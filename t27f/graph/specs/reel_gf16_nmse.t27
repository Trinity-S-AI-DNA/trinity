/// The protocol spec's own test count, which the evidence slide quotes.
pub const PROTOCOL_TESTS : i32 = 7;

pub fn step_number(cell: i32) -> i32 {
    return cell + 1;
}

/// Whether a SOURCES entry names a path: `path` occurs in `src` byte for byte.
pub fn cites(src: []const u8, n: usize, path: []const u8, m: usize) -> bool {
    if (m == 0 || m > n) {
        return false;
    }
    var i : usize = 0;
    while (i + m <= n) {
        var j : usize = 0;
        var same : bool = true;
        while (j < m && same) {
            if (src[i + j] != path[j]) {
                same = false;
            }
            j += 1;
        }
        if (same) {
            return true;
        }
        i += 1;
    }
    return false;
}

test the_domain_is_routed_not_chosen {
    assert DOMAIN == DOMAIN_RESEARCH;
    // gf16, gf16, benchmark; "bfloat16" is not "gf16", and no other list is hit
    assert keyword_hits(BRIEF, BRIEF.len, RESEARCH_WORDS, RESEARCH_WORDS.len) == 3;
    assert keyword_hits(BRIEF, BRIEF.len, CONTENT_WORDS, CONTENT_WORDS.len) == 0;
    assert keyword_hits(BRIEF, BRIEF.len, ENGINEERING_WORDS, ENGINEERING_WORDS.len) == 0;
    assert keyword_hits(BRIEF, BRIEF.len, SALES_WORDS, SALES_WORDS.len) == 0;
    assert route_brief(BRIEF, BRIEF.len) == DOMAIN;
}

test every_step_is_a_cell {
    assert CELL_COUNT == 27;
    var c : i32 = 0;
    while (c < CELL_COUNT) {
        const i : usize = @intCast(c);
        assert TITLES[i].len > 0;
        var want : i32 = 1;
        if (step_number(c) >= 10) {
            want = 2;
        }
        const len : i32 = @intCast(LABELS[i].len);
        assert len == want;
        c = c + 1;
    }
    assert LENS_TITLES[2].len > 0;
}

test a_gap_is_named_not_filled {
    assert gaps_are_named(SOURCES, MISSING, GROUNDED);
    assert count_true(GROUNDED) == 25;
    // a gap is drawn as a gap, and only a gap is
    var c : i32 = 0;
    while (c < CELL_COUNT) {
        const i : usize = @intCast(c);
        assert (STATUS[i] == STATUS_GAP) == (GROUNDED[i] == false);
        c = c + 1;
    }
    // the two gaps left are DELIVER steps: the chip repo's run and the paper's Delta_dB
    assert STATUS[17] == STATUS_GAP;
    assert STATUS[25] == STATUS_GAP;
    assert step_stage(17) == STAGE_DELIVER;
    assert step_stage(25) == STAGE_DELIVER;
    // the run's own cells cite the run, by both paths
    assert MISSING[15].len == 0;
    assert MISSING[16].len == 0;
    assert MISSING[24].len == 0;
    assert cites(SOURCES[15], SOURCES[15].len, RUN_HARNESS, RUN_HARNESS.len);
    assert cites(SOURCES[15], SOURCES[15].len, RUN_MANIFEST, RUN_MANIFEST.len);
    assert cites(SOURCES[16], SOURCES[16].len, RUN_MANIFEST, RUN_MANIFEST.len);
    assert cites(SOURCES[24], SOURCES[24].len, RUN_MANIFEST, RUN_MANIFEST.len);
    assert cites(SOURCES[24], SOURCES[24].len, RUN_HARNESS, RUN_HARNESS.len);
    // and cites is not a yes-machine: the protocol's own cells do not name the run
    assert cites(SOURCES[0], SOURCES[0].len, RUN_MANIFEST, RUN_MANIFEST.len) == false;
    assert cites(SOURCES[16], SOURCES[16].len, RUN_HARNESS, RUN_HARNESS.len) == false;
}

test a_status_is_earned_not_chosen {
    assert statuses_earned(STATUS, DOMAIN, GROUNDED, TEST_PASS, REVIEWED, LIVE);
    // the evidence slide's "15 published, 1 verified, 9 drafts" and "2 gaps"
    assert count_status(STATUS, STATUS_PUBLISHED) == 15;
    assert count_status(STATUS, STATUS_VERIFIED) == 1;
    assert count_status(STATUS, STATUS_DRAFT) == 9;
    assert count_status(STATUS, STATUS_GAP) == 2;
    assert count_true(REVIEWED) == 0;
    // every passing test is one of the protocol's own tests, on a PRACTICE step
    assert count_true(TEST_PASS) == PROTOCOL_TESTS;
    var c : i32 = 0;
    while (c < CELL_COUNT) {
        const i : usize = @intCast(c);
        if (TEST_PASS[i]) {
            assert step_stage(@intCast(c)) == STAGE_PRACTICE;
        }
        c = c + 1;
    }
    // the old numbers have a source but no seed, seal, test or review: a draft, never published
    assert STATUS[22] == STATUS_DRAFT;
}

test the_run_is_a_draft_until_reviewed {
    // steps 16, 17 and 25 now have the run as their source, and are DELIVER steps
    assert STATUS[15] == STATUS_DRAFT;
    assert STATUS[16] == STATUS_DRAFT;
    assert STATUS[24] == STATUS_DRAFT;
    assert step_stage(15) == STAGE_DELIVER;
    assert step_stage(16) == STAGE_DELIVER;
    assert step_stage(24) == STAGE_DELIVER;
    assert REVIEWED[15] == false;
    assert REVIEWED[16] == false;
    assert REVIEWED[24] == false;
    // a passing test and a live page do not lift a research DELIVER step: only a review does
    assert earned_status(15, DOMAIN, true, true, false, true) == STATUS_DRAFT;
    assert earned_status(15, DOMAIN, true, false, true, false) == STATUS_VERIFIED;
    assert earned_status(15, DOMAIN, true, false, true, true) == STATUS_PUBLISHED;
}

test the_camera_is_the_demo_camera {
    assert DEMO_COUNT == 5;
    // scene 1 shows lens 0, the row HEAD[1] calls "Steps 1-9"
    assert DEMO_LENS[1] == 0;
    // scenes 2 and 3 focus cell 10, which the focus slide calls "Step 11": the witness
    assert DEMO_CELL[2] == 10;
    assert DEMO_CELL[3] == 10;
    assert step_number(DEMO_CELL[2]) == 11;
    assert STATUS[10] == STATUS_PUBLISHED;
}

test every_slide_fits_every_preset {
    assert slides_fit(HEAD, ROWS);
    assert stage_slides_bare(ROWS);
}

invariant twenty_seven_steps {
    assert CELL_COUNT == 27;
}
