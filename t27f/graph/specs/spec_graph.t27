            "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
            "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
            "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""
        ],
        line_start: [0; 192], line_end: [0; 192],
        edge_count: 0, edge_kind: [0; 254], edge_from: [0; 254], edge_to: [0; 254], edge_label: [0; 254], edge_line: [0; 254]
    };
}

/// g with one more node. Past MAX_NODES the node is dropped and node_count still counts it, so
/// validate_graph_header refuses the graph instead of silently losing a node.
pub fn with_node(g: SpecGraph, kind: u8, label: u8, name: str, s: u32, e: u32) -> SpecGraph {
    var h : SpecGraph = g;
    if (h.node_count < MAX_NODES) {
        let k : usize = h.node_count as usize;
        h.node_kind[k] = kind;
        h.node_label[k] = label;
        h.node_name[k] = name;
        h.line_start[k] = s;
        h.line_end[k] = e;
    }
    h.node_count = h.node_count + 1;
    return h;
}

/// g with one more edge, under the same capacity rule as with_node.
pub fn with_edge(g: SpecGraph, kind: u8, f: u8, t: u8, label: u8, line: u32) -> SpecGraph {
    var h : SpecGraph = g;
    if (h.edge_count < MAX_EDGES) {
        let k : usize = h.edge_count as usize;
        h.edge_kind[k] = kind;
        h.edge_from[k] = f;
        h.edge_to[k] = t;
        h.edge_label[k] = label;
        h.edge_line[k] = line;
    }
    h.edge_count = h.edge_count + 1;
    return h;
}

/// The fixture: the graph of specs/tutorial/08_modules_and_arrays.t27 at gHashTag/t27 commit
/// 2f395025f (93 lines, sha256 c291e925d9dabef8b72b5a64aef153a2126c0b0b43d67bc08b1b2d7eaa98039a),
/// read by hand. Every top-level declaration is a node; every span and edge line is a line of
/// that file. Node numbers: 0 module, 1 use, 2-3 consts, 4 scaled_width, 5-7 consts,
/// 8 power_of_two, 9 bias_for_width, 10-12 tests, 13 invariant, 14 std.testing.
pub fn tutorial_08_graph() -> SpecGraph {
    var g : SpecGraph = blank_graph();
    g.spec_path = "specs/tutorial/08_modules_and_arrays.t27";
    g.line_count = 93;
    // `module tutorial-08-modules;` is line 11; the module node spans the file.
    g = with_node(g, NODE_MODULE, LABEL_EXACT, "tutorial-08-modules", 1, 93);
    g = with_node(g, NODE_USE, LABEL_EXACT, "base::types", 22, 22);
    g = with_node(g, NODE_CONST, LABEL_EXACT, "EXPORTED_WIDTH", 32, 32);
    g = with_node(g, NODE_CONST, LABEL_EXACT, "INTERNAL_SCALE", 35, 35);
    g = with_node(g, NODE_FN, LABEL_EXACT, "scaled_width", 37, 39);
    g = with_node(g, NODE_CONST, LABEL_EXACT, "TRIT_VALUES", 54, 54);
    g = with_node(g, NODE_CONST, LABEL_EXACT, "POWERS_OF_TWO", 56, 56);
    g = with_node(g, NODE_CONST, LABEL_EXACT, "EXPONENT_BIAS", 58, 58);
    g = with_node(g, NODE_FN, LABEL_EXACT, "power_of_two", 66, 68);
    g = with_node(g, NODE_FN, LABEL_EXACT, "bias_for_width", 70, 72);
    g = with_node(g, NODE_TEST, LABEL_EXACT, "the power table matches its own definition", 78, 81);
    g = with_node(g, NODE_TEST, LABEL_EXACT, "bias table carries the four standard widths", 83, 86);
    g = with_node(g, NODE_TEST, LABEL_EXACT, "a private constant is still usable inside its own module", 88, 90);
    g = with_node(g, NODE_INVARIANT, LABEL_EXACT, "exported_width_is_a_power_of_two", 92, 93);
    // The tests call std.testing.expectEqual (lines 79-89). No `use` in the file declares std and
    // it is not a corpus spec, so what it is cannot be read from this source.
    g = with_node(g, NODE_OPAQUE, LABEL_UNKNOWN, "std.testing", 79, 89);
    // The `use` statement (line 22).
    g = with_edge(g, EDGE_USES, 0, 1, LABEL_EXACT, 22);
    // Names in function bodies (lines 38, 67, 71).
    g = with_edge(g, EDGE_USES, 4, 2, LABEL_EXACT, 38);
    g = with_edge(g, EDGE_USES, 4, 3, LABEL_EXACT, 38);
    g = with_edge(g, EDGE_USES, 8, 6, LABEL_EXACT, 67);
    g = with_edge(g, EDGE_USES, 9, 7, LABEL_EXACT, 71);
    // The named values are operands of each return expression, so they reach the result.
    g = with_edge(g, EDGE_DATA_FLOW, 2, 4, LABEL_DERIVED, 38);
    g = with_edge(g, EDGE_DATA_FLOW, 3, 4, LABEL_DERIVED, 38);
    g = with_edge(g, EDGE_DATA_FLOW, 6, 8, LABEL_DERIVED, 67);
    g = with_edge(g, EDGE_DATA_FLOW, 7, 9, LABEL_DERIVED, 71);
    // Calls from test bodies (first call lines 79, 84, 89).
    g = with_edge(g, EDGE_CALLS, 10, 8, LABEL_EXACT, 79);
    g = with_edge(g, EDGE_CALLS, 11, 9, LABEL_EXACT, 84);
    g = with_edge(g, EDGE_CALLS, 12, 4, LABEL_EXACT, 89);
    // TESTED_BY is the calls above read backwards; it has no line of its own.
    g = with_edge(g, EDGE_TESTED_BY, 8, 10, LABEL_DERIVED, NO_LINE);
    g = with_edge(g, EDGE_TESTED_BY, 9, 11, LABEL_DERIVED, NO_LINE);
    g = with_edge(g, EDGE_TESTED_BY, 4, 12, LABEL_DERIVED, NO_LINE);
    // `assert EXPORTED_WIDTH == 16` (line 93).
    g = with_edge(g, EDGE_CONSTRAINS, 13, 2, LABEL_EXACT, 93);
    return g;
}

/// The fixture with a model's explanation added: node 15, "table lookup step", over the two
/// indexing functions (lines 66-72), and the suggested flow of POWERS_OF_TWO into it (line 67).
pub fn with_suggestion() -> SpecGraph {
    var g : SpecGraph = tutorial_08_graph();
    g = with_node(g, NODE_OPAQUE, LABEL_SUGGESTED, "table lookup step", 66, 72);
    g = with_edge(g, EDGE_DATA_FLOW, 6, 15, LABEL_SUGGESTED, 67);
    return g;
}

/// A UI plan for the fixture, every widget picked by node_widget: the module card (node 0), the
/// formula view of power_of_two (node 8) and the run button of its test (node 10).
pub fn tutorial_08_plan() -> UiPlan {
    let g : SpecGraph = tutorial_08_graph();
    var p : UiPlan = blank_plan();
    p.intent = "Show the graph of tutorial lesson 08";
    p.title = "Tutorial 08 spec graph";
    p.granted = bit(CAP_READ_SPECS) | bit(CAP_RUN_LAB);
    p.source_count = 2;
    p.source_kind[0] = SOURCE_SPEC;
    p.source_ref[0] = g.spec_path;
    p.source_kind[1] = SOURCE_FORMULA;
    p.source_ref[1] = "specs/tutorial/08_modules_and_arrays.t27#power_of_two";
    p.widget_count = 3;
    p.widget[0] = node_widget(g.node_kind[0], g.node_label[0]);
    p.props[0] = bit(PROP_TITLE) | bit(PROP_SPEC_PATH);
    p.binding[0] = 1;
    p.action[0] = ACTION_OPEN_SPEC;
    p.span[0] = 6;
    p.label[0] = g.node_name[0];
    p.widget[1] = node_widget(g.node_kind[8], g.node_label[8]);
    p.props[1] = bit(PROP_TITLE) | bit(PROP_FORMULA_ID);
    p.binding[1] = 2;
    p.action[1] = ACTION_NONE;
    p.col[1] = 6;
    p.span[1] = 6;
    p.label[1] = g.node_name[8];
    p.widget[2] = node_widget(g.node_kind[10], g.node_label[10]);
    p.props[2] = bit(PROP_TITLE) | bit(PROP_SPEC_PATH);
    p.binding[2] = 1;
    p.action[2] = ACTION_RUN_TESTS;
    p.row[2] = 1;
    p.span[2] = 4;
    p.label[2] = g.node_name[10];
    return p;
}

test name_tables_map_names_to_codes {
    assert node_kind_id("module") == NODE_MODULE;
    assert node_kind_id("fn") == NODE_FN;
    assert node_kind_id("opaque") == NODE_OPAQUE;
    assert edge_kind_id("tested_by") == EDGE_TESTED_BY;
    assert edge_kind_id("data_flow") == EDGE_DATA_FLOW;
    assert label_id("suggested") == LABEL_SUGGESTED;
    assert label_id("unknown") == LABEL_UNKNOWN;
    // names outside the tables, and a different spelling, are not codes
    assert node_kind_id("step") == NO_CODE;
    assert node_kind_id("Fn") == NO_CODE;
    assert edge_kind_id("control_flow") == NO_CODE;
    assert label_id("verified") == NO_CODE;
    assert name_tables_round_trip();
    assert valid_node_kind(NODE_OPAQUE);
    assert valid_node_kind(NODE_KINDS) == false;
    assert valid_edge_kind(EDGE_KINDS) == false;
    assert valid_label(LABEL_UNKNOWN);
    assert valid_label(LABEL_KINDS) == false;
}

test fixture_graph_is_valid {
    let g : SpecGraph = tutorial_08_graph();
    assert validate_graph(g) == GRAPH_OK;
    assert first_bad_node(g) == NO_INDEX;
    assert first_bad_edge(g) == NO_INDEX;
    assert g.node_count == 15;
    assert g.edge_count == 16;
    // one node per top-level declaration of the file, plus the opaque region
    assert count_node_kind(g, NODE_MODULE) == 1;
    assert count_node_kind(g, NODE_USE) == 1;
    assert count_node_kind(g, NODE_CONST) == 5;
    assert count_node_kind(g, NODE_FN) == 3;
    assert count_node_kind(g, NODE_TEST) == 3;
    assert count_node_kind(g, NODE_INVARIANT) == 1;
    assert count_node_kind(g, NODE_BENCH) == 0;
    assert count_node_kind(g, NODE_OPAQUE) == 1;
    assert count_node_label(g, LABEL_EXACT) == 14;
    assert count_node_label(g, LABEL_UNKNOWN) == 1;
    assert count_edge_kind(g, EDGE_USES) == 5;
    assert count_edge_kind(g, EDGE_DATA_FLOW) == 4;
    assert count_edge_kind(g, EDGE_CALLS) == 3;
    assert count_edge_kind(g, EDGE_TESTED_BY) == 3;
    assert count_edge_kind(g, EDGE_CONSTRAINS) == 1;
    assert count_edge_label(g, LABEL_EXACT) == 9;
    assert count_edge_label(g, LABEL_DERIVED) == 7;
    assert count_edge_label(g, LABEL_SUGGESTED) == 0;
}

test header_rules_come_first {
    var v : SpecGraph = tutorial_08_graph();
    v.ir_version = GRAPH_IR_VERSION + 1;
    assert validate_graph(v) == ERR_GRAPH_VERSION;
    var p : SpecGraph = tutorial_08_graph();
    p.spec_path = "";
    assert validate_graph(p) == ERR_SPEC_PATH;
    var c : SpecGraph = tutorial_08_graph();
    c.line_count = 0;
    assert validate_graph(c) == ERR_SPEC_PATH;
    assert validate_graph(blank_graph()) == ERR_SPEC_PATH;
    var e : SpecGraph = blank_graph();
    e.spec_path = "specs/x.t27";
    e.line_count = 1;
    assert validate_graph(e) == ERR_MODULE;
    // node 0 must be the module, and its span must be the whole file
    var m : SpecGraph = tutorial_08_graph();
    m.node_kind[0] = NODE_CONST;
    assert validate_graph(m) == ERR_MODULE;
    var s : SpecGraph = tutorial_08_graph();
    s.line_start[0] = 11;
    assert validate_graph(s) == ERR_MODULE;
    assert first_bad_node(s) == NO_INDEX;
    var f : SpecGraph = tutorial_08_graph();
    f.line_count = 94;
    assert validate_graph(f) == ERR_MODULE;
    // a second module is a node rule, reported at that node
    var d : SpecGraph = tutorial_08_graph();
    d.node_kind[5] = NODE_MODULE;
    assert validate_graph(d) == ERR_MODULE;
    assert first_bad_node(d) == 5;
}

test capacity_is_refused_not_truncated {
    var g : SpecGraph = tutorial_08_graph();
    while (g.node_count < MAX_NODES + 1) {
        g = with_node(g, NODE_CONST, LABEL_DERIVED, "extra", NO_LINE, NO_LINE);
    }
    // MAX_NODES + 1 nodes declared, MAX_NODES stored: the graph is refused, not cut short
    assert g.node_count == MAX_NODES + 1;
    assert validate_graph(g) == ERR_TOO_MANY_NODES;
    var h : SpecGraph = tutorial_08_graph();
    while (h.edge_count < MAX_EDGES + 1) {
        h = with_edge(h, EDGE_TESTED_BY, 9, 13, LABEL_DERIVED, NO_LINE);
    }
    assert h.edge_count == MAX_EDGES + 1;
    assert validate_graph(h) == ERR_TOO_MANY_EDGES;
}

test a_graph_exactly_at_capacity_is_valid {
    // 16 fns and 16 tests after the fixture's 15 nodes, then consts up to MAX_NODES; every
    // test calls every fn, so the CALLS edges are distinct (a repeated edge is a duplicate)
    var g : SpecGraph = tutorial_08_graph();
    var a : u32 = 0;
    while (a < 16) {
        g = with_node(g, NODE_FN, LABEL_EXACT, "f", 1, 1);
        a = a + 1;
    }
    a = 0;
    while (a < 16) {
        g = with_node(g, NODE_TEST, LABEL_EXACT, "t", 1, 1);
        a = a + 1;
    }
    while (g.node_count < MAX_NODES) {
        g = with_node(g, NODE_CONST, LABEL_EXACT, "extra", 1, 1);
    }
    var t : u32 = 0;
    while (t < 16) {
        var f : u32 = 0;
        while (f < 16) {
            if (g.edge_count < MAX_EDGES) {
                g = with_edge(g, EDGE_CALLS, (31 + t) as u8, (15 + f) as u8, LABEL_EXACT, 1);
            }
            f = f + 1;
        }
        t = t + 1;
    }
    assert g.node_count == MAX_NODES;
    assert g.edge_count == MAX_EDGES;
    assert validate_graph(g) == GRAPH_OK;
    // the last stored node and edge are real cells, not clipped
    assert g.node_kind[MAX_NODES as usize - 1] == NODE_CONST;
    assert g.edge_kind[MAX_EDGES as usize - 1] == EDGE_CALLS;
    // negative control: one more edge or node makes the same graph refused
    assert validate_graph(with_edge(g, EDGE_CALLS, 31, 15, LABEL_EXACT, 1)) == ERR_TOO_MANY_EDGES;
    assert validate_graph(with_node(g, NODE_CONST, LABEL_EXACT, "extra", 1, 1)) == ERR_TOO_MANY_NODES;
}

test node_rules {
    var k : SpecGraph = tutorial_08_graph();
    k.node_kind[3] = NODE_KINDS;
    assert validate_graph(k) == ERR_NODE_KIND;
    assert first_bad_node(k) == 3;
    var l : SpecGraph = tutorial_08_graph();
    l.node_label[7] = LABEL_KINDS;
    assert validate_graph(l) == ERR_LABEL;
    assert first_bad_node(l) == 7;
    var n : SpecGraph = tutorial_08_graph();
    n.node_name[9] = "";
    assert validate_graph(n) == ERR_NODE_NAME;
    // span order: start after end, or an end with no start
    var o : SpecGraph = tutorial_08_graph();
    o.line_start[4] = 40;
    assert validate_graph(o) == ERR_SPAN_ORDER;
    assert first_bad_node(o) == 4;
    var z : SpecGraph = tutorial_08_graph();
    z.line_start[4] = NO_LINE;
    assert validate_graph(z) == ERR_SPAN_ORDER;
    var x : SpecGraph = tutorial_08_graph();
    x.line_end[13] = 94;
    assert validate_graph(x) == ERR_SPAN_OUTSIDE;
    assert first_bad_node(x) == 13;
    // an EXACT node is in the source, so it has a span
    var m : SpecGraph = tutorial_08_graph();
    m.line_start[5] = NO_LINE;
    m.line_end[5] = NO_LINE;
    assert validate_graph(m) == ERR_SPAN_MISSING;
    assert first_bad_node(m) == 5;
    // a DERIVED or UNKNOWN node may have none
    m.node_label[5] = LABEL_DERIVED;
    assert validate_graph(m) == GRAPH_OK;
    var u : SpecGraph = tutorial_08_graph();
    u.line_start[14] = NO_LINE;
    u.line_end[14] = NO_LINE;
    assert validate_graph(u) == GRAPH_OK;
}

test suggested_node_needs_a_span {
    let g : SpecGraph = with_suggestion();
    assert validate_graph(g) == GRAPH_OK;
    assert count_node_label(g, LABEL_SUGGESTED) == 1;
    assert count_edge_label(g, LABEL_SUGGESTED) == 1;
    // without the lines it explains, a guess is refused
    var s : SpecGraph = with_suggestion();
    s.line_start[15] = NO_LINE;
    s.line_end[15] = NO_LINE;
    assert validate_graph(s) == ERR_SPAN_MISSING;
    assert first_bad_node(s) == 15;
    // an edge into a guess is a guess: it may not be labelled EXACT or DERIVED
    var e : SpecGraph = with_suggestion();
    e.edge_label[16] = LABEL_EXACT;
    assert validate_graph(e) == ERR_EDGE_LABEL;
    assert first_bad_edge(e) == 16;
    e.edge_label[16] = LABEL_DERIVED;
    assert validate_graph(e) == ERR_EDGE_LABEL;
    // and a suggested edge carries its source line too
    var l : SpecGraph = with_suggestion();
    l.edge_line[16] = NO_LINE;
    assert validate_graph(l) == ERR_EDGE_LINE;
}

test unknown_node_draws_no_edges {
    let g : SpecGraph = tutorial_08_graph();
    var a : SpecGraph = with_edge(g, EDGE_DATA_FLOW, 14, 10, LABEL_DERIVED, 79);
    assert validate_graph(a) == ERR_EDGE_UNKNOWN_NODE;
    assert first_bad_edge(a) == 16;
    var b : SpecGraph = with_edge(g, EDGE_DATA_FLOW, 6, 14, LABEL_SUGGESTED, 79);
    assert validate_graph(b) == ERR_EDGE_UNKNOWN_NODE;
    // the rule is about the label: the same edge from a DERIVED region is drawn
    a.node_label[14] = LABEL_DERIVED;
    assert validate_graph(a) == GRAPH_OK;
}

test edge_endpoints_must_exist_and_fit {
    let g : SpecGraph = tutorial_08_graph();
    assert validate_graph(with_edge(g, EDGE_CALLS, 10, 15, LABEL_EXACT, 79)) == ERR_EDGE_DANGLING;
    assert validate_graph(with_edge(g, EDGE_CALLS, 255, 8, LABEL_EXACT, 79)) == ERR_EDGE_DANGLING;
    assert validate_graph(with_edge(g, EDGE_KINDS, 10, 8, LABEL_EXACT, 79)) == ERR_EDGE_KIND;
    // calls end at a fn, never at a const
    assert validate_graph(with_edge(g, EDGE_CALLS, 10, 6, LABEL_EXACT, 79)) == ERR_EDGE_ENDPOINT_KIND;
    // tested_by starts at a fn; constrains starts at an invariant
    assert validate_graph(with_edge(g, EDGE_TESTED_BY, 10, 8, LABEL_DERIVED, NO_LINE)) == ERR_EDGE_ENDPOINT_KIND;
    assert validate_graph(with_edge(g, EDGE_CONSTRAINS, 10, 6, LABEL_EXACT, 79)) == ERR_EDGE_ENDPOINT_KIND;
    // a module uses an import, but does not call it
    assert validate_graph(with_edge(g, EDGE_CALLS, 0, 1, LABEL_EXACT, 22)) == ERR_EDGE_ENDPOINT_KIND;
    var w : SpecGraph = tutorial_08_graph();
    w.edge_to[9] = 7;
    assert validate_graph(w) == ERR_EDGE_ENDPOINT_KIND;
    assert first_bad_edge(w) == 9;
}

test edge_labels_lines_and_duplicates {
    let g : SpecGraph = tutorial_08_graph();
    // an edge is drawn or it is not: UNKNOWN is not an edge label
    var u : SpecGraph = tutorial_08_graph();
    u.edge_label[0] = LABEL_UNKNOWN;
    assert validate_graph(u) == ERR_EDGE_LABEL;
    assert first_bad_edge(u) == 0;
    // an EXACT edge is read from a line, so it names one
    var t : SpecGraph = tutorial_08_graph();
    t.edge_label[12] = LABEL_EXACT;
    assert validate_graph(t) == ERR_EDGE_LINE;
    assert first_bad_edge(t) == 12;
    // that line lies in one of its endpoints: line 50 is a comment between them
    var o : SpecGraph = tutorial_08_graph();
    o.edge_line[1] = 50;
    assert validate_graph(o) == ERR_EDGE_LINE;
    // a line in the target's span counts (data_flow 2 -> 4 is read at line 38, inside node 4)
    assert span_holds(g, 2, 38) == false;
    assert span_holds(g, 4, 38);
    // an EXACT edge may not touch a DERIVED node
    var d : SpecGraph = tutorial_08_graph();
    d.node_label[6] = LABEL_DERIVED;
    assert validate_graph(d) == ERR_EDGE_LABEL;
    assert first_bad_edge(d) == 3;
    // the same kind and endpoints twice is one edge drawn twice
    assert validate_graph(with_edge(g, EDGE_USES, 4, 2, LABEL_EXACT, 38)) == ERR_DUPLICATE_EDGE;
    // the same endpoints under another kind is a different edge
    assert has_edge(g, EDGE_USES, 4, 2);
    assert has_edge(g, EDGE_DATA_FLOW, 2, 4);
    assert has_edge(g, EDGE_DATA_FLOW, 4, 2) == false;
}

test source_mapping_goes_both_ways {
    let g : SpecGraph = tutorial_08_graph();
    // line -> node: the innermost span wins
    assert node_at_line(g, 67) == 8;
    assert node_at_line(g, 93) == 13;
    assert node_at_line(g, 22) == 1;
    // line 79 is in test 10 (78-81) and in std.testing (79-89); the shorter span wins
    assert node_at_line(g, 79) == 10;
    assert node_at_line(g, 87) == 14;
    // a comment line belongs to the module; no line 0, nothing past the file
    assert node_at_line(g, 50) == 0;
    assert node_at_line(g, 0) == NO_INDEX;
    assert node_at_line(g, 94) == NO_INDEX;
    // node -> line, and back to the same node, for every declaration
    var n : u32 = 1;
    var back : u32 = 0;
    while (n < 14) {
        let r : SpecGraphNode = node_at(g, n);
        if (node_at_line(g, r.line_start) == n and node_at_line(g, r.line_end) == n) { back = back + 1; }
        n = n + 1;
    }
    assert back == 13;
    let p : SpecGraphNode = node_at(g, 8);
    assert p.kind == NODE_FN;
    assert p.label == LABEL_EXACT;
    assert p.name == "power_of_two";
    assert p.line_start == 66;
    assert p.line_end == 68;
}

test tested_by_is_derived_from_calls {
    let g : SpecGraph = tutorial_08_graph();
    assert tested_by_matches_calls(g);
    assert tests_of(g, 8) == 1;
    assert tests_of(g, 4) == 1;
    // TRIT_VALUES is declared and never read: no edge, no test
    assert tests_of(g, 5) == 0;
    assert untested_fns(g) == 0;
    // drop one TESTED_BY edge: the derivation no longer holds and a fn is untested
    var m : SpecGraph = tutorial_08_graph();
    m.edge_count = 15;
    m.edge_kind[14] = EDGE_CONSTRAINS;
    m.edge_from[14] = 13;
    m.edge_to[14] = 2;
    m.edge_label[14] = LABEL_EXACT;
    m.edge_line[14] = 93;
    assert tested_by_matches_calls(m) == false;
    assert untested_fns(m) == 1;
    // a TESTED_BY edge with no call behind it is not derived either
    var x : SpecGraph = with_edge(g, EDGE_TESTED_BY, 9, 10, LABEL_DERIVED, NO_LINE);
    assert validate_graph(x) == GRAPH_OK;
    assert tested_by_matches_calls(x) == false;
}

test nodes_bind_to_trusted_widgets {
    assert node_widget(NODE_MODULE, LABEL_EXACT) == WIDGET_HONEYCOMB_CARD;
    assert node_widget(NODE_USE, LABEL_DERIVED) == WIDGET_HONEYCOMB_CARD;
    assert node_widget(NODE_FN, LABEL_EXACT) == WIDGET_FORMULA_VIEW;
    assert node_widget(NODE_CONST, LABEL_EXACT) == WIDGET_FORMULA_VIEW;
    assert node_widget(NODE_TEST, LABEL_EXACT) == WIDGET_RUN_BUTTON;
    assert node_widget(NODE_INVARIANT, LABEL_EXACT) == WIDGET_RUN_BUTTON;
    assert node_widget(NODE_BENCH, LABEL_EXACT) == WIDGET_METRICS_TABLE;
    assert node_widget(NODE_OPAQUE, LABEL_EXACT) == WIDGET_TEXT_BLOCK;
    // a guess and an unknown are drawn as text, whatever their kind
    assert node_widget(NODE_FN, LABEL_SUGGESTED) == WIDGET_TEXT_BLOCK;
    assert node_widget(NODE_TEST, LABEL_UNKNOWN) == WIDGET_TEXT_BLOCK;
    assert node_widget(NODE_KINDS, LABEL_EXACT) == WIDGET_TEXT_BLOCK;
    assert node_source_kind(NODE_FN, LABEL_EXACT) == SOURCE_FORMULA;
    assert node_source_kind(NODE_TEST, LABEL_EXACT) == SOURCE_SPEC;
    assert node_source_kind(NODE_BENCH, LABEL_EXACT) == SOURCE_METRICS;
    assert node_source_kind(NODE_FN, LABEL_SUGGESTED) == SOURCE_NONE;
    // a plan whose widgets were picked from the fixture passes ui_plan's own gate
    let p : UiPlan = tutorial_08_plan();
    assert validate_plan(p) == PLAN_OK;
    assert p.widget[1] == WIDGET_FORMULA_VIEW;
    assert p.source_kind[(p.binding[1] - 1) as usize] == node_source_kind(NODE_FN, LABEL_EXACT);
    // if node 8 were a guess, its widget would be text, and text takes no binding
    var q : UiPlan = tutorial_08_plan();
    q.widget[1] = node_widget(NODE_FN, LABEL_SUGGESTED);
    q.props[1] = bit(PROP_CAPTION);
    assert validate_plan(q) == ERR_BINDING_KIND;
    assert first_bad_slot(q) == 1;
    q.binding[1] = 0;
    assert validate_plan(q) == PLAN_OK;
}

test first_broken_rule_is_reported {
    // a node defect and an edge defect: the node is reported, and no edge is named
    var g : SpecGraph = tutorial_08_graph();
    g.edge_line[1] = 50;
    g.node_name[12] = "";
    assert validate_graph(g) == ERR_NODE_NAME;
    assert first_bad_node(g) == 12;
    assert first_bad_edge(g) == NO_INDEX;
    // fix the node: the edge comes next
    g.node_name[12] = "a private constant is still usable inside its own module";
    assert validate_graph(g) == ERR_EDGE_LINE;
    assert first_bad_edge(g) == 1;
    // a header defect hides both
    g.ir_version = 0;
    assert validate_graph(g) == ERR_GRAPH_VERSION;
    assert first_bad_node(g) == NO_INDEX;
    assert first_bad_edge(g) == NO_INDEX;
}

invariant name_tables_cover_every_code {
    assert name_tables_round_trip();
    assert node_kind_id(NODE_KIND_NAMES[NODE_OPAQUE as usize]) == NODE_OPAQUE;
    assert edge_kind_id(EDGE_KIND_NAMES[EDGE_DATA_FLOW as usize]) == EDGE_DATA_FLOW;
}

invariant edge_masks_are_spelled_right {
    let bodies : u32 = kind_bit(NODE_FN) | kind_bit(NODE_TEST) | kind_bit(NODE_INVARIANT) | kind_bit(NODE_BENCH);
    assert EDGE_FROM_KINDS[EDGE_CALLS as usize] == bodies;
    assert EDGE_TO_KINDS[EDGE_CALLS as usize] == kind_bit(NODE_FN);
    assert EDGE_FROM_KINDS[EDGE_USES as usize] == kind_bit(NODE_MODULE) | bodies;
    assert EDGE_TO_KINDS[EDGE_USES as usize] == kind_bit(NODE_CONST) | kind_bit(NODE_USE);
    assert EDGE_FROM_KINDS[EDGE_TESTED_BY as usize] == kind_bit(NODE_FN);
    assert EDGE_TO_KINDS[EDGE_TESTED_BY as usize] == kind_bit(NODE_TEST) | kind_bit(NODE_INVARIANT) | kind_bit(NODE_BENCH);
    assert EDGE_FROM_KINDS[EDGE_CONSTRAINS as usize] == kind_bit(NODE_INVARIANT);
    assert EDGE_TO_KINDS[EDGE_CONSTRAINS as usize] == kind_bit(NODE_CONST) | kind_bit(NODE_FN);
    assert EDGE_FROM_KINDS[EDGE_DATA_FLOW as usize] == kind_bit(NODE_CONST) | kind_bit(NODE_FN) | kind_bit(NODE_USE) | kind_bit(NODE_OPAQUE);
    assert EDGE_TO_KINDS[EDGE_DATA_FLOW as usize] == bodies | kind_bit(NODE_OPAQUE);
}

invariant every_node_binds_to_a_catalog_widget {
    assert all_bindings_trusted();
}

invariant the_fixture_stays_valid {
    assert validate_graph(tutorial_08_graph()) == GRAPH_OK;
    assert validate_graph(with_suggestion()) == GRAPH_OK;
    assert tested_by_matches_calls(tutorial_08_graph());
}

invariant reserved_codes_stay_outside {
    assert NO_CODE >= NODE_KINDS;
    assert NO_CODE >= EDGE_KINDS;
    assert NO_CODE >= LABEL_KINDS;
    assert MAX_NODES < NO_INDEX;
    assert MAX_EDGES < NO_INDEX;
    assert MAX_NODES >= MEASURED_NODES_P95;
    assert MAX_EDGES >= MEASURED_EDGES_P95;
    assert (NODE_KINDS as u32) < 32;
    assert ERR_DUPLICATE_EDGE + 1 == VERDICT_KINDS;
}
