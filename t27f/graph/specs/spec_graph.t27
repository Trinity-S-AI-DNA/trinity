// SPDX-License-Identifier: Apache-2.0
; specs/t27f/spec_graph.t27 -- the T27F spec graph IR: what a .t27 file becomes before T27F draws
; it (RFC gHashTag/trinity#1649, epic gHashTag/trinity#1648, tracked in gHashTag/t27#10020).
; T27F is the visual spec of .t27; the definition lives in .claude/skills/t27f/SKILL.md, "What T27F
; is". This file is its core: one spec -> one graph -> many views. Every view (architecture, data
; flow, dependencies, tests) is a projection of the same graph, and the graph is read from the
; spec's source, never drawn by hand.
; What this file decides, deterministically and without a language model:
;   - the vocabulary: node kinds, edge kinds and inference labels, as u8 codes with name tables;
;   - the records: a node carries kind, label, name and a source span; an edge carries kind,
;     endpoints, label and the source line it was read from;
;   - validation: validate_graph() returns GRAPH_OK or the first rule a graph breaks, and
;     first_bad_node() / first_bad_edge() name the record that broke it;
;   - source mapping both ways: a node has a span, and node_at_line() finds the node of a line;
;   - which ui_plan widget (specs/t27f/ui_plan.t27) draws a node, so a renderer never picks one.
; Inference labels, from strongest to weakest (RFC #1649, "Parsing and inference levels"):
;   EXACT     present in the spec's source as written (a declaration, a call, a `use`);
;   DERIVED   computed from EXACT facts by a rule stated here (tested_by is calls read backwards);
;   SUGGESTED a model's explanation; drawn as plain text, always with the source lines it explains;
;   UNKNOWN   cannot be read from the source; drawn alone, with no edge into or out of it.
; Not claimed here: t27c has no graph export yet, so no graph is generated from a spec; the fixture
; below is read by hand. No renderer draws a graph, there is no graph diff, and node kinds finer
; than a top-level declaration (steps, branches, operators, parameters) are not in IR version 1.
; phi^2 + 1/phi^2 = 3 | TRINITY

module t27f_spec_graph;

use t27f::ui_plan::UiPlan;
use t27f::ui_plan::blank_plan;
use t27f::ui_plan::validate_plan;
use t27f::ui_plan::first_bad_slot;
use t27f::ui_plan::catalog_widget;
use t27f::ui_plan::bit;
use t27f::ui_plan::PLAN_OK;
use t27f::ui_plan::ERR_BINDING_KIND;
use t27f::ui_plan::WIDGET_HONEYCOMB_CARD;
use t27f::ui_plan::WIDGET_FORMULA_VIEW;
use t27f::ui_plan::WIDGET_METRICS_TABLE;
use t27f::ui_plan::WIDGET_RUN_BUTTON;
use t27f::ui_plan::WIDGET_TEXT_BLOCK;
use t27f::ui_plan::WIDGET_SOURCE;
use t27f::ui_plan::SOURCE_NONE;
use t27f::ui_plan::SOURCE_SPEC;
use t27f::ui_plan::SOURCE_FORMULA;
use t27f::ui_plan::SOURCE_METRICS;
use t27f::ui_plan::PROP_TITLE;
use t27f::ui_plan::PROP_SPEC_PATH;
use t27f::ui_plan::PROP_FORMULA_ID;
use t27f::ui_plan::PROP_CAPTION;
use t27f::ui_plan::ACTION_NONE;
use t27f::ui_plan::ACTION_OPEN_SPEC;
use t27f::ui_plan::ACTION_RUN_TESTS;
use t27f::ui_plan::CAP_READ_SPECS;
use t27f::ui_plan::CAP_RUN_LAB;

/// The IR version a graph names. Any other version is refused.
pub const GRAPH_IR_VERSION : u32 = 1;

/// Node kinds. IR version 1 has one node per top-level declaration, plus OPAQUE for a region the
/// source names but this IR cannot read into.
pub const NODE_MODULE : u8 = 0;
pub const NODE_CONST : u8 = 1;
pub const NODE_FN : u8 = 2;
pub const NODE_TEST : u8 = 3;
pub const NODE_INVARIANT : u8 = 4;
pub const NODE_BENCH : u8 = 5;
pub const NODE_USE : u8 = 6;
pub const NODE_OPAQUE : u8 = 7;
pub const NODE_KINDS : u8 = 8;
pub const NODE_KIND_NAMES : [8]str = ["module", "const", "fn", "test", "invariant", "bench", "use", "opaque"];

/// Edge kinds, read from -> to:
///   CALLS      from a fn, test, invariant or bench to the fn it calls;
///   USES       from a module or a body to the const or `use` it names (module -> use is the
///              `use` statement itself);
///   TESTED_BY  from a fn to the test, invariant or bench that calls it; DERIVED from CALLS;
///   CONSTRAINS from an invariant to the const or fn its asserts are about;
///   DATA_FLOW  from a value (const, fn result, import, opaque region) to a body whose result it
///              reaches.
pub const EDGE_CALLS : u8 = 0;
pub const EDGE_USES : u8 = 1;
pub const EDGE_TESTED_BY : u8 = 2;
pub const EDGE_CONSTRAINS : u8 = 3;
pub const EDGE_DATA_FLOW : u8 = 4;
pub const EDGE_KINDS : u8 = 5;
pub const EDGE_KIND_NAMES : [5]str = ["calls", "uses", "tested_by", "constrains", "data_flow"];

/// Inference labels. A smaller code is a stronger claim; an edge is never stronger than either
/// of its endpoints.
pub const LABEL_EXACT : u8 = 0;
pub const LABEL_DERIVED : u8 = 1;
pub const LABEL_SUGGESTED : u8 = 2;
pub const LABEL_UNKNOWN : u8 = 3;
pub const LABEL_KINDS : u8 = 4;
pub const LABEL_NAMES : [4]str = ["exact", "derived", "suggested", "unknown"];

/// The code a name lookup returns for a name that is not in its table.
pub const NO_CODE : u8 = 255;

/// Which node kinds each edge kind may start and end at, as masks of node-kind bits, indexed by
/// edge kind. The invariant edge_masks_are_spelled_right rebuilds each one from the named kinds.
/// From: calls fn+test+invariant+bench; uses module+fn+test+invariant+bench; tested_by fn;
/// constrains invariant; data_flow const+fn+use+opaque.
pub const EDGE_FROM_KINDS : [5]u32 = [60, 61, 4, 16, 198];
/// To: calls fn; uses const+use; tested_by test+invariant+bench; constrains const+fn;
/// data_flow fn+test+invariant+bench+opaque.
pub const EDGE_TO_KINDS : [5]u32 = [4, 66, 56, 6, 188];

/// Capacity. Line 0 means "no source line": a span with line_start 0 is no span.
/// Measured 2026-10-18 on the Railway lab, over the 2204 specs/**/*.t27 files of gHashTag/t27
/// master (t27#10173 tree): top-level declarations per spec (nodes) p50 20, p90 66, p95 96,
/// p98 183, p99 436, max 678. Call/use/constrain edges, read through the exporter on an 86-spec
/// stratified sample: p50 at most 12, p95 at most 128 (82 of 86 specs), 85 of 86 at most 192, the
/// largest between 193 and 256. The caps cover the node p98 and the edge p95. Node and edge
/// endpoints are u8 and NO_INDEX is 255, so both caps must stay below 255; MAX_EDGES is the
/// largest edge count that does, MAX_NODES is the 192 that covers p98 under the same
/// limit. A larger graph is refused, never truncated (validate_graph).
pub const MAX_NODES : u32 = 192;
pub const MAX_EDGES : u32 = 254;
pub const MEASURED_NODES_P95 : u32 = 96;
pub const MEASURED_EDGES_P95 : u32 = 128;
pub const NO_LINE : u32 = 0;
pub const NO_INDEX : u32 = 255;

/// Validation verdicts. validate_graph checks graph-level rules in this order, then each node in
/// index order, then each edge in index order, and returns the first rule broken.
pub const GRAPH_OK : u8 = 0;
pub const ERR_GRAPH_VERSION : u8 = 1;
pub const ERR_SPEC_PATH : u8 = 2;
pub const ERR_TOO_MANY_NODES : u8 = 3;
pub const ERR_TOO_MANY_EDGES : u8 = 4;
pub const ERR_MODULE : u8 = 5;
pub const ERR_NODE_KIND : u8 = 6;
pub const ERR_LABEL : u8 = 7;
pub const ERR_NODE_NAME : u8 = 8;
pub const ERR_SPAN_ORDER : u8 = 9;
pub const ERR_SPAN_OUTSIDE : u8 = 10;
pub const ERR_SPAN_MISSING : u8 = 11;
pub const ERR_EDGE_KIND : u8 = 12;
pub const ERR_EDGE_DANGLING : u8 = 13;
pub const ERR_EDGE_ENDPOINT_KIND : u8 = 14;
pub const ERR_EDGE_UNKNOWN_NODE : u8 = 15;
pub const ERR_EDGE_LABEL : u8 = 16;
pub const ERR_EDGE_LINE : u8 = 17;
pub const ERR_DUPLICATE_EDGE : u8 = 18;
pub const VERDICT_KINDS : u8 = 19;

/// One spec graph. Node arrays are indexed by node number, edge arrays by edge number; entries at
/// or past node_count / edge_count are not read. Node 0 is the module and spans the whole file.
/// Spans are 1-based, inclusive source lines of the file at spec_path.
pub struct SpecGraph {
    ir_version: u32,
    spec_path: str,
    line_count: u32,
    node_count: u32,
    node_kind: [192]u8,
    node_label: [192]u8,
    node_name: [192]str,
    line_start: [192]u32,
    line_end: [192]u32,
    edge_count: u32,
    edge_kind: [254]u8,
    edge_from: [254]u8,
    edge_to: [254]u8,
    edge_label: [254]u8,
    edge_line: [254]u32,
}

/// One node read out of a graph: the record a node inspector shows.
pub struct SpecGraphNode {
    kind: u8,
    label: u8,
    name: str,
    line_start: u32,
    line_end: u32,
}

pub fn kind_bit(k: u8) -> u32 {
    return (1 as u32) << (k as u32);
}

pub fn valid_node_kind(k: u8) -> bool {
    return k < NODE_KINDS;
}

pub fn valid_edge_kind(k: u8) -> bool {
    return k < EDGE_KINDS;
}

pub fn valid_label(l: u8) -> bool {
    return l < LABEL_KINDS;
}

/// The code of a node kind asked for by name, or NO_CODE.
pub fn node_kind_id(name: str) -> u8 {
    var i : u32 = 0;
    while (i < (NODE_KINDS as u32)) {
        if (NODE_KIND_NAMES[i as usize] == name) { return i as u8; }
        i = i + 1;
    }
    return NO_CODE;
}

pub fn edge_kind_id(name: str) -> u8 {
    var i : u32 = 0;
    while (i < (EDGE_KINDS as u32)) {
        if (EDGE_KIND_NAMES[i as usize] == name) { return i as u8; }
        i = i + 1;
    }
    return NO_CODE;
}

pub fn label_id(name: str) -> u8 {
    var i : u32 = 0;
    while (i < (LABEL_KINDS as u32)) {
        if (LABEL_NAMES[i as usize] == name) { return i as u8; }
        i = i + 1;
    }
    return NO_CODE;
}

/// Every name in the three tables maps back to its own code.
pub fn name_tables_round_trip() -> bool {
    var k : u32 = 0;
    while (k < (NODE_KINDS as u32)) {
        if (node_kind_id(NODE_KIND_NAMES[k as usize]) != (k as u8)) { return false; }
        k = k + 1;
    }
    var e : u32 = 0;
    while (e < (EDGE_KINDS as u32)) {
        if (edge_kind_id(EDGE_KIND_NAMES[e as usize]) != (e as u8)) { return false; }
        e = e + 1;
    }
    var l : u32 = 0;
    while (l < (LABEL_KINDS as u32)) {
        if (label_id(LABEL_NAMES[l as usize]) != (l as u8)) { return false; }
        l = l + 1;
    }
    return true;
}

/// Node n has a span and the span holds `line`.
pub fn span_holds(g: SpecGraph, n: u32, line: u32) -> bool {
    let k : usize = n as usize;
    if (g.line_start[k] == NO_LINE) { return false; }
    return g.line_start[k] <= line and line <= g.line_end[k];
}

/// The rules one node must meet, in order: a known kind, a known label, a name, an ordered span
/// inside the file, a span when it is EXACT or SUGGESTED, and only node 0 may be the module.
pub fn validate_node(g: SpecGraph, n: u32) -> u8 {
    let k : usize = n as usize;
    if (valid_node_kind(g.node_kind[k]) == false) { return ERR_NODE_KIND; }
    if (valid_label(g.node_label[k]) == false) { return ERR_LABEL; }
    if (g.node_name[k] == "") { return ERR_NODE_NAME; }
    let s : u32 = g.line_start[k];
    let e : u32 = g.line_end[k];
    if (s > e) { return ERR_SPAN_ORDER; }
    if (s == NO_LINE and e != NO_LINE) { return ERR_SPAN_ORDER; }
    if (e > g.line_count) { return ERR_SPAN_OUTSIDE; }
    let l : u8 = g.node_label[k];
    if (s == NO_LINE and (l == LABEL_EXACT or l == LABEL_SUGGESTED)) { return ERR_SPAN_MISSING; }
    if (n > 0 and g.node_kind[k] == NODE_MODULE) { return ERR_MODULE; }
    return GRAPH_OK;
}

/// The rules one edge must meet, in order: a known kind; both endpoints exist; their kinds are
/// allowed for the edge kind; neither is UNKNOWN; a label that is not UNKNOWN and no stronger than
/// either endpoint; a source line inside an endpoint's span (required unless the edge is
/// DERIVED); and no earlier edge with the same kind and endpoints.
pub fn validate_edge(g: SpecGraph, j: u32) -> u8 {
    let k : usize = j as usize;
    let ek : u8 = g.edge_kind[k];
    if (valid_edge_kind(ek) == false) { return ERR_EDGE_KIND; }
    let f : u32 = g.edge_from[k] as u32;
    let t : u32 = g.edge_to[k] as u32;
    if (f >= g.node_count or t >= g.node_count) { return ERR_EDGE_DANGLING; }
    let fk : u8 = g.node_kind[f as usize];
    let tk : u8 = g.node_kind[t as usize];
    if ((EDGE_FROM_KINDS[ek as usize] & kind_bit(fk)) == 0) { return ERR_EDGE_ENDPOINT_KIND; }
    if ((EDGE_TO_KINDS[ek as usize] & kind_bit(tk)) == 0) { return ERR_EDGE_ENDPOINT_KIND; }
    let fl : u8 = g.node_label[f as usize];
    let tl : u8 = g.node_label[t as usize];
    if (fl == LABEL_UNKNOWN or tl == LABEL_UNKNOWN) { return ERR_EDGE_UNKNOWN_NODE; }
    let el : u8 = g.edge_label[k];
    if (el >= LABEL_UNKNOWN) { return ERR_EDGE_LABEL; }
    if (el < fl or el < tl) { return ERR_EDGE_LABEL; }
    let line : u32 = g.edge_line[k];
    if (line == NO_LINE) {
        if (el != LABEL_DERIVED) { return ERR_EDGE_LINE; }
    } else {
        if (span_holds(g, f, line) == false and span_holds(g, t, line) == false) { return ERR_EDGE_LINE; }
    }
    var i : u32 = 0;
    while (i < j) {
        let m : usize = i as usize;
        if (g.edge_kind[m] == ek and g.edge_from[m] == g.edge_from[k] and g.edge_to[m] == g.edge_to[k]) { return ERR_DUPLICATE_EDGE; }
        i = i + 1;
    }
    return GRAPH_OK;
}

/// Graph-level rules, before any node is read: version, a spec path and a line count, capacity,
/// and a module at node 0 whose span is the whole file.
pub fn validate_graph_header(g: SpecGraph) -> u8 {
    if (g.ir_version != GRAPH_IR_VERSION) { return ERR_GRAPH_VERSION; }
    if (g.spec_path == "" or g.line_count == 0) { return ERR_SPEC_PATH; }
    if (g.node_count > MAX_NODES) { return ERR_TOO_MANY_NODES; }
    if (g.edge_count > MAX_EDGES) { return ERR_TOO_MANY_EDGES; }
    if (g.node_count == 0) { return ERR_MODULE; }
    if (g.node_kind[0] != NODE_MODULE) { return ERR_MODULE; }
    if (g.line_start[0] != 1 or g.line_end[0] != g.line_count) { return ERR_MODULE; }
    return GRAPH_OK;
}

/// GRAPH_OK, or the first rule the graph breaks.
pub fn validate_graph(g: SpecGraph) -> u8 {
    let h : u8 = validate_graph_header(g);
    if (h != GRAPH_OK) { return h; }
    var n : u32 = 0;
    while (n < g.node_count) {
        let v : u8 = validate_node(g, n);
        if (v != GRAPH_OK) { return v; }
        n = n + 1;
    }
    var j : u32 = 0;
    while (j < g.edge_count) {
        let w : u8 = validate_edge(g, j);
        if (w != GRAPH_OK) { return w; }
        j = j + 1;
    }
    return GRAPH_OK;
}

/// The first node that breaks a rule, or NO_INDEX when the header fails or no node does.
pub fn first_bad_node(g: SpecGraph) -> u32 {
    if (validate_graph_header(g) != GRAPH_OK) { return NO_INDEX; }
    var n : u32 = 0;
    while (n < g.node_count) {
        if (validate_node(g, n) != GRAPH_OK) { return n; }
        n = n + 1;
    }
    return NO_INDEX;
}

/// The first edge that breaks a rule, or NO_INDEX when the header or a node fails or no edge does.
pub fn first_bad_edge(g: SpecGraph) -> u32 {
    if (validate_graph_header(g) != GRAPH_OK) { return NO_INDEX; }
    if (first_bad_node(g) != NO_INDEX) { return NO_INDEX; }
    var j : u32 = 0;
    while (j < g.edge_count) {
        if (validate_edge(g, j) != GRAPH_OK) { return j; }
        j = j + 1;
    }
    return NO_INDEX;
}

/// Node -> source: the record of node n, span included.
pub fn node_at(g: SpecGraph, n: u32) -> SpecGraphNode {
    let k : usize = n as usize;
    return SpecGraphNode { kind: g.node_kind[k], label: g.node_label[k], name: g.node_name[k], line_start: g.line_start[k], line_end: g.line_end[k] };
}

/// Source -> node: the innermost node whose span holds `line` (the shortest span; on a tie, the
/// lower node number), or NO_INDEX when no node does. A comment line inside the file belongs to
/// the module.
pub fn node_at_line(g: SpecGraph, line: u32) -> u32 {
    var best : u32 = NO_INDEX;
    var best_len : u32 = 0;
    var n : u32 = 0;
    while (n < g.node_count) {
        if (span_holds(g, n, line)) {
            let len : u32 = g.line_end[n as usize] - g.line_start[n as usize];
            if (best == NO_INDEX or len < best_len) {
                best = n;
                best_len = len;
            }
        }
        n = n + 1;
    }
    return best;
}

pub fn count_node_kind(g: SpecGraph, k: u8) -> u32 {
    var c : u32 = 0;
    var n : u32 = 0;
    while (n < g.node_count) {
        if (g.node_kind[n as usize] == k) { c = c + 1; }
        n = n + 1;
    }
    return c;
}

pub fn count_node_label(g: SpecGraph, l: u8) -> u32 {
    var c : u32 = 0;
    var n : u32 = 0;
    while (n < g.node_count) {
        if (g.node_label[n as usize] == l) { c = c + 1; }
        n = n + 1;
    }
    return c;
}

pub fn count_edge_kind(g: SpecGraph, k: u8) -> u32 {
    var c : u32 = 0;
    var j : u32 = 0;
    while (j < g.edge_count) {
        if (g.edge_kind[j as usize] == k) { c = c + 1; }
        j = j + 1;
    }
    return c;
}

pub fn count_edge_label(g: SpecGraph, l: u8) -> u32 {
    var c : u32 = 0;
    var j : u32 = 0;
    while (j < g.edge_count) {
        if (g.edge_label[j as usize] == l) { c = c + 1; }
        j = j + 1;
    }
    return c;
}

/// There is an edge of kind k from f to t.
pub fn has_edge(g: SpecGraph, k: u8, f: u32, t: u32) -> bool {
    var j : u32 = 0;
    while (j < g.edge_count) {
        let m : usize = j as usize;
        if (g.edge_kind[m] == k and (g.edge_from[m] as u32) == f and (g.edge_to[m] as u32) == t) { return true; }
        j = j + 1;
    }
    return false;
}

/// How many tests, invariants and benches exercise node n (its TESTED_BY edges).
pub fn tests_of(g: SpecGraph, n: u32) -> u32 {
    var c : u32 = 0;
    var j : u32 = 0;
    while (j < g.edge_count) {
        let m : usize = j as usize;
        if (g.edge_kind[m] == EDGE_TESTED_BY and (g.edge_from[m] as u32) == n) { c = c + 1; }
        j = j + 1;
    }
    return c;
}

/// The DERIVED rule for TESTED_BY: fn f is tested by t exactly when t is a test, invariant or
/// bench that CALLS f. True when the graph's TESTED_BY edges are that set and nothing else.
pub fn tested_by_matches_calls(g: SpecGraph) -> bool {
    let checkers : u32 = kind_bit(NODE_TEST) | kind_bit(NODE_INVARIANT) | kind_bit(NODE_BENCH);
    var j : u32 = 0;
    while (j < g.edge_count) {
        let m : usize = j as usize;
        let f : u32 = g.edge_from[m] as u32;
        let t : u32 = g.edge_to[m] as u32;
        if (g.edge_kind[m] == EDGE_TESTED_BY) {
            if (has_edge(g, EDGE_CALLS, t, f) == false) { return false; }
        }
        if (g.edge_kind[m] == EDGE_CALLS and (kind_bit(g.node_kind[f as usize]) & checkers) != 0) {
            if (has_edge(g, EDGE_TESTED_BY, t, f) == false) { return false; }
        }
        j = j + 1;
    }
    return true;
}

/// The fns no test, invariant or bench exercises.
pub fn untested_fns(g: SpecGraph) -> u32 {
    var c : u32 = 0;
    var n : u32 = 0;
    while (n < g.node_count) {
        if (g.node_kind[n as usize] == NODE_FN and tests_of(g, n) == 0) { c = c + 1; }
        n = n + 1;
    }
    return c;
}

/// The ui_plan widget that draws a node. A SUGGESTED or UNKNOWN node is drawn as plain text, never
/// as a widget that presents a verified property (a formula, a run button, a metrics table): ui_plan
/// IR version 1 has no way to badge a widget as a guess, so a guess gets no such widget.
pub fn node_widget(kind: u8, label: u8) -> u8 {
    if (valid_label(label) == false or label == LABEL_SUGGESTED or label == LABEL_UNKNOWN) { return WIDGET_TEXT_BLOCK; }
    if (kind == NODE_MODULE or kind == NODE_USE) { return WIDGET_HONEYCOMB_CARD; }
    if (kind == NODE_CONST or kind == NODE_FN) { return WIDGET_FORMULA_VIEW; }
    if (kind == NODE_TEST or kind == NODE_INVARIANT) { return WIDGET_RUN_BUTTON; }
    if (kind == NODE_BENCH) { return WIDGET_METRICS_TABLE; }
    return WIDGET_TEXT_BLOCK;
}

/// The ui_plan source kind a node's widget binds to, read from the ui_plan catalog. Source refs:
/// SOURCE_SPEC is the spec path (for a `use`, the imported spec); SOURCE_FORMULA is
/// "<spec path>#<node name>", the form ui_plan's own fixture uses; SOURCE_METRICS is a results
/// file the host declares, which the graph does not name.
pub fn node_source_kind(kind: u8, label: u8) -> u8 {
    return WIDGET_SOURCE[node_widget(kind, label) as usize];
}

/// Every (kind, label) pair, including out-of-range ones, binds to a catalog widget.
pub fn all_bindings_trusted() -> bool {
    var k : u32 = 0;
    while (k <= (NODE_KINDS as u32)) {
        var l : u32 = 0;
        while (l <= (LABEL_KINDS as u32)) {
            if (catalog_widget(node_widget(k as u8, l as u8)) == false) { return false; }
            l = l + 1;
        }
        k = k + 1;
    }
    return true;
}

/// An empty graph of the current version: no path, no nodes, no edges.
pub fn blank_graph() -> SpecGraph {
    return SpecGraph {
        ir_version: GRAPH_IR_VERSION, spec_path: "", line_count: 0, node_count: 0,
        node_kind: [0; 192], node_label: [0; 192],
        node_name: [
            "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
            "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
            "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
            "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
            "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
            "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
            "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
