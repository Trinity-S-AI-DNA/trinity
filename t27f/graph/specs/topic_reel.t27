// SPDX-License-Identifier: Apache-2.0
; specs/t27f/topic_reel.t27 -- the one workflow every T27F topic reel goes through.
; gHashTag/trinity#1677 asks that two very different domains use the same widget and workflow
; "without duplicated orchestration code". A topic reel (reel_t27_basics.t27, reel_gf16_nmse.t27)
; is data: a brief, 27 cells with their measurements, and the slide text. Everything a reel decides
; or checks with that data lives here, once:
;   - the domain is route_brief of the brief's own text (topic_engine.t27, KEYWORD_MATCH);
;   - every cell's STATUS is earned_status of its four measurements (statuses_earned);
;   - a gap is a cell with no source, and it names what is missing (gaps_are_named);
;   - every slide's text fits every preset as the host breaks it (slides_fit, stage_slides_bare).
; A reel calls these from its tests and keeps only the checks that are about its own topic.
; Before 2026-10-17 the first reel carried its own copy of the counting and slide-fit functions; a
; second reel would have copied them again, which is the duplication #1677 rules out.
; phi^2 + 1/phi^2 = 3 | TRINITY

module topic_reel;

use t27f::reel::CELL_COUNT;
use t27f::reel::DEMO_COUNT;
use t27f::reel::DEMO_KIND;
use t27f::reel::PRESET_COUNT;
use t27f::deck::LAYOUT_SPLIT;
use t27f::deck::LAYOUT_STAGE;
use t27f::deck::REGION_TITLE;
use t27f::deck::HEADLINE_PX;
use t27f::deck::BODY_PX;
use t27f::deck::HEADLINE_EM_PERMILLE;
use t27f::deck::BODY_EM_PERMILLE;
use t27f::deck::MAX_ROWS;
use t27f::deck::layout_for;
use t27f::deck::text_fits;
use t27f::deck::chars_per_line;
use t27f::deck::card_inner_w;
use t27f::deck::region_w;
use t27f::topic_engine::STATUS_GAP;
use t27f::topic_engine::STATUS_DRAFT;
use t27f::topic_engine::STATUS_VERIFIED;
use t27f::topic_engine::DOMAIN_RESEARCH;
use t27f::topic_engine::earned_status;

/// Slide rows per demo scene: a reel's ROWS holds DEMO_COUNT * ROWS_PER_SCENE entries, scene-major.
pub const ROWS_PER_SCENE : i32 = 4;

pub fn count_status(status: [27]u8, s: u8) -> i32 {
    var n : i32 = 0;
    var c : i32 = 0;
    while (c < CELL_COUNT) {
        if (status[@intCast(c)] == s) {
            n = n + 1;
        }
        c = c + 1;
    }
    return n;
}

pub fn count_true(xs: [27]bool) -> i32 {
    var n : i32 = 0;
    var c : i32 = 0;
    while (c < CELL_COUNT) {
        if (xs[@intCast(c)]) {
            n = n + 1;
        }
        c = c + 1;
    }
    return n;
}

/// The first cell whose drawn status is not the one the engine says its measurements earned, or -1.
pub fn first_unearned(status: [27]u8, domain: u8, grounded: [27]bool, test_pass: [27]bool, reviewed: [27]bool, live: [27]bool) -> i32 {
    var c : i32 = 0;
    while (c < CELL_COUNT) {
        const i : usize = @intCast(c);
        if (status[i] != earned_status(@intCast(c), domain, grounded[i], test_pass[i], reviewed[i], live[i])) {
            return c;
        }
        c = c + 1;
    }
    return -1;
}

pub fn statuses_earned(status: [27]u8, domain: u8, grounded: [27]bool, test_pass: [27]bool, reviewed: [27]bool, live: [27]bool) -> bool {
    return first_unearned(status, domain, grounded, test_pass, reviewed, live) == -1;
}

/// A gap is named, not blank: a cell is grounded exactly when it has a source, and a cell with no
/// source says what is missing instead.
pub fn gaps_are_named(sources: [27]str, missing: [27]str, grounded: [27]bool) -> bool {
    var c : i32 = 0;
    while (c < CELL_COUNT) {
        const i : usize = @intCast(c);
        const has_source : bool = sources[i].len > 0;
        const has_missing : bool = missing[i].len > 0;
        if (grounded[i] != has_source) {
            return false;
        }
        if (has_missing == has_source) {
            return false;
        }
        c = c + 1;
    }
    return true;
}

pub fn row_count(rows: [20]str, scene: i32) -> i32 {
    var n : i32 = 0;
    var j : i32 = 0;
    while (j < MAX_ROWS) {
        if (rows[@intCast(scene * ROWS_PER_SCENE + j)].len > 0) {
            n = n + 1;
        }
        j = j + 1;
    }
    return n;
}

/// Characters a headline line may hold on this scene's slide, as the host breaks it.
pub fn head_chars(layout: u8, preset: u8) -> i32 {
    if (layout == LAYOUT_SPLIT) {
        return chars_per_line(card_inner_w(preset), HEADLINE_PX[preset], HEADLINE_EM_PERMILLE);
    }
    return chars_per_line(region_w(layout, preset, REGION_TITLE), HEADLINE_PX[preset], HEADLINE_EM_PERMILLE);
}

pub fn row_chars(preset: u8) -> i32 {
    return chars_per_line(card_inner_w(preset), BODY_PX[preset], BODY_EM_PERMILLE);
}

/// Every demo slide fits every preset: one headline line the host never breaks, and card rows it
/// never breaks either. A headline must be one line because the host wraps a title greedily by
/// words, and only a one-line headline is drawn the same on every preset.
pub fn slides_fit(head: [5]str, rows: [20]str) -> bool {
    var s : i32 = 0;
    while (s < DEMO_COUNT) {
        const layout : u8 = layout_for(DEMO_KIND[@intCast(s)]);
        if (head[@intCast(s)].len == 0) {
            return false;
        }
        var p : u8 = 0;
        while (p < PRESET_COUNT) {
            if (text_fits(1, row_count(rows, s), layout, p) == false) {
                return false;
            }
            const head_len : i32 = @intCast(head[@intCast(s)].len);
            if (head_len > head_chars(layout, p)) {
                return false;
            }
            var j : i32 = 0;
            while (j < MAX_ROWS) {
                const row_len : i32 = @intCast(rows[@intCast(s * ROWS_PER_SCENE + j)].len);
                if (row_len > row_chars(p)) {
                    return false;
                }
                j = j + 1;
            }
            p = p + 1;
        }
        s = s + 1;
    }
    return true;
}

/// A stage slide (title or overview) carries its headline on the strip and no card rows.
pub fn stage_slides_bare(rows: [20]str) -> bool {
    var s : i32 = 0;
    while (s < DEMO_COUNT) {
        if (layout_for(DEMO_KIND[@intCast(s)]) == LAYOUT_STAGE and row_count(rows, s) > 0) {
            return false;
        }
        s = s + 1;
    }
    return true;
}

/// Fixture: a research map with every cell grounded and nothing else measured. LEARN steps have
/// their source link and are VERIFIED; PRACTICE and DELIVER ask for a test or a review and stay DRAFT.
pub const FIX_STATUS : [27]u8 = [4, 4, 4, 3, 3, 3, 3, 3, 3, 4, 4, 4, 3, 3, 3, 3, 3, 3, 4, 4, 4, 3, 3, 3, 3, 3, 3];
pub const ALL : [27]bool = [true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true];
pub const NONE : [27]bool = [false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false];
pub const FIX_HEAD : [5]str = ["Title", "Lens", "Focus", "Evidence", "Next"];
pub const FIX_ROWS : [20]str = ["", "", "", "", "", "", "", "", "a row", "", "", "", "a row", "a row", "", "", "a row", "", "", ""];
pub const FIX_LONG : [20]str = ["", "", "", "", "", "", "", "", "a row far too long to sit on one line of the card on any preset at all", "", "", "", "", "", "", "", "", "", "", ""];
pub const FIX_STAGE_ROW : [20]str = ["a row on the title strip", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""];

test counts_are_counts {
    assert count_true(ALL) == 27;
    assert count_true(NONE) == 0;
    assert count_status(FIX_STATUS, STATUS_VERIFIED) == 9;
    assert count_status(FIX_STATUS, STATUS_DRAFT) == 18;
    assert count_status(FIX_STATUS, STATUS_GAP) == 0;
}

test a_drawn_status_must_be_the_earned_one {
    assert statuses_earned(FIX_STATUS, DOMAIN_RESEARCH, ALL, NONE, NONE, NONE);
    // one cell drawn better than its measurements: caught, and at that cell
    var wrong : [27]u8 = FIX_STATUS;
    wrong[3] = STATUS_VERIFIED;
    assert statuses_earned(wrong, DOMAIN_RESEARCH, ALL, NONE, NONE, NONE) == false;
    assert first_unearned(wrong, DOMAIN_RESEARCH, ALL, NONE, NONE, NONE) == 3;
    // the same drawing is right once a test passes for every cell: PRACTICE turns VERIFIED too
    assert first_unearned(FIX_STATUS, DOMAIN_RESEARCH, ALL, ALL, NONE, NONE) == 3;
    // no source anywhere: every cell is a gap, so the fixture is wrong from cell 0
    assert first_unearned(FIX_STATUS, DOMAIN_RESEARCH, NONE, NONE, NONE, NONE) == 0;
}

test a_gap_names_what_is_missing {
    var sources : [27]str = ["s", "s", "s", "s", "s", "s", "s", "s", "s", "s", "s", "s", "s", "s", "s", "s", "s", "s", "s", "s", "s", "s", "s", "s", "s", "s", "s"];
    var missing : [27]str = ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""];
    assert gaps_are_named(sources, missing, ALL);
    var grounded : [27]bool = ALL;
    // a gap with nothing said about it is refused
    sources[5] = "";
    grounded[5] = false;
    assert gaps_are_named(sources, missing, grounded) == false;
    missing[5] = "the run that would ground it";
    assert gaps_are_named(sources, missing, grounded);
    // a grounded cell may not also claim to be missing something, nor a sourceless one be grounded
    missing[6] = "x";
    assert gaps_are_named(sources, missing, grounded) == false;
    missing[6] = "";
    assert gaps_are_named(sources, missing, ALL) == false;
}

test slide_text_fits_or_is_refused {
    assert row_count(FIX_ROWS, 2) == 1;
    assert row_count(FIX_ROWS, 3) == 2;
    assert slides_fit(FIX_HEAD, FIX_ROWS);
    assert slides_fit(FIX_HEAD, FIX_LONG) == false;
    var long_head : [5]str = FIX_HEAD;
    long_head[0] = "A headline much too long to stay on one line of the title strip";
    assert slides_fit(long_head, FIX_ROWS) == false;
    var no_head : [5]str = FIX_HEAD;
    no_head[4] = "";
    assert slides_fit(no_head, FIX_ROWS) == false;
}

test stage_slides_carry_no_card_text {
    // why a headline is one line: on the wide frame a second stage line would not fit the strip
    assert text_fits(2, 0, LAYOUT_STAGE, 0) == false;
    assert stage_slides_bare(FIX_ROWS);
    assert stage_slides_bare(FIX_STAGE_ROW) == false;
}
