; specs/widgets/hive-master-red.t27 -- Inherited red: what master's runs say about a red check
; Source of truth for public/widgets/hive-master-red/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-master-red/logic.js -- the fn
; bodies of gHashTag/t27 specs/queen/merger_gate.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 15 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader taps each of four master runs to change its result and whether it ran at
; or after the PR's merge base, and whether the bee named the check. Each rung is run_says of its
; run and the running look_back from MASTER_UNKNOWN; the gate is discount_holds(bee named, the
; result).

; WHAT IT DOES NOT CLAIM:  it does not read GitHub Actions: the runs are what the reader taps.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_master_red;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-master-red";
pub const TITLE : str = "Inherited red: what master's runs say about a red check";
pub const DESCRIPTION : str = "The bee says a red check is red on master too. The merger reads master itself, newest run first: a cancelled run is looked past, and only a failure at or after the merge base discounts.";
pub const IMAGE_ALT : str = "Inherited red card: four master runs, newest first: cancelled, failure, success, failure, all at or after the merge base. The top rung says unknown and is looked past, the next says red and decides; the look-back reads MASTER RED and the discount holds, green.";
pub const HOOK : str = "On 2026-10-06 a PR merged red: master's run was cancelled and read as red. A cancelled run says nothing about the code; only a completed failure counts.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/queen/merger_gate.t27 (t27 master c42f8fb40): every value on the page is run_says, look_back and discount_holds, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 15 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_RUNS : u8 = 4;
pub const K_RUN_KINDS : u8 = 8;
pub const K_MASTER_UNKNOWN : u8 = 0;
pub const K_PRESET_R0 : [4]u8 = [3, 3, 3, 1];
pub const K_PRESET_R1 : [4]u8 = [1, 3, 1, 1];
pub const K_PRESET_R2 : [4]u8 = [2, 3, 2, 2];
pub const K_PRESET_R3 : [4]u8 = [1, 3, 1, 1];
pub const K_PRESET_BASE : [4]u8 = [15, 15, 1, 15];
pub const K_PRESET_NAMED : [4]u8 = [1, 1, 1, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["Cancelled, then a failure", "Only cancelled runs (#6956)", "Failure before the merge base", "Bee did not name it"];
pub const SAY_ASK : str = "The bee says this red check is red on master too. Is it?";
pub const SAY_RUN_NAMES : [8]str = ["missing", "failure", "success", "cancelled", "skipped", "timed out", "running", "other"];
pub const SAY_MASTER_NAMES : [3]str = ["UNKNOWN", "MASTER RED", "MASTER GREEN"];
pub const SAY_RUN : str = "master run {0}, newest first";
pub const SAY_AFTER : str = "at or after the merge base";
pub const SAY_BEFORE : str = "before the merge base";
pub const SAY_TAP : str = "tap the result to change it";
pub const SAY_NAMED : str = "the bee named this check";
pub const SAY_SAYS : str = "says";
pub const SAY_SO_FAR : str = "so far";
pub const SAY_HOLDS : str = "The discount holds: the red is inherited";
pub const SAY_FAILS : str = "No discount: the red blocks";
pub const SAY_NOTE : str = "The newest decisive run wins: a cancelled newest run is looked past, a success is not. A run older than the merge base is not evidence about the code the PR started from.";
pub const SAY_SOURCE : str = "Logic: t27 spec queen/merger_gate.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test four_runs_eight_kinds {
    assert K_RUNS == 4;
    assert K_RUN_KINDS == 8;
    assert K_MASTER_UNKNOWN == 0;
}

test the_incident_preset_is_all_cancelled {
    assert K_PRESET_R0[1] == 3;
    assert K_PRESET_R3[1] == 3;
    assert K_PRESET_BASE[0] == 15;
}
