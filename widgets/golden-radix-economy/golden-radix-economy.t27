// SPDX-License-Identifier: Apache-2.0
; specs/widgets/golden-radix-economy.t27 -- the infographic of lesson 5 of the GoldenFloat course (specs/course/goldenfloat.t27)
; Source of truth for public/widgets/golden-radix-economy/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/math/radix_economy.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_golden_radix_economy;

pub const KIND : str = "widget-tool";
pub const ID : str = "golden-radix-economy";
pub const TITLE : str = "GoldenFloat 5: why base three";
pub const DESCRIPTION : str = "Radix economy ln(b) / b for bases 2, 3 and e, and 27 trits in bits, read from radix_economy.t27. Lesson 5 of the GoldenFloat course.";
pub const IMAGE_ALT : str = "A black and white table, Radix economy E(b) = ln(b) / b, as the spec writes it: E(2) = ln 2 / 2, 0.34657, E_BASE2; E(3) = ln 3 / 3, 0.36620, E_BASE3; E(e) = 1 / e, 0.36788, E_OPTIMAL; Bits per trit, 1.58496, LOG2_3; 27 balanced trits, 42 bits, ternary_range(27).";
pub const HOOK : str = "ln(b) / b peaks at e; base 3 reaches 0.995 of the peak, base 2 less.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/math/radix_economy.t27, read when the course was authored; every number in the table is a constant, a test value or arithmetic of that file", "Nothing on this page was measured on hardware or timed; a value written into a test is said to be written in, not computed"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Radix economy E(b) = ln(b) / b, as the spec writes it";
pub const SAY_TABLE_HEAD : [3]str = ["Quantity", "Value", "Spec constant"];
pub const SAY_TABLE_CELLS : [15]str = ["E(2) = ln 2 / 2", "0.34657", "E_BASE2", "E(3) = ln 3 / 3", "0.36620", "E_BASE3", "E(e) = 1 / e", "0.36788", "E_OPTIMAL", "Bits per trit", "1.58496", "LOG2_3", "27 balanced trits", "42 bits", "ternary_range(27)"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 5;
pub const K_TABLE_CELLS : u16 = 15;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "Where the peak sits";
pub const SAY_FLOW_STEPS : [3]str = ["E(b) = ln(b) / b", "Peak at b = e", "E(3) / E(e) >= 0.995"];
pub const K_FLOW_STEPS : u8 = 3;
pub const SAY_NOTE : str = "These are arguments about digits, written into constants; nothing here was timed on a ternary machine.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 3;
    assert K_FLOW_STEPS > 1;
}
