// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-key-rest.t27 -- How long a refused key rests
; Source of truth for public/widgets/hive-key-rest/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-key-rest/logic.js -- the fn
; bodies of gHashTag/t27 specs/queen/key_failover.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 17 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader picks a kind and the strikes in a row. Every rung is
; cooldown_seconds(transient, strikes); the dial and the verdict are cooldown_seconds of the picked
; kind.

; WHAT IT DOES NOT CLAIM:  it times nothing: the strikes are what the reader sets.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_key_rest;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-key-rest";
pub const TITLE : str = "How long a refused key rests";
pub const DESCRIPTION : str = "A transient refusal rests the key 15 s, doubled per strike in a row, never past 240 s. A spent quota or a refused key closes it for 1800 s. Drag the strikes.";
pub const IMAGE_ALT : str = "Key rest card: a transient refusal after 3 strikes. Rungs for 0 to 6 strikes read 15, 30, 60, 120, 240, 240, 240 seconds, the fourth lit. The dial shows 120 s against the 1800 s long break.";
pub const HOOK : str = "Long enough that the next bee does not hit the same overloaded key at once, short enough that 34 keys are never all resting through a one-minute burst.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/queen/key_failover.t27 (t27 master c42f8fb40): every value on the page is cooldown_seconds, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 17 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_STRIKES_MAX : u8 = 8;
pub const K_KE_TRANSIENT : u8 = 1;
pub const K_RUNGS : u8 = 7;
pub const K_COOL_BASE_SECONDS : u32 = 15;
pub const K_COOL_CAP_SECONDS : u32 = 240;
pub const K_KEY_BREAK_SECONDS : u32 = 1800;
pub const K_PRESET_KIND : [4]u8 = [1, 1, 2, 4];
pub const K_PRESET_STRIKES : [4]u8 = [3, 6, 0, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["Transient, 3 strikes", "Transient, 6 strikes", "Quota spent", "A bad request"];
pub const SAY_ASK : str = "How long should a key rest after it was refused?";
pub const SAY_KIND : str = "kind of refusal";
pub const SAY_KIND_NAMES : [5]str = ["ok", "transient", "quota", "auth", "request"];
pub const SAY_STRIKES : str = "strikes in a row before this one";
pub const SAY_RUNG : str = "after {0} in a row";
pub const SAY_REST : str = "rests {0} s";
pub const SAY_DIAL : str = "of the {0} s break";
pub const SAY_NONE : str = "no rest";
pub const SAY_NOTE : str = "The cap is the base doubled exactly four times, so the doubling meets 240 and never steps past it. A rest is always shorter than the break, so a 1305 can never close a key.";
pub const SAY_SOURCE : str = "Logic: t27 spec queen/key_failover.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_rest_and_the_break {
    assert K_COOL_BASE_SECONDS == 15;
    assert K_COOL_CAP_SECONDS == 240;
    assert K_KEY_BREAK_SECONDS == 1800;
}

test the_rungs_fit_the_slider {
    assert K_RUNGS <= K_STRIKES_MAX;
    assert K_PRESET_STRIKES[1] < K_RUNGS;
}
