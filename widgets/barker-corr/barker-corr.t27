// SPDX-License-Identifier: Apache-2.0
; specs/widgets/barker-corr.t27 -- a correlator finds the frame: Barker-13 detection from the ZeroDSP BPSK modem spec
; Source of truth for public/widgets/barker-corr/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/barker-corr/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/bpsk.t27 (t27 master) compiled to wasm, beside its copy logic.t27.
; Lesson 25 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: a stream of 32 chips carries the 13-chip Barker preamble at an offset the reader sets;
; the reader taps chips to flip them (noise) or inverts the whole stream (a 180-degree carrier). The chips
; are pushed one by one into the 13-chip window of the modem spec (rx_push) and correlated (correlate);
; stems show the correlation at every position, green where sync_locked() fires at the threshold of 9.

; WHAT IT DOES NOT CLAIM: hard-decided chips only, as the modem core takes them; soft decisions and carrier recovery are out.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_barker_corr;

pub const KIND : str = "widget-tool";
pub const ID : str = "barker-corr";
pub const TITLE : str = "A correlator finds the frame: Barker-13 in a stream of chips";
pub const DESCRIPTION : str = "Slide a Barker-13 preamble through a stream of chips and watch the correlator peak at 13 where it lines up. Flip chips to add noise; see when the lock fails.";
pub const IMAGE_ALT : str = "Barker correlator card: 32 chips with the preamble at chip 9. The correlation stays small everywhere but one position, where it reaches 13 and crosses the lock threshold of 9.";
pub const HOOK : str = "Line up 13 Barker chips and the correlator reads 13; nowhere else does it get near the lock threshold of 9. Two flipped chips still lock.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/bpsk.t27 (t27 master): every value on the page is its fn bodies, compiled to wasm (logic.js)", "R. H. Barker, Group synchronizing of binary digital systems, in Communication Theory, Butterworth, 1953: the length-13 code and its sidelobes of at most 1", "gHashTag/t27 specs/fpga/bpsk.t27: the ZeroDSP BPSK modem core, BARKER13_BITS, correlate, rx_push, SYNC_THRESHOLD 9"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_STREAM_CHIPS : u8 = 32;
pub const K_BARKER13_LEN : u8 = 13;
pub const K_BARKER13_BITS : u16 = 5535;
pub const K_SYNC_THRESHOLD : u8 = 9;
pub const K_FILL_BITS : u32 = 2774429293;
pub const K_PRESET_AT : [4]u8 = [9, 9, 9, 3];
pub const K_PRESET_INV : [4]u8 = [0, 0, 1, 0];
pub const K_PRESET_FLIPS : [4]u32 = [0, 33280, 0, 16641];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["clean preamble at 9", "two chips flipped", "inverted carrier", "three flips: does it lock?"];
pub const SAY_AT : str = "Preamble starts at chip";
pub const SAY_PHASE : str = "Carrier phase";
pub const SAY_PHASES : [2]str = ["0 degrees", "180 degrees: inverted"];
pub const SAY_TAP : str = "Tap a chip to flip it. Gold: the preamble, sent with bit 12 of the packed constant first.";
pub const SAY_STREAM_LABEL : str = "The received chips, the preamble shaded";
pub const SAY_CORR_LABEL : str = "The correlation at every window position, with the lock threshold";
pub const SAY_CHIP : str = "chip {0}";
pub const SAY_THRESHOLD : str = "lock at {0}";
pub const SAY_NOTE : str = "A Barker-13 window lined up with itself scores 13; shifted, it scores at most 1. That gap is why the modem can lock on 9 and still ride out flipped chips; an inverted carrier gives -13.";
pub const SAY_PEAK : str = "highest score";
pub const SAY_PEAK_AT : str = "{0} at chip {1}";
pub const SAY_SIDE : str = "largest other |score|";
pub const SAY_LOCKS : str = "positions that lock";
pub const SAY_FLIPS : str = "chips flipped";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/bpsk.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_preamble_fits_the_stream {
    assert K_PRESET_AT[0] + K_BARKER13_LEN <= K_STREAM_CHIPS;
    assert K_BARKER13_LEN == 13;
    assert K_BARKER13_BITS == 5535;
}

test the_threshold_sits_between_sidelobe_and_peak {
    assert K_SYNC_THRESHOLD > 1;
    assert K_SYNC_THRESHOLD < K_BARKER13_LEN;
    assert K_PRESET_INV[2] == 1;
}
