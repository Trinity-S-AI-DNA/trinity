// SPDX-License-Identifier: Apache-2.0
; specs/widgets/booth-radix4.t27 -- radix-4 Booth: recode the multiplier into digits -2..+2 and halve the partial products
; Source of truth for public/widgets/booth-radix4/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/booth-radix4/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/multipliers.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 5 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader sets two signed 8-bit numbers. The multiplier's bits are read in overlapping
; groups of three (with an implicit 0 below bit 0); each group becomes a digit from -2 to +2, each digit one
; partial product: digit x a x 4^k. Their sum is the product. The recoding table is read off the spec.

; WHAT IT DOES NOT CLAIM: 8-bit operands only; the hardware cost of the negation (an inverted row and a +1) is not drawn.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_booth_radix4;

pub const KIND : str = "widget-tool";
pub const ID : str = "booth-radix4";
pub const TITLE : str = "Booth's trick: half the partial products, signs for free";
pub const DESCRIPTION : str = "Set two signed numbers and watch the multiplier recoded into digits -2..+2, read three bits at a time. Four partial products instead of eight, and two's complement just works.";
pub const IMAGE_ALT : str = "Booth radix-4 card: 3 x 6. The bits of 6 read in overlapping groups give the digits -2, +2, 0, 0, so the partial products are -6 and +24, which sum to 18.";
pub const HOOK : str = "3 x 6 in radix-4 Booth: digits -2, +2, 0, 0. Two partial products instead of two of eight, and negative numbers need no special case.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/fpga/dsp/multipliers.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "A. D. Booth, A signed binary multiplication technique, Q. J. Mech. Appl. Math. 4(2), 1951; O. L. MacSorley, High-speed arithmetic in binary computers, Proc. IRE 49, 1961: the radix-4 form"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_BITS : u8 = 8;
pub const K_DIGITS : u8 = 4;
pub const K_OFFSET : u16 = 128;
pub const K_MASK : u16 = 255;
pub const K_PRESET_A_BIASED : [4]u16 = [131, 121, 255, 0];
pub const K_PRESET_B_BIASED : [4]u16 = [134, 133, 0, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["3 x 6: digits -2, +2", "-7 x 5: signs", "127 x -128", "-128 x -128: the corner"];
pub const SAY_A : str = "a (multiplicand)";
pub const SAY_B : str = "b (multiplier)";
pub const SAY_BIASED : str = "Presets are stored as value + 128: a t27 constant is never negative.";
pub const SAY_RECODE_LABEL : str = "The bits of b in overlapping groups of three, and the digit each group becomes";
pub const SAY_PP_LABEL : str = "The partial products digit x a x 4^k as signed bars, and their sum";
pub const SAY_TABLE_LABEL : str = "The recoding table: every group of three bits and its digit";
pub const SAY_IMPLICIT : str = "b-1 = 0";
pub const SAY_GROUP : str = "k = {0}";
pub const SAY_DIGITS_ROW : str = "digits, low first from the right";
pub const SAY_PP : str = "{0} x {1} x 4^{2} = {3}";
pub const SAY_SUM : str = "sum = {0}";
pub const SAY_TABLE_NOTE : str = "A group (b2k+1, b2k, b2k-1) is worth -2 b2k+1 + b2k + b2k-1: the table below is that rule, read off the spec for all eight groups.";
pub const SAY_PRODUCT : str = "a x b";
pub const SAY_BOOTH_ROWS : str = "Booth rows that add";
pub const SAY_PLAIN_ROWS : str = "shift-and-add rows";
pub const SAY_OF : str = "{0} of {1}";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/multipliers.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test four_digits_cover_eight_bits {
    assert K_DIGITS * 2 == K_BITS;
    assert K_OFFSET * 2 == K_MASK + 1;
    assert K_MASK == 255;
}

test the_presets_include_the_corner {
    assert K_PRESET_A_BIASED[3] == 0;
    assert K_PRESET_B_BIASED[3] == 0;
    assert K_PRESET_A_BIASED[0] == K_OFFSET + 3;
    assert K_PRESET_B_BIASED[0] == K_OFFSET + 6;
}
