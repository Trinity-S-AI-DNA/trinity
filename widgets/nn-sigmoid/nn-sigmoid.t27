// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-sigmoid.t27 -- the sigmoid: any number into a probability
; Source of truth for public/widgets/nn-sigmoid/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-sigmoid/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/activation/sigmoid_activation.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 2 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader drags x from -8 to 8. The curve is forward and the slope derivative of
; the spec, which takes the OUTPUT of the sigmoid, as backpropagation does; the tiles read the slope
; at x, at 0 and at the far right.

; WHAT IT DOES NOT CLAIM: the slope bound of 0.25 is read off the compiled curve at x = 0, not
; proved here.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_sigmoid;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-sigmoid";
pub const TITLE : str = "Sigmoid: turn any number into a probability";
pub const DESCRIPTION : str = "Drag along the S-curve: every input lands between 0 and 1, and the slope peaks at 0.25 in the middle and dies away at both ends.";
pub const IMAGE_ALT : str = "Sigmoid card at x = 2: the green S-curve from 0 to 1 over -8..8, the dashed gold slope a bump peaking at 0.25 at x = 0. Tiles read sigmoid 0.8808, slope 0.1050, slope at 0 = 0.2500 and slope at 8 = 0.000335; two bars repeat the output and the slope.";
pub const HOOK : str = "1 / (1 + e^-x) squeezes the whole line into 0..1. Its slope is never above 0.25, which is why deep sigmoid nets learned slowly.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/activation/sigmoid_activation.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 2 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_X_LO_C : i16 = -800;
pub const K_X_HI_C : i16 = 800;
pub const K_X_STEP_C : u8 = 10;
pub const K_X_TICKS : [5]i8 = [-8, -4, 0, 4, 8];
pub const K_Y_TICKS_C : [5]u8 = [0, 25, 50, 75, 100];
pub const K_PRESET_X_C : [4]i16 = [200, 0, -400, 600];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["x = 2", "x = 0", "x = -4", "x = 6"];
pub const SAY_ASK : str = "How does a neuron turn any number into a probability?";
pub const SAY_X : str = "input x";
pub const SAY_F : str = "sigmoid(x)";
pub const SAY_DF : str = "slope";
pub const SAY_PLOT_LABEL : str = "The sigmoid of x and its slope from -8 to 8, with a cursor you drag";
pub const SAY_BARS_LABEL : str = "The output and the slope at x as bars from 0 to 1";
pub const SAY_OUT : str = "probability";
pub const SAY_GRAD : str = "slope at x";
pub const SAY_AT_ZERO : str = "slope at 0";
pub const SAY_FAR : str = "slope at 8";
pub const SAY_NOTE : str = "The slope is s (1 - s), computed from the output s itself. Far from 0 it is close to nothing, so a saturated sigmoid passes almost no gradient back.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/activation/sigmoid_activation.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_range_is_symmetric {
    assert K_X_LO_C + K_X_HI_C == 0;
    assert K_X_HI_C == 800;
}

test the_axis_spans_zero_to_one {
    assert K_Y_TICKS_C[0] == 0;
    assert K_Y_TICKS_C[4] == 100;
    assert K_PRESET_X_C[1] == 0;
}
