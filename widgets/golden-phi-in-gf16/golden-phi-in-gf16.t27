// SPDX-License-Identifier: Apache-2.0
; specs/widgets/golden-phi-in-gf16.t27 -- the infographic of lesson 6 of the GoldenFloat course (specs/course/goldenfloat.t27)
; Source of truth for public/widgets/golden-phi-in-gf16/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/numeric/gf_competitive.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_golden_phi_in_gf16;

pub const KIND : str = "widget-tool";
pub const ID : str = "golden-phi-in-gf16";
pub const TITLE : str = "GoldenFloat 6: phi in sixteen bits";
pub const DESCRIPTION : str = "The five checks of gf_competitive.t27, read from gf_competitive.t27. Lesson 6 of the GoldenFloat course.";
pub const IMAGE_ALT : str = "A black and white table, The five checks of gf_competitive.t27: gf32_phi_representation, 1.618033988749894, 5e-3; phi_identity_gf16, 2.618015 vs 2.618042, 5e-3; trinity_identity, 2.999954, 1e-4; roundtrip_precision, 1.618034 to 1.618042, 5e-3; accumulation, 999.95 of 1000, 1e-4.";
pub const HOOK : str = "Five checks that GF16 keeps phi, phi^2 = phi + 1 and the 3 of phi^2 + 1/phi^2.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/numeric/gf_competitive.t27, read when the course was authored; every number in the table is a constant, a test value or arithmetic of that file", "Nothing on this page was measured on hardware or timed; a value written into a test is said to be written in, not computed"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "The five checks of gf_competitive.t27";
pub const SAY_TABLE_HEAD : [3]str = ["Test", "Written-in value", "Tolerance"];
pub const SAY_TABLE_CELLS : [15]str = ["gf32_phi_representation", "1.618033988749894", "5e-3", "phi_identity_gf16", "2.618015 vs 2.618042", "5e-3", "trinity_identity", "2.999954", "1e-4", "roundtrip_precision", "1.618034 to 1.618042", "5e-3", "accumulation", "999.95 of 1000", "1e-4"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 5;
pub const K_TABLE_CELLS : u16 = 15;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_NOTE : str = "The values are written into the tests; the spec checks the error arithmetic, not an encoder.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}
