// SPDX-License-Identifier: Apache-2.0
; specs/widgets/basics-many-tests.t27 -- the infographic of lesson 11 of the t27 basics course (specs/course/t27-basics.t27)
; Source of truth for public/widgets/basics-many-tests/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/basics/11_many_tests.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_basics_many_tests;

pub const KIND : str = "widget-tool";
pub const ID : str = "basics-many-tests";
pub const TITLE : str = "t27 basics 11: three tests, one idea each";
pub const DESCRIPTION : str = "The tests of a t27 spec counted one by one, with the asserts in each, from the lesson spec. Lesson 11 of the t27 basics course.";
pub const IMAGE_ALT : str = "A black and white table of three t27 tests from the lesson spec: a_day_has_24_hours with 1 assert, an_hour_has_60_minutes with 2 asserts, a_week_has_7_days with 2 asserts; all pass.";
pub const HOOK : str = "Three small tests beat one long one: a failure names the idea that broke.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/basics/11_many_tests.t27, compiled clean on 7 backends by public/t27/t27_compiler.wasm, whose tests pass in the site test runner", "Compiler verdicts, error lines, code and counts quoted on this page are what the same wasm answered in node 22 when the course was authored; words without a run behind them are said to be read, not run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "The tests of the lesson spec";
pub const SAY_TABLE_HEAD : [3]str = ["Test", "Asserts", "Result"];
pub const SAY_TABLE_CELLS : [9]str = ["a_day_has_24_hours", "1", "pass", "an_hour_has_60_minutes", "2", "pass", "a_week_has_7_days", "2", "pass"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 3;
pub const K_TABLE_CELLS : u16 = 9;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_NOTE : str = "The site test runner counted 3 tests and 5 asserts in the lesson spec.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}
