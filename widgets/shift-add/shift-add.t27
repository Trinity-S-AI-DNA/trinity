// SPDX-License-Identifier: Apache-2.0
; specs/widgets/shift-add.t27 -- shift and add: a product is a sum of shifted partial products
; Source of truth for public/widgets/shift-add/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/shift-add/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/multipliers.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 4 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader sets two 8-bit numbers and steps through the rows: each 1 bit of b adds a copy of a
; shifted left by that bit's position, each 0 bit adds nothing. The running sum grows row by row to the
; product; tiles count the rows that cost an adder input.

; WHAT IT DOES NOT CLAIM: unsigned 8-bit operands only; signed operands are lesson 5 (Booth).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_shift_add;

pub const KIND : str = "widget-tool";
pub const ID : str = "shift-add";
pub const TITLE : str = "Shift and add: a multiplier is a pile of shifted copies";
pub const DESCRIPTION : str = "Pick two 8-bit numbers and step through the partial products: one shifted copy of a for each 1 bit of b, summed row by row into the product.";
pub const IMAGE_ALT : str = "Shift and add card: 200 x 13. The bits of 13 are 1101, so three shifted copies of 200 -- by 0, 2 and 3 places -- are added, and the running sum reaches 2600.";
pub const HOOK : str = "A product is just shifted copies added up: 200 x 13 is 200 + 800 + 1600. Every multiplier in hardware starts here.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/fpga/dsp/multipliers.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Harris and Harris, Digital Design and Computer Architecture, ch. 5: array multipliers"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_BITS : u8 = 8;
pub const K_PRODUCT_BITS : u8 = 16;
pub const K_MAX_OPERAND : u16 = 255;
pub const K_PRESET_A : [4]u16 = [200, 255, 170, 1];
pub const K_PRESET_B : [4]u16 = [13, 255, 85, 128];
pub const K_PRESET_STEP : [4]u8 = [8, 8, 4, 8];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["200 x 13: three rows", "255 x 255: every row", "170 x 85, halfway", "1 x 128: one row"];
pub const SAY_A : str = "a";
pub const SAY_B : str = "b";
pub const SAY_STEP : str = "Rows added so far";
pub const SAY_GRID_LABEL : str = "a, b, the eight partial products and the running sum, as bits";
pub const SAY_ROW_A : str = "a = {0}";
pub const SAY_ROW_B : str = "b = {0}";
pub const SAY_ROW_PP : str = "row {0}: {1}";
pub const SAY_ROW_ZERO : str = "row {0}: zero";
pub const SAY_ROW_SUM : str = "sum of {0} rows";
pub const SAY_PROGRESS : str = "{0} of {1}";
pub const SAY_PRODUCT : str = "a x b";
pub const SAY_ROWS : str = "rows that add";
pub const SAY_OF : str = "{0} of {1}";
pub const SAY_WIDTH : str = "product width";
pub const SAY_BITS_N : str = "{0} bits";
pub const SAY_NOTE : str = "Row i is a shifted left by i when bit i of b is 1, and nothing when it is 0. Two 8-bit numbers make at most a 16-bit product.";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/multipliers.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_product_fits_twice_the_width {
    assert K_PRODUCT_BITS == K_BITS * 2;
    assert K_MAX_OPERAND * K_MAX_OPERAND < 65536;
    assert K_PRESET_A[0] * K_PRESET_B[0] == 2600;
}

test the_presets_step_inside_the_rows {
    assert K_PRESET_STEP[0] == K_BITS;
    assert K_PRESET_STEP[2] < K_BITS;
    assert K_PRESET_B[3] == 128;
}
