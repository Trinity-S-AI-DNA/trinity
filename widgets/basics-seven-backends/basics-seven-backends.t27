// SPDX-License-Identifier: Apache-2.0
; specs/widgets/basics-seven-backends.t27 -- the infographic of lesson 22 of the t27 basics course (specs/course/t27-basics.t27)
; Source of truth for public/widgets/basics-seven-backends/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/basics/22_seven_backends.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_basics_seven_backends;

pub const KIND : str = "widget-tool";
pub const ID : str = "basics-seven-backends";
pub const TITLE : str = "t27 basics 22: one spec, seven backends";
pub const DESCRIPTION : str = "How many bytes each of the 7 t27c backends wrote for one small spec, measured with the real compiler. Lesson 22 of the t27 basics course.";
pub const IMAGE_ALT : str = "A black and white table of the 7 backends of t27c, c, js, rust, ts, verilog, verilog_hir and zig, with whether each compiled the lesson spec and how many bytes of code it wrote.";
pub const HOOK : str = "One small t27 spec, 7 languages out. The bytes each backend wrote.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/basics/22_seven_backends.t27, compiled clean on 7 backends by public/t27/t27_compiler.wasm, whose tests pass in the site test runner", "Compiler verdicts, error lines, code and counts quoted on this page are what the same wasm answered in node 22 when the course was authored; words without a run behind them are said to be read, not run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Backends on the lesson spec";
pub const SAY_TABLE_HEAD : [3]str = ["Backend", "Compiled", "Bytes"];
pub const SAY_TABLE_CELLS : [21]str = ["c", "yes", "1723", "js", "yes", "1253", "rust", "yes", "369", "ts", "yes", "1297", "verilog", "yes", "2546", "verilog_hir", "yes", "360", "zig", "yes", "722"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 7;
pub const K_TABLE_CELLS : u16 = 21;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_NOTE : str = "Byte counts are what t27_compiler.wasm wrote when this page was authored.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}
