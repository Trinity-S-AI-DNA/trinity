// SPDX-License-Identifier: Apache-2.0
; specs/widgets/tc-compare.t27 -- lesson 22 of the course "The ternary machine" (specs/course/ternary-computing.t27)
; Source of truth for public/widgets/tc-compare/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles this
; file, checks its constants, evaluates the tests below and writes the page; the page hands every constant to
; tool.js as window.T27_WIDGET. tool.js draws through ../ternary-kit.js and computes nothing: every number comes
; from public/widgets/tc-compare/logic.js, the fn bodies of the gHashTag/t27 spec in logic.t27, compiled to wasm.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_tc_compare;

pub const KIND : str = "widget-tool";
pub const ID : str = "tc-compare";
pub const TITLE : str = "Compare at the first differing trit";
pub const DESCRIPTION : str = "Two numbers line up trit by trit; the first place from the top where they differ decides. The answer is itself a trit.";
pub const IMAGE_ALT : str = "Compare card: 41 and 39 as five trits each, +---- and 0+++0. They first differ in the top trit, lit gold, and that one trit decides: +1, greater, though 41 shows four minus signs.";
pub const HOOK : str = "Comparing balanced ternary numbers is reading from the left: the first different trit is the answer.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ternary/trits.t27 (t27#8979): every value on the page is its fn bodies, compiled to wasm (logic.js), with 18 tests and 4108 runtime asserts", "D. Knuth, The Art of Computer Programming, vol. 2, section 4.1: balanced ternary"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

pub const SAY_LOADING : str = "Loading";
pub const K_TRITS : u32 = 5;
pub const K_START_A : i32 = 41;
pub const K_START_B : i32 = 39;
pub const SAY_RESULT : str = "{0} is {1} {2}";
pub const SAY_SIGNS : [3]str = ["less than", "equal to", "greater than"];
pub const SAY_EQUAL : str = "All trits agree.";
pub const SAY_AT : str = "They first differ at place {0} (weight {1}).";
pub const SAY_SOURCE : str = "Logic: t27 spec ternary/trits.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_widget_starts_where_its_card_says {
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == false;
}
