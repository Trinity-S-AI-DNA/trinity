// SPDX-License-Identifier: Apache-2.0
// specs/fpga/eye_isi.t27 -- why an eye closes: one-pole channel, NRZ bits, intersymbol interference
// Host: gHashTag/trinity apps/website public/widgets/eye-isi/ (the eye-isi widget): its
//       logic.js is these fn bodies compiled to wasm (scripts/t27-logic.mjs in
//       gHashTag/999-multibots-telegraf, types stripped); the page writes no formula of its own.
//
// THE MODEL: a channel that behaves like one RC pole of time constant TAU (a lossy trace, an
// input capacitance behind a driver resistance) carries NRZ bits of length T, levels 0 and 1.
// Sampled at the end of each bit the received level obeys the first-order recurrence
//     y[n] = a * y[n-1] + (1 - a) * x[n],      a = exp(-T / TAU)
// (the step response 1 - exp(-t/TAU) taken one bit at a time). The worst case for a 1 is a 1
// after a long run of 0s, which reaches only 1 - a; the worst 0 after a long run of 1s stays at
// a. The vertical eye opening at the sampling point is therefore
//     eye(a) = (1 - a) - a = 1 - 2a,
// open while a < 1/2, closed from T = TAU * ln 2 down (H. Johnson and M. Graham, "High-Speed
// Signal Propagation", 2003, ch. 3 and ch. 13 on ISI; any signals text on the first-order step).
// A 2-tap de-emphasis transmitter sends x[n] - c * x[n-1] scaled by 1/(1 - c) and reopens part of it.
//
// THE PATTERN: PRBS7, the polynomial x^7 + x^6 + 1 (ITU-T O.150), a 7-bit Fibonacci LFSR whose
// period is 2^7 - 1 = 127 for any nonzero seed; the widget feeds it through the recurrence and
// overlays the bits into an eye.
//
// exp() is written here as a series with range reduction, so the page and the tests share it.
// WHAT IT DOES NOT CLAIM: jitter, reflections, crosstalk and the receiver's threshold noise are
// out of the model; the sampling point is fixed at the end of the bit. A real channel has more
// than one pole: this one shows the mechanism, not a link budget.
// Claim status: checked by the tests below (exp(-1) = 0.36788, eye at T = TAU is 0.2642, the eye
// closes at T / TAU = ln 2 = 0.6931, PRBS7 period 127).
// phi^2 + 1/phi^2 = 3 | TRINITY

module fpga::eye_isi {

    pub const KIND : str = "widget-logic";
    pub const ID : str = "eye-isi";
    pub const VERSION : u8 = 1;
    pub const LN2 : f64 = 0.6931471805599453;
    pub const PRBS7_PERIOD : u16 = 127;
    pub const PRBS7_SEED : u8 = 127;      // all ones
    pub const BITS_SHOWN : u16 = 254;     // two periods of PRBS7 in the widget

    // e^x for x >= 0: halve x until it is small, sum the series, square back.
    fn exp_pos(x: f64) -> f64 {
        var r : f64 = x;
        var halvings : u8 = 0;
        while (r > 0.0625) {
            r = r / 2.0;
            halvings = halvings + 1;
        }
        var term : f64 = 1.0;
        var sum : f64 = 1.0;
        var n : u8 = 1;
        while (n < 12) {
            term = term * r / (n as f64);
            sum = sum + term;
            n = n + 1;
        }
        var i : u8 = 0;
        while (i < halvings) {
            sum = sum * sum;
            i = i + 1;
        }
        return sum;
    }

    // e^(-x) for x >= 0.
    fn exp_neg(x: f64) -> f64 {
        return 1.0 / exp_pos(x);
    }

    // The pole of one bit: how much of the last level survives the next bit.
    fn pole(bit_ps: f64, tau_ps: f64) -> f64 {
        return exp_neg(bit_ps / tau_ps);
    }

    // One bit through the channel.
    fn next_level(y: f64, x: f64, a: f64) -> f64 {
        return a * y + (1.0 - a) * x;
    }

    // The worst-case vertical eye opening, as a fraction of the full swing; negative = closed.
    fn eye(a: f64) -> f64 {
        return 1.0 - 2.0 * a;
    }

    // The bit time, in units of TAU, below which the eye is shut.
    fn closes_below() -> f64 {
        return LN2;
    }

    // The level a 2-tap de-emphasis transmitter sends for bit x after bit prev, normalised so
    // a long run still reaches 0 and 1: (x - c * prev) / (1 - c).
    fn deemph(x: f64, prev: f64, c: f64) -> f64 {
        return (x - c * prev) / (1.0 - c);
    }

    // PRBS7 (x^7 + x^6 + 1): the next 7-bit state; the new bit enters at the bottom.
    fn prbs7_next(s: u8) -> u8 {
        const bit = ((s >> 6) ^ (s >> 5)) & 1;
        return ((s << 1) | bit) & 127;
    }

    // The bit PRBS7 puts on the wire for a state.
    fn prbs7_bit(s: u8) -> u8 {
        return s & 1;
    }

    // Steps until the state comes back: 127 for any nonzero seed.
    fn prbs7_period(seed: u8) -> u16 {
        var s : u8 = prbs7_next(seed);
        var n : u16 = 1;
        while (s != seed && n < 300) {
            s = prbs7_next(s);
            n = n + 1;
        }
        return n;
    }

    fn near(a: f64, b: f64) -> bool {
        return a - b < 0.0005 && b - a < 0.0005;
    }

    test "exp is the series, not a guess" {
        assert(near(exp_pos(0.0), 1.0));
        assert(near(exp_pos(1.0), 2.71828));
        assert(near(exp_neg(1.0), 0.36788));
        assert(near(exp_neg(3.0), 0.04979));
        assert(near(exp_neg(LN2), 0.5));
    }

    test "a bit as long as TAU leaves a quarter of the eye" {
        assert(near(pole(1000.0, 1000.0), 0.36788));
        assert(near(eye(pole(1000.0, 1000.0)), 0.26424));
        assert(eye(pole(3000.0, 1000.0)) > 0.9);
    }

    test "the eye shuts at T = TAU ln 2" {
        assert(near(eye(pole(closes_below() * 1000.0, 1000.0)), 0.0));
        assert(eye(pole(600.0, 1000.0)) < 0.0);
        assert(eye(pole(800.0, 1000.0)) > 0.0);
    }

    test "the recurrence is the step response one bit at a time" {
        assert(near(next_level(0.0, 1.0, 0.36788), 0.63212));
        assert(near(next_level(next_level(0.0, 1.0, 0.36788), 1.0, 0.36788), 0.86466));
        assert(near(next_level(1.0, 0.0, 0.25), 0.25));
    }

    test "de-emphasis lifts the first bit of a run and keeps a long run at 1" {
        assert(near(deemph(1.0, 1.0, 0.25), 1.0));
        assert(near(deemph(1.0, 0.0, 0.25), 1.33333));
        assert(near(deemph(0.0, 1.0, 0.25), 0.0 - 0.33333));
        assert(near(deemph(0.0, 0.0, 0.25), 0.0));
    }

    test "PRBS7 has period 127 from any nonzero seed" {
        assert(prbs7_period(PRBS7_SEED) == PRBS7_PERIOD);
        assert(prbs7_period(1) == PRBS7_PERIOD);
        assert(prbs7_period(85) == PRBS7_PERIOD);
        assert(prbs7_next(127) == 126);
        assert(prbs7_bit(prbs7_next(127)) == 0);
        assert(prbs7_next(0) == 0);
    }

    test "VERSION says what the header says" {
        assert(VERSION == 1);
        assert(BITS_SHOWN == PRBS7_PERIOD * 2);
        assert(near(closes_below(), 0.69315));
    }
}
// phi^2 + 1/phi^2 = 3 | TRINITY
