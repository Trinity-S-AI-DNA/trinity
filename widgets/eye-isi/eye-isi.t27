// SPDX-License-Identifier: Apache-2.0
; specs/widgets/eye-isi.t27 -- why an eye closes: PRBS7 through one RC pole
; Source of truth for public/widgets/eye-isi/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/eye-isi/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/eye_isi.t27 (t27#8931) compiled to wasm, beside its copy logic.t27.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader sets the bit time T and the channel's time constant TAU (or a bit
; rate), and a de-emphasis tap. The page sends two periods of PRBS7 through the channel, one bit
; at a time and 16 steps inside each bit, overlays every two-bit window into an eye, and prints
; the eye opening it measured beside the formula's worst case 1 - 2 exp(-T/TAU), and the bit time
; below which the eye shuts: TAU ln 2.

; WHAT IT DOES NOT CLAIM: jitter, reflections, crosstalk, noise and a receiver threshold are out;
; one pole is the mechanism, not a link budget.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_eye_isi;

pub const KIND : str = "widget-tool";
pub const ID : str = "eye-isi";
pub const TITLE : str = "Eye and ISI: PRBS7 through one RC pole, and when the eye shuts";
pub const DESCRIPTION : str = "Set the bit time and the channel's time constant. Watch the eye close as bits get shorter, and how much a de-emphasis tap opens it.";
pub const IMAGE_ALT : str = "Eye and ISI card: two periods of PRBS7 through a one-pole channel with the bit time equal to TAU. The eye is open by about a quarter of the swing, as 1 - 2 exp(-1) predicts; below T = TAU ln 2 it shuts.";
pub const HOOK : str = "One RC pole and a bit time of TAU leave a quarter of the eye. At TAU ln 2 it is gone. De-emphasis buys it back.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/eye_isi.t27 (t27#8931): every value on the page is its fn bodies, compiled to wasm (logic.js), with 7 tests", "H. Johnson, M. Graham, High-Speed Signal Propagation, 2003, ch. 3 and ch. 13: intersymbol interference in a first-order channel", "ITU-T O.150: PRBS7, polynomial x^7 + x^6 + 1, period 127"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- The logic spec's own numbers (logic.t27); scripts/widget-logic.mjs holds them equal ------
pub const K_PRBS7_SEED : u8 = 127;
pub const K_PRBS7_PERIOD : u16 = 127;
pub const K_BITS_SHOWN : u16 = 254;

; --- Presets: bit time and TAU in ps, de-emphasis in percent ----------------------------------
pub const K_PRESET_BIT_PS : [4]u16 = [3000, 1000, 600, 600];
pub const K_PRESET_TAU_PS : [4]u16 = [1000, 1000, 1000, 1000];
pub const K_PRESET_DEEMPH_PCT : [4]u8 = [0, 0, 0, 25];
pub const K_START_PRESET : u8 = 1;
pub const K_STEPS_PER_BIT : u8 = 16;
pub const K_MAX_PS : u16 = 20000;
pub const K_MAX_DEEMPH_PCT : u8 = 50;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_LOADING : str = "Loading";
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["T = 3 TAU: wide open", "T = TAU: a quarter left", "T = 0.6 TAU: shut", "T = 0.6 TAU, 25% de-emphasis"];
pub const SAY_BIT : str = "Bit time T, ps";
pub const SAY_TAU : str = "Channel TAU, ps";
pub const SAY_DEEMPH : str = "De-emphasis, %";
pub const SAY_BAD_INPUT : str = "Use whole numbers: times 1 to {0} ps, de-emphasis 0 to {1}%.";
pub const SAY_RATE : str = "{0} Gb/s; T / TAU = {1}";
pub const SAY_OPEN : str = "eye open: {0}% of the swing (measured on {1} bits)";
pub const SAY_SHUT : str = "eye shut: the worst 1 sits {0}% below the worst 0";
pub const SAY_FORMULA : str = "worst case without de-emphasis, 1 - 2 exp(-T/TAU): {0}%";
pub const SAY_LIMIT : str = "shuts below T = TAU ln 2 = {0} ps, above {1} Gb/s";
pub const SAY_SAMPLE : str = "sampling point";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/eye_isi.t27, compiled";

test the_presets_bracket_the_limit {
    assert K_PRESET_BIT_PS[1] == K_PRESET_TAU_PS[1];
    assert K_PRESET_BIT_PS[2] < 694;
    assert K_PRESET_BIT_PS[0] > 693;
    assert K_PRESET_DEEMPH_PCT[3] <= K_MAX_DEEMPH_PCT;
}

test two_periods_of_prbs7 {
    assert K_BITS_SHOWN == K_PRBS7_PERIOD * 2;
    assert K_PRBS7_SEED == 127;
    assert K_CARD_WIDTH == 1200;
}
