// SPDX-License-Identifier: Apache-2.0
// specs/fpga/line_bounce.t27 -- a step down a lossless transmission line: what the far end sees
// Host: gHashTag/trinity apps/website public/widgets/line-bounce/ (the line-bounce widget):
//       its logic.js is these fn bodies compiled to wasm (scripts/t27-logic.mjs in
//       gHashTag/999-multibots-telegraf, types stripped), so the page draws exactly what the
//       tests below assert; it writes no formula of its own.
//
// THE MODEL (the lattice or bounce diagram; H. Johnson and M. Graham, "High-Speed Digital
// Design", 1993, ch. 4; E. Bogatin, "Signal and Power Integrity -- Simplified", 3rd ed., ch. 8):
// a source of open-circuit voltage VS and resistance RS drives a lossless line of impedance Z0
// and one-way delay TD into a load RL. At t = 0 the line looks like Z0, so the wave launched is
//     V0 = VS * Z0 / (RS + Z0).
// At an end of resistance R the wave reflects with
//     gamma(R) = (R - Z0) / (R + Z0)
// so a wave arriving at the load adds wave * (1 + gamma_L) to the load voltage and sends
// wave * gamma_L back; at the source it is multiplied by gamma_S and comes back again. The k-th
// arrival at the load (time (2k - 1) * TD) brings the load voltage to
//     sum over i < k of  V0 * (gamma_L * gamma_S)^i * (1 + gamma_L).
// When the products shrink the voltage settles at the DC divider VS * RL / (RS + RL).
//
// WHAT IT TEACHES: a series-terminated line (RS = Z0) reaches its final value on the first
// arrival; a parallel-terminated one (RL = Z0) never reflects; an unterminated CMOS input
// (RL open) driven by a strong driver (RS < Z0) overshoots and rings, gamma_L * gamma_S < 0.
//
// WHAT IT DOES NOT CLAIM: loss, dispersion, the driver's edge rate, and capacitive loads are
// out of the model; a real trace is not lossless and a real input is not a resistor. OPEN_OHMS
// stands for an open end, so an "open" load reflects 0.9999, not exactly 1.
// Claim status: the arithmetic is checked by the tests below against the textbook lattice of
// VS = 1 V, RS = 25 ohm, Z0 = 50 ohm, open load: 1.333, 0.889, 1.037, 0.988 V.
// phi^2 + 1/phi^2 = 3 | TRINITY

module fpga::line_bounce {

    pub const KIND : str = "widget-logic";
    pub const ID : str = "line-bounce";
    pub const VERSION : u8 = 1;
    pub const OPEN_OHMS : f64 = 1000000.0;   // an open end, as a resistance
    pub const MAX_ARRIVALS : u8 = 12;        // arrivals the widget draws
    pub const MATCH_TOL : f64 = 0.05;        // |gamma| at or under this counts as matched
    pub const SHAPE_MATCHED : u8 = 0;        // the load is matched: one arrival, no reflection
    pub const SHAPE_SOURCE : u8 = 1;         // the source is matched: one reflection, then flat
    pub const SHAPE_RINGS : u8 = 2;          // gamma_L * gamma_S < 0: overshoot and undershoot
    pub const SHAPE_STAIRS : u8 = 3;         // gamma_L * gamma_S > 0: a staircase to the end value

    // How much of a wave an end of resistance r sends back into a line of impedance z0.
    fn gamma(r: f64, z0: f64) -> f64 {
        return (r - z0) / (r + z0);
    }

    // The step the source launches: the divider of RS and the line's Z0.
    fn launch(vs: f64, rs: f64, z0: f64) -> f64 {
        return vs * z0 / (rs + z0);
    }

    // The load voltage after the k-th arrival (k = 1 is the first, at time TD).
    fn far_end(k: u8, vs: f64, rs: f64, z0: f64, rl: f64) -> f64 {
        const gl = gamma(rl, z0);
        const gs = gamma(rs, z0);
        var v : f64 = 0.0;
        var wave : f64 = launch(vs, rs, z0);
        var i : u8 = 0;
        while (i < k) {
            v = v + wave * (1.0 + gl);
            wave = wave * gl * gs;
            i = i + 1;
        }
        return v;
    }

    // The source-end voltage just after the j-th return (j = 0 is the launch, at t = 0).
    fn near_end(j: u8, vs: f64, rs: f64, z0: f64, rl: f64) -> f64 {
        const gl = gamma(rl, z0);
        const gs = gamma(rs, z0);
        var v : f64 = launch(vs, rs, z0);
        var back : f64 = launch(vs, rs, z0) * gl;
        var i : u8 = 0;
        while (i < j) {
            v = v + back * (1.0 + gs);
            back = back * gs * gl;
            i = i + 1;
        }
        return v;
    }

    // Where the load ends up once every wave has died: the DC divider.
    fn settles_to(vs: f64, rs: f64, rl: f64) -> f64 {
        return vs * rl / (rs + rl);
    }

    fn matched(g: f64) -> bool {
        return g <= MATCH_TOL && g >= 0.0 - MATCH_TOL;
    }

    // The shape of the far-end waveform.
    fn shape(rs: f64, z0: f64, rl: f64) -> u8 {
        const gl = gamma(rl, z0);
        const gs = gamma(rs, z0);
        if (matched(gl)) {
            return SHAPE_MATCHED;
        }
        if (matched(gs)) {
            return SHAPE_SOURCE;
        }
        if (gl * gs < 0.0) {
            return SHAPE_RINGS;
        }
        return SHAPE_STAIRS;
    }

    // How far the k-th far-end value stands above the settled one, in percent of it.
    fn overshoot_pct(k: u8, vs: f64, rs: f64, z0: f64, rl: f64) -> f64 {
        const end = settles_to(vs, rs, rl);
        if (end == 0.0) {
            return 0.0;
        }
        return (far_end(k, vs, rs, z0, rl) - end) * 100.0 / end;
    }

    fn near(a: f64, b: f64) -> bool {
        return a - b < 0.001 && b - a < 0.001;
    }

    test "an end reflects by (R - Z0) / (R + Z0)" {
        assert(near(gamma(50.0, 50.0), 0.0));
        assert(near(gamma(25.0, 50.0), 0.0 - 0.3333));
        assert(near(gamma(150.0, 50.0), 0.5));
        assert(near(gamma(0.0, 50.0), 0.0 - 1.0));
        assert(gamma(OPEN_OHMS, 50.0) > 0.9998);
    }

    test "the launch is the divider of RS and Z0" {
        assert(near(launch(1.0, 25.0, 50.0), 0.6667));
        assert(near(launch(3.3, 50.0, 50.0), 1.65));
    }

    test "the textbook lattice: 25 ohm into 50 ohm, open end" {
        assert(near(far_end(1, 1.0, 25.0, 50.0, OPEN_OHMS), 1.3333));
        assert(near(far_end(2, 1.0, 25.0, 50.0, OPEN_OHMS), 0.8889));
        assert(near(far_end(3, 1.0, 25.0, 50.0, OPEN_OHMS), 1.0370));
        assert(near(far_end(4, 1.0, 25.0, 50.0, OPEN_OHMS), 0.9877));
        assert(near(far_end(MAX_ARRIVALS, 1.0, 25.0, 50.0, OPEN_OHMS), settles_to(1.0, 25.0, OPEN_OHMS)));
        assert(shape(25.0, 50.0, OPEN_OHMS) == SHAPE_RINGS);
        assert(near(overshoot_pct(1, 1.0, 25.0, 50.0, OPEN_OHMS), 33.33));
    }

    test "series termination reaches the end value on the first arrival" {
        assert(near(far_end(1, 3.3, 50.0, 50.0, OPEN_OHMS), 3.3));
        assert(near(far_end(2, 3.3, 50.0, 50.0, OPEN_OHMS), 3.3));
        assert(near(near_end(0, 3.3, 50.0, 50.0, OPEN_OHMS), 1.65));
        assert(near(near_end(1, 3.3, 50.0, 50.0, OPEN_OHMS), 3.3));
        assert(shape(50.0, 50.0, OPEN_OHMS) == SHAPE_SOURCE);
    }

    test "parallel termination never reflects" {
        assert(near(far_end(1, 1.0, 25.0, 50.0, 50.0), 0.6667));
        assert(near(far_end(5, 1.0, 25.0, 50.0, 50.0), 0.6667));
        assert(near(settles_to(1.0, 25.0, 50.0), 0.6667));
        assert(shape(25.0, 50.0, 50.0) == SHAPE_MATCHED);
    }

    test "a weak driver climbs a staircase" {
        assert(shape(150.0, 50.0, OPEN_OHMS) == SHAPE_STAIRS);
        assert(near(far_end(1, 1.0, 150.0, 50.0, OPEN_OHMS), 0.5));
        assert(near(far_end(2, 1.0, 150.0, 50.0, OPEN_OHMS), 0.75));
        assert(far_end(3, 1.0, 150.0, 50.0, OPEN_OHMS) < 1.0);
    }

    test "VERSION says what the header says" {
        assert(VERSION == 1);
        assert(MAX_ARRIVALS == 12);
        assert(matched(MATCH_TOL));
    }
}
// phi^2 + 1/phi^2 = 3 | TRINITY
