; specs/widgets/hive-key-error.t27 -- A refused key: transient, quota, auth or a bad request
; Source of truth for public/widgets/hive-key-error/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-key-error/logic.js -- the fn
; bodies of gHashTag/t27 specs/queen/key_failover.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 16 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader picks a status and a code; the verdict is error_kind(status, code), with
; key_closes and charges_issue of its kind. Every grid cell is error_kind of its row and column.

; WHAT IT DOES NOT CLAIM:  it calls no provider: the statuses and codes are a list to pick from.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_key_error;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-key-error";
pub const TITLE : str = "A refused key: transient, quota, auth or a bad request";
pub const DESCRIPTION : str = "Pick the HTTP status and the z.ai code a bee got back. error_kind sorts the refusal, and the grid colours every status against every code the same way.";
pub const IMAGE_ALT : str = "Key error card: HTTP 429 with z.ai code 1305. The verdict reads TRANSIENT in gold: the key rests, it does not close, the issue is not charged. A grid of 11 statuses by 7 codes is coloured gold for transient, orange for quota, pink for auth, red for request and green for ok.";
pub const HOOK : str = "z.ai sends a spent quota and a passing overload with the same 429. So the code in the body wins over the status, and 1305 never closes a key.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/queen/key_failover.t27 (t27 master c42f8fb40): every value on the page is error_kind, key_closes and charges_issue, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 16 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_STATUSES : [11]u16 = [0, 200, 400, 401, 402, 403, 404, 408, 429, 500, 503];
pub const K_CODES : [7]u16 = [0, 1113, 1302, 1305, 1308, 1312, 1321];
pub const K_ZAI_OVERLOAD : u32 = 1305;
pub const K_ZAI_RATE_LIMIT : u32 = 1302;
pub const K_PRESET_STATUS : [4]u8 = [8, 8, 3, 0];
pub const K_PRESET_CODE : [4]u8 = [3, 1, 0, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["429, code 1305", "429, code 1113", "401", "No answer at all"];
pub const SAY_ASK : str = "A bee's key was refused. Should it wait, switch keys, or give up?";
pub const SAY_STATUS : str = "HTTP status (0: no answer)";
pub const SAY_CODE : str = "z.ai code in the body (0: none)";
pub const SAY_KIND_NAMES : [5]str = ["OK", "TRANSIENT", "QUOTA", "AUTH", "REQUEST"];
pub const SAY_KIND_LINES : [5]str = ["answered", "another key or a moment later may pass", "the key's quota, plan or balance is spent", "the key itself is refused", "the request is wrong; every key would say the same"];
pub const SAY_CLOSES : str = "closes the key";
pub const SAY_CHARGES : str = "charged to the issue";
pub const SAY_YES : str = "yes";
pub const SAY_NO : str = "no";
pub const SAY_GRID : str = "status by code: the kind error_kind gives";
pub const SAY_NOTE : str = "Only a wrong request is charged to the issue: an overloaded, spent or refusing provider says nothing about the work, so it never retires an issue.";
pub const SAY_SOURCE : str = "Logic: t27 spec queen/key_failover.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lists_hold_the_overload_codes {
    assert K_CODES[2] == K_ZAI_RATE_LIMIT;
    assert K_CODES[3] == K_ZAI_OVERLOAD;
    assert K_STATUSES[8] == 429;
}

test the_presets_index_the_lists {
    assert K_PRESET_STATUS[0] == 8;
    assert K_PRESET_CODE[0] == 3;
    assert K_STATUSES[0] == 0;
}
