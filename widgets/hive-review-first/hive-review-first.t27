// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-review-first.t27 -- Review first: no new work while finished work waits
; Source of truth for public/widgets/hive-review-first/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-review-first/logic.js -- the fn
; bodies of gHashTag/t27 specs/queen/review_first.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 6 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader drags the review queue from 0 to 40. Four candidates are
; kind_of(assigned, sent back) for each pair of flags, and each sits in the column admission(kind,
; queue) names; the sentence shows when round_refused says a round that admitted only the backlog
; owes it.

; WHAT IT DOES NOT CLAIM:  it does not count a live queue: 29 is the reviewable count the spec
; records for 2026-10-18 17:09Z.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_review_first;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-review-first";
pub const TITLE : str = "Review first: no new work while finished work waits";
pub const DESCRIPTION : str = "Drag the review queue. While anything waits in review, a backlog issue is refused; work the review sent back and work the owner assigned still go.";
pub const IMAGE_ALT : str = "Review-first card at 29 dispatches waiting in review. The green ADMIT column holds three cards, sent back, assigned, and assigned and sent back; the red REVIEW FIRST column holds the backlog issue. The line under them reads 29 dispatches wait in review; the backlog is closed until the review queue is empty.";
pub const HOOK : str = "Measured 2026-10-18: nine bees started for every verdict, so the review queue only grew. Now the backlog closes while anything waits in review.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/queen/review_first.t27 (t27 master c42f8fb40): every value on the page is kind_of, admission and round_refused, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 6 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_QUEUE_MAX : u8 = 40;
pub const K_REVIEW_QUEUE_MAX : u32 = 0;
pub const K_PRESET_QUEUE : [3]u8 = [29, 0, 3];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [3]str = ["29 waiting, as measured", "Review queue empty", "3 waiting"];
pub const SAY_ASK : str = "Should the Queen start new work while finished work waits for a review?";
pub const SAY_QUEUE : str = "dispatches waiting in review";
pub const SAY_COLUMNS : [2]str = ["ADMIT", "REVIEW FIRST"];
pub const SAY_CANDIDATES : [4]str = ["a backlog issue", "sent back by the review", "assigned by the owner", "assigned and sent back"];
pub const SAY_KIND_NAMES : [3]str = ["backlog", "rework", "assigned"];
pub const SAY_TAIL : str = " dispatches wait in review; the backlog is closed until the review queue is empty";
pub const SAY_OPEN : str = "The backlog is open: the queue is empty.";
pub const SAY_ROUND : str = "a round with only backlog candidates says";
pub const SAY_NOTE : str = "Rework is never backlog: the review asked for it. The queue empties on its own, because every outcome of a review that is not an accept has a clock (review_valve.t27).";
pub const SAY_SOURCE : str = "Logic: t27 spec queen/review_first.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_owners_bound_is_zero {
    assert K_REVIEW_QUEUE_MAX == 0;
    assert K_PRESET_QUEUE[1] == K_REVIEW_QUEUE_MAX;
}

test the_start_is_the_measured_queue {
    assert K_PRESET_QUEUE[0] == 29;
    assert K_PRESET_QUEUE[0] <= K_QUEUE_MAX;
}
