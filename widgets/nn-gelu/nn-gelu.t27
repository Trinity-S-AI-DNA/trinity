// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-gelu.t27 -- GELU, exact and tanh form: the bend transformers use
; Source of truth for public/widgets/nn-gelu/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-gelu/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/activation/gelu_activation.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 4 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader drags x from -4 to 3. The exact curve is forward_at(x, false) through the
; spec's erf, the dashed curve forward_at(x, true), the tanh form, and the dotted curve backward_at,
; the slope.

; WHAT IT DOES NOT CLAIM: the erf of the spec is the Abramowitz-Stegun 7.1.26 fit, good to 1.5e-7,
; so the exact curve is exact to that.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_gelu;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-gelu";
pub const TITLE : str = "GELU: why transformers bend a little below zero";
pub const DESCRIPTION : str = "Drag along GELU: x weighed by the chance a normal draw is below it. It dips to about -0.17 before it rises, and the tanh shortcut stays within a few thousandths of the exact form.";
pub const IMAGE_ALT : str = "GELU card at x = -0.75: the thick green exact curve and the dashed pink tanh form lie on top of each other from -4 to 3, dipping just under zero near -0.75; the dotted cyan slope crosses zero there. Tiles read exact -0.16997, tanh form -0.17004 and slopes 0.0008.";
pub const HOOK : str = "GELU(-0.75) = -0.16997 exactly and -0.17004 by the tanh form. A smooth ReLU with a small dip, used in BERT and GPT.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/activation/gelu_activation.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 4 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_X_LO_C : i16 = -400;
pub const K_X_HI_C : i16 = 300;
pub const K_X_STEP_C : u8 = 5;
pub const K_Y_LO_C : i16 = -50;
pub const K_Y_HI_C : i16 = 300;
pub const K_X_TICKS : [8]i8 = [-4, -3, -2, -1, 0, 1, 2, 3];
pub const K_Y_TICKS_C : [4]i16 = [0, 100, 200, 300];
pub const K_PRESET_X_C : [4]i16 = [-75, 150, -300, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["The dip, x = -0.75", "x = 1.5", "Far left, x = -3", "x = 0"];
pub const SAY_ASK : str = "Why do transformers use a curve that bends a little below zero?";
pub const SAY_X : str = "input x";
pub const SAY_EXACT : str = "GELU, exact";
pub const SAY_TANH : str = "GELU, tanh form";
pub const SAY_DF : str = "slope";
pub const SAY_DF_TANH : str = "slope, tanh form";
pub const SAY_PLOT_LABEL : str = "GELU of x, exact and tanh form, and its slope from -4 to 3";
pub const SAY_NOTE : str = "GELU(x) = x Phi(x): a positive input mostly passes, a large negative one mostly vanishes, and in between the curve dips. Unlike ReLU its slope is smooth everywhere.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/activation/gelu_activation.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_dip_is_in_range {
    assert K_PRESET_X_C[0] < 0;
    assert K_PRESET_X_C[0] > K_X_LO_C;
    assert K_Y_LO_C < 0;
}

test the_window_is_wider_on_the_left {
    assert K_X_LO_C + 400 == 0;
    assert K_X_HI_C == 300;
    assert K_X_TICKS[0] * 100 == K_X_LO_C;
}
