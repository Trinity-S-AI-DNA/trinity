// SPDX-License-Identifier: Apache-2.0
; specs/widgets/lut-depth.t27 -- the longest path yosys `ltp` printed, drawn one step per cell
; Source of truth for public/widgets/lut-depth/ (gHashTag/trinity, apps/website). The page is
; written by scripts/widget-pages-from-spec.mjs from this file; tool.js holds no English of its
; own and reads every word below from window.T27_WIDGET.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader pastes or drops what yosys `ltp` printed after LUT mapping. The page
; reads it in the browser with public/widgets/lut-depth/ltpparse.js and draws each path block as a
; staircase, one step per cell, with one big number: the length yosys printed. ltp prints a cell
; NAME per step, never a type. When the same text also holds an RTLIL `dump` (yosys
; `dump t:*`), the page looks every cell name up there and labels the step LUT6, CARRY4 and so
; on; without a dump it says "type not given" and guesses nothing from the name. The file never
; leaves the page; nothing is sent.

; THE -noff TRAP, measured on the sample: `ltp -noff` leaves out only yosys' own flip-flop types
; ($dff, $_DFF_P_ and kin). synth_xilinx writes 7-series flip-flops (FDRE, FDCE, FDSE, FDPE),
; which ltp walks through like any other cell, from D and C to Q. On the sample, plain
; `ltp -noff` printed length=27, and steps 24 to 27 are FDCE, LUT2, FDCE, OBUF: the path runs
; through two registers to an output pin. `ltp -noff t:FD* %n` (every object except FD* cells)
; printed length=23, the same first 23 steps, ending at a register's D input. The page flags any
; path that crosses a cell in K_CLOCKED_TYPES. With generic `synth -lut 6 -flatten` (cells
; $lut and $dff) plain `ltp -noff` does skip the flip-flops: on the same design it printed
; length=14, all $lut. That run was made once to check the parser; it is not shipped.

; THE SAMPLE: one real run of Yosys 0.67+post (git sha1 b8e7da6f) on this machine, made by
; scripts/widget-data/lut-depth.mjs: fpga/openxc7-synth/gf16_add.v (gHashTag/trinity), the GF16
; (Golden Float 16) adder, `synth_xilinx -flatten -top gf16_add`, then `echo on` and three
; commands teed into one file: `ltp -noff`, `ltp -noff t:FD* %n` and `dump t:*`. That file is
; shipped byte for byte as public/widgets/lut-depth/sample.ltp.txt; the command, the yosys -V
; line, the exit code, the warnings and the sha256 of the input and output are in sample.json.
; Every K_SAMPLE_ fact below is re-read from sample.ltp.txt (K_SAMPLE_YOSYS from the -V line) by
; `node scripts/widget-data/lut-depth.mjs --check`, which also runs this spec's tests on the
; values it read and a negative control that must fail them. yosys printed three warnings for
; this design (two about in_ready, one out-of-range select at gf16_add.v:165); the path is the
; netlist yosys built from it, warnings and all.

; WHAT IT DOES NOT CLAIM: levels are not nanoseconds. ltp counts cells on a path of the netlist
; before place and route: no routing delay, no cell delay, a CARRY4 counts the same as a LUT6, and
; the path with the most cells need not be the slowest one or the one with the most LUTs. No Fmax
; or time is computed from it anywhere on the page or the card. ltp works per module, so the
; design must be flattened for it to see a whole path.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_lut_depth;

pub const KIND : str = "widget-tool";
pub const ID : str = "lut-depth";
pub const TITLE : str = "LUT depth: your longest yosys path, drawn as a staircase";
pub const DESCRIPTION : str = "Paste yosys ltp -noff output: the longest path after LUT mapping, one step per cell, typed when a dump is in the text. A cell count, not nanoseconds. Read in your browser.";
pub const IMAGE_ALT : str = "A staircase of 23 steps on black: the longest path yosys 0.67 ltp found in gf16_add, a GF16 adder, after synth_xilinx: 1 IBUF, 11 LUTs, 9 CARRY4 and 2 wide muxes. Plain ltp -noff said 27, because it walked through two FDCE flip-flops. Marked: cells, not nanoseconds.";
pub const HOOK : str = "Our GF16 adder's longest path: 23 cells, 11 of them LUTs. Plain ltp -noff said 27: it walked through two 7-series flip-flops it does not skip.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [5]str = ["Yosys 0.67+post (git sha1 b8e7da6f40ae8f552c116bf6c359b07c6533e159), run once by scripts/widget-data/lut-depth.mjs: nice -n 10 yosys -q -p \"read_verilog fpga/openxc7-synth/gf16_add.v; synth_xilinx -flatten -top gf16_add; echo on; tee -q -o ltp.txt ltp -noff; tee -q -a ltp.txt ltp -noff t:FD* %n; tee -q -a ltp.txt dump t:*\"", "gHashTag/trinity fpga/openxc7-synth/gf16_add.v (sha256 in sample.json), copied to a scratch directory under the same relative path", "public/widgets/lut-depth/sample.ltp.txt: the teed yosys output, byte for byte; sample.json: command, yosys -V line, exit code, warnings, seconds, sha256 of input and output, and the parsed path", "public/widgets/lut-depth/ltpparse.js: the one parser, run in node for the sample and in the browser for your text; card.png is drawn from sample.json by scripts/widget-data/lut-depth-card.py", "node scripts/widget-data/lut-depth.mjs --check: re-reads sample.ltp.txt and fails if any K_SAMPLE_ fact in this spec disagrees"];
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- Which cell type is which (7-series names as synth_xilinx writes them; $lut from generic synth)
pub const K_LUT_TYPES : [7]str = ["LUT1", "LUT2", "LUT3", "LUT4", "LUT5", "LUT6", "$lut"];
pub const K_CARRY_TYPES : [1]str = ["CARRY4"];
pub const K_MUX_TYPES : [2]str = ["MUXF7", "MUXF8"];
pub const K_IO_TYPES : [7]str = ["IBUF", "OBUF", "OBUFT", "IOBUF", "IBUFG", "BUFG", "BUFGCTRL"];
; Cells with a clock: ltp walks through them from input to output like logic, so a path that
; holds one is no longer a path between registers.
pub const K_CLOCKED_TYPES : [11]str = ["FDRE", "FDSE", "FDCE", "FDPE", "LDCE", "LDPE", "SRL16E", "SRLC32E", "RAMB18E1", "RAMB36E1", "DSP48E1"];

; --- The sample (scripts/widget-data/lut-depth.mjs re-reads every K_SAMPLE_ fact) ---------------
pub const K_SAMPLE_JSON : str = "sample.json";
pub const K_SAMPLE_LOG : str = "sample.ltp.txt";
pub const K_SAMPLE_DESIGN : str = "fpga/openxc7-synth/gf16_add.v";
pub const K_SAMPLE_TOP : str = "gf16_add";
pub const K_SAMPLE_YOSYS : str = "0.67+post";
; The two ltp commands of the sample, in the order they ran, and the length each printed.
pub const K_SAMPLE_COMMANDS : [2]str = ["ltp -noff", "ltp -noff t:FD* %n"];
pub const K_SAMPLE_LENGTHS : [2]u16 = [27, 23];
; The cell type of every step of the second path (steps 1 to 23), from the dump in the same file.
pub const K_SAMPLE_PATH : [23]str = ["IBUF", "LUT2", "CARRY4", "CARRY4", "LUT4", "LUT3", "LUT2", "LUT6", "LUT3", "CARRY4", "CARRY4", "CARRY4", "MUXF7", "MUXF8", "LUT2", "LUT4", "CARRY4", "CARRY4", "LUT6", "CARRY4", "CARRY4", "LUT3", "LUT6"];
; Steps 24 to 27 of the first path, the ones the second leaves out.
pub const K_SAMPLE_PLAIN_TAIL : [4]str = ["FDCE", "LUT2", "FDCE", "OBUF"];
pub const K_SAMPLE_LUT : u16 = 11;
pub const K_SAMPLE_CARRY : u16 = 9;
pub const K_SAMPLE_MUX : u16 = 2;
pub const K_SAMPLE_IO : u16 = 1;
pub const K_SAMPLE_CLOCKED : u16 = 0;
pub const K_SAMPLE_PLAIN_CLOCKED : u16 = 2;
; RTLIL `cell` lines in the dump: every cell of the design.
pub const K_SAMPLE_CELLS : u16 = 305;

; --- How it reads and draws ---------------------------------------------------------------------
pub const K_CARD_W : u16 = 1200;
pub const K_CARD_H : u16 = 630;
pub const K_MIN_TARGET_PX : u8 = 32;
; A pasted text or a file over this many characters is not read.
pub const K_MAX_CHARS : u32 = 16000000;

; --- Every word on the screen -------------------------------------------------------------------
; Templates take {0}, {1}, ... in order.
pub const SAY_SAMPLE_LABEL : str = "Real sample";
pub const SAY_SAMPLE_NAME : str = "gf16_add (yosys 0.67)";
pub const SAY_SAMPLE_LINE : str = "The GF16 (Golden Float 16) adder from gHashTag/trinity, fpga/openxc7-synth/gf16_add.v, synthesised on our machine with synth_xilinx -flatten. The log holds two ltp runs, plain -noff and with the flip-flops left out, and a dump that names each cell's type.";
pub const SAY_OPEN_SAMPLE : str = "Open the yosys output";
pub const SAY_OWN_LABEL : str = "Your ltp output";
pub const SAY_HOW_HEAD : str = "In yosys, after synthesis (the design flattened):";
pub const SAY_HOW : [3]str = ["synth_xilinx -flatten -top <top>", "tee -o ltp.txt ltp -noff t:FD* %n", "tee -q -a ltp.txt dump t:*"];
pub const SAY_HOW_NOTE : str = "The dump line is optional: without it the page has cell names, not types. With generic synth -lut 6 -flatten, plain ltp -noff does skip the flip-flops, and LUTs read as $lut.";
pub const SAY_DROP : str = "Drop ltp.txt or a yosys log here, or pick a file";
pub const SAY_PASTE_HINT : str = "...or paste what ltp printed";
pub const SAY_PASTE_LABEL : str = "yosys ltp output";
pub const SAY_READ : str = "Draw the path";
pub const SAY_CLEAR : str = "Clear";
pub const SAY_PICKED : str = "{0}: {1} bytes";
pub const SAY_PASTED : str = "pasted text";
pub const SAY_LOCAL_NOTE : str = "Read in this tab; nothing is sent.";
pub const SAY_TOO_BIG : str = "{0} characters is more than this page reads ({1}).";
pub const SAY_ERR_READ : str = "Could not read {0}.";
pub const SAY_ERR_LOAD : str = "The sample did not load.";
; One per parse error code of ltpparse.js, in this order.
pub const SAY_ERROR_IDS : [3]str = ["empty", "noltp", "loop"];
pub const SAY_ERROR_TEXT : [3]str = ["Nothing to read yet.", "No \"Longest topological path in ... (length=N):\" line in this text. Is it the output of yosys ltp?", "yosys found a combinational loop and printed no path; a loop has no longest path."];

; The path blocks of one text.
pub const SAY_BLOCKS_HEAD : str = "Paths in this text";
pub const SAY_BLOCK_NAME : str = "{0}: {1}, length {2}";

; The headline.
pub const SAY_LENGTH_LABEL : str = "cells on the longest path, as yosys counts them";
pub const SAY_LUT_LABEL : str = "of them LUTs";
pub const SAY_LUT_UNKNOWN : str = "LUTs: give the dump to count them";
pub const SAY_MODULE : str = "module {0}, printed by: {1}";
pub const SAY_NO_COMMAND : str = "the command is not in the text";
pub const SAY_CLASS_IDS : [8]str = ["lut", "carry", "mux", "io", "clocked", "other", "unknown", "start"];
pub const SAY_CLASS_NAMES : [8]str = ["LUT", "carry", "wide mux", "I/O buffer", "clocked", "other", "type not given", "start"];

; Warnings, each shown only when it applies.
pub const SAY_CLOCKED_WARN : str = "This path runs through {0} clocked cell(s): {1}. ltp -noff leaves out only yosys' own flip-flop types ($dff and kin), not the FDRE, FDCE, FDSE and FDPE that synth_xilinx writes, so the path crosses registers. Run ltp -noff t:FD* %n to leave them out.";
pub const SAY_UNTYPED : str = "No RTLIL dump in this text, so each step is named by its cell, not its type. Add tee -q -a ltp.txt dump t:* after ltp to see LUT, CARRY4 and the rest.";
pub const SAY_MISSING_TYPES : str = "{0} cell(s) on this path are not in the dump: was the dump taken from the same run?";
pub const SAY_INCOMPLETE : str = "This block lists {0} of its {1} steps: part of it is missing from the text.";
pub const SAY_LOOPS : str = "yosys also reported {0} combinational loop(s), first at {1}.";
pub const SAY_LOOP_AT : str = "The first is at {0} in module {1}.";

; The staircase.
pub const SAY_STAIRS_HEAD : str = "The path, one step per cell";
pub const SAY_STAIRS_LABEL : str = "Staircase of the path: one step per cell, from where the path starts to where it ends.";
pub const SAY_START : str = "starts at {0}";
pub const SAY_END : str = "ends at {0}";
pub const SAY_TABLE_SUMMARY : str = "Every step: cell type, cell name and the net it drives";
pub const SAY_TABLE_HEAD : [4]str = ["step", "cell type", "cell", "net it drives"];

pub const SAY_NOT_NS : str = "Levels are not nanoseconds. ltp counts cells on a path of the netlist before place and route: no routing delay, no cell delay, and a CARRY4 counts the same as a LUT6. No Fmax can be read from it; only a timing report after routing gives one.";
pub const SAY_HONEST : str = "ltp finds the path with the most cells, not the slowest path or the one with the most LUTs, and it works per module: flatten the design first.";

; The card (drawn by scripts/widget-data/lut-depth-card.py from sample.json).
pub const SAY_CARD_BRAND : str = "TRINITY S3AI  /  LUT DEPTH";
pub const SAY_CARD_URL : str = "t27.ai/widgets/lut-depth";
pub const SAY_CARD_KIND : str = "cells, not nanoseconds: before place and route";
pub const SAY_CARD_VERSION : str = "yosys {0}";
pub const SAY_CARD_PLAIN : str = "plain ltp -noff: {0}, through {1} FDCE";

; --- Tests --------------------------------------------------------------------------------------
test the_lists_name_7_series_cells {
    assert K_LUT_TYPES[0] == "LUT1";
    assert K_LUT_TYPES[5] == "LUT6";
    assert K_CARRY_TYPES[0] == "CARRY4";
    assert K_MUX_TYPES[1] == "MUXF8";
    assert K_CLOCKED_TYPES[0] == "FDRE";
    assert K_CLOCKED_TYPES[2] == "FDCE";
}

test the_sample_path_is_its_classes_summed {
    assert K_SAMPLE_COMMANDS[1] == "ltp -noff t:FD* %n";
    assert K_SAMPLE_LENGTHS[1] == 23;
    assert K_SAMPLE_LUT + K_SAMPLE_CARRY + K_SAMPLE_MUX + K_SAMPLE_IO + K_SAMPLE_CLOCKED == K_SAMPLE_LENGTHS[1];
    assert K_SAMPLE_PATH[0] == "IBUF";
    assert K_SAMPLE_PATH[2] == K_CARRY_TYPES[0];
    assert K_SAMPLE_PATH[12] == K_MUX_TYPES[0];
    assert K_SAMPLE_PATH[22] == "LUT6";
    assert K_SAMPLE_LUT == 11;
    assert K_SAMPLE_CLOCKED == 0;
}

test plain_noff_walks_through_two_flip_flops {
    assert K_SAMPLE_COMMANDS[0] == "ltp -noff";
    assert K_SAMPLE_LENGTHS[0] == K_SAMPLE_LENGTHS[1] + 4;
    assert K_SAMPLE_PLAIN_TAIL[0] == K_CLOCKED_TYPES[2];
    assert K_SAMPLE_PLAIN_TAIL[2] == K_CLOCKED_TYPES[2];
    assert K_SAMPLE_PLAIN_TAIL[3] == "OBUF";
    assert K_SAMPLE_PLAIN_CLOCKED == 2;
}

test the_card_and_the_page {
    assert K_CARD_W == 1200;
    assert K_CARD_H == 630;
    assert READS_LOCAL_FILES == true;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
}
