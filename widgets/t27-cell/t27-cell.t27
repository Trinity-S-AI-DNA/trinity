// SPDX-License-Identifier: Apache-2.0
; specs/widgets/t27-cell.t27 -- 27 seats against 16: a 3-trit T27 cell beside a 4-bit E2M1 (FP4) code
; Source of truth for public/widgets/t27-cell/ (gHashTag/trinity, apps/website). The page is written
; by scripts/widget-pages-from-spec.mjs from this file; tool.js holds no English of its own and reads
; every word below from window.T27_WIDGET, and every level and storage number from ./data.json.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT DRAWS: one number line from -1 to 1 (the top seat of either format is 1, which is what a
; power-of-two block scale under the block_tnf rule, rule B, gives both of them), with the 27 levels
; of T27_N above it and the 15 distinct values of E2M1 below it. The reader drags along the line,
; moves a slider or types a weight; the page shows the seat each format rounds it to (nearest seat, a
; tie to the smaller magnitude, as the runner rounds), the code of that seat (three trits, or four
; bits) and the error. Under it, the storage of 32 weights in trits and in bits for T27, MXFP4, MX+,
; NVFP4 and E2M2, with each one's measured test perplexity.

; WHERE THE NUMBERS COME FROM: scripts/widget-data/t27-cell.mjs compiles the two pre-registrations in
; trinity-fpga, specs/numeric/ternary_storage_search.t27 and ternary_storage_search_v2.t27, with the
; t27 compiler (public/t27/t27_compiler.wasm), runs their own test blocks, checks the tables the two
; share are identical, recomputes T27_N from its stated recipe (the NF4 normal-quantile rule at 27
; levels) with python statistics.NormalDist, reads the per-tensor NVFP4 scale from the v2 storage
; line, reads the measured perplexities from research/block/ternary_storage_search_v2.json after
; checking that its spec sha256 is the v2 file's, and writes public/widgets/t27-cell/data.json with
; the commit of every file. It then checks every K_ fact below against that data; a spec that
; disagrees fails the run. scripts/widget-data/t27-cell-card.py draws card.png from data.json.

; WHAT IT DOES NOT CLAIM: anything about binary memory, where T27 costs more bits than NVFP4; the cost
; of a trit cell against a bit cell, which nobody has measured; other models, corpora, activations or
; the KV cache. The quality column is one 135M model, 40 windows, weights only, no uncertainty
; interval; MX+ and NVFP4 are re-implementations; T27_N was chosen on dev from three candidates. The
; number line uses the MXFP4 scale rule for E2M1; NVFP4 puts the same 15 values under a finer
; per-16 scale, which the line does not draw.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_t27_cell;

pub const KIND : str = "widget-tool";
pub const ID : str = "t27-cell";
pub const TITLE : str = "T27 cell: 27 seats in 3 trits against FP4's 16 codes in 4 bits";
pub const DESCRIPTION : str = "Drag a weight along one line and see where a 27-level T27 cell and a 4-bit E2M1 code round it, and what 32 weights cost in trits and in bits. Numbers from two compiled .t27 specs.";
pub const IMAGE_ALT : str = "T27 cell card on black: one number line with the 27 levels of T27 above it in gold and the 15 values of E2M1 (FP4) below it in white; a table of 32 weights: T27 101 trits against NVFP4's 106, but 161 bits packed densely against NVFP4's 144. The claim that holds is on a ternary substrate only.";
pub const HOOK : str = "A 3-trit cell has 27 seats; FP4 fills 15 of them. T27 stores 32 weights in 101 trits to NVFP4's 106, but in bits it is 161 to 144.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [6]str = ["trinity-fpga specs/numeric/ternary_storage_search.t27 at 1f68b921a: T27_N, E2M1, E2M2 level tables, the cell and dense-packing counts", "trinity-fpga specs/numeric/ternary_storage_search_v2.t27 at 49a84ade5 (sha256 88fcf517...0d4d): TRITS_* and BITS_* per 32 weights, the NVFP4 per-tensor scale", "trinity-fpga research/block/ternary_storage_search_v2.json at d31d8523c: test perplexity of every arm, SmolLM2-135M, wikitext-2, 40 windows", "trinity-fpga research/block/TERNARY_STORAGE_V2_VERDICT_2026-09-27.md at d31d8523c: the limits stated on this page", "public/t27/t27_compiler.wasm: compiles both specs and runs their test blocks; python statistics.NormalDist recomputes T27_N", "scripts/widget-data/t27-cell.mjs writes data.json; scripts/widget-data/t27-cell-card.py draws card.png from it"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- Numbers the tool relies on, re-checked against data.json by the data script -----------------
pub const K_DATA_JSON : str = "data.json";
pub const K_BLOCK : u8 = 32;
pub const K_CELL_TRITS : u8 = 3;
pub const K_CELL_CODES : u8 = 27;
pub const K_T27_MAGS : u8 = 13;
pub const K_T27_SCALE_TRITS : u8 = 5;
pub const K_E2M1_BITS : u8 = 4;
pub const K_E2M1_CODES : u8 = 16;
pub const K_E2M1_MAGS : u8 = 8;
pub const K_E2M1_DISTINCT : u8 = 15;
pub const K_TRITS_T27 : u8 = 101;
pub const K_TRITS_NVFP4 : u8 = 106;
pub const K_BITS_NVFP4 : u8 = 144;
pub const K_BITS_T27_DENSE : u8 = 161;
pub const K_BITS_E2M2 : u8 = 168;
; The weight the page opens on, in thousandths of the top seat, and the slider's resolution.
pub const K_DEFAULT_X_E3 : u16 = 300;
pub const K_SLIDER_STEPS : u16 = 2000;
; Decimal places shown for a seat and for an error.
pub const K_DIGITS : u8 = 4;

; --- Words on screen ----------------------------------------------------------------------------
; Templates take {0}, {1}, ... in order.
pub const SAY_CLAIM : str = "This is a storage-format comparison on one model's weights. The claim that holds: T27 is better than NVFP4 on a ternary substrate. In binary bits T27 is larger.";
pub const SAY_CELL_T27 : str = "T27: {0} trits hold {1} codes, zero and {2} levels each side, no negative zero. That is {3} bits of information.";
pub const SAY_CELL_E2M1 : str = "E2M1 (FP4): {0} bits hold {1} codes, but +0 and -0 are one value, so {2} seats. A 3-trit cell can hold it and leaves {3} codes empty.";
pub const SAY_LINE_TITLE : str = "Seats on one number line";
pub const SAY_LINE_NOTE : str = "Both grids scaled so the top seat is 1: the weight divided by its block's power-of-two scale (rule B). Drag on the line, move the slider or type a value.";
pub const SAY_ROW_NAMES : [2]str = ["T27_N, 27 seats", "E2M1, 15 seats"];
pub const SAY_INPUT_LABEL : str = "Weight / block scale";
pub const SAY_RESULT_HEAD : [4]str = ["format", "seat", "code", "error"];
pub const SAY_FORMAT_SHORT : [2]str = ["T27", "E2M1"];
pub const SAY_CODE_T27 : str = "{0} = {1} (balanced ternary)";
pub const SAY_CODE_E2M1 : str = "{0} = s {1}, e {2}, m {3}";
pub const SAY_TRIT_GLYPHS : [3]str = ["-", "0", "+"];
pub const SAY_ERR : str = "{0} ({1}% of the weight)";
pub const SAY_ERR_ZERO : str = "{0}";
pub const SAY_CLOSER : [3]str = ["T27 lands closer, by {0}.", "E2M1 lands closer, by {0}.", "Both land at the same distance."];
pub const SAY_GAP : str = "Between the E2M1 seats {0} and {1}, T27 has {2} seats.";
pub const SAY_ROUND_NOTE : str = "Nearest seat; a tie goes to the smaller magnitude, as the runner rounds. NVFP4 puts the same 15 E2M1 values under a finer scale per 16 weights, which this line does not draw.";
pub const SAY_STORE_TITLE : str = "32 weights: what they cost, and how well they did";
pub const SAY_STORE_HEAD : [4]str = ["format", "trits", "bits", "test perplexity"];
pub const SAY_FORMAT_IDS : [5]str = ["T27", "MXFP4", "MXPLUS", "NVFP4", "E2M2"];
pub const SAY_FORMAT_NAMES : [5]str = ["T27 (T27_N)", "MXFP4", "MX+", "NVFP4", "E2M2 (5-bit)"];
pub const SAY_BITS_DENSE : str = "{0} packed densely";
pub const SAY_BITS_TENSOR : str = "{0} + {1} per tensor";
pub const SAY_BASE_ROW : str = "unquantised";
pub const SAY_STORE_TRITS : str = "On a ternary substrate T27 is the smallest: {0} trits against NVFP4's {1}.";
pub const SAY_STORE_BITS : str = "In binary bits it is not: {0} packed densely against NVFP4's {1}, {2}% more. On binary memory this is not an equal-storage comparison.";
pub const SAY_QUALITY : str = "Perplexity: SmolLM2-135M, wikitext-2 test, {0} windows of {1} tokens, weights only; lower is better. T27 against NVFP4: {2} per mille. E2M2 beats T27 on quality ({3} against {4}) and costs more in both units.";
pub const SAY_LIMITS_TITLE : str = "What this does not say";
pub const SAY_LIMITS : [5]str = ["Nothing about binary memory: there T27 is the larger format.", "Nothing about what a trit cell costs against a bit cell. Nobody has measured it, and ReTern argues it is higher.", "One 135M model, one corpus, weights only; no uncertainty interval was pre-registered.", "MX+ and NVFP4 are re-implementations from the paper and from NVIDIA's published recipe, not the authors' code.", "T27_N is one of three 27-level candidates, chosen on the dev split; test was run once, after the choice."];
pub const SAY_SOURCES : str = "Level tables and storage counts: trinity-fpga {0} ({1}) and {2} ({3}); perplexity: {4} ({5}).";
pub const SAY_ERR_DATA : str = "The data file did not load.";

; --- Tests ----------------------------------------------------------------------------------------
test a_three_trit_cell_holds_27_codes_and_no_negative_zero {
    assert K_CELL_CODES == 3 * 3 * 3;
    assert K_CELL_TRITS == 3;
    assert K_CELL_CODES == 2 * K_T27_MAGS + 1;
}

test e2m1_has_16_codes_and_15_values {
    assert K_E2M1_CODES == 2 * 2 * 2 * 2;
    assert K_E2M1_CODES == 2 * K_E2M1_MAGS;
    assert K_E2M1_DISTINCT == K_E2M1_CODES - 1;
    assert K_E2M1_CODES < K_CELL_CODES;
    assert K_CELL_CODES - K_E2M1_CODES == 11;
}

test t27_is_smaller_in_trits_and_larger_in_bits {
    assert K_TRITS_T27 == K_BLOCK * K_CELL_TRITS + K_T27_SCALE_TRITS;
    assert K_TRITS_T27 < K_TRITS_NVFP4;
    assert K_BITS_NVFP4 == K_BLOCK * K_E2M1_BITS + 2 * 8;
    assert K_BITS_NVFP4 < K_BITS_T27_DENSE;
    assert K_BITS_T27_DENSE < K_BITS_E2M2;
}

test the_page_opens_inside_the_line_and_sends_nothing {
    assert K_DEFAULT_X_E3 < 1000;
    assert K_SLIDER_STEPS >= 1000;
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == false;
    assert CATEGORY == "fpga";
    assert SAY_FORMAT_IDS[0] == "T27";
    assert SAY_FORMAT_IDS[3] == "NVFP4";
}
