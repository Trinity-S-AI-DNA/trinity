// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-column.t27 -- The public board: which column a task's card is in
; Source of truth for public/widgets/hive-column/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-column/logic.js -- the fn
; bodies of gHashTag/t27 specs/queen/dispatch.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 26 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader says whether the issue is open and whether the issue list was read. Each
; of five claim cards sits in the column column_of(claim, issue open, list known) names.

; WHAT IT DOES NOT CLAIM:  it reads no board: the five claims are every claim the spec has.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_column;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-column";
pub const TITLE : str = "The public board: which column a task's card is in";
pub const DESCRIPTION : str = "Five claims a dispatch can hold on its issue. Close the issue: column_of moves every finished one to done, whatever its verdict.";
pub const IMAGE_ALT : str = "Board card: the issue is closed and the issue list was read. Of six columns, running holds the running claim and done holds four cards, accepted, rejected, awaiting review and failed; backlog, blocked, review and dropped are empty.";
pub const HOOK : str = "The spec records it as a finding: the public board draws a closed issue's dispatch as done whatever its verdict, an escalation and a send-back included.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/queen/dispatch.t27 (t27 master c42f8fb40): every value on the page is column_of, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 26 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_CLAIMS : u8 = 5;
pub const K_COLUMNS : u8 = 6;
pub const K_COL_DONE : u32 = 4;
pub const K_PRESET_OPEN : [3]u8 = [0, 1, 0];
pub const K_PRESET_KNOWN : [3]u8 = [1, 1, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [3]str = ["Issue closed", "Issue open", "List not read"];
pub const SAY_ASK : str = "A task was reviewed and its issue was closed. Where does the public board draw it?";
pub const SAY_OPEN : str = "the issue is open";
pub const SAY_KNOWN : str = "the issue list was read";
pub const SAY_COLUMN_NAMES : [6]str = ["backlog", "blocked", "running", "review", "done", "dropped"];
pub const SAY_CLAIM_NAMES : [5]str = ["running", "accepted", "rejected", "awaiting review", "failed"];
pub const SAY_CLAIM : str = "claim";
pub const SAY_IN_DONE : str = "{0} of {1} cards in done";
pub const SAY_NOTE : str = "Done should mean accepted or merged. Until the board reads verdicts for closed issues, a send-back on a closed issue looks finished on the board; the spec names it so a reader is not misled.";
pub const SAY_SOURCE : str = "Logic: t27 spec queen/dispatch.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test five_claims_six_columns {
    assert K_CLAIMS == 5;
    assert K_COLUMNS == 6;
}

test the_start_is_a_closed_issue {
    assert K_PRESET_OPEN[0] == 0;
    assert K_PRESET_KNOWN[0] == 1;
}
