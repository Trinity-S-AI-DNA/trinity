// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-lifecycle.t27 -- A task's life: the Queen's state machine
; Source of truth for public/widgets/hive-lifecycle/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-lifecycle/logic.js -- the fn
; bodies of gHashTag/t27 specs/queen/dispatch.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 7 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader taps events; the state becomes next_state(state, event). Every event
; button is next_state of the current state, so an illegal one (99) is greyed and names nothing.
; Presets jump to a state.

; WHAT IT DOES NOT CLAIM:  it does not run the supervisor: the events are what the reader taps.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_lifecycle;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-lifecycle";
pub const TITLE : str = "A task's life: the Queen's state machine";
pub const DESCRIPTION : str = "Twelve states and sixteen events. Tap an event: next_state moves the task, and every event it would refuse is greyed out.";
pub const IMAGE_ALT : str = "Lifecycle card: the task is ENDED, highlighted among twelve state chips. Of sixteen event buttons, seven are lit, the verdicts accept, send back, escalate, wait, empty, criteria changed and floor passed, each naming the state it leads to; the other nine are grey as illegal.";
pub const HOOK : str = "A row has no status column: its state is read from four fields. This machine is the one that chooses, starts, ends, reviews and releases work.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/queen/dispatch.t27 (t27 master c42f8fb40): every value on the page is next_state, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 7 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_STATES : u8 = 12;
pub const K_EVENTS : u8 = 16;
pub const K_ILLEGAL : u32 = 99;
pub const K_PRESET_STATE : [4]u8 = [3, 0, 6, 10];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["Ended, awaiting a verdict", "A new candidate", "Sent back", "Reaped"];
pub const SAY_ASK : str = "What can happen to a task once a bee has started on it?";
pub const SAY_STATE_NAMES : [12]str = ["none", "running", "refused", "ended", "wait", "accept", "send back", "escalate", "empty", "stale", "reaped", "released"];
pub const SAY_EVENT_NAMES : [16]str = ["start", "refuse", "end", "end of another turn", "reap a stall", "reap at boot", "verdict accept", "verdict send back", "verdict escalate", "verdict wait", "verdict empty", "criteria changed", "CI red under the ceiling", "CI red at the ceiling", "floor passed", "dispatch again"];
pub const SAY_STATES : str = "states";
pub const SAY_EVENTS : str = "events: tap one";
pub const SAY_NOW : str = "now";
pub const SAY_ILLEGAL : str = "illegal here";
pub const SAY_TRAIL : str = "path so far";
pub const SAY_LEGAL : str = "{0} of {1} events are legal here";
pub const SAY_NOTE : str = "Accepted is done only until CI goes red: a red check under the send-back ceiling sends it back, at the ceiling it escalates. A released or reaped task can be dispatched again.";
pub const SAY_SOURCE : str = "Logic: t27 spec queen/dispatch.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test twelve_states_sixteen_events {
    assert K_STATES == 12;
    assert K_EVENTS == 16;
    assert K_ILLEGAL > K_STATES;
}

test the_presets_are_states {
    assert K_PRESET_STATE[0] == 3;
    assert K_PRESET_STATE[3] < K_STATES;
}
