// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-bce.t27 -- binary cross-entropy: why a confident wrong answer costs so much
; Source of truth for public/widgets/nn-bce/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-bce/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/loss/binary_crossentropy_loss.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 14 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader moves three probabilities from 0.01 to 0.99. The loss is loss_of(a, b, c,
; false) against the spec's targets (1, 0, 1), the bars grad_of, and the curve loss_of over the
; first prediction; one tile feeds logits of 0 through the spec's sigmoid.

; WHAT IT DOES NOT CLAIM: the spec clips each probability to [1e-7, 1 - 1e-7], so the curve is
; finite at the ends of this window.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_bce;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-bce";
pub const TITLE : str = "Cross-entropy: why a confident wrong answer costs so much";
pub const DESCRIPTION : str = "Set three predicted probabilities against the answers 1, 0, 1: the loss is -log of the chance given to the truth. Drag toward a confident mistake and the cost climbs without bound.";
pub const IMAGE_ALT : str = "Cross-entropy card: predictions 0.8, 0.3 and 0.9 against targets 1, 0, 1. A red curve shows the loss as prediction 0 runs from 0.01 to 0.99, rising steeply on the left, with the cursor at 0.8; gradient bars read -1.25, 1.43 and -1.11. Tiles read loss 0.2284, sure and right 0.0101, sure and wrong 4.6052, logits at 0 giving 0.6931.";
pub const HOOK : str = "Predicting 0.99 where the answer is 1 costs 0.01; predicting 0.01 costs 4.6. The cost of a confident mistake is what trains a classifier.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/loss/binary_crossentropy_loss.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 14 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_TARGETS : [3]u8 = [1, 0, 1];
pub const K_P_LO_C : u8 = 1;
pub const K_P_HI_C : u8 = 99;
pub const K_X_TICKS_C : [5]u8 = [1, 25, 50, 75, 99];
pub const K_LOSS_HI_C : u16 = 200;
pub const K_LOSS_TICKS_C : [5]u8 = [0, 50, 100, 150, 200];
pub const K_GRAD_LO_C : i16 = -1000;
pub const K_GRAD_HI_C : u16 = 1000;
pub const K_GRAD_TICKS : [5]i8 = [-10, -5, 0, 5, 10];
pub const K_PRESET_A_C : [4]u8 = [80, 99, 10, 50];
pub const K_PRESET_B_C : [4]u8 = [30, 1, 90, 50];
pub const K_PRESET_C_C : [4]u8 = [90, 99, 10, 50];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["0.8, 0.3, 0.9", "Sure and right", "Sure and wrong", "Undecided"];
pub const SAY_ASK : str = "Why does a confident wrong answer cost so much?";
pub const SAY_PRED : str = "p";
pub const SAY_TARGET : str = "answer";
pub const SAY_CURVE_LABEL : str = "The loss as the first prediction moves, the others held";
pub const SAY_GRAD_LABEL : str = "The gradient for each prediction";
pub const SAY_LOSS : str = "loss";
pub const SAY_SURE_RIGHT : str = "0.99 where right";
pub const SAY_SURE_WRONG : str = "0.01 where right";
pub const SAY_LOGITS : str = "logits 0, 0, 0";
pub const SAY_NOTE : str = "The loss of one case is -(t log p + (1 - t) log(1 - p)). The gradient of a prediction is huge where the model is sure and wrong, and small where it is sure and right.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/loss/binary_crossentropy_loss.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_targets_are_the_spec_fixture {
    assert K_TARGETS[0] == 1;
    assert K_TARGETS[1] == 0;
    assert K_TARGETS[2] == 1;
}

test the_window_stays_inside_zero_and_one {
    assert K_P_LO_C > 0;
    assert K_P_HI_C < 100;
    assert K_PRESET_B_C[1] == K_P_LO_C;
    assert K_PRESET_A_C[1] == K_P_HI_C;
}
