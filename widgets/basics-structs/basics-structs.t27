// SPDX-License-Identifier: Apache-2.0
; specs/widgets/basics-structs.t27 -- the infographic of lesson 17 of the t27 basics course (specs/course/t27-basics.t27)
; Source of truth for public/widgets/basics-structs/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/basics/17_structs.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_basics_structs;

pub const KIND : str = "widget-tool";
pub const ID : str = "basics-structs";
pub const TITLE : str = "t27 basics 17: a struct and its fields";
pub const DESCRIPTION : str = "A t27 struct and a packed struct drawn as tables of fields, with how many backends compiled them. Lesson 17 of the t27 basics course.";
pub const IMAGE_ALT : str = "A black and white table of the fields of two t27 structs from the lesson spec: Point with x and y of type i32, and the packed struct Flags with ready and error of type bool.";
pub const HOOK : str = "A struct is a table of fields. Two structs, one module, 7 backends.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/basics/17_structs.t27, compiled clean on 7 backends by public/t27/t27_compiler.wasm, whose tests pass in the site test runner", "Compiler verdicts, error lines, code and counts quoted on this page are what the same wasm answered in node 22 when the course was authored; words without a run behind them are said to be read, not run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "The structs of the lesson spec";
pub const SAY_TABLE_HEAD : [3]str = ["Struct", "Field", "Type"];
pub const SAY_TABLE_CELLS : [12]str = ["Point", "x", "i32", "Point", "y", "i32", "Flags (packed)", "ready", "bool", "Flags (packed)", "error", "bool"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 4;
pub const K_TABLE_CELLS : u16 = 12;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_NOTE : str = "Backends that compiled the lesson spec: 7 of 7.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}
