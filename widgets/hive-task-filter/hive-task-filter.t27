// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-task-filter.t27 -- One task, three kinds: the filter the board and the game share
; Source of truth for public/widgets/hive-task-filter/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-task-filter/logic.js -- the fn
; bodies of gHashTag/t27 specs/queen/tasks.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 3 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader taps kinds and states into two masks; every cell of the 3 x 7 grid is
; task_matches(kind mask, state mask, kind, state). The two rows below map a job state and a review
; state to a task state with job_state and review_state.

; WHAT IT DOES NOT CLAIM:  it does not read the live board: the grid is every kind against every
; state.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_task_filter;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-task-filter";
pub const TITLE : str = "One task, three kinds: the filter the board and the game share";
pub const DESCRIPTION : str = "An issue, a review and a job are one kind of task with seven states. Tap kinds and states: the grid lights every pair task_matches lets through.";
pub const IMAGE_ALT : str = "Task filter card: kinds review and job and states running and failed are pressed. A 3 by 7 grid lights four cells, review and job in running and failed, and leaves the rest dark. Below, a job running, done, failed, cancelled reads running, done, failed, dropped.";
pub const HOOK : str = "An issue, a job and a review each kept their own codes. Now one filter, a bit per kind and a bit per state, serves the board, the game and the route.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/queen/tasks.t27 (t27 master c42f8fb40): every value on the page is task_matches, job_state and review_state, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 3 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_KINDS : u8 = 3;
pub const K_STATES : u8 = 7;
pub const K_TASK_KINDS : u8 = 3;
pub const K_TASK_STATES : u8 = 7;
pub const K_PRESET_KINDS : [4]u8 = [6, 0, 1, 0];
pub const K_PRESET_STATES : [4]u8 = [68, 0, 4, 8];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["Reviews and jobs, running or failed", "Everything (0 means any)", "Issues running", "Anything in review"];
pub const SAY_ASK : str = "How can one board show issues, reviews and jobs at once?";
pub const SAY_KIND_NAMES : [3]str = ["issue", "review", "job"];
pub const SAY_STATE_NAMES : [7]str = ["backlog", "blocked", "running", "review", "done", "dropped", "failed"];
pub const SAY_KINDS : str = "kinds";
pub const SAY_STATES : str = "states";
pub const SAY_GRID : str = "kind by state: lit means the filter lets it through";
pub const SAY_JOB : str = "a job that is";
pub const SAY_JOB_STATES : [4]str = ["running", "done", "failed", "cancelled"];
pub const SAY_REVIEW : str = "a review row that is";
pub const SAY_REVIEW_STATES : [4]str = ["queued", "posted", "forgotten", "failed"];
pub const SAY_SHOWS : str = "shows as";
pub const SAY_PASS : str = "in";
pub const SAY_NOTE : str = "A mask of 0 means any. A job and a review keep their own machines; this spec only says which of the seven states each one shows as, so the board, the game and the route filter alike.";
pub const SAY_SOURCE : str = "Logic: t27 spec queen/tasks.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_grid_is_every_kind_by_every_state {
    assert K_KINDS == K_TASK_KINDS;
    assert K_STATES == K_TASK_STATES;
    assert K_KINDS * K_STATES == 21;
}

test the_masks_fit_their_bits {
    assert K_PRESET_KINDS[0] < 8;
    assert K_PRESET_STATES[0] < 128;
    assert K_PRESET_KINDS[1] == 0;
}
