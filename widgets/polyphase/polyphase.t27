// SPDX-License-Identifier: Apache-2.0
; specs/widgets/polyphase.t27 -- polyphase: do the filtering at the low rate
; Source of truth for public/widgets/polyphase/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/polyphase/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 21 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader sets the number of taps and the decimation factor R. The taps are coloured by
; their phase (k mod R) and dealt into R short filters, one row each, that all run at the output rate;
; bars compare the multiply-accumulates per output sample with filtering at the input rate and throwing
; R - 1 of every R outputs away.

; WHAT IT DOES NOT CLAIM: counts MACs only; the commutator, the adders and the memory are not counted.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_polyphase;

pub const KIND : str = "widget-tool";
pub const ID : str = "polyphase";
pub const TITLE : str = "Polyphase: do the work at the low rate";
pub const DESCRIPTION : str = "Set taps and a decimation factor. The taps are dealt into R short filters that each run at the output rate, and the work per output drops by R.";
pub const IMAGE_ALT : str = "Polyphase card: 31 taps, decimation by 4. The taps are dealt into 4 phases of at most 8 taps; filtering at the input rate costs 124 MACs per output, the polyphase form 31.";
pub const HOOK : str = "A 31-tap decimate-by-4 filter: 124 MACs per output the naive way, 31 in polyphase form. Same output, a quarter of the work.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "R. E. Crochiere, L. R. Rabiner, Multirate Digital Signal Processing, Prentice Hall, 1983: decimation and polyphase structures"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_MIN_TAPS : u8 = 4;
pub const K_TAP_LIMIT : u8 = 64;
pub const K_MAX_R : u8 = 8;
pub const K_PRESET_TAPS : [4]u8 = [31, 32, 64, 12];
pub const K_PRESET_R : [4]u8 = [4, 4, 8, 3];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["31 taps, R = 4", "32 taps, R = 4", "64 taps, R = 8", "12 taps, R = 3"];
pub const SAY_TAPS : str = "Taps";
pub const SAY_R : str = "Decimation factor R";
pub const SAY_SPLIT_LABEL : str = "The taps coloured by phase, then dealt into one short filter per phase";
pub const SAY_BARS_LABEL : str = "MACs per output sample, both ways";
pub const SAY_ALL_TAPS : str = "{0} taps, coloured by phase k mod R";
pub const SAY_PHASE : str = "phase {0}";
pub const SAY_NOTE : str = "Phase p only ever multiplies input samples p, p + R, p + 2R ...: each phase sees the input at the low rate.";
pub const SAY_PER_PHASE : str = "taps per phase";
pub const SAY_NAIVE : str = "MACs, filter then drop";
pub const SAY_POLY : str = "MACs, polyphase";
pub const SAY_SAVED : str = "work saved";
pub const SAY_TIMES : str = "{0}x";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/signals.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_presets_split_evenly_and_not {
    assert K_PRESET_TAPS[1] % K_PRESET_R[1] == 0;
    assert K_PRESET_TAPS[0] % K_PRESET_R[0] == 3;
    assert K_PRESET_TAPS[2] == K_TAP_LIMIT;
}

test the_factor_stays_small_enough_to_draw {
    assert K_MAX_R == 8;
    assert K_MIN_TAPS == 4;
    assert K_PRESET_R[3] <= K_MAX_R;
}
