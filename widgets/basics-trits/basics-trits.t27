// SPDX-License-Identifier: Apache-2.0
; specs/widgets/basics-trits.t27 -- the infographic of lesson 8 of the t27 basics course (specs/course/t27-basics.t27)
; Source of truth for public/widgets/basics-trits/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/basics/08_trits.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_basics_trits;

pub const KIND : str = "widget-tool";
pub const ID : str = "basics-trits";
pub const TITLE : str = "t27 basics 8: three values of a trit";
pub const DESCRIPTION : str = "The three values of a trit as t27 constants, and how three trits give 27 combinations. Lesson 8 of the t27 basics course.";
pub const IMAGE_ALT : str = "A black and white table of the three trit values: minus one as NEG, zero as ZERO, one as POS, all of type i8; a diagram multiplies 3 by 3 by 3 to get 27.";
pub const HOOK : str = "A bit has two values, a trit has three. Three trits give 27.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/basics/08_trits.t27, compiled clean on 7 backends by public/t27/t27_compiler.wasm, whose tests pass in the site test runner", "Compiler verdicts, error lines, code and counts quoted on this page are what the same wasm answered in node 22 when the course was authored; words without a run behind them are said to be read, not run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "A trit as i8 constants";
pub const SAY_TABLE_HEAD : [3]str = ["Value", "Constant", "Type"];
pub const SAY_TABLE_CELLS : [9]str = ["-1", "NEG", "i8", "0", "ZERO", "i8", "1", "POS", "i8"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 3;
pub const K_TABLE_CELLS : u16 = 9;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "How three trits give 27";
pub const SAY_FLOW_STEPS : [3]str = ["1 trit: 3 values", "2 trits: 3 x 3 = 9", "3 trits: 9 x 3 = 27"];
pub const K_FLOW_STEPS : u8 = 3;
pub const SAY_NOTE : str = "The lesson spec tests POS + NEG == ZERO and 3 * 3 * 3 == 27.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 3;
    assert K_FLOW_STEPS > 1;
}
