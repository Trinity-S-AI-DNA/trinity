// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-lamb.t27 -- LAMB: a layer-wise trust ratio for large batches
; Source of truth for public/widgets/nn-lamb/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-lamb/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/optimizer/lamb.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 21 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader drags the scale of the weights (1, 2) from 0.1 to 10. Every point is
; step_norm(scale), the norm of the LAMB update for gradients (0.1, 0.2) at lr 0.001, and the tiles
; two_layers, one step on two layers at once.

; WHAT IT DOES NOT CLAIM: the clip at a norm of 10 is the spec's DEFAULT_CLIP_THRESHOLD; the flat
; part is that cap, not a property of every LAMB.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_lamb;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-lamb";
pub const TITLE : str = "LAMB: one learning rate for layers of every size";
pub const DESCRIPTION : str = "Scale a layer's weights and watch its LAMB step: it grows with the weight norm, so every layer moves by the same fraction of itself, until the norm passes 10 and the step stops growing.";
pub const IMAGE_ALT : str = "LAMB card at scale 2: a green line rises straight from 0 at scale 0 and bends flat at 0.010 once the scale passes about 4.5, with the cursor at 0.00447. Tiles read step norm 0.004472, ten times the weights 0.010000, and the spec's two layers after one step 0.9984 1.9984 and 2.9965 3.9964.";
pub const HOOK : str = "Weights (2, 4) take a step of 0.00447 and weights (6, 12) one of 0.01: a step is 0.001 of the layer's norm, capped at 10. That is how LAMB trains large batches.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/optimizer/lamb.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 21 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_SCALE_LO_C : u8 = 10;
pub const K_SCALE_HI_C : u16 = 1000;
pub const K_Y_HI_U : u8 = 12;
pub const K_Y_TICKS_U : [5]u8 = [0, 3, 6, 9, 12];
pub const K_X_TICKS : [6]u8 = [0, 2, 4, 6, 8, 10];
pub const K_PRESET_SCALE_C : [4]u16 = [200, 600, 10, 1000];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["scale 2", "scale 6, capped", "scale 0.1", "scale 10"];
pub const SAY_ASK : str = "Can one learning rate suit a tiny layer and a huge one?";
pub const SAY_SCALE : str = "weight scale";
pub const SAY_NORM : str = "step norm";
pub const SAY_PLOT_LABEL : str = "The norm of one LAMB step as the layer's weights are scaled";
pub const SAY_NORM_X10 : str = "weights x 10";
pub const SAY_LAYER_A : str = "layer 1 after a step";
pub const SAY_LAYER_B : str = "layer 2 after a step";
pub const SAY_NOTE : str = "LAMB computes an Adam-style update for each layer, then rescales it by the trust ratio min(||w||, 10) / ||update||. A big layer takes a big step and a small layer a small one.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/optimizer/lamb.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_window_reaches_the_cap {
    assert K_SCALE_HI_C == 1000;
    assert K_PRESET_SCALE_C[1] > 448;
    assert K_PRESET_SCALE_C[0] < 448;
}

test the_axis_holds_the_cap {
    assert K_Y_HI_U > 10;
    assert K_Y_TICKS_U[4] == K_Y_HI_U;
    assert K_PRESET_SCALE_C[2] == K_SCALE_LO_C;
}
