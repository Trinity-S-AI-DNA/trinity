// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-jam-action.t27 -- The Queen's move: what each jam asks of her
; Source of truth for public/widgets/hive-jam-action/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-jam-action/logic.js -- the fn
; bodies of gHashTag/t27 specs/automation/review-jam.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 14 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader drags the case from 0 to 255 or taps a preset. The verdict is
; jam_action(case); each of the ten case cards sits in the column jam_is_queens_turn of its own
; case.

; WHAT IT DOES NOT CLAIM:  it does not act: the page shows the move, it does not dispatch a bee.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_jam_action;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-jam-action";
pub const TITLE : str = "The Queen's move: what each jam asks of her";
pub const DESCRIPTION : str = "Each jam case has one action at the same position. Drag the case: jam_action names the move, and jam_is_queens_turn splits the board into her turn and waiting.";
pub const IMAGE_ALT : str = "Jam action card: case 4, refused then pushed. The action reads dispatch a re-review. Ten case cards stand on two columns: seven in the gold QUEEN'S TURN column, none, draft or fresh and stacked on open in the grey WAIT column; case 4 is outlined.";
pub const HOOK : str = "An unknown case is never nothing to do: anything above 9 maps to measure again. A queue that cannot be read is not reported as free.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/automation/review-jam.t27 (t27 master c42f8fb40): every value on the page is jam_action and jam_is_queens_turn, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 14 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_CASES : u8 = 10;
pub const K_CASE_MAX : u8 = 255;
pub const K_PRESET_CASE : [5]u8 = [4, 1, 8, 6, 200];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [5]str = ["Refused then pushed", "No reviewer", "Draft or fresh", "Conflicting", "Unknown case 200"];
pub const SAY_ASK : str = "Which move is the Queen's for each jam, and which jams are not hers to move?";
pub const SAY_CASE : str = "case";
pub const SAY_CASE_NAMES : [10]str = ["none", "no reviewer", "stacked on open", "refused not fixed", "refused then pushed", "labeled not merged", "conflicting", "noise red", "draft or fresh", "unmeasured"];
pub const SAY_ACTION_NAMES : [10]str = ["nothing", "dispatch a reviewer", "wait for the base", "dispatch the coder", "dispatch a re-review", "finish the merge", "rebase, by the coder", "name the noise and review", "wait", "measure again"];
pub const SAY_COLUMNS : [2]str = ["QUEEN'S TURN", "WAIT"];
pub const SAY_UNKNOWN : str = "unknown case {0}";
pub const SAY_ACTION : str = "action";
pub const SAY_NOTE : str = "A draft, a fresh PR and one stacked on an open PR are waited on, not pushed. Every other jam is a move the Queen makes herself, in the order of the board.";
pub const SAY_SOURCE : str = "Logic: t27 spec automation/review-jam.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_slider_covers_unknown_cases {
    assert K_CASE_MAX > K_CASES;
    assert K_PRESET_CASE[4] > K_CASES;
}

test the_start_is_refused_then_pushed {
    assert K_PRESET_CASE[0] == 4;
    assert K_PRESET_CASE[0] < K_CASES;
}
