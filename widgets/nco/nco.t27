// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nco.t27 -- a numerically controlled oscillator: a phase accumulator and a sine table
; Source of truth for public/widgets/nco/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nco/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 14 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader sets the clock, the accumulator width, the wanted output frequency, and the
; phase and amplitude bits of the sine table. The spec picks the tuning word M; the wheel shows the
; accumulator stepping M each clock, and the output shows the table's samples against the ideal tone.
; Tiles: M, the frequency it actually gives, the resolution f_clk / 2^N and the phase-truncation spur rule.

; WHAT IT DOES NOT CLAIM: the spur level is the rule of thumb (about 6.02 dB per phase bit), not a computed spectrum.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nco;

pub const KIND : str = "widget-tool";
pub const ID : str = "nco";
pub const TITLE : str = "The NCO: a phase accumulator and a sine table";
pub const DESCRIPTION : str = "Set a clock, an accumulator width and a frequency. The spec picks the tuning word; watch the phase step around the wheel and the table turn it into a sine.";
pub const IMAGE_ALT : str = "NCO card: a 100 MHz clock and a 32-bit accumulator asked for 25 MHz. The tuning word is 2^30, so the phase steps a quarter turn per clock; the resolution is 0.0233 Hz.";
pub const HOOK : str = "100 MHz clock, 32-bit accumulator: any frequency in steps of 0.0233 Hz, from one adder and a sine table.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Analog Devices MT-085, Fundamentals of Direct Digital Synthesis: f_out = M f_clk / 2^N, phase truncation spurs", "Analog Devices, A Technical Tutorial on Digital Signal Synthesis, 1999"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_HZ_PER_MHZ : u32 = 1000000;
pub const K_WHEEL_STEPS : u8 = 16;
pub const K_CLOCKS_SHOWN : u8 = 64;
pub const K_FCLK_MIN_MHZ : u16 = 10;
pub const K_FCLK_MAX_MHZ : u16 = 500;
pub const K_MIN_ACC_BITS : u8 = 8;
pub const K_MAX_ACC_BITS : u8 = 32;
pub const K_FOUT_MAX_MHZ : u16 = 250;
pub const K_FOUT_STEP_DIV : u16 = 1000;
pub const K_MIN_TABLE_BITS : u8 = 4;
pub const K_MAX_TABLE_BITS : u8 = 16;
pub const K_PRESET_FCLK_MHZ : [4]u16 = [100, 100, 100, 100];
pub const K_PRESET_ACC_BITS : [4]u8 = [32, 32, 16, 32];
pub const K_PRESET_FOUT_KHZ : [4]u32 = [25000, 1000, 7000, 3000];
pub const K_PRESET_PHASE_BITS : [4]u8 = [12, 12, 6, 4];
pub const K_PRESET_AMP_BITS : [4]u8 = [16, 16, 8, 6];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["25 MHz: M = 2^30", "1 MHz", "7 MHz, 16-bit accumulator", "3 MHz, a coarse table"];
pub const SAY_FCLK : str = "Clock, MHz";
pub const SAY_NBITS : str = "Accumulator bits N";
pub const SAY_FOUT : str = "Wanted output, MHz";
pub const SAY_PBITS : str = "Table phase bits P";
pub const SAY_ABITS : str = "Table word bits A";
pub const SAY_PBITS_TOO_MANY : str = "The table cannot take more phase bits than the accumulator has.";
pub const SAY_WHEEL_LABEL : str = "The phase accumulator stepping around the circle, one step per clock";
pub const SAY_OUT_LABEL : str = "The output samples from the sine table, and the ideal tone";
pub const SAY_WORD_IS : str = "M = {0}";
pub const SAY_STEP_IS : str = "turn per clock {0}";
pub const SAY_FOUT_IS : str = "f_out = {0} Hz";
pub const SAY_RES_IS : str = "resolution {0} Hz";
pub const SAY_WHEEL_NOTE : str = "the first {0} clocks";
pub const SAY_CLOCKS : str = "clocks";
pub const SAY_WORD : str = "tuning word M";
pub const SAY_ACTUAL : str = "output, exactly";
pub const SAY_HZ : str = "{0} Hz";
pub const SAY_RES : str = "resolution f_clk / 2^N";
pub const SAY_SPUR : str = "spur rule, P bits";
pub const SAY_DBC : str = "{0} dBc";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/signals.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_quarter_turn_preset_is_exact {
    assert K_PRESET_FCLK_MHZ[0] == 4 * K_PRESET_FOUT_KHZ[0] / 1000;
    assert K_PRESET_ACC_BITS[0] == K_MAX_ACC_BITS;
}

test the_output_stays_below_half_the_fastest_clock {
    assert K_FOUT_MAX_MHZ * 2 == K_FCLK_MAX_MHZ;
    assert K_MAX_TABLE_BITS <= K_MAX_ACC_BITS;
    assert K_PRESET_PHASE_BITS[2] < K_PRESET_ACC_BITS[2];
}
