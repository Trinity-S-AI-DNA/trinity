// SPDX-License-Identifier: Apache-2.0
; specs/widgets/basics-what-a-spec-is.t27 -- the infographic of lesson 1 of the t27 basics course (specs/course/t27-basics.t27)
; Source of truth for public/widgets/basics-what-a-spec-is/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/basics/01_what_a_spec_is.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_basics_what_a_spec_is;

pub const KIND : str = "widget-tool";
pub const ID : str = "basics-what-a-spec-is";
pub const TITLE : str = "t27 basics 1: the three parts of a spec";
pub const DESCRIPTION : str = "A table of the parts of a .t27 file and a diagram of what t27c gives back for it. Lesson 1 of the t27 basics course.";
pub const IMAGE_ALT : str = "A black and white table: the parts of a t27 spec are a module line, declarations and test blocks; a diagram shows a .t27 file going into t27c and coming out as a verdict, test results and code for 7 backends.";
pub const HOOK : str = "A t27 spec has three parts: a module line, declarations, tests. One table, one diagram.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/basics/01_what_a_spec_is.t27, compiled clean on 7 backends by public/t27/t27_compiler.wasm, whose tests pass in the site test runner", "Compiler verdicts, error lines, code and counts quoted on this page are what the same wasm answered in node 22 when the course was authored; words without a run behind them are said to be read, not run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "The parts of a spec, top to bottom";
pub const SAY_TABLE_HEAD : [3]str = ["Part", "Looks like", "What it is for"];
pub const SAY_TABLE_CELLS : [9]str = ["Module line", "module basics_01_what_a_spec_is;", "Names the module; one per file", "Declarations", "pub const SIDES : u8 = 3;", "Named values, functions, structs, enums", "Tests", "test name { assert SIDES == 3; }", "Checks the spec makes about itself"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 3;
pub const K_TABLE_CELLS : u16 = 9;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "What t27c does with a spec";
pub const SAY_FLOW_STEPS : [4]str = ["A .t27 file", "t27c reads it", "A verdict and test results", "Code for 7 backends"];
pub const K_FLOW_STEPS : u8 = 4;
pub const SAY_NOTE : str = "The page compiles the lesson spec with t27_compiler.wasm, the compiler built for the browser.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 4;
    assert K_FLOW_STEPS > 1;
}
