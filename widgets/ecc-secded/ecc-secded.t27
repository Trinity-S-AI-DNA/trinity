// SPDX-License-Identifier: Apache-2.0
; specs/widgets/ecc-secded.t27 -- an ECC word you can break: one flip is fixed, two are caught
; Source of truth for public/widgets/ecc-secded/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO CODE of its
; own: encode, syndrome, parity, verdict, correction and decode come from
; public/widgets/ecc-secded/logic.js -- the fn bodies of gHashTag/t27 specs/fpga/secded.t27
; (t27#8931) compiled to wasm, beside its copy logic.t27.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader types a data byte; the page shows its 13-bit SECDED word -- Hamming
; check bits at positions 1, 2, 4, 8, data at the rest, overall parity at 0 -- and every bit is a
; button that flips it, as a cosmic ray or a weak cell would. The syndrome names the flipped
; position, the overall parity tells one flip from two, and the decoded byte shows what the
; memory controller would hand back.

; WHAT IT DOES NOT CLAIM: three or more flips can alias to one and be "corrected" wrongly; real
; DRAM ECC uses (72,64) words, the same construction at a larger width.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_ecc_secded;

pub const KIND : str = "widget-tool";
pub const ID : str = "ecc-secded";
pub const TITLE : str = "ECC SECDED: flip a bit, watch the syndrome find it, flip two";
pub const DESCRIPTION : str = "An 8-bit byte as a 13-bit SECDED word. Flip any bit: the syndrome names it and it is fixed. Flip two: detected, not fixed.";
pub const IMAGE_ALT : str = "ECC SECDED card: the byte 0xA5 as a 13-bit word with check bits at positions 1, 2, 4 and 8 and parity at 0. Bit 6 is flipped: the syndrome reads 0110, six, the parity is odd, and the byte comes back as 0xA5.";
pub const HOOK : str = "The syndrome is the position of the flipped bit, in binary. One extra parity bit tells one flip from two.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/fpga/secded.t27 (t27#8931): every value on the page is its fn bodies, compiled to wasm (logic.js), with 6 tests over every byte, every single flip and every double flip of three words", "R. W. Hamming, Error Detecting and Error Correcting Codes, Bell System Technical Journal 29(2), 1950; the extended (SECDED) form used per word by ECC memory"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- The logic spec's own numbers (logic.t27); scripts/widget-logic.mjs holds them equal ------
pub const K_WORD_BITS : u8 = 13;
pub const K_DATA_BITS : u8 = 8;
pub const K_CLEAN : u8 = 0;
pub const K_CORRECTED : u8 = 1;
pub const K_DOUBLE : u8 = 2;

; --- Presets: the data byte and the positions flipped (255 = none) ----------------------------
pub const K_PRESET_BYTE : [4]u8 = [165, 165, 165, 165];
pub const K_PRESET_FLIP_A : [4]u8 = [255, 6, 0, 3];
pub const K_PRESET_FLIP_B : [4]u8 = [255, 255, 255, 9];
pub const K_START_PRESET : u8 = 1;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_LOADING : str = "Loading";
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["clean word", "one flip at position 6", "the parity bit flipped", "two flips: 3 and 9"];
pub const SAY_BYTE : str = "Data byte (0-255 or 0x00-0xFF)";
pub const SAY_BAD_INPUT : str = "A byte is 0 to 255, or 0x00 to 0xFF.";
pub const SAY_WORD_LABEL : str = "The 13-bit word, position 12 to 0. Press a bit to flip it.";
pub const SAY_ROLES : [3]str = ["P", "C", "D"];
pub const SAY_SYNDROME : str = "syndrome {0} = {1}";
pub const SAY_PARITY : str = "overall parity: {0}";
pub const SAY_ODD : str = "odd";
pub const SAY_EVEN : str = "even";
pub const SAY_VERDICTS : [3]str = ["clean: nothing to fix", "one flip, at position {0}: corrected", "two flips: detected, not correctable"];
pub const SAY_DECODED : str = "byte handed back: {0}";
pub const SAY_RESET : str = "Undo all flips";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/secded.t27, compiled";

test the_word_is_data_plus_five {
    assert K_WORD_BITS == K_DATA_BITS + 5;
    assert K_CLEAN == 0;
    assert K_CORRECTED == 1;
    assert K_DOUBLE == 2;
}

test the_presets_stay_inside_the_word {
    assert K_PRESET_FLIP_A[1] < K_WORD_BITS;
    assert K_PRESET_FLIP_A[3] < K_PRESET_FLIP_B[3];
    assert K_PRESET_FLIP_B[3] < K_WORD_BITS;
    assert K_CARD_WIDTH == 1200;
}
