// SPDX-License-Identifier: Apache-2.0
// specs/fpga/secded.t27 -- an ECC word: 8 data bits, 4 Hamming checks and one overall parity
// Host: gHashTag/trinity apps/website public/widgets/ecc-secded/ (the ecc-secded widget): its
//       logic.js is these fn bodies compiled to wasm (scripts/t27-logic.mjs in
//       gHashTag/999-multibots-telegraf, types stripped); the page writes no code of its own.
//
// THE CODE (R. W. Hamming, "Error Detecting and Error Correcting Codes", Bell System Technical
// Journal 29(2), 1950; the extended form with an overall parity bit is SECDED, single error
// correction and double error detection, the scheme ECC memory uses per word, e.g. (72,64)):
// positions 1..12 of a 13-bit word, numbered from 1, hold check bits at the powers of two
// (1, 2, 4, 8) and the 8 data bits at 3, 5, 6, 7, 9, 10, 11, 12, low data bit first. Check bit p
// makes the XOR of every position whose number has bit p set equal to zero. Bit 0 of the word
// is the overall parity of positions 1..12, which makes the whole word even.
// On read, the SYNDROME is the XOR of the numbers of all positions holding a 1: zero for a clean
// word, the position of the flipped bit for one error. The overall parity tells one error (odd)
// from two (even): syndrome != 0 and even parity means two bits flipped -- detected, not
// correctable. Syndrome 0 with odd parity is the parity bit itself.
//
// WHAT IT DOES NOT CLAIM: three or more flips can look like one and be "corrected" wrongly; this
// code bounds what it promises to single correction and double detection.
// Claim status: checked by the tests below exhaustively over every single flip and every pair
// of flips of several words, and on the round trip of all 256 data bytes.
// phi^2 + 1/phi^2 = 3 | TRINITY

module fpga::secded {

    pub const KIND : str = "widget-logic";
    pub const ID : str = "ecc-secded";
    pub const VERSION : u8 = 1;
    pub const DATA_BITS : u8 = 8;
    pub const WORD_BITS : u8 = 13;
    pub const CLEAN : u8 = 0;
    pub const CORRECTED : u8 = 1;
    pub const DOUBLE : u8 = 2;

    // The word position of data bit i (0..7): the positions that are not powers of two.
    fn data_pos(i: u8) -> u8 {
        if (i == 0) { return 3; }
        if (i == 1) { return 5; }
        if (i == 2) { return 6; }
        if (i == 3) { return 7; }
        if (i == 4) { return 9; }
        if (i == 5) { return 10; }
        if (i == 6) { return 11; }
        return 12;
    }

    // XOR of the numbers of every position 1..12 that holds a 1.
    fn syndrome(w: u16) -> u8 {
        var s : u8 = 0;
        var p : u8 = 1;
        while (p < WORD_BITS) {
            if (((w >> p) & 1) == 1) {
                s = s ^ p;
            }
            p = p + 1;
        }
        return s;
    }

    // Parity of all 13 bits: 0 even, 1 odd.
    fn parity(w: u16) -> u8 {
        var x : u16 = 0;
        var p : u8 = 0;
        while (p < WORD_BITS) {
            x = x ^ ((w >> p) & 1);
            p = p + 1;
        }
        return x as u8;
    }

    // The 13-bit word for a data byte.
    fn encode(d: u8) -> u16 {
        var w : u16 = 0;
        var i : u8 = 0;
        while (i < DATA_BITS) {
            if (((d >> i) & 1) == 1) {
                w = w | ((1 as u16) << data_pos(i));
            }
            i = i + 1;
        }
        const s = syndrome(w);
        var b : u8 = 0;
        while (b < 4) {
            if (((s >> b) & 1) == 1) {
                w = w | ((1 as u16) << ((1 as u8) << b));
            }
            b = b + 1;
        }
        if (parity(w) == 1) {
            w = w | 1;
        }
        return w;
    }

    // What a read word is: CLEAN, CORRECTED (one flip) or DOUBLE (two flips, detected).
    fn verdict(w: u16) -> u8 {
        const s = syndrome(w);
        const odd = parity(w);
        if (s == 0 && odd == 0) {
            return CLEAN;
        }
        if (odd == 1) {
            return CORRECTED;
        }
        return DOUBLE;
    }

    // The position a single flip hit (0 = the parity bit), or 255 when there is none to fix.
    fn flipped(w: u16) -> u8 {
        if (verdict(w) != CORRECTED) {
            return 255;
        }
        return syndrome(w);
    }

    // The word with a single flip undone; any other word is returned as read.
    fn correct(w: u16) -> u16 {
        const at = flipped(w);
        if (at == 255 || at >= WORD_BITS) {
            return w;
        }
        return w ^ ((1 as u16) << at);
    }

    // The data byte a word carries, after correction.
    fn decode(w: u16) -> u8 {
        const c = correct(w);
        var d : u8 = 0;
        var i : u8 = 0;
        while (i < DATA_BITS) {
            if (((c >> data_pos(i)) & 1) == 1) {
                d = d | ((1 as u8) << i);
            }
            i = i + 1;
        }
        return d;
    }

    // Every single flip of the word for d is corrected back to d.
    fn every_single_flip_fixed(d: u8) -> bool {
        const w = encode(d);
        var p : u8 = 0;
        while (p < WORD_BITS) {
            const bad = w ^ ((1 as u16) << p);
            if (verdict(bad) != CORRECTED || decode(bad) != d || flipped(bad) != p) {
                return false;
            }
            p = p + 1;
        }
        return true;
    }

    // Every pair of flips of the word for d is detected as DOUBLE.
    fn every_double_flip_caught(d: u8) -> bool {
        const w = encode(d);
        var a : u8 = 0;
        while (a < WORD_BITS) {
            var b : u8 = a + 1;
            while (b < WORD_BITS) {
                const bad = w ^ ((1 as u16) << a) ^ ((1 as u16) << b);
                if (verdict(bad) != DOUBLE) {
                    return false;
                }
                b = b + 1;
            }
            a = a + 1;
        }
        return true;
    }

    // decode(encode(d)) == d for all 256 bytes.
    fn every_byte_round_trips() -> bool {
        var d : u16 = 0;
        while (d < 256) {
            const w = encode(d as u8);
            if (decode(w) != (d as u8) || verdict(w) != CLEAN) {
                return false;
            }
            d = d + 1;
        }
        return true;
    }

    test "a clean word has syndrome 0 and even parity" {
        assert(encode(0) == 0);
        assert(syndrome(encode(165)) == 0);
        assert(parity(encode(165)) == 0);
        assert(verdict(encode(255)) == CLEAN);
    }

    test "the data sits at the positions that are not powers of two" {
        assert(encode(1) == 15);
        assert(data_pos(0) == 3);
        assert(data_pos(7) == 12);
        assert(decode(encode(90)) == 90);
    }

    test "every byte round-trips" {
        assert(every_byte_round_trips());
    }

    test "one flip anywhere is found and fixed" {
        assert(every_single_flip_fixed(0));
        assert(every_single_flip_fixed(165));
        assert(every_single_flip_fixed(255));
        assert(flipped(encode(165) ^ 64) == 6);
        assert(flipped(encode(165) ^ 1) == 0);
    }

    test "two flips are caught, never miscorrected" {
        assert(every_double_flip_caught(0));
        assert(every_double_flip_caught(165));
        assert(every_double_flip_caught(255));
        assert(correct(encode(165) ^ 6) == (encode(165) ^ 6));
    }

    test "VERSION says what the header says" {
        assert(VERSION == 1);
        assert(WORD_BITS == DATA_BITS + 5);
        assert(flipped(encode(7)) == 255);
    }
}
// phi^2 + 1/phi^2 = 3 | TRINITY
