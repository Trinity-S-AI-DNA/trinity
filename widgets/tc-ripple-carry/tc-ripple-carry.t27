// SPDX-License-Identifier: Apache-2.0
; specs/widgets/tc-ripple-carry.t27 -- lesson 9 of the course "The ternary machine" (specs/course/ternary-computing.t27)
; Source of truth for public/widgets/tc-ripple-carry/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles this
; file, checks its constants, evaluates the tests below and writes the page; the page hands every constant to
; tool.js as window.T27_WIDGET. tool.js draws through ../ternary-kit.js and computes nothing: every number comes
; from public/widgets/tc-ripple-carry/logic.js, the fn bodies of the gHashTag/t27 spec in logic.t27, compiled to wasm.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_tc_ripple_carry;

pub const KIND : str = "widget-tool";
pub const ID : str = "tc-ripple-carry";
pub const TITLE : str = "Ripple carry: add two numbers trit by trit";
pub const DESCRIPTION : str = "Two numbers, one full adder per place, the carry walking left. Press play to watch every column decide its sum.";
pub const IMAGE_ALT : str = "Ripple carry card: 13 + 1 added in six columns. 13 is +++; the ones place makes 2 = 3 - 1, so a carry of +1 ripples left through three places and the sum row reads +---, which is 14.";
pub const HOOK : str = "13 + 1 in balanced ternary: one carry ripples through three places and +++ becomes +---.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ternary/trits.t27 (t27#8979): every value on the page is its fn bodies, compiled to wasm (logic.js), with 18 tests and 4108 runtime asserts", "D. Knuth, The Art of Computer Programming, vol. 2, section 4.1: balanced ternary"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

pub const SAY_LOADING : str = "Loading";
pub const K_TRITS : u32 = 6;
pub const K_START_X : i32 = 13;
pub const K_START_Y : i32 = 1;
pub const K_TICK_MS : u16 = 600;
pub const SAY_PLAY : str = "Add column by column";
pub const SAY_CARRY_IN : str = "carry in";
pub const SAY_SUM : str = "sum";
pub const SAY_RESULT : str = "{0} + {1} = {2}";
pub const SAY_COLUMN : str = "{0} of {1} columns added";
pub const SAY_DONE : str = "Every column added: the same sum the full adders give one place at a time.";
pub const SAY_SOURCE : str = "Logic: t27 spec ternary/trits.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_widget_starts_where_its_card_says {
    assert K_START_X == 13;
    assert K_START_Y == 1;
}
