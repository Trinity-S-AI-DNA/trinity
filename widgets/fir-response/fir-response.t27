// SPDX-License-Identifier: Apache-2.0
; specs/widgets/fir-response.t27 -- the moving average: the simplest low-pass, its response and its nulls
; Source of truth for public/widgets/fir-response/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/fir-response/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 16 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader sets the averaging length L and a test tone. The response |H(f)| of the
; L-point moving average is drawn from 0 to half the sample rate, with its nulls at multiples of 1/L;
; below, the tone and the averager's output, sample by sample, smaller by exactly that gain.

; WHAT IT DOES NOT CLAIM: frequencies are in cycles per sample (0.5 is half the sample rate); the output starts from zeros.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_fir_response;

pub const KIND : str = "widget-tool";
pub const ID : str = "fir-response";
pub const TITLE : str = "The moving average: a low-pass you can do in your head";
pub const DESCRIPTION : str = "Set how many samples to average and pick a tone. See the response, its nulls at multiples of 1/L, and the tone coming out smaller by exactly that much.";
pub const IMAGE_ALT : str = "Moving average card: a 4-point average and a tone at 0.125 cycles per sample. The response falls from 1 to a null at 0.25 and the tone comes out at 0.65328 of its size, -3.70 dB.";
pub const HOOK : str = "Average 4 samples and a tone at 1/8 of the sample rate keeps 0.653 of its size; at 1/4 it vanishes. A filter with no multipliers at all.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "R. G. Lyons, Understanding Digital Signal Processing, 3rd ed., ch. 5: finite impulse response filters", "S. W. Smith, The Scientist and Engineer's Guide to Digital Signal Processing, ch. 15: moving average filters"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_MIN_LEN : u8 = 2;
pub const K_MAX_LEN : u8 = 32;
pub const K_F_STEP_DIV : u16 = 200;
pub const K_SAMPLES_SHOWN : u8 = 48;
pub const K_PRESET_LEN : [4]u8 = [4, 4, 8, 16];
pub const K_PRESET_F_STEPS : [4]u16 = [25, 50, 10, 30];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["L = 4 at 0.125", "L = 4 at its null", "L = 8 at 0.05", "L = 16 at 0.15"];
pub const SAY_LEN : str = "Samples averaged L";
pub const SAY_F : str = "Tone, cycles per sample";
pub const SAY_RESP_LABEL : str = "The response of the moving average, 0 to half the sample rate";
pub const SAY_TIME_LABEL : str = "The tone and the averaged output";
pub const SAY_F_AXIS : str = "frequency, cycles per sample";
pub const SAY_GAIN_AXIS : str = "|H|";
pub const SAY_TIME_AXIS : str = "samples";
pub const SAY_IN : str = "tone in";
pub const SAY_OUT : str = "average out";
pub const SAY_AT : str = "tone at";
pub const SAY_CYC : str = "{0} cyc/sample";
pub const SAY_GAIN : str = "gain |H|";
pub const SAY_GAIN_DB : str = "gain";
pub const SAY_DB_VALUE : str = "{0} dB";
pub const SAY_NULLS : str = "nulls";
pub const SAY_NULLS_AT : str = "every 1/{0}";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/signals.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_null_preset_sits_on_one_over_l {
    assert K_PRESET_F_STEPS[1] * K_PRESET_LEN[1] == K_F_STEP_DIV;
    assert K_PRESET_F_STEPS[0] * 8 == K_F_STEP_DIV;
}

test the_lengths_and_the_tones_stay_in_range {
    assert K_MAX_LEN <= 32;
    assert K_PRESET_F_STEPS[3] * 2 <= K_F_STEP_DIV;
    assert K_PRESET_LEN[3] <= K_MAX_LEN;
}
