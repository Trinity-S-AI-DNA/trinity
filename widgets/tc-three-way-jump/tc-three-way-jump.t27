// SPDX-License-Identifier: Apache-2.0
; specs/widgets/tc-three-way-jump.t27 -- lesson 20 of the course "The ternary machine" (specs/course/ternary-computing.t27)
; Source of truth for public/widgets/tc-three-way-jump/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles this
; file, checks its constants, evaluates the tests below and writes the page; the page hands every constant to
; tool.js as window.T27_WIDGET. tool.js draws through ../ternary-kit.js and computes nothing: every number comes
; from public/widgets/tc-three-way-jump/logic.js, the fn bodies of the gHashTag/t27 spec in logic.t27, compiled to wasm.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_tc_three_way_jump;

pub const KIND : str = "widget-tool";
pub const ID : str = "tc-three-way-jump";
pub const TITLE : str = "A three-way jump: one compare, three targets";
pub const DESCRIPTION : str = "Compare two registers once and jump on the trit: less, equal or greater. A binary machine needs two tests for the same branch.";
pub const IMAGE_ALT : str = "Three-way jump card: a = 40 against b = 13 compared trit by trit from the top; the first differing trit decides +1, and the jump takes the greater branch of three.";
pub const HOOK : str = "One compare, three ways out. Binary branches test twice to tell less from equal from greater.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ternary/trits.t27 (t27#8979): every value on the page is its fn bodies, compiled to wasm (logic.js), with 18 tests and 4108 runtime asserts", "N. P. Brusentsov and others, the Setun computer, Moscow State University, 1958: a working balanced-ternary machine"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

pub const SAY_LOADING : str = "Loading";
pub const K_TRITS : u32 = 9;
pub const K_START_A : i32 = 40;
pub const K_START_B : i32 = 13;
pub const SAY_JUMP : str = "compare gives {0}: jump to {1}";
pub const SAY_TARGETS : [3]str = ["less", "equal", "greater"];
pub const SAY_HOW : str = "The gold column is where a and b first differ; that trit is the answer.";
pub const SAY_SOURCE : str = "Logic: t27 spec ternary/trits.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_widget_starts_where_its_card_says {
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == false;
}
