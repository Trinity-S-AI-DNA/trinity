// SPDX-License-Identifier: Apache-2.0
; specs/widgets/basics-reading-errors.t27 -- the infographic of lesson 25 of the t27 basics course (specs/course/t27-basics.t27)
; Source of truth for public/widgets/basics-reading-errors/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/basics/25_reading_errors.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_basics_reading_errors;

pub const KIND : str = "widget-tool";
pub const ID : str = "basics-reading-errors";
pub const TITLE : str = "t27 basics 25: four mistakes and what t27c says";
pub const DESCRIPTION : str = "Four small mistakes in a t27 spec and the exact message the real compiler printed for each. Lesson 25 of the t27 basics course.";
pub const IMAGE_ALT : str = "A black and white table of four mistakes in a t27 spec, a lone semicolon line, a semicolon inside a test, a u8 given 300 and a generic function, each with the error message the compiler printed.";
pub const HOOK : str = "Four tiny t27 mistakes and the exact error lines the compiler prints for them.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/basics/25_reading_errors.t27, compiled clean on 7 backends by public/t27/t27_compiler.wasm, whose tests pass in the site test runner", "Compiler verdicts, error lines, code and counts quoted on this page are what the same wasm answered in node 22 when the course was authored; words without a run behind them are said to be read, not run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Mistakes, as the compiler answered";
pub const SAY_TABLE_HEAD : [2]str = ["Mistake", "Compiler said"];
pub const SAY_TABLE_CELLS : [8]str = ["A lone ; on line 2", "parse error at module level near line 2: Unexpected token in expression: Semicolon (';') at line 2:1", "assert N == 1;; in a test", "parse error in fn 't' near line 4: Unexpected token in expression: Semicolon (';') at line 4:19", "pub const N : u8 = 300;", "error: constant 'N' declares u8 but its value has 3 digits, which no u8 can hold", "fn id<T>(x: T) -> T", "Expected LParen, got Lt ('<') at line 2:6"];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 4;
pub const K_TABLE_CELLS : u16 = 8;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_NOTE : str = "Each message is what t27_compiler.wasm printed when this page was authored.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}
