// SPDX-License-Identifier: Apache-2.0
; specs/widgets/golden-dot-two.t27 -- the infographic of lesson 14 of the GoldenFloat course (specs/course/goldenfloat.t27)
; Source of truth for public/widgets/golden-dot-two/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/ternary/gft_dot2.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_golden_dot_two;

pub const KIND : str = "widget-tool";
pub const ID : str = "golden-dot-two";
pub const TITLE : str = "GoldenFloat 14: two products, one sum";
pub const DESCRIPTION : str = "The two tests of gft_dot2.t27, read from gft_dot2.t27. Lesson 14 of the GoldenFloat course.";
pub const IMAGE_ALT : str = "A black and white table, The two tests of gft_dot2.t27: one_times_one_mul, 20480 x 20480, 20480 (1.0); dot_one, 1 x 1 + 1 x 1, 20992 (2.0).";
pub const HOOK : str = "The smallest dot product in GF-T16: a1 * b1 + a2 * b2, checked in two tests.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/ternary/gft_dot2.t27, read when the course was authored; every number in the table is a constant, a test value or arithmetic of that file", "Nothing on this page was measured on hardware or timed; a value written into a test is said to be written in, not computed"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "The two tests of gft_dot2.t27";
pub const SAY_TABLE_HEAD : [3]str = ["Test", "Inputs", "Result code"];
pub const SAY_TABLE_CELLS : [6]str = ["one_times_one_mul", "20480 x 20480", "20480 (1.0)", "dot_one", "1 x 1 + 1 x 1", "20992 (2.0)"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 2;
pub const K_TABLE_CELLS : u16 = 6;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "One multiply-accumulate";
pub const SAY_FLOW_STEPS : [3]str = ["a1 x b1", "a2 x b2", "add the two"];
pub const K_FLOW_STEPS : u8 = 3;
pub const SAY_NOTE : str = "GF-T16 magnitude: 7-bit offset, 9-bit mantissa, value = (1 + mant / 512) x 2^(offset - 40).";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 3;
    assert K_FLOW_STEPS > 1;
}
