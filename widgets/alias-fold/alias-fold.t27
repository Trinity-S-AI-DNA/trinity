// SPDX-License-Identifier: Apache-2.0
; specs/widgets/alias-fold.t27 -- sampling and aliasing: a tone above fs/2 comes back as a lower one
; Source of truth for public/widgets/alias-fold/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/alias-fold/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 13 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader sets a tone frequency and a sample rate. The fold is drawn as the apparent
; frequency against the input frequency -- a triangle with its corners at multiples of fs/2, every other
; Nyquist zone shaded -- and the tone and where it lands are marked. Below, the tone, its samples and the
; alias tone that passes through the same samples.

; WHAT IT DOES NOT CLAIM: an ideal sampler with no anti-alias filter; units are the reader's (Hz, kHz or MHz alike).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_alias_fold;

pub const KIND : str = "widget-tool";
pub const ID : str = "alias-fold";
pub const TITLE : str = "Sampling and aliasing: the fold of every frequency";
pub const DESCRIPTION : str = "Set a tone and a sample rate: the tone folds back into 0 .. fs/2 like paper, and below, its samples fit a lower tone exactly.";
pub const IMAGE_ALT : str = "Aliasing card: a tone at 70 sampled at 100 is seen at 30. The fold is a triangle with corners every 50; the 12 samples of the 70 tone lie exactly on a 30 tone, mirrored.";
pub const HOOK : str = "Sample 70 at 100 and the samples are those of 30, mirrored. Nothing after the converter can tell them apart.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "H. Nyquist, Certain topics in telegraph transmission theory, Trans. AIEE 47, 1928; C. E. Shannon, Communication in the presence of noise, Proc. IRE 37, 1949"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_F_MAX : u16 = 400;
pub const K_FS_MIN : u16 = 20;
pub const K_FS_MAX : u16 = 200;
pub const K_SAMPLES_SHOWN : u8 = 12;
pub const K_PRESET_F : [4]u16 = [30, 70, 130, 240];
pub const K_PRESET_FS : [4]u16 = [100, 100, 100, 100];
pub const K_START_PRESET : u8 = 1;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["30 at 100: below fs/2", "70 at 100: folds to 30", "130 at 100: back to 30", "240 at 100: 40"];
pub const SAY_F : str = "Tone frequency";
pub const SAY_FS : str = "Sample rate fs";
pub const SAY_FOLD_LABEL : str = "Apparent frequency against input frequency, Nyquist zones shaded";
pub const SAY_TIME_LABEL : str = "The tone, its samples and the alias through the same samples";
pub const SAY_IN_AXIS : str = "input frequency";
pub const SAY_OUT_AXIS : str = "seen at";
pub const SAY_SEEN_AT : str = "seen at {0}";
pub const SAY_TIME_AXIS : str = "time, {0} sample periods";
pub const SAY_FOLD_NOTE : str = "Every other shaded band is a Nyquist zone where the fold runs backwards: the alias comes out mirrored.";
pub const SAY_TONE : str = "the tone";
pub const SAY_ALIAS : str = "the alias";
pub const SAY_SAMPLES : str = "samples";
pub const SAY_INPUT : str = "input frequency";
pub const SAY_APPARENT : str = "apparent frequency";
pub const SAY_ZONE : str = "Nyquist zone";
pub const SAY_FLIPPED : str = "mirrored";
pub const SAY_YES : str = "yes";
pub const SAY_NO : str = "no";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/signals.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_presets_fold_onto_thirty {
    assert K_PRESET_FS[1] - K_PRESET_F[1] == K_PRESET_F[0];
    assert K_PRESET_F[2] - K_PRESET_FS[2] == K_PRESET_F[0];
    assert K_PRESET_F[3] < K_F_MAX;
}

test the_rates_leave_room_to_fold {
    assert K_FS_MAX * 2 == K_F_MAX;
    assert K_FS_MIN < K_PRESET_FS[0];
    assert K_SAMPLES_SHOWN == 12;
}
