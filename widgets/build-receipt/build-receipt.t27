; --- Tests: the generator evaluates these before it writes the page ----------------------
test the_items_add_up_to_the_total {
    assert K_STAGE_MS[0] + K_STAGE_MS[1] + K_STAGE_MS[2] + K_STAGE_MS[3] + K_STAGE_MS[4] + K_STAGE_MS[5] <= K_TOTAL_MS + K_ROUND_TOL_MS;
    assert K_STAGE_MS[0] + K_STAGE_MS[1] + K_STAGE_MS[2] + K_STAGE_MS[3] + K_STAGE_MS[4] + K_STAGE_MS[5] + K_ROUND_TOL_MS >= K_TOTAL_MS;
    assert K_ROUND_TOL_MS == (K_STAGE_PLAN + 1) / 2;
}

test the_stage_count_matches_the_data {
    assert K_STAGE_COUNT == K_STAGE_PLAN;
    assert K_STAGES_OK <= K_STAGE_COUNT;
    assert SAY_STAGE_NAMES[5] == "sha256 of the .bit";
}

test no_vendor_tool_was_run {
    assert K_VENDOR_TOOLS_RUN == 0;
    assert K_BIT_BYTES > 0;
}

test the_page_sends_nothing {
    assert READS_LOCAL_FILES == false;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
    assert K_DATA_FILE == "./receipt.json";
}
