// SPDX-License-Identifier: Apache-2.0
; specs/widgets/build-receipt.t27 -- one open-flow build, t27 spec to XC7A200T bitstream, as a receipt
; Source of truth for public/widgets/build-receipt/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English of its own: every
; word on screen is a SAY_ constant here, every number the tool relies on is a K_ constant or a field
; of receipt.json written by the same script run.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT SHOWS: a shop-style receipt for one real build on one machine. Each stage of the open flow
; is a line item with its wall time, its tool and version, the size of the file it wrote and that
; file's sha256: the t27 compiler (WebAssembly, in node) turns specs/ternary/stream_ternary_mac.t27
; into Verilog, yosys synthesises it, nextpnr-xilinx places and routes it on the xc7a200tfbg676-1
; chipdb, prjxray's fasm2frames and xc7frames2bit write the bitstream, and the last line hashes it.
; Under the items: the TOTAL, a line that no vendor tool and no licence was used, the exact commands,
; and how to reproduce it. A barcode is drawn from the bitstream's sha256.

; DATA PROVENANCE: scripts/widget-data/build-receipt.mjs ran every stage in /tmp/widget-receipt and
; wrote receipt.json and the generated block below; it then re-checked that the stage times sum to
; the total within rounding and that the stage count matches the data. The datapath is generated
; from the t27 spec; the board wrapper (clock from STARTUPE2's CFGMCLK, two LFSRs as stimulus, three
; LEDs) is hand-written Verilog, scripts/widget-data/build-receipt-top.v, and the receipt says so.
; Outside the total, bitwalk (gHashTag/t27 specs/xilinx7, generated by the same compiler's rust
; target) writes a second .bit from the same frames to check xc7frames2bit's payload.

; WHAT IT DOES NOT CLAIM: that the bitstream was loaded into a board (it was not: no JTAG was run),
; that the design does anything useful on one, or that the times hold on another machine. The run
; shared the machine with other work; its load average at start is printed on the receipt. No Vivado
; was run, so there is no Vivado time to compare against.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_build_receipt;

pub const KIND : str = "widget-tool";
pub const ID : str = "build-receipt";
pub const TITLE : str = "Build receipt: t27 spec to XC7A200T bitstream, no Vivado";
pub const DESCRIPTION : str = "One real open-flow build itemised like a shop receipt: each stage from a t27 spec to an Artix-7 200T bitstream with its time, tool version, output size and sha256.";
pub const IMAGE_ALT : str = "A white thermal-paper receipt on black. Header: Trinity S3AI open flow, build receipt. Six line items with times: t27 to Verilog 0.288 s, synthesis 29.608 s, place and route 57.238 s, FASM to frames 15.979 s, frames to .bit 0.635 s, sha256 0.016 s. TOTAL 103.764 s. Vivado licence 0. Below: a barcode drawn from the bitstream sha256 and the first hex digits of that sha.";
pub const HOOK : str = "From a ternary spec to an Artix-7 200T bitstream with no Vivado: every stage timed, versioned and hashed.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [7]str = ["scripts/widget-data/build-receipt.mjs run, 2026-10-04 on an Apple M1 Pro: every stage time (process.hrtime), cpu and peak memory (/usr/bin/time -l), output size and sha256 (node crypto), written to receipt.json", "public/t27/t27_compiler.wasm in node, targets.verilog of specs/ternary/stream_ternary_mac.t27", "Yosys 0.67+post b8e7da6f40: yosys -V; synth_xilinx -flatten -abc9 -arch xc7", "nextpnr-xilinx 0.9.2-107-g7037c948 with ~/openxc7-src/chipdb/xc7a200tfbg676-1.bin: fmax and utilisation from its log, --freq 80 --seed 1", "prjxray c9f02d85 fasm2frames.py and xc7frames2bit with prjxray-db ab1fc60 artix7 xc7a200tfbg676-1 part.yaml", "bitwalk cross-check: gHashTag/t27 29b78e7fe specs/xilinx7, rust target of the same compiler, rustc 1.98.1", "LED pins R23, T23, J26 LVCMOS33: gHashTag/t27 fpga/vsa/gf16_heartbeat_top.xdc (QMTech Wukong V1)"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- Numbers the tool relies on ------------------------------------------------------------
pub const K_DATA_FILE : str = "./receipt.json";
; The open flow has six stages: gen, synth, pnr, frames, bit, sha256.
pub const K_STAGE_PLAN : u8 = 6;
; Each stage time is rounded to the millisecond on its own and the total once, from the exact sum.
; So the items may miss the total by at most half a millisecond each: K_STAGE_PLAN / 2, rounded up.
pub const K_ROUND_TOL_MS : u8 = 3;

; --- The run: written by the script, re-checked by it and by the tests below ---------------
; --- BEGIN generated by scripts/widget-data/build-receipt.mjs run: do not edit by hand ---
; Run of 2026-10-04T17:41:38Z on Apple M1 Pro, 8 cores, load 151.2 at start.
pub const K_STAGE_COUNT : u8 = 6;
pub const K_STAGES_OK : u8 = 6;
pub const K_STAGE_MS : [6]u32 = [288, 29608, 57238, 15979, 635, 16];
pub const K_TOTAL_MS : u32 = 103764;
pub const K_BIT_BYTES : u32 = 9730757;
pub const K_VENDOR_TOOLS_RUN : u8 = 0;
; --- END generated ---

pub const SAY_STAGE_NAMES : [6]str = ["t27 to Verilog", "synthesis", "place and route", "FASM to frames", "frames to .bit", "sha256 of the .bit"];

; --- Words on the receipt -----------------------------------------------------------------
; Templates fill {name} slots from receipt.json; tool.js adds no words of its own.
pub const SAY_SHOP : str = "TRINITY S3AI OPEN FLOW";
pub const SAY_RECEIPT : str = "build receipt no. {no}";
pub const SAY_WHEN : str = "{when} UTC";
pub const SAY_MACHINE : str = "{cpu}, {cores} cores, macOS {macos}";
pub const SAY_LOAD : str = "load average {load} at start: the machine was shared";
pub const SAY_LABEL_SPEC : str = "spec";
pub const SAY_LABEL_PART : str = "part";
pub const SAY_LABEL_BOARD : str = "board";
pub const SAY_WRAPPER : str = "datapath {name} is generated from the spec; the board wrapper is {lines} lines of hand-written Verilog";
pub const SAY_COL_ITEM : str = "ITEM";
pub const SAY_COL_TIME : str = "TIME";
pub const SAY_OUT : str = "wrote {file}, {size}";
pub const SAY_SHA : str = "sha256 {sha}";
pub const SAY_CPU : str = "cpu {cpu} s, peak memory {rss} MB";
pub const SAY_FAILED : str = "FAILED, exit {exit}";
pub const SAY_NOT_RUN : str = "not run";
pub const SAY_ITEMS : str = "ITEMS {ok} of {count}";
pub const SAY_TOTAL : str = "TOTAL";
pub const SAY_NO_TOTAL : str = "NO TOTAL: a stage failed after {s} in all";
pub const SAY_VIVADO : str = "Vivado licence";
pub const SAY_VENDOR : str = "vendor tools run";
pub const SAY_END_TO_END : str = "end to end, with the script's own work: {s}";
pub const SAY_FMAX : str = "fmax {clock} {mhz} MHz, target {target} MHz";
pub const SAY_PASS : str = "PASS";
pub const SAY_FAIL : str = "FAIL";
pub const SAY_UTIL_TITLE : str = "used on the 200T";
pub const SAY_FILE_SHA : str = "sha256 of the .bit file";
pub const SAY_FILE_SHA_NOTE : str = "changes every run: the file header holds a path, a date and a time";
pub const SAY_PAYLOAD_SHA : str = "sha256 from the sync word on, {size}";
pub const SAY_SAME_PAYLOAD : str = "same payload as the {n} earlier run(s) of the same inputs";
pub const SAY_OTHER_PAYLOAD : str = "payload differs from an earlier run of the same inputs";
pub const SAY_EARLIER : str = "earlier run {when}: total {s}, load {load}";
pub const SAY_CROSS_OK : str = "cross-check: bitwalk, t27's own writer, wrote the same payload from the same frames in {ms} ms (not in the total)";
pub const SAY_CROSS_BAD : str = "cross-check: bitwalk wrote a different payload from the same frames";
pub const SAY_CROSS_SKIP : str = "cross-check: bitwalk was not run";
pub const SAY_NOT_PROGRAMMED : str = "Not loaded into any board: no JTAG was run.";
pub const SAY_BARCODE : str = "Barcode drawn from the sha256 of the .bit file";
pub const SAY_FOOTER : str = "phi^2 + 1/phi^2 = 3 | keep the sha, not the receipt";
pub const SAY_SHOW_CMDS : str = "show commands";
pub const SAY_HIDE_CMDS : str = "hide commands";
pub const SAY_VERIFY_TITLE : str = "Verify it yourself";
pub const SAY_VERIFY_STEPS : [5]str = ["Install the openXC7 tools: yosys, nextpnr-xilinx with the xc7a200tfbg676-1 chipdb, and prjxray with its database.", "Clone gHashTag/trinity, then run: cd apps/website && node scripts/widget-data/build-receipt.mjs run", "Compare the payload sha256 (from the sync word on), not the file sha256: the file header holds a path and a time.", "Run node scripts/widget-data/build-receipt.mjs check: it re-adds the stage times and recounts the stages.", "Expect other times: these were taken once, on one shared laptop."];
pub const SAY_SPEC_DIFF : str = "the spec and receipt.json disagree on {what}";
pub const SAY_LOADING : str = "printing the receipt";
