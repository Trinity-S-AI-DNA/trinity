// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-boundary.t27 -- A boundary: which files a task may reserve
; Source of truth for public/widgets/hive-boundary/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-boundary/logic.js -- the fn
; bodies of gHashTag/t27 specs/queen/shaping.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 2 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  each of four paths carries four facts the reader taps: the file exists, its folder
; exists, the issue cites it, it would be a new file in a language the only-t27 rule denies. Each
; path is path_accepted of its facts; the gate is shape_lands(missing after, 4, refused).

; WHAT IT DOES NOT CLAIM:  it does not read a repository: the four paths and their facts are what
; the reader sets.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_boundary;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-boundary";
pub const TITLE : str = "A boundary: which files a task may reserve";
pub const DESCRIPTION : str = "Four paths a model proposed for an issue. Tap what is true of each: the spec accepts or refuses it, and a shape lands only when every path holds.";
pub const IMAGE_ALT : str = "Boundary card: four proposed paths. An existing spec and a new cited t27 file in an existing folder are green; a cited file in a folder that does not exist and a new cited .py file are red. The gate is shut: 2 of 4 paths refused, the shape does not land.";
pub const HOOK : str = "A wrong boundary is worse than a missing one: it reserves files the work does not own. An invented path is refused, and one refusal stops the shape.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/queen/shaping.t27 (t27 master c42f8fb40): every value on the page is path_accepted and shape_lands, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 2 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_PATHS : u8 = 4;
pub const K_MAX_BOUNDARY_PATHS : u32 = 12;
pub const K_FACT_BITS : [4]u8 = [1, 2, 4, 8];
pub const K_PRESET_P0 : [4]u8 = [1, 1, 1, 1];
pub const K_PRESET_P1 : [4]u8 = [6, 6, 6, 0];
pub const K_PRESET_P2 : [4]u8 = [4, 6, 4, 4];
pub const K_PRESET_P3 : [4]u8 = [14, 6, 14, 14];
pub const K_PRESET_LEFT : [4]u8 = [0, 0, 1, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["Two invented paths", "Every path checked", "Still a section missing", "Only real files"];
pub const SAY_ASK : str = "Which files may a task reserve before a bee starts on it?";
pub const SAY_PATHS : [4]str = ["specs/queen/hive.t27", "specs/queen/comb.t27", "tools/queen/draw/new.t27", "tools/queen/draw.py"];
pub const SAY_FACTS : [4]str = ["exists", "folder exists", "cited by the issue", "new, foreign language"];
pub const SAY_LEFT : str = "a section still missing after the shape";
pub const SAY_OK : str = "accepted";
pub const SAY_BAD : str = "refused";
pub const SAY_LANDS : str = "the shape lands";
pub const SAY_STOPS : str = "the shape does not land";
pub const SAY_COUNT : str = "{0} of {1} paths refused";
pub const SAY_NOTE : str = "A file that exists is always fine: finding the file a title describes is the point. A new file needs a folder that exists, a citation in the issue, and a language the only-t27 rule allows. More than 12 paths is not a task but a project.";
pub const SAY_SOURCE : str = "Logic: t27 spec queen/shaping.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test four_paths_four_facts {
    assert K_PATHS == 4;
    assert K_FACT_BITS[0] == 1;
    assert K_FACT_BITS[3] == 8;
}

test the_start_has_one_path_of_each_kind {
    assert K_PRESET_P0[0] == 1;
    assert K_PRESET_P1[0] == 6;
    assert K_PRESET_P3[0] == 14;
    assert K_PATHS <= K_MAX_BOUNDARY_PATHS;
}
