// SPDX-License-Identifier: Apache-2.0
; specs/widgets/tc-ternary-mac.t27 -- lesson 12 of the course "The ternary machine" (specs/course/ternary-computing.t27)
; Source of truth for public/widgets/tc-ternary-mac/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles this
; file, checks its constants, evaluates the tests below and writes the page; the page hands every constant to
; tool.js as window.T27_WIDGET. tool.js draws through ../ternary-kit.js and computes nothing: every number comes
; from public/widgets/tc-ternary-mac/logic.js, the fn bodies of the gHashTag/t27 spec in logic.t27, compiled to wasm.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_tc_ternary_mac;

pub const KIND : str = "widget-tool";
pub const ID : str = "tc-ternary-mac";
pub const TITLE : str = "A MAC with ternary weights: add, subtract or skip";
pub const DESCRIPTION : str = "Nine inputs, nine weights of -1, 0 or +1. Each clock the accumulator adds, subtracts or does nothing. Press a weight to change it.";
pub const IMAGE_ALT : str = "Ternary MAC card: nine inputs 3, -1, 4, 1, -5, 9, 2, -6, 5 against weights + - 0 + + 0 - + 0. The accumulator does four adds, two subtracts and three skips, no multiply at all, and lands on -8, the dot product.";
pub const HOOK : str = "A dot product with ternary weights is only adds and subtracts. Zero weights cost nothing at all.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ternary/trits.t27 (t27#8979): every value on the page is its fn bodies, compiled to wasm (logic.js), with 18 tests and 4108 runtime asserts", "S. Ma and others, The Era of 1-bit LLMs: All Large Language Models are in 1.58 Bits, 2024: weights of -1, 0 and +1"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

pub const SAY_LOADING : str = "Loading";
pub const K_INPUTS : [9]i32 = [3, -1, 4, 1, -5, 9, 2, -6, 5];
pub const K_WEIGHTS : [9]i32 = [1, -1, 0, 1, 1, 0, -1, 1, 0];
pub const K_TICK_MS : u16 = 500;
pub const SAY_PLAY : str = "Run the nine clocks";
pub const SAY_ACC : str = "accumulator = {0}";
pub const SAY_TALLY : str = "{0} adds, {1} subtracts, {2} skipped; 0 multiplies";
pub const SAY_WEIGHT : str = "weight {0}: {1}";
pub const SAY_HOW : str = "Each clock: weight +1 adds the input, -1 subtracts it, 0 skips it.";
pub const SAY_OPS : [3]str = ["subtract", "skip", "add"];
pub const SAY_SOURCE : str = "Logic: t27 spec ternary/trits.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_widget_starts_where_its_card_says {
    assert K_INPUTS[0] == 3;
    assert K_WEIGHTS[2] == 0;
}
