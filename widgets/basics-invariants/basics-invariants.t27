// SPDX-License-Identifier: Apache-2.0
; specs/widgets/basics-invariants.t27 -- the infographic of lesson 20 of the t27 basics course (specs/course/t27-basics.t27)
; Source of truth for public/widgets/basics-invariants/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/basics/20_invariants.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_basics_invariants;

pub const KIND : str = "widget-tool";
pub const ID : str = "basics-invariants";
pub const TITLE : str = "t27 basics 20: test, invariant and bench";
pub const DESCRIPTION : str = "The three kinds of checking block in t27 and which ones the site test runner evaluates. Lesson 20 of the t27 basics course.";
pub const IMAGE_ALT : str = "A black and white table of three t27 blocks: test checks examples and is evaluated by the site runner, invariant states a rule and is skipped by the site runner, bench names a measurement and is skipped by the site runner.";
pub const HOOK : str = "A false invariant passes in the browser: the site runner skips it. A table of what runs.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/basics/20_invariants.t27, compiled clean on 7 backends by public/t27/t27_compiler.wasm, whose tests pass in the site test runner", "Compiler verdicts, error lines, code and counts quoted on this page are what the same wasm answered in node 22 when the course was authored; words without a run behind them are said to be read, not run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Checking blocks and the site test runner";
pub const SAY_TABLE_HEAD : [3]str = ["Block", "Says", "Site runner"];
pub const SAY_TABLE_CELLS : [9]str = ["test", "These examples hold", "Evaluates the asserts", "invariant", "This rule always holds", "Skips it", "bench", "Time this block", "Skips it"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 3;
pub const K_TABLE_CELLS : u16 = 9;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_NOTE : str = "The lesson spec repeats its invariant as a test, so the browser checks it too.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}
