// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-burn.t27 -- Tokens that burn: a month to spend them
; Source of truth for public/widgets/hive-burn/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-burn/logic.js -- the fn
; bodies of gHashTag/t27 specs/automation/token-wallet.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 21 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader drags today from day 0 to day 60. Each batch is days_left(the day it
; landed, today, 30). The list is ordered by those answers, which is the spend order the spec names,
; soonest burn first.

; WHAT IT DOES NOT CLAIM:  the spec marks the burn as decided but not yet in the ledger; the page
; shows the rule, not a balance.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_burn;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-burn";
pub const TITLE : str = "Tokens that burn: a month to spend them";
pub const DESCRIPTION : str = "Three batches of tokens, each burning 30 days after it lands. Drag today across two months: days_left counts down every batch, and the one that burns soonest is spent first.";
pub const IMAGE_ALT : str = "Burn card on day 25: three bars on a 60-day strip. The package month from day 0 has 5 days left, gold; the start gift from day 3 has 8 days; the top-up from day 12 has 17 days, green. A white line marks today.";
pub const HOOK : str = "All money goes into tokens, and the tokens burn within the month: a person who paid makes content instead of saving tokens.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/automation/token-wallet.t27 (t27 master c42f8fb40): every value on the page is days_left, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 21 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_TODAY_MAX : u8 = 60;
pub const K_MONTH_DAYS : u16 = 30;
pub const K_BATCH_DAYS : [3]u8 = [0, 3, 12];
pub const K_PRESET_TODAY : [4]u8 = [25, 2, 31, 45];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["Day 25", "Day 2", "Day 31, the month burned", "Day 45"];
pub const SAY_ASK : str = "How long do tokens last, and which ones are spent first?";
pub const SAY_TODAY : str = "today, day";
pub const SAY_BATCHES : [3]str = ["the package month", "the start gift", "a top-up"];
pub const SAY_LANDED : str = "landed on day {0}";
pub const SAY_LEFT : str = "{0} days left";
pub const SAY_GONE : str = "burned";
pub const SAY_STRIP : str = "days 0 to 60, one bar a batch";
pub const SAY_ORDER : str = "spent first: the soonest to burn";
pub const SAY_NOTE : str = "The spec warns at 7, 3 and 1 days. Tokens held before the burn existed never burn. Whether bought top-ups should live longer is still the owner's call: one line, TOPUP_DAYS.";
pub const SAY_SOURCE : str = "Logic: t27 spec automation/token-wallet.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test a_month_is_thirty_days {
    assert K_MONTH_DAYS == 30;
    assert K_TODAY_MAX == K_MONTH_DAYS * 2;
}

test the_batches_land_in_the_first_month {
    assert K_BATCH_DAYS[2] < K_MONTH_DAYS;
    assert K_PRESET_TODAY[0] == 25;
}
