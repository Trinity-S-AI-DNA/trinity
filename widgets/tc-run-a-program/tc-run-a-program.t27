// SPDX-License-Identifier: Apache-2.0
; specs/widgets/tc-run-a-program.t27 -- lesson 21 of the course "The ternary machine" (specs/course/ternary-computing.t27)
; Source of truth for public/widgets/tc-run-a-program/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles this
; file, checks its constants, evaluates the tests below and writes the page; the page hands every constant to
; tool.js as window.T27_WIDGET. tool.js draws through ../ternary-kit.js and computes nothing: every number comes
; from public/widgets/tc-run-a-program/logic.js, the fn bodies of the gHashTag/t27 spec in logic.t27, compiled to wasm.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_tc_run_a_program;

pub const KIND : str = "widget-tool";
pub const ID : str = "tc-run-a-program";
pub const TITLE : str = "Run a program on a ternary machine";
pub const DESCRIPTION : str = "Two short programs on three 9-trit registers: sum 1..n and multiply by repeated adds. Step a clock at a time and watch the trits change.";
pub const IMAGE_ALT : str = "Run a program card: the program sum 1..n with n = 5, its listing beside three 9-trit registers. After the last clock r0 holds 15 and the three-way branch has halted the loop.";
pub const HOOK : str = "Five instructions, one three-way branch, and a loop that halts itself on zero.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ternary/trits.t27 (t27#8979): every value on the page is its fn bodies, compiled to wasm (logic.js), with 18 tests and 4108 runtime asserts", "N. P. Brusentsov and others, the Setun computer, Moscow State University, 1958: a working balanced-ternary machine"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

pub const SAY_LOADING : str = "Loading";
pub const K_TRITS : u32 = 9;
pub const K_START_N : u32 = 5;
pub const K_MAX_N : u32 = 30;
pub const K_TICK_MS : u16 = 350;
pub const K_MAX_CLOCKS : u16 = 400;
pub const K_PROG_0 : [30]i32 = [0, 0, 0, 0, 0, 0, 1, -1000, 0, 0, 1, 0, 1, 0, 0, 2, 1, 0, 0, 0, 3, 1, 5, 5, 2, 4, 0, 0, 0, 0];
pub const K_PROG_1 : [35]i32 = [0, 0, 0, 0, 0, 0, 1, -1000, 0, 0, 0, 2, 7, 0, 0, 1, 0, 2, 0, 0, 2, 1, 0, 0, 0, 3, 1, 6, 6, 3, 4, 0, 0, 0, 0];
pub const SAY_PICK : str = "Program";
pub const SAY_PROGS : [2]str = ["sum 1..n", "7 x n by adding"];
pub const SAY_PROG_TIPS : [2]str = ["r0 collects n + (n-1) + ... + 1; BR3 loops while r1 is positive.", "r0 adds r2 = 7, n times; BR3 stops the loop at zero."];
pub const SAY_INS : [5]str = ["SET r{0}, {1}", "ADD r{0}, r{1}", "DEC r{0}", "BR3 r{0}: - to {1}, 0 to {2}, + to {3}", "HALT"];
pub const SAY_STEP : str = "Step one clock";
pub const SAY_RUN : str = "Run / pause";
pub const SAY_RESET : str = "Reset";
pub const SAY_HALTED : str = "halted: r0 = {0} after {1} clocks";
pub const SAY_RUNNING : str = "next instruction {0}, {1} clocks so far";
pub const SAY_SOURCE : str = "Logic: t27 spec ternary/trits.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_widget_starts_where_its_card_says {
    assert K_START_N <= K_MAX_N;
}
