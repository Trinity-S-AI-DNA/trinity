// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-silu.t27 -- Swish and SiLU: one knob between a smooth curve and ReLU
; Source of truth for public/widgets/nn-silu/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-silu/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/activation/silu_swish_activation.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 5 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader drags x from -5 to 5 and sets beta from 0.25 to 8. The green curve is
; forward(x, beta), the dotted one forward(x, 1), SiLU, and the dashed one derivative(x, beta).

; WHAT IT DOES NOT CLAIM: the claim that large beta approaches ReLU is what the curves show on this
; window, not a limit taken here.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_silu;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-silu";
pub const TITLE : str = "Swish: one knob between a smooth curve and ReLU";
pub const DESCRIPTION : str = "Drag along x times sigmoid(beta x). At beta 1 it is SiLU, with its dip of -0.28; turn beta up and the curve closes on ReLU, turn it down and it flattens toward x / 2.";
pub const IMAGE_ALT : str = "Swish card at beta 1, x = -1.28: the green curve dips to -0.2785 and then rises along the diagonal, over a dotted violet SiLU reference that matches it; the dashed gold slope crosses zero at the cursor. Tiles read output -0.2785, slope -0.0003, SiLU -0.2785 and the spec batch (-2, 0, 2) as -0.238 0.000 1.762.";
pub const HOOK : str = "SiLU(-1.28) = -0.2785, its lowest point. At beta 8 the dip shrinks to almost nothing and the curve is ReLU with rounded corners.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/activation/silu_swish_activation.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 5 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_X_LO_C : i16 = -500;
pub const K_X_HI_C : i16 = 500;
pub const K_X_STEP_C : u8 = 2;
pub const K_Y_LO_C : i16 = -100;
pub const K_Y_HI_C : i16 = 500;
pub const K_X_TICKS : [5]i8 = [-4, -2, 0, 2, 4];
pub const K_Y_TICKS : [7]i8 = [-1, 0, 1, 2, 3, 4, 5];
pub const K_BETA_LO_C : u8 = 25;
pub const K_BETA_HI_C : u16 = 800;
pub const K_BETA_STEP_C : u8 = 25;
pub const K_FIXTURE_C : [3]i16 = [-200, 0, 200];
pub const K_PRESET_X_C : [4]i16 = [-128, -128, 200, 200];
pub const K_PRESET_BETA_C : [4]u16 = [100, 400, 50, 800];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["SiLU at its dip", "beta 4 at the same x", "beta 0.5 at x = 2", "beta 8 at x = 2"];
pub const SAY_ASK : str = "Is there one knob between a smooth curve and ReLU?";
pub const SAY_X : str = "input x";
pub const SAY_BETA : str = "beta";
pub const SAY_F : str = "x sigmoid(beta x)";
pub const SAY_SILU : str = "SiLU, beta 1";
pub const SAY_DF : str = "slope";
pub const SAY_PLOT_LABEL : str = "Swish of x for the chosen beta, SiLU for reference, and the slope";
pub const SAY_OUT : str = "output";
pub const SAY_GRAD : str = "slope at x";
pub const SAY_SILU_AT : str = "SiLU at x";
pub const SAY_BATCH : str = "spec batch -2 0 2";
pub const SAY_NOTE : str = "Swish multiplies x by a sigmoid gate of itself. beta sets how sharp the gate is: the same unit can be gentle or close to a switch.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/activation/silu_swish_activation.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test beta_one_is_silu {
    assert K_PRESET_BETA_C[0] == 100;
    assert K_BETA_LO_C < K_PRESET_BETA_C[0];
    assert K_PRESET_BETA_C[3] == K_BETA_HI_C;
}

test the_presets_stay_in_range {
    assert K_PRESET_X_C[0] >= K_X_LO_C;
    assert K_PRESET_X_C[3] <= K_X_HI_C;
    assert K_BETA_HI_C % K_BETA_STEP_C == 0;
}
