// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cordic.t27 -- CORDIC rotation mode: sin and cos with shifts and adds
; Source of truth for public/widgets/cordic/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/cordic/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/cordic.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 10 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader sets an angle from -90 to 90 degrees and a number of steps. The vector starts
; at (K(n), 0) and turns by atan(2^-i) one way or the other at each step, driving the angle left to zero;
; every step is drawn in its own colour and listed with its direction and the angle still to go. It ends
; at (cos, sin), within an error the tiles compare against a 50-step reference.

; WHAT IT DOES NOT CLAIM: the steps run in f64; a b-bit datapath adds its own rounding per step.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cordic;

pub const KIND : str = "widget-tool";
pub const ID : str = "cordic";
pub const TITLE : str = "CORDIC: rotate a vector with shifts and adds";
pub const DESCRIPTION : str = "Set an angle and a number of steps and watch the vector turn by ever smaller angles, each one only a shift and an add, until it lands on cos and sin.";
pub const IMAGE_ALT : str = "CORDIC card: 30 degrees in 16 steps. The vector zigzags in coloured micro-rotations of 45, 26.6, 14.0 degrees and smaller onto the target ray and ends at cos 0.866018, sin 0.500013, with K(16) = 0.6072529351.";
pub const HOOK : str = "No multiplier: every step is two shifts and two adds. 16 of them land within 2e-5 of cos and sin of any angle in range.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [4]str = ["gHashTag/t27 specs/fpga/dsp/cordic.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "J. E. Volder, The CORDIC trigonometric computing technique, IRE Trans. Electronic Computers EC-8(3), 1959", "J. S. Walther, A unified algorithm for elementary functions, AFIPS Spring Joint Computer Conference, 1971", "K(n) tends to 0.6072529350088812 (ST DT0087, the CORDIC design tip); the spec recomputes it"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_MAX_DEG : u8 = 90;
pub const K_MAX_SHOWN_STEPS : u8 = 24;
pub const K_TABLE_ROWS : u8 = 12;
pub const K_X_OUT : u8 = 0;
pub const K_Y_OUT : u8 = 1;
pub const K_Z_OUT : u8 = 2;
pub const K_REF_STEPS : u8 = 50;
pub const K_PRESET_DEG : [4]u8 = [30, 30, 75, 1];
pub const K_PRESET_STEPS : [4]u8 = [16, 4, 12, 24];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["30 degrees, 16 steps", "30 degrees, 4 steps", "75 degrees, 12 steps", "1 degree, 24 steps"];
pub const SAY_ANGLE : str = "Angle";
pub const SAY_STEPS : str = "Steps";
pub const SAY_DEG_VALUE : str = "{0} deg";
pub const SAY_PLANE_LABEL : str = "The unit circle, the target angle and the vector after every CORDIC step";
pub const SAY_STEPS_LABEL : str = "Each step: its direction, its fixed angle and the angle still to go";
pub const SAY_COS : str = "x = cos: {0}";
pub const SAY_SIN : str = "y = sin: {0}";
pub const SAY_LEFT : str = "angle left: {0} deg";
pub const SAY_GAIN : str = "K(n) = {0}";
pub const SAY_TARGET : str = "white ring: the true point";
pub const SAY_COL_I : str = "step i";
pub const SAY_COL_DIR : str = "turns";
pub const SAY_COL_ATAN : str = "atan(2^-i)";
pub const SAY_COL_LEFT : str = "angle left after";
pub const SAY_CCW : str = "counter-clockwise";
pub const SAY_CW : str = "clockwise";
pub const SAY_NOTE : str = "Step i turns by exactly atan(2^-i), so the multiply by tan is a shift by i. Starting at K(n) instead of 1 cancels the stretch every step adds.";
pub const SAY_COS_ERR : str = "cos error";
pub const SAY_SIN_ERR : str = "sin error";
pub const SAY_K : str = "gain K(n)";
pub const SAY_OPS : str = "work";
pub const SAY_OPS_VALUE : str = "{0} x 3 shift-adds";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/cordic.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_angles_converge {
    assert K_MAX_DEG == 90;
    assert K_PRESET_DEG[2] <= K_MAX_DEG;
    assert K_MAX_SHOWN_STEPS < K_REF_STEPS;
}

test the_outputs_are_the_spec_selectors {
    assert K_X_OUT == 0;
    assert K_Y_OUT == 1;
    assert K_Z_OUT == 2;
    assert K_PRESET_STEPS[1] < K_PRESET_STEPS[0];
}
