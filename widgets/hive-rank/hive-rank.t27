// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-rank.t27 -- The queue: which issue the Queen takes first
; Source of truth for public/widgets/hive-rank/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-rank/logic.js -- the fn
; bodies of gHashTag/t27 specs/queen/priority.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 5 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  seven issues with fixed ages and blockers, in listing order; the reader taps a
; level for each. The host counts the criticals listed before each one and then calls capped_level,
; effective_level, eligible and why; the order is a sort whose only comparison is outranks.

; WHAT IT DOES NOT CLAIM:  the seven issues are fixtures of this page, not the live queue.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_rank;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-rank";
pub const TITLE : str = "The queue: which issue the Queen takes first";
pub const DESCRIPTION : str = "Seven open issues in GitHub order. Tap one to change its label: the cap, aging, blockers and outranks reorder the queue, and each issue says why it sits there.";
pub const IMAGE_ALT : str = "Queue card: seven issues ranked. Three criticals lead, the fourth critical is capped to high, an unlabelled normal comes next, a low issue aged to normal follows it, and one high issue with an open blocker is skipped. Each row carries a why pill: label, capped, listing, aged, blocked.";
pub const HOOK : str = "Labels can inflate: at most 3 criticals run as critical, the fourth runs as high. An issue with an open blocker is skipped, not waited on.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/queen/priority.t27 (t27 master c42f8fb40): every value on the page is capped_level, effective_level, eligible, outranks and why, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 5 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_ISSUES : u8 = 7;
pub const K_CRITICAL_CAP : u32 = 3;
pub const K_LEVEL_CRITICAL : u8 = 0;
pub const K_LEVEL_NORMAL : u8 = 2;
pub const K_LEVEL_LOW : u8 = 3;
; The tap state past the lowest level: the issue carries no priority label (SAY_LEVEL_NAMES[4]).
pub const K_NO_LABEL : u8 = 4;
pub const K_AGES : [7]u8 = [1, 3, 6, 8, 20, 30, 2];
pub const K_BLOCKERS : [7]u8 = [0, 0, 0, 0, 0, 0, 1];
pub const K_NUMBERS : [7]u16 = [712, 706, 699, 690, 681, 664, 710];
pub const K_PRESET_L0 : [3]u8 = [0, 1, 0];
pub const K_PRESET_L1 : [3]u8 = [0, 2, 0];
pub const K_PRESET_L2 : [3]u8 = [0, 4, 0];
pub const K_PRESET_L3 : [3]u8 = [0, 4, 0];
pub const K_PRESET_L4 : [3]u8 = [4, 4, 4];
pub const K_PRESET_L5 : [3]u8 = [3, 3, 3];
pub const K_PRESET_L6 : [3]u8 = [1, 4, 1];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [3]str = ["Four criticals", "Few labels", "Two criticals"];
pub const SAY_ASK : str = "Which open issue does the Queen take first?";
pub const SAY_LEVEL_NAMES : [5]str = ["critical", "high", "normal", "low", "no label"];
pub const SAY_WHY_NAMES : [5]str = ["listing", "label", "aged", "capped", "blocked"];
pub const SAY_ISSUE : str = "#{0} ({1} d open)";
pub const SAY_TAP : str = "Tap an issue to change its label";
pub const SAY_ORDER : str = "The order the Queen takes them";
pub const SAY_SKIPPED : str = "skipped: an open blocker";
pub const SAY_RUNS : str = "runs as {0}";
pub const SAY_FIRST : str = "taken first";
pub const SAY_CAPPED : str = "capped";
pub const SAY_NOTE : str = "Lower level first, then the real level (an aged issue never beats a real one of its level), then GitHub listing order. An unlabelled issue keeps the place it had before labels existed.";
pub const SAY_SOURCE : str = "Logic: t27 spec queen/priority.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test no_label_is_the_state_past_the_lowest_level {
    assert K_NO_LABEL == K_LEVEL_LOW + 1;
    assert K_LEVEL_CRITICAL < K_LEVEL_NORMAL;
}

test seven_issues_in_listing_order {
    assert K_ISSUES == 7;
    assert K_AGES[6] == 2;
    assert K_BLOCKERS[6] == 1;
}

test the_start_has_one_critical_more_than_the_cap {
    assert K_PRESET_L3[0] == 0;
    assert K_CRITICAL_CAP == 3;
    assert K_PRESET_L4[0] == 4;
}
