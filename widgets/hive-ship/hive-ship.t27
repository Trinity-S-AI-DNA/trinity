; specs/widgets/hive-ship.t27 -- The game: where a bee flies and how it leaves
; Source of truth for public/widgets/hive-ship/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-ship/logic.js -- the fn
; bodies of gHashTag/t27 specs/queen/hive.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 8 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader sets queued, working, the cell (placed, pending, none), departing, and
; the milliseconds since it left. The ship is drawn where ship_mode says, at the opacity ship_alpha
; gives in thousandths.

; WHAT IT DOES NOT CLAIM:  it is a flat sketch of the 3D game at app.t27.ai/game, not the game.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_ship;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-ship";
pub const TITLE : str = "The game: where a bee flies and how it leaves";
pub const DESCRIPTION : str = "Set what the bee is doing and where its cell stands: ship_mode puts it at the entrance, the portal, its cell or on the way home, and ship_alpha fades it out.";
pub const IMAGE_ALT : str = "Ship card: a map with the hive entrance on the left, a repository portal in the middle and an issue cell on the right. The bee has left the feed 1200 ms ago: it flies HOME along the path at half opacity, 500 of 1000. Tiles read mode HOME, opacity 500, fade 2400 ms.";
pub const HOOK : str = "Before this spec a bee that left the feed vanished in the frame it left. Now it flies home and fades over 2400 ms, so a finished task has an ending on screen.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/queen/hive.t27 (t27 master c42f8fb40): every value on the page is ship_mode and ship_alpha, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 8 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_MS_MAX : u16 = 3000;
pub const K_MS_STEP : u8 = 100;
pub const K_DEPART_MS : u32 = 2400;
pub const K_PRESET_QUEUED : [5]u8 = [0, 0, 0, 1, 0];
pub const K_PRESET_WORKING : [5]u8 = [1, 1, 0, 0, 1];
pub const K_PRESET_CELL : [5]u8 = [0, 0, 0, 0, 1];
pub const K_PRESET_DEPARTING : [5]u8 = [1, 0, 0, 0, 0];
pub const K_PRESET_MS : [5]u16 = [1200, 0, 0, 0, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [5]str = ["Task over, flying home", "Working on its cell", "Silent too long", "Not claimed yet", "Cell not placed"];
pub const SAY_ASK : str = "Where does a bee fly in the game, and what happens when its task ends?";
pub const SAY_QUEUED : str = "not claimed yet";
pub const SAY_WORKING : str = "heard from lately";
pub const SAY_CELL : str = "its issue cell";
pub const SAY_CELL_NAMES : [3]str = ["placed", "pending", "none"];
pub const SAY_DEPARTING : str = "left the feed";
pub const SAY_MS : str = "ms since it left";
pub const SAY_MODE_SHORT : [5]str = ["PARK", "ORBIT", "HOVER", "PORTAL", "HOME"];
pub const SAY_MODE_NAMES : [5]str = ["PARK at the entrance", "ORBIT its cell", "HOVER at the rim", "PORTAL of its repository", "HOME, fading"];
pub const SAY_PLACES : [3]str = ["entrance", "portal", "issue cell"];
pub const SAY_MAP : str = "the map: entrance, portal, cell";
pub const SAY_MODE : str = "mode";
pub const SAY_ALPHA : str = "opacity of 1000";
pub const SAY_FADE : str = "fade, ms";
pub const SAY_NOTE : str = "A quiet bee hovers instead of orbiting: one that has not spoken for minutes is not drawn as busy. A bee whose cell is not on the map yet waits at its repository portal, so where it is going is already true.";
pub const SAY_SOURCE : str = "Logic: t27 spec queen/hive.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_slider_covers_the_fade {
    assert K_MS_MAX > K_DEPART_MS;
    assert K_DEPART_MS == 2400;
}

test the_start_is_halfway_home {
    assert K_PRESET_DEPARTING[0] == 1;
    assert K_PRESET_MS[0] * 2 == K_DEPART_MS;
}
