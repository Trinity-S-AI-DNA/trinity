// SPDX-License-Identifier: Apache-2.0
; specs/widgets/tc-consensus-any.t27 -- lesson 5 of the course "The ternary machine" (specs/course/ternary-computing.t27)
; Source of truth for public/widgets/tc-consensus-any/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles this
; file, checks its constants, evaluates the tests below and writes the page; the page hands every constant to
; tool.js as window.T27_WIDGET. tool.js draws through ../ternary-kit.js and computes nothing: every number comes
; from public/widgets/tc-consensus-any/logic.js, the fn bodies of the gHashTag/t27 spec in logic.t27, compiled to wasm.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_tc_consensus_any;

pub const KIND : str = "widget-tool";
pub const ID : str = "tc-consensus-any";
pub const TITLE : str = "Consensus and any: gates binary logic does not have";
pub const DESCRIPTION : str = "Consensus keeps a value both inputs agree on; any keeps the decided input when the other is unknown. Neither exists with two values.";
pub const IMAGE_ALT : str = "Consensus and any card: the CONSENSUS table, +1 only where both inputs are +1, -1 only where both are -1, unknown everywhere else; ANY takes the decided input when the other one is 0.";
pub const HOOK : str = "Two gates with no binary twin: agree-or-unknown, and take-whatever-is-known.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ternary/trits.t27 (t27#8979): every value on the page is its fn bodies, compiled to wasm (logic.js), with 18 tests and 4108 runtime asserts", "S. C. Kleene, Introduction to Metamathematics, 1952, section 64: the strong three-valued logic"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

pub const SAY_LOADING : str = "Loading";
pub const K_GATES : [2]u32 = [3, 4];
pub const K_GATE_NOT : u32 = 0;
pub const SAY_PICK : str = "Gate";
pub const SAY_GATES : [2]str = ["CONSENSUS", "ANY"];
pub const SAY_OUT : str = "out";
pub const SAY_GATE_TIPS : [2]str = ["CONSENSUS: the value both inputs agree on, otherwise unknown.", "ANY: the decided input if the other is unknown; unknown if they contradict."];
pub const SAY_SOURCE : str = "Logic: t27 spec ternary/trits.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_widget_starts_where_its_card_says {
    assert K_GATES[0] == 3;
    assert K_GATES[1] == 4;
}
