// SPDX-License-Identifier: Apache-2.0
; specs/widgets/basics-constants.t27 -- the infographic of lesson 4 of the t27 basics course (specs/course/t27-basics.t27)
; Source of truth for public/widgets/basics-constants/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/basics/04_constants.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_basics_constants;

pub const KIND : str = "widget-tool";
pub const ID : str = "basics-constants";
pub const TITLE : str = "t27 basics 4: a constant, piece by piece";
pub const DESCRIPTION : str = "The six pieces of a t27 constant declaration in one table. Lesson 4 of the t27 basics course.";
pub const IMAGE_ALT : str = "A black and white table that splits pub const WIDTH : u8 = 8; into six pieces: pub, const, the name, the type, the value and the semicolon, with what each piece does.";
pub const HOOK : str = "pub const WIDTH : u8 = 8; has six pieces. Each one does one job.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/basics/04_constants.t27, compiled clean on 7 backends by public/t27/t27_compiler.wasm, whose tests pass in the site test runner", "Compiler verdicts, error lines, code and counts quoted on this page are what the same wasm answered in node 22 when the course was authored; words without a run behind them are said to be read, not run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "pub const WIDTH : u8 = 8;";
pub const SAY_TABLE_HEAD : [2]str = ["Piece", "What it does"];
pub const SAY_TABLE_CELLS : [12]str = ["pub", "Other modules may read the name", "const", "The value never changes", "WIDTH", "The name", ": u8", "The type: an unsigned 8-bit number", "= 8", "The value", ";", "Ends the declaration"];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 6;
pub const K_TABLE_CELLS : u16 = 12;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_NOTE : str = "The lesson spec tests WIDTH * HEIGHT == AREA with the values 8, 4 and 32.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}
