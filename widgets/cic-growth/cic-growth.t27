// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cic-growth.t27 -- the CIC filter: a decimator with no multipliers, and the bits it grows
; Source of truth for public/widgets/cic-growth/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/cic-growth/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 20 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader sets the number of stages N, the rate change R, the differential delay M and
; the input width. The response is drawn in units of the output rate, nulls at every multiple, with the
; droop at a quarter of the output rate marked; below, every integrator and comb register at the width
; Hogenauer gives them: the input bits plus ceil(N log2(R M)).

; WHAT IT DOES NOT CLAIM: no pruning of the low bits (Hogenauer's register-width reduction) and no compensation filter.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cic_growth;

pub const KIND : str = "widget-tool";
pub const ID : str = "cic-growth";
pub const TITLE : str = "The CIC filter: no multipliers, many bits";
pub const DESCRIPTION : str = "Set stages, rate change, delay and input width. See the sinc-shaped response with its nulls, and how many bits every register has to grow.";
pub const IMAGE_ALT : str = "CIC card: N = 4, R = 8, M = 1, 16-bit input. The DC gain is 4096, so every register grows 12 bits to 28; the response has nulls at every multiple of the output rate and droops 3.6 dB at a quarter of it.";
pub const HOOK : str = "A 4-stage CIC decimating by 8 has a gain of 4096: every register needs 12 more bits than its input. No multiplier anywhere.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "E. B. Hogenauer, An economical class of digital filters for decimation and interpolation, IEEE Trans. ASSP 29(2), 1981"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_MAX_STAGES : u8 = 8;
pub const K_R_CHOICES : [10]u16 = [2, 4, 8, 16, 32, 64, 128, 256, 1024, 4096];
pub const K_MAX_M : u8 = 2;
pub const K_MIN_BIN : u8 = 4;
pub const K_MAX_BIN : u8 = 32;
pub const K_DB_SHOWN : u8 = 120;
pub const K_OUT_RATES_SHOWN : u8 = 4;
pub const K_PASS_PCT : u8 = 25;
pub const K_PRESET_N : [4]u8 = [4, 1, 5, 8];
pub const K_PRESET_R : [4]u8 = [2, 2, 5, 9];
pub const K_PRESET_M : [4]u8 = [1, 1, 2, 2];
pub const K_PRESET_BIN : [4]u8 = [16, 16, 14, 16];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["N 4, R 8: 12 bits", "one stage: a moving sum", "N 5, R 64, M 2", "N 8, R 4096, M 2: 104 bits"];
pub const SAY_N : str = "Stages N";
pub const SAY_R : str = "Rate change R";
pub const SAY_M : str = "Differential delay M";
pub const SAY_BIN : str = "Input bits";
pub const SAY_RESP_LABEL : str = "The CIC response in units of the output rate, with the passband shaded";
pub const SAY_REGS_LABEL : str = "Every integrator and comb register: input bits and growth";
pub const SAY_F_AXIS : str = "frequency, in multiples of the output rate";
pub const SAY_DB : str = "dB";
pub const SAY_DB_VALUE : str = "{0} dB";
pub const SAY_DROOP_AT : str = "droop {0} dB";
pub const SAY_NOTE : str = "Integrators run at the input rate and wrap freely; combs run at the output rate. Two's complement wrap makes the sum come out right as long as every register is wide enough.";
pub const SAY_INTEG : str = "integrator {0}";
pub const SAY_COMB : str = "comb {0}";
pub const SAY_OUTPUT : str = "output";
pub const SAY_BITS_N : str = "{0} bits";
pub const SAY_SPLIT : str = "blue: {0} input bits, orange: {1} bits of growth";
pub const SAY_GAIN : str = "DC gain (RM)^N";
pub const SAY_GROWTH : str = "bit growth";
pub const SAY_BOUT : str = "register width";
pub const SAY_DROOP : str = "droop at 1/4 output rate";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/signals.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_first_preset_is_hogenauers_example_shape {
    assert K_R_CHOICES[2] == 8;
    assert K_PRESET_R[0] == 2;
    assert K_PRESET_N[0] == 4;
    assert K_PRESET_BIN[0] == 16;
}

test the_choices_stay_in_the_spec_range {
    assert K_R_CHOICES[9] == 4096;
    assert K_MAX_STAGES == 8;
    assert K_MAX_M == 2;
    assert K_PASS_PCT < 50;
}
