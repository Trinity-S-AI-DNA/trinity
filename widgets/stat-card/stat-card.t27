// SPDX-License-Identifier: Apache-2.0
; specs/widgets/stat-card.t27 -- a tweetable card and a README badge from yosys `stat -json`
; Source of truth for public/widgets/stat-card/ (gHashTag/trinity, apps/website). The page is
; written by scripts/widget-pages-from-spec.mjs from this file; tool.js holds no English of its
; own and reads every word below from window.T27_WIDGET.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader pastes the JSON that yosys `stat -json` printed, or drops the file
; `tee -o stat.json stat -json` wrote. The page reads it in the browser with
; public/widgets/stat-card/statparse.js, sorts every cell type into LUT, FF, DSP or BRAM by the
; four K_*_TYPES lists below, lists every other type under "other" with its count, and draws a
; 1200x630 card (top module, the four counts, the other types, the yosys version from "creator")
; and a small shields-like README badge as plain SVG text, to copy or download. The file never
; leaves the page; nothing is sent.

; THE SAMPLE: one real run of Yosys 0.67+post (git sha1 b8e7da6f) on this machine, made by
; scripts/widget-data/stat-card.mjs: fpga/openxc7-synth/lm_head_matvec.v with its weight file
; fpga/weights/lm_head_weights.mem (both in gHashTag/trinity), `synth_xilinx -flatten -top
; lm_head_matvec`, then `tee -q -o stat.json stat -json`. The output is shipped byte for byte as
; public/widgets/stat-card/sample.stat.json; the command, the version line and the sha256 of both
; inputs are in sample.json. Every K_SAMPLE_ fact below is re-read from that file by
; `node scripts/widget-data/stat-card.mjs --check`, which also runs this spec's tests on the
; values it read and a negative control that must fail them.

; THE TWO SHAPES: yosys 0.67 prints the per-type map as "num_cells_by_type"; older releases
; print it as "cells". Both are read the same way. Only 0.67+post was run here; the "cells"
; shape is read by the same code but was not checked against a real older yosys.

; WHAT IT DOES NOT CLAIM: a yosys stat count is a synthesis count, not post-place-and-route
; utilisation. A placer can pack, duplicate or remove cells: INV, for one, is its own cell here
; and is listed under other. The card and the badge both say "yosys synth" for that reason. The
; lists are 7-series cell names (synth_xilinx -family xc7, the default); cells of other families
; or of a generic `synth` read as other. DSP 0 on the sample is what yosys reported for this
; design: its ternary weights are added or subtracted, never multiplied.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_stat_card;

pub const KIND : str = "widget-tool";
pub const ID : str = "stat-card";
pub const TITLE : str = "Stat card: your yosys stat -json as a card and a README badge";
pub const DESCRIPTION : str = "Paste yosys stat -json: LUT, FF, DSP and BRAM counts, the top module and the yosys version on a 1200x630 card plus a README badge SVG. Read in your browser.";
pub const IMAGE_ALT : str = "A stat card on black for a real yosys 0.67 synth_xilinx run of lm_head_matvec, a ternary matrix-vector unit: 138 LUT, 149 FF, 0 DSP and 4 BRAM (RAMB36E1), with 139 other cells listed by type (OBUF 51, CARRY4 32, INV 28, IBUF 23, MUXF7 3, BUFG 1, MUXF8 1), marked yosys synth, not place and route.";
pub const HOOK : str = "Paste your yosys stat -json, get a card to post and a badge for your README: LUT, FF, DSP, BRAM, marked as a synth count.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [5]str = ["Yosys 0.67+post (git sha1 b8e7da6f40ae8f552c116bf6c359b07c6533e159), run once by scripts/widget-data/stat-card.mjs: nice -n 10 yosys -q -p \"read_verilog fpga/openxc7-synth/lm_head_matvec.v; synth_xilinx -flatten -top lm_head_matvec; tee -q -o stat.json stat -json\"", "gHashTag/trinity fpga/openxc7-synth/lm_head_matvec.v (sha256 749f9a8ba8fee582...) and fpga/weights/lm_head_weights.mem (sha256 03402649d7959c99...), copied to a scratch directory with the same relative paths", "public/widgets/stat-card/sample.stat.json: the yosys output, byte for byte; sample.json: command, yosys -V line, exit code, seconds and both input sha256", "public/widgets/stat-card/statparse.js: the one parser and badge writer, run in node for the sample and in the browser for your file; card.png is drawn from sample.json by scripts/widget-data/stat-card-card.py", "node scripts/widget-data/stat-card.mjs --check: re-reads sample.stat.json and fails if any K_SAMPLE_ fact in this spec disagrees"];
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- Which cell type is which (7-series names, as synth_xilinx writes them) ---------------------
pub const K_LUT_TYPES : [6]str = ["LUT1", "LUT2", "LUT3", "LUT4", "LUT5", "LUT6"];
pub const K_FF_TYPES : [4]str = ["FDRE", "FDSE", "FDCE", "FDPE"];
pub const K_DSP_TYPES : [1]str = ["DSP48E1"];
pub const K_BRAM_TYPES : [2]str = ["RAMB18E1", "RAMB36E1"];
; yosys bookkeeping that is no hardware: shown on its own line, counted in no group.
pub const K_INTERNAL_TYPES : [1]str = ["$scopeinfo"];

; --- The sample (scripts/widget-data/stat-card.mjs re-reads every K_SAMPLE_ fact) ---------------
pub const K_SAMPLE_JSON : str = "sample.json";
pub const K_SAMPLE_STAT : str = "sample.stat.json";
pub const K_SAMPLE_DESIGN : str = "fpga/openxc7-synth/lm_head_matvec.v";
pub const K_SAMPLE_MEM : str = "fpga/weights/lm_head_weights.mem";
pub const K_SAMPLE_TOP : str = "lm_head_matvec";
pub const K_SAMPLE_YOSYS : str = "0.67+post";
; Every cell type of the sample, in the order yosys printed them, and its count.
pub const K_SAMPLE_TYPES : [14]str = ["BUFG", "CARRY4", "FDRE", "IBUF", "INV", "LUT2", "LUT3", "LUT4", "LUT5", "LUT6", "MUXF7", "MUXF8", "OBUF", "RAMB36E1"];
pub const K_SAMPLE_COUNTS : [14]u16 = [1, 32, 149, 23, 28, 69, 3, 4, 50, 12, 3, 1, 51, 4];
pub const K_SAMPLE_LUT : u16 = 138;
pub const K_SAMPLE_FF : u16 = 149;
pub const K_SAMPLE_DSP : u16 = 0;
pub const K_SAMPLE_BRAM : u16 = 4;
pub const K_SAMPLE_OTHER : u16 = 139;
pub const K_SAMPLE_CELLS : u16 = 430;

; --- How it draws -------------------------------------------------------------------------------
pub const K_CARD_W : u16 = 1200;
pub const K_CARD_H : u16 = 630;
pub const K_MIN_TARGET_PX : u8 = 32;
; A pasted text over this many characters is not read.
pub const K_MAX_PASTE_CHARS : u32 = 4000000;
; Other types named on the card before the rest are folded into one "+N more".
pub const K_CARD_OTHER_MAX : u8 = 9;
; The badge: height, font size, the width given to each character, padding, two fills.
pub const K_BADGE_H : u8 = 20;
pub const K_BADGE_FONT_PX : u8 = 11;
pub const K_BADGE_CHAR_W : u8 = 7;
pub const K_BADGE_PAD : u8 = 6;
pub const K_BADGE_LABEL_FILL : str = "#555";
pub const K_BADGE_VALUE_FILL : str = "#2e7d4f";

; --- Every word on the screen -------------------------------------------------------------------
; Templates take {0}, {1}, ... in order.
pub const SAY_SAMPLE_LABEL : str = "Real sample";
pub const SAY_SAMPLE_NAME : str = "lm_head_matvec (yosys 0.67)";
pub const SAY_SAMPLE_LINE : str = "A ternary matrix-vector unit from gHashTag/trinity, fpga/openxc7-synth/lm_head_matvec.v, synthesised on our machine with synth_xilinx -flatten. Its weights sit in block RAM and are added or subtracted, so yosys used no DSP.";
pub const SAY_OPEN_SAMPLE : str = "Open the yosys output";
pub const SAY_OWN_LABEL : str = "Your stat -json";
pub const SAY_HOW : str = "In yosys, after synthesis: tee -q -o stat.json stat -json";
pub const SAY_DROP : str = "Drop stat.json here, or pick a file";
pub const SAY_PASTE_HINT : str = "...or paste what stat -json printed";
pub const SAY_PASTE_LABEL : str = "yosys stat -json text";
pub const SAY_READ : str = "Make the card";
pub const SAY_CLEAR : str = "Clear";
pub const SAY_PICKED : str = "{0}: {1} bytes";
pub const SAY_PASTED : str = "pasted text";
pub const SAY_LOCAL_NOTE : str = "Read in this tab; nothing is sent.";
pub const SAY_TOO_BIG : str = "{0} characters is more than this page reads ({1}).";
pub const SAY_ERR_READ : str = "Could not read {0}.";
pub const SAY_ERR_LOAD : str = "The sample did not load.";
; One per parse error code of statparse.js, in this order.
pub const SAY_ERROR_IDS : [5]str = ["empty", "nojson", "badjson", "nomodules", "nocells"];
pub const SAY_ERROR_TEXT : [5]str = ["Nothing to read yet.", "No JSON object in this text. Run stat with -json.", "The JSON does not parse. Paste all of it, from the first { to the last }.", "This JSON has no \"modules\": it is not yosys stat -json output.", "No per-type cell map (num_cells_by_type or cells) in this stat."];

; The four groups, in card order, and the words around them.
pub const SAY_GROUP_IDS : [4]str = ["lut", "ff", "dsp", "bram"];
pub const SAY_GROUP_NAMES : [4]str = ["LUT", "FF", "DSP", "BRAM"];
pub const SAY_GROUP_RULES : [4]str = ["LUT1 to LUT6", "FDRE, FDSE, FDCE, FDPE", "DSP48E1", "RAMB18E1, RAMB36E1"];
pub const SAY_OTHER : str = "other";
pub const SAY_OTHER_LINE : str = "Every other cell type, by count: none are dropped.";
pub const SAY_OTHER_NONE : str = "none";
pub const SAY_OTHER_MORE : str = "+{0} more";
pub const SAY_INTERNAL : str = "yosys bookkeeping, no hardware: {0}";
pub const SAY_HIER : str = "submodule instances, their cells counted above: {0}";
pub const SAY_NO_XILINX : str = "No 7-series LUT, FF, DSP or BRAM cell in this stat. Was it synth_xilinx? Generic synth cells read as other.";
pub const SAY_TOP : str = "top module";
pub const SAY_NO_TOP : str = "top module not named";
pub const SAY_VERSION : str = "yosys {0}";
pub const SAY_NO_VERSION : str = "yosys version not in this JSON";
pub const SAY_CELLS : str = "{0} cells";
pub const SAY_SHAPE : str = "Read from \"{0}\" ({1}), {2} module(s).";
pub const SAY_FROM : [2]str = ["the design totals", "the top module, submodules expanded"];
pub const SAY_TABLE_HEAD : [3]str = ["cell type", "count", "counted as"];

; The card and the badge.
pub const SAY_CARD_BRAND : str = "TRINITY S3AI  /  STAT CARD";
pub const SAY_CARD_KIND : str = "yosys synth, not place and route";
pub const SAY_CARD_URL : str = "t27.ai/widgets/stat-card";
pub const SAY_PREVIEW_ALT : str = "The card for this stat: top module, LUT, FF, DSP and BRAM counts, other cells and the yosys version.";
pub const SAY_PNG_BUTTON : str = "Save card PNG";
pub const SAY_PNG_FILE : str = "stat-card-{0}.png";
pub const SAY_BADGE_LABEL : str = "yosys synth";
pub const SAY_BADGE_VALUE : str = "{0} LUT | {1} FF | {2} DSP | {3} BRAM";
pub const SAY_BADGE_TITLE : str = "{0} -- top {1}, yosys {2}: synthesis cell counts, not place and route";
pub const SAY_BADGE_HEAD : str = "README badge";
pub const SAY_BADGE_NOTE : str = "Plain SVG, no fonts or links in it. Save it next to your README and point an image at it.";
pub const SAY_BADGE_COPY : str = "Copy SVG";
pub const SAY_BADGE_COPIED : str = "Copied";
pub const SAY_BADGE_SAVE : str = "Download SVG";
pub const SAY_BADGE_FILE : str = "yosys-synth-{0}.svg";
pub const SAY_BADGE_TEXT_LABEL : str = "Badge SVG text";
pub const SAY_HONEST : str = "These are yosys stat counts after synthesis, before place and route: a placer packs, duplicates and removes cells, so a P&R utilisation report can differ. The groups are 7-series cell names; every other type is listed under other.";

; --- Tests --------------------------------------------------------------------------------------
test the_four_lists_name_7_series_cells {
    assert K_LUT_TYPES[0] == "LUT1";
    assert K_LUT_TYPES[5] == "LUT6";
    assert K_FF_TYPES[0] == "FDRE";
    assert K_FF_TYPES[3] == "FDPE";
    assert K_DSP_TYPES[0] == "DSP48E1";
    assert K_BRAM_TYPES[0] == "RAMB18E1";
    assert K_BRAM_TYPES[1] == "RAMB36E1";
}

test the_sample_luts_are_its_lut2_to_lut6_cells {
    assert K_SAMPLE_TYPES[5] == "LUT2";
    assert K_SAMPLE_TYPES[6] == "LUT3";
    assert K_SAMPLE_TYPES[7] == "LUT4";
    assert K_SAMPLE_TYPES[8] == "LUT5";
    assert K_SAMPLE_TYPES[9] == "LUT6";
    assert K_SAMPLE_LUT == K_SAMPLE_COUNTS[5] + K_SAMPLE_COUNTS[6] + K_SAMPLE_COUNTS[7] + K_SAMPLE_COUNTS[8] + K_SAMPLE_COUNTS[9];
    assert K_SAMPLE_LUT == 138;
}

test the_sample_ffs_dsps_and_brams_come_from_their_lists {
    assert K_SAMPLE_TYPES[2] == "FDRE";
    assert K_SAMPLE_FF == K_SAMPLE_COUNTS[2];
    assert K_SAMPLE_TYPES[13] == K_BRAM_TYPES[1];
    assert K_SAMPLE_BRAM == K_SAMPLE_COUNTS[13];
    assert K_SAMPLE_BRAM == 4;
    assert K_SAMPLE_DSP == 0;
}

test every_other_sample_cell_is_counted_not_dropped {
    assert K_SAMPLE_TYPES[4] == "INV";
    assert K_SAMPLE_OTHER == K_SAMPLE_COUNTS[0] + K_SAMPLE_COUNTS[1] + K_SAMPLE_COUNTS[3] + K_SAMPLE_COUNTS[4] + K_SAMPLE_COUNTS[10] + K_SAMPLE_COUNTS[11] + K_SAMPLE_COUNTS[12];
    assert K_SAMPLE_CELLS == K_SAMPLE_LUT + K_SAMPLE_FF + K_SAMPLE_DSP + K_SAMPLE_BRAM + K_SAMPLE_OTHER;
    assert K_SAMPLE_CELLS == K_SAMPLE_COUNTS[0] + K_SAMPLE_COUNTS[1] + K_SAMPLE_COUNTS[2] + K_SAMPLE_COUNTS[3] + K_SAMPLE_COUNTS[4] + K_SAMPLE_COUNTS[5] + K_SAMPLE_COUNTS[6] + K_SAMPLE_COUNTS[7] + K_SAMPLE_COUNTS[8] + K_SAMPLE_COUNTS[9] + K_SAMPLE_COUNTS[10] + K_SAMPLE_COUNTS[11] + K_SAMPLE_COUNTS[12] + K_SAMPLE_COUNTS[13];
}

test the_card_and_badge_say_it_is_a_synth_count {
    assert SAY_BADGE_LABEL == "yosys synth";
    assert SAY_CARD_KIND == "yosys synth, not place and route";
    assert K_CARD_W == 1200;
    assert K_CARD_H == 630;
}

test the_page_reads_files_and_sends_nothing {
    assert READS_LOCAL_FILES == true;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
}
