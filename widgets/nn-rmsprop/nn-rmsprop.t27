// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-rmsprop.t27 -- RMSProp: a step that ignores the size of the gradient
; Source of truth for public/widgets/nn-rmsprop/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-rmsprop/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/optimizer/rmsprop.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 17 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader picks a gradient, a decay from 0.5 to 0.99 and a number of steps. Every
; point is param_after(g, n, decay) from 1.0 with lr 0.01, the cache cache_after(g, n) at the spec's
; decay 0.9.

; WHAT IT DOES NOT CLAIM: a constant gradient on one weight; with a changing gradient the cache lags
; behind it.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_rmsprop;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-rmsprop";
pub const TITLE : str = "RMSProp: a step that does not care how big the gradient is";
pub const DESCRIPTION : str = "Feed one weight a constant gradient of 0.001, 0.5 or 1000: RMSProp divides by the root of its running mean square, so all three walk the same path. Change the decay and the path bends.";
pub const IMAGE_ALT : str = "RMSProp card: gradient 0.5, decay 0.9, 100 steps. Three lines, green for 0.5 and dashed gold and pink for 0.001 and 1000, lie exactly on top of each other, falling from 1 to about -0.09. Tiles read the weight -0.09142, the three runs -0.0914 -0.0914 -0.0914, one step 0.96838 and the cache 0.249993.";
pub const HOOK : str = "Its first step is 0.0316 whether the gradient is 0.001 or 1000. Dividing by the gradient's own size is what makes the step scale-free.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/optimizer/rmsprop.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 17 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_STEPS_HI : u8 = 100;
pub const K_GRADS_M : [3]u32 = [1, 500, 1000000];
pub const K_DECAY_LO_C : u8 = 50;
pub const K_DECAY_HI_C : u8 = 99;
pub const K_Y_LO_C : i16 = -110;
pub const K_Y_HI_C : u8 = 110;
pub const K_Y_TICKS_C : [5]i8 = [-100, -50, 0, 50, 100];
pub const K_STEP_TICKS : [5]u8 = [0, 25, 50, 75, 100];
pub const K_PRESET_G : [4]u8 = [1, 0, 2, 1];
pub const K_PRESET_DECAY_C : [4]u8 = [90, 90, 90, 99];
pub const K_PRESET_STEPS : [4]u8 = [100, 100, 100, 100];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["g = 0.5", "g = 0.001", "g = 1000", "g = 0.5, decay 0.99"];
pub const SAY_ASK : str = "Can a step ignore how big the gradient is?";
pub const SAY_GRAD : str = "gradient";
pub const SAY_GRAD_NAMES : [3]str = ["g = 0.001", "g = 0.5", "g = 1000"];
pub const SAY_DECAY : str = "decay";
pub const SAY_STEPS : str = "steps";
pub const SAY_PLOT_LABEL : str = "The weight after every step for three gradient sizes";
pub const SAY_W_NOW : str = "weight now";
pub const SAY_W_OTHERS : str = "all three gradients";
pub const SAY_ONE_STEP : str = "after step 1";
pub const SAY_CACHE : str = "cache, decay 0.9";
pub const SAY_NOTE : str = "The cache is a running mean of g squared, so g / sqrt(cache) has no units: a layer whose gradients are tiny moves as fast as one whose gradients are huge.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/optimizer/rmsprop.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_gradients_span_six_decades {
    assert K_GRADS_M[0] == 1;
    assert K_GRADS_M[2] == 1000000;
    assert K_GRADS_M[1] == 500;
}

test the_presets_stay_in_range {
    assert K_PRESET_G[2] < 3;
    assert K_PRESET_DECAY_C[3] == K_DECAY_HI_C;
    assert K_PRESET_STEPS[0] == K_STEPS_HI;
}
