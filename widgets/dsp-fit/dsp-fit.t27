// SPDX-License-Identifier: Apache-2.0
; specs/widgets/dsp-fit.t27 -- the DSP48E1 slice: tiling a x b onto 25 x 18 multipliers, and the 48-bit accumulator
; Source of truth for public/widgets/dsp-fit/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/dsp-fit/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/multipliers.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 6 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader sets the widths of a and b and how many products a running sum adds up. The
; product rectangle is cut into the pieces one slice multiplies (low pieces one bit short of the port,
; because they are unsigned), and the 48-bit accumulator shows the product bits, the guard bits the sum
; needs and what is left. Tiles give slices, headroom, the most terms it holds and how many such
; multipliers the 740 slices of an XC7A200T take.

; WHAT IT DOES NOT CLAIM: a count model, not a synthesis tool's mapper (which may use LUTs or the pre-adder); timing is not modelled.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_dsp_fit;

pub const KIND : str = "widget-tool";
pub const ID : str = "dsp-fit";
pub const TITLE : str = "The DSP48E1 slice: fit a x b and its running sum";
pub const DESCRIPTION : str = "Set two operand widths and a number of terms. See how many 25 x 18 slices the product takes and whether the 48-bit accumulator has room for the sum.";
pub const IMAGE_ALT : str = "DSP fit card: a 25 x 18 product fills exactly one slice and leaves 5 bits of headroom in the 48-bit accumulator, so 32 terms sum safely and 33 do not.";
pub const HOOK : str = "25 x 18 is one DSP48E1 slice with 5 bits to spare: 32 products sum safely, the 33rd can overflow. 32 x 32 takes four.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/dsp/multipliers.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Xilinx UG479, 7 Series DSP48E1 Slice User Guide: a 25 x 18 two's complement multiplier and a 48-bit accumulator", "Xilinx DS180, 7 Series FPGAs Data Sheet: Overview: 740 DSP48E1 slices on the XC7A200T"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_DSP_A_BITS : u8 = 25;
pub const K_DSP_B_BITS : u8 = 18;
pub const K_DSP_ACC_BITS : u8 = 48;
pub const K_DSP48_ON_200T : u16 = 740;
pub const K_MIN_WIDTH : u8 = 2;
pub const K_MAX_WIDTH : u8 = 64;
pub const K_MAX_TERMS_LOG2 : u8 = 24;
pub const K_PRESET_WA : [4]u8 = [25, 25, 32, 16];
pub const K_PRESET_WB : [4]u8 = [18, 18, 32, 16];
pub const K_PRESET_TERMS_LOG2 : [4]u8 = [5, 6, 0, 16];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["25 x 18, 32 terms: fits", "25 x 18, 64 terms: overflows", "32 x 32: four slices", "16 x 16, 65536 terms"];
pub const SAY_WA : str = "Width of a, bits";
pub const SAY_WB : str = "Width of b, bits";
pub const SAY_TERMS : str = "Terms summed";
pub const SAY_TILES_LABEL : str = "The product cut into the pieces one slice multiplies";
pub const SAY_ACC_LABEL : str = "The 48-bit accumulator: product bits, guard bits and the rest";
pub const SAY_TILE : str = "{0} x {1}";
pub const SAY_A_ON : str = "a: {0} bits on the {1}-bit port";
pub const SAY_B_ON : str = "b: {0} bits on the {1}-bit port";
pub const SAY_LOW_PIECES : str = "low pieces carry one bit less than the port: they are unsigned";
pub const SAY_ACC : str = "{0}-bit accumulator";
pub const SAY_FITS : str = "{0} product bits + {1} guard bits: it fits";
pub const SAY_OVERFLOWS : str = "{0} product bits + {1} guard bits: more than {2}, the sum can overflow";
pub const SAY_SLICES : str = "DSP48E1 slices";
pub const SAY_HEADROOM : str = "headroom";
pub const SAY_BITS_N : str = "{0} bits";
pub const SAY_MAX_TERMS : str = "most terms that fit";
pub const SAY_ON_200T : str = "such multipliers on a 200T";
pub const SAY_NOTE : str = "Cyan: the product. Gold: one guard bit per doubling of the number of terms. Red: past bit 48.";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/multipliers.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test one_slice_is_25_by_18_into_48 {
    assert K_DSP_A_BITS == 25;
    assert K_DSP_B_BITS == 18;
    assert K_DSP_ACC_BITS == 48;
    assert K_DSP_ACC_BITS - K_DSP_A_BITS - K_DSP_B_BITS == 5;
}

test the_presets_sit_on_both_sides_of_the_headroom {
    assert K_PRESET_TERMS_LOG2[0] == 5;
    assert K_PRESET_TERMS_LOG2[1] == 6;
    assert K_PRESET_WA[2] == 32;
    assert K_MAX_TERMS_LOG2 < 32;
}
