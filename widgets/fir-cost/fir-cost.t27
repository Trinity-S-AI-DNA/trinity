// SPDX-License-Identifier: Apache-2.0
; specs/widgets/fir-cost.t27 -- folding taps onto DSP slices: symmetry, the pre-adder and time sharing
; Source of truth for public/widgets/fir-cost/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/fir-cost/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 18 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader sets the number of taps, whether they are symmetric, the clock and the sample
; rate. Each tap is drawn in the colour of the slice that multiplies it, symmetric pairs joined by an arc
; (they share one multiplier through the pre-adder); the slices are drawn below. Tiles: multipliers,
; clocks per sample, slices, and how many such filters the 740 slices of an XC7A200T hold.

; WHAT IT DOES NOT CLAIM: one multiply per slice per clock is assumed; the adder chain and the control are not counted.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_fir_cost;

pub const KIND : str = "widget-tool";
pub const ID : str = "fir-cost";
pub const TITLE : str = "Folding a FIR onto DSP slices";
pub const DESCRIPTION : str = "Set taps, symmetry, clock and sample rate. Symmetric taps share a multiplier; a fast clock lets one slice serve many taps. See how many slices are left.";
pub const IMAGE_ALT : str = "FIR cost card: 31 symmetric taps at 50 MHz on a 200 MHz clock. Pairs of taps share one multiplier, 16 in all, and 4 clocks per sample let each slice serve 4 of them: 4 slices.";
pub const HOOK : str = "31 symmetric taps need 16 multipliers. At 48 kHz on a 200 MHz clock, one DSP48E1 slice runs all of them: 740 such filters fit a 200T.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Xilinx UG479, 7 Series DSP48E1 Slice User Guide: the pre-adder that lets symmetric taps share one multiplier", "Xilinx DS180, 7 Series FPGAs Data Sheet: Overview: 740 DSP48E1 slices on the XC7A200T"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_MIN_TAPS : u8 = 3;
pub const K_TAP_LIMIT : u8 = 127;
pub const K_FCLK_MIN_MHZ : u16 = 50;
pub const K_FCLK_MAX_MHZ : u16 = 500;
pub const K_HZ_PER_MHZ : u32 = 1000000;
pub const K_FS_HZ : [5]u32 = [48000, 1000000, 10000000, 50000000, 100000000];
pub const K_MAX_BOXES : u8 = 64;
pub const K_DSP48_ON_200T : u16 = 740;
pub const K_PRESET_TAPS : [4]u8 = [31, 31, 31, 127];
pub const K_PRESET_SYM : [4]u8 = [1, 0, 1, 1];
pub const K_PRESET_FCLK_MHZ : [4]u16 = [200, 200, 200, 100];
pub const K_PRESET_FS : [4]u8 = [0, 3, 3, 4];
pub const K_START_PRESET : u8 = 2;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["31 taps at 48 kHz: one slice", "31 taps at 50 MHz", "31 symmetric taps at 50 MHz", "127 taps, one clock per sample"];
pub const SAY_TAPS : str = "Taps";
pub const SAY_SYM : str = "Taps symmetric";
pub const SAY_SYMS : [2]str = ["no", "yes: pre-adder"];
pub const SAY_FCLK : str = "Clock, MHz";
pub const SAY_FS : str = "Sample rate";
pub const SAY_FS_NAMES : [5]str = ["48 kHz", "1 MHz", "10 MHz", "50 MHz", "100 MHz"];
pub const SAY_FOLD_LABEL : str = "The taps coloured by the slice that multiplies them, and the slices";
pub const SAY_TAP_ROW : str = "{0} taps";
pub const SAY_DSP_ROW : str = "{0} DSP48E1 slices, {1} clocks per sample each";
pub const SAY_NOTE : str = "A slice clocked C times per sample can multiply C taps one after another. Symmetric taps add their two samples first, in the pre-adder, and multiply once.";
pub const SAY_MULTS : str = "multipliers";
pub const SAY_CPS : str = "clocks per sample";
pub const SAY_DSPS : str = "DSP48E1 slices";
pub const SAY_FIT : str = "such filters on a 200T";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/signals.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_rates_climb {
    assert K_FS_HZ[0] == 48000;
    assert K_FS_HZ[4] == K_HZ_PER_MHZ * 100;
    assert K_FS_HZ[2] < K_FS_HZ[3];
}

test the_presets_compare_symmetry {
    assert K_PRESET_TAPS[1] == K_PRESET_TAPS[2];
    assert K_PRESET_SYM[1] == 0;
    assert K_PRESET_SYM[2] == 1;
    assert K_PRESET_TAPS[3] == K_TAP_LIMIT;
    assert K_DSP48_ON_200T == 740;
}
