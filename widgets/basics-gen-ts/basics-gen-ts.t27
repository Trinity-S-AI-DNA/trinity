// SPDX-License-Identifier: Apache-2.0
; specs/widgets/basics-gen-ts.t27 -- the infographic of lesson 21 of the t27 basics course (specs/course/t27-basics.t27)
; Source of truth for public/widgets/basics-gen-ts/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/basics/21_gen_ts.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_basics_gen_ts;

pub const KIND : str = "widget-tool";
pub const ID : str = "basics-gen-ts";
pub const TITLE : str = "t27 basics 21: what gen-ts writes";
pub const DESCRIPTION : str = "The TypeScript the real t27 compiler wrote for the lesson spec, line by line next to its source. Lesson 21 of the t27 basics course.";
pub const IMAGE_ALT : str = "A black and white table of three t27 declarations and what gen-ts wrote for each: two constants became export const lines, and the function add was not emitted, with the note the backend left.";
pub const HOOK : str = "gen-ts turns t27 constants into TypeScript and leaves function bodies out. The real lines.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/basics/21_gen_ts.t27, compiled clean on 7 backends by public/t27/t27_compiler.wasm, whose tests pass in the site test runner", "Compiler verdicts, error lines, code and counts quoted on this page are what the same wasm answered in node 22 when the course was authored; words without a run behind them are said to be read, not run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "gen-ts on the lesson spec";
pub const SAY_TABLE_HEAD : [2]str = ["t27", "gen-ts wrote"];
pub const SAY_TABLE_CELLS : [6]str = ["pub const WIDTH : u8 = 8;", "export const WIDTH = 8 satisfies number;", "pub const NAME : str = \"basics\";", "export const NAME = \"basics\" satisfies string;", "pub fn add(a: u8, b: u8) -> u8", "// t27c gen-ts: fn add was not emitted -- this backend lowers declarations, not bodies."];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 3;
pub const K_TABLE_CELLS : u16 = 6;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "From spec to page";
pub const SAY_FLOW_STEPS : [4]str = ["A .t27 spec", "t27c gen-ts", "export const lines", "A page imports them"];
pub const K_FLOW_STEPS : u8 = 4;
pub const SAY_NOTE : str = "The right column is what t27_compiler.wasm wrote for the ts backend.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 4;
    assert K_FLOW_STEPS > 1;
}
