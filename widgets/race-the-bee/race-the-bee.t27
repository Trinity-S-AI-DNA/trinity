// SPDX-License-Identifier: Apache-2.0
; specs/widgets/race-the-bee.t27 -- who lands patches on gHashTag/t27: the Queen's bees or a person
; Source of truth for public/widgets/race-the-bee/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English of its own: every
; word on screen is a SAY_ constant here, and the lane rule is K_ constants.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT SHOWS: a dated snapshot, not a live race. scripts/widget-data/race-the-bee.mjs reads
; gHashTag/t27 through the GitHub GraphQL API (read-only GETs) and writes data.json beside the
; page; the page reads only that file. Three views: a scoreboard of the merged pull requests of
; the last seven days that close an issue, split into a bee lane and a human lane, with the median
; hours from the issue being opened to the merge; the issues where both lanes opened a pull
; request, with who opened first and who merged first; and the open issues nobody had taken at
; snapshot time, each a link to GitHub for the reader's own click.

; THE LANE RULE: a pull request is the bee's when its head branch is queen-<N>; those branches are
; written by a bee the Queen dispatched and published by tools/queen/publish.py in gHashTag/t27.
; Every other pull request is the human lane: a person opened the session, and that person may
; have used an AI assistant (claude/ and codex/ branches), so "human" means human-steered, not
; hand-typed. An open issue counts as takeable when it has a "## Boundary" section (the Queen's
; own rule, tools/queen/needs_boundary.py: without one no bee can be dispatched), no open pull
; request closes it, and no queen-<N> branch for it exists on the remote.

; WHAT IT DOES NOT CLAIM: that a race is running. No harness assigns one issue to a person and a
; bee at the same moment; the head-to-head rows are the few issues where both lanes happened to
; open a pull request. It does not claim the lanes do the same work: most bee merges are
; machine-filed "Port ... to specs/port" tasks, which no person took in the window, so the median
; hours compare different workloads. It does not claim an open issue is still free: the Queen may
; dispatch a bee to any of them after the snapshot. It does not rank the people or the bees.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_race_the_bee;

pub const KIND : str = "widget-tool";
pub const ID : str = "race-the-bee";
pub const TITLE : str = "Race the bee: who lands patches on t27, a person or a bee";
pub const DESCRIPTION : str = "A dated snapshot of gHashTag/t27: merged pull requests by the Queen's bees and by people, the issues both lanes went for, and the open ones nobody has taken.";
pub const IMAGE_ALT : str = "Race the bee card, snapshot 2026-10-04 of gHashTag/t27 over seven days: bees merged 152 pull requests (139 of them port tasks), people merged 62; on all 3 issues both lanes tried, the person opened first and the bee merged first.";
pub const HOOK : str = "Three times this week a person and a bee went for the same issue. The person started first every time; the bee merged first every time.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [4]str = ["GitHub GraphQL API, gHashTag/t27: pull requests closed in the window and every open pull request, with the issues each one closes", "GitHub GraphQL API, gHashTag/t27: every open issue and its body, searched for a ## Boundary section", "GitHub REST API, gHashTag/t27 git/matching-refs/heads/queen-: the bee branches on the remote", "scripts/widget-data/race-the-bee.mjs: the snapshot, written to public/widgets/race-the-bee/data.json with its UTC time"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The rule --------------------------------------------------------------------------------
pub const K_REPO : str = "gHashTag/t27";
pub const K_BEE_BRANCH_PREFIX : str = "queen-";
pub const K_WINDOW_DAYS : u8 = 7;
pub const K_OPEN_SHOWN : u8 = 12;
pub const K_DATA_FILE : str = "./data.json";
pub const K_LANES : [2]str = ["bee", "human"];

; --- Words -----------------------------------------------------------------------------------
; {name} is filled from data.json by tool.js; nothing else is.
pub const SAY_SNAPSHOT : str = "Snapshot, not a live race: taken {at} UTC from GitHub, covering the last {days} days of {repo}.";
pub const SAY_LOADING : str = "Reading the snapshot...";
pub const SAY_LOAD_FAILED : str = "The snapshot file could not be read.";
pub const SAY_TABS : [3]str = ["Scoreboard", "Head to head", "Take one"];
pub const SAY_LANE_NAMES : [2]str = ["Bee", "Human"];
pub const SAY_LANE_LINES : [2]str = ["head branch queen-<N>, written by a bee the Queen dispatched", "any other branch: a person steered the session, often with an AI assistant"];
pub const SAY_MERGED : str = "merged PRs that close an issue";
pub const SAY_MEDIAN_ISSUE : str = "median hours, issue opened to merge";
pub const SAY_MEDIAN_PR : str = "median hours, PR opened to merge";
pub const SAY_PORT_TASKS : str = "of them machine-filed port tasks";
pub const SAY_NOT_SAME_WORK : str = "Not the same work: {beePort} of the bees' {beeMerged} merges were machine-filed port tasks, and people took {humanPort} of those. The hours compare different workloads, not speed on one task.";
pub const SAY_RECENT : str = "Latest merges";
pub const SAY_HOURS : str = "h";
pub const SAY_ISSUE : str = "issue";
pub const SAY_PR : str = "PR";
pub const SAY_H2H_INTRO : str = "Issues where both lanes opened a pull request in the window: {n}. Nobody set these up as races; both lanes just went for the same issue.";
pub const SAY_H2H_NONE : str = "No issue in this window had pull requests from both lanes.";
pub const SAY_OPENED_FIRST : str = "opened first";
pub const SAY_MERGED_FIRST : str = "merged first";
pub const SAY_NOBODY_MERGED : str = "nobody merged yet";
pub const SAY_STATES : [3]str = ["merged", "open", "closed"];
pub const SAY_OPENED_AT : str = "opened";
pub const SAY_MERGED_AT : str = "merged";
pub const SAY_TAKE_INTRO : str = "{untouched} of {boundary} open issues with a Boundary had no pull request and no bee branch at snapshot time. A bee may be sent to any of them after it; check the issue before you start.";
pub const SAY_TAKE_COUNTS : str = "Open issues {total}; with a Boundary {boundary}; with no open PR {free}; of those, a bee branch already exists for {branch}.";
pub const SAY_TAKE_LINK : str = "Open on GitHub";
pub const SAY_RULE_TITLE : str = "How a lane is decided";
pub const SAY_RULE : str = "A pull request is the bee's when its head branch is queen-<N>; every other one is the human lane. Data: {repo}, read with gh api at the snapshot time; this page calls nobody.";

; --- Tests -----------------------------------------------------------------------------------
test the_page_sends_nothing_and_reads_no_file {
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == false;
    assert K_DATA_FILE == "./data.json";
}

test two_lanes_and_one_rule {
    assert K_LANES[0] == "bee";
    assert K_LANES[1] == "human";
    assert SAY_LANE_NAMES[0] == "Bee";
    assert K_BEE_BRANCH_PREFIX == "queen-";
    assert K_REPO == "gHashTag/t27";
}

test the_window_is_a_week_and_the_list_is_short {
    assert K_WINDOW_DAYS == 7;
    assert K_OPEN_SHOWN > 0;
    assert K_OPEN_SHOWN <= 20;
}

test it_is_a_game_widget {
    assert KIND == "widget-tool";
    assert CATEGORY == "game";
    assert ID == "race-the-bee";
}
