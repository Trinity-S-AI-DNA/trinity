// SPDX-License-Identifier: Apache-2.0
; specs/widgets/fir-design.t27 -- designing taps: a windowed-sinc low-pass, integer taps and the stopband they keep
; Source of truth for public/widgets/fir-design/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/fir-design/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 17 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader sets the number of taps, the cutoff, the window, the coefficient width and
; where the stopband starts. The integer taps are drawn as stems; the response is drawn with float taps
; (dashed) and with the integer taps (solid), and the highest level left in the stopband is marked.

; WHAT IT DOES NOT CLAIM: odd-length linear-phase low-pass filters only; no optimal (Parks-McClellan) design.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_fir_design;

pub const KIND : str = "widget-tool";
pub const ID : str = "fir-design";
pub const TITLE : str = "Designing FIR taps: a window, a cutoff, and the bits you keep";
pub const DESCRIPTION : str = "Set taps, cutoff, window and coefficient bits. Watch the integer taps and the response: a better window deepens the stopband, too few bits fill it back in.";
pub const IMAGE_ALT : str = "FIR design card: 31 taps, cutoff 0.1, Hamming window, 16-bit taps. The stems peak at 6542 in the middle; the stopband from 0.2 sits at -62.5 dB, against -32.8 dB with 8-bit taps.";
pub const HOOK : str = "31 Hamming taps hold the stopband at -62.6 dB in float and -62.5 with 16-bit taps. With 8-bit taps it is -32.8: the bits, not the window, set the floor.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "R. G. Lyons, Understanding Digital Signal Processing, 3rd ed., ch. 5: finite impulse response filters", "F. J. Harris, On the use of windows for harmonic analysis with the discrete Fourier transform, Proc. IEEE 66(1), 1978: Hamming and Blackman"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_MIN_TAPS : u8 = 5;
pub const K_TAP_LIMIT : u8 = 63;
pub const K_PER_MILLI : u16 = 1000;
pub const K_FC_MIN_MILLI : u16 = 20;
pub const K_FC_MAX_MILLI : u16 = 450;
pub const K_FSTOP_MIN_MILLI : u16 = 50;
pub const K_FSTOP_MAX_MILLI : u16 = 490;
pub const K_MIN_BITS : u8 = 6;
pub const K_MAX_BITS : u8 = 20;
pub const K_DB_SHOWN : u8 = 120;
pub const K_WINDOW_KINDS : [3]u8 = [0, 1, 2];
pub const K_WIN_RECT : u8 = 0;
pub const K_WIN_HAMMING : u8 = 1;
pub const K_WIN_BLACKMAN : u8 = 2;
pub const K_PRESET_TAPS : [4]u8 = [31, 31, 31, 63];
pub const K_PRESET_FC_MILLI : [4]u16 = [100, 100, 100, 50];
pub const K_PRESET_WINDOW : [4]u8 = [0, 1, 1, 2];
pub const K_PRESET_BITS : [4]u8 = [16, 16, 8, 18];
pub const K_PRESET_FSTOP_MILLI : [4]u16 = [200, 200, 200, 100];
pub const K_START_PRESET : u8 = 1;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["31 taps, no window", "31 taps, Hamming", "Hamming, 8-bit taps", "63 taps, Blackman, 18 bits"];
pub const SAY_TAPS : str = "Taps";
pub const SAY_FC : str = "Cutoff, cycles per sample";
pub const SAY_WINDOW : str = "Window";
pub const SAY_WINDOWS : [3]str = ["rectangular", "Hamming", "Blackman"];
pub const SAY_BITS : str = "Coefficient bits";
pub const SAY_FSTOP : str = "Stopband from";
pub const SAY_TAPS_LABEL : str = "The integer taps as stems";
pub const SAY_RESP_LABEL : str = "The response with float and integer taps, and the stopband";
pub const SAY_TAP_AXIS : str = "tap";
pub const SAY_F_AXIS : str = "frequency, cycles per sample";
pub const SAY_DB : str = "dB";
pub const SAY_DB_VALUE : str = "{0} dB";
pub const SAY_INT : str = "integer taps";
pub const SAY_FLOAT : str = "float taps";
pub const SAY_STOPBAND : str = "stopband and its highest level";
pub const SAY_STOP_INT : str = "stopband, integer";
pub const SAY_STOP_FLOAT : str = "stopband, float";
pub const SAY_AT_FC : str = "at the cutoff";
pub const SAY_CENTER : str = "centre tap";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/signals.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_windows_are_the_spec_kinds {
    assert K_WINDOW_KINDS[0] == K_WIN_RECT;
    assert K_WINDOW_KINDS[1] == K_WIN_HAMMING;
    assert K_WINDOW_KINDS[2] == K_WIN_BLACKMAN;
    assert K_TAP_LIMIT % 2 == 1;
}

test the_presets_put_the_stopband_above_the_cutoff {
    assert K_PRESET_FSTOP_MILLI[0] > K_PRESET_FC_MILLI[0];
    assert K_PRESET_FSTOP_MILLI[3] > K_PRESET_FC_MILLI[3];
    assert K_PRESET_BITS[2] < K_PRESET_BITS[1];
    assert K_PRESET_TAPS[3] == K_TAP_LIMIT;
}
