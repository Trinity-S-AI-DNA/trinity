// SPDX-License-Identifier: Apache-2.0
; specs/widgets/gatle.t27 -- Gatle: guess how many LUTs yosys spends on today's t27 module
; Source of truth for public/widgets/gatle/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English of its own: every
; word on screen is a SAY_ constant here, and the rules are K_ constants.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT SHOWS: a daily guessing game in the manner of Wordle. Each UTC day every reader gets the
; same real module from the vendored specs (public/t27/files/specs), its t27 source, and the
; Verilog that public/t27/t27_compiler.wasm emits for it -- compiled in the reader's browser, with
; the sha256 compared against the Verilog yosys read. The reader has K_GUESSES guesses at how many
; LUTs (LUT1 to LUT6 cells) yosys spends on it. Each guess is graded: close when within
; K_CLOSE_PCT percent of the truth (the boundary counts as close), warm within K_WARM_PCT, cold
; otherwise, with an arrow toward the truth. The end shows flip-flops, CARRY4, MUXF7/8, DSP48E1 and
; every cell type, the same module synthesised the other way (DSPs allowed), and a share text of
; emoji rows, "Gatle #N" and K_SHARE_URL, copied by a button and posted by nobody but the reader.
; Practice mode deals a random module from the same pool.

; THE DAY: the puzzle of a UTC day is (days since 1970-01-01 minus K_EPOCH_DAY) modulo
; K_POOL_SIZE, an index into K_POOL_IDS; the epoch day is Gatle #1. The pool order is the sha256
; of each spec path, a fixed shuffle nobody chose. public/widgets/gatle/rule.js holds these rules
; as code; scripts/widget-data/gatle.mjs imports that file and checks it against the tests below.

; THE NUMBERS: scripts/widget-data/gatle.mjs compiles every vendored spec to Verilog with the wasm
; compiler in node, keeps modules with data ports, and runs yosys on each one twice, with and
; without DSPs. The answer is the K_SYNTH run, -nodsp, so the number to guess is LUT fabric only and
; can never depend on whether yosys chose a DSP48E1. In this pool the run with DSPs allowed placed
; none anyway; its LUT count differs by a few on some modules, and the page shows it at the end. A
; module is in the pool when yosys accepts it within ten minutes, its code (lines neither blank nor
; comment-only) fits K_MAX_CODE_LINES by K_MAX_CODE_COLS, and it costs K_MIN_LUTS to K_MAX_LUTS
; LUTs. Every other spec is listed in pool.json with its reason. The script exits non-zero when
; this file and pool.json disagree.

; WHAT IT DOES NOT CLAIM: LUT counts after synthesis are not a placed-and-routed design; no timing,
; no board, no Vivado. The modules are mostly combinational as the emitter writes them
; (K_POOL_ZERO_FF of K_POOL_SIZE have no flip-flop), so the guess is LUTs and flip-flops are shown
; at the end rather than guessed. There are no streaks and no statistics: the page keeps nothing,
; no storage and no cookies, and a day's guesses live only in the address after the #. Most
; sources are longer than one phone screen: under 40 code lines the pool would hold too few
; modules for a daily game, so the code-size rule is a scrolling box, comment lines folded.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_gatle;

pub const KIND : str = "widget-tool";
pub const ID : str = "gatle";
pub const TITLE : str = "Gatle: guess how many LUTs yosys spends on today's t27 module";
pub const DESCRIPTION : str = "A daily guessing game: one real t27 module, its Verilog compiled in your browser, six guesses at the LUT count yosys reported for it.";
pub const IMAGE_ALT : str = "Gatle card, a sample game of puzzle #1 (2026-10-04), ternary/gft_sgd_step: guesses 122, 607 and 1351 are told more, 2014 is told fewer, and 1650 lands within 10% of the 1826 LUTs yosys reported with synth_xilinx -nodsp. One of 37 real t27 modules, one a day.";
pub const HOOK : str = "Can you out-guess yosys? One real t27 module a day, six guesses at its LUT count. Puzzle #1 cost 1826 LUTs; splitting the range took five.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [4]str = ["public/t27/t27_compiler.wasm (sha256 bb39b9a5ca41...), run in node by scripts/widget-data/gatle.mjs on 2026-10-04: the Verilog of every vendored spec; the page recompiles the day's module in the browser and compares sha256", "Yosys 0.67+post (git sha1 b8e7da6f), run 2026-10-04: read_verilog -sv; synth_xilinx -family xc7 -flatten -nodsp -top <top>; stat -json. The LUT1 to LUT6 cells are the answer", "The same Yosys in the same run: synth_xilinx -family xc7 -flatten, DSPs allowed, shown beside the answer when a game ends", "scripts/widget-data/gatle.mjs: public/widgets/gatle/pool.json with every rejected spec and its reason; --refilter tightened the code-size rule to the spec's, with no new yosys run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- What is measured and what is kept --------------------------------------------------------
pub const K_SYNTH : str = "synth_xilinx -family xc7 -flatten -nodsp";
pub const K_OTHER_SYNTH : str = "synth_xilinx -family xc7 -flatten";
pub const K_MIN_LUTS : u16 = 5;
pub const K_MAX_LUTS : u16 = 3000;
pub const K_MAX_CODE_LINES : u16 = 160;
pub const K_MAX_CODE_COLS : u16 = 120;
pub const K_DATA_FILE : str = "./pool.json";

; --- The pool: written from pool.json by `node scripts/widget-data/gatle.mjs --spec-lines` ------
pub const K_POOL_SIZE : u8 = 37;
pub const K_POOL_IDS : [37]str = ["ternary/gft_sgd_step", "ternary/gft_mlp2", "igla/race/ternary_lut_table", "ternary/comb_ternary_dot", "igla/race/ternary_mac_group", "ternary/gft_recip", "ternary/gft_dot4_rne", "ternary/stream_ternary_mac", "ternary/ternary_mac", "ternary/gft_classify", "ternary/gft_mul_rne", "numeric/e8m0", "ternary/gft_dot2_rne", "boards/wukong_v1", "ternary/gft_layer2", "igla/race/phi_accumulator_growth", "ternary/comb_bitnet_neuron", "igla/race/ternary_node", "ternary/gft_exp2", "ternary/gft_dot2", "ternary/gft_relu", "ternary/ternary_xor", "ternary/gft_smul", "igla/race/unit_weights_node", "ternary/comb_bitnet_layer", "ternary/gft_add_rne", "compiler/mod_structure", "ternary/gft_argmax4", "ternary/ternary_ripple_adder", "ternary/ternary_full_adder", "ternary/gft_signed_mac", "igla/race/mvp_ternary_classifier", "ternary/gft_madd", "ternary/gft_sadd", "ternary/activation_quantizer", "ternary/gft_dot8", "ternary/gft_dot4"];
pub const K_POOL_ZERO_FF : u8 = 36;
pub const K_CANDIDATES : u16 = 88;
pub const K_CORPUS_SPECS : u16 = 1682;

; --- The day ----------------------------------------------------------------------------------
; 2026-10-04, the UTC day the pool was built, is day 20730 since 1970-01-01, and Gatle #1.
pub const K_EPOCH_DATE : str = "2026-10-04";
pub const K_EPOCH_DAY : u32 = 20730;
; Two fixed dates with their day numbers, pool indexes and puzzle numbers. gatle.mjs checks that
; rule.js gives exactly these; the test below checks the arithmetic against K_POOL_SIZE.
pub const K_TEST_DATES : [2]str = ["2026-10-04", "2027-01-01"];
pub const K_TEST_DAYS : [2]u32 = [20730, 20819];
pub const K_TEST_INDEX : [2]u32 = [0, 15];
pub const K_TEST_NUMBER : [2]u32 = [1, 90];

; --- The guess --------------------------------------------------------------------------------
pub const K_GUESSES : u8 = 6;
pub const K_CLOSE_PCT : u8 = 10;
pub const K_WARM_PCT : u8 = 50;
pub const K_MAX_GUESS : u32 = 99999;
; The 10% boundary against a truth of 200: 180 and 220 are close, 179 and 221 are not.
; |guess - truth| * 100 <= truth * K_CLOSE_PCT is close; integer arithmetic, no rounding.
pub const K_RULE_TRUTH : u16 = 200;
pub const K_RULE_GUESSES : [4]u16 = [180, 179, 220, 221];
pub const K_RULE_HEAT : [4]str = ["close", "warm", "close", "warm"];
pub const K_RULE_DIR : [4]str = ["hit", "up", "hit", "down"];

; --- The share text ---------------------------------------------------------------------------
; Code points: green, yellow and red squares for close, warm and cold (the tile colours); up and down arrows,
; each followed by the emoji presentation selector.
pub const K_EMOJI_HEAT : [3]u32 = [129001, 129000, 128997];
pub const K_ARROWS : [2]u32 = [11014, 11015];
pub const K_EMOJI_SELECTOR : u32 = 65039;
pub const K_SHARE_URL : str = "t27.ai/widgets/gatle/";

; --- Words ------------------------------------------------------------------------------------
; {name} is filled by tool.js from pool.json or from the K_ constants above; nothing else is.
pub const SAY_LOADING : str = "Loading...";
pub const SAY_LOAD_FAILED : str = "The puzzle pool could not be read.";
pub const SAY_MODES : [2]str = ["Today", "Practice"];
pub const SAY_DAILY_LINE : str = "Gatle #{n}, {date} UTC: puzzle {i} of {size}. Every reader gets this module today.";
pub const SAY_PAST_LINE : str = "Gatle #{n} of {date}, opened from a link. Today is #{today}.";
pub const SAY_PRACTICE_LINE : str = "Practice: a random module from the {size}. Today's game is untouched.";
pub const SAY_NEW_PRACTICE : str = "Another module";
pub const SAY_TABS : [2]str = ["t27 source", "Verilog"];
pub const SAY_MODULE_META : str = "top module {top}; {code} code lines, {lines} with comments";
pub const SAY_SOURCE_FAILED : str = "The module's source could not be read.";
pub const SAY_SHOW_COMMENTS : str = "Show {n} comment lines";
pub const SAY_HIDE_COMMENTS : str = "Hide comment lines";
pub const SAY_SOURCE_DRIFT : str = "This source is not the one yosys read: its sha256 differs from pool.json.";
pub const SAY_COMPILING : str = "Compiling in your browser with t27_compiler.wasm...";
pub const SAY_COMPILE_FAILED : str = "The compiler could not run in this browser.";
pub const SAY_VERILOG_SAME : str = "Compiled here in {ms} ms: {bytes} bytes, sha256 {sha}..., the same Verilog yosys read.";
pub const SAY_VERILOG_DRIFT : str = "Compiled here in {ms} ms: sha256 {sha}... is not {was}..., the Verilog yosys read.";
pub const SAY_VERILOG_UNCHECKED : str = "Compiled here in {ms} ms: {bytes} bytes. This browser cannot hash it to compare.";
pub const SAY_QUESTION : str = "How many LUTs does yosys spend on this module?";
pub const SAY_RULE_NOTE : str = "LUT1 to LUT6 cells after {synth}, {version}. Close: within {close}%. Warm: within {warm}%.";
pub const SAY_BOARD_LABEL : str = "Your guesses";
pub const SAY_HEAT : [3]str = ["close, within {close}%", "warm, within {warm}%", "cold"];
pub const SAY_DIRS : [3]str = ["got it", "more", "fewer"];
pub const SAY_INPUT_LABEL : str = "Your guess, in LUTs";
pub const SAY_GUESS : str = "Guess";
pub const SAY_GUESSES_LEFT : str = "{n} of {max} guesses left.";
pub const SAY_BAD_GUESS : str = "A whole number from 0 to {max}, please.";
pub const SAY_ALREADY : str = "You guessed that number already.";
pub const SAY_WON : str = "Within {close}% in {n} of {max}.";
pub const SAY_LOST : str = "Out of guesses.";
pub const SAY_ANSWER : str = "yosys: {lut} LUTs";
pub const SAY_REVEAL : str = "Also {ff} flip-flops, {carry4} CARRY4, {muxf7} MUXF7, {muxf8} MUXF8, {dsp} DSP48E1; {cells} cells in all.";
pub const SAY_OTHER_SAME : str = "With {mode}: the same LUT and DSP counts.";
pub const SAY_OTHER_DIFF : str = "With {mode}: {lut} LUTs and {dsp} DSP48E1.";
pub const SAY_BY_TYPE : str = "Every cell type yosys reported";
pub const SAY_SHARE_LABEL : str = "Share text";
pub const SAY_SHARE_HEAD : str = "Gatle #{n} {score}/{max}";
pub const SAY_SHARE_PRACTICE : str = "Gatle practice {score}/{max}";
pub const SAY_SHARE_LOST : str = "X";
pub const SAY_COPY : str = "Copy";
pub const SAY_COPIED : str = "Copied.";
pub const SAY_COPY_FAILED : str = "Copy failed; the text is selected, copy it by hand.";
pub const SAY_NO_STREAKS : str = "No streaks and no stats: this page keeps nothing. Your guesses live only in the address after the #, so a bookmark or a link carries them and nothing else does.";
pub const SAY_POOL_NOTE : str = "{size} puzzles: the modules of {specs} vendored specs that emit Verilog with data ports ({candidates} synthesised), fit {lines} code lines by {cols} columns and cost {min} to {max} LUTs; {zeroff} have no flip-flop. Built {date}.";

test day_index_on_two_fixed_dates {
  assert K_TEST_INDEX[0] == (K_TEST_DAYS[0] - K_EPOCH_DAY) % K_POOL_SIZE;
  assert K_TEST_INDEX[1] == (K_TEST_DAYS[1] - K_EPOCH_DAY) % K_POOL_SIZE;
  assert K_TEST_NUMBER[0] == K_TEST_DAYS[0] - K_EPOCH_DAY + 1;
  assert K_TEST_NUMBER[1] == K_TEST_DAYS[1] - K_EPOCH_DAY + 1;
  assert K_TEST_DAYS[0] == K_EPOCH_DAY;
}

test close_is_within_ten_percent_boundary_included {
  assert K_CLOSE_PCT == 10;
  assert K_RULE_TRUTH - K_RULE_GUESSES[0] == 20;
  assert K_RULE_TRUTH * K_CLOSE_PCT >= (K_RULE_TRUTH - K_RULE_GUESSES[0]) * 100;
  assert K_RULE_TRUTH - K_RULE_GUESSES[1] == 21;
  assert K_RULE_TRUTH * K_CLOSE_PCT < (K_RULE_TRUTH - K_RULE_GUESSES[1]) * 100;
  assert K_RULE_TRUTH * K_WARM_PCT >= (K_RULE_TRUTH - K_RULE_GUESSES[1]) * 100;
  assert K_RULE_GUESSES[2] - K_RULE_TRUTH == 20;
  assert K_RULE_TRUTH * K_CLOSE_PCT >= (K_RULE_GUESSES[2] - K_RULE_TRUTH) * 100;
  assert K_RULE_GUESSES[3] - K_RULE_TRUTH == 21;
  assert K_RULE_TRUTH * K_CLOSE_PCT < (K_RULE_GUESSES[3] - K_RULE_TRUTH) * 100;
  assert K_RULE_HEAT[0] == "close";
  assert K_RULE_HEAT[1] == "warm";
  assert K_RULE_DIR[1] == "up";
  assert K_RULE_DIR[3] == "down";
}

test pool_size_matches_the_id_list {
  assert K_POOL_IDS[K_POOL_SIZE - 1] != "";
  assert K_POOL_ZERO_FF <= K_POOL_SIZE;
  assert K_POOL_SIZE <= K_CANDIDATES;
  assert K_CANDIDATES <= K_CORPUS_SPECS;
}

test sends_nothing_and_keeps_nothing {
  assert SENDS_NOTHING == true;
  assert READS_LOCAL_FILES == false;
  assert K_DATA_FILE == "./pool.json";
  assert K_MIN_LUTS < K_MAX_LUTS;
}
