// SPDX-License-Identifier: Apache-2.0
; specs/widgets/tc-long-multiply.t27 -- lesson 11 of the course "The ternary machine" (specs/course/ternary-computing.t27)
; Source of truth for public/widgets/tc-long-multiply/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles this
; file, checks its constants, evaluates the tests below and writes the page; the page hands every constant to
; tool.js as window.T27_WIDGET. tool.js draws through ../ternary-kit.js and computes nothing: every number comes
; from public/widgets/tc-long-multiply/logic.js, the fn bodies of the gHashTag/t27 spec in logic.t27, compiled to wasm.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_tc_long_multiply;

pub const KIND : str = "widget-tool";
pub const ID : str = "tc-long-multiply";
pub const TITLE : str = "Long multiplication in balanced ternary";
pub const DESCRIPTION : str = "Each trit of m picks a copy, a zero or a flip of n, shifted one place per row. Add the rows: that is the product.";
pub const IMAGE_ALT : str = "Long multiplication card: 7 x 8. 8 is +0-, so the rows are a flipped 7, nothing, and 7 shifted two places: -7 + 0 + 63 = 56.";
pub const HOOK : str = "Seven times eight is three rows: minus seven, nothing, sixty-three. No times table to learn.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ternary/trits.t27 (t27#8979): every value on the page is its fn bodies, compiled to wasm (logic.js), with 18 tests and 4108 runtime asserts", "D. Knuth, The Art of Computer Programming, vol. 2, section 4.1: balanced ternary"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

pub const SAY_LOADING : str = "Loading";
pub const K_TRITS : u32 = 6;
pub const K_FACTOR_TRITS : u32 = 3;
pub const K_START_N : i32 = 7;
pub const K_START_M : i32 = 8;
pub const SAY_ROW : str = "row {0}: trit {1}, {2}";
pub const SAY_SUM : str = "sum";
pub const SAY_RESULT : str = "{0} x {1} = {2}";
pub const SAY_HOW : str = "Every row is n copied, dropped or flipped, shifted by its place. Only additions follow.";
pub const SAY_OPS : [3]str = ["flip", "zero", "copy"];
pub const SAY_SOURCE : str = "Logic: t27 spec ternary/trits.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_widget_starts_where_its_card_says {
    assert K_START_N == 7;
    assert K_START_M == 8;
}
