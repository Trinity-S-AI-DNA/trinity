// SPDX-License-Identifier: Apache-2.0
; specs/widgets/golden-decode.t27 -- the infographic of lesson 27 of the GoldenFloat course (specs/course/goldenfloat.t27)
; Source of truth for public/widgets/golden-decode/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/math/gf_competitive.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_golden_decode;

pub const KIND : str = "widget-tool";
pub const ID : str = "golden-decode";
pub const TITLE : str = "GoldenFloat 27: decode in one step";
pub const DESCRIPTION : str = "Decode steps as gf_competitive.t27 counts them, read from gf_competitive.t27. Lesson 27 of the GoldenFloat course.";
pub const IMAGE_ALT : str = "A black and white table, Decode steps as gf_competitive.t27 counts them: IEEE FP16, 3, yes; POSIT16, 6, no; GF16, 3, yes.";
pub const HOOK : str = "Fixed fields decode at once; a posit must find its regime first.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/math/gf_competitive.t27, read when the course was authored; every number in the table is a constant, a test value or arithmetic of that file", "Nothing on this page was measured on hardware or timed; a value written into a test is said to be written in, not computed"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Decode steps as gf_competitive.t27 counts them";
pub const SAY_TABLE_HEAD : [3]str = ["Format", "Steps", "Fields in parallel"];
pub const SAY_TABLE_CELLS : [9]str = ["IEEE FP16", "3", "yes", "POSIT16", "6", "no", "GF16", "3", "yes"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 3;
pub const K_TABLE_CELLS : u16 = 9;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_NOTE : str = "Counts written into the spec, not a timing on hardware; an invariant checks POSIT16 has more steps than GF16.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}
