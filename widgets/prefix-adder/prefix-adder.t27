// SPDX-License-Identifier: Apache-2.0
; specs/widgets/prefix-adder.t27 -- prefix adders: the carries as a network, ripple, Sklansky, Kogge-Stone and Brent-Kung
; Source of truth for public/widgets/prefix-adder/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/prefix-adder/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/adders.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 2 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader picks a width (4 to 32 bits) and one of four prefix networks and sees every
; cell of it, level by level, coloured by level; tapping a column lights the cone of cells its carry
; depends on. Tiles give the levels, the cells, the largest fanout and whether the network computes every
; carry (the spec replays it on spans); bars compare the four networks at the same width.

; WHAT IT DOES NOT CLAIM: wire length and fanout delay are not timed; the level count is the logic depth only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_prefix_adder;

pub const KIND : str = "widget-tool";
pub const ID : str = "prefix-adder";
pub const TITLE : str = "Prefix adders: trade logic levels for cells and wires";
pub const DESCRIPTION : str = "Pick a width and a network -- ripple, Sklansky, Kogge-Stone, Brent-Kung -- and see every carry cell. Tap a bit to light the cells its carry waits for.";
pub const IMAGE_ALT : str = "Prefix adder card: a 16-bit Kogge-Stone network, 4 levels of coloured cells, 49 cells in all, fanout 1, against ripple with 15 levels and Brent-Kung with 7 levels and 26 cells.";
pub const HOOK : str = "Kogge-Stone adds 32 bits in 5 levels with 129 cells; Brent-Kung takes 9 levels and 57. Same carries, different bill.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/dsp/adders.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "D. Harris, A taxonomy of parallel prefix networks, Asilomar 2003: serial, Sklansky, Kogge-Stone and Brent-Kung levels and cells", "P. M. Kogge, H. S. Stone, IEEE Trans. Computers C-22(8), 1973; R. P. Brent, H. T. Kung, IEEE Trans. Computers C-31(3), 1982; J. Sklansky, IRE Trans. EC-9(2), 1960"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_WIDTHS : [4]u8 = [4, 8, 16, 32];
pub const K_MAX_BITS : u8 = 32;
pub const K_NET_RIPPLE : u8 = 0;
pub const K_NET_SKLANSKY : u8 = 1;
pub const K_NET_KOGGE_STONE : u8 = 2;
pub const K_NET_BRENT_KUNG : u8 = 3;
pub const K_PRESET_WIDTH : [4]u8 = [2, 2, 2, 3];
pub const K_PRESET_NET : [4]u8 = [0, 2, 3, 1];
pub const K_PRESET_COL : [4]u8 = [15, 15, 15, 31];
pub const K_START_PRESET : u8 = 1;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["16-bit ripple: 15 levels", "16-bit Kogge-Stone", "16-bit Brent-Kung", "32-bit Sklansky: fanout 16"];
pub const SAY_WIDTH : str = "Width, bits";
pub const SAY_NETWORK : str = "Network";
pub const SAY_NETS : [4]str = ["Ripple", "Sklansky", "Kogge-Stone", "Brent-Kung"];
pub const SAY_TAP : str = "Each dot combines its column with the column its line comes from. Tap a column: the white dots are the cells its carry waits for.";
pub const SAY_NET_LABEL : str = "The prefix network: columns are bits, rows are logic levels";
pub const SAY_BARS_LABEL : str = "Levels and cells of the four networks at this width";
pub const SAY_COLUMN : str = "bit {0}";
pub const SAY_LEVELS_DOWN : str = "{0} levels, top to bottom";
pub const SAY_LEVELS : str = "logic levels";
pub const SAY_CELLS : str = "prefix cells";
pub const SAY_FANOUT : str = "largest fanout";
pub const SAY_CHECK : str = "every carry computed";
pub const SAY_YES : str = "yes";
pub const SAY_NO : str = "no";
pub const SAY_COMPARE : str = "At {0} bits:";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/adders.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_widths_are_powers_of_two {
    assert K_WIDTHS[0] == 4;
    assert K_WIDTHS[1] * 2 == K_WIDTHS[2];
    assert K_WIDTHS[3] == K_MAX_BITS;
}

test the_presets_name_real_networks {
    assert K_PRESET_NET[0] == K_NET_RIPPLE;
    assert K_PRESET_NET[1] == K_NET_KOGGE_STONE;
    assert K_PRESET_NET[2] == K_NET_BRENT_KUNG;
    assert K_PRESET_NET[3] == K_NET_SKLANSKY;
    assert K_PRESET_COL[3] < K_MAX_BITS;
}
