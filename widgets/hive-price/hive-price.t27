// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-price.t27 -- The price of an operation: twice its cost, rounded up
; Source of truth for public/widgets/hive-price/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-price/logic.js -- the fn
; bodies of gHashTag/t27 specs/automation/token-wallet.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 20 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader drags the cost of one operation in micro-dollars and a monthly price in
; dollars. The price is price_tokens(cost); the month is month_tokens(dollars), and reels_in and
; portraits_in of that month.

; WHAT IT DOES NOT CLAIM:  it charges nothing; the reel and portrait sizes are the spec constants
; REEL_TOKENS and PORTRAIT_TOKENS.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_price;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-price";
pub const TITLE : str = "The price of an operation: twice its cost, rounded up";
pub const DESCRIPTION : str = "Drag what an operation costs the project and what a person pays a month: price_tokens sells it at twice the cost in half-cent tokens, and month_tokens turns dollars into tokens.";
pub const IMAGE_ALT : str = "Price card: an operation that costs 12300 micro-dollars sells for 5 tokens. A $20 month buys 4000 tokens, which is 14 reels of 270 tokens or 333 portraits of 12. The verdict line reads 5 tokens in gold.";
pub const HOOK : str = "One rate everywhere: a token is half a cent, and every operation is sold at twice what it costs, rounded up so nothing is sold below that.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/automation/token-wallet.t27 (t27 master c42f8fb40): every value on the page is price_tokens, month_tokens, reels_in and portraits_in, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 20 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_COST_MAX : u32 = 200000;
pub const K_COST_STEP : u16 = 100;
pub const K_USD_MAX : u8 = 200;
pub const K_TOKEN_MICRO_USD : u32 = 5000;
pub const K_MARKUP_PCT : u32 = 200;
pub const K_REEL_TOKENS : u32 = 270;
pub const K_PORTRAIT_TOKENS : u32 = 12;
pub const K_PRESET_COST : [4]u32 = [12300, 2500, 2600, 130000];
pub const K_PRESET_USD : [4]u8 = [20, 49, 10, 100];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["A $0.0123 call, $20 a month", "Exactly half a cent", "Just over half a cent", "A $0.13 lip-sync, $100"];
pub const SAY_ASK : str = "What does an operation cost a person, and what does a month buy?";
pub const SAY_COST : str = "what it costs us, micro-dollars";
pub const SAY_USD : str = "a month, dollars";
pub const SAY_PRICE : str = "price, tokens";
pub const SAY_MONTH : str = "tokens a month";
pub const SAY_REELS : str = "reels in a month";
pub const SAY_PORTRAITS : str = "portraits in a month";
pub const SAY_COST_DOLLARS : str = "costs ${0}";
pub const SAY_EACH : str = "{0} tokens";
pub const SAY_NOTE : str = "2500 micro-dollars is half a cent: at twice the cost that is exactly one token. 2600 is two, because the price rounds up. Tokens not spent within a month burn: the next lesson.";
pub const SAY_SOURCE : str = "Logic: t27 spec automation/token-wallet.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test one_rate_one_markup {
    assert K_TOKEN_MICRO_USD == 5000;
    assert K_MARKUP_PCT == 200;
}

test the_presets_fit {
    assert K_PRESET_COST[3] <= K_COST_MAX;
    assert K_PRESET_USD[3] <= K_USD_MAX;
    assert K_PRESET_COST[1] * 2 == K_TOKEN_MICRO_USD;
}
