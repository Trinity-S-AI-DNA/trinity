// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-shape.t27 -- Shaping: what the Queen does with an issue that is not ready
; Source of truth for public/widgets/hive-shape/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-shape/logic.js -- the fn
; bodies of gHashTag/t27 specs/queen/shaping.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 1 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader sets the sections judge() finds missing, whether the issue is an epic,
; the attempts so far, whether the author was told, and the minutes since the last attempt. The card
; goes to the column shape_action names; the row of attempts 0 to 4 is shape_action at each count;
; the tile is attempt_due.

; WHAT IT DOES NOT CLAIM:  it does not run the model that writes the sections, nor judge() itself
; (specs/policy/issue_shape.t27).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_shape;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-shape";
pub const TITLE : str = "Shaping: what the Queen does with an issue that is not ready";
pub const DESCRIPTION : str = "Set how many sections an issue lacks and how often shaping failed: the Queen leaves it, shapes it, or tells its author once what is missing.";
pub const IMAGE_ALT : str = "Shaping card: an issue missing two sections after two failed attempts. The board puts its card in the gold TELL column; the attempt row reads shape, shape, tell, tell, tell for attempts 0 to 4. Tiles read action TELL, attempt due yes after 420 minutes, limit 2.";
pub const HOOK : str = "Two failed shapes and the Queen stops rewriting the issue: she comments once with what is missing, and never again.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/queen/shaping.t27 (t27 master c42f8fb40): every value on the page is shape_action and attempt_due, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 1 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_MISSING_MAX : u8 = 3;
pub const K_ATTEMPTS_MAX : u8 = 4;
pub const K_MINUTES_MAX : u16 = 720;
pub const K_MINUTES_STEP : u8 = 30;
pub const K_SHAPE_ATTEMPT_LIMIT : u32 = 2;
pub const K_SHAPE_RETRY_MINUTES : u32 = 360;
pub const K_PRESET_MISSING : [5]u8 = [2, 0, 2, 1, 2];
pub const K_PRESET_CONTAINER : [5]u8 = [0, 0, 1, 0, 0];
pub const K_PRESET_ATTEMPTS : [5]u8 = [2, 0, 0, 0, 3];
pub const K_PRESET_TOLD : [5]u8 = [0, 0, 0, 0, 1];
pub const K_PRESET_MINUTES : [5]u16 = [420, 0, 0, 0, 600];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [5]str = ["Two shapes failed", "A ready issue", "An epic", "A first try", "Already told"];
pub const SAY_ASK : str = "What does the Queen do with an issue that is not ready for a bee?";
pub const SAY_MISSING : str = "sections missing";
pub const SAY_CONTAINER : str = "an epic or roadmap";
pub const SAY_ATTEMPTS : str = "shapes tried";
pub const SAY_TOLD : str = "author already told";
pub const SAY_MINUTES : str = "minutes since the last try";
pub const SAY_ACTIONS : [3]str = ["LEAVE", "SHAPE", "TELL"];
pub const SAY_ACTION_LINES : [3]str = ["nothing to do", "write the missing sections, judge them", "comment once with what is missing"];
pub const SAY_ISSUE : str = "the issue";
pub const SAY_ROW : str = "the same issue after 0, 1, 2, 3 and 4 tries";
pub const SAY_ACTION : str = "action";
pub const SAY_DUE : str = "another try due";
pub const SAY_YES : str = "yes";
pub const SAY_NO : str = "no";
pub const SAY_LIMIT : str = "attempt limit";
pub const SAY_NOTE : str = "A shape is one model call, and a refused shape is not retried for 360 minutes. After the limit the Queen stops writing and comments once, so a broken issue never costs a model call every round.";
pub const SAY_SOURCE : str = "Logic: t27 spec queen/shaping.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_presets_stay_in_range {
    assert K_PRESET_MISSING[0] <= K_MISSING_MAX;
    assert K_PRESET_ATTEMPTS[4] <= K_ATTEMPTS_MAX;
    assert K_PRESET_MINUTES[4] <= K_MINUTES_MAX;
}

test the_start_is_past_the_limit {
    assert K_PRESET_ATTEMPTS[0] == K_SHAPE_ATTEMPT_LIMIT;
    assert K_PRESET_MISSING[0] > 0;
    assert K_PRESET_TOLD[0] == 0;
}
