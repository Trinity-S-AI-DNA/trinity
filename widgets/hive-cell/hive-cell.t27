// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-cell.t27 -- The comb answers: what an event does to a cell
; Source of truth for public/widgets/hive-cell/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-cell/logic.js -- the fn
; bodies of gHashTag/t27 specs/queen/hive.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 27 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader picks an event kind, whether a review accepted, the milliseconds since
; the event, and for new cells the count pending, whether cells were placed before and the seconds
; since the last batch. Each cell is cell_effect(kind, accepted) at flash_alpha(ms); the gate is
; cells_due.

; WHAT IT DOES NOT CLAIM:  it is a flat comb, not the 3D game, and reads no live events.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_cell;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-cell";
pub const TITLE : str = "The comb answers: what an event does to a cell";
pub const DESCRIPTION : str = "Ten kinds of event reach the game. Pick one and the moment since: cell_effect colours the cell gold, amber, red, grey or white, flash_alpha fades it, and cells_due batches new cells.";
pub const IMAGE_ALT : str = "Comb card: ten cells, one per event kind, 400 ms after a review that accepted. The review cell flashes gold at 778 of 1000; task created is white, lease expired red, cancel grey, the six others dark. A gate below reads new cells due: no, 120 s of 300 since the last batch.";
pub const HOOK : str = "Before this spec an accepted task, a lost lease and a cancel looked the same as no news. Now each paints its cell, and the flash fades over 1800 ms.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/queen/hive.t27 (t27 master c42f8fb40): every value on the page is cell_effect, flash_alpha and cells_due, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 27 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_KINDS : u8 = 10;
pub const K_MS_MAX : u16 = 2000;
pub const K_MS_STEP : u8 = 50;
pub const K_FLASH_MS : u32 = 1800;
pub const K_CELL_BATCH_SECONDS : u32 = 300;
pub const K_PENDING_MAX : u8 = 10;
pub const K_SINCE_MAX : u16 = 600;
pub const K_SINCE_STEP : u8 = 10;
pub const K_FX_TONES : [6]u8 = [9, 7, 1, 4, 6, 8];
pub const K_PRESET_KIND : [4]u8 = [5, 5, 3, 0];
pub const K_PRESET_ACCEPTED : [4]u8 = [1, 0, 0, 0];
pub const K_PRESET_MS : [4]u16 = [400, 200, 900, 0];
pub const K_PRESET_PENDING : [4]u8 = [3, 3, 1, 5];
pub const K_PRESET_PLACED : [4]u8 = [1, 1, 1, 0];
pub const K_PRESET_SINCE : [4]u16 = [120, 320, 30, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["A review accepted", "A review sent back", "A lease expired", "The page opens"];
pub const SAY_ASK : str = "How does the game show that something happened to a task?";
pub const SAY_KIND : str = "event";
pub const SAY_KIND_SHORT : [10]str = ["created", "ended", "idle", "lease", "evidence", "review", "assign", "cancel", "beat", "tick"];
pub const SAY_KIND_NAMES : [10]str = ["task created", "task ended", "worker idle", "lease expired", "evidence", "review", "assign", "cancel", "heartbeat", "tick"];
pub const SAY_ACCEPTED : str = "the review accepted";
pub const SAY_MS : str = "ms since the event";
pub const SAY_PENDING : str = "new cells waiting";
pub const SAY_PLACED : str = "cells placed before";
pub const SAY_SINCE : str = "seconds since the last batch";
pub const SAY_FX_NAMES : [6]str = ["nothing", "START, white", "ACCEPT, gold", "SEND BACK, amber", "LOST, red", "CANCEL, grey"];
pub const SAY_FLASH : str = "flash, of 1000";
pub const SAY_DUE : str = "new cells are placed now";
pub const SAY_NOT_DUE : str = "new cells wait for the next batch";
pub const SAY_BATCH : str = "{0} waiting, {1} s of {2}";
pub const SAY_NOTE : str = "A new cell rebuilds the whole scene, so cells are placed in batches at most every 300 s, and all at once when the page first opens. A task ended paints nothing: its ship flies home, which says it.";
pub const SAY_SOURCE : str = "Logic: t27 spec queen/hive.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test ten_kinds_and_their_clocks {
    assert K_KINDS == 10;
    assert K_FLASH_MS == 1800;
    assert K_CELL_BATCH_SECONDS == 300;
}

test the_sliders_cross_each_clock {
    assert K_MS_MAX > K_FLASH_MS;
    assert K_SINCE_MAX > K_CELL_BATCH_SECONDS;
    assert K_PRESET_KIND[0] == 5;
}
