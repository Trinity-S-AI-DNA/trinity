// SPDX-License-Identifier: Apache-2.0
; specs/widgets/tc-balanced-count.t27 -- lesson 2 of the course "The ternary machine" (specs/course/ternary-computing.t27)
; Source of truth for public/widgets/tc-balanced-count/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles this
; file, checks its constants, evaluates the tests below and writes the page; the page hands every constant to
; tool.js as window.T27_WIDGET. tool.js draws through ../ternary-kit.js and computes nothing: every number comes
; from public/widgets/tc-balanced-count/logic.js, the fn bodies of the gHashTag/t27 spec in logic.t27, compiled to wasm.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_tc_balanced_count;

pub const KIND : str = "widget-tool";
pub const ID : str = "tc-balanced-count";
pub const TITLE : str = "Balanced ternary: count with -1, 0 and +1";
pub const DESCRIPTION : str = "Step a number up and down and watch its trits change. Every integer, negative ones too, has one form with no sign symbol.";
pub const IMAGE_ALT : str = "Balanced ternary card: the number 8 as six trit tiles 0 0 0 + 0 - with weights 243 81 27 9 3 1: 9 - 1 = 8. It needs 3 trits and 5 bits; six trits reach -364 to +364.";
pub const HOOK : str = "No minus sign needed: 8 is 9 - 1, -8 is -9 + 1. Six trits count from -364 to +364.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/ternary/trits.t27 (t27#8979): every value on the page is its fn bodies, compiled to wasm (logic.js), with 18 tests and 4108 runtime asserts", "D. Knuth, The Art of Computer Programming, vol. 2, section 4.1: balanced ternary", "N. P. Brusentsov and others, the Setun computer, Moscow State University, 1958: a working balanced-ternary machine"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

pub const SAY_LOADING : str = "Loading";
pub const K_TRITS : u32 = 6;
pub const K_START : i32 = 8;
pub const K_TICK_MS : u16 = 450;
pub const SAY_NUMBER : str = "A number from {0} to {1}";
pub const SAY_PLAY : str = "Count up";
pub const SAY_STOP : str = "Stop";
pub const SAY_TILES : str = "{0} in balanced ternary";
pub const SAY_TRITS : str = "{0} trits needed";
pub const SAY_BITS : str = "{0} bits in two's complement";
pub const SAY_RANGE : str = "{0} trits reach +/-{1}";
pub const SAY_SOURCE : str = "Logic: t27 spec ternary/trits.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_widget_starts_where_its_card_says {
    assert K_TRITS == 6;
    assert K_START == 8;
}
