// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-revisit.t27 -- Back off: when the reviewer looks at a waiting row again
; Source of truth for public/widgets/hive-revisit/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-revisit/logic.js -- the fn
; bodies of gHashTag/t27 specs/queen/reviewer.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 11 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader sets the waits in a row and the seconds since the last visit. Each bar
; is revisit_after_seconds of its wait count; the dial and the verdict are due_again(waits,
; seconds).

; WHAT IT DOES NOT CLAIM:  the 941 and 888 are the spec record of 2026-10-09; the page visits
; nothing.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_revisit;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-revisit";
pub const TITLE : str = "Back off: when the reviewer looks at a waiting row again";
pub const DESCRIPTION : str = "A row that answered wait is not visited again at once: 30 s, doubled per wait, never more than 900 s. Drag the waits and the clock and see when it is due.";
pub const IMAGE_ALT : str = "Revisit card: a row that answered wait 4 times, 200 s after its last visit. Bars for 0 to 8 waits read 0, 30, 60, 120, 240, 480, 900, 900, 900 seconds, the fifth lit. The clock dial fills to 200 of 240: not due yet.";
pub const HOOK : str = "Measured over 44 minutes: 941 visits, 888 of them wait, from 22 rows. One row was visited 54 times. Doubling the pause gave those slots back.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/queen/reviewer.t27 (t27 master c42f8fb40): every value on the page is revisit_after_seconds and due_again, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 11 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_WAITS_MAX : u8 = 8;
pub const K_SINCE_MAX : u16 = 1000;
pub const K_SINCE_STEP : u8 = 10;
pub const K_WAIT_REVISIT_BASE_SECONDS : u32 = 30;
pub const K_WAIT_REVISIT_CAP_SECONDS : u32 = 900;
pub const K_PRESET_WAITS : [4]u8 = [4, 1, 7, 0];
pub const K_PRESET_SINCE : [4]u16 = [200, 40, 600, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["Four waits, 200 s", "One wait, 40 s", "Seven waits, at the cap", "A fresh row"];
pub const SAY_ASK : str = "When should the reviewer look again at a row that keeps answering wait?";
pub const SAY_WAITS : str = "waits in a row";
pub const SAY_SINCE : str = "seconds since the last visit";
pub const SAY_BARS : str = "pause before the next visit, by waits in a row";
pub const SAY_DUE : str = "due again";
pub const SAY_NOT_DUE : str = "not due yet";
pub const SAY_PAUSE : str = "pause, s";
pub const SAY_NOTE : str = "Any answer other than wait resets the count, so a row that starts to read is visited at the normal pace again. The cap keeps a stuck row in sight several times an hour.";
pub const SAY_SOURCE : str = "Logic: t27 spec queen/reviewer.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_pause_starts_at_30_and_stops_at_900 {
    assert K_WAIT_REVISIT_BASE_SECONDS == 30;
    assert K_WAIT_REVISIT_CAP_SECONDS == 900;
    assert K_SINCE_MAX > K_WAIT_REVISIT_CAP_SECONDS;
}

test the_presets_fit {
    assert K_PRESET_WAITS[2] <= K_WAITS_MAX;
    assert K_PRESET_SINCE[2] <= K_SINCE_MAX;
}
