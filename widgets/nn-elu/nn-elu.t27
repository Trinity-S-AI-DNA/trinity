// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-elu.t27 -- ELU: a negative side with a floor at -alpha
; Source of truth for public/widgets/nn-elu/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-elu/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/activation/elu_activation.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 6 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader drags x from -5 to 3 and sets alpha from 0.1 to 2. The curve is
; forward(x, alpha), the slope derivative(x, alpha), and the floor line is forward far to the left
; (x = -100).

; WHAT IT DOES NOT CLAIM: the floor is read as forward(-100, alpha), which is -alpha to f32
; precision, not the limit itself.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_elu;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-elu";
pub const TITLE : str = "ELU: a negative side with a floor";
pub const DESCRIPTION : str = "Drag along ELU: x above zero, alpha (e^x - 1) below. The negative side never falls under -alpha, so outputs average closer to zero, and its slope never quite dies.";
pub const IMAGE_ALT : str = "ELU card at alpha 1, x = -3: the green curve runs along the diagonal for positive x and bends down toward the red dashed floor at -1 on the left; the dashed gold slope is 1 on the right and decays toward 0 on the left. Tiles read -0.9502, slope 0.0498, floor -1.0000 and the spec batch (-1, 0, 2) as -0.632 0.000 2.000.";
pub const HOOK : str = "ELU(-3) with alpha 1 is -0.9502, already 95% of the way to its floor of -1, and its slope there is still 0.0498, not 0.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/activation/elu_activation.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 6 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_X_LO_C : i16 = -500;
pub const K_X_HI_C : i16 = 300;
pub const K_X_STEP_C : u8 = 5;
pub const K_Y_LO_C : i16 = -220;
pub const K_Y_HI_C : i16 = 300;
pub const K_X_TICKS : [5]i8 = [-4, -2, 0, 2, 3];
pub const K_Y_TICKS : [6]i8 = [-2, -1, 0, 1, 2, 3];
pub const K_ALPHA_LO_C : u8 = 10;
pub const K_ALPHA_HI_C : u8 = 200;
pub const K_ALPHA_STEP_C : u8 = 5;
pub const K_FAR_LEFT : u8 = 100;
pub const K_PRESET_X_C : [4]i16 = [-300, -300, 150, -100];
pub const K_PRESET_ALPHA_C : [4]u8 = [100, 50, 100, 200];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["alpha 1, x = -3", "alpha 0.5, x = -3", "alpha 1, x = 1.5", "alpha 2, x = -1"];
pub const SAY_ASK : str = "What if the negative side had a floor instead of a cliff?";
pub const SAY_X : str = "input x";
pub const SAY_ALPHA : str = "alpha";
pub const SAY_F : str = "ELU(x)";
pub const SAY_DF : str = "slope";
pub const SAY_FLOOR : str = "floor";
pub const SAY_PLOT_LABEL : str = "ELU of x, its slope and its floor from -5 to 3";
pub const SAY_OUT : str = "output";
pub const SAY_GRAD : str = "slope at x";
pub const SAY_BATCH : str = "spec batch -1 0 2";
pub const SAY_NOTE : str = "ReLU throws the negative side away; ELU keeps a soft version of it, so a unit stuck below zero still moves. alpha is how deep the floor lies.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/activation/elu_activation.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_floor_is_far_left {
    assert K_FAR_LEFT == 100;
    assert K_FAR_LEFT * 100 + K_X_LO_C > 0;
}

test the_presets_stay_in_range {
    assert K_PRESET_ALPHA_C[3] == K_ALPHA_HI_C;
    assert K_PRESET_ALPHA_C[1] >= K_ALPHA_LO_C;
    assert K_Y_LO_C + 200 < 0;
}
