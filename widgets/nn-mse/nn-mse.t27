// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-mse.t27 -- mean squared error: how wrong a guess is, as one number
; Source of truth for public/widgets/nn-mse/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-mse/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/loss/mse_loss.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 13 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader moves three predictions from -1 to 5. The loss is mse_at(p0, p1, p2)
; against the spec's targets (1, 2, 3), each gradient mse_grad_at, and the bowl mse_at over p0.

; WHAT IT DOES NOT CLAIM: the targets are the spec's fixture, repeated as K_TARGETS; every loss and
; gradient comes from the compiled fn.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_mse;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-mse";
pub const TITLE : str = "Mean squared error: how wrong a guess is, as one number";
pub const DESCRIPTION : str = "Move three predictions against the targets 1, 2 and 3: the loss is the mean of the squared misses, its bowl is a parabola, and each gradient points its prediction back at the target.";
pub const IMAGE_ALT : str = "MSE card: predictions 1.5, 2 and 2 against targets 1, 2, 3 drawn as white rings with green dots, red dashed misses and pink gradient arrows. Below, the loss as prediction 0 moves is a gold parabola with its cursor at 1.5. Tiles read loss 0.4167, gradients 0.333 0.000 -0.667, loss at the targets 0.0000 and misses of 1 and 2 costing 0.333 and 1.333.";
pub const HOOK : str = "A miss of 1 costs 1 / 3 of the mean; a miss of 2 costs 4 / 3. Squaring is what makes MSE fear large errors and shrug at small ones.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/loss/mse_loss.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 13 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_TARGETS : [3]u8 = [1, 2, 3];
pub const K_P_LO_C : i16 = -100;
pub const K_P_HI_C : u16 = 500;
pub const K_P_TICKS : [7]i8 = [-1, 0, 1, 2, 3, 4, 5];
pub const K_LOSS_HI_C : u16 = 600;
pub const K_LOSS_TICKS : [4]u8 = [0, 2, 4, 6];
pub const K_PRESET_P0_C : [4]i16 = [150, 100, 300, -100];
pub const K_PRESET_P1_C : [4]u16 = [200, 200, 200, 400];
pub const K_PRESET_P2_C : [4]u16 = [200, 300, 300, 100];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["1.5, 2, 2", "On target", "One miss of 2", "All wrong"];
pub const SAY_ASK : str = "How wrong is a guess, as one number?";
pub const SAY_PRED : str = "prediction";
pub const SAY_TARGET : str = "target";
pub const SAY_GRAD : str = "minus the gradient";
pub const SAY_MISS_LABEL : str = "Each prediction, its target and the step the gradient asks for";
pub const SAY_BOWL_LABEL : str = "The loss as prediction 0 moves, the others held";
pub const SAY_BOWL : str = "Drag along the bowl: the loss as prediction 0 alone moves.";
pub const SAY_LOSS : str = "loss";
pub const SAY_GRADS : str = "gradients";
pub const SAY_AT_TARGET : str = "loss on target";
pub const SAY_DOUBLE : str = "miss of 1 / of 2";
pub const SAY_NOTE : str = "The gradient of each prediction is 2 (p - t) / n: the further off, the harder the pull. Gradient descent follows it downhill into the bottom of the bowl.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/loss/mse_loss.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_targets_are_the_spec_fixture {
    assert K_TARGETS[0] == 1;
    assert K_TARGETS[1] == 2;
    assert K_TARGETS[2] == 3;
}

test the_presets_stay_in_range {
    assert K_PRESET_P0_C[3] >= K_P_LO_C;
    assert K_PRESET_P1_C[3] <= K_P_HI_C;
    assert K_PRESET_P0_C[1] == K_TARGETS[0] * 100;
}
