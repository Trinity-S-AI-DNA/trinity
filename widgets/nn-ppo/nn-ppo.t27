// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-ppo.t27 -- PPO's clipped surrogate: a reward that stops pulling
; Source of truth for public/widgets/nn-ppo/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-ppo/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/rl/ppo_clip_loss.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 27 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader drags r from 0 to 2 and sets the advantage A from -2 to 2 and eps from
; 0.05 to 0.5. The green curve is clipped_surrogate(r, A, eps), the dashed one clipped_surrogate(r,
; A, 1000), which never clips here, and the tiles policy_loss_of on the spec's advantages (2, 1.5,
; 3).

; WHAT IT DOES NOT CLAIM: the objective of one sample; PPO averages it over a batch, adds value and
; entropy terms (total_loss in the spec) and runs it for a few epochs per batch.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_ppo;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-ppo";
pub const TITLE : str = "PPO: how an agent learns from reward without lurching";
pub const DESCRIPTION : str = "Drag the probability ratio of a new policy over the old: PPO's objective follows r times the advantage until r moves more than eps the rewarded way, then it goes flat and stops pulling.";
pub const IMAGE_ALT : str = "PPO card at r = 1.5, A = 1, eps 0.2: the dashed gold raw objective is a straight line through the origin; the thick green clipped one follows it and turns flat at 1.2 from r = 1.2 on. Tiles read clipped 1.2000, raw 1.5000, the spec batch policy loss -2.1167 and the same batch at r = 1.5, -2.6000.";
pub const HOOK : str = "At r = 1.5 with advantage 1 and eps 0.2, the raw objective is 1.5 but PPO counts only 1.2. The clip is what keeps one update from breaking the policy.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/rl/ppo_clip_loss.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 27 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_R_HI_C : u16 = 200;
pub const K_A_LO_C : i16 = -200;
pub const K_A_HI_C : u16 = 200;
pub const K_EPS_LO_C : u8 = 5;
pub const K_EPS_HI_C : u8 = 50;
pub const K_WIDE : u16 = 1000;
pub const K_Y_LO : i8 = -4;
pub const K_Y_HI : u8 = 4;
pub const K_Y_TICKS : [5]i8 = [-4, -2, 0, 2, 4];
pub const K_R_TICKS_C : [5]u8 = [0, 50, 100, 150, 200];
pub const K_BATCH_R_C : [3]u8 = [100, 110, 90];
pub const K_PRESET_R_C : [4]u8 = [150, 50, 150, 80];
pub const K_PRESET_A_C : [4]i16 = [100, -100, 200, -200];
pub const K_PRESET_EPS_C : [4]u8 = [20, 20, 50, 10];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["r 1.5, A 1", "r 0.5, A -1", "r 1.5, A 2, eps 0.5", "r 0.8, A -2, eps 0.1"];
pub const SAY_ASK : str = "How does an agent learn from reward without lurching?";
pub const SAY_R : str = "ratio r = new / old";
pub const SAY_A : str = "advantage A";
pub const SAY_EPS : str = "clip eps";
pub const SAY_PLOT_LABEL : str = "PPO's clipped objective and the raw r A as the ratio goes from 0 to 2";
pub const SAY_CLIPPED : str = "PPO objective";
pub const SAY_RAW : str = "raw r A";
pub const SAY_BATCH : str = "spec batch loss";
pub const SAY_BATCH_FAR : str = "same batch at r";
pub const SAY_NOTE : str = "A positive advantage says the action was better than expected, so raise its probability; past 1 + eps there is no more credit for it. A negative one is clipped at 1 - eps the same way.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/rl/ppo_clip_loss.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_wide_clip_never_clips_the_window {
    assert K_WIDE * 100 > K_R_HI_C;
    assert K_EPS_HI_C < 100;
}

test the_presets_stay_in_range {
    assert K_PRESET_R_C[0] <= K_R_HI_C;
    assert K_PRESET_A_C[3] == K_A_LO_C;
    assert K_PRESET_EPS_C[3] >= K_EPS_LO_C;
    assert K_BATCH_R_C[0] == 100;
}
