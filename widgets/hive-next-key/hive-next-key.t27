// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-next-key.t27 -- The next key: a bee moves on instead of dying
; Source of truth for public/widgets/hive-next-key/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-next-key/logic.js -- the fn
; bodies of gHashTag/t27 specs/queen/key_failover.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 18 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader sets the pool size, taps keys between free, tried and resting, and sets
; the attempts and how many keys answered 1305. The ring is next_free(tried, resting, size, last);
; the verdict is step(transient, attempts, that key, 1305 keys, size, the next pool) with
; pool_overloaded beside it.

; WHAT IT DOES NOT CLAIM:  it holds no key: the pool is a picture of masks, bit i is key i + 1.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_next_key;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-next-key";
pub const TITLE : str = "The next key: a bee moves on instead of dying";
pub const DESCRIPTION : str = "A pool of keys, some tried, some resting. Tap keys to change them: next_free picks the next one after the last, and step says next key, next pool or give up.";
pub const IMAGE_ALT : str = "Next key card: a pool of 10 keys, key 9 just failed with a 1305 and is tried, keys 10 and 1 rest in red, the others are green. Key 2 has a white ring: next_free picked it. The verdict reads NEXT KEY at attempt 2 of 8.";
pub const HOOK : str = "Measured 2026-10-17: a bee died 7 s into its turn on key 9 of 10 while 33 keys stood by. Now it tries the next free key, never the one that failed.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/queen/key_failover.t27 (t27 master c42f8fb40): every value on the page is next_free, pool_overloaded and step, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 18 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_SIZE_MAX : u8 = 12;
pub const K_KE_TRANSIENT : u8 = 1;
pub const K_ATTEMPTS_MAX : u8 = 9;
pub const K_OVERLOAD_MAX : u8 = 5;
pub const K_NO_KEY : u32 = 255;
pub const K_POOL_OVERLOAD_KEYS : u32 = 3;
pub const K_MAX_ATTEMPTS_PER_TURN : u32 = 8;
pub const K_PRESET_SIZE : [4]u8 = [10, 10, 10, 4];
pub const K_PRESET_LAST : [4]u8 = [8, 8, 3, 0];
pub const K_PRESET_TRIED : [4]u16 = [256, 256, 1023, 1];
pub const K_PRESET_RESTING : [4]u16 = [513, 513, 0, 14];
pub const K_PRESET_ATTEMPTS : [4]u8 = [2, 4, 8, 2];
pub const K_PRESET_OVERLOAD : [4]u8 = [1, 3, 1, 1];
pub const K_START_PRESET : u8 = 0;
; The pool list the bee falls back on: two pools, this one (pool 0) tried, none resting, this one
; failed last. next_free of it names the next pool.
pub const K_POOL_LIST_TRIED : u8 = 1;
pub const K_POOL_LIST_RESTING : u8 = 0;
pub const K_POOL_LIST_SIZE : u8 = 2;
pub const K_POOL_LIST_LAST : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["Key 9 of 10 failed", "Three keys said 1305", "Every key tried", "A small pool"];
pub const SAY_ASK : str = "A bee's key was refused mid-task. Which key does it try next?";
pub const SAY_SIZE : str = "keys in the pool";
pub const SAY_ATTEMPTS : str = "attempts this turn";
pub const SAY_OVERLOAD : str = "keys that answered 1305 in the last minute";
pub const SAY_KEY_STATES : [3]str = ["free", "tried", "resting"];
pub const SAY_TAP : str = "tap a key: free, tried, resting";
pub const SAY_LAST : str = "failed last";
pub const SAY_STEP_NAMES : [5]str = ["DONE", "NEXT KEY", "NEXT POOL", "GIVE UP", "FAIL"];
pub const SAY_NEXT : str = "next key";
pub const SAY_NONE : str = "none left";
pub const SAY_POOL_OUT : str = "pool overloaded";
pub const SAY_YES : str = "yes";
pub const SAY_NO : str = "no";
pub const SAY_NOTE : str = "1305 is an overload of the pool's model, not of one key: once 3 distinct keys said it within a minute, the bee moves to the next pool instead of burning the rest. At 8 attempts the turn ends, and its claim is released.";
pub const SAY_SOURCE : str = "Logic: t27 spec queen/key_failover.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_bounds_are_the_specs {
    assert K_NO_KEY == 255;
    assert K_POOL_OVERLOAD_KEYS == 3;
    assert K_MAX_ATTEMPTS_PER_TURN == 8;
}

test the_pool_list_has_this_pool_tried {
    assert K_POOL_LIST_SIZE == 2;
    assert K_POOL_LIST_TRIED == 1;
    assert K_POOL_LIST_LAST < K_POOL_LIST_SIZE;
}

test the_start_pool_is_ten_keys {
    assert K_PRESET_SIZE[0] == 10;
    assert K_PRESET_LAST[0] < K_PRESET_SIZE[0];
    assert K_PRESET_TRIED[0] == 256;
}
