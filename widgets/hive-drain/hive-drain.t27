// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-drain.t27 -- A deploy mid-flight: what happens to a running bee
; Source of truth for public/widgets/hive-drain/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-drain/logic.js -- the fn
; bodies of gHashTag/t27 specs/queen/drain.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 9 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader drags the seconds waited, marks the work ended or not, and sets the
; platform drain. The cap is drain_cap_seconds(runner 1800, platform); each of the five kinds is
; drain_verdict(kind, ended, waited, cap).

; WHAT IT DOES NOT CLAIM:  the runner drain of 1800 s is the value the spec names for today; the
; page sends no signal.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_drain;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-drain";
pub const TITLE : str = "A deploy mid-flight: what happens to a running bee";
pub const DESCRIPTION : str = "The Queen is redeployed while work runs. Drag how long the drain has waited: a bee is held to the cap and then handed back, a review is stopped, a round and a job are left to the store.";
pub const IMAGE_ALT : str = "Drain card at 1800 seconds of waiting, the cap. Five rows: bee HAND BACK in violet, review STOP in orange, round, job and wait LEAVE in sky blue. A violet meter shows 1800 of the 1800 s cap, the runner drain 1800 against the platform 1830.";
pub const HOOK : str = "A deploy does not cut a bee short: it is held up to the cap, then what it wrote is salvaged into its branch and its issue is free at once.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/queen/drain.t27 (t27 master c42f8fb40): every value on the page is drain_verdict and drain_cap_seconds, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 9 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_WAIT_MAX : u16 = 2400;
pub const K_WAIT_STEP : u8 = 60;
pub const K_RUNNER_DRAIN : u16 = 1800;
pub const K_PLATFORM_MAX : u16 = 3600;
pub const K_PLATFORM_STEP : u8 = 30;
pub const K_PRESET_WAIT : [4]u16 = [1800, 600, 60, 1800];
pub const K_PRESET_ENDED : [4]u8 = [0, 0, 1, 0];
pub const K_PRESET_PLATFORM : [4]u16 = [1830, 1830, 1830, 1000];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["At the cap", "Ten minutes in", "Work already ended", "A short platform drain"];
pub const SAY_ASK : str = "What happens to a bee halfway through its task when the Queen is redeployed?";
pub const SAY_WAIT : str = "seconds the drain has waited";
pub const SAY_ENDED : str = "the work already ended";
pub const SAY_PLATFORM : str = "platform drain, seconds";
pub const SAY_KIND_NAMES : [5]str = ["a bee", "a review", "a round", "a job step", "a wait row"];
pub const SAY_VERDICT_NAMES : [5]str = ["DONE", "LEAVE", "STOP", "HOLD", "HAND BACK"];
pub const SAY_VERDICT_LINES : [5]str = ["nothing is owed", "the store keeps it; the next process takes it up", "not waited for; stopped when the process exits", "the drain waits for it to end", "stopped, salvaged into its branch, its issue free now"];
pub const SAY_CAP : str = "cap, seconds";
pub const SAY_WAITED : str = "waited";
pub const SAY_NOTE : str = "A review is not held: a stop loses at most one review, which the next process redoes. A bee is held because what it has done lives in its conversation, which no row keeps.";
pub const SAY_SOURCE : str = "Logic: t27 spec queen/drain.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_slider_reaches_past_the_cap {
    assert K_WAIT_MAX > K_RUNNER_DRAIN;
    assert K_PRESET_WAIT[0] == K_RUNNER_DRAIN;
}

test the_platform_drain_is_in_range {
    assert K_PRESET_PLATFORM[0] <= K_PLATFORM_MAX;
    assert K_PRESET_PLATFORM[3] < K_RUNNER_DRAIN;
}
