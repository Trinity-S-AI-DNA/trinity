// SPDX-License-Identifier: Apache-2.0
; specs/widgets/test-waves.t27 -- test waves: a t27 spec's test block, simulated and drawn as waves
; Source of truth for public/widgets/test-waves/ (gHashTag/trinity, apps/website). The page is
; written by scripts/widget-pages-from-spec.mjs from this file; tool.js holds no English of its
; own and reads every word below from window.T27_WIDGET.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT DRAWS: a timing diagram of one real simulation. The vendored compiler
; (public/t27/t27_compiler.wasm, the one the X player runs) generates Verilog from
; specs/ternary/stream_ternary_mac.t27, a clocked ternary multiply-accumulate. The four vectors
; of that spec's own test blocks, assert_eq(dot27(a, b), d), are streamed into the generated
; module one per clock by scripts/widget-data/test-waves-tb.v under Icarus Verilog (iverilog,
; then vvp); after each edge acc must equal the running sum of the expected dot products. Two
; more checks read the generated RTL: en low holds acc, and rst_n low clears it at once.

; PROVENANCE: scripts/widget-data/test-waves.mjs runs the whole chain and writes demo.vcd, the
; VCD exactly as vvp dumped it, and demo.json: the spec and compiler sha256, the iverilog and
; vvp versions, the exact commands, and the pass or fail of every check. The tool shows all of
; it under the diagram, so a number on the screen can be traced to the command that made it.

; WHAT IT DOES NOT CLAIM: that the module was placed, routed or run on a board; this is a
; simulation of generated RTL. That every t27 spec simulates: many generated modules are refused
; by iverilog today (one calls an undeclared cast(), t27#6100), and this one was picked because
; it is accepted and its tests carry vectors. The VCD parser here is small and reads the common
; subset (scalars, vectors, reals as text); a file outside it is refused with a reason, not
; guessed at. A dropped file is read with FileReader in the reader's browser and sent nowhere.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_test_waves;

pub const KIND : str = "widget-tool";
pub const ID : str = "test-waves";
pub const TITLE : str = "Test waves: a t27 spec's tests, simulated and drawn as waves";
pub const DESCRIPTION : str = "Verilog generated from a ternary MAC spec, driven by the spec's own test vectors under Icarus Verilog: clock, buses, pass marks. Drop a .vcd and it draws yours.";
pub const IMAGE_ALT : str = "A timing diagram on black: clk, rst_n, en, the 64-bit buses a and b as labelled hex segments, the 32-bit accumulator acc and the expected sum, with six green pass marks along the bottom, from an Icarus Verilog run of Verilog that t27 generated from stream_ternary_mac.t27.";
pub const HOOK : str = "A spec's test block, run as gates and drawn as waves: every edge is from a real simulation, and your own .vcd opens in the same view.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [4]str = ["specs/ternary/stream_ternary_mac.t27, its four test blocks (vendored at public/t27/files/specs/)", "public/t27/t27_compiler.wasm, verilog target: module StreamTernaryMac", "scripts/widget-data/test-waves-tb.v and test-waves.mjs, run under Icarus Verilog (iverilog, vvp); versions and sha256 in demo.json", "A .vcd file the reader drops or picks: read in the browser with FileReader, never uploaded"];
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- What the tool reads and how big it draws ---------------------------------------------------
pub const K_DEMO_VCD : str = "demo.vcd";
pub const K_DEMO_JSON : str = "demo.json";
; A touch target is at least this many CSS pixels on a side; a row of the diagram is one.
pub const K_MIN_TARGET_PX : u8 = 32;
pub const K_ROW_PX : u8 = 36;
pub const K_AXIS_PX : u8 = 26;
pub const K_CHECKS_PX : u8 = 34;
; Signals past this many are not drawn, and the status line says so.
pub const K_MAX_SIGNALS : u16 = 400;
; A dropped file larger than this is refused before it is read.
pub const K_MAX_FILE_MB : u16 = 64;
; Zoom limit: one VCD time unit is never wider than this many pixels.
pub const K_MAX_PX_PER_UNIT : u16 = 400;

; --- Every word on the screen -------------------------------------------------------------------
pub const SAY_DEMO : str = "Demo";
pub const SAY_DEMO_TITLE : str = "Back to the simulated spec";
pub const SAY_ZOOM_IN : str = "Zoom in";
pub const SAY_ZOOM_OUT : str = "Zoom out";
pub const SAY_FIT : str = "Fit";
pub const SAY_FIT_TITLE : str = "Show the whole run";
pub const SAY_DROP : str = "Drop a .vcd file here, or tap to pick one. It is read in this browser and sent nowhere.";
pub const SAY_DROP_SHORT : str = "Open a .vcd";
pub const SAY_CANVAS_LABEL : str = "Timing diagram. Drag to pan, pinch or Ctrl and wheel to zoom, tap or hover for the values at a time.";
pub const SAY_HINT : str = "drag: pan / pinch or ctrl+wheel: zoom / tap or hover: values";
pub const SAY_LOADING : str = "Reading the simulation...";
pub const SAY_READING_FILE : str = "Reading {name}...";
pub const SAY_ERR_DEMO : str = "The demo simulation did not load: {why}";
pub const SAY_ERR_VCD : str = "{name} is not a VCD this tool reads: {why}";
pub const SAY_ERR_TOO_BIG : str = "{name} is {mb} MB; this tool reads files up to {max} MB.";
pub const SAY_ERR_NO_SIGNALS : str = "no signal ever changes value";
pub const SAY_ERR_NO_DEFS : str = "no $enddefinitions";
pub const SAY_ERR_NO_TIMESCALE : str = "the $timescale is missing or unreadable";
pub const SAY_ERR_BAD_TOKEN : str = "cannot read \"{token}\" after time {t}";
pub const SAY_DEMO_SOURCE : str = "{spec} -> Verilog ({module}) by t27_compiler.wasm -> {iverilog}";
pub const SAY_FILE_SOURCE : str = "{name}: {signals} signals over {span}, read in this browser";
pub const SAY_TRUNCATED : str = "Showing the first {shown} of {total} signals.";
pub const SAY_CHECKS_SUMMARY : str = "{pass} of {total} checks pass ({spec_pass} of {spec_total} spec tests)";
pub const SAY_CHECKS_ROW : str = "checks";
pub const SAY_PASS : str = "pass";
pub const SAY_FAIL : str = "fail";
pub const SAY_FROM_SPEC : str = "spec test";
pub const SAY_FROM_TB : str = "testbench check";
pub const SAY_CHECK_LINE : str = "{name} ({source}): {verdict} at {t}, acc = {acc}, expected {expected}";
pub const SAY_SIGNAL_LINE : str = "{name} [{width} bit] = {value} at {t}";
pub const SAY_CURSOR : str = "t = {t}";
pub const SAY_PROVENANCE : str = "How this run was made";
pub const SAY_PROV_KEYS : [8]str = ["spec", "spec sha256", "compiler", "compiler sha256", "generated Verilog sha256", "testbench", "iverilog", "vvp"];
pub const SAY_COMMANDS : str = "Commands";
pub const SAY_VECTORS : str = "Vectors from the spec's test blocks";
pub const SAY_TIME_UNITS : [6]str = ["s", "ms", "us", "ns", "ps", "fs"];

; --- Tests ------------------------------------------------------------------------------------
test a_row_is_a_touch_target {
    assert K_ROW_PX >= K_MIN_TARGET_PX;
    assert K_CHECKS_PX >= K_MIN_TARGET_PX;
    assert K_MIN_TARGET_PX == 32;
}

test the_tool_reads_files_and_sends_nothing {
    assert READS_LOCAL_FILES == true;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
}

test the_demo_is_the_simulated_spec {
    assert K_DEMO_VCD == "demo.vcd";
    assert K_DEMO_JSON == "demo.json";
    assert ID == "test-waves";
}

test the_limits_are_bounded {
    assert K_MAX_SIGNALS > 0;
    assert K_MAX_FILE_MB <= 256;
    assert K_MAX_PX_PER_UNIT > 0;
}

test time_units_run_from_seconds_down {
    assert SAY_TIME_UNITS[0] == "s";
    assert SAY_TIME_UNITS[3] == "ns";
    assert SAY_TIME_UNITS[5] == "fs";
}
