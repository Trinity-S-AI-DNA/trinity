// SPDX-License-Identifier: Apache-2.0
; specs/widgets/fft-scaling.t27 -- growth through the stages: FFT word widths, unscaled and halved every stage
; Source of truth for public/widgets/fft-scaling/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/fft-scaling/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 24 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader picks a size (8 to 256 points), an input width, an input and whether every
; stage halves its outputs. The spec runs the integer FFT and bars give the bits the largest value needs
; after every stage, against the input word and the conservative unscaled width B + log2 N + 1.

; WHAT IT DOES NOT CLAIM: halving is the simplest scaling schedule; block floating point and other schedules are not modelled.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_fft_scaling;

pub const KIND : str = "widget-tool";
pub const ID : str = "fft-scaling";
pub const TITLE : str = "FFT word growth: how many bits each stage adds";
pub const DESCRIPTION : str = "Pick a size, an input width and an input, with or without halving every stage. Watch the bits each stage needs grow, and what scaling holds back and what it costs.";
pub const IMAGE_ALT : str = "FFT scaling card: a 16-point FFT of a full-scale 12-bit DC input. Unscaled, each stage needs one more bit, 16 at the end against the 17 of the PG109 rule; halving every stage holds it at 12.";
pub const HOOK : str = "A full-scale DC input grows one bit per stage: 12 bits in, 16 out of a 16-point FFT. Halve every stage and it stays at 12, but a spread signal loses bits.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "AMD (Xilinx) PG109, Fast Fourier Transform LogiCORE IP Product Guide: unscaled output width = input width + log2(points) + 1", "J. W. Cooley, J. W. Tukey, An algorithm for the machine calculation of complex Fourier series, Math. Comp. 19, 1965"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_LENGTHS : [6]u16 = [8, 16, 32, 64, 128, 256];
pub const K_MIN_BITS : u8 = 4;
pub const K_MAX_BITS : u8 = 16;
pub const K_PAT_DC : u8 = 0;
pub const K_PAT_NOISE : u8 = 3;
pub const K_PRESET_LEN : [4]u8 = [1, 1, 1, 5];
pub const K_PRESET_BITS : [4]u8 = [12, 12, 12, 16];
pub const K_PRESET_PATTERN : [4]u8 = [0, 0, 3, 1];
pub const K_PRESET_SCALED : [4]u8 = [0, 1, 1, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["16 points, DC, unscaled", "DC, halved each stage", "noise, halved each stage", "256 points, cosine, unscaled"];
pub const SAY_LEN : str = "Points N";
pub const SAY_BITS : str = "Input bits B";
pub const SAY_PATTERN : str = "Input";
pub const SAY_PATTERNS : [4]str = ["DC, full scale", "one cycle of cosine", "alternating +-max", "LFSR noise"];
pub const SAY_SCALING : str = "Scaling";
pub const SAY_SCALINGS : [2]str = ["none", "halve every stage"];
pub const SAY_GROW_LABEL : str = "Bits the largest value needs after every stage";
pub const SAY_INPUT_LABEL : str = "The input samples";
pub const SAY_STAGE_AXIS : str = "stage";
pub const SAY_BITS_AXIS : str = "bits";
pub const SAY_INPUT_AXIS : str = "input sample";
pub const SAY_RULE_LINE : str = "B + log2 N + 1 = {0}";
pub const SAY_WORD_LINE : str = "input word {0}";
pub const SAY_NOTE : str = "Unscaled, a coherent input grows a bit per stage. Halving holds the word but throws a bit of a spread signal away at every stage.";
pub const SAY_RULE : str = "unscaled rule";
pub const SAY_NEEDED : str = "needed at the end";
pub const SAY_PEAK : str = "largest output";
pub const SAY_STATE : str = "the word";
pub const SAY_BITS_N : str = "{0} bits";
pub const SAY_OVERFLOW : str = "overflows";
pub const SAY_HELD : str = "held";
pub const SAY_GROWS : str = "grows";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/signals.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_presets_compare_scaling {
    assert K_PRESET_SCALED[0] == 0;
    assert K_PRESET_SCALED[1] == 1;
    assert K_PRESET_PATTERN[0] == K_PAT_DC;
    assert K_PRESET_PATTERN[2] == K_PAT_NOISE;
}

test the_widths_fit_the_spec {
    assert K_LENGTHS[5] == 256;
    assert K_MAX_BITS == 16;
    assert K_MIN_BITS == 4;
    assert K_PRESET_BITS[3] <= K_MAX_BITS;
}
