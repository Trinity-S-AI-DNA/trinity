// SPDX-License-Identifier: Apache-2.0
; specs/widgets/placement-map.t27 -- where nextpnr placed every cell of a design on the XC7A200T die
; Source of truth for public/widgets/placement-map/ (gHashTag/trinity, apps/website). The page is
; written by scripts/widget-pages-from-spec.mjs from this file and hands every constant below to
; tool.js as window.T27_WIDGET. tool.js holds no English of its own: every word on screen is a
; SAY_ constant here, every number the tool relies on is a K_ constant.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: draws the XC7A200T die as its tile columns (CLB, block RAM, DSP, IO, clock) and
; puts a dot on the site nextpnr-xilinx bound each cell to, coloured by kind: LUT, FF, CARRY4,
; BRAM, DSP, IO, BUFG. Hover or tap a dot for the cell's name, type and BEL. Drag to pan, wheel
; or pinch to zoom; "whole die" and "fit design" reset the view. Drop a routed nextpnr-xilinx JSON
; (the file --write writes) and it draws that design instead; the file is read in the browser
; with FileReader and sent nowhere.

; DATA PROVENANCE: placement.json is written by scripts/widget-data/fpga-pnr.py from one real run
; made on 2026-10-04: trinity_v3_jtaguart.v and jtaguart.xdc from gHashTag/trinity-fpga
; fpga/openxc7-synth at de4ebda367, synthesised by yosys 0.67+post (b8e7da6f40, synth_xilinx
; -flatten -abc9 -arch xc7) and placed and routed by nextpnr-xilinx 0.9.2-107-g7037c948 on the
; xc7a200tfbg676-1 chipdb with --freq 50 --seed 1; the exact commands and sha256 of the inputs
; ship in placement.json. The bench board's XC7A200T-FGG676 has the same die and pinout
; (t27 fpga/HARDWARE_SSOT.md). The design has 373 cells: 239 LUT, 98 FF, 23 CARRY4, 5 pads with
; 5 IO buffers, 1 BUFGCTRL and nextpnr's two constant drivers; its logic sits in 60 slices.
; The die drawing (tile columns, and which tile row and column each site index lands in) comes
; from prjxray-db 517d66a383 artix7/xc7a200t/tilegrid.json; fpga-pnr.py refuses to write it if a
; site index maps to two grid lines. The slice count 33650 is the chipdb's CARRY4 BEL count and
; equals prjxray's SLICE site count, as does 8 LUT BELs per slice (269200), and both agree with
; AMD DS180 (7 Series Product Selection Guide): 33,650 slices, 134,600 six-input LUTs.

; WHAT IT DOES NOT CLAIM: that the design was flashed or met timing on a board here; that is the
; slack-waterfall widget's question, and this is a placement only. The die drawing is the
; XC7A200T's: a dropped file from any other part is drawn on it only where its site names fall
; inside the 200T's ranges, and every cell it cannot place is listed instead of guessed at. Wires
; are not drawn. nextpnr's constant drivers sit on virtual NULL sites and are listed, not drawn.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_placement_map;

pub const KIND : str = "widget-tool";
pub const ID : str = "placement-map";
pub const TITLE : str = "Placement map: where nextpnr put every cell on the XC7A200T";
pub const DESCRIPTION : str = "Every LUT, FF, CARRY4, IO and clock buffer of a real nextpnr-xilinx run, drawn on its site of the Artix-7 200T die. Drop your routed JSON and it draws yours.";
pub const IMAGE_ALT : str = "A dark map of the XC7A200T die in tile columns, with a gold box around the left edge where the design sits, and the same corner enlarged beside it: green LUTs, gold flip-flops and blue carry chains in a few slices next to the IO column. Headline: 60 of 33,650 slices.";
pub const HOOK : str = "A 373-cell design on a 33,650-slice die: see exactly which sites nextpnr picked, then drop your own routed JSON.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [5]str = ["gHashTag/trinity-fpga de4ebda367: fpga/openxc7-synth/trinity_v3_jtaguart.v and jtaguart.xdc", "yosys 0.67+post (b8e7da6f40) synth_xilinx, then nextpnr-xilinx 0.9.2-107-g7037c948 --chipdb xc7a200tfbg676-1.bin --freq 50 --seed 1 --write routed.json", "prjxray-db 517d66a383 artix7/xc7a200t/tilegrid.json: tile columns and site-to-grid maps", "scripts/widget-data/fpga-pnr.py: placement.json, commands and input sha256 inside it", "A routed nextpnr-xilinx JSON the reader drops or picks: read in the browser with FileReader, never uploaded"];
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- Numbers the tool relies on ------------------------------------------------------------
pub const K_DATA_FILE : str = "placement.json";
; Cell kinds in drawing order, and the colour each is drawn in.
pub const K_KINDS : [8]str = ["LUT", "FF", "CARRY4", "BRAM", "DSP", "IO", "BUFG", "OTHER"];
pub const K_KIND_COLORS : [8]str = ["#00ff88", "#ffd700", "#00b4ff", "#be78ff", "#ff8c3c", "#ff4d6d", "#ffffff", "#8a8a8a"];
; A cell type is of kind K_TYPE_KIND[i] when it starts with K_TYPE_PREFIX[i]; first match wins.
pub const K_TYPE_PREFIX : [11]str = ["SLICE_LUTX", "SLICE_FFX", "CARRY4", "RAMB", "FIFO", "DSP48", "IOB", "PAD", "OBUF", "IBUF", "BUFG"];
pub const K_TYPE_KIND : [11]str = ["LUT", "FF", "CARRY4", "BRAM", "BRAM", "DSP", "IO", "IO", "IO", "IO", "BUFG"];
; Tile families drawn as the die, and their fill.
pub const K_TILES : [9]str = ["clbll", "clblm", "bram", "dsp", "iob", "bufg", "cmt", "gtp", "pcie"];
pub const K_TILE_COLORS : [9]str = ["#0f1e18", "#13261e", "#281a38", "#342210", "#32141c", "#3c3c3c", "#1e1e1e", "#1a1a28", "#1a1a28"];
; Site families the dropped file's BEL names are looked up in (placement.json geometry.maps).
pub const K_SITE_FAMILIES : [6]str = ["SLICE", "RAMB36", "RAMB18", "DSP48", "IOB", "BUFGCTRL"];
; XC7A200T: 265 x 261 tile grid (prjxray tilegrid), 33650 slices (chipdb CARRY4 BELs, DS180).
pub const K_GRID_W : u16 = 265;
pub const K_GRID_H : u16 = 261;
pub const K_SLICES : u32 = 33650;
pub const K_LUT_BELS : u32 = 269200;
pub const K_LUT6 : u32 = 134600;
; Interaction: touch targets and the pick radius around a dot, in CSS pixels.
pub const K_MIN_TARGET_PX : u8 = 32;
pub const K_PICK_PX : u8 = 14;
pub const K_MAX_ZOOM : u8 = 80;
pub const K_MAX_FILE_MB : u16 = 512;

; --- Words on screen ------------------------------------------------------------------------
; Templates take {0}, {1}, ... in order.
pub const SAY_WHOLE_DIE : str = "Whole die";
pub const SAY_FIT_DESIGN : str = "Fit design";
pub const SAY_DEMO : str = "Demo design";
pub const SAY_DROP : str = "Drop a routed nextpnr-xilinx JSON here, or tap to pick one. It is read in this browser and sent nowhere.";
pub const SAY_CANVAS_LABEL : str = "Map of the XC7A200T die with every placed cell as a coloured dot. Drag to pan, wheel or pinch to zoom, hover or tap a dot for its name, type and BEL.";
pub const SAY_HINT : str = "drag: pan / wheel or pinch: zoom / hover or tap: cell";
pub const SAY_LOADING : str = "Loading the placement...";
pub const SAY_READING : str = "Reading {0}...";
pub const SAY_SUMMARY : str = "{0}: {1} cells placed in {2} of {3} slices";
pub const SAY_SOURCE_DEMO : str = "{0} on {1}, placed by {2}";
pub const SAY_SOURCE_FILE : str = "{0} ({1} bytes), {2}";
pub const SAY_PICK_NONE : str = "Hover or tap a dot.";
pub const SAY_PICK_LINE : str = "{0} cells at this site";
pub const SAY_FIELDS : [3]str = ["cell", "type", "BEL"];
pub const SAY_OFF_MAP : str = "Not drawn ({0}): site outside the XC7A200T map or a virtual site";
pub const SAY_ERR_JSON : str = "{0} is not JSON.";
pub const SAY_ERR_NO_BELS : str = "{0} has no placed cells: no NEXTPNR_BEL attributes. Use the JSON nextpnr writes with --write after routing.";
pub const SAY_ERR_SIZE : str = "{0} is larger than {1} MB.";
pub const SAY_ERR_DEMO : str = "The demo placement did not load.";
pub const SAY_COMMANDS : str = "How this was made";

; --- Tests ----------------------------------------------------------------------------------
test the_die_counts_agree_with_each_other {
    assert K_LUT_BELS == 8 * K_SLICES;
    assert K_LUT6 == 4 * K_SLICES;
    assert K_LUT6 == 134600;
}

test every_type_prefix_has_a_kind_that_is_drawn {
    assert K_TYPE_KIND[0] == K_KINDS[0];
    assert K_TYPE_KIND[1] == K_KINDS[1];
    assert K_TYPE_KIND[2] == K_KINDS[2];
    assert K_TYPE_KIND[3] == K_KINDS[3];
    assert K_TYPE_KIND[5] == K_KINDS[4];
    assert K_TYPE_KIND[6] == K_KINDS[5];
    assert K_TYPE_KIND[10] == K_KINDS[6];
}

test the_touch_targets_are_big_enough {
    assert K_MIN_TARGET_PX >= 32;
    assert K_PICK_PX * 2 >= K_MIN_TARGET_PX - 4;
    assert K_GRID_W * K_GRID_H == 69165;
}

test the_page_reads_files_and_sends_nothing {
    assert READS_LOCAL_FILES == true;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
}
