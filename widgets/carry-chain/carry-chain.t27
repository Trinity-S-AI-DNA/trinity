// SPDX-License-Identifier: Apache-2.0
; specs/widgets/carry-chain.t27 -- the carry chain: a + b bit by bit, and the dedicated chain against LUTs
; Source of truth for public/widgets/carry-chain/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/carry-chain/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/adders.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 1 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader taps the bits of a and b (up to 32 bits) and sees, per bit, whether it
; generates, propagates or kills a carry, the carry out of every bit with the longest run lit, the sum,
; and the CARRY4 blocks the chain fills. A second drawing compares the delay of a carry recomputed by a LUT
; in every bit with the dedicated chain, from the three delays the reader sets.

; WHAT IT DOES NOT CLAIM: device timing. The three delays are the reader's; the defaults are illustrative, not a datasheet.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_carry_chain;

pub const KIND : str = "widget-tool";
pub const ID : str = "carry-chain";
pub const TITLE : str = "The carry chain: why adding is slow, and how a slice makes it fast";
pub const DESCRIPTION : str = "Tap the bits of two numbers and watch the carry run up the word. Then set three delays and see what the dedicated carry chain saves over LUTs.";
pub const IMAGE_ALT : str = "Carry chain card: 127 + 1 on 8 bits. Bit 0 generates a carry, bits 1 to 6 propagate it, and the lit chain of 7 carries is the delay the top bit waits for. Below, the dedicated chain is several times faster than a carry routed through LUTs.";
pub const HOOK : str = "127 + 1 makes a carry travel 7 bits. A slice's carry chain makes that walk cheap: one hop per bit, no routing.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/dsp/adders.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Xilinx UG474, 7 Series FPGAs CLB User Guide: carry logic, one CARRY4 of 4 bits per slice", "Harris and Harris, Digital Design and Computer Architecture, ch. 5: ripple-carry adders"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_MIN_BITS : u8 = 4;
pub const K_MAX_BITS : u8 = 32;
pub const K_CARRY4_BITS : u8 = 4;
pub const K_MIN_PS : u16 = 10;
pub const K_MAX_PS : u16 = 1000;
pub const K_PRESET_BITS : [4]u8 = [8, 8, 8, 32];
pub const K_PRESET_A : [4]u32 = [127, 255, 85, 4294967295];
pub const K_PRESET_B : [4]u32 = [1, 1, 170, 1];
pub const K_PRESET_LUT_PS : [4]u16 = [120, 120, 120, 120];
pub const K_PRESET_ROUTE_PS : [4]u16 = [300, 300, 300, 300];
pub const K_PRESET_HOP_PS : [4]u16 = [30, 30, 30, 30];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["127 + 1: a 7-bit run", "255 + 1: out of the top", "85 + 170: no carry at all", "32 bits, the worst case"];
pub const SAY_BITS : str = "Width, bits";
pub const SAY_LUT : str = "LUT delay, ps";
pub const SAY_ROUTE : str = "Route between LUTs, ps";
pub const SAY_HOP : str = "Carry hop per bit, ps";
pub const SAY_TAP : str = "Tap a bit of a or b to flip it. Gold: the carry out of each bit; magenta: the longest run.";
pub const SAY_GRID_LABEL : str = "The bits of a and b, the role of each bit, the carry out of each bit and the sum";
pub const SAY_TIMING_LABEL : str = "Delay of the top carry: recomputed in LUTs against the dedicated chain";
pub const SAY_ROW_A : str = "a";
pub const SAY_ROW_B : str = "b";
pub const SAY_ROW_ROLE : str = "role";
pub const SAY_ROW_CARRY : str = "carry";
pub const SAY_ROW_SUM : str = "sum";
pub const SAY_COUT : str = "out";
pub const SAY_ROLE_LETTERS : [3]str = ["K", "G", "P"];
pub const SAY_BLOCK : str = "CARRY4 #{0}";
pub const SAY_SUM : str = "a + b";
pub const SAY_RUN : str = "longest carry run";
pub const SAY_BITS_OF : str = "{0} of {1} bits";
pub const SAY_BLOCKS : str = "CARRY4 blocks";
pub const SAY_SPEEDUP : str = "chain against LUTs";
pub const SAY_RIPPLE : str = "carry in LUTs";
pub const SAY_CHAIN : str = "dedicated chain";
pub const SAY_PS : str = "delay to the top bit, ps";
pub const SAY_PS_VALUE : str = "{0} ps";
pub const SAY_ASSUMED : str = "G generates a carry (both bits 1), P propagates one (exactly one bit 1), K kills it. The delays are yours to set; the defaults are illustrative, not a datasheet.";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/adders.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_presets_show_a_run_a_wrap_and_none {
    assert K_PRESET_A[0] == 127;
    assert K_PRESET_B[0] == 1;
    assert K_PRESET_A[1] + K_PRESET_B[1] == 256;
    assert K_PRESET_A[2] + K_PRESET_B[2] == 255;
    assert K_PRESET_BITS[3] == K_MAX_BITS;
}

test a_slice_holds_four_bits {
    assert K_CARRY4_BITS == 4;
    assert K_MAX_BITS % K_CARRY4_BITS == 0;
    assert K_MIN_PS < K_PRESET_HOP_PS[0];
    assert K_PRESET_ROUTE_PS[0] <= K_MAX_PS;
}
