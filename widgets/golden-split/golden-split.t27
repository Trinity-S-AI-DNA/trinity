// SPDX-License-Identifier: Apache-2.0
; specs/widgets/golden-split.t27 -- the infographic of lesson 1 of the GoldenFloat course (specs/course/goldenfloat.t27)
; Source of truth for public/widgets/golden-split/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/numeric/goldenfloat_family.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_golden_split;

pub const KIND : str = "widget-tool";
pub const ID : str = "golden-split";
pub const TITLE : str = "GoldenFloat 1: one rule for every width";
pub const DESCRIPTION : str = "Five of the 17 GoldenFloat widths, read from goldenfloat_family.t27. Lesson 1 of the GoldenFloat course.";
pub const IMAGE_ALT : str = "A black and white table, Five of the 17 GoldenFloat widths: GF4, 1, 1, 2; GF8, 1, 3, 4; GF16, 1, 6, 9; GF32, 1, 12, 19; GF64, 1, 24, 39.";
pub const HOOK : str = "One rule picks the exponent of 17 float widths: round((N - 1) / phi^2).";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/numeric/goldenfloat_family.t27, read when the course was authored; every number in the table is a constant, a test value or arithmetic of that file", "Nothing on this page was measured on hardware or timed; a value written into a test is said to be written in, not computed"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Five of the 17 GoldenFloat widths";
pub const SAY_TABLE_HEAD : [4]str = ["Format", "Sign", "Exponent", "Mantissa"];
pub const SAY_TABLE_CELLS : [20]str = ["GF4", "1", "1", "2", "GF8", "1", "3", "4", "GF16", "1", "6", "9", "GF32", "1", "12", "19", "GF64", "1", "24", "39"];
pub const K_TABLE_COLS : u8 = 4;
pub const K_TABLE_ROWS : u8 = 5;
pub const K_TABLE_CELLS : u16 = 20;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "The rule";
pub const SAY_FLOW_STEPS : [3]str = ["N bits", "E = round((N - 1) / phi^2)", "M = N - 1 - E"];
pub const K_FLOW_STEPS : u8 = 3;
pub const SAY_NOTE : str = "Rows are read from GOLDEN_FLOAT_FAMILY in goldenfloat_family.t27, which lists 17 formats and marks GF16 primary.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 3;
    assert K_FLOW_STEPS > 1;
}
