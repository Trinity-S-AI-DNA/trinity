// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-encoder.t27 -- a transformer encoder block, post-norm and pre-norm
; Source of truth for public/widgets/nn-encoder/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-encoder/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/transformer/encoder_block.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 26 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader toggles post-norm and pre-norm. The output grid is block_at(pre, 0, i),
; the row means and variances block_at(pre, 1 or 2, row), and the attention grids attention_at(1,
; i): 3 positions, d_model 4, 2 heads, d_ff 8, the spec's weights.

; WHAT IT DOES NOT CLAIM: one block with the spec's fixed weights, not a trained model; a
; transformer stacks dozens.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_encoder;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-encoder";
pub const TITLE : str = "An encoder block: what one transformer layer does";
pub const DESCRIPTION : str = "Three positions through one transformer block: attention, a residual, a feed-forward net and layer norm. Post-norm ends every row at mean 0 and variance 1; pre-norm does not.";
pub const IMAGE_ALT : str = "Encoder card, post-norm: a 3 x 4 output grid in pink and green, every row centred on 0. Tiles read row means 0.000 0.000 0.000 and variances 1.000 1.000 1.000. Below, two 3 x 3 attention grids of the block, head 0 row 0 reading 0.401 0.198 0.401.";
pub const HOOK : str = "Post-norm rows come out at mean 0 and variance 1.000; pre-norm rows at variances 2.73, 3.33 and 0.96, because its last step is a residual add.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/transformer/encoder_block.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 26 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_SEQ : u8 = 3;
pub const K_D_MODEL : u8 = 4;
pub const K_HEADS : u8 = 2;
pub const K_PRESET_PRE : [2]u8 = [0, 1];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [2]str = ["Post-norm", "Pre-norm"];
pub const SAY_ASK : str = "What does one layer of a transformer actually do to its input?";
pub const SAY_PRE_NORM : str = "pre-norm";
pub const SAY_HEAD : str = "head";
pub const SAY_POS : str = "pos";
pub const SAY_DIM : str = "dim";
pub const SAY_OUT_LABEL : str = "The block's output: 3 positions x 4 dimensions";
pub const SAY_ATT_LABEL : str = "The block's self-attention weights";
pub const SAY_MEANS : str = "row means";
pub const SAY_VARS : str = "row variances";
pub const SAY_ORDER : str = "order";
pub const SAY_ORDER_POST : str = "attend, add, norm, FFN, add, norm";
pub const SAY_ORDER_PRE : str = "norm, attend, add, norm, FFN, add";
pub const SAY_ATT_ROW : str = "head 0, pos 0 reads";
pub const SAY_NOTE : str = "The residual adds keep the input flowing through, so a deep stack can train; the norms keep the numbers in range. Where the norm sits decides what comes out.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/transformer/encoder_block.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test two_heads_split_the_model {
    assert K_HEADS * 2 == K_D_MODEL;
    assert K_SEQ == 3;
}

test both_orders_are_offered {
    assert K_PRESET_PRE[0] == 0;
    assert K_PRESET_PRE[1] == 1;
}
