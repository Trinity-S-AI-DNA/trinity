// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-dropout.t27 -- dropout, inverted and classic: training with neurons switched off
; Source of truth for public/widgets/nn-dropout/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-dropout/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/layers/dropout_layer.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 9 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader toggles training and inverted scaling. The rows are forward_at(false,
; true, i) (the identity, so the input), forward_at(training, scaled, i) and, while training,
; backward_at(scaled, i).

; WHAT IT DOES NOT CLAIM: the mask is the spec's fixed one (keep, drop, keep, drop) with p 0.5, not
; a random draw; the point is the scaling, not the sampling.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_dropout;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-dropout";
pub const TITLE : str = "Dropout: training a network with neurons switched off";
pub const DESCRIPTION : str = "Switch between training and inference, inverted and classic dropout: units 1 and 3 are dropped, the survivors are scaled so that the layer's output keeps its expected size.";
pub const IMAGE_ALT : str = "Dropout card, training with inverted dropout: three rows of four cells. Input 1, 2, 3, 4; output 2, 0, 6, 0 with units 1 and 3 dimmed; gradient 2, 0, 2, 0. Tiles read mode training, a kept unit 2.00, a dropped unit 0.00 and the kept gradient 2.00.";
pub const HOOK : str = "With p = 0.5, inverted dropout doubles the units it keeps while training (1, 2, 3, 4 becomes 2, 0, 6, 0) and leaves inference alone.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/layers/dropout_layer.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 9 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_UNITS : u8 = 4;
pub const K_PRESET_TRAIN : [4]u8 = [1, 1, 0, 0];
pub const K_PRESET_SCALED : [4]u8 = [1, 0, 1, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["Training, inverted", "Training, classic", "Inference, inverted", "Inference, classic"];
pub const SAY_ASK : str = "Why would a network train with some of its neurons switched off?";
pub const SAY_TRAINING : str = "training";
pub const SAY_SCALED : str = "inverted (scale while training)";
pub const SAY_GRID_LABEL : str = "Input, output and gradient of four units through dropout";
pub const SAY_IN : str = "input";
pub const SAY_OUT : str = "output";
pub const SAY_GRAD : str = "gradient";
pub const SAY_UNIT : str = "unit";
pub const SAY_MODE : str = "mode";
pub const SAY_MODE_TRAIN : str = "training";
pub const SAY_MODE_INFER : str = "inference";
pub const SAY_KEPT_UNIT : str = "unit 0, kept";
pub const SAY_DROPPED_UNIT : str = "unit 1, dropped";
pub const SAY_GRAD_KEPT : str = "gradient, kept unit";
pub const SAY_NOTE : str = "Dropping random units forces the rest not to lean on any one of them. Inverted dropout scales by 1 / (1 - p) while training so that inference is a plain pass; classic dropout scales by 1 - p at inference instead.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/layers/dropout_layer.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test four_units_four_modes {
    assert K_UNITS == 4;
    assert K_PRESET_TRAIN[0] == 1;
    assert K_PRESET_TRAIN[3] == 0;
}

test every_mode_is_offered {
    assert K_PRESET_SCALED[0] != K_PRESET_SCALED[1];
    assert K_PRESET_SCALED[2] != K_PRESET_SCALED[3];
    assert K_START_PRESET == 0;
}
