// SPDX-License-Identifier: Apache-2.0
; specs/widgets/bit-reverse.t27 -- twiddles and bit reversal: the input order of a radix-2 FFT
; Source of truth for public/widgets/bit-reverse/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/bit-reverse/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 23 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader picks a size (4 to 64) and an index. The index's bits are drawn and read
; backwards; below, every index is joined to its bit-reversed place, the crossing pattern a
; decimation-in-time FFT wants at its input. The tiles add the twiddle W_N^k of the picked index.

; WHAT IT DOES NOT CLAIM: only the radix-2 order; mixed-radix digit reversal is not drawn.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_bit_reverse;

pub const KIND : str = "widget-tool";
pub const ID : str = "bit-reverse";
pub const TITLE : str = "Bit reversal: the order an FFT reads its input in";
pub const DESCRIPTION : str = "Pick a size and an index: its bits read backwards give the place it takes at the input of a radix-2 FFT. See the whole crossing pattern at once.";
pub const IMAGE_ALT : str = "Bit reversal card: 8 points. Index 1 is 001, read backwards 100, so x[1] goes to place 4; 3 (011) goes to 6 (110). Lines join every index to its reversed place.";
pub const HOOK : str = "Index 1 of an 8-point FFT is 001; backwards it is 100, so x[1] sits at place 4. One rewiring, no arithmetic at all.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "J. W. Cooley, J. W. Tukey, An algorithm for the machine calculation of complex Fourier series, Math. Comp. 19, 1965", "R. G. Lyons, Understanding Digital Signal Processing, 3rd ed., ch. 4: the radix-2 FFT and bit reversal"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_LENGTHS : [5]u16 = [4, 8, 16, 32, 64];
pub const K_PRESET_LEN : [4]u8 = [1, 1, 2, 4];
pub const K_PRESET_PICK : [4]u8 = [1, 3, 11, 37];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["8 points: 1 goes to 4", "8 points: 3 goes to 6", "16 points: 11", "64 points: 37"];
pub const SAY_LEN : str = "Points N";
pub const SAY_PICK : str = "Index";
pub const SAY_MAP_LABEL : str = "Every index joined to its bit-reversed place";
pub const SAY_BITS_LABEL : str = "The picked index, its bits, and the bits read backwards";
pub const SAY_NATURAL : str = "natural order";
pub const SAY_REVERSED : str = "FFT input order";
pub const SAY_NOTE : str = "Reversing the bits twice gives the index back, so the reordering is a set of swaps; an index that reads the same both ways stays put.";
pub const SAY_INDEX : str = "index";
pub const SAY_REV : str = "bit-reversed";
pub const SAY_BITS : str = "address bits";
pub const SAY_TWIDDLE : str = "W_N^k";
pub const SAY_CPLX : str = "{0} {1}j";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/signals.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_presets_fit_their_sizes {
    assert K_PRESET_PICK[0] < K_LENGTHS[1];
    assert K_PRESET_PICK[3] < K_LENGTHS[4];
    assert K_LENGTHS[1] == 8;
}

test the_sizes_double {
    assert K_LENGTHS[0] * 16 == K_LENGTHS[4];
    assert K_LENGTHS[2] == 16;
    assert K_PRESET_PICK[1] == 3;
}
