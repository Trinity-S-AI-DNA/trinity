test board_is_honest {
    assert HEADLINE_COUNT == 7;
    assert HEADLINE_KEYS[0] == "strict_pass";
    assert HEADLINE_VALUES[0] == "2";
    assert EVIDENCE_LEVELS[4] == "UNKNOWN";
}

test arena_has_a_negative_control {
    assert CANDIDATE_COUNT == 5;
    assert CANDIDATE_VERDICTS[0] == "champion";
    assert CANDIDATE_IDS[4] == "t27n";
    assert CANDIDATE_RANKS[4] == "";
}

test levers_are_paired_on_two_seeds {
    assert LEVER_COUNT == 4;
    assert PAIR_COUNT == 8;
    assert LEVER_VERDICTS[0] == "no-effect";
    assert LEVER_VERDICTS[1] == "kept";
    assert LEVER_VERDICTS[2] == "no-effect";
    assert LEVER_VERDICTS[3] == "no-effect";
    assert PAIR_SEEDS[0] == "11";
    assert PAIR_SEEDS[1] == "12";
}
