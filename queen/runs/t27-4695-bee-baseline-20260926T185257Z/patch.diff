@@ -51,6 +51,22 @@ module Simulator_Testbench {
         return true;
     }
 
+    // tick() is one clock cycle: the clock ends high, the cycle counter
+    // advances by exactly one, and nothing else moves -- event counting
+    // belongs to run_cycles(), and reset is left released.
+    test test_tick_advances_one_cycle {
+        reset();
+        var events_before : u32 = events_processed;
+        tick();
+        invariant sim_cycle == 1;
+        invariant clk == true;
+        tick();
+        invariant sim_cycle == 2;
+        invariant clk == true;
+        invariant rst_n == true;
+        invariant events_processed == events_before;
+    }
+
     test test_reset_state {
         reset();
