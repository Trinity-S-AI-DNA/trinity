+    // validate_trits: true iff every trit in the first len slots is balanced;
+    // slots at or past len are not inspected, so an empty prefix is valid
+    test validate_trits_check
+        var all_valid : [3]i32 = [_]i32{TRIT_NEG, TRIT_ZERO, TRIT_POS};
+        var bad_last : [3]i32 = [_]i32{TRIT_POS, TRIT_ZERO, 2};
+        var bad_first : [3]i32 = [_]i32{-2, TRIT_ZERO, TRIT_POS};
+        assert validate_trits(&all_valid, 3) == true
+        assert validate_trits(&bad_last, 3) == false
+        assert validate_trits(&bad_last, 2) == true
+        assert validate_trits(&bad_first, 3) == false
+        assert validate_trits(&bad_first, 0) == true
+
     test char_encoding_roundtrip
         var test_chars : [5]u8 = [_]u8{'A', '0', ' ', '\n', 127};
         var trits : [10]i32 = undefined;
