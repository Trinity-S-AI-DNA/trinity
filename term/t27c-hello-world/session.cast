[8.6008, "o", "test \"basic_config_creation\" {\r\n    const config = create_config(8, 16, 3);\r\n    if (!(config.width == 8)) __t27_assert_fail(\"\\n  assertion failed:\\n    config.width = {any}\\n\", .{ config.width });\r\n    if (!(config.height == 16)) __t27_assert_fail(\"\\n  assertion failed:\\n    config.height = {any}\\n\", .{ config.height });\r\n    if (!(config.depth == 3)) __t27_assert_fail(\"\\n  assertion failed:\\n    config.depth = {any}\\n\", .{ config.depth });\r\n    if (!(config.enable == true)) __t27_assert_fail(\"\\n  assertion failed:\\n    config.enable = {any}\\n\", .{ config.enable });\r\n}\r\ntest \"area_calculation\" {\r\n    const small_config = create_config(5, 7, 2);\r\n    const area = calculate_area(small_config);\r\n    if (!(area == 35)) __t27_assert_fail(\"\\n  assertion failed:\\n    area = {any}\\n\", .{ area });\r\n}\r\ncomptime {\r\n    // invariant: config_field_bounds\r\n    if (!(MAGIC_NUMBER <= 0xFFFFFFFF)) __t27_assert_fail(\"\\n  assertion failed:\\n    MAGIC_NUMBER = {any}\\n\", .{ MAGIC_NUMBER });\r\n    if (!(VERSION <= 255)) __t27_asse"]
[8.6008, "o", "rt_fail(\"\\n  assertion failed:\\n    VERSION = {any}\\n\", .{ VERSION });\r\n    if (!(create_config(255, 255, 255).width <= 255)) __t27_assert_fail(\"\\n  assertion failed:\\n    create_config(255, 255, 255).width = {any}\\n\", .{ create_config(255, 255, 255).width });\r\n}\r\ncomptime {\r\n    // invariant: area_consistency\r\n    const test_config = create_config(10, 20, 1);\r\n    const area = calculate_area(test_config);\r\n    if (!(area > 0)) __t27_assert_fail(\"\\n  assertion failed:\\n    area = {any}\\n\", .{ area });\r\n}\r\n"]
[8.602, "x", "0"]
