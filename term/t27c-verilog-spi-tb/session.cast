[2.8292, "o", "tiplication helper (no `*` operator)\r\n    // -------------------------------------------------------\r\n    function [63:0] __mul_noop; // t27#1886: 64-bit, u64 products no longer truncate\r\n        input [63:0] a;\r\n        input [63:0] b;\r\n        integer i;\r\n        reg [127:0] acc;\r\n        begin\r\n            acc = 128'd0;\r\n            for (i = 0; i < 64; i = i + 1) begin\r\n                if (b[i]) acc = acc + ({64'd0, a} << i);\r\n            end\r\n            __mul_noop = acc[63:0];\r\n        end\r\n    endfunction\r\n\r\n    assign ready = 1'b1;\r\n\r\n    // -------------------------------------------------------\r\n    // Combinational logic (from function declarations)\r\n    // -------------------------------------------------------\r\n\r\n    // function: tick\r\n    task tick;\r\n        input _unused;\r\n        begin : tick_body\r\n            reg __t27_ret;\r\n            __t27_ret = 1'b0;\r\n            clk = 1'b0;\r\n            clk = 1'b1;\r\n        end\r\n    endtask\r\n\r\n    // function: reset\r\n    task reset;\r\n        input _unused"]
[2.8292, "o", ";\r\n        begin : reset_body\r\n            reg __t27_ret;\r\n            __t27_ret = 1'b0;\r\n            rst_n = 1'b0;\r\n            tick(1'b0);\r\n            tick(1'b0);\r\n            rst_n = 1'b1;\r\n            reset = tick(1'b0);\r\n        end\r\n    endtask\r\n\r\n    // function: spi_transfer\r\n    function [31:0] spi_transfer; // -> u32\r\n        input [31:0] tx_data;\r\n        begin : spi_transfer_body\r\n            reg [31:0] timeout;\r\n            reg __t27_ret;\r\n            __t27_ret = 1'b0;\r\n            spi_start = 1'b1;\r\n            spi_mosi_data = tx_data;\r\n            tick(1'b0);\r\n            spi_start = 1'b0;\r\n            timeout = 0;\r\n            // W700/W702: NOT UNROLLED -- the bound is not a literal, so there is no\r\n            // static trip count and nothing can unroll it.\r\n            //\r\n            // W702 measured the consequence, which is NOT a silent zero: yosys rejects\r\n            // the enclosing function outright --\r\n            //     ERROR: Function \\<name> can only be called with constant argum"]
[2.8293, "o", "ents.\r\n            // -- because a Verilog `function` is combinational by definition and a\r\n            // data-dependent trip count is not. NINE of the thirteen entry-point specs\r\n            // that fail synthesis fail exactly here.\r\n            //\r\n            // The fix is a DESIGN decision this compiler does not make: either give the\r\n            // loop a compile-time bound, or move the entry point to `fn on_clock` and let\r\n            // it be the multi-cycle operation it actually is. A loop whose length depends\r\n            // on data is sequential; naming it combinational is the error.\r\n            while (!__t27_ret && !spi_done) begin\r\n                tick(1'b0);\r\n                timeout = (timeout + 1);\r\n                if ((timeout > SIM_TIMEOUT)) begin\r\n                    spi_transfer = 57005;\r\n                    __t27_ret = 1'b1;\r\n                end\r\n            end\r\n            if (!__t27_ret) begin\r\n                spi_transfer = spi_rx_data;\r\n                __t27_ret = 1'b1;\r\n            "]
[2.8293, "o", "end\r\n        end\r\n    endfunction\r\n\r\n    // function: on_comb\r\n    function [31:0] on_comb; // -> u32\r\n        input [31:0] tx_data;\r\n        begin : on_comb_body\r\n            reg __t27_ret;\r\n            __t27_ret = 1'b0;\r\n            on_comb = spi_transfer(tx_data);\r\n            __t27_ret = 1'b1;\r\n        end\r\n    endfunction\r\n\r\n    assign result = on_comb(tx_data);\r\n    // -------------------------------------------------------\r\n    // NOT LOWERED BY THIS BACKEND\r\n    //\r\n    // `gen-verilog` emits synthesizable RTL. A test, an invariant and a\r\n    // bench are simulation constructs -- yosys turns each `$display` into a\r\n    // `$print` cell and nextpnr has no BEL to place one. They are carried by\r\n    // `gen-verilog-for-simulation`, which lowers every declaration below.\r\n    //\r\n    // test      test_idle_state\r\n    // test      test_single_transfer\r\n    // test      test_cs_assert_during_transfer\r\n    // test      test_consecutive_transfers\r\n    // test      test_full_duplex\r\n    // test      test_zero_d"]
