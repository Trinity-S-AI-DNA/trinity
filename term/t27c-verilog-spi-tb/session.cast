[2.8291, "o", "// ============================================================================\r\n// Generated from t27 spec: SPI_Testbench\r\n// DO NOT EDIT - generated by t27c gen-verilog\r\n// phi^2 + 1/phi^2 = 3 | TRINITY\r\n// ============================================================================\r\n\r\n`timescale 1ns / 1ps\r\n`default_nettype none\r\n\r\nmodule SPI_Testbench (\r\n    input  wire        en,\r\n    input  wire [31:0] tx_data,\r\n    output wire        ready,\r\n    output wire [31:0] result\r\n);\r\n\r\n    // -------------------------------------------------------\r\n    // Parameters (from const declarations)\r\n    // -------------------------------------------------------\r\n    localparam [31:0] CLK_PERIOD = 20;\r\n    localparam [31:0] SIM_TIMEOUT = 10000000;\r\n    localparam [31:0] SPI_CLK_DIV = 4;\r\n    reg clk;\r\n    initial begin\r\n        clk = 1'b0;\r\n    end\r\n\r\n    reg rst_n;\r\n    initial begin\r\n        rst_n = 1'b0;\r\n    end\r\n\r\n    reg spi_start;\r\n    initial begin\r\n        spi_start = 1'b0;\r\n    end\r\n\r\n    reg [31:0] spi_mosi_"]
