[7.9833, "o", "\r\n"]
[7.9872, "o", "    test small_weights_vanish_in_mxfp4 {\r\n        // 31 non-zero inputs; the outlier's scale flushes 23 of them in MXFP4\r\n        assert block_flushed(BLOCK_A, K_E2M1) == 23;\r\n        assert block_flushed(BLOCK_A, K_E2M3) == 4;\r\n        assert block_flushed(BLOCK_A, K_INT8) == 2;\r\n        assert block_flushed(BLOCK_A, K_E3M2) == 0;\r\n        assert block_flushed(BLOCK_A, K_E4M3) == 0;\r\n    }\r\n"]
