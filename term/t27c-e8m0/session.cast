[18.9026, "o", "    // function: e8m0_is_nan\r\n    function e8m0_is_nan; // -> bool\r\n        input [31:0] x;\r\n        begin : e8m0_is_nan_body\r\n            reg __t27_ret;\r\n            __t27_ret = 1'b0;\r\n            e8m0_is_nan = (x == E8M0_NAN_CODE);\r\n            __t27_ret = 1'b1;\r\n        end\r\n    endfunction\r\n"]
