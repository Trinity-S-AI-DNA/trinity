[1.6375, "o", "\r\n"]
[1.805, "o", "self-test tern_tc_batch_runner (no board, no RTL)\r\n  ok   constants come from the spec's params (window 24, ceiling 13, flush 24)\r\n"]
[2.0021, "o", "  ok   clean link, two passes: every receipt (220+594 frames), every row, no retransmit, no resync\r\n  ok   frame economy: SETX {PLANES}xC then RxC DOT6 per pass, >4x fewer than today\r\n  ok   one budget across both passes: retry space untouched, node pinned once\r\n"]
[2.2434, "o", "  ok   the RTL hunting parser agrees with the aligned model on a clean link\r\n"]
[2.311, "o", "  ok   recovered, 1 retransmitted, 1 resyncs: 12 bytes lost mid SETX answer\r\n"]
[2.3371, "o", "  ok   recovered, 1 retransmitted, 0 resyncs: a whole DOT6 answer lost, stream still aligned\r\n"]
[2.3758, "o", "  ok   recovered, 1 retransmitted, 1 resyncs: 16 bytes lost across two DOT6 answers\r\n"]
[2.4196, "o", "  ok   recovered, 1 retransmitted, 1 resyncs: the last answer of the pass lost\r\n"]
[2.4875, "o", "  ok   recovered, 3 retransmitted, 2 resyncs: two holes, one in each phase\r\n"]
[2.5614, "o", "  ok   recovered, 1 retransmitted, 0 resyncs: a flipped tag bit on a DOT6 (fault damage)\r\n"]
[2.6099, "o", "  ok   recovered, 1 retransmitted, 0 resyncs: a swallowed DOT6 answer (fault drop)\r\n"]
[2.6553, "o", "  ok   recovered, 1 retransmitted, 1 resyncs: an answer under a nonce never issued (fault nonce)\r\n"]
[2.6805, "o", "  ok   recovered, 4 retransmitted, 1 resyncs: one request byte lost (a w byte): the parser eats the next frame's magic\r\n"]
[2.7538, "o", "  ok   recovered, 1 retransmitted, 0 resyncs: a request's last byte lost: the frame limps, the parser mis-answers it\r\n"]
[2.7836, "o", "  ok   recovered, 1 retransmitted, 0 resyncs: a request's AA lost: the node never sees that frame\r\n"]
[2.8018, "o", "  ok   a workload with a y-nonce collision exists (search found one)\r\n"]
[2.8056, "o", "  ok   the colliding frame (ys[2..5]=[3, 0, 1, 0] spell an issued nonce) settles by tag, not by a false status/duplicate stop (1 both-shape frames)\r\n"]
[2.8305, "o", "  ok   still stops the run on a wrong y byte with a valid tag ('lie')\r\n"]
[2.832, "o", "  ok   still stops the run on a cell signing with another key ('exhausted')\r\n"]
[2.832, "o", "  ok   an unkeyed cell (status 0x04) stops the run at its first answer, no retry\r\n"]
[2.838, "o", "  ok   one DOT6 answer served twice stops the run ('duplicate')\r\n"]
[2.8788, "o", "  ok   RAM drift after an honest SETX is never credited: retries burn out and the run stops\r\n"]
[2.9707, "o", "  ok   zero-plane skip: identical rows, the all-zero chunk's 12 DOT6 frames skipped\r\n"]
[3.057, "o", "  ok   14 random hole patterns: 6 stopped on the lie, 8 passed clean\r\n"]
[3.6801, "o", "  ok   rehearsal pair: honest and corrupt links agree on every row (5 retransmits over 3 holes)\r\nself-test: PASS\r\n"]
