[3.1226, "o", "// ============================================================================\r\n// Generated from t27 spec: APB_Bridge_Testbench\r\n// DO NOT EDIT - generated by t27c gen-verilog\r\n// phi^2 + 1/phi^2 = 3 | TRINITY\r\n// ============================================================================\r\n\r\n`timescale 1ns / 1ps\r\n`default_nettype none\r\n\r\nmodule APB_Bridge_Testbench (\r\n    input  wire        en,\r\n    output wire        ready\r\n);\r\n// NO DATA PORTS -- this module cannot move a value across its boundary.\r\n// Synthesis will optimise it to nothing. Add `fn on_comb(...) -> T` to give\r\n// it a combinational surface: parameters become inputs, the return becomes\r\n// `result`. See T81.\r\n\r\n    // -------------------------------------------------------\r\n    // Parameters (from const declarations)\r\n    // -------------------------------------------------------\r\n    localparam [31:0] CLK_PERIOD = 20;\r\n    localparam [31:0] SIM_TIMEOUT = 5000000;\r\n    localparam [31:0] APB_ADDR_WIDTH = 12;\r\n    localparam [31:0] APB_DATA_"]
