{"version": 2, "width": 104, "height": 30, "timestamp": 1791394517, "title": "t27c on mmcm.t27 -- widen the VCO window, one test objects", "commands": ["t27c test-report specs/fpga/mmcm.t27 --specs-dir specs | sed -n '1,7p'", "sed -i '' 's/VCO_MIN_KHZ : u32 = 800000/VCO_MIN_KHZ : u32 = 400000/' specs/fpga/mmcm.t27 && git diff -U0 specs/fpga/mmcm.t27 | tail -n 2", "t27c test-report specs/fpga/mmcm.t27 --specs-dir specs | sed -n '1,8p'", "git checkout specs/fpga/mmcm.t27 && sha256sum specs/fpga/mmcm.t27"], "redacted": ["home directory shown as ~"]}
