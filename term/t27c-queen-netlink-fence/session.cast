[11.3463, "o", "pub fn must_fence(refused: bool, seconds_since_renewed: u32) -> bool {\r\n    if (refused) { return true; }\r\n    return seconds_since_renewed >= SELF_FENCE_SECONDS;\r\n}\r\ntest a_node_stops_before_any_peer_can_see_it_down {\r\n    assert must_fence(false, 0) == false;\r\n    assert must_fence(false, SELF_FENCE_SECONDS - 1) == false;\r\n    assert must_fence(false, SELF_FENCE_SECONDS) == true;\r\n"]
