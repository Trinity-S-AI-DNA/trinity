[7.9885, "o", "pub fn neuronN(acts: [8]u64, weights: [8]u64, nchunks: u32, threshold: i16) -> u8 {\r\n    var acc : i16 = 0;\r\n    var c : u32 = 0;\r\n    while (c < nchunks) {\r\n        acc = acc + dot27(acts[c], weights[c]);\r\n        c = c + 1;\r\n    }\r\n    return quantize(acc, threshold);\r\n}\r\ntest neuron_zero_chunks { assert_eq(neuronN([8]u64{12009599006321322, 12009599006321322, 12009599006321322, 12009599006321322, 12009599006321322, 12009599006321322, 12009599006321322, 12009599006321322}, [8]u64{12009599006321322, 12009599006321322, 12009599006321322, 12009599006321322, 12009599006321322, 12009599006321322, 12009599006321322, 12009599006321322}, 0, 10), 1); }\r\n"]
