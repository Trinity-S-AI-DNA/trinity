[2.8969, "o", "// ============================================================================\r\n// Generated from t27 spec: Memory_Testbench\r\n// DO NOT EDIT - generated by t27c gen-verilog\r\n// phi^2 + 1/phi^2 = 3 | TRINITY\r\n// ============================================================================\r\n\r\n`timescale 1ns / 1ps\r\n`default_nettype none\r\n\r\nmodule Memory_Testbench (\r\n    input  wire        en,\r\n    input  wire [31:0] addr,\r\n    output wire        ready,\r\n    output wire [31:0] result\r\n);\r\n\r\n    // -------------------------------------------------------\r\n    // Parameters (from const declarations)\r\n    // -------------------------------------------------------\r\n    localparam [31:0] CLK_PERIOD = 20;\r\n    localparam [31:0] SIM_TIMEOUT = 5000000;\r\n    localparam [31:0] MEM_BASE = 0;\r\n    localparam [31:0] MEM_SIZE = 65536;\r\n    reg clk;\r\n    initial begin\r\n        clk = 1'b0;\r\n    end\r\n\r\n    reg rst_n;\r\n    initial begin\r\n        rst_n = 1'b0;\r\n    end\r\n\r\n    reg [31:0] mem_addr;\r\n    initial begin\r\n        mem_addr"]
