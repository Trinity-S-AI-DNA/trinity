[2.8972, "o", "gin\r\n            acc = 128'd0;\r\n            for (i = 0; i < 64; i = i + 1) begin\r\n                if (b[i]) acc = acc + ({64'd0, a} << i);\r\n            end\r\n            __mul_noop = acc[63:0];\r\n        end\r\n    endfunction\r\n\r\n    assign ready = 1'b1;\r\n\r\n    // -------------------------------------------------------\r\n    // Combinational logic (from function declarations)\r\n    // -------------------------------------------------------\r\n\r\n    // function: tick\r\n    task tick;\r\n        input _unused;\r\n        begin : tick_body\r\n            reg __t27_ret;\r\n            __t27_ret = 1'b0;\r\n            clk = 1'b0;\r\n            clk = 1'b1;\r\n        end\r\n    endtask\r\n\r\n    // function: reset\r\n    task reset;\r\n        input _unused;\r\n        begin : reset_body\r\n            reg __t27_ret;\r\n            __t27_ret = 1'b0;\r\n            rst_n = 1'b0;\r\n            tick(1'b0);\r\n            tick(1'b0);\r\n            rst_n = 1'b1;\r\n            reset = tick(1'b0);\r\n        end\r\n    endtask\r\n\r\n    // function: mem_write\r\n    task me"]
[2.8972, "o", "m_write;\r\n        input [31:0] addr;\r\n        input [31:0] data;\r\n        begin : mem_write_body\r\n            reg __t27_ret;\r\n            __t27_ret = 1'b0;\r\n            mem_addr = addr;\r\n            mem_wdata = data;\r\n            mem_we = 1'b1;\r\n            mem_re = 1'b0;\r\n            tick(1'b0);\r\n            // W700/W702: NOT UNROLLED -- the bound is not a literal, so there is no\r\n            // static trip count and nothing can unroll it.\r\n            //\r\n            // W702 measured the consequence, which is NOT a silent zero: yosys rejects\r\n            // the enclosing function outright --\r\n            //     ERROR: Function \\<name> can only be called with constant arguments.\r\n            // -- because a Verilog `function` is combinational by definition and a\r\n            // data-dependent trip count is not. NINE of the thirteen entry-point specs\r\n            // that fail synthesis fail exactly here.\r\n            //\r\n            // The fix is a DESIGN decision this compiler does not make: either give the\r"]
