[3.1547, "o", "// ============================================================================\r\n// Generated from t27 spec: Integration_Testbench\r\n// DO NOT EDIT - generated by t27c gen-verilog\r\n// phi^2 + 1/phi^2 = 3 | TRINITY\r\n// ============================================================================\r\n\r\n`timescale 1ns / 1ps\r\n`default_nettype none\r\n\r\nmodule Integration_Testbench (\r\n    input  wire        en,\r\n    output wire        ready\r\n);\r\n// NO DATA PORTS -- this module cannot move a value across its boundary.\r\n// Synthesis will optimise it to nothing. Add `fn on_comb(...) -> T` to give\r\n// it a combinational surface: parameters become inputs, the return becomes\r\n// `result`. See T81.\r\n\r\n    // -------------------------------------------------------\r\n    // Parameters (from const declarations)\r\n    // -------------------------------------------------------\r\n    localparam [31:0] CLK_PERIOD = 20;\r\n    localparam [31:0] SIM_TIMEOUT = 20000000;\r\n    localparam [31:0] NUM_MODULES = 5;\r\n    reg clk;\r\n    initial begin\r"]
[3.1548, "o", "\r\n        clk = 1'b0;\r\n    end\r\n\r\n    reg rst_n;\r\n    initial begin\r\n        rst_n = 1'b0;\r\n    end\r\n\r\n    reg mac_busy;\r\n    initial begin\r\n        mac_busy = 1'b0;\r\n    end\r\n\r\n    reg uart_tx_ready;\r\n    initial begin\r\n        uart_tx_ready = 1'b0;\r\n    end\r\n\r\n    reg spi_done;\r\n    initial begin\r\n        spi_done = 1'b0;\r\n    end\r\n\r\n    reg mem_ready;\r\n    initial begin\r\n        mem_ready = 1'b0;\r\n    end\r\n\r\n    reg bridge_busy;\r\n    initial begin\r\n        bridge_busy = 1'b0;\r\n    end\r\n\r\n    reg all_modules_idle;\r\n    initial begin\r\n        all_modules_idle = 1'b0;\r\n    end\r\n\r\n    reg integration_passed;\r\n    initial begin\r\n        integration_passed = 1'b0;\r\n    end\r\n\r\n    reg [31:0] test_passed;\r\n    initial begin\r\n        test_passed = 0;\r\n    end\r\n\r\n    reg [31:0] test_failed;\r\n    initial begin\r\n        test_failed = 0;\r\n    end\r\n\r\n\r\n    // -------------------------------------------------------\r\n    // R-SI-1: multiplication helper (no `*` operator)\r\n    // -------------------------------------------"]
[3.1553, "o", "------------\r\n    function [63:0] __mul_noop; // t27#1886: 64-bit, u64 products no longer truncate\r\n        input [63:0] a;\r\n        input [63:0] b;\r\n        integer i;\r\n        reg [127:0] acc;\r\n        begin\r\n            acc = 128'd0;\r\n            for (i = 0; i < 64; i = i + 1) begin\r\n                if (b[i]) acc = acc + ({64'd0, a} << i);\r\n            end\r\n            __mul_noop = acc[63:0];\r\n        end\r\n    endfunction\r\n\r\n    assign ready = 1'b1;\r\n\r\n    // -------------------------------------------------------\r\n    // Combinational logic (from function declarations)\r\n    // -------------------------------------------------------\r\n\r\n    // function: tick\r\n    task tick;\r\n        input _unused;\r\n        begin : tick_body\r\n            reg __t27_ret;\r\n            __t27_ret = 1'b0;\r\n            clk = 1'b0;\r\n            clk = 1'b1;\r\n        end\r\n    endtask\r\n\r\n    // function: reset\r\n    task reset;\r\n        input _unused;\r\n        begin : reset_body\r\n            reg __t27_ret;\r\n            __t27_ret = 1'b0;"]
[3.1553, "o", "\r\n            rst_n = 1'b0;\r\n            tick(1'b0);\r\n            tick(1'b0);\r\n            rst_n = 1'b1;\r\n            reset = tick(1'b0);\r\n        end\r\n    endtask\r\n\r\n    // function: check_all_idle\r\n    function check_all_idle; // -> bool\r\n        input _unused;\r\n        begin : check_all_idle_body\r\n            reg __t27_ret;\r\n            __t27_ret = 1'b0;\r\n            check_all_idle = ((((!mac_busy && uart_tx_ready) && spi_done) && mem_ready) && !bridge_busy);\r\n            __t27_ret = 1'b1;\r\n        end\r\n    endfunction\r\n    // -------------------------------------------------------\r\n    // NOT LOWERED BY THIS BACKEND\r\n    //\r\n    // `gen-verilog` emits synthesizable RTL. A test, an invariant and a\r\n    // bench are simulation constructs -- yosys turns each `$display` into a\r\n    // `$print` cell and nextpnr has no BEL to place one. They are carried by\r\n    // `gen-verilog-for-simulation`, which lowers every declaration below.\r\n    //\r\n    // test      test_reset_all_modules\r\n    // test      test_module_co"]
