[2.2385, "o", "HirModule {\r\n    name: \"ZeroDSP_UART\",\r\n    ports: [\r\n        HirPort {\r\n            name: \"uart_tx_ready_result\",\r\n            dir: Output,\r\n            ty: Bool,\r\n        },\r\n        HirPort {\r\n            name: \"uart_tx_send_result\",\r\n            dir: Output,\r\n            ty: Bool,\r\n        },\r\n        HirPort {\r\n            name: \"data\",\r\n            dir: Input,\r\n            ty: UInt(\r\n                8,\r\n            ),\r\n        },\r\n        HirPort {\r\n            name: \"uart_rx_ready_result\",\r\n            dir: Output,\r\n            ty: Bool,\r\n        },\r\n        HirPort {\r\n            name: \"uart_rx_read_result\",\r\n            dir: Output,\r\n            ty: UInt(\r\n                8,\r\n            ),\r\n        },\r\n        HirPort {\r\n            name: \"uart_status_result\",\r\n            dir: Output,\r\n            ty: UInt(\r\n                8,\r\n            ),\r\n        },\r\n        HirPort {\r\n            name: \"uart_reset_result\",\r\n            dir: Output,\r\n            ty: Bits(\r\n                32,\r\n            ),\r\n"]
[2.2385, "o", "        },\r\n        HirPort {\r\n            name: \"uart_configure_result\",\r\n            dir: Output,\r\n            ty: Bits(\r\n                32,\r\n            ),\r\n        },\r\n        HirPort {\r\n            name: \"baud_divisor\",\r\n            dir: Input,\r\n            ty: UInt(\r\n                32,\r\n            ),\r\n        },\r\n        HirPort {\r\n            name: \"parity_enable\",\r\n            dir: Input,\r\n            ty: Bool,\r\n        },\r\n        HirPort {\r\n            name: \"stop_bits\",\r\n            dir: Input,\r\n            ty: UInt(\r\n                8,\r\n            ),\r\n        },\r\n        HirPort {\r\n            name: \"fifo_enable\",\r\n            dir: Input,\r\n            ty: Bool,\r\n        },\r\n        HirPort {\r\n            name: \"on_clock_result\",\r\n            dir: Output,\r\n            ty: Bits(\r\n                32,\r\n            ),\r\n        },\r\n    ],\r\n    signals: [\r\n        HirSignal {\r\n            name: \"UART_CLOCK_HZ\",\r\n            kind: Wire,\r\n            ty: UInt(\r\n                32,\r\n            ),\r\n    "]
