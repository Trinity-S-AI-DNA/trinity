// SPDX-License-Identifier: Apache-2.0
; specs/x/player.t27 -- a t27 spec, compiled and run inside a post on X
; Source of truth for apps/website/scripts/play-from-spec.mjs (gHashTag/trinity), which
; compiles this file with the vendored compiler (public/t27/t27_compiler.wasm), checks the
; constant schema, evaluates every test block below, and only then writes one share page per
; play under public/play/<id>/ and a byte-identical copy of this file at public/play/player.t27.
; The player (public/play/embed.js) compiles that copy again, in the reader's browser, with the
; same compiler, and takes its tabs, its timing and its honesty note from the constants below.
; Nothing about the player is typed twice: not here and in the page, not here and in the script.
; ASCII only (L3), English only (LANG-EN).

; WHAT X GIVES US: the player card. A post whose only link points at a page carrying
; twitter:card = player shows that page's still image. On x.com a click swaps the image for an
; iframe of the address in twitter:player; X adds autoplay=1 and auto_play=true to it. The X
; apps on a phone show the image and open the page in their own browser. The numbers in the
; second section are X's rules, from its card documentation, not ours:
; https://developer.x.com/en/docs/x-for-websites/cards/overview/player-card

; WHAT THE READER GETS: the compiler itself, the same WebAssembly module t27.ai runs, on the
; spec named by the play. Compile is a short linear piece -- source, lexer, parser, types, HIR,
; seven backends, tests -- and every number in it is the compiler's answer for that file, read
; while it plays. The spec can be edited in place and compiles again as it is typed. Tests runs
; the spec's own test blocks. Code shows what each backend emitted, coloured the way the spec
; explorer colours it. RTL reads the emitted Verilog the way a hardware engineer would before
; synthesis: the module's ports and parameters, the bit map of every packed struct, the
; functions, and what a Verilog-2005 tool will refuse in that text. Term is a terminal over the
; same compiler: `t27c gen rust` prints the Rust it emits for the spec in the editor, and so for
; each of the seven backends; `t27c test`, `ls`, `cat` and `save` work on what it made; `run`
; executes the JavaScript backend's module in the page; `replay` plays a recording of t27c on
; the same file, made on a real machine. Each backend has a share page of its own, so a post can
; open the terminal on that backend.

; WHAT IS DELIBERATELY ABSENT: sound, a sign-in, a cookie, a request to any host but t27.ai,
; and a test outcome this page made up. A block the evaluator cannot follow is a skip and says
; why; it is never counted as a pass, and it is never counted as a fail.
; phi^2 + 1/phi^2 = 3 | TRINITY

module x_player;

pub const KIND : str = "player";
pub const ID : str = "x/player";
pub const NAME : str = "t27 in a post";
; The derived files the generator rewrites (relative to apps/website): this spec's public copy,
; then the site modules below as one ES module, then per play, in PLAY_IDS order, its share page
; and one share page per backend, in BACKENDS order.
pub const GENERATED : [42]str = ["public/play/player.t27", "public/play/site.js", "public/play/hello-world/index.html", "public/play/hello-world/zig/index.html", "public/play/hello-world/c/index.html", "public/play/hello-world/rust/index.html", "public/play/hello-world/verilog/index.html", "public/play/hello-world/verilog-hir/index.html", "public/play/hello-world/js/index.html", "public/play/hello-world/ts/index.html", "public/play/e8m0/index.html", "public/play/e8m0/zig/index.html", "public/play/e8m0/c/index.html", "public/play/e8m0/rust/index.html", "public/play/e8m0/verilog/index.html", "public/play/e8m0/verilog-hir/index.html", "public/play/e8m0/js/index.html", "public/play/e8m0/ts/index.html", "public/play/gfternary/index.html", "public/play/gfternary/zig/index.html", "public/play/gfternary/c/index.html", "public/play/gfternary/rust/index.html", "public/play/gfternary/verilog/index.html", "public/play/gfternary/verilog-hir/index.html", "public/play/gfternary/js/index.html", "public/play/gfternary/ts/index.html", "public/play/golden-sieve/index.html", "public/play/golden-sieve/zig/index.html", "public/play/golden-sieve/c/index.html", "public/play/golden-sieve/rust/index.html", "public/play/golden-sieve/verilog/index.html", "public/play/golden-sieve/verilog-hir/index.html", "public/play/golden-sieve/js/index.html", "public/play/golden-sieve/ts/index.html", "public/play/tnf17/index.html", "public/play/tnf17/zig/index.html", "public/play/tnf17/c/index.html", "public/play/tnf17/rust/index.html", "public/play/tnf17/verilog/index.html", "public/play/tnf17/verilog-hir/index.html", "public/play/tnf17/js/index.html", "public/play/tnf17/ts/index.html"];

; --- What the player takes from the site -------------------------------------------------------
; The spec explorer's highlighter and palette, bundled from the site's own source rather than
; copied into the player: a second copy of a colour table is where two pages start to disagree.
; SITE_IMPORTS[i] names what is taken from SITE_MODULES[i] (paths relative to apps/website).
pub const SITE_MODULES : [2]str = ["src/lib/highlight.ts", "src/lib/explorerTheme.ts"];
pub const SITE_IMPORTS : [2]str = ["highlightSource, highlightCode, CLS_COLOR, TARGET_LANG", "C"];
pub const SITE_BUNDLE : str = "public/play/site.js";

; --- The card, as X defines it -------------------------------------------------------------
pub const CARD : str = "player";
pub const SITE_HANDLE : str = "@t27_dev";
pub const ORIGIN : str = "https://t27.ai/";
; The iframe page every play shares; the play is named in its query.
pub const EMBED : str = "play/embed.html";
; Where the player's open link goes: ORIGIN, then this, then the spec path, URL-encoded.
pub const SPEC_PAGE : str = "?lang=en#/specs?spec=";
pub const TITLE_MAX : u8 = 70;
pub const DESCRIPTION_MAX : u8 = 200;
pub const IMAGE_ALT_MAX : u16 = 420;
; The iframe size the card declares. X scales it down to the timeline; the image should match.
pub const PLAYER_WIDTH : u16 = 1200;
pub const PLAYER_HEIGHT : u16 = 675;
pub const IMAGE_WIDTH : u16 = 1200;
pub const IMAGE_HEIGHT : u16 = 675;
; Below this many pixels X does not render the card at all (262x262, or 350x196 at 16:9).
pub const IMAGE_MIN_AREA : u32 = 68600;
; X takes images under 5 MB; held to 5 000 000 bytes so the margin is not a rounding question.
pub const IMAGE_MAX_BYTES : u32 = 5000000;
pub const IMAGE_FILE : str = "card.png";

; --- Motion and sound ------------------------------------------------------------------------
; X's rule for a player card: nothing longer than ten seconds starts by itself, and nothing
; starts with sound. The compile piece runs once, shorter than the limit, and then stops.
pub const AUTOPLAY_LIMIT_MS : u16 = 10000;
pub const COMPILE_ANIMATION_MS : u16 = 8000;
pub const HAS_SOUND : bool = false;
; The query keys X appends when a reader clicks the card. Either one starts the piece.
pub const AUTOPLAY_PARAMS : [2]str = ["autoplay", "auto_play"];

; --- Layout ------------------------------------------------------------------------------------
pub const TABS : [6]str = ["compile", "spec", "tests", "code", "rtl", "term"];
pub const TAB_LABELS : [6]str = ["Compile", "Spec", "Tests", "Code", "RTL", "Term"];
pub const FIRST_TAB : str = "compile";
; At this width and above the spec stays beside the active tab instead of being a tab of its own.
pub const WIDE_MIN_PX : u16 = 900;
; The editor's text is transparent; what a reader sees is the coloured layer under it. That layer
; is redrawn on every keystroke, so typing shows at once. Only the compile waits for this pause.
pub const RECOMPILE_DEBOUNCE_MS : u16 = 250;
; iOS Safari zooms the page in whenever a field whose text is smaller than this takes focus, and
; does not zoom back out. On a touch screen the editor's text is never smaller.
pub const IOS_FOCUS_ZOOM_BELOW_PX : u8 = 16;
pub const EDITOR_TOUCH_FONT_PX : u8 = 16;

; --- Honesty ------------------------------------------------------------------------------------
; There is no other runner for these test blocks today: the Zig test report does not build for
; hello_world and the JS backend emits declarations only. So the page runs them itself, and says
; what that means beside the result.
pub const OUTCOMES : [3]str = ["pass", "fail", "skip"];
pub const SKIP_IS_NEVER_PASS : bool = true;
pub const TESTS_NOTE : str = "Run here, in your browser, by a small evaluator over the compiler's syntax tree. Fail means an assert was false, or the block divided by zero or indexed past the end. Anything the evaluator cannot follow is a skip and names the reason; a skip is never counted as a pass.";

; --- Term: a terminal over the same compiler --------------------------------------------------
; The compiler's backends, in the order every tab lists them. The generator refuses this list
; unless it is exactly the set of targets the compiler answers with, so a backend added to t27c
; and not named here (or named here and gone from t27c) stops the build instead of going unseen.
pub const BACKENDS : [7]str = ["zig", "c", "rust", "verilog", "verilog_hir", "js", "ts"];
pub const BACKEND_NAMES : [7]str = ["Zig", "C", "Rust", "Verilog", "Verilog (HIR)", "JavaScript", "TypeScript"];
; The emitted file's name is the spec's stem plus this; Verilog takes its module's name instead.
pub const BACKEND_EXTS : [7]str = [".zig", ".c", ".rs", ".v", ".hir.v", ".js", ".ts"];
; Each backend's share page: public/play/<id>/<page>/, the terminal opened on that backend.
pub const BACKEND_PAGES : [7]str = ["zig", "c", "rust", "verilog", "verilog-hir", "js", "ts"];
; What `run` prints for the backends this page cannot run: the command on a machine that has
; the toolchain. {file} is the emitted file. The terminal prints it; it never claims its outcome.
pub const BACKEND_RUN_LOCAL : [7]str = ["zig test {file}", "cc -std=c11 -c {file}", "rustc --crate-type lib --edition 2021 {file}", "iverilog -g2012 -o /dev/null {file}", "iverilog -g2012 -o /dev/null {file}", "node {file}", "tsc --noEmit --strict {file}"];
; The backends whose output this page runs itself. A browser has a JavaScript engine; it has no
; zig, cc, rustc, iverilog or tsc, and this page fetches nothing from any other host to fake one.
pub const RUNS_IN_BROWSER : [1]str = ["js"];
; The commands, what each takes, and the line `help` prints for it. Two words are one command.
pub const SHELL_COMMANDS : [12]str = ["help", "ls", "cat", "save", "lang", "t27c gen", "t27c test", "t27c check", "run", "replay", "history", "clear"];
pub const SHELL_ARGS : [12]str = ["", "", "<file>", "<file>", "[backend]", "[backend]", "", "", "[backend]", "", "", ""];
pub const SHELL_HELP : [12]str = ["this list", "the spec, and the file each backend emitted from it", "print a file", "download a file", "show the backend, or pick one", "compile the spec in the editor and print what the backend emits", "run the spec's test and invariant blocks", "what each compiler stage made of the spec", "run the emitted code, where this page can: JavaScript", "play a recording of t27c on this spec, made on a real machine", "the commands typed so far", "clear the screen"];
; The commands a tap runs, for a reader with no keyboard; the backends are taps of their own.
pub const SHELL_CHIPS : [5]str = ["t27c test", "run", "ls", "replay", "help"];
pub const SHELL_NOTE : str = "Every line here is printed by the t27 compiler running in this page, or by the JavaScript it emitted. Nothing is sent anywhere. A browser has no zig, cc, rustc or iverilog: for those backends, run prints the command for your machine.";
; Opened on a backend with autoplay, the terminal types this one command and runs it.
pub const SHELL_DEMO : str = "t27c gen {backend}";
pub const SHELL_TYPE_MS : u8 = 45;
pub const SHELL_DEMO_MAX_CHARS : u8 = 32;
; A backend's share page. {spec} is the play's file name, {lang} its BACKEND_NAMES entry and
; {backend} its BACKENDS entry. Filled in, each is held to X's limits like any play's.
pub const SHELL_PAGE_TITLE : str = "{spec} to {lang}, in a terminal inside the post";
pub const SHELL_PAGE_DESCRIPTION : str = "A terminal in your browser running the t27 compiler as WebAssembly: t27c gen {backend} prints the {lang} it emits for {spec}, and t27c test runs the spec's tests.";
pub const SHELL_PAGE_IMAGE_ALT : str = "The t27 player's terminal: t27c gen {backend} on {spec}, and the {lang} the compiler emitted, coloured.";

; --- What the terminal says ------------------------------------------------------------------
; Every word the terminal prints is one of these; public/play/shell.js holds none of its own.
; It fills the {names} and lays the columns out, nothing more. The generator refuses a SAY_
; constant that shell.js never says and a phrase shell.js says that is not here, so the two
; cannot drift. The name sets the colour: SAY_ERR_ red, SAY_WARN_ yellow, SAY_NOTE_ dim.
; shell.js is JavaScript by hand for one reason, measured: gen-js lowers declarations, not
; function bodies, so the terminal's logic cannot yet be a t27 spec compiled by this compiler.
pub const STAGES : [7]str = ["source", "lexer", "parser", "types", "hir", "backends", "tests"];
pub const SAY_CHECK : [6]str = ["{bytes} bytes, {lines} lines", "{tokens} tokens, {kinds} kinds, {dropped} dropped", "{nodes} nodes, depth {depth}, {top} top-level", "{errors} errors", "{bytes} bytes", "{ok} of {all} emitted, {bytes} bytes"];
pub const SAY_BANNER : str = "t27 terminal - {spec} - {count} backends";
pub const SAY_NOTE_START : str = "type help, or tap a command below";
pub const SAY_NOTE_BACKENDS : str = "backends: {backends}";
pub const SAY_NOTE_ALSO : str = "also understood: {alias}, the local command of a backend that runs here, and the names of native tools";
pub const SAY_SPEC_FILE : str = "the spec";
pub const SAY_RUNS_HERE : str = "runs in this page";
pub const SAY_FAILED : str = "failed";
pub const SAY_ERR_WHICH_FILE : str = "{cmd}: which file? ls lists them";
pub const SAY_ERR_NO_FILE : str = "{cmd}: {file}: no such file; ls lists them";
pub const SAY_ERR_NOT_EMITTED : str = "{backend} emitted nothing: {error}";
pub const SAY_SAVED : str = "asked your browser to download {file}, {bytes} bytes";
pub const SAY_ERR_NO_BACKEND : str = "{cmd}: no backend called {name}; the backends are {backends}";
pub const SAY_NOTE_GEN : str = "// {file}: {bytes} bytes of {lang}, compiled in {ms} ms by t27_compiler.wasm in this page";
pub const SAY_ERR_RUNNER : str = "the test runner stopped: {error}";
pub const SAY_NOTE_NO_TESTS : str = "this spec has no test or invariant block";
pub const SAY_TESTS : str = "{pass} pass, {fail} fail, {skip} skip";
pub const SAY_ASSERTS : str = "asserts: {count}";
pub const SAY_NOTE_CHECKED : str = "compiled in {ms} ms, in this page";
pub const SAY_NOTE_IMPORTING : str = "importing {file} into this page; its exports are printed, nothing is called";
pub const SAY_IMPORT_OK : str = "import ok: {count} exports";
pub const SAY_ERR_IMPORT : str = "import failed: {error}";
pub const SAY_WARN_NOT_HERE : str = "{lang} does not run in a browser: this page has no {tool}. On a machine that has it:";
pub const SAY_LOCAL_STEPS : [2]str = ["  $ save {file}", "  $ {command}"];
pub const SAY_NOTE_NO_CAST : str = "there is no recording of t27c on this spec";
pub const SAY_NOTE_REPLAY : str = "a recording of t27c on this spec, made on a real machine: the typing is staged, every byte printed is real";
pub const SAY_WARN_NATIVE : str = "{tool} is not in your browser: this page has the t27 compiler and nothing else";
pub const SAY_NOTE_NATIVE_RUN : str = "run {backend} prints the command for your machine";
pub const SAY_ERR_T27C : str = "t27c {sub}: not in this terminal; it has {commands}";
pub const SAY_ERR_NOT_FOUND : str = "{cmd}: command not found; help lists what this terminal does";
pub const SAY_ERR_THREW : str = "{cmd} stopped: {error}";
; Names a reader may type for a toolchain this page does not have, besides the first word of
; each BACKEND_RUN_LOCAL; and the real t27c's spelling of gen, which the terminal also takes.
pub const NATIVE_TOOLS : [7]str = ["gcc", "clang", "cargo", "verilator", "yosys", "deno", "bun"];
pub const SHELL_GEN_ALIAS : str = "t27c gen-{backend}";

; --- Plays ---------------------------------------------------------------------------------------
; One entry per play, the same position in every array. SPEC is a path under public/t27/files/;
; CAST names a recording published at public/term/<cast>/.
pub const PLAY_COUNT : u8 = 5;
pub const PLAY_IDS : [5]str = ["hello-world", "e8m0", "gfternary", "golden-sieve", "tnf17"];
pub const PLAY_SPECS : [5]str = ["specs/demos/hello_world.t27", "specs/numeric/e8m0.t27", "specs/numeric/gfternary.t27", "specs/numeric/golden_sieve.t27", "specs/numeric/tnf17.t27"];
pub const PLAY_CASTS : [5]str = ["t27c-hello-world", "t27c-e8m0", "t27c-gfternary", "t27c-golden-sieve", "t27c-tnf17"];
pub const PLAY_TITLES : [5]str = ["hello_world.t27, compiled inside the post", "e8m0.t27, the OCP MX scale byte, compiled inside the post", "gfternary.t27, phi-scaled ternary weights, compiled inside the post", "golden_sieve.t27, the ternary sieve, compiled inside the post", "tnf17.t27, a 17-bit ternary-exponent float, compiled inside the post"];
pub const PLAY_DESCRIPTIONS : [5]str = ["The t27 compiler, as WebAssembly, running on one spec in your browser: lexer to seven backends, the spec's own tests, the emitted code, its Verilog read for synthesis, and a terminal.", "The OCP MX shared scale as a t27 spec, compiled by t27c as WebAssembly in your browser: one byte, 2^(e-127), code 255 is NaN. Seven backends, the spec's own tests and its Verilog.", "Two-bit ternary weights {-phi, 0, +phi} as a t27 spec, compiled by t27c as WebAssembly in your browser. Seven backends; every test the page cannot run says why.", "The Golden Sieve as a t27 spec: five predicates a ternary weight alphabet must pass, compiled by t27c as WebAssembly in your browser. Seven backends; every test runs in the page.", "TNF17e as a t27 spec: a sign, a 7-bit offset holding four balanced trits, a 9-bit mantissa, compiled by t27c in your browser. Seven backends; every test the page cannot run says why."];
pub const PLAY_IMAGE_ALTS : [5]str = ["The t27 player: hello_world.t27 on the left, the compiler's stages on the right with token, node and backend counts, and tabs for tests, code, RTL and a terminal.", "The t27 player: e8m0.t27, the shared scale byte of the OCP Microscaling formats, on the left; the compiler's stages on the right with token, node and backend counts, and tabs for tests, code, RTL and a terminal.", "The t27 player: gfternary.t27, two-bit ternary weights scaled by phi, on the left; the compiler's stages on the right with token, node and backend counts, and tabs for tests, code, RTL and a terminal.", "The t27 player: golden_sieve.t27, the five predicates a ternary weight alphabet must pass, on the left; the compiler's stages on the right with token, node and backend counts, and tabs for tests, code, RTL and a terminal.", "The t27 player: tnf17.t27, a 17-bit float whose exponent is four balanced trits, on the left; the compiler's stages on the right with token, node and backend counts, and tabs for tests, code, RTL and a terminal."];

test the_player_is_sixteen_by_nine {
    assert PLAYER_WIDTH * 9 == PLAYER_HEIGHT * 16;
    assert IMAGE_WIDTH == PLAYER_WIDTH;
    assert IMAGE_HEIGHT == PLAYER_HEIGHT;
}

test the_image_is_large_enough_for_x_to_render {
    assert IMAGE_WIDTH * IMAGE_HEIGHT >= IMAGE_MIN_AREA;
}

test nothing_starts_by_itself_for_longer_than_the_limit {
    assert COMPILE_ANIMATION_MS <= AUTOPLAY_LIMIT_MS;
    assert COMPILE_ANIMATION_MS > 0;
    assert HAS_SOUND == false;
}

test focusing_the_editor_on_a_phone_does_not_zoom {
    assert EDITOR_TOUCH_FONT_PX >= IOS_FOCUS_ZOOM_BELOW_PX;
}

test a_skip_is_never_a_pass {
    assert SKIP_IS_NEVER_PASS == true;
    assert OUTCOMES[0] == "pass";
    assert OUTCOMES[1] == "fail";
    assert OUTCOMES[2] == "skip";
}

test the_piece_opens_on_the_compile_run {
    assert TABS[0] == FIRST_TAB;
    assert TABS[0] == "compile";
    assert TAB_LABELS[0] == "Compile";
}

test the_rtl_tab_reads_the_verilog_backend {
    assert TABS[4] == "rtl";
    assert TAB_LABELS[4] == "RTL";
}

test the_site_bundle_is_generated_with_the_rest {
    assert GENERATED[0] == "public/play/player.t27";
    assert GENERATED[1] == SITE_BUNDLE;
    assert SITE_MODULES[0] == "src/lib/highlight.ts";
}

test the_terminal_speaks_every_backend {
    assert BACKENDS[0] == "zig";
    assert BACKENDS[2] == "rust";
    assert BACKENDS[4] == "verilog_hir";
    assert BACKEND_PAGES[4] == "verilog-hir";
    assert BACKEND_EXTS[4] == ".hir.v";
    assert BACKEND_NAMES[5] == "JavaScript";
}

test only_javascript_runs_in_the_browser {
    assert RUNS_IN_BROWSER[0] == "js";
    assert BACKENDS[5] == RUNS_IN_BROWSER[0];
}

test the_typed_command_ends_inside_the_autoplay_limit {
    assert SHELL_DEMO_MAX_CHARS * SHELL_TYPE_MS <= AUTOPLAY_LIMIT_MS;
    assert SHELL_TYPE_MS > 0;
}

test the_terminal_is_a_tab_and_gen_is_a_command {
    assert TABS[5] == "term";
    assert TAB_LABELS[5] == "Term";
    assert SHELL_COMMANDS[0] == "help";
    assert SHELL_COMMANDS[5] == "t27c gen";
    assert SHELL_ARGS[5] == "[backend]";
    assert SHELL_CHIPS[0] == SHELL_COMMANDS[6];
}

test the_first_play_is_hello_world {
    assert PLAY_IDS[0] == "hello-world";
    assert PLAY_SPECS[0] == "specs/demos/hello_world.t27";
}

test the_second_play_is_the_mx_scale_byte {
    assert PLAY_IDS[1] == "e8m0";
    assert PLAY_SPECS[1] == "specs/numeric/e8m0.t27";
    assert PLAY_CASTS[1] == "t27c-e8m0";
}

test the_ternary_plays_follow_the_scale_byte {
    assert PLAY_COUNT == 5;
    assert PLAY_IDS[2] == "gfternary";
    assert PLAY_SPECS[2] == "specs/numeric/gfternary.t27";
    assert PLAY_IDS[3] == "golden-sieve";
    assert PLAY_SPECS[3] == "specs/numeric/golden_sieve.t27";
    assert PLAY_IDS[4] == "tnf17";
    assert PLAY_SPECS[4] == "specs/numeric/tnf17.t27";
    assert PLAY_CASTS[4] == "t27c-tnf17";
}

test the_terminal_reads_the_compile_stages {
    assert STAGES[0] == "source";
    assert STAGES[5] == "backends";
    assert STAGES[6] == "tests";
    assert SAY_CHECK[3] == "{errors} errors";
}
