    const at_cap : []const u8 = src[0..10 + 18 * (MAX_NODES as usize - 1)];
    const a : SpecGraph = export_graph("specs/x.t27", at_cap);
    assert a.node_count == MAX_NODES;
    assert validate_graph(a) == GRAPH_OK;
    const over : []const u8 = src;
    const g : SpecGraph = export_graph("specs/x.t27", over);
    assert g.node_count == MAX_NODES + 1;
    assert validate_graph(g) == ERR_TOO_MANY_NODES;
    assert export_verdict("specs/x.t27", over) == ERR_TOO_MANY_NODES;
    // negative controls: the verdict is the capacity one, and it is not OK
    assert export_verdict("specs/x.t27", over) != GRAPH_OK;
    assert export_verdict("specs/x.t27", over) != ERR_TOO_MANY_EDGES;
    assert export_verdict("specs/x.t27", at_cap) == GRAPH_OK;
}

test more_edges_than_the_ir_holds_is_refused_not_truncated {
    // 64 fns f00..f63 (1674 bytes with "module m;"), then 64 tests of 461 bytes that each call all 64
    // (64 x 64 = 4096 edges) and one more test that calls f00 once. A prefix of MAX_EDGES / 64 tests
    // is exactly at capacity; the whole source is one edge over, and the count says so
    const src : []const u8 = "module m;\nfn f00() u8 { return 1; }\nfn f01() u8 { return 1; }\nfn f02() u8 { return 1; }\nfn f03() u8 { return 1; }\nfn f04() u8 { return 1; }\nfn f05() u8 { return 1; }\nfn f06() u8 { return 1; }\nfn f07() u8 { return 1; }\nfn f08() u8 { return 1; }\nfn f09() u8 { return 1; }\nfn f10() u8 { return 1; }\nfn f11() u8 { return 1; }\nfn f12() u8 { return 1; }\nfn f13() u8 { return 1; }\nfn f14() u8 { return 1; }\nfn f15() u8 { return 1; }\nfn f16() u8 { return 1; }\nfn f17() u8 { return 1; }\nfn f18() u8 { return 1; }\nfn f19() u8 { return 1; }\nfn f20() u8 { return 1; }\nfn f21() u8 { return 1; }\nfn f22() u8 { return 1; }\nfn f23() u8 { return 1; }\nfn f24() u8 { return 1; }\nfn f25() u8 { return 1; }\nfn f26() u8 { return 1; }\nfn f27() u8 { return 1; }\nfn f28() u8 { return 1; }\nfn f29() u8 { return 1; }\nfn f30() u8 { return 1; }\nfn f31() u8 { return 1; }\nfn f32() u8 { return 1; }\nfn f33() u8 { return 1; }\nfn f34() u8 { return 1; }\nfn f35() u8 { return 1; }\nfn f36() u8 { return 1; }\nfn f37() u8 { return 1; }\nfn f38() u8 { return 1; }\nfn f39() u8 { return 1; }\nfn f40() u8 { return 1; }\nfn f41() u8 { return 1; }\nfn f42() u8 { return 1; }\nfn f43() u8 { return 1; }\nfn f44() u8 { return 1; }\nfn f45() u8 { return 1; }\nfn f46() u8 { return 1; }\nfn f47() u8 { return 1; }\nfn f48() u8 { return 1; }\nfn f49() u8 { return 1; }\nfn f50() u8 { return 1; }\nfn f51() u8 { return 1; }\nfn f52() u8 { return 1; }\nfn f53() u8 { return 1; }\nfn f54() u8 { return 1; }\nfn f55() u8 { return 1; }\nfn f56() u8 { return 1; }\nfn f57() u8 { return 1; }\nfn f58() u8 { return 1; }\nfn f59() u8 { return 1; }\nfn f60() u8 { return 1; }\nfn f61() u8 { return 1; }\nfn f62() u8 { return 1; }\nfn f63() u8 { return 1; }\ntest \"t\" { f00(); f01(); f02(); f03(); f04(); f05(); f06(); f07(); f08(); f09(); f10(); f11(); f12(); f13(); f14(); f15(); f16(); f17(); f18(); f19(); f20(); f21(); f22(); f23(); f24(); f25(); f26(); f27(); f28(); f29(); f30(); f