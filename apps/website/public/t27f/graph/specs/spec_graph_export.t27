f54(); f55(); f56(); f57(); f58(); f59(); f60(); f61(); f62(); f63(); }\ntest \"t\" { f00(); f01(); f02(); f03(); f04(); f05(); f06(); f07(); f08(); f09(); f10(); f11(); f12(); f13(); f14(); f15(); f16(); f17(); f18(); f19(); f20(); f21(); f22(); f23(); f24(); f25(); f26(); f27(); f28(); f29(); f30(); f31(); f32(); f33(); f34(); f35(); f36(); f37(); f38(); f39(); f40(); f41(); f42(); f43(); f44(); f45(); f46(); f47(); f48(); f49(); f50(); f51(); f52(); f53(); f54(); f55(); f56(); f57(); f58(); f59(); f60(); f61(); f62(); f63(); }\ntest \"t\" { f00(); f01(); f02(); f03(); f04(); f05(); f06(); f07(); f08(); f09(); f10(); f11(); f12(); f13(); f14(); f15(); f16(); f17(); f18(); f19(); f20(); f21(); f22(); f23(); f24(); f25(); f26(); f27(); f28(); f29(); f30(); f31(); f32(); f33(); f34(); f35(); f36(); f37(); f38(); f39(); f40(); f41(); f42(); f43(); f44(); f45(); f46(); f47(); f48(); f49(); f50(); f51(); f52(); f53(); f54(); f55(); f56(); f57(); f58(); f59(); f60(); f61(); f62(); f63(); }\ntest \"t\" { f00(); f01(); f02(); f03(); f04(); f05(); f06(); f07(); f08(); f09(); f10(); f11(); f12(); f13(); f14(); f15(); f16(); f17(); f18(); f19(); f20(); f21(); f22(); f23(); f24(); f25(); f26(); f27(); f28(); f29(); f30(); f31(); f32(); f33(); f34(); f35(); f36(); f37(); f38(); f39(); f40(); f41(); f42(); f43(); f44(); f45(); f46(); f47(); f48(); f49(); f50(); f51(); f52(); f53(); f54(); f55(); f56(); f57(); f58(); f59(); f60(); f61(); f62(); f63(); }\ntest \"t\" { f00(); }\n";
    const at_cap : []const u8 = src[0..1674 + 461 * (MAX_EDGES as usize / 64)];
    const a : SpecGraph = export_graph("specs/x.t27", at_cap);
    assert a.node_count == 129;
    assert a.edge_count == MAX_EDGES;
    assert validate_graph(a) == GRAPH_OK;
    const over : []const u8 = src;
    const g : SpecGraph = export_graph("specs/x.t27", over);
    assert g.node_count == 130;
    assert g.edge_count == MAX_EDGES + 1;
    assert validate_graph(g) == ERR_TOO_MANY_EDGES;
    // negative controls: it is the edge verdict, not the node one, and it is not OK
    assert export_verdict("specs/x.t27", over) == ERR_TOO_MANY_EDGES;
    assert export_verdict("specs/x.t27", over) != ERR_TOO_MANY_NODES;
    assert export_verdict("specs/x.t27", at_cap) == GRAPH_OK;
}

test an_empty_source_or_a_missing_path_is_refused {
    assert export_verdict("specs/x.t27", "") == ERR_SPEC_PATH;
    assert export_verdict("", "module m;\n") == ERR_SPEC_PATH;
    // negative control: a path and a line make a valid graph
    assert export_verdict("specs/x.t27", "module m;\n") == GRAPH_OK;
    assert export_verdict("specs/x.t27", "\n") == GRAPH_OK;
    assert export_graph("specs/x.t27", "").node_count == 1;
}

test tutorial_08_export_is_a_valid_graph_of_the_lesson {
    const g : SpecGraph = export_graph("specs/tutorial/08_modules_and_arrays.t27", TUTORIAL_08_SRC);
    assert validate_graph(g) == GRAPH_OK;
    assert g.spec_path == "specs/tutorial/08_modules_and_arrays.t27";
    assert g.line_count == 93;
    assert g.node_count == 14;
    assert g.edge_count == 9;
    assert g.node_name[0] == "tutorial-08-modules";
    assert g.line_start[0] == 1 and g.line_end[0] == 93;
    assert count_node_kind(g, NODE_USE) == 1;
    assert count_node_kind(g, NODE_CONST) == 5;
    assert count_node_kind(g, NODE_FN) == 3;
    assert count_node_kind(g, NODE_TEST) == 3;
    assert count_node_kind(g, NODE_INVARIANT) == 1;
    assert count_node_kind(g, NODE_OPAQUE) == 0;
    // negative control: the same lesson with a line cut off is a different graph
    const cut : SpecGraph = export_graph("specs/tutorial/08_modules_and_arrays.t27", "module tutorial-08-modules;\nuse base::types;\n");
    assert cut.node_count == 2;
    assert cut.node_count != g.node_count;
}

test tutorial_08_exports_the_fixture_exactly_except_what_is_derived {
    const e : SpecGraph = export_graph("specs/tutorial/08_modules_and_arrays.t27", TUTORIAL_08_SRC);
    const f : SpecGraph = tutorial_08_graph();
    assert validate_graph(e) == GRAPH_OK;
    assert validate_graph(f) == GRAPH_OK;
    assert e.spec_path == f.spec_path;
    assert e.line_count == f.line_count;
    // the 14 declaration nodes are identical, node by node: kind, label, name and span
    assert nodes_in_common(e, f) == 14;
    assert node_matches(e, f, 0);
    assert node_matches(e, f, 4);
    assert node_matches(e, f, 10);
    assert node_matches(e, f, 13);
    // difference 1: the fixture's node 14 (std.testing, UNKNOWN) is inferred from call targets,
    // not declared in the file, so the scanner does not produce it
    assert f.node_count == 15;
    assert e.node_count == 14;
    assert f.node_label[14] == LABEL_UNKNOWN;
    // every edge the scanner reads is in the fixture, with the same kind, endpoints, label and line
    assert e.edge_count == 9;
    assert edges_shared(e, f) == 9;
    // every EXACT edge of the fixture is one the scanner reads
    assert count_edge_label(f, LABEL_EXACT) == 9;
    assert edges_shared(f, e) == 9;
    // difference 2: the fixture's other 7 edges are DERIVED (4 data flow, 3 tested_by), and the scanner never derives
    assert f.edge_count == 16;
    assert f.edge_count - edges_shared(f, e) == 7;
    assert count_edge_label(f, LABEL_DERIVED) == 7;
    assert count_edge_kind(f, EDGE_DATA_FLOW) == 4;
    assert count_edge_kind(f, EDGE_TESTED_BY) == 3;
    assert count_edge_kind(e, EDGE_DATA_FLOW) == 0;
    assert count_edge_kind(e, EDGE_TESTED_BY) == 0;
    // the nine, by name: USES 0->1 22, 4->2 38, 4->3 38, 8->6 67, 9->7 71; CALLS 10->8 79, 11->9 84, 12->4 89; CONSTRAINS 13->2 93
    assert edge_in(e, EDGE_USES, 0, 1, LABEL_EXACT, 22);
    assert edge_in(e, EDGE_USES, 4, 2, LABEL_EXACT, 38);
    assert edge_in(e, EDGE_USES, 4, 3, LABEL_EXACT, 38);
    assert edge_in(e, EDGE_USES, 8, 6, LABEL_EXACT, 67);
    assert edge_in(e, EDGE_USES, 9, 7, LABEL_EXACT, 71);
    assert edge_in(e, EDGE_CALLS, 10, 8, LABEL_EXACT, 79);
    assert edge_in(e, EDGE_CALLS, 11, 9, LABEL_EXACT, 84);
    assert edge_in(e, EDGE_CALLS, 12, 4, LABEL_EXACT, 89);
    assert edge_in(e, EDGE_CONSTRAINS, 13, 2, LABEL_EXACT, 93);
    // negative controls: the comparison can fail. A fixture with one span moved is not matched,
    // and one with an edge line moved shares one fewer edge.
    var moved : SpecGraph = tutorial_08_graph();
    moved.line_end[4] = 40;
    assert node_matches(e, moved, 4) == false;
    assert nodes_in_common(e, moved) == 13;
    var shifted : SpecGraph = tutorial_08_graph();
    shifted.edge_line[1] = 37;
    assert edges_shared(e, shifted) == 8;
    assert edges_shared(e, shifted) != edges_shared(e, f);
}
