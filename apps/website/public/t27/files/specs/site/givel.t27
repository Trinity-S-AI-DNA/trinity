// SPDX-License-Identifier: Apache-2.0
; specs/site/givel.t27 -- the GIVEL campus site map as a law, not a wiki page.
; Measured 2026-10-27 on the live edge (igor-house.duckdns.org, Caddy) and its
; upstreams, from the VPS and from outside: 13 edge handles, two of them DEAD.
; This file is the SSOT the T27F graph renders (the trinity spec sync vendors
; t27/specs); an edge change that skips this file is a drift the map refuses.
; Closes #12801.
; --
module SiteGivel;

pub const ROUTE_COUNT : u32 = 11;

// route transport kinds: what the edge handle does with the request
pub const KIND_FILE : u32 = 1;   // the Caddy file server (no upstream port)
pub const KIND_PROXY : u32 = 2;  // reverse_proxy to a local port
pub const KIND_TUNNEL : u32 = 3; // reverse_proxy through an ssh remote-forward

// upstream ports, one per route
pub const UP_VIBEE : u32 = 18090;    // /vibee/*    (sshd remote-forward)
pub const UP_TMA : u32 = 8791;       // /tma/*      (givel-tma, the owner CRM)
pub const UP_API : u32 = 8890;       // the FIVE /api/* prefixes: ONE service
pub const UP_MEDIA : u32 = 8891;     // /media/*
// REMOVED from the edge 2026-10-27 (the handle is commented out in the
// Caddyfile, config preserved): /oauth/threads* -> 8892, refused since before
// the audit. The upstream port is kept as evidence, not as a route.
pub const UP_OAUTH : u32 = 8892;
pub const UP_CATALOG : u32 = 8893;   // /catalog-api/*
pub const UP_ADMIN : u32 = 8894;     // /admin*
// REMOVED from the edge 2026-10-27: the site fallback -> 5678, refused since
// before the audit. The edge now answers 404 honestly for unmatched paths
// (Caddy's default for an unmatched path is an EMPTY 200 -- a lie of success).
pub const UP_FALLBACK : u32 = 5678;

// probe results measured 2026-10-27 (http code; 0 = connection refused)
pub const PROBE_TMA : u32 = 200;
pub const PROBE_API : u32 = 404;     // an api root 404s: alive is not "200"
pub const PROBE_MEDIA : u32 = 200;
pub const PROBE_OAUTH : u32 = 0;     // DEAD: the upstream refuses connections
pub const PROBE_CATALOG : u32 = 404;
pub const PROBE_ADMIN : u32 = 302;
pub const PROBE_FALLBACK : u32 = 0;  // DEAD: the site fallback refuses

/// Alive is "the upstream answered at all": an api root 404 and an admin
/// 302 are alive; 0 (refused) is dead. The map must never read a dead
/// upstream as up.
pub fn route_alive(probe_code: u32) -> bool {
    return probe_code > 0;
}

/// The five /api/* prefixes are ONE service on one port: DRY on the wire.
/// A map that splits them into five upstreams is a drift.
pub fn api_shared_port(port: u32) -> bool {
    return port == UP_API;
}

/// An edge handle may be claimed UP only when its probe says alive. This is
/// the verdict the auditor runs per route: marked_up and !alive -> the map
/// lies (today: /oauth/threads and the fallback would fail this law).
pub fn map_honest(marked_up: bool, probe_code: u32) -> bool {
    if (marked_up == false) { return true; }
    return route_alive(probe_code);
}

/// The edge serves exactly ROUTE_COUNT handles -- the drift law between the
/// live Caddyfile and this spec.
pub fn route_count_matches(seen: u32) -> bool {
    return seen == ROUTE_COUNT;
}

test the_map_refuses_dead_upstreams_marked_up {
    assert route_alive(PROBE_OAUTH) == false;
    assert route_alive(PROBE_FALLBACK) == false;
    assert map_honest(true, PROBE_OAUTH) == false;
    assert map_honest(true, PROBE_FALLBACK) == false;
    assert map_honest(true, PROBE_TMA) == true;
    assert map_honest(true, PROBE_API) == true;
    assert map_honest(true, PROBE_ADMIN) == true;
    assert map_honest(false, PROBE_OAUTH) == true;
}

test an_answer_of_any_code_is_alive_refused_is_not {
    assert route_alive(200) == true;
    assert route_alive(404) == true;
    assert route_alive(302) == true;
    assert route_alive(0) == false;
}

test the_api_prefixes_share_one_upstream {
    assert api_shared_port(UP_API) == true;
    assert api_shared_port(UP_MEDIA) == false;
    assert api_shared_port(0) == false;
}

test the_edge_serves_eleven_handles {
    assert route_count_matches(11) == true;
    assert route_count_matches(10) == false;
    assert route_count_matches(12) == false;
    // the two removed routes' upstreams are still refused -- the map's
    // negative examples stay true even though the edge no longer routes them
    assert route_alive(PROBE_OAUTH) == false;
    assert route_alive(PROBE_FALLBACK) == false;
}
