// SPDX-License-Identifier: Apache-2.0
; Vibecoding, lesson 26: Build it, then measure one thing.
; After your project runs, pick ONE thing to measure and read it from a run, not from a hunch.
; Made-up example: the reading log from lesson 25 was run on 4 titles and kept 3 of them.
; The measure is the share kept. Plant a bug: set KEPT to 5 and see which test goes red.
; phi^2 + 1/phi^2 = 3 | TRINITY

module vibecoding_measure;

; What the run printed.
pub const RUNS : u8 = 4;
pub const KEPT : u8 = 3;

test a_measure_needs_at_least_one_run {
    assert RUNS > 0;
}

test a_run_cannot_keep_more_than_it_was_given {
    assert KEPT <= RUNS;
}

test the_share_kept_is_read_from_the_run {
    assert KEPT * 100 / RUNS == 75;
}
