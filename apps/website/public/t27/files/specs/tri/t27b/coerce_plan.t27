// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/coerce_plan.t27 -- how t27b lowers a value of one numeric type where Zig 0.16 accepts it in
; another: the `type mismatch` family of t27b coverage (epic #6063; written in t27 under the port epic #6198).
; gen-zig prints a comparison, an operator, a typed `const`, an argument and a `return` as written, so t27b
; must give each the meaning Zig gives it. Before this plan t27b took only a lossless integer widening and
; f32 to f64, and refused the rest as `type mismatch`; the reference passes specs that use more:
; gf16.t27 (`gf16_extract_exponent(x) == EXP_MAX`, an i8 against a u8 constant), workflow.t27
; (`return workflow.steps.len;` in a fn that returns i32) and gen_perceptron.t27
; (`const diff: f64 = target - guess;` with two i32).
; Everything t27b decides about these values is in this file and reaches cli/t27b through `t27c gen-rust`
; (gen/rust/tri/t27b/coerce_plan.rs). The Rust glue in cli/t27b/src/lower.rs reads the widths and the
; signedness of the two types, whether the value is a constant and whether that constant fits, asks the plan,
; and builds the IR node the answer names: the value itself, a Widen, the constant retyped, an IntToFloat,
; or the refusal it already had.
; --
; The rules, measured with zig 0.16.0 (Debug, x86_64) on the t27c lab for this plan:
;   A constant here is a value t27b holds as an IR constant: a module const, an array's `.len`, an element
;   of a constant array at a constant index, and `+ - * & | ^` (wrapping or not) over such constants. Zig
;   knows each of them at compile time.
;   An integer reaches another integer type when every value of its type fits (same signedness and not
;   narrower, or unsigned into a strictly wider signed type), or when it is a constant whose value fits:
;   `const s: u4 = A - B;` with A = 9 and B = 4 two u8 constants, `return arr.len;` into an i32.
;   `+ - * & | ^` and the arms of an `if` with no result type take the peer type of two integer operands:
;   the type with more bits, the first operand's on a tie (i8 + u8 const 63 is an i8; u8 const 63 + i8 is a
;   u8, which Zig refuses since an i8 variable does not fit it; i8 const 5 + u16 is a u16). Then each
;   operand reaches that type by the rule above.
;   Two integers compare by value, whatever their types, even when neither is a constant (-1 < 0u8, and
;   -1 != 255). t27b compares them in the type one of them widens to, else in i64 when both widen to it,
;   else in the type of the one the other is a constant that fits. What is left -- a u64 against a signed
;   variable -- would need 65 bits, and stays refused.
;   An integer reaches a float type when the float holds every value of its type exactly: an unsigned type
;   of at most p bits, a signed one of at most p + 1, p being the significand's bits (53 for an f64, 24
;   for an f32, 11 for an f16): u53 and i54 reach an f64, u54 and i64 do not; u24 and i25 reach an f32,
;   i32 does not. A constant also reaches it when the float holds its value exactly (a u64 2^60 into an
;   f64, but not 2^60 + 1; 2^25 into an f32, but not 2^24 + 1). The conversion is exact, so it never
;   rounds. An operator or a comparison of a float and an integer converts the integer to the float's type
;   by the same rule (f64 * i32 is an f64; f32 + i32 is refused).
;   Folding: `+ - * & | ^` on two constants of one integer type folds when the result fits the type; the
;   wrapping `+% -% *%` always fold, to the wrapped value. A result that does not fit stays the run-time
;   operation it was, as before this plan (Zig refuses it where it analyzes it). `/`, `%` and the shifts
;   are not folded here.
; --
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bCoercePlan;

// `widens` (Zig's lossless integer rule) and the test helpers `icp_bits` / `icp_signed` are
// int_cast_plan.t27's, not written twice; gen-rust copies what it needs of that plan into this plan's
// generated file. No name here is also one of int_cast_plan's, so neither shadows the other there.
use tri::t27b::int_cast_plan;

// How an integer value reaches another integer type (int_to_int), or a float type (int_to_float).
pub const INT_KEEP : u8 = 0;
pub const INT_WIDEN : u8 = 1;
pub const INT_FOLD : u8 = 2;
pub const CONVERT : u8 = 3;
pub const REFUSE : u8 = 4;

// The type two integers of different types are compared in (compare_in).
pub const IN_A : u8 = 5;
pub const IN_B : u8 = 6;
pub const IN_I64 : u8 = 7;

/// An integer of type (from_bits, from_signed) where the integer type (to_bits, to_signed) is wanted.
/// is_const: the value is a constant. fits: that constant is inside the wanted type.
pub fn int_to_int(from_bits: u32, from_signed: bool, to_bits: u32, to_signed: bool, is_const: bool, fits: bool) -> u8 {
    if (from_bits == to_bits and from_signed == to_signed) { return INT_KEEP; }
    if (widens(from_bits, from_signed, to_bits, to_signed)) { return INT_WIDEN; }
    if (is_const and fits) { return INT_FOLD; }
    return REFUSE;
}

/// The bits of a float type's significand, the implicit one included; 0 for a width t27b has no float of.
pub fn significand(float_bits: u32) -> u32 {
    if (float_bits == 64) { return 53; }
    if (float_bits == 32) { return 24; }
    if (float_bits == 16) { return 11; }
    return 0;
}

/// The bits from the highest set bit of mag to its lowest: what a significand needs to hold mag. 0 for 0.
pub fn span(mag: u64) -> u32 {
    if (mag == 0) { return 0; }
    var m : u64 = mag;
    while (m % 2 == 0) {
        m = m / 2;
    }
    var n : u32 = 0;
    while (m != 0) {
        m = m / 2;
        n = n + 1;
    }
    return n;
}

/// An integer of type (from_bits, from_signed) where the float type of float_bits is wanted. is_const: the
/// value is a constant; mag: its magnitude (ignored for a variable).
pub fn int_to_float(from_bits: u32, from_signed: bool, float_bits: u32, is_const: bool, mag: u64) -> u8 {
    const p : u32 = significand(float_bits);
    if (p == 0) { return REFUSE; }
    if (from_signed and from_bits <= p + 1) { return CONVERT; }
    if (!from_signed and from_bits <= p) { return CONVERT; }
    if (is_const and span(mag) <= p) { return CONVERT; }
    return REFUSE;
}

/// The peer type of two integer operands of `+ - * & | ^` or of an `if`'s arms: true when it is the first
/// operand's type (a_bits wide), false when it is the second's.
pub fn peer_is_first(a_bits: u32, b_bits: u32) -> bool {
    return a_bits >= b_bits;
}

/// The type in which two integers of the types a and b compare by value. a_fits_b: a is a constant inside
/// type b; b_fits_a likewise. REFUSE when there is none.
pub fn compare_in(a_bits: u32, a_signed: bool, a_fits_b: bool, b_bits: u32, b_signed: bool, b_fits_a: bool) -> u8 {
    if (widens(b_bits, b_signed, a_bits, a_signed)) { return IN_A; }
    if (widens(a_bits, a_signed, b_bits, b_signed)) { return IN_B; }
    if (widens(a_bits, a_signed, 64, true) and widens(b_bits, b_signed, 64, true)) { return IN_I64; }
    if (b_fits_a) { return IN_A; }
    if (a_fits_b) { return IN_B; }
    return REFUSE;
}

// The bytes of an operator as the t27c parser spells it, for `folds`. They are passed as numbers: gen-rust
// gives a `[]const u8` parameter the type `&'static str` in a file with no range slice (#7449), which the
// glue's operator text is not, and a character literal does not compare with a u8 there (#7604).
pub const B_PLUS : u8 = 43;
pub const B_MINUS : u8 = 45;
pub const B_STAR : u8 = 42;
pub const B_AMP : u8 = 38;
pub const B_BAR : u8 = 124;
pub const B_CARET : u8 = 94;
pub const B_PERCENT : u8 = 37;

/// Does the operator of `len` bytes, `first` then `second` (0 for a one-byte operator), on two constants of
/// one integer type fold to a constant, given whether the exact result fits that type? The wrapping
/// `+% -% *%` always fold; the glue folds to the result wrapped to the type, which is the result itself
/// when it fits.
pub fn folds(first: u8, second: u8, len: usize, fits: bool) -> bool {
    const arith : bool = first == B_PLUS or first == B_MINUS or first == B_STAR;
    if (len == 2 and arith and second == B_PERCENT) { return true; }
    if (len != 1 or !fits) { return false; }
    return arith or first == B_AMP or first == B_BAR or first == B_CARET;
}

/// Why a comparison is refused (after `type mismatch` and the operator).
pub fn compare_why(act: u8) -> str {
    if (act == REFUSE) { return "a u64 against a signed type needs 65 bits to compare in"; }
    return "";
}

// ---------------------------------------------------------------- tests

test a_variable_keeps_its_type_or_widens {
    assert int_to_int(8, true, 8, true, false, false) == INT_KEEP;
    assert int_to_int(64, false, 64, false, true, true) == INT_KEEP;
    assert int_to_int(8, false, 16, false, false, false) == INT_WIDEN;
    assert int_to_int(8, true, 64, true, false, false) == INT_WIDEN;
    assert int_to_int(32, false, 64, true, false, false) == INT_WIDEN;
    assert int_to_int(31, false, 32, true, false, false) == INT_WIDEN;
    assert int_to_int(8, false, 8, true, false, false) == REFUSE;
    assert int_to_int(64, false, 32, true, false, false) == REFUSE;
    assert int_to_int(8, true, 64, false, false, false) == REFUSE;
    assert int_to_int(16, false, 8, false, false, true) == REFUSE;
}

test a_constant_that_fits_is_retyped {
    // workflow.t27: `return workflow.steps.len;` is a u64 5 into an i32.
    assert int_to_int(64, false, 32, true, true, true) == INT_FOLD;
    // gf16.t27: `const trunc_shift : u4 = 9 - 4;` over two u8 constants.
    assert int_to_int(8, false, 4, false, true, true) == INT_FOLD;
    // ocp_mx.t27: KIND_TOP[K_E4M3], an i64 3 as an index.
    assert int_to_int(64, true, 64, false, true, true) == INT_FOLD;
    assert int_to_int(8, false, 8, true, true, true) == INT_FOLD;
    assert int_to_int(8, false, 8, true, true, false) == REFUSE;
    assert int_to_int(64, false, 32, true, true, false) == REFUSE;
    // A widening constant widens: the value is the same either way.
    assert int_to_int(8, false, 16, false, true, true) == INT_WIDEN;
}

test the_peer_type_has_more_bits_and_the_first_wins_a_tie {
    assert peer_is_first(8, 8);
    assert peer_is_first(16, 8);
    assert !peer_is_first(8, 16);
    assert !peer_is_first(8, 64);
    assert peer_is_first(64, 64);
    assert peer_is_first(5, 4);
    assert !peer_is_first(3, 4);
    // i8 + u8 const 63: the i8 wins, and 63 fits it.
    assert int_to_int(8, false, 8, true, true, true) == INT_FOLD;
    // u8 const 63 + i8 variable: the u8 wins, and the variable does not reach it.
    assert int_to_int(8, true, 8, false, false, false) == REFUSE;
    // i8 const 5 + u16: the u16 wins.
    assert int_to_int(8, true, 16, false, true, true) == INT_FOLD;
    // u8 + i8 const -1: the u8 wins, and -1 does not fit it.
    assert int_to_int(8, true, 8, false, true, false) == REFUSE;
}

test integers_compare_in_a_type_that_holds_both {
    assert compare_in(8, true, false, 8, false, false) == IN_I64;
    assert compare_in(8, false, false, 8, true, false) == IN_I64;
    assert compare_in(64, true, false, 32, false, false) == IN_A;
    assert compare_in(32, false, false, 64, true, false) == IN_B;
    assert compare_in(8, false, false, 16, false, false) == IN_B;
    assert compare_in(32, true, false, 32, false, false) == IN_I64;
    assert compare_in(63, false, false, 64, true, false) == IN_B;
    // A u64 against a signed type: only a constant that fits the other side.
    assert compare_in(64, false, false, 64, true, true) == IN_A;
    assert compare_in(64, true, true, 64, false, false) == IN_B;
    assert compare_in(64, false, false, 8, true, true) == IN_A;
    assert compare_in(64, false, false, 64, true, false) == REFUSE;
    assert compare_in(8, true, false, 64, false, false) == REFUSE;
    assert compare_why(REFUSE).len > 0;
    assert compare_why(IN_A).len == 0;
}

// Over u8 .. i64 (64 ordered pairs): two variables compare in one of their types or in i64, always one that
// holds both, for every pair but the 8 that put u64 against i8, i16, i32 or i64, in either order.
test every_pair_but_u64_against_signed_has_a_type {
    var refused : u32 = 0;
    var a : u32 = 0;
    while (a < 8) {
        var b : u32 = 0;
        while (b < 8) {
            const r : u8 = compare_in(icp_bits(a), icp_signed(a), false, icp_bits(b), icp_signed(b), false);
            if (r == REFUSE) {
                refused = refused + 1;
                const u64_first : bool = icp_bits(a) == 64 and !icp_signed(a) and icp_signed(b);
                const u64_second : bool = icp_bits(b) == 64 and !icp_signed(b) and icp_signed(a);
                assert u64_first or u64_second;
            }
            if (r == IN_A) { assert widens(icp_bits(b), icp_signed(b), icp_bits(a), icp_signed(a)); }
            if (r == IN_B) { assert widens(icp_bits(a), icp_signed(a), icp_bits(b), icp_signed(b)); }
            if (r == IN_I64) {
                assert widens(icp_bits(a), icp_signed(a), 64, true);
                assert widens(icp_bits(b), icp_signed(b), 64, true);
            }
            b = b + 1;
        }
        a = a + 1;
    }
    assert refused == 8;
}

test a_float_holds_every_value_of_a_narrow_enough_integer_type {
    assert significand(64) == 53;
    assert significand(32) == 24;
    assert significand(16) == 11;
    assert significand(128) == 0;
    // gen_perceptron.t27: `const diff: f64 = target - guess;` with two i32.
    assert int_to_float(32, true, 64, false, 0) == CONVERT;
    assert int_to_float(32, false, 64, false, 0) == CONVERT;
    assert int_to_float(53, false, 64, false, 0) == CONVERT;
    assert int_to_float(54, false, 64, false, 0) == REFUSE;
    assert int_to_float(54, true, 64, false, 0) == CONVERT;
    assert int_to_float(64, true, 64, false, 0) == REFUSE;
    assert int_to_float(64, false, 64, false, 0) == REFUSE;
    assert int_to_float(24, false, 32, false, 0) == CONVERT;
    assert int_to_float(25, false, 32, false, 0) == REFUSE;
    assert int_to_float(25, true, 32, false, 0) == CONVERT;
    assert int_to_float(32, true, 32, false, 0) == REFUSE;
    assert int_to_float(8, false, 32, false, 0) == CONVERT;
    assert int_to_float(11, false, 16, false, 0) == CONVERT;
    assert int_to_float(12, false, 16, false, 0) == REFUSE;
    assert int_to_float(12, true, 16, false, 0) == CONVERT;
    assert int_to_float(8, true, 128, false, 0) == REFUSE;
}

test a_float_holds_a_constant_whose_bits_span_its_significand {
    assert span(0) == 0;
    assert span(1) == 1;
    assert span(5) == 3;
    assert span(1152921504606846976) == 1;
    assert span(1152921504606846977) == 61;
    assert span(18446744073709551615) == 64;
    assert span(9223372036854775808) == 1;
    assert span(16777217) == 25;
    // A u64 2^60 into an f64, and not 2^60 + 1.
    assert int_to_float(64, false, 64, true, 1152921504606846976) == CONVERT;
    assert int_to_float(64, false, 64, true, 1152921504606846977) == REFUSE;
    // An i64 -2^63 into an f64.
    assert int_to_float(64, true, 64, true, 9223372036854775808) == CONVERT;
    // A u32 2^25 into an f32, and not 2^24 + 1.
    assert int_to_float(32, false, 32, true, 33554432) == CONVERT;
    assert int_to_float(32, false, 32, true, 16777217) == REFUSE;
    assert int_to_float(64, false, 64, true, 9007199254740993) == REFUSE;
    assert int_to_float(64, false, 64, true, 9007199254740992) == CONVERT;
    // A span of exactly the significand still fits: 2^53 - 1 into an f64, 2^24 - 1 into an f32.
    assert span(9007199254740991) == 53;
    assert int_to_float(64, false, 64, true, 9007199254740991) == CONVERT;
    assert int_to_float(32, false, 32, true, 16777215) == CONVERT;
}

test constants_fold_when_the_result_fits_or_wraps {
    assert folds(B_PLUS, 0, 1, true);
    assert folds(B_MINUS, 0, 1, true);
    assert folds(B_STAR, 0, 1, true);
    assert folds(B_AMP, 0, 1, true);
    assert folds(B_BAR, 0, 1, true);
    assert folds(B_CARET, 0, 1, true);
    assert !folds(B_PLUS, 0, 1, false);
    assert !folds(B_MINUS, 0, 1, false);
    assert !folds(B_STAR, 0, 1, false);
    assert folds(B_PLUS, B_PERCENT, 2, false);
    assert folds(B_MINUS, B_PERCENT, 2, false);
    assert folds(B_STAR, B_PERCENT, 2, true);
    // `/`, `%`, `<<`, `>>`, `+=` and `|%` do not fold here.
    assert !folds(47, 0, 1, true);
    assert !folds(B_PERCENT, 0, 1, true);
    assert !folds(60, 60, 2, true);
    assert !folds(62, 62, 2, true);
    assert !folds(B_PLUS, 61, 2, true);
    assert !folds(B_BAR, B_PERCENT, 2, true);
    assert !folds(B_PLUS, B_PERCENT, 3, true);
    assert !folds(B_PLUS, 0, 0, true);
}

// The glue passes the operator's own bytes, so each constant is its character's ASCII code.
test the_operator_bytes_are_their_ascii_codes {
    assert B_PLUS == 43;
    assert B_MINUS == 45;
    assert B_STAR == 42;
    assert B_AMP == 38;
    assert B_BAR == 124;
    assert B_CARET == 94;
    assert B_PERCENT == 37;
    assert folds(43, 37, 2, false);
    assert folds(94, 0, 1, true);
}
