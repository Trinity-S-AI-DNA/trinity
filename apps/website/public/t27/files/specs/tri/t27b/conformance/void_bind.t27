// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/void_bind.t27 -- a local bound to the result of a void fn, as the reference runs
; it (gHashTag/t27#7690, a lane of #6063). Every test here passes `t27c test-report`; t27b must give the
; same verdict on each, or refuse the file.
; What t27c's Zig backend prints: `const result = f(x);` as written (`var result = f(x);` and
; `_ = &result;` for a var), plus `_ = result;` when nothing reads it. Zig accepts it, because `void` is a
; value: the call runs once, for its effects, in statement order, and the local holds void's one value.
; `result == undefined` is comptime true and `result != undefined` comptime false, either way round.
; The shapes are the corpus's own: a test step that passes a const pointer (specs/tri/graph/graph.t27's
; `when result = add_node(&graph)`), one that passes a slice to a fn that returns at once
; (specs/tri/graph/bellman_ford.t27), a `const` compared with `undefined` after a void fn spelled the Zig
; way (specs/port/browseros/.../browser/history.t27) and a `var` compared the same way
; (specs/port/scripts/gen_w381_lean.t27). Then: the order of several such calls, arguments that run once,
; a void local passed on to a `void` parameter, and void results bound inside a fn body.
; Every test reads a module var the void calls write, so each has a runtime assert.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceVoidBind;

var VB_COUNT: u32 = 0;
var VB_LOG: u32 = 0;

pub const VbGraph = struct {
    nodes: u32,
    directed: bool,
};

pub const VbEdge = struct {
    from: u32,
    to: u32,
};

fn vb_graph(n: u32) -> VbGraph {
    return VbGraph{ .nodes = n, .directed = false };
}

/// Adds `by` to VB_COUNT. No result.
fn vb_bump(by: u32) -> void {
    VB_COUNT = VB_COUNT + by;
}

/// Appends the digit `d` to VB_LOG. No result.
fn vb_note(d: u32) -> void {
    VB_LOG = VB_LOG * 10 + d;
}

/// One more than VB_COUNT, which it keeps.
fn vb_next() -> u32 {
    VB_COUNT = VB_COUNT + 1;
    return VB_COUNT;
}

/// graph.t27's add_node: reads through a const pointer.
fn vb_add_node(graph: *const VbGraph) -> void {
    VB_COUNT = VB_COUNT + graph.nodes;
}

/// bellman_ford.t27's shortest_path: returns at once.
fn vb_relax(edges: []VbEdge) -> void {
    return;
}

/// history.t27's deleteUrl, its result spelled the Zig way.
pub fn vb_forget(key: []const u8, n: u32) void {
    VB_COUNT = VB_COUNT + n;
}

/// A `void` parameter beside one that matters.
fn vb_take(v: void, n: u32) -> u32 {
    return n + 1;
}

/// Void results bound in a fn body, then the count they left.
fn vb_twice(by: u32) -> u32 {
    const first = vb_bump(by);
    const second = vb_bump(by);
    return VB_COUNT;
}

test a_step_binds_the_result_and_runs_the_call
    given graph = vb_graph(4)
    when result = vb_add_node(&graph)
    then VB_COUNT == 4

test a_step_compares_the_result_with_undefined
    when result = vb_bump(9)
    then result == undefined
    then VB_COUNT == 9

test the_calls_run_once_each_in_order {
    const a = vb_note(1);
    const b = vb_note(2);
    const c = vb_note(3);
    assert(VB_LOG == 123);
}

test the_arguments_run_once {
    const a = vb_note(vb_next());
    const b = vb_note(vb_next());
    assert(VB_LOG == 12);
    assert(VB_COUNT == 2);
}

test a_const_result_equals_undefined {
    const r = vb_forget("https://example.com", 2);
    assert(r == undefined);
    assert(undefined == r);
    assert((r != undefined) == false);
    assert(VB_COUNT == 2);
}

test a_var_result_equals_undefined {
    var r = vb_bump(7);
    assert(r == undefined);
    assert(VB_COUNT == 7);
}

test a_void_result_is_passed_on {
    const r = vb_bump(1);
    assert(vb_take(r, VB_COUNT) == 2);
}

test a_slice_to_a_fn_that_returns_at_once {
    const input = []VbEdge;
    const r = vb_relax(input);
    const s = vb_bump(3);
    assert(VB_COUNT == 3);
}

test a_fn_body_binds_void_results {
    assert(vb_twice(3) == 6);
    assert(VB_COUNT == 6);
}
