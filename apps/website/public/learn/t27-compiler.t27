pub const LESSON_GOALS : [27]str = [
    "How the lexer sorts one byte into a letter, a digit or a gap, and why the underscore is a letter.",
    "Where three scanners stop when they all start at the same byte.",
    "Which limit each of the assembler's three number doors has, and why a digit run is judged before it is read.",
    "Which of two operators splits an expression, and why the tightest operators group first.",
    "How a backend can tell from text alone that an operator lost its right side.",
    "How a parser names the reason it refused a line, and why the same line always gets the same reason.",
    "What the compiler makes of a type name before it knows any types: its width, its suffix and its spaces.",
    "Which tuple types the Verilog backend lowers, decided from their text alone.",
    "Where an if/else can sit as a value, and what each of seven small bodies hands back.",
    "How the compiler turns the LUT depth of a path into a delay and the clock that delay allows.",
    "How five short formulas estimate the power of a design from its resources, its clock and its toggle rate.",
    "How fanout picks a wire class, how congestion is counted and how many buffers a clock tree needs.",
    "Why a unary operator must cover everything inside a bracket, and what small case pins it.",
    "When an optimizer may share a repeated expression and when the shared value has gone stale.",
    "Why a spec can pass in Zig and still fail in rustc, and which four cases keep the Rust backend honest.",
    "How five facts decide whether t27c compile may write its output over a file that is already there.",
    "Where in a file the words generated by t27c must sit to count, and why deeper is only a comment.",
    "Why seal --verify must compare a committed generated file with its generator and not with the recorded hash.",
    "How a checker that did not build a seal judges its parts in a fixed order and fails closed.",
    "What receipt an agent reads before it reuses a spec, and in which order the verdict is decided.",
    "What a seal file holds after a run is killed, for each of three ways of writing it.",
    "Which compilers a table of ten questions removes, and why unknown is kept apart from no.",
    "Why seven builds of one commit gave t27c four different binaries, and how a cause model is tested.",
    "What a match proves when the compiler is rebuilt by three routes and compared with its own text.",
    "How one line of text becomes one 32-bit word and comes back, and why every 32-bit word round-trips.",
    "How 47 opcodes share one 32-bit word in three shapes, and which bits each field reads.",
    "In which order a loader refuses a program file, and what its six header bytes hold."
];
pub const LESSON_TEXTS : [27]str = [
    "The lexer of the t27 compiler reads bytes, not letters. is_alpha accepts A to Z, a to z and the underscore. is_digit accepts 0 to 9, and is_hex_digit adds A to F and a to f. is_alnum is a letter or a digit. is_whitespace accepts the space, the tab, the line feed and the carriage return, bytes 32, 9, 10 and 13. Every other byte is something else, and a character outside ASCII is two or more of them. lexer.t27 declares 20 functions; these five are the ones WebAssembly can run, because the others scan a struct.",
    "The t27a assembler reads a line with three loops. skip_spaces moves over spaces and tabs, name_end moves over letters, digits and the underscore, and digits_end moves over digits alone. Each takes the text and a start byte and returns the byte where it stopped, so a scanner that cannot move returns its start. Start on the digit 3 of ADD t12, 345 and name_end and digits_end both stop at byte 12, because a digit is also a name character. The spec t27a.t27 declares 38 functions, these three among them, and pulls in 20 more through use from ternary_encoding.t27 and t27a_mnemonics.t27, so 58 lower to WebAssembly.",
    "A number has three doors in the assembler, each with its own limit. A .word takes any decimal up to 4294967295, so 4294967296 is refused as a bad word. An immediate takes at most 5 digits and, signed, runs from -16384 to 16383, so 16384 is a bad immediate. A register is t0 to t26, so t27 is a bad register. dec_fits_u32 judges a digit run before it is read, because the callers of dec_value must bound it first or the value would wrap.",
    "The parser reads an expression through 11 functions, each calling the next tighter one for its operands: or, and, comparison, bit or, bit xor, bit and, shift, additive, multiplicative, unary and postfix. So the tightest operators group first. binds_looser(a, b) compares two levels, and the grid draws all 121 answers: additive binds looser than multiplicative, so a + b * c groups the product. max_children returns 32, the number of children one tree node can hold.",
    "A renderer once printed (BOARD_NAME != ) and left the C compiler to find the hole. has_empty_operand scans a rendered expression: it skips an operator run and the spaces after it, and an operator followed by the end of the text or a closing bracket is a hole. The tape tries 17 operators dropped and kept: 15 are caught, and the tilde and the dot are not, because they are not binary operators in its set. The expected values of its tests are what the hand-written Rust returned on the lab.",
    "A parser that only says no is no help. assemble_status returns 0 for a line it accepts and one of 7 numbered reasons otherwise: no mnemonic, unknown mnemonic, bad separator, bad register, bad immediate, trailing text and bad word. It reads left to right and stops at the problem it meets, so a line with two faults gets the number of the earlier one, and the same line always gets the same number. add in lower case is an unknown mnemonic, not a missing one, because lower case is read as a name.",
    "Before the compiler knows a type, a type is a text. int_rank gives the storage width of an integer name: 8, 16, 32, 64 or 128 bits, with usize and isize counted as 64 and 0 for anything else. It trims the spaces first, so a space-padded u8 has width 8. The trimming is done by trim_lo and trim_hi, which int_type_names.t27 takes from tri/t27b/type_text.t27 through use. is_integer_type_suffix does not trim: it is applied to a name cut from a builtin such as cast_i8, so the same padded text is not a suffix. int_value_bits and uint_bits return an optional number, which WebAssembly cannot take, so they are not run here.",
    "The Verilog backend lowers a tuple type only when its text is plain parentheses with no named field. is_simple_tuple_type checks that the text starts with an opening bracket, ends with a closing one, contains no colon and is not empty. (u8, u16) passes and (u8, x: u16) does not. The three byte tests, starts_with, ends_with and bytes_contain, are not declared in verilog_names.t27: it takes bytes_contain from tools/t27o/rust_std.t27 and the other two from hosting/toolchain.t27 through use, and the page lists their answers beside the verdict. is_icarus_builtin accepts one name, __mul_noop, a helper the backend adds by itself, so it has no definition in the source.",
    "In t27 an if/else can be a value. The spec verilog_branch_context.t27 keeps seven small bodies in which it is: as a whole function, nested, with local names, narrowed to a byte, as an early return, beside a statement that sets a result, and called by another body. At 19 they return 182, 20, 31, 19, 16, 18 and 182, and the spec's own test asserts that branch_value(19) is 182. The Verilog backend must keep the value of the conditional, and these bodies pin the cases. wide_value, which returns 64 bits, is not run here.",
    "Before any wire is placed the compiler estimates timing. est_comb_delay is the LUT depth times 100 ps plus 300 ps for one routing hop, and est_reg_to_reg_delay adds 200 ps of setup when a register ends the path. fmax_from_delay divides a second of picoseconds by the delay and answers in kHz. Three LUTs deep, the register to register path is 800 ps and allows 1250 MHz; with no register it would allow 1667 MHz. A path with no delay asks for no clock and answers 0. Slack is a signed 64-bit number, which WebAssembly cannot return, so the page shows none.",
    "The compiler also estimates power with five short formulas. A LUT costs 10 uW per MHz, a flip-flop 5, a block RAM 50 and a DSP 100, scaled by the clock and, for LUTs and flip-flops, by the toggle rate. The idle chip draws a base of 50 mW plus 100 uW for every resource. A design of 800 LUTs, 600 flip-flops, 2 block RAMs and 16 DSPs at 200 MHz and 25 percent toggling comes to 400, 150, 20 and 320 mW dynamic and 191 mW static, 1081 mW in all. The estimates are whole milliwatts, rounded down.",
    "Wire is estimated too. est_wire_length sorts a net by fanout: none for 0, a local wire of 500 um for 1 to 4, a medium wire of 2000 um for 5 to 16 and a long wire of 5000 um beyond. est_congestion is nets per square millimetre, and a die with no area reports none. A clock buffer serves 16 sinks: est_buffers_needed is one per 16 plus one, never less than one, and est_tree_levels is 1, 2 or 3 as the sinks pass 16 and 256. 100 sinks need 7 buffers in 2 levels.",
    "The parser keeps no parentheses, so a backend once wrote a unary operator straight in front of its first operand. -(a + b) ran as -a + b, !(a and b) as !a and b, and ~(a | b) as ~a | b. Typecheck stayed green, and a loss function in specs/ml came out with the wrong sign. codegen_conformance.t27 keeps one small case for each: negated_sum(1, 2) is -3, nand(true, false) is true and nor_bits(1, 2) is 252, a one only where both inputs have a zero. The spec adds a case per miscompile instead of opening a spec per bug.",
    "Common subexpression elimination replaces a repeated expression with a temp. It may do so only when nothing the expression reads was written in between. The optimizer once computed the temp at the top of the body whatever happened later: the temp read a local above its declaration, which did not compile, or a value from before a reassignment, which compiled and was wrong. stale_operand(5) is 106, and the defective compiler returned 12. shared_product(3, 4) is 24: with nothing written between the two products, sharing is still right. The rule now lives in its own spec, cse_hoist.t27.",
    "Some defects pass in Zig and fail in rustc. The Rust that t27c gen-rust wrote for a character literal was a char, not a byte. For a read-only slice parameter it was a Vec, which a caller passing a slice could not satisfy, and for an array of strings it was Vec<const u8>. Four cases pin the fixes: count_byte counts a byte in a text, is_digit judges one, first_plus_of_three adds entry 0 of the slice 4, 5, 6 to another entry, and name_len keeps each length of the table a, bb, ccc. banana holds 3 letters a, and first_plus_of_three(2) is 10.",
    "Without -o, t27c compile writes its output next to the spec. On the lab, measured on 2026-10-18, it did so over a hand-written line, and with -o naming the spec itself it replaced the spec with its own output. output_check decides in a fixed order: the output path is the spec, refuse; no file there, write; -o named the path, write; the file cannot be read, refuse; the generated marker within the head of 5 lines, write; otherwise refuse as hand-written. output_check_today is the unsafe answer the lab measured: write whatever is there.",
    "Every backend writes generated by t27c in its header: on line 2 for Zig and Rust, on line 3 for Verilog and C, below a rule line. A file counts as generated only when the marker sits within the head, 5 lines long: a marker deeper in the body is a comment or a quote, not a header. marked_within takes the head as an argument, and marked_generated fixes it at 5. The spec counted 75 committed generated files beside a same-stem spec: 14 carry the marker on line 2 and 61 on line 3, so the rule refuses none of them.",
    "A seal records the hashes of four generated backends, but on the lab seal --verify never opened the generated files committed beside a spec: a digest_cache.rs cut to its first 200 bytes verified with five MATCH lines. gen_file_check.t27 adds the rule. A committed file passes when it is absent or equals what its generator emits, and a file that cannot be read, or that no generator writes, fails closed. verify_passes needs the recorded hashes to match and all four files to pass. The comparison is with the generator because of the 124 committed files, 61 hash to a value a seal records and 63 do not.",
    "A seal records the spec hash, four generated outputs and the result of a test run. A checker that did not build it recomputes each part and compares. seal_check_alg judges in a fixed order: a digest the checker does not know is unknown before anything else, then the spec, then the C, Rust, Verilog and Zig outputs, then forced, then failed. A part it could not recompute makes the seal unknown instead of a match, unless an earlier part already names itself. Only a match counts as a pass, and a forced or a failed seal never does, whatever the hashes say.",
    "An agent about to reuse a spec asks for the receipt of its seal, and seal_verdict answers with one of 7 words in a fixed order: unsealed when there is no seal of this spec, unknown when the seal cannot be compared, stale when the source changed after the seal, forced, failing, vacuous when no sealed test asserts anything, and verified. The seal file name is the parent folder and the module, so two specs can derive one name, and a seal that records another path is no seal of this one. Here fresh means only that the spec bytes are the sealed bytes: t27c seal --verify is the full check.",
    "What if a run is killed while it writes a seal? seal_write.t27 asks it of 3 ways of writing and 4 moments of a cut, and answers from a model of the disk. In the model, writing in place and cutting during the write leaves a torn file; the lab found no partial file when it killed runs, and the spec records that finished seals survived. Writing and restoring leaves another spec's seal in place when the new seal belongs to a spec that derived the same file name, and that the lab did see: killing the parent while its child wrote one spec's seal into another's file left that spec failing verification. Staging the seal and renaming it leaves the old seal until the rename and the new checked one after it, at every one of the 4 moments. cut_safe accepts only those two states. The lab account of 2026-10-18 measured writing in place and writing then restoring; the third way is the rule.",
    "The sieve asks 10 questions of 9 compilers: proved correct, checked by a validator, tested against another implementation, rebuilt from an independent bootstrap, backed by a reference interpreter, warmup measured, speed published, retargetable, reproducible build and vacuity aware. A cell is true, false, unknown or not applicable, and only false removes a compiler. For the 7 outside compilers a cell is false only if a source says so, and on the cited evidence none is removed. t27c has 4 false cells and t27b 1, because for them we are the source. Between 2026-10-05 and 2026-10-09, 4 cells moved from false to true.",
    "Seven builds of one commit gave t27c four different binaries and t27b one: of the 21 pairs of t27c builds, 17 differ. Two inputs that are not the source explained all of it: the length of the git hash baked into the binary, 7 characters in a depth-1 clone and 9 in a full one, and the path of the cargo cache, whose absolute path rustc writes into panic locations. predicts_same says what a cause model expects of each pair, and mispredicts counts the pairs it gets wrong: the two named causes get 0 wrong and the host alone gets 7. With a flag that remaps the cache path, 3 builds gave one hash.",
    "Diverse double-compiling rebuilds the compiler by another route and compares the result with the compiler text. Here the text is the output of t27core.t27, and there are 3 routes: gen-c then cc, t27b, and the Zig reference. ddc_verdict says cannot run when fewer than 2 routes were built, a miscompile when a built route's second stage differs, and agreement when all match: of the back ends only, while every route shares one front end. A run with all 3 routes built, which exposed issue 6292, found a defect that the Zig route had and the other two did not. The self-host fixpoint alone, route A, would have passed it.",
    "The last step turns a line of text into one 32-bit word. assemble reads ADD t1, t2, t3 and returns 803088, 0x000c4110. The disassembler prints a word one character at a time, listing_char(w, k), because the language has no allocator, and the same parser reads those characters back, so the assembler and the disassembler share one field table. A word is canonical when its opcode is one of the 47, its registers are 0 to 26 and re-encoding its fields gives the word back. Any other word lists as .word, and since the assembler accepts .word, every 32-bit word round-trips.",
    "The same 32-bit word holds 47 opcodes in 3 shapes. The opcode is bits 7 to 0 and the destination bits 12 to 8. In the 24 immediate forms the source is 4 bits, 16 to 13, and a signed 15-bit immediate fills bits 31 to 17, from -16384 to 16383. The 11 three-operand forms have two 5-bit sources, and BUNDLE3 has a third register; the other 12 opcodes take 2 operands. The page finds the owner of each bit by flipping it and asking the decoder, so the colours are what the spec's decoder reads. The decoders are declared in ternary_encoding.t27, which t27a.t27 pulls in with use.",
    "A program file begins with a header of 6 bytes: the magic number as four bytes, a version byte and a section count byte. header_status refuses in a fixed order: a file under 6 bytes is truncated before anything is read, then the magic is checked, then the version. The four magic bytes 50, 73, 82, 84 spell 2IRT in file order and make the number 1414678834, 0x54524932, and the loader reads one version, 1. The 4 section kinds, CODE, CONSTANTS, DATA and BSS, have headers of 4, 1, 3 and 3 bytes. The spec records the container the pinned loader reads and keeps its findings apart from its rules."
];
pub const LESSON_TASKS : [27]str = [
    "Tap byte 102 and then byte 103: f is a hex digit and g is not. Then type a word with an accented letter and count its bytes.",
    "Start on the space after the comma and watch skip_spaces move one byte. Then start on the t and compare name_end with digits_end.",
    "Try 16383 and 16384, then 26 and 27, and then find the largest number the .word door accepts.",
    "Pick additive and multiplicative and read the brackets. Then pick shift and additive: which operator splits the expression?",
    "Take the sample (BOARD_NAME != ) and add y before the bracket. Then try x>> and a - -1.",
    "Take each of the 8 samples and watch the ladder. Then break ADD t1, t2, t3 in two places and see which refusal wins.",
    "Type u8 with a space on each side and read both answers. Then try usize, u128 and u3.",
    "Add a colon to (u8, u16) and watch the third test. Then ask about __mul_noop.",
    "Slide the input across 63, 64, 127 and 128 and watch which branch of nested_value runs. Then find an input where narrow_value stops following it.",
    "Slide the depth to 10 and read both clocks. Then find the depth at which the register to register clock drops below 500 MHz.",
    "Set the DSPs to 0 and watch the DSP bar and the static bar. Then raise the toggle rate to 50 percent and say which bars move and which do not.",
    "Set the fanout to 4 and then 5 and watch the wire class. Then find the number of sinks at which the tree gets a third level.",
    "Take a = 1 and b = 2 and read the three answers. Then set a and b to 255 and look at the result bits.",
    "Run stale_operand(5), then folded_twice(131071), and read the rule under each. Then try shared_product with y set to 0.",
    "Tap each of b, a and n in banana and read the counts. Then move the index to 2 and read both answers.",
    "Start from the hand-written file and tick -o names this path. Then mark the file as generated on line 2.",
    "Slide the marker from line 5 to line 6 with the head at 5. Then widen the head to 6.",
    "Start from the truncated Rust file and read the verdict. Then make that file absent, and then orphan.",
    "Set Rust to differs and Zig to not observed and read which part is named. Then swap them.",
    "Take the good seal and change one digit of the current source. Then force it past a failure, and then give it a test that asserts nothing.",
    "Cut the in-place write during the write. Then pick write then restore and tick a foreign seal, and then pick stage then rename and look at every moment.",
    "Pick t27c and C9 and read the fix issue. Then show the rows as of 2026-10-05 and count the false cells of the t27c row.",
    "Pick t27c and the host alone and read the pairs it gets wrong. Then pick the two causes, and then switch to t27b with no cause.",
    "Start from the run at 0fbd183ba and make the Zig route differ. Then restore it and untick the shared front end.",
    "Assemble each sample and read its word. Then type .word 0 and compare it with NOP t0, t0.",
    "Pick LDI with the immediate minus 12 and find the 15 bits of the immediate. Then pick ADD and find the source 2 bits, and pick NOP and count the unused bits.",
    "Take the good header and cut it to 5 bytes. Then reverse the magic bytes, and then set the version to 2."
];

; --- Claims --------------------------------------------------------------------------------
test the_course_is_three_cubed {
    assert LESSONS_PER_MODULE == 3;
    assert MODULE_COUNT == 9;
    assert LESSON_COUNT == 27;
    assert MODULE_COUNT * LESSONS_PER_MODULE == LESSON_COUNT;
    assert LESSON_COUNT == 3 * 3 * 3;
}

test it_starts_with_a_byte_and_ends_on_a_file_header {
    assert MODULE_IDS[0] == "reading-the-text";
    assert LESSON_WIDGETS[0] == "cmp-chars";
    assert LESSON_SPECS[0] == "specs/compiler/lexer.t27";
    assert MODULE_IDS[8] == "down-to-the-machine";
    assert LESSON_WIDGETS[26] == "cmp-container";
    assert LESSON_SPECS[26] == "specs/isa/tri27_bytecode.t27";
}

test the_text_is_read_before_it_is_shaped_and_costed {
    assert MODULE_IDS[1] == "shape-and-refusals";
    assert LESSON_SPECS[3] == "specs/compiler/parser.t27";
    assert MODULE_IDS[3] == "the-cost-estimate";
    assert LESSON_SPECS[9] == "specs/compiler/hir_cost_models.t27";
    assert LESSON_SPECS[11] == "specs/compiler/hir_cost_models.t27";
}

test the_backends_must_agree_before_a_file_is_written_and_sealed {
    assert MODULE_IDS[4] == "the-same-answer";
    assert LESSON_SPECS[12] == "specs/compiler/codegen_conformance.t27";
    assert MODULE_IDS[5] == "the-output-file";
    assert LESSON_SPECS[15] == "specs/compiler/compile_output.t27";
    assert MODULE_IDS[6] == "seals";
    assert LESSON_SPECS[18] == "specs/verified/seal_check.t27";
    assert LESSON_SPECS[19] == "specs/t27mcp/seal_verdict.t27";
    assert LESSON_SPECS[20] == "specs/verified/seal_write.t27";
}

test the_compiler_is_asked_about_itself_before_the_machine {
    assert MODULE_IDS[7] == "trusting-the-compiler";
    assert LESSON_SPECS[21] == "specs/compiler/theory/sieve.t27";
    assert LESSON_SPECS[22] == "specs/compiler/theory/reproducible.t27";
    assert LESSON_SPECS[23] == "specs/compiler/theory/toolchain.t27";
    assert LESSON_SPECS[24] == "specs/isa/t27a.t27";
}

test the_course_sends_nothing {
    assert SENDS_NOTHING == true;
    assert LOCALES[0] == "en";
    assert LOCALES[1] == "ru";
}
