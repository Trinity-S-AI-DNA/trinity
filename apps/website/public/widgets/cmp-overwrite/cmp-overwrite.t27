// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-overwrite.t27 -- May the compiler overwrite this file? Four refusals and one yes
; Source of truth for public/widgets/cmp-overwrite/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-overwrite/logic.js -- the fn
; bodies of gHashTag/t27 specs/compiler/compile_output.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 16 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader sets the five facts: the output is the input spec, the file exists, it is readable, the line of its
; generated marker and whether -o named it. output_check names the answer, and output_check_today the answer the lab measured before the rule.

; WHAT IT DOES NOT CLAIM:  it touches no file. The measured account in the spec is dated 2026-10-18, on t27c 0.5.2 built from master 982894c96,
; and it says compile wrote whatever was there; whether it still does is for the spec's own header to say.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_overwrite;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-overwrite";
pub const TITLE : str = "May the compiler overwrite this file? Four refusals and one yes";
pub const DESCRIPTION : str = "Without -o, t27c compile writes its output next to the spec, once over a hand-written line and once over the spec itself. Five facts decide whether it may write; output_check answers.";
pub const IMAGE_ALT : str = "Overwrite card: the output file exists, can be read and carries no generated marker in its first lines, and -o did not name it. The answer is refuse, a hand-written file, in red. Four rungs show write, refuse hand-written, refuse unreadable and refuse because the output is the spec itself.";
pub const HOOK : str = "A compiler that writes over a file can destroy work. Five facts decide: is it the spec, is it there, can it be read, is it marked generated, did you name it.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/compiler/compile_output.t27 (t27 master 90e797659): every answer is output_check or output_check_today, fn bodies compiled to wasm (logic.js); the lab account is in the spec's header (2026-10-18)", "Course 12 of t27.ai, t27-compiler: lesson 16 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 5;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_OUT_WRITE : u8 = 0;
pub const K_OUT_REFUSE_HAND_WRITTEN : u8 = 1;
pub const K_OUT_REFUSE_UNREADABLE : u8 = 2;
pub const K_OUT_REFUSE_SPEC : u8 = 3;
pub const K_MARK_HEAD_LINES : u8 = 5;
pub const K_MAX_MARK_LINE : u8 = 12;
pub const K_PRESET_SPEC : [5]u8 = [0, 0, 0, 0, 0];
pub const K_PRESET_EXISTS : [5]u8 = [1, 0, 1, 1, 1];
pub const K_PRESET_READABLE : [5]u8 = [1, 1, 1, 0, 1];
pub const K_PRESET_MARK : [5]u8 = [0, 0, 2, 0, 0];
pub const K_PRESET_NAMED : [5]u8 = [0, 0, 0, 0, 1];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine stages a spec passes; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [5]str = ["A hand-written file", "A new output", "Its own earlier output", "A file it cannot read", "Named with -o"];
pub const SAY_ASK : str = "When may the compiler write its output over a file that is already there?";
pub const SAY_IS_SPEC : str = "the output is the input spec";
pub const SAY_EXISTS : str = "the file exists";
pub const SAY_READABLE : str = "it can be read";
pub const SAY_MARK : str = "line of the generated marker";
pub const SAY_NAMED : str = "-o names this path";
pub const SAY_ANSWERS : [4]str = ["write", "refuse: hand-written", "refuse: unreadable", "refuse: it is the spec"];
pub const SAY_ANSWER_LINES : [4]str = ["Nothing is there, or the file is generated, or you named it: the write is safe.", "A file is there, readable, with no generated marker in its first lines, and you did not name it.", "A file is there but its first lines cannot be read: refuse rather than guess.", "The output path is the spec itself: the output of a spec is never its source."];
pub const SAY_BEFORE : str = "Measured before the rule: {0}";
pub const SAY_NO_MARK : str = "none";
pub const SAY_NOTE : str = "The checks run in a fixed order: the spec itself first, then whether anything is there, then -o, then whether it can be read, then the marker. A marker deeper than the first lines is a quote or a comment, not a header.";
pub const SAY_SOURCE : str = "Logic: t27 spec compiler/compile_output.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_has_a_stage_of_nine {
    assert K_STAGE < 9;
    assert K_STAGE == 5;
}

test four_answers_in_the_order_of_the_checks {
    assert K_OUT_WRITE == 0;
    assert K_OUT_REFUSE_HAND_WRITTEN == 1;
    assert K_OUT_REFUSE_UNREADABLE == 2;
    assert K_OUT_REFUSE_SPEC == 3;
}

test the_start_is_a_hand_written_file_and_the_marker_head_is_five_lines {
    assert K_PRESET_EXISTS[0] == 1;
    assert K_PRESET_MARK[0] == 0;
    assert K_PRESET_MARK[2] < K_MARK_HEAD_LINES;
    assert K_START_PRESET == 0;
}
