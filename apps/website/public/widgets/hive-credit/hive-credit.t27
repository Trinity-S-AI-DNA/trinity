// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-credit.t27 -- Lending a key earns no credit: XP follows recorded work
; Source of truth for public/widgets/hive-credit/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-credit/logic.js -- the fn
; bodies of gHashTag/t27 specs/automation/queen-contributor-keys.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 19 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader drags the keys a contributor owns, the probes in flight and the seconds
; since the last probe. The credit meter is wallet_credit(keys added); the tiles are
; may_add_key(keys), may_start_probe(probes) and cooldown_passed(a probe ran, seconds).

; WHAT IT DOES NOT CLAIM:  it moves no money and stores no key: the wallet meter is the spec fn, and
; it answers 0.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_credit;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-credit";
pub const TITLE : str = "Lending a key earns no credit: XP follows recorded work";
pub const DESCRIPTION : str = "A contributor lends the hive model keys. Drag the keys added: the wallet credit meter stays at 0, a key slot opens up to 100, and a probe waits out its 60 s.";
pub const IMAGE_ALT : str = "Credit card: a contributor with 99 keys. The keys meter is nearly full against the 100 limit and one more may be added; the wallet credit meter is empty at 0 tokens. A probe started 45 s ago waits for its 60 s cooldown; 3 of 4 probe slots are busy.";
pub const HOOK : str = "Adding a key never credits a wallet: CREDIT_WALLET is false in the spec, so XP follows only the work the Queen records, not the keys someone lends.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/automation/queen-contributor-keys.t27 (t27 master c42f8fb40): every value on the page is wallet_credit, may_add_key, may_start_probe and cooldown_passed, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 19 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_MAX_KEYS_PER_OWNER : u16 = 100;
pub const K_MAX_PROBES_IN_FLIGHT : u16 = 4;
pub const K_PROBE_COOLDOWN_SECONDS : u16 = 60;
pub const K_PROBES_MAX : u8 = 6;
pub const K_SECONDS_MAX : u8 = 120;
pub const K_PRESET_KEYS : [4]u8 = [99, 100, 3, 40];
pub const K_PRESET_PROBES : [4]u8 = [3, 4, 0, 1];
pub const K_PRESET_SECONDS : [4]u8 = [45, 61, 0, 90];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["99 keys, a probe 45 s ago", "At the limit", "A new contributor", "40 keys, probe cooled"];
pub const SAY_ASK : str = "Does lending the hive a model key earn a contributor credit?";
pub const SAY_KEYS : str = "keys this contributor owns";
pub const SAY_PROBES : str = "probes in flight";
pub const SAY_SECONDS : str = "seconds since the last probe (0: none yet)";
pub const SAY_KEY_METER : str = "keys, limit {0}";
pub const SAY_CREDIT : str = "wallet credit for those keys, tokens";
pub const SAY_SLOT_METER : str = "probe slots in use";
pub const SAY_ADD : str = "may add a key";
pub const SAY_PROBE : str = "may start a probe";
pub const SAY_COOL : str = "probe cooldown passed";
pub const SAY_YES : str = "yes";
pub const SAY_NO : str = "no";
; The verdict is filled with wallet_credit(keys): SAY_ZERO when it answers 0, SAY_CREDITED otherwise.
pub const SAY_ZERO : str = "{0} tokens: XP follows work";
pub const SAY_CREDITED : str = "{0} tokens: the keys credit the wallet";
pub const SAY_NOTE : str = "A key is probed before it is enabled, at most {0} at once and one per {1} s, so a burst of new keys cannot hammer a provider. Credit comes from the work the Queen records, never from the keys.";
pub const SAY_SOURCE : str = "Logic: t27 spec automation/queen-contributor-keys.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_limits_are_the_specs {
    assert K_MAX_KEYS_PER_OWNER == 100;
    assert K_MAX_PROBES_IN_FLIGHT == 4;
    assert K_PROBE_COOLDOWN_SECONDS == 60;
}

test the_presets_fit_the_sliders {
    assert K_PRESET_KEYS[1] == K_MAX_KEYS_PER_OWNER;
    assert K_PRESET_PROBES[1] <= K_PROBES_MAX;
    assert K_PRESET_SECONDS[3] <= K_SECONDS_MAX;
}
