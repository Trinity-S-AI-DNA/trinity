pub fn nid_named(w: []const u8) -> i32 {
    var i : usize = 0;
    while (i < NM_N) {
        if (pool_eq(NM_OFF[i], NM_LEN[i], w)) { return (i as i32); }
        i = i + 1;
    }
    return -1;
}

pub fn disp_is(n: usize, w: []const u8) -> bool {
    return pool_eq(DP_OFF[n], DP_LEN[n], w);
}

test the_sample_adds_up_to_yosys_total {
    assert parse_hier(SAMPLE) == E_OK;
    assert pool_eq(NM_OFF[TOP], NM_LEN[TOP], "gf16_matmul4x4_p");
    assert totals_of(TOP, 0) == 20464.0;
    assert totals_of(TOP, 1) == 1792.0;
    assert totals_of(TOP, 2) == 64.0;
    assert same_as_design(TOP);
    assert has_creator();
    assert pool_eq(VER_OFF, VER_LEN, "0.67+post");
    assert key_kind() == 1;
    assert is_flat() == false;
    assert order_n() == 4;
    assert roots_n() == 1;
}

test instances_multiply_down_the_hierarchy_and_rows_list_them {
    assert parse_hier(SAMPLE) == E_OK;
    assert module_rows() == 4;
    const add : usize = nid_named("gf16_add") as usize;
    const dot : usize = nid_named("gf16_dot4_p") as usize;
    const mul : usize = nid_named("gf16_mul") as usize;
    assert inst_of(add) == 48.0;
    assert inst_of(dot) == 16.0;
    assert inst_of(mul) == 64.0;
    assert own(add, 0) == 293.0;
    assert own(mul, 0) == 100.0;
    assert own(mul, 2) == 1.0;
    assert own(dot, 1) == 112.0;
    assert row_total(0, 0) == 14064.0;
    assert sub_n(dot) == 2;
    assert sub_count(dot, 0) == 3.0;
}

test the_flat_run_has_one_module_and_fewer_luts {
    assert parse_hier(SAMPLE_FLAT) == E_OK;
    assert is_flat();
    assert totals_of(TOP, 0) == 18730.0;
    assert totals_of(TOP, 1) == 1792.0;
    assert own(TOP, 4) > 0.0;
    assert has_design();
    assert design_val(0) == 18730.0;
    assert sub_n(TOP) == 0;
}

test paramod_names_are_decoded_and_two_paths_are_added {
    assert parse_hier(PARAMOD) == E_OK;
    const l4 : usize = nid_named("$paramod\\leaf\\W=s32'00000000000000000000000000000100") as usize;
    const l8 : usize = nid_named("$paramod\\leaf\\W=s32'00000000000000000000000000001000") as usize;
    assert disp_is(l4, "leaf W=4");
    assert disp_is(l8, "leaf W=8");
    assert module_rows() == 4;
    assert inst_of(l4) == 4.0;
    assert inst_of(l8) == 1.0;
    assert same_as_design(TOP);
    assert display_name("$paramod\\m\\P=s8'11111111\\Q=8'11111111\\R=s4'0101") == 16;
    assert display_byte(0) == 109;
    assert display_name("\\plain") == 5;
    assert bare_skip("\\x") == 1;
}

test the_view_tree_has_one_tile_per_instance_and_the_leaves_add_up {
    assert parse_hier(SAMPLE) == E_OK;
    assert view_tree(0, 64.0, 600.0) == 129;
    assert view_tree_failed() == false;
    assert leaves_n() == 112;
    assert leaves_sum() == 20464.0;
    assert tile_value(0) == 20464.0;
    assert tile_own(0) == false;
    assert view_tree(1, 64.0, 600.0) == 17;
    assert leaves_sum() == 1792.0;
    assert view_tree(0, 2.0, 600.0) == 4;
    assert leaves_sum() == 20464.0;
    assert view_tree(3, 64.0, 600.0) == 1;
}

test the_layout_places_every_tile_inside_the_map {
    assert parse_hier(SAMPLE) == E_OK;
    assert view_tree(0, 64.0, 600.0) > 0;
    assert layout_tree(0.0, 0.0, 900.0, 600.0, 16.0, 2.0) == 129;
    assert layout_failed() == false;
    assert rect_x(0) == 0.0;
    assert rect_w(0) == 900.0;
    assert rect_head(0);
    assert rect_x(1) == 2.0;
    assert rect_y(1) == 16.0;
    assert rect_w(1) == 168.00000000000003;
    assert rect_h(1) == 194.0;
    assert rect_x(128) == 858.6743626743628;
    assert rect_h(128) == 61.34594214229872;
    assert rect_depth(128) == 2;
}

test squarify_follows_bruls_huizing_van_wijk {
    sq_set(0, 6.0);
    sq_set(1, 6.0);
    sq_set(2, 4.0);
    sq_set(3, 3.0);
    sq_set(4, 2.0);
    sq_set(5, 2.0);
    sq_set(6, 1.0);
    assert squarify(7, 0.0, 0.0, 6.0, 4.0) == 7;
    assert sq_out_item(0) == 0;
    assert sq_out_x(0) == 0.0;
    assert sq_out_w(0) == 3.0;
    assert sq_out_h(0) == 2.0;
    assert sq_out_x(6) == 5.4;
    assert sq_out_y(6) == 2.3333333333333335;
    assert sq_out_w(6) == 0.5999999999999996;
    assert sq_out_h(6) == 1.6666666666666676;
    assert squarify(0, 0.0, 0.0, 6.0, 4.0) == 0;
}

test parse_failures_are_named_the_way_the_page_says {
    assert parse_hier("") == E_EMPTY;
    assert parse_hier("   ") == E_EMPTY;
    assert parse_hier("run stat with -json please") == E_NOJSON;
    assert parse_hier("{\"modules\": }") == E_BADJSON;
    assert parse_hier("[1, 2]") == E_NOMODULES;
    assert parse_hier("{\"modules\": 5}") == E_NOMODULES;
    assert parse_hier("{\"creator\": \"Yosys 0.9\", \"modules\": {\"a\": {}}}") == E_NOCELLS;
    assert pool_eq(VER_OFF, VER_LEN, "0.9");
    assert parse_hier("{\"modules\": {\"a\": {\"cells\": {\"b\": 1}}, \"b\": {\"cells\": {\"a\": 1}}}}") == E_NOTOP;
}

test json_quirks_are_read_the_way_javascript_reads_them {
    assert parse_hier("log line {\"modules\": {\"\\\\a\": {\"cells\": {\"LUT2\": 7}}}} tail") == E_OK;
    assert key_kind() == 2;
    assert own(TOP, 0) == 7.0;
    assert parse_hier("{\"modules\": {\"a\": {\"cells\": {\"LUT2\": 1, \"LUT2\": 5, \"FDRE\": \"3\", \"BUFG\": true}}}}") == E_OK;
    assert own(TOP, 0) == 5.0;
    assert own(TOP, 1) == 3.0;
    assert own(TOP, 4) == 1.0;
    assert parse_hier("{\"modules\": {\"b\": {\"cells\": {\"LUT1\": 1}}, \"2\": {\"cells\": {\"LUT1\": 2}}, \"1\": {\"cells\": {\"LUT1\": 3}}}}") == E_OK;
    assert order_n() == 3;
    assert pool_eq(NM_OFF[order_nid(0)], NM_LEN[order_nid(0)], "1");
    assert pool_eq(NM_OFF[order_nid(2)], NM_LEN[order_nid(2)], "b");
    assert parse_hier("{\"modules\": {\"a\": {\"cells\": {\"LUT1\": 1e2, \"LUT2\": 2.5E-1, \"LUT3\": 01}}}}") == E_BADJSON;
    assert parse_hier("{\"modules\": {\"a\": {\"cells\": {\"LUT1\": 1e2, \"LUT2\": 2.5E-1, \"LUT3\": 0.5}}}}") == E_OK;
    assert own(TOP, 0) == 100.75;
}

; FOLD END

; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, issue #10938, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/lut-treemap/tool.js (322 lines of hand-written JavaScript). The
; words and numbers above are unchanged. The reader, the instance multiplier, the view tree and the layout
; (treemap.js, 289 lines) are lut_treemap_logic.t27, folded into this module (its text between "FOLD BEGIN"
; and "FOLD END" is that module's body with the changes listed at FOLD BEGIN): `use` cannot carry a
; `pub var` across modules and the reader keeps its tables in module-level arrays.
; This tool's treemap is DOM, not canvas: absolutely placed <div> tiles, sized by the map box. The page
; needs three things from the host that the browser alone knows, besides the events of the other pages:
;   w_measure_sel(dst)    the selector of the box whose size the page needs: ".lt-map"
;   w_size(px, py)        that box is now px wide and py tall (clientWidth, clientHeight); 1 when it changed
;                         and the page has to be written again
;   w_mono(bytes)         the CSS variable --w-mono (the labels are measured in that font)
;   w_text_need(dst), w_text_give(widths, n)   the text width service (see stat_card.t27): the page
;                         asks for ctx.measureText widths while it writes the tiles' labels
;   w_tile(id)            a tile was clicked (its data-id)
;   w_theme/w_base/w_init/w_data/w_data_failed/w_input/w_click/w_file/w_file_data/w_file_failed/
;   w_drag/w_value/w_render/w_effect as in the other pages. Buttons in document order: the four metrics, the
;   table's rows, then sample, draw, back-to-sample; zones: 0 the stat, 1 the flattened stat.
; HOW IT DIFFERS FROM tool.js, said plainly:
;  - the sample button re-reads the bytes fetched at load instead of fetching again;
;  - the reader keeps ONE parse at a time: the flattened drop keeps only its top totals, and the stat
;    that is shown is read again from the text this page kept whenever another text was read;
;  - a text the reader does not carry (its header) says "Could not read"; so does a cyclic hierarchy
;    (tool.js throws in viewTree) and a stat over the reader's capacities;
;  - a dropped file is read as bytes, not through File.text() (no UTF-8 repair, no BOM strip);
;  - the host writes the page at most 1 MiB; a treemap of many thousand tiles does not fit.

; MEASURED 2026-10-19: t27c gen + a 21-line Zig export wrapper + zig build-exe wasm32-freestanding ReleaseSmall give
; a 41208-byte wasm. The original page (tool.js with treemap.js) and this one ran in two DOM windows (happy-dom);
; the box .lt-map has a size the harness sets (clientWidth and clientHeight), a ResizeObserver stand-in fires on
; request, and ctx.measureText answers with one proportional-font stand-in (the same on both sides). After every
; action the DOM, with the style of every tile and every textarea value, and the scrollIntoView calls of the two
; were compared: 2055 comparisons (63551 tile elements seen), 0 differences. They cover the real sample with every
; control (the four metrics, rows, tiles, both drop boxes by pick and by drop, drag over and leave, clear, sample,
; a cancelled picker, nine map sizes from 0 x 0 to 1200 x 700), 1719 fuzzed actions on designs of 1 to 12 modules
; (random hierarchies with 1 to 1000 instances of a child, $paramod names, markup, quotes, accents and CJK in
; names, "cells" and "num_cells_by_type", design blocks that agree and that do not, two roots, the same module
; under two keys, modules without a cell map, null/true/fraction counts, pretty and minified, terminal captures,
; 16 texts that do not read), 25 variants of the two sample files plus a 404 and a non-JSON answer, events
; before the data arrives, and the limits (8,000,000 and 8,000,001 characters, files of 8,000,001 and 3,000,000
; bytes, 1.5 million multibyte characters, 1500 leaf instances against the tile budget of 600, 40 modules).
; Stated differences, measured: a cyclic hierarchy (tool.js throws in viewTree, this page says "Could not
; read"), a count given as a JSON array and a count given as hex text (the reader does not carry them).
; Negative controls: a changed DOM node, a changed tile style, a measured width 0.5 px and 8 px too wide, a map
; one pixel too tall and one pixel too narrow, a click on the neighbour tile, a scroll left out and a scroll
; with another behaviour are each reported. NOT compared (happy-dom has no layout or fonts): the real box size,
; the real font widths, the smooth scrolling itself.

pub const W_DATA_FILES : [2]str = ["sample.stat.json", "sample.flat.stat.json"];
pub const W_ACCEPT : str = ".json,.txt,application/json,text/plain";
pub const W_MONO_FALLBACK : str = "monospace";
pub const W_PX : u32 = 10;
pub const W_MEASURE_SEL : str = ".lt-map";
pub const W_SCROLL_SEL : str = ".lt-result";
pub const W_SEP : str = " > ";
pub const W_NUM_MAX_CHARS : u64 = 8000000;

pub var S_SMP0 : [1048576]u8 = [0; 1048576];
pub var S_SMP1 : [1048576]u8 = [0; 1048576];
pub var S_SMP_N : [2]u32 = [0; 2];
pub var S_SMP_ST : [2]u8 = [0; 2];
pub var S_MAIN : [8388608]u8 = [0; 8388608];
pub var S_MAIN_N : u32 = 0;
pub var S_PASTE : [8388608]u8 = [0; 8388608];
pub var S_PASTE_N : u32 = 0;
pub var S_PASTE_U : u64 = 0;
pub var S_PASTE_BIG : bool = false;
pub var S_CLR_PASTE : bool = false;
pub var S_CLR_FILE : [2]bool = [false; 2];
pub var S_STATUS : [8192]u8 = [0; 8192];
pub var S_STATUS_N : u32 = 0;
pub var S_BASE : [1024]u8 = [0; 1024];
pub var S_BASE_N : u32 = 0;
pub var S_FAM : [256]u8 = [0; 256];
pub var S_FAM_N : u32 = 0;
pub var S_FB : [262144]u8 = [0; 262144];
pub var S_NUM : [64]u8 = [0; 64];
pub var S_NUM2 : [64]u8 = [0; 64];
pub var S_PRESSED : bool = false;
pub var S_OVER : [2]bool = [false; 2];
pub var S_HAVE : bool = false;
pub var S_HIDDEN : bool = true;
pub var S_RENDERED : bool = false;
pub var S_METRIC : u32 = 0;
pub var S_SEL : i32 = 0 - 1;
pub var S_TILE : i32 = 0 - 1;
pub var S_FLAT : bool = false;
pub var F_TOT : [5]f64 = [0.0; 5];
pub var S_FLATLINE : [4096]u8 = [0; 4096];
pub var S_FLATLINE_N : u32 = 0;
pub var S_DIRTY : bool = false;
pub var S_HUE : [4096]u32 = [0; 4096];
pub var S_MAP_W : f64 = 0.0;
pub var S_MAP_H : f64 = 0.0;
pub var S_PLACED : [32768]u8 = [0; 32768];
pub var S_PLACED_OK : bool = false;
pub var S_EF : [4]u8 = [0; 4];
pub var S_EF_N : u32 = 0;

// the text width service (as in stat_card.t27, with the family the page gets from the host)
pub var X_POOL : [524288]u8 = [0; 524288];
pub var X_PN : u32 = 0;
pub var X_OFF : [8192]u32 = [0; 8192];
pub var X_LEN : [8192]u32 = [0; 8192];
pub var X_W : [8192]f64 = [0.0; 8192];
pub var X_ST : [8192]u8 = [0; 8192];
pub var X_N : u32 = 0;
pub var X_MISS : bool = false;

/// Two texts equal byte for byte (t27c's Zig target does not compare two str array elements with ==).
pub fn same_text(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn copy_into(dst: []u8, at: u32, s: []const u8) -> u32 {
    var n : u32 = at;
    var k : usize = 0;
    while (k < s.len and (n as usize) < dst.len) {
        dst[n as usize] = s[k];
        n = n + 1;
        k = k + 1;
    }
    return n;
}

pub fn w_init(h: []const u8) -> u32 {
    S_SMP_N[0] = 0;
    S_SMP_N[1] = 0;
    S_SMP_ST[0] = 0;
    S_SMP_ST[1] = 0;
    S_MAIN_N = 0;
    S_PASTE_N = 0;
    S_PASTE_U = 0;
    S_PASTE_BIG = false;
    S_CLR_PASTE = false;
    S_CLR_FILE[0] = false;
    S_CLR_FILE[1] = false;
    S_PRESSED = false;
    S_OVER[0] = false;
    S_OVER[1] = false;
    S_HAVE = false;
    S_HIDDEN = true;
    S_RENDERED = false;
    S_METRIC = 0;
    S_SEL = 0 - 1;
    S_TILE = 0 - 1;
    S_FLAT = false;
    S_FLATLINE_N = 0;
    S_DIRTY = false;
    S_MAP_W = 0.0;
    S_MAP_H = 0.0;
    S_PLACED_OK = false;
    S_EF_N = 0;
    X_N = 0;
    X_PN = 0;
    status_is(SAY_LOCAL_NOTE);
    return 0;
}

pub fn w_base(s: []const u8) -> u32 {
    S_BASE_N = copy_into(S_BASE[0..], 0, s);
    return 0;
}

pub fn w_mono(s: []const u8) -> u32 {
    S_FAM_N = copy_into(S_FAM[0..], 0, s);
    return 0;
}

pub fn w_theme(s: []const u8) -> u32 {
    return 0;
}

pub fn w_measure_sel(dst: []u8) -> u32 {
    return copy_into(dst, 0, W_MEASURE_SEL);
}

/// The map box is now px wide and py tall. 1 when it changed.
pub fn w_size(px: f64, py: f64) -> u32 {
    const same : bool = px == S_MAP_W and py == S_MAP_H;
    S_MAP_W = px;
    S_MAP_H = py;
    if (same or !S_HAVE or S_HIDDEN) { return 0; }
    return 1;
}

// --- fmt(): the templates {0} {1} ... of the words, with the arguments in ARB -------------------------------

pub var ARB : [262144]u8 = [0; 262144];
pub var ARO : [8]u32 = [0; 8];
pub var ARL : [8]u32 = [0; 8];

/// fmt(tpl, args...): {0} {1} ... replaced by the arguments in ARB; an index with no argument becomes nothing.
/// Writes into dst; returns the length, or -1 when dst is too small.
pub fn fmt_into(dst: []u8, tpl: []const u8, nargs: u32) -> i64 {
    var n : usize = 0;
    var k : usize = 0;
    while (k < tpl.len) {
        var done : bool = false;
        if (tpl[k] == 123) {
            var q : usize = k + 1;
            var idx : u64 = 0;
            while (q < tpl.len and is_digit(tpl[q])) {
                if (idx < 100000) { idx = idx * 10 + ((tpl[q] - 48) as u64); }
                q = q + 1;
            }
            if (q > k + 1 and q < tpl.len and tpl[q] == 125) {
                if (idx < (nargs as u64)) {
                    var a : usize = 0;
                    while (a < (ARL[idx as usize] as usize)) {
                        if (n >= dst.len) { return -1; }
                        dst[n] = ARB[(ARO[idx as usize] as usize) + a];
                        n = n + 1;
                        a = a + 1;
                    }
                }
                k = q + 1;
                done = true;
            }
        }
        if (!done) {
            if (n >= dst.len) { return -1; }
            dst[n] = tpl[k];
            n = n + 1;
            k = k + 1;
        }
    }
    return n as i64;
}

/// Argument i = the bytes w[lo .. hi] (arguments are set in order 0, 1, 2 ...).
pub fn arg_set(i: usize, w: []const u8, lo: usize, hi: usize) -> bool {
    var at : usize = 0;
    if (i > 0) { at = (ARO[i - 1] + ARL[i - 1]) as usize; }
    if (at + (hi - lo) > 262144) { return false; }
    ARO[i] = at as u32;
    ARL[i] = (hi - lo) as u32;
    var k : usize = lo;
    while (k < hi) {
        ARB[at + (k - lo)] = w[k];
        k = k + 1;
    }
    return true;
}

/// Argument i = String(x), a number the way JavaScript writes it.
pub fn arg_num(i: usize, x: f64) -> bool {
    var at : usize = 0;
    if (i > 0) { at = (ARO[i - 1] + ARL[i - 1]) as usize; }
    if (at + 400 > 262144) { return false; }
    ARO[i] = at as u32;
    const e : u32 = js_str_num(ARB[0 .. 262144], at as u32, x);
    if (e == JN_OVER) { return false; }
    ARL[i] = e - (at as u32);
    return true;
}

// --- text and numbers -------------------------------------------------------------------------------

fn arg_text(i: usize, s: []const u8) -> bool {
    return arg_set(i, s, 0, s.len);
}

fn arg_f(i: usize, x: f64) -> bool {
    return arg_num(i, x);
}

/// Number.toLocaleString('en-US') of x into S_NUM; the length.
fn locale_text(x: f64) -> u32 {
    const e : u32 = js_locale_num(S_NUM[0..], 0, x);
    if (e == OVER) { return 0; }
    return e;
}

/// arg i = num(x)
fn arg_loc(i: usize, x: f64) -> bool {
    const l : u32 = locale_text(x);
    return arg_set(i, S_NUM[0..], 0, l as usize);
}

fn put_say(dst: []u8, n0: u32, tpl: []const u8, nargs: u32) -> u32 {
    const l : i64 = fmt_into(S_FB[0..], tpl, nargs);
    if (l < 0) { return OVER; }
    return text(dst, n0, S_FB[0..(l as usize)]);
}

fn status_is(s: []const u8) -> u32 {
    S_STATUS_N = copy_into(S_STATUS[0..], 0, s);
    return 0;
}

fn status_fmt(tpl: []const u8, nargs: u32) -> u32 {
    const l : i64 = fmt_into(S_STATUS[0..], tpl, nargs);
    S_STATUS_N = 0;
    if (l >= 0) { S_STATUS_N = l as u32; }
    return 0;
}

/// The metric's name: SAY_METRIC_NAMES[IDS.indexOf(m)].
fn metric_name() -> []const u8 {
    return SAY_METRIC_NAMES[S_METRIC as usize];
}

/// "pct(a, b)": (100 * a / b).toFixed(1) + "%", or "-" when b is 0. Into dst.
fn put_pct(dst: []u8, n0: u32, a: f64, b: f64) -> u32 {
    if (b == 0.0 or b != b) { return raw(dst, n0, "-"); }
    var n : u32 = js_to_fixed(dst, n0, (100.0 * a) / b, 1);
    return raw(dst, n, "%");
}

fn pct_text(a: f64, b: f64) -> u32 {
    S_PCT_N = put_pct(S_NUM2[0..], 0, a, b);
    return S_PCT_N;
}

// --- the group lists (the reader holds them as literals) ----------------------------------------------

// --- text width service ----------------------------------------------------------------------------------

fn x_same(i: u32, s: []const u8) -> bool {
    if ((X_LEN[i as usize] as usize) != s.len) { return false; }
    var k : usize = 0;
    const o : usize = X_OFF[i as usize] as usize;
    while (k < s.len) {
        if (X_POOL[o + k] != s[k]) { return false; }
        k = k + 1;
    }
    return true;
}

fn x_find(s: []const u8) -> i32 {
    var i : u32 = 0;
    while (i < X_N) {
        if (x_same(i, s)) { return i as i32; }
        i = i + 1;
    }
    return 0 - 1;
}

fn x_ask(s: []const u8) -> u32 {
    if (x_find(s) >= 0) { return 0; }
    if (X_N >= 8192 or (X_PN as usize) + s.len > 524288) {
        X_N = 0;
        X_PN = 0;
    }
    if (s.len > 8192) { return 0; }
    const i : usize = X_N as usize;
    X_OFF[i] = X_PN;
    X_LEN[i] = s.len as u32;
    X_ST[i] = 0;
    X_W[i] = 0.0;
    var k : usize = 0;
    while (k < s.len) {
        X_POOL[(X_PN as usize) + k] = s[k];
        k = k + 1;
    }
    X_PN = X_PN + (s.len as u32);
    X_N = X_N + 1;
    return 1;
}

/// ctx.measureText(s).width in the labels' font; 0.0 and a request while the host has not answered.
fn x_width(s: []const u8) -> f64 {
    const f : i32 = x_find(s);
    if (f >= 0 and X_ST[f as usize] == 2) {
        X_MISS = false;
        return X_W[f as usize];
    }
    X_MISS = true;
    x_ask(s);
    return 0.0;
}

pub var S_FT : [512]u8 = [0; 512];
pub var S_FT_N : u32 = 0;

/// The labels' font: 10px and the family the host gave (monospace when it is empty).
fn ft_make() -> u32 {
    var n : u32 = copy_into(S_FT[0..], 0, "10px ");
    if (S_FAM_N == 0) { n = copy_into(S_FT[0..], n, W_MONO_FALLBACK); } else { n = copy_into(S_FT[0..], n, S_FAM[0..(S_FAM_N as usize)]); }
    S_FT_N = n;
    return n;
}

fn put_u32le(dst: []u8, at: u32, v: u32) -> u32 {
    dst[at as usize] = (v % 256) as u8;
    dst[(at + 1) as usize] = ((v / 256) % 256) as u8;
    dst[(at + 2) as usize] = ((v / 65536) % 256) as u8;
    dst[(at + 3) as usize] = ((v / 16777216) % 256) as u8;
    return at + 4;
}

/// Requests for the host: records of (u32 font length, u32 text length, font bytes, text bytes). The count.
pub fn w_text_need(dst: []u8) -> u32 {
    var n : u32 = 0;
    var c : u32 = 0;
    var i : u32 = 0;
    ft_make();
    while (i < X_N) {
        if (X_ST[i as usize] == 0) {
            const need : u32 = 8 + S_FT_N + X_LEN[i as usize];
            if ((n as usize) + (need as usize) > dst.len) { return c; }
            n = put_u32le(dst, n, S_FT_N);
            n = put_u32le(dst, n, X_LEN[i as usize]);
            n = copy_into(dst, n, S_FT[0..(S_FT_N as usize)]);
            var k : u32 = 0;
            while (k < X_LEN[i as usize]) {
                dst[(n + k) as usize] = X_POOL[(X_OFF[i as usize] + k) as usize];
                k = k + 1;
            }
            n = n + X_LEN[i as usize];
            X_ST[i as usize] = 1;
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

/// The widths of the requests last sent, in order.
pub fn w_text_give(src: []const f64, n: u32) -> u32 {
    var i : u32 = 0;
    var k : u32 = 0;
    while (i < X_N and k < n and (k as usize) < src.len) {
        if (X_ST[i as usize] == 1) {
            X_W[i as usize] = src[k as usize];
            X_ST[i as usize] = 2;
            k = k + 1;
        }
        i = i + 1;
    }
    return 0;
}

// --- the parse and what the page keeps of it ------------------------------------------------------------

/// The reader reads again the stat that is shown, when another text was read after it.
fn ensure_main() -> u32 {
    if (S_DIRTY and S_HAVE) {
        parse_hier(S_MAIN[0..(S_MAIN_N as usize)]);
        S_DIRTY = false;
    }
    return 0;
}

fn top_total(k: usize) -> f64 {
    return totals_of(top_nid(), k);
}

/// use(r, flat): the page now shows the stat the reader holds.
fn use_result() -> u32 {
    S_HAVE = true;
    S_SEL = 0 - 1;
    S_TILE = 0 - 1;
    S_PLACED_OK = false;
    var i : usize = 0;
    while (i < order_n()) {
        S_HUE[order_nid(i)] = K_TILE_HUES[i % K_TILE_HUES.len] as u32;
        i = i + 1;
    }
    if (top_total(S_METRIC as usize) == 0.0 or top_total(S_METRIC as usize) != top_total(S_METRIC as usize)) {
        var m : u32 = 0;
        var found : bool = false;
        while (m < 4 and !found) {
            const t : f64 = top_total(m as usize);
            if (t != 0.0 and t == t) {
                S_METRIC = m;
                found = true;
            }
            m = m + 1;
        }
        if (!found) { S_METRIC = 0; }
    }
    do_render();
    return 0;
}

fn set_flat_from_reader() -> u32 {
    var k : usize = 0;
    while (k < 5) {
        F_TOT[k] = top_total(k);
        k = k + 1;
    }
    return 0;
}

/// Read text t as the stat to show. The code of the reader's answer; the reader holds the stat only when it is 0.
fn read_main(t: []const u8) -> u32 {
    const code : u32 = parse_hier(t);
    if (code != 0) { return code; }
    // a cyclic hierarchy: tool.js throws in viewTree; this page refuses it
    view_tree(0, K_EXPAND_MAX as f64, K_MAX_TILES as f64);
    if (view_tree_failed()) { return 7; }
    var m : usize = 1;
    while (m < 4) {
        view_tree(m, K_EXPAND_MAX as f64, K_MAX_TILES as f64);
        if (view_tree_failed()) { return 7; }
        m = m + 1;
    }
    return 0;
}

fn error_words(code: u32, plain_name: []const u8) -> u32 {
    if (code >= 1 and code <= 6) {
        status_is(SAY_ERROR_TEXT[((code - 1) as usize)]);
        return 0;
    }
    arg_text(0, plain_name);
    return status_fmt(SAY_ERR_READ, 1);
}

fn too_big(n: f64) -> u32 {
    arg_loc(0, n);
    arg_loc(1, W_NUM_MAX_CHARS as f64);
    return status_fmt(SAY_TOO_BIG, 2);
}

/// readText(text, name): the text is t; its JavaScript length u16; name, in S_FB when it was a file's.
fn read_text(t: []const u8, u16: u64, plain_name: []const u8, named: []const u8) -> u32 {
    if (u16 > W_NUM_MAX_CHARS) {
        too_big(u16 as f64);
        return 0;
    }
    const code : u32 = read_main(t);
    if (code != 0) {
        S_DIRTY = true;
        error_words(code, plain_name);
        ensure_main();
        return 0;
    }
    // the stat is accepted: keep its text, show it
    var k : usize = 0;
    while (k < t.len) {
        S_MAIN[k] = t[k];
        k = k + 1;
    }
    S_MAIN_N = t.len as u32;
    S_DIRTY = false;
    S_PRESSED = false;
    S_FLAT = false;
    var n : u32 = copy_into(S_STATUS[0..], 0, named);
    n = copy_into(S_STATUS[0..], n, ". ");
    n = copy_into(S_STATUS[0..], n, SAY_LOCAL_NOTE);
    S_STATUS_N = n;
    use_result();
    S_EF[0] = 122;
    S_EF_N = 1;
    return 0;
}

/// The flattened stat text (readFlatText).
fn read_flat_text(t: []const u8, u16: u64, plain_name: []const u8, named: []const u8) -> u32 {
    if (u16 > W_NUM_MAX_CHARS) {
        too_big(u16 as f64);
        return 0;
    }
    const code : u32 = parse_hier(t);
    S_DIRTY = true;
    if (code != 0) {
        error_words(code, plain_name);
        ensure_main();
        return 0;
    }
    if (!is_flat()) {
        status_is(SAY_NOT_FLAT);
        ensure_main();
        return 0;
    }
    set_flat_from_reader();
    var n : u32 = copy_into(S_STATUS[0..], 0, named);
    n = copy_into(S_STATUS[0..], n, ". ");
    n = copy_into(S_STATUS[0..], n, SAY_LOCAL_NOTE);
    S_STATUS_N = n;
    S_FLAT = true;
    ensure_main();
    if (S_HAVE) { do_render(); }
    return 0;
}

/// showSample(): both files read, then shown; any failure says the sample did not load.
fn show_sample() -> u32 {
    if (S_SMP_ST[0] == 0 or S_SMP_ST[1] == 0) { return 0; }
    if (S_SMP_ST[0] != 1 or S_SMP_ST[1] != 1) {
        status_is(SAY_ERR_LOAD);
        return 0;
    }
    // the flat first: only its totals are kept
    const cf : u32 = parse_hier(S_SMP1[0..(S_SMP_N[1] as usize)]);
    S_DIRTY = true;
    if (cf != 0) {
        status_is(SAY_ERR_LOAD);
        ensure_main();
        return 0;
    }
    set_flat_from_reader();
    const cm : u32 = read_main(S_SMP0[0..(S_SMP_N[0] as usize)]);
    if (cm != 0) {
        status_is(SAY_ERR_LOAD);
        ensure_main();
        return 0;
    }
    var k : usize = 0;
    while (k < (S_SMP_N[0] as usize)) {
        S_MAIN[k] = S_SMP0[k];
        k = k + 1;
    }
    S_MAIN_N = S_SMP_N[0];
    S_DIRTY = false;
    S_PRESSED = true;
    status_is(SAY_LOCAL_NOTE);
    S_FLAT = true;
    use_result();
    return 0;
}

pub fn w_data(i: u32, s: []const u8) -> u32 {
    S_EF_N = 0;
    if (i > 1) { return 0; }
    if (s.len > 1048576) {
        S_SMP_ST[i as usize] = 2;
    } else {
        var k : usize = 0;
        if (i == 0) {
            while (k < s.len) {
                S_SMP0[k] = s[k];
                k = k + 1;
            }
        } else {
            while (k < s.len) {
                S_SMP1[k] = s[k];
                k = k + 1;
            }
        }
        S_SMP_N[i as usize] = s.len as u32;
        S_SMP_ST[i as usize] = 1;
    }
    if (S_SMP_ST[i as usize] == 2) { status_is(SAY_ERR_LOAD); }
    show_sample();
    return 0;
}

pub fn w_data_failed(i: u32) -> u32 {
    S_EF_N = 0;
    if (i > 1) { return 0; }
    S_SMP_ST[i as usize] = 2;
    status_is(SAY_ERR_LOAD);
    return 0;
}

pub fn w_input(i: u32, s: []const u8) -> u32 {
    S_EF_N = 0;
    if (i != 1) { return 0; }
    S_PASTE_U = utf16_len(s, 0, s.len);
    S_PASTE_BIG = s.len > 8388608;
    var k : usize = 0;
    while (k < s.len and k < 8388608) {
        S_PASTE[k] = s[k];
        k = k + 1;
    }
    S_PASTE_N = k as u32;
    return 0;
}

/// UTF-16 length of the first bytes of a UTF-8 text.
fn utf16_len(w: []const u8, lo: usize, hi: usize) -> u64 {
    var n : u64 = 0;
    var k : usize = lo;
    while (k < hi) {
        const b : u8 = w[k];
        if (b < 128 or b >= 192) { n = n + 1; }
        if (b >= 240) { n = n + 1; }
        k = k + 1;
    }
    return n;
}

fn read_pasted() -> u32 {
    if (S_PASTE_BIG and S_PASTE_U <= W_NUM_MAX_CHARS) {
        arg_text(0, SAY_PASTED);
        return status_fmt(SAY_ERR_READ, 1);
    }
    return read_text(S_PASTE[0..(S_PASTE_N as usize)], S_PASTE_U, SAY_PASTED, SAY_PASTED);
}

pub var S_FNAME : [2048]u8 = [0; 2048];
pub var S_FNAME_N : u32 = 0;
pub var S_FPICK : [4096]u8 = [0; 4096];
pub var S_FPICK_N : u32 = 0;

/// A file was picked or dropped on zone z: 1 when this page wants its bytes.
pub fn w_file(z: u32, name: []const u8, size: f64) -> u32 {
    S_EF_N = 0;
    S_FNAME_N = copy_into(S_FNAME[0..], 0, name);
    arg_text(0, name);
    arg_loc(1, size);
    const l : i64 = fmt_into(S_FPICK[0..], SAY_PICKED, 2);
    S_FPICK_N = 0;
    if (l >= 0) { S_FPICK_N = l as u32; }
    if (size > (W_NUM_MAX_CHARS as f64)) {
        too_big(size);
        return 0;
    }
    return 1;
}

pub fn w_file_data(z: u32, data: []const u8) -> u32 {
    S_EF_N = 0;
    if (z == 0) {
        read_text(data, utf16_len(data, 0, data.len), S_FNAME[0..(S_FNAME_N as usize)], S_FPICK[0..(S_FPICK_N as usize)]);
    } else {
        read_flat_text(data, utf16_len(data, 0, data.len), S_FNAME[0..(S_FNAME_N as usize)], S_FPICK[0..(S_FPICK_N as usize)]);
    }
    return 0;
}

pub fn w_file_failed(z: u32) -> u32 {
    S_EF_N = 0;
    arg_text(0, S_FNAME[0..(S_FNAME_N as usize)]);
    status_fmt(SAY_ERR_READ, 1);
    return 0;
}

pub fn w_drag(z: u32, over: u32) -> u32 {
    S_EF_N = 0;
    if (z > 1) { return 0; }
    const was : bool = S_OVER[z as usize];
    S_OVER[z as usize] = over != 0;
    if (was != S_OVER[z as usize]) { return 1; }
    return 0;
}

pub fn w_value(i: u32, dst: []u8) -> u32 {
    if (i == 0 and S_CLR_FILE[0]) {
        S_CLR_FILE[0] = false;
        return 0;
    }
    if (i == 1 and S_CLR_PASTE) {
        S_CLR_PASTE = false;
        return 0;
    }
    if (i == 2 and S_CLR_FILE[1]) {
        S_CLR_FILE[1] = false;
        return 0;
    }
    return 4294967295;
}

pub fn w_effect(k: u32, dst: []u8) -> u32 {
    if (k >= S_EF_N) {
        S_EF_N = 0;
        return 0;
    }
    dst[0] = 122;
    return copy_into(dst, 1, W_SCROLL_SEL);
}

// --- what the page keeps between events, and the page ------------------------------------------------------

pub var S_NUM3 : [64]u8 = [0; 64];
pub var S_ROWS : [4096]u32 = [0; 4096];
pub var S_ROWS_TMP : [4096]u32 = [0; 4096];
pub var S_ROWS_N : u32 = 0;
pub var S_PTH : [64]u32 = [0; 64];

fn sel_on() -> bool {
    return S_SEL >= 0 and name_len(S_SEL as usize) > 0;
}

/// render(): the tree is built again (w_render does that), the result opens, the lines that keep their text are set.
fn do_render() -> u32 {
    if (!S_HAVE) { return 0; }
    S_RENDERED = true;
    S_HIDDEN = false;
    view_tree(S_METRIC as usize, K_EXPAND_MAX as f64, K_MAX_TILES as f64);
    if (S_FLAT) {
        const m : usize = S_METRIC as usize;
        const t : f64 = top_total(m);
        const f : f64 = F_TOT[m];
        arg_loc(0, f);
        arg_text(1, metric_name());
        if (f == t) {
            status_flatline(SAY_FLAT_SAME, 2);
        } else {
            arg_loc(2, t);
            // d = t[m] ? `${f >= t[m] ? '+' : ''}${(((f - t[m]) / t[m]) * 100).toFixed(1)}%` : '-'
            var n : u32 = 0;
            if (t != 0.0 and t == t) {
                if (f >= t) { n = copy_into(S_NUM2[0..], n, "+"); }
                n = js_to_fixed(S_NUM2[0..], n, (((f - t) / t) * 100.0), 1);
                n = copy_into(S_NUM2[0..], n, "%");
            } else {
                n = copy_into(S_NUM2[0..], n, "-");
            }
            arg_set(3, S_NUM2[0..], 0, n as usize);
            status_flatline(SAY_FLAT_CMP, 4);
        }
    }
    return 0;
}

fn status_flatline(tpl: []const u8, nargs: u32) -> u32 {
    const l : i64 = fmt_into(S_FLATLINE[0..], tpl, nargs);
    S_FLATLINE_N = 0;
    if (l >= 0) { S_FLATLINE_N = l as u32; }
    return 0;
}

fn set_metric(m: u32) -> u32 {
    S_METRIC = m;
    S_TILE = 0 - 1;
    return do_render();
}

fn clear_own() -> u32 {
    S_PASTE_N = 0;
    S_PASTE_U = 0;
    S_PASTE_BIG = false;
    S_CLR_PASTE = true;
    S_CLR_FILE[0] = true;
    S_CLR_FILE[1] = true;
    status_is(SAY_LOCAL_NOTE);
    show_sample();
    return 0;
}

/// The rows of the table, sorted: S_ROWS[0..S_ROWS_N] are indexes into the reader's rows.
fn right_first(l: u32, r: u32) -> bool {
    const m : usize = S_METRIC as usize;
    const d1 : f64 = row_total(r as usize, m) - row_total(l as usize, m);
    if (d1 != 0.0 and d1 == d1) { return d1 > 0.0; }
    const d2 : f64 = row_instances(r as usize) - row_instances(l as usize);
    if (d2 != 0.0 and d2 == d2) { return d2 > 0.0; }
    return false;
}

fn sort_rows() -> u32 {
    const cnt : u32 = module_rows() as u32;
    S_ROWS_N = cnt;
    var i : u32 = 0;
    while (i < cnt) {
        S_ROWS[i as usize] = i;
        i = i + 1;
    }
    var w : u32 = 1;
    while (w < cnt) {
        var lo : u32 = 0;
        while (lo < cnt) {
            var mid : u32 = lo + w;
            if (mid > cnt) { mid = cnt; }
            var hi : u32 = lo + w + w;
            if (hi > cnt) { hi = cnt; }
            var a : u32 = lo;
            var b : u32 = mid;
            var k : u32 = lo;
            while (a < mid and b < hi) {
                if (right_first(S_ROWS[a as usize], S_ROWS[b as usize])) {
                    S_ROWS_TMP[k as usize] = S_ROWS[b as usize];
                    b = b + 1;
                } else {
                    S_ROWS_TMP[k as usize] = S_ROWS[a as usize];
                    a = a + 1;
                }
                k = k + 1;
            }
            while (a < mid) {
                S_ROWS_TMP[k as usize] = S_ROWS[a as usize];
                a = a + 1;
                k = k + 1;
            }
            while (b < hi) {
                S_ROWS_TMP[k as usize] = S_ROWS[b as usize];
                b = b + 1;
                k = k + 1;
            }
            lo = lo + w + w;
        }
        var c : u32 = 0;
        while (c < cnt) {
            S_ROWS[c as usize] = S_ROWS_TMP[c as usize];
            c = c + 1;
        }
        w = w * 2;
    }
    return cnt;
}

pub fn w_click(i: u32) -> u32 {
    S_EF_N = 0;
    const rows : u32 = S_ROWS_N;
    if (i < 4) {
        set_metric(i);
        ensure_main();
        return 0;
    }
    if (i < 4 + rows) {
        const nid : i32 = row_nid(S_ROWS[(i - 4) as usize] as usize) as i32;
        if (S_SEL == nid) { S_SEL = 0 - 1; } else { S_SEL = nid; }
        S_TILE = 0 - 1;
        return 0;
    }
    const b : u32 = i - 4 - rows;
    if (b == 0) { show_sample(); }
    if (b == 1) { read_pasted(); }
    if (b == 2) { clear_own(); }
    ensure_main();
    return 0;
}

/// A click on a tile: map.addEventListener('click').
pub fn w_tile(id: u32) -> u32 {
    S_EF_N = 0;
    if (!S_HAVE) { return 0; }
    if (!S_PLACED_OK or id >= 32768 or S_PLACED[id as usize] == 0) { return 0; }
    S_TILE = id as i32;
    S_SEL = tile_nid(id as usize) as i32;
    return 0;
}

// --- writing the page -----------------------------------------------------------------------------------

fn button(dst: []u8, n0: u32, label: []const u8) -> u32 {
    var n : u32 = raw(dst, n0, "<button class=\"t27-btn\" type=\"button\">");
    n = text(dst, n, label);
    return raw(dst, n, "</button>");
}

fn put_px(dst: []u8, n0: u32, x: f64) -> u32 {
    var e : u32 = js_to_fixed(S_NUM3[0..], 0, x, 1);
    if (e >= 2 and S_NUM3[(e - 2) as usize] == 46 and S_NUM3[(e - 1) as usize] == 48) { e = e - 2; }
    var n : u32 = raw(dst, n0, S_NUM3[0..(e as usize)]);
    return raw(dst, n, "px");
}

fn disp_bytes(nid: usize) -> []const u8 {
    return POOL[disp_off(nid)..(disp_off(nid) + disp_len(nid))];
}

/// fmt(tpl, display(nid), a, b): the tile words.
fn tile_words(tpl: []const u8, nid: usize, x: f64, y: f64, nargs: u32) -> i64 {
    arg_set(0, POOL[0..], disp_off(nid), disp_off(nid) + disp_len(nid));
    if (nargs > 1) { arg_num(1, x); }
    if (nargs > 2) { arg_num(2, y); }
    return fmt_into(S_FB[0..], tpl, nargs);
}

/// tileName(node) into S_FB; the length.
fn tile_name(t: u32) -> u32 {
    const nid : usize = tile_nid(t as usize);
    var l : i64 = 0;
    if (tile_own(t as usize)) {
        l = tile_words(SAY_TILE_OWN, nid, 0.0, 0.0, 1);
    } else {
        if (tile_index(t as usize) != 0.0) {
            l = tile_words(SAY_TILE_COPY, nid, tile_index(t as usize), tile_of(t as usize), 3);
        } else {
            if (tile_copies(t as usize) > 1.0) {
                l = tile_words(SAY_TILE_GROUP, nid, tile_copies(t as usize), 0.0, 2);
            } else {
                l = copy_into(S_FB[0..], 0, disp_bytes(nid)) as i64;
            }
        }
    }
    if (l < 0) { return 0; }
    return l as u32;
}

/// tileLabel(node) into S_FB; the length.
fn tile_label(t: u32) -> u32 {
    const nid : usize = tile_nid(t as usize);
    var l : i64 = 0;
    if (tile_own(t as usize)) {
        l = tile_words(SAY_TILE_OWN, nid, 0.0, 0.0, 1);
    } else {
        if (tile_index(t as usize) != 0.0) {
            l = tile_words(SAY_TILE_SHORT, nid, tile_index(t as usize), 0.0, 2);
        } else {
            if (tile_copies(t as usize) > 1.0) {
                l = tile_words(SAY_TILE_GROUP, nid, tile_copies(t as usize), 0.0, 2);
            } else {
                l = copy_into(S_FB[0..], 0, disp_bytes(nid)) as i64;
            }
        }
    }
    if (l < 0) { return 0; }
    return l as u32;
}

pub var S_LAB : [8192]u8 = [0; 8192];
pub var S_TTL : [8192]u8 = [0; 8192];

fn put_map(dst: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    const m : usize = S_METRIC as usize;
    const w : f64 = S_MAP_W;
    const hgt : f64 = S_MAP_H;
    const tn : usize = view_tree(m, K_EXPAND_MAX as f64, K_MAX_TILES as f64);
    const val0 : f64 = tile_value(0);
    if (tn == 0 or val0 == 0.0 or val0 != val0 or w < 10.0 or hgt < 10.0) {
        arg_text(0, metric_name());
        n = raw(dst, n, "<p class=\"lt-empty\">");
        n = put_say(dst, n, SAY_METRIC_EMPTY, 1);
        return raw(dst, n, "</p>");
    }
    const rc : usize = layout_tree(0.0, 0.0, w, hgt, K_HEAD_PX as f64, K_PAD_PX as f64);
    var z : usize = 0;
    while (z < tn) {
        S_PLACED[z] = 0;
        z = z + 1;
    }
    S_PLACED_OK = true;
    ft_make();
    var i : usize = 0;
    while (i < rc) {
        const t : usize = rect_node(i);
        S_PLACED[t] = 1;
        const leaf : bool = tile_first(t) < 0;
        const is_own : bool = tile_own(t);
        const px : f64 = rect_x(i);
        const py : f64 = rect_y(i);
        const pw : f64 = rect_w(i);
        const ph : f64 = rect_h(i);
        // the text of the label: the display name of a plain leaf, else tileLabel
        var ll : u32 = 0;
        if (leaf and !is_own and !(tile_copies(t) > 1.0)) {
            ll = copy_into(S_LAB[0..], 0, disp_bytes(tile_nid(t)));
        } else {
            const tl : u32 = tile_label(t as u32);
            ll = copy_into(S_LAB[0..], 0, S_FB[0..(tl as usize)]);
        }
        var label : bool = false;
        var head_or_h : bool = false;
        if (leaf) { head_or_h = ph >= (K_LABEL_MIN_H as f64); } else { head_or_h = rect_head(i); }
        if (head_or_h and pw >= (K_LABEL_MIN_W as f64)) {
            label = x_width(S_LAB[0..(ll as usize)]) + 8.0 <= pw;
        }
        n = raw(dst, n, "<div class=\"lt-tile");
        if (leaf) { n = raw(dst, n, " is-leaf"); } else { n = raw(dst, n, " is-box"); }
        if (is_own) { n = raw(dst, n, " is-own"); }
        if (rect_depth(i) == 0) { n = raw(dst, n, " is-root"); }
        if (sel_on()) {
            if ((tile_nid(t) as i32) == S_SEL) {
                n = raw(dst, n, " is-sel");
            } else {
                if (leaf) { n = raw(dst, n, " is-dim"); }
            }
        }
        if (S_TILE == (t as i32)) { n = raw(dst, n, " is-tile"); }
        n = raw(dst, n, "\" style=\"left: ");
        n = put_px(dst, n, px);
        n = raw(dst, n, "; top: ");
        n = put_px(dst, n, py);
        n = raw(dst, n, "; width: ");
        var cw : f64 = pw;
        if (!(cw > 0.0)) { cw = 0.0; }
        n = put_px(dst, n, cw);
        n = raw(dst, n, "; height: ");
        var chh : f64 = ph;
        if (!(chh > 0.0)) { chh = 0.0; }
        n = put_px(dst, n, chh);
        n = raw(dst, n, "; --hue: ");
        n = num(dst, n, S_HUE[tile_nid(t)] as u64);
        n = raw(dst, n, ";\" title=\"");
        const nl : u32 = tile_name(t as u32);
        var tt : u32 = copy_into(S_TTL[0..], 0, S_FB[0..(nl as usize)]);
        tt = copy_into(S_TTL[0..], tt, ": ");
        arg_loc(0, tile_value(t));
        arg_text(1, metric_name());
        const vl : i64 = fmt_into(S_FB[0..], SAY_TILE_VALUE, 2);
        if (vl >= 0) { tt = copy_into(S_TTL[0..], tt, S_FB[0..(vl as usize)]); }
        n = text(dst, n, S_TTL[0..(tt as usize)]);
        n = raw(dst, n, "\" data-id=\"");
        n = num(dst, n, t as u64);
        n = raw(dst, n, "\">");
        if (label) {
            n = raw(dst, n, "<span class=\"lt-label\">");
            n = text(dst, n, S_LAB[0..(ll as usize)]);
            n = raw(dst, n, "</span>");
            if (leaf and ph >= (K_LABEL_MIN_H as f64) * 2.0) {
                n = raw(dst, n, "<span class=\"lt-value\">");
                n = put_locale_num(dst, n, tile_value(t));
                n = raw(dst, n, "</span>");
            }
        }
        n = raw(dst, n, "</div>");
        i = i + 1;
    }
    return n;
}

fn put_locale_num(dst: []u8, n0: u32, x: f64) -> u32 {
    return js_locale_num(dst, n0, x);
}

fn put_table(dst: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    const m : usize = S_METRIC as usize;
    const top : f64 = top_total(m);
    const cnt : u32 = sort_rows();
    n = raw(dst, n, "<caption>");
    n = text(dst, n, SAY_TABLE_CAPTION);
    n = raw(dst, n, "</caption><thead><tr>");
    var h : usize = 0;
    while (h < SAY_TABLE_HEAD.len) {
        n = raw(dst, n, "<th scope=\"col\">");
        n = text(dst, n, SAY_TABLE_HEAD[h]);
        n = raw(dst, n, "</th>");
        h = h + 1;
    }
    n = raw(dst, n, "</tr></thead><tbody>");
    var r : u32 = 0;
    while (r < cnt) {
        const ri : usize = S_ROWS[r as usize] as usize;
        const nid : usize = row_nid(ri);
        const picked : bool = S_SEL == (nid as i32);
        n = raw(dst, n, "<tr class=\"");
        if (picked) { n = raw(dst, n, "is-sel"); }
        n = raw(dst, n, "\"><td><button class=\"lt-row\" type=\"button\" aria-pressed=\"");
        if (picked) { n = raw(dst, n, "true"); } else { n = raw(dst, n, "false"); }
        n = raw(dst, n, "\" style=\"--hue: ");
        n = num(dst, n, S_HUE[nid] as u64);
        n = raw(dst, n, ";\"><span class=\"lt-swatch\" aria-hidden=\"true\"></span>");
        n = text(dst, n, disp_bytes(nid));
        n = raw(dst, n, "</button></td><td class=\"lt-n\">");
        n = put_locale_num(dst, n, row_instances(ri));
        n = raw(dst, n, "</td><td class=\"lt-n\">");
        n = put_locale_num(dst, n, own(nid, m));
        n = raw(dst, n, "</td><td class=\"lt-n\">");
        n = put_locale_num(dst, n, row_total(ri, m));
        n = raw(dst, n, "</td><td class=\"lt-n\">");
        const tot : f64 = row_total(ri, m);
        if (tot != 0.0 and tot == tot) { n = put_pct(dst, n, tot, top); } else { n = raw(dst, n, "-"); }
        n = raw(dst, n, "</td></tr>");
        r = r + 1;
    }
    return raw(dst, n, "</tbody>");
}

/// The path of tile t from the top, as the words of tool.js's pathText: each step is one tile.
fn put_detail(dst: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    const m : usize = S_METRIC as usize;
    const top : f64 = top_total(m);
    if (S_TILE >= 0 and S_PLACED_OK and S_PLACED[S_TILE as usize] == 1) {
        const t : usize = S_TILE as usize;
        n = raw(dst, n, "<p class=\"lt-path\"><span class=\"lt-h\">");
        n = text(dst, n, SAY_DETAIL_PATH);
        n = raw(dst, n, "</span> ");
        n = text(dst, n, disp_bytes(top_nid()));
        // the chain: an own tile has its parent's path
        var c : i32 = t as i32;
        if (tile_own(t)) { c = tile_parent(t); }
        var depth : u32 = 0;
        var q : i32 = c;
        while (q > 0 and depth < 64) {
            S_PTH[depth as usize] = q as u32;
            depth = depth + 1;
            q = tile_parent(q as usize);
        }
        while (depth > 0) {
            depth = depth - 1;
            const e : usize = S_PTH[depth as usize] as usize;
            n = text(dst, n, W_SEP);
            var l : i64 = 0;
            if (tile_index(e) != 0.0) {
                l = tile_words(SAY_TILE_COPY, tile_nid(e), tile_index(e), tile_of(e), 3);
            } else {
                l = tile_words(SAY_TILE_GROUP, tile_nid(e), tile_of(e), 0.0, 2);
            }
            if (l >= 0) { n = text(dst, n, S_FB[0..(l as usize)]); }
        }
        if (tile_own(t)) {
            n = text(dst, n, W_SEP);
            const ol : i64 = tile_words(SAY_TILE_OWN, tile_nid(t), 0.0, 0.0, 1);
            if (ol >= 0) { n = text(dst, n, S_FB[0..(ol as usize)]); }
        }
        n = raw(dst, n, "</p><p>");
        arg_loc(0, tile_value(t));
        arg_text(1, metric_name());
        pct_text(tile_value(t), top);
        arg_set(2, S_NUM2[0..], 0, pct_len() as usize);
        arg_loc(3, top);
        n = put_say(dst, n, SAY_DETAIL_LINE, 4);
        return raw(dst, n, "</p>");
    }
    if (sel_on()) {
        // the row of the selected module, if it is under the top
        const cnt : u32 = module_rows() as u32;
        var r : u32 = 0;
        var found : bool = false;
        while (r < cnt and !found) {
            if ((row_nid(r as usize) as i32) == S_SEL) { found = true; } else { r = r + 1; }
        }
        if (found) {
            const nid : usize = S_SEL as usize;
            arg_set(0, POOL[0..], disp_off(nid), disp_off(nid) + disp_len(nid));
            arg_loc(1, row_instances(r as usize));
            arg_loc(2, own(nid, m));
            arg_loc(3, row_total(r as usize, m));
            arg_text(4, metric_name());
            pct_text(row_total(r as usize, m), top);
            arg_set(5, S_NUM2[0..], 0, pct_len() as usize);
            n = raw(dst, n, "<p>");
            n = put_say(dst, n, SAY_DETAIL_MODULE, 6);
            return raw(dst, n, "</p>");
        }
    }
    n = raw(dst, n, "<p class=\"lt-hint\">");
    n = text(dst, n, SAY_DETAIL_HINT);
    return raw(dst, n, "</p>");
}

pub var S_PCT_N : u32 = 0;

/// pct(a, b) into S_NUM2, its length into S_PCT_N.
fn pct_len() -> u32 {
    return S_PCT_N;
}

fn put_lines_and_map(dst: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    const m : usize = S_METRIC as usize;
    n = raw(dst, n, "<div class=\"lt-bar\"><p class=\"lt-total\">");
    if (S_RENDERED) {
        arg_loc(0, top_total(m));
        arg_text(1, metric_name());
        arg_set(2, POOL[0..], disp_off(top_nid()), disp_off(top_nid()) + disp_len(top_nid()));
        n = put_say(dst, n, SAY_TOTAL, 3);
    }
    n = raw(dst, n, "</p><div class=\"lt-metric\" role=\"group\" aria-label=\"");
    n = text(dst, n, SAY_METRIC_LABEL);
    n = raw(dst, n, "\"><span class=\"lt-metric-label\">");
    n = text(dst, n, SAY_METRIC_LABEL);
    n = raw(dst, n, "</span>");
    var b : u32 = 0;
    while (b < 4) {
        n = raw(dst, n, "<button class=\"t27-btn\" type=\"button\" aria-pressed=\"");
        if (S_RENDERED and S_METRIC == b) { n = raw(dst, n, "true"); } else { n = raw(dst, n, "false"); }
        n = raw(dst, n, "\" data-m=\"");
        n = text(dst, n, SAY_METRIC_IDS[b as usize]);
        n = raw(dst, n, "\">");
        n = text(dst, n, SAY_METRIC_NAMES[b as usize]);
        n = raw(dst, n, "</button>");
        b = b + 1;
    }
    n = raw(dst, n, "</div></div><p class=\"lt-warn\"");
    if (!S_RENDERED or !is_flat()) { n = raw(dst, n, " hidden=\"\""); }
    n = raw(dst, n, ">");
    if (S_RENDERED and is_flat()) { n = text(dst, n, SAY_FLAT_WARN); }
    n = raw(dst, n, "</p><p class=\"lt-sum");
    var sum : f64 = 0.0;
    var bad : bool = false;
    if (S_RENDERED) {
        view_tree(m, K_EXPAND_MAX as f64, K_MAX_TILES as f64);
        sum = leaves_sum();
        bad = has_design() and design_val(m) != sum;
    }
    if (bad) { n = raw(dst, n, " is-bad"); }
    n = raw(dst, n, "\">");
    if (S_RENDERED) {
        arg_loc(0, sum);
        if (!has_design()) {
            n = put_say(dst, n, SAY_SUM_NO_DESIGN, 1);
        } else {
            arg_loc(1, design_val(m));
            if (bad) { n = put_say(dst, n, SAY_SUM_BAD, 2); } else { n = put_say(dst, n, SAY_SUM_OK, 2); }
        }
    }
    n = raw(dst, n, "</p><p class=\"lt-flat\"");
    if (S_RENDERED and !S_FLAT) { n = raw(dst, n, " hidden=\"\""); }
    n = raw(dst, n, ">");
    n = text(dst, n, S_FLATLINE[0..(S_FLATLINE_N as usize)]);
    n = raw(dst, n, "</p><div class=\"lt-map\" role=\"img\"");
    if (S_RENDERED) {
        arg_text(0, metric_name());
        n = raw(dst, n, " aria-label=\"");
        n = put_say(dst, n, SAY_MAP_LABEL, 1);
        n = raw(dst, n, "\"");
    }
    n = raw(dst, n, ">");
    if (S_RENDERED) { n = put_map(dst, n); }
    n = raw(dst, n, "</div><div class=\"lt-detail\" aria-live=\"polite\">");
    if (S_RENDERED) { n = put_detail(dst, n); }
    n = raw(dst, n, "</div><div class=\"lt-table-wrap\"><table class=\"lt-table\">");
    if (S_RENDERED) { n = put_table(dst, n); n = raw(dst, n, "</table></div><div class=\"lt-notes\">"); } else { n = raw(dst, n, "</table></div><div class=\"lt-notes\">"); }
    if (S_RENDERED) {
        var any_copy : bool = false;
        var any_group : bool = false;
        var t : usize = 0;
        const tn : usize = view_tree(m, K_EXPAND_MAX as f64, K_MAX_TILES as f64);
        while (t < tn) {
            if (tile_index(t) > 0.0) { any_copy = true; }
            if (!tile_own(t) and tile_index(t) == 0.0 and tile_of(t) > 0.0) { any_group = true; }
            t = t + 1;
        }
        if (any_copy) {
            n = raw(dst, n, "<p>");
            n = text(dst, n, SAY_NOTE_COPIES);
            n = raw(dst, n, "</p>");
        }
        if (any_group) {
            arg_loc(0, K_EXPAND_MAX as f64);
            arg_loc(1, K_MAX_TILES as f64);
            n = raw(dst, n, "<p>");
            n = put_say(dst, n, SAY_NOTE_GROUPED, 2);
            n = raw(dst, n, "</p>");
        }
    }
    return raw(dst, n, "</div>");
}

pub fn w_render(dst: []u8) -> u32 {
    var n : u32 = raw(dst, 0, "<div class=\"lt\"><section class=\"lt-result\"");
    if (S_HIDDEN) { n = raw(dst, n, " hidden=\"\""); }
    n = raw(dst, n, ">");
    n = put_lines_and_map(dst, n);
    n = raw(dst, n, "</section><section class=\"lt-pick\"><div class=\"lt-col\"><h2 class=\"lt-h\">");
    n = text(dst, n, SAY_SAMPLE_LABEL);
    n = raw(dst, n, "</h2><div class=\"lt-btns\"><button class=\"t27-btn\" type=\"button\" aria-pressed=\"");
    if (S_PRESSED) { n = raw(dst, n, "true"); } else { n = raw(dst, n, "false"); }
    n = raw(dst, n, "\">");
    n = text(dst, n, SAY_SAMPLE_NAME);
    n = raw(dst, n, "</button></div><p class=\"lt-line\">");
    n = text(dst, n, SAY_SAMPLE_LINE);
    n = raw(dst, n, " <span><a class=\"lt-open\" href=\"");
    n = text(dst, n, S_BASE[0..(S_BASE_N as usize)]);
    n = text(dst, n, K_SAMPLE_STAT);
    n = raw(dst, n, "\" target=\"_blank\" rel=\"noopener\">");
    n = text(dst, n, SAY_OPEN_SAMPLE);
    n = raw(dst, n, "</a> <a class=\"lt-open\" href=\"");
    n = text(dst, n, S_BASE[0..(S_BASE_N as usize)]);
    n = text(dst, n, K_SAMPLE_FLAT_STAT);
    n = raw(dst, n, "\" target=\"_blank\" rel=\"noopener\">");
    n = text(dst, n, SAY_OPEN_FLAT);
    n = raw(dst, n, "</a></span></p></div><div class=\"lt-col\"><h2 class=\"lt-h\">");
    n = text(dst, n, SAY_OWN_LABEL);
    n = raw(dst, n, "</h2><p class=\"lt-how\"><code>");
    n = text(dst, n, SAY_HOW);
    n = raw(dst, n, "</code></p><label class=\"t27-drop lt-drop");
    if (S_OVER[0]) { n = raw(dst, n, " is-over"); }
    n = raw(dst, n, "\"><input type=\"file\" accept=\"");
    n = text(dst, n, W_ACCEPT);
    n = raw(dst, n, "\" class=\"lt-file\"><span>");
    n = text(dst, n, SAY_DROP);
    n = raw(dst, n, "</span></label><textarea class=\"lt-paste\" rows=\"3\" spellcheck=\"false\" placeholder=\"");
    n = text(dst, n, SAY_PASTE_HINT);
    n = raw(dst, n, "\" aria-label=\"");
    n = text(dst, n, SAY_PASTE_LABEL);
    n = raw(dst, n, "\"></textarea><div class=\"lt-btns\">");
    n = button(dst, n, SAY_READ);
    n = button(dst, n, SAY_CLEAR);
    n = raw(dst, n, "</div><p class=\"lt-how\">");
    n = text(dst, n, SAY_FLAT_LABEL);
    n = raw(dst, n, "</p><label class=\"t27-drop lt-drop lt-drop-small");
    if (S_OVER[1]) { n = raw(dst, n, " is-over"); }
    n = raw(dst, n, "\"><input type=\"file\" accept=\"");
    n = text(dst, n, W_ACCEPT);
    n = raw(dst, n, "\" class=\"lt-file\"><span>");
    n = text(dst, n, SAY_FLAT_DROP);
    n = raw(dst, n, "</span></label><p class=\"lt-status\" role=\"status\">");
    n = text(dst, n, S_STATUS[0..(S_STATUS_N as usize)]);
    n = raw(dst, n, "</p></div></section><p class=\"lt-honest\">");
    n = text(dst, n, SAY_HONEST);
    n = raw(dst, n, "</p></div>");
    if (!ok(n)) { return 0; }
    return n;
}


// --- Tests of the native page -----------------------------------------------------------------------------

/// Does the first n bytes of o contain the text want?
fn has_text(o: []const u8, n: u32, want: []const u8) -> bool {
    if (want.len > (n as usize)) { return false; }
    var i : usize = 0;
    while (i + want.len <= (n as usize)) {
        var k : usize = 0;
        while (k < want.len and o[i + k] == want[k]) { k = k + 1; }
        if (k == want.len) { return true; }
        i = i + 1;
    }
    return false;
}

fn count_text(o: []const u8, n: u32, want: []const u8) -> u32 {
    var c : u32 = 0;
    var i : usize = 0;
    while (i + want.len <= (n as usize)) {
        var k : usize = 0;
        while (k < want.len and o[i + k] == want[k]) { k = k + 1; }
        if (k == want.len) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

/// The host measures the q requests in req: w bytes of text are w * 6 pixels, or 'wide' when asked for.
fn give_widths(req: []const u8, q: u32, each: f64) -> u32 {
    var wd : [8192]f64 = [0.0; 8192];
    var p : u32 = 0;
    var i : u32 = 0;
    while (i < q and i < 8192) {
        const tl : u32 = (req[(p + 4) as usize] as u32) + 256 * (req[(p + 5) as usize] as u32);
        const fl : u32 = (req[p as usize] as u32) + 256 * (req[(p + 1) as usize] as u32);
        wd[i as usize] = (tl as f64) * each;
        p = p + 8 + fl + tl;
        i = i + 1;
    }
    return w_text_give(wd[0..], q);
}

/// Write the page, answer the width requests, write it again, until no request is left. Returns the length.
fn page_with_widths(o: []u8, each: f64) -> u32 {
    var req : [262144]u8 = [0; 262144];
    var n : u32 = 0;
    var rounds : u32 = 0;
    var go : bool = true;
    while (go and rounds < 20) {
        n = w_render(o);
        const q : u32 = w_text_need(req[0..]);
        if (q == 0) { go = false; } else { give_widths(req[0..], q, each); }
        rounds = rounds + 1;
    }
    return n;
}

fn open_page() -> u32 {
    w_init("");
    w_base("http://x/y/");
    w_mono("Fira Code, monospace");
    return 0;
}

fn load_sample() -> u32 {
    w_data(0, SAMPLE);
    w_data(1, SAMPLE_FLAT);
    w_size(900.0, 600.0);
    return 0;
}

test the_page_opens_with_the_result_hidden_and_the_lines_unset {
    open_page();
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert n > 0;
    assert has_text(o[0..], n, "<section class=\"lt-result\" hidden=\"\"><div class=\"lt-bar\"><p class=\"lt-total\"></p>");
    assert has_text(o[0..], n, "<button class=\"t27-btn\" type=\"button\" aria-pressed=\"false\" data-m=\"lut\">LUT</button>");
    assert has_text(o[0..], n, "<p class=\"lt-warn\" hidden=\"\"></p><p class=\"lt-sum\"></p><p class=\"lt-flat\"></p><div class=\"lt-map\" role=\"img\"></div>");
    assert has_text(o[0..], n, "role=\"status\">Read in this tab; nothing is sent.</p>");
    assert has_text(o[0..], n, "href=\"http://x/y/sample.flat.stat.json\" target=\"_blank\" rel=\"noopener\">and the flattened one</a>");
    assert has_text(o[0..], n, "<caption>") == false;
}

test the_sample_opens_129_tiles_the_sum_the_flat_line_and_the_table {
    open_page();
    load_sample();
    assert S_HAVE and !S_HIDDEN and S_PRESSED and S_FLAT;
    var o : [524288]u8 = [0; 524288];
    const n : u32 = page_with_widths(o[0..], 1.0);
    assert has_text(o[0..], n, "<p class=\"lt-total\">20,464 LUT under gf16_matmul4x4_p</p>");
    assert has_text(o[0..], n, "aria-pressed=\"true\" data-m=\"lut\">LUT</button>");
    assert has_text(o[0..], n, "<p class=\"lt-sum\">The tiles add up to 20,464, the top&#39;s total; yosys printed 20,464 for the whole design.</p>");
    assert has_text(o[0..], n, "<p class=\"lt-flat\">Flattened run of the same design: 18,730 LUT. Hierarchical: 20,464 (-8.5%).");
    assert has_text(o[0..], n, "<p class=\"lt-warn\" hidden=\"\"></p>");
    assert has_text(o[0..], n, "<div class=\"lt-map\" role=\"img\" aria-label=\"Treemap of LUT per submodule instance\">");
    assert count_text(o[0..], n, "<div class=\"lt-tile") == 129;
    assert has_text(o[0..], n, "<tr class=\"\"><td><button class=\"lt-row\" type=\"button\" aria-pressed=\"false\" style=\"--hue: 152;\"><span class=\"lt-swatch\" aria-hidden=\"true\"></span>gf16_add</button></td><td class=\"lt-n\">48</td><td class=\"lt-n\">293</td><td class=\"lt-n\">14,064</td><td class=\"lt-n\">68.7%</td></tr>");
    assert has_text(o[0..], n, "<td class=\"lt-n\">0</td><td class=\"lt-n\">-</td></tr>");
    assert has_text(o[0..], n, "<div class=\"lt-detail\" aria-live=\"polite\"><p class=\"lt-hint\">Tap a tile or a row to see where it sits.</p></div>");
    assert !has_text(o[0..], n, "Some instances share one tile");
    assert has_text(o[0..], n, "stat -json names no instances");
}

test a_small_map_says_there_is_nothing_to_draw_and_a_resize_draws_it {
    open_page();
    w_data(0, SAMPLE);
    w_data(1, SAMPLE_FLAT);
    var o : [524288]u8 = [0; 524288];
    var n : u32 = w_render(o[0..]);
    assert has_text(o[0..], n, "<p class=\"lt-empty\">No LUT cells in this design: nothing to draw.</p>");
    assert w_size(900.0, 600.0) == 1;
    assert w_size(900.0, 600.0) == 0;
    n = page_with_widths(o[0..], 1.0);
    assert count_text(o[0..], n, "<div class=\"lt-tile") == 129;
    assert has_text(o[0..], n, "style=\"left: 0px; top: 0px; width: 900px; height: 600px; --hue: 200;\"");
    assert has_text(o[0..], n, "style=\"left: 2px; top: 16px; width: 168px; height: 194px; --hue: 46;\"");
    w_size(9.0, 600.0);
    n = w_render(o[0..]);
    assert count_text(o[0..], n, "<div class=\"lt-tile") == 0;
    assert has_text(o[0..], n, "<p class=\"lt-empty\">");
}

test labels_are_left_off_where_the_tile_is_too_narrow_for_them {
    open_page();
    load_sample();
    var o : [524288]u8 = [0; 524288];
    var n : u32 = page_with_widths(o[0..], 1.0);
    const some : u32 = count_text(o[0..], n, "<span class=\"lt-label\">");
    assert some > 0;
    open_page();
    load_sample();
    n = page_with_widths(o[0..], 1000.0);
    assert count_text(o[0..], n, "<span class=\"lt-label\">") == 0;
    assert count_text(o[0..], n, "<div class=\"lt-tile") == 129;
}

test a_tile_click_picks_its_module_and_shows_the_path_a_row_click_toggles {
    open_page();
    load_sample();
    var o : [524288]u8 = [0; 524288];
    page_with_widths(o[0..], 1.0);
    w_tile(5);
    assert S_TILE == 5;
    var n : u32 = page_with_widths(o[0..], 1.0);
    assert count_text(o[0..], n, " is-tile") == 1;
    assert has_text(o[0..], n, "<p class=\"lt-path\"><span class=\"lt-h\">Path from the top</span> gf16_matmul4x4_p &gt; gf16_dot4_p #1 of 16 &gt; gf16_mul #1 of 4</p>");
    assert has_text(o[0..], n, "of the top&#39;s 20,464.</p>");
    assert has_text(o[0..], n, " is-dim");
    w_click(4);
    assert S_SEL == (row_nid(S_ROWS[0] as usize) as i32);
    assert S_TILE == 0 - 1;
    n = page_with_widths(o[0..], 1.0);
    assert has_text(o[0..], n, "aria-pressed=\"true\" style=\"--hue: 152;\"");
    assert has_text(o[0..], n, "<p>gf16_add: 48 x 293 = 14,064 LUT, 68.7% of the top.</p>");
    w_click(4);
    assert S_SEL == 0 - 1;
    w_tile(100000);
    assert S_TILE == 0 - 1;
}

test the_metric_buttons_change_the_tiles_and_a_metric_with_no_cells_is_empty {
    open_page();
    load_sample();
    var o : [524288]u8 = [0; 524288];
    w_click(1);
    assert S_METRIC == 1;
    var n : u32 = page_with_widths(o[0..], 1.0);
    assert has_text(o[0..], n, "<p class=\"lt-total\">1,792 FF under gf16_matmul4x4_p</p>");
    assert has_text(o[0..], n, "aria-pressed=\"true\" data-m=\"ff\">FF</button>");
    assert has_text(o[0..], n, "Flattened run of the same design: 1,792 FF, the same as hierarchical.");
    assert count_text(o[0..], n, "<div class=\"lt-tile") == 17;
    w_click(3);
    n = page_with_widths(o[0..], 1.0);
    assert has_text(o[0..], n, "<p class=\"lt-empty\">No BRAM cells in this design: nothing to draw.</p>");
}

test texts_that_do_not_read_say_why_and_keep_the_stat_that_is_shown {
    open_page();
    load_sample();
    var o : [524288]u8 = [0; 524288];
    w_input(1, "hello");
    w_click(4 + S_ROWS_N + 1);
    var n : u32 = page_with_widths(o[0..], 1.0);
    assert has_text(o[0..], n, "role=\"status\">No JSON object in this text. Run stat with -json.</p>");
    assert has_text(o[0..], n, "<p class=\"lt-total\">20,464 LUT under gf16_matmul4x4_p</p>");
    assert count_text(o[0..], n, "<div class=\"lt-tile") == 129;
    w_input(1, "{\"modules\":{\"a\":{\"cells\":{\"b\":1}},\"b\":{\"cells\":{\"a\":1}}}}");
    w_click(4 + S_ROWS_N + 1);
    n = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">Every module is instantiated by another, so there is no top.</p>");
    w_input(1, "{\"modules\":{\"top\":{\"cells\":{\"LUT6\":3}}}}");
    w_click(4 + S_ROWS_N + 1);
    n = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">pasted text. Read in this tab; nothing is sent.</p>");
    assert has_text(o[0..], n, "<p class=\"lt-total\">3 LUT under top</p>");
    assert has_text(o[0..], n, "<p class=\"lt-warn\">This stat is flat: no module holds another, so there is one tile.");
    assert has_text(o[0..], n, "<p class=\"lt-flat\" hidden=\"\">Flattened run of the same design: 18,730");
    assert S_EF_N == 1;
    var e : [64]u8 = [0; 64];
    assert w_effect(0, e[0..]) == 1 + 10;
    assert e[0] == 122;
    assert w_effect(1, e[0..]) == 0;
}

test the_flat_drop_is_checked_and_compared_and_the_stat_shown_is_read_again {
    open_page();
    load_sample();
    var o : [524288]u8 = [0; 524288];
    assert w_file(1, "f.json", 100.0) == 1;
    w_file_data(1, SAMPLE);
    var n : u32 = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">That stat still has submodules; the second drop is for a -flatten run.</p>");
    assert has_text(o[0..], n, "<p class=\"lt-total\">20,464 LUT under gf16_matmul4x4_p</p>");
    w_file_data(1, "{\"modules\":{\"t\":{\"cells\":{\"LUT6\":20000}}}}");
    n = page_with_widths(o[0..], 1.0);
    assert has_text(o[0..], n, "role=\"status\">f.json: 100 bytes. Read in this tab; nothing is sent.</p>");
    assert has_text(o[0..], n, "Flattened run of the same design: 20,000 LUT. Hierarchical: 20,464 (-2.3%).");
    assert count_text(o[0..], n, "<div class=\"lt-tile") == 129;
    assert w_file(0, "big.json", 8000001.0) == 0;
    n = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">8,000,001 characters is more than this page reads (8,000,000).</p>");
    w_file_failed(0);
    n = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">Could not read big.json.</p>");
    assert w_drag(1, 1) == 1;
    assert w_drag(1, 1) == 0;
    n = w_render(o[0..]);
    assert has_text(o[0..], n, "<label class=\"t27-drop lt-drop lt-drop-small is-over\">");
}

test clear_goes_back_to_the_sample_and_empties_the_inputs {
    open_page();
    load_sample();
    var o : [524288]u8 = [0; 524288];
    w_input(1, "{\"modules\":{\"top\":{\"cells\":{\"LUT6\":3}}}}");
    w_click(4 + S_ROWS_N + 1);
    assert !S_PRESSED;
    w_click(4 + S_ROWS_N + 2);
    assert S_PRESSED;
    var v : [8]u8 = [0; 8];
    assert w_value(0, v[0..]) == 0;
    assert w_value(1, v[0..]) == 0;
    assert w_value(2, v[0..]) == 0;
    assert w_value(1, v[0..]) == 4294967295;
    const n : u32 = page_with_widths(o[0..], 1.0);
    assert has_text(o[0..], n, "<p class=\"lt-total\">20,464 LUT under gf16_matmul4x4_p</p>");
}

test the_sample_that_does_not_load_says_so {
    open_page();
    w_data_failed(0);
    var o : [65536]u8 = [0; 65536];
    var n : u32 = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">The sample did not load.</p>");
    assert S_HIDDEN;
    w_data(1, SAMPLE_FLAT);
    w_click(4 + S_ROWS_N);
    n = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">The sample did not load.</p>");
}

test the_fold_reads_the_specs_own_lists_as_group_of_does {
    open_page();
    assert parse_hier("{\"modules\":{\"t\":{\"cells\":{\"LUT2\":1,\"FDSE\":2,\"DSP48E1\":3,\"RAMB18E1\":4,\"$scopeinfo\":5,\"XYZ\":6}}}}") == E_OK;
    assert own(top_nid(), 0) == 1.0;
    assert own(top_nid(), 1) == 2.0;
    assert own(top_nid(), 2) == 3.0;
    assert own(top_nid(), 3) == 4.0;
    assert own(top_nid(), 4) == 6.0;
    assert same_text(W_DATA_FILES[0], K_SAMPLE_STAT);
    assert same_text(W_DATA_FILES[1], K_SAMPLE_FLAT_STAT);
    assert same_text(K_LUT_TYPES[1], "LUT2");
    assert same_text(K_FF_TYPES[1], "FDSE");
    assert same_text(K_BRAM_TYPES[0], "RAMB18E1");
    assert same_text(K_INTERNAL_TYPES[0], "$scopeinfo");
}

/// The splicer follows only the names a module itself mentions, not the names the imported functions mention.
/// This anchor mentions every helper the writer and the number rules call. Never called.
pub fn imports_anchor(o: []u8, s: []const u8) -> u32 {
    var n : u32 = 0;
    n = n + (ok(0) as u32);
    n = n + OVER;
    n = n + put(o, 0, 0);
    n = n + raw(o, 0, s);
    n = n + put_escaped(o, 0, 0);
    n = n + text(o, 0, s);
    n = n + num(o, 0, 0);
    n = n + attr(o, 0, s, s);
    n = n + fill(o, 0, s, s, s, s, 0);
    n = n + fill_named(o, 0, s, s, s, s, s, s, s, s, s, s, s, s, s);
    n = n + dec_to(o, 0);
    n = n + (name_is(s, 0, 0, s) as u32);
    n = n + (is_word_byte(0) as u32);
    n = n + (H_LT as u32);
    n = n + (H_GT as u32);
    n = n + (H_AMP as u32);
    n = n + (H_QUOTE as u32);
    n = n + (H_APOS as u32);
    n = n + (H_SPACE as u32);
    n = n + (H_SLASH as u32);
    n = n + (H_EQ as u32);
    n = n + JN_OVER;
    n = n + JN_CAP;
    n = n + ((JN_TWO52 > 0.0) as u32);
    n = n + ((JN_TWO53 > 0.0) as u32);
    n = n + jn_put(o, 0, 0);
    n = n + jn_raw(o, 0, s);
    n = n + jn_digits(o, 0);
    n = n + jn_mul(o, 0, 0);
    n = n + jn_mul2(o, 0, 0);
    n = n + jn_mul5(o, 0, 0);
    n = n + jn_shift(o, 0, 0);
    n = n + (jn_cmp(s, s, 0) as u32);
    n = n + (jn_expo(0.0) as u32);
    n = n + (jn_mant(0.0) as u32);
    n = n + ((jn_make(0, 0) > 0.0) as u32);
    n = n + jn_exact(o, 0, 0);
    n = n + jn_fscale(0);
    n = n + (js_is_nan(0.0) as u32);
    n = n + ((js_nan(0.0) > 0.0) as u32);
    n = n + ((js_inf(1.0) > 0.0) as u32);
    n = n + ((js_floor(0.0) > 0.0) as u32);
    n = n + ((js_ceil(0.0) > 0.0) as u32);
    n = n + ((js_max(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_min(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_round(0.0) > 0.0) as u32);
    n = n + (jn_shortest(o, 1.0) as u32);
    n = n + jn_copy(o, s, 0);
    n = n + jn_put_run(o, 0, s, 0, 0);
    n = n + jn_layout(o, 0, s, 0, 0);
    n = n + js_str_num(o, 0, 0.0);
    n = n + js_to_fixed(o, 0, 0.0, 0);
    n = n + js_locale_num(o, 0, 0.0);
    n = n + (jn_num_ok(s, 0, 0) as u32);
    n = n + (jn_cmp_text(s, 0, 0, 0, 0) as u32);
    n = n + ((js_parse_num(s, 0, 0) > 0.0) as u32);
    n = n + ((jn_dec_value(s, 0, 0) > 0.0) as u32);
    n = n + (jn_abs(0) as u32);
    n = n + js_str_u64(o, 0, 0);
    n = n + num_grouped(o, 0, 0);
    return n;
}
