; --- Tests --------------------------------------------------------------------------------------
test the_tiles_add_up_to_the_top {
    assert K_SAMPLE_TOTAL_LUT == K_SAMPLE_INST[0] * K_SAMPLE_EACH_LUT[0] + K_SAMPLE_INST[1] * K_SAMPLE_EACH_LUT[1] + K_SAMPLE_INST[2] * K_SAMPLE_EACH_LUT[2] + K_SAMPLE_INST[3] * K_SAMPLE_EACH_LUT[3];
    assert K_SAMPLE_TOTAL_FF == K_SAMPLE_INST[0] * K_SAMPLE_EACH_FF[0] + K_SAMPLE_INST[1] * K_SAMPLE_EACH_FF[1] + K_SAMPLE_INST[2] * K_SAMPLE_EACH_FF[2] + K_SAMPLE_INST[3] * K_SAMPLE_EACH_FF[3];
    assert K_SAMPLE_TOTAL_DSP == K_SAMPLE_INST[0] * K_SAMPLE_EACH_DSP[0] + K_SAMPLE_INST[1] * K_SAMPLE_EACH_DSP[1] + K_SAMPLE_INST[2] * K_SAMPLE_EACH_DSP[2] + K_SAMPLE_INST[3] * K_SAMPLE_EACH_DSP[3];
    assert K_SAMPLE_TOTAL_LUT == 20464;
}

test yosys_agrees_with_the_sum {
    assert K_SAMPLE_DESIGN_LUT == K_SAMPLE_TOTAL_LUT;
    assert K_SAMPLE_DESIGN_FF == K_SAMPLE_TOTAL_FF;
    assert K_SAMPLE_DESIGN_DSP == K_SAMPLE_TOTAL_DSP;
}

test instances_multiply_down_the_hierarchy {
    assert K_SAMPLE_MODULES[2] == K_SAMPLE_TOP;
    assert K_SAMPLE_INST[2] == 1;
    assert K_SAMPLE_EDGE_PARENT[2] == K_SAMPLE_TOP;
    assert same_text(K_SAMPLE_EDGE_CHILD[2], K_SAMPLE_MODULES[1]);
    assert K_SAMPLE_INST[1] == K_SAMPLE_EDGE_COUNT[2];
    assert same_text(K_SAMPLE_EDGE_CHILD[0], K_SAMPLE_MODULES[0]);
    assert K_SAMPLE_INST[0] == K_SAMPLE_EDGE_COUNT[2] * K_SAMPLE_EDGE_COUNT[0];
    assert same_text(K_SAMPLE_EDGE_CHILD[1], K_SAMPLE_MODULES[3]);
    assert K_SAMPLE_INST[3] == K_SAMPLE_EDGE_COUNT[2] * K_SAMPLE_EDGE_COUNT[1];
    assert K_SAMPLE_LUT_TILES == K_SAMPLE_INST[0] + K_SAMPLE_INST[3];
}

test flattening_moves_the_total {
    assert K_SAMPLE_FLAT_LUT < K_SAMPLE_TOTAL_LUT;
    assert K_SAMPLE_FLAT_LUT == 18730;
    assert K_SAMPLE_FLAT_FF == K_SAMPLE_TOTAL_FF;
    assert K_SAMPLE_FLAT_DSP == K_SAMPLE_TOTAL_DSP;
}

test the_four_lists_name_7_series_cells {
    assert K_LUT_TYPES[0] == "LUT1";
    assert K_LUT_TYPES[5] == "LUT6";
    assert K_FF_TYPES[0] == "FDRE";
    assert K_DSP_TYPES[0] == "DSP48E1";
    assert K_BRAM_TYPES[1] == "RAMB36E1";
    assert SAY_METRIC_IDS[0] == "lut";
    assert SAY_METRIC_IDS[3] == "bram";
}

test the_page_reads_files_and_sends_nothing {
    assert READS_LOCAL_FILES == true;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
    assert K_CARD_W == 1200;
    assert K_CARD_H == 630;
    assert K_MIN_TARGET_PX == 32;
}

