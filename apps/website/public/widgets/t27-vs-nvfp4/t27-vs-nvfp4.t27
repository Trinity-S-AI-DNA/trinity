pub const KIND : str = "widget-tool";
pub const ID : str = "t27-vs-nvfp4";
pub const TITLE : str = "T27 vs NVFP4: six weight formats on one small language model";
pub const DESCRIPTION : str = "Perplexity of six weight formats on SmolLM2-135M and the pre-registered ladder: T27 better than NVFP4, MX+ and MXFP4 on a trit substrate, worse than E2M2. Every limit listed.";
pub const IMAGE_ALT : str = "Scoreboard on black: SmolLM2-135M wikitext-2 test perplexity, lower is better: BASE 14.49, E2M2 15.81, T27_N 16.29 in gold, NVFP4 17.47, MX+ 17.98, MXFP4 21.94. T27 to NVFP4 is 932 per mille against a 990 bar, MX+ 906, MXFP4 743; against E2M2 it is 1030, a loss. One model, weights only, no confidence interval.";
pub const HOOK : str = "One claim with its limits: T27 beats NVFP4 on a ternary substrate, on one small model, and loses to a 5-bit E2M2. See every number and every caveat.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [4]str = ["trinity-fpga research/block/ternary_storage_search_v2.json @ d31d8523cd (sha256 969e7b196f6afb9a...): the runner's output, perplexity per arm and split, permille ratios and verdicts; python 3.12.12, torch 2.11.0, transformers 4.57.6, run 2026-09-27 11:44:02Z to 11:52:11Z, not retried", "trinity-fpga specs/numeric/ternary_storage_search_v2.t27 @ 49a84ade57 (sha256 88fcf517296ecc77..., the sha the run recorded): the pre-registration, compiled with the wasm t27 compiler for BEAT_PERMILLE, TIE_PERMILLE, NWIN, SEQLEN and the trits and bits per 32 weights", "trinity-fpga research/block/TERNARY_STORAGE_V2_VERDICT_2026-09-27.md @ d31d8523cd: the report; its perplexity and ratio tables are cross-checked against the JSON, and every limit on this page is from its section What it does not say", "node scripts/widget-data/t27-vs-nvfp4.mjs writes data.json; --check re-reads the three files and fails if data.json or a K_ fact here disagrees; card.png is drawn from data.json by scripts/widget-data/t27-vs-nvfp4-card.py"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The run, as integers (scripts/widget-data/t27-vs-nvfp4.mjs --check re-reads every one) -----
pub const K_DATA : str = "data.json";
; The arms in page order. K_PPL_*_E4 is perplexity times 10000, rounded; 0 means not run on that split.
pub const K_ARMS : [6]str = ["BASE", "E2M2", "T27_N", "NVFP4", "MXPLUS", "MXFP4"];
pub const K_BASE_ARM : u8 = 0;
pub const K_T27_ARM : u8 = 2;
pub const K_NVFP4_ARM : u8 = 3;
pub const K_PPL_TEST_E4 : [6]u32 = [144869, 158083, 162892, 174697, 179780, 219353];
pub const K_PPL_DEV_E4 : [6]u32 = [0, 162063, 166880, 180213, 183802, 226285];
; The comparators of T27_N and the arm each one is. r is per mille times 10, rounded.
pub const K_COMPARATORS : [4]str = ["E2M2", "NVFP4", "MXPLUS", "MXFP4"];
pub const K_COMPARATOR_ARM : [4]u8 = [1, 3, 4, 5];
pub const K_R_TEST_X10 : [4]u32 = [10304, 9324, 9061, 7426];
pub const K_R_DEV_X10 : [4]u32 = [10297, 9260, 9079, 7375];
; The pre-registered ladder: r <= BEAT is T27 better, r <= TIE a tie, above that C better.
pub const K_BEAT_PERMILLE : u16 = 990;
pub const K_TIE_PERMILLE : u16 = 1010;
pub const K_WINDOWS : u8 = 40;
pub const K_SEQLEN : u16 = 2048;
; Storage of a 32-weight block, per arm (0 for BASE). Trits are the pre-registered axis; T27's
; bits are a dense packing of its trits.
pub const K_TRITS_32 : [6]u16 = [0, 134, 101, 106, 106, 102];
pub const K_BITS_32 : [6]u16 = [0, 168, 161, 144, 141, 136];
; Excess test perplexity over BASE, times 100, and the share of NVFP4's excess T27 removes.
pub const K_EXCESS_T27_E2 : u16 = 180;
pub const K_EXCESS_NVFP4_E2 : u16 = 298;
pub const K_GAP_CLOSED_PCT : u8 = 40;

; --- Every word on the screen -------------------------------------------------------------------
