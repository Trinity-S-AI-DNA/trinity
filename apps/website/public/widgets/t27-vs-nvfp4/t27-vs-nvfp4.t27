pub const SAY_CAND_TITLE : str = "The three T27 cells on dev";
pub const SAY_CAND_LINE : str = "The lowest dev perplexity went to test; the other two were never run on test.";
pub const SAY_CHOSEN : str = "chosen";
pub const SAY_R_TITLE : str = "T27_N against each format, per mille";
pub const SAY_R_LINE : str = "r = 1000 x ppl(T27_N) / ppl(C). Bars fixed before the run: r up to {0} is T27 better, up to {1} a tie, above that C better.";
pub const SAY_R_AXIS : str = "r, per mille ({0} = equal)";
pub const SAY_BEAT_MARK : str = "BEAT {0}";
pub const SAY_TIE_MARK : str = "TIE {0}";
pub const SAY_VERDICT_IDS : [3]str = ["beat", "tie", "lose"];
pub const SAY_VERDICT_TEXT : [3]str = ["T27 better", "tie", "T27 loses"];
pub const SAY_OFF_LADDER : str = "not on the pre-registered ladder; computed here from the two perplexities";
pub const SAY_GAP : str = "T27_N removes {0}% of NVFP4's excess over the unquantised model: excess test perplexity {1} against {2}.";
pub const SAY_STORE_TITLE : str = "Storage per 32 weights";
pub const SAY_STORE_HEAD : [3]str = ["format", "trits", "bits"];
pub const SAY_STORE_LINE : str = "Trits are the pre-registered equal-storage axis. In bits, packed densely, T27_N costs {0} against NVFP4's {1}: {2}% more.";
pub const SAY_NOT_TITLE : str = "What this does NOT show";
pub const SAY_LIMITS : [8]str = ["One model and one corpus: SmolLM2-135M on wikitext-2. Weights only: nothing about activations or the KV cache, nothing about other models.", "No confidence interval. Each arm is one point on {windows} windows of {seqlen} tokens; a paired bootstrap was not pre-registered, so none is claimed. Large margins are judgement, not a test.", "NVFP4 and MX+ are our own reimplementations, from NVIDIA's published recipe and from the MX+ paper, not the authors' code. MXFP4 uses a ceil E8M0 scale (rule B).", "T27_N was chosen on dev, the lowest of {ncand} T27 cells there. Test was touched once, after the choice.", "Nothing about binary memory. Packed densely, T27_N costs {t27bits} bits per 32 weights against NVFP4's {nvbits}; E2M2 costs {e2m2bits} and beats T27_N. On a bit substrate this is not an equal-storage comparison.", "Nothing about the cost of a trit cell against a bit cell: nobody has measured it, and ReTern argues it is higher.", "The rulers reproduced the first attempt's numbers on the same machine; the numbers of the main branch's machine were not re-run.", "E2M2 was not on the pre-registered ladder; its ratio here uses the same formula on the two test perplexities."];
pub const SAY_SOURCE : str = "Numbers from trinity-fpga {0} at {1}, ladder from {2} at {3}; read by scripts/widget-data/t27-vs-nvfp4.mjs. Run {4} to {5}, torch {6}, not retried.";
pub const SAY_ERR_LOAD : str = "The data did not load.";
pub const SAY_CHART_ALT : str = "Bars of {split} perplexity per weight format, and dots of T27_N's per-mille ratio to each format against the BEAT and TIE bars.";

; --- Tests --------------------------------------------------------------------------------------
test the_test_ratios_are_the_test_perplexities_within_one_permille {
    assert K_R_TEST_X10[0] * K_PPL_TEST_E4[K_COMPARATOR_ARM[0]] <= 10000 * K_PPL_TEST_E4[K_T27_ARM] + 10 * K_PPL_TEST_E4[K_COMPARATOR_ARM[0]];
    assert 10000 * K_PPL_TEST_E4[K_T27_ARM] <= K_R_TEST_X10[0] * K_PPL_TEST_E4[K_COMPARATOR_ARM[0]] + 10 * K_PPL_TEST_E4[K_COMPARATOR_ARM[0]];
    assert K_R_TEST_X10[1] * K_PPL_TEST_E4[K_COMPARATOR_ARM[1]] <= 10000 * K_PPL_TEST_E4[K_T27_ARM] + 10 * K_PPL_TEST_E4[K_COMPARATOR_ARM[1]];
    assert 10000 * K_PPL_TEST_E4[K_T27_ARM] <= K_R_TEST_X10[1] * K_PPL_TEST_E4[K_COMPARATOR_ARM[1]] + 10 * K_PPL_TEST_E4[K_COMPARATOR_ARM[1]];
    assert K_R_TEST_X10[2] * K_PPL_TEST_E4[K_COMPARATOR_ARM[2]] <= 10000 * K_PPL_TEST_E4[K_T27_ARM] + 10 * K_PPL_TEST_E4[K_COMPARATOR_ARM[2]];
    assert 10000 * K_PPL_TEST_E4[K_T27_ARM] <= K_R_TEST_X10[2] * K_PPL_TEST_E4[K_COMPARATOR_ARM[2]] + 10 * K_PPL_TEST_E4[K_COMPARATOR_ARM[2]];
    assert K_R_TEST_X10[3] * K_PPL_TEST_E4[K_COMPARATOR_ARM[3]] <= 10000 * K_PPL_TEST_E4[K_T27_ARM] + 10 * K_PPL_TEST_E4[K_COMPARATOR_ARM[3]];
    assert 10000 * K_PPL_TEST_E4[K_T27_ARM] <= K_R_TEST_X10[3] * K_PPL_TEST_E4[K_COMPARATOR_ARM[3]] + 10 * K_PPL_TEST_E4[K_COMPARATOR_ARM[3]];
}

test the_dev_ratios_are_the_dev_perplexities_within_one_permille {
    assert K_R_DEV_X10[0] * K_PPL_DEV_E4[K_COMPARATOR_ARM[0]] <= 10000 * K_PPL_DEV_E4[K_T27_ARM] + 10 * K_PPL_DEV_E4[K_COMPARATOR_ARM[0]];
    assert 10000 * K_PPL_DEV_E4[K_T27_ARM] <= K_R_DEV_X10[0] * K_PPL_DEV_E4[K_COMPARATOR_ARM[0]] + 10 * K_PPL_DEV_E4[K_COMPARATOR_ARM[0]];
    assert K_R_DEV_X10[1] * K_PPL_DEV_E4[K_COMPARATOR_ARM[1]] <= 10000 * K_PPL_DEV_E4[K_T27_ARM] + 10 * K_PPL_DEV_E4[K_COMPARATOR_ARM[1]];
    assert 10000 * K_PPL_DEV_E4[K_T27_ARM] <= K_R_DEV_X10[1] * K_PPL_DEV_E4[K_COMPARATOR_ARM[1]] + 10 * K_PPL_DEV_E4[K_COMPARATOR_ARM[1]];
    assert K_R_DEV_X10[2] * K_PPL_DEV_E4[K_COMPARATOR_ARM[2]] <= 10000 * K_PPL_DEV_E4[K_T27_ARM] + 10 * K_PPL_DEV_E4[K_COMPARATOR_ARM[2]];
    assert 10000 * K_PPL_DEV_E4[K_T27_ARM] <= K_R_DEV_X10[2] * K_PPL_DEV_E4[K_COMPARATOR_ARM[2]] + 10 * K_PPL_DEV_E4[K_COMPARATOR_ARM[2]];
    assert K_R_DEV_X10[3] * K_PPL_DEV_E4[K_COMPARATOR_ARM[3]] <= 10000 * K_PPL_DEV_E4[K_T27_ARM] + 10 * K_PPL_DEV_E4[K_COMPARATOR_ARM[3]];
    assert 10000 * K_PPL_DEV_E4[K_T27_ARM] <= K_R_DEV_X10[3] * K_PPL_DEV_E4[K_COMPARATOR_ARM[3]] + 10 * K_PPL_DEV_E4[K_COMPARATOR_ARM[3]];
}

test the_ladder_says_t27_beats_three_and_loses_to_e2m2 {
    assert K_COMPARATORS[1] == "NVFP4";
    assert K_R_TEST_X10[1] <= 10 * K_BEAT_PERMILLE;
    assert K_R_TEST_X10[2] <= 10 * K_BEAT_PERMILLE;
    assert K_R_TEST_X10[3] <= 10 * K_BEAT_PERMILLE;
    assert K_COMPARATORS[0] == "E2M2";
    assert K_R_TEST_X10[0] > 10 * K_TIE_PERMILLE;
    assert K_R_DEV_X10[1] <= 10 * K_BEAT_PERMILLE;
    assert K_R_DEV_X10[0] > 10 * K_TIE_PERMILLE;
    assert K_BEAT_PERMILLE < K_TIE_PERMILLE;
}

test perplexity_orders_the_arms_as_the_page_lists_them {
    assert K_PPL_TEST_E4[0] < K_PPL_TEST_E4[1];
    assert K_PPL_TEST_E4[1] < K_PPL_TEST_E4[2];
    assert K_PPL_TEST_E4[2] < K_PPL_TEST_E4[3];
    assert K_PPL_TEST_E4[3] < K_PPL_TEST_E4[4];
    assert K_PPL_TEST_E4[4] < K_PPL_TEST_E4[5];
    assert K_PPL_DEV_E4[K_BASE_ARM] == 0;
}

test t27_removes_forty_percent_of_nvfp4s_excess {
    assert K_PPL_TEST_E4[K_T27_ARM] - K_PPL_TEST_E4[K_BASE_ARM] + 50 >= 100 * K_EXCESS_T27_E2;
    assert K_PPL_TEST_E4[K_T27_ARM] - K_PPL_TEST_E4[K_BASE_ARM] + 50 < 100 * K_EXCESS_T27_E2 + 100;
    assert K_PPL_TEST_E4[K_NVFP4_ARM] - K_PPL_TEST_E4[K_BASE_ARM] + 50 >= 100 * K_EXCESS_NVFP4_E2;
    assert K_PPL_TEST_E4[K_NVFP4_ARM] - K_PPL_TEST_E4[K_BASE_ARM] + 50 < 100 * K_EXCESS_NVFP4_E2 + 100;
    assert K_GAP_CLOSED_PCT == (200 * (K_PPL_TEST_E4[K_NVFP4_ARM] - K_PPL_TEST_E4[K_T27_ARM]) + K_PPL_TEST_E4[K_NVFP4_ARM] - K_PPL_TEST_E4[K_BASE_ARM]) / (2 * (K_PPL_TEST_E4[K_NVFP4_ARM] - K_PPL_TEST_E4[K_BASE_ARM]));
}

test fewer_trits_than_nvfp4_but_more_bits {
    assert K_TRITS_32[K_T27_ARM] < K_TRITS_32[K_NVFP4_ARM];
    assert K_BITS_32[K_T27_ARM] > K_BITS_32[K_NVFP4_ARM];
    assert K_BITS_32[1] > K_BITS_32[K_T27_ARM];
    assert K_WINDOWS == 40;
    assert K_SEQLEN == 2048;
}

test the_page_reads_nothing_of_yours_and_sends_nothing {
    assert READS_LOCAL_FILES == false;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
}


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, issue #10938, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/t27-vs-nvfp4/tool.js (192 lines of hand-written JavaScript).
; The words and numbers above are unchanged. The host protocol is race_the_bee.t27's:
;   w_init(hash)          the page opens: the empty frame tool.js draws before data.json arrives
;   w_data(i, bytes)      file i of K_DATA has been fetched; w_data_failed(i) when it could not be
;   w_click(i)            split button i was pressed (0 test, 1 dev)
;   w_render(dst)         the page's HTML, length (0 on overflow)
; Numbers are written the JavaScript way by js_num.t27 (toFixed on the exact value, String(x) the
; shortest digits for the pct() widths) and values are read the way String() / Number() read a parsed
; value by js_val.t27, so a null, a missing key or a string where a number is expected prints what
; tool.js prints. NOT carried over: where tool.js throws a TypeError (an arm with id T27_STAR, NVFP4,
; BASE or E2M2 missing, d.ratios.test without NVFP4, a missing protocol or run object) it leaves a
; half-drawn page; this page draws the same frame with the missing values as undefined and compares
; equal only where tool.js does not throw. The data file is cut at W_DATA_CAP bytes (the page then says
; it could not be read).
; MEASURED 2026-10-19: t27c 0.5.2 gen + a 5-line Zig export wrapper + zig build-exe wasm32-freestanding
; ReleaseSmall give a 28660-byte wasm. The original page (tool.js) and this one ran in two happy-dom
; windows against the real 3911-byte data.json and 120 variants of it, 1517 comparisons of tag,
; attributes and text (the empty frame before the data arrives, with and without a click on dev, the
; page after it, then the split buttons clicked in random order): arms with a null dev perplexity or
; null storage, markup / quotes / accents / an emoji / null in names, an unknown arm or verdict word,
; truthy and falsy chosen / ladder flags, empty candidate and ratio lists, ratios far from 1000 and
; equal to it, bars moved / equal / strings / null / missing, odd windows and seqlen, perplexities that
; are ties for toFixed, 1e-7, 1e22, negative, strings and booleans, odd gap and source fields, a
; reordered and a longer arm list, a duplicated arm id, 60 variants with every number replaced by a
; random one (17 digits, thousandths, binary fractions), 20 walks of 30 clicks, a 404 and a body that is
; not JSON: 0 differences. A negative control (one node of the native DOM changed) is reported.
; Not compared: a data file where tool.js throws (see above); the stylesheet is not loaded (happy-dom).

pub const W_DATA_CAP : u32 = 32768;
pub var DATA : [32768]u8 = [0; 32768];
pub var DATA_LEN : u32 = 0;
pub var DATA_STATE : u8 = 0;
pub var SPLIT : u32 = 0;
pub var CAND_DRAWN : bool = false;

pub fn w_init(h: []const u8) -> u32 {
    DATA_STATE = 0;
    DATA_LEN = 0;
    SPLIT = 0;
    CAND_DRAWN = false;
    return 0;
}

pub fn w_data(i: u32, s: []const u8) -> u32 {
    if (s.len > (W_DATA_CAP as usize)) {
        DATA_STATE = 2;
        return 0;
    }
    var k : usize = 0;
    while (k < s.len) {
        DATA[k] = s[k];
        k = k + 1;
    }
    DATA_LEN = s.len as u32;
    DATA_STATE = 1;
    if (!jv_valid(DATA[0..(DATA_LEN as usize)])) { DATA_STATE = 2; }
    if (DATA_STATE == 1 and SPLIT == 1) { CAND_DRAWN = true; }
    return 0;
}

pub fn w_data_failed(i: u32) -> u32 {
    DATA_STATE = 2;
    return 0;
}

pub fn w_click(i: u32) -> u32 {
    if (i < 2) {
        SPLIT = i;
        if (DATA_STATE == 1 and SPLIT == 1) { CAND_DRAWN = true; }
    }
    return 0;
}

fn split_key() -> []const u8 {
    if (SPLIT == 1) { return "dev"; }
    return "test";
}

fn is_null(d: []const u8, sp: i64) -> bool {
    return kind(d, sp) == J_NULL;
}

/// The arm whose id is `id`, NO_SPAN when none (tool.js would throw).
fn find_arm(d: []const u8, arms: i64, id: []const u8) -> i64 {
    const cnt : u32 = arr_len(d, arms);
    var i : u32 = 0;
    while (i < cnt) {
        const a : i64 = arr_at(d, arms, i);
        if (jv_is(d, obj_get(d, a, "id"), id)) { return a; }
        i = i + 1;
    }
    return NO_SPAN;
}

/// K_ARMS.indexOf(name): the index or -1.
fn arm_idx(d: []const u8, sp: i64) -> i32 {
    var i : usize = 0;
    while (i < K_ARMS.len) {
        if (jv_is(d, sp, K_ARMS[i])) { return i as i32; }
        i = i + 1;
    }
    return 0 - 1;
}

/// armName(name): the word for a known arm, else the data's own text (a child node).
fn arm_name(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    const ix : i32 = arm_idx(d, sp);
    if (ix >= 0) { return text(dst, n0, SAY_ARM_NAMES[ix as usize]); }
    return jv_kid(dst, n0, d, sp);
}

fn arm_note(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    const ix : i32 = arm_idx(d, sp);
    if (ix >= 0) { return text(dst, n0, SAY_ARM_NOTES[ix as usize]); }
    return n0;
}

fn pct_val(x: f64, lo: f64, hi: f64) -> f64 {
    return js_max(0.0, js_min(100.0, ((x - lo) / (hi - lo)) * 100.0));
}

/// `${pct(x, lo, hi)}%`
fn put_pct(dst: []u8, n0: u32, x: f64, lo: f64, hi: f64) -> u32 {
    const n : u32 = js_str_num(dst, n0, pct_val(x, lo, hi));
    return put(dst, n, 37);
}

fn fixed_text(dst: []u8, n0: u32, x: f64, digits: u32) -> u32 {
    return js_to_fixed(dst, n0, x, digits);
}

fn num_at(d: []const u8, sp: i64, key: []const u8) -> f64 {
    return jv_num(d, obj_get(d, sp, key));
}

fn claim_html(dst: []u8, n0: u32, d: []const u8, r: i64) -> u32 {
    const arms : i64 = obj_get(d, r, "arms");
    const t27 : i64 = find_arm(d, arms, "T27_STAR");
    const nv : i64 = find_arm(d, arms, "NVFP4");
    const tests : i64 = obj_get(d, obj_get(d, r, "ratios"), "test");
    var rat : i64 = NO_SPAN;
    const cnt : u32 = arr_len(d, tests);
    var i : u32 = 0;
    while (i < cnt) {
        const q : i64 = arr_at(d, tests, i);
        if (rat == NO_SPAN and jv_is(d, obj_get(d, q, "c"), "NVFP4")) { rat = q; }
        i = i + 1;
    }
    var n : u32 = raw(dst, n0, "<span class=\"tn-h\">");
    n = text(dst, n, SAY_CLAIM_LABEL);
    n = raw(dst, n, "</span><p class=\"tn-claim-text\">");
    n = text(dst, n, SAY_CLAIM);
    n = raw(dst, n, "</p><p class=\"tn-line\">");
    var vb : [1024]u8 = [0; 1024];
    var vn : u32 = jv_vput_fixed(vb[0..], 0, "0", num_at(d, t27, "test"), 4);
    vn = jv_vput_fixed(vb[0..], vn, "1", num_at(d, nv, "test"), 4);
    vn = jv_vput_fixed(vb[0..], vn, "2", num_at(d, rat, "r"), 1);
    vn = jv_vput_defined(vb[0..], vn, "3", d, obj_get(d, obj_get(d, r, "protocol"), "beat_permille"));
    vn = jv_vput_defined(vb[0..], vn, "4", d, obj_get(d, t27, "trits32"));
    vn = jv_vput_defined(vb[0..], vn, "5", d, obj_get(d, nv, "trits32"));
    n = jv_fill(dst, n, SAY_CLAIM_LINE, vb[0..], vn, false);
    return raw(dst, n, "</p>");
}

fn ppl_html(dst: []u8, n0: u32, d: []const u8, r: i64) -> u32 {
    const key : []const u8 = split_key();
    const arms : i64 = obj_get(d, r, "arms");
    const cnt : u32 = arr_len(d, arms);
    const P : i64 = obj_get(d, r, "protocol");
    var hi : f64 = 0.0 - js_inf(0.0);
    var i : u32 = 0;
    while (i < cnt) {
        const v : i64 = obj_get(d, arr_at(d, arms, i), key);
        if (!is_null(d, v)) { hi = js_max(hi, jv_num(d, v)); }
        i = i + 1;
    }
    const base : i64 = find_arm(d, arms, "BASE");
    const bv : i64 = obj_get(d, base, key);
    var n : u32 = raw(dst, n0, "<h2 class=\"tn-h\">");
    n = text(dst, n, SAY_PPL_TITLE);
    n = raw(dst, n, "</h2><p class=\"tn-line\">");
    var vb : [512]u8 = [0; 512];
    var vn : u32 = jv_vput_str(vb[0..], 0, "split", SAY_SPLITS[SPLIT as usize]);
    vn = jv_vput_defined(vb[0..], vn, "windows", d, obj_get(d, P, "windows"));
    vn = jv_vput_defined(vb[0..], vn, "seqlen", d, obj_get(d, P, "seqlen"));
    n = jv_fill(dst, n, SAY_PPL_LINE, vb[0..], vn, false);
    n = raw(dst, n, "</p><div class=\"tn-rows\">");
    i = 0;
    while (i < cnt) {
        const a : i64 = arr_at(d, arms, i);
        const v : i64 = obj_get(d, a, key);
        const id : i64 = obj_get(d, a, "id");
        const nm : i64 = obj_get(d, a, "name");
        n = raw(dst, n, "<div class=\"tn-row");
        if (jv_is(d, id, "T27_STAR")) { n = raw(dst, n, " is-t27"); }
        if (jv_is(d, id, "BASE")) { n = raw(dst, n, " is-base"); }
        n = raw(dst, n, "\"><div class=\"tn-name\"><b>");
        n = arm_name(dst, n, d, nm);
        n = raw(dst, n, "</b><span>");
        n = arm_note(dst, n, d, nm);
        n = raw(dst, n, "</span></div><div class=\"tn-track\">");
        if (is_null(d, v)) {
            n = raw(dst, n, "<span class=\"tn-none\">");
            n = text(dst, n, SAY_NOT_RUN);
            n = raw(dst, n, "</span>");
        } else {
            n = raw(dst, n, "<span class=\"tn-bar\" style=\"width:");
            n = put_pct(dst, n, jv_num(d, v), 0.0, hi);
            n = raw(dst, n, "\"></span>");
        }
        n = raw(dst, n, "</div><div class=\"tn-val\">");
        if (!is_null(d, v)) {
            n = raw(dst, n, "<b>");
            n = fixed_text(dst, n, jv_num(d, v), 4);
            n = raw(dst, n, "</b>");
        }
        n = raw(dst, n, "<span>");
        if (!is_null(d, v) and !is_null(d, bv)) {
            var rb : [512]u8 = [0; 512];
            var rn : u32 = jv_vput_fixed(rb[0..], 0, "0", jv_num(d, v) / jv_num(d, bv), 3);
            n = jv_fill(dst, n, SAY_TIMES_BASE, rb[0..], rn, false);
        }
        n = raw(dst, n, "</span></div></div>");
        i = i + 1;
    }
    return raw(dst, n, "</div>");
}

fn cand_html(dst: []u8, n0: u32, d: []const u8, r: i64) -> u32 {
    const cs : i64 = obj_get(d, r, "dev_candidates");
    const cnt : u32 = arr_len(d, cs);
    var hi : f64 = 0.0 - js_inf(0.0);
    var i : u32 = 0;
    while (i < cnt) {
        hi = js_max(hi, num_at(d, arr_at(d, cs, i), "dev"));
        i = i + 1;
    }
    var n : u32 = raw(dst, n0, "<h2 class=\"tn-h\">");
    n = text(dst, n, SAY_CAND_TITLE);
    n = raw(dst, n, "</h2><p class=\"tn-line\">");
    n = text(dst, n, SAY_CAND_LINE);
    n = raw(dst, n, "</p><div class=\"tn-rows\">");
    i = 0;
    while (i < cnt) {
        const c : i64 = arr_at(d, cs, i);
        const ch : bool = jv_truthy(d, obj_get(d, c, "chosen"));
        n = raw(dst, n, "<div class=\"tn-row");
        if (ch) { n = raw(dst, n, " is-t27"); } else { n = raw(dst, n, " is-dim"); }
        n = raw(dst, n, "\"><div class=\"tn-name\"><b>");
        n = jv_kid(dst, n, d, obj_get(d, c, "name"));
        n = raw(dst, n, "</b><span>");
        if (ch) { n = text(dst, n, SAY_CHOSEN); }
        n = raw(dst, n, "</span></div><div class=\"tn-track\"><span class=\"tn-bar\" style=\"width:");
        n = put_pct(dst, n, num_at(d, c, "dev"), 0.0, hi);
        n = raw(dst, n, "\"></span></div><div class=\"tn-val\"><b>");
        n = fixed_text(dst, n, num_at(d, c, "dev"), 4);
        n = raw(dst, n, "</b></div></div>");
        i = i + 1;
    }
    return raw(dst, n, "</div>");
}

/// marks(withText): the 1000 line and the two pre-registered bars.
fn marks_html(dst: []u8, n0: u32, d: []const u8, P: i64, lo: f64, hi: f64, with_text: bool) -> u32 {
    const beat : i64 = obj_get(d, P, "beat_permille");
    const tie : i64 = obj_get(d, P, "tie_permille");
    var n : u32 = raw(dst, n0, "<span class=\"tn-mark is-one\" style=\"left:");
    n = put_pct(dst, n, 1000.0, lo, hi);
    n = raw(dst, n, "\"></span><span class=\"tn-mark is-beat\" style=\"left:");
    n = put_pct(dst, n, jv_num(d, beat), lo, hi);
    n = raw(dst, n, "\">");
    var vb : [128]u8 = [0; 128];
    if (with_text) {
        n = raw(dst, n, "<i>");
        var vn : u32 = jv_vput_defined(vb[0..], 0, "0", d, beat);
        n = jv_fill(dst, n, SAY_BEAT_MARK, vb[0..], vn, false);
        n = raw(dst, n, "</i>");
    }
    n = raw(dst, n, "</span><span class=\"tn-mark is-tie\" style=\"left:");
    n = put_pct(dst, n, jv_num(d, tie), lo, hi);
    n = raw(dst, n, "\">");
    if (with_text) {
        n = raw(dst, n, "<i>");
        var vn2 : u32 = jv_vput_defined(vb[0..], 0, "0", d, tie);
        n = jv_fill(dst, n, SAY_TIE_MARK, vb[0..], vn2, false);
        n = raw(dst, n, "</i>");
    }
    return raw(dst, n, "</span>");
}

fn verdict_idx(d: []const u8, sp: i64) -> i32 {
    var i : usize = 0;
    while (i < SAY_VERDICT_IDS.len) {
        if (jv_is(d, sp, SAY_VERDICT_IDS[i])) { return i as i32; }
        i = i + 1;
    }
    return 0 - 1;
}

fn ratios_html(dst: []u8, n0: u32, d: []const u8, r: i64) -> u32 {
    const P : i64 = obj_get(d, r, "protocol");
    const list : i64 = obj_get(d, obj_get(d, r, "ratios"), split_key());
    const arms : i64 = obj_get(d, r, "arms");
    const cnt : u32 = arr_len(d, list);
    const beat : i64 = obj_get(d, P, "beat_permille");
    const tie : i64 = obj_get(d, P, "tie_permille");
    var mn : f64 = js_min(js_min(jv_num(d, beat), jv_num(d, tie)), 1000.0);
    var mx : f64 = js_max(js_max(jv_num(d, beat), jv_num(d, tie)), 1000.0);
    var i : u32 = 0;
    while (i < cnt) {
        const rv : f64 = num_at(d, arr_at(d, list, i), "r");
        mn = js_min(mn, rv);
        mx = js_max(mx, rv);
        i = i + 1;
    }
    const step : f64 = 50.0;
    const lo : f64 = js_floor((mn - 20.0) / step) * step;
    const hi : f64 = js_ceil((mx + 20.0) / step) * step;
    var n : u32 = raw(dst, n0, "<h2 class=\"tn-h\">");
    n = text(dst, n, SAY_R_TITLE);
    n = raw(dst, n, "</h2><p class=\"tn-line\">");
    var vb : [256]u8 = [0; 256];
    var vn : u32 = jv_vput_defined(vb[0..], 0, "0", d, beat);
    vn = jv_vput_defined(vb[0..], vn, "1", d, tie);
    n = jv_fill(dst, n, SAY_R_LINE, vb[0..], vn, false);
    n = raw(dst, n, "</p><div class=\"tn-rows\"><div class=\"tn-row tn-axisrow\"><div></div><div class=\"tn-track tn-rtrack tn-marktrack\">");
    n = marks_html(dst, n, d, P, lo, hi, true);
    n = raw(dst, n, "</div><div></div></div>");
    i = 0;
    while (i < cnt) {
        const q : i64 = arr_at(d, list, i);
        const qr : f64 = num_at(d, q, "r");
        const a : f64 = js_min(qr, 1000.0);
        const b : f64 = js_max(qr, 1000.0);
        const vd : i64 = obj_get(d, q, "verdict");
        n = raw(dst, n, "<div class=\"tn-row tn-rrow is-");
        n = jv_text(dst, n, d, vd);
        n = raw(dst, n, "\"><div class=\"tn-name\"><b>");
        // d.arms.find((x) => x.id === q.c).name
        var found : i64 = NO_SPAN;
        const ac : u32 = arr_len(d, arms);
        var j : u32 = 0;
        while (j < ac) {
            const x : i64 = arr_at(d, arms, j);
            if (found == NO_SPAN and ids_equal(d, obj_get(d, x, "id"), obj_get(d, q, "c"))) { found = x; }
            j = j + 1;
        }
        n = arm_name(dst, n, d, obj_get(d, found, "name"));
        n = raw(dst, n, "</b><span>");
        if (!jv_truthy(d, obj_get(d, q, "ladder"))) { n = text(dst, n, SAY_OFF_LADDER); }
        n = raw(dst, n, "</span></div><div class=\"tn-track tn-rtrack\">");
        n = marks_html(dst, n, d, P, lo, hi, false);
        n = raw(dst, n, "<span class=\"tn-stem\" style=\"left:");
        n = put_pct(dst, n, a, lo, hi);
        n = raw(dst, n, ";width:calc(");
        n = put_pct(dst, n, b, lo, hi);
        n = raw(dst, n, " - ");
        n = put_pct(dst, n, a, lo, hi);
        n = raw(dst, n, ")\"></span><span class=\"tn-dot\" style=\"left:");
        n = put_pct(dst, n, qr, lo, hi);
        n = raw(dst, n, "\"></span></div><div class=\"tn-val\"><b>");
        n = fixed_text(dst, n, qr, 1);
        n = raw(dst, n, "</b><span>");
        const vi : i32 = verdict_idx(d, vd);
        if (vi >= 0) { n = text(dst, n, SAY_VERDICT_TEXT[vi as usize]); } else { n = jv_kid(dst, n, d, vd); }
        n = raw(dst, n, "</span></div></div>");
        i = i + 1;
    }
    n = raw(dst, n, "<div class=\"tn-row tn-axisrow\"><div></div><div class=\"tn-axis\">");
    var x : f64 = lo;
    var guard : u32 = 0;
    while (x <= hi and guard < 2000) {
        n = raw(dst, n, "<span class=\"tn-tick\" style=\"left:");
        n = put_pct(dst, n, x, lo, hi);
        n = raw(dst, n, "\">");
        n = js_str_num(dst, n, x);
        n = raw(dst, n, "</span>");
        x = x + step;
        guard = guard + 1;
    }
    n = raw(dst, n, "</div><div class=\"tn-axislabel\">");
    var ab : [32]u8 = [0; 32];
    const avn : u32 = jv_vput_str(ab[0..], 0, "0", "1000");
    n = jv_fill(dst, n, SAY_R_AXIS, ab[0..], avn, false);
    n = raw(dst, n, "</div></div></div><p class=\"tn-line\">");
    const g : i64 = obj_get(d, r, "gap");
    var gb : [256]u8 = [0; 256];
    var gn : u32 = jv_vput_fixed(gb[0..], 0, "0", num_at(d, g, "closed") * 100.0, 0);
    gn = jv_vput_fixed(gb[0..], gn, "1", num_at(d, g, "t27_excess"), 2);
    gn = jv_vput_fixed(gb[0..], gn, "2", num_at(d, g, "nvfp4_excess"), 2);
    n = jv_fill(dst, n, SAY_GAP, gb[0..], gn, false);
    return raw(dst, n, "</p>");
}

/// a === b for two string values (both must be strings: tool.js compares ids with ===).
fn ids_equal(d: []const u8, a: i64, b: i64) -> bool {
    if (kind(d, a) != J_STRING or kind(d, b) != J_STRING) { return false; }
    const l : u32 = str_len(d, a);
    if (l != str_len(d, b)) { return false; }
    var k : u32 = 0;
    while (k < l) {
        if (str_byte(d, a, k) != str_byte(d, b, k)) { return false; }
        k = k + 1;
    }
    return true;
}

fn store_html(dst: []u8, n0: u32, d: []const u8, r: i64) -> u32 {
    const arms : i64 = obj_get(d, r, "arms");
    const cnt : u32 = arr_len(d, arms);
    var n : u32 = raw(dst, n0, "<h2 class=\"tn-h\">");
    n = text(dst, n, SAY_STORE_TITLE);
    n = raw(dst, n, "</h2><div class=\"tn-table-wrap\"><table class=\"tn-table\"><thead><tr>");
    var h : usize = 0;
    while (h < SAY_STORE_HEAD.len) {
        n = raw(dst, n, "<th>");
        n = text(dst, n, SAY_STORE_HEAD[h]);
        n = raw(dst, n, "</th>");
        h = h + 1;
    }
    n = raw(dst, n, "</tr></thead><tbody>");
    var i : u32 = 0;
    while (i < cnt) {
        const a : i64 = arr_at(d, arms, i);
        if (!is_null(d, obj_get(d, a, "trits32"))) {
            n = raw(dst, n, "<tr class=\"");
            if (jv_is(d, obj_get(d, a, "id"), "T27_STAR")) { n = raw(dst, n, "is-t27"); }
            n = raw(dst, n, "\"><td>");
            n = arm_name(dst, n, d, obj_get(d, a, "name"));
            n = raw(dst, n, "</td><td class=\"tn-n\">");
            n = jv_text(dst, n, d, obj_get(d, a, "trits32"));
            n = raw(dst, n, "</td><td class=\"tn-n\">");
            n = jv_text(dst, n, d, obj_get(d, a, "bits32"));
            n = raw(dst, n, "</td></tr>");
        }
        i = i + 1;
    }
    n = raw(dst, n, "</tbody></table></div><p class=\"tn-line\">");
    const t27 : i64 = find_arm(d, arms, "T27_STAR");
    const nv : i64 = find_arm(d, arms, "NVFP4");
    const tb : f64 = num_at(d, t27, "bits32");
    const nb : f64 = num_at(d, nv, "bits32");
    var vb : [256]u8 = [0; 256];
    var vn : u32 = jv_vput_defined(vb[0..], 0, "0", d, obj_get(d, t27, "bits32"));
    vn = jv_vput_defined(vb[0..], vn, "1", d, obj_get(d, nv, "bits32"));
    vn = jv_vput_fixed(vb[0..], vn, "2", ((tb - nb) / nb) * 100.0, 0);
    n = jv_fill(dst, n, SAY_STORE_LINE, vb[0..], vn, false);
    return raw(dst, n, "</p>");
}

fn limits_html(dst: []u8, n0: u32, d: []const u8, r: i64) -> u32 {
    const P : i64 = obj_get(d, r, "protocol");
    const arms : i64 = obj_get(d, r, "arms");
    var vb : [512]u8 = [0; 512];
    var vn : u32 = jv_vput_defined(vb[0..], 0, "windows", d, obj_get(d, P, "windows"));
    vn = jv_vput_defined(vb[0..], vn, "seqlen", d, obj_get(d, P, "seqlen"));
    vn = jv_vput_f64(vb[0..], vn, "ncand", arr_len(d, obj_get(d, P, "candidates")) as f64);
    vn = jv_vput_defined(vb[0..], vn, "t27bits", d, obj_get(d, find_arm(d, arms, "T27_STAR"), "bits32"));
    vn = jv_vput_defined(vb[0..], vn, "nvbits", d, obj_get(d, find_arm(d, arms, "NVFP4"), "bits32"));
    vn = jv_vput_defined(vb[0..], vn, "e2m2bits", d, obj_get(d, find_arm(d, arms, "E2M2"), "bits32"));
    var n : u32 = raw(dst, n0, "<h2 class=\"tn-h\">");
    n = text(dst, n, SAY_NOT_TITLE);
    n = raw(dst, n, "</h2><ul class=\"tn-limits\">");
    var i : usize = 0;
    while (i < SAY_LIMITS.len) {
        n = raw(dst, n, "<li>");
        n = jv_fill(dst, n, SAY_LIMITS[i], vb[0..], vn, false);
        n = raw(dst, n, "</li>");
        i = i + 1;
    }
    return raw(dst, n, "</ul>");
}

fn source_text(dst: []u8, n0: u32, d: []const u8, r: i64) -> u32 {
    const S : i64 = obj_get(d, r, "source");
    const run : i64 = obj_get(d, r, "run");
    var vb : [1024]u8 = [0; 1024];
    var vn : u32 = jv_vput_defined(vb[0..], 0, "0", d, obj_get(d, obj_get(d, S, "results"), "path"));
    vn = jv_vput_defined(vb[0..], vn, "1", d, obj_get(d, obj_get(d, S, "results"), "commit"));
    vn = jv_vput_defined(vb[0..], vn, "2", d, obj_get(d, obj_get(d, S, "prereg"), "path"));
    vn = jv_vput_defined(vb[0..], vn, "3", d, obj_get(d, obj_get(d, S, "prereg"), "commit"));
    vn = jv_vput_defined(vb[0..], vn, "4", d, obj_get(d, run, "started"));
    vn = jv_vput_defined(vb[0..], vn, "5", d, obj_get(d, run, "finished"));
    vn = jv_vput_defined(vb[0..], vn, "6", d, obj_get(d, obj_get(d, run, "versions"), "torch"));
    return jv_fill(dst, n0, SAY_SOURCE, vb[0..], vn, false);
}

/// The whole page, as tool.js leaves it: the frame at once, the data's sections after w_data.
pub fn w_render(dst: []u8) -> u32 {
    var n : u32 = 0;
    if (DATA_STATE == 2) {
        n = raw(dst, n, "<p class=\"tn-err\" role=\"alert\">");
        n = text(dst, n, SAY_ERR_LOAD);
        n = raw(dst, n, "</p>");
        if (!ok(n)) { return 0; }
        return n;
    }
    const loaded : bool = DATA_STATE == 1;
    var d : []const u8 = DATA[0..0];
    var r : i64 = NO_SPAN;
    if (loaded) {
        d = DATA[0..(DATA_LEN as usize)];
        r = root(d);
    }
    var lab : u32 = 0;
    if (loaded) { lab = SPLIT; }
    n = raw(dst, n, "<div class=\"tn\" role=\"group\" aria-label=\"");
    var ab : [128]u8 = [0; 128];
    const al : u32 = jv_vput_str(ab[0..], 0, "split", SAY_SPLITS[lab as usize]);
    n = jv_fill(dst, n, SAY_CHART_ALT, ab[0..], al, false);
    n = raw(dst, n, "\"><section class=\"tn-claim\">");
    if (loaded) { n = claim_html(dst, n, d, r); }
    n = raw(dst, n, "</section><div class=\"tn-split\"><span class=\"tn-h\">");
    n = text(dst, n, SAY_SPLIT_LABEL);
    n = raw(dst, n, "</span><div class=\"tn-btns\">");
    var i : u32 = 0;
    while (i < 2) {
        n = raw(dst, n, "<button class=\"t27-btn\" type=\"button\" aria-pressed=\"");
        if (SPLIT == i) { n = raw(dst, n, "true"); } else { n = raw(dst, n, "false"); }
        n = raw(dst, n, "\">");
        n = text(dst, n, SAY_SPLITS[i as usize]);
        n = raw(dst, n, "</button>");
        i = i + 1;
    }
    n = raw(dst, n, "</div><p class=\"tn-line\">");
    if (loaded) { n = text(dst, n, SAY_SPLIT_LINES[SPLIT as usize]); }
    n = raw(dst, n, "</p></div><section class=\"tn-box\">");
    if (loaded) { n = ppl_html(dst, n, d, r); }
    n = raw(dst, n, "</section><section class=\"tn-box\"");
    if (!loaded or SPLIT != 1) { n = raw(dst, n, " hidden=\"\""); }
    n = raw(dst, n, ">");
    if (loaded and CAND_DRAWN) { n = cand_html(dst, n, d, r); }
    n = raw(dst, n, "</section><section class=\"tn-box\">");
    if (loaded) { n = ratios_html(dst, n, d, r); }
    n = raw(dst, n, "</section><section class=\"tn-box\">");
    if (loaded) { n = store_html(dst, n, d, r); }
    n = raw(dst, n, "</section><section class=\"tn-box tn-not\">");
    if (loaded) { n = limits_html(dst, n, d, r); }
    n = raw(dst, n, "</section><p class=\"tn-source\">");
    if (loaded) { n = source_text(dst, n, d, r); }
    n = raw(dst, n, "</p></div>");
    if (!ok(n)) { return 0; }
    return n;
}

/// The splicer follows only the names a module itself mentions, not the names the imported functions
/// mention. This anchor mentions every helper the writer, the JSON reader and the number rules call.
/// Never called.
pub fn imports_anchor(o: []u8, s: []const u8) -> u32 {
    var n : u32 = 0;
    n = n + (ok(0) as u32);
    n = n + OVER;
    n = n + put(o, 0, 0);
    n = n + raw(o, 0, s);
    n = n + put_escaped(o, 0, 0);
    n = n + text(o, 0, s);
    n = n + num(o, 0, 0);
    n = n + attr(o, 0, s, s);
    n = n + fill(o, 0, s, s, s, s, 0);
    n = n + fill_named(o, 0, s, s, s, s, s, s, s, s, s, s, s, s, s);
    n = n + dec_to(o, 0);
    n = n + (name_is(s, 0, 0, s) as u32);
    n = n + (is_word_byte(0) as u32);
    n = n + (H_LT as u32);
    n = n + (H_GT as u32);
    n = n + (H_AMP as u32);
    n = n + (H_QUOTE as u32);
    n = n + (H_APOS as u32);
    n = n + (H_SPACE as u32);
    n = n + (H_SLASH as u32);
    n = n + (H_EQ as u32);
    n = n + ((NO_SPAN < 0) as u32);
    n = n + ((SPAN > 0) as u32);
    n = n + (J_NONE as u32);
    n = n + (J_OBJECT as u32);
    n = n + (J_ARRAY as u32);
    n = n + (J_STRING as u32);
    n = n + (J_NUMBER as u32);
    n = n + (J_TRUE as u32);
    n = n + (J_FALSE as u32);
    n = n + (J_NULL as u32);
    n = n + (jspan(0, 0) as u32);
    n = n + (span_lo(0) as u32);
    n = n + (span_hi(0) as u32);
    n = n + (skip_ws(s, 0) as u32);
    n = n + (string_end(s, 0) as u32);
    n = n + (value_end(s, 0) as u32);
    n = n + (root(s) as u32);
    n = n + (kind(s, 0) as u32);
    n = n + (key_is(s, 0, 0, s) as u32);
    n = n + (obj_get(s, 0, s) as u32);
    n = n + arr_len(s, 0);
    n = n + (arr_at(s, 0, 0) as u32);
    n = n + hex4(s, 0);
    n = n + escape_at(s, 0, 0);
    n = n + cp_utf8_len(0);
    n = n + (cp_utf8_byte(0, 0) as u32);
    n = n + str_len(s, 0);
    n = n + (str_byte(s, 0, 0) as u32);
    n = n + JN_OVER;
    n = n + JN_CAP;
    n = n + ((JN_TWO52 > 0.0) as u32);
    n = n + ((JN_TWO53 > 0.0) as u32);
    n = n + jn_put(o, 0, 0);
    n = n + jn_raw(o, 0, s);
    n = n + jn_digits(o, 0);
    n = n + jn_mul(o, 0, 0);
    n = n + jn_mul2(o, 0, 0);
    n = n + jn_mul5(o, 0, 0);
    n = n + jn_shift(o, 0, 0);
    n = n + (jn_cmp(s, s, 0) as u32);
    n = n + (jn_expo(0.0) as u32);
    n = n + (jn_mant(0.0) as u32);
    n = n + ((jn_make(0, 0) > 0.0) as u32);
    n = n + jn_exact(o, 0, 0);
    n = n + jn_fscale(0);
    n = n + (js_is_nan(0.0) as u32);
    n = n + ((js_nan(0.0) > 0.0) as u32);
    n = n + ((js_inf(1.0) > 0.0) as u32);
    n = n + ((js_floor(0.0) > 0.0) as u32);
    n = n + ((js_ceil(0.0) > 0.0) as u32);
    n = n + ((js_max(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_min(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_round(0.0) > 0.0) as u32);
    n = n + (jn_shortest(o, 1.0) as u32);
    n = n + jn_copy(o, s, 0);
    n = n + jn_put_run(o, 0, s, 0, 0);
    n = n + jn_layout(o, 0, s, 0, 0);
    n = n + js_str_num(o, 0, 0.0);
    n = n + js_to_fixed(o, 0, 0.0, 0);
    n = n + js_locale_num(o, 0, 0.0);
    n = n + (jn_num_ok(s, 0, 0) as u32);
    n = n + (jn_cmp_text(s, 0, 0, 0, 0) as u32);
    n = n + ((js_parse_num(s, 0, 0) > 0.0) as u32);
    n = n + ((jn_dec_value(s, 0, 0) > 0.0) as u32);
    n = n + (jn_abs(0) as u32);
    n = n + js_str_u64(o, 0, 0);
    n = n + jv_str_to(o, 0, s, 0);
    n = n + jv_text_str(o, 0, s, 0);
    n = n + ((jv_numval(s, 0) > 0.0) as u32);
    n = n + jv_str(o, 0, s, 0);
    n = n + jv_text(o, 0, s, 0);
    n = n + (jv_is(s, 0, s) as u32);
    n = n + (jv_truthy(s, 0) as u32);
    n = n + (jv_is_ws(0) as u32);
    n = n + ((jv_number_of_text(s, 0) > 0.0) as u32);
    n = n + ((jv_num(s, 0) > 0.0) as u32);
    n = n + jv_vput_str(o, 0, s, s);
    n = n + jv_vput_f64(o, 0, s, 0.0);
    n = n + jv_vput_val(o, 0, s, s, 0);
    n = n + jv_vput_defined(o, 0, s, s, 0);
    n = n + jv_vput_fixed(o, 0, s, 0.0, 0);
    n = n + jv_kid(o, 0, s, 0);
    n = n + jv_find(s, 0, s);
    n = n + jv_fill(o, 0, s, s, 0, true);
    n = n + (jv_string_ok(s, 0) as u32);
    n = n + (jv_number_ok(s, 0) as u32);
    n = n + (jv_lit_ok(s, 0, s) as u32);
    n = n + (jv_valid(s) as u32);
    return n;
}
