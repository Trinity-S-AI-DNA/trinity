pub const KIND : str = "widget-tool";
pub const ID : str = "fits-on";
pub const TITLE : str = "Fits on a 200T: how many copies of your design an XC7A200T holds";
pub const DESCRIPTION : str = "Type your LUT count (and FF, DSP, BRAM) and see how many copies fit on an XC7A200T, one grid cell per copy, and which resource runs out first. Totals from nextpnr-xilinx.";
pub const IMAGE_ALT : str = "Fits on a 200T card: 28 copies of the AX7203 node0 design (4,738 LUTs, 2,378 FFs, 1 RAMB36E1) fit on an XC7A200T, drawn as 28 cells over 134,600 LUT6 positions; LUTs bind first, flip-flops would allow 113. Totals from nextpnr-xilinx.";
pub const HOOK : str = "nextpnr said 1% LUTs. That design fits 28 times on a 200T, not 100: type your own LUT count and see which resource runs out first.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [5]str = ["nextpnr-xilinx 0.9.2-107-g7037c948 (version from manifest.json beside the log), Device utilisation block: /tmp/x7board/node0/nextpnr.log, sha256 fbdeb0d27c53e0e0aea1981f157193a553f36f1ccf580155f0e779c9d9146d7c, ALINX AX7203, xc7a200tfbg484-2", "the same block in ~/trinity-fpga/build/tnf16_board_ax7203/nextpnr.log, sha256 60e4ef9b281d70f733dd135663349a3af0a43d6751ec9a3df1cefd16969a301e, ALINX AX7203, xc7a200tfbg484-2", "yosys 0.67+post b8e7da6f40 stat blocks in the yosys.full.log beside each log: the synthesis LUT and FF counts", "/tmp/x7board/node0/node_routed.json, sha256 e2f04fb0fb09311843cf8f3ed59b6d5f8e2ebf75c5c93c584ea43f33de4b7f61: NEXTPNR_BEL of each SLICE_LUTX cell, counted per slice position", "scripts/widget-data/fits-on.mjs: parses all of the above into public/widgets/fits-on/device.json and checks this spec against it"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- Totals, as nextpnr-xilinx printed them in both logs --------------------------------------
pub const K_DATA_FILE : str = "device.json";
pub const K_SLICE_LUTX : u32 = 269200;
pub const K_SLICE_FFX : u32 = 269200;
pub const K_CARRY4 : u32 = 33650;
pub const K_DSP48E1 : u32 = 740;
pub const K_RAMB36E1 : u32 = 365;
pub const K_RAMB18E1 : u32 = 730;
; PAD BELs in the fbg484 chipdb: a BEL count, not bonded pins; quoted only to say so, never used.
pub const K_PAD_FBG484 : u32 = 1062;
; A slice has one CARRY4, four LUT positions and two LUT BELs per position.
pub const K_POSITIONS_PER_SLICE : u8 = 4;
pub const K_BELS_PER_POSITION : u8 = 2;
pub const K_LUT_POSITIONS : u32 = 134600;

; --- What the page divides by ------------------------------------------------------------------
; Rows: LUT, FF, DSP, BRAM in 18Kb halves. K_CAPACITY[0] is replaced by K_SLICE_LUTX when the
; reader picks LUT BELs (K_DIVIDE_MODES[1]).
pub const K_RESOURCES : [4]str = ["LUT", "FF", "DSP", "BRAM18"];
pub const K_CAPACITY : [4]u32 = [134600, 269200, 740, 730];
pub const K_DIVIDE_MODES : [2]str = ["positions", "bels"];
; Inputs, in the order of the K_EX_* arrays: SLICE_LUTX, SLICE_FFX, DSP48E1, RAMB36E1, RAMB18E1.
pub const K_INPUTS : [5]str = ["SLICE_LUTX", "SLICE_FFX", "DSP48E1", "RAMB36E1", "RAMB18E1"];
pub const K_HALVES_PER_INPUT : [2]u8 = [2, 1];
; The grid draws at most this many cells; above it one cell stands for several copies.
pub const K_GRID_MAX_CELLS : u16 = 600;
pub const K_INPUT_MAX : u32 = 10000000;

; --- Two real designs, used column of each log (checked by scripts/widget-data/fits-on.mjs) ---
pub const K_EXAMPLES : [2]str = ["node0", "tnf16"];
pub const K_EX_NODE0 : [5]u32 = [4738, 2378, 0, 1, 0];
pub const K_EX_NODE0_COPIES : u32 = 28;
pub const K_EX_NODE0_COPIES_BELS : u32 = 56;
pub const K_EX_NODE0_YOSYS_LUT : u32 = 4732;
pub const K_EX_NODE0_LUT6_POSITIONS : u32 = 4738;
pub const K_EX_TNF16 : [5]u32 = [838, 541, 0, 0, 0];
pub const K_EX_TNF16_COPIES : u32 = 160;
pub const K_EX_TNF16_COPIES_BELS : u32 = 321;
pub const K_EX_TNF16_YOSYS_LUT : u32 = 836;

; --- Words on screen ---------------------------------------------------------------------------
; Templates take {0}, {1}, ... in order; numbers are filled from K_ constants or device.json.
pub const SAY_LOADING : str = "Reading the device totals...";
pub const SAY_ERR_DATA : str = "The device totals did not load.";
pub const SAY_INPUT_TITLE : str = "One copy of your design uses";
pub const SAY_INPUT_NAMES : [5]str = ["LUTs", "Flip-flops", "DSP48E1", "RAMB36E1", "RAMB18E1"];
pub const SAY_INPUT_NOTES : [5]str = ["SLICE_LUTX, or a yosys LUT1-LUT6 count", "SLICE_FFX, or yosys FD* cells", "optional", "optional, 36Kb block RAM", "optional, 18Kb block RAM"];
pub const SAY_PRESET_LABEL : str = "Real designs";
pub const SAY_PRESET_NAMES : [2]str = ["node0", "tnf16"];
pub const SAY_PRESET_LINE : str = "{0} on the {1} ({2}): nextpnr placed {3} SLICE_LUTX; yosys had counted {4} LUT1-LUT6 cells.";
pub const SAY_DIVIDE_LABEL : str = "Divide LUTs by";
pub const SAY_DIVIDE_NAMES : [2]str = ["LUT6 positions", "LUT BELs"];
pub const SAY_EMPTY : str = "Type a LUT count, or pick a real design.";
pub const SAY_RESULT_MANY : str = "{0} copies fit";
pub const SAY_RESULT_ONE : str = "1 copy fits";
pub const SAY_RESULT_NONE : str = "Does not fit";
pub const SAY_BINDING : str = "{0} run out first: {1} per copy, {2} on the device.";
pub const SAY_TOO_BIG : str = "One copy needs {1} {0}; the device has {2}.";
pub const SAY_UPPER_BOUND : str = "At 100% of {0}: an upper bound, not a promise that it routes.";
pub const SAY_COLS : [4]str = ["resource", "per copy", "on the device", "copies"];
pub const SAY_RES_NAMES : [4]str = ["LUTs", "Flip-flops", "DSP48E1", "Block RAM, 18Kb halves"];
pub const SAY_RES_UNITS : [4]str = ["LUT6 positions", "SLICE_FFX", "DSP48E1", "RAMB18E1 sites"];
pub const SAY_LUT_BELS_UNIT : str = "LUT BELs";
pub const SAY_NOT_USED : str = "not used";
pub const SAY_GRID_LINE : str = "One cell per copy over the device's {0}; the last, hollow cell is what is left: {1}.";
pub const SAY_GRID_SCALED : str = "One cell per {0} copies over the device's {1}; the last, hollow cell is what is left: {2}.";
pub const SAY_GRID_LABEL : str = "{0} copies drawn over {1} {2}";
pub const SAY_NOTES_TITLE : str = "Read this before you trust the number";
pub const SAY_NOTE_LUT : str = "nextpnr-xilinx counts LUT BELs: its SLICE_LUTX total {0} is {1} slices x {2}, a LUT6 and a LUT5 BEL at each of a slice's four positions. A position holds one six-input LUT, or two smaller LUTs that share its inputs. In node0's routed result nextpnr put its {3} LUT cells on {4} different positions, none shared. So this page divides by positions, {5}; nextpnr's own percent column divides by {0}, and reads half as full for a design like that one. LUT BELs gives the ceiling if every LUT found a partner.";
pub const SAY_NOTE_BOUND : str = "A yosys LUT count is a synthesis count, not what nextpnr places: for node0 yosys counted {0} LUT1-LUT6 cells and nextpnr placed {1}. Every result here is at 100% of the binding resource, an upper bound; placement and routing need room, so fewer copies will route. How many fewer, none of this page's sources measures, so no lower figure is shown.";
pub const SAY_NOTE_PACKAGE : str = "The package decides which pins are bonded, not what the die holds: LUT, FF, DSP and block RAM totals are the XC7A200T's in any package. Both logs are from the {0} ({1}), not the QMTech Wukong (fgg676). Their PAD total, {2}, is a chipdb BEL count, not a count of bonded pins; this page uses it for nothing and claims no pin count for the Wukong.";
pub const SAY_SOURCE_TITLE : str = "Where the totals come from";
pub const SAY_SOURCE_LINE : str = "{0}: sha256 {1}, {2} bytes, top {3}";
pub const SAY_SOURCE_VERSION : str = "The logs carry no version line; the manifest.json beside them names nextpnr-xilinx {0}. Both logs print the same total for all {1} BEL types.";

; --- Tests ---------------------------------------------------------------------------------------
test the_totals_are_the_parsed_nextpnr_totals {
    assert K_SLICE_LUTX == 269200;
    assert K_SLICE_FFX == 269200;
    assert K_CARRY4 == 33650;
    assert K_DSP48E1 == 740;
    assert K_RAMB36E1 == 365;
    assert K_RAMB18E1 == 730;
    assert K_PAD_FBG484 == 1062;
}

test lut_bels_are_eight_per_slice_and_positions_half_of_them {
    assert K_SLICE_LUTX == K_CARRY4 * K_POSITIONS_PER_SLICE * K_BELS_PER_POSITION;
    assert K_LUT_POSITIONS == K_SLICE_LUTX / K_BELS_PER_POSITION;
    assert K_LUT_POSITIONS == K_CARRY4 * K_POSITIONS_PER_SLICE;
    assert K_SLICE_FFX == K_CARRY4 * 8;
    assert K_RAMB18E1 == K_RAMB36E1 * K_HALVES_PER_INPUT[0];
}

test the_capacity_row_is_the_totals {
    assert K_CAPACITY[0] == K_LUT_POSITIONS;
    assert K_CAPACITY[1] == K_SLICE_FFX;
    assert K_CAPACITY[2] == K_DSP48E1;
    assert K_CAPACITY[3] == K_RAMB18E1;
    assert K_RESOURCES[0] == "LUT";
    assert K_DIVIDE_MODES[0] == "positions";
}

test node0_fits_28_times_and_luts_bind {
    assert K_LUT_POSITIONS / K_EX_NODE0[0] == K_EX_NODE0_COPIES;
    assert K_EX_NODE0_COPIES * K_EX_NODE0[0] <= K_LUT_POSITIONS;
    assert K_EX_NODE0_COPIES * K_EX_NODE0[0] + K_EX_NODE0[0] > K_LUT_POSITIONS;
    assert K_SLICE_FFX / K_EX_NODE0[1] > K_EX_NODE0_COPIES;
    assert K_RAMB18E1 / (K_HALVES_PER_INPUT[0] * K_EX_NODE0[3] + K_EX_NODE0[4]) > K_EX_NODE0_COPIES;
    assert K_SLICE_LUTX / K_EX_NODE0[0] == K_EX_NODE0_COPIES_BELS;
}

test node0_used_one_position_per_lut_cell {
    assert K_EX_NODE0_LUT6_POSITIONS == K_EX_NODE0[0];
    assert K_EX_NODE0_YOSYS_LUT < K_EX_NODE0[0];
}

test tnf16_fits_160_times_and_luts_bind {
    assert K_LUT_POSITIONS / K_EX_TNF16[0] == K_EX_TNF16_COPIES;
    assert K_EX_TNF16_COPIES * K_EX_TNF16[0] + K_EX_TNF16[0] > K_LUT_POSITIONS;
    assert K_SLICE_FFX / K_EX_TNF16[1] > K_EX_TNF16_COPIES;
    assert K_SLICE_LUTX / K_EX_TNF16[0] == K_EX_TNF16_COPIES_BELS;
    assert K_EX_TNF16_YOSYS_LUT < K_EX_TNF16[0];
}

test the_page_reads_no_file_and_sends_nothing {
    assert READS_LOCAL_FILES == false;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
    assert ID == "fits-on";
}


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, issue #10938, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/fits-on/tool.js (232 lines of hand-written JavaScript). The
; words and numbers above are unchanged. The page draws a CANVAS, so beside the protocol of
; jtag_verdict.t27 / race_the_bee.t27 it uses canvas_out.t27's draw list:
;   w_init(hash)          the page opens: nothing fetched, nothing rendered
;   w_view(width, dpr, embed)  the three inputs tool.js reads from the window: the width of the widget
;                         root (the canvas's parent), devicePixelRatio, and whether <html> has class
;                         "embed". The host calls it before every event and after a resize.
;   w_data(i, bytes)      device.json has been fetched; w_data_failed(i) when it could not be
;   w_input(i, text)      the i-th number field was edited
;   w_click(i)            the i-th button in document order: 0-1 a real design, 2-3 the divide mode
;   w_resize()            the window was resized (the host waits 120 ms of quiet, as tool.js does)
;   w_render(dst)         the page's HTML, length (0 on overflow)
;   w_draw(dst)           the canvas draw list (canvas_out.t27) for the canvas w_render wrote
; tool.js's render() is do_render() here: it runs when tool.js calls render() (an input, a button, the
; data arriving, a resize) and keeps what tool.js's persistent elements keep: the canvas keeps its
; width/height/style/aria-label while it is hidden, the headline keeps its class when the page says
; "type a LUT count". w_render prints from that state and changes none of it.
; Not carried over (said plainly): a device.json whose examples[0] is null/missing, or whose example has
; no nextpnr_log / used / yosys object, makes tool.js throw halfway and leave a half-built page; this
; page prints those fields as undefined ("NaN" / "") and builds all of it. A duplicate key in the JSON
; reads as the first one here, the last in JSON.parse. The data file is cut at W_DATA_CAP bytes (the
; page then says it could not load), an input text at W_TEXT_CAP bytes.

; MEASURED 2026-10-19: t27c gen + a 9-line Zig export wrapper + zig build-exe wasm32-freestanding ReleaseSmall give
; a 30952-byte wasm. The original page (tool.js) and this one ran in two DOM windows (happy-dom) with a FAKE
; getContext('2d') on each that records every method call and every property assignment as one string; after
; every action the DOM and the recorded sequence of the two were compared: 4317 DOM comparisons and 4317
; call-sequence comparisons (533752 calls and assignments recorded), 41 variants of device.json (28 that load:
; null, missing, string, boolean, array and object fields, 1e21 and -1234.5678 and 5e-7, markup, quotes, accents
; and an emoji, one / three / 42 examples, odd nextpnr_log and version, extra totals keys, escapes, minified and
; pretty; 13 that must not load), a loading phase with events before the data, a 404 and a non-JSON answer, a
; 1700-step fuzz of the five inputs (numbers, signs, 1e3, 0x10, Infinity, 1e400, blanks) with the buttons, the
; window width (0 to 3000), devicePixelRatio (0, 1, 1.25, 1.5, 2, 2.625, 3, NaN), the embed class and the CSS
; variables, and the debounced resize: 0 differences. Negative controls: a changed DOM node, a rect digit moved by
; 1e-9, a property value moved by 1e-9, a skipped clearRect and a changed CSS fallback are each reported.
; NOT compared (happy-dom has no layout or pixels): the pixels the context draws, real clientWidth values, and a
; real canvas.width reset (the fake context has no state to reset).

pub const W_DATA_CAP : u32 = 262144;
pub const W_TEXT_CAP : u32 = 128;
pub const W_NINPUTS : u32 = 5;
pub const W_NPRESETS : u32 = 2;
pub const W_GREEN_VAR : str = "--w-green";
pub const W_GREEN_FALLBACK : str = "#00ff88";
pub const W_GOLD_VAR : str = "--w-gold";
pub const W_GOLD_FALLBACK : str = "#ffd700";
pub const W_LINE_VAR : str = "--w-line";
pub const W_LINE_FALLBACK : str = "#1a4";

pub var DATA : [262144]u8 = [0; 262144];
pub var DATA_LEN : u32 = 0;
pub var LOAD : u8 = 0;
pub var MODE : u32 = 0;
pub var PRESET : i32 = -1;
pub var COUNTS : [5]u64 = [0; 5];
pub var IN_TXT : [640]u8 = [0; 640];
pub var IN_LEN : [5]u32 = [0; 5];
pub var RENDERED : bool = false;
pub var HL_NONE : bool = false;
pub var ENV_W : f64 = 0.0;
pub var ENV_DPR : f64 = 1.0;
pub var ENV_EMBED : u32 = 0;
pub var CV_SET : bool = false;
pub var CV_HIDDEN : bool = false;
pub var CV_PX_W : u64 = 0;
pub var CV_PX_H : u64 = 0;
pub var CV_CSS_W : u64 = 0;
pub var CV_CSS_H : u64 = 0;
pub var CV_LBL : [512]u8 = [0; 512];
pub var CV_LBL_LEN : u32 = 0;
pub var G_N : u64 = 0;
pub var G_SCALE : u64 = 1;
pub var G_FULL : u64 = 0;
pub var G_REST : u64 = 0;
pub var G_LEFT : u64 = 0;
pub var G_U : u64 = 0;
pub var G_COLS : u64 = 1;
pub var G_SIZE : u64 = 0;
pub var G_W : u64 = 0;
pub var G_H : u64 = 0;
pub var G_DPR : f64 = 1.0;
pub var G_GAP : f64 = 0.0;

pub fn w_init(h: []const u8) -> u32 {
    LOAD = 0;
    DATA_LEN = 0;
    MODE = 0;
    PRESET = 0 - 1;
    var i : usize = 0;
    while (i < 5) {
        COUNTS[i] = 0;
        IN_LEN[i] = 0;
        i = i + 1;
    }
    RENDERED = false;
    HL_NONE = false;
    CV_SET = false;
    CV_HIDDEN = false;
    CV_LBL_LEN = 0;
    G_N = 0;
    return 0;
}

pub fn w_view(width: f64, dpr: f64, embed: u32) -> u32 {
    ENV_W = width;
    ENV_DPR = dpr;
    ENV_EMBED = embed;
    return 0;
}

// --- the data --------------------------------------------------------------------------------

fn totals_agree(d: []const u8, r: i64) -> bool {
    const t : i64 = obj_get(d, r, "totals");
    if (kind(d, t) != J_OBJECT) { return false; }
    const a : i64 = obj_get(d, t, "SLICE_LUTX");
    const b : i64 = obj_get(d, t, "SLICE_FFX");
    const c : i64 = obj_get(d, t, "DSP48E1");
    const e : i64 = obj_get(d, t, "RAMB18E1");
    const f : i64 = obj_get(d, t, "RAMB36E1");
    if (kind(d, a) != J_NUMBER or jv_numval(d, a) != (K_SLICE_LUTX as f64)) { return false; }
    if (kind(d, b) != J_NUMBER or jv_numval(d, b) != (K_SLICE_FFX as f64)) { return false; }
    if (kind(d, c) != J_NUMBER or jv_numval(d, c) != (K_DSP48E1 as f64)) { return false; }
    if (kind(d, e) != J_NUMBER or jv_numval(d, e) != (K_RAMB18E1 as f64)) { return false; }
    if (kind(d, f) != J_NUMBER or jv_numval(d, f) != (K_RAMB36E1 as f64)) { return false; }
    return true;
}

fn data_agrees(d: []const u8) -> bool {
    const r : i64 = root(d);
    if (!totals_agree(d, r)) { return false; }
    const ex : i64 = obj_get(d, r, "examples");
    return kind(d, ex) == J_ARRAY and arr_len(d, ex) > 0;
}

pub fn w_data(i: u32, s: []const u8) -> u32 {
    if (s.len > (W_DATA_CAP as usize)) {
        LOAD = 2;
        return 0;
    }
    var k : usize = 0;
    while (k < s.len) {
        DATA[k] = s[k];
        k = k + 1;
    }
    DATA_LEN = s.len as u32;
    const d : []const u8 = DATA[0..(DATA_LEN as usize)];
    if (!jv_valid(d)) {
        LOAD = 2;
        return 0;
    }
    if (!data_agrees(d)) {
        LOAD = 2;
        return 0;
    }
    LOAD = 1;
    if (notes_throw(d)) {
        LOAD = 3;
        return 0;
    }
    use_preset(0);
    return 0;
}

/// Does renderNotes(d) throw? It reads ex0.board (examples[0] null) and e.nextpnr_log.path of every example
/// (nextpnr_log null or missing). tool.js then keeps the data, leaves the status line hidden with the error
/// text, and never reaches usePreset(0).
fn notes_throw(d: []const u8) -> bool {
    const exs : i64 = obj_get(d, root(d), "examples");
    if (kind(d, arr_at(d, exs, 0)) == J_NULL) { return true; }
    const cnt : u32 = arr_len(d, exs);
    var i : u32 = 0;
    while (i < cnt) {
        const k : u8 = kind(d, obj_get(d, arr_at(d, exs, i), "nextpnr_log"));
        if (k == J_NONE or k == J_NULL) { return true; }
        i = i + 1;
    }
    return false;
}

fn ex0_is_null(d: []const u8) -> bool {
    return kind(d, arr_at(d, obj_get(d, root(d), "examples"), 0)) == J_NULL;
}

pub fn w_data_failed(i: u32) -> u32 {
    LOAD = 2;
    return 0;
}

/// Object.keys(o).length for the members of the object at sp.
fn obj_len(d: []const u8, sp: i64) -> u32 {
    if (kind(d, sp) != J_OBJECT) { return 0; }
    const hi : usize = span_hi(sp);
    var p : usize = skip_ws(d, span_lo(sp) + 1);
    var n : u32 = 0;
    while (p < hi and d[p] == 34) {
        const ke : usize = string_end(d, p);
        if (ke > hi) { return n; }
        const q : usize = skip_ws(d, ke);
        if (q >= hi or d[q] != 58) { return n; }
        const v : usize = skip_ws(d, q + 1);
        const ve : usize = value_end(d, v);
        if (ve > hi) { return n; }
        n = n + 1;
        p = skip_ws(d, ve);
        if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
    }
    return n;
}

// --- the state: tool.js's readInputs, usePreset, fit ---------------------------------------------

fn example_count(ix: u32, j: u32) -> u64 {
    if (ix == 0) { return K_EX_NODE0[j as usize] as u64; }
    return K_EX_TNF16[j as usize] as u64;
}

/// Math.floor(Number(text)), finite and above zero, else 0, at most K_INPUT_MAX.
fn count_of_text(base: u32, len: u32) -> u64 {
    const v : f64 = js_floor(jv_number_of_text(IN_TXT[(base as usize)..((base + len) as usize)], len));
    if (js_is_nan(v)) { return 0; }
    if (v - v != 0.0) { return 0; }
    if (!(v > 0.0)) { return 0; }
    if (v > (K_INPUT_MAX as f64)) { return K_INPUT_MAX as u64; }
    return v as u64;
}

fn read_inputs() -> u32 {
    var i : u32 = 0;
    while (i < W_NINPUTS) {
        COUNTS[i as usize] = count_of_text(i * W_TEXT_CAP, IN_LEN[i as usize]);
        i = i + 1;
    }
    return 0;
}

fn set_text(i: u32, s: []const u8) -> u32 {
    var len : u32 = s.len as u32;
    if (len > W_TEXT_CAP) { len = W_TEXT_CAP; }
    var k : u32 = 0;
    while (k < len) {
        IN_TXT[(i * W_TEXT_CAP + k) as usize] = s[k as usize];
        k = k + 1;
    }
    IN_LEN[i as usize] = len;
    return 0;
}

fn use_preset(ix: u32) -> u32 {
    PRESET = ix as i32;
    var j : u32 = 0;
    while (j < W_NINPUTS) {
        const c : u64 = example_count(ix, j);
        COUNTS[j as usize] = c;
        if (c == 0) {
            IN_LEN[j as usize] = 0;
        } else {
            var tmp : [24]u8 = [0; 24];
            const l : u32 = dec_to(tmp[0..], c);
            set_text(j, tmp[0..(l as usize)]);
        }
        j = j + 1;
    }
    do_render();
    return 0;
}

pub fn w_input(i: u32, s: []const u8) -> u32 {
    if (i >= W_NINPUTS) { return 0; }
    PRESET = 0 - 1;
    set_text(i, s);
    read_inputs();
    do_render();
    return 0;
}

pub fn w_click(i: u32) -> u32 {
    if (i < W_NPRESETS) {
        use_preset(i);
        return 0;
    }
    if (i < W_NPRESETS + 2) {
        MODE = i - W_NPRESETS;
        do_render();
    }
    return 0;
}

pub fn w_resize() -> u32 {
    do_render();
    return 0;
}

/// Per copy, in the units of K_CAPACITY's rows: LUT, FF, DSP, block RAM in 18Kb halves.
fn per_copy(j: u32) -> u64 {
    if (j == 3) { return (K_HALVES_PER_INPUT[0] as u64) * COUNTS[3] + (K_HALVES_PER_INPUT[1] as u64) * COUNTS[4]; }
    return COUNTS[j as usize];
}

fn cap_of(j: u32) -> u64 {
    if (j == 0 and MODE == 1) { return K_SLICE_LUTX as u64; }
    return K_CAPACITY[j as usize] as u64;
}

/// Copies of row j that fit; only meaningful when the row is used (per_copy above zero).
fn copies_of(j: u32) -> u64 {
    return cap_of(j) / per_copy(j);
}

/// The smallest quotient over the used rows; 4 (no row) when none is used.
fn binding_first() -> u32 {
    var best : u32 = 4;
    var j : u32 = 0;
    while (j < 4) {
        if (per_copy(j) > 0) {
            if (best == 4 or copies_of(j) < copies_of(best)) { best = j; }
        }
        j = j + 1;
    }
    return best;
}

fn is_binding(j: u32, b: u32) -> bool {
    return b < 4 and per_copy(j) > 0 and copies_of(j) == copies_of(b);
}

// --- the grid: do_render keeps the geometry the canvas and the list need ---------------------------

fn do_render() -> u32 {
    RENDERED = true;
    const b : u32 = binding_first();
    if (b == 4) {
        CV_HIDDEN = true;
        return 0;
    }
    const n : u64 = copies_of(b);
    if (n == 0) {
        HL_NONE = true;
        CV_HIDDEN = true;
        return 0;
    }
    HL_NONE = false;
    CV_HIDDEN = false;
    CV_SET = true;
    const u : u64 = per_copy(b);
    const nf : f64 = n as f64;
    const scale : f64 = js_max(1.0, js_ceil(nf / (K_GRID_MAX_CELLS as f64)));
    const full : f64 = js_floor(nf / scale);
    const rest : f64 = nf - full * scale;
    const left : u64 = cap_of(b) - n * u;
    var cells : f64 = full + 1.0;
    if (rest > 0.0) { cells = cells + 1.0; }
    var cw : f64 = ENV_W;
    if (cw == 0.0 or cw != cw) { cw = 600.0; }
    const width : f64 = js_max(200.0, js_floor(cw));
    var target : f64 = 220.0;
    if (ENV_EMBED != 0) { target = 130.0; } else { if (width < 500.0) { target = 180.0; } }
    var cols : f64 = js_max(1.0, js_ceil(@sqrt((cells * width) / target)));
    var size : f64 = js_floor(width / cols);
    while (js_ceil(cells / cols) * size > target * 1.4 and cols < cells) {
        cols = cols + 1.0;
        size = js_floor(width / cols);
    }
    const rows : f64 = js_ceil(cells / cols);
    const height : f64 = rows * size;
    var dpr : f64 = ENV_DPR;
    if (dpr == 0.0 or dpr != dpr) { dpr = 1.0; }
    CV_PX_W = (width * dpr) as u64;
    CV_PX_H = (height * dpr) as u64;
    CV_CSS_W = width as u64;
    CV_CSS_H = height as u64;
    G_N = n;
    G_SCALE = scale as u64;
    G_FULL = full as u64;
    G_REST = rest as u64;
    G_LEFT = left;
    G_U = u;
    G_COLS = cols as u64;
    G_SIZE = size as u64;
    G_W = width as u64;
    G_H = height as u64;
    G_DPR = dpr;
    if (size >= 8.0) { G_GAP = js_max(1.0, js_round(size / 10.0)); } else { G_GAP = 0.0; }
    // aria-label: fmt(SAY_GRID_LABEL, num(n), num(b.cap), unit(b.i)), stored as plain text
    var vb : [512]u8 = [0; 512];
    var vn : u32 = pool_u(vb[0..], 0, "0", n);
    vn = pool_u(vb[0..], vn, "1", cap_of(b));
    vn = pool_unit(vb[0..], vn, "2", b);
    CV_LBL_LEN = jv_fill_raw(CV_LBL[0..], 0, SAY_GRID_LABEL, vb[0..], vn, true);
    if (CV_LBL_LEN == OVER) { CV_LBL_LEN = 0; }
    return 0;
}

pub fn w_draw(dst: []u8) -> u32 {
    if (!RENDERED or CV_HIDDEN) { return 0; }
    var n : u32 = cv_canvas(dst, 0, 0);
    n = cv_call6(dst, n, "setTransform", G_DPR, 0.0, 0.0, G_DPR, 0.0, 0.0);
    n = cv_call4(dst, n, "clearRect", 0.0, 0.0, G_W as f64, G_H as f64);
    const size : f64 = G_SIZE as f64;
    const s : f64 = size - G_GAP;
    var k : u64 = 0;
    while (k < G_FULL) {
        n = cv_set_var(dst, n, "fillStyle", W_GREEN_VAR, W_GREEN_FALLBACK);
        n = cv_call4(dst, n, "fillRect", ((k % G_COLS) as f64) * size, ((k / G_COLS) as f64) * size, s, s);
        k = k + 1;
    }
    if (G_REST > 0) {
        const x : f64 = ((k % G_COLS) as f64) * size;
        const y : f64 = ((k / G_COLS) as f64) * size;
        k = k + 1;
        n = cv_set_var(dst, n, "strokeStyle", W_LINE_VAR, W_LINE_FALLBACK);
        n = cv_call4(dst, n, "strokeRect", x + 0.5, y + 0.5, s - 1.0, s - 1.0);
        n = cv_set_var(dst, n, "fillStyle", W_GREEN_VAR, W_GREEN_FALLBACK);
        n = cv_call4(dst, n, "fillRect", x, y, s * ((G_REST as f64) / (G_SCALE as f64)), s);
    }
    const gx : f64 = ((k % G_COLS) as f64) * size;
    const gy : f64 = ((k / G_COLS) as f64) * size;
    n = cv_set_var(dst, n, "strokeStyle", W_GOLD_VAR, W_GOLD_FALLBACK);
    n = cv_set_num(dst, n, "lineWidth", js_max(1.0, js_min(2.0, s / 8.0)));
    n = cv_call4(dst, n, "strokeRect", gx + 0.5, gy + 0.5, s - 1.0, s - 1.0);
    const frac : f64 = js_min(1.0, (G_LEFT as f64) / ((G_U * G_SCALE) as f64));
    if (frac > 0.0) {
        n = cv_set_num(dst, n, "globalAlpha", 0.35);
        n = cv_set_var(dst, n, "fillStyle", W_GOLD_VAR, W_GOLD_FALLBACK);
        n = cv_call4(dst, n, "fillRect", gx, gy + s * (1.0 - frac), s, s * frac);
        n = cv_set_num(dst, n, "globalAlpha", 1.0);
    }
    if (!cv_ok(n)) { return 0; }
    return n;
}

// --- text pieces: fmt() and num() of tool.js -----------------------------------------------------

/// A fmt() argument that is a number written by num(): the grouped decimal.
fn pool_u(vb: []u8, n0: u32, key: []const u8, v: u64) -> u32 {
    var tmp : [32]u8 = [0; 32];
    const l : u32 = num_grouped(tmp[0..], 0, v);
    return jv_vput_str(vb, n0, key, tmp[0..(l as usize)]);
}

/// A fmt() argument that is an integer written by String().
fn pool_plain(vb: []u8, n0: u32, key: []const u8, v: u64) -> u32 {
    var tmp : [32]u8 = [0; 32];
    const l : u32 = dec_to(tmp[0..], v);
    return jv_vput_str(vb, n0, key, tmp[0..(l as usize)]);
}

/// unit(i) as plain text.
fn unit_to(o: []u8, n0: u32, i: u32) -> u32 {
    if (i == 0 and MODE == 1) { return jn_raw(o, n0, SAY_LUT_BELS_UNIT); }
    return jn_raw(o, n0, SAY_RES_UNITS[i as usize]);
}

fn pool_unit(vb: []u8, n0: u32, key: []const u8, i: u32) -> u32 {
    var tmp : [48]u8 = [0; 48];
    const l : u32 = unit_to(tmp[0..], 0, i);
    return jv_vput_str(vb, n0, key, tmp[0..(l as usize)]);
}

/// `${num(v)} ${unit(i)}` as a fmt() argument.
fn pool_num_unit(vb: []u8, n0: u32, key: []const u8, v: u64, i: u32) -> u32 {
    var tmp : [96]u8 = [0; 96];
    var l : u32 = num_grouped(tmp[0..], 0, v);
    l = put(tmp[0..], l, 32);
    l = unit_to(tmp[0..], l, i);
    return jv_vput_str(vb, n0, key, tmp[0..(l as usize)]);
}

/// A fmt() argument that is a JSON value: String(v ?? '').
fn pool_val(vb: []u8, n0: u32, key: []const u8, d: []const u8, sp: i64) -> u32 {
    const k : u8 = kind(d, sp);
    if (k == J_NONE or k == J_NULL) { return jv_vput_str(vb, n0, key, ""); }
    return jv_vput_val(vb, n0, key, d, sp);
}

/// A fmt() argument that is num(v) for a JSON value: Number(v).toLocaleString('en-US').
fn pool_num(vb: []u8, n0: u32, key: []const u8, d: []const u8, sp: i64) -> u32 {
    var tmp : [64]u8 = [0; 64];
    const l : u32 = js_locale_num(tmp[0..], 0, jv_num(d, sp));
    return jv_vput_str(vb, n0, key, tmp[0..(l as usize)]);
}

/// The template filled from the pool, as escaped text; OVER when the pool overflowed.
fn fmt_to(dst: []u8, n0: u32, t: []const u8, vb: []const u8, vn: u32) -> u32 {
    if (vn == OVER or n0 == OVER) { return OVER; }
    return jv_fill(dst, n0, t, vb, vn, true);
}

fn words(dst: []u8, n0: u32, i: u32) -> u32 {
    return text(dst, n0, SAY_RES_NAMES[i as usize]);
}

fn btn(dst: []u8, n0: u32, pressed: bool, label: []const u8) -> u32 {
    var n : u32 = raw(dst, n0, "<button class=\"t27-btn\" type=\"button\" aria-pressed=\"");
    if (pressed) { n = raw(dst, n, "true"); } else { n = raw(dst, n, "false"); }
    n = raw(dst, n, "\">");
    n = text(dst, n, label);
    return raw(dst, n, "</button>");
}

fn input_field(dst: []u8, n0: u32, i: u32) -> u32 {
    var n : u32 = raw(dst, n0, "<label class=\"fo-field\" for=\"fo-in-");
    n = num(dst, n, i as u64);
    n = raw(dst, n, "\"><span class=\"fo-field-name\">");
    n = text(dst, n, SAY_INPUT_NAMES[i as usize]);
    n = raw(dst, n, "<small>");
    n = text(dst, n, SAY_INPUT_NOTES[i as usize]);
    n = raw(dst, n, "</small></span><input type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"");
    n = num(dst, n, K_INPUT_MAX as u64);
    n = raw(dst, n, "\" step=\"1\" id=\"fo-in-");
    n = num(dst, n, i as u64);
    n = raw(dst, n, "\" placeholder=\"0\" value=\"");
    n = text(dst, n, IN_TXT[((i * W_TEXT_CAP) as usize)..((i * W_TEXT_CAP + IN_LEN[i as usize]) as usize)]);
    return raw(dst, n, "\"></label>");
}

/// The preset line: tool.js's presetLine.textContent.
fn preset_line(dst: []u8, n0: u32, d: []const u8) -> u32 {
    if ((LOAD != 1 and LOAD != 3) or PRESET < 0) { return n0; }
    const r : i64 = root(d);
    const ex : i64 = arr_at(d, obj_get(d, r, "examples"), PRESET as u32);
    if (!jv_truthy(d, ex)) { return n0; }
    const used : i64 = obj_get(d, ex, "used");
    const yo : i64 = obj_get(d, ex, "yosys");
    var vb : [8192]u8 = [0; 8192];
    var vn : u32 = pool_val(vb[0..], 0, "0", d, obj_get(d, ex, "top"));
    vn = pool_val(vb[0..], vn, "1", d, obj_get(d, ex, "board"));
    vn = pool_val(vb[0..], vn, "2", d, obj_get(d, ex, "part"));
    vn = pool_num(vb[0..], vn, "3", d, obj_get(d, used, "SLICE_LUTX"));
    vn = pool_num(vb[0..], vn, "4", d, obj_get(d, yo, "LUT"));
    return fmt_to(dst, n0, SAY_PRESET_LINE, vb[0..], vn);
}

fn table_html(dst: []u8, n0: u32, b: u32) -> u32 {
    var n : u32 = raw(dst, n0, "<div class=\"fo-table\" role=\"table\">");
    if (RENDERED) {
        n = raw(dst, n, "<div class=\"fo-row fo-head\" role=\"row\">");
        var c : usize = 0;
        while (c < 4) {
            n = raw(dst, n, "<span role=\"columnheader\">");
            n = text(dst, n, SAY_COLS[c]);
            n = raw(dst, n, "</span>");
            c = c + 1;
        }
        n = raw(dst, n, "</div>");
        var j : u32 = 0;
        while (j < 4) {
            n = raw(dst, n, "<div class=\"fo-row");
            if (is_binding(j, b)) { n = raw(dst, n, " is-binding"); }
            n = raw(dst, n, "\" role=\"row\"><span role=\"cell\" class=\"fo-name\">");
            n = words(dst, n, j);
            n = raw(dst, n, "<small>");
            var ub : [48]u8 = [0; 48];
            const ul : u32 = unit_to(ub[0..], 0, j);
            n = text(dst, n, ub[0..(ul as usize)]);
            n = raw(dst, n, "</small></span><span role=\"cell\">");
            if (per_copy(j) > 0) { n = num_grouped(dst, n, per_copy(j)); } else { n = text(dst, n, SAY_NOT_USED); }
            n = raw(dst, n, "</span><span role=\"cell\">");
            n = num_grouped(dst, n, cap_of(j));
            n = raw(dst, n, "</span><span role=\"cell\" class=\"fo-copies\">");
            if (per_copy(j) > 0) { n = num_grouped(dst, n, copies_of(j)); } else { n = raw(dst, n, "-"); }
            n = raw(dst, n, "</span></div>");
            j = j + 1;
        }
    }
    return raw(dst, n, "</div>");
}

/// The notes section and the sources list: tool.js's renderNotes(d).
fn notes_html(dst: []u8, n0: u32, d: []const u8) -> u32 {
    const r : i64 = root(d);
    const exs : i64 = obj_get(d, r, "examples");
    const ex0 : i64 = arr_at(d, exs, 0);
    var n : u32 = raw(dst, n0, "<section class=\"fo-notes\"><h2>");
    n = text(dst, n, SAY_NOTES_TITLE);
    n = raw(dst, n, "</h2><p>");
    var vb : [8192]u8 = [0; 8192];
    var vn : u32 = pool_u(vb[0..], 0, "0", K_SLICE_LUTX as u64);
    vn = pool_u(vb[0..], vn, "1", K_CARRY4 as u64);
    vn = pool_plain(vb[0..], vn, "2", (K_POSITIONS_PER_SLICE as u64) * (K_BELS_PER_POSITION as u64));
    vn = pool_u(vb[0..], vn, "3", K_EX_NODE0[0] as u64);
    vn = pool_u(vb[0..], vn, "4", K_EX_NODE0_LUT6_POSITIONS as u64);
    vn = pool_u(vb[0..], vn, "5", K_LUT_POSITIONS as u64);
    n = fmt_to(dst, n, SAY_NOTE_LUT, vb[0..], vn);
    n = raw(dst, n, "</p><p>");
    vn = pool_u(vb[0..], 0, "0", K_EX_NODE0_YOSYS_LUT as u64);
    vn = pool_u(vb[0..], vn, "1", K_EX_NODE0[0] as u64);
    n = fmt_to(dst, n, SAY_NOTE_BOUND, vb[0..], vn);
    n = raw(dst, n, "</p><p>");
    vn = pool_val(vb[0..], 0, "0", d, obj_get(d, ex0, "board"));
    vn = pool_val(vb[0..], vn, "1", d, obj_get(d, ex0, "part"));
    vn = pool_u(vb[0..], vn, "2", K_PAD_FBG484 as u64);
    n = fmt_to(dst, n, SAY_NOTE_PACKAGE, vb[0..], vn);
    return raw(dst, n, "</p></section>");
}

/// The sources list: tool.js's renderNotes(d), second half.
fn sources_html(dst: []u8, n0: u32, d: []const u8) -> u32 {
    const r : i64 = root(d);
    const exs : i64 = obj_get(d, r, "examples");
    const ex0 : i64 = arr_at(d, exs, 0);
    var vb : [8192]u8 = [0; 8192];
    var vn : u32 = 0;
    var n : u32 = raw(dst, n0, "<details class=\"fo-sources\"><summary>");
    n = text(dst, n, SAY_SOURCE_TITLE);
    n = raw(dst, n, "</summary><ul>");
    const cnt : u32 = arr_len(d, exs);
    var i : u32 = 0;
    while (i < cnt) {
        const e : i64 = arr_at(d, exs, i);
        const nl : i64 = obj_get(d, e, "nextpnr_log");
        n = raw(dst, n, "<li>");
        vn = pool_val(vb[0..], 0, "0", d, obj_get(d, nl, "path"));
        vn = pool_val(vb[0..], vn, "1", d, obj_get(d, nl, "sha256"));
        vn = pool_num(vb[0..], vn, "2", d, obj_get(d, nl, "bytes"));
        vn = pool_val(vb[0..], vn, "3", d, obj_get(d, e, "top"));
        n = fmt_to(dst, n, SAY_SOURCE_LINE, vb[0..], vn);
        n = raw(dst, n, "</li>");
        i = i + 1;
    }
    n = raw(dst, n, "</ul><p>");
    vn = pool_val(vb[0..], 0, "0", d, obj_get(d, ex0, "nextpnr_version"));
    vn = pool_plain(vb[0..], vn, "1", obj_len(d, obj_get(d, r, "totals")) as u64);
    n = fmt_to(dst, n, SAY_SOURCE_VERSION, vb[0..], vn);
    return raw(dst, n, "</p></details>");
}

/// The result block: headline, binding line, bound line, and (when the grid is drawn) the grid line.
fn result_html(dst: []u8, n0: u32, b: u32) -> u32 {
    var n : u32 = raw(dst, n0, "<div class=\"fo-result\"><p class=\"fo-headline");
    if (HL_NONE) { n = raw(dst, n, " is-none"); }
    n = raw(dst, n, "\">");
    var vb : [1024]u8 = [0; 1024];
    var vn : u32 = 0;
    if (!RENDERED) {
        return raw(dst, n, "</p><p class=\"fo-binding\"></p><p class=\"fo-bound\"></p></div>");
    }
    if (b == 4) {
        n = text(dst, n, SAY_EMPTY);
        return raw(dst, n, "</p><p class=\"fo-binding\"></p><p class=\"fo-bound\"></p></div>");
    }
    const copies : u64 = copies_of(b);
    if (copies == 0) {
        n = text(dst, n, SAY_RESULT_NONE);
        n = raw(dst, n, "</p><p class=\"fo-binding\">");
        vn = pool_unit(vb[0..], 0, "0", b);
        vn = pool_u(vb[0..], vn, "1", per_copy(b));
        vn = pool_u(vb[0..], vn, "2", cap_of(b));
        n = fmt_to(dst, n, SAY_TOO_BIG, vb[0..], vn);
        return raw(dst, n, "</p><p class=\"fo-bound\"></p></div>");
    }
    if (copies == 1) {
        n = text(dst, n, SAY_RESULT_ONE);
    } else {
        vn = pool_u(vb[0..], 0, "0", copies);
        n = fmt_to(dst, n, SAY_RESULT_MANY, vb[0..], vn);
    }
    n = raw(dst, n, "</p><p class=\"fo-binding\">");
    // bindNames: the names of every binding row, joined with " + "
    var names : [256]u8 = [0; 256];
    var nl : u32 = 0;
    var j : u32 = 0;
    while (j < 4) {
        if (is_binding(j, b)) {
            if (nl > 0) { nl = jn_raw(names[0..], nl, " + "); }
            nl = jn_raw(names[0..], nl, SAY_RES_NAMES[j as usize]);
        }
        j = j + 1;
    }
    vn = jv_vput_str(vb[0..], 0, "0", names[0..(nl as usize)]);
    vn = pool_num_unit(vb[0..], vn, "1", per_copy(b), b);
    vn = pool_u(vb[0..], vn, "2", cap_of(b));
    n = fmt_to(dst, n, SAY_BINDING, vb[0..], vn);
    n = raw(dst, n, "</p><p class=\"fo-bound\">");
    vn = pool_unit(vb[0..], 0, "0", b);
    n = fmt_to(dst, n, SAY_UPPER_BOUND, vb[0..], vn);
    return raw(dst, n, "</p></div>");
}

fn canvas_html(dst: []u8, n0: u32) -> u32 {
    var n : u32 = raw(dst, n0, "<canvas class=\"fo-grid\" role=\"img\"");
    if (CV_HIDDEN) { n = raw(dst, n, " hidden=\"\""); }
    if (CV_SET) {
        n = raw(dst, n, " width=\"");
        n = num(dst, n, CV_PX_W);
        n = raw(dst, n, "\" height=\"");
        n = num(dst, n, CV_PX_H);
        n = raw(dst, n, "\" style=\"width: ");
        n = num(dst, n, CV_CSS_W);
        n = raw(dst, n, "px; height: ");
        n = num(dst, n, CV_CSS_H);
        n = raw(dst, n, "px;\" aria-label=\"");
        n = text(dst, n, CV_LBL[0..(CV_LBL_LEN as usize)]);
        n = raw(dst, n, "\"");
    }
    return raw(dst, n, "></canvas>");
}

/// The grid line under the canvas.
fn grid_line_html(dst: []u8, n0: u32, b: u32) -> u32 {
    var n : u32 = raw(dst, n0, "<p class=\"fo-note\">");
    if (!RENDERED or CV_HIDDEN or b == 4) { return raw(dst, n, "</p>"); }
    var vb : [512]u8 = [0; 512];
    var vn : u32 = 0;
    const copies : u64 = copies_of(b);
    const left : u64 = cap_of(b) - copies * per_copy(b);
    var scale : u64 = (copies + (K_GRID_MAX_CELLS as u64) - 1) / (K_GRID_MAX_CELLS as u64);
    if (scale < 1) { scale = 1; }
    if (scale == 1) {
        vn = pool_num_unit(vb[0..], 0, "0", cap_of(b), b);
        vn = pool_num_unit(vb[0..], vn, "1", left, b);
        n = fmt_to(dst, n, SAY_GRID_LINE, vb[0..], vn);
    } else {
        vn = pool_u(vb[0..], 0, "0", scale);
        vn = pool_num_unit(vb[0..], vn, "1", cap_of(b), b);
        vn = pool_num_unit(vb[0..], vn, "2", left, b);
        n = fmt_to(dst, n, SAY_GRID_SCALED, vb[0..], vn);
    }
    return raw(dst, n, "</p>");
}

/// The whole page, as tool.js's render() and load left it.
pub fn w_render(dst: []u8) -> u32 {
    const b : u32 = binding_first();
    var n : u32 = raw(dst, 0, "<div class=\"fo-bar\"><span class=\"fo-label\">");
    n = text(dst, n, SAY_PRESET_LABEL);
    n = raw(dst, n, "</span>");
    var i : u32 = 0;
    while (i < W_NPRESETS) {
        n = btn(dst, n, PRESET == (i as i32), SAY_PRESET_NAMES[i as usize]);
        i = i + 1;
    }
    n = raw(dst, n, "</div><p class=\"fo-note fo-preset-line\">");
    if (RENDERED) { n = preset_line(dst, n, DATA[0..(DATA_LEN as usize)]); }
    n = raw(dst, n, "</p><fieldset class=\"fo-inputs\"><legend>");
    n = text(dst, n, SAY_INPUT_TITLE);
    n = raw(dst, n, "</legend>");
    i = 0;
    while (i < W_NINPUTS) {
        n = input_field(dst, n, i);
        i = i + 1;
    }
    n = raw(dst, n, "</fieldset><div class=\"fo-bar\"><span class=\"fo-label\">");
    n = text(dst, n, SAY_DIVIDE_LABEL);
    n = raw(dst, n, "</span>");
    i = 0;
    while (i < 2) {
        n = btn(dst, n, MODE == i, SAY_DIVIDE_NAMES[i as usize]);
        i = i + 1;
    }
    n = raw(dst, n, "</div><p class=\"fo-status\" role=\"status\"");
    if (LOAD == 1 or LOAD == 3) { n = raw(dst, n, " hidden=\"\""); }
    n = raw(dst, n, ">");
    if (LOAD >= 2) { n = text(dst, n, SAY_ERR_DATA); } else { n = text(dst, n, SAY_LOADING); }
    n = raw(dst, n, "</p>");
    n = result_html(dst, n, b);
    n = canvas_html(dst, n);
    n = grid_line_html(dst, n, b);
    n = table_html(dst, n, b);
    if (LOAD == 1) {
        n = notes_html(dst, n, DATA[0..(DATA_LEN as usize)]);
        n = sources_html(dst, n, DATA[0..(DATA_LEN as usize)]);
    } else {
        if (LOAD == 3 and !ex0_is_null(DATA[0..(DATA_LEN as usize)])) {
            n = notes_html(dst, n, DATA[0..(DATA_LEN as usize)]);
        } else {
            n = raw(dst, n, "<section class=\"fo-notes\"></section>");
        }
        n = raw(dst, n, "<details class=\"fo-sources\"></details>");
    }
    if (!ok(n)) { return 0; }
    return n;
}

// --- Tests of the native page ---------------------------------------------------------------------

pub const W_TEST_DATA : str = "{\"totals\":{\"SLICE_LUTX\":269200,\"SLICE_FFX\":269200,\"DSP48E1\":740,\"RAMB18E1\":730,\"RAMB36E1\":365},\"examples\":[{\"top\":\"trinet\",\"board\":\"ALINX\",\"part\":\"xc7\",\"nextpnr_version\":\"0.9\",\"nextpnr_log\":{\"path\":\"/a\",\"sha256\":\"ab\",\"bytes\":1234},\"used\":{\"SLICE_LUTX\":4738},\"yosys\":{\"LUT\":4732}},{\"top\":\"tnf16\",\"board\":\"B\",\"part\":\"p\",\"nextpnr_log\":{\"path\":\"/b\",\"sha256\":\"cd\",\"bytes\":20},\"used\":{\"SLICE_LUTX\":838},\"yosys\":{\"LUT\":836}}]}";

/// Does the first n bytes of o contain the text want?
fn has(o: []const u8, n: u32, want: []const u8) -> bool {
    if (want.len > (n as usize)) { return false; }
    var i : usize = 0;
    while (i + want.len <= (n as usize)) {
        var k : usize = 0;
        while (k < want.len and o[i + k] == want[k]) { k = k + 1; }
        if (k == want.len) { return true; }
        i = i + 1;
    }
    return false;
}

fn count_of(o: []const u8, n: u32, want: []const u8) -> u32 {
    var c : u32 = 0;
    var i : usize = 0;
    while (i + want.len <= (n as usize)) {
        var k : usize = 0;
        while (k < want.len and o[i + k] == want[k]) { k = k + 1; }
        if (k == want.len) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

test the_page_opens_loading_with_an_empty_table_and_a_visible_canvas {
    w_init("");
    var o : [24576]u8 = [0; 24576];
    const n : u32 = w_render(o[0..]);
    assert n > 0;
    assert has(o[0..], n, "<p class=\"fo-status\" role=\"status\">Reading the device totals...</p>");
    assert has(o[0..], n, "<div class=\"fo-table\" role=\"table\"></div>");
    assert has(o[0..], n, "<canvas class=\"fo-grid\" role=\"img\"></canvas>");
    assert has(o[0..], n, "aria-pressed=\"true\">LUT6 positions</button>");
    assert w_draw(o[0..]) == 0;
}

test node0_loads_fits_28_times_and_luts_bind {
    w_init("");
    w_view(600.0, 1.0, 0);
    w_data(0, W_TEST_DATA);
    assert LOAD == 1;
    assert COUNTS[0] == 4738 and COUNTS[1] == 2378 and COUNTS[3] == 1;
    assert binding_first() == 0;
    assert copies_of(0) == K_EX_NODE0_COPIES as u64;
    var o : [24576]u8 = [0; 24576];
    const n : u32 = w_render(o[0..]);
    assert has(o[0..], n, "<p class=\"fo-headline\">28 copies fit</p>");
    assert has(o[0..], n, "LUTs run out first: 4,738 LUT6 positions per copy, 134,600 on the device.");
    assert has(o[0..], n, "trinet on the ALINX (xc7): nextpnr placed 4,738 SLICE_LUTX; yosys had counted 4,732 LUT1-LUT6 cells.");
    assert has(o[0..], n, "width=\"600\" height=\"264\" style=\"width: 600px; height: 264px;\" aria-label=\"28 copies drawn over 134,600 LUT6 positions\"");
    assert has(o[0..], n, "<p class=\"fo-status\" role=\"status\" hidden=\"\">");
    assert has(o[0..], n, "<span role=\"cell\" class=\"fo-copies\">113</span>");
}

test the_draw_list_is_28_green_cells_then_the_gold_one_with_its_tint {
    w_init("");
    w_view(600.0, 1.0, 0);
    w_data(0, W_TEST_DATA);
    var o : [16384]u8 = [0; 16384];
    const n : u32 = w_draw(o[0..]);
    assert n > 0;
    assert has(o[0..], n, "[\"c\",0],[\"m\",\"setTransform\",1,0,0,1,0,0],[\"m\",\"clearRect\",0,0,600,264],[\"s\",\"fillStyle\",{\"v\":\"--w-green\",\"f\":\"#00ff88\"}],[\"m\",\"fillRect\",0,0,59,59],[\"s\",\"fillStyle\",{\"v\":\"--w-green\",\"f\":\"#00ff88\"}],[\"m\",\"fillRect\",66,0,59,59],");
    assert count_of(o[0..], n, "\"fillRect\"") == 29;
    assert count_of(o[0..], n, "\"strokeRect\"") == 1;
    assert has(o[0..], n, "[\"s\",\"globalAlpha\",0.35]");
    assert has(o[0..], n, "[\"s\",\"strokeStyle\",{\"v\":\"--w-gold\",\"f\":\"#ffd700\"}],[\"s\",\"lineWidth\",2]");
}

test dividing_by_lut_bels_doubles_the_copies {
    w_init("");
    w_view(600.0, 1.0, 0);
    w_data(0, W_TEST_DATA);
    w_click(3);
    assert MODE == 1;
    assert copies_of(binding_first()) == K_EX_NODE0_COPIES_BELS as u64;
    var o : [24576]u8 = [0; 24576];
    const n : u32 = w_render(o[0..]);
    assert has(o[0..], n, "56 copies fit");
    assert has(o[0..], n, "LUT BELs per copy, 269,200 on the device.");
    w_click(1);
    assert PRESET == 1;
    assert copies_of(binding_first()) == K_EX_TNF16_COPIES_BELS as u64;
}

test a_typed_text_is_read_like_number_floor_and_cut_at_the_ceiling {
    w_init("");
    w_input(0, "  12.9 ");
    assert COUNTS[0] == 12;
    w_input(0, "abc");
    assert COUNTS[0] == 0;
    w_input(0, "1e9");
    assert COUNTS[0] == K_INPUT_MAX as u64;
    w_input(0, "0x10");
    assert COUNTS[0] == 16;
    w_input(0, "-5");
    assert COUNTS[0] == 0;
    w_input(0, "Infinity");
    assert COUNTS[0] == 0;
    assert PRESET == 0 - 1;
}

test a_design_too_big_does_not_fit_and_hides_the_canvas {
    w_init("");
    w_view(600.0, 1.0, 0);
    w_input(0, "200000");
    var o : [24576]u8 = [0; 24576];
    const n : u32 = w_render(o[0..]);
    assert has(o[0..], n, "<p class=\"fo-headline is-none\">Does not fit</p>");
    assert has(o[0..], n, "One copy needs 200,000 LUT6 positions; the device has 134,600.");
    assert has(o[0..], n, "<canvas class=\"fo-grid\" role=\"img\" hidden=\"\"></canvas>");
    assert w_draw(o[0..]) == 0;
    w_input(0, "");
    const m : u32 = w_render(o[0..]);
    assert has(o[0..], m, "<p class=\"fo-headline is-none\">Type a LUT count, or pick a real design.</p>");
}

test a_small_design_draws_one_cell_per_several_copies_and_a_hollow_cell {
    w_init("");
    w_view(600.0, 1.0, 0);
    w_input(0, "10");
    assert G_SCALE == 23;
    assert G_FULL == 585 and G_REST == 5;
    var o : [49152]u8 = [0; 49152];
    const n : u32 = w_render(o[0..]);
    assert has(o[0..], n, "13,460 copies fit");
    assert has(o[0..], n, "One cell per 23 copies over the device&#39;s 134,600 LUT6 positions; the last, hollow cell is what is left: 0 LUT6 positions.");
    const d : u32 = w_draw(o[0..]);
    assert has(o[0..], d, "[\"s\",\"strokeStyle\",{\"v\":\"--w-line\",\"f\":\"#1a4\"}]");
    assert count_of(o[0..], d, "\"fillRect\"") == 586;
}

test the_window_sets_the_canvas_size_and_a_resize_recomputes_it {
    w_init("");
    w_view(1000.0, 2.0, 0);
    w_input(0, "4738");
    assert CV_CSS_W == 1000 and CV_PX_W == 2000;
    w_view(320.0, 1.5, 1);
    assert CV_CSS_W == 1000;
    w_resize();
    assert CV_CSS_W == 320 and CV_PX_W == 480;
    w_view(0.0, 0.0, 0);
    w_resize();
    assert CV_CSS_W == 600 and CV_PX_W == 600;
}

test data_that_does_not_agree_with_the_totals_says_so_and_stays_visible {
    w_init("");
    w_data(0, "{\"totals\":{\"SLICE_LUTX\":\"269200\"},\"examples\":[{}]}");
    assert LOAD == 2;
    var o : [24576]u8 = [0; 24576];
    var n : u32 = w_render(o[0..]);
    assert has(o[0..], n, "<p class=\"fo-status\" role=\"status\">The device totals did not load.</p>");
    w_init("");
    w_data(0, "{\"totals\":{\"SLICE_LUTX\":269200,\"SLICE_FFX\":269200,\"DSP48E1\":740,\"RAMB18E1\":730,\"RAMB36E1\":365},\"examples\":[]}");
    assert LOAD == 2;
    w_init("");
    w_data(0, "{\"totals\":");
    assert LOAD == 2;
    w_init("");
    w_data_failed(0);
    n = w_render(o[0..]);
    assert has(o[0..], n, "The device totals did not load.");
    assert w_draw(o[0..]) == 0;
}

test the_numbers_in_the_words_are_grouped_like_en_us_and_the_notes_read_the_data {
    w_init("");
    w_data(0, W_TEST_DATA);
    var o : [24576]u8 = [0; 24576];
    const n : u32 = w_render(o[0..]);
    assert has(o[0..], n, "its SLICE_LUTX total 269,200 is 33,650 slices x 8, a LUT6 and a LUT5 BEL");
    assert has(o[0..], n, "Both logs are from the ALINX (xc7), not the QMTech Wukong (fgg676). Their PAD total, 1,062,");
    assert has(o[0..], n, "<li>/a: sha256 ab, 1,234 bytes, top trinet</li>");
    assert has(o[0..], n, "names nextpnr-xilinx 0.9. Both logs print the same total for all 5 BEL types.");
    assert obj_len(W_TEST_DATA, obj_get(W_TEST_DATA, root(W_TEST_DATA), "totals")) == 5;
}
/// The splicer follows only the names a module itself mentions, not the names the imported functions
/// mention. This anchor mentions every helper the writer, the JSON reader, the number rules and the
/// canvas writers call. Never called.
pub fn imports_anchor(o: []u8, s: []const u8) -> u32 {
    var n : u32 = 0;
    n = n + (ok(0) as u32);
    n = n + OVER;
    n = n + put(o, 0, 0);
    n = n + raw(o, 0, s);
    n = n + put_escaped(o, 0, 0);
    n = n + text(o, 0, s);
    n = n + num(o, 0, 0);
    n = n + attr(o, 0, s, s);
    n = n + fill(o, 0, s, s, s, s, 0);
    n = n + fill_named(o, 0, s, s, s, s, s, s, s, s, s, s, s, s, s);
    n = n + dec_to(o, 0);
    n = n + (name_is(s, 0, 0, s) as u32);
