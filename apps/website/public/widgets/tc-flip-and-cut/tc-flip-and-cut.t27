// SPDX-License-Identifier: Apache-2.0
; specs/widgets/tc-flip-and-cut.t27 -- lesson 3 of the course "The ternary machine" (specs/course/ternary-computing.t27)
; Source of truth for public/widgets/tc-flip-and-cut/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles this
; file, checks its constants, evaluates the tests below and writes the page; the page hands every constant to
; tool.js as window.T27_WIDGET. tool.js draws through ../ternary-kit.js and computes nothing: every number comes
; from public/widgets/tc-flip-and-cut/logic.js, the fn bodies of the gHashTag/t27 spec in logic.t27, compiled to wasm.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_tc_flip_and_cut;

pub const KIND : str = "widget-tool";
pub const ID : str = "tc-flip-and-cut";
pub const TITLE : str = "Flip every trit to negate, cut trits to round";
pub const DESCRIPTION : str = "Negation in balanced ternary flips every trit: no borrow, no complement. Cutting the lowest trits rounds to the nearest multiple.";
pub const IMAGE_ALT : str = "Flip and cut card: 8 is 0 0 0 + 0 -, flipped it is 0 0 0 - 0 +, which is -8. Cutting one trit off 8 gives 9, the nearest multiple of 3: rounding without a rule for halves.";
pub const HOOK : str = "In balanced ternary -x is x with every trit flipped, and truncation is rounding. Binary needs a rule for both.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ternary/trits.t27 (t27#8979): every value on the page is its fn bodies, compiled to wasm (logic.js), with 18 tests and 4108 runtime asserts", "D. Knuth, The Art of Computer Programming, vol. 2, section 4.1: balanced ternary"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

pub const SAY_LOADING : str = "Loading";
pub const K_TRITS : u32 = 6;
pub const K_START : i32 = 8;
pub const K_START_CUT : u32 = 1;
pub const SAY_NUMBER : str = "A number from {0} to {1}";
pub const SAY_FLIP : str = "Flip every trit";
pub const SAY_CUT : str = "Trits to cut";
pub const SAY_TILES : str = "{0} in balanced ternary";
pub const SAY_TRITS : str = "{0} trits needed";
pub const SAY_BITS : str = "{0} bits in two's complement";
pub const SAY_RANGE : str = "{0} trits reach +/-{1}";
pub const SAY_NEG_TITLE : str = "Every trit flipped: {0}";
pub const SAY_CUT_TITLE : str = "The lowest {0} trits cut: {1}";
pub const SAY_CUT_NOTE : str = "The cut value is the nearest multiple of 3^k. A tie cannot happen: the dropped part is always less than half.";
pub const SAY_SOURCE : str = "Logic: t27 spec ternary/trits.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_widget_starts_where_its_card_says {
    assert K_START_CUT <= K_TRITS;
}
