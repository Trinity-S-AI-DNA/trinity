// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-backprop.t27 -- backpropagation through one dense layer
; Source of truth for public/widgets/nn-backprop/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-backprop/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/layers/dense_layer.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 19 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader sets the output gradients g0 and g1 from -2 to 2. Edges are
; backward_at(g0, g1, 1, o * 3 + i), input nodes backward_at(g0, g1, 0, i), bias tiles
; backward_at(g0, g1, 2, o), and the loss loss_at = g . y at x and at x with x0 moved by 1.

; WHAT IT DOES NOT CLAIM: the layer is the spec's fixture (W = [[1, 2, 3], [-1, 0, 1]], b = (0.5,
; -0.5)), linear; the inputs are repeated as K_X.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_backprop;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-backprop";
pub const TITLE : str = "Backpropagation: how blame flows back through a layer";
pub const DESCRIPTION : str = "Set how much the loss wants each of two outputs to move: every weight gets that times its input, every input gets W transposed times it. The edges and nodes show the numbers.";
pub const IMAGE_ALT : str = "Backprop card: a dense layer of 3 inputs and 2 outputs with g = (1, 0.5). Six edges are coloured by their weight gradients 1, 2, 3 and 0.5, 1, 1.5; the input nodes hold 0.5, 2.0 and 3.5. Tiles read input gradients 0.50 2.00 3.50, bias gradients 1.00 0.50, loss 15.250 and with x0 moved by 1 15.750.";
pub const HOOK : str = "With g = (1, 0.5) on inputs (1, 2, 3), the weights get 1, 2, 3 and 0.5, 1, 1.5, and the inputs get 0.5, 2, 3.5. Two products are the whole rule.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/layers/dense_layer.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 19 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_X : [3]u8 = [1, 2, 3];
pub const K_X_NUDGED : [3]u8 = [2, 2, 3];
pub const K_G_LO_C : i16 = -200;
pub const K_G_HI_C : u16 = 200;
pub const K_PRESET_G0_C : [4]i16 = [100, 100, 0, -200];
pub const K_PRESET_G1_C : [4]i16 = [50, 0, 100, 100];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["g = (1, 0.5)", "Only output 0", "Only output 1", "g = (-2, 1)"];
pub const SAY_ASK : str = "How does blame for an error flow back through a layer?";
pub const SAY_G : str = "g";
pub const SAY_NET_LABEL : str = "Three inputs, two outputs; edges coloured by their weight gradient, inputs by theirs";
pub const SAY_NET_CAP : str = "Edge label: g_o x_i. Input node: sum over o of W[o][i] g_o. Pink is negative, green positive.";
pub const SAY_GRAD_IN : str = "input gradients";
pub const SAY_GRAD_B : str = "bias gradients";
pub const SAY_LOSS : str = "loss g . y";
pub const SAY_LOSS_NUDGED : str = "with x0 + 1";
pub const SAY_NOTE : str = "The layer is linear, so moving x0 by 1 moves the loss by exactly its input gradient: compare the last two tiles. Chain this rule layer by layer and you have backpropagation.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/layers/dense_layer.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_inputs_are_the_spec_fixture {
    assert K_X[0] == 1;
    assert K_X[2] == 3;
    assert K_X_NUDGED[0] == K_X[0] + 1;
    assert K_X_NUDGED[2] == K_X[2];
}

test the_presets_stay_in_range {
    assert K_PRESET_G0_C[3] == K_G_LO_C;
    assert K_PRESET_G1_C[2] <= K_G_HI_C;
    assert K_G_LO_C + K_G_HI_C == 0;
}
