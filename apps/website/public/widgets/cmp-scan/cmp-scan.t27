// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-scan.t27 -- Where a word stops: three scanners over one line
; Source of truth for public/widgets/cmp-scan/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-scan/logic.js -- the fn
; bodies of gHashTag/t27 specs/isa/t27a.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 2 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader types a line of t27a assembler (or takes a sample), taps a start byte, and sees where
; skip_spaces, name_end and digits_end each stop from it. The bytes a scanner walked over are lit in its row.

; WHAT IT DOES NOT CLAIM:  it does not chain the scanners into a parse: t27a.t27 does that inside parse(), and lesson 6 runs
; the whole parser. Here each scanner answers alone.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_scan;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-scan";
pub const TITLE : str = "Where a word stops: three scanners over one line";
pub const DESCRIPTION : str = "The t27a assembler reads a line with three tiny scanners: skip_spaces, name_end and digits_end. Pick a start byte and see where each one stops, and which bytes it walked over.";
pub const IMAGE_ALT : str = "Scanner card: the line ADD t12, 345 as one cell per byte with the start at byte 9, the digit 3. Three rows under it show the walk of each scanner: skip_spaces stops at once, name_end and digits_end both walk the three digits 345 and stop at byte 12.";
pub const HOOK : str = "Reading is three loops: skip the spaces, walk the name, walk the digits. Each is a function of a text and a start, and it stops at the first byte that fails.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/isa/t27a.t27 (t27 master 90e797659): every stop is skip_spaces, name_end or digits_end, its fn bodies compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 2 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 0;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_START_AT : u8 = 9;
pub const K_MAX_TEXT : u8 = 40;
pub const K_START_SAMPLE : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine steps of this course; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_SAMPLES : [4]str = ["ADD t12, 345", "  LDI t4, t0, -12", "MOV t26,t1", ".word 4294967295"];
pub const SAY_ASK : str = "Where does one word of a line stop and the next begin?";
pub const SAY_TEXT_LABEL : str = "A line of t27a assembler";
pub const SAY_SCANNERS : [3]str = ["skip_spaces", "name_end", "digits_end"];
pub const SAY_STOPS_AT : str = "stops at byte {0}";
pub const SAY_WALKED : str = "walked {0}";
pub const SAY_NOTHING : str = "An empty line has no bytes to scan.";
pub const SAY_AT : str = "Start byte {0}";
pub const SAY_TAP : str = "Tap a byte to start the scanners there.";
pub const SAY_NOTE : str = "A name is letters, digits and the underscore, so t12 is one name and its digits belong to it. Spaces and tabs are the only blanks. A scanner that cannot move stops at the byte it started on.";
pub const SAY_SOURCE : str = "Logic: t27 spec isa/t27a.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_is_one_of_nine_course_steps {
    assert K_STAGE < 9;
    assert K_STAGE == 0;
}

test the_start_sits_inside_the_first_sample {
    assert K_START_AT == 9;
    assert K_START_AT < 12;
}

test a_line_has_room_for_the_longest_sample {
    assert K_MAX_TEXT >= 17;
    assert K_START_SAMPLE == 0;
}
