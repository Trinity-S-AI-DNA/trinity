// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-reviewers.t27 -- How many reviewer bees: keeping up with the finish rate
; Source of truth for public/widgets/hive-reviewers/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-reviewers/logic.js -- the fn
; bodies of gHashTag/t27 specs/queen/reviewer.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 10 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader sets keys, lanes per key, free memory, memory per review, rows waiting
; and rows finished an hour. The upper meter is reviewer_concurrency of the top five, the lower
; slots_needed(finished an hour), and the gate keeps_up of the two.

; WHAT IT DOES NOT CLAIM:  the start numbers are the ones the spec records for 2026-10-09; the page
; measures nothing.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_reviewers;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-reviewers";
pub const TITLE : str = "How many reviewer bees: keeping up with the finish rate";
pub const DESCRIPTION : str = "Set the keys, lanes, memory and the rows waiting: reviewer_concurrency says how many reviews run at once, and keeps_up says whether that outruns the bees finishing work.";
pub const IMAGE_ALT : str = "Reviewer card at the load of 2026-10-09: 111 rows waiting, 58 finished an hour, 4 keys of 1 lane. Meters read 4 reviews at once against 5 needed; the gate is shut, the reviewer falls behind. The fixed bound of 4 is marked on the meter.";
pub const HOOK : str = "At 300 s a review, one slot clears 12 rows an hour. The fixed 4 tops out at 48 while bees finish 58, so the backlog only grew. 16 lanes keep up.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/queen/reviewer.t27 (t27 master c42f8fb40): every value on the page is reviewer_concurrency, slots_needed and keeps_up, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 10 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_KEYS_MAX : u8 = 20;
pub const K_LANES_MAX : u8 = 4;
pub const K_MB_MAX : u16 = 8000;
pub const K_MB_STEP : u16 = 250;
pub const K_PER_MAX : u16 = 1000;
pub const K_PER_STEP : u8 = 50;
pub const K_WAITING_MAX : u8 = 150;
pub const K_RATE_MAX : u8 = 120;
pub const K_REVIEWER_CONCURRENCY : u32 = 4;
pub const K_REVIEWER_CEILING : u32 = 16;
pub const K_REVIEW_ROW_SECONDS : u32 = 300;
pub const K_PRESET_KEYS : [4]u8 = [4, 10, 4, 4];
pub const K_PRESET_LANES : [4]u8 = [1, 2, 1, 1];
pub const K_PRESET_MB : [4]u16 = [8000, 8000, 1000, 8000];
pub const K_PRESET_PER : [4]u16 = [500, 500, 500, 500];
pub const K_PRESET_WAITING : [4]u8 = [111, 111, 111, 0];
pub const K_PRESET_RATE : [4]u8 = [58, 58, 58, 58];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["As measured, 4 keys", "10 keys of 2 lanes", "Short of memory", "Nothing waits"];
pub const SAY_ASK : str = "How many reviews must run at once so finished work does not pile up?";
pub const SAY_KEYS : str = "model keys";
pub const SAY_LANES : str = "lanes per key";
pub const SAY_MB : str = "free memory, MB";
pub const SAY_PER : str = "MB per review";
pub const SAY_WAITING : str = "rows waiting";
pub const SAY_RATE : str = "rows finished an hour";
pub const SAY_AT_ONCE : str = "reviews at once";
pub const SAY_NEEDED : str = "needed to keep up";
pub const SAY_FIXED : str = "the fixed bound of {0}";
pub const SAY_KEEPS : str = "The reviewer keeps up";
pub const SAY_BEHIND : str = "The reviewer falls behind";
pub const SAY_GAP : str = "{0} at once, {1} needed";
pub const SAY_NOTE : str = "0 only when nothing waits, at least 1 while anything waits, never above 16. Each review takes a lane no bee holds and runs on its own clock, so the round no longer reviews at all.";
pub const SAY_SOURCE : str = "Logic: t27 spec queen/reviewer.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_bounds_are_the_specs {
    assert K_REVIEWER_CONCURRENCY == 4;
    assert K_REVIEWER_CEILING == 16;
    assert K_REVIEW_ROW_SECONDS == 300;
}

test the_start_is_the_measured_load {
    assert K_PRESET_WAITING[0] == 111;
    assert K_PRESET_RATE[0] == 58;
    assert K_PRESET_KEYS[0] == K_REVIEWER_CONCURRENCY;
}
