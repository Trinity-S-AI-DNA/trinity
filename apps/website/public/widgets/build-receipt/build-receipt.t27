; --- Tests: the generator evaluates these before it writes the page ----------------------
test the_items_add_up_to_the_total {
    assert K_STAGE_MS[0] + K_STAGE_MS[1] + K_STAGE_MS[2] + K_STAGE_MS[3] + K_STAGE_MS[4] + K_STAGE_MS[5] <= K_TOTAL_MS + K_ROUND_TOL_MS;
    assert K_STAGE_MS[0] + K_STAGE_MS[1] + K_STAGE_MS[2] + K_STAGE_MS[3] + K_STAGE_MS[4] + K_STAGE_MS[5] + K_ROUND_TOL_MS >= K_TOTAL_MS;
    assert K_ROUND_TOL_MS == (K_STAGE_PLAN + 1) / 2;
}

test the_stage_count_matches_the_data {
    assert K_STAGE_COUNT == K_STAGE_PLAN;
    assert K_STAGES_OK <= K_STAGE_COUNT;
    assert SAY_STAGE_NAMES[5] == "sha256 of the .bit";
}

test no_vendor_tool_was_run {
    assert K_VENDOR_TOOLS_RUN == 0;
    assert K_BIT_BYTES > 0;
}

test the_page_sends_nothing {
    assert READS_LOCAL_FILES == false;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
    assert K_DATA_FILE == "./receipt.json";
}


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, issue #10938, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/build-receipt/tool.js (221 lines of hand-written JavaScript).
; The words and numbers above are unchanged. The host protocol is race_the_bee.t27's:
;   w_init(hash)          the page opens: "printing the receipt"
;   w_data(i, bytes)      file i of K_DATA_FILE has been fetched; w_data_failed(i) when it could not be
;   w_click(i)            the "show commands" button (the only one) was pressed
;   w_render(dst)         the page's HTML, length (0 on overflow)
; The receipt is drawn from the bytes of receipt.json (json_scan.t27) and the values are written the way
; tool.js's String() / toFixed(3) / Math.round / template literals write them (js_val.t27, js_num.t27).
; Where tool.js throws while it draws (receipt.stages no array, a null stage, a machine that is a string
; or a number, a payload digest that is no string, a utilisation row that is no array, earlier runs with a
; null entry, commands that are no array) its catch shows SAY_ERROR; so does this page (data_ok).
; The spec-versus-data check (specDiff) reads the K_ constants of this very file.
; NOT carried over: String.prototype.toLowerCase / toUpperCase beyond ASCII and Latin-1 (the tool-name
; test and the receipt number); Object.entries order for integer-like keys of `utilisation`, and duplicate keys; a
; non-empty string as `utilisation` or `earlier_runs`, and a string as a row of `utilisation`;
; the data file is cut at W_DATA_CAP bytes (the page then says it could not be read); a digest longer than
; 293 hex digits is cut in the barcode and one longer than 511 bytes everywhere.
; MEASURED 2026-10-19: t27c 0.5.2 gen + a 5-line Zig export wrapper + zig build-exe wasm32-freestanding
; ReleaseSmall give a 32541-byte wasm. The original page (tool.js) and this one ran in two happy-dom
; windows against the real 6673-byte receipt.json and 188 variants of it, 951 comparisons of tag,
; attributes (the barcode svg included) and text, the button pressed up to 12 times in a row (569 presses)
; and the page before the data arrives and after: no fmax / a failing one / an odd one, utilisation empty /
; absent / an array / short rows / odd keys, stages not run / failed (with and without exit and error) /
; with odd status words, outputs missing / partial / byte sizes at every unit boundary (0, 999, 1000,
; 999999, 1e9, 1.5e12, negative, a string, 7e21), cpu and rss forms, ms of every form (a string makes the
; sum a string, as in JavaScript), an extra / fewer / duplicate / one stage, every kind of spec-versus-data
; disagreement (the warning line), a missing / null bit, digests of every shape (upper case, short, empty,
; non-hex, 200 digits, a number, Latin-1 letters), cross-check ok / bad / skipped / missing, earlier runs
; none / many / odd stamps, an incomplete receipt, vendor tools of every form, machine and design missing /
; partial / numbers, commands empty / markup / nested, version and tool names with and without a match,
; markup and unicode in every string, 15 data files the page cannot draw (a root that is an array or null,
; stages missing / an object / with a null, a number and a string in it, a machine that is a string or a
; number, a payload that is a number or an array, a utilisation row that is a number or null, an earlier
; run that is null, commands that are a string or an object): all end on the error line in both; 70 files
; with random numbers and strings in every field, 8 long sessions, a 404 and a body that is not JSON:
; 0 differences. A negative control (one node of the native DOM changed) is caught.
; Not compared: the stylesheet (happy-dom); the cases under "NOT carried over".

pub const W_DATA_CAP : u32 = 32768;
pub var DATA : [32768]u8 = [0; 32768];
pub var DATA_LEN : u32 = 0;
pub var DATA_STATE : u8 = 0;
pub var CMDS_ON : bool = false;

pub fn w_init(h: []const u8) -> u32 {
    DATA_STATE = 0;
    DATA_LEN = 0;
    CMDS_ON = false;
    return 0;
}

fn nullish(d: []const u8, sp: i64) -> bool {
    const k : u8 = kind(d, sp);
    return k == J_NONE or k == J_NULL;
}

/// receipt.stages is an array, every stage is non-null, and the rest of render() would not throw.
fn data_ok(d: []const u8, r: i64) -> bool {
    if (kind(d, r) != J_OBJECT) { return false; }
    const st : i64 = obj_get(d, r, "stages");
    if (kind(d, st) != J_ARRAY) { return false; }
    const cnt : u32 = arr_len(d, st);
    var i : u32 = 0;
    while (i < cnt) {
        if (nullish(d, arr_at(d, st, i))) { return false; }
        i = i + 1;
    }
    const m : i64 = obj_get(d, r, "machine");
    if (jv_truthy(d, m) and kind(d, m) != J_OBJECT and kind(d, m) != J_ARRAY) { return false; }
    const bit : i64 = obj_get(d, r, "bit");
    var pay : i64 = obj_get(d, bit, "payload_sha256");
    if (nullish(d, pay)) { pay = obj_get(d, bit, "sha256"); }
    if (!nullish(d, pay) and kind(d, pay) != J_STRING) { return false; }
    const ut : i64 = obj_get(d, r, "utilisation");
    if (jv_truthy(d, ut)) {
        const k : u8 = kind(d, ut);
        if (k == J_STRING) { return false; }
        if (k == J_OBJECT or k == J_ARRAY) {
            if (!entries_ok(d, ut)) { return false; }
        }
    }
    if (jv_truthy(d, bit)) {
        const er : i64 = obj_get(d, r, "earlier_runs");
        if (jv_truthy(d, er) and kind(d, er) == J_STRING) { return false; }
        if (kind(d, er) == J_OBJECT and jv_truthy(d, obj_get(d, er, "length"))) { return false; }
        if (kind(d, er) == J_ARRAY) {
            const ec : u32 = arr_len(d, er);
            var j : u32 = 0;
            while (j < ec) {
                if (nullish(d, arr_at(d, er, j))) { return false; }
                j = j + 1;
            }
        }
    }
    const cm : i64 = obj_get(d, r, "commands");
    if (jv_truthy(d, cm) and kind(d, cm) != J_ARRAY) { return false; }
    return true;
}

/// Every entry of the object / array `ut` is an array (the `[used, total]` destructuring does not throw).
fn entries_ok(d: []const u8, ut: i64) -> bool {
    if (kind(d, ut) == J_ARRAY) {
        const c : u32 = arr_len(d, ut);
        var i : u32 = 0;
        while (i < c) {
            const v : i64 = arr_at(d, ut, i);
            if (kind(d, v) != J_ARRAY) { return false; }
            i = i + 1;
        }
        return true;
    }
    // an object: walk its members in file order
    const hi : usize = span_hi(ut);
    var p : usize = skip_ws(d, span_lo(ut) + 1);
    while (p < hi and d[p] == 34) {
        const ke : usize = string_end(d, p);
        const q : usize = skip_ws(d, ke);
        const v : usize = skip_ws(d, q + 1);
        const ve : usize = value_end(d, v);
        if (kind(d, jspan(v, ve)) != J_ARRAY) { return false; }
        p = skip_ws(d, ve);
        if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
    }
    return true;
}

pub fn w_data(i: u32, s: []const u8) -> u32 {
    if (s.len > (W_DATA_CAP as usize)) {
        DATA_STATE = 2;
        return 0;
    }
    var k : usize = 0;
    while (k < s.len) {
        DATA[k] = s[k];
        k = k + 1;
    }
    DATA_LEN = s.len as u32;
    DATA_STATE = 1;
    const d : []const u8 = DATA[0..(DATA_LEN as usize)];
    if (!jv_valid(d)) {
        DATA_STATE = 2;
        return 0;
    }
    if (!data_ok(d, root(d))) { DATA_STATE = 2; }
    return 0;
}

pub fn w_data_failed(i: u32) -> u32 {
    DATA_STATE = 2;
    return 0;
}

pub fn w_click(i: u32) -> u32 {
    if (i == 0 and DATA_STATE == 1) { CMDS_ON = !CMDS_ON; }
    return 0;
}

// --- small writers ------------------------------------------------------------------------------

/// <div class="PREFIX[ CLS]">
fn div_open(dst: []u8, n0: u32, prefix: []const u8, cls: []const u8) -> u32 {
    var n : u32 = raw(dst, n0, "<div class=\"");
    n = raw(dst, n, prefix);
    if (cls.len > 0) {
        n = put(dst, n, 32);
        n = raw(dst, n, cls);
    }
    return raw(dst, n, "\">");
}

fn rule_html(dst: []u8, n0: u32) -> u32 {
    return raw(dst, n0, "<div class=\"br-rule\" aria-hidden=\"true\"></div>");
}

/// line(left, right, cls) up to the left text.
fn line_open(dst: []u8, n0: u32, cls: []const u8) -> u32 {
    var n : u32 = div_open(dst, n0, "br-line", cls);
    return raw(dst, n, "<span class=\"br-l\">");
}

fn line_mid(dst: []u8, n0: u32) -> u32 {
    return raw(dst, n0, "</span><span class=\"br-dots\" aria-hidden=\"true\"></span><span class=\"br-r\">");
}

fn line_close(dst: []u8, n0: u32) -> u32 {
    return raw(dst, n0, "</span></div>");
}

fn put_all(dst: []u8, n0: u32, s: []const u8, l: u32) -> u32 {
    var n : u32 = n0;
    var i : u32 = 0;
    while (i < l) {
        n = put_escaped(dst, n, s[i as usize]);
        i = i + 1;
    }
    return n;
}

/// The text of a textContent / child assignment: null and undefined add nothing.
fn tc_text(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    if (nullish(d, sp)) { return n0; }
    return jv_text(dst, n0, d, sp);
}

/// (ms / 1000).toFixed(3) in SAY_SECONDS.
fn secs_text(dst: []u8, n0: u32, ms: f64) -> u32 {
    var vb : [128]u8 = [0; 128];
    const vn : u32 = jv_vput_fixed(vb[0..], 0, "s", ms / 1000.0, 3);
    return jv_fill(dst, n0, SAY_SECONDS, vb[0..], vn, false);
}

/// `x ?? 0` then Number(): the coerced number of a field with a default of 0.
fn num_or0(d: []const u8, sp: i64) -> f64 {
    if (nullish(d, sp)) { return 0.0; }
    return jv_num(d, sp);
}

/// Trim JavaScript white space off buf[0..l); the new start in lo and end in hi (written back through the arrays).
fn trim_range(buf: []const u8, l: u32, out: []u32) -> u32 {
    var lo : u32 = 0;
    var hi : u32 = l;
    var w : u32 = 1;
    while (lo < hi and w > 0) {
        w = jv_ws_at(buf, lo, hi);
        lo = lo + w;
    }
    w = 1;
    while (hi > lo and w > 0) {
        w = jv_ws_before(buf, lo, hi);
        hi = hi - w;
    }
    out[0] = lo;
    out[1] = hi;
    return 0;
}

/// size(bytes) as raw bytes into out, trimmed: `12.34 MB (12345678 B)` / `4492 B`; the length.
fn size_raw(out: []u8, d: []const u8, sp: i64) -> u32 {
    var tmp : [512]u8 = [0; 512];
    var t : u32 = 0;
    var v : f64 = jv_num(d, sp);
    var i : u32 = 0;
    const last : u32 = (SAY_UNITS.len as u32) - 1;
    while (v >= 1000.0 and i < last) {
        v = v / 1000.0;
        i = i + 1;
    }
    if (i == 0) {
        t = jv_str(tmp[0..], t, d, sp);
    } else {
        t = js_to_fixed(tmp[0..], t, v, 2);
    }
    t = put(tmp[0..], t, 32);
    t = jn_raw(tmp[0..], t, SAY_UNITS[i as usize]);
    if (i != 0) {
        t = jn_raw(tmp[0..], t, " (");
        t = jv_str(tmp[0..], t, d, sp);
        t = put(tmp[0..], t, 32);
        t = jn_raw(tmp[0..], t, SAY_UNITS[0]);
        t = put(tmp[0..], t, 41);
    }
    var rg : [2]u32 = [0; 2];
    trim_range(tmp[0..], t, rg[0..]);
    var n : u32 = 0;
    var q : u32 = rg[0];
    while (q < rg[1]) {
        n = jn_put(out, n, tmp[q as usize]);
        q = q + 1;
    }
    return n;
}

fn size_text(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    var tmp : [600]u8 = [0; 600];
    const l : u32 = size_raw(tmp[0..], d, sp);
    return put_all(dst, n0, tmp[0..], l);
}

/// toLowerCase for ASCII and Latin-1 (UTF-8 C3 80..9E except 97), in place; the length does not change.
fn lower_in_place(buf: []u8, l: u32) -> u32 {
    var i : u32 = 0;
    while (i < l) {
        const c : u8 = buf[i as usize];
        if (c >= 65 and c <= 90) { buf[i as usize] = c + 32; }
        if (c == 195 and i + 1 < l) {
            const c2 : u8 = buf[(i + 1) as usize];
            if (c2 >= 128 and c2 <= 158 and c2 != 151) { buf[(i + 1) as usize] = c2 + 32; }
            i = i + 1;
        }
        i = i + 1;
    }
    return l;
}

/// toolLine(s): the version alone when it already names the tool, else `tool | version`.
fn tool_line(dst: []u8, n0: u32, d: []const u8, s: i64) -> u32 {
    var ver : [512]u8 = [0; 512];
    var vl : u32 = 0;
    const vv : i64 = obj_get(d, s, "version");
    if (!nullish(d, vv)) { vl = jv_str(ver[0..], 0, d, vv); }
    var tool : [512]u8 = [0; 512];
    const tl : u32 = jv_str(tool[0..], 0, d, obj_get(d, s, "tool"));
    var fl : u32 = 0;
    while (fl < tl and tool[fl as usize] != 32) { fl = fl + 1; }
    var lver : [512]u8 = [0; 512];
    var ltool : [512]u8 = [0; 512];
    var c : u32 = 0;
    while (c < vl) {
        lver[c as usize] = ver[c as usize];
        c = c + 1;
    }
    c = 0;
    while (c < fl) {
        ltool[c as usize] = tool[c as usize];
        c = c + 1;
    }
    lower_in_place(lver[0..], vl);
    lower_in_place(ltool[0..], fl);
    // does lower(ver) include lower(first)?
    var found : bool = fl == 0;
    var a : u32 = 0;
    while (!found and a + fl <= vl) {
        var m : bool = true;
        var b : u32 = 0;
        while (m and b < fl) {
            if (lver[(a + b) as usize] != ltool[b as usize]) { m = false; }
            b = b + 1;
        }
        if (m) { found = true; }
        a = a + 1;
    }
    if (found) { return put_all(dst, n0, ver[0..], vl); }
    var n : u32 = put_all(dst, n0, tool[0..], tl);
    n = jn_raw(dst, n, " | ");
    return put_all(dst, n, ver[0..], vl);
}

fn hexval(b: u8) -> u32 {
    if (b >= 48 and b <= 57) { return (b - 48) as u32; }
    if (b >= 97 and b <= 102) { return (b - 97) as u32 + 10; }
    if (b >= 65 and b <= 70) { return (b - 65) as u32 + 10; }
    return 99;
}

/// barcode(hex): one bar and one gap per hex digit, widths 1 to 4, with a guard at each end.
fn barcode_html(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    var tmp : [512]u8 = [0; 512];
    var l : u32 = 0;
    if (jv_truthy(d, sp)) { l = jv_str(tmp[0..], 0, d, sp); }
    var parts : [600]u32 = [0; 600];
    var pc : u32 = 0;
    parts[0] = 1; parts[1] = 1; parts[2] = 1; parts[3] = 1;
    pc = 4;
    var i : u32 = 0;
    while (i < l and pc < 590) {
        const hv : u32 = hexval(tmp[i as usize]);
        if (hv < 16) {
            parts[pc as usize] = hv / 4 + 1;
            parts[(pc + 1) as usize] = hv % 4 + 1;
            pc = pc + 2;
        }
        i = i + 1;
    }
    parts[pc as usize] = 1; parts[(pc + 1) as usize] = 1; parts[(pc + 2) as usize] = 1; parts[(pc + 3) as usize] = 1;
    pc = pc + 4;
    var width : u32 = 12;
    i = 0;
    while (i < pc) {
        width = width + parts[i as usize];
        i = i + 1;
    }
    var n : u32 = raw(dst, n0, "<svg viewBox=\"0 0 ");
    n = js_str_u64(dst, n, width as u64);
    n = raw(dst, n, " 40\" preserveAspectRatio=\"none\" class=\"br-barcode\" role=\"img\"");
    n = attr(dst, n, "aria-label", SAY_BARCODE);
    n = raw(dst, n, ">");
    var x : u32 = 6;
    i = 0;
    while (i < pc) {
        if (i % 2 == 0) {
            n = raw(dst, n, "<rect x=\"");
            n = js_str_u64(dst, n, x as u64);
            n = raw(dst, n, "\" y=\"0\" width=\"");
            n = js_str_u64(dst, n, parts[i as usize] as u64);
            n = raw(dst, n, "\" height=\"40\"></rect>");
        }
        x = x + parts[i as usize];
        i = i + 1;
    }
    return raw(dst, n, "</svg>");
}

// --- the stages -----------------------------------------------------------------------------------

fn stage_item(dst: []u8, n0: u32, d: []const u8, s: i64, ix: u32) -> u32 {
    const status : i64 = obj_get(d, s, "status");
    var n : u32 = raw(dst, n0, "<div class=\"br-item br-");
    var okc : bool = jv_is(d, status, "ok");
    var failed : bool = jv_is(d, status, "failed");
    if (okc) { n = raw(dst, n, "ok"); } else { if (failed) { n = raw(dst, n, "failed"); } else { n = raw(dst, n, "notrun"); } }
    n = raw(dst, n, "\">");
    // line(name, ...)
    n = line_open(dst, n, "");
    n = js_str_u64(dst, n, (ix + 1) as u64);
    n = put(dst, n, 32);
    if (ix < (SAY_STAGE_NAMES.len as u32)) { n = text(dst, n, SAY_STAGE_NAMES[ix as usize]); } else { n = jv_text(dst, n, d, obj_get(d, s, "id")); }
    n = line_mid(dst, n);
    if (jv_is(d, status, "not run")) {
        n = text(dst, n, SAY_NOT_RUN);
        n = line_close(dst, n);
        n = div_open(dst, n, "br-sub", "");
        n = tc_text(dst, n, d, obj_get(d, s, "tool"));
        n = raw(dst, n, "</div></div>");
        return n;
    }
    n = secs_text(dst, n, num_or0(d, obj_get(d, s, "ms")));
    n = line_close(dst, n);
    n = div_open(dst, n, "br-sub", "");
    n = tool_line(dst, n, d, s);
    n = raw(dst, n, "</div>");
    if (failed) {
        n = div_open(dst, n, "br-sub", "br-bad");
        var vb : [256]u8 = [0; 256];
        var vn : u32 = 0;
        const ex : i64 = obj_get(d, s, "exit");
        if (nullish(d, ex)) { vn = jv_vput_str(vb[0..], 0, "exit", ""); } else { vn = jv_vput_val(vb[0..], 0, "exit", d, ex); }
        n = jv_fill(dst, n, SAY_FAILED, vb[0..], vn, false);
        n = raw(dst, n, "</div>");
        if (jv_truthy(d, obj_get(d, s, "error"))) {
            n = raw(dst, n, "<pre class=\"br-err\">");
            n = jv_text(dst, n, d, obj_get(d, s, "error"));
            n = raw(dst, n, "</pre>");
        }
        return raw(dst, n, "</div>");
    }
    const out : i64 = obj_get(d, s, "output");
    if (jv_truthy(d, out)) {
        n = div_open(dst, n, "br-sub", "br-detail");
        var ob : [1024]u8 = [0; 1024];
        var on : u32 = jv_vput_val(ob[0..], 0, "file", d, obj_get(d, out, "file"));
        var szn : [600]u8 = [0; 600];
        const tmpn : u32 = size_raw(szn[0..], d, obj_get(d, out, "bytes"));
        on = jv_vput_str(ob[0..], on, "size", szn[0..(tmpn as usize)]);
        n = jv_fill(dst, n, SAY_OUT, ob[0..], on, false);
        n = raw(dst, n, "</div>");
        n = div_open(dst, n, "br-sub", "br-hex br-detail");
        var hb : [512]u8 = [0; 512];
        var hn : u32 = jv_vput_val(hb[0..], 0, "sha", d, obj_get(d, out, "sha256"));
        n = jv_fill(dst, n, SAY_SHA, hb[0..], hn, false);
        n = raw(dst, n, "</div>");
    }
    const cpu : i64 = obj_get(d, s, "cpu_s");
    if (!nullish(d, cpu)) {
        n = div_open(dst, n, "br-sub", "br-faint br-detail");
        var cb : [256]u8 = [0; 256];
        var cn : u32 = jv_vput_val(cb[0..], 0, "cpu", d, cpu);
        cn = jv_vput_f64(cb[0..], cn, "rss", js_round(num_or0(d, obj_get(d, s, "rss_mb"))));
        n = jv_fill(dst, n, SAY_CPU, cb[0..], cn, false);
        n = raw(dst, n, "</div>");
    }
    return raw(dst, n, "</div>");
}

/// The names specDiff() lists: where the generated constants of this spec and receipt.json disagree.
fn spec_diff(dst: []u8, n0: u32, d: []const u8, r: i64) -> u32 {
    const st : i64 = obj_get(d, r, "stages");
    const cnt : u32 = arr_len(d, st);
    var n : u32 = n0;
    var any : bool = false;
    const sc : i64 = obj_get(d, r, "stage_count");
    if (!(kind(d, sc) == J_NUMBER and jv_num(d, sc) == (K_STAGE_COUNT as f64) and jv_num(d, sc) == (cnt as f64))) {
        n = raw(dst, n, "K_STAGE_COUNT");
        any = true;
    }
    const so : i64 = obj_get(d, r, "stages_ok");
    if (!(kind(d, so) == J_NUMBER and jv_num(d, so) == (K_STAGES_OK as f64))) {
        if (any) { n = raw(dst, n, ", "); }
        n = raw(dst, n, "K_STAGES_OK");
        any = true;
    }
    var msbad : bool = false;
    if ((K_STAGE_MS.len as u32) != cnt) { msbad = true; }
    var sum : f64 = 0.0;
    // reduce((a, b) => a + b, 0): numbers add; once a string (or object / array) is met the rest is concatenated
    var sbuf : [1100]u8 = [0; 1100];
    var sl : u32 = 0;
    var strmode : bool = false;
    var i : u32 = 0;
    while (i < cnt) {
        const ms : i64 = obj_get(d, arr_at(d, st, i), "ms");
        const mk : u8 = kind(d, ms);
        var mv : f64 = 0.0;
        var is_num : bool = true;
        if (!nullish(d, ms)) {
            mv = jv_num(d, ms);
            is_num = mk == J_NUMBER;
        }
        if (i < (K_STAGE_MS.len as u32)) {
            if (!is_num or mv != (K_STAGE_MS[i as usize] as f64)) { msbad = true; }
        }
        if (!strmode and (mk == J_STRING or mk == J_OBJECT or mk == J_ARRAY)) {
            strmode = true;
            sl = js_str_num(sbuf[0..], 0, sum);
        }
        if (strmode) {
            if (nullish(d, ms)) { sl = jn_raw(sbuf[0..], sl, "0"); } else { sl = jv_str(sbuf[0..], sl, d, ms); }
        } else {
            sum = sum + mv;
        }
        i = i + 1;
    }
    if (strmode) { sum = jv_number_of_text(sbuf[0..], sl); }
    if (msbad) {
        if (any) { n = raw(dst, n, ", "); }
        n = raw(dst, n, "K_STAGE_MS");
        any = true;
    }
    const tm : i64 = obj_get(d, r, "total_ms");
    if (!(kind(d, tm) == J_NUMBER and jv_num(d, tm) == (K_TOTAL_MS as f64))) {
        if (any) { n = raw(dst, n, ", "); }
        n = raw(dst, n, "K_TOTAL_MS");
        any = true;
    }
    const bit : i64 = obj_get(d, r, "bit");
    if (jv_truthy(d, bit)) {
        const bb : i64 = obj_get(d, bit, "bytes");
        if (!(kind(d, bb) == J_NUMBER and jv_num(d, bb) == (K_BIT_BYTES as f64))) {
            if (any) { n = raw(dst, n, ", "); }
            n = raw(dst, n, "K_BIT_BYTES");
            any = true;
        }
    }
    var gap : f64 = sum - jv_num(d, tm);
    if (gap < 0.0) { gap = 0.0 - gap; }
    if (gap > (K_ROUND_TOL_MS as f64)) {
        if (any) { n = raw(dst, n, ", "); }
        n = raw(dst, n, "total_ms");
    }
    return n;
}

fn member_value(d: []const u8, ut: i64, ix: u32, key_out: []u8, key_len: []u32) -> i64 {
    const hi : usize = span_hi(ut);
    var p : usize = skip_ws(d, span_lo(ut) + 1);
    var at : u32 = 0;
    while (p < hi and d[p] == 34) {
        const ke : usize = string_end(d, p);
        const q : usize = skip_ws(d, ke);
        const v : usize = skip_ws(d, q + 1);
        const ve : usize = value_end(d, v);
        if (at == ix) {
            key_len[0] = jv_str_to(key_out, 0, d, jspan(p, ke));
            return jspan(v, ve);
        }
        at = at + 1;
        p = skip_ws(d, ve);
        if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
    }
    return NO_SPAN;
}

fn member_count(d: []const u8, ut: i64) -> u32 {
    const hi : usize = span_hi(ut);
    var p : usize = skip_ws(d, span_lo(ut) + 1);
    var at : u32 = 0;
    while (p < hi and d[p] == 34) {
        const ke : usize = string_end(d, p);
        const q : usize = skip_ws(d, ke);
        const v : usize = skip_ws(d, q + 1);
        const ve : usize = value_end(d, v);
        at = at + 1;
        p = skip_ws(d, ve);
        if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
    }
    return at;
}

fn paper_html(dst: []u8, n0: u32, d: []const u8, r: i64) -> u32 {
    const bit : i64 = obj_get(d, r, "bit");
    const mach : i64 = obj_get(d, r, "machine");
    const des : i64 = obj_get(d, r, "design");
    const sha : i64 = obj_get(d, bit, "sha256");
    var n : u32 = raw(dst, n0, "<article class=\"br-paper\"");
    n = attr(dst, n, "aria-label", TITLE);
    n = raw(dst, n, ">");
    // the receipt number: the payload digest (else the file digest), first 8 characters, upper case
    var pay : i64 = obj_get(d, bit, "payload_sha256");
    if (nullish(d, pay)) { pay = sha; }
    var nb : [64]u8 = [0; 64];
    var nl : u32 = 0;
    if (kind(d, pay) == J_STRING) {
        var raw8 : [512]u8 = [0; 512];
        const rl : u32 = jv_str(raw8[0..], 0, d, pay);
        var units : u32 = 0;
        var q : u32 = 0;
        while (q < rl and units < 8 and nl < 56) {
            const c : u8 = raw8[q as usize];
            var w : u32 = 1;
            var u : u32 = 1;
            if (c >= 192) { w = 2; }
            if (c >= 224) { w = 3; }
            if (c >= 240) { w = 4; u = 2; }
            if (units + u > 8) { break; }
            if (c >= 97 and c <= 122) {
                nb[nl as usize] = c - 32;
                nl = nl + 1;
            } else {
                if (c == 195 and q + 1 < rl) {
                    // Latin-1: a..o / o..y with a diaeresis etc. go up by 32 (not the division sign); y with diaeresis and sharp s are special
                    const c2 : u8 = raw8[(q + 1) as usize];
                    if (c2 == 159) {
                        nb[nl as usize] = 83;
                        nb[(nl + 1) as usize] = 83;
                        nl = nl + 2;
                    } else {
                        if (c2 == 191) {
                            nb[nl as usize] = 197;
                            nb[(nl + 1) as usize] = 184;
                            nl = nl + 2;
                        } else {
                            nb[nl as usize] = c;
                            if (c2 >= 160 and c2 <= 190 and c2 != 183) { nb[(nl + 1) as usize] = c2 - 32; } else { nb[(nl + 1) as usize] = c2; }
                            nl = nl + 2;
                        }
                    }
                } else {
                    if (c == 194 and q + 1 < rl and raw8[(q + 1) as usize] == 181) {
                        nb[nl as usize] = 206;
                        nb[(nl + 1) as usize] = 156;
                        nl = nl + 2;
                    } else {
                        var z : u32 = 0;
                        while (z < w and q + z < rl) {
                            nb[(nl + z) as usize] = raw8[(q + z) as usize];
                            z = z + 1;
                        }
                        nl = nl + z;
                    }
                }
            }
            q = q + w;
            units = units + u;
        }
    }
    var vb : [512]u8 = [0; 512];
    var vn : u32 = jv_vput_str(vb[0..], 0, "no", nb[0..(nl as usize)]);
    n = div_open(dst, n, "br-center", "br-shop");
    n = text(dst, n, SAY_SHOP);
    n = raw(dst, n, "</div>");
    n = div_open(dst, n, "br-center", "");
    n = jv_fill(dst, n, SAY_RECEIPT, vb[0..], vn, false);
    n = raw(dst, n, "</div>");
    // when
    n = div_open(dst, n, "br-center", "");
    var wb : [1200]u8 = [0; 1200];
    var wtmp : [1100]u8 = [0; 1100];
    const wl : u32 = utc_raw(wtmp[0..], d, obj_get(d, r, "when_utc"));
    var wn : u32 = jv_vput_str(wb[0..], 0, "when", wtmp[0..(wl as usize)]);
    n = jv_fill(dst, n, SAY_WHEN, wb[0..], wn, false);
    n = raw(dst, n, "</div>");
    // machine
    n = div_open(dst, n, "br-center", "br-faint");
    var mb : [1024]u8 = [0; 1024];
    var mn : u32 = 0;
    if (kind(d, mach) == J_OBJECT) {
        mn = jv_vput_defined(mb[0..], mn, "cpu", d, obj_get(d, mach, "cpu"));
        mn = jv_vput_defined(mb[0..], mn, "cores", d, obj_get(d, mach, "cores"));
        mn = jv_vput_defined(mb[0..], mn, "macos", d, obj_get(d, mach, "macos"));
    }
    n = jv_fill(dst, n, SAY_MACHINE, mb[0..], mn, false);
    n = raw(dst, n, "</div>");
    n = div_open(dst, n, "br-center", "br-faint");
    var lb : [256]u8 = [0; 256];
    var ln : u32 = 0;
    const la : i64 = obj_get(d, mach, "loadavg_1m_at_start");
    if (nullish(d, la)) { ln = jv_vput_str(lb[0..], 0, "load", ""); } else { ln = jv_vput_val(lb[0..], 0, "load", d, la); }
    n = jv_fill(dst, n, SAY_LOAD, lb[0..], ln, false);
    n = raw(dst, n, "</div>");
    n = rule_html(dst, n);
    // design
    n = div_open(dst, n, "br-sub", "");
    n = text(dst, n, SAY_LABEL_SPEC);
    n = raw(dst, n, ": ");
    n = nn_text(dst, n, d, obj_get(d, des, "spec"));
    n = raw(dst, n, "</div>");
    n = div_open(dst, n, "br-sub", "");
    n = text(dst, n, SAY_LABEL_PART);
    n = raw(dst, n, ": ");
    n = nn_text(dst, n, d, obj_get(d, des, "part"));
    n = raw(dst, n, "</div>");
    n = div_open(dst, n, "br-sub", "br-detail");
    n = text(dst, n, SAY_LABEL_BOARD);
    n = raw(dst, n, ": ");
    n = nn_text(dst, n, d, obj_get(d, des, "board"));
    n = raw(dst, n, "</div>");
    n = div_open(dst, n, "br-sub", "br-faint br-detail");
    var db : [1024]u8 = [0; 1024];
    var dn : u32 = 0;
    dn = jv_vput_nn(db[0..], dn, "name", d, obj_get(d, des, "datapath"));
    dn = jv_vput_nn(db[0..], dn, "lines", d, obj_get(d, des, "wrapper_lines"));
    n = jv_fill(dst, n, SAY_WRAPPER, db[0..], dn, false);
    n = raw(dst, n, "</div>");
    n = rule_html(dst, n);
    n = line_open(dst, n, "br-head");
    n = text(dst, n, SAY_COL_ITEM);
    n = line_mid(dst, n);
    n = text(dst, n, SAY_COL_TIME);
    n = line_close(dst, n);
    // items
    const st : i64 = obj_get(d, r, "stages");
    const cnt : u32 = arr_len(d, st);
    var i : u32 = 0;
    while (i < cnt) {
        n = stage_item(dst, n, d, arr_at(d, st, i), i);
        i = i + 1;
    }
    n = rule_html(dst, n);
    // totals
    n = div_open(dst, n, "br-line", "");
    var tb : [256]u8 = [0; 256];
    var tn : u32 = jv_vput_val(tb[0..], 0, "ok", d, obj_get(d, r, "stages_ok"));
    tn = jv_vput_val(tb[0..], tn, "count", d, obj_get(d, r, "stage_count"));
    n = jv_fill(dst, n, SAY_ITEMS, tb[0..], tn, false);
    n = raw(dst, n, "</div>");
    const total_ms : f64 = jv_num(d, obj_get(d, r, "total_ms"));
    if (jv_truthy(d, obj_get(d, r, "complete"))) {
        n = line_open(dst, n, "br-total");
        n = text(dst, n, SAY_TOTAL);
        n = line_mid(dst, n);
        n = secs_text(dst, n, total_ms);
        n = line_close(dst, n);
    } else {
        n = div_open(dst, n, "br-sub", "br-bad br-total-miss");
        var sb : [256]u8 = [0; 256];
        var stmp : [200]u8 = [0; 200];
        const sl : u32 = secs_text_raw(stmp[0..], total_ms);
        const sn : u32 = jv_vput_str(sb[0..], 0, "s", stmp[0..(sl as usize)]);
        n = jv_fill(dst, n, SAY_NO_TOTAL, sb[0..], sn, false);
        n = raw(dst, n, "</div>");
    }
    var vt : [64]u8 = [0; 64];
    var vtl : u32 = 0;
    const vend : i64 = obj_get(d, r, "vendor_tools_run");
    if (nullish(d, vend)) { vtl = jn_raw(vt[0..], 0, "0"); } else { vtl = jv_str(vt[0..], 0, d, vend); }
    n = line_open(dst, n, "br-big");
    n = text(dst, n, SAY_VIVADO);
    n = line_mid(dst, n);
    n = put_all(dst, n, vt[0..], vtl);
    n = line_close(dst, n);
    n = line_open(dst, n, "");
    n = text(dst, n, SAY_VENDOR);
    n = line_mid(dst, n);
    n = put_all(dst, n, vt[0..], vtl);
    n = line_close(dst, n);
    n = div_open(dst, n, "br-sub", "br-faint");
    var eb : [256]u8 = [0; 256];
    var etmp : [200]u8 = [0; 200];
    const el : u32 = secs_text_raw(etmp[0..], num_or0(d, obj_get(d, r, "wall_ms_end_to_end")));
    const en : u32 = jv_vput_str(eb[0..], 0, "s", etmp[0..(el as usize)]);
    n = jv_fill(dst, n, SAY_END_TO_END, eb[0..], en, false);
    n = raw(dst, n, "</div>");
    n = rule_html(dst, n);
    // the design that came out
    const fm : i64 = obj_get(d, r, "fmax");
    if (jv_truthy(d, fm)) {
        const pass : bool = jv_truthy(d, obj_get(d, fm, "pass"));
        if (pass) { n = line_open(dst, n, ""); } else { n = line_open(dst, n, "br-bad"); }
        var fb : [512]u8 = [0; 512];
        var fn_ : u32 = jv_vput_val(fb[0..], 0, "clock", d, obj_get(d, fm, "clock"));
        fn_ = jv_vput_val(fb[0..], fn_, "mhz", d, obj_get(d, fm, "mhz"));
        fn_ = jv_vput_val(fb[0..], fn_, "target", d, obj_get(d, fm, "target_mhz"));
        n = jv_fill(dst, n, SAY_FMAX, fb[0..], fn_, false);
        n = line_mid(dst, n);
        if (pass) { n = text(dst, n, SAY_PASS); } else { n = text(dst, n, SAY_FAIL); }
        n = line_close(dst, n);
    }
    const ut : i64 = obj_get(d, r, "utilisation");
    var has_entries : bool = false;
    if (jv_truthy(d, ut)) {
        if (kind(d, ut) == J_ARRAY) { has_entries = arr_len(d, ut) > 0; }
        if (kind(d, ut) == J_OBJECT) { has_entries = member_count(d, ut) > 0; }
    }
    if (has_entries) {
        n = div_open(dst, n, "br-sub", "");
        n = text(dst, n, SAY_UTIL_TITLE);
        n = raw(dst, n, "</div>");
        var ecount : u32 = 0;
        if (kind(d, ut) == J_ARRAY) { ecount = arr_len(d, ut); } else { ecount = member_count(d, ut); }
        var e : u32 = 0;
        while (e < ecount) {
            var kb : [512]u8 = [0; 512];
            var kl : [1]u32 = [0; 1];
            var val : i64 = NO_SPAN;
            if (kind(d, ut) == J_ARRAY) {
                val = arr_at(d, ut, e);
                kl[0] = js_str_u64(kb[0..], 0, e as u64);
            } else {
                val = member_value(d, ut, e, kb[0..], kl[0..]);
            }
            n = line_open(dst, n, "br-small");
            n = raw(dst, n, "  ");
            n = put_all(dst, n, kb[0..], kl[0]);
            n = line_mid(dst, n);
            n = jv_text(dst, n, d, arr_at(d, val, 0));
            n = raw(dst, n, " / ");
            n = jv_text(dst, n, d, arr_at(d, val, 1));
            n = line_close(dst, n);
            e = e + 1;
        }
    }
    if (jv_truthy(d, fm) or jv_truthy(d, ut)) { n = rule_html(dst, n); }
    // the bitstream
    if (jv_truthy(d, bit)) {
        n = div_open(dst, n, "br-sub", "");
        n = text(dst, n, SAY_FILE_SHA);
        n = raw(dst, n, ": ");
        n = size_text(dst, n, d, obj_get(d, bit, "bytes"));
        n = raw(dst, n, "</div>");
        n = div_open(dst, n, "br-sub", "br-hex");
        n = tc_text(dst, n, d, obj_get(d, bit, "sha256"));
        n = raw(dst, n, "</div>");
        n = div_open(dst, n, "br-sub", "br-faint");
        n = text(dst, n, SAY_FILE_SHA_NOTE);
        n = raw(dst, n, "</div>");
        n = div_open(dst, n, "br-sub", "");
        var pb : [600]u8 = [0; 600];
        var pstr : [600]u8 = [0; 600];
        const pl : u32 = size_raw(pstr[0..], d, obj_get(d, bit, "payload_bytes"));
        const pn : u32 = jv_vput_str(pb[0..], 0, "size", pstr[0..(pl as usize)]);
        n = jv_fill(dst, n, SAY_PAYLOAD_SHA, pb[0..], pn, false);
        n = raw(dst, n, "</div>");
        n = div_open(dst, n, "br-sub", "br-hex");
        n = tc_text(dst, n, d, obj_get(d, bit, "payload_sha256"));
        n = raw(dst, n, "</div>");
        const er : i64 = obj_get(d, r, "earlier_runs");
        var ec : u32 = 0;
        if (kind(d, er) == J_ARRAY) { ec = arr_len(d, er); }
        if (ec > 0) {
            const same : bool = jv_truthy(d, obj_get(d, r, "payload_same_as_earlier"));
            if (same) { n = div_open(dst, n, "br-sub", ""); } else { n = div_open(dst, n, "br-sub", "br-bad"); }
            if (same) {
                var sb2 : [64]u8 = [0; 64];
                const sn2 : u32 = jv_vput_f64(sb2[0..], 0, "n", ec as f64);
                n = jv_fill(dst, n, SAY_SAME_PAYLOAD, sb2[0..], sn2, false);
            } else {
                n = text(dst, n, SAY_OTHER_PAYLOAD);
            }
            n = raw(dst, n, "</div>");
            var x : u32 = 0;
            while (x < ec) {
                const e2 : i64 = arr_at(d, er, x);
                n = div_open(dst, n, "br-sub", "br-faint");
                var xb : [1600]u8 = [0; 1600];
                var xt : [1100]u8 = [0; 1100];
                var xtl : u32 = utc_raw(xt[0..], d, obj_get(d, e2, "when_utc"));
                var xn : u32 = jv_vput_str(xb[0..], 0, "when", xt[0..(xtl as usize)]);
                var xs : [200]u8 = [0; 200];
                const xsl : u32 = secs_text_raw(xs[0..], jv_num(d, obj_get(d, e2, "total_ms")));
                xn = jv_vput_str(xb[0..], xn, "s", xs[0..(xsl as usize)]);
                xn = jv_vput_val(xb[0..], xn, "load", d, obj_get(d, e2, "loadavg_1m_at_start"));
                n = jv_fill(dst, n, SAY_EARLIER, xb[0..], xn, false);
                n = raw(dst, n, "</div>");
                x = x + 1;
            }
        }
        const cc : i64 = obj_get(d, r, "cross_check");
        const cs : i64 = obj_get(d, cc, "status");
        const cok : bool = jv_is(d, cs, "ok");
        const ceq : bool = jv_truthy(d, obj_get(d, cc, "payload_equal"));
        if (cok and !ceq) { n = div_open(dst, n, "br-sub", "br-bad"); } else { n = div_open(dst, n, "br-sub", ""); }
        if (cok and ceq) {
            var cb : [256]u8 = [0; 256];
            const cn : u32 = jv_vput_val(cb[0..], 0, "ms", d, obj_get(d, cc, "ms"));
            n = jv_fill(dst, n, SAY_CROSS_OK, cb[0..], cn, false);
        } else {
            if (cok) { n = text(dst, n, SAY_CROSS_BAD); } else { n = text(dst, n, SAY_CROSS_SKIP); }
        }
        n = raw(dst, n, "</div>");
        n = rule_html(dst, n);
        n = barcode_html(dst, n, d, sha);
        n = div_open(dst, n, "br-center", "br-hex br-tiny");
        n = tc_text(dst, n, d, sha);
        n = raw(dst, n, "</div>");
    }
    n = div_open(dst, n, "br-center", "br-small");
    n = text(dst, n, SAY_NOT_PROGRAMMED);
    n = raw(dst, n, "</div>");
    n = div_open(dst, n, "br-center", "br-faint br-small");
    n = text(dst, n, SAY_FOOTER);
    n = raw(dst, n, "</div>");
    return raw(dst, n, "</article>");
}

/// `x ?? ''` as a child / template-literal piece: the value's String(), nothing for null / missing.
fn nn_text(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    if (nullish(d, sp)) { return n0; }
    return jv_text(dst, n0, d, sp);
}

/// A pool entry for `{key: x ?? ''}`.
fn jv_vput_nn(vb: []u8, n0: u32, key: []const u8, d: []const u8, sp: i64) -> u32 {
    if (nullish(d, sp)) { return jv_vput_str(vb, n0, key, ""); }
    return jv_vput_val(vb, n0, key, d, sp);
}

/// utc(iso) as raw bytes (not escaped) into out; the length.
fn utc_raw(out: []u8, d: []const u8, sp: i64) -> u32 {
    var l : u32 = 0;
    if (!nullish(d, sp)) { l = jv_str(out, 0, d, sp); }
    var k : u32 = 0;
    var done : bool = false;
    while (k < l and !done) {
        if (out[k as usize] == 84) {
            out[k as usize] = 32;
            done = true;
        }
        k = k + 1;
    }
    if (l > 0 and out[(l - 1) as usize] == 90) {
        var e : u32 = l - 1;
        var j : u32 = e;
        while (j > 0 and out[(j - 1) as usize] >= 48 and out[(j - 1) as usize] <= 57) { j = j - 1; }
        if (j < e and j > 0 and out[(j - 1) as usize] == 46) { e = j - 1; }
        l = e;
    }
    return l;
}

/// secs(ms) as raw bytes into out: SAY_SECONDS with (ms / 1000).toFixed(3).
fn secs_text_raw(out: []u8, ms: f64) -> u32 {
    var tmp : [128]u8 = [0; 128];
    const l : u32 = js_to_fixed(tmp[0..], 0, ms / 1000.0, 3);
    return fill_raw(out, SAY_SECONDS, tmp[0..(l as usize)]);
}

/// The template with {s} replaced by v, as raw (unescaped) bytes.
fn fill_raw(out: []u8, t: []const u8, v: []const u8) -> u32 {
    var n : u32 = 0;
    var i : usize = 0;
    while (i < t.len) {
        if (t[i] == 123 and i + 2 < t.len and t[i + 1] == 115 and t[i + 2] == 125) {
            n = jn_raw(out, n, v);
            i = i + 3;
        } else {
            n = jn_put(out, n, t[i]);
            i = i + 1;
        }
    }
    return n;
}

pub fn w_render(dst: []u8) -> u32 {
    var n : u32 = 0;
    if (DATA_STATE == 0) {
        n = raw(dst, n, "<p class=\"br-status\">");
        n = text(dst, n, SAY_LOADING);
        n = raw(dst, n, "</p>");
        if (!ok(n)) { return 0; }
        return n;
    }
    if (DATA_STATE == 2) {
        n = raw(dst, n, "<p class=\"br-status br-bad\" role=\"alert\">");
        n = text(dst, n, SAY_ERROR);
        n = raw(dst, n, "</p>");
        if (!ok(n)) { return 0; }
        return n;
    }
    const d : []const u8 = DATA[0..(DATA_LEN as usize)];
    const r : i64 = root(d);
    n = raw(dst, n, "<div class=\"br-wrap\">");
    var diff : [512]u8 = [0; 512];
    const dl : u32 = spec_diff(diff[0..], 0, d, r);
    if (dl > 0) {
        n = raw(dst, n, "<p class=\"br-warn\" role=\"status\">");
        var wb : [600]u8 = [0; 600];
        const wn : u32 = jv_vput_str(wb[0..], 0, "what", diff[0..(dl as usize)]);
        n = jv_fill(dst, n, SAY_SPEC_DIFF, wb[0..], wn, false);
        n = raw(dst, n, "</p>");
    }
    n = paper_html(dst, n, d, r);
    n = raw(dst, n, "<div class=\"br-tools\"><button type=\"button\" class=\"t27-btn\" aria-pressed=\"");
    if (CMDS_ON) { n = raw(dst, n, "true"); } else { n = raw(dst, n, "false"); }
    n = raw(dst, n, "\" aria-controls=\"br-cmds\">");
    if (CMDS_ON) { n = text(dst, n, SAY_HIDE_CMDS); } else { n = text(dst, n, SAY_SHOW_CMDS); }
    n = raw(dst, n, "</button></div><pre class=\"br-cmds\" id=\"br-cmds\"");
    if (!CMDS_ON) { n = raw(dst, n, " hidden=\"\""); }
    n = raw(dst, n, ">");
    const cm : i64 = obj_get(d, r, "commands");
    if (kind(d, cm) == J_ARRAY) {
        const cc : u32 = arr_len(d, cm);
        var c : u32 = 0;
        while (c < cc) {
            if (c > 0) { n = put(dst, n, 10); }
            const el : i64 = arr_at(d, cm, c);
            if (!nullish(d, el)) { n = jv_text(dst, n, d, el); }
            c = c + 1;
        }
    }
    n = raw(dst, n, "</pre><section class=\"br-verify\"><h2>");
    n = text(dst, n, SAY_VERIFY_TITLE);
    n = raw(dst, n, "</h2><ol>");
    var v : usize = 0;
    while (v < SAY_VERIFY_STEPS.len) {
        n = raw(dst, n, "<li>");
        n = text(dst, n, SAY_VERIFY_STEPS[v]);
        n = raw(dst, n, "</li>");
        v = v + 1;
    }
    n = raw(dst, n, "</ol></section></div>");
    if (!ok(n)) { return 0; }
    return n;
}

/// The splicer follows only the names a module itself mentions, not the names the imported functions
/// mention. This anchor mentions every helper the writer, the JSON reader and the number rules call.
/// Never called.
pub fn imports_anchor(o: []u8, s: []const u8) -> u32 {
    var n : u32 = 0;
    n = n + (ok(0) as u32);
    n = n + OVER;
    n = n + put(o, 0, 0);
    n = n + raw(o, 0, s);
    n = n + put_escaped(o, 0, 0);
    n = n + text(o, 0, s);
    n = n + num(o, 0, 0);
    n = n + attr(o, 0, s, s);
    n = n + fill(o, 0, s, s, s, s, 0);
    n = n + fill_named(o, 0, s, s, s, s, s, s, s, s, s, s, s, s, s);
    n = n + dec_to(o, 0);
    n = n + (name_is(s, 0, 0, s) as u32);
    n = n + (is_word_byte(0) as u32);
    n = n + (H_LT as u32);
    n = n + (H_GT as u32);
    n = n + (H_AMP as u32);
    n = n + (H_QUOTE as u32);
    n = n + (H_APOS as u32);
    n = n + (H_SPACE as u32);
    n = n + (H_SLASH as u32);
    n = n + (H_EQ as u32);
    n = n + ((NO_SPAN < 0) as u32);
    n = n + ((SPAN > 0) as u32);
    n = n + (J_NONE as u32);
    n = n + (J_OBJECT as u32);
    n = n + (J_ARRAY as u32);
    n = n + (J_STRING as u32);
    n = n + (J_NUMBER as u32);
    n = n + (J_TRUE as u32);
    n = n + (J_FALSE as u32);
    n = n + (J_NULL as u32);
    n = n + (jspan(0, 0) as u32);
    n = n + (span_lo(0) as u32);
    n = n + (span_hi(0) as u32);
    n = n + (skip_ws(s, 0) as u32);
    n = n + (string_end(s, 0) as u32);
    n = n + (value_end(s, 0) as u32);
    n = n + (root(s) as u32);
    n = n + (kind(s, 0) as u32);
    n = n + (key_is(s, 0, 0, s) as u32);
    n = n + (obj_get(s, 0, s) as u32);
    n = n + arr_len(s, 0);
    n = n + (arr_at(s, 0, 0) as u32);
    n = n + hex4(s, 0);
    n = n + escape_at(s, 0, 0);
    n = n + cp_utf8_len(0);
    n = n + (cp_utf8_byte(0, 0) as u32);
    n = n + str_len(s, 0);
    n = n + (str_byte(s, 0, 0) as u32);
    n = n + JN_OVER;
    n = n + JN_CAP;
    n = n + ((JN_TWO52 > 0.0) as u32);
    n = n + ((JN_TWO53 > 0.0) as u32);
    n = n + jn_put(o, 0, 0);
    n = n + jn_raw(o, 0, s);
    n = n + jn_digits(o, 0);
    n = n + jn_mul(o, 0, 0);
    n = n + jn_mul2(o, 0, 0);
    n = n + jn_mul5(o, 0, 0);
    n = n + jn_shift(o, 0, 0);
    n = n + (jn_cmp(s, s, 0) as u32);
    n = n + (jn_expo(0.0) as u32);
    n = n + (jn_mant(0.0) as u32);
    n = n + ((jn_make(0, 0) > 0.0) as u32);
    n = n + jn_exact(o, 0, 0);
    n = n + jn_fscale(0);
    n = n + (js_is_nan(0.0) as u32);
    n = n + ((js_nan(0.0) > 0.0) as u32);
    n = n + ((js_inf(1.0) > 0.0) as u32);
    n = n + ((js_floor(0.0) > 0.0) as u32);
    n = n + ((js_ceil(0.0) > 0.0) as u32);
    n = n + ((js_max(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_min(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_round(0.0) > 0.0) as u32);
    n = n + (jn_shortest(o, 1.0) as u32);
    n = n + jn_copy(o, s, 0);
    n = n + jn_put_run(o, 0, s, 0, 0);
    n = n + jn_layout(o, 0, s, 0, 0);
    n = n + js_str_num(o, 0, 0.0);
    n = n + js_to_fixed(o, 0, 0.0, 0);
    n = n + js_locale_num(o, 0, 0.0);
    n = n + (jn_num_ok(s, 0, 0) as u32);
    n = n + (jn_cmp_text(s, 0, 0, 0, 0) as u32);
    n = n + ((js_parse_num(s, 0, 0) > 0.0) as u32);
    n = n + ((jn_dec_value(s, 0, 0) > 0.0) as u32);
    n = n + (jn_abs(0) as u32);
    n = n + js_str_u64(o, 0, 0);
    n = n + jv_str_to(o, 0, s, 0);
    n = n + jv_text_str(o, 0, s, 0);
    n = n + ((jv_numval(s, 0) > 0.0) as u32);
    n = n + jv_str(o, 0, s, 0);
    n = n + jv_text(o, 0, s, 0);
    n = n + (jv_is(s, 0, s) as u32);
    n = n + (jv_truthy(s, 0) as u32);
    n = n + (jv_is_ws(0) as u32);
    n = n + ((jv_number_of_text(s, 0) > 0.0) as u32);
    n = n + ((jv_num(s, 0) > 0.0) as u32);
    n = n + jv_vput_str(o, 0, s, s);
    n = n + jv_vput_f64(o, 0, s, 0.0);
    n = n + jv_vput_val(o, 0, s, s, 0);
    n = n + jv_vput_defined(o, 0, s, s, 0);
    n = n + jv_vput_fixed(o, 0, s, 0.0, 0);
    n = n + jv_kid(o, 0, s, 0);
    n = n + jv_find(s, 0, s);
    n = n + jv_fill(o, 0, s, s, 0, true);
    n = n + (jv_string_ok(s, 0) as u32);
    n = n + (jv_number_ok(s, 0) as u32);
    n = n + (jv_lit_ok(s, 0, s) as u32);
    n = n + (jv_valid(s) as u32);
    n = n + jv_ws_at(s, 0, 0);
    n = n + jv_ws_before(s, 0, 0);
    n = n + jv_digit_value(0);
    return n;
}
