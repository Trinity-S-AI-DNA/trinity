// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-container.t27 -- The container: six header bytes and how a loader says no
; Source of truth for public/widgets/cmp-container/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-container/logic.js -- the fn
; bodies of gHashTag/t27 specs/isa/tri27_bytecode.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 27 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader sets the file length, the four magic bytes and the version byte. header_status gives the loader's answer and
; magic_word the number the four bytes make; section_kind_ok and section_header_bytes describe each section id from 0 to 5.

; WHAT IT DOES NOT CLAIM:  it loads no file and runs no program. The spec records the container as the pinned loader reads it; findings about the
; loader and its writers are in the spec, and the page does not restate them. Only the header and the section kinds are run.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_container;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-container";
pub const TITLE : str = "The container: six header bytes and how a loader says no";
pub const DESCRIPTION : str = "A program file starts with a magic number and a version, and the loader refuses what it cannot read, in a fixed order. Set the length and the first bytes of a file and read the loader's verdict.";
pub const IMAGE_ALT : str = "Container card: a twelve-byte file whose first four bytes spell 2IRT and whose version is 1. The header status is ok, in green. The four magic bytes are drawn as cells, and a list of the four section kinds shows the size of the header each one has: code four bytes, constants one, data three and bss three.";
pub const HOOK : str = "A file under six bytes is truncated before the magic is read. Then the magic is checked, then the version: the loader says no in a fixed order, and says which.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/isa/tri27_bytecode.t27 (t27 master 90e797659): every verdict is header_status, magic_word, section_kind_ok or section_header_bytes, fn bodies compiled to wasm (logic.js); the container is the one the pinned loader reads, as the spec's header records", "Course 12 of t27.ai, t27-compiler: lesson 27 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 8;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_MAGIC : u32 = 1414678834;
pub const K_VERSION : u8 = 1;
pub const K_HEADER_BYTES : u8 = 6;
pub const K_LOAD_OK : u8 = 0;
pub const K_LOAD_TRUNCATED : u8 = 1;
pub const K_LOAD_INVALID_MAGIC : u8 = 2;
pub const K_LOAD_INVALID_VERSION : u8 = 3;
pub const K_MAX_LEN : u8 = 32;
pub const K_PRESET_LEN : [5]u8 = [12, 5, 12, 12, 6];
pub const K_PRESET_B0 : [5]u8 = [50, 50, 84, 50, 50];
pub const K_PRESET_B1 : [5]u8 = [73, 73, 82, 73, 73];
pub const K_PRESET_B2 : [5]u8 = [82, 82, 73, 82, 82];
pub const K_PRESET_B3 : [5]u8 = [84, 84, 50, 84, 84];
pub const K_PRESET_VERSION : [5]u8 = [1, 1, 1, 2, 1];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine steps of this course; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [5]str = ["A good header", "Five bytes only", "Magic the wrong way round", "Version 2", "Exactly the header"];
pub const SAY_ASK : str = "In what order does a loader refuse a program file?";
pub const SAY_LEN : str = "file length, bytes";
pub const SAY_B0 : str = "magic byte 0";
pub const SAY_B1 : str = "magic byte 1";
pub const SAY_B2 : str = "magic byte 2";
pub const SAY_B3 : str = "magic byte 3";
pub const SAY_VERSION : str = "version byte";
pub const SAY_STATUS_NAMES : [4]str = ["ok", "truncated", "invalid magic", "invalid version"];
pub const SAY_STATUS_LINES : [4]str = ["the header is read and the sections come next", "a file shorter than six bytes is truncated before the magic is read", "the four bytes do not make the magic number", "the version byte is not the one version the loader reads"];
pub const SAY_MAGIC : str = "the four bytes make";
pub const SAY_EXPECTED : str = "the loader expects";
pub const SAY_SECTIONS : [6]str = ["id 0", "CODE", "CONSTANTS", "DATA", "BSS", "id 5"];
pub const SAY_SECTION_KIND : str = "a section kind: {0}";
pub const SAY_NOT_KIND : str = "not a section kind";
pub const SAY_HEADER_OF : str = "section header bytes: {0}";
pub const SAY_NOTE : str = "The header is the magic number as four bytes, one version byte and one section count byte. The order of refusal is fixed: length first, then magic, then version, so the same bad file always gets the same answer.";
pub const SAY_SOURCE : str = "Logic: t27 spec isa/tri27_bytecode.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_is_one_of_nine_course_steps {
    assert K_STAGE < 9;
    assert K_STAGE == 8;
}

test the_header_is_six_bytes_and_the_magic_is_four_of_them {
    assert K_HEADER_BYTES == 6;
    assert K_VERSION == 1;
    assert K_MAGIC == 1414678834;
}

test four_answers_and_a_good_start {
    assert K_LOAD_OK == 0;
    assert K_LOAD_INVALID_VERSION == 3;
    assert K_PRESET_LEN[0] >= K_HEADER_BYTES;
    assert K_PRESET_LEN[1] < K_HEADER_BYTES;
    assert K_PRESET_LEN[4] == K_HEADER_BYTES;
    assert K_PRESET_VERSION[3] > K_VERSION;
    assert K_START_PRESET == 0;
}
