; --- Tests ----------------------------------------------------------------------------------------
test a_three_trit_cell_holds_27_codes_and_no_negative_zero {
    assert K_CELL_CODES == 3 * 3 * 3;
    assert K_CELL_TRITS == 3;
    assert K_CELL_CODES == 2 * K_T27_MAGS + 1;
}

test e2m1_has_16_codes_and_15_values {
    assert K_E2M1_CODES == 2 * 2 * 2 * 2;
    assert K_E2M1_CODES == 2 * K_E2M1_MAGS;
    assert K_E2M1_DISTINCT == K_E2M1_CODES - 1;
    assert K_E2M1_CODES < K_CELL_CODES;
    assert K_CELL_CODES - K_E2M1_CODES == 11;
}

test t27_is_smaller_in_trits_and_larger_in_bits {
    assert K_TRITS_T27 == K_BLOCK * K_CELL_TRITS + K_T27_SCALE_TRITS;
    assert K_TRITS_T27 < K_TRITS_NVFP4;
    assert K_BITS_NVFP4 == K_BLOCK * K_E2M1_BITS + 2 * 8;
    assert K_BITS_NVFP4 < K_BITS_T27_DENSE;
    assert K_BITS_T27_DENSE < K_BITS_E2M2;
}

test the_page_opens_inside_the_line_and_sends_nothing {
    assert K_DEFAULT_X_E3 < 1000;
    assert K_SLIDER_STEPS >= 1000;
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == false;
    assert CATEGORY == "fpga";
    assert SAY_FORMAT_IDS[0] == "T27";
    assert SAY_FORMAT_IDS[3] == "NVFP4";
}


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, issue #10938, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/t27-cell/tool.js (187 lines of hand-written JavaScript).
; The words and numbers above are unchanged. The host protocol is race_the_bee.t27's plus the inputs:
;   w_init(hash)          the page opens: tool.js draws nothing until data.json arrives
;   w_data(i, bytes)      file i of K_DATA_JSON has been fetched; w_data_failed(i) when it could not be
;   w_input(i, text)      input i (0 the number box, 1 the slider, in document order) now holds text
;   w_change(i, text)     the number box lost focus / got Enter (tool.js's "change" listener)
;   w_pointer(fx)         a press or drag on the number line, fx = (clientX - left) / width of the svg
;   w_render(dst)         the page's HTML, length (0 on overflow)
; The state tool.js keeps in DOM nodes is kept here: the weight x, and the two strings the box and the
; slider hold (what the reader typed stays as typed; a slider drag rewrites the box, a typed value
; rewrites the slider). A seat is found, rounded, written and compared exactly as tool.js does it, in
; IEEE doubles, with the number text of js_num.t27 (toFixed, String(x) of the svg coordinates) and
; Number(text) of js_val.t27. Where tool.js throws while it draws (a missing t27 / e2m1 / cell / quality
; / sources object, levels that are no array, a storage row without T27, NVFP4 or E2M2, a ppl that is
; no number) its catch shows SAY_ERR_DATA; so does this page, for the same list of causes (data_ok).
; NOT carried over: levels beyond W_LEVEL_CAP entries; text typed into the number box beyond 255 bytes;
; the pointer events are the host's (host.js grows 'change' and pointer forwarding, see the report).
; MEASURED 2026-10-19: t27c 0.5.2 gen + an 8-function Zig export wrapper + zig build-exe wasm32-freestanding
; ReleaseSmall give a 31401-byte wasm. The original page (tool.js) and this one ran in two happy-dom
; windows against the real 2875-byte data.json and 93 variants of it, 3098 comparisons of tag,
; attributes (the svg coordinates are String(double)) and text: 1057 typed values in the number box (decimals,
; ties, near-midpoint values, 0x10 / 1_0 / Infinity / 1e400 / 5. / .5 / blanks, which happy-dom lets through),
; 515 slider values (in range, out of range, fractional, not a number), 387 change events, 661 presses and
; drags on the line (with the pointer captured and not), and the page before the data arrives and after:
; levels longer / shorter / empty / duplicated / unsorted / not numbers / not an array, other tops (zero,
; string), a cell with 17 or 1e6 codes (Math.log2 printed in full), dense / tensorBits flags, ties in
; trits, bits and perplexity, strings and nulls as counts, an unknown and a duplicated storage id, markup in
; ids, a given and a null permille, 17 data files the page cannot draw (a missing t27, e2m1, cell, storage,
; quality, sources, a null row, no NVFP4 or E2M2 row, a null / string ppl, a string permille or base, a
; root that is an array / null / a number): all of them end on the error line in both, 25 random level
; tables with random storage numbers (17 digits) and 12 sessions of 80 interactions, a 404 and a body
; that is not JSON: 0 differences. A negative control (one table cell of the native DOM changed) is caught.
; Not compared: the real getBoundingClientRect, real pointer capture and a real blur / Enter for change
; (stubbed or synthesised identically on both sides); the stylesheet (happy-dom).

pub const W_DATA_CAP : u32 = 16384;
pub const W_LEVEL_CAP : u32 = 128;
pub var DATA : [16384]u8 = [0; 16384];
pub var DATA_LEN : u32 = 0;
pub var DATA_STATE : u8 = 0;
pub var X : f64 = 0.0;
pub var RANGE_TXT : [256]u8 = [0; 256];
pub var RANGE_LEN : u32 = 0;
pub var BOX_TXT : [256]u8 = [0; 256];
pub var BOX_LEN : u32 = 0;
pub var TL : [128]f64 = [0.0; 128];
pub var TL_N : u32 = 0;
pub var TL_TOP : f64 = 0.0;
pub var EL : [128]f64 = [0.0; 128];
pub var EL_N : u32 = 0;
pub var EL_TOP : f64 = 0.0;

pub fn w_init(h: []const u8) -> u32 {
    DATA_STATE = 0;
    DATA_LEN = 0;
    X = 0.0;
    RANGE_LEN = 0;
    BOX_LEN = 0;
    return 0;
}

fn nullish(d: []const u8, sp: i64) -> bool {
    const k : u8 = kind(d, sp);
    return k == J_NONE or k == J_NULL;
}

/// The storage row whose id is `id` (the first one), NO_SPAN when none.
fn row_of(d: []const u8, st: i64, id: []const u8) -> i64 {
    const cnt : u32 = arr_len(d, st);
    var i : u32 = 0;
    while (i < cnt) {
        const a : i64 = arr_at(d, st, i);
        if (jv_is(d, obj_get(d, a, "id"), id)) { return a; }
        i = i + 1;
    }
    return NO_SPAN;
}

/// Would render() in tool.js get to the end without a TypeError?
fn data_ok(d: []const u8, r: i64) -> bool {
    if (nullish(d, r)) { return false; }
    const t : i64 = obj_get(d, r, "t27");
    const e : i64 = obj_get(d, r, "e2m1");
    if (nullish(d, t) or nullish(d, e)) { return false; }
    if (kind(d, obj_get(d, t, "levels")) != J_ARRAY or kind(d, obj_get(d, e, "levels")) != J_ARRAY) { return false; }
    if (nullish(d, obj_get(d, r, "cell"))) { return false; }
    const st : i64 = obj_get(d, r, "storage");
    if (kind(d, st) != J_ARRAY) { return false; }
    const cnt : u32 = arr_len(d, st);
    var i : u32 = 0;
    while (i < cnt) {
        const a : i64 = arr_at(d, st, i);
        if (nullish(d, a)) { return false; }
        if (kind(d, obj_get(d, a, "ppl")) != J_NUMBER) { return false; }
        i = i + 1;
    }
    const tr : i64 = row_of(d, st, "T27");
    const nv : i64 = row_of(d, st, "NVFP4");
    const e2 : i64 = row_of(d, st, "E2M2");
    if (tr == NO_SPAN or nv == NO_SPAN or e2 == NO_SPAN) { return false; }
    const pm : u8 = kind(d, obj_get(d, nv, "permille"));
    if (pm != J_NONE and pm != J_NULL and pm != J_NUMBER) { return false; }
    const q : i64 = obj_get(d, r, "quality");
    if (nullish(d, q)) { return false; }
    if (kind(d, obj_get(d, q, "base")) != J_NUMBER) { return false; }
    const s : i64 = obj_get(d, r, "sources");
    if (nullish(d, s)) { return false; }
    if (nullish(d, obj_get(d, s, "v1")) or nullish(d, obj_get(d, s, "v2")) or nullish(d, obj_get(d, s, "result"))) { return false; }
    return true;
}

fn steps() -> f64 {
    return K_SLIDER_STEPS as f64;
}

fn finite(v: f64) -> bool {
    return v == v and (v - v) == 0.0;
}

fn set_text(buf: []u8, s: []const u8) -> u32 {
    var n : u32 = 0;
    while (n < (s.len as u32) and n < 255) {
        buf[n as usize] = s[n as usize];
        n = n + 1;
    }
    return n;
}

/// tool.js set(v, from): from 0 = null, 1 = the slider, 2 = the box. Not finite: nothing changes.
fn set_x(v: f64, from: u32) -> u32 {
    if (!finite(v)) { return 0; }
    const x : f64 = js_max(0.0 - 1.0, js_min(1.0, v));
    X = x;
    var tmp : [64]u8 = [0; 64];
    if (from != 1) {
        const l : u32 = js_str_num(tmp[0..], 0, js_round((x * steps()) / 2.0));
        RANGE_LEN = set_text(RANGE_TXT[0..], tmp[0..(l as usize)]);
    }
    if (from != 2) {
        const l2 : u32 = js_to_fixed(tmp[0..], 0, x, 3);
        BOX_LEN = set_text(BOX_TXT[0..], tmp[0..(l2 as usize)]);
    }
    return 0;
}

pub fn w_data(i: u32, s: []const u8) -> u32 {
    if (s.len > (W_DATA_CAP as usize)) {
        DATA_STATE = 2;
        return 0;
    }
    var k : usize = 0;
    while (k < s.len) {
        DATA[k] = s[k];
        k = k + 1;
    }
    DATA_LEN = s.len as u32;
    DATA_STATE = 1;
    const d : []const u8 = DATA[0..(DATA_LEN as usize)];
    if (!jv_valid(d)) {
        DATA_STATE = 2;
        return 0;
    }
    const r : i64 = root(d);
    if (!data_ok(d, r)) {
        DATA_STATE = 2;
        return 0;
    }
    const t : i64 = obj_get(d, r, "t27");
    const e : i64 = obj_get(d, r, "e2m1");
    TL_N = arr_len(d, obj_get(d, t, "levels"));
    if (TL_N > W_LEVEL_CAP) { TL_N = W_LEVEL_CAP; }
    var j : u32 = 0;
    while (j < TL_N) {
        TL[j as usize] = jv_num(d, arr_at(d, obj_get(d, t, "levels"), j));
        j = j + 1;
    }
    TL_TOP = jv_num(d, obj_get(d, t, "top"));
    EL_N = arr_len(d, obj_get(d, e, "levels"));
    if (EL_N > W_LEVEL_CAP) { EL_N = W_LEVEL_CAP; }
    j = 0;
    while (j < EL_N) {
        EL[j as usize] = jv_num(d, arr_at(d, obj_get(d, e, "levels"), j));
        j = j + 1;
    }
    EL_TOP = jv_num(d, obj_get(d, e, "top"));
    set_x((K_DEFAULT_X_E3 as f64) / 1000.0, 0);
    return 0;
}

pub fn w_data_failed(i: u32) -> u32 {
    DATA_STATE = 2;
    return 0;
}

pub fn w_input(i: u32, s: []const u8) -> u32 {
    if (DATA_STATE != 1) { return 0; }
    if (i == 1) {
        RANGE_LEN = set_text(RANGE_TXT[0..], s);
        set_x((jv_number_of_text(s, s.len as u32) * 2.0) / steps(), 1);
    }
    if (i == 0) {
        BOX_LEN = set_text(BOX_TXT[0..], s);
        // if (box.value.trim() !== '') set(Number(box.value), 'box')
        var blank : bool = true;
        var k : u32 = 0;
        const l : u32 = s.len as u32;
        while (k < l) {
            const w : u32 = jv_ws_at(s, k, l);
            if (w == 0) { blank = false; break; }
            k = k + w;
        }
        if (!blank) { set_x(jv_number_of_text(s, l), 2); }
    }
    return 0;
}

pub fn w_change(i: u32, s: []const u8) -> u32 {
    if (DATA_STATE != 1) { return 0; }
    if (i == 0) { set_x(jv_number_of_text(s, s.len as u32), 0); }
    return 0;
}

pub fn w_pointer(fx: f64) -> u32 {
    if (DATA_STATE != 1) { return 0; }
    const px : f64 = fx * 1000.0;
    set_x((((px - 24.0) / 952.0) * 2.0) - 1.0, 0);
    return 0;
}

pub fn w_click(i: u32) -> u32 {
    return 0;
}

// --- the grids ----------------------------------------------------------------------------------

fn tl_at(i: u32) -> f64 {
    if (i >= TL_N) { return js_nan(0.0); }
    return TL[i as usize];
}

fn el_at(i: u32) -> f64 {
    if (i >= EL_N) { return js_nan(0.0); }
    return EL[i as usize];
}

fn fabs(v: f64) -> f64 {
    if (v < 0.0) { return 0.0 - v; }
    return v;
}

/// Nearest magnitude in an ascending table; a tie keeps the smaller magnitude.
fn nearest(tab: bool, a: f64) -> u32 {
    var top : f64 = EL_TOP;
    var n : u32 = EL_N;
    if (tab) {
        top = TL_TOP;
        n = TL_N;
    }
    const t : f64 = js_min(a, 1.0) * top;
    var k : u32 = 0;
    var i : u32 = 1;
    while (i < n) {
        var li : f64 = el_at(i);
        var lk : f64 = el_at(k);
        if (tab) {
            li = tl_at(i);
            lk = tl_at(k);
        }
        if (fabs(t - li) < fabs(t - lk)) { k = i; }
        i = i + 1;
    }
    return k;
}

pub var R_NEG : bool = false;
pub var R_KT : u32 = 0;
pub var R_KE : u32 = 0;
pub var R_QT : f64 = 0.0;
pub var R_QE : f64 = 0.0;
pub var R_ERR_T : f64 = 0.0;
pub var R_ERR_E : f64 = 0.0;

/// roundBoth(d, x): the seat each format rounds x to, its error.
fn round_both(x: f64) -> u32 {
    const a : f64 = fabs(x);
    const neg : bool = x < 0.0;
    var sgn : f64 = 1.0;
    if (neg) { sgn = 0.0 - 1.0; }
    R_NEG = neg;
    R_KT = nearest(true, a);
    R_KE = nearest(false, a);
    R_QT = (sgn * tl_at(R_KT)) / TL_TOP;
    R_QE = (sgn * el_at(R_KE)) / EL_TOP;
    R_ERR_T = fabs(x - R_QT);
    R_ERR_E = fabs(x - R_QE);
    return 0;
}

/// num(v): v.toFixed(K_DIGITS), -0 as 0.
fn num_text(dst: []u8, n0: u32, v: f64) -> u32 {
    if (v == 0.0) { return js_to_fixed(dst, n0, 0.0, K_DIGITS as u32); }
    return js_to_fixed(dst, n0, v, K_DIGITS as u32);
}

fn signed_text(dst: []u8, n0: u32, v: f64) -> u32 {
    var n : u32 = n0;
    if (v > 0.0) { n = put(dst, n, 43); }
    return num_text(dst, n, v);
}

/// tritsOf(c): three balanced-ternary glyphs, most significant first. The digits of -c are the negated digits
/// of c, so they are found on the magnitude (no signed remainder).
fn trits_of(dst: []u8, n0: u32, c: i64) -> u32 {
    var m : u64 = 0;
    if (c >= 0) { m = c as u64; } else { m = (0 - c) as u64; }
    var g : [3]u32 = [0; 3];
    var i : usize = 0;
    while (i < 3) {
        const r : u64 = m % 3;
        if (r == 2) {
            g[i] = 0;
            m = (m + 1) / 3;
        } else {
            g[i] = (r as u32) + 1;
            m = m / 3;
        }
        if (c < 0) { g[i] = 2 - g[i]; }
        i = i + 1;
    }
    var n : u32 = n0;
    n = text(dst, n, SAY_TRIT_GLYPHS[g[2] as usize]);
    n = text(dst, n, SAY_TRIT_GLYPHS[g[1] as usize]);
    return text(dst, n, SAY_TRIT_GLYPHS[g[0] as usize]);
}

/// errText(e): fill(SAY_ERR, num(e), (e / |x| * 100).toFixed(1)), or SAY_ERR_ZERO when x is 0.
fn err_text(dst: []u8, n0: u32, e: f64, x: f64) -> u32 {
    var vb : [256]u8 = [0; 256];
    var tmp : [128]u8 = [0; 128];
    const l : u32 = num_text(tmp[0..], 0, e);
    var vn : u32 = jv_vput_str(vb[0..], 0, "0", tmp[0..(l as usize)]);
    if (x == 0.0) { return jv_fill(dst, n0, SAY_ERR_ZERO, vb[0..], vn, true); }
    vn = jv_vput_fixed(vb[0..], vn, "1", (e / fabs(x)) * 100.0, 1);
    return jv_fill(dst, n0, SAY_ERR, vb[0..], vn, true);
}

fn t27_code(dst: []u8, n0: u32) -> u32 {
    var vb : [128]u8 = [0; 128];
    var tr : [16]u8 = [0; 16];
    const tl : u32 = trits_of(tr[0..], 0, if_neg(R_KT));
    var vn : u32 = jv_vput_str(vb[0..], 0, "0", tr[0..(tl as usize)]);
    var sg : [32]u8 = [0; 32];
    var sl : u32 = 0;
    const ct : i64 = if_neg(R_KT);
    var cabs : u64 = 0;
    if (ct < 0) {
        sg[0] = 45;
        sl = 1;
        cabs = (0 - ct) as u64;
    } else {
        cabs = ct as u64;
        if (ct > 0) {
            sg[0] = 43;
            sl = 1;
        }
    }
    var nb : [24]u8 = [0; 24];
    const dl : u32 = jn_digits(nb[0..], cabs);
    var q : u32 = dl;
    while (q > 0) {
        q = q - 1;
        sg[sl as usize] = nb[q as usize] + 48;
        sl = sl + 1;
    }
    vn = jv_vput_str(vb[0..], vn, "1", sg[0..(sl as usize)]);
    return jv_fill(dst, n0, SAY_CODE_T27, vb[0..], vn, true);
}

/// ct = (neg ? -1 : 1) * kt
fn if_neg(kt: u32) -> i64 {
    if (R_NEG) { return 0 - (kt as i64); }
    return kt as i64;
}

fn e2m1_code(dst: []u8, n0: u32) -> u32 {
    var bits : [24]u8 = [0; 24];
    var bl : u32 = 0;
    var tmpb : [24]u8 = [0; 24];
    var kk : u32 = R_KE;
    var tl : u32 = 0;
    if (kk == 0) {
        tmpb[0] = 48;
        tl = 1;
    }
    while (kk > 0) {
        tmpb[tl as usize] = ((kk % 2) as u8) + 48;
        kk = kk / 2;
        tl = tl + 1;
    }
    // padStart(3, '0')
    while (bl + tl < 3) {
        bits[bl as usize] = 48;
        bl = bl + 1;
    }
    while (tl > 0) {
        tl = tl - 1;
        bits[bl as usize] = tmpb[tl as usize];
        bl = bl + 1;
    }
    var sgn : [1]u8 = [48; 1];
    if (R_NEG) { sgn[0] = 49; }
    var full : [32]u8 = [0; 32];
    full[0] = sgn[0];
    var q : u32 = 0;
    while (q < bl) {
        full[(q + 1) as usize] = bits[q as usize];
        q = q + 1;
    }
    var h : u32 = 2;
    if (bl < 2) { h = bl; }
    var vb : [128]u8 = [0; 128];
    var vn : u32 = jv_vput_str(vb[0..], 0, "0", full[0..((bl + 1) as usize)]);
    vn = jv_vput_str(vb[0..], vn, "1", sgn[0..1]);
    vn = jv_vput_str(vb[0..], vn, "2", bits[0..(h as usize)]);
    vn = jv_vput_str(vb[0..], vn, "3", bits[(h as usize)..(bl as usize)]);
    return jv_fill(dst, n0, SAY_CODE_E2M1, vb[0..], vn, true);
}

/// X(v): the svg x of weight v.
fn sx(v: f64) -> f64 {
    return 24.0 + ((v + 1.0) / 2.0) * 952.0;
}

fn put_num_attr(dst: []u8, n0: u32, name: []const u8, v: f64) -> u32 {
    var n : u32 = put(dst, n0, 32);
    n = raw(dst, n, name);
    n = raw(dst, n, "=\"");
    n = js_str_num(dst, n, v);
    return put(dst, n, 34);
}

fn tick_t27(dst: []u8, n0: u32, v: f64) -> u32 {
    var n : u32 = raw(dst, n0, "<line");
    n = put_num_attr(dst, n, "x1", sx(v));
    n = put_num_attr(dst, n, "x2", sx(v));
    return raw(dst, n, " y1=\"36\" y2=\"66\" class=\"tc-tick-t27\"></line>");
}

fn tick_e2(dst: []u8, n0: u32, v: f64) -> u32 {
    var n : u32 = raw(dst, n0, "<line");
    n = put_num_attr(dst, n, "x1", sx(v));
    n = put_num_attr(dst, n, "x2", sx(v));
    return raw(dst, n, " y1=\"74\" y2=\"104\" class=\"tc-tick-e2\"></line>");
}

fn svg_html(dst: []u8, n0: u32) -> u32 {
    var n : u32 = raw(dst, n0, "<svg viewBox=\"0 0 1000 140\" class=\"tc-line\" role=\"img\"");
    n = attr(dst, n, "aria-label", SAY_LINE_TITLE);
    n = raw(dst, n, "><line x1=\"24\" x2=\"976\" y1=\"70\" y2=\"70\" class=\"tc-axis\"></line>");
    // t27Seats: the negated magnitudes from the top down, 0, then the magnitudes
    var i : u32 = TL_N;
    while (i > 1) {
        i = i - 1;
        n = tick_t27(dst, n, 0.0 - (tl_at(i) / TL_TOP));
    }
    n = tick_t27(dst, n, 0.0);
    i = 1;
    while (i < TL_N) {
        n = tick_t27(dst, n, tl_at(i) / TL_TOP);
        i = i + 1;
    }
    i = EL_N;
    while (i > 1) {
        i = i - 1;
        n = tick_e2(dst, n, 0.0 - (el_at(i) / EL_TOP));
    }
    n = tick_e2(dst, n, 0.0);
    i = 1;
    while (i < EL_N) {
        n = tick_e2(dst, n, el_at(i) / EL_TOP);
        i = i + 1;
    }
    n = raw(dst, n, "<text x=\"24\" y=\"134\" class=\"tc-lab\" text-anchor=\"start\">-1</text>");
    n = raw(dst, n, "<text x=\"500\" y=\"134\" class=\"tc-lab\" text-anchor=\"middle\">0</text>");
    n = raw(dst, n, "<text x=\"976\" y=\"134\" class=\"tc-lab\" text-anchor=\"end\">1</text>");
    round_both(X);
    n = raw(dst, n, "<line y1=\"8\" y2=\"116\" class=\"tc-cursor\"");
    n = put_num_attr(dst, n, "x1", sx(X));
    n = put_num_attr(dst, n, "x2", sx(X));
    n = raw(dst, n, "></line><circle r=\"9\" cy=\"30\" class=\"tc-hit-t27\"");
    n = put_num_attr(dst, n, "cx", sx(R_QT));
    n = raw(dst, n, "></circle><circle r=\"9\" cy=\"110\" class=\"tc-hit-e2\"");
    n = put_num_attr(dst, n, "cx", sx(R_QE));
    return raw(dst, n, "></circle></svg>");
}

/// The result rows and the sentences under the table, from the weight X.
fn result_table(dst: []u8, n0: u32) -> u32 {
    round_both(X);
    var n : u32 = raw(dst, n0, "<div class=\"tc-scroll\"><table class=\"tc-result\"><thead><tr>");
    var h : usize = 0;
    while (h < SAY_RESULT_HEAD.len) {
        n = raw(dst, n, "<th>");
        n = text(dst, n, SAY_RESULT_HEAD[h]);
        n = raw(dst, n, "</th>");
        h = h + 1;
    }
    n = raw(dst, n, "</tr></thead><tbody><tr class=\"tc-r-t27\"><th scope=\"row\">");
    n = text(dst, n, SAY_FORMAT_SHORT[0]);
    n = raw(dst, n, "</th><td>");
    n = signed_text(dst, n, R_QT);
    n = raw(dst, n, "</td><td>");
    n = t27_code(dst, n);
    n = raw(dst, n, "</td><td>");
    n = err_text(dst, n, R_ERR_T, X);
    n = raw(dst, n, "</td></tr><tr class=\"tc-r-e2\"><th scope=\"row\">");
    n = text(dst, n, SAY_FORMAT_SHORT[1]);
    n = raw(dst, n, "</th><td>");
    n = signed_text(dst, n, R_QE);
    n = raw(dst, n, "</td><td>");
    n = e2m1_code(dst, n);
    n = raw(dst, n, "</td><td>");
    n = err_text(dst, n, R_ERR_E, X);
    n = raw(dst, n, "</td></tr></tbody></table></div>");
    // the closer
    const diff : f64 = R_ERR_E - R_ERR_T;
    var win : []const u8 = "e2";
    if (diff > 0.0) { win = "t27"; }
    if (fabs(diff) < 0.000000000001) { win = "tie"; }
    n = raw(dst, n, "<p class=\"tc-closer\"");
    n = attr(dst, n, "data-win", win);
    n = raw(dst, n, ">");
    if (fabs(diff) < 0.000000000001) {
        n = text(dst, n, SAY_CLOSER[2]);
    } else {
        var vb : [128]u8 = [0; 128];
        var tmp : [64]u8 = [0; 64];
        const l : u32 = num_text(tmp[0..], 0, fabs(diff));
        const vn : u32 = jv_vput_str(vb[0..], 0, "0", tmp[0..(l as usize)]);
        if (diff > 0.0) { n = jv_fill(dst, n, SAY_CLOSER[0], vb[0..], vn, true); } else { n = jv_fill(dst, n, SAY_CLOSER[1], vb[0..], vn, true); }
    }
    // the gap that holds the weight
    const a : f64 = fabs(X);
    var s : f64 = 1.0;
    if (X < 0.0) { s = 0.0 - 1.0; }
    var hi : i32 = 0 - 1;
    var i : u32 = 0;
    while (i < EL_N and hi < 0) {
        if ((el_at(i) / EL_TOP) > a) { hi = i as i32; }
        i = i + 1;
    }
    if (hi < 0) { hi = (EL_N as i32) - 1; }
    const lo : i32 = hi - 1;
    var mlo : f64 = js_nan(0.0);
    var mhi : f64 = js_nan(0.0);
    if (lo >= 0 and lo < (EL_N as i32)) { mlo = el_at(lo as u32) / EL_TOP; }
    if (hi >= 0 and hi < (EL_N as i32)) { mhi = el_at(hi as u32) / EL_TOP; }
    var inside : u32 = 0;
    i = 0;
    while (i < TL_N) {
        const lv : f64 = tl_at(i) / TL_TOP;
        if (lv > mlo and lv < mhi) { inside = inside + 1; }
        i = i + 1;
    }
    n = raw(dst, n, "</p><p class=\"tc-note\">");
    var gb : [256]u8 = [0; 256];
    var tg : [64]u8 = [0; 64];
    var gl : u32 = num_text(tg[0..], 0, s * mlo);
    var gn : u32 = jv_vput_str(gb[0..], 0, "0", tg[0..(gl as usize)]);
    gl = num_text(tg[0..], 0, s * mhi);
    gn = jv_vput_str(gb[0..], gn, "1", tg[0..(gl as usize)]);
    gn = jv_vput_f64(gb[0..], gn, "2", inside as f64);
    n = jv_fill(dst, n, SAY_GAP, gb[0..], gn, true);
    return n;
}

fn is_best_num(d: []const u8, v: i64, best: f64) -> bool {
    return kind(d, v) == J_NUMBER and jv_num(d, v) == best;
}

fn bar_html(dst: []u8, n0: u32, v: f64, mx: f64, best: bool) -> u32 {
    var n : u32 = raw(dst, n0, "<span class=\"tc-bar");
    if (best) { n = raw(dst, n, " is-best"); }
    n = raw(dst, n, "\"><span class=\"tc-bar-fill\" style=\"width:");
    n = js_to_fixed(dst, n, (v / mx) * 100.0, 1);
    return raw(dst, n, "%\"></span></span>");
}

fn storage_html(dst: []u8, n0: u32, d: []const u8, r: i64) -> u32 {
    const st : i64 = obj_get(d, r, "storage");
    const cnt : u32 = arr_len(d, st);
    var maxt : f64 = 0.0 - js_inf(0.0);
    var maxb : f64 = 0.0 - js_inf(0.0);
    var mint : f64 = js_inf(0.0);
    var minb : f64 = js_inf(0.0);
    var minp : f64 = js_inf(0.0);
    var i : u32 = 0;
    while (i < cnt) {
        const a : i64 = arr_at(d, st, i);
        const ta : f64 = jv_num(d, obj_get(d, a, "trits"));
        const ba : f64 = jv_num(d, obj_get(d, a, "bits"));
        maxt = js_max(maxt, ta);
        maxb = js_max(maxb, ba);
        mint = js_min(mint, ta);
        minb = js_min(minb, ba);
        minp = js_min(minp, jv_num(d, obj_get(d, a, "ppl")));
        i = i + 1;
    }
    var n : u32 = raw(dst, n0, "<h2>");
    n = text(dst, n, SAY_STORE_TITLE);
    n = raw(dst, n, "</h2><div class=\"tc-scroll\"><table class=\"tc-store\"><thead><tr>");
    var h : usize = 0;
    while (h < SAY_STORE_HEAD.len) {
        n = raw(dst, n, "<th>");
        n = text(dst, n, SAY_STORE_HEAD[h]);
        n = raw(dst, n, "</th>");
        h = h + 1;
    }
    n = raw(dst, n, "</tr></thead><tbody>");
    i = 0;
    while (i < cnt) {
        const a : i64 = arr_at(d, st, i);
        const id : i64 = obj_get(d, a, "id");
        const tv : i64 = obj_get(d, a, "trits");
        const bv : i64 = obj_get(d, a, "bits");
        const pv : i64 = obj_get(d, a, "ppl");
        n = raw(dst, n, "<tr class=\"");
        if (jv_is(d, id, "T27")) { n = raw(dst, n, "tc-r-t27"); }
        n = raw(dst, n, "\"><th scope=\"row\">");
        var fi : i32 = 0 - 1;
        var fq : usize = 0;
        while (fq < SAY_FORMAT_IDS.len) {
            if (jv_is(d, id, SAY_FORMAT_IDS[fq])) { fi = fq as i32; break; }
            fq = fq + 1;
        }
        if (fi >= 0) { n = text(dst, n, SAY_FORMAT_NAMES[fi as usize]); }
        n = raw(dst, n, "</th><td><span class=\"tc-v");
        const bt : bool = is_best_num(d, tv, mint);
        if (bt) { n = raw(dst, n, " is-best"); }
        n = raw(dst, n, "\">");
        n = jv_text(dst, n, d, tv);
        n = raw(dst, n, "</span>");
        n = bar_html(dst, n, jv_num(d, tv), maxt, bt);
        n = raw(dst, n, "</td><td><span class=\"tc-v");
        const bb : bool = is_best_num(d, bv, minb);
        if (bb) { n = raw(dst, n, " is-best"); }
        n = raw(dst, n, "\">");
        var vb : [512]u8 = [0; 512];
        var vn : u32 = jv_vput_val(vb[0..], 0, "0", d, bv);
        if (jv_truthy(d, obj_get(d, a, "dense"))) {
            n = jv_fill(dst, n, SAY_BITS_DENSE, vb[0..], vn, true);
        } else {
            if (jv_truthy(d, obj_get(d, a, "tensorBits"))) {
                vn = jv_vput_val(vb[0..], vn, "1", d, obj_get(d, a, "tensorBits"));
                n = jv_fill(dst, n, SAY_BITS_TENSOR, vb[0..], vn, true);
            } else {
                n = jv_text(dst, n, d, bv);
            }
        }
        n = raw(dst, n, "</span>");
        n = bar_html(dst, n, jv_num(d, bv), maxb, bb);
        n = raw(dst, n, "</td><td><span class=\"tc-v");
        if (is_best_num(d, pv, minp)) { n = raw(dst, n, " is-best"); }
        n = raw(dst, n, "\">");
        n = js_to_fixed(dst, n, jv_num(d, pv), 4);
        n = raw(dst, n, "</span></td></tr>");
        i = i + 1;
    }
    const ql : i64 = obj_get(d, r, "quality");
    n = raw(dst, n, "<tr class=\"tc-r-base\"><th scope=\"row\">");
    n = text(dst, n, SAY_BASE_ROW);
    n = raw(dst, n, "</th><td></td><td></td><td><span class=\"tc-v\">");
    n = js_to_fixed(dst, n, num_of(d, ql, "base"), 4);
    n = raw(dst, n, "</span></td></tr></tbody></table></div>");
    const t : i64 = row_of(d, st, "T27");
    const nv : i64 = row_of(d, st, "NVFP4");
    const e2 : i64 = row_of(d, st, "E2M2");
    var pb : [512]u8 = [0; 512];
    var pn : u32 = jv_vput_val(pb[0..], 0, "0", d, obj_get(d, t, "trits"));
    pn = jv_vput_val(pb[0..], pn, "1", d, obj_get(d, nv, "trits"));
    n = raw(dst, n, "<p class=\"tc-say\">");
    n = jv_fill(dst, n, SAY_STORE_TRITS, pb[0..], pn, true);
    n = raw(dst, n, "</p><p class=\"tc-say\">");
    pn = jv_vput_val(pb[0..], 0, "0", d, obj_get(d, t, "bits"));
    pn = jv_vput_val(pb[0..], pn, "1", d, obj_get(d, nv, "bits"));
    const tb : f64 = num_of(d, t, "bits");
    const nb : f64 = num_of(d, nv, "bits");
    pn = jv_vput_fixed(pb[0..], pn, "2", ((tb - nb) / nb) * 100.0, 1);
    n = jv_fill(dst, n, SAY_STORE_BITS, pb[0..], pn, true);
    n = raw(dst, n, "</p><p class=\"tc-note\">");
    pn = jv_vput_val(pb[0..], 0, "0", d, obj_get(d, ql, "nwin"));
    pn = jv_vput_val(pb[0..], pn, "1", d, obj_get(d, ql, "seqlen"));
    const pm : i64 = obj_get(d, nv, "permille");
    var permille : f64 = 0.0;
    if (nullish(d, pm)) { permille = (1000.0 * num_of(d, t, "ppl")) / num_of(d, nv, "ppl"); } else { permille = jv_num(d, pm); }
    pn = jv_vput_fixed(pb[0..], pn, "2", permille, 1);
    pn = jv_vput_fixed(pb[0..], pn, "3", num_of(d, e2, "ppl"), 4);
    pn = jv_vput_fixed(pb[0..], pn, "4", num_of(d, t, "ppl"), 4);
    n = jv_fill(dst, n, SAY_QUALITY, pb[0..], pn, true);
    return raw(dst, n, "</p>");
}

fn num_of(d: []const u8, sp: i64, key: []const u8) -> f64 {
    return jv_num(d, obj_get(d, sp, key));
}

fn limits_html(dst: []u8, n0: u32, d: []const u8, r: i64) -> u32 {
    var n : u32 = raw(dst, n0, "<h2>");
    n = text(dst, n, SAY_LIMITS_TITLE);
    n = raw(dst, n, "</h2><ul class=\"tc-limits\">");
    var i : usize = 0;
    while (i < SAY_LIMITS.len) {
        n = raw(dst, n, "<li>");
        n = text(dst, n, SAY_LIMITS[i]);
        n = raw(dst, n, "</li>");
        i = i + 1;
    }
    const s : i64 = obj_get(d, r, "sources");
    const v1 : i64 = obj_get(d, s, "v1");
    const v2 : i64 = obj_get(d, s, "v2");
    const rs : i64 = obj_get(d, s, "result");
    var vb : [1024]u8 = [0; 1024];
    var vn : u32 = jv_vput_val(vb[0..], 0, "0", d, obj_get(d, v1, "file"));
    vn = jv_vput_val(vb[0..], vn, "1", d, obj_get(d, v1, "commit"));
    vn = jv_vput_val(vb[0..], vn, "2", d, obj_get(d, v2, "file"));
    vn = jv_vput_val(vb[0..], vn, "3", d, obj_get(d, v2, "commit"));
    vn = jv_vput_val(vb[0..], vn, "4", d, obj_get(d, rs, "file"));
    vn = jv_vput_val(vb[0..], vn, "5", d, obj_get(d, rs, "commit"));
    n = raw(dst, n, "</ul><p class=\"tc-note tc-subtle\">");
    n = jv_fill(dst, n, SAY_SOURCES, vb[0..], vn, true);
    return raw(dst, n, "</p>");
}

/// The page, as tool.js leaves it: nothing before the data, the error line when it failed or was unusable.
pub fn w_render(dst: []u8) -> u32 {
    var n : u32 = 0;
    if (DATA_STATE == 0) { return 0; }
    if (DATA_STATE == 2) {
        n = raw(dst, n, "<p class=\"tc-err\">");
        n = text(dst, n, SAY_ERR_DATA);
        n = raw(dst, n, "</p>");
        if (!ok(n)) { return 0; }
        return n;
    }
    const d : []const u8 = DATA[0..(DATA_LEN as usize)];
    const r : i64 = root(d);
    const cell : i64 = obj_get(d, r, "cell");
    const e2m1 : i64 = obj_get(d, r, "e2m1");
    n = raw(dst, n, "<p class=\"tc-claim\">");
    n = text(dst, n, SAY_CLAIM);
    n = raw(dst, n, "</p><div class=\"tc-cells\"><p class=\"tc-cell tc-cell-t27\">");
    var vb : [512]u8 = [0; 512];
    var vn : u32 = jv_vput_val(vb[0..], 0, "0", d, obj_get(d, cell, "trits"));
    vn = jv_vput_val(vb[0..], vn, "1", d, obj_get(d, cell, "codes"));
    vn = jv_vput_val(vb[0..], vn, "2", d, obj_get(d, cell, "mags"));
    vn = jv_vput_fixed(vb[0..], vn, "3", js_log2(num_of(d, cell, "codes")), 2);
    n = jv_fill(dst, n, SAY_CELL_T27, vb[0..], vn, true);
    n = raw(dst, n, "</p><p class=\"tc-cell\">");
    vn = jv_vput_f64(vb[0..], 0, "0", js_log2(num_of(d, e2m1, "codes")));
    vn = jv_vput_val(vb[0..], vn, "1", d, obj_get(d, e2m1, "codes"));
    vn = jv_vput_val(vb[0..], vn, "2", d, obj_get(d, e2m1, "distinct"));
    vn = jv_vput_f64(vb[0..], vn, "3", num_of(d, cell, "codes") - num_of(d, e2m1, "codes"));
    n = jv_fill(dst, n, SAY_CELL_E2M1, vb[0..], vn, true);
    n = raw(dst, n, "</p></div><section class=\"tc-sec\"><h2>");
    n = text(dst, n, SAY_LINE_TITLE);
    n = raw(dst, n, "</h2><p class=\"tc-note\">");
    n = text(dst, n, SAY_LINE_NOTE);
    n = raw(dst, n, "</p><div class=\"tc-legend\"><span class=\"tc-key tc-key-t27\">");
    n = text(dst, n, SAY_ROW_NAMES[0]);
    n = raw(dst, n, "</span><span class=\"tc-key tc-key-e2\">");
    n = text(dst, n, SAY_ROW_NAMES[1]);
    n = raw(dst, n, "</span></div>");
    n = svg_html(dst, n);
    n = raw(dst, n, "<div class=\"tc-controls\"><label class=\"tc-label\" for=\"tc-x\">");
    n = text(dst, n, SAY_INPUT_LABEL);
    n = raw(dst, n, "</label><input type=\"number\" min=\"-1\" max=\"1\" step=\"");
    n = js_str_num(dst, n, 2.0 / steps());
    n = raw(dst, n, "\" class=\"tc-num\" inputmode=\"decimal\" id=\"tc-x\"");
    n = attr(dst, n, "value", BOX_TXT[0..(BOX_LEN as usize)]);
    n = raw(dst, n, "><input type=\"range\" min=\"");
    n = js_str_num(dst, n, (0.0 - steps()) / 2.0);
    n = raw(dst, n, "\" max=\"");
    n = js_str_num(dst, n, steps() / 2.0);
    n = raw(dst, n, "\" step=\"1\" class=\"tc-range\"");
    n = attr(dst, n, "aria-label", SAY_INPUT_LABEL);
    n = attr(dst, n, "value", RANGE_TXT[0..(RANGE_LEN as usize)]);
    n = raw(dst, n, "></div>");
    n = result_table(dst, n);
    n = raw(dst, n, "</p><p class=\"tc-note tc-subtle\">");
    n = text(dst, n, SAY_ROUND_NOTE);
    n = raw(dst, n, "</p></section><section class=\"tc-sec\">");
    n = storage_html(dst, n, d, r);
    n = raw(dst, n, "</section><section class=\"tc-sec\">");
    n = limits_html(dst, n, d, r);
    n = raw(dst, n, "</section>");
    if (!ok(n)) { return 0; }
    return n;
}

/// The splicer follows only the names a module itself mentions, not the names the imported functions
/// mention. This anchor mentions every helper the writer, the JSON reader and the number rules call.
/// Never called.
pub fn imports_anchor(o: []u8, s: []const u8) -> u32 {
    var n : u32 = 0;
    n = n + (ok(0) as u32);
    n = n + OVER;
    n = n + put(o, 0, 0);
    n = n + raw(o, 0, s);
    n = n + put_escaped(o, 0, 0);
    n = n + text(o, 0, s);
    n = n + num(o, 0, 0);
    n = n + attr(o, 0, s, s);
    n = n + fill(o, 0, s, s, s, s, 0);
    n = n + fill_named(o, 0, s, s, s, s, s, s, s, s, s, s, s, s, s);
    n = n + dec_to(o, 0);
    n = n + (name_is(s, 0, 0, s) as u32);
    n = n + (is_word_byte(0) as u32);
    n = n + (H_LT as u32);
    n = n + (H_GT as u32);
    n = n + (H_AMP as u32);
    n = n + (H_QUOTE as u32);
    n = n + (H_APOS as u32);
    n = n + (H_SPACE as u32);
    n = n + (H_SLASH as u32);
    n = n + (H_EQ as u32);
    n = n + ((NO_SPAN < 0) as u32);
    n = n + ((SPAN > 0) as u32);
    n = n + (J_NONE as u32);
    n = n + (J_OBJECT as u32);
    n = n + (J_ARRAY as u32);
    n = n + (J_STRING as u32);
    n = n + (J_NUMBER as u32);
    n = n + (J_TRUE as u32);
    n = n + (J_FALSE as u32);
    n = n + (J_NULL as u32);
    n = n + (jspan(0, 0) as u32);
    n = n + (span_lo(0) as u32);
    n = n + (span_hi(0) as u32);
    n = n + (skip_ws(s, 0) as u32);
    n = n + (string_end(s, 0) as u32);
    n = n + (value_end(s, 0) as u32);
    n = n + (root(s) as u32);
    n = n + (kind(s, 0) as u32);
    n = n + (key_is(s, 0, 0, s) as u32);
    n = n + (obj_get(s, 0, s) as u32);
    n = n + arr_len(s, 0);
    n = n + (arr_at(s, 0, 0) as u32);
    n = n + hex4(s, 0);
    n = n + escape_at(s, 0, 0);
    n = n + cp_utf8_len(0);
    n = n + (cp_utf8_byte(0, 0) as u32);
    n = n + str_len(s, 0);
    n = n + (str_byte(s, 0, 0) as u32);
    n = n + JN_OVER;
    n = n + JN_CAP;
    n = n + ((JN_TWO52 > 0.0) as u32);
    n = n + ((JN_TWO53 > 0.0) as u32);
    n = n + jn_put(o, 0, 0);
    n = n + jn_raw(o, 0, s);
    n = n + jn_digits(o, 0);
    n = n + jn_mul(o, 0, 0);
    n = n + jn_mul2(o, 0, 0);
    n = n + jn_mul5(o, 0, 0);
    n = n + jn_shift(o, 0, 0);
    n = n + (jn_cmp(s, s, 0) as u32);
    n = n + (jn_expo(0.0) as u32);
    n = n + (jn_mant(0.0) as u32);
    n = n + ((jn_make(0, 0) > 0.0) as u32);
    n = n + jn_exact(o, 0, 0);
    n = n + jn_fscale(0);
    n = n + (js_is_nan(0.0) as u32);
    n = n + ((js_nan(0.0) > 0.0) as u32);
    n = n + ((js_inf(1.0) > 0.0) as u32);
    n = n + ((js_floor(0.0) > 0.0) as u32);
    n = n + ((js_ceil(0.0) > 0.0) as u32);
    n = n + ((js_max(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_min(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_round(0.0) > 0.0) as u32);
    n = n + (jn_shortest(o, 1.0) as u32);
    n = n + jn_copy(o, s, 0);
    n = n + jn_put_run(o, 0, s, 0, 0);
    n = n + jn_layout(o, 0, s, 0, 0);
    n = n + js_str_num(o, 0, 0.0);
    n = n + js_to_fixed(o, 0, 0.0, 0);
    n = n + js_locale_num(o, 0, 0.0);
    n = n + (jn_num_ok(s, 0, 0) as u32);
    n = n + (jn_cmp_text(s, 0, 0, 0, 0) as u32);
    n = n + ((js_parse_num(s, 0, 0) > 0.0) as u32);
    n = n + ((jn_dec_value(s, 0, 0) > 0.0) as u32);
    n = n + (jn_abs(0) as u32);
    n = n + js_str_u64(o, 0, 0);
    n = n + jv_str_to(o, 0, s, 0);
    n = n + jv_text_str(o, 0, s, 0);
    n = n + ((jv_numval(s, 0) > 0.0) as u32);
    n = n + jv_str(o, 0, s, 0);
    n = n + jv_text(o, 0, s, 0);
    n = n + (jv_is(s, 0, s) as u32);
    n = n + (jv_truthy(s, 0) as u32);
    n = n + (jv_is_ws(0) as u32);
    n = n + ((jv_number_of_text(s, 0) > 0.0) as u32);
    n = n + ((jv_num(s, 0) > 0.0) as u32);
    n = n + jv_vput_str(o, 0, s, s);
    n = n + jv_vput_f64(o, 0, s, 0.0);
    n = n + jv_vput_val(o, 0, s, s, 0);
    n = n + jv_vput_defined(o, 0, s, s, 0);
    n = n + jv_vput_fixed(o, 0, s, 0.0, 0);
    n = n + jv_kid(o, 0, s, 0);
    n = n + jv_find(s, 0, s);
    n = n + jv_fill(o, 0, s, s, 0, true);
    n = n + (jv_string_ok(s, 0) as u32);
    n = n + (jv_number_ok(s, 0) as u32);
    n = n + (jv_lit_ok(s, 0, s) as u32);
    n = n + (jv_valid(s) as u32);
    n = n + jv_ws_at(s, 0, 0);
    n = n + jv_ws_before(s, 0, 0);
    n = n + jv_digit_value(0);
    return n;
}
