pub const KIND : str = "widget-tool";
pub const ID : str = "t27-cell";
pub const TITLE : str = "T27 cell: 27 seats in 3 trits against FP4's 16 codes in 4 bits";
pub const DESCRIPTION : str = "Drag a weight along one line and see where a 27-level T27 cell and a 4-bit E2M1 code round it, and what 32 weights cost in trits and in bits. Numbers from two compiled .t27 specs.";
pub const IMAGE_ALT : str = "T27 cell card on black: one number line with the 27 levels of T27 above it in gold and the 15 values of E2M1 (FP4) below it in white; a table of 32 weights: T27 101 trits against NVFP4's 106, but 161 bits packed densely against NVFP4's 144. The claim that holds is on a ternary substrate only.";
pub const HOOK : str = "A 3-trit cell has 27 seats; FP4 fills 15 of them. T27 stores 32 weights in 101 trits to NVFP4's 106, but in bits it is 161 to 144.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [6]str = ["trinity-fpga specs/numeric/ternary_storage_search.t27 at 1f68b921a: T27_N, E2M1, E2M2 level tables, the cell and dense-packing counts", "trinity-fpga specs/numeric/ternary_storage_search_v2.t27 at 49a84ade5 (sha256 88fcf517...0d4d): TRITS_* and BITS_* per 32 weights, the NVFP4 per-tensor scale", "trinity-fpga research/block/ternary_storage_search_v2.json at d31d8523c: test perplexity of every arm, SmolLM2-135M, wikitext-2, 40 windows", "trinity-fpga research/block/TERNARY_STORAGE_V2_VERDICT_2026-09-27.md at d31d8523c: the limits stated on this page", "public/t27/t27_compiler.wasm: compiles both specs and runs their test blocks; python statistics.NormalDist recomputes T27_N", "scripts/widget-data/t27-cell.mjs writes data.json; scripts/widget-data/t27-cell-card.py draws card.png from it"];
