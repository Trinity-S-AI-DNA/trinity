; specs/widgets/cmp-seal-verdict.t27 -- The receipt for a spec an agent is about to reuse
; Source of truth for public/widgets/cmp-seal-verdict/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-seal-verdict/logic.js -- the fn
; bodies of gHashTag/t27 specs/t27mcp/seal_verdict.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 20 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader sets the facts of a seal: whether one exists, whether it names this spec's path, whether its recorded
; digest is a sha256 and equals the current one, and the test counts and the forced flag. seal_verdict names the receipt.

; WHAT IT DOES NOT CLAIM:  it reads no seal and hashes no spec: the digests are text the reader chooses. The spec itself says its
; "fresh" means the spec bytes are the sealed bytes and nothing more; t27c seal --verify is the full check.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_seal_verdict;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-seal-verdict";
pub const TITLE : str = "The receipt for a spec an agent is about to reuse";
pub const DESCRIPTION : str = "Before an agent reuses a spec it asks for the seal receipt. Seven verdicts, decided in order, from unsealed to verified. Set the facts of a seal and read its receipt.";
pub const IMAGE_ALT : str = "Receipt card: a seal of this very spec, with the same recorded and current digest and three passing tests, none of them vacuous. The verdict is verified. A ladder lists the seven verdicts, from unsealed to verified, and the note under the verdict says the source is the sealed source and its sealed tests passed.";
pub const HOOK : str = "A seal with no test that asserts anything verifies nothing, and a seal of another spec with the same file name is no seal of this one. The receipt says which.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/t27mcp/seal_verdict.t27 (t27 master 90e797659): every verdict is seal_verdict, with seal_check_alg inside it, fn bodies compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 20 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 6;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_SV_UNSEALED : u8 = 1;
pub const K_SV_UNKNOWN : u8 = 2;
pub const K_SV_STALE : u8 = 3;
pub const K_SV_FORCED : u8 = 4;
pub const K_SV_FAILING : u8 = 5;
pub const K_SV_VACUOUS : u8 = 6;
pub const K_SV_VERIFIED : u8 = 7;
pub const K_MAX_TESTS : u8 = 6;
pub const K_PRESET_HAS : [8]u8 = [1, 0, 1, 1, 1, 1, 1, 1];
pub const K_PRESET_SAME_PATH : [8]u8 = [1, 1, 0, 1, 1, 1, 1, 1];
pub const K_PRESET_RECORDED : [8]u8 = [0, 0, 0, 0, 1, 0, 0, 0];
pub const K_PRESET_CURRENT : [8]u8 = [0, 0, 0, 1, 0, 0, 0, 0];
pub const K_PRESET_TOTAL : [8]u8 = [3, 0, 3, 3, 3, 3, 3, 3];
pub const K_PRESET_PASSED : [8]u8 = [3, 0, 3, 3, 3, 3, 1, 3];
pub const K_PRESET_VACUOUS : [8]u8 = [0, 0, 0, 0, 0, 0, 0, 1];
pub const K_PRESET_FORCED : [8]u8 = [0, 0, 0, 0, 0, 1, 0, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine stages a spec passes; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [8]str = ["A good seal", "No seal file", "Another spec's seal", "The source changed", "No digest recorded", "Forced past a failure", "Failing tests", "A test that asserts nothing"];
pub const SAY_ASK : str = "What does a seal say about a spec an agent is about to reuse?";
pub const SAY_HAS : str = "a seal file exists";
pub const SAY_SAME_PATH : str = "it names this spec's path";
pub const SAY_RECORDED : str = "recorded digest";
pub const SAY_CURRENT : str = "current source";
pub const SAY_RECORDED_NAMES : [2]str = ["a sha256", "no digest"];
pub const SAY_CURRENT_NAMES : [2]str = ["unchanged", "one digit changed"];
pub const SAY_TOTAL : str = "tests sealed";
pub const SAY_PASSED : str = "tests passed";
pub const SAY_VACUOUS : str = "of them vacuous";
pub const SAY_FORCED : str = "forced past failures";
pub const SAY_DIGESTS : [2]str = ["sha256:66cc87ba315b75ba80b51b6813d84cb238149e6e75a4f1f55a5fec4915be7c1f", "sha256:66cc87ba315b75ba80b51b6813d84cb238149e6e75a4f1f55a5fec4915be7c1e"];
pub const SAY_PATHS : [2]str = ["specs/a/x.t27", "specs/b/x.t27"];
pub const SAY_VERDICTS : [7]str = ["unsealed", "unknown", "stale", "forced", "failing", "vacuous", "verified"];
pub const SAY_NOTES : [7]str = ["No seal of this spec: nobody has run its tests into a receipt. Run t27c test-report before you rely on it.", "The seal cannot be compared with the source (no or unknown digest). Treat as unverified.", "The source changed after the seal. The seal says nothing about this text; reseal it before you rely on it.", "The seal was forced past failing tests. It is not a pass.", "The sealed run had failing tests.", "The seal holds no test that asserts anything, so it verifies nothing.", "The source is the sealed source and its sealed tests passed."];
pub const SAY_NOTE : str = "Verdicts are decided in the order listed. The seal file name is the parent folder and the module, so two specs can derive one name; a seal that records another path is no seal of this one.";
pub const SAY_SOURCE : str = "Logic: t27 spec t27mcp/seal_verdict.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_has_a_stage_of_nine {
    assert K_STAGE < 9;
    assert K_STAGE == 6;
}

test seven_verdicts_from_unsealed_to_verified {
    assert K_SV_UNSEALED == 1;
    assert K_SV_STALE == 3;
    assert K_SV_VACUOUS + 1 == K_SV_VERIFIED;
    assert K_SV_VERIFIED == 7;
}

test presets_cover_each_verdict_and_start_verified {
    assert K_PRESET_HAS[1] == 0;
    assert K_PRESET_CURRENT[3] == 1;
    assert K_PRESET_FORCED[5] == 1;
    assert K_PRESET_VACUOUS[7] == 1;
    assert K_PRESET_TOTAL[0] <= K_MAX_TESTS;
    assert K_START_PRESET == 0;
}
