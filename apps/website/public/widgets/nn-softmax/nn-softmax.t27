// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-softmax.t27 -- softmax and temperature: scores into a choice
; Source of truth for public/widgets/nn-softmax/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-softmax/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/activation/softmax.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 7 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader sets three scores from -3 to 3 and a temperature from 0.1 to 5. The bars
; are softmax_at(a, b, c, T, i) and the sweep draws the same fn over T, with a cursor to drag.

; WHAT IT DOES NOT CLAIM: three scores stand for a layer of any width; the spec's softmax_at takes
; three.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_softmax;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-softmax";
pub const TITLE : str = "Softmax: how a network turns scores into a choice";
pub const DESCRIPTION : str = "Move three scores and the temperature: softmax turns them into probabilities that sum to one. Cool it and the top score takes almost everything; heat it and the choice evens out.";
pub const IMAGE_ALT : str = "Softmax card: scores 1, 2 and 3 at temperature 1. Three bars in cyan, pink and green stand at 0.0900, 0.2447 and 0.6652. Below, three curves sweep the temperature from 0.1 to 5: the green one falls from 1 toward 0.4 while the other two rise, with a cursor at T = 1.";
pub const HOOK : str = "Scores 1, 2, 3 give 0.090, 0.245, 0.665. At temperature 0.5 the top one takes 0.867; at 5 the three are 0.27, 0.33, 0.40.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/activation/softmax.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 7 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_SCORE_LO_C : i16 = -300;
pub const K_SCORE_HI_C : i16 = 300;
pub const K_T_LO_C : u8 = 10;
pub const K_T_HI_C : u16 = 500;
pub const K_T_STEP_C : u8 = 5;
pub const K_T_TICKS : [6]u8 = [0, 1, 2, 3, 4, 5];
pub const K_P_TICKS_C : [5]u8 = [0, 25, 50, 75, 100];
pub const K_PRESET_A_C : [4]i16 = [100, 100, 100, 200];
pub const K_PRESET_B_C : [4]i16 = [200, 200, 200, 200];
pub const K_PRESET_C_C : [4]i16 = [300, 300, 300, 0];
pub const K_PRESET_T_C : [4]u16 = [100, 50, 500, 100];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["1, 2, 3 at T = 1", "1, 2, 3 at T = 0.5", "1, 2, 3 at T = 5", "A tie: 2, 2, 0"];
pub const SAY_ASK : str = "How does a network turn scores into a choice?";
pub const SAY_A : str = "A";
pub const SAY_B : str = "B";
pub const SAY_C : str = "C";
pub const SAY_T : str = "temperature T";
pub const SAY_BARS_LABEL : str = "The three probabilities softmax gives the three scores";
pub const SAY_SWEEP_LABEL : str = "Each probability as the temperature goes from 0.1 to 5";
pub const SAY_SWEEP : str = "Drag along the temperature: the same three scores, cooled and heated.";
pub const SAY_P : str = "p({0})";
pub const SAY_COLD : str = "at T = {0}";
pub const SAY_NOTE : str = "Softmax is exp(x / T) over the sum of all of them, with the largest score subtracted first so exp never overflows. A language model samples its next token from exactly this.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/activation/softmax.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_temperature_stays_positive {
    assert K_T_LO_C > 0;
    assert K_T_HI_C == 500;
    assert K_PRESET_T_C[1] < K_PRESET_T_C[0];
}

test the_presets_stay_in_range {
    assert K_PRESET_C_C[0] == K_SCORE_HI_C;
    assert K_PRESET_A_C[3] == K_PRESET_B_C[3];
    assert K_PRESET_T_C[2] == K_T_HI_C;
}
