// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-sgd.t27 -- gradient descent with momentum and Nesterov
; Source of truth for public/widgets/nn-sgd/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-sgd/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/optimizer/sgd.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 16 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader sets lr from 0.01 to 1, momentum from 0 to 0.95, Nesterov and the number
; of steps. Every point is descend(lr, momentum, nesterov, n), the spec minimising (x - 3)^2 from 0;
; the dashed path is descend with momentum 0.

; WHAT IT DOES NOT CLAIM: one weight on one bowl; a network has millions and its bowl is not a
; parabola.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_sgd;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-sgd";
pub const TITLE : str = "Gradient descent: how a network walks downhill";
pub const DESCRIPTION : str = "Set the learning rate and momentum and watch a weight walk from 0 to the bottom of (x - 3)^2. Plain steps creep, momentum overshoots and rings, and a rate of 1 bounces forever.";
pub const IMAGE_ALT : str = "SGD card: momentum 0.9 at lr 0.1 for 50 steps. The green path of dots shoots up from 0 past the white dashed minimum at 3 to about 5.1, swings back below it and rings in toward 3; the dashed violet plain path creeps up smoothly. Tiles read x after 50 steps 3.09149, plain 2.99996 and step 1 at 0.6000.";
pub const HOOK : str = "lr 0.1 reaches 2.99996 in 50 steps. Add momentum 0.9 and it shoots to 5.13 first; at lr 1 it bounces between 0 and 6 for good.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/optimizer/sgd.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 16 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_STEPS_HI : u8 = 100;
pub const K_MINIMUM : u8 = 3;
pub const K_LR_LO_C : u8 = 1;
pub const K_LR_HI_C : u8 = 100;
pub const K_MOM_HI_C : u8 = 95;
pub const K_Y_LO : i8 = -1;
pub const K_Y_HI : u8 = 7;
pub const K_Y_TICKS : [5]i8 = [0, 2, 3, 4, 6];
pub const K_STEP_TICKS : [5]u8 = [0, 25, 50, 75, 100];
pub const K_PRESET_LR_C : [4]u8 = [10, 10, 10, 100];
pub const K_PRESET_MOM_C : [4]u8 = [90, 0, 90, 0];
pub const K_PRESET_NEST : [4]u8 = [0, 0, 1, 0];
pub const K_PRESET_STEPS : [4]u8 = [50, 50, 50, 20];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["Momentum 0.9", "Plain, lr 0.1", "Nesterov 0.9", "lr 1: it bounces"];
pub const SAY_ASK : str = "How does a network walk downhill, and why does it overshoot?";
pub const SAY_LR : str = "learning rate";
pub const SAY_MOMENTUM : str = "momentum";
pub const SAY_NESTEROV : str = "Nesterov";
pub const SAY_STEPS : str = "steps";
pub const SAY_PLOT_LABEL : str = "The weight after every step, from 0 toward the minimum at 3";
pub const SAY_PATH : str = "this run";
pub const SAY_PLAIN : str = "no momentum";
pub const SAY_MIN : str = "the minimum";
pub const SAY_X_NOW : str = "x after the steps";
pub const SAY_X_PLAIN : str = "without momentum";
pub const SAY_X_ONE : str = "after step 1";
pub const SAY_NOTE : str = "Each step moves x by -lr times the gradient 2 (x - 3). Momentum adds 0.9 of the last move, which speeds up a long slope and overshoots a sharp bottom; Nesterov takes the gradient one step ahead.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/optimizer/sgd.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_minimum_is_inside_the_axis {
    assert K_MINIMUM == 3;
    assert K_Y_LO < 0;
    assert K_Y_HI > K_MINIMUM * 2;
}

test the_presets_stay_in_range {
    assert K_PRESET_LR_C[3] == K_LR_HI_C;
    assert K_PRESET_MOM_C[0] <= K_MOM_HI_C;
    assert K_PRESET_STEPS[0] <= K_STEPS_HI;
}
