// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-tanh.t27 -- tanh and the saturated band where learning stops
; Source of truth for public/widgets/nn-tanh/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-tanh/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/activation/tanh_activation.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 3 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader drags x from -4 to 4. The curve is forward, the slope derivative, and
; every sampled x whose slope is under K_SAT is shaded red.

; WHAT IT DOES NOT CLAIM: the threshold 0.1 is a choice made for the picture, not a constant of the
; spec.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_tanh;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-tanh";
pub const TITLE : str = "tanh: where a neuron stops learning";
pub const DESCRIPTION : str = "Drag along tanh: it is centred on zero, and where it flattens out its slope drops under 0.1. The red band shows every input where the gradient has all but stopped.";
pub const IMAGE_ALT : str = "tanh card at x = 2.5: the green curve from -1 to 1, the dashed gold slope a bell peaking at 1, and two red bands on both sides where the slope is under 0.1. Tiles read tanh 0.9866, slope 0.0266 marked saturated, and the spec batch tanh(0, 1, 2) = 0 0.762 0.964.";
pub const HOOK : str = "tanh(2.5) is already 0.987 and its slope 0.027. Past about 1.8 either way the gradient is under 0.1: the band a deep net must stay out of.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/activation/tanh_activation.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 3 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_X_LO_C : i16 = -400;
pub const K_X_HI_C : i16 = 400;
pub const K_X_STEP_C : u8 = 5;
pub const K_X_TICKS : [5]i8 = [-4, -2, 0, 2, 4];
pub const K_Y_TICKS : [3]i8 = [-1, 0, 1];
pub const K_SAT_C : u8 = 10;
pub const K_PRESET_X_C : [4]i16 = [250, 0, 100, -300];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["x = 2.5", "x = 0", "x = 1", "x = -3"];
pub const SAY_ASK : str = "Where does a neuron stop learning?";
pub const SAY_X : str = "input x";
pub const SAY_F : str = "tanh(x)";
pub const SAY_DF : str = "slope";
pub const SAY_SAT_BAND : str = "slope under 0.1";
pub const SAY_PLOT_LABEL : str = "tanh of x and its slope from -4 to 4, saturated inputs shaded";
pub const SAY_OUT : str = "tanh(x)";
pub const SAY_GRAD : str = "slope at x";
pub const SAY_BATCH : str = "spec batch 0 1 2";
pub const SAY_STATE : str = "here";
pub const SAY_SATURATED : str = "saturated";
pub const SAY_LEARNING : str = "still learning";
pub const SAY_NOTE : str = "Unlike the sigmoid, tanh is centred on 0 and its slope reaches 1. It still saturates: the gradient that flows back through it is multiplied by that slope.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/activation/tanh_activation.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_band_threshold_is_a_tenth {
    assert K_SAT_C == 10;
    assert K_SAT_C < 100;
}

test the_presets_cover_both_regions {
    assert K_PRESET_X_C[0] > 150;
    assert K_PRESET_X_C[1] == 0;
    assert K_PRESET_X_C[3] + 150 < 0;
}
