// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-cooldown.t27 -- The cooldown clock, /stop and /mute
; Source of truth for public/widgets/hive-cooldown/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-cooldown/logic.js -- the fn
; bodies of gHashTag/t27 specs/automation/agent-hive-group.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 24 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader drags the milliseconds since the last bot message, the minutes since
; /stop and since /mute, and whether the agent was tagged. The dial is cooled(ms); the cards are
; may_answer_after_stop(from a bot or a person, ms) and heard_while_muted(tagged, ms).

; WHAT IT DOES NOT CLAIM:  it sends no command: the minutes are what the reader sets.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_cooldown;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-cooldown";
pub const TITLE : str = "The cooldown clock, /stop and /mute";
pub const DESCRIPTION : str = "One agent answers another at most every 5 s. /stop silences bot-to-bot turns for 10 minutes and /mute an agent for an hour. Drag the clocks: a person is always heard.";
pub const IMAGE_ALT : str = "Cooldown card: 3200 ms since the last bot message, the dial filling to 3.2 of 10 s with a gold mark at 5 s: not cooled, the bot waits. A /stop 4 minutes ago: bots stay silent, a person is heard. A /mute 20 minutes ago: only a tag by name gets through.";
pub const HOOK : str = "A stop cuts bot-to-bot turns only, a mute still answers its own tag: neither one can lose a person or a direct call.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/automation/agent-hive-group.t27 (t27 master c42f8fb40): every value on the page is cooled, may_answer_after_stop and heard_while_muted, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 24 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_MS_MAX : u16 = 10000;
pub const K_MS_STEP : u8 = 100;
pub const K_BOT_REPLY_COOLDOWN_MS : u32 = 5000;
pub const K_STOP_WINDOW_MS : u32 = 600000;
pub const K_MUTE_MS : u32 = 3600000;
pub const K_MS_PER_MINUTE : u32 = 60000;
pub const K_STOP_MAX : u8 = 20;
pub const K_MUTE_MAX : u8 = 90;
pub const K_PRESET_MS : [4]u16 = [3200, 5000, 8000, 1000];
pub const K_PRESET_STOP : [4]u8 = [4, 12, 4, 20];
pub const K_PRESET_MUTE : [4]u8 = [20, 20, 70, 5];
pub const K_PRESET_TAGGED : [4]u8 = [0, 0, 0, 1];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["3.2 s, stop 4 min ago", "Exactly 5 s", "Mute ran out", "Tagged while muted"];
pub const SAY_ASK : str = "Agents answer fast. How does the hive keep them from flooding a chat?";
pub const SAY_MS : str = "ms since the last bot message";
pub const SAY_STOP : str = "minutes since /stop";
pub const SAY_MUTE : str = "minutes since /mute";
pub const SAY_TAGGED : str = "the agent is tagged by name";
pub const SAY_COOLED : str = "cooled: a bot may answer";
pub const SAY_WAIT : str = "not cooled: the bot waits";
pub const SAY_DIAL : str = "of 10 s";
pub const SAY_STOP_CARDS : [2]str = ["a bot after /stop", "a person after /stop"];
pub const SAY_MUTE_CARD : str = "the muted agent";
pub const SAY_HEARD : str = "heard";
pub const SAY_SILENT : str = "silent";
pub const SAY_NOTE : str = "/stop lasts 10 minutes and /mute an hour; both are clocks, so the hive needs no one to switch it back on.";
pub const SAY_SOURCE : str = "Logic: t27 spec automation/agent-hive-group.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_clocks_are_the_specs {
    assert K_BOT_REPLY_COOLDOWN_MS == 5000;
    assert K_STOP_WINDOW_MS == K_MS_PER_MINUTE * 10;
    assert K_MUTE_MS == K_MS_PER_MINUTE * 60;
}

test the_sliders_cross_each_window {
    assert K_STOP_MAX * K_MS_PER_MINUTE > K_STOP_WINDOW_MS;
    assert K_MUTE_MAX * K_MS_PER_MINUTE > K_MUTE_MS;
    assert K_MS_MAX > K_BOT_REPLY_COOLDOWN_MS;
}
