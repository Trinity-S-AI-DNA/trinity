; --- Tests -----------------------------------------------------------------------------------
test twenty_six_answers_fit {
    assert K_RX_BYTES / K_ANSWER_BYTES == K_LARGEST_FIT;
    assert K_LARGEST_FIT * K_ANSWER_BYTES <= K_RX_BYTES;
    assert K_ANSWER_BYTES * (K_LARGEST_FIT + 1) > K_RX_BYTES;
    assert K_LARGEST_FIT * K_ANSWER_BYTES == 494;
}

test the_two_arms_sit_either_side_of_the_buffer {
    assert K_ARM_WINDOWS[1] * K_ANSWER_BYTES <= K_RX_BYTES;
    assert K_RX_BYTES < K_ARM_WINDOWS[0] * K_ANSWER_BYTES;
    assert K_ARM_WINDOWS[0] * K_ANSWER_BYTES == 1216;
    assert K_ARM_WINDOWS[1] * K_ANSWER_BYTES == 456;
}

test the_edge_runs_bracket_the_buffer {
    assert K_EDGE_WINDOWS[0] == K_LARGEST_FIT;
    assert K_EDGE_WINDOWS[0] * K_ANSWER_BYTES <= K_RX_BYTES;
    assert K_EDGE_WINDOWS[1] * K_ANSWER_BYTES > K_RX_BYTES;
    assert K_EDGE_WINDOWS[1] * K_ANSWER_BYTES == 570;
}

test the_slider_reaches_every_measured_window {
    assert K_WINDOW_MIN == 1;
    assert K_WINDOW_MAX >= K_ARM_WINDOWS[0];
    assert K_WINDOW_MIN <= K_ARM_WINDOWS[1];
    assert K_WINDOW_START <= K_WINDOW_MAX;
    assert K_REQUEST_BYTES > K_ANSWER_BYTES;
}

test the_page_sends_nothing {
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == false;
    assert K_DATA_FILE == "./data.json";
    assert CATEGORY == "fpga";
}


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, issue #10938, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/uart-bucket/tool.js (228 lines of hand-written JavaScript).
; The words and numbers above are unchanged. The host protocol is race_the_bee.t27's plus:
;   w_input(i, text)      the slider (input 0) now holds text
;   w_click(i)            button i in document order: 0 fewer, 1 more, 2 and 3 the two arms' "put window
;                         in the bucket", then one per edge run
;   w_env(reduced, hidden) prefers-reduced-motion matches / document.hidden, before the data and whenever
;                         either changes; w_resync() then re-runs set() as tool.js's two listeners do
;   w_now(ms)             performance.now(), before every event that can start the animation
;   w_anim()              1 while the animation wants frames (host: keep requestAnimationFrame running)
;   w_frame(now, dst)     one animation frame at time `now`: the DOM changes it makes, as patch lines in
;                         dst, length. A patch line is `selector@index TAB kind TAB name TAB value LF`,
;                         kind a = setAttribute, s = style[name], t = textContent, c = classList.toggle
;                         (value 1 or 0); the host runs it with querySelectorAll(selector)[index]
;   w_render(dst)         the page's HTML, length (0 on overflow). It holds the LAST DRAWN animation state,
;                         so a re-render after an event shows what tool.js's nodes would still hold.
; The bucket is drawn by the same rules as tool.js: the level, the spill and the three drops are numbers
; from the cycle clock ((now - start) mod K_CYCLE_MS) written with toFixed(1); the readout, verdict and
; the SVG <title> follow the slider. Numbers are written the JavaScript way (js_num.t27: toLocaleString for
; fmt(), toFixed, String(x) of the slider value), values read the way String() reads them (js_val.t27).
; Where tool.js throws while it draws (arms without the two windows, no edges, a null wire / carried /
; sources entry) its catch shows SAY_LOAD_FAILED and starts no animation; so does this page (data_ok).
; NOT carried over: the data file is cut at W_DATA_CAP bytes (the page then says it could not be read);
; classList.toggle on happy-dom normalises a class string even when nothing changes (a trailing space of
; "ub-arm " goes at the first set()); this page writes the normalised string, a browser keeps the space.
; MEASURED 2026-10-19: t27c 0.5.2 gen + an 11-function Zig export wrapper + zig build-exe wasm32-freestanding
; ReleaseSmall give a 32562-byte wasm. The original page (tool.js) and this one ran in two happy-dom
; windows against the real 2040-byte data.json and 95 variants of it, 3288 comparisons of tag, attributes
; (the animated y / height / class / style / x) and text, with a VIRTUAL clock and requestAnimationFrame
; on both sides (the same timestamps, so the cycle is compared at 1360 instants across the fill, hold and
; drain phases, from 16 ms to 20 s apart), 561 slider values (in range, fractional, blank, not a number),
; 409 presses of fewer / more, 364 presses of the measured-run buttons, 186 changes of prefers-reduced-motion
; and 216 of document.hidden (the animation stops and a still frame is drawn, then restarts), runs that
; start reduced / hidden / at a late or fractional clock, data with a markup / null / number board, lost
; counts zero / string / null, in-flight at the 512 edge, huge / negative / null numbers, swapped / extra /
; duplicate arms, a string window, three / one / all-slipped / none-slipped edges, odd wire and carried
; fields, no generation line, empty / odd sources, 14 files the page cannot draw (an arm missing, no edges,
; a null edge / wire / carried / source, a root that is null or an array): 0 differences. A negative
; control (one attribute of the native DOM changed) is caught.
; Not compared, and why: real time (requestAnimationFrame and performance.now are virtual: happy-dom has
; no frame clock, so smoothness and the 60 Hz cadence are not measured); CSS (happy-dom loads none, so the
; opacity / transform the stylesheet adds is not seen); focus (range.focus() after a "put window" press is
; not a DOM difference); real pointer or media-query events.

pub const W_DATA_CAP : u32 = 16384;
pub var DATA : [16384]u8 = [0; 16384];
pub var DATA_LEN : u32 = 0;
pub var DATA_STATE : u8 = 0;
pub var WIN : f64 = 64.0;
pub var TARGET : f64 = 0.0;
pub var START : f64 = 0.0;
pub var RAF : bool = false;
pub var NOW : f64 = 0.0;
pub var REDUCED : bool = false;
pub var HIDDEN : bool = false;
pub var NOTE : bool = false;
pub var DRAWN : bool = false;
pub var D_WATER_Y : f64 = 268.0;
pub var D_OVER : bool = false;
pub var D_SPILL : u8 = 0;
pub var D_LVL_TXT : [48]u8 = [0; 48];
pub var D_LVL_LEN : u32 = 0;
pub var D_LVL_X : f64 = 0.0;
pub var D_LVL_Y : f64 = 0.0;
pub var D_DROP_OP : [3]u8 = [0; 3];
pub var D_DROP_Y : [3]f64 = [0.0; 3];
pub var D_DROP_SET : [3]bool = [false; 3];

pub fn w_init(h: []const u8) -> u32 {
    DATA_STATE = 0;
    DATA_LEN = 0;
    RAF = false;
    DRAWN = false;
    NOTE = false;
    WIN = 64.0;
    TARGET = 0.0;
    D_SPILL = 0;
    D_OVER = false;
    D_WATER_Y = 268.0;
    D_LVL_LEN = 0;
    D_DROP_OP[0] = 0; D_DROP_OP[1] = 0; D_DROP_OP[2] = 0;
    D_DROP_SET[0] = false; D_DROP_SET[1] = false; D_DROP_SET[2] = false;
    return 0;
}

pub fn w_env(reduced: u32, hidden: u32) -> u32 {
    REDUCED = reduced != 0;
    HIDDEN = hidden != 0;
    return 0;
}

pub fn w_now(ms: f64) -> u32 {
    NOW = ms;
    return 0;
}

pub fn w_anim() -> u32 {
    if (RAF) { return 1; }
    return 0;
}

fn nullish(d: []const u8, sp: i64) -> bool {
    const k : u8 = kind(d, sp);
    return k == J_NONE or k == J_NULL;
}

/// The arm whose window is `w` (a number equal to it), NO_SPAN when none.
fn arm_of(d: []const u8, r: i64, w: u16) -> i64 {
    const arms : i64 = obj_get(d, r, "arms");
    const cnt : u32 = arr_len(d, arms);
    var i : u32 = 0;
    while (i < cnt) {
        const a : i64 = arr_at(d, arms, i);
        const v : i64 = obj_get(d, a, "window");
        if (kind(d, v) == J_NUMBER and jv_num(d, v) == (w as f64)) { return a; }
        i = i + 1;
    }
    return NO_SPAN;
}

/// Would draw() in tool.js get to its last line without a TypeError?
fn data_ok(d: []const u8, r: i64) -> bool {
    if (nullish(d, r)) { return false; }
    if (nullish(d, arm_of(d, r, K_ARM_WINDOWS[0])) or nullish(d, arm_of(d, r, K_ARM_WINDOWS[1]))) { return false; }
    const ed : i64 = obj_get(d, r, "edges");
    if (kind(d, ed) != J_ARRAY) { return false; }
    const ec : u32 = arr_len(d, ed);
    if (ec == 0) { return false; }
    var i : u32 = 0;
    while (i < ec) {
        if (nullish(d, arr_at(d, ed, i))) { return false; }
        i = i + 1;
    }
    if (nullish(d, obj_get(d, r, "wire")) or nullish(d, obj_get(d, r, "carried"))) { return false; }
    const so : i64 = obj_get(d, r, "sources");
    if (kind(d, so) != J_ARRAY) { return false; }
    const sc : u32 = arr_len(d, so);
    i = 0;
    while (i < sc) {
        if (nullish(d, arr_at(d, so, i))) { return false; }
        i = i + 1;
    }
    return true;
}

// --- the bucket's numbers -----------------------------------------------------------------------

fn rxf() -> f64 {
    return K_RX_BYTES as f64;
}

fn level_y(frac: f64) -> f64 {
    return 268.0 - (268.0 - 104.0) * js_min(frac, 1.0);
}

/// xAt(y, +1): the right wall at height y.
fn x_right(y: f64) -> f64 {
    const t : f64 = (y - 104.0) / (268.0 - 104.0);
    return 256.0 + (234.0 - 256.0) * t;
}

/// JavaScript's a % b for doubles: the sign of a, |a| mod |b| exactly.
fn fmod(a: f64, b: f64) -> f64 {
    if (a != a or b != b or b == 0.0 or (a - a) != 0.0) { return js_nan(0.0); }
    var neg : bool = a < 0.0;
    var x : f64 = a;
    if (neg) { x = 0.0 - a; }
    var m : f64 = b;
    if (m < 0.0) { m = 0.0 - m; }
    if (m > x) { return a; }
    // subtract b * 2^k from the top down; every step is exact (x and the subtrahend are within a factor 2)
    var scaled : f64 = m;
    var steps : u32 = 0;
    while (scaled * 2.0 <= x and steps < 1100) {
        scaled = scaled * 2.0;
        steps = steps + 1;
    }
    while (scaled >= m) {
        if (x >= scaled) { x = x - scaled; }
        scaled = scaled / 2.0;
    }
    if (neg) { return 0.0 - x; }
    return x;
}

/// draw(bytes, overflowing, dropPhase) of tool.js's animator, into the last-drawn state D_*.
fn draw_state(bytes: f64, over: bool, has_phase: bool, phase: f64) -> u32 {
    const y : f64 = level_y(bytes / rxf());
    DRAWN = true;
    D_WATER_Y = y;
    D_OVER = over;
    if (over) { D_SPILL = 49; } else { D_SPILL = 48; }
    var tmp : [48]u8 = [0; 48];
    const l : u32 = js_locale_num(tmp[0..], 0, js_round(js_min(bytes, rxf())));
    var q : u32 = 0;
    while (q < l and q < 44) {
        D_LVL_TXT[q as usize] = tmp[q as usize];
        q = q + 1;
    }
    D_LVL_TXT[q as usize] = 32;
    D_LVL_TXT[(q + 1) as usize] = 66;
    D_LVL_LEN = q + 2;
    D_LVL_X = x_right(y) + 8.0;
    D_LVL_Y = y + 4.0;
    var i : u32 = 0;
    while (i < 3) {
        if (!has_phase) {
            D_DROP_OP[i as usize] = 48;
        } else {
            const p : f64 = fmod(phase + (i as f64) / 3.0, 1.0);
            const bottom : f64 = js_max(level_y(bytes / rxf()) - 8.0, 56.0);
            D_DROP_Y[i as usize] = 56.0 + (bottom - 56.0) * p;
            D_DROP_SET[i as usize] = true;
            D_DROP_OP[i as usize] = 49;
        }
        i = i + 1;
    }
    return 0;
}

fn still() -> u32 {
    return draw_state(TARGET, TARGET > rxf(), false, 0.0);
}

/// animator.set(bytes)
fn anim_set(bytes: f64) -> u32 {
    TARGET = bytes;
    if (REDUCED or HIDDEN) {
        RAF = false;
        still();
        return 0;
    }
    if (!RAF) {
        START = NOW;
        RAF = true;
    }
    return 0;
}

/// set(w) of tool.js's page.
fn set_win(w0: f64) -> u32 {
    const lo : f64 = K_WINDOW_MIN as f64;
    const hi : f64 = K_WINDOW_MAX as f64;
    WIN = js_max(lo, js_min(hi, js_round(w0)));
    anim_set(WIN * (K_ANSWER_BYTES as f64));
    return 0;
}

pub fn w_data(i: u32, s: []const u8) -> u32 {
    if (s.len > (W_DATA_CAP as usize)) {
        DATA_STATE = 2;
        return 0;
    }
    var k : usize = 0;
    while (k < s.len) {
        DATA[k] = s[k];
        k = k + 1;
    }
    DATA_LEN = s.len as u32;
    DATA_STATE = 1;
    const d : []const u8 = DATA[0..(DATA_LEN as usize)];
    if (!jv_valid(d)) {
        DATA_STATE = 2;
        return 0;
    }
    if (!data_ok(d, root(d))) {
        DATA_STATE = 2;
        return 0;
    }
    NOTE = REDUCED;
    set_win(K_WINDOW_START as f64);
    return 0;
}

pub fn w_data_failed(i: u32) -> u32 {
    DATA_STATE = 2;
    return 0;
}

pub fn w_input(i: u32, s: []const u8) -> u32 {
    if (DATA_STATE != 1) { return 0; }
    if (i == 0) { set_win(jv_number_of_text(s, s.len as u32)); }
    return 0;
}

pub fn w_resync() -> u32 {
    if (DATA_STATE != 1) { return 0; }
    set_win(WIN);
    return 0;
}

pub fn w_click(i: u32) -> u32 {
    if (DATA_STATE != 1) { return 0; }
    if (i == 0) { set_win(WIN - 1.0); }
    if (i == 1) { set_win(WIN + 1.0); }
    if (i >= 2) {
        const d : []const u8 = DATA[0..(DATA_LEN as usize)];
        const r : i64 = root(d);
        if (i == 2) { set_win(jv_num(d, obj_get(d, arm_of(d, r, K_ARM_WINDOWS[0]), "window"))); }
        if (i == 3) { set_win(jv_num(d, obj_get(d, arm_of(d, r, K_ARM_WINDOWS[1]), "window"))); }
        if (i >= 4) {
            const ed : i64 = obj_get(d, r, "edges");
            if (i - 4 < arr_len(d, ed)) { set_win(jv_num(d, obj_get(d, arr_at(d, ed, i - 4), "window"))); }
        }
    }
    return 0;
}

// --- the frame ----------------------------------------------------------------------------------

fn patch(dst: []u8, n0: u32, sel: []const u8, ix: u32, kind_c: u8, name: []const u8) -> u32 {
    var n : u32 = raw(dst, n0, sel);
    n = put(dst, n, 64);
    n = js_str_u64(dst, n, ix as u64);
    n = put(dst, n, 9);
    n = put(dst, n, kind_c);
    n = put(dst, n, 9);
    n = raw(dst, n, name);
    return put(dst, n, 9);
}

/// The patches that bring a page showing the previous state to the state D_*.
fn emit_patches(dst: []u8, n0: u32) -> u32 {
    var n : u32 = patch(dst, n0, ".ub-water", 0, 97, "y");
    n = js_to_fixed(dst, n, D_WATER_Y, 1);
    n = put(dst, n, 10);
    n = patch(dst, n, ".ub-water", 0, 97, "height");
    n = js_to_fixed(dst, n, 268.0 - D_WATER_Y, 1);
    n = put(dst, n, 10);
    n = patch(dst, n, ".ub-water", 0, 99, "is-over");
    if (D_OVER) { n = put(dst, n, 49); } else { n = put(dst, n, 48); }
    n = put(dst, n, 10);
    n = patch(dst, n, ".ub-spill", 0, 115, "opacity");
    n = put(dst, n, D_SPILL);
    n = put(dst, n, 10);
    n = patch(dst, n, ".ub-level", 0, 116, "");
    var q : u32 = 0;
    while (q < D_LVL_LEN) {
        n = put(dst, n, D_LVL_TXT[q as usize]);
        q = q + 1;
    }
    n = put(dst, n, 10);
    n = patch(dst, n, ".ub-level", 0, 97, "x");
    n = js_to_fixed(dst, n, D_LVL_X, 1);
    n = put(dst, n, 10);
    n = patch(dst, n, ".ub-level", 0, 97, "y");
    n = js_to_fixed(dst, n, D_LVL_Y, 1);
    n = put(dst, n, 10);
    var i : u32 = 0;
    while (i < 3) {
        if (D_DROP_OP[i as usize] == 49) {
            n = patch(dst, n, ".ub-drop", i, 97, "y");
            n = js_to_fixed(dst, n, D_DROP_Y[i as usize], 1);
            n = put(dst, n, 10);
        }
        n = patch(dst, n, ".ub-drop", i, 115, "opacity");
        n = put(dst, n, D_DROP_OP[i as usize]);
        n = put(dst, n, 10);
        i = i + 1;
    }
    return n;
}

/// One animation frame at time `now`; the patch lines, their length (0 when no frame is wanted).
pub fn w_frame(now: f64, dst: []u8) -> u32 {
    if (!RAF or DATA_STATE != 1) { return 0; }
    const cyc : f64 = K_CYCLE_MS as f64;
    const t : f64 = fmod(now - START, cyc) / cyc;
    var bytes : f64 = 0.0;
    var has_phase : bool = false;
    var phase : f64 = 0.0;
    if (t < 0.55) {
        bytes = TARGET * (t / 0.55);
        has_phase = true;
        phase = fmod((t / 0.55) * 4.0, 1.0);
    } else {
        if (t < 0.75) {
            bytes = TARGET;
        } else {
            bytes = js_min(TARGET, rxf()) * (1.0 - (t - 0.75) / 0.25);
        }
    }
    draw_state(bytes, bytes > rxf(), has_phase, phase);
    return emit_patches(dst, 0);
}

// --- the page -----------------------------------------------------------------------------------

/// fmt(n): toLocaleString for a number, String(n) for anything else.
fn fmt_text(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    if (kind(d, sp) == J_NUMBER) { return js_locale_num(dst, n0, jv_num(d, sp)); }
    return jv_text(dst, n0, d, sp);
}

/// fmt(x) as raw bytes (for a pool value).
fn fmt_raw(out: []u8, d: []const u8, sp: i64) -> u32 {
    if (kind(d, sp) == J_NUMBER) { return js_locale_num(out, 0, jv_num(d, sp)); }
    return jv_str(out, 0, d, sp);
}

fn fmt_f64_raw(out: []u8, v: f64) -> u32 {
    return js_locale_num(out, 0, v);
}

fn bucket_html(dst: []u8, n0: u32, d: []const u8, r: i64, readout: []const u8, verdict: []const u8) -> u32 {
    var n : u32 = raw(dst, n0, "<svg viewBox=\"0 0 340 300\" class=\"ub-svg\" role=\"img\"><title>");
    n = text(dst, n, readout);
    n = put(dst, n, 32);
    n = text(dst, n, verdict);
    n = raw(dst, n, "</title><rect x=\"110\" y=\"6\" width=\"120\" height=\"26\" rx=\"6\" class=\"ub-node\"></rect><text x=\"170\" y=\"24\" class=\"ub-node-t\" text-anchor=\"middle\">");
    n = nn_text(dst, n, d, obj_get(d, r, "board"));
    n = raw(dst, n, "</text><rect x=\"165\" y=\"32\" width=\"10\" height=\"24\" class=\"ub-pipe\"></rect><text x=\"182\" y=\"50\" class=\"ub-label\">");
    var vb : [128]u8 = [0; 128];
    var vn : u32 = jv_vput_f64(vb[0..], 0, "answer", K_ANSWER_BYTES as f64);
    n = jv_fill(dst, n, SAY_TAP, vb[0..], vn, false);
    n = raw(dst, n, "</text><defs><clipPath id=\"ub-clip\"><polygon points=\"84,104 256,104 234,268 106,268\"></polygon></clipPath></defs><rect x=\"80\" width=\"180\" ");
    if (DRAWN) {
        n = raw(dst, n, "y=\"");
        n = js_to_fixed(dst, n, D_WATER_Y, 1);
        n = raw(dst, n, "\" height=\"");
        n = js_to_fixed(dst, n, 268.0 - D_WATER_Y, 1);
        n = raw(dst, n, "\"");
    } else {
        n = raw(dst, n, "y=\"268\" height=\"0\"");
    }
    n = raw(dst, n, " class=\"ub-water");
    if (DRAWN and D_OVER) { n = raw(dst, n, " is-over"); }
    n = raw(dst, n, "\" clip-path=\"url(#ub-clip)\"></rect>");
    var i : u32 = 0;
    while (i < 3) {
        n = raw(dst, n, "<rect x=\"167\" y=\"");
        if (D_DROP_SET[i as usize]) { n = js_to_fixed(dst, n, D_DROP_Y[i as usize], 1); } else { n = raw(dst, n, "56"); }
        n = raw(dst, n, "\" width=\"6\" height=\"10\" rx=\"3\" class=\"ub-drop\"");
        if (D_DROP_OP[i as usize] == 48) { n = raw(dst, n, " style=\"opacity: 0;\""); }
        if (D_DROP_OP[i as usize] == 49) { n = raw(dst, n, " style=\"opacity: 1;\""); }
        n = raw(dst, n, "></rect>");
        i = i + 1;
    }
    n = raw(dst, n, "<g class=\"ub-spill\"");
    if (D_SPILL == 48) { n = raw(dst, n, " style=\"opacity: 0;\""); }
    if (D_SPILL == 49) { n = raw(dst, n, " style=\"opacity: 1;\""); }
    n = raw(dst, n, "><path d=\"M 84 104 q -14 0 -18 20 L 62 278\" class=\"ub-spill-line\"></path><path d=\"M 256 104 q 14 0 18 20 L 278 278\" class=\"ub-spill-line\"></path><text x=\"286\" y=\"270\" class=\"ub-spill-t\">");
    n = text(dst, n, SAY_SPILL);
    n = raw(dst, n, "</text></g><polyline points=\"78,96 106,268 234,268 262,96\" class=\"ub-wall\"></polyline><line x1=\"82\" x2=\"258\" y1=\"104\" y2=\"104\" class=\"ub-brim\"></line><text x=\"74\" y=\"108\" class=\"ub-brim-t\" text-anchor=\"end\">");
    var bb : [64]u8 = [0; 64];
    const bn : u32 = jv_vput_f64(bb[0..], 0, "rx", rxf());
    n = jv_fill(dst, n, SAY_BRIM, bb[0..], bn, false);
    n = raw(dst, n, "</text><rect x=\"165\" y=\"268\" width=\"10\" height=\"14\" class=\"ub-pipe\"></rect><text x=\"170\" y=\"296\" class=\"ub-label\" text-anchor=\"middle\">");
    n = text(dst, n, SAY_DRAIN);
    n = raw(dst, n, "</text><text");
    if (DRAWN) {
        n = raw(dst, n, " x=\"");
        n = js_to_fixed(dst, n, D_LVL_X, 1);
        n = raw(dst, n, "\" y=\"");
        n = js_to_fixed(dst, n, D_LVL_Y, 1);
        n = raw(dst, n, "\"");
    } else {
        n = raw(dst, n, " x=\"266\" y=\"268\"");
    }
    n = raw(dst, n, " class=\"ub-level\">");
    if (DRAWN) {
        var q : u32 = 0;
        while (q < D_LVL_LEN) {
            n = put_escaped(dst, n, D_LVL_TXT[q as usize]);
            q = q + 1;
        }
    }
    return raw(dst, n, "</text></svg>");
}

/// `x ?? ''` as a child.
fn nn_text(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    if (nullish(d, sp)) { return n0; }
    return jv_text(dst, n0, d, sp);
}

fn arm_card(dst: []u8, n0: u32, d: []const u8, a: i64) -> u32 {
    const inflight : i64 = obj_get(d, a, "inFlight");
    const lost : i64 = obj_get(d, a, "lost");
    const over : bool = jv_num(d, inflight) > rxf();
    const w : i64 = obj_get(d, a, "window");
    const shown : bool = kind(d, w) == J_NUMBER and jv_num(d, w) == WIN;
    var n : u32 = raw(dst, n0, "<section class=\"ub-arm");
    if (over) { n = raw(dst, n, " is-over"); }
    if (shown) { n = raw(dst, n, " is-shown"); }
    n = raw(dst, n, "\"><h3>");
    var vb : [256]u8 = [0; 256];
    var vn : u32 = jv_vput_val(vb[0..], 0, "w", d, w);
    n = jv_fill(dst, n, SAY_ARM_HEAD, vb[0..], vn, false);
    n = raw(dst, n, "</h3><dl>");
    var row : usize = 0;
    while (row < SAY_ARM_ROWS.len) {
        n = raw(dst, n, "<dt>");
        n = text(dst, n, SAY_ARM_ROWS[row]);
        n = raw(dst, n, "</dt><dd class=\"");
        if (row == 3 and jv_num(d, lost) > 0.0) { n = raw(dst, n, "ub-lost"); }
        n = raw(dst, n, "\">");
        if (row == 0) {
            n = fmt_text(dst, n, d, inflight);
            n = raw(dst, n, " B");
        }
        if (row == 1) { n = fmt_text(dst, n, d, obj_get(d, a, "jobsSent")); }
        if (row == 2) { n = fmt_text(dst, n, d, obj_get(d, a, "accepted")); }
        if (row == 3) { n = fmt_text(dst, n, d, lost); }
        if (row == 4) { n = fmt_text(dst, n, d, obj_get(d, a, "events")); }
        if (row == 5) {
            n = jv_text(dst, n, d, obj_get(d, a, "elapsedS"));
            n = put(dst, n, 32);
            n = text(dst, n, SAY_SECONDS);
        }
        n = raw(dst, n, "</dd>");
        row = row + 1;
    }
    n = raw(dst, n, "</dl><button type=\"button\" class=\"t27-btn ub-show\">");
    n = jv_fill(dst, n, SAY_SHOW, vb[0..], vn, false);
    return raw(dst, n, "</button></section>");
}

pub fn w_render(dst: []u8) -> u32 {
    var n : u32 = 0;
    if (DATA_STATE == 0) {
        n = raw(dst, n, "<p class=\"ub-note\">");
        n = text(dst, n, SAY_LOADING);
        n = raw(dst, n, "</p>");
        if (!ok(n)) { return 0; }
        return n;
    }
    if (DATA_STATE == 2) {
        n = raw(dst, n, "<p class=\"ub-note\">");
        n = text(dst, n, SAY_LOAD_FAILED);
        n = raw(dst, n, "</p>");
        if (!ok(n)) { return 0; }
        return n;
    }
    const d : []const u8 = DATA[0..(DATA_LEN as usize)];
    const r : i64 = root(d);
    // the readout and the verdict for the window
    const bytes : f64 = WIN * (K_ANSWER_BYTES as f64);
    const over : bool = bytes > rxf();
    var rd : [256]u8 = [0; 256];
    var rb : [256]u8 = [0; 256];
    var tmp : [64]u8 = [0; 64];
    var rv : u32 = jv_vput_f64(rb[0..], 0, "w", WIN);
    rv = jv_vput_f64(rb[0..], rv, "answer", K_ANSWER_BYTES as f64);
    var tl : u32 = fmt_f64_raw(tmp[0..], bytes);
    rv = jv_vput_str(rb[0..], rv, "bytes", tmp[0..(tl as usize)]);
    rv = jv_vput_f64(rb[0..], rv, "rx", rxf());
    // the filled text, unescaped, for the <title>: the fill escapes, so fill into a scratch and unescape
    var ro : [512]u8 = [0; 512];
    var rl : u32 = jv_fill_raw(ro[0..], 0, SAY_READOUT, rb[0..], rv, false);
    var vd : [512]u8 = [0; 512];
    var vb : [256]u8 = [0; 256];
    var vl : u32 = 0;
    if (over) {
        tl = fmt_f64_raw(tmp[0..], bytes - rxf());
        const vn : u32 = jv_vput_str(vb[0..], 0, "over", tmp[0..(tl as usize)]);
        vl = jv_fill_raw(vd[0..], 0, SAY_OVER, vb[0..], vn, false);
    } else {
        tl = fmt_f64_raw(tmp[0..], rxf() - bytes);
        const vn2 : u32 = jv_vput_str(vb[0..], 0, "spare", tmp[0..(tl as usize)]);
        vl = jv_fill_raw(vd[0..], 0, SAY_FITS, vb[0..], vn2, false);
    }
    n = raw(dst, n, "<p class=\"ub-intro\">");
    var ib : [512]u8 = [0; 512];
    var in_ : u32 = jv_vput_val(ib[0..], 0, "board", d, obj_get(d, r, "board"));
    in_ = jv_vput_f64(ib[0..], in_, "answer", K_ANSWER_BYTES as f64);
    in_ = jv_vput_f64(ib[0..], in_, "rx", rxf());
    n = jv_fill(dst, n, SAY_INTRO, ib[0..], in_, false);
    n = raw(dst, n, "</p><div class=\"ub-play\"><figure class=\"ub-stage\">");
    n = bucket_html(dst, n, d, r, ro[0..(rl as usize)], vd[0..(vl as usize)]);
    n = raw(dst, n, "<figcaption>");
    n = text(dst, n, SAY_BUCKET);
    n = raw(dst, n, "</figcaption></figure><div class=\"ub-controls\"><label class=\"ub-label-l\" for=\"ub-range\">");
    n = text(dst, n, SAY_WINDOW_LABEL);
    n = raw(dst, n, " <output class=\"ub-w\" for=\"ub-range\">");
    n = js_str_num(dst, n, WIN);
    n = raw(dst, n, "</output></label><div class=\"ub-slider\"><button type=\"button\" class=\"t27-btn ub-step\"");
    n = attr(dst, n, "aria-label", SAY_FEWER);
    n = raw(dst, n, ">");
    n = text(dst, n, SAY_MINUS);
    n = raw(dst, n, "</button><input type=\"range\"");
    n = raw(dst, n, " min=\"");
    n = js_str_num(dst, n, K_WINDOW_MIN as f64);
    n = raw(dst, n, "\" max=\"");
    n = js_str_num(dst, n, K_WINDOW_MAX as f64);
    n = raw(dst, n, "\" step=\"1\" value=\"");
    n = js_str_num(dst, n, WIN);
    n = raw(dst, n, "\" list=\"ub-marks\" class=\"ub-range\" id=\"ub-range\"");
    n = attr(dst, n, "aria-label", SAY_WINDOW_LABEL);
    n = raw(dst, n, "><button type=\"button\" class=\"t27-btn ub-step\"");
    n = attr(dst, n, "aria-label", SAY_MORE);
    n = raw(dst, n, ">");
    n = text(dst, n, SAY_PLUS);
    n = raw(dst, n, "</button><datalist id=\"ub-marks\">");
    var i : usize = 0;
    while (i < K_ARM_WINDOWS.len) {
        n = raw(dst, n, "<option value=\"");
        n = js_str_num(dst, n, K_ARM_WINDOWS[i] as f64);
        n = raw(dst, n, "\"></option>");
        i = i + 1;
    }
    i = 0;
    while (i < K_EDGE_WINDOWS.len) {
        n = raw(dst, n, "<option value=\"");
        n = js_str_num(dst, n, K_EDGE_WINDOWS[i] as f64);
        n = raw(dst, n, "\"></option>");
        i = i + 1;
    }
    n = raw(dst, n, "</datalist></div><p class=\"ub-readout\">");
    n = put_all2(dst, n, ro[0..], rl);
    n = raw(dst, n, "</p><p class=\"ub-verdict");
    if (over) { n = raw(dst, n, " is-over"); }
    n = raw(dst, n, "\">");
    n = put_all2(dst, n, vd[0..], vl);
    n = raw(dst, n, "</p><p class=\"ub-rule\">");
    var ub : [512]u8 = [0; 512];
    var un : u32 = jv_vput_f64(ub[0..], 0, "rx", rxf());
    un = jv_vput_f64(ub[0..], un, "answer", K_ANSWER_BYTES as f64);
    un = jv_vput_val(ub[0..], un, "ratio", d, obj_get(d, r, "ratio"));
    un = jv_vput_f64(ub[0..], un, "fit", K_LARGEST_FIT as f64);
    n = jv_fill(dst, n, SAY_RULE, ub[0..], un, false);
    n = raw(dst, n, "</p>");
    if (NOTE) {
        n = raw(dst, n, "<p class=\"ub-note\">");
        n = text(dst, n, SAY_MOTION_OFF);
        n = raw(dst, n, "</p>");
    }
    n = raw(dst, n, "</div></div><h2 class=\"ub-h\">");
    var hb : [512]u8 = [0; 512];
    var hn : u32 = jv_vput_val(hb[0..], 0, "board", d, obj_get(d, r, "board"));
    var jt : [64]u8 = [0; 64];
    const jl : u32 = fmt_raw(jt[0..], d, obj_get(d, r, "jobsPerArm"));
    hn = jv_vput_str(hb[0..], hn, "jobs", jt[0..(jl as usize)]);
    n = jv_fill(dst, n, SAY_RUNS_TITLE, hb[0..], hn, false);
    n = raw(dst, n, "</h2><div class=\"ub-arms\">");
    const a64 : i64 = arm_of(d, r, K_ARM_WINDOWS[0]);
    const a24 : i64 = arm_of(d, r, K_ARM_WINDOWS[1]);
    n = arm_card(dst, n, d, a64);
    n = arm_card(dst, n, d, a24);
    n = raw(dst, n, "</div><p class=\"ub-note\">");
    const wire : i64 = obj_get(d, r, "wire");
    var sb : [1024]u8 = [0; 1024];
    var sn : u32 = jv_vput_val(sb[0..], 0, "t64", d, obj_get(d, a64, "elapsedS"));
    sn = jv_vput_val(sb[0..], sn, "t24", d, obj_get(d, a24, "elapsedS"));
    sn = jv_vput_val(sb[0..], sn, "req", d, obj_get(d, wire, "requestBytes"));
    var bt : [64]u8 = [0; 64];
    var btl : u32 = fmt_raw(bt[0..], d, obj_get(d, wire, "baud"));
    sn = jv_vput_str(sb[0..], sn, "baud", bt[0..(btl as usize)]);
    btl = fmt_raw(bt[0..], d, obj_get(d, wire, "jobs"));
    sn = jv_vput_str(sb[0..], sn, "jobs", bt[0..(btl as usize)]);
    sn = jv_vput_val(sb[0..], sn, "wire", d, obj_get(d, wire, "seconds"));
    n = jv_fill(dst, n, SAY_SAME_TIME, sb[0..], sn, false);
    n = raw(dst, n, "</p><h3 class=\"ub-h3\">");
    const ed : i64 = obj_get(d, r, "edges");
    var eb : [256]u8 = [0; 256];
    var et : [64]u8 = [0; 64];
    const el : u32 = fmt_raw(et[0..], d, obj_get(d, arr_at(d, ed, 0), "planned"));
    const en : u32 = jv_vput_str(eb[0..], 0, "planned", et[0..(el as usize)]);
    n = jv_fill(dst, n, SAY_EDGE_TITLE, eb[0..], en, false);
    n = raw(dst, n, "</h3><ul class=\"ub-edges\">");
    const ec : u32 = arr_len(d, ed);
    var x : u32 = 0;
    while (x < ec) {
        const e : i64 = arr_at(d, ed, x);
        const slipped : bool = jv_truthy(d, obj_get(d, e, "slipped"));
        const shown : bool = kind(d, obj_get(d, e, "window")) == J_NUMBER and jv_num(d, obj_get(d, e, "window")) == WIN;
        n = raw(dst, n, "<li class=\"");
        if (slipped) { n = raw(dst, n, "is-over"); }
        if (slipped and shown) { n = put(dst, n, 32); }
        if (shown) { n = raw(dst, n, "is-shown"); }
        n = raw(dst, n, "\">");
        var xb : [1024]u8 = [0; 1024];
        var xn : u32 = jv_vput_val(xb[0..], 0, "w", d, obj_get(d, e, "window"));
        var xt : [64]u8 = [0; 64];
        var xl : u32 = fmt_raw(xt[0..], d, obj_get(d, e, "inFlight"));
        xn = jv_vput_str(xb[0..], xn, "bytes", xt[0..(xl as usize)]);
        xl = fmt_raw(xt[0..], d, obj_get(d, e, "receipts"));
        xn = jv_vput_str(xb[0..], xn, "ok", xt[0..(xl as usize)]);
        xl = fmt_raw(xt[0..], d, obj_get(d, e, "receiptsOf"));
        xn = jv_vput_str(xb[0..], xn, "planned", xt[0..(xl as usize)]);
        xl = fmt_raw(xt[0..], d, obj_get(d, e, "jobsSent"));
        xn = jv_vput_str(xb[0..], xn, "sent", xt[0..(xl as usize)]);
        if (slipped) { n = jv_fill(dst, n, SAY_EDGE_FAIL, xb[0..], xn, false); } else { n = jv_fill(dst, n, SAY_EDGE_PASS, xb[0..], xn, false); }
        n = raw(dst, n, " <button type=\"button\" class=\"t27-btn ub-show\">");
        var wb : [128]u8 = [0; 128];
        const wn : u32 = jv_vput_val(wb[0..], 0, "w", d, obj_get(d, e, "window"));
        n = jv_fill(dst, n, SAY_SHOW, wb[0..], wn, false);
        n = raw(dst, n, "</button></li>");
        x = x + 1;
    }
    n = raw(dst, n, "</ul><p class=\"ub-caveat\">");
    n = text(dst, n, SAY_CAVEAT);
    n = raw(dst, n, "</p><section class=\"ub-carried\"><h2 class=\"ub-h\">");
    const c : i64 = obj_get(d, r, "carried");
    var cb : [256]u8 = [0; 256];
    var cn : u32 = jv_vput_val(cb[0..], 0, "w", d, obj_get(d, c, "window"));
    n = jv_fill(dst, n, SAY_CARRIED_TITLE, cb[0..], cn, false);
    n = raw(dst, n, "</h2><p class=\"ub-note\">");
    cn = jv_vput_val(cb[0..], 0, "board", d, obj_get(d, r, "board"));
    n = jv_fill(dst, n, SAY_CARRIED_LINE, cb[0..], cn, false);
    n = raw(dst, n, "</p><dl>");
    var row : usize = 0;
    while (row < SAY_CARRIED_ROWS.len) {
        n = raw(dst, n, "<dt>");
        n = text(dst, n, SAY_CARRIED_ROWS[row]);
        n = raw(dst, n, "</dt><dd>");
        if (row == 0) { n = fmt_text(dst, n, d, obj_get(d, c, "matrices")); }
        if (row == 1) { n = fmt_text(dst, n, d, obj_get(d, c, "modelRows")); }
        if (row == 2) { n = fmt_text(dst, n, d, obj_get(d, c, "weights")); }
        if (row == 3) {
            n = fmt_text(dst, n, d, obj_get(d, c, "receipts"));
            n = raw(dst, n, " / ");
            n = fmt_text(dst, n, d, obj_get(d, c, "receiptsOf"));
        }
        if (row == 4) {
            n = fmt_text(dst, n, d, obj_get(d, c, "rows"));
            n = raw(dst, n, " / ");
            n = fmt_text(dst, n, d, obj_get(d, c, "rowsOf"));
        }
        if (row == 5) {
            n = jv_text(dst, n, d, obj_get(d, c, "elapsedS"));
            n = put(dst, n, 32);
            n = text(dst, n, SAY_SECONDS);
            n = raw(dst, n, ", ");
            var qb : [256]u8 = [0; 256];
            var qt : [64]u8 = [0; 64];
            const ql : u32 = fmt_raw(qt[0..], d, obj_get(d, c, "answersPerS"));
            const qn : u32 = jv_vput_str(qb[0..], 0, "rate", qt[0..(ql as usize)]);
            n = jv_fill(dst, n, SAY_RATE, qb[0..], qn, false);
        }
        n = raw(dst, n, "</dd>");
        row = row + 1;
    }
    n = raw(dst, n, "</dl>");
    if (jv_truthy(d, obj_get(d, r, "generationOnMac"))) {
        n = raw(dst, n, "<p class=\"ub-plain\">");
        n = text(dst, n, SAY_CARRIED_PLAIN);
        n = raw(dst, n, "</p>");
    }
    n = raw(dst, n, "</section><details class=\"ub-sources\"><summary>");
    n = text(dst, n, SAY_SOURCES);
    n = raw(dst, n, "</summary><ul>");
    const so : i64 = obj_get(d, r, "sources");
    const sc : u32 = arr_len(d, so);
    x = 0;
    while (x < sc) {
        const s : i64 = arr_at(d, so, x);
        n = raw(dst, n, "<li>");
        n = jv_text(dst, n, d, obj_get(d, r, "repo"));
        n = put(dst, n, 32);
        n = jv_text(dst, n, d, obj_get(d, s, "path"));
        n = put(dst, n, 32);
        n = text(dst, n, SAY_AT);
        n = put(dst, n, 32);
        n = jv_text(dst, n, d, obj_get(d, s, "commit"));
        n = raw(dst, n, "</li>");
        x = x + 1;
    }
    n = raw(dst, n, "</ul></details>");
    if (!ok(n)) { return 0; }
    return n;
}

fn put_all2(dst: []u8, n0: u32, s: []const u8, l: u32) -> u32 {
    var n : u32 = n0;
    var i : u32 = 0;
    while (i < l) {
        n = put_escaped(dst, n, s[i as usize]);
        i = i + 1;
    }
    return n;
}

/// The splicer follows only the names a module itself mentions, not the names the imported functions
/// mention. This anchor mentions every helper the writer, the JSON reader and the number rules call.
/// Never called.
pub fn imports_anchor(o: []u8, s: []const u8) -> u32 {
    var n : u32 = 0;
    n = n + (ok(0) as u32);
    n = n + OVER;
    n = n + put(o, 0, 0);
    n = n + raw(o, 0, s);
    n = n + put_escaped(o, 0, 0);
    n = n + text(o, 0, s);
    n = n + num(o, 0, 0);
    n = n + attr(o, 0, s, s);
    n = n + fill(o, 0, s, s, s, s, 0);
    n = n + fill_named(o, 0, s, s, s, s, s, s, s, s, s, s, s, s, s);
    n = n + dec_to(o, 0);
    n = n + (name_is(s, 0, 0, s) as u32);
    n = n + (is_word_byte(0) as u32);
    n = n + (H_LT as u32);
    n = n + (H_GT as u32);
    n = n + (H_AMP as u32);
    n = n + (H_QUOTE as u32);
    n = n + (H_APOS as u32);
    n = n + (H_SPACE as u32);
    n = n + (H_SLASH as u32);
    n = n + (H_EQ as u32);
    n = n + ((NO_SPAN < 0) as u32);
    n = n + ((SPAN > 0) as u32);
    n = n + (J_NONE as u32);
    n = n + (J_OBJECT as u32);
    n = n + (J_ARRAY as u32);
    n = n + (J_STRING as u32);
    n = n + (J_NUMBER as u32);
    n = n + (J_TRUE as u32);
    n = n + (J_FALSE as u32);
    n = n + (J_NULL as u32);
    n = n + (jspan(0, 0) as u32);
    n = n + (span_lo(0) as u32);
    n = n + (span_hi(0) as u32);
    n = n + (skip_ws(s, 0) as u32);
    n = n + (string_end(s, 0) as u32);
    n = n + (value_end(s, 0) as u32);
    n = n + (root(s) as u32);
    n = n + (kind(s, 0) as u32);
    n = n + (key_is(s, 0, 0, s) as u32);
    n = n + (obj_get(s, 0, s) as u32);
    n = n + arr_len(s, 0);
    n = n + (arr_at(s, 0, 0) as u32);
    n = n + hex4(s, 0);
    n = n + escape_at(s, 0, 0);
    n = n + cp_utf8_len(0);
    n = n + (cp_utf8_byte(0, 0) as u32);
    n = n + str_len(s, 0);
    n = n + (str_byte(s, 0, 0) as u32);
    n = n + JN_OVER;
    n = n + JN_CAP;
    n = n + ((JN_TWO52 > 0.0) as u32);
    n = n + ((JN_TWO53 > 0.0) as u32);
    n = n + jn_put(o, 0, 0);
    n = n + jn_raw(o, 0, s);
    n = n + jn_digits(o, 0);
    n = n + jn_mul(o, 0, 0);
    n = n + jn_mul2(o, 0, 0);
    n = n + jn_mul5(o, 0, 0);
    n = n + jn_shift(o, 0, 0);
    n = n + (jn_cmp(s, s, 0) as u32);
    n = n + (jn_expo(0.0) as u32);
    n = n + (jn_mant(0.0) as u32);
    n = n + ((jn_make(0, 0) > 0.0) as u32);
    n = n + jn_exact(o, 0, 0);
    n = n + jn_fscale(0);
    n = n + (js_is_nan(0.0) as u32);
    n = n + ((js_nan(0.0) > 0.0) as u32);
    n = n + ((js_inf(1.0) > 0.0) as u32);
    n = n + ((js_floor(0.0) > 0.0) as u32);
    n = n + ((js_ceil(0.0) > 0.0) as u32);
    n = n + ((js_max(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_min(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_round(0.0) > 0.0) as u32);
    n = n + (jn_shortest(o, 1.0) as u32);
    n = n + jn_copy(o, s, 0);
    n = n + jn_put_run(o, 0, s, 0, 0);
    n = n + jn_layout(o, 0, s, 0, 0);
    n = n + js_str_num(o, 0, 0.0);
    n = n + js_to_fixed(o, 0, 0.0, 0);
    n = n + js_locale_num(o, 0, 0.0);
    n = n + (jn_num_ok(s, 0, 0) as u32);
    n = n + (jn_cmp_text(s, 0, 0, 0, 0) as u32);
    n = n + ((js_parse_num(s, 0, 0) > 0.0) as u32);
    n = n + ((jn_dec_value(s, 0, 0) > 0.0) as u32);
    n = n + (jn_abs(0) as u32);
    n = n + js_str_u64(o, 0, 0);
    n = n + jv_str_to(o, 0, s, 0);
    n = n + jv_text_str(o, 0, s, 0);
    n = n + ((jv_numval(s, 0) > 0.0) as u32);
    n = n + jv_str(o, 0, s, 0);
    n = n + jv_text(o, 0, s, 0);
    n = n + (jv_is(s, 0, s) as u32);
    n = n + (jv_truthy(s, 0) as u32);
    n = n + (jv_is_ws(0) as u32);
    n = n + ((jv_number_of_text(s, 0) > 0.0) as u32);
    n = n + ((jv_num(s, 0) > 0.0) as u32);
    n = n + jv_vput_str(o, 0, s, s);
    n = n + jv_vput_f64(o, 0, s, 0.0);
    n = n + jv_vput_val(o, 0, s, s, 0);
    n = n + jv_vput_defined(o, 0, s, s, 0);
    n = n + jv_vput_fixed(o, 0, s, 0.0, 0);
    n = n + jv_kid(o, 0, s, 0);
    n = n + jv_find(s, 0, s);
    n = n + jv_fill(o, 0, s, s, 0, true);
    n = n + (jv_string_ok(s, 0) as u32);
    n = n + (jv_number_ok(s, 0) as u32);
    n = n + (jv_lit_ok(s, 0, s) as u32);
    n = n + (jv_valid(s) as u32);
    n = n + jv_ws_at(s, 0, 0);
    n = n + jv_ws_before(s, 0, 0);
    n = n + jv_digit_value(0);
    n = n + jv_fill_raw(o, 0, s, s, 0, true);
    n = n + jv_fill_with(o, 0, s, s, 0, true, true);
    return n;
}
