// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-assemble.t27 -- Text to a machine word and back: the t27a assembler
; Source of truth for public/widgets/cmp-assemble/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-assemble/logic.js -- the fn
; bodies of gHashTag/t27 specs/isa/t27a.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 25 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader types a line or takes a sample. assemble_status and assemble give the status and the word, listing_char the
; disassembly, is_canonical and reassemble the round trip. A bit is coloured by the field that changes when it is flipped.

; WHAT IT DOES NOT CLAIM:  it runs the assembler as WebAssembly, not the command line t27c asm that runs the same module as generated Rust. The
; colours are found by flipping each bit and asking the decoder, so they show what the spec's decoder reads, not a table kept here.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_assemble;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-assemble";
pub const TITLE : str = "Text to a machine word and back: the t27a assembler";
pub const DESCRIPTION : str = "The last stage turns a line of text into one 32-bit word. Type a line of t27a assembler and see the word, the line the disassembler prints for it, and which bits belong to which field.";
pub const IMAGE_ALT : str = "Assembler card: the line ADD t1, t2, t3 becomes the word 803088. The disassembler prints it back as the same line and the word is canonical. Four rows of eight bits colour the opcode in bits 7 to 0, the destination register, the first and second source registers, and the unused upper bits.";
pub const HOOK : str = "One line in, one 32-bit word out, and one table reads it back: a word that is not an instruction lists as .word, so every 32-bit number survives the round trip.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/isa/t27a.t27 (t27 master 90e797659): every word, status and listing is assemble, assemble_status, listing_char, is_canonical or reassemble, and the field owners are found with opcode_of, dst_of, t27a_src1, t27a_src2, v3_of and t27a_imm, fn bodies compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 25 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 8;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_MAX_TEXT : u8 = 40;
pub const K_START_SAMPLE : u8 = 0;
pub const K_ASM_OK : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine stages a spec passes; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_SAMPLES : [6]str = ["ADD t1, t2, t3", "LDI t4, t0, -12", "HALT t0, t0", "BUNDLE3 t1, t2, t3, t4", "NOP t0, t0", ".word 4294967295"];
pub const SAY_ASK : str = "How does one line of text become one 32-bit word, and come back?";
pub const SAY_TEXT_LABEL : str = "A line of t27a assembler";
pub const SAY_STATUS_NAMES : [8]str = ["ok", "no mnemonic", "unknown mnemonic", "bad separator", "bad register", "bad immediate", "trailing text", "bad word"];
pub const SAY_WORD : str = "word {0}";
pub const SAY_HEX : str = "{0} in hex";
pub const SAY_LISTING : str = "the disassembler prints";
pub const SAY_CANONICAL : str = "an instruction (canonical)";
pub const SAY_NOT_CANONICAL : str = "not an instruction: it lists as .word";
pub const SAY_ROUND : str = "assembles back to the same word";
pub const SAY_YES : str = "yes";
pub const SAY_NO : str = "no";
pub const SAY_FIELDS : [7]str = ["opcode", "destination", "source 1", "source 2", "third register", "immediate", "unused"];
pub const SAY_NOTE : str = "The disassembler prints one canonical line per word, so the assembler and the disassembler share one field table. A word with an undefined opcode, a register past t26 or a stray bit is printed as .word and still assembles back to itself.";
pub const SAY_SOURCE : str = "Logic: t27 spec isa/t27a.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_has_a_stage_of_nine {
    assert K_STAGE < 9;
    assert K_STAGE == 8;
}

test the_start_is_the_three_operand_sample {
    assert K_START_SAMPLE == 0;
    assert K_ASM_OK == 0;
    assert K_MAX_TEXT == 40;
}

test a_line_has_room_for_the_longest_sample {
    assert K_MAX_TEXT >= 22;
    assert K_MAX_TEXT < 64;
}
