// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-chars.t27 -- A letter, a digit or a gap: how the lexer sorts bytes
; Source of truth for public/widgets/cmp-chars/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-chars/logic.js -- the fn
; bodies of gHashTag/t27 specs/compiler/lexer.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 1 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader types a line (or takes a sample) and sees one cell per byte of its UTF-8, coloured by the
; answer of the lexer's own predicates; a second tape holds the bytes on both sides of every class boundary.
; Tapping a byte shows the answer of each of the five predicates for it.

; WHAT IT DOES NOT CLAIM:  it does not run the lexer: lexer.t27 scans a struct, which wasm cannot take. It runs the five
; byte tests the scanner is built from, and says so.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_chars;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-chars";
pub const TITLE : str = "A letter, a digit or a gap: how the lexer sorts bytes";
pub const DESCRIPTION : str = "Type a line of t27. The lexer reads it byte by byte and asks five questions of each: is_alpha, is_digit, is_hex_digit, is_alnum, is_whitespace. Tap a byte to see all five answers.";
pub const IMAGE_ALT : str = "Byte tape card: the line fn rate_2(x: u8) -> bool drawn as one cell per byte, letters and the underscore green, digits gold, spaces blue, every other byte red. The byte f is selected: is_alpha, is_hex_digit and is_alnum true, is_digit and is_whitespace false.";
pub const HOOK : str = "The underscore is a letter and f is both a letter and a digit. The lexer decides it all with five tiny functions over one byte.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/compiler/lexer.t27 (t27 master 90e797659): every class on the page is is_alpha, is_digit, is_hex_digit, is_alnum or is_whitespace, its fn bodies compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 1 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 0;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_START_BYTE : u8 = 102;
pub const K_EDGE_BYTES : [21]u8 = [9, 10, 13, 32, 47, 48, 57, 58, 64, 65, 70, 71, 90, 91, 95, 96, 97, 102, 103, 122, 123];
pub const K_MAX_TEXT : u8 = 40;
pub const K_START_SAMPLE : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine stages a spec passes; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_SAMPLES : [3]str = ["fn rate_2(x: u8) -> bool", "const MAX = 0x1F;", "if (a_1 >= b2) { }"];
pub const SAY_ASK : str = "How does the lexer know a letter from a digit from a gap?";
pub const SAY_TEXT_LABEL : str = "A line of t27";
pub const SAY_EDGES : str = "Bytes on both sides of each boundary";
pub const SAY_CLASSES : [4]str = ["letter", "digit", "gap", "other"];
pub const SAY_PREDICATES : [5]str = ["is_alpha", "is_digit", "is_hex_digit", "is_alnum", "is_whitespace"];
pub const SAY_TRUE : str = "true";
pub const SAY_FALSE : str = "false";
pub const SAY_BYTE : str = "byte {0}";
pub const SAY_COUNTS : [4]str = ["letters", "digits", "gaps", "other"];
pub const SAY_NOTHING : str = "An empty line has no bytes to sort.";
pub const SAY_NOTE : str = "The lexer reads bytes, not letters: a character outside ASCII is two or more bytes, and each of them is other. The underscore counts as a letter. Hex digits run to f, so f is both a letter and a hex digit.";
pub const SAY_SOURCE : str = "Logic: t27 spec compiler/lexer.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_has_a_stage_of_nine {
    assert K_STAGE < 9;
    assert K_STAGE == 0;
}

test edges_come_in_pairs_around_each_class {
    assert K_EDGE_BYTES[1] == 10;
    assert K_EDGE_BYTES[5] == 48;
    assert K_EDGE_BYTES[6] == 57;
    assert K_EDGE_BYTES[9] == 65;
    assert K_EDGE_BYTES[14] == 95;
}

test the_start_is_a_byte_that_is_two_things {
    assert K_START_BYTE == 102;
    assert K_START_SAMPLE == 0;
}
