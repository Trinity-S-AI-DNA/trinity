// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-builds.t27 -- Seven builds, one commit: what made two binaries differ
; Source of truth for public/widgets/cmp-builds/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-builds/logic.js -- the fn
; bodies of gHashTag/t27 specs/compiler/theory/reproducible.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 23 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader picks a binary, t27c or t27b, and a cause model. The table lists what varied in each of the seven
; builds. predicts_same fills a grid of build pairs, mispredicts counts the pairs the model gets wrong, pairs_differing the pairs that differ.

; WHAT IT DOES NOT CLAIM:  the hashes themselves are 64-bit, which wasm cannot take, so which two builds matched is not shown here; the counts are
; the spec's. The seven builds ran on 2026-10-09 on two labs; they are the spec's record, not a run of this page.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_builds;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-builds";
pub const TITLE : str = "Seven builds, one commit: what made two binaries differ";
pub const DESCRIPTION : str = "Seven builds of one commit gave t27c four different binaries and t27b one. Pick a binary and a cause model: it explains the builds only if it gets no pair of builds wrong.";
pub const IMAGE_ALT : str = "Builds card: for t27c, 17 of 21 pairs of builds of one commit differ. The model naming the git abbreviation and the cache path gets 0 of 21 pairs wrong, so the verdict for reproducible builds is false, with a named cause. A grid of the seven builds shows the pairs the model says match, and a table what varied in each build.";
pub const HOOK : str = "The same source gave four t27c binaries. Two inputs that are not the source explained all of it: the length of the git hash baked in, and the path of the cache.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/compiler/theory/reproducible.t27 (t27 master 90e797659): every number is one of build_host, build_abbrev, build_cargo_home, build_clone, build_env_varied, pairs_differing, predicts_same, mispredicts or c9_verdict, fn bodies compiled to wasm (logic.js); the runs are the spec's record of 2026-10-09", "Course 12 of t27.ai, t27-compiler: lesson 23 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 7;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_BUILDS : u8 = 7;
pub const K_BUILD_PAIRS : u8 = 21;
pub const K_MODEL_CAUSE : u8 = 0;
pub const K_MODEL_NO_ABBREV : u8 = 1;
pub const K_MODEL_NO_CARGO_HOME : u8 = 2;
pub const K_MODEL_HOST_ONLY : u8 = 3;
pub const K_MODEL_NONE : u8 = 4;
pub const K_BIN_T27C : u8 = 0;
pub const K_BIN_T27B : u8 = 1;
pub const K_FALSE3 : u8 = 0;
pub const K_UNKNOWN3 : u8 = 1;
pub const K_TRUE3 : u8 = 2;
pub const K_PRESET_BIN : [4]u8 = [0, 0, 1, 1];
pub const K_PRESET_MODEL : [4]u8 = [0, 3, 4, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine steps of this course; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [4]str = ["t27c, the two named causes", "t27c, the host alone", "t27b, no cause at all", "t27b, the two causes"];
pub const SAY_ASK : str = "Why did builds of one commit not give one binary, and how do we know?";
pub const SAY_BIN : str = "binary";
pub const SAY_BINS : [2]str = ["t27c", "t27b"];
pub const SAY_MODEL : str = "cause model";
pub const SAY_MODELS : [5]str = ["git abbreviation and cache path", "cache path alone", "git abbreviation alone", "host alone", "no cause: all the same"];
pub const SAY_BUILD_NAMES : [7]str = ["A", "B", "C", "D", "E", "X", "Y"];
pub const SAY_COLUMNS : [5]str = ["host", "hash length", "cache", "clone", "env"];
pub const SAY_CLONES : [4]str = ["partial", "full", "depth 1", "copy"];
pub const SAY_YES : str = "yes";
pub const SAY_NO : str = "no";
pub const SAY_DIFFER : str = "pairs of builds that differ";
pub const SAY_WRONG : str = "pairs the model gets wrong";
pub const SAY_OF : str = "{0} of {1}";
pub const SAY_VERDICTS : [3]str = ["false, with a named cause", "unknown", "true: every build the same"];
pub const SAY_GRID : str = "pairs the model says give the same binary";
pub const SAY_TABLE : str = "what varied in each build";
pub const SAY_SAME_MARK : str = "same";
pub const SAY_NOTE : str = "A binary is reproducible only if every build of one commit gives one hash while the builds vary what is not the source. It is false when two builds differ and a named input explains every pair, and unknown when nothing explains them.";
pub const SAY_SOURCE : str = "Logic: t27 spec compiler/theory/reproducible.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_is_one_of_nine_course_steps {
    assert K_STAGE < 9;
    assert K_STAGE == 7;
}

test seven_builds_make_twenty_one_pairs {
    assert K_BUILDS == 7;
    assert K_BUILD_PAIRS == 21;
    assert K_BUILDS * (K_BUILDS - 1) == 2 * K_BUILD_PAIRS;
}

test five_models_two_binaries_and_a_named_start {
    assert K_MODEL_CAUSE == 0;
    assert K_MODEL_NONE == 4;
    assert K_BIN_T27C == 0;
    assert K_PRESET_MODEL[2] == K_MODEL_NONE;
    assert K_PRESET_BIN[2] == K_BIN_T27B;
    assert K_START_PRESET == 0;
}
