// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-stale.t27 -- A value gone stale: when the optimizer shares a repeat
; Source of truth for public/widgets/cmp-stale/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-stale/logic.js -- the fn
; bodies of gHashTag/t27 specs/compiler/codegen_conformance.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 14 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader picks one of four conformance functions and sets its inputs. The widget calls the compiled fn and shows
; its result, the one recorded wrong answer where the spec states it, and a line on the rule the case pins.

; WHAT IT DOES NOT CLAIM:  it does not run the optimizer, and it computes no wrong answer: the only defective result shown, 12 for
; stale_operand(5), is the number the spec's header records. The other three cases are shown with their right answers only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_stale;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-stale";
pub const TITLE : str = "A value gone stale: when the optimizer shares a repeat";
pub const DESCRIPTION : str = "Common subexpression elimination shares a repeated expression, and may only do it when nothing changed in between. Four small functions pin the rule. Pick one, set its input and read the result.";
pub const IMAGE_ALT : str = "Stale card: stale_operand called with 5 returns 106, in green, because the second x + 1 reads x after it was set to 99. A red banner records the wrong answer of the defective compiler, 12. Under it the steps of the function are written out, and the rule the case pins.";
pub const HOOK : str = "stale_operand(5) is 106. A compiler that shared the second x + 1 with the first returned 12, and it all still compiled: the bug was in the value.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/compiler/codegen_conformance.t27 (t27 master 90e797659): every result is stale_operand, shared_product, folded_twice or counted_three_times, fn bodies compiled to wasm (logic.js); the recorded wrong answer is from the spec's header", "Course 12 of t27.ai, t27-compiler: lesson 14 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 4;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_MAX_X : u32 = 262143;
pub const K_MAX_Y : u8 = 100;
pub const K_STALE_VECTOR : u8 = 5;
pub const K_STALE_DEFECT : u8 = 12;
pub const K_PRESET_FN : [4]u8 = [0, 1, 2, 3];
pub const K_PRESET_X : [4]u32 = [5, 3, 131071, 0];
pub const K_PRESET_Y : [4]u8 = [0, 4, 0, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine stages a spec passes; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [4]str = ["stale_operand(5)", "shared_product(3, 4)", "folded_twice(131071)", "counted_three_times()"];
pub const SAY_ASK : str = "When may an optimizer share a repeated expression, and when must it not?";
pub const SAY_FN : str = "function";
pub const SAY_X : str = "x";
pub const SAY_Y : str = "y";
pub const SAY_FNS : [4]str = ["stale_operand", "shared_product", "folded_twice", "counted_three_times"];
pub const SAY_BODIES : [4]str = ["p = x + 1  then  x = 99  then  q = x + 1  returns p + q", "p = x * y  then  q = x * y  returns p + q", "s = x  then  s = (s & 65535) + (s >> 16), twice  returns s", "count = 0  then  count = count + 1, three times  returns count"];
pub const SAY_RULES : [4]str = ["x was set to 99 between the two repeats, so the second x + 1 is a new value and may not borrow the first.", "Nothing changed between the two products, so the repeat is still shared: the optimizer is kept, not turned off.", "The second fold reads what the first wrote: 131071 folds to 65536, and 65536 folds to 1.", "Each count + 1 reads the count the one before wrote, so three of them make three."];
pub const SAY_RESULT : str = "returns {0}";
pub const SAY_DEFECT : str = "The defective compiler returned {0} for {1}";
pub const SAY_NOTE : str = "The temp that replaces a repeat is only safe if nothing it reads was written after the first use. The temp either read a local above its declaration, which did not compile, or a value from before a reassignment, which compiled and was wrong.";
pub const SAY_SOURCE : str = "Logic: t27 spec compiler/codegen_conformance.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_has_a_stage_of_nine {
    assert K_STAGE < 9;
    assert K_STAGE == 4;
}

test the_recorded_defect_is_twelve_for_five {
    assert K_STALE_VECTOR == 5;
    assert K_STALE_DEFECT == 12;
    assert K_STALE_DEFECT == 2 * (K_STALE_VECTOR + 1);
}

test presets_pick_each_of_the_four_functions {
    assert K_PRESET_FN[0] == 0;
    assert K_PRESET_FN[3] == 3;
    assert K_PRESET_X[2] == 131071;
    assert K_PRESET_X[2] <= K_MAX_X;
    assert K_START_PRESET == 0;
}
