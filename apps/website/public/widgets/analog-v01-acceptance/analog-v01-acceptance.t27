// SPDX-License-Identifier: Apache-2.0
; specs/widgets/analog-v01-acceptance.t27 -- the acceptance scoreboard of t27 analog v0.1, and one comparator number beside it
; Source of truth for public/widgets/analog-v01-acceptance/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; Epic Trinity-S-AI-DNA/t27#10486 (t27 analog emulation v0.1), milestone M6, issue #11972.

; THE SOURCE: every number here is copied from docs/analog/v0.1-release-notes.md (PR #11973) and from nothing else. The
; table is its "Acceptance" table: the per-block checks of specs/analog/accept_sar.t27 applied to our models of the SAR
; ADC of the golden deck, 13 blocks and 30 rows, the counts pinned there by the tests as_all_blocks and as_all_rows. The
; diagram is its M4b-q row (#11325): the dynamic comparator's decision time on PSP103 against ngspice's own run.

; HOW A WRONG NUMBER FAILS: the K_ constants hold each count once, the tests below add them up (9 + 0 + 4 = 13 blocks,
; 26 + 0 + 4 = 30 rows), pin each table cell and flow step to its K_ value, and recompute the 1.75 % from the two decision
; times in integers. A number edited in one place and not the others fails the compile of this file.

; WHAT IT DOES NOT CLAIM: a row t27 does not compute is never a pass, so the 4 NOT MODELLED blocks stay on the page as
; open gaps. The integration block passes as a behavioural converter fitted to the golden deck, and the report's corners
; smoke suite is not modelled; both scopes are the release notes' own words (its section "What it does not claim"). The comparator row is one circuit at one corner (tt) against one ngspice run; it is not an accuracy claim for
; the other blocks. Nothing here is a speed claim: v0.1 makes none, the release notes say so in their own words.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_analog_v01_acceptance;

pub const KIND : str = "widget-tool";
pub const ID : str = "analog-v01-acceptance";
pub const TITLE : str = "t27 analog v0.1: SAR ADC acceptance, 9 of 13 blocks";
pub const DESCRIPTION : str = "The acceptance scoreboard of the SAR ADC golden deck in t27 analog v0.1: 9 of 13 blocks pass, 0 fail, 4 are not modelled. Beside it, one comparator decision time against ngspice.";
pub const IMAGE_ALT : str = "A black and white scoreboard of the SAR ADC golden deck in t27 analog v0.1. Blocks: 9 pass, 0 fail, 4 not modelled (dff, DAC_control, DAC_control_top, neg_bottom_plate_logic), 13 in all; integration is a fitted behavioural converter. Rows: 26 pass, 0 fail, 4 not modelled, 30 in all. Below, the comparator decision time, 613.07 ps in t27 against 602.54 ps in ngspice. Not a speed claim.";
pub const HOOK : str = "9 of 13 blocks pass, 0 fail, 4 not modelled: the t27 analog v0.1 scoreboard, with the gaps named.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [2]str = ["docs/analog/v0.1-release-notes.md of Trinity-S-AI-DNA/t27 (PR #11973): its Acceptance table (the per-block checks of specs/analog/accept_sar.t27, 13 blocks and 30 rows, counts pinned there by the tests as_all_blocks and as_all_rows) and its M4b-q comparator row (#11325, PSP103)", "Nothing is measured on this page: every number is copied from that file, and the tests of this spec pin the sums and the 1.75 % in integers. v0.1 makes no speed claim and this page makes none"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The numbers, each once --------------------------------------------------------------------
pub const K_BLOCKS_PASS : u8 = 9;
pub const K_BLOCKS_FAIL : u8 = 0;
pub const K_BLOCKS_NOT_MODELLED : u8 = 4;
pub const K_BLOCKS_ALL : u8 = 13;
pub const K_ROWS_PASS : u8 = 26;
pub const K_ROWS_FAIL : u8 = 0;
pub const K_ROWS_NOT_MODELLED : u8 = 4;
pub const K_ROWS_ALL : u8 = 30;

; Decision times in hundredths of a picosecond, so the 1.75 % is recomputed in integers: 613.07 ps and 602.54 ps.
pub const K_COMPARATOR_T27_CENTI_PS : u32 = 61307;
pub const K_COMPARATOR_NGSPICE_CENTI_PS : u32 = 60254;
pub const K_COMPARATOR_GAP_CENTI_PERCENT : u32 = 175;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "SAR ADC golden deck: acceptance result by block and by row";
pub const SAY_TABLE_HEAD : [4]str = ["Result", "Blocks (13)", "Rows (30)", "Which blocks"];
pub const SAY_TABLE_CELLS : [16]str = ["PASS", "9", "26", "clock_gen, SAR_logic, integration (a behavioural converter fitted to the golden deck), nand, nor, tgate, dynamic_comparator, inverter, tracking_switch", "FAIL", "0", "0", "none", "NOT MODELLED", "4", "4", "dff, DAC_control, DAC_control_top, neg_bottom_plate_logic", "Total", "13", "30", "the 13 blocks of the golden SAR ADC"];
pub const K_TABLE_COLS : u8 = 4;
pub const K_TABLE_ROWS : u8 = 4;
pub const K_TABLE_CELLS : u16 = 16;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "Dynamic comparator, decision time on PSP103 (M4b-q)";
pub const SAY_FLOW_STEPS : [3]str = ["t27 model at +2 mV: 613.07 ps", "ngspice's own run: 602.54 ps", "t27 above ngspice by 1.75 %"];
pub const K_FLOW_STEPS : u8 = 3;
pub const SAY_NOTE : str = "Nothing here is a speed claim: v0.1 makes none. A row t27 does not compute is never a pass, so the 4 NOT MODELLED blocks stay open, and so does the report's corners smoke suite. A transistor-level row passes only when ngspice-47 with PSP103 agrees within a stated bar.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 3;
    assert K_FLOW_STEPS > 1;
}

test the_blocks_add_up_to_thirteen {
    assert K_BLOCKS_PASS + K_BLOCKS_FAIL + K_BLOCKS_NOT_MODELLED == K_BLOCKS_ALL;
    assert K_BLOCKS_ALL == 13;
    assert K_BLOCKS_PASS == 9;
    assert K_BLOCKS_FAIL == 0;
    assert K_BLOCKS_NOT_MODELLED == 4;
}

test the_rows_add_up_to_thirty {
    assert K_ROWS_PASS + K_ROWS_FAIL + K_ROWS_NOT_MODELLED == K_ROWS_ALL;
    assert K_ROWS_ALL == 30;
    assert K_ROWS_PASS == 26;
    assert K_ROWS_FAIL == 0;
    assert K_ROWS_NOT_MODELLED == 4;
}

test every_not_modelled_block_has_a_row_and_nothing_is_a_pass_by_default {
    assert K_ROWS_NOT_MODELLED >= K_BLOCKS_NOT_MODELLED;
    assert K_ROWS_PASS >= K_BLOCKS_PASS;
}

test the_table_cells_show_the_k_numbers {
    assert SAY_TABLE_CELLS[0] == "PASS";
    assert SAY_TABLE_CELLS[1] == "9";
    assert SAY_TABLE_CELLS[2] == "26";
    assert SAY_TABLE_CELLS[4] == "FAIL";
    assert SAY_TABLE_CELLS[5] == "0";
    assert SAY_TABLE_CELLS[6] == "0";
    assert SAY_TABLE_CELLS[8] == "NOT MODELLED";
    assert SAY_TABLE_CELLS[9] == "4";
    assert SAY_TABLE_CELLS[10] == "4";
    assert SAY_TABLE_CELLS[3] == "clock_gen, SAR_logic, integration (a behavioural converter fitted to the golden deck), nand, nor, tgate, dynamic_comparator, inverter, tracking_switch";
    assert SAY_TABLE_CELLS[7] == "none";
    assert SAY_TABLE_CELLS[11] == "dff, DAC_control, DAC_control_top, neg_bottom_plate_logic";
    assert SAY_TABLE_CELLS[12] == "Total";
    assert SAY_TABLE_CELLS[13] == "13";
    assert SAY_TABLE_CELLS[14] == "30";
}

test the_note_keeps_the_scope_of_every_pass_and_claims_no_speed {
    assert SAY_NOTE == "Nothing here is a speed claim: v0.1 makes none. A row t27 does not compute is never a pass, so the 4 NOT MODELLED blocks stay open, and so does the report's corners smoke suite. A transistor-level row passes only when ngspice-47 with PSP103 agrees within a stated bar.";
    assert K_BLOCKS_NOT_MODELLED == 4;
}

test the_comparator_gap_is_recomputed_from_the_two_times {
    assert K_COMPARATOR_T27_CENTI_PS > K_COMPARATOR_NGSPICE_CENTI_PS;
    assert K_COMPARATOR_GAP_CENTI_PERCENT * 100 - 50 <= (K_COMPARATOR_T27_CENTI_PS - K_COMPARATOR_NGSPICE_CENTI_PS) * 1000000 / K_COMPARATOR_NGSPICE_CENTI_PS;
    assert K_COMPARATOR_GAP_CENTI_PERCENT * 100 + 50 > (K_COMPARATOR_T27_CENTI_PS - K_COMPARATOR_NGSPICE_CENTI_PS) * 1000000 / K_COMPARATOR_NGSPICE_CENTI_PS;
}

test the_flow_steps_show_the_comparator_numbers {
    assert K_COMPARATOR_T27_CENTI_PS == 61307;
    assert K_COMPARATOR_NGSPICE_CENTI_PS == 60254;
    assert K_COMPARATOR_GAP_CENTI_PERCENT == 175;
    assert SAY_FLOW_STEPS[0] == "t27 model at +2 mV: 613.07 ps";
    assert SAY_FLOW_STEPS[1] == "ngspice's own run: 602.54 ps";
    assert SAY_FLOW_STEPS[2] == "t27 above ngspice by 1.75 %";
}
