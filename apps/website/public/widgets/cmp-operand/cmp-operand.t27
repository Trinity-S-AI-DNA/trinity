// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-operand.t27 -- An operator with nothing after it: the dropped right side
; Source of truth for public/widgets/cmp-operand/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-operand/logic.js -- the fn
; bodies of gHashTag/t27 specs/compiler/operator_text.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 5 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader types a rendered expression or takes a sample from the spec's own vectors. has_empty_operand says
; whether an operator has nothing after it. A tape tries each operator of a list as (x op ) and as (x op y).

; WHAT IT DOES NOT CLAIM:  it does not show where the hole is: the spec answers yes or no, and the page shows no more. compound_binop,
; the other rule of the spec, returns an optional text, which wasm cannot take, and is not run here.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_operand;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-operand";
pub const TITLE : str = "An operator with nothing after it: the dropped right side";
pub const DESCRIPTION : str = "A backend once printed (BOARD_NAME != ) and left the C compiler to find the hole. has_empty_operand reads an expression as text and says whether an operator lost its right side.";
pub const IMAGE_ALT : str = "Operand card: the expression (BOARD_NAME != ) is flagged as having an empty operand, in red. Below it a tape of seventeen operators, each tried as (x op ) and as (x op y): the dropped form is caught for fifteen of them, and missed for the tilde and the dot, which are not binary operators.";
pub const HOOK : str = "A parenthesis, a space and an operator are enough to spot a hole in generated code: the rule is a loop over bytes, and its vectors come from a real miscompile.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/compiler/operator_text.t27 (t27 master 90e797659): every verdict on the page is has_empty_operand, its fn body compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 5 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 1;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_START_SAMPLE : u8 = 0;
pub const K_MAX_TEXT : u8 = 40;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine steps of this course; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_SAMPLES : [5]str = ["(BOARD_NAME != )", "(a != b)", "(x == 1) && (y >= )", "a - -1", "x>>"];
pub const SAY_ASK : str = "How can a backend tell that an operator lost its right side?";
pub const SAY_TEXT_LABEL : str = "A rendered expression";
pub const SAY_HOLE : str = "an operator has nothing after it";
pub const SAY_WHOLE : str = "every operator has a right side";
pub const SAY_NOTHING : str = "An empty text has no operator, so no hole.";
pub const SAY_OPS : [17]str = ["+", "-", "*", "/", "%", "<", ">", "==", "!=", "&", "|", "^", "&&", "<<=", ">>=", "~", "."];
pub const SAY_DROPPED_FORM : str = "(x {0} )";
pub const SAY_KEPT_FORM : str = "(x {0} y)";
pub const SAY_TABLE : str = "Each operator, dropped and kept";
pub const SAY_CAUGHT : str = "caught";
pub const SAY_MISSED : str = "missed";
pub const SAY_ALARM : str = "false alarm";
pub const SAY_NOTE : str = "The rule skips an operator run and the spaces after it, then asks for something other than the end of the text or a closing parenthesis. The same loop answers for every operator in the tape; the tilde and the dot are not in its set of operator bytes.";
pub const SAY_SOURCE : str = "Logic: t27 spec compiler/operator_text.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_is_one_of_nine_course_steps {
    assert K_STAGE < 9;
    assert K_STAGE == 1;
}

test the_first_sample_is_the_dropped_right_side_of_the_issue {
    assert K_START_SAMPLE == 0;
    assert K_MAX_TEXT >= 19;
}

test a_sample_text_fits_the_box {
    assert K_MAX_TEXT == 40;
    assert K_MAX_TEXT > 2 * 16;
}
