// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-night.t27 -- The night watch: four checks, one verdict, one report
; Source of truth for public/widgets/hive-night/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-night/logic.js -- the fn
; bodies of gHashTag/t27 specs/automation/card-chat-night-watch.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 25 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader taps each of four checks between pass, fail and unmeasured and says
; whether an issue is open. The host counts fails and unmeasured; the verdict is night_verdict of
; the counts and the column night_report(verdict, issue open).

; WHAT IT DOES NOT CLAIM:  it runs no check at night: the four results are what the reader taps.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_night;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-night";
pub const TITLE : str = "The night watch: four checks, one verdict, one report";
pub const DESCRIPTION : str = "Every night four card checks run. Tap each to pass, fail or unmeasured: night_verdict sums them up and night_report says whether to open an issue, comment, close it or stay silent.";
pub const IMAGE_ALT : str = "Night watch card: four comb cells, thread green, status door red, merges green, parity green. The verdict reads FAIL; an issue is already open, so the report card sits in the COMMENT column of five: silent, open issue, comment, close issue, leave as is.";
pub const HOOK : str = "Any fail is a fail; else anything unmeasured leaves things as they are. A night that could not measure never closes an issue.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/automation/card-chat-night-watch.t27 (t27 master c42f8fb40): every value on the page is night_verdict and night_report, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 25 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_CHECKS : u8 = 4;
pub const K_CARD_CHECK_VERDICTS : u8 = 4;
pub const K_PRESET_C0 : [4]u8 = [0, 0, 0, 0];
pub const K_PRESET_C1 : [4]u8 = [1, 0, 1, 2];
pub const K_PRESET_C2 : [4]u8 = [0, 0, 0, 0];
pub const K_PRESET_C3 : [4]u8 = [0, 0, 0, 0];
pub const K_PRESET_OPEN : [4]u8 = [1, 1, 0, 1];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["A fail, issue open", "All pass, issue open", "A fail, no issue", "Unmeasured"];
pub const SAY_ASK : str = "The card checks ran overnight. What should the watch do in the morning?";
pub const SAY_CHECK_NAMES : [4]str = ["thread", "status door", "merges", "parity"];
pub const SAY_RESULTS : [3]str = ["pass", "fail", "unmeasured"];
pub const SAY_TAP : str = "tap a check: pass, fail, unmeasured";
pub const SAY_OPEN : str = "an issue is already open";
pub const SAY_VERDICT_NAMES : [3]str = ["PASS", "FAIL", "UNMEASURED"];
pub const SAY_REPORT_NAMES : [5]str = ["silent", "open an issue", "comment", "close the issue", "leave as is"];
pub const SAY_TONIGHT : str = "tonight";
pub const SAY_COUNTS : str = "{0} fail, {1} unmeasured";
pub const SAY_NOTE : str = "A pass with an open issue closes it, so a fixed card does not leave a stale alarm. A night with nothing to say sends nothing.";
pub const SAY_SOURCE : str = "Logic: t27 spec automation/card-chat-night-watch.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test four_checks {
    assert K_CHECKS == K_CARD_CHECK_VERDICTS;
    assert K_CHECKS == 4;
}

test the_start_has_one_fail {
    assert K_PRESET_C1[0] == 1;
    assert K_PRESET_OPEN[0] == 1;
    assert K_PRESET_C3[3] == 0;
}
