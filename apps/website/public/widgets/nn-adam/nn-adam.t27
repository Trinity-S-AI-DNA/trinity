// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-adam.t27 -- Adam: momentum, a running scale and the bias correction
; Source of truth for public/widgets/nn-adam/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-adam/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/optimizer/adam.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 18 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader sets the number of steps and three gradients from -50 to 50. The path is
; descend(n) of the spec (lr 0.1 on (x - 3)^2 from 0); the bars and tiles are first_step(g0, g1, g2,
; which, i) on weights (1, 2, 3) at lr 0.001.

; WHAT IT DOES NOT CLAIM: the bowl is one weight, as in the SGD lesson, so the two paths can be
; compared, not ranked.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_adam;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-adam";
pub const TITLE : str = "Adam: the optimizer most networks are trained with";
pub const DESCRIPTION : str = "Watch Adam carry a weight from 0 to the minimum at 3, then set three gradients of any size: the bias correction makes the first step lr times their sign, whatever their size.";
pub const IMAGE_ALT : str = "Adam card: the green path rises from 0, passes the white dashed minimum at 3, peaks near 3.18 and settles at 3.00005 by step 200. Below, three bars of the first moment m read 0.20, -4.00 and 0.05 while the weights read 0.9990, 2.0010 and 2.9990. Tiles read x 3.00005 and step 1 at 0.1000.";
pub const HOOK : str = "Gradients 2, -40 and 0.5 all move their weights by exactly 0.001 on step 1. Adam reaches 3.00005 in 200 steps at lr 0.1.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/optimizer/adam.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 18 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_STEPS_HI : u8 = 200;
pub const K_MINIMUM : u8 = 3;
pub const K_Y_LO : u8 = 0;
pub const K_Y_HI : u8 = 4;
pub const K_Y_TICKS : [5]u8 = [0, 1, 2, 3, 4];
pub const K_STEP_TICKS : [5]u8 = [0, 50, 100, 150, 200];
pub const K_G_LO_C : i16 = -5000;
pub const K_G_HI_C : u16 = 5000;
pub const K_BAR_LO : i8 = -5;
pub const K_BAR_HI : u8 = 5;
pub const K_BAR_TICKS : [5]i8 = [-4, -2, 0, 2, 4];
pub const K_PRESET_STEPS : [4]u8 = [200, 10, 50, 200];
pub const K_PRESET_G0_C : [4]i16 = [200, 100, -100, 5000];
pub const K_PRESET_G1_C : [4]i16 = [-4000, 100, -100, 1];
pub const K_PRESET_G2_C : [4]i16 = [50, 100, -100, -5000];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["200 steps; g 2, -40, 0.5", "10 steps; equal g", "50 steps; negative g", "200 steps; g 50, 0.01, -50"];
pub const SAY_ASK : str = "Why is Adam the optimizer most networks are trained with?";
pub const SAY_STEPS : str = "steps";
pub const SAY_G : str = "gradient";
pub const SAY_W : str = "w";
pub const SAY_PLOT_LABEL : str = "The weight after every Adam step, from 0 toward the minimum at 3";
pub const SAY_FIRST_LABEL : str = "Step 1 on weights 1, 2, 3: the first moment m and the weight after";
pub const SAY_PATH : str = "Adam, lr 0.1";
pub const SAY_MIN : str = "the minimum";
pub const SAY_X_NOW : str = "x after the steps";
pub const SAY_X_ONE : str = "after step 1";
pub const SAY_W_AFTER : str = "weights after step 1";
pub const SAY_V : str = "second moment v";
pub const SAY_NOTE : str = "m and v start at zero, so early on they are too small; dividing by 1 - beta^t corrects them. On step 1 that makes m / sqrt(v) exactly the sign of the gradient.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/optimizer/adam.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_gradients_are_symmetric {
    assert K_G_LO_C + K_G_HI_C == 0;
    assert K_PRESET_G0_C[3] == K_G_HI_C;
    assert K_PRESET_G2_C[3] == K_G_LO_C;
}

test the_minimum_is_inside_the_axis {
    assert K_MINIMUM == 3;
    assert K_Y_HI > K_MINIMUM;
    assert K_PRESET_STEPS[0] == K_STEPS_HI;
}
