// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-ddc.t27 -- Diverse double-compiling: three routes to one compiler text
; Source of truth for public/widgets/cmp-ddc/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-ddc/logic.js -- the fn
; bodies of gHashTag/t27 specs/compiler/theory/toolchain.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 24 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader sets, for the three routes, whether the route was built and whether its second stage was byte-identical to
; the compiler text, and whether the routes share a front end. ddc_verdict names the verdict and fixpoint_only_passes says what route A alone would.

; WHAT IT DOES NOT CLAIM:  it builds no compiler. The three presets are the spec's recorded runs, whose numbers are held equal to its constants,
; and the spec says equality on every route proves nothing about a defect all routes share.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_ddc;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-ddc";
pub const TITLE : str = "Diverse double-compiling: three routes to one compiler text";
pub const DESCRIPTION : str = "Build the compiler again by three routes and compare each result with the compiler text itself. Set which routes were built and which matched, and see what the check can and cannot prove.";
pub const IMAGE_ALT : str = "Double-compiling card: three routes were built, gen-c with cc, t27b and the Zig reference, and each is listed as matching the compiler text. Because the front end is shared by every route, the verdict is that the back ends agree, not that the compiler is independently rebuilt. A second line says the self-host fixpoint alone would also have passed.";
pub const HOOK : str = "Rebuild the compiler three ways and compare. One run found a miscompile that the self-host fixpoint alone passed; a shared front end keeps it back-end only.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/compiler/theory/toolchain.t27 (t27 master 90e797659): every verdict is ddc_verdict or fixpoint_only_passes, fn bodies compiled to wasm (logic.js); the three recorded runs are the spec's own constants", "Course 12 of t27.ai, t27-compiler: lesson 24 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 7;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_ROUTE_GENC_CC : u8 = 1;
pub const K_ROUTE_T27B : u8 = 2;
pub const K_ROUTE_ZIG : u8 = 4;
pub const K_ROUTE_ALL : u8 = 7;
pub const K_DDC_CANNOT_RUN : u8 = 0;
pub const K_DDC_MISCOMPILE : u8 = 1;
pub const K_DDC_AGREE_BACK_ENDS : u8 = 2;
pub const K_DDC_AGREE_INDEPENDENT : u8 = 3;
pub const K_RUN_BEFORE_BUILT : u8 = 1;
pub const K_RUN_BEFORE_EQUAL : u8 = 1;
pub const K_RUN_FIRST_ZIG_BUILT : u8 = 7;
pub const K_RUN_FIRST_ZIG_EQUAL : u8 = 3;
pub const K_RUN_0FBD183BA_BUILT : u8 = 7;
pub const K_RUN_0FBD183BA_EQUAL : u8 = 7;
pub const K_PRESET_BUILT : [4]u8 = [7, 7, 7, 1];
pub const K_PRESET_EQUAL : [4]u8 = [7, 3, 7, 1];
pub const K_PRESET_SHARED : [4]u8 = [1, 1, 0, 1];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine stages a spec passes; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [4]str = ["The run at 0fbd183ba", "The first run with three routes", "Without a shared front end", "Before the fix"];
pub const SAY_ASK : str = "If we rebuild the compiler by three routes, what does a match prove?";
pub const SAY_ROUTES : [3]str = ["gen-c, then cc", "t27b, AArch64", "Zig reference"];
pub const SAY_BUILT : str = "built";
pub const SAY_NOT_BUILT : str = "not built";
pub const SAY_MATCHES : str = "built, matches the compiler text";
pub const SAY_DIFFERS : str = "built, differs from the compiler text";
pub const SAY_EQUAL : str = "second stage equals the compiler text";
pub const SAY_SHARED : str = "the routes share one front end";
pub const SAY_VERDICTS : [4]str = ["cannot run", "a miscompile is proven", "the back ends agree", "independent agreement"];
pub const SAY_VERDICT_LINES : [4]str = ["Fewer than two routes were built: the check cannot run.", "A built route whose second stage differs from the compiler text proves its back end miscompiles it.", "Every built route matches. With one front end for all of them, only the back ends are compared.", "Every built route matches and the front ends are independent."];
pub const SAY_FIXPOINT : str = "the fixpoint alone, route A";
pub const SAY_PASSES : str = "would pass";
pub const SAY_FAILS : str = "would not pass";
pub const SAY_NOTE : str = "A route whose stage two differs from the compiler text proves a miscompile. Equality on every route proves nothing about a defect all routes share, so shared parts of the front end keep the verdict at agreement of back ends.";
pub const SAY_SOURCE : str = "Logic: t27 spec compiler/theory/toolchain.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_has_a_stage_of_nine {
    assert K_STAGE < 9;
    assert K_STAGE == 7;
}

test three_routes_are_three_bits {
    assert K_ROUTE_GENC_CC == 1;
    assert K_ROUTE_T27B == 2;
    assert K_ROUTE_ZIG == 4;
    assert K_ROUTE_GENC_CC + K_ROUTE_T27B + K_ROUTE_ZIG == K_ROUTE_ALL;
}

test the_three_recorded_runs_and_the_start {
    assert K_RUN_BEFORE_BUILT == 1;
    assert K_RUN_FIRST_ZIG_EQUAL == 3;
    assert K_RUN_0FBD183BA_EQUAL == K_RUN_0FBD183BA_BUILT;
    assert K_PRESET_BUILT[0] == K_RUN_0FBD183BA_BUILT;
    assert K_PRESET_EQUAL[1] == K_RUN_FIRST_ZIG_EQUAL;
    assert K_START_PRESET == 0;
}
