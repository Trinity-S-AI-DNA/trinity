; --- Tests --------------------------------------------------------------------------------------
test the_lists_name_7_series_cells {
    assert K_LUT_TYPES[0] == "LUT1";
    assert K_LUT_TYPES[5] == "LUT6";
    assert K_CARRY_TYPES[0] == "CARRY4";
    assert K_MUX_TYPES[1] == "MUXF8";
    assert K_CLOCKED_TYPES[0] == "FDRE";
    assert K_CLOCKED_TYPES[2] == "FDCE";
}

test the_sample_path_is_its_classes_summed {
    assert K_SAMPLE_COMMANDS[1] == "ltp -noff t:FD* %n";
    assert K_SAMPLE_LENGTHS[1] == 23;
    assert K_SAMPLE_LUT + K_SAMPLE_CARRY + K_SAMPLE_MUX + K_SAMPLE_IO + K_SAMPLE_CLOCKED == K_SAMPLE_LENGTHS[1];
    assert K_SAMPLE_PATH[0] == "IBUF";
    assert same_text(K_SAMPLE_PATH[2], K_CARRY_TYPES[0]);
    assert same_text(K_SAMPLE_PATH[12], K_MUX_TYPES[0]);
    assert K_SAMPLE_PATH[22] == "LUT6";
    assert K_SAMPLE_LUT == 11;
    assert K_SAMPLE_CLOCKED == 0;
}

test plain_noff_walks_through_two_flip_flops {
    assert K_SAMPLE_COMMANDS[0] == "ltp -noff";
    assert K_SAMPLE_LENGTHS[0] == K_SAMPLE_LENGTHS[1] + 4;
    assert same_text(K_SAMPLE_PLAIN_TAIL[0], K_CLOCKED_TYPES[2]);
    assert same_text(K_SAMPLE_PLAIN_TAIL[2], K_CLOCKED_TYPES[2]);
    assert K_SAMPLE_PLAIN_TAIL[3] == "OBUF";
    assert K_SAMPLE_PLAIN_CLOCKED == 2;
}

test the_card_and_the_page {
    assert K_CARD_W == 1200;
    assert K_CARD_H == 630;
    assert READS_LOCAL_FILES == true;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
}


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, issue #10938, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/lut-depth/tool.js (241 lines of hand-written JavaScript)
; and, as the page's reader, ltpparse.js. The words and numbers above are unchanged: the view prints
; SAY_ constants and uses K_ lists, it writes no English of its own.
; --
; THE READER IS FOLDED IN, NOT IMPORTED. specs/widgets/lut_depth_logic.t27 is the differential-tested
; port of ltpparse.js. Its functions keep their tables in module-level `pub var`s (BLK, STP, CEL ...)
; and t27c's `use` does not carry a `pub var` across modules (measured on 0.5.2: "undeclared
; identifier"), so ltp_parse cannot be imported. The block between the two "FOLDED" markers is that
; module's text, lines 55-565, byte for byte except that B_CR (defined here by page_reader) is not
; declared again; the build script below diffs the region against the logic module. Change the
; reader there, then regenerate this region.
; --
; Host protocol (host.js; all exports of this module):
;   w_base(url)          the page's directory address, for the sample link (the original used new URL(..., import.meta.url))
;   w_init(hash)         the page opens
;   w_data(i, bytes)     the sample file (W_DATA_FILE) was fetched; w_data_failed(i) when it was not
;   w_click(i)           button i: 0 the sample, 1 "Draw the path", 2 "Clear", 3.. the path-block buttons
;   w_input(i, bytes)    control i (among input and textarea, in page order) changed: i 1 is the paste box
;   w_file(z, name, size) -> 1 | 0    a file was picked or dropped on drop zone z: 1 = send its bytes
;   w_file_data(z, bytes) / w_file_failed(z)   the bytes, or "could not be read"
;   w_drag(z, over) -> 1 | 0          the drag entered (1) or left/dropped (0) zone z; 1 = the page changed
;   w_effect(k, dst) -> len           effect k after the last event: bytes 'v', control index = set that control's value to ''
;   w_render(dst)        the page's HTML, length (0 on overflow)
; Buffers (all module-level, static): the sample SAMP 2 MiB, the paste box PASTE 2 MiB, the two
; shown/candidate texts TA and TB 2 MiB each, the status STATUS 64 KiB, a file name FNAME 1 KiB.
; Not carried over from JavaScript: a text over W_TEXT_CAP (2,097,152 bytes) is refused with the
; page's own "too big" sentence and W_TEXT_CAP in place of K_MAX_CHARS (16,000,000); the reader's
; tables hold 1024 blocks, 16384 steps, 1024 loops and 16384 dump cells (a text over a table limit
; says "could not read"); a page whose HTML passes the host's 1 MiB render buffer is not drawn;
; a file's bytes are not decoded: invalid UTF-8 reaches the page as the browser decodes the HTML;
; the Clear button shows the cached sample, the original fetched it again.

use widgets::html_out::ok;
use widgets::html_out::OVER;
use widgets::html_out::put;
use widgets::html_out::raw;
use widgets::html_out::put_escaped;
use widgets::html_out::text;
use widgets::html_out::num;
use widgets::html_out::num_grouped;
use widgets::html_out::attr;
use widgets::html_out::fill;
use widgets::html_out::H_LT;
use widgets::html_out::H_GT;
use widgets::html_out::H_AMP;
use widgets::html_out::H_QUOTE;
use widgets::html_out::H_APOS;
use widgets::html_out::H_SPACE;
use widgets::html_out::H_SLASH;
use widgets::html_out::H_EQ;
use widgets::page_reader::match_in;
use widgets::page_reader::is_space;
use widgets::page_reader::pack;
use widgets::page_reader::lo_of;
use widgets::page_reader::hi_of;
use widgets::page_reader::NO_TEXT;
use widgets::page_reader::PACK;
use widgets::page_reader::B_SPACE;
use widgets::page_reader::B_TAB;
use widgets::page_reader::B_CR;

pub const W_DATA_FILE : str = "./sample.ltp.txt";
pub const W_TEXT_CAP : u32 = 2097152;
pub const W_STATUS_CAP : u32 = 65536;

; FOLDED-BEGIN lut_depth_logic.t27 55-565
pub const W_B_NL : u8 = 10;
pub const W_B_RPAREN : u8 = 41;
pub const W_B_BACKSLASH : u8 = 92;
pub const W_B_BACKTICK : u8 = 96;

pub const W_CLS_OTHER : u32 = 5;
pub const W_CLS_UNKNOWN : u32 = 6;
pub const W_CLS_START : u32 = 7;

pub const W_MAX_BLOCKS : usize = 1024;
pub const W_MAX_STEPS : usize = 16384;
pub const W_MAX_LOOPS : usize = 1024;
pub const W_MAX_CELLS : usize = 16384;

pub var BLK : [16384]u64 = [0; 16384];
pub var STP : [147456]u32 = [0; 147456];
pub var LOP : [4096]u32 = [0; 4096];
pub var CEL : [65536]u32 = [0; 65536];
pub var SC : [8]u64 = [0; 8];
pub var INFO : [8]u64 = [0; 8];

pub fn is_digit(b: u8) -> bool {
    return b >= 48 and b <= 57;
}

/// JavaScript's \w for the ASCII range.
pub fn is_word(b: u8) -> bool {
    return is_digit(b) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95;
}

pub fn skip_ws(s: []const u8, p0: usize, hi: usize) -> usize {
    var p : usize = p0;
    while (p < hi and is_space(s[p])) { p = p + 1; }
    return p;
}

/// The end of the run of non-space bytes that starts at p0.
pub fn tok_end(s: []const u8, p0: usize, hi: usize) -> usize {
    var p : usize = p0;
    while (p < hi and !is_space(s[p])) { p = p + 1; }
    return p;
}

pub fn digits_end(s: []const u8, p0: usize, hi: usize) -> usize {
    var p : usize = p0;
    while (p < hi and is_digit(s[p])) { p = p + 1; }
    return p;
}

/// The value of the digits s[a..b), held at a ceiling so a long run cannot wrap.
pub fn digits_val(s: []const u8, a: usize, b: usize) -> u64 {
    var v : u64 = 0;
    var k : usize = a;
    while (k < b) {
        if (v < 100000000000000000) { v = v * 10 + ((s[k] - 48) as u64); }
        k = k + 1;
    }
    return v;
}

/// The end of s[lo..hi) with its trailing space removed (JS trimEnd for ASCII).
pub fn rtrim_end(s: []const u8, lo: usize, hi: usize) -> usize {
    var e : usize = hi;
    while (e > lo and is_space(s[e - 1])) { e = e - 1; }
    return e;
}

pub fn has_cr(s: []const u8, a: usize, b: usize) -> bool {
    var k : usize = a;
    while (k < b) {
        if (s[k] == B_CR) { return true; }
        k = k + 1;
    }
    return false;
}

/// The first offset in [from, hi) where w starts, wholly inside the range, or NO_TEXT.
pub fn find_in(s: []const u8, from: usize, hi: usize, w: []const u8) -> i64 {
    var p : usize = from;
    while (p + w.len <= hi) {
        if (match_in(s, p, hi, w)) { return p as i64; }
        p = p + 1;
    }
    return NO_TEXT;
}

/// The last offset in [lo, hi) where w starts, wholly inside the range, or NO_TEXT.
pub fn rfind_in(s: []const u8, lo: usize, hi: usize, w: []const u8) -> i64 {
    if (hi < lo + w.len) { return NO_TEXT; }
    var p : usize = hi - w.len + 1;
    while (p > lo) {
        p = p - 1;
        if (match_in(s, p, hi, w)) { return p as i64; }
    }
    return NO_TEXT;
}

pub fn next_nl(s: []const u8, from: usize) -> usize {
    var p : usize = from;
    while (p < s.len and s[p] != W_B_NL) { p = p + 1; }
    return p;
}

/// bare(): a public yosys name loses its leading backslash; the start offset of the result.
pub fn bare_lo(s: []const u8, lo: usize, hi: usize) -> usize {
    if (lo < hi and s[lo] == W_B_BACKSLASH) { return lo + 1; }
    return lo;
}

/// Are s[a..b) and t[c..d) the same bytes?
pub fn same_range(s: []const u8, a: usize, b: usize, t: []const u8, c: usize, d: usize) -> bool {
    if (b - a != d - c) { return false; }
    var k : usize = 0;
    while (a + k < b) {
        if (s[a + k] != t[c + k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// classOf for a non-empty type: the first of lut, carry, mux, io, clocked whose list holds it, else other.
pub fn class_of(s: []const u8, tl: usize, th: usize, lists: []const u8) -> u32 {
    var best : u32 = W_CLS_OTHER;
    var a : usize = 0;
    while (a < lists.len) {
        const e : usize = next_nl(lists, a);
        if (e > a + 1 and lists[a] >= 48 and lists[a] <= 52) {
            if (same_range(s, tl, th, lists, a + 1, e)) {
                const c : u32 = (lists[a] - 48) as u32;
                if (c < best) { best = c; }
            }
        }
        a = e + 1;
    }
    return best;
}

/// The tail of HEAD_RE from q: " (length=<n>):" and then only space to the end of the line.
pub fn head_tail(s: []const u8, q: usize, hi: usize) -> bool {
    if (!match_in(s, q, hi, " (length=")) { return false; }
    const a : usize = q + 9;
    const d : usize = digits_end(s, a, hi);
    if (d == a) { return false; }
    if (!match_in(s, d, hi, "):")) { return false; }
    if (skip_ws(s, d + 2, hi) != hi) { return false; }
    SC[0] = digits_val(s, a, d);
    return true;
}

/// HEAD_RE on the line [lo, hi): the packed range of the module name (lazy, so the first name that
/// lets the tail match), the length in SC[0]; NO_TEXT when the line is no header.
pub fn head_match(s: []const u8, lo: usize, hi: usize) -> i64 {
    var f : i64 = find_in(s, lo, hi, "Longest topological path in ");
    while (f >= 0) {
        const ns : usize = (f as usize) + 28;
        var q : usize = ns + 1;
        var dead : bool = false;
        while (q <= hi and !dead) {
            if (s[q - 1] == B_CR) {
                dead = true;
            } else {
                if (head_tail(s, q, hi)) { return pack(ns, q); }
                q = q + 1;
            }
        }
        f = find_in(s, (f as usize) + 1, hi, "Longest topological path in ");
    }
    return NO_TEXT;
}

/// LOOP_RE on the line: the packed range of the net bit, the module in SC[1]..SC[2]; NO_TEXT when none.
pub fn loop_match(s: []const u8, lo: usize, hi: usize) -> i64 {
    const te : usize = rtrim_end(s, lo, hi);
    var ts : usize = te;
    while (ts > lo and !is_space(s[ts - 1])) { ts = ts - 1; }
    if (ts == te) { return NO_TEXT; }
    if (ts < lo + 4) { return NO_TEXT; }
    if (!match_in(s, ts - 4, hi, " in ")) { return NO_TEXT; }
    const bhi : usize = ts - 4;
    var f : i64 = find_in(s, lo, hi, "Detected loop at ");
    while (f >= 0) {
        const bl : usize = (f as usize) + 17;
        if (bl + 1 <= bhi and !has_cr(s, bl, bhi)) {
            SC[1] = ts as u64;
            SC[2] = te as u64;
            return pack(bl, bhi);
        }
        f = find_in(s, (f as usize) + 1, hi, "Detected loop at ");
    }
    return NO_TEXT;
}

/// CELL_RE on the line: type token in SC[0]..SC[1], name token in SC[2]..SC[3].
pub fn cell_match(s: []const u8, lo: usize, hi: usize) -> bool {
    var p : usize = skip_ws(s, lo, hi);
    if (!match_in(s, p, hi, "cell")) { return false; }
    p = p + 4;
    var q : usize = skip_ws(s, p, hi);
    if (q == p) { return false; }
    p = q;
    q = tok_end(s, p, hi);
    if (q == p) { return false; }
    SC[0] = p as u64;
    SC[1] = q as u64;
    p = skip_ws(s, q, hi);
    if (p == q) { return false; }
    q = tok_end(s, p, hi);
    if (q == p) { return false; }
    SC[2] = p as u64;
    SC[3] = q as u64;
    if (skip_ws(s, q, hi) != hi) { return false; }
    return true;
}

/// STEP_RE on the line: the step number in SC[0] (held at a ceiling), the start of the rest in SC[1].
pub fn step_match(s: []const u8, lo: usize, hi: usize) -> bool {
    const p : usize = skip_ws(s, lo, hi);
    const d : usize = digits_end(s, p, hi);
    if (d == p) { return false; }
    if (!match_in(s, d, hi, ": ")) { return false; }
    if (has_cr(s, d + 2, hi)) { return false; }
    SC[0] = digits_val(s, p, d);
    SC[1] = (d + 2) as u64;
    return true;
}

/// \b after a word character: the end of the line or a non-word byte.
pub fn boundary_after(s: []const u8, p: usize, hi: usize) -> bool {
    return p >= hi or !is_word(s[p]);
}

/// The first backtick in [from, hi), else hi.
pub fn backtick_or_end(s: []const u8, from: usize, hi: usize) -> usize {
    var p : usize = from;
    while (p < hi and s[p] != W_B_BACKTICK) { p = p + 1; }
    return p;
}

/// CMD_RES[0]: yosys> ltp ...   (also yosys [module]> ltp ...)
pub fn cmd_prompt(s: []const u8, lo: usize, hi: usize) -> i64 {
    var p : usize = skip_ws(s, lo, hi);
    if (!match_in(s, p, hi, "yosys")) { return NO_TEXT; }
    p = p + 5;
    if (match_in(s, p, hi, " [")) {
        const c : i64 = find_in(s, p + 2, hi, "]");
        if (c >= 0) { p = (c as usize) + 1; }
    }
    if (!match_in(s, p, hi, "> ")) { return NO_TEXT; }
    p = p + 2;
    if (!match_in(s, p, hi, "ltp")) { return NO_TEXT; }
    if (!boundary_after(s, p + 3, hi)) { return NO_TEXT; }
    const e : usize = rtrim_end(s, p + 3, hi);
    if (has_cr(s, p + 3, e)) { return NO_TEXT; }
    return pack(p, e);
}

/// CMD_RES[1]: -- Running command `ltp ...' --
pub fn cmd_running_ltp(s: []const u8, lo: usize, hi: usize) -> i64 {
    if (!match_in(s, lo, hi, "-- Running command `ltp")) { return NO_TEXT; }
    const t : usize = lo + 23;
    if (!boundary_after(s, t, hi)) { return NO_TEXT; }
    const r : usize = backtick_or_end(s, t, hi);
    const e : i64 = rfind_in(s, t, r, "' --");
    if (e < 0) { return NO_TEXT; }
    return pack(lo + 20, e as usize);
}

/// CMD_RES[2]: -- Running command `... ltp ...' -- with the last whole word ltp that lets the rest fit.
pub fn cmd_running_any(s: []const u8, lo: usize, hi: usize) -> i64 {
    if (!match_in(s, lo, hi, "-- Running command `")) { return NO_TEXT; }
    const a : usize = lo + 20;
    if (hi < a + 3) { return NO_TEXT; }
    var t : usize = hi - 2;
    while (t > a) {
        t = t - 1;
        if (match_in(s, t, hi, "ltp") and !has_cr(s, a, t)) {
            if (t == a or !is_word(s[t - 1])) {
                if (boundary_after(s, t + 3, hi)) {
                    const r : usize = backtick_or_end(s, t + 3, hi);
                    const e : i64 = rfind_in(s, t + 3, r, "' --");
                    if (e >= 0) { return pack(a, e as usize); }
                }
            }
        }
    }
    return NO_TEXT;
}

pub fn cmd_match(s: []const u8, lo: usize, hi: usize) -> i64 {
    var c : i64 = cmd_prompt(s, lo, hi);
    if (c < 0) { c = cmd_running_ltp(s, lo, hi); }
    if (c < 0) { c = cmd_running_any(s, lo, hi); }
    return c;
}

/// The end of the line that starts at ls: the offset of its newline (or the end), minus a CR just before the newline.
pub fn line_hi(s: []const u8, ls: usize, le: usize) -> usize {
    if (le < s.len and le > ls and s[le - 1] == B_CR) { return le - 1; }
    return le;
}

/// Is every byte of the text a space? (JS: no line has anything left after trim.)
pub fn all_space(s: []const u8) -> bool {
    return skip_ws(s, 0, s.len) == s.len;
}

/// Pass 1: every RTLIL `cell <type> <name>` line, in order, into CEL as name_lo, name_hi, type_lo, type_hi.
/// Returns false when there are more than W_MAX_CELLS.
pub fn read_cells(s: []const u8) -> bool {
    var ls : usize = 0;
    var n : usize = 0;
    var distinct : u64 = 0;
    while (ls <= s.len) {
        const le : usize = next_nl(s, ls);
        const hi : usize = line_hi(s, ls, le);
        if (cell_match(s, ls, hi)) {
            if (n >= W_MAX_CELLS) { return false; }
            const tl : usize = bare_lo(s, SC[0] as usize, SC[1] as usize);
            const th : usize = SC[1] as usize;
            const nl : usize = bare_lo(s, SC[2] as usize, SC[3] as usize);
            const nh : usize = SC[3] as usize;
            var seen : bool = false;
            var k : usize = 0;
            while (k < n and !seen) {
                if (same_range(s, CEL[k * 4], CEL[k * 4 + 1], s, nl, nh)) { seen = true; }
                k = k + 1;
            }
            if (!seen) { distinct = distinct + 1; }
            CEL[n * 4] = nl as u32;
            CEL[n * 4 + 1] = nh as u32;
            CEL[n * 4 + 2] = tl as u32;
            CEL[n * 4 + 3] = th as u32;
            n = n + 1;
        }
        ls = le + 1;
    }
    INFO[3] = distinct;
    INFO[5] = n as u64;
    return true;
}

/// Pass 3, one step: its type from the dump (the last cell line with its via as name), and its class.
pub fn type_step(s: []const u8, i: usize, lists: []const u8) -> u32 {
    const vf : u32 = STP[i * 9 + 2];
    const vl : usize = STP[i * 9 + 3] as usize;
    const vh : usize = STP[i * 9 + 4] as usize;
    STP[i * 9 + 5] = 0;
    STP[i * 9 + 6] = 0;
    STP[i * 9 + 7] = 0;
    if (vf == 0 or vh <= vl) {
        STP[i * 9 + 8] = W_CLS_START;
        return W_CLS_START;
    }
    var k : usize = INFO[5] as usize;
    var cls : u32 = W_CLS_UNKNOWN;
    var found : bool = false;
    while (k > 0 and !found) {
        k = k - 1;
        if (same_range(s, CEL[k * 4], CEL[k * 4 + 1], s, vl, vh)) {
            found = true;
            STP[i * 9 + 5] = 1;
            STP[i * 9 + 6] = CEL[k * 4 + 2];
            STP[i * 9 + 7] = CEL[k * 4 + 3];
            if (CEL[k * 4 + 3] > CEL[k * 4 + 2]) {
                cls = class_of(s, CEL[k * 4 + 2] as usize, CEL[k * 4 + 3] as usize, lists);
            }
        }
    }
    STP[i * 9 + 8] = cls;
    return cls;
}

/// parseLtp. Returns 0 ok, 1 empty, 2 noltp, 3 loop, -1 over a table limit.
pub fn ltp_parse(text: []const u8, lists: []const u8) -> i32 {
    INFO[0] = 0;
    INFO[1] = 0;
    INFO[2] = 0;
    INFO[3] = 0;
    INFO[4] = 0;
    INFO[5] = 0;
    if (all_space(text)) { return 1; }
    if (!read_cells(text)) { return -1; }
    var nb : usize = 0;
    var ns : usize = 0;
    var nl : usize = 0;
    var cmd_set : u64 = 0;
    var cmd_lo : u64 = 0;
    var cmd_hi : u64 = 0;
    var cur : i64 = -1;
    var ls : usize = 0;
    while (ls <= text.len) {
        const le : usize = next_nl(text, ls);
        const hi : usize = line_hi(text, ls, le);
        const c : i64 = cmd_match(text, ls, hi);
        if (c >= 0) {
            cmd_set = 1;
            cmd_lo = lo_of(c) as u64;
            cmd_hi = hi_of(c) as u64;
        }
        var handled : bool = false;
        const lm : i64 = loop_match(text, ls, hi);
        if (lm >= 0) {
            if (nl >= W_MAX_LOOPS) { return -1; }
            LOP[nl * 4] = lo_of(lm) as u32;
            LOP[nl * 4 + 1] = hi_of(lm) as u32;
            LOP[nl * 4 + 2] = SC[1] as u32;
            LOP[nl * 4 + 3] = SC[2] as u32;
            nl = nl + 1;
            handled = true;
        }
        if (!handled) {
            const hm : i64 = head_match(text, ls, hi);
            if (hm >= 0) {
                if (nb >= W_MAX_BLOCKS) { return -1; }
                const len : u64 = SC[0];
                const ml : usize = bare_lo(text, lo_of(hm), hi_of(hm));
                const b : usize = nb * 16;
                BLK[b] = ml as u64;
                BLK[b + 1] = hi_of(hm) as u64;
                BLK[b + 2] = len;
                BLK[b + 3] = cmd_set;
                BLK[b + 4] = cmd_lo;
                BLK[b + 5] = cmd_hi;
                BLK[b + 6] = 0;
                BLK[b + 7] = ns as u64;
                var z : usize = 8;
                while (z < 15) {
                    BLK[b + z] = 0;
                    z = z + 1;
                }
                cur = nb as i64;
                nb = nb + 1;
                handled = true;
            }
        }
        if (!handled and cur >= 0) {
            const cb : usize = (cur as usize) * 16;
            var took : bool = false;
            if (step_match(text, ls, hi)) {
                if (SC[0] == BLK[cb + 6]) {
                    if (ns >= W_MAX_STEPS) { return -1; }
                    var bl : usize = SC[1] as usize;
                    var bh : usize = hi;
                    var vf : u32 = 0;
                    var vl : usize = 0;
                    var vh : usize = 0;
                    if (bh > bl and text[bh - 1] == W_B_RPAREN) {
                        const at : i64 = rfind_in(text, bl, bh, " (via ");
                        if (at >= 0) {
                            vl = bare_lo(text, (at as usize) + 6, bh - 1);
                            vh = bh - 1;
                            vf = 1;
                            bh = at as usize;
                        }
                    }
                    STP[ns * 9] = bl as u32;
                    STP[ns * 9 + 1] = bh as u32;
                    STP[ns * 9 + 2] = vf;
                    STP[ns * 9 + 3] = vl as u32;
                    STP[ns * 9 + 4] = vh as u32;
                    ns = ns + 1;
                    BLK[cb + 6] = BLK[cb + 6] + 1;
                    took = true;
                }
            }
            if (!took and BLK[cb + 6] > 0) { cur = -1; }
        }
        ls = le + 1;
    }
    INFO[0] = nb as u64;
    INFO[1] = nl as u64;
    INFO[4] = ns as u64;
    if (nb == 0) {
        if (nl > 0) { return 3; }
        return 2;
    }
    INFO[2] = 0;
    if (INFO[3] > 0) { INFO[2] = 1; }
    var bi : usize = 0;
    while (bi < nb) {
        const first : usize = BLK[bi * 16 + 7] as usize;
        const cnt : usize = BLK[bi * 16 + 6] as usize;
        var k : usize = 0;
        while (k < cnt) {
            const cls : u32 = type_step(text, first + k, lists);
            if (cls < W_CLS_START) { BLK[bi * 16 + 8 + (cls as usize)] = BLK[bi * 16 + 8 + (cls as usize)] + 1; }
            k = k + 1;
        }
        bi = bi + 1;
    }
    return 0;
}

pub fn ltp_info(f: u32) -> u64 {
    return INFO[f as usize];
}

pub fn ltp_blk(b: u32, f: u32) -> u64 {
    return BLK[(b as usize) * 16 + (f as usize)];
}

pub fn ltp_step(i: u32, f: u32) -> u32 {
    return STP[(i as usize) * 9 + (f as usize)];
}

pub fn ltp_loop(l: u32, f: u32) -> u32 {
    return LOP[(l as usize) * 4 + (f as usize)];
}

// ---------------------------------------------------------------------------------------------
; FOLDED-END

pub var LISTS : [1024]u8 = [0; 1024];
pub var LISTS_N : usize = 0;
pub var SAMP : [2097152]u8 = [0; 2097152];
pub var SAMP_LEN : u32 = 0;
pub var SAMP_STATE : u32 = 0;
pub var PASTE : [2097152]u8 = [0; 2097152];
pub var PASTE_LEN : u32 = 0;
pub var PASTE_CHARS : u32 = 0;
pub var PASTE_FIT : bool = true;
pub var TA : [2097152]u8 = [0; 2097152];
pub var TA_LEN : u32 = 0;
pub var TB : [2097152]u8 = [0; 2097152];
pub var TB_LEN : u32 = 0;
pub var SRC : u32 = 0;
pub var PICK : u32 = 0;
pub var RESULT_HIDDEN : bool = true;
pub var SAMPLE_ON : bool = false;
pub var DRAGGING : bool = false;
pub var EFF_CLEAR : bool = false;
pub var STATUS : [65536]u8 = [0; 65536];
pub var STATUS_LEN : u32 = 0;
pub var FNAME : [1024]u8 = [0; 1024];
pub var FNAME_LEN : u32 = 0;
pub var FSIZE : u32 = 0;
pub var BASE : [1024]u8 = [0; 1024];
pub var BASE_LEN : u32 = 0;
pub var G1 : [32]u8 = [0; 32];
pub var G2 : [32]u8 = [0; 32];
pub var G3 : [32]u8 = [0; 32];
pub var WARN_TYPES : [1024]u8 = [0; 1024];

fn lists_add(c: u8, s: []const u8) -> usize {
    LISTS[LISTS_N] = c;
    LISTS_N = LISTS_N + 1;
    var k : usize = 0;
    while (k < s.len) {
        LISTS[LISTS_N] = s[k];
        LISTS_N = LISTS_N + 1;
        k = k + 1;
    }
    LISTS[LISTS_N] = W_B_NL;
    LISTS_N = LISTS_N + 1;
    return LISTS_N;
}

/// listsOf(W): the cell-type lists, one class digit then the type per line, in the reader's layout.
fn lists_build() -> usize {
    LISTS_N = 0;
    var i : usize = 0;
    while (i < 7) { lists_add(48, K_LUT_TYPES[i]); i = i + 1; }
    i = 0;
    while (i < 1) { lists_add(49, K_CARRY_TYPES[i]); i = i + 1; }
    i = 0;
    while (i < 2) { lists_add(50, K_MUX_TYPES[i]); i = i + 1; }
    i = 0;
    while (i < 7) { lists_add(51, K_IO_TYPES[i]); i = i + 1; }
    i = 0;
    while (i < 11) { lists_add(52, K_CLOCKED_TYPES[i]); i = i + 1; }
    return LISTS_N;
}

/// The bytes of text number cs: 1 the sample, 2 TA, 3 TB (what the page shows is one of them).
fn buf(cs: u32) -> []const u8 {
    if (cs == 1) { return SAMP[0..(SAMP_LEN as usize)]; }
    if (cs == 2) { return TA[0..(TA_LEN as usize)]; }
    return TB[0..(TB_LEN as usize)];
}

/// The other of TA and TB than the one the page shows.
fn cand_src() -> u32 {
    if (SRC == 2) { return 3; }
    return 2;
}

/// Copy s into the candidate buffer; its number.
fn load_cand(s: []const u8) -> u32 {
    const cs : u32 = cand_src();
    var k : usize = 0;
    if (cs == 2) {
        while (k < s.len) { TA[k] = s[k]; k = k + 1; }
        TA_LEN = s.len as u32;
    } else {
        while (k < s.len) { TB[k] = s[k]; k = k + 1; }
        TB_LEN = s.len as u32;
    }
    return cs;
}

/// JavaScript's String length of UTF-8 bytes: a lead byte counts one, or two from 240 up (a surrogate pair).
fn utf16_len(s: []const u8) -> u32 {
    var n : u32 = 0;
    var k : usize = 0;
    while (k < s.len) {
        const b : u8 = s[k];
        if (b < 128 or b >= 192) {
            n = n + 1;
            if (b >= 240) { n = n + 1; }
        }
        k = k + 1;
    }
    return n;
}

/// The offset after a leading byte order mark, which Blob.text() and Response.text() drop.
fn bom_skip(s: []const u8) -> usize {
    if (s.len >= 3 and s[0] == 239 and s[1] == 187 and s[2] == 191) { return 3; }
    return 0;
}

fn fin(n: u32) -> u32 {
    if (n == OVER) { return 0; }
    return n;
}

fn status_note() -> u32 {
    STATUS_LEN = fin(text(STATUS[0..], 0, SAY_LOCAL_NOTE));
    return 0;
}

fn status_err_load() -> u32 {
    STATUS_LEN = fin(text(STATUS[0..], 0, SAY_ERR_LOAD));
    return 0;
}

fn picked_into(n0: u32) -> u32 {
    const gl : u32 = num_grouped(G1[0..], 0, FSIZE as u64);
    return fill(STATUS[0..], n0, SAY_PICKED, FNAME[0..(FNAME_LEN as usize)], G1[0..(gl as usize)], "", 2);
}

fn status_picked() -> u32 {
    STATUS_LEN = fin(picked_into(0));
    return 0;
}

/// readText's success status: "<name>. <note>", the name being "pasted text" or the picked-file line.
fn status_read(kind: u32) -> u32 {
    var n : u32 = 0;
    if (kind == 0) { n = text(STATUS[0..], 0, SAY_PASTED); } else { n = picked_into(0); }
    n = raw(STATUS[0..], n, ". ");
    n = text(STATUS[0..], n, SAY_LOCAL_NOTE);
    STATUS_LEN = fin(n);
    return 0;
}

fn status_too_big(chars: u64) -> u32 {
    const a : u32 = num_grouped(G1[0..], 0, chars);
    const b : u32 = num_grouped(G2[0..], 0, W_TEXT_CAP as u64);
    STATUS_LEN = fin(fill(STATUS[0..], 0, SAY_TOO_BIG, G1[0..(a as usize)], G2[0..(b as usize)], "", 2));
    return 0;
}

fn status_err_read(kind: u32) -> u32 {
    if (kind == 0) {
        STATUS_LEN = fin(fill(STATUS[0..], 0, SAY_ERR_READ, SAY_PASTED, "", "", 1));
    } else {
        STATUS_LEN = fin(fill(STATUS[0..], 0, SAY_ERR_READ, FNAME[0..(FNAME_LEN as usize)], "", "", 1));
    }
    return 0;
}

/// errorText(code) for the parse failure code, the loop one with its place: read from the failed text.
fn status_parse_error(code: i32, t: []const u8) -> u32 {
    if (code == 1) { STATUS_LEN = fin(text(STATUS[0..], 0, SAY_ERROR_TEXT[0])); }
    if (code == 2) { STATUS_LEN = fin(text(STATUS[0..], 0, SAY_ERROR_TEXT[1])); }
    if (code == 3) {
        var n : u32 = text(STATUS[0..], 0, SAY_ERROR_TEXT[2]);
        n = raw(STATUS[0..], n, " ");
        const bl : usize = ltp_loop(0, 0) as usize;
        const bh : usize = ltp_loop(0, 1) as usize;
        const ml : usize = ltp_loop(0, 2) as usize;
        const mh : usize = ltp_loop(0, 3) as usize;
        n = fill(STATUS[0..], n, SAY_LOOP_AT, t[bl..bh], t[ml..mh], "", 2);
        STATUS_LEN = fin(n);
    }
    return 0;
}

/// After a failed parse the tables hold the failed text: read the shown text again.
fn restore() -> u32 {
    if (SRC != 0) {
        const code : i32 = ltp_parse(buf(SRC), LISTS[0..LISTS_N]);
        return code as u32;
    }
    return 0;
}

fn refuse() -> u32 {
    RESULT_HIDDEN = true;
    SAMPLE_ON = false;
    return 0;
}

fn show() -> u32 {
    PICK = (ltp_info(0) as u32) - 1;
    RESULT_HIDDEN = false;
    return 0;
}

/// readText: parse the candidate text cs; kind 0 pasted, 1 a picked file.
fn read_text(cs: u32, kind: u32) -> u32 {
    const code : i32 = ltp_parse(buf(cs), LISTS[0..LISTS_N]);
    if (code != 0) {
        if (code < 0) { status_err_read(kind); } else { status_parse_error(code, buf(cs)); }
        restore();
        refuse();
        return 0;
    }
    SRC = cs;
    SAMPLE_ON = false;
    status_read(kind);
    show();
    return 0;
}

/// showSample: the cached sample; its failures say the sample did not load.
fn show_sample() -> u32 {
    if (SAMP_STATE != 1) {
        status_err_load();
        return 0;
    }
    const code : i32 = ltp_parse(buf(1), LISTS[0..LISTS_N]);
    if (code != 0) {
        status_err_load();
        restore();
        return 0;
    }
    SRC = 1;
    SAMPLE_ON = true;
    status_note();
    show();
    return 0;
}

pub fn w_base(u: []const u8) -> u32 {
    var n : usize = u.len;
    if (n > 1000) { n = 1000; }
    var k : usize = 0;
    while (k < n) { BASE[k] = u[k]; k = k + 1; }
    BASE_LEN = n as u32;
    return 0;
}

pub fn w_init(h: []const u8) -> u32 {
    lists_build();
    SAMP_LEN = 0;
    SAMP_STATE = 0;
    PASTE_LEN = 0;
    PASTE_CHARS = 0;
    PASTE_FIT = true;
    TA_LEN = 0;
    TB_LEN = 0;
    SRC = 0;
    PICK = 0;
    RESULT_HIDDEN = true;
    SAMPLE_ON = false;
    DRAGGING = false;
    EFF_CLEAR = false;
    FNAME_LEN = 0;
    FSIZE = 0;
    status_note();
    return 0;
}

pub fn w_data(i: u32, s: []const u8) -> u32 {
    EFF_CLEAR = false;
    const from : usize = bom_skip(s);
    if (s.len - from > (W_TEXT_CAP as usize)) {
        SAMP_STATE = 2;
    } else {
        var k : usize = from;
        while (k < s.len) { SAMP[k - from] = s[k]; k = k + 1; }
        SAMP_LEN = (s.len - from) as u32;
        SAMP_STATE = 1;
    }
    show_sample();
    return 0;
}

pub fn w_data_failed(i: u32) -> u32 {
    EFF_CLEAR = false;
    SAMP_STATE = 2;
    show_sample();
    return 0;
}

/// A control's text changed. Control 1 is the paste box (0 is the file input, which carries no text).
pub fn w_input(i: u32, s: []const u8) -> u32 {
    EFF_CLEAR = false;
    if (i != 1) { return 0; }
    PASTE_CHARS = utf16_len(s);
    if (s.len > (W_TEXT_CAP as usize)) {
        PASTE_FIT = false;
        PASTE_LEN = 0;
        return 0;
    }
    PASTE_FIT = true;
    var k : usize = 0;
    while (k < s.len) { PASTE[k] = s[k]; k = k + 1; }
    PASTE_LEN = s.len as u32;
    return 0;
}

pub fn w_click(i: u32) -> u32 {
    EFF_CLEAR = false;
    if (i == 0) { show_sample(); }
    if (i == 1) {
        if (!PASTE_FIT) {
            status_too_big(PASTE_CHARS as u64);
            refuse();
            return 0;
        }
        const cs : u32 = load_cand(PASTE[0..(PASTE_LEN as usize)]);
        read_text(cs, 0);
    }
    if (i == 2) {
        PASTE_LEN = 0;
        PASTE_CHARS = 0;
        PASTE_FIT = true;
        EFF_CLEAR = true;
        status_note();
        show_sample();
    }
    if (i >= 3) {
        const j : u32 = i - 3;
        if (SRC != 0 and ltp_info(0) >= 2 and (j as u64) < ltp_info(0)) {
            PICK = j;
            RESULT_HIDDEN = false;
        }
    }
    return 0;
}

/// readFile, first half: remember the name and size, say what was picked, refuse a file over the cap.
pub fn w_file(z: u32, name: []const u8, size: u32) -> u32 {
    EFF_CLEAR = false;
    var n : usize = name.len;
    if (n > 1000) { n = 1000; }
    var k : usize = 0;
    while (k < n) { FNAME[k] = name[k]; k = k + 1; }
    FNAME_LEN = n as u32;
    FSIZE = size;
    status_picked();
    if (size > W_TEXT_CAP) {
        status_too_big(size as u64);
        refuse();
        return 0;
    }
    return 1;
}

/// readFile, second half: the bytes arrived.
pub fn w_file_data(z: u32, s: []const u8) -> u32 {
    EFF_CLEAR = false;
    const from : usize = bom_skip(s);
    const cs : u32 = load_cand(s[from..s.len]);
    read_text(cs, 1);
    return 0;
}

pub fn w_file_failed(z: u32) -> u32 {
    EFF_CLEAR = false;
    status_err_read(1);
    refuse();
    return 0;
}

pub fn w_drag(z: u32, over: u32) -> u32 {
    EFF_CLEAR = false;
    const want : bool = over != 0;
    if (want == DRAGGING) { return 0; }
    DRAGGING = want;
    return 1;
}

/// Effects after the last event: after "Clear" the paste box and the file input are emptied.
pub fn w_effect(k: u32, dst: []u8) -> u32 {
    if (EFF_CLEAR and k < 2) {
        dst[0] = 118;
        dst[1] = k as u8;
        return 2;
    }
    return 0;
}

; --- drawing ---------------------------------------------------------------------------------------

/// One path block's buttons (when there are two or more): fmt(SAY_BLOCK_NAME, i + 1, command ?? module, num(length)).
fn render_blocks(dst: []u8, n0: u32, t: []const u8) -> u32 {
    var n : u32 = raw(dst, n0, "<h2 class=\"ld-h\">");
    n = text(dst, n, SAY_BLOCKS_HEAD);
    n = raw(dst, n, "</h2><div class=\"ld-btns\">");
    const nb : u32 = ltp_info(0) as u32;
    var i : u32 = 0;
    while (i < nb) {
        n = raw(dst, n, "<button class=\"t27-btn\" type=\"button\" aria-pressed=\"");
        if (i == PICK) { n = raw(dst, n, "true"); } else { n = raw(dst, n, "false"); }
        n = raw(dst, n, "\">");
        const a : u32 = dec_small(G1[0..], (i + 1) as u64);
        const c : u32 = num_grouped(G2[0..], 0, ltp_blk(i, 2));
        if (ltp_blk(i, 3) == 1) {
            const cl : usize = ltp_blk(i, 4) as usize;
            const ch : usize = ltp_blk(i, 5) as usize;
            n = fill(dst, n, SAY_BLOCK_NAME, G1[0..(a as usize)], t[cl..ch], G2[0..(c as usize)], 3);
        } else {
            const ml : usize = ltp_blk(i, 0) as usize;
            const mh : usize = ltp_blk(i, 1) as usize;
            n = fill(dst, n, SAY_BLOCK_NAME, G1[0..(a as usize)], t[ml..mh], G2[0..(c as usize)], 3);
        }
        n = raw(dst, n, "</button>");
        i = i + 1;
    }
    return raw(dst, n, "</div>");
}

/// String(v): plain decimal.
fn dec_small(dst: []u8, v0: u64) -> u32 {
    if (v0 == 0) { dst[0] = 48; return 1; }
    var digits : [20]u8 = [0; 20];
    var k : usize = 0;
    var v : u64 = v0;
    while (v > 0) {
        digits[k] = ((v % 10) as u8) + 48;
        v = v / 10;
        k = k + 1;
    }
    var n : u32 = 0;
    while (k > 0) {
        k = k - 1;
        dst[n as usize] = digits[k];
        n = n + 1;
    }
    return n;
}

fn render_head(dst: []u8, n0: u32, t: []const u8, b: u32) -> u32 {
    var n : u32 = raw(dst, n0, "<div class=\"ld-bigs\"><div class=\"ld-big\"><span class=\"ld-num ld-num-main\">");
    n = num_grouped(dst, n, ltp_blk(b, 2));
    n = raw(dst, n, "</span><span class=\"ld-label\">");
    n = text(dst, n, SAY_LENGTH_LABEL);
    n = raw(dst, n, "</span></div><div class=\"ld-big ld-big-lut\">");
    if (ltp_info(2) == 1) {
        n = raw(dst, n, "<span class=\"ld-num\">");
        n = num_grouped(dst, n, ltp_blk(b, 8));
        n = raw(dst, n, "</span><span class=\"ld-label\">");
        n = text(dst, n, SAY_LUT_LABEL);
        n = raw(dst, n, "</span>");
    } else {
        n = raw(dst, n, "<span class=\"ld-label\">");
        n = text(dst, n, SAY_LUT_UNKNOWN);
        n = raw(dst, n, "</span>");
    }
    n = raw(dst, n, "</div></div><p class=\"ld-meta\">");
    const ml : usize = ltp_blk(b, 0) as usize;
    const mh : usize = ltp_blk(b, 1) as usize;
    if (ltp_blk(b, 3) == 1) {
        const cl : usize = ltp_blk(b, 4) as usize;
        const ch : usize = ltp_blk(b, 5) as usize;
        n = fill(dst, n, SAY_MODULE, t[ml..mh], t[cl..ch], "", 2);
    } else {
        n = fill(dst, n, SAY_MODULE, t[ml..mh], SAY_NO_COMMAND, "", 2);
    }
    return raw(dst, n, "</p>");
}

/// The clocked-cell types on the block, each once, in the order first met, joined by ", " into WARN_TYPES.
fn clocked_types(t: []const u8, b: u32) -> u32 {
    var w : u32 = 0;
    const first : u32 = ltp_blk(b, 7) as u32;
    const cnt : u32 = ltp_blk(b, 6) as u32;
    var k : u32 = 0;
    while (k < cnt) {
        const si : u32 = first + k;
        if (ltp_step(si, 8) == 4) {
            const tl : usize = ltp_step(si, 6) as usize;
            const th : usize = ltp_step(si, 7) as usize;
            var seen : bool = false;
            var q : u32 = 0;
            while (q < k and !seen) {
                const sj : u32 = first + q;
                if (ltp_step(sj, 8) == 4) {
                    if (same_range(t, ltp_step(sj, 6) as usize, ltp_step(sj, 7) as usize, t, tl, th)) { seen = true; }
                }
                q = q + 1;
            }
            if (!seen) {
                if (w > 0) {
                    WARN_TYPES[w as usize] = 44;
                    WARN_TYPES[(w + 1) as usize] = 32;
                    w = w + 2;
                }
                var c : usize = tl;
                while (c < th) {
                    WARN_TYPES[w as usize] = t[c];
                    w = w + 1;
                    c = c + 1;
                }
            }
        }
        k = k + 1;
    }
    return w;
}

fn render_warns(dst: []u8, n0: u32, t: []const u8, b: u32) -> u32 {
    var n : u32 = n0;
    if (ltp_blk(b, 12) > 0) {
        const w : u32 = clocked_types(t, b);
        const a : u32 = num_grouped(G1[0..], 0, ltp_blk(b, 12));
        n = raw(dst, n, "<p class=\"ld-warn is-red\">");
        n = fill(dst, n, SAY_CLOCKED_WARN, G1[0..(a as usize)], WARN_TYPES[0..(w as usize)], "", 2);
        n = raw(dst, n, "</p>");
    }
    if (ltp_info(2) == 0) {
        n = raw(dst, n, "<p class=\"ld-warn\">");
        n = text(dst, n, SAY_UNTYPED);
        n = raw(dst, n, "</p>");
    } else {
        if (ltp_blk(b, 14) > 0) {
            const a : u32 = num_grouped(G1[0..], 0, ltp_blk(b, 14));
            n = raw(dst, n, "<p class=\"ld-warn\">");
            n = fill(dst, n, SAY_MISSING_TYPES, G1[0..(a as usize)], "", "", 1);
            n = raw(dst, n, "</p>");
        }
    }
    if (ltp_blk(b, 6) != ltp_blk(b, 2) + 1) {
        const a : u32 = num_grouped(G1[0..], 0, ltp_blk(b, 6));
        const c : u32 = num_grouped(G2[0..], 0, ltp_blk(b, 2) + 1);
        n = raw(dst, n, "<p class=\"ld-warn\">");
        n = fill(dst, n, SAY_INCOMPLETE, G1[0..(a as usize)], G2[0..(c as usize)], "", 2);
        n = raw(dst, n, "</p>");
    }
    if (ltp_info(1) > 0) {
        const a : u32 = num_grouped(G1[0..], 0, ltp_info(1));
        const bl : usize = ltp_loop(0, 0) as usize;
        const bh : usize = ltp_loop(0, 1) as usize;
        n = raw(dst, n, "<p class=\"ld-warn\">");
        n = fill(dst, n, SAY_LOOPS, G1[0..(a as usize)], t[bl..bh], "", 2);
        n = raw(dst, n, "</p>");
    }
    return n;
}

fn legend_item(dst: []u8, n0: u32, b: u32, c: u32) -> u32 {
    var n : u32 = n0;
    const cnt : u64 = ltp_blk(b, 8 + c);
    if (cnt > 0) {
        n = raw(dst, n, "<li class=\"is-");
        n = text(dst, n, SAY_CLASS_IDS[c as usize]);
        n = raw(dst, n, "\"><span class=\"ld-swatch\"></span>");
        n = text(dst, n, SAY_CLASS_NAMES[c as usize]);
        n = raw(dst, n, " ");
        n = num_grouped(dst, n, cnt);
        n = raw(dst, n, "</li>");
    }
    return n;
}

/// A step's via has bytes: JavaScript's `s.via` is truthy.
fn has_via(si: u32) -> bool {
    return ltp_step(si, 2) == 1 and ltp_step(si, 4) > ltp_step(si, 3);
}

fn render_stairs(dst: []u8, n0: u32, t: []const u8, b: u32) -> u32 {
    var n : u32 = n0;
    const first : u32 = ltp_blk(b, 7) as u32;
    const cnt : u32 = ltp_blk(b, 6) as u32;
    var cells : u32 = 0;
    var k : u32 = 0;
    while (k < cnt) {
        if (has_via(first + k)) { cells = cells + 1; }
        k = k + 1;
    }
    var width : u32 = cells;
    if (width < 1) { width = 1; }
    n = raw(dst, n, "<div class=\"ld-stairs\" role=\"img\"");
    n = attr(dst, n, "aria-label", SAY_STAIRS_LABEL);
    n = raw(dst, n, " style=\"--ld-n: ");
    n = num(dst, n, width as u64);
    n = raw(dst, n, ";\">");
    var m : u32 = 0;
    k = 0;
    while (k < cnt) {
        const si : u32 = first + k;
        if (has_via(si)) {
            n = raw(dst, n, "<div class=\"ld-step is-");
            n = text(dst, n, SAY_CLASS_IDS[ltp_step(si, 8) as usize]);
            n = raw(dst, n, "\" style=\"--ld-k: ");
            n = num(dst, n, m as u64);
            n = raw(dst, n, ";\"><span class=\"ld-i\">");
            n = num(dst, n, k as u64);
            n = raw(dst, n, "</span><span class=\"ld-track\"><span class=\"ld-block\"></span><span class=\"ld-type");
            if (m * 2 >= width) { n = raw(dst, n, " is-left"); }
            n = raw(dst, n, "\"");
            const vl : usize = ltp_step(si, 3) as usize;
            const vh : usize = ltp_step(si, 4) as usize;
            n = attr(dst, n, "title", t[vl..vh]);
            n = raw(dst, n, ">");
            if (ltp_step(si, 5) == 1) {
                n = text(dst, n, t[(ltp_step(si, 6) as usize)..(ltp_step(si, 7) as usize)]);
            } else {
                n = text(dst, n, t[vl..vh]);
            }
            n = raw(dst, n, "</span></span></div>");
            m = m + 1;
        }
        k = k + 1;
    }
    n = raw(dst, n, "</div><p class=\"ld-ends\">");
    if (cnt > 0) {
        const bl : usize = ltp_step(first, 0) as usize;
        const bh : usize = ltp_step(first, 1) as usize;
        n = raw(dst, n, "<span>");
        n = fill(dst, n, SAY_START, t[bl..bh], "", "", 1);
        n = raw(dst, n, "</span>");
    }
    if (cnt > 1) {
        const el : usize = ltp_step(first + cnt - 1, 0) as usize;
        const eh : usize = ltp_step(first + cnt - 1, 1) as usize;
        n = raw(dst, n, "<span>");
        n = fill(dst, n, SAY_END, t[el..eh], "", "", 1);
        n = raw(dst, n, "</span>");
    }
    return raw(dst, n, "</p>");
}

fn render_table(dst: []u8, n0: u32, t: []const u8, b: u32) -> u32 {
    var n : u32 = n0;
    const first : u32 = ltp_blk(b, 7) as u32;
    const cnt : u32 = ltp_blk(b, 6) as u32;
    var k : u32 = 0;
    while (k < cnt) {
        const si : u32 = first + k;
        n = raw(dst, n, "<tr class=\"is-");
        n = text(dst, n, SAY_CLASS_IDS[ltp_step(si, 8) as usize]);
        n = raw(dst, n, "\"><td class=\"ld-n\">");
        n = num(dst, n, k as u64);
        n = raw(dst, n, "</td><td>");
        if (has_via(si)) {
            if (ltp_step(si, 5) == 1) {
                n = text(dst, n, t[(ltp_step(si, 6) as usize)..(ltp_step(si, 7) as usize)]);
            } else {
                n = text(dst, n, SAY_CLASS_NAMES[6]);
            }
        } else {
            n = text(dst, n, SAY_CLASS_NAMES[7]);
        }
        n = raw(dst, n, "</td><td class=\"ld-name\">");
        if (ltp_step(si, 2) == 1) {
            n = text(dst, n, t[(ltp_step(si, 3) as usize)..(ltp_step(si, 4) as usize)]);
        }
        n = raw(dst, n, "</td><td class=\"ld-name\">");
        n = text(dst, n, t[(ltp_step(si, 0) as usize)..(ltp_step(si, 1) as usize)]);
        n = raw(dst, n, "</td></tr>");
        k = k + 1;
    }
    return n;
}

fn render_result(dst: []u8, n0: u32) -> u32 {
    var n : u32 = raw(dst, n0, "<section class=\"ld-result\" aria-live=\"polite\"");
    if (RESULT_HIDDEN) { n = raw(dst, n, " hidden=\"\""); }
    n = raw(dst, n, "><div class=\"ld-blocks\"");
    const have : bool = SRC != 0;
    var blocks : u32 = 0;
    if (have) { blocks = ltp_info(0) as u32; }
    const t : []const u8 = buf(SRC);
    if (blocks < 2) {
        n = raw(dst, n, " hidden=\"\"></div>");
    } else {
        n = raw(dst, n, ">");
        n = render_blocks(dst, n, t);
        n = raw(dst, n, "</div>");
    }
    n = raw(dst, n, "<div class=\"ld-head\">");
    if (have) { n = render_head(dst, n, t, PICK); }
    n = raw(dst, n, "</div><p class=\"ld-notns\">");
    n = text(dst, n, SAY_NOT_NS);
    n = raw(dst, n, "</p><div class=\"ld-warns\">");
    if (have) { n = render_warns(dst, n, t, PICK); }
    n = raw(dst, n, "</div><div class=\"ld-stairs-box\"><h2 class=\"ld-h\">");
    n = text(dst, n, SAY_STAIRS_HEAD);
    n = raw(dst, n, "</h2><ul class=\"ld-legend\">");
    if (have) {
        n = legend_item(dst, n, PICK, 0);
        n = legend_item(dst, n, PICK, 1);
        n = legend_item(dst, n, PICK, 2);
        n = legend_item(dst, n, PICK, 3);
        n = legend_item(dst, n, PICK, 5);
        n = legend_item(dst, n, PICK, 6);
        n = legend_item(dst, n, PICK, 4);
    }
    n = raw(dst, n, "</ul>");
    if (have) {
        n = render_stairs(dst, n, t, PICK);
    } else {
        n = raw(dst, n, "<div class=\"ld-stairs\" role=\"img\"");
        n = attr(dst, n, "aria-label", SAY_STAIRS_LABEL);
        n = raw(dst, n, "></div><p class=\"ld-ends\"></p>");
    }
    n = raw(dst, n, "</div><details class=\"ld-details\"><summary>");
    n = text(dst, n, SAY_TABLE_SUMMARY);
    n = raw(dst, n, "</summary><div class=\"ld-table-wrap\"><table class=\"ld-table\"><thead><tr>");
    var h : usize = 0;
    while (h < 4) {
        n = raw(dst, n, "<th scope=\"col\">");
        n = text(dst, n, SAY_TABLE_HEAD[h]);
        n = raw(dst, n, "</th>");
        h = h + 1;
    }
    n = raw(dst, n, "</tr></thead><tbody>");
    if (have) { n = render_table(dst, n, t, PICK); }
    return raw(dst, n, "</tbody></table></div></details></section>");
}

/// The whole page, as tool.js's root.replaceChildren(...) and the render calls left it. 0 on overflow.
pub fn w_render(dst: []u8) -> u32 {
    var n : u32 = raw(dst, 0, "<div class=\"ld\"><section class=\"ld-pick\"><div class=\"ld-col\"><h2 class=\"ld-h\">");
    n = text(dst, n, SAY_SAMPLE_LABEL);
    n = raw(dst, n, "</h2><div class=\"ld-btns\"><button class=\"t27-btn\" type=\"button\" aria-pressed=\"");
    if (SAMPLE_ON) { n = raw(dst, n, "true"); } else { n = raw(dst, n, "false"); }
    n = raw(dst, n, "\">");
    n = text(dst, n, SAY_SAMPLE_NAME);
    n = raw(dst, n, "</button></div><p class=\"ld-line\">");
    n = text(dst, n, SAY_SAMPLE_LINE);
    n = raw(dst, n, " <a class=\"ld-open\" href=\"");
    n = text(dst, n, BASE[0..(BASE_LEN as usize)]);
    n = text(dst, n, K_SAMPLE_LOG);
    n = raw(dst, n, "\" target=\"_blank\" rel=\"noopener\">");
    n = text(dst, n, SAY_OPEN_SAMPLE);
    n = raw(dst, n, "</a></p></div><div class=\"ld-col\"><h2 class=\"ld-h\">");
    n = text(dst, n, SAY_OWN_LABEL);
    n = raw(dst, n, "</h2><p class=\"ld-line\">");
    n = text(dst, n, SAY_HOW_HEAD);
    n = raw(dst, n, "</p><pre class=\"ld-how\">");
    n = text(dst, n, SAY_HOW[0]);
    n = put(dst, n, 10);
    n = text(dst, n, SAY_HOW[1]);
    n = put(dst, n, 10);
    n = text(dst, n, SAY_HOW[2]);
    n = raw(dst, n, "</pre><p class=\"ld-note\">");
    n = text(dst, n, SAY_HOW_NOTE);
    n = raw(dst, n, "</p><label class=\"t27-drop ld-drop");
    if (DRAGGING) { n = raw(dst, n, " is-over"); }
    n = raw(dst, n, "\"><input type=\"file\" accept=\".txt,.log,text/plain\" class=\"ld-file\"><span>");
    n = text(dst, n, SAY_DROP);
    n = raw(dst, n, "</span></label><textarea class=\"ld-paste\" rows=\"4\" spellcheck=\"false\"");
    n = attr(dst, n, "placeholder", SAY_PASTE_HINT);
    n = attr(dst, n, "aria-label", SAY_PASTE_LABEL);
    n = raw(dst, n, "></textarea><div class=\"ld-btns\"><button class=\"t27-btn\" type=\"button\">");
    n = text(dst, n, SAY_READ);
    n = raw(dst, n, "</button><button class=\"t27-btn\" type=\"button\">");
    n = text(dst, n, SAY_CLEAR);
    n = raw(dst, n, "</button></div><p class=\"ld-status\" role=\"status\">");
    var q : usize = 0;
    while (q < (STATUS_LEN as usize)) {
        n = put(dst, n, STATUS[q]);
        q = q + 1;
    }
    n = raw(dst, n, "</p></div></section>");
    n = render_result(dst, n);
    n = raw(dst, n, "<p class=\"ld-honest\">");
    n = text(dst, n, SAY_HONEST);
    n = raw(dst, n, "</p></div>");
    if (!ok(n)) { return 0; }
    return n;
}

/// The splicer follows only the names a module itself mentions, not the names its imported functions
/// mention. This anchor mentions every helper the writer and the line reader call. Never called.
pub fn imports_anchor(o: []u8, s: []const u8) -> u32 {
    var n : u32 = put(o, 0, 0);
    n = put_escaped(o, n, 0);
    n = n + OVER + ((H_LT + H_GT + H_AMP + H_QUOTE + H_APOS + H_SPACE + H_SLASH + H_EQ) as u32);
    n = n + (is_space(0) as u32) + (B_SPACE as u32) + (B_TAB as u32) + (B_CR as u32) + (PACK as u32);
    n = n + (pack(0, 0) as u32) + (lo_of(0) as u32) + (hi_of(0) as u32);
    return n;
}

; --- Test support (lut_depth_logic.t27 567-568, 572-587 and 624-645): a text built from lines ---
pub var TXT : [8192]u8 = [0; 8192];
pub var TXN : usize = 0;
pub fn tx_reset() -> usize {
    TXN = 0;
    return 0;
}

pub fn tx_line(s: []const u8) -> usize {
    var k : usize = 0;
    while (k < s.len) {
        TXT[TXN] = s[k];
        TXN = TXN + 1;
        k = k + 1;
    }
    TXT[TXN] = W_B_NL;
    TXN = TXN + 1;
    return TXN;
}
pub fn is_text(s: []const u8, lo: u64, hi: u64, w: []const u8) -> bool {
    return (hi - lo) == (w.len as u64) and match_in(s, lo as usize, hi as usize, w);
}

/// The sample's first path, cut to its first four steps, with the real names, and a dump of the cells it names.
pub fn short_block() -> usize {
    tx_reset();
    tx_line("yosys> ltp -noff t:FD* %n");
    tx_line("");
    tx_line("Longest topological path in gf16_add (length=3):");
    tx_line("    0: \\in_b [12]");
    tx_line("    1: \\exp_b [3] (via $iopadmap$gf16_add.in_b_12)");
    tx_line("    2: $auto$alumacc.cc:512:replace_alu$1455.X [3] (via $abc$2850$auto$blifparse.cc:557:parse_blif$2977)");
    tx_line("    3: $auto$alumacc.cc:512:replace_alu$1455.CO [3] (via $auto$alumacc.cc:512:replace_alu$1455.genblk1.slice[0].genblk1.carry4)");
    tx_line("");
    tx_line("yosys> dump t:*");
    tx_line("  cell \\IBUF $iopadmap$gf16_add.in_b_12");
    tx_line("  cell \\LUT2 $abc$2850$auto$blifparse.cc:557:parse_blif$2977");
    tx_line("  cell \\CARRY4 $auto$alumacc.cc:512:replace_alu$1455.genblk1.slice[0].genblk1.carry4");
    tx_line("  cell \\FDCE $auto$ff.cc:337:slice$1884");
    return TXN;
}

; --- Tests of the native page ----------------------------------------------------------------------
; The reader's own tests (7, in lut_depth_logic.t27) run on the same text; these hold the page.

pub var OUT : [262144]u8 = [0; 262144];

/// Does the rendered page hold w?
fn has(n: u32, w: []const u8) -> bool {
    return find_in(OUT[0..(n as usize)], 0, n as usize, w) >= 0;
}

/// The test sample: the short block, as the host hands it over.
fn load_sample() -> u32 {
    short_block();
    w_init("");
    w_base("http://h/w/");
    w_data(0, TXT[0..TXN]);
    return 0;
}

test the_lists_are_built_from_the_specs_constants {
    w_init("");
    assert LISTS[0] == 48;
    assert LISTS[1] == 76;
    assert LISTS_N == 195;
    assert class_of("FDCE", 0, 4, LISTS[0..LISTS_N]) == 4;
    assert class_of("CARRY4", 0, 6, LISTS[0..LISTS_N]) == 1;
    assert class_of("MUXF8", 0, 5, LISTS[0..LISTS_N]) == 2;
    assert class_of("IBUF", 0, 4, LISTS[0..LISTS_N]) == 3;
    assert class_of("$lut", 0, 4, LISTS[0..LISTS_N]) == 0;
    assert class_of("MY_CELL", 0, 7, LISTS[0..LISTS_N]) == 5;
    assert W_DATA_FILE.len == K_SAMPLE_LOG.len + 2;
}

test the_page_opens_with_the_result_hidden_and_the_note_in_the_status {
    w_init("");
    w_base("http://h/w/");
    const n : u32 = w_render(OUT[0..]);
    assert n > 2000;
    assert has(n, "<section class=\"ld-result\" aria-live=\"polite\" hidden=\"\">");
    assert has(n, "<div class=\"ld-blocks\" hidden=\"\"></div>");
    assert has(n, "<p class=\"ld-status\" role=\"status\">Read in this tab; nothing is sent.</p>");
    assert has(n, "href=\"http://h/w/sample.ltp.txt\" target=\"_blank\" rel=\"noopener\"");
    assert has(n, "<button class=\"t27-btn\" type=\"button\" aria-pressed=\"false\">gf16_add (yosys 0.67)</button>");
    assert has(n, "<input type=\"file\" accept=\".txt,.log,text/plain\" class=\"ld-file\">");
    assert has(n, "<pre class=\"ld-how\">synth_xilinx -flatten -top &lt;top&gt;");
    assert has(n, "<div class=\"ld-stairs\" role=\"img\"");
    assert has(n, "--ld-n") == false;
    assert has(n, "<tbody></tbody>");
}

test the_sample_draws_a_staircase_a_legend_and_a_table {
    load_sample();
    const n : u32 = w_render(OUT[0..]);
    assert RESULT_HIDDEN == false;
    assert SAMPLE_ON;
    assert has(n, "<section class=\"ld-result\" aria-live=\"polite\"><div class=\"ld-blocks\" hidden=\"\"></div>");
    assert has(n, "aria-pressed=\"true\">gf16_add (yosys 0.67)</button>");
    assert has(n, "<span class=\"ld-num ld-num-main\">3</span>");
    assert has(n, "<span class=\"ld-num\">1</span><span class=\"ld-label\">of them LUTs</span>");
    assert has(n, "<p class=\"ld-meta\">module gf16_add, printed by: ltp -noff t:FD* %n</p>");
    assert has(n, "style=\"--ld-n: 3;\"");
    assert has(n, "<div class=\"ld-step is-io\" style=\"--ld-k: 0;\"><span class=\"ld-i\">1</span>");
    assert has(n, "<span class=\"ld-type\" title=\"$iopadmap$gf16_add.in_b_12\">IBUF</span>");
    assert has(n, "<span class=\"ld-type is-left\" title=\"$auto$alumacc.cc:512:replace_alu$1455.genblk1.slice[0].genblk1.carry4\">CARRY4</span>");
    assert has(n, "<li class=\"is-lut\"><span class=\"ld-swatch\"></span>LUT 1</li>");
    assert has(n, "<span>starts at \\in_b [12]</span><span>ends at $auto$alumacc.cc:512:replace_alu$1455.CO [3]</span>");
    assert has(n, "<tr class=\"is-start\"><td class=\"ld-n\">0</td><td>start</td><td class=\"ld-name\"></td><td class=\"ld-name\">\\in_b [12]</td></tr>");
    assert has(n, "<tr class=\"is-lut\"><td class=\"ld-n\">2</td><td>LUT2</td>");
    assert has(n, "<p class=\"ld-warn") == false;
}

test a_text_with_no_dump_names_cells_not_types {
    load_sample();
    tx_reset();
    tx_line("Longest topological path in top (length=2):");
    tx_line("    0: a");
    tx_line("    1: b (via c1)");
    tx_line("    2: c (via c2)");
    w_input(1, TXT[0..TXN]);
    w_click(1);
    const n : u32 = w_render(OUT[0..]);
    assert RESULT_HIDDEN == false;
    assert SAMPLE_ON == false;
    assert has(n, "<p class=\"ld-status\" role=\"status\">pasted text. Read in this tab; nothing is sent.</p>");
    assert has(n, "<div class=\"ld-big ld-big-lut\"><span class=\"ld-label\">LUTs: give the dump to count them</span></div>");
    assert has(n, "<p class=\"ld-warn\">No RTLIL dump in this text");
    assert has(n, "<p class=\"ld-meta\">module top, printed by: the command is not in the text</p>");
    assert has(n, "<span class=\"ld-type\" title=\"c1\">c1</span>");
    assert has(n, "<li class=\"is-unknown\"><span class=\"ld-swatch\"></span>type not given 2</li>");
    assert has(n, "<td>type not given</td><td class=\"ld-name\">c2</td>");
}

test a_path_through_a_flip_flop_is_flagged_and_a_cut_block_is_told {
    load_sample();
    tx_reset();
    tx_line("Longest topological path in top (length=4):");
    tx_line("    0: a");
    tx_line("    1: b (via u1)");
    tx_line("    2: c (via u2)");
    tx_line("    3: d (via u1)");
    tx_line("  cell \\FDCE u1");
    tx_line("  cell \\LUT2 u2");
    w_input(1, TXT[0..TXN]);
    w_click(1);
    const n : u32 = w_render(OUT[0..]);
    assert has(n, "<p class=\"ld-warn is-red\">This path runs through 2 clocked cell(s): FDCE. ");
    assert has(n, "<p class=\"ld-warn\">This block lists 4 of its 5 steps: part of it is missing from the text.</p>");
    assert has(n, "<li class=\"is-clocked\"><span class=\"ld-swatch\"></span>clocked 2</li>");
    assert has(n, "<span class=\"ld-num\">1</span>");
}

test two_blocks_give_buttons_and_a_click_moves_the_pick {
    load_sample();
    tx_reset();
    tx_line("yosys> ltp -noff");
    tx_line("Longest topological path in one (length=1):");
    tx_line("    0: a");
    tx_line("    1: b (via u1)");
    tx_line("yosys> ltp");
    tx_line("Longest topological path in two (length=2):");
    tx_line("    0: a");
    tx_line("    1: b (via u1)");
    tx_line("    2: c (via u1)");
    tx_line("  cell \\LUT6 u1");
    w_input(1, TXT[0..TXN]);
    w_click(1);
    assert PICK == 1;
    var n : u32 = w_render(OUT[0..]);
    assert has(n, "<div class=\"ld-blocks\"><h2 class=\"ld-h\">Paths in this text</h2>");
    assert has(n, "aria-pressed=\"false\">1: ltp -noff, length 1</button><button class=\"t27-btn\" type=\"button\" aria-pressed=\"true\">2: ltp, length 2</button>");
    w_click(3);
    assert PICK == 0;
    n = w_render(OUT[0..]);
    assert has(n, "aria-pressed=\"true\">1: ltp -noff, length 1</button>");
    w_click(9);
    assert PICK == 0;
}

test a_refused_text_hides_the_result_and_keeps_what_was_drawn {
    load_sample();
    w_input(1, "this is not ltp output");
    w_click(1);
    var n : u32 = w_render(OUT[0..]);
    assert RESULT_HIDDEN;
    assert SAMPLE_ON == false;
    assert has(n, "No &quot;Longest topological path in ... (length=N):&quot; line in this text. Is it the output of yosys ltp?</p>");
    assert has(n, "<section class=\"ld-result\" aria-live=\"polite\" hidden=\"\">");
    assert has(n, "<span class=\"ld-num ld-num-main\">3</span>");
    w_input(1, "   ");
    w_click(1);
    n = w_render(OUT[0..]);
    assert has(n, "role=\"status\">Nothing to read yet.</p>");
    w_click(0);
    n = w_render(OUT[0..]);
    assert RESULT_HIDDEN == false;
    assert has(n, "role=\"status\">Read in this tab; nothing is sent.</p>");
}

test a_loop_is_told_with_its_place {
    load_sample();
    tx_reset();
    tx_line("Detected loop at \\n [3] in top");
    w_input(1, TXT[0..TXN]);
    w_click(1);
    const n : u32 = w_render(OUT[0..]);
    assert has(n, "found a combinational loop and printed no path; a loop has no longest path. The first is at \\n [3] in module top.</p>");
    assert RESULT_HIDDEN;
}

test a_file_is_announced_then_read_and_a_big_or_unreadable_one_is_refused {
    load_sample();
    short_block();
    assert w_file(0, "my<ltp>.txt", 1234) == 1;
    var n : u32 = w_render(OUT[0..]);
    assert has(n, "role=\"status\">my&lt;ltp&gt;.txt: 1,234 bytes</p>");
    w_file_data(0, TXT[0..TXN]);
    n = w_render(OUT[0..]);
    assert has(n, "role=\"status\">my&lt;ltp&gt;.txt: 1,234 bytes. Read in this tab; nothing is sent.</p>");
    assert RESULT_HIDDEN == false;
    assert w_file(0, "big.log", 3000000) == 0;
    n = w_render(OUT[0..]);
    assert has(n, "role=\"status\">3,000,000 characters is more than this page reads (2,097,152).</p>");
    assert RESULT_HIDDEN;
    w_file_failed(0);
    n = w_render(OUT[0..]);
    assert has(n, "role=\"status\">Could not read big.log.</p>");
}

test a_byte_order_mark_is_dropped_and_lengths_count_utf16 {
    assert bom_skip("abc") == 0;
    var b : [4]u8 = [239, 187, 191, 65];
    assert bom_skip(b[0..4]) == 3;
    var u : [6]u8 = [97, 195, 169, 226, 130, 172];
    assert utf16_len(u[0..6]) == 3;
    var e : [5]u8 = [97, 240, 159, 152, 128];
    assert utf16_len(e[0..5]) == 3;
}

test dragging_marks_the_drop_zone_and_clear_empties_the_two_inputs {
    load_sample();
    assert w_drag(0, 1) == 1;
    assert w_drag(0, 1) == 0;
    var n : u32 = w_render(OUT[0..]);
    assert has(n, "<label class=\"t27-drop ld-drop is-over\">");
    assert w_drag(0, 0) == 1;
    n = w_render(OUT[0..]);
    assert has(n, "<label class=\"t27-drop ld-drop\">");
    w_input(1, "something");
    assert PASTE_LEN == 9;
    var e : [4]u8 = [0; 4];
    w_click(2);
    assert PASTE_LEN == 0;
    assert w_effect(0, e[0..]) == 2;
    assert e[0] == 118 and e[1] == 0;
    assert w_effect(1, e[0..]) == 2;
    assert e[1] == 1;
    assert w_effect(2, e[0..]) == 0;
    w_click(0);
    assert w_effect(0, e[0..]) == 0;
}

test a_sample_that_did_not_load_says_so_and_draws_nothing {
    w_init("");
    w_data_failed(0);
    const n : u32 = w_render(OUT[0..]);
    assert has(n, "role=\"status\">The sample did not load.</p>");
    assert RESULT_HIDDEN;
    w_data(0, "no path in here");
    assert SAMP_STATE == 1;
    const m : u32 = w_render(OUT[0..]);
    assert has(m, "role=\"status\">The sample did not load.</p>");
    assert RESULT_HIDDEN;
}

/// Two texts equal byte for byte (t27c's Zig target does not compare two str array elements with ==).
pub fn same_text(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}
