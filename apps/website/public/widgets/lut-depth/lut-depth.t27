// SPDX-License-Identifier: Apache-2.0
; specs/widgets/lut-depth.t27 -- the longest path yosys `ltp` printed, drawn one step per cell
; Source of truth for public/widgets/lut-depth/ (gHashTag/trinity, apps/website). The page is
; written by scripts/widget-pages-from-spec.mjs from this file; tool.js holds no English of its
; own and reads every word below from window.T27_WIDGET.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader pastes or drops what yosys `ltp` printed after LUT mapping. The page
; reads it in the browser with public/widgets/lut-depth/ltpparse.js and draws each path block as a
; staircase, one step per cell, with one big number: the length yosys printed. ltp prints a cell
; NAME per step, never a type. When the same text also holds an RTLIL `dump` (yosys
; `dump t:*`), the page looks every cell name up there and labels the step LUT6, CARRY4 and so
; on; without a dump it says "type not given" and guesses nothing from the name. The file never
; leaves the page; nothing is sent.

; THE -noff TRAP, measured on the sample: `ltp -noff` leaves out only yosys' own flip-flop types
; ($dff, $_DFF_P_ and kin). synth_xilinx writes 7-series flip-flops (FDRE, FDCE, FDSE, FDPE),
; which ltp walks through like any other cell, from D and C to Q. On the sample, plain
; `ltp -noff` printed length=27, and steps 24 to 27 are FDCE, LUT2, FDCE, OBUF: the path runs
; through two registers to an output pin. `ltp -noff t:FD* %n` (every object except FD* cells)
; printed length=23, the same first 23 steps, ending at a register's D input. The page flags any
; path that crosses a cell in K_CLOCKED_TYPES. With generic `synth -lut 6 -flatten` (cells
; $lut and $dff) plain `ltp -noff` does skip the flip-flops: on the same design it printed
; length=14, all $lut. That run was made once to check the parser; it is not shipped.

; THE SAMPLE: one real run of Yosys 0.67+post (git sha1 b8e7da6f) on this machine, made by
; scripts/widget-data/lut-depth.mjs: fpga/openxc7-synth/gf16_add.v (gHashTag/trinity), the GF16
; (Golden Float 16) adder, `synth_xilinx -flatten -top gf16_add`, then `echo on` and three
; commands teed into one file: `ltp -noff`, `ltp -noff t:FD* %n` and `dump t:*`. That file is
; shipped byte for byte as public/widgets/lut-depth/sample.ltp.txt; the command, the yosys -V
; line, the exit code, the warnings and the sha256 of the input and output are in sample.json.
; Every K_SAMPLE_ fact below is re-read from sample.ltp.txt (K_SAMPLE_YOSYS from the -V line) by
; `node scripts/widget-data/lut-depth.mjs --check`, which also runs this spec's tests on the
; values it read and a negative control that must fail them. yosys printed three warnings for
; this design (two about in_ready, one out-of-range select at gf16_add.v:165); the path is the
; netlist yosys built from it, warnings and all.

; WHAT IT DOES NOT CLAIM: levels are not nanoseconds. ltp counts cells on a path of the netlist
; before place and route: no routing delay, no cell delay, a CARRY4 counts the same as a LUT6, and
; the path with the most cells need not be the slowest one or the one with the most LUTs. No Fmax
; or time is computed from it anywhere on the page or the card. ltp works per module, so the
; design must be flattened for it to see a whole path.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_lut_depth;

pub const KIND : str = "widget-tool";
pub const ID : str = "lut-depth";
pub const TITLE : str = "LUT depth: your longest yosys path, drawn as a staircase";
pub const DESCRIPTION : str = "Paste yosys ltp -noff output: the longest path after LUT mapping, one step per cell, typed when a dump is in the text. A cell count, not nanoseconds. Read in your browser.";
pub const IMAGE_ALT : str = "A staircase of 23 steps on black: the longest path yosys 0.67 ltp found in gf16_add, a GF16 adder, after synth_xilinx: 1 IBUF, 11 LUTs, 9 CARRY4 and 2 wide muxes. Plain ltp -noff said 27, because it walked through two FDCE flip-flops. Marked: cells, not nanoseconds.";
pub const HOOK : str = "Our GF16 adder's longest path: 23 cells, 11 of them LUTs. Plain ltp -noff said 27: it walked through two 7-series flip-flops it does not skip.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [5]str = ["Yosys 0.67+post (git sha1 b8e7da6f40ae8f552c116bf6c359b07c6533e159), run once by scripts/widget-data/lut-depth.mjs: nice -n 10 yosys -q -p \"read_verilog fpga/openxc7-synth/gf16_add.v; synth_xilinx -flatten -top gf16_add; echo on; tee -q -o ltp.txt ltp -noff; tee -q -a ltp.txt ltp -noff t:FD* %n; tee -q -a ltp.txt dump t:*\"", "gHashTag/trinity fpga/openxc7-synth/gf16_add.v (sha256 in sample.json), copied to a scratch directory under the same relative path", "public/widgets/lut-depth/sample.ltp.txt: the teed yosys output, byte for byte; sample.json: command, yosys -V line, exit code, warnings, seconds, sha256 of input and output, and the parsed path", "public/widgets/lut-depth/ltpparse.js: the one parser, run in node for the sample and in the browser for your text; card.png is drawn from sample.json by scripts/widget-data/lut-depth-card.py", "node scripts/widget-data/lut-depth.mjs --check: re-reads sample.ltp.txt and fails if any K_SAMPLE_ fact in this spec disagrees"];
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

