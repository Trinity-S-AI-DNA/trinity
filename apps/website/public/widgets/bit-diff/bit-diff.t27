; --- Numbers the tool relies on ------------------------------------------------------------
; 0xAA995566, the word after which the configuration logic reads packets.
pub const K_SYNC_WORD : u32 = 2862175590;
pub const K_FRAME_WORDS : u8 = 101;
; Word 50 of a frame carries the frame ECC in bits 0..12; the rest of it is configuration.
pub const K_ECC_WORD : u8 = 50;
pub const K_ECC_MASK : u16 = 8191;
; Every configuration row in the FDRI stream ends with two pad frames.
pub const K_PAD_FRAMES_PER_ROW : u8 = 2;
; XC7A200T: IDCODE 0x03636093, five clock-region rows (two top, three bottom), each with 3660
; CLB/IO/CLK frames and 1152 block RAM frames (prjxray-db part.json).
pub const K_XC7A200T_IDCODE : u32 = 56844435;
pub const K_XC7A200T_ROWS : u8 = 5;
pub const K_XC7A200T_CLB_ROW_FRAMES : u16 = 3660;
pub const K_XC7A200T_BRAM_ROW_FRAMES : u16 = 1152;
pub const K_XC7A200T_FRAMES : u32 = 24080;
; Cells per band in the frame map.
pub const K_STRIP_BUCKETS : u16 = 160;
; Frames compared between two pauses that let the page draw.
pub const K_CHUNK_FRAMES : u16 = 2000;

