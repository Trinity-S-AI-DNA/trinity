pub const KIND : str = "widget-tool";
pub const ID : str = "synth-smells";
pub const TITLE : str = "Synth smells: a lint card for your yosys log";
pub const DESCRIPTION : str = "Paste or drop a yosys synth_xilinx log: latches, undriven wires, driver conflicts, memories turned into flip-flops, warnings and final cell counts, read in your browser.";
pub const IMAGE_ALT : str = "A lint card on black for four real yosys 0.67 synth_xilinx logs: two t27 specs synthesise clean (346 and 317 LUTs), one is refused at a syntax error, and a hand-written teaching sample shows 1 latch, 1 undriven wire, 3 conflicting-driver nets, 1 memory rebuilt from flip-flops and 12 warnings.";
pub const HOOK : str = "Paste your yosys log and see the latch you did not mean, the wire nothing drives, and the RAM that became 16 flip-flops.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [6]str = ["Yosys 0.67+post (git sha1 b8e7da6f), one run per sample: yosys -q -l <stem>.full.log -p \"read_verilog -sv <stem>.v; synth_xilinx -family xc7 -flatten -top <top>\"; every command, exit code and time in samples.json", "specs/ternary/stream_ternary_mac.t27, specs/ternary/comb_ternary_dot.t27 and specs/base/ternary_add.t27, compiled to Verilog by public/t27/t27_compiler.wasm in node (sha256 of spec, compiler and Verilog in samples.json)", "scripts/widget-data/synth-smells-teaching.v: a hand-written teaching sample, not from a spec, with a latch, an undriven wire, two drivers on one wire and a reset-cleared register file", "node scripts/widget-data/synth-smells.mjs: compiles, runs yosys, trims each log by rule (never by hand) and fails unless the full and trimmed log parse to the same counts", "public/widgets/synth-smells/smellparse.js: the one parser, run in node for the samples and in the browser for your log", "node scripts/widget-data/synth-smells.mjs --check: re-parses the shipped logs and fails if any K_ fact in this spec disagrees"];
