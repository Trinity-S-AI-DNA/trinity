; --- Numbers the tool relies on ------------------------------------------------------------
; 0xAA995566, the word after which the configuration logic reads packets.
pub const K_SYNC_WORD : u32 = 2862175590;
pub const K_FRAME_WORDS : u8 = 101;
; 0x0FFFFFFF: the IDCODE compared without its top four bits, the silicon version.
pub const K_IDCODE_MASK : u32 = 268435455;
; Every configuration row in the FDRI stream ends with two pad frames.
pub const K_PAD_FRAMES_PER_ROW : u8 = 2;
; The bench: three QMTech Wukong V1 boards, XC7A200T, IDCODE 0x03636093 with the version masked
; (gHashTag/t27 fpga/HARDWARE_SSOT.md). The XC7A100T is 0x03631093.
pub const K_BENCH_IDCODE : u32 = 56844435;
pub const K_XC7A100T_IDCODE : u32 = 56823955;
; Clock-region rows per die, and the two block types an FDRI stream writes (CLB/IO/CLK, block RAM).
pub const K_XC7A100T_ROWS : u8 = 4;
pub const K_XC7A200T_ROWS : u8 = 5;
pub const K_BLOCK_TYPES_WRITTEN : u8 = 2;
; The six samples, in the order of SAY_SAMPLE_IDS; scripts/widget-data/bit-autopsy.mjs exits 1 if
; any of these differs from what the parser and prjxray bitread find in the files.
pub const K_SAMPLE_IDCODES : [6]u32 = [56823955, 56844435, 56823955, 56823955, 56823955, 56823955];
pub const K_SAMPLE_FRAME_SLOTS : [6]u32 = [9464, 24080, 9464, 9464, 9464, 9464];
pub const K_SAMPLE_CONFIG_FRAMES : [6]u32 = [9448, 24060, 9448, 9448, 9448, 9448];
pub const K_SAMPLE_NONZERO_FRAMES : [6]u32 = [134, 230, 152, 9, 75, 137];
pub const K_SAMPLE_BYTES : [6]u32 = [3825921, 9730757, 3825920, 3825921, 3825920, 3825905];
; Cells per band in the frame map.
pub const K_STRIP_BUCKETS : u16 = 160;
; The card the Download PNG button saves.
pub const K_CARD_W : u16 = 1200;
pub const K_CARD_H : u16 = 630;

