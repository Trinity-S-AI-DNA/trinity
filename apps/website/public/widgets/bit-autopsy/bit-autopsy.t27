; --- Tests ----------------------------------------------------------------------------------
test the_sync_word_and_the_idcode_mask {
    assert K_SYNC_WORD == 170 * 16777216 + 153 * 65536 + 85 * 256 + 102;
    assert K_IDCODE_MASK == 268435455;
    assert K_FRAME_WORDS == 101;
}

test blink_j26_writes_the_xc7a100t_idcode_not_the_bench_one {
    assert SAY_SAMPLE_IDS[0] == "blink_j26";
    assert K_SAMPLE_IDCODES[0] == K_XC7A100T_IDCODE;
    assert K_SAMPLE_IDCODES[0] != K_BENCH_IDCODE;
    assert K_XC7A100T_IDCODE == 3 * 16777216 + 99 * 65536 + 16 * 256 + 147;
}

test every_t27_sample_is_a_100t_and_the_receipt_is_the_bench_200t {
    assert K_SAMPLE_IDCODES[1] == K_BENCH_IDCODE;
    assert K_BENCH_IDCODE == 3 * 16777216 + 99 * 65536 + 96 * 256 + 147;
    assert K_SAMPLE_IDCODES[2] == K_XC7A100T_IDCODE;
    assert K_SAMPLE_IDCODES[3] == K_XC7A100T_IDCODE;
    assert K_SAMPLE_IDCODES[4] == K_XC7A100T_IDCODE;
    assert K_SAMPLE_IDCODES[5] == K_XC7A100T_IDCODE;
}

test frame_slots_are_config_frames_plus_two_pads_per_row {
    assert K_SAMPLE_FRAME_SLOTS[0] == K_SAMPLE_CONFIG_FRAMES[0] + K_PAD_FRAMES_PER_ROW * K_XC7A100T_ROWS * K_BLOCK_TYPES_WRITTEN;
    assert K_SAMPLE_FRAME_SLOTS[1] == K_SAMPLE_CONFIG_FRAMES[1] + K_PAD_FRAMES_PER_ROW * K_XC7A200T_ROWS * K_BLOCK_TYPES_WRITTEN;
    assert K_SAMPLE_FRAME_SLOTS[1] == 24080;
    assert K_SAMPLE_FRAME_SLOTS[0] * K_FRAME_WORDS * 4 < K_SAMPLE_BYTES[0];
}

test most_frames_are_zero {
    assert K_SAMPLE_NONZERO_FRAMES[0] == 134;
    assert K_SAMPLE_NONZERO_FRAMES[0] * 50 < K_SAMPLE_CONFIG_FRAMES[0];
    assert K_SAMPLE_NONZERO_FRAMES[1] * 100 < K_SAMPLE_CONFIG_FRAMES[1];
    assert K_SAMPLE_NONZERO_FRAMES[3] == 9;
}

test the_page_reads_files_and_sends_nothing {
    assert READS_LOCAL_FILES == true;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
    assert K_CARD_W == 1200;
    assert K_CARD_H == 630;
}

