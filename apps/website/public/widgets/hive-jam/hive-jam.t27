// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-jam.t27 -- The review jam: which case a stuck pull request is in
; Source of truth for public/widgets/hive-jam/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-jam/logic.js -- the fn
; bodies of gHashTag/t27 specs/automation/review-jam.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 13 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader toggles the nine facts. The lit rung, where the pull request sits, is
; the case jam_case(measured, draft or fresh, stacked, conflicting, labeled, refused, pushed after,
; has reviewer, only noise red) names.

; WHAT IT DOES NOT CLAIM:  it reads no pull request: the facts are what the reader sets.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_jam;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-jam";
pub const TITLE : str = "The review jam: which case a stuck pull request is in";
pub const DESCRIPTION : str = "Nine facts about a pull request that will not move. Toggle them: the earliest rule that matches wins, and the pull request lands on that rule.";
pub const IMAGE_ALT : str = "Review jam card: a measured pull request, refused, pushed after the refusal, with a reviewer and only noise checks red. Of ten rules in first-match order the sixth, refused then pushed, is lit and holds the card, ahead of noise red, which also matches.";
pub const HOOK : str = "A pull request can be refused, pushed again and red at once. The earliest rule that matches wins, so the Queen always knows which one case she is in.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/automation/review-jam.t27 (t27 master c42f8fb40): every value on the page is jam_case, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 13 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_CASES : u8 = 10;
; The case jam_case returns when no rule matches; the rule order is read from jam_case itself (tool.js).
pub const K_JAM_NONE : u8 = 0;
pub const K_PRESET_FLAGS : [5]u16 = [481, 0, 3, 9, 1];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [5]str = ["Refused, pushed, noise red", "Not measured", "A draft", "Conflicting", "No reviewer yet"];
pub const SAY_ASK : str = "A pull request has not moved for hours. Which jam is it in?";
pub const SAY_FLAGS : [9]str = ["measured", "draft or fresh", "stacked on an open PR", "conflicting", "labeled reviewed", "refused", "pushed after the refusal", "has a reviewer", "only noise checks red"];
pub const SAY_CASE_NAMES : [10]str = ["NONE", "NO REVIEWER", "STACKED ON OPEN", "REFUSED NOT FIXED", "REFUSED THEN PUSHED", "LABELED NOT MERGED", "CONFLICTING", "NOISE RED", "DRAFT OR FRESH", "UNMEASURED"];
pub const SAY_RULES : str = "the rules, first match wins";
pub const SAY_PR : str = "this pull request";
pub const SAY_CASE : str = "case";
pub const SAY_NOTE : str = "Pushed without a refusal is not refused then pushed: it is no jam at all. Unmeasured beats every other fact, because a pull request the Queen could not read is never reported as free.";
pub const SAY_SOURCE : str = "Logic: t27 spec automation/review-jam.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test ten_cases_ten_rules {
    assert K_CASES == 10;
    assert K_JAM_NONE == 0;
    assert K_JAM_NONE < K_CASES;
}

test the_start_is_measured_and_refused {
    assert K_PRESET_FLAGS[0] == 481;
    assert K_PRESET_FLAGS[1] == 0;
}
