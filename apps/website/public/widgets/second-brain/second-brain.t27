// SPDX-License-Identifier: Apache-2.0
; specs/widgets/second-brain.t27 -- Second Brain widget tool
; A demo node-link graph on the shared graph-kit renderer. Four independent layers:
; graph data, one interaction state, the view mode (how the graph is drawn) and the
; theme id (how the whole screen is styled). Demo data is spelled here, in the spec,
; and marked as demo by SAY_NOTE; nothing is read from a file or sent.

module widget_second_brain;

pub const KIND : str = "widget-tool";
pub const ID : str = "second-brain";
pub const TITLE : str = "Second Brain";
pub const DESCRIPTION : str = "A knowledge graph of concepts and their references";
pub const IMAGE_ALT : str = "A node-link diagram of a second brain graph with concepts and edges";
pub const HOOK : str = "A node-link diagram showing concepts connected by reference edges";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["DEMO DATA spelled in this spec, not read from any file", "No fetch, no cookie, nothing sent"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The graph: demo nodes ----------------------------------------------------
pub const K_NODE_COUNT : u8 = 6;
pub const SAY_NODE_TITLES : [6]str = ["Alpha", "Beta", "Gamma", "Delta", "Epsilon", "Zeta"];
pub const SAY_NODE_KINDS : [6]str = ["concept", "concept", "note", "concept", "source", "note"];

; --- The graph: demo edges ----------------------------------------------------
pub const K_EDGE_COUNT : u8 = 6;
pub const SAY_EDGE_LABELS : [6]str = ["relates to", "extends", "contrasts", "references", "extends", "relates to"];
pub const K_EDGE_SRC : [6]u8 = [0, 1, 2, 3, 4, 0];
pub const K_EDGE_DST : [6]u8 = [1, 2, 3, 4, 5, 5];

; --- Presentation contract: view modes and theme ids ---------------------------
; view_mode: how the graph itself is drawn; theme_id: which style template the whole
; screen uses. Both are declarative names the shared kit knows; neither holds JS.
pub const K_VIEW_MODE_COUNT : u8 = 2;
pub const SAY_VIEW_MODES : [2]str = ["discs", "squares"];
pub const K_THEME_COUNT : u8 = 2;
pub const SAY_THEME_IDS : [2]str = ["slate", "paper"];

; --- The table ----------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "DEMO: the six nodes of the graph above";
pub const SAY_TABLE_HEAD : [2]str = ["Index", "Node"];
pub const SAY_TABLE_CELLS : [12]str = ["0", "Alpha", "1", "Beta", "2", "Gamma", "3", "Delta", "4", "Epsilon", "5", "Zeta"];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 6;
pub const K_TABLE_CELLS : u16 = 12;

pub const SAY_NOTE : str = "Demo data: six nodes and six edges spelled in this spec. Click a node to select it; drag to pan; scroll to zoom. Switching the view mode or the theme keeps the selection, the filter, the pan and the zoom.";

test constants_verify {
    assert ID == "second-brain";
    assert TITLE == "Second Brain";
    assert CATEGORY == "compiler";
    assert READS_LOCAL_FILES == false;
    assert SENDS_NOTHING == true;
}

test graph_counts_agree {
    assert K_NODE_COUNT == 6;
    assert K_EDGE_COUNT == 6;
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test edges_reference_existing_nodes {
    assert K_EDGE_SRC[0] < K_NODE_COUNT;
    assert K_EDGE_DST[0] < K_NODE_COUNT;
    assert K_EDGE_SRC[5] < K_NODE_COUNT;
    assert K_EDGE_DST[5] < K_NODE_COUNT;
}

test presentation_contract {
    assert K_VIEW_MODE_COUNT == 2;
    assert K_THEME_COUNT == 2;
    assert SAY_VIEW_MODES[0] == "discs";
    assert SAY_VIEW_MODES[1] == "squares";
    assert SAY_THEME_IDS[0] == "slate";
    assert SAY_THEME_IDS[1] == "paper";
}
