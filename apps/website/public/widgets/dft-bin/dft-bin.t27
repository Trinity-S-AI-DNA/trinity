// SPDX-License-Identifier: Apache-2.0
; specs/widgets/dft-bin.t27 -- bins of a spectrum: what one DFT bin measures, and leakage between bins
; Source of truth for public/widgets/dft-bin/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/dft-bin/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 15 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader picks a DFT length, a tone frequency in bins (it may sit between bins) and a
; window. The spectrum shows every bin's level; a tone on a bin is one bar at 0 dB, a tone between bins
; spreads into all of them. Below, the windowed input twice over, with the seam the DFT assumes between
; one copy and the next.

; WHAT IT DOES NOT CLAIM: a single real tone and two windows; noise, averaging and other windows are not modelled.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_dft_bin;

pub const KIND : str = "widget-tool";
pub const ID : str = "dft-bin";
pub const TITLE : str = "Bins of a spectrum: one tone, and where it leaks";
pub const DESCRIPTION : str = "Slide a tone across the bins of a DFT. On a bin it is one clean bar; between bins it leaks everywhere, unless a window tapers the seam.";
pub const IMAGE_ALT : str = "DFT bin card: a 64-point DFT of a tone at 8.5 bins, rectangular window. The peak bins read -3.7 dB and the leakage falls off slowly; a Hann window lowers the far bins by tens of dB.";
pub const HOOK : str = "Move a tone half a bin and the peak drops 3.7 dB and leaks into every bin. A window trades that leakage for a wider peak.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "F. J. Harris, On the use of windows for harmonic analysis with the discrete Fourier transform, Proc. IEEE 66(1), 1978", "R. G. Lyons, Understanding Digital Signal Processing, 3rd ed., ch. 3: the DFT, leakage and windows"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_LENGTHS : [4]u16 = [16, 32, 64, 128];
pub const K_WINDOW_KINDS : [2]u8 = [0, 3];
pub const K_WIN_RECT : u8 = 0;
pub const K_WIN_HANN : u8 = 3;
pub const K_DB_SHOWN : u8 = 100;
pub const K_MAX_K0 : u8 = 32;
pub const K_K0_STEP_DIV : u8 = 20;
pub const K_FAR_BINS : u8 = 4;
pub const K_PRESET_LEN : [4]u8 = [2, 2, 2, 3];
pub const K_PRESET_K0_HUNDREDTHS : [4]u16 = [800, 850, 850, 1030];
pub const K_PRESET_WINDOW : [4]u8 = [0, 0, 1, 1];
pub const K_START_PRESET : u8 = 1;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["on bin 8", "at 8.5: leakage", "at 8.5, Hann window", "128 points, 10.3, Hann"];
pub const SAY_LEN : str = "DFT length";
pub const SAY_K0 : str = "Tone, in bins";
pub const SAY_WINDOW : str = "Window";
pub const SAY_WINDOWS : [2]str = ["rectangular", "Hann"];
pub const SAY_SPEC_LABEL : str = "The level of every bin, in dB, with the tone marked";
pub const SAY_TIME_LABEL : str = "The windowed input, twice, with the seam between copies";
pub const SAY_BIN_AXIS : str = "bin";
pub const SAY_DB : str = "dB";
pub const SAY_TONE_AT : str = "tone at {0}";
pub const SAY_TIME_AXIS : str = "samples: the input and its repeat";
pub const SAY_SEAM : str = "seam";
pub const SAY_NOTE : str = "A DFT sees its input as one period of a repeat. If the tone does not fit a whole number of cycles, the seam jumps, and the jump is the leakage.";
pub const SAY_TONE : str = "tone";
pub const SAY_BINS : str = "{0} bins";
pub const SAY_PEAK : str = "highest bin";
pub const SAY_DB_VALUE : str = "{0} dB";
pub const SAY_LEAK : str = "bin {0}";
pub const SAY_WIN : str = "window";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/signals.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_windows_are_the_spec_kinds {
    assert K_WINDOW_KINDS[0] == K_WIN_RECT;
    assert K_WINDOW_KINDS[1] == K_WIN_HANN;
    assert K_PRESET_WINDOW[1] == 0;
    assert K_PRESET_WINDOW[2] == 1;
}

test the_presets_sit_on_and_between_bins {
    assert K_PRESET_K0_HUNDREDTHS[0] % 100 == 0;
    assert K_PRESET_K0_HUNDREDTHS[1] % 100 == 50;
    assert K_LENGTHS[3] / 2 >= K_PRESET_K0_HUNDREDTHS[3] / 100;
    assert K_MAX_K0 * 4 == K_LENGTHS[3];
}
