// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-slices.t27 -- Bytes, slices and a table of strings in the Rust backend
; Source of truth for public/widgets/cmp-slices/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-slices/logic.js -- the fn
; bodies of gHashTag/t27 specs/compiler/codegen_conformance.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 15 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader types a text and taps a byte: count_byte counts it in the text and is_digit judges it. Two sliders
; pick an index into the spec's slice of three numbers and its table of three strings, and first_plus_of_three and name_len answer.

; WHAT IT DOES NOT CLAIM:  it runs the bodies as WebAssembly, not through rustc, and shows no Rust. That the Rust once failed is the
; spec's own account in its header. The indexes stop at 2: the slice and the table each have three entries.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_slices;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-slices";
pub const TITLE : str = "Bytes, slices and a table of strings in the Rust backend";
pub const DESCRIPTION : str = "The Zig tests passed, but the Rust that t27c wrote for them was refused by rustc. Four small cases pin it: counting a byte in a text, a digit test, a slice parameter and a table of strings.";
pub const IMAGE_ALT : str = "Slices card: the text banana with the byte a selected. count_byte answers 3, drawn as three lit cells, and is_digit answers false for the byte. A slice of 4, 5 and 6 gives first_plus_of_three of 2 equal to 10, and a table of the strings a, bb and ccc gives a length of 3 for the third.";
pub const HOOK : str = "A spec can pass in Zig and fail in rustc. These cases run the Rust path: a char is a byte, a slice is borrowed, a table of strings keeps each length.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/compiler/codegen_conformance.t27 (t27 master 90e797659): every result is count_byte, is_digit, first_plus_of_three or name_len, fn bodies compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 15 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 4;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_XS : [3]u8 = [4, 5, 6];
pub const K_MAX_INDEX : u8 = 2;
pub const K_MAX_TEXT : u8 = 24;
pub const K_START_BYTE : u8 = 97;
pub const K_START_INDEX : u8 = 2;
pub const K_START_SAMPLE : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine steps of this course; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_SAMPLES : [4]str = ["banana", "rate_2 + 7", "a1b22c333", ""];
pub const SAY_ASK : str = "Can the Rust a backend writes still count bytes, take slices and keep strings?";
pub const SAY_TEXT_LABEL : str = "A text";
pub const SAY_TAP : str = "Tap a byte to count it";
pub const SAY_COUNT : str = "count_byte of byte {0}";
pub const SAY_IS_DIGIT : str = "is_digit of byte {0}";
pub const SAY_YES : str = "yes";
pub const SAY_NO : str = "no";
pub const SAY_INDEX : str = "index";
pub const SAY_SLICE : str = "the slice";
pub const SAY_FIRST_PLUS : str = "first_plus_of_three of {0}";
pub const SAY_NAMES : [3]str = ["a", "bb", "ccc"];
pub const SAY_TABLE : str = "the table of strings";
pub const SAY_NAME_LEN : str = "name_len of {0}";
pub const SAY_NOTHING : str = "An empty text has no byte to count.";
pub const SAY_NOTE : str = "These cases are the Rust that t27c gen-rust writes: a character literal is a byte, a read-only slice parameter takes a slice, and a table of strings keeps each length. The slice of three numbers and the table of three strings are the spec's own.";
pub const SAY_SOURCE : str = "Logic: t27 spec compiler/codegen_conformance.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_is_one_of_nine_course_steps {
    assert K_STAGE < 9;
    assert K_STAGE == 4;
}

test the_slice_has_three_numbers_and_the_index_stops_at_two {
    assert K_XS[0] == 4;
    assert K_XS[2] == 6;
    assert K_MAX_INDEX == 2;
    assert K_START_INDEX == K_MAX_INDEX;
}

test the_start_counts_the_letter_a_in_banana {
    assert K_START_BYTE == 97;
    assert K_START_SAMPLE == 0;
    assert K_MAX_TEXT == 24;
}
