// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-tuple.t27 -- A tuple type the Verilog backend takes, and one it refuses
; Source of truth for public/widgets/cmp-tuple/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-tuple/logic.js -- the fn
; bodies of gHashTag/t27 specs/compiler/verilog_names.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 8 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader types a type text or takes a sample. The widget asks the three byte tests under the rule (starts, ends_with,
; bytes_contain) and then the rule itself, is_simple_tuple_type, and also asks is_icarus_builtin whether the text is the one injected helper.

; WHERE THE FNS COME FROM:
; verilog_names.t27 declares is_simple_tuple_type and is_icarus_builtin. The tests under its verdict are spliced in through use and
; are not vendored beside this widget: starts from tri/t27b/type_text.t27 and bytes_contain from tools/t27o/rust_std.t27. The spec
; writes its closing-parenthesis test inline, so the page asks ends_with of hosting/toolchain.t27, which rust_std.t27 uses.

; WHAT IT DOES NOT CLAIM:  it does not combine the three tests itself: the verdict is the spec's one fn, shown beside them. The closing-parenthesis row asks ends_with of another spec, the same question: verilog_names.t27 does not call it. Nothing
; here lowers a tuple to Verilog; the page only answers the text question the lowering asks first.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_tuple;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-tuple";
pub const TITLE : str = "A tuple type the Verilog backend takes, and one it refuses";
pub const DESCRIPTION : str = "The Verilog backend lowers a tuple type only when it is plain parentheses with no named field. Type a type text and see the three byte tests and the verdict is_simple_tuple_type gives.";
pub const IMAGE_ALT : str = "Tuple card: the text (u8, x: u16) is refused as a simple tuple type. It starts with an opening parenthesis and ends with a closing one, but it contains a colon, which marks a named field, so the verdict is no.";
pub const HOOK : str = "Hardware has no named tuple fields: a colon anywhere in the type text is enough for the Verilog backend to refuse it, and it decides from the text alone.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/compiler/verilog_names.t27 (t27 master 90e797659): is_simple_tuple_type and is_icarus_builtin, and the byte tests spliced in through use: starts from specs/tri/t27b/type_text.t27, bytes_contain from specs/tools/t27o/rust_std.t27 and ends_with from specs/hosting/toolchain.t27, fn bodies compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 8 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 2;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_COLON : u8 = 58;
pub const K_MAX_TEXT : u8 = 24;
pub const K_START_SAMPLE : u8 = 1;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine steps of this course; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_SAMPLES : [6]str = ["(u8, u16)", "(u8, x: u16)", "()", "((u8, u8), u16)", "u8", "__mul_noop"];
pub const SAY_ASK : str = "Which tuple types can the Verilog backend lower, from their text alone?";
pub const SAY_TEXT_LABEL : str = "A type text";
pub const SAY_TESTS : [3]str = ["starts with an opening parenthesis", "ends with a closing parenthesis", "contains a colon"];
pub const SAY_VERDICT : [2]str = ["a simple tuple type", "not a simple tuple type"];
pub const SAY_VERDICT_LINE : str = "is_simple_tuple_type";
pub const SAY_BUILTIN : str = "is_icarus_builtin";
pub const SAY_BUILTIN_NAME : str = "the helper the backend injects for a multiply: __mul_noop";
pub const SAY_YES : str = "yes";
pub const SAY_NO : str = "no";
pub const SAY_NOTE : str = "A simple tuple type is a parenthesised text with no field names: a colon refuses it, and so does a text that is not parenthesised. The Icarus builtin is one name the backend adds by itself, so it has no definition in the source. The spec checks the closing parenthesis inline, so that row asks ends_with of hosting/toolchain.t27, the same question.";
pub const SAY_SOURCE : str = "Logic: t27 spec compiler/verilog_names.t27, with starts from tri/t27b/type_text.t27, bytes_contain from tools/t27o/rust_std.t27 and ends_with from hosting/toolchain.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_is_one_of_nine_course_steps {
    assert K_STAGE < 9;
    assert K_STAGE == 2;
}

test the_colon_is_byte_fifty_eight {
    assert K_COLON == 58;
    assert K_COLON == 48 + 10;
}

test the_start_is_a_text_with_a_named_field {
    assert K_START_SAMPLE == 1;
    assert K_MAX_TEXT == 24;
}
