pub var THEME : [288]u8 = [0; 288];
pub var THEME_L : [9]u32 = [0; 9];
pub var WPX : f64 = 0.0;

// the reader's work arrays and the two copies of a result: the one being parsed, and the one on show
pub var PTEXT : [262144]u8 = [0; 262144];
pub var PTEXT_LEN : u32 = 0;
pub var LS : [524290]u32 = [0; 524290];
