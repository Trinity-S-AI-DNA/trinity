; --- Tests -----------------------------------------------------------------------------------------
test the_uart_rx_sample_is_four_states_and_fourteen_rows {
    assert K_SAMPLE_IDS[0] == "uart-rx";
    assert K_SAMPLE_FOUND[0] == 1;
    assert K_SAMPLE_STATES[0] == 4;
    assert K_SAMPLE_TRANSITIONS[0] == 14;
    assert K_SAMPLE_INPUTS[0] == 4;
    assert K_CARD_SAMPLE == 0;
}

test plain_opt_on_the_same_file_finds_nothing_and_names_nothing {
    assert K_SAMPLE_DESIGNS[0] == "fpga/rtl/uart_rx.v";
    assert K_SAMPLE_DESIGNS[3] == "fpga/rtl/uart_rx.v";
    assert K_SAMPLE_OPTS[0] == "opt -nodffe -nosdff";
    assert K_SAMPLE_OPTS[3] == "opt";
    assert K_SAMPLE_FOUND[3] == 0;
    assert K_SAMPLE_REJECTED[3] == 0;
    assert K_SAMPLE_STATES[3] == 0;
}

test the_traffic_light_is_named_and_refused {
    assert K_SAMPLE_TOPS[2] == "fsm_simple";
    assert K_SAMPLE_FOUND[2] == 0;
    assert K_SAMPLE_REJECTED[2] == 1;
    assert K_SAMPLE_REASON == "Register has an initialization value.";
}

test two_of_four_runs_extract_an_fsm {
    assert K_SAMPLE_FOUND[0] + K_SAMPLE_FOUND[1] + K_SAMPLE_FOUND[2] + K_SAMPLE_FOUND[3] == 2;
    assert K_SAMPLE_STATES[1] == 7;
    assert K_SAMPLE_TRANSITIONS[1] == 23;
    assert K_SAMPLE_TRANSITIONS[1] > K_SAMPLE_STATES[1];
}

test the_card_and_the_page {
    assert K_CARD_W == 1200;
    assert K_CARD_H == 630;
    assert K_CARD_GRAPH_W < K_CARD_W;
    assert K_MIN_TARGET_PX == 32;
    assert READS_LOCAL_FILES == true;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
}


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, issue #10938, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/fsm-sketch/tool.js (361 lines of hand-written JavaScript). The
; yosys log and KISS2 readers and the layout of the state diagram are NOT rewritten here: they are
; imported from fsm_sketch_logic.t27 (the port of fsmparse.js, differential-tested). The words above are
; unchanged and are the only words the view prints.
; Host protocol (jtag_verdict.t27's plus, all optional, the host calls what the wasm exports):
;   w_init(hash)              the page opens
;   w_base(bytes)             the URL of the folder the page is served from, with a closing slash: the links
;                             to the sample files are written absolute, as tool.js's new URL(..) writes them
;   w_theme(bytes)            the nine colours of the shared frame, --w-bg --w-panel --w-line --w-green --w-gold
;                             --w-red --w-text --w-muted --w-subtle, one per line, as getComputedStyle gives
;                             them (#888 where a variable is empty): they are written into the SVG so that a
;                             saved copy stands alone
;   w_size(px)                the width of the diagram box, 0 when it is not laid out; the host calls it after
;                             every draw and whenever the box is resized (tool.js's ResizeObserver)
;   w_data(i, bytes)          file i of K_DATA_FILES has been fetched: 0 sample.json, 1 to 4 the yosys logs of
;                             the samples, in the order of K_SAMPLE_IDS; w_data_failed(i) when it could not be
;   w_input(i, bytes)         control i changed (the input and textarea elements in page order: 0 the file
;                             input, 1 the text area); only the text area is read, when "Draw it" is pressed
;   w_click(i)                button i was pressed (index among the page's buttons)
;   w_drag(kind)              0 dragover, 1 dragleave, 2 drop on the file box; 1 when the box changed
;   w_file(name, size, bytes, st)   a file was picked or dropped; st 0 read, 1 read failed
;   w_value(i, dst) -> n      the text control i must now hold (Clear), or 4294967295 for "leave it"
;   w_effect(dst) -> n        an action for the host: byte 1 then a CSS selector, a newline and a file name means
;                             "save the SVG that selector finds, serialised, under that name"; else a CSS
;                             selector to scroll into view; 0 for none
;   w_render(dst) -> len      the page's HTML (0 on overflow); the host draws again while
;   w_libm_need(dst) -> n     says n libm calls were missing in that pass (the wasm has no libm): n records of
;                             three f64, op (0 sin 1 cos 2 atan2 3 log2 4 log10 5 pow), a, b; the host computes
;                             them with Math.* and answers
;   w_libm_give(src, n)       with the n results, in order. The pass is repeated until none is missing.
; Why the libm service: Math.sin, Math.cos and Math.atan2 of V8 differ in the last bit from every portable
; libm (fsm_sketch_logic.t27, "Floating point"); the page has to print what the browser's own functions give.
; --
; The four module variables of the logic (V, M, NUMFLAG, PEND) are declared here: t27c does not splice a
; `pub var` across a `use` (measured), and the imported functions name them.
; --
; What is NOT carried over from tool.js (also reported in the commit message):
;  * texts over 262144 bytes are not read (the page's own limit is K_MAX_CHARS = 4000000); a text between the
;    two shows the "too big" line with 262144 as the limit; a log with more than 60000 events, 16384
;    transition rows, 256 FSMs or 1024 states is not read either (the same line);
;  * non-ASCII is not mapped by trim or by \\s in the readers (see fsm_sketch_logic.t27, "Domain");
;  * the width of the diagram is the host's last measure: the first draw of a result uses K_DIAGRAM_MIN_W and
;    the host's size message then draws it again at the measured width (tool.js measures first);
;  * a sample that is still on its way when its button is pressed is shown when it arrives (tool.js fetches
;    on the press); the last press wins.
; --

pub const K_DATA_FILES : [5]str = ["./sample.json", "./samples/uart-rx.yosys.txt", "./samples/spi-flash.yosys.txt", "./samples/fsm-simple.yosys.txt", "./samples/uart-rx-plain-opt.yosys.txt"];

pub var V : [8]f64 = [0.0; 8];
pub var M : [8]usize = [0; 8];
pub var NUMFLAG : u32 = 0;
pub var PEND : [2]usize = [0; 2];

pub const W_NO : u32 = 4294967295;
pub const W_TEXT_CAP : u32 = 262144;
pub const W_MAX_ROWS : u32 = 16384;
pub const W_MAX_STATES : u32 = 1024;
pub const W_MAX_FSMS : u32 = 256;

// raw data
pub var SJ : [65536]u8 = [0; 65536];
pub var SJ_LEN : u32 = 0;
pub var SLOG : [524288]u8 = [0; 524288];
pub var SL_LEN : [4]u32 = [0; 4];
pub var D_STATE : [5]u8 = [0; 5];
