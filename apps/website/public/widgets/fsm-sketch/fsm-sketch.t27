pub var LOUT : [262144]u32 = [0; 262144];
pub var LNUMS : [1024]f64 = [0.0; 1024];
pub var LRES : [32]u32 = [0; 32];
pub var LIVE : bool = false;

// what the page shows besides the result
pub var PICK : u32 = 0;
