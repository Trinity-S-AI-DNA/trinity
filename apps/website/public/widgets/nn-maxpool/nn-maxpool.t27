// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-maxpool.t27 -- max pooling: keep the largest value of each window, and where it was
; Source of truth for public/widgets/nn-maxpool/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-maxpool/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/layers/maxpool2d_layer.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 11 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader picks one of four window and stride pairs and taps an output. Outputs and
; argmax indices are pool_at(kernel, stride, 0 or 1, i) and the output side is out_side(kernel,
; stride); for 2 x 2 stride 2 the gradient view is backward_at(i), the spec's output gradients
; 1, 2, 3, 4.

; WHAT IT DOES NOT CLAIM: the grid is the spec's fixture, repeated as K_INPUT; the outputs and
; argmax come from the compiled fn, so a K_INPUT that drifted would show a max that is not in its
; window.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_maxpool;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-maxpool";
pub const TITLE : str = "Max pooling: what a network keeps when it shrinks a picture";
pub const DESCRIPTION : str = "Pick a window size and stride and tap an output: max pooling keeps the largest value of its window and remembers where it was, and the gradient later goes to that one cell.";
pub const IMAGE_ALT : str = "Max-pool card, 2 x 2 windows with stride 2: the spec's 4 x 4 grid in pink and green, with cell 13 (value 9) outlined inside its window; the 2 x 2 output reads 4, 8, 9, -2 with 9 outlined. Tiles read max 9, argmax 13, output 2 x 2 and gradient at the max 3.";
pub const HOOK : str = "On the spec's 4 x 4 grid, 2 x 2 windows with stride 2 keep 4, 8, 9 and -2; their gradients land on cells 5, 6, 13 and 11 and nowhere else.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/layers/maxpool2d_layer.t27 (t27 master 2e53089d5): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 11 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_SIDE : u8 = 4;
pub const K_INPUT : [16]i8 = [1, 2, 5, 6, 3, 4, 8, 7, 0, -1, -3, -2, -4, 9, -6, -5];
pub const K_KERNELS : [4]u8 = [2, 3, 2, 4];
pub const K_STRIDES : [4]u8 = [2, 1, 1, 1];
pub const K_PRESET_CFG : [3]u8 = [0, 1, 2];
pub const K_PRESET_CELL : [3]u8 = [2, 0, 4];
pub const K_PRESET_GRAD : [3]u8 = [0, 0, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [3]str = ["2 x 2, stride 2", "3 x 3, stride 1", "2 x 2, stride 1"];
pub const SAY_ASK : str = "What does a network keep when it shrinks a picture?";
pub const SAY_CONFIG : str = "window, stride";
pub const SAY_CONFIG_NAMES : [4]str = ["2 x 2 / 2", "3 x 3 / 1", "2 x 2 / 1", "4 x 4 / 1"];
pub const SAY_SHOW_GRAD : str = "show the gradient (2 x 2 / 2)";
pub const SAY_IN_LABEL : str = "The spec's 4 x 4 input, the max of the window outlined";
pub const SAY_GRAD_LABEL : str = "The gradient each input receives";
pub const SAY_OUT_LABEL : str = "The output: tap a cell";
pub const SAY_MAX : str = "max";
pub const SAY_ARGMAX : str = "from cell";
pub const SAY_OUT_SIDE : str = "output";
pub const SAY_GRAD_AT_MAX : str = "gradient there";
pub const SAY_NO_GRAD : str = "2 x 2 / 2 only";
pub const SAY_NOTE : str = "A max pool forgets every value but one per window, which makes the network care less about exactly where a feature sits. In backpropagation the whole gradient of a window goes to its maximum.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/layers/maxpool2d_layer.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_four_configs_are_the_spec_window_stride_pairs {
    assert K_KERNELS[0] == 2;
    assert K_STRIDES[0] == 2;
    assert K_KERNELS[1] == 3;
    assert K_STRIDES[1] == 1;
    assert K_KERNELS[2] == 2;
    assert K_STRIDES[2] == 1;
    assert K_KERNELS[3] == K_SIDE;
    assert K_STRIDES[3] == 1;
}

test the_grid_is_the_spec_fixture {
    assert K_INPUT[5] == 4;
    assert K_INPUT[6] == 8;
    assert K_INPUT[13] == 9;
    assert K_INPUT[11] + 2 == 0;
}
