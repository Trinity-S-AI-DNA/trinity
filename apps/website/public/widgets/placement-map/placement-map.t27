; --- Tests ----------------------------------------------------------------------------------
test the_die_counts_agree_with_each_other {
    assert K_LUT_BELS == 8 * K_SLICES;
    assert K_LUT6 == 4 * K_SLICES;
    assert K_LUT6 == 134600;
}

test every_type_prefix_has_a_kind_that_is_drawn {
    assert same_text(K_TYPE_KIND[0], K_KINDS[0]);
    assert same_text(K_TYPE_KIND[1], K_KINDS[1]);
    assert same_text(K_TYPE_KIND[2], K_KINDS[2]);
    assert same_text(K_TYPE_KIND[3], K_KINDS[3]);
    assert same_text(K_TYPE_KIND[5], K_KINDS[4]);
    assert same_text(K_TYPE_KIND[6], K_KINDS[5]);
    assert same_text(K_TYPE_KIND[10], K_KINDS[6]);
}

test the_touch_targets_are_big_enough {
    assert K_MIN_TARGET_PX >= 32;
    assert K_PICK_PX * 2 >= K_MIN_TARGET_PX - 4;
    assert (K_GRID_W as u32) * (K_GRID_H as u32) == 69165;
}

test the_page_reads_files_and_sends_nothing {
    assert READS_LOCAL_FILES == true;
    assert SENDS_NOTHING == true;
    assert same_text(CATEGORY, "fpga");
}

