// --- small helpers -----------------------------------------------------------------------------------------------------------

pub fn same_text(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn copy_into(dst: []u8, at: u32, s: []const u8) -> u32 {
    var n : u32 = at;
    var k : usize = 0;
    while (k < s.len and (n as usize) < dst.len) {
        dst[n as usize] = s[k];
        n = n + 1;
        k = k + 1;
    }
    return n;
}

fn is_digit(b: u8) -> bool {
    return b >= 48 and b <= 57;
}

/// Does the text start with the prefix?
fn starts(t: []const u8, w: []const u8) -> bool {
    if (t.len < w.len) { return false; }
    var k : usize = 0;
    while (k < w.len) {
        if (t[k] != w[k]) { return false; }
        k = k + 1;
    }
    return true;
}

// --- fmt(): the templates {0} {1} ... of the words, with the arguments in ARB -----------------------------------------------------

pub var ARB : [262144]u8 = [0; 262144];
pub var ARO : [8]u32 = [0; 8];
pub var ARL : [8]u32 = [0; 8];

pub fn fmt_into(dst: []u8, tpl: []const u8, nargs: u32) -> i64 {
    var n : usize = 0;
    var k : usize = 0;
    while (k < tpl.len) {
        var done : bool = false;
        if (tpl[k] == 123) {
            var q : usize = k + 1;
            var idx : u64 = 0;
            while (q < tpl.len and is_digit(tpl[q])) {
                if (idx < 100000) { idx = idx * 10 + ((tpl[q] - 48) as u64); }
                q = q + 1;
            }
            if (q > k + 1 and q < tpl.len and tpl[q] == 125) {
                if (idx < (nargs as u64)) {
                    var a : usize = 0;
                    while (a < (ARL[idx as usize] as usize)) {
                        if (n >= dst.len) { return 0 - 1; }
                        dst[n] = ARB[(ARO[idx as usize] as usize) + a];
                        n = n + 1;
                        a = a + 1;
                    }
                }
                k = q + 1;
                done = true;
            }
        }
        if (!done) {
            if (n >= dst.len) { return 0 - 1; }
            dst[n] = tpl[k];
            n = n + 1;
            k = k + 1;
        }
    }
    return n as i64;
}

fn arg_at(i: usize) -> usize {
    if (i == 0) { return 0; }
    return (ARO[i - 1] + ARL[i - 1]) as usize;
}

pub fn arg_set(i: usize, w: []const u8, lo: usize, hi: usize) -> bool {
    const at : usize = arg_at(i);
    if (at + (hi - lo) > 262144) { return false; }
    ARO[i] = at as u32;
    ARL[i] = (hi - lo) as u32;
    var k : usize = lo;
    while (k < hi) {
        ARB[at + (k - lo)] = w[k];
        k = k + 1;
    }
    return true;
}

fn arg_text(i: usize, s: []const u8) -> bool {
    return arg_set(i, s, 0, s.len);
}

/// arg i = num(x), Number.toLocaleString('en-US')
fn arg_loc(i: usize, x: f64) -> bool {
    const e : u32 = js_locale_num(S_NUM[0..], 0, x);
    if (e == OVER) { return arg_set(i, S_NUM[0..], 0, 0); }
    return arg_set(i, S_NUM[0..], 0, e as usize);
}

/// arg i = String(x) for a number
fn arg_num(i: usize, x: f64) -> bool {
    const at : usize = arg_at(i);
    if (at + 400 > 262144) { return false; }
    ARO[i] = at as u32;
    const e : u32 = js_str_num(ARB[0 .. 262144], at as u32, x);
    if (e == OVER) { return false; }
    ARL[i] = e - (at as u32);
    return true;
}

/// arg i = String(v) of the JSON value at sp; with `nullish` a null or missing value is '' (the `v ?? ''` of fmt)
fn arg_val(i: usize, d: []const u8, sp: i64, nullish: bool) -> bool {
    const at : usize = arg_at(i);
    ARO[i] = at as u32;
    ARL[i] = 0;
    const k : u8 = kind(d, sp);
    if (nullish and (k == J_NONE or k == J_NULL)) { return true; }
    if (at + 400 > 262144) { return false; }
    const e : u32 = jv_str(ARB[0 .. 262144], at as u32, d, sp);
    if (e == OVER) { return false; }
    ARL[i] = e - (at as u32);
    return true;
}

fn status_is(s: []const u8) -> u32 {
    S_STATUS_N = copy_into(S_STATUS[0..], 0, s);
    return 0;
}

fn status_fmt(tpl: []const u8, nargs: u32) -> u32 {
    const l : i64 = fmt_into(S_STATUS[0..], tpl, nargs);
    S_STATUS_N = 0;
    if (l >= 0) { S_STATUS_N = l as u32; }
    return 0;
}

/// A DOM unsigned long from a double: truncated, modulo 2^32.
fn to_uint32(x: f64) -> u64 {
    if (x != x or x - x != 0.0) { return 0; }
    var t : f64 = js_floor(x);
    if (x < 0.0) { t = js_ceil(x); }
    const m : f64 = t - 4294967296.0 * js_floor(t / 4294967296.0);
    return m as u64;
}

/// Math.hypot(a, b), V8's algorithm: the larger argument scales, a Kahan sum of the squares.
pub fn hypot2(a0: f64, b0: f64) -> f64 {
    var a : f64 = a0;
    var b : f64 = b0;
    if (a != a or b != b) {
        if (a - a != 0.0 and a == a) { return js_inf(0.0); }
        if (b - b != 0.0 and b == b) { return js_inf(0.0); }
        return js_nan(0.0);
    }
    if (a < 0.0) { a = 0.0 - a; }
    if (b < 0.0) { b = 0.0 - b; }
    var mx : f64 = 0.0;
    if (a > mx) { mx = a; }
    if (b > mx) { mx = b; }
    if (mx == js_inf(0.0)) { return mx; }
    if (mx == 0.0) { return 0.0; }
    var sum : f64 = 0.0;
    var comp : f64 = 0.0;
    var k : u32 = 0;
    while (k < 2) {
        var v : f64 = a;
        if (k == 1) { v = b; }
        const n : f64 = v / mx;
        const summand : f64 = n * n - comp;
        const prelim : f64 = sum + summand;
        comp = (prelim - sum) - summand;
        sum = prelim;
        k = k + 1;
    }
    return @sqrt(sum) * mx;
}

/// Math.abs
fn abs_f(x: f64) -> f64 {
    if (x < 0.0) { return 0.0 - x; }
    return x;
}

// --- boot ------------------------------------------------------------------------------------------------------------------------

fn kind_index(k: []const u8) -> i32 {
    var i : usize = 0;
    while (i < K_KINDS.len) {
        if (same_text(K_KINDS[i], k)) { return i as i32; }
        i = i + 1;
    }
    return 0 - 1;
}

fn init_kinds() -> u32 {
    var i : usize = 0;
    while (i < K_TYPE_PREFIX.len and i < 16) {
        KIND_OF_PFX[i] = kind_index(K_TYPE_KIND[i]);
        i = i + 1;
    }
    KIND_OTHER = kind_index("OTHER");
    return 0;
}

pub fn w_init(h: []const u8) -> u32 {
    init_kinds();
    S_GRID = false;
    S_DEMO = false;
    S_CELLS_OK = false;
    GR_N = 0;
    GM_N = 0;
    GV_N = 0;
    C_N = 0;
    C_PN = 0;
    P_N = 0;
    O_N = 0;
    S_SLICES = 0;
    BOX_ON = false;
    S_LABEL_N = 0;
    S_SRC_N = 0;
    S_CMDN = 0;
    S_VX = 0.0;
    S_VY = 0.0;
    S_VS = 1.0;
    S_CSSW = 0.0;
    S_CSSH = 0.0;
    S_LASTW = 0.0;
    S_SIZED = false;
    S_HOVER = 0 - 1;
    S_PICK = 0 - 1;
    S_INFO = false;
    S_SIDE = false;
    S_DEMO_HIDDEN = true;
    S_OVER = false;
    S_CLR_FILE = false;
    PT_N = 0;
    DR_ON = false;
    PI_ON = false;
    LB_N = 0;
    RQ_N = 0;
    MISSING = false;
    var q : usize = 0;
    while (q < 16) {
        K_CNT[q] = 0;
        q = q + 1;
    }
    status_is(SAY_LOADING);
    return 0;
}

pub fn w_view(width: f64, dpr: f64, embed: u32, ih: f64, bw: f64) -> u32 {
    ENV_W = width;
    ENV_DPR = dpr;
    ENV_EMBED = embed;
    ENV_IH = ih;
    ENV_BW = bw;
    return 0;
}

pub fn w_measure_sel(dst: []u8) -> u32 {
    return copy_into(dst, 0, W_MEASURE_SEL);
}

pub fn w_canvas_keep() -> u32 {
    return 1;
}

pub fn w_drop_root() -> u32 {
    return 1;
}

pub fn w_draw_cap() -> u32 {
    return W_DRAW_CAP;
}

pub fn w_file_cap() -> u32 {
    return W_FILE_CAP;
}

// --- JSON members and elements, walked in one pass -----------------------------------------------------------------------------

/// The member of the object ending at hi that starts at or after p0: sets M_KLO/M_KHI (the key with its quotes) and
/// M_VLO/M_VHI (the value), returns the position after it, or -1 when there is no member there.
fn mem_next(d: []const u8, hi: usize, p0: usize) -> i64 {
    const p : usize = skip_ws(d, p0);
    if (p >= hi or d[p] != 34) { return 0 - 1; }
    const ke : usize = string_end(d, p);
    if (ke > hi) { return 0 - 1; }
    const q : usize = skip_ws(d, ke);
    if (q >= hi or d[q] != 58) { return 0 - 1; }
    const v : usize = skip_ws(d, q + 1);
    const ve : usize = value_end(d, v);
    if (ve > hi) { return 0 - 1; }
    M_KLO = p;
    M_KHI = ke;
    M_VLO = v;
    M_VHI = ve;
    var nx : usize = skip_ws(d, ve);
    if (nx < hi and d[nx] == 44) { nx = skip_ws(d, nx + 1); }
    return nx as i64;
}

/// The element of the array ending at hi that starts at or after p0: sets M_VLO/M_VHI, returns the position after it, or -1.
fn el_next(d: []const u8, hi: usize, p0: usize) -> i64 {
    const p : usize = skip_ws(d, p0);
    if (p + 1 >= hi) { return 0 - 1; }
    const ve : usize = value_end(d, p);
    if (ve > hi) { return 0 - 1; }
    M_VLO = p;
    M_VHI = ve;
    var nx : usize = skip_ws(d, ve);
    if (nx < hi and d[nx] == 44) { nx = skip_ws(d, nx + 1); }
    return nx as i64;
}

/// Is the key span (quotes included) the key, escapes decoded? A plain key is compared byte for byte.
fn key_eq(d: []const u8, lo: usize, hi: usize, key: []const u8) -> bool {
    if (hi < lo + 2) { return false; }
    var plain : bool = true;
    var p : usize = lo + 1;
    while (p + 1 < hi) {
        if (d[p] == 92) { plain = false; }
        p = p + 1;
    }
    if (plain) {
        if (hi - lo - 2 != key.len) { return false; }
        var k : usize = 0;
        while (k < key.len) {
            if (d[lo + 1 + k] != key[k]) { return false; }
            k = k + 1;
        }
        return true;
    }
    return key_is(d, lo, hi, key);
}

/// The value of `key` in the object at sp; the LAST such key, as JSON.parse keeps it. NO_SPAN when absent.
fn obj_last(d: []const u8, sp: i64, key: []const u8) -> i64 {
    if (kind(d, sp) != J_OBJECT) { return NO_SPAN; }
    const hi : usize = span_hi(sp);
    var res : i64 = NO_SPAN;
    var p : usize = span_lo(sp) + 1;
    var go : bool = true;
    while (go) {
        const nx : i64 = mem_next(d, hi, p);
        if (nx < 0) {
            go = false;
        } else {
            if (key_eq(d, M_KLO, M_KHI, key)) { res = jspan(M_VLO, M_VHI); }
            p = nx as usize;
        }
    }
    return res;
}

/// The i-th element of the array at sp (arr_at is quadratic when called in a loop; this is for a few elements).
fn el_at(d: []const u8, sp: i64, i: u32) -> i64 {
    return arr_at(d, sp, i);
}

/// The code point at p of a JSON string body (escapes decoded, UTF-8 read): cp * 16 + the bytes it takes.
fn cp_at(d: []const u8, p: usize, hi: usize) -> u32 {
    const b : u8 = d[p];
    if (b == 92 and p + 1 < hi) {
        const e : u32 = escape_at(d, p + 1, hi);
        return (e / 16) * 16 + 1 + (e % 16);
    }
    if (b < 128) { return (b as u32) * 16 + 1; }
    if (b >= 240 and p + 3 < hi) {
        const c4 : u32 = ((b - 240) as u32) * 262144 + ((d[p + 1] % 64) as u32) * 4096 + ((d[p + 2] % 64) as u32) * 64 + ((d[p + 3] % 64) as u32);
        return c4 * 16 + 4;
    }
    if (b >= 224 and b < 240 and p + 2 < hi) {
        const c3 : u32 = ((b - 224) as u32) * 4096 + ((d[p + 1] % 64) as u32) * 64 + ((d[p + 2] % 64) as u32);
        return c3 * 16 + 3;
    }
    if (b >= 192 and b < 224 and p + 1 < hi) {
        const c2 : u32 = ((b - 192) as u32) * 64 + ((d[p + 1] % 64) as u32);
        return c2 * 16 + 2;
    }
    return (b as u32) * 16 + 1;
}

/// The first UTF-16 unit of a code point.
fn unit_of(cp: u32) -> u32 {
    if (cp < 65536) { return cp; }
    return 55296 + (cp - 65536) / 1024;
}

/// a < b as JavaScript compares two strings (UTF-16 code units, a prefix first): -1, 0 or 1, for the two key spans.
fn key_cmp(d: []const u8, alo: usize, ahi: usize, blo: usize, bhi: usize) -> i32 {
    var pa : usize = alo + 1;
    var pb : usize = blo + 1;
    const ea : usize = ahi - 1;
    const eb : usize = bhi - 1;
    while (true) {
        if (pa >= ea and pb >= eb) { return 0; }
        if (pa >= ea) { return 0 - 1; }
        if (pb >= eb) { return 1; }
        const ca : u32 = cp_at(d, pa, ea);
        const cb : u32 = cp_at(d, pb, eb);
        const xa : u32 = ca / 16;
        const xb : u32 = cb / 16;
        if (xa != xb) {
            const ua : u32 = unit_of(xa);
            const ub : u32 = unit_of(xb);
            if (ua != ub) {
                if (ua < ub) { return 0 - 1; }
                return 1;
            }
            if (xa < xb) { return 0 - 1; }
            return 1;
        }
        pa = pa + ((ca % 16) as usize);
        pb = pb + ((cb % 16) as usize);
    }
    return 0;
}

// --- the demo data file: geometry, source lines, cells ---------------------------------------------------------------------------

/// A JSON number as a double, NaN when the value is no number.
fn jnum(d: []const u8, sp: i64) -> f64 {
    if (kind(d, sp) != J_NUMBER) { return js_nan(0.0); }
    return jv_numval(d, sp);
}

/// The index of the tile family named by the JSON string at sp in K_TILES, -1 when it is none of them.
fn tile_index(d: []const u8, sp: i64) -> i32 {
    var i : usize = 0;
    while (i < K_TILES.len) {
        if (jv_is(d, sp, K_TILES[i])) { return i as i32; }
        i = i + 1;
    }
    return 0 - 1;
}

fn gm_find(d: []const u8, sp: i64) -> i32 {
    var i : u32 = 0;
    while (i < GM_N) {
        const o : usize = GM_NO[i as usize] as usize;
        const l : usize = GM_NL[i as usize] as usize;
        if (str_len(d, sp) == (l as u32)) {
            var k : usize = 0;
            var same : bool = true;
            while (k < l) {
                if (GM_NAME[o + k] != str_byte(d, sp, k as u32)) { same = false; }
                k = k + 1;
            }
            if (same) { return i as i32; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

/// The numbers of the JSON array at sp into GV; the offset, or -1 when something is no number or the pool is full.
fn gv_numbers(d: []const u8, sp: i64) -> i64 {
    if (kind(d, sp) != J_ARRAY) { return 0 - 1; }
    const start : u32 = GV_N;
    const hi : usize = span_hi(sp);
    var p : usize = span_lo(sp) + 1;
    var go : bool = true;
    while (go) {
        const nx : i64 = el_next(d, hi, p);
        if (nx < 0) {
            go = false;
        } else {
            if (GV_N >= W_MAX_VALS) { return 0 - 1; }
            const v : f64 = jnum(d, jspan(M_VLO, M_VHI));
            if (v != v) { return 0 - 1; }
            GV[GV_N as usize] = v;
            GV_N = GV_N + 1;
            p = nx as usize;
        }
    }
    return start as i64;
}

/// geometry of the demo: grid size, the runs of tiles, the site maps of each family.
fn decode_geometry(d: []const u8, geo: i64) -> bool {
    G_W = jnum(d, obj_last(d, geo, "grid_w"));
    G_H = jnum(d, obj_last(d, geo, "grid_h"));
    if (G_W != G_W or G_H != G_H) { return false; }
    const runs : i64 = obj_last(d, geo, "runs");
    if (kind(d, runs) != J_ARRAY) { return false; }
    GR_N = 0;
    var p : usize = span_lo(runs) + 1;
    const hi : usize = span_hi(runs);
    var go : bool = true;
    while (go) {
        const nx : i64 = el_next(d, hi, p);
        if (nx < 0) {
            go = false;
        } else {
            const e : i64 = jspan(M_VLO, M_VHI);
            if (kind(d, e) != J_ARRAY or GR_N >= W_MAX_RUNS) { return false; }
            const gx : f64 = jnum(d, el_at(d, e, 1));
            const top : f64 = jnum(d, el_at(d, e, 2));
            const bot : f64 = jnum(d, el_at(d, e, 3));
            if (gx != gx or top != top or bot != bot) { return false; }
            GR_K[GR_N as usize] = tile_index(d, el_at(d, e, 0));
            GR_GX[GR_N as usize] = gx;
            GR_TOP[GR_N as usize] = top;
            GR_BOT[GR_N as usize] = bot;
            GR_N = GR_N + 1;
            p = nx as usize;
        }
    }
    const maps : i64 = obj_last(d, geo, "maps");
    // geom.maps[fam]: absent or null throws at the first cell; any other value that is no object has no families
    if (kind(d, maps) == J_NONE or kind(d, maps) == J_NULL) { return false; }
    GM_N = 0;
    GM_NAME_N = 0;
    GV_N = 0;
    const mh : usize = span_hi(maps);
    var q : usize = span_lo(maps) + 1;
    go = kind(d, maps) == J_OBJECT;
    while (go) {
        const mx : i64 = mem_next(d, mh, q);
        if (mx < 0) {
            go = false;
        } else {
            const ksp : i64 = jspan(M_KLO, M_KHI);
            const fam : i64 = jspan(M_VLO, M_VHI);
            if (kind(d, fam) != J_OBJECT) { return false; }
            const xs : i64 = gv_numbers(d, obj_last(d, fam, "x"));
            const ys : i64 = gv_numbers(d, obj_last(d, fam, "y"));
            if (xs < 0 or ys < 0) { return false; }
            var slot : i32 = gm_find(d, ksp);
            if (slot < 0) {
                if (GM_N >= 32) { return false; }
                slot = GM_N as i32;
                GM_NO[GM_N as usize] = GM_NAME_N;
                const e2 : u32 = jv_str_to(GM_NAME[0..], GM_NAME_N, d, ksp);
                if (e2 == OVER) { return false; }
                GM_NL[GM_N as usize] = e2 - GM_NAME_N;
                GM_NAME_N = e2;
                GM_N = GM_N + 1;
            }
            const s : usize = slot as usize;
            GM_XO[s] = xs as u32;
            GM_XN[s] = arr_len(d, obj_last(d, fam, "x"));
            GM_YO[s] = ys as u32;
            GM_YN[s] = arr_len(d, obj_last(d, fam, "y"));
            q = mx as usize;
        }
    }
    return true;
}

/// state.label, state.sourceLine, state.commands of the demo (src = demo.source || {}).
fn demo_words(d: []const u8, r: i64) -> bool {
    const src : i64 = obj_last(d, r, "source");
    const top : i64 = obj_last(d, src, "top");
    S_LABEL_N = 0;
    if (jv_truthy(d, top)) {
        const e : u32 = jv_str(S_LABEL[0..], 0, d, top);
        if (e == OVER) { return false; }
        S_LABEL_N = e;
    }
    arg_val(0, d, obj_last(d, src, "design"), true);
    arg_val(1, d, obj_last(d, src, "part"), true);
    arg_val(2, d, obj_last(d, src, "nextpnr"), true);
    const sl : i64 = fmt_into(S_SRC[0..], SAY_SOURCE_DEMO, 3);
    S_SRC_N = 0;
    if (sl >= 0) { S_SRC_N = sl as u32; }
    S_CMDN = 0;
    const cm : i64 = obj_last(d, src, "commands");
    if (jv_truthy(d, cm)) {
        if (kind(d, cm) != J_ARRAY) { return false; }
        var at : u32 = 0;
        var p : usize = span_lo(cm) + 1;
        const hi : usize = span_hi(cm);
        var go : bool = true;
        while (go) {
            const nx : i64 = el_next(d, hi, p);
            if (nx < 0) {
                go = false;
            } else {
                if (S_CMDN >= W_MAX_CMDS) { return false; }
                const sp : i64 = jspan(M_VLO, M_VHI);
                const k : u8 = kind(d, sp);
                S_CMDO[S_CMDN as usize] = at;
                var e : u32 = at;
                if (k != J_NULL and k != J_FALSE) { e = jv_str(S_CMD[0..], at, d, sp); }
                if (e == OVER) { return false; }
                S_CMDL[S_CMDN as usize] = e - at;
                at = e;
                S_CMDN = S_CMDN + 1;
                p = nx as usize;
            }
        }
    }
    return true;
}

/// One cell's three texts into the pool: the String() of the JSON value at sp. Returns false when the pool is full.
fn pool_val(d: []const u8, sp: i64, which: u32, ci: u32) -> bool {
    const e : u32 = jv_str(C_POOL[0..], C_PN, d, sp);
    if (e == OVER) { return false; }
    const o : u32 = C_PN;
    const l : u32 = e - C_PN;
    C_PN = e;
    if (which == 0) { C_NO[ci as usize] = o; C_NL[ci as usize] = l; }
    if (which == 1) { C_TO[ci as usize] = o; C_TL[ci as usize] = l; }
    if (which == 2) { C_BO[ci as usize] = o; C_BL[ci as usize] = l; }
    return true;
}

/// demo.cells into the pool, each [name, type, bel]; false when it is no array of arrays or the pool is full.
fn demo_cells(d: []const u8, cells: i64) -> bool {
    C_N = 0;
    C_PN = 0;
    if (kind(d, cells) != J_ARRAY) { return false; }
    const hi : usize = span_hi(cells);
    var p : usize = span_lo(cells) + 1;
    var go : bool = true;
    while (go) {
        const nx : i64 = el_next(d, hi, p);
        if (nx < 0) {
            go = false;
        } else {
            const e : i64 = jspan(M_VLO, M_VHI);
            if (kind(d, e) != J_ARRAY or C_N >= W_MAX_CELLS) { return false; }
            const a : i64 = arr_at(d, e, 0);
            const b : i64 = arr_at(d, e, 1);
            const c : i64 = arr_at(d, e, 2);
            const ci : u32 = C_N;
            if (!pool_val(d, a, 0, ci) or !pool_val(d, b, 1, ci) or !pool_val(d, c, 2, ci)) { return false; }
            var fl : u8 = 0;
            const ka : u8 = kind(d, a);
            if (ka == J_NONE or ka == J_NULL or ka == J_FALSE) { fl = fl + 1; }
            const kb : u8 = kind(d, b);
            if (kb == J_NONE or kb == J_NULL or kb == J_FALSE) { fl = fl + 2; }
            if (!jv_truthy(d, c)) { fl = fl + 4; }
            C_FL[ci as usize] = fl;
            C_N = C_N + 1;
            p = nx as usize;
        }
    }
    return true;
}

// --- placing a cell on the die ---------------------------------------------------------------------------------------------

fn kind_of_cell(ci: u32) -> i32 {
    const t : []const u8 = C_POOL[(C_TO[ci as usize] as usize)..((C_TO[ci as usize] + C_TL[ci as usize]) as usize)];
    var i : usize = 0;
    while (i < K_TYPE_PREFIX.len and i < 16) {
        if (starts(t, K_TYPE_PREFIX[i])) { return KIND_OF_PFX[i]; }
        i = i + 1;
    }
    return KIND_OTHER;
}

fn type_starts(ci: u32, w: []const u8) -> bool {
    return starts(C_POOL[(C_TO[ci as usize] as usize)..((C_TO[ci as usize] + C_TL[ci as usize]) as usize)], w);
}

/// The length of the site of a cell: its BEL up to the first slash.
fn site_len(ci: u32) -> u32 {
    const o : usize = C_BO[ci as usize] as usize;
    const l : u32 = C_BL[ci as usize];
    var k : u32 = 0;
    while (k < l and C_POOL[o + (k as usize)] != 47) { k = k + 1; }
    return k;
}

fn site_same(a: u32, b: u32) -> bool {
    const la : u32 = site_len(a);
    if (la != site_len(b)) { return false; }
    const oa : usize = C_BO[a as usize] as usize;
    const ob : usize = C_BO[b as usize] as usize;
    var k : usize = 0;
    while (k < (la as usize)) {
        if (C_POOL[oa + k] != C_POOL[ob + k]) { return false; }
        k = k + 1;
    }
    return true;
}

fn fam_is(ci: u32, flen: u32, w: []const u8) -> bool {
    if ((flen as usize) != w.len) { return false; }
    const o : usize = C_BO[ci as usize] as usize;
    var k : usize = 0;
    while (k < w.len) {
        if (C_POOL[o + k] != w[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// place(cell, geom): the rectangle of the cell in grid units, appended to P_*; false when it is off the map.
fn place_cell(ci: u32) -> bool {
    const o : usize = C_BO[ci as usize] as usize;
    const sl : u32 = site_len(ci);
    const bl : u32 = C_BL[ci as usize];
    // ^([A-Z0-9]+)_X(\d+)Y(\d+)$
    var i : u32 = 0;
    while (i < sl and ((C_POOL[o + (i as usize)] >= 65 and C_POOL[o + (i as usize)] <= 90) or is_digit(C_POOL[o + (i as usize)]))) { i = i + 1; }
    const flen : u32 = i;
    if (flen == 0) { return false; }
    if (i + 1 >= sl or C_POOL[o + (i as usize)] != 95 or C_POOL[o + (i as usize) + 1] != 88) { return false; }
    i = i + 2;
    var sx : f64 = 0.0;
    var nd : u32 = 0;
    while (i < sl and is_digit(C_POOL[o + (i as usize)])) {
        sx = sx * 10.0 + ((C_POOL[o + (i as usize)] - 48) as f64);
        i = i + 1;
        nd = nd + 1;
    }
    if (nd == 0) { return false; }
    if (i >= sl or C_POOL[o + (i as usize)] != 89) { return false; }
    i = i + 1;
    var sy : f64 = 0.0;
    nd = 0;
    while (i < sl and is_digit(C_POOL[o + (i as usize)])) {
        sy = sy * 10.0 + ((C_POOL[o + (i as usize)] - 48) as f64);
        i = i + 1;
        nd = nd + 1;
    }
    if (nd == 0 or i != sl) { return false; }
    // FIFO18 is drawn with the RAMB18 map
    var fname : []const u8 = C_POOL[o..(o + (flen as usize))];
    if (fam_is(ci, flen, "FIFO18")) { fname = "RAMB18"; }
    var g : i32 = 0 - 1;
    var m : u32 = 0;
    while (m < GM_N) {
        if (same_text(GM_NAME[(GM_NO[m as usize] as usize)..((GM_NO[m as usize] + GM_NL[m as usize]) as usize)], fname)) { g = m as i32; }
        m = m + 1;
    }
    if (g < 0) { return false; }
    const gi : usize = g as usize;
    if (sx >= (GM_XN[gi] as f64) or sy >= (GM_YN[gi] as f64)) { return false; }
    const gxv : f64 = GV[(GM_XO[gi] as usize) + (sx as usize)];
    const gyv : f64 = GV[(GM_YO[gi] as usize) + (sy as usize)];
    if (gxv < 0.0 or gyv < 0.0) { return false; }
    const n : usize = P_N as usize;
    P_C[n] = ci;
    P_K[n] = kind_of_cell(ci) as u8;
    if (same_text(fname, "SLICE")) {
        var half : f64 = 0.0;
        if (((sx as u64) % 2) == 1) { half = 0.46; }
        var letter : f64 = 0.0;
        if (sl + 1 < bl) {
            const ch : u8 = C_POOL[o + (sl as usize) + 1];
            if (ch >= 65 and ch <= 68) { letter = (ch - 65) as f64; }
        }
        var col : f64 = 0.0;
        if (type_starts(ci, "SLICE_FFX")) { col = 1.0; } else {
            if (type_starts(ci, "CARRY4")) { col = 2.0; }
        }
        var yoff : f64 = letter * 0.25;
        var hh : f64 = 0.25;
        if (type_starts(ci, "CARRY4")) {
            yoff = 0.0;
            hh = 1.0;
        }
        P_X[n] = gxv + half + col * 0.15;
        P_Y[n] = gyv + yoff;
        P_W[n] = 0.14;
        P_H[n] = hh;
        return true;
    }
    P_X[n] = gxv;
    P_Y[n] = gyv;
    P_W[n] = 1.5;
    P_H[n] = 1.5;
    if (same_text(fname, "RAMB36") or same_text(fname, "DSP48")) {
        P_Y[n] = gyv - 4.0;
        P_W[n] = 0.9;
        P_H[n] = 5.0;
        return true;
    }
    if (same_text(fname, "RAMB18")) {
        P_Y[n] = gyv - 2.0;
        P_W[n] = 0.9;
        P_H[n] = 2.5;
        return true;
    }
    if (same_text(fname, "IOB")) {
        P_W[n] = 0.9;
        P_H[n] = 1.0;
        return true;
    }
    return true;
}

/// The hash set of the distinct sites of the slice and carry cells: true when the site of ci is new.
fn site_add(ci: u32) -> bool {
    var h : u64 = 7;
    const o : usize = C_BO[ci as usize] as usize;
    const sl : u32 = site_len(ci);
    var k : usize = 0;
    while (k < (sl as usize)) {
        h = (h * 31 + (C_POOL[o + k] as u64)) % 4294967296;
        k = k + 1;
    }
    var slot : u64 = h % 1048576;
    var tries : u32 = 0;
    while (tries < 1048576) {
        const v : u32 = SITE_H[slot as usize];
        if (v == 0) {
            SITE_H[slot as usize] = ci + 1;
            return true;
        }
        if (site_same(v - 1, ci)) { return false; }
        slot = (slot + 1) % 1048576;
        tries = tries + 1;
    }
    return false;
}

fn is_slice_cell(ci: u32) -> bool {
    return type_starts(ci, "SLICE_") or type_starts(ci, "CARRY4");
}

// --- load(cells, geom) --------------------------------------------------------------------------------------------------------

/// The rest of load() once the cells are in the pool: kinds, placing, the slice count, the box; then renderSide and fit(true).
fn finish_load() -> u32 {
    P_N = 0;
    O_N = 0;
    S_SLICES = 0;
    var q : usize = 0;
    while (q < 16) {
        K_CNT[q] = 0;
        q = q + 1;
    }
    var z : u32 = 0;
    while (z < 1048576) {
        SITE_H[z as usize] = 0;
        z = z + 1;
    }
    var ci : u32 = 0;
    while (ci < C_N) {
        const k : i32 = kind_of_cell(ci);
        if (k >= 0 and k < 16) { K_CNT[k as usize] = K_CNT[k as usize] + 1; }
        if (place_cell(ci)) {
            P_N = P_N + 1;
        } else {
            if (O_N < W_OFF_SHOWN) { O_C[O_N as usize] = ci; }
            O_N = O_N + 1;
        }
        if (is_slice_cell(ci)) {
            if (site_add(ci)) { S_SLICES = S_SLICES + 1; }
        }
        ci = ci + 1;
    }
    // the box around the slices (else around every placed cell)
    var any : bool = false;
    var i : u32 = 0;
    while (i < P_N) {
        if (is_slice_cell(P_C[i as usize])) { any = true; }
        i = i + 1;
    }
    BOX_ON = false;
    var x0 : f64 = js_inf(0.0);
    var y0 : f64 = js_inf(0.0);
    var x1 : f64 = 0.0 - js_inf(0.0);
    var y1 : f64 = 0.0 - js_inf(0.0);
    i = 0;
    while (i < P_N) {
        if (!any or is_slice_cell(P_C[i as usize])) {
            BOX_ON = true;
            x0 = js_min(x0, P_X[i as usize]);
            y0 = js_min(y0, P_Y[i as usize]);
            x1 = js_max(x1, P_X[i as usize] + P_W[i as usize]);
            y1 = js_max(y1, P_Y[i as usize] + P_H[i as usize]);
        }
        i = i + 1;
    }
    if (BOX_ON) {
        BOX_X0 = x0 - 4.0;
        BOX_Y0 = y0 - 4.0;
        BOX_X1 = x1 + 4.0;
        BOX_Y1 = y1 + 4.0;
    }
    S_PICK = 0 - 1;
    S_HOVER = 0 - 1;
    // renderSide(): the summary line
    S_SIDE = true;
    S_INFO = true;
    arg_set(0, S_LABEL[0..], 0, S_LABEL_N as usize);
    arg_loc(1, C_N as f64);
    arg_loc(2, S_SLICES as f64);
    arg_loc(3, K_SLICES as f64);
    status_fmt(SAY_SUMMARY, 4);
    fit(true);
    return 0;
}

/// showDemo(): the demo's words and cells.
fn show_demo() -> u32 {
    if (!S_DEMO) { return 0; }
    const d : []const u8 = D_BUF[0..(D_N as usize)];
    const r : i64 = root(d);
    if (!demo_words(d, r)) {
        status_is(SAY_ERR_DEMO);
        return 0;
    }
    S_DEMO_HIDDEN = true;
    if (!demo_cells(d, obj_last(d, r, "cells"))) {
        // tool.js: the loop over cells throws after placed and offMap were emptied
        P_N = 0;
        O_N = 0;
        status_is(SAY_ERR_DEMO);
        return 0;
    }
    return finish_load();
}

fn data_ready() -> u32 {
    const d : []const u8 = D_BUF[0..(D_N as usize)];
    if (!jv_valid(d)) {
        status_is(SAY_ERR_DEMO);
        return 0;
    }
    const r : i64 = root(d);
    const geo : i64 = obj_last(d, r, "geometry");
    if (kind(d, r) != J_OBJECT or kind(d, geo) != J_OBJECT or !decode_geometry(d, geo)) {
        status_is(SAY_ERR_DEMO);
        return 0;
    }
    S_DEMO = true;
    S_GRID = true;
    show_demo();
    return 0;
}

pub fn w_data(i: u32, s: []const u8) -> u32 {
    if (i > 0) { return 0; }
    if (s.len > 4194304) {
        status_is(SAY_ERR_DEMO);
        return 0;
    }
    var k : usize = 0;
    while (k < s.len) {
        D_BUF[k] = s[k];
        k = k + 1;
    }
    D_N = s.len as u32;
    data_ready();
    return 0;
}

pub fn w_data_failed(i: u32) -> u32 {
    status_is(SAY_ERR_DEMO);
    return 0;
}

// --- a dropped file: the modules, the cells, tool.js's sort -------------------------------------------------------------------

/// The canonical array index a key spells ("0", "17"; not "01" or "4294967295"), else -1.
fn index_key(d: []const u8, klo: usize, khi: usize) -> i64 {
    const e : u32 = jv_str_to(X_SCR[0..], 0, d, jspan(klo, khi));
    if (e == OVER or e == 0 or e > 10) { return 0 - 1; }
    if (e > 1 and X_SCR[0] == 48) { return 0 - 1; }
    var v : i64 = 0;
    var k : u32 = 0;
    while (k < e) {
        const b : u8 = X_SCR[k as usize];
        if (!is_digit(b)) { return 0 - 1; }
        v = v * 10 + ((b - 48) as i64);
        k = k + 1;
    }
    if (v >= 4294967295) { return 0 - 1; }
    return v;
}

/// a goes before b, or they are equal: the order of the cell records (name, then module).
fn ent_le(d: []const u8, a: u32, b: u32) -> bool {
    const c : i32 = key_cmp(d, E_KLO[a as usize] as usize, E_KHI[a as usize] as usize, E_KLO[b as usize] as usize, E_KHI[b as usize] as usize);
    if (c < 0) { return true; }
    if (c > 0) { return false; }
    return E_RK[a as usize] <= E_RK[b as usize];
}

fn merge_pass(d: []const u8, src: []const u32, dst: []u32, n: u32, width: u32) -> u32 {
    var i : u32 = 0;
    while (i < n) {
        var mid : u32 = i + width;
        if (mid > n) { mid = n; }
        var hi : u32 = i + width * 2;
        if (hi > n) { hi = n; }
        var a : u32 = i;
        var b : u32 = mid;
        var o : u32 = i;
        while (a < mid and b < hi) {
            if (ent_le(d, src[a as usize], src[b as usize])) {
                dst[o as usize] = src[a as usize];
                a = a + 1;
            } else {
                dst[o as usize] = src[b as usize];
                b = b + 1;
            }
            o = o + 1;
        }
        while (a < mid) {
            dst[o as usize] = src[a as usize];
            a = a + 1;
            o = o + 1;
        }
        while (b < hi) {
            dst[o as usize] = src[b as usize];
            b = b + 1;
            o = o + 1;
        }
        i = hi;
    }
    return 0;
}

/// Stable merge sort of E_IX[0..n] by ent_le.
fn sort_entries(d: []const u8, n: u32) -> u32 {
    var i : u32 = 0;
    while (i < n) {
        E_IX[i as usize] = i;
        i = i + 1;
    }
    var width : u32 = 1;
    var in_ix : bool = true;
    while (width < n) {
        if (in_ix) { merge_pass(d, E_IX[0..], E_TM[0..], n, width); } else { merge_pass(d, E_TM[0..], E_IX[0..], n, width); }
        in_ix = !in_ix;
        width = width * 2;
    }
    if (!in_ix) {
        i = 0;
        while (i < n) {
            E_IX[i as usize] = E_TM[i as usize];
            i = i + 1;
        }
    }
    return 0;
}

pub var E_NS : u32 = 0;

/// Read the modules of the document: 0 ok (the cells with a BEL in E_TM[0..E_NS], in order), 1 not JSON, 2 no placed cells,
/// 3 too big for the tables.
fn scan_file(d: []const u8) -> u32 {
    if (!jv_valid(d)) { return 1; }
    const r : i64 = root(d);
    E_N = 0;
    E_NS = 0;
    if (kind(d, r) != J_OBJECT) { return 2; }
    const mods : i64 = obj_last(d, r, "modules");
    if (!jv_truthy(d, mods) or kind(d, mods) != J_OBJECT) { return 2; }
    // the modules: a repeated key keeps its first place and its last value
    MD_N = 0;
    var p : usize = span_lo(mods) + 1;
    const mhi : usize = span_hi(mods);
    var go : bool = true;
    while (go) {
        const nx : i64 = mem_next(d, mhi, p);
        if (nx < 0) {
            go = false;
        } else {
            const klo : usize = M_KLO;
            const khi : usize = M_KHI;
            const vlo : usize = M_VLO;
            const vhi : usize = M_VHI;
            var found : i32 = 0 - 1;
            var j : u32 = 0;
            while (j < MD_N) {
                if (key_cmp(d, klo, khi, MD_KLO[j as usize] as usize, MD_KHI[j as usize] as usize) == 0) { found = j as i32; }
                j = j + 1;
            }
            if (found >= 0) {
                MD_VLO[found as usize] = vlo as u32;
                MD_VHI[found as usize] = vhi as u32;
            } else {
                if (MD_N >= W_MAX_MODS) { return 3; }
                MD_KLO[MD_N as usize] = klo as u32;
                MD_KHI[MD_N as usize] = khi as u32;
                MD_VLO[MD_N as usize] = vlo as u32;
                MD_VHI[MD_N as usize] = vhi as u32;
                MD_NUM[MD_N as usize] = index_key(d, klo, khi);
                MD_N = MD_N + 1;
            }
            p = nx as usize;
        }
    }
    // Object.values order: integer keys ascending, then the others as they came
    var nnum : u32 = 0;
    var m : u32 = 0;
    while (m < MD_N) {
        if (MD_NUM[m as usize] >= 0) { nnum = nnum + 1; }
        m = m + 1;
    }
    m = 0;
    while (m < MD_N) {
        var rk : u32 = 0;
        var j2 : u32 = 0;
        if (MD_NUM[m as usize] >= 0) {
            while (j2 < MD_N) {
                if (MD_NUM[j2 as usize] >= 0 and MD_NUM[j2 as usize] < MD_NUM[m as usize]) { rk = rk + 1; }
                j2 = j2 + 1;
            }
        } else {
            rk = nnum;
            while (j2 < m) {
                if (MD_NUM[j2 as usize] < 0) { rk = rk + 1; }
                j2 = j2 + 1;
            }
        }
        MD_RK[m as usize] = rk;
        m = m + 1;
    }
    // the cells of every module: one record per entry
    m = 0;
    while (m < MD_N) {
        const cells : i64 = obj_last(d, jspan(MD_VLO[m as usize] as usize, MD_VHI[m as usize] as usize), "cells");
        if (jv_truthy(d, cells) and kind(d, cells) == J_OBJECT) {
            var cp : usize = span_lo(cells) + 1;
            const chi : usize = span_hi(cells);
            var cgo : bool = true;
            while (cgo) {
                const cn : i64 = mem_next(d, chi, cp);
                if (cn < 0) {
                    cgo = false;
                } else {
                    if (E_N >= W_MAX_CELLS) { return 3; }
                    const e : usize = E_N as usize;
                    E_KLO[e] = M_KLO as u32;
                    E_KHI[e] = M_KHI as u32;
                    E_RK[e] = MD_RK[m as usize];
                    E_BSP[e] = NO_SPAN;
                    E_TSP[e] = NO_SPAN;
                    const c : i64 = jspan(M_VLO, M_VHI);
                    if (kind(d, c) == J_OBJECT) {
                        const attrs : i64 = obj_last(d, c, "attributes");
                        if (kind(d, attrs) == J_OBJECT) {
                            const b : i64 = obj_last(d, attrs, "NEXTPNR_BEL");
                            if (jv_truthy(d, b)) {
                                E_BSP[e] = b;
                                E_TSP[e] = obj_last(d, c, "type");
                            }
                        }
                    }
                    E_N = E_N + 1;
                    cp = cn as usize;
                }
            }
        }
        m = m + 1;
    }
    sort_entries(d, E_N);
    // a repeated cell name of one module keeps its last entry; only the entries with a BEL are cells
    var i : u32 = 0;
    var total : u32 = 0;
    while (i < E_N) {
        var last : bool = true;
        const a : u32 = E_IX[i as usize];
        if (i + 1 < E_N) {
            const b2 : u32 = E_IX[(i + 1) as usize];
            if (E_RK[a as usize] == E_RK[b2 as usize] and key_cmp(d, E_KLO[a as usize] as usize, E_KHI[a as usize] as usize, E_KLO[b2 as usize] as usize, E_KHI[b2 as usize] as usize) == 0) { last = false; }
        }
        if (last and E_BSP[a as usize] >= 0) {
            E_TM[E_NS as usize] = a;
            E_NS = E_NS + 1;
            // will it fit the pool? (the three texts, decoded)
            const nl : u32 = str_len(d, jspan(E_KLO[a as usize] as usize, E_KHI[a as usize] as usize));
            const e1 : u32 = jv_str(X_SCR[0..], 0, d, E_TSP[a as usize]);
            const e2 : u32 = jv_str(X_SCR[0..], 0, d, E_BSP[a as usize]);
            if (e1 == OVER or e2 == OVER) { return 3; }
            if (total + nl + e1 + e2 > 33554432) { return 3; }
            total = total + nl + e1 + e2;
        }
        i = i + 1;
    }
    if (E_NS == 0) { return 2; }
    return 0;
}

/// The surviving records into the cell pool: name (the key), String(type), String(BEL).
fn commit_cells(d: []const u8) -> u32 {
    C_PN = 0;
    C_N = E_NS;
    var i : u32 = 0;
    while (i < E_NS) {
        const a : u32 = E_TM[i as usize];
        C_NO[i as usize] = C_PN;
        C_PN = jv_str_to(C_POOL[0..], C_PN, d, jspan(E_KLO[a as usize] as usize, E_KHI[a as usize] as usize));
        C_NL[i as usize] = C_PN - C_NO[i as usize];
        C_TO[i as usize] = C_PN;
        C_PN = jv_str(C_POOL[0..], C_PN, d, E_TSP[a as usize]);
        C_TL[i as usize] = C_PN - C_TO[i as usize];
        C_BO[i as usize] = C_PN;
        C_PN = jv_str(C_POOL[0..], C_PN, d, E_BSP[a as usize]);
        C_BL[i as usize] = C_PN - C_BO[i as usize];
        C_FL[i as usize] = 0;
        i = i + 1;
    }
    return 0;
}

/// takeFile(file): name, size in bytes, the file's text as the host decoded it, st != 0 when it could not be read.
pub fn w_file(name: []const u8, size: f64, data: []const u8, st: u32) -> u32 {
    S_CLR_FILE = true;
    if (!S_GRID) { return 0; }
    arg_text(0, name);
    if (size > (K_MAX_FILE_MB as f64) * 1048576.0) {
        arg_num(1, K_MAX_FILE_MB as f64);
        status_fmt(SAY_ERR_SIZE, 2);
        return 0;
    }
    if (size > (W_FILE_CAP as f64)) {
        arg_num(1, W_FILE_CAP_MB as f64);
        status_fmt(SAY_ERR_SIZE, 2);
        return 0;
    }
    if (st != 0) {
        status_fmt(SAY_ERR_JSON, 1);
        return 0;
    }
    const rc : u32 = scan_file(data);
    if (rc == 1) {
        status_fmt(SAY_ERR_JSON, 1);
        return 0;
    }
    if (rc == 2) {
        status_fmt(SAY_ERR_NO_BELS, 1);
        return 0;
    }
    if (rc == 3) {
        arg_num(1, W_FILE_CAP_MB as f64);
        status_fmt(SAY_ERR_SIZE, 2);
        return 0;
    }
    commit_cells(data);
    S_LABEL_N = copy_into(S_LABEL[0..], 0, name);
    arg_loc(1, size);
    const cr : i64 = obj_last(data, root(data), "creator");
    if (jv_truthy(data, cr)) { arg_val(2, data, cr, false); } else { arg_set(2, name, 0, 0); }
    const sl : i64 = fmt_into(S_SRC[0..], SAY_SOURCE_FILE, 3);
    S_SRC_N = 0;
    if (sl >= 0) { S_SRC_N = sl as u32; }
    S_CMDN = 0;
    S_DEMO_HIDDEN = false;
    return finish_load();
}

pub fn w_value(i: u32, dst: []u8) -> u32 {
    if (i == 0 and S_CLR_FILE) {
        S_CLR_FILE = false;
        return 0;
    }
    return 4294967295;
}

pub fn w_drag(kind_of: u32) -> u32 {
    const was : bool = S_OVER;
    S_OVER = kind_of == 0;
    if (was != S_OVER) { return 1; }
    return 0;
}

// --- the canvas: size, fit, zoom --------------------------------------------------------------------------------------------------

/// size(): the canvas gets the width of its box and a height that fits the window.
fn size_canvas() -> u32 {
    var bw : f64 = ENV_BW;
    if (bw == 0.0 or bw != bw) { bw = 600.0; }
    S_CSSW = bw;
    const aspect : f64 = G_H / G_W;
    var maxh : f64 = 0.0;
    if (ENV_EMBED != 0) {
        maxh = js_max(200.0, ENV_IH - 205.0);
    } else {
        maxh = js_max(260.0, ENV_IH * 0.7);
    }
    S_CSSH = js_round(js_min(S_CSSW * aspect, maxh));
    var dpr : f64 = ENV_DPR;
    if (dpr == 0.0 or dpr != dpr) { dpr = 1.0; }
    S_CANVAS_W = to_uint32(js_round(S_CSSW * dpr));
    S_CANVAS_H = to_uint32(js_round(S_CSSH * dpr));
    S_SIZED = true;
    return 0;
}

/// fit(design)
fn fit(design: bool) -> u32 {
    if (!S_GRID) { return 0; }
    size_canvas();
    var x0 : f64 = 0.0;
    var y0 : f64 = 0.0;
    var x1 : f64 = G_W;
    var y1 : f64 = G_H;
    if (design and BOX_ON) {
        x0 = BOX_X0;
        y0 = BOX_Y0;
        x1 = BOX_X1;
        y1 = BOX_Y1;
    }
    const s : f64 = js_min(S_CSSW / (x1 - x0), S_CSSH / (y1 - y0));
    S_VS = s;
    S_VX = (x0 + x1) / 2.0 - S_CSSW / s / 2.0;
    S_VY = (y0 + y1) / 2.0 - S_CSSH / s / 2.0;
    return 0;
}

/// zoomAt(px, py, factor)
fn zoom_at(px: f64, py: f64, factor: f64) -> u32 {
    if (!S_GRID) { return 0; }
    const x : f64 = S_VX;
    const y : f64 = S_VY;
    const s : f64 = S_VS;
    const mins : f64 = js_min(S_CSSW / G_W, S_CSSH / G_H) * 0.8;
    const ns : f64 = js_min(js_max(s * factor, mins), mins * (K_MAX_ZOOM as f64) * 4.0);
    const gx : f64 = x + px / s;
    const gy : f64 = y + py / s;
    S_VS = ns;
    S_VX = gx - px / ns;
    S_VY = gy - py / ns;
    return 0;
}

/// nearest(px, py): the placed cell within K_PICK_PX, the smaller one when several are under the point; -1 for none.
fn nearest(px: f64, py: f64) -> i32 {
    const x : f64 = S_VX;
    const y : f64 = S_VY;
    const s : f64 = S_VS;
    var best : i32 = 0 - 1;
    var bd : f64 = K_PICK_PX as f64;
    var i : u32 = 0;
    while (i < P_N) {
        const k : usize = i as usize;
        const cx : f64 = (P_X[k] + P_W[k] / 2.0 - x) * s;
        const cy : f64 = (P_Y[k] + P_H[k] / 2.0 - y) * s;
        const ddx : f64 = js_max(0.0, abs_f(px - cx) - P_W[k] * s / 2.0);
        const ddy : f64 = js_max(0.0, abs_f(py - cy) - P_H[k] * s / 2.0);
        const dd : f64 = hypot2(ddx, ddy);
        var take : bool = dd < bd;
        if (!take and dd == 0.0 and best >= 0) {
            if (P_W[k] * P_H[k] < P_W[best as usize] * P_H[best as usize]) { take = true; }
        }
        if (take) {
            bd = dd;
            best = i as i32;
        }
        i = i + 1;
    }
    return best;
}

fn pt_find(id: i64) -> i32 {
    var i : u32 = 0;
    while (i < PT_N) {
        if (PT_ID[i as usize] == id) { return i as i32; }
        i = i + 1;
    }
    return 0 - 1;
}

fn pt_remove(id: i64) -> u32 {
    const f : i32 = pt_find(id);
    if (f < 0) { return 0; }
    var i : u32 = f as u32;
    while (i + 1 < PT_N) {
        PT_ID[i as usize] = PT_ID[(i + 1) as usize];
        PT_X[i as usize] = PT_X[(i + 1) as usize];
        PT_Y[i as usize] = PT_Y[(i + 1) as usize];
        i = i + 1;
    }
    PT_N = PT_N - 1;
    return 0;
}

/// A pointer on the canvas. kind 0 down, 1 move, 2 up, 3 cancel, 4 leave; x, y in the canvas's box.
pub fn w_cpointer(kind_of: u32, id: i64, x: f64, y: f64, mouse: u32) -> u32 {
    if (kind_of == 0) {
        const f : i32 = pt_find(id);
        if (f >= 0) {
            PT_X[f as usize] = x;
            PT_Y[f as usize] = y;
        } else {
            if (PT_N < 8) {
                PT_ID[PT_N as usize] = id;
                PT_X[PT_N as usize] = x;
                PT_Y[PT_N as usize] = y;
                PT_N = PT_N + 1;
            }
        }
        if (PT_N == 1) {
            DR_ON = true;
            DR_SX = x;
            DR_SY = y;
            DR_VX = S_VX;
            DR_VY = S_VY;
            DR_VS = S_VS;
            DR_MOVED = false;
        }
        if (PT_N == 2) {
            PI_ON = true;
            PI_D = hypot2(PT_X[0] - PT_X[1], PT_Y[0] - PT_Y[1]);
            PI_S = S_VS;
            DR_ON = false;
        }
        return 0;
    }
    if (kind_of == 1) {
        const f2 : i32 = pt_find(id);
        if (f2 >= 0) {
            PT_X[f2 as usize] = x;
            PT_Y[f2 as usize] = y;
        }
        if (PI_ON and PT_N == 2) {
            const mx : f64 = (PT_X[0] + PT_X[1]) / 2.0;
            const my : f64 = (PT_Y[0] + PT_Y[1]) / 2.0;
            zoom_at(mx, my, (PI_S * hypot2(PT_X[0] - PT_X[1], PT_Y[0] - PT_Y[1]) / PI_D) / S_VS);
            return 0;
        }
        if (DR_ON) {
            const dx : f64 = x - DR_SX;
            const dy : f64 = y - DR_SY;
            if (abs_f(dx) + abs_f(dy) > 4.0) { DR_MOVED = true; }
            if (DR_MOVED) {
                S_VS = DR_VS;
                S_VX = DR_VX - dx / DR_VS;
                S_VY = DR_VY - dy / DR_VS;
            }
            return 0;
        }
        if (mouse != 0) {
            const p : i32 = nearest(x, y);
            if (p != S_HOVER) {
                S_HOVER = p;
                S_INFO = true;
            }
        }
        return 0;
    }
    if (kind_of == 2) {
        if (DR_ON and !DR_MOVED) {
            S_PICK = nearest(x, y);
            S_INFO = true;
        }
        pt_remove(id);
        if (PT_N < 2) { PI_ON = false; }
        if (PT_N == 0) { DR_ON = false; }
        return 0;
    }
    if (kind_of == 3) {
        pt_remove(id);
        PI_ON = false;
        DR_ON = false;
        return 0;
    }
    if (S_HOVER >= 0) {
        S_HOVER = 0 - 1;
        S_INFO = true;
    }
    return 0;
}

/// The wheel over the canvas: zoomAt(x, y, Math.exp(-deltaY * (ctrl ? 0.01 : 0.0025))). 2: a libm call is missing.
pub fn w_wheel(x: f64, y: f64, dy: f64, ctrl: u32) -> u32 {
    MISSING = false;
    var k : f64 = 0.0025;
    if (ctrl != 0) { k = 0.01; }
    const arg : f64 = (0.0 - dy) * k;
    const f : f64 = libm(16, arg);
    if (MISSING) { return 2; }
    zoom_at(x, y, f);
    return 1;
}

pub fn w_key(key: []const u8) -> u32 {
    const step : f64 = 40.0 / S_VS;
    if (key.len == 1 and (key[0] == 43 or key[0] == 61)) {
        zoom_at(S_CSSW / 2.0, S_CSSH / 2.0, 1.4);
        return 1;
    }
    if (key.len == 1 and key[0] == 45) {
        zoom_at(S_CSSW / 2.0, S_CSSH / 2.0, 1.0 / 1.4);
        return 1;
    }
    if (same_text(key, "ArrowLeft")) {
        S_VX = S_VX - step;
        return 1;
    }
    if (same_text(key, "ArrowRight")) {
        S_VX = S_VX + step;
        return 1;
    }
    if (same_text(key, "ArrowUp")) {
        S_VY = S_VY - step;
        return 1;
    }
    if (same_text(key, "ArrowDown")) {
        S_VY = S_VY + step;
        return 1;
    }
    return 0;
}

/// The ResizeObserver of the box around the canvas: 1 when the drawing changed.
pub fn w_box(w: f64, h: f64) -> u32 {
    if (!S_GRID or w == S_LASTW) { return 0; }
    const ow : f64 = S_CSSW;
    const oh : f64 = S_CSSH;
    const ovx : f64 = S_VX;
    const ovy : f64 = S_VY;
    const ovs : f64 = S_VS;
    S_LASTW = w;
    size_canvas();
    if (ow != 0.0 and ow == ow) {
        const cx : f64 = ovx + ow / ovs / 2.0;
        const cy : f64 = ovy + oh / ovs / 2.0;
        const s : f64 = ovs * S_CSSW / ow;
        S_VS = s;
        S_VX = cx - S_CSSW / s / 2.0;
        S_VY = cy - S_CSSH / s / 2.0;
    }
    return 1;
}

pub fn w_click(i: u32) -> u32 {
    if (i == 0) { fit(false); }
    if (i == 1) { fit(true); }
    if (i == 2) { show_demo(); }
    return 0;
}

// --- the libm service ----------------------------------------------------------------------------------------------------------------

fn libm(op: u32, a: f64) -> f64 {
    var i : u32 = 0;
    while (i < LB_N) {
        if ((LB_OP[i as usize] as u32) == op and LB_A[i as usize] == a) { return LB_R[i as usize]; }
        i = i + 1;
    }
    MISSING = true;
    var j : u32 = 0;
    while (j < RQ_N) {
        if ((RQ_OP[j as usize] as u32) == op and RQ_A[j as usize] == a) { return 0.0; }
        j = j + 1;
    }
    if (RQ_N < 64) {
        RQ_OP[RQ_N as usize] = op as u8;
        RQ_A[RQ_N as usize] = a;
        RQ_N = RQ_N + 1;
    }
    return 0.0;
}

pub fn w_libm_need(dst: []f64) -> u32 {
    if (RQ_N == 0) { return 0; }
    var k : u32 = 0;
    while (k < RQ_N and ((k * 3 + 2) as usize) < dst.len) {
        dst[(k * 3) as usize] = RQ_OP[k as usize] as f64;
        dst[(k * 3 + 1) as usize] = RQ_A[k as usize];
        dst[(k * 3 + 2) as usize] = 0.0;
        k = k + 1;
    }
    RQ_SENT = k;
    return k;
}

pub fn w_libm_give(src: []const f64, n: u32) -> u32 {
    var k : u32 = 0;
    while (k < n and k < RQ_SENT and (k as usize) < src.len) {
        if (LB_N >= 64) { LB_N = 0; }
        LB_OP[LB_N as usize] = RQ_OP[k as usize];
        LB_A[LB_N as usize] = RQ_A[k as usize];
        LB_R[LB_N as usize] = src[k as usize];
        LB_N = LB_N + 1;
        k = k + 1;
    }
    RQ_N = 0;
    RQ_SENT = 0;
    MISSING = false;
    return 0;
}

// --- the page: HTML as tool.js builds it ------------------------------------------------------------------------------------------------

fn put_say(dst: []u8, n0: u32, tpl: []const u8, nargs: u32) -> u32 {
    const l : i64 = fmt_into(S_FB[0..], tpl, nargs);
    if (l < 0) { return OVER; }
    return text(dst, n0, S_FB[0..(l as usize)]);
}

fn put_locale(dst: []u8, n0: u32, x: f64) -> u32 {
    return js_locale_num(dst, n0, x);
}

/// Text from the data as the page shows it: escaped like text(), and a carriage return as a character reference, which an HTML
/// parser keeps (a raw one it turns into a line feed, tool.js keeps the carriage return).
fn etext(dst: []u8, n0: u32, s: []const u8) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    while (i < s.len) {
        if (s[i] == 13) { n = raw(dst, n, "&#13;"); } else { n = put_escaped(dst, n, s[i]); }
        i = i + 1;
    }
    return n;
}

fn pool_text(dst: []u8, n0: u32, o: u32, l: u32) -> u32 {
    return etext(dst, n0, C_POOL[(o as usize)..((o + l) as usize)]);
}

/// <i style="background:COLOR"></i> as h('i', { style: `background:${KIND_COLOR[kind]}` }) writes it
fn put_swatch(dst: []u8, n0: u32, k: u32) -> u32 {
    var n : u32 = raw(dst, n0, "<i style=\"background:");
    if ((k as usize) < K_KIND_COLORS.len) { n = text(dst, n, K_KIND_COLORS[k as usize]); } else { n = text(dst, n, W_KIND_DEFAULT); }
    return raw(dst, n, "\"></i>");
}

fn put_legend(dst: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    while (i < K_KINDS.len and i < 16) {
        if (K_CNT[i] > 0) {
            n = raw(dst, n, "<li>");
            n = put_swatch(dst, n, i as u32);
            n = text(dst, n, K_KINDS[i]);
            n = raw(dst, n, " ");
            n = put_locale(dst, n, K_CNT[i] as f64);
            n = raw(dst, n, "</li>");
        }
        i = i + 1;
    }
    return n;
}

/// renderInfo(): the pick, else the hover, as a table of the cells that share its site.
fn put_info(dst: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    var pi : i32 = S_PICK;
    if (pi < 0) { pi = S_HOVER; }
    if (pi < 0) {
        n = raw(dst, n, "<p class=\"pm-muted\">");
        n = text(dst, n, SAY_PICK_NONE);
        return raw(dst, n, "</p>");
    }
    const ci : u32 = P_C[pi as usize];
    var same : u32 = 0;
    var q : u32 = 0;
    while (q < P_N) {
        if (site_same(P_C[q as usize], ci)) { same = same + 1; }
        q = q + 1;
    }
    arg_num(0, same as f64);
    n = raw(dst, n, "<p class=\"pm-muted\">");
    n = put_say(dst, n, SAY_PICK_LINE, 1);
    n = raw(dst, n, "</p><table><thead><tr>");
    var f : usize = 0;
    while (f < SAY_FIELDS.len) {
        n = raw(dst, n, "<th>");
        n = text(dst, n, SAY_FIELDS[f]);
        n = raw(dst, n, "</th>");
        f = f + 1;
    }
    n = raw(dst, n, "</tr></thead><tbody>");
    var shown : u32 = 0;
    q = 0;
    while (q < P_N and shown < W_ROWS_SHOWN) {
        const cj : u32 = P_C[q as usize];
        if (site_same(cj, ci)) {
            shown = shown + 1;
            n = raw(dst, n, "<tr class=\"");
            if ((q as i32) == pi) { n = raw(dst, n, "is-pick"); }
            n = raw(dst, n, "\"><td>");
            n = put_swatch(dst, n, P_K[q as usize] as u32);
            if ((C_FL[cj as usize] % 2) == 0) { n = pool_text(dst, n, C_NO[cj as usize], C_NL[cj as usize]); }
            n = raw(dst, n, "</td><td>");
            if (((C_FL[cj as usize] / 2) % 2) == 0) { n = pool_text(dst, n, C_TO[cj as usize], C_TL[cj as usize]); }
            n = raw(dst, n, "</td><td>");
            n = pool_text(dst, n, C_BO[cj as usize], C_BL[cj as usize]);
            n = raw(dst, n, "</td></tr>");
        }
        q = q + 1;
    }
    return raw(dst, n, "</tbody></table>");
}

fn put_details(dst: []u8, n0: u32) -> u32 {
    var n : u32 = raw(dst, n0, "<details class=\"pm-off\"");
    if (!S_SIDE) {
        n = raw(dst, n, "></details>");
    } else {
        if (O_N == 0) { n = raw(dst, n, " hidden=\"\""); }
        n = raw(dst, n, "><summary>");
        arg_loc(0, O_N as f64);
        n = put_say(dst, n, SAY_OFF_MAP, 1);
        n = raw(dst, n, "</summary><ul>");
        var j : u32 = 0;
        while (j < O_N and j < W_OFF_SHOWN) {
            const cj : u32 = O_C[j as usize];
            n = raw(dst, n, "<li>");
            n = pool_text(dst, n, C_NO[cj as usize], C_NL[cj as usize]);
            n = raw(dst, n, "  ");
            n = pool_text(dst, n, C_TO[cj as usize], C_TL[cj as usize]);
            n = raw(dst, n, "  ");
            if (((C_FL[cj as usize] / 4) % 2) == 1) { n = text(dst, n, W_DASH); } else { n = pool_text(dst, n, C_BO[cj as usize], C_BL[cj as usize]); }
            n = raw(dst, n, "</li>");
            j = j + 1;
        }
        n = raw(dst, n, "</ul></details>");
    }
    n = raw(dst, n, "<details class=\"pm-how\"");
    if (!S_SIDE) {
        n = raw(dst, n, "></details>");
    } else {
        if (S_CMDN == 0) { n = raw(dst, n, " hidden=\"\""); }
        n = raw(dst, n, "><summary>");
        n = text(dst, n, SAY_COMMANDS);
        n = raw(dst, n, "</summary><p>");
        n = etext(dst, n, S_SRC[0..(S_SRC_N as usize)]);
        n = raw(dst, n, "</p><ul>");
        var c : u32 = 0;
        while (c < S_CMDN) {
            n = raw(dst, n, "<li><code>");
            n = etext(dst, n, S_CMD[(S_CMDO[c as usize] as usize)..((S_CMDO[c as usize] + S_CMDL[c as usize]) as usize)]);
            n = raw(dst, n, "</code></li>");
            c = c + 1;
        }
        n = raw(dst, n, "</ul></details>");
    }
    return n;
}

fn button(dst: []u8, n0: u32, label: []const u8) -> u32 {
    var n : u32 = raw(dst, n0, "<button class=\"t27-btn\" type=\"button\">");
    n = text(dst, n, label);
    return raw(dst, n, "</button>");
}

/// A CSS length in px as the style serialisation writes it: 273px, 12.5px.
fn put_css_px(dst: []u8, n0: u32, x: f64) -> u32 {
    const e : u32 = js_str_num(S_NUM3[0..], 0, x);
    var n : u32 = raw(dst, n0, S_NUM3[0..(e as usize)]);
    return raw(dst, n, "px");
}

pub fn w_render(dst: []u8) -> u32 {
    var n : u32 = raw(dst, 0, "<div class=\"pm-bar\">");
    n = button(dst, n, SAY_WHOLE_DIE);
    n = button(dst, n, SAY_FIT_DESIGN);
    n = raw(dst, n, "<button class=\"t27-btn\" type=\"button\"");
    if (S_DEMO_HIDDEN) { n = raw(dst, n, " hidden=\"\""); }
    n = raw(dst, n, ">");
    n = text(dst, n, SAY_DEMO);
    n = raw(dst, n, "</button></div><p class=\"pm-status\" role=\"status\">");
    n = etext(dst, n, S_STATUS[0..(S_STATUS_N as usize)]);
    n = raw(dst, n, "</p><div class=\"pm-wrap\"><canvas class=\"pm-canvas\" role=\"img\" tabindex=\"0\" aria-label=\"");
    n = text(dst, n, SAY_CANVAS_LABEL);
    n = raw(dst, n, "\"");
    if (S_SIZED) {
        n = raw(dst, n, " width=\"");
        n = num(dst, n, S_CANVAS_W);
        n = raw(dst, n, "\" height=\"");
        n = num(dst, n, S_CANVAS_H);
        n = raw(dst, n, "\" style=\"height: ");
        n = put_css_px(dst, n, S_CSSH);
        n = raw(dst, n, ";\"");
    }
    n = raw(dst, n, "></canvas></div><p class=\"pm-hint\">");
    n = text(dst, n, SAY_HINT);
    n = raw(dst, n, "</p><div class=\"pm-side\"><ul class=\"pm-legend\">");
    if (S_SIDE) { n = put_legend(dst, n); }
    n = raw(dst, n, "</ul><div class=\"pm-info\" aria-live=\"polite\">");
    if (S_INFO) { n = put_info(dst, n); }
    n = raw(dst, n, "</div></div><label class=\"t27-drop pm-drop");
    if (S_OVER) { n = raw(dst, n, " is-over"); }
    n = raw(dst, n, "\"><input type=\"file\" accept=\"");
    n = text(dst, n, W_ACCEPT);
    n = raw(dst, n, "\" class=\"pm-file\"><span>");
    n = text(dst, n, SAY_DROP);
    n = raw(dst, n, "</span></label>");
    n = put_details(dst, n);
    if (!ok(n)) { return 0; }
    return n;
}

// --- the binary draw list (op byte, then f64 little endian / u16-length strings; 200 picks canvas i) ----------------------------------------

fn bw_b(o: []u8, n: u32, b: u8) -> u32 {
    if (n == OVER or (n as usize) >= o.len) { return OVER; }
    o[n as usize] = b;
    return n + 1;
}

/// The IEEE 754 bits of a finite double (no subnormals, no NaN).
fn f64_bits(x: f64) -> u64 {
    if (x == 0.0) {
        if ((1.0 / x) < 0.0) { return 9223372036854775808; }
        return 0;
    }
    var sign : u64 = 0;
    var ax : f64 = x;
    if (x < 0.0) {
        sign = 9223372036854775808;
        ax = 0.0 - x;
    }
    if (x != x) { return 9221120237041090560; }
    if (ax - ax != 0.0) { return sign + 9218868437227405312; }
    const m : u64 = jn_mant(ax);
    const e : i32 = jn_expo(ax);
    const be : u64 = ((e + 52 + 1023) as u64);
    return sign + be * 4503599627370496 + (m - 4503599627370496);
}

fn bw_f(o: []u8, n0: u32, x: f64) -> u32 {
    var bits : u64 = f64_bits(x);
    var n : u32 = n0;
    var k : u32 = 0;
    while (k < 8) {
        n = bw_b(o, n, (bits % 256) as u8);
        bits = bits / 256;
        k = k + 1;
    }
    return n;
}

fn bw_s(o: []u8, n0: u32, s: []const u8) -> u32 {
    var n : u32 = bw_b(o, n0, (s.len % 256) as u8);
    n = bw_b(o, n, ((s.len / 256) % 256) as u8);
    var k : usize = 0;
    while (k < s.len) {
        n = bw_b(o, n, s[k]);
        k = k + 1;
    }
    return n;
}

fn bw_rect(o: []u8, n0: u32, op: u8, a: f64, b: f64, c: f64, d: f64) -> u32 {
    var n : u32 = bw_b(o, n0, op);
    n = bw_f(o, n, a);
    n = bw_f(o, n, b);
    n = bw_f(o, n, c);
    return bw_f(o, n, d);
}

fn bw_set_s(o: []u8, n0: u32, op: u8, s: []const u8) -> u32 {
    const n : u32 = bw_b(o, n0, op);
    return bw_s(o, n, s);
}

fn kind_color(k: u32) -> []const u8 {
    if ((k as usize) < K_KIND_COLORS.len) { return K_KIND_COLORS[k as usize]; }
    return W_KIND_DEFAULT;
}

/// The ring around the hovered or picked cell.
fn bw_ring(o: []u8, n0: u32, pi: i32, col: []const u8, s: f64, vx: f64, vy: f64) -> u32 {
    const k : usize = pi as usize;
    var n : u32 = bw_set_s(o, n0, 33, col);
    n = bw_b(o, n, 34);
    n = bw_f(o, n, 2.0);
    const w : f64 = js_max(8.0, P_W[k] * s);
    const hh : f64 = js_max(8.0, P_H[k] * s);
    const x : f64 = (P_X[k] - vx) * s;
    const y : f64 = (P_Y[k] - vy) * s;
    return bw_rect(o, n, 11, x + P_W[k] * s / 2.0 - w / 2.0 - 2.0, y + P_H[k] * s / 2.0 - hh / 2.0 - 2.0, w + 4.0, hh + 4.0);
}

/// draw(): the die floor, the placed cells, the rings.
pub fn w_bdraw(o: []u8) -> u32 {
    if (!S_GRID or !S_SIZED) { return 0; }
    var n : u32 = bw_b(o, 0, 200);
    n = bw_b(o, n, 0);
    var dpr : f64 = ENV_DPR;
    if (dpr == 0.0 or dpr != dpr) { dpr = 1.0; }
    n = bw_b(o, n, 12);
    n = bw_f(o, n, dpr);
    n = bw_f(o, n, 0.0);
    n = bw_f(o, n, 0.0);
    n = bw_f(o, n, dpr);
    n = bw_f(o, n, 0.0);
    n = bw_f(o, n, 0.0);
    n = bw_set_s(o, n, 32, W_BLACK);
    n = bw_rect(o, n, 10, 0.0, 0.0, S_CSSW, S_CSSH);
    const vx : f64 = S_VX;
    const vy : f64 = S_VY;
    const s : f64 = S_VS;
    var r : u32 = 0;
    while (r < GR_N) {
        const x : f64 = (GR_GX[r as usize] - vx) * s;
        if (!(x > S_CSSW) and !(x + s < 0.0)) {
            const t : i32 = GR_K[r as usize];
            if (t >= 0 and (t as usize) < K_TILE_COLORS.len) { n = bw_set_s(o, n, 32, K_TILE_COLORS[t as usize]); } else { n = bw_set_s(o, n, 32, W_TILE_DEFAULT); }
            n = bw_rect(o, n, 10, x, (GR_TOP[r as usize] - vy) * s, js_max(1.0, s * 0.9), js_max(1.0, (GR_BOT[r as usize] - GR_TOP[r as usize] + 1.0) * s - js_min(1.0, s * 0.1)));
        }
        r = r + 1;
    }
    var i : u32 = 0;
    while (i < P_N) {
        const k : usize = i as usize;
        var px : f64 = (P_X[k] - vx) * s;
        var py : f64 = (P_Y[k] - vy) * s;
        var pw : f64 = P_W[k] * s;
        var ph : f64 = P_H[k] * s;
        if (!(px > S_CSSW) and !(py > S_CSSH) and !(px + pw < 0.0 - 3.0) and !(py + ph < 0.0 - 3.0)) {
            if (pw < 3.0) {
                px = px - (3.0 - pw) / 2.0;
                pw = 3.0;
            }
            if (ph < 3.0) {
                py = py - (3.0 - ph) / 2.0;
                ph = 3.0;
            }
            n = bw_set_s(o, n, 32, kind_color(P_K[k] as u32));
            n = bw_rect(o, n, 10, px, py, pw, ph);
        }
        i = i + 1;
    }
    if (S_HOVER >= 0) { n = bw_ring(o, n, S_HOVER, W_HOVER_COLOR, s, vx, vy); }
    if (S_PICK >= 0) { n = bw_ring(o, n, S_PICK, W_PICK_COLOR, s, vx, vy); }
    if (n == OVER) { return 0; }
    return n;
}


// --- Tests of the native page -------------------------------------------------------------------------------------------

pub const W_TEST_DATA : str = "{\"source\":{\"top\":\"t<1>\",\"design\":\"d\",\"part\":\"p\",\"nextpnr\":\"n\",\"commands\":[\"c1 & c2\",\"c3\"]},\"geometry\":{\"grid_w\":40,\"grid_h\":30,\"runs\":[[\"clbll\",2,1,20],[\"bram\",10,3,12],[\"zzz\",11,0,0]],\"maps\":{\"SLICE\":{\"x\":[2,2,3,3],\"y\":[1,2,3,4,5,6]},\"RAMB36\":{\"x\":[10],\"y\":[8,16]},\"RAMB18\":{\"x\":[10],\"y\":[8,12,16,20]},\"IOB\":{\"x\":[0],\"y\":[5,6]},\"BUFGCTRL\":{\"x\":[20],\"y\":[2]}}},\"cells\":[[\"a\",\"SLICE_LUTX\",\"SLICE_X0Y0/A6LUT\"],[\"b\",\"SLICE_FFX\",\"SLICE_X1Y0/CFF\"],[\"c\",\"CARRY4\",\"SLICE_X0Y1/CARRY4\"],[\"r\",\"RAMB36E1\",\"RAMB36_X0Y1/RAMB36E1\"],[\"f\",\"FIFO18E1\",\"FIFO18_X0Y2/FIFO18E1\"],[\"i\",\"IOB33_OUTBUF\",\"IOB_X0Y1/IOB33/OUTBUF\"],[\"g\",\"BUFGCTRL\",\"BUFGCTRL_X0Y0/BUFGCTRL\"],[\"z\",\"PSEUDO_GND\",\"NULL_X0Y9/PSEUDO_GND_BEL\"],[\"q\",\"SLICE_LUTX\",\"SLICE_X0Y0/B5LUT\"],[\"w\",\"FOO\",\"SLICE_X9Y0/A6LUT\"],[null,null,null]]}";

fn has_text(o: []const u8, n: u32, want: []const u8) -> bool {
    if (want.len > (n as usize)) { return false; }
    var i : usize = 0;
    while (i + want.len <= (n as usize)) {
        var k : usize = 0;
        while (k < want.len and o[i + k] == want[k]) { k = k + 1; }
        if (k == want.len) { return true; }
        i = i + 1;
    }
    return false;
}

fn open_page() -> u32 {
    w_init("");
    w_view(800.0, 1.0, 0, 900.0, 800.0);
    return 0;
}

fn load_test() -> u32 {
    w_data(0, W_TEST_DATA);
    return 0;
}

test the_page_opens_loading_with_nothing_drawn {
    open_page();
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert n > 0;
    assert has_text(o[0..], n, "<div class=\"pm-bar\"><button class=\"t27-btn\" type=\"button\">Whole die</button><button class=\"t27-btn\" type=\"button\">Fit design</button><button class=\"t27-btn\" type=\"button\" hidden=\"\">Demo design</button></div>");
    assert has_text(o[0..], n, "<p class=\"pm-status\" role=\"status\">Loading the placement...</p>");
    assert has_text(o[0..], n, "<canvas class=\"pm-canvas\" role=\"img\" tabindex=\"0\" aria-label=");
    assert !has_text(o[0..], n, " width=\"");
    assert has_text(o[0..], n, "<ul class=\"pm-legend\"></ul><div class=\"pm-info\" aria-live=\"polite\"></div>");
    assert has_text(o[0..], n, "<details class=\"pm-off\"></details><details class=\"pm-how\"></details>");
    assert has_text(o[0..], n, "<label class=\"t27-drop pm-drop\"><input type=\"file\" accept=\".json,application/json\" class=\"pm-file\"><span>Drop a routed");
    var d : [64]u8 = [0; 64];
    assert w_bdraw(d[0..]) == 0;
}

test a_demo_that_did_not_load_says_so {
    open_page();
    w_data_failed(0);
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">The demo placement did not load.</p>");
    w_data(0, "{\"geometry\": 5}");
    const n2 : u32 = w_render(o[0..]);
    assert has_text(o[0..], n2, "role=\"status\">The demo placement did not load.</p>");
    assert !S_GRID;
}

test the_mini_demo_loads_and_is_summarised {
    open_page();
    load_test();
    assert S_GRID and S_DEMO;
    assert C_N == 11 and P_N == 8 and O_N == 3;
    var o : [262144]u8 = [0; 262144];
    const n : u32 = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">t&lt;1&gt;: 11 cells placed in 3 of 33,650 slices</p>");
    assert has_text(o[0..], n, " width=\"800\" height=\"600\" style=\"height: 600px;\"");
    assert has_text(o[0..], n, "<ul class=\"pm-legend\"><li><i style=\"background:#00ff88\"></i>LUT 2</li><li><i style=\"background:#ffd700\"></i>FF 1</li><li><i style=\"background:#00b4ff\"></i>CARRY4 1</li><li><i style=\"background:#be78ff\"></i>BRAM 2</li><li><i style=\"background:#ff4d6d\"></i>IO 1</li><li><i style=\"background:#ffffff\"></i>BUFG 1</li><li><i style=\"background:#8a8a8a\"></i>OTHER 3</li></ul>");
    assert has_text(o[0..], n, "<div class=\"pm-info\" aria-live=\"polite\"><p class=\"pm-muted\">Hover or tap a dot.</p></div>");
    assert has_text(o[0..], n, "<details class=\"pm-off\"><summary>Not drawn (3): site outside the XC7A200T map or a virtual site</summary><ul><li>z  PSEUDO_GND  NULL_X0Y9/PSEUDO_GND_BEL</li><li>w  FOO  SLICE_X9Y0/A6LUT</li><li>null  null  -</li>");
    assert has_text(o[0..], n, "<details class=\"pm-how\"><summary>How this was made</summary><p>d on p, placed by n</p><ul><li><code>c1 &amp; c2</code></li><li><code>c3</code></li></ul></details>");
    assert S_DEMO_HIDDEN;
}

test cells_are_placed_the_way_tool_js_places_them {
    open_page();
    load_test();
    // a: SLICE_X0Y0/A6LUT -> grid (2, 1), left slice, letter A, LUT column
    assert P_C[0] == 0 and P_X[0] == 2.0 and P_Y[0] == 1.0 and P_W[0] == 0.14 and P_H[0] == 0.25;
    // b: SLICE_X1Y0/CFF -> right slice (+0.46), letter C (+0.5), FF column (+0.15)
    assert P_C[1] == 1 and P_X[1] == 2.0 + 0.46 + 1.0 * 0.15 and P_Y[1] == 1.0 + 2.0 * 0.25 and P_H[1] == 0.25;
    // c: a carry chain is one tall bar in the third column
    assert P_C[2] == 2 and P_X[2] == 2.0 + 0.0 + 2.0 * 0.15 and P_Y[2] == 2.0 and P_H[2] == 1.0;
    // r: RAMB36 at grid (10, 16) is five tall and starts four above
    assert P_X[3] == 10.0 and P_Y[3] == 12.0 and P_W[3] == 0.9 and P_H[3] == 5.0;
    // f: FIFO18 uses the RAMB18 map: (10, 16), 2.5 tall from two above
    assert P_X[4] == 10.0 and P_Y[4] == 14.0 and P_H[4] == 2.5;
    // i: IOB at (0, 6)
    assert P_X[5] == 0.0 and P_Y[5] == 6.0 and P_W[5] == 0.9 and P_H[5] == 1.0;
    // g: anything else is 1.5 square
    assert P_X[6] == 20.0 and P_Y[6] == 2.0 and P_W[6] == 1.5 and P_H[6] == 1.5;
    // q shares the site of a
    assert P_C[6] == 6;
    assert site_same(0, 8) and !site_same(0, 1);
    assert P_K[0] == 0 and P_K[1] == 1 and P_K[2] == 2 and P_K[3] == 3 and P_K[5] == 5 and P_K[6] == 6;
}

test the_drawing_is_a_binary_list_that_starts_with_the_canvas_and_the_transform {
    open_page();
    load_test();
    var o : [262144]u8 = [0; 262144];
    const n : u32 = w_bdraw(o[0..]);
    assert n > 300;
    assert o[0] == 200 and o[1] == 0 and o[2] == 12;
    // setTransform(1, 0, 0, 1, 0, 0): 1.0 is 3FF0000000000000, little endian
    assert o[3] == 0 and o[9] == 240 and o[10] == 63;
    // then fillStyle "#000" (op 32, length 4) and a fillRect (op 10)
    assert o[51] == 32 and o[52] == 4 and o[53] == 0 and o[54] == 35 and o[55] == 48;
    assert o[58] == 10;
    assert f64_bits(1.0) == 4607182418800017408;
    assert f64_bits(0.0 - 2.5) == 13836183955189006336;
    assert f64_bits(0.0) == 0;
    assert f64_bits(0.1) == 4591870180066957722;
    assert f64_bits(123456.789) == 4683220299150161609;
}

test a_tap_picks_the_dot_and_lists_the_cells_of_its_site {
    open_page();
    load_test();
    // the view after fit(design): find the screen point of cell a (centre of its rectangle)
    const sx : f64 = (P_X[0] + P_W[0] / 2.0 - S_VX) * S_VS;
    const sy : f64 = (P_Y[0] + P_H[0] / 2.0 - S_VY) * S_VS;
    w_cpointer(0, 1, sx, sy, 1);
    w_cpointer(2, 1, sx, sy, 1);
    assert S_PICK == 0;
    var o : [262144]u8 = [0; 262144];
    const n : u32 = w_render(o[0..]);
    assert has_text(o[0..], n, "<p class=\"pm-muted\">2 cells at this site</p><table><thead><tr><th>cell</th><th>type</th><th>BEL</th></tr></thead><tbody><tr class=\"is-pick\"><td><i style=\"background:#00ff88\"></i>a</td><td>SLICE_LUTX</td><td>SLICE_X0Y0/A6LUT</td></tr><tr class=\"\"><td><i style=\"background:#00ff88\"></i>q</td><td>SLICE_LUTX</td><td>SLICE_X0Y0/B5LUT</td></tr></tbody></table>");
    var d : [262144]u8 = [0; 262144];
    const m : u32 = w_bdraw(d[0..]);
    assert has_text(d[0..], m, "#ffd700");
    assert !has_text(d[0..], m, "#e8fff7");
}

test a_mouse_over_a_dot_hovers_it_and_leaving_clears_it {
    open_page();
    load_test();
    const sx : f64 = (P_X[6] + P_W[6] / 2.0 - S_VX) * S_VS;
    const sy : f64 = (P_Y[6] + P_H[6] / 2.0 - S_VY) * S_VS;
    w_cpointer(1, 7, sx, sy, 1);
    assert S_HOVER == 6;
    w_cpointer(1, 7, sx + 1.0, sy, 0);
    assert S_HOVER == 6;
    w_cpointer(4, 7, 0.0, 0.0, 1);
    assert S_HOVER == 0 - 1;
    // a touch pointer does not hover
    w_cpointer(1, 8, sx, sy, 0);
    assert S_HOVER == 0 - 1;
    // far from every dot
    w_cpointer(1, 7, 0.0, 0.0, 1);
    assert S_HOVER == 0 - 1;
}

test a_drag_pans_and_does_not_pick {
    open_page();
    load_test();
    const vx : f64 = S_VX;
    const vs : f64 = S_VS;
    w_cpointer(0, 1, 100.0, 100.0, 1);
    w_cpointer(1, 1, 102.0, 101.0, 1);
    assert S_VX == vx;
    w_cpointer(1, 1, 140.0, 120.0, 1);
    assert S_VX == vx - 40.0 / vs;
    w_cpointer(2, 1, 140.0, 120.0, 1);
    assert S_PICK == 0 - 1;
    assert !DR_ON and PT_N == 0;
}

test two_pointers_pinch_and_one_cancel_stops_it {
    open_page();
    load_test();
    const vs : f64 = S_VS;
    w_cpointer(0, 1, 300.0, 200.0, 0);
    w_cpointer(0, 2, 400.0, 200.0, 0);
    assert PI_ON and PT_N == 2;
    w_cpointer(1, 2, 500.0, 200.0, 0);
    assert S_VS > vs;
    w_cpointer(3, 2, 0.0, 0.0, 0);
    assert !PI_ON and !DR_ON and PT_N == 1;
}

test the_wheel_waits_for_exp_from_the_host_then_zooms {
    open_page();
    load_test();
    const vs : f64 = S_VS;
    assert w_wheel(400.0, 300.0, 0.0 - 240.0, 0) == 2;
    assert S_VS == vs;
    var need : [30]f64 = [0.0; 30];
    assert w_libm_need(need[0..]) == 1;
    assert need[0] == 16.0 and need[1] == 0.0 - (0.0 - 240.0) * 0.0025;
    var give : [3]f64 = [0.0; 3];
    give[0] = 1.8221188003905089;
    assert w_libm_give(give[0..], 1) == 0;
    assert w_wheel(400.0, 300.0, 0.0 - 240.0, 0) == 1;
    assert S_VS > vs;
    // ctrl scales by 0.01
    assert w_wheel(400.0, 300.0, 100.0, 1) == 2;
    assert w_libm_need(need[0..]) == 1;
    assert need[1] == (0.0 - 100.0) * 0.01;
}

test the_keys_zoom_and_pan_and_others_are_left_alone {
    open_page();
    load_test();
    const vs : f64 = S_VS;
    assert w_key("+") == 1;
    assert S_VS > vs;
    assert w_key("-") == 1;
    assert w_key("=") == 1;
    const vx2 : f64 = S_VX;
    const step : f64 = 40.0 / S_VS;
    assert w_key("ArrowLeft") == 1;
    assert S_VX == vx2 - step;
    assert w_key("ArrowRight") == 1;
    assert w_key("ArrowUp") == 1;
    assert w_key("ArrowDown") == 1;
    assert w_key("r") == 0;
    assert w_key("Escape") == 0;
    assert w_key("") == 0;
}

test the_box_resize_rescales_the_view_and_the_canvas {
    open_page();
    load_test();
    const cx : f64 = S_VX + S_CSSW / S_VS / 2.0;
    w_view(400.0, 1.0, 0, 900.0, 400.0);
    assert w_box(400.0, 300.0) == 1;
    assert S_CSSW == 400.0;
    // the same width again changes nothing
    assert w_box(400.0, 300.0) == 0;
    const cx2 : f64 = S_VX + S_CSSW / S_VS / 2.0;
    assert cx2 - cx < 0.000001 and cx - cx2 < 0.000001;
    var o : [262144]u8 = [0; 262144];
    const n : u32 = w_render(o[0..]);
    assert has_text(o[0..], n, " width=\"400\" height=\"300\" style=\"height: 300px;\"");
}

test the_window_sets_the_canvas_height {
    open_page();
    load_test();
    // grid 40 x 30: a 800 wide canvas would be 600 high; the window of 900 allows 630
    assert S_CSSH == 600.0;
    w_view(800.0, 2.0, 0, 500.0, 800.0);
    w_click(0);
    assert S_CSSH == 350.0 and S_CANVAS_W == 1600 and S_CANVAS_H == 700;
    w_view(800.0, 1.0, 1, 500.0, 0.0);
    w_click(1);
    assert S_CSSW == 600.0 and S_CSSH == 295.0;
}

test fit_design_uses_the_box_of_the_slices_and_whole_die_the_grid {
    open_page();
    load_test();
    assert BOX_ON;
    // slice cells a, b, c, q span x 2 .. 2.61+0.14 and y 1 .. 3, plus 4 around
    assert BOX_X0 == 2.0 - 4.0 and BOX_Y0 == 1.0 - 4.0;
    assert BOX_Y1 == 3.0 + 4.0;
    w_click(0);
    assert S_VS == 600.0 / 30.0;
    assert S_VX == 20.0 - 800.0 / S_VS / 2.0;
}

test a_nextpnr_file_is_read_sorted_and_loaded {
    open_page();
    load_test();
    const f : []const u8 = "{\"creator\":\"nextpnr <x>\",\"modules\":{\"top\":{\"cells\":{\"zed\":{\"type\":\"SLICE_LUTX\",\"attributes\":{\"NEXTPNR_BEL\":\"SLICE_X0Y0/A6LUT\"}},\"alpha\":{\"type\":\"SLICE_FFX\",\"attributes\":{\"NEXTPNR_BEL\":\"SLICE_X0Y0/AFF\"}},\"nobel\":{\"type\":\"X\",\"attributes\":{}},\"\\ud83d\\ude00\":{\"type\":5,\"attributes\":{\"NEXTPNR_BEL\":\"NULL_X0Y1/B\"}},\"\\uff5e\":{\"attributes\":{\"NEXTPNR_BEL\":\"NULL_X0Y2/B\"}}}}}}";
    assert w_file("f&.json", 1234.0, f, 0) == 0;
    assert C_N == 4 and S_LABEL_N == 7;
    // JavaScript sorts by UTF-16 units: "alpha" < "zed" < the emoji (D83D) < U+FF5E
    assert same_text(C_POOL[(C_NO[0] as usize)..((C_NO[0] + C_NL[0]) as usize)], "alpha");
    assert same_text(C_POOL[(C_NO[1] as usize)..((C_NO[1] + C_NL[1]) as usize)], "zed");
    assert C_NL[2] == 4 and C_POOL[C_NO[2] as usize] == 240;
    assert C_NL[3] == 3 and C_POOL[C_NO[3] as usize] == 239;
    // String(type): 5 -> "5", a missing type -> "undefined"
    assert same_text(C_POOL[(C_TO[2] as usize)..((C_TO[2] + C_TL[2]) as usize)], "5");
    assert same_text(C_POOL[(C_TO[3] as usize)..((C_TO[3] + C_TL[3]) as usize)], "undefined");
    var o : [262144]u8 = [0; 262144];
    const n : u32 = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">f&amp;.json: 4 cells placed in 1 of 33,650 slices</p>");
    assert has_text(o[0..], n, "<p>f&amp;.json (1,234 bytes), nextpnr &lt;x&gt;</p><ul></ul></details>");
    assert has_text(o[0..], n, "<button class=\"t27-btn\" type=\"button\">Demo design</button>");
    assert !S_DEMO_HIDDEN;
    // the file input is cleared once
    assert w_value(0, o[0..]) == 0;
    assert w_value(0, o[0..]) == 4294967295;
    // Demo design brings the demo back
    w_click(2);
    assert C_N == 11 and S_DEMO_HIDDEN;
}

test modules_are_taken_in_object_values_order_and_a_repeated_key_keeps_its_last_value {
    open_page();
    load_test();
    // modules "b" "10" "2" "a": integer keys first (2, 10), then b, a. The same cell name in two modules keeps the module order.
    const f : []const u8 = "{\"modules\":{\"b\":{\"cells\":{\"x\":{\"type\":\"Tb\",\"attributes\":{\"NEXTPNR_BEL\":\"NULL_X0Y0/b\"}}}},\"10\":{\"cells\":{\"x\":{\"type\":\"T10\",\"attributes\":{\"NEXTPNR_BEL\":\"NULL_X0Y0/b\"}}}},\"2\":{\"cells\":{\"x\":{\"type\":\"T2\",\"attributes\":{\"NEXTPNR_BEL\":\"NULL_X0Y0/b\"}},\"y\":{\"type\":\"first\",\"attributes\":{\"NEXTPNR_BEL\":\"NULL_X0Y0/b\"}},\"y\":{\"type\":\"last\",\"attributes\":{\"NEXTPNR_BEL\":\"NULL_X0Y0/b\"}},\"z\":{\"type\":\"gone\",\"attributes\":{\"NEXTPNR_BEL\":\"NULL_X0Y0/b\"}},\"z\":{\"type\":\"gone\",\"attributes\":{}}}},\"a\":{\"cells\":{\"x\":{\"type\":\"Ta\",\"attributes\":{\"NEXTPNR_BEL\":\"NULL_X0Y0/b\"}}}}}}";
    assert w_file("m.json", 10.0, f, 0) == 0;
    assert C_N == 5;
    assert same_text(C_POOL[(C_TO[0] as usize)..((C_TO[0] + C_TL[0]) as usize)], "T2");
    assert same_text(C_POOL[(C_TO[1] as usize)..((C_TO[1] + C_TL[1]) as usize)], "T10");
    assert same_text(C_POOL[(C_TO[2] as usize)..((C_TO[2] + C_TL[2]) as usize)], "Tb");
    assert same_text(C_POOL[(C_TO[3] as usize)..((C_TO[3] + C_TL[3]) as usize)], "Ta");
    assert same_text(C_POOL[(C_TO[4] as usize)..((C_TO[4] + C_TL[4]) as usize)], "last");
}

test a_file_that_is_no_use_leaves_the_page_as_it_was {
    open_page();
    load_test();
    var o : [262144]u8 = [0; 262144];
    assert w_file("a.json", 5.0, "{", 0) == 0;
    var n : u32 = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">a.json is not JSON.</p>");
    assert C_N == 11;
    w_file("b.json", 5.0, "{\"modules\":{}}", 0);
    n = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">b.json has no placed cells: no NEXTPNR_BEL attributes. Use the JSON nextpnr writes with --write after routing.</p>");
    w_file("c.json", 536870913.0, "{}", 0);
    n = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">c.json is larger than 512 MB.</p>");
    w_file("d.json", 100000000.0, "", 0);
    n = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">d.json is larger than 64 MB.</p>");
    w_file("e.json", 5.0, "", 1);
    n = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">e.json is not JSON.</p>");
    assert C_N == 11 and S_DEMO_HIDDEN;
}

test a_file_before_the_data_is_ignored {
    open_page();
    assert w_file("a.json", 5.0, "{}", 0) == 0;
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">Loading the placement...</p>");
}

test the_drop_zone_lights_up_while_a_file_is_over_it {
    open_page();
    assert w_drag(0) == 1;
    var o : [65536]u8 = [0; 65536];
    var n : u32 = w_render(o[0..]);
    assert has_text(o[0..], n, "<label class=\"t27-drop pm-drop is-over\">");
    assert w_drag(0) == 0;
    assert w_drag(1) == 1;
    n = w_render(o[0..]);
    assert has_text(o[0..], n, "<label class=\"t27-drop pm-drop\">");
}

test the_templates_fill_like_fmt {
    arg_set(0, "ab", 0, 2);
    arg_set(1, "xyz", 0, 3);
    var buf : [64]u8 = [0; 64];
    const l : i64 = fmt_into(buf[0..], "{0}-{1}-{2}-{1}{x}", 2);
    assert l == 14;
    assert same_text(buf[0..14], "ab-xyz--xyz{x}");
}

test hypot_is_the_v8_algorithm {
    assert hypot2(3.0, 4.0) == 5.0;
    assert hypot2(0.0 - 3.0, 4.0) == 5.0;
    assert hypot2(0.0, 0.0) == 0.0;
    assert hypot2(0.0, 7.5) == 7.5;
    assert hypot2(1.0, 1.0) == 1.4142135623730951;
    assert hypot2(0.1, 0.2) == 0.223606797749979;
    assert hypot2(js_inf(0.0), js_nan(0.0)) == js_inf(0.0);
    assert js_is_nan(hypot2(js_nan(0.0), 1.0));
    assert hypot2(1e200, 1e200) == 1.414213562373095e200;
}

test the_hash_set_counts_distinct_sites {
    open_page();
    load_test();
    // cells a, b, c, q, r.. : the slice sites are X0Y0, X1Y0, X0Y1 -> 3, plus the off-map FOO (not a slice type) -> 3
    assert S_SLICES == 3;
}

test a_carriage_return_in_a_name_is_written_as_a_character_reference {
    open_page();
    load_test();
    const f : []const u8 = "{\"modules\":{\"t\":{\"cells\":{\"a\\rb&\":{\"type\":\"FOO\",\"attributes\":{\"NEXTPNR_BEL\":\"NULL_X0Y1/B\"}}}}}}";
    assert w_file("f.json", 10.0, f, 0) == 0;
    var o : [262144]u8 = [0; 262144];
    const n : u32 = w_render(o[0..]);
    assert has_text(o[0..], n, "<li>a&#13;b&amp;  FOO  NULL_X0Y1/B</li>");
}

test a_type_longer_than_the_old_scratch_buffer_is_read {
    open_page();
    load_test();
    var f : [40000]u8 = [0; 40000];
    const head : []const u8 = "{\"modules\":{\"t\":{\"cells\":{\"a\":{\"type\":\"";
    const tail : []const u8 = "\",\"attributes\":{\"NEXTPNR_BEL\":\"NULL_X0Y1/B\"}}}}}}";
    var n : usize = 0;
    var k : usize = 0;
    while (k < head.len) {
        f[n] = head[k];
        n = n + 1;
        k = k + 1;
    }
    var q : usize = 0;
    while (q < 20000) {
        f[n] = 116;
        n = n + 1;
        q = q + 1;
    }
    k = 0;
    while (k < tail.len) {
        f[n] = tail[k];
        n = n + 1;
        k = k + 1;
    }
    assert w_file("g.json", 20100.0, f[0..n], 0) == 0;
    assert C_N == 1 and C_TL[0] == 20000;
}

/// The splicer follows only the names a module itself mentions, not the names the imported functions mention.
/// This anchor mentions every helper the writer, the JSON reader and the number rules call. Never called.
pub fn imports_anchor(o: []u8, s: []const u8) -> u32 {
    var n : u32 = 0;
    n = n + (ok(0) as u32);
    n = n + OVER;
    n = n + put(o, 0, 0);
    n = n + raw(o, 0, s);
    n = n + put_escaped(o, 0, 0);
    n = n + text(o, 0, s);
    n = n + num(o, 0, 0);
    n = n + attr(o, 0, s, s);
    n = n + fill(o, 0, s, s, s, s, 0);
    n = n + fill_named(o, 0, s, s, s, s, s, s, s, s, s, s, s, s, s);
    n = n + dec_to(o, 0);
    n = n + (name_is(s, 0, 0, s) as u32);
    n = n + (is_word_byte(0) as u32);
    n = n + (H_LT as u32);
    n = n + (H_GT as u32);
    n = n + (H_AMP as u32);
    n = n + (H_QUOTE as u32);
    n = n + (H_APOS as u32);
    n = n + (H_SPACE as u32);
    n = n + (H_SLASH as u32);
    n = n + (H_EQ as u32);
    n = n + ((NO_SPAN < 0) as u32);
    n = n + ((SPAN > 0) as u32);
    n = n + (J_NONE as u32);
    n = n + (J_OBJECT as u32);
    n = n + (J_ARRAY as u32);
    n = n + (J_STRING as u32);
    n = n + (J_NUMBER as u32);
    n = n + (J_TRUE as u32);
    n = n + (J_FALSE as u32);
    n = n + (J_NULL as u32);
    n = n + (jspan(0, 0) as u32);
    n = n + (span_lo(0) as u32);
    n = n + (span_hi(0) as u32);
    n = n + (skip_ws(s, 0) as u32);
    n = n + (string_end(s, 0) as u32);
    n = n + (value_end(s, 0) as u32);
    n = n + (root(s) as u32);
    n = n + (kind(s, 0) as u32);
    n = n + (key_is(s, 0, 0, s) as u32);
    n = n + (obj_get(s, 0, s) as u32);
    n = n + arr_len(s, 0);
    n = n + (arr_at(s, 0, 0) as u32);
    n = n + hex4(s, 0);
    n = n + escape_at(s, 0, 0);
    n = n + cp_utf8_len(0);
    n = n + (cp_utf8_byte(0, 0) as u32);
    n = n + str_len(s, 0);
    n = n + (str_byte(s, 0, 0) as u32);
    n = n + JN_OVER;
    n = n + JN_CAP;
    n = n + ((JN_TWO52 > 0.0) as u32);
    n = n + ((JN_TWO53 > 0.0) as u32);
    n = n + jn_put(o, 0, 0);
    n = n + jn_raw(o, 0, s);
    n = n + jn_digits(o, 0);
    n = n + jn_mul(o, 0, 0);
    n = n + jn_mul2(o, 0, 0);
    n = n + jn_mul5(o, 0, 0);
    n = n + jn_shift(o, 0, 0);
    n = n + (jn_cmp(s, s, 0) as u32);
    n = n + (jn_expo(0.0) as u32);
    n = n + (jn_mant(0.0) as u32);
    n = n + ((jn_make(0, 0) > 0.0) as u32);
    n = n + jn_exact(o, 0, 0);
    n = n + jn_fscale(0);
    n = n + (js_is_nan(0.0) as u32);
    n = n + ((js_nan(0.0) > 0.0) as u32);
    n = n + ((js_inf(1.0) > 0.0) as u32);
    n = n + ((js_floor(0.0) > 0.0) as u32);
    n = n + ((js_ceil(0.0) > 0.0) as u32);
    n = n + ((js_max(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_min(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_round(0.0) > 0.0) as u32);
    n = n + (jn_shortest(o, 1.0) as u32);
    n = n + jn_copy(o, s, 0);
    n = n + jn_put_run(o, 0, s, 0, 0);
    n = n + jn_layout(o, 0, s, 0, 0);
    n = n + js_str_num(o, 0, 0.0);
    n = n + js_to_fixed(o, 0, 0.0, 0);
    n = n + js_locale_num(o, 0, 0.0);
    n = n + (jn_num_ok(s, 0, 0) as u32);
    n = n + (jn_cmp_text(s, 0, 0, 0, 0) as u32);
    n = n + ((js_parse_num(s, 0, 0) > 0.0) as u32);
    n = n + ((jn_dec_value(s, 0, 0) > 0.0) as u32);
    n = n + (jn_abs(0) as u32);
    n = n + js_str_u64(o, 0, 0);
    n = n + jv_str_to(o, 0, s, 0);
    n = n + jv_text_str(o, 0, s, 0);
    n = n + ((jv_numval(s, 0) > 0.0) as u32);
    n = n + jv_str(o, 0, s, 0);
    n = n + jv_text(o, 0, s, 0);
    n = n + (jv_is(s, 0, s) as u32);
    n = n + (jv_truthy(s, 0) as u32);
    n = n + (jv_is_ws(0) as u32);
    n = n + ((jv_number_of_text(s, 0) > 0.0) as u32);
    n = n + ((jv_num(s, 0) > 0.0) as u32);
    n = n + jv_vput_str(o, 0, s, s);
    n = n + jv_vput_f64(o, 0, s, 0.0);
    n = n + jv_vput_val(o, 0, s, s, 0);
    n = n + jv_vput_defined(o, 0, s, s, 0);
    n = n + jv_vput_fixed(o, 0, s, 0.0, 0);
    n = n + jv_kid(o, 0, s, 0);
    n = n + jv_find(s, 0, s);
    n = n + jv_fill(o, 0, s, s, 0, true);
    n = n + (jv_string_ok(s, 0) as u32);
    n = n + (jv_number_ok(s, 0) as u32);
    n = n + (jv_lit_ok(s, 0, s) as u32);
    n = n + (jv_valid(s) as u32);
    n = n + jv_ws_at(s, 0, 0);
    n = n + jv_ws_before(s, 0, 0);
    n = n + jv_digit_value(0);
    n = n + jv_fill_raw(o, 0, s, s, 0, true);
    n = n + jv_fill_with(o, 0, s, s, 0, true, true);
    n = n + num_grouped(o, 0, 0);
    return n;
}
