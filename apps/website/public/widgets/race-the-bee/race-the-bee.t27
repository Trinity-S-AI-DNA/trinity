// SPDX-License-Identifier: Apache-2.0
; specs/widgets/race-the-bee.t27 -- who lands patches on gHashTag/t27: the Queen's bees or a person
; Source of truth for public/widgets/race-the-bee/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English of its own: every
; word on screen is a SAY_ constant here, and the lane rule is K_ constants.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT SHOWS: a dated snapshot, not a live race. scripts/widget-data/race-the-bee.mjs reads
; gHashTag/t27 through the GitHub GraphQL API (read-only GETs) and writes data.json beside the
; page; the page reads only that file. Three views: a scoreboard of the merged pull requests of
; the last seven days that close an issue, split into a bee lane and a human lane, with the median
; hours from the issue being opened to the merge; the issues where both lanes opened a pull
; request, with who opened first and who merged first; and the open issues nobody had taken at
; snapshot time, each a link to GitHub for the reader's own click.

; THE LANE RULE: a pull request is the bee's when its head branch is queen-<N>; those branches are
; written by a bee the Queen dispatched and published by tools/queen/publish.py in gHashTag/t27.
; Every other pull request is the human lane: a person opened the session, and that person may
; have used an AI assistant (claude/ and codex/ branches), so "human" means human-steered, not
; hand-typed. An open issue counts as takeable when it has a "## Boundary" section (the Queen's
; own rule, tools/queen/needs_boundary.py: without one no bee can be dispatched), no open pull
; request closes it, and no queen-<N> branch for it exists on the remote.

; WHAT IT DOES NOT CLAIM: that a race is running. No harness assigns one issue to a person and a
; bee at the same moment; the head-to-head rows are the few issues where both lanes happened to
; open a pull request. It does not claim the lanes do the same work: most bee merges are
; machine-filed "Port ... to specs/port" tasks, which no person took in the window, so the median
; hours compare different workloads. It does not claim an open issue is still free: the Queen may
; dispatch a bee to any of them after the snapshot. It does not rank the people or the bees.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_race_the_bee;

use widgets::html_out::ok;
use widgets::html_out::OVER;
use widgets::html_out::put;
use widgets::html_out::raw;
use widgets::html_out::put_escaped;
use widgets::html_out::text;
use widgets::html_out::num;
use widgets::html_out::attr;
use widgets::html_out::fill;
use widgets::html_out::fill_named;
use widgets::html_out::dec_to;
use widgets::html_out::name_is;
use widgets::html_out::is_word_byte;
use widgets::html_out::H_LT;
use widgets::html_out::H_GT;
use widgets::html_out::H_AMP;
use widgets::html_out::H_QUOTE;
use widgets::html_out::H_APOS;
use widgets::html_out::H_SPACE;
use widgets::html_out::H_SLASH;
use widgets::html_out::H_EQ;
use widgets::json_scan::NO_SPAN;
use widgets::json_scan::SPAN;
use widgets::json_scan::J_NONE;
use widgets::json_scan::J_OBJECT;
use widgets::json_scan::J_ARRAY;
use widgets::json_scan::J_STRING;
use widgets::json_scan::J_NUMBER;
use widgets::json_scan::jspan;
use widgets::json_scan::span_lo;
use widgets::json_scan::span_hi;
use widgets::json_scan::skip_ws;
use widgets::json_scan::string_end;
use widgets::json_scan::value_end;
use widgets::json_scan::root;
use widgets::json_scan::kind;
use widgets::json_scan::key_is;
use widgets::json_scan::obj_get;
use widgets::json_scan::arr_len;
use widgets::json_scan::arr_at;
use widgets::json_scan::hex4;
use widgets::json_scan::escape_at;
use widgets::json_scan::cp_utf8_len;
use widgets::json_scan::cp_utf8_byte;
use widgets::json_scan::str_len;
use widgets::json_scan::str_byte;


pub const KIND : str = "widget-tool";
pub const ID : str = "race-the-bee";
pub const TITLE : str = "Race the bee: who lands patches on t27, a person or a bee";
pub const DESCRIPTION : str = "A dated snapshot of gHashTag/t27: merged pull requests by the Queen's bees and by people, the issues both lanes went for, and the open ones nobody has taken.";
pub const IMAGE_ALT : str = "Race the bee card, snapshot 2026-10-04 of gHashTag/t27 over seven days: bees merged 152 pull requests (139 of them port tasks), people merged 62; on all 3 issues both lanes tried, the person opened first and the bee merged first.";
pub const HOOK : str = "Three times this week a person and a bee went for the same issue. The person started first every time; the bee merged first every time.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [4]str = ["GitHub GraphQL API, gHashTag/t27: pull requests closed in the window and every open pull request, with the issues each one closes", "GitHub GraphQL API, gHashTag/t27: every open issue and its body, searched for a ## Boundary section", "GitHub REST API, gHashTag/t27 git/matching-refs/heads/queen-: the bee branches on the remote", "scripts/widget-data/race-the-bee.mjs: the snapshot, written to public/widgets/race-the-bee/data.json with its UTC time"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The rule --------------------------------------------------------------------------------
pub const K_REPO : str = "gHashTag/t27";
pub const K_BEE_BRANCH_PREFIX : str = "queen-";
pub const K_WINDOW_DAYS : u8 = 7;
pub const K_OPEN_SHOWN : u8 = 12;
pub const K_DATA_FILE : str = "./data.json";
pub const K_LANES : [2]str = ["bee", "human"];

; --- Words -----------------------------------------------------------------------------------
; {name} is filled from data.json by tool.js; nothing else is.
pub const SAY_SNAPSHOT : str = "Snapshot, not a live race: taken {at} UTC from GitHub, covering the last {days} days of {repo}.";
pub const SAY_LOADING : str = "Reading the snapshot...";
pub const SAY_LOAD_FAILED : str = "The snapshot file could not be read.";
pub const SAY_TABS : [3]str = ["Scoreboard", "Head to head", "Take one"];
pub const SAY_LANE_NAMES : [2]str = ["Bee", "Human"];
pub const SAY_LANE_LINES : [2]str = ["head branch queen-<N>, written by a bee the Queen dispatched", "any other branch: a person steered the session, often with an AI assistant"];
pub const SAY_MERGED : str = "merged PRs that close an issue";
pub const SAY_MEDIAN_ISSUE : str = "median hours, issue opened to merge";
pub const SAY_MEDIAN_PR : str = "median hours, PR opened to merge";
pub const SAY_PORT_TASKS : str = "of them machine-filed port tasks";
pub const SAY_NOT_SAME_WORK : str = "Not the same work: {beePort} of the bees' {beeMerged} merges were machine-filed port tasks, and people took {humanPort} of those. The hours compare different workloads, not speed on one task.";
pub const SAY_RECENT : str = "Latest merges";
pub const SAY_HOURS : str = "h";
pub const SAY_ISSUE : str = "issue";
pub const SAY_PR : str = "PR";
pub const SAY_H2H_INTRO : str = "Issues where both lanes opened a pull request in the window: {n}. Nobody set these up as races; both lanes just went for the same issue.";
pub const SAY_H2H_NONE : str = "No issue in this window had pull requests from both lanes.";
pub const SAY_OPENED_FIRST : str = "opened first";
pub const SAY_MERGED_FIRST : str = "merged first";
pub const SAY_NOBODY_MERGED : str = "nobody merged yet";
pub const SAY_STATES : [3]str = ["merged", "open", "closed"];
pub const SAY_OPENED_AT : str = "opened";
pub const SAY_MERGED_AT : str = "merged";
pub const SAY_TAKE_INTRO : str = "{untouched} of {boundary} open issues with a Boundary had no pull request and no bee branch at snapshot time. A bee may be sent to any of them after it; check the issue before you start.";
pub const SAY_TAKE_COUNTS : str = "Open issues {total}; with a Boundary {boundary}; with no open PR {free}; of those, a bee branch already exists for {branch}.";
pub const SAY_TAKE_LINK : str = "Open on GitHub";
pub const SAY_RULE_TITLE : str = "How a lane is decided";
pub const SAY_RULE : str = "A pull request is the bee's when its head branch is queen-<N>; every other one is the human lane. Data: {repo}, read with gh api at the snapshot time; this page calls nobody.";

; --- Tests -----------------------------------------------------------------------------------
test the_page_sends_nothing_and_reads_no_file {
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == false;
    assert K_DATA_FILE == "./data.json";
}

test two_lanes_and_one_rule {
    assert K_LANES[0] == "bee";
    assert K_LANES[1] == "human";
    assert SAY_LANE_NAMES[0] == "Bee";
    assert K_BEE_BRANCH_PREFIX == "queen-";
    assert K_REPO == "gHashTag/t27";
}

test the_window_is_a_week_and_the_list_is_short {
    assert K_WINDOW_DAYS == 7;
    assert K_OPEN_SHOWN > 0;
    assert K_OPEN_SHOWN <= 20;
}

test it_is_a_game_widget {
    assert KIND == "widget-tool";
    assert CATEGORY == "game";
    assert ID == "race-the-bee";
}


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/race-the-bee/tool.js (105 lines of hand-written
; JavaScript). The words above are unchanged. The host protocol is jtag_verdict.t27's, plus the data:
;   w_init(hash)          the page opens: state "loading"
;   w_data(i, bytes)      file i of K_DATA_FILE has been fetched; w_data_failed(i) when it could not be
;   w_click(i)            tab button i was pressed
;   w_render(dst)         the page's HTML, length (0 on overflow)
; The data is read as bytes (json_scan.t27): no tree, spans of values. A number is written as its
; own text in the file, which is what String(n) gives for the numbers the builder wrote. Not carried
; MEASURED 2026-10-19: t27c gen + a 5-line Zig export wrapper + zig build-exe wasm32-freestanding
; give a 13014-byte wasm. The original page (tool.js) and this one ran in two DOM windows against the
; real 109288-byte data.json: the initial page and the three tabs, then 13 variants of the data (no
; contested issues, nobody merged, open and odd PR states, null hours, titles with markup, quotes,
; backslash, newline, accents and an emoji, 3 or no landed rows, an unknown lane, odd timestamps, big
; numbers, no open issues) each with its three tabs: 59 comparisons of tag, attributes and text, 0
; differences. Not carried over: the data file is cut at W_DATA_CAP bytes (the page then says it could not be read); a timestamp
; longer than 63 bytes is cut.

pub const W_DATA_CAP : u32 = 131072;
pub var DATA : [131072]u8 = [0; 131072];
pub var DATA_LEN : u32 = 0;
pub var DATA_STATE : u8 = 0;
pub var TAB : u32 = 0;
pub var TMP : [64]u8 = [0; 64];

pub fn w_init(h: []const u8) -> u32 {
    DATA_STATE = 0;
    DATA_LEN = 0;
    TAB = 0;
    return 0;
}

pub fn w_data(i: u32, s: []const u8) -> u32 {
    if (s.len > (W_DATA_CAP as usize)) {
        DATA_STATE = 2;
        return 0;
    }
    var k : usize = 0;
    while (k < s.len) {
        DATA[k] = s[k];
        k = k + 1;
    }
    DATA_LEN = s.len as u32;
    DATA_STATE = 1;
    if (root(DATA[0..(DATA_LEN as usize)]) < 0) { DATA_STATE = 2; }
    return 0;
}

pub fn w_data_failed(i: u32) -> u32 {
    DATA_STATE = 2;
    return 0;
}

pub fn w_click(i: u32) -> u32 {
    if (i < 3) { TAB = i; }
    return 0;
}

fn str_is(d: []const u8, sp: i64, lit: []const u8) -> bool {
    if (str_len(d, sp) != (lit.len as u32)) { return false; }
    var k : usize = 0;
    while (k < lit.len) {
        if (str_byte(d, sp, k as u32) != lit[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// A JSON string value as text.
fn jtext(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    var n : u32 = n0;
    const len : u32 = str_len(d, sp);
    var k : u32 = 0;
    while (k < len) {
        n = put_escaped(dst, n, str_byte(d, sp, k));
        k = k + 1;
    }
    return n;
}

/// A JSON number as the text it has in the file.
fn jraw(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    var n : u32 = n0;
    var p : usize = span_lo(sp);
    while (p < span_hi(sp)) {
        n = put(dst, n, d[p]);
        p = p + 1;
    }
    return n;
}

/// A JSON string copied to TMP (cut at 63 bytes); its length.
fn tmp_of(d: []const u8, sp: i64) -> u32 {
    var len : u32 = str_len(d, sp);
    if (len > 63) { len = 63; }
    var k : u32 = 0;
    while (k < len) {
        TMP[k as usize] = str_byte(d, sp, k);
        k = k + 1;
    }
    return len;
}

/// stamp(): the first T becomes a space, a trailing :dd and Z go; nothing for an empty or missing value.
fn stamp(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    var n : u32 = n0;
    if (kind(d, sp) != J_STRING) { return n; }
    var len : u32 = tmp_of(d, sp);
    if (len >= 3 and TMP[(len - 1) as usize] == 90 and TMP[(len - 2) as usize] >= 48 and TMP[(len - 2) as usize] <= 57 and TMP[(len - 3) as usize] >= 48 and TMP[(len - 3) as usize] <= 57 and len >= 4 and TMP[(len - 4) as usize] == 58) {
        len = len - 4;
    }
    var k : u32 = 0;
    var seen_t : bool = false;
    while (k < len) {
        const b : u8 = TMP[k as usize];
        if (b == 84 and !seen_t) {
            n = put(dst, n, 32);
            seen_t = true;
        } else {
            n = put_escaped(dst, n, b);
        }
        k = k + 1;
    }
    return n;
}

/// The stamp with the T replaced and the seconds cut, as bytes for fill(): length, bytes in TMP.
fn stamp_tmp(d: []const u8, sp: i64) -> u32 {
    var len : u32 = tmp_of(d, sp);
    if (len >= 4 and TMP[(len - 1) as usize] == 90 and TMP[(len - 2) as usize] >= 48 and TMP[(len - 2) as usize] <= 57 and TMP[(len - 3) as usize] >= 48 and TMP[(len - 3) as usize] <= 57 and TMP[(len - 4) as usize] == 58) {
        len = len - 4;
    }
    var k : u32 = 0;
    var seen_t : bool = false;
    while (k < len) {
        if (TMP[k as usize] == 84 and !seen_t) { TMP[k as usize] = 32; seen_t = true; }
        k = k + 1;
    }
    return len;
}

fn lane_ix(d: []const u8, sp: i64) -> u32 {
    if (str_is(d, sp, "bee")) { return 0; }
    if (str_is(d, sp, "human")) { return 1; }
    return 255;
}

fn chip(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    var n : u32 = raw(dst, n0, "<span class=\"rtb-chip rtb-");
    n = jtext(dst, n, d, sp);
    n = raw(dst, n, "\">");
    const ix : u32 = lane_ix(d, sp);
    if (ix < 2) { n = text(dst, n, SAY_LANE_NAMES[ix as usize]); } else { n = jtext(dst, n, d, sp); }
    return raw(dst, n, "</span>");
}

/// <a href=url target=_blank rel=noopener [class=cls]> then the caller's text and </a>.
fn link_open(dst: []u8, n0: u32, d: []const u8, url: i64, cls: []const u8) -> u32 {
    var n : u32 = raw(dst, n0, "<a href=\"");
    n = jtext(dst, n, d, url);
    n = raw(dst, n, "\" target=\"_blank\" rel=\"noopener\"");
    if (cls.len > 0) {
        n = attr(dst, n, "class", cls);
    }
    return raw(dst, n, ">");
}

fn hrs(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    var n : u32 = n0;
    if (kind(d, sp) != J_NUMBER) { return put(dst, n, 45); }
    n = jraw(dst, n, d, sp);
    n = put(dst, n, 32);
    return text(dst, n, SAY_HOURS);
}

fn lane_card(dst: []u8, n0: u32, d: []const u8, lanes: i64, name: []const u8, ix: u32) -> u32 {
    const l : i64 = obj_get(d, lanes, name);
    var n : u32 = raw(dst, n0, "<section class=\"rtb-lane rtb-");
    n = text(dst, n, name);
    n = raw(dst, n, "\"><h2>");
    n = text(dst, n, SAY_LANE_NAMES[ix as usize]);
    n = raw(dst, n, "</h2><p class=\"rtb-rule\">");
    n = text(dst, n, SAY_LANE_LINES[ix as usize]);
    n = raw(dst, n, "</p><p class=\"rtb-big\">");
    n = jraw(dst, n, d, obj_get(d, l, "merged"));
    n = raw(dst, n, "<small>");
    n = text(dst, n, SAY_MERGED);
    n = raw(dst, n, "</small></p><dl><dt>");
    n = text(dst, n, SAY_MEDIAN_ISSUE);
    n = raw(dst, n, "</dt><dd>");
    n = hrs(dst, n, d, obj_get(d, l, "medianHoursIssueToMerge"));
    n = raw(dst, n, "</dd><dt>");
    n = text(dst, n, SAY_MEDIAN_PR);
    n = raw(dst, n, "</dt><dd>");
    n = hrs(dst, n, d, obj_get(d, l, "medianHoursPrToMerge"));
    n = raw(dst, n, "</dd><dt>");
    n = text(dst, n, SAY_PORT_TASKS);
    n = raw(dst, n, "</dt><dd>");
    n = jraw(dst, n, d, obj_get(d, l, "portTasks"));
    return raw(dst, n, "</dd></dl></section>");
}

fn scoreboard(dst: []u8, n0: u32, d: []const u8, r: i64) -> u32 {
    const lanes : i64 = obj_get(d, r, "lanes");
    var n : u32 = raw(dst, n0, "<div><div class=\"rtb-lanes\">");
    n = lane_card(dst, n, d, lanes, "bee", 0);
    n = lane_card(dst, n, d, lanes, "human", 1);
    n = raw(dst, n, "</div><p class=\"rtb-note\">");
    var b1 : [20]u8 = [0; 20];
    var b2 : [20]u8 = [0; 20];
    var b3 : [20]u8 = [0; 20];
    const bee : i64 = obj_get(d, lanes, "bee");
    const hum : i64 = obj_get(d, lanes, "human");
    const l1 : u32 = raw_to(b1[0..], d, obj_get(d, bee, "portTasks"));
    const l2 : u32 = raw_to(b2[0..], d, obj_get(d, bee, "merged"));
    const l3 : u32 = raw_to(b3[0..], d, obj_get(d, hum, "portTasks"));
    n = fill_named(dst, n, SAY_NOT_SAME_WORK, "beePort", b1[0..(l1 as usize)], "beeMerged", b2[0..(l2 as usize)], "humanPort", b3[0..(l3 as usize)], "", "", "", "", "", "");
    n = raw(dst, n, "</p><h3>");
    n = text(dst, n, SAY_RECENT);
    n = raw(dst, n, "</h3><ul class=\"rtb-list\">");
    const landed : i64 = obj_get(d, r, "landed");
    var cnt : u32 = arr_len(d, landed);
    if (cnt > 8) { cnt = 8; }
    var i : u32 = 0;
    while (i < cnt) {
        const row : i64 = arr_at(d, landed, i);
        n = raw(dst, n, "<li>");
        n = chip(dst, n, d, obj_get(d, row, "lane"));
        n = raw(dst, n, " ");
        n = link_open(dst, n, d, obj_get(d, row, "issueUrl"), "");
        n = raw(dst, n, "#");
        n = jraw(dst, n, d, obj_get(d, row, "issue"));
        n = raw(dst, n, "</a> <span class=\"rtb-title\">");
        n = jtext(dst, n, d, obj_get(d, row, "title"));
        n = raw(dst, n, "</span> <span class=\"rtb-meta\">");
        n = text(dst, n, SAY_PR);
        n = raw(dst, n, " ");
        n = link_open(dst, n, d, obj_get(d, row, "prUrl"), "");
        n = raw(dst, n, "#");
        n = jraw(dst, n, d, obj_get(d, row, "pr"));
        n = raw(dst, n, "</a> ");
        n = hrs(dst, n, d, obj_get(d, row, "hoursIssueToMerge"));
        n = raw(dst, n, "</span></li>");
        i = i + 1;
    }
    return raw(dst, n, "</ul></div>");
}

/// A JSON value's own text into dst; its length.
fn raw_to(dst: []u8, d: []const u8, sp: i64) -> u32 {
    var n : u32 = 0;
    var p : usize = span_lo(sp);
    while (p < span_hi(sp) and n < (dst.len as u32)) {
        dst[n as usize] = d[p];
        n = n + 1;
        p = p + 1;
    }
    return n;
}

fn state_word(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    if (str_is(d, sp, "merged")) { return text(dst, n0, SAY_STATES[0]); }
    if (str_is(d, sp, "open")) { return text(dst, n0, SAY_STATES[1]); }
    if (str_is(d, sp, "closed")) { return text(dst, n0, SAY_STATES[2]); }
    return jtext(dst, n0, d, sp);
}

fn head_to_head(dst: []u8, n0: u32, d: []const u8, r: i64) -> u32 {
    const c : i64 = obj_get(d, r, "contested");
    const cnt : u32 = arr_len(d, c);
    if (cnt == 0) {
        var m : u32 = raw(dst, n0, "<p class=\"rtb-note\">");
        m = text(dst, m, SAY_H2H_NONE);
        return raw(dst, m, "</p>");
    }
    var n : u32 = raw(dst, n0, "<div><p class=\"rtb-note\">");
    var nb : [20]u8 = [0; 20];
    const nl : u32 = dec_to(nb[0..], cnt as u64);
    n = fill_named(dst, n, SAY_H2H_INTRO, "n", nb[0..(nl as usize)], "", "", "", "", "", "", "", "", "", "");
    n = raw(dst, n, "</p><ul class=\"rtb-list rtb-races\">");
    var i : u32 = 0;
    while (i < cnt) {
        const row : i64 = arr_at(d, c, i);
        n = raw(dst, n, "<li class=\"rtb-race\"><p class=\"rtb-race-head\">");
        n = link_open(dst, n, d, obj_get(d, row, "issueUrl"), "");
        n = raw(dst, n, "#");
        n = jraw(dst, n, d, obj_get(d, row, "issue"));
        n = raw(dst, n, "</a> <span class=\"rtb-title\">");
        n = jtext(dst, n, d, obj_get(d, row, "title"));
        n = raw(dst, n, "</span></p><p class=\"rtb-verdict\">");
        n = chip(dst, n, d, obj_get(d, row, "openedFirstBy"));
        n = raw(dst, n, " ");
        n = text(dst, n, SAY_OPENED_FIRST);
        n = raw(dst, n, "<span class=\"rtb-sep\"> / </span>");
        const fm : i64 = obj_get(d, row, "firstMergedBy");
        if (kind(d, fm) == J_STRING and str_len(d, fm) > 0) {
            n = chip(dst, n, d, fm);
            n = raw(dst, n, " ");
            n = text(dst, n, SAY_MERGED_FIRST);
        } else {
            n = text(dst, n, SAY_NOBODY_MERGED);
        }
        n = raw(dst, n, "</p><ul class=\"rtb-prs\">");
        const prs : i64 = obj_get(d, row, "prs");
        const pc : u32 = arr_len(d, prs);
        var j : u32 = 0;
        while (j < pc) {
            const p : i64 = arr_at(d, prs, j);
            n = raw(dst, n, "<li>");
            n = chip(dst, n, d, obj_get(d, p, "lane"));
            n = raw(dst, n, " ");
            n = link_open(dst, n, d, obj_get(d, p, "url"), "");
            n = text(dst, n, SAY_PR);
            n = raw(dst, n, " #");
            n = jraw(dst, n, d, obj_get(d, p, "pr"));
            n = raw(dst, n, "</a> <span class=\"rtb-meta\">");
            n = text(dst, n, SAY_OPENED_AT);
            n = raw(dst, n, " ");
            n = stamp(dst, n, d, obj_get(d, p, "opened"));
            const mg : i64 = obj_get(d, p, "merged");
            if (kind(d, mg) == J_STRING and str_len(d, mg) > 0) {
                n = raw(dst, n, ", ");
                n = text(dst, n, SAY_MERGED_AT);
                n = raw(dst, n, " ");
                n = stamp(dst, n, d, mg);
            } else {
                n = raw(dst, n, ", ");
                n = state_word(dst, n, d, obj_get(d, p, "state"));
            }
            n = raw(dst, n, "</span></li>");
            j = j + 1;
        }
        n = raw(dst, n, "</ul></li>");
        i = i + 1;
    }
    return raw(dst, n, "</ul></div>");
}

fn take_one(dst: []u8, n0: u32, d: []const u8, r: i64) -> u32 {
    const o : i64 = obj_get(d, r, "open");
    var n : u32 = raw(dst, n0, "<div><p class=\"rtb-note\">");
    var b1 : [20]u8 = [0; 20];
    var b2 : [20]u8 = [0; 20];
    var b3 : [20]u8 = [0; 20];
    var b4 : [20]u8 = [0; 20];
    const l1 : u32 = raw_to(b1[0..], d, obj_get(d, o, "untouched"));
    const l2 : u32 = raw_to(b2[0..], d, obj_get(d, o, "withBoundary"));
    n = fill_named(dst, n, SAY_TAKE_INTRO, "untouched", b1[0..(l1 as usize)], "boundary", b2[0..(l2 as usize)], "", "", "", "", "", "", "", "");
    n = raw(dst, n, "</p><p class=\"rtb-meta\">");
    const l3 : u32 = raw_to(b3[0..], d, obj_get(d, o, "total"));
    const l4 : u32 = raw_to(b4[0..], d, obj_get(d, o, "withoutOpenPr"));
    var b5 : [20]u8 = [0; 20];
    const l5 : u32 = raw_to(b5[0..], d, obj_get(d, o, "beeBranchExists"));
    n = fill_named(dst, n, SAY_TAKE_COUNTS, "total", b3[0..(l3 as usize)], "boundary", b2[0..(l2 as usize)], "free", b4[0..(l4 as usize)], "branch", b5[0..(l5 as usize)], "", "", "", "");
    n = raw(dst, n, "</p><ul class=\"rtb-list\">");
    const shown : i64 = obj_get(d, o, "shown");
    const cnt : u32 = arr_len(d, shown);
    var i : u32 = 0;
    while (i < cnt) {
        const row : i64 = arr_at(d, shown, i);
        n = raw(dst, n, "<li>");
        n = link_open(dst, n, d, obj_get(d, row, "url"), "");
        n = raw(dst, n, "#");
        n = jraw(dst, n, d, obj_get(d, row, "issue"));
        n = raw(dst, n, "</a> <span class=\"rtb-title\">");
        n = jtext(dst, n, d, obj_get(d, row, "title"));
        n = raw(dst, n, "</span> <span class=\"rtb-meta\">");
        n = text(dst, n, SAY_OPENED_AT);
        n = raw(dst, n, " ");
        n = stamp(dst, n, d, obj_get(d, row, "opened"));
        n = raw(dst, n, "</span> ");
        n = link_open(dst, n, d, obj_get(d, row, "url"), "rtb-take");
        n = text(dst, n, SAY_TAKE_LINK);
        n = raw(dst, n, "</a></li>");
        i = i + 1;
    }
    return raw(dst, n, "</ul></div>");
}

/// The whole page, as tool.js's draw(d) left it; "loading" and "could not be read" before and instead.
pub fn w_render(dst: []u8) -> u32 {
    var n : u32 = 0;
    if (DATA_STATE == 0) {
        n = raw(dst, n, "<p class=\"rtb-note\">");
        n = text(dst, n, SAY_LOADING);
        n = raw(dst, n, "</p>");
        if (!ok(n)) { return 0; }
        return n;
    }
    if (DATA_STATE == 2) {
        n = raw(dst, n, "<p class=\"rtb-note\">");
        n = text(dst, n, SAY_LOAD_FAILED);
        n = raw(dst, n, "</p>");
        if (!ok(n)) { return 0; }
        return n;
    }
    const d : []const u8 = DATA[0..(DATA_LEN as usize)];
    const r : i64 = root(d);
    n = raw(dst, n, "<p class=\"rtb-snapshot\">");
    var db : [20]u8 = [0; 20];
    const dl : u32 = raw_to(db[0..], d, obj_get(d, r, "days"));
    const at : i64 = obj_get(d, r, "snapshotAt");
    var atb : [64]u8 = [0; 64];
    const al : u32 = stamp_tmp(d, at);
    var q : u32 = 0;
    while (q < al) { atb[q as usize] = TMP[q as usize]; q = q + 1; }
    var rb : [64]u8 = [0; 64];
    const rl : u32 = tmp_of(d, obj_get(d, r, "repo"));
    q = 0;
    while (q < rl) { rb[q as usize] = TMP[q as usize]; q = q + 1; }
    n = fill_named(dst, n, SAY_SNAPSHOT, "at", atb[0..(al as usize)], "days", db[0..(dl as usize)], "repo", rb[0..(rl as usize)], "", "", "", "", "", "");
    n = raw(dst, n, "</p><div class=\"rtb-tabs\" role=\"tablist\">");
    var i : u32 = 0;
    while (i < 3) {
        n = raw(dst, n, "<button class=\"t27-btn\" type=\"button\" aria-pressed=\"");
        if (TAB == i) { n = raw(dst, n, "true"); } else { n = raw(dst, n, "false"); }
        n = raw(dst, n, "\">");
        n = text(dst, n, SAY_TABS[i as usize]);
        n = raw(dst, n, "</button>");
        i = i + 1;
    }
    n = raw(dst, n, "</div><div class=\"rtb-panel\" role=\"tabpanel\">");
    if (TAB == 0) { n = scoreboard(dst, n, d, r); }
    if (TAB == 1) { n = head_to_head(dst, n, d, r); }
    if (TAB == 2) { n = take_one(dst, n, d, r); }
    n = raw(dst, n, "</div><details class=\"rtb-ruleblock\"><summary>");
    n = text(dst, n, SAY_RULE_TITLE);
    n = raw(dst, n, "</summary><p>");
    n = fill_named(dst, n, SAY_RULE, "repo", rb[0..(rl as usize)], "", "", "", "", "", "", "", "", "", "");
    n = raw(dst, n, "</p></details>");
    if (!ok(n)) { return 0; }
    return n;
}

/// The splicer follows only the names a module itself mentions, not the names the imported functions
/// mention. This anchor mentions every helper the writer and the JSON reader call. Never called.
pub fn imports_anchor(o: []u8, s: []const u8) -> u32 {
    var n : u32 = put(o, 0, 0);
    n = put_escaped(o, n, 0);
    n = n + OVER + ((H_LT + H_GT + H_AMP + H_QUOTE + H_APOS + H_SPACE + H_SLASH + H_EQ) as u32);
    n = n + (name_is(s, 0, 0, s) as u32) + (is_word_byte(0) as u32);
    n = n + (skip_ws(s, 0) as u32) + (string_end(s, 0) as u32) + (value_end(s, 0) as u32);
    n = n + (key_is(s, 0, 0, s) as u32) + hex4(s, 0) + escape_at(s, 0, 0) + cp_utf8_len(0) + (cp_utf8_byte(0, 0) as u32);
    n = n + (SPAN as u32) + (J_NONE as u32) + (J_OBJECT as u32) + (J_ARRAY as u32) + (J_STRING as u32) + (J_NUMBER as u32);
    n = n + (NO_SPAN as u32) + (jspan(0, 0) as u32);
    return n;
}
