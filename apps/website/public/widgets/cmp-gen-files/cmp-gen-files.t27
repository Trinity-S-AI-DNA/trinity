// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-gen-files.t27 -- Committed output that nobody regenerated: the verify rule
; Source of truth for public/widgets/cmp-gen-files/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-gen-files/logic.js -- the fn
; bodies of gHashTag/t27 specs/verified/gen_file_check.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 18 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader sets whether the seal hashes match and the state of the committed Rust, C, Verilog and JSON file: ok,
; absent, drift, unreadable or orphan. The widget asks gen_file_passes for each file, and verify_passes and verify_passes_today for the whole.

; WHAT IT DOES NOT CLAIM:  it hashes no file: the states are what the reader sets. The before answer is the lab measurement the spec records
; for 2026-10-18, t27c 0.5.2 at master 982894c96, and may have changed since.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_gen_files;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-gen-files";
pub const TITLE : str = "Committed output that nobody regenerated: the verify rule";
pub const DESCRIPTION : str = "A seal records hashes, and on the lab seal --verify never opened the generated files committed beside a spec. Set the state of each file and see whether the rule passes.";
pub const IMAGE_ALT : str = "Verify card: the seal hashes all match, the Rust file has drifted from what its generator emits today, and the other three files are absent. The rule says verify fails, in red. The measured account before the rule said it passes, because the recorded hashes decided alone.";
pub const HOOK : str = "A generated file cut to 200 bytes verified with five MATCH lines. The rule: a committed file must equal what its generator writes, or the verify fails.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/verified/gen_file_check.t27 (t27 master 90e797659): every verdict is gen_file_passes, verify_passes or verify_passes_today, fn bodies compiled to wasm (logic.js); the lab account is in the spec's header (2026-10-18)", "Course 12 of t27.ai, t27-compiler: lesson 18 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 5;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_GEN_OK : u8 = 0;
pub const K_GEN_ABSENT : u8 = 1;
pub const K_GEN_DRIFT : u8 = 2;
pub const K_GEN_UNREADABLE : u8 = 3;
pub const K_GEN_ORPHAN : u8 = 4;
pub const K_PRESET_SEAL : [4]u8 = [1, 1, 1, 1];
pub const K_PRESET_RUST : [4]u8 = [2, 0, 1, 3];
pub const K_PRESET_C : [4]u8 = [1, 0, 1, 1];
pub const K_PRESET_VERILOG : [4]u8 = [1, 0, 2, 1];
pub const K_PRESET_JSON : [4]u8 = [1, 0, 1, 4];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine steps of this course; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [4]str = ["A truncated Rust file", "All files untouched", "A hand-edited Verilog file", "A file nobody generates"];
pub const SAY_ASK : str = "Does seal --verify look at the generated files committed beside a spec?";
pub const SAY_SEAL : str = "the seal hashes all match";
pub const SAY_FILES : [4]str = ["Rust file", "C file", "Verilog file", "JSON file"];
pub const SAY_STATES : [5]str = ["ok", "absent", "drift", "unreadable", "orphan"];
pub const SAY_STATE_LINES : [5]str = ["equal to what its generator emits today", "no such file: nothing to check", "its bytes differ from what its generator emits today", "it exists but its bytes cannot be read", "the backend no longer generates anything for this spec"];
pub const SAY_PASSES : str = "passes";
pub const SAY_FAILS : str = "fails";
pub const SAY_VERIFY : str = "seal --verify {0}";
pub const SAY_BEFORE : str = "Measured before the rule: {0}";
pub const SAY_NOTE : str = "An absent file is not drift: most specs have no committed output. A file must equal its generator, not the recorded hash, because a spec with use is hashed unresolved by the seal and resolved by the generator.";
pub const SAY_SOURCE : str = "Logic: t27 spec verified/gen_file_check.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_is_one_of_nine_course_steps {
    assert K_STAGE < 9;
    assert K_STAGE == 5;
}

test five_states_of_a_committed_file {
    assert K_GEN_OK == 0;
    assert K_GEN_ABSENT == 1;
    assert K_GEN_DRIFT == 2;
    assert K_GEN_UNREADABLE == 3;
    assert K_GEN_ORPHAN == 4;
}

test the_start_is_a_truncated_rust_file_beside_three_absent_ones {
    assert K_PRESET_RUST[0] == K_GEN_DRIFT;
    assert K_PRESET_C[0] == K_GEN_ABSENT;
    assert K_PRESET_SEAL[0] == 1;
    assert K_START_PRESET == 0;
}
