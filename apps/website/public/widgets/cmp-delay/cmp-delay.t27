// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-delay.t27 -- How fast can it clock? Delay and fmax from the LUT depth
; Source of truth for public/widgets/cmp-delay/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-delay/logic.js -- the fn
; bodies of gHashTag/t27 specs/compiler/hir_cost_models.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 10 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader slides the LUT depth of a path from 0 to 40. The widget asks est_comb_delay and est_reg_to_reg_delay
; for the delays in picoseconds and fmax_from_delay for the clock each one allows, and plots the clock against the depth.

; WHAT IT DOES NOT CLAIM:  these are the compiler's static estimates, not a place-and-route timing report. slack returns a signed
; 64-bit number, which wasm cannot take, so no slack is shown. The picosecond constants are held equal to the spec's.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_delay;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-delay";
pub const TITLE : str = "How fast can it clock? Delay and fmax from the LUT depth";
pub const DESCRIPTION : str = "Before a design reaches a board the compiler estimates its speed. Slide the number of LUTs on the longest path and read the delay, with and without the register, and the clock it allows.";
pub const IMAGE_ALT : str = "Delay card: a path of 3 LUTs. The combinational delay is 600 ps and the register to register delay 800 ps. The estimated fmax is 1250 MHz for the register to register path. Two curves below plot fmax against the LUT depth from 0 to 40, starting at 3333 MHz and 2000 MHz at depth zero.";
pub const HOOK : str = "Each LUT adds the same 100 ps and the path adds one routing hop: a deeper path costs a fixed step, and the clock it allows is a second divided by the delay.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/compiler/hir_cost_models.t27 (t27 master 90e797659): every number is est_comb_delay, est_reg_to_reg_delay or fmax_from_delay, fn bodies compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 10 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 3;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_MAX_LUTS : u8 = 40;
pub const K_LUT_DELAY_PS : u8 = 100;
pub const K_ROUTING_DELAY_PS : u16 = 300;
pub const K_SETUP_TIME_PS : u8 = 200;
pub const K_PRESET_LUTS : [4]u8 = [3, 0, 10, 30];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine steps of this course; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [4]str = ["Three LUTs", "No LUT", "Ten LUTs", "Thirty LUTs"];
pub const SAY_ASK : str = "How fast can a design clock before anyone places a single wire?";
pub const SAY_LUTS : str = "LUTs on the longest path";
pub const SAY_COMB : str = "combinational delay";
pub const SAY_REG : str = "register to register delay";
pub const SAY_FMAX_COMB : str = "fmax, no register";
pub const SAY_FMAX_REG : str = "fmax, register to register";
pub const SAY_PS : str = "{0} ps";
pub const SAY_MHZ : str = "{0} MHz";
pub const SAY_RECIPE : str = "delay = LUTs x {0} ps + {1} ps for one routing hop, plus {2} ps of setup when a register ends the path";
pub const SAY_AXIS_X : str = "LUTs on the path";
pub const SAY_AXIS_Y : str = "MHz";
pub const SAY_NOTE : str = "fmax_from_delay divides a second of picoseconds by the delay and answers in kHz; the page shows MHz. A path with no delay asks for no clock, and answers 0.";
pub const SAY_SOURCE : str = "Logic: t27 spec compiler/hir_cost_models.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_is_one_of_nine_course_steps {
    assert K_STAGE < 9;
    assert K_STAGE == 3;
}

test three_delay_constants_in_picoseconds {
    assert K_LUT_DELAY_PS == 100;
    assert K_ROUTING_DELAY_PS == 300;
    assert K_SETUP_TIME_PS == 200;
}

test the_start_is_three_luts_deep {
    assert K_PRESET_LUTS[0] == 3;
    assert K_PRESET_LUTS[3] <= K_MAX_LUTS;
    assert K_START_PRESET == 0;
}
