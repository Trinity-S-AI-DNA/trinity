/// Two texts equal byte for byte (t27c's Zig target does not compare two str array elements with ==).
pub fn same_text(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn copy_into(dst: []u8, at: u32, s: []const u8) -> u32 {
    var n : u32 = at;
    var k : usize = 0;
    while (k < s.len and (n as usize) < dst.len) {
        dst[n as usize] = s[k];
        n = n + 1;
        k = k + 1;
    }
    return n;
}

// --- fmt(): the templates {0} {1} ... of the words, with the arguments in ARB -------------------------------

pub var ARB : [262144]u8 = [0; 262144];
pub var ARO : [8]u32 = [0; 8];
pub var ARL : [8]u32 = [0; 8];

pub fn fmt_into(dst: []u8, tpl: []const u8, nargs: u32) -> i64 {
    var n : usize = 0;
    var k : usize = 0;
    while (k < tpl.len) {
        var done : bool = false;
        if (tpl[k] == 123) {
            var q : usize = k + 1;
            var idx : u64 = 0;
            while (q < tpl.len and is_digit(tpl[q])) {
                if (idx < 100000) { idx = idx * 10 + ((tpl[q] - 48) as u64); }
                q = q + 1;
            }
            if (q > k + 1 and q < tpl.len and tpl[q] == 125) {
                if (idx < (nargs as u64)) {
                    var a : usize = 0;
                    while (a < (ARL[idx as usize] as usize)) {
                        if (n >= dst.len) { return -1; }
                        dst[n] = ARB[(ARO[idx as usize] as usize) + a];
                        n = n + 1;
                        a = a + 1;
                    }
                }
                k = q + 1;
                done = true;
            }
        }
        if (!done) {
            if (n >= dst.len) { return -1; }
            dst[n] = tpl[k];
            n = n + 1;
            k = k + 1;
        }
    }
    return n as i64;
}

pub fn arg_set(i: usize, w: []const u8, lo: usize, hi: usize) -> bool {
    var at : usize = 0;
    if (i > 0) { at = (ARO[i - 1] + ARL[i - 1]) as usize; }
    if (at + (hi - lo) > 262144) { return false; }
    ARO[i] = at as u32;
    ARL[i] = (hi - lo) as u32;
    var k : usize = lo;
    while (k < hi) {
        ARB[at + (k - lo)] = w[k];
        k = k + 1;
    }
    return true;
}

pub fn arg_num(i: usize, x: f64) -> bool {
    var at : usize = 0;
    if (i > 0) { at = (ARO[i - 1] + ARL[i - 1]) as usize; }
    if (at + 400 > 262144) { return false; }
    ARO[i] = at as u32;
    const e : u32 = js_str_num(ARB[0 .. 262144], at as u32, x);
    if (e == JN_OVER) { return false; }
    ARL[i] = e - (at as u32);
    return true;
}

fn arg_text(i: usize, s: []const u8) -> bool {
    return arg_set(i, s, 0, s.len);
}

/// arg i = num(x), Number.toLocaleString('en-US')
fn arg_loc(i: usize, x: f64) -> bool {
    const e : u32 = js_locale_num(S_NUM[0..], 0, x);
    if (e == OVER) { return arg_set(i, S_NUM[0..], 0, 0); }
    return arg_set(i, S_NUM[0..], 0, e as usize);
}

fn put_say(dst: []u8, n0: u32, tpl: []const u8, nargs: u32) -> u32 {
    const l : i64 = fmt_into(S_FB[0..], tpl, nargs);
    if (l < 0) { return OVER; }
    return text(dst, n0, S_FB[0..(l as usize)]);
}

fn status_is(s: []const u8) -> u32 {
    S_STATUS_N = copy_into(S_STATUS[0..], 0, s);
    return 0;
}

fn status_fmt(tpl: []const u8, nargs: u32) -> u32 {
    const l : i64 = fmt_into(S_STATUS[0..], tpl, nargs);
    S_STATUS_N = 0;
    if (l >= 0) { S_STATUS_N = l as u32; }
    return 0;
}

/// (100 * a / b).toFixed(2), or "0" when b is 0
fn pct_into(dst: []u8, n0: u32, a: f64, b: f64) -> u32 {
    if (b == 0.0 or b != b) { return raw(dst, n0, "0"); }
    return js_to_fixed(dst, n0, (100.0 * a) / b, 2);
}

