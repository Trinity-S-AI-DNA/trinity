    S_NSAMP = 0;
    S_HAVE = false;
    S_INFO = false;
    S_PRESSED = 0 - 1;
    S_SAMPLE_IX = 0;
    S_OVER = false;
    S_CLR_FILE = false;
    S_ROT = 0;
    S_VX = 0.0;
    S_VY = 0.0;
    S_VS = 1.0;
    S_HK = 1.0;
    S_CSSW = 0.0;
    S_CSSH = 0.0;
    S_LASTW = 0.0;
    S_SIZED = false;
    S_DREW = false;
    S_GEN = 0;
    PK_ON = false;
    HV_ON = false;
    PT_N = 0;
    DR_ON = false;
    PI_ON = false;
    S_EF_N = 0;
    X_N = 0;
    X_PN = 0;
    LB_N = 0;
    RQ_N = 0;
    MISSING = false;
    R_NCOL = 0;
    R_NOFF = 0;
    S_CMDN = 0;
