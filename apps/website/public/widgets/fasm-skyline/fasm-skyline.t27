pub fn w_view(width: f64, dpr: f64, embed: u32, ih: f64, bw: f64) -> u32 {
    ENV_W = width;
    ENV_DPR = dpr;
    ENV_EMBED = embed;
    ENV_IH = ih;
    ENV_BW = bw;
    return 0;
}

pub fn w_measure_sel(dst: []u8) -> u32 {
    return copy_into(dst, 0, W_MEASURE_SEL);
}

pub fn w_canvas_keep() -> u32 {
    return 1;
}

pub fn w_drop_root() -> u32 {
    return 1;
}

pub fn w_draw_cap() -> u32 {
    return W_DRAW_CAP;
}

pub fn w_file_cap() -> u32 {
    return W_FILE_CAP;
}

// --- the two data files ------------------------------------------------------------------------------------------

fn str_to(dst: []u8, at: u32, d: []const u8, sp: i64) -> u32 {
    var n : u32 = at;
    const l : u32 = str_len(d, sp);
    var k : u32 = 0;
    while (k < l and (n as usize) < dst.len) {
        dst[n as usize] = str_byte(d, sp, k);
        n = n + 1;
        k = k + 1;
    }
    return n;
}

/// Iterate the members of the object at span sp: the member after position p (a position inside the object, p0 =
/// span_lo + 1 for the first). Returns the key span in S_K and the value span in S_V, and the next position, or
/// 0 when there is none.
pub var S_K : i64 = 0;
pub var S_V : i64 = 0;

fn member_at(d: []const u8, sp: i64, p0: usize) -> usize {
    const hi : usize = span_hi(sp);
    var p : usize = skip_ws(d, p0);
    if (p >= hi or d[p] != 34) { return 0; }
    const ke : usize = string_end(d, p);
    if (ke > hi) { return 0; }
    const q : usize = skip_ws(d, ke);
    if (q >= hi or d[q] != 58) { return 0; }
    const v : usize = skip_ws(d, q + 1);
    const ve : usize = value_end(d, v);
    if (ve > hi) { return 0; }
    S_K = jspan(p, ke);
    S_V = jspan(v, ve);
    var nx : usize = skip_ws(d, ve);
    if (nx < hi and d[nx] == 44) { nx = skip_ws(d, nx + 1); }
    if (nx == 0) { return 1; }
    return nx;
}

fn whole(d: []const u8, sp: i64) -> i64 {
    if (kind(d, sp) != J_NUMBER) { return 0 - 1; }
    return num_i64(d, sp);
}

/// grid.json into the counting tables; false when it does not have the shape the data script writes.
fn decode_grid() -> bool {
    const d : []const u8 = G_BUF[0..(G_N as usize)];
    const r : i64 = root(d);
    if (kind(d, r) != J_OBJECT) { return false; }
    const gw : i64 = whole(d, obj_get(d, r, "w"));
    const gh : i64 = whole(d, obj_get(d, r, "h"));
    if (gw <= 0 or gh <= 0 or gw > 4096 or gh > 4096) { return false; }
    if (grid_begin(gw as u32, gh as u32) != 0) { return false; }
    G_W = gw as u32;
    G_H = gh as u32;
    // types
    const ts : i64 = obj_get(d, r, "types");
    if (kind(d, ts) != J_ARRAY) { return false; }
    var tn : u32 = 0;
    var i : u32 = 0;
    const nt : u32 = arr_len(d, ts);
    while (i < nt) {
        const e : i64 = arr_at(d, ts, i);
        if (kind(d, e) != J_STRING) { return false; }
        tn = str_to(STG_T[0..], tn, d, e);
        if ((tn as usize) >= STG_T.len) { return false; }
        STG_T[tn as usize] = 10;
        tn = tn + 1;
        i = i + 1;
    }
    if (grid_types(STG_T[0..(tn as usize)]) != 0) { return false; }
    // rle
    const rs : i64 = obj_get(d, r, "rle");
    if (kind(d, rs) != J_ARRAY) { return false; }
    const nr : u32 = arr_len(d, rs);
    if ((nr as usize) > STG_RLE.len) { return false; }
    i = 0;
    while (i < nr) {
        const v : i64 = whole(d, arr_at(d, rs, i));
        if (v < 0) { return false; }
        STG_RLE[i as usize] = v as u32;
        i = i + 1;
    }
    if (grid_rle(STG_RLE[0..(nr as usize)]) != 0) { return false; }
    // x and y: prefixes, then the segments of each
    var xn : u32 = 0;
    var yn : u32 = 0;
    var nseg : u32 = 0;
    var pnum : u32 = 0;
    var axis : u32 = 0;
    while (axis < 2) {
        var key : []const u8 = "x";
        if (axis == 1) { key = "y"; }
        const os : i64 = obj_get(d, r, key);
        if (kind(d, os) != J_OBJECT) { return false; }
        var p : usize = span_lo(os) + 1;
        var more : bool = true;
        while (more) {
            const nx : usize = member_at(d, os, p);
            if (nx == 0) {
                more = false;
            } else {
                // the key: a prefix
                if (axis == 0) {
                    xn = str_to(STG_X[0..], xn, d, S_K);
                    STG_X[xn as usize] = 10;
                    xn = xn + 1;
                } else {
                    yn = str_to(STG_Y[0..], yn, d, S_K);
                    STG_Y[yn as usize] = 10;
                    yn = yn + 1;
                }
                const segs : i64 = S_V;
                if (kind(d, segs) != J_ARRAY) { return false; }
                const ns : u32 = arr_len(d, segs);
                var q : u32 = 0;
                while (q < ns) {
                    const sg : i64 = arr_at(d, segs, q);
                    if (kind(d, sg) != J_ARRAY or arr_len(d, sg) < 5 or nseg >= 65536) { return false; }
                    STG_SEG[(nseg * 7) as usize] = axis as i32;
                    STG_SEG[(nseg * 7 + 1) as usize] = pnum as i32;
                    var f : u32 = 0;
                    while (f < 5) {
                        const nv : i64 = whole(d, arr_at(d, sg, f));
                        STG_SEG[(nseg * 7 + 2 + f) as usize] = nv as i32;
                        f = f + 1;
                    }
                    nseg = nseg + 1;
                    q = q + 1;
                }
                pnum = pnum + 1;
                if (nx == 1) { more = false; } else { p = nx; }
            }
        }
        axis = axis + 1;
    }
    if (grid_prefixes(0, STG_X[0..(xn as usize)]) != 0) { return false; }
    if (grid_prefixes(1, STG_Y[0..(yn as usize)]) != 0) { return false; }
    if (grid_segs(STG_SEG[0..((nseg * 7) as usize)]) != 0) { return false; }
    // the exceptions: name -> [gx, gy]
    const es : i64 = obj_get(d, r, "except");
    if (kind(d, es) != J_OBJECT) { return false; }
    var en : u32 = 0;
    var exn : u32 = 0;
    var ep : usize = span_lo(es) + 1;
    var emore : bool = true;
    while (emore) {
        const nx2 : usize = member_at(d, es, ep);
        if (nx2 == 0) {
            emore = false;
        } else {
            en = str_to(STG_E[0..], en, d, S_K);
            STG_E[en as usize] = 10;
            en = en + 1;
            const pr : i64 = S_V;
            if (kind(d, pr) != J_ARRAY or arr_len(d, pr) < 2 or exn >= 4096) { return false; }
            STG_XY[(exn * 2) as usize] = whole(d, arr_at(d, pr, 0)) as i32;
            STG_XY[(exn * 2 + 1) as usize] = whole(d, arr_at(d, pr, 1)) as i32;
            exn = exn + 1;
            if (nx2 == 1) { emore = false; } else { ep = nx2; }
        }
    }
    if (grid_except(STG_E[0..(en as usize)], STG_XY[0..((exn * 2) as usize)]) != 0) { return false; }
    return true;
}

fn list_add(buf: []u8, at: u32, s: []const u8) -> u32 {
    var n : u32 = copy_into(buf, at, s);
    buf[n as usize] = 10;
    return n + 1;
}

/// The family lists the counting needs, from the spec's own constants.
fn set_families() -> bool {
    var a : u32 = 0;
    var b : u32 = 0;
    var c : u32 = 0;
    var i : usize = 0;
    while (i < K_TYPE_PREFIX.len) {
        a = list_add(STG_LIST[0..], a, K_TYPE_PREFIX[i]);
        b = list_add(STG_LIST2[0..], b, K_TYPE_FAMILY[i]);
        i = i + 1;
    }
    i = 0;
    while (i < K_FAMILIES.len) {
        c = list_add(STG_LIST3[0..], c, K_FAMILIES[i]);
        i = i + 1;
    }
    return fam_set(STG_LIST[0..(a as usize)], STG_LIST2[0..(b as usize)], STG_LIST3[0..(c as usize)]) == 0;
}

/// state.runs: per column, the stretches of one family (the floor under the columns).
fn make_runs() -> bool {
    var t : u32 = 0;
    while (t < (V[V_NTY] as u32)) {
        const o : usize = GTO[t as usize] as usize;
        FAMOF[t as usize] = family_of(GPOOL[o..(o + (GTL[t as usize] as usize))]);
        t = t + 1;
    }
    RUN_N = 0;
    var gx : u32 = 0;
    while (gx < G_W) {
        var start : u32 = 0;
        var gy : u32 = 1;
        while (gy <= G_H) {
            const f : i32 = FAMOF[grid_at(gx as i64, start as i64) as usize];
            var cut : bool = gy == G_H;
            if (!cut) { cut = FAMOF[grid_at(gx as i64, gy as i64) as usize] != f; }
            if (cut) {
                if (RUN_N >= 262144) { return false; }
                RUN_F[RUN_N as usize] = f;
                RUN_GX[RUN_N as usize] = gx;
                RUN_TOP[RUN_N as usize] = start;
                RUN_BOT[RUN_N as usize] = gy - 1;
                RUN_N = RUN_N + 1;
                start = gy;
            }
            gy = gy + 1;
        }
        gx = gx + 1;
    }
    return true;
}

fn data_ready() -> u32 {
    if (DATA_ST[0] == 2 or DATA_ST[1] == 2) {
        status_is(SAY_ERR_DATA);
        return 0;
    }
    if (DATA_ST[0] != 1 or DATA_ST[1] != 1) { return 0; }
    if (!jv_valid(G_BUF[0..(G_N as usize)]) or !jv_valid(D_BUF[0..(D_N as usize)])) {
        status_is(SAY_ERR_DATA);
        return 0;
    }
    const sd : []const u8 = D_BUF[0..(D_N as usize)];
    const sr : i64 = root(sd);
    const sa : i64 = obj_get(sd, sr, "samples");
    if (kind(sd, sr) != J_OBJECT or kind(sd, sa) != J_ARRAY) {
        status_is(SAY_ERR_DATA);
        return 0;
    }
    if (!decode_grid() or !set_families() or !make_runs()) {
        status_is(SAY_ERR_DATA);
        return 0;
    }
    S_NSAMP = arr_len(sd, sa);
    S_GRID = true;
    show_sample(0);
    return 0;
}

pub fn w_data(i: u32, s: []const u8) -> u32 {
    S_EF_N = 0;
    if (i > 1) { return 0; }
    if (s.len > 1048576) {
        DATA_ST[i as usize] = 2;
    } else {
        var k : usize = 0;
        if (i == 0) {
            while (k < s.len) {
                G_BUF[k] = s[k];
                k = k + 1;
            }
            G_N = s.len as u32;
        } else {
            while (k < s.len) {
                D_BUF[k] = s[k];
                k = k + 1;
            }
            D_N = s.len as u32;
        }
        DATA_ST[i as usize] = 1;
    }
    data_ready();
    return 0;
}

pub fn w_data_failed(i: u32) -> u32 {
    S_EF_N = 0;
    if (i > 1) { return 0; }
    DATA_ST[i as usize] = 2;
    data_ready();
    return 0;
}

// --- loading a design ---------------------------------------------------------------------------------------------

/// tiles.set(name, cnt) for the name in LINE[lo..hi): a Map built from the sample's [name, n] pairs.
fn tile_set(lo: usize, hi: usize, cnt: u32) -> bool {
    const t : []const u8 = LINE[0 .. 1048576];
    var idx : usize = (fnv(t, lo, hi) as usize) % 262144;
    while (HT[idx] != 0) {
        const ti : usize = (HT[idx] - 1) as usize;
        if (pool_eq_text(TLO[ti], TLL[ti], t, lo, hi)) {
            TCT[ti] = cnt;
            return true;
        }
        idx = (idx + 1) % 262144;
    }
    const nt : usize = V[V_NT] as usize;
    if (nt >= 65536) { return false; }
    const at : i64 = pool_put_text(t, lo, hi);
    if (at < 0) { return false; }
    TLO[nt] = at as u32;
    TLL[nt] = (hi - lo) as u32;
    TCT[nt] = cnt;
    HT[idx] = (nt + 1) as u32;
    V[V_NT] = (nt + 1) as u64;
    return true;
}

fn tiles_reset() -> u32 {
    var f : usize = 0;
    while (f < 8) {
        V[f] = 0;
        f = f + 1;
    }
    var h : usize = 0;
    while (h < 262144) {
        HT[h] = 0;
        h = h + 1;
    }
    return 0;
}

/// The tile table of a sample from its "tiles" array of [name, n] pairs. false when it has not that shape.
fn sample_tiles(d: []const u8, ts: i64) -> bool {
    tiles_reset();
    if (kind(d, ts) != J_ARRAY) { return false; }
    const n : u32 = arr_len(d, ts);
    var i : u32 = 0;
    while (i < n) {
        const pr : i64 = arr_at(d, ts, i);
        if (kind(d, pr) != J_ARRAY or arr_len(d, pr) < 2) { return false; }
        const nm : i64 = arr_at(d, pr, 0);
        const ct : i64 = arr_at(d, pr, 1);
        if (kind(d, nm) != J_STRING or kind(d, ct) != J_NUMBER) { return false; }
        const l : u32 = str_to(LINE[0..], 0, d, nm);
        const c : f64 = num_f64(d, ct);
        if (!tile_set(0, l as usize, c as u32)) { return false; }
        i = i + 1;
    }
    return true;
}

/// The counting of the table the logic holds now, kept apart from it.
fn snapshot_sum() -> bool {
    const ncol : u32 = sm_info(0) as u32;
    R_NCOL = ncol;
    R_NPOOL_N = 0;
    var i : u32 = 0;
    while (i < ncol) {
        const t : usize = sm_col(i, 0) as usize;
        const o : usize = TLO[t] as usize;
        const l : usize = TLL[t] as usize;
        R_CNO[i as usize] = R_NPOOL_N;
        R_CNL[i as usize] = l as u32;
        var k : usize = 0;
        while (k < l) {
            R_NPOOL[(R_NPOOL_N as usize) + k] = POOL[o + k];
            k = k + 1;
        }
        R_NPOOL_N = R_NPOOL_N + (l as u32);
        R_CGX[i as usize] = sm_col(i, 1) as u32;
        R_CGY[i as usize] = sm_col(i, 2) as u32;
        R_CTL[i as usize] = sm_col(i, 3) as u32;
        R_CFAM[i as usize] = sm_col(i, 4) as i32;
        R_CN[i as usize] = sm_col(i, 5) as u32;
        i = i + 1;
    }
    R_NOFF = sm_info(1) as u32;
    var j : u32 = 0;
    while (j < R_NOFF and j < 300) {
        const t2 : usize = sm_off(j, 0) as usize;
        const o2 : usize = TLO[t2] as usize;
        const l2 : usize = TLL[t2] as usize;
        R_OFFNO[j as usize] = R_NPOOL_N;
        R_OFFNL[j as usize] = l2 as u32;
        var k2 : usize = 0;
        while (k2 < l2) {
            R_NPOOL[(R_NPOOL_N as usize) + k2] = POOL[o2 + k2];
            k2 = k2 + 1;
        }
        R_NPOOL_N = R_NPOOL_N + (l2 as u32);
        R_OFFN[j as usize] = sm_off(j, 1) as u32;
        j = j + 1;
    }
    R_FEAT = sm_info(2) as u64;
    R_PLACED = sm_info(3) as u64;
    R_TALL = sm_info(5);
    var f : u32 = 0;
    while (f < 64) {
        R_FAMT[f as usize] = sm_fam(f, 0);
        R_FAMF[f as usize] = sm_fam(f, 1);
        f = f + 1;
    }
    return true;
}

fn tallest_n() -> f64 {
    if (R_TALL < 0) { return 0.0; }
    return R_CN[R_TALL as usize] as f64;
}

/// load(): the table the logic holds is counted, kept, and the drawing starts again.
fn load_design() -> u32 {
    summarize();
    snapshot_sum();
    S_HAVE = true;
    S_CLEARED = V[V_CLR];
    PK_ON = false;
    HV_ON = false;
    arg_text(0, S_LABEL[0..(S_LABEL_N as usize)]);
    arg_loc(1, R_PLACED as f64);
    arg_loc(2, R_NCOL as f64);
    status_fmt(SAY_SUMMARY, 3);
    layout();
    fit(false);
    return 0;
}

/// showSample(i)
fn show_sample(i: u32) -> u32 {
    if (!S_GRID or i >= S_NSAMP) { return 0; }
    const d : []const u8 = D_BUF[0..(D_N as usize)];
    const sa : i64 = obj_get(d, root(d), "samples");
    const s : i64 = arr_at(d, sa, i);
    if (kind(d, s) != J_OBJECT) { return 0; }
    S_SAMPLE_IX = i;
    S_PRESSED = i as i32;
    if (!sample_tiles(d, obj_get(d, s, "tiles"))) {
        status_is(SAY_ERR_DATA);
        return 0;
    }
    V[V_FEAT] = num_i64(d, obj_get(d, s, "features")) as u64;
    V[V_CLR] = num_i64(d, obj_get(d, s, "cleared")) as u64;
    S_LABEL_N = str_to(S_LABEL[0..], 0, d, obj_get(d, s, "file"));
    // the source line: Sample {0}, part {1}, sha256 {2}...   (the first 16 characters of the hash)
    arg_set(0, S_LABEL[0..], 0, S_LABEL_N as usize);
    var pl : u32 = str_to(S_FB[0..], 0, d, obj_get(d, s, "part"));
    arg_set(1, S_FB[0..], 0, pl as usize);
    var shl : u32 = str_to(S_FB[0..], pl, d, obj_get(d, s, "sha256"));
    if (shl - pl > 16) { shl = pl + 16; }
    arg_set(2, S_FB[0..], pl as usize, shl as usize);
    const sl : i64 = fmt_into(S_SRC[0..], SAY_SOURCE_SAMPLE, 3);
    S_SRC_N = 0;
    if (sl >= 0) { S_SRC_N = sl as u32; }
    S_NOTE_N = 0;
    if ((i as usize) < SAY_SAMPLE_LINES.len) { S_NOTE_N = copy_into(S_NOTE[0..], 0, SAY_SAMPLE_LINES[i as usize]); }
    // the commands
    S_CMDN = 0;
    const cs : i64 = obj_get(d, s, "commands");
    var cpos : u32 = 0;
    if (kind(d, cs) == J_ARRAY) {
        const cn : u32 = arr_len(d, cs);
        var c : u32 = 0;
        while (c < cn and c < 64) {
            const e : i64 = arr_at(d, cs, c);
            S_CMDO[c as usize] = cpos;
            if (kind(d, e) == J_STRING) { cpos = str_to(S_CMD[0..], cpos, d, e); }
            S_CMDL[c as usize] = cpos - S_CMDO[c as usize];
            c = c + 1;
        }
        S_CMDN = c;
    }
    S_BADN = 0;
    return load_design();
}

// --- geometry --------------------------------------------------------------------------------------------------------

pub var G_PX : f64 = 0.0;
pub var G_PY : f64 = 0.0;

/// rotPt(x, y) into G_PX, G_PY
fn rot_pt(x: f64, y: f64) -> u32 {
    const gw : f64 = G_W as f64;
    const gh : f64 = G_H as f64;
    if (S_ROT == 1) {
        G_PX = gh - y;
        G_PY = x;
        return 0;
    }
    if (S_ROT == 2) {
        G_PX = gw - x;
        G_PY = gh - y;
        return 0;
    }
    if (S_ROT == 3) {
        G_PX = y;
        G_PY = gw - x;
        return 0;
    }
    G_PX = x;
    G_PY = y;
    return 0;
}

pub var G_U : f64 = 0.0;
pub var G_V : f64 = 0.0;

/// cellUV(gx, gy) into G_U, G_V
fn cell_uv(gx: f64, gy: f64) -> u32 {
    rot_pt(gx, gy);
    const ax : f64 = G_PX;
    const ay : f64 = G_PY;
    rot_pt(gx + 1.0, gy + 1.0);
    G_U = js_min(ax, G_PX);
    G_V = js_min(ay, G_PY);
    return 0;
}

fn px_of(u: f64, v: f64) -> f64 {
    return u - v;
}

fn py_of(u: f64, v: f64, z: f64) -> f64 {
    return (u + v) / 2.0 - z;
}

/// The six points of the hull of column ci (the outline of its box), x then y, into out[0..12].
fn hull_of(ci: u32, out: []f64) -> u32 {
    cell_uv(R_CGX[ci as usize] as f64, R_CGY[ci as usize] as f64);
    const u : f64 = G_U;
    const v : f64 = G_V;
    const z : f64 = (R_CN[ci as usize] as f64) * S_HK;
    out[0] = px_of(u, v);
    out[1] = py_of(u, v, z);
    out[2] = px_of(u + 1.0, v);
    out[3] = py_of(u + 1.0, v, z);
    out[4] = px_of(u + 1.0, v);
    out[5] = py_of(u + 1.0, v, 0.0);
    out[6] = px_of(u + 1.0, v + 1.0);
    out[7] = py_of(u + 1.0, v + 1.0, 0.0);
    out[8] = px_of(u, v + 1.0);
    out[9] = py_of(u, v + 1.0, 0.0);
    out[10] = px_of(u, v + 1.0);
    out[11] = py_of(u, v + 1.0, z);
    return 0;
}

/// layout(): the height scale and the columns in drawing order (far to near), stable.
fn layout() -> u32 {
    var mx : f64 = tallest_n();
    if (mx == 0.0) { mx = 1.0; }
    S_HK = ((K_HEIGHT_PCT as f64) / 100.0) * (((G_W as f64) + (G_H as f64)) / 2.0) / mx;
    var i : u32 = 0;
    while (i < R_NCOL) {
        cell_uv(R_CGX[i as usize] as f64, R_CGY[i as usize] as f64);
        L_DEPTH[i as usize] = G_U + G_V;
        L_U[i as usize] = G_U;
        L_CI[i as usize] = i;
        i = i + 1;
    }
    // a stable merge sort by (depth, u)
    const n : u32 = R_NCOL;
    var w : u32 = 1;
    while (w < n) {
        var lo : u32 = 0;
        while (lo < n) {
            var mid : u32 = lo + w;
            if (mid > n) { mid = n; }
            var hi : u32 = lo + w + w;
            if (hi > n) { hi = n; }
            var a : u32 = lo;
            var b : u32 = mid;
            var k : u32 = lo;
            while (a < mid or b < hi) {
                var takeb : bool = false;
                if (a >= mid) {
                    takeb = true;
                } else {
                    if (b < hi) {
                        const ca : u32 = L_CI[a as usize];
                        const cb : u32 = L_CI[b as usize];
                        var d1 : f64 = L_DEPTH[cb as usize] - L_DEPTH[ca as usize];
                        // sort((a, b) => a.depth - b.depth || a.u - b.u): b goes first when the result is positive
                        var cmp : f64 = L_DEPTH[ca as usize] - L_DEPTH[cb as usize];
                        if (cmp == 0.0 or cmp != cmp) { cmp = L_U[ca as usize] - L_U[cb as usize]; }
                        takeb = cmp > 0.0;
                    }
                }
                if (takeb) {
                    L_TMP[k as usize] = L_CI[b as usize];
                    b = b + 1;
                } else {
                    L_TMP[k as usize] = L_CI[a as usize];
                    a = a + 1;
                }
                k = k + 1;
            }
            lo = lo + w + w;
        }
        var c : u32 = 0;
        while (c < n) {
            L_CI[c as usize] = L_TMP[c as usize];
            c = c + 1;
        }
        w = w * 2;
    }
    S_GEN = S_GEN + 1;
    return 0;
}

pub var B_X0 : f64 = 0.0;
pub var B_Y0 : f64 = 0.0;
pub var B_X1 : f64 = 0.0;
pub var B_Y1 : f64 = 0.0;

fn bounds_add(x: f64, y: f64) -> u32 {
    B_X0 = js_min(B_X0, x);
    B_Y0 = js_min(B_Y0, y);
    B_X1 = js_max(B_X1, x);
    B_Y1 = js_max(B_Y1, y);
    return 0;
}

/// bounds(design) into B_*
fn bounds(design: bool) -> u32 {
    B_X0 = js_inf(0.0);
    B_Y0 = js_inf(0.0);
    B_X1 = 0.0 - js_inf(0.0);
    B_Y1 = 0.0 - js_inf(0.0);
    if (!design or R_NCOL == 0) {
        const gw : f64 = G_W as f64;
        const gh : f64 = G_H as f64;
        var c : u32 = 0;
        while (c < 4) {
            var cx : f64 = 0.0;
            var cy : f64 = 0.0;
            if (c == 1 or c == 3) { cx = gw; }
            if (c == 2 or c == 3) { cy = gh; }
            rot_pt(cx, cy);
            bounds_add(px_of(G_PX, G_PY), py_of(G_PX, G_PY, 0.0));
            c = c + 1;
        }
    }
    var i : u32 = 0;
    var hull : [12]f64 = [0.0; 12];
    while (i < R_NCOL) {
        hull_of(L_CI[i as usize], hull[0..]);
        var p : u32 = 0;
        while (p < 6) {
            bounds_add(hull[(p * 2) as usize], hull[(p * 2 + 1) as usize]);
            p = p + 1;
        }
        i = i + 1;
    }
    var pad : f64 = 2.0;
    if (design) { pad = 6.0; }
    B_X0 = B_X0 - pad;
    B_Y0 = B_Y0 - pad;
    B_X1 = B_X1 + pad;
    B_Y1 = B_Y1 + pad;
    return 0;
}

pub var F_S : f64 = 1.0;
pub var F_X : f64 = 0.0;
pub var F_Y : f64 = 0.0;

/// fitView(bounds, w, hgt) into F_*
fn fit_view(w: f64, hgt: f64) -> u32 {
    F_S = js_min(w / (B_X1 - B_X0), hgt / (B_Y1 - B_Y0));
    F_X = (B_X0 + B_X1) / 2.0 - w / F_S / 2.0;
    F_Y = (B_Y0 + B_Y1) / 2.0 - hgt / F_S / 2.0;
    return 0;
}

/// size(): the canvas gets the width of its box and a height that fits the window.
fn size_canvas() -> u32 {
    var bw : f64 = ENV_BW;
    if (bw == 0.0 or bw != bw) { bw = 600.0; }
    S_CSSW = bw;
    var maxh : f64 = 0.0;
    if (ENV_EMBED != 0) {
        maxh = js_max(180.0, ENV_IH - 200.0);
    } else {
        maxh = js_max(260.0, ENV_IH * 0.66);
    }
    S_CSSH = js_round(js_min(S_CSSW * 0.62, maxh));
    var dpr : f64 = ENV_DPR;
    if (dpr == 0.0 or dpr != dpr) { dpr = 1.0; }
    S_CANVAS_W = to_uint32(js_round(S_CSSW * dpr));
    S_CANVAS_H = to_uint32(js_round(S_CSSH * dpr));
    S_SIZED = true;
    return 0;
}

/// A DOM unsigned long from a double: truncated, modulo 2^32.
fn to_uint32(x: f64) -> u64 {
    if (x != x or x - x != 0.0) { return 0; }
    var t : f64 = js_floor(x);
    if (x < 0.0) { t = js_ceil(x); }
    if (t < 0.0) {
        const m : f64 = t - 4294967296.0 * js_floor(t / 4294967296.0);
        return m as u64;
    }
    const m2 : f64 = t - 4294967296.0 * js_floor(t / 4294967296.0);
    return m2 as u64;
}

/// fit(design)
fn fit(design: bool) -> u32 {
    if (!S_GRID) { return 0; }
    size_canvas();
    bounds(design);
    fit_view(S_CSSW, S_CSSH);
    S_VS = F_S;
    S_VX = F_X;
    S_VY = F_Y;
    S_DREW = true;
    return 0;
}

fn rotate_view() -> u32 {
    if (!S_GRID) { return 0; }
    S_ROT = (S_ROT + 1) % 4;
    layout();
    fit(false);
    return 0;
}

/// zoomAt(px, py, factor)
fn zoom_at(px: f64, py: f64, factor: f64) -> u32 {
    if (!S_GRID) { return 0; }
    const s : f64 = S_VS;
    const x : f64 = S_VX;
    const y : f64 = S_VY;
    bounds(false);
    fit_view(S_CSSW, S_CSSH);
    const base : f64 = F_S;
    const ns : f64 = js_min(js_max(s * factor, base * 0.6), base * (K_MAX_ZOOM as f64));
    const gx : f64 = x + px / s;
    const gy : f64 = y + py / s;
    S_VS = ns;
    S_VX = gx - px / ns;
    S_VY = gy - py / ns;
    S_DREW = true;
    return 0;
}

/// Math.hypot(a, b), V8's algorithm: the larger argument scales, a Kahan sum of the squares.
fn hypot2(a0: f64, b0: f64) -> f64 {
    var a : f64 = a0;
    var b : f64 = b0;
    if (a != a or b != b) {
        if (a - a != 0.0 and a == a) { return js_inf(0.0); }
        if (b - b != 0.0 and b == b) { return js_inf(0.0); }
        return js_nan(0.0);
    }
    if (a < 0.0) { a = 0.0 - a; }
    if (b < 0.0) { b = 0.0 - b; }
    var mx : f64 = 0.0;
    if (a > mx) { mx = a; }
    if (b > mx) { mx = b; }
    if (mx == js_inf(0.0)) { return mx; }
    if (mx == 0.0) { return 0.0; }
    var sum : f64 = 0.0;
    var comp : f64 = 0.0;
    var k : u32 = 0;
    while (k < 2) {
        var v : f64 = a;
        if (k == 1) { v = b; }
        const n : f64 = v / mx;
        const summand : f64 = n * n - comp;
        const prelim : f64 = sum + summand;
        comp = (prelim - sum) - summand;
        sum = prelim;
        k = k + 1;
    }
    return @sqrt(sum) * mx;
}

/// inside(pts, x, y) for a hull of six points in hull[0..12]
fn inside_hull(hull: []const f64, x: f64, y: f64) -> bool {
    var sign : f64 = 0.0;
    var i : u32 = 0;
    while (i < 6) {
        const j : u32 = (i + 1) % 6;
        const ax : f64 = hull[(i * 2) as usize];
        const ay : f64 = hull[(i * 2 + 1) as usize];
        const bx : f64 = hull[(j * 2) as usize];
        const by : f64 = hull[(j * 2 + 1) as usize];
        const c : f64 = (bx - ax) * (y - ay) - (by - ay) * (x - ax);
        if (c != 0.0) {
            var sg : f64 = 1.0;
            if (c < 0.0) { sg = 0.0 - 1.0; }
            if (c != c) { sg = c; }
            if (sign != 0.0 and sg != sign) { return false; }
            sign = sg;
        }
        i = i + 1;
    }
    return true;
}

pub var N_FOUND : bool = false;
pub var N_CI : u32 = 0;
pub var N_HULL : [12]f64 = [0.0; 12];

/// nearest(px, py): the column under the point, else the nearest top within half a touch target.
fn nearest(px: f64, py: f64) -> u32 {
    N_FOUND = false;
    const x : f64 = S_VX;
    const y : f64 = S_VY;
    const s : f64 = S_VS;
    const wx : f64 = px / s + x;
    const wy : f64 = py / s + y;
    var hull : [12]f64 = [0.0; 12];
    var i : u32 = R_NCOL;
    while (i > 0) {
        i = i - 1;
        const ci : u32 = L_CI[i as usize];
        hull_of(ci, hull[0..]);
        if (inside_hull(hull[0..], wx, wy)) {
            N_FOUND = true;
            N_CI = ci;
            var q : u32 = 0;
            while (q < 12) {
                N_HULL[q as usize] = hull[q as usize];
                q = q + 1;
            }
            return 0;
        }
    }
    var bd : f64 = (K_MIN_TARGET_PX as f64) / 2.0;
    var k : u32 = 0;
    while (k < R_NCOL) {
        const ci2 : u32 = L_CI[k as usize];
        hull_of(ci2, hull[0..]);
        const tx : f64 = hull[0];
        const ty : f64 = hull[1];
        const dd : f64 = hypot2((tx - x) * s - px, (ty - y) * s - py);
        if (dd < bd) {
            bd = dd;
            N_FOUND = true;
            N_CI = ci2;
            var q2 : u32 = 0;
            while (q2 < 12) {
                N_HULL[q2 as usize] = hull[q2 as usize];
                q2 = q2 + 1;
            }
        }
        k = k + 1;
    }
    return 0;
}

// --- the events -----------------------------------------------------------------------------------------------------------

fn pt_find(id: i64) -> i32 {
    var i : u32 = 0;
    while (i < PT_N) {
        if (PT_ID[i as usize] == id) { return i as i32; }
        i = i + 1;
    }
    return 0 - 1;
}

fn pt_remove(id: i64) -> u32 {
    const f : i32 = pt_find(id);
    if (f < 0) { return 0; }
    var i : u32 = f as u32;
    while (i + 1 < PT_N) {
        PT_ID[i as usize] = PT_ID[(i + 1) as usize];
        PT_X[i as usize] = PT_X[(i + 1) as usize];
        PT_Y[i as usize] = PT_Y[(i + 1) as usize];
        i = i + 1;
    }
    PT_N = PT_N - 1;
    return 0;
}

/// state.hover = the column found (or none); the info panel and the drawing follow.
fn set_hover() -> u32 {
    S_INFO = true;
    HV_ON = N_FOUND;
    HV_CI = N_CI;
    HV_GEN = S_GEN;
    var q : u32 = 0;
    while (q < 12) {
        HV_HULL[q as usize] = N_HULL[q as usize];
        q = q + 1;
    }
    S_DREW = true;
    return 0;
}

fn set_pick() -> u32 {
    S_INFO = true;
    PK_ON = N_FOUND;
    PK_CI = N_CI;
    PK_GEN = S_GEN;
    var q : u32 = 0;
    while (q < 12) {
        PK_HULL[q as usize] = N_HULL[q as usize];
        q = q + 1;
    }
    S_DREW = true;
    return 0;
}

/// A pointer on the canvas. kind 0 down, 1 move, 2 up, 3 cancel, 4 leave; x, y in the canvas's box.
pub fn w_cpointer(kind_of: u32, id: i64, x: f64, y: f64, mouse: u32) -> u32 {
    S_EF_N = 0;
    if (kind_of == 0) {
        const f : i32 = pt_find(id);
        if (f >= 0) {
            PT_X[f as usize] = x;
            PT_Y[f as usize] = y;
        } else {
            if (PT_N < 8) {
                PT_ID[PT_N as usize] = id;
                PT_X[PT_N as usize] = x;
                PT_Y[PT_N as usize] = y;
                PT_N = PT_N + 1;
            }
        }
        if (PT_N == 1) {
            DR_ON = true;
            DR_SX = x;
            DR_SY = y;
            DR_VX = S_VX;
            DR_VY = S_VY;
            DR_VS = S_VS;
            DR_MOVED = false;
        }
        if (PT_N == 2) {
            PI_ON = true;
            PI_D = hypot2(PT_X[0] - PT_X[1], PT_Y[0] - PT_Y[1]);
            PI_S = S_VS;
            DR_ON = false;
        }
        return 0;
    }
    if (kind_of == 1) {
        const f2 : i32 = pt_find(id);
        if (f2 >= 0) {
            PT_X[f2 as usize] = x;
            PT_Y[f2 as usize] = y;
        }
        if (PI_ON and PT_N == 2) {
            const mx : f64 = (PT_X[0] + PT_X[1]) / 2.0;
            const my : f64 = (PT_Y[0] + PT_Y[1]) / 2.0;
            zoom_at(mx, my, (PI_S * hypot2(PT_X[0] - PT_X[1], PT_Y[0] - PT_Y[1]) / PI_D) / S_VS);
            return 0;
        }
        if (DR_ON) {
            const dx : f64 = x - DR_SX;
            const dy : f64 = y - DR_SY;
            var ax : f64 = dx;
            if (ax < 0.0) { ax = 0.0 - ax; }
            var ay : f64 = dy;
            if (ay < 0.0) { ay = 0.0 - ay; }
            if (ax + ay > 4.0) { DR_MOVED = true; }
            if (DR_MOVED) {
                S_VS = DR_VS;
                S_VX = DR_VX - dx / DR_VS;
                S_VY = DR_VY - dy / DR_VS;
                S_DREW = true;
            }
            return 0;
        }
        if (mouse != 0) {
            nearest(x, y);
            var same : bool = false;
            if (!N_FOUND and !HV_ON) { same = true; }
            if (N_FOUND and HV_ON and N_CI == HV_CI and S_GEN == HV_GEN) { same = true; }
            if (!same) { set_hover(); }
        }
        return 0;
    }
    if (kind_of == 2) {
        if (DR_ON and !DR_MOVED) {
            nearest(x, y);
            set_pick();
        }
        pt_remove(id);
        if (PT_N < 2) { PI_ON = false; }
        if (PT_N == 0) { DR_ON = false; }
        return 0;
    }
    if (kind_of == 3) {
        pt_remove(id);
        PI_ON = false;
        DR_ON = false;
        return 0;
    }
    if (HV_ON) {
        HV_ON = false;
        S_INFO = true;
        S_DREW = true;
    }
    return 0;
}

/// The wheel over the canvas: zoomAt(x, y, Math.exp(-deltaY * (ctrl ? 0.01 : 0.0025))). 2: a libm call is missing.
pub fn w_wheel(x: f64, y: f64, dy: f64, ctrl: u32) -> u32 {
    S_EF_N = 0;
    MISSING = false;
    var k : f64 = 0.0025;
    if (ctrl != 0) { k = 0.01; }
    const arg : f64 = (0.0 - dy) * k;
    const f : f64 = libm(16, arg);
    if (MISSING) { return 2; }
    zoom_at(x, y, f);
    return 1;
}

pub fn w_key(key: []const u8) -> u32 {
    S_EF_N = 0;
    const step : f64 = 40.0 / S_VS;
    if (key.len == 1 and (key[0] == 43 or key[0] == 61)) {
        zoom_at(S_CSSW / 2.0, S_CSSH / 2.0, 1.4);
        return 1;
    }
    if (key.len == 1 and key[0] == 45) {
        zoom_at(S_CSSW / 2.0, S_CSSH / 2.0, 1.0 / 1.4);
        return 1;
    }
    if (key.len == 1 and (key[0] == 114 or key[0] == 82)) {
        rotate_view();
        return 1;
    }
    if (same_text(key, "ArrowLeft")) {
        S_VX = S_VX - step;
        S_DREW = true;
        return 1;
    }
    if (same_text(key, "ArrowRight")) {
        S_VX = S_VX + step;
        S_DREW = true;
        return 1;
    }
    if (same_text(key, "ArrowUp")) {
        S_VY = S_VY - step;
        S_DREW = true;
        return 1;
    }
    if (same_text(key, "ArrowDown")) {
        S_VY = S_VY + step;
        S_DREW = true;
        return 1;
    }
    return 0;
}

/// The ResizeObserver of the box around the canvas: 1 when the drawing changed.
pub fn w_box(w: f64, h: f64) -> u32 {
    S_EF_N = 0;
    if (!S_GRID or w == S_LASTW) { return 0; }
    const ow : f64 = S_CSSW;
    const oh : f64 = S_CSSH;
    const ovx : f64 = S_VX;
    const ovy : f64 = S_VY;
    const ovs : f64 = S_VS;
    S_LASTW = w;
    size_canvas();
    if (ow != 0.0 and ow == ow) {
        const cx : f64 = ovx + ow / ovs / 2.0;
        const cy : f64 = ovy + oh / ovs / 2.0;
        const s : f64 = ovs * S_CSSW / ow;
        S_VS = s;
        S_VX = cx - S_CSSW / s / 2.0;
        S_VY = cy - S_CSSH / s / 2.0;
    }
    S_DREW = true;
    return 1;
}

pub fn w_click(i: u32) -> u32 {
    S_EF_N = 0;
    const ns : u32 = SAY_SAMPLES.len as u32;
    if (i < ns) {
        show_sample(i);
        return 0;
    }
    if (i == ns) { fit(false); }
    if (i == ns + 1) { fit(true); }
    if (i == ns + 2) { rotate_view(); }
    if (i == ns + 3 and S_HAVE) {
        S_SAVE_N = save_name(W_PNG_SUFFIX);
        push_effect(80);
    }
    if (i == ns + 4 and S_HAVE) {
        S_SAVE_N = save_name(W_STL_SUFFIX);
        push_effect(68);
    }
    return 0;
}

fn push_effect(k: u8) -> u32 {
    if (S_EF_N < 4) {
        S_EF[S_EF_N as usize] = k;
        S_EF_N = S_EF_N + 1;
    }
    return 0;
}

/// stem() + suffix into S_SAVE: String(label || ID).replace(/\.[^.]*$/, '').replace(/[^A-Za-z0-9_-]+/g, '-')
fn save_name(suffix: []const u8) -> u32 {
    var src : bool = true;
    if (S_LABEL_N == 0) { src = false; }
    var n : u32 = 0;
    var run : bool = false;
    var k : u32 = 0;
    var end : u32 = 0;
    // the label (or the id) without its last extension
    var buf : [4096]u8 = [0; 4096];
    var bl : u32 = 0;
    if (src) { bl = copy_into(buf[0..], 0, S_LABEL[0..(S_LABEL_N as usize)]); } else { bl = copy_into(buf[0..], 0, ID); }
    end = bl;
    var dot : i32 = 0 - 1;
    k = 0;
    while (k < bl) {
        if (buf[k as usize] == 46) { dot = k as i32; }
        k = k + 1;
    }
    if (dot >= 0) {
        // \.[^.]*$ : from the last dot to the end, when no dot follows it
        end = dot as u32;
    }
    k = 0;
    while (k < end) {
        const b : u8 = buf[k as usize];
        var okc : bool = false;
        if (b >= 65 and b <= 90) { okc = true; }
        if (b >= 97 and b <= 122) { okc = true; }
        if (b >= 48 and b <= 57) { okc = true; }
        if (b == 95 or b == 45) { okc = true; }
        if (okc) {
            if (n < 3000) { S_SAVE[n as usize] = b; n = n + 1; }
            run = false;
        } else {
            if (!run and n < 3000) { S_SAVE[n as usize] = 45; n = n + 1; }
            run = true;
        }
        k = k + 1;
    }
    n = copy_into(S_SAVE[0..], n, suffix);
    return n;
}

pub fn w_drag(kind_of: u32) -> u32 {
    S_EF_N = 0;
    const was : bool = S_OVER;
    S_OVER = kind_of == 0;
    if (was != S_OVER) { return 1; }
    return 0;
}

/// A file picked or dropped: takeFile(file). text is the file as the host decoded it.
pub fn w_file(name: []const u8, size: f64, data: []const u8, st: u32) -> u32 {
    S_EF_N = 0;
    S_CLR_FILE = true;
    S_FNAME_N = copy_into(S_FNAME[0..], 0, name);
    if (!S_GRID) { return 0; }
    arg_text(0, name);
    if (size > (K_MAX_FILE_MB as f64) * 1048576.0) {
        arg_num(1, K_MAX_FILE_MB as f64);
        status_fmt(SAY_ERR_SIZE, 2);
        return 0;
    }
    status_fmt(SAY_READING, 1);
    if (st != 0 or size > (W_FILE_CAP as f64)) {
        status_fmt(SAY_ERR_READ, 1);
        return 0;
    }
    tiles_reset();
    if (parse_fasm(data) != 0) {
        status_fmt(SAY_ERR_READ, 1);
        return 0;
    }
    if (V[V_FEAT] == 0) {
        status_fmt(SAY_ERR_EMPTY, 1);
        return 0;
    }
    S_PRESSED = 0 - 1;
    // the chip line: the first header comment that starts with "chipdb "
    var chip : u32 = 0;
    var chipo : u32 = 0;
    var found : bool = false;
    var h : u32 = 0;
    while (h < (V[V_NH] as u32) and !found) {
        const ho : u32 = HDRO[h as usize];
        const hl : u32 = HDRL[h as usize];
        if (pool_is_prefix(ho, hl, "chipdb ")) {
            found = true;
            chipo = ho;
            chip = hl;
        }
        h = h + 1;
    }
    arg_text(0, name);
    arg_loc(1, size);
    if (found) { arg_set(2, POOL[0..], chipo as usize, (chipo + chip) as usize); } else { arg_set(2, POOL[0..], 0, 0); }
    const sl : i64 = fmt_into(S_SRC[0..], SAY_SOURCE_FILE, 3);
    S_SRC_N = 0;
    if (sl >= 0) { S_SRC_N = sl as u32; }
    S_NOTE_N = 0;
    S_CMDN = 0;
    S_LABEL_N = copy_into(S_LABEL[0..], 0, name);
    // the lines that are not features
    S_BADN = V[V_NB] as u32;
    var b : u32 = 0;
    var bp : u32 = 0;
    while (b < S_BADN and b < 100) {
        S_BADO[b as usize] = bp;
        var l : u32 = BADL[b as usize];
        if (l > 2000) { l = 2000; }
        var q : u32 = 0;
        while (q < l) {
            S_BADTXT[(bp + q) as usize] = POOL[(BADO[b as usize] + q) as usize];
            q = q + 1;
        }
        S_BADL[b as usize] = l;
        bp = bp + l;
        b = b + 1;
    }
    return load_design();
}

fn pool_is_prefix(o: u32, l: u32, w: []const u8) -> bool {
    if ((l as usize) < w.len) { return false; }
    var k : usize = 0;
    while (k < w.len) {
        if (POOL[(o as usize) + k] != w[k]) { return false; }
        k = k + 1;
    }
    return true;
}

pub fn w_value(i: u32, dst: []u8) -> u32 {
    if (i == 0 and S_CLR_FILE) {
        S_CLR_FILE = false;
        return 0;
    }
    return 4294967295;
}

// --- the libm service ---------------------------------------------------------------------------------------------

fn libm(op: u32, a: f64) -> f64 {
    var i : u32 = 0;
    while (i < LB_N) {
        if ((LB_OP[i as usize] as u32) == op and LB_A[i as usize] == a) { return LB_R[i as usize]; }
        i = i + 1;
    }
    MISSING = true;
    var j : u32 = 0;
    while (j < RQ_N) {
        if ((RQ_OP[j as usize] as u32) == op and RQ_A[j as usize] == a) { return 0.0; }
        j = j + 1;
    }
    if (RQ_N < 64) {
        RQ_OP[RQ_N as usize] = op as u8;
        RQ_A[RQ_N as usize] = a;
        RQ_N = RQ_N + 1;
    }
    return 0.0;
}

pub fn w_libm_need(dst: []f64) -> u32 {
    if (RQ_N == 0) { return 0; }
    var k : u32 = 0;
    while (k < RQ_N and ((k * 3 + 2) as usize) < dst.len) {
        dst[(k * 3) as usize] = RQ_OP[k as usize] as f64;
        dst[(k * 3 + 1) as usize] = RQ_A[k as usize];
        dst[(k * 3 + 2) as usize] = 0.0;
        k = k + 1;
    }
    RQ_SENT = k;
    return k;
}

pub fn w_libm_give(src: []const f64, n: u32) -> u32 {
    var k : u32 = 0;
    while (k < n and k < RQ_SENT and (k as usize) < src.len) {
        if (LB_N >= 64) { LB_N = 0; }
        LB_OP[LB_N as usize] = RQ_OP[k as usize];
        LB_A[LB_N as usize] = RQ_A[k as usize];
        LB_R[LB_N as usize] = src[k as usize];
        LB_N = LB_N + 1;
        k = k + 1;
    }
    RQ_N = 0;
    RQ_SENT = 0;
    MISSING = false;
    return 0;
}

// --- the page --------------------------------------------------------------------------------------------------

fn put_locale(dst: []u8, n0: u32, x: f64) -> u32 {
    return js_locale_num(dst, n0, x);
}

fn put_col_name(dst: []u8, n0: u32, ci: u32) -> u32 {
    return text(dst, n0, R_NPOOL[(R_CNO[ci as usize] as usize)..((R_CNO[ci as usize] + R_CNL[ci as usize]) as usize)]);
}

/// "background:" and the colour of family f, as tool.js writes the style attribute (undefined for no family)
fn put_swatch(dst: []u8, n0: u32, fam: i32) -> u32 {
    var n : u32 = raw(dst, n0, "<i style=\"background:");
    if (fam >= 0 and (fam as usize) < K_FAMILY_COLORS.len) { n = text(dst, n, K_FAMILY_COLORS[fam as usize]); } else { n = raw(dst, n, "undefined"); }
    return raw(dst, n, "\"></i>");
}

fn put_info(dst: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    var on : bool = PK_ON;
    var ci : u32 = PK_CI;
    if (!PK_ON) {
        on = HV_ON;
        ci = HV_CI;
    }
    if (!on) {
        n = raw(dst, n, "<p class=\"fs-muted\">");
        n = text(dst, n, SAY_PICK_NONE);
        return raw(dst, n, "</p>");
    }
    n = raw(dst, n, "<table><tbody>");
    var i : usize = 0;
    while (i < SAY_PICK_FIELDS.len) {
        n = raw(dst, n, "<tr><th>");
        n = text(dst, n, SAY_PICK_FIELDS[i]);
        n = raw(dst, n, "</th><td>");
        if (i == 0) {
            n = put_swatch(dst, n, R_CFAM[ci as usize]);
            n = put_col_name(dst, n, ci);
        }
        if (i == 1) {
            n = text(dst, n, R_NPOOL[(R_CNO[ci as usize] as usize)..((R_CNO[ci as usize] + R_CTL[ci as usize]) as usize)]);
        }
        if (i == 2) {
            const f : i32 = R_CFAM[ci as usize];
            if (f >= 0 and (f as usize) < SAY_FAMILY_NAMES.len) {
                n = text(dst, n, SAY_FAMILY_NAMES[f as usize]);
            } else {
                if (f >= 0 and (f as usize) < K_FAMILIES.len) { n = text(dst, n, K_FAMILIES[f as usize]); }
            }
        }
        if (i == 3) { n = put_locale(dst, n, R_CN[ci as usize] as f64); }
        if (i == 4) {
            n = num(dst, n, R_CGX[ci as usize] as u64);
            n = raw(dst, n, ", ");
            n = num(dst, n, R_CGY[ci as usize] as u64);
        }
        n = raw(dst, n, "</td></tr>");
        i = i + 1;
    }
    return raw(dst, n, "</tbody></table>");
}

fn put_stats(dst: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    n = raw(dst, n, "<div><dt>");
    n = text(dst, n, SAY_STAT_LABELS[0]);
    n = raw(dst, n, "</dt><dd>");
    n = put_locale(dst, n, R_NCOL as f64);
    n = raw(dst, n, "</dd></div><div><dt>");
    n = text(dst, n, SAY_STAT_LABELS[1]);
    n = raw(dst, n, "</dt><dd>");
    n = put_locale(dst, n, R_PLACED as f64);
    n = raw(dst, n, "</dd></div><div><dt>");
    n = text(dst, n, SAY_STAT_LABELS[2]);
    n = raw(dst, n, "</dt><dd class=\"fs-tile\">");
    if (R_TALL >= 0) {
        n = put_col_name(dst, n, R_TALL as u32);
        arg_loc(0, tallest_n());
        n = raw(dst, n, "<small>");
        n = put_say(dst, n, SAY_STAT_TALLEST, 1);
        n = raw(dst, n, "</small>");
    } else {
        n = raw(dst, n, "-");
    }
    n = raw(dst, n, "</dd></div><div><dt>");
    n = text(dst, n, SAY_STAT_LABELS[3]);
    n = raw(dst, n, "</dt><dd>");
    n = pct_into(dst, n, R_NCOL as f64, K_CONFIG_TILES as f64);
    n = raw(dst, n, "%<small>");
    arg_loc(0, R_NCOL as f64);
    arg_loc(1, K_CONFIG_TILES as f64);
    n = put_say(dst, n, SAY_STAT_SHARE, 2);
    return raw(dst, n, "</small></dd></div>");
}

fn put_fams(dst: []u8, n0: u32) -> u32 {
    var n : u32 = raw(dst, n0, "<thead><tr>");
    var h : usize = 0;
    while (h < SAY_FAMILY_HEAD.len) {
        n = raw(dst, n, "<th>");
        n = text(dst, n, SAY_FAMILY_HEAD[h]);
        n = raw(dst, n, "</th>");
        h = h + 1;
    }
    n = raw(dst, n, "</tr></thead><tbody>");
    var i : usize = 0;
    while (i < K_FAMILIES.len) {
        n = raw(dst, n, "<tr class=\"");
        if (R_FAMT[i] == 0) { n = raw(dst, n, "is-zero"); }
        n = raw(dst, n, "\"><td>");
        n = put_swatch(dst, n, i as i32);
        if (i < SAY_FAMILY_NAMES.len) { n = text(dst, n, SAY_FAMILY_NAMES[i]); } else { n = text(dst, n, K_FAMILIES[i]); }
        n = raw(dst, n, "</td><td>");
        arg_loc(0, R_FAMT[i] as f64);
        var cfg : f64 = 0.0;
        if (i < K_CONFIG_FAMILY_TILES.len) { cfg = K_CONFIG_FAMILY_TILES[i] as f64; }
        arg_loc(1, cfg);
        n = put_say(dst, n, SAY_OF, 2);
        n = raw(dst, n, "</td><td>");
        n = put_locale(dst, n, R_FAMF[i] as f64);
        n = raw(dst, n, "</td></tr>");
        i = i + 1;
    }
    return raw(dst, n, "</tbody>");
}

fn put_source(dst: []u8, n0: u32) -> u32 {
    var n : u32 = raw(dst, n0, "<span>");
    n = text(dst, n, S_SRC[0..(S_SRC_N as usize)]);
    n = raw(dst, n, "</span>");
    if (S_NOTE_N > 0) {
        n = raw(dst, n, "<span class=\"fs-note\">");
        n = text(dst, n, S_NOTE[0..(S_NOTE_N as usize)]);
        n = raw(dst, n, "</span>");
    }
    if (S_CLEARED != 0) {
        n = raw(dst, n, "<span class=\"fs-note\">");
        arg_loc(0, S_CLEARED as f64);
        n = put_say(dst, n, SAY_CLEARED, 1);
        n = raw(dst, n, "</span>");
    }
    n = raw(dst, n, "<span class=\"fs-note\">");
    arg_loc(0, tallest_n());
    arg_num(1, G_W as f64);
    arg_num(2, G_H as f64);
    n = put_say(dst, n, SAY_SCALE, 3);
    return raw(dst, n, "</span>");
}

fn put_details(dst: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    // off the map
    n = raw(dst, n, "<details class=\"fs-more\"");
    if (!S_HAVE) {
        n = raw(dst, n, "></details>");
    } else {
        if (R_NOFF == 0) { n = raw(dst, n, " hidden=\"\""); }
        n = raw(dst, n, "><summary>");
        arg_loc(0, R_NOFF as f64);
        arg_loc(1, (R_FEAT as f64) - (R_PLACED as f64));
        n = put_say(dst, n, SAY_OFF_MAP, 2);
        n = raw(dst, n, "</summary><ul>");
        var j : u32 = 0;
        while (j < R_NOFF and j < 300) {
            n = raw(dst, n, "<li>");
            n = text(dst, n, R_NPOOL[(R_OFFNO[j as usize] as usize)..((R_OFFNO[j as usize] + R_OFFNL[j as usize]) as usize)]);
            n = raw(dst, n, "  ");
            n = num(dst, n, R_OFFN[j as usize] as u64);
            n = raw(dst, n, "</li>");
            j = j + 1;
        }
        n = raw(dst, n, "</ul></details>");
    }
    // lines that are not features
    n = raw(dst, n, "<details class=\"fs-more\"");
    if (!S_HAVE) {
        n = raw(dst, n, "></details>");
    } else {
        if (S_BADN == 0) { n = raw(dst, n, " hidden=\"\""); }
        n = raw(dst, n, "><summary>");
        arg_loc(0, S_BADN as f64);
        n = put_say(dst, n, SAY_BAD_LINES, 1);
        n = raw(dst, n, "</summary><ul>");
        var b : u32 = 0;
        while (b < S_BADN and b < 100) {
            n = raw(dst, n, "<li>");
            n = text(dst, n, S_BADTXT[(S_BADO[b as usize] as usize)..((S_BADO[b as usize] + S_BADL[b as usize]) as usize)]);
            n = raw(dst, n, "</li>");
            b = b + 1;
        }
        n = raw(dst, n, "</ul></details>");
    }
    // how the sample was made
    n = raw(dst, n, "<details class=\"fs-more\"");
    if (!S_HAVE) {
        n = raw(dst, n, "></details>");
    } else {
        if (S_CMDN == 0) { n = raw(dst, n, " hidden=\"\""); }
        n = raw(dst, n, "><summary>");
        n = text(dst, n, SAY_HOW);
        n = raw(dst, n, "</summary><ul>");
        var c : u32 = 0;
        while (c < S_CMDN) {
            n = raw(dst, n, "<li><code>");
            n = text(dst, n, S_CMD[(S_CMDO[c as usize] as usize)..((S_CMDO[c as usize] + S_CMDL[c as usize]) as usize)]);
            n = raw(dst, n, "</code></li>");
            c = c + 1;
        }
        n = raw(dst, n, "</ul></details>");
    }
    return n;
}

pub fn w_render(dst: []u8) -> u32 {
    var n : u32 = raw(dst, 0, "<div class=\"fs-bar\">");
    var i : usize = 0;
    while (i < SAY_SAMPLES.len) {
        n = raw(dst, n, "<button class=\"t27-btn\" type=\"button\" aria-pressed=\"");
        if (S_PRESSED == (i as i32)) { n = raw(dst, n, "true"); } else { n = raw(dst, n, "false"); }
        n = raw(dst, n, "\">");
        n = text(dst, n, SAY_SAMPLES[i]);
        n = raw(dst, n, "</button>");
        i = i + 1;
    }
    n = raw(dst, n, "</div><div class=\"fs-bar\">");
    n = button(dst, n, SAY_WHOLE_DIE);
    n = button(dst, n, SAY_FIT_DESIGN);
    n = button(dst, n, SAY_ROTATE);
    n = button(dst, n, SAY_DOWNLOAD_PNG);
    n = button(dst, n, SAY_DOWNLOAD_STL);
    n = raw(dst, n, "</div><p class=\"fs-status\" role=\"status\">");
    n = text(dst, n, S_STATUS[0..(S_STATUS_N as usize)]);
    n = raw(dst, n, "</p><div class=\"fs-wrap\"><canvas class=\"fs-canvas\" role=\"img\" tabindex=\"0\" aria-label=\"");
    n = text(dst, n, SAY_CANVAS_LABEL);
    n = raw(dst, n, "\"");
    if (S_SIZED) {
        n = raw(dst, n, " width=\"");
        n = num(dst, n, S_CANVAS_W);
        n = raw(dst, n, "\" height=\"");
        n = num(dst, n, S_CANVAS_H);
        n = raw(dst, n, "\" style=\"height: ");
        n = put_css_px(dst, n, S_CSSH);
        n = raw(dst, n, ";\"");
    }
    n = raw(dst, n, "></canvas></div><p class=\"fs-hint\">");
    n = text(dst, n, SAY_HINT);
    n = raw(dst, n, "</p><dl class=\"fs-stats\">");
    if (S_HAVE) { n = put_stats(dst, n); }
    n = raw(dst, n, "</dl><div class=\"fs-side\"><table class=\"fs-fams\">");
    if (S_HAVE) { n = put_fams(dst, n); }
    n = raw(dst, n, "</table><div class=\"fs-info\" aria-live=\"polite\">");
    if (S_HAVE or S_INFO) { n = put_info(dst, n); }
    n = raw(dst, n, "</div></div><p class=\"fs-source\">");
    if (S_HAVE) { n = put_source(dst, n); }
    n = raw(dst, n, "</p><label class=\"t27-drop fs-drop");
    if (S_OVER) { n = raw(dst, n, " is-over"); }
    n = raw(dst, n, "\"><input type=\"file\" accept=\"");
    n = text(dst, n, W_ACCEPT);
    n = raw(dst, n, "\" class=\"fs-file\"><span>");
    n = text(dst, n, SAY_DROP);
    n = raw(dst, n, "</span></label><p class=\"fs-share\">");
    n = text(dst, n, SAY_SHARE_NOTE);
    n = raw(dst, n, "</p>");
    n = put_details(dst, n);
    if (!ok(n)) { return 0; }
    return n;
}

fn button(dst: []u8, n0: u32, label: []const u8) -> u32 {
    var n : u32 = raw(dst, n0, "<button class=\"t27-btn\" type=\"button\">");
    n = text(dst, n, label);
    return raw(dst, n, "</button>");
}

/// A CSS length in px as the style serialisation writes it: 273px, 12.5px.
fn put_css_px(dst: []u8, n0: u32, x: f64) -> u32 {
    const e : u32 = js_str_num(S_NUM3[0..], 0, x);
    var n : u32 = raw(dst, n0, S_NUM3[0..(e as usize)]);
    return raw(dst, n, "px");
}

// --- the binary draw list --------------------------------------------------------------------------------------------

fn bw_b(o: []u8, n: u32, b: u8) -> u32 {
    if (n == OVER or (n as usize) >= o.len) { return OVER; }
    o[n as usize] = b;
    return n + 1;
}

/// The IEEE 754 bits of a finite double (no subnormals, no NaN).
fn f64_bits(x: f64) -> u64 {
    if (x == 0.0) {
        if ((1.0 / x) < 0.0) { return 9223372036854775808; }
        return 0;
    }
    var sign : u64 = 0;
    var ax : f64 = x;
    if (x < 0.0) {
        sign = 9223372036854775808;
        ax = 0.0 - x;
    }
    if (x != x) { return 9221120237041090560; }
    if (ax - ax != 0.0) { return sign + 9218868437227405312; }
    const m : u64 = jn_mant(ax);
    const e : i32 = jn_expo(ax);
    const be : u64 = ((e + 52 + 1023) as u64);
    return sign + be * 4503599627370496 + (m - 4503599627370496);
}

fn bw_f(o: []u8, n0: u32, x: f64) -> u32 {
    var bits : u64 = f64_bits(x);
    var n : u32 = n0;
    var k : u32 = 0;
    while (k < 8) {
        n = bw_b(o, n, (bits % 256) as u8);
        bits = bits / 256;
        k = k + 1;
    }
    return n;
}

fn bw_s(o: []u8, n0: u32, s: []const u8) -> u32 {
    var n : u32 = bw_b(o, n0, (s.len % 256) as u8);
    n = bw_b(o, n, ((s.len / 256) % 256) as u8);
    var k : usize = 0;
    while (k < s.len) {
        n = bw_b(o, n, s[k]);
        k = k + 1;
    }
    return n;
}

fn bw_move(o: []u8, n0: u32, x: f64, y: f64) -> u32 {
    var n : u32 = bw_b(o, n0, 7);
    n = bw_f(o, n, x);
    return bw_f(o, n, y);
}

fn bw_line(o: []u8, n0: u32, x: f64, y: f64) -> u32 {
    var n : u32 = bw_b(o, n0, 8);
    n = bw_f(o, n, x);
    return bw_f(o, n, y);
}

fn bw_rect(o: []u8, n0: u32, op: u8, a: f64, b: f64, c: f64, d: f64) -> u32 {
    var n : u32 = bw_b(o, n0, op);
    n = bw_f(o, n, a);
    n = bw_f(o, n, b);
    n = bw_f(o, n, c);
    return bw_f(o, n, d);
}

fn bw_set_s(o: []u8, n0: u32, op: u8, s: []const u8) -> u32 {
    const n : u32 = bw_b(o, n0, op);
    return bw_s(o, n, s);
}

/// parseInt(hex.slice(1), 16): the leading hex digits after the first character.
fn hex_value(s: []const u8) -> u64 {
    var v : u64 = 0;
    var i : usize = 1;
    var go : bool = true;
    while (i < s.len and go) {
        const b : u8 = s[i];
        var d : i32 = 0 - 1;
        if (b >= 48 and b <= 57) { d = (b - 48) as i32; }
        if (b >= 97 and b <= 102) { d = (b - 87) as i32; }
        if (b >= 65 and b <= 70) { d = (b - 55) as i32; }
        if (d < 0) {
            go = false;
        } else {
            if (v < 1000000000000) { v = v * 16 + (d as u64); }
            i = i + 1;
        }
    }
    return v;
}

pub var S_SH : [64]u8 = [0; 64];

/// shade(hex, f) into S_SH: rgb(r,g,b); the length.
fn shade_into(hex: []const u8, f: f64) -> u32 {
    const nv : u64 = hex_value(hex);
    // n >> 16 & 255 etc. on a 32 bit integer
    const n32 : u64 = nv % 4294967296;
    var n : u32 = copy_into(S_SH[0..], 0, "rgb(");
    var c : u32 = 0;
    while (c < 3) {
        var sh : u64 = 1;
        if (c == 0) { sh = 65536; }
        if (c == 1) { sh = 256; }
        const comp : u64 = (n32 / sh) % 256;
        const v : f64 = js_round((comp as f64) * f);
        n = js_str_num(S_SH[0..], n, v);
        if (c < 2) { n = copy_into(S_SH[0..], n, ","); }
        c = c + 1;
    }
    return copy_into(S_SH[0..], n, ")");
}

/// poly(ctx, pts, X, Y): beginPath, moveTo, lineTo, closePath for points given by (u, v, z) triples of columns.
pub var D_VX : f64 = 0.0;
pub var D_VY : f64 = 0.0;
pub var D_VS : f64 = 1.0;

fn dx(x: f64) -> f64 {
    return (x - D_VX) * D_VS;
}

fn dy(y: f64) -> f64 {
    return (y - D_VY) * D_VS;
}

/// One point (x, y) of the pts into the path: first = moveTo, else lineTo.
fn path_pt(o: []u8, n: u32, first: bool, x: f64, y: f64) -> u32 {
    if (first) { return bw_move(o, n, dx(x), dy(y)); }
    return bw_line(o, n, dx(x), dy(y));
}

/// The hull of an old pick or hover, a polygon of six points in h[0..12].
fn poly_hull(o: []u8, n0: u32, h: []const f64) -> u32 {
    var n : u32 = bw_b(o, n0, 1);
    var i : u32 = 0;
    while (i < 6) {
        n = path_pt(o, n, i == 0, h[(i * 2) as usize], h[(i * 2 + 1) as usize]);
        i = i + 1;
    }
    return bw_b(o, n, 2);
}

fn col_hex(fam: i32) -> []const u8 {
    if (fam >= 0 and (fam as usize) < K_FAMILY_COLORS.len) { return K_FAMILY_COLORS[fam as usize]; }
    return W_COL_DEFAULT;
}

/// render(ctx, w, hgt, view): the die floor and the columns, far to near.
fn render_ops(o: []u8, n0: u32, w: f64, hgt: f64, vx: f64, vy: f64, vs: f64) -> u32 {
    D_VX = vx;
    D_VY = vy;
    D_VS = vs;
    var n : u32 = bw_set_s(o, n0, 32, W_PNG_BLACK);
    n = bw_rect(o, n, 10, 0.0, 0.0, w, hgt);
    if (!S_GRID) { return n; }
    var r : u32 = 0;
    while (r < RUN_N) {
        const f : i32 = RUN_F[r as usize];
        const gx : f64 = RUN_GX[r as usize] as f64;
        const top : f64 = RUN_TOP[r as usize] as f64;
        const bot : f64 = RUN_BOT[r as usize] as f64;
        if (f >= 0 and (f as usize) < K_FLOOR_COLORS.len) { n = bw_set_s(o, n, 32, K_FLOOR_COLORS[f as usize]); } else { n = bw_set_s(o, n, 32, W_FLOOR_DEFAULT); }
        n = bw_b(o, n, 1);
        rot_pt(gx, top);
        n = path_pt(o, n, true, px_of(G_PX, G_PY), py_of(G_PX, G_PY, 0.0));
        rot_pt(gx + 1.0, top);
        n = path_pt(o, n, false, px_of(G_PX, G_PY), py_of(G_PX, G_PY, 0.0));
        rot_pt(gx + 1.0, bot + 1.0);
        n = path_pt(o, n, false, px_of(G_PX, G_PY), py_of(G_PX, G_PY, 0.0));
        rot_pt(gx, bot + 1.0);
        n = path_pt(o, n, false, px_of(G_PX, G_PY), py_of(G_PX, G_PY, 0.0));
        n = bw_b(o, n, 2);
        n = bw_b(o, n, 3);
        r = r + 1;
    }
    const edge : bool = vs > 6.0;
    var i : u32 = 0;
    var hull : [12]f64 = [0.0; 12];
    while (i < R_NCOL) {
        const ci : u32 = L_CI[i as usize];
        cell_uv(R_CGX[ci as usize] as f64, R_CGY[ci as usize] as f64);
        const u : f64 = G_U;
        const v : f64 = G_V;
        const z : f64 = (R_CN[ci as usize] as f64) * S_HK;
        const hex : []const u8 = col_hex(R_CFAM[ci as usize]);
        // left face
        var sl : u32 = shade_into(hex, 0.55);
        n = bw_set_s(o, n, 32, S_SH[0..(sl as usize)]);
        n = bw_b(o, n, 1);
        n = path_pt(o, n, true, px_of(u, v + 1.0), py_of(u, v + 1.0, z));
        n = path_pt(o, n, false, px_of(u + 1.0, v + 1.0), py_of(u + 1.0, v + 1.0, z));
        n = path_pt(o, n, false, px_of(u + 1.0, v + 1.0), py_of(u + 1.0, v + 1.0, 0.0));
        n = path_pt(o, n, false, px_of(u, v + 1.0), py_of(u, v + 1.0, 0.0));
        n = bw_b(o, n, 2);
        n = bw_b(o, n, 3);
        // right face
        sl = shade_into(hex, 0.38);
        n = bw_set_s(o, n, 32, S_SH[0..(sl as usize)]);
        n = bw_b(o, n, 1);
        n = path_pt(o, n, true, px_of(u + 1.0, v), py_of(u + 1.0, v, z));
        n = path_pt(o, n, false, px_of(u + 1.0, v + 1.0), py_of(u + 1.0, v + 1.0, z));
        n = path_pt(o, n, false, px_of(u + 1.0, v + 1.0), py_of(u + 1.0, v + 1.0, 0.0));
        n = path_pt(o, n, false, px_of(u + 1.0, v), py_of(u + 1.0, v, 0.0));
        n = bw_b(o, n, 2);
        n = bw_b(o, n, 3);
        // top
        n = bw_set_s(o, n, 32, hex);
        n = bw_b(o, n, 1);
        n = path_pt(o, n, true, px_of(u, v), py_of(u, v, z));
        n = path_pt(o, n, false, px_of(u + 1.0, v), py_of(u + 1.0, v, z));
        n = path_pt(o, n, false, px_of(u + 1.0, v + 1.0), py_of(u + 1.0, v + 1.0, z));
        n = path_pt(o, n, false, px_of(u, v + 1.0), py_of(u, v + 1.0, z));
        n = bw_b(o, n, 2);
        n = bw_b(o, n, 3);
        if (edge) {
            n = bw_set_s(o, n, 33, W_EDGE_STROKE);
            n = bw_b(o, n, 34);
            n = bw_f(o, n, 1.0);
            hull_of(ci, hull[0..]);
            n = poly_hull(o, n, hull[0..]);
            n = bw_b(o, n, 4);
        }
        i = i + 1;
    }
    if (HV_ON) {
        n = bw_set_s(o, n, 33, W_HOVER_COLOR);
        n = bw_b(o, n, 34);
        n = bw_f(o, n, 2.0);
        n = poly_hull(o, n, HV_HULL[0..]);
        n = bw_b(o, n, 4);
    }
    if (PK_ON) {
        n = bw_set_s(o, n, 33, W_PICK_COLOR);
        n = bw_b(o, n, 34);
        n = bw_f(o, n, 2.0);
        n = poly_hull(o, n, PK_HULL[0..]);
        n = bw_b(o, n, 4);
    }
    return n;
}

pub const W_EDGE_STROKE : str = "rgba(0,0,0,0.5)";

/// draw(): the drawing on the page's canvas.
pub fn w_bdraw(o: []u8) -> u32 {
    if (!S_DREW) { return 0; }
    var n : u32 = bw_b(o, 0, 200);
    n = bw_b(o, n, 0);
    var dpr : f64 = ENV_DPR;
    if (dpr == 0.0 or dpr != dpr) { dpr = 1.0; }
    n = bw_b(o, n, 12);
    n = bw_f(o, n, dpr);
    n = bw_f(o, n, 0.0);
    n = bw_f(o, n, 0.0);
    n = bw_f(o, n, dpr);
    n = bw_f(o, n, 0.0);
    n = bw_f(o, n, 0.0);
    n = render_ops(o, n, S_CSSW, S_CSSH, S_VX, S_VY, S_VS);
    if (n == OVER) { return 0; }
    return n;
}

// --- the text width service, keyed by the whole font string -------------------------------------------------------------------

fn x_same(i: u32, font: []const u8, s: []const u8) -> bool {
    if ((X_FL[i as usize] as usize) != font.len or (X_TL[i as usize] as usize) != s.len) { return false; }
    var k : usize = 0;
    const fo : usize = X_FO[i as usize] as usize;
    while (k < font.len) {
        if (X_POOL[fo + k] != font[k]) { return false; }
        k = k + 1;
    }
    k = 0;
    const to : usize = X_TO[i as usize] as usize;
    while (k < s.len) {
        if (X_POOL[to + k] != s[k]) { return false; }
        k = k + 1;
    }
    return true;
}

fn x_find(font: []const u8, s: []const u8) -> i32 {
    var i : u32 = 0;
    while (i < X_N) {
        if (x_same(i, font, s)) { return i as i32; }
        i = i + 1;
    }
    return 0 - 1;
}

fn x_ask(font: []const u8, s: []const u8) -> u32 {
    if (x_find(font, s) >= 0) { return 0; }
    if (X_N >= 4096 or (X_PN as usize) + s.len + font.len > 524288) {
        X_N = 0;
        X_PN = 0;
    }
    if (s.len > 8192 or font.len > 256) { return 0; }
    const i : usize = X_N as usize;
    X_FO[i] = X_PN;
    X_FL[i] = font.len as u32;
    var k : usize = 0;
    while (k < font.len) {
        X_POOL[(X_PN as usize) + k] = font[k];
        k = k + 1;
    }
    X_PN = X_PN + (font.len as u32);
    X_TO[i] = X_PN;
    X_TL[i] = s.len as u32;
    k = 0;
    while (k < s.len) {
        X_POOL[(X_PN as usize) + k] = s[k];
        k = k + 1;
    }
    X_PN = X_PN + (s.len as u32);
    X_ST[i] = 0;
    X_W[i] = 0.0;
    X_N = X_N + 1;
    return 1;
}

fn x_width(font: []const u8, s: []const u8) -> f64 {
    const f : i32 = x_find(font, s);
    if (f >= 0 and X_ST[f as usize] == 2) {
        X_MISS = false;
        return X_W[f as usize];
    }
    X_MISS = true;
    x_ask(font, s);
    return 0.0;
}

fn put_u32le(dst: []u8, at: u32, v: u32) -> u32 {
    dst[at as usize] = (v % 256) as u8;
    dst[(at + 1) as usize] = ((v / 256) % 256) as u8;
    dst[(at + 2) as usize] = ((v / 65536) % 256) as u8;
    dst[(at + 3) as usize] = ((v / 16777216) % 256) as u8;
    return at + 4;
}

pub fn w_text_need(dst: []u8) -> u32 {
    var n : u32 = 0;
    var c : u32 = 0;
    var i : u32 = 0;
    while (i < X_N) {
        if (X_ST[i as usize] == 0) {
            const need : u32 = 8 + X_FL[i as usize] + X_TL[i as usize];
            if ((n as usize) + (need as usize) > dst.len) { return c; }
            n = put_u32le(dst, n, X_FL[i as usize]);
            n = put_u32le(dst, n, X_TL[i as usize]);
            var k : u32 = 0;
            while (k < X_FL[i as usize]) {
                dst[(n + k) as usize] = X_POOL[(X_FO[i as usize] + k) as usize];
                k = k + 1;
            }
            n = n + X_FL[i as usize];
            k = 0;
            while (k < X_TL[i as usize]) {
                dst[(n + k) as usize] = X_POOL[(X_TO[i as usize] + k) as usize];
                k = k + 1;
            }
            n = n + X_TL[i as usize];
            X_ST[i as usize] = 1;
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

pub fn w_text_give(src: []const f64, n: u32) -> u32 {
    var i : u32 = 0;
    var k : u32 = 0;
    while (i < X_N and k < n and (k as usize) < src.len) {
        if (X_ST[i as usize] == 1) {
            X_W[i as usize] = src[k as usize];
            X_ST[i as usize] = 2;
            k = k + 1;
        }
        i = i + 1;
    }
    return 0;
}

// --- the PNG ----------------------------------------------------------------------------------------------------------------------

pub var P_FONT : [128]u8 = [0; 128];
pub var P_FONT_N : u32 = 0;
pub var P_TXT : [262144]u8 = [0; 262144];

/// ctx.font = `${spec} ui-monospace, Menlo, monospace` into P_FONT
fn png_font(spec: []const u8) -> u32 {
    var n : u32 = copy_into(P_FONT[0..], 0, spec);
    n = copy_into(P_FONT[0..], n, " ");
    n = copy_into(P_FONT[0..], n, W_PNG_FAMILY);
    P_FONT_N = n;
    return n;
}

fn is_word_b(b: u8) -> bool {
    if (b >= 48 and b <= 57) { return true; }
    if (b >= 65 and b <= 90) { return true; }
    if (b >= 97 and b <= 122) { return true; }
    return b == 95;
}

/// brand(s) = s.replace(/\bS3AI\b/g, S-superscript-3-AI) into dst
fn brand_into(dst: []u8, at: u32, s: []const u8) -> u32 {
    var n : u32 = at;
    var i : usize = 0;
    while (i < s.len) {
        var hit : bool = false;
        if (i + 4 <= s.len and s[i] == 83 and s[i + 1] == 51 and s[i + 2] == 65 and s[i + 3] == 73) {
            const before : bool = i == 0 or !is_word_b(s[i - 1]);
            const after : bool = i + 4 == s.len or !is_word_b(s[i + 4]);
            if (before and after) { hit = true; }
        }
        if (hit) {
            dst[n as usize] = 83;
            dst[(n + 1) as usize] = W_SUP3_A;
            dst[(n + 2) as usize] = W_SUP3_B;
            dst[(n + 3) as usize] = 65;
            dst[(n + 4) as usize] = 73;
            n = n + 5;
            i = i + 4;
        } else {
            dst[n as usize] = s[i];
            n = n + 1;
            i = i + 1;
        }
    }
    return n;
}

/// wrapText(ctx, text, maxW) written as fillText records at x = 40, line by line from y; returns the new write position and y in P_Y.
pub var P_Y : f64 = 0.0;

fn wrap_text(o: []u8, n0: u32, t: []const u8, maxw: f64, size: f64) -> u32 {
    var n : u32 = n0;
    var a : usize = 0;
    var p : usize = 0;
    while (p < t.len) {
        // the next word: up to and including the next space
        var q : usize = p;
        var done : bool = false;
        while (q < t.len and !done) {
            if (t[q] == 32) { done = true; }
            q = q + 1;
        }
        if (p > a) {
            const w : f64 = x_width(P_FONT[0..(P_FONT_N as usize)], t[a..q]);
            if (w > maxw) {
                n = bw_b(o, n, 13);
                n = bw_s(o, n, t[a..p]);
                n = bw_f(o, n, 40.0);
                n = bw_f(o, n, P_Y);
                P_Y = P_Y + size + 10.0;
                a = p;
            }
        }
        p = q;
    }
    if (a < t.len) {
        n = bw_b(o, n, 13);
        n = bw_s(o, n, t[a..t.len]);
        n = bw_f(o, n, 40.0);
        n = bw_f(o, n, P_Y);
        P_Y = P_Y + size + 10.0;
    }
    return n;
}

/// One line of the card: font spec, colour, text (in P_TXT[0..len]).
fn png_line(o: []u8, n0: u32, spec: []const u8, size: f64, col: []const u8, len: u32, maxw: f64) -> u32 {
    png_font(spec);
    var n : u32 = bw_set_s(o, n0, 35, P_FONT[0..(P_FONT_N as usize)]);
    n = bw_set_s(o, n, 32, col);
    n = wrap_text(o, n, P_TXT[0..(len as usize)], maxw, size);
    P_Y = P_Y + 8.0;
    return n;
}

/// downloadPng(): the drawing and the card text on a K_PNG_W x K_PNG_H canvas.
pub fn w_bdraw2(o: []u8) -> u32 {
    const w : f64 = K_PNG_W as f64;
    const hgt : f64 = K_PNG_H as f64;
    const ax : f64 = 380.0;
    const ay : f64 = 20.0;
    const aw : f64 = w - 400.0;
    const ah : f64 = hgt - 40.0;
    var n : u32 = bw_b(o, 0, 200);
    n = bw_b(o, n, 0);
    n = bw_b(o, n, 5);
    n = bw_b(o, n, 9);
    n = bw_f(o, n, ax);
    n = bw_f(o, n, ay);
    bounds(false);
    fit_view(aw, ah);
    n = render_ops(o, n, aw, ah, F_X, F_Y, F_S);
    n = bw_b(o, n, 6);
    n = bw_set_s(o, n, 32, W_PNG_BLACK);
    n = bw_rect(o, n, 10, 0.0, 0.0, ax, hgt);
    P_Y = 70.0;
    const maxw : f64 = ax - 60.0;
    // title
    var l : u32 = copy_into(P_TXT[0..], 0, SAY_PNG_TITLE);
    n = png_line(o, n, "700 44px", 44.0, W_PNG_ACCENT, l, maxw);
    // the label
    l = copy_into(P_TXT[0..], 0, S_LABEL[0..(S_LABEL_N as usize)]);
    n = png_line(o, n, "600 22px", 22.0, W_PNG_GOLD, l, maxw);
    // tiles touched
    arg_loc(0, R_NCOL as f64);
    var pn : u32 = pct_into(S_NUM3[0..], 0, R_NCOL as f64, K_CONFIG_TILES as f64);
    arg_set(1, S_NUM3[0..], 0, pn as usize);
    var fl : i64 = fmt_into(P_TXT[0..], SAY_PNG_TILES, 2);
    l = 0;
    if (fl >= 0) { l = fl as u32; }
    n = png_line(o, n, "600 22px", 22.0, W_PNG_WHITE, l, maxw);
    // features
    arg_loc(0, R_PLACED as f64);
    fl = fmt_into(P_TXT[0..], SAY_PNG_FEATURES, 1);
    l = 0;
    if (fl >= 0) { l = fl as u32; }
    n = png_line(o, n, "600 22px", 22.0, W_PNG_WHITE, l, maxw);
    // tallest
    l = 0;
    if (R_TALL >= 0) {
        arg_set(0, R_NPOOL[0..], R_CNO[R_TALL as usize] as usize, (R_CNO[R_TALL as usize] + R_CNL[R_TALL as usize]) as usize);
        arg_loc(1, tallest_n());
        fl = fmt_into(P_TXT[0..], SAY_PNG_TALLEST, 2);
        if (fl >= 0) { l = fl as u32; }
    }
    n = png_line(o, n, "400 18px", 18.0, W_PNG_MUTED, l, maxw);
    // the families
    png_font("600 18px");
    n = bw_set_s(o, n, 35, P_FONT[0..(P_FONT_N as usize)]);
    var i : usize = 0;
    while (i < K_FAMILIES.len) {
        if (R_FAMT[i] != 0) {
            n = bw_set_s(o, n, 32, K_FAMILY_COLORS[i]);
            n = bw_rect(o, n, 10, 40.0, P_Y - 13.0, 14.0, 14.0);
            n = bw_set_s(o, n, 32, W_PNG_MUTED);
            var t : u32 = copy_into(P_TXT[0..], 0, K_FAMILIES[i]);
            t = copy_into(P_TXT[0..], t, " ");
            const e : u32 = js_locale_num(P_TXT[0..], t, R_FAMT[i] as f64);
            n = bw_b(o, n, 13);
            n = bw_s(o, n, P_TXT[0..(e as usize)]);
            n = bw_f(o, n, 62.0);
            n = bw_f(o, n, P_Y);
            P_Y = P_Y + 26.0;
        }
        i = i + 1;
    }
    // brand and foot
    n = bw_set_s(o, n, 32, W_PNG_ACCENT);
    png_font("700 18px");
    n = bw_set_s(o, n, 35, P_FONT[0..(P_FONT_N as usize)]);
    const bl : u32 = brand_into(P_TXT[0..], 0, SAY_PNG_BRAND);
    n = bw_b(o, n, 13);
    n = bw_s(o, n, P_TXT[0..(bl as usize)]);
    n = bw_f(o, n, 40.0);
    n = bw_f(o, n, hgt - 56.0);
    n = bw_set_s(o, n, 32, W_PNG_FOOT_COLOR);
    png_font("400 15px");
    n = bw_set_s(o, n, 35, P_FONT[0..(P_FONT_N as usize)]);
    n = bw_b(o, n, 13);
    n = bw_s(o, n, SAY_PNG_FOOT);
    n = bw_f(o, n, 40.0);
    n = bw_f(o, n, hgt - 30.0);
    if (n == OVER) { return 0; }
    return n;
}

// --- the STL ----------------------------------------------------------------------------------------------------------------------------------

/// The bits of a double rounded to a 32 bit float (round to nearest, ties to even).
fn f32_bits(x: f64) -> u32 {
    if (x == 0.0) {
        if ((1.0 / x) < 0.0) { return 2147483648; }
        return 0;
    }
    var sign : u32 = 0;
    var ax : f64 = x;
    if (x < 0.0) {
        sign = 2147483648;
        ax = 0.0 - x;
    }
    if (x != x) { return 2143289344; }
    if (ax - ax != 0.0) { return sign + 2139095040; }
    const m : u64 = jn_mant(ax);
    const e : i32 = jn_expo(ax) + 52;
    if (e > 127) { return sign + 2139095040; }
    if (e < 0 - 126) {
        // a subnormal float: units of 2^-149
        var sh : i32 = (0 - 126) - e + 29;
        if (sh > 60) { return sign; }
        var q : u64 = m;
        var low : u64 = 0;
        var half : u64 = 1;
        var k : i32 = 0;
        while (k < sh) {
            half = half * 2;
            k = k + 1;
        }
        low = q % half;
        q = q / half;
        const h2 : u64 = half / 2;
        if (low > h2 or (low == h2 and q % 2 == 1)) { q = q + 1; }
        return sign + (q as u32);
    }
    var hi : u64 = m / 536870912;
    const low2 : u64 = m % 536870912;
    var ee : i32 = e;
    if (low2 > 268435456 or (low2 == 268435456 and hi % 2 == 1)) { hi = hi + 1; }
    if (hi == 16777216) {
        hi = 8388608;
        ee = ee + 1;
    }
    if (ee > 127) { return sign + 2139095040; }
    return sign + (((ee + 127) as u32) * 8388608) + ((hi - 8388608) as u32);
}

fn put_f32(o: []u8, at: u32, x: f64) -> u32 {
    var b : u32 = f32_bits(x);
    var n : u32 = at;
    var k : u32 = 0;
    while (k < 4) {
        if ((n as usize) < o.len) { o[n as usize] = (b % 256) as u8; }
        b = b / 256;
        n = n + 1;
        k = k + 1;
    }
    return n;
}

/// One triangle: the normal and three corners, each three floats, and two bytes of zero.
fn stl_tri(o: []u8, at: u32, nx: f64, ny: f64, nz: f64, a: []const f64, b: []const f64, c: []const f64) -> u32 {
    var n : u32 = put_f32(o, at, nx);
    n = put_f32(o, n, ny);
    n = put_f32(o, n, nz);
    var k : u32 = 0;
    while (k < 3) {
        n = put_f32(o, n, a[k as usize]);
        k = k + 1;
    }
    k = 0;
    while (k < 3) {
        n = put_f32(o, n, b[k as usize]);
        k = k + 1;
    }
    k = 0;
    while (k < 3) {
        n = put_f32(o, n, c[k as usize]);
        k = k + 1;
    }
    if ((n as usize) + 1 < o.len) {
        o[n as usize] = 0;
        o[(n + 1) as usize] = 0;
    }
    return n + 2;
}

pub var S_BOX : [6]f64 = [0.0; 6];
pub var S_PA : [3]f64 = [0.0; 3];
pub var S_PB : [3]f64 = [0.0; 3];
pub var S_PC : [3]f64 = [0.0; 3];
pub var S_PD : [3]f64 = [0.0; 3];

/// p(x, y, z) of the current box into out
fn box_p(out: []f64, x: u32, y: u32, z: u32) -> u32 {
    if (x != 0) { out[0] = S_BOX[3]; } else { out[0] = S_BOX[0]; }
    if (y != 0) { out[1] = S_BOX[4]; } else { out[1] = S_BOX[1]; }
    if (z != 0) { out[2] = S_BOX[5]; } else { out[2] = S_BOX[2]; }
    return 0;
}

fn stl_quad(o: []u8, at: u32, nx: f64, ny: f64, nz: f64, a: u32, b: u32, c: u32, d: u32) -> u32 {
    // the corner codes are 3 bits: x y z
    box_p(S_PA[0..], (a / 4) % 2, (a / 2) % 2, a % 2);
    box_p(S_PB[0..], (b / 4) % 2, (b / 2) % 2, b % 2);
    box_p(S_PC[0..], (c / 4) % 2, (c / 2) % 2, c % 2);
    box_p(S_PD[0..], (d / 4) % 2, (d / 2) % 2, d % 2);
    var n : u32 = stl_tri(o, at, nx, ny, nz, S_PA[0..], S_PB[0..], S_PC[0..]);
    n = stl_tri(o, n, nx, ny, nz, S_PA[0..], S_PC[0..], S_PD[0..]);
    return n;
}

fn stl_box(o: []u8, at: u32) -> u32 {
    var n : u32 = at;
    n = stl_quad(o, n, 0.0, 0.0, 0.0 - 1.0, 0, 2, 6, 4);
    n = stl_quad(o, n, 0.0, 0.0, 1.0, 1, 5, 7, 3);
    n = stl_quad(o, n, 0.0, 0.0 - 1.0, 0.0, 0, 4, 5, 1);
    n = stl_quad(o, n, 0.0, 1.0, 0.0, 2, 3, 7, 6);
    n = stl_quad(o, n, 0.0 - 1.0, 0.0, 0.0, 0, 1, 3, 2);
    n = stl_quad(o, n, 1.0, 0.0, 0.0, 4, 6, 7, 5);
    return n;
}

fn stl_len() -> u32 {
    return 84 + (R_NCOL + 1) * 12 * 50;
}

/// downloadStl(): a base plate the size of the die and one box per touched tile. Returns its length.
pub fn w_bytes(o: []u8) -> u32 {
    const total : u32 = stl_len();
    if ((total as usize) > o.len) { return 0; }
    var i : u32 = 0;
    while (i < 84) {
        o[i as usize] = 0;
        i = i + 1;
    }
    // the header: `${ID} ${label}`.slice(0, 79), each UTF-16 unit & 127
    var head : [4096]u8 = [0; 4096];
    var hl : u32 = copy_into(head[0..], 0, ID);
    hl = copy_into(head[0..], hl, " ");
    hl = copy_into(head[0..], hl, S_LABEL[0..(S_LABEL_N as usize)]);
    var units : u32 = 0;
    var p : u32 = 0;
    while (p < hl and units < 79) {
        const b : u32 = head[p as usize] as u32;
        var cp : u32 = b;
        var len : u32 = 1;
        if (b >= 240) {
            cp = b % 8;
            len = 4;
        } else {
            if (b >= 224) {
                cp = b % 16;
                len = 3;
            } else {
                if (b >= 192) {
                    cp = b % 32;
                    len = 2;
                }
            }
        }
        var q : u32 = 1;
        while (q < len and p + q < hl) {
            cp = cp * 64 + (head[(p + q) as usize] as u32) % 64;
            q = q + 1;
        }
        if (cp >= 65536) {
            const c2 : u32 = cp - 65536;
            o[units as usize] = (((55296 + c2 / 1024) % 128) as u8);
            units = units + 1;
            if (units < 79) {
                o[units as usize] = (((56320 + c2 % 1024) % 128) as u8);
                units = units + 1;
            }
        } else {
            o[units as usize] = ((cp % 128) as u8);
            units = units + 1;
        }
        p = p + len;
    }
    const tris : u32 = (R_NCOL + 1) * 12;
    o[80] = (tris % 256) as u8;
    o[81] = ((tris / 256) % 256) as u8;
    o[82] = ((tris / 65536) % 256) as u8;
    o[83] = ((tris / 16777216) % 256) as u8;
    var at : u32 = 84;
    S_BOX[0] = 0.0;
    S_BOX[1] = 0.0;
    S_BOX[2] = 0.0 - 1.0;
    S_BOX[3] = G_W as f64;
    S_BOX[4] = G_H as f64;
    S_BOX[5] = 0.0;
    at = stl_box(o, at);
    var c : u32 = 0;
    while (c < R_NCOL) {
        S_BOX[0] = R_CGX[c as usize] as f64;
        S_BOX[1] = (G_H as f64) - (R_CGY[c as usize] as f64) - 1.0;
        S_BOX[2] = 0.0;
        S_BOX[3] = (R_CGX[c as usize] as f64) + 1.0;
        S_BOX[4] = (G_H as f64) - (R_CGY[c as usize] as f64);
        S_BOX[5] = (R_CN[c as usize] as f64) * S_HK;
        at = stl_box(o, at);
        c = c + 1;
    }
    return at;
}

// --- effects ---------------------------------------------------------------------------------------------------------------------------------------

pub fn w_effect(k: u32, dst: []u8) -> u32 {
    if (k >= S_EF_N) {
        S_EF_N = 0;
        return 0;
    }
    const e : u8 = S_EF[k as usize];
    if (e == 80) {
        dst[0] = 80;
        var n : u32 = js_str_num(dst, 1, K_PNG_W as f64);
        dst[n as usize] = 10;
        n = js_str_num(dst, n + 1, K_PNG_H as f64);
        dst[n as usize] = 10;
        return copy_into(dst, n + 1, S_SAVE[0..(S_SAVE_N as usize)]);
    }
    dst[0] = 68;
    var m : u32 = copy_into(dst, 1, S_SAVE[0..(S_SAVE_N as usize)]);
    dst[m as usize] = 10;
    m = copy_into(dst, m + 1, W_STL_MIME);
    dst[m as usize] = 10;
    return js_str_num(dst, m + 1, stl_len() as f64);
}


// --- Tests of the native page -----------------------------------------------------------------------------

pub const W_TEST_GRID : str = "{\"w\":3,\"h\":2,\"types\":[\"CLBLL_L\",\"INT_L\",\"BRAM_L\"],\"rle\":[0,1,1,3,2,2],\"x\":{\"CLBLL_L\":[[7,0,1,1,0]],\"INT_L\":[[5,1,2,1,-1]],\"BRAM_L\":[[10,2,1,1,0]]},\"y\":{\"CLBLL_L\":[[20,0,2,1,1]],\"INT_L\":[[20,0,2,1,1]],\"BRAM_L\":[[20,0,2,1,1]]},\"except\":{},\"bits\":[1,1,1]}";
pub const W_TEST_SAMPLES : str = "{\"samples\":[{\"file\":\"a.fasm\",\"part\":\"xc7\",\"sha256\":\"0123456789abcdef0123456789abcdef\",\"features\":10,\"cleared\":1,\"commands\":[\"yosys -q\",\"nextpnr\"],\"tiles\":[[\"CLBLL_L_X7Y20\",3],[\"INT_L_X5Y20\",4],[\"BRAM_L_X10Y21\",2],[\"FOO_X1Y1\",1]]}]}";

fn has_text(o: []const u8, n: u32, want: []const u8) -> bool {
    if (want.len > (n as usize)) { return false; }
    var i : usize = 0;
    while (i + want.len <= (n as usize)) {
        var k : usize = 0;
        while (k < want.len and o[i + k] == want[k]) { k = k + 1; }
        if (k == want.len) { return true; }
        i = i + 1;
    }
    return false;
}

fn open_page() -> u32 {
    w_init("");
    w_view(800.0, 1.0, 0, 900.0, 800.0);
    return 0;
}

fn load_mini() -> u32 {
    w_data(0, W_TEST_GRID);
    w_data(1, W_TEST_SAMPLES);
    return 0;
}

test the_page_opens_loading_with_nothing_counted {
    open_page();
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert n > 0;
    assert has_text(o[0..], n, "<p class=\"fs-status\" role=\"status\">Loading the XC7A200T tile grid...</p>");
    assert has_text(o[0..], n, "aria-pressed=\"false\">AX7203 node (sample)</button>");
    assert has_text(o[0..], n, "<canvas class=\"fs-canvas\" role=\"img\" tabindex=\"0\" aria-label=");
    assert !has_text(o[0..], n, " width=\"");
    assert has_text(o[0..], n, "<dl class=\"fs-stats\"></dl><div class=\"fs-side\"><table class=\"fs-fams\"></table><div class=\"fs-info\" aria-live=\"polite\"></div></div><p class=\"fs-source\"></p>");
    assert has_text(o[0..], n, "<details class=\"fs-more\"></details><details class=\"fs-more\"></details><details class=\"fs-more\"></details>");
    var d : [64]u8 = [0; 64];
    assert w_bdraw(d[0..]) == 0;
}

test the_mini_die_loads_and_the_first_sample_is_counted {
    open_page();
    load_mini();
    assert S_GRID and S_HAVE;
    assert S_PRESSED == 0;
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">a.fasm: 9 features in 3 tiles</p>");
    assert has_text(o[0..], n, "aria-pressed=\"true\">AX7203 node (sample)</button>");
    assert has_text(o[0..], n, " width=\"800\" height=\"496\" style=\"height: 496px;\"");
    assert has_text(o[0..], n, "<div><dt>Tiles touched</dt><dd>3</dd></div><div><dt>Features set</dt><dd>9</dd></div>");
    assert has_text(o[0..], n, "<dd class=\"fs-tile\">INT_L_X5Y20<small>4 features</small></dd>");
    assert has_text(o[0..], n, "<dd>0.01%<small>3 of 41,106 tiles that hold configuration bits</small></dd>");
    assert has_text(o[0..], n, "<tr class=\"\"><td><i style=\"background:#00ff88\"></i>Logic (CLBLL, CLBLM)</td><td>1 / 16,825</td><td>3</td></tr>");
    assert has_text(o[0..], n, "<tr class=\"is-zero\"><td><i style=\"background:#ff8c3c\"></i>DSP</td><td>0 / 370</td><td>0</td></tr>");
    assert has_text(o[0..], n, "<p class=\"fs-muted\">Point at or tap a column to see its tile.</p>");
    assert has_text(o[0..], n, "<span>Sample a.fasm, part xc7, sha256 0123456789abcdef...</span>");
    assert has_text(o[0..], n, "<span class=\"fs-note\">1 lines set a value of zero");
    assert has_text(o[0..], n, "<span class=\"fs-note\">Heights are relative: the tallest column (4 features) is drawn the same height in every file. Floor: the 3 x 2 tile grid.</span>");
    assert has_text(o[0..], n, "<details class=\"fs-more\"><summary>1 tiles (1 features) are not tiles of the XC7A200T grid and are not drawn</summary><ul><li>FOO_X1Y1  1</li></ul></details>");
    assert has_text(o[0..], n, "<details class=\"fs-more\" hidden=\"\"><summary>0 lines are not FASM features");
    assert has_text(o[0..], n, "<details class=\"fs-more\"><summary>How this sample was made</summary><ul><li><code>yosys -q</code></li><li><code>nextpnr</code></li></ul></details>");
}

test the_drawing_is_a_binary_list_that_starts_with_the_canvas_and_the_transform {
    open_page();
    load_mini();
    var o : [262144]u8 = [0; 262144];
    const n : u32 = w_bdraw(o[0..]);
    assert n > 200;
    assert o[0] == 200 and o[1] == 0 and o[2] == 12;
    // setTransform(1, 0, 0, 1, 0, 0): 1.0 is 3FF0000000000000, little endian
    assert o[3] == 0 and o[9] == 240 and o[10] == 63;
    // then fillStyle "#000" (op 32, length 4)
    assert o[51] == 32 and o[52] == 4 and o[53] == 0 and o[54] == 35 and o[55] == 48;
    assert f64_bits(1.0) == 4607182418800017408;
    assert f64_bits(0.0 - 2.5) == 13836183955189006336;
    assert f64_bits(0.0) == 0;
    assert f64_bits(0.1) == 4591870180066957722;
    assert f64_bits(123456.789) == 4683220299150161609;
}

test floats_round_to_32_bits_to_nearest_even {
    assert f32_bits(1.5) == 1069547520;
    assert f32_bits(0.1) == 1036831949;
    assert f32_bits(0.0 - 3.0) == 3225419776;
    assert f32_bits(16777217.0) == 1266679808;
    assert f32_bits(16777219.0) == 1266679810;
    assert f32_bits(1.401298464324817e-45) == 1;
    assert f32_bits(0.0) == 0;
    assert f32_bits(1e39) == 2139095040;
}

test the_stl_has_a_base_and_a_box_per_tile_and_a_header {
    open_page();
    load_mini();
    var o : [4096]u8 = [0; 4096];
    assert w_bytes(o[0..]) == 84 + 4 * 12 * 50;
    assert o[0] == 102 and o[1] == 97 and o[2] == 115 and o[3] == 109;
    assert o[12] == 32 and o[13] == 97;
    assert o[80] == 48 and o[81] == 0 and o[82] == 0 and o[83] == 0;
    // the first triangle: the normal (0, 0, -1) of the plate's bottom, then its first corner (0, 0, -1)
    assert o[84] == 0 and o[91] == 0 and o[92] == 0 and o[93] == 0 and o[94] == 128 and o[95] == 191;
    assert o[96] == 0 and o[103] == 0 and o[107] == 191;
    assert o[132] == 0 and o[133] == 0;
    var small : [64]u8 = [0; 64];
    assert w_bytes(small[0..]) == 0;
}

test buttons_rotate_fit_and_save_with_the_names_of_the_loaded_file {
    open_page();
    load_mini();
    assert S_ROT == 0;
    w_click(4);
    assert S_ROT == 1;
    w_click(4);
    w_click(4);
    w_click(4);
    assert S_ROT == 0;
    var e : [256]u8 = [0; 256];
    w_click(5);
    const n : u32 = w_effect(0, e[0..]);
    assert e[0] == 80;
    assert has_text(e[0..], n, "1200");
    assert has_text(e[0..], n, "a-skyline.png");
    assert w_effect(1, e[0..]) == 0;
    w_click(6);
    const m : u32 = w_effect(0, e[0..]);
    assert e[0] == 68;
    assert has_text(e[0..], m, "a-skyline.stl");
    assert has_text(e[0..], m, "model/stl");
    assert has_text(e[0..], m, "2484");
    S_LABEL_N = copy_into(S_LABEL[0..], 0, "my file.v2.fasm");
    S_SAVE_N = save_name(W_PNG_SUFFIX);
    assert has_text(S_SAVE[0..], S_SAVE_N, "my-file-v2-skyline.png");
    assert S_SAVE[0] == 109;
}

test a_tap_picks_a_column_a_pointer_over_it_shows_it_and_leaving_clears_it {
    open_page();
    load_mini();
    // the first column in the list, by its hull
    cell_uv(R_CGX[0] as f64, R_CGY[0] as f64);
    // a point inside it: the middle of its top face, in canvas pixels
    const px : f64 = (px_of(G_U + 0.5, G_V + 0.5) - S_VX) * S_VS;
    const py : f64 = (py_of(G_U + 0.5, G_V + 0.5, (R_CN[0] as f64) * S_HK) - S_VY) * S_VS;
    w_cpointer(1, 1, px, py, 1);
    assert HV_ON;
    var o : [65536]u8 = [0; 65536];
    var n : u32 = w_render(o[0..]);
    assert has_text(o[0..], n, "<table><tbody><tr><th>Tile</th>");
    w_cpointer(0, 1, px, py, 1);
    w_cpointer(2, 1, px, py, 1);
    assert PK_ON;
    w_cpointer(4, 1, 0.0, 0.0, 1);
    assert !HV_ON;
    assert PK_ON;
    // a drag moves the view and picks nothing
    const vx : f64 = S_VX;
    w_cpointer(0, 2, 100.0, 100.0, 1);
    w_cpointer(1, 2, 140.0, 100.0, 1);
    w_cpointer(2, 2, 140.0, 100.0, 1);
    assert S_VX != vx;
    // a mouse leave with no hover does nothing
    w_cpointer(4, 2, 0.0, 0.0, 1);
}

test the_wheel_asks_the_host_for_exp_then_zooms_and_the_keys_zoom_pan_rotate {
    open_page();
    load_mini();
    const s0 : f64 = S_VS;
    assert w_wheel(100.0, 100.0, 100.0, 0) == 2;
    var req : [192]f64 = [0.0; 192];
    assert w_libm_need(req[0..]) == 1;
    assert req[0] == 16.0 and req[1] == 0.0 - 0.25;
    var ans : [1]f64 = [0.7788007830714049; 1];
    w_libm_give(ans[0..], 1);
    assert w_wheel(100.0, 100.0, 100.0, 0) == 1;
    assert S_VS < s0 or S_VS == s0;
    const s1 : f64 = S_VS;
    assert w_key("+") == 1;
    assert S_VS > s1;
    assert w_key("ArrowLeft") == 1;
    assert w_key("q") == 0;
    assert w_key("r") == 1;
    assert S_ROT == 1;
}

test hypot_is_the_v8_one_and_the_pinch_and_resize_follow_tool_js {
    assert hypot2(3.0, 4.0) == 5.0;
    assert hypot2(0.0, 0.0) == 0.0;
    assert hypot2(0.0 - 3.0, 4.0) == 5.0;
    assert hypot2(1e200, 1e200) > 1.4e200;
    open_page();
    load_mini();
    const s0 : f64 = S_VS;
    w_view(400.0, 1.0, 0, 900.0, 400.0);
    assert w_box(400.0, 300.0) == 1;
    assert S_CSSW == 400.0;
    assert S_VS < s0;
    assert w_box(400.0, 300.0) == 0;
}

test a_file_is_counted_or_refused_with_the_words_of_the_page {
    open_page();
    load_mini();
    var o : [65536]u8 = [0; 65536];
    w_file("mine.fasm", 77.0, "CLBLL_L_X7Y20.A\nCLBLL_L_X7Y20.B\nINT_L_X5Y20.C = 0\n# chipdb x.bin\nFOO.f\n", 0);
    var n : u32 = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">mine.fasm: 2 features in 1 tiles</p>");
    assert has_text(o[0..], n, "aria-pressed=\"false\">AX7203 node (sample)</button>");
    assert has_text(o[0..], n, "<span>Your file mine.fasm, 77 bytes, counted in this browser and sent nowhere. chipdb x.bin</span>");
    assert has_text(o[0..], n, "<span class=\"fs-note\">1 lines set a value of zero");
    assert has_text(o[0..], n, "<details class=\"fs-more\"><summary>1 lines are not FASM features (no tile name before the first &#39;.&#39;)</summary><ul><li>FOO.f</li></ul></details>");
    assert has_text(o[0..], n, "<details class=\"fs-more\" hidden=\"\"><summary>How this sample was made</summary>");
    w_file("empty.fasm", 3.0, "# c\n", 0);
    n = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">empty.fasm sets no FASM features: no line has a tile name and a feature.</p>");
    assert has_text(o[0..], n, "<dt>Tiles touched</dt><dd>1</dd>");
    w_file("huge.fasm", 300000000.0, "", 0);
    n = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">huge.fasm is larger than 256 MB, the most this page reads.</p>");
    w_file("bad.fasm", 3.0, "x", 1);
    n = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">bad.fasm could not be read.</p>");
}

test the_card_text_is_wrapped_at_spaces_to_the_widths_the_host_measures {
    open_page();
    load_mini();
    var o : [262144]u8 = [0; 262144];
    var req : [65536]u8 = [0; 65536];
    var rounds : u32 = 0;
    var go : bool = true;
    while (go and rounds < 40) {
        w_bdraw2(o[0..]);
        const q : u32 = w_text_need(req[0..]);
        if (q == 0) {
            go = false;
        } else {
            var wd : [512]f64 = [0.0; 512];
            var p : u32 = 0;
            var i : u32 = 0;
            while (i < q and i < 512) {
                const fl : u32 = (req[p as usize] as u32) + 256 * (req[(p + 1) as usize] as u32);
                const tl : u32 = (req[(p + 4) as usize] as u32) + 256 * (req[(p + 5) as usize] as u32);
                wd[i as usize] = (tl as f64) * 9.0;
                p = p + 8 + fl + tl;
                i = i + 1;
            }
            w_text_give(wd[0..], q);
        }
        rounds = rounds + 1;
    }
    assert !go or rounds < 40;
    const n : u32 = w_bdraw2(o[0..]);
    assert n > 300;
    assert o[0] == 200 and o[2] == 5 and o[3] == 9;
    // the brand has the superscript three
    assert has_text(o[0..], n, "Trinity S");
    var t : [16]u8 = [0; 16];
    assert brand_into(t[0..], 0, "Trinity S3AI") == 13;
    assert t[9] == 194 and t[10] == 179;
    assert brand_into(t[0..], 0, "S3AIX S3AI_") == 11;
}

test a_sample_that_is_not_on_the_die_or_a_broken_file_says_the_die_map_did_not_load {
    open_page();
    w_data(0, "{\"w\":3}");
    w_data(1, W_TEST_SAMPLES);
    var o : [65536]u8 = [0; 65536];
    var n : u32 = w_render(o[0..]);
    assert has_text(o[0..], n, "role=\"status\">The die map (grid.json) or the samples (samples.json) did not load, so nothing can be drawn.</p>");
    assert !S_GRID;
    open_page();
    w_data_failed(0);
    w_data(1, W_TEST_SAMPLES);
    n = w_render(o[0..]);
    assert has_text(o[0..], n, "did not load, so nothing can be drawn.</p>");
    w_click(0);
    w_click(4);
    assert w_key("r") == 1;
    assert !S_HAVE;
}

test the_text_widths_the_counting_and_the_spec_agree_on_the_families {
    open_page();
    load_mini();
    assert same_text(W_DATA_FILES[0], K_DATA_GRID);
    assert same_text(W_DATA_FILES[1], K_DATA_SAMPLES);
    assert family_of("CLBLL_L") == 0;
    assert family_of("INT_L") == 1;
    assert family_of("BRAM_INT_INTERFACE_L") == 1;
    assert family_of("BRAM_L") == 2;
    assert family_of("DSP_L") == 3;
    assert family_of("LIOB33") == 4;
    assert family_of("CLK_BUFG") == 5;
    assert family_of("NULL") == 6;
    assert R_NCOL == 3 and R_NOFF == 1 and R_PLACED == 9 and R_FEAT == 10;
    assert R_FAMT[0] == 1 and R_FAMT[1] == 1 and R_FAMT[2] == 1;
    assert R_FAMF[1] == 4;
}

/// The splicer follows only the names a module itself mentions, not the names the imported functions mention.
/// This anchor mentions every helper the writer, the JSON reader and the number rules call. Never called.
pub fn imports_anchor(o: []u8, s: []const u8) -> u32 {
    var n : u32 = 0;
    n = n + (ok(0) as u32);
    n = n + OVER;
    n = n + put(o, 0, 0);
    n = n + raw(o, 0, s);
    n = n + put_escaped(o, 0, 0);
    n = n + text(o, 0, s);
    n = n + num(o, 0, 0);
    n = n + attr(o, 0, s, s);
    n = n + fill(o, 0, s, s, s, s, 0);
