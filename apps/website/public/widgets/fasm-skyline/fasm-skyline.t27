; A tile type is of family K_TYPE_FAMILY[i] when it starts with K_TYPE_PREFIX[i]; first match wins,
; no match is OTHER. The interface tiles beside BRAM, IO and the fabric are routing, so INT.
pub const K_TYPE_PREFIX : [17]str = ["CLBLL", "CLBLM", "BRAM_INT_INTERFACE", "INT_INTERFACE", "IO_INT_INTERFACE", "INT_L", "INT_R", "BRAM_L", "BRAM_R", "DSP", "LIOB", "RIOB", "LIOI", "RIOI", "CLK", "HCLK", "CMT"];
