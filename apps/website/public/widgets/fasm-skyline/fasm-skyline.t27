; --- Tests ---------------------------------------------------------------------------------------
test the_die_counts_add_up {
    assert (K_GRID_W as u32) * (K_GRID_H as u32) == K_DIE_TILES;
    assert K_DIE_TILES == 69165;
    assert K_CONFIG_FAMILY_TILES[0] + K_CONFIG_FAMILY_TILES[1] + K_CONFIG_FAMILY_TILES[2] + K_CONFIG_FAMILY_TILES[3] + K_CONFIG_FAMILY_TILES[4] + K_CONFIG_FAMILY_TILES[5] + K_CONFIG_FAMILY_TILES[6] == K_CONFIG_TILES;
    assert K_CONFIG_TILES == 41106;
    assert K_CONFIG_TILES < K_DIE_TILES;
}

test the_ax7203_node_sample_adds_up {
    assert K_NODE_TILES == 2148;
    assert K_NODE_FEATURES == 114803;
    assert K_NODE_FAMILY_TILES[0] + K_NODE_FAMILY_TILES[1] + K_NODE_FAMILY_TILES[2] + K_NODE_FAMILY_TILES[3] + K_NODE_FAMILY_TILES[4] + K_NODE_FAMILY_TILES[5] + K_NODE_FAMILY_TILES[6] == K_NODE_TILES;
    assert K_NODE_FAMILY_FEATURES[0] + K_NODE_FAMILY_FEATURES[1] + K_NODE_FAMILY_FEATURES[2] + K_NODE_FAMILY_FEATURES[3] + K_NODE_FAMILY_FEATURES[4] + K_NODE_FAMILY_FEATURES[5] + K_NODE_FAMILY_FEATURES[6] == K_NODE_FEATURES;
    assert K_NODE_SHARE_BP == (K_NODE_TILES * 10000 + K_CONFIG_TILES / 2) / K_CONFIG_TILES;
    assert K_NODE_TALLEST_TILE == "BRAM_L_X6Y230";
    assert K_NODE_TALLEST <= K_NODE_FAMILY_FEATURES[2];
    assert K_NODE_FAMILY_TILES[0] <= K_CONFIG_FAMILY_TILES[0];
    assert K_NODE_FAMILY_TILES[1] <= K_CONFIG_FAMILY_TILES[1];
}

test the_t27_mac_sample_adds_up {
    assert K_MAC_TILES == 167;
    assert K_MAC_FEATURES == 5201;
    assert K_MAC_FAMILY_TILES[0] + K_MAC_FAMILY_TILES[1] + K_MAC_FAMILY_TILES[2] + K_MAC_FAMILY_TILES[3] + K_MAC_FAMILY_TILES[4] + K_MAC_FAMILY_TILES[5] + K_MAC_FAMILY_TILES[6] == K_MAC_TILES;
    assert K_MAC_FAMILY_FEATURES[0] + K_MAC_FAMILY_FEATURES[1] + K_MAC_FAMILY_FEATURES[2] + K_MAC_FAMILY_FEATURES[3] + K_MAC_FAMILY_FEATURES[4] + K_MAC_FAMILY_FEATURES[5] + K_MAC_FAMILY_FEATURES[6] == K_MAC_FEATURES;
    assert K_MAC_SHARE_BP == (K_MAC_TILES * 10000 + K_CONFIG_TILES / 2) / K_CONFIG_TILES;
    assert K_MAC_TALLEST <= K_MAC_FAMILY_FEATURES[0];
    assert K_MAC_CLEARED == 0;
    assert K_MAC_TILES < K_NODE_TILES;
}

test every_type_prefix_names_a_family {
    assert same_text(K_TYPE_FAMILY[0], K_FAMILIES[0]);
    assert same_text(K_TYPE_FAMILY[1], K_FAMILIES[0]);
    assert same_text(K_TYPE_FAMILY[2], K_FAMILIES[1]);
    assert same_text(K_TYPE_FAMILY[6], K_FAMILIES[1]);
    assert same_text(K_TYPE_FAMILY[7], K_FAMILIES[2]);
    assert same_text(K_TYPE_FAMILY[9], K_FAMILIES[3]);
    assert same_text(K_TYPE_FAMILY[10], K_FAMILIES[4]);
    assert same_text(K_TYPE_FAMILY[16], K_FAMILIES[5]);
}

test the_page_reads_files_and_sends_nothing {
    assert READS_LOCAL_FILES == true;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
    assert K_MIN_TARGET_PX >= 32;
    assert K_DATA_GRID == "./grid.json";
    assert (K_PNG_W as u32) * 630 == (K_PNG_H as u32) * 1200;
}

