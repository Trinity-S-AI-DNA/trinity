// SPDX-License-Identifier: Apache-2.0
; specs/widgets/course-deck.t27 -- a whole t27.ai course as one embeddable widget: its nine modules
; as tabs, each module's three lessons as a row of cards, each card holding that lesson's own widget.
; Source of truth for public/widgets/course-deck/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page. tool.js draws
; the deck from courses/<course>.json beside it (written by scripts/course-pages.mjs from the course
; specs, src/lib/course.generated.ts) and nests each lesson's widget page as an iframe through
; ../frame-pool.js, which mounts a frame only near the viewport and keeps at most K_LIVE_FRAMES_MAX live.
; ONE WIDGET FOR EVERY COURSE: the course is a parameter (?course=<id>, the first course when absent,
; &module=<n>, &lang=ru), not a copy per course. Eleven copies would differ only in their data, and a
; twelfth course would need a twelfth widget; here it needs nothing.
; THE NUMBERS ARE NOT THE DECK'S: every K_<NAME> below that specs/view/course-view.t27 also names is
; that spec's number, held equal by scripts/course-view-from-spec.mjs. No K_ holds a spec function's
; result. ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_course_deck;

pub const KIND : str = "widget-tool";
pub const ID : str = "course-deck";
pub const TITLE : str = "Course deck: a t27 course, module by module, widget by widget";
pub const DESCRIPTION : str = "Any free t27.ai course in one embed: nine module tabs, three lesson cards each, every card running that lesson's own widget, loaded only as you reach it.";
pub const IMAGE_ALT : str = "A black and white card: the line A whole course in one embed, 9 modules, 27 live lesson widgets; nine module tabs with the first one lit; and the three lesson cards of the first module of t27 basics (What a spec is, The module line, Comments and prose lines), each over a widget frame.";
pub const HOOK : str = "One iframe, one whole course: 9 modules, 27 lesson widgets, each loaded only when you reach it.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["The course specs specs/course/*.t27 and their Russian bundles, read by scripts/course-from-spec.mjs and written beside this page as courses/<course>.json by scripts/course-pages.mjs", "The frame budget and the load margins of specs/view/course-view.t27, held equal to the K_ numbers here by scripts/course-view-from-spec.mjs"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The words ---------------------------------------------------------------------------------
pub const SAY_MODULES : str = "Modules";
pub const SAY_MODULE : str = "Module {0}";
pub const SAY_LESSON : str = "Lesson {0} of {1}";
pub const SAY_GOAL : str = "You will learn";
pub const SAY_OPEN_LESSON : str = "Open the lesson";
pub const SAY_ONE_PAGE : str = "Whole course on one page";
pub const SAY_LOAD : str = "Load the widget";
pub const SAY_PREV : str = "Previous lesson";
pub const SAY_NEXT : str = "Next lesson";
pub const SAY_FREE : str = "Free course";
pub const SAY_NOT_FOUND : str = "This course is not in the catalog.";

; --- The numbers -------------------------------------------------------------------------------
pub const K_MODULES : u8 = 9;
pub const K_LESSONS_PER_MODULE : u8 = 3;
pub const K_LESSONS : u8 = 27;
pub const K_LIVE_FRAMES_MAX : u8 = 3;
pub const K_MOUNT_MARGIN_PX : u16 = 600;
pub const K_UNMOUNT_MARGIN_PX : u16 = 2000;
pub const K_FRAME_MIN_PX : u16 = 320;
pub const K_FRAME_MAX_PX : u16 = 900;
pub const K_TOUCH_TARGET_PX : u8 = 44;

test a_course_is_nine_tabs_of_three_cards {
    assert K_MODULES * K_LESSONS_PER_MODULE == K_LESSONS;
    assert K_LESSONS == 27;
}

; The cards of one module are the frames a phone may keep: a whole module stays live while it is read.
test one_module_is_one_frame_budget {
    assert K_LIVE_FRAMES_MAX == K_LESSONS_PER_MODULE;
    assert K_UNMOUNT_MARGIN_PX > K_MOUNT_MARGIN_PX;
    assert K_FRAME_MIN_PX < K_FRAME_MAX_PX;
}

test every_tab_and_button_takes_a_finger {
    assert K_TOUCH_TARGET_PX >= 44;
}
