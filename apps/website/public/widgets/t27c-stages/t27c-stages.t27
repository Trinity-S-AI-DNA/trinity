test the_card_is_x_shaped {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
}

test the_page_sends_nothing_and_reads_no_files {
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == false;
    assert CATEGORY == "compiler";
}

test the_example_numbers_hang_together {
    assert K_EXAMPLE_TOKENS > K_EXAMPLE_NODES;
    assert K_EXAMPLE_DEPTH < K_EXAMPLE_NODES;
    assert K_EXAMPLE_TARGETS_OK == K_TARGETS;
    assert K_EXAMPLE_BYTES <= K_MAX_SOURCE_BYTES;
}

test the_page_stays_responsive {
    assert K_DEBOUNCE_MS <= 500;
    assert K_MAX_TOKEN_CHIPS >= K_EXAMPLE_TOKENS;
    assert K_MAX_TREE_ROWS >= K_EXAMPLE_NODES;
}


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/t27c-stages/tool.js (364 lines of hand-written
; JavaScript). The words and numbers above are unchanged. What the page needs from outside is ONE
; service, the compiler, and it is asked in the way the libm and text services are: the wasm queues
; a request, the host answers it, the page is drawn again.
;   w_init(hash)              the page opens: the first example is in the box and is asked of the compiler
;   w_compile_need(dst)       the text to compile, copied to dst; 1 + its length, 0 when nothing is asked
;   w_compile_give(bytes, ok, t0, t1)
;                             the host's answer: ok 0 = the compiler's JSON (t27_analyze, public/t27/t27_compiler.wasm),
;                             ok 1 = the compiler trapped (bytes = the message), ok 2 = the module did not load (bytes =
;                             the message); t0 and t1 = performance.now() before and after t27_analyze
;   w_input(i, text)          the box changed: the answer is wanted after K_DEBOUNCE_MS of quiet
;   w_timer(id)               the debounce ran out (id = the one asked for last; an older one is ignored)
;   w_tab(i, shift, key)      a key went down in the box: the number of spaces Tab inserts, else 0
;   w_value(i, dst)           the text the box must hold now (4294967295: leave it as the reader typed it)
;   w_click(i)                button i in page order: 0 to 3 the examples, 4 to 9 the stages, 10 to 16 the backends
;   w_effect(k, dst)          effects after the last event: 't' + id + decimal ms = call w_timer(id) after ms
;   w_render(dst)             the page's HTML, length (0 on overflow)
; The compiler's answer is read as bytes (json_scan.t27): no tree. Not carried over from JavaScript:
; the colours of site.js (the page draws plain, which is what tool.js does when site.js did not
; load); an answer larger than W_RES_CAP bytes (4 MiB, the largest of the 2130 specs of the site under 64 KiB
; gave 1.7 MB) is a crash; a tree deeper than W_STACK levels is drawn to that depth; the page is cut at the
; host's 1 MiB; a click before the compiler has loaded waits for it (tool.js then shows its TypeError).
; The browser's HTML parser drops a newline right after <pre> and turns a carriage return into a
; newline: the page writes a second newline where the text starts with one and &#13; for a carriage return.

pub const W_RES_CAP : u32 = 4194304;
pub const W_SRC_CAP : u32 = 65536;
pub const W_MSG_CAP : u32 = 1024;
pub const W_TAB_SPACES : u32 = 4;
pub const W_STACK : u32 = 4096;
pub const W_EXAMPLES : u32 = 4;
pub const W_STAGES : u32 = 6;
pub const W_V_NONE : u32 = 0;
pub const W_V_JSTR : u32 = 1;
pub const W_V_GROUP : u32 = 2;
pub const W_V_PLAIN : u32 = 3;
pub const W_V_JRAW : u32 = 4;
pub const W_V_MSG : u32 = 5;
pub const W_V_JQUOTE : u32 = 6;
pub const W_V_SCR : u32 = 7;
pub const W_V_LMSG : u32 = 8;
pub const W_V_JFMT : u32 = 9;

pub var RES : [4194304]u8 = [0; 4194304];
pub var RES_N : u32 = 0;
pub var SRC : [65536]u8 = [0; 65536];
pub var SRC_N : u32 = 0;
pub var SRC_BYTES : u32 = 0;
pub var ED : [65536]u8 = [0; 65536];
