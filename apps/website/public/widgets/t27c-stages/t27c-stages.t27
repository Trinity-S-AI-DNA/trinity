:\",\",\"line\":11},{\"col\":23,\"kind\":\"Number\",\"lexeme\":\"3\",\"line\":11},{\"col\":24,\"kind\":\"RParen\",\"lexeme\":\")\",\"line\":11},{\"col\":26,\"kind\":\"Eq\",\"lexeme\":\"==\",\"line\":11},{\"col\":29,\"kind\":\"Number\",\"lexeme\":\"5\",\"line\":11},{\"col\":30,\"kind\":\"Semicolon\",\"lexeme\":\";\",\"line\":11},{\"col\":1,\"kind\":\"RBrace\",\"lexeme\":\"}\",\"line\":12}],\"topLevel\":3,\"typecheck\":{\"errorCount\":0,\"errors\":[],\"ok\":true,\"warnings\":0}}";
pub const W_T_BAD : str = "{\"astError\":\"boom \\\"x\\\"\",\"discarded\":[\"fell\"],\"hir\":{\"error\":\"no hir\",\"ok\":false},\"lexerDiscarded\":[{\"char\":\"\\u00e2\",\"line\":3},{\"char\":\"$\",\"line\":4},{\"char\":\"\\\"\",\"line\":5},{\"char\":\"\\\\\",\"line\":6},{\"char\":\"\\n\",\"line\":7},{\"char\":\"\\u0001\",\"line\":8}],\"nodeCount\":0,\"sourceBytes\":1234567,\"sourceLines\":1,\"swallowed\":[{\"line\":2,\"what\":\"@@\"}],\"targets\":{},\"tokenCount\":2,\"tokens\":[{\"col\":1,\"kind\":\"Ident\",\"lexeme\":\"ab\",\"line\":1},{\"col\":3,\"kind\":\"Number\",\"lexeme\":\"\",\"line\":1}],\"topLevel\":0,\"typecheck\":{\"errorCount\":0,\"errors\":[],\"ok\":true,\"warnings\":0}}";
pub const W_T_WARN : str = "{\"ast\":{\"children\":[{\"children\":[],\"kind\":\"ConstDecl\",\"line\":1,\"name\":\"A\",\"nodeKind\":\"x\",\"type\":\"u8\",\"value\":\"7\"},{\"children\":[],\"kind\":\"ExprLiteral\",\"line\":2,\"nodeKind\":\"string\",\"value\":\"a\\\"b\"}],\"kind\":\"Module\",\"line\":0,\"name\":\"m\"},\"astDepth\":2,\"discarded\":[],\"hir\":{\"ok\":true,\"text\":\"\\nHirModule\"},\"lexerDiscarded\":[],\"nodeCount\":3,\"sourceBytes\":9,\"sourceLines\":2,\"swallowed\":[],\"targets\":{\"c\":{\"bytes\":3,\"code\":\"\\n// c\",\"notEmitted\":2,\"ok\":true},\"verilog\":{\"bytes\":0,\"ok\":false,\"error\":\"no verilog\"}},\"tokenCount\":5,\"tokens\":[],\"topLevel\":2,\"typecheck\":{\"errors\":[\"Warning: one\",\"warning two\",\"error: three\"],\"ok\":false,\"warnings\":0}}";

fn t_page_has_bytes2(pre: []const u8, b1: u8, b2: u8, post: []const u8) -> bool {
    var b : [160]u8 = [0; 160];
    var n : u32 = raw(b[0..160], 0, pre);
    n = put(b[0..160], n, b1);
    n = put(b[0..160], n, b2);
    n = raw(b[0..160], n, post);
    return t_page_has(b[0..(n as usize)]);
}

/// Does the first n bytes of hay hold needle?
fn t_has(hay: []const u8, needle: []const u8) -> bool {
    if (needle.len > hay.len) { return false; }
    var i : usize = 0;
    while (i + needle.len <= hay.len) {
        var k : usize = 0;
        while (k < needle.len and hay[i + k] == needle[k]) { k = k + 1; }
        if (k == needle.len) { return true; }
        i = i + 1;
    }
    return false;
}

fn t_page_has(needle: []const u8) -> bool {
    const n : u32 = w_render(T_OUT[0..1048576]);
    return t_has(T_OUT[0..(n as usize)], needle);
}

fn t_number_has(v: u64, tail: []const u8) -> bool {
    var b : [32]u8 = [0; 32];
    var n : u32 = num_grouped(b[0..32], 0, v);
    var k : usize = 0;
    while (k < tail.len) {
        n = put(b[0..32], n, tail[k]);
        k = k + 1;
    }
    return t_page_has(b[0..(n as usize)]);
}

fn t_open() -> u32 {
    w_init("");
    return w_compile_give(W_T_ADDER, 0, 1.0, 3.5);
}

test the_page_opens_loading_and_asks_for_the_first_example {
    w_init("");
    assert t_page_has("Loading the t27c compiler");
    assert t_page_has("<textarea class=\"ts-editor\"");
    assert t_page_has("aria-pressed=\"true\">A tiny adder</button>");
    assert t_page_has("<section class=\"ts-panel\" aria-live=\"off\"></section>");
    assert t_page_has("<div class=\"ts-alert\" hidden=\"\"></div>");
    assert w_compile_need(T_NEED[0..70000]) == (SAY_EXAMPLE_SOURCES[0].len as u32) + 1;
    assert same_bytes(T_NEED[0..SAY_EXAMPLE_SOURCES[0].len], SAY_EXAMPLE_SOURCES[0].len as u32, SAY_EXAMPLE_SOURCES[0]);
    assert w_value(0, T_OUT[0..1000]) == (SAY_EXAMPLE_SOURCES[0].len as u32);
    assert w_value(0, T_OUT[0..1000]) == 4294967295;
}

test the_example_numbers_of_the_spec_come_back_on_the_chips {
    t_open();
    assert w_compile_need(T_NEED[0..70000]) == 0;
    assert t_number_has(K_EXAMPLE_BYTES as u64, " bytes</span>");
    assert t_number_has(K_EXAMPLE_TOKENS as u64, " tokens</span>");
    assert t_number_has(K_EXAMPLE_NODES as u64, " nodes</span>");
    assert t_page_has(">passed</span>");
    assert t_page_has(">51 lines</span>");
    assert t_page_has(">7 of 7</span>");
    assert t_page_has("12 lines, 211 bytes. Compiled in 2.5 ms by t27_compiler.wasm, in this tab.");
    assert t_page_has("data-state=\"ok\"");
    assert !t_page_has("data-state=\"bad\"");
}

test each_stage_says_what_the_compiler_answered {
    t_open();
    assert t_page_has("<h2 class=\"ts-stage-name\">1. Source</h2>");
    assert t_page_has("211 bytes on 12 lines.");
    assert t_page_has("The first 48 bytes as the compiler receives them");
    assert t_page_has("<span class=\"ts-byte-ch\">;</span><span class=\"ts-byte-hex\">3b</span>");
    w_click(5);
    assert t_page_has("45 tokens. Each shows its text and, under it, its kind.");
    assert t_page_has("<span class=\"ts-tok-lex\">module</span><span class=\"ts-tok-kind\">KwModule</span>");
    w_click(6);
    assert t_page_has("16 nodes, 7 levels deep, 3 declarations at the top.");
    assert t_page_has("<div class=\"ts-node\" style=\"--d:0\"><span class=\"ts-n-kind\">Module</span> <span class=\"ts-n-name\">tiny_adder</span></div>");
    assert t_page_has("<span class=\"ts-n-type\">(a: u8, b: u8)</span> <span class=\"ts-n-type\">-> u8</span>");
    w_click(7);
    assert t_page_has("Passed: every value fits its type.");
    w_click(8);
    assert t_page_has("<p class=\"ts-facts\">51 lines, printed by the compiler&#39;s own debug view of the HIR.</p>");
    w_click(9);
    assert t_number_has(K_EXAMPLE_TARGET_BYTES as u64, " bytes in all. Pick one:");
    assert t_page_has("7 of 7 backends wrote code");
    assert t_page_has("aria-pressed=\"true\">Verilog <span class=\"ts-target-bytes\">");
    w_click(12);
    assert t_page_has("aria-pressed=\"true\">C <span class=\"ts-target-bytes\">");
}

test a_crash_stops_the_stages_and_keeps_the_page_alive {
    t_open();
    w_input(0, "module z;");
    w_timer(TIMER_GEN);
    assert w_compile_need(T_NEED[0..70000]) == 10;
    w_compile_give("unreachable", 1, 0.0, 0.0);
    assert t_page_has("internal error (unreachable)");
    assert t_page_has("<p class=\"ts-facts is-bad\" role=\"status\">The compiler stopped");
    assert t_page_has("<p class=\"ts-bad\">The compiler stopped");
    assert t_page_has("data-state=\"bad\"");
    assert t_page_has(">stopped</span>");
    w_click(7);
    assert t_page_has("<p class=\"ts-bad\">The compiler stopped");
}

test a_text_over_the_limit_is_refused_before_the_compiler {
    t_open();
    var k : usize = 0;
    while (k < 65537) {
        T_IN[k] = 97;
        k = k + 1;
    }
    w_input(0, T_IN[0..65537]);
    assert t_page_has("Compiling...");
    w_timer(TIMER_GEN);
    assert w_compile_need(T_NEED[0..70000]) == 0;
    assert t_page_has("This text is 65,537 bytes; the page compiles up to 65,536.");
    assert t_page_has("<p class=\"ts-facts is-bad\"");
    k = 0;
    while (k < 65536) {
        T_IN[k] = 97;
        k = k + 1;
    }
    w_input(0, T_IN[0..65536]);
    w_timer(TIMER_GEN);
    assert w_compile_need(T_NEED[0..70000]) == 65537;
}

test the_debounce_keeps_only_the_last_timer {
    t_open();
    w_input(0, "module a;");
    const first : u32 = TIMER_GEN;
    var e : [16]u8 = [0; 16];
    assert w_effect(0, e[0..16]) == 5;
    assert e[0] == 116;
    assert e[1] == (first as u8);
    assert e[2] == 50;
    assert e[3] == 50;
    assert e[4] == 48;
    assert w_effect(1, e[0..16]) == 0;
    w_input(0, "module ab;");
    assert TIMER_GEN != first;
    w_timer(first);
    assert w_compile_need(T_NEED[0..70000]) == 0;
    w_timer(TIMER_GEN);
    assert w_compile_need(T_NEED[0..70000]) == 11;
    assert t_page_has("aria-pressed=\"false\">A tiny adder</button>");
    w_click(1);
    assert w_effect(0, e[0..16]) == 0;
    assert t_page_has("aria-pressed=\"true\">A value too big</button>");
    assert w_value(0, T_OUT[0..1000]) == (SAY_EXAMPLE_SOURCES[1].len as u32);
}

test tab_indents_and_escape_lets_it_leave {
    assert w_tab(0, 0, "Tab") == 4;
    assert w_tab(0, 1, "Tab") == 0;
    assert w_tab(0, 0, "a") == 0;
    assert w_tab(0, 0, "Escape") == 0;
    assert w_tab(0, 0, "Tab") == 0;
    assert w_tab(0, 0, "Tab") == 4;
}

test the_browser_parser_rules_are_met_for_pre_and_carriage_returns {
    t_open();
    // LF, a, b, CR, c, CR, LF, d: the bytes are set one by one (a carriage return has no spelling in a literal)
    T_IN[0] = 10;
    T_IN[1] = 97;
    T_IN[2] = 98;
    T_IN[3] = 13;
    T_IN[4] = 99;
    T_IN[5] = 13;
    T_IN[6] = 10;
    T_IN[7] = 100;
    w_input(0, T_IN[0..8]);
    w_timer(TIMER_GEN);
    w_compile_give(W_T_ADDER, 0, 0.0, 0.0);
    var e : [64]u8 = [0; 64];
    var n : u32 = raw(e[0..64], 0, "<pre class=\"ts-code\">");
    n = put(e[0..64], n, 10);
    n = put(e[0..64], n, 10);
    n = raw(e[0..64], n, "ab&#13;c&#13;");
    n = put(e[0..64], n, 10);
    n = raw(e[0..64], n, "d</pre>");
    assert t_page_has(e[0..(n as usize)]);
    w_input(0, "ab");
    w_timer(TIMER_GEN);
    w_compile_give(W_T_ADDER, 0, 0.0, 0.0);
    assert t_page_has("<pre class=\"ts-code\">ab</pre>");
}

test the_alert_names_what_the_compiler_dropped_and_survives_a_failure {
    t_open();
    w_compile_give(W_T_BAD, 0, 0.0, 0.0);
    assert t_page_has("<div class=\"ts-alert is-bad\">");
    assert t_page_has("<p class=\"ts-alert-title is-bad\">The parser stopped, so the stages after it have nothing to work on: boom &quot;x&quot;</p>");
    assert t_page_has_bytes2("<li>line 3: the lexer threw away the byte &quot;", 195, 162, "&quot;</li>");
    assert t_page_has("line 4: the lexer threw away the byte &quot;$&quot;");
    assert t_page_has("line 5: the lexer threw away the byte &quot;\\&quot;&quot;");
    assert t_page_has("line 6: the lexer threw away the byte &quot;\\\\&quot;");
    assert t_page_has("line 7: the lexer threw away the byte &quot;\\n&quot;");
    assert t_page_has("line 8: the lexer threw away the byte &quot;\\u0001&quot;");
    assert t_page_has("line 2: the parser skipped @@");
    assert t_page_has("the parser fell back: fell");
    assert t_page_has("one non-ASCII character such as an em dash");
    assert t_number_has(1234567, " bytes</span>");
    w_click(5);
    assert t_page_has("<span class=\"ts-tok-lex\">ab</span>");
    assert t_page_has_bytes2("<span class=\"ts-tok-lex\">", 194, 160, "</span>");
    w_click(4);
    w_compile_give("boom", 1, 0.0, 0.0);
    assert t_page_has("<div class=\"ts-alert is-bad\" hidden=\"\">");
    assert t_page_has("line 4: the lexer threw away the byte");
    w_compile_give(W_T_ADDER, 0, 0.0, 0.0);
    assert t_page_has("<div class=\"ts-alert\" hidden=\"\"></div>");
}

test warnings_the_value_of_a_string_and_the_backend_that_wrote_nothing {
    t_open();
    w_compile_give(W_T_WARN, 0, 0.0, 0.0);
    w_click(7);
    assert t_page_has("<p class=\"ts-verdict is-bad\">Failed. Errors: 1, warnings: 2.</p>");
    assert t_page_has("<li class=\"is-warn\">Warning: one</li><li class=\"is-warn\">warning two</li><li class=\"is-bad\">error: three</li>");
    assert t_page_has("The backends wrote code anyway");
    w_click(6);
    assert t_page_has("<span class=\"ts-n-val\">7</span>");
    assert t_page_has("<span class=\"ts-n-val\">&quot;a\\&quot;b&quot;</span>");
    w_click(8);
    assert t_page_has("<pre class=\"ts-code\">\n\nHirModule</pre>");
    w_click(9);
    assert t_page_has("1 of 7 backends wrote code, 3 bytes in all.");
    assert t_page_has("class=\"t27-btn ts-target is-bad\"");
    assert t_page_has("<p class=\"ts-bad\">This backend wrote nothing: no verilog</p>");
    w_click(12);
    assert t_page_has("<p class=\"ts-note\">2 declarations have no spelling in this language and were left out; the code marks each one.</p>");
    assert t_page_has("<pre class=\"ts-code\">\n\n// c</pre>");
}
