pub var LMSG : [1024]u8 = [0; 1024];
pub var LMSG_N : u32 = 0;
pub var SCR : [64]u8 = [0; 64];
pub var STAGE : u32 = 0;
pub var TARGET : u32 = 0;
pub var EX_PRESSED : u32 = 0;
pub var HAVE : bool = false;
pub var STAGE_DRAWN : bool = false;
pub var RES_OK : bool = false;
pub var FIRST : bool = false;
pub var REQ : bool = false;
pub var ESCAPED : bool = false;
pub var FACTS_BAD : bool = false;
pub var FACTS_MODE : u32 = 0;
pub var ERR_KIND : u32 = 0;
pub var ERR_BYTES : u32 = 0;
pub var MS : f64 = 0.0;
pub var TIMER_GEN : u32 = 0;
pub var EFF_TIMER : bool = false;
pub var T_AST : i64 = -1;
pub var T_ASTDEPTH : i64 = -1;
pub var T_ASTERR : i64 = -1;
pub var T_DISC : i64 = -1;
pub var T_HIR : i64 = -1;
pub var T_LEXD : i64 = -1;
pub var T_NODES : i64 = -1;
pub var T_SBYTES : i64 = -1;
pub var T_SLINES : i64 = -1;
pub var T_SWAL : i64 = -1;
pub var T_TARGETS : i64 = -1;
pub var T_TOKCOUNT : i64 = -1;
pub var T_TOKENS : i64 = -1;
pub var T_TOPLEVEL : i64 = -1;
pub var T_TC : i64 = -1;
pub var T_HIRTEXT : i64 = -1;
pub var T_HIRERR : i64 = -1;
pub var T_OK : [7]bool = [false; 7];
pub var T_SP : [7]i64 = [-1; 7];
pub var T_BYTES : [7]u64 = [0; 7];
pub var OK7 : u32 = 0;
pub var OKALL : u32 = 0;
pub var SUM_BYTES : u64 = 0;
pub var V_PARSED : bool = true;
pub var V_DROPPED : bool = false;
pub var V_SWALLOWED : bool = false;
pub var V_HIR_OK : bool = false;
pub var V_HIR_LINES : u32 = 0;
pub var V_TC_OK : bool = false;
pub var V_TC_FATAL : bool = false;
pub var V_WARNS : u32 = 0;
pub var V_ERRS : i64 = 0;
pub var ST_POS : [4096]u32 = [0; 4096];
pub var ST_END : [4096]u32 = [0; 4096];

fn ts_d() -> []const u8 {
    return RES[0..(RES_N as usize)];
}

// --- writing -----------------------------------------------------------------------------------

fn ts_esc(o: []u8, n: u32, b: u8) -> u32 {
    if (b == 13) { return raw(o, n, "&#13;"); }
    return put_escaped(o, n, b);
}

fn ts_text(o: []u8, n0: u32, s: []const u8) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    while (i < s.len) {
        n = ts_esc(o, n, s[i]);
        i = i + 1;
    }
    return n;
}

/// A JSON string value as text, its escapes decoded to UTF-8 and the bytes written as HTML text.
fn ts_jstr(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    var n : u32 = n0;
    if (kind(d, sp) != J_STRING) { return n; }
    const hi : usize = span_hi(sp) - 1;
    var p : usize = span_lo(sp) + 1;
    while (p < hi) {
        if (d[p] == 92 and p + 1 < hi) {
            const e : u32 = escape_at(d, p + 1, hi);
            const cp : u32 = e / 16;
            const w : u32 = cp_utf8_len(cp);
            var j : u32 = 0;
            while (j < w) {
                n = ts_esc(o, n, cp_utf8_byte(cp, j));
                j = j + 1;
            }
            p = p + 1 + ((e % 16) as usize);
        } else {
            n = ts_esc(o, n, d[p]);
            p = p + 1;
        }
    }
    return n;
}

/// JSON.stringify of the string at sp, written as HTML text.
fn ts_jquote(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    var n : u32 = ts_esc(o, n0, 34);
    if (kind(d, sp) == J_STRING) {
        const hi : usize = span_hi(sp) - 1;
        var p : usize = span_lo(sp) + 1;
        while (p < hi) {
            var cp : u32 = d[p] as u32;
            var adv : usize = 1;
            var lit : bool = true;
            if (d[p] == 92 and p + 1 < hi) {
                const e : u32 = escape_at(d, p + 1, hi);
                cp = e / 16;
                adv = 1 + ((e % 16) as usize);
                lit = false;
            }
            if (lit and d[p] >= 128) {
                n = ts_esc(o, n, d[p]);
            } else {
                if (cp == 34) { n = raw(o, n, "\\&quot;"); }
                else { if (cp == 92) { n = raw(o, n, "\\\\"); }
                else { if (cp == 8) { n = raw(o, n, "\\b"); }
                else { if (cp == 12) { n = raw(o, n, "\\f"); }
                else { if (cp == 10) { n = raw(o, n, "\\n"); }
                else { if (cp == 13) { n = raw(o, n, "\\r"); }
                else { if (cp == 9) { n = raw(o, n, "\\t"); }
                else {
                    if (cp < 32 or (cp >= 55296 and cp <= 57343)) {
                        n = raw(o, n, "\\u");
                        var sh : u32 = 4096;
                        while (sh > 0) {
                            const dg : u32 = (cp / sh) % 16;
                            if (dg < 10) { n = put(o, n, (48 + dg) as u8); } else { n = put(o, n, (87 + dg) as u8); }
                            sh = sh / 16;
                        }
                    } else {
                        const w : u32 = cp_utf8_len(cp);
                        var j : u32 = 0;
                        while (j < w) {
                            n = ts_esc(o, n, cp_utf8_byte(cp, j));
                            j = j + 1;
                        }
                    }
                } } } } } } }
            }
            p = p + adv;
        }
    }
    return ts_esc(o, n, 34);
}

/// A JSON number as the text it has in the file.
fn ts_jraw(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    var n : u32 = n0;
    if (sp < 0) { return n; }
    var p : usize = span_lo(sp);
    while (p < span_hi(sp)) {
        n = put(o, n, d[p]);
        p = p + 1;
    }
    return n;
}

/// String(v) of a JSON value: a string as it is, a number as written, true, false, null, undefined.
fn ts_jstring(o: []u8, n: u32, d: []const u8, sp: i64) -> u32 {
    const k : u8 = kind(d, sp);
    if (k == J_STRING) { return ts_jstr(o, n, d, sp); }
    if (k == J_NUMBER) { return ts_jraw(o, n, d, sp); }
    if (k == J_TRUE) { return raw(o, n, "true"); }
    if (k == J_FALSE) { return raw(o, n, "false"); }
    if (k == J_NULL) { return raw(o, n, "null"); }
    return raw(o, n, "undefined");
}

/// fmt(v): Number(v ?? 0).toLocaleString('en-US') for a whole number; 0 for anything that is no number.
fn ts_jfmt(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    if (kind(d, sp) != J_NUMBER) { return put(o, n0, 48); }
    const v : i64 = num_i64(d, sp);
    if (v < 0) {
        const m : u32 = put(o, n0, 45);
        return num_grouped(o, m, (0 - v) as u64);
    }
    return num_grouped(o, n0, v as u64);
}

/// A JSON value is a string with at least one character (JavaScript: truthy).
fn ts_has(d: []const u8, sp: i64) -> bool {
    return kind(d, sp) == J_STRING and str_len(d, sp) > 0;
}

/// A JSON number as an integer; dflt when it is none.
fn ts_jint(d: []const u8, sp: i64, dflt: i64) -> i64 {
    if (kind(d, sp) != J_NUMBER) { return dflt; }
    return num_i64(d, sp);
}

fn ts_val(o: []u8, n: u32, k: u32, r: i64) -> u32 {
    if (k == W_V_JSTR) { return ts_jstr(o, n, ts_d(), r); }
    if (k == W_V_GROUP) { return num_grouped(o, n, r as u64); }
    if (k == W_V_PLAIN) { return num(o, n, r as u64); }
    if (k == W_V_JRAW) { return ts_jraw(o, n, ts_d(), r); }
    if (k == W_V_MSG) { return ts_text(o, n, MSG[0..(MSG_N as usize)]); }
    if (k == W_V_LMSG) { return ts_text(o, n, LMSG[0..(LMSG_N as usize)]); }
    if (k == W_V_JQUOTE) { return ts_jquote(o, n, ts_d(), r); }
    if (k == W_V_JFMT) { return ts_jfmt(o, n, ts_d(), r); }
    if (k == W_V_SCR) { return ts_text(o, n, SCR[span_lo(r)..span_hi(r)]); }
    return n;
}

/// fill(template, ...values): {0} {1} {2} replaced by the values given (kind and reference each), others as written.
fn ts_fill(o: []u8, n0: u32, t: []const u8, k0: u32, r0: i64, k1: u32, r1: i64, k2: u32, r2: i64) -> u32 {
    var n : u32 = n0;
    var cnt : u32 = 0;
    if (k0 != W_V_NONE) { cnt = 1; }
    if (k1 != W_V_NONE) { cnt = 2; }
    if (k2 != W_V_NONE) { cnt = 3; }
    var i : usize = 0;
    while (i < t.len) {
        var done : bool = false;
        if (t[i] == 123) {
            var j : usize = i + 1;
            var idx : u32 = 0;
            while (j < t.len and t[j] >= 48 and t[j] <= 57) {
                if (idx < 100000) { idx = idx * 10 + ((t[j] - 48) as u32); }
                j = j + 1;
            }
            if (j > i + 1 and j < t.len and t[j] == 125 and idx < cnt) {
                if (idx == 0) { n = ts_val(o, n, k0, r0); }
                if (idx == 1) { n = ts_val(o, n, k1, r1); }
                if (idx == 2) { n = ts_val(o, n, k2, r2); }
                i = j + 1;
                done = true;
            }
        }
        if (!done) {
            n = ts_esc(o, n, t[i]);
            i = i + 1;
        }
    }
    return n;
}

fn ts_fill1(o: []u8, n: u32, t: []const u8, k0: u32, r0: i64) -> u32 {
    return ts_fill(o, n, t, k0, r0, W_V_NONE, 0, W_V_NONE, 0);
}

// --- reading the compiler's answer ---------------------------------------------------------------

/// Is the decoded string at sp, in its first bytes, "warning" in any case?
fn ts_is_warning(d: []const u8, sp: i64) -> bool {
    if (kind(d, sp) != J_STRING or str_len(d, sp) < 7) { return false; }
    const w : []const u8 = "warning";
    var k : u32 = 0;
    while (k < 7) {
        var b : u8 = str_byte(d, sp, k);
        if (b >= 65 and b <= 90) { b = b + 32; }
        if (b != w[k as usize]) { return false; }
        k = k + 1;
    }
    return true;
}

/// Reads the answer once: where each top-level value is, and the verdicts the chips and panels share.
fn ts_index() -> u32 {
    const d : []const u8 = ts_d();
    const r : i64 = root(d);
    T_AST = NO_SPAN;
    T_ASTDEPTH = NO_SPAN;
    T_ASTERR = NO_SPAN;
    T_DISC = NO_SPAN;
    T_HIR = NO_SPAN;
    T_LEXD = NO_SPAN;
    T_NODES = NO_SPAN;
    T_SBYTES = NO_SPAN;
    T_SLINES = NO_SPAN;
    T_SWAL = NO_SPAN;
    T_TARGETS = NO_SPAN;
    T_TOKCOUNT = NO_SPAN;
    T_TOKENS = NO_SPAN;
    T_TOPLEVEL = NO_SPAN;
    T_TC = NO_SPAN;
    if (kind(d, r) == J_OBJECT) {
        const hi : usize = span_hi(r);
        var p : usize = skip_ws(d, span_lo(r) + 1);
        while (p < hi and d[p] == 34) {
            const ke : usize = string_end(d, p);
            if (ke > hi) { break; }
            const q : usize = skip_ws(d, ke);
            if (q >= hi or d[q] != 58) { break; }
            const v : usize = skip_ws(d, q + 1);
            const ve : usize = value_end(d, v);
            if (ve > hi) { break; }
            const sp : i64 = jspan(v, ve);
            if (key_is(d, p, ke, "ast")) { T_AST = sp; }
            if (key_is(d, p, ke, "astDepth")) { T_ASTDEPTH = sp; }
            if (key_is(d, p, ke, "astError")) { T_ASTERR = sp; }
            if (key_is(d, p, ke, "discarded")) { T_DISC = sp; }
            if (key_is(d, p, ke, "hir")) { T_HIR = sp; }
            if (key_is(d, p, ke, "lexerDiscarded")) { T_LEXD = sp; }
            if (key_is(d, p, ke, "nodeCount")) { T_NODES = sp; }
            if (key_is(d, p, ke, "sourceBytes")) { T_SBYTES = sp; }
            if (key_is(d, p, ke, "sourceLines")) { T_SLINES = sp; }
            if (key_is(d, p, ke, "swallowed")) { T_SWAL = sp; }
            if (key_is(d, p, ke, "targets")) { T_TARGETS = sp; }
            if (key_is(d, p, ke, "tokenCount")) { T_TOKCOUNT = sp; }
            if (key_is(d, p, ke, "tokens")) { T_TOKENS = sp; }
            if (key_is(d, p, ke, "topLevel")) { T_TOPLEVEL = sp; }
            if (key_is(d, p, ke, "typecheck")) { T_TC = sp; }
            p = skip_ws(d, ve);
            if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
        }
    }
    // the backends: those the page lists, and every one the object holds
    var j : usize = 0;
    while (j < 7) {
        T_OK[j] = false;
        T_SP[j] = NO_SPAN;
        T_BYTES[j] = 0;
        j = j + 1;
    }
    OK7 = 0;
    OKALL = 0;
    SUM_BYTES = 0;
    if (kind(d, T_TARGETS) == J_OBJECT) {
        const hi : usize = span_hi(T_TARGETS);
        var p : usize = skip_ws(d, span_lo(T_TARGETS) + 1);
        while (p < hi and d[p] == 34) {
            const ke : usize = string_end(d, p);
            if (ke > hi) { break; }
            const q : usize = skip_ws(d, ke);
            if (q >= hi or d[q] != 58) { break; }
            const v : usize = skip_ws(d, q + 1);
            const ve : usize = value_end(d, v);
            if (ve > hi) { break; }
            const sp : i64 = jspan(v, ve);
            const good : bool = is_true(d, obj_get(d, sp, "ok"));
            if (good) { OKALL = OKALL + 1; }
            var t : usize = 0;
            while (t < 7) {
                if (key_is(d, p, ke, SAY_TARGET_IDS[t])) {
                    T_SP[t] = sp;
                    T_OK[t] = good;
                    const by : i64 = ts_jint(d, obj_get(d, sp, "bytes"), 0);
                    if (by > 0) { T_BYTES[t] = by as u64; }
                    if (good) {
                        OK7 = OK7 + 1;
                        SUM_BYTES = SUM_BYTES + T_BYTES[t];
                    }
                }
                t = t + 1;
            }
            p = skip_ws(d, ve);
            if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
        }
    }
    V_PARSED = !ts_has(d, T_ASTERR);
    V_DROPPED = arr_len(d, T_LEXD) > 0;
    V_SWALLOWED = arr_len(d, T_SWAL) > 0 or arr_len(d, T_DISC) > 0;
    T_HIRTEXT = obj_get(d, T_HIR, "text");
    T_HIRERR = obj_get(d, T_HIR, "error");
    V_HIR_OK = is_true(d, obj_get(d, T_HIR, "ok"));
    V_HIR_LINES = 0;
    if (V_HIR_OK) { V_HIR_LINES = ts_count_lf(d, T_HIRTEXT) + 1; }
    V_TC_OK = is_true(d, obj_get(d, T_TC, "ok"));
    V_TC_FATAL = ts_truthy(d, obj_get(d, T_TC, "fatal"));
    const msgs : i64 = obj_get(d, T_TC, "errors");
    const mn : u32 = arr_len(d, msgs);
    var wn : u32 = 0;
    var m : u32 = 0;
    while (m < mn) {
        if (ts_is_warning(d, arr_at(d, msgs, m))) { wn = wn + 1; }
        m = m + 1;
    }
    V_WARNS = wn;
    if (wn == 0) {
        const tw : i64 = ts_jint(d, obj_get(d, T_TC, "warnings"), 0);
        if (tw > 0) { V_WARNS = tw as u32; }
    }
    V_ERRS = ts_jint(d, obj_get(d, T_TC, "errorCount"), (mn as i64) - (V_WARNS as i64));
    return 0;
}

/// JavaScript truthiness of a JSON value: a non-empty string, a number that is not 0, true, an array or an object.
fn ts_truthy(d: []const u8, sp: i64) -> bool {
    const k : u8 = kind(d, sp);
    if (k == J_STRING) { return str_len(d, sp) > 0; }
    if (k == J_NUMBER) { return num_f64(d, sp) != 0.0; }
    if (k == J_TRUE or k == J_ARRAY or k == J_OBJECT) { return true; }
    return false;
}

/// How many line feeds the decoded string at sp holds.
fn ts_count_lf(d: []const u8, sp: i64) -> u32 {
    var c : u32 = 0;
    if (kind(d, sp) != J_STRING) { return 0; }
    const hi : usize = span_hi(sp) - 1;
    var p : usize = span_lo(sp) + 1;
    while (p < hi) {
        if (d[p] == 92 and p + 1 < hi) {
            const e : u32 = escape_at(d, p + 1, hi);
            if (e / 16 == 10) { c = c + 1; }
            p = p + 1 + ((e % 16) as usize);
        } else {
            p = p + 1;
        }
    }
    return c;
}

/// Does the decoded string at sp start with a line feed?
fn ts_starts_lf(d: []const u8, sp: i64) -> bool {
    if (kind(d, sp) != J_STRING or span_hi(sp) - span_lo(sp) < 3) { return false; }
    const p : usize = span_lo(sp) + 1;
    if (d[p] == 92 and p + 1 < span_hi(sp) - 1) { return escape_at(d, p + 1, span_hi(sp) - 1) / 16 == 10; }
    return false;
}

// --- the verdict of each stage ---------------------------------------------------------------------

/// 0 ok, 1 warn, 2 bad, for the chip of stage i of the answer.
fn ts_chip_cls(i: u32) -> u32 {
    if (i == 0) { return 0; }
    if (i == 1) {
        if (V_DROPPED) { return 1; }
        return 0;
    }
    if (i == 2) {
        if (!V_PARSED) { return 2; }
        if (V_SWALLOWED) { return 1; }
        return 0;
    }
    if (i == 3) {
        if (V_TC_FATAL or !V_PARSED) { return 2; }
        if (!V_TC_OK) { return 2; }
        if (V_WARNS > 0) { return 1; }
        return 0;
    }
    if (i == 4) {
        if (V_HIR_OK) { return 0; }
        return 2;
    }
    if (OK7 == (K_TARGETS as u32)) { return 0; }
    if (OK7 > 0) { return 1; }
    return 2;
}

fn ts_chip_count(o: []u8, n: u32, i: u32) -> u32 {
    const d : []const u8 = ts_d();
    if (i == 0) { return ts_fill1(o, n, SAY_CHIP_BYTES, W_V_JFMT, T_SBYTES); }
    if (i == 1) { return ts_fill1(o, n, SAY_CHIP_TOKENS, W_V_JFMT, T_TOKCOUNT); }
    if (i == 2) {
        if (!V_PARSED) { return ts_text(o, n, SAY_CHIP_STOPPED); }
        return ts_fill1(o, n, SAY_CHIP_NODES, W_V_JFMT, T_NODES);
    }
    if (i == 3) {
        if (V_TC_FATAL or !V_PARSED) { return ts_text(o, n, SAY_CHIP_STOPPED); }
        if (!V_TC_OK) { return ts_fill1(o, n, SAY_CHIP_ERRORS, W_V_GROUP, V_ERRS); }
        if (V_WARNS > 0) { return ts_fill1(o, n, SAY_CHIP_WARNINGS, W_V_GROUP, V_WARNS as i64); }
        return ts_text(o, n, SAY_CHIP_PASSED);
    }
    if (i == 4) {
        if (V_HIR_OK) { return ts_fill1(o, n, SAY_CHIP_LINES, W_V_GROUP, V_HIR_LINES as i64); }
        return ts_text(o, n, SAY_CHIP_STOPPED);
    }
    return ts_fill(o, n, SAY_CHIP_BACKENDS, W_V_PLAIN, OK7 as i64, W_V_PLAIN, (K_TARGETS as u32) as i64, W_V_NONE, 0);
}

// --- the six panels ------------------------------------------------------------------------------------

fn ts_utf8(o: []u8, n0: u32, cp: u32) -> u32 {
    var n : u32 = n0;
    const w : u32 = cp_utf8_len(cp);
    var j : u32 = 0;
    while (j < w) {
        n = put(o, n, cp_utf8_byte(cp, j));
        j = j + 1;
    }
    return n;
}

/// <pre class="ts-code">, and a second newline where the text starts with one (the HTML parser drops the first).
fn ts_pre_open(o: []u8, n: u32, lf: bool) -> u32 {
    const m : u32 = raw(o, n, "<pre class=\"ts-code\">");
    if (lf) { return put(o, m, 10); }
    return m;
}

/// The position of the first element of the array at sp, and of the element after the one at p.
fn ts_first(d: []const u8, sp: i64) -> usize {
    return skip_ws(d, span_lo(sp) + 1);
}

fn ts_after(d: []const u8, sp: i64, p: usize) -> usize {
    var q : usize = skip_ws(d, value_end(d, p));
    if (q < span_hi(sp) and d[q] == 44) { q = skip_ws(d, q + 1); }
    return q;
}

fn ts_nonempty(d: []const u8, sp: i64) -> bool {
    if (kind(d, sp) != J_ARRAY) { return false; }
    return ts_first(d, sp) + 1 < span_hi(sp);
}

fn ts_sourcepanel(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<p class=\"ts-facts\">");
    n = ts_fill(o, n, SAY_SOURCE_FACTS, W_V_JFMT, T_SBYTES, W_V_JFMT, T_SLINES, W_V_NONE, 0);
    n = raw(o, n, "</p><p class=\"ts-sub\">");
    var cnt : u32 = SRC_N;
    if (cnt > (K_SOURCE_HEX_BYTES as u32)) { cnt = K_SOURCE_HEX_BYTES as u32; }
    n = ts_fill1(o, n, SAY_SOURCE_HEX, W_V_PLAIN, cnt as i64);
    n = raw(o, n, "</p><div class=\"ts-bytes\">");
    var i : u32 = 0;
    while (i < cnt) {
        const b : u8 = SRC[i as usize];
        n = raw(o, n, "<span class=\"ts-byte\"><span class=\"ts-byte-ch\">");
        if (b == 10) { n = ts_utf8(o, n, 8629); }
        else { if (b == 32) { n = ts_utf8(o, n, 9251); }
        else { if (b > 32 and b < 127) { n = ts_esc(o, n, b); }
        else { n = ts_utf8(o, n, 183); } } }
        n = raw(o, n, "</span><span class=\"ts-byte-hex\">");
        const hi : u8 = b / 16;
        const lo : u8 = b % 16;
        if (hi < 10) { n = put(o, n, 48 + hi); } else { n = put(o, n, 87 + hi); }
        if (lo < 10) { n = put(o, n, 48 + lo); } else { n = put(o, n, 87 + lo); }
        n = raw(o, n, "</span></span>");
        i = i + 1;
    }
    n = raw(o, n, "</div><p class=\"ts-sub\">");
    n = ts_text(o, n, SAY_SOURCE_VIEW);
    n = raw(o, n, "</p>");
    n = ts_pre_open(o, n, SRC_N > 0 and SRC[0] == 10);
    n = ts_text(o, n, SRC[0..(SRC_N as usize)]);
    return raw(o, n, "</pre>");
}

fn ts_lexerpanel(o: []u8, n0: u32) -> u32 {
    const d : []const u8 = ts_d();
    var n : u32 = raw(o, n0, "<p class=\"ts-facts\">");
    n = ts_fill1(o, n, SAY_LEXER_FACTS, W_V_JFMT, T_TOKCOUNT);
    n = raw(o, n, "</p><p class=\"ts-legend\">");
    var c : usize = 0;
    while (c < 6) {
        n = raw(o, n, "<span style=\"color:var(--w-text)\">");
        n = ts_text(o, n, SAY_TOKEN_CLASSES[c]);
        n = raw(o, n, "</span>");
        c = c + 1;
    }
    n = raw(o, n, "</p><div class=\"ts-tokens\">");
    var shown : u32 = 0;
    var line : i64 = 0;
    if (kind(d, T_TOKENS) == J_ARRAY) {
        var p : usize = ts_first(d, T_TOKENS);
        while (p + 1 < span_hi(T_TOKENS) and shown < (K_MAX_TOKEN_CHIPS as u32)) {
            const t : i64 = jspan(p, value_end(d, p));
            const tl : i64 = obj_get(d, t, "line");
            const tk : i64 = obj_get(d, t, "kind");
            const tc : i64 = obj_get(d, t, "col");
            const lx : i64 = obj_get(d, t, "lexeme");
            if (kind(d, tl) != J_NUMBER or num_i64(d, tl) != line) {
                if (kind(d, tl) == J_NUMBER) { line = num_i64(d, tl); }
                n = raw(o, n, "<span class=\"ts-tok-line\" aria-hidden=\"true\">");
                n = ts_jstring(o, n, d, tl);
                n = raw(o, n, "</span>");
            }
            n = raw(o, n, "<span class=\"ts-tok\" style=\"--tok:var(--w-text)\" title=\"");
            n = ts_jstring(o, n, d, tk);
            n = raw(o, n, " ");
            n = ts_jstring(o, n, d, tl);
            n = raw(o, n, ":");
            n = ts_jstring(o, n, d, tc);
            n = raw(o, n, "\"><span class=\"ts-tok-lex\">");
            if (ts_has(d, lx)) { n = ts_jstr(o, n, d, lx); } else { n = ts_utf8(o, n, 160); }
            n = raw(o, n, "</span><span class=\"ts-tok-kind\">");
            n = ts_jstr(o, n, d, tk);
            n = raw(o, n, "</span></span>");
            shown = shown + 1;
            p = ts_after(d, T_TOKENS, p);
        }
    }
    n = raw(o, n, "</div>");
    const total : u32 = arr_len(d, T_TOKENS);
    if (total > shown) {
        n = raw(o, n, "<p class=\"ts-sub\">");
        n = ts_fill1(o, n, SAY_MORE, W_V_GROUP, (total - shown) as i64);
        n = raw(o, n, "</p>");
    }
    return n;
}

/// Is the JSON value at sp the string `lit`?
fn ts_jis(d: []const u8, sp: i64, lit: []const u8) -> bool {
    if (kind(d, sp) != J_STRING or str_len(d, sp) != (lit.len as u32)) { return false; }
    var k : usize = 0;
    while (k < lit.len) {
        if (str_byte(d, sp, k as u32) != lit[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// One row of the tree: the kind and what the node says of itself.
fn ts_noderow(o: []u8, n0: u32, d: []const u8, sp: i64, depth: u32) -> u32 {
    var n : u32 = raw(o, n0, "<div class=\"ts-node\" style=\"--d:");
    n = num(o, n, depth as u64);
    n = raw(o, n, "\"><span class=\"ts-n-kind\">");
    n = ts_jstring(o, n, d, obj_get(d, sp, "kind"));
    n = raw(o, n, "</span>");
    const nm : i64 = obj_get(d, sp, "name");
    if (ts_truthy(d, nm)) {
        n = raw(o, n, " <span class=\"ts-n-name\">");
        n = ts_jstring(o, n, d, nm);
        n = raw(o, n, "</span>");
    }
    const op : i64 = obj_get(d, sp, "op");
    if (ts_truthy(d, op)) {
        n = raw(o, n, " <span class=\"ts-n-op\">");
        n = ts_jstring(o, n, d, op);
        n = raw(o, n, "</span>");
    }
    const vl : i64 = obj_get(d, sp, "value");
    const vk : u8 = kind(d, vl);
    if (vk != J_NONE and vk != J_NULL and !(vk == J_STRING and str_len(d, vl) == 0)) {
        n = raw(o, n, " <span class=\"ts-n-val\">");
        if (ts_jis(d, obj_get(d, sp, "nodeKind"), "string")) { n = ts_jquote(o, n, d, vl); } else { n = ts_jstring(o, n, d, vl); }
        n = raw(o, n, "</span>");
    }
    const ps : i64 = obj_get(d, sp, "params");
    if (ts_nonempty(d, ps)) {
        n = raw(o, n, " <span class=\"ts-n-type\">(");
        var q : usize = ts_first(d, ps);
        var first : bool = true;
        while (q + 1 < span_hi(ps)) {
            const pp : i64 = jspan(q, value_end(d, q));
            if (!first) { n = raw(o, n, ", "); }
            first = false;
            n = ts_jstring(o, n, d, obj_get(d, pp, "name"));
            n = raw(o, n, ": ");
            n = ts_jstring(o, n, d, obj_get(d, pp, "type"));
            q = ts_after(d, ps, q);
        }
        n = raw(o, n, ")</span>");
    }
    const rt : i64 = obj_get(d, sp, "returnType");
    const ty : i64 = obj_get(d, sp, "type");
    if (ts_truthy(d, rt)) {
        n = raw(o, n, " <span class=\"ts-n-type\">-> ");
        n = ts_jstring(o, n, d, rt);
        n = raw(o, n, "</span>");
    } else {
        if (ts_truthy(d, ty)) {
            n = raw(o, n, " <span class=\"ts-n-type\">: ");
            n = ts_jstring(o, n, d, ty);
            n = raw(o, n, "</span>");
        }
    }
    return raw(o, n, "</div>");
}

pub var TREE_MORE : u32 = 0;

/// The tree, depth first: the first K_MAX_TREE_ROWS rows are written, the rest counted.
fn ts_tree(o: []u8, n0: u32, d: []const u8, ast: i64) -> u32 {
    var n : u32 = raw(o, n0, "<div class=\"ts-tree\">");
    var count : u32 = 0;
    var more : u32 = 0;
    if (count < (K_MAX_TREE_ROWS as u32)) {
        n = ts_noderow(o, n, d, ast, 0);
        count = count + 1;
    } else {
        more = more + 1;
    }
    var h : u32 = 0;
    const c0 : i64 = obj_get(d, ast, "children");
    if (ts_nonempty(d, c0)) {
        ST_POS[0] = ts_first(d, c0) as u32;
        ST_END[0] = span_hi(c0) as u32;
        h = 1;
    }
    while (h > 0) {
        const lv : usize = (h - 1) as usize;
        if (ST_POS[lv] + 1 >= ST_END[lv]) {
            h = h - 1;
        } else {
            const p : usize = ST_POS[lv] as usize;
            const e : usize = value_end(d, p);
            var q : usize = skip_ws(d, e);
            if (q < (ST_END[lv] as usize) and d[q] == 44) { q = skip_ws(d, q + 1); }
            ST_POS[lv] = q as u32;
            const child : i64 = jspan(p, e);
            if (count < (K_MAX_TREE_ROWS as u32)) {
                n = ts_noderow(o, n, d, child, h);
                count = count + 1;
            } else {
                more = more + 1;
            }
            const cc : i64 = obj_get(d, child, "children");
            if (ts_nonempty(d, cc) and h < W_STACK) {
                ST_POS[h as usize] = ts_first(d, cc) as u32;
                ST_END[h as usize] = span_hi(cc) as u32;
                h = h + 1;
            }
        }
    }
    TREE_MORE = more;
    return raw(o, n, "</div>");
}

fn ts_parserpanel(o: []u8, n0: u32) -> u32 {
    const d : []const u8 = ts_d();
    if (!V_PARSED) {
        var m : u32 = raw(o, n0, "<p class=\"ts-bad\">");
        m = ts_fill1(o, m, SAY_PARSE_STOPPED, W_V_JSTR, T_ASTERR);
        return raw(o, m, "</p>");
    }
    var n : u32 = raw(o, n0, "<p class=\"ts-facts\">");
    n = ts_fill(o, n, SAY_PARSER_FACTS, W_V_JFMT, T_NODES, W_V_JFMT, T_ASTDEPTH, W_V_JFMT, T_TOPLEVEL);
    n = raw(o, n, "</p>");
    n = ts_tree(o, n, d, T_AST);
    if (TREE_MORE > 0) {
        n = raw(o, n, "<p class=\"ts-sub\">");
        n = ts_fill1(o, n, SAY_MORE, W_V_GROUP, TREE_MORE as i64);
        n = raw(o, n, "</p>");
    }
    return n;
}

fn ts_typecheckpanel(o: []u8, n0: u32) -> u32 {
    const d : []const u8 = ts_d();
    if (!V_PARSED) {
        var m : u32 = raw(o, n0, "<p class=\"ts-bad\">");
        m = ts_fill1(o, m, SAY_PARSE_STOPPED, W_V_JSTR, T_ASTERR);
        return raw(o, m, "</p>");
    }
    const fatal : i64 = obj_get(d, T_TC, "fatal");
    if (V_TC_FATAL) {
        var m : u32 = raw(o, n0, "<p class=\"ts-bad\">");
        m = ts_fill1(o, m, SAY_TC_FATAL, W_V_JSTR, fatal);
        return raw(o, m, "</p>");
    }
    var n : u32 = n0;
    if (!V_TC_OK) {
        n = raw(o, n, "<p class=\"ts-verdict is-bad\">");
        n = ts_fill(o, n, SAY_TC_ERRORS, W_V_GROUP, V_ERRS, W_V_GROUP, V_WARNS as i64, W_V_NONE, 0);
    } else {
        if (V_WARNS > 0) {
            n = raw(o, n, "<p class=\"ts-verdict is-warn\">");
            n = ts_fill1(o, n, SAY_TC_OK_WARN, W_V_GROUP, V_WARNS as i64);
        } else {
            n = raw(o, n, "<p class=\"ts-verdict is-ok\">");
            n = ts_text(o, n, SAY_TC_OK);
        }
    }
    n = raw(o, n, "</p>");
    const msgs : i64 = obj_get(d, T_TC, "errors");
    if (ts_nonempty(d, msgs)) {
        n = raw(o, n, "<ul class=\"ts-msgs\">");
        var q : usize = ts_first(d, msgs);
        while (q + 1 < span_hi(msgs)) {
            const m : i64 = jspan(q, value_end(d, q));
            if (ts_is_warning(d, m)) { n = raw(o, n, "<li class=\"is-warn\">"); } else { n = raw(o, n, "<li class=\"is-bad\">"); }
            n = ts_jstring(o, n, d, m);
            n = raw(o, n, "</li>");
            q = ts_after(d, msgs, q);
        }
        n = raw(o, n, "</ul>");
    }
    if (!V_TC_OK and OKALL > 0) {
        n = raw(o, n, "<p class=\"ts-note\">");
        n = ts_text(o, n, SAY_TC_NOT_A_GATE);
        n = raw(o, n, "</p>");
    }
    n = raw(o, n, "<p class=\"ts-sub\">");
    n = ts_text(o, n, SAY_TC_LIMITS);
    return raw(o, n, "</p>");
}

fn ts_hirpanel(o: []u8, n0: u32) -> u32 {
    const d : []const u8 = ts_d();
    if (!V_HIR_OK) {
        var m : u32 = raw(o, n0, "<p class=\"ts-bad\">");
        var e : i64 = T_ASTERR;
        if (!ts_has(d, e)) { e = T_HIRERR; }
        m = ts_fill1(o, m, SAY_HIR_FAILED, W_V_JSTR, e);
        return raw(o, m, "</p>");
    }
    var n : u32 = raw(o, n0, "<p class=\"ts-facts\">");
    n = ts_fill1(o, n, SAY_HIR_FACTS, W_V_GROUP, V_HIR_LINES as i64);
    n = raw(o, n, "</p><p class=\"ts-note\">");
    n = ts_text(o, n, SAY_HIR_FEEDS);
    n = raw(o, n, "</p>");
    n = ts_pre_open(o, n, ts_starts_lf(d, T_HIRTEXT));
    n = ts_jstr(o, n, d, T_HIRTEXT);
    return raw(o, n, "</pre>");
}

fn ts_backendspanel(o: []u8, n0: u32) -> u32 {
    const d : []const u8 = ts_d();
    var n : u32 = raw(o, n0, "<p class=\"ts-facts\">");
    n = ts_fill(o, n, SAY_BACKENDS_FACTS, W_V_PLAIN, OK7 as i64, W_V_PLAIN, (K_TARGETS as u32) as i64, W_V_GROUP, SUM_BYTES as i64);
    n = raw(o, n, "</p><div class=\"ts-targets\" role=\"group\" aria-label=\"");
    n = ts_text(o, n, SAY_STAGE_NAMES[5]);
    n = raw(o, n, "\">");
    var i : usize = 0;
    while (i < 7) {
        n = raw(o, n, "<button type=\"button\" class=\"t27-btn ts-target");
        if (!T_OK[i]) { n = raw(o, n, " is-bad"); }
        n = raw(o, n, "\" aria-pressed=\"");
        if (TARGET == (i as u32)) { n = raw(o, n, "true"); } else { n = raw(o, n, "false"); }
        n = raw(o, n, "\">");
        n = ts_text(o, n, SAY_TARGET_NAMES[i]);
        n = raw(o, n, " <span class=\"ts-target-bytes\">");
        if (T_OK[i]) { n = ts_fill1(o, n, SAY_TARGET_BYTES, W_V_GROUP, T_BYTES[i] as i64); } else { n = ts_text(o, n, SAY_CHIP_STOPPED); }
        n = raw(o, n, "</span></button>");
        i = i + 1;
    }
    n = raw(o, n, "</div>");
    const t : usize = TARGET as usize;
    if (!T_OK[t]) {
        n = raw(o, n, "<p class=\"ts-bad\">");
        var e : i64 = obj_get(d, T_SP[t], "error");
        if (!ts_has(d, e)) { e = T_ASTERR; }
        n = ts_fill1(o, n, SAY_TARGET_FAILED, W_V_JSTR, e);
        return raw(o, n, "</p>");
    }
    const ne : i64 = obj_get(d, T_SP[t], "notEmitted");
    if (ts_truthy(d, ne)) {
        n = raw(o, n, "<p class=\"ts-note\">");
        n = ts_fill1(o, n, SAY_NOT_EMITTED, W_V_JFMT, ne);
        n = raw(o, n, "</p>");
    }
    const code : i64 = obj_get(d, T_SP[t], "code");
    n = ts_pre_open(o, n, ts_starts_lf(d, code));
    n = ts_jstr(o, n, d, code);
    return raw(o, n, "</pre>");
}

fn ts_stagepanel(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<h2 class=\"ts-stage-name\">");
    n = num(o, n, (STAGE + 1) as u64);
    n = raw(o, n, ". ");
    n = ts_text(o, n, SAY_STAGE_NAMES[STAGE as usize]);
    n = raw(o, n, "</h2><p class=\"ts-stage-line\">");
    n = ts_text(o, n, SAY_STAGE_LINES[STAGE as usize]);
    n = raw(o, n, "</p>");
    if (STAGE == 0) { return ts_sourcepanel(o, n); }
    if (STAGE == 1) { return ts_lexerpanel(o, n); }
    if (STAGE == 2) { return ts_parserpanel(o, n); }
    if (STAGE == 3) { return ts_typecheckpanel(o, n); }
    if (STAGE == 4) { return ts_hirpanel(o, n); }
    return ts_backendspanel(o, n);
}

// --- the alert above the stages ------------------------------------------------------------------------------

fn ts_alert_items() -> u32 {
    const d : []const u8 = ts_d();
    return arr_len(d, T_LEXD) + arr_len(d, T_SWAL) + arr_len(d, T_DISC);
}

fn ts_alertkids(o: []u8, n0: u32) -> u32 {
    const d : []const u8 = ts_d();
    var n : u32 = n0;
    if (!V_PARSED) {
        n = raw(o, n, "<p class=\"ts-alert-title is-bad\">");
        n = ts_fill1(o, n, SAY_PARSE_STOPPED, W_V_JSTR, T_ASTERR);
        n = raw(o, n, "</p>");
    }
    if (ts_alert_items() > 0) {
        n = raw(o, n, "<p class=\"ts-alert-title\">");
        n = ts_text(o, n, SAY_DROPPED_TITLE);
        n = raw(o, n, "</p><p class=\"ts-alert-why\">");
        n = ts_text(o, n, SAY_DROPPED_WHY);
        n = raw(o, n, "</p><ul>");
        var nonascii : bool = false;
        if (kind(d, T_LEXD) == J_ARRAY) {
            var p : usize = ts_first(d, T_LEXD);
            while (p + 1 < span_hi(T_LEXD)) {
                const it : i64 = jspan(p, value_end(d, p));
                const ch : i64 = obj_get(d, it, "char");
                n = raw(o, n, "<li>");
                n = ts_fill(o, n, SAY_DROP_LEXER, W_V_JRAW, obj_get(d, it, "line"), W_V_JQUOTE, ch, W_V_NONE, 0);
                n = raw(o, n, "</li>");
                if (ts_first_cp(d, ch) > 127) { nonascii = true; }
                p = ts_after(d, T_LEXD, p);
            }
        }
        if (kind(d, T_SWAL) == J_ARRAY) {
            var p : usize = ts_first(d, T_SWAL);
            while (p + 1 < span_hi(T_SWAL)) {
                const it : i64 = jspan(p, value_end(d, p));
                n = raw(o, n, "<li>");
                n = ts_fill(o, n, SAY_DROP_SWALLOWED, W_V_JRAW, obj_get(d, it, "line"), W_V_JSTR, obj_get(d, it, "what"), W_V_NONE, 0);
                n = raw(o, n, "</li>");
                p = ts_after(d, T_SWAL, p);
            }
        }
        if (kind(d, T_DISC) == J_ARRAY) {
            var p : usize = ts_first(d, T_DISC);
            while (p + 1 < span_hi(T_DISC)) {
                const it : i64 = jspan(p, value_end(d, p));
                n = raw(o, n, "<li>");
                n = ts_fill1(o, n, SAY_DROP_DISCARDED, W_V_JSTR, it);
                n = raw(o, n, "</li>");
                p = ts_after(d, T_DISC, p);
            }
        }
        n = raw(o, n, "</ul>");
        if (nonascii) {
            n = raw(o, n, "<p class=\"ts-alert-why\">");
            n = ts_text(o, n, SAY_DROP_BYTES_NOTE);
            n = raw(o, n, "</p>");
        }
    }
    return n;
}

/// The first code point of the string at sp (a raw byte above 127 stands for itself).
fn ts_first_cp(d: []const u8, sp: i64) -> u32 {
    if (kind(d, sp) != J_STRING or span_hi(sp) - span_lo(sp) < 3) { return 0; }
    const p : usize = span_lo(sp) + 1;
    if (d[p] == 92 and p + 1 < span_hi(sp) - 1) { return escape_at(d, p + 1, span_hi(sp) - 1) / 16; }
    return d[p] as u32;
}

// --- the page ---------------------------------------------------------------------------------------------------

fn ts_ms() -> i64 {
    var n : u32 = 0;
    if (MS < 10.0) { n = js_to_fixed(SCR[0..64], 0, MS, 1); } else { n = js_str_num(SCR[0..64], 0, js_round(MS)); }
    return jspan(0, n as usize);
}

fn ts_errortext(o: []u8, n: u32) -> u32 {
    if (ERR_KIND == 1) { return ts_fill(o, n, SAY_TOO_BIG, W_V_GROUP, ERR_BYTES as i64, W_V_GROUP, K_MAX_SOURCE_BYTES as i64, W_V_NONE, 0); }
    return ts_fill1(o, n, SAY_CRASHED, W_V_MSG, 0);
}

fn ts_factstext(o: []u8, n: u32) -> u32 {
    if (FACTS_MODE == 0) { return ts_text(o, n, SAY_LOADING); }
    if (FACTS_MODE == 1) { return ts_fill1(o, n, SAY_LOAD_FAILED, W_V_LMSG, 0); }
    if (FACTS_MODE == 2) { return ts_text(o, n, SAY_EDITOR_WAIT); }
    if (FACTS_MODE == 3) { return ts_errortext(o, n); }
    return ts_fill(o, n, SAY_EDITOR_FACTS, W_V_JFMT, T_SLINES, W_V_JFMT, T_SBYTES, W_V_SCR, ts_ms());
}

pub fn w_render(dst: []u8) -> u32 {
    var n : u32 = raw(dst, 0, "<div class=\"ts\"><div class=\"ts-edit\"><div class=\"ts-examples\"><span class=\"ts-label\">");
    n = ts_text(dst, n, SAY_EXAMPLES_LABEL);
    n = raw(dst, n, "</span>");
    var i : u32 = 0;
    while (i < W_EXAMPLES) {
        n = raw(dst, n, "<button type=\"button\" class=\"t27-btn\" aria-pressed=\"");
        if (EX_PRESSED == i) { n = raw(dst, n, "true"); } else { n = raw(dst, n, "false"); }
        n = raw(dst, n, "\">");
        n = ts_text(dst, n, SAY_EXAMPLE_NAMES[i as usize]);
        n = raw(dst, n, "</button>");
        i = i + 1;
    }
    n = raw(dst, n, "</div><label class=\"ts-label ts-editor-label\">");
    n = ts_text(dst, n, SAY_EDITOR_LABEL);
    n = raw(dst, n, "</label><textarea class=\"ts-editor\" spellcheck=\"false\" autocapitalize=\"off\" autocomplete=\"off\"");
    n = attr(dst, n, "aria-label", SAY_EDITOR_LABEL);
    n = raw(dst, n, " rows=\"12\"></textarea><p class=\"ts-facts");
    if (FACTS_BAD) { n = raw(dst, n, " is-bad"); }
    n = raw(dst, n, "\" role=\"status\">");
    n = ts_factstext(dst, n);
    n = raw(dst, n, "</p></div><div class=\"ts-stages\"><div class=\"ts-alert");
    if (RES_OK and !V_PARSED) { n = raw(dst, n, " is-bad"); }
    n = raw(dst, n, "\"");
    if (!HAVE or (ts_alert_items() == 0 and V_PARSED)) { n = raw(dst, n, " hidden=\"\""); }
    n = raw(dst, n, ">");
    if (RES_OK) { n = ts_alertkids(dst, n); }
    n = raw(dst, n, "</div>");
    n = raw(dst, n, "<div class=\"ts-chips\" role=\"group\"");
    n = attr(dst, n, "aria-label", SAY_STAGES_LABEL);
    n = raw(dst, n, ">");
    i = 0;
    while (i < W_STAGES) {
        if (i > 0) {
            n = raw(dst, n, "<span class=\"ts-arrow\" aria-hidden=\"true\">");
            n = ts_utf8(dst, n, 8594);
            n = raw(dst, n, "</span>");
        }
        n = raw(dst, n, "<button type=\"button\" class=\"ts-chip\" aria-pressed=\"");
        if (STAGE_DRAWN and STAGE == i) { n = raw(dst, n, "true"); } else { n = raw(dst, n, "false"); }
        n = raw(dst, n, "\"");
        if (HAVE) {
            const cl : u32 = ts_chip_cls(i);
            if (cl == 0) { n = raw(dst, n, " data-state=\"ok\""); }
            if (cl == 1) { n = raw(dst, n, " data-state=\"warn\""); }
            if (cl == 2) { n = raw(dst, n, " data-state=\"bad\""); }
        } else {
            if (FIRST) { n = raw(dst, n, " data-state=\"bad\""); }
        }
        n = raw(dst, n, "><span class=\"ts-chip-name\"><span class=\"ts-dot\" aria-hidden=\"true\"></span>");
        n = ts_text(dst, n, SAY_STAGE_NAMES[i as usize]);
        n = raw(dst, n, "</span><span class=\"ts-chip-count\">");
        if (HAVE) { n = ts_chip_count(dst, n, i); } else { if (FIRST) { n = ts_text(dst, n, SAY_CHIP_STOPPED); } }
        n = raw(dst, n, "</span></button>");
        i = i + 1;
    }
    n = raw(dst, n, "</div><section class=\"ts-panel\" aria-live=\"off\">");
    if (HAVE) {
        n = ts_stagepanel(dst, n);
    } else {
        if (FIRST) {
            n = raw(dst, n, "<p class=\"ts-bad\">");
            n = ts_errortext(dst, n);
            n = raw(dst, n, "</p>");
        }
    }
    n = raw(dst, n, "</section></div></div>");
    if (!ok(n)) { return 0; }
    return n;
}

// --- events --------------------------------------------------------------------------------------------------------

fn ts_load_example(i: u32) -> u32 {
    const s : []const u8 = SAY_EXAMPLE_SOURCES[i as usize];
    var k : usize = 0;
    while (k < s.len and k < (W_SRC_CAP as usize)) {
        ED[k] = s[k];
        k = k + 1;
    }
    ED_N = k as u32;
    ED_BYTES = s.len as u32;
    ED_SET = true;
    return 0;
}

/// run(): the text in the box is what the compiler is asked about; too long a text is refused here.
fn ts_run() -> u32 {
    TIMER_GEN = (TIMER_GEN + 1) % 256;
    var k : usize = 0;
    while (k < (ED_N as usize)) {
        SRC[k] = ED[k];
        k = k + 1;
    }
    SRC_N = ED_N;
    SRC_BYTES = ED_BYTES;
    if (SRC_BYTES > K_MAX_SOURCE_BYTES) {
        HAVE = false;
        ERR_KIND = 1;
        ERR_BYTES = SRC_BYTES;
        FIRST = true;
        FACTS_MODE = 3;
        FACTS_BAD = true;
        REQ = false;
    } else {
        REQ = true;
    }
    return 0;
}

pub fn w_init(h: []const u8) -> u32 {
    EFF_TIMER = false;
    STAGE = 0;
    TARGET = 0;
    EX_PRESSED = 0;
    HAVE = false;
    STAGE_DRAWN = false;
    RES_OK = false;
    FIRST = false;
    FACTS_MODE = 0;
    FACTS_BAD = false;
    ERR_KIND = 0;
    ESCAPED = false;
    ts_load_example(0);
    return ts_run();
}

pub fn w_input(i: u32, s: []const u8) -> u32 {
    EFF_TIMER = false;
    var k : usize = 0;
    while (k < s.len and k < (W_SRC_CAP as usize)) {
        ED[k] = s[k];
        k = k + 1;
    }
    ED_N = k as u32;
    ED_BYTES = s.len as u32;
    EX_PRESSED = 255;
    FACTS_MODE = 2;
    TIMER_GEN = (TIMER_GEN + 1) % 256;
    EFF_TIMER = true;
    return 0;
}

pub fn w_timer(id: u32) -> u32 {
    EFF_TIMER = false;
    if (id == TIMER_GEN) { ts_run(); }
    return 0;
}

pub fn w_tab(i: u32, shift: u32, key: []const u8) -> u32 {
    if (same_bytes(key, key.len as u32, "Escape")) {
        ESCAPED = true;
        return 0;
    }
    var r : u32 = 0;
    if (same_bytes(key, key.len as u32, "Tab") and shift == 0 and !ESCAPED) { r = W_TAB_SPACES; }
    ESCAPED = false;
    return r;
}

pub fn w_value(i: u32, dst: []u8) -> u32 {
    if (i == 0 and ED_SET) {
        var k : usize = 0;
        while (k < (ED_N as usize) and k < dst.len) {
            dst[k] = ED[k];
            k = k + 1;
        }
        ED_SET = false;
        return k as u32;
    }
    return 4294967295;
}

pub fn w_click(i: u32) -> u32 {
    EFF_TIMER = false;
    if (i < W_EXAMPLES) {
        EX_PRESSED = i;
        ts_load_example(i);
        return ts_run();
    }
    if (i < W_EXAMPLES + W_STAGES) {
        STAGE = i - W_EXAMPLES;
        STAGE_DRAWN = true;
        return 0;
    }
    if (i < W_EXAMPLES + W_STAGES + (K_TARGETS as u32)) { TARGET = i - W_EXAMPLES - W_STAGES; }
    return 0;
}

pub fn w_effect(k: u32, dst: []u8) -> u32 {
    if (EFF_TIMER and k == 0) {
        dst[0] = 116;
        dst[1] = TIMER_GEN as u8;
        const ms : u32 = K_DEBOUNCE_MS as u32;
        var n : u32 = 2;
        n = n + dec_to(dst[2..], ms as u64);
        return n;
    }
    return 0;
}

pub fn w_compile_need(dst: []u8) -> u32 {
    if (!REQ) { return 0; }
    var k : usize = 0;
    while (k < (SRC_N as usize) and k < dst.len) {
        dst[k] = SRC[k];
        k = k + 1;
    }
    return (k as u32) + 1;
}

fn ts_keep(dst: []u8, s: []const u8) -> u32 {
    var k : usize = 0;
    while (k < s.len and k < dst.len) {
        dst[k] = s[k];
        k = k + 1;
    }
    return k as u32;
}

pub fn w_compile_give(s: []const u8, ok_: u32, t0: f64, t1: f64) -> u32 {
    REQ = false;
    if (ok_ == 0 and s.len <= (W_RES_CAP as usize)) {
        var k : usize = 0;
        while (k < s.len) {
            RES[k] = s[k];
            k = k + 1;
        }
        RES_N = s.len as u32;
        ts_index();
        HAVE = true;
        STAGE_DRAWN = true;
        RES_OK = true;
        FIRST = true;
        ERR_KIND = 0;
        FACTS_MODE = 4;
        FACTS_BAD = false;
        MS = t1 - t0;
        return 0;
    }
    if (ok_ == 2) {
        LMSG_N = ts_keep(LMSG[0..1024], s);
        FACTS_MODE = 1;
        FACTS_BAD = true;
        return 0;
    }
    // the compiler trapped (or its answer did not fit): the stages have nothing to show
    if (ok_ == 0) {
        MSG_N = num(MSG[0..1024], 0, s.len as u64);
    } else {
        MSG_N = ts_keep(MSG[0..1024], s);
    }
    HAVE = false;
    ERR_KIND = 2;
    FIRST = true;
    FACTS_MODE = 3;
    FACTS_BAD = true;
    return 0;
}

/// The splicer follows only the names a module itself mentions, not the names its imported functions
/// mention. This anchor mentions every helper the writer, the JSON reader and the number rules call.
/// Never called.
pub fn imports_anchor(o: []u8, s: []const u8, m: []u32) -> u32 {
    var n : u32 = 0;
    n = n + (ok(0) as u32);
    n = n + OVER;
    n = n + put(o, 0, 0);
    n = n + raw(o, 0, s);
    n = n + put_escaped(o, 0, 0);
    n = n + text(o, 0, s);
    n = n + num(o, 0, 0);
    n = n + attr(o, 0, s, s);
    n = n + fill(o, 0, s, s, s, s, 0);
    n = n + fill_named(o, 0, s, s, s, s, s, s, s, s, s, s, s, s, s);
    n = n + dec_to(o, 0);
    n = n + (name_is(s, 0, 0, s) as u32);
    n = n + (is_word_byte(0) as u32);
    n = n + (H_LT as u32);
    n = n + (H_GT as u32);
    n = n + (H_AMP as u32);
    n = n + (H_QUOTE as u32);
    n = n + (H_APOS as u32);
    n = n + (H_SPACE as u32);
    n = n + (H_SLASH as u32);
    n = n + (H_EQ as u32);
    n = n + num_grouped(o, 0, 0);
    n = n + ((NO_SPAN < 0) as u32);
    n = n + ((SPAN > 0) as u32);
    n = n + (J_NONE as u32);
    n = n + (J_OBJECT as u32);
    n = n + (J_ARRAY as u32);
    n = n + (J_STRING as u32);
    n = n + (J_NUMBER as u32);
    n = n + (J_TRUE as u32);
    n = n + (J_FALSE as u32);
    n = n + (J_NULL as u32);
    n = n + (jspan(0, 0) as u32);
    n = n + (span_lo(0) as u32);
    n = n + (span_hi(0) as u32);
    n = n + (skip_ws(s, 0) as u32);
    n = n + (string_end(s, 0) as u32);
    n = n + (value_end(s, 0) as u32);
    n = n + (root(s) as u32);
    n = n + (kind(s, 0) as u32);
    n = n + (key_is(s, 0, 0, s) as u32);
    n = n + (obj_get(s, 0, s) as u32);
    n = n + arr_len(s, 0);
    n = n + (arr_at(s, 0, 0) as u32);
    n = n + hex4(s, 0);
    n = n + escape_at(s, 0, 0);
    n = n + cp_utf8_len(0);
    n = n + (cp_utf8_byte(0, 0) as u32);
    n = n + str_len(s, 0);
    n = n + (str_byte(s, 0, 0) as u32);
    n = n + JN_OVER;
    n = n + JN_CAP;
    n = n + ((JN_TWO52 > 0.0) as u32);
    n = n + ((JN_TWO53 > 0.0) as u32);
    n = n + jn_put(o, 0, 0);
    n = n + jn_raw(o, 0, s);
    n = n + jn_digits(o, 0);
    n = n + jn_mul(o, 0, 0);
    n = n + jn_mul2(o, 0, 0);
    n = n + jn_mul5(o, 0, 0);
    n = n + jn_shift(o, 0, 0);
    n = n + (jn_cmp(s, s, 0) as u32);
    n = n + (jn_expo(0.0) as u32);
    n = n + (jn_mant(0.0) as u32);
    n = n + ((jn_make(0, 0) > 0.0) as u32);
    n = n + jn_exact(o, 0, 0);
    n = n + jn_fscale(0);
    n = n + (js_is_nan(0.0) as u32);
    n = n + ((js_nan(0.0) > 0.0) as u32);
    n = n + ((js_inf(1.0) > 0.0) as u32);
    n = n + ((js_floor(0.0) > 0.0) as u32);
    n = n + ((js_ceil(0.0) > 0.0) as u32);
    n = n + ((js_max(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_min(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_round(0.0) > 0.0) as u32);
    n = n + (jn_shortest(o, 1.0) as u32);
    n = n + jn_copy(o, s, 0);
    n = n + jn_put_run(o, 0, s, 0, 0);
    n = n + jn_layout(o, 0, s, 0, 0);
    n = n + js_str_num(o, 0, 0.0);
    n = n + js_to_fixed(o, 0, 0.0, 0);
    n = n + js_locale_num(o, 0, 0.0);
