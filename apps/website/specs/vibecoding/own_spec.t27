// SPDX-License-Identifier: Apache-2.0
; Vibecoding, lesson 25: A spec for your own idea.
; An idea is ready to hand to an agent when you can name its one input, its one output and the
; one test that tells you it is done. This spec is that sentence as a program, for a made-up
; idea: a reading log that takes one book title and answers with how many books are logged.
; Change a number below and see which test goes red. Ready is one of each: 1 x 1 x 1 = 1.
; phi^2 + 1/phi^2 = 3 | TRINITY

module vibecoding_own_spec;

; The idea, in numbers a beginner can count.
pub const IDEA_INPUTS : u8 = 1;
pub const IDEA_OUTPUTS : u8 = 1;
pub const IDEA_TESTS : u8 = 1;

test the_reading_log_has_one_input {
    assert IDEA_INPUTS == 1;
}

test the_reading_log_has_one_output {
    assert IDEA_OUTPUTS == 1;
}

test the_reading_log_has_a_test_that_says_done {
    assert IDEA_TESTS >= 1;
}

test the_idea_is_ready_to_hand_over {
    assert IDEA_INPUTS * IDEA_OUTPUTS * IDEA_TESTS == 1;
}
