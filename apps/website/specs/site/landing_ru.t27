test no_view_is_on_the_page_twice_and_the_roadmap_duplicate_is_gone {
    const n : u32 = page_landing_ru(OUT[0..]);
    var dup : u32 = 0;
    var v : u32 = N_LESSONS;
    while (v < N_VIEWS) {
        const m : u32 = attr(SRC_BUF[0..], 0, "src", VIEW_SRCS[v as usize]);
        if (!lr_has_doc(v)) { if (pk_count(OUT[0..], n, SRC_BUF[0..m]) != 1) { dup = dup + 1; } }
        v = v + 1;
    }
    assert dup == 0;
    assert N_VIEWS == 56;
    assert pk_count(OUT[0..], n, "q-roadmap") == 0;
}


/// One item design (owner 2026-11-21): Y, X and Z share one rule set, written once; nothing per rail repeats its font
/// size or its active colour, and the three menus meet with no gap.
test one_item_design_serves_y_x_and_z_once {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, ".rail>a,.zr a,.x .card,.x .tile,.top>a,.side>a,.side>span{position:relative;display:flex;") == 1;
    assert pk_count(OUT[0..], n, "font:600 10px/1.15 var(--mono);letter-spacing:.04em;text-transform:uppercase;") == 1;
    assert pk_count(OUT[0..], n, ".rail .ico,.side .ico,.zr .ico,.x .ico{flex:none;width:22px;height:22px;margin:0}") == 1;
    assert pk_count(OUT[0..], n, ".rail .key,.zr .key,.x .idx{") == 1;
    assert pk_count(OUT[0..], n, "{background:var(--text);color:var(--bg);opacity:1;outline:0}") == 1;
    assert pk_count(OUT[0..], n, ".rail>*") == 0;
    assert pk_count(OUT[0..], n, ".zr a{") == 0;
    assert pk_count(OUT[0..], n, ".zr span{") == 0;
    assert pk_count(OUT[0..], n, ".app::after{") == 1;
    assert pk_count(OUT[0..], n, ".app::after{content:\"\";grid-area:1/1/4/5;border:1px solid var(--card-line);pointer-events:none}") == 1;
    assert pk_count(OUT[0..], n, "grid-template-columns:calc(var(--tile) + 1px) minmax(0,1fr) auto calc(var(--tile) + 1px);grid-template-rows:auto minmax(0,1fr) auto auto;gap:0;padding:6px;") == 1;
    assert pk_count(OUT[0..], n, ".x{margin:0;padding:0;gap:0;") == 1;
    assert pk_has(OUT[0..], n, ".hero{display:none}");
}

/// Layout (owner 2026-11-21): Y is the TOP row (logo tile first), X the LEFT column, Z the BOTTOM row, the links and counters the RIGHT column,
/// the display in the middle. Every tab of the three menus is one square tile with the icon above the text, and the selected tab keeps it.
test y_is_top_x_is_left_z_is_bottom_links_are_right_and_every_tab_is_a_square {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, ".top .rail{display:contents}") == 1;
    assert pk_count(OUT[0..], n, ".app>.top{grid-area:1/1/2/5!important;display:flex;flex-direction:row;") == 1;
    assert pk_count(OUT[0..], n, ".zr{grid-area:3/1/4/5!important;flex-direction:row;overflow-x:auto;") == 1;
    assert pk_count(OUT[0..], n, ".x,#s-lessons{grid-area:2/1/3/2!important;grid-template-columns:minmax(0,1fr);") == 1;
    assert pk_count(OUT[0..], n, "<nav class=\"top glass\"") == 1;
    assert pk_count(OUT[0..], n, "<nav class=\"rail\"") == 1;
    assert pk_count(OUT[0..], n, ".side{grid-area:2/4/3/5!important;display:flex;flex-direction:column;") == 1;
    assert pk_count(OUT[0..], n, "<nav class=\"side\"") == 1;
    assert pk_count(OUT[0..], n, "target=\"_blank\" rel=\"noopener\"") == N_FOOT + 2;
    assert pk_count(OUT[0..], n, "<span title=\"КУРСЫ\"><b>12</b>") == 1;
    assert pk_count(OUT[0..], n, ".panel{grid-area:2/2/3/3!important;") == 1;
    assert pk_count(OUT[0..], n, ".st:target~main .panel{grid-area:2/2/3/4!important}") == 0;
    assert pk_count(OUT[0..], n, ".x .grid,.x .hub,#s-lessons .hub{display:flex;flex-direction:column;") == 1;
    assert pk_count(OUT[0..], n, ".rail>a,.zr a,.x .card,.x .tile,.top>a,.side>a,.side>span{position:relative;") == 1;
    assert pk_count(OUT[0..], n, "flex-direction:column;align-items:center;justify-content:center;box-sizing:border-box;flex:none;width:var(--tile);height:var(--tile);aspect-ratio:1/1;") == 1;
    assert pk_count(OUT[0..], n, "flex:none;width:var(--tile);height:var(--tile);aspect-ratio:1/1;") == 1;
    assert pk_count(OUT[0..], n, "width:var(--tile)") == 1;
    assert pk_count(OUT[0..], n, "height:var(--tile)") == 1;
    assert pk_count(OUT[0..], n, ".app{--tile:84px}") == 1;
    assert pk_count(OUT[0..], n, "@media (max-width:719px){.app{--tile:64px}") == 1;
}

/// Default selection (owner 2026-11-21): with no hash, tab 1 is selected in every menu, Y1 Courses, X1 the first
/// course, Z1 its first lesson, and the display shows that lesson with its widget. The selected tab is a fill only.
test tab_one_is_selected_by_default_in_y_x_and_z {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_has(OUT[0..], n, "<nav class=\"rail\" aria-label=\"Разделы страницы\"><a href=\"#v-t27-basics\">");
    assert pk_count(OUT[0..], n, ".rail [href='#v-t27-basics'],#v-courses:target~.top .rail [href='#v-t27-basics'],") == 1;
    assert pk_count(OUT[0..], n, ".x [href='#v-t27-basics'],.zr a:first-child{background:var(--text);color:var(--bg)}") == 1;
    assert pk_count(OUT[0..], n, ".st:target~main .x [href='#v-t27-basics']:not(:hover),.zr:focus-within a:first-child:not(:focus):not(:hover){background:none;color:var(--muted)}") == 1;
    assert pk_count(OUT[0..], n, "#z-t27-basics{display:flex}.st:target~main #z-t27-basics{display:none}") == 1;
    assert pk_count(OUT[0..], n, ".panel>#w-t27-basics{top:0;visibility:visible}.st:target~main #w-t27-basics{top:10000px;visibility:hidden}") == 1;
    assert pk_count(OUT[0..], n, ".panel>#w-courses") == 0;
    assert pk_has(OUT[0..], n, "name=\"f-t27-basics\" src=\"/widgets/basics-what-a-spec-is/index.html?embed=1\"");
}

/// Y > X > Z (owner 2026-11-21): X lists only the children of the open Y item and Z only the children of the open X
/// item. Every X group is a section keyed by its Y id, every Z group a rail keyed by its X (course) id, the counts
/// match, and no parent is repeated: the Courses item is in Y once and the 12 courses are X items, the 27 lessons Z.
test x_holds_only_the_children_of_y_and_z_only_the_children_of_x {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "<section class=\"x\" id=\"s-") == N_SECTIONS + N_QZ + 1;
    assert pk_has(OUT[0..], n, "<section class=\"x\" id=\"s-lessons\">");
    assert pk_has(OUT[0..], n, "<section class=\"x\" id=\"s-articles\">");
    assert pk_has(OUT[0..], n, "<section class=\"x\" id=\"s-results\">");
    assert pk_has(OUT[0..], n, "<section class=\"x\" id=\"s-about\">");
    assert pk_count(OUT[0..], n, "<a href=\"#v-t27-basics\">") == 1;
    assert pk_count(OUT[0..], n, "<nav class=\"zr\" id=\"z-") == N_LESSONS + lr_doc_views();
    assert pk_count(OUT[0..], n, " target=\"f-") == N_LESSONS * SEGMENTS + lr_doc_sections();
    var bad : u32 = 0;
    var c : u32 = 0;
    while (c < N_LESSONS) {
        var m : u32 = raw(SRC_BUF[0..], 0, "<nav class=\"zr\" id=\"z-");
        m = raw(SRC_BUF[0..], m, VIEW_IDS[c as usize]);
        m = raw(SRC_BUF[0..], m, "\"");
        if (pk_count(OUT[0..], n, SRC_BUF[0..m]) != 1) { bad = bad + 1; }
        m = raw(SRC_BUF[0..], 0, "#v-");
        m = raw(SRC_BUF[0..], m, VIEW_IDS[c as usize]);
        m = raw(SRC_BUF[0..], m, ":target~main #z-");
        m = raw(SRC_BUF[0..], m, VIEW_IDS[c as usize]);
        if (pk_count(OUT[0..], n, SRC_BUF[0..m]) != 1) { bad = bad + 1; }
        c = c + 1;
    }
    assert bad == 0;
}

/// How many times the page draws the icon `path` (its exact d attribute), for the unique-icon test.
pub fn lr_ico_seen(o: []const u8, n: u32, path: []const u8) -> u32 {
    var m : u32 = raw(SRC_BUF[0..], 0, "<path d=\"");
    m = raw(SRC_BUF[0..], m, path);
    m = raw(SRC_BUF[0..], m, "\"/>");
    return pk_count(o, n, SRC_BUF[0..m]);
}

/// Unique icons everywhere (owner 2026-11-21): every icon of the rail, the strips and the course tiles is drawn
/// exactly once on the page, so no two menu items share a drawing; the links of the old footer sit in the rail.
test every_icon_on_the_page_is_drawn_once {
    const n : u32 = page_landing_ru(OUT[0..]);
    var bad : u32 = 0;
    var i : u32 = 0;
    while (i < N_SECTIONS) { if (lr_ico_seen(OUT[0..], n, SEC_ICONS[i as usize]) != 1) { bad = bad + 1; } i = i + 1; }
    i = 0;
    while (i < N_QZ) { if (lr_ico_seen(OUT[0..], n, QZ_ICONS[i as usize]) != 1) { bad = bad + 1; } i = i + 1; }
    i = 0;
    while (i < N_QUEEN) { if (lr_ico_seen(OUT[0..], n, QUEEN_ICONS[i as usize]) != 1) { bad = bad + 1; } i = i + 1; }
    i = 0;
    while (i < N_LESSONS) { if (lr_ico_seen(OUT[0..], n, LESSON_ICONS[i as usize]) != 1) { bad = bad + 1; } i = i + 1; }
    i = 0;
    while (i < N_POSTS) { if (lr_ico_seen(OUT[0..], n, POST_ICONS[i as usize]) != 1) { bad = bad + 1; } i = i + 1; }
    i = 0;
    while (i < N_RESULTS) { if (lr_ico_seen(OUT[0..], n, RESULT_ICONS[i as usize]) != 1) { bad = bad + 1; } i = i + 1; }
    i = 0;
    while (i < N_ABOUT) { if (lr_ico_seen(OUT[0..], n, ABOUT_ICONS[i as usize]) != 1) { bad = bad + 1; } i = i + 1; }
    i = 0;
    while (i < N_FOOT) { if (lr_ico_seen(OUT[0..], n, FOOT_ICONS[i as usize]) != 1) { bad = bad + 1; } i = i + 1; }
    if (lr_ico_seen(OUT[0..], n, RAIL_MAP_ICON) != 1) { bad = bad + 1; }
    if (lr_ico_seen(OUT[0..], n, POSTS_ALL_ICON) != 1) { bad = bad + 1; }
    if (lr_ico_seen(OUT[0..], n, RAIL_SOURCE_ICON) != 1) { bad = bad + 1; }
    i = 0;
    while (i < N_LZ) {
        const m : u32 = lr_lz_path(LZ_ICO_BUF[0..], 0, i);
        if (lr_ico_seen(OUT[0..], n, LZ_ICO_BUF[0..m]) != 1) { bad = bad + 1; }
        i = i + 1;
    }
    assert bad == 0;
    assert N_SECTIONS + N_QZ + N_QUEEN + N_LESSONS + N_POSTS + N_RESULTS + N_ABOUT + N_FOOT + 3 == 68;
    assert pk_count(OUT[0..], n, "<svg class=\"ico\"") == 68 + N_LZ;
    assert pk_count(OUT[0..], n, "<footer") == 0;
    assert pk_count(OUT[0..], n, "<a class=\"ext\"") == N_FOOT + 1;
}

/// Owner 2026-11-21: Y tab 1 is Courses (the default selection); a course in X opens its Z rail on the right,
/// 27 lessons that open in the course frame, so a lesson is three presses away (Y Courses, X course, Z lesson).
test courses_is_tab_one_and_a_lesson_is_three_presses_away {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_has(OUT[0..], n, "О проекте</span><b class=\"key\">4</b></a><a href=\"#v-q-specs\">");
    assert pk_has(OUT[0..], n, "<a href=\"#v-t27-basics\"><svg class=\"ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2 9l10-5 10 5-10 5zM6 11v5c3 2 9 2 12 0v-5\"/></svg><span class=\"lb\" title=\"Курсы\">Курсы</span><b class=\"key\">1</b></a><a href=\"#h-articles\">");
    assert pk_count(OUT[0..], n, "Уроки") == 0;
    assert N_LZ == N_LESSONS * SEGMENTS;
    assert pk_count(OUT[0..], n, "<nav class=\"zr\"") == N_LESSONS + lr_doc_views();
    assert pk_count(OUT[0..], n, " name=\"f-") == N_LESSONS + lr_doc_views();
    assert pk_count(OUT[0..], n, " target=\"f-") == N_LZ + lr_doc_sections();
    assert pk_has(OUT[0..], n, "<path d=\"M4 5h5M4 11h4M4 15h4M4 19h4\"/></svg><b class=\"key\">01</b>");
    assert pk_has(OUT[0..], n, "<path d=\"M4 5h16M16 11h4M16 15h4M16 19h4\"/></svg><b class=\"key\">27</b>");
    assert pk_has(OUT[0..], n, " name=\"f-ai-numbers\" src=\"/widgets/t27-cell/index.html?embed=1\"");
    assert pk_has(OUT[0..], n, "<a href=\"/widgets/t27-cell/index.html?embed=1\" target=\"f-ai-numbers\"><svg class=\"ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 5h7M4 11h4M4 15h4M4 19h4\"/></svg><b class=\"key\">01</b><span title=\"T27: наш собственный формат чисел\">T27: наш собственный формат чисел</span></a>");
    assert pk_has(OUT[0..], n, "target=\"f-vibecoding\"><svg class=\"ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 5h16M16 11h4M16 15h4M16 19h4\"/></svg><b class=\"key\">27</b>");
    assert pk_has(OUT[0..], n, "#v-vibecoding:target~main #z-vibecoding,#v-blog:target~main #z-blog");
    assert pk_has(OUT[0..], n, "#v-vibecoding:target~main .panel,#v-blog:target~main .panel");
    var empty : u32 = 0;
    var e : u32 = 0;
    while (e < N_LZ) {
        if (LZ_IDS[e as usize].len == 0) { empty = empty + 1; }
        if (LZ_TITLES[e as usize].len == 0) { empty = empty + 1; }
        e = e + 1;
    }
    assert empty == 0;
}

test every_z_link_opens_its_own_lesson_widget {
    const n : u32 = page_landing_ru(OUT[0..]);
    var k : u32 = 0;
    while (k < N_LESSONS) {
        var z : u32 = lr_frame_name(SRC_BUF[0..], 0, k);
        z = lr_frame_src(SRC_BUF[0..], z, k);
        z = raw(SRC_BUF[0..], z, "></iframe>");
        assert pk_has(OUT[0..], n, SRC_BUF[0..z]);
        var l : u32 = raw(SRC_BUF[0..], 0, "<a href=\"");
        l = text(SRC_BUF[0..], l, LZ_HREFS[(k * SEGMENTS) as usize]);
        l = raw(SRC_BUF[0..], l, "\"");
        l = lr_frame_target(SRC_BUF[0..], l, k);
        assert pk_has(OUT[0..], n, SRC_BUF[0..l]);
        const m : u32 = attr(SRC_BUF[0..], 0, "src", VIEW_SRCS[k as usize]);
        assert pk_count(OUT[0..], n, SRC_BUF[0..m]) == 0;
        k = k + 1;
    }
    assert pk_count(OUT[0..], n, "<a href=\"/ru/learn/") == 0;
    assert pk_count(OUT[0..], n, "<nav class=\"zr\"") == N_LESSONS + lr_doc_views();
    assert pk_count(OUT[0..], n, "#/ai-numbers/") == 0;
    assert pk_has(OUT[0..], n, "<a href=\"/widgets/basics-what-a-spec-is/index.html?embed=1\" target=\"f-t27-basics\">");
    assert pk_has(OUT[0..], n, "<a href=\"/widgets/basics-where-next/index.html?embed=1\" target=\"f-t27-basics\">");
    assert pk_has(OUT[0..], n, "<a href=\"/widgets/fasm-skyline/index.html?embed=1\" target=\"f-");
    assert pk_has(OUT[0..], n, "<a href=\"/widgets/gatle/index.html?embed=1\" target=\"f-");
    assert pk_has(OUT[0..], n, "<a href=\"/widgets/vc-honest-plan/index.html?embed=1\" target=\"f-vibecoding\">");
}

