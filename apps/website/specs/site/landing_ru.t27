; One navigation (owner 2026-11-21): the rail is Y, the strip below the centre is X, the centre is the detail.
; One hash drives all three. A section hash (#lessons, #h-articles ...) lights its rail item, shows its strip and
; puts its overview view in the centre; a view hash (#v-ID) shows that view, and its marker's group class
; (vc lessons, va articles, vr results, vb about) lights the rail item and keeps the strip of its section.
; No target is the lessons state: the course strip and the course list in the centre.
pub const CSS_VIEW : str = ".panel{position:relative;overflow:hidden}.panel>.view{display:flex;position:absolute;left:0;right:0;top:10000px;height:100%;visibility:hidden;flex-direction:column;padding:0;overflow:hidden}.view iframe{flex:1;display:block;width:100%;height:100%;min-height:0;border:0;background:var(--bg)}.panel>#w-courses{top:0;visibility:visible}.st:target~main #w-courses{top:10000px;visibility:hidden}#s-articles,#s-results,#s-about,.st:target~main #s-lessons{display:none}#lessons:target~main #s-lessons,#v-courses:target~main #s-lessons,.vc:target~main #s-lessons,#h-articles:target~main #s-articles,#articles:target~main #s-articles,.va:target~main #s-articles,#h-results:target~main #s-results,#results:target~main #s-results,.vr:target~main #s-results,#h-about:target~main #s-about,#about:target~main #s-about,.vb:target~main #s-about{display:grid}.st:target~.rail [href='#v-courses']:not(:hover){background:none;color:var(--muted)}";
; The open rail item, one selector each: the Courses item by default, then the item its marker names. The one lit rule
; (lr_css_lit) gives them, the strip items, the group slots and every hovered item the same inverted look.
pub const CSS_LIT_SEL : str = ".rail [href='#v-courses'],#v-courses:target~.rail [href='#v-courses'],#lessons:target~.rail [href='#v-courses'],#h-articles:target~.rail [href='#h-articles'],#articles:target~.rail [href='#h-articles'],#h-results:target~.rail [href='#h-results'],#results:target~.rail [href='#h-results'],#h-about:target~.rail [href='#h-about'],#about:target~.rail [href='#h-about'],#v-queen:target~.rail [href='#v-queen'],.st.vc:target~.rail [href='#v-courses'],.st.va:target~.rail [href='#h-articles'],.st.vr:target~.rail [href='#h-results'],.st.vb:target~.rail [href='#h-about']";
; The X strips: every section is a strip (class x) in the row below the centre; its items are the children of the
; selected Y item and nothing else.
pub const CSS_UNI : str = ".x{margin:0;padding:0;gap:0;grid-template-columns:minmax(0,1fr)}";
; The strip layout only: one row, the extras of a card hidden. The item look is CSS_ITEM, the same as Y and Z.
pub const CSS_XTAB : str = ".x h2,.x .lvl,.x .hubline,.x .hubnote,.x .all,.x p,.x .bar,.x .kick{display:none}.x .grid,.x .hub,#s-lessons .hub{display:flex;flex-direction:row;gap:0;padding:0;overflow-x:auto;overflow-y:hidden;background:none;border:0}.x .top2,#s-lessons .tile .top2{display:contents}";
pub const NAV_LABEL : str = "Разделы страницы";
pub const BAR_LABEL : str = "Панель TRINITY";
pub const LANG_EN : str = "EN";

; The four sections: the public id of each (the anchors of the navigation) and its heading.
