}

test the_view_frame_has_no_padding_or_margin_at_any_width {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, ".panel>.view{padding:0;margin:0;border:0}.panel .view iframe{padding:0;margin:0;border:0;width:100%;height:100%}") == 1;
}

/// Long names (owner 2026-11-21): every tile label of the header, Y, X and Z is clamped to two lines and ends in an
/// ellipsis, never wraps past the square, and carries its full name in a title attribute for the hover.
test long_tile_labels_are_clamped_with_an_ellipsis_and_keep_a_title {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, ".lb,.zr span,.x h3{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;") == 1;
    assert pk_has(OUT[0..], n, "overflow:hidden;text-overflow:ellipsis}");
    assert pk_has(OUT[0..], n, "<span class=\"lb\" title=\"Курсы\">Курсы</span>");
    assert pk_has(OUT[0..], n, "<i class=\"lb\">КУРСЫ</i>");
    assert pk_has(OUT[0..], n, "<h3 title=\"");
    assert pk_has(OUT[0..], n, "<span title=\"T27: наш собственный формат чисел\">");
    assert pk_count(OUT[0..], n, "<span class=\"lb\">") >= 1;
}

/// The agent chat (owner 2026-11-21): the first tile of the right column opens the course page of the app in a new tab.
/// The app has no embeddable chat route yet (sub-issue of #1917), so no drawer and no crop of a frame.
test the_chat_tile_is_first_on_the_right_and_opens_a_drawer {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "<nav class=\"side\" aria-label=\"Ссылки и показатели\"><a class=\"chat-open\" href=\"https://t27.ai/?lang=ru#/vibecoding\" target=\"_blank\" rel=\"noopener\"><img class=\"chat-av\" src=\"/ghashtag-avatar.jpg\"") == 1;
    assert pk_count(OUT[0..], n, "<span class=\"lb\" title=\"Чат с агентом\">ЧАТ</span></a><a class=\"ext\"") == 1;
    assert pk_count(OUT[0..], n, ".chat-av{inline-size:46%;block-size:46%;border-radius:50%;") == 1;
    assert pk_count(OUT[0..], n, "<i class=\"cs\" id=\"chat\"></i>") == 1;
    assert pk_count(OUT[0..], n, "#chat:target~.chat{display:flex}") == 1;
    assert pk_count(OUT[0..], n, "drawer-chat") == 0;
    assert pk_count(OUT[0..], n, "<aside class=\"chat\"") == 0;
    assert pk_count(OUT[0..], n, "chathead") == 0;
    assert pk_count(OUT[0..], n, "<iframe class=\"chatf\"") == 0;
    assert pk_count(OUT[0..], n, ".chat{display:none;grid-area:2/3/3/4;width:360px;") == 1;
    assert pk_count(OUT[0..], n, "grid-template-columns:calc(var(--tile) + 1px) minmax(0,1fr) auto calc(var(--tile) + 1px);") == 1;
    assert pk_count(OUT[0..], n, ".app::after{content:\"\";grid-area:1/1/4/5;") == 1;
    assert pk_count(OUT[0..], n, ".app>.top{grid-area:1/1/2/5!important;") == 1;
    assert pk_count(OUT[0..], n, ".side{grid-area:2/4/3/5!important;") == 1;
    assert pk_count(OUT[0..], n, ".zr{grid-area:3/1/4/5!important;") == 1;
    assert pk_count(OUT[0..], n, "@media (max-width:719px){#chat:target~.panel{display:none}.chat{width:calc(100vw - 2 * var(--tile) - 14px)}}") == 1;
    assert pk_count(OUT[0..], n, ":has(") == 0;
    assert pk_count(OUT[0..], n, "@media (max-width:719px){#chat:target~.panel{display:none}.chat{width:calc(100vw - 2 * var(--tile) - 14px)}}") == 1;
    assert pk_count(OUT[0..], n, ".chat{position:") == 0;
    assert pk_count(OUT[0..], n, ".app{position:relative}") == 0;
    assert pk_count(OUT[0..], n, ".chat{display:none;position") == 0;
    assert pk_count(OUT[0..], n, "<script") == 0;
}

/// Owner 2026-11-21: every Y shows its X (left), its Z (bottom) and a filled display, no spinner. Per Y slot:
/// the display is a built document (srcdoc) with a title and a first section, its Z rail is on the page once, and the
/// Map has its own X strip.
test every_y_has_its_x_its_z_and_a_filled_display {
    const n : u32 = page_landing_ru(OUT[0..]);
    var bad : u32 = 0;
    var v : u32 = DOC_FIRST;
    while (v < N_VIEWS) {
        if (lr_has_doc(v)) {
            var m : u32 = raw(SRC_BUF[0..], 0, "<nav class=\"zr\" id=\"z-");
            m = raw(SRC_BUF[0..], m, VIEW_IDS[v as usize]);
            m = raw(SRC_BUF[0..], m, "\"");
            if (pk_count(OUT[0..], n, SRC_BUF[0..m]) != 1) { bad = bad + 1; }
            if (!lr_nonempty(lr_dstr(v, 0))) { bad = bad + 1; }
            if (!lr_dsec(v, 0)) { bad = bad + 1; }
            if (!lr_nonempty(lr_dstr(v, 3))) { bad = bad + 1; }
        }
        v = v + 1;
    }
    assert bad == 0;
    assert pk_count(OUT[0..], n, " srcdoc=\"") == 41;
    assert pk_count(OUT[0..], n, "<section class=\"x\" id=\"s-map\">") == 1;
    assert pk_count(OUT[0..], n, ".vm:target~main #s-map{display:grid}") == 1;
    assert pk_count(OUT[0..], n, "<i class=\"st vm\" id=\"v-queen\"></i>") == 1;
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, ":has(") == 0;
}
