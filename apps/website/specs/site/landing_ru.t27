pub const CSS_FONTS : str = "@font-face{font-family:Outfit;src:url('/fonts/outfit-latin.woff2') format('woff2');font-display:swap}@font-face{font-family:'JetBrains Mono';src:url('/fonts/jetbrains-mono-latin.woff2') format('woff2');font-display:swap;unicode-range:U+0000-00FF}@font-face{font-family:'JetBrains Mono';src:url('/fonts/jetbrains-mono-cyrillic.woff2') format('woff2');font-display:swap;unicode-range:U+0400-04FF}";

pub const CSS_BASE : str = "*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--text);font:16px/1.6 var(--sans);background:radial-gradient(900px 520px at 50% -8%,rgba(232,196,106,.14),transparent 70%),radial-gradient(700px 480px at 100% 30%,rgba(120,120,255,.06),transparent 70%),var(--bg);background-attachment:fixed;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}img{max-width:100%;height:auto}.wrap{max-width:var(--maxw);margin:0 auto;padding:0 var(--s2)}.glass{background:var(--glass);-webkit-backdrop-filter:var(--blur);backdrop-filter:var(--blur);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}.muted{color:var(--muted)}";

pub const CSS_NAV : str = ".top{position:sticky;top:var(--s1);z-index:10;width:calc(100% - 16px);max-width:var(--maxw);margin:var(--s1) auto 0;padding:var(--s1) var(--s2);display:flex;flex-wrap:wrap;align-items:center;gap:var(--s1) var(--s2)}.brand{font-weight:700;letter-spacing:.04em;margin-right:auto}.links{display:flex;flex-wrap:wrap;align-items:center;gap:4px var(--s2)}.links a{color:var(--muted);font-size:.95rem;transition:color .2s ease}.links a:hover{color:var(--text)}.links a.lang{font-family:var(--mono);font-size:.8rem;border:1px solid var(--line);border-radius:8px;padding:4px var(--s1)}.btn{display:inline-block;padding:12px 20px;border-radius:var(--radius-sm);font-weight:600;border:1px solid var(--line);transition:transform .2s ease,border-color .2s ease,background .2s ease}.btn:hover{transform:translateY(-2px)}.btn.pri{background:var(--gold);border-color:var(--gold);color:var(--ink)}.btn.sec{background:var(--glass);-webkit-backdrop-filter:var(--blur);backdrop-filter:var(--blur);color:var(--text)}.btn.sec:hover{border-color:var(--line-hi)}.btn.sm{padding:var(--s1) 14px;font-size:.9rem}@media (max-width:560px){.links{order:3;width:100%}}";

pub const CSS_HERO : str = ".hero{text-align:center;padding:var(--s8) 0 var(--s6)}.hero img{width:clamp(96px,16vw,160px)}.cap{display:block;margin-top:var(--s2);font-family:var(--mono);font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}h1{font-size:clamp(1.9rem,5.4vw,3.4rem);line-height:1.12;margin:var(--s3) auto var(--s2);max-width:24ch}.lede{max-width:60ch;margin:0 auto var(--s4);color:var(--muted);font-size:1.1rem}.acts{display:flex;flex-wrap:wrap;justify-content:center;gap:var(--s2)}";

pub const CSS_CARDS : str = "section{padding:var(--s4) 0;scroll-margin-top:96px}h2{font-size:1.6rem;margin:0 0 var(--s3)}.grid{display:grid;gap:var(--s2);grid-template-columns:repeat(auto-fill,minmax(var(--grid-min),1fr))}.card{display:block;padding:var(--s3);transition:transform .2s ease,border-color .2s ease,background .2s ease}.card:hover{transform:translateY(-2px);border-color:var(--line-hi);background:var(--glass-hi)}.card .kick{font-family:var(--mono);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--gold)}.card h3{font-size:1.1rem;line-height:1.3;margin:var(--s1) 0}.card p{margin:0;color:var(--muted);font-size:.95rem}.card.more{border-style:dashed}.foot{margin:var(--s6) auto var(--s4)}.pad{padding:var(--s3)}.pad p{margin:var(--s1) 0}.flinks{display:flex;flex-wrap:wrap;gap:var(--s1) var(--s3)}.flinks a:hover,.pad p a:hover{color:var(--gold)}.pad p a{text-decoration:underline}";

pub const CSS_MOTION : str = "@keyframes chatIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}.hero>*,.card{animation:chatIn .5s ease both}.hero>*:nth-child(2){animation-delay:.05s}.hero>*:nth-child(3){animation-delay:.1s}.hero>*:nth-child(4){animation-delay:.15s}.hero>*:nth-child(5){animation-delay:.2s}.grid>.card:nth-child(2){animation-delay:.04s}.grid>.card:nth-child(3){animation-delay:.08s}.grid>.card:nth-child(4){animation-delay:.12s}.grid>.card:nth-child(5){animation-delay:.16s}.grid>.card:nth-child(6){animation-delay:.2s}.grid>.card:nth-child(n+7){animation-delay:.24s}@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.hero>*,.card{animation:none}.btn,.card,.links a{transition:none}.btn:hover,.card:hover{transform:none}}";

