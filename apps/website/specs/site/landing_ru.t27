; The Z rail (owner 2026-11-21): every lesson of every course, 27 per course in the order of VIEW_IDS 0 .. 11;
; lesson j of course k is entry k * 27 + j. Ids from the LESSON_IDS of specs/course/<id>.t27, titles from
; apps/website/i18n/<id>.ru.json (same order, checked when copied).
pub const N_LZ : u32 = 324;
; The section that the rail shows first (owner 2026-11-21: About moves to slot 1).
pub const SEC_ABOUT : u32 = 3;
; A lesson link is LZ_PRE + lesson id + LZ_POST: the static Russian lesson page /ru/learn/<slug>/ (relative, so it
; works at t27.ai/ru/ and on the local server alike). The SPA route #/<course>/<lesson> is locked by the course
; ladder and always shows the course cover, so the Z rail does not use it.
pub const LZ_PRE : str = "/ru/learn/";
pub const LZ_POST : str = "/";
; The Z rail look is the shared item look below; the rail only hides until its course view is open.
pub const CSS_ZR : str =".zr{display:none}";
; ONE object (owner 2026-11-21): Y, Z, the display and X sit in one frame, drawn once by .app::after over rows 2 to 4 of
; the grid: a single 1px line, one outer edge, no boxes and no gaps between the menus, only the 1px divider under Y,
; right of Z and over X. The header stays above the frame, the hero strip and the footer below it.
pub const CSS_FRAME : str = ".app{display:grid;grid-template-columns:var(--tile) minmax(0,1fr) var(--tile);grid-template-rows:auto minmax(0,1fr) auto auto;gap:0;padding:6px;overflow:hidden}.app::after{content:\"\";grid-area:2/1/4/4;border:1px solid var(--card-line);pointer-events:none}.app>.top{grid-area:1/1/2/4!important;margin:0 0 6px}.rail{grid-area:2/1/4/2!important;display:flex;flex-direction:column;overflow-x:hidden;overflow-y:auto;min-height:0;margin:0;padding:0;gap:0;border-right:1px solid var(--card-line)}.rail>a:not(.ext)+.ext{margin-top:auto;border-top:1px solid var(--card-line)}.zr{grid-area:2/3/3/4!important;flex-direction:column;overflow-x:hidden;overflow-y:auto;min-height:0;margin:0;padding:0;gap:0;border-left:1px solid var(--card-line)}.panel{grid-area:2/2/3/4!important;margin:0;min-height:0;border:0}.x,#s-lessons{grid-area:3/2/4/4!important;min-width:0;margin:0;padding:0;border:0;border-top:1px solid var(--card-line)}.hero{display:none}.foot{grid-area:4/1/5/4!important;margin:4px 0 0;padding:2px 8px;border:0}.panel>.view{padding:0;margin:0;border:0}.panel .view iframe{padding:0;margin:0;border:0;width:100%;height:100%}";
; The ONE item look of Y, X and Z (owner 2026-11-21): mono caps, the 16px icon, the number at the right, the muted
; ink, the same padding. Only the direction differs: Y and X run in a row, Z in a column, every item reads icon then name.
pub const CSS_ITEM : str = ".app{--tile:84px}.rail>a,.zr a,.x .card,.x .tile{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;flex:0 0 var(--tile);width:var(--tile);height:var(--tile);gap:4px;min-width:0;min-height:0;margin:0;padding:4px 2px;border:0;border-radius:0;background:none;color:var(--muted);font:600 10px/1.15 var(--mono);letter-spacing:.04em;text-transform:uppercase;text-decoration:none;text-align:center;white-space:normal;overflow:hidden;transition:background .15s,color .15s}.rail .ico,.zr .ico,.x .ico{flex:none;width:22px;height:22px;margin:0}.rail .key,.zr .key,.x .idx{position:absolute;top:3px;right:4px;margin:0;padding:0;font:500 9px/1 var(--mono);letter-spacing:0;text-transform:none;color:inherit;opacity:.6}.zr span,.x h3{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;min-width:0;max-width:100%;margin:0;font:inherit;letter-spacing:inherit;color:inherit;text-align:center;overflow:hidden}.x .card::before,.x .card::after,.x .tile::before,.x .tile::after{display:none}@media (max-width:719px){.app{--tile:64px}.rail>a,.zr a,.x .card,.x .tile{font-size:9px;letter-spacing:0}}";
