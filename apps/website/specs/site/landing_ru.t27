pub const C_FOOT : str = "#8a8a8a";
pub const C_KICK : str = "#bbb";
pub const C_CARD_LINE : str = "#333";
pub const C_BADGE_LINE : str = "#555";
pub const C_GLASS : str = "rgba(18,18,20,0.72)";
pub const GLASS_BLUR : str = "blur(24px) saturate(140%)";
pub const MAX_WIDTH : str = "1120px";
pub const GRID_MIN : str = "260px";
pub const SP_1 : str = "8px";
pub const SP_2 : str = "16px";
pub const SP_3 : str = "24px";
pub const SP_4 : str = "32px";
pub const SP_6 : str = "48px";
pub const SP_8 : str = "64px";
pub const FONT_SANS : str = "Outfit,system-ui,-apple-system,sans-serif";
pub const FONT_MONO : str = "'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace";
pub const RANGE_LATIN : str = "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";
pub const RANGE_CYRILLIC : str = "U+301,U+400-45F,U+490-491,U+4B0-4B1,U+2116";

; One progress segment per lesson; every course is 27 lessons, as the site says.
pub const SEGMENTS : u32 = 27;

pub const CSS_BASE : str = "*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--text);font:15.2px/1.5 var(--sans);background:var(--bg);-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}img{max-width:100%;height:auto}.wrap{max-width:var(--maxw);margin:0 auto;padding:0 var(--s2)}.glass{background:var(--glass);-webkit-backdrop-filter:var(--blur);backdrop-filter:var(--blur)}.muted{color:var(--foot)}";

pub const CSS_NAV : str = ".top{position:sticky;top:var(--s1);z-index:10;width:calc(100% - 16px);max-width:var(--maxw);margin:var(--s1) auto 0;padding:var(--s1) var(--s2);display:flex;flex-wrap:wrap;align-items:center;gap:var(--s1) var(--s2);border:1px solid var(--card-line);border-radius:12px}.brand{display:flex;align-items:center;gap:10px;font-weight:800;letter-spacing:-.02em;margin-right:auto}.hud{display:flex;gap:var(--s2);font-family:var(--mono);font-size:12px;color:var(--kick);white-space:nowrap}.links{display:flex;flex-wrap:wrap;align-items:center;gap:4px var(--s2)}.links a{color:var(--muted);font-size:14px;transition:color .15s}.links a:hover{color:var(--text)}.links a.lang{font-family:var(--mono);font-size:12px;border:1px solid var(--badge-line);border-radius:999px;padding:3px 10px}.btn{display:inline-block;padding:12px 22px;border-radius:999px;font-weight:800;border:1px solid var(--text);transition:background .15s,color .15s}.btn.pri{background:var(--text);color:var(--bg)}.btn.sec{background:transparent;color:var(--text)}.btn.sec:hover{background:var(--text);color:var(--bg)}.btn.sm{padding:6px 14px;font-size:14px}@media (max-width:560px){.hud{display:none}.links{order:3;width:100%}}";

pub const CSS_HERO : str = ".hero{position:relative;text-align:center;margin-top:var(--s3);padding:var(--s8) var(--s2) var(--s6);border:1px solid var(--card-line);background-image:repeating-linear-gradient(0deg,rgba(255,255,255,.03) 0,rgba(255,255,255,.03) 1px,transparent 1px,transparent 3px)}.logo{display:block;height:30px;width:auto;overflow:visible;filter:brightness(1.2)}.logo path{fill:#fff;stroke:#000;stroke-width:1;transform-box:fill-box;transform-origin:center;transition:transform .3s cubic-bezier(.3,1.6,.5,1),filter .3s;animation:petalIn .6s ease both,petalGlow 5.4s ease-in-out 1s infinite}.logo path:nth-child(3n+2){animation-delay:.08s,1.6s}.logo path:nth-child(3n){animation-delay:.16s,2.2s}.logo path:hover{transform:translateY(-8px) scale(1.15);filter:brightness(1.7) drop-shadow(0 4px 6px rgba(255,255,255,.3))}@keyframes petalIn{from{opacity:0;transform:scale(.6)}to{opacity:1;transform:scale(1)}}@keyframes petalGlow{0%,80%,100%{filter:none}90%{filter:brightness(1.6) drop-shadow(0 0 6px rgba(255,255,255,.35))}}@media (prefers-reduced-motion:reduce){.logo path{animation:none;transition:none}}.cap{display:block;margin-top:var(--s2);font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--kick)}.cap::after{content:'';display:inline-block;width:.6em;height:1em;margin-left:6px;vertical-align:-2px;background:var(--text);animation:blink 1s steps(1) infinite}h1{font-weight:800;letter-spacing:-.045em;line-height:.9;font-size:clamp(31px,6.3vw,67px);margin:var(--s3) auto;overflow-wrap:break-word}.lede{max-width:62ch;margin:0 auto var(--s4);color:var(--text);font-size:22px;font-weight:500}.acts{display:flex;flex-wrap:wrap;justify-content:center;gap:var(--s2)}.stat{margin:var(--s4) 0 0;font-family:var(--mono);font-size:12px;letter-spacing:.08em;color:var(--kick)}";

pub const CSS_CARDS : str = "section{padding:var(--s6) 0 var(--s4);border-top:4px solid var(--text);scroll-margin-top:80px}main>section:first-of-type{margin-top:var(--s6)}.lvl{margin:0 0 var(--s1);font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--kick)}h2{font-weight:800;letter-spacing:-.04em;line-height:1;font-size:clamp(32px,6vw,56px);margin:0 0 var(--s4)}.grid{display:grid;gap:var(--s2);grid-template-columns:repeat(auto-fill,minmax(var(--grid-min),1fr))}.card{position:relative;display:block;padding:20px;border:1px solid var(--card-line);border-radius:12px;transition:border-color .15s}.card:hover{border-color:var(--text)}.kick{display:inline-block;font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--kick);border:1px solid var(--badge-line);border-radius:999px;padding:3px 10px}.card h3{font-weight:800;font-size:22px;line-height:1.15;letter-spacing:-.02em;margin:var(--s2) 0 var(--s1)}.card p{margin:0;color:var(--muted);font-size:14px}.card .pf{margin:var(--s1) 0 0;font-family:var(--mono);font-size:11px;color:var(--foot)}.bar{display:flex;gap:2px;margin-top:var(--s2)}.bar i{flex:1;height:4px;background:var(--card-line)}.card.more{border-style:dashed}.hubline{margin:0 0 var(--s2);font-family:var(--mono);font-size:12px;letter-spacing:.08em;color:var(--kick)}.hubnote{margin:var(--s2) 0 0;color:var(--foot);font-size:13px}.hub{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--card-line);border:1px solid var(--card-line)}.tile{position:relative;display:flex;flex-direction:column;gap:var(--s1);padding:var(--s2);background:var(--bg);color:var(--text);transition:background .15s,color .15s}.tile .top2{display:flex;align-items:center;justify-content:space-between;gap:var(--s1)}.tile .idx{font-family:var(--mono);font-size:28px;font-weight:500;line-height:1}.tile h3{flex:1;hyphens:auto;overflow-wrap:break-word;margin:var(--s1) 0 0;font-weight:800;font-size:18px;line-height:1.15;letter-spacing:-.02em}.tile .pf{margin:0;font-family:var(--mono);font-size:11px;color:var(--foot)}.tile::before,.tile::after{content:'';position:absolute;width:12px;height:12px;border:0 solid var(--text);transition:width .15s,height .15s}.tile::before{top:0;left:0;border-top-width:2px;border-left-width:2px}.tile::after{bottom:0;right:0;border-bottom-width:2px;border-right-width:2px}.tile:hover{background:var(--text);color:var(--bg)}.tile:hover .idx,.tile:hover .pf,.tile:hover .kick{color:var(--bg)}.tile:hover .kick{border-color:var(--bg)}.tile:hover .bar i{background:var(--badge-line)}.tile:hover::before,.tile:hover::after{width:16px;height:16px;border-color:var(--bg)}.all{display:block;margin-top:var(--s2);text-align:center}@media (max-width:560px){.hub{grid-template-columns:repeat(2,minmax(0,1fr))}}.hero::before,.hero::after,.card::before,.card::after{content:'';position:absolute;width:12px;height:12px;border:0 solid var(--text);transition:width .15s,height .15s}.hero::before,.card::before{top:-1px;left:-1px;border-top-width:2px;border-left-width:2px}.hero::after,.card::after{bottom:-1px;right:-1px;border-bottom-width:2px;border-right-width:2px}.card:hover::before,.card:hover::after{width:16px;height:16px}.foot{margin:var(--s6) auto var(--s4);padding-top:var(--s3);border-top:4px solid var(--text)}.end{margin:0;font-family:var(--mono);font-size:12px;letter-spacing:.08em;color:var(--foot)}.flinks{display:flex;flex-wrap:wrap;gap:var(--s1) var(--s3);margin:var(--s2) 0}.flinks a{color:var(--muted);transition:color .15s}.flinks a:hover,.end a:hover{color:var(--text)}.foot p{color:var(--foot);font-size:13px}.end a{text-decoration:underline}";

pub const CSS_MOTION : str = "@keyframes chatIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}@keyframes blink{50%{opacity:0}}.hero>*,.card,.tile{animation:chatIn .5s ease both}.hero>*:nth-child(2){animation-delay:.05s}.hero>*:nth-child(3){animation-delay:.1s}.hero>*:nth-child(4){animation-delay:.15s}.hero>*:nth-child(5){animation-delay:.2s}.hero>*:nth-child(6){animation-delay:.25s}.grid>.card:nth-child(2){animation-delay:.04s}.grid>.card:nth-child(3){animation-delay:.08s}.grid>.card:nth-child(4){animation-delay:.12s}.grid>.card:nth-child(5){animation-delay:.16s}.grid>.card:nth-child(6){animation-delay:.2s}.grid>.card:nth-child(n+7){animation-delay:.24s}@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.hero>*,.card,.tile{animation:none}.cap::after{animation:none}.btn,.card,.tile,.links a,.card::before,.card::after,.tile::before,.tile::after{transition:none}}";

/// The one-screen hub (variant A, owner 2026-11-19): a rail on the left, the HUD bar on top, the hero as the stage,
/// a tabbed panel on the right (articles / results / about, switched by :target, no script), the course strip below.
/// Under 900px the page falls back to one column with every section shown.
pub const CSS_APP : str = ".st{position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;pointer-events:none}.panel>section{display:none}@media (min-width:720px){body{height:100dvh;overflow:hidden}.app{display:grid;grid-template-columns:minmax(240px,22vw) minmax(0,1fr) minmax(240px,22vw);grid-template-rows:auto minmax(0,1fr) auto auto;gap:12px;box-sizing:border-box;height:100dvh;margin:0;padding:12px}.app>.top{grid-column:1/4;grid-row:1;position:static;width:auto;max-width:none;margin:0}main.wrap{display:contents}.hero{grid-column:3;grid-row:2;min-height:0;margin:0;padding:var(--s3) var(--s2);display:flex;flex-direction:column;justify-content:safe center;overflow:auto}.hero h1{font-size:clamp(20px,min(1.7vw,3.4vh),30px);margin:var(--s2) auto}.lede{font-size:16px;margin-bottom:var(--s2)}.panel{grid-column:2;grid-row:2;display:flex;flex-direction:column;min-height:0}.panel>section{display:none;flex:1;min-height:0;overflow:auto;padding:var(--s2);border-top:0;margin:0}.panel h2{font-size:28px;margin-bottom:var(--s2)}.panel .grid{grid-template-columns:minmax(0,1fr)}.panel .card{padding:14px}.panel .card h3{font-size:17px;margin:var(--s1) 0 4px}#s-lessons{grid-column:1/4;grid-row:3;display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:var(--s2);margin:0;padding:var(--s1) 0 0}#s-lessons>h2,#s-lessons>.hubline,#s-lessons>.hubnote{display:none}#s-lessons .lvl{writing-mode:vertical-rl;transform:rotate(180deg);margin:0}#s-lessons .all{margin:0;white-space:nowrap}.foot{grid-column:1/4;grid-row:4;margin:0;padding:0;border:0;display:flex;justify-content:center;flex-wrap:wrap;align-items:center;gap:var(--s3)}.foot .flinks{margin:0;font-size:13px}.foot>p:not(.end){display:none}.flinks a:nth-child(3),.flinks a:nth-child(4){border:1px solid var(--text);padding:4px 10px;font-weight:700;color:var(--text)}.flinks a:nth-child(3):hover,.flinks a:nth-child(4):hover{background:var(--text);color:var(--bg)}.hero .lede{font-size:13px;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}.hero .acts{flex-direction:column;align-items:stretch;gap:6px}.hero .btn{padding:8px 12px;font-size:13px}.hero .stat{display:none}}@media (min-width:720px) and (max-width:1099px){.app{grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-template-rows:auto auto minmax(0,1fr) auto auto}.app>.top{grid-column:1/3}.hero{grid-column:2;grid-row:3}.panel{grid-column:1;grid-row:3}#s-lessons{grid-column:1/3;grid-row:4}.foot{grid-column:1/3;grid-row:5}.hero{padding:var(--s2)}.hero h1{font-size:clamp(22px,3.2vw,36px);margin:var(--s1) auto}.lede{font-size:14px;margin-bottom:var(--s1)}.hero .acts{gap:8px}.hero .btn{padding:8px 14px;font-size:13px}.hero{justify-content:safe center}.hero .stat{display:none}}@media (min-width:720px) and (max-height:820px){.hero .stat{display:none}.hero{padding:var(--s2)}.hero h1{margin:var(--s1) auto}.lede{font-size:15px;margin-bottom:var(--s1)}}";

