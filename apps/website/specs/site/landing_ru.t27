    assert pk_count(OUT[0..], n, "<a href=\"#h-about\">") == 1;
    assert pk_has(OUT[0..], n, "<a href=\"#v-t27-basics\"><svg class=\"ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2 9l10-5 10 5-10 5zM6 11v5c3 2 9 2 12 0v-5\"/></svg><span class=\"lb\" title=\"Курсы\">Курсы</span><b class=\"key\">1</b></a>");
    assert pk_count(OUT[0..], n, "<svg class=\"ico\"") == N_SECTIONS + N_QZ + 1 + N_FOOT + 1 + N_LESSONS + N_CARDS + N_LZ;
    assert pk_has(OUT[0..], n, "<a href=\"#v-queen\"><svg class=\"ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3zM9 3v15M15 6v15\"/></svg><span class=\"lb\" title=\"Карта\">Карта</span><b class=\"key\">9</b></a></nav>\n</nav>\n<nav class=\"side\"");
    assert pk_has(OUT[0..], n, "#v-queen:target~.top .rail [href='#v-queen']");
    assert pk_count(OUT[0..], n, "btn pri sm") == 0;
    assert pk_has(OUT[0..], n, "height:100dvh");
    assert pk_has(OUT[0..], n, "grid-template-columns:minmax(240px,22vw) minmax(0,1fr) minmax(240px,22vw)");
    assert pk_has(OUT[0..], n, "#h-articles:target~main #s-articles,#articles:target~main #s-articles,.va:target~main #s-articles");
    assert pk_has(OUT[0..], n, "#v-vibecoding:target~main #w-vibecoding");
