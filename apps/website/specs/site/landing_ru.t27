/// One navigation (owner 2026-11-21): the rail is Y, the strip under the centre is X, the centre is the detail,
/// and one hash drives all three. Every view marker names its rail group; every section is a strip; the centre
/// follows the strips in the page, so the strips never sit inside it.
test the_rail_picks_the_strip_and_the_strip_picks_the_centre {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "class=\"st vc\"") == N_LESSONS;
    assert pk_count(OUT[0..], n, "class=\"st va\"") == N_POSTS + 1;
    assert pk_count(OUT[0..], n, "class=\"st vr\"") == N_RESULTS;
    assert pk_count(OUT[0..], n, "class=\"st vb\"") == N_ABOUT - 1;
    assert pk_has(OUT[0..], n, "<i class=\"st va\" id=\"v-blog\"></i>");
    assert pk_has(OUT[0..], n, "<i class=\"st vb\" id=\"v-b-join-swarm\"></i><i class=\"st vm\" id=\"v-queen\"></i>");
    assert pk_count(OUT[0..], n, "<section class=\"x\" id=\"s-") == N_SECTIONS + N_QZ + 1;
    assert pk_has(OUT[0..], n, "</nav>\n<div class=\"panel\">\n<section class=\"view\" id=\"w-t27-basics\">");
    assert pk_has(OUT[0..], n, ".vb:target~main #s-about{display:grid}");
    assert pk_has(OUT[0..], n, ".panel>#w-t27-basics{top:0;visibility:visible}.st:target~main #w-t27-basics{top:10000px;visibility:hidden}");
    assert pk_has(OUT[0..], n, ",#h-articles:target~main #w-blog,#articles:target~main #w-blog,");
    assert pk_has(OUT[0..], n, ",#h-results:target~main #w-proof,#results:target~main #w-proof,");
    assert pk_has(OUT[0..], n, ",#h-about:target~main #w-trinity,#about:target~main #w-trinity,");
    assert pk_has(OUT[0..], n, ".st.vc:target~.top .rail [href='#v-t27-basics'],.st.va:target~.top .rail [href='#h-articles']");
    assert pk_has(OUT[0..], n, "}</style>\n</head>");
}

