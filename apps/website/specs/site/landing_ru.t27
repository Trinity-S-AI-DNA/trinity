; --- the writer -------------------------------------------------------------------------------------


/// One CSS declaration, name:value; written raw (the values are the named constants above).
pub fn lr_decl(o: []u8, n0: u32, name: []const u8, value: []const u8) -> u32 {
    var n : u32 = raw(o, n0, name);
    n = raw(o, n, ":");
    n = raw(o, n, value);
    return raw(o, n, ";");
}

/// One @font-face: family, file, weight range and unicode range.
pub fn lr_face(o: []u8, n0: u32, family: []const u8, file: []const u8, weight: []const u8, range: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "@font-face{font-family:");
    n = raw(o, n, family);
    n = raw(o, n, ";src:url('/fonts/");
    n = raw(o, n, file);
    n = raw(o, n, "') format('woff2');font-weight:");
    n = raw(o, n, weight);
    n = raw(o, n, ";font-display:swap;unicode-range:");
    n = raw(o, n, range);
    return raw(o, n, "}");
}

/// The whole style sheet: fonts, the token block, then the rules.
pub fn lr_css(o: []u8, n0: u32) -> u32 {
    var n : u32 = lr_face(o, n0, "Outfit", "outfit-latin.woff2", "400 800", RANGE_LATIN);
    n = lr_face(o, n, "'JetBrains Mono'", "jetbrains-mono-latin.woff2", "400 500", RANGE_LATIN);
    n = lr_face(o, n, "'JetBrains Mono'", "jetbrains-mono-cyrillic.woff2", "400 500", RANGE_CYRILLIC);
    n = raw(o, n, ":root{");
    n = lr_decl(o, n, "--bg", C_BG);
    n = lr_decl(o, n, "--text", C_TEXT);
    n = lr_decl(o, n, "--muted", C_MUTED);
    n = lr_decl(o, n, "--foot", C_FOOT);
    n = lr_decl(o, n, "--kick", C_KICK);
    n = lr_decl(o, n, "--card-line", C_CARD_LINE);
    n = lr_decl(o, n, "--badge-line", C_BADGE_LINE);
    n = lr_decl(o, n, "--glass", C_GLASS);
    n = lr_decl(o, n, "--blur", GLASS_BLUR);
    n = lr_decl(o, n, "--maxw", MAX_WIDTH);
    n = lr_decl(o, n, "--grid-min", GRID_MIN);
    n = lr_decl(o, n, "--s1", SP_1);
    n = lr_decl(o, n, "--s2", SP_2);
    n = lr_decl(o, n, "--s3", SP_3);
    n = lr_decl(o, n, "--s4", SP_4);
    n = lr_decl(o, n, "--s6", SP_6);
    n = lr_decl(o, n, "--s8", SP_8);
    n = lr_decl(o, n, "--sans", FONT_SANS);
    n = lr_decl(o, n, "--mono", FONT_MONO);
    n = raw(o, n, "}");
    n = raw(o, n, CSS_BASE);
    n = raw(o, n, CSS_NAV);
    n = raw(o, n, CSS_HERO);
    n = raw(o, n, CSS_CARDS);
    n = raw(o, n, CSS_MOTION);
    return raw(o, n, CSS_APP);
}

/// A number of two digits at least: 01 .. 12.
pub fn lr_two(o: []u8, n0: u32, v: u32) -> u32 {
    var n : u32 = n0;
    if (v < 10) { n = put(o, n, 48); }
    return num(o, n, v as u64);
}

/// One state selector per lesson, joined by commas: pre NN mid NN post, NN = 01 .. 12.
pub fn lr_css_list(o: []u8, n0: u32, pre: []const u8, mid: []const u8, post: []const u8) -> u32 {
    var n : u32 = n0;
    var i : u32 = 1;
    while (i <= N_LESSONS) {
        if (i > 1) { n = raw(o, n, ","); }
        n = raw(o, n, pre);
        n = lr_two(o, n, i);
        n = raw(o, n, mid);
        n = lr_two(o, n, i);
        n = raw(o, n, post);
        i = i + 1;
    }
    return n;
}

/// The lesson state rules: the checked lesson's pane shows, its tile is inverted, the rail's lessons item is lit.
pub fn lr_css_panes(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, CSS_PANE);
    n = lr_css_list(o, n, "#t-l", ":checked~main #l", "");
    n = raw(o, n, "{display:block}");
    n = lr_css_list(o, n, "#t-l", ":checked~main [for=t-l", "]");
    n = raw(o, n, "{background:var(--text);color:var(--bg)}");
    n = lr_css_list(o, n, "#t-l", ":checked~main [for=t-l", "] *");
    n = raw(o, n, "{color:var(--bg);border-color:var(--bg)}");
    var i : u32 = 1;
    while (i <= N_LESSONS) {
        if (i > 1) { n = raw(o, n, ","); }
        n = raw(o, n, "#t-l");
        n = lr_two(o, n, i);
        n = raw(o, n, ":checked~.rail [for=t-l01]");
        i = i + 1;
    }
    return raw(o, n, "{background:var(--text);color:var(--bg);border-color:var(--text)}");
}

/// The document up to and including <body>: head, metas, links and the style sheet.
pub fn lr_head(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<!doctype html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>");
    n = text(o, n, TITLE);
    n = raw(o, n, "</title>\n");
    n = pk_meta(o, n, "name", "description", DESCRIPTION);
    n = pk_meta(o, n, "name", "theme-color", C_BG);
    n = raw(o, n, "<link rel=\"canonical\" href=\"");
    n = raw(o, n, CANONICAL);
    n = raw(o, n, "\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"");
    n = raw(o, n, ORIGIN);
    n = raw(o, n, "\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"");
    n = raw(o, n, CANONICAL);
    n = raw(o, n, "\">\n<link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">\n");
    n = pk_meta(o, n, "property", "og:type", "website");
    n = pk_meta(o, n, "property", "og:locale", "ru_RU");
    n = pk_meta(o, n, "property", "og:site_name", SITE_NAME);
    n = pk_meta(o, n, "property", "og:url", CANONICAL);
    n = pk_meta(o, n, "property", "og:title", TITLE);
    n = pk_meta(o, n, "property", "og:description", DESCRIPTION);
    n = pk_meta(o, n, "property", "og:image", IMAGE);
    n = raw(o, n, "<style>");
    n = lr_css(o, n);
    n = lr_css_panes(o, n);
    n = raw(o, n, ".map{display:flex;flex-wrap:wrap;gap:4px;margin:var(--s2) auto;max-width:var(--maxw);font-size:13px}.map .lvl{width:100%;margin:0 0 4px}.map a{padding:4px 8px;border:1px solid var(--card-line);color:var(--text);text-decoration:none}.map a:first-of-type{border-color:var(--text);font-weight:700}.map a:hover{background:var(--text);color:var(--bg)}@media (min-width:720px){.app{grid-template-rows:auto auto minmax(0,1fr) auto auto}.rail,.panel{grid-row:3}#lessons{grid-row:4}.foot{grid-row:5}.hero{grid-column:1/4;grid-row:2;flex-direction:row;align-items:center;justify-content:flex-start;gap:16px;padding:8px 16px;text-align:left;overflow:hidden}.hero h1{font-size:18px;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}.hero .lede,.hero .stat{display:none}.hero .acts{flex-direction:row;flex-wrap:nowrap;margin:0 0 0 auto;gap:6px}.hero .btn{padding:6px 12px;white-space:nowrap}.map{grid-column:3;grid-row:3;min-height:0;overflow:auto;margin:0;padding:var(--s1);border:1px solid var(--card-line);display:grid;grid-template-columns:1fr 1fr;align-content:start}.map .lvl{grid-column:1/3}}@media (min-width:720px) and (max-width:1099px){.app{grid-template-rows:auto auto auto minmax(0,1fr) auto auto}.rail{grid-row:2}.hero{grid-column:1/3;grid-row:3}.panel{grid-column:1;grid-row:4}.map{grid-column:2;grid-row:4}#lessons{grid-row:5}.foot{grid-row:6}.hero .cap{display:none}}");
    return raw(o, n, "</style>\n</head>\n<body>\n");
}

/// One HUD readout: [ WORD value ], the value computed by the caller.
pub fn lr_readout(o: []u8, n0: u32, word: []const u8, v: u32) -> u32 {
    var n : u32 = raw(o, n0, "<span>[ ");
    n = text(o, n, word);
    n = raw(o, n, " ");
    n = num(o, n, v as u64);
    return raw(o, n, " ]</span>");
}

/// The sticky glass HUD bar: logo and wordmark, readouts (counted from the arrays), anchors, EN and the map button.
pub fn lr_nav(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<nav class=\"top glass\"");
    n = attr(o, n, "aria-label", BAR_LABEL);
    n = raw(o, n, ">\n<a class=\"brand\"");
    n = attr(o, n, "href", HREF_HOME);
    n = raw(o, n, ">");
    n = raw(o, n, LOGO_SVG);
    n = text(o, n, SITE_NAME);
    n = raw(o, n, "</a>\n<div class=\"hud\">");
    n = lr_readout(o, n, HUD_COURSES, N_LESSONS);
    n = lr_readout(o, n, HUD_LESSONS, N_LESSONS * SEGMENTS);
    n = lr_readout(o, n, HUD_POSTS, N_POSTS);
    n = raw(o, n, "</div>\n<div class=\"links\">");
    n = raw(o, n, "<a class=\"lang\" lang=\"en\" hreflang=\"en\"");
    n = attr(o, n, "href", HREF_EN);
    n = raw(o, n, ">");
    n = text(o, n, LANG_EN);
    n = raw(o, n, "</a></div>\n<a class=\"btn pri sm\"");
    n = attr(o, n, "href", HREF_MAP);
    n = raw(o, n, ">");
    n = text(o, n, BTN_MAP);
    return raw(o, n, "</a>\n</nav>\n");
}

/// A rail item's inside: the section's icon, then its name.
pub fn lr_rail_face(o: []u8, n0: u32, i: u32) -> u32 {
    var n : u32 = raw(o, n0, "<svg class=\"ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"");
    n = raw(o, n, SEC_ICONS[i as usize]);
    n = raw(o, n, "\"/></svg>");
    return text(o, n, SEC_TITLES[i as usize]);
}

/// The rail and the tab state. One hidden radio per panel section (articles checked) comes first, so the CSS
/// reads the state with `~` and never with :has(:target), which Chromium does not re-check on a hash change.
/// The rail is the only switcher: a label per panel section; Lessons opens course 01 in the center.
pub fn lr_rail(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<input class=\"st\" type=\"radio\" name=\"tab\" id=\"t-");
    n = text(o, n, SEC_IDS[1]);
    n = raw(o, n, "\" checked>");
    var i : u32 = 2;
    while (i < N_SECTIONS) {
        n = raw(o, n, "<input class=\"st\" type=\"radio\" name=\"tab\" id=\"t-");
        n = text(o, n, SEC_IDS[i as usize]);
        n = raw(o, n, "\">");
        i = i + 1;
    }
    i = 1;
    while (i <= N_LESSONS) {
        n = raw(o, n, "<input class=\"st\" type=\"radio\" name=\"tab\" id=\"t-l");
        n = lr_two(o, n, i);
        n = raw(o, n, "\">");
        i = i + 1;
    }
    n = raw(o, n, "\n<nav class=\"rail\"");
    n = attr(o, n, "aria-label", NAV_LABEL);
    n = raw(o, n, "><label for=\"t-l01\">");
    n = lr_rail_face(o, n, 0);
    n = raw(o, n, "</label>");
    i = 1;
    while (i < N_SECTIONS) {
        n = raw(o, n, "<label for=\"t-");
        n = text(o, n, SEC_IDS[i as usize]);
        n = raw(o, n, "\">");
        n = lr_rail_face(o, n, i);
        n = raw(o, n, "</label>");
        i = i + 1;
    }
    return raw(o, n, "</nav>\n");
}

/// The panel: the one checked section shows (see lr_rail); no tab row of its own.
pub fn lr_tabs(o: []u8, n0: u32) -> u32 {
    return raw(o, n0, "<div class=\"panel\">\n");
}

/// The site map: the head line (counted), then one link per page; wide screens show it as the right column.
pub fn lr_map(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<nav class=\"map\"");
    n = attr(o, n, "aria-label", MAP_LABEL);
    n = raw(o, n, "><p class=\"lvl mh\">");
    n = text(o, n, MAP_HEAD);
    n = num(o, n, N_PAGES as u64);
    n = raw(o, n, "</p>");
    var i : u32 = 0;
    while (i < N_PAGES) {
        n = raw(o, n, "<a");
        n = attr(o, n, "href", PAGE_HREFS[i as usize]);
        n = raw(o, n, ">");
        n = text(o, n, PAGE_TITLES[i as usize]);
        n = raw(o, n, "</a>");
        i = i + 1;
    }
    return raw(o, n, "</nav>\n");
}

/// A button of the hero: kind is pri or sec.
pub fn lr_button(o: []u8, n0: u32, kind: []const u8, href: []const u8, label: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<a class=\"btn ");
    n = raw(o, n, kind);
    n = raw(o, n, "\"");
    n = attr(o, n, "href", href);
    n = raw(o, n, ">");
    n = text(o, n, label);
    return raw(o, n, "</a>");
}

/// The hero: caption (with its cursor), the one h1, the lead, the buttons and the status line.
pub fn lr_hero(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<main class=\"wrap\">\n<header class=\"hero\">\n");
    n = raw(o, n, "<span class=\"cap\">");
    n = text(o, n, MOTTO_CAPTION);
    n = raw(o, n, "</span>\n<h1>");
    n = text(o, n, MOTTO_HEADLINE);
    n = raw(o, n, ": ");
    n = text(o, n, MOTTO_CLAUSE);
    n = raw(o, n, "</h1>\n<p class=\"lede\">");
    n = text(o, n, HERO_LEDE);
    n = raw(o, n, "</p>\n<div class=\"acts\">");
    n = lr_button(o, n, "pri", HREF_MAP, BTN_MAP);
    n = lr_button(o, n, "sec", HREF_PLAY, BTN_PLAY);
    n = lr_button(o, n, "sec", HREF_NUMBER, BTN_NUMBER);
    n = raw(o, n, "</div>\n<p class=\"stat\">");
    n = text(o, n, STATUS_LINE);
    return raw(o, n, "</p>\n</header>\n");
}

/// The opening of a card: one anchor. more is " more" for the "all" card, else "".
pub fn lr_card_open(o: []u8, n0: u32, more: []const u8, href: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<a class=\"card");
    n = raw(o, n, more);
    n = raw(o, n, "\"");
    n = attr(o, n, "href", href);
    return raw(o, n, ">");
}

/// The title and the line of a card, then its end.
pub fn lr_card_tail(o: []u8, n0: u32, title: []const u8, line: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<h3>");
    n = text(o, n, title);
    n = raw(o, n, "</h3><p>");
    n = text(o, n, line);
    return raw(o, n, "</p>");
}

/// A plain card: a mono badge, the title and the line.
pub fn lr_card(o: []u8, n0: u32, more: []const u8, href: []const u8, kick: []const u8, title: []const u8, line: []const u8) -> u32 {
    var n : u32 = lr_card_open(o, n0, more, href);
    n = raw(o, n, "<span class=\"kick\">");
    n = text(o, n, kick);
    n = raw(o, n, "</span>");
    n = lr_card_tail(o, n, title, line);
    return raw(o, n, "</a>\n");
}

/// A course tile of the hub: index and status pill, title, an empty progress bar of SEGMENTS cells, the foot 0 / 27.
/// The tile is the label of the lesson's radio, so choosing it opens the lesson's pane in the panel.
pub fn lr_tile(o: []u8, n0: u32, k: u32) -> u32 {
    var n : u32 = raw(o, n0, "<label class=\"tile\" for=\"t-l");
    n = lr_two(o, n, k + 1);
    n = raw(o, n, "\"><div class=\"top2\"><span class=\"idx\">");
    n = lr_two(o, n, k + 1);
    n = raw(o, n, "</span><span class=\"kick\">");
    n = text(o, n, PILL_OPEN);
    n = raw(o, n, "</span></div><h3>");
    n = text(o, n, LESSON_TITLES[k as usize]);
    n = raw(o, n, "</h3><div class=\"bar\" aria-hidden=\"true\">");
    var s : u32 = 0;
    while (s < SEGMENTS) {
        n = raw(o, n, "<i></i>");
        s = s + 1;
    }
    n = raw(o, n, "</div><p class=\"pf\">");
    n = text(o, n, PF_PRE);
    n = num(o, n, SEGMENTS as u64);
    return raw(o, n, "</p></label>\n");
}

/// A lesson's pane in the panel: COURSE NN / 12, the title, the line, the progress and the two buttons.
pub fn lr_pane(o: []u8, n0: u32, k: u32) -> u32 {
    var n : u32 = raw(o, n0, "<article class=\"pane\" id=\"l");
    n = lr_two(o, n, k + 1);
    n = raw(o, n, "\">\n<p class=\"lvl pk\">");
    n = text(o, n, PANE_WORD);
    n = lr_two(o, n, k + 1);
    n = raw(o, n, " / ");
    n = lr_two(o, n, N_LESSONS);
    n = raw(o, n, "</p>\n<h2>");
    n = text(o, n, LESSON_TITLES[k as usize]);
    n = raw(o, n, "</h2>\n<p class=\"pline\">");
    n = text(o, n, LESSON_LINES[k as usize]);
    n = raw(o, n, "</p>\n<p class=\"pp\">");
    n = text(o, n, PF_PRE);
    n = num(o, n, SEGMENTS as u64);
    n = raw(o, n, "</p>\n<div class=\"pacts\">");
    n = lr_button(o, n, "pri", LESSON_HREFS[k as usize], PANE_OPEN);
    n = lr_button(o, n, "sec", LESSONS_ALL_HREF, LESSONS_ALL_TITLE);
    n = raw(o, n, "<label class=\"btn sec px\" for=\"t-");
    n = text(o, n, SEC_IDS[1]);
    n = raw(o, n, "\">");
    n = text(o, n, PANE_CLOSE);
    return raw(o, n, "</label></div>\n</article>\n");
}

/// Every lesson's pane, after the sections of the panel.
pub fn lr_panes(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    var i : u32 = 0;
    while (i < N_LESSONS) {
        n = lr_pane(o, n, i);
        i = i + 1;
    }
    return n;
}

/// The head of a section: its id, the level line (LEVEL NN / 04, the section name) and its h2.
pub fn lr_section_head(o: []u8, n0: u32, k: u32) -> u32 {
    var n : u32 = raw(o, n0, "<section id=\"");
    n = text(o, n, SEC_IDS[k as usize]);
    n = raw(o, n, "\">\n<p class=\"lvl\">");
    n = text(o, n, LVL_WORD);
    n = lr_two(o, n, k + 1);
    n = raw(o, n, " / ");
    n = lr_two(o, n, N_SECTIONS);
    n = raw(o, n, " · ");
    n = text(o, n, SEC_UPPER[k as usize]);
    n = raw(o, n, "</p>\n<h2>");
    n = text(o, n, SEC_TITLES[k as usize]);
    return raw(o, n, "</h2>\n");
}

/// The start of a card section: the head and the grid.
pub fn lr_section_open(o: []u8, n0: u32, k: u32) -> u32 {
    var n : u32 = lr_section_head(o, n0, k);
    return raw(o, n, "<div class=\"grid\">\n");
}

pub fn lr_section_close(o: []u8, n0: u32) -> u32 {
    return raw(o, n0, "</div>\n</section>\n");
}

/// The lessons hub, a level-select screen: the readout line (counted), 12 tiles in a hairline grid, the all-courses pill.
pub fn lr_lessons(o: []u8, n0: u32) -> u32 {
    var n : u32 = lr_section_head(o, n0, 0);
    n = raw(o, n, "<p class=\"hubline\">");
    n = text(o, n, HUB_PRE);
    n = num(o, n, N_LESSONS as u64);
    n = text(o, n, HUB_MID1);
    n = num(o, n, (N_LESSONS * SEGMENTS) as u64);
    n = text(o, n, HUB_MID2);
    n = raw(o, n, "</p>\n<div class=\"hub\">\n");
    var i : u32 = 0;
    while (i < N_LESSONS) {
        n = lr_tile(o, n, i);
        i = i + 1;
    }
    n = raw(o, n, "</div>\n<a class=\"btn pri all\"");
    n = attr(o, n, "href", LESSONS_ALL_HREF);
    n = raw(o, n, ">");
    n = text(o, n, LESSONS_ALL_TITLE);
    n = text(o, n, ALL_ARROW);
    n = raw(o, n, "</a>\n<p class=\"hubnote\">");
    n = text(o, n, LESSONS_ALL_LINE);
    return raw(o, n, "</p>\n</section>\n");
}

pub fn lr_articles(o: []u8, n0: u32) -> u32 {
    var n : u32 = lr_section_open(o, n0, 1);
    var i : u32 = 0;
    while (i < N_POSTS) {
        n = lr_card(o, n, "", POST_HREFS[i as usize], POST_DATES[i as usize], POST_TITLES[i as usize], POST_LINES[i as usize]);
        i = i + 1;
    }
    n = lr_card(o, n, " more", POSTS_ALL_HREF, KICK_MORE, POSTS_ALL_TITLE, POSTS_ALL_LINE);
    return lr_section_close(o, n);
}

pub fn lr_results(o: []u8, n0: u32) -> u32 {
    var n : u32 = lr_section_open(o, n0, 2);
    var i : u32 = 0;
    while (i < N_RESULTS) {
        n = lr_card(o, n, "", RESULT_HREFS[i as usize], KICK_RESULT, RESULT_TITLES[i as usize], RESULT_LINES[i as usize]);
        i = i + 1;
    }
    return lr_section_close(o, n);
}

pub fn lr_about(o: []u8, n0: u32) -> u32 {
    var n : u32 = lr_section_open(o, n0, 3);
    var i : u32 = 0;
    while (i < N_ABOUT) {
        n = lr_card(o, n, "", ABOUT_HREFS[i as usize], KICK_ABOUT, ABOUT_TITLES[i as usize], ABOUT_LINES[i as usize]);
        i = i + 1;
    }
    return lr_section_close(o, n);
}

/// The footer: links, the no-script note and the level-end line that names this spec.
pub fn lr_footer(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "</main>\n<footer class=\"foot wrap\">\n<div class=\"flinks\">");
    var i : u32 = 0;
    while (i < N_FOOT) {
        n = raw(o, n, "<a");
        n = attr(o, n, "href", FOOT_HREFS[i as usize]);
        n = raw(o, n, ">");
        n = text(o, n, FOOT_LABELS[i as usize]);
        n = raw(o, n, "</a>");
        i = i + 1;
    }
    n = raw(o, n, "</div>\n<p>");
    n = text(o, n, FOOT_NOTE);
    n = raw(o, n, "</p>\n<p class=\"end\">");
    n = text(o, n, END_LINE);
    n = raw(o, n, "<a");
    n = attr(o, n, "href", SOURCE_URL);
    n = raw(o, n, ">");
    n = text(o, n, FOOT_SOURCE_NAME);
    return raw(o, n, "</a></p>\n</footer>\n</div>\n</body>\n</html>\n");
}

/// The whole page, one screen on wide displays: app frame, bar, rail, stage, strip, tabbed panel, footer.
/// OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = lr_head(o, 0);
    n = raw(o, n, "<div class=\"app\">\n");
    n = lr_nav(o, n);
    n = lr_rail(o, n);
    n = lr_hero(o, n);
    n = lr_map(o, n);
    n = lr_lessons(o, n);
    n = lr_tabs(o, n);
    n = lr_articles(o, n);
    n = lr_results(o, n);
    n = lr_about(o, n);
    n = lr_panes(o, n);
    n = raw(o, n, "</div>\n");
    return lr_footer(o, n);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_landing_ru(out: []u8) -> u32 {
    return render_page(out);
}

/// The splicer follows only the names a module itself mentions (see html_out.t27). Never called.
pub fn lr_anchor(o: []u8) -> u32 {
    var n : u32 = put(o, 0, 0);
    n = put_escaped(o, n, 0);
    n = raw(o, n, "");
    n = text(o, n, "");
    n = attr(o, n, "", "");
    n = num(o, n, 0);
    n = fill(o, n, "", "", "", "", 0);
    return OVER + n + (H_SLASH + H_EQ + H_SPACE + H_APOS + H_QUOTE + H_AMP + H_GT + H_LT) as u32;
}

; --- tests --------------------------------------------------------------------------------------------

test the_page_is_written_and_fits_the_buffer {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert ok(n);
    assert n > 0;
    assert n < OUT_CAP;
}

test the_page_has_exactly_one_h1_and_it_is_the_motto {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "<h1") == 1;
    assert pk_count(OUT[0..], n, "</h1>") == 1;
    assert pk_has(OUT[0..], n, "<h1>Играй, управляй, зарабатывай: ядро — это игра, и доска открыта</h1>");
    assert pk_has(OUT[0..], n, "<html lang=\"ru\">");
}

test the_four_sections_exist_and_the_navigation_names_them {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "<section ") == 4;
    assert pk_has(OUT[0..], n, "id=\"lessons\"");
    assert pk_has(OUT[0..], n, "id=\"articles\"");
    assert pk_has(OUT[0..], n, "id=\"results\"");
    assert pk_has(OUT[0..], n, "id=\"about\"");
    assert pk_has(OUT[0..], n, "<label for=\"t-l01\"><svg class=\"ico\"");
    assert pk_has(OUT[0..], n, "<label for=\"t-about\">");
}

test each_section_opens_with_a_level_line {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "<p class=\"lvl\">") == 4;
    assert pk_has(OUT[0..], n, "УРОВЕНЬ 01 / 04 · УРОКИ");
    assert pk_has(OUT[0..], n, "УРОВЕНЬ 02 / 04 · СТАТЬИ");
    assert pk_has(OUT[0..], n, "УРОВЕНЬ 03 / 04 · РЕЗУЛЬТАТЫ");
    assert pk_has(OUT[0..], n, "УРОВЕНЬ 04 / 04 · О ПРОЕКТЕ");
}

test the_card_count_is_the_sum_of_the_section_arrays {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert N_LESSONS == 12;
    assert N_POSTS == 6;
    assert N_RESULTS == 7;
    assert N_ABOUT == 6;
    assert N_CARDS == N_POSTS + N_RESULTS + N_ABOUT + 1;
    assert pk_count(OUT[0..], n, "<a class=\"card") == N_CARDS;
    assert pk_count(OUT[0..], n, "<a class=\"card more\"") == 1;
    assert pk_count(OUT[0..], n, "<label class=\"tile\" for=\"t-l") == N_LESSONS;
    assert pk_count(OUT[0..], n, "<a class=\"tile\"") == 0;
    assert pk_count(OUT[0..], n, "<a href=\"/?lang=ru#/") == N_PAGES;
    assert pk_has(OUT[0..], n, "<nav class=\"map\" aria-label=\"Все страницы сайта\"><p class=\"lvl mh\">КАРТА САЙТА · 19</p><a href=\"/?lang=ru#/blog\">Блог</a>");
}

test the_style_sheet_has_the_glass_the_animation_and_the_reduced_motion_switch {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_has(OUT[0..], n, "@keyframes chatIn");
    assert pk_has(OUT[0..], n, "@keyframes blink");
    assert pk_has(OUT[0..], n, "-webkit-backdrop-filter");
    assert pk_has(OUT[0..], n, "blur(24px) saturate(140%)");
    assert pk_has(OUT[0..], n, "rgba(18,18,20,0.72)");
    assert pk_has(OUT[0..], n, "prefers-reduced-motion");
    assert pk_has(OUT[0..], n, ".cap::after{animation:none}");
    assert pk_has(OUT[0..], n, "scroll-behavior:smooth");
    assert pk_has(OUT[0..], n, "scroll-margin-top");
    assert pk_has(OUT[0..], n, "repeat(auto-fill,minmax(var(--grid-min),1fr))");
    assert pk_has(OUT[0..], n, "--grid-min:260px;");
}

test the_style_is_black_and_white_with_the_measured_values {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_has(OUT[0..], n, "--bg:#000;");
    assert pk_has(OUT[0..], n, "--text:#f2f2f2;");
    assert pk_has(OUT[0..], n, "--muted:#a6a6a6;");
    assert pk_has(OUT[0..], n, "--foot:#8a8a8a;");
    assert pk_has(OUT[0..], n, "--card-line:#333;");
    assert pk_has(OUT[0..], n, "--badge-line:#555;");
    assert pk_has(OUT[0..], n, "border-top:4px solid var(--text)");
    assert pk_has(OUT[0..], n, "letter-spacing:-.045em");
    assert pk_has(OUT[0..], n, "clamp(31px,6.3vw,67px)");
    assert pk_has(OUT[0..], n, "repeating-linear-gradient");
    assert pk_has(OUT[0..], n, "outfit-latin.woff2");
    assert pk_has(OUT[0..], n, "jetbrains-mono-latin.woff2");
    assert pk_has(OUT[0..], n, "jetbrains-mono-cyrillic.woff2");
    assert pk_has(OUT[0..], n, "U+301,U+400-45F,U+490-491,U+4B0-4B1,U+2116");
    assert pk_count(OUT[0..], n, "#e8c46a") == 0;
    assert pk_count(OUT[0..], n, "232,196,106") == 0;
}

test the_hud_readouts_are_computed_from_the_arrays {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert SEGMENTS == 27;
    assert N_LESSONS * SEGMENTS == 324;
    assert pk_has(OUT[0..], n, "[ КУРСЫ 12 ]");
    assert pk_has(OUT[0..], n, "[ УРОКИ 324 ]");
    assert pk_has(OUT[0..], n, "[ СТАТЬИ 6 ]");
    assert pk_has(OUT[0..], n, "СТАТУС: ДОСКА ОТКРЫТА · ВХОД БЕЗ РЕГИСТРАЦИИ");
    assert pk_has(OUT[0..], n, "КОНЕЦ УРОВНЯ · <a");
}

test the_progress_cells_are_27_per_course {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "<i></i>") == N_LESSONS * SEGMENTS;
    assert pk_count(OUT[0..], n, "<div class=\"bar\"") == N_LESSONS;
    assert pk_count(OUT[0..], n, "<p class=\"pf\">0 / 27</p>") == N_LESSONS;
    assert pk_has(OUT[0..], n, "<span class=\"idx\">01</span>");
    assert pk_has(OUT[0..], n, "<span class=\"idx\">12</span>");
    assert pk_count(OUT[0..], n, "ВЫБРАТЬ</span>") == N_LESSONS;
    assert pk_has(OUT[0..], n, "ХАБ КУРСОВ · 12 КУРСОВ · 324 УРОКА · ВЫБЕРИ УРОВЕНЬ");
    assert pk_has(OUT[0..], n, ">Все курсы →</a>");
    assert pk_has(OUT[0..], n, "grid-template-columns:repeat(4,minmax(0,1fr))");
    assert pk_has(OUT[0..], n, "grid-template-columns:repeat(2,minmax(0,1fr))");
}

test the_page_carries_no_script_and_no_form {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
    assert pk_count(OUT[0..], n, "<iframe") == 0;
    assert pk_count(OUT[0..], n, " onclick=") == 0;
}

test the_head_names_the_address_the_language_pair_and_the_icon {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/ru/\">");
    assert pk_has(OUT[0..], n, "<link rel=\"alternate\" hreflang=\"en\" href=\"https://t27.ai/\">");
    assert pk_has(OUT[0..], n, "<link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">");
    assert pk_has(OUT[0..], n, "<meta name=\"description\" content=\"Играй, управляй, зарабатывай: ядро — это игра, и доска открыта\">");
    assert pk_has(OUT[0..], n, "<title>TRINITY S³AI — AGI-игра — играй, управляй, зарабатывай</title>");
}

test every_href_of_a_card_is_on_the_page {
    const n : u32 = page_landing_ru(OUT[0..]);
    var bad : u32 = 0;
    var i : u32 = 0;
    while (i < N_LESSONS) {
        if (!pk_has(OUT[0..], n, LESSON_HREFS[i as usize])) { bad = bad + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < N_POSTS) {
        if (!pk_has(OUT[0..], n, POST_HREFS[i as usize])) { bad = bad + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < N_RESULTS) {
        if (!pk_has(OUT[0..], n, RESULT_HREFS[i as usize])) { bad = bad + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < N_ABOUT) {
        if (!pk_has(OUT[0..], n, ABOUT_HREFS[i as usize])) { bad = bad + 1; }
        i = i + 1;
    }
    assert bad == 0;
}

test the_lesson_cards_follow_the_course_list_in_order {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_has(OUT[0..], n, "/?lang=ru#/t27-basics");
    assert pk_has(OUT[0..], n, "/?lang=ru#/ternary-computing");
    assert pk_has(OUT[0..], n, "/?lang=ru#/vibecoding");
    assert pk_has(OUT[0..], n, "остальные открывает клуб.");
}

test the_hero_has_its_three_buttons_and_the_footer_its_links {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_has(OUT[0..], n, "<a class=\"btn pri\" href=\"/?lang=ru#/queen\">Открыть карту</a>");
    assert pk_has(OUT[0..], n, ">Как играть</a>");
    assert pk_has(OUT[0..], n, "<a class=\"btn sec\" href=\"/?lang=ru#/trinity\">Число за этим</a>");
    assert pk_has(OUT[0..], n, "href=\"https://t27.ai/\">EN</a>");
    assert pk_has(OUT[0..], n, "href=\"mailto:admin@t27.ai\"");
    assert pk_has(OUT[0..], n, "href=\"https://t.me/t27_dev\"");
    assert pk_has(OUT[0..], n, "href=\"https://x.com/t27_lang\"");
    assert pk_has(OUT[0..], n, "href=\"https://x.com/t27_dev\"");
    assert pk_has(OUT[0..], n, "blob/main/apps/website/specs/site/landing_ru.t27");
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_landing_ru(tiny[0..]) == OVER;
    assert render_page(tiny[0..]) == OVER;
}

/// The hero mark is the white 27-petal logo with its CSS animation, not the green favicon.
test the_hero_mark_is_the_white_animated_logo {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "<svg class=\"logo\"") == 1;
    assert pk_count(OUT[0..], n, "<path d=\"") == 27 + 4;
    assert pk_has(OUT[0..], n, ".logo path{fill:#fff");
    assert pk_has(OUT[0..], n, "@keyframes petalIn");
    assert pk_has(OUT[0..], n, ".logo path:hover{");
    assert pk_count(OUT[0..], n, "<img src=\"/favicon.svg\"") == 0;
}

/// Variant A, one screen: app frame, rail, tabbed panel (three radio states, the rail switches them), course strip; no script.
test the_hub_is_one_screen_with_a_rail_tabs_and_a_course_strip {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "<div class=\"app\">") == 1;
    assert pk_count(OUT[0..], n, "<nav class=\"rail\"") == 1;
    assert pk_count(OUT[0..], n, "<div class=\"panel\">") == 1;
    assert pk_count(OUT[0..], n, "<div class=\"tabs\">") == 0;
    assert pk_count(OUT[0..], n, "<a href=\"#lessons\">") == 0;
    assert pk_count(OUT[0..], n, "<label for=\"t-articles\">") == 1;
    assert pk_count(OUT[0..], n, "<label for=\"t-about\">") == 1;
    assert pk_count(OUT[0..], n, "<a href=\"#articles\">") == 0;
    assert pk_count(OUT[0..], n, ":has(") == 0;
    assert pk_has(OUT[0..], n, "<input class=\"st\" type=\"radio\" name=\"tab\" id=\"t-articles\" checked><input class=\"st\" type=\"radio\" name=\"tab\" id=\"t-results\"><input class=\"st\" type=\"radio\" name=\"tab\" id=\"t-about\"><input class=\"st\" type=\"radio\" name=\"tab\" id=\"t-l01\">");
    assert pk_has(OUT[0..], n, "<label for=\"t-l01\"><svg class=\"ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2 9l10-5 10 5-10 5zM6 11v5c3 2 9 2 12 0v-5\"/></svg>Уроки</label>");
    assert pk_count(OUT[0..], n, "<svg class=\"ico\"") == 4;
    assert pk_has(OUT[0..], n, ".rail .ico{width:22px;height:22px;fill:none;stroke:currentColor");
    assert pk_has(OUT[0..], n, "height:100dvh");
    assert pk_has(OUT[0..], n, "grid-template-columns:minmax(240px,22vw) minmax(0,1fr) minmax(240px,22vw)");
    assert pk_has(OUT[0..], n, "#t-articles:checked~main #articles,#t-results:checked~main #results,#t-about:checked~main #about{display:block}");
    assert pk_has(OUT[0..], n, "#t-articles:checked~.rail [for=t-articles],#t-results:checked~.rail [for=t-results],#t-about:checked~.rail [for=t-about]{background:var(--text)");
    assert pk_has(OUT[0..], n, "grid-auto-flow:column");
    assert pk_has(OUT[0..], n, "scroll-snap-type:x mandatory");
    assert pk_count(OUT[0..], n, "<input") == 3 + N_LESSONS;
    assert pk_has(OUT[0..], n, "id=\"t-l12\">\n<nav class=\"rail\"");
}

/// A chosen lesson opens in the center: its tile is its radio's label, its pane sits in the panel, CSS shows it.
test a_chosen_lesson_opens_in_the_center {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "<article class=\"pane\" id=\"l") == N_LESSONS;
    assert pk_has(OUT[0..], n, "<label class=\"tile\" for=\"t-l12\"><div class=\"top2\"><span class=\"idx\">12</span>");
    assert pk_has(OUT[0..], n, "<article class=\"pane\" id=\"l01\">\n<p class=\"lvl pk\">КУРС 01 / 12</p>\n<h2>");
    assert pk_has(OUT[0..], n, "<div class=\"pacts\"><a class=\"btn pri\" href=\"/?lang=ru#/vibecoding\">Открыть курс →</a>");
    assert pk_has(OUT[0..], n, "#t-l01:checked~main #l01,#t-l02:checked~main #l02,");
    assert pk_has(OUT[0..], n, "#t-l12:checked~main #l12{display:block}");
    assert pk_has(OUT[0..], n, "#t-l12:checked~main [for=t-l12]{background:var(--text);color:var(--bg)}");
    assert pk_has(OUT[0..], n, "#t-l12:checked~.rail [for=t-l01]{background:var(--text)");
    assert pk_count(OUT[0..], n, "<label class=\"btn sec px\" for=\"t-articles\">Закрыть</label></div>") == N_LESSONS;
    assert pk_has(OUT[0..], n, "@media (max-width:719px){body{height:100dvh;overflow:hidden}.app{display:flex;flex-direction:column");
}
