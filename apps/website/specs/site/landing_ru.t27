    assert pk_has(OUT[0..], n, "<a href=\"#v-courses\"><svg class=\"ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2 9l10-5 10 5-10 5zM6 11v5c3 2 9 2 12 0v-5\"/></svg>Курсы<b class=\"key\">2</b></a>");
    assert pk_count(OUT[0..], n, "<svg class=\"ico\"") == N_SECTIONS + N_QZ + 1 + N_FOOT + 1 + N_LESSONS + N_CARDS + N_LZ;
    assert pk_has(OUT[0..], n, "<a href=\"#v-queen\"><svg class=\"ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3zM9 3v15M15 6v15\"/></svg>Карта<b class=\"key\">9</b></a><a class=\"ext\" href=\"https://github.com/gHashTag/trinity\" rel=\"noopener\">");
    assert pk_has(OUT[0..], n, "#v-queen:target~.rail [href='#v-queen']");
    assert pk_count(OUT[0..], n, "btn pri sm") == 0;
    assert pk_has(OUT[0..], n, "height:100dvh");
    assert pk_has(OUT[0..], n, "grid-template-columns:minmax(240px,22vw) minmax(0,1fr) minmax(240px,22vw)");
    assert pk_has(OUT[0..], n, "#h-articles:target~main #s-articles,#articles:target~main #s-articles,.va:target~main #s-articles");
    assert pk_has(OUT[0..], n, "#v-vibecoding:target~main #w-vibecoding");
    assert pk_has(OUT[0..], n, "<i class=\"st zg z2\" id=\"v-q-providers\"></i>\n<nav class=\"rail\"");
}

/// Every section name is a public hash: the marker carries the public id, the section the internal one, so
/// #lessons, #articles, #results and #about read the same state the rail reads, with no :has and no radio.
test every_section_name_is_a_public_hash_that_drives_panel_and_rail {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_has(OUT[0..], n, "<i class=\"st\" id=\"lessons\"></i>");
    assert pk_has(OUT[0..], n, "<i class=\"st\" id=\"articles\"></i>");
    assert pk_has(OUT[0..], n, "<i class=\"st\" id=\"results\"></i>");
    assert pk_has(OUT[0..], n, "<i class=\"st\" id=\"about\"></i>");
    assert pk_count(OUT[0..], n, "id=\"lessons\"") == 1;
    assert pk_count(OUT[0..], n, "id=\"articles\"") == 1;
    assert pk_count(OUT[0..], n, "id=\"results\"") == 1;
    assert pk_count(OUT[0..], n, "id=\"about\"") == 1;
    assert pk_has(OUT[0..], n, "#lessons:target~main #w-courses");
    assert pk_has(OUT[0..], n, "#lessons:target~.rail [href='#v-courses']");
    assert pk_has(OUT[0..], n, "#articles:target~main #s-articles");
    assert pk_has(OUT[0..], n, "#results:target~main #s-results");
    assert pk_has(OUT[0..], n, "#about:target~main #s-about");
    assert pk_has(OUT[0..], n, "#about:target~.rail [href='#h-about']");
    assert pk_count(OUT[0..], n, ":has(") == 0;
    assert pk_count(OUT[0..], n, "<input") == 0;
}

/// A course tile opens its course at once in the center: the tile targets its view; no radio, no pane, no site map.
test a_course_tile_opens_its_course_at_once {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_has(OUT[0..], n, "<a class=\"tile\" href=\"#v-vibecoding\"><div class=\"top2\"><svg class=\"ico\"");
