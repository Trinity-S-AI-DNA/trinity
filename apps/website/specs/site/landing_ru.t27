pub const BTN_PLAY : str = "Как играть";
pub const BTN_NUMBER : str = "Число за этим";
; The logo returns the HUD to its first state (no :target, the articles panel).
pub const HREF_HOME : str = "#";

; HUD-NAV-001 (owner 2026-11-19, HUD_IS_THE_SITE): the whole site opens inside this one HUD. Every internal page is a
; view: an empty :target marker before the rail and main (id v-ID) and a panel section (id w-ID) holding a lazy
; iframe of that page. A link to a page is href="#v-ID", so choosing it swaps the centre panel and never leaves.
; Only GitHub, Telegram and X go outside. The first N_LESSONS views are the courses, in COURSE_IDS order.
; The hash contract: a public hash is always the id of a marker, never of the content. The sections answer to their
; own names (#lessons, #articles, #results, #about) and the panel tabs to their h- names (#h-articles, #h-results,
; #h-about); both drive the same state through `~`, so the panel, the rail and the hash always agree.
pub const N_VIEWS : u32 = 56;
pub const NO_VIEW : u32 = 99;
pub const VIEW_IDS : [56]str = [
    "t27-basics", "course", "ai-numbers", "goldenfloat", "verify-hardware", "clocks-and-cdc",
