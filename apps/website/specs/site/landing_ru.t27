; --- the writer -------------------------------------------------------------------------------------

/// One CSS declaration, name:value; written raw (the values are the named constants above).
pub fn lr_decl(o: []u8, n0: u32, name: []const u8, value: []const u8) -> u32 {
    var n : u32 = raw(o, n0, name);
    n = raw(o, n, ":");
    n = raw(o, n, value);
    return raw(o, n, ";");
}

/// The whole style sheet: fonts, the token block, then the rules.
pub fn lr_css(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, CSS_FONTS);
    n = raw(o, n, ":root{");
    n = lr_decl(o, n, "--bg", C_BG);
    n = lr_decl(o, n, "--text", C_TEXT);
    n = lr_decl(o, n, "--muted", C_MUTED);
    n = lr_decl(o, n, "--gold", C_GOLD);
    n = lr_decl(o, n, "--ink", C_INK);
    n = lr_decl(o, n, "--glass", C_GLASS);
    n = lr_decl(o, n, "--glass-hi", C_GLASS_HI);
    n = lr_decl(o, n, "--line", C_LINE);
    n = lr_decl(o, n, "--line-hi", C_LINE_HI);
    n = lr_decl(o, n, "--blur", GLASS_BLUR);
    n = lr_decl(o, n, "--shadow", SHADOW);
    n = lr_decl(o, n, "--radius", RADIUS);
    n = lr_decl(o, n, "--radius-sm", RADIUS_SM);
    n = lr_decl(o, n, "--maxw", MAX_WIDTH);
    n = lr_decl(o, n, "--grid-min", GRID_MIN);
    n = lr_decl(o, n, "--s1", SP_1);
    n = lr_decl(o, n, "--s2", SP_2);
    n = lr_decl(o, n, "--s3", SP_3);
    n = lr_decl(o, n, "--s4", SP_4);
    n = lr_decl(o, n, "--s6", SP_6);
    n = lr_decl(o, n, "--s8", SP_8);
    n = lr_decl(o, n, "--sans", FONT_SANS);
    n = lr_decl(o, n, "--mono", FONT_MONO);
    n = raw(o, n, "}");
    n = raw(o, n, CSS_BASE);
    n = raw(o, n, CSS_NAV);
    n = raw(o, n, CSS_HERO);
    n = raw(o, n, CSS_CARDS);
    return raw(o, n, CSS_MOTION);
}

/// The document up to and including <body>: head, metas, links and the style sheet.
pub fn lr_head(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<!doctype html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>");
    n = text(o, n, TITLE);
    n = raw(o, n, "</title>\n");
    n = pk_meta(o, n, "name", "description", DESCRIPTION);
    n = pk_meta(o, n, "name", "theme-color", C_BG);
    n = raw(o, n, "<link rel=\"canonical\" href=\"");
    n = raw(o, n, CANONICAL);
    n = raw(o, n, "\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"");
    n = raw(o, n, ORIGIN);
    n = raw(o, n, "\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"");
    n = raw(o, n, CANONICAL);
    n = raw(o, n, "\">\n<link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">\n");
    n = pk_meta(o, n, "property", "og:type", "website");
    n = pk_meta(o, n, "property", "og:locale", "ru_RU");
    n = pk_meta(o, n, "property", "og:site_name", SITE_NAME);
    n = pk_meta(o, n, "property", "og:url", CANONICAL);
    n = pk_meta(o, n, "property", "og:title", TITLE);
    n = pk_meta(o, n, "property", "og:description", DESCRIPTION);
    n = pk_meta(o, n, "property", "og:image", IMAGE);
    n = raw(o, n, "<style>");
    n = lr_css(o, n);
    return raw(o, n, "</style>\n</head>\n<body>\n");
}

/// The sticky glass navigation: wordmark, the four anchors, the language switch and the map button.
pub fn lr_nav(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<nav class=\"top glass\"");
    n = attr(o, n, "aria-label", NAV_LABEL);
    n = raw(o, n, ">\n<a class=\"brand\"");
    n = attr(o, n, "href", HREF_HOME);
    n = raw(o, n, ">");
    n = text(o, n, SITE_NAME);
    n = raw(o, n, "</a>\n<div class=\"links\">");
    var i : u32 = 0;
    while (i < N_SECTIONS) {
        n = raw(o, n, "<a href=\"#");
        n = text(o, n, SEC_IDS[i as usize]);
        n = raw(o, n, "\">");
        n = text(o, n, SEC_TITLES[i as usize]);
        n = raw(o, n, "</a>");
        i = i + 1;
    }
    n = raw(o, n, "<a class=\"lang\" lang=\"en\" hreflang=\"en\"");
    n = attr(o, n, "href", HREF_EN);
    n = raw(o, n, ">");
    n = text(o, n, LANG_EN);
    n = raw(o, n, "</a></div>\n<a class=\"btn pri sm\"");
    n = attr(o, n, "href", HREF_MAP);
    n = raw(o, n, ">");
    n = text(o, n, BTN_MAP);
    return raw(o, n, "</a>\n</nav>\n");
}

/// A button of the hero: kind is pri or sec.
pub fn lr_button(o: []u8, n0: u32, kind: []const u8, href: []const u8, label: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<a class=\"btn ");
    n = raw(o, n, kind);
    n = raw(o, n, "\"");
    n = attr(o, n, "href", href);
    n = raw(o, n, ">");
    n = text(o, n, label);
    return raw(o, n, "</a>");
}

/// The hero: the mark, the caption, the one h1, the lede and the three buttons.
pub fn lr_hero(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<main class=\"wrap\">\n<header class=\"hero\">\n<img src=\"/favicon.svg\" width=\"160\" height=\"160\"");
    n = attr(o, n, "alt", LOGO_ALT);
    n = raw(o, n, ">\n<span class=\"cap\">");
    n = text(o, n, MOTTO_CAPTION);
    n = raw(o, n, "</span>\n<h1>");
    n = text(o, n, MOTTO_HEADLINE);
    n = raw(o, n, ": ");
    n = text(o, n, MOTTO_CLAUSE);
    n = raw(o, n, "</h1>\n<p class=\"lede\">");
    n = text(o, n, HERO_LEDE);
    n = raw(o, n, "</p>\n<div class=\"acts\">");
    n = lr_button(o, n, "pri", HREF_MAP, BTN_MAP);
    n = lr_button(o, n, "sec", HREF_PLAY, BTN_PLAY);
    n = lr_button(o, n, "sec", HREF_NUMBER, BTN_NUMBER);
    return raw(o, n, "</div>\n</header>\n");
}

/// One card, one anchor: the kicker, the title and the line. more is " more" for the "all" card, else "".
pub fn lr_card(o: []u8, n0: u32, more: []const u8, href: []const u8, kick: []const u8, title: []const u8, line: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<a class=\"card glass");
    n = raw(o, n, more);
    n = raw(o, n, "\"");
    n = attr(o, n, "href", href);
    n = raw(o, n, "><span class=\"kick\">");
    n = text(o, n, kick);
    n = raw(o, n, "</span><h3>");
    n = text(o, n, title);
    n = raw(o, n, "</h3><p>");
    n = text(o, n, line);
    return raw(o, n, "</p></a>\n");
}

/// The start of a section: its id, its h2 and the opening of its grid.
pub fn lr_section_open(o: []u8, n0: u32, k: u32) -> u32 {
    var n : u32 = raw(o, n0, "<section id=\"");
    n = text(o, n, SEC_IDS[k as usize]);
    n = raw(o, n, "\">\n<h2>");
    n = text(o, n, SEC_TITLES[k as usize]);
    return raw(o, n, "</h2>\n<div class=\"grid\">\n");
}

pub fn lr_section_close(o: []u8, n0: u32) -> u32 {
    return raw(o, n0, "</div>\n</section>\n");
}

pub fn lr_lessons(o: []u8, n0: u32) -> u32 {
    var n : u32 = lr_section_open(o, n0, 0);
    var i : u32 = 0;
    while (i < N_LESSONS) {
        n = lr_card(o, n, "", LESSON_HREFS[i as usize], KICK_LESSON, LESSON_TITLES[i as usize], LESSON_LINES[i as usize]);
        i = i + 1;
    }
    n = lr_card(o, n, " more", LESSONS_ALL_HREF, KICK_MORE, LESSONS_ALL_TITLE, LESSONS_ALL_LINE);
    return lr_section_close(o, n);
}

pub fn lr_articles(o: []u8, n0: u32) -> u32 {
    var n : u32 = lr_section_open(o, n0, 1);
    var i : u32 = 0;
    while (i < N_POSTS) {
        n = lr_card(o, n, "", POST_HREFS[i as usize], POST_DATES[i as usize], POST_TITLES[i as usize], POST_LINES[i as usize]);
        i = i + 1;
    }
    n = lr_card(o, n, " more", POSTS_ALL_HREF, KICK_MORE, POSTS_ALL_TITLE, POSTS_ALL_LINE);
    return lr_section_close(o, n);
}

pub fn lr_results(o: []u8, n0: u32) -> u32 {
    var n : u32 = lr_section_open(o, n0, 2);
    var i : u32 = 0;
    while (i < N_RESULTS) {
        n = lr_card(o, n, "", RESULT_HREFS[i as usize], KICK_RESULT, RESULT_TITLES[i as usize], RESULT_LINES[i as usize]);
        i = i + 1;
    }
    return lr_section_close(o, n);
}

pub fn lr_about(o: []u8, n0: u32) -> u32 {
    var n : u32 = lr_section_open(o, n0, 3);
    var i : u32 = 0;
    while (i < N_ABOUT) {
        n = lr_card(o, n, "", ABOUT_HREFS[i as usize], KICK_ABOUT, ABOUT_TITLES[i as usize], ABOUT_LINES[i as usize]);
        i = i + 1;
    }
    return lr_section_close(o, n);
}

/// The footer and the end of the document.
pub fn lr_footer(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "</main>\n<footer class=\"foot wrap\">\n<div class=\"glass pad\">\n<div class=\"flinks\">");
    var i : u32 = 0;
    while (i < N_FOOT) {
        n = raw(o, n, "<a");
        n = attr(o, n, "href", FOOT_HREFS[i as usize]);
        n = raw(o, n, ">");
        n = text(o, n, FOOT_LABELS[i as usize]);
        n = raw(o, n, "</a>");
        i = i + 1;
    }
    n = raw(o, n, "</div>\n<p class=\"muted\">");
    n = text(o, n, FOOT_NOTE);
    n = raw(o, n, "</p>\n<p class=\"muted\">");
    n = text(o, n, FOOT_SOURCE_PRE);
    n = raw(o, n, "<a");
    n = attr(o, n, "href", SOURCE_URL);
    n = raw(o, n, ">");
    n = text(o, n, FOOT_SOURCE_NAME);
    n = raw(o, n, "</a>");
    n = text(o, n, FOOT_SOURCE_POST);
    return raw(o, n, "</p>\n</div>\n</footer>\n</body>\n</html>\n");
}

/// The whole page. OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = lr_head(o, 0);
    n = lr_nav(o, n);
    n = lr_hero(o, n);
    n = lr_lessons(o, n);
    n = lr_articles(o, n);
    n = lr_results(o, n);
    n = lr_about(o, n);
    return lr_footer(o, n);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_landing_ru(out: []u8) -> u32 {
    return render_page(out);
}

/// The splicer follows only the names a module itself mentions (see html_out.t27). Never called.
pub fn lr_anchor(o: []u8) -> u32 {
    var n : u32 = put(o, 0, 0);
    n = put_escaped(o, n, 0);
    n = raw(o, n, "");
    n = text(o, n, "");
    n = attr(o, n, "", "");
    n = num(o, n, 0);
    n = fill(o, n, "", "", "", "", 0);
    return OVER + n + (H_SLASH + H_EQ + H_SPACE + H_APOS + H_QUOTE + H_AMP + H_GT + H_LT) as u32;
}

; --- tests --------------------------------------------------------------------------------------------

test the_page_is_written_and_fits_the_buffer {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert ok(n);
    assert n > 0;
    assert n < OUT_CAP;
}

test the_page_has_exactly_one_h1_and_it_is_the_motto {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "<h1") == 1;
    assert pk_count(OUT[0..], n, "</h1>") == 1;
    assert pk_has(OUT[0..], n, "<h1>Играй, управляй, зарабатывай: ядро — это игра, и доска открыта</h1>");
    assert pk_has(OUT[0..], n, "<html lang=\"ru\">");
}

test the_four_sections_exist_and_the_navigation_names_them {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "<section ") == 4;
    assert pk_has(OUT[0..], n, "id=\"lessons\"");
    assert pk_has(OUT[0..], n, "id=\"articles\"");
    assert pk_has(OUT[0..], n, "id=\"results\"");
    assert pk_has(OUT[0..], n, "id=\"about\"");
    assert pk_has(OUT[0..], n, "<a href=\"#lessons\">");
    assert pk_has(OUT[0..], n, "<a href=\"#about\">");
}

test the_card_count_is_the_sum_of_the_section_arrays {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert N_LESSONS == 12;
    assert N_POSTS == 6;
    assert N_RESULTS == 7;
    assert N_ABOUT == 6;
    assert N_CARDS == N_LESSONS + N_POSTS + N_RESULTS + N_ABOUT + 2;
    assert pk_count(OUT[0..], n, "<a class=\"card ") == N_CARDS;
    assert pk_count(OUT[0..], n, "card glass more\"") == 2;
}

test the_style_sheet_has_the_glass_the_animation_and_the_reduced_motion_switch {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_has(OUT[0..], n, "chatIn");
    assert pk_has(OUT[0..], n, "@keyframes chatIn");
    assert pk_has(OUT[0..], n, "backdrop-filter");
    assert pk_has(OUT[0..], n, "-webkit-backdrop-filter");
    assert pk_has(OUT[0..], n, "blur(24px) saturate(140%)");
    assert pk_has(OUT[0..], n, "rgba(18,18,20,0.72)");
    assert pk_has(OUT[0..], n, "prefers-reduced-motion");
    assert pk_has(OUT[0..], n, "scroll-behavior:smooth");
    assert pk_has(OUT[0..], n, "scroll-margin-top");
    assert pk_has(OUT[0..], n, "repeat(auto-fill,minmax(var(--grid-min),1fr))");
    assert pk_has(OUT[0..], n, "--grid-min:260px;");
}

test the_page_carries_no_script_and_no_form {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
    assert pk_count(OUT[0..], n, "<iframe") == 0;
    assert pk_count(OUT[0..], n, " onclick=") == 0;
}

test the_head_names_the_address_the_language_pair_and_the_icon {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/ru/\">");
    assert pk_has(OUT[0..], n, "<link rel=\"alternate\" hreflang=\"en\" href=\"https://t27.ai/\">");
    assert pk_has(OUT[0..], n, "<link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">");
    assert pk_has(OUT[0..], n, "<meta name=\"description\" content=\"Играй, управляй, зарабатывай: ядро — это игра, и доска открыта\">");
    assert pk_has(OUT[0..], n, "<title>TRINITY S³AI — AGI-игра — играй, управляй, зарабатывай</title>");
    assert pk_has(OUT[0..], n, "/fonts/outfit-latin.woff2");
}

test no_card_text_is_empty_and_every_href_is_on_the_page {
    const n : u32 = page_landing_ru(OUT[0..]);
    var bad : u32 = 0;
    var i : u32 = 0;
    while (i < N_LESSONS) {
        if (!pk_has(OUT[0..], n, LESSON_HREFS[i as usize])) { bad = bad + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < N_POSTS) {
        if (!pk_has(OUT[0..], n, POST_HREFS[i as usize])) { bad = bad + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < N_RESULTS) {
        if (!pk_has(OUT[0..], n, RESULT_HREFS[i as usize])) { bad = bad + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < N_ABOUT) {
        if (!pk_has(OUT[0..], n, ABOUT_HREFS[i as usize])) { bad = bad + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < N_SECTIONS) {
        i = i + 1;
    }
    assert bad == 0;
}

test the_lesson_cards_follow_the_course_list_in_order {
    assert pk_has(OUT[0..], page_landing_ru(OUT[0..]), "/?lang=ru#/t27-basics");
    assert pk_has(OUT[0..], page_landing_ru(OUT[0..]), "/?lang=ru#/course");
    assert pk_has(OUT[0..], page_landing_ru(OUT[0..]), "/?lang=ru#/ternary-computing");
    assert pk_has(OUT[0..], page_landing_ru(OUT[0..]), "/?lang=ru#/vibecoding");
}

test the_hero_has_its_three_buttons_and_the_footer_its_links {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_has(OUT[0..], n, "<a class=\"btn pri\" href=\"/?lang=ru#/queen\">Открыть карту</a>");
    assert pk_has(OUT[0..], n, ">Как играть</a>");
    assert pk_has(OUT[0..], n, "<a class=\"btn sec\" href=\"/?lang=ru#/trinity\">Число за этим</a>");
    assert pk_has(OUT[0..], n, "href=\"https://t27.ai/\">EN</a>");
    assert pk_has(OUT[0..], n, "href=\"mailto:admin@t27.ai\"");
    assert pk_has(OUT[0..], n, "href=\"https://t.me/t27_dev\"");
    assert pk_has(OUT[0..], n, "href=\"https://x.com/t27_lang\"");
    assert pk_has(OUT[0..], n, "blob/main/apps/website/specs/site/landing_ru.t27");
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_landing_ru(tiny[0..]) == OVER;
    assert render_page(tiny[0..]) == OVER;
}
