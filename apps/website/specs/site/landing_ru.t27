    assert pk_count(OUT[0..], n, "lime") == 0;
    assert pk_count(OUT[0..], n, "#0f0") == 0;
    assert pk_count(OUT[0..], n, "#22c55e") == 0;
    assert pk_count(OUT[0..], n, "#08FAB5") == 0;
    assert pk_count(OUT[0..], n, "#08fab5") == 0;
    assert pk_count(OUT[0..], n, "#4ade80") == 0;
}

test the_view_frame_has_no_padding_or_margin_at_any_width {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, ".panel>.view{padding:0;margin:0;border:0}.panel .view iframe{padding:0;margin:0;border:0;width:100%;height:100%}") == 1;
}
