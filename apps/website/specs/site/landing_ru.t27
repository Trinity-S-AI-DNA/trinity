; --- the writer -------------------------------------------------------------------------------------


/// One CSS declaration, name:value; written raw (the values are the named constants above).
pub fn lr_decl(o: []u8, n0: u32, name: []const u8, value: []const u8) -> u32 {
    var n : u32 = raw(o, n0, name);
    n = raw(o, n, ":");
    n = raw(o, n, value);
    return raw(o, n, ";");
}

/// One @font-face: family, file, weight range and unicode range.
pub fn lr_face(o: []u8, n0: u32, family: []const u8, file: []const u8, weight: []const u8, range: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "@font-face{font-family:");
    n = raw(o, n, family);
    n = raw(o, n, ";src:url('/fonts/");
    n = raw(o, n, file);
    n = raw(o, n, "') format('woff2');font-weight:");
    n = raw(o, n, weight);
    n = raw(o, n, ";font-display:swap;unicode-range:");
    n = raw(o, n, range);
    return raw(o, n, "}");
}

/// The whole style sheet: fonts, the token block, then the rules.
pub fn lr_css(o: []u8, n0: u32) -> u32 {
    var n : u32 = lr_face(o, n0, "Outfit", "outfit-latin.woff2", "400 800", RANGE_LATIN);
    n = lr_face(o, n, "'JetBrains Mono'", "jetbrains-mono-latin.woff2", "400 500", RANGE_LATIN);
    n = lr_face(o, n, "'JetBrains Mono'", "jetbrains-mono-cyrillic.woff2", "400 500", RANGE_CYRILLIC);
    n = raw(o, n, ":root{");
    n = lr_decl(o, n, "--bg", C_BG);
    n = lr_decl(o, n, "--text", C_TEXT);
    n = lr_decl(o, n, "--muted", C_MUTED);
    n = lr_decl(o, n, "--foot", C_FOOT);
    n = lr_decl(o, n, "--kick", C_KICK);
    n = lr_decl(o, n, "--card-line", C_CARD_LINE);
    n = lr_decl(o, n, "--badge-line", C_BADGE_LINE);
    n = lr_decl(o, n, "--glass", C_GLASS);
    n = lr_decl(o, n, "--blur", GLASS_BLUR);
    n = lr_decl(o, n, "--maxw", MAX_WIDTH);
    n = lr_decl(o, n, "--grid-min", GRID_MIN);
    n = lr_decl(o, n, "--s1", SP_1);
    n = lr_decl(o, n, "--s2", SP_2);
    n = lr_decl(o, n, "--s3", SP_3);
    n = lr_decl(o, n, "--s4", SP_4);
    n = lr_decl(o, n, "--s6", SP_6);
    n = lr_decl(o, n, "--s8", SP_8);
    n = lr_decl(o, n, "--sans", FONT_SANS);
    n = lr_decl(o, n, "--mono", FONT_MONO);
    n = raw(o, n, "}");
    n = raw(o, n, CSS_BASE);
    n = raw(o, n, CSS_NAV);
    n = raw(o, n, CSS_HERO);
    n = raw(o, n, CSS_CARDS);
    n = raw(o, n, CSS_MOTION);
    return raw(o, n, CSS_APP);
}

/// A number of two digits at least: 01 .. 12.
pub fn lr_two(o: []u8, n0: u32, v: u32) -> u32 {
    var n : u32 = n0;
    if (v < 10) { n = put(o, n, 48); }
    return num(o, n, v as u64);
}

/// The phone HUD rules, then the view rules: CSS_VIEW and one show rule per view, #v-ID:target~main #w-ID.
/// A section hash puts the overview of its section in the centre: #lessons the course list, articles the blog,
/// results the proofs, about the Trinity page. CSS_UNI comes last, in lr_head.
pub fn lr_css_phone(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, CSS_PHONE);
    n = raw(o, n, CSS_VIEW);
    var v : u32 = 0;
    while (v < N_VIEWS) {
        if (v > 0) { n = raw(o, n, ","); }
        n = raw(o, n, "#v-");
        n = text(o, n, VIEW_IDS[v as usize]);
        n = raw(o, n, ":target~main #w-");
        n = text(o, n, VIEW_IDS[v as usize]);
        if (v == V_COURSES) { n = raw(o, n, ",#lessons:target~main #w-courses"); }
        if (v == V_BLOG) { n = raw(o, n, ",#h-articles:target~main #w-blog,#articles:target~main #w-blog"); }
        if (v == V_PROOF) { n = raw(o, n, ",#h-results:target~main #w-proof,#results:target~main #w-proof"); }
        if (v == V_TRINITY) { n = raw(o, n, ",#h-about:target~main #w-trinity,#about:target~main #w-trinity"); }
        v = v + 1;
    }
    return raw(o, n, "{top:0;visibility:visible}");
}

/// The href of a link to view v: " href=\"#v-ID\""; NO_VIEW writes the GitHub issues address.
pub fn lr_href(o: []u8, n0: u32, v: u32) -> u32 {
    if (v == NO_VIEW) { return attr(o, n0, "href", ISSUES_HREF); }
    var n : u32 = raw(o, n0, " href=\"#v-");
    n = text(o, n, VIEW_IDS[v as usize]);
    return raw(o, n, "\"");
}

/// The group class of view v's marker, the rail item it lights: " vc" a course, " va" the blog and the posts,
/// " vr" a result, " vb" an about page, " zg zK" a Queen screen of group K; the courses list, the map (it shows only
/// the map, no strip), play and EN have none.
pub fn lr_group(o: []u8, n0: u32, v: u32) -> u32 {
    if (v < N_LESSONS) { return raw(o, n0, " vc"); }
    if (v == V_QUEEN) { return raw(o, n0, " vm"); }
    if (v < V_BLOG) { return n0; }
    if (v < V_PROOF) { return raw(o, n0, " va"); }
    if (v < V_TRINITY) { return raw(o, n0, " vr"); }
    if (v < V_QUEEN) { return raw(o, n0, " vb"); }
    if (v > V_PLAY) { return lr_zclass(o, n0, v); }
    return n0;
}

/// The :target markers, empty and fixed (no scroll): one per panel tab after the first, one per section name,
/// one per view. They precede the rail and main, so the CSS reads the state with `~`; view markers carry a group.
/// The section-name markers are the public hashes of the sections: #lessons, #articles, #results and #about
/// drive the panel and the rail exactly as the rail item of that section does.
pub fn lr_markers(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    n = raw(o, n, "<i class=\"cs\" id=\"chat\"></i>");
    var i : u32 = 1;
    while (i < N_SECTIONS) {
        n = raw(o, n, "<i class=\"st\" id=\"h-");
        n = text(o, n, SEC_IDS[i as usize]);
        n = raw(o, n, "\"></i>");
        i = i + 1;
    }
    var a : u32 = 0;
    while (a < N_SECTIONS) {
        n = raw(o, n, "<i class=\"st\" id=\"");
        n = text(o, n, SEC_IDS[a as usize]);
        n = raw(o, n, "\"></i>");
        a = a + 1;
    }
    var v : u32 = 0;
    while (v < N_VIEWS) {
        n = raw(o, n, "<i class=\"st");
        n = lr_group(o, n, v);
        n = raw(o, n, "\" id=\"v-");
        n = text(o, n, VIEW_IDS[v as usize]);
        n = raw(o, n, "\"></i>");
        v = v + 1;
    }
    return n;
}

/// The first src of course k: the static page of the first lesson of its Z rail (same-origin, so a Z press can retarget it).
pub fn lr_frame_src(o: []u8, n0: u32, k: u32) -> u32 {
    var n : u32 = raw(o, n0, " src=\"");
    n = text(o, n, LZ_HREFS[(k * SEGMENTS) as usize]);
    return raw(o, n, "\"");
}

/// True when view v has a built display (lr_srcdoc) instead of an app page: the views 13 .. 55 but the memory page and
/// the spec player.
pub fn lr_has_doc(v: u32) -> bool {
    if (v < DOC_FIRST) { return false; }
    if (v == V_MEMORY) { return false; }
    if (v == V_PLAY) { return false; }
    return v < N_VIEWS;
}

/// The string of slot s of view v's document.
pub fn lr_dstr(v: u32, s: u32) -> str {
    return DOC[((v - DOC_FIRST) * DOC_SLOTS + s) as usize];
}

/// True when s is not empty.
pub fn lr_nonempty(s: []const u8) -> bool {
    return s.len > 0;
}

/// True when section k (0 .. 2) of view v's document has a heading.
pub fn lr_dsec(v: u32, k: u32) -> bool {
    return lr_nonempty(lr_dstr(v, 2 + 2 * k));
}

/// Text inside the document inside the attribute: the document escape (& < >) and then the attribute escape.
pub fn lr_dtext(o: []u8, n0: u32, s: []const u8) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    while (i < s.len) {
        const b : u8 = s[i];
        var done : bool = false;
        if (b == 38) { n = raw(o, n, "&amp;amp;"); done = true; }
        if (b == 60) { n = raw(o, n, "&amp;lt;"); done = true; }
        if (b == 62) { n = raw(o, n, "&amp;gt;"); done = true; }
        if (b == 34) { n = raw(o, n, "&quot;"); done = true; }
        if (b == 39) { n = raw(o, n, "&#39;"); done = true; }
        if (!done) { n = put(o, n, b); }
        i = i + 1;
    }
    return n;
}

/// The srcdoc of view v: the head and style of the document, the kicker, the title and up to three sections, each
/// an h2 with id dK (the Z link of the section lands on it) and a paragraph. Black and white, no script.
pub fn lr_srcdoc(o: []u8, n0: u32, v: u32) -> u32 {
    var n : u32 = raw(o, n0, " srcdoc=\"");
    n = text(o, n, DOC_HEAD);
    n = raw(o, n, "&lt;p class=k&gt;");
    n = lr_dtext(o, n, lr_dstr(v, 1));
    n = raw(o, n, "&lt;/p&gt;&lt;h1&gt;");
    n = lr_dtext(o, n, lr_dstr(v, 0));
    n = raw(o, n, "&lt;/h1&gt;");
    var k : u32 = 0;
    while (k < 3) {
        if (lr_dsec(v, k)) {
            n = raw(o, n, "&lt;h2 id=d");
            n = num(o, n, (k + 1) as u64);
            n = raw(o, n, "&gt;");
            n = lr_dtext(o, n, lr_dstr(v, 2 + 2 * k));
            n = raw(o, n, "&lt;/h2&gt;&lt;p&gt;");
            n = lr_dtext(o, n, lr_dstr(v, 3 + 2 * k));
            n = raw(o, n, "&lt;/p&gt;");
        }
        k = k + 1;
    }
    return raw(o, n, "\"");
}

/// The Z rail of view v's document: its sections, each a link into the document (about:srcdoc#dK) in the frame of
/// the view, the section number as the slot key. No icon: the icons of the page are counted and pinned.
pub fn lr_zdoc(o: []u8, n0: u32, v: u32) -> u32 {
    var n : u32 = raw(o, n0, "<nav class=\"zr\" id=\"z-");
    n = text(o, n, VIEW_IDS[v as usize]);
    n = raw(o, n, "\"");
    n = attr(o, n, "aria-label", lr_dstr(v, 0));
    n = raw(o, n, ">");
    var k : u32 = 0;
    while (k < 3) {
        if (lr_dsec(v, k)) {
            n = raw(o, n, "<a href=\"about:srcdoc#d");
            n = num(o, n, (k + 1) as u64);
            n = raw(o, n, "\"");
            n = lr_frame_target(o, n, v);
            n = raw(o, n, "><b class=\"key\">");
            n = lr_two(o, n, k + 1);
            n = raw(o, n, "</b><span");
            n = attr(o, n, "title", lr_dstr(v, 2 + 2 * k));
            n = raw(o, n, ">");
            n = text(o, n, lr_dstr(v, 2 + 2 * k));
            n = raw(o, n, "</span></a>");
        }
        k = k + 1;
    }
    return raw(o, n, "</nav>\n");
}

/// The view sections, inside the panel: one lazy iframe each, loaded only when its view is shown.
pub fn lr_views(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    var v : u32 = 0;
    while (v < N_VIEWS) {
        n = raw(o, n, "<section class=\"view\" id=\"w-");
        n = text(o, n, VIEW_IDS[v as usize]);
        n = raw(o, n, "\"><iframe loading=\"lazy\" title=\"");
        n = text(o, n, VIEW_TITLE_PRE);
        n = text(o, n, VIEW_IDS[v as usize]);
        n = raw(o, n, "\"");
        if (v < N_LESSONS) { n = lr_frame_name(o, n, v); }
        if (lr_has_doc(v)) { n = lr_frame_name(o, n, v); }
        if (v < N_LESSONS) { n = lr_frame_src(o, n, v); }
        if (v >= N_LESSONS) {
            if (lr_has_doc(v)) { n = lr_srcdoc(o, n, v); } else { n = attr(o, n, "src", VIEW_SRCS[v as usize]); }
        }
        n = raw(o, n, "></iframe></section>\n");
        v = v + 1;
    }
    return n;
}

/// The document up to and including <body>: head, metas, links and the style sheet.
pub fn lr_head(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<!doctype html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>");
    n = text(o, n, TITLE);
    n = raw(o, n, "</title>\n");
    n = pk_meta(o, n, "name", "description", DESCRIPTION);
    n = pk_meta(o, n, "name", "theme-color", C_BG);
    n = raw(o, n, "<link rel=\"canonical\" href=\"");
    n = raw(o, n, CANONICAL);
    n = raw(o, n, "\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"");
    n = raw(o, n, ORIGIN);
    n = raw(o, n, "\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"");
    n = raw(o, n, CANONICAL);
    n = raw(o, n, "\">\n<link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">\n");
    n = pk_meta(o, n, "property", "og:type", "website");
    n = pk_meta(o, n, "property", "og:locale", "ru_RU");
    n = pk_meta(o, n, "property", "og:site_name", SITE_NAME);
    n = pk_meta(o, n, "property", "og:url", CANONICAL);
    n = pk_meta(o, n, "property", "og:title", TITLE);
    n = pk_meta(o, n, "property", "og:description", DESCRIPTION);
    n = pk_meta(o, n, "property", "og:image", IMAGE);
    n = raw(o, n, "<style>");
    n = lr_css(o, n);
    n = lr_css_phone(o, n);
    n = raw(o, n, "@media (min-width:720px){.app{grid-template-rows:auto auto minmax(0,1fr) auto auto}.rail,.panel{grid-row:3}.panel{grid-column:2/4}#s-lessons{grid-row:4}.foot{grid-row:5}.hero{grid-column:1/4;grid-row:2;flex-direction:row;align-items:center;justify-content:flex-start;gap:16px;padding:8px 16px;text-align:left;overflow:hidden}.hero h1{font-size:18px;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}.hero .lede,.hero .stat{display:none}.hero .acts{flex-direction:row;flex-wrap:nowrap;margin:0 0 0 auto;gap:6px}.hero .btn{padding:6px 12px;white-space:nowrap}}@media (min-width:720px) and (max-width:1099px){.app{grid-template-rows:auto auto auto minmax(0,1fr) auto auto}.rail{grid-row:2}.hero{grid-column:1/3;grid-row:3}.panel{grid-column:1/3;grid-row:4}#s-lessons{grid-row:5}.foot{grid-row:6}.hero .cap{display:none}}");
    n = raw(o, n, CSS_UNI);
    n = raw(o, n, CSS_XTAB);
    n = raw(o, n, CSS_ICO);
    n = lr_css_group(o, n);
    n = lr_css_zr(o, n);
    n = raw(o, n, CSS_FRAME);
    n = raw(o, n, CSS_CHAT);
    n = raw(o, n, CSS_ITEM);
    n = lr_css_lit(o, n);
    return raw(o, n, "</style>\n</head>\n<body>\n");
}

/// The open item of the X strip, lit like the open rail tab: one selector per view, "#v-ID:target~main .x
/// [href='#v-ID']", so every view URL inverts its own strip item and no other.
pub fn lr_css_strip(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    var v : u32 = 0;
    while (v < N_VIEWS) {
        if (v > 0) { n = raw(o, n, ","); }
        n = raw(o, n, "#v-");
        n = text(o, n, VIEW_IDS[v as usize]);
        n = raw(o, n, ":target~main .x [href='#v-");
        n = text(o, n, VIEW_IDS[v as usize]);
        n = raw(o, n, "']");
        v = v + 1;
    }
    return n;
}

/// The ONE lit rule of the page (owner 2026-11-21): the hovered or focused item of Y, X and Z, the open rail item, the
/// open strip item and the open group slot all get the same look, white fill and black text, written once.
pub fn lr_css_lit(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, CSS_DEFAULT_SEL);
    n = raw(o, n, "{background:var(--text);color:var(--bg)}");
    n = raw(o, n, CSS_DEFAULT_OFF);
    n = raw(o, n, "{background:none;color:var(--muted)}");
    n = raw(o, n, ".rail>a:hover,.rail>a:focus,.zr a:hover,.zr a:focus,.x .card:hover,.x .tile:hover,");
    n = raw(o, n, CSS_LIT_SEL);
    n = raw(o, n, ",");
    n = lr_css_strip(o, n);
    n = raw(o, n, ",");
    n = lr_css_group_lit(o, n);
    return raw(o, n, "{background:var(--text);color:var(--bg);opacity:1;outline:0}");
}

/// One HUD readout: [ WORD value ], the value computed by the caller.
pub fn lr_readout(o: []u8, n0: u32, word: []const u8, v: u32) -> u32 {
    var n : u32 = raw(o, n0, "<span");
    n = attr(o, n, "title", word);
    n = raw(o, n, "><b>");
    n = num(o, n, v as u64);
    n = raw(o, n, "</b><i class=\"lb\">");
    n = text(o, n, word);
    return raw(o, n, "</i></span>");
}

/// The sticky glass HUD bar: logo and wordmark, readouts (counted from the arrays), anchors, EN and the map button.
pub fn lr_nav(o: []u8, n0: u32) -> u32 {
    var n : u32 = lr_markers(o, n0);
    n = raw(o, n, "<nav class=\"top glass\"");
    n = attr(o, n, "aria-label", BAR_LABEL);
    n = raw(o, n, ">\n<a class=\"brand\"");
    n = attr(o, n, "href", HREF_HOME);
    n = attr(o, n, "title", SITE_NAME);
    n = attr(o, n, "aria-label", SITE_NAME);
    n = raw(o, n, ">");
    n = raw(o, n, LOGO_SVG);
    return raw(o, n, "</a>\n");
}

/// The end of the header row (logo tile and the Y tiles).
pub fn lr_nav_end(o: []u8, n0: u32) -> u32 {
    return raw(o, n0, "</nav>\n");
}

/// A rail slot's inside: the icon, the name, then the slot key number (a game-HUD hint, 1 .. 9).
pub fn lr_rail_face(o: []u8, n0: u32, path: []const u8, title: []const u8, key: u32) -> u32 {
    var n : u32 = lr_ico(o, n0, path);
    n = raw(o, n, "<span class=\"lb\"");
    n = attr(o, n, "title", title);
    n = raw(o, n, ">");
    n = text(o, n, title);
    n = raw(o, n, "</span><b class=\"key\">");
    n = num(o, n, key as u64);
    return raw(o, n, "</b>");
}

/// The rail slot of section i (its panel tab, #h-ID) with slot key key.
pub fn lr_rail_sec(o: []u8, n0: u32, i: u32, key: u32) -> u32 {
    var n : u32 = raw(o, n0, "<a href=\"#h-");
    n = text(o, n, SEC_IDS[i as usize]);
    n = raw(o, n, "\">");
    n = lr_rail_face(o, n, SEC_ICONS[i as usize], SEC_TITLES[i as usize], key);
    return raw(o, n, "</a>");
}

/// The name of course k's frame, f-ID: the Z rail's lesson links target it, so a lesson opens in the course view.
pub fn lr_frame_name(o: []u8, n0: u32, k: u32) -> u32 {
    var n : u32 = raw(o, n0, " name=\"f-");
    n = text(o, n, VIEW_IDS[k as usize]);
    return raw(o, n, "\"");
}

/// The Z rail of course k (owner 2026-11-21), the mirror of the Y rail on the right: its 27 lessons, each a link
/// into the course frame (target f-ID), the lesson number as the slot key. Y Courses, X the course, Z the lesson:
/// a lesson is three presses away. It shows only while course k is open.
pub fn lr_zrail(o: []u8, n0: u32, k: u32) -> u32 {
    var n : u32 = raw(o, n0, "<nav class=\"zr\" id=\"z-");
    n = text(o, n, VIEW_IDS[k as usize]);
    n = raw(o, n, "\"");
    n = attr(o, n, "aria-label", LESSON_TITLES[k as usize]);
    n = raw(o, n, ">");
    var j : u32 = 0;
    while (j < SEGMENTS) {
        const e : u32 = k * SEGMENTS + j;
        n = raw(o, n, "<a href=\"");
        n = text(o, n, LZ_HREFS[e as usize]);
        n = raw(o, n, "\"");
        n = lr_frame_target(o, n, k);
        n = raw(o, n, ">");
        n = lr_lz_ico(o, n, e);
        n = raw(o, n, "<b class=\"key\">");
        n = lr_two(o, n, j + 1);
        n = raw(o, n, "</b><span");
        n = attr(o, n, "title", LZ_TITLES[e as usize]);
        n = raw(o, n, ">");
        n = text(o, n, LZ_TITLES[e as usize]);
        n = raw(o, n, "</span></a>");
        j = j + 1;
    }
    return raw(o, n, "</nav>\n");
}

/// The d attribute of the icon of Z lesson e = k*27 + j, drawn from its numbers so all 324 differ: a top bar
/// 5+k long names the course, and three dashes, one per base-3 digit of j (left, middle, right), name the lesson.
pub fn lr_lz_path(o: []u8, n0: u32, e: u32) -> u32 {
    const k : u32 = e / SEGMENTS;
    var j : u32 = e - k * SEGMENTS;
    var n : u32 = raw(o, n0, "M4 5h");
    n = num(o, n, (k + 5) as u64);
    var r : u32 = 0;
    while (r < 3) {
        const d : u32 = j - (j / 3) * 3;
        n = raw(o, n, "M");
        n = num(o, n, (4 + 6 * d) as u64);
        n = raw(o, n, " ");
        n = num(o, n, (11 + 4 * r) as u64);
        n = raw(o, n, "h4");
        j = j / 3;
        r = r + 1;
    }
    return n;
}

/// The icon of Z lesson e, in the face of a Y item.
pub fn lr_lz_ico(o: []u8, n0: u32, e: u32) -> u32 {
    var n : u32 = raw(o, n0, "<svg class=\"ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"");
    n = lr_lz_path(o, n, e);
    return raw(o, n, "\"/></svg>");
}

/// The target attribute of a lesson link of course k.
pub fn lr_frame_target(o: []u8, n0: u32, k: u32) -> u32 {
    var n : u32 = raw(o, n0, " target=\"f-");
    n = text(o, n, VIEW_IDS[k as usize]);
    return raw(o, n, "\"");
}

/// The twelve Z rails, after the X strips.
pub fn lr_zrails(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    var k : u32 = 0;
    while (k < N_LESSONS) {
        n = lr_zrail(o, n, k);
        k = k + 1;
    }
    var v : u32 = DOC_FIRST;
    while (v < N_VIEWS) {
        if (lr_has_doc(v)) { n = lr_zdoc(o, n, v); }
        v = v + 1;
    }
    return n;
}

/// True when view v has a Z rail: a course (its 27 lessons) or a built display (its sections).
pub fn lr_has_z(v: u32) -> bool {
    if (v < N_LESSONS) { return true; }
    return lr_has_doc(v);
}

/// The Z state: the base look (CSS_ZR), then one rule that shows the Z rail of view v while its view is open, and one
/// that keeps the display clear of the Z row.
pub fn lr_css_zr(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, CSS_ZR);
    n = raw(o, n, CSS_ZR_DEFAULT);
    var first : bool = true;
    var v : u32 = 0;
    while (v < N_VIEWS) {
        if (lr_has_z(v)) {
            if (!first) { n = raw(o, n, ","); }
            first = false;
            n = raw(o, n, "#v-");
            n = text(o, n, VIEW_IDS[v as usize]);
            n = raw(o, n, ":target~main #z-");
            n = text(o, n, VIEW_IDS[v as usize]);
            if (v == V_BLOG) { n = raw(o, n, ",#h-articles:target~main #z-blog,#articles:target~main #z-blog"); }
            if (v == V_PROOF) { n = raw(o, n, ",#h-results:target~main #z-proof,#results:target~main #z-proof"); }
            if (v == V_TRINITY) { n = raw(o, n, ",#h-about:target~main #z-trinity,#about:target~main #z-trinity"); }
        }
        v = v + 1;
    }
    n = raw(o, n, "{display:flex}");
    first = true;
    v = 0;
    while (v < N_VIEWS) {
        if (lr_has_z(v)) {
            if (!first) { n = raw(o, n, ","); }
            first = false;
            n = raw(o, n, "#v-");
            n = text(o, n, VIEW_IDS[v as usize]);
            n = raw(o, n, ":target~main .panel");
            if (v == V_BLOG) { n = raw(o, n, ",#h-articles:target~main .panel,#articles:target~main .panel"); }
            if (v == V_PROOF) { n = raw(o, n, ",#h-results:target~main .panel,#results:target~main .panel"); }
            if (v == V_TRINITY) { n = raw(o, n, ",#h-about:target~main .panel,#about:target~main .panel"); }
        }
        v = v + 1;
    }
    return raw(o, n, "{grid-area:2/2/3/3!important}");
}


/// The rail and the HUD state. The :target markers come first (lr_markers), so the CSS reads the state with `~`
/// and never with :has(:target), which Chromium does not re-check on a hash change. Every rail item is an anchor and
/// a game slot: 1 About (first, owner 2026-11-21), 2 Courses (the course list view), 3 .. 4 Articles and Results (their panel tab), 5 .. 8 the four
/// groups of the Queen menu (each opens the first view of its group and shows its X strip), 9 the Map (only the map).
pub fn lr_rail(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "\n<nav class=\"rail\"");
    n = attr(o, n, "aria-label", NAV_LABEL);
    n = raw(o, n, ">");
    n = raw(o, n, "<a");
    n = lr_href(o, n, 0);
    n = raw(o, n, ">");
    n = lr_rail_face(o, n, SEC_ICONS[0], SEC_TITLES[0], 1);
    n = raw(o, n, "</a>");
    var i : u32 = 1;
    while (i < SEC_ABOUT) {
        n = lr_rail_sec(o, n, i, i + 1);
        i = i + 1;
    }
    n = lr_rail_sec(o, n, SEC_ABOUT, SEC_ABOUT + 1);
    var g : u32 = 0;
    while (g < N_QZ) {
        n = raw(o, n, "<a");
        n = lr_href(o, n, QZ_FIRST[g as usize]);
        n = raw(o, n, ">");
        n = lr_rail_face(o, n, QZ_ICONS[g as usize], QZ_TITLES[g as usize], N_SECTIONS + 1 + g);
        n = raw(o, n, "</a>");
        g = g + 1;
    }
    n = raw(o, n, "<a");
    n = lr_href(o, n, V_QUEEN);
    n = raw(o, n, ">");
    n = lr_rail_face(o, n, RAIL_MAP_ICON, RAIL_MAP, N_SECTIONS + N_QZ + 1);
    n = raw(o, n, "</a>");
    return raw(o, n, "</nav>\n");
}

/// The right side of the frame: the outside links (each opens a new tab), then the counters and the EN tile, all square tiles.
pub fn lr_side(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<nav class=\"side\"");
    n = attr(o, n, "aria-label", SIDE_LABEL);
    n = raw(o, n, ">");
    n = raw(o, n, "<a class=\"chat-open\"");
    n = attr(o, n, "href", CHAT_SRC);
    n = raw(o, n, " target=\"_blank\" rel=\"noopener\">");
    n = raw(o, n, "<img class=\"chat-av\"");
    n = attr(o, n, "src", CHAT_AVATAR);
    n = raw(o, n, " alt=\"\" width=\"40\" height=\"40\">");
    n = raw(o, n, "<span class=\"lb\"");
    n = attr(o, n, "title", CHAT_TITLE);
    n = raw(o, n, ">");
    n = text(o, n, CHAT_LABEL);
    n = raw(o, n, "</span></a>");
    var j : u32 = 0;
    while (j < N_FOOT) {
        n = raw(o, n, "<a class=\"ext\"");
        n = attr(o, n, "href", FOOT_HREFS[j as usize]);
        n = raw(o, n, " target=\"_blank\" rel=\"noopener\">");
        n = lr_ico(o, n, FOOT_ICONS[j as usize]);
        n = raw(o, n, "<span class=\"lb\"");
        n = attr(o, n, "title", FOOT_LABELS[j as usize]);
        n = raw(o, n, ">");
        n = text(o, n, FOOT_LABELS[j as usize]);
        n = raw(o, n, "</span>");
        n = raw(o, n, "</a>");
        j = j + 1;
    }
    n = raw(o, n, "<a class=\"ext\"");
    n = attr(o, n, "href", SOURCE_URL);
    n = raw(o, n, " title=\"");
    n = text(o, n, END_LINE);
    n = text(o, n, FOOT_SOURCE_NAME);
    n = raw(o, n, "\" target=\"_blank\" rel=\"noopener\">");
    n = lr_ico(o, n, RAIL_SOURCE_ICON);
    n = raw(o, n, "<span class=\"lb\">");
    n = text(o, n, RAIL_SOURCE);
    n = raw(o, n, "</span>");
    n = raw(o, n, "</a>");
    n = lr_readout(o, n, HUD_COURSES, N_LESSONS);
    n = lr_readout(o, n, HUD_LESSONS, N_LESSONS * SEGMENTS);
    n = lr_readout(o, n, HUD_POSTS, N_POSTS);
    n = raw(o, n, "<a class=\"lang\" lang=\"en\"");
    n = attr(o, n, "href", LANG_HREF);
    n = raw(o, n, ">");
    n = text(o, n, LANG_EN);
    return raw(o, n, "</a></nav>\n");
}

/// The centre: the targeted view shows, the course list when nothing is targeted; no tab row of its own.
pub fn lr_tabs(o: []u8, n0: u32) -> u32 {
    return raw(o, n0, "<div class=\"panel\">\n");
}

/// A button of the hero: kind is pri or sec.
pub fn lr_button(o: []u8, n0: u32, kind: []const u8, v: u32, label: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<a class=\"btn ");
    n = raw(o, n, kind);
    n = raw(o, n, "\"");
    n = lr_href(o, n, v);
    n = raw(o, n, ">");
    n = text(o, n, label);
    return raw(o, n, "</a>");
}

/// The hero: caption (with its cursor), the one h1, the lead, the buttons and the status line.
pub fn lr_hero(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<main class=\"wrap\">\n<header class=\"hero\">\n");
    n = raw(o, n, "<span class=\"cap\">");
    n = text(o, n, MOTTO_CAPTION);
    n = raw(o, n, "</span>\n<h1>");
    n = text(o, n, MOTTO_HEADLINE);
    n = raw(o, n, ": ");
    n = text(o, n, MOTTO_CLAUSE);
    n = raw(o, n, "</h1>\n<p class=\"lede\">");
    n = text(o, n, HERO_LEDE);
    n = raw(o, n, "</p>\n<div class=\"acts\">");
    n = lr_button(o, n, "sec", V_PLAY, BTN_PLAY);
    n = lr_button(o, n, "sec", V_TRINITY, BTN_NUMBER);
    n = raw(o, n, "</div>\n<p class=\"stat\">");
    n = text(o, n, STATUS_LINE);
    return raw(o, n, "</p>\n</header>\n");
}

/// The opening of a card: one anchor. more is " more" for the "all" card, else "".
pub fn lr_card_open(o: []u8, n0: u32, more: []const u8, v: u32) -> u32 {
    var n : u32 = raw(o, n0, "<a class=\"card");
    n = raw(o, n, more);
    n = raw(o, n, "\"");
    n = lr_href(o, n, v);
    return raw(o, n, ">");
}

/// The title and the line of a card, then its end.
pub fn lr_card_tail(o: []u8, n0: u32, title: []const u8, line: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<h3");
    n = attr(o, n, "title", title);
    n = raw(o, n, ">");
    n = text(o, n, title);
    n = raw(o, n, "</h3><p>");
    n = text(o, n, line);
    return raw(o, n, "</p>");
}

/// A course tile of the hub: index and status pill, title, an empty progress bar of SEGMENTS cells, the foot 0 / 27.
/// The tile is a link to its course view (view k), so choosing it opens the course at once, inside the HUD.
pub fn lr_tile(o: []u8, n0: u32, k: u32) -> u32 {
    var n : u32 = raw(o, n0, "<a class=\"tile\"");
    n = lr_href(o, n, k);
    n = raw(o, n, "><div class=\"top2\">");
    n = lr_ico(o, n, LESSON_ICONS[k as usize]);
    n = raw(o, n, "<span class=\"idx\">");
    n = lr_two(o, n, k + 1);
    n = raw(o, n, "</span><span class=\"kick\">");
    n = text(o, n, PILL_OPEN);
    n = raw(o, n, "</span></div><h3");
    n = attr(o, n, "title", LESSON_TITLES[k as usize]);
    n = raw(o, n, ">");
    n = text(o, n, LESSON_TITLES[k as usize]);
    n = raw(o, n, "</h3><div class=\"bar\" aria-hidden=\"true\">");
    var s : u32 = 0;
    while (s < SEGMENTS) {
        n = raw(o, n, "<i></i>");
        s = s + 1;
    }
    n = raw(o, n, "</div><p class=\"pf\">");
    n = text(o, n, PF_PRE);
    n = num(o, n, SEGMENTS as u64);
    return raw(o, n, "</p></a>\n");
}


/// The head of a section, a strip of class x: its internal id, the level line (LEVEL NN / 04, the section name) and its h2.
pub fn lr_section_head(o: []u8, n0: u32, k: u32) -> u32 {
    var n : u32 = raw(o, n0, "<section class=\"x\" id=\"");
    n = text(o, n, SEC_DOM_IDS[k as usize]);
    n = raw(o, n, "\">\n<p class=\"lvl\">");
    n = text(o, n, LVL_WORD);
    n = lr_two(o, n, k + 1);
    n = raw(o, n, " / ");
    n = lr_two(o, n, N_SECTIONS);
    n = raw(o, n, " · ");
    n = text(o, n, SEC_UPPER[k as usize]);
    n = raw(o, n, "</p>\n<h2>");
    n = text(o, n, SEC_TITLES[k as usize]);
    return raw(o, n, "</h2>\n");
}

/// The start of a card section: the head and the grid.
pub fn lr_section_open(o: []u8, n0: u32, k: u32) -> u32 {
    var n : u32 = lr_section_head(o, n0, k);
    return raw(o, n, "<div class=\"grid\">\n");
}

pub fn lr_section_close(o: []u8, n0: u32) -> u32 {
    return raw(o, n0, "</div>\n</section>\n");
}

/// The lessons hub, a level-select screen: the readout line (counted), 12 tiles in a hairline grid, the all-courses pill.
pub fn lr_lessons(o: []u8, n0: u32) -> u32 {
    var n : u32 = lr_section_head(o, n0, 0);
    n = raw(o, n, "<p class=\"hubline\">");
    n = text(o, n, HUB_PRE);
    n = num(o, n, N_LESSONS as u64);
    n = text(o, n, HUB_MID1);
    n = num(o, n, (N_LESSONS * SEGMENTS) as u64);
    n = text(o, n, HUB_MID2);
    n = raw(o, n, "</p>\n<div class=\"hub\">\n");
    var i : u32 = 0;
    while (i < N_LESSONS) {
        n = lr_tile(o, n, i);
        i = i + 1;
    }
    n = raw(o, n, "</div>\n<a class=\"btn pri all\"");
    n = lr_href(o, n, V_COURSES);
    n = raw(o, n, ">");
    n = text(o, n, LESSONS_ALL_TITLE);
    n = text(o, n, ALL_ARROW);
    n = raw(o, n, "</a>\n<p class=\"hubnote\">");
    n = text(o, n, LESSONS_ALL_LINE);
    return raw(o, n, "</p>\n</section>\n");
}

pub fn lr_articles(o: []u8, n0: u32) -> u32 {
    var n : u32 = lr_section_open(o, n0, 1);
    var i : u32 = 0;
    while (i < N_POSTS) {
        n = lr_card_ico(o, n, "", POST_VIEWS[i as usize], POST_ICONS[i as usize], POST_TITLES[i as usize], POST_LINES[i as usize]);
        i = i + 1;
    }
    n = lr_card_ico(o, n, " more", V_BLOG, POSTS_ALL_ICON, POSTS_ALL_TITLE, POSTS_ALL_LINE);
    return lr_section_close(o, n);
}

pub fn lr_results(o: []u8, n0: u32) -> u32 {
    var n : u32 = lr_section_open(o, n0, 2);
    var i : u32 = 0;
    while (i < N_RESULTS) {
        n = lr_card_ico(o, n, "", RESULT_VIEWS[i as usize], RESULT_ICONS[i as usize], RESULT_TITLES[i as usize], RESULT_LINES[i as usize]);
        i = i + 1;
    }
    return lr_section_close(o, n);
}

pub fn lr_about(o: []u8, n0: u32) -> u32 {
    var n : u32 = lr_section_open(o, n0, 3);
    var i : u32 = 0;
    while (i < N_ABOUT) {
        n = lr_card_ico(o, n, "", ABOUT_VIEWS[i as usize], ABOUT_ICONS[i as usize], ABOUT_TITLES[i as usize], ABOUT_LINES[i as usize]);
        i = i + 1;
    }
    return lr_section_close(o, n);
}

/// One menu icon: a line drawing on the 24 grid, the same for the rail and the strips.
pub fn lr_ico(o: []u8, n0: u32, path: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<svg class=\"ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"");
    n = raw(o, n, path);
    return raw(o, n, "\"/></svg>");
}

/// A strip card: the icon, the title and the line.
pub fn lr_card_ico(o: []u8, n0: u32, more: []const u8, v: u32, path: []const u8, title: []const u8, line: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<a class=\"card");
    n = raw(o, n, more);
    n = raw(o, n, "\"");
    n = lr_href(o, n, v);
    n = raw(o, n, ">");
    n = lr_ico(o, n, path);
    n = lr_card_tail(o, n, title, line);
    return raw(o, n, "</a>\n");
}

/// The group of Queen view v, or N_QZ when v is not a Queen view.
pub fn lr_zgroup(v: u32) -> u32 {
    var i : u32 = 0;
    while (i < N_QUEEN) {
        if (QUEEN_VIEWS[i as usize] == v) { return QUEEN_ZG[i as usize]; }
        i = i + 1;
    }
    return N_QZ;
}

/// The group classes of view v's marker: " zg zK", K its group.
pub fn lr_zclass(o: []u8, n0: u32, v: u32) -> u32 {
    var n : u32 = raw(o, n0, " zg z");
    return num(o, n, lr_zgroup(v) as u64);
}

/// The selector [href='#v-NAME'] of view v.
pub fn lr_href_sel(o: []u8, n0: u32, v: u32) -> u32 {
    var n : u32 = raw(o, n0, "[href='#v-");
    n = text(o, n, VIEW_IDS[v as usize]);
    return raw(o, n, "']");
}

/// The group state, one rule each: the group strips are hidden, a group's strip shows while any view of the group is
/// open (its marker's class zK), and the group's rail slot lights the same way.
pub fn lr_css_group(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    var g : u32 = 0;
    while (g < N_QZ) {
        if (g > 0) { n = raw(o, n, ","); }
        n = raw(o, n, "#s-q");
        n = num(o, n, g as u64);
        g = g + 1;
    }
    n = raw(o, n, ",#s-map{display:none}");
    g = 0;
    while (g < N_QZ) {
        if (g > 0) { n = raw(o, n, ","); }
        n = raw(o, n, ".z");
        n = num(o, n, g as u64);
        n = raw(o, n, ":target~main #s-q");
        n = num(o, n, g as u64);
        g = g + 1;
    }
    return raw(o, n, ",.vm:target~main #s-map{display:grid}");
}

/// The selectors of the group slots of the rail that light while a view of the group is open (no declaration: lr_css_lit adds it).
pub fn lr_css_group_lit(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    var g : u32 = 0;
    while (g < N_QZ) {
        if (g > 0) { n = raw(o, n, ","); }
        n = raw(o, n, ".z");
        n = num(o, n, g as u64);
        n = raw(o, n, ":target~.top .rail ");
        n = lr_href_sel(o, n, QZ_FIRST[g as usize]);
        g = g + 1;
    }
    return n;
}

/// The strip of group g, an X strip like the section strips: its Queen items with their icons.
pub fn lr_group_strip(o: []u8, n0: u32, g: u32) -> u32 {
    var n : u32 = raw(o, n0, "<section class=\"x\" id=\"s-q");
    n = num(o, n, g as u64);
    n = raw(o, n, "\">\n<p class=\"lvl\">");
    n = text(o, n, QUEEN_LVL);
    n = raw(o, n, "</p>\n<h2>");
    n = text(o, n, QZ_TITLES[g as usize]);
    n = raw(o, n, "</h2>\n<div class=\"grid\">\n");
    var i : u32 = 0;
    while (i < N_QUEEN) {
        if (QUEEN_ZG[i as usize] == g) {
            n = lr_card_ico(o, n, "", QUEEN_VIEWS[i as usize], QUEEN_ICONS[i as usize], QUEEN_TITLES[i as usize], QUEEN_LINE);
        }
        i = i + 1;
    }
    return lr_section_close(o, n);
}

/// The four group strips of the Queen menu, after the section strips.
pub fn lr_group_strips(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    var g : u32 = 0;
    while (g < N_QZ) {
        n = lr_group_strip(o, n, g);
        g = g + 1;
    }
    return n;
}

/// The X strip of the Map (view 32): its own item, so the Map has an X like every other Y.
pub fn lr_map_strip(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<section class=\"x\" id=\"s-map\">\n<p class=\"lvl\">");
    n = text(o, n, QUEEN_LVL);
    n = raw(o, n, "</p>\n<h2>");
    n = text(o, n, RAIL_MAP);
    n = raw(o, n, "</h2>\n<div class=\"grid\">\n<a class=\"card\"");
    n = lr_href(o, n, V_QUEEN);
    n = raw(o, n, ">");
    n = lr_card_tail(o, n, RAIL_MAP, QUEEN_LINE);
    n = raw(o, n, "</a>\n");
    return lr_section_close(o, n);
}

/// How many sections the built displays have, the count of their Z links.
pub fn lr_doc_views() -> u32 {
    var c : u32 = 0;
    var v : u32 = DOC_FIRST;
    while (v < N_VIEWS) {
        if (lr_has_doc(v)) { c = c + 1; }
        v = v + 1;
    }
    return c;
}

pub fn lr_doc_sections() -> u32 {
    var c : u32 = 0;
    var v : u32 = DOC_FIRST;
    while (v < N_VIEWS) {
        if (lr_has_doc(v)) {
            var k : u32 = 0;
            while (k < 3) {
                if (lr_dsec(v, k)) { c = c + 1; }
                k = k + 1;
            }
        }
        v = v + 1;
    }
    return c;
}

/// The page end. The outside links and the level-end line moved into the Y rail (owner 2026-11-21), so no footer.
pub fn lr_footer(o: []u8, n0: u32) -> u32 {
    return raw(o, n0, "</main>\n</div>\n</body>\n</html>\n");
}

/// The whole page, one screen on wide displays: app frame, bar, rail (Y), stage, the four strips (X), the centre
/// with its views, footer. OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = lr_head(o, 0);
    n = raw(o, n, "<div class=\"app\">\n");
    n = lr_nav(o, n);
    n = lr_rail(o, n);
    n = lr_nav_end(o, n);
    n = lr_side(o, n);
    n = lr_hero(o, n);
    n = lr_lessons(o, n);
    n = lr_articles(o, n);
    n = lr_results(o, n);
    n = lr_about(o, n);
    n = lr_group_strips(o, n);
    n = lr_map_strip(o, n);
    n = lr_zrails(o, n);
    n = lr_tabs(o, n);
    n = lr_views(o, n);
    n = raw(o, n, "</div>\n");
    return lr_footer(o, n);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_landing_ru(out: []u8) -> u32 {
    return render_page(out);
}

/// The splicer follows only the names a module itself mentions (see html_out.t27). Never called.
pub fn lr_anchor(o: []u8) -> u32 {
    var n : u32 = put(o, 0, 0);
    n = put_escaped(o, n, 0);
    n = raw(o, n, "");
    n = text(o, n, "");
    n = attr(o, n, "", "");
    n = num(o, n, 0);
    n = fill(o, n, "", "", "", "", 0);
    return OVER + n + (H_SLASH + H_EQ + H_SPACE + H_APOS + H_QUOTE + H_AMP + H_GT + H_LT) as u32;
}

; --- tests --------------------------------------------------------------------------------------------

test the_page_is_written_and_fits_the_buffer {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert ok(n);
    assert n > 0;
    assert n < OUT_CAP;
}

test the_page_has_exactly_one_h1_and_it_is_the_motto {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "<h1") == 1;
    assert pk_count(OUT[0..], n, "</h1>") == 1;
    assert pk_has(OUT[0..], n, "<h1>Играй, управляй, зарабатывай: ядро — это игра, и доска открыта</h1>");
    assert pk_has(OUT[0..], n, "<html lang=\"ru\">");
}

test the_four_sections_exist_and_the_navigation_names_them {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "<section ") == N_SECTIONS + N_QZ + 1 + N_VIEWS;
    assert pk_count(OUT[0..], n, "<section class=\"view\"") == N_VIEWS;
    assert pk_has(OUT[0..], n, "id=\"s-lessons\"");
    assert pk_has(OUT[0..], n, "id=\"s-articles\"");
    assert pk_has(OUT[0..], n, "id=\"s-results\"");
    assert pk_has(OUT[0..], n, "id=\"s-about\"");
    assert pk_has(OUT[0..], n, "<a href=\"#v-t27-basics\"><svg class=\"ico\"");
    assert pk_has(OUT[0..], n, "<a href=\"#h-about\"><svg class=\"ico\"");
}

test each_section_opens_with_a_level_line {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "<p class=\"lvl\">") == N_SECTIONS + N_QZ + 1;
    assert pk_has(OUT[0..], n, "УРОВЕНЬ 01 / 04 · КУРСЫ");
    assert pk_has(OUT[0..], n, "УРОВЕНЬ 02 / 04 · СТАТЬИ");
    assert pk_has(OUT[0..], n, "УРОВЕНЬ 03 / 04 · РЕЗУЛЬТАТЫ");
    assert pk_has(OUT[0..], n, "УРОВЕНЬ 04 / 04 · О ПРОЕКТЕ");
}

test the_card_count_is_the_sum_of_the_section_arrays {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert N_LESSONS == 12;
    assert N_POSTS == 6;
    assert N_RESULTS == 7;
    assert N_ABOUT == 6;
    assert N_CARDS == N_POSTS + N_RESULTS + N_ABOUT + 1 + N_QUEEN;
    assert pk_count(OUT[0..], n, "<a class=\"card") == N_CARDS + 1;
    assert pk_count(OUT[0..], n, "<a class=\"card more\"") == 1;
    assert pk_count(OUT[0..], n, "<a class=\"tile\" href=") == N_LESSONS;
    assert pk_count(OUT[0..], n, "<label class=\"tile\"") == 0;
}

test the_style_sheet_has_the_glass_the_animation_and_the_reduced_motion_switch {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_has(OUT[0..], n, "@keyframes chatIn");
    assert pk_has(OUT[0..], n, "@keyframes blink");
    assert pk_has(OUT[0..], n, "-webkit-backdrop-filter");
    assert pk_has(OUT[0..], n, "blur(24px) saturate(140%)");
    assert pk_has(OUT[0..], n, "rgba(18,18,20,0.72)");
    assert pk_has(OUT[0..], n, "prefers-reduced-motion");
    assert pk_has(OUT[0..], n, ".cap::after{animation:none}");
    assert pk_has(OUT[0..], n, "scroll-behavior:smooth");
    assert pk_has(OUT[0..], n, "scroll-margin-top");
    assert pk_has(OUT[0..], n, "repeat(auto-fill,minmax(var(--grid-min),1fr))");
    assert pk_has(OUT[0..], n, "--grid-min:260px;");
}

test the_style_is_black_and_white_with_the_measured_values {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_has(OUT[0..], n, "--bg:#000;");
    assert pk_has(OUT[0..], n, "--text:#f2f2f2;");
    assert pk_has(OUT[0..], n, "--muted:#a6a6a6;");
    assert pk_has(OUT[0..], n, "--foot:#8a8a8a;");
    assert pk_has(OUT[0..], n, "--card-line:#333;");
    assert pk_has(OUT[0..], n, "--badge-line:#555;");
    assert pk_has(OUT[0..], n, "border-top:4px solid var(--text)");
    assert pk_has(OUT[0..], n, "letter-spacing:-.045em");
    assert pk_has(OUT[0..], n, "clamp(31px,6.3vw,67px)");
    assert pk_has(OUT[0..], n, "repeating-linear-gradient");
    assert pk_has(OUT[0..], n, "outfit-latin.woff2");
    assert pk_has(OUT[0..], n, "jetbrains-mono-latin.woff2");
    assert pk_has(OUT[0..], n, "jetbrains-mono-cyrillic.woff2");
    assert pk_has(OUT[0..], n, "U+301,U+400-45F,U+490-491,U+4B0-4B1,U+2116");
    assert pk_count(OUT[0..], n, "#e8c46a") == 0;
    assert pk_count(OUT[0..], n, "232,196,106") == 0;
}

/// Header and frame (owner 2026-11-21): the header is made of the same square tiles as Y, X and Z, the logo is the first
/// tile at the head of the Y column, and header, Y, X and Z are one frame with no gap between them.
test header_is_square_tiles_logo_is_a_tile_and_the_frame_is_whole {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, ".rail>a,.zr a,.x .card,.x .tile,.top>a,.side>a,.side>span{position:relative;") == 1;
    assert pk_has(OUT[0..], n, "<nav class=\"top glass\" aria-label=\"");
    assert pk_has(OUT[0..], n, "\n<a class=\"brand\" href=\"");
    assert pk_has(OUT[0..], n, "<a class=\"brand\" href=\"#\" title=\"TRINITY S³AI\" aria-label=\"TRINITY S³AI\"><svg class=\"logo\"");
    assert pk_count(OUT[0..], n, "</svg></a>\n\n<nav class=\"rail\"") == 1;
    assert pk_count(OUT[0..], n, ".top .logo{width:64%;height:64%;flex:none}") == 1;
    assert pk_has(OUT[0..], n, "<span title=\"КУРСЫ\"><b>12</b><i class=\"lb\">КУРСЫ</i></span><span title=\"УРОКИ\"><b>324</b><i class=\"lb\">УРОКИ</i></span><span title=\"СТАТЬИ\"><b>6</b><i class=\"lb\">СТАТЬИ</i></span>");
    assert pk_has(OUT[0..], n, "<a class=\"lang\" lang=\"en\"");
    assert pk_count(OUT[0..], n, "<div class=\"hud\"") == 0;
    assert pk_count(OUT[0..], n, "<div class=\"links\"") == 0;
    assert pk_count(OUT[0..], n, ".app>.top{grid-area:1/1/2/5!important;display:flex;flex-direction:row;flex-wrap:nowrap;gap:0;") == 1;
    assert pk_count(OUT[0..], n, ".app::after{content:\"\";grid-area:1/1/4/5;border:1px solid var(--card-line);") == 1;
    assert pk_has(OUT[0..], n, "grid-template-rows:auto minmax(0,1fr) auto auto;gap:0;padding:6px;");
    assert pk_has(OUT[0..], n, ".x,#s-lessons{grid-area:2/1/3/2!important;");
    assert pk_has(OUT[0..], n, ".zr{grid-area:3/1/4/5!important;");
}

/// Y switching, one slot at a time (owner 2026-11-21): every Y slot has its own :target rule that lights only its own
/// tile, shows its own X strip and fills the display with a view. Y1 is the default state.
test every_y_slot_lights_only_itself_shows_its_x_strip_and_fills_the_display {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_has(OUT[0..], n, ".rail [href='#v-t27-basics'],#v-courses:target~.top .rail [href='#v-t27-basics']");
    assert pk_has(OUT[0..], n, ".vc:target~main #s-lessons");
    assert pk_has(OUT[0..], n, "#h-articles:target~.top .rail [href='#h-articles']");
    assert pk_has(OUT[0..], n, "#h-articles:target~main #s-articles");
    assert pk_has(OUT[0..], n, "#h-articles:target~main #w-blog");
    assert pk_has(OUT[0..], n, "#h-results:target~.top .rail [href='#h-results']");
    assert pk_has(OUT[0..], n, "#h-results:target~main #s-results");
    assert pk_has(OUT[0..], n, "#h-results:target~main #w-proof");
    assert pk_has(OUT[0..], n, "#h-about:target~.top .rail [href='#h-about']");
    assert pk_has(OUT[0..], n, "#h-about:target~main #s-about");
    assert pk_has(OUT[0..], n, "#h-about:target~main #w-trinity");
    assert pk_has(OUT[0..], n, "#v-queen:target~.top .rail [href='#v-queen']");
    assert pk_has(OUT[0..], n, "#v-queen:target~main #w-queen");
    var g : u32 = 0;
    while (g < N_QZ) {
        var m : u32 = raw(SRC_BUF[0..], 0, ".z");
        m = num(SRC_BUF[0..], m, g as u64);
        m = raw(SRC_BUF[0..], m, ":target~.top .rail ");
        m = lr_href_sel(SRC_BUF[0..], m, QZ_FIRST[g as usize]);
        assert pk_has(OUT[0..], n, SRC_BUF[0..m]);
        var s : u32 = raw(SRC_BUF[0..], 0, ".z");
        s = num(SRC_BUF[0..], s, g as u64);
        s = raw(SRC_BUF[0..], s, ":target~main #s-q");
        s = num(SRC_BUF[0..], s, g as u64);
        assert pk_has(OUT[0..], n, SRC_BUF[0..s]);
        var t : u32 = raw(SRC_BUF[0..], 0, "<section class=\"x\" id=\"s-q");
        t = num(SRC_BUF[0..], t, g as u64);
        assert pk_has(OUT[0..], n, SRC_BUF[0..t]);
        g = g + 1;
    }
    assert pk_count(OUT[0..], n, "<nav class=\"rail\"") == 1;
    assert pk_count(OUT[0..], n, ".st:target~.top .rail [href='#v-t27-basics']:not(:hover){background:none;color:var(--muted)}") == 1;
}

test the_hud_readouts_are_computed_from_the_arrays {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert SEGMENTS == 27;
    assert N_LESSONS * SEGMENTS == 324;
    assert pk_has(OUT[0..], n, "<span title=\"КУРСЫ\"><b>12</b><i class=\"lb\">КУРСЫ</i></span>");
    assert pk_has(OUT[0..], n, "<span title=\"УРОКИ\"><b>324</b><i class=\"lb\">УРОКИ</i></span>");
    assert pk_has(OUT[0..], n, "<span title=\"СТАТЬИ\"><b>6</b><i class=\"lb\">СТАТЬИ</i></span>");
    assert pk_has(OUT[0..], n, "СТАТУС: ДОСКА ОТКРЫТА · ВХОД БЕЗ РЕГИСТРАЦИИ");
    assert pk_has(OUT[0..], n, "<a class=\"ext\" href=\"https://github.com/Trinity-S-AI-DNA/trinity/blob/main/apps/website/specs/site/landing_ru.t27\" title=\"КОНЕЦ УРОВНЯ · specs/site/landing_ru.t27\" target=\"_blank\" rel=\"noopener\">");
}

test the_progress_cells_are_27_per_course {
    const n : u32 = page_landing_ru(OUT[0..]);
    assert pk_count(OUT[0..], n, "<i></i>") == N_LESSONS * SEGMENTS;
    assert pk_count(OUT[0..], n, "<div class=\"bar\"") == N_LESSONS;
    assert pk_count(OUT[0..], n, "<p class=\"pf\">0 / 27</p>") == N_LESSONS;
    assert pk_has(OUT[0..], n, "<span class=\"idx\">01</span>");
    assert pk_has(OUT[0..], n, "<span class=\"idx\">12</span>");
    assert pk_count(OUT[0..], n, "ВЫБРАТЬ</span>") == N_LESSONS;
    assert pk_has(OUT[0..], n, "ХАБ КУРСОВ · 12 КУРСОВ · 324 УРОКА · ВЫБЕРИ УРОВЕНЬ");
    assert pk_has(OUT[0..], n, ">Все курсы →</a>");
    assert pk_has(OUT[0..], n, "grid-template-columns:repeat(4,minmax(0,1fr))");
    assert pk_has(OUT[0..], n, "grid-template-columns:repeat(2,minmax(0,1fr))");
}

