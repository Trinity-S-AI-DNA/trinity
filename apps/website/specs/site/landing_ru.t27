pub const CSS_PANE : str = ".pane{display:none;flex:1;min-height:0;overflow:auto;padding:var(--s2)}.pane .pline{margin:0 0 var(--s2);max-width:60ch;font-size:17px;line-height:1.45}.pane .pp{margin:0 0 var(--s2);font-family:var(--mono);font-size:12px;color:var(--foot)}.pacts{display:flex;flex-wrap:wrap;gap:8px}.px{display:none}@media (max-width:719px){body{height:100dvh;overflow:hidden}.app{display:flex;flex-direction:column;gap:6px;box-sizing:border-box;height:100dvh;margin:0;padding:6px;border:1px solid var(--card-line)}.app>.top{order:1;flex:none;position:static;width:auto;max-width:none;margin:0}main.wrap{display:contents}.app .map{display:none}.app>.top{flex-wrap:nowrap;padding:6px 10px}.hero{order:2;flex:none;margin:0;padding:6px 10px;text-align:left}.hero>:not(h1){display:none}.hero h1{font-size:15px;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rail{order:3;flex:none;margin:0;padding:4px;border:1px solid var(--card-line)}.panel{order:4;flex:1;min-height:0;display:flex;flex-direction:column;border:1px solid var(--card-line)}.panel>section{display:none;flex:1;min-height:0;overflow:auto;padding:var(--s2);border-top:0;margin:0}.panel h2{font-size:22px;margin-bottom:var(--s1)}.panel .grid{grid-template-columns:minmax(0,1fr)}.pane .px{display:inline-flex}#lessons{order:5;flex:none;margin:0;padding:0}#lessons>h2,#lessons>.hubline,#lessons>.hubnote,#lessons .lvl,#lessons .all{display:none}#lessons .hub{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:minmax(140px,42vw);overflow-x:auto;scroll-snap-type:x mandatory;gap:6px}#lessons .tile{scroll-snap-align:start;padding:8px}#lessons .tile h3{font-size:13px;margin:0}#lessons .tile .bar,#lessons .tile .pf{display:none}.foot{order:6;flex:none;margin:0;padding:0;border:0;display:flex;justify-content:center;flex-wrap:wrap;gap:8px}.foot>p:not(.end){display:none}.foot .flinks{margin:0;font-size:12px}.foot .end{display:none}}label.tile{cursor:pointer;user-select:none}";

