// SPDX-License-Identifier: Apache-2.0
; specs/site/course_page.t27 -- the shared writer of the twelve course pages of t27.ai, https://t27.ai/ru/learn/<course>/
; (gHashTag/trinity issue Trinity-S-AI-DNA/trinity#1916). One spec per course (specs/site/learn_<course>.t27) holds
; that course's words and calls the blocks below, so the page is written from one place and no rule lives in twelve
; copies. The page has NO script: the 27 lessons are :target views inside one HUD frame.
; --
; THE FRAME. Y is the course (top bar: back to the course list, the title, the lead). X is the module (9 tiles, left on
; a wide screen, a strip on a phone). The panel holds the 27 lessons, one visible. Z is the lesson (the 3 lessons of the
; open module, bottom). A state is a marker <i class="st" id="yN-xM-zK"> (N course 1..12, M module 1..9, K lesson 1..3)
; and CSS sibling rules `#id:target ~ .app ...` show the view, the Z group and the lit tiles of that state. With no
; target, lesson 1 shows.
; --
; LANGUAGE. Like specs/site/landing_ru.t27 this module carries Cyrillic inside string literals only; identifiers,
; comments and the module line stay ASCII English. The words are the ui block of i18n/<course>.ru.json, the same for
; every course. The text of a lesson comes from i18n/<course>.ru.json, the widget link from LZ_HREFS of landing_ru.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY
module site_course_page;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const N_MODULES : u32 = 9;
pub const N_LESSONS : u32 = 27;
pub const ORIGIN : str = "https://t27.ai/ru/learn/";
pub const SOURCE_BASE : str = "https://github.com/Trinity-S-AI-DNA/trinity/blob/main/apps/website/specs/site/";
pub const BACK_LABEL : str = "Все курсы";
pub const BACK_HREF : str = "/ru/#lessons";
pub const WORD_MODULE : str = "Модуль ";
pub const WORD_LESSON : str = "Урок ";
pub const WORD_OF : str = " из ";
pub const WORD_GOAL : str = "Вы узнаете";
pub const WORD_TRY : str = "Попробуйте";
pub const WORD_PREV : str = "Назад";
pub const WORD_NEXT : str = "Дальше";
pub const WORD_WIDGET : str = "Открыть виджет урока";
pub const WORD_NAV_X : str = "Модули курса";
pub const WORD_NAV_Z : str = "Уроки модуля";
pub const WORD_SPEC : str = "Спека страницы";
pub const LIT_ON : str = "background:#f2f2f2;color:#000";
pub const LIT_OFF : str = "background:transparent;color:#f2f2f2";
pub const CSS_BASE : str = "*{box-sizing:border-box}html,body{margin:0;height:100%}body{background:#000;color:#f2f2f2;font:15.2px/1.55 Outfit,system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}.st{position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;pointer-events:none}.app{display:grid;height:100dvh;grid-template-columns:minmax(150px,240px) minmax(0,1fr);grid-template-rows:auto minmax(0,1fr) auto}.y{grid-column:1/3;display:flex;align-items:baseline;flex-wrap:wrap;gap:8px 24px;padding:12px 24px;border-bottom:4px solid #f2f2f2}.y .back{border:1px solid #555;padding:2px 12px;color:#a6a6a6}.y h1{margin:0;font-size:22px;font-weight:600}.y p{margin:0;color:#a6a6a6;flex:1 1 100%;max-width:70ch}.x{display:flex;flex-direction:column;overflow:auto;border-right:1px solid #333}.x a{padding:10px 16px;border-bottom:1px solid #333;color:#bbb}.panel{position:relative;overflow:auto;padding:24px}.panel>.view{display:none;max-width:72ch}.view h2{margin:0 0 4px;font-size:26px;font-weight:600}.view .lvl{margin:0 0 16px;color:#8a8a8a;font-size:12px;letter-spacing:.08em;text-transform:uppercase}.view h3{margin:20px 0 4px;color:#bbb;font-size:12px;letter-spacing:.08em;text-transform:uppercase}.view p{margin:0 0 8px}.view .open,.view .pn a{display:inline-block;margin:12px 12px 0 0;border:1px solid #555;padding:6px 14px}.z{grid-column:1/3;display:none;border-top:1px solid #333}.z a{flex:1 1 0;min-width:0;padding:10px 16px;border-right:1px solid #333;color:#bbb;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.foot{grid-column:1/3;padding:6px 24px;color:#8a8a8a;font-size:12px;border-top:1px solid #333}.foot a{text-decoration:underline}@media (max-width:719px){.app{grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto minmax(0,1fr) auto}.y,.z,.foot{grid-column:1}.x{flex-direction:row;border-right:0;border-bottom:1px solid #333}.x a{white-space:nowrap;border-bottom:0;border-right:1px solid #333}.panel{padding:16px}}";

; --- ids ---------------------------------------------------------------------------------------------

/// The marker id of lesson k (0..26) of course c (1..12): y{c}-x{module 1..9}-z{lesson in module 1..3}.
pub fn cp_id(o: []u8, n0: u32, c: u32, k: u32) -> u32 {
    const m : u32 = k / 3;
    const l : u32 = k - m * 3;
    var n : u32 = raw(o, n0, "y");
    n = num(o, n, c as u64);
    n = raw(o, n, "-x");
    n = num(o, n, (m + 1) as u64);
    n = raw(o, n, "-z");
    return num(o, n, (l + 1) as u64);
}

; --- style -------------------------------------------------------------------------------------------

/// The rules of lesson k: the target shows its view and its Z group and lights its X tile and its Z link; the
/// first lesson is the default and lets go when any marker is the target.
pub fn cp_css_k(o: []u8, n0: u32, c: u32, k: u32) -> u32 {
    const m : u32 = k / 3;
    var n : u32 = raw(o, n0, "#");
    n = cp_id(o, n, c, k);
    n = raw(o, n, ":target~.app .v");
    n = num(o, n, k as u64);
    n = raw(o, n, "{display:block}#");
    n = cp_id(o, n, c, k);
    n = raw(o, n, ":target~.app .g");
    n = num(o, n, m as u64);
    n = raw(o, n, "{display:flex}#");
    n = cp_id(o, n, c, k);
    n = raw(o, n, ":target~.app .xt");
    n = num(o, n, m as u64);
    n = raw(o, n, ",#");
    n = cp_id(o, n, c, k);
    n = raw(o, n, ":target~.app .zl");
    n = num(o, n, k as u64);
    n = raw(o, n, "{");
    n = raw(o, n, LIT_ON);
    return raw(o, n, "}");
}

/// The default state (lesson 1) and the reset any marker applies to it.
pub fn cp_css_default(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, ".v0{display:block}.g0{display:flex}.xt0,.zl0{");
    n = raw(o, n, LIT_ON);
    n = raw(o, n, "}.st:target~.app .v0{display:none}.st:target~.app .g0{display:none}.st:target~.app .xt0,.st:target~.app .zl0{");
    n = raw(o, n, LIT_OFF);
    return raw(o, n, "}");
}

pub fn cp_css(o: []u8, n0: u32, c: u32) -> u32 {
    var n : u32 = raw(o, n0, CSS_BASE);
    n = cp_css_default(o, n);
    var k : u32 = 0;
    while (k < N_LESSONS) {
        n = cp_css_k(o, n, c, k);
        k = k + 1;
    }
    return n;
}

; --- blocks ------------------------------------------------------------------------------------------

/// The head and the opening of the body; slug is the course id as it is in the address.
pub fn cp_head(o: []u8, n0: u32, c: u32, slug: str, title: str, desc: str) -> u32 {
    var n : u32 = raw(o, n0, "<!doctype html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>");
    n = text(o, n, title);
    n = raw(o, n, " · TRINITY S³AI</title>\n");
    n = pk_meta(o, n, "name", "description", desc);
    n = pk_meta(o, n, "name", "theme-color", "#000");
    n = raw(o, n, "<link rel=\"canonical\" href=\"");
    n = raw(o, n, ORIGIN);
    n = raw(o, n, slug);
    n = raw(o, n, "/\">\n<link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">\n");
    n = pk_meta(o, n, "property", "og:type", "website");
    n = pk_meta(o, n, "property", "og:locale", "ru_RU");
    n = pk_meta(o, n, "property", "og:title", title);
    n = pk_meta(o, n, "property", "og:description", desc);
    n = raw(o, n, "<style>");
    n = cp_css(o, n, c);
    return raw(o, n, "</style>\n</head>\n<body>\n");
}

/// The 27 state markers, before the frame so that the sibling rules reach it.
pub fn cp_markers(o: []u8, n0: u32, c: u32) -> u32 {
    var n : u32 = n0;
    var k : u32 = 0;
    while (k < N_LESSONS) {
        n = raw(o, n, "<i class=\"st\" id=\"");
        n = cp_id(o, n, c, k);
        n = raw(o, n, "\"></i>\n");
        k = k + 1;
    }
    return n;
}

/// The frame opens: the Y bar (back link, title, lead) and the start of the X strip.
pub fn cp_open(o: []u8, n0: u32, title: str, lead: str) -> u32 {
    var n : u32 = raw(o, n0, "<div class=\"app\">\n<header class=\"y\"><a class=\"back\" href=\"");
    n = raw(o, n, BACK_HREF);
    n = raw(o, n, "\">");
    n = text(o, n, BACK_LABEL);
    n = raw(o, n, "</a><h1>");
    n = text(o, n, title);
    n = raw(o, n, "</h1><p>");
    n = text(o, n, lead);
    n = raw(o, n, "</p></header>\n<nav class=\"x\" aria-label=\"");
    n = text(o, n, WORD_NAV_X);
    return raw(o, n, "\">\n");
}

/// One X tile: module m (0..8) opens its first lesson.
pub fn cp_x_tile(o: []u8, n0: u32, c: u32, m: u32, title: str) -> u32 {
    var n : u32 = raw(o, n0, "<a class=\"xt xt");
    n = num(o, n, m as u64);
    n = raw(o, n, "\" href=\"#");
    n = cp_id(o, n, c, m * 3);
    n = raw(o, n, "\">");
    n = num(o, n, (m + 1) as u64);
    n = raw(o, n, " · ");
    n = text(o, n, title);
    return raw(o, n, "</a>\n");
}

/// The X strip closes and the panel opens.
pub fn cp_panel_open(o: []u8, n0: u32) -> u32 {
    return raw(o, n0, "</nav>\n<main class=\"panel\">\n");
}

/// One lesson view k (0..26), the text of the lesson and its links to the lesson before and after.
pub fn cp_view(o: []u8, n0: u32, c: u32, k: u32, modt: str, modl: str, title: str, goal: str, task: str, body: str, href: str) -> u32 {
    var n : u32 = raw(o, n0, "<section class=\"view v");
    n = num(o, n, k as u64);
    n = raw(o, n, "\">\n<p class=\"lvl\">");
    n = text(o, n, WORD_MODULE);
    n = num(o, n, (k / 3 + 1) as u64);
    n = raw(o, n, " · ");
    n = text(o, n, WORD_LESSON);
    n = num(o, n, (k + 1) as u64);
    n = text(o, n, WORD_OF);
    n = num(o, n, N_LESSONS as u64);
    n = raw(o, n, "</p>\n<h2>");
    n = text(o, n, title);
    n = raw(o, n, "</h2>\n<p class=\"muted\">");
    n = text(o, n, modt);
    n = raw(o, n, ". ");
    n = text(o, n, modl);
    n = raw(o, n, "</p>\n<h3>");
    n = text(o, n, WORD_GOAL);
    n = raw(o, n, "</h3>\n<p>");
    n = text(o, n, goal);
    n = raw(o, n, "</p>\n<p>");
    n = text(o, n, body);
    n = raw(o, n, "</p>\n<h3>");
    n = text(o, n, WORD_TRY);
    n = raw(o, n, "</h3>\n<p>");
    n = text(o, n, task);
    n = raw(o, n, "</p>\n<a class=\"open\" href=\"");
    n = text(o, n, href);
    n = raw(o, n, "\">");
    n = text(o, n, WORD_WIDGET);
    n = raw(o, n, "</a>\n<p class=\"pn\">");
    if (k > 0) {
        n = raw(o, n, "<a href=\"#");
        n = cp_id(o, n, c, k - 1);
        n = raw(o, n, "\">");
        n = text(o, n, WORD_PREV);
        n = raw(o, n, "</a>");
    }
    if (k + 1 < N_LESSONS) {
        n = raw(o, n, "<a href=\"#");
        n = cp_id(o, n, c, k + 1);
        n = raw(o, n, "\">");
        n = text(o, n, WORD_NEXT);
        n = raw(o, n, "</a>");
    }
    return raw(o, n, "</p>\n</section>\n");
}


/// The panel closes.
pub fn cp_panel_close(o: []u8, n0: u32) -> u32 {
    return raw(o, n0, "</main>\n");
}

/// One Z link of lesson k; the first link of a module opens that module's group and the third closes it.
pub fn cp_z_link(o: []u8, n0: u32, c: u32, k: u32, title: str) -> u32 {
    const m : u32 = k / 3;
    const l : u32 = k - m * 3;
    var n : u32 = n0;
    if (l == 0) {
        n = raw(o, n, "<nav class=\"z g");
        n = num(o, n, m as u64);
        n = raw(o, n, "\" aria-label=\"");
        n = text(o, n, WORD_NAV_Z);
        n = raw(o, n, "\">");
    }
    n = raw(o, n, "<a class=\"zl zl");
    n = num(o, n, k as u64);
    n = raw(o, n, "\" href=\"#");
    n = cp_id(o, n, c, k);
    n = raw(o, n, "\">");
    n = num(o, n, (l + 1) as u64);
    n = raw(o, n, " · ");
    n = text(o, n, title);
    n = raw(o, n, "</a>");
    if (l == 2) {
        n = raw(o, n, "</nav>\n");
    }
    return n;
}

/// The footer: the source spec of the page; the frame and the document close.
pub fn cp_close(o: []u8, n0: u32, file: str) -> u32 {
    var n : u32 = raw(o, n0, "<footer class=\"foot\">");
    n = text(o, n, WORD_SPEC);
    n = raw(o, n, ": <a href=\"");
    n = raw(o, n, SOURCE_BASE);
    n = raw(o, n, file);
    n = raw(o, n, "\">specs/site/");
    n = text(o, n, file);
    return raw(o, n, "</a></footer>\n</div>\n</body>\n</html>\n");
}

/// The splicer follows only the names a module itself mentions (see html_out.t27). Never called.
pub fn cp_anchor(o: []u8) -> u32 {
    var n : u32 = put(o, 0, 0);
    n = put_escaped(o, n, 0);
    n = raw(o, n, "");
    n = text(o, n, "");
    n = attr(o, n, "", "");
    n = num(o, n, 0);
    n = fill(o, n, "", "", "", "", 0);
    return OVER + n + (H_SLASH + H_EQ + H_SPACE + H_APOS + H_QUOTE + H_AMP + H_GT + H_LT) as u32;
}

; --- tests --------------------------------------------------------------------------------------------

pub var CP_BUF : [65536]u8 = [0; 65536];

test the_marker_id_counts_course_module_and_lesson {
    const n : u32 = cp_id(CP_BUF[0..], 0, 3, 7);
    assert same_bytes(CP_BUF[0..], n, "y3-x3-z2");
    const a : u32 = cp_id(CP_BUF[0..], 0, 12, 0);
    assert same_bytes(CP_BUF[0..], a, "y12-x1-z1");
    const b : u32 = cp_id(CP_BUF[0..], 0, 1, 26);
    assert same_bytes(CP_BUF[0..], b, "y1-x9-z3");
}
test a_z_group_opens_on_the_first_lesson_of_a_module_and_closes_on_the_third {
    var n : u32 = cp_z_link(CP_BUF[0..], 0, 1, 3, "a");
    n = cp_z_link(CP_BUF[0..], n, 1, 4, "b");
    n = cp_z_link(CP_BUF[0..], n, 1, 5, "c");
    assert pk_count(CP_BUF[0..], n, "<nav class=\"z g1\"") == 1;
    assert pk_count(CP_BUF[0..], n, "</nav>") == 1;
    assert pk_count(CP_BUF[0..], n, "<a class=\"zl zl") == 3;
    assert pk_has(CP_BUF[0..], n, "href=\"#y1-x2-z3\"");
}
test the_first_lesson_has_no_back_link_and_the_last_has_no_next_link {
    const a : u32 = cp_view(CP_BUF[0..], 0, 1, 0, "m", "l", "t", "g", "k", "b", "/w");
    assert pk_has(CP_BUF[0..], a, "href=\"#y1-x1-z2\"");
    assert pk_count(CP_BUF[0..], a, "<a href=\"#") == 1;
    const z : u32 = cp_view(CP_BUF[0..], 0, 1, 26, "m", "l", "t", "g", "k", "b", "/w");
    assert pk_has(CP_BUF[0..], z, "href=\"#y1-x9-z2\"");
    assert pk_count(CP_BUF[0..], z, "<a href=\"#") == 1;
    const mid : u32 = cp_view(CP_BUF[0..], 0, 1, 10, "m", "l", "t", "g", "k", "b", "/w");
    assert pk_count(CP_BUF[0..], mid, "<a href=\"#") == 2;
}
test a_lesson_text_is_escaped {
    const n : u32 = cp_view(CP_BUF[0..], 0, 1, 4, "m", "l", "t", "g", "k", "a < b & c", "/w?a=1&b=2");
    assert pk_has(CP_BUF[0..], n, "a &lt; b &amp; c");
    assert pk_has(CP_BUF[0..], n, "href=\"/w?a=1&amp;b=2\"");
}
test each_state_rule_shows_the_view_and_lights_the_tiles {
    const n : u32 = cp_css_k(CP_BUF[0..], 0, 2, 13);
    assert pk_has(CP_BUF[0..], n, "#y2-x5-z2:target~.app .v13{display:block}");
    assert pk_has(CP_BUF[0..], n, ".g4{display:flex}");
    assert pk_has(CP_BUF[0..], n, ".xt4,");
    assert pk_has(CP_BUF[0..], n, ".zl13{");
}
