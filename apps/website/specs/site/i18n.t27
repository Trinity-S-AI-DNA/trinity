/// Russian value of key k.
pub fn i18n_ru(k: u32) -> str {
    return RU[k as usize];
}

/// English value of key k.
pub fn i18n_en(k: u32) -> str {
    return EN[k as usize];
}

/// True when s is not empty.
pub fn i18n_nonempty(s: []const u8) -> bool {
    return s.len > 0;
}

/// True when a and b are the same bytes.
pub fn i18n_same(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// How many keys equal key k (1 when k is unique).
pub fn i18n_key_count(k: u32) -> u32 {
    var c : u32 = 0;
    var j : u32 = 0;
    while (j < N_KEYS) {
        if (i18n_same(KEYS[j as usize], KEYS[k as usize])) { c = c + 1; }
        j = j + 1;
    }
    return c;
}

/// Number of rows whose ru and en values are both non-empty.
pub fn i18n_filled() -> u32 {
    var c : u32 = 0;
    var k : u32 = 0;
    while (k < N_KEYS) {
        if (i18n_nonempty(i18n_ru(k)) and i18n_nonempty(i18n_en(k)) and i18n_nonempty(KEYS[k as usize])) {
            c = c + 1;
        }
        k = k + 1;
    }
    return c;
}

/// Number of keys that appear exactly once.
pub fn i18n_unique() -> u32 {
    var c : u32 = 0;
    var k : u32 = 0;
    while (k < N_KEYS) {
        if (i18n_key_count(k) == 1) { c = c + 1; }
        k = k + 1;
    }
    return c;
}


/// The row of key, or N_KEYS when the key is not in the table.
pub fn i18n_index(key: []const u8) -> u32 {
    var k : u32 = 0;
    while (k < N_KEYS) {
        if (i18n_same(KEYS[k as usize], key)) { return k; }
        k = k + 1;
    }
    return N_KEYS;
}

/// The value of key in language lang (0 Russian, 1 English); the empty string for an unknown key.
pub fn i18n_get(lang: u32, key: []const u8) -> str {
    const k : u32 = i18n_index(key);
    if (k == N_KEYS) { return ""; }
    if (lang == L_EN) { return EN[k as usize]; }
    return RU[k as usize];
}

test every_key_has_a_ru_and_an_en_value {
    assert i18n_filled() == N_KEYS;
}

test no_key_repeats {
    assert i18n_unique() == N_KEYS;
}

test the_three_columns_have_the_same_length {
    assert KEYS.len == N_KEYS as usize;
    assert RU.len == N_KEYS as usize;
    assert EN.len == N_KEYS as usize;
}

test lookups_return_the_row_of_the_key {
    assert i18n_same(i18n_get(L_RU, "bar.label"), "Панель TRINITY");
    assert i18n_same(i18n_get(L_EN, "bar.label"), "TRINITY bar");
    assert i18n_same(i18n_get(L_EN, "motto.headline"), "Play, direct, earn");
}

test an_unknown_key_gives_the_empty_string {
    assert i18n_get(L_RU, "no.such.key").len == 0;
    assert i18n_index("no.such.key") == N_KEYS;
}

test the_two_languages_differ_on_the_language_switch {
    assert !i18n_same(i18n_get(L_RU, "lang.other"), i18n_get(L_EN, "lang.other"));
    assert !i18n_same(i18n_get(L_RU, "lang.href"), i18n_get(L_EN, "lang.href"));
}
