// SPDX-License-Identifier: Apache-2.0
; specs/site/i18n.t27 -- the chrome strings of the t27.ai landing page, one row per key, a Russian value
; and an English value side by side (gHashTag/trinity issue Trinity-S-AI-DNA/trinity#1918). Source of
; truth for the words the HUD frame prints around the content; the page spec landing_ru.t27 still holds
; its own copies until its strings move onto these keys (parked, see the issue).
; --
; LANGUAGE. By the owner's decision of 2026-11-19 the Russian column carries Cyrillic inside string
; literals only (the same exception as landing_ru.t27). Identifiers, comments and the module line stay
; ASCII English.
; --
; SHAPE. Three parallel arrays of the same length N_KEYS: KEYS, RU, EN. A key is looked up by position
; with i18n_ru(k) and i18n_en(k); a test pins that no value is empty and no key repeats.
; phi^2 + 1/phi^2 = 3 | TRINITY

module site_i18n;

pub const N_KEYS : u32 = 14;

pub const KEYS : [14]str = [
    "nav.label", "side.label", "chat.label", "chat.title", "chat.close", "bar.label", "lang.other",
    "sec.lessons", "sec.articles", "sec.results", "sec.about", "rail.map", "level.word", "queen.level"
];

pub const RU : [14]str = [
    "Разделы страницы", "Ссылки и показатели", "ЧАТ", "Чат с агентом", "ЗАКРЫТЬ", "Панель TRINITY", "EN",
    "Курсы", "Статьи", "Результаты", "О проекте", "Карта", "УРОВЕНЬ ", "КАРТА · КОРОЛЕВА"
];

pub const EN : [14]str = [
    "Page sections", "Links and figures", "CHAT", "Chat with the agent", "CLOSE", "TRINITY bar", "RU",
    "Courses", "Articles", "Results", "About", "Map", "LEVEL ", "MAP · QUEEN"
];

/// Russian value of key k.
pub fn i18n_ru(k: u32) -> str {
    return RU[k as usize];
}

/// English value of key k.
pub fn i18n_en(k: u32) -> str {
    return EN[k as usize];
}

/// True when s is not empty.
pub fn i18n_nonempty(s: []const u8) -> bool {
    return s.len > 0;
}

/// True when a and b are the same bytes.
pub fn i18n_same(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// How many keys equal key k (1 when k is unique).
pub fn i18n_key_count(k: u32) -> u32 {
    var c : u32 = 0;
    var j : u32 = 0;
    while (j < N_KEYS) {
        if (i18n_same(KEYS[j as usize], KEYS[k as usize])) { c = c + 1; }
        j = j + 1;
    }
    return c;
}

/// Number of rows whose ru and en values are both non-empty.
pub fn i18n_filled() -> u32 {
    var c : u32 = 0;
    var k : u32 = 0;
    while (k < N_KEYS) {
        if (i18n_nonempty(i18n_ru(k)) and i18n_nonempty(i18n_en(k)) and i18n_nonempty(KEYS[k as usize])) {
            c = c + 1;
        }
        k = k + 1;
    }
    return c;
}

/// Number of keys that appear exactly once.
pub fn i18n_unique() -> u32 {
    var c : u32 = 0;
    var k : u32 = 0;
    while (k < N_KEYS) {
        if (i18n_key_count(k) == 1) { c = c + 1; }
        k = k + 1;
    }
    return c;
}

test every_key_has_a_ru_and_an_en_value {
    assert i18n_filled() == N_KEYS;
}

test no_key_repeats {
    assert i18n_unique() == N_KEYS;
}

test the_three_columns_have_the_same_length {
    assert KEYS.len == N_KEYS as usize;
    assert RU.len == N_KEYS as usize;
    assert EN.len == N_KEYS as usize;
}

test lookups_return_the_row_of_the_key {
    assert i18n_same(i18n_ru(5), "Панель TRINITY");
    assert i18n_same(i18n_en(5), "TRINITY bar");
    assert i18n_same(KEYS[5], "bar.label");
}

test the_two_languages_differ_on_the_language_switch {
    assert !i18n_same(i18n_ru(6), i18n_en(6));
}
