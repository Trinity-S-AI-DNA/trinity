/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_learn_verify_hardware(o: []u8) -> u32 {
    var n : u32 = cp_head(o, 0, COURSE_NO, SLUG, C_TITLE, C_DESCRIPTION);
    n = cp_markers(o, n, COURSE_NO);
    n = cp_open(o, n, C_TITLE, C_LEAD);
    var m : u32 = 0;
    while (m < 9) {
        n = cp_x_tile(o, n, COURSE_NO, m, MOD_TITLES[m as usize]);
        m = m + 1;
    }
    n = cp_panel_open(o, n);
    var k : u32 = 0;
    while (k < 27) {
        m = k / 3;
        n = cp_view(o, n, COURSE_NO, k, MOD_TITLES[m as usize], MOD_LINES[m as usize], LZ_TITLE[k as usize], LZ_GOAL[k as usize], LZ_TASK[k as usize], LZ_TEXT[k as usize], LZ_HREF[k as usize]);
        k = k + 1;
    }
    n = cp_panel_close(o, n);
    k = 0;
    while (k < 27) {
        n = cp_z_link(o, n, COURSE_NO, k, LZ_TITLE[k as usize]);
        k = k + 1;
    }
    return cp_close(o, n, FILE);
}

/// The splicer follows only the names a module itself mentions (see html_out.t27). Never called.
pub fn learn_anchor(o: []u8) -> u32 {
    if (pk_has(o, 0, "") and ok(0)) { return 1; }
    return OVER + pk_count(o, 0, "");
}

; --- tests --------------------------------------------------------------------------------------------

test the_page_is_written_and_fits_the_buffer {
    const n : u32 = page_learn_verify_hardware(OUT[0..]);
    assert ok(n);
    assert n > 0;
    assert n < OUT_CAP;
}
test the_page_has_one_h1_and_no_script {
    const n : u32 = page_learn_verify_hardware(OUT[0..]);
    assert pk_count(OUT[0..], n, "<h1>") == 1;
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_has(OUT[0..], n, "<html lang=\"ru\">");
}
test the_frame_has_27_states_9_modules_and_27_lessons {
    const n : u32 = page_learn_verify_hardware(OUT[0..]);
    assert pk_count(OUT[0..], n, "<i class=\"st\" id=\"y5-x") == 27;
    assert pk_has(OUT[0..], n, "id=\"y5-x1-z1\"");
    assert pk_has(OUT[0..], n, "id=\"y5-x9-z3\"");
    assert pk_count(OUT[0..], n, "<a class=\"xt xt") == 9;
    assert pk_count(OUT[0..], n, "<section class=\"view v") == 27;
    assert pk_count(OUT[0..], n, "<nav class=\"z g") == 9;
    assert pk_count(OUT[0..], n, "<a class=\"zl zl") == 27;
}
test each_lesson_links_its_widget_and_the_course_list {
    const n : u32 = page_learn_verify_hardware(OUT[0..]);
    assert pk_count(OUT[0..], n, "<a class=\"open\" href=\"") == 27;
    assert pk_has(OUT[0..], n, "href=\"/ru/#lessons\"");
    assert pk_has(OUT[0..], n, "</html>");
}
test the_states_have_rules_and_the_first_lesson_is_the_default {
    const n : u32 = page_learn_verify_hardware(OUT[0..]);
    assert pk_has(OUT[0..], n, ".v0{display:block}");
    assert pk_has(OUT[0..], n, "#y5-x9-z3:target~.app .v26{display:block}");
    assert pk_has(OUT[0..], n, "#y5-x2-z1:target~.app .g1{display:flex}");
}
