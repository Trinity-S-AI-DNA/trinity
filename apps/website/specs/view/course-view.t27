// SPDX-License-Identifier: Apache-2.0
; specs/view/course-view.t27 -- how a course is laid out on t27.ai: the reading width, when the
; lesson text and its widget sit side by side, the table of contents, how many widget frames are
; live at once and how far ahead they load, the finger targets and the focus ring; and the words
; of the whole-course-on-one-page view. Contrast is measured on the rendered pages, not held here.
; Source of truth for apps/website/scripts/course-view-from-spec.mjs (gHashTag/trinity), which
; compiles this file with the vendored compiler, evaluates the tests below, holds the Russian
; bundle (i18n/course-view.ru.json) to every SAY_ key with the same digits and {placeholders},
; holds the course-deck widget's K_ numbers and Course.css's @media widths to these numbers,
; and writes src/lib/courseView.generated.ts and src/styles/courseView.generated.css.
; scripts/course-pages.mjs reads the same numbers for the static one-page view, and
; public/widgets/frame-pool.js is told them by its callers; nothing restates them.
; --
; Owner, 2026-10-19: "make the page with the course's topic fit on one page, so it spreads in the
; network at once; all the text fits; and make this page a widget that holds the other widgets;
; think how to improve the course UI/UX ergonomically, visually". And, 2026-10-07: every number,
; threshold and order on a screen is a spec first.
; --
; THE ONE PAGE. Each course has a static page at <share path><ONE_PAGE_DIR>/ (t27.ai/learn/all/
; for the first course, t27.ai/learn/<course>/all/ for the others; ru/ before it in Russian):
; the course, then every module, then every lesson's title, goal, text, task and widget. It is a
; real page with its own card, never a #/ route, because a crawler drops what follows '#'.
; WIDGET FRAMES ARE A BUDGET. 27 live iframes would sink a phone. A frame mounts only when its
; slot comes within MOUNT_MARGIN_PX of the viewport, at most LIVE_FRAMES_MAX are live at once
; (the one farthest from the viewport gives way), and a live frame further than
; UNMOUNT_MARGIN_PX away is taken down. Its slot keeps the frame's height all along, so nothing
; below it moves when a frame comes or goes. SETTLE_MS after the last scroll event the pool
; looks again, so a frame that gave way while it was still near comes back once it is among the
; nearest; a wheel turn of many events is one look, not many.
; THE COLUMNS. A line of lesson text holds about READ_CHARS characters (65 to 75 is the readable
; band). The em width that holds them is measured, not guessed: CHAR_EM_X1000_EN and _RU are the
; average character widths of the lesson text as Chromium sets it (2026-10-19, 18 px, Outfit for
; English and the system face Russian falls back to, over the lessons of three courses: 0.427 to
; 0.432 em in English, 0.531 to 0.532 em in Russian), and READ_EM_X10_EN and _RU are the column
; widths the tests hold inside the band. A ch is the width of a zero, 0.66 em in Outfit, which
; would have made a "68ch" column 95 characters wide. From
; SIDE_BY_SIDE_MIN_PX up, a lesson's text and its widget sit side by side; below it they stack
; and the widget comes right after the task, the question it answers. From TOC_SIDEBAR_MIN_PX up
; the contents stand in a column beside the lessons; below it they fold into a sticky bar.
; The wider column (Russian) is the one the breakpoint tests leave the widget WIDGET_MIN_PX beside.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module course_view;

pub const KIND : str = "course-view";
pub const SCHEMA_VERSION : u8 = 1;
pub const GENERATED : [2]str = ["src/lib/courseView.generated.ts", "src/styles/courseView.generated.css"];
pub const ONE_PAGE_DIR : str = "all";
pub const DECK_WIDGET : str = "course-deck";

; --- Reading ---------------------------------------------------------------------------------
pub const READ_CHARS : u8 = 70;
pub const READ_CHARS_MIN : u8 = 65;
pub const READ_CHARS_MAX : u8 = 75;
pub const TEXT_PX : u8 = 18;
pub const CHAR_EM_X1000_EN : u16 = 430;
pub const CHAR_EM_X1000_RU : u16 = 532;
pub const READ_EM_X10_EN : u16 = 301;
pub const READ_EM_X10_RU : u16 = 372;

; --- Columns and breakpoints -----------------------------------------------------------------
pub const NARROW_MAX_PX : u16 = 600;
pub const SIDE_BY_SIDE_MIN_PX : u16 = 1150;
pub const TOC_SIDEBAR_MIN_PX : u16 = 1440;
pub const PAGE_MAX_PX : u16 = 1440;
pub const TOC_WIDTH_PX : u16 = 240;
pub const WIDGET_MIN_PX : u16 = 400;
pub const COLUMN_GAP_PX : u8 = 32;
pub const GUTTER_WIDE_PX : u8 = 20;
pub const GUTTER_PHONE_PX : u8 = 16;

; --- Widget frames ---------------------------------------------------------------------------
pub const LIVE_FRAMES_MAX : u8 = 3;
pub const MOUNT_MARGIN_PX : u16 = 600;
pub const UNMOUNT_MARGIN_PX : u16 = 2000;
pub const FRAME_MIN_PX : u16 = 320;
pub const FRAME_MAX_PX : u16 = 900;

; --- Fingers, focus, motion, settling ---------------------------------------------------------
pub const TOUCH_TARGET_PX : u8 = 44;
pub const THUMB_BAR_PX : u8 = 56;
pub const FOCUS_RING_PX : u8 = 2;
pub const FOCUS_OFFSET_PX : u8 = 2;
pub const SETTLE_MS : u16 = 120;
pub const MOTION_WHEN_REDUCED : bool = false;

; --- The words of the one-page view (Russian in i18n/course-view.ru.json) ---------------------
pub const SAY_ONE_PAGE : str = "Whole course on one page";
pub const SAY_ONE_PAGE_LINE : str = "All 27 lessons and their widgets on one page: one link to share, one page to read.";
pub const SAY_ONE_PAGE_TITLE : str = "{0}: the whole course on one page";
pub const SAY_CONTENTS : str = "Contents";
pub const SAY_SHARE_PAGE : str = "Share the course";
pub const SAY_SHARE_LESSON : str = "Share this lesson";
pub const SAY_COPY : str = "Copy link";
pub const SAY_COPIED : str = "Link copied";
pub const SAY_LESSON_LINK : str = "Link to this lesson on this page";
pub const SAY_LOAD : str = "Load the widget";
pub const SAY_WAITING : str = "The widget loads as you scroll to it.";
pub const SAY_TOP : str = "Back to the top";
pub const SAY_JUMP : str = "Jump to a lesson";

; A column holds READ_CHARS_MIN to READ_CHARS_MAX average characters, in both languages.
test the_text_column_is_readable {
    assert READ_CHARS >= READ_CHARS_MIN;
    assert READ_CHARS <= READ_CHARS_MAX;
    assert READ_CHARS_MIN == 65;
    assert READ_CHARS_MAX == 75;
    assert READ_EM_X10_EN * 100 >= READ_CHARS_MIN * CHAR_EM_X1000_EN;
    assert READ_EM_X10_EN * 100 <= READ_CHARS_MAX * CHAR_EM_X1000_EN;
    assert READ_EM_X10_RU * 100 >= READ_CHARS_MIN * CHAR_EM_X1000_RU;
    assert READ_EM_X10_RU * 100 <= READ_CHARS_MAX * CHAR_EM_X1000_RU;
}

; The breakpoint is where two gutters, the gap, the text column and the widget's minimum fit.
test side_by_side_leaves_the_widget_its_minimum {
    assert READ_EM_X10_RU >= READ_EM_X10_EN;
    assert SIDE_BY_SIDE_MIN_PX * 10 >= (2 * GUTTER_WIDE_PX + COLUMN_GAP_PX + WIDGET_MIN_PX) * 10 + TEXT_PX * READ_EM_X10_RU;
    assert SIDE_BY_SIDE_MIN_PX > NARROW_MAX_PX;
}

test the_contents_column_only_where_the_lesson_still_fits_beside_it {
    assert TOC_SIDEBAR_MIN_PX * 10 >= (2 * GUTTER_WIDE_PX + TOC_WIDTH_PX + 2 * COLUMN_GAP_PX + WIDGET_MIN_PX) * 10 + TEXT_PX * READ_EM_X10_RU;
    assert TOC_SIDEBAR_MIN_PX > SIDE_BY_SIDE_MIN_PX;
    assert PAGE_MAX_PX >= TOC_SIDEBAR_MIN_PX;
}

; Load ahead of the reader, take down far behind: a frame that comes back on a short scroll
; is not torn down and rebuilt on every wheel turn.
test frames_load_ahead_and_leave_far_behind {
    assert UNMOUNT_MARGIN_PX > MOUNT_MARGIN_PX;
    assert UNMOUNT_MARGIN_PX >= 2 * MOUNT_MARGIN_PX;
    assert MOUNT_MARGIN_PX >= FRAME_MIN_PX;
}

; Room for the frame being read and the next one, and no more than a phone can keep.
test a_phone_keeps_only_a_few_frames_live {
    assert LIVE_FRAMES_MAX >= 2;
    assert LIVE_FRAMES_MAX <= 4;
    assert FRAME_MIN_PX < FRAME_MAX_PX;
}

test every_target_is_a_finger_wide {
    assert TOUCH_TARGET_PX >= 44;
    assert THUMB_BAR_PX >= TOUCH_TARGET_PX;
    assert GUTTER_PHONE_PX == 16;
}

test focus_shows_and_motion_yields {
    assert FOCUS_RING_PX >= 2;
    assert FOCUS_OFFSET_PX >= 1;
    assert MOTION_WHEN_REDUCED == false;
}

; A look after the scroll stops: soon enough that a returning frame is back before the reader is
; there (a frame mounts MOUNT_MARGIN_PX ahead), and late enough that one wheel turn is one look.
test the_pool_looks_again_once_the_scroll_stops {
    assert SETTLE_MS > 0;
    assert SETTLE_MS <= 200;
}
