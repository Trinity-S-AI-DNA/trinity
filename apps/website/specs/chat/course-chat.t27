module chat_course_chat;

; The course helper chat (Trinity-S-AI-DNA/trinity#1813): a chat panel beside the
; lessons of a course, where a reader types a question and gets an answer from an
; assistant that knows which course and lesson is open.
; This module is the whole rule. The page (src/components/CourseChat.tsx) and the
; answer route on the render host both read these numbers and call these fns; neither
; keeps a copy. The module is self-contained on purpose (no `use`), so `t27c gen-ts`
; turns it into src/lib/courseChat.gen.ts without resolving other specs.
; Wire shape. One POST to CHAT_ROUTE on the render host, JSON both ways.
;   request : {"course": "vibecoding", "lesson": "<lesson id>", "title": "<lesson title>",
;              "message": "<what the reader typed>", "turn": <questions already asked>,
;              "lessonText": "<first CHAT_BODY_MAX bytes of lesson body, optional>",
;              "key": "<course key, optional>"}
;   probe   : {"course": "vibecoding", "probe": true}, sent when the panel opens; the route
;             answers {"ok": true, "probe": true} with no model call (probe_reason)
;   answer  : NDJSON stream: {"delta": "<token>"}\n lines then {"ok": true}\n (or
;             {"ok": false, "offline": true, "reason": "<name>"} on error)
; The route runs gate_reason() before any model call and never falls back to a paid model
; (fallback_allowed): a free provider that is down gives an offline answer, nothing else.
; The reason names are the ones reason_name() returns. A page that cannot reach the
; route builds the same offline state itself, from client_reason().
; Honesty. The panel shows generated text only when the reason is REASON_NONE
; (show_answer). Every offline reason shows one fixed sentence from this module and
; nothing the model said. The model runs on the server, on the free tier only; the
; key lives in a server env file and is never in this module, in the bundle, in git,
; in a chat or in a log.
; Scope. The chat is on for the courses in CHAT_COURSES only. Another course turns it
; on by adding its id there. No history is stored, no account is made, and the helper
; has no tools (the system prompt says so).

pub const CHAT_ROUTE : str = "/api/course/chat";

pub const CHAT_COURSES : [1]str = ["vibecoding"];

pub const CHAT_MSG_MAX : u32 = 600;
pub const CHAT_TITLE_MAX : u32 = 120;
pub const CHAT_ANSWER_MAX : u32 = 1200;
pub const CHAT_PER_IP_HOUR : u32 = 20;
pub const CHAT_PER_KEY_DAY : u32 = 60;
pub const CHAT_TIMEOUT_MS : u32 = 20000;
pub const CHAT_GLOBAL_DAY : u32 = 500;
pub const CHAT_TURNS_MAX : u32 = 8;
pub const CHAT_PROBE_RETRY_MS : u32 = 30000;
pub const CHAT_PAID_FALLBACK : u32 = 0;

pub const REASON_NONE : u32 = 0;
pub const REASON_UNREACHABLE : u32 = 1;
pub const REASON_TIMEOUT : u32 = 2;
pub const REASON_STATUS : u32 = 3;
pub const REASON_EMPTY : u32 = 4;
pub const REASON_LIMIT : u32 = 5;
pub const REASON_OFF : u32 = 6;
pub const REASON_BAD_REQUEST : u32 = 7;
pub const REASON_BUSY : u32 = 8;

pub const CHAT_TITLE : str = "Course helper";
pub const CHAT_HINT : str = "Ask about this lesson. Nothing you type is stored.";
pub const CHAT_PLACEHOLDER : str = "Ask a question";
pub const CHAT_SEND : str = "Send";
pub const CHAT_OPEN : str = "Ask the helper";
pub const CHAT_CLOSE : str = "Close";
pub const CHAT_WORKING : str = "The helper is thinking.";
pub const CHAT_OFFLINE : str = "The assistant is offline.";
pub const CHAT_OFFLINE_LIMIT : str = "The assistant is offline for now: the question limit is reached. Try again later.";
pub const CHAT_OFFLINE_BAD : str = "The assistant is offline: this question cannot be sent. Shorten it and try again.";
pub const CHAT_OFFLINE_BUSY : str = "The assistant is busy right now. Try again in a moment.";

; The reader's message is never dropped (trinity#1824). Send and Return put the reader's line in the
; log and clear the box in every state; send_plan says what happens next. While the helper is offline
; the line is followed by one plain sentence (CHAT_UNANSWERED), and while it is still answering the
; last question by CHAT_WAIT_NOTE. Each new string has a Russian form, the one the page shows on a
; Russian page; the same digits in both (there are none yet).
pub const CHAT_UNANSWERED : str = "The helper is offline, so your message was not answered. Try again later.";
pub const CHAT_UNANSWERED_RU : str = "Помощник сейчас не в сети, поэтому ваше сообщение осталось без ответа. Попробуйте позже.";
pub const CHAT_WAIT_NOTE : str = "The helper is still answering your last question, so this message was not sent. Ask again in a moment.";
pub const CHAT_WAIT_NOTE_RU : str = "Помощник ещё отвечает на прошлый вопрос, поэтому это сообщение не отправлено. Спросите ещё раз чуть позже.";

pub const ACT_IGNORE : u32 = 0;
pub const ACT_SEND : u32 = 1;
pub const ACT_REPROBE : u32 = 2;
pub const ACT_WAIT : u32 = 3;
pub const ACT_LIMIT : u32 = 4;

; The system prompt, in up to four parts. system_prompt() joins them around the course id,
; the lesson title, and (when non-empty) the lesson body; the route on the render host does
; the same with these constants. CHAT_BODY_MAX is how many bytes of lesson body are injected.
pub const CHAT_PROMPT_HEAD : str = "You are the course helper on t27.ai for the course \"";
pub const CHAT_PROMPT_LESSON : str = "\", open at the lesson \"";
pub const CHAT_PROMPT_BODY : str = "\". Lesson text: \"";
pub const CHAT_PROMPT_TAIL : str = "\". Answer the reader's question about this course and lesson in at most five short sentences, in the language the reader writes in. If you do not know, say \"I do not know\" and do not guess or invent facts. Never ask for or repeat a key, a token or a password. You have no tools: you cannot run code, open links or remember earlier chats.";
pub const CHAT_BODY_MAX : u32 = 1500;

; The panel's style, black and white like the rest of the course page (no colour, no glow).
; A column beside the lesson from CHAT_WIDE_MIN px; below that a button opens a sheet.
pub const CHAT_WIDE_MIN : u32 = 1000;

; The docked column keeps the lesson readable (trinity#1825): the lesson column is what is
; left of CHAT_WIDE_MIN after the left gutter and the room kept for the panel, and it must stay
; at least CHAT_COLUMN_MIN px wide (1000 - 20 - 360 = 620 at the narrowest docked width).
pub const CHAT_GUTTER : u32 = 20;
pub const CHAT_DOCK_PAD : u32 = 360;
pub const CHAT_COLUMN_MIN : u32 = 600;

; The opener below CHAT_WIDE_MIN (trinity#1820): a round button that carries the owner's GitHub
; avatar. The image is a copy kept in public/ under CHAT_AVATAR (the 256 px variant of the
; account's avatar, so the 67 px circle stays sharp on a 3x screen), so the page never asks
; GitHub for it. CHAT_AVATAR_PX is the circle's side: the owner asked for 20 percent more than
; the first 56 px, 56 x 12 / 10 = 67. CHAT_TAP_MIN is the smallest tap target allowed.
; The button keeps its name CHAT_OPEN as an aria-label; the image has an empty alt.
; The same avatar sits in the chat's head (CHAT_HEAD_AVATAR_PX px), and opening is one motion:
; the sheet grows out of the opener's circle while the opener leaves and the head avatar arrives.
pub const CHAT_AVATAR : str = "ghashtag-avatar.jpg";
pub const CHAT_AVATAR_PX : u32 = 67;
pub const CHAT_HEAD_AVATAR_PX : u32 = 36;
pub const CHAT_TAP_MIN : u32 = 44;

; A sheet on a tablet is a card, not a wall: at most CHAT_SHEET_MAX px wide, flush right.
pub const CHAT_SHEET_MAX : u32 = 520;
pub const CHAT_TABLET_MIN : u32 = 600;
pub const CHAT_LANDSCAPE_MAX_H : u32 = 480;

pub const CHAT_CSS : str = ".course-main:has(.cc){padding-right:360px}.cc{position:fixed;top:84px;right:20px;bottom:20px;width:320px;display:flex;flex-direction:column;background:#000;color:#f2f2f2;border:1px solid #fff;z-index:30;font-family:var(--font)}.cc-head{display:flex;align-items:center;gap:10px;padding:10px 12px;border-bottom:1px solid #fff}.cc-av{display:block;flex:none;width:36px;height:36px;border-radius:50%;object-fit:cover;border:1px solid #fff}.cc-title{flex:1;font-size:11px;letter-spacing:.16em;text-transform:uppercase;margin:0}.cc-x{display:none;background:none;border:0;color:#f2f2f2;font:inherit;cursor:pointer}.cc-hint{font-size:12px;color:#8a8a8a;margin:0;padding:8px 12px 0}.cc-log{flex:1;overflow:auto;padding:12px;display:flex;flex-direction:column;gap:8px;font-size:14px;line-height:1.45}.cc-m{margin:0;padding:8px 10px;border:1px solid #333;white-space:pre-wrap;overflow-wrap:anywhere}.cc-you{border-color:#fff;align-self:flex-end}.cc-off{color:#8a8a8a;border-style:dashed}.cc-form{display:flex;gap:8px;padding:12px;border-top:1px solid #fff}.cc-in{flex:1;min-width:0;min-height:44px;max-height:120px;resize:none;background:#000;color:#f2f2f2;border:1px solid #fff;padding:8px;font:inherit;font-size:16px}.cc-go{background:#fff;color:#000;border:0;padding:0 14px;min-width:44px;min-height:44px;font:inherit;font-weight:700;cursor:pointer}.cc-go:disabled{background:#8a8a8a;cursor:default}.cc-open{display:none}";
