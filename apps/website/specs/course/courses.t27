// SPDX-License-Identifier: Apache-2.0
; specs/course/courses.t27 -- the t27 courses, in the order a reader takes them
; Source of truth for apps/website/scripts/course-from-spec.mjs (gHashTag/trinity), which
; compiles this file with the vendored compiler (public/t27/t27_compiler.wasm), evaluates the
; test blocks below, then reads every course named here (specs/course/<id>.t27 and its Russian
; contract specs/course/<id>-ru.t27) and holds each one to the shape this file declares.
; ASCII only (L3), English only (LANG-EN).

; WHAT A COURSE IS: 27 lessons in 9 modules of 3, the size of a TRI-27 word (owner's
; decision 2026-10-07: 9 modules of 3 lessons, not 27 modules of one). Every lesson
; opens one working widget and one t27 spec the reader can run in the player. Each course has
; its own address in the app (#/<route>) and its own share pages (learn/ for the first,
; learn/<id>/ for the next), so each can be shared on its own; the last lesson of one course
; hands the reader to lesson 1 of the next.

; WHAT THE ORDER IS: course 0 (t27 basics) comes first, because it teaches the language every
; later lesson spec is written in. The FPGA course follows, and the AI numbers course uses the
; phi^2 + 1/phi^2 = 3 | TRINITY

module courses;

pub const KIND : str = "courses";
pub const SCHEMA_VERSION : u8 = 1;
; The generator writes every course into the first file; each course spec names its own copy.
; The second is the course addresses alone: the router, the starfield and the menu import it,
; so a course named here has an address in the app without loading the courses. On
; 2026-10-10 the router listed 4 of the 7 by hand and "Next course" after GoldenFloat opened
; nothing (#/verify-hardware had no route).
pub const GENERATED : [2]str = ["src/lib/course.generated.ts", "src/lib/courseRoutes.generated.ts"];

pub const COURSE_COUNT : u8 = 7;

pub const COURSE_IDS : [7]str = ["t27-basics", "course", "ai-numbers", "goldenfloat", "verify-hardware", "clocks-and-cdc", "buses-and-peripherals"];
pub const COURSE_SPECS : [7]str = ["specs/course/t27-basics.t27", "specs/course/course.t27", "specs/course/ai-numbers.t27", "specs/course/goldenfloat.t27", "specs/course/verify-hardware.t27", "specs/course/clocks-and-cdc.t27", "specs/course/buses-and-peripherals.t27"];

pub const LESSONS_PER_COURSE : u8 = 27;
pub const MODULES_PER_COURSE : u8 = 9;
pub const LESSONS_PER_MODULE : u8 = 3;

; One key for every course: progress stays in the reader's browser.
pub const PROGRESS_KEY : str = "t27-course-done";
; Share pages live under this directory of t27.ai.
pub const SHARE_BASE : str = "learn";

test every_course_is_three_cubed {
    assert LESSONS_PER_MODULE == 3;
    assert MODULES_PER_COURSE == 9;
    assert MODULES_PER_COURSE * LESSONS_PER_MODULE == LESSONS_PER_COURSE;
    assert LESSONS_PER_COURSE == 3 * 3 * 3;
}

test the_basics_come_first {
    assert COURSE_COUNT == 7;
    assert COURSE_IDS[0] == "t27-basics";
    assert COURSE_SPECS[0] == "specs/course/t27-basics.t27";
    assert COURSE_IDS[1] == "course";
    assert COURSE_SPECS[1] == "specs/course/course.t27";
    assert COURSE_IDS[2] == "ai-numbers";
    assert COURSE_SPECS[2] == "specs/course/ai-numbers.t27";
}
