; specs/blog/course_bench_board.t27 -- the blog post "The FPGA course names its bench board"
; (Trinity-S-AI-DNA/trinity#1804, pull request 1806): the English body and the Russian ruBody of the post
; that ships with the course text change. pub fn body_ts fills a buffer with the whole TypeScript module;
; t27c gen-text --fn body_ts writes the bytes, unchanged, to
; src/data/blog/bodies/the-course-names-its-bench-board.ts. Nobody types that body. The post is registered
; by hand in src/data/blog/index.ts and posts.ts, as every post is.
; The board numbers are not decided here: they are constants of t27 specs/boards/ax7203.t27, and the t27
; entry specs/blog/course_bench_board.t27 imports them and fails its tests if they differ; the still is drawn
; by t27 specs/blog/course_bench_board_still.t27. This spec carries the published words in two languages.
; Texts hold no double quote and no backslash, so a text lands in a TS string as it stands; the figure's svg
; uses single quotes. The Russian text is UTF-8 inside str consts, as in static_widgets.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module blog_course_bench_board;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const SLUG : str = "the-course-names-its-bench-board";
pub const K_BLOCKS : u32 = 9;
pub const K_LANGUAGES : u32 = 2;

pub const HEAD : str = "import type { Block } from '../types'\n\n// Written by t27c gen-text --fn body_ts from apps/website/specs/blog/course_bench_board.t27, never by hand (Trinity-S-AI-DNA/trinity#1804).\n\n";

pub const EN_P1 : str = "Two lessons of the FPGA course pointed at a board that is not on our bench. Lesson 3 gave the chip on our board 676 solder balls, and the task of lesson 1 called the board file of a Wukong the spec of our bench board. The board on the bench is an ALINX AX7203, with the AMD Artix-7 XC7A200T in the 484-ball FBG484 package; a camera read ALINX off the board and its bitstream answered over the UART (t27 fpga/HARDWARE_SSOT.md, 2026-10-08). The 676 balls belong to the FGG676 package of the Wukong board.";
pub const EN_H1 : str = "What changed";
pub const EN_P2 : str = "Lesson 1, An FPGA is a grid you configure, now says: our bench chip is an AMD Artix-7 XC7A200T on an ALINX AX7203 board, in the 484-ball FBG484 package. Its task now says that the spec frame is the board file of a Wukong, which carries the same die, and that LUT_TOTAL there holds the AMD logic cell count, 1.6 per LUT6, not a LUT count.";
pub const EN_P3 : str = "Lesson 3, Pins, balls and the package, now says that on our AX7203 board the XC7A200T is in the 484-ball FBG484, and that the pin map draws the same die in the 676-ball FGG676 package of the Wukong board. The widget did not change; the text now says which package it draws.";
pub const EN_P4 : str = "The course lead now lists the two X accounts: x.com/t27_dev and x.com/t27_lang.";
pub const EN_SVG : str = "<svg xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' viewBox='0 0 642 210' role='img' aria-label='Bench board ALINX AX7203, package FBG484, 484 balls; the pin map draws FGG676, 676 balls, the package of the Wukong board'><image href='/t27f/stills/the-course-names-its-bench-board.png' xlink:href='/t27f/stills/the-course-names-its-bench-board.png' width='642' height='210'/></svg>";
pub const EN_CAPTION : str = "The bench board and the package the pin map draws: a T27F still that t27b draws natively from t27 specs/blog/course_bench_board_still.t27, with the numbers of specs/boards/ax7203.t27.";
pub const EN_H2 : str = "Where the numbers come from";
pub const EN_P5 : str = "The board name, the package and the ball count are constants of t27 specs/boards/ax7203.t27. The t27 entry of this post, specs/blog/course_bench_board.t27, imports them and fails its tests if they differ. The same board spec keeps two counts apart that the course once mixed: 134,600 LUT6 and 215,360 logic cells, the AMD figure of 1.6 per LUT6.";
pub const EN_P6 : str = "Not claimed: that the course is now free of other drift. The drift rules in t27 specs/tri/course/audit.t27 check the triggers they list and nothing else. The still was checked by decoding the PNG, not by looking at it in a browser. The change is in Trinity-S-AI-DNA/trinity#1806.";
pub const RU_P1 : str = "Два урока курса по FPGA указывали на плату, которой нет на нашем стенде. Урок 3 давал чипу на нашей плате 676 шариков припоя, а задание урока 1 называло файл платы Wukong спекой платы нашего стенда. На стенде стоит ALINX AX7203 с AMD Artix-7 XC7A200T в корпусе FBG484 на 484 шарика; камера прочитала надпись ALINX на плате, а её битстрим ответил по UART (t27 fpga/HARDWARE_SSOT.md, 2026-10-08). 676 шариков относятся к корпусу FGG676 платы Wukong.";
pub const RU_H1 : str = "Что изменилось";
pub const RU_P2 : str = "Урок 1, FPGA - это сетка, которую вы настраиваете, теперь говорит: чип нашего стенда - AMD Artix-7 XC7A200T на плате ALINX AX7203, в корпусе FBG484 на 484 шарика. Его задание теперь говорит, что спека-рамка - это файл платы Wukong с тем же кристаллом и что LUT_TOTAL там хранит число логических ячеек AMD, по 1,6 на LUT6, а не число LUT.";
pub const RU_P3 : str = "Урок 3, Выводы, шарики и корпус, теперь говорит, что на нашей плате AX7203 XC7A200T стоит в корпусе FBG484 на 484 шарика, а карта выводов рисует тот же кристалл в корпусе FGG676 на 676 шариков платы Wukong. Виджет не изменился; текст теперь говорит, какой корпус он рисует.";
pub const RU_P4 : str = "В шапке курса теперь указаны два аккаунта в X: x.com/t27_dev и x.com/t27_lang.";
pub const RU_SVG : str = "<svg xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' viewBox='0 0 642 210' role='img' aria-label='Плата на стенде ALINX AX7203, корпус FBG484, 484 шарика; карта выводов рисует FGG676, 676 шариков, корпус платы Wukong'><image href='/t27f/stills/the-course-names-its-bench-board.png' xlink:href='/t27f/stills/the-course-names-its-bench-board.png' width='642' height='210'/></svg>";
pub const RU_CAPTION : str = "Плата на стенде и корпус, который рисует карта выводов: кадр T27F, который t27b рисует нативно из t27 specs/blog/course_bench_board_still.t27, с числами из specs/boards/ax7203.t27. Надписи на кадре английские.";
pub const RU_H2 : str = "Откуда числа";
pub const RU_P5 : str = "Название платы, корпус и число шариков - константы t27 specs/boards/ax7203.t27. Запись этого поста в t27, specs/blog/course_bench_board.t27, импортирует их, и её тесты падают, если они расходятся. Та же спека платы держит раздельно два числа, которые курс когда-то смешивал: 134 600 LUT6 и 215 360 логических ячеек, по оценке AMD 1,6 на LUT6.";
pub const RU_P6 : str = "Не утверждается: что в курсе не осталось других расхождений. Правила в t27 specs/tri/course/audit.t27 проверяют перечисленные в них триггеры и ничего больше. Кадр проверен декодированием PNG, а не просмотром в браузере. Изменение - в Trinity-S-AI-DNA/trinity#1806.";

pub var OUT : [32768]u8 = [0; 32768];

/// One block with a single text: tag is p, h or quote.
pub fn bp_text(o: []u8, n0: u32, tag: []const u8, s: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "  {\n    \"kind\": \"");
    n = raw(o, n, tag);
    n = raw(o, n, "\",\n    \"text\": \"");
    n = raw(o, n, s);
    return raw(o, n, "\"\n  },\n");
}

/// One figure block: the svg and its caption.
pub fn bp_figure(o: []u8, n0: u32, svg: []const u8, cap: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "  {\n    \"kind\": \"figure\",\n    \"svg\": \"");
    n = raw(o, n, svg);
    n = raw(o, n, "\",\n    \"caption\": \"");
    n = raw(o, n, cap);
    return raw(o, n, "\"\n  },\n");
}

/// The nine blocks of the English body.
pub fn bp_english(o: []u8, n0: u32) -> u32 {
    var n : u32 = bp_text(o, n0, "p", EN_P1);
    n = bp_text(o, n, "h", EN_H1);
    n = bp_text(o, n, "p", EN_P2);
    n = bp_text(o, n, "p", EN_P3);
    n = bp_text(o, n, "p", EN_P4);
    n = bp_figure(o, n, EN_SVG, EN_CAPTION);
    n = bp_text(o, n, "h", EN_H2);
    n = bp_text(o, n, "p", EN_P5);
    return bp_text(o, n, "p", EN_P6);
}

/// The nine blocks of the Russian body.
pub fn bp_russian(o: []u8, n0: u32) -> u32 {
    var n : u32 = bp_text(o, n0, "p", RU_P1);
    n = bp_text(o, n, "h", RU_H1);
    n = bp_text(o, n, "p", RU_P2);
    n = bp_text(o, n, "p", RU_P3);
    n = bp_text(o, n, "p", RU_P4);
    n = bp_figure(o, n, RU_SVG, RU_CAPTION);
    n = bp_text(o, n, "h", RU_H2);
    n = bp_text(o, n, "p", RU_P5);
    return bp_text(o, n, "p", RU_P6);
}

/// The whole body module of the post: header, body, ruBody. The workflow calls exactly this name.
pub fn body_ts(out: []u8) -> u32 {
    var n : u32 = raw(out, 0, HEAD);
    n = raw(out, n, "export const body: Block[] = [\n");
    n = bp_english(out, n);
    n = raw(out, n, "]\n\nexport const ruBody: Block[] = [\n");
    n = bp_russian(out, n);
    return raw(out, n, "]\n");
}

test each_language_has_nine_blocks {
    assert K_BLOCKS == 9;
    assert K_LANGUAGES == 2;
}

test the_module_has_a_body_and_a_ru_body {
    const n : u32 = body_ts(OUT[0..]);
    assert ok(n);
    assert pk_has(OUT[0..], n, "import type { Block } from '../types'");
    assert pk_count(OUT[0..], n, "export const body: Block[] = [") == 1;
    assert pk_count(OUT[0..], n, "export const ruBody: Block[] = [") == 1;
}

test both_bodies_have_the_same_blocks_and_one_figure_each {
    const n : u32 = body_ts(OUT[0..]);
    assert pk_count(OUT[0..], n, "\"kind\": \"") == 18;
    assert pk_count(OUT[0..], n, "\"kind\": \"p\"") == 12;
    assert pk_count(OUT[0..], n, "\"kind\": \"h\"") == 4;
    assert pk_count(OUT[0..], n, "\"kind\": \"figure\"") == 2;
    assert pk_count(OUT[0..], n, "\"kind\": \"ul\"") == 0;
}

test the_texts_carry_the_board_numbers_in_both_languages {
    const n : u32 = body_ts(OUT[0..]);
    assert pk_has(OUT[0..], n, "484-ball FBG484");
    assert pk_has(OUT[0..], n, "676-ball FGG676");
    assert pk_has(OUT[0..], n, "FBG484 на 484 шарика");
    assert pk_has(OUT[0..], n, "FGG676 на 676 шариков");
    assert pk_has(OUT[0..], n, "134,600 LUT6 and 215,360 logic cells");
    assert pk_has(OUT[0..], n, "134 600 LUT6 и 215 360 логических ячеек");
    assert pk_count(OUT[0..], n, "Trinity-S-AI-DNA/trinity#1806") == 2;
    assert pk_count(OUT[0..], n, "x.com/t27_dev and x.com/t27_lang") == 1;
    assert pk_count(OUT[0..], n, "x.com/t27_dev и x.com/t27_lang") == 1;
}

test the_figure_is_the_still_with_single_quotes_and_no_script {
    const n : u32 = body_ts(OUT[0..]);
    assert pk_count(OUT[0..], n, "viewBox='0 0 642 210'") == 2;
    assert pk_count(OUT[0..], n, "/t27f/stills/the-course-names-its-bench-board.png'") == 4;
    assert pk_count(OUT[0..], n, "</svg>") == 2;
    assert pk_count(OUT[0..], n, "<script") == 0;
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert body_ts(tiny[0..]) == OVER;
}
