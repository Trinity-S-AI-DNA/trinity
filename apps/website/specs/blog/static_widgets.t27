; specs/blog/static_widgets.t27 -- the blog post "Twenty-seven widgets with no script, written by specs"
; (FR-106, Trinity-S-AI-DNA/trinity#1807): the English body and the Russian ruBody of the post that ships
; with course 12, "Vibecoding from zero". The post is data, and this spec writes it: pub fn body_ts fills a
; buffer with the whole TypeScript module, and .github/workflows/emit-widget-pages.yml runs t27c gen-text --fn
; on it and puts the bytes, unchanged, in src/data/blog/bodies/twenty-seven-widgets-with-no-script-written-by-specs.ts.
; Nobody types that body. The post is registered by hand in src/data/blog/index.ts and posts.ts, two lines of
; existing files, as every post is.
; Texts hold no double quote and no backslash, so a text lands in a TS string as it stands; the figure's svg
; uses single quotes. Every number comes from the pull request that ships the course: 27 pages in
; specs/widgets/views/view_pages.t27, the loop page of vc-the-loop.t27 (92 sections, 55132 bytes, measured
; on Actions). The Russian text is UTF-8 inside str consts, as in specs/course_recipe/fragments/*-ru.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module blog_static_widgets;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const SLUG : str = "twenty-seven-widgets-with-no-script-written-by-specs";
pub const K_BLOCKS : u32 = 9;
pub const K_LANGUAGES : u32 = 2;

pub const HEAD : str = "import type { Block } from '../types'\n\n// Written by t27c gen-text --fn body_ts from apps/website/specs/blog/static_widgets.t27, never by hand (FR-106, Trinity-S-AI-DNA/trinity#1807).\n\n";

pub const EN_P1 : str = "Course 12 of t27.ai, Vibecoding from zero, has 27 widgets, and none of them runs a script. Each widget is one HTML page. Every state of the widget is one section of that page, every click is a link to a fragment such as #plant, and a CSS rule, :target, shows the one section the address names. The browser does the switching, so there is no JavaScript to load, to break or to review.";
pub const EN_H1 : str = "A page is written by a spec";
pub const EN_P2 : str = "No page is typed by hand. Each widget has a t27 spec in apps/website/specs/widgets/views/ with a function such as page_vc_the_loop that fills a buffer with the whole page, through a small writer, html_out, and a shared frame, page_kit. On Actions, t27c gen-text --fn compiles the spec, runs that function and writes its bytes, unchanged, to apps/website/public/widgets/vc-the-loop/index.html. A workflow fails when a committed page differs from the emitted one by a single byte.";
pub const EN_P3 : str = "Of the 27 pages, 18 are infographics: a table and a flow, two sections with a tab link between them. The other 9 have state: the four phases, the loop, the message loop, planting a bug, reading a diff, secrets out, unstuck, the test judge and the spec-to-bot table. Each of those is written out as a finite-state machine with a cap on its states. The loop widget is the largest: 92 sections, 55,132 bytes of plain HTML.";
pub const EN_SVG : str = "<svg viewBox='0 0 720 100' xmlns='http://www.w3.org/2000/svg' role='img' aria-label='27 static widget pages: 18 infographics and 9 with state' style='width:100%;height:auto;font-family:inherit'><text x='182' y='38' fill='currentColor' fill-opacity='0.8' font-size='13' text-anchor='end'>Infographics</text><rect x='190' y='22' width='432' height='22' rx='4' fill='currentColor' fill-opacity='0.35'/><text x='630' y='38' fill='currentColor' font-size='13'>18</text><text x='182' y='78' fill='currentColor' fill-opacity='0.8' font-size='13' text-anchor='end'>With state</text><rect x='190' y='62' width='216' height='22' rx='4' fill='#e0a800'/><text x='414' y='78' fill='currentColor' font-size='13'>9</text></svg>";
pub const EN_CAPTION : str = "The 27 static widget pages of course 12: 18 infographics and 9 with state, counted from view_pages.t27 in the pull request that ships them.";
pub const EN_H2 : str = "What a page cannot do";
pub const EN_A1 : str = "It cannot read what you type: every state is written out in advance, so each page with state has a cap on its states and stops there.";
pub const EN_A2 : str = "It sends nothing: the widgets collect and transmit nothing, and the tests of every view check that its page has no script and no form.";
pub const EN_A3 : str = "Its size grows with its states: the loop page is 55,132 bytes for 92 sections, which is why the pages with state carry a cap.";
pub const EN_H3 : str = "Try it";
pub const EN_B1 : str = "Course: t27.ai/#/vibecoding";
pub const EN_B2 : str = "Pages: t27.ai/widgets/vc-the-loop/ and t27.ai/widgets/vc-key-pair/";
pub const EN_B3 : str = "Specs: apps/website/specs/widgets/views/ in Trinity-S-AI-DNA/trinity, pull request 1808";

pub const RU_P1 : str = "В курсе 12 на t27.ai, Вайбкодинг с нуля, 27 виджетов, и ни один из них не запускает скрипт. Каждый виджет - одна HTML-страница. Каждое состояние виджета - одна секция этой страницы, каждый клик - ссылка на фрагмент вроде #plant, а CSS-правило :target показывает ту единственную секцию, которую называет адрес. Переключает браузер, поэтому нет JavaScript, который надо загружать, который может сломаться и который надо ревьюить.";
pub const RU_H1 : str = "Страницу пишет спека";
pub const RU_P2 : str = "Ни одна страница не набрана руками. У каждого виджета есть t27-спека в apps/website/specs/widgets/views/ с функцией вроде page_vc_the_loop: она заполняет буфер всей страницей через маленький writer html_out и общую раму page_kit. На Actions t27c gen-text --fn компилирует спеку, запускает эту функцию и пишет её байты без изменений в apps/website/public/widgets/vc-the-loop/index.html. Workflow падает, если закоммиченная страница отличается от выпущенной хотя бы на один байт.";
pub const RU_P3 : str = "Из 27 страниц 18 - инфографики: таблица и схема шагов, две секции со ссылкой-вкладкой между ними. Остальные 9 имеют состояние: четыре фазы, цикл, цикл сообщений, подбросить баг, прочитать дифф, секреты наружу, застрял, судья тестов и таблица spec-to-bot. Каждая из них выписана как конечный автомат с потолком числа состояний. Самый большой виджет - цикл: 92 секции, 55 132 байта обычного HTML.";
pub const RU_SVG : str = "<svg viewBox='0 0 720 100' xmlns='http://www.w3.org/2000/svg' role='img' aria-label='27 статических страниц виджетов: 18 инфографик и 9 с состоянием' style='width:100%;height:auto;font-family:inherit'><text x='182' y='38' fill='currentColor' fill-opacity='0.8' font-size='13' text-anchor='end'>Инфографики</text><rect x='190' y='22' width='432' height='22' rx='4' fill='currentColor' fill-opacity='0.35'/><text x='630' y='38' fill='currentColor' font-size='13'>18</text><text x='182' y='78' fill='currentColor' fill-opacity='0.8' font-size='13' text-anchor='end'>С состоянием</text><rect x='190' y='62' width='216' height='22' rx='4' fill='#e0a800'/><text x='414' y='78' fill='currentColor' font-size='13'>9</text></svg>";
pub const RU_CAPTION : str = "27 статических страниц виджетов курса 12: 18 инфографик и 9 с состоянием, посчитано по view_pages.t27 в пулл-реквесте, который их выпускает.";
pub const RU_H2 : str = "Чего страница не умеет";
pub const RU_A1 : str = "Она не читает, что вы печатаете: каждое состояние выписано заранее, поэтому у каждой страницы с состоянием есть потолок числа состояний, и на нём она останавливается.";
pub const RU_A2 : str = "Она ничего не отправляет: виджеты ничего не собирают и не передают, а тесты каждого вида проверяют, что в его странице нет ни скрипта, ни формы.";
pub const RU_A3 : str = "Её размер растёт вместе с состояниями: страница цикла - 55 132 байта на 92 секции, поэтому у страниц с состоянием есть потолок.";
pub const RU_H3 : str = "Попробуйте";
pub const RU_B1 : str = "Курс: t27.ai/#/vibecoding";
pub const RU_B2 : str = "Страницы: t27.ai/widgets/vc-the-loop/ и t27.ai/widgets/vc-key-pair/";
pub const RU_B3 : str = "Спеки: apps/website/specs/widgets/views/ в Trinity-S-AI-DNA/trinity, пулл-реквест 1808";

pub var OUT : [32768]u8 = [0; 32768];

/// One block with a single text: tag is p, h or quote.
pub fn bp_text(o: []u8, n0: u32, tag: []const u8, s: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "  {\n    \"kind\": \"");
    n = raw(o, n, tag);
    n = raw(o, n, "\",\n    \"text\": \"");
    n = raw(o, n, s);
    return raw(o, n, "\"\n  },\n");
}

/// One figure block: the svg and its caption.
pub fn bp_figure(o: []u8, n0: u32, svg: []const u8, cap: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "  {\n    \"kind\": \"figure\",\n    \"svg\": \"");
    n = raw(o, n, svg);
    n = raw(o, n, "\",\n    \"caption\": \"");
    n = raw(o, n, cap);
    return raw(o, n, "\"\n  },\n");
}

/// One list block of three items.
pub fn bp_list3(o: []u8, n0: u32, a: []const u8, b: []const u8, c: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "  {\n    \"kind\": \"ul\",\n    \"items\": [\n      \"");
    n = raw(o, n, a);
    n = raw(o, n, "\",\n      \"");
    n = raw(o, n, b);
    n = raw(o, n, "\",\n      \"");
    n = raw(o, n, c);
    return raw(o, n, "\"\n    ]\n  },\n");
}

/// The nine blocks of the English body.
pub fn bp_english(o: []u8, n0: u32) -> u32 {
    var n : u32 = bp_text(o, n0, "p", EN_P1);
    n = bp_text(o, n, "h", EN_H1);
    n = bp_text(o, n, "p", EN_P2);
    n = bp_text(o, n, "p", EN_P3);
    n = bp_figure(o, n, EN_SVG, EN_CAPTION);
    n = bp_text(o, n, "h", EN_H2);
    n = bp_list3(o, n, EN_A1, EN_A2, EN_A3);
    n = bp_text(o, n, "h", EN_H3);
    return bp_list3(o, n, EN_B1, EN_B2, EN_B3);
}

/// The nine blocks of the Russian body.
pub fn bp_russian(o: []u8, n0: u32) -> u32 {
    var n : u32 = bp_text(o, n0, "p", RU_P1);
    n = bp_text(o, n, "h", RU_H1);
    n = bp_text(o, n, "p", RU_P2);
    n = bp_text(o, n, "p", RU_P3);
    n = bp_figure(o, n, RU_SVG, RU_CAPTION);
    n = bp_text(o, n, "h", RU_H2);
    n = bp_list3(o, n, RU_A1, RU_A2, RU_A3);
    n = bp_text(o, n, "h", RU_H3);
    return bp_list3(o, n, RU_B1, RU_B2, RU_B3);
}

/// The whole body module of the post: header, body, ruBody. The workflow calls exactly this name.
pub fn body_ts(out: []u8) -> u32 {
    var n : u32 = raw(out, 0, HEAD);
    n = raw(out, n, "export const body: Block[] = [\n");
    n = bp_english(out, n);
    n = raw(out, n, "]\n\nexport const ruBody: Block[] = [\n");
    n = bp_russian(out, n);
    return raw(out, n, "]\n");
}

test each_language_has_nine_blocks {
    assert K_BLOCKS == 9;
    assert K_LANGUAGES == 2;
}

test the_module_has_a_body_and_a_ru_body {
    const n : u32 = body_ts(OUT[0..]);
    assert ok(n);
    assert pk_has(OUT[0..], n, "import type { Block } from '../types'");
    assert pk_count(OUT[0..], n, "export const body: Block[] = [") == 1;
    assert pk_count(OUT[0..], n, "export const ruBody: Block[] = [") == 1;
}

test both_bodies_have_the_same_blocks_and_one_figure_each {
    const n : u32 = body_ts(OUT[0..]);
    assert pk_count(OUT[0..], n, "\"kind\": ") == 18;
    assert pk_count(OUT[0..], n, "\"kind\": \"p\"") == 6;
    assert pk_count(OUT[0..], n, "\"kind\": \"h\"") == 6;
    assert pk_count(OUT[0..], n, "\"kind\": \"ul\"") == 4;
    assert pk_count(OUT[0..], n, "\"kind\": \"figure\"") == 2;
}

test the_texts_carry_the_numbers_of_the_pull_request {
    const n : u32 = body_ts(OUT[0..]);
    assert pk_count(OUT[0..], n, "#plant") == 2;
    assert pk_has(OUT[0..], n, "92 sections, 55,132 bytes");
    assert pk_has(OUT[0..], n, "92 секции, 55 132 байта");
    assert pk_count(OUT[0..], n, "27 widgets") == 1;
    assert pk_count(OUT[0..], n, "27 виджетов") == 1;
}

test the_figure_is_one_svg_with_single_quotes_and_no_script {
    const n : u32 = body_ts(OUT[0..]);
    assert pk_count(OUT[0..], n, "<svg viewBox='0 0 720 100'") == 2;
    assert pk_count(OUT[0..], n, "</svg>") == 2;
    assert pk_count(OUT[0..], n, "<script") == 0;
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert body_ts(tiny[0..]) == OVER;
}
