// SPDX-License-Identifier: Apache-2.0
; specs/widgets/round-sat.t27 -- rounding and overflow: truncate, round half up, convergent; wrap or saturate
; Source of truth for public/widgets/round-sat/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/round-sat/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/fixed_point.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 8 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader picks a small Qm.n, a rounding mode and what happens on overflow, and drags a
; value: the transfer curve shows every input against what the word stores (a staircase inside the range,
; a sawtooth or a flat line outside it). Bars give the mean error each rounding mode leaves on a ramp when
; d bits are dropped: only convergent rounding has none.

; WHAT IT DOES NOT CLAIM: the bias is measured on a uniform ramp; a signal that is not uniform over the dropped bits can see a different mean.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_round_sat;

pub const KIND : str = "widget-tool";
pub const ID : str = "round-sat";
pub const TITLE : str = "Rounding and saturation: the error you choose, and its bias";
pub const DESCRIPTION : str = "Drag a value into a small Qm.n and switch between truncation, rounding and convergent rounding, and between wrap and saturate. The bars show which rounding is biased.";
pub const IMAGE_ALT : str = "Rounding card: 1.25 into Q3.1. Truncation and round-half-up step through the range as staircases; outside it, wrap jumps to the far end while saturation stays flat. The bias bars read -0.25, +0.25 and 0 LSB for one dropped bit.";
pub const HOOK : str = "Truncation is biased by -1/2 LSB and round-half-up by a little up; only convergent rounding averages to zero. Wrap turns +1.0 into -1.0.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/dsp/fixed_point.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "ARM CMSIS-DSP and the Q notation of DSP texts: Qm.n with m integer bits counting the sign (Q1.15 is a 16-bit word)", "IEEE 754-2019, section 4.3.1: roundTiesToEven, the convergent rounding of this page"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_MAX_INT_BITS : u8 = 6;
pub const K_MAX_FRAC_BITS : u8 = 6;
pub const K_X_SPAN : u8 = 40;
pub const K_X_STEP_DIV : u16 = 100;
pub const K_MAX_DROP : u8 = 8;
pub const K_PLOT_MARGIN_PCT : u16 = 160;
pub const K_CURVE_POINTS : u16 = 600;
pub const K_MODE_TRUNC : u8 = 0;
pub const K_MODE_ROUND : u8 = 1;
pub const K_MODE_CONVERGENT : u8 = 2;
pub const K_PRESET_M : [4]u8 = [3, 3, 3, 2];
pub const K_PRESET_N : [4]u8 = [1, 1, 2, 2];
pub const K_PRESET_MODE : [4]u8 = [2, 1, 0, 1];
pub const K_PRESET_SAT : [4]u8 = [1, 1, 0, 1];
pub const K_PRESET_X_CENTI : [4]u16 = [125, 125, 525, 525];
pub const K_PRESET_X_NEG : [4]u8 = [0, 0, 0, 0];
pub const K_PRESET_DROP : [4]u8 = [1, 1, 4, 4];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["1.25 in Q3.1, convergent", "1.25 in Q3.1, half up", "5.25 in Q3.2: wrap", "5.25 in Q2.2: saturate"];
pub const SAY_M : str = "Integer bits m (with the sign)";
pub const SAY_N : str = "Fraction bits n";
pub const SAY_MODE : str = "Rounding";
pub const SAY_MODES : [3]str = ["truncate", "round half up", "convergent"];
pub const SAY_OVERFLOW : str = "On overflow";
pub const SAY_OVERFLOWS : [2]str = ["wrap", "saturate"];
pub const SAY_X : str = "Input";
pub const SAY_DROP : str = "Bits dropped, for the bias";
pub const SAY_CURVE_LABEL : str = "Every input against the value the word stores, with the range shaded";
pub const SAY_BIAS_LABEL : str = "Mean error of each rounding mode on a ramp";
pub const SAY_IN : str = "input";
pub const SAY_OUT : str = "stored";
pub const SAY_BIAS_AXIS : str = "mean error, output LSBs, {0} bits dropped";
pub const SAY_BIAS_NOTE : str = "Drop d bits from every value of a ramp and average the error. Ties are what separate the modes.";
pub const SAY_STORED : str = "stored in Q{0}.{1}";
pub const SAY_ERROR : str = "error";
pub const SAY_STATE : str = "range";
pub const SAY_SATURATED : str = "saturated";
pub const SAY_WRAPPED : str = "wrapped";
pub const SAY_IN_RANGE : str = "in range";
pub const SAY_WORST : str = "worst error";
pub const SAY_LSB : str = "{0} LSB";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/fixed_point.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_modes_are_the_spec_modes {
    assert K_MODE_TRUNC == 0;
    assert K_MODE_ROUND == 1;
    assert K_MODE_CONVERGENT == 2;
    assert K_PRESET_MODE[0] == K_MODE_CONVERGENT;
}

test the_wrap_preset_overflows_its_format {
    assert K_PRESET_X_CENTI[2] > 400;
    assert K_PRESET_M[2] == 3;
    assert K_PRESET_SAT[2] == 0;
    assert K_PRESET_SAT[3] == 1;
}
