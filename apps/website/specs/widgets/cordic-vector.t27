// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cordic-vector.t27 -- CORDIC vectoring mode: the angle and the length of a vector
; Source of truth for public/widgets/cordic-vector/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/cordic-vector/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/cordic.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 11 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader drags a point anywhere on the plane (or sets x and y) and a number of steps.
; Vectoring mode turns the vector down onto the x axis, each step by atan(2^-i), collecting the angle as it
; goes; the x it ends at, scaled by K(n), is the length. A vector in the left half-plane is first turned by
; 90 degrees. Tiles compare angle and length with a 50-step run and the exact magnitude.

; WHAT IT DOES NOT CLAIM: the steps run in f64; the 90-degree pre-turn is one common way to cover the left half-plane, not the only one.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cordic_vector;

pub const KIND : str = "widget-tool";
pub const ID : str = "cordic-vector";
pub const TITLE : str = "CORDIC vectoring: angle and length without a divide";
pub const DESCRIPTION : str = "Drag a point and watch CORDIC turn its vector down onto the x axis, step by step, reading off atan2 and the magnitude with shifts and adds.";
pub const IMAGE_ALT : str = "CORDIC vectoring card: the vector (3, 4) turned onto the x axis in coloured steps, ending within 0.001 degree of 53.1301 degrees and at a length of 5.000000 after 16 steps.";
pub const HOOK : str = "(3, 4) in 16 shift-and-add steps: angle 53.13 degrees, length 5.000000. atan2 and a square root with no divider and no multiplier.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/dsp/cordic.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "J. E. Volder, The CORDIC trigonometric computing technique, IRE Trans. Electronic Computers EC-8(3), 1959", "J. S. Walther, A unified algorithm for elementary functions, AFIPS Spring Joint Computer Conference, 1971"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_SPAN : u8 = 10;
pub const K_STEP_DIV : u8 = 10;
pub const K_MAX_SHOWN_STEPS : u8 = 24;
pub const K_X_OUT : u8 = 0;
pub const K_Y_OUT : u8 = 1;
pub const K_REF_STEPS : u8 = 50;
pub const K_PRESET_X_TENTHS : [4]u8 = [30, 10, 50, 80];
pub const K_PRESET_X_NEG : [4]u8 = [0, 1, 1, 0];
pub const K_PRESET_Y_TENTHS : [4]u8 = [40, 10, 20, 1];
pub const K_PRESET_Y_NEG : [4]u8 = [0, 0, 1, 1];
pub const K_PRESET_STEPS : [4]u8 = [16, 16, 12, 8];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["(3, 4)", "(-1, 1): left half", "(-5, -2)", "(8, -0.1), 8 steps"];
pub const SAY_X : str = "x";
pub const SAY_Y : str = "y";
pub const SAY_STEPS : str = "Steps";
pub const SAY_DEG_VALUE : str = "{0} deg";
pub const SAY_DRAG : str = "Drag on the plane to move the white point.";
pub const SAY_PLANE_LABEL : str = "The vector and its path down to the x axis, one coloured step at a time";
pub const SAY_ANGLE_IS : str = "angle {0} deg";
pub const SAY_MAG_IS : str = "length {0}";
pub const SAY_GROWS : str = "the vector grows by 1/K(n) = {0} on the way";
pub const SAY_ANGLE_ERR : str = "angle error";
pub const SAY_MAG_ERR : str = "length error";
pub const SAY_K : str = "gain K(n)";
pub const SAY_Y_LEFT : str = "y left";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/cordic.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_plane_is_ten_each_way {
    assert K_SPAN == 10;
    assert K_STEP_DIV == 10;
    assert K_PRESET_X_TENTHS[0] == 30;
    assert K_PRESET_Y_TENTHS[0] == 40;
}

test the_presets_visit_three_quadrants {
    assert K_PRESET_X_NEG[1] == 1;
    assert K_PRESET_Y_NEG[2] == 1;
    assert K_PRESET_X_NEG[2] == 1;
    assert K_REF_STEPS > K_MAX_SHOWN_STEPS;
}
