// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-route.t27 -- Wires and clock trees: wire class, congestion and buffers
; Source of truth for public/widgets/cmp-route/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-route/logic.js -- the fn
; bodies of gHashTag/t27 specs/compiler/hir_cost_models.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 12 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader sets a fanout, a net count and a die area, and a number of clock sinks. The widget asks
; est_wire_length, est_congestion, est_buffers_needed and est_tree_levels and lights the class or level each answer names.

; WHAT IT DOES NOT CLAIM:  it routes nothing. These are the compiler's static estimates before placement, and a die with no area
; reports no congestion rather than an infinite one. The wire lengths are held equal to the spec's constants.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_route;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-route";
pub const TITLE : str = "Wires and clock trees: wire class, congestion and buffers";
pub const DESCRIPTION : str = "The last three estimates are about wire. Set a net's fanout, the nets and die area, and the sinks of a clock, and read the wire class, the congestion and the clock buffers the compiler counts.";
pub const IMAGE_ALT : str = "Route card: a net with fanout 8 gets the medium wire class, 2000 micrometres. 5000 nets on a 4 square millimetre die give a congestion of 1250 nets per square millimetre. A clock with 100 sinks needs 7 buffers and 2 tree levels.";
pub const HOOK : str = "A net of five sinks is a medium wire, one of seventeen a long wire. A clock buffer serves sixteen sinks, and the tree grows a level per factor of sixteen.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/compiler/hir_cost_models.t27 (t27 master 90e797659): every number is est_wire_length, est_congestion, est_buffers_needed or est_tree_levels, fn bodies compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 12 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 3;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_MAX_FANOUT : u8 = 40;
pub const K_MAX_NETS : u16 = 20000;
pub const K_MAX_DIE : u8 = 16;
pub const K_MAX_SINKS : u16 = 1024;
pub const K_LOCAL_WIRE_UM : u16 = 500;
pub const K_MEDIUM_WIRE_UM : u16 = 2000;
pub const K_LONG_WIRE_UM : u16 = 5000;
pub const K_PRESET_FANOUT : [4]u8 = [8, 0, 3, 30];
pub const K_PRESET_NETS : [4]u16 = [5000, 0, 800, 20000];
pub const K_PRESET_DIE : [4]u8 = [4, 0, 4, 2];
pub const K_PRESET_SINKS : [4]u16 = [100, 1, 16, 1024];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine steps of this course; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [4]str = ["A medium net", "Nothing placed", "A small block", "A crowded die"];
pub const SAY_ASK : str = "How long is a wire, how crowded is a die and how big is a clock tree, before routing?";
pub const SAY_FANOUT : str = "fanout of a net";
pub const SAY_NETS : str = "nets";
pub const SAY_DIE : str = "die area, mm2";
pub const SAY_SINKS : str = "clock sinks";
pub const SAY_WIRES : [4]str = ["no wire", "local wire", "medium wire", "long wire"];
pub const SAY_WIRE_LEN : str = "{0} um";
pub const SAY_CONGESTION : str = "congestion";
pub const SAY_PER_MM2 : str = "{0} nets per mm2";
pub const SAY_BUFFERS : str = "clock buffers";
pub const SAY_LEVELS : str = "tree levels";
pub const SAY_RUNG_LEVEL : str = "{0} level";
pub const SAY_RUNG_LEVELS : str = "{0} levels";
pub const SAY_NOTE : str = "Fanout picks one of four wire classes. Congestion is nets over die area, and no die means none. One buffer serves sixteen sinks and there is always at least one; the tree has one, two or three levels.";
pub const SAY_SOURCE : str = "Logic: t27 spec compiler/hir_cost_models.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_is_one_of_nine_course_steps {
    assert K_STAGE < 9;
    assert K_STAGE == 3;
}

test the_three_wire_classes_in_micrometres {
    assert K_LOCAL_WIRE_UM == 500;
    assert K_MEDIUM_WIRE_UM == 2000;
    assert K_LONG_WIRE_UM == 5000;
}

test the_start_is_a_medium_net_with_a_hundred_sinks {
    assert K_PRESET_FANOUT[0] == 8;
    assert K_PRESET_SINKS[0] == 100;
    assert K_PRESET_NETS[3] == K_MAX_NETS;
}
