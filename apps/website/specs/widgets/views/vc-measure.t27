// SPDX-License-Identifier: Apache-2.0
; specs/widgets/views/vc-measure.t27 -- lesson 26 of the Vibecoding course: one thing measured after a run
; Source of truth for public/widgets/vc-measure/index.html, a page with NO script (FR-106, gHashTag/trinity#1807):
; t27c gen-text compiles this file and runs page_vc_measure, whose bytes the workflow
; .github/workflows/emit-widget-pages.yml writes to that path. An infographic: two views of one fact, a real
; <table> of one run of a made-up reading log and the one number read from it, and an ordered list of the four
; steps of measuring one thing, one <section> each, switched by the CSS :target selector (the frame is
; views/page_kit.t27).
; The lesson spec it illustrates: specs/vibecoding/measure.t27 (the Vibecoding from zero course, module own).
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_measure;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-measure";
pub const TITLE : str = "Build it, then measure one thing: a share read from a run";
pub const DESCRIPTION : str = "One run of a made-up reading log, one number read from it, and what that number can and cannot tell you. Lesson 26 of the Vibecoding course.";
pub const IMAGE_ALT : str = "A black and white diagram of four steps, run it, read one number, write it down, run it again, and a table of one example run: 4 titles given, 3 kept, a share kept of 75 out of 100, and a note that one run says nothing about the next.";
pub const HOOK : str = "One run, one number. 3 of 4 titles kept is 75 out of 100, and it is all that run can tell you.";
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "One run of the reading log";
pub const SAY_TABLE_HEAD : [2]str = ["What", "Value"];
pub const SAY_TABLE_CELLS : [8]str = ["Titles given", "4", "Titles kept", "3", "Share kept, out of 100", "75", "What one run says about the next", "nothing yet"];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 4;
pub const K_TABLE_CELLS : u16 = 8;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "Measure one thing";
pub const SAY_FLOW_STEPS : [4]str = ["Run it", "Read one number", "Write it down", "Run it again"];
pub const K_FLOW_STEPS : u8 = 4;
pub const SAY_NOTE : str = "Set KEPT to 5 in the lesson spec: a run cannot keep more than it was given, and two tests go red.";
pub const SAY_TAB_TABLE : str = "One run";
pub const SAY_TAB_FLOW : str = "The steps";
pub const SAY_SOURCE : str = "Rules: t27 spec vibecoding/measure.t27";

pub var OUT : [32768]u8 = [0; 32768];

; --- the page ---------------------------------------------------------------------------------

/// The two tabs, as links to the two sections; the one on screen is marked.
pub fn render_nav(o: []u8, n0: u32, on_flow: bool) -> u32 {
    var n : u32 = raw(o, n0, "<p class=\"nav\">");
    n = pk_link(o, n, "table", SAY_TAB_TABLE, !on_flow);
    n = pk_link(o, n, "flow", SAY_TAB_FLOW, on_flow);
    return raw(o, n, "</p>\n");
}

/// The table of the run: a head row and K_TABLE_ROWS rows of K_TABLE_COLS cells.
pub fn render_table(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<table>\n<caption>");
    n = text(o, n, SAY_TABLE_CAPTION);
    n = raw(o, n, "</caption>\n<thead><tr>");
    var c : u32 = 0;
    while (c < 2) {
        n = raw(o, n, "<th>");
        n = text(o, n, SAY_TABLE_HEAD[c as usize]);
        n = raw(o, n, "</th>");
        c = c + 1;
    }
    n = raw(o, n, "</tr></thead>\n<tbody>\n");
    var r : u32 = 0;
    while (r < 4) {
        n = raw(o, n, "<tr>");
        var k : u32 = 0;
        while (k < 2) {
            n = raw(o, n, "<td>");
            n = text(o, n, SAY_TABLE_CELLS[(r * 2 + k) as usize]);
            n = raw(o, n, "</td>");
            k = k + 1;
        }
        n = raw(o, n, "</tr>\n");
        r = r + 1;
    }
    return raw(o, n, "</tbody>\n</table>\n");
}

/// The four steps, in order.
pub fn render_flow(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<ol class=\"steps\">\n");
    var i : u32 = 0;
    while (i < 4) {
        n = raw(o, n, "<li>");
        n = text(o, n, SAY_FLOW_STEPS[i as usize]);
        n = raw(o, n, "</li>\n");
        i = i + 1;
    }
    return raw(o, n, "</ol>\n");
}

/// The whole page. The flow is the first section, the table the last and the default (a browser without
/// :has needs the default last). OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    n = pk_sec_open(o, n, "flow", false);
    n = render_nav(o, n, true);
    n = pk_h2(o, n, SAY_FLOW_TITLE);
    n = render_flow(o, n);
    n = pk_sec_close(o, n);
    n = pk_sec_open(o, n, "table", true);
    n = render_nav(o, n, false);
    n = render_table(o, n);
    n = pk_sec_close(o, n);
    n = pk_p(o, n, SAY_NOTE);
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_measure(out: []u8) -> u32 {
    return render_page(out);
}

; --- tests --------------------------------------------------------------------------------------

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 4;
    assert K_FLOW_STEPS > 1;
}

test the_share_is_read_from_the_run {
    assert 3 * 100 / 4 == 75;
}

test the_widget_sends_nothing {
    assert SENDS_NOTHING == true;
}

test the_page_has_a_real_table_and_the_four_steps {
    const n : u32 = page_vc_measure(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<table>") == 1;
    assert pk_count(OUT[0..], n, "<caption>") == 1;
    assert pk_count(OUT[0..], n, "<th>") == 2;
    assert pk_count(OUT[0..], n, "<td>") == 8;
    assert pk_count(OUT[0..], n, "<li>") == 4;
    assert pk_has(OUT[0..], n, "<td>Share kept, out of 100</td><td>75</td>");
    assert pk_has(OUT[0..], n, "<td>nothing yet</td>");
    assert pk_has(OUT[0..], n, "<li>Run it again</li>");
}

test the_page_has_two_sections_and_the_table_is_the_default {
    const n : u32 = page_vc_measure(OUT[0..]);
    assert pk_count(OUT[0..], n, "<section ") == 2;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"flow\">") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"table\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_has(OUT[0..], n, "<a href=\"#flow\">The steps</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#table\" class=\"on\">One run</a>");
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_measure(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"Build it, then measure one thing: a share read from a run\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"One run, one number. 3 of 4 titles kept is 75 out of 100, and it is all that run can tell you.\">");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-measure/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_measure(tiny[0..]) == OVER;
}
