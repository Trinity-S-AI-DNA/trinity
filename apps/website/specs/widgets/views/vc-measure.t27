// SPDX-License-Identifier: Apache-2.0
; specs/widgets/vc-measure.t27 -- lesson 26 of the Vibecoding course: one thing measured after a run
; Source of truth for public/widgets/vc-measure/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: specs/vibecoding/measure.t27 (the Vibecoding from zero course, module own).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_vc_measure;

pub const KIND : str = "widget-tool";
pub const ID : str = "vc-measure";
pub const TITLE : str = "Build it, then measure one thing: a share read from a run";
pub const DESCRIPTION : str = "One run of a made-up reading log, one number read from it, and what that number can and cannot tell you. Lesson 26 of the Vibecoding course.";
pub const IMAGE_ALT : str = "A black and white diagram of four steps, run it, read one number, write it down, run it again, and a table of one example run: 4 titles given, 3 kept, a share kept of 75 out of 100, and a note that one run says nothing about the next.";
pub const HOOK : str = "One run, one number. 3 of 4 titles kept is 75 out of 100, and it is all that run can tell you.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec specs/vibecoding/measure.t27: RUNS is 4, KEPT is 3, and its test asserts KEPT x 100 / RUNS == 75; its 3 tests pass in the site test runner", "The reading log run is a made-up example written for this lesson; no run of a real project is quoted"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "One run of the reading log";
pub const SAY_TABLE_HEAD : [2]str = ["What", "Value"];
pub const SAY_TABLE_CELLS : [8]str = ["Titles given", "4", "Titles kept", "3", "Share kept, out of 100", "75", "What one run says about the next", "nothing yet"];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 4;
pub const K_TABLE_CELLS : u16 = 8;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "Measure one thing";
pub const SAY_FLOW_STEPS : [4]str = ["Run it", "Read one number", "Write it down", "Run it again"];
pub const K_FLOW_STEPS : u8 = 4;
pub const SAY_NOTE : str = "Set KEPT to 5 in the lesson spec: a run cannot keep more than it was given, and two tests go red.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 4;
    assert K_FLOW_STEPS > 1;
}

test the_share_is_read_from_the_run {
    assert 3 * 100 / 4 == 75;
}
