// SPDX-License-Identifier: Apache-2.0
; specs/widgets/views/view_pages.t27 -- the list of the static widget pages of course 12, "Vibecoding from zero"
; (FR-106, gHashTag/trinity#1807). Every id below has one view spec, views/<id>.t27, whose pub fn page_<id>
; writes the whole page; .github/workflows/emit-widget-pages.yml runs t27c gen-text on it and puts the bytes
; in public/widgets/<id>/index.html. The two kinds: STATEFUL (a finite-state machine written out as one
; <section> per state, links between them, the CSS :target selector showing one), INFOGRAPHIC (a few
; sections or one, tabs by fragment links) -- both with no script. The nine stateful ones have a cap on
; their states, so a page stays small; the number of states and the size of each page are tests of the view.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_view_pages;

pub const K_PAGE_COUNT : u32 = 27;
pub const K_STATEFUL_COUNT : u32 = 9;
pub const K_INFOGRAPHIC_COUNT : u32 = 18;
pub const K_MODULES : u32 = 9;
pub const K_LESSONS_PER_MODULE : u32 = 3;

pub const PAGE_IDS : [27]str = [
    "vc-agent-hands", "vc-agent-memory", "vc-agent-mind", "vc-branch", "vc-commit", "vc-describe-run-check",
    "vc-editor-agent", "vc-four-phases", "vc-honest-plan", "vc-key-pair", "vc-measure", "vc-message-loop",
    "vc-myth-tests", "vc-own-spec", "vc-plant-bug", "vc-prompt-example", "vc-prompt-parts", "vc-read-an-error",
    "vc-read-diff", "vc-secrets-out", "vc-small-step", "vc-spec-to-bot", "vc-steps-in-order", "vc-ten-commands",
    "vc-test-judge", "vc-the-loop", "vc-unstuck"
];

pub const STATEFUL_IDS : [9]str = [
    "vc-four-phases", "vc-message-loop", "vc-plant-bug", "vc-read-diff", "vc-secrets-out", "vc-spec-to-bot",
    "vc-test-judge", "vc-the-loop", "vc-unstuck"
];

/// Is this id one of the nine stateful pages?
pub fn is_stateful(id: []const u8) -> bool {
    var i : usize = 0;
    while (i < 9) {
        if (STATEFUL_IDS[i] == id) { return true; }
        i = i + 1;
    }
    return false;
}

/// How many times does id stand in PAGE_IDS: 1 for a page of the course, 0 for any other.
pub fn page_count_of(id: []const u8) -> u32 {
    var c : u32 = 0;
    var i : usize = 0;
    while (i < 27) {
        if (PAGE_IDS[i] == id) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

test the_course_has_nine_modules_of_three_lessons_and_one_page_per_lesson {
    assert K_MODULES * K_LESSONS_PER_MODULE == 27;
    assert K_PAGE_COUNT == 27;
    assert K_STATEFUL_COUNT == 9;
    assert K_STATEFUL_COUNT + K_INFOGRAPHIC_COUNT == K_PAGE_COUNT;
}

test every_id_stands_once_in_the_list {
    var bad : u32 = 0;
    var i : usize = 0;
    while (i < 27) {
        if (page_count_of(PAGE_IDS[i]) != 1) { bad = bad + 1; }
        i = i + 1;
    }
    assert bad == 0;
}

test every_stateful_id_is_a_page_and_the_loop_is_stateful {
    var bad : u32 = 0;
    var i : usize = 0;
    while (i < 9) {
        if (page_count_of(STATEFUL_IDS[i]) != 1) { bad = bad + 1; }
        i = i + 1;
    }
    assert bad == 0;
    assert is_stateful("vc-the-loop");
    assert is_stateful("vc-key-pair") == false;
}

test an_unknown_id_is_not_a_page {
    assert page_count_of("vc-nothing") == 0;
    assert page_count_of("") == 0;
}
