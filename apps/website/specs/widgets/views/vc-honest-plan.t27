// SPDX-License-Identifier: Apache-2.0
; specs/widgets/views/vc-honest-plan.t27 -- lesson 27 of the Vibecoding course: a plan that names what is measured and what is unknown
; Source of truth for public/widgets/vc-honest-plan/index.html, a page with NO script (FR-106, gHashTag/trinity#1807):
; t27c gen-text compiles this file and runs page_vc_honest_plan, whose bytes the workflow
; .github/workflows/emit-widget-pages.yml writes to that path. An infographic: two views of one fact, a real
; <table> of five plan lines for a made-up reading log, each marked measured or unknown, and an ordered list of
; the three steps that put a line into the plan, one <section> each, switched by the CSS :target selector (the
; frame is views/page_kit.t27).
; The lesson spec it illustrates: specs/vibecoding/honest_plan.t27 (the Vibecoding from zero course, module own).
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_honest_plan;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-honest-plan";
pub const TITLE : str = "An honest plan: what is measured, what is not known yet";
pub const DESCRIPTION : str = "A plan of five lines for a made-up reading log, each marked measured or unknown, with no promise about the future. Lesson 27 of the Vibecoding course.";
pub const IMAGE_ALT : str = "A black and white diagram of three steps, write the line, mark it measured or unknown, say what would tell us, and a table of five plan lines: two marked measured, three marked unknown with the run that would answer them, none promised.";
pub const HOOK : str = "Every line of your plan is either a number a run printed or a plain not known yet. Mark five lines and count the promises: zero.";
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "A plan for the reading log";
pub const SAY_TABLE_HEAD : [2]str = ["Plan line", "Kind"];
pub const SAY_TABLE_CELLS : [10]str = ["The log kept 3 of 4 titles in one run", "measured", "The tests pass on every change", "measured", "Will it keep as many next week", "unknown: run it again and read the number", "Will a friend find it clear", "unknown: watch one friend use it", "Will it still work in a month", "unknown: run the tests then"];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 5;
pub const K_TABLE_CELLS : u16 = 10;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "How a line gets into the plan";
pub const SAY_FLOW_STEPS : [3]str = ["Write the line", "Mark it measured or unknown", "Name the run that would tell"];
pub const K_FLOW_STEPS : u8 = 3;
pub const SAY_NOTE : str = "Set PROMISED to 1 in the lesson spec and the lines no longer add up to the plan.";
pub const SAY_TAB_TABLE : str = "The plan lines";
pub const SAY_TAB_FLOW : str = "How a line gets in";
pub const SAY_SOURCE : str = "Rules: t27 spec vibecoding/honest_plan.t27";

pub var OUT : [32768]u8 = [0; 32768];

; --- the page ---------------------------------------------------------------------------------

/// The two tabs, as links to the two sections; the one on screen is marked.
pub fn render_nav(o: []u8, n0: u32, on_flow: bool) -> u32 {
    var n : u32 = raw(o, n0, "<p class=\"nav\">");
    n = pk_link(o, n, "table", SAY_TAB_TABLE, !on_flow);
    n = pk_link(o, n, "flow", SAY_TAB_FLOW, on_flow);
    return raw(o, n, "</p>\n");
}

/// The table of the plan: a head row and K_TABLE_ROWS rows of K_TABLE_COLS cells.
pub fn render_table(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<table>\n<caption>");
    n = text(o, n, SAY_TABLE_CAPTION);
    n = raw(o, n, "</caption>\n<thead><tr>");
    var c : u32 = 0;
    while (c < 2) {
        n = raw(o, n, "<th>");
        n = text(o, n, SAY_TABLE_HEAD[c as usize]);
        n = raw(o, n, "</th>");
        c = c + 1;
    }
    n = raw(o, n, "</tr></thead>\n<tbody>\n");
    var r : u32 = 0;
    while (r < 5) {
        n = raw(o, n, "<tr>");
        var k : u32 = 0;
        while (k < 2) {
            n = raw(o, n, "<td>");
            n = text(o, n, SAY_TABLE_CELLS[(r * 2 + k) as usize]);
            n = raw(o, n, "</td>");
            k = k + 1;
        }
        n = raw(o, n, "</tr>\n");
        r = r + 1;
    }
    return raw(o, n, "</tbody>\n</table>\n");
}

/// The three steps, in order.
pub fn render_flow(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<ol class=\"steps\">\n");
    var i : u32 = 0;
    while (i < 3) {
        n = raw(o, n, "<li>");
        n = text(o, n, SAY_FLOW_STEPS[i as usize]);
        n = raw(o, n, "</li>\n");
        i = i + 1;
    }
    return raw(o, n, "</ol>\n");
}

/// The whole page. The flow is the first section, the table the last and the default (a browser without
/// :has needs the default last). OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    n = pk_sec_open(o, n, "flow", false);
    n = render_nav(o, n, true);
    n = pk_h2(o, n, SAY_FLOW_TITLE);
    n = render_flow(o, n);
    n = pk_sec_close(o, n);
    n = pk_sec_open(o, n, "table", true);
    n = render_nav(o, n, false);
    n = render_table(o, n);
    n = pk_sec_close(o, n);
    n = pk_p(o, n, SAY_NOTE);
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_honest_plan(out: []u8) -> u32 {
    return render_page(out);
}

; --- tests --------------------------------------------------------------------------------------

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 3;
    assert K_FLOW_STEPS > 1;
}

test the_plan_lines_add_up {
    assert 2 + 3 + 0 == 5;
}

test the_widget_sends_nothing {
    assert SENDS_NOTHING == true;
}

test the_page_has_a_real_table_and_the_three_steps {
    const n : u32 = page_vc_honest_plan(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<table>") == 1;
    assert pk_count(OUT[0..], n, "<caption>") == 1;
    assert pk_count(OUT[0..], n, "<th>") == 2;
    assert pk_count(OUT[0..], n, "<td>") == 10;
    assert pk_count(OUT[0..], n, "<li>") == 3;
    assert pk_count(OUT[0..], n, "<td>measured</td>") == 2;
    assert pk_has(OUT[0..], n, "<td>unknown: run the tests then</td>");
    assert pk_has(OUT[0..], n, "<li>Name the run that would tell</li>");
}

test the_page_has_two_sections_and_the_table_is_the_default {
    const n : u32 = page_vc_honest_plan(OUT[0..]);
    assert pk_count(OUT[0..], n, "<section ") == 2;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"flow\">") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"table\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_has(OUT[0..], n, "<a href=\"#flow\">How a line gets in</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#table\" class=\"on\">The plan lines</a>");
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_honest_plan(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"An honest plan: what is measured, what is not known yet\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"Every line of your plan is either a number a run printed or a plain not known yet. Mark five lines and count the promises: zero.\">");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-honest-plan/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_honest_plan(tiny[0..]) == OVER;
}
