// SPDX-License-Identifier: Apache-2.0
; specs/widgets/views/vc-plant-bug.t27 -- plant a bug on purpose and see which test notices. Lesson 17 of the
; course "Vibecoding from zero" (specs/course/vibecoding.t27). Source of truth for
; public/widgets/vc-plant-bug/index.html, a page with NO script (FR-106, gHashTag/trinity#1807): t27c gen-text
; compiles this file and runs page_vc_plant_bug, whose bytes the workflow
; .github/workflows/emit-widget-pages.yml writes to that path. The widget is a finite-state machine written
; out in full: one <section> per state, a link per transition, the CSS :target selector shows the one the
; address names (the frame is views/page_kit.t27). The lesson spec is specs/vibecoding/plant_bug.t27.
; --
; STATE. One sign: 0 the rule as the agent wrote it, age >= 18; 1 the bug planted, age > 18. Two states, so
; the page needs no cap on steps: the link of the first state plants the bug, the link of the second puts the
; sign back. In each state the three tests run against the rule shown: a weak test (age 30 is an adult, age 5
; is not) and a boundary test (age 18 is an adult), each green when the rule says what the test expects and
; red when it does not. With the bug planted the two weak tests stay green and the boundary test turns red.
; WHAT IT DOES NOT CLAIM: that one boundary test is enough for real code; it shows that a test which has
; never failed may not be looking where the bug is.
; ASSUMPTION: the interaction is read from the words of the widget that ran as a script before (SAY_FLIP,
; SAY_RESTORE, SAY_PASS, SAY_FAIL, SAY_VERDICT_WEAK, SAY_VERDICT_BOUNDARY): one click flips the sign, and the
; verdict lines show while the bug is planted.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_plant_bug;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-plant-bug";
pub const TITLE : str = "Vibecoding 17: plant a bug and watch the test fail";
pub const DESCRIPTION : str = "Flip one sign in a rule, run a weak test and a boundary test, and see which one turns red. Lesson 17 of the vibecoding course.";
pub const IMAGE_ALT : str = "A black and white card: the rule age >= 18 with its sign flipped to age > 18; a test on ages 30 and 5 stays green, a test on age 18 turns red.";
pub const HOOK : str = "A test that never failed has not proved it can. Break the code on purpose and watch.";
pub const SENDS_NOTHING : bool = true;

; --- Numbers: held equal to specs/vibecoding/plant_bug.t27 by the tests below
pub const K_ADULT_AT : u8 = 18;
pub const K_OLD_AGE : u8 = 30;
pub const K_YOUNG_AGE : u8 = 5;
pub const K_BOUNDARY_AGE : u8 = 18;
pub const K_TESTS : u8 = 3;
pub const K_MIN_AGE : u8 = 0;
pub const K_MAX_AGE : u8 = 120;
pub const K_STATES : u32 = 2;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_RULE_LABEL : str = "The rule, as the agent wrote it";
pub const SAY_RULES : [2]str = ["age >= 18", "age > 18"];
pub const SAY_FLIP : str = "Plant the bug: flip the sign";
pub const SAY_RESTORE : str = "Put the sign back";
pub const SAY_TESTS : [3]str = ["weak test: age 30 is an adult", "weak test: age 5 is not an adult", "boundary test: age 18 is an adult"];
pub const SAY_PASS : str = "green";
pub const SAY_FAIL : str = "red";
pub const SAY_VERDICT_WEAK : str = "Both weak tests are green with the bug planted: they never look at the edge.";
pub const SAY_VERDICT_BOUNDARY : str = "The boundary test turns red: it is the one that can tell.";
pub const SAY_NOTE : str = "Bugs live at edges: 18, 0, the last item of a list. Put a test there.";
pub const SAY_SOURCE : str = "Logic: t27 spec specs/vibecoding/plant_bug.t27";

pub var OUT : [16384]u8 = [0; 16384];

; --- the transitions: the whole logic of the widget, one place ---------------------------------

/// The rule of the lesson: is_adult says yes from K_ADULT_AT up; is_adult_planted, with planted 1, says yes
/// only above it. 1 for yes, 0 for no.
pub fn bug_is_adult(age: u32, planted: u32) -> u32 {
    if (planted == 1) {
        if (age > (K_ADULT_AT as u32)) { return 1; }
        return 0;
    }
    if (age >= (K_ADULT_AT as u32)) { return 1; }
    return 0;
}

/// The age test i runs on: 0 the old age, 1 the young age, 2 the boundary age.
pub fn bug_age(i: u32) -> u32 {
    if (i == 0) { return K_OLD_AGE as u32; }
    if (i == 1) { return K_YOUNG_AGE as u32; }
    return K_BOUNDARY_AGE as u32;
}

/// What test i expects: 1 an adult, 0 not an adult (only the young age is not).
pub fn bug_expect(i: u32) -> u32 {
    if (i == 1) { return 0; }
    return 1;
}

/// Does test i come out green against the rule, planted or not?
pub fn bug_passes(i: u32, planted: u32) -> bool {
    return bug_is_adult(bug_age(i), planted) == bug_expect(i);
}

/// How many of the three tests are red against the rule.
pub fn bug_red_count(planted: u32) -> u32 {
    var c : u32 = 0;
    var i : u32 = 0;
    while (i < 3) {
        if (!bug_passes(i, planted)) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

; --- the page ---------------------------------------------------------------------------------

/// The id of a state: s, then the sign, 0 or 1.
pub fn bug_id(o: []u8, n0: u32, planted: u32) -> u32 {
    var n : u32 = raw(o, n0, "s");
    return num(o, n, planted as u64);
}

/// A link to a state, or the plain label when there is nothing to go to.
pub fn bug_link(o: []u8, n0: u32, planted: u32, label: []const u8, live: bool, on: bool) -> u32 {
    var n : u32 = n0;
    if (!live) {
        n = raw(o, n, "<span class=\"off\">");
        n = text(o, n, label);
        return raw(o, n, "</span> ");
    }
    n = raw(o, n, "<a href=\"#");
    n = bug_id(o, n, planted);
    if (on) { n = raw(o, n, "\" class=\"on\">"); } else { n = raw(o, n, "\">"); }
    n = text(o, n, label);
    return raw(o, n, "</a> ");
}

/// One list item of a test result: the colour word in bold, large when it is red, then the test.
pub fn bug_li(o: []u8, n0: u32, lead: []const u8, rest: []const u8, loud: bool) -> u32 {
    var n : u32 = n0;
    if (loud) { n = raw(o, n, "<li><b class=\"big\">"); } else { n = raw(o, n, "<li><b>"); }
    n = text(o, n, lead);
    n = raw(o, n, "</b>");
    n = text(o, n, rest);
    return raw(o, n, "</li>\n");
}

/// One section: the rule, the three tests with their colour, the verdict when planted, and the two links.
pub fn bug_render_state(o: []u8, n0: u32, planted: u32) -> u32 {
    var n : u32 = pk_sec_begin(o, n0, planted == 0);
    n = bug_id(o, n, planted);
    n = pk_sec_body(o, n);
    n = pk_h2(o, n, SAY_RULE_LABEL);
    n = raw(o, n, "<div class=\"box\"><p class=\"big\">");
    n = text(o, n, SAY_RULES[planted as usize]);
    n = raw(o, n, "</p></div>\n<ul class=\"list\">\n");
    var i : u32 = 0;
    while (i < 3) {
        if (bug_passes(i, planted)) {
            n = bug_li(o, n, SAY_PASS, SAY_TESTS[i as usize], false);
        } else {
            n = bug_li(o, n, SAY_FAIL, SAY_TESTS[i as usize], true);
        }
        i = i + 1;
    }
    n = raw(o, n, "</ul>\n");
    if (planted == 1) {
        n = pk_p(o, n, SAY_VERDICT_WEAK);
        n = pk_p(o, n, SAY_VERDICT_BOUNDARY);
    }
    n = raw(o, n, "<p class=\"nav\">");
    n = bug_link(o, n, 1, SAY_FLIP, planted == 0, false);
    n = bug_link(o, n, 0, SAY_RESTORE, planted == 1, false);
    n = raw(o, n, "</p>\n");
    return pk_sec_close(o, n);
}

/// The whole page. The planted state first, the real rule s0 last: the default is the last section, as a
/// browser without :has needs. OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    n = bug_render_state(o, n, 1);
    n = bug_render_state(o, n, 0);
    n = pk_p(o, n, SAY_NOTE);
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_plant_bug(out: []u8) -> u32 {
    return render_page(out);
}

; --- tests --------------------------------------------------------------------------------------

test the_widget_sends_nothing {
    assert SENDS_NOTHING == true;
}

test the_weak_ages_sit_on_both_sides_of_the_rule {
    assert K_OLD_AGE > K_ADULT_AT;
    assert K_YOUNG_AGE < K_ADULT_AT;
}

test the_boundary_age_is_the_edge_of_the_rule {
    assert K_BOUNDARY_AGE == K_ADULT_AT;
    assert K_BOUNDARY_AGE <= K_MAX_AGE;
    assert K_BOUNDARY_AGE >= K_MIN_AGE;
}

test there_is_one_test_per_label {
    assert K_TESTS == 3;
    assert SAY_TESTS[2] == "boundary test: age 18 is an adult";
}

test the_planted_rule_is_one_sign_away {
    assert bug_is_adult(18, 0) == 1;
    assert bug_is_adult(18, 1) == 0;
    assert bug_is_adult(30, 0) == 1;
    assert bug_is_adult(30, 1) == 1;
    assert bug_is_adult(5, 0) == 0;
    assert bug_is_adult(5, 1) == 0;
}

test the_tests_run_on_the_ages_of_the_lesson {
    assert bug_age(0) == 30;
    assert bug_age(1) == 5;
    assert bug_age(2) == 18;
}

test the_weak_tests_stay_green_and_the_boundary_test_turns_red {
    assert bug_passes(0, 0) == true;
    assert bug_passes(1, 0) == true;
    assert bug_passes(2, 0) == true;
    assert bug_passes(0, 1) == true;
    assert bug_passes(1, 1) == true;
    assert bug_passes(2, 1) == false;
    assert bug_red_count(0) == 0;
    assert bug_red_count(1) == 1;
}

test the_machine_has_two_states {
    assert K_STATES == 2;
}

test the_page_has_one_section_per_state_and_one_default {
    const n : u32 = page_vc_plant_bug(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<section ") == 2;
    assert pk_count(OUT[0..], n, "<section ") == K_STATES;
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"s0\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"s1\">") == 1;
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_plant_bug(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"Vibecoding 17: plant a bug and watch the test fail\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"A test that never failed has not proved it can.");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-plant-bug/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_state_page_shows_the_rule_the_colours_and_the_links {
    const n : u32 = page_vc_plant_bug(OUT[0..]);
    assert pk_count(OUT[0..], n, "<p class=\"big\">age &gt;= 18</p>") == 1;
    assert pk_count(OUT[0..], n, "<p class=\"big\">age &gt; 18</p>") == 1;
    assert pk_count(OUT[0..], n, ">green</b>") == 5;
    assert pk_count(OUT[0..], n, "<b class=\"big\">red</b>boundary test: age 18 is an adult") == 1;
    assert pk_count(OUT[0..], n, ">red</b>") == 1;
    assert pk_count(OUT[0..], n, "Both weak tests are green with the bug planted: they never look at the edge.") == 1;
    assert pk_count(OUT[0..], n, "The boundary test turns red: it is the one that can tell.") == 1;
    assert pk_has(OUT[0..], n, "<a href=\"#s1\">Plant the bug: flip the sign</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#s0\">Put the sign back</a>");
    assert pk_has(OUT[0..], n, "<span class=\"off\">Plant the bug: flip the sign</span>");
    assert pk_has(OUT[0..], n, "<span class=\"off\">Put the sign back</span>");
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_plant_bug(tiny[0..]) == OVER;
    assert render_page(tiny[0..]) == OVER;
}
