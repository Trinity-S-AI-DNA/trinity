// SPDX-License-Identifier: Apache-2.0
; specs/widgets/views/vc-myth-tests.t27 -- the infographic of lesson 3 of the vibecoding course (specs/course/vibecoding.t27)
; Source of truth for public/widgets/vc-myth-tests/index.html, a page with NO script (FR-106, gHashTag/trinity#1807):
; t27c gen-text compiles this file and runs page_vc_myth_tests, whose bytes the workflow
; .github/workflows/emit-widget-pages.yml writes to that path. An infographic: two views of one fact, a real
; <table> of five myths about vibecoding and the small case that settles each, and an ordered list of the four
; steps of putting a myth to a test, one <section> each, switched by the CSS :target selector (the frame is
; views/page_kit.t27).
; The lesson spec it illustrates: specs/vibecoding/myth_tests.t27.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_myth_tests;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-myth-tests";
pub const TITLE : str = "Vibecoding 3: five myths, each put to a test";
pub const DESCRIPTION : str = "Five sentences that sound right about vibecoding, each settled by a small case a test can run. Lesson 3 of the vibecoding course.";
pub const IMAGE_ALT : str = "A black and white table of five myths about vibecoding with the small case that settles each one: an average that runs and gives 8 instead of 6, a double that passes at 2 and fails at 3, 8 messages kept of 20, 7 halved and doubled gives 6, and a check that says yes to 2 against 3; a diagram walks the steps of a test.";
pub const HOOK : str = "Five myths about vibecoding, each one settled by a test you can read in a minute.";
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Five myths and the case that settles each";
pub const SAY_TABLE_HEAD : [2]str = ["Myth", "What the test found"];
pub const SAY_TABLE_CELLS : [10]str = [
    "If it runs without an error, it is right.", "average of 4 and 8 printed 8, the answer is 6",
    "One passing test proves the code is right.", "x * x equals x + x at 2 and not at 3",
    "The agent remembers the whole conversation.", "8 messages kept of 20 sent",
    "A step you do can always be undone.", "7 halved and doubled is 6, not 7",
    "A check that passes is a good check.", "a check that says yes to 2 against 3 cannot fail"
];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 5;
pub const K_TABLE_CELLS : u16 = 10;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "How a myth is put to a test";
pub const SAY_FLOW_STEPS : [4]str = ["Say the myth as a sentence", "Find a small case where it could fail", "Write the check with the answer you expect", "Run it and read the verdict"];
pub const K_FLOW_STEPS : u8 = 4;
pub const SAY_NOTE : str = "The cases are small on purpose: each fits in one line you can check by hand.";
pub const SAY_TAB_TABLE : str = "Five myths";
pub const SAY_TAB_FLOW : str = "A test, step by step";
pub const SAY_SOURCE : str = "Rules: t27 spec vibecoding/myth_tests.t27";

; --- The numbers behind the table ------------------------------------------------------------
pub const K_MYTHS : u8 = 5;
pub const K_AVG_RAN : u16 = 8;
pub const K_AVG_RIGHT : u16 = 6;
pub const K_MESSAGES_SENT : u16 = 20;
pub const K_MESSAGES_KEPT : u16 = 8;
pub const K_ODD_BACK : u16 = 6;

pub var OUT : [32768]u8 = [0; 32768];

; --- the page ---------------------------------------------------------------------------------

/// The two tabs, as links to the two sections; the one on screen is marked.
pub fn render_nav(o: []u8, n0: u32, on_flow: bool) -> u32 {
    var n : u32 = raw(o, n0, "<p class=\"nav\">");
    n = pk_link(o, n, "table", SAY_TAB_TABLE, !on_flow);
    n = pk_link(o, n, "flow", SAY_TAB_FLOW, on_flow);
    return raw(o, n, "</p>\n");
}

/// The table of the myths: a head row and K_TABLE_ROWS rows of K_TABLE_COLS cells.
pub fn render_table(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<table>\n<caption>");
    n = text(o, n, SAY_TABLE_CAPTION);
    n = raw(o, n, "</caption>\n<thead><tr>");
    var c : u32 = 0;
    while (c < 2) {
        n = raw(o, n, "<th>");
        n = text(o, n, SAY_TABLE_HEAD[c as usize]);
        n = raw(o, n, "</th>");
        c = c + 1;
    }
    n = raw(o, n, "</tr></thead>\n<tbody>\n");
    var r : u32 = 0;
    while (r < 5) {
        n = raw(o, n, "<tr>");
        var k : u32 = 0;
        while (k < 2) {
            n = raw(o, n, "<td>");
            n = text(o, n, SAY_TABLE_CELLS[(r * 2 + k) as usize]);
            n = raw(o, n, "</td>");
            k = k + 1;
        }
        n = raw(o, n, "</tr>\n");
        r = r + 1;
    }
    return raw(o, n, "</tbody>\n</table>\n");
}

/// The four steps, in order.
pub fn render_flow(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<ol class=\"steps\">\n");
    var i : u32 = 0;
    while (i < 4) {
        n = raw(o, n, "<li>");
        n = text(o, n, SAY_FLOW_STEPS[i as usize]);
        n = raw(o, n, "</li>\n");
        i = i + 1;
    }
    return raw(o, n, "</ol>\n");
}

/// The whole page. The flow is the first section, the table the last and the default (a browser without
/// :has needs the default last). OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    n = pk_sec_open(o, n, "flow", false);
    n = render_nav(o, n, true);
    n = pk_h2(o, n, SAY_FLOW_TITLE);
    n = render_flow(o, n);
    n = pk_sec_close(o, n);
    n = pk_sec_open(o, n, "table", true);
    n = render_nav(o, n, false);
    n = render_table(o, n);
    n = pk_sec_close(o, n);
    n = pk_p(o, n, SAY_NOTE);
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_myth_tests(out: []u8) -> u32 {
    return render_page(out);
}

; --- tests --------------------------------------------------------------------------------------

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
    assert K_TABLE_ROWS == K_MYTHS;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 4;
}

test the_table_numbers_come_from_the_lesson {
    assert K_AVG_RAN == 4 + 8 / 2;
    assert K_AVG_RIGHT == (4 + 8) / 2;
    assert K_MESSAGES_KEPT < K_MESSAGES_SENT;
    assert K_ODD_BACK == 7 / 2 * 2;
}

test the_widget_sends_nothing {
    assert SENDS_NOTHING == true;
}

test the_page_has_a_real_table_and_the_four_steps {
    const n : u32 = page_vc_myth_tests(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<table>") == 1;
    assert pk_count(OUT[0..], n, "<caption>") == 1;
    assert pk_count(OUT[0..], n, "<th>") == 2;
    assert pk_count(OUT[0..], n, "<td>") == 10;
    assert pk_count(OUT[0..], n, "<li>") == 4;
    assert pk_has(OUT[0..], n, "<td>x * x equals x + x at 2 and not at 3</td>");
    assert pk_has(OUT[0..], n, "<td>8 messages kept of 20 sent</td>");
    assert pk_has(OUT[0..], n, "<li>Run it and read the verdict</li>");
}

test the_page_has_two_sections_and_the_table_is_the_default {
    const n : u32 = page_vc_myth_tests(OUT[0..]);
    assert pk_count(OUT[0..], n, "<section ") == 2;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"flow\">") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"table\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_has(OUT[0..], n, "<a href=\"#flow\">A test, step by step</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#table\" class=\"on\">Five myths</a>");
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_myth_tests(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"Vibecoding 3: five myths, each put to a test\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"Five myths about vibecoding, each one settled by a test you can read in a minute.\">");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-myth-tests/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_myth_tests(tiny[0..]) == OVER;
}
