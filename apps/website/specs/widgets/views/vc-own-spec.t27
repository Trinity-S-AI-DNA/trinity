// SPDX-License-Identifier: Apache-2.0
; specs/widgets/views/vc-own-spec.t27 -- lesson 25 of the Vibecoding course: the parts of a spec for your own idea
; Source of truth for public/widgets/vc-own-spec/index.html, a page with NO script (FR-106, gHashTag/trinity#1807):
; t27c gen-text compiles this file and runs page_vc_own_spec, whose bytes the workflow
; .github/workflows/emit-widget-pages.yml writes to that path. An infographic: two views of one fact, a real
; <table> that fills in the three parts of a spec for a made-up reading log, and an ordered list of the five
; steps from an idea to a hand-over, one <section> each, switched by the CSS :target selector (the frame is
; views/page_kit.t27).
; The lesson spec it illustrates: specs/vibecoding/own_spec.t27 (the Vibecoding from zero course, module own).
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_own_spec;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-own-spec";
pub const TITLE : str = "A spec for your own idea: one input, one output, one test";
pub const DESCRIPTION : str = "The three parts an idea needs before you hand it to an agent, filled in for a made-up reading log. Lesson 25 of the Vibecoding course.";
pub const IMAGE_ALT : str = "A black and white diagram of five steps, idea, one input, one output, one test, hand to the agent, and a table that fills in each part for a reading log: input one book title, output the count of books logged, done test the count goes up by one after one title.";
pub const HOOK : str = "Before an agent writes anything, can you name one input, one output and the test that says done? Fill them in for a reading log.";
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "The reading log, as a spec";
pub const SAY_TABLE_HEAD : [2]str = ["Part", "In the reading log"];
pub const SAY_TABLE_CELLS : [8]str = ["One input", "one book title", "One output", "how many books are logged", "One test that says done", "after one title the count is 1", "Ready to hand over", "1 x 1 x 1 = 1"];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 4;
pub const K_TABLE_CELLS : u16 = 8;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "From an idea to a hand-over";
pub const SAY_FLOW_STEPS : [5]str = ["An idea", "One input", "One output", "One test", "Hand it to the agent"];
pub const K_FLOW_STEPS : u8 = 5;
pub const SAY_NOTE : str = "Set the test count to 0 in the lesson spec and the idea is no longer ready.";
pub const SAY_TAB_TABLE : str = "The three parts";
pub const SAY_TAB_FLOW : str = "Idea to hand-over";
pub const SAY_SOURCE : str = "Rules: t27 spec vibecoding/own_spec.t27";

pub var OUT : [32768]u8 = [0; 32768];

; --- the page ---------------------------------------------------------------------------------

/// The two tabs, as links to the two sections; the one on screen is marked.
pub fn render_nav(o: []u8, n0: u32, on_flow: bool) -> u32 {
    var n : u32 = raw(o, n0, "<p class=\"nav\">");
    n = pk_link(o, n, "table", SAY_TAB_TABLE, !on_flow);
    n = pk_link(o, n, "flow", SAY_TAB_FLOW, on_flow);
    return raw(o, n, "</p>\n");
}

/// The table of the parts: a head row and K_TABLE_ROWS rows of K_TABLE_COLS cells.
pub fn render_table(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<table>\n<caption>");
    n = text(o, n, SAY_TABLE_CAPTION);
    n = raw(o, n, "</caption>\n<thead><tr>");
    var c : u32 = 0;
    while (c < 2) {
        n = raw(o, n, "<th>");
        n = text(o, n, SAY_TABLE_HEAD[c as usize]);
        n = raw(o, n, "</th>");
        c = c + 1;
    }
    n = raw(o, n, "</tr></thead>\n<tbody>\n");
    var r : u32 = 0;
    while (r < 4) {
        n = raw(o, n, "<tr>");
        var k : u32 = 0;
        while (k < 2) {
            n = raw(o, n, "<td>");
            n = text(o, n, SAY_TABLE_CELLS[(r * 2 + k) as usize]);
            n = raw(o, n, "</td>");
            k = k + 1;
        }
        n = raw(o, n, "</tr>\n");
        r = r + 1;
    }
    return raw(o, n, "</tbody>\n</table>\n");
}

/// The five steps, in order.
pub fn render_flow(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<ol class=\"steps\">\n");
    var i : u32 = 0;
    while (i < 5) {
        n = raw(o, n, "<li>");
        n = text(o, n, SAY_FLOW_STEPS[i as usize]);
        n = raw(o, n, "</li>\n");
        i = i + 1;
    }
    return raw(o, n, "</ol>\n");
}

/// The whole page. The flow is the first section, the table the last and the default (a browser without
/// :has needs the default last). OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    n = pk_sec_open(o, n, "flow", false);
    n = render_nav(o, n, true);
    n = pk_h2(o, n, SAY_FLOW_TITLE);
    n = render_flow(o, n);
    n = pk_sec_close(o, n);
    n = pk_sec_open(o, n, "table", true);
    n = render_nav(o, n, false);
    n = render_table(o, n);
    n = pk_sec_close(o, n);
    n = pk_p(o, n, SAY_NOTE);
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_own_spec(out: []u8) -> u32 {
    return render_page(out);
}

; --- tests --------------------------------------------------------------------------------------

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 5;
    assert K_FLOW_STEPS > 1;
}

test the_widget_sends_nothing {
    assert SENDS_NOTHING == true;
}

test the_page_has_a_real_table_and_the_five_steps {
    const n : u32 = page_vc_own_spec(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<table>") == 1;
    assert pk_count(OUT[0..], n, "<caption>") == 1;
    assert pk_count(OUT[0..], n, "<th>") == 2;
    assert pk_count(OUT[0..], n, "<td>") == 8;
    assert pk_count(OUT[0..], n, "<li>") == 5;
    assert pk_has(OUT[0..], n, "<td>1 x 1 x 1 = 1</td>");
    assert pk_has(OUT[0..], n, "<td>after one title the count is 1</td>");
    assert pk_has(OUT[0..], n, "<li>Hand it to the agent</li>");
}

test the_page_has_two_sections_and_the_table_is_the_default {
    const n : u32 = page_vc_own_spec(OUT[0..]);
    assert pk_count(OUT[0..], n, "<section ") == 2;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"flow\">") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"table\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_has(OUT[0..], n, "<a href=\"#flow\">Idea to hand-over</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#table\" class=\"on\">The three parts</a>");
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_own_spec(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"A spec for your own idea: one input, one output, one test\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"Before an agent writes anything, can you name one input, one output and the test that says done? Fill them in for a reading log.\">");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-own-spec/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_own_spec(tiny[0..]) == OVER;
}
