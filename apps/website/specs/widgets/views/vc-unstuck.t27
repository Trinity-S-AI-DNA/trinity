// SPDX-License-Identifier: Apache-2.0
; specs/widgets/views/vc-unstuck.t27 -- lesson 15 of the course "Vibecoding from zero" (specs/course/vibecoding.t27),
; module loop. Source of truth for public/widgets/vc-unstuck/index.html, a page with NO script (FR-106,
; gHashTag/trinity#1807): t27c gen-text compiles this file and runs page_vc_unstuck, whose bytes the workflow
; .github/workflows/emit-widget-pages.yml writes to that path. The widget is a finite-state machine written out
; in full: one <section> per state, a link per transition, the CSS :target selector shows the one the address
; names (the frame is views/page_kit.t27).
; --
; STATE. The streak c: how many times in a row the same error came back, 0 to K_STREAK_MAX. That is
; K_STATE_COUNT = K_STREAK_MAX + 1 = 5 sections, the cap on states is the cap of the streak. The id of a state is
; u and the streak: u0 is the start (the default section, written LAST). The streak picks the move, by the move
; table of the lesson spec specs/vibecoding/unstuck.t27 (held equal by the tests below): 0 and 1 read the error,
; 2 ask for a smaller step, 3 go back to the save point, 4 start a fresh conversation. A longer streak stays at
; the last move, so the streak stops at K_STREAK_MAX.
; TRANSITIONS. "The same error again" goes to the streak plus one, and at K_STREAK_MAX it is a plain label, not
; a link (the cap). "A different error" goes to K_COUNT_AFTER_NEW_ERROR (1) from any state: a new error is a first
; time. "Start again" goes to 0. Each section shows the streak, the four moves with the one the streak selects in
; bold, and that move with its line.
; ASSUMPTION: the interaction is read from the words of the widget that ran as a script before (SAY_SAME,
; SAY_NEW, SAY_RESET, SAY_STREAK): one click is one more error of the same kind or one new kind of error. The
; line SAY_CAP is new; it says why the same-error link stops.
; The card size K_CARD_WIDTH x K_CARD_HEIGHT is the share image of the old widget, kept with its test.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_unstuck;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-unstuck";
pub const TITLE : str = "When you are stuck, the streak picks the move";
pub const DESCRIPTION : str = "Press the same error again and again and watch the advice grow: read it, ask for a smaller step, go back to the save point, start a fresh conversation. A new error resets it.";
pub const IMAGE_ALT : str = "Unstuck card: a ladder of four moves, read the error, ask smaller, go back to the save point, start fresh, with a marker on the rung that the current streak of the same error selects.";
pub const HOOK : str = "The same error three times is not bad luck, it is a signal. Go back to the last save point.";
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: held equal to specs/vibecoding/unstuck.t27 by the tests below
pub const K_MOVE_COUNT : u8 = 4;
pub const K_MOVE_FOR : [5]u8 = [0, 0, 1, 2, 3];
pub const K_STREAK_MAX : u8 = 4;
pub const K_COUNT_AFTER_NEW_ERROR : u8 = 1;
pub const K_STATE_COUNT : u32 = 5;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_MOVES : [4]str = ["Read the error", "Ask for a smaller step", "Go back to the save point", "Start a fresh conversation"];
pub const SAY_MOVE_LINES : [4]str = [
    "Read the whole message and say in your own words what it claims.",
    "Cut the task in half and ask for only the first half.",
    "Return to the last commit that worked and try again from there.",
    "Open a new chat and paste a short summary and the one error."
];
pub const SAY_ASK : str = "How many times in a row has the same error come back?";
pub const SAY_SAME : str = "The same error again";
pub const SAY_NEW : str = "A different error";
pub const SAY_RESET : str = "Start again";
pub const SAY_STREAK : str = "same error in a row: {0}";
pub const SAY_NOTE : str = "A new error is progress: you got past the last one. Only a repeat means you are going round in a circle.";
pub const SAY_CAP : str = "The count stops at {0}: a longer streak keeps the last move.";
pub const SAY_SOURCE : str = "Rules: t27 spec vibecoding/unstuck.t27";

pub var OUT : [32768]u8 = [0; 32768];

; --- the transitions: the whole logic of the widget, one place ---------------------------------

/// The move a streak of c selects: the move table of the lesson, a longer streak stays at the last move.
pub fn un_move(c: u32) -> u32 {
    var i : u32 = c;
    if (i > (K_STREAK_MAX as u32)) { i = K_STREAK_MAX as u32; }
    return K_MOVE_FOR[i as usize] as u32;
}

/// May "the same error again" count one more: not at the cap.
pub fn un_can_count(c: u32) -> bool {
    return c < (K_STREAK_MAX as u32);
}

/// The streak after "the same error again": one more, and the cap stays the cap.
pub fn un_next_same(c: u32) -> u32 {
    if (!un_can_count(c)) { return K_STREAK_MAX as u32; }
    return c + 1;
}

/// The streak after "a different error": a first time, from any streak.
pub fn un_next_new() -> u32 {
    return K_COUNT_AFTER_NEW_ERROR as u32;
}

; --- the page ---------------------------------------------------------------------------------

/// The id of a state: u and the streak.
pub fn un_state_id(o: []u8, n0: u32, c: u32) -> u32 {
    var n : u32 = raw(o, n0, "u");
    return num(o, n, c as u64);
}

/// A link to a state, or the plain label when there is nothing to go to.
pub fn un_link(o: []u8, n0: u32, c: u32, label: []const u8, live: bool) -> u32 {
    var n : u32 = n0;
    if (!live) {
        n = raw(o, n, "<span class=\"off\">");
        n = text(o, n, label);
        return raw(o, n, "</span> ");
    }
    n = raw(o, n, "<a href=\"#");
    n = un_state_id(o, n, c);
    n = raw(o, n, "\">");
    n = text(o, n, label);
    return raw(o, n, "</a> ");
}

/// One section: the streak, the ladder of four moves with the selected one in bold, that move with its line, the three links.
pub fn render_state(o: []u8, n0: u32, c: u32) -> u32 {
    var n : u32 = pk_sec_begin(o, n0, c == 0);
    n = un_state_id(o, n, c);
    n = pk_sec_body(o, n);
    var digits : [20]u8 = [0; 20];
    var ld : u32 = dec_to(digits[0..], c as u64);
    n = raw(o, n, "<div class=\"box\"><p class=\"big\">");
    n = fill(o, n, SAY_STREAK, digits[0..(ld as usize)], "", "", 1);
    n = raw(o, n, "</p></div>\n<ol class=\"steps\">\n");
    var m : u32 = 0;
    while (m < 4) {
        if (m == un_move(c)) {
            n = raw(o, n, "<li><b>");
            n = text(o, n, SAY_MOVES[m as usize]);
            n = raw(o, n, "</b></li>\n");
        } else {
            n = raw(o, n, "<li>");
            n = text(o, n, SAY_MOVES[m as usize]);
            n = raw(o, n, "</li>\n");
        }
        m = m + 1;
    }
    n = raw(o, n, "</ol>\n<div class=\"box dash\"><p class=\"big\">");
    n = text(o, n, SAY_MOVES[un_move(c) as usize]);
    n = raw(o, n, "</p><p>");
    n = text(o, n, SAY_MOVE_LINES[un_move(c) as usize]);
    n = raw(o, n, "</p></div>\n<p class=\"nav\">");
    n = un_link(o, n, un_next_same(c), SAY_SAME, un_can_count(c));
    n = un_link(o, n, un_next_new(), SAY_NEW, true);
    n = un_link(o, n, 0, SAY_RESET, true);
    n = raw(o, n, "</p>\n");
    return pk_sec_close(o, n);
}

/// The whole page. Streaks 1 to the cap first, streak 0 last: the default is the last section, as a browser
/// without :has needs. OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    n = pk_p(o, n, SAY_ASK);
    var c : u32 = 1;
    while (c <= (K_STREAK_MAX as u32)) {
        n = render_state(o, n, c);
        c = c + 1;
    }
    n = render_state(o, n, 0);
    n = pk_p(o, n, SAY_NOTE);
    var digits : [20]u8 = [0; 20];
    var lc : u32 = dec_to(digits[0..], K_STREAK_MAX as u64);
    n = raw(o, n, "<p class=\"muted\">");
    n = fill(o, n, SAY_CAP, digits[0..(lc as usize)], "", "", 1);
    n = raw(o, n, "</p>\n");
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_unstuck(out: []u8) -> u32 {
    return render_page(out);
}

/// Is the last <section of the first n bytes the default one?
pub fn un_default_is_last(o: []const u8, n: u32) -> bool {
    var i : u32 = n;
    while (i > 0) {
        i = i - 1;
        if (pk_match_at(o, n, i, "<section ")) {
            return pk_match_at(o, n, i, "<section class=\"s d\"");
        }
    }
    return false;
}

; --- tests --------------------------------------------------------------------------------------

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_widget_sends_nothing {
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == false;
}

test the_moves_match_the_lesson_spec {
    assert K_MOVE_FOR[0] == 0;
    assert K_MOVE_FOR[2] == 1;
    assert K_MOVE_FOR[3] == 2;
    assert K_MOVE_FOR[K_STREAK_MAX] == K_MOVE_COUNT - 1;
    assert K_MOVE_FOR[K_COUNT_AFTER_NEW_ERROR] == 0;
}

test every_move_has_a_name_and_a_line {
    assert SAY_MOVES[3] == "Start a fresh conversation";
    assert SAY_MOVE_LINES[3] == "Open a new chat and paste a short summary and the one error.";
}

test the_streak_picks_the_move_of_the_table {
    assert un_move(0) == 0;
    assert un_move(1) == 0;
    assert un_move(2) == 1;
    assert un_move(3) == 2;
    assert un_move(4) == 3;
    assert un_move(9) == 3;
}

test the_streak_counts_up_to_the_cap_and_stops {
    assert un_next_same(0) == 1;
    assert un_next_same(3) == 4;
    assert un_next_same(4) == 4;
    assert un_can_count(3) == true;
    assert un_can_count(4) == false;
}

test a_new_error_is_a_first_time {
    assert un_next_new() == 1;
    assert un_move(un_next_new()) == 0;
}

test the_states_are_the_streaks_zero_to_the_cap {
    assert K_STATE_COUNT == (K_STREAK_MAX as u32) + 1;
    assert K_STATE_COUNT == 5;
}

test every_transition_lands_on_a_state_of_the_page {
    var bad : u32 = 0;
    var c : u32 = 0;
    while (c <= (K_STREAK_MAX as u32)) {
        if (un_next_same(c) >= K_STATE_COUNT) { bad = bad + 1; }
        if (un_next_new() >= K_STATE_COUNT) { bad = bad + 1; }
        if (un_move(c) >= (K_MOVE_COUNT as u32)) { bad = bad + 1; }
        c = c + 1;
    }
    assert bad == 0;
}

test the_page_has_one_section_per_streak_and_the_start_is_the_default_and_last {
    const n : u32 = page_vc_unstuck(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<section ") == 5;
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"u0\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"u1\">") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"u4\">") == 1;
    assert un_default_is_last(OUT[0..], n);
}

test every_section_shows_its_streak {
    const n : u32 = page_vc_unstuck(OUT[0..]);
    assert pk_count(OUT[0..], n, "same error in a row: 0") == 1;
    assert pk_count(OUT[0..], n, "same error in a row: 1") == 1;
    assert pk_count(OUT[0..], n, "same error in a row: 2") == 1;
    assert pk_count(OUT[0..], n, "same error in a row: 3") == 1;
    assert pk_count(OUT[0..], n, "same error in a row: 4") == 1;
}

test the_selected_move_is_in_bold_in_the_ladder {
    const n : u32 = page_vc_unstuck(OUT[0..]);
    assert pk_count(OUT[0..], n, "<li><b>Read the error</b></li>") == 2;
    assert pk_count(OUT[0..], n, "<li><b>Ask for a smaller step</b></li>") == 1;
    assert pk_count(OUT[0..], n, "<li><b>Go back to the save point</b></li>") == 1;
    assert pk_count(OUT[0..], n, "<li><b>Start a fresh conversation</b></li>") == 1;
    assert pk_count(OUT[0..], n, "<ol class=\"steps\">") == 5;
    assert pk_count(OUT[0..], n, "Open a new chat and paste a short summary") == 1;
}

test the_links_go_to_the_next_streak_and_the_cap_stops_the_same_link {
    const n : u32 = page_vc_unstuck(OUT[0..]);
    assert pk_count(OUT[0..], n, "<a href=\"#u1\">The same error again</a>") == 1;
    assert pk_count(OUT[0..], n, "<a href=\"#u4\">The same error again</a>") == 1;
    assert pk_count(OUT[0..], n, "<span class=\"off\">The same error again</span>") == 1;
    assert pk_count(OUT[0..], n, "<a href=\"#u1\">A different error</a>") == 5;
    assert pk_count(OUT[0..], n, "<a href=\"#u0\">Start again</a>") == 5;
    assert pk_has(OUT[0..], n, "The count stops at 4");
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_unstuck(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"When you are stuck, the streak picks the move\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"The same error three times is not bad luck");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-unstuck/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_unstuck(tiny[0..]) == OVER;
    assert render_page(tiny[0..]) == OVER;
}
