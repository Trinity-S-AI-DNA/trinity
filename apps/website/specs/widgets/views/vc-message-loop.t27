// SPDX-License-Identifier: Apache-2.0
; specs/widgets/views/vc-message-loop.t27 -- a toy bot you talk to: watch the message loop turn. Lesson 1 of the
; module "A first bot" of the course "Vibecoding from zero" (specs/course/vibecoding.t27). Source of truth for
; public/widgets/vc-message-loop/index.html, a page with NO script (FR-106, gHashTag/trinity#1807): t27c
; gen-text compiles this file and runs page_vc_message_loop, whose bytes the workflow
; .github/workflows/emit-widget-pages.yml writes to that path. The widget is a finite-state machine written out
; in full: one <section> per state, a link per transition, the CSS :target selector shows the one the address
; names (the frame is views/page_kit.t27). The lesson spec it illustrates: specs/vibecoding/message_loop.t27.
; --
; STATE. (t, m): t the turn, 0 to K_CAP, m the message sent at that turn, 0 blah (a word the bot does not
; know), 1 start, 2 help, 3 stop. The state (0, 0) is the start: nothing sent yet. Every turn shows the four
; beats of the loop and, from the first turn on, the log line of the turn: what you sent and what the bot
; said. A message link goes from (t, m) to (t + 1, the message chosen). The reply is K_REPLY_TABLE[m] of the
; lesson: 90, 10, 20, and 0 for stop; a reply of 0 means no reply and the loop ends (SAY_STOPPED), so a
; stopped state has no message links, only the link to start again. The loop can run as long as the reader
; likes, so the page follows at most K_CAP turns; at the cap the message links are plain labels.
; WHAT IT DOES NOT CLAIM: it is not a real chat bot and talks to no network; the reply table is the one of
; the lesson spec, four slots long. Nothing is sent anywhere. The page keeps the last turn, not the whole
; conversation: a log of every turn would need a state for every conversation.
; ASSUMPTION: the interaction is read from the words of the widget that ran as a script before (SAY_PICK_LABEL,
; SAY_MSG_NAMES, SAY_BEATS, SAY_TURN, SAY_BOT_SAYS, SAY_STOPPED, SAY_RESTART, SAY_LOG_TITLE): one click on a
; message name is one turn of the loop.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_message_loop;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-message-loop";
pub const TITLE : str = "A bot is a loop: send messages, watch it answer";
pub const DESCRIPTION : str = "Send start, help or an unknown word to a toy bot and watch the four beats of its message loop: wait, read, reply, wait again. A stop message ends it. Nothing is sent.";
pub const IMAGE_ALT : str = "A black and white loop diagram with four boxes in a ring: wait for a message, read it, pick a reply from the table, send it; an arrow leaves the ring at the stop message.";
pub const HOOK : str = "A bot is a loop that answers one message at a time. Send it a few and watch each turn.";
pub const SENDS_NOTHING : bool = true;

; --- Numbers the tool relies on ------------------------------------------------------------
; Messages: 0 unknown, 1 start, 2 help, 3 stop. The reply for each, 0 meaning none.
pub const K_MSG_COUNT : u8 = 4;
pub const K_STOP_MSG : u8 = 3;
pub const K_REPLY_TABLE : [4]u8 = [90, 10, 20, 0];
pub const K_BEAT_COUNT : u8 = 4;
pub const K_CAP : u32 = 12;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PICK_LABEL : str = "Send a message to the bot";
pub const SAY_MSG_NAMES : [4]str = ["blah", "start", "help", "stop"];
pub const SAY_REPLY_TEXTS : [4]str = ["I did not understand that.", "Hello! I am a first bot.", "Try start, help or stop.", ""];
pub const SAY_BEATS : [4]str = ["Wait for a message", "Read it", "Pick the reply from the table", "Send the reply"];
pub const SAY_TURN : str = "Turn {0}: you sent {1}";
pub const SAY_BOT_SAYS : str = "The bot says: {0}";
pub const SAY_STOPPED : str = "A stop message: the loop ends and nothing is sent back.";
pub const SAY_RESTART : str = "Start the loop again";
pub const SAY_LOG_TITLE : str = "What the bot answered";
pub const SAY_NOTE : str = "The same message always gets the same reply: the reply depends on the message alone.";
pub const SAY_CAP : str = "This page follows up to {0} turns, then the message links stop.";
pub const SAY_SOURCE : str = "Rules: t27 spec vibecoding/message_loop.t27";

pub var OUT : [65536]u8 = [0; 65536];

; --- the transitions: the whole logic of the widget, one place ---------------------------------

/// The reply of the table for message m: 90, 10, 20, and 0 (none) for stop.
pub fn msg_reply(m: u32) -> u32 {
    return K_REPLY_TABLE[m as usize] as u32;
}

/// Does message m end the loop: it gets no reply.
pub fn msg_is_stop(m: u32) -> bool {
    return msg_reply(m) == 0;
}

/// May a message link do something: not after a stop, not at the cap.
pub fn msg_can_send(t: u32, m: u32, cap: u32) -> bool {
    if (msg_is_stop(m)) { return false; }
    return t < cap;
}

/// The number of states with at most cap turns: the start, and every message at every turn 1 to cap.
pub fn msg_state_count(cap: u32) -> u32 {
    var c : u32 = 1;
    var t : u32 = 1;
    while (t <= cap) {
        c = c + 4;
        t = t + 1;
    }
    return c;
}

; --- the page ---------------------------------------------------------------------------------

/// The id of a state: t, the turn, -, the message.
pub fn msg_id(o: []u8, n0: u32, t: u32, m: u32) -> u32 {
    var n : u32 = raw(o, n0, "t");
    n = num(o, n, t as u64);
    n = raw(o, n, "-");
    return num(o, n, m as u64);
}

/// A link to a state, or the plain label when there is nothing to go to.
pub fn msg_link(o: []u8, n0: u32, t: u32, m: u32, label: []const u8, live: bool, on: bool) -> u32 {
    var n : u32 = n0;
    if (!live) {
        n = raw(o, n, "<span class=\"off\">");
        n = text(o, n, label);
        return raw(o, n, "</span> ");
    }
    n = raw(o, n, "<a href=\"#");
    n = msg_id(o, n, t, m);
    if (on) { n = raw(o, n, "\" class=\"on\">"); } else { n = raw(o, n, "\">"); }
    n = text(o, n, label);
    return raw(o, n, "</a> ");
}

/// One section: the four beats, the log line of the turn, and the links.
pub fn msg_render_state(o: []u8, n0: u32, t: u32, m: u32, cap: u32) -> u32 {
    var n : u32 = pk_sec_begin(o, n0, t == 0);
    n = msg_id(o, n, t, m);
    n = pk_sec_body(o, n);
    n = raw(o, n, "<ol class=\"steps\">\n");
    var i : u32 = 0;
    while (i < 4) {
        n = pk_li(o, n, SAY_BEATS[i as usize], "");
        i = i + 1;
    }
    n = raw(o, n, "</ol>\n");
    var digits : [20]u8 = [0; 20];
    var la : u32 = dec_to(digits[0..], t as u64);
    if (t > 0) {
        n = pk_h2(o, n, SAY_LOG_TITLE);
        n = raw(o, n, "<div class=\"box\"><p class=\"big\">");
        n = fill(o, n, SAY_TURN, digits[0..(la as usize)], SAY_MSG_NAMES[m as usize], "", 2);
        n = raw(o, n, "</p>");
        if (msg_is_stop(m)) {
            n = pk_p(o, n, SAY_STOPPED);
        } else {
            n = raw(o, n, "<p>");
            n = fill(o, n, SAY_BOT_SAYS, SAY_REPLY_TEXTS[m as usize], "", "", 1);
            n = raw(o, n, "</p>\n");
        }
        n = raw(o, n, "</div>\n");
    }
    if (!msg_is_stop(m)) { n = pk_p(o, n, SAY_PICK_LABEL); }
    n = raw(o, n, "<p class=\"nav\">");
    var j : u32 = 0;
    if (!msg_is_stop(m)) {
        while (j < 4) {
            n = msg_link(o, n, t + 1, j, SAY_MSG_NAMES[j as usize], msg_can_send(t, m, cap), false);
            j = j + 1;
        }
    }
    if (t > 0) { n = msg_link(o, n, 0, 0, SAY_RESTART, true, false); }
    n = raw(o, n, "</p>\n");
    return pk_sec_close(o, n);
}

/// The whole page for a cap. Every state except t0-0 first, t0-0 last: the default is the last section, as
/// a browser without :has needs. OVER when it did not fit.
pub fn render_page(o: []u8, cap: u32) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    var t : u32 = 1;
    while (t <= cap) {
        var m : u32 = 0;
        while (m < 4) {
            n = msg_render_state(o, n, t, m, cap);
            m = m + 1;
        }
        t = t + 1;
    }
    n = msg_render_state(o, n, 0, 0, cap);
    n = pk_p(o, n, SAY_NOTE);
    var digits : [20]u8 = [0; 20];
    var lc : u32 = dec_to(digits[0..], cap as u64);
    n = raw(o, n, "<p class=\"muted\">");
    n = fill(o, n, SAY_CAP, digits[0..(lc as usize)], "", "", 1);
    n = raw(o, n, "</p>\n");
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_message_loop(out: []u8) -> u32 {
    return render_page(out, K_CAP);
}

; --- tests --------------------------------------------------------------------------------------

test the_table_has_a_slot_for_every_message {
    assert K_MSG_COUNT == 4;
    assert K_REPLY_TABLE[3] == 0;
    assert K_STOP_MSG == K_MSG_COUNT - 1;
}

test the_four_beats_are_all_named {
    assert K_BEAT_COUNT == 4;
    assert SAY_BEATS[3] == "Send the reply";
}

test two_commands_never_share_a_reply {
    assert K_REPLY_TABLE[1] != K_REPLY_TABLE[2];
    assert K_REPLY_TABLE[1] != K_REPLY_TABLE[0];
}

test the_page_sends_nothing {
    assert SENDS_NOTHING == true;
}

test the_reply_table_matches_the_lesson_spec {
    assert msg_reply(0) == 90;
    assert msg_reply(1) == 10;
    assert msg_reply(2) == 20;
    assert msg_reply(3) == 0;
    assert SAY_MSG_NAMES[1] == "start";
    assert SAY_MSG_NAMES[3] == "stop";
}

test the_state_counts_for_the_three_caps {
    assert msg_state_count(6) == 25;
    assert msg_state_count(12) == 49;
    assert msg_state_count(24) == 97;
}

test a_stop_message_ends_the_loop {
    assert msg_is_stop(3) == true;
    assert msg_is_stop(0) == false;
    assert msg_is_stop(1) == false;
    assert msg_is_stop(2) == false;
    assert msg_can_send(5, 3, 12) == false;
    assert msg_can_send(0, 0, 12) == true;
    assert msg_can_send(5, 1, 12) == true;
}

test the_cap_stops_the_message_links {
    assert msg_can_send(11, 1, 12) == true;
    assert msg_can_send(12, 1, 12) == false;
    assert msg_can_send(12, 0, 12) == false;
}

test every_transition_lands_on_a_state_of_the_page {
    var bad : u32 = 0;
    var t : u32 = 0;
    while (t <= 12) {
        var m : u32 = 0;
        while (m < 4) {
            if (msg_can_send(t, m, 12)) {
                if (t + 1 > 12) { bad = bad + 1; }
            }
            m = m + 1;
        }
        t = t + 1;
    }
    assert bad == 0;
}

test the_page_has_one_section_per_state_and_one_default {
    const n : u32 = page_vc_message_loop(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<section ") == 49;
    assert pk_count(OUT[0..], n, "<section ") == msg_state_count(12);
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"t0-0\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"t12-3\">") == 1;
}

test a_smaller_cap_writes_fewer_sections {
    const n : u32 = render_page(OUT[0..], 6);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<section ") == 25;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_message_loop(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"A bot is a loop: send messages, watch it answer\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"A bot is a loop that answers one message at a time.");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-message-loop/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_state_page_shows_its_log_line_and_links {
    const n : u32 = page_vc_message_loop(OUT[0..]);
    assert pk_has(OUT[0..], n, "Turn 1: you sent start");
    assert pk_has(OUT[0..], n, "Turn 12: you sent blah");
    assert pk_has(OUT[0..], n, "The bot says: Hello! I am a first bot.");
    assert pk_has(OUT[0..], n, "The bot says: I did not understand that.");
    assert pk_has(OUT[0..], n, "The bot says: Try start, help or stop.");
    assert pk_has(OUT[0..], n, "A stop message: the loop ends and nothing is sent back.");
    assert pk_has(OUT[0..], n, "<a href=\"#t1-1\">start</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#t1-3\">stop</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#t12-0\">blah</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#t0-0\">Start the loop again</a>");
    assert pk_has(OUT[0..], n, "<span class=\"off\">start</span>");
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_message_loop(tiny[0..]) == OVER;
    assert render_page(tiny[0..], 6) == OVER;
}
