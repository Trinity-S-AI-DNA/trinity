// SPDX-License-Identifier: Apache-2.0
; specs/widgets/views/vc-the-loop.t27 -- lesson 14 of the course "Vibecoding from zero" (specs/course/vibecoding.t27),
; module loop. Source of truth for public/widgets/vc-the-loop/index.html, a page with NO script (FR-106,
; gHashTag/trinity#1807): t27c gen-text compiles this file and runs page_vc_the_loop, whose bytes the
; workflow .github/workflows/emit-widget-pages.yml writes to that path. The widget is a finite-state machine
; written out in full: one <section> per state, a link per transition, the CSS :target selector shows the one
; the address names (the frame is views/page_kit.t27).
; --
; STATE. (h, k, sw): h honest rounds, 0 to 3, each reads the result and fixes one problem, so the problems left
; are K_ROUND_STATE[h]; k rounds run with the reading skipped, they fix nothing; sw is the switch "Skip the
; reading". Rounds in all: h + k. The switch makes skipping unbounded, so the page follows at most K_CAP rounds;
; at the cap, or when green (h = 3), the round link is a plain label. The round table is the one of
; specs/vibecoding/the_loop.t27 (held equal by the tests below).
; ASSUMPTION: the interaction is read from the words of the widget that ran as a script before (SAY_ROUND,
; SAY_SKIP_READ, SAY_RESET, SAY_LEFT, SAY_ROUNDS, SAY_GREEN, SAY_SKIPPED): one click on the round link is one
; whole round, and the four steps are listed in every state.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_the_loop;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-the-loop";
pub const TITLE : str = "Ask, run, read, fix";
pub const DESCRIPTION : str = "Run rounds of ask, run, read and fix on a program with three problems. Each round fixes one thing. Switch the reading off and the problems stay hidden.";
pub const IMAGE_ALT : str = "Loop card: four steps in a circle, ask, run, read and fix, and a counter of problems left that falls from 3 to 0 across three rounds. A second row shows the same loop with the read step crossed out and the counter stuck.";
pub const HOOK : str = "Three problems, three rounds: ask, run, read, fix one thing, and run again. Skip the reading and you cannot tell.";
pub const SENDS_NOTHING : bool = true;

; --- Numbers: held equal to specs/vibecoding/the_loop.t27 by the tests below
pub const K_STEPS_PER_ROUND : u8 = 4;
pub const K_START_PROBLEMS : u8 = 3;
pub const K_ROUND_STATE : [4]u8 = [3, 2, 1, 0];
pub const K_CAP : u32 = 12;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_STEPS : [4]str = ["Ask", "Run", "Read", "Fix"];
pub const SAY_STEP_LINES : [4]str = [
    "Tell the agent one thing to change.",
    "Run the program or the tests.",
    "Read what came back, all of it.",
    "Fix one problem, then go round again."
];
pub const SAY_ASK : str = "How many rounds until the program is green?";
pub const SAY_ROUND : str = "Run one round";
pub const SAY_SKIP_READ : str = "Skip the reading";
pub const SAY_RESET : str = "Start again";
pub const SAY_LEFT : str = "problems left: {0}";
pub const SAY_ROUNDS : str = "rounds: {0}";
pub const SAY_GREEN : str = "Green. Every problem was found by reading the result.";
pub const SAY_SKIPPED : str = "You did not read the result, so you do not know what is left.";
pub const SAY_NOTE : str = "One round, one fix. Fixing three things at once makes the next error hard to place.";
pub const SAY_CAP : str = "This page follows up to {0} rounds, then the round link stops.";
pub const SAY_SOURCE : str = "Rules: t27 spec vibecoding/the_loop.t27";

pub var OUT : [131072]u8 = [0; 131072];

; --- the transitions: the whole logic of the widget, one place ---------------------------------

/// Problems left after h honest rounds: the round table of the lesson.
pub fn problems_after(h: u32) -> u32 {
    if (h >= 3) { return 0; }
    return K_ROUND_STATE[h as usize] as u32;
}

/// May the round link do something: not when green, not at the cap.
pub fn can_run(h: u32, k: u32, cap: u32) -> bool {
    if (h >= 3) { return false; }
    return h + k < cap;
}

/// Honest rounds after one click on the round link.
pub fn next_h(h: u32, k: u32, sw: u32, cap: u32) -> u32 {
    if (!can_run(h, k, cap)) { return h; }
    if (sw == 1) { return h; }
    return h + 1;
}

/// Skipped rounds after one click on the round link.
pub fn next_k(h: u32, k: u32, sw: u32, cap: u32) -> u32 {
    if (!can_run(h, k, cap)) { return k; }
    if (sw == 1) { return k + 1; }
    return k;
}

/// The number of states with at most cap rounds: h 0 to 3, k up to cap - h, the switch on or off.
pub fn state_count(cap: u32) -> u32 {
    var c : u32 = 0;
    var h : u32 = 0;
    while (h <= 3) {
        var k : u32 = 0;
        while (h + k <= cap) {
            c = c + 2;
            k = k + 1;
        }
        h = h + 1;
    }
    return c;
}

; --- the page ---------------------------------------------------------------------------------

/// The id of a state: s, h, -, k, -, sw.
pub fn state_id(o: []u8, n0: u32, h: u32, k: u32, sw: u32) -> u32 {
    var n : u32 = raw(o, n0, "s");
    n = num(o, n, h as u64);
    n = raw(o, n, "-");
    n = num(o, n, k as u64);
    n = raw(o, n, "-");
    return num(o, n, sw as u64);
}

/// A link to a state, or the plain label when there is nothing to go to.
pub fn link_to(o: []u8, n0: u32, h: u32, k: u32, sw: u32, label: []const u8, live: bool, on: bool) -> u32 {
    var n : u32 = n0;
    if (!live) {
        n = raw(o, n, "<span class=\"off\">");
        n = text(o, n, label);
        return raw(o, n, "</span> ");
    }
    n = raw(o, n, "<a href=\"#");
    n = state_id(o, n, h, k, sw);
    if (on) { n = raw(o, n, "\" class=\"on\">"); } else { n = raw(o, n, "\">"); }
    n = text(o, n, label);
    return raw(o, n, "</a> ");
}

/// One section: the four steps, the two counters, the verdict line, and the three links.
pub fn render_state(o: []u8, n0: u32, h: u32, k: u32, sw: u32, cap: u32) -> u32 {
    var n : u32 = pk_sec_begin(o, n0, h == 0 and k == 0 and sw == 0);
    n = state_id(o, n, h, k, sw);
    n = pk_sec_body(o, n);
    n = raw(o, n, "<ol class=\"steps\">\n");
    var i : u32 = 0;
    while (i < 4) {
        n = pk_li(o, n, SAY_STEPS[i as usize], SAY_STEP_LINES[i as usize]);
        i = i + 1;
    }
    n = raw(o, n, "</ol>\n<div class=\"box\"><p class=\"big\">");
    var digits : [20]u8 = [0; 20];
    var la : u32 = dec_to(digits[0..], problems_after(h) as u64);
    n = fill(o, n, SAY_LEFT, digits[0..(la as usize)], "", "", 1);
    n = raw(o, n, "</p><p>");
    var lb : u32 = dec_to(digits[0..], (h + k) as u64);
    n = fill(o, n, SAY_ROUNDS, digits[0..(lb as usize)], "", "", 1);
    n = raw(o, n, "</p>");
    if (h >= 3) {
        n = pk_p(o, n, SAY_GREEN);
    } else {
        if (k > 0) { n = pk_p(o, n, SAY_SKIPPED); }
    }
    n = raw(o, n, "</div>\n<p class=\"nav\">");
    n = link_to(o, n, next_h(h, k, sw, cap), next_k(h, k, sw, cap), sw, SAY_ROUND, can_run(h, k, cap), false);
    n = link_to(o, n, h, k, 1 - sw, SAY_SKIP_READ, true, sw == 1);
    n = link_to(o, n, 0, 0, 0, SAY_RESET, true, false);
    n = raw(o, n, "</p>\n");
    return pk_sec_close(o, n);
}

/// The whole page for a cap. Every state except s0-0-0 first, s0-0-0 last: the default is the last
/// section, as a browser without :has needs. OVER when it did not fit.
pub fn render_page(o: []u8, cap: u32) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    n = pk_p(o, n, SAY_ASK);
    var h : u32 = 0;
    while (h <= 3) {
        var k : u32 = 0;
        while (h + k <= cap) {
            var sw : u32 = 0;
            while (sw <= 1) {
                if (!(h == 0 and k == 0 and sw == 0)) { n = render_state(o, n, h, k, sw, cap); }
                sw = sw + 1;
            }
            k = k + 1;
        }
        h = h + 1;
    }
    n = render_state(o, n, 0, 0, 0, cap);
    n = pk_p(o, n, SAY_NOTE);
    var digits : [20]u8 = [0; 20];
    var lc : u32 = dec_to(digits[0..], cap as u64);
    n = raw(o, n, "<p class=\"muted\">");
    n = fill(o, n, SAY_CAP, digits[0..(lc as usize)], "", "", 1);
    n = raw(o, n, "</p>\n");
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_the_loop(out: []u8) -> u32 {
    return render_page(out, K_CAP);
}

; --- tests --------------------------------------------------------------------------------------

test the_widget_sends_nothing {
    assert SENDS_NOTHING == true;
}

test the_rounds_match_the_lesson_spec {
    assert K_ROUND_STATE[0] == K_START_PROBLEMS;
    assert K_ROUND_STATE[K_START_PROBLEMS] == 0;
    assert K_ROUND_STATE[1] + 1 == K_ROUND_STATE[0];
    assert K_ROUND_STATE[2] + 1 == K_ROUND_STATE[1];
    assert K_STEPS_PER_ROUND == 4;
    assert SAY_STEPS[3] == "Fix";
}

test the_state_counts_for_the_three_caps {
    assert state_count(6) == 44;
    assert state_count(12) == 92;
    assert state_count(24) == 188;
}

test three_honest_rounds_reach_green {
    var h : u32 = 0;
    var k : u32 = 0;
    var i : u32 = 0;
    while (i < 3) {
        const nh : u32 = next_h(h, k, 0, 12);
        const nk : u32 = next_k(h, k, 0, 12);
        h = nh;
        k = nk;
        i = i + 1;
    }
    assert h == 3;
    assert k == 0;
    assert problems_after(h) == 0;
    assert can_run(h, k, 12) == false;
}

test skipping_the_reading_fixes_nothing {
    assert next_h(0, 0, 1, 12) == 0;
    assert next_k(0, 0, 1, 12) == 1;
    assert problems_after(0) == 3;
}

test the_cap_stops_the_round_link {
    assert can_run(0, 11, 12) == true;
    assert can_run(0, 12, 12) == false;
    assert next_k(0, 12, 1, 12) == 12;
}

test every_transition_lands_on_a_state_of_the_page {
    var bad : u32 = 0;
    var h : u32 = 0;
    while (h <= 3) {
        var k : u32 = 0;
        while (h + k <= 12) {
            var sw : u32 = 0;
            while (sw <= 1) {
                if (next_h(h, k, sw, 12) + next_k(h, k, sw, 12) > 12) { bad = bad + 1; }
                if (next_h(h, k, sw, 12) > 3) { bad = bad + 1; }
                sw = sw + 1;
            }
            k = k + 1;
        }
        h = h + 1;
    }
    assert bad == 0;
}

test the_page_has_one_section_per_state_and_one_default {
    const n : u32 = page_vc_the_loop(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<section ") == 92;
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"s0-0-0\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"s3-0-0\">") == 1;
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_the_loop(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"Ask, run, read, fix\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"Three problems, three rounds");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-the-loop/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_state_page_shows_its_counters_and_links {
    const n : u32 = page_vc_the_loop(OUT[0..]);
    assert pk_has(OUT[0..], n, "problems left: 3");
    assert pk_has(OUT[0..], n, "problems left: 0");
    assert pk_has(OUT[0..], n, "<a href=\"#s1-0-0\">Run one round</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#s0-1-1\">Run one round</a>");
    assert pk_has(OUT[0..], n, "<span class=\"off\">Run one round</span>");
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_the_loop(tiny[0..]) == OVER;
    assert render_page(tiny[0..], 6) == OVER;
}
