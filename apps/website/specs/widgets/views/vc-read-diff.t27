// SPDX-License-Identifier: Apache-2.0
; specs/widgets/views/vc-read-diff.t27 -- read a diff against what you asked for before you accept it. Lesson 18
; of the course "Vibecoding from zero" (specs/course/vibecoding.t27). Source of truth for
; public/widgets/vc-read-diff/index.html, a page with NO script (FR-106, gHashTag/trinity#1807): t27c gen-text
; compiles this file and runs page_vc_read_diff, whose bytes the workflow
; .github/workflows/emit-widget-pages.yml writes to that path. The widget is a finite-state machine written
; out in full: one <section> per state, a link per transition, the CSS :target selector shows the one the
; address names (the frame is views/page_kit.t27). The lesson spec is specs/vibecoding/read_diff.t27.
; --
; STATE. (a, b): the decision on diff A and on diff B, each 0 not decided yet, 1 accepted, 2 sent back. Three
; times three, nine states, so the page needs no cap on steps: a click on Accept or Send back changes the
; decision of that diff only, and a decision can be changed again, so no state is a dead end. Both diffs
; stand in every state as lists of touched lines; a line outside the request (outside_the_ask of the lesson:
; below K_ASK_FROM or above K_ASK_TO) is marked in large type. The right decision of a diff is Accept when
; no touched line is outside the request and Send back when one is: diff A, K_CLEAN_DIFF, is accepted, diff B,
; K_SPRAWLING_DIFF with its line 40, is sent back. The verdict line of a diff shows once it is decided.
; WHAT IT DOES NOT CLAIM: that a diff inside the range is correct; it only says the agent kept to what was
; asked, and the tests still decide whether the change works.
; ASSUMPTION: the interaction is read from the words of the widget that ran as a script before (SAY_ACCEPT,
; SAY_SEND_BACK, SAY_RIGHT_A, SAY_RIGHT_B, SAY_WRONG): each diff has its own two links, and the verdict
; follows the decision.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_read_diff;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-read-diff";
pub const TITLE : str = "Vibecoding 18: read the diff before you accept it";
pub const DESCRIPTION : str = "Two diffs, one request: see which touched lines fall outside what you asked for, and accept one diff and send the other back. Lesson 18 of the vibecoding course.";
pub const IMAGE_ALT : str = "A black and white card: a request to change lines 10 to 20; one diff touches lines 10, 12, 15 and 20 and is accepted; another touches 12, 13, 14 and 40, line 40 is marked outside the request, and it is sent back.";
pub const HOOK : str = "The agent said done. Read what it touched before you say yes.";
pub const SENDS_NOTHING : bool = true;

; --- Numbers: held equal to specs/vibecoding/read_diff.t27 by the tests below
pub const K_ASK_FROM : u8 = 10;
pub const K_ASK_TO : u8 = 20;
pub const K_CLEAN_DIFF : [4]u8 = [10, 12, 15, 20];
pub const K_SPRAWLING_DIFF : [4]u8 = [12, 13, 14, 40];
pub const K_FILE_LINES : u8 = 50;
pub const K_STATES : u32 = 9;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_ASK : str = "You asked: change lines {0} to {1}";
pub const SAY_DIFF_NAMES : [2]str = ["Diff A", "Diff B"];
pub const SAY_TOUCHED : str = "Touched lines";
pub const SAY_INSIDE : str = "inside the request";
pub const SAY_OUTSIDE : str = "outside the request";
pub const SAY_ACCEPT : str = "Accept";
pub const SAY_SEND_BACK : str = "Send back";
pub const SAY_RIGHT_A : str = "Right: every touched line is something you asked for.";
pub const SAY_RIGHT_B : str = "Right: line 40 is a change nobody asked for. Ask why, or send it back.";
pub const SAY_WRONG : str = "Look at the touched lines again, next to the request.";
pub const SAY_NOTE : str = "Inside the request is not the same as correct: the tests still decide that.";
pub const SAY_SOURCE : str = "Logic: t27 spec specs/vibecoding/read_diff.t27";

pub var OUT : [32768]u8 = [0; 32768];

; --- the transitions: the whole logic of the widget, one place ---------------------------------

/// Is this touched line outside the request: the check of the lesson, outside_the_ask.
pub fn diff_outside(line: u32) -> bool {
    if (line < (K_ASK_FROM as u32)) { return true; }
    return line > (K_ASK_TO as u32);
}

/// Touched line i (0 to 3) of diff which: 0 is diff A, the clean one, 1 is diff B, the sprawling one.
pub fn diff_line(which: u32, i: u32) -> u32 {
    if (which == 0) { return K_CLEAN_DIFF[i as usize] as u32; }
    return K_SPRAWLING_DIFF[i as usize] as u32;
}

/// Does diff which touch a line outside the request?
pub fn diff_has_outside(which: u32) -> bool {
    var i : u32 = 0;
    while (i < 4) {
        if (diff_outside(diff_line(which, i))) { return true; }
        i = i + 1;
    }
    return false;
}

/// The right decision for diff which: 1 accept when no line is outside, 2 send back when one is.
pub fn diff_right(which: u32) -> u32 {
    if (diff_has_outside(which)) { return 2; }
    return 1;
}

/// The verdict on diff which after decision pick: 0 not decided, 1 right, 2 wrong.
pub fn diff_verdict(which: u32, pick: u32) -> u32 {
    if (pick == 0) { return 0; }
    if (pick == diff_right(which)) { return 1; }
    return 2;
}

/// The decision on diff A after a click on diff which with choice 1 (accept) or 2 (send back).
pub fn diff_next_a(which: u32, a: u32, choice: u32) -> u32 {
    if (which == 0) { return choice; }
    return a;
}

/// The decision on diff B after a click on diff which with choice 1 (accept) or 2 (send back).
pub fn diff_next_b(which: u32, b: u32, choice: u32) -> u32 {
    if (which == 1) { return choice; }
    return b;
}

; --- the page ---------------------------------------------------------------------------------

/// The id of a state: d, the decision on diff A, -, the decision on diff B.
pub fn diff_id(o: []u8, n0: u32, a: u32, b: u32) -> u32 {
    var n : u32 = raw(o, n0, "d");
    n = num(o, n, a as u64);
    n = raw(o, n, "-");
    return num(o, n, b as u64);
}

/// A link to a state; on marks the decision that is made.
pub fn diff_link(o: []u8, n0: u32, a: u32, b: u32, label: []const u8, on: bool) -> u32 {
    var n : u32 = raw(o, n0, "<a href=\"#");
    n = diff_id(o, n, a, b);
    if (on) { n = raw(o, n, "\" class=\"on\">"); } else { n = raw(o, n, "\">"); }
    n = text(o, n, label);
    return raw(o, n, "</a> ");
}

/// One list item of a touched line: the line number in bold, large when it is outside the request, then the
/// words inside or outside.
pub fn diff_li(o: []u8, n0: u32, lead: []const u8, rest: []const u8, loud: bool) -> u32 {
    var n : u32 = n0;
    if (loud) { n = raw(o, n, "<li><b class=\"big\">"); } else { n = raw(o, n, "<li><b>"); }
    n = text(o, n, lead);
    n = raw(o, n, "</b>");
    n = text(o, n, rest);
    return raw(o, n, "</li>\n");
}

/// One diff as a box: its name, the touched lines, the verdict once decided, the two links.
pub fn diff_render_box(o: []u8, n0: u32, which: u32, a: u32, b: u32) -> u32 {
    var pick : u32 = a;
    if (which == 1) { pick = b; }
    var n : u32 = raw(o, n0, "<div class=\"box\">\n");
    n = pk_h2(o, n, SAY_DIFF_NAMES[which as usize]);
    n = raw(o, n, "<p class=\"muted\">");
    n = text(o, n, SAY_TOUCHED);
    n = raw(o, n, "</p>\n<ul class=\"list\">\n");
    var digits : [20]u8 = [0; 20];
    var line : u32 = 0;
    var ll : u32 = 0;
    var i : u32 = 0;
    while (i < 4) {
        line = diff_line(which, i);
        ll = dec_to(digits[0..], line as u64);
        if (diff_outside(line)) {
            n = diff_li(o, n, digits[0..(ll as usize)], SAY_OUTSIDE, true);
        } else {
            n = diff_li(o, n, digits[0..(ll as usize)], SAY_INSIDE, false);
        }
        i = i + 1;
    }
    n = raw(o, n, "</ul>\n");
    var verdict : u32 = diff_verdict(which, pick);
    if (verdict == 1) {
        if (which == 0) { n = pk_p(o, n, SAY_RIGHT_A); } else { n = pk_p(o, n, SAY_RIGHT_B); }
    }
    if (verdict == 2) { n = pk_p(o, n, SAY_WRONG); }
    n = raw(o, n, "<p class=\"nav\">");
    n = diff_link(o, n, diff_next_a(which, a, 1), diff_next_b(which, b, 1), SAY_ACCEPT, pick == 1);
    n = diff_link(o, n, diff_next_a(which, a, 2), diff_next_b(which, b, 2), SAY_SEND_BACK, pick == 2);
    return raw(o, n, "</p>\n</div>\n");
}

/// One section: the two diffs side by side.
pub fn diff_render_state(o: []u8, n0: u32, a: u32, b: u32) -> u32 {
    var n : u32 = pk_sec_begin(o, n0, a == 0 and b == 0);
    n = diff_id(o, n, a, b);
    n = pk_sec_body(o, n);
    n = raw(o, n, "<div class=\"row\">\n");
    n = diff_render_box(o, n, 0, a, b);
    n = diff_render_box(o, n, 1, a, b);
    n = raw(o, n, "</div>\n");
    return pk_sec_close(o, n);
}

/// The whole page. Every state except d0-0 first, d0-0 last: the default is the last section, as a browser
/// without :has needs. OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    var da : [20]u8 = [0; 20];
    var db : [20]u8 = [0; 20];
    var la : u32 = dec_to(da[0..], K_ASK_FROM as u64);
    var lb : u32 = dec_to(db[0..], K_ASK_TO as u64);
    n = raw(o, n, "<p>");
    n = fill(o, n, SAY_ASK, da[0..(la as usize)], db[0..(lb as usize)], "", 2);
    n = raw(o, n, "</p>\n");
    var a : u32 = 0;
    while (a < 3) {
        var b : u32 = 0;
        while (b < 3) {
            if (!(a == 0 and b == 0)) { n = diff_render_state(o, n, a, b); }
            b = b + 1;
        }
        a = a + 1;
    }
    n = diff_render_state(o, n, 0, 0);
    n = pk_p(o, n, SAY_NOTE);
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_read_diff(out: []u8) -> u32 {
    return render_page(out);
}

; --- tests --------------------------------------------------------------------------------------

test the_widget_sends_nothing {
    assert SENDS_NOTHING == true;
}

test the_clean_diff_stays_in_the_request {
    assert K_CLEAN_DIFF[0] >= K_ASK_FROM;
    assert K_CLEAN_DIFF[3] <= K_ASK_TO;
}

test the_sprawling_diff_has_a_line_outside {
    assert K_SPRAWLING_DIFF[3] > K_ASK_TO;
    assert K_SPRAWLING_DIFF[3] <= K_FILE_LINES;
}

test the_check_is_the_one_of_the_lesson {
    assert diff_outside(9) == true;
    assert diff_outside(10) == false;
    assert diff_outside(20) == false;
    assert diff_outside(21) == true;
    assert diff_outside(40) == true;
}

test only_the_sprawling_diff_has_a_line_outside {
    assert diff_has_outside(0) == false;
    assert diff_has_outside(1) == true;
    assert diff_line(1, 3) == 40;
    assert diff_line(0, 3) == 20;
}

test the_right_decision_follows_the_lines {
    assert diff_right(0) == 1;
    assert diff_right(1) == 2;
    assert diff_verdict(0, 0) == 0;
    assert diff_verdict(0, 1) == 1;
    assert diff_verdict(0, 2) == 2;
    assert diff_verdict(1, 2) == 1;
    assert diff_verdict(1, 1) == 2;
}

test a_click_changes_one_diff_only {
    assert diff_next_a(0, 0, 1) == 1;
    assert diff_next_b(0, 2, 1) == 2;
    assert diff_next_a(1, 2, 2) == 2;
    assert diff_next_b(1, 2, 1) == 1;
}

test every_transition_lands_on_a_state_of_the_page {
    var bad : u32 = 0;
    var a : u32 = 0;
    while (a < 3) {
        var b : u32 = 0;
        while (b < 3) {
            var w : u32 = 0;
            while (w < 2) {
                var c : u32 = 1;
                while (c <= 2) {
                    if (diff_next_a(w, a, c) > 2) { bad = bad + 1; }
                    if (diff_next_b(w, b, c) > 2) { bad = bad + 1; }
                    c = c + 1;
                }
                w = w + 1;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    assert bad == 0;
}

test the_machine_has_nine_states {
    assert K_STATES == 9;
    assert K_STATES == 3 * 3;
}

test the_page_has_one_section_per_state_and_one_default {
    const n : u32 = page_vc_read_diff(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<section ") == 9;
    assert pk_count(OUT[0..], n, "<section ") == K_STATES;
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"d0-0\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"d2-2\">") == 1;
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_read_diff(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"Vibecoding 18: read the diff before you accept it\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"The agent said done.");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-read-diff/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_state_page_marks_the_lines_outside_the_request {
    const n : u32 = page_vc_read_diff(OUT[0..]);
    assert pk_has(OUT[0..], n, "<p>You asked: change lines 10 to 20</p>");
    assert pk_count(OUT[0..], n, "<b class=\"big\">40</b>outside the request</li>") == 9;
    assert pk_count(OUT[0..], n, "</b>outside the request</li>") == 9;
    assert pk_count(OUT[0..], n, "</b>inside the request</li>") == 63;
    assert pk_count(OUT[0..], n, "<h2>Diff A</h2>") == 9;
    assert pk_count(OUT[0..], n, "<h2>Diff B</h2>") == 9;
}

test the_verdict_lines_follow_the_decisions {
    const n : u32 = page_vc_read_diff(OUT[0..]);
    assert pk_count(OUT[0..], n, "Right: every touched line is something you asked for.") == 3;
    assert pk_count(OUT[0..], n, "Right: line 40 is a change nobody asked for. Ask why, or send it back.") == 3;
    assert pk_count(OUT[0..], n, "Look at the touched lines again, next to the request.") == 6;
}

test a_state_page_links_every_decision {
    const n : u32 = page_vc_read_diff(OUT[0..]);
    assert pk_has(OUT[0..], n, "<a href=\"#d1-0\">Accept</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#d2-0\">Send back</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#d0-1\">Accept</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#d0-2\">Send back</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#d1-0\" class=\"on\">Accept</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#d0-2\" class=\"on\">Send back</a>");
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_read_diff(tiny[0..]) == OVER;
    assert render_page(tiny[0..]) == OVER;
}
