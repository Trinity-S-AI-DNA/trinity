; specs/widgets/views/page_kit.t27 -- the frame every static widget page of course 12 shares (FR-106,
; gHashTag/trinity#1807, gHashTag/t27#10937). A page of this kind has NO script: every state of the
; widget is one <section> of one HTML document, a link is a fragment (#state), and the CSS :target
; selector shows the section the address names. A spec writes the page with html_out (the writer of
; views/html_out.t27, a byte copy of specs/widgets/html_out.t27 in gHashTag/t27) and this kit; the
; t27c gen-text step of .github/workflows/emit-widget-pages.yml puts the bytes in
; public/widgets/<id>/index.html. Nothing on a page is typed by hand.
; --
; THE ONE DEFAULT SECTION. The section written with the d class is shown when the address names no
; section; when the address names another one, the default is hidden. It may stand anywhere among the
; sections: the first rule below serves a browser with :has, the second one a browser without it
; (there the default must be the LAST section).
; --
; Every function takes the buffer o and the length written so far n, and returns the new length. A write
; past the end of o returns OVER (html_out), and OVER stays OVER, so a page fn checks once, at the end,
; and returns OVER: gen-text then fails loudly and writes no file (a 0 would write an empty file as
; if it had worked).
; The metas follow the shape scripts/widgets-from-spec.mjs reads for the gallery: property or name,
; then content, both double-quoted; og:image is a t27.ai file that exists under public/.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_page_kit;

use widgets::views::html_out;

pub const PK_ORIGIN : str = "https://t27.ai/";
pub const PK_IMAGE : str = "https://t27.ai/og-image.png";

/// The whole style sheet: black on white, the brand book. Hidden sections, the shown target, the default.
pub const PK_CSS : str = "*{box-sizing:border-box}body{margin:0;font:16px/1.55 system-ui,-apple-system,'Segoe UI',sans-serif;color:#000;background:#fff}main,footer{max-width:46rem;margin:0 auto;padding:1rem}a{color:#000}.brand{font-weight:700;letter-spacing:.03em;text-decoration:none}h1{font-size:1.65rem;line-height:1.2;margin:.7rem 0 .3rem}h2{font-size:1.1rem;margin:1.1rem 0 .4rem}p{margin:.5rem 0}.muted{color:#555}.s{display:none}.s:target{display:block}.s:target~.d{display:none}main:has(.s:not(.d):target) .d{display:none}.d{display:block}.nav a,.nav span{display:inline-block;border:1px solid #000;padding:.25rem .65rem;margin:0 .4rem .4rem 0;text-decoration:none}.nav a.on{background:#000;color:#fff}.nav span.off{border-style:dashed;color:#777;border-color:#777}.box{border:1px solid #000;padding:.6rem .85rem;margin:.6rem 0}.box.dash{border-style:dashed}.row{display:flex;flex-wrap:wrap;gap:.6rem}.row>*{flex:1 1 11rem}table{border-collapse:collapse;width:100%;margin:.6rem 0}th,td{border:1px solid #000;padding:.35rem .55rem;text-align:left;vertical-align:top}th{background:#000;color:#fff}ol.steps,ul.list{padding-left:1.3rem}li{margin:.25rem 0}li b{margin-right:.4rem}code,pre{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.92em}pre{border:1px solid #000;padding:.6rem .8rem;white-space:pre-wrap;overflow-x:auto;margin:.5rem 0}.big{font-size:1.4rem;font-weight:700}footer{border-top:1px solid #000;margin-top:1.5rem;font-size:.9rem}";

/// One meta tag: <meta property="x" content="y">. kind is property or name.
pub fn pk_meta(o: []u8, n0: u32, kind: []const u8, key: []const u8, value: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<meta");
    n = attr(o, n, kind, key);
    n = attr(o, n, "content", value);
    return raw(o, n, ">\n");
}

/// The document up to and including the header of the page: head, metas, style, brand, title, description.
/// id is the widget id; the canonical address is t27.ai/widgets/<id>/.
pub fn pk_open(o: []u8, n0: u32, id: []const u8, title: []const u8, desc: []const u8, hook: []const u8, alt: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>");
    n = text(o, n, title);
    n = raw(o, n, " &middot; Trinity S&sup3;AI</title>\n");
    n = pk_meta(o, n, "name", "description", desc);
    n = pk_meta(o, n, "name", "t27:hook", hook);
    n = raw(o, n, "<link rel=\"canonical\" href=\"");
    n = raw(o, n, PK_ORIGIN);
    n = raw(o, n, "widgets/");
    n = text(o, n, id);
    n = raw(o, n, "/\">\n<link rel=\"icon\" href=\"../../favicon.svg\" type=\"image/svg+xml\">\n");
    n = pk_meta(o, n, "property", "og:type", "website");
    n = pk_meta(o, n, "property", "og:site_name", "Trinity S3AI");
    n = raw(o, n, "<meta property=\"og:url\" content=\"");
    n = raw(o, n, PK_ORIGIN);
    n = raw(o, n, "widgets/");
    n = text(o, n, id);
    n = raw(o, n, "/\">\n");
    n = pk_meta(o, n, "property", "og:title", title);
    n = pk_meta(o, n, "property", "og:description", desc);
    n = pk_meta(o, n, "property", "og:image", PK_IMAGE);
    n = pk_meta(o, n, "property", "og:image:alt", alt);
    n = pk_meta(o, n, "name", "twitter:card", "summary_large_image");
    n = pk_meta(o, n, "name", "twitter:site", "@t27_dev");
    n = pk_meta(o, n, "name", "twitter:title", title);
    n = pk_meta(o, n, "name", "twitter:description", desc);
    n = pk_meta(o, n, "name", "twitter:image", PK_IMAGE);
    n = raw(o, n, "<style>");
    n = raw(o, n, PK_CSS);
    n = raw(o, n, "</style>\n</head>\n<body>\n<main>\n<header><a class=\"brand\" href=\"../../\">Trinity S&sup3;AI</a>\n<h1>");
    n = text(o, n, title);
    n = raw(o, n, "</h1>\n<p class=\"muted\">");
    n = text(o, n, desc);
    return raw(o, n, "</p></header>\n");
}

/// The footer and the end of the document. source is the line that says where the rules come from.
pub fn pk_close(o: []u8, n0: u32, source: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "</main>\n<footer>\n<p>This page runs no script, sets no cookie and sends nothing anywhere.</p>\n<p>");
    n = text(o, n, source);
    n = raw(o, n, "</p>\n<p><a href=\"../../#/vibecoding\">Course: Vibecoding from zero</a> &middot; <a href=\"../../#/queen?tab=widgets\">All widgets</a></p>\n</footer>\n</body>\n</html>\n");
    return n;
}

/// The start of a section whose id the caller writes next (a numbered state): <section class="s[ d]" id=".
/// Follow it with the id, then pk_sec_body.
pub fn pk_sec_begin(o: []u8, n0: u32, dflt: bool) -> u32 {
    var n : u32 = raw(o, n0, "<section class=\"s");
    if (dflt) { n = raw(o, n, " d"); }
    return raw(o, n, "\" id=\"");
}

/// The end of the section tag opened by pk_sec_begin plus the id.
pub fn pk_sec_body(o: []u8, n0: u32) -> u32 {
    return raw(o, n0, "\">\n");
}

/// A whole section tag for a fixed id.
pub fn pk_sec_open(o: []u8, n0: u32, id: []const u8, dflt: bool) -> u32 {
    var n : u32 = pk_sec_begin(o, n0, dflt);
    n = text(o, n, id);
    return pk_sec_body(o, n);
}

pub fn pk_sec_close(o: []u8, n0: u32) -> u32 {
    return raw(o, n0, "</section>\n");
}

/// <p>text</p>
pub fn pk_p(o: []u8, n0: u32, s: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<p>");
    n = text(o, n, s);
    return raw(o, n, "</p>\n");
}

/// <h2>text</h2>
pub fn pk_h2(o: []u8, n0: u32, s: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<h2>");
    n = text(o, n, s);
    return raw(o, n, "</h2>\n");
}

/// <li><b>lead</b>rest</li>
pub fn pk_li(o: []u8, n0: u32, lead: []const u8, rest: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<li><b>");
    n = text(o, n, lead);
    n = raw(o, n, "</b>");
    n = text(o, n, rest);
    return raw(o, n, "</li>\n");
}

/// A link to a section by a fixed id: <a href="#id" [class="on"]>label</a> followed by a space.
/// A numbered state writes its own href with the same shape.
pub fn pk_link(o: []u8, n0: u32, id: []const u8, label: []const u8, on: bool) -> u32 {
    var n : u32 = raw(o, n0, "<a href=\"#");
    n = text(o, n, id);
    if (on) { n = raw(o, n, "\" class=\"on\">"); } else { n = raw(o, n, "\">"); }
    n = text(o, n, label);
    return raw(o, n, "</a> ");
}

// ---- reading a written page: the tests of every view use these ----

/// Does pat stand in o at position i (within the first n bytes)?
pub fn pk_match_at(o: []const u8, n: u32, i: u32, pat: []const u8) -> bool {
    if (i + (pat.len as u32) > n) { return false; }
    var j : usize = 0;
    while (j < pat.len) {
        if (o[(i as usize) + j] != pat[j]) { return false; }
        j = j + 1;
    }
    return true;
}

/// How many times pat stands in the first n bytes of o (0 for an empty pattern).
pub fn pk_count(o: []const u8, n: u32, pat: []const u8) -> u32 {
    if (pat.len == 0) { return 0; }
    var c : u32 = 0;
    var i : u32 = 0;
    while (i < n) {
        if (pk_match_at(o, n, i, pat)) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

pub fn pk_has(o: []const u8, n: u32, pat: []const u8) -> bool {
    return pk_count(o, n, pat) > 0;
}

/// The splicer follows only the names a module itself mentions (see html_out.t27). Never called.
pub fn pk_anchor(o: []u8) -> u32 {
    var n : u32 = put(o, 0, 0);
    n = put_escaped(o, n, 0);
    n = num(o, n, 0);
    n = fill(o, n, "", "", "", "", 0);
    return OVER + n + (H_SLASH + H_EQ + H_SPACE + H_APOS + H_QUOTE + H_AMP + H_GT + H_LT) as u32;
}

test the_frame_has_the_metas_the_gallery_reads {
    var o : [4096]u8 = [0; 4096];
    var n : u32 = pk_open(o[0..], 0, "x-y", "A & B", "Two \"things\".", "Hook.", "Alt.");
    n = pk_close(o[0..], n, "Rules: none");
    assert ok(n);
    assert pk_count(o[0..], n, "<meta property=\"og:title\" content=\"A &amp; B\">") == 1;
    assert pk_count(o[0..], n, "<meta property=\"og:description\" content=\"Two &quot;things&quot;.\">") == 1;
    assert pk_count(o[0..], n, "<meta property=\"og:image\" content=\"https://t27.ai/og-image.png\">") == 1;
    assert pk_count(o[0..], n, "<meta name=\"t27:hook\" content=\"Hook.\">") == 1;
    assert pk_count(o[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/x-y/\">") == 1;
    assert pk_count(o[0..], n, "<script") == 0;
    assert pk_count(o[0..], n, "<main>") == 1;
    assert pk_count(o[0..], n, "</main>") == 1;
}

test a_section_marks_the_default_once_and_links_name_it {
    var o : [512]u8 = [0; 512];
    var n : u32 = pk_sec_open(o[0..], 0, "tab-a", false);
    n = pk_sec_close(o[0..], n);
    n = pk_sec_open(o[0..], n, "tab-b", true);
    n = pk_link(o[0..], n, "tab-a", "A", true);
    n = pk_sec_close(o[0..], n);
    assert pk_count(o[0..], n, "<section class=\"s\" id=\"tab-a\">") == 1;
    assert pk_count(o[0..], n, "<section class=\"s d\" id=\"tab-b\">") == 1;
    assert pk_count(o[0..], n, "<a href=\"#tab-a\" class=\"on\">A</a>") == 1;
    assert pk_count(o[0..], n, "</section>") == 2;
}

test the_kit_refuses_a_buffer_that_is_too_small {
    var t : [32]u8 = [0; 32];
    assert pk_open(t[0..], 0, "x", "T", "D", "H", "A") == OVER;
    assert pk_close(t[0..], 0, "S") == OVER;
    assert pk_p(t[0..], OVER, "x") == OVER;
}

test the_counter_counts_overlaps_and_empty_patterns {
    var o : [16]u8 = [0; 16];
    var n : u32 = raw(o[0..], 0, "aaaa");
    assert pk_count(o[0..], n, "aa") == 3;
    assert pk_count(o[0..], n, "") == 0;
    assert pk_has(o[0..], n, "aaaa");
    assert pk_has(o[0..], n, "aaaaa") == false;
}
