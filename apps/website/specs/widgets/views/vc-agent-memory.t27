// SPDX-License-Identifier: Apache-2.0
; specs/widgets/vc-agent-memory.t27 -- the infographic of lesson 21 of the Vibecoding from zero course (specs/course_recipe/vibecoding-plan.t27)
; Source of truth for public/widgets/vc-agent-memory/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: specs/vibecoding/agent_memory.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_vc_agent_memory;

pub const KIND : str = "widget-tool";
pub const ID : str = "vc-agent-memory";
pub const TITLE : str = "Vibecoding 21: what an agent keeps";
pub const DESCRIPTION : str = "A chat of 10 messages in a window of 6: which messages the agent still sees, which it has lost, and what a file in the project keeps. Lesson 21 of the Vibecoding from zero course.";
pub const IMAGE_ALT : str = "A black and white table of chat length against what the agent keeps and forgets for a window of 6 messages; a diagram shows the window sliding along the chat as new messages arrive and the oldest fall out.";
pub const HOOK : str = "A window of 6 in a chat of 10: the oldest 4 are gone. A file stays.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [1]str = ["The lesson spec specs/vibecoding/agent_memory.t27, whose tests pass in the site test runner; the window, the chat length and the counts on this page are its constants"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "A window of 6 messages";
pub const SAY_TABLE_HEAD : [3]str = ["Messages in the chat", "Kept", "Forgotten"];
pub const SAY_TABLE_CELLS : [9]str = ["4", "4", "0", "6", "6", "0", "10", "6", "4"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 3;
pub const K_TABLE_CELLS : u16 = 9;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "The window slides";
pub const SAY_FLOW_STEPS : [4]str = ["Messages 0 to 5 fit", "Message 6 arrives: 0 falls out", "At 10 the window holds 4 to 9", "Notes in a project file are read again"];
pub const K_FLOW_STEPS : u8 = 4;
pub const SAY_NOTE : str = "Write what must last into a file; the chat is not a notebook.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 4;
    assert K_FLOW_STEPS > 1;
}
