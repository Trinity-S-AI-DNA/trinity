// SPDX-License-Identifier: Apache-2.0
; specs/widgets/views/vc-test-judge.t27 -- lesson 16 of the course "Vibecoding from zero" (specs/course/vibecoding.t27),
; module test_judge: a test says yes or no, the judge compares an answer with the one you wrote down.
; Source of truth for public/widgets/vc-test-judge/index.html, a page with NO script (FR-106,
; gHashTag/trinity#1807): t27c gen-text compiles this file and runs page_vc_test_judge, whose bytes the
; workflow .github/workflows/emit-widget-pages.yml writes to that path. The widget is a finite-state machine
; written out in full: one <section> per state, a link per transition, the CSS :target selector shows the one
; the address names (the frame is views/page_kit.t27).
; --
; STATE. (p, wi, g): p is the order of the two numbers, 0 for 3 and 9, 1 for 9 and 3 ("the numbers the other way
; round" of SAY_NOTE); wi is the answer written down, 0 for 3, 1 for 9; g is the stage, 0 for "write the answer
; down, then run" and 1 for "both versions ran and the judge has spoken". That is K_STATE_COUNT = 2 * 2 * 2 = 8
; sections, the cap on states is the nature of the widget. The id of a state is j and the three digits p, wi, g:
; j010 is the start (the numbers 3 and 9, the answer 9, nothing run yet), the default section, written LAST.
; LOGIC. Held equal to specs/vibecoding/test_judge.t27 by the tests below: larger gives the bigger number,
; larger_wrong always gives the first one; the judge says yes when what the code gave equals the answer written
; down. For 3 and 9 and the answer 9 the working code says yes and the slip no. With the numbers the other way
; round the slip gives 9 too, so the judge says yes to the slip: a yes means "agrees for these inputs", no more.
; And an answer written down wrongly (3) makes the judge say no to the working code. The judge never sees the
; code, only what it gave.
; TRANSITIONS. Stage 0: the answer links (3, 9) set wi and stay at stage 0; "Run both" goes to stage 1 with the
; same numbers and answer; "Swap the numbers" flips p and stays at stage 0 (the code has to run again); "Start
; again" goes to the start. Stage 1: the answer is locked, as the order of the lesson says (write it down before
; you run); "Write down another answer" goes back to stage 0; "Swap the numbers" and "Start again" as above.
; ASSUMPTION: the old widget had number fields (K_MIN_INPUT to K_MAX_INPUT); a page without script cannot take
; a typed number, so the answers on offer are the two numbers on screen and the numbers can be swapped. The words
; SAY_SWAP, SAY_AGAIN and SAY_RESET are new; every other word is the old widget's.
; WHAT IT DOES NOT CLAIM: that a test proves code correct; it says the code agrees with what the reader wrote
; down for those inputs and no more.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_test_judge;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-test-judge";
pub const TITLE : str = "Vibecoding 16: a test says yes or no";
pub const DESCRIPTION : str = "Write down the answer you expect, run two versions of a function, and watch the judge say yes to one and no to the other. Lesson 16 of the vibecoding course.";
pub const IMAGE_ALT : str = "A black and white card: the expected answer 9 for the inputs 3 and 9, a working function that gives 9 and is marked yes, and a function with a slip that gives 3 and is marked no.";
pub const HOOK : str = "You do not read the code. You write the answer down first, and a test says yes or no.";
pub const SENDS_NOTHING : bool = true;
pub const READS_LOCAL_FILES : bool = false;

; --- Numbers: held equal to specs/vibecoding/test_judge.t27 by the tests below ------------------
pub const K_INPUT_A : u8 = 3;
pub const K_INPUT_B : u8 = 9;
pub const K_WANT : u8 = 9;
pub const K_GOT_WORKING : u8 = 9;
pub const K_GOT_SLIP : u8 = 3;
pub const K_MIN_INPUT : u8 = 0;
pub const K_MAX_INPUT : u8 = 99;
pub const K_STATE_COUNT : u32 = 8;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_STEP_WRITE : str = "1. Write down the answer you expect";
pub const SAY_STEP_RUN : str = "2. Run the code";
pub const SAY_STEP_JUDGE : str = "3. Let the judge compare";
pub const SAY_INPUT_LABEL : str = "The larger of {0} and {1} is";
pub const SAY_VERSIONS : [2]str = ["Working code", "Code with a slip"];
pub const SAY_CODE : [2]str = ["if a is above b give a, else give b", "always give a"];
pub const SAY_GOT : str = "It gave {0}";
pub const SAY_YES : str = "Yes: it gave what you wrote down";
pub const SAY_NO : str = "No: it gave something else";
pub const SAY_RUN_BUTTON : str = "Run both";
pub const SAY_SWAP : str = "Swap the numbers";
pub const SAY_AGAIN : str = "Write down another answer";
pub const SAY_RESET : str = "Start again";
pub const SAY_NOTE : str = "A yes means the code agrees with your answer for these inputs, nothing more. Try the numbers the other way round.";
pub const SAY_SOURCE : str = "Logic: t27 spec specs/vibecoding/test_judge.t27";

pub var OUT : [32768]u8 = [0; 32768];

; --- the logic of the widget: the lesson's functions and the judge, one place ----------------------

/// The first number on screen: 3 when p is 0, 9 when p is 1.
pub fn tj_first(p: u32) -> u32 {
    if (p == 0) { return K_INPUT_A as u32; }
    return K_INPUT_B as u32;
}

/// The second number on screen: 9 when p is 0, 3 when p is 1.
pub fn tj_second(p: u32) -> u32 {
    if (p == 0) { return K_INPUT_B as u32; }
    return K_INPUT_A as u32;
}

/// larger of the lesson spec: the bigger of the two numbers.
pub fn tj_larger(a: u32, b: u32) -> u32 {
    if (a > b) { return a; }
    return b;
}

/// larger_wrong of the lesson spec: the slip, it always gives the first number.
pub fn tj_larger_wrong(a: u32, b: u32) -> u32 {
    return a;
}

/// The answer written down: 3 when wi is 0, 9 when wi is 1.
pub fn tj_want(wi: u32) -> u32 {
    if (wi == 0) { return K_INPUT_A as u32; }
    return K_INPUT_B as u32;
}

/// What version v (0 working, 1 with a slip) gives for the numbers of order p.
pub fn tj_got(v: u32, p: u32) -> u32 {
    if (v == 0) { return tj_larger(tj_first(p), tj_second(p)); }
    return tj_larger_wrong(tj_first(p), tj_second(p));
}

/// The judge: yes when what the version gave equals the answer written down.
pub fn tj_says_yes(v: u32, p: u32, wi: u32) -> bool {
    return tj_got(v, p) == tj_want(wi);
}

/// The start: the numbers 3 and 9, the answer 9, nothing run yet.
pub fn tj_is_start(p: u32, wi: u32, g: u32) -> bool {
    return p == 0 and wi == 1 and g == 0;
}

; --- the page ---------------------------------------------------------------------------------

/// The id of a state: j, p, wi, g.
pub fn tj_state_id(o: []u8, n0: u32, p: u32, wi: u32, g: u32) -> u32 {
    var n : u32 = raw(o, n0, "j");
    n = num(o, n, p as u64);
    n = num(o, n, wi as u64);
    return num(o, n, g as u64);
}

/// A link to a state: <a href="#id" [class="on"]>label</a> followed by a space. Every state exists, so it is always live.
pub fn tj_link(o: []u8, n0: u32, p: u32, wi: u32, g: u32, label: []const u8, on: bool) -> u32 {
    var n : u32 = raw(o, n0, "<a href=\"#");
    n = tj_state_id(o, n, p, wi, g);
    if (on) { n = raw(o, n, "\" class=\"on\">"); } else { n = raw(o, n, "\">"); }
    n = text(o, n, label);
    return raw(o, n, "</a> ");
}

/// One of the three steps; a step not reached yet is muted.
pub fn tj_step(o: []u8, n0: u32, label: []const u8, muted: bool) -> u32 {
    var n : u32 = n0;
    if (muted) { n = raw(o, n, "<p class=\"muted\">"); } else { n = raw(o, n, "<p>"); }
    n = text(o, n, label);
    return raw(o, n, "</p>\n");
}

/// "The larger of 3 and 9 is", then at stage 0 a link per answer (the one written down is marked on), at stage 1 the answer, locked.
pub fn tj_question(o: []u8, n0: u32, p: u32, wi: u32, g: u32) -> u32 {
    var n : u32 = raw(o, n0, "<p>");
    var da : [20]u8 = [0; 20];
    var la : u32 = dec_to(da[0..], tj_first(p) as u64);
    var db : [20]u8 = [0; 20];
    var lb : u32 = dec_to(db[0..], tj_second(p) as u64);
    n = fill(o, n, SAY_INPUT_LABEL, da[0..(la as usize)], db[0..(lb as usize)], "", 2);
    if (g == 1) {
        n = raw(o, n, " <b>");
        n = num(o, n, tj_want(wi) as u64);
        return raw(o, n, "</b></p>\n");
    }
    n = raw(o, n, "</p>\n<p class=\"nav\">");
    var c : u32 = 0;
    while (c <= 1) {
        la = dec_to(da[0..], tj_want(c) as u64);
        n = tj_link(o, n, p, c, 0, da[0..(la as usize)], c == wi);
        c = c + 1;
    }
    return raw(o, n, "</p>\n");
}

/// The two versions with their code, before anything ran.
pub fn tj_render_versions(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<ul class=\"list\">\n");
    var v : u32 = 0;
    while (v <= 1) {
        n = raw(o, n, "<li><b>");
        n = text(o, n, SAY_VERSIONS[v as usize]);
        n = raw(o, n, "</b><code>");
        n = text(o, n, SAY_CODE[v as usize]);
        n = raw(o, n, "</code></li>\n");
        v = v + 1;
    }
    return raw(o, n, "</ul>\n");
}

/// What version v gave and what the judge says: a solid box for yes, a dashed one for no.
pub fn tj_render_result(o: []u8, n0: u32, v: u32, p: u32, wi: u32) -> u32 {
    var yes : bool = tj_says_yes(v, p, wi);
    var n : u32 = raw(o, n0, "<div class=\"box");
    if (!yes) { n = raw(o, n, " dash"); }
    n = raw(o, n, "\"><p><b>");
    n = text(o, n, SAY_VERSIONS[v as usize]);
    n = raw(o, n, "</b></p><p><code>");
    n = text(o, n, SAY_CODE[v as usize]);
    n = raw(o, n, "</code></p><p>");
    var d : [20]u8 = [0; 20];
    var l : u32 = dec_to(d[0..], tj_got(v, p) as u64);
    n = fill(o, n, SAY_GOT, d[0..(l as usize)], "", "", 1);
    n = raw(o, n, "</p><p class=\"big\">");
    if (yes) { n = text(o, n, SAY_YES); } else { n = text(o, n, SAY_NO); }
    return raw(o, n, "</p></div>\n");
}

/// One section: the three steps, the question, then the versions and the run link (stage 0) or the two verdicts (stage 1).
pub fn render_state(o: []u8, n0: u32, p: u32, wi: u32, g: u32) -> u32 {
    var n : u32 = pk_sec_begin(o, n0, tj_is_start(p, wi, g));
    n = tj_state_id(o, n, p, wi, g);
    n = pk_sec_body(o, n);
    n = tj_step(o, n, SAY_STEP_WRITE, false);
    n = tj_step(o, n, SAY_STEP_RUN, g == 0);
    n = tj_step(o, n, SAY_STEP_JUDGE, g == 0);
    n = tj_question(o, n, p, wi, g);
    if (g == 0) {
        n = tj_render_versions(o, n);
        n = raw(o, n, "<p class=\"nav\">");
        n = tj_link(o, n, p, wi, 1, SAY_RUN_BUTTON, false);
    } else {
        n = raw(o, n, "<div class=\"row\">\n");
        n = tj_render_result(o, n, 0, p, wi);
        n = tj_render_result(o, n, 1, p, wi);
        n = raw(o, n, "</div>\n<p class=\"nav\">");
        n = tj_link(o, n, p, wi, 0, SAY_AGAIN, false);
    }
    n = tj_link(o, n, 1 - p, wi, 0, SAY_SWAP, false);
    n = tj_link(o, n, 0, 1, 0, SAY_RESET, false);
    n = raw(o, n, "</p>\n");
    return pk_sec_close(o, n);
}

/// The whole page. Every state except the start first, the start last: the default is the last section,
/// as a browser without :has needs. OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    var p : u32 = 0;
    while (p <= 1) {
        var wi : u32 = 0;
        while (wi <= 1) {
            var g : u32 = 0;
            while (g <= 1) {
                if (!tj_is_start(p, wi, g)) { n = render_state(o, n, p, wi, g); }
                g = g + 1;
            }
            wi = wi + 1;
        }
        p = p + 1;
    }
    n = render_state(o, n, 0, 1, 0);
    n = pk_p(o, n, SAY_NOTE);
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_test_judge(out: []u8) -> u32 {
    return render_page(out);
}

/// Is the last <section of the first n bytes the default one?
pub fn tj_default_is_last(o: []const u8, n: u32) -> bool {
    var i : u32 = n;
    while (i > 0) {
        i = i - 1;
        if (pk_match_at(o, n, i, "<section ")) {
            return pk_match_at(o, n, i, "<section class=\"s d\"");
        }
    }
    return false;
}

; --- tests --------------------------------------------------------------------------------------

test the_page_sends_nothing {
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == false;
}

test the_working_code_agrees_with_the_answer_written_down {
    assert K_GOT_WORKING == K_WANT;
    assert K_WANT == K_INPUT_B;
    assert tj_got(0, 0) == (K_GOT_WORKING as u32);
    assert tj_want(1) == (K_WANT as u32);
}

test the_slip_does_not_agree {
    assert K_GOT_SLIP != K_WANT;
    assert K_GOT_SLIP == K_INPUT_A;
    assert tj_got(1, 0) == (K_GOT_SLIP as u32);
}

test the_inputs_fit_the_field {
    assert K_INPUT_B <= K_MAX_INPUT;
    assert K_INPUT_A >= K_MIN_INPUT;
}

test the_functions_are_the_ones_of_the_lesson_spec {
    assert tj_larger(3, 9) == 9;
    assert tj_larger(9, 3) == 9;
    assert tj_larger_wrong(3, 9) == 3;
    assert tj_larger_wrong(9, 3) == 9;
    assert tj_first(0) == 3;
    assert tj_second(0) == 9;
    assert tj_first(1) == 9;
    assert tj_second(1) == 3;
}

test the_judge_compares_with_what_you_wrote_not_with_the_truth {
    assert tj_says_yes(0, 0, 1) == true;
    assert tj_says_yes(1, 0, 1) == false;
    assert tj_says_yes(0, 1, 1) == true;
    assert tj_says_yes(1, 1, 1) == true;
    assert tj_says_yes(0, 0, 0) == false;
    assert tj_says_yes(1, 0, 0) == true;
    assert tj_says_yes(0, 1, 0) == false;
    assert tj_says_yes(1, 1, 0) == false;
}

test the_states_are_the_product_of_the_three_choices {
    var c : u32 = 0;
    var p : u32 = 0;
    while (p <= 1) {
        var wi : u32 = 0;
        while (wi <= 1) {
            var g : u32 = 0;
            while (g <= 1) {
                c = c + 1;
                g = g + 1;
            }
            wi = wi + 1;
        }
        p = p + 1;
    }
    assert c == K_STATE_COUNT;
    assert K_STATE_COUNT == 8;
}

test every_link_lands_on_a_state_of_the_page {
    var bad : u32 = 0;
    var p : u32 = 0;
    while (p <= 1) {
        if (1 - p > 1) { bad = bad + 1; }
        if (1 - (1 - p) != p) { bad = bad + 1; }
        p = p + 1;
    }
    var wi : u32 = 0;
    while (wi <= 1) {
        if (tj_want(wi) != 3 and tj_want(wi) != 9) { bad = bad + 1; }
        wi = wi + 1;
    }
    assert bad == 0;
}

test the_page_has_one_section_per_state_and_the_start_is_the_default_and_last {
    const n : u32 = page_vc_test_judge(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<section ") == 8;
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"j010\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"j000\">") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"j111\">") == 1;
    assert tj_default_is_last(OUT[0..], n);
}

test the_steps_and_the_question_are_in_every_state {
    const n : u32 = page_vc_test_judge(OUT[0..]);
    assert pk_count(OUT[0..], n, "<p>1. Write down the answer you expect</p>") == 8;
    assert pk_count(OUT[0..], n, "<p>2. Run the code</p>") == 4;
    assert pk_count(OUT[0..], n, "<p class=\"muted\">2. Run the code</p>") == 4;
    assert pk_count(OUT[0..], n, "<p>3. Let the judge compare</p>") == 4;
    assert pk_count(OUT[0..], n, "<p class=\"muted\">3. Let the judge compare</p>") == 4;
    assert pk_count(OUT[0..], n, "The larger of 3 and 9 is") == 4;
    assert pk_count(OUT[0..], n, "The larger of 9 and 3 is") == 4;
}

test the_judge_says_yes_four_times_and_no_four_times {
    const n : u32 = page_vc_test_judge(OUT[0..]);
    assert pk_count(OUT[0..], n, "Yes: it gave what you wrote down") == 4;
    assert pk_count(OUT[0..], n, "No: it gave something else") == 4;
    assert pk_count(OUT[0..], n, "It gave 9") == 6;
    assert pk_count(OUT[0..], n, "It gave 3") == 2;
}

test the_links_go_to_the_state_with_the_choice_changed {
    const n : u32 = page_vc_test_judge(OUT[0..]);
    assert pk_has(OUT[0..], n, "<a href=\"#j011\">Run both</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#j110\">Swap the numbers</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#j000\">3</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#j010\" class=\"on\">9</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#j010\">Start again</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#j010\">Write down another answer</a>");
    assert pk_count(OUT[0..], n, "Run both</a>") == 4;
    assert pk_count(OUT[0..], n, "Write down another answer</a>") == 4;
    assert pk_count(OUT[0..], n, "Start again</a>") == 8;
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_test_judge(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"Vibecoding 16: a test says yes or no\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"You do not read the code.");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-test-judge/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_test_judge(tiny[0..]) == OVER;
    assert render_page(tiny[0..]) == OVER;
}
