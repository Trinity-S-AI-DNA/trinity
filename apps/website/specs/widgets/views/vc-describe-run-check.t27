; specs/widgets/views/vc-describe-run-check.t27 -- the infographic of lesson 1 of the course "Vibecoding from zero" (specs/course/vibecoding.t27)
; Source of truth for public/widgets/vc-describe-run-check/index.html, a page with NO script (FR-106, gHashTag/trinity#1807):
; t27c gen-text --fn page_vc_describe_run_check compiles this file and runs that fn, whose bytes the workflow
; .github/workflows/emit-widget-pages.yml writes to that path. An infographic: two views of one fact, a real
; <table> of two runs of one tab and the verdict of the check on each, and an ordered list of the three steps
; describe, run and check, one <section> each, switched by the CSS :target selector (the frame is views/page_kit.t27).
; The lesson spec it illustrates: specs/vibecoding/describe_run_check.t27.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_describe_run_check;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-describe-run-check";
pub const TITLE : str = "Vibecoding 1: describe, run, check";
pub const DESCRIPTION : str = "A wish in plain words, a run that prints a number, and a check that says yes or no. A run that only looks fine is rejected. Lesson 1 of the vibecoding course.";
pub const IMAGE_ALT : str = "A black and white table of two runs of a cafe tab for 3 drinks at 4 each, with the check's verdict: the run that printed 12 passes, the run that printed 7 is rejected; a diagram walks the three steps describe, run and check.";
pub const HOOK : str = "A run with no error can still be wrong. Describe it, run it, and let a check say yes or no.";
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Two runs of the tab for 3 drinks at 4 each";
pub const SAY_TABLE_HEAD : [3]str = ["Run", "Printed", "Check"];
pub const SAY_TABLE_CELLS : [6]str = ["drinks * price", "12", "Passes", "drinks + price", "7", "Rejected"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 2;
pub const K_TABLE_CELLS : u16 = 6;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "The loop of one idea";
pub const SAY_FLOW_STEPS : [3]str = ["Describe: the tab is drinks times price", "Run: the program prints a number", "Check: the number equals 3 * 4"];
pub const K_FLOW_STEPS : u8 = 3;
pub const SAY_NOTE : str = "Both runs finish without an error. Only the check tells them apart.";
pub const SAY_TAB_TABLE : str = "The two runs";
pub const SAY_TAB_FLOW : str = "The three steps";
pub const SAY_SOURCE : str = "Rules: t27 spec vibecoding/describe_run_check.t27";

; --- The numbers behind the table ------------------------------------------------------------
pub const K_DRINKS : u16 = 3;
pub const K_PRICE : u16 = 4;
pub const K_GOOD_RUN : u16 = 12;
pub const K_BAD_RUN : u16 = 7;

pub var OUT : [32768]u8 = [0; 32768];

; --- the page ---------------------------------------------------------------------------------

/// The two tabs, as links to the two sections; the one on screen is marked.
pub fn render_nav(o: []u8, n0: u32, on_flow: bool) -> u32 {
    var n : u32 = raw(o, n0, "<p class=\"nav\">");
    n = pk_link(o, n, "table", SAY_TAB_TABLE, !on_flow);
    n = pk_link(o, n, "flow", SAY_TAB_FLOW, on_flow);
    return raw(o, n, "</p>\n");
}

/// The table of the two runs: a head row and K_TABLE_ROWS rows of K_TABLE_COLS cells.
pub fn render_table(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<table>\n<caption>");
    n = text(o, n, SAY_TABLE_CAPTION);
    n = raw(o, n, "</caption>\n<thead><tr>");
    var c : u32 = 0;
    while (c < 3) {
        n = raw(o, n, "<th>");
        n = text(o, n, SAY_TABLE_HEAD[c as usize]);
        n = raw(o, n, "</th>");
        c = c + 1;
    }
    n = raw(o, n, "</tr></thead>\n<tbody>\n");
    var r : u32 = 0;
    while (r < 2) {
        n = raw(o, n, "<tr>");
        var k : u32 = 0;
        while (k < 3) {
            n = raw(o, n, "<td>");
            n = text(o, n, SAY_TABLE_CELLS[(r * 3 + k) as usize]);
            n = raw(o, n, "</td>");
            k = k + 1;
        }
        n = raw(o, n, "</tr>\n");
        r = r + 1;
    }
    return raw(o, n, "</tbody>\n</table>\n");
}

/// The three steps, in order.
pub fn render_flow(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<ol class=\"steps\">\n");
    var i : u32 = 0;
    while (i < 3) {
        n = raw(o, n, "<li>");
        n = text(o, n, SAY_FLOW_STEPS[i as usize]);
        n = raw(o, n, "</li>\n");
        i = i + 1;
    }
    return raw(o, n, "</ol>\n");
}

/// The whole page. The flow is the first section, the table the last and the default (a browser without
/// :has needs the default last). OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    n = pk_sec_open(o, n, "flow", false);
    n = render_nav(o, n, true);
    n = pk_h2(o, n, SAY_FLOW_TITLE);
    n = render_flow(o, n);
    n = pk_sec_close(o, n);
    n = pk_sec_open(o, n, "table", true);
    n = render_nav(o, n, false);
    n = render_table(o, n);
    n = pk_sec_close(o, n);
    n = pk_p(o, n, SAY_NOTE);
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_describe_run_check(out: []u8) -> u32 {
    return render_page(out);
}

; --- tests --------------------------------------------------------------------------------------

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_flow_has_every_step {
    assert K_FLOW_STEPS == 3;
    assert K_FLOW_STEPS > 1;
}

test the_table_numbers_come_from_the_lesson {
    assert K_GOOD_RUN == K_DRINKS * K_PRICE;
    assert K_BAD_RUN == K_DRINKS + K_PRICE;
    assert K_GOOD_RUN != K_BAD_RUN;
}

test the_widget_sends_nothing {
    assert SENDS_NOTHING == true;
}

test the_page_has_a_real_table_and_the_three_steps {
    const n : u32 = page_vc_describe_run_check(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<table>") == 1;
    assert pk_count(OUT[0..], n, "<th>") == 3;
    assert pk_count(OUT[0..], n, "<td>") == 6;
    assert pk_count(OUT[0..], n, "<li>") == 3;
    assert pk_has(OUT[0..], n, "<td>drinks * price</td>");
    assert pk_has(OUT[0..], n, "<td>Rejected</td>");
    assert pk_has(OUT[0..], n, "<li>Check: the number equals 3 * 4</li>");
    assert pk_has(OUT[0..], n, "<p>Both runs finish without an error. Only the check tells them apart.</p>");
}

test the_page_has_two_sections_and_the_table_is_the_default {
    const n : u32 = page_vc_describe_run_check(OUT[0..]);
    assert pk_count(OUT[0..], n, "<section ") == 2;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"flow\">") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"table\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_has(OUT[0..], n, "<a href=\"#flow\">The three steps</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#table\" class=\"on\">The two runs</a>");
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_describe_run_check(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"Vibecoding 1: describe, run, check\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"A run with no error can still be wrong. Describe it, run it, and let a check say yes or no.\">");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-describe-run-check/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_describe_run_check(tiny[0..]) == OVER;
}
