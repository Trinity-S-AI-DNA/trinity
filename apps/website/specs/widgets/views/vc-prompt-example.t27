; specs/widgets/views/vc-prompt-example.t27 -- the infographic of lesson 2 of module Prompting, course Vibecoding from zero (specs/course/vibecoding.t27)
; Source of truth for public/widgets/vc-prompt-example/index.html, a page with NO script (FR-106, gHashTag/trinity#1807):
; t27c gen-text compiles this file and runs page_vc_prompt_example, whose bytes the workflow
; .github/workflows/emit-widget-pages.yml writes to that path. An infographic: two views of one fact, a real
; <table> of three example pairs and what two rules give for each, and an ordered list of the three steps of how
; many rules still fit, one <section> each, switched by the CSS :target selector (the frame is views/page_kit.t27).
; The lesson spec it illustrates: specs/vibecoding/prompt_example.t27.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_prompt_example;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-prompt-example";
pub const TITLE : str = "Vibecoding: an example beats an adjective";
pub const DESCRIPTION : str = "One example input and output fits two rules; a second example drops one. Why an agent follows an example better than the word bigger. Vibecoding from zero, Prompting.";
pub const IMAGE_ALT : str = "A black and white diagram: a vague word fits many rules, one example fits two, two examples fit one; a table shows three example pairs and whether rule A, add 3, and rule B, multiply by 3 and add 1, give the wanted output.";
pub const HOOK : str = "One example fits two rules. The second example picks one.";
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Wanted output, and what two rules give";
pub const SAY_TABLE_HEAD : [4]str = ["Input", "Wanted", "Rule A: x + 3", "Rule B: x * 3 + 1"];
pub const SAY_TABLE_CELLS : [12]str = [
    "1", "4", "4", "4",
    "2", "5", "5", "7",
    "5", "8", "8", "16"
];
pub const K_TABLE_COLS : u8 = 4;
pub const K_TABLE_ROWS : u8 = 3;
pub const K_TABLE_CELLS : u16 = 12;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "How many rules still fit";
pub const SAY_FLOW_STEPS : [3]str = ["An adjective: many rules fit", "One example: two rules fit", "Two examples: one rule fits"];
pub const K_FLOW_STEPS : u8 = 3;
pub const SAY_NOTE : str = "Row 1 does not tell A from B. Row 2 does: B gives 7, not the wanted 5.";
pub const SAY_TAB_TABLE : str = "Two rules";
pub const SAY_TAB_FLOW : str = "How many fit";
pub const SAY_SOURCE : str = "Rules: t27 spec vibecoding/prompt_example.t27";

pub var OUT : [32768]u8 = [0; 32768];

; --- the page ---------------------------------------------------------------------------------

/// The two tabs, as links to the two sections; the one on screen is marked.
pub fn render_nav(o: []u8, n0: u32, on_flow: bool) -> u32 {
    var n : u32 = raw(o, n0, "<p class=\"nav\">");
    n = pk_link(o, n, "table", SAY_TAB_TABLE, !on_flow);
    n = pk_link(o, n, "flow", SAY_TAB_FLOW, on_flow);
    return raw(o, n, "</p>\n");
}

/// The table of the example pairs: a head row and K_TABLE_ROWS rows of K_TABLE_COLS cells.
pub fn render_table(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<table>\n<caption>");
    n = text(o, n, SAY_TABLE_CAPTION);
    n = raw(o, n, "</caption>\n<thead><tr>");
    var c : u32 = 0;
    while (c < 4) {
        n = raw(o, n, "<th>");
        n = text(o, n, SAY_TABLE_HEAD[c as usize]);
        n = raw(o, n, "</th>");
        c = c + 1;
    }
    n = raw(o, n, "</tr></thead>\n<tbody>\n");
    var r : u32 = 0;
    while (r < 3) {
        n = raw(o, n, "<tr>");
        var k : u32 = 0;
        while (k < 4) {
            n = raw(o, n, "<td>");
            n = text(o, n, SAY_TABLE_CELLS[(r * 4 + k) as usize]);
            n = raw(o, n, "</td>");
            k = k + 1;
        }
        n = raw(o, n, "</tr>\n");
        r = r + 1;
    }
    return raw(o, n, "</tbody>\n</table>\n");
}

/// The three steps, in order.
pub fn render_flow(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<ol class=\"steps\">\n");
    var i : u32 = 0;
    while (i < 3) {
        n = raw(o, n, "<li>");
        n = text(o, n, SAY_FLOW_STEPS[i as usize]);
        n = raw(o, n, "</li>\n");
        i = i + 1;
    }
    return raw(o, n, "</ol>\n");
}

/// The whole page. The flow is the first section, the table the last and the default (a browser without
/// :has needs the default last). OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    n = pk_sec_open(o, n, "flow", false);
    n = render_nav(o, n, true);
    n = pk_h2(o, n, SAY_FLOW_TITLE);
    n = render_flow(o, n);
    n = pk_sec_close(o, n);
    n = pk_sec_open(o, n, "table", true);
    n = render_nav(o, n, false);
    n = render_table(o, n);
    n = pk_sec_close(o, n);
    n = pk_p(o, n, SAY_NOTE);
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_prompt_example(out: []u8) -> u32 {
    return render_page(out);
}

; --- tests --------------------------------------------------------------------------------------

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 3;
    assert K_FLOW_STEPS > 1;
}

test the_cells_are_the_two_rules {
    assert 4 == 1 + 3;
    assert 4 == 1 * 3 + 1;
    assert 5 == 2 + 3;
    assert 7 == 2 * 3 + 1;
    assert 8 == 5 + 3;
    assert 16 == 5 * 3 + 1;
}

test the_widget_sends_nothing {
    assert SENDS_NOTHING == true;
}

test the_page_has_a_real_table_and_the_three_steps {
    const n : u32 = page_vc_prompt_example(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<table>") == 1;
    assert pk_count(OUT[0..], n, "<caption>") == 1;
    assert pk_count(OUT[0..], n, "<th>") == 4;
    assert pk_count(OUT[0..], n, "<td>") == 12;
    assert pk_count(OUT[0..], n, "<li>") == 3;
    assert pk_has(OUT[0..], n, "<th>Rule B: x * 3 + 1</th>");
    assert pk_has(OUT[0..], n, "<td>2</td><td>5</td><td>5</td><td>7</td>");
    assert pk_has(OUT[0..], n, "<li>Two examples: one rule fits</li>");
}

test the_page_has_two_sections_and_the_table_is_the_default {
    const n : u32 = page_vc_prompt_example(OUT[0..]);
    assert pk_count(OUT[0..], n, "<section ") == 2;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"flow\">") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"table\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_has(OUT[0..], n, "<a href=\"#flow\">How many fit</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#table\" class=\"on\">Two rules</a>");
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_prompt_example(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"Vibecoding: an example beats an adjective\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"One example fits two rules. The second example picks one.\">");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-prompt-example/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_prompt_example(tiny[0..]) == OVER;
}
