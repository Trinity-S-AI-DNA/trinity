// SPDX-License-Identifier: Apache-2.0
; specs/widgets/views/vc-agent-hands.t27 -- the infographic of lesson 20 of the course "Vibecoding from zero" (specs/course/vibecoding.t27)
; Source of truth for public/widgets/vc-agent-hands/index.html, a page with NO script (FR-106, gHashTag/trinity#1807):
; t27c gen-text --fn page_vc_agent_hands compiles this file and runs that fn, whose bytes the workflow
; .github/workflows/emit-widget-pages.yml writes to that path. An infographic: two views of one fact, a real
; <table> of the three tools and who may start each one and an ordered list of the five steps of one tool call, one
; <section> each, switched by the CSS :target selector (the frame is views/page_kit.t27).
; The lesson spec it illustrates: specs/vibecoding/agent_hands.t27.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_agent_hands;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-agent-hands";
pub const TITLE : str = "Vibecoding 20: tools an agent can call";
pub const DESCRIPTION : str = "Three tools, which run at once and which wait for a yes, and the cap on calls in one turn. Lesson 20 of the Vibecoding from zero course.";
pub const IMAGE_ALT : str = "A black and white table of three tools, read a file, run the tests and write a file, with who may start each one; a diagram follows one call from the agent naming a tool to the host checking the list, running it and sending the result back.";
pub const HOOK : str = "Reading and testing run at once; writing waits for your yes.";
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Tools and who may start them";
pub const SAY_TABLE_HEAD : [3]str = ["Id", "Tool", "Runs"];
pub const SAY_TABLE_CELLS : [9]str = ["0", "Read a file", "At once", "1", "Run the tests", "At once", "2", "Write a file", "After your yes"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 3;
pub const K_TABLE_CELLS : u16 = 9;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "One tool call";
pub const SAY_FLOW_STEPS : [5]str = ["The agent names a tool", "The host checks the list", "A write waits for a yes", "The host runs the tool", "The result goes back as text"];
pub const K_FLOW_STEPS : u8 = 5;
pub const SAY_NOTE : str = "The loop is capped: of 9 calls asked in one turn, the host lets 5 through.";
pub const SAY_TAB_TABLE : str = "The three tools";
pub const SAY_TAB_FLOW : str = "How a call runs";
pub const SAY_SOURCE : str = "Rules: t27 spec vibecoding/agent_hands.t27";

pub var OUT : [32768]u8 = [0; 32768];

; --- the page ---------------------------------------------------------------------------------

/// The two tabs, as links to the two sections; the one on screen is marked.
pub fn render_nav(o: []u8, n0: u32, on_flow: bool) -> u32 {
    var n : u32 = raw(o, n0, "<p class=\"nav\">");
    n = pk_link(o, n, "table", SAY_TAB_TABLE, !on_flow);
    n = pk_link(o, n, "flow", SAY_TAB_FLOW, on_flow);
    return raw(o, n, "</p>\n");
}

/// The table of the three tools: a head row and K_TABLE_ROWS rows of K_TABLE_COLS cells.
pub fn render_table(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<table>\n<caption>");
    n = text(o, n, SAY_TABLE_CAPTION);
    n = raw(o, n, "</caption>\n<thead><tr>");
    var c : u32 = 0;
    while (c < 3) {
        n = raw(o, n, "<th>");
        n = text(o, n, SAY_TABLE_HEAD[c as usize]);
        n = raw(o, n, "</th>");
        c = c + 1;
    }
    n = raw(o, n, "</tr></thead>\n<tbody>\n");
    var r : u32 = 0;
    while (r < 3) {
        n = raw(o, n, "<tr>");
        var k : u32 = 0;
        while (k < 3) {
            n = raw(o, n, "<td>");
            n = text(o, n, SAY_TABLE_CELLS[(r * 3 + k) as usize]);
            n = raw(o, n, "</td>");
            k = k + 1;
        }
        n = raw(o, n, "</tr>\n");
        r = r + 1;
    }
    return raw(o, n, "</tbody>\n</table>\n");
}

/// The five steps of one call, in order.
pub fn render_flow(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<ol class=\"steps\">\n");
    var i : u32 = 0;
    while (i < 5) {
        n = raw(o, n, "<li>");
        n = text(o, n, SAY_FLOW_STEPS[i as usize]);
        n = raw(o, n, "</li>\n");
        i = i + 1;
    }
    return raw(o, n, "</ol>\n");
}

/// The whole page. The flow is the first section, the table the last and the default (a browser without
/// :has needs the default last). OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    n = pk_sec_open(o, n, "flow", false);
    n = render_nav(o, n, true);
    n = pk_h2(o, n, SAY_FLOW_TITLE);
    n = render_flow(o, n);
    n = pk_sec_close(o, n);
    n = pk_sec_open(o, n, "table", true);
    n = render_nav(o, n, false);
    n = render_table(o, n);
    n = pk_sec_close(o, n);
    n = pk_p(o, n, SAY_NOTE);
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_agent_hands(out: []u8) -> u32 {
    return render_page(out);
}

; --- tests --------------------------------------------------------------------------------------

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_flow_has_every_step {
    assert K_FLOW_STEPS == 5;
    assert K_FLOW_STEPS > 1;
}

test the_widget_sends_nothing {
    assert SENDS_NOTHING == true;
}

test the_page_has_a_real_table_and_the_five_steps {
    const n : u32 = page_vc_agent_hands(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<table>") == 1;
    assert pk_count(OUT[0..], n, "<th>") == 3;
    assert pk_count(OUT[0..], n, "<td>") == 9;
    assert pk_count(OUT[0..], n, "<li>") == 5;
    assert pk_has(OUT[0..], n, "<td>After your yes</td>");
    assert pk_has(OUT[0..], n, "<li>The result goes back as text</li>");
    assert pk_has(OUT[0..], n, "<p>The loop is capped: of 9 calls asked in one turn, the host lets 5 through.</p>");
}

test the_page_has_two_sections_and_the_table_is_the_default {
    const n : u32 = page_vc_agent_hands(OUT[0..]);
    assert pk_count(OUT[0..], n, "<section ") == 2;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"flow\">") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"table\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_has(OUT[0..], n, "<a href=\"#flow\">How a call runs</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#table\" class=\"on\">The three tools</a>");
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_agent_hands(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"Vibecoding 20: tools an agent can call\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"Reading and testing run at once; writing waits for your yes.\">");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-agent-hands/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_agent_hands(tiny[0..]) == OVER;
}
