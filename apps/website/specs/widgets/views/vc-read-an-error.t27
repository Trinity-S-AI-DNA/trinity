// SPDX-License-Identifier: Apache-2.0
; specs/widgets/vc-read-an-error.t27 -- the infographic of lesson 6 of the vibecoding course (specs/course/vibecoding.t27)
; Source of truth for public/widgets/vc-read-an-error/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/vibecoding/read_an_error.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_vc_read_an_error;

pub const KIND : str = "widget-tool";
pub const ID : str = "vc-read-an-error";
pub const TITLE : str = "Vibecoding 6: the four parts of an error";
pub const DESCRIPTION : str = "An error message split into its four parts, in the order you read them, and where to start reading. Lesson 6 of the vibecoding course.";
pub const IMAGE_ALT : str = "A black and white table of an error message in four parts: kind, message, file, line. The line is where the problem was noticed; start reading one line before it.";
pub const HOOK : str = "Kind, message, file, line. Start one line above the one it names.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [1]str = ["The lesson spec public/t27/files/specs/vibecoding/read_an_error.t27, compiled clean by public/t27/t27_compiler.wasm, whose tests pass in the site test runner; the four parts and the line rule are its constants"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "The four parts of an error message";
pub const SAY_TABLE_HEAD : [2]str = ["Part", "What it tells you"];
pub const SAY_TABLE_CELLS : [8]str = ["Kind", "the family of the problem, such as a syntax error", "Message", "what the program says went wrong, in its own words", "File", "which file to open", "Line", "where it was noticed; the cause can sit just above"];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 4;
pub const K_TABLE_CELLS : u16 = 8;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "What to do with an error";
pub const SAY_FLOW_STEPS : [4]str = ["Read the message whole", "Open the file at the line", "Read from one line above", "Fix one thing and run again"];
pub const K_FLOW_STEPS : u8 = 4;
pub const SAY_NOTE : str = "The example parts are generic wording, not output of a run; paste your own whole message to your agent.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 4;
    assert K_FLOW_STEPS > 1;
}
