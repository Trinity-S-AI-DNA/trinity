; specs/widgets/views/vc-four-phases.t27 -- lesson 13 of the course "Vibecoding from zero" (specs/course/vibecoding.t27),
; module loop. Source of truth for public/widgets/vc-four-phases/index.html, a page with NO script (FR-106,
; gHashTag/trinity#1807): t27c gen-text compiles this file and runs page_vc_four_phases, whose bytes the
; workflow .github/workflows/emit-widget-pages.yml writes to that path. The widget is a finite-state machine
; written out in full: one <section> per state, a link per transition, the CSS :target selector shows the one
; the address names (the frame is views/page_kit.t27).
; --
; STATE. (p, s): p the phase, 0 idea, 1 build, 2 test, 3 ship; s the steps taken, 0 to K_CAP. The reader walks
; one idea through the phases. At idea and build one link goes to the next phase. At test there are two links:
; a pass goes to K_PASS_NEXT[2], which is ship, a fail goes to K_FAIL_NEXT[2], which is build. Every click is one
; step, so a fail makes the loop longer; ship has no step link, only the link to start again. The loop can run
; as long as the reader likes, so the page follows at most K_CAP steps; at the cap the step links are plain
; labels. Only the states a reader can reach are written (phase_reachable): s 0 is idea, s 1 is build, an even s
; from 2 is test, an odd s from 3 is build (after a fail) or ship (after a pass). The two next-phase tables are
; the ones of specs/vibecoding/four_phases.t27 (held equal by the tests below).
; ASSUMPTION: the interaction is read from the words of the widget that ran as a script before (SAY_NEXT,
; SAY_PASS, SAY_FAIL, SAY_RESET, SAY_STEPS, SAY_FAILED_BACK, SAY_SHIPPED): one click is one step, and the four
; phases are listed in every state with the current one in large type.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_four_phases;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-four-phases";
pub const TITLE : str = "Four phases: idea, build, test, ship";
pub const DESCRIPTION : str = "Walk one idea through four phases. At the test phase press pass or fail: a pass ships it, a fail sends it back to build. Nothing ships past a red test.";
pub const IMAGE_ALT : str = "Four phases card: a row of four boxes, idea, build, test and ship, joined by arrows. The test box has two exits: a pass arrow to ship and a fail arrow back to build. A counter shows the steps taken so far.";
pub const HOOK : str = "A failed test does not go forward to ship. It goes back to build, and the loop runs again.";
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: held equal to specs/vibecoding/four_phases.t27 by the tests below
pub const K_PHASE_COUNT : u8 = 4;
pub const K_TEST_PHASE : u8 = 2;
pub const K_PASS_NEXT : [4]u8 = [1, 2, 3, 3];
pub const K_FAIL_NEXT : [4]u8 = [1, 2, 1, 3];
pub const K_START_PHASE : u8 = 0;
pub const K_CAP : u32 = 12;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PHASES : [4]str = ["Idea", "Build", "Test", "Ship"];
pub const SAY_PHASE_LINES : [4]str = [
    "Say in one sentence what you want.",
    "Ask the agent for one small piece.",
    "Run it and let a test say yes or no.",
    "Save it and put it where it is used."
];
pub const SAY_ASK : str = "Which phase is your work in?";
pub const SAY_NEXT : str = "Go to the next phase";
pub const SAY_PASS : str = "The tests pass";
pub const SAY_FAIL : str = "A test fails";
pub const SAY_RESET : str = "Start again";
pub const SAY_STEPS : str = "steps taken: {0}";
pub const SAY_FAILED_BACK : str = "A test failed, so the work goes back to Build.";
pub const SAY_SHIPPED : str = "Shipped. The only way here was through a passing test.";
pub const SAY_NOTE : str = "The loop is not a straight line: Test can send you back to Build as many times as it needs to.";
pub const SAY_CAP : str = "This page follows up to {0} steps, then the step links stop.";
pub const SAY_SOURCE : str = "Rules: t27 spec vibecoding/four_phases.t27";

pub var OUT : [49152]u8 = [0; 49152];

; --- the transitions: the whole logic of the widget, one place ---------------------------------

/// The phase a pass (or the next link of idea and build) leads to: the pass table of the lesson.
pub fn phase_pass(p: u32) -> u32 {
    return K_PASS_NEXT[p as usize] as u32;
}

/// The phase a failed test leads to: the fail table of the lesson.
pub fn phase_fail(p: u32) -> u32 {
    return K_FAIL_NEXT[p as usize] as u32;
}

/// May a step link do something: not at ship, not at the cap.
pub fn phase_can_step(p: u32, s: u32, cap: u32) -> bool {
    if (p >= 3) { return false; }
    return s < cap;
}

/// Can a reader stand in phase p after s steps? s 0 is idea, s 1 is build, an even s is test, an odd s from 3
/// is build (after a fail) or ship (after a pass).
pub fn phase_reachable(p: u32, s: u32) -> bool {
    if (s == 0) { return p == 0; }
    if (s == 1) { return p == 1; }
    if (s % 2 == 0) { return p == 2; }
    return p == 1 or p == 3;
}

/// Is this state the one a failed test just sent back to build?
pub fn phase_failed_back(p: u32, s: u32) -> bool {
    return p == 1 and s >= 3;
}

/// The number of states with at most cap steps: every reachable (p, s), p 0 to 3, s 0 to cap.
pub fn phase_state_count(cap: u32) -> u32 {
    var c : u32 = 0;
    var p : u32 = 0;
    while (p <= 3) {
        var s : u32 = 0;
        while (s <= cap) {
            if (phase_reachable(p, s)) { c = c + 1; }
            s = s + 1;
        }
        p = p + 1;
    }
    return c;
}

; --- the page ---------------------------------------------------------------------------------

/// The id of a state: p, the phase, -, the steps.
pub fn phase_id(o: []u8, n0: u32, p: u32, s: u32) -> u32 {
    var n : u32 = raw(o, n0, "p");
    n = num(o, n, p as u64);
    n = raw(o, n, "-");
    return num(o, n, s as u64);
}

/// A link to a state, or the plain label when there is nothing to go to.
pub fn phase_link(o: []u8, n0: u32, p: u32, s: u32, label: []const u8, live: bool, on: bool) -> u32 {
    var n : u32 = n0;
    if (!live) {
        n = raw(o, n, "<span class=\"off\">");
        n = text(o, n, label);
        return raw(o, n, "</span> ");
    }
    n = raw(o, n, "<a href=\"#");
    n = phase_id(o, n, p, s);
    if (on) { n = raw(o, n, "\" class=\"on\">"); } else { n = raw(o, n, "\">"); }
    n = text(o, n, label);
    return raw(o, n, "</a> ");
}

/// One list item for the phase the reader stands in: the name in large type, marked as the current step.
pub fn phase_li_now(o: []u8, n0: u32, lead: []const u8, rest: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<li aria-current=\"step\"><b class=\"big\">");
    n = text(o, n, lead);
    n = raw(o, n, "</b>");
    n = text(o, n, rest);
    return raw(o, n, "</li>\n");
}

/// One section: the four phases, the step counter, the notes, and the links.
pub fn phase_render_state(o: []u8, n0: u32, p: u32, s: u32, cap: u32) -> u32 {
    var n : u32 = pk_sec_begin(o, n0, p == 0 and s == 0);
    n = phase_id(o, n, p, s);
    n = pk_sec_body(o, n);
    n = raw(o, n, "<ol class=\"steps\">\n");
    var i : u32 = 0;
    while (i < 4) {
        if (i == p) {
            n = phase_li_now(o, n, SAY_PHASES[i as usize], SAY_PHASE_LINES[i as usize]);
        } else {
            n = pk_li(o, n, SAY_PHASES[i as usize], SAY_PHASE_LINES[i as usize]);
        }
        i = i + 1;
    }
    n = raw(o, n, "</ol>\n<div class=\"box\"><p class=\"big\">");
    var digits : [20]u8 = [0; 20];
    var la : u32 = dec_to(digits[0..], s as u64);
    n = fill(o, n, SAY_STEPS, digits[0..(la as usize)], "", "", 1);
    n = raw(o, n, "</p>");
    if (phase_failed_back(p, s)) { n = pk_p(o, n, SAY_FAILED_BACK); }
    if (p == 3) { n = pk_p(o, n, SAY_SHIPPED); }
    n = raw(o, n, "</div>\n<p class=\"nav\">");
    if (p == 2) {
        n = phase_link(o, n, phase_pass(p), s + 1, SAY_PASS, phase_can_step(p, s, cap), false);
        n = phase_link(o, n, phase_fail(p), s + 1, SAY_FAIL, phase_can_step(p, s, cap), false);
    } else {
        if (p < 3) { n = phase_link(o, n, phase_pass(p), s + 1, SAY_NEXT, phase_can_step(p, s, cap), false); }
    }
    n = phase_link(o, n, 0, 0, SAY_RESET, true, false);
    n = raw(o, n, "</p>\n");
    return pk_sec_close(o, n);
}

/// The whole page for a cap. Every reachable state except p0-0 first, p0-0 last: the default is the last
/// section, as a browser without :has needs. OVER when it did not fit.
pub fn render_page(o: []u8, cap: u32) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    n = pk_p(o, n, SAY_ASK);
    var p : u32 = 0;
    while (p <= 3) {
        var s : u32 = 0;
        while (s <= cap) {
            if (phase_reachable(p, s)) {
                if (!(p == 0 and s == 0)) { n = phase_render_state(o, n, p, s, cap); }
            }
            s = s + 1;
        }
        p = p + 1;
    }
    n = phase_render_state(o, n, 0, 0, cap);
    n = pk_p(o, n, SAY_NOTE);
    var digits : [20]u8 = [0; 20];
    var lc : u32 = dec_to(digits[0..], cap as u64);
    n = raw(o, n, "<p class=\"muted\">");
    n = fill(o, n, SAY_CAP, digits[0..(lc as usize)], "", "", 1);
    n = raw(o, n, "</p>\n");
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_four_phases(out: []u8) -> u32 {
    return render_page(out, K_CAP);
}

; --- tests --------------------------------------------------------------------------------------

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_widget_sends_nothing {
    assert SENDS_NOTHING == true;
}

test the_tables_match_the_lesson_spec {
    assert K_PASS_NEXT[0] == 1;
    assert K_PASS_NEXT[2] == 3;
    assert K_FAIL_NEXT[K_TEST_PHASE] == 1;
    assert K_PASS_NEXT[K_TEST_PHASE] == K_PHASE_COUNT - 1;
}

test every_phase_has_a_name_and_a_line {
    assert SAY_PHASES[3] == "Ship";
    assert SAY_PHASE_LINES[3] == "Save it and put it where it is used.";
}

test the_state_counts_for_the_three_caps {
    assert phase_state_count(6) == 9;
    assert phase_state_count(12) == 18;
    assert phase_state_count(24) == 36;
}

test three_passing_steps_reach_ship {
    var p : u32 = 0;
    var s : u32 = 0;
    var i : u32 = 0;
    while (i < 3) {
        const np : u32 = phase_pass(p);
        p = np;
        s = s + 1;
        i = i + 1;
    }
    assert p == 3;
    assert s == 3;
    assert phase_can_step(p, s, 12) == false;
}

test a_failed_test_goes_back_to_build {
    assert phase_pass(2) == 3;
    assert phase_fail(2) == 1;
    assert phase_reachable(1, 3) == true;
    assert phase_failed_back(1, 3) == true;
    assert phase_failed_back(1, 1) == false;
}

test shipped_stays_shipped {
    assert phase_pass(3) == 3;
    assert phase_fail(3) == 3;
    assert phase_can_step(3, 3, 12) == false;
}

test the_cap_stops_the_step_links {
    assert phase_can_step(0, 0, 12) == true;
    assert phase_can_step(1, 11, 12) == true;
    assert phase_can_step(2, 12, 12) == false;
}

test every_transition_lands_on_a_state_of_the_page {
    var bad : u32 = 0;
    var p : u32 = 0;
    while (p <= 3) {
        var s : u32 = 0;
        while (s <= 12) {
            if (phase_reachable(p, s) and phase_can_step(p, s, 12)) {
                if (!phase_reachable(phase_pass(p), s + 1)) { bad = bad + 1; }
                if (!phase_reachable(phase_fail(p), s + 1)) { bad = bad + 1; }
            }
            s = s + 1;
        }
        p = p + 1;
    }
    assert bad == 0;
}

test the_page_has_one_section_per_state_and_one_default {
    const n : u32 = page_vc_four_phases(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<section ") == 18;
    assert pk_count(OUT[0..], n, "<section ") == phase_state_count(12);
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"p0-0\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"p3-11\">") == 1;
}

test a_smaller_cap_writes_fewer_sections {
    const n : u32 = render_page(OUT[0..], 6);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<section ") == 9;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_four_phases(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"Four phases: idea, build, test, ship\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"A failed test does not go forward to ship.");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-four-phases/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_state_page_shows_its_counter_notes_and_links {
    const n : u32 = page_vc_four_phases(OUT[0..]);
    assert pk_has(OUT[0..], n, "steps taken: 0");
    assert pk_has(OUT[0..], n, "steps taken: 12");
    assert pk_has(OUT[0..], n, "<a href=\"#p1-1\">Go to the next phase</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#p3-3\">The tests pass</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#p1-3\">A test fails</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#p0-0\">Start again</a>");
    assert pk_has(OUT[0..], n, "<span class=\"off\">The tests pass</span>");
    assert pk_has(OUT[0..], n, "A test failed, so the work goes back to Build.");
    assert pk_has(OUT[0..], n, "Shipped. The only way here was through a passing test.");
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_four_phases(tiny[0..]) == OVER;
    assert render_page(tiny[0..], 6) == OVER;
}
