// SPDX-License-Identifier: Apache-2.0
; specs/widgets/vc-four-phases.t27 -- lesson 13 of the course "Vibecoding from zero" (specs/course/vibecoding.t27), module loop
; Source of truth for public/widgets/vc-four-phases/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles this
; file, checks its constants, evaluates the tests below and writes the page; the page hands every constant to
; tool.js as window.T27_WIDGET. The reader walks one idea through idea, build, test and ship, and at the test phase
; chooses pass or fail. The two next-phase tables are the ones of specs/vibecoding/four_phases.t27.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_vc_four_phases;

pub const KIND : str = "widget-tool";
pub const ID : str = "vc-four-phases";
pub const TITLE : str = "Four phases: idea, build, test, ship";
pub const DESCRIPTION : str = "Walk one idea through four phases. At the test phase press pass or fail: a pass ships it, a fail sends it back to build. Nothing ships past a red test.";
pub const IMAGE_ALT : str = "Four phases card: a row of four boxes, idea, build, test and ship, joined by arrows. The test box has two exits: a pass arrow to ship and a fail arrow back to build. A counter shows the steps taken so far.";
pub const HOOK : str = "A failed test does not go forward to ship. It goes back to build, and the loop runs again.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [1]str = ["Course 12 of t27.ai, vibecoding (module loop, lesson 13): the next-phase tables are specs/vibecoding/four_phases.t27, the lesson spec the player opens"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: held equal to specs/vibecoding/four_phases.t27 by the tests below
pub const K_PHASE_COUNT : u8 = 4;
pub const K_TEST_PHASE : u8 = 2;
pub const K_PASS_NEXT : [4]u8 = [1, 2, 3, 3];
pub const K_FAIL_NEXT : [4]u8 = [1, 2, 1, 3];
pub const K_START_PHASE : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PHASES : [4]str = ["Idea", "Build", "Test", "Ship"];
pub const SAY_PHASE_LINES : [4]str = [
    "Say in one sentence what you want.",
    "Ask the agent for one small piece.",
    "Run it and let a test say yes or no.",
    "Save it and put it where it is used."
];
pub const SAY_ASK : str = "Which phase is your work in?";
pub const SAY_NEXT : str = "Go to the next phase";
pub const SAY_PASS : str = "The tests pass";
pub const SAY_FAIL : str = "A test fails";
pub const SAY_RESET : str = "Start again";
pub const SAY_STEPS : str = "steps taken: {0}";
pub const SAY_FAILED_BACK : str = "A test failed, so the work goes back to Build.";
pub const SAY_SHIPPED : str = "Shipped. The only way here was through a passing test.";
pub const SAY_NOTE : str = "The loop is not a straight line: Test can send you back to Build as many times as it needs to.";
pub const SAY_SOURCE : str = "Rules: t27 spec vibecoding/four_phases.t27";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_widget_sends_nothing {
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == false;
}

test the_tables_match_the_lesson_spec {
    assert K_PASS_NEXT[0] == 1;
    assert K_PASS_NEXT[2] == 3;
    assert K_FAIL_NEXT[K_TEST_PHASE] == 1;
    assert K_PASS_NEXT[K_TEST_PHASE] == K_PHASE_COUNT - 1;
}

test every_phase_has_a_name_and_a_line {
    assert SAY_PHASES[3] == "Ship";
    assert SAY_PHASE_LINES[3] == "Save it and put it where it is used.";
}
