; specs/widgets/views/vc-secrets-out.t27 -- lesson 3 of module "A first bot" of the course "Vibecoding from zero"
; (specs/course/vibecoding.t27), module secrets_out. Source of truth for public/widgets/vc-secrets-out/index.html,
; a page with NO script (FR-106, gHashTag/trinity#1807): t27c gen-text compiles this file and runs
; page_vc_secrets_out, whose bytes the workflow .github/workflows/emit-widget-pages.yml writes to that path.
; The widget is a finite-state machine written out in full: one <section> per state, a link per transition,
; the CSS :target selector shows the one the address names (the frame is views/page_kit.t27).
; --
; STATE. Four switches, one per file of the project: saved by git (1) or ignored by git (0). A state is the
; number st = sum of flag(i) * 2^i over the four files, 0 to 15, so the page has K_STATE_COUNT = 16 sections and
; the cap on states is the nature of the widget (2 to the power of K_FILE_COUNT). The id of a state is the
; letter t and the four flags, file 0 first: t1101 is the start (bot.t27, .env.example and README.md saved, .env
; ignored: K_TRACKED_START of the lesson spec specs/vibecoding/secrets_out.t27). A file leaks when it holds a
; secret and git saves it (leaks of the lesson spec, held equal by the tests below): the .env file, in the
; states where its switch is on, so eight states leak and eight do not.
; TRANSITIONS. Every file has two links, "git saves it" and "git ignores it": each goes to the state with that
; one flag set, and the link that names the state itself is marked on. The last link of every state, "Put the
; switches back", goes to the start. The message to an agent and the made-up placeholder stand once, under the
; sections, the same in every state.
; The default section is the LAST one, as a browser without :has needs.
; ASSUMPTION: the interaction is read from the words of the widget that ran as a script before (SAY_SAVED,
; SAY_IGNORED, SAY_LEAK, SAY_SAFE, SAY_RESET): a click on a switch word is one flip of that file.
; WHAT IT DOES NOT CLAIM: the placeholder is invented for this page and opens nothing; the page takes no real
; token or key and reads no file from the reader's machine.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_secrets_out;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-secrets-out";
pub const TITLE : str = "Secrets stay out: tick which files git saves";
pub const DESCRIPTION : str = "Four files of a small bot project: switch each between saved and ignored and see the alarm when a file with a secret is saved. Only a made-up placeholder is used.";
pub const IMAGE_ALT : str = "A black and white list of four files, bot.t27, .env.example, .env and README.md, each with a saved or ignored switch; the .env file holds a secret and an alarm marks it when it is switched to saved.";
pub const HOOK : str = "Flip the switch on the settings file and watch what a saved secret does.";
pub const SENDS_NOTHING : bool = true;
pub const READS_LOCAL_FILES : bool = false;

; --- Numbers: held equal to specs/vibecoding/secrets_out.t27 by the tests below ----------------
pub const K_FILE_COUNT : u8 = 4;
pub const K_HOLDS_SECRET : [4]u8 = [0, 0, 1, 0];
pub const K_TRACKED_START : [4]u8 = [1, 1, 0, 1];
pub const K_STATE_COUNT : u32 = 16;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_FILES_TITLE : str = "Files of the project";
pub const SAY_FILE_NAMES : [4]str = ["bot.t27", ".env.example", ".env", "README.md"];
pub const SAY_FILE_NOTES : [4]str = ["the bot's code", "the names of the settings and a made-up placeholder", "the real settings on your machine", "notes for a reader"];
pub const SAY_SAVED : str = "git saves it";
pub const SAY_IGNORED : str = "git ignores it";
pub const SAY_LEAK : str = "Leak: this file holds a secret and git saves it. Anyone who sees the repository sees the secret.";
pub const SAY_SAFE : str = "No file leaks: the secret stays on your machine.";
pub const SAY_PLACEHOLDER_NAME : str = "BOT_TOKEN";
pub const SAY_PLACEHOLDER : str = "your-token-goes-here";
pub const SAY_PLACEHOLDER_LEAD : str = "In .env.example the setting holds only a made-up placeholder:";
pub const SAY_PROMPT_TITLE : str = "A message to an agent";
pub const SAY_PROMPT_GOOD : str = "Read the bot's token from the setting named BOT_TOKEN. The value is in my .env file; do not print it.";
pub const SAY_PROMPT_BAD_NOTE : str = "Never paste the value itself into a message: a message can be logged, shared or saved.";
pub const SAY_RESET : str = "Put the switches back";
pub const SAY_SOURCE : str = "Rules: t27 spec vibecoding/secrets_out.t27";

pub var OUT : [65536]u8 = [0; 65536];

; --- the transitions: the whole logic of the widget, one place ---------------------------------

/// 2 to the power i: the weight of file i in a state number (the lowest bit is file 0).
pub fn so_pow2(i: u32) -> u32 {
    var p : u32 = 1;
    var j : u32 = 0;
    while (j < i) {
        p = p * 2;
        j = j + 1;
    }
    return p;
}

/// 1 when git saves file i in state st, 0 when it ignores it.
pub fn so_flag(st: u32, i: u32) -> u32 {
    return (st / so_pow2(i)) % 2;
}

/// The state st with the switch of file i set to v (0 ignored, 1 saved). The other three switches stay.
pub fn so_with(st: u32, i: u32, v: u32) -> u32 {
    return st - so_flag(st, i) * so_pow2(i) + v * so_pow2(i);
}

/// The state a reader starts in, and the one the reset link goes to: the saved flags of the lesson spec.
pub fn so_start() -> u32 {
    var st : u32 = 0;
    var i : u32 = 0;
    while (i < 4) {
        st = st + (K_TRACKED_START[i as usize] as u32) * so_pow2(i);
        i = i + 1;
    }
    return st;
}

/// How many files leak in state st: a file leaks when it holds a secret and git saves it (the product of the lesson spec).
pub fn so_leaks(st: u32) -> u32 {
    var c : u32 = 0;
    var i : u32 = 0;
    while (i < 4) {
        c = c + (K_HOLDS_SECRET[i as usize] as u32) * so_flag(st, i);
        i = i + 1;
    }
    return c;
}

; --- the page ---------------------------------------------------------------------------------

/// The id of state st: t, then the saved flag of each file, file 0 first.
pub fn so_state_id(o: []u8, n0: u32, st: u32) -> u32 {
    var n : u32 = raw(o, n0, "t");
    var i : u32 = 0;
    while (i < 4) {
        n = num(o, n, so_flag(st, i) as u64);
        i = i + 1;
    }
    return n;
}

/// A link to state st: <a href="#id" [class="on"]>label</a> followed by a space. Every state exists, so the link is always live.
pub fn so_link(o: []u8, n0: u32, st: u32, label: []const u8, on: bool) -> u32 {
    var n : u32 = raw(o, n0, "<a href=\"#");
    n = so_state_id(o, n, st);
    if (on) { n = raw(o, n, "\" class=\"on\">"); } else { n = raw(o, n, "\">"); }
    n = text(o, n, label);
    return raw(o, n, "</a> ");
}

/// One file of the list: its name, its note and its two switch links. The link that names this very state is marked on.
pub fn so_render_file(o: []u8, n0: u32, st: u32, i: u32) -> u32 {
    var n : u32 = raw(o, n0, "<li><b>");
    n = text(o, n, SAY_FILE_NAMES[i as usize]);
    n = raw(o, n, "</b>");
    n = text(o, n, SAY_FILE_NOTES[i as usize]);
    n = raw(o, n, "<div class=\"nav\">");
    n = so_link(o, n, so_with(st, i, 1), SAY_SAVED, so_flag(st, i) == 1);
    n = so_link(o, n, so_with(st, i, 0), SAY_IGNORED, so_flag(st, i) == 0);
    return raw(o, n, "</div></li>\n");
}

/// One section: the four files with their switches, the alarm or the all-clear, and the reset link.
pub fn render_state(o: []u8, n0: u32, st: u32) -> u32 {
    var n : u32 = pk_sec_begin(o, n0, st == so_start());
    n = so_state_id(o, n, st);
    n = pk_sec_body(o, n);
    n = raw(o, n, "<ul class=\"list\">\n");
    var i : u32 = 0;
    while (i < 4) {
        n = so_render_file(o, n, st, i);
        i = i + 1;
    }
    n = raw(o, n, "</ul>\n");
    if (so_leaks(st) > 0) {
        n = raw(o, n, "<div class=\"box\">");
        n = pk_p(o, n, SAY_LEAK);
    } else {
        n = raw(o, n, "<div class=\"box dash\">");
        n = pk_p(o, n, SAY_SAFE);
    }
    n = raw(o, n, "</div>\n<p class=\"nav\">");
    n = so_link(o, n, so_start(), SAY_RESET, false);
    n = raw(o, n, "</p>\n");
    return pk_sec_close(o, n);
}

/// The message to an agent and the made-up placeholder: the same in every state, so written once.
pub fn so_render_prompt(o: []u8, n0: u32) -> u32 {
    var n : u32 = pk_h2(o, n0, SAY_PROMPT_TITLE);
    n = raw(o, n, "<pre><code>");
    n = text(o, n, SAY_PROMPT_GOOD);
    n = raw(o, n, "</code></pre>\n");
    n = pk_p(o, n, SAY_PROMPT_BAD_NOTE);
    n = pk_p(o, n, SAY_PLACEHOLDER_LEAD);
    n = raw(o, n, "<pre><code>");
    n = text(o, n, SAY_PLACEHOLDER_NAME);
    n = raw(o, n, "=");
    n = text(o, n, SAY_PLACEHOLDER);
    return raw(o, n, "</code></pre>\n");
}

/// The whole page. Every state except the start first, the start last: the default is the last section,
/// as a browser without :has needs. OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    n = pk_h2(o, n, SAY_FILES_TITLE);
    var st : u32 = 0;
    while (st < K_STATE_COUNT) {
        if (st != so_start()) { n = render_state(o, n, st); }
        st = st + 1;
    }
    n = render_state(o, n, so_start());
    n = so_render_prompt(o, n);
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_secrets_out(out: []u8) -> u32 {
    return render_page(out);
}

/// Is the last <section of the first n bytes the default one?
pub fn so_default_is_last(o: []const u8, n: u32) -> bool {
    var i : u32 = n;
    while (i > 0) {
        i = i - 1;
        if (pk_match_at(o, n, i, "<section ")) {
            return pk_match_at(o, n, i, "<section class=\"s d\"");
        }
    }
    return false;
}

; --- tests --------------------------------------------------------------------------------------

test the_page_sends_nothing {
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == false;
}

test the_secret_is_in_one_file_of_four {
    assert K_FILE_COUNT == 4;
    assert K_HOLDS_SECRET[2] == 1;
    assert K_HOLDS_SECRET[0] + K_HOLDS_SECRET[1] + K_HOLDS_SECRET[3] == 0;
}

test the_starting_switches_leak_nothing {
    assert K_HOLDS_SECRET[0] * K_TRACKED_START[0] == 0;
    assert K_HOLDS_SECRET[1] * K_TRACKED_START[1] == 0;
    assert K_HOLDS_SECRET[2] * K_TRACKED_START[2] == 0;
    assert K_HOLDS_SECRET[3] * K_TRACKED_START[3] == 0;
    assert so_leaks(so_start()) == 0;
}

test the_names_match_the_flags {
    assert SAY_FILE_NAMES[K_FILE_COUNT - 1] == "README.md";
    assert SAY_FILE_NAMES[2] == ".env";
}

test the_state_numbers_are_the_four_switches {
    assert so_pow2(0) == 1;
    assert so_pow2(1) == 2;
    assert so_pow2(2) == 4;
    assert so_pow2(3) == 8;
    assert so_pow2(4) == K_STATE_COUNT;
    assert so_start() == 11;
    assert so_flag(11, 0) == 1;
    assert so_flag(11, 1) == 1;
    assert so_flag(11, 2) == 0;
    assert so_flag(11, 3) == 1;
    assert so_with(11, 2, 1) == 15;
    assert so_with(15, 2, 0) == 11;
    assert so_with(11, 0, 1) == 11;
    assert so_with(11, 0, 0) == 10;
}

test the_leak_rule_is_the_lesson_rule {
    assert so_leaks(0) == 0;
    assert so_leaks(4) == 1;
    assert so_leaks(11) == 0;
    assert so_leaks(15) == 1;
}

test exactly_half_of_the_states_leak {
    var leaking : u32 = 0;
    var st : u32 = 0;
    while (st < K_STATE_COUNT) {
        if (so_leaks(st) > 0) { leaking = leaking + 1; }
        st = st + 1;
    }
    assert leaking == 8;
}

test every_switch_lands_on_a_state_and_moves_one_flag {
    var bad : u32 = 0;
    var st : u32 = 0;
    while (st < K_STATE_COUNT) {
        var i : u32 = 0;
        while (i < 4) {
            var v : u32 = 0;
            while (v <= 1) {
                const dest : u32 = so_with(st, i, v);
                if (dest >= K_STATE_COUNT) { bad = bad + 1; }
                if (so_flag(dest, i) != v) { bad = bad + 1; }
                var j : u32 = 0;
                while (j < 4) {
                    if (j != i and so_flag(dest, j) != so_flag(st, j)) { bad = bad + 1; }
                    j = j + 1;
                }
                v = v + 1;
            }
            i = i + 1;
        }
        st = st + 1;
    }
    assert bad == 0;
}

test the_page_has_one_section_per_state_and_the_start_is_the_default_and_last {
    const n : u32 = page_vc_secrets_out(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<section ") == 16;
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"t1101\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"t0000\">") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"t1111\">") == 1;
    assert so_default_is_last(OUT[0..], n);
}

test every_state_lists_the_four_files {
    const n : u32 = page_vc_secrets_out(OUT[0..]);
    assert pk_count(OUT[0..], n, "<li><b>") == 64;
    assert pk_count(OUT[0..], n, "<li><b>bot.t27</b>") == 16;
    assert pk_count(OUT[0..], n, "<li><b>.env</b>") == 16;
    assert pk_count(OUT[0..], n, "<li><b>README.md</b>") == 16;
}

test eight_sections_raise_the_alarm_and_eight_say_all_clear {
    const n : u32 = page_vc_secrets_out(OUT[0..]);
    assert pk_count(OUT[0..], n, "Leak: this file holds a secret") == 8;
    assert pk_count(OUT[0..], n, "No file leaks") == 8;
}

test the_switch_links_go_to_the_state_with_one_flag_changed {
    const n : u32 = page_vc_secrets_out(OUT[0..]);
    assert pk_has(OUT[0..], n, "<a href=\"#t1111\">git saves it</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#t1101\" class=\"on\">git ignores it</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#t0101\">git ignores it</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#t1101\">Put the switches back</a>");
}

test the_prompt_and_the_placeholder_stand_once {
    const n : u32 = page_vc_secrets_out(OUT[0..]);
    assert pk_count(OUT[0..], n, "<pre>") == 2;
    assert pk_count(OUT[0..], n, "BOT_TOKEN=your-token-goes-here") == 1;
    assert pk_count(OUT[0..], n, "A message to an agent") == 1;
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_secrets_out(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"Secrets stay out: tick which files git saves\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"Flip the switch on the settings file");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-secrets-out/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_secrets_out(tiny[0..]) == OVER;
    assert render_page(tiny[0..]) == OVER;
}
