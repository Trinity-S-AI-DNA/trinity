// SPDX-License-Identifier: Apache-2.0
; specs/widgets/vc-secrets-out.t27 -- which files git saves, and which one must never be saved
; Source of truth for public/widgets/vc-secrets-out/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English of its own: every
; word on screen is a SAY_ constant here, every number the tool relies on is a K_ constant.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: lists the four files of a small bot project. The reader switches each file between
; "git saves it" and "git ignores it" and watches a leak alarm: a file that holds a real secret and
; is saved by git is a leak. A second panel shows a message to an agent with a made-up placeholder
; in it and says what to do instead of pasting a real value: name the secret, never show it.
; Lesson 3 of the module "A first bot" of the course Vibecoding from zero. The lesson spec it
; illustrates: specs/vibecoding/secrets_out.t27.

; WHAT IT DOES NOT CLAIM: the placeholder is invented for this tool and opens nothing; the page
; takes no real token or key and reads no file from the reader's machine.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_vc_secrets_out;

pub const KIND : str = "widget-tool";
pub const ID : str = "vc-secrets-out";
pub const TITLE : str = "Secrets stay out: tick which files git saves";
pub const DESCRIPTION : str = "Four files of a small bot project: switch each between saved and ignored and see the alarm when a file with a secret is saved. Only a made-up placeholder is used.";
pub const IMAGE_ALT : str = "A black and white list of four files, bot.t27, .env.example, .env and README.md, each with a saved or ignored switch; the .env file holds a secret and an alarm marks it when it is switched to saved.";
pub const HOOK : str = "Flip the switch on the settings file and watch what a saved secret does.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [1]str = ["specs/vibecoding/secrets_out.t27: its four files, the secret flags and the starting saved flags, with tests that pass in the site test runner"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- Numbers the tool relies on ------------------------------------------------------------
pub const K_FILE_COUNT : u8 = 4;
pub const K_HOLDS_SECRET : [4]u8 = [0, 0, 1, 0];
pub const K_TRACKED_START : [4]u8 = [1, 1, 0, 1];

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_FILES_TITLE : str = "Files of the project";
pub const SAY_FILE_NAMES : [4]str = ["bot.t27", ".env.example", ".env", "README.md"];
pub const SAY_FILE_NOTES : [4]str = ["the bot's code", "the names of the settings and a made-up placeholder", "the real settings on your machine", "notes for a reader"];
pub const SAY_SAVED : str = "git saves it";
pub const SAY_IGNORED : str = "git ignores it";
pub const SAY_LEAK : str = "Leak: this file holds a secret and git saves it. Anyone who sees the repository sees the secret.";
pub const SAY_SAFE : str = "No file leaks: the secret stays on your machine.";
pub const SAY_PLACEHOLDER_NAME : str = "BOT_TOKEN";
pub const SAY_PLACEHOLDER : str = "your-token-goes-here";
pub const SAY_PROMPT_TITLE : str = "A message to an agent";
pub const SAY_PROMPT_GOOD : str = "Read the bot's token from the setting named BOT_TOKEN. The value is in my .env file; do not print it.";
pub const SAY_PROMPT_BAD_NOTE : str = "Never paste the value itself into a message: a message can be logged, shared or saved.";
pub const SAY_RESET : str = "Put the switches back";

; --- Tests ----------------------------------------------------------------------------------
test the_secret_is_in_one_file_of_four {
    assert K_FILE_COUNT == 4;
    assert K_HOLDS_SECRET[2] == 1;
    assert K_HOLDS_SECRET[0] + K_HOLDS_SECRET[1] + K_HOLDS_SECRET[3] == 0;
}

test the_starting_switches_leak_nothing {
    assert K_HOLDS_SECRET[0] * K_TRACKED_START[0] == 0;
    assert K_HOLDS_SECRET[1] * K_TRACKED_START[1] == 0;
    assert K_HOLDS_SECRET[2] * K_TRACKED_START[2] == 0;
    assert K_HOLDS_SECRET[3] * K_TRACKED_START[3] == 0;
}

test the_names_match_the_flags {
    assert SAY_FILE_NAMES[K_FILE_COUNT - 1] == "README.md";
    assert SAY_FILE_NAMES[2] == ".env";
}

test the_page_sends_nothing {
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == false;
}
