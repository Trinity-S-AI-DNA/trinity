// SPDX-License-Identifier: Apache-2.0
; specs/widgets/views/vc-spec-to-bot.t27 -- a bot described as a table, checked before anything is built
; Source of truth for public/widgets/vc-spec-to-bot/index.html, a page with NO script (FR-106,
; gHashTag/trinity#1807): t27c gen-text compiles this file and runs page_vc_spec_to_bot, whose bytes the
; workflow .github/workflows/emit-widget-pages.yml writes to that path. Lesson 2 of the module "A first bot" of
; the course Vibecoding from zero. The lesson spec it illustrates: specs/vibecoding/spec_to_bot.t27.
; --
; WHAT IT SHOWS: a bot's spec as a three-row table, command and reply, and the three checks of the lesson spec
; (every command has a reply, no two share one, the route count equals the command count), each marked pass or
; fail. A green table is the point where a bot may be generated from it.
; The widget is a finite-state machine written out in full: one <section> per state, a link per edit, the CSS
; :target selector shows the one the address names (the frame is views/page_kit.t27).
; --
; STATE. (ra, rb, rc): the reply id of each of the three commands, 0 meaning "missing"; the lesson spec has the
; ids 10, 20 and 30. The edits are the links of the page. "Blank this reply" sets the id of its row to 0. "Copy
; the reply above" sets the id of the second row to the id of the first, or the id of the third row to the id of
; the second (the first row has nothing above it). "Put the table back" sets 10, 20, 30. So ra is 10 or 0, rb is
; 20, 0 or 10, rc is 30, 0, 20 or 10: 2 * 3 * 4 = 24 states, K_STATES, every one written, even the few that no
; click reaches, so that no link can name a missing section. The start state, 10, 20, 30, is the default and
; the last section. The checks are the tests of the lesson spec: ra, rb and rc all differ from 0; no two of them
; are equal; the routes equal the commands. Only the start state passes all three.
; ASSUMPTION: the interaction is read from the words of the widget that ran as a script before (SAY_BLANK_BTN,
; SAY_COPY_BTN, SAY_RESET, SAY_PASS, SAY_FAIL, SAY_READY, SAY_NOT_READY): one click on a link is one edit. No
; edit adds or removes a command, so the third check, routes equal commands, passes in every state.
; WHAT IT DOES NOT CLAIM: it generates no bot; it shows only the checks that come before.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_spec_to_bot;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-spec-to-bot";
pub const TITLE : str = "From a spec to a bot: break the table, watch a check go red";
pub const DESCRIPTION : str = "A bot written down as a table of commands and replies. Blank a reply or repeat one and the checks turn red before any bot exists. Nothing is sent.";
pub const IMAGE_ALT : str = "A black and white table of three commands, start, help and about, each with a reply, and three checks beside it, each marked pass; one reply is blanked and one check is marked fail.";
pub const HOOK : str = "Describe the bot as a table, then break the table and see which check catches it.";
pub const SENDS_NOTHING : bool = true;

; --- Numbers the page relies on: the first four are held equal to specs/vibecoding/spec_to_bot.t27 -------
pub const K_COMMAND_COUNT : u8 = 3;
pub const K_COMMAND_IDS : [3]u8 = [1, 2, 3];
pub const K_REPLY_IDS : [3]u8 = [10, 20, 30];
pub const K_CHECK_COUNT : u8 = 3;
pub const K_ROUTE_COUNT : u8 = 3;

; --- The states: the values each reply cell can hold, and how many states that makes ---------------
pub const K_A_VALUES : [2]u8 = [10, 0];
pub const K_B_VALUES : [3]u8 = [20, 0, 10];
pub const K_C_VALUES : [4]u8 = [30, 0, 20, 10];
pub const K_STATES : u32 = 24;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "The bot's spec";
pub const SAY_TABLE_HEAD : [2]str = ["Command", "Reply"];
pub const SAY_COMMANDS : [3]str = ["start", "help", "about"];
pub const SAY_REPLIES : [3]str = ["Hello! I am a first bot.", "Try start, help or about.", "I answer messages one at a time."];
pub const SAY_BLANK : str = "(no reply)";
pub const SAY_BLANK_BTN : str = "Blank this reply";
pub const SAY_COPY_BTN : str = "Copy the reply above";
pub const SAY_RESET : str = "Put the table back";
pub const SAY_CHECKS : [3]str = ["Every command has a reply", "No two commands share a reply", "The routes match the commands"];
pub const SAY_PASS : str = "pass";
pub const SAY_FAIL : str = "fail";
pub const SAY_READY : str = "All checks pass: a bot can be generated from this table.";
pub const SAY_NOT_READY : str = "A check failed: fix the table first, a bot built from it would be wrong.";
pub const SAY_NOTE : str = "The links only move between versions of the table written on this page. No bot is generated and nothing is sent.";
pub const SAY_SOURCE : str = "Rules: t27 spec vibecoding/spec_to_bot.t27";

pub var OUT : [131072]u8 = [0; 131072];

; --- the transitions: the whole logic of the widget, one place ---------------------------------

/// Which of the three replies an id names: its position in K_REPLY_IDS, or 3 for 0, the missing reply.
pub fn bot_reply_slot(id: u32) -> u32 {
    var i : u32 = 0;
    while (i < 3) {
        if ((K_REPLY_IDS[i as usize] as u32) == id) { return i; }
        i = i + 1;
    }
    return 3;
}

/// The edits, as numbers: 0, 1 and 2 blank the reply of that row, 3 copies the first row into the second,
/// 4 copies the second row into the third, 5 puts the table back. The first row after an edit.
pub fn bot_next_a(ra: u32, edit: u32) -> u32 {
    if (edit == 0) { return 0; }
    if (edit == 5) { return K_REPLY_IDS[0] as u32; }
    return ra;
}

/// The second row after an edit.
pub fn bot_next_b(ra: u32, rb: u32, edit: u32) -> u32 {
    if (edit == 1) { return 0; }
    if (edit == 3) { return ra; }
    if (edit == 5) { return K_REPLY_IDS[1] as u32; }
    return rb;
}

/// The third row after an edit.
pub fn bot_next_c(rb: u32, rc: u32, edit: u32) -> u32 {
    if (edit == 2) { return 0; }
    if (edit == 4) { return rb; }
    if (edit == 5) { return K_REPLY_IDS[2] as u32; }
    return rc;
}

/// Can the first row hold v: one of K_A_VALUES.
pub fn bot_in_a(v: u32) -> bool {
    var i : u32 = 0;
    while (i < 2) {
        if ((K_A_VALUES[i as usize] as u32) == v) { return true; }
        i = i + 1;
    }
    return false;
}

/// Can the second row hold v: one of K_B_VALUES.
pub fn bot_in_b(v: u32) -> bool {
    var i : u32 = 0;
    while (i < 3) {
        if ((K_B_VALUES[i as usize] as u32) == v) { return true; }
        i = i + 1;
    }
    return false;
}

/// Can the third row hold v: one of K_C_VALUES.
pub fn bot_in_c(v: u32) -> bool {
    var i : u32 = 0;
    while (i < 4) {
        if ((K_C_VALUES[i as usize] as u32) == v) { return true; }
        i = i + 1;
    }
    return false;
}

/// Check 1, every_command_has_a_reply of the lesson spec: no reply id is 0.
pub fn bot_check_reply(ra: u32, rb: u32, rc: u32) -> bool {
    return ra != 0 and rb != 0 and rc != 0;
}

/// Check 2, no_reply_is_shared_by_two_commands of the lesson spec: no two reply ids are equal.
pub fn bot_check_shared(ra: u32, rb: u32, rc: u32) -> bool {
    return ra != rb and ra != rc and rb != rc;
}

/// Check 3, the_routes_match_the_commands of the lesson spec: as many routes as commands.
pub fn bot_routes_match(routes: u32) -> bool {
    return routes == (K_COMMAND_COUNT as u32);
}

/// All three checks pass: a bot may be generated from the table.
pub fn bot_ready(ra: u32, rb: u32, rc: u32) -> bool {
    if (!bot_check_reply(ra, rb, rc)) { return false; }
    if (!bot_check_shared(ra, rb, rc)) { return false; }
    return bot_routes_match(K_ROUTE_COUNT as u32);
}

/// Is this the table as the lesson spec has it: the start state.
pub fn bot_is_start(ra: u32, rb: u32, rc: u32) -> bool {
    return ra == (K_REPLY_IDS[0] as u32) and rb == (K_REPLY_IDS[1] as u32) and rc == (K_REPLY_IDS[2] as u32);
}

; --- the page ---------------------------------------------------------------------------------

/// The id of a state: s, ra, -, rb, -, rc.
pub fn bot_state_id(o: []u8, n0: u32, ra: u32, rb: u32, rc: u32) -> u32 {
    var n : u32 = raw(o, n0, "s");
    n = num(o, n, ra as u64);
    n = raw(o, n, "-");
    n = num(o, n, rb as u64);
    n = raw(o, n, "-");
    return num(o, n, rc as u64);
}

/// A link to a state.
pub fn bot_link(o: []u8, n0: u32, ra: u32, rb: u32, rc: u32, label: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<a href=\"#");
    n = bot_state_id(o, n, ra, rb, rc);
    n = raw(o, n, "\">");
    n = text(o, n, label);
    return raw(o, n, "</a> ");
}

/// A link to the state that one edit of the state (ra, rb, rc) leads to.
pub fn bot_edit_link(o: []u8, n0: u32, ra: u32, rb: u32, rc: u32, edit: u32, label: []const u8) -> u32 {
    return bot_link(o, n0, bot_next_a(ra, edit), bot_next_b(ra, rb, edit), bot_next_c(rb, rc, edit), label);
}

/// One row of the table: the command, then the reply (or the words for a missing one) and the links that edit it.
/// Row r blanks with edit r and, from the second row on, copies with edit r + 2.
pub fn bot_row(o: []u8, n0: u32, r: u32, ra: u32, rb: u32, rc: u32) -> u32 {
    var id : u32 = ra;
    if (r == 1) { id = rb; }
    if (r == 2) { id = rc; }
    var n : u32 = raw(o, n0, "<tr><td>");
    n = text(o, n, SAY_COMMANDS[r as usize]);
    n = raw(o, n, "</td><td>");
    var slot : u32 = bot_reply_slot(id);
    if (slot < 3) { n = text(o, n, SAY_REPLIES[slot as usize]); } else { n = text(o, n, SAY_BLANK); }
    n = raw(o, n, "<p class=\"nav\">");
    n = bot_edit_link(o, n, ra, rb, rc, r, SAY_BLANK_BTN);
    if (r > 0) { n = bot_edit_link(o, n, ra, rb, rc, r + 2, SAY_COPY_BTN); }
    n = raw(o, n, "</p>");
    return raw(o, n, "</td></tr>\n");
}

/// The table of commands and replies: a head row and one row per command.
pub fn bot_table(o: []u8, n0: u32, ra: u32, rb: u32, rc: u32) -> u32 {
    var n : u32 = raw(o, n0, "<table>\n<caption>");
    n = text(o, n, SAY_TABLE_CAPTION);
    n = raw(o, n, "</caption>\n<thead><tr>");
    var c : u32 = 0;
    while (c < 2) {
        n = raw(o, n, "<th>");
        n = text(o, n, SAY_TABLE_HEAD[c as usize]);
        n = raw(o, n, "</th>");
        c = c + 1;
    }
    n = raw(o, n, "</tr></thead>\n<tbody>\n");
    var r : u32 = 0;
    while (r < 3) {
        n = bot_row(o, n, r, ra, rb, rc);
        r = r + 1;
    }
    return raw(o, n, "</tbody>\n</table>\n");
}

/// One check, as a line: pass or fail in bold, then the words of check i.
pub fn bot_check_li(o: []u8, n0: u32, passed: bool, i: u32) -> u32 {
    if (passed) { return pk_li(o, n0, SAY_PASS, SAY_CHECKS[i as usize]); }
    return pk_li(o, n0, SAY_FAIL, SAY_CHECKS[i as usize]);
}

/// One section: the table, the three checks, the verdict, and the link that puts the table back.
pub fn bot_state(o: []u8, n0: u32, ra: u32, rb: u32, rc: u32) -> u32 {
    var n : u32 = pk_sec_begin(o, n0, bot_is_start(ra, rb, rc));
    n = bot_state_id(o, n, ra, rb, rc);
    n = pk_sec_body(o, n);
    n = bot_table(o, n, ra, rb, rc);
    n = raw(o, n, "<div class=\"box\">\n<ul class=\"list\">\n");
    n = bot_check_li(o, n, bot_check_reply(ra, rb, rc), 0);
    n = bot_check_li(o, n, bot_check_shared(ra, rb, rc), 1);
    n = bot_check_li(o, n, bot_routes_match(K_ROUTE_COUNT as u32), 2);
    n = raw(o, n, "</ul>\n");
    if (bot_ready(ra, rb, rc)) { n = pk_p(o, n, SAY_READY); } else { n = pk_p(o, n, SAY_NOT_READY); }
    n = raw(o, n, "</div>\n<p class=\"nav\">");
    n = bot_edit_link(o, n, ra, rb, rc, 5, SAY_RESET);
    n = raw(o, n, "</p>\n");
    return pk_sec_close(o, n);
}

/// The whole page. Every state except the start state first, the start state last: the default is the last
/// section, as a browser without :has needs. OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    var ia : u32 = 0;
    while (ia < 2) {
        var ib : u32 = 0;
        while (ib < 3) {
            var ic : u32 = 0;
            while (ic < 4) {
                var ra : u32 = K_A_VALUES[ia as usize] as u32;
                var rb : u32 = K_B_VALUES[ib as usize] as u32;
                var rc : u32 = K_C_VALUES[ic as usize] as u32;
                if (!bot_is_start(ra, rb, rc)) { n = bot_state(o, n, ra, rb, rc); }
                ic = ic + 1;
            }
            ib = ib + 1;
        }
        ia = ia + 1;
    }
    n = bot_state(o, n, K_REPLY_IDS[0] as u32, K_REPLY_IDS[1] as u32, K_REPLY_IDS[2] as u32);
    n = pk_p(o, n, SAY_NOTE);
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_spec_to_bot(out: []u8) -> u32 {
    return render_page(out);
}

; --- tests ----------------------------------------------------------------------------------
test the_table_is_three_commands_with_three_replies {
    assert K_COMMAND_COUNT == 3;
    assert K_COMMAND_IDS[K_COMMAND_COUNT - 1] == 3;
    assert K_REPLY_IDS[K_COMMAND_COUNT - 1] == 30;
}

test every_check_has_words {
    assert K_CHECK_COUNT == 3;
    assert SAY_CHECKS[K_CHECK_COUNT - 1] == "The routes match the commands";
}

test the_starting_table_passes_its_checks {
    assert K_REPLY_IDS[0] != 0;
    assert K_REPLY_IDS[1] != 0;
    assert K_REPLY_IDS[2] != 0;
    assert K_REPLY_IDS[0] != K_REPLY_IDS[1];
    assert K_REPLY_IDS[1] != K_REPLY_IDS[2];
}

test the_page_sends_nothing {
    assert SENDS_NOTHING == true;
}

test the_routes_are_as_many_as_the_commands {
    assert K_ROUTE_COUNT == K_COMMAND_COUNT;
    assert K_STATES == 24;
}

test a_reply_id_names_its_reply {
    assert bot_reply_slot(10) == 0;
    assert bot_reply_slot(20) == 1;
    assert bot_reply_slot(30) == 2;
    assert bot_reply_slot(0) == 3;
}

test the_checks_catch_a_blank_and_a_repeat {
    assert bot_check_reply(10, 20, 30) == true;
    assert bot_check_reply(10, 0, 30) == false;
    assert bot_check_shared(10, 20, 30) == true;
    assert bot_check_shared(10, 20, 20) == false;
    assert bot_check_shared(0, 0, 30) == false;
    assert bot_routes_match(3) == true;
    assert bot_routes_match(2) == false;
    assert bot_ready(10, 20, 30) == true;
    assert bot_ready(10, 0, 30) == false;
    assert bot_ready(10, 20, 20) == false;
    assert bot_is_start(10, 20, 30) == true;
    assert bot_is_start(0, 20, 30) == false;
}

test the_edits_do_what_the_links_say {
    assert bot_next_a(10, 0) == 0;
    assert bot_next_a(10, 1) == 10;
    assert bot_next_a(0, 5) == 10;
    assert bot_next_b(10, 20, 1) == 0;
    assert bot_next_b(10, 20, 3) == 10;
    assert bot_next_b(10, 20, 0) == 20;
    assert bot_next_b(0, 0, 5) == 20;
    assert bot_next_c(20, 30, 2) == 0;
    assert bot_next_c(20, 30, 4) == 20;
    assert bot_next_c(20, 30, 3) == 30;
    assert bot_next_c(0, 0, 5) == 30;
}

test every_edit_lands_on_a_state_of_the_page {
    var bad : u32 = 0;
    var ia : u32 = 0;
    while (ia < 2) {
        var ib : u32 = 0;
        while (ib < 3) {
            var ic : u32 = 0;
            while (ic < 4) {
                var ra : u32 = K_A_VALUES[ia as usize] as u32;
                var rb : u32 = K_B_VALUES[ib as usize] as u32;
                var rc : u32 = K_C_VALUES[ic as usize] as u32;
                var edit : u32 = 0;
                while (edit < 6) {
                    if (!bot_in_a(bot_next_a(ra, edit))) { bad = bad + 1; }
                    if (!bot_in_b(bot_next_b(ra, rb, edit))) { bad = bad + 1; }
                    if (!bot_in_c(bot_next_c(rb, rc, edit))) { bad = bad + 1; }
                    edit = edit + 1;
                }
                ic = ic + 1;
            }
            ib = ib + 1;
        }
        ia = ia + 1;
    }
    assert bad == 0;
}

test the_page_has_one_section_per_state_and_one_default {
    const n : u32 = page_vc_spec_to_bot(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<section ") == 24;
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"s10-20-30\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"s0-20-30\">") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"s0-10-20\">") == 1;
}

test every_state_has_a_real_table_and_three_checks {
    const n : u32 = page_vc_spec_to_bot(OUT[0..]);
    assert pk_count(OUT[0..], n, "<table>") == 24;
    assert pk_count(OUT[0..], n, "<th>") == 48;
    assert pk_count(OUT[0..], n, "<td>") == 144;
    assert pk_count(OUT[0..], n, "<li>") == 72;
    assert pk_count(OUT[0..], n, "<li><b>pass</b>Every command has a reply</li>") == 6;
    assert pk_count(OUT[0..], n, "<li><b>pass</b>No two commands share a reply</li>") == 8;
    assert pk_count(OUT[0..], n, "<li><b>pass</b>The routes match the commands</li>") == 24;
}

test only_the_start_state_is_ready {
    const n : u32 = page_vc_spec_to_bot(OUT[0..]);
    assert pk_count(OUT[0..], n, "<p>All checks pass: a bot can be generated from this table.</p>") == 1;
    assert pk_count(OUT[0..], n, "<p>A check failed: fix the table first, a bot built from it would be wrong.</p>") == 23;
}

test the_links_land_on_states_and_every_state_has_them {
    const n : u32 = page_vc_spec_to_bot(OUT[0..]);
    assert pk_has(OUT[0..], n, "<td>start</td><td>Hello! I am a first bot.<p class=\"nav\">");
    assert pk_has(OUT[0..], n, "<td>start</td><td>(no reply)<p class=\"nav\">");
    assert pk_has(OUT[0..], n, "<a href=\"#s0-20-30\">Blank this reply</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#s10-10-30\">Copy the reply above</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#s10-20-20\">Copy the reply above</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#s10-20-30\">Put the table back</a>");
    assert pk_has(OUT[0..], n, "<li><b>fail</b>Every command has a reply</li>");
    assert pk_has(OUT[0..], n, "<li><b>fail</b>No two commands share a reply</li>");
    assert pk_count(OUT[0..], n, ">Blank this reply</a>") == 72;
    assert pk_count(OUT[0..], n, ">Copy the reply above</a>") == 48;
    assert pk_count(OUT[0..], n, ">Put the table back</a>") == 24;
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_spec_to_bot(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"From a spec to a bot: break the table, watch a check go red\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"Describe the bot as a table, then break the table and see which check catches it.\">");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-spec-to-bot/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_spec_to_bot(tiny[0..]) == OVER;
}
