// SPDX-License-Identifier: Apache-2.0
; specs/widgets/html_out.t27 -- the HTML writer every native widget view uses. Epic gHashTag/t27#10937,
; stage "page" of specs/t27f/widget_factory.t27. A tool.js builds its page with el()/h() helpers and
; DOM calls (28 files, 8920 lines); a native view writes HTML text into the buffer the host gave it
; (a region of the wasm's linear memory) and the host sets it as innerHTML. This file is that writer,
; once: put a byte, put text (raw or HTML-escaped), put a number, put an attribute, fill a template.
; --
; STATELESS ON PURPOSE. Every function takes the buffer o and the length written so far n and returns
; the new length. There is no module-level state because t27c's splicer does not carry a `pub var`
; across `use` (measured: a view that imported OUT and OUT_LEN got "undeclared identifier"), and
; follows only the names a module itself mentions, not the names an imported function mentions: so a
; view imports every function it calls, and these functions call only each other through the
; ANCHOR in the view (see jtag_verdict.t27, html_out_anchor). A write past the end of o returns OVER,
; and every function returns OVER at once when it is given OVER, so a view can never write outside o
; and checks once, at the end, with ok(n).
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_html_out;

pub const OVER : u32 = 4294967295;
pub const H_LT : u8 = 60;
pub const H_GT : u8 = 62;
pub const H_AMP : u8 = 38;
pub const H_QUOTE : u8 = 34;
pub const H_APOS : u8 = 39;
pub const H_SPACE : u8 = 32;
pub const H_SLASH : u8 = 47;
pub const H_EQ : u8 = 61;

pub fn ok(n: u32) -> bool {
    return n != OVER;
}

pub fn put(o: []u8, n: u32, b: u8) -> u32 {
    if (n >= (o.len as u32)) { return OVER; }
    o[n as usize] = b;
    return n + 1;
}

/// Raw bytes, as the caller wrote them (markup the view itself owns).
pub fn raw(o: []u8, n0: u32, s: []const u8) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    while (i < s.len) {
        n = put(o, n, s[i]);
        i = i + 1;
    }
    return n;
}

/// One byte of text, escaped: & < > " ' become entities.
pub fn put_escaped(o: []u8, n: u32, b: u8) -> u32 {
    if (b == H_AMP) { return raw(o, n, "&amp;"); }
    if (b == H_LT) { return raw(o, n, "&lt;"); }
    if (b == H_GT) { return raw(o, n, "&gt;"); }
    if (b == H_QUOTE) { return raw(o, n, "&quot;"); }
    if (b == H_APOS) { return raw(o, n, "&#39;"); }
    return put(o, n, b);
}

/// Text from outside the view (data, words).
pub fn text(o: []u8, n0: u32, s: []const u8) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    while (i < s.len) {
        n = put_escaped(o, n, s[i]);
        i = i + 1;
    }
    return n;
}

/// An unsigned decimal.
pub fn num(o: []u8, n0: u32, v0: u64) -> u32 {
    var n : u32 = n0;
    if (v0 == 0) { return put(o, n, 48); }
    var digits : [20]u8 = [0; 20];
    var k : usize = 0;
    var v : u64 = v0;
    while (v > 0) {
        digits[k] = ((v % 10) as u8) + 48;
        v = v / 10;
        k = k + 1;
    }
    while (k > 0) {
        k = k - 1;
        n = put(o, n, digits[k]);
    }
    return n;
}

/// An unsigned decimal with thousands separated by commas, as toLocaleString('en-US') writes it.
pub fn num_grouped(o: []u8, n0: u32, v0: u64) -> u32 {
    var n : u32 = n0;
    if (v0 == 0) { return put(o, n, 48); }
    var digits : [20]u8 = [0; 20];
    var k : usize = 0;
    var v : u64 = v0;
    while (v > 0) {
        digits[k] = ((v % 10) as u8) + 48;
        v = v / 10;
        k = k + 1;
    }
    while (k > 0) {
        k = k - 1;
        n = put(o, n, digits[k]);
        if (k > 0 and k % 3 == 0) { n = put(o, n, 44); }
    }
    return n;
}

/// name="value" with the value escaped, preceded by a space.
pub fn attr(o: []u8, n0: u32, name: []const u8, value: []const u8) -> u32 {
    var n : u32 = put(o, n0, H_SPACE);
    n = raw(o, n, name);
    n = put(o, n, H_EQ);
    n = put(o, n, H_QUOTE);
    n = text(o, n, value);
    return put(o, n, H_QUOTE);
}

/// {0} {1} {2} filled from k values (k up to 3), as fill() does in the tool.js files: a placeholder
/// whose index is not below k stays as written. The template and each value are escaped as text.
pub fn fill(o: []u8, n0: u32, t: []const u8, a: []const u8, b: []const u8, c: []const u8, k: u32) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    while (i < t.len) {
        if (t[i] == 123 and i + 2 < t.len and t[i + 2] == 125 and t[i + 1] >= 48 and t[i + 1] < 48 + (k as u8) and t[i + 1] <= 50) {
            if (t[i + 1] == 48) { n = text(o, n, a); }
            if (t[i + 1] == 49) { n = text(o, n, b); }
            if (t[i + 1] == 50) { n = text(o, n, c); }
            i = i + 3;
        } else {
            n = put_escaped(o, n, t[i]);
            i = i + 1;
        }
    }
    return n;
}

/// Is `name` (the bytes of t between braces) the key k? An empty key matches nothing.
pub fn name_is(t: []const u8, lo: usize, hi: usize, k: []const u8) -> bool {
    if (k.len == 0 or hi - lo != k.len) { return false; }
    var i : usize = 0;
    while (i < k.len) {
        if (t[lo + i] != k[i]) { return false; }
        i = i + 1;
    }
    return true;
}

pub fn is_word_byte(b: u8) -> bool {
    return (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95;
}

/// {name} filled from up to six key/value pairs, as the tool.js files' fill(s, { name: value }) does:
/// a placeholder whose name is not a key stays as written. A name is one or more of [A-Za-z0-9_].
/// The template and each value are escaped as text.
pub fn fill_named(o: []u8, n0: u32, t: []const u8, k0: []const u8, v0: []const u8, k1: []const u8, v1: []const u8, k2: []const u8, v2: []const u8, k3: []const u8, v3: []const u8, k4: []const u8, v4: []const u8, k5: []const u8, v5: []const u8) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    while (i < t.len) {
        var closed : usize = 0;
        if (t[i] == 123) {
            var j : usize = i + 1;
            while (j < t.len and is_word_byte(t[j])) { j = j + 1; }
            if (j > i + 1 and j < t.len and t[j] == 125) { closed = j; }
        }
        if (closed > 0) {
            if (name_is(t, i + 1, closed, k0)) { n = text(o, n, v0); }
            else { if (name_is(t, i + 1, closed, k1)) { n = text(o, n, v1); }
            else { if (name_is(t, i + 1, closed, k2)) { n = text(o, n, v2); }
            else { if (name_is(t, i + 1, closed, k3)) { n = text(o, n, v3); }
            else { if (name_is(t, i + 1, closed, k4)) { n = text(o, n, v4); }
            else { if (name_is(t, i + 1, closed, k5)) { n = text(o, n, v5); }
            else {
                var q : usize = i;
                while (q <= closed) { n = put(o, n, t[q]); q = q + 1; }
            } } } } } }
            i = closed + 1;
        } else {
            n = put_escaped(o, n, t[i]);
            i = i + 1;
        }
    }
    return n;
}

/// An unsigned decimal written to dst (for use as a value in fill()); returns its length.
pub fn dec_to(dst: []u8, v0: u64) -> u32 {
    if (v0 == 0) { dst[0] = 48; return 1; }
    var digits : [20]u8 = [0; 20];
    var k : usize = 0;
    var v : u64 = v0;
    while (v > 0) {
        digits[k] = ((v % 10) as u8) + 48;
        v = v / 10;
        k = k + 1;
    }
    var n : u32 = 0;
    while (k > 0) {
        k = k - 1;
        dst[n as usize] = digits[k];
        n = n + 1;
    }
    return n;
}

pub fn same_bytes(o: []const u8, n: u32, want: []const u8) -> bool {
    if (n != (want.len as u32)) { return false; }
    var i : usize = 0;
    while (i < want.len) {
        if (o[i] != want[i]) { return false; }
        i = i + 1;
    }
    return true;
}

test the_writer_escapes_text_and_leaves_markup_alone {
    var o : [128]u8 = [0; 128];
    var n : u32 = raw(o[0..], 0, "<p");
    n = attr(o[0..], n, "title", "a \"b\" & c");
    n = raw(o[0..], n, ">");
    n = text(o[0..], n, "x < y & 'z'");
    n = raw(o[0..], n, "</p>");
    assert same_bytes(o[0..], n, "<p title=\"a &quot;b&quot; &amp; c\">x &lt; y &amp; &#39;z&#39;</p>");
    assert ok(n);
}

test numbers_are_decimal_and_grouped_like_en_us {
    var o : [128]u8 = [0; 128];
    var n : u32 = num(o[0..], 0, 0);
    n = put(o[0..], n, 32);
    n = num(o[0..], n, 1234567);
    n = put(o[0..], n, 32);
    n = num_grouped(o[0..], n, 0);
    n = put(o[0..], n, 32);
    n = num_grouped(o[0..], n, 999);
    n = put(o[0..], n, 32);
    n = num_grouped(o[0..], n, 1000);
    n = put(o[0..], n, 32);
    n = num_grouped(o[0..], n, 215360);
    n = put(o[0..], n, 32);
    n = num_grouped(o[0..], n, 1234567890);
    assert same_bytes(o[0..], n, "0 1234567 0 999 1,000 215,360 1,234,567,890");
}

test fill_puts_values_in_the_template_and_escapes_them {
    var o : [128]u8 = [0; 128];
    var n : u32 = fill(o[0..], 0, "{0} of {1}, {2}{3}", "Gatle", "<6>", "end", 3);
    assert same_bytes(o[0..], n, "Gatle of &lt;6&gt;, end{3}");
    n = fill(o[0..], 0, "{0}{1} it's", "x", "", "", 1);
    assert same_bytes(o[0..], n, "x{1} it&#39;s");
}

test the_buffer_never_writes_past_its_end {
    var o : [8]u8 = [0; 8];
    var n : u32 = raw(o[0..], 0, "12345678");
    assert ok(n);
    assert n == 8;
    n = raw(o[0..], n, "9");
    assert ok(n) == false;
    n = text(o[0..], n, "more");
    assert n == OVER;
    assert o[7] == 56;
    var p : [4]u8 = [0; 4];
    assert text(p[0..], 0, "<<") == OVER;
}

test named_placeholders_fill_from_pairs_and_unknown_ones_stay {
    var o : [160]u8 = [0; 160];
    var n : u32 = fill_named(o[0..], 0, "Snapshot {at} UTC, {days} days of {repo}; {nope} {a_b} {} {x", "at", "2026-10-04 17:06", "days", "7", "repo", "gHashTag/t27", "", "", "", "", "", "");
    assert same_bytes(o[0..], n, "Snapshot 2026-10-04 17:06 UTC, 7 days of gHashTag/t27; {nope} {a_b} {} {x");
    n = fill_named(o[0..], 0, "{n} of {boundary}: <{n}>", "n", "5 & 6", "boundary", "9", "", "", "", "", "", "", "", "");
    assert same_bytes(o[0..], n, "5 &amp; 6 of 9: &lt;5 &amp; 6&gt;");
    var d : [20]u8 = [0; 20];
    assert dec_to(d[0..], 0) == 1;
    assert dec_to(d[0..], 4294967296) == 10;
    assert d[0] == 52 and d[9] == 54;
}
