; specs/widgets/views/vc-small-step.t27 -- the infographic of lesson 3 of module Prompting, course Vibecoding from zero (specs/course/vibecoding.t27)
; Source of truth for public/widgets/vc-small-step/index.html, a page with NO script (FR-106, gHashTag/trinity#1807):
; t27c gen-text compiles this file and runs page_vc_small_step, whose bytes the workflow
; .github/workflows/emit-widget-pages.yml writes to that path. An infographic: two views of one fact, a real
; <table> that compares one big prompt with five small ones and an ordered list of a five step plan checked after
; every step, one <section> each, switched by the CSS :target selector (the frame is views/page_kit.t27).
; The lesson spec it illustrates: specs/vibecoding/small_step.t27.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_small_step;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-small-step";
pub const TITLE : str = "Vibecoding: one small step per prompt";
pub const DESCRIPTION : str = "A plan of five steps with a check each: the first step that fails is the only prompt to fix. One big prompt leaves five suspects, a small step leaves one. Vibecoding from zero.";
pub const IMAGE_ALT : str = "A black and white diagram of a five step plan: steps 1 and 2 passed, step 3 failed, steps 4 and 5 not reached; a table compares one big prompt with five suspects against small steps with one suspect.";
pub const HOOK : str = "One big prompt fails and you do not know where. Five small ones tell you.";
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "When a plan of five steps fails at step 3";
pub const SAY_TABLE_HEAD : [3]str = ["How you asked", "Checks run", "Suspects"];
pub const SAY_TABLE_CELLS : [6]str = [
    "One big prompt", "1, at the end", "5 steps",
    "Five small prompts", "1 after each step", "1 step: the last"
];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 2;
pub const K_TABLE_CELLS : u16 = 6;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "A plan, checked after every step";
pub const SAY_FLOW_STEPS : [5]str = ["Step 1: passed", "Step 2: passed", "Step 3: failed, fix this one", "Step 4: not reached", "Step 5: not reached"];
pub const K_FLOW_STEPS : u8 = 5;
pub const SAY_NOTE : str = "Step results are the PASSED list of the lesson spec: 1, 1, 0, 0, 0.";
pub const SAY_TAB_TABLE : str = "Big prompt or small steps";
pub const SAY_TAB_FLOW : str = "The five steps";
pub const SAY_SOURCE : str = "Rules: t27 spec vibecoding/small_step.t27";

pub var OUT : [32768]u8 = [0; 32768];

; --- the page ---------------------------------------------------------------------------------

/// The two tabs, as links to the two sections; the one on screen is marked.
pub fn render_nav(o: []u8, n0: u32, on_flow: bool) -> u32 {
    var n : u32 = raw(o, n0, "<p class=\"nav\">");
    n = pk_link(o, n, "table", SAY_TAB_TABLE, !on_flow);
    n = pk_link(o, n, "flow", SAY_TAB_FLOW, on_flow);
    return raw(o, n, "</p>\n");
}

/// The table that compares the two ways of asking: a head row and K_TABLE_ROWS rows of K_TABLE_COLS cells.
pub fn render_table(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<table>\n<caption>");
    n = text(o, n, SAY_TABLE_CAPTION);
    n = raw(o, n, "</caption>\n<thead><tr>");
    var c : u32 = 0;
    while (c < 3) {
        n = raw(o, n, "<th>");
        n = text(o, n, SAY_TABLE_HEAD[c as usize]);
        n = raw(o, n, "</th>");
        c = c + 1;
    }
    n = raw(o, n, "</tr></thead>\n<tbody>\n");
    var r : u32 = 0;
    while (r < 2) {
        n = raw(o, n, "<tr>");
        var k : u32 = 0;
        while (k < 3) {
            n = raw(o, n, "<td>");
            n = text(o, n, SAY_TABLE_CELLS[(r * 3 + k) as usize]);
            n = raw(o, n, "</td>");
            k = k + 1;
        }
        n = raw(o, n, "</tr>\n");
        r = r + 1;
    }
    return raw(o, n, "</tbody>\n</table>\n");
}

/// The five steps of the plan, in order.
pub fn render_flow(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<ol class=\"steps\">\n");
    var i : u32 = 0;
    while (i < 5) {
        n = raw(o, n, "<li>");
        n = text(o, n, SAY_FLOW_STEPS[i as usize]);
        n = raw(o, n, "</li>\n");
        i = i + 1;
    }
    return raw(o, n, "</ol>\n");
}

/// The whole page. The flow is the first section, the table the last and the default (a browser without
/// :has needs the default last). OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    n = pk_sec_open(o, n, "flow", false);
    n = render_nav(o, n, true);
    n = pk_h2(o, n, SAY_FLOW_TITLE);
    n = render_flow(o, n);
    n = pk_sec_close(o, n);
    n = pk_sec_open(o, n, "table", true);
    n = render_nav(o, n, false);
    n = render_table(o, n);
    n = pk_sec_close(o, n);
    n = pk_p(o, n, SAY_NOTE);
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_small_step(out: []u8) -> u32 {
    return render_page(out);
}

; --- tests --------------------------------------------------------------------------------------

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 5;
    assert K_FLOW_STEPS > 1;
}

test the_widget_sends_nothing {
    assert SENDS_NOTHING == true;
}

test the_page_has_a_real_table_and_the_five_steps {
    const n : u32 = page_vc_small_step(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<table>") == 1;
    assert pk_count(OUT[0..], n, "<th>") == 3;
    assert pk_count(OUT[0..], n, "<td>") == 6;
    assert pk_count(OUT[0..], n, "<li>") == 5;
    assert pk_has(OUT[0..], n, "<td>1 step: the last</td>");
    assert pk_has(OUT[0..], n, "<li>Step 3: failed, fix this one</li>");
}

test the_page_has_two_sections_and_the_table_is_the_default {
    const n : u32 = page_vc_small_step(OUT[0..]);
    assert pk_count(OUT[0..], n, "<section ") == 2;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"flow\">") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"table\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_has(OUT[0..], n, "<a href=\"#flow\">The five steps</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#table\" class=\"on\">Big prompt or small steps</a>");
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_small_step(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"Vibecoding: one small step per prompt\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"One big prompt fails and you do not know where. Five small ones tell you.\">");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-small-step/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_small_step(tiny[0..]) == OVER;
}
