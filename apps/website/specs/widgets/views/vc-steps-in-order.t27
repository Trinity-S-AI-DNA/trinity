// SPDX-License-Identifier: Apache-2.0
; specs/widgets/views/vc-steps-in-order.t27 -- the infographic of lesson 2 of the vibecoding course (specs/course/vibecoding.t27)
; Source of truth for public/widgets/vc-steps-in-order/index.html, a page with NO script (FR-106, gHashTag/trinity#1807):
; t27c gen-text compiles this file and runs page_vc_steps_in_order, whose bytes the workflow
; .github/workflows/emit-widget-pages.yml writes to that path. An infographic: two views of one fact, a real
; <table> of two orders of the same two steps and an ordered list of a loop that repeats one step, one
; <section> each, switched by the CSS :target selector (the frame is views/page_kit.t27).
; The lesson spec it illustrates: specs/vibecoding/steps_in_order.t27.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_views_vc_steps_in_order;

use widgets::views::html_out;
use widgets::views::page_kit;

pub const ID : str = "vc-steps-in-order";
pub const TITLE : str = "Vibecoding 2: a program is steps in order";
pub const DESCRIPTION : str = "The same two steps, add 3 and double, in two orders give two answers, and a loop repeats one step. Lesson 2 of the vibecoding course.";
pub const IMAGE_ALT : str = "A black and white table of two orders of the steps add 3 and double, starting at 2: add first gives 10, double first gives 7; a diagram walks the loop add 3 four times, 2, 5, 8, 11, 14.";
pub const HOOK : str = "Start at 2: add 3 then double gives 10, double then add 3 gives 7. A program is steps, and the order is part of it.";
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Two steps, two orders, start at 2";
pub const SAY_TABLE_HEAD : [2]str = ["Order", "Result"];
pub const SAY_TABLE_CELLS : [4]str = ["add 3, then double", "10", "double, then add 3", "7"];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 2;
pub const K_TABLE_CELLS : u16 = 4;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "A loop: add 3, four times";
pub const SAY_FLOW_STEPS : [5]str = ["start: 2", "after 1 step: 5", "after 2 steps: 8", "after 3 steps: 11", "after 4 steps: 14"];
pub const K_FLOW_STEPS : u8 = 5;
pub const SAY_NOTE : str = "Swap two steps and the answer changes; the loop is one step written once.";
pub const SAY_TAB_TABLE : str = "Two orders";
pub const SAY_TAB_FLOW : str = "A loop";
pub const SAY_SOURCE : str = "Rules: t27 spec vibecoding/steps_in_order.t27";

; --- The numbers behind the table ------------------------------------------------------------
pub const K_START : u16 = 2;
pub const K_ADD_FIRST : u16 = 10;
pub const K_DOUBLE_FIRST : u16 = 7;
pub const K_LOOP_END : u16 = 14;
pub const K_LOOP_TIMES : u8 = 4;

pub var OUT : [32768]u8 = [0; 32768];

; --- the page ---------------------------------------------------------------------------------

/// The two tabs, as links to the two sections; the one on screen is marked.
pub fn render_nav(o: []u8, n0: u32, on_flow: bool) -> u32 {
    var n : u32 = raw(o, n0, "<p class=\"nav\">");
    n = pk_link(o, n, "table", SAY_TAB_TABLE, !on_flow);
    n = pk_link(o, n, "flow", SAY_TAB_FLOW, on_flow);
    return raw(o, n, "</p>\n");
}

/// The table of the two orders: a head row and K_TABLE_ROWS rows of K_TABLE_COLS cells.
pub fn render_table(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<table>\n<caption>");
    n = text(o, n, SAY_TABLE_CAPTION);
    n = raw(o, n, "</caption>\n<thead><tr>");
    var c : u32 = 0;
    while (c < 2) {
        n = raw(o, n, "<th>");
        n = text(o, n, SAY_TABLE_HEAD[c as usize]);
        n = raw(o, n, "</th>");
        c = c + 1;
    }
    n = raw(o, n, "</tr></thead>\n<tbody>\n");
    var r : u32 = 0;
    while (r < 2) {
        n = raw(o, n, "<tr>");
        var k : u32 = 0;
        while (k < 2) {
            n = raw(o, n, "<td>");
            n = text(o, n, SAY_TABLE_CELLS[(r * 2 + k) as usize]);
            n = raw(o, n, "</td>");
            k = k + 1;
        }
        n = raw(o, n, "</tr>\n");
        r = r + 1;
    }
    return raw(o, n, "</tbody>\n</table>\n");
}

/// The start and the four steps of the loop, in order.
pub fn render_flow(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<ol class=\"steps\">\n");
    var i : u32 = 0;
    while (i < 5) {
        n = raw(o, n, "<li>");
        n = text(o, n, SAY_FLOW_STEPS[i as usize]);
        n = raw(o, n, "</li>\n");
        i = i + 1;
    }
    return raw(o, n, "</ol>\n");
}

/// The whole page. The flow is the first section, the table the last and the default (a browser without
/// :has needs the default last). OVER when it did not fit.
pub fn render_page(o: []u8) -> u32 {
    var n : u32 = pk_open(o, 0, ID, TITLE, DESCRIPTION, HOOK, IMAGE_ALT);
    n = pk_sec_open(o, n, "flow", false);
    n = render_nav(o, n, true);
    n = pk_h2(o, n, SAY_FLOW_TITLE);
    n = render_flow(o, n);
    n = pk_sec_close(o, n);
    n = pk_sec_open(o, n, "table", true);
    n = render_nav(o, n, false);
    n = render_table(o, n);
    n = pk_sec_close(o, n);
    n = pk_p(o, n, SAY_NOTE);
    return pk_close(o, n, SAY_SOURCE);
}

/// The page the workflow writes: gen-text calls this fn. OVER (no file) when the buffer is too small.
pub fn page_vc_steps_in_order(out: []u8) -> u32 {
    return render_page(out);
}

; --- tests --------------------------------------------------------------------------------------

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_diagram_has_start_and_every_step {
    assert K_FLOW_STEPS == K_LOOP_TIMES + 1;
}

test the_table_numbers_come_from_the_lesson {
    assert K_ADD_FIRST == (K_START + 3) * 2;
    assert K_DOUBLE_FIRST == K_START * 2 + 3;
    assert K_ADD_FIRST != K_DOUBLE_FIRST;
    assert K_LOOP_END == K_START + 3 * 4;
}

test the_widget_sends_nothing {
    assert SENDS_NOTHING == true;
}

test the_page_has_a_real_table_and_the_loop {
    const n : u32 = page_vc_steps_in_order(OUT[0..]);
    assert ok(n);
    assert pk_count(OUT[0..], n, "<table>") == 1;
    assert pk_count(OUT[0..], n, "<th>") == 2;
    assert pk_count(OUT[0..], n, "<td>") == 4;
    assert pk_count(OUT[0..], n, "<li>") == 5;
    assert pk_has(OUT[0..], n, "<td>add 3, then double</td>");
    assert pk_has(OUT[0..], n, "<td>10</td>");
    assert pk_has(OUT[0..], n, "<td>7</td>");
    assert pk_has(OUT[0..], n, "<li>after 4 steps: 14</li>");
}

test the_page_has_two_sections_and_the_table_is_the_default {
    const n : u32 = page_vc_steps_in_order(OUT[0..]);
    assert pk_count(OUT[0..], n, "<section ") == 2;
    assert pk_count(OUT[0..], n, "<section class=\"s\" id=\"flow\">") == 1;
    assert pk_count(OUT[0..], n, "<section class=\"s d\" id=\"table\">") == 1;
    assert pk_count(OUT[0..], n, "class=\"s d\"") == 1;
    assert pk_has(OUT[0..], n, "<a href=\"#flow\">A loop</a>");
    assert pk_has(OUT[0..], n, "<a href=\"#table\" class=\"on\">Two orders</a>");
}

test the_page_carries_the_gallery_metas_and_no_script {
    const n : u32 = page_vc_steps_in_order(OUT[0..]);
    assert pk_has(OUT[0..], n, "<meta property=\"og:title\" content=\"Vibecoding 2: a program is steps in order\">");
    assert pk_has(OUT[0..], n, "<meta name=\"t27:hook\" content=\"Start at 2: add 3 then double gives 10, double then add 3 gives 7. A program is steps, and the order is part of it.\">");
    assert pk_has(OUT[0..], n, "<link rel=\"canonical\" href=\"https://t27.ai/widgets/vc-steps-in-order/\">");
    assert pk_count(OUT[0..], n, "<script") == 0;
    assert pk_count(OUT[0..], n, "<form") == 0;
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert page_vc_steps_in_order(tiny[0..]) == OVER;
}
