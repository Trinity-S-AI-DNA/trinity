// SPDX-License-Identifier: Apache-2.0
; specs/widgets/vc-steps-in-order.t27 -- the infographic of lesson 2 of the vibecoding course (specs/course/vibecoding.t27)
; Source of truth for public/widgets/vc-steps-in-order/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: specs/vibecoding/steps_in_order.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_vc_steps_in_order;

pub const KIND : str = "widget-tool";
pub const ID : str = "vc-steps-in-order";
pub const TITLE : str = "Vibecoding 2: a program is steps in order";
pub const DESCRIPTION : str = "The same two steps, add 3 and double, in two orders give two answers, and a loop repeats one step. Lesson 2 of the vibecoding course.";
pub const IMAGE_ALT : str = "A black and white table of two orders of the steps add 3 and double, starting at 2: add first gives 10, double first gives 7; a diagram walks the loop add 3 four times, 2, 5, 8, 11, 14.";
pub const HOOK : str = "Start at 2: add 3 then double gives 10, double then add 3 gives 7. A program is steps, and the order is part of it.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [1]str = ["The lesson spec specs/vibecoding/steps_in_order.t27, whose tests pass in the site test runner; every number is a constant of that spec"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Two steps, two orders, start at 2";
pub const SAY_TABLE_HEAD : [2]str = ["Order", "Result"];
pub const SAY_TABLE_CELLS : [4]str = ["add 3, then double", "10", "double, then add 3", "7"];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 2;
pub const K_TABLE_CELLS : u16 = 4;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "A loop: add 3, four times";
pub const SAY_FLOW_STEPS : [5]str = ["start: 2", "after 1 step: 5", "after 2 steps: 8", "after 3 steps: 11", "after 4 steps: 14"];
pub const K_FLOW_STEPS : u8 = 5;
pub const SAY_NOTE : str = "Swap two steps and the answer changes; the loop is one step written once.";

; --- The numbers behind the table ------------------------------------------------------------
pub const K_START : u16 = 2;
pub const K_ADD_FIRST : u16 = 10;
pub const K_DOUBLE_FIRST : u16 = 7;
pub const K_LOOP_END : u16 = 14;
pub const K_LOOP_TIMES : u8 = 4;

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_diagram_has_start_and_every_step {
    assert K_FLOW_STEPS == K_LOOP_TIMES + 1;
}

test the_table_numbers_come_from_the_lesson {
    assert K_ADD_FIRST == (K_START + 3) * 2;
    assert K_DOUBLE_FIRST == K_START * 2 + 3;
    assert K_ADD_FIRST != K_DOUBLE_FIRST;
    assert K_LOOP_END == K_START + 3 * 4;
}
