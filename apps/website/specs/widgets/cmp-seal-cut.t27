// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-seal-cut.t27 -- A run cut in the middle of a seal: what stays on disk
; Source of truth for public/widgets/cmp-seal-cut/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-seal-cut/logic.js -- the fn
; bodies of gHashTag/t27 specs/verified/seal_write.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 21 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader picks a way of writing a seal, the moment a run is cut and whether the new seal belongs to another
; spec that derived the same file name. after_cut names what the file holds and cut_safe judges it; a grid asks both for every way and moment.

; WHAT IT DOES NOT CLAIM:  it cuts no run. The lab account of what seal --save and frontier --reseal do is dated 2026-10-18, t27c 0.5.2 at
; master 89254d2; the third way is the rule the spec states, and whether t27c does it is for the spec to say.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_seal_cut;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-seal-cut";
pub const TITLE : str = "A run cut in the middle of a seal: what stays on disk";
pub const DESCRIPTION : str = "Three ways to write a seal file, four moments a run can be cut, and one question: what does the file hold afterwards. Pick a way and a moment and see whether the file can be trusted.";
pub const IMAGE_ALT : str = "Cut card: a run sealing one spec is cut while the file is being written, with the write in place. The file is torn, in red, and not safe. A grid of three ways to write against four cut moments shows the stage then rename way safe at every moment and the other two unsafe at some.";
pub const HOOK : str = "Kill a run halfway through writing a seal and the file may hold half of it. Staging the file and renaming it leaves the old seal or the new, checked one.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/verified/seal_write.t27 (t27 master 90e797659): every answer is after_cut, cut_safe or proto_cut_safe, fn bodies compiled to wasm (logic.js); the lab account is in the spec's header (2026-10-18)", "Course 12 of t27.ai, t27-compiler: lesson 21 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 6;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_PROTO_IN_PLACE : u8 = 1;
pub const K_PROTO_WRITE_THEN_RESTORE : u8 = 2;
pub const K_PROTO_STAGE_THEN_RENAME : u8 = 3;
pub const K_CUT_BEFORE_WRITE : u8 = 1;
pub const K_CUT_DURING_WRITE : u8 = 2;
pub const K_CUT_AFTER_WRITE : u8 = 3;
pub const K_CUT_AFTER_COMMIT : u8 = 4;
pub const K_DISK_OLD : u8 = 1;
pub const K_DISK_NEW_CHECKED : u8 = 2;
pub const K_DISK_NEW_UNCHECKED : u8 = 3;
pub const K_DISK_TORN : u8 = 4;
pub const K_DISK_FOREIGN : u8 = 5;
pub const K_PRESET_PROTO : [4]u8 = [0, 1, 2, 2];
pub const K_PRESET_CUT : [4]u8 = [1, 2, 2, 3];
pub const K_PRESET_FOREIGN : [4]u8 = [0, 1, 0, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine stages a spec passes; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [4]str = ["In place, cut mid-write", "Restore, a foreign seal", "Stage and rename, after the write", "Stage and rename, after the commit"];
pub const SAY_ASK : str = "If a run is killed while it seals a spec, what does the seal file hold?";
pub const SAY_PROTO : str = "way of writing";
pub const SAY_CUT : str = "moment of the cut";
pub const SAY_FOREIGN : str = "the new seal belongs to another spec";
pub const SAY_PROTOS : [3]str = ["write in place", "write, then restore", "stage, then rename"];
pub const SAY_PROTO_LINES : [3]str = ["the seal goes straight onto its file", "the child writes in place and the parent writes the old text back if the new seal is refused", "the seal goes to a staging file and a rename makes it the seal"];
pub const SAY_CUTS : [4]str = ["before the write", "during the write", "after the write", "after the commit"];
pub const SAY_CUTS_SHORT : [4]str = ["before", "mid-write", "written", "committed"];
pub const SAY_DISKS : [5]str = ["the old seal", "the new seal, checked", "the new seal, unchecked", "a torn file", "another spec's seal"];
pub const SAY_SAFE : str = "safe: the file is the old seal or the new checked one";
pub const SAY_UNSAFE : str = "not safe";
pub const SAY_ALL_SAFE : str = "safe at every moment";
pub const SAY_NOT_ALL_SAFE : str = "not safe at every moment";
pub const SAY_GRID : str = "every way against every moment";
pub const SAY_NOTE : str = "A seal is safe to find on disk only if it is the old one or the new one that was checked. The rename is the commit: until it happens the seal file was never touched.";
pub const SAY_SOURCE : str = "Logic: t27 spec verified/seal_write.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_has_a_stage_of_nine {
    assert K_STAGE < 9;
    assert K_STAGE == 6;
}

test three_ways_four_moments_five_states {
    assert K_PROTO_IN_PLACE == 1;
    assert K_PROTO_STAGE_THEN_RENAME == 3;
    assert K_CUT_AFTER_COMMIT == 4;
    assert K_DISK_FOREIGN == 5;
    assert K_DISK_TORN == K_DISK_NEW_UNCHECKED + 1;
}

test the_start_is_an_in_place_write_cut_mid_write {
    assert K_PRESET_PROTO[0] + 1 == K_PROTO_IN_PLACE;
    assert K_PRESET_CUT[0] + 1 == K_CUT_DURING_WRITE;
    assert K_PRESET_PROTO[3] + 1 == K_PROTO_STAGE_THEN_RENAME;
    assert K_PRESET_FOREIGN[1] == 1;
    assert K_START_PRESET == 0;
}
