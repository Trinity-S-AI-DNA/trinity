// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-int-types.t27 -- What a type name means: width, suffix and trimmed spaces
; Source of truth for public/widgets/cmp-int-types/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-int-types/logic.js -- the fn
; bodies of gHashTag/t27 specs/compiler/int_type_names.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 7 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader types a type name or takes a sample. The widget asks int_rank for its storage width,
; is_integer_type_suffix whether it is a suffix of a typed builtin, and trim_lo and trim_hi for the bytes the spaces leave.

; WHERE THE FNS COME FROM:
; trim_lo and trim_hi are not declared in int_type_names.t27: it takes them through use from tri/t27b/type_text.t27,
; which is not vendored beside this widget. Their bodies are compiled into logic.js with the rest.

; WHAT IT DOES NOT CLAIM:  int_value_bits and uint_bits return an optional number, which wasm cannot take, so the value bits of
; the signed types and the u1 to u64 widths are not run here. The rung list is the ranks the spec names, as words.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_int_types;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-int-types";
pub const TITLE : str = "What a type name means: width, suffix and trimmed spaces";
pub const DESCRIPTION : str = "A type is first a text. Type one name and see what the reference compiler makes of it: its storage width in bits, whether it is an integer suffix, and the span left after the spaces are trimmed.";
pub const IMAGE_ALT : str = "Type name card: the text u8 with a leading and a trailing space. The trim keeps the two middle bytes, the width is 8 bits and a ladder of 8, 16, 32, 64 and 128 lights the first rung, but the text is not an integer suffix, because a suffix is read without trimming.";
pub const HOOK : str = "A space-padded u8 is one type to the width rule and a different text to the suffix rule. Both rules are written once, in one spec.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/compiler/int_type_names.t27 (t27 master 90e797659): int_rank and is_integer_type_suffix, and trim_lo and trim_hi spliced in from specs/tri/t27b/type_text.t27 through use, fn bodies compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 7 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 2;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_WIDTHS : [5]u8 = [8, 16, 32, 64, 128];
pub const K_MAX_TEXT : u8 = 12;
pub const K_START_SAMPLE : u8 = 3;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine steps of this course; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_SAMPLES : [8]str = ["u8", "i32", "usize", " u8 ", "u128", "u3", "f32", "u8x"];
pub const SAY_ASK : str = "What does the compiler make of a type name before it knows any types?";
pub const SAY_TEXT_LABEL : str = "A type name";
pub const SAY_RANK : str = "width: {0} bits";
pub const SAY_RANK_NONE : str = "not a Rust integer";
pub const SAY_SUFFIX : str = "integer suffix";
pub const SAY_TRIM : str = "bytes kept by trim";
pub const SAY_YES : str = "yes";
pub const SAY_NO : str = "no";
pub const SAY_RUNG : str = "{0} bits";
pub const SAY_NOTHING : str = "An empty name has no width.";
pub const SAY_NOTE : str = "The width rule trims the spaces first and counts usize as 64 bits. The suffix rule does not trim: it is applied to a name cut from a builtin such as cast_i8, so a space makes it a different text.";
pub const SAY_SOURCE : str = "Logic: t27 spec compiler/int_type_names.t27, with trim_lo and trim_hi from tri/t27b/type_text.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_is_one_of_nine_course_steps {
    assert K_STAGE < 9;
    assert K_STAGE == 2;
}

test five_widths_from_a_byte_to_sixteen_bytes {
    assert K_WIDTHS[0] == 8;
    assert K_WIDTHS[3] == 64;
    assert K_WIDTHS[4] == 128;
    assert K_WIDTHS[1] * 2 == K_WIDTHS[2];
}

test the_start_has_spaces_to_trim {
    assert K_START_SAMPLE == 3;
    assert K_MAX_TEXT == 12;
}
