// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-sieve.t27 -- The compiler sieve: nine compilers, ten filters, one honest table
; Source of truth for public/widgets/cmp-sieve/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-sieve/logic.js -- the fn
; bodies of gHashTag/t27 specs/compiler/theory/sieve.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 22 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader picks a compiler, a filter and which date of the t27c and t27b rows to show. The grid is value for every
; cell; the facts are the cell, fix_issue, kills for the filter and verdict for the compiler.

; WHAT IT DOES NOT CLAIM:  the table says where t27 is known to fall short and how little is known of the others. It does not rank the
; compilers, and the spec says it may not be read as t27 is worse than X. The cells come from the spec's cited sources, not from this page.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_sieve;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-sieve";
pub const TITLE : str = "The compiler sieve: nine compilers, ten filters, one honest table";
pub const DESCRIPTION : str = "Ten yes-or-no questions asked of nine compilers, with unknown kept apart from no. Pick a compiler, a filter and a date of the t27 rows, and see the cell, its fix issue and what the filter removes.";
pub const IMAGE_ALT : str = "Sieve card: a grid of nine compilers by ten filters, each cell true, false, unknown or not applicable. The seven outside compilers have no false cell. The t27c row has four false cells, and its reproducible builds cell is false with fix issue 8178. Only false removes a compiler, and only t27c and t27b are removed.";
pub const HOOK : str = "Unknown is not no. On published evidence the sieve removes none of the seven outside compilers, and only the two we know best, our own, fall out of it.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/compiler/theory/sieve.t27 (t27 master 90e797659): every cell is value, value_at_682564f48 or value_at_be9757784, and the removed set is kills, fn bodies compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 22 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 7;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_CANDIDATES : u8 = 9;
pub const K_FILTERS : u8 = 10;
pub const K_T27C : u8 = 7;
pub const K_T27B : u8 = 8;
pub const K_FALSE3 : u8 = 0;
pub const K_UNKNOWN3 : u8 = 1;
pub const K_TRUE3 : u8 = 2;
pub const K_NA3 : u8 = 3;
pub const K_PRESET_CANDIDATE : [4]u8 = [7, 7, 8, 6];
pub const K_PRESET_FILTER : [4]u8 = [8, 1, 2, 2];
pub const K_PRESET_DATE : [4]u8 = [2, 0, 0, 2];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine stages a spec passes; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [4]str = ["t27c, reproducible builds", "t27c, validator, first look", "t27b, differential, first look", "LLVM, differential"];
pub const SAY_ASK : str = "Which compilers does a plain table of ten questions leave standing?";
pub const SAY_CANDIDATE : str = "compiler";
pub const SAY_FILTER : str = "filter";
pub const SAY_DATE : str = "rows of t27c and t27b as of";
pub const SAY_CANDIDATES : [9]str = ["Zig aarch64", "Zig x86_64", "cg_clif", "Go SSA", "QBE", "CompCert", "LLVM", "t27c", "t27b"];
pub const SAY_FILTERS : [10]str = ["C1 proved", "C2 validator", "C3 differential", "C4 independent bootstrap", "C5 reference interpreter", "C6 warmup measured", "C7 speed published", "C8 retargetable", "C9 reproducible build", "C10 vacuity aware"];
pub const SAY_DATES : [3]str = ["2026-10-05, master 682564f48", "2026-10-09, master be9757784", "the spec as vendored, master 90e797659"];
pub const SAY_VALUES : [4]str = ["false", "unknown", "true", "n/a"];
pub const SAY_MARKS : [4]str = ["F", "?", "T", "-"];
pub const SAY_CELL : str = "cell";
pub const SAY_FIX : str = "fix issue";
pub const SAY_NO_FIX : str = "none recorded";
pub const SAY_REMOVES : str = "this filter removes";
pub const SAY_REMOVES_NONE : str = "nobody";
pub const SAY_VERDICT : str = "verdict of this compiler";
pub const SAY_NOTE : str = "Only false removes a compiler. n/a means the question does not apply, and unknown means no opened source states the cell: never a guess. For the outside compilers a cell is false only if a source says so; for t27c and t27b we are the source.";
pub const SAY_SOURCE : str = "Logic: t27 spec compiler/theory/sieve.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_has_a_stage_of_nine {
    assert K_STAGE < 9;
    assert K_STAGE == 7;
}

test nine_compilers_and_ten_filters {
    assert K_CANDIDATES == 9;
    assert K_FILTERS == 10;
    assert K_T27C + 1 == K_T27B;
    assert K_T27B + 1 == K_CANDIDATES;
}

test the_four_values_run_from_false_to_not_applicable {
    assert K_FALSE3 == 0;
    assert K_UNKNOWN3 == 1;
    assert K_TRUE3 == 2;
    assert K_NA3 == 3;
    assert K_PRESET_CANDIDATE[0] == K_T27C;
    assert K_START_PRESET == 0;
}
