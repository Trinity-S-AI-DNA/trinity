// SPDX-License-Identifier: Apache-2.0
; specs/widgets/line-bounce.t27 -- a step down a transmission line, arrival by arrival
; Source of truth for public/widgets/line-bounce/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every word is a SAY_ constant here, every number a K_ constant, and every computed value
; comes from public/widgets/line-bounce/logic.js -- the fn bodies of gHashTag/t27
; specs/fpga/line_bounce.t27 (t27#8931) compiled to wasm, beside its copy logic.t27.
; scripts/widget-logic.mjs stops the build when logic.js was built from another version of it.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader sets the driver (VS, RS), the line (Z0, TD) and the load (RL or open),
; or picks a preset. The page draws the load voltage after every arrival and the source voltage
; after every return -- the bounce or lattice diagram of Johnson and Graham, ch. 4 -- with the
; settled DC value, the two reflection coefficients, the first overshoot and the shape: matched,
; source-matched, ringing or a staircase, and what to change to make it clean.

; WHAT IT DOES NOT CLAIM: a lossless line, a resistive load, an ideal step. Loss, the edge rate,
; vias and the input capacitance of a real pin are outside it.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_line_bounce;

pub const KIND : str = "widget-tool";
pub const ID : str = "line-bounce";
pub const TITLE : str = "Line bounce: a step down a transmission line, arrival by arrival";
pub const DESCRIPTION : str = "Set the driver, the line and the load. See the far end ring or climb, arrival by arrival, and which termination makes it clean.";
pub const IMAGE_ALT : str = "Line bounce card: a 1 V step from a 25 ohm driver into a 50 ohm line with an open end. The far end jumps to 1.33 V, falls to 0.89 V, rises to 1.04 V and settles at 1 V: the textbook lattice, ringing because the two reflection coefficients have opposite signs.";
pub const HOOK : str = "A 25 ohm driver into an open 50 ohm line overshoots by a third. One series resistor fixes it. Watch every arrival.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/line_bounce.t27 (t27#8931): every value on the page is its fn bodies, compiled to wasm (logic.js), with 7 tests", "H. Johnson, M. Graham, High-Speed Digital Design, 1993, ch. 4: the lattice of VS 1 V, RS 25 ohm, Z0 50 ohm, open end: 1.333, 0.889, 1.037, 0.988 V", "E. Bogatin, Signal and Power Integrity -- Simplified, 3rd ed., ch. 8: reflection coefficient (R - Z0) / (R + Z0) and termination"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Presets: VS (mV), RS, Z0, RL (ohm; 0 = open), TD (ps) ---------------------------------------
pub const K_PRESET_VS_MV : [4]u16 = [1000, 3300, 1000, 1000];
pub const K_PRESET_RS : [4]u16 = [25, 50, 25, 150];
pub const K_PRESET_Z0 : [4]u16 = [50, 50, 50, 50];
pub const K_PRESET_RL : [4]u16 = [0, 0, 50, 0];
pub const K_PRESET_TD_PS : [4]u16 = [1000, 1000, 1000, 1000];
pub const K_START_PRESET : u8 = 0;
; The logic spec's own numbers (logic.t27 OPEN_OHMS, MAX_ARRIVALS); scripts/widget-logic.mjs holds them equal.
pub const K_OPEN_OHMS : u32 = 1000000;
pub const K_MAX_ARRIVALS : u8 = 12;
; Input bounds (the form refuses anything outside).
pub const K_MAX_OHMS : u16 = 10000;
pub const K_MAX_MV : u16 = 5000;
pub const K_MAX_TD_PS : u16 = 20000;

; --- Words on screen ------------------------------------------------------------------------
; Templates take {0}, {1}, ... in order.
pub const SAY_LOADING : str = "Loading";
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["textbook: 25 ohm into an open 50 ohm line", "series terminated, 3.3 V", "parallel terminated", "weak driver, 150 ohm"];
pub const SAY_VS : str = "Driver step, mV";
pub const SAY_RS : str = "Driver resistance RS, ohm";
pub const SAY_Z0 : str = "Line impedance Z0, ohm";
pub const SAY_RL : str = "Load RL, ohm (0 = open)";
pub const SAY_TD : str = "One-way delay TD, ps";
pub const SAY_BAD_INPUT : str = "Use whole numbers in range: ohms up to {0}, millivolts up to {1}, delay up to {2} ps; Z0 above 0.";
pub const SAY_FAR : str = "far end (load)";
pub const SAY_NEAR : str = "near end (driver)";
pub const SAY_SETTLE : str = "settles at {0} V";
pub const SAY_AXIS_T : str = "time, in TD";
pub const SAY_GAMMAS : str = "reflection at the driver {0}, at the load {1}; launched {2} V";
pub const SAY_OVERSHOOT : str = "first arrival {0} V: {1}% from the end value";
pub const SAY_SHAPE_NAMES : [4]str = ["matched load: one arrival, no reflection", "series terminated: one reflection, then flat", "rings: overshoot and undershoot", "staircase: climbs to the end value"];
pub const SAY_SHAPE_TIPS : [4]str = ["Clean. The load absorbs the wave; it costs DC current through RL.", "Clean at the far end. The near end sits at half for 2 TD -- fine for a point-to-point link.", "Add a series resistor so RS + R = Z0, or a parallel RL = Z0 at the far end.", "Slow but clean: every arrival climbs. A stronger driver (RS closer to Z0) gets there sooner."];
pub const SAY_TABLE : str = "arrival {0} at {1} TD: {2} V";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/line_bounce.t27, compiled";

test the_presets_are_the_spec_vectors {
    assert K_PRESET_RS[0] == 25;
    assert K_PRESET_Z0[0] == 50;
    assert K_PRESET_RL[0] == 0;
    assert K_PRESET_RS[1] == K_PRESET_Z0[1];
    assert K_PRESET_RL[2] == K_PRESET_Z0[2];
}

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_START_PRESET == 0;
}
