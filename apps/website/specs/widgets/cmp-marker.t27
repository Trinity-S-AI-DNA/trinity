// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-marker.t27 -- The mark of a generated file: where it must sit
; Source of truth for public/widgets/cmp-marker/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-marker/logic.js -- the fn
; bodies of gHashTag/t27 specs/compiler/compile_output.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 17 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader slides the line of the marker through a twelve-line file and the length of the head. The widget asks
; marked_within for the head set and marked_generated for the head the spec fixes, and four taps put the marker where each backend does.

; WHAT IT DOES NOT CLAIM:  it reads no file: the marker line is what the reader sets. The lines of the four backends are the spec's
; constants, held equal to them. Which line a backend really writes today is for t27c to say.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_marker;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-marker";
pub const TITLE : str = "The mark of a generated file: where it must sit";
pub const DESCRIPTION : str = "Every backend writes the words generated by t27c in its header. A file counts as generated only if that marker sits in its first lines. Move the marker down a file and see where it stops counting.";
pub const IMAGE_ALT : str = "Marker card: a file of twelve lines with the marker on line 3, as the Verilog and C backends write it. The first five lines, the head, are shaded, and the marker is inside them, so the file counts as generated. The same marker on line 8 would be a quote or a comment, not a header.";
pub const HOOK : str = "A marker on line 3 marks a generated file; the same words on line 8 are a comment. The head is five lines, and four backends write theirs on line 2 or 3.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/compiler/compile_output.t27 (t27 master 90e797659): every verdict is marked_within or marked_generated, fn bodies compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 17 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 5;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_MARK_HEAD_LINES : u8 = 5;
pub const K_MARK_LINE_ZIG : u8 = 2;
pub const K_MARK_LINE_RUST : u8 = 2;
pub const K_MARK_LINE_VERILOG : u8 = 3;
pub const K_MARK_LINE_C : u8 = 3;
pub const K_FILE_LINES : u8 = 12;
pub const K_MAX_HEAD : u8 = 8;
pub const K_PRESET_MARK : [5]u8 = [3, 2, 3, 8, 0];
pub const K_PRESET_HEAD : [5]u8 = [5, 5, 5, 5, 5];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine steps of this course; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [5]str = ["Verilog and C: line 3", "Zig: line 2", "C again", "A quote on line 8", "No marker"];
pub const SAY_ASK : str = "Where in a file must the words generated by t27c sit to count?";
pub const SAY_MARK : str = "line of the marker";
pub const SAY_HEAD : str = "lines of the head";
pub const SAY_NO_MARK : str = "none";
pub const SAY_BACKENDS : [4]str = ["Zig", "Rust", "Verilog", "C"];
pub const SAY_LINE_N : str = "line {0}";
pub const SAY_MARKER : str = "generated by t27c";
pub const SAY_HEAD_TAG : str = "head";
pub const SAY_WITHIN : str = "marked_within the head you set";
pub const SAY_GENERATED : str = "marked_generated, the head the spec fixes";
pub const SAY_YES : str = "yes";
pub const SAY_NO : str = "no";
pub const SAY_NOTE : str = "A line number of 0 means the marker is nowhere in the file. The spec counted 75 committed generated files beside a same-stem spec and found the marker on line 2 in 14 of them and on line 3 in 61.";
pub const SAY_SOURCE : str = "Logic: t27 spec compiler/compile_output.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_is_one_of_nine_course_steps {
    assert K_STAGE < 9;
    assert K_STAGE == 5;
}

test the_head_is_five_lines_and_the_backends_sit_inside_it {
    assert K_MARK_HEAD_LINES == 5;
    assert K_MARK_LINE_ZIG == 2;
    assert K_MARK_LINE_RUST == 2;
    assert K_MARK_LINE_VERILOG == 3;
    assert K_MARK_LINE_C == 3;
    assert K_MARK_LINE_C <= K_MARK_HEAD_LINES;
}

test presets_follow_the_backend_lines {
    assert K_PRESET_MARK[0] == K_MARK_LINE_VERILOG;
    assert K_PRESET_MARK[1] == K_MARK_LINE_ZIG;
    assert K_PRESET_MARK[3] > K_MARK_HEAD_LINES;
    assert K_PRESET_MARK[3] <= K_FILE_LINES;
    assert K_START_PRESET == 0;
}
