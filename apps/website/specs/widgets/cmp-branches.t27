// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-branches.t27 -- An if that is a value: seven bodies, one input
; Source of truth for public/widgets/cmp-branches/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-branches/logic.js -- the fn
; bodies of gHashTag/t27 specs/compiler/verilog_branch_context.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 9 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader slides one input from 0 to 511 and picks one of seven bodies. Every body is called with the input
; and its result is listed; the picked body's text is shown beside its answer.

; WHAT IT DOES NOT CLAIM:  it runs the bodies as WebAssembly, not as Verilog: the spec's header says conditional bodies preserve
; value returns, and this page does not simulate a circuit. The two fns that need a 64-bit result are not run.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_branches;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-branches";
pub const TITLE : str = "An if that is a value: seven bodies, one input";
pub const DESCRIPTION : str = "In t27 an if/else can be a value, and the Verilog backend must keep it. Seven small functions pin the cases. Slide one input and read what each compiled body returns.";
pub const IMAGE_ALT : str = "Branch card: the input 19 given to seven functions. branch_value returns 182, nested_value 20, local_branch 31, narrow_value 19, explicit_value 16, ordinary_if 18 and on_comb 182. The branch_value row is selected and its source text is shown beside the answer.";
pub const HOOK : str = "branch_value(19) is 182, and the spec's own test asserts the same number: a conditional that returns a value must survive the lowering, and seven bodies pin it.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/compiler/verilog_branch_context.t27 (t27 master 90e797659): every result is one of its seven fn bodies compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 9 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 2;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_MAX_INPUT : u16 = 511;
pub const K_PRESET_INPUT : [5]u16 = [19, 0, 64, 128, 511];
pub const K_PRESET_FN : [5]u8 = [0, 0, 1, 2, 3];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine steps of this course; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [5]str = ["The spec's 19", "Zero", "Across 64", "Across 128", "Past a byte"];
pub const SAY_ASK : str = "An if/else can be a value: what does each body hand back?";
pub const SAY_INPUT : str = "input";
pub const SAY_FN : str = "body";
pub const SAY_FNS : [7]str = ["branch_value", "nested_value", "local_branch", "narrow_value", "explicit_value", "ordinary_if", "on_comb"];
pub const SAY_BODIES : [7]str = ["if value == 0 { 0 } else { value ^ 165 }", "if value < 128 { if value < 64 { value + 1 } else { value ^ 1 } } else { value - 1 }", "if value == 0 { let bias = 9; bias ^ 0 } else { let bias = 12; value ^ bias }", "if value == 0 { 7 } else { value as u8 }", "if value == 0 { return 17 }  return value ^ 3", "result = 5  if value > 0 { result = value }  return result ^ 1", "return branch_value(value)"];
pub const SAY_RESULT : str = "returns {0}";
pub const SAY_NOTE : str = "Each body is a different place an if/else can sit: as the whole function, nested, with locals, narrowed to a byte, as a plain return, as a statement, and called by another body. All seven must return the same value after lowering.";
pub const SAY_SOURCE : str = "Logic: t27 spec compiler/verilog_branch_context.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_is_one_of_nine_course_steps {
    assert K_STAGE < 9;
    assert K_STAGE == 2;
}

test the_input_range_is_nine_bits {
    assert K_MAX_INPUT == 511;
    assert K_MAX_INPUT + 1 == 512;
}

test presets_are_in_range_and_the_start_is_the_specs_own_input {
    assert K_PRESET_INPUT[0] == 19;
    assert K_PRESET_INPUT[4] == K_MAX_INPUT;
    assert K_START_PRESET == 0;
}
