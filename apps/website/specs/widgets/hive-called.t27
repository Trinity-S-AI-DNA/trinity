// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-called.t27 -- Who is called: an agent bot in a group of agents
; Source of truth for public/widgets/hive-called/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-called/logic.js -- the fn
; bodies of gHashTag/t27 specs/automation/agent-hive-group.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 22 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader toggles tagged, the all tag, a reply to this agent, and the agent's own
; topic. The two cards are addressed(flags, from a person) and addressed(flags, from a bot); every
; table cell is addressed of its row's single flag and its column's sender.

; WHAT IT DOES NOT CLAIM:  it sends nothing to Telegram; a live group also needs Bot-to-Bot
; Communication Mode on in @BotFather.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_called;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-called";
pub const TITLE : str = "Who is called: an agent bot in a group of agents";
pub const DESCRIPTION : str = "Each agent has its own bot and topic in one group. Toggle how a message reaches an agent: addressed answers for a person and for another agent's bot.";
pub const IMAGE_ALT : str = "Called card: a message written in the agent's own topic, with no tag and no reply. The person's message wakes the agent, green; the same message from another agent's bot does not, grey. A table of five ways to call reads tag, reply, all tag, own topic, nothing for both senders.";
pub const HOOK : str = "A bot never triggers the whole hive and never wakes a topic's owner by merely writing there. Only a tag or a reply calls an agent from another bot.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/automation/agent-hive-group.t27 (t27 master c42f8fb40): every value on the page is addressed, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 22 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_FLAGS : u8 = 4;
pub const K_PRESET_TAGGED : [4]u8 = [0, 1, 0, 0];
pub const K_PRESET_ALL : [4]u8 = [0, 0, 1, 0];
pub const K_PRESET_REPLY : [4]u8 = [0, 0, 0, 1];
pub const K_PRESET_TOPIC : [4]u8 = [1, 0, 0, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["In the agent's topic", "Tagged by name", "The all tag", "A reply to the agent"];
pub const SAY_ASK : str = "A message lands in the hive group. Which agent must answer it?";
pub const SAY_FLAGS : [4]str = ["tagged by name", "the @all tag", "a reply to this agent", "in this agent's topic"];
pub const SAY_SENDERS : [2]str = ["a person writes", "another agent's bot writes"];
pub const SAY_CALLED : str = "called: answers";
pub const SAY_QUIET : str = "not called: stays quiet";
pub const SAY_TABLE : str = "one way at a time";
pub const SAY_NOTHING : str = "none of them";
pub const SAY_YES : str = "calls";
pub const SAY_NO : str = "quiet";
pub const SAY_NOTE : str = "Telegram gives no loop protection between bots. So the rule is narrow for bots: a tag or a reply, nothing else, and the depth and the cooldown of the next two lessons stop the rest.";
pub const SAY_SOURCE : str = "Logic: t27 spec automation/agent-hive-group.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test four_ways_to_call {
    assert K_FLAGS == 4;
    assert K_PRESET_TOPIC[0] == 1;
}

test each_preset_sets_one_flag {
    assert K_PRESET_TAGGED[1] + K_PRESET_ALL[1] + K_PRESET_REPLY[1] + K_PRESET_TOPIC[1] == 1;
    assert K_PRESET_TAGGED[0] + K_PRESET_ALL[0] + K_PRESET_REPLY[0] + K_PRESET_TOPIC[0] == 1;
}
