; --- Tests ------------------------------------------------------------------------------------
test the_grid_is_26_by_26 {
    assert K_GRID_ROWS == 26;
    assert K_GRID_COLS == 26;
    assert K_BALLS == (K_GRID_ROWS as u16) * (K_GRID_COLS as u16);
    assert K_GRID_ROWS == K_ROWS_SINGLE + K_ROWS_DOUBLE;
    assert K_ROWS_SINGLE + K_SKIPPED_LETTERS == 26;
    assert SAY_SKIPPED_LETTERS[0] == "I";
    assert SAY_SKIPPED_LETTERS[5] == "Z";
}

test every_ball_is_listed_or_counted_as_unlisted {
    assert K_LISTED_PINS + K_UNLISTED_BALLS == K_BALLS;
    assert K_LISTED_PINS == K_USER_IO + K_MGT_PINS + K_DEDICATED_LISTED;
    assert K_TYPE_COUNTS[0] + K_TYPE_COUNTS[1] + K_TYPE_COUNTS[2] + K_TYPE_COUNTS[3] + K_TYPE_COUNTS[4] + K_TYPE_COUNTS[5] + K_TYPE_COUNTS[6] + K_TYPE_COUNTS[7] == K_BALLS;
    assert K_TYPE_COUNTS[7] == K_UNLISTED_BALLS;
    assert K_TYPE_COUNTS[5] == K_MGT_PINS;
    assert K_TYPE_COUNTS[6] == K_DEDICATED_LISTED;
}

test the_bank_count_matches_the_data {
    assert K_BANKS == 11;
    assert K_BANKS == K_IO_BANKS + K_MGT_BANKS + 1;
    assert K_USER_IO == (K_IO_BANKS as u16) * (K_IO_PER_BANK as u16);
    assert K_MGT_PINS == K_MGT_BANKS * K_MGT_PINS_PER_BANK;
    assert K_BANK_IDS[0] == 12;
    assert K_BANK_IDS[7] == 35;
    assert K_BANK_IDS[8] == 213;
    assert K_BANK_IDS[9] == 216;
    assert K_BANK_IDS[10] == 0;
}

test the_100t_fits_inside_the_200t_package {
    assert K_A100T_PINS < K_USER_IO;
    assert K_A100T_PINS > 0;
}

test the_demo_counts_add_up {
    assert K_DEMO_OK[0] + K_DEMO_FLAGGED[0] == K_DEMO_PORTS[0];
    assert K_DEMO_OK[1] + K_DEMO_FLAGGED[1] == K_DEMO_PORTS[1];
    assert K_DEMO_OK[2] + K_DEMO_FLAGGED[2] == K_DEMO_PORTS[2];
    assert K_DEMO_OK[3] + K_DEMO_FLAGGED[3] == K_DEMO_PORTS[3];
    assert SAY_DEMO_IDS[0] == "wukong";
    assert K_DEMO_FLAGGED[0] == 13;
}

test the_page_reads_files_and_sends_nothing {
    assert READS_LOCAL_FILES == true;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
    assert K_VCCO_MV[0] == 3300;
    assert SAY_VCCO_STD[0] == "LVCMOS33";
}


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, issue #10938, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/pin-map/tool.js (340 lines of hand-written JavaScript). The
; XDC reader and the lint are NOT rewritten here: they are imported from pin_map_logic.t27 (the port of
; xdc.js, differential-tested). The words above are unchanged and are the only words the view prints.
; The host protocol is jtag_verdict.t27's, plus (all optional, the host calls what the wasm exports):
;   w_init(hash)              the page opens: state "loading"
;   w_data(i, bytes)          file i of K_DATA_FILES has been fetched (0 pins.json, 1 demos.json)
;   w_data_failed(i)          it could not be fetched
;   w_input(i, bytes)         control i changed; i counts the input and textarea elements in page order:
;                             0 the search field, 1 the XDC text area, 2 the file input (ignored)
;   w_click(i)                button i was pressed (index among the page's buttons); an SVG click goes
;                             through w_point
;   w_point(kind, x, y)       the pointer over the board, in viewBox units: kind 0 moved (mouse only),
;                             1 left the board, 2 clicked
;   w_key(bytes) -> 0 | 1     a key went down on the board; 1 means it was used (preventDefault)
;   w_drag(kind)              0 dragover, 1 dragleave, 2 drop on the file box
;   w_file(name, size, bytes, st)   a file was picked or dropped: its name, size in bytes, its text as
;                             UTF-8 bytes (empty when it was not read), st 0 read / 1 read failed
;   w_value(i, dst) -> n      the text control i must now hold (the wasm pushes it: Clear, a file), or
;                             4294967295 for "leave what the reader typed"
;   w_effect(dst) -> n        a CSS selector the host must scroll into view (a finding was pressed), or 0
;   w_render(dst) -> len      the page's HTML, 0 on overflow
; The board is drawn as SVG text inside w_render; the host sets the HTML as innerHTML.
; --
; What is NOT carried over from tool.js (also reported in the commit message):
;  * the 120 ms and 350 ms debounce of the search and the XDC text area: the native page lints on every
;    keystroke (the result after the last keystroke is the same);
;  * XDC texts above 2097152 bytes are cut there (the page's own limit is K_MAX_XDC_BYTES = 2000000);
;    more than 1024 ports or 2048 findings in one XDC make the lint give no ports and no findings; a
;    package with more than 40 rows, 40 columns, 2048 pins or 32 banks, or data files above 262144
;    bytes, show the "data did not load" line;
;  * the search is read as ASCII (toUpperCase/toLowerCase and trim() of non-ASCII letters and spaces are
;    not mapped); a selected ball name is cut at 255 bytes, a search at 1023;
;  * a pins.json or demos.json that is JSON but lacks rows, cols, banks or pins (tool.js then throws and
;    leaves the loading page) is shown as the loading page too, without any promise of equal details.
; --

pub const K_DATA_FILES : [2]str = ["./pins.json", "./demos.json"];

pub const W_CELL : u32 = 20;
pub const W_OX : u32 = 26;
pub const W_OY : u32 = 22;
pub const W_MAX_ROWS : u32 = 40;
pub const W_MAX_COLS : u32 = 40;
pub const W_MAX_CELLS : u32 = 1600;
pub const W_MAX_PINS : u32 = 2048;
pub const W_MAX_BANKS : u32 = 32;
pub const W_CAPX : u32 = 2097152;
pub const W_NO : u32 = 4294967295;
pub const W_CAP_DATA : u32 = 262144;

pub var PINS_RAW : [262144]u8 = [0; 262144];
pub var PINS_LEN : u32 = 0;
pub var DEMOS_RAW : [262144]u8 = [0; 262144];
pub var DEMOS_LEN : u32 = 0;
pub var D_STATE : [2]u8 = [0; 2];
pub var LOADED : bool = false;
pub var FAILED : bool = false;

pub var DP : [262144]u8 = [0; 262144];
pub var DP_LEN : u32 = 0;
pub var PB_O : [2048]u32 = [0; 2048];
pub var PB_L : [2048]u32 = [0; 2048];
pub var PS_O : [2048]u32 = [0; 2048];
pub var PS_L : [2048]u32 = [0; 2048];
pub var PT_O : [2048]u32 = [0; 2048];
pub var PT_L : [2048]u32 = [0; 2048];
pub var PF_O : [2048]u32 = [0; 2048];
pub var PF_L : [2048]u32 = [0; 2048];
pub var PY_O : [2048]u32 = [0; 2048];
pub var PY_L : [2048]u32 = [0; 2048];
pub var PY_C : [2048]u32 = [0; 2048];
pub var PB_BANK : [2048]i64 = [0; 2048];
pub var PIN_LAST : [2048]u8 = [0; 2048];
pub var N_PINS : u32 = 0;
pub var ROW_O : [40]u32 = [0; 40];
pub var ROW_L : [40]u32 = [0; 40];
pub var N_ROWS : u32 = 0;
pub var COLS : u32 = 0;
pub var BK_ID : [32]i64 = [0; 32];
pub var BK_PINS : [32]i64 = [0; 32];
pub var BK_KIND : [32]u32 = [0; 32];
pub var N_BANKS : u32 = 0;
pub var DEMO_EL : [8]i64 = [0; 8];
pub var N_DEMO : u32 = 0;
pub var CELLPIN : [1600]i32 = [0; 1600];

pub var PKG_TXT : [131072]u8 = [0; 131072];
pub var PKG_LEN : u32 = 0;
pub var ROWS_TXT : [512]u8 = [0; 512];
pub var ROWS_LEN : u32 = 0;
pub var VCCO_TXT : [1024]u8 = [0; 1024];
pub var VCCO_LEN : u32 = 0;

pub var PASTE : [2097152]u8 = [0; 2097152];
pub var PASTE_LEN : u32 = 0;
pub var NORM : [2097152]u8 = [0; 2097152];
pub var UPN : [2097152]u8 = [0; 2097152];
pub var XT : [262144]u8 = [0; 262144];

pub var LP_PINS : [5120]u32 = [0; 5120];
pub var LP_STDS : [5120]u32 = [0; 5120];
pub var LP_META : [8]u32 = [0; 8];
pub var LP_WORK : [5120]u32 = [0; 5120];
pub var LP_PORTS : [12288]u32 = [0; 12288];
pub var LP_FINDS : [22528]u32 = [0; 22528];
pub var LP_ORDER : [2048]u32 = [0; 2048];
pub var LP_POOL : [1048576]u8 = [0; 1048576];
pub var LP_LM : [4]u32 = [0; 4];
pub var LP_SUM : [6]u32 = [0; 6];
pub var N_PORTS : u32 = 0;
pub var N_FINDS : u32 = 0;
pub var PORT_CELL : [1024]i32 = [0; 1024];
pub var CELL_BAD : [1600]u8 = [0; 1600];
pub var CELL_USED : [1600]u8 = [0; 1600];
