// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-relu.t27 -- ReLU and leaky ReLU: what a neuron does with a negative number
; Source of truth for public/widgets/nn-relu/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-relu/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/activation/relu_activation.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 1 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader drags x from -4 to 4 and sets a leaky slope from 0 to 0.3. The green
; curve is forward_at over x and the dashed curve backward_at, the slope; the tiles read both at x
; and over the spec's own three-input batch (-2, 0, 2).

; WHAT IT DOES NOT CLAIM: ReLU is one choice among the activations of module 2; the page measures
; nothing about training.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_relu;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-relu";
pub const TITLE : str = "ReLU: what a neuron does with a negative number";
pub const DESCRIPTION : str = "Drag along the curve and watch ReLU pass every positive input and zero every negative one; give it a leaky slope and a little of the negative side gets through.";
pub const IMAGE_ALT : str = "ReLU card: leaky slope 0.1 at x = -2. The green curve is flat at -0.2 on the left and rises at 45 degrees on the right; the dashed gold slope sits at 0.1 then jumps to 1. Tiles read out -0.200, slope 0.100 and the spec's batch (-2, 0, 2) as -0.20 0.00 2.00.";
pub const HOOK : str = "max(0, x) is the whole rule, and its slope is 1 or 0. A leaky slope of 0.1 keeps a gradient alive on the negative side.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/activation/relu_activation.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 1 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_X_LO_C : i16 = -400;
pub const K_X_HI_C : i16 = 400;
pub const K_X_STEP_C : u8 = 5;
pub const K_Y_LO_C : i16 = -100;
pub const K_Y_HI_C : i16 = 400;
pub const K_X_TICKS : [5]i8 = [-4, -2, 0, 2, 4];
pub const K_Y_TICKS : [6]i8 = [-1, 0, 1, 2, 3, 4];
pub const K_SLOPE_MAX_C : u8 = 30;
pub const K_FIXTURE_C : [3]i16 = [-200, 0, 200];
pub const K_PRESET_X_C : [4]i16 = [-200, 150, -200, -300];
pub const K_PRESET_SLOPE_C : [4]u8 = [10, 0, 0, 30];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["Leaky 0.1 at x = -2", "ReLU at x = 1.5", "ReLU at x = -2", "Leaky 0.3 at x = -3"];
pub const SAY_ASK : str = "What does a neuron do with a negative number?";
pub const SAY_X : str = "input x";
pub const SAY_SLOPE : str = "leaky slope";
pub const SAY_F : str = "ReLU(x)";
pub const SAY_DF : str = "slope dReLU/dx";
pub const SAY_PLOT_LABEL : str = "ReLU of x and its slope from -4 to 4, with a cursor you drag";
pub const SAY_OUT : str = "output";
pub const SAY_GRAD : str = "slope at x";
pub const SAY_BATCH : str = "spec batch -2 0 2";
pub const SAY_BATCH_GRAD : str = "its slopes";
pub const SAY_NOTE : str = "A slope of 0 means no gradient flows back, so a unit that only ever sees negative inputs stops learning. The leaky slope is the fix the spec takes as its fourth argument.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/activation/relu_activation.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_range_holds_both_sides {
    assert K_X_LO_C < 0;
    assert K_X_HI_C > 0;
    assert K_X_LO_C + K_X_HI_C == 0;
}

test the_presets_stay_in_range {
    assert K_PRESET_X_C[3] >= K_X_LO_C;
    assert K_PRESET_SLOPE_C[3] <= K_SLOPE_MAX_C;
    assert K_PRESET_SLOPE_C[1] == 0;
    assert K_FIXTURE_C[0] == K_PRESET_X_C[0];
}
