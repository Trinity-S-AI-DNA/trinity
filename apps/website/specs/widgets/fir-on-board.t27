// SPDX-License-Identifier: Apache-2.0
; specs/widgets/fir-on-board.t27 -- capstone: the FIR as RTL runs it, bit for bit, next to its f64 twin
; Source of truth for public/widgets/fir-on-board/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/fir-on-board/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 27 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader designs the low-pass of lesson 17 (taps, cutoff, window, coefficient bits)
; and feeds it two tones, one in the passband and one in the stopband, as Q1.15 samples. The spec runs the
; filter the way the hardware will: integer taps, a wide accumulator, round half up, saturate to 16 bits.
; The page draws the input, the RTL output and the f64 output, and the error between them in output LSBs.

; WHAT IT DOES NOT CLAIM: this is the arithmetic the board runs, computed in the browser; the bitstream and the JTAG read-back are the bench lessons' widgets.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_fir_on_board;

pub const KIND : str = "widget-tool";
pub const ID : str = "fir-on-board";
pub const TITLE : str = "Capstone: a filter as the board computes it";
pub const DESCRIPTION : str = "Design a low-pass, feed it two tones as 16-bit samples and see what the RTL arithmetic outputs next to the same filter in f64, down to the last bit.";
pub const IMAGE_ALT : str = "FIR capstone card: 31 Hamming taps of 16 bits, cutoff 0.1, a passband tone at 0.02 and a stopband tone at 0.3. The stopband tone is gone; the RTL output stays within 1.5 LSB of the f64 filter at every sample.";
pub const HOOK : str = "The RTL output of a 31-tap filter stays within 1.5 LSB of the f64 filter, sample after sample. With 8-bit taps the gap grows: now you can see by how much.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "R. G. Lyons, Understanding Digital Signal Processing, 3rd ed., ch. 12: digital data formats and their effects", "Xilinx UG479, 7 Series DSP48E1 Slice User Guide: the 48-bit accumulator the sum fits in"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_MIN_TAPS : u8 = 5;
pub const K_TAP_LIMIT : u8 = 63;
pub const K_PER_MILLI : u16 = 1000;
pub const K_FC_MIN_MILLI : u16 = 20;
pub const K_FC_MAX_MILLI : u16 = 300;
pub const K_MIN_BITS : u8 = 8;
pub const K_MAX_BITS : u8 = 18;
pub const K_FA_MIN_MILLI : u16 = 5;
pub const K_FA_MAX_MILLI : u16 = 100;
pub const K_FB_MIN_MILLI : u16 = 150;
pub const K_FB_MAX_MILLI : u16 = 450;
pub const K_SAMPLES_SHOWN : u16 = 128;
pub const K_Q15_ONE : u32 = 32768;
pub const K_OUT_BITS : u8 = 16;
pub const K_WINDOW_KINDS : [3]u8 = [0, 1, 2];
pub const K_PRESET_TAPS : [4]u8 = [31, 31, 63, 15];
pub const K_PRESET_FC_MILLI : [4]u16 = [100, 100, 100, 100];
pub const K_PRESET_WINDOW : [4]u8 = [1, 1, 2, 0];
pub const K_PRESET_BITS : [4]u8 = [16, 8, 18, 12];
pub const K_PRESET_FA_MILLI : [4]u16 = [20, 20, 20, 20];
pub const K_PRESET_FB_MILLI : [4]u16 = [300, 300, 300, 300];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["31 Hamming taps, 16 bits", "the same with 8-bit taps", "63 Blackman taps, 18 bits", "15 taps, no window"];
pub const SAY_TAPS : str = "Taps";
pub const SAY_FC : str = "Cutoff, cycles per sample";
pub const SAY_WINDOW : str = "Window";
pub const SAY_WINDOWS : [3]str = ["rectangular", "Hamming", "Blackman"];
pub const SAY_BITS : str = "Coefficient bits";
pub const SAY_FA : str = "Passband tone, cycles per sample";
pub const SAY_FB : str = "Stopband tone, cycles per sample";
pub const SAY_WAVE_LABEL : str = "The input, the RTL output and the f64 output over 128 samples";
pub const SAY_ERR_LABEL : str = "RTL output minus f64 output, in output LSBs";
pub const SAY_IN : str = "input, two tones";
pub const SAY_RTL : str = "RTL output";
pub const SAY_REF : str = "f64 filter";
pub const SAY_TIME_AXIS : str = "sample";
pub const SAY_ERR_AXIS : str = "error, LSBs";
pub const SAY_NOTE : str = "Bars past one LSB are red. The integer arithmetic is exact; what moves the output away from the f64 filter is rounding: of the input samples, of the taps and of the output.";
pub const SAY_ACC : str = "accumulator";
pub const SAY_WORST : str = "worst error";
pub const SAY_LSB : str = "{0} LSB";
pub const SAY_COEFF : str = "coefficients";
pub const SAY_OUT_WORD : str = "output word";
pub const SAY_BITS_N : str = "{0} bits";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/signals.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_tones_sit_either_side_of_the_cutoff {
    assert K_PRESET_FA_MILLI[0] < K_PRESET_FC_MILLI[0];
    assert K_PRESET_FB_MILLI[0] > K_PRESET_FC_MILLI[0] * 2;
    assert K_FA_MAX_MILLI < K_FB_MIN_MILLI;
}

test the_words_are_q15_and_sixteen_bits {
    assert K_Q15_ONE == 32768;
    assert K_OUT_BITS == 16;
    assert K_MAX_BITS <= 18;
    assert K_PRESET_BITS[1] < K_PRESET_BITS[0];
}
