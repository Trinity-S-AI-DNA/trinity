// SPDX-License-Identifier: Apache-2.0
; specs/widgets/hive-aging.t27 -- Aging: how long a labelled low issue waits
; Source of truth for public/widgets/hive-aging/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every column, verdict and number it shows comes from public/widgets/hive-aging/logic.js -- the fn
; bodies of gHashTag/t27 specs/queen/priority.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 4 of the course queen-and-hive. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader picks a level, whether it is labelled, and an age from 0 to 60 days. The
; green line is effective_level over every day for a labelled issue and the dashed one for an
; unlabelled one; the tiles read it and why at the chosen age.

; WHAT IT DOES NOT CLAIM:  it does not read GitHub labels: the level is what the reader picks.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_hive_aging;

pub const KIND : str = "widget-tool";
pub const ID : str = "hive-aging";
pub const TITLE : str = "Aging: how long a labelled low issue waits";
pub const DESCRIPTION : str = "Pick a level, label it or not, and drag its age: a labelled issue gains one level after 14 days, at most one, and never reaches critical.";
pub const IMAGE_ALT : str = "Aging card: a labelled LOW issue at 20 days. The green step line runs at low until day 14 and then at normal to day 60; the dashed unlabelled line stays flat. Tiles read effective level normal, why aged, 14 days a step.";
pub const HOOK : str = "A low label that aged past unlabelled work would make low the fastest way to the front. So aging is one step, and only for labelled issues.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/queen/priority.t27 (t27 master c42f8fb40): every value on the page is effective_level and why, its fn bodies compiled to wasm (logic.js)", "Course 11 of t27.ai, queen-and-hive (gHashTag/trinity#1698): lesson 4 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_AGE_MAX : u8 = 60;
pub const K_AGE_TICKS : [5]u8 = [0, 14, 28, 42, 60];
pub const K_AGING_DAYS : u32 = 14;
pub const K_MAX_AGING_STEPS : u32 = 1;
pub const K_PRESET_LEVEL : [4]u8 = [3, 2, 3, 1];
pub const K_PRESET_LABELLED : [4]u8 = [1, 1, 0, 1];
pub const K_PRESET_AGE : [4]u8 = [20, 30, 50, 45];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["Low, 20 days", "Normal, 30 days", "Low, no label", "High, 45 days"];
pub const SAY_ASK : str = "How long does a labelled low issue wait before it moves up?";
pub const SAY_LEVEL : str = "level";
pub const SAY_LEVEL_NAMES : [4]str = ["critical", "high", "normal", "low"];
pub const SAY_LABELLED : str = "labelled";
pub const SAY_AGE : str = "days open";
pub const SAY_PLOT_LABEL : str = "the level an issue runs at, by days open";
pub const SAY_LINE : str = "labelled";
pub const SAY_FLAT : str = "not labelled";
pub const SAY_PICKED : str = "level picked";
pub const SAY_EFFECTIVE : str = "runs at";
pub const SAY_STEP : str = "days a step";
pub const SAY_WHY : str = "why";
pub const SAY_WHY_NAMES : [5]str = ["listing", "label", "aged", "capped", "blocked"];
pub const SAY_NOTE : str = "Lower runs first. An unlabelled issue is normal and never ages, so a repository with no labels keeps the order it had. High and critical do not age at all.";
pub const SAY_SOURCE : str = "Logic: t27 spec queen/priority.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test one_step_every_fourteen_days {
    assert K_AGING_DAYS == 14;
    assert K_MAX_AGING_STEPS == 1;
    assert K_AGE_TICKS[1] == K_AGING_DAYS;
}

test the_presets_fit_the_axis {
    assert K_PRESET_AGE[2] <= K_AGE_MAX;
    assert K_PRESET_LEVEL[0] == 3;
    assert K_AGE_TICKS[4] == K_AGE_MAX;
}
