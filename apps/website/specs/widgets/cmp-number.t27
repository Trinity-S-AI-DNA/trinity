// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-number.t27 -- How big may a number be? Three doors with three limits
; Source of truth for public/widgets/cmp-number/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-number/logic.js -- the fn
; bodies of gHashTag/t27 specs/isa/t27a.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 3 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader types a number or takes an edge value. The widget puts it into three lines of assembler and
; asks the assembler for each line's status and word, and asks dec_fits_u32 whether the digit run fits 32 bits.

; WHAT IT DOES NOT CLAIM:  the three line shapes are the reader's input, not a rule: the limits are the assembler's own answers.
; The status numbers are held equal to the constants of t27a.t27 by widget-logic.mjs.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_number;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-number";
pub const TITLE : str = "How big may a number be? Three doors with three limits";
pub const DESCRIPTION : str = "Type a number. The t27a assembler reads it three ways: as a .word, as an immediate and as a register number. Each door has its own limit, and each refusal has its own name.";
pub const IMAGE_ALT : str = "Number card: the text 16384 tried three ways. The line .word 16384 is accepted and assembles to the word 16384. The line LDI t1, t0, 16384 is refused as a bad immediate. The line ADD t1, t2, t16384 is refused as a bad register.";
pub const HOOK : str = "One number, three doors: 4294967295 passes as a word, 16383 as an immediate, 26 as a register. Past the limit the assembler refuses and says which door.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/isa/t27a.t27 (t27 master 90e797659): every status and word is assemble_status or assemble, and the digit run is digits_end and dec_fits_u32, fn bodies compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 3 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 0;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_ASM_OK : u8 = 0;
pub const K_ASM_NO_MNEMONIC : u8 = 1;
pub const K_ASM_UNKNOWN_MNEMONIC : u8 = 2;
pub const K_ASM_BAD_SEPARATOR : u8 = 3;
pub const K_ASM_BAD_REGISTER : u8 = 4;
pub const K_ASM_BAD_IMMEDIATE : u8 = 5;
pub const K_ASM_TRAILING_TEXT : u8 = 6;
pub const K_ASM_BAD_WORD : u8 = 7;
pub const K_MAX_TEXT : u8 = 12;
pub const K_START_SAMPLE : u8 = 1;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine stages a spec passes; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_SAMPLES : [8]str = ["16383", "16384", "-16385", "26", "27", "65535", "4294967295", "4294967296"];
pub const SAY_ASK : str = "How big may a number be before the assembler says no?";
pub const SAY_TEXT_LABEL : str = "A number";
pub const SAY_LINES : [3]str = [".word {0}", "LDI t1, t0, {0}", "ADD t1, t2, t{0}"];
pub const SAY_DOORS : [3]str = ["a whole word", "an immediate", "a register"];
pub const SAY_STATUS_NAMES : [8]str = ["ok", "no mnemonic", "unknown mnemonic", "bad separator", "bad register", "bad immediate", "trailing text", "bad word"];
pub const SAY_STATUS : str = "status {0}";
pub const SAY_WORD : str = "word";
pub const SAY_DIGITS : str = "{0} digits from byte 0";
pub const SAY_FITS : str = "fits 32 bits";
pub const SAY_YES : str = "yes";
pub const SAY_NO : str = "no";
pub const SAY_NONE : str = "none";
pub const SAY_NOTE : str = "The three limits are the assembler's own: a word is any 32-bit number, an immediate is a signed number of up to five digits, a register is t0 up to t26. The digit run is read first and refused when it cannot fit.";
pub const SAY_SOURCE : str = "Logic: t27 spec isa/t27a.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_has_a_stage_of_nine {
    assert K_STAGE < 9;
    assert K_STAGE == 0;
}

test status_numbers_run_from_ok_to_bad_word {
    assert K_ASM_OK == 0;
    assert K_ASM_BAD_REGISTER == 4;
    assert K_ASM_BAD_IMMEDIATE == 5;
    assert K_ASM_BAD_WORD == 7;
}

test the_start_is_a_number_one_door_refuses {
    assert K_START_SAMPLE == 1;
    assert K_MAX_TEXT == 12;
}
