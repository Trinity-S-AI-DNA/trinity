// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-seal-parts.t27 -- A seal checked by a stranger: which part breaks first
; Source of truth for public/widgets/cmp-seal-parts/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-seal-parts/logic.js -- the fn
; bodies of gHashTag/t27 specs/verified/seal_check.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 19 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader sets, for the spec and the four generated outputs, whether the checker could not recompute the part,
; found it the same or found it different, and whether the sealed tests passed, were forced and used a digest the checker knows. seal_check_alg answers.

; WHAT IT DOES NOT CLAIM:  it computes no hash and reads no seal: the part states are what the reader sets. The verdict numbers are held
; equal to the constants of seal_check.t27. The spec says the digest is sha256 everywhere today.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_seal_parts;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-seal-parts";
pub const TITLE : str = "A seal checked by a stranger: which part breaks first";
pub const DESCRIPTION : str = "A seal records the spec, four generated outputs and a test run. A checker that did not build it judges each part in a fixed order and fails closed. Set the parts and read the verdict.";
pub const IMAGE_ALT : str = "Seal check card: the spec, C and Verilog parts match, the Rust part differs and the Zig part could not be recomputed. The verdict names the Rust output, the first part that differs in the fixed order, in red, and the seal is not a pass. Nine verdicts are listed from match to unknown.";
pub const HOOK : str = "A part the checker cannot recompute is unknown, never a match. And when several parts differ, the same one is named every time: the first in a fixed order.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/verified/seal_check.t27 (t27 master 90e797659): every verdict is seal_check_alg and verdict_pass, fn bodies compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 19 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 6;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_CHECK_MATCH : u8 = 0;
pub const K_CHECK_SPEC_DIFF : u8 = 1;
pub const K_CHECK_GEN_C : u8 = 2;
pub const K_CHECK_GEN_RUST : u8 = 3;
pub const K_CHECK_GEN_VERILOG : u8 = 4;
pub const K_CHECK_GEN_ZIG : u8 = 5;
pub const K_CHECK_FORCED : u8 = 6;
pub const K_CHECK_FAILED : u8 = 7;
pub const K_CHECK_UNKNOWN : u8 = 8;
pub const K_ALG_SHA256 : u8 = 1;
pub const K_ALG_OTHER : u8 = 7;
pub const K_PRESET_SPEC : [6]u8 = [1, 1, 1, 2, 1, 1];
pub const K_PRESET_C : [6]u8 = [1, 1, 1, 2, 1, 0];
pub const K_PRESET_RUST : [6]u8 = [2, 1, 1, 2, 1, 0];
pub const K_PRESET_VERILOG : [6]u8 = [1, 1, 1, 2, 1, 0];
pub const K_PRESET_ZIG : [6]u8 = [0, 1, 1, 2, 1, 0];
pub const K_PRESET_PASSED : [6]u8 = [1, 1, 0, 1, 1, 1];
pub const K_PRESET_FORCED : [6]u8 = [0, 0, 1, 0, 0, 0];
pub const K_PRESET_ALG : [6]u8 = [0, 0, 0, 0, 1, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine steps of this course; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [6]str = ["A part we cannot see", "Everything fine", "Forced past a failure", "The spec itself changed", "A digest we do not know", "Only the spec checks out"];
pub const SAY_ASK : str = "How does a stranger check a seal without trusting the builder?";
pub const SAY_PARTS : [5]str = ["spec", "C output", "Rust output", "Verilog output", "Zig output"];
pub const SAY_PART_STATES : [3]str = ["not observed", "same", "differs"];
pub const SAY_PASSED : str = "the sealed tests passed";
pub const SAY_FORCED : str = "the seal was forced";
pub const SAY_ALG : str = "digest";
pub const SAY_ALG_NAMES : [2]str = ["sha256", "another digest"];
pub const SAY_CHECKS : [9]str = ["match", "the spec differs", "the C output differs", "the Rust output differs", "the Verilog output differs", "the Zig output differs", "forced", "failed", "unknown"];
pub const SAY_PASS : str = "counts as a pass";
pub const SAY_NOT_PASS : str = "is not a pass";
pub const SAY_NOTE : str = "Parts are judged in a fixed order, the spec first and then the four outputs in the seal's own key order. A part that cannot be recomputed makes the seal unknown unless an earlier part already names itself. Forced and failed seals are never a pass whatever the hashes say.";
pub const SAY_SOURCE : str = "Logic: t27 spec verified/seal_check.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_is_one_of_nine_course_steps {
    assert K_STAGE < 9;
    assert K_STAGE == 6;
}

test nine_verdicts_in_the_fixed_part_order {
    assert K_CHECK_MATCH == 0;
    assert K_CHECK_SPEC_DIFF == 1;
    assert K_CHECK_GEN_C + 1 == K_CHECK_GEN_RUST;
    assert K_CHECK_GEN_ZIG == 5;
    assert K_CHECK_UNKNOWN == 8;
}

test the_start_has_one_part_the_checker_cannot_see {
    assert K_PRESET_ZIG[0] == 0;
    assert K_PRESET_RUST[0] == 2;
    assert K_ALG_SHA256 == 1;
    assert K_PRESET_ALG[4] == 1;
    assert K_ALG_OTHER == 7;
    assert K_START_PRESET == 0;
}
