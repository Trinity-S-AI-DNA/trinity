// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-errors.t27 -- Seven ways to refuse a line: what the parser says
; Source of truth for public/widgets/cmp-errors/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-errors/logic.js -- the fn
; bodies of gHashTag/t27 specs/isa/t27a.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 6 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader types a line or takes one of eight samples, one per status. assemble_status answers with a code;
; the ladder lights that code, and when the line is accepted the word it assembles to is shown.

; WHAT IT DOES NOT CLAIM:  it does not say where in the line the problem is: the parser returns a code, not a position. The
; code numbers are held equal to the constants of t27a.t27 by widget-logic.mjs.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_errors;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-errors";
pub const TITLE : str = "Seven ways to refuse a line: what the parser says";
pub const DESCRIPTION : str = "Type a line of t27a assembler. The parser reads it left to right and stops at the first problem. assemble_status names that problem with one of seven codes, or says ok.";
pub const IMAGE_ALT : str = "Refusal card: the line ADD t1, t2, t30 is refused with status 4, a bad register. A ladder of the eight statuses shows ok, no mnemonic, unknown mnemonic, bad separator, bad register, bad immediate, trailing text and bad word, with bad register lit in red.";
pub const HOOK : str = "A parser that only says no is no help. This one gives each refusal its own number, in the order it meets them, and the same line always gets the same one.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/isa/t27a.t27 (t27 master 90e797659): every status is assemble_status, its fn body compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 6 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 1;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_ASM_OK : u8 = 0;
pub const K_ASM_NO_MNEMONIC : u8 = 1;
pub const K_ASM_UNKNOWN_MNEMONIC : u8 = 2;
pub const K_ASM_BAD_SEPARATOR : u8 = 3;
pub const K_ASM_BAD_REGISTER : u8 = 4;
pub const K_ASM_BAD_IMMEDIATE : u8 = 5;
pub const K_ASM_TRAILING_TEXT : u8 = 6;
pub const K_ASM_BAD_WORD : u8 = 7;
pub const K_MAX_TEXT : u8 = 40;
pub const K_START_SAMPLE : u8 = 4;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine steps of this course; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_SAMPLES : [8]str = ["NOP t0, t0", "", "add t1, t2, t3", "ADD t1 t2, t3", "ADD t1, t2, t30", "LDI t1, t0, 99999", "NOP t0, t0 x", ".word 4294967296"];
pub const SAY_ASK : str = "When the parser refuses a line, how does it say why?";
pub const SAY_TEXT_LABEL : str = "A line of t27a assembler";
pub const SAY_STATUS_NAMES : [8]str = ["ok", "no mnemonic", "unknown mnemonic", "bad separator", "bad register", "bad immediate", "trailing text", "bad word"];
pub const SAY_STATUS_LINES : [8]str = ["the line is one instruction", "the line has no name to read", "the name is read but is not one of the 47 opcodes", "a comma or a space is missing between operands", "a register is not t0 to t26, or not t0 to t15 as the second operand of an immediate form", "an immediate has no digits, more than five, or is outside -16384 to 16383", "something follows the last operand", ".word has no decimal number that fits 32 bits"];
pub const SAY_CODE : str = "status {0}";
pub const SAY_WORD : str = "assembles to {0}";
pub const SAY_NOTE : str = "The parser stops at the first problem it meets, reading left to right, so a line with two faults gets the code of the first. Lower case is read as a name, so add is an unknown mnemonic, not a missing one.";
pub const SAY_SOURCE : str = "Logic: t27 spec isa/t27a.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_is_one_of_nine_course_steps {
    assert K_STAGE < 9;
    assert K_STAGE == 1;
}

test eight_statuses_in_the_order_the_parser_meets_them {
    assert K_ASM_OK == 0;
    assert K_ASM_NO_MNEMONIC == 1;
    assert K_ASM_BAD_SEPARATOR == 3;
    assert K_ASM_BAD_WORD == 7;
}

test the_start_is_the_bad_register_sample {
    assert K_START_SAMPLE == K_ASM_BAD_REGISTER;
    assert K_MAX_TEXT == 40;
}
