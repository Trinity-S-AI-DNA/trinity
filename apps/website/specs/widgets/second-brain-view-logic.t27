// SPDX-License-Identifier: Apache-2.0
; second-brain-view-logic.t27 -- the view-transition functions as executable spec bodies, and the
; concrete fixture for the compiler task: gen-ts and gen-js skip fn bodies (lower declarations,
; not bodies), while the Zig backend of the same compiler lowers this exact file. When codegen_ts
; learns scalar body lowering, this spec generates the logic module the second-brain tool imports,
; and the rules leave the data table for compiler-checked functions. KIND is not widget-tool on
; purpose: the widget generator skips this file; t27c test is its gate.
; phi^2 + 1/phi^2 = 3 | TRINITY

module second_brain_view_logic;

pub const KIND : str = "view-logic";

pub fn view_zoom_in(zoom_milli: u16) -> u16 {
    return zoom_milli * 12 / 10;
}

pub fn view_zoom_out(zoom_milli: u16) -> u16 {
    return zoom_milli * 10 / 12;
}

pub fn view_toggle_selected(selected: u16, node: u16) -> u16 {
    if (selected == node) { return 255; }
    return node;
}

pub fn view_reset_zoom() -> u16 {
    return 1000;
}

test zoom_in_at_1000 {
    assert view_zoom_in(1000) == 1200;
}

test zoom_out_of_1440 {
    assert view_zoom_out(1440) == 1200;
}

test toggle_selects_and_deselects {
    assert view_toggle_selected(255, 2) == 2;
    assert view_toggle_selected(2, 2) == 255;
}

test reset_zoom_is_milli_one {
    assert view_reset_zoom() == 1000;
}
