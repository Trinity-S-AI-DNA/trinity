// SPDX-License-Identifier: Apache-2.0
; second-brain-view-logic.t27 -- the view contract the tool imports as a generated module:
; the transition functions (bodies, lowered by t27c gen-js) and the transition table that
; drives them (events, fields, rows). One source for both: the widget spec spells the page's
; words, this spec owns the behaviour, and tool.js wires the two through the shared kit.
; The differential harness (node) executes the generated functions against this spec's own
; reference runs; the trap cases (intermediate overflow) cannot be asserted inside a t27
; test block -- a trap aborts the reference itself -- so they live in the harness.
; KIND is not widget-tool on purpose: the widget generator skips this file; t27c test is its gate.
; phi^2 + 1/phi^2 = 3 | TRINITY

module second_brain_view_logic;

pub const KIND : str = "view-logic";

; --- The transition functions -------------------------------------------------
pub fn view_zoom_in(zoom_milli: u16) -> u16 {
    return zoom_milli * 12 / 10;
}

pub fn view_zoom_out(zoom_milli: u16) -> u16 {
    return zoom_milli * 10 / 12;
}

pub fn view_toggle_selected(selected: u16, node: u16) -> u16 {
    if (selected == node) { return 255; }
    return node;
}

; --- The view-state boundary, as data: what `none` is in the model. ------------
pub const K_SELECTED_NONE : u16 = 255;

; --- Node sizing and edge attachment, as functions the host calls. -------------
; The host measures the label (its one runtime op) and hands the numbers here;
; every geometric decision -- how much a node grows for its label, how far an
; edge travels before it touches a border -- is a spec function the compiler
; checks. pad_x/pad_y come from the view descriptor's K_VIEW_PADDING_*.
pub fn abs_f(v: f64) -> f64 {
    if (v < 0) { return 0 - v; }
    return v;
}

; A disc's squared reach: the label box's far corner plus padding, squared --
; the circular border must clear the label's corners, not just its width.
pub fn disc_reach_sq(label_w: f64, label_h: f64, pad_x: f64, pad_y: f64) -> f64 {
    var hx: f64 = label_w / 2 + pad_x;
    var hy: f64 = label_h / 2 + pad_y;
    return hx * hx + hy * hy;
}

; A square's full width/height: the label box plus padding on both axes.
; Written as two additions, not `* 2`: the object chain (t27b -> .o) does not
; lower float multiply-by-a-power-of-two (#6284), and the sum is the same
; number. The supported subset is part of the spec's own discipline.
pub fn square_w(label_w: f64, pad_x: f64) -> f64 {
    return label_w + pad_x + pad_x;
}

pub fn square_h(label_h: f64, pad_y: f64) -> f64 {
    return label_h + pad_y + pad_y;
}

; The ray-to-rectangle parameter: how far along the edge direction (dx, dy)
; the rectangle half-width hw and half-height hh is met, whichever side is hit
; first. Zero direction means zero distance -- the point is on the node.
pub fn square_reach_t(hw: f64, hh: f64, dx: f64, dy: f64) -> f64 {
    if (dx == 0) {
        if (dy == 0) { return 0; }
        return hh / abs_f(dy);
    }
    var tx: f64 = hw / abs_f(dx);
    var ty: f64 = hh / abs_f(dy);
    if (tx < ty) { return tx; }
    return ty;
}

; --- The transition table -----------------------------------------------------
; The view state has five fields: 0 selected (node index, 255 = none), 1 filter
; (index into KINDS), 2 pan_x, 3 pan_y, 4 zoom (milli, 1000 = 1x). Every UI event
; is a row [event, field, op, arg]: op 1 = zero, 2 = set to arg (0 = the event
; payload), 3 = toggle with arg, 4 = multiply by arg (0 = use the event payload,
; in milli), 5 = add the event payload (a pan payload is [dx, dy], per row).
; The events: 0 theme, 1 view mode, 2 reset, 3 filter, 4 node click, 5 wheel
; zoom, 6 pan. The rows ARE the transition rules; the runtime only applies them.
pub const K_FIELD_SELECTED : u8 = 0;
pub const K_FIELD_FILTER : u8 = 1;
pub const K_FIELD_PAN_X : u8 = 2;
pub const K_FIELD_PAN_Y : u8 = 3;
pub const K_FIELD_ZOOM : u8 = 4;

pub const K_EVENT_THEME : u8 = 0;
pub const K_EVENT_MODE : u8 = 1;
pub const K_EVENT_RESET : u8 = 2;
pub const K_EVENT_FILTER : u8 = 3;
pub const K_EVENT_NODE : u8 = 4;
pub const K_EVENT_WHEEL : u8 = 5;
pub const K_EVENT_PAN : u8 = 6;

pub const K_T_THEME_ROWS : u8 = 0;
pub const K_T_MODE_ROWS : u8 = 0;
pub const K_T_RESET_ROWS : u8 = 4;
pub const K_T_FILTER_ROWS : u8 = 2;
pub const K_T_NODE_ROWS : u8 = 1;
pub const K_T_WHEEL_ROWS : u8 = 1;
pub const K_T_PAN_ROWS : u8 = 2;
pub const K_T_ROWS_TOTAL : u16 = 10;

pub const K_TRANSITIONS : [40]u16 = [
    2, 0, 2, 255,
    2, 2, 1, 0,
    2, 3, 1, 0,
    2, 4, 2, 1000,
    3, 0, 2, 255,
    3, 1, 2, 0,
    4, 0, 3, 0,
    5, 4, 4, 0,
    6, 2, 5, 0,
    6, 3, 5, 0
];

test zoom_in_at_1000 {
    assert view_zoom_in(1000) == 1200;
}

test zoom_in_fits_u16 {
    assert view_zoom_in(5461) == 6553;
}

test zoom_out_of_1440 {
    assert view_zoom_out(1440) == 1200;
}

test toggle_selects_and_deselects {
    assert view_toggle_selected(255, 2) == 2;
    assert view_toggle_selected(2, 2) == 255;
}

test selected_none_is_the_model_value {
    assert K_SELECTED_NONE == 255;
}

test square_reaches_the_hit_side {
    assert square_reach_t(10, 5, 100, 0) == 0.1;
    assert square_reach_t(10, 5, 0, 100) == 0.05;
    assert square_reach_t(10, 5, 100, 100) == 0.05;
    assert square_reach_t(10, 5, 0, 0) == 0;
}

test disc_reach_clears_the_label_corners {
    assert disc_reach_sq(20, 10, 2, 2) == 193;
    assert disc_reach_sq(0, 0, 3, 4) == 25;
}

test square_box_is_label_plus_padding {
    assert square_w(20, 3) == 26;
    assert square_h(10, 3) == 16;
}

test theme_change_preserves_everything {
    assert K_T_THEME_ROWS == 0;
}

test mode_change_preserves_everything {
    assert K_T_MODE_ROWS == 0;
}

test reset_touches_only_spec_fields {
    assert K_T_RESET_ROWS == 4;
    assert K_TRANSITIONS[0] == K_EVENT_RESET;
    assert K_TRANSITIONS[1] == K_FIELD_SELECTED;
    assert K_TRANSITIONS[2] == 2;
    assert K_TRANSITIONS[3] == 255;
    assert K_TRANSITIONS[5] == K_FIELD_PAN_X;
    assert K_TRANSITIONS[9] == K_FIELD_PAN_Y;
    assert K_TRANSITIONS[13] == K_FIELD_ZOOM;
    assert K_TRANSITIONS[14] == 2;
    assert K_TRANSITIONS[15] == 1000;
}

test filter_sets_filter_and_clears_selection {
    assert K_T_FILTER_ROWS == 2;
    assert K_TRANSITIONS[16] == K_EVENT_FILTER;
    assert K_TRANSITIONS[17] == K_FIELD_SELECTED;
    assert K_TRANSITIONS[18] == 2;
    assert K_TRANSITIONS[19] == 255;
    assert K_TRANSITIONS[20] == K_EVENT_FILTER;
    assert K_TRANSITIONS[21] == K_FIELD_FILTER;
    assert K_TRANSITIONS[22] == 2;
    assert K_TRANSITIONS[23] == 0;
}

test table_is_complete {
    assert K_T_ROWS_TOTAL == 10;
    assert K_T_THEME_ROWS + K_T_MODE_ROWS + K_T_RESET_ROWS + K_T_FILTER_ROWS + K_T_NODE_ROWS + K_T_WHEEL_ROWS + K_T_PAN_ROWS == K_T_ROWS_TOTAL;
}
