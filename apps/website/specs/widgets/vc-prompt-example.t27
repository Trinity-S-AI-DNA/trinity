// SPDX-License-Identifier: Apache-2.0
; specs/widgets/vc-prompt-example.t27 -- the infographic of lesson 2 of module Prompting, course Vibecoding from zero (specs/course/vibecoding.t27)
; Source of truth for public/widgets/vc-prompt-example/ (gHashTag/trinity), in the shape of specs/widgets/basics-a-test-block.t27:
; a table and a flow diagram, black and white, no words in JS. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: specs/vibecoding/prompt_example.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_vc_prompt_example;

pub const KIND : str = "widget-tool";
pub const ID : str = "vc-prompt-example";
pub const TITLE : str = "Vibecoding: an example beats an adjective";
pub const DESCRIPTION : str = "One example input and output fits two rules; a second example drops one. Why an agent follows an example better than the word bigger. Vibecoding from zero, Prompting.";
pub const IMAGE_ALT : str = "A black and white diagram: a vague word fits many rules, one example fits two, two examples fit one; a table shows three example pairs and whether rule A, add 3, and rule B, multiply by 3 and add 1, give the wanted output.";
pub const HOOK : str = "One example fits two rules. The second example picks one.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [1]str = ["The lesson spec specs/vibecoding/prompt_example.t27: its constants and tests, run by the site test runner (t27check.mjs); the table cells are EX_IN, EX_OUT, rule A (x + 3) and rule B (x * 3 + 1) of that spec"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Wanted output, and what two rules give";
pub const SAY_TABLE_HEAD : [4]str = ["Input", "Wanted", "Rule A: x + 3", "Rule B: x * 3 + 1"];
pub const SAY_TABLE_CELLS : [12]str = [
    "1", "4", "4", "4",
    "2", "5", "5", "7",
    "5", "8", "8", "16"
];
pub const K_TABLE_COLS : u8 = 4;
pub const K_TABLE_ROWS : u8 = 3;
pub const K_TABLE_CELLS : u16 = 12;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "How many rules still fit";
pub const SAY_FLOW_STEPS : [3]str = ["An adjective: many rules fit", "One example: two rules fit", "Two examples: one rule fits"];
pub const K_FLOW_STEPS : u8 = 3;
pub const SAY_NOTE : str = "Row 1 does not tell A from B. Row 2 does: B gives 7, not the wanted 5.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 3;
    assert K_FLOW_STEPS > 1;
}

test the_cells_are_the_two_rules {
    assert 4 == 1 + 3;
    assert 4 == 1 * 3 + 1;
    assert 5 == 2 + 3;
    assert 7 == 2 * 3 + 1;
    assert 8 == 5 + 3;
    assert 16 == 5 * 3 + 1;
}
