// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-fields.t27 -- Pack an instruction: forty-seven opcodes, three shapes
; Source of truth for public/widgets/cmp-fields/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-fields/logic.js -- the fn
; bodies of gHashTag/t27 specs/isa/t27a.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 26 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader picks one of the 47 opcodes and slides its operands. t27a_encode packs the word, the decoder fns read each
; field back, is_canonical judges the word and the listing shows its text. Bits are coloured by the decoder field that reads them.

; WHERE THE FNS COME FROM:
; is_canonical and the listing are fns declared in t27a.t27. t27a_encode, opcode_of, dst_of, t27a_src1, t27a_src2, v3_of, t27a_imm
; and imm_clamped are spliced in through use from isa/ternary_encoding.t27, and opcode_at from isa/t27a_mnemonics.t27; neither is vendored here.

; WHAT IT DOES NOT CLAIM:  an operand the opcode does not carry is dropped by the encoder and read back as zero; the page shows it as not in this form.
; The mnemonics are found by disassembling a word of each opcode, so they are the spec's, not a list kept here.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_fields;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-fields";
pub const TITLE : str = "Pack an instruction: forty-seven opcodes, three shapes";
pub const DESCRIPTION : str = "Pick an opcode and its operands and the encoder packs them into one 32-bit word. The decoder reads them back, and the bits that matter move with the shape of the opcode.";
pub const IMAGE_ALT : str = "Pack card: the opcode LDI with destination t4, source t0 and the immediate minus 12, packed into one word. Four rows of eight bits colour the opcode, the destination, a four-bit source and a fifteen-bit immediate that fills bits 31 to 17. The decoder reads minus 12 back, and the word is canonical.";
pub const HOOK : str = "Forty-seven opcodes share one 32-bit word in three shapes: an immediate takes fifteen bits, a register five. The decoder finds each field from the opcode alone.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/isa/t27a.t27 (t27 master 90e797659): is_canonical and the listing, with t27a_encode, opcode_of, dst_of, t27a_src1, t27a_src2, v3_of, t27a_imm and imm_clamped spliced in from specs/isa/ternary_encoding.t27 and opcode_at from specs/isa/t27a_mnemonics.t27 through use, fn bodies compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 26 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 8;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_OPCODES : u8 = 47;
pub const K_REGISTERS : u8 = 27;
pub const K_IMM_MAX : u16 = 16383;
pub const K_IMM_NEG_MAX : u16 = 16384;
pub const K_PRESET_OP : [5]u8 = [3, 6, 0, 37, 41];
pub const K_PRESET_DST : [5]u8 = [4, 1, 0, 1, 2];
pub const K_PRESET_SRC1 : [5]u8 = [0, 2, 0, 2, 5];
pub const K_PRESET_SRC2 : [5]u8 = [0, 3, 0, 3, 0];
pub const K_PRESET_V3 : [5]u8 = [0, 0, 0, 4, 0];
pub const K_PRESET_MAG : [5]u16 = [12, 0, 0, 0, 9000];
pub const K_PRESET_NEG : [5]u8 = [1, 0, 0, 0, 0];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine steps of this course; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [5]str = ["LDI, a negative immediate", "ADD, three registers", "NOP", "BUNDLE3, a third register", "SACR, a large immediate"];
pub const SAY_ASK : str = "How do an opcode and its operands share one 32-bit word?";
pub const SAY_OP : str = "opcode";
pub const SAY_DST : str = "destination register";
pub const SAY_SRC1 : str = "source 1";
pub const SAY_SRC2 : str = "source 2";
pub const SAY_V3 : str = "third register";
pub const SAY_MAG : str = "immediate, size";
pub const SAY_NEG : str = "immediate is negative";
pub const SAY_WORD : str = "word {0}";
pub const SAY_LISTING : str = "listing";
pub const SAY_FIELDS : [7]str = ["opcode", "destination", "source 1", "source 2", "third register", "immediate", "unused"];
pub const SAY_READ_BACK : str = "the decoder reads back";
pub const SAY_NOT_IN_FORM : str = "not in this form";
pub const SAY_CANONICAL : str = "canonical";
pub const SAY_YES : str = "yes";
pub const SAY_NO : str = "no";
pub const SAY_NOTE : str = "The shape comes from the opcode: an immediate form has a four-bit source and a signed fifteen-bit immediate, a three-operand form has two five-bit sources, BUNDLE3 has a third register. A field the shape lacks is not written.";
pub const SAY_SOURCE : str = "Logic: t27 spec isa/t27a.t27, with the encoder and decoders from isa/ternary_encoding.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_is_one_of_nine_course_steps {
    assert K_STAGE < 9;
    assert K_STAGE == 8;
}

test forty_seven_opcodes_and_twenty_seven_registers {
    assert K_OPCODES == 47;
    assert K_REGISTERS == 27;
    assert K_IMM_MAX + 1 == K_IMM_NEG_MAX;
}

test presets_stay_in_range_and_start_on_a_negative_immediate {
    assert K_PRESET_OP[0] < K_OPCODES;
    assert K_PRESET_DST[3] < K_REGISTERS;
    assert K_PRESET_MAG[4] <= K_IMM_MAX;
    assert K_PRESET_NEG[0] == 1;
    assert K_PRESET_MAG[0] <= K_IMM_NEG_MAX;
    assert K_START_PRESET == 0;
}
