// SPDX-License-Identifier: Apache-2.0
; specs/widgets/sine-table.t27 -- a sine table: how many entries, how many bits, and what interpolation buys
; Source of truth for public/widgets/sine-table/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/sine-table/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/cordic.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 12 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader picks entries per quarter wave (4 to 1024), the word width and nearest-entry or
; linear interpolation. The quarter sine is drawn with the table's answer and its entries; the error curve
; runs underneath with two lines: the interpolation bound h^2/8 and the word bound 1/(2S). The worst error
; is measured on 8 points per entry against the spec's own 50-step CORDIC.

; WHAT IT DOES NOT CLAIM: a single quarter-wave table with symmetric folding assumed; phase truncation before the table is lesson 14.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_sine_table;

pub const KIND : str = "widget-tool";
pub const ID : str = "sine-table";
pub const TITLE : str = "Sine tables: entries, word width, and interpolation";
pub const DESCRIPTION : str = "Choose how many entries per quarter wave and how many bits each holds, with or without interpolation, and watch the worst error move between the two bounds.";
pub const IMAGE_ALT : str = "Sine table card: 16 entries of 16 bits per quarter wave. Taking the nearest entry is off by up to 0.049; interpolating between entries brings that to 0.0012, on the h^2/8 bound.";
pub const HOOK : str = "16 entries, nearest: off by 0.049. Same 16 entries, interpolated: 0.0012. Past a point more entries buy nothing until the words get wider.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/dsp/cordic.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "The interpolation bound: linear interpolation of f on a step h errs by at most h^2/8 max|f''| (any numerical analysis text); for sin, max|f''| = 1", "J. E. Volder, The CORDIC trigonometric computing technique, IRE Trans. Electronic Computers EC-8(3), 1959"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_ENTRIES : [9]u16 = [4, 8, 16, 32, 64, 128, 256, 512, 1024];
pub const K_MIN_BITS : u8 = 6;
pub const K_MAX_BITS : u8 = 24;
pub const K_QUARTER_MICRORAD : u32 = 1570796;
pub const K_PLOT_POINTS : u16 = 400;
pub const K_MAX_DOTS : u16 = 64;
pub const K_PRESET_ENTRIES : [4]u8 = [2, 2, 6, 6];
pub const K_PRESET_BITS : [4]u8 = [16, 16, 16, 12];
pub const K_PRESET_INTERP : [4]u8 = [0, 1, 1, 1];
pub const K_START_PRESET : u8 = 1;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["16 entries, nearest", "16 entries, interpolated", "256 entries, 16 bits", "256 entries, 12 bits: the words limit"];
pub const SAY_ENTRIES : str = "Entries per quarter wave";
pub const SAY_BITS : str = "Word width, bits";
pub const SAY_LOOKUP : str = "Lookup";
pub const SAY_LOOKUPS : [2]str = ["nearest entry", "linear interpolation"];
pub const SAY_WAVE_LABEL : str = "A quarter of a sine, the table's answer and its entries";
pub const SAY_ERR_LABEL : str = "The table's error over the quarter wave, with the two bounds";
pub const SAY_QUARTER : str = "0 to pi/2";
pub const SAY_ERR_AXIS : str = "error, absolute";
pub const SAY_WORST_IS : str = "worst {0}";
pub const SAY_WORST : str = "worst error";
pub const SAY_IB : str = "interpolation bound h^2/8";
pub const SAY_WB : str = "word bound 1/(2S)";
pub const SAY_MEMORY : str = "table memory";
pub const SAY_BITS_N : str = "{0} bits";
pub const SAY_SINE : str = "sine";
pub const SAY_TABLE : str = "table";
pub const SAY_NOTE : str = "h is the step between entries, pi/2 divided by their number; S is the largest word, 2^(b-1) - 1. Interpolation trades a multiply for many entries.";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/cordic.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_entries_double {
    assert K_ENTRIES[0] == 4;
    assert K_ENTRIES[1] == K_ENTRIES[0] * 2;
    assert K_ENTRIES[8] == 1024;
}

test the_presets_compare_like_with_like {
    assert K_PRESET_ENTRIES[0] == K_PRESET_ENTRIES[1];
    assert K_PRESET_INTERP[0] == 0;
    assert K_PRESET_INTERP[1] == 1;
    assert K_PRESET_BITS[3] < K_PRESET_BITS[2];
    assert K_QUARTER_MICRORAD == 1570796;
}
