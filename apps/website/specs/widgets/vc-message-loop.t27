// SPDX-License-Identifier: Apache-2.0
; specs/widgets/vc-message-loop.t27 -- a toy bot you talk to: watch the message loop turn
; Source of truth for public/widgets/vc-message-loop/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English of its own: every
; word on screen is a SAY_ constant here, every number the tool relies on is a K_ constant.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader picks messages (start, help, stop, or something the bot does not know)
; and sends them one at a time to a toy bot. Each turn the page shows the loop's four beats: wait
; for a message, read it, pick a reply from the table, send the reply, go back to waiting. A stop
; message ends the loop. Lesson 1 of the module "A first bot" of the course Vibecoding from zero.
; The lesson spec it illustrates: specs/vibecoding/message_loop.t27.

; WHAT IT DOES NOT CLAIM: it is not a real chat bot and talks to no network; the reply table is the
; one of the lesson spec, six words long. Nothing is sent anywhere.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_vc_message_loop;

pub const KIND : str = "widget-tool";
pub const ID : str = "vc-message-loop";
pub const TITLE : str = "A bot is a loop: send messages, watch it answer";
pub const DESCRIPTION : str = "Send start, help or an unknown word to a toy bot and watch the four beats of its message loop: wait, read, reply, wait again. A stop message ends it. Nothing is sent.";
pub const IMAGE_ALT : str = "A black and white loop diagram with four boxes in a ring: wait for a message, read it, pick a reply from the table, send it; an arrow leaves the ring at the stop message.";
pub const HOOK : str = "A bot is a loop that answers one message at a time. Send it a few and watch each turn.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [1]str = ["specs/vibecoding/message_loop.t27: its reply table and inbox, with tests that pass in the site test runner"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- Numbers the tool relies on ------------------------------------------------------------
; Messages: 0 unknown, 1 start, 2 help, 3 stop. The reply for each, 0 meaning none.
pub const K_MSG_COUNT : u8 = 4;
pub const K_STOP_MSG : u8 = 3;
pub const K_REPLY_TABLE : [4]u8 = [90, 10, 20, 0];
pub const K_BEAT_COUNT : u8 = 4;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PICK_LABEL : str = "Send a message to the bot";
pub const SAY_MSG_NAMES : [4]str = ["blah", "start", "help", "stop"];
pub const SAY_REPLY_TEXTS : [4]str = ["I did not understand that.", "Hello! I am a first bot.", "Try start, help or stop.", ""];
pub const SAY_BEATS : [4]str = ["Wait for a message", "Read it", "Pick the reply from the table", "Send the reply"];
pub const SAY_TURN : str = "Turn {0}: you sent {1}";
pub const SAY_BOT_SAYS : str = "The bot says: {0}";
pub const SAY_STOPPED : str = "A stop message: the loop ends and nothing is sent back.";
pub const SAY_RESTART : str = "Start the loop again";
pub const SAY_LOG_TITLE : str = "What the bot answered";
pub const SAY_NOTE : str = "The same message always gets the same reply: the reply depends on the message alone.";

; --- Tests ----------------------------------------------------------------------------------
test the_table_has_a_slot_for_every_message {
    assert K_MSG_COUNT == 4;
    assert K_REPLY_TABLE[K_MSG_COUNT - 1] == 0;
    assert K_STOP_MSG == K_MSG_COUNT - 1;
}

test the_four_beats_are_all_named {
    assert K_BEAT_COUNT == 4;
    assert SAY_BEATS[K_BEAT_COUNT - 1] == "Send the reply";
}

test two_commands_never_share_a_reply {
    assert K_REPLY_TABLE[1] != K_REPLY_TABLE[2];
    assert K_REPLY_TABLE[1] != K_REPLY_TABLE[0];
}

test the_page_sends_nothing {
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == false;
}
