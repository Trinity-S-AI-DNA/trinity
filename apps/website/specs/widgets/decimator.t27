// SPDX-License-Identifier: Apache-2.0
; specs/widgets/decimator.t27 -- decimation: keep every R-th sample, and what folds onto your band
; Source of truth for public/widgets/decimator/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/decimator/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 19 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: at a fixed input rate of 400 the reader sets the decimation factor R, the band to keep
; and a tone. Every input frequency that would land inside the band after decimating is painted (green: the
; band itself, red: everything that folds onto it); below, the output spectrum at the new rate shows where
; the tone lands, red when it lands in the band.

; WHAT IT DOES NOT CLAIM: no filter is drawn: the red zones are what a decimation filter must remove before the samples are dropped.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_decimator;

pub const KIND : str = "widget-tool";
pub const ID : str = "decimator";
pub const TITLE : str = "Decimation: lower the rate without folding noise in";
pub const DESCRIPTION : str = "Pick a decimation factor and a band to keep. See every input frequency that would fold onto that band, and where a tone lands after the rate drops.";
pub const IMAGE_ALT : str = "Decimator card: an input rate of 400 decimated by 4 to 100, keeping a band of 10. Red zones around 100 and 200 fold straight onto the band; a tone at 95 lands at 5, inside it.";
pub const HOOK : str = "Decimate 400 by 4 and a tone at 95 lands at 5, right inside your band. That is what the filter before the decimator is for.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "R. E. Crochiere, L. R. Rabiner, Multirate Digital Signal Processing, Prentice Hall, 1983: decimation and polyphase structures", "R. G. Lyons, Understanding Digital Signal Processing, 3rd ed., ch. 10: sample rate conversion"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_FS : u16 = 400;
pub const K_MAX_R : u8 = 16;
pub const K_MAX_BAND : u8 = 50;
pub const K_PRESET_R : [4]u8 = [4, 4, 8, 2];
pub const K_PRESET_BAND : [4]u8 = [10, 10, 5, 40];
pub const K_PRESET_F : [4]u16 = [30, 95, 47, 170];
pub const K_START_PRESET : u8 = 1;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["R = 4: a tone in the band", "R = 4: 95 folds onto 5", "R = 8, a narrow band", "R = 2, a wide band"];
pub const SAY_R : str = "Decimation factor R";
pub const SAY_BAND : str = "Band to keep, 0 to";
pub const SAY_F : str = "Tone";
pub const SAY_IN_LABEL : str = "Input frequencies that fold onto the band after decimation";
pub const SAY_OUT_LABEL : str = "The output spectrum at the new rate, and where the tone lands";
pub const SAY_IN_AXIS : str = "input frequency, sample rate {0}";
pub const SAY_OUT_AXIS : str = "output frequency, new rate {0}";
pub const SAY_NOTE : str = "After decimation every multiple of the new rate looks like 0: whatever sits within the band of one lands on the band.";
pub const SAY_NEW_RATE : str = "new rate";
pub const SAY_LANDS : str = "the tone lands at";
pub const SAY_IN_BAND : str = "lands in the band";
pub const SAY_YES : str = "yes";
pub const SAY_NO : str = "no";
pub const SAY_BAND_IS : str = "band kept";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/signals.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_folding_preset_lands_in_the_band {
    assert K_FS / K_PRESET_R[1] - K_PRESET_F[1] <= K_PRESET_BAND[1];
    assert K_PRESET_F[0] < K_FS / K_PRESET_R[0] / 2;
}

test the_ranges_fit_the_rate {
    assert K_MAX_R <= 16;
    assert K_MAX_BAND * 8 == K_FS;
    assert K_PRESET_F[3] <= K_FS / 2;
}
