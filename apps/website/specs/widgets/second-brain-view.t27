// SPDX-License-Identifier: Apache-2.0
; second-brain-view.t27 -- the view descriptor: what the graph looks like and how a click binds.
; Coordinates, shapes, kinds, edge endpoints and the selection binding are data here, generated
; to the module tool.js imports; the hand host draws whatever the descriptor says and holds no
; node names, no coordinates and no shape rules of its own. A MINI descriptor (two nodes, one
; edge) is kept beside the full one as the smallest vertical example the harness can render.
; KIND is not widget-tool on purpose: the widget generator skips this file; t27c test is its gate.
; phi^2 + 1/phi^2 = 3 | TRINITY

module second_brain_view;

pub const KIND : str = "view-descriptor";

; --- Shapes: the two the host knows. Anything else must be refused, not guessed. ---
pub const SHAPE_DISC : u8 = 1;
pub const SHAPE_SQUARE : u8 = 2;

; --- Node padding, in graph coordinates: the gap between a label's box and the
; node's border, on each axis. The host sizes every node from its label plus
; this padding -- it never shrinks a font to fit a fixed node. ---
pub const K_VIEW_PADDING_X : u16 = 16;
pub const K_VIEW_PADDING_Y : u16 = 12;

; --- The binding of a node click: event 4 touches field 0 (selected) with op 3 (toggle). ---
pub const K_SELECT_BINDING : [4]u16 = [4, 0, 3, 0];

; --- MINI: two nodes, one edge, one binding. The vertical example. -----------------
pub const MINI_NODE_COUNT : u8 = 2;
pub const SAY_MINI_NODE_TITLES : [2]str = ["One", "Two"];
pub const K_MINI_NODE_X : [2]i16 = [-80, 80];
pub const K_MINI_NODE_Y : [2]i16 = [0, 0];
pub const K_MINI_NODE_SHAPES : [2]u8 = [1, 1];
pub const K_MINI_EDGE_COUNT : u8 = 1;
pub const K_MINI_EDGE_SRC : [1]u8 = [0];
pub const K_MINI_EDGE_DST : [1]u8 = [1];
pub const SAY_MINI_EDGE_LABELS : [1]str = ["relates to"];

; --- FULL: the six-node demo graph, geometry spelled, not computed. -----------------
pub const VIEW_NODE_COUNT : u8 = 6;
pub const SAY_VIEW_NODE_TITLES : [6]str = ["Alpha", "Beta", "Gamma", "Delta", "Epsilon", "Zeta"];
pub const SAY_VIEW_NODE_KINDS : [6]str = ["concept", "concept", "note", "concept", "source", "note"];
pub const K_VIEW_NODE_SHAPES : [6]u8 = [1, 1, 2, 1, 1, 2];
pub const K_VIEW_NODE_X : [6]i16 = [0, 95, 95, 0, -95, -95];
pub const K_VIEW_NODE_Y : [6]i16 = [-110, -55, 55, 110, 55, -55];
pub const VIEW_EDGE_COUNT : u8 = 6;
pub const K_VIEW_EDGE_SRC : [6]u8 = [0, 1, 2, 3, 4, 0];
pub const K_VIEW_EDGE_DST : [6]u8 = [1, 2, 3, 4, 5, 5];
pub const SAY_VIEW_EDGE_LABELS : [6]str = ["relates to", "extends", "contrasts", "references", "extends", "relates to"];

test padding_is_graph_distance {
    assert K_VIEW_PADDING_X == 16;
    assert K_VIEW_PADDING_Y == 12;
}

test mini_is_one_edge_over_two_nodes {
    assert MINI_NODE_COUNT == 2;
    assert K_MINI_EDGE_SRC[0] < MINI_NODE_COUNT;
    assert K_MINI_EDGE_DST[0] < MINI_NODE_COUNT;
    assert K_MINI_NODE_SHAPES[0] == SHAPE_DISC;
}

test select_binding_toggles_selected {
    assert K_SELECT_BINDING[0] == 4;
    assert K_SELECT_BINDING[1] == 0;
    assert K_SELECT_BINDING[2] == 3;
}

test full_graph_geometry_is_present {
    assert VIEW_NODE_COUNT == 6;
    assert VIEW_EDGE_COUNT == 6;
    assert K_VIEW_NODE_SHAPES[2] == SHAPE_SQUARE;
    assert K_VIEW_NODE_SHAPES[3] == SHAPE_DISC;
    assert K_VIEW_EDGE_SRC[5] < VIEW_NODE_COUNT;
    assert K_VIEW_EDGE_DST[5] < VIEW_NODE_COUNT;
}

test shapes_are_known_shapes {
    assert K_VIEW_NODE_SHAPES[0] == SHAPE_DISC or K_VIEW_NODE_SHAPES[0] == SHAPE_SQUARE;
    assert K_VIEW_NODE_SHAPES[4] == SHAPE_DISC or K_VIEW_NODE_SHAPES[4] == SHAPE_SQUARE;
}
