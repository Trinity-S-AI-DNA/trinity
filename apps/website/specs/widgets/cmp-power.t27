// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-power.t27 -- What it will draw: a power estimate from the resource count
; Source of truth for public/widgets/cmp-power/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-power/logic.js -- the fn
; bodies of gHashTag/t27 specs/compiler/hir_cost_models.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 11 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader sets the resources, the clock and the toggle rate. The widget asks each of the five estimate fns
; and draws one bar per answer, with a total that adds the bars.

; WHAT IT DOES NOT CLAIM:  it measures no board. These are the compiler's static estimates, in whole milliwatts, rounded down by
; the integer arithmetic of the spec. The ranges stop where the spec's 32-bit arithmetic would wrap.
; The spec has no total fn: the page adds the bars, and the host sums the four resource counts and passes the sum to est_static as its argument.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_power;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-power";
pub const TITLE : str = "What it will draw: a power estimate from the resource count";
pub const DESCRIPTION : str = "The compiler also estimates power. Set how many LUTs, flip-flops, block RAMs and DSPs a design uses, the clock and the toggle rate, and read each part of the estimate in milliwatts.";
pub const IMAGE_ALT : str = "Power card: a design of 800 LUTs, 600 flip-flops, 2 block RAMs and 16 DSPs at 200 MHz with a 25 percent toggle rate. Bars show 400 mW for the LUTs, 150 for the flip-flops, 20 for the block RAMs, 320 for the DSPs and 191 static, and a total of 1081 milliwatts.";
pub const HOOK : str = "A DSP block costs ten times a LUT per megahertz, a block RAM five, and an idle chip still draws a base of milliwatts: the model is five short formulas.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/compiler/hir_cost_models.t27 (t27 master 90e797659): every number is est_lut_dynamic, est_ff_dynamic, est_bram_dynamic, est_dsp_dynamic or est_static, fn bodies compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 11 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 3;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_MAX_LUTS : u16 = 8000;
pub const K_MAX_FFS : u16 = 8000;
pub const K_MAX_BRAMS : u8 = 100;
pub const K_MAX_DSPS : u8 = 100;
pub const K_MIN_MHZ : u8 = 10;
pub const K_MAX_MHZ : u16 = 500;
pub const K_MAX_TOGGLE : u8 = 100;
pub const K_LUT_POWER_UW_PER_MHZ : u8 = 10;
pub const K_FF_POWER_UW_PER_MHZ : u8 = 5;
pub const K_BRAM_POWER_UW_PER_MHZ : u8 = 50;
pub const K_DSP_POWER_UW_PER_MHZ : u8 = 100;
pub const K_STATIC_BASE_MW : u8 = 50;
pub const K_PRESET_LUTS : [4]u16 = [800, 120, 6000, 3000];
pub const K_PRESET_FFS : [4]u16 = [600, 64, 5000, 2000];
pub const K_PRESET_BRAMS : [4]u8 = [2, 0, 40, 20];
pub const K_PRESET_DSPS : [4]u8 = [16, 0, 60, 0];
pub const K_PRESET_MHZ : [4]u16 = [200, 100, 300, 50];
pub const K_PRESET_TOGGLE : [4]u8 = [25, 25, 50, 12];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine steps of this course; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [4]str = ["A FIR filter", "A small counter", "A busy design", "A quiet design"];
pub const SAY_ASK : str = "What will a design draw, counted before it is ever built?";
pub const SAY_LUTS : str = "LUTs";
pub const SAY_FFS : str = "flip-flops";
pub const SAY_BRAMS : str = "block RAMs";
pub const SAY_DSPS : str = "DSPs";
pub const SAY_MHZ : str = "clock, MHz";
pub const SAY_TOGGLE : str = "toggle rate, percent";
pub const SAY_PARTS : [5]str = ["LUT dynamic", "flip-flop dynamic", "block RAM dynamic", "DSP dynamic", "static"];
pub const SAY_MW : str = "{0} mW";
pub const SAY_TOTAL : str = "total";
pub const SAY_PER_MHZ : str = "Each unit draws {0} uW per MHz for a LUT, {1} for a flip-flop, {2} for a block RAM and {3} for a DSP; the idle chip draws {4} mW before any resource.";
pub const SAY_NOTE : str = "LUTs and flip-flops scale with the toggle rate; block RAM and DSP blocks do not take one. The static part is the base plus a small term for every resource.";
pub const SAY_SOURCE : str = "Logic: t27 spec compiler/hir_cost_models.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_is_one_of_nine_course_steps {
    assert K_STAGE < 9;
    assert K_STAGE == 3;
}

test the_power_constants_per_megahertz {
    assert K_LUT_POWER_UW_PER_MHZ == 10;
    assert K_FF_POWER_UW_PER_MHZ * 2 == K_LUT_POWER_UW_PER_MHZ;
    assert K_BRAM_POWER_UW_PER_MHZ == 50;
    assert K_DSP_POWER_UW_PER_MHZ == 100;
    assert K_STATIC_BASE_MW == 50;
}

test the_ranges_keep_the_u32_arithmetic_from_wrapping {
    assert K_MAX_LUTS * 10 * K_MAX_MHZ * K_MAX_TOGGLE < 4294967295;
    assert K_PRESET_LUTS[0] <= K_MAX_LUTS;
    assert K_PRESET_MHZ[2] <= K_MAX_MHZ;
    assert K_START_PRESET == 0;
}
