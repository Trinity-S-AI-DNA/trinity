; specs/widgets/vc-prompt-parts.t27 -- the infographic of lesson 1 of module Prompting, course Vibecoding from zero (specs/course/vibecoding.t27)
; Source of truth for public/widgets/vc-prompt-parts/ (gHashTag/trinity), in the shape of specs/widgets/basics-a-test-block.t27:
; a table and a flow diagram, black and white, no words in JS. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: specs/vibecoding/prompt_parts.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_vc_prompt_parts;

pub const KIND : str = "widget-tool";
pub const ID : str = "vc-prompt-parts";
pub const TITLE : str = "Vibecoding: the four parts of a prompt";
pub const DESCRIPTION : str = "A prompt that works has a goal, context, limits and a check. Three prompts, from vague to full, and how many parts each carries. Vibecoding from zero, Prompting.";
pub const IMAGE_ALT : str = "A black and white diagram of a prompt split into four parts, goal, context, limit and check; a table lists three prompts with the parts each one carries and whether an agent can be sent to run it.";
pub const HOOK : str = "Most prompts name a goal and nothing else. Here are the other three parts.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [1]str = ["The lesson spec specs/vibecoding/prompt_parts.t27: its constants and tests, run by the site test runner (t27check.mjs); the part counts below are the masks 0, 1 and 15 of that spec"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Three prompts for one cart page";
pub const SAY_TABLE_HEAD : [3]str = ["Prompt", "Parts", "Ready to run"];
pub const SAY_TABLE_CELLS : [9]str = [
    "Make it better", "0 of 4", "no",
    "Add a total line to the cart page", "1 of 4: goal", "no: no check",
    "Add a total line to the cart page (goal). The page is cart.html (context). Do not touch the price code (limit). The test cart_total must pass (check).", "4 of 4", "yes"
];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 3;
pub const K_TABLE_CELLS : u16 = 9;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "One prompt, four parts";
pub const SAY_FLOW_STEPS : [4]str = ["Goal: what to do", "Context: what the agent cannot see", "Limit: what not to touch", "Check: how you know it is done"];
pub const K_FLOW_STEPS : u8 = 4;
pub const SAY_NOTE : str = "The counts are the masks of the lesson spec: 0, 1 and 15.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 4;
    assert K_FLOW_STEPS > 1;
}
