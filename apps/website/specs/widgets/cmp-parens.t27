// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-parens.t27 -- Minus before a bracket: the parentheses the parser forgot
; Source of truth for public/widgets/cmp-parens/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-parens/logic.js -- the fn
; bodies of gHashTag/t27 specs/compiler/codegen_conformance.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 13 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader sets two numbers and two switches. negated_sum, nand and nor_bits are called with them and their
; results are shown; the nor result is drawn as bits beside the two inputs.

; WHAT IT DOES NOT CLAIM:  it does not run the defective compiler: the wrong reading of each case is quoted from the spec's header as
; words, not computed. negated_float_sum, the fourth case, is not run here.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_parens;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-parens";
pub const TITLE : str = "Minus before a bracket: the parentheses the parser forgot";
pub const DESCRIPTION : str = "The parser keeps no parentheses, so a backend once wrote a unary operator straight before its first operand. Three conformance cases pin the fix: -(a + b), !(a and b) and ~(a | b).";
pub const IMAGE_ALT : str = "Parentheses card: a is 1 and b is 2. The negated sum is -3. The nand of true and false is true. The bitwise nor of 1 and 2 is 252, drawn as three rows of eight bits: 00000001, 00000010 and the result 11111100, which has a one only where both inputs have a zero.";
pub const HOOK : str = "Minus a bracket of a plus b is not minus a, plus b. One silent miscompile gave a loss function the wrong sign, and three tiny cases now guard it.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/compiler/codegen_conformance.t27 (t27 master 90e797659): every result is negated_sum, nand or nor_bits, fn bodies compiled to wasm (logic.js)", "Course 12 of t27.ai, t27-compiler: lesson 13 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 4;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_MAX_BYTE : u8 = 255;
pub const K_PRESET_A : [4]u8 = [1, 0, 255, 128];
pub const K_PRESET_B : [4]u8 = [2, 0, 255, 127];
pub const K_PRESET_X : [4]u8 = [1, 0, 1, 0];
pub const K_PRESET_Y : [4]u8 = [0, 0, 1, 1];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine steps of this course; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [4]str = ["The spec's own", "Both zero", "Both full", "Opposite halves"];
pub const SAY_ASK : str = "Does a minus in front of a bracket reach everything inside it?";
pub const SAY_A : str = "a";
pub const SAY_B : str = "b";
pub const SAY_X : str = "x is true";
pub const SAY_Y : str = "y is true";
pub const SAY_CASES : [3]str = ["-(a + b)", "!(x and y)", "~(a | b)"];
pub const SAY_WRONG : [3]str = ["written as -a + b", "written as !x and y", "written as ~a | b"];
pub const SAY_WRONG_LABEL : str = "The defective compiler";
pub const SAY_RIGHT_LABEL : str = "The compiled spec";
pub const SAY_TRUE : str = "true";
pub const SAY_FALSE : str = "false";
pub const SAY_BITS : [3]str = ["a", "b", "result"];
pub const SAY_NOTE : str = "The parser keeps no parentheses, so the backend must put them back around everything a unary operator covers. The case that failed in the wild was a loss function that came out with the wrong sign.";
pub const SAY_SOURCE : str = "Logic: t27 spec compiler/codegen_conformance.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_is_one_of_nine_course_steps {
    assert K_STAGE < 9;
    assert K_STAGE == 4;
}

test presets_are_bytes_and_the_start_is_the_spec_vector {
    assert K_PRESET_A[0] == 1;
    assert K_PRESET_B[0] == 2;
    assert K_PRESET_X[0] == 1;
    assert K_PRESET_Y[0] == 0;
    assert K_START_PRESET == 0;
}

test a_byte_is_eight_bits {
    assert K_MAX_BYTE == 255;
    assert K_MAX_BYTE + 1 == 256;
    assert K_PRESET_A[2] == K_MAX_BYTE;
}
