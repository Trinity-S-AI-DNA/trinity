// SPDX-License-Identifier: Apache-2.0
; second-brain-flow.t27 -- the data model of the control-flow view: what a flow node
; and a flow edge are allowed to be, and what every mesh cell must carry. The values
; come from scripts/flow-extract.mjs (compiler AST for control flow, nm/otool for the
; .o symbol table); this spec is the contract the extractor and the renderer are held
; to. GOST 19.701-90 names the shapes the projection draws. KIND is not widget-tool
; on purpose; t27c test is its gate.
; phi^2 + 1/phi^2 = 3 | TRINITY

module second_brain_flow;

pub const KIND : str = "flow-model";
pub const MODEL_VERSION : u8 = 1;

; --- FlowNode kinds; the projection maps each to its GOST shape. ----------------
; entry/exit draw as ovals (terminators), action as a rectangle, decision as a
; diamond, io as a parallelogram (also the merge connector), call double-bordered
; (predefined process). ERROR is reserved: no source construct produces it yet.
pub const NODE_KIND_ENTRY : u8 = 0;
pub const NODE_KIND_ACTION : u8 = 1;
pub const NODE_KIND_DECISION : u8 = 2;
pub const NODE_KIND_LOOP : u8 = 3;
pub const NODE_KIND_IO : u8 = 4;
pub const NODE_KIND_CALL : u8 = 5;
pub const NODE_KIND_ERROR : u8 = 6;
pub const NODE_KIND_EXIT : u8 = 7;
pub const K_NODE_KIND_COUNT : u8 = 8;

; --- FlowEdge kinds. -------------------------------------------------------------
pub const EDGE_NORMAL : u8 = 0;
pub const EDGE_RETRY : u8 = 1;
pub const EDGE_ERROR : u8 = 2;
pub const EDGE_LOOP_BACK : u8 = 3;

; --- Mesh cell: the smallest visible unit, and what it must always carry. --------
pub const K_CELL_REQUIRED_FIELDS : u8 = 5;
pub const SAY_CELL_REQUIRED_FIELDS : [5]str = ["id", "kind", "source_ref", "status", "grid"];
; status: what the cell is right now; `unknown` is a legal value, never hidden.
pub const SAY_CELL_STATUSES : [4]str = ["idle", "active", "done", "unknown"];

; --- Runtime events. A live highlight is legal ONLY on these. --------------------
pub const SAY_TRACE_EVENTS : [7]str = ["node_entered", "condition_evaluated", "branch_chosen", "state_changed", "effect_attempted", "error", "recovery"];
pub const K_TRACE_EVENT_COUNT : u8 = 7;

test node_kinds_cover_gost {
    assert K_NODE_KIND_COUNT == 8;
    assert NODE_KIND_ENTRY == 0;
    assert NODE_KIND_DECISION == 2;
    assert NODE_KIND_CALL == 5;
    assert NODE_KIND_EXIT == 7;
}

; No source construct produces ERROR yet; the extractor marks recovery paths
; UNKNOWN instead of inventing an error node.
test error_kind_is_reserved {
    assert NODE_KIND_ERROR == 6;
}

test cell_contract_is_explicit {
    assert K_CELL_REQUIRED_FIELDS == 5;
    assert SAY_CELL_REQUIRED_FIELDS[0] == "id";
    assert SAY_CELL_REQUIRED_FIELDS[2] == "source_ref";
}

test trace_events_are_named {
    assert K_TRACE_EVENT_COUNT == 7;
    assert SAY_TRACE_EVENTS[0] == "node_entered";
    assert SAY_TRACE_EVENTS[6] == "recovery";
}

test loop_back_edge_is_named {
    assert EDGE_LOOP_BACK == 3;
}
