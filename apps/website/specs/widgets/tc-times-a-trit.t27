// SPDX-License-Identifier: Apache-2.0
; specs/widgets/tc-times-a-trit.t27 -- lesson 10 of the course "The ternary machine" (specs/course/ternary-computing.t27)
; Source of truth for public/widgets/tc-times-a-trit/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles this
; file, checks its constants, evaluates the tests below and writes the page; the page hands every constant to
; tool.js as window.T27_WIDGET. tool.js draws through ../ternary-kit.js and computes nothing: every number comes
; from public/widgets/tc-times-a-trit/logic.js, the fn bodies of the gHashTag/t27 spec in logic.t27, compiled to wasm.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_tc_times_a_trit;

pub const KIND : str = "widget-tool";
pub const ID : str = "tc-times-a-trit";
pub const TITLE : str = "Times one trit: copy, drop or flip";
pub const DESCRIPTION : str = "Multiplying by a trit needs no multiplier. By +1 the number is copied, by 0 dropped, by -1 every trit is flipped.";
pub const IMAGE_ALT : str = "Times a trit card: 25 times -1. 25 is +0-+ in balanced ternary; times -1 every trit flips to -0+-, which is -25. No multiplier, only wires and inverters.";
pub const HOOK : str = "A ternary multiplier is a switch: pass, zero or flip. That is why ternary neural nets need no multipliers.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ternary/trits.t27 (t27#8979): every value on the page is its fn bodies, compiled to wasm (logic.js), with 18 tests and 4108 runtime asserts", "S. Ma and others, The Era of 1-bit LLMs: All Large Language Models are in 1.58 Bits, 2024: weights of -1, 0 and +1"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

pub const SAY_LOADING : str = "Loading";
pub const K_TRITS : u32 = 6;
pub const K_START : i32 = 25;
pub const SAY_TRIT : str = "Multiply by";
pub const SAY_RESULT : str = "{0} x {1} = {2}";
pub const SAY_TIMES : str = "times {0}";
pub const SAY_OPS : [3]str = ["flip every trit", "drop it: zero", "copy it"];
pub const SAY_SOURCE : str = "Logic: t27 spec ternary/trits.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_widget_starts_where_its_card_says {
    assert K_START == 25;
}
