// SPDX-License-Identifier: Apache-2.0
; specs/widgets/vc-myth-tests.t27 -- the infographic of lesson 3 of the vibecoding course (specs/course/vibecoding.t27)
; Source of truth for public/widgets/vc-myth-tests/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: specs/vibecoding/myth_tests.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_vc_myth_tests;

pub const KIND : str = "widget-tool";
pub const ID : str = "vc-myth-tests";
pub const TITLE : str = "Vibecoding 3: five myths, each put to a test";
pub const DESCRIPTION : str = "Five sentences that sound right about vibecoding, each settled by a small case a test can run. Lesson 3 of the vibecoding course.";
pub const IMAGE_ALT : str = "A black and white table of five myths about vibecoding with the small case that settles each one: an average that runs and gives 8 instead of 6, a double that passes at 2 and fails at 3, 8 messages kept of 20, 7 halved and doubled gives 6, and a check that says yes to 2 against 3; a diagram walks the steps of a test.";
pub const HOOK : str = "Five myths about vibecoding, each one settled by a test you can read in a minute.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [1]str = ["The lesson spec specs/vibecoding/myth_tests.t27, whose tests pass in the site test runner; every number is a constant of that spec"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Five myths and the case that settles each";
pub const SAY_TABLE_HEAD : [2]str = ["Myth", "What the test found"];
pub const SAY_TABLE_CELLS : [10]str = [
    "If it runs without an error, it is right.", "average of 4 and 8 printed 8, the answer is 6",
    "One passing test proves the code is right.", "x * x equals x + x at 2 and not at 3",
    "The agent remembers the whole conversation.", "8 messages kept of 20 sent",
    "A step you do can always be undone.", "7 halved and doubled is 6, not 7",
    "A check that passes is a good check.", "a check that says yes to 2 against 3 cannot fail"
];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 5;
pub const K_TABLE_CELLS : u16 = 10;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "How a myth is put to a test";
pub const SAY_FLOW_STEPS : [4]str = ["Say the myth as a sentence", "Find a small case where it could fail", "Write the check with the answer you expect", "Run it and read the verdict"];
pub const K_FLOW_STEPS : u8 = 4;
pub const SAY_NOTE : str = "The cases are small on purpose: each fits in one line you can check by hand.";

; --- The numbers behind the table ------------------------------------------------------------
pub const K_MYTHS : u8 = 5;
pub const K_AVG_RAN : u16 = 8;
pub const K_AVG_RIGHT : u16 = 6;
pub const K_MESSAGES_SENT : u16 = 20;
pub const K_MESSAGES_KEPT : u16 = 8;
pub const K_ODD_BACK : u16 = 6;

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
    assert K_TABLE_ROWS == K_MYTHS;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 4;
}

test the_table_numbers_come_from_the_lesson {
    assert K_AVG_RAN == 4 + 8 / 2;
    assert K_AVG_RIGHT == (4 + 8) / 2;
    assert K_MESSAGES_KEPT < K_MESSAGES_SENT;
    assert K_ODD_BACK == 7 / 2 * 2;
}
