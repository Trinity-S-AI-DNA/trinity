// SPDX-License-Identifier: Apache-2.0
; specs/widgets/vc-editor-agent.t27 -- the infographic of lesson 4 of the vibecoding course (specs/course/vibecoding.t27)
; Source of truth for public/widgets/vc-editor-agent/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/vibecoding/editor_agent.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_vc_editor_agent;

pub const KIND : str = "widget-tool";
pub const ID : str = "vc-editor-agent";
pub const TITLE : str = "Vibecoding 4: keep a change or send it back";
pub const DESCRIPTION : str = "Three changes an agent might propose in your editor, and the rule that decides each one: can you read all of it, and do the tests pass. Lesson 4 of the vibecoding course.";
pub const IMAGE_ALT : str = "A black and white table of three proposed changes. 3 changed lines, tests pass: keep. 12 changed lines, tests fail: send back. 90 changed lines, tests pass: send back, too long to read.";
pub const HOOK : str = "The agent edits fast. You decide what stays: readable, and passing.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [1]str = ["The lesson spec public/t27/files/specs/vibecoding/editor_agent.t27, compiled clean by public/t27/t27_compiler.wasm, whose tests pass in the site test runner; the rule and the three example changes are its constants"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Three changes an agent might propose, and the decision";
pub const SAY_TABLE_HEAD : [4]str = ["Change", "Changed lines", "Tests", "Decision"];
pub const SAY_TABLE_CELLS : [12]str = ["A rename", "3", "pass", "keep", "A new button", "12", "fail", "send back", "A whole-file rewrite", "90", "pass", "send back: too long to read"];
pub const K_TABLE_COLS : u8 = 4;
pub const K_TABLE_ROWS : u8 = 3;
pub const K_TABLE_CELLS : u16 = 12;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "One round with an agent in the editor";
pub const SAY_FLOW_STEPS : [4]str = ["You describe the change in words", "The agent edits the files", "You read the change and run the tests", "Keep it, or send it back"];
pub const K_FLOW_STEPS : u8 = 4;
pub const SAY_NOTE : str = "The limit of 20 lines is this lesson's rule, written as READ_LIMIT in its spec; pick your own and keep it.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 4;
    assert K_FLOW_STEPS > 1;
}
