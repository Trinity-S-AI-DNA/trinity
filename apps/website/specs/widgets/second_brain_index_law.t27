module SecondBrainIndexLaw;

// The edge law for the second-brain spec index (Milestone 4, slice A).
// Every decision the extractor makes about a call site is stated here, once,
// with tests -- and reaches the site as `t27c gen-js` output of THIS spec
// (scripts/gen/second_brain_index_law.gen.js, committed). The driver
// (scripts/spec-index.mjs) only walks the pinned compiler's AST and feeds
// rows into these functions; it holds no classification logic of its own.
//
// Verdicts for one call site, in the order the law applies them:
pub const V_HARNESS : u32 = 4;
pub const V_TEST_CALL : u32 = 1;
pub const V_SELF_LOOP : u32 = 3;
pub const V_FN_EDGE : u32 = 0;
pub const V_UNRESOLVED : u32 = 2;

// The measured corpus facts this law is pinned to (second-brain corpus,
// extracted 2026-11-13): three call sites in
// widgets/second-brain-view-logic all name the one relation
// square_reach_t -> abs_f; the test blocks call spec functions 159 times;
// a recursive call is never a relation.
pub const CALL_SITES_SQUARE_REACH_ABS_F : u32 = 3;
pub const UNIQUE_RELATIONS_SQUARE_REACH_ABS_F : u32 = 1;
pub const TEST_CALLS_CORPUS : u32 = 159;
pub const SELF_LOOPS_ALLOWED : u32 = 0;

fn is_harness(name: str) -> bool {
    return name == "assert" or name == "assert_eq";
}

fn same_name(a: str, b: str) -> bool {
    return a == b;
}

/// The one decision per call site. Order is law: the test harness names are
/// not program logic; a call inside a test block exercises a function
/// without being control flow; a recursive call is never a relation; a call
/// the spec declares is a resolved fn -> fn edge; anything else is an
/// UNRESOLVED reference, kept and shown, never silently dropped (#1649).
pub fn call_verdict(callee: str, caller: str, declared: bool, in_test: bool) -> u32 {
    if (is_harness(callee)) { return V_HARNESS; }
    if (in_test) { return V_TEST_CALL; }
    if (same_name(caller, callee)) { return V_SELF_LOOP; }
    if (declared) { return V_FN_EDGE; }
    return V_UNRESOLVED;
}

/// Only V_FN_EDGE sites become edges; a self-loop verdict is counted and
/// dropped, so the relation count stays 0 self-loops by construction.
pub fn is_edge(verdict: u32) -> bool {
    return verdict == V_FN_EDGE;
}

/// N call sites of the same relation collapse to the number of DISTINCT
/// relations, never to the number of sites.
pub fn relations_from_sites(sites: u32, distinct_relations: u32) -> u32 {
    return distinct_relations;
}

/// A widget-tool spec (KIND = "widget-tool" with a tool ID) generates two
/// artifacts -- its page and its byte-for-byte spec copy; anything else
/// generates none.
pub fn artifacts_for_tool(kind: str, tool_id_set: bool) -> u32 {
    if (kind == "widget-tool" and tool_id_set) { return 2; }
    return 0;
}

test harness_names_are_never_edges {
    assert call_verdict("assert", "f", true, false) == V_HARNESS;
    assert call_verdict("assert_eq", "f", true, false) == V_HARNESS;
    assert is_edge(V_HARNESS) == false;
}

test test_block_calls_are_counted_separately {
    assert call_verdict("abs_f", "", true, true) == V_TEST_CALL;
    assert call_verdict("undeclared_thing", "", false, true) == V_TEST_CALL;
    assert is_edge(V_TEST_CALL) == false;
}

test a_recursive_call_is_never_a_relation {
    assert call_verdict("walk", "walk", true, false) == V_SELF_LOOP;
    assert is_edge(V_SELF_LOOP) == false;
    assert SELF_LOOPS_ALLOWED == 0;
}

test a_declared_call_is_a_resolved_fn_edge {
    assert call_verdict("abs_f", "square_reach_t", true, false) == V_FN_EDGE;
    assert is_edge(V_FN_EDGE) == true;
}

test an_undeclared_call_stays_explicitly_unresolved {
    assert call_verdict("no_such_fn", "caller", false, false) == V_UNRESOLVED;
    assert is_edge(V_UNRESOLVED) == false;
}

test three_call_sites_collapse_to_one_unique_relation {
    assert CALL_SITES_SQUARE_REACH_ABS_F == 3;
    assert relations_from_sites(CALL_SITES_SQUARE_REACH_ABS_F, UNIQUE_RELATIONS_SQUARE_REACH_ABS_F) == 1;
}

test the_corpus_test_call_count_is_pinned {
    assert TEST_CALLS_CORPUS == 159;
}

test widget_tool_artifacts_are_two_per_spec {
    assert artifacts_for_tool("widget-tool", true) == 2;
    assert artifacts_for_tool("widget-tool", false) == 0;
    assert artifacts_for_tool("policy", true) == 0;
}

/// A `use` declaration resolves to a spec when its module name is that
/// spec's module; anything else stays an unresolved use, kept explicitly.
pub fn uses_resolves(module_name: str, spec_module: str) -> bool {
    return module_name == spec_module;
}

test uses_resolution_is_by_module_name {
    assert uses_resolves("SecondBrainIndexLaw", "SecondBrainIndexLaw") == true;
    assert uses_resolves("NoSuchModule", "SecondBrainIndexLaw") == false;
}
