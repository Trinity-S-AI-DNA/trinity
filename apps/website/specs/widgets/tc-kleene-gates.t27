// SPDX-License-Identifier: Apache-2.0
; specs/widgets/tc-kleene-gates.t27 -- lesson 4 of the course "The ternary machine" (specs/course/ternary-computing.t27)
; Source of truth for public/widgets/tc-kleene-gates/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles this
; file, checks its constants, evaluates the tests below and writes the page; the page hands every constant to
; tool.js as window.T27_WIDGET. tool.js draws through ../ternary-kit.js and computes nothing: every number comes
; from public/widgets/tc-kleene-gates/logic.js, the fn bodies of the gHashTag/t27 spec in logic.t27, compiled to wasm.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_tc_kleene_gates;

pub const KIND : str = "widget-tool";
pub const ID : str = "tc-kleene-gates";
pub const TITLE : str = "Three-valued logic: NOT, MIN and MAX";
pub const DESCRIPTION : str = "False, unknown, true as -1, 0, +1. AND is the minimum, OR the maximum, NOT a flip; on -1 and +1 alone they are Boolean logic.";
pub const IMAGE_ALT : str = "Kleene gates card: the MIN table, 3 rows by 3 columns of -1, 0 and +1. Its four corners, where no input is unknown, are the Boolean AND table; MIN(+, 0) is 0: unknown stays unknown.";
pub const HOOK : str = "Boolean logic is the four corners of a 3 x 3 table. The middle row is what a circuit says when it does not know.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ternary/trits.t27 (t27#8979): every value on the page is its fn bodies, compiled to wasm (logic.js), with 18 tests and 4108 runtime asserts", "S. C. Kleene, Introduction to Metamathematics, 1952, section 64: the strong three-valued logic"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

pub const SAY_LOADING : str = "Loading";
pub const K_GATES : [3]u32 = [1, 2, 0];
pub const K_GATE_NOT : u32 = 0;
pub const SAY_PICK : str = "Gate";
pub const SAY_GATES : [3]str = ["MIN", "MAX", "NOT"];
pub const SAY_OUT : str = "out";
pub const SAY_GATE_TIPS : [3]str = ["MIN is AND: the result is as false as the falsest input.", "MAX is OR: the result is as true as the truest input.", "NOT flips -1 and +1 and leaves unknown alone."];
pub const SAY_BOOL : str = "The dashed cells are Boolean logic: no input is 0 there. Press any cell.";
pub const SAY_SOURCE : str = "Logic: t27 spec ternary/trits.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_widget_starts_where_its_card_says {
    assert K_GATE_NOT == 0;
    assert K_GATES[0] == 1;
}
