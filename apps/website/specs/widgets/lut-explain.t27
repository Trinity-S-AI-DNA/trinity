// --- Constants and bit helpers -----------------------------------------------------------------
pub fn n_in() -> u32 { return W_N_IN; }
pub fn n_bits() -> u32 { return W_N_BITS; }
pub fn out_byte(i: usize) -> u8 { return OUT[i]; }
pub fn out_n() -> usize { return OUT_N; }

pub fn bit_of(v: u64, i: u32) -> u32 {
    return ((v >> i) & 1) as u32;
}

pub fn pop64(x0: u64) -> u32 {
    var x : u64 = x0;
    var n : u32 = 0;
    while (x != 0) {
        x = x & (x - 1);
        n = n + 1;
    }
    return n;
}

pub fn is_digit(b: u8) -> bool {
    return b >= 48 and b <= 57;
}

pub fn is_hex(b: u8) -> bool {
    return (b >= 48 and b <= 57) or (b >= 97 and b <= 102) or (b >= 65 and b <= 70);
}

pub fn hexv(b: u8) -> u32 {
    if (b >= 48 and b <= 57) { return (b as u32) - 48; }
    if (b >= 97 and b <= 102) { return (b as u32) - 87; }
    return (b as u32) - 55;
}

pub fn is_class(b: u8) -> bool {
    return (b >= 48 and b <= 57) or (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or b == 95;
}

pub fn out_reset() { OUT_N = 0; }

pub fn out_push(b: u8) {
    if (OUT_N < 512) {
        OUT[OUT_N] = b;
        OUT_N = OUT_N + 1;
    }
}

pub fn out_str(w: []const u8) {
    var k : usize = 0;
    while (k < w.len) {
        out_push(w[k]);
        k = k + 1;
    }
}

/// bigFromBits: bits[i] & 1 over i = 63 down to 0 (a missing entry reads as 0).
pub fn big_from_bits(b: []const u8) -> u64 {
    var v : u64 = 0;
    var i : u32 = 0;
    while (i < 64) {
        if ((i as usize) < b.len) {
            v = v | (((b[(i as usize)] & 1) as u64) << i);
        }
        i = i + 1;
    }
    return v;
}

/// initHex: 16 upper-case hex digits in OUT.
pub fn init_hex(bits: u64) -> usize {
    out_reset();
    var k : u32 = 0;
    while (k < 16) {
        const d : u32 = ((bits >> ((15 - k) * 4)) & 15) as u32;
        if (d < 10) { out_push((d + 48) as u8); } else { out_push((d + 55) as u8); }
        k = k + 1;
    }
    return OUT_N;
}

/// initBin: 64 characters in OUT, INIT[63] first.
pub fn init_bin(bits: u64) -> usize {
    out_reset();
    var k : u32 = 0;
    while (k < 64) {
        out_push((bit_of(bits, 63 - k) + 48) as u8);
        k = k + 1;
    }
    return OUT_N;
}

// --- JavaScript whitespace (trim and \s) -------------------------------------------------------
pub fn ws_fwd(b0: u8, b1: u8, b2: u8, avail: usize) -> usize {
    if (avail == 0) { return 0; }
    if (b0 == 32 or (b0 >= 9 and b0 <= 13)) { return 1; }
    if (b0 == 194) {
        if (avail >= 2 and b1 == 160) { return 2; }
        return 0;
    }
    if (avail < 3) { return 0; }
    if (b0 == 225) {
        if (b1 == 154 and b2 == 128) { return 3; }
        return 0;
    }
    if (b0 == 226) {
        if (b1 == 128) {
            if (b2 >= 128 and b2 <= 138) { return 3; }
            if (b2 == 168 or b2 == 169 or b2 == 175) { return 3; }
        }
        if (b1 == 129 and b2 == 159) { return 3; }
        return 0;
    }
    if (b0 == 227) {
        if (b1 == 128 and b2 == 128) { return 3; }
        return 0;
    }
    if (b0 == 239) {
        if (b1 == 187 and b2 == 191) { return 3; }
        return 0;
    }
    return 0;
}

pub fn ws_back(a: u8, m: u8, c: u8, avail: usize) -> usize {
    if (avail == 0) { return 0; }
    if (c == 32 or (c >= 9 and c <= 13)) { return 1; }
    if (avail >= 2 and m == 194 and c == 160) { return 2; }
    if (avail < 3) { return 0; }
    if (a == 225 and m == 154 and c == 128) { return 3; }
    if (a == 226 and m == 128) {
        if (c >= 128 and c <= 138) { return 3; }
        if (c == 168 or c == 169 or c == 175) { return 3; }
    }
    if (a == 226 and m == 129 and c == 159) { return 3; }
    if (a == 227 and m == 128 and c == 128) { return 3; }
    if (a == 239 and m == 187 and c == 191) { return 3; }
    return 0;
}

pub fn ws_at(s: []const u8, p: usize, hi: usize) -> usize {
    if (p >= hi) { return 0; }
    var b1 : u8 = 0;
    var b2 : u8 = 0;
    var avail : usize = 1;
    if (p + 1 < hi) { b1 = s[p + 1]; avail = 2; }
    if (p + 2 < hi) { b2 = s[p + 2]; avail = 3; }
    return ws_fwd(s[p], b1, b2, avail);
}

pub fn ws_before(s: []const u8, lo: usize, e: usize) -> usize {
    if (e <= lo) { return 0; }
    var a : u8 = 0;
    var m : u8 = 0;
    var avail : usize = 1;
    if (e >= lo + 2) { m = s[e - 2]; avail = 2; }
    if (e >= lo + 3) { a = s[e - 3]; avail = 3; }
    return ws_back(a, m, s[e - 1], avail);
}

/// s.trim() as [lo, hi) packed lo * 4294967296 + hi.
pub fn trim_pack(s: []const u8, lo0: usize, hi0: usize) -> u64 {
    var lo : usize = lo0;
    var hi : usize = hi0;
    while (lo < hi) {
        const w : usize = ws_at(s, lo, hi);
        if (w == 0) { break; }
        lo = lo + w;
    }
    while (hi > lo) {
        const w2 : usize = ws_before(s, lo, hi);
        if (w2 == 0) { break; }
        hi = hi - w2;
    }
    return (lo as u64) * 4294967296 + (hi as u64);
}

pub fn pk_lo(p: u64) -> usize { return (p / 4294967296) as usize; }
pub fn pk_hi(p: u64) -> usize { return (p % 4294967296) as usize; }

// --- parseLiteral ------------------------------------------------------------------------------
pub fn lit_value() -> u64 { return LIT_VAL; }
pub fn lit_width() -> u32 { return LIT_W; }

/// Value of digits LB[a .. b) in base 2, 10 or 16; LV_OVER is set when it does not fit a u64.
pub fn lb_value(a: usize, b: usize, base: u64) -> u64 {
    var v : u64 = 0;
    LV_OVER = false;
    var i : usize = a;
    while (i < b) {
        const d : u64 = hexv(LB[i]) as u64;
        if (v > (18446744073709551615 - d) / base) {
            LV_OVER = true;
            return 0;
        }
        v = v * base + d;
        i = i + 1;
    }
    return v;
}

/// The matching on LB[0 .. n): the four forms of lut.js.
pub fn lit_match(n: usize) -> bool {
    LIT_VAL = 0;
    LIT_W = 0;
    var p : usize = 0;
    while (p < n and is_digit(LB[p])) { p = p + 1; }
    if (p > 0 and p + 2 < n and LB[p] == 39) {
        const bl : u8 = LB[p + 1];
        if (bl == 104 or bl == 72 or bl == 98 or bl == 66 or bl == 100 or bl == 68) {
            var all_hex : bool = true;
            var q : usize = p + 2;
            while (q < n) {
                if (!is_hex(LB[q])) { all_hex = false; }
                q = q + 1;
            }
            if (all_hex) {
                // the Verilog form: it answers for itself, a failure does not fall through
                var width : f64 = 0.0;
                var i : usize = 0;
                while (i < p) {
                    width = width * 10.0 + (((LB[i] - 48) as u32) as f64);
                    i = i + 1;
                }
                if (width < 1.0 or width > 64.0) { return false; }
                var base : u64 = 16;
                if (bl == 98 or bl == 66) {
                    base = 2;
                    var j : usize = p + 2;
                    while (j < n) {
                        if (LB[j] != 48 and LB[j] != 49) { return false; }
                        j = j + 1;
                    }
                }
                if (bl == 100 or bl == 68) {
                    base = 10;
                    var j2 : usize = p + 2;
                    while (j2 < n) {
                        if (!is_digit(LB[j2])) { return false; }
                        j2 = j2 + 1;
                    }
                }
                const v : u64 = lb_value(p + 2, n, base);
                if (LV_OVER) { return false; }
                const w : u32 = width as u32;
                if (w < 64) {
                    if ((v >> w) != 0) { return false; }
                }
                LIT_VAL = v;
                LIT_W = w;
                return true;
            }
        }
    }
    // 0x + 1..16 hex digits
    if (n >= 3 and n <= 18 and LB[0] == 48 and (LB[1] == 120 or LB[1] == 88)) {
        var ok : bool = true;
        var k : usize = 2;
        while (k < n) {
            if (!is_hex(LB[k])) { ok = false; }
            k = k + 1;
        }
        if (ok) {
            LIT_VAL = lb_value(2, n, 16);
            LIT_W = 64;
            return true;
        }
    }
    // 64 binary digits
    if (n == 64) {
        var okb : bool = true;
        var m : usize = 0;
        while (m < n) {
            if (LB[m] != 48 and LB[m] != 49) { okb = false; }
            m = m + 1;
        }
        if (okb) {
            LIT_VAL = lb_value(0, n, 2);
            LIT_W = 64;
            return true;
        }
    }
    // bare hex, 1..16 digits
    if (n >= 1 and n <= 16) {
        var okh : bool = true;
        var r : usize = 0;
        while (r < n) {
            if (!is_hex(LB[r])) { okh = false; }
            r = r + 1;
        }
        if (okh) {
            LIT_VAL = lb_value(0, n, 16);
            LIT_W = 64;
            return true;
        }
    }
    return false;
}

/// parseLiteral(text): String(text).trim() with underscores removed, then the four forms.
pub fn parse_literal(text: []const u8) -> bool {
    const t : u64 = trim_pack(text, 0, text.len);
    var n : usize = 0;
    var i : usize = pk_lo(t);
    const e : usize = pk_hi(t);
    while (i < e) {
        if (text[i] != 95) {
            if (n >= 65536) { return false; }
            LB[n] = text[i];
            n = n + 1;
        }
        i = i + 1;
    }
    return lit_match(n);
}

// --- parseFasmLine -----------------------------------------------------------------------------
pub fn fl_kind() -> u32 { return FL_KIND; }
pub fn fl_text_lo() -> usize { return FL_TEXT_LO; }
pub fn fl_text_hi() -> usize { return FL_TEXT_HI; }
pub fn fl_tile_lo() -> usize { return FL_TILE_LO; }
pub fn fl_tile_hi() -> usize { return FL_TILE_HI; }
pub fn fl_type_hi() -> usize { return FL_TYPE_HI; }
pub fn fl_path_lo() -> usize { return FL_PATH_LO; }
pub fn fl_path_hi() -> usize { return FL_PATH_HI; }
pub fn fl_has_hi() -> bool { return FL_HAS_HI; }
pub fn fl_hi() -> f64 { return FL_HI; }
pub fn fl_has_lo() -> bool { return FL_HAS_LO; }
pub fn fl_lo() -> f64 { return FL_LO; }
pub fn fl_has_vtext() -> bool { return FL_HAS_VTEXT; }
pub fn fl_vtext_lo() -> usize { return FL_VTEXT_LO; }
pub fn fl_vtext_hi() -> usize { return FL_VTEXT_HI; }
pub fn fl_has_lit() -> bool { return FL_HAS_LIT; }
pub fn fl_lit_value() -> u64 { return FL_LIT; }
pub fn fl_lit_width() -> u32 { return FL_LIT_W; }
pub fn fl_has_site() -> bool { return FL_HAS_SITE; }
pub fn fl_site_lo() -> usize { return FL_SITE_LO; }
pub fn fl_site_hi() -> usize { return FL_SITE_HI; }
pub fn fl_feat_lo() -> usize { return FL_FEAT_LO; }
pub fn fl_feat_hi() -> usize { return FL_FEAT_HI; }
pub fn fl_lut() -> u8 { return FL_LUT; }
pub fn fl_nparts() -> usize { return FL_NPARTS; }

pub fn fl_part_lo(i: usize) -> usize {
    if (i >= 1024) { return 0; }
    return FL_PART_LO[i];
}

pub fn fl_part_hi(i: usize) -> usize {
    if (i >= 1024) { return 0; }
    return FL_PART_HI[i];
}

/// The decimal digits s[a .. b) as a number (exact up to 2^53).
pub fn dec_f64(s: []const u8, a: usize, b: usize) -> f64 {
    var v : f64 = 0.0;
    var i : usize = a;
    while (i < b) {
        v = v * 10.0 + (((s[i] - 48) as u32) as f64);
        i = i + 1;
    }
    return v;
}

/// /_X\d+Y\d+$/ at the end of s[lo .. hi): the offset where the suffix starts, or hi.
pub fn type_end(s: []const u8, lo: usize, hi: usize) -> usize {
    var p : usize = lo;
    while (p < hi) {
        if (s[p] == 95 and p + 1 < hi and s[p + 1] == 88) {
            var q : usize = p + 2;
            const d0 : usize = q;
            while (q < hi and is_digit(s[q])) { q = q + 1; }
            if (q > d0 and q < hi and s[q] == 89) {
                q = q + 1;
                const d1 : usize = q;
                while (q < hi and is_digit(s[q])) { q = q + 1; }
                if (q > d1 and q == hi) { return p; }
            }
        }
        p = p + 1;
    }
    return hi;
}

/// /^SLICE[LM]_X[01]$/ on s[lo .. hi).
pub fn is_slice_site(s: []const u8, lo: usize, hi: usize) -> bool {
    if (hi - lo != 9) { return false; }
    if (!(s[lo] == 83 and s[lo + 1] == 76 and s[lo + 2] == 73 and s[lo + 3] == 67 and s[lo + 4] == 69)) { return false; }
    if (s[lo + 5] != 76 and s[lo + 5] != 77) { return false; }
    if (s[lo + 6] != 95 or s[lo + 7] != 88) { return false; }
    return s[lo + 8] == 48 or s[lo + 8] == 49;
}

pub fn fl_clear() {
    FL_KIND = 0;
    FL_HAS_HI = false;
    FL_HI = 0.0;
    FL_HAS_LO = false;
    FL_LO = 0.0;
    FL_HAS_VTEXT = false;
    FL_VTEXT_LO = 0;
    FL_VTEXT_HI = 0;
    FL_HAS_LIT = false;
    FL_LIT = 0;
    FL_LIT_W = 0;
    FL_HAS_SITE = false;
    FL_SITE_LO = 0;
    FL_SITE_HI = 0;
    FL_FEAT_LO = 0;
    FL_FEAT_HI = 0;
    FL_LUT = 0;
    FL_NPARTS = 0;
}

/// parseFasmLine(line): false when the JavaScript returns null.
pub fn parse_fasm_line(s: []const u8) -> bool {
    fl_clear();
    const n : usize = s.len;
    // line terminators: the comment regex #.*$ needs none after its '#'
    var lt_end : usize = 0;
    var i : usize = 0;
    while (i < n) {
        const b : u8 = s[i];
        if (b == 10 or b == 13) { lt_end = i + 1; }
        if (b == 226 and i + 2 < n and s[i + 1] == 128 and (s[i + 2] == 168 or s[i + 2] == 169)) { lt_end = i + 3; }
        i = i + 1;
    }
    var cut : usize = n;
    var c : usize = lt_end;
    while (c < n) {
        if (s[c] == 35) {
            cut = c;
            break;
        }
        c = c + 1;
    }
    const tp : u64 = trim_pack(s, 0, cut);
    const lo : usize = pk_lo(tp);
    const hi : usize = pk_hi(tp);
    if (hi == lo) { return false; }
    FL_TEXT_LO = lo;
    FL_TEXT_HI = hi;
    var p : usize = lo;
    while (p < hi and is_class(s[p])) { p = p + 1; }
    if (p == lo or p >= hi or s[p] != 46) { return false; }
    FL_TILE_LO = lo;
    FL_TILE_HI = p;
    FL_TYPE_HI = type_end(s, lo, p);
    const ps : usize = p + 1;
    var q : usize = ps;
    while (q < hi and (is_class(s[q]) or s[q] == 46)) { q = q + 1; }
    if (q == ps) { return false; }
    FL_PATH_LO = ps;
    FL_PATH_HI = q;
    var r : usize = q;
    var has_hi : bool = false;
    var has_lo_s : bool = false;
    var hi_a : usize = 0;
    var hi_b : usize = 0;
    var lo_a : usize = 0;
    var lo_b : usize = 0;
    if (r < hi and s[r] == 91) {
        r = r + 1;
        hi_a = r;
        while (r < hi and is_digit(s[r])) { r = r + 1; }
        if (r == hi_a) { return false; }
        hi_b = r;
        has_hi = true;
        if (r < hi and s[r] == 58) {
            r = r + 1;
            lo_a = r;
            while (r < hi and is_digit(s[r])) { r = r + 1; }
            if (r == lo_a) { return false; }
            lo_b = r;
            has_lo_s = true;
        }
        if (r >= hi or s[r] != 93) { return false; }
        r = r + 1;
    }
    var has_v : bool = false;
    var v0 : usize = 0;
    var v1 : usize = 0;
    var w : usize = r;
    while (w < hi) {
        const k : usize = ws_at(s, w, hi);
        if (k == 0) { break; }
        w = w + k;
    }
    if (w < hi and s[w] == 61) {
        w = w + 1;
        while (w < hi) {
            const k2 : usize = ws_at(s, w, hi);
            if (k2 == 0) { break; }
            w = w + k2;
        }
        v0 = w;
        while (w < hi) {
            const k3 : usize = ws_at(s, w, hi);
            if (k3 > 0) { break; }
            w = w + 1;
        }
        if (w == hi and w > v0) {
            has_v = true;
            v1 = w;
        }
    }
    if (!has_v and r != hi) { return false; }
    if (has_hi) {
        FL_HAS_HI = true;
        FL_HI = dec_f64(s, hi_a, hi_b);
        FL_HAS_LO = true;
        if (has_lo_s) { FL_LO = dec_f64(s, lo_a, lo_b); } else { FL_LO = FL_HI; }
        if (FL_LO > FL_HI) { return false; }
    }
    if (has_v) {
        FL_HAS_VTEXT = true;
        FL_VTEXT_LO = v0;
        FL_VTEXT_HI = v1;
    }
    // parts of the path
    var pi : usize = ps;
    var pstart : usize = ps;
    FL_NPARTS = 0;
    while (pi <= q) {
        if (pi == q or s[pi] == 46) {
            if (FL_NPARTS < 1024) {
                FL_PART_LO[FL_NPARTS] = pstart;
                FL_PART_HI[FL_NPARTS] = pi;
            }
            FL_NPARTS = FL_NPARTS + 1;
            pstart = pi + 1;
        }
        pi = pi + 1;
    }
    if (has_v) {
        if (!parse_literal(s[v0 .. v1])) {
            FL_KIND = W_FK_BAD_VALUE;
            return true;
        }
        FL_HAS_LIT = true;
        FL_LIT = LIT_VAL;
        FL_LIT_W = LIT_W;
    }
    FL_KIND = W_FK_OTHER;
    if (is_slice_site(s, FL_PART_LO[0], FL_PART_HI[0]) and FL_NPARTS >= 2) {
        FL_HAS_SITE = true;
        FL_SITE_LO = FL_PART_LO[0];
        FL_SITE_HI = FL_PART_HI[0];
        FL_FEAT_LO = FL_PART_HI[0] + 1;
        FL_FEAT_HI = q;
        FL_KIND = W_FK_SITE;
        // /^([ABCD])LUT\.INIT$/ on the feature
        if (q - FL_FEAT_LO == 9) {
            const f0 : u8 = s[FL_FEAT_LO];
            if (f0 >= 65 and f0 <= 68 and lit_is(s, FL_FEAT_LO + 1, "LUT.INIT")) {
                FL_LUT = f0;
                FL_KIND = W_FK_LUT_INIT;
            }
        }
        return true;
    }
    if (FL_NPARTS == 2) { FL_KIND = W_FK_PIP; }
    return true;
}

pub fn lit_is(s: []const u8, p: usize, w: []const u8) -> bool {
    if (p + w.len > s.len) { return false; }
    var k : usize = 0;
    while (k < w.len) {
        if (s[p + k] != w[k]) { return false; }
        k = k + 1;
    }
    return true;
}

// --- parseInput --------------------------------------------------------------------------------
pub fn pi_has_bits() -> bool { return PI_HAS_BITS; }

pub fn pi_bits() -> u64 {
    if (PI_INIT_KIND == 2) { return PI_LBITS; }
    return PI_LIT_INIT;
}

pub fn pi_has_lut() -> bool { return PI_LUT_SET; }
pub fn pi_tile_lo() -> usize { return PI_TILE_LO; }
pub fn pi_tile_hi() -> usize { return PI_TILE_HI; }
pub fn pi_type_hi() -> usize { return PI_TYPE_HI; }
pub fn pi_site_lo() -> usize { return PI_SITE_LO; }
pub fn pi_site_hi() -> usize { return PI_SITE_HI; }
pub fn pi_lut_letter() -> u8 { return PI_LUT; }
pub fn pi_n() -> usize { return PI_N; }
pub fn pi_line_lo(k: usize) -> usize { return PI_LO[k]; }
pub fn pi_line_hi(k: usize) -> usize { return PI_HI[k]; }
pub fn pi_kind(k: usize) -> u32 { return PI_KIND[k]; }
pub fn pi_bad_n() -> usize { return PI_BAD_N; }
pub fn pi_bad_lo(k: usize) -> usize { return PI_BAD_LO[k]; }
pub fn pi_bad_hi(k: usize) -> usize { return PI_BAD_HI[k]; }

pub fn pi_push(lo: usize, hi: usize, kind: u32) -> bool {
    if (PI_N >= 16384) { return false; }
    PI_LO[PI_N] = lo;
    PI_HI[PI_N] = hi;
    PI_KIND[PI_N] = kind;
    PI_N = PI_N + 1;
    return true;
}

pub fn pi_bad(lo: usize, hi: usize) -> bool {
    if (PI_BAD_N >= 16384) { return false; }
    PI_BAD_LO[PI_BAD_N] = lo;
    PI_BAD_HI[PI_BAD_N] = hi;
    PI_BAD_N = PI_BAD_N + 1;
    return true;
}

pub fn same_range(s: []const u8, a: usize, b: usize, len: usize) -> bool {
    var k : usize = 0;
    while (k < len) {
        if (s[a + k] != s[b + k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// The first match of /(\d+'[hHbBdD][0-9a-fA-F_]+|0[xX][0-9a-fA-F_]+)/ in s[lo .. hi): packed, or hi * 2^32 + hi when none (empty).
pub fn find_inside(s: []const u8, lo: usize, hi: usize) -> u64 {
    var i : usize = lo;
    while (i < hi) {
        var p : usize = i;
        while (p < hi and is_digit(s[p])) { p = p + 1; }
        if (p > i and p + 2 < hi and s[p] == 39) {
            const bl : u8 = s[p + 1];
            if (bl == 104 or bl == 72 or bl == 98 or bl == 66 or bl == 100 or bl == 68) {
                var q : usize = p + 2;
                while (q < hi and (is_hex(s[q]) or s[q] == 95)) { q = q + 1; }
                if (q > p + 2) { return (i as u64) * 4294967296 + (q as u64); }
            }
        }
        if (s[i] == 48 and i + 1 < hi and (s[i + 1] == 120 or s[i + 1] == 88)) {
            var q2 : usize = i + 2;
            while (q2 < hi and (is_hex(s[q2]) or s[q2] == 95)) { q2 = q2 + 1; }
            if (q2 > i + 2) { return (i as u64) * 4294967296 + (q2 as u64); }
        }
        i = i + 1;
    }
    return (hi as u64) * 4294967296 + (hi as u64);
}

/// One trimmed non-empty line s[lo .. hi) of parseInput. False on a capacity hit.
pub fn pi_line(s: []const u8, lo: usize, hi: usize) -> bool {
    const line : []const u8 = s[lo .. hi];
    const fok : bool = parse_fasm_line(line);
    if (fok and FL_KIND == W_FK_LUT_INIT) {
        var same : bool = true;
        if (PI_LUT_SET) {
            same = (PI_TILE_HI - PI_TILE_LO) == (FL_TILE_HI - FL_TILE_LO) and (PI_SITE_HI - PI_SITE_LO) == (FL_SITE_HI - FL_SITE_LO) and PI_LUT == FL_LUT;
            if (same) {
                same = same_range(s, PI_TILE_LO, lo + FL_TILE_LO, PI_TILE_HI - PI_TILE_LO) and same_range(s, PI_SITE_LO, lo + FL_SITE_LO, PI_SITE_HI - PI_SITE_LO);
            }
        }
        if (same) {
            if (!PI_LUT_SET) {
                PI_LUT_SET = true;
                PI_TILE_LO = lo + FL_TILE_LO;
                PI_TILE_HI = lo + FL_TILE_HI;
                PI_TYPE_HI = lo + FL_TYPE_HI;
                PI_SITE_LO = lo + FL_SITE_LO;
                PI_SITE_HI = lo + FL_SITE_HI;
                PI_LUT = FL_LUT;
                PI_LBITS = 0;
            }
            var lo_n : f64 = 0.0;
            if (FL_HAS_LO) { lo_n = FL_LO; }
            var hi_n : f64 = lo_n;
            if (FL_HAS_HI) {
                hi_n = FL_HI;
            } else {
                if (FL_HAS_LIT) { hi_n = lo_n + (FL_LIT_W as f64) - 1.0; }
            }
            if (hi_n >= 64.0) {
                if (!pi_bad(lo, hi)) { return false; }
                return pi_push(lo, hi, W_FK_BAD_RANGE);
            }
            var v : u64 = 1;
            if (FL_HAS_LIT) { v = FL_LIT; }
            const a : u32 = lo_n as u32;
            const z : u32 = hi_n as u32;
            var bi : u32 = a;
            while (bi <= z) {
                const m : u64 = (1 as u64) << bi;
                if (((v >> (bi - a)) & 1) == 1) {
                    PI_LBITS = PI_LBITS | m;
                } else {
                    PI_LBITS = PI_LBITS & ~m;
                }
                bi = bi + 1;
            }
            PI_INIT_KIND = 2;
            PI_HAS_BITS = true;
        }
        return pi_push(lo, hi, FL_KIND);
    }
    if (fok and FL_KIND != W_FK_BAD_VALUE) { return pi_push(lo, hi, FL_KIND); }
    const was_bad : bool = fok;
    var lit_ok : bool = parse_literal(line);
    var lit_v : u64 = LIT_VAL;
    if (!lit_ok) {
        const ins : u64 = find_inside(s, lo, hi);
        if (pk_hi(ins) > pk_lo(ins)) {
            lit_ok = parse_literal(s[pk_lo(ins) .. pk_hi(ins)]);
            lit_v = LIT_VAL;
        }
    }
    if (lit_ok and !PI_HAS_BITS) {
        PI_LIT_INIT = lit_v;
        PI_INIT_KIND = 1;
        PI_HAS_BITS = true;
        return true;
    }
    if (!lit_ok) {
        if (!pi_bad(lo, hi)) { return false; }
    }
    if (was_bad) { return pi_push(lo, hi, W_FK_BAD_VALUE); }
    return true;
}

/// parseInput(text): lines split at \r?\n, trimmed, empty ones dropped. False: a capacity was hit.
pub fn parse_input(s: []const u8) -> bool {
    PI_HAS_BITS = false;
    PI_INIT_KIND = 0;
    PI_LIT_INIT = 0;
    PI_LBITS = 0;
    PI_LUT_SET = false;
    PI_N = 0;
    PI_BAD_N = 0;
    var start : usize = 0;
    var i : usize = 0;
    while (i <= s.len) {
        if (i == s.len or s[i] == 10) {
            var e : usize = i;
            if (i < s.len and e > start and s[e - 1] == 13) { e = e - 1; }
            const t : u64 = trim_pack(s, start, e);
            if (pk_hi(t) > pk_lo(t)) {
                if (!pi_line(s, pk_lo(t), pk_hi(t))) { return false; }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return true;
}

// --- support and the bit-level helpers ---------------------------------------------------------
/// The inputs the output depends on, as a mask (bit k = input k).
pub fn support_mask(b: u64) -> u32 {
    var m : u32 = 0;
    var k : u32 = 0;
    while (k < 6) {
        var x : u32 = 0;
        while (x < 64) {
            if (bit_of(b, x) != bit_of(b, x ^ (1 << k))) {
                m = m | (1 << k);
                break;
            }
            x = x + 1;
        }
        k = k + 1;
    }
    return m;
}

pub fn halves_o5(b: u64) -> u64 {
    const lo : u64 = b & 4294967295;
    return lo | (lo << 32);
}

pub fn halves_o6(b: u64) -> u64 {
    const hi : u64 = b >> 32;
    return hi | (hi << 32);
}

pub fn halves_same(b: u64) -> bool {
    return halves_o5(b) == halves_o6(b);
}

pub fn row_level(i: u32, q: u32) -> u32 {
    return (i >> (5 - q)) & 1;
}

// --- Quine-McCluskey -----------------------------------------------------------------------------
pub fn min_value(i: usize) -> u32 { return MN_V[i]; }
pub fn min_dc(i: usize) -> u32 { return MN_D[i]; }
pub fn min_exact() -> bool { return MN_EXACT; }
pub fn min_primes() -> usize { return MN_PRIMES; }

pub fn term_set(i: usize, value: u32, dc: u32) {
    MN_V[i] = value;
    MN_D[i] = dc;
}

/// coverBits(terms) over the terms term_set / minimize left in MN_V, MN_D: the u64 of the points covered.
pub fn cover_bits(n: usize) -> u64 {
    var b : u64 = 0;
    var x : u32 = 0;
    while (x < 64) {
        var hit : bool = false;
        var t : usize = 0;
        while (t < n) {
            if ((x & ~MN_D[t]) == MN_V[t]) { hit = true; }
            t = t + 1;
        }
        if (hit) { b = b | ((1 as u64) << x); }
        x = x + 1;
    }
    return b;
}

/// termLiterals(t): the literals of one implicant in input order; the count.
pub fn term_literals(value: u32, dc: u32) -> usize {
    TL_N = 0;
    var k : u32 = 0;
    while (k < 6) {
        if (((dc >> k) & 1) == 0) {
            TL_INPUT[TL_N] = k;
            if (((value >> k) & 1) == 0) { TL_INV[TL_N] = 1; } else { TL_INV[TL_N] = 0; }
            TL_N = TL_N + 1;
        }
        k = k + 1;
    }
    return TL_N;
}

pub fn tl_input(i: usize) -> u32 { return TL_INPUT[i]; }
pub fn tl_inverted(i: usize) -> u32 { return TL_INV[i]; }

/// The solver's covers with the point m: opts pushed on OPT_STACK, the count.
pub fn cov_count(left: u64, i: usize) -> u32 {
    return pop64(MN_COV[i] & left);
}

/// opts[a] goes before opts[b] when this is negative: more of `left` first, then fewer literals.
pub fn opt_cmp(left: u64, i: u32, j: u32) -> i32 {
    const ci : i32 = cov_count(left, i as usize) as i32;
    const cj : i32 = cov_count(left, j as usize) as i32;
    if (cj - ci != 0) { return cj - ci; }
    return (MN_LIT[(i as usize)] as i32) - (MN_LIT[(j as usize)] as i32);
}

pub fn solve(left: u64, lit_sum: u32) {
    SV_NODES = SV_NODES + 1;
    if (SV_NODES > SV_BUDGET) {
        SV_EXACT = false;
        return;
    }
    if (left == 0) {
        if (!SV_HAS_BEST or SV_CHOSEN_N < SV_BEST_N or (SV_CHOSEN_N == SV_BEST_N and lit_sum < SV_BEST_LITS)) {
            var k : usize = 0;
            while (k < SV_CHOSEN_N) {
                SV_BEST[k] = SV_CHOSEN[k];
                k = k + 1;
            }
            SV_BEST_N = SV_CHOSEN_N;
            SV_HAS_BEST = true;
            SV_BEST_LITS = lit_sum;
        }
        return;
    }
    if (SV_HAS_BEST and SV_CHOSEN_N + 1 > SV_BEST_N) { return; }
    // the uncovered point with the fewest primes able to cover it decides the branch
    var pick : i32 = -1;
    var best_cnt : usize = 0;
    var m : u32 = 0;
    while (m < 64) {
        if (((left >> m) & 1) == 1) {
            var cnt : usize = 0;
            var i : usize = 0;
            while (i < MN_PN) {
                if (((MN_COV[i] >> m) & 1) == 1) { cnt = cnt + 1; }
                i = i + 1;
            }
            if (pick < 0 or cnt < best_cnt) {
                pick = m as i32;
                best_cnt = cnt;
                if (cnt == 1) { break; }
            }
        }
        m = m + 1;
    }
    if (pick < 0) { return; }
    const base : usize = OPT_TOP;
    if (base + best_cnt > 65536 or SV_CHOSEN_N >= 63) {
        SV_EXACT = false;
        return;
    }
    var nopt : usize = 0;
    var ii : usize = 0;
    while (ii < MN_PN) {
        if (((MN_COV[ii] >> (pick as u32)) & 1) == 1) {
            // stable insertion into opts by opt_cmp
            const x : u32 = ii as u32;
            var j : usize = base + nopt;
            while (j > base) {
                if (opt_cmp(left, OPT_STACK[j - 1], x) > 0) {
                    OPT_STACK[j] = OPT_STACK[j - 1];
                    j = j - 1;
                } else {
                    break;
                }
            }
            OPT_STACK[j] = x;
            nopt = nopt + 1;
        }
        ii = ii + 1;
    }
    OPT_TOP = base + nopt;
    var q : usize = 0;
    while (q < nopt) {
        const pi : u32 = OPT_STACK[base + q];
        SV_CHOSEN[SV_CHOSEN_N] = pi;
        SV_CHOSEN_N = SV_CHOSEN_N + 1;
        solve(left & ~MN_COV[(pi as usize)], lit_sum + MN_LIT[(pi as usize)]);
        SV_CHOSEN_N = SV_CHOSEN_N - 1;
        if (!SV_EXACT) {
            OPT_TOP = base;
            return;
        }
        q = q + 1;
    }
    OPT_TOP = base;
}

/// minimize(bits, budget): the term count; the terms are in MN_V / MN_D (min_value / min_dc).
pub fn minimize(b: u64, budget: u32) -> usize {
    MN_EXACT = true;
    MN_PRIMES = 0;
    MN_N = 0;
    const ones : u32 = pop64(b);
    if (ones == 0) { return 0; }
    if (ones == 64) {
        MN_V[0] = 0;
        MN_D[0] = 63;
        MN_N = 1;
        MN_PRIMES = 1;
        return 1;
    }
    var ln : usize = 0;
    var mm : u32 = 0;
    while (mm < 64) {
        if (((b >> mm) & 1) == 1) {
            LV_V[ln] = mm;
            LV_D[ln] = 0;
            ln = ln + 1;
        }
        mm = mm + 1;
    }
    MN_PN = 0;
    while (ln > 0) {
        var i : usize = 0;
        while (i < ln) {
            LV_USED[i] = 0;
            i = i + 1;
        }
        var nn : usize = 0;
        var a : usize = 0;
        while (a < ln) {
            var bb : usize = a + 1;
            while (bb < ln) {
                if (LV_D[a] == LV_D[bb]) {
                    const d : u32 = LV_V[a] ^ LV_V[bb];
                    if ((d & (d - 1)) == 0) {
                        LV_USED[a] = 1;
                        LV_USED[bb] = 1;
                        const tv : u32 = LV_V[a] & ~d;
                        const td : u32 = LV_D[a] | d;
                        var found : bool = false;
                        var f : usize = 0;
                        while (f < nn) {
                            if (NX_V[f] == tv and NX_D[f] == td) {
                                found = true;
                                break;
                            }
                            f = f + 1;
                        }
                        if (!found) {
                            NX_V[nn] = tv;
                            NX_D[nn] = td;
                            nn = nn + 1;
                        }
                    }
                }
                bb = bb + 1;
            }
            a = a + 1;
        }
        i = 0;
        while (i < ln) {
            if (LV_USED[i] == 0) {
                MN_PV[MN_PN] = LV_V[i];
                MN_PD[MN_PN] = LV_D[i];
                MN_PN = MN_PN + 1;
            }
            i = i + 1;
        }
        i = 0;
        while (i < nn) {
            LV_V[i] = NX_V[i];
            LV_D[i] = NX_D[i];
            i = i + 1;
        }
        ln = nn;
    }
    MN_PRIMES = MN_PN;
    // covers
    var p : usize = 0;
    while (p < MN_PN) {
        var cv : u64 = 0;
        var m2 : u32 = 0;
        while (m2 < 64) {
            if (((b >> m2) & 1) == 1) {
                if ((m2 & ~MN_PD[p]) == MN_PV[p]) { cv = cv | ((1 as u64) << m2); }
            }
            m2 = m2 + 1;
        }
        MN_COV[p] = cv;
        MN_LIT[p] = 6 - pop64(MN_PD[p] as u64);
        p = p + 1;
    }
    SV_HAS_BEST = false;
    SV_BEST_N = 0;
    SV_BEST_LITS = 0;
    SV_NODES = 0;
    SV_BUDGET = budget;
    SV_EXACT = true;
    SV_CHOSEN_N = 0;
    OPT_TOP = 0;
    solve(b, 0);
    MN_EXACT = SV_EXACT;
    if (!SV_HAS_BEST) {
        // budget gone before any cover: the greedy cover
        SV_BEST_N = 0;
        var left : u64 = b;
        while (left != 0) {
            var bi : usize = 0;
            var q : usize = 1;
            while (q < MN_PN) {
                if (cov_count(left, q) > cov_count(left, bi)) { bi = q; }
                q = q + 1;
            }
            SV_BEST[SV_BEST_N] = bi as u32;
            SV_BEST_N = SV_BEST_N + 1;
            left = left & ~MN_COV[bi];
        }
    }
    // terms: best.map(primes).sort(fewer literals, then smaller value), stable
    var t : usize = 0;
    while (t < SV_BEST_N) {
        const pv : u32 = MN_PV[(SV_BEST[t] as usize)];
        const pd : u32 = MN_PD[(SV_BEST[t] as usize)];
        var j : usize = t;
        while (j > 0) {
            const qv : u32 = MN_V[j - 1];
            const qd : u32 = MN_D[j - 1];
            const lq : u32 = 6 - pop64(qd as u64);
            const lp : u32 = 6 - pop64(pd as u64);
            var after : bool = false;
            if (lq > lp) { after = true; }
            if (lq == lp and qv > pv) { after = true; }
            if (after) {
                MN_V[j] = qv;
                MN_D[j] = qd;
                j = j - 1;
            } else {
                break;
            }
        }
        MN_V[j] = pv;
        MN_D[j] = pd;
        t = t + 1;
    }
    MN_N = SV_BEST_N;
    return MN_N;
}

// --- classify ----------------------------------------------------------------------------------
pub fn cls_id() -> u32 { return CL_ID[0]; }
pub fn cls_n() -> u32 { return CL_N[0]; }
pub fn cls_k() -> u32 { return CL_K[0]; }
pub fn cls_inputs_mask() -> u32 { return CL_INPUTS[0]; }
pub fn cls_sel_n() -> u32 { return CL_SEL_N[0]; }
pub fn cls_sel(i: usize) -> u32 { return CL_SEL[i]; }
pub fn cls_data_n() -> u32 { return CL_DATA_N[0]; }
pub fn cls_data(i: usize) -> u32 { return CL_DATA[i]; }
pub fn cls_has_inner() -> bool { return CL_INNER; }
pub fn cls_inner_id() -> u32 { return CL_ID[1]; }
pub fn cls_inner_n() -> u32 { return CL_N[1]; }
pub fn cls_inner_k() -> u32 { return CL_K[1]; }
pub fn cls_inner_inputs_mask() -> u32 { return CL_INPUTS[1]; }
pub fn cls_inner_sel_n() -> u32 { return CL_SEL_N[1]; }
pub fn cls_inner_sel(i: usize) -> u32 { return CL_SEL[2 + i]; }
pub fn cls_inner_data_n() -> u32 { return CL_DATA_N[1]; }
pub fn cls_inner_data(i: usize) -> u32 { return CL_DATA[6 + i]; }

/// The k-th input (ascending) of a support mask.
pub fn input_at(mask: u32, k: u32) -> u32 {
    var seen : u32 = 0;
    var q : u32 = 0;
    while (q < 6) {
        if (((mask >> q) & 1) == 1) {
            if (seen == k) { return q; }
            seen = seen + 1;
        }
        q = q + 1;
    }
    return 0;
}

pub fn cl_start(slot: usize, id: u32, n: u32, k: u32, mask: u32) {
    CL_ID[slot] = id;
    CL_N[slot] = n;
    CL_K[slot] = k;
    CL_INPUTS[slot] = mask;
    CL_SEL_N[slot] = 0;
    CL_DATA_N[slot] = 0;
}

pub fn cl_sel(slot: usize, v: u32) {
    CL_SEL[slot * 2 + (CL_SEL_N[slot] as usize)] = v;
    CL_SEL_N[slot] = CL_SEL_N[slot] + 1;
}

pub fn cl_data(slot: usize, v: u32) {
    CL_DATA[slot * 6 + (CL_DATA_N[slot] as usize)] = v;
    CL_DATA_N[slot] = CL_DATA_N[slot] + 1;
}

/// score(c) of the xorwith search: other 99, an 'x' family 10, plus k.
pub fn cl_score(slot: usize) -> u32 {
    const id : u32 = CL_ID[slot];
    if (id == W_C_OTHER) { return 99; }
    var s : u32 = 0;
    if (id == W_C_ANDX or id == W_C_ORX or id == W_C_MAJX or id == W_C_CARRY2X) { s = 10; }
    return s + CL_K[slot];
}

pub fn cl_copy(from: usize, to: usize) {
    CL_ID[to] = CL_ID[from];
    CL_N[to] = CL_N[from];
    CL_K[to] = CL_K[from];
    CL_INPUTS[to] = CL_INPUTS[from];
    CL_SEL_N[to] = CL_SEL_N[from];
    CL_DATA_N[to] = CL_DATA_N[from];
    var i : usize = 0;
    while (i < 2) {
        CL_SEL[to * 2 + i] = CL_SEL[from * 2 + i];
        i = i + 1;
    }
    i = 0;
    while (i < 6) {
        CL_DATA[to * 6 + i] = CL_DATA[from * 6 + i];
        i = i + 1;
    }
}

/// g[j] (the function on its own n inputs): bit j of the result.
pub fn compress(b: u64, mask: u32, n: u32) -> u64 {
    var g : u64 = 0;
    const size : u32 = 1 << n;
    var j : u32 = 0;
    while (j < size) {
        var x : u32 = 0;
        var q : u32 = 0;
        while (q < n) {
            if (((j >> q) & 1) == 1) { x = x | (1 << input_at(mask, q)); }
            q = q + 1;
        }
        if (bit_of(b, x) == 1) { g = g | ((1 as u64) << j); }
        j = j + 1;
    }
    return g;
}

pub fn lowest_bit(g: u64, want: u32) -> u32 {
    var i : u32 = 0;
    while (i < 64) {
        if (bit_of(g, i) == want) { return i; }
        i = i + 1;
    }
    return 64;
}

/// classify(bits) into slot (0 = the answer, 1 and 2 = candidates for the inner function).
pub fn classify_into(b: u64, slot: usize) {
    const mask : u32 = support_mask(b);
    const n : u32 = pop64(mask as u64);
    if (n == 0) {
        if (bit_of(b, 0) == 1) { cl_start(slot, W_C_ONE, 0, 0, mask); } else { cl_start(slot, W_C_ZERO, 0, 0, mask); }
        return;
    }
    const size : u32 = 1 << n;
    const g : u64 = compress(b, mask, n);
    const ones : u32 = pop64(g);
    if (n == 1) {
        if (bit_of(g, 1) == 1) { cl_start(slot, W_C_BUF, n, 0, mask); } else { cl_start(slot, W_C_NOT, n, 0, mask); }
        return;
    }
    // xor, xnor
    var is_xor : bool = true;
    var is_xnor : bool = true;
    var j : u32 = 0;
    while (j < size) {
        const par : u32 = pop64(j as u64) & 1;
        if (bit_of(g, j) != par) { is_xor = false; }
        if (bit_of(g, j) != 1 - par) { is_xnor = false; }
        j = j + 1;
    }
    if (is_xor) {
        cl_start(slot, W_C_XOR, n, 0, mask);
        return;
    }
    if (is_xnor) {
        cl_start(slot, W_C_XNOR, n, 0, mask);
        return;
    }
    if (ones == 1) {
        const m1 : u32 = lowest_bit(g, 1);
        const k1 : u32 = n - pop64(m1 as u64);
        var id1 : u32 = W_C_ANDX;
        if (k1 == 0) { id1 = W_C_AND; }
        if (k1 == n) { id1 = W_C_NOR; }
        cl_start(slot, id1, n, k1, mask);
        return;
    }
    if (ones == size - 1) {
        const m0 : u32 = lowest_bit(g, 0);
        const k0 : u32 = pop64(m0 as u64);
        var id0 : u32 = W_C_ORX;
        if (k0 == 0) { id0 = W_C_OR; }
        if (k0 == n) { id0 = W_C_NAND; }
        cl_start(slot, id0, n, k0, mask);
        return;
    }
    if (n == 3) {
        var msk : u32 = 0;
        while (msk < 8) {
            var ok : bool = true;
            var jj : u32 = 0;
            while (jj < 8) {
                var want : u32 = 0;
                if (pop64((jj ^ msk) as u64) >= 2) { want = 1; }
                if (bit_of(g, jj) != want) { ok = false; }
                jj = jj + 1;
            }
            if (ok) {
                if (msk != 0) { cl_start(slot, W_C_MAJX, n, pop64(msk as u64), mask); } else { cl_start(slot, W_C_MAJ, n, 0, mask); }
                return;
            }
            msk = msk + 1;
        }
        var s : u32 = 0;
        while (s < 3) {
            var a3 : u32 = 0;
            var b3 : u32 = 0;
            var seen : u32 = 0;
            var qq : u32 = 0;
            while (qq < 3) {
                if (qq != s) {
                    if (seen == 0) { a3 = qq; } else { b3 = qq; }
                    seen = seen + 1;
                }
                qq = qq + 1;
            }
            var pair : u32 = 0;
            while (pair < 2) {
                var hi3 : u32 = a3;
                var lo3 : u32 = b3;
                if (pair == 1) {
                    hi3 = b3;
                    lo3 = a3;
                }
                var okm : bool = true;
                var jm : u32 = 0;
                while (jm < 8) {
                    var wm : u32 = (jm >> lo3) & 1;
                    if (((jm >> s) & 1) == 1) { wm = (jm >> hi3) & 1; }
                    if (bit_of(g, jm) != wm) { okm = false; }
                    jm = jm + 1;
                }
                if (okm) {
                    cl_start(slot, W_C_MUX2, n, 0, mask);
                    cl_sel(slot, input_at(mask, s));
                    cl_data(slot, input_at(mask, lo3));
                    cl_data(slot, input_at(mask, hi3));
                    return;
                }
                pair = pair + 1;
            }
            s = s + 1;
        }
    }
    if (n == 5) {
        var a : u32 = 0;
        while (a < 5) {
            var bq : u32 = a + 1;
            while (bq < 5) {
                var rest : [3]u32 = [0; 3];
                var rn : usize = 0;
                var qr : u32 = 0;
                while (qr < 5) {
                    if (qr != a and qr != bq) {
                        rest[rn] = qr;
                        rn = rn + 1;
                    }
                    qr = qr + 1;
                }
                var cm : u32 = 0;
                while (cm < 32) {
                    var okc : bool = true;
                    var jc : u32 = 0;
                    while (jc < 32) {
                        const y : u32 = jc ^ cm;
                        const low : u32 = ((y >> rest[0]) & 1) + ((y >> rest[1]) & 1) + ((y >> rest[2]) & 1);
                        var lowb : u32 = 0;
                        if (low >= 2) { lowb = 1; }
                        var wc : u32 = 0;
                        if (((y >> a) & 1) + ((y >> bq) & 1) + lowb >= 2) { wc = 1; }
                        if (bit_of(g, jc) != wc) { okc = false; }
                        jc = jc + 1;
                    }
                    if (okc) {
                        const kc : u32 = pop64(cm as u64);
                        if (kc != 0) { cl_start(slot, W_C_CARRY2X, n, kc, mask); } else { cl_start(slot, W_C_CARRY2, n, 0, mask); }
                        cl_data(slot, input_at(mask, a));
                        cl_data(slot, input_at(mask, bq));
                        cl_data(slot, input_at(mask, rest[0]));
                        cl_data(slot, input_at(mask, rest[1]));
                        cl_data(slot, input_at(mask, rest[2]));
                        return;
                    }
                    cm = cm + 1;
                }
                bq = bq + 1;
            }
            a = a + 1;
        }
    }
    if (n == 6) {
        var s1 : u32 = 0;
        while (s1 < 6) {
            var s2 : u32 = s1 + 1;
            while (s2 < 6) {
                var r4 : [4]u32 = [0; 4];
                var r4n : usize = 0;
                var q6 : u32 = 0;
                while (q6 < 6) {
                    if (q6 != s1 and q6 != s2) {
                        r4[r4n] = q6;
                        r4n = r4n + 1;
                    }
                    q6 = q6 + 1;
                }
                var p0 : usize = 0;
                while (p0 < 4) {
                    var p1 : usize = 0;
                    while (p1 < 4) {
                        if (p1 != p0) {
                            var p2 : usize = 0;
                            while (p2 < 4) {
                                if (p2 != p0 and p2 != p1) {
                                    const p3 : usize = 6 - p0 - p1 - p2;
                                    var pm : [4]u32 = [0; 4];
                                    pm[0] = r4[p0];
                                    pm[1] = r4[p1];
                                    pm[2] = r4[p2];
                                    pm[3] = r4[p3];
                                    var ok4 : bool = true;
                                    var j4 : u32 = 0;
                                    while (j4 < 64) {
                                        const sel : usize = (((j4 >> s1) & 1) | (((j4 >> s2) & 1) << 1)) as usize;
                                        if (bit_of(g, j4) != ((j4 >> pm[sel]) & 1)) { ok4 = false; }
                                        j4 = j4 + 1;
                                    }
                                    if (ok4) {
                                        cl_start(slot, W_C_MUX4, n, 0, mask);
                                        cl_sel(slot, input_at(mask, s1));
                                        cl_sel(slot, input_at(mask, s2));
                                        cl_data(slot, input_at(mask, pm[0]));
                                        cl_data(slot, input_at(mask, pm[1]));
                                        cl_data(slot, input_at(mask, pm[2]));
                                        cl_data(slot, input_at(mask, pm[3]));
                                        return;
                                    }
                                }
                                p2 = p2 + 1;
                            }
                        }
                        p1 = p1 + 1;
                    }
                    p0 = p0 + 1;
                }
                s2 = s2 + 1;
            }
            s1 = s1 + 1;
        }
    }
    // f = (XOR of some inputs) ^ h(the others): an input is linear when flipping it flips every row
    var lin : u32 = 0;
    var ln : u32 = 0;
    var qi : u32 = 0;
    while (qi < 6) {
        if (((mask >> qi) & 1) == 1) {
            var all_flip : bool = true;
            var xx : u32 = 0;
            while (xx < 64) {
                if (bit_of(b, xx) == bit_of(b, xx ^ (1 << qi))) { all_flip = false; }
                xx = xx + 1;
            }
            if (all_flip) {
                lin = lin | (1 << qi);
                ln = ln + 1;
            }
        }
        qi = qi + 1;
    }
    if (ln != 0 and n - ln >= 2 and slot < 1) {
        var h : u64 = 0;
        var x2 : u32 = 0;
        while (x2 < 64) {
            if (bit_of(b, x2 & ~lin) == 1) { h = h | ((1 as u64) << x2); }
            x2 = x2 + 1;
        }
        classify_into(h, 1);
        classify_into(~h, 2);
        var use_flipped : bool = false;
        if (cl_score(2) < cl_score(1)) { use_flipped = true; }
        var use_slot : usize = 1;
        if (use_flipped) { use_slot = 2; }
        if (CL_ID[use_slot] != W_C_OTHER) {
            if (use_flipped) { cl_copy(2, 1); }
            if (use_flipped) { cl_start(slot, W_C_XNORWITH, n, ln, mask); } else { cl_start(slot, W_C_XORWITH, n, ln, mask); }
            var lq : u32 = 0;
            while (lq < 6) {
                if (((lin >> lq) & 1) == 1) { cl_data(slot, lq); }
                lq = lq + 1;
            }
            CL_INNER = true;
            return;
        }
    }
    cl_start(slot, W_C_OTHER, n, 0, mask);
}

pub fn classify(b: u64) {
    CL_INNER = false;
    classify_into(b, 0);
}

pub fn put_id(id: u32) {
    if (id == W_C_ZERO) { out_str("zero"); }
    if (id == W_C_ONE) { out_str("one"); }
    if (id == W_C_BUF) { out_str("buf"); }
    if (id == W_C_NOT) { out_str("not"); }
    if (id == W_C_AND) { out_str("and"); }
    if (id == W_C_NAND) { out_str("nand"); }
    if (id == W_C_OR) { out_str("or"); }
    if (id == W_C_NOR) { out_str("nor"); }
    if (id == W_C_ANDX) { out_str("andx"); }
    if (id == W_C_ORX) { out_str("orx"); }
    if (id == W_C_XOR) { out_str("xor"); }
    if (id == W_C_XNOR) { out_str("xnor"); }
    if (id == W_C_MAJ) { out_str("maj"); }
    if (id == W_C_MAJX) { out_str("majx"); }
    if (id == W_C_CARRY2) { out_str("carry2"); }
    if (id == W_C_CARRY2X) { out_str("carry2x"); }
    if (id == W_C_MUX2) { out_str("mux2"); }
    if (id == W_C_MUX4) { out_str("mux4"); }
    if (id == W_C_XORWITH) { out_str("xorwith"); }
    if (id == W_C_XNORWITH) { out_str("xnorwith"); }
    if (id == W_C_OTHER) { out_str("other"); }
}

/// CLASS_IDS[i] in OUT; the length.
pub fn class_id(i: u32) -> usize {
    out_reset();
    put_id(i);
    return OUT_N;
}

pub fn put_num(v: u32) {
    out_push((v + 48) as u8);
}

/// classKey of the last classify(): "id/n/k" or "id/n/k/inner-id/n/k" in OUT; the length.
pub fn class_key() -> usize {
    out_reset();
    put_id(CL_ID[0]);
    out_push(47);
    put_num(CL_N[0]);
    out_push(47);
    put_num(CL_K[0]);
    if (CL_INNER and (CL_ID[0] == W_C_XORWITH or CL_ID[0] == W_C_XNORWITH)) {
        out_push(47);
        put_id(CL_ID[1]);
        out_push(47);
        put_num(CL_N[1]);
        out_push(47);
        put_num(CL_K[1]);
    }
    return OUT_N;
}
; FOLDED-END

; --- state ----------------------------------------------------------------------------------------
pub var INPUT : [524288]u8 = [0; 524288];
pub var INPUT_N : u32 = 0;
pub var PXD : [524288]u8 = [0; 524288];
pub var PX_N : u32 = 0;
pub var DSD : [524288]u8 = [0; 524288];
pub var DS_N : u32 = 0;
pub var PX_ST : u32 = 0;
pub var DS_ST : u32 = 0;
pub var FAIL_FILE : u32 = 0;
pub var DATA_ST : u32 = 0;
pub var TAB : u32 = 0;
pub var EX_ON : i32 = -1;
pub var DRAGGING : bool = false;
pub var EFF_INPUT : bool = false;
pub var HAS_BITS : bool = false;
pub var BITS : u64 = 0;
