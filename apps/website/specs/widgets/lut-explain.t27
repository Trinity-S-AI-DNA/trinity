; --- Tests -------------------------------------------------------------------------------------
; INIT[i] is the output for input vector i, I0 = A1 the least significant bit. If the output is A1,
; every odd row is 1 and every even row 0 (0xAAAA in each word). If the output is A6, rows 0..31
; are 0 and rows 32..63 are 1: INIT[31] is bit 15 of word 1, INIT[32] bit 0 of word 2.
test bit_index_convention_i0_is_the_lsb {
    assert K_A1_WORDS[0] % 2 == 0;
    assert 1 == (K_A1_WORDS[0] / 2) % 2;
    assert 1 == (K_A1_WORDS[3] / 32768) % 2;
    assert K_A1_WORDS[0] == 43690;
    assert K_A1_WORDS[1] == K_A1_WORDS[0];
    assert K_A1_WORDS[3] == K_A1_WORDS[0];
    assert 0 == (K_A6_WORDS[1] / 32768) % 2;
    assert K_A6_WORDS[2] % 2 == 1;
    assert K_A6_WORDS[0] + K_A6_WORDS[1] == 0;
    assert K_A6_WORDS[2] == 65535;
    assert K_A6_WORDS[3] == 65535;
    assert 31 / 16 == 1;
    assert 32 / 16 == 2;
}

; 64'h6996966996696996 is XOR6. Nibble 0 of word 0 is rows 0..3 (A1, A2 vary): 6 = 0110, the parity
; of A1 and A2. A3 = 1 (nibble 1) and A4 = 1 (nibble 2) invert it, both together (nibble 3) do not.
; A5 = 1 (word 1) and A6 = 1 (word 2) invert the whole word, both together (word 3) do not.
test init_6996966996696996_is_xor6_the_parity_of_six_inputs {
    assert K_XOR6_WORDS[0] % 16 == 6;
    assert 6 % 2 == 0;
    assert 1 == (6 / 2) % 2;
    assert 1 == (6 / 4) % 2;
    assert 0 == (6 / 8) % 2;
    assert 15 - 6 == (K_XOR6_WORDS[0] / 16) % 16;
    assert 15 - 6 == (K_XOR6_WORDS[0] / 256) % 16;
    assert K_XOR6_WORDS[0] / 4096 == 6;
    assert K_XOR6_WORDS[1] == 65535 - K_XOR6_WORDS[0];
    assert K_XOR6_WORDS[2] == 65535 - K_XOR6_WORDS[0];
    assert K_XOR6_WORDS[3] == K_XOR6_WORDS[0];
    assert K_EXAMPLE_INITS[0] == "6996966996696996";
    assert K_EXAMPLE_CLASSES[0] == "xor/6/0";
    assert K_EXAMPLE_N[0] == K_N_INPUTS;
}

; 64'h8000000000000000 is AND6: one 1, at bit 15 of word 3, which is INIT[63], the row where all
; six inputs are 1.
test init_8000000000000000_is_and6 {
    assert K_AND6_WORDS[0] + K_AND6_WORDS[1] + K_AND6_WORDS[2] == 0;
    assert K_AND6_WORDS[3] == 32768;
    assert 3 * 16 + 15 == K_N_BITS - 1;
    assert K_N_BITS - 1 == 32 + 16 + 8 + 4 + 2 + 1;
    assert K_EXAMPLE_INITS[1] == "8000000000000000";
    assert K_EXAMPLE_CLASSES[1] == "and/6/0";
    assert K_EXAMPLE_N[1] == 6;
}

test the_design_numbers_add_up {
    assert K_DESIGN_NAMED + K_DESIGN_OTHER == K_DESIGN_LUTS;
    assert K_DESIGN_PINS_AGREE == K_DESIGN_LUTS;
    assert K_DESIGN_XOR_FAMILY <= K_DESIGN_NAMED;
    assert K_DESIGN_TOP_COUNT <= K_DESIGN_XOR_FAMILY;
    assert K_DESIGN_DISTINCT <= K_DESIGN_LUTS;
    assert K_DESIGN_O5_USED == 0;
    assert K_DESIGN_ROUNDS >= K_GAME_ROUNDS;
    assert K_GAME_CHOICES == 4;
}

test the_page_sends_nothing {
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == true;
    assert K_DATA_DESIGN == "./design.json";
    assert K_DATA_PRJXRAY == "./prjxray.json";
    assert CATEGORY == "fpga";
}


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, issue #10938, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/lut-explain/tool.js (588 lines of hand-written JavaScript)
; and, as its decoder, lut.js. The words and numbers above are unchanged: the view prints SAY_
; constants and K_ numbers, it writes no English of its own.
; --
; THE DECODER IS FOLDED IN, NOT IMPORTED. specs/widgets/lut_explain_logic.t27 is the differential-
; tested port of lut.js. Its functions keep their tables in module-level `pub var`s and t27c's `use`
; does not carry a `pub var` across modules (measured on 0.5.2), so they cannot be imported. The
; block between the two FOLDED markers is that module's text, from its first constant to class_key(),
; byte for byte; the build diffs the region against the logic module. Change the decoder there,
; then regenerate this region.
; --
; Host protocol (host.js; all exports of this module):
;   w_init(hash)              the page opens
;   w_data(i, bytes)          file i of W_DATA_FILES (0 prjxray.json, 1 design.json) was fetched; w_data_failed(i) when not
;   w_press(i)                button number i in page order (the page maps it to its action; buttons carry no data-i)
;   w_input(i, bytes)         control i (among input and textarea, in page order) changed: 0 is the paste box
;   w_file(z, name, size) -> 1 | 0, w_file_data(z, bytes), w_file_failed(z)   a picked or dropped .fasm file
;   w_drag(z, over) -> 1 | 0  the drag entered (1) or left/dropped (0) zone z
;   w_seed(n)                 the seed of the game's random numbers (xorshift32)
;   w_effect(k, dst) -> len   effect k after the last event: 'v', control index, text = set that control's value
;   w_render(dst)             the page's HTML, length (0 on overflow)
; The state is what tool.js kept: tab, the paste text and what was read from it, the flipped bits, the
; file, the game, and the design box. The design box is a cached HTML region because tool.js draws it
; only when its tab opens (or a file is read on that tab); everything else is derived on every render.
; Not carried over from JavaScript: the paste text is cut at W_IN_CAP (524,288 bytes) and a text with more
; than 16,384 non-empty lines reads as nothing; a dropped file over W_FILE_CAP (8 MiB) is ignored, and
; one with more than 8,192 LUTs or 24 lines for one LUT is cut; a data file over 512 KiB, or that is
; not JSON, counts as not read (the message names the file, JavaScript names the parse error); numbers
; in the data files are printed as integers; the game's random numbers are an xorshift32 seeded by the
; host (Math.random in the original); a width of 100*n/max is rounded by exact integer arithmetic on
; the double (as toFixed(1) does).

