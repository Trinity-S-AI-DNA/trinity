; --- plain text helpers ---------------------------------------------------------------------------
pub fn eq_s(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var k : usize = 0;
    while (k < a.len) {
        if (a[k] != b[k]) { return false; }
        k = k + 1;
    }
    return true;
}

pub fn starts_s(a: []const u8, p: []const u8) -> bool {
    if (a.len < p.len) { return false; }
    var k : usize = 0;
    while (k < p.len) {
        if (a[k] != p[k]) { return false; }
        k = k + 1;
    }
    return true;
}

pub fn ends_s(a: []const u8, p: []const u8) -> bool {
    if (a.len < p.len) { return false; }
    var k : usize = 0;
    while (k < p.len) {
        if (a[a.len - p.len + k] != p[k]) { return false; }
        k = k + 1;
    }
    return true;
}

fn up_b(c: u8) -> u8 {
    if (c >= 97 and c <= 122) { return c - 32; }
    return c;
}

/// Is s, upper-cased, the upper-case word w?
fn eq_up(s: []const u8, w: []const u8) -> bool {
    if (s.len != w.len) { return false; }
    var k : usize = 0;
    while (k < s.len) {
        if (up_b(s[k]) != w[k]) { return false; }
        k = k + 1;
    }
    return true;
}

fn is_abcd(c: u8) -> bool {
    return c >= 65 and c <= 68;
}

/// Are all bytes of s[lo..hi) word characters (\w), and is there at least one?
fn all_word(s: []const u8, lo: usize, hi: usize) -> bool {
    if (hi <= lo) { return false; }
    var k : usize = lo;
    while (k < hi) {
        if (!is_word_byte(s[k])) { return false; }
        k = k + 1;
    }
    return true;
}

fn copy_to(dst: []u8, n0: u32, s: []const u8) -> u32 {
    return raw(dst, n0, s);
}

fn wr(o: []u8, n: u32, esc: bool, s: []const u8) -> u32 {
    if (esc) { return text(o, n, s); }
    return raw(o, n, s);
}

fn wb(o: []u8, n: u32, esc: bool, b: u8) -> u32 {
    if (esc) { return put_escaped(o, n, b); }
    return put(o, n, b);
}

/// Fill {name} placeholders from up to eight pairs. esc = false writes plain text (for a name that is
/// built first and written later); esc = true escapes the template and the values as text. A placeholder
/// with no pair stays as written.
fn pf8(o: []u8, n0: u32, esc: bool, t: []const u8, k0: []const u8, v0: []const u8, k1: []const u8, v1: []const u8, k2: []const u8, v2: []const u8, k3: []const u8, v3: []const u8, k4: []const u8, v4: []const u8, k5: []const u8, v5: []const u8, k6: []const u8, v6: []const u8, k7: []const u8, v7: []const u8) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    while (i < t.len) {
        var closed : usize = 0;
        if (t[i] == 123) {
            var j : usize = i + 1;
            while (j < t.len and is_word_byte(t[j])) { j = j + 1; }
            if (j > i + 1 and j < t.len and t[j] == 125) { closed = j; }
        }
        if (closed > 0) {
            var hit : bool = false;
            if (!hit and name_is(t, i + 1, closed, k0)) { n = wr(o, n, esc, v0); hit = true; }
            if (!hit and name_is(t, i + 1, closed, k1)) { n = wr(o, n, esc, v1); hit = true; }
            if (!hit and name_is(t, i + 1, closed, k2)) { n = wr(o, n, esc, v2); hit = true; }
            if (!hit and name_is(t, i + 1, closed, k3)) { n = wr(o, n, esc, v3); hit = true; }
            if (!hit and name_is(t, i + 1, closed, k4)) { n = wr(o, n, esc, v4); hit = true; }
            if (!hit and name_is(t, i + 1, closed, k5)) { n = wr(o, n, esc, v5); hit = true; }
            if (!hit and name_is(t, i + 1, closed, k6)) { n = wr(o, n, esc, v6); hit = true; }
            if (!hit and name_is(t, i + 1, closed, k7)) { n = wr(o, n, esc, v7); hit = true; }
            if (!hit) {
                var q : usize = i;
                while (q <= closed) { n = put(o, n, t[q]); q = q + 1; }
            }
            i = closed + 1;
        } else {
            n = wb(o, n, esc, t[i]);
            i = i + 1;
        }
    }
    return n;
}

fn pf1(o: []u8, n0: u32, esc: bool, t: []const u8, k0: []const u8, v0: []const u8) -> u32 {
    return pf8(o, n0, esc, t, k0, v0, "", "", "", "", "", "", "", "", "", "", "", "", "", "");
}

fn pf2(o: []u8, n0: u32, esc: bool, t: []const u8, k0: []const u8, v0: []const u8, k1: []const u8, v1: []const u8) -> u32 {
    return pf8(o, n0, esc, t, k0, v0, k1, v1, "", "", "", "", "", "", "", "", "", "", "", "");
}

fn pf3(o: []u8, n0: u32, esc: bool, t: []const u8, k0: []const u8, v0: []const u8, k1: []const u8, v1: []const u8, k2: []const u8, v2: []const u8) -> u32 {
    return pf8(o, n0, esc, t, k0, v0, k1, v1, k2, v2, "", "", "", "", "", "", "", "", "", "");
}

/// A signed integer as toLocaleString('en-US') writes it (grouped); an integer-valued double.
fn fnum(o: []u8, n0: u32, v: f64) -> u32 {
    var n : u32 = n0;
    var x : f64 = v;
    if (x < 0.0) {
        n = put(o, n, 45);
        x = 0.0 - x;
    }
    return num_grouped(o, n, x as u64);
}

/// String(n) for a small integer: plain decimal.
fn dnum(o: []u8, n0: u32, v: u64) -> u32 {
    var tmp : [24]u8 = [0; 24];
    const m : u32 = dec_to(tmp[0..], v);
    return raw(o, n0, tmp[0..(m as usize)]);
}

fn pin_to(o: []u8, n0: u32, q: u32) -> u32 {
    var d : [4]u8 = [0; 4];
    const m : u32 = dec_to(d[0..], (q + 1) as u64);
    return pf1(o, n0, false, SAY_PIN, "n", d[0..(m as usize)]);
}

/// pins(mask): A1, A3, ... for the set bits of a mask, joined by ", ".
fn pins_mask(o: []u8, n0: u32, mask: u32) -> u32 {
    var n : u32 = n0;
    var first : bool = true;
    var q : u32 = 0;
    while (q < 6) {
        if (((mask >> q) & 1) == 1) {
            if (!first) { n = raw(o, n, ", "); }
            n = pin_to(o, n, q);
            first = false;
        }
        q = q + 1;
    }
    return n;
}

fn lowest_set(mask: u32) -> u32 {
    var q : u32 = 0;
    while (q < 6) {
        if (((mask >> q) & 1) == 1) { return q; }
        q = q + 1;
    }
    return 0;
}

; --- JSON helpers -----------------------------------------------------------------------------------
/// state.px and state.design are set only when both files have been read.
fn pxs() -> []const u8 {
    if (DATA_ST != 1) { return PXD[0..0]; }
    return PXD[0..(PX_N as usize)];
}

fn dss() -> []const u8 {
    if (DATA_ST != 1) { return DSD[0..0]; }
    return DSD[0..(DS_N as usize)];
}

fn jstr_copy(dst: []u8, d: []const u8, sp: i64) -> u32 {
    var len : u32 = str_len(d, sp);
    if (len > (dst.len as u32)) { len = dst.len as u32; }
    var k : u32 = 0;
    while (k < len) {
        dst[k as usize] = str_byte(d, sp, k);
        k = k + 1;
    }
    return len;
}

fn jstr_is(d: []const u8, sp: i64, w: []const u8) -> bool {
    if (kind(d, sp) != J_STRING) { return false; }
    if (str_len(d, sp) != (w.len as u32)) { return false; }
    var k : usize = 0;
    while (k < w.len) {
        if (str_byte(d, sp, k as u32) != w[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// num(n) of a JSON value: '-' for a missing or null one, else the grouped integer.
fn jnum_to(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    if (sp < 0 or kind(d, sp) == J_NULL) { return put(o, n0, 45); }
    return fnum(o, n0, num_f64(d, sp));
}

fn jfield_to(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    var n : u32 = n0;
    const len : u32 = str_len(d, sp);
    var k : u32 = 0;
    while (k < len) {
        n = put(o, n, str_byte(d, sp, k));
        k = k + 1;
    }
    return n;
}

; --- prjxray-db ----------------------------------------------------------------------------------------
fn tiles_sp() -> i64 {
    const d : []const u8 = pxs();
    return obj_get(d, root(d), "tiles");
}

/// tileOf(tt): the tile object, following one sameAs; NO_SPAN when there is none.
fn tile_of(tt: []const u8) -> i64 {
    const d : []const u8 = pxs();
    const tiles : i64 = tiles_sp();
    var t : i64 = obj_get(d, tiles, tt);
    if (t < 0) { return NO_SPAN; }
    const sa : i64 = obj_get(d, t, "sameAs");
    if (sa >= 0 and kind(d, sa) == J_STRING and str_len(d, sa) > 0) {
        const m : u32 = jstr_copy(KB[0..], d, sa);
        t = obj_get(d, tiles, KB[0..(m as usize)]);
        if (t < 0) { return NO_SPAN; }
    }
    return t;
}

/// twinOf(tt) into KB2; its length, or 0 when there is none.
fn twin_of(tt: []const u8) -> u32 {
    const d : []const u8 = pxs();
    const tiles : i64 = tiles_sp();
    const own : i64 = obj_get(d, tiles, tt);
    if (own < 0) { return 0; }
    const sa : i64 = obj_get(d, own, "sameAs");
    if (sa >= 0 and kind(d, sa) == J_STRING and str_len(d, sa) > 0) {
        return jstr_copy(KB2[0..], d, sa);
    }
    if (kind(d, tiles) != J_OBJECT) { return 0; }
    const hi : usize = span_hi(tiles);
    var p : usize = skip_ws(d, span_lo(tiles) + 1);
    while (p < hi and d[p] == 34) {
        const ke : usize = string_end(d, p);
        if (ke > hi) { return 0; }
        const q : usize = skip_ws(d, ke);
        if (q >= hi or d[q] != 58) { return 0; }
        const v : usize = skip_ws(d, q + 1);
        const ve : usize = value_end(d, v);
        if (ve > hi) { return 0; }
        const sa2 : i64 = obj_get(d, jspan(v, ve), "sameAs");
        if (sa2 >= 0 and jstr_is(d, sa2, tt)) {
            const ks : i64 = jspan(p, ke);
            return jstr_copy(KB2[0..], d, ks);
        }
        p = skip_ws(d, ve);
        if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
    }
    return 0;
}

/// parseLoc's test: TILE.SITE.L with TILE ending _X<digits>Y<digits>, SITE SLICE[LM]_X[01], L one of ABCD.
fn loc_valid(s: []const u8) -> bool {
    var p : usize = 0;
    while (p < s.len and is_class(s[p])) { p = p + 1; }
    if (p == 0 or p >= s.len or s[p] != 46 or p > 160) { return false; }
    const te : usize = type_end(s, 0, p);
    if (te == p or te == 0) { return false; }
    if (s.len != p + 1 + 9 + 1 + 1) { return false; }
    if (!is_slice_site(s, p + 1, p + 10)) { return false; }
    if (s[p + 10] != 46) { return false; }
    if (!is_abcd(s[p + 11])) { return false; }
    return true;
}

fn parse_loc(s: []const u8) -> bool {
    if (!loc_valid(s)) { return false; }
    var p : usize = 0;
    while (p < s.len and s[p] != 46) { p = p + 1; }
    const te : usize = type_end(s, 0, p);
    var k : usize = 0;
    while (k < p) {
        LOC_TILE[k] = s[k];
        k = k + 1;
    }
    LOC_TILE_N = p;
    LOC_TYPE_N = te;
    k = 0;
    while (k < 9) {
        LOC_SITE[k] = s[p + 1 + k];
        k = k + 1;
    }
    LOC_SITE_N = 9;
    LOC_LUT = s[p + 11];
    LOC_OK = true;
    return true;
}

fn loc_type() -> []const u8 {
    return LOC_TILE[0..LOC_TYPE_N];
}

fn loc_site() -> []const u8 {
    return LOC_SITE[0..LOC_SITE_N];
}

/// The key "SITE.X" in KB for a site name and a trailing part; its length.
fn dotted(site: []const u8, tail: []const u8) -> u32 {
    var n : u32 = raw(KB[0..], 0, site);
    n = put(KB[0..], n, 46);
    n = raw(KB[0..], n, tail);
    return n;
}

/// The span of init["SITE.L"] of the tile type tt, or NO_SPAN.
fn init_list(tt: []const u8, site: []const u8, lut: u8) -> i64 {
    const t : i64 = tile_of(tt);
    if (t < 0) { return NO_SPAN; }
    const d : []const u8 = pxs();
    var one : [2]u8 = [0; 2];
    one[0] = lut;
    const m : u32 = dotted(site, one[0..1]);
    return obj_get(d, obj_get(d, t, "init"), KB[0..(m as usize)]);
}

; --- class names -------------------------------------------------------------------------------------
fn id_name(i: u32) -> []const u8 {
    if (i == 0) { return "ZERO"; }
    if (i == 1) { return "ONE"; }
    if (i == 2) { return "BUF"; }
    if (i == 3) { return "NOT"; }
    if (i == 4) { return "AND"; }
    if (i == 5) { return "NAND"; }
    if (i == 6) { return "OR"; }
    if (i == 7) { return "NOR"; }
    if (i == 8) { return "ANDX"; }
    if (i == 9) { return "ORX"; }
    if (i == 10) { return "XOR"; }
    if (i == 11) { return "XNOR"; }
    if (i == 12) { return "MAJ"; }
    if (i == 13) { return "MAJX"; }
    if (i == 14) { return "CARRY2"; }
    if (i == 15) { return "CARRY2X"; }
    if (i == 16) { return "MUX2"; }
    if (i == 17) { return "MUX4"; }
    if (i == 18) { return "XORWITH"; }
    if (i == 19) { return "XNORWITH"; }
    return "OTHER";
}

fn class_tpl(i: u32) -> []const u8 {
    if (i == 0) { return SAY_CLASS_ZERO; }
    if (i == 1) { return SAY_CLASS_ONE; }
    if (i == 2) { return SAY_CLASS_BUF; }
    if (i == 3) { return SAY_CLASS_NOT; }
    if (i == 4) { return SAY_CLASS_AND; }
    if (i == 5) { return SAY_CLASS_NAND; }
    if (i == 6) { return SAY_CLASS_OR; }
    if (i == 7) { return SAY_CLASS_NOR; }
    if (i == 8) { return SAY_CLASS_ANDX; }
    if (i == 9) { return SAY_CLASS_ORX; }
    if (i == 10) { return SAY_CLASS_XOR; }
    if (i == 11) { return SAY_CLASS_XNOR; }
    if (i == 12) { return SAY_CLASS_MAJ; }
    if (i == 13) { return SAY_CLASS_MAJX; }
    if (i == 14) { return SAY_CLASS_CARRY2; }
    if (i == 15) { return SAY_CLASS_CARRY2X; }
    if (i == 16) { return SAY_CLASS_MUX2; }
    if (i == 17) { return SAY_CLASS_MUX4; }
    if (i == 18) { return SAY_CLASS_XORWITH; }
    if (i == 19) { return SAY_CLASS_XNORWITH; }
    return SAY_CLASS_OTHER;
}

/// The class a text names, upper-cased: 0..20, or 255.
fn id_of_ci(s: []const u8) -> u32 {
    var i : u32 = 0;
    while (i < 21) {
        if (eq_up(s, id_name(i))) { return i; }
        i = i + 1;
    }
    return 255;
}

/// Number(part) for a class key's n and k: a missing part is NaN, an empty or blank one 0, a sign and digits
/// (with white space around) their value, anything else NaN (W_NAN_V).
fn num_part(s: []const u8, lo0: usize, hi0: usize, has: bool) -> i64 {
    if (!has) { return W_NAN_V; }
    var lo : usize = lo0;
    var hi : usize = hi0;
    while (lo < hi and (s[lo] == 32 or (s[lo] >= 9 and s[lo] <= 13))) { lo = lo + 1; }
    while (hi > lo and (s[hi - 1] == 32 or (s[hi - 1] >= 9 and s[hi - 1] <= 13))) { hi = hi - 1; }
    if (hi <= lo) { return 0; }
    var neg : bool = false;
    if (s[lo] == 43 or s[lo] == 45) {
        neg = s[lo] == 45;
        lo = lo + 1;
    }
    if (hi <= lo) { return W_NAN_V; }
    var v : i64 = 0;
    var k : usize = lo;
    while (k < hi) {
        if (!is_digit(s[k])) { return W_NAN_V; }
        if (v < 100000000000000) { v = v * 10 + ((s[k] - 48) as i64); }
        k = k + 1;
    }
    if (neg) { return 0 - v; }
    return v;
}

fn num_plain(o: []u8, n0: u32, v: i64) -> u32 {
    if (v == W_NAN_V) { return raw(o, n0, "NaN"); }
    if (v < 0) {
        const n : u32 = put(o, n0, 45);
        return dnum(o, n, (0 - v) as u64);
    }
    return dnum(o, n0, v as u64);
}

/// className(classFromKey(key)): plain text of the name a key "id/n/k[/inner]" stands for.
fn class_name_key(o: []u8, n0: u32, key: []const u8) -> u32 {
    var s0 : usize = key.len;
    var s1 : usize = key.len;
    var s2 : usize = key.len;
    var has1 : bool = false;
    var has2 : bool = false;
    var has3 : bool = false;
    var p : usize = 0;
    while (p < key.len and key[p] != 47) { p = p + 1; }
    s0 = p;
    var a : usize = p + 1;
    if (p < key.len) {
        has1 = true;
        var q : usize = a;
        while (q < key.len and key[q] != 47) { q = q + 1; }
        s1 = q;
        if (q < key.len) {
            has2 = true;
            var r : usize = q + 1;
            while (r < key.len and key[r] != 47) { r = r + 1; }
            s2 = r;
            if (r < key.len) { has3 = true; }
        }
    }
    const id : u32 = id_of_ci(key[0..s0]);
    var tpl : []const u8 = key[0..s0];
    if (id < 21) { tpl = class_tpl(id); }
    const nv : i64 = num_part(key, a, s1, has1);
    var kv : i64 = W_NAN_V;
    var b : usize = s1 + 1;
    if (has2) { kv = num_part(key, b, s2, true); }
    var nb : [32]u8 = [0; 32];
    var kb : [32]u8 = [0; 32];
    const nl : u32 = num_plain(nb[0..], 0, nv);
    const kl : u32 = num_plain(kb[0..], 0, kv);
    var inner : [1024]u8 = [0; 1024];
    var il : u32 = 0;
    if (has3) { il = class_name_key(inner[0..], 0, key[(s2 + 1)..key.len]); }
    return pf3(o, n0, false, tpl, "n", nb[0..(nl as usize)], "k", kb[0..(kl as usize)], "inner", inner[0..(il as usize)]);
}

/// className(c) of the last classify(): through its key.
fn class_name_cls(o: []u8, n0: u32) -> u32 {
    const kl : usize = class_key();
    var kb : [64]u8 = [0; 64];
    var k : usize = 0;
    while (k < kl) {
        kb[k] = OUT[k];
        k = k + 1;
    }
    return class_name_key(o, n0, kb[0..kl]);
}

; --- what prjxray-db says (words) -----------------------------------------------------------------------
fn letter_buf(b: u8) -> u32 {
    W8[0] = b;
    return 1;
}

/// srcWord(key, lut) as plain text in o; the length.
fn src_word(o: []u8, n0: u32, key: []const u8, lut: u8) -> u32 {
    var kk : []const u8 = key;
    if (key.len == 2 and is_abcd(key[0]) and key[1] == 88) {
        kk = "NX";
    } else {
        if (key.len == 3 and is_abcd(key[0]) and key[1] == 53 and key[2] == 81) {
            kk = "N5Q";
        } else {
            if (key.len == 2 and is_abcd(key[0]) and key[1] == 73) {
                kk = "NI";
            } else {
                if (ends_s(key, "MC31")) { kk = "MC31"; }
            }
        }
    }
    var l0 : u8 = lut;
    if (key.len > 0 and is_abcd(key[0]) and !eq_s(kk, key)) { l0 = key[0]; }
    var tpl : []const u8 = key;
    var i : usize = 0;
    while (i < 13) {
        if (eq_s(kk, SAY_SRC_KEYS[i])) { tpl = SAY_SRC_WORDS[i]; }
        i = i + 1;
    }
    W8[0] = l0;
    return pf1(o, n0, false, tpl, "L", W8[0..1]);
}

fn flat_word(f: []const u8) -> []const u8 {
    if (eq_s(f, "CEUSEDMUX")) { return SAY_F_CEUSEDMUX; }
    if (eq_s(f, "SRUSEDMUX")) { return SAY_F_SRUSEDMUX; }
    if (eq_s(f, "CLKINV")) { return SAY_F_CLKINV; }
    if (eq_s(f, "NOCLKINV")) { return SAY_F_NOCLKINV; }
    if (eq_s(f, "FFSYNC")) { return SAY_F_FFSYNC; }
    if (eq_s(f, "LATCH")) { return SAY_F_LATCH; }
    if (eq_s(f, "WA7USED")) { return SAY_F_WA7USED; }
    if (eq_s(f, "WA8USED")) { return SAY_F_WA8USED; }
    if (eq_s(f, "WEMUX.CE")) { return SAY_F_WEMUX_CE; }
    return "";
}

/// featureWords(f) for the feature text f of a site line in tile type tt, written as escaped text to o.
fn feature_words(o: []u8, n0: u32, f: []const u8, tt: []const u8) -> u32 {
    const len : usize = f.len;
    if (len == 9 and is_abcd(f[0]) and eq_s(f[1..9], "LUT.INIT")) {
        return pf1(o, n0, true, SAY_F_LUT_INIT, "L", f[0..1]);
    }
    if (len >= 5 and is_abcd(f[0]) and eq_s(f[1..5], "LUT.")) {
        if (eq_s(f[5..len], "RAM")) { return pf1(o, n0, true, SAY_F_LUT_RAM, "L", f[0..1]); }
        if (eq_s(f[5..len], "SMALL")) { return pf1(o, n0, true, SAY_F_LUT_SMALL, "L", f[0..1]); }
        if (eq_s(f[5..len], "SRL")) { return pf1(o, n0, true, SAY_F_LUT_SRL, "L", f[0..1]); }
    }
    if (len > 12 and is_abcd(f[0]) and eq_s(f[1..12], "LUT.DI1MUX.") and all_word(f, 12, len)) {
        const m : u32 = src_word(W1[0..], 0, f[12..len], f[0]);
        return pf2(o, n0, true, SAY_F_DI1MUX, "L", f[0..1], "src", W1[0..(m as usize)]);
    }
    if (len >= 1 and is_abcd(f[0])) {
        var ix : usize = 1;
        if (len > 1 and f[1] == 53) { ix = 2; }
        if (eq_s(f[ix..len], "FF.ZINI")) { return pf1(o, n0, true, SAY_F_ZINI, "ff", f[0..(ix + 2)]); }
        if (eq_s(f[ix..len], "FF.ZRST")) { return pf1(o, n0, true, SAY_F_ZRST, "ff", f[0..(ix + 2)]); }
    }
    if (len == 12 and is_abcd(f[0]) and eq_s(f[1..12], "5FFMUX.IN_A")) {
        return pf2(o, n0, true, SAY_F_5FFMUX_IN_A, "ff", f[0..4], "L", f[0..1]);
    }
    if (len == 12 and is_abcd(f[0]) and eq_s(f[1..12], "5FFMUX.IN_B")) {
        return pf2(o, n0, true, SAY_F_5FFMUX_IN_B, "ff", f[0..4], "L", f[0..1]);
    }
    if (len > 7 and is_abcd(f[0]) and eq_s(f[1..7], "FFMUX.") and all_word(f, 7, len)) {
        const m2 : u32 = src_word(W1[0..], 0, f[7..len], f[0]);
        return pf2(o, n0, true, SAY_F_FFMUX, "ff", f[0..3], "src", W1[0..(m2 as usize)]);
    }
    if (len > 8 and is_abcd(f[0]) and eq_s(f[1..8], "OUTMUX.") and all_word(f, 8, len)) {
        const m3 : u32 = src_word(W1[0..], 0, f[8..len], f[0]);
        return pf2(o, n0, true, SAY_F_OUTMUX, "L", f[0..1], "src", W1[0..(m3 as usize)]);
    }
    if (len == 11 and eq_s(f[0..7], "CARRY4.") and is_abcd(f[7]) and eq_s(f[8..11], "CY0")) {
        return pf1(o, n0, true, SAY_F_CY0, "L", f[7..8]);
    }
    if (len > 10 and eq_s(f[0..10], "PRECYINIT.") and all_word(f, 10, len)) {
        const m4 : u32 = src_word(W1[0..], 0, f[10..len], 65);
        return pf1(o, n0, true, SAY_F_PRECYINIT, "src", W1[0..(m4 as usize)]);
    }
    const fw : []const u8 = flat_word(f);
    if (fw.len > 0) { return text(o, n0, fw); }
    return pf1(o, n0, true, SAY_F_UNKNOWN, "tt", tt);
}

/// pipWords(f): dst and src are the two parts of the path; the words, each in a lx-w paragraph.
fn pip_words(o: []u8, n0: u32, dst: []const u8, src: []const u8, tt: []const u8) -> u32 {
    var n : u32 = n0;
    const t : i64 = tile_of(tt);
    if (t < 0) {
        n = raw(o, n, "<p class=\"lx-w\">");
        n = pf3(o, n, true, SAY_PIP_OTHER, "tt", tt, "dst", dst, "src", src);
        return raw(o, n, "</p>");
    }
    const d : []const u8 = pxs();
    var plen : usize = 0;
    // /^(CLBL[LM]_(?:LL|L|M)_)([ABCD])([1-6])$/
    if (dst.len >= 8 and eq_s(dst[0..4], "CLBL") and (dst[4] == 76 or dst[4] == 77) and dst[5] == 95) {
        if (dst.len >= 9 and dst[6] == 76 and dst[7] == 76 and dst[8] == 95) { plen = 9; }
        if (plen == 0 and dst[6] == 76 and dst[7] == 95) { plen = 8; }
        if (plen == 0 and dst[6] == 77 and dst[7] == 95) { plen = 8; }
    }
    if (plen > 0 and (dst.len != plen + 2 or !is_abcd(dst[plen]) or dst[plen + 1] < 49 or dst[plen + 1] > 54)) { plen = 0; }
    var found : bool = false;
    var site_name : i64 = NO_SPAN;
    if (plen > 0) {
        const sites : i64 = obj_get(d, t, "sites");
        const sn : u32 = arr_len(d, sites);
        var i : u32 = 0;
        while (i < sn and !found) {
            const sobj : i64 = arr_at(d, sites, i);
            if (jstr_is(d, obj_get(d, sobj, "prefix"), dst[0..plen])) {
                found = true;
                site_name = obj_get(d, sobj, "name");
            }
            i = i + 1;
        }
    }
    n = raw(o, n, "<p class=\"lx-w\">");
    if (found) {
        const nm : u32 = jstr_copy(W2[0..], d, site_name);
        n = pf8(o, n, true, SAY_PIP_LUTPIN, "n", dst[(plen + 1)..(plen + 2)], "site", W2[0..(nm as usize)], "L", dst[plen..(plen + 1)], "src", src, "", "", "", "", "", "", "", "");
    } else {
        n = pf2(o, n, true, SAY_PIP_CLB, "dst", dst, "src", src);
    }
    n = raw(o, n, "</p>");
    var kl : u32 = raw(KB[0..], 0, dst);
    kl = put(KB[0..], kl, 46);
    kl = raw(KB[0..], kl, src);
    if (kl != OVER) {
        const kind_sp : i64 = obj_get(d, obj_get(d, t, "ppips"), KB[0..(kl as usize)]);
        if (jstr_is(d, kind_sp, "always")) {
            n = raw(o, n, "<p class=\"lx-w\">");
            n = text(o, n, SAY_PIP_ALWAYS);
            n = raw(o, n, "</p>");
        }
        if (jstr_is(d, kind_sp, "hint")) {
            n = raw(o, n, "<p class=\"lx-w\">");
            n = text(o, n, SAY_PIP_HINT);
            n = raw(o, n, "</p>");
        }
        if (jstr_is(d, kind_sp, "default")) {
            n = raw(o, n, "<p class=\"lx-w\">");
            n = text(o, n, SAY_PIP_DEFAULT);
            n = raw(o, n, "</p>");
        }
    }
    return n;
}

/// tileWords(tt), each in a lx-note paragraph.
fn tile_words(o: []u8, n0: u32, tt: []const u8) -> u32 {
    var n : u32 = n0;
    if (starts_s(tt, "CLBLL_")) {
        n = raw(o, n, "<p class=\"lx-note\">");
        n = text(o, n, SAY_TILE_CLBLL);
        n = raw(o, n, "</p>");
    } else {
        if (starts_s(tt, "CLBLM_")) {
            n = raw(o, n, "<p class=\"lx-note\">");
            n = text(o, n, SAY_TILE_CLBLM);
            n = raw(o, n, "</p>");
        } else {
            n = raw(o, n, "<p class=\"lx-note\">");
            n = pf1(o, n, true, SAY_TILE_OTHER, "tt", tt);
            return raw(o, n, "</p>");
        }
    }
    const tw : u32 = twin_of(tt);
    if (tw > 0) {
        n = raw(o, n, "<p class=\"lx-note\">");
        n = pf2(o, n, true, SAY_TILE_SIDE, "a", tt, "b", KB2[0..(tw as usize)]);
        n = raw(o, n, "</p>");
    }
    return n;
}

fn chip(o: []u8, n0: u32, k: usize, v: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<span class=\"lx-chip\"><b>");
    n = text(o, n, SAY_PART_NAMES[k]);
    n = raw(o, n, "</b> ");
    n = text(o, n, v);
    return raw(o, n, "</span>");
}

; --- the FASM lines of the paste ---------------------------------------------------------------------------
/// One list item for the line f (already parsed into FL_*); `line` is the line's bytes. kind is pi_kind.
fn emit_item(o: []u8, n0: u32, line: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<li class=\"lx-fl\"><code class=\"lx-line lx-mono\">");
    n = text(o, n, line[FL_TEXT_LO..FL_TEXT_HI]);
    n = raw(o, n, "</code><div class=\"lx-chips\">");
    const tile : []const u8 = line[FL_TILE_LO..FL_TILE_HI];
    const tt : []const u8 = line[FL_TILE_LO..FL_TYPE_HI];
    n = chip(o, n, 0, tile);
    const kd : u32 = FL_KIND;
    if (kd == W_FK_SITE or kd == W_FK_LUT_INIT) {
        const site : []const u8 = line[FL_SITE_LO..FL_SITE_HI];
        const feat : []const u8 = line[FL_FEAT_LO..FL_FEAT_HI];
        const lutc : u8 = FL_LUT;
        const has_v : bool = FL_HAS_VTEXT;
        const vtext : []const u8 = line[FL_VTEXT_LO..FL_VTEXT_HI];
        n = chip(o, n, 1, site);
        var dot : usize = feat.len;
        var q : usize = 0;
        while (q < feat.len) {
            if (feat[q] == 46) { dot = q; break; }
            q = q + 1;
        }
        if (dot < feat.len) {
            n = chip(o, n, 2, feat[0..dot]);
            n = chip(o, n, 3, feat[(dot + 1)..feat.len]);
        } else {
            n = chip(o, n, 3, feat);
        }
        if (has_v) {
            if (vtext.len > 24) {
                var vb : [32]u8 = [0; 32];
                var z : usize = 0;
                while (z < 22) { vb[z] = vtext[z]; z = z + 1; }
                vb[22] = 46;
                vb[23] = 46;
                n = chip(o, n, 4, vb[0..24]);
            } else {
                n = chip(o, n, 4, vtext);
            }
        }
        n = raw(o, n, "</div>");
        n = raw(o, n, "<p class=\"lx-w\">");
        n = feature_words(o, n, feat, tt);
        n = raw(o, n, "</p>");
        const t : i64 = tile_of(tt);
        if (t >= 0) {
            const d : []const u8 = pxs();
            if (kd == W_FK_LUT_INIT) {
                const list : i64 = init_list(tt, site, lutc);
                if (list >= 0) {
                    n = raw(o, n, "<p class=\"lx-w\">");
                    const first : i64 = arr_at(d, list, 0);
                    const last : i64 = arr_at(d, list, 63);
                    const m1 : u32 = jstr_copy(W3[0..], d, first);
                    const m2 : u32 = jstr_copy(W4[0..], d, last);
                    n = pf2(o, n, true, SAY_BITS_INIT, "first", W3[0..(m1 as usize)], "last", W4[0..(m2 as usize)]);
                    n = raw(o, n, "</p>");
                }
            } else {
                const kl : u32 = dotted(site, feat);
                var list2 : i64 = NO_SPAN;
                if (kl != OVER) { list2 = obj_get(d, obj_get(d, t, "features"), KB[0..(kl as usize)]); }
                if (list2 >= 0) {
                    const cnt : u32 = arr_len(d, list2);
                    var neg : bool = false;
                    var b : u32 = 0;
                    while (b < cnt) {
                        const bs : i64 = arr_at(d, list2, b);
                        if (kind(d, bs) == J_STRING and str_len(d, bs) > 0 and str_byte(d, bs, 0) == 33) { neg = true; }
                        b = b + 1;
                    }
                    n = raw(o, n, "<p class=\"lx-w lx-sub\">");
                    n = text(o, n, SAY_BITS);
                    n = raw(o, n, ": <span class=\"lx-bits lx-mono\">");
                    b = 0;
                    while (b < cnt) {
                        const bs2 : i64 = arr_at(d, list2, b);
                        if (kind(d, bs2) == J_STRING and str_len(d, bs2) > 0 and str_byte(d, bs2, 0) == 33) {
                            n = raw(o, n, "<span class=\"is-neg\">");
                        } else {
                            n = raw(o, n, "<span>");
                        }
                        n = jtext_to(o, n, d, bs2);
                        n = raw(o, n, "</span>");
                        b = b + 1;
                    }
                    n = raw(o, n, "</span>");
                    if (neg) {
                        n = raw(o, n, " (");
                        n = text(o, n, SAY_BIT_NEG);
                        n = raw(o, n, ")");
                    }
                    n = raw(o, n, "</p>");
                } else {
                    n = raw(o, n, "<p class=\"lx-w\">");
                    const kk : u32 = dotted(site, feat);
                    n = pf2(o, n, true, SAY_TILE_NO_FEATURE, "tt", tt, "feature", KB[0..(kk as usize)]);
                    n = raw(o, n, "</p>");
                }
            }
        }
    } else {
        n = raw(o, n, "</div>");
        if (kd == W_FK_PIP) {
            const p0 : usize = FL_PART_LO[0];
            const p1 : usize = FL_PART_HI[0];
            const q0 : usize = FL_PART_LO[1];
            const q1 : usize = FL_PART_HI[1];
            n = pip_words(o, n, line[p0..p1], line[q0..q1], tt);
        } else {
            n = raw(o, n, "<p class=\"lx-w\">");
            n = pf1(o, n, true, SAY_F_UNKNOWN, "tt", tt);
            n = raw(o, n, "</p>");
        }
    }
    return raw(o, n, "</li>");
}

/// A JSON string as escaped text.
fn jtext_to(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    var n : u32 = n0;
    const len : u32 = str_len(d, sp);
    var k : u32 = 0;
    while (k < len) {
        n = put_escaped(o, n, str_byte(d, sp, k));
        k = k + 1;
    }
    return n;
}

/// parseInput over the paste again (the tables are shared with the file reader); false: a capacity was hit.
fn reparse() -> bool {
    if (!parse_input(INPUT[0..(INPUT_N as usize)])) {
        PI_N = 0;
        PI_BAD_N = 0;
        PI_HAS_BITS = false;
        PI_LUT_SET = false;
        return false;
    }
    return true;
}

fn emit_fasm(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<div class=\"lx-block\"><h3 class=\"lx-h\">");
    n = text(o, n, SAY_FASM_TITLE);
    n = raw(o, n, "</h3>");
    const inp : []const u8 = INPUT[0..(INPUT_N as usize)];
    const cnt : usize = PI_N;
    // the tile types of the lines, each once, in order
    var uq : usize = 0;
    var k : usize = 0;
    while (k < cnt) {
        const lo : usize = PI_LO[k];
        const hi : usize = PI_HI[k];
        if (parse_fasm_line(inp[lo..hi])) {
            const a : usize = lo + FL_TILE_LO;
            const b : usize = lo + FL_TYPE_HI;
            var seen : bool = false;
            var j : usize = 0;
            while (j < uq and !seen) {
                if (eq_s(inp[(UQ_LO[j] as usize)..(UQ_HI[j] as usize)], inp[a..b])) { seen = true; }
                j = j + 1;
            }
            if (!seen and uq < 512) {
                UQ_LO[uq] = a as u32;
                UQ_HI[uq] = b as u32;
                uq = uq + 1;
            }
        }
        k = k + 1;
    }
    var j2 : usize = 0;
    while (j2 < uq) {
        n = tile_words(o, n, inp[(UQ_LO[j2] as usize)..(UQ_HI[j2] as usize)]);
        j2 = j2 + 1;
    }
    var items : usize = 0;
    k = 0;
    while (k < cnt) {
        if (PI_KIND[k] != W_FK_BAD_RANGE) { items = items + 1; }
        k = k + 1;
    }
    items = items + PI_BAD_N;
    if (items > 0) {
        n = raw(o, n, "<ul class=\"lx-fls\">");
        k = 0;
        while (k < cnt) {
            if (PI_KIND[k] != W_FK_BAD_RANGE) {
                const lo2 : usize = PI_LO[k];
                const hi2 : usize = PI_HI[k];
                if (parse_fasm_line(inp[lo2..hi2])) {
                    n = emit_item(o, n, inp[lo2..hi2]);
                }
            }
            k = k + 1;
        }
        var bk : usize = 0;
        while (bk < PI_BAD_N) {
            n = raw(o, n, "<li class=\"lx-fl is-bad\">");
            n = fill_named(o, n, SAY_BAD_LINE, "line", inp[PI_BAD_LO[bk]..PI_BAD_HI[bk]], "", "", "", "", "", "", "", "", "", "");
            n = raw(o, n, "</li>");
            bk = bk + 1;
        }
        n = raw(o, n, "</ul>");
    } else {
        n = raw(o, n, "<p class=\"lx-note\">");
        n = text(o, n, SAY_FASM_NONE);
        n = raw(o, n, "</p>");
    }
    return raw(o, n, "</div>");
}

; --- the decode panel --------------------------------------------------------------------------------------
fn btn_mark(a: u32) -> u32 {
    if (BTN_N < 512) { BTN_ACT[BTN_N as usize] = a; }
    BTN_N = BTN_N + 1;
    return 0;
}

/// className(c) of the function the last classify() found, as escaped text.
fn emit_class_name(o: []u8, n0: u32) -> u32 {
    const m : u32 = class_name_cls(W1[0..], 0);
    return text(o, n0, W1[0..(m as usize)]);
}

/// classDetail(c) for the last classify(): the sentence in a dd, or nothing.
fn emit_detail(o: []u8, n0: u32) -> u32 {
    const id : u32 = cls_id();
    var n : u32 = n0;
    var has : bool = false;
    if (id == W_C_BUF or id == W_C_NOT) {
        const m : u32 = pin_to(W2[0..], 0, lowest_set(cls_inputs_mask()));
        n = raw(o, n, "<dt></dt><dd>");
        if (id == W_C_BUF) { n = pf1(o, n, true, SAY_DETAIL_BUF, "pin", W2[0..(m as usize)]); } else { n = pf1(o, n, true, SAY_DETAIL_NOT, "pin", W2[0..(m as usize)]); }
        has = true;
    }
    if (id == W_C_MUX2) {
        const a : u32 = pin_to(W2[0..], 0, cls_sel(0));
        const b : u32 = pin_to(W3[0..], 0, cls_data(0));
        const c : u32 = pin_to(W4[0..], 0, cls_data(1));
        n = raw(o, n, "<dt></dt><dd>");
        n = pf3(o, n, true, SAY_DETAIL_MUX2, "s", W2[0..(a as usize)], "d0", W3[0..(b as usize)], "d1", W4[0..(c as usize)]);
        has = true;
    }
    if (id == W_C_MUX4) {
        const a2 : u32 = pin_to(W2[0..], 0, cls_sel(1));
        const b2 : u32 = pin_to(W3[0..], 0, cls_sel(0));
        var dn : u32 = 0;
        var i : usize = 0;
        while (i < (cls_data_n() as usize)) {
            if (i > 0) { dn = raw(W4[0..], dn, ", "); }
            dn = pin_to(W4[0..], dn, cls_data(i));
            i = i + 1;
        }
        n = raw(o, n, "<dt></dt><dd>");
        n = pf3(o, n, true, SAY_DETAIL_MUX4, "s1", W2[0..(a2 as usize)], "s0", W3[0..(b2 as usize)], "d", W4[0..(dn as usize)]);
        has = true;
    }
    if (id == W_C_CARRY2 or id == W_C_CARRY2X) {
        const pa : u32 = pin_to(W1[0..], 0, cls_data(0));
        const pb : u32 = pin_to(W2[0..], 0, cls_data(1));
        const pc : u32 = pin_to(W3[0..], 0, cls_data(2));
        const pd : u32 = pin_to(W4[0..], 0, cls_data(3));
        const pe : u32 = pin_to(W5[0..], 0, cls_data(4));
        n = raw(o, n, "<dt></dt><dd>");
        n = pf8(o, n, true, SAY_DETAIL_CARRY2, "a", W1[0..(pa as usize)], "b", W2[0..(pb as usize)], "c", W3[0..(pc as usize)], "d", W4[0..(pd as usize)], "e", W5[0..(pe as usize)], "", "", "", "", "", "");
        has = true;
    }
    if (id == W_C_XORWITH or id == W_C_XNORWITH) {
        var ln : u32 = 0;
        var j : usize = 0;
        while (j < (cls_data_n() as usize)) {
            if (j > 0) { ln = raw(W2[0..], ln, ", "); }
            ln = pin_to(W2[0..], ln, cls_data(j));
            j = j + 1;
        }
        n = raw(o, n, "<dt></dt><dd>");
        n = pf1(o, n, true, SAY_DETAIL_LINEAR, "list", W2[0..(ln as usize)]);
        has = true;
    }
    if (has) { n = raw(o, n, "</dd>"); }
    return n;
}

/// expression(terms) over the terms minimize() left, as escaped text.
fn emit_expression(o: []u8, n0: u32, cnt: usize) -> u32 {
    var n : u32 = n0;
    if (cnt == 0) { return text(o, n, SAY_CONST_0); }
    var t : usize = 0;
    while (t < cnt) {
        if (t > 0) { n = text(o, n, SAY_OP_OR); }
        const nl : usize = term_literals(min_value(t), min_dc(t));
        if (nl == 0) {
            n = text(o, n, SAY_CONST_1);
        } else {
            var l : usize = 0;
            while (l < nl) {
                if (l > 0) { n = text(o, n, SAY_OP_AND); }
                if (tl_inverted(l) == 1) { n = text(o, n, SAY_OP_NOT); }
                const m : u32 = pin_to(W6[0..], 0, tl_input(l));
                n = text(o, n, W6[0..(m as usize)]);
                l = l + 1;
            }
        }
        t = t + 1;
    }
    return n;
}

fn fasm_line_to(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, LOC_TILE[0..LOC_TILE_N]);
    n = put(o, n, 46);
    n = raw(o, n, LOC_SITE[0..LOC_SITE_N]);
    n = put(o, n, 46);
    n = put(o, n, LOC_LUT);
    n = raw(o, n, "LUT.INIT[63:0] = 64'b");
    init_bin(BITS);
    var k : usize = 0;
    while (k < OUT_N) {
        n = put(o, n, OUT[k]);
        k = k + 1;
    }
    return n;
}

fn emit_truth(o: []u8, n0: u32, dcmask: u32) -> u32 {
    var n : u32 = raw(o, n0, "<div class=\"lx-table\">");
    var b : u32 = 0;
    while (b < 4) {
        n = raw(o, n, "<div class=\"lx-tb\"><div class=\"lx-tr lx-th\" aria-hidden=\"true\"><span class=\"lx-i\">");
        n = text(o, n, SAY_TABLE_HEAD[0]);
        n = raw(o, n, "</span><span class=\"lx-lv\">");
        n = text(o, n, SAY_TABLE_HEAD[1]);
        n = raw(o, n, "</span><span class=\"lx-o\">");
        n = text(o, n, SAY_TABLE_HEAD[2]);
        n = raw(o, n, "</span></div>");
        var i : u32 = b * 16;
        while (i < b * 16 + 16) {
            btn_mark(100 + i);
            n = raw(o, n, "<button class=\"lx-tr");
            const v : u32 = bit_of(BITS, i);
            if (v == 1) { n = raw(o, n, " is-one"); }
            if (v != bit_of(ORIG, i)) { n = raw(o, n, " is-flipped"); }
            n = raw(o, n, "\" type=\"button\" aria-pressed=\"");
            if (v == 1) { n = raw(o, n, "true"); } else { n = raw(o, n, "false"); }
            n = raw(o, n, "\" data-i=\"");
            n = dnum(o, n, i as u64);
            n = raw(o, n, "\"><span class=\"lx-i\">");
            n = dnum(o, n, i as u64);
            n = raw(o, n, "</span><span class=\"lx-lv\">");
            var q : u32 = 0;
            while (q < 6) {
                if (((dcmask >> (5 - q)) & 1) == 1) { n = raw(o, n, "<span class=\"is-dc\">"); } else { n = raw(o, n, "<span>"); }
                n = dnum(o, n, row_level(i, q) as u64);
                n = raw(o, n, "</span>");
                q = q + 1;
            }
            n = raw(o, n, "</span><span class=\"lx-o\">");
            n = dnum(o, n, v as u64);
            n = raw(o, n, "</span></button>");
            i = i + 1;
        }
        n = raw(o, n, "</div>");
        b = b + 1;
    }
    return raw(o, n, "</div>");
}

/// decodeBits(bits): its four blocks.
fn emit_bits(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    classify(BITS);
    const mask : u32 = cls_inputs_mask();
    const dcmask : u32 = 63 - mask;
    const cid : u32 = cls_id();
    n = raw(o, n, "<div class=\"lx-block\"><dl class=\"lx-facts\"><dt>");
    n = text(o, n, SAY_NAME_LABEL);
    n = raw(o, n, "</dt><dd class=\"lx-name");
    if (cid == W_C_OTHER) { n = raw(o, n, " is-other"); }
    n = raw(o, n, "\">");
    n = emit_class_name(o, n);
    n = raw(o, n, "</dd>");
    n = emit_detail(o, n);
    n = raw(o, n, "<dt>");
    n = text(o, n, SAY_INPUTS_LABEL);
    n = raw(o, n, "</dt><dd>");
    if (mask != 0) {
        const m : u32 = pins_mask(W2[0..], 0, mask);
        n = text(o, n, W2[0..(m as usize)]);
    } else {
        n = text(o, n, SAY_NONE);
    }
    n = raw(o, n, "<span class=\"lx-dc\"> ");
    n = text(o, n, SAY_DONT_CARE);
    n = raw(o, n, ": ");
    if (dcmask != 0) {
        const m2 : u32 = pins_mask(W2[0..], 0, dcmask);
        n = text(o, n, W2[0..(m2 as usize)]);
    } else {
        n = text(o, n, SAY_NONE);
    }
    n = raw(o, n, "</span></dd><dt>");
    n = text(o, n, SAY_INIT_LABEL);
    n = raw(o, n, "</dt><dd class=\"lx-mono lx-init\">");
    n = text(o, n, "64'h");
    init_hex(BITS);
    var k : usize = 0;
    while (k < OUT_N) {
        n = put(o, n, OUT[k]);
        k = k + 1;
    }
    n = raw(o, n, "</dd></dl>");
    const tc : usize = minimize(BITS, 40000);
    const exact : bool = min_exact();
    const good : bool = cover_bits(tc) == BITS;
    var tn : [24]u8 = [0; 24];
    const tl : u32 = dec_to(tn[0..], tc as u64);
    n = raw(o, n, "<p class=\"lx-k\">");
    n = pf1(o, n, true, SAY_EXPR_LABEL, "terms", tn[0..(tl as usize)]);
    n = raw(o, n, "</p><p class=\"lx-expr lx-mono\">");
    n = emit_expression(o, n, tc);
    n = raw(o, n, "</p>");
    if (!exact) {
        n = raw(o, n, "<p class=\"lx-note is-warn\">");
        n = text(o, n, SAY_EXPR_INEXACT);
        n = raw(o, n, "</p>");
    }
    if (good) {
        n = raw(o, n, "<p class=\"lx-note is-ok\">");
        n = text(o, n, SAY_EXPR_CHECK);
        n = raw(o, n, "</p>");
    }
    n = raw(o, n, "</div>");
    // the truth table, the flip note, the undo button
    n = raw(o, n, "<div class=\"lx-block\"><p class=\"lx-k\">");
    n = text(o, n, SAY_TABLE_LABEL);
    n = raw(o, n, "</p>");
    if (FLIPPED >= 0 and LOC_OK) {
        const list : i64 = init_list(loc_type(), loc_site(), LOC_LUT);
        if (list >= 0) {
            const d : []const u8 = pxs();
            const item : i64 = arr_at(d, list, FLIPPED as u32);
            if (item >= 0) {
                const m3 : u32 = jstr_copy(W2[0..], d, item);
                var us : usize = 0;
                while (us < (m3 as usize) and W2[us] != 95) { us = us + 1; }
                const frame : u64 = dec_val(W2[0..us]);
                var bitv : u64 = 0;
                if (us < (m3 as usize)) { bitv = dec_val(W2[(us + 1)..(m3 as usize)]); }
                var ib : [24]u8 = [0; 24];
                var vb : [24]u8 = [0; 24];
                var fb : [24]u8 = [0; 24];
                var bb : [24]u8 = [0; 24];
                const il : u32 = dec_to(ib[0..], FLIPPED as u64);
                const vl : u32 = dec_to(vb[0..], bit_of(BITS, FLIPPED as u32) as u64);
                const fl : u32 = dec_to(fb[0..], frame);
                const bl : u32 = dec_to(bb[0..], bitv);
                var lb : [2]u8 = [0; 2];
                lb[0] = LOC_LUT;
                n = raw(o, n, "<p class=\"lx-note is-gold\" role=\"status\">");
                n = pf8(o, n, true, SAY_FLIPPED, "i", ib[0..(il as usize)], "v", vb[0..(vl as usize)], "frame", fb[0..(fl as usize)], "bit", bb[0..(bl as usize)], "tt", loc_type(), "site", loc_site(), "lut", lb[0..1], "", "");
                n = raw(o, n, "</p>");
            }
        }
    }
    if (BITS != ORIG) {
        btn_mark(30);
        n = raw(o, n, "<button class=\"t27-btn\" type=\"button\">");
        n = text(o, n, SAY_RESET);
        n = raw(o, n, "</button>");
    }
    n = emit_truth(o, n, dcmask);
    n = raw(o, n, "</div>");
    // the rebuilt FASM line
    n = raw(o, n, "<div class=\"lx-block\"><h3 class=\"lx-h\">");
    n = text(o, n, SAY_FASM_REBUILT);
    n = raw(o, n, "</h3><p class=\"lx-mono lx-line\">");
    const fl2 : u32 = fasm_line_to(W1[0..], 0);
    n = text(o, n, W1[0..(fl2 as usize)]);
    n = raw(o, n, "</p>");
    if (ASSUMED) {
        n = raw(o, n, "<p class=\"lx-note\">");
        n = pf1(o, n, true, SAY_LOC_ASSUMED, "loc", K_DEFAULT_LOC);
        n = raw(o, n, "</p>");
    }
    n = raw(o, n, "</div>");
    // the two LUT5 halves
    var lo_name : [512]u8 = [0; 512];
    var hi_name : [512]u8 = [0; 512];
    classify(halves_o5(BITS));
    const lol : u32 = class_name_cls(lo_name[0..], 0);
    classify(halves_o6(BITS));
    const hil : u32 = class_name_cls(hi_name[0..], 0);
    init_hex(BITS);
    n = raw(o, n, "<div class=\"lx-block\"><h3 class=\"lx-h\">");
    n = text(o, n, SAY_HALVES_TITLE);
    n = raw(o, n, "</h3><p class=\"lx-note\">");
    n = text(o, n, SAY_HALVES_BODY);
    n = raw(o, n, "</p><dl class=\"lx-facts\"><dt>");
    n = text(o, n, SAY_HALF_LOW);
    n = raw(o, n, "</dt><dd><span class=\"lx-mono\">32'h");
    k = 8;
    while (k < 16) {
        n = put(o, n, OUT[k]);
        k = k + 1;
    }
    n = raw(o, n, "</span> ");
    n = text(o, n, lo_name[0..(lol as usize)]);
    n = raw(o, n, "</dd><dt>");
    n = text(o, n, SAY_HALF_HIGH);
    n = raw(o, n, "</dt><dd><span class=\"lx-mono\">32'h");
    k = 0;
    while (k < 8) {
        n = put(o, n, OUT[k]);
        k = k + 1;
    }
    n = raw(o, n, "</span> ");
    n = text(o, n, hi_name[0..(hil as usize)]);
    n = raw(o, n, "</dd></dl><p class=\"lx-note\">");
    if (halves_same(BITS)) { n = text(o, n, SAY_HALVES_SAME); } else { n = text(o, n, SAY_HALVES_DIFF); }
    n = raw(o, n, "</p><p class=\"lx-note\">");
    const ds : []const u8 = dss();
    const dr : i64 = root(ds);
    const a1 : u32 = jnum_to(W2[0..], 0, ds, obj_get(ds, dr, "o5Used"));
    const a2 : u32 = jnum_to(W3[0..], 0, ds, obj_get(ds, dr, "luts"));
    n = pf2(o, n, true, SAY_HALVES_DESIGN, "o5", W2[0..(a1 as usize)], "luts", W3[0..(a2 as usize)]);
    return raw(o, n, "</p></div>");
}

/// Number(digits) of a digit string.
fn dec_val(s: []const u8) -> u64 {
    var v : u64 = 0;
    var k : usize = 0;
    while (k < s.len) {
        if (s[k] >= 48 and s[k] <= 57 and v < 100000000000000) { v = v * 10 + ((s[k] - 48) as u64); }
        k = k + 1;
    }
    return v;
}

fn emit_out(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<div class=\"lx-out\">");
    if (DATA_ST != 1) { return raw(o, n, "</div>"); }
    reparse();
    if (!HAS_BITS and PI_N == 0) {
        n = raw(o, n, "<p class=\"lx-note\">");
        n = text(o, n, SAY_NOTHING);
        n = raw(o, n, "</p>");
    }
    if (HAS_BITS) { n = emit_bits(o, n); }
    n = emit_fasm(o, n);
    return raw(o, n, "</div>");
}

; --- readInput, examples, setInput -------------------------------------------------------------------------
fn example_text(i: u32) -> u32 {
    // exampleText(i) into INPUT: the 64'h form of an INIT, or the joined FASM lines.
    var n : u32 = 0;
    if (i < 6) {
        n = raw(INPUT[0..], n, "64'h");
        n = raw(INPUT[0..], n, K_EXAMPLE_INITS[i as usize]);
        return n;
    }
    if (i == 6) {
        var j : usize = 0;
        while (j < 7) {
            if (j > 0) { n = put(INPUT[0..], n, 10); }
            n = raw(INPUT[0..], n, K_EXAMPLE_FASM_CARRY[j]);
            j = j + 1;
        }
        return n;
    }
    var j2 : usize = 0;
    while (j2 < 12) {
        if (j2 > 0) { n = put(INPUT[0..], n, 10); }
        n = raw(INPUT[0..], n, K_EXAMPLE_FASM_FF[j2]);
        j2 = j2 + 1;
    }
    return n;
}

/// readInput(): parse the paste, keep the bits and the place.
fn read_input() -> u32 {
    FLIPPED = -1;
    const okp : bool = reparse();
    if (okp and PI_HAS_BITS) {
        HAS_BITS = true;
        BITS = pi_bits();
        ORIG = BITS;
        ASSUMED = !PI_LUT_SET;
        if (PI_LUT_SET) {
            var k : usize = 0;
            const tl : usize = PI_TILE_HI - PI_TILE_LO;
            while (k < tl and k < 160) {
                LOC_TILE[k] = INPUT[PI_TILE_LO + k];
                k = k + 1;
            }
            LOC_TILE_N = tl;
            LOC_TYPE_N = PI_TYPE_HI - PI_TILE_LO;
            k = 0;
            while (k < 9 and k < PI_SITE_HI - PI_SITE_LO) {
                LOC_SITE[k] = INPUT[PI_SITE_LO + k];
                k = k + 1;
            }
            LOC_SITE_N = PI_SITE_HI - PI_SITE_LO;
            LOC_LUT = PI_LUT;
            LOC_OK = true;
        } else {
            parse_loc(K_DEFAULT_LOC);
        }
    } else {
        HAS_BITS = false;
    }
    return 0;
}

/// setInput(text) when the text is already in INPUT: the examples are all unpressed.
fn set_input(len: u32) -> u32 {
    INPUT_N = len;
    EFF_INPUT = true;
    EX_ON = -1;
    read_input();
    return 0;
}

; --- the reader's own file ---------------------------------------------------------------------------------
fn hash_key(s: []const u8) -> u64 {
    var h : u64 = 7;
    var k : usize = 0;
    while (k < s.len) {
        h = (h * 31 + (s[k] as u64)) % 1000000007;
        k = k + 1;
    }
    return h;
}

/// The LUT whose location text is key: its index, or 0xFFFFFFFF.
fn lut_find(key: []const u8) -> u32 {
    var slot : usize = (hash_key(key) % 16384) as usize;
    var probes : usize = 0;
    while (probes < 16384) {
        const e : u32 = LUT_HT[slot];
        if (e == 0) { return 4294967295; }
        const li : usize = (e - 1) as usize;
        const lo : usize = LUT_LOC_LO[li] as usize;
        if (eq_s(FILE_BUF[lo..(lo + (LUT_LOC_N[li] as usize))], key)) { return li as u32; }
        slot = (slot + 1) % 16384;
        probes = probes + 1;
    }
    return 4294967295;
}

fn lut_insert(key_lo: usize, key_n: usize) -> u32 {
    if (LUT_N >= W_MAX_LUTS) { return 4294967295; }
    const key : []const u8 = FILE_BUF[key_lo..(key_lo + key_n)];
    const f : u32 = lut_find(key);
    if (f != 4294967295) { return f; }
    const li : usize = LUT_N;
    LUT_LOC_LO[li] = key_lo as u32;
    LUT_LOC_N[li] = key_n as u32;
    LUT_NL[li] = 0;
    LUT_N = LUT_N + 1;
    var slot : usize = (hash_key(key) % 16384) as usize;
    while (LUT_HT[slot] != 0) { slot = (slot + 1) % 16384; }
    LUT_HT[slot] = (li + 1) as u32;
    return li as u32;
}

fn lut_add_line(li: u32, lo: usize, hi: usize) -> u32 {
    const c : usize = LUT_NL[li as usize] as usize;
    if (c >= W_LUT_LINES) { return 0; }
    LUT_LO[(li as usize) * W_LUT_LINES + c] = lo as u32;
    LUT_HI[(li as usize) * W_LUT_LINES + c] = hi as u32;
    LUT_NL[li as usize] = (c + 1) as u32;
    return 0;
}

/// A tile name: word characters ending _X<digits>Y<digits>, at least one character before it; the end of it from lo.
fn tile_end(s: []const u8, lo: usize, hi: usize) -> usize {
    var p : usize = lo;
    while (p < hi and is_class(s[p])) { p = p + 1; }
    if (p == lo) { return 0; }
    const te : usize = type_end(s, lo, p);
    if (te == p or te == lo) { return 0; }
    return p;
}

/// /^TILE\.SLICE[LM]_X[01]\.[ABCD]LUT\.INIT\[/ on s[lo..hi): the end of "TILE.SITE.L", or 0.
fn init_line_loc(s: []const u8, lo: usize, hi: usize) -> usize {
    const te : usize = tile_end(s, lo, hi);
    if (te == 0 or te >= hi or s[te] != 46) { return 0; }
    if (te + 1 + 9 > hi or !is_slice_site(s, te + 1, te + 10)) { return 0; }
    if (te + 10 >= hi or s[te + 10] != 46) { return 0; }
    if (te + 11 >= hi or !is_abcd(s[te + 11])) { return 0; }
    if (!lit_is(s, te + 12, "LUT.INIT[")) { return 0; }
    return te + 12;
}

/// /^TILE\.CLBL[LM]_(?:LL|L|M)_[ABCD][1-6]\./ on s[lo..hi): the end of the prefix "CLBLx_yy_", or 0 (the tile end in te).
fn pin_line_prefix(s: []const u8, lo: usize, hi: usize) -> usize {
    const te : usize = tile_end(s, lo, hi);
    if (te == 0 or te >= hi or s[te] != 46) { return 0; }
    const a : usize = te + 1;
    if (a + 8 > hi or !lit_is(s, a, "CLBL")) { return 0; }
    if (s[a + 4] != 76 and s[a + 4] != 77) { return 0; }
    if (s[a + 5] != 95) { return 0; }
    var pl : usize = 0;
    if (a + 9 <= hi and s[a + 6] == 76 and s[a + 7] == 76 and s[a + 8] == 95) { pl = 9; }
    if (pl == 0 and s[a + 6] == 76 and s[a + 7] == 95) { pl = 8; }
    if (pl == 0 and s[a + 6] == 77 and s[a + 7] == 95) { pl = 8; }
    if (pl == 0) { return 0; }
    if (a + pl + 3 > hi) { return 0; }
    if (!is_abcd(s[a + pl])) { return 0; }
    if (s[a + pl + 1] < 49 or s[a + pl + 1] > 54) { return 0; }
    if (s[a + pl + 2] != 46) { return 0; }
    return a + pl;
}

/// The tile type of tile s[lo..te): the name without its _X<digits>Y<digits> tail.
fn tile_type_len(s: []const u8, lo: usize, te: usize) -> usize {
    return type_end(s, lo, te) - lo;
}

fn hist_add(key: []const u8) -> u32 {
    var i : usize = 0;
    while (i < HK_N) {
        if (eq_s(HK[(HK_OFF[i] as usize)..((HK_OFF[i] + HK_LEN[i]) as usize)], key)) {
            HK_CNT[i] = HK_CNT[i] + 1;
            return 0;
        }
        i = i + 1;
    }
    if (HK_N >= W_HIST_MAX or HK_BYTES + key.len > 10240) { return 0; }
    HK_OFF[HK_N] = HK_BYTES as u32;
    HK_LEN[HK_N] = key.len as u32;
    HK_CNT[HK_N] = 1;
    var k : usize = 0;
    while (k < key.len) {
        HK[HK_BYTES + k] = key[k];
        k = k + 1;
    }
    HK_BYTES = HK_BYTES + key.len;
    HK_N = HK_N + 1;
    return 0;
}

/// Does s[a..b) hold the text INIT[ ?
fn has_init_br(s: []const u8, a: usize, b: usize) -> bool {
    var k : usize = a;
    while (k + 5 <= b) {
        if (s[k] == 73 and s[k + 1] == 78 and s[k + 2] == 73 and s[k + 3] == 84 and s[k + 4] == 91) { return true; }
        k = k + 1;
    }
    return false;
}

/// takeFile: read the whole file for its LUTs.
fn take_file(len: u32) -> u32 {
    const s : []const u8 = FILE_BUF[0..(len as usize)];
    FILE_ON = true;
    FILE_IDX = 0;
    FILE_NAMED = 0;
    LUT_N = 0;
    HK_N = 0;
    HK_BYTES = 0;
    var i : usize = 0;
    while (i < 16384) { LUT_HT[i] = 0; i = i + 1; }
    var npin : usize = 0;
    var ls : usize = 0;
    while (ls <= s.len) {
        var le : usize = ls;
        while (le < s.len and s[le] != 10) { le = le + 1; }
        var he : usize = le;
        if (le < s.len and he > ls and s[he - 1] == 13) { he = he - 1; }
        const tp : u64 = trim_pack(s, ls, he);
        const lo : usize = pk_lo(tp);
        const hi : usize = pk_hi(tp);
        if (hi > lo and s[lo] != 35) {
            const ie : usize = init_line_loc(s, lo, hi);
            if (ie > 0) {
                const li : u32 = lut_insert(lo, ie - lo);
                if (li != 4294967295) { lut_add_line(li, lo, hi); }
            } else {
                if (pin_line_prefix(s, lo, hi) > 0 and npin < W_MAX_PINS) {
                    PIN_LO[npin] = lo as u32;
                    PIN_HI[npin] = hi as u32;
                    npin = npin + 1;
                }
            }
        }
        ls = le + 1;
    }
    // the pin lines, each given to its LUT
    var p : usize = 0;
    while (p < npin) {
        const lo2 : usize = PIN_LO[p] as usize;
        const hi2 : usize = PIN_HI[p] as usize;
        const te : usize = tile_end(s, lo2, hi2);
        const pe : usize = pin_line_prefix(s, lo2, hi2);
        const tt : []const u8 = s[lo2..(lo2 + tile_type_len(s, lo2, te))];
        const t : i64 = tile_of(tt);
        if (t >= 0) {
            const d : []const u8 = pxs();
            const sites : i64 = obj_get(d, t, "sites");
            const sn : u32 = arr_len(d, sites);
            var found : bool = false;
            var j : u32 = 0;
            while (j < sn and !found) {
                const sobj : i64 = arr_at(d, sites, j);
                if (jstr_is(d, obj_get(d, sobj, "prefix"), s[(te + 1)..pe])) {
                    found = true;
                    var kn : u32 = raw(KB[0..], 0, s[lo2..te]);
                    kn = put(KB[0..], kn, 46);
                    kn = jfield_to(KB[0..], kn, d, obj_get(d, sobj, "name"));
                    kn = put(KB[0..], kn, 46);
                    kn = put(KB[0..], kn, s[pe]);
                    if (kn != OVER) {
                        const li2 : u32 = lut_find(KB[0..(kn as usize)]);
                        if (li2 != 4294967295) { lut_add_line(li2, lo2, hi2); }
                    }
                }
                j = j + 1;
            }
        }
        p = p + 1;
    }
    // the histogram of what the LUTs are
    var li3 : usize = 0;
    while (li3 < LUT_N) {
        var tn : u32 = 0;
        var c : usize = 0;
        while (c < (LUT_NL[li3] as usize)) {
            const a : usize = LUT_LO[li3 * W_LUT_LINES + c] as usize;
            const b : usize = LUT_HI[li3 * W_LUT_LINES + c] as usize;
            if (has_init_br(s, a, b)) {
                if (tn > 0) { tn = put(LNB[0..], tn, 10); }
                tn = raw(LNB[0..], tn, s[a..b]);
            }
            c = c + 1;
        }
        if (tn != OVER) {
            if (parse_input(LNB[0..(tn as usize)]) and PI_HAS_BITS) {
                classify(pi_bits());
                const kl : usize = class_key();
                var kb : [64]u8 = [0; 64];
                var q : usize = 0;
                while (q < kl) { kb[q] = OUT[q]; q = q + 1; }
                if (!starts_s(kb[0..kl], "other/")) { FILE_NAMED = FILE_NAMED + 1; }
                hist_add(kb[0..kl]);
            }
        }
        li3 = li3 + 1;
    }
    // sorted by count, largest first, ties in the order first met
    var z : usize = 0;
    while (z < HK_N) { HK_ORD[z] = z as u32; z = z + 1; }
    var a2 : usize = 1;
    while (a2 < HK_N) {
        const cur : u32 = HK_ORD[a2];
        var b2 : usize = a2;
        while (b2 > 0 and HK_CNT[HK_ORD[b2 - 1] as usize] < HK_CNT[cur as usize]) {
            HK_ORD[b2] = HK_ORD[b2 - 1];
            b2 = b2 - 1;
        }
        HK_ORD[b2] = cur;
        a2 = a2 + 1;
    }
    return 0;
}

/// showFileLut(i): the LUT number i (wrapping), its lines into the paste box.
fn show_file_lut(i: i64) -> u32 {
    if (LUT_N == 0) { return 0; }
    var idx : i64 = i;
    const total : i64 = LUT_N as i64;
    idx = ((idx % total) + total) % total;
    FILE_IDX = idx as u32;
    const li : usize = idx as usize;
    var n : u32 = 0;
    var c : usize = 0;
    while (c < (LUT_NL[li] as usize)) {
        if (c > 0) { n = put(INPUT[0..], n, 10); }
        n = raw(INPUT[0..], n, FILE_BUF[(LUT_LO[li * W_LUT_LINES + c] as usize)..(LUT_HI[li * W_LUT_LINES + c] as usize)]);
        c = c + 1;
    }
    if (n == OVER) { n = 0; }
    set_input(n);
    return 0;
}

; --- the game ------------------------------------------------------------------------------------------------
fn rnd_next() -> f64 {
    var x : u64 = RNG;
    x = x ^ ((x << 13) & 4294967295);
    x = x ^ (x >> 17);
    x = x ^ ((x << 5) & 4294967295);
    RNG = x;
    return (x as f64) / 4294967296.0;
}

/// Math.floor(Math.random() * m)
fn rnd_below(m: u32) -> u32 {
    return (rnd_next() * (m as f64)) as u32;
}

pub var POOL : [512]u32 = [0; 512];

/// The sort of shuffle(): Fisher-Yates from the end, over POOL[0..n).
fn shuffle_pool(n: usize) -> u32 {
    var i : usize = n;
    while (i > 1) {
        i = i - 1;
        const j : usize = rnd_below((i + 1) as u32) as usize;
        const t : u32 = POOL[i];
        POOL[i] = POOL[j];
        POOL[j] = t;
    }
    return 0;
}

fn eq_low(s: []const u8, w: []const u8) -> bool {
    if (s.len != w.len) { return false; }
    var k : usize = 0;
    while (k < s.len) {
        var want : u8 = w[k];
        if (want >= 65 and want <= 90) { want = want + 32; }
        if (s[k] != want) { return false; }
        k = k + 1;
    }
    return true;
}

/// The named classes of the design's histogram (keys that do not start "other/"), in order.
fn build_named() -> u32 {
    NM_N = 0;
    const d : []const u8 = dss();
    const hist : i64 = obj_get(d, root(d), "hist");
    const hn : u32 = arr_len(d, hist);
    var i : u32 = 0;
    var off : u32 = 0;
    while (i < hn and NM_N < 128) {
        const e : i64 = arr_at(d, hist, i);
        const ks : i64 = arr_at(d, e, 0);
        const kl : u32 = str_len(d, ks);
        if (kind(d, ks) == J_STRING and off + kl <= 16384) {
            var k : u32 = 0;
            while (k < kl) {
                NM_TXT[(off + k) as usize] = str_byte(d, ks, k);
                k = k + 1;
            }
            const key : []const u8 = NM_TXT[(off as usize)..((off + kl) as usize)];
            if (!starts_s(key, "other/")) {
                var p : usize = 0;
                while (p < key.len and key[p] != 47) { p = p + 1; }
                var idv : u32 = 255;
                var w : u32 = 0;
                while (w < 21) {
                    if (eq_low(key[0..p], id_name(w))) { idv = w; }
                    w = w + 1;
                }
                NM_ID[NM_N] = idv;
                var nv : i64 = W_NAN_V;
                if (p < key.len) {
                    var q : usize = p + 1;
                    while (q < key.len and key[q] != 47) { q = q + 1; }
                    nv = num_part(key, p + 1, q, true);
                }
                NM_NUM[NM_N] = nv;
                NM_OFF[NM_N] = off;
                NM_LEN[NM_N] = kl;
                NM_N = NM_N + 1;
                off = off + kl;
            }
        }
        i = i + 1;
    }
    return 0;
}

/// Is the label in the text w (length wl) already among the first cnt labels of round r?
fn label_seen(r: usize, cnt: usize, w: []const u8) -> bool {
    var j : usize = 0;
    while (j < cnt) {
        const base : usize = (r * 5 + j) * 256;
        const ln : usize = G_LEN[r * 5 + j] as usize;
        if (eq_s(G_TXT[base..(base + ln)], w)) { return true; }
        j = j + 1;
    }
    return false;
}

fn label_set(r: usize, j: usize, w: []const u8) -> u32 {
    const base : usize = (r * 5 + j) * 256;
    var k : usize = 0;
    while (k < w.len and k < 256) {
        G_TXT[base + k] = w[k];
        k = k + 1;
    }
    G_LEN[r * 5 + j] = k as u32;
    return 0;
}

/// tryAdd(cands, upTo) for round r with the candidates CAND[0..m): shuffle a copy, then add the new names.
fn try_add(r: usize, m: usize, up_to: usize) -> u32 {
    // the shuffle consumes the same random numbers whatever happens next
    var i : usize = m;
    while (i > 1) {
        i = i - 1;
        const j : usize = rnd_below((i + 1) as u32) as usize;
        const t : u32 = CAND[i];
        CAND[i] = CAND[j];
        CAND[j] = t;
    }
    var x : usize = 0;
    while (x < m) {
        if ((G_NL[r] as usize) >= up_to) { return 0; }
        const ci : usize = CAND[x] as usize;
        const off : usize = NM_OFF[ci] as usize;
        const nm : u32 = class_name_key(W7[0..], 0, NM_TXT[off..(off + (NM_LEN[ci] as usize))]);
        if (!label_seen(r, G_NL[r] as usize, W7[0..(nm as usize)])) {
            if (G_NL[r] < 5) {
                label_set(r, G_NL[r] as usize, W7[0..(nm as usize)]);
                G_NL[r] = G_NL[r] + 1;
            }
        }
        x = x + 1;
    }
    return 0;
}

/// newGame()
fn new_game() -> u32 {
    const d : []const u8 = dss();
    const rounds : i64 = obj_get(d, root(d), "rounds");
    var rn : usize = arr_len(d, rounds) as usize;
    if (rn > 512) { rn = 512; }
    var i : usize = 0;
    while (i < rn) { POOL[i] = i as u32; i = i + 1; }
    shuffle_pool(rn);
    var pick : usize = K_GAME_ROUNDS as usize;
    if (pick > rn) { pick = rn; }
    build_named();
    var r : usize = 0;
    while (r < pick) {
        G_IDX[r] = POOL[r];
        const item : i64 = arr_at(d, rounds, POOL[r]);
        const init : i64 = obj_get(d, item, "init");
        const il : u32 = jstr_copy(W1[0..], d, init);
        // BigInt('0x' + init) as 64 bits: the last 16 hex digits
        var bits : u64 = 0;
        var from : usize = 0;
        if (il > 16) { from = (il as usize) - 16; }
        var h : usize = from;
        while (h < (il as usize)) {
            bits = bits * 16 + (hexv(W1[h]) as u64);
            h = h + 1;
        }
        G_BITS[r] = bits;
        classify(bits);
        const cid : u32 = cls_id();
        const cn : u32 = cls_n();
        const an : u32 = class_name_cls(W2[0..], 0);
        G_NL[r] = 0;
        label_set(r, 0, W2[0..(an as usize)]);
        G_NL[r] = 1;
        // one near miss in the same family, one with the same number of inputs, the rest from anywhere
        var m : usize = 0;
        var q : usize = 0;
        while (q < NM_N) {
            if (NM_ID[q] == cid) { CAND[m] = q as u32; m = m + 1; }
            q = q + 1;
        }
        try_add(r, m, 2);
        m = 0;
        q = 0;
        while (q < NM_N) {
            if (NM_NUM[q] == (cn as i64) and NM_ID[q] != cid) { CAND[m] = q as u32; m = m + 1; }
            q = q + 1;
        }
        try_add(r, m, 3);
        m = 0;
        q = 0;
        while (q < NM_N) { CAND[m] = q as u32; m = m + 1; q = q + 1; }
        try_add(r, m, K_GAME_CHOICES as usize);
        // labels: shuffle(out)
        var o : usize = 0;
        while (o < 5) { G_ORD[r * 5 + o] = o as u32; o = o + 1; }
        var z : usize = G_NL[r] as usize;
        while (z > 1) {
            z = z - 1;
            const j : usize = rnd_below((z + 1) as u32) as usize;
            const t : u32 = G_ORD[r * 5 + z];
            G_ORD[r * 5 + z] = G_ORD[r * 5 + j];
            G_ORD[r * 5 + j] = t;
        }
        r = r + 1;
    }
    G_N = pick as u32;
    G_AT = 0;
    G_RIGHT = 0;
    G_PICK = -1;
    GAME_ON = true;
    return 0;
}

fn emit_game_sample(o: []u8, n0: u32) -> u32 {
    const d : []const u8 = dss();
    const dr : i64 = root(d);
    var n : u32 = raw(o, n0, "<p class=\"lx-note lx-sub\">");
    const rounds : i64 = obj_get(d, dr, "rounds");
    const a : u32 = fnum(W1[0..], 0, arr_len(d, rounds) as f64);
    var per : [8]u8 = [0; 8];
    const pl : u32 = dec_to(per[0..], K_ROUNDS_PER_CLASS as u64);
    const ot : u32 = fnum(W3[0..], 0, num_f64(d, obj_get(d, dr, "luts")) - num_f64(d, obj_get(d, dr, "named")));
    n = pf3(o, n, true, SAY_GAME_SAMPLE, "pool", W1[0..(a as usize)], "per", per[0..(pl as usize)], "other", W3[0..(ot as usize)]);
    return raw(o, n, "</p>");
}

fn emit_game(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<div class=\"lx-game\">");
    if (!GAME_ON) { return raw(o, n, "</div>"); }
    var sc : [24]u8 = [0; 24];
    var s2 : [24]u8 = [0; 24];
    var s3 : [24]u8 = [0; 24];
    if (G_AT >= G_N) {
        const l1 : u32 = dec_to(sc[0..], G_RIGHT as u64);
        const l2 : u32 = dec_to(s2[0..], G_N as u64);
        n = raw(o, n, "<p class=\"lx-score\">");
        n = pf2(o, n, true, SAY_GAME_DONE, "right", sc[0..(l1 as usize)], "rounds", s2[0..(l2 as usize)]);
        n = raw(o, n, "</p>");
        btn_mark(302);
        n = raw(o, n, "<button class=\"t27-btn\" type=\"button\">");
        n = text(o, n, SAY_GAME_AGAIN);
        n = raw(o, n, "</button>");
        n = emit_game_sample(o, n);
        return raw(o, n, "</div>");
    }
    const r : usize = G_AT as usize;
    const answered : bool = G_PICK >= 0;
    const l1 : u32 = dec_to(sc[0..], (G_AT + 1) as u64);
    const l2 : u32 = dec_to(s2[0..], G_N as u64);
    const l3 : u32 = dec_to(s3[0..], G_RIGHT as u64);
    n = raw(o, n, "<p class=\"lx-score\">");
    n = pf3(o, n, true, SAY_GAME_SCORE, "round", sc[0..(l1 as usize)], "rounds", s2[0..(l2 as usize)], "right", s3[0..(l3 as usize)]);
    n = raw(o, n, "</p><p class=\"lx-mono lx-init lx-big\">64'h");
    const d : []const u8 = dss();
    const item : i64 = arr_at(d, obj_get(d, root(d), "rounds"), G_IDX[r]);
    n = jtext_to(o, n, d, obj_get(d, item, "init"));
    n = raw(o, n, "</p><p class=\"lx-note lx-mono\">");
    const lc : u32 = jstr_copy(W4[0..], d, obj_get(d, item, "loc"));
    n = pf1(o, n, true, SAY_GAME_LOC, "loc", W4[0..(lc as usize)]);
    n = raw(o, n, "</p><div class=\"lx-grid\" aria-hidden=\"true\">");
    var b : u32 = 64;
    while (b > 0) {
        b = b - 1;
        if (bit_of(G_BITS[r], b) == 1) { n = raw(o, n, "<span class=\"is-one\"></span>"); } else { n = raw(o, n, "<span></span>"); }
    }
    n = raw(o, n, "</div><div class=\"lx-choices\">");
    var k : usize = 0;
    while (k < (G_NL[r] as usize)) {
        const slot : usize = G_ORD[r * 5 + k] as usize;
        btn_mark(200 + (k as u32));
        n = raw(o, n, "<button class=\"t27-btn lx-choice");
        if (answered and slot == 0) { n = raw(o, n, " is-right"); }
        if (answered and (k as i32) == G_PICK and slot != 0) { n = raw(o, n, " is-wrong"); }
        n = raw(o, n, "\" type=\"button\" aria-pressed=\"");
        if ((k as i32) == G_PICK) { n = raw(o, n, "true"); } else { n = raw(o, n, "false"); }
        n = raw(o, n, "\"");
        if (answered) { n = raw(o, n, " disabled=\"\""); }
        n = raw(o, n, ">");
        const base : usize = (r * 5 + slot) * 256;
        n = text(o, n, G_TXT[base..(base + (G_LEN[r * 5 + slot] as usize))]);
        n = raw(o, n, "</button>");
        k = k + 1;
    }
    n = raw(o, n, "</div>");
    if (answered) {
        const pslot : usize = G_ORD[r * 5 + (G_PICK as usize)] as usize;
        if (pslot == 0) {
            n = raw(o, n, "<p class=\"lx-verdict is-ok\" role=\"status\">");
            n = text(o, n, SAY_GAME_RIGHT);
        } else {
            n = raw(o, n, "<p class=\"lx-verdict is-bad\" role=\"status\">");
            const base0 : usize = (r * 5) * 256;
            n = pf1(o, n, true, SAY_GAME_WRONG, "answer", G_TXT[base0..(base0 + (G_LEN[r * 5] as usize))]);
        }
        n = raw(o, n, "</p><div class=\"lx-row\">");
        btn_mark(300);
        n = raw(o, n, "<button class=\"t27-btn\" type=\"button\">");
        n = text(o, n, SAY_GAME_NEXT);
        n = raw(o, n, "</button>");
        btn_mark(301);
        n = raw(o, n, "<button class=\"t27-btn\" type=\"button\">");
        n = text(o, n, SAY_GAME_OPEN);
        n = raw(o, n, "</button></div>");
    }
    n = emit_game_sample(o, n);
    return raw(o, n, "</div>");
}

/// openInDecoder(r): the round's LUT as a FASM line when its place parses, else as 64'h...
fn open_in_decoder() -> u32 {
    const r : usize = G_AT as usize;
    const d : []const u8 = dss();
    const item : i64 = arr_at(d, obj_get(d, root(d), "rounds"), G_IDX[r]);
    const lc : u32 = jstr_copy(W4[0..], d, obj_get(d, item, "loc"));
    var n : u32 = 0;
    if (loc_valid(W4[0..(lc as usize)])) {
        n = raw(INPUT[0..], n, W4[0..(lc as usize)]);
        n = raw(INPUT[0..], n, "LUT.INIT[63:0] = 64'b");
        init_bin(G_BITS[r]);
        var k : usize = 0;
        while (k < OUT_N) {
            n = put(INPUT[0..], n, OUT[k]);
            k = k + 1;
        }
    } else {
        n = raw(INPUT[0..], n, "64'h");
        n = jfield_to(INPUT[0..], n, d, obj_get(d, item, "init"));
    }
    if (n == OVER) { n = 0; }
    set_input(n);
    TAB = 0;
    return 0;
}

; --- our design ----------------------------------------------------------------------------------------------
/// (100 * n / max).toFixed(1): the digits of round-half-up of ten times the double's exact value.
fn fixed1(o: []u8, n0: u32, x: f64) -> u32 {
    if (x != x) { return raw(o, n0, "NaN"); }
    if (x > 1.0e15) { return raw(o, n0, "Infinity"); }
    var m : f64 = x;
    var k : u32 = 0;
    while (m != ((m as u64) as f64) and k < 80) {
        m = m * 2.0;
        k = k + 1;
    }
    var v : u64 = 0;
    if (k <= 62) {
        const t : u64 = (m as u64) * 10;
        if (k == 0) { v = t; } else { v = (t + ((1 as u64) << (k - 1))) >> k; }
    }
    var n : u32 = dnum(o, n0, v / 10);
    n = put(o, n, 46);
    return dnum(o, n, v % 10);
}

fn hist_len(mode: u32) -> u32 {
    if (mode == 0) {
        const d : []const u8 = dss();
        return arr_len(d, obj_get(d, root(d), "hist"));
    }
    return HK_N as u32;
}

/// Entry i of the histogram: its key as plain text into KB; the length. Its count in HCOUNT.
pub var HCOUNT : f64 = 0.0;

fn hist_entry(mode: u32, i: u32) -> u32 {
    if (mode == 0) {
        const d : []const u8 = dss();
        const e : i64 = arr_at(d, obj_get(d, root(d), "hist"), i);
        HCOUNT = num_f64(d, arr_at(d, e, 1));
        return jstr_copy(KB[0..], d, arr_at(d, e, 0));
    }
    const ix : usize = HK_ORD[i as usize] as usize;
    HCOUNT = HK_CNT[ix] as f64;
    return raw(KB[0..], 0, HK[(HK_OFF[ix] as usize)..((HK_OFF[ix] + HK_LEN[ix]) as usize)]);
}

fn bar_row(o: []u8, n0: u32, label: []const u8, cnt: f64, cls: []const u8, maxv: f64, total: f64) -> u32 {
    var n : u32 = raw(o, n0, "<li class=\"lx-bar ");
    n = raw(o, n, cls);
    n = raw(o, n, "\"><span class=\"lx-bl\"");
    n = attr(o, n, "title", label);
    n = raw(o, n, ">");
    n = text(o, n, label);
    n = raw(o, n, "</span><span class=\"lx-bt\"><span class=\"lx-bf\" style=\"width:");
    n = fixed1(o, n, (100.0 * cnt) / maxv);
    n = raw(o, n, "%\"></span></span><span class=\"lx-bn\">");
    n = fnum(o, n, cnt);
    n = raw(o, n, "  ");
    n = fixed1(o, n, (100.0 * cnt) / total);
    return raw(o, n, "%</span></li>");
}

fn emit_bars(o: []u8, n0: u32, mode: u32, total: f64) -> u32 {
    var n : u32 = raw(o, n0, "<ul class=\"lx-bars\">");
    const len : u32 = hist_len(mode);
    var shown : u32 = len;
    if (shown > (K_HIST_SHOWN as u32)) { shown = K_HIST_SHOWN as u32; }
    var maxv : f64 = 1.0;
    var i : u32 = 0;
    while (i < shown) {
        hist_entry(mode, i);
        if (HCOUNT > maxv) { maxv = HCOUNT; }
        i = i + 1;
    }
    i = 0;
    while (i < shown) {
        const kl : u32 = hist_entry(mode, i);
        const cnt : f64 = HCOUNT;
        const key : []const u8 = KB[0..(kl as usize)];
        const nm : u32 = class_name_key(W5[0..], 0, key);
        var cls : []const u8 = "";
        if (starts_s(key, "other/")) {
            cls = "is-other";
        } else {
            if (starts_s(key, "xor/") or starts_s(key, "xnor/")) { cls = "is-xor"; }
        }
        n = bar_row(o, n, W5[0..(nm as usize)], cnt, cls, maxv, total);
        i = i + 1;
    }
    if (len > shown) {
        var rest : f64 = 0.0;
        i = shown;
        while (i < len) {
            hist_entry(mode, i);
            rest = rest + HCOUNT;
            i = i + 1;
        }
        var kn : [24]u8 = [0; 24];
        const kl2 : u32 = dec_to(kn[0..], (len - shown) as u64);
        const rl : u32 = pf1(W6[0..], 0, false, SAY_HIST_REST, "kinds", kn[0..(kl2 as usize)]);
        n = bar_row(o, n, W6[0..(rl as usize)], rest, "is-rest", maxv, total);
    }
    return raw(o, n, "</ul>");
}

/// renderDesign(): the box is cached, tool.js draws it when its tab opens or a file is read on that tab.
fn render_design() -> u32 {
    if (DATA_ST != 1) { return 0; }
    const d : []const u8 = dss();
    const dr : i64 = root(d);
    const src : i64 = obj_get(d, dr, "source");
    const tools : i64 = obj_get(d, src, "tools");
    const o : []u8 = DESIGN_HTML[0..];
    var n : u32 = raw(o, 0, "<h3 class=\"lx-h\">");
    n = text(o, n, SAY_HIST_TITLE);
    n = raw(o, n, "</h3><p class=\"lx-note\">");
    const luts : f64 = num_f64(d, obj_get(d, dr, "luts"));
    const named : f64 = num_f64(d, obj_get(d, dr, "named"));
    const a1 : u32 = jnum_to(W1[0..], 0, d, obj_get(d, dr, "luts"));
    const a2 : u32 = jnum_to(W2[0..], 0, d, obj_get(d, dr, "distinct"));
    const a3 : u32 = jstr_copy(W3[0..], d, obj_get(d, src, "part"));
    const a4 : u32 = jnum_to(W4[0..], 0, d, obj_get(d, dr, "named"));
    const a5 : u32 = fnum(W5[0..], 0, luts - named);
    n = pf8(o, n, true, SAY_HIST_INTRO, "luts", W1[0..(a1 as usize)], "distinct", W2[0..(a2 as usize)], "part", W3[0..(a3 as usize)], "named", W4[0..(a4 as usize)], "other", W5[0..(a5 as usize)], "", "", "", "", "", "");
    n = raw(o, n, "</p>");
    if (FILE_ON) {
        n = raw(o, n, "<p class=\"lx-k\">");
        n = text(o, n, SAY_HIST_OURS);
        n = raw(o, n, "</p>");
    }
    n = emit_bars(o, n, 0, luts);
    if (FILE_ON) {
        n = raw(o, n, "<p class=\"lx-k\">");
        n = text(o, n, SAY_HIST_YOURS);
        n = raw(o, n, "</p><p class=\"lx-note\">");
        const b1 : u32 = fnum(W1[0..], 0, LUT_N as f64);
        const b2 : u32 = fnum(W2[0..], 0, FILE_NAMED as f64);
        n = pf3(o, n, true, SAY_YOUR_FILE, "name", FILE_NAME[0..FILE_NAME_N], "luts", W1[0..(b1 as usize)], "named", W2[0..(b2 as usize)]);
        n = raw(o, n, "</p>");
        var total : f64 = LUT_N as f64;
        if (total < 1.0) { total = 1.0; }
        n = emit_bars(o, n, 1, total);
    }
    n = raw(o, n, "<ul class=\"lx-factlist\"><li>");
    const c1 : u32 = jnum_to(W1[0..], 0, d, obj_get(d, dr, "pinsAgree"));
    const c2 : u32 = jnum_to(W2[0..], 0, d, obj_get(d, dr, "luts"));
    n = pf2(o, n, true, SAY_FACT_PINS, "agree", W1[0..(c1 as usize)], "luts", W2[0..(c2 as usize)]);
    n = raw(o, n, "</li><li>");
    const e1 : u32 = jnum_to(W1[0..], 0, d, obj_get(d, dr, "o5Used"));
    const e2 : u32 = jnum_to(W2[0..], 0, d, obj_get(d, dr, "ramSrl"));
    n = pf2(o, n, true, SAY_FACT_O5, "o5", W1[0..(e1 as usize)], "ram", W2[0..(e2 as usize)]);
    n = raw(o, n, "</li><li>");
    const g1 : u32 = jnum_to(W1[0..], 0, d, obj_get(d, dr, "inexact"));
    const g2 : u32 = jnum_to(W2[0..], 0, d, obj_get(d, dr, "maxTerms"));
    n = pf2(o, n, true, SAY_FACT_QM, "inexact", W1[0..(g1 as usize)], "terms", W2[0..(g2 as usize)]);
    n = raw(o, n, "</li><li>");
    // yosys: the text before " (" ; prjxray: the first word
    const y1 : u32 = jstr_copy(W1[0..], d, obj_get(d, tools, "yosys"));
    var ycut : usize = 0;
    while (ycut < (y1 as usize) and W1[ycut] != 40) { ycut = ycut + 1; }
    var ye : usize = ycut;
    while (ye > 0 and (W1[ye - 1] == 32 or (W1[ye - 1] >= 9 and W1[ye - 1] <= 13))) { ye = ye - 1; }
    const y2 : u32 = jstr_copy(W2[0..], d, obj_get(d, src, "yosys"));
    const y3 : u32 = jstr_copy(W3[0..], d, obj_get(d, tools, "nextpnr"));
    const y4 : u32 = jstr_copy(W4[0..], d, obj_get(d, tools, "prjxray"));
    var y4e : usize = 0;
    while (y4e < (y4 as usize) and W4[y4e] != 32) { y4e = y4e + 1; }
    const y5 : u32 = jstr_copy(W5[0..], d, obj_get(d, tools, "db"));
    n = pf8(o, n, true, SAY_FACT_TOOLS, "yosys", W1[0..ye], "ycmd", W2[0..(y2 as usize)], "nextpnr", W3[0..(y3 as usize)], "prjxray", W4[0..y4e], "db", W5[0..(y5 as usize)], "", "", "", "", "", "");
    n = raw(o, n, "</li><li>");
    n = text(o, n, SAY_LIMITS);
    n = raw(o, n, "</li></ul>");
    if (n == OVER) { n = 0; }
    DESIGN_N = n;
    return 0;
}

; --- events -----------------------------------------------------------------------------------------------------
fn show_tab(i: u32) -> u32 {
    TAB = i;
    if (i == 1 and !GAME_ON and DATA_ST == 1) { new_game(); }
    if (i == 2) { render_design(); }
    return 0;
}

/// start(): both data files are in.
fn start_page() -> u32 {
    DATA_ST = 1;
    EX_ON = 6;
    const n : u32 = example_text(6);
    INPUT_N = n;
    EFF_INPUT = true;
    read_input();
    return 0;
}

pub fn w_init(h: []const u8) -> u32 {
    PX_N = 0;
    DS_N = 0;
    PX_ST = 0;
    DS_ST = 0;
    DATA_ST = 0;
    FAIL_FILE = 0;
    TAB = 0;
    EX_ON = -1;
    DRAGGING = false;
    EFF_INPUT = false;
    HAS_BITS = false;
    BITS = 0;
    ORIG = 0;
    FLIPPED = -1;
    ASSUMED = false;
    INPUT_N = 0;
    LOC_OK = false;
    GAME_ON = false;
    G_N = 0;
    G_AT = 0;
    G_RIGHT = 0;
    G_PICK = -1;
    FILE_ON = false;
    FILE_NAME_N = 0;
    FILE_N = 0;
    LUT_N = 0;
    HK_N = 0;
    DESIGN_N = 0;
    PI_N = 0;
    PI_BAD_N = 0;
    PI_HAS_BITS = false;
    PI_LUT_SET = false;
    parse_loc(K_DEFAULT_LOC);
    return 0;
}

pub fn w_seed(s: u32) -> u32 {
    RNG = s as u64;
    if (RNG == 0) { RNG = 1; }
    return 0;
}

fn data_ready() -> u32 {
    if (PX_ST == 1 and DS_ST == 1) { start_page(); }
    return 0;
}

pub fn w_data(i: u32, s: []const u8) -> u32 {
    EFF_INPUT = false;
    if (DATA_ST != 0) { return 0; }
    var ok_data : bool = s.len <= (W_DATA_CAP as usize);
    if (ok_data) {
        if (i == 0) {
            var k : usize = 0;
            while (k < s.len) { PXD[k] = s[k]; k = k + 1; }
            PX_N = s.len as u32;
            ok_data = kind(PXD[0..(PX_N as usize)], root(PXD[0..(PX_N as usize)])) == J_OBJECT;
        } else {
            var k2 : usize = 0;
            while (k2 < s.len) { DSD[k2] = s[k2]; k2 = k2 + 1; }
            DS_N = s.len as u32;
            ok_data = kind(DSD[0..(DS_N as usize)], root(DSD[0..(DS_N as usize)])) == J_OBJECT;
        }
    }
    if (!ok_data) { return w_data_failed(i); }
    if (i == 0) { PX_ST = 1; } else { DS_ST = 1; }
    data_ready();
    return 0;
}

pub fn w_data_failed(i: u32) -> u32 {
    EFF_INPUT = false;
    if (DATA_ST != 0) { return 0; }
    DATA_ST = 2;
    FAIL_FILE = i;
    return 0;
}

pub fn w_input(i: u32, s: []const u8) -> u32 {
    EFF_INPUT = false;
    if (i != 0) { return 0; }
    var n : usize = s.len;
    if (n > (W_IN_CAP as usize)) { n = W_IN_CAP as usize; }
    var k : usize = 0;
    while (k < n) { INPUT[k] = s[k]; k = k + 1; }
    INPUT_N = n as u32;
    read_input();
    return 0;
}

pub fn w_press(i: u32) -> u32 {
    EFF_INPUT = false;
    if (i >= BTN_N or i >= 512) { return 0; }
    const a : u32 = BTN_ACT[i as usize];
    if (a < 3) { show_tab(a); }
    if (a >= 10 and a < 18) {
        const n : u32 = example_text(a - 10);
        set_input(n);
        EX_ON = (a - 10) as i32;
    }
    if (a == 20) { show_file_lut((FILE_IDX as i64) - 1); }
    if (a == 21) { show_file_lut((FILE_IDX as i64) + 1); }
    if (a == 30) {
        BITS = ORIG;
        FLIPPED = -1;
    }
    if (a >= 100 and a < 164) {
        BITS = BITS ^ ((1 as u64) << (a - 100));
        FLIPPED = (a - 100) as i32;
    }
    if (a >= 200 and a < 205) {
        if (G_PICK < 0 and GAME_ON) {
            G_PICK = (a - 200) as i32;
            if (G_ORD[(G_AT as usize) * 5 + ((a - 200) as usize)] == 0) { G_RIGHT = G_RIGHT + 1; }
        }
    }
    if (a == 300) {
        G_AT = G_AT + 1;
        G_PICK = -1;
    }
    if (a == 301) { open_in_decoder(); }
    if (a == 302) { new_game(); }
    return 0;
}

pub fn w_file(z: u32, name: []const u8, size: u32) -> u32 {
    EFF_INPUT = false;
    if (size > W_FILE_CAP) { return 0; }
    var n : usize = name.len;
    if (n > 1000) { n = 1000; }
    var k : usize = 0;
    while (k < n) { FILE_NAME[k] = name[k]; k = k + 1; }
    FILE_NAME_N = n;
    return 1;
}

pub fn w_file_data(z: u32, s: []const u8) -> u32 {
    EFF_INPUT = false;
    const from : usize = bom_skip(s);
    if (s.len - from > (W_FILE_CAP as usize)) { return 0; }
    var k : usize = from;
    while (k < s.len) { FILE_BUF[k - from] = s[k]; k = k + 1; }
    FILE_N = (s.len - from) as u32;
    take_file(FILE_N);
    show_file_lut(0);
    if (TAB == 2) { render_design(); }
    return 0;
}

pub fn w_file_failed(z: u32) -> u32 {
    EFF_INPUT = false;
    return 0;
}

pub fn w_drag(z: u32, over: u32) -> u32 {
    EFF_INPUT = false;
    const want : bool = over != 0;
    if (want == DRAGGING) { return 0; }
    DRAGGING = want;
    return 1;
}

/// The offset after a leading byte order mark, which FileReader.readAsText drops.
fn bom_skip(s: []const u8) -> usize {
    if (s.len >= 3 and s[0] == 239 and s[1] == 187 and s[2] == 191) { return 3; }
    return 0;
}

/// Effects after the last event: the paste box takes the text the page put in INPUT.
pub fn w_effect(k: u32, dst: []u8) -> u32 {
    if (EFF_INPUT and k == 0) {
        if (((INPUT_N + 2) as usize) > dst.len) { return 0; }
        dst[0] = 118;
        dst[1] = 0;
        var i : usize = 0;
        while (i < (INPUT_N as usize)) {
            dst[2 + i] = INPUT[i];
            i = i + 1;
        }
        return INPUT_N + 2;
    }
    return 0;
}

; --- the page ---------------------------------------------------------------------------------------------------------
fn emit_fileline(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<div class=\"lx-fileline\"");
    if (!FILE_ON) { return raw(o, n, " hidden=\"\"></div>"); }
    n = raw(o, n, "><p class=\"lx-note\">");
    var b1 : [24]u8 = [0; 24];
    var b2 : [24]u8 = [0; 24];
    if (LUT_N == 0) {
        n = pf8(o, n, true, SAY_FILE_LUTS, "name", FILE_NAME[0..FILE_NAME_N], "n", "0", "i", "0", "loc", "", "", "", "", "", "", "", "", "");
        return raw(o, n, "</p></div>");
    }
    const l1 : u32 = fnum(b1[0..], 0, LUT_N as f64);
    const l2 : u32 = fnum(b2[0..], 0, (FILE_IDX + 1) as f64);
    const li : usize = FILE_IDX as usize;
    const loc : []const u8 = FILE_BUF[(LUT_LOC_LO[li] as usize)..((LUT_LOC_LO[li] + LUT_LOC_N[li]) as usize)];
    n = pf8(o, n, true, SAY_FILE_LUTS, "name", FILE_NAME[0..FILE_NAME_N], "n", b1[0..(l1 as usize)], "i", b2[0..(l2 as usize)], "loc", loc, "", "", "", "", "", "", "", "");
    n = raw(o, n, "</p><div class=\"lx-row\">");
    btn_mark(20);
    n = raw(o, n, "<button class=\"t27-btn\" type=\"button\">");
    n = text(o, n, SAY_PREV);
    n = raw(o, n, "</button>");
    btn_mark(21);
    n = raw(o, n, "<button class=\"t27-btn\" type=\"button\">");
    n = text(o, n, SAY_NEXT);
    n = raw(o, n, "</button></div></div>");
    return n;
}

fn panel_open(o: []u8, n0: u32, ix: u32) -> u32 {
    var n : u32 = raw(o, n0, "<section class=\"lx-panel\"");
    if (TAB != ix) { n = raw(o, n, " hidden=\"\""); }
    return raw(o, n, ">");
}

/// The whole page, as tool.js's root.replaceChildren(...) and the render calls left it. 0 on overflow.
pub fn w_render(dst: []u8) -> u32 {
    BTN_N = 0;
    var n : u32 = raw(dst, 0, "<div class=\"lx\"><nav class=\"lx-tabs\">");
    var i : u32 = 0;
    while (i < 3) {
        btn_mark(i);
        n = raw(dst, n, "<button class=\"t27-btn\" type=\"button\" aria-pressed=\"");
        if (TAB == i) { n = raw(dst, n, "true"); } else { n = raw(dst, n, "false"); }
        n = raw(dst, n, "\">");
        n = text(dst, n, SAY_TABS[i as usize]);
        n = raw(dst, n, "</button>");
        i = i + 1;
    }
    n = raw(dst, n, "</nav><p class=\"lx-status\" role=\"status\"");
    if (DATA_ST == 1) {
        n = raw(dst, n, " hidden=\"\"></p>");
    } else {
        n = raw(dst, n, ">");
        if (DATA_ST == 0) {
            n = text(dst, n, SAY_LOADING);
        } else {
            if (FAIL_FILE == 0) { n = pf1(dst, n, true, SAY_LOAD_FAILED, "file", K_DATA_PRJXRAY); } else { n = pf1(dst, n, true, SAY_LOAD_FAILED, "file", K_DATA_DESIGN); }
        }
        n = raw(dst, n, "</p>");
    }
    n = panel_open(dst, n, 0);
    n = raw(dst, n, "<label class=\"lx-label\">");
    n = text(dst, n, SAY_INPUT_LABEL);
    n = raw(dst, n, "<textarea class=\"lx-input\" rows=\"4\" spellcheck=\"false\" autocomplete=\"off\"");
    n = attr(dst, n, "placeholder", SAY_INPUT_PLACEHOLDER);
    n = attr(dst, n, "aria-label", SAY_INPUT_LABEL);
    n = raw(dst, n, "></textarea></label><label class=\"t27-drop lx-drop");
    if (DRAGGING) { n = raw(dst, n, " is-over"); }
    n = raw(dst, n, "\">");
    n = text(dst, n, SAY_DROP);
    n = raw(dst, n, "<input type=\"file\" accept=\".fasm,text/plain\" class=\"lx-file\"></label><div class=\"lx-examples\"><span class=\"lx-k\">");
    n = text(dst, n, SAY_EXAMPLES);
    n = raw(dst, n, "</span>");
    i = 0;
    while (i < 8) {
        btn_mark(10 + i);
        n = raw(dst, n, "<button class=\"t27-btn\" type=\"button\" aria-pressed=\"");
        if (EX_ON == (i as i32)) { n = raw(dst, n, "true"); } else { n = raw(dst, n, "false"); }
        n = raw(dst, n, "\">");
        n = text(dst, n, SAY_EXAMPLE_NAMES[i as usize]);
        n = raw(dst, n, "</button>");
        i = i + 1;
    }
    n = raw(dst, n, "</div>");
    n = emit_fileline(dst, n);
    n = emit_out(dst, n);
    n = raw(dst, n, "</section>");
    n = panel_open(dst, n, 1);
    n = raw(dst, n, "<p class=\"lx-note\">");
    n = text(dst, n, SAY_GAME_INTRO);
    n = raw(dst, n, "</p>");
    n = emit_game(dst, n);
    n = raw(dst, n, "</section>");
    n = panel_open(dst, n, 2);
    n = raw(dst, n, "<div class=\"lx-design\">");
    var q : usize = 0;
    while (q < (DESIGN_N as usize)) {
        n = put(dst, n, DESIGN_HTML[q]);
        q = q + 1;
    }
    n = raw(dst, n, "</div></section></div>");
    if (!ok(n)) { return 0; }
    return n;
}

/// The splicer follows only the names a module itself mentions, not the names its imported functions
/// mention. This anchor mentions every helper the writer and the JSON reader call. Never called.
pub fn imports_anchor(o: []u8, s: []const u8) -> u32 {
    var n : u32 = put(o, 0, 0);
    n = put_escaped(o, n, 0);
    n = n + OVER + ((H_LT + H_GT + H_AMP + H_QUOTE + H_APOS + H_SPACE + H_SLASH + H_EQ) as u32);
    n = n + (name_is(s, 0, 0, s) as u32) + (is_word_byte(0) as u32);
    n = n + (skip_ws(s, 0) as u32) + (string_end(s, 0) as u32) + (value_end(s, 0) as u32);
    n = n + (key_is(s, 0, 0, s) as u32) + hex4(s, 0) + escape_at(s, 0, 0) + cp_utf8_len(0) + (cp_utf8_byte(0, 0) as u32);
    n = n + (SPAN as u32) + (J_NONE as u32) + (J_OBJECT as u32) + (J_ARRAY as u32) + (J_STRING as u32) + (J_NUMBER as u32);
    n = n + (J_TRUE as u32) + (J_FALSE as u32) + (J_NULL as u32);
    n = n + (NO_SPAN as u32) + (jspan(0, 0) as u32);
    return n;
}

; --- Tests of the native page ------------------------------------------------------------------------------
; The decoder's own tests (in lut_explain_logic.t27) run on the same code; these hold the page. The data
; files here are small stand-ins written by this test: one CLB tile type with a twin, five histogram rows,
; three game rounds.

pub var T_OUT : [262144]u8 = [0; 262144];
pub var T_TXT : [8192]u8 = [0; 8192];
pub var T_N : usize = 0;

fn contains(s: []const u8, w: []const u8) -> bool {
    if (w.len > s.len) { return false; }
    var p : usize = 0;
    while (p + w.len <= s.len) {
        if (starts_s(s[p..s.len], w)) { return true; }
        p = p + 1;
    }
    return false;
}

fn render() -> u32 {
    return w_render(T_OUT[0..]);
}

fn has(n: u32, w: []const u8) -> bool {
    return contains(T_OUT[0..(n as usize)], w);
}

fn t_reset() -> usize {
    T_N = 0;
    return 0;
}

fn t_line(s: []const u8) -> usize {
    var k : usize = 0;
    while (k < s.len) {
        T_TXT[T_N] = s[k];
        T_N = T_N + 1;
        k = k + 1;
    }
    T_TXT[T_N] = 10;
    T_N = T_N + 1;
    return T_N;
}

/// Press the button whose action is a, as the page numbered it in its last render.
fn press_act(a: u32) -> u32 {
    render();
    var i : u32 = 0;
    while (i < BTN_N) {
        if (BTN_ACT[i as usize] == a) {
            w_press(i);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn load_ok() -> u32 {
    w_init("");
    w_seed(1);
    w_data(0, W_PX_T);
    w_data(1, W_DS_T);
    return 0;
}

pub const W_PX_T : str = "{\"schema\":1,\"tiles\":{\"CLBLM_L\":{\"sites\":[{\"name\":\"SLICEM_X0\",\"type\":\"SLICEM\",\"prefix\":\"CLBLM_M_\"},{\"name\":\"SLICEL_X1\",\"type\":\"SLICEL\",\"prefix\":\"CLBLM_L_\"}],\"features\":{\"SLICEM_X0.NOCLKINV\":[\"01_02\",\"!03_04\"],\"SLICEM_X0.AFF.ZINI\":[\"31_06\"]},\"init\":{\"SLICEM_X0.C\":[\"20_0\",\"21_1\",\"22_2\",\"23_3\",\"24_4\",\"25_5\",\"26_6\",\"27_7\",\"28_8\",\"29_9\",\"30_10\",\"31_11\",\"32_12\",\"33_13\",\"34_14\",\"35_15\",\"36_0\",\"37_1\",\"38_2\",\"39_3\",\"40_4\",\"41_5\",\"42_6\",\"43_7\",\"44_8\",\"45_9\",\"46_10\",\"47_11\",\"48_12\",\"49_13\",\"50_14\",\"51_15\",\"52_0\",\"53_1\",\"54_2\",\"55_3\",\"56_4\",\"57_5\",\"58_6\",\"59_7\",\"60_8\",\"61_9\",\"62_10\",\"63_11\",\"64_12\",\"65_13\",\"66_14\",\"67_15\",\"68_0\",\"69_1\",\"70_2\",\"71_3\",\"72_4\",\"73_5\",\"74_6\",\"75_7\",\"76_8\",\"77_9\",\"78_10\",\"79_11\",\"80_12\",\"81_13\",\"82_14\",\"83_15\"],\"SLICEL_X1.A\":[\"20_0\",\"21_1\",\"22_2\",\"23_3\",\"24_4\",\"25_5\",\"26_6\",\"27_7\",\"28_8\",\"29_9\",\"30_10\",\"31_11\",\"32_12\",\"33_13\",\"34_14\",\"35_15\",\"36_0\",\"37_1\",\"38_2\",\"39_3\",\"40_4\",\"41_5\",\"42_6\",\"43_7\",\"44_8\",\"45_9\",\"46_10\",\"47_11\",\"48_12\",\"49_13\",\"50_14\",\"51_15\",\"52_0\",\"53_1\",\"54_2\",\"55_3\",\"56_4\",\"57_5\",\"58_6\",\"59_7\",\"60_8\",\"61_9\",\"62_10\",\"63_11\",\"64_12\",\"65_13\",\"66_14\",\"67_15\",\"68_0\",\"69_1\",\"70_2\",\"71_3\",\"72_4\",\"73_5\",\"74_6\",\"75_7\",\"76_8\",\"77_9\",\"78_10\",\"79_11\",\"80_12\",\"81_13\",\"82_14\",\"83_15\"]},\"ppips\":{\"CLBLM_M_C.CLBLM_M_C1\":\"hint\",\"CLBLM_L_B.CLBLM_L_B2\":\"always\"}},\"CLBLM_R\":{\"sameAs\":\"CLBLM_L\"}}}";
pub const W_DS_T : str = "{\"luts\":12,\"distinct\":9,\"named\":8,\"pinsAgree\":12,\"inexact\":0,\"maxTerms\":4,\"o5Used\":0,\"ramSrl\":0,\"hist\":[[\"xor/2/0\",4],[\"and/3/0\",2],[\"mux2/3/0\",1],[\"xorwith/5/2/and/3/0\",1],[\"other/5/0\",4]],\"rounds\":[{\"loc\":\"CLBLM_L_X1Y2.SLICEM_X0.C\",\"init\":\"6996966996696996\"},{\"loc\":\"CLBLM_L_X1Y2.SLICEM_X0.C\",\"init\":\"8000000000000000\"},{\"loc\":\"CLBLM_R_X3Y4.SLICEL_X1.A\",\"init\":\"CACACACACACACACA\"}],\"source\":{\"part\":\"xc7\",\"tools\":{\"yosys\":\"Yosys 1.2 (git abc)\",\"nextpnr\":\"np 9\",\"prjxray\":\"c9f 2025 x\",\"db\":\"db1\"},\"yosys\":\"synth_x\"}}";

test the_page_opens_loading_with_the_tabs_the_examples_and_two_hidden_panels {
    w_init("");
    const n : u32 = render();
    assert n > 1500;
    assert has(n, "<p class=\"lx-status\" role=\"status\">Reading the data files...</p>");
    assert has(n, "aria-pressed=\"true\">Decode</button><button class=\"t27-btn\" type=\"button\" aria-pressed=\"false\">Guess the gate</button>");
    assert has(n, "</nav><p class=\"lx-status\"");
    assert has(n, "<section class=\"lx-panel\"><label class=\"lx-label\">");
    assert has(n, "<section class=\"lx-panel\" hidden=\"\"><p class=\"lx-note\">");
    assert has(n, "<textarea class=\"lx-input\" rows=\"4\" spellcheck=\"false\" autocomplete=\"off\" placeholder=\"64&#39;h6996966996696996\"");
    assert has(n, "<div class=\"lx-fileline\" hidden=\"\"></div><div class=\"lx-out\"></div>");
    assert BTN_N == 11;
    assert BTN_ACT[0] == 0 and BTN_ACT[3] == 10 and BTN_ACT[10] == 17;
}

test a_data_file_that_fails_is_named_and_the_page_stays_empty {
    w_init("");
    w_data_failed(0);
    var n : u32 = render();
    assert has(n, "role=\"status\">A data file could not be read: ./prjxray.json</p>");
    assert has(n, "<div class=\"lx-out\"></div>");
    w_init("");
    w_data(0, W_PX_T);
    w_data_failed(1);
    w_data(1, W_DS_T);
    n = render();
    assert has(n, "role=\"status\">A data file could not be read: ./design.json</p>");
    assert DATA_ST == 2;
    w_press(2);
    n = render();
    assert has(n, "aria-pressed=\"true\">Our design</button>");
    w_init("");
    w_data(0, "not json");
    assert DATA_ST == 2;
}

test both_files_in_start_the_page_on_the_carry_example {
    load_ok();
    assert DATA_ST == 1;
    assert EX_ON == 6;
    assert HAS_BITS;
    assert EFF_INPUT;
    const n : u32 = render();
    assert has(n, "<p class=\"lx-status\" role=\"status\" hidden=\"\"></p>");
    assert has(n, "aria-pressed=\"true\">carry LUT, our design</button>");
    assert has(n, "<dd class=\"lx-name\">2-bit carry out: MAJ(a, b, MAJ(c, d, e))</dd>");
    assert has(n, "<p class=\"lx-note is-ok\">Checked: the expression gives the same 64 outputs as the INIT.</p>");
    assert has(n, "<code class=\"lx-line lx-mono\">CLBLM_L_X10Y248.SLICEM_X0.CLUT.INIT[63:0] = 64&#39;b1111111111101000");
    assert BTN_N == 75;
    var e : [2048]u8 = [0; 2048];
    const m : u32 = w_effect(0, e[0..]);
    assert m == INPUT_N + 2;
    assert e[0] == 118 and e[1] == 0 and e[2] == 67;
    assert w_effect(1, e[0..]) == 0;
}

test a_tapped_row_flips_its_bit_says_where_it_lives_and_can_be_undone {
    load_ok();
    const before : u64 = BITS;
    assert press_act(105) == 1;
    assert BITS == (before ^ 32);
    assert FLIPPED == 5;
    var n : u32 = render();
    assert has(n, "<p class=\"lx-note is-gold\" role=\"status\">INIT[5] is now ");
    assert has(n, "prjxray-db puts it at frame offset 25, bit 5 of a CLBLM_L tile, SLICEM_X0 CLUT.</p>");
    assert has(n, "<button class=\"t27-btn\" type=\"button\">Undo my flips</button>");
    assert has(n, " is-flipped\" type=\"button\"");
    assert press_act(30) == 1;
    assert BITS == before;
    assert FLIPPED == -1;
    n = render();
    assert has(n, "Undo my flips") == false;
    assert has(n, "is-flipped") == false;
}

test a_pasted_init_is_named_and_gets_the_assumed_place {
    load_ok();
    w_input(0, "64'h6996966996696996");
    assert HAS_BITS;
    assert ASSUMED;
    var n : u32 = render();
    assert has(n, "<dd class=\"lx-name\">XOR6: parity of 6 inputs</dd>");
    assert has(n, "<dd>none<span class=\"lx-dc\"> don&#39;t-care: none</span></dd>") == false;
    assert has(n, "<dd>A1, A2, A3, A4, A5, A6<span class=\"lx-dc\"> don&#39;t-care: none</span></dd>");
    assert has(n, "<h3 class=\"lx-h\">The FASM line for this INIT</h3><p class=\"lx-mono lx-line\">CLBLM_L_X10Y248.SLICEM_X0.CLUT.INIT[63:0] = 64&#39;b0110100110010110");
    assert has(n, "The paste names no LUT, so the line uses CLBLM_L_X10Y248.SLICEM_X0.C, a real SLICEM LUT of our design.");
    assert has(n, "32'h96696996</span> XOR5: parity of 5 inputs");
    assert has(n, "Both halves are the same function") == false;
    assert has(n, "The halves differ: A6 picks between them.");
    assert has(n, "In our design 0 of 12 LUTs route O5");
    w_input(0, "");
    assert HAS_BITS == false;
    n = render();
    assert has(n, "<p class=\"lx-note\">Nothing to read yet: paste an INIT or a FASM LUT line.</p><div class=\"lx-block\"><h3 class=\"lx-h\">FASM lines, read against prjxray-db</h3><p class=\"lx-note\">No FASM lines in the paste.</p>");
    assert EFF_INPUT == false;
}

test fasm_lines_are_split_and_read_against_the_db {
    load_ok();
    t_reset();
    t_line("CLBLM_L_X1Y2.SLICEM_X0.NOCLKINV");
    t_line("CLBLM_L_X1Y2.SLICEM_X0.AFF.ZINI");
    t_line("CLBLM_L_X1Y2.CLBLM_M_C1.CLBLM_IMUX32");
    t_line("CLBLM_L_X1Y2.CLBLM_M_C.CLBLM_M_C1");
    t_line("CLBLM_R_X1Y2.SLICEL_X1.CLKINV");
    t_line("DSP_L_X5Y5.A.B");
    t_line("not fasm");
    w_input(0, T_TXT[0..T_N]);
    const n : u32 = render();
    assert HAS_BITS == false;
    assert has(n, "<p class=\"lx-note\">CLBLM: a SLICEM site, whose LUTs can also be RAM or shift registers, and a SLICEL site.</p><p class=\"lx-note\">In this db the CLBLM_L and CLBLM_R tiles have the same feature names and the same bits.</p>");
    assert has(n, "<p class=\"lx-note\">In this db the CLBLM_R and CLBLM_L tiles have the same feature names and the same bits.</p>");
    assert has(n, "<p class=\"lx-note\">DSP_L is not a CLB tile: this page ships only the CLBLL and CLBLM part of prjxray-db.</p>");
    assert has(n, "<span class=\"lx-chip\"><b>tile</b> CLBLM_L_X1Y2</span><span class=\"lx-chip\"><b>site</b> SLICEM_X0</span><span class=\"lx-chip\"><b>feature</b> NOCLKINV</span>");
    assert has(n, "<span class=\"lx-chip\"><b>BEL</b> AFF</span><span class=\"lx-chip\"><b>feature</b> ZINI</span>");
    assert has(n, "<p class=\"lx-w lx-sub\">config bits, as frame offset _ bit in the tile: <span class=\"lx-bits lx-mono\"><span>01_02</span><span class=\"is-neg\">!03_04</span></span> (a bit written !x must be 0)</p>");
    assert has(n, "<p class=\"lx-w\">AFF starts at 0 after configuration (GSR).");
    assert has(n, "<p class=\"lx-w\">Input A1 of the SLICEM_X0 CLUT comes from CLBLM_IMUX32.</p>");
    assert has(n, "<p class=\"lx-w\">Inside the CLB tile: wire CLBLM_M_C from CLBLM_M_C1.</p><p class=\"lx-w\">A path through the LUT from an input to its output (prjxray-db ppip &#39;hint&#39;): no config bits.</p>");
    assert has(n, "<p class=\"lx-w\">CLBLM_R has no feature SLICEL_X1.CLKINV in prjxray-db ab1fc60.</p>");
    assert has(n, "<p class=\"lx-w\">Routing pip: wire A driven from B. Its bits are in the segbits of DSP_L, which this page does not ship.</p>");
    assert has(n, "<li class=\"lx-fl is-bad\">Not read: not fasm</li>");
}

test a_split_init_in_fasm_gives_the_lut_its_place_and_its_bits {
    load_ok();
    t_reset();
    t_line("CLBLL_L_X2Y3.SLICEL_X1.BLUT.INIT[31:0] = 32'hFFFF0000");
    t_line("CLBLL_L_X2Y3.SLICEL_X1.BLUT.INIT[63:32] = 32'hFFFF0000");
    t_line("CLBLL_L_X2Y3.SLICEL_X0.BLUT.INIT[63:0] = 64'h1");
    t_line("CLBLL_L_X2Y3.SLICEL_X1.BLUT.INIT[64:0] = 65'h1");
    w_input(0, T_TXT[0..T_N]);
    assert HAS_BITS;
    assert BITS == 18446462603027742720;
    assert ASSUMED == false;
    const n : u32 = render();
    assert has(n, "<dd class=\"lx-name\">buffer: copies one input</dd><dt></dt><dd>The output is A5.</dd>");
    assert has(n, "CLBLL_L_X2Y3.SLICEL_X1.BLUT.INIT[63:0] = 64&#39;b1111111111111111000000000000000011111111111111110000000000000000</p>");
    assert has(n, "<li class=\"lx-fl is-bad\">Not read: CLBLL_L_X2Y3.SLICEL_X1.BLUT.INIT[64:0] = 65&#39;h1</li>");
    assert has(n, "<code class=\"lx-line lx-mono\">CLBLL_L_X2Y3.SLICEL_X1.BLUT.INIT[63:0]") == false;
}

test a_fasm_file_gives_its_luts_a_histogram_and_the_paste_box_follows_prev_and_next {
    load_ok();
    t_reset();
    t_line("# a file");
    t_line("CLBLM_L_X1Y2.SLICEM_X0.CLUT.INIT[63:0] = 64'hFFFFFFFF00000000");
    t_line("");
    t_line("CLBLM_L_X1Y2.CLBLM_M_C1.CLBLM_IMUX32");
    t_line("CLBLM_L_X1Y2.CLBLM_M_C2.CLBLM_IMUX29");
    t_line("CLBLM_L_X1Y2.CLBLM_M_B2.CLBLM_IMUX29");
    t_line("INT_L_X1Y1.X.Y");
    t_line("CLBLM_L_X1Y2.SLICEL_X1.ALUT.INIT[63:0] = 64'h6996966996696996");
    t_line("CLBLM_L_X1Y2.CLBLM_L_A1.CLBLM_IMUX3");
    assert w_file(0, "n<1>.fasm", 400) == 1;
    w_file_data(0, T_TXT[0..T_N]);
    assert FILE_ON;
    assert LUT_N == 2;
    assert FILE_NAMED == 2;
    assert LUT_NL[0] == 3 and LUT_NL[1] == 2;
    assert FILE_IDX == 0;
    assert EFF_INPUT;
    var n : u32 = render();
    assert has(n, "<div class=\"lx-fileline\"><p class=\"lx-note\">n&lt;1&gt;.fasm: 2 LUT INIT lines. This is LUT 1 of 2, CLBLM_L_X1Y2.SLICEM_X0.C.</p><div class=\"lx-row\"><button class=\"t27-btn\" type=\"button\">Previous LUT</button><button class=\"t27-btn\" type=\"button\">Next LUT</button></div></div>");
    assert has(n, "<dd class=\"lx-name\">buffer: copies one input</dd>");
    assert press_act(21) == 1;
    assert FILE_IDX == 1;
    n = render();
    assert has(n, "This is LUT 2 of 2, CLBLM_L_X1Y2.SLICEL_X1.A.</p>");
    assert has(n, "<dd class=\"lx-name\">XOR6: parity of 6 inputs</dd>");
    assert press_act(21) == 1;
    assert FILE_IDX == 0;
    assert press_act(20) == 1;
    assert FILE_IDX == 1;
    // the design box is drawn when its tab opens
    assert DESIGN_N == 0;
    assert press_act(2) == 1;
    assert DESIGN_N > 0;
    n = render();
    assert has(n, "<p class=\"lx-k\">our design</p><ul class=\"lx-bars\"><li class=\"lx-bar is-xor\"><span class=\"lx-bl\" title=\"XOR2: parity of 2 inputs\">XOR2: parity of 2 inputs</span><span class=\"lx-bt\"><span class=\"lx-bf\" style=\"width:100.0%\"></span></span><span class=\"lx-bn\">4  33.3%</span></li>");
    assert has(n, "<p class=\"lx-k\">your file</p><p class=\"lx-note\">Your file n&lt;1&gt;.fasm: 2 LUTs, 2 with a short name. Read in this tab only.</p><ul class=\"lx-bars\"><li class=\"lx-bar \"><span class=\"lx-bl\" title=\"buffer: copies one input\">buffer: copies one input</span><span class=\"lx-bt\"><span class=\"lx-bf\" style=\"width:100.0%\"></span></span><span class=\"lx-bn\">1  50.0%</span></li>");
    assert has(n, "<li class=\"lx-bar is-other\">");
    assert has(n, "<li>Built with Yosys 1.2: synth_x. Placed and routed with np 9. Read with prjxray c9f and db1.</li>");
    // a file with no LUT says so and leaves the paste box alone
    t_reset();
    t_line("nothing here");
    w_file(0, "e.fasm", 12);
    w_file_data(0, T_TXT[0..T_N]);
    assert LUT_N == 0;
    n = render();
    assert has(n, "<div class=\"lx-fileline\"><p class=\"lx-note\">e.fasm: 0 LUT INIT lines. This is LUT 0 of 0, .</p></div>");
    assert w_file(0, "huge.fasm", 9000000) == 0;
}

test the_game_deals_three_rounds_scores_them_and_deals_again {
    load_ok();
    assert GAME_ON == false;
    assert press_act(1) == 1;
    assert GAME_ON;
    assert G_N == 3;
    var n : u32 = render();
    assert has(n, "<p class=\"lx-score\">Round 1 of 3. Score 0.</p><p class=\"lx-mono lx-init lx-big\">64'h");
    assert has(n, "<div class=\"lx-grid\" aria-hidden=\"true\">");
    assert has(n, "Rounds come from 3 INITs: at most 4 distinct ones per named function, so rare functions turn up as often as XOR2. The 4 LUTs with no short name are left out.");
    assert G_NL[0] >= 2;
    var round : u32 = 0;
    while (round < 3) {
        // the right answer is always label slot 0; find where it was dealt
        var k : u32 = 0;
        while (k < G_NL[G_AT as usize]) {
            if (G_ORD[(G_AT as usize) * 5 + (k as usize)] == 0) { press_act(200 + k); }
            k = k + 1;
        }
        n = render();
        assert has(n, "<p class=\"lx-verdict is-ok\" role=\"status\">Right.</p>");
        assert has(n, " disabled=\"\"");
        assert has(n, " is-right");
        assert has(n, " is-wrong") == false;
        press_act(300);
        round = round + 1;
    }
    n = render();
    assert has(n, "<p class=\"lx-score\">3 of 3 right.</p><button class=\"t27-btn\" type=\"button\">Play again</button>");
    assert press_act(302) == 1;
    assert G_AT == 0 and G_RIGHT == 0;
    // a wrong pick
    var j : u32 = 0;
    while (j < G_NL[0]) {
        if (G_ORD[j as usize] != 0) { press_act(200 + j); break; }
        j = j + 1;
    }
    n = render();
    assert has(n, "<p class=\"lx-verdict is-bad\" role=\"status\">No: it is ");
    assert has(n, " is-wrong");
    // open it in the decoder
    assert press_act(301) == 1;
    assert TAB == 0;
    assert HAS_BITS;
    assert EX_ON == -1;
    assert EFF_INPUT;
}

test the_random_numbers_are_the_xorshift_the_original_was_given {
    w_seed(1);
    const r1 : u64 = (rnd_next() * 4294967296.0) as u64;
    const r2 : u64 = (rnd_next() * 4294967296.0) as u64;
    const r3 : u64 = (rnd_next() * 4294967296.0) as u64;
    assert r1 == 270369;
    assert r2 == 67634689;
    assert r3 == 2647435461;
    w_seed(0);
    assert RNG == 1;
}

test widths_are_rounded_like_toFixed_of_the_exact_double {
    var b : [32]u8 = [0; 32];
    var n : u32 = fixed1(b[0..], 0, 12.25);
    assert eq_s(b[0..(n as usize)], "12.3");
    n = fixed1(b[0..], 0, 0.35);
    assert eq_s(b[0..(n as usize)], "0.3");
    n = fixed1(b[0..], 0, 100.0);
    assert eq_s(b[0..(n as usize)], "100.0");
    n = fixed1(b[0..], 0, 0.05);
    assert eq_s(b[0..(n as usize)], "0.1");
    n = fixed1(b[0..], 0, 0.15);
    assert eq_s(b[0..(n as usize)], "0.1");
    n = fixed1(b[0..], 0, 0.25);
    assert eq_s(b[0..(n as usize)], "0.3");
    n = fixed1(b[0..], 0, 1.45);
    assert eq_s(b[0..(n as usize)], "1.4");
    n = fixed1(b[0..], 0, 99.95);
    assert eq_s(b[0..(n as usize)], "100.0");
    n = fixed1(b[0..], 0, 0.049999999999999996);
    assert eq_s(b[0..(n as usize)], "0.0");
    n = fixed1(b[0..], 0, (52000.0) / 4738.0);
    assert eq_s(b[0..(n as usize)], "11.0");
    n = fixed1(b[0..], 0, 33.333333333333336);
    assert eq_s(b[0..(n as usize)], "33.3");
    n = fixed1(b[0..], 0, 0.0);
    assert eq_s(b[0..(n as usize)], "0.0");
}

test class_keys_become_the_names_the_original_gives {
    var b : [256]u8 = [0; 256];
    var n : u32 = class_name_key(b[0..], 0, "xorwith/5/2/and/3/0");
    assert eq_s(b[0..(n as usize)], "XOR of 2 inputs with (AND3)");
    n = class_name_key(b[0..], 0, "foo/2/0");
    assert eq_s(b[0..(n as usize)], "foo");
    n = class_name_key(b[0..], 0, "xor");
    assert eq_s(b[0..(n as usize)], "XORNaN: parity of NaN inputs");
    n = class_name_key(b[0..], 0, "XOR/ 2/+3");
    assert eq_s(b[0..(n as usize)], "XOR2: parity of 2 inputs");
    n = class_name_key(b[0..], 0, "other/4/0");
    assert eq_s(b[0..(n as usize)], "no short name, 4 inputs");
    n = class_name_key(b[0..], 0, "mux2/3/0");
    assert eq_s(b[0..(n as usize)], "2:1 mux");
    n = class_name_key(b[0..], 0, "andx/3/-1");
    assert eq_s(b[0..(n as usize)], "AND3 with -1 inverted");
    assert num_part("12", 0, 2, true) == 12;
    assert num_part(" 7 ", 0, 3, true) == 7;
    assert num_part("", 0, 0, true) == 0;
    assert num_part("1x", 0, 2, true) == W_NAN_V;
    assert num_part("1", 0, 1, false) == W_NAN_V;
}

test placeholders_fill_from_pairs_and_unknown_ones_stay_and_escaping_is_a_choice {
    var b : [128]u8 = [0; 128];
    var n : u32 = pf8(b[0..], 0, false, "a {x} <{y}> {z} {x}", "x", "1&2", "y", "B", "", "", "", "", "", "", "", "", "", "", "", "");
    assert eq_s(b[0..(n as usize)], "a 1&2 <B> {z} 1&2");
    n = pf8(b[0..], 0, true, "a {x} <{y}> {z}", "x", "1&2", "y", "B", "", "", "", "", "", "", "", "", "", "", "", "");
    assert eq_s(b[0..(n as usize)], "a 1&amp;2 &lt;B&gt; {z}");
}

test dragging_marks_the_drop_zone {
    load_ok();
    assert w_drag(0, 1) == 1;
    assert w_drag(0, 1) == 0;
    var n : u32 = render();
    assert has(n, "<label class=\"t27-drop lx-drop is-over\">");
    assert w_drag(0, 0) == 1;
    n = render();
    assert has(n, "<label class=\"t27-drop lx-drop\">Or drop") == false;
    assert has(n, "<label class=\"t27-drop lx-drop\">");
}
