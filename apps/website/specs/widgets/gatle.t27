test day_index_on_two_fixed_dates {
  assert K_TEST_INDEX[0] == (K_TEST_DAYS[0] - K_EPOCH_DAY) % K_POOL_SIZE;
  assert K_TEST_INDEX[1] == (K_TEST_DAYS[1] - K_EPOCH_DAY) % K_POOL_SIZE;
  assert K_TEST_NUMBER[0] == K_TEST_DAYS[0] - K_EPOCH_DAY + 1;
  assert K_TEST_NUMBER[1] == K_TEST_DAYS[1] - K_EPOCH_DAY + 1;
  assert K_TEST_DAYS[0] == K_EPOCH_DAY;
}

test close_is_within_ten_percent_boundary_included {
  assert K_CLOSE_PCT == 10;
  assert K_RULE_TRUTH - K_RULE_GUESSES[0] == 20;
  assert K_RULE_TRUTH * K_CLOSE_PCT >= (K_RULE_TRUTH - K_RULE_GUESSES[0]) * 100;
  assert K_RULE_TRUTH - K_RULE_GUESSES[1] == 21;
  assert K_RULE_TRUTH * K_CLOSE_PCT < (K_RULE_TRUTH - K_RULE_GUESSES[1]) * 100;
  assert K_RULE_TRUTH * K_WARM_PCT >= (K_RULE_TRUTH - K_RULE_GUESSES[1]) * 100;
  assert K_RULE_GUESSES[2] - K_RULE_TRUTH == 20;
  assert K_RULE_TRUTH * K_CLOSE_PCT >= (K_RULE_GUESSES[2] - K_RULE_TRUTH) * 100;
  assert K_RULE_GUESSES[3] - K_RULE_TRUTH == 21;
  assert K_RULE_TRUTH * K_CLOSE_PCT < (K_RULE_GUESSES[3] - K_RULE_TRUTH) * 100;
  assert K_RULE_HEAT[0] == "close";
  assert K_RULE_HEAT[1] == "warm";
  assert K_RULE_DIR[1] == "up";
  assert K_RULE_DIR[3] == "down";
}

test pool_size_matches_the_id_list {
  assert K_POOL_IDS[K_POOL_SIZE - 1] != "";
  assert K_POOL_ZERO_FF <= K_POOL_SIZE;
  assert K_POOL_SIZE <= K_CANDIDATES;
  assert K_CANDIDATES <= K_CORPUS_SPECS;
}

test sends_nothing_and_keeps_nothing {
  assert SENDS_NOTHING == true;
  assert READS_LOCAL_FILES == false;
  assert K_DATA_FILE == "./pool.json";
  assert K_MIN_LUTS < K_MAX_LUTS;
}


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/gatle/tool.js (309 lines of hand-written JavaScript) and
; rule.js (parseHash and formatHash; the rest of rule.js is gatle_rule.t27, used here). The words and
; numbers above are unchanged. The host protocol is race_the_bee's (w_init, w_data, w_click,
; w_render) plus the services a day-by-day game needs:
;   w_init(hash)              the page opens; the game is made when the pool has been read
;   w_data(i, bytes)          pool.json (K_DATA_FILE); w_data_failed(i) when it could not be read
;   w_hash(hash)              the address's fragment changed (the game is read from it again)
;   w_hash_out(dst)           the fragment to show after an event that saved the game (0: leave it)
;   w_input(i, text)          the guess box changed (its value, which a number box blanks when it is no number)
;   w_click(i)                button i in page order: the heads (2 or 3), the 2 tabs, the comment toggle, the play button
;   w_toggle(i, open)         the details element was opened or closed by the reader
;   w_value(i, dst)           the text the guess box must hold now (0 bytes: empty it; 4294967295: leave it)
;   w_wall(ms)                Date.now() before each event; w_now(t) performance.now(); w_rand(r) Math.random()
;   w_base(url)               the page's directory, from which the source links are made
;   w_effect(k, dst)          effects after an event: 'f' + id + path = fetch a file and answer w_fetched(id, ok, bytes);
;                             'F' + selector = focus; 'n' + selector = scroll into view; 'w' + selector, LF, text = copy
;                             the text (the old way on the element's text if refused) and answer w_copied(ok);
;                             't' + id + decimal ms = call w_timer(id) after ms
;   w_compile_need(dst) / w_compile_give(bytes, ok, t0, t1)
;                             the compiler service of t27c_stages.t27: the source to compile, the answer
;   w_render(dst)             the page's HTML, length (0 on overflow)
; The sha256 of the source and of the Verilog is sha256_hex.t27. State is the address's fragment only,
; as in tool.js. Not carried over from JavaScript: a pool file or a source above 1 MiB, more than 256
; puzzles, a compiler answer above 1 MiB, a Verilog above 1 MiB or 512 KiB of source are taken for a failure;
; 256 games remembered in a visit (tool.js remembers all); a browser that cannot hash is not modelled (this page always
; hashes); invalid UTF-8 in a source is not replaced by U+FFFD; a pool file with a field missing
; stays at "Loading..." in tool.js (an exception) and draws blanks here; a number box value that no
; browser would hand over (it blanks what is no number) is not modelled beyond what the box gives.
; The browser's HTML parser drops a newline right after <pre> and turns a carriage return into a
; newline: the page writes a second newline where the text starts with one and &#13; for a carriage return.

pub const W_DATA_CAP : u32 = 1048576;
pub const W_POOL_MAX : u32 = 256;
pub const W_SRC_TOTAL : u32 = 1048576;
pub const W_RES_CAP : u32 = 1048576;
pub const W_CODE_CAP : u32 = 1048576;
pub const W_COMPILE_CAP : u32 = 524288;
pub const W_MEM_MAX : u32 = 256;
pub const W_COPY_MS : u32 = 2500;
pub const W_DAY_MS : f64 = 86400000.0;
pub const W_V_NONE : u32 = 0;
pub const W_V_STR : u32 = 1;
pub const W_V_RAW : u32 = 2;
pub const W_V_NUM : u32 = 3;
pub const W_V_SC : u32 = 4;
pub const W_NAMES : str = "n date i size today top code lines ms bytes sha was synth version close warm max lut ff carry4 muxf7 muxf8 dsp cells mode score specs candidates zeroff min cols";

pub var DATA : [1048576]u8 = [0; 1048576];
pub var DATA_N : u32 = 0;
pub var DATA_STATE : u32 = 0;
pub var HASH_IN : [4096]u8 = [0; 4096];
pub var HASH_IN_N : u32 = 0;
pub var HASH_DIRTY : bool = false;
pub var RAW_OUT : bool = false;
pub var D_ROOT : i64 = -1;
pub var D_POOL : i64 = -1;
pub var D_YOSYS : i64 = -1;
pub var D_CORPUS : i64 = -1;
pub var D_DATE : i64 = -1;
pub var POOL_SP : [256]i64 = [-1; 256];
pub var POOL_N : u32 = 0;
pub var ZEROFF : u32 = 0;
pub var G_PRACTICE : bool = false;
pub var G_DAY : u32 = 0;
pub var G_INDEX : u32 = 0;
pub var G_GUESS : [6]u32 = [0; 6];
pub var G_N : u32 = 0;
pub var MEM_KEY : [256]u32 = [0; 256];
pub var MEM_GUESS : [1536]u32 = [0; 1536];
pub var MEM_N : [256]u32 = [0; 256];
pub var MEM_USED : u32 = 0;
pub var MEM_NEXT : u32 = 0;
pub var V_TAB : u32 = 0;
pub var V_COMMENTS : bool = false;
pub var HDR_T : u32 = 0;
pub var WALL : f64 = 0.0;
pub var NOW : f64 = 0.0;
pub var RAND : f64 = 0.0;
pub var BASE : [1024]u8 = [0; 1024];
pub var BASE_N : u32 = 0;
pub var MSG_KIND : u32 = 0;
pub var CLEAR_INPUT : bool = false;
pub var INPUT_TEXT : [256]u8 = [0; 256];
pub var INPUT_N : u32 = 0;
pub var DET_OPEN : bool = false;
pub var SHARE_EPOCH : u32 = 0;
pub var COPY_EPOCH : u32 = 0;
pub var COPY_MSG : u32 = 0;
pub var SRC_STATE : [256]u32 = [0; 256];
pub var SRC_OFF : [256]u32 = [0; 256];
pub var SRC_LEN : [256]u32 = [0; 256];
pub var SRC_SHA : [16384]u8 = [0; 16384];
pub var SRC_STORE : [1048576]u8 = [0; 1048576];
pub var SRC_USED : u32 = 0;
pub var VER_STATE : u32 = 0;
pub var VER_PENDING : bool = false;
pub var VER_T0 : f64 = 0.0;
pub var VER_MS : f64 = 0.0;
pub var VER_BYTES : u32 = 0;
pub var VER_SAME : bool = false;
pub var VER_SHA : [64]u8 = [0; 64];
pub var CODE : [1048576]u8 = [0; 1048576];
pub var CODE_N : u32 = 0;
pub var RES : [1048576]u8 = [0; 1048576];
pub var SC : [1024]u8 = [0; 1024];
pub var SC_N : u32 = 0;
pub var F_K : [40]u32 = [0; 40];
pub var F_R : [40]i64 = [0; 40];
pub var EQ_KIND : [8]u32 = [0; 8];
pub var EQ_ARG : [8]u32 = [0; 8];
pub var EQ_N : u32 = 0;
pub var P_DAY : i64 = -1;
pub var P_PRACTICE : i64 = -1;
pub var P_G : [6]u32 = [0; 6];
pub var P_GN : u32 = 0;
pub var KV : [4096]u8 = [0; 4096];
pub var BT_K : [64]i64 = [-1; 64];
pub var BT_V : [64]i64 = [-1; 64];
pub var SHA_H : [8]u32 = [0; 8];
pub var SHA_W : [64]u32 = [0; 64];
pub var SHA_O : [64]u8 = [0; 64];

// --- writing ---------------------------------------------------------------------------------------

fn gt_esc(o: []u8, n: u32, b: u8) -> u32 {
    if (RAW_OUT) { return put(o, n, b); }
    if (b == 13) { return raw(o, n, "&#13;"); }
    return put_escaped(o, n, b);
}

fn gt_text(o: []u8, n0: u32, s: []const u8) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    while (i < s.len) {
        n = gt_esc(o, n, s[i]);
        i = i + 1;
    }
    return n;
}

/// A JSON string value as HTML text.
fn gt_jstr(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    var n : u32 = n0;
    if (kind(d, sp) != J_STRING) { return n; }
    const hi : usize = span_hi(sp) - 1;
    var p : usize = span_lo(sp) + 1;
    while (p < hi) {
        if (d[p] == 92 and p + 1 < hi) {
            const e : u32 = escape_at(d, p + 1, hi);
            const cp : u32 = e / 16;
            const w : u32 = cp_utf8_len(cp);
            var j : u32 = 0;
            while (j < w) {
                n = gt_esc(o, n, cp_utf8_byte(cp, j));
                j = j + 1;
            }
            p = p + 1 + ((e % 16) as usize);
        } else {
            n = gt_esc(o, n, d[p]);
            p = p + 1;
        }
    }
    return n;
}

fn gt_jraw(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    if (sp < 0) { return n0; }
    var n : u32 = n0;
    var q : usize = span_lo(sp);
    const e : usize = span_hi(sp);
    while (q < e) {
        n = put(o, n, d[q]);
        q = q + 1;
    }
    return n;
}

/// String(v) of a JSON value.
fn gt_jstring(o: []u8, n: u32, d: []const u8, sp: i64) -> u32 {
    const k : u8 = kind(d, sp);
    if (k == J_STRING) { return gt_jstr(o, n, d, sp); }
    if (k == J_NUMBER) { return gt_jraw(o, n, d, sp); }
    if (k == J_TRUE) { return raw(o, n, "true"); }
    if (k == J_FALSE) { return raw(o, n, "false"); }
    if (k == J_NULL) { return raw(o, n, "null"); }
    return raw(o, n, "undefined");
}

fn gt_d() -> []const u8 {
    return DATA[0..(DATA_N as usize)];
}

/// The decoded string at sp copied to dst (cut at dst's length); its length.
fn gt_jcopy(dst: []u8, d: []const u8, sp: i64) -> u32 {
    var n : u32 = 0;
    if (kind(d, sp) != J_STRING) { return 0; }
    const hi : usize = span_hi(sp) - 1;
    var p : usize = span_lo(sp) + 1;
    while (p < hi) {
        if (d[p] == 92 and p + 1 < hi) {
            const e : u32 = escape_at(d, p + 1, hi);
            const cp : u32 = e / 16;
            const w : u32 = cp_utf8_len(cp);
            var j : u32 = 0;
            while (j < w) {
                if ((n as usize) < dst.len) { dst[n as usize] = cp_utf8_byte(cp, j); n = n + 1; }
                j = j + 1;
            }
            p = p + 1 + ((e % 16) as usize);
        } else {
            if ((n as usize) < dst.len) { dst[n as usize] = d[p]; n = n + 1; }
            p = p + 1;
        }
    }
    return n;
}

fn gt_sc_reset() -> u32 {
    SC_N = 0;
    return 0;
}

/// Bytes into the scratch text; the packed span (lo, hi) of what was written.
fn gt_sc_put(s: []const u8) -> i64 {
    const lo : u32 = SC_N;
    var i : usize = 0;
    while (i < s.len and (SC_N as usize) < 1024) {
        SC[SC_N as usize] = s[i];
        SC_N = SC_N + 1;
        i = i + 1;
    }
    return jspan(lo as usize, SC_N as usize);
}

fn gt_clear() -> u32 {
    var i : usize = 0;
    while (i < 40) {
        F_K[i] = W_V_NONE;
        F_R[i] = 0;
        i = i + 1;
    }
    return 0;
}

/// Slot of a name in W_NAMES (40 when it is none).
fn gt_slot(name: []const u8) -> u32 {
    var idx : u32 = 0;
    var i : usize = 0;
    while (i < W_NAMES.len) {
        var j : usize = i;
        while (j < W_NAMES.len and W_NAMES[j] != 32) { j = j + 1; }
        if (name_is(W_NAMES, i, j, name)) { return idx; }
        idx = idx + 1;
        i = j + 1;
    }
    return 40;
}

fn gt_set(name: []const u8, k: u32, r: i64) -> u32 {
    const s : u32 = gt_slot(name);
    if (s < 40) {
        F_K[s as usize] = k;
        F_R[s as usize] = r;
    }
    return 0;
}

fn gt_val(o: []u8, n: u32, k: u32, r: i64) -> u32 {
    if (k == W_V_STR) { return gt_jstr(o, n, gt_d(), r); }
    if (k == W_V_RAW) { return gt_jstring(o, n, gt_d(), r); }
    if (k == W_V_NUM) { return num(o, n, r as u64); }
    if (k == W_V_SC) { return gt_text(o, n, SC[span_lo(r)..span_hi(r)]); }
    return n;
}

/// fill(template, vars): {name} replaced by the value set for it, a name with none stays as written.
fn gt_fill(o: []u8, n0: u32, t: []const u8) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    while (i < t.len) {
        var done : bool = false;
        if (t[i] == 123) {
            var j : usize = i + 1;
            while (j < t.len and is_word_byte(t[j])) { j = j + 1; }
            if (j > i + 1 and j < t.len and t[j] == 125) {
                const s : u32 = gt_slot(t[(i + 1)..j]);
                if (s < 40 and F_K[s as usize] != W_V_NONE) {
                    n = gt_val(o, n, F_K[s as usize], F_R[s as usize]);
                    i = j + 1;
                    done = true;
                }
            }
        }
        if (!done) {
            n = gt_esc(o, n, t[i]);
            i = i + 1;
        }
    }
    return n;
}

// --- the rule's dates and the address ------------------------------------------------------------------------

/// YYYY-MM-DD of a day number (toISOString().slice(0, 10)), written to the scratch text.
fn gt_iso_day(day: u32) -> i64 {
    const z : u64 = (day as u64) + 719468;
    const era : u64 = z / 146097;
    const doe : u64 = z % 146097;
    const yoe : u64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    var y : u64 = yoe + era * 400;
    const doy : u64 = doe - (365 * yoe + yoe / 4 - yoe / 100);
    const mp : u64 = (5 * doy + 2) / 153;
    const dd : u64 = doy - (153 * mp + 2) / 5 + 1;
    var m : u64 = mp + 3;
    if (mp >= 10) { m = mp - 9; }
    if (m <= 2) { y = y + 1; }
    var b : [16]u8 = [0; 16];
    b[0] = (48 + (y / 1000) % 10) as u8;
    b[1] = (48 + (y / 100) % 10) as u8;
    b[2] = (48 + (y / 10) % 10) as u8;
    b[3] = (48 + y % 10) as u8;
    b[4] = 45;
    b[5] = (48 + m / 10) as u8;
    b[6] = (48 + m % 10) as u8;
    b[7] = 45;
    b[8] = (48 + dd / 10) as u8;
    b[9] = (48 + dd % 10) as u8;
    return gt_sc_put(b[0..10]);
}

/// Before the epoch day there is no puzzle yet, so the clock is held at Gatle #1.
fn gt_today() -> u32 {
    var t : u32 = (js_floor(WALL / W_DAY_MS)) as u32;
    if (t < K_EPOCH_DAY) { t = K_EPOCH_DAY; }
    return t;
}

/// URLSearchParams' percent-decoding of s[lo .. hi) into dst: + is a space, %XX a byte; returns the length.
fn gt_unescape(dst: []u8, s: []const u8, lo: usize, hi: usize) -> u32 {
    var n : u32 = 0;
    var i : usize = lo;
    while (i < hi) {
        var b : u8 = s[i];
        if (b == 43) { b = 32; }
        if (b == 37 and i + 2 < hi and jv_digit_value(s[i + 1]) < 16 and jv_digit_value(s[i + 2]) < 16) {
            b = (jv_digit_value(s[i + 1]) * 16 + jv_digit_value(s[i + 2])) as u8;
            i = i + 2;
        }
        if ((n as usize) < dst.len) { dst[n as usize] = b; n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// /^\d{1,7}$/ then Number(): the value, or -1.
fn gt_int(s: []const u8) -> i64 {
    if (s.len < 1 or s.len > 7) { return -1; }
    var v : i64 = 0;
    var i : usize = 0;
    while (i < s.len) {
        if (s[i] < 48 or s[i] > 57) { return -1; }
        v = v * 10 + ((s[i] - 48) as i64);
        i = i + 1;
    }
    return v;
}

/// rule.js parseHash: "#d=<day>&g=<g1>.<g2>" or "#p=<index>&g=..."; anything unreadable is ignored.
fn gt_parse_hash(h: []const u8) -> u32 {
    P_DAY = -1;
    P_PRACTICE = -1;
    P_GN = 0;
    var start : usize = 0;
    if (h.len > 0 and h[0] == 35) { start = 1; }
    var seen_d : bool = false;
    var seen_p : bool = false;
    var seen_g : bool = false;
    var key : [64]u8 = [0; 64];
    var i : usize = start;
    while (i <= h.len) {
        var j : usize = i;
        while (j < h.len and h[j] != 38) { j = j + 1; }
        // the pair is h[i .. j)
        if (j > i) {
            var eq : usize = i;
            while (eq < j and h[eq] != 61) { eq = eq + 1; }
            const kl : u32 = gt_unescape(key[0..64], h, i, eq);
            var vs : usize = eq;
            if (eq < j) { vs = eq + 1; }
            if (kl == 1 and key[0] == 100 and !seen_d) {
                seen_d = true;
                const vl : u32 = gt_unescape(KV[0..4096], h, vs, j);
                P_DAY = gt_int(KV[0..(vl as usize)]);
            }
            if (kl == 1 and key[0] == 112 and !seen_p) {
                seen_p = true;
                const vl : u32 = gt_unescape(KV[0..4096], h, vs, j);
                P_PRACTICE = gt_int(KV[0..(vl as usize)]);
            }
            if (kl == 1 and key[0] == 103 and !seen_g) {
                seen_g = true;
                const vl : u32 = gt_unescape(KV[0..4096], h, vs, j);
                var a : usize = 0;
                while (a <= (vl as usize)) {
                    var z : usize = a;
                    while (z < (vl as usize) and KV[z] != 46) { z = z + 1; }
                    const g : i64 = gt_int(KV[a..z]);
                    if (g >= 0 and g <= (K_MAX_GUESS as i64) and P_GN < (K_GUESSES as u32)) {
                        P_G[P_GN as usize] = g as u32;
                        P_GN = P_GN + 1;
                    }
                    a = z + 1;
                }
            }
        }
        i = j + 1;
    }
    return 0;
}

/// rule.js formatHash: "#d=<day>" or "#p=<index>", then "&g=1.2.3" when there are guesses.
fn gt_format_hash(dst: []u8) -> u32 {
    var n : u32 = put(dst, 0, 35);
    if (G_PRACTICE) {
        n = raw(dst, n, "p=");
        n = num(dst, n, G_INDEX as u64);
    } else {
        n = raw(dst, n, "d=");
        n = num(dst, n, G_DAY as u64);
    }
    if (G_N > 0) {
        n = raw(dst, n, "&g=");
        var i : u32 = 0;
        while (i < G_N) {
            if (i > 0) { n = put(dst, n, 46); }
            n = num(dst, n, G_GUESS[i as usize] as u64);
            i = i + 1;
        }
    }
    return n;
}

// --- the games the visit remembers -------------------------------------------------------------------------

fn gt_mem_key(practice: bool, v: u32) -> u32 {
    if (practice) { return 2147483648 + v; }
    return v;
}

fn gt_mem_find(key: u32) -> i64 {
    var i : u32 = 0;
    while (i < MEM_USED) {
        if (MEM_KEY[i as usize] == key) { return i as i64; }
        i = i + 1;
    }
    return -1;
}

/// memory.get(key) || [] into G_GUESS.
fn gt_mem_load(key: u32) -> u32 {
    G_N = 0;
    const at : i64 = gt_mem_find(key);
    if (at >= 0) {
        const base : usize = (at as usize) * 6;
        G_N = MEM_N[at as usize];
        var i : usize = 0;
        while (i < (G_N as usize)) {
            G_GUESS[i] = MEM_GUESS[base + i];
            i = i + 1;
        }
    }
    return 0;
}

fn gt_mem_save() -> u32 {
    const key : u32 = gt_mem_key(G_PRACTICE, G_INDEX);
    var k2 : u32 = key;
    if (!G_PRACTICE) { k2 = G_DAY; }
    var at : i64 = gt_mem_find(k2);
    if (at < 0) {
        if (MEM_USED < W_MEM_MAX) {
            at = MEM_USED as i64;
            MEM_USED = MEM_USED + 1;
        } else {
            at = MEM_NEXT as i64;
            MEM_NEXT = (MEM_NEXT + 1) % W_MEM_MAX;
        }
        MEM_KEY[at as usize] = k2;
    }
    const base : usize = (at as usize) * 6;
    MEM_N[at as usize] = G_N;
    var i : usize = 0;
    while (i < (G_N as usize)) {
        MEM_GUESS[base + i] = G_GUESS[i];
        i = i + 1;
    }
    return 0;
}

fn gt_game_from_hash() -> u32 {
    gt_parse_hash(HASH_IN[0..(HASH_IN_N as usize)]);
    if (P_PRACTICE >= 0 and P_PRACTICE < (POOL_N as i64)) {
        G_PRACTICE = true;
        G_DAY = 0;
        G_INDEX = P_PRACTICE as u32;
        G_N = P_GN;
        var i : usize = 0;
        while (i < (P_GN as usize)) {
            G_GUESS[i] = P_G[i];
            i = i + 1;
        }
        return 0;
    }
    const t : u32 = gt_today();
    var day : u32 = t;
    if (P_DAY >= (K_EPOCH_DAY as i64) and P_DAY <= (t as i64)) { day = P_DAY as u32; }
    G_PRACTICE = false;
    G_DAY = day;
    G_INDEX = day_index(day as u64, K_EPOCH_DAY as u64, POOL_N as u64) as u32;
    if (P_DAY == (day as i64) and P_GN > 0) {
        G_N = P_GN;
        var i : usize = 0;
        while (i < (P_GN as usize)) {
            G_GUESS[i] = P_G[i];
            i = i + 1;
        }
    } else {
        gt_mem_load(day);
    }
    return 0;
}

/// saveHash(): the game is remembered for the visit and its fragment is to be shown.
fn gt_save() -> u32 {
    gt_mem_save();
    HASH_DIRTY = true;
    return 0;
}

/// newPractice(): a random module, never the one on the page.
fn gt_new_practice() -> u32 {
    var i : u32 = js_floor(RAND * (POOL_N as f64)) as u32;
    if (POOL_N > 1 and i == G_INDEX) { i = (i + 1) % POOL_N; }
    G_PRACTICE = true;
    G_DAY = 0;
    G_INDEX = i;
    gt_mem_load(gt_mem_key(true, i));
    return 0;
}

// --- effects ---------------------------------------------------------------------------------------------

fn gt_eff_clear() -> u32 {
    EQ_N = 0;
    return 0;
}

fn gt_eff(k: u32, a: u32) -> u32 {
    if (EQ_N < 8) {
        EQ_KIND[EQ_N as usize] = k;
        EQ_ARG[EQ_N as usize] = a;
        EQ_N = EQ_N + 1;
    }
    return 0;
}

// --- the pool and the sources -------------------------------------------------------------------------------

fn gt_pf(sp: i64, key: []const u8) -> i64 {
    return obj_get(gt_d(), sp, key);
}

fn gt_cur() -> i64 {
    return POOL_SP[G_INDEX as usize];
}

/// The first puzzle whose src is the same as that of puzzle i: sources are fetched once per path.
fn gt_src_slot(i: u32) -> u32 {
    const d : []const u8 = gt_d();
    const s : i64 = obj_get(d, POOL_SP[i as usize], "src");
    var j : u32 = 0;
    while (j < i) {
        const t : i64 = obj_get(d, POOL_SP[j as usize], "src");
        if (span_hi(s) - span_lo(s) == span_hi(t) - span_lo(t)) {
            var k : usize = 0;
            var same : bool = true;
            while (same and k < span_hi(s) - span_lo(s)) {
                if (d[span_lo(s) + k] != d[span_lo(t) + k]) { same = false; }
                k = k + 1;
            }
            if (same) { return j; }
        }
        j = j + 1;
    }
    return i;
}

/// sourceOf(p): the file is asked for once.
fn gt_src_need() -> u32 {
    const slot : u32 = gt_src_slot(G_INDEX);
    if (SRC_STATE[slot as usize] == 0) {
        SRC_STATE[slot as usize] = 1;
        gt_eff(1, slot);
    }
    return 0;
}

fn gt_src_state() -> u32 {
    return SRC_STATE[gt_src_slot(G_INDEX) as usize];
}

fn gt_src_bytes() -> []const u8 {
    const slot : usize = gt_src_slot(G_INDEX) as usize;
    return SRC_STORE[(SRC_OFF[slot] as usize)..((SRC_OFF[slot] + SRC_LEN[slot]) as usize)];
}

/// The decoded string of a pool field equals bytes.
fn gt_str_is(d: []const u8, sp: i64, b: []const u8) -> bool {
    if (kind(d, sp) != J_STRING or str_len(d, sp) != (b.len as u32)) { return false; }
    var k : usize = 0;
    while (k < b.len) {
        if (str_byte(d, sp, k as u32) != b[k]) { return false; }
        k = k + 1;
    }
    return true;
}

pub fn w_data_failed(i: u32) -> u32 {
    gt_eff_clear();
    DATA_STATE = 2;
    return 0;
}

pub fn w_data(i: u32, s: []const u8) -> u32 {
    gt_eff_clear();
    if (s.len > (W_DATA_CAP as usize)) {
        DATA_STATE = 2;
        return 0;
    }
    var k : usize = 0;
    while (k < s.len) {
        DATA[k] = s[k];
        k = k + 1;
    }
    DATA_N = s.len as u32;
    DATA_STATE = 2;
    const d : []const u8 = gt_d();
    if (!jv_valid(d)) { return 0; }
    D_ROOT = root(d);
    D_POOL = obj_get(d, D_ROOT, "pool");
    if (kind(d, D_POOL) != J_ARRAY) { return 0; }
    // the puzzles, once; a pool of none is a failure
    var p : usize = ts_first_of(d, D_POOL);
    POOL_N = 0;
    ZEROFF = 0;
    var total : u32 = 0;
    while (p + 1 < span_hi(D_POOL)) {
        if (POOL_N < W_POOL_MAX) {
            const sp : i64 = jspan(p, value_end(d, p));
            POOL_SP[POOL_N as usize] = sp;
            POOL_N = POOL_N + 1;
        }
        total = total + 1;
        const e : usize = value_end(d, p);
        var q : usize = skip_ws(d, e);
        if (q < span_hi(D_POOL) and d[q] == 44) { q = skip_ws(d, q + 1); }
        p = q;
    }
    if (total == 0) { return 0; }
    var z : u32 = 0;
    var i2 : u32 = 0;
    while (i2 < POOL_N) {
        const ff : i64 = obj_get(d, obj_get(d, POOL_SP[i2 as usize], "answer"), "ff");
        if (kind(d, ff) == J_NUMBER and num_f64(d, ff) == 0.0) { z = z + 1; }
        i2 = i2 + 1;
    }
    ZEROFF = z;
    D_YOSYS = obj_get(d, D_ROOT, "yosys");
    D_CORPUS = obj_get(d, D_ROOT, "corpus");
    D_DATE = obj_get(d, D_ROOT, "date_utc");
    DATA_STATE = 1;
    gt_game_from_hash();
    gt_save();
    gt_draw_event();
    return 0;
}

fn ts_first_of(d: []const u8, sp: i64) -> usize {
    return skip_ws(d, span_lo(sp) + 1);
}

/// draw(): the whole page is made again.
fn gt_draw_event() -> u32 {
    HDR_T = gt_today();
    CLEAR_INPUT = true;
    MSG_KIND = 0;
    DET_OPEN = false;
    SHARE_EPOCH = SHARE_EPOCH + 1;
    COPY_MSG = 0;
    gt_pane_start();
    return 0;
}

/// show(): the body of the code box is made for the tab that is open.
fn gt_pane_start() -> u32 {
    VER_STATE = 0;
    VER_PENDING = false;
    gt_src_need();
    if (V_TAB == 1) {
        VER_PENDING = true;
        VER_T0 = NOW;
        if (gt_src_state() == 3) {
            VER_PENDING = false;
            VER_STATE = 2;
        }
    }
    return 0;
}

pub fn w_fetched(id: u32, ok_: u32, s: []const u8) -> u32 {
    gt_eff_clear();
    if (id >= 256) { return 0; }
    const slot : usize = id as usize;
    if (ok_ == 0) {
        SRC_STATE[slot] = 3;
    } else {
        var from : usize = 0;
        if (s.len >= 3 and s[0] == 239 and s[1] == 187 and s[2] == 191) { from = 3; }
        const n : usize = s.len - from;
        if ((SRC_USED as usize) + n > (W_SRC_TOTAL as usize)) {
            SRC_STATE[slot] = 3;
        } else {
            var k : usize = 0;
            while (k < n) {
                SRC_STORE[(SRC_USED as usize) + k] = s[from + k];
                k = k + 1;
            }
            SRC_OFF[slot] = SRC_USED;
            SRC_LEN[slot] = n as u32;
            SRC_USED = SRC_USED + (n as u32);
            sha256_hex(SRC_STORE[(SRC_OFF[slot] as usize)..((SRC_OFF[slot] + SRC_LEN[slot]) as usize)], SHA_H[0..8], SHA_W[0..64], SHA_O[0..64]);
            var b : usize = 0;
            while (b < 64) {
                SRC_SHA[slot * 64 + b] = SHA_O[b];
                b = b + 1;
            }
            SRC_STATE[slot] = 2;
        }
    }
    if (VER_PENDING and DATA_STATE == 1 and gt_src_slot(G_INDEX) == id and SRC_STATE[slot] == 3) {
        VER_PENDING = false;
        VER_STATE = 2;
    }
    return 0;
}

pub fn w_compile_need(dst: []u8) -> u32 {
    if (!VER_PENDING or DATA_STATE != 1 or gt_src_state() != 2) { return 0; }
    const s : []const u8 = gt_src_bytes();
    if (s.len > dst.len or s.len > (W_COMPILE_CAP as usize)) {
        VER_PENDING = false;
        VER_STATE = 2;
        return 0;
    }
    var k : usize = 0;
    while (k < s.len) {
        dst[k] = s[k];
        k = k + 1;
    }
    return (s.len as u32) + 1;
}

/// Length in UTF-16 units of UTF-8 text (code.length).
fn gt_utf16_len(b: []const u8) -> u32 {
    var n : u32 = 0;
    var i : usize = 0;
    while (i < b.len) {
        if ((b[i] & 192) != 128) {
            n = n + 1;
            if (b[i] >= 240) { n = n + 1; }
        }
        i = i + 1;
    }
    return n;
}

pub fn w_compile_give(s: []const u8, ok_: u32, t0: f64, t1: f64) -> u32 {
    VER_PENDING = false;
    VER_STATE = 2;
    if (ok_ != 0 or s.len > (W_RES_CAP as usize)) { return 0; }
    var k : usize = 0;
    while (k < s.len) {
        RES[k] = s[k];
        k = k + 1;
    }
    const r : []const u8 = RES[0..s.len];
    const code : i64 = obj_get(r, obj_get(r, obj_get(r, root(r), "targets"), "verilog"), "code");
    if (kind(r, code) != J_STRING or str_len(r, code) == 0) { return 0; }
    // the Verilog goes through a text of UTF-16 units in tool.js; its bytes are the UTF-8 of it
    const cn : u32 = gt_jcopy(CODE[0..1048576], r, code);
    if (cn >= W_CODE_CAP) { return 0; }
    CODE_N = cn;
    sha256_hex(CODE[0..(cn as usize)], SHA_H[0..8], SHA_W[0..64], SHA_O[0..64]);
    var b : usize = 0;
    while (b < 64) {
        VER_SHA[b] = SHA_O[b];
        b = b + 1;
    }
    const want : i64 = gt_pf(gt_cur(), "verilog_sha256");
    VER_SAME = gt_str_is(gt_d(), want, VER_SHA[0..64]);
    VER_BYTES = gt_utf16_len(CODE[0..(cn as usize)]);
    VER_MS = t1 - VER_T0;
    VER_STATE = 1;
    return 0;
}

// --- the page ------------------------------------------------------------------------------------------------------

pub var SHT : [1024]u8 = [0; 1024];

fn gt_utf8(o: []u8, n0: u32, cp: u32) -> u32 {
    var n : u32 = n0;
    const w : u32 = cp_utf8_len(cp);
    var k : u32 = 0;
    while (k < w) {
        n = put(o, n, cp_utf8_byte(cp, k));
        k = k + 1;
    }
    return n;
}

/// The base of the page with its last two directories dropped, then the path: new URL('../../' + path, base).href
fn gt_url(o: []u8, n0: u32, rel: []const u8) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    // the origin: up to the first slash after "://"
    var o_end : usize = 0;
    while (i + 2 < (BASE_N as usize)) {
        if (BASE[i] == 58 and BASE[i + 1] == 47 and BASE[i + 2] == 47) { o_end = i + 3; i = BASE_N as usize; }
        i = i + 1;
    }
    while (o_end < (BASE_N as usize) and BASE[o_end] != 47) { o_end = o_end + 1; }
    // the segments of the directory path
    var segs : u32 = 0;
    var q : usize = o_end;
    while (q < (BASE_N as usize)) {
        if (BASE[q] == 47 and q + 1 < (BASE_N as usize) and BASE[q + 1] != 47) { segs = segs + 1; }
        q = q + 1;
    }
    var keep : u32 = 0;
    if (segs > 2) { keep = segs - 2; }
    // write the origin and the first `keep` segments
    var k : usize = 0;
    while (k < o_end) {
        n = put_escaped(o, n, BASE[k]);
        k = k + 1;
    }
    var seen : u32 = 0;
    var p : usize = o_end;
    while (p < (BASE_N as usize) and seen < keep) {
        if (BASE[p] == 47 and p + 1 < (BASE_N as usize) and BASE[p + 1] != 47) {
            seen = seen + 1;
            var e : usize = p + 1;
            while (e < (BASE_N as usize) and BASE[e] != 47) { e = e + 1; }
            var c : usize = p;
            while (c < e) {
                n = put_escaped(o, n, BASE[c]);
                c = c + 1;
            }
            p = e;
        } else {
            p = p + 1;
        }
    }
    n = put(o, n, 47);
    return gt_text(o, n, rel);
}

/// Is the line src[lo .. hi) nothing but a comment: white space, then ; or //.
fn gt_is_comment(src: []const u8, lo: usize, hi: usize) -> bool {
    var p : usize = lo;
    var w : u32 = 1;
    while (p < hi and w > 0) {
        w = jv_ws_at(src, p as u32, hi as u32);
        p = p + (w as usize);
    }
    if (p >= hi) { return false; }
    if (src[p] == 59) { return true; }
    return src[p] == 47 and p + 1 < hi and src[p + 1] == 47;
}

fn gt_src_pane(o: []u8, n0: u32) -> u32 {
    const st : u32 = gt_src_state();
    var n : u32 = n0;
    if (st == 3) {
        n = raw(o, n, "<p class=\"gt-bad\">");
        n = gt_text(o, n, SAY_SOURCE_FAILED);
        return raw(o, n, "</p>");
    }
    if (st != 2) {
        n = raw(o, n, "<p class=\"gt-note\">");
        n = gt_text(o, n, SAY_LOADING);
        return raw(o, n, "</p>");
    }
    const src : []const u8 = gt_src_bytes();
    var end : usize = src.len;
    if (end > 0 and src[end - 1] == 10) { end = end - 1; }
    // the lines: src[ls .. le) separated by line feeds
    var hidden : u32 = 0;
    var shown : u32 = 0;
    var first_empty : bool = false;
    var ls : usize = 0;
    var count_done : bool = false;
    while (!count_done) {
        var le : usize = ls;
        while (le < end and src[le] != 10) { le = le + 1; }
        const com : bool = gt_is_comment(src, ls, le);
        if (com) { hidden = hidden + 1; }
        if (V_COMMENTS or !com) {
            if (shown == 0 and le == ls) { first_empty = true; }
            shown = shown + 1;
        }
        if (le >= end) { count_done = true; } else { ls = le + 1; }
    }
    n = raw(o, n, "<pre class=\"gt-pre\" tabindex=\"0\">");
    if (first_empty and shown >= 2) { n = put(o, n, 10); }
    var written : u32 = 0;
    ls = 0;
    count_done = false;
    while (!count_done) {
        var le : usize = ls;
        while (le < end and src[le] != 10) { le = le + 1; }
        if (V_COMMENTS or !gt_is_comment(src, ls, le)) {
            if (written > 0) { n = put(o, n, 10); }
            written = written + 1;
            var c : usize = ls;
            while (c < le) {
                n = gt_esc(o, n, src[c]);
                c = c + 1;
            }
        }
        if (le >= end) { count_done = true; } else { ls = le + 1; }
    }
    n = raw(o, n, "</pre><div class=\"gt-row\"><button type=\"button\" class=\"t27-btn\" aria-pressed=\"");
    if (V_COMMENTS) { n = raw(o, n, "true"); } else { n = raw(o, n, "false"); }
    n = raw(o, n, "\">");
    if (V_COMMENTS) {
        n = gt_text(o, n, SAY_HIDE_COMMENTS);
    } else {
        gt_clear();
        gt_set("n", W_V_NUM, hidden as i64);
        n = gt_fill(o, n, SAY_SHOW_COMMENTS);
    }
    n = raw(o, n, "</button><a href=\"");
    const d : []const u8 = gt_d();
    var pb : [512]u8 = [0; 512];
    const pl : u32 = gt_jcopy(pb[0..512], d, gt_pf(gt_cur(), "src"));
    n = gt_url(o, n, pb[0..(pl as usize)]);
    n = raw(o, n, "\" target=\"_blank\" rel=\"noopener\" class=\"gt-meta\">");
    n = gt_jstr(o, n, d, gt_pf(gt_cur(), "path"));
    n = raw(o, n, "</a></div>");
    // the digest of the source against the one yosys read
    const want : i64 = gt_pf(gt_cur(), "spec_sha256");
    const slot : usize = gt_src_slot(G_INDEX) as usize;
    if (!gt_str_is(d, want, SRC_SHA[(slot * 64)..(slot * 64 + 64)])) {
        n = raw(o, n, "<p class=\"gt-bad\">");
        n = gt_text(o, n, SAY_SOURCE_DRIFT);
        n = raw(o, n, "</p>");
    }
    return n;
}

fn gt_ver_pane(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    if (VER_STATE == 0) {
        n = raw(o, n, "<p class=\"gt-note\">");
        n = gt_text(o, n, SAY_COMPILING);
        return raw(o, n, "</p>");
    }
    if (VER_STATE == 2) {
        n = raw(o, n, "<p class=\"gt-bad\">");
        n = gt_text(o, n, SAY_COMPILE_FAILED);
        return raw(o, n, "</p>");
    }
    n = raw(o, n, "<pre class=\"gt-pre\" tabindex=\"0\">");
    if (CODE_N > 0 and CODE[0] == 10) { n = put(o, n, 10); }
    n = gt_text(o, n, CODE[0..(CODE_N as usize)]);
    n = raw(o, n, "</pre>");
    if (VER_SAME) { n = raw(o, n, "<p class=\"gt-note\">"); } else { n = raw(o, n, "<p class=\"gt-bad\">"); }
    gt_clear();
    gt_sc_reset();
    var tb : [32]u8 = [0; 32];
    const ml : u32 = js_str_num(tb[0..32], 0, js_round(VER_MS));
    gt_set("ms", W_V_SC, gt_sc_put(tb[0..(ml as usize)]));
    gt_set("sha", W_V_SC, gt_sc_put(VER_SHA[0..12]));
    if (VER_SAME) {
        gt_set("bytes", W_V_NUM, VER_BYTES as i64);
        n = gt_fill(o, n, SAY_VERILOG_SAME);
    } else {
        var wb : [64]u8 = [0; 64];
        const wl : u32 = gt_jcopy(wb[0..64], gt_d(), gt_pf(gt_cur(), "verilog_sha256"));
        var wn : usize = wl as usize;
        if (wn > 12) { wn = 12; }
        gt_set("was", W_V_SC, gt_sc_put(wb[0..wn]));
        n = gt_fill(o, n, SAY_VERILOG_DRIFT);
    }
    return raw(o, n, "</p>");
}

fn gt_code_pane(o: []u8, n0: u32) -> u32 {
    const d : []const u8 = gt_d();
    const p : i64 = gt_cur();
    var n : u32 = raw(o, n0, "<div class=\"gt-code\"><p class=\"gt-module\"><strong>");
    n = gt_jstr(o, n, d, gt_pf(p, "id"));
    n = raw(o, n, "</strong> <span class=\"gt-meta\">");
    gt_clear();
    gt_set("top", W_V_STR, gt_pf(p, "top"));
    gt_set("code", W_V_RAW, gt_pf(p, "code_lines"));
    gt_set("lines", W_V_RAW, gt_pf(p, "lines"));
    n = gt_fill(o, n, SAY_MODULE_META);
    n = raw(o, n, "</span></p><div class=\"gt-tabs\" role=\"group\">");
    var i : u32 = 0;
    while (i < 2) {
        n = raw(o, n, "<button type=\"button\" class=\"t27-btn\" aria-pressed=\"");
        if (V_TAB == i) { n = raw(o, n, "true"); } else { n = raw(o, n, "false"); }
        n = raw(o, n, "\">");
        n = gt_text(o, n, SAY_TABS[i as usize]);
        n = raw(o, n, "</button>");
        i = i + 1;
    }
    n = raw(o, n, "</div><div class=\"gt-codebody\">");
    if (V_TAB == 0) { n = gt_src_pane(o, n); } else { n = gt_ver_pane(o, n); }
    return raw(o, n, "</div></div>");
}

fn gt_header(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<div class=\"gt-head\"><div class=\"gt-modes\" role=\"group\">");
    var i : u32 = 0;
    while (i < 2) {
        n = raw(o, n, "<button type=\"button\" class=\"t27-btn\" aria-pressed=\"");
        var pressed : bool = i == 0;
        if (G_PRACTICE) { pressed = i == 1; }
        if (pressed) { n = raw(o, n, "true"); } else { n = raw(o, n, "false"); }
        n = raw(o, n, "\">");
        n = gt_text(o, n, SAY_MODES[i as usize]);
        n = raw(o, n, "</button>");
        i = i + 1;
    }
    n = raw(o, n, "</div>");
    if (G_PRACTICE) {
        n = raw(o, n, "<button type=\"button\" class=\"t27-btn\">");
        n = gt_text(o, n, SAY_NEW_PRACTICE);
        n = raw(o, n, "</button>");
    }
    n = raw(o, n, "<p class=\"gt-line\">");
    gt_clear();
    gt_sc_reset();
    gt_set("size", W_V_NUM, POOL_N as i64);
    if (G_PRACTICE) {
        n = gt_fill(o, n, SAY_PRACTICE_LINE);
    } else {
        gt_set("n", W_V_NUM, puzzle_number(G_DAY as u64, K_EPOCH_DAY as u64) as i64);
        gt_set("date", W_V_SC, gt_iso_day(G_DAY));
        if (G_DAY == HDR_T) {
            gt_set("i", W_V_NUM, (G_INDEX as i64) + 1);
            n = gt_fill(o, n, SAY_DAILY_LINE);
        } else {
            gt_set("today", W_V_NUM, puzzle_number(HDR_T as u64, K_EPOCH_DAY as u64) as i64);
            n = gt_fill(o, n, SAY_PAST_LINE);
        }
    }
    return raw(o, n, "</p></div>");
}

/// The cut of yosys' version text tool.js makes: version.replace(/\s*\(.*$/, '').
fn gt_version(dst: []u8) -> u32 {
    const d : []const u8 = gt_d();
    var raw_v : [256]u8 = [0; 256];
    const vl : u32 = gt_jcopy(raw_v[0..256], d, obj_get(d, D_YOSYS, "version"));
    var cut : u32 = vl;
    var i : u32 = 0;
    var found : bool = false;
    while (i < vl and !found) {
        if (raw_v[i as usize] == 40) {
            // no line terminator after the bracket (the dot does not match one)
            var clean : bool = true;
            var j : u32 = i + 1;
            while (j < vl) {
                const c : u8 = raw_v[j as usize];
                if (c == 10 or c == 13) { clean = false; }
                if (c == 226 and j + 2 < vl and raw_v[(j + 1) as usize] == 128 and (raw_v[(j + 2) as usize] == 168 or raw_v[(j + 2) as usize] == 169)) { clean = false; }
                j = j + 1;
            }
            if (clean) {
                found = true;
                cut = i;
            }
        }
        i = i + 1;
    }
    if (found) {
        // the white space before the bracket goes too
        var back : bool = true;
        while (back and cut > 0) {
            back = false;
            const c : u8 = raw_v[(cut - 1) as usize];
            if (jv_is_ws(c)) { cut = cut - 1; back = true; }
            if (!back and cut >= 2 and jv_ws_before(raw_v[0..256], 0, cut) == 2) { cut = cut - 2; back = true; }
            if (!back and cut >= 3 and jv_ws_before(raw_v[0..256], 0, cut) == 3) { cut = cut - 3; back = true; }
        }
    }
    var k : u32 = 0;
    while (k < cut and (k as usize) < dst.len) {
        dst[k as usize] = raw_v[k as usize];
        k = k + 1;
    }
    return k;
}

fn gt_truth() -> u64 {
    const lut : i64 = gt_pf(gt_pf(gt_cur(), "answer"), "lut");
    if (kind(gt_d(), lut) != J_NUMBER) { return 0; }
    const v : i64 = num_i64(gt_d(), lut);
    if (v < 0) { return 0; }
    return v as u64;
}

fn gt_won() -> bool {
    var i : u32 = 0;
    const t : u64 = gt_truth();
    while (i < G_N) {
        if (heat(G_GUESS[i as usize] as u64, t, K_CLOSE_PCT as u64, K_WARM_PCT as u64) == HEAT_CLOSE) { return true; }
        i = i + 1;
    }
    return false;
}

fn gt_over() -> bool {
    return gt_won() or G_N >= (K_GUESSES as u32);
}

fn gt_board(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<ol class=\"gt-board\"");
    n = attr(o, n, "aria-label", SAY_BOARD_LABEL);
    n = raw(o, n, ">");
    const t : u64 = gt_truth();
    var i : u32 = 0;
    while (i < (K_GUESSES as u32)) {
        if (i >= G_N) {
            n = raw(o, n, "<li class=\"gt-rowtile is-empty\"><span class=\"gt-tile\"></span><span class=\"gt-say\"></span></li>");
        } else {
            const g : u64 = G_GUESS[i as usize] as u64;
            const h : u8 = heat(g, t, K_CLOSE_PCT as u64, K_WARM_PCT as u64);
            const dr : u8 = dir(g, t, K_CLOSE_PCT as u64, K_WARM_PCT as u64);
            n = raw(o, n, "<li class=\"gt-rowtile is-");
            if (h == HEAT_CLOSE) { n = raw(o, n, "close"); }
            if (h == HEAT_WARM) { n = raw(o, n, "warm"); }
            if (h == HEAT_COLD) { n = raw(o, n, "cold"); }
            n = raw(o, n, "\"><span class=\"gt-tile\">");
            n = num(o, n, g);
            n = raw(o, n, "</span><span class=\"gt-arrow\" aria-hidden=\"true\">");
            const ac : u32 = arrow_code(dr);
            if (ac != 0) { n = gt_utf8(o, n, ac); }
            n = raw(o, n, "</span><span class=\"gt-say\">");
            n = gt_text(o, n, SAY_DIRS[dr as usize]);
            n = raw(o, n, ", ");
            gt_clear();
            gt_set("close", W_V_NUM, K_CLOSE_PCT as i64);
            gt_set("warm", W_V_NUM, K_WARM_PCT as i64);
            n = gt_fill(o, n, SAY_HEAT[h as usize]);
            n = raw(o, n, "</span></li>");
        }
        i = i + 1;
    }
    return raw(o, n, "</ol>");
}

/// The share text (plain, not escaped) into SHT; its length.
fn gt_share_text() -> u32 {
    RAW_OUT = true;
    var n : u32 = 0;
    const won : bool = gt_won();
    gt_clear();
    gt_sc_reset();
    var sb : [24]u8 = [0; 24];
    var sl : u32 = 0;
    if (won) { sl = num(sb[0..24], 0, G_N as u64); } else { sl = raw(sb[0..24], 0, SAY_SHARE_LOST); }
    gt_set("score", W_V_SC, gt_sc_put(sb[0..(sl as usize)]));
    gt_set("max", W_V_NUM, K_GUESSES as i64);
    if (G_PRACTICE) {
        n = gt_fill(SHT[0..1024], n, SAY_SHARE_PRACTICE);
    } else {
        gt_set("n", W_V_NUM, puzzle_number(G_DAY as u64, K_EPOCH_DAY as u64) as i64);
        n = gt_fill(SHT[0..1024], n, SAY_SHARE_HEAD);
    }
    const t : u64 = gt_truth();
    var i : u32 = 0;
    while (i < G_N) {
        const g : u64 = G_GUESS[i as usize] as u64;
        const h : u8 = heat(g, t, K_CLOSE_PCT as u64, K_WARM_PCT as u64);
        const dr : u8 = dir(g, t, K_CLOSE_PCT as u64, K_WARM_PCT as u64);
        n = put(SHT[0..1024], n, 10);
        n = gt_utf8(SHT[0..1024], n, heat_code(h));
        if (dr != DIR_HIT) {
            n = gt_utf8(SHT[0..1024], n, arrow_code(dr));
            n = gt_utf8(SHT[0..1024], n, K_EMOJI_SELECTOR as u32);
        }
        i = i + 1;
    }
    n = put(SHT[0..1024], n, 10);
    n = raw(SHT[0..1024], n, K_SHARE_URL);
    RAW_OUT = false;
    return n;
}

fn gt_reveal(o: []u8, n0: u32) -> u32 {
    const d : []const u8 = gt_d();
    const p : i64 = gt_cur();
    const a : i64 = gt_pf(p, "answer");
    const won : bool = gt_won();
    var n : u32 = raw(o, n0, "<section class=\"gt-reveal\">");
    gt_clear();
    if (won) {
        n = raw(o, n, "<p class=\"gt-won\">");
        gt_set("n", W_V_NUM, G_N as i64);
        gt_set("max", W_V_NUM, K_GUESSES as i64);
        gt_set("close", W_V_NUM, K_CLOSE_PCT as i64);
        n = gt_fill(o, n, SAY_WON);
    } else {
        n = raw(o, n, "<p class=\"gt-lost\">");
        n = gt_text(o, n, SAY_LOST);
    }
    n = raw(o, n, "</p><p class=\"gt-answer\">");
    gt_clear();
    gt_set("lut", W_V_RAW, gt_pf(a, "lut"));
    n = gt_fill(o, n, SAY_ANSWER);
    n = raw(o, n, "</p><p class=\"gt-note\">");
    gt_clear();
    gt_set("ff", W_V_RAW, gt_pf(a, "ff"));
    gt_set("carry4", W_V_RAW, gt_pf(a, "carry4"));
    gt_set("muxf7", W_V_RAW, gt_pf(a, "muxf7"));
    gt_set("muxf8", W_V_RAW, gt_pf(a, "muxf8"));
    gt_set("dsp", W_V_RAW, gt_pf(a, "dsp"));
    gt_set("cells", W_V_RAW, gt_pf(a, "cells"));
    n = gt_fill(o, n, SAY_REVEAL);
    n = raw(o, n, "</p>");
    const oo : i64 = gt_pf(p, "other");
    const ol : i64 = gt_pf(oo, "lut");
    const olk : u8 = kind(d, ol);
    if (olk != J_NONE and olk != J_NULL) {
        n = raw(o, n, "<p class=\"gt-note\">");
        gt_clear();
        gt_sc_reset();
        gt_set("mode", W_V_SC, gt_sc_put(K_OTHER_SYNTH));
        const al : i64 = gt_pf(a, "lut");
        const od : i64 = gt_pf(oo, "dsp");
        const ad : i64 = gt_pf(a, "dsp");
        if (gt_same_value(d, ol, al) and gt_same_value(d, od, ad)) {
            n = gt_fill(o, n, SAY_OTHER_SAME);
        } else {
            gt_set("lut", W_V_RAW, ol);
            gt_set("dsp", W_V_RAW, od);
            n = gt_fill(o, n, SAY_OTHER_DIFF);
        }
        n = raw(o, n, "</p>");
    }
    n = raw(o, n, "<details class=\"gt-types\"");
    if (DET_OPEN) { n = raw(o, n, " open=\"\""); }
    n = raw(o, n, "><summary>");
    n = gt_text(o, n, SAY_BY_TYPE);
    n = raw(o, n, "</summary><p class=\"gt-meta\">");
    n = gt_types(o, n, d, gt_pf(a, "by_type"));
    n = raw(o, n, "</p></details>");
    // the share box
    const sl : u32 = gt_share_text();
    n = raw(o, n, "<div class=\"gt-sharebox\"><p class=\"gt-label\">");
    n = gt_text(o, n, SAY_SHARE_LABEL);
    n = raw(o, n, "</p><pre class=\"gt-share\" tabindex=\"0\">");
    n = gt_text(o, n, SHT[0..(sl as usize)]);
    n = raw(o, n, "</pre><div class=\"gt-row\"><button type=\"button\" class=\"t27-btn\">");
    n = gt_text(o, n, SAY_COPY);
    n = raw(o, n, "</button><span class=\"gt-note\" role=\"status\">");
    if (COPY_MSG == 1) { n = gt_text(o, n, SAY_COPIED); }
    if (COPY_MSG == 2) { n = gt_text(o, n, SAY_COPY_FAILED); }
    return raw(o, n, "</span></div></div></section>");
}

/// a === b for two JSON values that are numbers or words.
fn gt_same_value(d: []const u8, a: i64, b: i64) -> bool {
    const ka : u8 = kind(d, a);
    if (ka != kind(d, b)) { return false; }
    if (ka == J_NUMBER) { return num_f64(d, a) == num_f64(d, b); }
    if (ka == J_STRING) {
        if (str_len(d, a) != str_len(d, b)) { return false; }
        var k : u32 = 0;
        while (k < str_len(d, a)) {
            if (str_byte(d, a, k) != str_byte(d, b, k)) { return false; }
            k = k + 1;
        }
        return true;
    }
    return true;
}

/// Is key a before key b, as JavaScript's < compares two strings (UTF-16 order, here the UTF-8 order)?
fn gt_key_less(d: []const u8, a: i64, b: i64) -> bool {
    const la : u32 = str_len(d, a);
    const lb : u32 = str_len(d, b);
    var k : u32 = 0;
    while (k < la and k < lb) {
        const x : u8 = str_byte(d, a, k);
        const y : u8 = str_byte(d, b, k);
        if (x != y) { return x < y; }
        k = k + 1;
    }
    return la < lb;
}

/// Object.entries(by_type).sort(by key).map(([k, n]) => `${k} ${n}`).join(', ')
fn gt_types(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    var n : u32 = n0;
    var cnt : u32 = 0;
    if (kind(d, sp) == J_OBJECT) {
        const hi : usize = span_hi(sp);
        var p : usize = skip_ws(d, span_lo(sp) + 1);
        while (p < hi and d[p] == 34 and cnt < 64) {
            const ke : usize = string_end(d, p);
            if (ke > hi) { break; }
            const q : usize = skip_ws(d, ke);
            if (q >= hi or d[q] != 58) { break; }
            const v : usize = skip_ws(d, q + 1);
            const ve : usize = value_end(d, v);
            if (ve > hi) { break; }
            // insertion sort by key
            var at : u32 = cnt;
            const ksp : i64 = jspan(p, ke);
            while (at > 0 and gt_key_less(d, ksp, BT_K[(at - 1) as usize])) {
                BT_K[at as usize] = BT_K[(at - 1) as usize];
                BT_V[at as usize] = BT_V[(at - 1) as usize];
                at = at - 1;
            }
            BT_K[at as usize] = ksp;
            BT_V[at as usize] = jspan(v, ve);
            cnt = cnt + 1;
            p = skip_ws(d, ve);
            if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
        }
    }
    var i : u32 = 0;
    while (i < cnt) {
        if (i > 0) { n = raw(o, n, ", "); }
        n = gt_jstr(o, n, d, BT_K[i as usize]);
        n = put(o, n, 32);
        n = gt_jstring(o, n, d, BT_V[i as usize]);
        i = i + 1;
    }
    return n;
}

fn gt_form(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<form class=\"gt-form\"><label for=\"gt-in\">");
    n = gt_text(o, n, SAY_INPUT_LABEL);
    n = raw(o, n, "</label><div class=\"gt-inputline\"><input id=\"gt-in\" class=\"gt-input\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"");
    n = num(o, n, K_MAX_GUESS as u64);
    n = raw(o, n, "\" step=\"1\" required=\"required\" autocomplete=\"off\"><button type=\"submit\" class=\"t27-btn gt-go\">");
    n = gt_text(o, n, SAY_GUESS);
    n = raw(o, n, "</button></div><p class=\"gt-note\">");
    gt_clear();
    gt_set("n", W_V_NUM, (K_GUESSES as i64) - (G_N as i64));
    gt_set("max", W_V_NUM, K_GUESSES as i64);
    n = gt_fill(o, n, SAY_GUESSES_LEFT);
    n = raw(o, n, "</p><p class=\"gt-bad\" role=\"status\">");
    if (MSG_KIND == 1) {
        gt_clear();
        gt_set("max", W_V_NUM, K_MAX_GUESS as i64);
        n = gt_fill(o, n, SAY_BAD_GUESS);
    }
    if (MSG_KIND == 2) { n = gt_text(o, n, SAY_ALREADY); }
    return raw(o, n, "</p></form>");
}

fn gt_play(o: []u8, n0: u32) -> u32 {
    const d : []const u8 = gt_d();
    var n : u32 = raw(o, n0, "<section class=\"gt-play\"><h2 class=\"gt-q\">");
    n = gt_text(o, n, SAY_QUESTION);
    n = raw(o, n, "</h2><p class=\"gt-note\">");
    gt_clear();
    gt_sc_reset();
    var vb : [256]u8 = [0; 256];
    const vl : u32 = gt_version(vb[0..256]);
    gt_set("synth", W_V_STR, obj_get(d, D_YOSYS, "answer"));
    gt_set("version", W_V_SC, gt_sc_put(vb[0..(vl as usize)]));
    gt_set("close", W_V_NUM, K_CLOSE_PCT as i64);
    gt_set("warm", W_V_NUM, K_WARM_PCT as i64);
    n = gt_fill(o, n, SAY_RULE_NOTE);
    n = raw(o, n, "</p>");
    n = gt_board(o, n);
    if (gt_over()) { n = gt_reveal(o, n); } else { n = gt_form(o, n); }
    return raw(o, n, "</section>");
}

pub fn w_render(dst: []u8) -> u32 {
    var n : u32 = 0;
    if (DATA_STATE == 0) {
        n = raw(dst, 0, "<p class=\"gt-note\">");
        n = gt_text(dst, n, SAY_LOADING);
        n = raw(dst, n, "</p>");
    } else {
        if (DATA_STATE == 2) {
            n = raw(dst, 0, "<p class=\"gt-bad\">");
            n = gt_text(dst, n, SAY_LOAD_FAILED);
            n = raw(dst, n, "</p>");
        } else {
            const d : []const u8 = gt_d();
            n = gt_header(dst, 0);
            n = raw(dst, n, "<div class=\"gt-grid\">");
            n = gt_code_pane(dst, n);
            n = gt_play(dst, n);
            n = raw(dst, n, "</div><p class=\"gt-honest\">");
            n = gt_text(dst, n, SAY_NO_STREAKS);
            n = raw(dst, n, "</p><p class=\"gt-meta gt-pool\">");
            gt_clear();
            gt_set("size", W_V_NUM, POOL_N as i64);
            gt_set("specs", W_V_RAW, obj_get(d, D_CORPUS, "specs"));
            gt_set("candidates", W_V_RAW, obj_get(d, D_CORPUS, "candidates"));
            gt_set("date", W_V_STR, D_DATE);
            gt_set("zeroff", W_V_NUM, ZEROFF as i64);
            gt_set("min", W_V_NUM, K_MIN_LUTS as i64);
            gt_set("max", W_V_NUM, K_MAX_LUTS as i64);
            gt_set("lines", W_V_NUM, K_MAX_CODE_LINES as i64);
            gt_set("cols", W_V_NUM, K_MAX_CODE_COLS as i64);
            n = gt_fill(dst, n, SAY_POOL_NOTE);
            n = raw(dst, n, "</p>");
        }
    }
    if (!ok(n)) { return 0; }
    return n;
}

// --- events -----------------------------------------------------------------------------------------------------

pub fn w_base(u: []const u8) -> u32 {
    var k : usize = 0;
    while (k < u.len and k < 1024) {
        BASE[k] = u[k];
        k = k + 1;
    }
    BASE_N = k as u32;
    return 0;
}

pub fn w_wall(ms: f64) -> u32 {
    WALL = ms;
    return 0;
}

pub fn w_now(t: f64) -> u32 {
    NOW = t;
    return 0;
}

pub fn w_rand(r: f64) -> u32 {
    RAND = r;
    return 0;
}

fn gt_store_hash(h: []const u8) -> u32 {
    var k : usize = 0;
    while (k < h.len and k < 4096) {
        HASH_IN[k] = h[k];
        k = k + 1;
    }
    HASH_IN_N = k as u32;
    return 0;
}

pub fn w_init(h: []const u8) -> u32 {
    gt_eff_clear();
    DATA_STATE = 0;
    gt_store_hash(h);
    return 0;
}

pub fn w_hash(h: []const u8) -> u32 {
    gt_eff_clear();
    gt_store_hash(h);
    if (DATA_STATE == 1) {
        gt_game_from_hash();
        gt_draw_event();
    }
    return 0;
}

pub fn w_hash_out(dst: []u8) -> u32 {
    if (!HASH_DIRTY or DATA_STATE != 1) { return 0; }
    HASH_DIRTY = false;
    return gt_format_hash(dst);
}

pub fn w_input(i: u32, s: []const u8) -> u32 {
    gt_eff_clear();
    var k : usize = 0;
    while (k < s.len and k < 255) {
        INPUT_TEXT[k] = s[k];
        k = k + 1;
    }
    INPUT_N = k as u32;
    return 0;
}

pub fn w_value(i: u32, dst: []u8) -> u32 {
    if (i == 0 and CLEAR_INPUT) {
        CLEAR_INPUT = false;
        INPUT_N = 0;
        return 0;
    }
    return 4294967295;
}

pub fn w_toggle(i: u32, open: u32) -> u32 {
    DET_OPEN = open != 0;
    return 0;
}

/// What the browser lets through before the page's own check: the box is required, holds a number, which is
/// at least 0, at most K_MAX_GUESS and whole (step 1).
fn gt_box_valid(s: []const u8) -> bool {
    if (s.len == 0) { return false; }
    var i : usize = 0;
    if (s[i] == 45) { i = i + 1; }
    var nd : usize = 0;
    while (i < s.len and s[i] >= 48 and s[i] <= 57) {
        i = i + 1;
        nd = nd + 1;
    }
    var fd : usize = 0;
    if (i < s.len and s[i] == 46) {
        i = i + 1;
        while (i < s.len and s[i] >= 48 and s[i] <= 57) {
            i = i + 1;
            fd = fd + 1;
        }
        if (fd == 0) { return false; }
    } else {
        if (nd == 0) { return false; }
    }
    if (i < s.len and (s[i] == 101 or s[i] == 69)) {
        i = i + 1;
        if (i < s.len and (s[i] == 43 or s[i] == 45)) { i = i + 1; }
        var ed : usize = 0;
        while (i < s.len and s[i] >= 48 and s[i] <= 57) {
            i = i + 1;
            ed = ed + 1;
        }
        if (ed == 0) { return false; }
    }
    if (i != s.len) { return false; }
    const v : f64 = js_parse_num(s, 0, s.len);
    if (v < 0.0 or v > (K_MAX_GUESS as f64)) { return false; }
    return v == js_floor(v);
}

/// The form's submit handler, after the browser has let the value through.
fn gt_submit() -> u32 {
    const s : []const u8 = INPUT_TEXT[0..(INPUT_N as usize)];
    if (!gt_box_valid(s)) { return 0; }
    var digits : bool = true;
    var v : u64 = 0;
    var i : usize = 0;
    while (i < s.len) {
        if (s[i] < 48 or s[i] > 57) { digits = false; }
        if (v < 100000000) { v = v * 10 + ((s[i] - 48) as u64); }
        i = i + 1;
    }
    if (!digits or v > (K_MAX_GUESS as u64)) {
        MSG_KIND = 1;
        return 0;
    }
    var k : u32 = 0;
    while (k < G_N) {
        if ((G_GUESS[k as usize] as u64) == v) {
            MSG_KIND = 2;
            return 0;
        }
        k = k + 1;
    }
    if (G_N >= (K_GUESSES as u32)) { return 0; }
    G_GUESS[G_N as usize] = v as u32;
    G_N = G_N + 1;
    gt_save();
    // redrawPlay(): the play side is made again, the code box is left as it is
    MSG_KIND = 0;
    CLEAR_INPUT = true;
    DET_OPEN = false;
    SHARE_EPOCH = SHARE_EPOCH + 1;
    COPY_MSG = 0;
    if (gt_over()) { gt_eff(3, 0); } else { gt_eff(2, 0); }
    return 0;
}

pub fn w_click(i: u32) -> u32 {
    gt_eff_clear();
    if (DATA_STATE != 1) { return 0; }
    var nh : u32 = 2;
    if (G_PRACTICE) { nh = 3; }
    if (i == 0) {
        G_PRACTICE = false;
        G_DAY = HDR_T;
        G_INDEX = day_index(HDR_T as u64, K_EPOCH_DAY as u64, POOL_N as u64) as u32;
        gt_mem_load(HDR_T);
        gt_save();
        gt_draw_event();
        return 0;
    }
    if (i == 1 or (G_PRACTICE and i == 2)) {
        gt_new_practice();
        gt_save();
        gt_draw_event();
        return 0;
    }
    if (i == nh) {
        V_TAB = 0;
        gt_pane_start();
        return 0;
    }
    if (i == nh + 1) {
        V_TAB = 1;
        gt_pane_start();
        return 0;
    }
    var at : u32 = nh + 2;
    if (V_TAB == 0 and gt_src_state() == 2) {
        if (i == at) {
            V_COMMENTS = !V_COMMENTS;
            return 0;
        }
        at = at + 1;
    }
    if (i == at) {
        if (gt_over()) {
            COPY_EPOCH = SHARE_EPOCH;
            gt_share_text();
            gt_eff(4, 0);
        } else {
            gt_submit();
        }
    }
    return 0;
}

pub fn w_copied(g: u32) -> u32 {
    gt_eff_clear();
    if (COPY_EPOCH == SHARE_EPOCH) {
        if (g != 0) { COPY_MSG = 1; } else { COPY_MSG = 2; }
        gt_eff(5, SHARE_EPOCH % 256);
    }
    return 0;
}

pub fn w_timer(id: u32) -> u32 {
    gt_eff_clear();
    if (id == SHARE_EPOCH % 256) { COPY_MSG = 0; }
    return 0;
}

pub fn w_effect(k: u32, dst: []u8) -> u32 {
    if (k >= EQ_N) { return 0; }
    const kd : u32 = EQ_KIND[k as usize];
    const a : u32 = EQ_ARG[k as usize];
    if (kd == 1) {
        dst[0] = 102;
        dst[1] = a as u8;
        var n : u32 = raw(dst, 2, "../../");
        n = n + gt_jcopy(dst[(n as usize)..], gt_d(), gt_pf(POOL_SP[a as usize], "src"));
        return n;
    }
    if (kd == 2) { return raw(dst, put(dst, 0, 70), "#gt-in"); }
    if (kd == 3) { return raw(dst, put(dst, 0, 110), ".gt-reveal"); }
    if (kd == 4) {
        var n : u32 = raw(dst, put(dst, 0, 119), "pre.gt-share");
        n = put(dst, n, 10);
        const sl : u32 = gt_share_text();
        var j : usize = 0;
        while (j < (sl as usize)) {
            n = put(dst, n, SHT[j]);
            j = j + 1;
        }
        return n;
    }
    // the timer that clears the copy message
    dst[0] = 116;
    dst[1] = a as u8;
    return dec_to(dst[2..], W_COPY_MS as u64) + 2;
}

/// The splicer follows only the names a module itself mentions, not the names its imported functions
/// mention. This anchor mentions every helper the writer, the JSON reader, the number rules, the
/// digest and the rules of the game call. Never called.
pub fn imports_anchor(o: []u8, s: []const u8, m: []u32) -> u32 {
    var n : u32 = 0;
    n = n + (ok(0) as u32);
    n = n + OVER;
    n = n + put(o, 0, 0);
    n = n + raw(o, 0, s);
    n = n + put_escaped(o, 0, 0);
    n = n + text(o, 0, s);
    n = n + num(o, 0, 0);
    n = n + attr(o, 0, s, s);
    n = n + fill(o, 0, s, s, s, s, 0);
    n = n + fill_named(o, 0, s, s, s, s, s, s, s, s, s, s, s, s, s);
    n = n + dec_to(o, 0);
    n = n + (name_is(s, 0, 0, s) as u32);
    n = n + (is_word_byte(0) as u32);
    n = n + (H_LT as u32);
    n = n + (H_GT as u32);
    n = n + (H_AMP as u32);
    n = n + (H_QUOTE as u32);
    n = n + (H_APOS as u32);
    n = n + (H_SPACE as u32);
    n = n + (H_SLASH as u32);
    n = n + (H_EQ as u32);
    n = n + num_grouped(o, 0, 0);
    n = n + ((NO_SPAN < 0) as u32);
    n = n + ((SPAN > 0) as u32);
    n = n + (J_NONE as u32);
    n = n + (J_OBJECT as u32);
    n = n + (J_ARRAY as u32);
    n = n + (J_STRING as u32);
    n = n + (J_NUMBER as u32);
    n = n + (J_TRUE as u32);
    n = n + (J_FALSE as u32);
    n = n + (J_NULL as u32);
    n = n + (jspan(0, 0) as u32);
    n = n + (span_lo(0) as u32);
    n = n + (span_hi(0) as u32);
    n = n + (skip_ws(s, 0) as u32);
    n = n + (string_end(s, 0) as u32);
    n = n + (value_end(s, 0) as u32);
    n = n + (root(s) as u32);
    n = n + (kind(s, 0) as u32);
    n = n + (key_is(s, 0, 0, s) as u32);
    n = n + (obj_get(s, 0, s) as u32);
    n = n + arr_len(s, 0);
    n = n + (arr_at(s, 0, 0) as u32);
    n = n + hex4(s, 0);
    n = n + escape_at(s, 0, 0);
    n = n + cp_utf8_len(0);
    n = n + (cp_utf8_byte(0, 0) as u32);
    n = n + str_len(s, 0);
    n = n + (str_byte(s, 0, 0) as u32);
    n = n + JN_OVER;
    n = n + JN_CAP;
    n = n + ((JN_TWO52 > 0.0) as u32);
    n = n + ((JN_TWO53 > 0.0) as u32);
    n = n + jn_put(o, 0, 0);
    n = n + jn_raw(o, 0, s);
    n = n + jn_digits(o, 0);
    n = n + jn_mul(o, 0, 0);
    n = n + jn_mul2(o, 0, 0);
    n = n + jn_mul5(o, 0, 0);
    n = n + jn_shift(o, 0, 0);
    n = n + (jn_cmp(s, s, 0) as u32);
    n = n + (jn_expo(0.0) as u32);
    n = n + (jn_mant(0.0) as u32);
    n = n + ((jn_make(0, 0) > 0.0) as u32);
    n = n + jn_exact(o, 0, 0);
    n = n + jn_fscale(0);
    n = n + (js_is_nan(0.0) as u32);
    n = n + ((js_nan(0.0) > 0.0) as u32);
    n = n + ((js_inf(1.0) > 0.0) as u32);
    n = n + ((js_floor(0.0) > 0.0) as u32);
    n = n + ((js_ceil(0.0) > 0.0) as u32);
    n = n + ((js_max(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_min(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_round(0.0) > 0.0) as u32);
    n = n + (jn_shortest(o, 1.0) as u32);
    n = n + jn_copy(o, s, 0);
    n = n + jn_put_run(o, 0, s, 0, 0);
    n = n + jn_layout(o, 0, s, 0, 0);
    n = n + js_str_num(o, 0, 0.0);
    n = n + js_to_fixed(o, 0, 0.0, 0);
    n = n + js_locale_num(o, 0, 0.0);
    n = n + (jn_num_ok(s, 0, 0) as u32);
    n = n + (jn_cmp_text(s, 0, 0, 0, 0) as u32);
    n = n + ((js_parse_num(s, 0, 0) > 0.0) as u32);
    n = n + ((jn_dec_value(s, 0, 0) > 0.0) as u32);
    n = n + (jn_abs(0) as u32);
    n = n + js_str_u64(o, 0, 0);
    n = n + (is_true(s, 0) as u32) + (is_false(s, 0) as u32) + (is_null(s, 0) as u32);
    n = n + ((num_f64(s, 0) > 0.0) as u32) + (num_i64(s, 0) as u32);
    n = n + (jv_valid(s) as u32) + (jv_string_ok(s, 0) as u32) + (jv_number_ok(s, 0) as u32) + (jv_lit_ok(s, 0, s) as u32);
    n = n + (jv_is_ws(0) as u32) + jv_ws_at(s, 0, 0) + jv_ws_before(s, 0, 0);
    n = n + (SH_K[0] as u32) + ((SH_M32 > 0) as u32) + (sh_rotr(0, 0) as u32) + (sh_hexd(0) as u32);
    n = n + sh_block(m, m, s, 0) + sha256_hex(s, m, m, o);
    n = n + (DAY_MS as u32) + (HEAT_CLOSE as u32) + (HEAT_WARM as u32) + (HEAT_COLD as u32) + (DIR_HIT as u32) + (DIR_UP as u32) + (DIR_DOWN as u32);
    n = n + EMOJI_HEAT[0] + ARROWS[0];
    n = n + (day_number(0) as u32) + (day_index(0, 0, 1) as u32) + (puzzle_number(0, 0) as u32) + (off100(0, 0) as u32);
    n = n + (heat(0, 0, 0, 0) as u32) + (dir(0, 0, 0, 0) as u32) + heat_code(0) + arrow_code(0);
    return n;
}


; --- Tests of the native page ------------------------------------------------------------------------------------------
; A pool of two puzzles stands for pool.json; the source and the compiler's answer are given by hand.

pub var G_OUT : [1048576]u8 = [0; 1048576];
pub var G_NEED : [4096]u8 = [0; 4096];
pub var G_EFF : [512]u8 = [0; 512];
pub var G_HASH : [256]u8 = [0; 256];
pub const W_G_POOL : str = "{\"date_utc\":\"2026-10-04\",\"corpus\":{\"specs\":9,\"candidates\":4},\"yosys\":{\"answer\":\"synth_xilinx -nodsp\",\"version\":\"Yosys 0.67+post (git sha1 abc)\"},\"pool\":[{\"id\":\"a/b\",\"path\":\"specs/a/b.t27\",\"src\":\"t27/files/specs/a/b.t27\",\"top\":\"B\",\"spec_sha256\":\"10b4939015dc40258ee23d285d8dff3a8b25b6d3a57b4ca8bb87ff5c25686caa\",\"verilog_sha256\":\"77616cd592ced36d8e32442146b232415fd3d53d0ec883019e336865e61052ad\",\"lines\":5,\"code_lines\":3,\"answer\":{\"lut\":200,\"ff\":0,\"carry4\":1,\"muxf7\":2,\"muxf8\":3,\"dsp\":0,\"cells\":9,\"by_type\":{\"LUT2\":5,\"CARRY4\":1,\"IBUF\":2}},\"other\":{\"mode\":\"dsp\",\"lut\":200,\"dsp\":0}},{\"id\":\"c/d\",\"path\":\"specs/c/d.t27\",\"src\":\"t27/files/specs/c/d.t27\",\"top\":\"D\",\"spec_sha256\":\"0\",\"verilog_sha256\":\"0\",\"lines\":2,\"code_lines\":2,\"answer\":{\"lut\":50,\"ff\":1,\"carry4\":0,\"muxf7\":0,\"muxf8\":0,\"dsp\":2,\"cells\":3,\"by_type\":{}},\"other\":{\"mode\":\"dsp\",\"lut\":40,\"dsp\":1}}]}";
pub const W_G_POOL_PAST : str = "{\"date_utc\":\"2026-10-04\",\"corpus\":{\"specs\":9,\"candidates\":4},\"yosys\":{\"answer\":\"synth_xilinx -nodsp\",\"version\":\"Yosys 0.67+post (git sha1 abc)\"},\"pool\":[{\"id\":\"a/b\",\"path\":\"specs/a/b.t27\",\"src\":\"t27/files/specs/a/b.t27\",\"top\":\"B\",\"spec_sha256\":\"10b4939015dc40258ee23d285d8dff3a8b25b6d3a57b4ca8bb87ff5c25686caa\",\"verilog_sha256\":\"ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\",\"lines\":5,\"code_lines\":3,\"answer\":{\"lut\":200,\"ff\":0,\"carry4\":1,\"muxf7\":2,\"muxf8\":3,\"dsp\":0,\"cells\":9,\"by_type\":{\"LUT2\":5,\"CARRY4\":1,\"IBUF\":2}},\"other\":{\"mode\":\"dsp\",\"lut\":200,\"dsp\":0}},{\"id\":\"c/d\",\"path\":\"specs/c/d.t27\",\"src\":\"t27/files/specs/c/d.t27\",\"top\":\"D\",\"spec_sha256\":\"0\",\"verilog_sha256\":\"0\",\"lines\":2,\"code_lines\":2,\"answer\":{\"lut\":50,\"ff\":1,\"carry4\":0,\"muxf7\":0,\"muxf8\":0,\"dsp\":2,\"cells\":3,\"by_type\":{}},\"other\":{\"mode\":\"dsp\",\"lut\":40,\"dsp\":1}}]}";
pub const W_G_SRC : str = "; head\nmodule B;\n\n// note\nfn f() -> u8 { return 1; }\n";
pub const W_G_ANSWER : str = "{\"targets\":{\"verilog\":{\"bytes\":20,\"code\":\"module B;\\nendmodule\\n\",\"ok\":true}}}";
pub const W_G_DAY1 : f64 = 1791090000000.0;

/// Does the page hold the text? (Scans for the first byte, then compares the rest.)
fn g_has(hay: []const u8, nd: []const u8) -> bool {
    var at : usize = 0;
    var found : bool = nd.len == 0;
    while (!found and at + nd.len <= hay.len) {
        if (hay[at] == nd[0]) {
            var j : usize = 1;
            while (j < nd.len and hay[at + j] == nd[j]) { j = j + 1; }
            found = j == nd.len;
        }
        at = at + 1;
    }
    return found;
}

fn g_page(nd: []const u8) -> bool {
    return g_has(G_OUT[0..(w_render(G_OUT[0..1048576]) as usize)], nd);
}

/// The page has pre bytes, then two bytes, then post.
fn g_page_cp(pre: []const u8, b1: u8, b2: u8, b3: u8, post: []const u8) -> bool {
    var e : [200]u8 = [0; 200];
    var k : u32 = raw(e[0..200], 0, pre);
    k = put(e[0..200], k, b1);
    k = put(e[0..200], k, b2);
    k = put(e[0..200], k, b3);
    k = raw(e[0..200], k, post);
    return g_page(e[0..(k as usize)]);
}

fn g_start(pool: []const u8, wall: f64) -> u32 {
    w_base("http://localhost/widgets/x/");
    w_wall(wall);
    w_now(0.0);
    w_init("");
    w_data(0, pool);
    return 0;
}

fn g_open() -> u32 {
    g_start(W_G_POOL, W_G_DAY1);
    w_fetched(0, 1, W_G_SRC);
    return 0;
}

test the_page_waits_for_the_pool_and_says_when_it_cannot_be_read {
    w_init("");
    assert g_page("<p class=\"gt-note\">Loading...</p>");
    w_data_failed(0);
    assert g_page("<p class=\"gt-bad\">The puzzle pool could not be read.</p>");
    w_init("");
    w_data(0, "<html>no</html>");
    assert g_page("could not be read");
    w_init("");
    w_data(0, "{\"pool\":[]}");
    assert g_page("could not be read");
    w_init("");
    w_data(0, "{\"pool\":[1,}");
    assert g_page("could not be read");
    w_init("");
    w_data(0, "[1]");
    assert g_page("could not be read");
    assert w_hash_out(G_HASH[0..256]) == 0;
}

test the_day_is_the_game_and_its_address_is_saved {
    g_start(W_G_POOL, W_G_DAY1);
    assert g_page("Gatle #1, 2026-10-04 UTC: puzzle 1 of 2. Every reader gets this module today.");
    assert g_page("<strong>a/b</strong> <span class=\"gt-meta\">top module B; 3 code lines, 5 with comments</span>");
    assert g_page("aria-pressed=\"true\">Today</button><button type=\"button\" class=\"t27-btn\" aria-pressed=\"false\">Practice</button>");
    assert w_hash_out(G_HASH[0..256]) == 8;
    assert same_bytes(G_HASH[0..8], 8, "#d=20730");
    assert w_hash_out(G_HASH[0..256]) == 0;
    assert g_page("<p class=\"gt-note\">Loading...</p>");
    assert w_effect(0, G_EFF[0..512]) == 2 + 6 + 23;
    assert G_EFF[0] == 102;
    assert G_EFF[1] == 0;
    assert same_bytes(G_EFF[2..31], 29, "../../t27/files/specs/a/b.t27");
    assert w_effect(1, G_EFF[0..512]) == 0;
    assert !g_page("37 puzzles");
    assert g_page("2 puzzles: the modules of 9 vendored specs");
}

test the_source_shows_without_its_comment_lines_and_each_comes_back_on_a_click {
    g_open();
    assert g_page("<pre class=\"gt-pre\" tabindex=\"0\">module B;\n\nfn f() -&gt; u8 { return 1; }</pre>");
    assert g_page("aria-pressed=\"false\">Show 2 comment lines</button><a href=\"http://localhost/t27/files/specs/a/b.t27\" target=\"_blank\" rel=\"noopener\" class=\"gt-meta\">specs/a/b.t27</a>");
    assert !g_page("not the one yosys read");
    w_click(4);
    assert g_page("<pre class=\"gt-pre\" tabindex=\"0\">; head\nmodule B;\n\n// note\nfn f() -&gt; u8 { return 1; }</pre>");
    assert g_page("aria-pressed=\"true\">Hide comment lines</button>");
    w_click(4);
    assert g_page("Show 2 comment lines");
}

test a_source_that_is_not_the_one_yosys_read_says_so_and_a_missing_one_too {
    g_start(W_G_POOL, W_G_DAY1);
    w_fetched(0, 1, "module B;\n");
    assert g_page("<p class=\"gt-bad\">This source is not the one yosys read: its sha256 differs from pool.json.</p>");
    g_start(W_G_POOL, W_G_DAY1);
    w_fetched(0, 0, "");
    assert g_page("<p class=\"gt-bad\">The module&#39;s source could not be read.</p>");
    assert w_compile_need(G_NEED[0..4096]) == 0;
}

test the_verilog_is_compiled_by_the_service_and_its_digest_is_compared {
    g_open();
    w_now(100.0);
    w_click(3);
    assert g_page("Compiling in your browser with t27_compiler.wasm...");
    assert w_compile_need(G_NEED[0..4096]) == (W_G_SRC.len as u32) + 1;
    assert w_compile_give(W_G_ANSWER, 0, 101.0, 103.4) == 0;
    assert w_compile_need(G_NEED[0..4096]) == 0;
    assert g_page("<pre class=\"gt-pre\" tabindex=\"0\">module B;\nendmodule\n</pre>");
    assert g_page("<p class=\"gt-note\">Compiled here in 3 ms: 20 bytes, sha256 ");
    assert g_page("..., the same Verilog yosys read.</p>");
    assert g_page("aria-pressed=\"true\">Verilog</button>");
    // the other tab and back: the compiler is asked again
    w_click(2);
    assert w_compile_need(G_NEED[0..4096]) == 0;
    w_click(3);
    assert w_compile_need(G_NEED[0..4096]) == (W_G_SRC.len as u32) + 1;
}

test a_different_digest_a_failed_compile_and_a_failed_source_are_named {
    g_start(W_G_POOL_PAST, W_G_DAY1);
    w_fetched(0, 1, W_G_SRC);
    w_click(3);
    w_compile_give(W_G_ANSWER, 0, 1.0, 2.0);
    assert g_page("<p class=\"gt-bad\">Compiled here in 2 ms: sha256 ");
    assert g_page("... is not ffffffffffff..., the Verilog yosys read.</p>");
    w_click(3);
    w_compile_give("{\"targets\":{}}", 0, 1.0, 2.0);
    assert g_page("<p class=\"gt-bad\">The compiler could not run in this browser.</p>");
    w_click(3);
    w_compile_give("trap", 1, 0.0, 0.0);
    assert g_page("The compiler could not run in this browser.");
    g_start(W_G_POOL, W_G_DAY1);
    w_click(3);
    assert g_page("Compiling in your browser");
    w_fetched(0, 0, "");
    assert w_compile_need(G_NEED[0..4096]) == 0;
    assert g_page("The compiler could not run in this browser.");
}

test guesses_are_graded_remembered_in_the_address_and_checked {
    g_open();
    w_hash_out(G_HASH[0..256]);
    w_input(0, "100");
    w_click(5);
    assert g_page("<li class=\"gt-rowtile is-warm\"><span class=\"gt-tile\">100</span><span class=\"gt-arrow\" aria-hidden=\"true\">");
    assert g_page_cp("aria-hidden=\"true\">", 226, 172, 134, "</span><span class=\"gt-say\">more, warm, within 50%</span></li>");
    assert g_page("5 of 6 guesses left.");
    assert w_hash_out(G_HASH[0..256]) == 14;
    assert same_bytes(G_HASH[0..14], 14, "#d=20730&g=100");
    assert w_value(0, G_OUT[0..10]) == 0;
    assert w_effect(0, G_EFF[0..512]) == 6 + 1;
    assert G_EFF[0] == 70;
    assert same_bytes(G_EFF[1..7], 6, "#gt-in");
    w_input(0, "100");
    w_click(5);
    assert g_page("<p class=\"gt-bad\" role=\"status\">You guessed that number already.</p>");
    w_input(0, "1e3");
    w_click(5);
    assert g_page("<p class=\"gt-bad\" role=\"status\">A whole number from 0 to 99999, please.</p>");
    w_input(0, "-5");
    w_click(5);
    assert g_page("A whole number from 0 to 99999, please.");
    w_input(0, "");
    w_click(5);
    w_input(0, "7.5");
    w_click(5);
    assert g_page("5 of 6 guesses left.");
    w_input(0, "1000");
    w_click(5);
    assert g_page("<li class=\"gt-rowtile is-cold\"><span class=\"gt-tile\">1000</span>");
    assert g_page("4 of 6 guesses left.");
    assert g_page("<p class=\"gt-bad\" role=\"status\"></p>");
}

test a_guess_within_ten_percent_ends_the_game_with_the_answer_and_a_share_text {
    g_open();
    w_input(0, "100");
    w_click(5);
    w_input(0, "190");
    w_click(5);
    assert g_page("<p class=\"gt-won\">Within 10% in 2 of 6.</p><p class=\"gt-answer\">yosys: 200 LUTs</p>");
    assert g_page("<p class=\"gt-note\">Also 0 flip-flops, 1 CARRY4, 2 MUXF7, 3 MUXF8, 0 DSP48E1; 9 cells in all.</p>");
    assert g_page("<p class=\"gt-note\">With synth_xilinx -family xc7 -flatten: the same LUT and DSP counts.</p>");
    assert g_page("<details class=\"gt-types\"><summary>Every cell type yosys reported</summary><p class=\"gt-meta\">CARRY4 1, IBUF 2, LUT2 5</p></details>");
    assert g_page("<pre class=\"gt-share\" tabindex=\"0\">Gatle #1 2/6\n");
    var sh : [96]u8 = [0; 96];
    var k : u32 = raw(sh[0..96], 0, "Gatle #1 2/6");
    k = put(sh[0..96], k, 10);
    k = put(sh[0..96], k, 240);
    k = put(sh[0..96], k, 159);
    k = put(sh[0..96], k, 159);
    k = put(sh[0..96], k, 168);
    k = put(sh[0..96], k, 226);
    k = put(sh[0..96], k, 172);
    k = put(sh[0..96], k, 134);
    k = put(sh[0..96], k, 239);
    k = put(sh[0..96], k, 184);
    k = put(sh[0..96], k, 143);
    k = put(sh[0..96], k, 10);
    k = put(sh[0..96], k, 240);
    k = put(sh[0..96], k, 159);
    k = put(sh[0..96], k, 159);
    k = put(sh[0..96], k, 169);
    k = put(sh[0..96], k, 10);
    k = raw(sh[0..96], k, "t27.ai/widgets/gatle/</pre>");
    assert g_page(sh[0..(k as usize)]);
    assert w_effect(0, G_EFF[0..512]) == 11;
    assert G_EFF[0] == 110;
    w_toggle(0, 1);
    assert g_page("<details class=\"gt-types\" open=\"\">");
    // copy: the text and the selector go to the host; its answer shows and a timer clears it
    w_click(5);
    assert w_effect(0, G_EFF[0..512]) > 20;
    assert G_EFF[0] == 119;
    w_copied(1);
    assert g_page("<span class=\"gt-note\" role=\"status\">Copied.</span>");
    assert w_effect(0, G_EFF[0..512]) == 6;
    assert G_EFF[0] == 116;
    assert G_EFF[2] == 50;
    assert G_EFF[3] == 53;
    w_timer(G_EFF[1] as u32);
    assert g_page("<span class=\"gt-note\" role=\"status\"></span>");
    w_click(5);
    w_copied(0);
    assert g_page("Copy failed; the text is selected, copy it by hand.");
    // a draw in between: the answer of an older copy finds nothing to show
    w_click(5);
    w_click(1);
    w_copied(1);
    assert !g_page("Copied.");
}

test six_wrong_guesses_lose_and_the_share_text_says_x {
    g_open();
    var i : u32 = 0;
    while (i < 6) {
        var t : [8]u8 = [0; 8];
        const l : u32 = num(t[0..8], 0, (1000 + i * 7) as u64);
        w_input(0, t[0..(l as usize)]);
        w_click(5);
        i = i + 1;
    }
    assert g_page("<p class=\"gt-lost\">Out of guesses.</p>");
    assert g_page("Gatle #1 X/6\n");
    assert g_page("0 of 6 guesses left.") == false;
}

test the_address_is_read_the_way_url_search_params_reads_it {
    g_open();
    w_hash_out(G_HASH[0..256]);
    w_wall(W_G_DAY1 + 86400000.0 * 30.0);
    w_hash("#d=20735&g=1.2.3");
    assert g_page("Gatle #6 of 2026-10-09, opened from a link. Today is #31.");
    assert g_page("<span class=\"gt-tile\">3</span>");
    assert w_hash_out(G_HASH[0..256]) == 0;
    w_hash("#%64=20731&g=%31%30.99999.100000.7");
    assert g_page("Gatle #2 of 2026-10-05");
    assert g_page("<span class=\"gt-tile\">10</span>");
    assert g_page("<span class=\"gt-tile\">99999</span>");
    assert !g_page("<span class=\"gt-tile\">100000</span>");
    assert g_page("<span class=\"gt-tile\">7</span>");
    w_hash("#d=20731&d=20732&g=5");
    assert g_page("Gatle #2 of 2026-10-05");
    w_hash("#p=1&g=5.6");
    assert g_page("Practice: a random module from the 2. Today&#39;s game is untouched.");
    assert g_page("<span class=\"gt-tile\">6</span>");
    assert g_page("<strong>c/d</strong>");
    w_hash("#p=2");
    assert g_page("Gatle #31, 2026-11-03 UTC: puzzle 1 of 2.");
    w_hash("#d=99999999");
    assert g_page("Gatle #31, 2026-11-03 UTC");
    w_hash("#d=20000");
    assert g_page("Gatle #31, 2026-11-03 UTC");
    w_hash("#g=1+2");
    assert g_page("Gatle #31, 2026-11-03 UTC");
    assert !g_page("gt-tile\">1</span>");
}

test practice_deals_another_module_than_the_one_on_the_page {
    g_open();
    w_rand(0.0);
    w_click(1);
    assert g_page("<strong>c/d</strong>");
    assert w_hash_out(G_HASH[0..256]) == 4;
    assert same_bytes(G_HASH[0..4], 4, "#p=1");
    assert g_page("aria-pressed=\"true\">Practice</button>");
    assert g_page("<button type=\"button\" class=\"t27-btn\">Another module</button>");
    w_rand(0.99);
    w_click(2);
    assert g_page("<strong>a/b</strong>");
    w_rand(0.99);
    w_click(1);
    assert g_page("<strong>c/d</strong>");
    w_rand(0.2);
    w_click(2);
    assert g_page("<strong>a/b</strong>");
    w_click(0);
    assert g_page("<strong>a/b</strong>");
    assert w_hash_out(G_HASH[0..256]) == 8;
}

test dates_are_written_the_way_to_iso_string_writes_them {
    g_open();
    w_wall(W_G_DAY1 + 86400000.0 * 800.0);
    w_hash("#d=20819");
    assert g_page("Gatle #90 of 2027-01-01");
    w_hash("#d=21000");
    assert g_page("Gatle #271 of 2027-07-01");
    w_wall(86400000.0 * 11017.0);
    assert gt_today() == 20730;
    w_wall(86400000.0 * 99999.0 + 5.0);
    w_hash("#d=99999");
    assert g_page("Gatle #79270, 2243-10-16 UTC: puzzle ");
    w_hash("#d=20730");
    assert g_page("Gatle #1 of 2026-10-04");
}

test the_links_of_the_source_follow_the_page_s_directory {
    w_base("https://t27.ai/widgets/gatle/");
    w_wall(W_G_DAY1);
    w_init("");
    w_data(0, W_G_POOL);
    w_fetched(0, 1, W_G_SRC);
    assert g_page("href=\"https://t27.ai/t27/files/specs/a/b.t27\"");
    w_base("https://t27.ai/");
    assert g_page("href=\"https://t27.ai/t27/files/specs/a/b.t27\"");
    w_base("https://x.y/a/b/c/");
    assert g_page("href=\"https://x.y/a/t27/files/specs/a/b.t27\"");
}

test the_number_box_is_checked_the_way_a_browser_checks_it {
    assert gt_box_valid("5");
    assert gt_box_valid("00042");
    assert gt_box_valid("1e3");
    assert gt_box_valid("1.0");
    assert gt_box_valid("-0");
    assert gt_box_valid("99999");
    assert gt_box_valid("1E2");
    assert gt_box_valid("12.50e1");
    assert !gt_box_valid("");
    assert !gt_box_valid("100000");
    assert !gt_box_valid("5.5");
    assert !gt_box_valid(".5");
    assert !gt_box_valid("-1");
    assert !gt_box_valid("1e");
    assert !gt_box_valid("abc");
    assert !gt_box_valid("5.");
    assert !gt_box_valid("+5");
    assert !gt_box_valid("1e400");
}

test the_version_loses_its_bracketed_tail {
    g_open();
    var v : [64]u8 = [0; 64];
    assert gt_version(v[0..64]) == 15;
    assert same_bytes(v[0..15], 15, "Yosys 0.67+post");
}
