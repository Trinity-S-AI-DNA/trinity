pub const DESCRIPTION : str = "A daily guessing game: one real t27 module, its Verilog compiled in your browser, six guesses at the LUT count yosys reported for it.";
pub const IMAGE_ALT : str = "Gatle card, a sample game of puzzle #1 (2026-10-04), ternary/gft_sgd_step: guesses 122, 607 and 1351 are told more, 2014 is told fewer, and 1650 lands within 10% of the 1826 LUTs yosys reported with synth_xilinx -nodsp. One of 37 real t27 modules, one a day.";
pub const HOOK : str = "Can you out-guess yosys? One real t27 module a day, six guesses at its LUT count. Puzzle #1 cost 1826 LUTs; splitting the range took five.";
pub const CATEGORY : str = "game";
pub const DATA_SOURCES : [4]str = ["public/t27/t27_compiler.wasm (sha256 bb39b9a5ca41...), run in node by scripts/widget-data/gatle.mjs on 2026-10-04: the Verilog of every vendored spec; the page recompiles the day's module in the browser and compares sha256", "Yosys 0.67+post (git sha1 b8e7da6f), run 2026-10-04: read_verilog -sv; synth_xilinx -family xc7 -flatten -nodsp -top <top>; stat -json. The LUT1 to LUT6 cells are the answer", "The same Yosys in the same run: synth_xilinx -family xc7 -flatten, DSPs allowed, shown beside the answer when a game ends", "scripts/widget-data/gatle.mjs: public/widgets/gatle/pool.json with every rejected spec and its reason; --refilter tightened the code-size rule to the spec's, with no new yosys run"];
