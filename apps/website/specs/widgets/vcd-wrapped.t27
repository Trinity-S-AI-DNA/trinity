pub var VE : [65536]u8 = [0; 65536];
pub var SCO : [1024]u32 = [0; 1024];
pub var SCL : [1024]u32 = [0; 1024];

pub var SIO : [65536]u32 = [0; 65536];
pub var SIL : [65536]u32 = [0; 65536];
pub var SNO : [65536]u32 = [0; 65536];
pub var SNL : [65536]u32 = [0; 65536];
pub var STO : [65536]u32 = [0; 65536];
pub var STL : [65536]u32 = [0; 65536];
pub var SWD : [65536]u32 = [0; 65536];
pub var SFG : [65536]u8 = [0; 65536];
pub var SVO : [65536]u32 = [0; 65536];
pub var SVL : [65536]u32 = [0; 65536];
pub var SVC : [65536]u32 = [0; 65536];
pub var SHV : [65536]u8 = [0; 65536];
pub var SVA : [65536]u64 = [0; 65536];
pub var SCH : [65536]u64 = [0; 65536];
pub var SFL : [65536]u64 = [0; 65536];
pub var SEK : [65536]u8 = [0; 65536];
pub var SAL : [65536]u32 = [0; 65536];
pub var HT : [262144]u32 = [0; 262144];

pub var LIVE : [65536]u32 = [0; 65536];
pub var SRT : [65536]u32 = [0; 65536];
pub var STMP : [65536]u32 = [0; 65536];
pub var BUSY : [8]u32 = [0; 8];
pub var QUIET : [8]u32 = [0; 8];
pub var STUCK : [8]u32 = [0; 8];
pub var ENDSX : [8]u32 = [0; 8];

// ---------------------------------------------------------------- bytes and whitespace
pub fn ws_len_at(s: []const u8, p: usize, hi: usize) -> usize {
    if (p >= hi) { return 0; }
    const b : u8 = s[p];
    if (b == 32 or (b >= 9 and b <= 13)) { return 1; }
    if (b == 194 and p + 1 < hi and s[p + 1] == 160) { return 2; }
    if (p + 3 <= hi) {
        const b1 : u8 = s[p + 1];
        const b2 : u8 = s[p + 2];
        if (b == 225 and b1 == 154 and b2 == 128) { return 3; }
        if (b == 226 and b1 == 128 and ((b2 >= 128 and b2 <= 138) or b2 == 168 or b2 == 169 or b2 == 175)) { return 3; }
        if (b == 226 and b1 == 129 and b2 == 159) { return 3; }
        if (b == 227 and b1 == 128 and b2 == 128) { return 3; }
        if (b == 239 and b1 == 187 and b2 == 191) { return 3; }
    }
    return 0;
}

pub fn is_digit(b: u8) -> bool {
    return b >= 48 and b <= 57;
}

/// The UTF-16 units of the UTF-8 bytes s[lo..hi).
pub fn units_of(s: []const u8, lo: usize, hi: usize) -> u64 {
    var n : u64 = 0;
    var k : usize = lo;
    while (k < hi) {
        const b : u8 = s[k];
        if (b < 128 or b >= 192) { n = n + 1; }
        if (b >= 240) { n = n + 1; }
        k = k + 1;
    }
    return n;
}

/// The bytes of the first `units` UTF-16 units of s[lo..hi) (whole characters only); returns -1 when a pair would be split.
pub fn prefix_bytes(s: []const u8, lo: usize, hi: usize, units: u64) -> i64 {
    var n : u64 = 0;
    var k : usize = lo;
    while (k < hi) {
        const b : u8 = s[k];
        var step : usize = 1;
        var u : u64 = 1;
        if (b >= 192 and b < 224) { step = 2; }
        if (b >= 224 and b < 240) { step = 3; }
        if (b >= 240) {
            step = 4;
            u = 2;
        }
        if (n + u > units) {
            if (u == 2 and n + 1 == units) { R[R_UNSUP] = 1; }
            return (k - lo) as i64;
        }
        n = n + u;
        k = k + step;
    }
    return (hi - lo) as i64;
}

pub fn fail(code: u64, o: usize, l: usize, src: u32) -> i32 {
    R[R_ECODE] = code;
    R[R_EO] = 0;
    R[R_EL] = l as u64;
    var k : usize = 0;
    while (k < l and k < 1048576) {
        if (src == 0) { ERRB[k] = TOKB[o + k]; }
        if (src == 1) { ERRB[k] = CB[o + k]; }
        if (src == 2) { ERRB[k] = PVB[o + k]; }
        if (src == 3) { ERRB[k] = HOLD[o + k]; }
        k = k + 1;
    }
    return code as i32;
}

pub fn tok_is(w: []const u8) -> bool {
    if ((R[R_TOKN] as usize) != w.len) { return false; }
    var k : usize = 0;
    while (k < w.len) {
        if (TOKB[k] != w[k]) { return false; }
        k = k + 1;
    }
    return true;
}

pub fn cb_is(i: usize, w: []const u8) -> bool {
    if ((CTL[i] as usize) != w.len) { return false; }
    var k : usize = 0;
    while (k < w.len) {
        if (CB[(CTO[i] as usize) + k] != w[k]) { return false; }
        k = k + 1;
    }
    return true;
}

// ---------------------------------------------------------------- Number(token) for a $var width
/// -1 NaN or negative, -3 not carried, else the whole number (0 for anything in [0, 1)).
pub fn js_width(o: usize, l: usize) -> i64 {
    var p : usize = 0;
    var neg : bool = false;
    if (l == 0) { return -1; }
    const t : []const u8 = CB[0 .. 1048576];
    const b0 : u8 = t[o];
    if (b0 == 43 or b0 == 45) {
        neg = b0 == 45;
        p = 1;
    }
    if (l - p == 8 and t[o + p] == 73 and t[o + p + 1] == 110 and t[o + p + 2] == 102 and t[o + p + 3] == 105 and t[o + p + 4] == 110 and t[o + p + 5] == 105 and t[o + p + 6] == 116 and t[o + p + 7] == 121) {
        if (neg) { return -1; }
        return -3;
    }
    if (p == 0 and l > 2 and t[o] == 48) {
        const c : u8 = t[o + 1] | 32;
        var base : u64 = 0;
        if (c == 120) { base = 16; }
        if (c == 111) { base = 8; }
        if (c == 98) { base = 2; }
        if (base > 0) {
            var v : u64 = 0;
            var k : usize = 2;
            while (k < l) {
                const d : u8 = t[o + k];
                var dv : u64 = 99;
                if (is_digit(d)) { dv = (d - 48) as u64; }
                if ((d | 32) >= 97 and (d | 32) <= 102) { dv = ((d | 32) - 87) as u64; }
                if (dv >= base) { return -1; }
                if (v < 4294967296) { v = v * base + dv; }
                k = k + 1;
            }
            if (v >= 2147483648) { return -3; }
            return v as i64;
        }
    }
    var m : u64 = 0;
    var nd : u64 = 0;
    var e10 : i64 = 0;
    var digits : u64 = 0;
    var seen : bool = false;
    var big : bool = false;
    while (p < l and is_digit(t[o + p])) {
        digits = digits + 1;
        seen = true;
        if (m == 0 and t[o + p] == 48) {
            m = 0;
        } else {
            if (nd < 19) {
                m = m * 10 + ((t[o + p] - 48) as u64);
                nd = nd + 1;
            } else {
                big = true;
            }
        }
        p = p + 1;
    }
    if (p < l and t[o + p] == 46) {
        p = p + 1;
        while (p < l and is_digit(t[o + p])) {
            digits = digits + 1;
            seen = true;
            if (m == 0 and t[o + p] == 48) {
                m = 0;
            } else {
                if (nd < 19) {
                    m = m * 10 + ((t[o + p] - 48) as u64);
                    nd = nd + 1;
                } else {
                    big = true;
                }
            }
            e10 = e10 - 1;
            p = p + 1;
        }
    }
    if (!seen) { return -1; }
    if (p < l and (t[o + p] == 101 or t[o + p] == 69)) {
        p = p + 1;
        var eneg : bool = false;
        if (p < l and (t[o + p] == 43 or t[o + p] == 45)) {
            eneg = t[o + p] == 45;
            p = p + 1;
        }
        if (p >= l or !is_digit(t[o + p])) { return -1; }
        var ev : i64 = 0;
        while (p < l and is_digit(t[o + p])) {
            if (ev < 100000) { ev = ev * 10 + ((t[o + p] - 48) as i64); }
            p = p + 1;
        }
        if (eneg) { e10 = e10 - ev; } else { e10 = e10 + ev; }
    }
    if (p != l) { return -1; }
    if (m == 0 and !big) { return 0; }
    if (neg) { return -1; }
    if (big) { return -3; }
    while (m % 10 == 0) {
        m = m / 10;
        nd = nd - 1;
        e10 = e10 + 1;
    }
    if ((nd as i64) + e10 <= 0) { return 0; }
    if (e10 >= 0) {
        if ((nd as i64) + e10 > 10) { return -3; }
        var v2 : u64 = m;
        var k2 : i64 = 0;
        while (k2 < e10) {
            v2 = v2 * 10;
            k2 = k2 + 1;
        }
        if (v2 >= 2147483648) { return -3; }
        return v2 as i64;
    }
    return -3;
}

// ---------------------------------------------------------------- the reader
pub fn pool_put(w: []const u8, lo: usize, hi: usize, src: u32) -> i64 {
    const at : u64 = R[R_NP];
    if (at + ((hi - lo) as u64) >= 16777216) { return -1; }
    var k : usize = lo;
    while (k < hi) {
        if (src == 0) { NAMEP[(at as usize) + (k - lo)] = TOKB[k]; }
        if (src == 1) { NAMEP[(at as usize) + (k - lo)] = CB[k]; }
        k = k + 1;
    }
    R[R_NP] = at + ((hi - lo) as u64);
    return at as i64;
}

pub fn hash_id(o: usize, l: usize, src: u32) -> usize {
    var h : u64 = 2166136261;
    var k : usize = 0;
    while (k < l) {
        var b : u64 = 0;
        if (src == 0) { b = TOKB[o + k] as u64; }
        if (src == 1) { b = CB[o + k] as u64; }
        h = ((h ^ b) * 16777619) % 4294967296;
        k = k + 1;
    }
    return (h as usize) % 262144;
}

pub fn id_eq(si: usize, o: usize, l: usize, src: u32) -> bool {
    if ((SIL[si] as usize) != l) { return false; }
    var k : usize = 0;
    while (k < l) {
        var b : u8 = 0;
        if (src == 0) { b = TOKB[o + k]; }
        if (src == 1) { b = CB[o + k]; }
        if (NAMEP[(SIO[si] as usize) + k] != b) { return false; }
        k = k + 1;
    }
    return true;
}

/// byId.get(id): the signal index plus one, or 0.
pub fn find_sig(o: usize, l: usize, src: u32) -> usize {
    var p : usize = hash_id(o, l, src);
    while (HT[p] != 0) {
        if (id_eq((HT[p] - 1) as usize, o, l, src)) { return HT[p] as usize; }
        p = (p + 1) % 262144;
    }
    return 0;
}

/// endCommand() for $var: tokens in CB.
pub fn end_var() -> i32 {
    const nct : usize = R[R_NCT] as usize;
    if (nct < 4) { return bad_var_text(); }
    const w : i64 = js_width(CTO[1] as usize, CTL[1] as usize);
    if (w == -3) {
        R[R_UNSUP] = 1;
        return 90;
    }
    if (w < 0) { return bad_var_text(); }
    if (w > 65536) { return -1; }
    R[R_VARS] = R[R_VARS] + 1;
    // name = [...scope, ref].join('.') plus the index when it has no ':'
    const nm0 : u64 = R[R_NP];
    var k : usize = 0;
    var nlen : u64 = 0;
    while (k < (R[R_NSC] as usize)) {
        var q : usize = 0;
        while (q < (SCL[k] as usize)) {
            if (R[R_NP] >= 16777000) { return -1; }
            NAMEP[R[R_NP] as usize] = NAMEP[(SCO[k] as usize) + q];
            R[R_NP] = R[R_NP] + 1;
            q = q + 1;
        }
        NAMEP[R[R_NP] as usize] = 46;
        R[R_NP] = R[R_NP] + 1;
        k = k + 1;
    }
    var q2 : usize = 0;
    while (q2 < (CTL[3] as usize)) {
        if (R[R_NP] >= 16777000) { return -1; }
        NAMEP[R[R_NP] as usize] = CB[(CTO[3] as usize) + q2];
        R[R_NP] = R[R_NP] + 1;
        q2 = q2 + 1;
    }
    if (nct >= 5) {
        var has_colon : bool = false;
        var c : usize = 0;
        while (c < (CTL[4] as usize)) {
            if (CB[(CTO[4] as usize) + c] == 58) { has_colon = true; }
            c = c + 1;
        }
        if (!has_colon) {
            c = 0;
            while (c < (CTL[4] as usize)) {
                if (R[R_NP] >= 16777000) { return -1; }
                NAMEP[R[R_NP] as usize] = CB[(CTO[4] as usize) + c];
                R[R_NP] = R[R_NP] + 1;
                c = c + 1;
            }
        }
    }
    nlen = R[R_NP] - nm0;
    const ex : usize = find_sig(CTO[2] as usize, CTL[2] as usize, 1);
    if (ex != 0) {
        SAL[ex - 1] = SAL[ex - 1] + 1;
        R[R_NP] = nm0;
        return 0;
    }
    const si : usize = R[R_NSIG] as usize;
    if (si >= MS) { return -1; }
    const ido : i64 = pool_put(CB[0 .. 1048576], CTO[2] as usize, (CTO[2] + CTL[2]) as usize, 1);
    const tyo : i64 = pool_put(CB[0 .. 1048576], CTO[0] as usize, (CTO[0] + CTL[0]) as usize, 1);
    if (ido < 0 or tyo < 0) { return -1; }
    SIO[si] = ido as u32;
    SIL[si] = CTL[2];
    SNO[si] = nm0 as u32;
    SNL[si] = nlen as u32;
    STO[si] = tyo as u32;
    STL[si] = CTL[0];
    var wd : u32 = w as u32;
    if (wd < 1) { wd = 1; }
    SWD[si] = wd;
    var fl : u8 = 0;
    if (cb_is(0, "real") or cb_is(0, "realtime")) { fl = fl + 1; }
    if (cb_is(0, "parameter")) { fl = fl + 2; }
    if (cb_is(0, "string")) { fl = fl + 4; }
    SFG[si] = fl;
    SHV[si] = 0;
    SVL[si] = 0;
    SVC[si] = 0;
    SVA[si] = 0;
    SCH[si] = 0;
    SFL[si] = 0;
    SEK[si] = 0;
    SAL[si] = 0;
    var p : usize = hash_id(CTO[2] as usize, CTL[2] as usize, 1);
    while (HT[p] != 0) { p = (p + 1) % 262144; }
    HT[p] = (si + 1) as u32;
    R[R_NSIG] = (si + 1) as u64;
    return 0;
}

pub fn bad_var_text() -> i32 {
    // detail text = tokens joined with a space
    var n : usize = 0;
    var i : usize = 0;
    while (i < (R[R_NCT] as usize)) {
        if (i > 0 and n < 1048576) {
            ERRB[n] = 32;
            n = n + 1;
        }
        var k : usize = 0;
        while (k < (CTL[i] as usize) and n < 1048576) {
            ERRB[n] = CB[(CTO[i] as usize) + k];
            n = n + 1;
            k = k + 1;
        }
        i = i + 1;
    }
    R[R_ECODE] = 4;
    R[R_EO] = 0;
    R[R_EL] = n as u64;
    return 4;
}

pub fn timescale_fail() -> i32 {
    var n : usize = 0;
    var i : usize = 0;
    while (i < (R[R_NCT] as usize)) {
        if (i > 0 and n < 1048576) {
            ERRB[n] = 32;
            n = n + 1;
        }
        var k : usize = 0;
        while (k < (CTL[i] as usize) and n < 1048576) {
            ERRB[n] = CB[(CTO[i] as usize) + k];
            n = n + 1;
            k = k + 1;
        }
        i = i + 1;
    }
    R[R_ECODE] = 3;
    R[R_EO] = 0;
    R[R_EL] = n as u64;
    return 3;
}

/// endCommand(): the command word is R_CMD (1 timescale 2 version 3 scope 4 upscope 5 var 6 enddefinitions 7 other).
pub fn end_command() -> i32 {
    const cmd : u64 = R[R_CMD];
    const nct : usize = R[R_NCT] as usize;
    var rc : i32 = 0;
    if (cmd == 1) {
        // join without spaces, then ^(1|10|100)\s*(s|ms|us|ns|ps|fs)$
        var n : usize = 0;
        var i : usize = 0;
        while (i < nct) {
            var k : usize = 0;
            while (k < (CTL[i] as usize) and n < 64) {
                VE[n] = CB[(CTO[i] as usize) + k];
                n = n + 1;
                k = k + 1;
            }
            i = i + 1;
        }
        var d : usize = 0;
        while (d < n and is_digit(VE[d])) { d = d + 1; }
        var mul : u64 = 0;
        if (d == 1 and VE[0] == 49) { mul = 1; }
        if (d == 2 and VE[0] == 49 and VE[1] == 48) { mul = 10; }
        if (d == 3 and VE[0] == 49 and VE[1] == 48 and VE[2] == 48) { mul = 100; }
        var unit : u64 = 9;
        if (n - d == 1 and VE[d] == 115) { unit = 0; }
        if (n - d == 2 and VE[d + 1] == 115) {
            if (VE[d] == 109) { unit = 1; }
            if (VE[d] == 117) { unit = 2; }
            if (VE[d] == 110) { unit = 3; }
            if (VE[d] == 112) { unit = 4; }
            if (VE[d] == 102) { unit = 5; }
        }
        if (mul == 0 or unit == 9 or n >= 64) { return timescale_fail(); }
        R[R_TSS] = 1;
        R[R_TSM] = mul;
        R[R_TSU] = unit;
    }
    if (cmd == 2) {
        // version = tokens joined by a space
        const at : u64 = R[R_NP];
        var i2 : usize = 0;
        while (i2 < nct) {
            if (i2 > 0) {
                if (R[R_NP] >= 16777000) { return -1; }
                NAMEP[R[R_NP] as usize] = 32;
                R[R_NP] = R[R_NP] + 1;
            }
            var k2 : usize = 0;
            while (k2 < (CTL[i2] as usize)) {
                if (R[R_NP] >= 16777000) { return -1; }
                NAMEP[R[R_NP] as usize] = CB[(CTO[i2] as usize) + k2];
                R[R_NP] = R[R_NP] + 1;
                k2 = k2 + 1;
            }
            i2 = i2 + 1;
        }
        R[R_VERO] = at;
        R[R_VERL] = R[R_NP] - at;
    }
    if (cmd == 3) {
        var pick : usize = 99;
        if (nct >= 2) { pick = 1; } else { if (nct >= 1) { pick = 0; } }
        const at2 : u64 = R[R_NP];
        if (pick == 99) {
            NAMEP[at2 as usize] = 63;
            R[R_NP] = at2 + 1;
        } else {
            const o : i64 = pool_put(CB[0 .. 1048576], CTO[pick] as usize, (CTO[pick] + CTL[pick]) as usize, 1);
            if (o < 0) { return -1; }
        }
        if (R[R_NSC] >= 1024) { return -1; }
        SCO[R[R_NSC] as usize] = at2 as u32;
        SCL[R[R_NSC] as usize] = (R[R_NP] - at2) as u32;
        R[R_NSC] = R[R_NSC] + 1;
        R[R_SCOPES] = R[R_SCOPES] + 1;
    }
    if (cmd == 4) {
        if (R[R_NSC] > 0) { R[R_NSC] = R[R_NSC] - 1; }
    }
    if (cmd == 5) {
        rc = end_var();
        if (rc != 0) { return rc; }
    }
    if (cmd == 6) {
        R[R_HDR] = 0;
        if (R[R_VARS] == 0) { return fail(5, 0, 0, 0); }
    }
    R[R_CMD] = 0;
    R[R_NCT] = 0;
    R[R_CBN] = 0;
    return 0;
}

pub fn header_token() -> i32 {
    if (R[R_CMD] != 0) {
        if (tok_is("$end")) { return end_command(); }
        const n : usize = R[R_NCT] as usize;
        const tl : usize = R[R_TOKN] as usize;
        if (n >= 65536 or (R[R_CBN] as usize) + tl >= 1048576) { return -1; }
        CTO[n] = R[R_CBN] as u32;
        CTL[n] = tl as u32;
        var k : usize = 0;
        while (k < tl) {
            CB[(R[R_CBN] as usize) + k] = TOKB[k];
            k = k + 1;
        }
        R[R_CBN] = R[R_CBN] + (tl as u64);
        R[R_NCT] = (n + 1) as u64;
        return 0;
    }
    if (TOKB[0] != 36) {
        const pb : i64 = prefix_bytes(TOKB[0 .. 1048576], 0, R[R_TOKN] as usize, 40);
        return fail(2, 0, pb as usize, 0);
    }
    var c : u64 = 7;
    if (tok_is("$timescale")) { c = 1; }
    if (tok_is("$version")) { c = 2; }
    if (tok_is("$scope")) { c = 3; }
    if (tok_is("$upscope")) { c = 4; }
    if (tok_is("$var")) { c = 5; }
    if (tok_is("$enddefinitions")) { c = 6; }
    R[R_CMD] = c;
    return 0;
}

pub fn extend_into(vl: usize, width: usize) -> bool {
    // PVB[0..vl) -> VE[0..width): the rightmost width characters, or padded on the left
    if (vl >= width) {
        var k : usize = 0;
        while (k < width) {
            VE[k] = PVB[vl - width + k];
            k = k + 1;
        }
        return true;
    }
    var fill : u8 = 48;
    if (vl > 0) {
        const c : u8 = PVB[0];
        if (c == 120 or c == 88) { fill = 120; }
        if (c == 122 or c == 90) { fill = 122; }
    }
    var i : usize = 0;
    while (i < width - vl) {
        VE[i] = fill;
        i = i + 1;
    }
    var j : usize = 0;
    while (j < vl) {
        VE[width - vl + j] = PVB[j];
        j = j + 1;
    }
    return true;
}

pub fn is_unknown_char(c: u8) -> bool {
    return c == 120 or c == 88 or c == 122 or c == 90 or c == 117 or c == 85 or c == 119 or c == 87 or c == 45;
}

pub fn lower(c: u8) -> u8 {
    if (c >= 65 and c <= 90) { return c + 32; }
    return c;
}

/// /^(nan|x|z)$/i on PVB[0..vl)
pub fn is_nan_x_z(vl: usize) -> bool {
    if (vl == 1) {
        const c : u8 = lower(PVB[0]);
        return c == 120 or c == 122;
    }
    if (vl == 3) { return lower(PVB[0]) == 110 and lower(PVB[1]) == 97 and lower(PVB[2]) == 110; }
    return false;
}

pub fn store_value(si: usize, src_is_ve: bool, len: usize) -> bool {
    if ((SVC[si] as usize) < len) {
        if (R[R_VP] + (len as u64) >= 33554432) { return false; }
        SVO[si] = R[R_VP] as u32;
        SVC[si] = len as u32;
        R[R_VP] = R[R_VP] + (len as u64);
    }
    var k : usize = 0;
    while (k < len) {
        if (src_is_ve) { VALP[(SVO[si] as usize) + k] = VE[k]; } else { VALP[(SVO[si] as usize) + k] = PVB[k]; }
        k = k + 1;
    }
    SVL[si] = len as u32;
    SHV[si] = 1;
    return true;
}

/// record(id, value, kind): kind 0 scalar, 1 b, 2 r, 3 s. The value is in PVB[0..vl); the id is TOKB[io..ih).
pub fn record(io: usize, ih: usize, vl: usize, kind: u32) -> i32 {
    if (R[R_BLOCK] == 1) { return 0; }
    const sp : usize = find_sig(io, ih - io, 0);
    if (sp == 0) {
        R[R_ETS] = R[R_TSET];
        return fail(6, io, ih - io, 0);
    }
    const si : usize = sp - 1;
    SVA[si] = SVA[si] + 1;
    const fl : u8 = SFG[si];
    const isstr : bool = kind == 2 or kind == 3 or (fl % 2) == 1 or fl >= 4;
    var known : bool = false;
    var len : usize = vl;
    if (isstr) {
        known = !is_nan_x_z(vl);
    } else {
        var z : usize = 0;
        while (z < vl) {
            if (PVB[z] >= 128) {
                R[R_UNSUP] = 1;
                return 90;
            }
            z = z + 1;
        }
        len = SWD[si] as usize;
        extend_into(vl, len);
        known = true;
        var i : usize = 0;
        while (i < len) {
            if (is_unknown_char(VE[i])) { known = false; }
            i = i + 1;
        }
    }
    if (known) { SEK[si] = 1; }
    if (SHV[si] == 0) {
        if (!store_value(si, !isstr, len)) { return -1; }
        return 0;
    }
    var same : bool = (SVL[si] as usize) == len;
    var c : usize = 0;
    while (c < len and same) {
        var nb : u8 = PVB[c];
        if (!isstr) { nb = VE[c]; }
        if (VALP[(SVO[si] as usize) + c] != nb) { same = false; }
        c = c + 1;
    }
    if (same) { return 0; }
    SCH[si] = SCH[si] + 1;
    if (isstr) {
        SFL[si] = SFL[si] + 1;
    } else {
        // flipsBetween(old, new) loops over the OLD length; a shorter new value makes JS throw
        var f : u64 = 0;
        var d : usize = 0;
        while (d < (SVL[si] as usize)) {
            if (d >= len) {
                R[R_UNSUP] = 1;
                return 90;
            }
            if (lower(VALP[(SVO[si] as usize) + d]) != lower(VE[d])) { f = f + 1; }
            d = d + 1;
        }
        SFL[si] = SFL[si] + f;
    }
    if (!store_value(si, !isstr, len)) { return -1; }
    return 0;
}

pub fn set_time_from_token() -> bool {
    // TOKB[1..n) are digits
    const n : usize = R[R_TOKN] as usize;
    if (n - 1 > 19) { return false; }
    var v : u64 = 0;
    var k : usize = 1;
    while (k < n) {
        v = v * 10 + ((TOKB[k] - 48) as u64);
        k = k + 1;
    }
    TF[0] = v as f64;
    return true;
}

pub fn body_token() -> i32 {
    const n : usize = R[R_TOKN] as usize;
    if (R[R_PEND] != 0) {
        const kind : u32 = R[R_PEND] as u32;
        const vl : usize = R[R_PENDL] as usize;
        R[R_PEND] = 0;
        return record(0, n, vl, kind);
    }
    if (R[R_BLOCK] == 2) {
        if (tok_is("$end")) { R[R_BLOCK] = 0; }
        return 0;
    }
    const c : u8 = TOKB[0];
    if (c == 35) {
        var ok : bool = n >= 2;
        var k : usize = 1;
        while (k < n) {
            if (!is_digit(TOKB[k])) { ok = false; }
            k = k + 1;
        }
        if (!ok) {
            const pb : i64 = prefix_bytes(TOKB[0 .. 1048576], 0, n, 40);
            R[R_ETS] = R[R_TSET];
            return fail(7, 0, pb as usize, 0);
        }
        if (!set_time_from_token()) { R[R_UNSUP] = 1; return 90; }
        R[R_TSET] = 1;
        if (R[R_TFS] == 0) {
            TF[1] = TF[0];
            R[R_TFS] = 1;
        }
        TF[2] = TF[0];
        R[R_STAMPS] = R[R_STAMPS] + 1;
        return 0;
    }
    if (c == 36) {
        if (tok_is("$end")) {
            R[R_BLOCK] = 0;
        } else {
            if (tok_is("$dumpoff")) { R[R_BLOCK] = 1; } else {
                if (tok_is("$comment")) { R[R_BLOCK] = 2; } else { R[R_BLOCK] = 3; }
            }
        }
        return 0;
    }
    var pk : u32 = 0;
    if (c == 98 or c == 66) { pk = 1; }
    if (c == 114 or c == 82) { pk = 2; }
    if (c == 115 or c == 83) { pk = 3; }
    if (pk != 0) {
        var k2 : usize = 1;
        while (k2 < n) {
            PVB[k2 - 1] = TOKB[k2];
            k2 = k2 + 1;
        }
        R[R_PEND] = pk as u64;
        R[R_PENDL] = (n - 1) as u64;
        return 0;
    }
    const sc : bool = c == 48 or c == 49 or c == 120 or c == 88 or c == 122 or c == 90 or c == 117 or c == 85 or c == 119 or c == 87 or c == 108 or c == 76 or c == 104 or c == 72 or c == 45;
    if (sc and n > 1) {
        PVB[0] = lower(c);
        return record(1, n, 1, 0);
    }
    const pb2 : i64 = prefix_bytes(TOKB[0 .. 1048576], 0, n, 40);
    R[R_ETS] = R[R_TSET];
    return fail(7, 0, pb2 as usize, 0);
}

pub fn token_done() -> i32 {
    var rc : i32 = 0;
    if (R[R_HDR] == 1) { rc = header_token(); } else { rc = body_token(); }
    R[R_TOKN] = 0;
    return rc;
}

/// Feed bytes through the tokenizer (JS \s splits; a trailing partial token stays in TOKB).
pub fn feed(s: []const u8, lo: usize, hi: usize) -> i32 {
    var p : usize = lo;
    while (p < hi) {
        const w : usize = ws_len_at(s, p, hi);
        if (w > 0) {
            if (R[R_TOKN] > 0) {
                const rc : i32 = token_done();
                if (rc != 0) { return rc; }
            }
            p = p + w;
        } else {
            if (R[R_TOKN] >= 1048576) { return -1; }
            TOKB[R[R_TOKN] as usize] = s[p];
            R[R_TOKN] = R[R_TOKN] + 1;
            p = p + 1;
        }
    }
    return 0;
}

pub fn vcd_begin(max_header: u64) -> i32 {
    var f : usize = 0;
    while (f < 40) {
        R[f] = 0;
        f = f + 1;
    }
    var h : usize = 0;
    while (h < 262144) {
        HT[h] = 0;
        h = h + 1;
    }
    R[R_HDR] = 1;
    R[R_MAXH] = max_header;
    TF[0] = 0.0;
    TF[1] = 0.0;
    TF[2] = 0.0;
    return 0;
}

pub fn vcd_chars() -> u64 {
    return R[R_CHARS];
}

pub fn vcd_push(text: []const u8) -> i32 {
    if (R[R_STARTED] == 0) {
        const hb : i64 = prefix_bytes(text, 0, text.len, 4096);
        const hl : usize = hb as usize;
        var z : usize = 0;
        while (z < hl) {
            if (text[z] == 0) { return fail(1, 0, 0, 0); }
            z = z + 1;
        }
        var p : usize = 0;
        var w : usize = ws_len_at(text, p, hl);
        while (w > 0) {
            p = p + w;
            w = ws_len_at(text, p, hl);
        }
        if (p >= hl) {
            if (R[R_HOLD] + (text.len as u64) > 8388608) { return -1; }
            var k : usize = 0;
            while (k < text.len) {
                HOLD[(R[R_HOLD] as usize) + k] = text[k];
                k = k + 1;
            }
            R[R_HOLD] = R[R_HOLD] + (text.len as u64);
            R[R_CHARS] = R[R_CHARS] + units_of(text, 0, text.len);
            return 0;
        }
        if (text[p] != 36) {
            var e : usize = p;
            while (e < hl and ws_len_at(text, e, hl) == 0) { e = e + 1; }
            const pb : i64 = prefix_bytes(text, p, e, 40);
            R[R_ECODE] = 2;
            R[R_EL] = pb as u64;
            var q : usize = 0;
            while (q < (pb as usize)) {
                ERRB[q] = text[p + q];
                q = q + 1;
            }
            return 2;
        }
        R[R_STARTED] = 1;
    }
    R[R_CHARS] = R[R_CHARS] + units_of(text, 0, text.len);
    if (R[R_HOLD] > 0) {
        const rc0 : i32 = feed(HOLD[0 .. 8388608], 0, R[R_HOLD] as usize);
        R[R_HOLD] = 0;
        if (rc0 != 0) { return rc0; }
    }
    const rc : i32 = feed(text, 0, text.len);
    if (rc != 0) { return rc; }
    if (R[R_HDR] == 1 and R[R_CHARS] > R[R_MAXH]) { return fail(8, 0, 0, 0); }
    return 0;
}

// ---------------------------------------------------------------- summarize
pub fn name_less(a: u32, b: u32) -> bool {
    const la : usize = SNL[a as usize] as usize;
    const lb : usize = SNL[b as usize] as usize;
    var k : usize = 0;
    while (k < la and k < lb) {
        const x : u8 = NAMEP[(SNO[a as usize] as usize) + k];
        const y : u8 = NAMEP[(SNO[b as usize] as usize) + k];
        if (x != y) { return x < y; }
        k = k + 1;
    }
    return la < lb;
}

/// mode 0 busiest (changes desc, flips desc, name), 1 quietest (changes asc, flips asc, name), 2 name.
/// true when a sorts strictly before b.
pub fn before(mode: u32, a: u32, b: u32) -> bool {
    const ca : u64 = SCH[a as usize];
    const cb : u64 = SCH[b as usize];
    const fa : u64 = SFL[a as usize];
    const fb : u64 = SFL[b as usize];
    if (mode == 0) {
        if (ca != cb) { return ca > cb; }
        if (fa != fb) { return fa > fb; }
        return name_less(a, b);
    }
    if (mode == 1) {
        if (ca != cb) { return ca < cb; }
        if (fa != fb) { return fa < fb; }
        return name_less(a, b);
    }
    return name_less(a, b);
}

/// Stable merge sort of SRT[0..n) by `before`.
pub fn sort_idx(n: usize, mode: u32) -> bool {
    var w : usize = 1;
    while (w < n) {
        var lo : usize = 0;
        while (lo < n) {
            var mid : usize = lo + w;
            if (mid > n) { mid = n; }
            var hi : usize = lo + 2 * w;
            if (hi > n) { hi = n; }
            var a : usize = lo;
            var b : usize = mid;
            var o : usize = lo;
            while (a < mid or b < hi) {
                if (b >= hi or (a < mid and !before(mode, SRT[b], SRT[a]))) {
                    STMP[o] = SRT[a];
                    a = a + 1;
                } else {
                    STMP[o] = SRT[b];
                    b = b + 1;
                }
                o = o + 1;
            }
            lo = lo + 2 * w;
        }
        var c : usize = 0;
        while (c < n) {
            SRT[c] = STMP[c];
            c = c + 1;
        }
        w = w * 2;
    }
    return true;
}

pub fn has_xzuw(si: usize) -> bool {
    var k : usize = 0;
    while (k < (SVL[si] as usize)) {
        const c : u8 = lower(VALP[(SVO[si] as usize) + k]);
        if (c == 120 or c == 122 or c == 117 or c == 119 or c == 45) { return true; }
        k = k + 1;
    }
    return false;
}

/// summarize(state, top).
pub fn vcd_summarize(top: usize) -> i32 {
    const n : usize = R[R_NSIG] as usize;
    var nlive : usize = 0;
    var changes : u64 = 0;
    var flips : u64 = 0;
    var i : usize = 0;
    while (i < n) {
        changes = changes + SCH[i];
        flips = flips + SFL[i];
        if (SFG[i] / 2 % 2 == 0) {
            LIVE[nlive] = i as u32;
            nlive = nlive + 1;
        }
        i = i + 1;
    }
    var nm : usize = 0;
    var never : u64 = 0;
    var j : usize = 0;
    while (j < nlive) {
        const s : usize = LIVE[j] as usize;
        if (SCH[s] > 0) {
            SRT[nm] = s as u32;
            nm = nm + 1;
        } else {
            never = never + 1;
        }
        j = j + 1;
    }
    sort_idx(nm, 0);
    var nb : usize = nm;
    if (nb > top) { nb = top; }
    var k : usize = 0;
    while (k < nb and k < 8) {
        BUSY[k] = SRT[k];
        k = k + 1;
    }
    var m2 : usize = 0;
    while (m2 < nm) {
        j = 0;
        m2 = nm;
    }
    // quietest: the movers again, other order
    var q : usize = 0;
    var t : usize = 0;
    while (t < nlive) {
        const s2 : usize = LIVE[t] as usize;
        if (SCH[s2] > 0) {
            SRT[q] = s2 as u32;
            q = q + 1;
        }
        t = t + 1;
    }
    sort_idx(q, 1);
    var nq : usize = q;
    if (nq > top) { nq = top; }
    k = 0;
    while (k < nq and k < 8) {
        QUIET[k] = SRT[k];
        k = k + 1;
    }
    // stuck: values and never known; ends unknown: known once and the last value has x z u w -
    var ns : usize = 0;
    var ne : usize = 0;
    var stuck_all : usize = 0;
    var ends_all : usize = 0;
    t = 0;
    while (t < nlive) {
        const s3 : usize = LIVE[t] as usize;
        if (SVA[s3] > 0 and SEK[s3] == 0) {
            SRT[stuck_all] = s3 as u32;
            stuck_all = stuck_all + 1;
        }
        t = t + 1;
    }
    sort_idx(stuck_all, 2);
    k = 0;
    while (k < stuck_all and k < top and k < 8) {
        STUCK[k] = SRT[k];
        k = k + 1;
    }
    ns = stuck_all;
    t = 0;
    while (t < nlive) {
        const s4 : usize = LIVE[t] as usize;
        if (SVA[s4] > 0 and SEK[s4] == 1 and SHV[s4] == 1 and (SFG[s4] % 2) == 0 and SFG[s4] < 4 and has_xzuw(s4)) {
            SRT[ends_all] = s4 as u32;
            ends_all = ends_all + 1;
        }
        t = t + 1;
    }
    sort_idx(ends_all, 2);
    k = 0;
    while (k < ends_all and k < top and k < 8) {
        ENDSX[k] = SRT[k];
        k = k + 1;
    }
    ne = ends_all;
    SUM[0] = R[R_TSS];
    SUM[1] = R[R_TSM];
    SUM[2] = R[R_TSU];
    SUM[4] = R[R_VERO];
    SUM[5] = R[R_VERL];
    SUM[6] = R[R_STAMPS];
    SUM[7] = R[R_CHARS];
    SUM[8] = R[R_VARS];
    SUM[9] = n as u64;
    SUM[10] = (n - nlive) as u64;
    SUM[11] = R[R_SCOPES];
    SUM[12] = changes;
    SUM[13] = flips;
    SUM[14] = nb as u64;
    SUM[15] = nq as u64;
    SUM[16] = ns as u64;
    var shown : usize = ns;
    if (shown > top) { shown = top; }
    SUM[17] = shown as u64;
    SUM[18] = ne as u64;
    var shown2 : usize = ne;
    if (shown2 > top) { shown2 = top; }
    SUM[19] = shown2 as u64;
    SUM[20] = never;
    SUM[21] = nm as u64;
    SUT[0] = 0.0;
    SUT[1] = 0.0;
    if (R[R_TFS] == 1) {
        SUT[0] = TF[1];
        SUT[1] = TF[2];
    }
    SUT[2] = SUT[1] - SUT[0];
    return 0;
}

pub fn vcd_end() -> i32 {
    if (R[R_HOLD] > 0) {
        const rc0 : i32 = feed(HOLD[0 .. 8388608], 0, R[R_HOLD] as usize);
        R[R_HOLD] = 0;
        if (rc0 != 0) { return rc0; }
    }
    if (R[R_TOKN] > 0) {
        const rc : i32 = token_done();
        if (rc != 0) { return rc; }
    }
    if (R[R_STARTED] == 0) { return fail(9, 0, 0, 0); }
    if (R[R_HDR] == 1) { return fail(8, 0, 0, 0); }
    if (R[R_PEND] != 0) {
        // token: kind letter + value
        var kc : u8 = 98;
        if (R[R_PEND] == 2) { kc = 114; }
        if (R[R_PEND] == 3) { kc = 115; }
        ERRB[0] = kc;
        var k : usize = 0;
        while (k < (R[R_PENDL] as usize)) {
            ERRB[k + 1] = PVB[k];
            k = k + 1;
        }
        R[R_ECODE] = 7;
        R[R_EL] = R[R_PENDL] + 1;
        R[R_ETS] = R[R_TSET];
        return 7;
    }
    return vcd_summarize(5);
}

/// vcdSummary(text, opts): chunks of 1048576 bytes.
pub fn vcd_summary(text: []const u8, max_header: u64) -> i32 {
    vcd_begin(max_header);
    var i : usize = 0;
    while (i < text.len) {
        var e : usize = i + 1048576;
        if (e > text.len) { e = text.len; }
        const rc : i32 = vcd_push(text[i .. e]);
        if (rc != 0) { return rc; }
        i = e;
    }
    return vcd_end();
}

pub fn vcd_err_info(f: u32) -> u64 {
    if (f == 0) { return R[R_ECODE]; }
    if (f == 1) { return R[R_EO]; }
    if (f == 2) { return R[R_EL]; }
    if (f == 3) { return R[R_ETS]; }
    return 0;
}

pub fn vcd_err_time() -> f64 {
    return TF[0];
}

pub fn err_byte(i: u32) -> u8 {
    return ERRB[i as usize];
}

pub fn pool_byte(i: u32) -> u8 {
    return NAMEP[i as usize];
}

pub fn vs_info(f: u32) -> u64 {
    return SUM[f as usize];
}

pub fn vs_time(f: u32) -> f64 {
    return SUT[f as usize];
}

pub fn vs_row(kind: u32, i: u32, f: u32) -> u64 {
    var s : usize = BUSY[i as usize] as usize;
    if (kind == 1) { s = QUIET[i as usize] as usize; }
    if (f == 0) { return SNO[s] as u64; }
    if (f == 1) { return SNL[s] as u64; }
    if (f == 2) { return SWD[s] as u64; }
    if (f == 3) { return STO[s] as u64; }
    if (f == 4) { return STL[s] as u64; }
    if (f == 5) { return SCH[s]; }
    if (f == 6) { return SFL[s]; }
    return SAL[s] as u64;
}

pub fn vs_name(kind: u32, i: u32, f: u32) -> u64 {
    var s : usize = STUCK[i as usize] as usize;
    if (kind == 1) { s = ENDSX[i as usize] as usize; }
    if (f == 0) { return SNO[s] as u64; }
    return SNL[s] as u64;
}

// ---------------------------------------------------------------- spanUnits
/// Small big integers (16 limbs of 32 bits) to place a double exactly against powers of ten.
pub var BA : [20]u64 = [0; 20];
pub var BB : [20]u64 = [0; 20];

pub fn big_set(a: u32, v: u64) -> bool {
    var k : usize = 0;
    while (k < 20) {
        if (a == 0) { BA[k] = 0; } else { BB[k] = 0; }
        k = k + 1;
    }
    if (a == 0) {
        BA[0] = v % 4294967296;
        BA[1] = v / 4294967296;
    } else {
        BB[0] = v % 4294967296;
        BB[1] = v / 4294967296;
    }
    return true;
}

pub fn big_mul(a: u32, m: u64) -> bool {
    var carry : u64 = 0;
    var k : usize = 0;
    while (k < 20) {
        var cur : u64 = 0;
        if (a == 0) { cur = BA[k] * m + carry; } else { cur = BB[k] * m + carry; }
        if (a == 0) { BA[k] = cur % 4294967296; } else { BB[k] = cur % 4294967296; }
        carry = cur / 4294967296;
        k = k + 1;
    }
    return true;
}

pub fn big_mul_pow(a: u32, base: u64, e: i64) -> bool {
    var k : i64 = 0;
    while (k < e) {
        big_mul(a, base);
        k = k + 1;
    }
    return true;
}

/// compare BA with BB: -1, 0, 1
pub fn big_cmp() -> i32 {
    var k : usize = 20;
    while (k > 0) {
        k = k - 1;
        if (BA[k] > BB[k]) { return 1; }
        if (BA[k] < BB[k]) { return -1; }
    }
    return 0;
}

/// Is val (= m * 2^e2) at least 10^p ?  (p may be negative)
pub fn val_ge_pow10(m: u64, e2: i64, p: i64) -> bool {
    big_set(0, m);
    big_set(1, 1);
    if (e2 > 0) { big_mul_pow(0, 2, e2); } else { big_mul_pow(1, 2, 0 - e2); }
    if (p < 0) { big_mul_pow(0, 10, 0 - p); } else { big_mul_pow(1, 10, p); }
    return big_cmp() >= 0;
}

/// Number(val.toPrecision(4)) for a finite val >= 0 (set in SUV[0]); false when out of the carried range.
pub fn to_precision4(val: f64) -> bool {
    if (val == 0.0) {
        SUV[0] = 0.0;
        return true;
    }
    var x : f64 = val;
    var e2 : i64 = 0;
    while (x >= 9007199254740992.0) {
        x = x / 2.0;
        e2 = e2 + 1;
    }
    while (x < 4503599627370496.0) {
        x = x * 2.0;
        e2 = e2 - 1;
    }
    const m : u64 = x as u64;
    var e0 : i64 = 0;
    var y : f64 = val;
    while (y >= 10.0) {
        y = y / 10.0;
        e0 = e0 + 1;
    }
    while (y < 1.0) {
        y = y * 10.0;
        e0 = e0 - 1;
    }
    while (!val_ge_pow10(m, e2, e0)) { e0 = e0 - 1; }
    while (val_ge_pow10(m, e2, e0 + 1)) { e0 = e0 + 1; }
    var q : i64 = e0 - 3;
    // n = floor(val / 10^q + 1/2): the largest n with n * 2 * den <= 2 * num + den
    var lo : u64 = 0;
    var hi : u64 = 20000;
    while (lo < hi) {
        const mid : u64 = (lo + hi + 1) / 2;
        // num = m * 2^e2 * 10^max(-q,0); den = 2^max(-e2,0) * 10^max(q,0)
        big_set(0, m);
        big_set(1, 1);
        if (e2 > 0) { big_mul_pow(0, 2, e2); } else { big_mul_pow(1, 2, 0 - e2); }
        if (q < 0) { big_mul_pow(0, 10, 0 - q); } else { big_mul_pow(1, 10, q); }
        // left: mid * 2 * den (in BB), right: 2 * num + den
        var k : usize = 0;
        var carry : u64 = 0;
        var tmp : [20]u64 = [0; 20];
        while (k < 20) {
            tmp[k] = BB[k];
            k = k + 1;
        }
        big_mul(1, mid * 2);
        // BA = 2 * num + den
        big_mul(0, 2);
        k = 0;
        carry = 0;
        while (k < 20) {
            const cur : u64 = BA[k] + tmp[k] + carry;
            BA[k] = cur % 4294967296;
            carry = cur / 4294967296;
            k = k + 1;
        }
        if (big_cmp() >= 0) { lo = mid; } else { hi = mid - 1; }
    }
    var n : u64 = lo;
    if (n >= 10000) {
        n = 1000;
        q = q + 1;
    }
    if (q > 22 or q < -22) { return false; }
    var r : f64 = n as f64;
    if (q >= 0) { r = r * P10[q as usize]; } else { r = r / P10[(0 - q) as usize]; }
    SUV[0] = r;
    return true;
}

/// spanUnits(ticks, timescale): the value in su_value(), the unit index in the return (-1 without a timescale), -2 not carried.
pub fn span_units(ticks: f64, has_ts: bool, mul: u64, exp: i64) -> i32 {
    if (!has_ts) {
        SUV[0] = ticks;
        return -1;
    }
    P10[0] = 1.0;
    var e : usize = 1;
    while (e < 23) {
        P10[e] = P10[e - 1] * 10.0;
        e = e + 1;
    }
    const v : f64 = ticks * (mul as f64);
    var i : i64 = 0;
    while (i < 6) {
        var ue : i64 = 0;
        if (i == 1) { ue = -3; }
        if (i == 2) { ue = -6; }
        if (i == 3) { ue = -9; }
        if (i == 4) { ue = -12; }
        if (i == 5) { ue = -15; }
        const shift : i64 = exp - ue;
        var p : f64 = 1.0;
        if (shift >= 0) { p = P10[shift as usize]; } else { p = 1.0 / P10[(0 - shift) as usize]; }
        const val : f64 = v * p;
        if (val >= 1.0 or i == 5) {
            if (!to_precision4(val)) { return -2; }
            return i as i32;
        }
        i = i + 1;
    }
    return -2;
}

pub fn su_value() -> f64 {
    return SUV[0];
}
; ---- END FOLDED ----


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, issue #10938, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/vcd-wrapped/tool.js (362 lines of hand-written JavaScript)
; and, as the page's reader, vcdstats.js. The words and numbers above are unchanged: the view prints
; SAY_ constants and uses K_ lists, it writes no English of its own. "Save as PNG card" paints a
; 1200 x 630 canvas that never enters the DOM and downloads it: the card is a draw list
; (canvas_out.t27) and every width it needs is asked of the host (text_meas.t27).
; --
; THE READER IS FOLDED IN, NOT IMPORTED. specs/widgets/vcd_wrapped_logic.t27 is the differential-tested
; port of vcdstats.js. Its tables are module-level `pub var`s and t27c's `use` does not carry a
; `pub var` across modules, so vcd_summary cannot be imported. The block between the two "FOLDED"
; markers is that module's text from `pub const MS` to the end of span_units / su_value, byte for byte
; except the renames listed on the marker line (names that json_scan.t27, js_num.t27 or this spec also
; declare). Change the reader there, then regenerate this region (the build script diffs it).
; --
; Host protocol (host.js; all exports of this module):
;   w_init(hash)         the page opens on K_CARD_SAMPLE
;   w_data(i, bytes)     file i of W_DATA_FILES was fetched (0 samples.json, 1 .. 3 the three VCDs); w_data_failed(i) when it was not
;   w_click(i)           button i in document order: 0 .. 2 a sample, 3 "Save as PNG card"
;   w_file(z, name, size) -> 1 | 0    a file was picked or dropped on drop zone z: 1 = send its bytes
;   w_file_data(z, bytes) / w_file_failed(z)   the bytes, or "could not be read"
;   w_drag(z, over) -> 1 | 0          the drag entered (1) or left/dropped (0) zone z; 1 = the page changed
;   w_effect(k, dst) -> len           'v' + control index = set that control's value to ''; 'p' + "width TAB height TAB file name" =
;                                     paint w_card on a new canvas of that size and download it as a PNG
;   w_card(dst) -> len   the draw list of the card (canvas_out.t27 protocol 1; the host calls it again while w_meas_need answers)
;   w_meas_need(dst) -> len / w_meas_give(text)   text_meas.t27: the widths the card asks for
;   w_render(dst)        the page's HTML, length (0 on overflow)
; Buffers (module-level, static): samples.json META 65536 bytes, the three sample VCDs 200000 bytes each (K_MAX_SAMPLE_BYTES is the
; most a sample may have), the width memo 4096 entries / 512 KiB. The reader's own tables are in the folded block (65536 signals,
; 16 MB of names ...).
; Not carried over from JavaScript, said plainly:
;   - the sample's VCD is fetched from W_DATA_FILES, i.e. samples/<id>.vcd; the original fetched info.vcd of samples.json when
;     it named another file;
;   - a sample VCD over 200000 bytes, or samples.json over 65536 bytes, counts as not loaded;
;   - the reader refuses (status 90 or -1 in the folded block) what it does not carry: the page then says SAY_ERR_READ with the file name;
;   - samples.json and the VCDs are fetched once, at the start; the original fetched the sample again on every click;
;   - the progress sentence SAY_READING appears while the original reads a big file in chunks; this page reads the whole
;     file in one call, so it never shows it;
;   - when a sample cannot be shown after a result exists, the reader reads the previous source again (state.result must stay): a previous
;     own file over 1 MiB cannot be read again and the card button is then disabled;
;   - the card cuts a name that is longer than 512 bytes to its last 512 before it fits it (the fitted text is the same);
;   - the card's file name lowercases ASCII only; a duplicate key in samples.json reads as the first one here, the last in JSON.parse.

pub const W_META_CAP : u32 = 65536;
pub const W_VCD_CAP : u32 = 200000;
pub const W_NAME_CAP : u32 = 1000;
pub const W_MAX_HEADER : u64 = 67108864;
pub const W_DATA_FILES : [4]str = ["samples.json", "samples/counter.vcd", "samples/vsa-bind.vcd", "samples/tmu.vcd"];
pub const W_MONO : str = "Menlo, ui-monospace, SFMono-Regular, monospace";
pub const W_LINE_COLOR : str = "rgb(0,70,40)";
pub const W_TRACK_COLOR : str = "rgb(0,32,20)";

pub var META : [65536]u8 = [0; 65536];
pub var META_LEN : u32 = 0;
pub var META_ST : u32 = 0;
pub var VCDS : [600000]u8 = [0; 600000];
pub var VCD_LEN : [3]u32 = [0; 3];
pub var VCD_ST : [3]u32 = [0; 3];
pub var SAMPLE : i32 = 0 - 1;
pub var AWAIT : bool = false;
pub var RS_KIND : u32 = 0;
pub var ERR_IDX : i32 = 0 - 1;
pub var ERR_TXT : [1000]u8 = [0; 1000];
pub var ERR_TXT_LEN : u32 = 0;
pub var ERR_HAS_TIME : bool = false;
pub var ERR_TIME : f64 = 0.0;
pub var HAS_RESULT : bool = false;
pub var LAST_KIND : u32 = 0;
pub var LAST_SAMPLE : u32 = 0;
pub var OWN : [1048576]u8 = [0; 1048576];
pub var OWN_LEN : u32 = 0;
pub var OWN_OK : bool = false;
pub var SV_ON : bool = false;
pub var SV_CLS : u32 = 0;
pub var SV_A : [400]u8 = [0; 400];
pub var SV_A_LEN : u32 = 0;
pub var SV_B : [400]u8 = [0; 400];
pub var SV_B_LEN : u32 = 0;
pub var SN_ON : bool = false;
pub var SN_NUM : [64]u8 = [0; 64];
pub var SN_NUM_LEN : u32 = 0;
pub var DROP_MODE : u32 = 0;
pub var FNAME : [1000]u8 = [0; 1000];
pub var FNAME_LEN : u32 = 0;
pub var FSIZE : u64 = 0;
pub var SRC : [1000]u8 = [0; 1000];
pub var SRC_LEN : u32 = 0;
pub var SLUG : [1000]u8 = [0; 1000];
pub var SLUG_LEN : u32 = 0;
pub var DRAGGING : bool = false;
pub var EFF_CLEAR : bool = false;
pub var EFF_PNG : bool = false;

pub var TM : [16392]u32 = [0; 16392];
pub var MPOOL : [524288]u8 = [0; 524288];
pub var MWID : [4096]f64 = [0.0; 4096];
pub var MOK : [4096]u8 = [0; 4096];
pub var CUR_FONT : [160]u8 = [0; 160];
pub var CUR_FL : u32 = 0;
pub var FITB : [1200]u8 = [0; 1200];
pub var WSP : [32]u32 = [0; 32];

fn bom_skip(s: []const u8) -> usize {
    if (s.len >= 3 and s[0] == 239 and s[1] == 187 and s[2] == 191) { return 3; }
    return 0;
}

fn copy_small(dst: []u8, s: []const u8) -> u32 {
    var n : usize = s.len;
    if (n > dst.len) { n = dst.len; }
    var k : usize = 0;
    while (k < n) { dst[k] = s[k]; k = k + 1; }
    return n as u32;
}

fn set_src(s: []const u8, slug: []const u8) -> u32 {
    SRC_LEN = copy_small(SRC[0..], s);
    SLUG_LEN = copy_small(SLUG[0..], slug);
    return 0;
}

pub fn w_init(h: []const u8) -> u32 {
    META_LEN = 0;
    META_ST = 0;
    var i : usize = 0;
    while (i < 3) {
        VCD_LEN[i] = 0;
        VCD_ST[i] = 0;
        i = i + 1;
    }
    RS_KIND = 0;
    HAS_RESULT = false;
    LAST_KIND = 0;
    SV_ON = false;
    SV_CLS = 0;
    SN_ON = false;
    DROP_MODE = 0;
    FNAME_LEN = 0;
    FSIZE = 0;
    SRC_LEN = 0;
    SLUG_LEN = 0;
    DRAGGING = false;
    EFF_CLEAR = false;
    EFF_PNG = false;
    tm_reset(TM[0..16392]);
    var first : i32 = 0;
    var q : usize = 0;
    while (q < K_SAMPLE_IDS.len) {
        if (same_text(K_SAMPLE_IDS[q], K_CARD_SAMPLE)) { first = q as i32; }
        q = q + 1;
    }
    show_sample(first);
    return 0;
}

pub fn w_hash(h: []const u8) -> u32 {
    EFF_CLEAR = false;
    EFF_PNG = false;
    return 0;
}

pub fn same_text(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// --- data ----------------------------------------------------------------------------------------

pub fn w_data(i: u32, s: []const u8) -> u32 {
    EFF_CLEAR = false;
    EFF_PNG = false;
    const from : usize = bom_skip(s);
    const len : usize = s.len - from;
    if (i == 0) {
        if (len > (W_META_CAP as usize)) {
            META_ST = 2;
        } else {
            var k : usize = 0;
            while (k < len) { META[k] = s[from + k]; k = k + 1; }
            META_LEN = len as u32;
            if (jv_valid(META[0..len])) { META_ST = 1; } else { META_ST = 2; }
        }
    } else {
        if (i <= 3) {
            const j : usize = (i - 1) as usize;
            if (s.len > (W_VCD_CAP as usize)) {
                VCD_ST[j] = 2;
            } else {
                var k : usize = 0;
                const base : usize = j * (W_VCD_CAP as usize);
                while (k < s.len) { VCDS[base + k] = s[k]; k = k + 1; }
                VCD_LEN[j] = s.len as u32;
                VCD_ST[j] = 1;
            }
        }
    }
    resolve();
    return 0;
}

pub fn w_data_failed(i: u32) -> u32 {
    EFF_CLEAR = false;
    EFF_PNG = false;
    if (i == 0) { META_ST = 2; }
    if (i >= 1 and i <= 3) { VCD_ST[(i - 1) as usize] = 2; }
    resolve();
    return 0;
}

// --- choosing a sample ---------------------------------------------------------------------------

fn show_sample(i: i32) -> u32 {
    SAMPLE = i;
    AWAIT = true;
    SV_ON = false;
    SN_ON = false;
    DROP_MODE = 0;
    EFF_CLEAR = true;
    resolve();
    return 0;
}

fn load_failed() -> u32 {
    AWAIT = false;
    RS_KIND = 2;
    return 0;
}

/// showSample's async half: samples.json, then the VCD, then the reader; any failure is SAY_ERR_LOAD.
fn resolve() -> u32 {
    if (!AWAIT or SAMPLE < 0) { return 0; }
    if (META_ST == 0) { return 0; }
    if (META_ST == 2) {
        load_failed();
        return 0;
    }
    const j : usize = SAMPLE as usize;
    if (VCD_ST[j] == 0) { return 0; }
    if (VCD_ST[j] == 2) {
        load_failed();
        return 0;
    }
    const f : i64 = find_info(SAMPLE as u32);
    if (f == 0 - 2) {
        load_failed();
        return 0;
    }
    if (f >= 0 and !verdict_ok(f)) {
        load_failed();
        return 0;
    }
    const base : usize = j * (W_VCD_CAP as usize);
    const text : []const u8 = VCDS[base..(base + (VCD_LEN[j] as usize))];
    const from : usize = bom_skip(text);
    const rc : i32 = vcd_summary(text[from..text.len], W_MAX_HEADER);
    if (rc != 0) {
        restore_last();
        load_failed();
        return 0;
    }
    if (f >= 0) { sample_verdict(f); }
    AWAIT = false;
    set_src(SAY_SAMPLE_NAMES[j], K_SAMPLE_IDS[j]);
    HAS_RESULT = true;
    LAST_KIND = 1;
    LAST_SAMPLE = j as u32;
    RS_KIND = 1;
    return 0;
}

/// The reader holds ONE summary; a failed read must leave state.result as it was, so read the previous source again.
fn restore_last() -> u32 {
    if (!HAS_RESULT) { return 0; }
    if (LAST_KIND == 1) {
        const base : usize = (LAST_SAMPLE as usize) * (W_VCD_CAP as usize);
        const text : []const u8 = VCDS[base..(base + (VCD_LEN[LAST_SAMPLE as usize] as usize))];
        vcd_summary(text[bom_skip(text)..text.len], W_MAX_HEADER);
        return 0;
    }
    if (LAST_KIND == 2 and OWN_OK) {
        const text : []const u8 = OWN[0..(OWN_LEN as usize)];
        vcd_summary(text[bom_skip(text)..text.len], W_MAX_HEADER);
        return 0;
    }
    HAS_RESULT = false;
    return 0;
}

/// meta.samples?.find((s) => s.id === IDS[i]) ?? null: the span of the sample, -1 for null, -2 when JavaScript throws.
fn find_info(i: u32) -> i64 {
    const d : []const u8 = META[0..(META_LEN as usize)];
    const r : i64 = root(d);
    const rk : u8 = kind(d, r);
    if (rk == J_NULL) { return 0 - 2; }
    if (rk != J_OBJECT) { return 0 - 1; }
    const sm : i64 = obj_get(d, r, "samples");
    const sk : u8 = kind(d, sm);
    if (sk == J_NONE or sk == J_NULL) { return 0 - 1; }
    if (sk != J_ARRAY) { return 0 - 2; }
    const cnt : u32 = arr_len(d, sm);
    var q : u32 = 0;
    while (q < cnt) {
        const el : i64 = arr_at(d, sm, q);
        const ek : u8 = kind(d, el);
        if (ek == J_NULL) { return 0 - 2; }
        if (ek == J_OBJECT) {
            const idv : i64 = obj_get(d, el, "id");
            if (kind(d, idv) == J_STRING and str_is(d, idv, K_SAMPLE_IDS[i as usize])) { return el; }
        }
        q = q + 1;
    }
    return 0 - 1;
}

fn str_is(d: []const u8, sp: i64, want: []const u8) -> bool {
    if (str_len(d, sp) != (want.len as u32)) { return false; }
    var k : u32 = 0;
    while (k < (want.len as u32)) {
        if (str_byte(d, sp, k) != want[k as usize]) { return false; }
        k = k + 1;
    }
    return true;
}

/// a === b for two JSON values (a missing value is undefined; objects and arrays are never equal)
fn strict_eq(d: []const u8, a: i64, b: i64) -> bool {
    const ka : u8 = kind(d, a);
    const kb : u8 = kind(d, b);
    if (ka != kb) { return false; }
    if (ka == J_NONE or ka == J_NULL or ka == J_TRUE or ka == J_FALSE) { return true; }
    if (ka == J_STRING) {
        const la : u32 = str_len(d, a);
        if (la != str_len(d, b)) { return false; }
        var k : u32 = 0;
        while (k < la) {
            if (str_byte(d, a, k) != str_byte(d, b, k)) { return false; }
            k = k + 1;
        }
        return true;
    }
    if (ka == J_NUMBER) { return num_f64(d, a) == num_f64(d, b); }
    return false;
}

/// String(v ?? ''): null and undefined are the empty text
fn fmt_arg(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    const k : u8 = kind(d, sp);
    if (k == J_NONE or k == J_NULL) { return n0; }
    return jv_str(dst, n0, d, sp);
}

/// Would `info.verdict.pass` throw? (verdict missing or null)
fn verdict_ok(f: i64) -> bool {
    const d : []const u8 = META[0..(META_LEN as usize)];
    const vk : u8 = kind(d, obj_get(d, f, "verdict"));
    return !(vk == J_NONE or vk == J_NULL);
}

/// info.verdict.pass / .total into SV_A / SV_B, the class, and the note (num(info.vcd_bytes)).
fn sample_verdict(f: i64) -> bool {
    const d : []const u8 = META[0..(META_LEN as usize)];
    const vd : i64 = obj_get(d, f, "verdict");
    const vk : u8 = kind(d, vd);
    var pass : i64 = 0 - 1;
    var total : i64 = 0 - 1;
    if (vk == J_OBJECT) {
        pass = obj_get(d, vd, "pass");
        total = obj_get(d, vd, "total");
    }
    var tmp : [400]u8 = [0; 400];
    var n : u32 = fmt_arg(tmp[0..], 0, d, pass);
    if (n == OVER) { n = 0; }
    SV_A_LEN = copy_small(SV_A[0..], tmp[0..(n as usize)]);
    n = fmt_arg(tmp[0..], 0, d, total);
    if (n == OVER) { n = 0; }
    SV_B_LEN = copy_small(SV_B[0..], tmp[0..(n as usize)]);
    SV_ON = true;
    if (strict_eq(d, pass, total)) { SV_CLS = 1; } else { SV_CLS = 2; }
    // num(info.vcd_bytes)
    const bv : i64 = obj_get(d, f, "vcd_bytes");
    const bk : u8 = kind(d, bv);
    var m : u32 = 0;
    if (bk == J_NONE or bk == J_NULL) {
        SN_NUM[0] = 45;
        m = 1;
    } else {
        m = js_locale_num(SN_NUM[0..], 0, jv_num(d, bv));
        if (m == OVER) { m = 0; }
    }
    SN_NUM_LEN = m;
    SN_ON = true;
    return true;
}

// --- reading a file ------------------------------------------------------------------------------

fn own_picked() -> u32 {
    SAMPLE = 0 - 1;
    AWAIT = false;
    SV_ON = false;
    SN_ON = false;
    return 0;
}

pub fn w_file(z: u32, name: []const u8, size: u32) -> u32 {
    EFF_CLEAR = false;
    EFF_PNG = false;
    own_picked();
    FNAME_LEN = copy_small(FNAME[0..], name);
    FSIZE = size as u64;
    DROP_MODE = 1;
    return 1;
}

fn base_name_len() -> u32 {
    var k : u32 = FNAME_LEN;
    while (k > 0) {
        k = k - 1;
        if (FNAME[k as usize] == 46) { return k; }
    }
    return FNAME_LEN;
}

/// code index in SAY_ERR_CODES of a reader status, or -1
fn err_index(rc: i32) -> i32 {
    if (rc == 1) { return 1; }
    if (rc == 2) { return 0; }
    if (rc == 3) { return 6; }
    if (rc == 4) { return 5; }
    if (rc == 5) { return 4; }
    if (rc == 6) { return 7; }
    if (rc == 7) { return 8; }
    if (rc == 8) { return 3; }
    if (rc == 9) { return 2; }
    return 0 - 1;
}

pub fn w_file_data(z: u32, s: []const u8) -> u32 {
    EFF_CLEAR = false;
    EFF_PNG = false;
    const from : usize = bom_skip(s);
    const rc : i32 = vcd_summary(s[from..s.len], W_MAX_HEADER);
    if (rc == 0) {
        const b : u32 = base_name_len();
        set_src(FNAME[0..(FNAME_LEN as usize)], FNAME[0..(b as usize)]);
        HAS_RESULT = true;
        LAST_KIND = 2;
        OWN_OK = s.len <= 1048576;
        if (OWN_OK) {
            var q : usize = 0;
            while (q < s.len) { OWN[q] = s[q]; q = q + 1; }
            OWN_LEN = s.len as u32;
        }
        RS_KIND = 1;
        return 0;
    }
    HAS_RESULT = false;
    RS_KIND = 3;
    ERR_IDX = err_index(rc);
    ERR_TXT_LEN = 0;
    ERR_HAS_TIME = vcd_err_info(3) != 0;
    ERR_TIME = vcd_err_time();
    var l : u32 = vcd_err_info(2) as u32;
    if (l > 1000) { l = 1000; }
    var k : u32 = 0;
    while (k < l) {
        ERR_TXT[k as usize] = err_byte(k);
        k = k + 1;
    }
    ERR_TXT_LEN = l;
    return 0;
}

pub fn w_file_failed(z: u32) -> u32 {
    EFF_CLEAR = false;
    EFF_PNG = false;
    HAS_RESULT = false;
    RS_KIND = 3;
    ERR_IDX = 0 - 1;
    return 0;
}

pub fn w_drag(z: u32, over: u32) -> u32 {
    EFF_CLEAR = false;
    EFF_PNG = false;
    const want : bool = over != 0;
    if (want == DRAGGING) { return 0; }
    DRAGGING = want;
    return 1;
}

pub fn w_click(i: u32) -> u32 {
    EFF_CLEAR = false;
    EFF_PNG = false;
    if (i < (K_SAMPLE_IDS.len as u32)) {
        show_sample(i as i32);
        return 0;
    }
    if (i == (K_SAMPLE_IDS.len as u32) and HAS_RESULT) { EFF_PNG = true; }
    return 0;
}

// --- effects -------------------------------------------------------------------------------------

fn put_dec(dst: []u8, n0: u32, v: u64) -> u32 {
    var tmp : [24]u8 = [0; 24];
    const l : u32 = dec_to(tmp[0..], v);
    var k : u32 = 0;
    var n : u32 = n0;
    while (k < l) {
        dst[n as usize] = tmp[k as usize];
        n = n + 1;
        k = k + 1;
    }
    return n;
}

fn slug_name(dst: []u8, n0: u32) -> u32 {
    var any : bool = false;
    var dash : bool = false;
    var k : usize = 0;
    var tmp : [1000]u8 = [0; 1000];
    var tn : u32 = 0;
    while (k < (SLUG_LEN as usize)) {
        var c : u8 = SLUG[k];
        if (c >= 65 and c <= 90) { c = c + 32; }
        if ((c >= 97 and c <= 122) or (c >= 48 and c <= 57)) {
            if (dash and any) {
                tmp[tn as usize] = 45;
                tn = tn + 1;
            }
            dash = false;
            tmp[tn as usize] = c;
            tn = tn + 1;
            any = true;
        } else {
            dash = true;
        }
        k = k + 1;
    }
    if (!any) {
        tmp[0] = 118;
        tmp[1] = 99;
        tmp[2] = 100;
        tn = 3;
    }
    return fill_plain(dst, n0, SAY_PNG_FILE, tmp[0..(tn as usize)], "", "", 1);
}

pub fn w_effect(k: u32, dst: []u8) -> u32 {
    if (EFF_CLEAR and k < 1) {
        dst[0] = 118;
        dst[1] = k as u8;
        return 2;
    }
    if (EFF_PNG and k == 0 and HAS_RESULT) {
        var n : u32 = 0;
        dst[0] = 112;
        n = 1;
        n = put_dec(dst, n, K_CARD_W as u64);
        dst[n as usize] = 9;
        n = n + 1;
        n = put_dec(dst, n, K_CARD_H as u64);
        dst[n as usize] = 9;
        n = n + 1;
        return slug_name(dst, n);
    }
    return 0;
}

/// {0} {1} {2} filled from k values, as fill() but the values and the template go out as they are (no HTML escaping).
fn fill_plain(o: []u8, n0: u32, t: []const u8, a: []const u8, b: []const u8, c: []const u8, k: u32) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    while (i < t.len) {
        if (t[i] == 123 and i + 2 < t.len and t[i + 2] == 125 and t[i + 1] >= 48 and t[i + 1] < 48 + (k as u8) and t[i + 1] <= 50) {
            if (t[i + 1] == 48) { n = put_all(o, n, a); }
            if (t[i + 1] == 49) { n = put_all(o, n, b); }
            if (t[i + 1] == 50) { n = put_all(o, n, c); }
            i = i + 3;
        } else {
            n = put(o, n, t[i]);
            i = i + 1;
        }
    }
    return n;
}

fn put_all(o: []u8, n0: u32, s: []const u8) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    while (i < s.len) {
        n = put(o, n, s[i]);
        i = i + 1;
    }
    return n;
}

// --- numbers from the reader ---------------------------------------------------------------------

fn pool_slice(o: u64, l: u64) -> []const u8 {
    return NAMEP[(o as usize)..((o + l) as usize)];
}

fn row_name(kd: u32, i: u32) -> []const u8 {
    return pool_slice(vs_row(kd, i, 0), vs_row(kd, i, 1));
}

fn stuck_name(kd: u32, i: u32) -> []const u8 {
    return pool_slice(vs_name(kd, i, 0), vs_name(kd, i, 1));
}

/// num(v) for a count
fn grouped(dst: []u8, n0: u32, v: u64) -> u32 {
    return num_grouped(dst, n0, v);
}

/// spanText(s): `${v} ${unit}` or `${num(v)} ${no timescale}` into dst; esc: HTML-escaped
fn span_text(dst: []u8, n0: u32, esc: bool) -> u32 {
    const ticks : f64 = vs_time(2);
    const has : bool = vs_info(0) != 0;
    const u : i32 = span_units(ticks, has, vs_info(1), 0 - 3 * (vs_info(2) as i64));
    var n : u32 = n0;
    if (u < 0) {
        n = js_locale_num(dst, n, su_value());
        n = put(dst, n, 32);
        n = word_to(dst, n, SAY_NO_TIMESCALE, esc);
        return n;
    }
    n = js_str_num(dst, n, su_value());
    n = put(dst, n, 32);
    return word_to(dst, n, SAY_UNITS[u as usize], esc);
}

fn word_to(dst: []u8, n0: u32, w: []const u8, esc: bool) -> u32 {
    if (esc) { return text(dst, n0, w); }
    return raw(dst, n0, w);
}

// --- the page --------------------------------------------------------------------------------------

fn btn_open(dst: []u8, n0: u32, pressed: u32) -> u32 {
    var n : u32 = raw(dst, n0, "<button class=\"t27-btn\" type=\"button\"");
    if (pressed == 1) { n = raw(dst, n, " aria-pressed=\"true\""); }
    if (pressed == 0) { n = raw(dst, n, " aria-pressed=\"false\""); }
    return raw(dst, n, ">");
}

pub fn w_render(dst: []u8) -> u32 {
    var n : u32 = raw(dst, 0, "<div class=\"vw\"><section class=\"vw-pick\"><div class=\"vw-col\"><h2 class=\"vw-h\">");
    n = text(dst, n, SAY_SAMPLES_LABEL);
    n = raw(dst, n, "</h2><div class=\"vw-btns\">");
    var i : u32 = 0;
    while (i < (K_SAMPLE_IDS.len as u32)) {
        var p : u32 = 0;
        if (SAMPLE == (i as i32)) { p = 1; }
        n = btn_open(dst, n, p);
        n = text(dst, n, SAY_SAMPLE_NAMES[i as usize]);
        n = raw(dst, n, "</button>");
        i = i + 1;
    }
    n = raw(dst, n, "</div><p class=\"vw-line\">");
    if (SAMPLE >= 0) { n = text(dst, n, SAY_SAMPLE_LINES[SAMPLE as usize]); }
    n = raw(dst, n, "</p><p class=\"vw-verdict");
    if (SV_CLS == 1) { n = raw(dst, n, " is-good"); }
    if (SV_CLS == 2) { n = raw(dst, n, " is-bad"); }
    n = raw(dst, n, "\">");
    if (SV_ON) { n = fill(dst, n, SAY_SAMPLE_VERDICT, SV_A[0..(SV_A_LEN as usize)], SV_B[0..(SV_B_LEN as usize)], "", 2); }
    n = raw(dst, n, "</p><p class=\"vw-note\">");
    if (SN_ON) { n = fill(dst, n, SAY_SAMPLE_NOTE, SN_NUM[0..(SN_NUM_LEN as usize)], "", "", 1); }
    n = raw(dst, n, "</p></div><div class=\"vw-col\"><h2 class=\"vw-h\">");
    n = text(dst, n, SAY_OWN_LABEL);
    n = raw(dst, n, "</h2><label class=\"t27-drop vw-drop");
    if (DRAGGING) { n = raw(dst, n, " is-over"); }
    n = raw(dst, n, "\"><input type=\"file\" accept=\".vcd,text/plain\" class=\"vw-file\"");
    n = attr(dst, n, "aria-label", SAY_PICK);
    n = raw(dst, n, "><span>");
    if (DROP_MODE == 0) {
        n = text(dst, n, SAY_DROP);
    } else {
        var sz : [32]u8 = [0; 32];
        const sl : u32 = num_grouped(sz[0..], 0, FSIZE);
        n = fill(dst, n, SAY_PICKED, FNAME[0..(FNAME_LEN as usize)], sz[0..(sl as usize)], "", 2);
    }
    n = raw(dst, n, "</span></label><p class=\"vw-status\" role=\"status\">");
    n = text(dst, n, SAY_LOCAL_NOTE);
    n = raw(dst, n, "</p></div></section><section class=\"vw-result\" aria-live=\"polite\">");
    if (RS_KIND == 2) {
        n = raw(dst, n, "<p class=\"vw-error\">");
        n = text(dst, n, SAY_ERR_LOAD);
        n = raw(dst, n, "</p>");
    }
    if (RS_KIND == 3) { n = error_html(dst, n); }
    if (RS_KIND == 1) { n = result_html(dst, n); }
    n = raw(dst, n, "</section><div class=\"vw-foot\"><button class=\"t27-btn vw-png\" type=\"button\"");
    if (!HAS_RESULT) { n = raw(dst, n, " disabled=\"\""); }
    n = raw(dst, n, ">");
    n = text(dst, n, SAY_PNG_BUTTON);
    n = raw(dst, n, "</button><p class=\"vw-honest\">");
    n = text(dst, n, SAY_HONEST);
    n = raw(dst, n, "</p></div><p class=\"vw-rules\">");
    n = text(dst, n, SAY_RULES);
    n = raw(dst, n, "</p></div>");
    if (!ok(n)) { return 0; }
    return n;
}

/// errorWords(e) ?? fmt(SAY_ERR_READ, f.name)
fn error_html(dst: []u8, n0: u32) -> u32 {
    var n : u32 = raw(dst, n0, "<p class=\"vw-error\">");
    if (ERR_IDX < 0) {
        n = fill(dst, n, SAY_ERR_READ, FNAME[0..(FNAME_LEN as usize)], "", "", 1);
    } else {
        var tb : [64]u8 = [0; 64];
        var tl : u32 = 0;
        if (ERR_HAS_TIME and (ERR_IDX == 7 or ERR_IDX == 8)) {
            tl = js_locale_num(tb[0..], 0, ERR_TIME);
        } else {
            tb[0] = 45;
            tl = 1;
        }
        n = fill(dst, n, SAY_ERR_WORDS[ERR_IDX as usize], ERR_TXT[0..(ERR_TXT_LEN as usize)], tb[0..(tl as usize)], "", 2);
    }
    return raw(dst, n, "</p>");
}

fn num_text(dst: []u8, n0: u32, v: u64) -> u32 {
    return num_grouped(dst, n0, v);
}

fn result_html(dst: []u8, n0: u32) -> u32 {
    const changes : u64 = vs_info(12);
    var n : u32 = raw(dst, n0, "<div class=\"vw-top\"><div class=\"vw-lead\"><p class=\"vw-kicker\">");
    n = text(dst, n, SAY_KICKER);
    n = raw(dst, n, "</p><p class=\"vw-big\">");
    const hq : u32 = headline_split();
    n = text(dst, n, SAY_HEADLINE[0..(hq as usize)]);
    n = raw(dst, n, "<strong>");
    n = num_grouped(dst, n, changes);
    n = raw(dst, n, "</strong><span>");
    n = text(dst, n, headline_after());
    n = raw(dst, n, "</span></p><p class=\"vw-subhead\">");
    var st : [200]u8 = [0; 200];
    const stl : u32 = span_text(st[0..], 0, false);
    n = fill(dst, n, SAY_SUBHEAD, st[0..(stl as usize)], "", "", 1);
    n = raw(dst, n, "</p><p class=\"vw-busiest\">");
    if (vs_info(14) > 0) {
        var cb : [32]u8 = [0; 32];
        const cl : u32 = num_grouped(cb[0..], 0, vs_row(0, 0, 5));
        n = fill(dst, n, SAY_BUSIEST_LINE, row_name(0, 0), cb[0..(cl as usize)], "", 2);
    } else {
        n = text(dst, n, SAY_NO_MOVERS);
    }
    n = raw(dst, n, "</p><p class=\"vw-src\">");
    n = text(dst, n, SRC[0..(SRC_LEN as usize)]);
    n = raw(dst, n, "</p></div><div class=\"vw-tiles\">");
    var t : u32 = 0;
    while (t < 6) {
        const v : u64 = tile_value(t);
        n = raw(dst, n, "<div class=\"vw-tile");
        if (t >= 4 and v > 0) { n = raw(dst, n, " is-bad"); }
        n = raw(dst, n, "\"><strong>");
        n = num_grouped(dst, n, v);
        n = raw(dst, n, "</strong><span>");
        n = text(dst, n, SAY_TILE_NAMES[t as usize]);
        n = raw(dst, n, "</span></div>");
        t = t + 1;
    }
    n = raw(dst, n, "</div></div><div class=\"vw-lists\">");
    n = rows_html(dst, n, 0, "is-busy", true);
    n = rows_html(dst, n, 1, "is-quiet", false);
    n = names_html(dst, n, 0, 2);
    n = names_html(dst, n, 1, 3);
    n = raw(dst, n, "</div><div class=\"vw-meta\"><span>");
    var a : [32]u8 = [0; 32];
    var b : [32]u8 = [0; 32];
    var la : u32 = num_grouped(a[0..], 0, vs_info(20));
    var lb : u32 = num_grouped(b[0..], 0, vs_info(9) - vs_info(10));
    n = fill(dst, n, SAY_NEVER_LINE, a[0..(la as usize)], b[0..(lb as usize)], "", 2);
    n = raw(dst, n, "</span><span>");
    la = num_grouped(a[0..], 0, vs_info(8));
    lb = num_grouped(b[0..], 0, vs_info(9));
    n = fill(dst, n, SAY_VARS_LINE, a[0..(la as usize)], b[0..(lb as usize)], "", 2);
    n = raw(dst, n, "</span>");
    if (vs_info(10) != 0) {
        la = num_grouped(a[0..], 0, vs_info(10));
        n = raw(dst, n, "<span>");
        n = fill(dst, n, SAY_PARAMS_LINE, a[0..(la as usize)], "", "", 1);
        n = raw(dst, n, "</span>");
    }
    n = raw(dst, n, "<span>");
    if (vs_info(0) != 0) {
        la = dec_to(a[0..], vs_info(1));
        n = fill(dst, n, SAY_TIMESCALE, a[0..(la as usize)], SAY_UNITS[vs_info(2) as usize], "", 2);
    } else {
        n = text(dst, n, SAY_NO_TIMESCALE);
    }
    n = raw(dst, n, "</span>");
    if (vs_info(5) != 0) {
        n = raw(dst, n, "<span>");
        n = fill(dst, n, SAY_VERSION, pool_slice(vs_info(4), vs_info(5)), "", "", 1);
        n = raw(dst, n, "</span>");
    }
    n = raw(dst, n, "</div>");
    return n;
}

fn tile_value(t: u32) -> u64 {
    if (t == 0) { return vs_info(13); }
    if (t == 1) { return vs_info(9); }
    if (t == 2) { return vs_info(11); }
    if (t == 3) { return vs_info(6); }
    if (t == 4) { return vs_info(16); }
    return vs_info(18);
}

/// String(SAY_HEADLINE).split('{0}'): the length of the first piece
fn headline_split() -> u32 {
    var i : usize = 0;
    while (i + 3 <= SAY_HEADLINE.len) {
        if (SAY_HEADLINE[i] == 123 and SAY_HEADLINE[i + 1] == 48 and SAY_HEADLINE[i + 2] == 125) { return i as u32; }
        i = i + 1;
    }
    return SAY_HEADLINE.len as u32;
}

/// the second piece: between the first and the second '{0}', or the end
fn headline_after() -> []const u8 {
    const from : usize = (headline_split() as usize) + 3;
    if (from > SAY_HEADLINE.len) { return ""; }
    var e : usize = from;
    while (e + 3 <= SAY_HEADLINE.len) {
        if (SAY_HEADLINE[e] == 123 and SAY_HEADLINE[e + 1] == 48 and SAY_HEADLINE[e + 2] == 125) { return SAY_HEADLINE[from..e]; }
        e = e + 1;
    }
    return SAY_HEADLINE[from..SAY_HEADLINE.len];
}

fn rows_html(dst: []u8, n0: u32, kd: u32, cls: []const u8, bars: bool) -> u32 {
    var cnt : u32 = vs_info(14) as u32;
    if (kd == 1) { cnt = vs_info(15) as u32; }
    var n : u32 = raw(dst, n0, "<section class=\"vw-list ");
    n = raw(dst, n, cls);
    n = raw(dst, n, "\"><h3>");
    n = text(dst, n, SAY_LIST_TITLES[kd as usize]);
    n = raw(dst, n, "</h3>");
    if (cnt == 0) {
        n = raw(dst, n, "<p class=\"vw-none\">");
        n = text(dst, n, SAY_NONE);
        n = raw(dst, n, "</p></section>");
        return n;
    }
    var mx : u64 = 1;
    var i : u32 = 0;
    while (i < cnt) {
        if (vs_row(kd, i, 5) > mx) { mx = vs_row(kd, i, 5); }
        i = i + 1;
    }
    n = raw(dst, n, "<ul>");
    i = 0;
    while (i < cnt) {
        const nm : []const u8 = row_name(kd, i);
        const ch : u64 = vs_row(kd, i, 5);
        n = raw(dst, n, "<li class=\"vw-row\"><div class=\"vw-row-head\"><code class=\"vw-name\"");
        n = attr(dst, n, "title", nm);
        n = raw(dst, n, ">");
        n = text(dst, n, nm);
        n = raw(dst, n, "</code><span class=\"vw-n\">");
        var a : [32]u8 = [0; 32];
        var b : [32]u8 = [0; 32];
        const la : u32 = num_grouped(a[0..], 0, ch);
        const lb : u32 = num_grouped(b[0..], 0, vs_row(kd, i, 6));
        n = fill(dst, n, SAY_ROW, a[0..(la as usize)], b[0..(lb as usize)], "", 2);
        n = raw(dst, n, "</span></div>");
        if (bars) {
            n = raw(dst, n, "<span class=\"vw-track\"><span class=\"vw-fill\" style=\"width:");
            n = js_to_fixed(dst, n, js_max(1.0, (100.0 * (ch as f64)) / (mx as f64)), 1);
            n = raw(dst, n, "%\"></span></span>");
        }
        n = raw(dst, n, "<span class=\"vw-sub\">");
        const wd : u64 = vs_row(kd, i, 2);
        if (wd == 1) {
            n = text(dst, n, SAY_WIDTH_ONE);
        } else {
            const lw : u32 = num_grouped(a[0..], 0, wd);
            n = fill(dst, n, SAY_WIDTH, a[0..(lw as usize)], "", "", 1);
        }
        const al : u64 = vs_row(kd, i, 7);
        if (al != 0) {
            n = raw(dst, n, " / ");
            if (al == 1) {
                n = text(dst, n, SAY_ALIASES_ONE);
            } else {
                const lq : u32 = num_grouped(a[0..], 0, al);
                n = fill(dst, n, SAY_ALIASES, a[0..(lq as usize)], "", "", 1);
            }
        }
        n = raw(dst, n, "</span></li>");
        i = i + 1;
    }
    const total : u64 = vs_info(21);
    if (total > (cnt as u64)) {
        var mb : [32]u8 = [0; 32];
        const ml : u32 = num_grouped(mb[0..], 0, total - (cnt as u64));
        n = raw(dst, n, "<li class=\"vw-more\">");
        n = fill(dst, n, SAY_MORE, mb[0..(ml as usize)], "", "", 1);
        n = raw(dst, n, "</li>");
    }
    return raw(dst, n, "</ul></section>");
}

/// namesList: kd 0 the signals that never leave X or Z, 1 the ones that end in X or Z; title index ti
fn names_html(dst: []u8, n0: u32, kd: u32, ti: u32) -> u32 {
    var cnt : u32 = vs_info(17) as u32;
    var total : u64 = vs_info(16);
    if (kd == 1) {
        cnt = vs_info(19) as u32;
        total = vs_info(18);
    }
    var n : u32 = raw(dst, n0, "<section class=\"vw-list ");
    if (total > 0) {
        if (kd == 0) { n = raw(dst, n, "is-bad"); } else { n = raw(dst, n, "is-warn"); }
    }
    n = raw(dst, n, "\"><h3>");
    n = text(dst, n, SAY_LIST_TITLES[ti as usize]);
    n = raw(dst, n, "</h3>");
    if (cnt == 0) {
        n = raw(dst, n, "<p class=\"vw-none\">");
        n = text(dst, n, SAY_NONE);
        n = raw(dst, n, "</p></section>");
        return n;
    }
    n = raw(dst, n, "<ul>");
    var i : u32 = 0;
    while (i < cnt) {
        const nm : []const u8 = stuck_name(kd, i);
        n = raw(dst, n, "<li><code class=\"vw-name\"");
        n = attr(dst, n, "title", nm);
        n = raw(dst, n, ">");
        n = text(dst, n, nm);
        n = raw(dst, n, "</code></li>");
        i = i + 1;
    }
    if (total > (cnt as u64)) {
        var mb : [32]u8 = [0; 32];
        const ml : u32 = num_grouped(mb[0..], 0, total - (cnt as u64));
        n = raw(dst, n, "<li class=\"vw-more\">");
        n = fill(dst, n, SAY_MORE, mb[0..(ml as usize)], "", "", 1);
        n = raw(dst, n, "</li>");
    }
    return raw(dst, n, "</ul></section>");
}

// --- the card: tool.js savePng() -----------------------------------------------------------------

fn meas(t: []const u8) -> f64 {
    return tm_width(TM[0..16392], MPOOL[0..524288], MWID[0..4096], MOK[0..4096], CUR_FONT[0..(CUR_FL as usize)], t);
}

fn meas_font(size: u32, bold: bool, t: []const u8) -> f64 {
    var f : [160]u8 = [0; 160];
    const fl : u32 = font_text(f[0..], size, bold);
    return tm_width(TM[0..16392], MPOOL[0..524288], MWID[0..4096], MOK[0..4096], f[0..(fl as usize)], t);
}

fn font_text(f: []u8, size: u32, bold: bool) -> u32 {
    var n : u32 = 0;
    if (bold) { n = raw(f, 0, "bold "); }
    n = num(f, n, size as u64);
    n = raw(f, n, "px ");
    return raw(f, n, W_MONO);
}

/// font(size, bold): g.font = ...
fn set_font(o: []u8, n0: u32, size: u32, bold: bool) -> u32 {
    CUR_FL = font_text(CUR_FONT[0..], size, bold);
    return cv_set_str(o, n0, "font", CUR_FONT[0..(CUR_FL as usize)]);
}

fn card_color(o: []u8, n0: u32, which: u32) -> u32 {
    if (which == 0) { return cv_set_var(o, n0, "fillStyle", "--w-bg", "#000"); }
    if (which == 1) { return cv_set_var(o, n0, "fillStyle", "--w-green", "#00ff88"); }
    if (which == 2) { return cv_set_var(o, n0, "fillStyle", "--w-gold", "#ffd700"); }
    if (which == 3) { return cv_set_var(o, n0, "fillStyle", "--w-red", "#ff4d6d"); }
    if (which == 4) { return cv_set_var(o, n0, "fillStyle", "--w-text", "#e8fff7"); }
    if (which == 5) { return cv_set_var(o, n0, "fillStyle", "--w-muted", "#adc9c0"); }
    if (which == 6) { return cv_set_var(o, n0, "fillStyle", "--w-subtle", "#8fa9a0"); }
    if (which == 7) { return cv_set_str(o, n0, "fillStyle", W_LINE_COLOR); }
    return cv_set_str(o, n0, "fillStyle", W_TRACK_COLOR);
}

fn stroke_color(o: []u8, n0: u32, which: u32) -> u32 {
    if (which == 3) { return cv_set_var(o, n0, "strokeStyle", "--w-red", "#ff4d6d"); }
    return cv_set_str(o, n0, "strokeStyle", W_LINE_COLOR);
}

/// text(t, x, y, color, align, base)
fn text_at(o: []u8, n0: u32, t: []const u8, x: f64, y: f64, color: u32, align: []const u8, base: []const u8) -> u32 {
    var n : u32 = card_color(o, n0, color);
    n = cv_set_str(o, n, "textAlign", align);
    n = cv_set_str(o, n, "textBaseline", base);
    return cv_text(o, n, "fillText", t, x, y);
}

fn tail_of(t: []const u8) -> []const u8 {
    if (t.len <= 512) { return t; }
    var from : usize = t.len - 512;
    while (from < t.len and t[from] >= 128 and t[from] < 192) { from = from + 1; }
    return t[from..t.len];
}

/// fit(t, room) in the current font: the text to draw, in FITB (its length returned)
fn fit_now(t0: []const u8, room: f64) -> u32 {
    const t : []const u8 = tail_of(t0);
    var sc : [600]u8 = [0; 600];
    const lo : i64 = tm_fit_left(TM[0..16392], MPOOL[0..524288], MWID[0..4096], MOK[0..4096], CUR_FONT[0..(CUR_FL as usize)], t, room, sc[0..600]);
    var n : u32 = 0;
    var from : usize = 0;
    if (lo >= 0) {
        n = raw(FITB[0..], 0, "...");
        from = lo as usize;
    }
    var k : usize = from;
    while (k < t.len and n < 1190) {
        FITB[n as usize] = t[k];
        n = n + 1;
        k = k + 1;
    }
    return n;
}

pub fn w_card(dst: []u8) -> u32 {
    // the memo is cleared when it is more than half full or ran out: one card needs a few hundred entries
    if (TM[3] != 0 or TM[0] > 2000 or TM[1] > 262144) { tm_reset(TM[0..16392]); }
    tm_clear_miss(TM[0..16392]);
    if (!HAS_RESULT) { return 0; }
    const wd : f64 = K_CARD_W as f64;
    const hd : f64 = K_CARD_H as f64;
    const changes : u64 = vs_info(12);
    var n : u32 = cv_canvas(dst, 0, 0);
    n = card_color(dst, n, 0);
    n = cv_call4(dst, n, "fillRect", 0.0, 0.0, wd, hd);
    // brand row
    n = card_color(dst, n, 1);
    n = cv_call0(dst, n, "beginPath");
    n = cv_call2(dst, n, "moveTo", 48.0, 40.0);
    n = cv_call2(dst, n, "lineTo", 66.0, 40.0);
    n = cv_call2(dst, n, "lineTo", 57.0, 55.0);
    n = cv_call0(dst, n, "closePath");
    n = cv_call0(dst, n, "fill");
    n = set_font(dst, n, 20, true);
    n = text_at(dst, n, SAY_CARD_BRAND, 78.0, 47.0, 1, "left", "middle");
    n = set_font(dst, n, 17, false);
    var ue : usize = 0;
    while (ue < SAY_CARD_URL.len and SAY_CARD_URL[ue] != 32) { ue = ue + 1; }
    n = text_at(dst, n, SAY_CARD_URL[0..ue], wd - 48.0, 47.0, 6, "right", "middle");
    // left: the headline
    n = set_font(dst, n, 26, true);
    n = text_at(dst, n, SAY_KICKER, 48.0, 98.0, 2, "left", "alphabetic");
    var hb : [200]u8 = [0; 200];
    const hq : u32 = headline_split();
    var hl : u32 = raw(hb[0..], 0, SAY_HEADLINE[0..(hq as usize)]);
    hl = num_grouped(hb[0..], hl, changes);
    var big : u32 = 124;
    n = set_font(dst, n, big, true);
    // look-ahead: every size the loop may reach
    var sz : u32 = 124;
    meas_font(sz, true, hb[0..(hl as usize)]);
    while (sz > 48) {
        sz = sz - 4;
        meas_font(sz, true, hb[0..(hl as usize)]);
    }
    while (big > 48 and meas(hb[0..(hl as usize)]) > 600.0) {
        big = big - 4;
        n = set_font(dst, n, big, true);
    }
    n = text_at(dst, n, hb[0..(hl as usize)], 44.0, 238.0, 1, "left", "alphabetic");
    n = set_font(dst, n, 36, true);
    n = text_at(dst, n, trim_ascii(headline_after()), 48.0, 288.0, 4, "left", "alphabetic");
    n = set_font(dst, n, 22, false);
    var sub : [400]u8 = [0; 400];
    var stx : [200]u8 = [0; 200];
    const stl : u32 = span_text(stx[0..], 0, false);
    const sbl : u32 = fill_plain(sub[0..], 0, SAY_SUBHEAD, stx[0..(stl as usize)], "", "", 1);
    var fl : u32 = fit_now(sub[0..(sbl as usize)], 600.0);
    n = text_at(dst, n, FITB[0..(fl as usize)], 48.0, 330.0, 5, "left", "alphabetic");
    n = set_font(dst, n, 22, true);
    var bl : [1200]u8 = [0; 1200];
    var bn : u32 = 0;
    if (vs_info(14) > 0) {
        var cb : [32]u8 = [0; 32];
        const cl : u32 = num_grouped(cb[0..], 0, vs_row(0, 0, 5));
        bn = fill_plain(bl[0..], 0, SAY_BUSIEST_LINE, row_name(0, 0), cb[0..(cl as usize)], "", 2);
    } else {
        bn = raw(bl[0..], 0, SAY_NO_MOVERS);
    }
    const nlines : u32 = tm_wrap(TM[0..16392], MPOOL[0..524288], MWID[0..4096], MOK[0..4096], CUR_FONT[0..(CUR_FL as usize)], bl[0..(bn as usize)], 600.0, WSP[0..32]);
    var y : f64 = 384.0;
    var li : u32 = 0;
    while (li < nlines and li < 2) {
        var line : [1200]u8 = [0; 1200];
        const a : usize = WSP[(li * 2) as usize] as usize;
        const e : usize = WSP[(li * 2 + 1) as usize] as usize;
        const ll : u32 = raw(line[0..], 0, bl[a..e]);
        fl = fit_now(line[0..(ll as usize)], 600.0);
        n = text_at(dst, n, FITB[0..(fl as usize)], 48.0, y, 4, "left", "alphabetic");
        y = y + 32.0;
        li = li + 1;
    }
    // right: busiest nets as bars, then the names that never left X or Z
    const x0 : f64 = 700.0;
    const x1 : f64 = wd - 48.0;
    n = card_color(dst, n, 7);
    n = cv_call4(dst, n, "fillRect", x0 - 28.0, 80.0, 1.0, 366.0);
    n = set_font(dst, n, 20, true);
    n = text_at(dst, n, SAY_LIST_TITLES[0], x0, 98.0, 2, "left", "alphabetic");
    var rows : u32 = vs_info(14) as u32;
    if (rows > 5) { rows = 5; }
    var most : f64 = 1.0;
    var i : u32 = 0;
    while (i < rows) {
        const rc : f64 = vs_row(0, i, 5) as f64;
        if (rc > most) { most = rc; }
        i = i + 1;
    }
    y = 128.0;
    i = 0;
    while (i < rows) {
        n = set_font(dst, n, 18, true);
        var cnt : [32]u8 = [0; 32];
        const cl : u32 = num_grouped(cnt[0..], 0, vs_row(0, i, 5));
        const room : f64 = x1 - x0 - meas(cnt[0..(cl as usize)]) - 12.0;
        fl = fit_now(row_name(0, i), room);
        n = text_at(dst, n, FITB[0..(fl as usize)], x0, y, 4, "left", "alphabetic");
        n = text_at(dst, n, cnt[0..(cl as usize)], x1, y, 1, "right", "alphabetic");
        n = card_color(dst, n, 8);
        n = cv_call4(dst, n, "fillRect", x0, y + 8.0, x1 - x0, 6.0);
        n = card_color(dst, n, 1);
        n = cv_call4(dst, n, "fillRect", x0, y + 8.0, js_max(3.0, ((x1 - x0) * (vs_row(0, i, 5) as f64)) / most), 6.0);
        y = y + 46.0;
        i = i + 1;
    }
    y = y + 8.0;
    n = set_font(dst, n, 18, true);
    var tc : u32 = 6;
    if (vs_info(16) != 0) { tc = 3; }
    n = text_at(dst, n, SAY_LIST_TITLES[2], x0, y, tc, "left", "alphabetic");
    y = y + 26.0;
    n = set_font(dst, n, 16, false);
    var names : u32 = vs_info(17) as u32;
    if (names > 3) { names = 3; }
    i = 0;
    while (i < names) {
        fl = fit_now(stuck_name(0, i), x1 - x0);
        n = text_at(dst, n, FITB[0..(fl as usize)], x0, y, 5, "left", "alphabetic");
        y = y + 22.0;
        i = i + 1;
    }
    const rest : u64 = vs_info(16) - (names as u64);
    if (rest > 0) {
        var mb : [32]u8 = [0; 32];
        const ml : u32 = num_grouped(mb[0..], 0, rest);
        var mt : [200]u8 = [0; 200];
        const mtl : u32 = fill_plain(mt[0..], 0, SAY_MORE, mb[0..(ml as usize)], "", "", 1);
        n = text_at(dst, n, mt[0..(mtl as usize)], x0, y, 6, "left", "alphabetic");
    } else {
        if (names == 0) { n = text_at(dst, n, SAY_NONE, x0, y, 6, "left", "alphabetic"); }
    }
    // tiles
    const gap : f64 = 12.0;
    const tw : f64 = (wd - 96.0 - gap * 5.0) / 6.0;
    const ty : f64 = 470.0;
    var t : u32 = 0;
    while (t < 6) {
        const v : u64 = tile_value(t);
        const tx : f64 = 48.0 + (t as f64) * (tw + gap);
        var bad : bool = false;
        if (t >= 4 and v > 0) { bad = true; }
        if (bad) { n = stroke_color(dst, n, 3); } else { n = stroke_color(dst, n, 7); }
        n = cv_set_num(dst, n, "lineWidth", 2.0);
        n = cv_call4(dst, n, "strokeRect", tx + 1.0, ty + 1.0, tw - 2.0, 90.0);
        n = set_font(dst, n, 38, true);
        var vb : [32]u8 = [0; 32];
        const vl : u32 = num_grouped(vb[0..], 0, v);
        fl = fit_now(vb[0..(vl as usize)], tw - 24.0);
        if (bad) { n = text_at(dst, n, FITB[0..(fl as usize)], tx + 16.0, ty + 50.0, 3, "left", "alphabetic"); } else { n = text_at(dst, n, FITB[0..(fl as usize)], tx + 16.0, ty + 50.0, 1, "left", "alphabetic"); }
        n = set_font(dst, n, 15, false);
        fl = fit_now(SAY_TILE_NAMES[t as usize], tw - 24.0);
        n = text_at(dst, n, FITB[0..(fl as usize)], tx + 16.0, ty + 76.0, 5, "left", "alphabetic");
        t = t + 1;
    }
    // footer
    n = set_font(dst, n, 16, true);
    const dropw : f64 = meas(SAY_DROP);
    n = text_at(dst, n, SAY_DROP, wd - 48.0, hd - 30.0, 2, "right", "middle");
    n = set_font(dst, n, 16, false);
    var ft : [1400]u8 = [0; 1400];
    var fnl : u32 = copy_small(ft[0..], SRC[0..(SRC_LEN as usize)]);
    if (vs_info(5) != 0) {
        fnl = raw(ft[0..], fnl, "  |  ");
        var vt : [600]u8 = [0; 600];
        var vn : u32 = vs_info(5) as u32;
        if (vn > 500) { vn = 500; }
        const vv : u32 = fill_plain(vt[0..], 0, SAY_VERSION, pool_slice(vs_info(4), vn as u64), "", "", 1);
        fnl = raw(ft[0..], fnl, vt[0..(vv as usize)]);
    }
    fl = fit_now(ft[0..(fnl as usize)], wd - 96.0 - dropw - 24.0);
    n = text_at(dst, n, FITB[0..(fl as usize)], 48.0, hd - 30.0, 6, "left", "middle");
    if (!cv_ok(n)) { return 0; }
    return n;
}

fn trim_ascii(s: []const u8) -> []const u8 {
    var a : usize = 0;
    var b : usize = s.len;
    while (a < b and (s[a] == 32 or (s[a] >= 9 and s[a] <= 13))) { a = a + 1; }
    while (b > a and (s[b - 1] == 32 or (s[b - 1] >= 9 and s[b - 1] <= 13))) { b = b - 1; }
    return s[a..b];
}

pub fn w_meas_need(dst: []u8) -> u32 {
    return tm_need(TM[0..16392], MPOOL[0..524288], MOK[0..4096], dst);
}

pub fn w_meas_give(s: []const u8) -> u32 {
    return tm_give(TM[0..16392], MOK[0..4096], MWID[0..4096], s);
}

// --- Tests of the native page -------------------------------------------------------------------------

fn has(o: []const u8, n: u32, want: []const u8) -> bool {
    if (n < (want.len as u32)) { return false; }
    var i : usize = 0;
    while (i + want.len <= (n as usize)) {
        var k : usize = 0;
        while (k < want.len and o[i + k] == want[k]) { k = k + 1; }
        if (k == want.len) { return true; }
        i = i + 1;
    }
    return false;
}

pub const W_TEST_VCD : str = "$timescale 1ps $end $scope module tb $end $var wire 1 ! clk $end $var wire 4 \" q $end $upscope $end $enddefinitions $end #0 0! b0 \" #5 1! b1 \" #10 0! b11 \" #15 1!";
pub const W_TEST_META : str = "{\"samples\":[{\"id\":\"counter\",\"vcd_bytes\":1234,\"verdict\":{\"pass\":7,\"total\":7}},{\"id\":\"vsa-bind\",\"vcd_bytes\":9,\"verdict\":{\"pass\":1,\"total\":2}}]}";

fn open_page() -> u32 {
    w_init("");
    w_data(0, W_TEST_META);
    w_data(1, W_TEST_VCD);
    w_data(2, W_TEST_VCD);
    w_data(3, W_TEST_VCD);
    return 0;
}

test the_page_opens_on_the_card_sample_and_waits_for_its_data {
    var o : [131072]u8 = [0; 131072];
    w_init("");
    const n : u32 = w_render(o[0..]);
    assert has(o[0..], n, "aria-pressed=\"true\">t27 ClockedCounter");
    assert has(o[0..], n, "vw-png\" type=\"button\" disabled=\"\"");
    assert !has(o[0..], n, "vw-top");
    open_page();
    const m : u32 = w_render(o[0..]);
    assert has(o[0..], m, "<div class=\"vw-top\">");
    assert has(o[0..], m, "<p class=\"vw-verdict is-good\">The testbench&#39;s own verdict: 7 of 7 checks passed.</p>");
    assert has(o[0..], m, "Shipped as vvp dumped it, not trimmed: 1,234 bytes.");
    assert !has(o[0..], m, "disabled=\"\"");
}

test a_dump_is_summed_up_the_way_vcdstats_counts_it {
    open_page();
    var o : [131072]u8 = [0; 131072];
    const n : u32 = w_render(o[0..]);
    assert vs_info(12) == 5;
    assert vs_info(13) == 5;
    assert vs_info(6) == 4;
    assert has(o[0..], n, "<strong>5</strong><span> value changes</span>");
    assert has(o[0..], n, "over 15 ps of simulated time");
    assert has(o[0..], n, "Your busiest net was tb.clk, with 3 changes.");
    assert has(o[0..], n, "<code class=\"vw-name\" title=\"tb.clk\">tb.clk</code><span class=\"vw-n\">changes 3, flips 3</span>");
    assert has(o[0..], n, "$timescale 1ps");
    assert has(o[0..], n, "<section class=\"vw-list \"><h3>Never left X or Z</h3><p class=\"vw-none\">none</p></section>");
}

test a_file_that_is_not_a_vcd_is_refused_in_the_words_of_the_spec {
    open_page();
    assert w_file(0, "My Dump.VCD", 5) == 1;
    w_file_data(0, "hello");
    var o : [131072]u8 = [0; 131072];
    const n : u32 = w_render(o[0..]);
    assert has(o[0..], n, "<p class=\"vw-error\">Not a VCD file: a VCD starts with a $ keyword such as $date or $timescale, and this starts with &quot;hello&quot;.</p>");
    assert has(o[0..], n, "My Dump.VCD: 5 bytes");
    assert has(o[0..], n, "disabled=\"\"");
    w_file_data(0, "");
    const m : u32 = w_render(o[0..]);
    assert has(o[0..], m, "<p class=\"vw-error\">The file is empty.</p>");
    w_file_failed(0);
    const k : u32 = w_render(o[0..]);
    assert has(o[0..], k, "<p class=\"vw-error\">Could not read My Dump.VCD.</p>");
}

test the_card_asks_for_widths_until_it_has_them_and_names_its_file {
    open_page();
    w_file(0, "My Dump.VCD", 100);
    w_file_data(0, W_TEST_VCD);
    w_click(3);
    var e : [256]u8 = [0; 256];
    const l : u32 = w_effect(0, e[0..]);
    assert l > 0;
    assert has(e[0..], l, "vcd-wrapped-my-dump.png");
    var c : [131072]u8 = [0; 131072];
    var need : [65536]u8 = [0; 65536];
    var g : [3000]u8 = [0; 3000];
    var q : usize = 0;
    while (q + 3 <= 3000) {
        g[q] = 49;
        g[q + 1] = 48;
        g[q + 2] = 10;
        q = q + 3;
    }
    var pass : u32 = 0;
    var n : u32 = 0;
    var open : u32 = 1;
    while (open > 0 and pass < 60) {
        n = w_card(c[0..]);
        open = w_meas_need(need[0..]);
        if (open > 0) { w_meas_give(g[0..]); }
        pass = pass + 1;
    }
    assert open == 0;
    assert pass >= 2;
    assert has(c[0..], n, "[\"c\",0],[\"s\",\"fillStyle\",{\"v\":\"--w-bg\",\"f\":\"#000\"}],[\"m\",\"fillRect\",0,0,1200,630],");
    assert has(c[0..], n, "[\"s\",\"font\",\"bold 20px Menlo, ui-monospace, SFMono-Regular, monospace\"]");
    assert has(c[0..], n, "[\"m\",\"fillText\",\"TRINITY S3AI  /  VCD WRAPPED\",78,47],");
    assert has(c[0..], n, "[\"m\",\"fillText\",\"5\",44,238],");
    // every width is 10 px: a name of 6 letters fits, so nothing is cut
    assert has(c[0..], n, "[\"m\",\"fillText\",\"tb.clk\",700,128],");
    assert has(c[0..], n, "[\"m\",\"fillText\",\"Your busiest net was tb.clk, with 3 changes.\",48,384],");
}

test samples_json_without_a_verdict_says_the_samples_did_not_load {
    w_init("");
    w_data(0, "{\"samples\":[{\"id\":\"counter\"}]}");
    w_data(1, W_TEST_VCD);
    var o : [131072]u8 = [0; 131072];
    const n : u32 = w_render(o[0..]);
    assert has(o[0..], n, "<p class=\"vw-error\">The sample simulations did not load.</p>");
    assert !has(o[0..], n, "vw-top");
    w_data_failed(2);
    w_click(1);
    const m : u32 = w_render(o[0..]);
    assert has(o[0..], m, "<p class=\"vw-error\">The sample simulations did not load.</p>");
}

/// The splicer follows only the names a module itself mentions, not the names the imported functions
/// mention. This anchor mentions every helper the writer, the JSON reader, the number rules and the
/// canvas writers call. Never called.
pub fn imports_anchor(o: []u8, s: []const u8, m: []u32, f: []f64, k: []u8) -> u32 {
    var n : u32 = 0;
    n = n + (ok(0) as u32);
    n = n + OVER;
    n = n + put(o, 0, 0);
    n = n + raw(o, 0, s);
    n = n + put_escaped(o, 0, 0);
    n = n + text(o, 0, s);
    n = n + num(o, 0, 0);
    n = n + attr(o, 0, s, s);
    n = n + fill(o, 0, s, s, s, s, 0);
    n = n + fill_named(o, 0, s, s, s, s, s, s, s, s, s, s, s, s, s);
    n = n + dec_to(o, 0);
    n = n + (name_is(s, 0, 0, s) as u32);
    n = n + (is_word_byte(0) as u32);
    n = n + (H_LT as u32);
    n = n + (H_GT as u32);
    n = n + (H_AMP as u32);
    n = n + (H_QUOTE as u32);
    n = n + (H_APOS as u32);
    n = n + (H_SPACE as u32);
    n = n + (H_SLASH as u32);
    n = n + (H_EQ as u32);
    n = n + num_grouped(o, 0, 0);
    n = n + ((NO_SPAN < 0) as u32);
