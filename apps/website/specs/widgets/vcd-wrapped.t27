pub const SAY_PNG_FILE : str = "vcd-wrapped-{0}.png";
pub const SAY_CARD_BRAND : str = "TRINITY S3AI  /  VCD WRAPPED";
pub const SAY_CARD_URL : str = "t27.ai/widgets/vcd-wrapped/ -- read in the browser, nothing uploaded";
