; --- Tests: each holds of this file, and scripts/widget-data/vcd-wrapped.mjs runs them again with
; every K_ fact replaced by the value read from the shipped VCDs.
test the_t27_counter_passes_its_checks_and_clk_is_busiest {
    assert K_SAMPLE_KINDS[0] == "t27";
    assert K_SAMPLE_IDS[0] == K_CARD_SAMPLE;
    assert K_CHECKS_TOTAL[0] > 0;
    assert K_CHECKS_PASS[0] == K_CHECKS_TOTAL[0];
    assert K_BUSIEST_CHANGES[0] > 0;
    assert K_BUSIEST_CHANGES[0] <= K_CHANGES[0];
    assert K_STUCK_XZ[0] > 0;
    assert K_ENDS_XZ[0] == 0;
}

test the_tmu_run_fails_its_checks_and_leaves_x {
    assert K_SAMPLE_SOURCES[2] == "fpga/openxc7-synth/tmu.v";
    assert K_CHECKS_TOTAL[2] > 0;
    assert K_CHECKS_PASS[2] == 0;
    assert K_STUCK_XZ[2] + K_ENDS_XZ[2] > 0;
    assert K_PARAMS[2] > 0;
}

test the_counts_agree_with_each_other {
    assert K_CHANGES[0] <= K_FLIPS[0];
    assert K_CHANGES[1] <= K_FLIPS[1];
    assert K_CHANGES[2] <= K_FLIPS[2];
    assert K_SIGNALS[0] <= K_VARS[0];
    assert K_SIGNALS[1] <= K_VARS[1];
    assert K_SIGNALS[2] <= K_VARS[2];
    assert K_NEVER_CHANGED[0] + K_PARAMS[0] <= K_SIGNALS[0];
    assert K_NEVER_CHANGED[2] + K_PARAMS[2] <= K_SIGNALS[2];
    assert K_STUCK_XZ[0] + K_ENDS_XZ[0] <= K_SIGNALS[0];
    assert K_STUCK_XZ[2] + K_ENDS_XZ[2] <= K_SIGNALS[2];
    assert K_SPAN[0] > 0;
    assert K_SPAN[1] > 0;
    assert K_SPAN[2] > 0;
    assert K_STAMPS[1] > 0;
}

test the_vsa_bind_run_passes_clean {
    assert K_SAMPLE_KINDS[1] == "repo";
    assert K_CHECKS_TOTAL[1] > 0;
    assert K_CHECKS_PASS[1] == K_CHECKS_TOTAL[1];
    assert K_STUCK_XZ[1] == 0;
    assert K_CHANGES[1] > 0;
}

test the_page_reads_files_and_sends_nothing {
    assert READS_LOCAL_FILES == true;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
    assert K_CARD_W == 1200;
    assert K_CARD_H == 630;
    assert K_MIN_TARGET_PX >= 32;
    assert K_MAX_SAMPLE_BYTES <= 200000;
    assert SAY_ERR_CODES[0] == "not-vcd";
    assert SAY_ERR_CODES[8] == "bad-token";
}

