pub const KIND : str = "widget-tool";
pub const ID : str = "vcd-wrapped";
pub const TITLE : str = "VCD wrapped: your simulation, summed up on one card";
pub const DESCRIPTION : str = "Drop a .vcd from any simulator and get a Wrapped-style card: value changes, the busiest net, signals stuck at X or Z, the quietest ones and the time span, read in your browser.";
pub const IMAGE_ALT : str = "A Wrapped-style summary card on black for a real Icarus Verilog 12.0 run of the t27 ClockedCounter: 1,418 value changes over 2.925 us of simulated time, the busiest net clk with 585 changes, 4 signals that never leave X or Z, and 14 signals in 4 scopes.";
pub const HOOK : str = "Your testbench toggled clk 585 times and left 4 signals at X all run. Drop your .vcd and see your simulation, wrapped.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [7]str = ["Icarus Verilog version 12.0 (stable), iverilog and vvp; one run per sample, one at a time: iverilog -g2012 -s <top> -o sim.vvp <testbench> <design>; vvp -n sim.vvp; each command, the tool versions and the testbench's verdict lines in samples.json", "specs/ternary/clocked_counter.t27, compiled to Verilog by public/t27/t27_compiler.wasm in node (sha256 of spec and generated Verilog in samples.json)", "scripts/widget-data/vcd-wrapped-counter-tb.v: a hand-written testbench for the generated ClockedCounter, not from the spec; it checks the spec's own test, hold on en low, the u8 wrap and the asynchronous reset", "fpga/openxc7-synth/vsa_bind_16.v with fpga/openxc7-synth/tb/tb_vsa_bind_16.v, and fpga/openxc7-synth/tmu.v with fpga/openxc7-synth/tmu_tb.v, committed RTL and testbenches run unchanged", "The VCDs are shipped as vvp dumped them, not trimmed; each is under 200000 bytes", "public/widgets/vcd-wrapped/vcdstats.js: the one VCD reader, run in node for the samples and in the browser for your file", "node scripts/widget-data/vcd-wrapped.mjs --check: re-reads the shipped VCDs and fails if any K_ fact in this spec disagrees"];
