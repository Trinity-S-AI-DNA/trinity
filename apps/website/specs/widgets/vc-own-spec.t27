// SPDX-License-Identifier: Apache-2.0
; specs/widgets/vc-own-spec.t27 -- lesson 25 of the Vibecoding course: the parts of a spec for your own idea
; Source of truth for public/widgets/vc-own-spec/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: specs/vibecoding/own_spec.t27 (the Vibecoding from zero course, module own).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_vc_own_spec;

pub const KIND : str = "widget-tool";
pub const ID : str = "vc-own-spec";
pub const TITLE : str = "A spec for your own idea: one input, one output, one test";
pub const DESCRIPTION : str = "The three parts an idea needs before you hand it to an agent, filled in for a made-up reading log. Lesson 25 of the Vibecoding course.";
pub const IMAGE_ALT : str = "A black and white diagram of five steps, idea, one input, one output, one test, hand to the agent, and a table that fills in each part for a reading log: input one book title, output the count of books logged, done test the count goes up by one after one title.";
pub const HOOK : str = "Before an agent writes anything, can you name one input, one output and the test that says done? Fill them in for a reading log.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec specs/vibecoding/own_spec.t27: its constants IDEA_INPUTS, IDEA_OUTPUTS and IDEA_TESTS are 1 each and its 4 tests pass in the site test runner", "The reading log is a made-up example written for this lesson; no run of a real project is quoted"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "The reading log, as a spec";
pub const SAY_TABLE_HEAD : [2]str = ["Part", "In the reading log"];
pub const SAY_TABLE_CELLS : [8]str = ["One input", "one book title", "One output", "how many books are logged", "One test that says done", "after one title the count is 1", "Ready to hand over", "1 x 1 x 1 = 1"];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 4;
pub const K_TABLE_CELLS : u16 = 8;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "From an idea to a hand-over";
pub const SAY_FLOW_STEPS : [5]str = ["An idea", "One input", "One output", "One test", "Hand it to the agent"];
pub const K_FLOW_STEPS : u8 = 5;
pub const SAY_NOTE : str = "Set the test count to 0 in the lesson spec and the idea is no longer ready.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 5;
    assert K_FLOW_STEPS > 1;
}
