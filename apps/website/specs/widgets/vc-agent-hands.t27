// SPDX-License-Identifier: Apache-2.0
; specs/widgets/vc-agent-hands.t27 -- the infographic of lesson 20 of the Vibecoding from zero course (specs/course_recipe/vibecoding-plan.t27)
; Source of truth for public/widgets/vc-agent-hands/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: specs/vibecoding/agent_hands.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_vc_agent_hands;

pub const KIND : str = "widget-tool";
pub const ID : str = "vc-agent-hands";
pub const TITLE : str = "Vibecoding 20: tools an agent can call";
pub const DESCRIPTION : str = "Three tools, which run at once and which wait for a yes, and the cap on calls in one turn. Lesson 20 of the Vibecoding from zero course.";
pub const IMAGE_ALT : str = "A black and white table of three tools, read a file, run the tests and write a file, with who may start each one; a diagram follows one call from the agent naming a tool to the host checking the list, running it and sending the result back.";
pub const HOOK : str = "Reading and testing run at once; writing waits for your yes.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [1]str = ["The lesson spec specs/vibecoding/agent_hands.t27, whose tests pass in the site test runner; the tool ids and the cap on calls on this page are its constants"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Tools and who may start them";
pub const SAY_TABLE_HEAD : [3]str = ["Id", "Tool", "Runs"];
pub const SAY_TABLE_CELLS : [9]str = ["0", "Read a file", "At once", "1", "Run the tests", "At once", "2", "Write a file", "After your yes"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 3;
pub const K_TABLE_CELLS : u16 = 9;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "One tool call";
pub const SAY_FLOW_STEPS : [5]str = ["The agent names a tool", "The host checks the list", "A write waits for a yes", "The host runs the tool", "The result goes back as text"];
pub const K_FLOW_STEPS : u8 = 5;
pub const SAY_NOTE : str = "The loop is capped: of 9 calls asked in one turn, the host lets 5 through.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 5;
    assert K_FLOW_STEPS > 1;
}
