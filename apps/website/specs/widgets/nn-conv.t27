// SPDX-License-Identifier: Apache-2.0
; specs/widgets/nn-conv.t27 -- a window over a picture: 2 x 2 average pooling
; Source of truth for public/widgets/nn-conv/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/nn-conv/logic.js -- the fn bodies of
; gHashTag/t27 specs/ml/layers/avgpool2d_layer.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 10 of the course neural-networks. ASCII only (L3), English only (LANG-EN).
; Numbers are integers (the schema reads no float): a K_ name ending in _C is in hundredths.

; WHAT IT DOES: the reader taps a window, on the image or on the output, and toggles the gradient
; view. Outputs are pool4_at(i), the output side calc_output_size(4) and the gradient
; backward4_at(i) for the spec's output gradients (4, 8, 12, 16).

; WHAT IT DOES NOT CLAIM: this is AVERAGE pooling with a fixed 2 x 2 window, not a convolution with
; a learned kernel: the sliding conv2d spec is gHashTag/t27#10612, not merged when this page was
; made.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_nn_conv;

pub const KIND : str = "widget-tool";
pub const ID : str = "nn-conv";
pub const TITLE : str = "Patches of a picture: a 2 x 2 window, averaged";
pub const DESCRIPTION : str = "Tap a window on the 4 x 4 image: each output is the average of its 2 x 2 patch, two cells apart. Then switch to the gradient and see each output's blame shared out over its patch.";
pub const IMAGE_ALT : str = "Window card: a 4 x 4 image holding 0 to 15, with the 2 x 2 patch 2, 3, 6, 7 outlined and the rest dimmed; beside it the 2 x 2 output 2.50, 4.50, 10.50, 12.50 with 4.50 outlined. Tiles read window 2 / 4, average 4.50, output 2 x 2 and gradient share 2.00.";
pub const HOOK : str = "Pictures are read in patches. Here a 2 x 2 window steps by 2 over a 4 x 4 image and averages: 2.5, 4.5, 10.5, 12.5. A learned kernel comes next.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/ml/layers/avgpool2d_layer.t27 (t27 master 239b4b059): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Course 10 of t27.ai, neural-networks (gHashTag/trinity#1695): lesson 10 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and fixtures the spec holds (held equal by the tests below)
pub const K_SIDE : u8 = 4;
pub const K_KERNEL : u8 = 2;
pub const K_DEFAULT_KERNEL : u8 = 2;
pub const K_DEFAULT_STRIDE : u8 = 2;
pub const K_WIN_ROW : [4]u8 = [0, 0, 2, 2];
pub const K_WIN_COL : [4]u8 = [0, 2, 0, 2];
pub const K_PRESET_WIN : [3]u8 = [1, 0, 3];
pub const K_PRESET_GRAD : [3]u8 = [0, 0, 1];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [3]str = ["Window 2", "Window 1", "The gradient of window 4"];
pub const SAY_ASK : str = "How does a network look at a picture: all at once, or in patches?";
pub const SAY_SHOW_GRAD : str = "show the gradient";
pub const SAY_IN_LABEL : str = "The 4 x 4 input: tap a patch";
pub const SAY_GRAD_LABEL : str = "The gradient each input receives";
pub const SAY_OUT_LABEL : str = "The 2 x 2 output: one number per patch";
pub const SAY_WINDOW : str = "window";
pub const SAY_AVERAGE : str = "its average";
pub const SAY_OUT_SIDE : str = "output";
pub const SAY_GRAD_SHARE : str = "gradient per input";
pub const SAY_NOTE : str = "Average pooling, not yet a convolution: every window weighs its four cells equally. A convolution would weigh them with a learned 2 x 2 kernel and usually step by 1; that spec (t27#10612) is still open.";
pub const SAY_SOURCE : str = "Logic: t27 spec ml/layers/avgpool2d_layer.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_windows_tile_the_image {
    assert K_SIDE == 4;
    assert K_KERNEL == 2;
    assert K_WIN_ROW[3] + K_KERNEL == K_SIDE;
    assert K_WIN_COL[1] + K_KERNEL == K_SIDE;
}

test the_window_steps_by_its_own_size {
    assert K_DEFAULT_KERNEL == K_DEFAULT_STRIDE;
    assert K_WIN_COL[1] == K_DEFAULT_STRIDE;
    assert K_PRESET_WIN[2] == 3;
}
