// SPDX-License-Identifier: Apache-2.0
; specs/widgets/fir-fit.t27 -- does it fit and close timing: a FIR on the 740 slices of the XC7A200T
; Source of truth for public/widgets/fir-fit/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/fir-fit/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 26 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader sets the filter (taps, symmetry), the sample and clock rates, how many
; channels, the adder structure and two delays. The 740 slices of the 200T fill channel by channel; a
; timing bar puts one register-to-register path -- a fixed part plus one adder delay per level -- against
; the clock period: a direct-form adder tree has ceil(log2 taps) levels, a systolic chain one.

; WHAT IT DOES NOT CLAIM: the delays are the reader's, not a timing report; routing, BRAM and control logic are not counted.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_fir_fit;

pub const KIND : str = "widget-tool";
pub const ID : str = "fir-fit";
pub const TITLE : str = "Does it fit, and does it close timing?";
pub const DESCRIPTION : str = "Set a filter, its rates and a channel count: watch the 740 DSP slices of an XC7A200T fill, and a register-to-register path race the clock period.";
pub const IMAGE_ALT : str = "FIR fit card: 63 symmetric taps at 50 MHz on a 250 MHz clock, 16 channels. Each channel takes 7 slices, 112 of 740; a direct adder tree of 6 levels misses the 4000 ps period, a systolic chain makes it.";
pub const HOOK : str = "16 channels of a 63-tap filter take 112 of the 740 slices. The adder tree is what misses timing: a systolic chain has one adder per register.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "Xilinx DS180, 7 Series FPGAs Data Sheet: Overview: 740 DSP48E1 slices on the XC7A200T", "Xilinx UG479, 7 Series DSP48E1 Slice User Guide: the PCIN/PCOUT cascade that a systolic FIR chains through"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_MIN_TAPS : u8 = 3;
pub const K_TAP_LIMIT : u8 = 127;
pub const K_FS_HZ : [5]u32 = [48000, 1000000, 10000000, 50000000, 100000000];
pub const K_HZ_PER_MHZ : u32 = 1000000;
pub const K_FCLK_MIN_MHZ : u16 = 50;
pub const K_FCLK_MAX_MHZ : u16 = 500;
pub const K_MAX_CHANNELS : u8 = 64;
pub const K_MIN_PS : u16 = 100;
pub const K_MAX_LEVEL_PS : u16 = 1000;
pub const K_MAX_FIXED_PS : u16 = 3000;
pub const K_DSP48_ON_200T : u16 = 740;
pub const K_GRID_COLS : u8 = 37;
pub const K_PRESET_TAPS : [4]u8 = [63, 63, 127, 31];
pub const K_PRESET_SYM : [4]u8 = [1, 1, 0, 1];
pub const K_PRESET_FS : [4]u8 = [3, 3, 4, 0];
pub const K_PRESET_FCLK_MHZ : [4]u16 = [250, 250, 200, 100];
pub const K_PRESET_CHANNELS : [4]u8 = [16, 16, 8, 64];
pub const K_PRESET_FORM : [4]u8 = [0, 1, 1, 0];
pub const K_PRESET_LEVEL_PS : [4]u16 = [500, 500, 500, 500];
pub const K_PRESET_FIXED_PS : [4]u16 = [1500, 1500, 1500, 1500];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["16 channels, adder tree", "16 channels, systolic", "8 channels, 127 taps: too many", "64 audio channels"];
pub const SAY_TAPS : str = "Taps";
pub const SAY_SYM : str = "Taps symmetric";
pub const SAY_SYMS : [2]str = ["no", "yes"];
pub const SAY_FS : str = "Sample rate";
pub const SAY_FS_NAMES : [5]str = ["48 kHz", "1 MHz", "10 MHz", "50 MHz", "100 MHz"];
pub const SAY_FCLK : str = "Clock, MHz";
pub const SAY_CHANNELS : str = "Channels";
pub const SAY_FORM : str = "Adder structure";
pub const SAY_FORMS : [2]str = ["direct adder tree", "systolic chain"];
pub const SAY_LEVEL_PS : str = "Delay per adder level, ps";
pub const SAY_FIXED_PS : str = "Fixed part of the path, ps";
pub const SAY_GRID_LABEL : str = "The 740 DSP48E1 slices of the XC7A200T, filled channel by channel";
pub const SAY_TIMING_LABEL : str = "One register-to-register path against the clock period";
pub const SAY_USED : str = "{0} of {1} slices used";
pub const SAY_OVER : str = "{0} slices wanted, {1} there: it does not fit";
pub const SAY_PERIOD : str = "clock period {0} ps";
pub const SAY_PATH : str = "path {0} ps: the fixed part and {1} adder level(s)";
pub const SAY_NOTE : str = "The two delays are yours to set; the defaults are illustrative, not a timing report. Your build's slack-waterfall says what the tools measured.";
pub const SAY_PER_CH : str = "slices per channel";
pub const SAY_FIT : str = "such filters on a 200T";
pub const SAY_LEVELS : str = "adder levels";
pub const SAY_SLACK : str = "slack";
pub const SAY_PS : str = "{0} ps";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/signals.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_two_first_presets_differ_only_in_form {
    assert K_PRESET_TAPS[0] == K_PRESET_TAPS[1];
    assert K_PRESET_CHANNELS[0] == K_PRESET_CHANNELS[1];
    assert K_PRESET_FORM[0] == 0;
    assert K_PRESET_FORM[1] == 1;
}

test the_grid_holds_the_whole_device {
    assert K_GRID_COLS * 20 == K_DSP48_ON_200T;
    assert K_DSP48_ON_200T == 740;
    assert K_TAP_LIMIT == 127;
}
