pub var L_T : [262144]f64 = [0.0; 262144];
pub var L_VO : [262144]u32 = [0; 262144];
pub var L_VL : [262144]u32 = [0; 262144];
pub var L_VP : [2097152]u8 = [0; 2097152];
pub var L_N : u32 = 0;
pub var L_VP_N : u32 = 0;

// the scratch tables of one parse
pub var P_NP : [1048576]u8 = [0; 1048576];
pub var P_NP_N : u32 = 0;
pub var P_IDP : [1048576]u8 = [0; 1048576];
pub var P_IDP_N : u32 = 0;
pub var P_VN : u32 = 0;
pub var PV_NAME_O : [65536]u32 = [0; 65536];
pub var PV_NAME_L : [65536]u32 = [0; 65536];
pub var PV_ID_O : [65536]u32 = [0; 65536];
pub var PV_ID_L : [65536]u32 = [0; 65536];
pub var PV_WIDTH : [65536]f64 = [0.0; 65536];
pub var PV_REAL : [65536]u8 = [0; 65536];
pub var PV_CANON : [65536]u32 = [0; 65536];
pub var PV_LAST : [65536]i32 = [0; 65536];
pub var PV_CNT : [65536]u32 = [0; 65536];
pub var PV_START : [65536]u32 = [0; 65536];
pub var HASH_T : [262144]i32 = [0; 262144];
pub var PC_SIG : [262144]u32 = [0; 262144];
pub var PC_T : [262144]f64 = [0.0; 262144];
pub var PC_VO : [262144]u32 = [0; 262144];
pub var PC_VL : [262144]u32 = [0; 262144];
pub var PC_N : u32 = 0;
pub var P_VP : [2097152]u8 = [0; 2097152];
pub var P_VP_N : u32 = 0;
pub var S_T : [262144]f64 = [0.0; 262144];
pub var S_VO : [262144]u32 = [0; 262144];
pub var S_VL : [262144]u32 = [0; 262144];
pub var P_END : f64 = 0.0;
pub var P_UEXP : i32 = 0;
pub var P_UMUL : f64 = 1.0;
pub var P_NSIG : u32 = 0;
pub var P_ERR : u32 = 0;
pub var ERR_TOKEN : [64]u8 = [0; 64];
pub var ERR_TOKEN_LEN : u32 = 0;
pub var ERR_TIME : f64 = 0.0;
pub var MISSING : bool = false;
pub var X_N : u32 = 0;
pub var X_FO : [4096]u32 = [0; 4096];
pub var X_FL : [4096]u32 = [0; 4096];
pub var X_TO : [4096]u32 = [0; 4096];
pub var X_TL : [4096]u32 = [0; 4096];
pub var X_ST : [4096]u8 = [0; 4096];
pub var X_W : [4096]f64 = [0.0; 4096];
pub var X_POOL : [262144]u8 = [0; 262144];
pub var X_POOL_N : u32 = 0;
pub var LB_N : u32 = 0;
pub var LB_OP : [64]u8 = [0; 64];
pub var LB_A : [64]f64 = [0.0; 64];
pub var LB_B : [64]f64 = [0.0; 64];
pub var LB_R : [64]f64 = [0.0; 64];
pub var RQ_N : u32 = 0;
pub var RQ_OP : [64]u8 = [0; 64];
pub var RQ_A : [64]f64 = [0.0; 64];
pub var RQ_B : [64]f64 = [0.0; 64];
pub var RQ_SENT : u32 = 0;

// pointers
pub var PT_N : u32 = 0;
pub var PT_ID : [16]i64 = [0; 16];
pub var PT_X : [16]f64 = [0.0; 16];
pub var PT_Y : [16]f64 = [0.0; 16];
pub var DR_ON : bool = false;
pub var DR_SX : f64 = 0.0;
pub var DR_SY : f64 = 0.0;
pub var DR_LX : f64 = 0.0;
pub var DR_LY : f64 = 0.0;
pub var DR_MOVED : bool = false;
pub var PI_ON : bool = false;
pub var PI_DIST : f64 = 1.0;
pub var PI_SCALE : f64 = 1.0;
pub var PI_T : f64 = 0.0;

// --- small pieces ------------------------------------------------------------------------------------------

fn copy_into(dst: []u8, at: u32, s: []const u8) -> u32 {
    var n : u32 = at;
    var i : usize = 0;
    while (i < s.len and (n as usize) < dst.len) {
        dst[n as usize] = s[i];
        n = n + 1;
        i = i + 1;
    }
    return n;
}

fn word_is(key: []const u8, want: []const u8) -> bool {
    if (key.len != want.len) { return false; }
    var i : usize = 0;
    while (i < key.len) {
        if (key[i] != want[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn present(d: []const u8, sp: i64) -> bool {
    const k : u8 = kind(d, sp);
    return k != J_NONE and k != J_NULL;
}

/// Number(v) as a number operand: a missing value is NaN.
fn numv(d: []const u8, sp: i64) -> f64 {
    if (kind(d, sp) == J_NONE) { return js_nan(0.0); }
    return jv_num(d, sp);
}

fn str_of(tmp: []u8, d: []const u8, sp: i64) -> u32 {
    const l : u32 = jv_str(tmp, 0, d, sp);
    if (l == OVER) { return 0; }
    return l;
}

fn hypot2(a0: f64, b0: f64) -> f64 {
    var a : f64 = a0;
    var b : f64 = b0;
    if (a != a or b != b) {
        if (a - a != 0.0 and a == a) { return js_inf(0.0); }
        if (b - b != 0.0 and b == b) { return js_inf(0.0); }
        return js_nan(0.0);
    }
    if (a < 0.0) { a = 0.0 - a; }
    if (b < 0.0) { b = 0.0 - b; }
    var mx : f64 = 0.0;
    if (a > mx) { mx = a; }
    if (b > mx) { mx = b; }
    if (mx == js_inf(0.0)) { return mx; }
    if (mx == 0.0) { return 0.0; }
    var sum : f64 = 0.0;
    var comp : f64 = 0.0;
    var k : u32 = 0;
    while (k < 2) {
        var v : f64 = a;
        if (k == 1) { v = b; }
        const n : f64 = v / mx;
        const summand : f64 = n * n - comp;
        const prelim : f64 = sum + summand;
        comp = (prelim - sum) - summand;
        sum = prelim;
        k = k + 1;
    }
    return @sqrt(sum) * mx;
}

/// 10 ** k for a whole k from -15 to 15 (exact as Math.pow: the doubles are whole numbers up to 1e15).
fn pow10i(k: i32) -> f64 {
    var r : f64 = 1.0;
    var i : i32 = 0;
    while (i < k) {
        r = r * 10.0;
        i = i + 1;
    }
    return r;
}

fn pow1000i(k: u32) -> f64 {
    var r : f64 = 1.0;
    var i : u32 = 0;
    while (i < k) {
        r = r * 1000.0;
        i = i + 1;
    }
    return r;
}

// --- parseVcd: tool.js's parser, token by token --------------------------------------------------------------------
// P_ERR: 0 read, 1 SAY_ERR_NO_DEFS, 2 SAY_ERR_NO_TIMESCALE, 3 SAY_ERR_BAD_TOKEN, 4 SAY_ERR_NO_SIGNALS, 5 too big for the tables.

pub var TK_P : u32 = 0;
pub var TK_S : u32 = 0;
pub var TK_E : u32 = 0;
pub var SC_O : [256]u32 = [0; 256];
pub var SC_L : [256]u32 = [0; 256];
pub var SC_N : u32 = 0;
pub var TS_BUF : [256]u8 = [0; 256];

/// The next whitespace-separated token of d from TK_P: TK_S..TK_E. False at the end.
fn tk_next(d: []const u8) -> bool {
    const len : u32 = d.len as u32;
    var p : u32 = TK_P;
    while (p < len) {
        const w : u32 = jv_ws_at(d, p, len);
        if (w == 0) { break; }
        p = p + w;
    }
    if (p >= len) {
        TK_P = p;
        TK_S = p;
        TK_E = p;
        return false;
    }
    TK_S = p;
    while (p < len) {
        const w : u32 = jv_ws_at(d, p, len);
        if (w != 0) { break; }
        p = p + 1;
    }
    TK_E = p;
    TK_P = p;
    return true;
}

fn tk_is(d: []const u8, lit: []const u8) -> bool {
    if ((TK_E - TK_S) != (lit.len as u32)) { return false; }
    var k : usize = 0;
    while (k < lit.len) {
        if (d[(TK_S as usize) + k] != lit[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// skipToEnd(): tokens up to and including the next $end.
fn skip_to_end(d: []const u8) -> u32 {
    while (tk_next(d)) {
        if (tk_is(d, "$end")) { return 0; }
    }
    return 0;
}

/// Number(token) of the bytes s[a..b).
fn num_of(d: []const u8, a: u32, b: u32) -> f64 {
    if (b <= a) { return 0.0; }
    return jv_number_of_text(d[(a as usize)..(b as usize)], b - a);
}

fn finite(x: f64) -> bool {
    return x == x and (x - x) == 0.0;
}

fn id_hash(d: []const u8, a: u32, l: u32) -> u32 {
    var h : u64 = 2166136261;
    var i : u32 = 0;
    while (i < l) {
        const x : u64 = (d[(a + i) as usize]) as u64;
        h = (((h + x) * 16777619) % 4294967296);
        i = i + 1;
    }
    return h as u32;
}

fn id_equal(d: []const u8, a: u32, l: u32, v: u32) -> bool {
    if (PV_ID_L[v as usize] != l) { return false; }
    var i : u32 = 0;
    while (i < l) {
        if (P_IDP[(PV_ID_O[v as usize] + i) as usize] != d[(a + i) as usize]) { return false; }
        i = i + 1;
    }
    return true;
}

/// byId.get(id): the variable index, or -1.
fn hash_find(d: []const u8, a: u32, l: u32) -> i32 {
    var h : u32 = id_hash(d, a, l) % 262144;
    var guard : u32 = 0;
    while (guard < 262144) {
        const e : i32 = HASH_T[h as usize];
        if (e == 0) { return -1; }
        if (id_equal(d, a, l, (e - 1) as u32)) { return e - 1; }
        h = (h + 1) % 262144;
        guard = guard + 1;
    }
    return -1;
}

fn hash_put(d: []const u8, a: u32, l: u32, v: u32) -> u32 {
    var h : u32 = id_hash(d, a, l) % 262144;
    var guard : u32 = 0;
    while (guard < 262144) {
        if (HASH_T[h as usize] == 0) {
            HASH_T[h as usize] = (v + 1) as i32;
            return 0;
        }
        h = (h + 1) % 262144;
        guard = guard + 1;
    }
    return 0;
}

/// Is v the name of a variable already (vars.some(v => v.name === name))?
fn name_known(a: u32, l: u32) -> bool {
    var v : u32 = 0;
    while (v < P_VN) {
        if (PV_NAME_L[v as usize] == l) {
            var k : u32 = 0;
            while (k < l and P_NP[(PV_NAME_O[v as usize] + k) as usize] == P_NP[(a + k) as usize]) { k = k + 1; }
            if (k == l) { return true; }
        }
        v = v + 1;
    }
    return false;
}

/// The $timescale tokens joined: /^(\d+)\s*(s|ms|us|ns|ps|fs)$/. Sets P_UMUL and P_UEXP; false when it does not match.
fn timescale_ok(n: u32) -> bool {
    var i : u32 = 0;
    while (i < n and TS_BUF[i as usize] >= 48 and TS_BUF[i as usize] <= 57) { i = i + 1; }
    if (i == 0) { return false; }
    const rest : u32 = n - i;
    var exp : i32 = 0 - 100;
    if (rest == 1 and TS_BUF[i as usize] == 115) { exp = 0; }
    if (rest == 2) {
        const a : u8 = TS_BUF[i as usize];
        const b : u8 = TS_BUF[(i + 1) as usize];
        if (a == 109 and b == 115) { exp = 0 - 3; }
        if (a == 117 and b == 115) { exp = 0 - 6; }
        if (a == 110 and b == 115) { exp = 0 - 9; }
        if (a == 112 and b == 115) { exp = 0 - 12; }
        if (a == 102 and b == 115) { exp = 0 - 15; }
    }
    if (exp == 0 - 100) { return false; }
    P_UMUL = jv_number_of_text(TS_BUF[0..(i as usize)], i);
    P_UEXP = exp;
    return true;
}

/// Append a lowercase (ASCII) copy of d[a..b) to the scratch value pool; the new length is returned, OVER on overflow.
fn pool_lower(d: []const u8, a: u32, b: u32, prefix: u8) -> u32 {
    var n : u32 = P_VP_N;
    const extra : u32 = if_prefix(prefix);
    if ((n + (b - a) + extra) as usize > P_VP.len) { return OVER; }
    if (prefix != 0) {
        P_VP[n as usize] = prefix;
        n = n + 1;
    }
    var i : u32 = a;
    while (i < b) {
        var c : u8 = d[i as usize];
        if (prefix == 0 and c >= 65 and c <= 90) { c = c + 32; }
        P_VP[n as usize] = c;
        n = n + 1;
        i = i + 1;
    }
    return n;
}

fn if_prefix(p: u8) -> u32 {
    if (p != 0) { return 1; }
    return 0;
}

/// set(id, v) with the value already in the pool at [vo, vo + vl): the dedupe rules of tool.js.
fn set_value(d: []const u8, ia: u32, il: u32, vo: u32, vl: u32, time: f64) -> u32 {
    const idx : i32 = hash_find(d, ia, il);
    if (idx < 0) {
        P_VP_N = vo;
        return 0;
    }
    const v : u32 = idx as u32;
    const last : i32 = PV_LAST[v as usize];
    if (last >= 0) {
        const lc : u32 = last as u32;
        if (PC_T[lc as usize] == time) {
            PC_VO[lc as usize] = vo;
            PC_VL[lc as usize] = vl;
            return 0;
        }
        if (PC_VL[lc as usize] == vl) {
            var k : u32 = 0;
            while (k < vl and P_VP[(PC_VO[lc as usize] + k) as usize] == P_VP[(vo + k) as usize]) { k = k + 1; }
            if (k == vl) {
                P_VP_N = vo;
                return 0;
            }
        }
    }
    if (PC_N >= W_MAX_CH) {
        P_ERR = 5;
        return 0;
    }
    PC_SIG[PC_N as usize] = v;
    PC_T[PC_N as usize] = time;
    PC_VO[PC_N as usize] = vo;
    PC_VL[PC_N as usize] = vl;
    PV_LAST[v as usize] = PC_N as i32;
    PV_CNT[v as usize] = PV_CNT[v as usize] + 1;
    PC_N = PC_N + 1;
    return 0;
}

/// Record a bad token for SAY_ERR_BAD_TOKEN: its first 24 UTF-16 units, and the time.
fn bad_token(d: []const u8, a: u32, b: u32, time: f64) -> u32 {
    P_ERR = 3;
    var units : u32 = 0;
    var i : u32 = a;
    while (i < b) {
        const c : u8 = d[i as usize];
        var w : u32 = 1;
        var u : u32 = 1;
        if (c >= 192) { w = 2; }
        if (c >= 224) { w = 3; }
        if (c >= 240) {
            w = 4;
            u = 2;
        }
        if (units + u > 24) { break; }
        units = units + u;
        i = i + w;
    }
    if (i > b) { i = b; }
    ERR_TOKEN_LEN = copy_into(ERR_TOKEN[0..], 0, d[(a as usize)..(i as usize)]);
    ERR_TIME = time;
    return 0;
}

/// parseVcd(text) into the scratch tables. Returns P_ERR.
fn parse_vcd(d: []const u8) -> u32 {
    TK_P = 0;
    SC_N = 0;
    P_ERR = 0;
    P_NP_N = 0;
    P_IDP_N = 0;
    P_VN = 0;
    PC_N = 0;
    P_VP_N = 0;
    P_END = 0.0;
    P_UEXP = 0;
    P_UMUL = 1.0;
    var h : u32 = 0;
    while (h < 262144) {
        HASH_T[h as usize] = 0;
        h = h + 1;
    }
    var have_unit : bool = false;
    // header
    var done : bool = false;
    while (!done) {
        if (!tk_next(d)) {
            P_ERR = 1;
            return 1;
        }
        if (tk_is(d, "$timescale")) {
            var n : u32 = 0;
            while (tk_next(d)) {
                if (tk_is(d, "$end")) { break; }
                const l : u32 = TK_E - TK_S;
                if (n + l < 256) {
                    var k : u32 = 0;
                    while (k < l) {
                        TS_BUF[(n + k) as usize] = d[(TK_S + k) as usize];
                        k = k + 1;
                    }
                }
                n = n + l;
            }
            if (n >= 256 or !timescale_ok(n)) {
                P_ERR = 2;
                return 2;
            }
            have_unit = true;
        } else {
            if (tk_is(d, "$scope")) {
                tk_next(d);
                var no : u32 = 0;
                var nl : u32 = 0;
                if (tk_next(d)) {
                    no = TK_S;
                    nl = TK_E - TK_S;
                }
                if (SC_N < 256) {
                    SC_O[SC_N as usize] = no;
                    SC_L[SC_N as usize] = nl;
                    SC_N = SC_N + 1;
                }
                skip_to_end(d);
            } else {
                if (tk_is(d, "$upscope")) {
                    if (SC_N > 0) { SC_N = SC_N - 1; }
                    skip_to_end(d);
                } else {
                    if (tk_is(d, "$var")) {
                        var vt : u32 = 0;
                        var vtl : u32 = 0;
                        if (tk_next(d)) {
                            vt = TK_S;
                            vtl = TK_E - TK_S;
                        }
                        var width : f64 = js_nan(0.0);
                        if (tk_next(d)) { width = num_of(d, TK_S, TK_E); } else { width = js_nan(0.0); }
                        var ido : u32 = 0;
                        var idl : u32 = 0;
                        if (tk_next(d)) {
                            ido = TK_S;
                            idl = TK_E - TK_S;
                        }
                        var rfo : u32 = 0;
                        var rfl : u32 = 0;
                        if (tk_next(d)) {
                            rfo = TK_S;
                            rfl = TK_E - TK_S;
                        }
                        skip_to_end(d);
                        if (width > 0.0 and idl > 0 and rfl > 0) {
                            // name = [...scope, ref].join('.')
                            const name_o : u32 = P_NP_N;
                            var nn : u32 = P_NP_N;
                            var s : u32 = 0;
                            var big : bool = false;
                            while (s < SC_N) {
                                if ((nn + SC_L[s as usize] + 1) as usize > P_NP.len) { big = true; }
                                if (!big) {
                                    nn = copy_into(P_NP[0..], nn, d[(SC_O[s as usize] as usize)..((SC_O[s as usize] + SC_L[s as usize]) as usize)]);
                                    P_NP[nn as usize] = 46;
                                    nn = nn + 1;
                                }
                                s = s + 1;
                            }
                            if ((nn + rfl) as usize > P_NP.len or P_VN >= W_MAX_VARS or (P_IDP_N + idl) as usize > P_IDP.len) { big = true; }
                            if (big) {
                                P_ERR = 5;
                                return 5;
                            }
                            nn = copy_into(P_NP[0..], nn, d[(rfo as usize)..((rfo + rfl) as usize)]);
                            const name_l : u32 = nn - name_o;
                            const found : i32 = hash_find(d, ido, idl);
                            if (found < 0) {
                                const v : u32 = P_VN;
                                P_NP_N = nn;
                                PV_NAME_O[v as usize] = name_o;
                                PV_NAME_L[v as usize] = name_l;
                                PV_ID_O[v as usize] = P_IDP_N;
                                PV_ID_L[v as usize] = idl;
                                P_IDP_N = copy_into(P_IDP[0..], P_IDP_N, d[(ido as usize)..((ido + idl) as usize)]);
                                PV_WIDTH[v as usize] = width;
                                PV_REAL[v as usize] = 0;
                                if (vtl == 4 and d[vt as usize] == 114 and d[(vt + 1) as usize] == 101 and d[(vt + 2) as usize] == 97 and d[(vt + 3) as usize] == 108) { PV_REAL[v as usize] = 1; }
                                PV_CANON[v as usize] = v;
                                PV_LAST[v as usize] = 0 - 1;
                                PV_CNT[v as usize] = 0;
                                hash_put(d, ido, idl, v);
                                P_VN = v + 1;
                            } else {
                                if (!name_known(name_o, name_l)) {
                                    const v : u32 = P_VN;
                                    const c : u32 = found as u32;
                                    P_NP_N = nn;
                                    PV_NAME_O[v as usize] = name_o;
                                    PV_NAME_L[v as usize] = name_l;
                                    PV_ID_O[v as usize] = PV_ID_O[c as usize];
                                    PV_ID_L[v as usize] = PV_ID_L[c as usize];
                                    PV_WIDTH[v as usize] = PV_WIDTH[c as usize];
                                    PV_REAL[v as usize] = PV_REAL[c as usize];
                                    PV_CANON[v as usize] = c;
                                    PV_LAST[v as usize] = 0 - 1;
                                    PV_CNT[v as usize] = 0;
                                    P_VN = v + 1;
                                }
                            }
                        }
                    } else {
                        if (tk_is(d, "$enddefinitions")) {
                            skip_to_end(d);
                            done = true;
                        } else {
                            if (d[TK_S as usize] == 36) { skip_to_end(d); }
                        }
                    }
                }
            }
        }
    }
    if (!have_unit) {
        P_UEXP = 0 - 9;
        P_UMUL = 1.0;
    }
    // value changes
    var time : f64 = 0.0;
    var end : f64 = 0.0;
    while (tk_next(d)) {
        const ta : u32 = TK_S;
        const tb : u32 = TK_E;
        const c : u8 = d[ta as usize];
        if (c == 35) {
            const nv : f64 = num_of(d, ta + 1, tb);
            if (!finite(nv)) {
                bad_token(d, ta, tb, time);
                return 3;
            }
            time = nv;
            if (nv > end) { end = nv; }
        } else {
            if (c == 48 or c == 49 or c == 120 or c == 88 or c == 122 or c == 90) {
                const vo : u32 = P_VP_N;
                var lc : u8 = c;
                if (c >= 65 and c <= 90) { lc = c + 32; }
                if (vo + 1 > P_VP.len as u32) {
                    P_ERR = 5;
                    return 5;
                }
                P_VP[vo as usize] = lc;
                P_VP_N = vo + 1;
                set_value(d, ta + 1, tb - ta - 1, vo, 1, time);
                if (P_ERR == 5) { return 5; }
            } else {
                if (c == 98 or c == 66) {
                    var ia : u32 = 0;
                    var il : u32 = 0;
                    const vo : u32 = P_VP_N;
                    const e : u32 = pool_lower(d, ta + 1, tb, 0);
                    if (e == OVER) {
                        P_ERR = 5;
                        return 5;
                    }
                    P_VP_N = e;
                    if (tk_next(d)) {
                        ia = TK_S;
                        il = TK_E - TK_S;
                    }
                    set_value(d, ia, il, vo, e - vo, time);
                    if (P_ERR == 5) { return 5; }
                } else {
                    if (c == 114 or c == 82) {
                        var ia : u32 = 0;
                        var il : u32 = 0;
                        const vo : u32 = P_VP_N;
                        const e : u32 = pool_lower(d, ta + 1, tb, 114);
                        if (e == OVER) {
                            P_ERR = 5;
                            return 5;
                        }
                        P_VP_N = e;
                        if (tk_next(d)) {
                            ia = TK_S;
                            il = TK_E - TK_S;
                        }
                        set_value(d, ia, il, vo, e - vo, time);
                        if (P_ERR == 5) { return 5; }
                    } else {
                        if (c == 36) {
                            if (tk_is(d, "$comment")) { skip_to_end(d); }
                        } else {
                            bad_token(d, ta, tb, time);
                            return 3;
                        }
                    }
                }
            }
        }
    }
    // the signals that ever change
    var any : bool = false;
    var v : u32 = 0;
    var sigs : u32 = 0;
    while (v < P_VN) {
        if (PV_CNT[PV_CANON[v as usize] as usize] > 0) {
            any = true;
            sigs = sigs + 1;
        }
        v = v + 1;
    }
    if (!any) {
        P_ERR = 4;
        return 4;
    }
    P_NSIG = sigs;
    P_END = js_max(end, 1.0);
    // scatter the changes by variable (a stable counting sort)
    var pos : u32 = 0;
    v = 0;
    while (v < P_VN) {
        if (PV_CANON[v as usize] == v) {
            PV_START[v as usize] = pos;
            pos = pos + PV_CNT[v as usize];
        }
        v = v + 1;
    }
    var i : u32 = 0;
    v = 0;
    while (v < P_VN) {
        PV_LAST[v as usize] = 0;
        v = v + 1;
    }
    while (i < PC_N) {
        const sg : u32 = PC_SIG[i as usize];
        const at : u32 = PV_START[sg as usize] + (PV_LAST[sg as usize] as u32);
        S_T[at as usize] = PC_T[i as usize];
        S_VO[at as usize] = PC_VO[i as usize];
        S_VL[at as usize] = PC_VL[i as usize];
        PV_LAST[sg as usize] = PV_LAST[sg as usize] + 1;
        i = i + 1;
    }
    return 0;
}

// --- values: bitsOf, hexOf, decimalOf, labelOf, valueText, valueAt -----------------------------------------------

pub var SC_BITS : [8200]u8 = [0; 8200];
pub var SC_HEXB : [2300]u8 = [0; 2300];
pub var LIMB : [260]u32 = [0; 260];
pub var DIG : [2800]u8 = [0; 2800];

/// The width as a bit count: a whole number from 1 to W_MAX_BITS.
fn bits_wide(w: f64) -> u32 {
    if (!(w >= 1.0)) { return 1; }
    if (w > (W_MAX_BITS as f64)) { return W_MAX_BITS; }
    return js_floor(w) as u32;
}

/// bitsOf(v, width) into SC_BITS: v is L_VP[vo .. vo + vl). Returns the length (always width).
fn bits_of(vo: u32, vl: u32, width: u32) -> u32 {
    var n : u32 = 0;
    if (vl >= width) {
        var i : u32 = vl - width;
        while (i < vl) {
            SC_BITS[n as usize] = L_VP[(vo + i) as usize];
            n = n + 1;
            i = i + 1;
        }
        return n;
    }
    var pad : u8 = 48;
    if (vl > 0) {
        const f : u8 = L_VP[vo as usize];
        if (f == 120 or f == 122) { pad = f; }
    }
    var i : u32 = 0;
    while (i < width - vl) {
        SC_BITS[n as usize] = pad;
        n = n + 1;
        i = i + 1;
    }
    i = 0;
    while (i < vl) {
        SC_BITS[n as usize] = L_VP[(vo + i) as usize];
        n = n + 1;
        i = i + 1;
    }
    return n;
}

fn hexch(v: u32) -> u8 {
    if (v < 10) { return (v as u8) + 48; }
    return (v as u8) + 87;
}

/// hexOf(v, width) into SC_HEXB; the length. A real value (first byte r) is its text after the r.
fn hex_of(vo: u32, vl: u32, width: u32, is_real: bool) -> u32 {
    var n : u32 = 0;
    if (vl > 0 and L_VP[vo as usize] == 114) {
        var i : u32 = 1;
        while (i < vl and (n as usize) < SC_HEXB.len) {
            SC_HEXB[n as usize] = L_VP[(vo + i) as usize];
            n = n + 1;
            i = i + 1;
        }
        return n;
    }
    const bl : u32 = bits_of(vo, vl, width);
    var start : u32 = 0;
    var first : u32 = bl % 4;
    if (first == 0) { first = 4; }
    var g : u32 = 0;
    while (start < bl) {
        var len : u32 = 4;
        if (g == 0) { len = first; }
        var has_x : bool = false;
        var has_z : bool = false;
        var val : u32 = 0;
        var lead : bool = true;
        var any_digit : bool = false;
        var k : u32 = 0;
        while (k < len) {
            const c : u8 = SC_BITS[(start + k) as usize];
            if (c == 120) { has_x = true; }
            if (c == 122) { has_z = true; }
            if (lead and (c == 48 or c == 49)) {
                val = val * 2 + ((c - 48) as u32);
                any_digit = true;
            } else {
                lead = false;
            }
            k = k + 1;
        }
        if ((n as usize) + 4 < SC_HEXB.len) {
            if (has_x) {
                SC_HEXB[n as usize] = 120;
                n = n + 1;
            } else {
                if (has_z) {
                    SC_HEXB[n as usize] = 122;
                    n = n + 1;
                } else {
                    if (any_digit) {
                        SC_HEXB[n as usize] = hexch(val);
                        n = n + 1;
                    } else {
                        SC_HEXB[n as usize] = 78;
                        SC_HEXB[(n + 1) as usize] = 97;
                        SC_HEXB[(n + 2) as usize] = 78;
                        n = n + 3;
                    }
                }
            }
        }
        start = start + len;
        g = g + 1;
    }
    return n;
}

fn has_xz(vo: u32, vl: u32) -> bool {
    var i : u32 = 0;
    while (i < vl) {
        const c : u8 = L_VP[(vo + i) as usize];
        if (c == 120 or c == 122) { return true; }
        i = i + 1;
    }
    return false;
}

/// The decimal text of the bits in SC_BITS[0..bl) read as an unsigned number, into DIG; the length.
fn bits_to_decimal(bl: u32) -> u32 {
    // limbs of 32 bits, least significant first
    var nl : u32 = (bl + 31) / 32;
    var i : u32 = 0;
    while (i < nl) {
        LIMB[i as usize] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < bl) {
        // bit i from the left is bit (bl - 1 - i) from the right
        const bit : u32 = if_one(SC_BITS[i as usize]);
        const pos : u32 = bl - 1 - i;
        LIMB[(pos / 32) as usize] = LIMB[(pos / 32) as usize] | (bit << (pos % 32));
        i = i + 1;
    }
    // repeated division by 10^9
    var top : u32 = nl;
    while (top > 0 and LIMB[(top - 1) as usize] == 0) { top = top - 1; }
    if (top == 0) {
        DIG[0] = 48;
        return 1;
    }
    var rev_n : u32 = 0;
    while (top > 0) {
        var rem : u64 = 0;
        var j : u32 = top;
        while (j > 0) {
            j = j - 1;
            const cur : u64 = rem * 4294967296 + (LIMB[j as usize] as u64);
            LIMB[j as usize] = (cur / 1000000000) as u32;
            rem = cur % 1000000000;
        }
        var q : u32 = 0;
        while (q < 9) {
            if (rev_n < 2800) {
                DIG[rev_n as usize] = ((rem % 10) as u8) + 48;
                rev_n = rev_n + 1;
            }
            rem = rem / 10;
            q = q + 1;
        }
        while (top > 0 and LIMB[(top - 1) as usize] == 0) { top = top - 1; }
    }
    // drop the leading zeros of the last chunk (they are at the end of the reversed digits) and reverse
    while (rev_n > 1 and DIG[(rev_n - 1) as usize] == 48) { rev_n = rev_n - 1; }
    var a : u32 = 0;
    var b : u32 = rev_n;
    while (a + 1 < b) {
        b = b - 1;
        const t : u8 = DIG[a as usize];
        DIG[a as usize] = DIG[b as usize];
        DIG[b as usize] = t;
        a = a + 1;
    }
    return rev_n;
}

fn if_one(c: u8) -> u32 {
    if (c == 49) { return 1; }
    return 0;
}

/// u as decimal text (unsigned) of v, into o at n0.
fn put_unsigned_bits(o: []u8, n0: u32, bl: u32) -> u32 {
    const dl : u32 = bits_to_decimal(bl);
    return jn_raw(o, n0, DIG[0..(dl as usize)]);
}

/// 2^width - u as bits (two's complement magnitude), in SC_BITS, for a number whose top bit is set.
fn negate_bits(bl: u32) -> u32 {
    // invert, add one
    var i : u32 = 0;
    while (i < bl) {
        if (SC_BITS[i as usize] == 49) { SC_BITS[i as usize] = 48; } else { SC_BITS[i as usize] = 49; }
        i = i + 1;
    }
    var k : u32 = bl;
    while (k > 0) {
        k = k - 1;
        if (SC_BITS[k as usize] == 49) {
            SC_BITS[k as usize] = 48;
        } else {
            SC_BITS[k as usize] = 49;
            break;
        }
    }
    return bl;
}

/// The signed reading of an unsigned bit string in SC_BITS[0..bl): "-m" or "u" into o.
fn put_signed_bits(o: []u8, n0: u32, bl: u32) -> u32 {
    if (SC_BITS[0] == 49) {
        negate_bits(bl);
        const n : u32 = put(o, n0, 45);
        return put_unsigned_bits(o, n, bl);
    }
    return put_unsigned_bits(o, n0, bl);
}

/// labelOf(sig, v) for row r and value k, raw bytes into o.
fn put_label(o: []u8, n0: u32, r: u32, k: u32) -> u32 {
    const vo : u32 = L_VO[k as usize];
    const vl : u32 = L_VL[k as usize];
    if (R_REAL[r as usize] != 0) { return jn_raw(o, n0, L_VP[((vo + 1) as usize)..((vo + vl) as usize)]); }
    const width : u32 = bits_wide(R_WIDTH[r as usize]);
    if (R_SDEC[r as usize] != 0 and !has_xz(vo, vl)) {
        const bl : u32 = bits_of(vo, vl, width);
        // u >> (width - 1) is non-zero when the top bit is set (u < 2^width)
        return put_signed_bits(o, n0, bl);
    }
    const hl : u32 = hex_of(vo, vl, width, false);
    var s : u32 = 0;
    while (s + 1 < hl and SC_HEXB[s as usize] == 48) { s = s + 1; }
    return jn_raw(o, n0, SC_HEXB[(s as usize)..(hl as usize)]);
}

/// valueText(sig, v) for row r and value k (k negative: no value), raw bytes into o.
fn put_value_text(o: []u8, n0: u32, r: u32, k: i32) -> u32 {
    if (k < 0) { return n0; }
    const kk : u32 = k as u32;
    const vo : u32 = L_VO[kk as usize];
    const vl : u32 = L_VL[kk as usize];
    if (R_REAL[r as usize] != 0) { return jn_raw(o, n0, L_VP[((vo + 1) as usize)..((vo + vl) as usize)]); }
    if (R_WIDTH[r as usize] == 1.0) { return jn_raw(o, n0, L_VP[(vo as usize)..((vo + vl) as usize)]); }
    const width : u32 = bits_wide(R_WIDTH[r as usize]);
    const hl : u32 = hex_of(vo, vl, width, false);
    var n : u32 = copy_into(o, n0, "0x");
    n = jn_raw(o, n, SC_HEXB[0..(hl as usize)]);
    if (vl > 0 and L_VP[vo as usize] == 114) { return n; }
    if (has_xz(vo, vl)) { return n; }
    // decimalOf: the unsigned value, and the signed one when the top bit is set
    const bl : u32 = bits_of(vo, vl, width);
    n = copy_into(o, n, " = ");
    const top_set : bool = width > 1 and SC_BITS[0] == 49;
    n = put_unsigned_bits(o, n, bl);
    if (top_set) {
        n = copy_into(o, n, " / ");
        const bl2 : u32 = bits_of(vo, vl, width);
        n = put_signed_bits(o, n, bl2);
    }
    return n;
}

/// valueAt(sig, t): the index of the value in force at t for row r, or -1.
fn value_at(r: u32, t: f64) -> i32 {
    const n : u32 = R_N[r as usize];
    const f : u32 = R_FIRST[r as usize];
    if (n == 0) { return 0 - 1; }
    if (t < L_T[f as usize]) { return 0 - 1; }
    var lo : u32 = 0;
    var hi : u32 = n - 1;
    while (lo < hi) {
        const mid : u32 = (lo + hi + 1) / 2;
        if (L_T[(f + mid) as usize] <= t) { lo = mid; } else { hi = mid - 1; }
    }
    return (f + lo) as i32;
}

/// firstIndexAt(sig, t) as an index into the row's changes (0-based within the row).
fn first_index_at(r: u32, t: f64) -> u32 {
    const n : u32 = R_N[r as usize];
    const f : u32 = R_FIRST[r as usize];
    if (n == 0) { return 0; }
    if (t < L_T[f as usize]) { return 0; }
    var lo : u32 = 0;
    var hi : u32 = n - 1;
    while (lo < hi) {
        const mid : u32 = (lo + hi + 1) / 2;
        if (L_T[(f + mid) as usize] <= t) { lo = mid; } else { hi = mid - 1; }
    }
    return lo;
}

// --- time: timeText ----------------------------------------------------------------------------------------------

fn unit_index() -> u32 {
    var u : u32 = 0;
    if (D_UEXP < 0) { u = ((0 - D_UEXP) as u32) / 3; }
    if (u > 5) { u = 5; }
    return u;
}

/// timeText(t, data) as raw bytes.
fn put_time(o: []u8, n0: u32, t: f64) -> u32 {
    const seconds : f64 = t * D_UMUL;
    if (seconds == 0.0) {
        var n : u32 = copy_into(o, n0, "0 ");
        return jn_raw(o, n, SAY_TIME_UNITS[unit_index() as usize]);
    }
    var abs_s : f64 = seconds;
    if (abs_s < 0.0) { abs_s = 0.0 - abs_s; }
    const absf : f64 = abs_s * pow10i(D_UEXP + 15);
    var u : u32 = 5;
    while (u > 0 and absf >= pow1000i(6 - u)) { u = u - 1; }
    const val : f64 = absf / pow1000i(5 - u);
    var tmp : [400]u8 = [0; 400];
    var tl : u32 = 0;
    if (val >= 100.0) {
        tl = js_to_fixed(tmp[0..], 0, val, 0);
    } else {
        if (val >= 10.0) { tl = js_to_fixed(tmp[0..], 0, val, 1); } else { tl = js_to_fixed(tmp[0..], 0, val, 2); }
    }
    if (tl == OVER) { tl = 0; }
    var has_dot : bool = false;
    var i : u32 = 0;
    while (i < tl) {
        if (tmp[i as usize] == 46) { has_dot = true; }
        i = i + 1;
    }
    if (has_dot) {
        // s.replace(/\.?0+$/, ''): trailing zeros, and the dot before them
        var e : u32 = tl;
        while (e > 0 and tmp[(e - 1) as usize] == 48) { e = e - 1; }
        if (e < tl) {
            if (e > 0 and tmp[(e - 1) as usize] == 46) { e = e - 1; }
            tl = e;
        }
    }
    var n : u32 = jn_raw(o, n0, tmp[0..(tl as usize)]);
    n = put(o, n, 32);
    return jn_raw(o, n, SAY_TIME_UNITS[u as usize]);
}

/// niceStep(raw): the first of 1, 2, 5, 10 times 10 ** floor(log10(raw)) that reaches raw (answers from the host).
fn libm2(op: u32, a: f64, b: f64) -> f64 {
    var i : u32 = 0;
    while (i < LB_N) {
        if ((LB_OP[i as usize] as u32) == op and LB_A[i as usize] == a and LB_B[i as usize] == b) { return LB_R[i as usize]; }
        i = i + 1;
    }
    MISSING = true;
    var j : u32 = 0;
    while (j < RQ_N) {
        if ((RQ_OP[j as usize] as u32) == op and RQ_A[j as usize] == a and RQ_B[j as usize] == b) { return 0.0; }
        j = j + 1;
    }
    if (RQ_N < 64) {
        RQ_OP[RQ_N as usize] = op as u8;
        RQ_A[RQ_N as usize] = a;
        RQ_B[RQ_N as usize] = b;
        RQ_N = RQ_N + 1;
    }
    return 0.0;
}

pub fn w_libm_need(dst: []f64) -> u32 {
    if (RQ_N == 0) { return 0; }
    var k : u32 = 0;
    while (k < RQ_N and ((k * 3 + 2) as usize) < dst.len) {
        dst[(k * 3) as usize] = RQ_OP[k as usize] as f64;
        dst[(k * 3 + 1) as usize] = RQ_A[k as usize];
        dst[(k * 3 + 2) as usize] = RQ_B[k as usize];
        k = k + 1;
    }
    RQ_SENT = k;
    return k;
}

pub fn w_libm_give(src: []const f64, n: u32) -> u32 {
    var k : u32 = 0;
    while (k < n and k < RQ_SENT and (k as usize) < src.len) {
        if (LB_N >= 64) { LB_N = 0; }
        LB_OP[LB_N as usize] = RQ_OP[k as usize];
        LB_A[LB_N as usize] = RQ_A[k as usize];
        LB_B[LB_N as usize] = RQ_B[k as usize];
        LB_R[LB_N as usize] = src[k as usize];
        LB_N = LB_N + 1;
        k = k + 1;
    }
    RQ_N = 0;
    RQ_SENT = 0;
    MISSING = false;
    return 0;
}

fn nice_step(raw_v: f64) -> f64 {
    const lg : f64 = libm2(4, raw_v, 0.0);
    const p : f64 = libm2(5, 10.0, js_floor(lg));
    if (1.0 * p >= raw_v) { return 1.0 * p; }
    if (2.0 * p >= raw_v) { return 2.0 * p; }
    if (5.0 * p >= raw_v) { return 5.0 * p; }
    if (10.0 * p >= raw_v) { return 10.0 * p; }
    return 10.0 * p;
}

// --- view: gutter, fit, clampView, zoomBy, resize ----------------------------------------------------------------

fn gutter() -> f64 {
    return js_round(js_min(220.0, js_max(92.0, W_PX * 0.24)));
}

fn wave_w() -> f64 {
    return js_max(40.0, W_PX - gutter() - 8.0);
}

fn checks_h() -> f64 {
    if (HAVE and NCHECKS > 0) { return K_CHECKS_PX as f64; }
    return 0.0;
}

fn rows_h() -> f64 {
    return H_PX - (K_AXIS_PX as f64) - checks_h();
}

fn x_of(t: f64) -> f64 {
    return gutter() + (t - V_T0) * V_SCALE;
}

fn t_of(x: f64) -> f64 {
    return V_T0 + (x - gutter()) / V_SCALE;
}

fn min_scale() -> f64 {
    return (wave_w() / D_END) * 0.5;
}

fn fit() -> u32 {
    if (!HAVE) { return 0; }
    V_T0 = 0.0;
    V_SCALE = wave_w() / D_END;
    V_Y = 0.0;
    return 0;
}

fn clamp_view() -> u32 {
    if (!HAVE) { return 0; }
    V_SCALE = js_min(K_MAX_PX_PER_UNIT as f64, js_max(min_scale(), V_SCALE));
    const span : f64 = wave_w() / V_SCALE;
    V_T0 = js_min(D_END - span * 0.2, js_max(0.0 - span * 0.8, V_T0));
    const content : f64 = (NROWS as f64) * (K_ROW_PX as f64);
    V_Y = js_max(0.0, js_min(js_max(0.0, content - rows_h()), V_Y));
    return 0;
}

/// zoomBy(f, atX): at_x is the pointer's x, or the middle of the waves when use_mid.
fn zoom_by(f: f64, at: f64, use_mid: bool) -> u32 {
    if (!HAVE) { return 0; }
    var at_x : f64 = at;
    if (use_mid) { at_x = gutter() + wave_w() / 2.0; }
    const t : f64 = t_of(at_x);
    V_SCALE = V_SCALE * f;
    clamp_view();
    V_T0 = t - (at_x - gutter()) / V_SCALE;
    clamp_view();
    return 0;
}

fn dpr_now() -> f64 {
    if (ENV_DPR == 0.0 or ENV_DPR != ENV_DPR) { return 1.0; }
    return ENV_DPR;
}

fn resize() -> u32 {
    var want : f64 = 300.0;
    if (HAVE) { want = (NROWS as f64) * (K_ROW_PX as f64) + (K_AXIS_PX as f64) + checks_h(); }
    var h : f64 = 0.0;
    if (IS_EMBED) {
        h = js_max(200.0, RECT_H);
    } else {
        h = js_max(240.0, js_min(want, js_round(ENV_IH * 0.72)));
    }
    W_PX = js_max(200.0, js_floor(RECT_W));
    H_PX = js_floor(h);
    const dpr : f64 = dpr_now();
    CV_W = js_round(W_PX * dpr) as u64;
    CV_H = js_round(H_PX * dpr) as u64;
    CV_SW = js_floor(W_PX) as u64;
    CV_SHT = js_floor(H_PX) as u64;
    CV_SET = true;
    return 0;
}

fn relayout() -> u32 {
    var have_span : bool = false;
    var span : f64 = 0.0;
    if (HAVE and W_PX != 0.0) {
        span = wave_w() / V_SCALE;
        have_span = span != 0.0 and span == span;
    }
    resize();
    if (HAVE and have_span) {
        V_SCALE = wave_w() / span;
        clamp_view();
    }
    return 0;
}

// --- status line and source line, as raw text ---------------------------------------------------------------------

fn set_status(cls: u32) -> u32 {
    ST_CLS = cls;
    return 0;
}

fn pool_str(vb: []u8, n0: u32, key: []const u8, v: []const u8) -> u32 {
    return jv_vput_str(vb, n0, key, v);
}

fn pool_u32(vb: []u8, n0: u32, key: []const u8, v: u64) -> u32 {
    var tmp : [32]u8 = [0; 32];
    const l : u32 = dec_to(tmp[0..], v);
    return jv_vput_str(vb, n0, key, tmp[0..(l as usize)]);
}

/// showError(fill(template, pool)).
fn show_error_fill(t: []const u8, vb: []const u8, vn: u32) -> u32 {
    ST_LEN = 0;
    if (vn != OVER) {
        const l : u32 = jv_fill_raw(ST_TXT[0..], 0, t, vb, vn, false);
        if (l != OVER) { ST_LEN = l; }
    }
    ST_CLS = 2;
    return 0;
}

/// The message of a VcdError (P_ERR 1 to 4) as raw bytes into o.
fn put_vcd_error(o: []u8, n0: u32) -> u32 {
    if (P_ERR == 1) { return jn_raw(o, n0, SAY_ERR_NO_DEFS); }
    if (P_ERR == 2) { return jn_raw(o, n0, SAY_ERR_NO_TIMESCALE); }
    if (P_ERR == 4) { return jn_raw(o, n0, SAY_ERR_NO_SIGNALS); }
    var vb : [512]u8 = [0; 512];
    var vn : u32 = jv_vput_str(vb[0..], 0, "token", ERR_TOKEN[0..(ERR_TOKEN_LEN as usize)]);
    var tb : [64]u8 = [0; 64];
    const tl : u32 = js_str_num(tb[0..], 0, ERR_TIME);
    vn = jv_vput_str(vb[0..], vn, "t", tb[0..(tl as usize)]);
    return jv_fill_raw(o, n0, SAY_ERR_BAD_TOKEN, vb[0..], vn, false);
}

fn show_demo_error(why: []const u8) -> u32 {
    var vb : [4096]u8 = [0; 4096];
    const vn : u32 = jv_vput_str(vb[0..], 0, "why", why);
    return show_error_fill(SAY_ERR_DEMO, vb[0..], vn);
}

// --- setData -----------------------------------------------------------------------------------------------------

pub var SEL : [65536]u32 = [0; 65536];
pub var SEL_K : [65536]u32 = [0; 65536];

/// Is the word lit at P_NP[j ..) (lowercase letters, ASCII case-insensitive) and followed by the end e or . or _ ?
fn word_at(j: u32, e: u32, lit: []const u8) -> bool {
    if (j + (lit.len as u32) > e) { return false; }
    var k : usize = 0;
    while (k < lit.len) {
        if (low(P_NP[(j as usize) + k]) != lit[k]) { return false; }
        k = k + 1;
    }
    const nx : u32 = j + (lit.len as u32);
    if (nx == e) { return true; }
    return P_NP[nx as usize] == 46 or P_NP[nx as usize] == 95;
}

/// Is the last dotted segment of the name at P_NP[a .. a + l) a clock: /(^|[._])(clk|clock)([._]|$)/i.
fn clock_name(a: u32, l: u32) -> bool {
    var s : u32 = a;
    var i : u32 = a;
    while (i < a + l) {
        if (P_NP[i as usize] == 46) { s = i + 1; }
        i = i + 1;
    }
    const e : u32 = a + l;
    var j : u32 = s;
    while (j < e) {
        if (j == s or P_NP[(j - 1) as usize] == 95) {
            if (word_at(j, e, "clk") or word_at(j, e, "clock")) { return true; }
        }
        j = j + 1;
    }
    return false;
}

fn low(c: u8) -> u8 {
    if (c >= 65 and c <= 90) { return c + 32; }
    return c;
}

/// Is the decoded JSON string at sp equal to P_NP[a .. a + l)?
fn json_name_is(d: []const u8, sp: i64, a: u32, l: u32) -> bool {
    if (kind(d, sp) != J_STRING) { return false; }
    if (str_len(d, sp) != l) { return false; }
    var k : u32 = 0;
    while (k < l) {
        if (str_byte(d, sp, k) != P_NP[(a + k) as usize]) { return false; }
        k = k + 1;
    }
    return true;
}

fn role_code(d: []const u8, sp: i64) -> u8 {
    if (jv_is(d, sp, "clock")) { return 1; }
    if (jv_is(d, sp, "in")) { return 2; }
    if (jv_is(d, sp, "out")) { return 3; }
    if (jv_is(d, sp, "tb")) { return 4; }
    return 0;
}

/// shortNames(rows): the dotted scope every row shares is dropped.
fn short_names() -> u32 {
    var common : u32 = 0;
    var go : bool = NROWS > 0;
    while (go) {
        // segment `common` of row 0
        var ok : bool = true;
        var r : u32 = 0;
        var a0 : u32 = 0;
        var l0 : u32 = 0;
        while (r < NROWS and ok) {
            const o : u32 = R_NAME_O[r as usize];
            const l : u32 = R_NAME_L[r as usize];
            // count segments and find segment `common`
            var segs : u32 = 1;
            var sa : u32 = o;
            var found : bool = false;
            var fa : u32 = o;
            var fl : u32 = 0;
            var i : u32 = o;
            var cur : u32 = 0;
            while (i < o + l) {
                if (L_NP[i as usize] == 46) {
                    if (cur == common) {
                        found = true;
                        fa = sa;
                        fl = i - sa;
                    }
                    segs = segs + 1;
                    cur = cur + 1;
                    sa = i + 1;
                }
                i = i + 1;
            }
            if (cur == common) {
                found = true;
                fa = sa;
                fl = o + l - sa;
            }
            if (!(segs > common + 1)) { ok = false; }
            if (ok and !found) { ok = false; }
            if (ok and r == 0) {
                a0 = fa;
                l0 = fl;
            }
            if (ok and r > 0) {
                if (fl != l0) { ok = false; }
                var k : u32 = 0;
                while (ok and k < fl) {
                    if (L_NP[(fa + k) as usize] != L_NP[(a0 + k) as usize]) { ok = false; }
                    k = k + 1;
                }
            }
            r = r + 1;
        }
        if (ok) { common = common + 1; } else { go = false; }
    }
    // short = parts.slice(common).join('.'): from the start of segment `common`
    var r : u32 = 0;
    while (r < NROWS) {
        const o : u32 = R_NAME_O[r as usize];
        const l : u32 = R_NAME_L[r as usize];
        var start : u32 = o;
        var seen : u32 = 0;
        var i : u32 = o;
        while (i < o + l and seen < common) {
            if (L_NP[i as usize] == 46) {
                seen = seen + 1;
                start = i + 1;
            }
            i = i + 1;
        }
        R_SHORT_O[r as usize] = start;
        R_SHORT_L[r as usize] = o + l - start;
        r = r + 1;
    }
    return 0;
}

/// setData(parsed, ...) from the scratch tables: false (P_ERR = 5) when the rows do not fit the tables of the page.
/// roles/checks come from DEMO_JSON when is_demo.
fn set_data(is_demo: bool, name: []const u8) -> bool {
    const dj : []const u8 = DEMO_JSON[0..(DJ_LEN as usize)];
    var roles : i64 = NO_SPAN;
    var checks : i64 = NO_SPAN;
    if (is_demo) {
        roles = obj_get(dj, root(dj), "signals");
        checks = obj_get(dj, root(dj), "checks");
    }
    const use_roles : bool = is_demo and jv_truthy(dj, roles);
    // the rows: the signals that change, in file order
    var nsel : u32 = 0;
    var v : u32 = 0;
    while (v < P_VN) {
        if (PV_CNT[PV_CANON[v as usize] as usize] > 0) {
            if (use_roles) {
                // the last role entry with this name
                var best : i32 = 0 - 1;
                const cnt : u32 = arr_len(dj, roles);
                var k : u32 = 0;
                while (k < cnt) {
                    if (json_name_is(dj, obj_get(dj, arr_at(dj, roles, k), "name"), PV_NAME_O[v as usize], PV_NAME_L[v as usize])) { best = k as i32; }
                    k = k + 1;
                }
                if (best >= 0) {
                    SEL[nsel as usize] = v;
                    SEL_K[nsel as usize] = best as u32;
                    nsel = nsel + 1;
                }
            } else {
                SEL[nsel as usize] = v;
                SEL_K[nsel as usize] = 0;
                nsel = nsel + 1;
            }
        }
        v = v + 1;
    }
    if (use_roles) {
        // a stable insertion sort by the role order
        var i : u32 = 1;
        while (i < nsel) {
            const sv : u32 = SEL[i as usize];
            const sk : u32 = SEL_K[i as usize];
            var j : u32 = i;
            while (j > 0 and SEL_K[(j - 1) as usize] > sk) {
                SEL[j as usize] = SEL[(j - 1) as usize];
                SEL_K[j as usize] = SEL_K[(j - 1) as usize];
                j = j - 1;
            }
            SEL[j as usize] = sv;
            SEL_K[j as usize] = sk;
            i = i + 1;
        }
    }
    const truncated : bool = nsel > K_MAX_SIGNALS as u32;
    var nrows : u32 = nsel;
    if (nrows > (K_MAX_SIGNALS as u32)) { nrows = K_MAX_SIGNALS as u32; }
    // do the rows fit the page's tables
    var need_ch : u32 = 0;
    var need_vp : u32 = 0;
    var need_np : u32 = 0;
    var r : u32 = 0;
    while (r < nrows) {
        const c : u32 = PV_CANON[SEL[r as usize] as usize];
        need_ch = need_ch + PV_CNT[c as usize];
        var q : u32 = 0;
        while (q < PV_CNT[c as usize]) {
            need_vp = need_vp + S_VL[(PV_START[c as usize] + q) as usize];
            q = q + 1;
        }
        need_np = need_np + PV_NAME_L[SEL[r as usize] as usize];
        r = r + 1;
    }
    if (need_ch > W_MAX_CH or need_vp > W_VPOOL or need_np > W_NPOOL) {
        P_ERR = 5;
        return false;
    }
    // copy the rows
    L_N = 0;
    L_VP_N = 0;
    L_NP_N = 0;
    r = 0;
    while (r < nrows) {
        const sv : u32 = SEL[r as usize];
        const c : u32 = PV_CANON[sv as usize];
        R_NAME_O[r as usize] = L_NP_N;
        R_NAME_L[r as usize] = PV_NAME_L[sv as usize];
        var q : u32 = 0;
        while (q < PV_NAME_L[sv as usize]) {
            L_NP[(L_NP_N + q) as usize] = P_NP[(PV_NAME_O[sv as usize] + q) as usize];
            q = q + 1;
        }
        L_NP_N = L_NP_N + PV_NAME_L[sv as usize];
        R_WIDTH[r as usize] = PV_WIDTH[sv as usize];
        R_REAL[r as usize] = PV_REAL[sv as usize];
        R_FIRST[r as usize] = L_N;
        R_N[r as usize] = PV_CNT[c as usize];
        q = 0;
        while (q < PV_CNT[c as usize]) {
            const at : u32 = PV_START[c as usize] + q;
            L_T[L_N as usize] = S_T[at as usize];
            L_VO[L_N as usize] = L_VP_N;
            L_VL[L_N as usize] = S_VL[at as usize];
            var b : u32 = 0;
            while (b < S_VL[at as usize]) {
                L_VP[(L_VP_N + b) as usize] = P_VP[(S_VO[at as usize] + b) as usize];
                b = b + 1;
            }
            L_VP_N = L_VP_N + S_VL[at as usize];
            L_N = L_N + 1;
            q = q + 1;
        }
        if (use_roles) {
            const re : i64 = arr_at(dj, roles, SEL_K[r as usize]);
            R_ROLE[r as usize] = role_code(dj, obj_get(dj, re, "role"));
            R_SDEC[r as usize] = 0;
            if (jv_is(dj, obj_get(dj, re, "radix"), "sdec")) { R_SDEC[r as usize] = 1; }
        } else {
            R_SDEC[r as usize] = 0;
            R_ROLE[r as usize] = 2;
            if (PV_WIDTH[sv as usize] == 1.0 and clock_name(PV_NAME_O[sv as usize], PV_NAME_L[sv as usize])) { R_ROLE[r as usize] = 1; }
        }
        r = r + 1;
    }
    NROWS = nrows;
    short_names();
    // the data
    D_END = P_END;
    D_UEXP = P_UEXP;
    D_UMUL = P_UMUL;
    D_TOTAL = P_NSIG;
    NCHECKS = 0;
    if (is_demo and kind(dj, checks) == J_ARRAY) {
        var cnt : u32 = arr_len(dj, checks);
        if (cnt > W_MAX_CHECKS) { cnt = W_MAX_CHECKS; }
        var k : u32 = 0;
        while (k < cnt) {
            const ce : i64 = arr_at(dj, checks, k);
            CK_SP[k as usize] = ce;
            CK_T[k as usize] = numv(dj, obj_get(dj, ce, "t"));
            k = k + 1;
        }
        NCHECKS = cnt;
    }
    HAVE = true;
    IS_DEMO = is_demo;
    PICKED = 0 - 1;
    resize();
    fit();
    CUR_ON = true;
    if (NCHECKS > 0) { CURSOR = CK_T[0]; } else { CURSOR = js_round(D_END * 0.4); }
    PRESSED = is_demo;
    // the lines under the diagram
    SRC_LEN = 0;
    var vb : [8192]u8 = [0; 8192];
    var vn : u32 = 0;
    if (is_demo) {
        const spec : i64 = obj_get(dj, root(dj), "spec");
        const tools : i64 = obj_get(dj, root(dj), "tools");
        vn = jv_vput_val(vb[0..], 0, "spec", dj, obj_get(dj, spec, "path"));
        vn = jv_vput_val(vb[0..], vn, "module", dj, obj_get(dj, spec, "module"));
        vn = jv_vput_val(vb[0..], vn, "iverilog", dj, obj_get(dj, tools, "iverilog"));
        if (vn != OVER) {
            const l : u32 = jv_fill_raw(SRC_TXT[0..], 0, SAY_DEMO_SOURCE, vb[0..], vn, false);
            if (l != OVER) { SRC_LEN = l; }
        }
        // status: the summary
        const sm : i64 = obj_get(dj, root(dj), "summary");
        var sb : [8192]u8 = [0; 8192];
        const sn : u32 = pool_members(sb[0..], dj, sm);
        ST_LEN = 0;
        if (sn != OVER) {
            const l : u32 = jv_fill_raw(ST_TXT[0..], 0, SAY_CHECKS_SUMMARY, sb[0..], sn, false);
            if (l != OVER) { ST_LEN = l; }
        }
        if (json_strict_eq(dj, obj_get(dj, sm, "pass"), obj_get(dj, sm, "total"))) { ST_CLS = 1; } else { ST_CLS = 2; }
    } else {
        var nm : [1100]u8 = [0; 1100];
        FILE_NAME_LEN = copy_into(FILE_NAME[0..], 0, name);
        vn = jv_vput_str(vb[0..], 0, "name", name);
        vn = jv_vput_str(vb[0..], vn, "signals", dec_str(D_TOTAL));
        var tt : [128]u8 = [0; 128];
        const tl : u32 = put_time(tt[0..], 0, D_END);
        vn = jv_vput_str(vb[0..], vn, "span", tt[0..(tl as usize)]);
        if (vn != OVER) {
            const l : u32 = jv_fill_raw(SRC_TXT[0..], 0, SAY_FILE_SOURCE, vb[0..], vn, false);
            if (l != OVER) { SRC_LEN = l; }
        }
        ST_LEN = 0;
        if (truncated) {
            var tb : [256]u8 = [0; 256];
            var tn : u32 = jv_vput_str(tb[0..], 0, "shown", dec_str(K_MAX_SIGNALS as u32));
            tn = jv_vput_str(tb[0..], tn, "total", dec_str(D_TOTAL));
            const l : u32 = jv_fill_raw(ST_TXT[0..], 0, SAY_TRUNCATED, tb[0..], tn, false);
            if (l != OVER) { ST_LEN = l; }
        }
        ST_CLS = 0;
    }
    return true;
}

pub var FILE_NAME_LEN : u32 = 0;
pub var DEC_BUF : [24]u8 = [0; 24];

fn dec_str(v: u32) -> []const u8 {
    const l : u32 = dec_to(DEC_BUF[0..], v as u64);
    return DEC_BUF[0..(l as usize)];
}

/// A pool entry for every member of the object at sp: key, String(value).
fn pool_members(vb: []u8, d: []const u8, sp: i64) -> u32 {
    var n : u32 = 0;
    if (kind(d, sp) != J_OBJECT) { return 0; }
    const hi : usize = span_hi(sp);
    var p : usize = skip_ws(d, span_lo(sp) + 1);
    while (p < hi and d[p] == 34) {
        const ke : usize = string_end(d, p);
        const q : usize = skip_ws(d, ke);
        const v : usize = skip_ws(d, q + 1);
        const ve : usize = value_end(d, v);
        var kb : [256]u8 = [0; 256];
        const kl : u32 = jv_str_to(kb[0..], 0, d, jspan(p, ke));
        if (kl != OVER and kl < 200) { n = jv_vput_val(vb, n, kb[0..(kl as usize)], d, jspan(v, ve)); }
        p = skip_ws(d, ve);
        if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
    }
    return n;
}

/// a === b for two JSON values (numbers by value, strings by text, literals by kind; objects and arrays never).
fn json_strict_eq(d: []const u8, a: i64, b: i64) -> bool {
    const ka : u8 = kind(d, a);
    const kb : u8 = kind(d, b);
    if (ka != kb) { return false; }
    if (ka == J_NONE) { return true; }
    if (ka == J_NUMBER) { return jv_numval(d, a) == jv_numval(d, b); }
    if (ka == J_STRING) {
        const l : u32 = str_len(d, a);
        if (l != str_len(d, b)) { return false; }
        var k : u32 = 0;
        while (k < l) {
            if (str_byte(d, a, k) != str_byte(d, b, k)) { return false; }
            k = k + 1;
        }
        return true;
    }
    if (ka == J_TRUE or ka == J_FALSE or ka == J_NULL) { return true; }
    return false;
}

// --- the text width memo ---------------------------------------------------------------------------------------

fn x_same(off: u32, len: u32, s: []const u8) -> bool {
    if (len != (s.len as u32)) { return false; }
    var k : u32 = 0;
    while (k < len) {
        if (X_POOL[(off + k) as usize] != s[k as usize]) { return false; }
        k = k + 1;
    }
    return true;
}

pub var X_MISS : bool = false;

/// ctx.measureText(text).width under the font: from the memo, else asked of the host and read as 0 for now.
fn x_width(font: []const u8, text: []const u8) -> f64 {
    var i : u32 = 0;
    while (i < X_N) {
        if (x_same(X_FO[i as usize], X_FL[i as usize], font) and x_same(X_TO[i as usize], X_TL[i as usize], text)) {
            if (X_ST[i as usize] == 2) { return X_W[i as usize]; }
            X_MISS = true;
            return 0.0;
        }
        i = i + 1;
    }
    X_MISS = true;
    if (X_N >= 4096 or X_POOL_N + (font.len as u32) + (text.len as u32) > 262144) {
        X_N = 0;
        X_POOL_N = 0;
    }
    if ((font.len as u32) + (text.len as u32) > 262144) { return 0.0; }
    const e : u32 = X_N;
    X_FO[e as usize] = X_POOL_N;
    X_FL[e as usize] = font.len as u32;
    X_POOL_N = copy_into(X_POOL[0..], X_POOL_N, font);
    X_TO[e as usize] = X_POOL_N;
    X_TL[e as usize] = text.len as u32;
    X_POOL_N = copy_into(X_POOL[0..], X_POOL_N, text);
    X_ST[e as usize] = 0;
    X_N = e + 1;
    return 0.0;
}

fn put_u32le(dst: []u8, at: u32, v: u32) -> u32 {
    dst[at as usize] = (v % 256) as u8;
    dst[(at + 1) as usize] = ((v / 256) % 256) as u8;
    dst[(at + 2) as usize] = ((v / 65536) % 256) as u8;
    dst[(at + 3) as usize] = ((v / 16777216) % 256) as u8;
    return at + 4;
}

pub fn w_text_need(dst: []u8) -> u32 {
    var n : u32 = 0;
    var c : u32 = 0;
    var i : u32 = 0;
    while (i < X_N) {
        if (X_ST[i as usize] == 0) {
            const need : u32 = 8 + X_FL[i as usize] + X_TL[i as usize];
            if ((n as usize) + (need as usize) > dst.len) { return c; }
            n = put_u32le(dst, n, X_FL[i as usize]);
            n = put_u32le(dst, n, X_TL[i as usize]);
            var k : u32 = 0;
            while (k < X_FL[i as usize]) {
                dst[(n + k) as usize] = X_POOL[(X_FO[i as usize] + k) as usize];
                k = k + 1;
            }
            n = n + X_FL[i as usize];
            k = 0;
            while (k < X_TL[i as usize]) {
                dst[(n + k) as usize] = X_POOL[(X_TO[i as usize] + k) as usize];
                k = k + 1;
            }
            n = n + X_TL[i as usize];
            X_ST[i as usize] = 1;
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

pub fn w_text_give(src: []const f64, n: u32) -> u32 {
    var i : u32 = 0;
    var k : u32 = 0;
    while (i < X_N and k < n and (k as usize) < src.len) {
        if (X_ST[i as usize] == 1) {
            X_W[i as usize] = src[k as usize];
            X_ST[i as usize] = 2;
            k = k + 1;
        }
        i = i + 1;
    }
    return 0;
}

// --- the binary draw list ------------------------------------------------------------------------------------------

fn bw_b(o: []u8, n: u32, b: u8) -> u32 {
    if (n == OVER or (n as usize) >= o.len) { return OVER; }
    o[n as usize] = b;
    return n + 1;
}

fn f64_bits(x: f64) -> u64 {
    if (x == 0.0) {
        if ((1.0 / x) < 0.0) { return 9223372036854775808; }
        return 0;
    }
    var sign : u64 = 0;
    var ax : f64 = x;
    if (x < 0.0) {
        sign = 9223372036854775808;
        ax = 0.0 - x;
    }
    const m : u64 = jn_mant(ax);
    const e : i32 = jn_expo(ax);
    const be : u64 = ((e + 52 + 1023) as u64);
    return sign + be * 4503599627370496 + (m - 4503599627370496);
}

fn bw_f(o: []u8, n0: u32, x: f64) -> u32 {
    var bits : u64 = f64_bits(x);
    var n : u32 = n0;
    var k : u32 = 0;
    while (k < 8) {
        n = bw_b(o, n, (bits % 256) as u8);
        bits = bits / 256;
        k = k + 1;
    }
    return n;
}

fn bw_s(o: []u8, n0: u32, s: []const u8) -> u32 {
    var n : u32 = bw_b(o, n0, (s.len % 256) as u8);
    n = bw_b(o, n, ((s.len / 256) % 256) as u8);
    var k : usize = 0;
    while (k < s.len) {
        n = bw_b(o, n, s[k]);
        k = k + 1;
    }
    return n;
}

fn bw_raw(o: []u8, n0: u32, s: []const u8) -> u32 {
    var n : u32 = n0;
    var k : usize = 0;
    while (k < s.len) {
        n = bw_b(o, n, s[k]);
        k = k + 1;
    }
    return n;
}

fn bw_len(o: []u8, n0: u32, len: u32) -> u32 {
    const n : u32 = bw_b(o, n0, (len % 256) as u8);
    return bw_b(o, n, ((len / 256) % 256) as u8);
}

fn bw_set_s(o: []u8, n0: u32, op: u8, v: []const u8) -> u32 {
    const n : u32 = bw_b(o, n0, op);
    return bw_s(o, n, v);
}

fn bw_set_f(o: []u8, n0: u32, op: u8, v: f64) -> u32 {
    const n : u32 = bw_b(o, n0, op);
    return bw_f(o, n, v);
}

fn bw_rect(o: []u8, n0: u32, op: u8, a: f64, b: f64, c: f64, d: f64) -> u32 {
    var n : u32 = bw_b(o, n0, op);
    n = bw_f(o, n, a);
    n = bw_f(o, n, b);
    n = bw_f(o, n, c);
    return bw_f(o, n, d);
}

fn bw_pt(o: []u8, n0: u32, op: u8, x: f64, y: f64) -> u32 {
    var n : u32 = bw_b(o, n0, op);
    n = bw_f(o, n, x);
    return bw_f(o, n, y);
}

fn bw_text(o: []u8, n0: u32, s: []const u8, x: f64, y: f64) -> u32 {
    var n : u32 = bw_b(o, n0, 13);
    n = bw_s(o, n, s);
    n = bw_f(o, n, x);
    return bw_f(o, n, y);
}

/// A CSS variable with its fallback: byte 1, name, byte 2, fallback, byte 3 (the host trims the value).
fn var_bytes(f: []u8, n0: u32, name: []const u8, fb: []const u8) -> u32 {
    var n : u32 = n0;
    f[n as usize] = 1;
    n = copy_into(f, n + 1, name);
    f[n as usize] = 2;
    n = copy_into(f, n + 1, fb);
    f[n as usize] = 3;
    return n + 1;
}

/// Colour code: 0 green, 1 gold, 2 red, 3 text, 4 muted, 5 subtle, 6 line, 7 grid, 8 z, 9 black.
fn color_bytes(f: []u8, code: u32) -> u32 {
    if (code == 0) { return var_bytes(f, 0, "--w-green", "#00ff88"); }
    if (code == 1) { return var_bytes(f, 0, "--w-gold", "#ffd700"); }
    if (code == 2) { return var_bytes(f, 0, "--w-red", "#ff4d6d"); }
    if (code == 3) { return var_bytes(f, 0, "--w-text", "#e8fff7"); }
    if (code == 4) { return var_bytes(f, 0, "--w-muted", "#adc9c0"); }
    if (code == 5) { return var_bytes(f, 0, "--w-subtle", "#8fa9a0"); }
    if (code == 6) { return copy_into(f, 0, "rgba(0,255,136,0.16)"); }
    if (code == 7) { return copy_into(f, 0, "rgba(0,255,136,0.07)"); }
    if (code == 8) { return copy_into(f, 0, "#6fa8ff"); }
    return copy_into(f, 0, "#000");
}

/// fillStyle (op 32) or strokeStyle (op 33) set to a colour code.
fn bw_color(o: []u8, n0: u32, op: u8, code: u32) -> u32 {
    var f : [160]u8 = [0; 160];
    const l : u32 = color_bytes(f[0..], code);
    return bw_set_s(o, n0, op, f[0..(l as usize)]);
}

/// `${px}px ${mono}` into f: the variable --w-mono, trimmed, or ui-monospace, Menlo, monospace.
fn font_bytes(f: []u8, px: u32) -> u32 {
    var tmp : [16]u8 = [0; 16];
    const dl : u32 = dec_to(tmp[0..], px as u64);
    var n : u32 = copy_into(f, 0, tmp[0..(dl as usize)]);
    n = copy_into(f, n, "px ");
    return var_bytes(f, n, W_MONO_VAR, W_MONO_FB);
}

fn bw_font(o: []u8, n0: u32, px: u32) -> u32 {
    var f : [160]u8 = [0; 160];
    const l : u32 = font_bytes(f[0..], px);
    return bw_set_s(o, n0, 35, f[0..(l as usize)]);
}

fn role_color(role: u8) -> u32 {
    if (role == 1) { return 5; }
    if (role == 3) { return 1; }
    if (role == 4) { return 4; }
    return 0;
}

// the drawing state of one list
pub var D_FONT : u32 = 0;
pub var D_LABEL : [4200]u8 = [0; 4200];
pub var D_TMP : [4200]u8 = [0; 4200];

/// The bytes of x without its last UTF-16 unit (a code point; a pair counts as one step here).
fn drop_last(b: []const u8, n: u32) -> u32 {
    if (n == 0) { return 0; }
    var k : u32 = n - 1;
    while (k > 0 and (b[k as usize] & 192) == 128) { k = k - 1; }
    return k;
}

/// The number of UTF-16 units of b[0..n).
fn units_of(b: []const u8, n: u32) -> u32 {
    var u : u32 = 0;
    var i : u32 = 0;
    while (i < n) {
        const c : u8 = b[i as usize];
        if (c < 128 or c >= 192) {
            u = u + 1;
            if (c >= 240) { u = u + 1; }
        }
        i = i + 1;
    }
    return u;
}

/// measureText(b[0..n)).width under the font of px.
fn measure(px: u32, b: []const u8, n: u32) -> f64 {
    X_MISS = false;
    var f : [160]u8 = [0; 160];
    const fl : u32 = font_bytes(f[0..], px);
    return x_width(f[0..(fl as usize)], b[0..(n as usize)]);
}

/// Ask ahead: the prefixes of b[0..n) shorter by 1 to 8 units, in the font of px.
fn ask_prefixes(px: u32, b: []const u8, n0: u32, min_units: u32) -> u32 {
    var f : [160]u8 = [0; 160];
    const fl : u32 = font_bytes(f[0..], px);
    var n : u32 = n0;
    var t : u32 = 0;
    while (t < 8) {
        n = drop_last(b, n);
        if (units_of(b, n) < min_units) { return 0; }
        x_width(f[0..(fl as usize)], b[0..(n as usize)]);
        t = t + 1;
    }
    return 0;
}


/// The bytes of one UTF-16 unit step at a lead byte (a code point here).
fn unit_len(c: u8) -> u32 {
    if (c >= 240) { return 4; }
    if (c >= 224) { return 3; }
    if (c >= 192) { return 2; }
    return 1;
}

/// '\u2026' + b[s..n) into o; its length.
fn with_ellipsis(o: []u8, b: []const u8, s: u32, n: u32) -> u32 {
    o[0] = 226;
    o[1] = 128;
    o[2] = 166;
    var k : u32 = 0;
    while (s + k < n) {
        o[(3 + k) as usize] = b[(s + k) as usize];
        k = k + 1;
    }
    return 3 + k;
}

/// Ask ahead: the next 8 shorter suffixes (with the ellipsis) of b[s..n), in the font of px.
fn ask_suffixes(px: u32, b: []const u8, s0: u32, n: u32) -> u32 {
    var f : [160]u8 = [0; 160];
    const fl : u32 = font_bytes(f[0..], px);
    var s : u32 = s0;
    var t : u32 = 0;
    while (t < 8) {
        if (!(units_of(b[(s as usize)..], n - s) > 1)) { return 0; }
        s = s + unit_len(b[s as usize]);
        var tmp : [4210]u8 = [0; 4210];
        const cl : u32 = with_ellipsis(tmp[0..], b, s, n);
        x_width(f[0..(fl as usize)], tmp[0..(cl as usize)]);
        t = t + 1;
    }
    return 0;
}

/// drawBit(sig r, y0, colour, t0, t1)
fn draw_bit(o: []u8, n0: u32, r: u32, y0: f64, colour: u32, t0: f64, t1: f64) -> u32 {
    var n : u32 = n0;
    const row_px : f64 = K_ROW_PX as f64;
    const hi : f64 = y0 + 7.0;
    const lo : f64 = y0 + row_px - 7.0;
    const mid : f64 = (hi + lo) / 2.0;
    const gx : f64 = gutter();
    const xr : f64 = gx + wave_w();
    var i : u32 = first_index_at(r, t0);
    var have_prev : bool = false;
    var prev_y : f64 = 0.0;
    if (R_ROLE[r as usize] == 1) { n = bw_set_f(o, n, 34, 1.0); } else { n = bw_set_f(o, n, 34, 1.5); }
    const cnt : u32 = R_N[r as usize];
    const f : u32 = R_FIRST[r as usize];
    while (i < cnt and L_T[(f + i) as usize] <= t1) {
        const a : f64 = js_max(gx, x_of(L_T[(f + i) as usize]));
        var bx : f64 = 0.0;
        if (i + 1 < cnt) { bx = x_of(L_T[(f + i + 1) as usize]); } else { bx = x_of(D_END); }
        const b : f64 = js_min(xr, bx);
        if (!(b < a)) {
            const vo : u32 = L_VO[(f + i) as usize];
            const vl : u32 = L_VL[(f + i) as usize];
            var y : f64 = mid;
            if (vl == 1 and L_VP[vo as usize] == 49) { y = hi; }
            if (vl == 1 and L_VP[vo as usize] == 48) { y = lo; }
            const is_x : bool = vl == 1 and L_VP[vo as usize] == 120;
            const is_z : bool = vl == 1 and L_VP[vo as usize] == 122;
            if (is_x) {
                n = bw_color(o, n, 33, 2);
            } else {
                if (is_z) { n = bw_color(o, n, 33, 8); } else { n = bw_color(o, n, 33, colour); }
            }
            if (is_x) {
                n = bw_set_s(o, n, 32, "rgba(255,77,109,0.18)");
                n = bw_rect(o, n, 10, a, hi, b - a, lo - hi);
            }
            n = bw_b(o, n, 1);
            if (have_prev and prev_y != y and a > gx) {
                n = bw_pt(o, n, 7, a, prev_y);
                n = bw_pt(o, n, 8, a, y);
            } else {
                n = bw_pt(o, n, 7, a, y);
            }
            n = bw_pt(o, n, 8, b, y);
            n = bw_b(o, n, 4);
            if (vl == 1 and L_VP[vo as usize] == 49 and R_ROLE[r as usize] != 1) {
                n = bw_set_s(o, n, 32, "rgba(0,255,136,0.07)");
                n = bw_rect(o, n, 10, a, hi, b - a, lo - hi);
            }
            prev_y = y;
            have_prev = true;
        }
        i = i + 1;
    }
    return n;
}

fn all_z(vo: u32, vl: u32) -> bool {
    if (vl == 0) { return false; }
    var i : u32 = 0;
    while (i < vl) {
        if (L_VP[(vo + i) as usize] != 122) { return false; }
        i = i + 1;
    }
    return true;
}

fn has_x(vo: u32, vl: u32) -> bool {
    var i : u32 = 0;
    while (i < vl) {
        if (L_VP[(vo + i) as usize] == 120) { return true; }
        i = i + 1;
    }
    return false;
}

/// drawBus(sig r, y0, colour, t0, t1)
fn draw_bus(o: []u8, n0: u32, r: u32, y0: f64, colour: u32, t0: f64, t1: f64) -> u32 {
    var n : u32 = n0;
    const row_px : f64 = K_ROW_PX as f64;
    const top : f64 = y0 + 6.0;
    const bot : f64 = y0 + row_px - 6.0;
    const mid : f64 = (top + bot) / 2.0;
    const gx : f64 = gutter();
    const xr : f64 = gx + wave_w();
    var i : u32 = first_index_at(r, t0);
    n = bw_font(o, n, 11);
    n = bw_set_s(o, n, 36, "middle");
    const cnt : u32 = R_N[r as usize];
    const f : u32 = R_FIRST[r as usize];
    const is_real : bool = R_REAL[r as usize] != 0;
    while (i < cnt and L_T[(f + i) as usize] <= t1) {
        const a : f64 = js_max(gx, x_of(L_T[(f + i) as usize]));
        var bx : f64 = 0.0;
        if (i + 1 < cnt) { bx = x_of(L_T[(f + i + 1) as usize]); } else { bx = x_of(D_END); }
        const b : f64 = js_min(xr, bx);
        if (b > a) {
            const vo : u32 = L_VO[(f + i) as usize];
            const vl : u32 = L_VL[(f + i) as usize];
            const bad : bool = !is_real and has_x(vo, vl);
            const hiz : bool = !is_real and all_z(vo, vl);
            var scol : u32 = colour;
            if (hiz) { scol = 8; }
            if (bad) { scol = 2; }
            n = bw_color(o, n, 33, scol);
            n = bw_set_f(o, n, 34, 1.25);
            const k : f64 = js_min(4.0, (b - a) / 2.0);
            if (b - a < 3.0) {
                n = bw_color(o, n, 32, scol);
                n = bw_set_f(o, n, 38, 0.5);
                n = bw_rect(o, n, 10, a, top, js_max(1.0, b - a), bot - top);
                n = bw_set_f(o, n, 38, 1.0);
            } else {
                if (hiz) {
                    n = bw_b(o, n, 1);
                    n = bw_pt(o, n, 7, a, mid);
                    n = bw_pt(o, n, 8, b, mid);
                    n = bw_b(o, n, 4);
                } else {
                    n = bw_b(o, n, 1);
                    n = bw_pt(o, n, 7, a, mid);
                    n = bw_pt(o, n, 8, a + k, top);
                    n = bw_pt(o, n, 8, b - k, top);
                    n = bw_pt(o, n, 8, b, mid);
                    n = bw_pt(o, n, 8, b - k, bot);
                    n = bw_pt(o, n, 8, a + k, bot);
                    n = bw_b(o, n, 2);
                    if (bad) { n = bw_set_s(o, n, 32, "rgba(255,77,109,0.18)"); } else { n = bw_set_s(o, n, 32, "rgba(0,255,136,0.05)"); }
                    n = bw_b(o, n, 3);
                    n = bw_b(o, n, 4);
                    var ll : u32 = put_label(D_LABEL[0..], 0, r, f + i);
                    const room : f64 = b - a - 2.0 * k - 6.0;
                    if (room > 8.0) {
                        var draw_it : bool = true;
                        var sx : u32 = 0;
                        var ellipsis : bool = false;
                        if (measure(11, D_LABEL[0..], ll) > room) {
                            // keep the low digits: drop leading units while the ellipsis and the rest do not fit
                            ellipsis = true;
                            var go : bool = true;
                            while (go) {
                                if (!(units_of(D_LABEL[(sx as usize)..], ll - sx) > 1)) {
                                    go = false;
                                } else {
                                    const cl : u32 = with_ellipsis(D_TMP[0..], D_LABEL[0..], sx, ll);
                                    const w : f64 = measure(11, D_TMP[0..], cl);
                                    if (X_MISS) { ask_suffixes(11, D_LABEL[0..], sx, ll); }
                                    if (!(w > room)) {
                                        go = false;
                                    } else {
                                        sx = sx + unit_len(D_LABEL[sx as usize]);
                                    }
                                }
                            }
                            const fl : u32 = with_ellipsis(D_TMP[0..], D_LABEL[0..], sx, ll);
                            if (measure(11, D_TMP[0..], fl) > room) { draw_it = false; }
                        }
                        if (draw_it) {
                            if (bad) { n = bw_color(o, n, 32, 2); } else { n = bw_color(o, n, 32, 3); }
                            n = bw_set_s(o, n, 37, "center");
                            if (ellipsis) {
                                const fl2 : u32 = with_ellipsis(D_TMP[0..], D_LABEL[0..], sx, ll);
                                n = bw_text(o, n, D_TMP[0..(fl2 as usize)], (a + b) / 2.0, mid + 0.5);
                            } else {
                                n = bw_text(o, n, D_LABEL[0..(ll as usize)], (a + b) / 2.0, mid + 0.5);
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return n;
}

// --- draw(): the diagram ----------------------------------------------------------------------------------------

pub var D_NAME : [1200]u8 = [0; 1200];
pub var D_VAL : [4300]u8 = [0; 4300];

/// Trim b[0..n) from the right by one unit at a time while it is longer than min_units and wider than limit, in the font
/// of px (`while (s.length > min && measureText(s).width > limit) s = s.slice(0, -1)`); the new length.
fn trim_right(px: u32, b: []u8, n0: u32, min_units: u32, limit: f64) -> u32 {
    var n : u32 = n0;
    var go : bool = true;
    while (go) {
        if (!(units_of(b, n) > min_units)) {
            go = false;
        } else {
            const w : f64 = measure(px, b, n);
            if (X_MISS) { ask_prefixes(px, b, n, min_units + 1); }
            if (w > limit) { n = drop_last(b, n); } else { go = false; }
        }
    }
    return n;
}

pub fn w_bdraw(o: []u8) -> u32 {
    if (W_PX == 0.0 or !CV_SET) { return 0; }
    MISSING = false;
    const dpr : f64 = dpr_now();
    var n : u32 = bw_b(o, 0, 200);
    n = bw_b(o, n, 0);
    n = bw_b(o, n, 12);
    n = bw_f(o, n, dpr);
    n = bw_f(o, n, 0.0);
    n = bw_f(o, n, 0.0);
    n = bw_f(o, n, dpr);
    n = bw_f(o, n, 0.0);
    n = bw_f(o, n, 0.0);
    n = bw_rect(o, n, 14, 0.0, 0.0, W_PX, H_PX);
    n = bw_color(o, n, 32, 9);
    n = bw_rect(o, n, 10, 0.0, 0.0, W_PX, H_PX);
    if (!HAVE) {
        if (n == OVER) { return 0; }
        return n;
    }
    const axis : f64 = K_AXIS_PX as f64;
    const row_px : f64 = K_ROW_PX as f64;
    const gx : f64 = gutter();
    const xr : f64 = gx + wave_w();
    const t0 : f64 = t_of(gx);
    const t1 : f64 = t_of(xr);
    // axis + grid
    const step : f64 = nice_step(90.0 / V_SCALE);
    if (MISSING) { return 0; }
    n = bw_font(o, n, 10);
    n = bw_set_s(o, n, 36, "middle");
    n = bw_set_s(o, n, 37, "left");
    var t : f64 = js_ceil(t0 / step) * step;
    var guard : u32 = 0;
    while (t <= t1 and step > 0.0 and guard < 100000) {
        const x : f64 = x_of(t);
        if (!(x < gx)) {
            n = bw_color(o, n, 33, 7);
            n = bw_set_f(o, n, 34, 1.0);
            n = bw_b(o, n, 1);
            n = bw_pt(o, n, 7, x + 0.5, axis);
            n = bw_pt(o, n, 8, x + 0.5, H_PX);
            n = bw_b(o, n, 4);
            n = bw_color(o, n, 33, 6);
            n = bw_b(o, n, 1);
            n = bw_pt(o, n, 7, x + 0.5, axis - 6.0);
            n = bw_pt(o, n, 8, x + 0.5, axis);
            n = bw_b(o, n, 4);
            n = bw_color(o, n, 32, 5);
            if (x + 4.0 < xr - 20.0) {
                const tl : u32 = put_time(D_TMP[0..], 0, t);
                n = bw_text(o, n, D_TMP[0..(tl as usize)], x + 3.0, axis / 2.0);
            }
        }
        t = t + step;
        guard = guard + 1;
    }
    n = bw_color(o, n, 33, 6);
    n = bw_b(o, n, 1);
    n = bw_pt(o, n, 7, 0.0, axis + 0.5);
    n = bw_pt(o, n, 8, W_PX, axis + 0.5);
    n = bw_b(o, n, 4);
    // check lines behind the waves
    const ch : f64 = checks_h();
    const dj : []const u8 = DEMO_JSON[0..(DJ_LEN as usize)];
    var k : u32 = 0;
    while (k < NCHECKS) {
        const x : f64 = x_of(CK_T[k as usize]);
        if (!(x < gx or x > xr)) {
            if (jv_truthy(dj, obj_get(dj, CK_SP[k as usize], "pass"))) { n = bw_set_s(o, n, 33, "rgba(0,255,136,0.28)"); } else { n = bw_set_s(o, n, 33, "rgba(255,77,109,0.6)"); }
            n = bw_b(o, n, 17);
            n = bw_b(o, n, 2);
            n = bw_f(o, n, 2.0);
            n = bw_f(o, n, 3.0);
            n = bw_b(o, n, 1);
            n = bw_pt(o, n, 7, x + 0.5, axis);
            n = bw_pt(o, n, 8, x + 0.5, H_PX - ch);
            n = bw_b(o, n, 4);
            n = bw_b(o, n, 17);
            n = bw_b(o, n, 0);
        }
        k = k + 1;
    }
    // rows
    const top : f64 = axis;
    const bottom : f64 = H_PX - ch;
    n = bw_b(o, n, 5);
    n = bw_b(o, n, 1);
    n = bw_rect(o, n, 15, 0.0, top, W_PX, bottom - top);
    n = bw_b(o, n, 16);
    var r : u32 = js_floor(V_Y / row_px) as u32;
    var stop : bool = false;
    while (r < NROWS and !stop) {
        const y0 : f64 = top + (r as f64) * row_px - V_Y;
        if (y0 > bottom) {
            stop = true;
        } else {
            const colour : u32 = role_color(R_ROLE[r as usize]);
            n = bw_set_s(o, n, 33, "rgba(0,255,136,0.06)");
            n = bw_b(o, n, 1);
            n = bw_pt(o, n, 7, 0.0, y0 + row_px + 0.5);
            n = bw_pt(o, n, 8, W_PX, y0 + row_px + 0.5);
            n = bw_b(o, n, 4);
            n = bw_set_s(o, n, 37, "left");
            n = bw_set_s(o, n, 36, "alphabetic");
            n = bw_font(o, n, 12);
            n = bw_color(o, n, 32, colour);
            // the name, cut from the right until it fits
            var nl : u32 = 0;
            var q : u32 = 0;
            while (q < R_SHORT_L[r as usize] and nl < 1190) {
                D_NAME[nl as usize] = L_NP[(R_SHORT_O[r as usize] + q) as usize];
                nl = nl + 1;
                q = q + 1;
            }
            const full_l : u32 = nl;
            nl = trim_right(12, D_NAME[0..], nl, 3, gx - 14.0);
            if (nl != full_l) {
                nl = drop_last(D_NAME[0..], nl);
                D_NAME[nl as usize] = 226;
                D_NAME[(nl + 1) as usize] = 128;
                D_NAME[(nl + 2) as usize] = 166;
                nl = nl + 3;
            }
            n = bw_text(o, n, D_NAME[0..(nl as usize)], 8.0, y0 + 15.0);
            if (R_WIDTH[r as usize] > 1.0) {
                const w : f64 = measure(12, D_NAME[0..], nl);
                var tg : u32 = copy_into(D_TMP[0..], 0, "[");
                tg = js_str_num(D_TMP[0..], tg, R_WIDTH[r as usize]);
                tg = copy_into(D_TMP[0..], tg, "]");
                n = bw_font(o, n, 9);
                n = bw_color(o, n, 32, 5);
                if (8.0 + w + 4.0 + measure(9, D_TMP[0..], tg) < gx - 4.0) { n = bw_text(o, n, D_TMP[0..(tg as usize)], 8.0 + w + 4.0, y0 + 15.0); }
            }
            if (CUR_ON) {
                const vi : i32 = value_at(r, CURSOR);
                if (vi >= 0) {
                    n = bw_font(o, n, 10);
                    n = bw_color(o, n, 32, 1);
                    const vk : u32 = vi as u32;
                    var sl : u32 = 0;
                    if (R_WIDTH[r as usize] == 1.0) {
                        sl = copy_into(D_VAL[0..], 0, L_VP[(L_VO[vk as usize] as usize)..((L_VO[vk as usize] + L_VL[vk as usize]) as usize)]);
                    } else {
                        if (R_REAL[r as usize] != 0 or R_SDEC[r as usize] != 0) {
                            sl = put_label(D_VAL[0..], 0, r, vk);
                        } else {
                            sl = copy_into(D_VAL[0..], 0, "0x");
                            sl = put_label(D_VAL[0..], sl, r, vk);
                        }
                    }
                    sl = trim_right(10, D_VAL[0..], sl, 2, gx - 14.0);
                    n = bw_text(o, n, D_VAL[0..(sl as usize)], 8.0, y0 + 29.0);
                }
            }
            n = bw_b(o, n, 5);
            n = bw_b(o, n, 1);
            n = bw_rect(o, n, 15, gx, y0, xr - gx, row_px);
            n = bw_b(o, n, 16);
            if (R_WIDTH[r as usize] == 1.0 and R_REAL[r as usize] == 0) {
                n = draw_bit(o, n, r, y0, colour, t0, t1);
            } else {
                n = draw_bus(o, n, r, y0, colour, t0, t1);
            }
            n = bw_b(o, n, 6);
            r = r + 1;
        }
    }
    n = bw_b(o, n, 6);
    // gutter edge
    n = bw_color(o, n, 33, 6);
    n = bw_b(o, n, 1);
    n = bw_pt(o, n, 7, gx - 0.5, axis);
    n = bw_pt(o, n, 8, gx - 0.5, H_PX);
    n = bw_b(o, n, 4);
    // checks row
    if (ch != 0.0) {
        const y0 : f64 = H_PX - ch;
        n = bw_color(o, n, 33, 6);
        n = bw_b(o, n, 1);
        n = bw_pt(o, n, 7, 0.0, y0 + 0.5);
        n = bw_pt(o, n, 8, W_PX, y0 + 0.5);
        n = bw_b(o, n, 4);
        n = bw_font(o, n, 12);
        n = bw_color(o, n, 32, 4);
        n = bw_set_s(o, n, 37, "left");
        n = bw_set_s(o, n, 36, "middle");
        n = bw_text(o, n, SAY_CHECKS_ROW, 8.0, y0 + ch / 2.0);
        var c : u32 = 0;
        while (c < NCHECKS) {
            const x : f64 = x_of(CK_T[c as usize]);
            if (!(x < gx - 1.0 or x > xr + 1.0)) {
                const picked : bool = (c as i32) == PICKED;
                const pass : bool = jv_truthy(dj, obj_get(dj, CK_SP[c as usize], "pass"));
                if (pass) { n = bw_color(o, n, 32, 0); } else { n = bw_color(o, n, 32, 2); }
                n = bw_b(o, n, 1);
                var s : f64 = 7.0;
                if (picked) { s = 9.0; }
                const cy : f64 = y0 + ch / 2.0;
                if (pass) {
                    n = bw_pt(o, n, 7, x - s, cy - s * 0.6);
                    n = bw_pt(o, n, 8, x + s, cy - s * 0.6);
                    n = bw_pt(o, n, 8, x, cy + s * 0.8);
                } else {
                    n = bw_pt(o, n, 7, x - s, cy - s);
                    n = bw_pt(o, n, 8, x + s, cy + s);
                    n = bw_pt(o, n, 7, x + s, cy - s);
                    n = bw_pt(o, n, 8, x - s, cy + s);
                }
                if (pass) {
                    n = bw_b(o, n, 3);
                } else {
                    n = bw_color(o, n, 33, 2);
                    n = bw_set_f(o, n, 34, 2.5);
                    n = bw_b(o, n, 4);
                    n = bw_set_f(o, n, 34, 1.0);
                }
                if (jv_is(dj, obj_get(dj, CK_SP[c as usize], "source"), "testbench")) {
                    n = bw_color(o, n, 33, 1);
                    n = bw_set_f(o, n, 34, 1.0);
                    n = bw_b(o, n, 1);
                    n = bw_b(o, n, 18);
                    n = bw_f(o, n, x);
                    n = bw_f(o, n, cy);
                    n = bw_f(o, n, s + 3.0);
                    n = bw_f(o, n, 0.0);
                    n = bw_f(o, n, W_PI2);
                    n = bw_b(o, n, 4);
                }
            }
            c = c + 1;
        }
    }
    // cursor
    if (CUR_ON) {
        const x : f64 = x_of(CURSOR);
        if (x >= gx and x <= xr) {
            n = bw_color(o, n, 33, 1);
            n = bw_set_f(o, n, 34, 1.0);
            n = bw_b(o, n, 1);
            n = bw_pt(o, n, 7, x + 0.5, axis);
            n = bw_pt(o, n, 8, x + 0.5, H_PX);
            n = bw_b(o, n, 4);
            var tb : [160]u8 = [0; 160];
            const tl : u32 = put_time(tb[0..], 0, CURSOR);
            var vb : [400]u8 = [0; 400];
            const vn : u32 = jv_vput_str(vb[0..], 0, "t", tb[0..(tl as usize)]);
            var lb : [400]u8 = [0; 400];
            var ll : u32 = jv_fill_raw(lb[0..], 0, SAY_CURSOR, vb[0..], vn, false);
            if (ll == OVER) { ll = 0; }
            n = bw_font(o, n, 10);
            const w : f64 = measure(10, lb[0..], ll) + 10.0;
            const lx : f64 = js_min(xr - w, js_max(gx, x - w / 2.0));
            n = bw_color(o, n, 32, 1);
            n = bw_rect(o, n, 10, lx, 3.0, w, axis - 8.0);
            n = bw_color(o, n, 32, 9);
            n = bw_set_s(o, n, 37, "left");
            n = bw_set_s(o, n, 36, "middle");
            n = bw_text(o, n, lb[0..(ll as usize)], lx + 5.0, axis / 2.0 - 1.0);
        }
    }
    if (n == OVER) { return 0; }
    return n;
}

// --- events: pick, pointers, wheel, keys, buttons, files, the demo --------------------------------------------------

fn pointer_index(id: i64) -> i32 {
    var i : u32 = 0;
    while (i < PT_N) {
        if (PT_ID[i as usize] == id) { return i as i32; }
        i = i + 1;
    }
    return 0 - 1;
}

fn pointer_set(id: i64, x: f64, y: f64) -> u32 {
    const k : i32 = pointer_index(id);
    if (k >= 0) {
        PT_X[k as usize] = x;
        PT_Y[k as usize] = y;
        return 0;
    }
    if (PT_N < 16) {
        PT_ID[PT_N as usize] = id;
        PT_X[PT_N as usize] = x;
        PT_Y[PT_N as usize] = y;
        PT_N = PT_N + 1;
    }
    return 0;
}

fn pointer_delete(id: i64) -> u32 {
    const k : i32 = pointer_index(id);
    if (k < 0) { return 0; }
    var i : u32 = k as u32;
    while (i + 1 < PT_N) {
        PT_ID[i as usize] = PT_ID[(i + 1) as usize];
        PT_X[i as usize] = PT_X[(i + 1) as usize];
        PT_Y[i as usize] = PT_Y[(i + 1) as usize];
        i = i + 1;
    }
    PT_N = PT_N - 1;
    return 0;
}

/// pick(p): a tap.
fn pick(px: f64, py: f64) -> u32 {
    if (!HAVE) { return 0; }
    const gx : f64 = gutter();
    const ch : f64 = checks_h();
    const axis : f64 = K_AXIS_PX as f64;
    const dj : []const u8 = DEMO_JSON[0..(DJ_LEN as usize)];
    if (ch != 0.0 and py >= H_PX - ch) {
        var best : i32 = 0 - 1;
        var bd : f64 = js_max(16.0, (K_MIN_TARGET_PX as f64) / 2.0);
        var c : u32 = 0;
        while (c < NCHECKS) {
            var dd : f64 = x_of(CK_T[c as usize]) - px;
            if (dd < 0.0) { dd = 0.0 - dd; }
            if (dd <= bd) {
                bd = dd;
                best = c as i32;
            }
            c = c + 1;
        }
        if (best >= 0) {
            const b : u32 = best as u32;
            const ce : i64 = CK_SP[b as usize];
            PICKED = best;
            CURSOR = CK_T[b as usize];
            CUR_ON = true;
            var vb : [8192]u8 = [0; 8192];
            var vn : u32 = jv_vput_val(vb[0..], 0, "name", dj, obj_get(dj, ce, "name"));
            if (jv_is(dj, obj_get(dj, ce, "source"), "spec")) { vn = jv_vput_str(vb[0..], vn, "source", SAY_FROM_SPEC); } else { vn = jv_vput_str(vb[0..], vn, "source", SAY_FROM_TB); }
            const pass : bool = jv_truthy(dj, obj_get(dj, ce, "pass"));
            if (pass) { vn = jv_vput_str(vb[0..], vn, "verdict", SAY_PASS); } else { vn = jv_vput_str(vb[0..], vn, "verdict", SAY_FAIL); }
            var tb : [160]u8 = [0; 160];
            const tl : u32 = put_time(tb[0..], 0, CK_T[b as usize]);
            vn = jv_vput_str(vb[0..], vn, "t", tb[0..(tl as usize)]);
            vn = jv_vput_val(vb[0..], vn, "acc", dj, obj_get(dj, ce, "acc"));
            vn = jv_vput_val(vb[0..], vn, "expected", dj, obj_get(dj, ce, "expected"));
            ST_LEN = 0;
            if (vn != OVER) {
                const l : u32 = jv_fill_raw(ST_TXT[0..], 0, SAY_CHECK_LINE, vb[0..], vn, false);
                if (l != OVER) { ST_LEN = l; }
            }
            if (pass) { ST_CLS = 1; } else { ST_CLS = 2; }
            return 0;
        }
    }
    if (px >= gx) { CURSOR = js_max(0.0, js_min(D_END, t_of(px))); }
    const rr : f64 = js_floor((py - axis + V_Y) / (K_ROW_PX as f64));
    if (py > axis and py < H_PX - ch and rr >= 0.0 and rr < (NROWS as f64)) {
        const r : u32 = rr as u32;
        if (CUR_ON) {
            var vb : [8192]u8 = [0; 8192];
            var vn : u32 = jv_vput_str(vb[0..], 0, "name", L_NP[(R_NAME_O[r as usize] as usize)..((R_NAME_O[r as usize] + R_NAME_L[r as usize]) as usize)]);
            var wb : [32]u8 = [0; 32];
            const wl : u32 = js_str_num(wb[0..], 0, R_WIDTH[r as usize]);
            vn = jv_vput_str(vb[0..], vn, "width", wb[0..(wl as usize)]);
            var xb : [4300]u8 = [0; 4300];
            const xl : u32 = put_value_text(xb[0..], 0, r, value_at(r, CURSOR));
            vn = jv_vput_str(vb[0..], vn, "value", xb[0..(xl as usize)]);
            var tb : [160]u8 = [0; 160];
            const tl : u32 = put_time(tb[0..], 0, CURSOR);
            vn = jv_vput_str(vb[0..], vn, "t", tb[0..(tl as usize)]);
            ST_LEN = 0;
            if (vn != OVER) {
                const l : u32 = jv_fill_raw(ST_TXT[0..], 0, SAY_SIGNAL_LINE, vb[0..], vn, false);
                if (l != OVER) { ST_LEN = l; }
            }
            ST_CLS = 0;
        }
    }
    return 0;
}

pub fn w_cpointer(kind_of: u32, id: i64, x: f64, y: f64, mouse: u32) -> u32 {
    EF_N = 0;
    if (kind_of == 0) {
        pointer_set(id, x, y);
        if (PT_N == 1) {
            DR_ON = true;
            DR_SX = x;
            DR_SY = y;
            DR_LX = x;
            DR_LY = y;
            DR_MOVED = false;
        } else {
            if (PT_N == 2 and HAVE) {
                const mx : f64 = (PT_X[0] + PT_X[1]) / 2.0;
                var dist : f64 = hypot2(PT_X[0] - PT_X[1], PT_Y[0] - PT_Y[1]);
                if (dist == 0.0 or dist != dist) { dist = 1.0; }
                PI_ON = true;
                PI_DIST = dist;
                PI_SCALE = V_SCALE;
                PI_T = t_of(mx);
                DR_ON = false;
            }
        }
        return 0;
    }
    if (kind_of == 1) {
        if (pointer_index(id) >= 0) { pointer_set(id, x, y); }
        if (!HAVE) { return 0; }
        if (PI_ON and PT_N >= 2) {
            const mx : f64 = (PT_X[0] + PT_X[1]) / 2.0;
            V_SCALE = PI_SCALE * (hypot2(PT_X[0] - PT_X[1], PT_Y[0] - PT_Y[1]) / PI_DIST);
            clamp_view();
            V_T0 = PI_T - (mx - gutter()) / V_SCALE;
            clamp_view();
            return 0;
        }
        if (DR_ON) {
            const dx : f64 = x - DR_LX;
            const dy : f64 = y - DR_LY;
            if (!DR_MOVED and hypot2(x - DR_SX, y - DR_SY) > 6.0) { DR_MOVED = true; }
            if (DR_MOVED) {
                V_T0 = V_T0 - dx / V_SCALE;
                V_Y = V_Y - dy;
                clamp_view();
            }
            DR_LX = x;
            DR_LY = y;
            return 0;
        }
        if (mouse != 0 and x >= gutter() and y > (K_AXIS_PX as f64) and y < H_PX - checks_h()) {
            CURSOR = js_max(0.0, js_min(D_END, t_of(x)));
            CUR_ON = true;
        }
        return 0;
    }
    if (kind_of == 2 or kind_of == 3) {
        pointer_delete(id);
        if (PI_ON and PT_N < 2) {
            PI_ON = false;
            DR_ON = false;
            return 0;
        }
        if (DR_ON and !DR_MOVED and kind_of == 2) { pick(x, y); }
        if (PT_N == 0) { DR_ON = false; }
    }
    return 0;
}

/// The wheel: bit 0 tool.js calls preventDefault, bit 1 (2) a libm answer is missing: call again.
pub fn w_wheel2(x: f64, y: f64, dx: f64, dy: f64, ctrl: u32, shift: u32, meta: u32) -> u32 {
    EF_N = 0;
    if (!HAVE) { return 0; }
    MISSING = false;
    if (ctrl != 0 or meta != 0) {
        const e : f64 = libm2(16, (0.0 - dy) * 0.01, 0.0);
        if (MISSING) { return 2; }
        zoom_by(e, js_max(gutter(), x), false);
        return 1;
    }
    var ax : f64 = dx;
    if (ax < 0.0) { ax = 0.0 - ax; }
    var ay : f64 = dy;
    if (ay < 0.0) { ay = 0.0 - ay; }
    if (shift != 0 or ax > ay) {
        var amt : f64 = dx;
        if (shift != 0) {
            if (dy != 0.0 and dy == dy) { amt = dy; } else { amt = dx; }
        }
        V_T0 = V_T0 + amt / V_SCALE;
        clamp_view();
        return 1;
    }
    const content : f64 = (NROWS as f64) * (K_ROW_PX as f64);
    if (content > rows_h()) {
        const before : f64 = V_Y;
        V_Y = V_Y + dy;
        clamp_view();
        if (V_Y != before) { return 1; }
    }
    return 0;
}

pub fn w_key(key: []const u8) -> u32 {
    EF_N = 0;
    if (!HAVE) { return 0; }
    const step : f64 = wave_w() / V_SCALE / 10.0;
    if (word_is(key, "+") or word_is(key, "=")) {
        zoom_by(1.6, 0.0, true);
    } else {
        if (word_is(key, "-")) {
            zoom_by(1.0 / 1.6, 0.0, true);
        } else {
            if (word_is(key, "ArrowLeft")) {
                V_T0 = V_T0 - step;
                clamp_view();
            } else {
                if (word_is(key, "ArrowRight")) {
                    V_T0 = V_T0 + step;
                    clamp_view();
                } else {
                    if (word_is(key, "ArrowUp")) {
                        V_Y = V_Y - (K_ROW_PX as f64);
                        clamp_view();
                    } else {
                        if (word_is(key, "ArrowDown")) {
                            V_Y = V_Y + (K_ROW_PX as f64);
                            clamp_view();
                        } else {
                            if (word_is(key, "0")) {
                                fit();
                            } else {
                                return 0;
                            }
                        }
                    }
                }
            }
        }
    }
    return 1;
}

pub fn w_box(w: f64, h: f64) -> u32 {
    EF_N = 0;
    relayout();
    return 1;
}

pub fn w_winresize() -> u32 {
    EF_N = 0;
    relayout();
    return 0;
}

pub fn w_dclick() -> u32 {
    EF[0] = 105;
    EF_N = 1;
    return 0;
}

pub fn w_dkey(key: []const u8) -> u32 {
    EF_N = 0;
    if (word_is(key, "Enter") or word_is(key, " ")) {
        EF[0] = 105;
        EF_N = 1;
        return 1;
    }
    return 0;
}

pub fn w_drag(kind_of: u32) -> u32 {
    EF_N = 0;
    const was : bool = OVER_ON;
    OVER_ON = kind_of == 0;
    if (was != OVER_ON) { return 1; }
    return 0;
}

pub fn w_drag_related() -> u32 {
    return 1;
}

pub fn w_drag_sel(dst: []u8) -> u32 {
    return copy_into(dst, 0, W_AREA_SEL);
}

pub fn w_rect_sel(dst: []u8) -> u32 {
    return copy_into(dst, 0, W_STAGE_SEL);
}

pub fn w_rect(w: f64, h: f64) -> u32 {
    RECT_W = w;
    RECT_H = h;
    return 0;
}

pub fn w_view(width: f64, dpr: f64, embed: u32, ih: f64, bw: f64) -> u32 {
    ENV_W = width;
    ENV_DPR = dpr;
    ENV_EMBED = embed;
    ENV_IH = ih;
    ENV_BW = bw;
    return 0;
}

pub fn w_canvas_keep() -> u32 {
    return 1;
}

pub fn w_draw_cap() -> u32 {
    return W_DRAW_CAP;
}

pub fn w_file_cap() -> u32 {
    return W_FILE_CAP;
}

pub fn w_value(i: u32, dst: []u8) -> u32 {
    if (i == 0 and CLR_FILE) {
        CLR_FILE = false;
        return 0;
    }
    return 4294967295;
}

pub fn w_click(i: u32) -> u32 {
    EF_N = 0;
    if (i == 0) {
        load_demo();
        return 0;
    }
    if (i == 1) {
        EF[0] = 105;
        EF_N = 1;
        return 0;
    }
    if (i == 2) { return zoom_by(1.0 / 1.6, 0.0, true); }
    if (i == 3) { return zoom_by(1.6, 0.0, true); }
    if (i == 4) {
        fit();
    }
    return 0;
}

pub fn w_effect(k: u32, dst: []u8) -> u32 {
    if (k >= EF_N) {
        EF_N = 0;
        return 0;
    }
    dst[0] = 105;
    return 1;
}

/// A file: readFile(file).
pub fn w_file(name: []const u8, size: f64, data: []const u8, st: u32) -> u32 {
    EF_N = 0;
    CLR_FILE = true;
    var vb : [4096]u8 = [0; 4096];
    var vn : u32 = jv_vput_str(vb[0..], 0, "name", name);
    if (size > (W_FILE_MB as f64) * 1048576.0) {
        var mb : [64]u8 = [0; 64];
        const ml : u32 = js_to_fixed(mb[0..], 0, size / 1048576.0, 1);
        vn = jv_vput_str(vb[0..], vn, "mb", mb[0..(ml as usize)]);
        vn = pool_u32(vb[0..], vn, "max", W_FILE_MB as u64);
        show_error_fill(SAY_ERR_TOO_BIG, vb[0..], vn);
        return 0;
    }
    if (st != 0) {
        vn = jv_vput_str(vb[0..], vn, "why", "");
        show_error_fill(SAY_ERR_VCD, vb[0..], vn);
        return 0;
    }
    const e : u32 = parse_vcd(data);
    if (e != 0) {
        if (e == 5) {
            var mb : [64]u8 = [0; 64];
            const ml : u32 = js_to_fixed(mb[0..], 0, size / 1048576.0, 1);
            vn = jv_vput_str(vb[0..], vn, "mb", mb[0..(ml as usize)]);
            vn = pool_u32(vb[0..], vn, "max", W_FILE_MB as u64);
            show_error_fill(SAY_ERR_TOO_BIG, vb[0..], vn);
            return 0;
        }
        var why : [1024]u8 = [0; 1024];
        const wl : u32 = put_vcd_error(why[0..], 0);
        vn = jv_vput_str(vb[0..], vn, "why", why[0..(wl as usize)]);
        show_error_fill(SAY_ERR_VCD, vb[0..], vn);
        return 0;
    }
    if (!set_data(false, name)) {
        var mb : [64]u8 = [0; 64];
        const ml : u32 = js_to_fixed(mb[0..], 0, size / 1048576.0, 1);
        vn = jv_vput_str(vb[0..], vn, "mb", mb[0..(ml as usize)]);
        vn = pool_u32(vb[0..], vn, "max", W_FILE_MB as u64);
        show_error_fill(SAY_ERR_TOO_BIG, vb[0..], vn);
    }
    return 0;
}

// --- the demo ---------------------------------------------------------------------------------------------------

fn demo_json_ok(d: []const u8) -> bool {
    const r : i64 = root(d);
    if (kind(d, r) != J_OBJECT) { return false; }
    const spec : i64 = obj_get(d, r, "spec");
    const tools : i64 = obj_get(d, r, "tools");
    const sm : i64 = obj_get(d, r, "summary");
    if (!present(d, spec) or !present(d, tools) or !present(d, obj_get(d, r, "compiler")) or !present(d, obj_get(d, r, "testbench"))) { return false; }
    const sk : u8 = kind(d, sm);
    if (sk != J_OBJECT and sk != J_ARRAY) { return false; }
    if (kind(d, obj_get(d, r, "vectors")) != J_ARRAY or kind(d, obj_get(d, r, "commands")) != J_ARRAY) { return false; }
    const sg : i64 = obj_get(d, r, "signals");
    if (jv_truthy(d, sg) and kind(d, sg) != J_ARRAY) { return false; }
    if (kind(d, sg) == J_ARRAY) {
        const hi : usize = span_hi(sg);
        var p : usize = skip_ws(d, span_lo(sg) + 1);
        while (p < hi and d[p] != 93) {
            const e : usize = value_end(d, p);
            if (kind(d, jspan(p, e)) == J_NULL) { return false; }
            p = skip_ws(d, e);
            if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
        }
    }
    const ck : i64 = obj_get(d, r, "checks");
    if (jv_truthy(d, ck) and kind(d, ck) != J_ARRAY) { return false; }
    if (kind(d, ck) == J_ARRAY) {
        const hi : usize = span_hi(ck);
        var p : usize = skip_ws(d, span_lo(ck) + 1);
        while (p < hi and d[p] != 93) {
            const e : usize = value_end(d, p);
            if (kind(d, jspan(p, e)) == J_NULL) { return false; }
            p = skip_ws(d, e);
            if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
        }
    }
    return true;
}

/// loadDemo(), once demo.vcd and demo.json have both answered.
fn load_demo() -> u32 {
    ST_LEN = copy_into(ST_TXT[0..], 0, SAY_LOADING);
    ST_CLS = 0;
    if (GOT[0] == 0 or GOT[1] == 0) { return 0; }
    if (GOT[0] != 1 or GOT[1] != 1) {
        var code : u32 = GOT_STATUS[0];
        if (GOT[0] == 1) { code = GOT_STATUS[1]; }
        var sb : [32]u8 = [0; 32];
        var sl : u32 = copy_into(sb[0..], 0, "HTTP ");
        sl = sl + dec_to(sb[(sl as usize)..], code as u64);
        if (GOT[0] == 3 or GOT[1] == 3) { sl = 0; }
        show_demo_error(sb[0..(sl as usize)]);
        return 0;
    }
    const dj : []const u8 = DEMO_JSON[0..(DJ_LEN as usize)];
    if (!jv_valid(dj) or !demo_json_ok(dj)) {
        show_demo_error("");
        return 0;
    }
    const e : u32 = parse_vcd(DEMO_VCD[0..(DV_LEN as usize)]);
    if (e != 0) {
        if (e == 5) {
            show_demo_error("");
            return 0;
        }
        var why : [1024]u8 = [0; 1024];
        const wl : u32 = put_vcd_error(why[0..], 0);
        show_demo_error(why[0..(wl as usize)]);
        return 0;
    }
    if (!set_data(true, "")) { show_demo_error(""); }
    return 0;
}

pub fn w_data(i: u32, s: []const u8) -> u32 {
    EF_N = 0;
    if (i > 1) { return 0; }
    var cap : u32 = W_DEMO_CAP;
    if (i == 1) { cap = W_JSON_CAP; }
    if (s.len > (cap as usize)) {
        GOT[i as usize] = 3;
    } else {
        var k : usize = 0;
        while (k < s.len) {
            if (i == 0) { DEMO_VCD[k] = s[k]; } else { DEMO_JSON[k] = s[k]; }
            k = k + 1;
        }
        if (i == 0) { DV_LEN = s.len as u32; } else { DJ_LEN = s.len as u32; }
        GOT[i as usize] = 1;
    }
    if (GOT[0] != 0 and GOT[1] != 0) { load_demo(); }
    return 0;
}

pub fn w_data_failed(i: u32, status: u32) -> u32 {
    EF_N = 0;
    if (i > 1) { return 0; }
    GOT[i as usize] = 2;
    GOT_STATUS[i as usize] = status;
    if (GOT[0] != 0 and GOT[1] != 0) { load_demo(); }
    return 0;
}

pub fn w_init(h: []const u8) -> u32 {
    IS_EMBED = ENV_EMBED != 0;
    HAVE = false;
    IS_DEMO = false;
    OVER_ON = false;
    PRESSED = true;
    W_PX = 0.0;
    H_PX = 0.0;
    CV_SET = false;
    V_T0 = 0.0;
    V_SCALE = 1.0;
    V_Y = 0.0;
    CUR_ON = false;
    PICKED = 0 - 1;
    NROWS = 0;
    NCHECKS = 0;
    PT_N = 0;
    DR_ON = false;
    PI_ON = false;
    EF_N = 0;
    CLR_FILE = false;
    GOT[0] = 0;
    GOT[1] = 0;
    ST_LEN = copy_into(ST_TXT[0..], 0, SAY_LOADING);
    ST_CLS = 0;
    SRC_LEN = 0;
    return 0;
}

// --- the page --------------------------------------------------------------------------------------------------

/// One bar button: <button type class title aria-label [aria-pressed]>label</button>.
fn put_button(o: []u8, n0: u32, label: []const u8, title: []const u8, pressed: u32) -> u32 {
    var n : u32 = raw(o, n0, "<button type=\"button\" class=\"t27-btn\"");
    n = attr(o, n, "title", title);
    n = attr(o, n, "aria-label", title);
    if (pressed == 1) { n = raw(o, n, " aria-pressed=\"true\""); }
    if (pressed == 2) { n = raw(o, n, " aria-pressed=\"false\""); }
    n = raw(o, n, ">");
    n = text(o, n, label);
    return raw(o, n, "</button>");
}

/// String(v) of the JSON value, or the template literal of it: "undefined" for a missing value.
fn put_val(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    return jv_text(o, n0, d, sp);
}

/// el(tag, {text: v}) with `vals[n] ?? ''`: missing and null give no text.
fn put_opt(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    if (!present(d, sp)) { return n0; }
    return jv_text(o, n0, d, sp);
}

fn put_prov(o: []u8, n0: u32) -> u32 {
    const d : []const u8 = DEMO_JSON[0..(DJ_LEN as usize)];
    const r : i64 = root(d);
    const spec : i64 = obj_get(d, r, "spec");
    const comp : i64 = obj_get(d, r, "compiler");
    const tools : i64 = obj_get(d, r, "tools");
    const tb : i64 = obj_get(d, r, "testbench");
    var n : u32 = raw(o, n0, "<summary>");
    n = text(o, n, SAY_PROVENANCE);
    n = raw(o, n, "</summary><dl>");
    var k : u32 = 0;
    while (k < 8) {
        n = raw(o, n, "<dt>");
        n = text(o, n, SAY_PROV_KEYS[k as usize]);
        n = raw(o, n, "</dt><dd>");
        if (k == 0) { n = put_opt(o, n, d, obj_get(d, spec, "path")); }
        if (k == 1) { n = put_opt(o, n, d, obj_get(d, spec, "sha256")); }
        if (k == 2) { n = put_opt(o, n, d, obj_get(d, comp, "path")); }
        if (k == 3) { n = put_opt(o, n, d, obj_get(d, comp, "sha256")); }
        if (k == 4) { n = put_opt(o, n, d, obj_get(d, r, "verilog_sha256")); }
        if (k == 5) {
            n = put_val(o, n, d, obj_get(d, tb, "path"));
            n = raw(o, n, " (");
            n = put_val(o, n, d, obj_get(d, tb, "sha256"));
            n = raw(o, n, ")");
        }
        if (k == 6) { n = put_opt(o, n, d, obj_get(d, tools, "iverilog")); }
        if (k == 7) { n = put_opt(o, n, d, obj_get(d, tools, "vvp")); }
        n = raw(o, n, "</dd>");
        k = k + 1;
    }
    n = raw(o, n, "</dl><h4>");
    n = text(o, n, SAY_VECTORS);
    n = raw(o, n, "</h4><ul>");
    const vs : i64 = obj_get(d, r, "vectors");
    var hi : usize = span_hi(vs);
    var p : usize = skip_ws(d, span_lo(vs) + 1);
    while (p < hi and d[p] != 93) {
        const e : usize = value_end(d, p);
        const v : i64 = jspan(p, e);
        n = raw(o, n, "<li>");
        n = put_val(o, n, d, obj_get(d, v, "test"));
        n = raw(o, n, ": a = ");
        n = put_val(o, n, d, obj_get(d, v, "a"));
        n = raw(o, n, ", b = ");
        n = put_val(o, n, d, obj_get(d, v, "b"));
        n = raw(o, n, ", dot27 = ");
        n = put_val(o, n, d, obj_get(d, v, "dot"));
        n = raw(o, n, "</li>");
        p = skip_ws(d, e);
        if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
    }
    n = raw(o, n, "</ul><h4>");
    n = text(o, n, SAY_COMMANDS);
    n = raw(o, n, "</h4><pre>");
    // commands.join('\\n'); a text that starts with a line feed needs one more in markup
    const cm : i64 = obj_get(d, r, "commands");
    hi = span_hi(cm);
    p = skip_ws(d, span_lo(cm) + 1);
    var idx : u32 = 0;
    while (p < hi and d[p] != 93) {
        const e : usize = value_end(d, p);
        const c : i64 = jspan(p, e);
        if (idx == 0) {
            var first : [8]u8 = [0; 8];
            const fl : u32 = str_head(first[0..], d, c);
            if (fl > 0 and first[0] == 10) { n = put(o, n, 10); }
            if (fl == 0 and has_more(d, p, hi, e)) { n = put(o, n, 10); }
        }
        if (idx > 0) { n = put(o, n, 10); }
        n = put_opt(o, n, d, c);
        idx = idx + 1;
        p = skip_ws(d, e);
        if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
    }
    return raw(o, n, "</pre>");
}

/// The first byte of String(v) of the JSON value (0 or 1 byte).
fn str_head(o: []u8, d: []const u8, sp: i64) -> u32 {
    var tmp : [8]u8 = [0; 8];
    if (!present(d, sp)) { return 0; }
    var big : [1100]u8 = [0; 1100];
    const l : u32 = jv_str(big[0..], 0, d, sp);
    if (l == OVER or l == 0) { return 0; }
    o[0] = big[0];
    return 1;
}

/// Is there another element after the one ending at e (so that join adds a line feed first)?
fn has_more(d: []const u8, p0: usize, hi: usize, e: usize) -> bool {
    const q : usize = skip_ws(d, e);
    return q < hi and d[q] == 44;
}

pub fn w_render(dst: []u8) -> u32 {
    var n : u32 = raw(dst, 0, "<div class=\"tw");
    if (IS_EMBED) { n = raw(dst, n, " tw-embed"); }
    n = raw(dst, n, "\"><div class=\"tw-bar\">");
    n = put_button(dst, n, SAY_DEMO, SAY_DEMO_TITLE, if_pressed(PRESSED));
    n = put_button(dst, n, SAY_DROP_SHORT, SAY_DROP, 0);
    n = raw(dst, n, "<button type=\"button\" class=\"t27-btn\"");
    n = attr(dst, n, "title", SAY_ZOOM_OUT);
    n = attr(dst, n, "aria-label", SAY_ZOOM_OUT);
    n = raw(dst, n, ">");
    n = put(dst, n, 226);
    n = put(dst, n, 136);
    n = put(dst, n, 146);
    n = raw(dst, n, "</button>");
    n = put_button(dst, n, "+", SAY_ZOOM_IN, 0);
    n = put_button(dst, n, SAY_FIT, SAY_FIT_TITLE, 0);
    n = raw(dst, n, "<span class=\"tw-hint\">");
    n = text(dst, n, SAY_HINT);
    n = raw(dst, n, "</span></div><div class=\"tw-stage");
    if (OVER_ON) { n = raw(dst, n, " is-over"); }
    n = raw(dst, n, "\"><canvas class=\"tw-canvas\" tabindex=\"0\" role=\"img\"");
    n = attr(dst, n, "aria-label", SAY_CANVAS_LABEL);
    if (CV_SET) {
        n = raw(dst, n, " width=\"");
        n = num(dst, n, CV_W);
        n = raw(dst, n, "\" height=\"");
        n = num(dst, n, CV_H);
        n = raw(dst, n, "\" style=\"width: ");
        n = num(dst, n, CV_SW);
        n = raw(dst, n, "px; height: ");
        n = num(dst, n, CV_SHT);
        n = raw(dst, n, "px;\"");
    }
    n = raw(dst, n, "></canvas></div><p class=\"tw-status");
    if (ST_CLS == 1) { n = raw(dst, n, " is-pass"); }
    if (ST_CLS == 2) { n = raw(dst, n, " is-fail"); }
    n = raw(dst, n, "\" aria-live=\"polite\">");
    n = text(dst, n, ST_TXT[0..(ST_LEN as usize)]);
    n = raw(dst, n, "</p><p class=\"tw-source\">");
    n = text(dst, n, SRC_TXT[0..(SRC_LEN as usize)]);
    n = raw(dst, n, "</p><div class=\"t27-drop tw-drop");
    if (OVER_ON) { n = raw(dst, n, " is-over"); }
    n = raw(dst, n, "\" role=\"button\" tabindex=\"0\">");
    n = text(dst, n, SAY_DROP);
    n = raw(dst, n, "</div><details class=\"tw-prov\"");
    if (HAVE and !IS_DEMO) { n = raw(dst, n, " hidden=\"\""); }
    n = raw(dst, n, ">");
    if (HAVE and IS_DEMO) { n = put_prov(dst, n); }
    n = raw(dst, n, "</details><input type=\"file\" accept=\".vcd,text/plain\" hidden=\"\"></div>");
    if (n == OVER) { return 0; }
    return n;
}

fn if_pressed(p: bool) -> u32 {
    if (p) { return 1; }
    return 2;
}

pub fn same_text(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// --- Tests of the native page ------------------------------------------------------------------------------

pub const W_TEST_VCD : str = "$timescale 1ns $end $scope module top $end $var wire 1 ! clk $end $var wire 8 \" bus [7:0] $end $upscope $end $enddefinitions $end #0 0! b00000101 \" #10 1! b11111111 \" #20 0!";

fn w_has(o: []const u8, n: u32, want: []const u8) -> bool {
    if (want.len > (n as usize)) { return false; }
    var i : usize = 0;
    while (i + want.len <= (n as usize)) {
        var k : usize = 0;
        while (k < want.len and o[i + k] == want[k]) { k = k + 1; }
        if (k == want.len) { return true; }
        i = i + 1;
    }
    return false;
}

fn open_tiny() -> u32 {
    RQ_N = 0;
    RQ_SENT = 0;
    LB_N = 0;
    X_N = 0;
    X_POOL_N = 0;
    w_view(800.0, 1.0, 0, 768.0, 0.0);
    w_init("");
    w_rect(602.0, 300.0);
    parse_vcd(W_TEST_VCD);
    set_data(false, "x.vcd");
    return 0;
}

test the_parser_reads_scalars_vectors_scopes_and_the_timescale {
    assert parse_vcd(W_TEST_VCD) == 0;
    assert P_VN == 2;
    assert P_NSIG == 2;
    assert PC_N == 5;
    assert P_UEXP == 0 - 9;
    assert P_UMUL == 1.0;
    assert P_END == 20.0;
    assert PV_NAME_L[0] == 7;
    assert PV_NAME_L[1] == 7;
    assert PV_WIDTH[1] == 8.0;
}

test the_parser_refuses_what_tool_js_refuses_in_the_same_order {
    assert parse_vcd("") == 1;
    assert parse_vcd("$timescale 5 xs $end $enddefinitions $end") == 2;
    assert parse_vcd("$enddefinitions $end #5 q") == 3;
    assert ERR_TOKEN_LEN == 1;
    assert ERR_TIME == 5.0;
    assert parse_vcd("$timescale 1ns $end $var wire 1 ! a $end $enddefinitions $end #1") == 4;
    assert parse_vcd("$var wire 1 ! a $end $enddefinitions $end #1e400 0!") == 3;
    assert parse_vcd("$var wire 1 ! a $end $enddefinitions $end #0x10 1!") == 0;
    assert P_END == 16.0;
}

test a_value_at_the_same_time_replaces_and_a_repeat_is_dropped {
    assert parse_vcd("$var wire 1 ! a $end $enddefinitions $end #0 0! #0 1! #5 1! #6 0!") == 0;
    assert PC_N == 2;
    assert P_VP[PC_VO[0]] == 49;
    assert P_VP[PC_VO[1]] == 48;
    assert PC_T[1] == 6.0;
}

test one_code_with_two_names_is_an_alias_with_the_same_changes {
    assert parse_vcd("$var wire 1 ! a $end $var wire 1 ! b $end $var wire 1 ! a $end $enddefinitions $end #0 1!") == 0;
    assert P_VN == 2;
    assert PV_CANON[1] == 0;
    assert P_NSIG == 2;
}

test the_rows_are_copied_named_and_given_a_role {
    open_tiny();
    assert NROWS == 2;
    assert D_TOTAL == 2;
    assert R_SHORT_L[0] == 3;
    assert R_SHORT_L[1] == 3;
    assert R_ROLE[0] == 1;
    assert R_ROLE[1] == 2;
    assert R_N[0] == 3;
    assert R_N[1] == 2;
    assert CURSOR == 8.0;
    assert !PRESSED;
}

test values_read_as_hex_decimal_and_signed {
    open_tiny();
    var o : [256]u8 = [0; 256];
    var n : u32 = put_value_text(o[0..], 0, 1, value_at(1, 10.0));
    assert w_has(o[0..], n, "0xff = 255 / -1");
    n = put_value_text(o[0..], 0, 1, value_at(1, 0.0));
    assert w_has(o[0..], n, "0x05 = 5");
    n = put_value_text(o[0..], 0, 0, value_at(0, 10.0));
    assert n == 1;
    assert o[0] == 49;
    n = put_label(o[0..], 0, 1, R_FIRST[1]);
    assert n == 1;
    assert o[0] == 53;
    assert value_at(1, 0.0 - 1.0) == 0 - 1;
}

test a_wide_bus_is_a_big_number {
    assert parse_vcd("$var wire 64 ! w $end $enddefinitions $end #0 b1111111111111111111111111111111111111111111111111111111111111111 !") == 0;
    set_data(false, "w.vcd");
    var o : [512]u8 = [0; 512];
    const n : u32 = put_value_text(o[0..], 0, 0, value_at(0, 0.0));
    assert w_has(o[0..], n, "0xffffffffffffffff = 18446744073709551615 / -1");
}

test time_is_written_in_the_largest_unit_that_keeps_it_above_one {
    open_tiny();
    var o : [64]u8 = [0; 64];
    var n : u32 = put_time(o[0..], 0, 20.0);
    assert w_has(o[0..], n, "20 ns");
    n = put_time(o[0..], 0, 0.0);
    assert w_has(o[0..], n, "0 ns");
    n = put_time(o[0..], 0, 1500.0);
    assert w_has(o[0..], n, "1.5 us");
    n = put_time(o[0..], 0, 0.25);
    assert w_has(o[0..], n, "250 ps");
}

test the_page_opens_with_the_demo_pressed_and_the_diagram_unsized {
    w_view(800.0, 1.0, 0, 768.0, 0.0);
    w_init("");
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert w_has(o[0..], n, "aria-label=\"Back to the simulated spec\" aria-pressed=\"true\">Demo</button>");
    assert w_has(o[0..], n, "<p class=\"tw-status\" aria-live=\"polite\">Reading the simulation...</p>");
    assert !w_has(o[0..], n, "width=");
    assert w_has(o[0..], n, "<details class=\"tw-prov\"></details>");
    assert w_has(o[0..], n, "<input type=\"file\" accept=\".vcd,text/plain\" hidden=\"\">");
    assert w_bdraw(o[0..]) == 0;
}

test a_file_is_sized_drawn_and_described {
    open_tiny();
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert w_has(o[0..], n, "width=\"602\" height=\"240\" style=\"width: 602px; height: 240px;\"");
    assert w_has(o[0..], n, "<p class=\"tw-source\">x.vcd: 2 signals over 20 ns, read in this browser</p>");
    assert w_has(o[0..], n, "<details class=\"tw-prov\" hidden=\"\"></details>");
    var d : [1048576]u8 = [0; 1048576];
    assert w_bdraw(d[0..]) == 0;
    var q : [64]f64 = [0.0; 64];
    assert w_libm_need(q[0..]) == 2;
}

test zoom_pan_and_fit_move_the_view_the_way_tool_js_does {
    open_tiny();
    const s0 : f64 = V_SCALE;
    w_click(3);
    assert V_SCALE > s0 * 1.59 and V_SCALE < s0 * 1.61;
    w_click(2);
    assert V_SCALE > s0 * 0.99 and V_SCALE < s0 * 1.01;
    w_click(4);
    assert V_T0 == 0.0;
    assert w_key("ArrowRight") == 1;
    assert V_T0 > 0.0 - 0.001;
    assert w_key("q") == 0;
    assert w_key("0") == 1;
    assert V_T0 == 0.0;
}

test a_tap_on_a_row_reads_its_value_under_the_cursor {
    open_tiny();
    w_cpointer(0, 1, 300.0, 70.0, 1);
    w_cpointer(2, 1, 300.0, 70.0, 1);
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert w_has(o[0..], n, "top.bus [8 bit] = 0x05 = 5 at ");
    assert ST_CLS == 0;
}

test a_drag_pans_and_does_not_tap {
    open_tiny();
    w_click(3);
    w_click(3);
    const t0 : f64 = V_T0;
    w_cpointer(0, 1, 300.0, 70.0, 1);
    w_cpointer(1, 1, 320.0, 70.0, 1);
    w_cpointer(1, 1, 340.0, 70.0, 1);
    w_cpointer(2, 1, 340.0, 70.0, 1);
    assert V_T0 < t0;
    assert PT_N == 0;
}

test the_wheel_asks_for_exp_before_it_zooms {
    open_tiny();
    const s0 : f64 = V_SCALE;
    assert w_wheel2(300.0, 70.0, 0.0, 0.0 - 100.0, 1, 0, 0) == 2;
    assert V_SCALE == s0;
    var q : [64]f64 = [0.0; 64];
    assert w_libm_need(q[0..]) == 1;
    assert q[0] == 16.0;
    var a : [4]f64 = [1.5, 0.0, 0.0, 0.0];
    w_libm_give(a[0..], 1);
    assert w_wheel2(300.0, 70.0, 0.0, 0.0 - 100.0, 1, 0, 0) == 1;
    assert V_SCALE > s0;
    assert w_wheel2(300.0, 70.0, 5.0, 0.0, 0, 1, 0) == 1;
    assert w_wheel2(300.0, 70.0, 0.0, 5.0, 0, 0, 0) == 0;
}

test the_drop_box_opens_the_picker_and_the_area_follows_the_drag {
    open_tiny();
    assert w_dkey("Enter") == 1;
    var e : [8]u8 = [0; 8];
    assert w_effect(0, e[0..]) == 1;
    assert e[0] == 105;
    assert w_effect(1, e[0..]) == 0;
    assert w_dkey("a") == 0;
    w_dclick();
    assert w_effect(0, e[0..]) == 1;
    assert w_drag(0) == 1;
    assert w_drag(0) == 0;
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert w_has(o[0..], n, "<div class=\"tw-stage is-over\">");
    assert w_has(o[0..], n, "<div class=\"t27-drop tw-drop is-over\"");
    assert w_drag(1) == 1;
}

test a_file_that_does_not_read_leaves_the_diagram_and_says_why {
    open_tiny();
    w_file("bad.vcd", 12.0, "hello world", 0);
    var o : [65536]u8 = [0; 65536];
    var n : u32 = w_render(o[0..]);
    assert w_has(o[0..], n, "<p class=\"tw-status is-fail\" aria-live=\"polite\">bad.vcd is not a VCD this tool reads: no $enddefinitions</p>");
    assert w_has(o[0..], n, "<p class=\"tw-source\">x.vcd: 2 signals over 20 ns, read in this browser</p>");
    assert NROWS == 2;
    w_file("q.vcd", 12.0, "$enddefinitions $end #5 q", 0);
    n = w_render(o[0..]);
    assert w_has(o[0..], n, "cannot read &quot;q&quot; after time 5</p>");
    w_file("big.vcd", 9437184.0, "", 0);
    n = w_render(o[0..]);
    assert w_has(o[0..], n, "big.vcd is 9.0 MB; this tool reads files up to 8 MB.</p>");
}

/// The splicer follows only the names a module itself mentions, not the names the imported functions
/// mention. This anchor mentions every helper the writer, the JSON reader, the number rules and the
/// canvas writers call. Never called.
pub fn imports_anchor(o: []u8, s: []const u8) -> u32 {
    var n : u32 = 0;
    n = n + (ok(0) as u32);
    n = n + OVER;
    n = n + put(o, 0, 0);
    n = n + raw(o, 0, s);
    n = n + put_escaped(o, 0, 0);
    n = n + text(o, 0, s);
    n = n + num(o, 0, 0);
    n = n + attr(o, 0, s, s);
    n = n + fill(o, 0, s, s, s, s, 0);
    n = n + fill_named(o, 0, s, s, s, s, s, s, s, s, s, s, s, s, s);
    n = n + dec_to(o, 0);
    n = n + (name_is(s, 0, 0, s) as u32);
    n = n + (is_word_byte(0) as u32);
    n = n + (H_LT as u32);
    n = n + (H_GT as u32);
    n = n + (H_AMP as u32);
    n = n + (H_QUOTE as u32);
    n = n + (H_APOS as u32);
    n = n + (H_SPACE as u32);
    n = n + (H_SLASH as u32);
    n = n + (H_EQ as u32);
    n = n + ((NO_SPAN < 0) as u32);
    n = n + ((SPAN > 0) as u32);
    n = n + (J_NONE as u32);
    n = n + (J_OBJECT as u32);
    n = n + (J_ARRAY as u32);
    n = n + (J_STRING as u32);
    n = n + (J_NUMBER as u32);
    n = n + (J_TRUE as u32);
    n = n + (J_FALSE as u32);
    n = n + (J_NULL as u32);
    n = n + (jspan(0, 0) as u32);
    n = n + (span_lo(0) as u32);
    n = n + (span_hi(0) as u32);
    n = n + (skip_ws(s, 0) as u32);
    n = n + (string_end(s, 0) as u32);
    n = n + (value_end(s, 0) as u32);
    n = n + (root(s) as u32);
    n = n + (kind(s, 0) as u32);
    n = n + (key_is(s, 0, 0, s) as u32);
    n = n + (obj_get(s, 0, s) as u32);
    n = n + arr_len(s, 0);
    n = n + (arr_at(s, 0, 0) as u32);
    n = n + hex4(s, 0);
    n = n + escape_at(s, 0, 0);
    n = n + cp_utf8_len(0);
    n = n + (cp_utf8_byte(0, 0) as u32);
    n = n + str_len(s, 0);
    n = n + (str_byte(s, 0, 0) as u32);
    n = n + JN_OVER;
    n = n + JN_CAP;
    n = n + ((JN_TWO52 > 0.0) as u32);
    n = n + ((JN_TWO53 > 0.0) as u32);
    n = n + jn_put(o, 0, 0);
    n = n + jn_raw(o, 0, s);
    n = n + jn_digits(o, 0);
    n = n + jn_mul(o, 0, 0);
    n = n + jn_mul2(o, 0, 0);
    n = n + jn_mul5(o, 0, 0);
    n = n + jn_shift(o, 0, 0);
    n = n + (jn_cmp(s, s, 0) as u32);
    n = n + (jn_expo(0.0) as u32);
    n = n + (jn_mant(0.0) as u32);
    n = n + ((jn_make(0, 0) > 0.0) as u32);
    n = n + jn_exact(o, 0, 0);
    n = n + jn_fscale(0);
    n = n + (js_is_nan(0.0) as u32);
    n = n + ((js_nan(0.0) > 0.0) as u32);
    n = n + ((js_inf(1.0) > 0.0) as u32);
    n = n + ((js_floor(0.0) > 0.0) as u32);
    n = n + ((js_ceil(0.0) > 0.0) as u32);
    n = n + ((js_max(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_min(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_round(0.0) > 0.0) as u32);
    n = n + (jn_shortest(o, 1.0) as u32);
    n = n + jn_copy(o, s, 0);
    n = n + jn_put_run(o, 0, s, 0, 0);
    n = n + jn_layout(o, 0, s, 0, 0);
    n = n + js_str_num(o, 0, 0.0);
    n = n + js_to_fixed(o, 0, 0.0, 0);
    n = n + js_locale_num(o, 0, 0.0);
    n = n + (jn_num_ok(s, 0, 0) as u32);
    n = n + (jn_cmp_text(s, 0, 0, 0, 0) as u32);
    n = n + ((js_parse_num(s, 0, 0) > 0.0) as u32);
    n = n + ((jn_dec_value(s, 0, 0) > 0.0) as u32);
    n = n + (jn_abs(0) as u32);
    n = n + js_str_u64(o, 0, 0);
    n = n + jv_str_to(o, 0, s, 0);
    n = n + jv_text_str(o, 0, s, 0);
    n = n + ((jv_numval(s, 0) > 0.0) as u32);
    n = n + jv_str(o, 0, s, 0);
    n = n + jv_text(o, 0, s, 0);
    n = n + (jv_is(s, 0, s) as u32);
    n = n + (jv_truthy(s, 0) as u32);
    n = n + (jv_is_ws(0) as u32);
    n = n + ((jv_number_of_text(s, 0) > 0.0) as u32);
    n = n + ((jv_num(s, 0) > 0.0) as u32);
    n = n + jv_vput_str(o, 0, s, s);
    n = n + jv_vput_f64(o, 0, s, 0.0);
    n = n + jv_vput_val(o, 0, s, s, 0);
    n = n + jv_vput_defined(o, 0, s, s, 0);
    n = n + jv_vput_fixed(o, 0, s, 0.0, 0);
    n = n + jv_kid(o, 0, s, 0);
    n = n + jv_find(s, 0, s);
    n = n + jv_fill(o, 0, s, s, 0, true);
    n = n + (jv_string_ok(s, 0) as u32);
    n = n + (jv_number_ok(s, 0) as u32);
    n = n + (jv_lit_ok(s, 0, s) as u32);
    n = n + (jv_valid(s) as u32);
    n = n + jv_ws_at(s, 0, 0);
    n = n + jv_ws_before(s, 0, 0);
    n = n + jv_digit_value(0);
    n = n + jv_fill_raw(o, 0, s, s, 0, true);
    n = n + jv_fill_with(o, 0, s, s, 0, true, true);
    n = n + num_grouped(o, 0, 0);
    return n;
}
