; --- Tests ------------------------------------------------------------------------------------
test a_row_is_a_touch_target {
    assert K_ROW_PX >= K_MIN_TARGET_PX;
    assert K_CHECKS_PX >= K_MIN_TARGET_PX;
    assert K_MIN_TARGET_PX == 32;
}

test the_tool_reads_files_and_sends_nothing {
    assert READS_LOCAL_FILES == true;
    assert SENDS_NOTHING == true;
    assert same_text(CATEGORY, "fpga");
}

test the_demo_is_the_simulated_spec {
    assert same_text(K_DEMO_VCD, "demo.vcd");
    assert same_text(K_DEMO_JSON, "demo.json");
    assert same_text(ID, "test-waves");
}

test the_limits_are_bounded {
    assert K_MAX_SIGNALS > 0;
    assert K_MAX_FILE_MB <= 256;
    assert K_MAX_PX_PER_UNIT > 0;
}

test time_units_run_from_seconds_down {
    assert same_text(SAY_TIME_UNITS[0], "s");
    assert same_text(SAY_TIME_UNITS[3], "ns");
    assert same_text(SAY_TIME_UNITS[5], "fs");
}


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, issue #10938, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/test-waves/tool.js (726 lines of hand-written JavaScript). The words
; and numbers above are unchanged (but for one test, and K_DATA_FILES, see below). The page keeps its state in
; module-level `pub var`s, writes the page as HTML and the diagram as a BINARY draw list (the protocol of
; fasm_skyline.t27 with the additions of idcode.t27 and slack_waterfall.t27, and ops 14 clearRect, 15 rect, 16 clip,
; 17 setLineDash(u8 count, f64 each), 18 arc(5 f64)); the one shared host (host.js) sets the HTML, replays the list,
; forwards the events and runs the effects. Exports (all `pub fn`):
;   w_init(hash)             the page opens (the host stamps w_view first: <html class="embed"> is read once, here)
;   w_view(width, dpr, embed, innerHeight, boxWidth)   the window numbers tool.js reads
;   w_rect_sel(dst), w_rect(w, h)   the getBoundingClientRect of ".tw-stage", stamped by the host with w_view
;   w_canvas_keep()          the canvas is one element for the life of the page (focus, pointer capture)
;   w_data(i, bytes), w_data_failed(i, status)   i 0 is demo.vcd, 1 is demo.json (K_DATA_FILES); status is the HTTP status
;   w_click(i)               the i-th button: 0 Demo, 1 Open a .vcd, 2 zoom out, 3 zoom in, 4 Fit
;   w_dclick(), w_dkey(key)  a click / Enter or Space on the drop box (.t27-drop): the file picker opens (effect 105)
;   w_cpointer(kind, id, x, y, mouse)  pointer events on the canvas: 0 down, 1 move, 2 up, 3 cancel, 4 leave (ignored)
;   w_wheel2(x, y, dx, dy, ctrl, shift, meta)  bit 0: tool.js calls preventDefault; bit 2: a libm answer is missing, call again
;   w_key(key)               a key on the canvas: 1 when tool.js handles it (the host then calls preventDefault)
;   w_box(w, h)              the ResizeObserver: relayout() always; w_winresize() the window's resize event
;   w_drag_sel(dst)          ".tw" is the drag area; w_drag(kind) 0 over, 1 left it, 2 dropped; w_drag_related() the leave
;                            is ignored when the pointer went to a child of the area (tool.js: box.contains(relatedTarget))
;   w_file(name, size, text, st), w_file_cap(), w_value(i, dst) as in slack_waterfall.t27 (no w_drop_root: a drop outside the page box is not taken)
;   w_render(dst), w_bdraw(dst), w_draw_cap(), w_text_need / w_text_give, w_libm_need / w_libm_give
;   w_effect(k, dst)         record 105 ("i"): click the hidden file input
; The VCD is parsed into scratch tables, and only the rows that are drawn (at most K_MAX_SIGNALS) are copied into the
; tables the page keeps, so a file that does not read leaves the diagram as it was. Token by token the parser is
; parseVcd(): the same errors in the same order, the same dedupe of value changes, aliases of one code.
; Not carried over from JavaScript (said plainly; the measurement does not cover them):
;  - limits: a file's text is handed over up to W_FILE_CAP (8 MiB; tool.js reads 64 MB, K_MAX_FILE_MB) and a larger file
;    says SAY_ERR_TOO_BIG with the real limit (W_FILE_MB); more than W_MAX_CH (262144) value changes, W_MAX_VARS (65536)
;    variables or 2 MiB of value text say SAY_ERR_TOO_BIG too; a bus wider than W_MAX_BITS (8192) is read as that wide;
;    a draw list above W_DRAW_CAP is not drawn;
;  - values other than 0 1 x z (u w l h -) in a vector: tool.js throws in BigInt() or parseInt() halfway through a
;    draw; here they read as bits that are neither x nor z; a width that is not a whole number; a signal role that is
;    a name of Object.prototype; lowercasing folds ASCII only; a token cut to 24 characters is cut at 24 bytes of UTF-8
;    that end a character;
;  - the "why" of an error that is not a VcdError (a JSON.parse or TypeError message of the engine, a FileReader error)
;    is not reproducible: a demo.json that is not JSON, or lacks a field the page reads, says SAY_ERR_DEMO with an empty
;    reason; roles that remove every signal make tool.js loop for ever in shortNames() (here the diagram is empty);
;  - the colours and the font are read when the list is drawn (tool.js reads them once at load); the demo is read from
;    the two files fetched at load again at each click of "Demo" (tool.js fetches again);
;  - the stage observed for a size change is the page root (the ResizeObserver of tool.js watches the stage); a window
;    resize is handled at once, as tool.js does; a click on "Demo" while the first two fetches are still running starts no
;    third fetch; a pointer that leaves the canvas without being released is not told apart;
;  - an HTML parser drops the first line feed of a <pre>: when the joined commands start with one, this page writes one more,
;    which a browser removes and happy-dom (the oracle of the measurement) does not; a value that is `false` in a field
;    written with textContent is "false" in a browser, empty in happy-dom (the measurement keeps both out);
;  - seven asserts of three tests of the spec compare str constants with ==; t27c 0.5.2 does not compile that, so they read same_text(...);
;  - K_DATA_FILES is added to the spec (the two names the host fetches: demo.vcd, demo.json) and the generated index.html
;    must carry it in T27_WIDGET.

; MEASURED 2026-10-20: t27c gen + a 34-line Zig export wrapper + zig build-exe wasm32-freestanding ReleaseSmall give a
; 55128-byte wasm (with about 26 MiB of tables in zero-initialised memory). The original page (tool.js) and this one ran
; in two DOM windows (happy-dom) with a FAKE getContext('2d') on each that records every method call and every property
; assignment (measureText answers one proportional stand-in; a property read gives back what was set), a fake
; ResizeObserver fired by hand, and stand-ins for the stage rectangle, innerHeight and devicePixelRatio; after every
; action the DOM (attributes, text), the file-picker clicks, the preventDefault of every key and wheel and, whenever tool.js
; drew, its last call sequence against the native page's last one (and the transform when tool.js set it) were compared:
; 10903 comparisons (about 10.9 million calls and assignments recorded, 5926 drawings of tool.js), 0 differences. They cover the
; real demo (tap on every region of the diagram at five sizes and device pixel ratios, embed on and off), 59 files
; (36 generated VCDs: timescales of every unit and none, nested scopes, buses of 1 to 128 bits with x and z, reals,
; integers, aliases, comments, $dumpvars, repeated and decreasing times, \r\n and space separated; 23 that must be refused or read
; oddly: empty, no definitions, a bad timescale, a bad token with accents and over 24 characters, no signals, hex and
; binary times, width 0, duplicates, short and long vectors), 6 x 5 files again with 50 random events each (taps, drags, pinches
; with two pointers, hover, cancel, wheel with ctrl / meta / shift / horizontal / vertical, keys, resizes of the window and
; the observer, drags in and out of the area and its children, the drop box clicked and keyed, picks and drops), 36 variants
; of demo.json and demo.vcd (a failing summary, a summary of strings, roles reordered / a subset / duplicated / unknown /
; odd, no roles, checks empty / missing / forty / out of the window / with times as strings, markup and accents in every
; field, odd vectors, commands empty, other timescales, x and z values, a negative acc, a real signal, an alias, a bad token),
; a 404, events before the demo arrives and CSS variables set. Negative controls: a changed DOM node, a rect digit and
; a line width moved by 1e-9, a skipped clip, a changed dash, a wrong CSS fallback, a measured width 1000 too wide, a wheel
; always prevented, a leave into a child ending the drag, the stage width read 10 too small and a pointer x moved by 1 are
; each reported. NOT compared (happy-dom has no layout, fonts, pixels, pointer capture, real FileReader errors or file
; picker): the pixels, real font widths, the real ResizeObserver, focus, the picker itself (only the click on it), the
; behaviour of a real browser for a leading line feed in a <pre> and for textContent = false, and the case of a demo.json
; that is not JSON or lacks a field (their reasons are engine messages).

pub const K_DATA_FILES : [2]str = ["demo.vcd", "demo.json"];
pub const W_FILE_CAP : u32 = 8388608;
pub const W_FILE_MB : u32 = 8;
pub const W_DEMO_CAP : u32 = 4194304;
pub const W_JSON_CAP : u32 = 262144;
pub const W_MAX_VARS : u32 = 65536;
pub const W_MAX_CH : u32 = 262144;
pub const W_VPOOL : u32 = 2097152;
pub const W_NPOOL : u32 = 1048576;
pub const W_MAX_ROWS : u32 = 400;
pub const W_MAX_CHECKS : u32 = 1024;
pub const W_MAX_BITS : u32 = 8192;
pub const W_DRAW_CAP : u32 = 16777216;
pub const W_STAGE_SEL : str = ".tw-stage";
pub const W_AREA_SEL : str = ".tw";
pub const W_MONO_VAR : str = "--w-mono";
pub const W_MONO_FB : str = "ui-monospace, Menlo, monospace";
pub const W_PI2 : f64 = 6.283185307179586;

