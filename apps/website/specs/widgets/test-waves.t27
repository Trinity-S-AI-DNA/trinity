pub const KIND : str = "widget-tool";
pub const ID : str = "test-waves";
pub const TITLE : str = "Test waves: a t27 spec's tests, simulated and drawn as waves";
pub const DESCRIPTION : str = "Verilog generated from a ternary MAC spec, driven by the spec's own test vectors under Icarus Verilog: clock, buses, pass marks. Drop a .vcd and it draws yours.";
pub const IMAGE_ALT : str = "A timing diagram on black: clk, rst_n, en, the 64-bit buses a and b as labelled hex segments, the 32-bit accumulator acc and the expected sum, with six green pass marks along the bottom, from an Icarus Verilog run of Verilog that t27 generated from stream_ternary_mac.t27.";
pub const HOOK : str = "A spec's test block, run as gates and drawn as waves: every edge is from a real simulation, and your own .vcd opens in the same view.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [4]str = ["specs/ternary/stream_ternary_mac.t27, its four test blocks (vendored at public/t27/files/specs/)", "public/t27/t27_compiler.wasm, verilog target: module StreamTernaryMac", "scripts/widget-data/test-waves-tb.v and test-waves.mjs, run under Icarus Verilog (iverilog, vvp); versions and sha256 in demo.json", "A .vcd file the reader drops or picks: read in the browser with FileReader, never uploaded"];
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

