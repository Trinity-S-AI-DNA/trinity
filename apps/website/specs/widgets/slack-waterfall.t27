pub const KIND : str = "widget-tool";
pub const ID : str = "slack-waterfall";
pub const TITLE : str = "Slack waterfall: every timing path of a routed design, worst first";
pub const DESCRIPTION : str = "159 endpoints of a real nextpnr-xilinx run at 50 MHz as logic and routing waterfalls, checked bin by bin against nextpnr's log. Drop a --report JSON for yours.";
pub const IMAGE_ALT : str = "A waterfall on black: 159 rows, one per timing endpoint, sorted worst first, each a strip of gold logic and green routing segments ending well before a red 20 ns period line, the spare time shaded dark green. Headline: worst slack +15.233 ns, fmax 209.78 MHz.";
pub const HOOK : str = "Where do 4.8 ns go in a 20 ns clock? Every path of a real Artix-7 run, segment by segment, worst first; drop your report for yours.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [5]str = ["gHashTag/trinity-fpga de4ebda367: fpga/openxc7-synth/trinity_v3_jtaguart.v and jtaguart.xdc", "nextpnr-xilinx 0.9.2-107-g7037c948 --chipdb xc7a200tfbg676-1.bin --freq 50 --seed 1: routed.sdf, report.json (fmax) and the log's critical path and slack histogram", "scripts/widget-data/fpga-pnr.py: per-endpoint paths from the SDF, checked against the log, written to timing.json", "nextpnr common/timing.cc and xilinx/arch.cc (nextpnr-xilinx 0.9.2-107-g7037c948): the arrival, setup and port-class rules followed", "A nextpnr --report JSON or a fpga-pnr.py timing.json the reader drops or picks: read in the browser with FileReader, never uploaded"];
