; --- Tests ----------------------------------------------------------------------------------
test the_period_is_the_inverse_of_the_frequency {
    assert K_DEMO_PERIOD_PS * K_DEMO_FREQ_MHZ == 1000000;
    assert K_PS_PER_NS == 1000;
}

test the_worst_path_adds_up {
    assert K_DEMO_WORST_LOGIC_PS + K_DEMO_WORST_ROUTING_PS == K_DEMO_WORST_TOTAL_PS;
    assert K_DEMO_WORST_TOTAL_PS + K_DEMO_WORST_SLACK_PS == K_DEMO_PERIOD_PS;
    assert K_DEMO_WORST_TOTAL_PS < K_DEMO_PERIOD_PS;
}

test the_worst_path_rounds_to_nextpnr_log_figures {
    assert 48 == (K_DEMO_WORST_TOTAL_PS + 50) / 100;
    assert 22 == (K_DEMO_WORST_LOGIC_PS + 50) / 100;
    assert 25 == (K_DEMO_WORST_ROUTING_PS + 50) / 100;
}

test every_segment_type_has_a_colour {
    assert K_SEG_TYPES[3] == "routing";
    assert K_SEG_COLORS[3] == "#00ff88";
    assert K_SEG_TYPES[4] == "setup";
}

test the_page_reads_files_and_sends_nothing {
    assert READS_LOCAL_FILES == true;
    assert SENDS_NOTHING == true;
    assert same_text(CATEGORY, "fpga");
}


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, issue #10938, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/slack-waterfall/tool.js (370 lines of hand-written JavaScript). The
; words and numbers above are unchanged (but for one test, see the end of this header). The page keeps its state
; in module-level `pub var`s, writes the page as HTML and the waterfall as a BINARY draw list (the protocol of
; fasm_skyline.t27, plus the property codes 36 textBaseline, 37 textAlign and 38 globalAlpha that idcode.t27 adds);
; the one shared host (host.js) sets the HTML, replays the list, forwards the events and runs the effects.
; Exports (all `pub fn`):
;   w_init(hash)            the page opens
;   w_view(width, dpr, embed, innerHeight, boxWidth)  the numbers tool.js reads from the window and from the box
;                           .sw-wrap (w_measure_sel), stamped by the host before every event
;   w_measure_sel(dst)      ".sw-wrap"        w_scroll_sel(dst)  ".sw-wrap": its scrollTop survives a repaint
;   w_canvas_keep()         the canvas is one element for the life of the page (focus)
;   w_drop_root()           a file dropped anywhere on the page is taken (tool.js listens on the page root)
;   w_draw_cap()            the byte size of the draw list buffer        w_file_cap()  the biggest file text handed over
;   w_data(i, bytes)        timing.json was fetched; w_data_failed(i)
;   w_click(i)              the i-th button: 0 Full period, 1 Fit paths, 2 Worse, 3 Better, 4 Demo design
;   w_key(key)              a key on the canvas: 1 when it was one of the six tool.js handles (the host then calls
;                           preventDefault, as tool.js does)
;   w_cpointer(kind, id, x, y, mouse)  pointer events on the canvas, x and y relative to it: kind 0 is the press
;   w_box(w, h)             the ResizeObserver of the box: 1 when the canvas must be sized and drawn again
;   w_drag(kind)            0 over the drop label, 1 left it, 2 dropped: 1 when its look changed
;   w_file(name, size, text, st)   a file was picked or dropped; st 1 when the host could not read it
;   w_value(i, dst)         the text the file field must hold (empty, after a pick: tool.js clears it) or 4294967295
;   w_render(dst)           the page's HTML        w_bdraw(dst)  the waterfall as a binary draw list (canvas 0)
;   w_text_need(dst), w_text_give(widths, n)   the text width service (see stat_card.t27): ctx.measureText of the
;                           axis labels; font strings carry the CSS-variable marker (byte 4, name, byte 5, fallback,
;                           byte 6), which is `getComputedStyle(root).getPropertyValue(name) || fallback`, NOT trimmed
;   w_libm_need(dst), w_libm_give(src, n)   Math.log10 and Math.pow of the axis step, answered by the host
;   w_effect(k, dst)        effects: record 121 ("y") "sel LF y LF rowH" scroll the box so the picked row shows,
;                           as scrollToPick(); record 120 ("x") "sel" set the box's scrollTop to 0
; STATE tool.js keeps in DOM elements and in its closure is kept as flags: what each element last held. The part
; of the page render() rewrites is a function of the data; the parts it does not touch (the detail table when the
; data has no path, the canvas size and the box's max-height when the data has no path, a status text set by a
; failed drop) keep their old look, as there: DET_N holds the last detail table.
; The page reads a file the way tool.js does: the first character-for-character JSON.parse verdict (jv_valid), the
; two shapes (the timing.json of fpga-pnr.py, a nextpnr --report), and the cases where tool.js throws halfway (a
; null path, a segment that is not an array, a clock entry that is null: the status stays "Reading NAME...").
; Not carried over from JavaScript (said plainly; the measurement does not cover them):
;  - files: the host hands over a file's text up to W_FILE_CAP bytes (8 MiB); a bigger file says SAY_ERR_SIZE with
;    its real limit (W_FILE_MB), where tool.js reads up to 256 MB. timing.json is read up to 1 MiB, W_MAX_PATHS (65536)
;    paths and W_MAX_FMAX (256) clocks are kept, W_MAX_CELL (4096) bytes of one cell text;
;  - a number is expected where tool.js adds or compares ("ps", "slack", "period_ps", fmax numbers): a string there
;    adds as text in JavaScript; "kind" and the strings table may hold other kinds (shown as String(v));
;  - arrays inside arrays where h() flattens them (a segment kind that is an array); a segment row that is a string
;    (JavaScript reads its characters); "strings" that is not an array; the clock name "constructor" and the other
;    names of Object.prototype read as clocks of the report's table; integer-like clock names (JavaScript lists
;    them first); a repeated key inside a JSON object reads as the first here, the last in JSON.parse;
;  - src.commands that is not an array (JavaScript throws halfway through render()); a cell text above W_MAX_CELL;
;  - the box of the canvas is observed on the page root (the ResizeObserver of tool.js watches the box itself);
;    "Reading NAME..." is not shown while the file is read (the host hands the whole text over at once);
;  - tool.js never reads the box width while the box is hidden; the host stamps it before the event, so the first
;    drawing may use 600 for one pass until the observer reports the real width;
;  - an infinite loop: if the widest path is 0 ps long the axis step is 0 and tool.js never leaves its loop; here
;    the axis is left out.
; One test of the spec, the_page_reads_files_and_sends_nothing, reads same_text(CATEGORY, "fpga") where it read CATEGORY == "fpga":
; t27c 0.5.2 does not compile a comparison of two str constants.

; MEASURED 2026-10-20: t27c gen + a 24-line Zig export wrapper + zig build-exe wasm32-freestanding ReleaseSmall give a
; 42255-byte wasm (with 17 MiB of tables in zero-initialised memory). The original page (tool.js) and this one ran in two
; DOM windows (happy-dom) with a FAKE getContext('2d') on each that records every method call and every property
; assignment (measureText answers one proportional stand-in), a fake ResizeObserver, and stand-ins for clientWidth,
; clientHeight, scrollTop, innerHeight and devicePixelRatio; after every action the DOM (attributes, text, the scrollTop of
; the box), the preventDefault of every key and, whenever tool.js drew, its last call sequence against the native page's
; last one were compared: 4151 comparisons (16.6 million calls and assignments recorded, 2169 drawings of tool.js), 0
; differences. They cover the real timing.json with every button and key, pointer presses in and out of the rows, 10
; widths from 0 to 2400, devicePixelRatio 0 to 3, embed on and off, the font variable, scrolling and the details; 79 dropped
; or picked files (28 timing.json and 24 nextpnr reports of generated shapes: no, one, many paths, with and without
; a period, slack null / negative / missing, segment kinds of every sort, clocks with null, string and missing numbers, a
; check and a source of every shape; reports with no paths, only fmax, an fmax array; 23 files that are refused or make
; tool.js throw halfway), 8 x 6 files again with 45 random events each, 16 demo files (404, not JSON, a demo that
; disagrees in the period, in the path count and in the slack, root null / array / number / {}, a null path, a null clock,
; label and source changes), and events before the demo arrives. Negative controls: a changed DOM node, a changed scrollTop, a rect
; digit and a property value moved by 1e-9, a skipped call, a wrong CSS fallback, a measured width 1000 too wide, no scrollTop
; kept through a repaint, no scroll to the picked row, a key not prevented and a wrong libm function are each reported.
; NOT compared (happy-dom has no layout, fonts or pixels): the pixels, real font widths (a stand-in answers), the real
; ResizeObserver (a fake one is fired by hand), focus, pointer capture, the real FileReader error cases, and white space around
; the --w-mono variable (happy-dom trims custom property values, so the untrimmed read is by construction only).

pub const W_FILE_CAP : u32 = 8388608;
pub const W_FILE_MB : u32 = 8;
pub const W_DEMO_CAP : u32 = 1048576;
pub const W_DRAW_CAP : u32 = 4194304;
pub const W_MAX_PATHS : u32 = 65536;
pub const W_MAX_FMAX : u32 = 256;
pub const W_MAX_CELL : u32 = 4096;
pub const W_DET_CAP : u32 = 262144;
pub const W_SEL : str = ".sw-wrap";
pub const W_AXIS : f64 = 18.0;
pub const W_MONO_VAR : str = "--w-mono";
pub const W_MONO_FB : str = "monospace";
pub const W_LINE_FB : str = "var(--w-line)";
pub const W_GOLD_FB : str = "#ffd700";

pub var DEMO : [1048576]u8 = [0; 1048576];
pub var DEMO_LEN : u32 = 0;
pub var FA : [8388608]u8 = [0; 8388608];
pub var FB : [8388608]u8 = [0; 8388608];
pub var CUR : u32 = 0;
pub var DEMO_OK : bool = false;
pub var FULL : bool = true;
pub var PICK : u32 = 0;
pub var ST : u32 = 0;
pub var ST_FAIL : bool = false;
pub var ST_NAME : [1100]u8 = [0; 1100];
pub var ST_NAME_LEN : u32 = 0;
pub var RENDERED : bool = false;
pub var OVER_DROP : bool = false;
pub var CLR_FILE : bool = false;
pub var EF : [4]u8 = [0; 4];
pub var EF_N : u32 = 0;
pub var ENV_W : f64 = 0.0;
pub var ENV_DPR : f64 = 1.0;
pub var ENV_EMBED : u32 = 0;
pub var ENV_IH : f64 = 768.0;
pub var ENV_BW : f64 = 0.0;
pub var LAST_W : f64 = 0.0;
pub var CV_SET : bool = false;
pub var CV_W : u64 = 0;
pub var CV_H : u64 = 0;
pub var CV_SH : u64 = 0;
pub var CV_MAXH : u64 = 0;
pub var CSS_W : f64 = 0.0;
pub var ROW_H : f64 = 3.0;
pub var X_MAX : f64 = 1.0;
pub var DET_LEN : u32 = 0;
pub var DET : [262144]u8 = [0; 262144];

// the data in use: tool.js's state.data, read from the bytes of the buffer CUR names
pub var DS_FMT : u32 = 0;
pub var DS_N : u32 = 0;
pub var DS_PERIOD : f64 = 0.0;
pub var DS_HAS_PERIOD : bool = false;
pub var DS_LABEL : [1100]u8 = [0; 1100];
pub var DS_LABEL_LEN : u32 = 0;
pub var DS_ROOT : i64 = -1;
pub var PSP : [65536]i64 = [0; 65536];
pub var ORD : [65536]u32 = [0; 65536];
pub var TMPO : [65536]u32 = [0; 65536];
pub var TOT : [65536]f64 = [0.0; 65536];
pub var ROU : [65536]f64 = [0.0; 65536];
pub var SLK : [65536]f64 = [0.0; 65536];
pub var SLN : [65536]u8 = [0; 65536];
pub var FM_N : u32 = 0;
pub var FM_K : [256]i64 = [0; 256];
pub var FM_A : [256]i64 = [0; 256];
pub var FM_C : [256]i64 = [0; 256];
pub var FM_KIDX : [256]u32 = [0; 256];

// the text width memo and the libm memo (answers the host gives; a miss makes the list wrong and is asked again)
pub var X_N : u32 = 0;
pub var X_FO : [256]u32 = [0; 256];
pub var X_FL : [256]u32 = [0; 256];
pub var X_TO : [256]u32 = [0; 256];
pub var X_TL : [256]u32 = [0; 256];
pub var X_ST : [256]u8 = [0; 256];
pub var X_W : [256]f64 = [0.0; 256];
pub var X_POOL : [16384]u8 = [0; 16384];
pub var X_POOL_N : u32 = 0;
pub var X_MISS : bool = false;
pub var LB_N : u32 = 0;
pub var LB_OP : [64]u8 = [0; 64];
pub var LB_A : [64]f64 = [0.0; 64];
pub var LB_B : [64]f64 = [0.0; 64];
pub var LB_R : [64]f64 = [0.0; 64];
pub var RQ_N : u32 = 0;
pub var RQ_OP : [64]u8 = [0; 64];
pub var RQ_A : [64]f64 = [0.0; 64];
pub var RQ_B : [64]f64 = [0.0; 64];
pub var RQ_SENT : u32 = 0;
pub var MISSING : bool = false;

// --- small pieces ------------------------------------------------------------------------------------------

fn copy_into(dst: []u8, at: u32, s: []const u8) -> u32 {
    var n : u32 = at;
    var i : usize = 0;
    while (i < s.len and (n as usize) < dst.len) {
        dst[n as usize] = s[i];
        n = n + 1;
        i = i + 1;
    }
    return n;
}

/// The active buffer: 1 the demo, 2 and 3 the two file buffers.
fn ds_bytes() -> []const u8 {
    if (CUR == 1) { return DEMO[0..(DEMO_LEN as usize)]; }
    if (CUR == 2) { return FA[0..(FA_LEN as usize)]; }
    return FB[0..(FB_LEN as usize)];
}

pub var FA_LEN : u32 = 0;
pub var FB_LEN : u32 = 0;

/// String(v) of the value at sp into tmp (cut where tmp ends); its length.
fn str_of(tmp: []u8, d: []const u8, sp: i64) -> u32 {
    const l : u32 = jv_str(tmp, 0, d, sp);
    if (l == OVER) { return 0; }
    return l;
}

/// A child of h(): missing, null and false add nothing, the rest is String(v) as escaped text.
fn put_kid(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    const k : u8 = kind(d, sp);
    if (k == J_NONE or k == J_NULL or k == J_FALSE) { return n0; }
    return jv_text(o, n0, d, sp);
}

/// Number(v) of the value at sp, the way `a + b` and `a < b` read a number (a missing value is NaN).
fn numv(d: []const u8, sp: i64) -> f64 {
    if (kind(d, sp) == J_NONE) { return js_nan(0.0); }
    return jv_num(d, sp);
}

fn ns_of(ps: f64) -> f64 {
    return ps / (K_PS_PER_NS as f64);
}

/// ns(ps): (ps / PS).toFixed(3).
fn put_ns(o: []u8, n0: u32, ps: f64) -> u32 {
    return js_to_fixed(o, n0, ns_of(ps), 3);
}

/// signed(ps): "+" for ps >= 0 (a null slack counts as 0), then ns(ps).
fn put_signed(o: []u8, n0: u32, ps: f64, is_null: bool) -> u32 {
    var n : u32 = n0;
    var v : f64 = ps;
    if (is_null) { v = 0.0; }
    if (v >= 0.0) { n = put(o, n, 43); }
    return put_ns(o, n, v);
}

/// +(x).toFixed(digits) as String(): the number the text reads back as.
fn put_fixed_num(o: []u8, n0: u32, x: f64, digits: u32) -> u32 {
    var tmp : [400]u8 = [0; 400];
    const l : u32 = js_to_fixed(tmp[0..], 0, x, digits);
    if (l == OVER) { return OVER; }
    const v : f64 = js_parse_num(tmp[0..], 0, l as usize);
    return js_str_num(o, n0, v);
}

fn dec_text(tmp: []u8, v: u64) -> u32 {
    return dec_to(tmp, v);
}

// --- reading the two shapes ---------------------------------------------------------------------------------

/// The value after the last "." of nothing: `str(i)` of fromOwn(): i >= 0 ? String(s[i] ?? '') : '', raw bytes.
fn put_str_idx(o: []u8, n0: u32, d: []const u8, strs: i64, idx: i64) -> u32 {
    const k : u8 = kind(d, idx);
    if (k != J_NUMBER) { return n0; }
    const v : f64 = jv_numval(d, idx);
    if (!(v >= 0.0)) { return n0; }
    if (v != js_floor(v) or v > 4294967000.0) { return n0; }
    const el : i64 = arr_at(d, strs, v as u32);
    const ek : u8 = kind(d, el);
    if (ek == J_NONE or ek == J_NULL) { return n0; }
    return jv_str(o, n0, d, el);
}

/// The value at sp is an array for `x.map(...)`; a falsy value stands for [] (`x || []`); other kinds throw (false).
fn list_ok(d: []const u8, sp: i64) -> bool {
    const k : u8 = kind(d, sp);
    if (k == J_ARRAY) { return true; }
    return !jv_truthy(d, sp);
}

/// Does the element at sp destructure as an array in `([a, b, ...]) =>`: an array does; a string is read as its
/// characters in JavaScript (not carried over); the others throw.
fn row_ok(d: []const u8, sp: i64) -> bool {
    const k : u8 = kind(d, sp);
    return k == J_ARRAY or k == J_STRING;
}

/// Object.entries(x) for the value at sp into FM_*: an object gives its members, an array its index as the key.
/// Returns false when an entry's value is null and tool.js dereferences it (own: v.achieved).
fn fmax_entries(d: []const u8, sp: i64, own: bool, store: bool) -> bool {
    if (store) { FM_N = 0; }
    if (!jv_truthy(d, sp)) { return true; }
    const k : u8 = kind(d, sp);
    if (k == J_OBJECT) {
        const hi : usize = span_hi(sp);
        var p : usize = skip_ws(d, span_lo(sp) + 1);

        while (p < hi and d[p] == 34 and (!store or FM_N < W_MAX_FMAX)) {
            const ke : usize = string_end(d, p);
            const q : usize = skip_ws(d, ke);
            const v : usize = skip_ws(d, q + 1);
            const ve : usize = value_end(d, v);
            const vs : i64 = jspan(v, ve);
            if (own and kind(d, vs) == J_NULL) { return false; }
            if (store) {
                FM_K[FM_N as usize] = jspan(p, ke);
                FM_A[FM_N as usize] = obj_get(d, vs, "achieved");
                FM_C[FM_N as usize] = obj_get(d, vs, "constraint");
                FM_KIDX[FM_N as usize] = 0;
                FM_N = FM_N + 1;
            }

            p = skip_ws(d, ve);
            if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
        }
        return true;
    }
    if (k == J_ARRAY) {
        const cnt : u32 = arr_len(d, sp);
        var i : u32 = 0;
        while (i < cnt and (!store or FM_N < W_MAX_FMAX)) {
            const vs : i64 = arr_at(d, sp, i);
            if (own and kind(d, vs) == J_NULL) { return false; }
            if (store) {
                FM_K[FM_N as usize] = NO_SPAN;
                FM_A[FM_N as usize] = obj_get(d, vs, "achieved");
                FM_C[FM_N as usize] = obj_get(d, vs, "constraint");
                FM_KIDX[FM_N as usize] = i;
                FM_N = FM_N + 1;
            }
            i = i + 1;
        }
    }
    return true;
}

/// The key of fmax entry i as raw text into tmp.
fn fm_key_raw(tmp: []u8, d: []const u8, i: u32) -> u32 {
    if (FM_K[i as usize] == NO_SPAN) { return dec_to(tmp, FM_KIDX[i as usize] as u64); }
    return jv_str_to(tmp, 0, d, FM_K[i as usize]);
}

/// Would tool.js throw while it builds the data of a timing.json (fromOwn) from the object at r?
fn own_throws(d: []const u8, r: i64) -> bool {
    const ps : i64 = obj_get(d, r, "paths");
    var hi : usize = 0;
    var p : usize = 0;
    if (kind(d, ps) == J_ARRAY) {
        hi = span_hi(ps);
        p = skip_ws(d, span_lo(ps) + 1);
    }
    while (p < hi and d[p] != 93) {
        const e : usize = value_end(d, p);
        const sp : i64 = jspan(p, e);
        if (kind(d, sp) == J_NULL) { return true; }
        const segs : i64 = obj_get(d, sp, "segs");
        if (!list_ok(d, segs)) { return true; }
        if (kind(d, segs) == J_ARRAY) {
            const sh : usize = span_hi(segs);
            var q : usize = skip_ws(d, span_lo(segs) + 1);
            while (q < sh and d[q] != 93) {
                const qe : usize = value_end(d, q);
                if (!row_ok(d, jspan(q, qe))) { return true; }
                q = skip_ws(d, qe);
                if (q < sh and d[q] == 44) { q = skip_ws(d, q + 1); }
            }
        }
        p = skip_ws(d, e);
        if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
    }
    return !fmax_entries(d, obj_get(d, r, "fmax"), true, false);
}

/// Would tool.js throw while it builds the data of a nextpnr report (fromReport)?
fn report_throws(d: []const u8, r: i64) -> bool {
    const cps : i64 = obj_get(d, r, "critical_paths");
    if (!list_ok(d, cps)) { return true; }
    if (kind(d, cps) == J_ARRAY) {
        const hi : usize = span_hi(cps);
        var p : usize = skip_ws(d, span_lo(cps) + 1);
        while (p < hi and d[p] != 93) {
            const e : usize = value_end(d, p);
            const cp : i64 = jspan(p, e);
            if (kind(d, cp) == J_NULL) { return true; }
            const path : i64 = obj_get(d, cp, "path");
            if (!list_ok(d, path)) { return true; }
            if (kind(d, path) == J_ARRAY) {
                const sh : usize = span_hi(path);
                var q : usize = skip_ws(d, span_lo(path) + 1);
                while (q < sh and d[q] != 93) {
                    const qe : usize = value_end(d, q);
                    if (kind(d, jspan(q, qe)) == J_NULL) { return true; }
                    q = skip_ws(d, qe);
                    if (q < sh and d[q] == 44) { q = skip_ws(d, q + 1); }
                }
            }
            p = skip_ws(d, e);
            if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
        }
    }
    return !fmax_entries(d, obj_get(d, r, "fmax"), false, false);
}

/// The segment list of the path at sp, or NO_SPAN: own "segs", report "path".
fn segs_of(d: []const u8, sp: i64) -> i64 {
    if (DS_FMT == 1) { return obj_get(d, sp, "segs"); }
    return obj_get(d, sp, "path");
}

/// A segment's kind value, its time in ps and whether it is routing: own [kind, ps, ...], report {type, delay, ...}.
fn seg_kind(d: []const u8, g: i64) -> i64 {
    if (DS_FMT == 1) { return arr_at(d, g, 0); }
    return obj_get(d, g, "type");
}

fn seg_ps(d: []const u8, g: i64) -> f64 {
    if (DS_FMT == 1) { return numv(d, arr_at(d, g, 1)); }
    const dl : i64 = obj_get(d, g, "delay");
    var v : f64 = 0.0;
    if (jv_truthy(d, dl)) { v = numv(d, dl); }
    return js_round(v * (K_PS_PER_NS as f64));
}

fn seg_is_routing(d: []const u8, g: i64) -> bool {
    return jv_is(d, seg_kind(d, g), "routing");
}

/// colorOf(kind): the colour of the type the value equals, else the colour of "logic".
fn put_color(o: []u8, n0: u32, d: []const u8, ksp: i64) -> u32 {
    var i : usize = 0;
    while (i < K_SEG_TYPES.len) {
        if (jv_is(d, ksp, K_SEG_TYPES[i])) { return jn_raw(o, n0, K_SEG_COLORS[i]); }
        i = i + 1;
    }
    return jn_raw(o, n0, K_SEG_COLORS[2]);
}

/// The key a path sorts by: slack ?? -total.
fn sort_key(i: u32) -> f64 {
    if (SLN[i as usize] != 0) { return 0.0 - TOT[i as usize]; }
    return SLK[i as usize];
}

/// ORD[0..n] in file order, then a stable merge sort by sort_key (Array.prototype.sort is stable).
fn sort_paths(cnt: u32) -> u32 {
    var i : u32 = 0;
    while (i < cnt) {
        ORD[i as usize] = i;
        i = i + 1;
    }
    var w : u32 = 1;
    while (w < cnt) {
        var lo : u32 = 0;
        while (lo < cnt) {
            var mid : u32 = lo + w;
            if (mid > cnt) { mid = cnt; }
            var hi : u32 = lo + w + w;
            if (hi > cnt) { hi = cnt; }
            var a : u32 = lo;
            var b : u32 = mid;
            var k : u32 = lo;
            while (a < mid and b < hi) {
                if (sort_key(ORD[b as usize]) - sort_key(ORD[a as usize]) < 0.0) {
                    TMPO[k as usize] = ORD[b as usize];
                    b = b + 1;
                } else {
                    TMPO[k as usize] = ORD[a as usize];
                    a = a + 1;
                }
                k = k + 1;
            }
            while (a < mid) {
                TMPO[k as usize] = ORD[a as usize];
                a = a + 1;
                k = k + 1;
            }
            while (b < hi) {
                TMPO[k as usize] = ORD[b as usize];
                b = b + 1;
                k = k + 1;
            }
            lo = lo + w + w;
        }
        var c : u32 = 0;
        while (c < cnt) {
            ORD[c as usize] = TMPO[c as usize];
            c = c + 1;
        }
        w = w + w;
    }
    return 0;
}

/// Is String(a) equal to the decoded key of fmax entry i.
fn fm_key_is(d: []const u8, i: u32, v: i64) -> bool {
    var a : [1100]u8 = [0; 1100];
    var b : [1100]u8 = [0; 1100];
    const al : u32 = fm_key_raw(a[0..], d, i);
    const bl : u32 = str_of(b[0..], d, v);
    if (al != bl) { return false; }
    var k : u32 = 0;
    while (k < al) {
        if (a[k as usize] != b[k as usize]) { return false; }
        k = k + 1;
    }
    return true;
}

/// cons[key] ?? ...: the constraint of the clock named by the value at v, or NO_SPAN.
fn fm_constraint_of(d: []const u8, v: i64) -> i64 {
    var i : u32 = 0;
    var res : i64 = NO_SPAN;
    while (i < FM_N) {
        if (fm_key_is(d, i, v)) { res = FM_C[i as usize]; }
        i = i + 1;
    }
    return res;
}

fn present(d: []const u8, sp: i64) -> bool {
    const k : u8 = kind(d, sp);
    return k != J_NONE and k != J_NULL;
}

/// Build the data of the active buffer: DS_*, the paths' totals and the sorted order. fmt 1 timing.json, 2 report.
/// The checks of own_throws / report_throws have passed.
fn build_ds(fmt: u32, label: []const u8) -> u32 {
    DS_FMT = fmt;
    DS_LABEL_LEN = copy_into(DS_LABEL[0..], 0, label);
    const d : []const u8 = ds_bytes();
    const r : i64 = root(d);
    DS_ROOT = r;
    DS_N = 0;
    DS_HAS_PERIOD = false;
    DS_PERIOD = 0.0;
    var lst : i64 = NO_SPAN;
    if (fmt == 1) { lst = obj_get(d, r, "paths"); } else { lst = obj_get(d, r, "critical_paths"); }
    fmax_entries(d, obj_get(d, r, "fmax"), fmt == 1, true);
    if (fmt == 1) {
        const pp : i64 = obj_get(d, r, "period_ps");
        if (jv_truthy(d, pp)) {
            DS_HAS_PERIOD = true;
            DS_PERIOD = numv(d, pp);
        }
    }
    // the single fmax constraint, when there is exactly one clock
    var one : i64 = NO_SPAN;
    if (FM_N == 1) { one = FM_C[0]; }
    var any_period : bool = false;
    var min_period : f64 = 0.0;
    if (kind(d, lst) == J_ARRAY) {
        const hi : usize = span_hi(lst);
        var p : usize = skip_ws(d, span_lo(lst) + 1);
        while (p < hi and d[p] != 93 and DS_N < W_MAX_PATHS) {
            const e : usize = value_end(d, p);
            const sp : i64 = jspan(p, e);
            const i : u32 = DS_N;
            PSP[i as usize] = sp;
            var total : f64 = 0.0;
            var rout : f64 = 0.0;
            const segs : i64 = segs_of(d, sp);
            if (kind(d, segs) == J_ARRAY) {
                const sh : usize = span_hi(segs);
                var q : usize = skip_ws(d, span_lo(segs) + 1);
                while (q < sh and d[q] != 93) {
                    const qe : usize = value_end(d, q);
                    const g : i64 = jspan(q, qe);
                    const ps : f64 = seg_ps(d, g);
                    total = total + ps;
                    if (seg_is_routing(d, g)) { rout = rout + ps; }
                    q = skip_ws(d, qe);
                    if (q < sh and d[q] == 44) { q = skip_ws(d, q + 1); }
                }
            }
            TOT[i as usize] = total;
            ROU[i as usize] = rout;
            SLN[i as usize] = 1;
            SLK[i as usize] = 0.0;
            if (fmt == 1) {
                const sl : i64 = obj_get(d, sp, "slack");
                if (present(d, sl)) {
                    SLN[i as usize] = 0;
                    SLK[i as usize] = numv(d, sl);
                }
            } else {
                // c = cons[cp.to] ?? cons[cp.from] ?? one; period = c ? Math.round(1e6 / c) : null
                var c : i64 = fm_constraint_of(d, obj_get(d, sp, "to"));
                if (!present(d, c)) { c = fm_constraint_of(d, obj_get(d, sp, "from")); }
                if (!present(d, c)) { c = one; }
                if (jv_truthy(d, c)) {
                    const period : f64 = js_round(1000000.0 / numv(d, c));
                    if (period == period and period != 0.0) {
                        if (!any_period or period < min_period) { min_period = period; }
                        any_period = true;
                        SLN[i as usize] = 0;
                        SLK[i as usize] = period - total;
                    }
                }
            }
            DS_N = DS_N + 1;
            p = skip_ws(d, e);
            if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
        }
    }
    if (fmt == 2 and any_period) {
        DS_HAS_PERIOD = true;
        DS_PERIOD = min_period;
    }
    sort_paths(DS_N);
    return 0;
}

/// The path at row k (sorted order) of the data.
fn row_path(k: u32) -> u32 {
    return ORD[k as usize];
}

/// p.slack !== null && p.slack < 0 for the path at file index i.
fn path_fails(i: u32) -> bool {
    return SLN[i as usize] == 0 and SLK[i as usize] < 0.0;
}

/// The label of a demo: j.source?.top || '' as text; fills DS_LABEL through build_ds.
fn demo_label(tmp: []u8, d: []const u8, r: i64) -> u32 {
    const t : i64 = obj_get(d, obj_get(d, r, "source"), "top");
    if (!jv_truthy(d, t)) { return 0; }
    return str_of(tmp, d, t);
}

// --- the libm memo and the text width memo -------------------------------------------------------------------

/// op 4 Math.log10(a), op 5 Math.pow(a, b): from the memo, else asked of the host (a miss makes the list wrong).
fn libm2(op: u32, a: f64, b: f64) -> f64 {
    var i : u32 = 0;
    while (i < LB_N) {
        if ((LB_OP[i as usize] as u32) == op and LB_A[i as usize] == a and LB_B[i as usize] == b) { return LB_R[i as usize]; }
        i = i + 1;
    }
    MISSING = true;
    var j : u32 = 0;
    while (j < RQ_N) {
        if ((RQ_OP[j as usize] as u32) == op and RQ_A[j as usize] == a and RQ_B[j as usize] == b) { return 0.0; }
        j = j + 1;
    }
    if (RQ_N < 64) {
        RQ_OP[RQ_N as usize] = op as u8;
        RQ_A[RQ_N as usize] = a;
        RQ_B[RQ_N as usize] = b;
        RQ_N = RQ_N + 1;
    }
    return 0.0;
}

pub fn w_libm_need(dst: []f64) -> u32 {
    if (RQ_N == 0) { return 0; }
    var k : u32 = 0;
    while (k < RQ_N and ((k * 3 + 2) as usize) < dst.len) {
        dst[(k * 3) as usize] = RQ_OP[k as usize] as f64;
        dst[(k * 3 + 1) as usize] = RQ_A[k as usize];
        dst[(k * 3 + 2) as usize] = RQ_B[k as usize];
        k = k + 1;
    }
    RQ_SENT = k;
    return k;
}

pub fn w_libm_give(src: []const f64, n: u32) -> u32 {
    var k : u32 = 0;
    while (k < n and k < RQ_SENT and (k as usize) < src.len) {
        if (LB_N >= 64) { LB_N = 0; }
        LB_OP[LB_N as usize] = RQ_OP[k as usize];
        LB_A[LB_N as usize] = RQ_A[k as usize];
        LB_B[LB_N as usize] = RQ_B[k as usize];
        LB_R[LB_N as usize] = src[k as usize];
        LB_N = LB_N + 1;
        k = k + 1;
    }
    RQ_N = 0;
    RQ_SENT = 0;
    MISSING = false;
    return 0;
}

fn x_same(off: u32, len: u32, s: []const u8) -> bool {
    if (len != (s.len as u32)) { return false; }
    var k : u32 = 0;
    while (k < len) {
        if (X_POOL[(off + k) as usize] != s[k as usize]) { return false; }
        k = k + 1;
    }
    return true;
}

/// ctx.measureText(text).width under the font: from the memo, else asked of the host and read as 0 for now.
fn x_width(font: []const u8, text: []const u8) -> f64 {
    var i : u32 = 0;
    while (i < X_N) {
        if (x_same(X_FO[i as usize], X_FL[i as usize], font) and x_same(X_TO[i as usize], X_TL[i as usize], text)) {
            if (X_ST[i as usize] == 2) { return X_W[i as usize]; }
            X_MISS = true;
            return 0.0;
        }
        i = i + 1;
    }
    X_MISS = true;
    if (X_N >= 256 or X_POOL_N + (font.len as u32) + (text.len as u32) > 16384) {
        X_N = 0;
        X_POOL_N = 0;
    }
    if ((font.len as u32) + (text.len as u32) > 16384) { return 0.0; }
    const e : u32 = X_N;
    X_FO[e as usize] = X_POOL_N;
    X_FL[e as usize] = font.len as u32;
    X_POOL_N = copy_into(X_POOL[0..], X_POOL_N, font);
    X_TO[e as usize] = X_POOL_N;
    X_TL[e as usize] = text.len as u32;
    X_POOL_N = copy_into(X_POOL[0..], X_POOL_N, text);
    X_ST[e as usize] = 0;
    X_N = e + 1;
    return 0.0;
}

fn put_u32le(dst: []u8, at: u32, v: u32) -> u32 {
    dst[at as usize] = (v % 256) as u8;
    dst[(at + 1) as usize] = ((v / 256) % 256) as u8;
    dst[(at + 2) as usize] = ((v / 65536) % 256) as u8;
    dst[(at + 3) as usize] = ((v / 16777216) % 256) as u8;
    return at + 4;
}

/// Requests for the host: records of (u32 font length, u32 text length, font bytes, text bytes). The count.
pub fn w_text_need(dst: []u8) -> u32 {
    var n : u32 = 0;
    var c : u32 = 0;
    var i : u32 = 0;
    while (i < X_N) {
        if (X_ST[i as usize] == 0) {
            const need : u32 = 8 + X_FL[i as usize] + X_TL[i as usize];
            if ((n as usize) + (need as usize) > dst.len) { return c; }
            n = put_u32le(dst, n, X_FL[i as usize]);
            n = put_u32le(dst, n, X_TL[i as usize]);
            var k : u32 = 0;
            while (k < X_FL[i as usize]) {
                dst[(n + k) as usize] = X_POOL[(X_FO[i as usize] + k) as usize];
                k = k + 1;
            }
            n = n + X_FL[i as usize];
            k = 0;
            while (k < X_TL[i as usize]) {
                dst[(n + k) as usize] = X_POOL[(X_TO[i as usize] + k) as usize];
                k = k + 1;
            }
            n = n + X_TL[i as usize];
            X_ST[i as usize] = 1;
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

pub fn w_text_give(src: []const f64, n: u32) -> u32 {
    var i : u32 = 0;
    var k : u32 = 0;
    while (i < X_N and k < n and (k as usize) < src.len) {
        if (X_ST[i as usize] == 1) {
            X_W[i as usize] = src[k as usize];
            X_ST[i as usize] = 2;
            k = k + 1;
        }
        i = i + 1;
    }
    X_MISS = false;
    return 0;
}

// --- layout: tool.js's layout() and niceStep() ------------------------------------------------------------------

/// The step between axis labels, in ps: the first of 1, 2, 5, 10 times a power of ten that reaches range / (px / 70).
fn nice_step(range: f64, px: f64) -> f64 {
    const target : f64 = range / js_max(2.0, px / 70.0);
    const lg : f64 = libm2(4, target, 0.0);
    const p : f64 = libm2(5, 10.0, js_floor(lg));
    if (1.0 * p >= target) { return 1.0 * p; }
    if (2.0 * p >= target) { return 2.0 * p; }
    if (5.0 * p >= target) { return 5.0 * p; }
    if (10.0 * p >= target) { return 10.0 * p; }
    return p * 10.0;
}

fn dpr_now() -> f64 {
    if (ENV_DPR == 0.0 or ENV_DPR != ENV_DPR) { return 1.0; }
    return ENV_DPR;
}

/// layout(): the row height, the canvas size and style, the box's max-height, the x range.
fn do_layout() -> u32 {
    const n : f64 = DS_N as f64;
    var max_h : f64 = 0.0;
    if (ENV_EMBED != 0) {
        max_h = js_max(120.0, ENV_IH - 265.0);
    } else {
        max_h = js_min(560.0, js_max(240.0, ENV_IH * 0.6));
    }
    ROW_H = 0.0;
    if (DS_N > 0) { ROW_H = js_max(2.0, js_min(7.0, js_floor((max_h - W_AXIS) / n))); }
    CSS_W = ENV_BW;
    if (CSS_W == 0.0 or CSS_W != CSS_W) { CSS_W = 600.0; }
    const css_h : f64 = W_AXIS + js_max(1.0, n) * ROW_H + 2.0;
    const dpr : f64 = dpr_now();
    CV_MAXH = js_round(max_h) as u64;
    CV_W = js_round(CSS_W * dpr) as u64;
    CV_H = js_round(css_h * dpr) as u64;
    CV_SH = css_h as u64;
    CV_SET = true;
    var worst : f64 = 1.0;
    if (DS_N > 0) {
        worst = TOT[0];
        var i : u32 = 1;
        while (i < DS_N) {
            worst = js_max(worst, TOT[i as usize]);
            i = i + 1;
        }
    }
    if (FULL and DS_HAS_PERIOD) {
        X_MAX = js_max(DS_PERIOD, worst) * 1.02;
    } else {
        X_MAX = worst * 1.06;
    }
    return 0;
}

// --- the binary draw list -------------------------------------------------------------------------------------

fn bw_b(o: []u8, n: u32, b: u8) -> u32 {
    if (n == OVER or (n as usize) >= o.len) { return OVER; }
    o[n as usize] = b;
    return n + 1;
}

fn f64_bits(x: f64) -> u64 {
    if (x == 0.0) {
        if ((1.0 / x) < 0.0) { return 9223372036854775808; }
        return 0;
    }
    var sign : u64 = 0;
    var ax : f64 = x;
    if (x < 0.0) {
        sign = 9223372036854775808;
        ax = 0.0 - x;
    }
    const m : u64 = jn_mant(ax);
    const e : i32 = jn_expo(ax);
    const be : u64 = ((e + 52 + 1023) as u64);
    return sign + be * 4503599627370496 + (m - 4503599627370496);
}

fn bw_f(o: []u8, n0: u32, x: f64) -> u32 {
    var bits : u64 = f64_bits(x);
    var n : u32 = n0;
    var k : u32 = 0;
    while (k < 8) {
        n = bw_b(o, n, (bits % 256) as u8);
        bits = bits / 256;
        k = k + 1;
    }
    return n;
}

fn bw_s(o: []u8, n0: u32, s: []const u8) -> u32 {
    var n : u32 = bw_b(o, n0, (s.len % 256) as u8);
    n = bw_b(o, n, ((s.len / 256) % 256) as u8);
    var k : usize = 0;
    while (k < s.len) {
        n = bw_b(o, n, s[k]);
        k = k + 1;
    }
    return n;
}

fn bw_set_s(o: []u8, n0: u32, op: u8, v: []const u8) -> u32 {
    const n : u32 = bw_b(o, n0, op);
    return bw_s(o, n, v);
}

fn bw_set_f(o: []u8, n0: u32, op: u8, v: f64) -> u32 {
    const n : u32 = bw_b(o, n0, op);
    return bw_f(o, n, v);
}

fn bw_rect(o: []u8, n0: u32, op: u8, a: f64, b: f64, c: f64, d: f64) -> u32 {
    var n : u32 = bw_b(o, n0, op);
    n = bw_f(o, n, a);
    n = bw_f(o, n, b);
    n = bw_f(o, n, c);
    return bw_f(o, n, d);
}

fn bw_text(o: []u8, n0: u32, s: []const u8, x: f64, y: f64) -> u32 {
    var n : u32 = bw_b(o, n0, 13);
    n = bw_s(o, n, s);
    n = bw_f(o, n, x);
    return bw_f(o, n, y);
}

/// The font `10px ${getComputedStyle(root).getPropertyValue('--w-mono') || 'monospace'}` into f: the variable stands
/// for itself between byte 4 and byte 6, its fallback after byte 5 (the host does not trim the value).
fn font_into(f: []u8) -> u32 {
    var n : u32 = copy_into(f, 0, "10px ");
    f[n as usize] = 4;
    n = copy_into(f, n + 1, W_MONO_VAR);
    f[n as usize] = 5;
    n = copy_into(f, n + 1, W_MONO_FB);
    f[n as usize] = 6;
    return n + 1;
}

fn x_of(ps: f64) -> f64 {
    return (ps / X_MAX) * (CSS_W - 2.0) + 1.0;
}

/// The waterfall: what draw() paints on the canvas, call for call.
pub fn w_bdraw(o: []u8) -> u32 {
    if (!RENDERED or DS_N == 0 or CUR == 0 or !CV_SET) { return 0; }
    const d : []const u8 = ds_bytes();
    const dpr : f64 = dpr_now();
    const css_h : f64 = (CV_H as f64) / dpr;
    var n : u32 = bw_b(o, 0, 200);
    n = bw_b(o, n, 0);
    n = bw_b(o, n, 12);
    n = bw_f(o, n, dpr);
    n = bw_f(o, n, 0.0);
    n = bw_f(o, n, 0.0);
    n = bw_f(o, n, dpr);
    n = bw_f(o, n, 0.0);
    n = bw_f(o, n, 0.0);
    n = bw_set_s(o, n, 32, "#000");
    n = bw_rect(o, n, 10, 0.0, 0.0, CSS_W, css_h);
    // axis
    MISSING = false;
    const step : f64 = nice_step(X_MAX, CSS_W);
    if (MISSING) { return 0; }
    var font : [160]u8 = [0; 160];
    const fl : u32 = font_into(font[0..]);
    n = bw_b(o, n, 35);
    n = bw_s(o, n, font[0..(fl as usize)]);
    n = bw_set_s(o, n, 36, "middle");
    var t : f64 = 0.0;
    var guard : u32 = 0;
    while (t <= X_MAX and step > 0.0 and guard < 100000) {
        const px : f64 = js_round(x_of(t)) + 0.5;
        n = bw_set_s(o, n, 32, "rgba(0,255,136,0.12)");
        n = bw_rect(o, n, 10, px, W_AXIS, 1.0, css_h - W_AXIS);
        n = bw_set_s(o, n, 32, "#8fa9a0");
        var lb : [64]u8 = [0; 64];
        var ll : u32 = put_fixed_num(lb[0..], 0, t / (K_PS_PER_NS as f64), 3);
        var lab : [160]u8 = [0; 160];
        var vb : [96]u8 = [0; 96];
        var vn : u32 = jv_vput_str(vb[0..], 0, "0", lb[0..(ll as usize)]);
        var al : u32 = jv_fill_raw(lab[0..], 0, SAY_AXIS, vb[0..], vn, true);
        if (al == OVER) { al = 0; }
        const w : f64 = x_width(font[0..(fl as usize)], lab[0..(al as usize)]);
        if (px + 2.0 + w < CSS_W) { n = bw_text(o, n, lab[0..(al as usize)], px + 2.0, W_AXIS / 2.0); }
        t = t + step;
        guard = guard + 1;
    }
    // rows
    var gap : f64 = 0.0;
    if (ROW_H >= 4.0) { gap = 1.0; }
    var row : u32 = 0;
    while (row < DS_N) {
        const pi : u32 = ORD[row as usize];
        const y : f64 = W_AXIS + (row as f64) * ROW_H;
        const hgt : f64 = ROW_H - gap;
        if (DS_HAS_PERIOD and TOT[pi as usize] < DS_PERIOD) {
            n = bw_set_s(o, n, 32, K_SLACK_COLOR);
            n = bw_rect(o, n, 10, x_of(TOT[pi as usize]), y, x_of(DS_PERIOD) - x_of(TOT[pi as usize]), hgt);
        }
        var tt : f64 = 0.0;
        const segs : i64 = segs_of(d, PSP[pi as usize]);
        if (kind(d, segs) == J_ARRAY) {
            const sh : usize = span_hi(segs);
            var q : usize = skip_ws(d, span_lo(segs) + 1);
            var k : u32 = 0;
            while (q < sh and d[q] != 93) {
                const qe : usize = value_end(d, q);
                const g : i64 = jspan(q, qe);
                var col : [16]u8 = [0; 16];
                const cl : u32 = put_color(col[0..], 0, d, seg_kind(d, g));
                n = bw_set_s(o, n, 32, col[0..(cl as usize)]);
                if (k % 2 == 1) { n = bw_set_f(o, n, 38, 0.78); } else { n = bw_set_f(o, n, 38, 1.0); }
                const ps : f64 = seg_ps(d, g);
                n = bw_rect(o, n, 10, x_of(tt), y, js_max(0.6, x_of(tt + ps) - x_of(tt)), hgt);
                tt = tt + ps;
                k = k + 1;
                q = skip_ws(d, qe);
                if (q < sh and d[q] == 44) { q = skip_ws(d, q + 1); }
            }
        }
        n = bw_set_f(o, n, 38, 1.0);
        if (path_fails(pi)) {
            var per : f64 = 0.0;
            if (DS_HAS_PERIOD) { per = DS_PERIOD; }
            n = bw_set_s(o, n, 32, K_FAIL_COLOR);
            n = bw_rect(o, n, 10, x_of(per), y, x_of(TOT[pi as usize]) - x_of(per), hgt);
            n = bw_rect(o, n, 10, 0.0, y, 3.0, hgt);
        }
        row = row + 1;
    }
    // period line
    if (DS_HAS_PERIOD and DS_PERIOD <= X_MAX) {
        n = bw_set_s(o, n, 32, K_FAIL_COLOR);
        n = bw_rect(o, n, 10, js_round(x_of(DS_PERIOD)) - 1.0, 0.0, 2.0, css_h);
    }
    // the picked row
    const py : f64 = W_AXIS + (PICK as f64) * ROW_H;
    n = bw_set_s(o, n, 33, "#e8fff7");
    n = bw_set_f(o, n, 34, 1.0);
    n = bw_rect(o, n, 11, 0.5, py - 1.5, CSS_W - 1.0, ROW_H + 2.0);
    if (n == OVER) { return 0; }
    return n;
}

// --- text pieces: tool.js's fmt() and the detail of one path -----------------------------------------------------

fn pool_dec(vb: []u8, n0: u32, key: []const u8, v: u64) -> u32 {
    var tmp : [32]u8 = [0; 32];
    const l : u32 = dec_to(tmp[0..], v);
    return jv_vput_str(vb, n0, key, tmp[0..(l as usize)]);
}

/// `${g.from.cell}.${g.from.port}` (report) or `${str(f)}.${fp}` (own) as raw bytes; the segment's from (cell 2, 3),
/// to (cell 4, 5) or a report segment's "from" / "to" object.
fn seg_end_raw(tmp: []u8, d: []const u8, g: i64, which: u32) -> u32 {
    if (DS_FMT == 1) {
        const strs : i64 = obj_get(d, DS_ROOT, "strings");
        var base : u32 = 2;
        if (which == 1) { base = 4; }
        var n : u32 = put_str_idx(tmp, 0, d, strs, arr_at(d, g, base));
        n = put(tmp, n, 46);
        return jv_str(tmp, n, d, arr_at(d, g, base + 1));
    }
    var key : []const u8 = "from";
    if (which == 1) { key = "to"; }
    const e : i64 = obj_get(d, g, key);
    if (!jv_truthy(d, e)) { return 0; }
    var n : u32 = jv_str(tmp, 0, d, obj_get(d, e, "cell"));
    n = put(tmp, n, 46);
    return jv_str(tmp, n, d, obj_get(d, e, "port"));
}

fn seg_net_raw(tmp: []u8, d: []const u8, g: i64) -> u32 {
    if (DS_FMT == 1) {
        return put_str_idx(tmp, 0, d, obj_get(d, DS_ROOT, "strings"), arr_at(d, g, 6));
    }
    const nt : i64 = obj_get(d, g, "net");
    if (!jv_truthy(d, nt)) { return 0; }
    return jv_str(tmp, 0, d, nt);
}

/// The last segment of a path, or NO_SPAN.
fn last_seg(d: []const u8, sp: i64) -> i64 {
    const segs : i64 = segs_of(d, sp);
    if (kind(d, segs) != J_ARRAY) { return NO_SPAN; }
    const c : u32 = arr_len(d, segs);
    if (c == 0) { return NO_SPAN; }
    return arr_at(d, segs, c - 1);
}

/// `${cp.from} -> ${cp.to}` of a report path as raw bytes.
fn clocks_raw(tmp: []u8, d: []const u8, sp: i64) -> u32 {
    var n : u32 = jv_str(tmp, 0, d, obj_get(d, sp, "from"));
    n = copy_into(tmp, n, " -> ");
    return jv_str(tmp, n, d, obj_get(d, sp, "to"));
}

/// The path's `to` as raw bytes: own `${str(p.to)}.${p.pin}`, report the last segment's to, else its clocks.
fn path_to_raw(tmp: []u8, d: []const u8, sp: i64) -> u32 {
    if (DS_FMT == 1) {
        var n : u32 = put_str_idx(tmp, 0, d, obj_get(d, DS_ROOT, "strings"), obj_get(d, sp, "to"));
        n = put(tmp, n, 46);
        return jv_str(tmp, n, d, obj_get(d, sp, "pin"));
    }
    const last : i64 = last_seg(d, sp);
    if (last == NO_SPAN) { return clocks_raw(tmp, d, sp); }
    return seg_end_raw(tmp, d, last, 1);
}

/// showDetail(): the title, the line and the table of the picked path, into o.
fn put_detail(o: []u8, n0: u32) -> u32 {
    const d : []const u8 = ds_bytes();
    const pi : u32 = ORD[PICK as usize];
    const sp : i64 = PSP[pi as usize];
    const failed : bool = path_fails(pi);
    var n : u32 = raw(o, n0, "<p class=\"sw-title");
    if (failed) { n = raw(o, n, " is-fail"); }
    n = raw(o, n, "\">");
    var vb : [8192]u8 = [0; 8192];
    var vn : u32 = pool_dec(vb[0..], 0, "0", (PICK + 1) as u64);
    vn = pool_dec(vb[0..], vn, "1", DS_N as u64);
    var xt : [4200]u8 = [0; 4200];
    var xl : u32 = path_to_raw(xt[0..], d, sp);
    if (DS_FMT == 2) {
        xl = copy_into(xt[0..], xl, " (");
        var ck : [2200]u8 = [0; 2200];
        const cl : u32 = clocks_raw(ck[0..], d, sp);
        xl = copy_into(xt[0..], xl, ck[0..(cl as usize)]);
        xl = copy_into(xt[0..], xl, ")");
    }
    vn = jv_vput_str(vb[0..], vn, "2", xt[0..(xl as usize)]);
    if (vn == OVER) { return OVER; }
    n = jv_fill(o, n, SAY_PATH_TITLE, vb[0..], vn, true);
    n = raw(o, n, "</p><p class=\"sw-line");
    if (failed) { n = raw(o, n, " is-fail"); }
    n = raw(o, n, "\">");
    var v2 : [8192]u8 = [0; 8192];
    var tn : u32 = 0;
    var t0 : [64]u8 = [0; 64];
    var t1 : [64]u8 = [0; 64];
    var t2 : [64]u8 = [0; 64];
    var t3 : [64]u8 = [0; 64];
    const l0 : u32 = put_ns(t0[0..], 0, TOT[pi as usize]);
    const l1 : u32 = put_ns(t1[0..], 0, TOT[pi as usize] - ROU[pi as usize]);
    const l2 : u32 = put_ns(t2[0..], 0, ROU[pi as usize]);
    tn = jv_vput_str(v2[0..], 0, "0", t0[0..(l0 as usize)]);
    tn = jv_vput_str(v2[0..], tn, "1", t1[0..(l1 as usize)]);
    tn = jv_vput_str(v2[0..], tn, "2", t2[0..(l2 as usize)]);
    if (SLN[pi as usize] == 0) {
        const l3 : u32 = put_signed(t3[0..], 0, SLK[pi as usize], false);
        tn = jv_vput_str(v2[0..], tn, "3", t3[0..(l3 as usize)]);
        n = jv_fill(o, n, SAY_PATH_LINE, v2[0..], tn, true);
    } else {
        n = jv_fill(o, n, SAY_PATH_LINE_NO_PERIOD, v2[0..], tn, true);
    }
    n = raw(o, n, "</p><div class=\"sw-table\"><table><thead><tr>");
    var h : usize = 0;
    while (h < 5) {
        n = raw(o, n, "<th>");
        n = text(o, n, SAY_SEG_HEAD[h]);
        n = raw(o, n, "</th>");
        h = h + 1;
    }
    n = raw(o, n, "</tr></thead><tbody>");
    const segs : i64 = segs_of(d, sp);
    if (kind(d, segs) == J_ARRAY) {
        const sh : usize = span_hi(segs);
        var q : usize = skip_ws(d, span_lo(segs) + 1);
        while (q < sh and d[q] != 93) {
            const qe : usize = value_end(d, q);
            const g : i64 = jspan(q, qe);
            n = raw(o, n, "<tr><td><i style=\"background:");
            var col : [16]u8 = [0; 16];
            const cl : u32 = put_color(col[0..], 0, d, seg_kind(d, g));
            n = raw(o, n, col[0..(cl as usize)]);
            n = raw(o, n, "\"></i>");
            if (DS_FMT == 1) {
                n = put_kid(o, n, d, seg_kind(d, g));
            } else {
                if (jv_truthy(d, seg_kind(d, g))) { n = jv_text(o, n, d, seg_kind(d, g)); }
            }
            n = raw(o, n, "</td><td class=\"sw-num\">");
            n = put_ns(o, n, seg_ps(d, g));
            n = raw(o, n, "</td><td>");
            var cell : [4200]u8 = [0; 4200];
            var cn : u32 = seg_end_raw(cell[0..], d, g, 0);
            n = text(o, n, cell[0..(cn as usize)]);
            n = raw(o, n, "</td><td>");
            cn = seg_end_raw(cell[0..], d, g, 1);
            n = text(o, n, cell[0..(cn as usize)]);
            n = raw(o, n, "</td><td>");
            cn = seg_net_raw(cell[0..], d, g);
            n = text(o, n, cell[0..(cn as usize)]);
            n = raw(o, n, "</td></tr>");
            q = skip_ws(d, qe);
            if (q < sh and d[q] == 44) { q = skip_ws(d, q + 1); }
        }
    }
    return raw(o, n, "</tbody></table></div>");
}

/// The fmax table into o.
fn put_fmax(o: []u8, n0: u32) -> u32 {
    const d : []const u8 = ds_bytes();
    var n : u32 = raw(o, n0, "<table><thead><tr>");
    var h : usize = 0;
    while (h < 4) {
        n = raw(o, n, "<th>");
        n = text(o, n, SAY_FMAX_HEAD[h]);
        n = raw(o, n, "</th>");
        h = h + 1;
    }
    n = raw(o, n, "</tr></thead><tbody>");
    var i : u32 = 0;
    while (i < FM_N) {
        const a : i64 = FM_A[i as usize];
        const c : i64 = FM_C[i as usize];
        const cpos : bool = numv(d, c) > 0.0;
        const good : bool = !cpos or numv(d, a) >= numv(d, c);
        n = raw(o, n, "<tr><td>");
        var kt : [1100]u8 = [0; 1100];
        const kl : u32 = fm_key_raw(kt[0..], d, i);
        n = text(o, n, kt[0..(kl as usize)]);
        n = raw(o, n, "</td><td class=\"sw-num\">");
        if (!present(d, a)) { n = put(o, n, 45); } else { n = js_to_fixed(o, n, numv(d, a), 2); }
        n = raw(o, n, "</td><td class=\"sw-num\">");
        if (!present(d, c)) { n = put(o, n, 45); } else { n = js_to_fixed(o, n, numv(d, c), 2); }
        if (good) { n = raw(o, n, "</td><td class=\"sw-pass\">"); } else { n = raw(o, n, "</td><td class=\"sw-fail\">"); }
        if (cpos) {
            if (good) { n = text(o, n, SAY_PASS); } else { n = text(o, n, SAY_FAIL); }
        }
        n = raw(o, n, "</td></tr>");
        i = i + 1;
    }
    return raw(o, n, "</tbody></table>");
}

/// UTF-16 length of the decoded string at sp.
fn utf16_len(d: []const u8, sp: i64) -> u32 {
    const l : u32 = str_len(d, sp);
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < l) {
        const b : u8 = str_byte(d, sp, i);
        if (b < 128 or b >= 192) {
            n = n + 1;
            if (b >= 240) { n = n + 1; }
        }
        i = i + 1;
    }
    return n;
}

/// The check line of a timing.json into o (escaped), as fmt(SAY_CHECK_LINE, ...).
fn put_check(o: []u8, n0: u32) -> u32 {
    const d : []const u8 = ds_bytes();
    const c : i64 = obj_get(d, DS_ROOT, "check");
    var vb : [8192]u8 = [0; 8192];
    var vn : u32 = 0;
    var k : u32 = 0;
    while (k < 3) {
        var key : []const u8 = "nextpnr_critical_total_ns";
        if (k == 1) { key = "nextpnr_critical_endpoint"; }
        if (k == 2) { key = "sdf_worst_total_ps"; }
        const v : i64 = obj_get(d, c, key);
        var kb : [2]u8 = [0; 2];
        kb[0] = 48 + (k as u8);
        if (present(d, v)) { vn = jv_vput_val(vb[0..], vn, kb[0..1], d, v); } else { vn = jv_vput_str(vb[0..], vn, kb[0..1], ""); }
        k = k + 1;
    }
    const h : i64 = obj_get(d, c, "nextpnr_histogram");
    var have_bins : bool = true;
    var bins : u32 = 0;
    if (jv_truthy(d, h)) {
        const hk : u8 = kind(d, h);
        if (hk == J_ARRAY) {
            bins = arr_len(d, h);
        } else {
            if (hk == J_STRING) { bins = utf16_len(d, h); } else { have_bins = false; }
        }
    }
    var b4 : [16]u8 = [0; 16];
    var bl : u32 = 0;
    if (have_bins) { bl = dec_to(b4[0..], bins as u64); }
    if (jv_truthy(d, obj_get(d, c, "histogram_bins_equal"))) {
        vn = jv_vput_str(vb[0..], vn, "3", b4[0..(bl as usize)]);
    } else {
        vn = jv_vput_str(vb[0..], vn, "3", "0");
    }
    vn = jv_vput_str(vb[0..], vn, "4", b4[0..(bl as usize)]);
    if (vn == OVER) { return OVER; }
    return jv_fill(o, n0, SAY_CHECK_LINE, vb[0..], vn, true);
}

/// The "how this was made" body into o: the summary, the joined fields and the commands.
fn put_how(o: []u8, n0: u32) -> u32 {
    const d : []const u8 = ds_bytes();
    const src : i64 = obj_get(d, DS_ROOT, "source");
    var n : u32 = raw(o, n0, "<summary>");
    n = text(o, n, SAY_COMMANDS);
    n = raw(o, n, "</summary><p>");
    var first : bool = true;
    var i : u32 = 0;
    while (i < 5) {
        var key : []const u8 = "design";
        if (i == 1) { key = "part"; }
        if (i == 2) { key = "nextpnr"; }
        if (i == 3) { key = "yosys"; }
        if (i == 4) { key = "when"; }
        const v : i64 = obj_get(d, src, key);
        if (jv_truthy(d, v)) {
            if (!first) { n = raw(o, n, " / "); }
            first = false;
            n = jv_text(o, n, d, v);
        }
        i = i + 1;
    }
    n = raw(o, n, "</p><ul>");
    const cm : i64 = obj_get(d, src, "commands");
    if (kind(d, cm) == J_ARRAY) {
        const hi : usize = span_hi(cm);
        var p : usize = skip_ws(d, span_lo(cm) + 1);
        while (p < hi and d[p] != 93) {
            const e : usize = value_end(d, p);
            n = raw(o, n, "<li><code>");
            n = put_kid(o, n, d, jspan(p, e));
            n = raw(o, n, "</code></li>");
            p = skip_ws(d, e);
            if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
        }
    }
    return raw(o, n, "</ul>");
}

// --- state: tool.js's use(), render(), step() and the events --------------------------------------------------

pub var DEMO_HID : bool = true;
pub var CHK : [16384]u8 = [0; 16384];
pub var CHK_LEN : u32 = 0;
pub var HOW : [262144]u8 = [0; 262144];
pub var HOW_LEN : u32 = 0;

fn refresh_detail() -> u32 {
    if (DS_N == 0 or CUR == 0) { return 0; }
    const l : u32 = put_detail(DET[0..], 0);
    DET_LEN = 0;
    if (l != OVER) { DET_LEN = l; }
    return 0;
}

fn has_check() -> bool {
    if (CUR == 0 or DS_FMT != 1) { return false; }
    const d : []const u8 = ds_bytes();
    return jv_truthy(d, obj_get(d, DS_ROOT, "check"));
}

fn has_source() -> bool {
    if (CUR == 0 or DS_FMT != 1) { return false; }
    const d : []const u8 = ds_bytes();
    return jv_truthy(d, obj_get(d, DS_ROOT, "source"));
}

/// render(): everything that depends on the data in use. The parts it leaves alone when there is no path (the
/// detail, the canvas size) keep their old look; the check line and the commands keep it when the data has none.
fn do_render() -> u32 {
    if (CUR == 0) { return 0; }
    ST = 7;
    RENDERED = true;
    ST_FAIL = DS_N > 0 and path_fails(ORD[0]);
    if (has_check()) {
        const l : u32 = put_check(CHK[0..], 0);
        CHK_LEN = 0;
        if (l != OVER) { CHK_LEN = l; }
    }
    if (has_source()) {
        const l : u32 = put_how(HOW[0..], 0);
        HOW_LEN = 0;
        if (l != OVER) { HOW_LEN = l; }
    }
    if (DS_N > 0) {
        do_layout();
        refresh_detail();
    }
    return 0;
}

/// use(d): the data in use is the buffer CUR names, built by build_ds.
fn use_data(is_demo: bool) -> u32 {
    PICK = 0;
    DEMO_HID = is_demo or !DEMO_OK;
    EF[0] = 120;
    EF_N = 1;
    return do_render();
}

fn step(k: f64) -> u32 {
    if (CUR == 0 or DS_N == 0) { return 0; }
    var next : f64 = js_max(0.0, js_min((DS_N as f64) - 1.0, (PICK as f64) + k));
    PICK = next as u32;
    refresh_detail();
    EF[0] = 121;
    EF_N = 1;
    return 0;
}

pub fn w_init(h: []const u8) -> u32 {
    CUR = 0;
    DEMO_OK = false;
    DEMO_LEN = 0;
    FA_LEN = 0;
    FB_LEN = 0;
    FULL = true;
    PICK = 0;
    ST = 0;
    ST_FAIL = false;
    RENDERED = false;
    OVER_DROP = false;
    CLR_FILE = false;
    EF_N = 0;
    LAST_W = 0.0;
    CV_SET = false;
    ROW_H = 3.0;
    CSS_W = 0.0;
    X_MAX = 1.0;
    DET_LEN = 0;
    CHK_LEN = 0;
    HOW_LEN = 0;
    DEMO_HID = true;
    DS_FMT = 0;
    DS_N = 0;
    DS_HAS_PERIOD = false;
    FM_N = 0;
    return 0;
}

pub fn w_view(width: f64, dpr: f64, embed: u32, ih: f64, bw: f64) -> u32 {
    ENV_W = width;
    ENV_DPR = dpr;
    ENV_EMBED = embed;
    ENV_IH = ih;
    ENV_BW = bw;
    return 0;
}

pub fn w_measure_sel(dst: []u8) -> u32 {
    return copy_into(dst, 0, W_SEL);
}

pub fn w_scroll_sel(dst: []u8) -> u32 {
    return copy_into(dst, 0, W_SEL);
}

pub fn w_canvas_keep() -> u32 {
    return 1;
}

pub fn w_drop_root() -> u32 {
    return 1;
}

pub fn w_draw_cap() -> u32 {
    return W_DRAW_CAP;
}

pub fn w_file_cap() -> u32 {
    return W_FILE_CAP;
}

/// The timing.json of the page, fetched at load: fromOwn, then agrees(), then use(); anything else is a status.
pub fn w_data(i: u32, s: []const u8) -> u32 {
    if (s.len > (W_DEMO_CAP as usize)) {
        ST = 1;
        return 0;
    }
    var k : usize = 0;
    while (k < s.len) {
        DEMO[k] = s[k];
        k = k + 1;
    }
    DEMO_LEN = s.len as u32;
    const d : []const u8 = DEMO[0..(DEMO_LEN as usize)];
    if (!jv_valid(d)) {
        ST = 1;
        return 0;
    }
    const r : i64 = root(d);
    if (kind(d, r) == J_NULL) {
        ST = 1;
        return 0;
    }
    if (own_throws(d, r)) {
        ST = 1;
        return 0;
    }
    const prev : u32 = CUR;
    const prev_fmt : u32 = DS_FMT;
    var keep : [1100]u8 = [0; 1100];
    const keep_len : u32 = copy_into(keep[0..], 0, DS_LABEL[0..(DS_LABEL_LEN as usize)]);
    CUR = 1;
    var lb : [1100]u8 = [0; 1100];
    const ll : u32 = demo_label(lb[0..], d, r);
    build_ds(1, lb[0..(ll as usize)]);
    var agrees : bool = false;
    if (DS_N > 0) {
        const p : u32 = ORD[0];
        agrees = DS_HAS_PERIOD and DS_PERIOD == (K_DEMO_PERIOD_PS as f64) and DS_N == (K_DEMO_ENDPOINTS as u32) and TOT[p as usize] == (K_DEMO_WORST_TOTAL_PS as f64) and ROU[p as usize] == (K_DEMO_WORST_ROUTING_PS as f64) and SLN[p as usize] == 0 and SLK[p as usize] == (K_DEMO_WORST_SLACK_PS as f64);
    }
    if (!agrees) {
        CUR = prev;
        DS_N = 0;
        if (prev != 0) { build_ds(prev_fmt, keep[0..(keep_len as usize)]); }
        ST = 2;
        return 0;
    }
    DEMO_OK = true;
    use_data(true);
    return 0;
}

/// The demo's data again (the buffer is intact; the tables are rebuilt).
fn build_demo() -> u32 {
    const d : []const u8 = DEMO[0..(DEMO_LEN as usize)];
    var lb : [1100]u8 = [0; 1100];
    const ll : u32 = demo_label(lb[0..], d, root(d));
    return build_ds(1, lb[0..(ll as usize)]);
}

pub fn w_data_failed(i: u32) -> u32 {
    ST = 1;
    return 0;
}

pub fn w_click(i: u32) -> u32 {
    EF_N = 0;
    if (i == 0) {
        FULL = true;
        if (CUR != 0) {
            do_render();
        }
        return 0;
    }
    if (i == 1) {
        FULL = false;
        if (CUR != 0) {
            do_render();
        }
        return 0;
    }
    if (i == 2) { return step(-1.0); }
    if (i == 3) { return step(1.0); }
    if (i == 4) {
        if (DEMO_OK) {
            CUR = 1;
            build_demo();
            use_data(true);
        }
    }
    return 0;
}

fn word_is(key: []const u8, want: []const u8) -> bool {
    if (key.len != want.len) { return false; }
    var i : usize = 0;
    while (i < key.len) {
        if (key[i] != want[i]) { return false; }
        i = i + 1;
    }
    return true;
}

pub fn w_key(key: []const u8) -> u32 {
    EF_N = 0;
    const n : f64 = (DS_N as f64);
    var cnt : f64 = 0.0;
    if (CUR != 0) { cnt = n; }
    if (word_is(key, "ArrowUp")) {
        step(-1.0);
        return 1;
    }
    if (word_is(key, "ArrowDown")) {
        step(1.0);
        return 1;
    }
    if (word_is(key, "PageUp")) {
        step(-10.0);
        return 1;
    }
    if (word_is(key, "PageDown")) {
        step(10.0);
        return 1;
    }
    if (word_is(key, "Home")) {
        step(0.0 - cnt);
        return 1;
    }
    if (word_is(key, "End")) {
        step(cnt);
        return 1;
    }
    return 0;
}

pub fn w_cpointer(kind_of: u32, id: i64, x: f64, y: f64, mouse: u32) -> u32 {
    EF_N = 0;
    if (kind_of != 0) { return 0; }
    if (CUR == 0 or ROW_H == 0.0) { return 0; }
    const i : f64 = js_floor((y - W_AXIS) / ROW_H);
    if (i < 0.0 or i >= (DS_N as f64)) { return 0; }
    PICK = i as u32;
    refresh_detail();
    return 1;
}

pub fn w_box(w: f64, h: f64) -> u32 {
    EF_N = 0;
    if (CUR == 0 or DS_N == 0 or w == LAST_W) { return 0; }
    LAST_W = w;
    do_layout();
    return 1;
}

pub fn w_drag(kind_of: u32) -> u32 {
    EF_N = 0;
    const was : bool = OVER_DROP;
    OVER_DROP = kind_of == 0;
    if (was != OVER_DROP) { return 1; }
    return 0;
}

pub fn w_value(i: u32, dst: []u8) -> u32 {
    if (i == 0 and CLR_FILE) {
        CLR_FILE = false;
        return 0;
    }
    return 4294967295;
}

/// takeFile(file): the text the host decoded. The checks of tool.js come in its order; a throw leaves "Reading".
pub fn w_file(name: []const u8, size: f64, data: []const u8, st: u32) -> u32 {
    EF_N = 0;
    CLR_FILE = true;
    ST_NAME_LEN = copy_into(ST_NAME[0..], 0, name);
    if (size > (W_FILE_CAP as f64)) {
        ST = 6;
        return 0;
    }
    ST = 3;
    if (st != 0) {
        ST = 4;
        return 0;
    }
    if (data.len > (W_FILE_CAP as usize)) {
        ST = 6;
        return 0;
    }
    var which : u32 = 2;
    if (CUR == 2) { which = 3; }
    var k : usize = 0;
    while (k < data.len) {
        if (which == 2) { FA[k] = data[k]; } else { FB[k] = data[k]; }
        k = k + 1;
    }
    if (which == 2) { FA_LEN = data.len as u32; } else { FB_LEN = data.len as u32; }
    var d : []const u8 = FA[0..(FA_LEN as usize)];
    if (which == 3) { d = FB[0..(FB_LEN as usize)]; }
    if (!jv_valid(d)) {
        ST = 4;
        return 0;
    }
    const r : i64 = root(d);
    var fmt : u32 = 0;
    if (jv_is(d, obj_get(d, r, "t27"), K_SCHEMA) and kind(d, obj_get(d, r, "paths")) == J_ARRAY) {
        fmt = 1;
    } else {
        const cps : i64 = obj_get(d, r, "critical_paths");
        const fx : i64 = obj_get(d, r, "fmax");
        if (kind(d, cps) == J_ARRAY) { fmt = 2; }
        if (fmt == 0 and jv_truthy(d, fx) and (kind(d, fx) == J_OBJECT or kind(d, fx) == J_ARRAY)) { fmt = 2; }
    }
    if (fmt == 0) {
        ST = 5;
        return 0;
    }
    if (fmt == 1 and own_throws(d, r)) { return 0; }
    if (fmt == 2 and report_throws(d, r)) { return 0; }
    CUR = which;
    build_ds(fmt, name);
    use_data(false);
    return 0;
}

pub fn w_effect(k: u32, dst: []u8) -> u32 {
    if (k >= EF_N) {
        EF_N = 0;
        return 0;
    }
    var n : u32 = 0;
    if (EF[k as usize] == 120) {
        n = put(dst, 0, 120);
        n = raw(dst, n, W_SEL);
    } else {
        n = put(dst, 0, 121);
        n = raw(dst, n, W_SEL);
        n = put(dst, n, 10);
        n = js_str_num(dst, n, W_AXIS + (PICK as f64) * ROW_H);
        n = put(dst, n, 10);
        n = js_str_num(dst, n, ROW_H);
    }
    if (n == OVER) { return 0; }
    return n;
}

// --- the page --------------------------------------------------------------------------------------------------

fn hid(o: []u8, n: u32, h: bool) -> u32 {
    if (h) { return raw(o, n, " hidden=\"\""); }
    return n;
}

/// The words of the status line: a message, or the summary of the data in use.
fn put_status(o: []u8, n0: u32) -> u32 {
    if (ST == 0) { return text(o, n0, SAY_LOADING); }
    if (ST == 1) { return text(o, n0, SAY_ERR_DEMO); }
    if (ST == 2) { return text(o, n0, SAY_ERR_DEMO_DIFF); }
    var vb : [4096]u8 = [0; 4096];
    var vn : u32 = 0;
    if (ST >= 3 and ST <= 6) {
        vn = jv_vput_str(vb[0..], 0, "0", ST_NAME[0..(ST_NAME_LEN as usize)]);
        if (ST == 3) { return jv_fill(o, n0, SAY_READING, vb[0..], vn, true); }
        if (ST == 4) { return jv_fill(o, n0, SAY_ERR_JSON, vb[0..], vn, true); }
        if (ST == 5) { return jv_fill(o, n0, SAY_ERR_SHAPE, vb[0..], vn, true); }
        vn = pool_dec(vb[0..], vn, "1", W_FILE_MB as u64);
        return jv_fill(o, n0, SAY_ERR_SIZE, vb[0..], vn, true);
    }
    // the summary
    if (DS_N == 0) { return text(o, n0, DS_LABEL[0..(DS_LABEL_LEN as usize)]); }
    const p : u32 = ORD[0];
    vn = jv_vput_str(vb[0..], 0, "0", DS_LABEL[0..(DS_LABEL_LEN as usize)]);
    var cnt : [32]u8 = [0; 32];
    const cl : u32 = js_locale_num(cnt[0..], 0, DS_N as f64);
    vn = jv_vput_str(vb[0..], vn, "1", cnt[0..(cl as usize)]);
    var t2 : [96]u8 = [0; 96];
    if (DS_HAS_PERIOD) {
        const l2 : u32 = put_signed(t2[0..], 0, SLK[p as usize], SLN[p as usize] != 0);
        vn = jv_vput_str(vb[0..], vn, "2", t2[0..(l2 as usize)]);
        var t3 : [64]u8 = [0; 64];
        const l3 : u32 = put_fixed_num(t3[0..], 0, 1000000.0 / DS_PERIOD, 2);
        vn = jv_vput_str(vb[0..], vn, "3", t3[0..(l3 as usize)]);
        if (vn == OVER) { return OVER; }
        return jv_fill(o, n0, SAY_SUMMARY, vb[0..], vn, true);
    }
    const l2 : u32 = put_ns(t2[0..], 0, TOT[p as usize]);
    vn = jv_vput_str(vb[0..], vn, "2", t2[0..(l2 as usize)]);
    if (vn == OVER) { return OVER; }
    return jv_fill(o, n0, SAY_SUMMARY_NO_PERIOD, vb[0..], vn, true);
}

fn color_named(name: []const u8) -> []const u8 {
    var i : usize = 0;
    while (i < K_SEG_TYPES.len) {
        if (word_is(K_SEG_TYPES[i], name)) { return K_SEG_COLORS[i]; }
        i = i + 1;
    }
    return K_SEG_COLORS[2];
}

fn put_legend_item(o: []u8, n0: u32, style: []const u8, cls: []const u8, label: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<li><i");
    if (cls.len > 0) {
        n = raw(o, n, " class=\"");
        n = raw(o, n, cls);
        n = raw(o, n, "\"");
    }
    n = attr(o, n, "style", style);
    n = raw(o, n, "></i>");
    n = text(o, n, label);
    return raw(o, n, "</li>");
}

pub fn w_render(dst: []u8) -> u32 {
    const have : bool = RENDERED;
    const nz : bool = DS_N > 0;
    const no_paths : bool = have and !nz;
    var n : u32 = raw(dst, 0, "<div class=\"sw-bar\"><button class=\"t27-btn\" type=\"button\"");
    if (FULL) { n = raw(dst, n, " aria-pressed=\"true\""); } else { n = raw(dst, n, " aria-pressed=\"false\""); }
    n = hid(dst, n, have and (!nz or !DS_HAS_PERIOD));
    n = raw(dst, n, ">");
    n = text(dst, n, SAY_FULL_PERIOD);
    n = raw(dst, n, "</button><button class=\"t27-btn\" type=\"button\"");
    if (FULL) { n = raw(dst, n, " aria-pressed=\"false\""); } else { n = raw(dst, n, " aria-pressed=\"true\""); }
    n = hid(dst, n, have and (!nz or !DS_HAS_PERIOD));
    n = raw(dst, n, ">");
    n = text(dst, n, SAY_FIT_PATHS);
    n = raw(dst, n, "</button><button class=\"t27-btn\" type=\"button\"");
    n = hid(dst, n, no_paths);
    n = raw(dst, n, ">");
    n = text(dst, n, SAY_WORSE);
    n = raw(dst, n, "</button><button class=\"t27-btn\" type=\"button\"");
    n = hid(dst, n, no_paths);
    n = raw(dst, n, ">");
    n = text(dst, n, SAY_BETTER);
    n = raw(dst, n, "</button><button class=\"t27-btn\" type=\"button\"");
    n = hid(dst, n, DEMO_HID);
    n = raw(dst, n, ">");
    n = text(dst, n, SAY_DEMO);
    n = raw(dst, n, "</button></div><p class=\"sw-status");
    if (ST_FAIL) { n = raw(dst, n, " is-fail"); }
    n = raw(dst, n, "\" role=\"status\">");
    n = put_status(dst, n);
    n = raw(dst, n, "</p><div class=\"sw-fmax\"");
    n = hid(dst, n, have and FM_N == 0);
    n = raw(dst, n, ">");
    if (have) { n = put_fmax(dst, n); }
    n = raw(dst, n, "</div><p class=\"sw-note\"");
    const note_on : bool = have and DS_FMT == 2 and !nz;
    n = hid(dst, n, have and !note_on);
    n = raw(dst, n, ">");
    if (note_on) {
        var vb : [2400]u8 = [0; 2400];
        const vn : u32 = jv_vput_str(vb[0..], 0, "0", DS_LABEL[0..(DS_LABEL_LEN as usize)]);
        n = jv_fill(dst, n, SAY_NO_PATHS, vb[0..], vn, true);
    }
    n = raw(dst, n, "</p><div class=\"sw-wrap\"");
    n = hid(dst, n, no_paths);
    if (CV_SET) {
        n = raw(dst, n, " style=\"max-height: ");
        n = num(dst, n, CV_MAXH);
        n = raw(dst, n, "px;\"");
    }
    n = raw(dst, n, "><canvas class=\"sw-canvas\" tabindex=\"0\" role=\"img\"");
    n = attr(dst, n, "aria-label", SAY_CANVAS_LABEL);
    if (CV_SET) {
        n = raw(dst, n, " width=\"");
        n = num(dst, n, CV_W);
        n = raw(dst, n, "\" height=\"");
        n = num(dst, n, CV_H);
        n = raw(dst, n, "\" style=\"height: ");
        n = num(dst, n, CV_SH);
        n = raw(dst, n, "px;\"");
    }
    n = raw(dst, n, "></canvas></div><p class=\"sw-hint\"");
    n = hid(dst, n, no_paths);
    n = raw(dst, n, ">");
    n = text(dst, n, SAY_HINT);
    n = raw(dst, n, "</p><ul class=\"sw-legend\"");
    n = hid(dst, n, no_paths);
    n = raw(dst, n, ">");
    var sty : [96]u8 = [0; 96];
    var sl : u32 = copy_into(sty[0..], 0, "background:");
    sl = copy_into(sty[0..], sl, color_named("logic"));
    n = put_legend_item(dst, n, sty[0..(sl as usize)], "", SAY_LEGEND[0]);
    sl = copy_into(sty[0..], 0, "background:");
    sl = copy_into(sty[0..], sl, color_named("routing"));
    n = put_legend_item(dst, n, sty[0..(sl as usize)], "", SAY_LEGEND[1]);
    sl = copy_into(sty[0..], 0, "background:");
    sl = copy_into(sty[0..], sl, color_named("setup"));
    n = put_legend_item(dst, n, sty[0..(sl as usize)], "", SAY_LEGEND[2]);
    sl = copy_into(sty[0..], 0, "background:");
    sl = copy_into(sty[0..], sl, K_SLACK_COLOR);
    sl = copy_into(sty[0..], sl, ";border:1px solid ");
    sl = copy_into(sty[0..], sl, W_LINE_FB);
    n = put_legend_item(dst, n, sty[0..(sl as usize)], "", SAY_LEGEND[3]);
    sl = copy_into(sty[0..], 0, "background:");
    sl = copy_into(sty[0..], sl, K_FAIL_COLOR);
    n = put_legend_item(dst, n, sty[0..(sl as usize)], "sw-period", SAY_LEGEND[4]);
    n = raw(dst, n, "</ul><div class=\"sw-detail\" aria-live=\"polite\"");
    n = hid(dst, n, no_paths);
    n = raw(dst, n, ">");
    n = raw(dst, n, DET[0..(DET_LEN as usize)]);
    n = raw(dst, n, "</div><p class=\"sw-check\"");
    const chk_on : bool = have and has_check();
    n = hid(dst, n, have and !chk_on);
    n = raw(dst, n, ">");
    n = raw(dst, n, CHK[0..(CHK_LEN as usize)]);
    n = raw(dst, n, "</p><label class=\"t27-drop sw-drop");
    if (OVER_DROP) { n = raw(dst, n, " is-over"); }
    n = raw(dst, n, "\"><input type=\"file\" accept=\".json,application/json\" class=\"sw-file\"><span>");
    n = text(dst, n, SAY_DROP);
    n = raw(dst, n, "</span></label><details class=\"sw-how\"");
    const src_on : bool = have and has_source();
    n = hid(dst, n, have and !src_on);
    n = raw(dst, n, ">");
    n = raw(dst, n, HOW[0..(HOW_LEN as usize)]);
    n = raw(dst, n, "</details>");
    if (n == OVER) { return 0; }
    return n;
}

pub fn same_text(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// --- Tests of the native page -----------------------------------------------------------------------------

pub const W_TEST_OWN : str = "{\"t27\":\"slack-waterfall/1\",\"period_ps\":20000,\"strings\":[\"a\",\"b\"],\"paths\":[{\"to\":1,\"pin\":\"D\",\"slack\":15233,\"segs\":[[\"clk-to-q\",100,0,\"CK\",0,\"Q\",-1],[\"routing\",270,0,\"Q\",1,\"A1\",1],[\"setup\",100,1,\"A1\",1,\"A1\",-1]]},{\"to\":0,\"pin\":\"Q\",\"slack\":-5,\"segs\":[[\"logic\",20005,0,\"A\",1,\"B\",-1]]}],\"fmax\":{\"clk\":{\"achieved\":209.78,\"constraint\":50}}}";
pub const W_TEST_REPORT : str = "{\"fmax\":{\"clk\":{\"achieved\":100,\"constraint\":50}},\"critical_paths\":[{\"from\":\"clk\",\"to\":\"clk\",\"path\":[{\"type\":\"logic\",\"delay\":1.5,\"from\":{\"cell\":\"a\",\"port\":\"Q\"},\"to\":{\"cell\":\"b\",\"port\":\"D\"},\"net\":\"n\"}]}]}";

fn w_has(o: []const u8, n: u32, want: []const u8) -> bool {
    if (want.len > (n as usize)) { return false; }
    var i : usize = 0;
    while (i + want.len <= (n as usize)) {
        var k : usize = 0;
        while (k < want.len and o[i + k] == want[k]) { k = k + 1; }
        if (k == want.len) { return true; }
        i = i + 1;
    }
    return false;
}

fn open_page() -> u32 {
    w_init("");
    w_view(600.0, 1.0, 0, 768.0, 600.0);
    return 0;
}

test the_page_opens_loading_with_the_demo_button_hidden {
    open_page();
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert w_has(o[0..], n, "<p class=\"sw-status\" role=\"status\">Loading the paths...</p>");
    assert w_has(o[0..], n, "<button class=\"t27-btn\" type=\"button\" hidden=\"\">Demo design</button>");
    assert w_has(o[0..], n, "<button class=\"t27-btn\" type=\"button\" aria-pressed=\"true\">Full period</button>");
    assert !w_has(o[0..], n, "width=");
    assert w_bdraw(o[0..]) == 0;
}

test a_timing_json_is_sorted_worst_first_and_summarised {
    open_page();
    w_file("t.json", 100.0, W_TEST_OWN, 0);
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert w_has(o[0..], n, "<p class=\"sw-status is-fail\" role=\"status\">t.json: 2 paths, worst slack -0.005 ns at 50 MHz</p>");
    assert w_has(o[0..], n, "<p class=\"sw-title is-fail\">Path 1 of 2: a.Q</p>");
    assert w_has(o[0..], n, "<p class=\"sw-line is-fail\">total 20.005 ns = 20.005 logic + 0.000 routing; slack -0.005 ns</p>");
    assert w_has(o[0..], n, "<td>clk</td><td class=\"sw-num\">209.78</td><td class=\"sw-num\">50.00</td><td class=\"sw-pass\">PASS</td>");
    assert w_has(o[0..], n, " style=\"max-height: 461px;\"");
    assert w_has(o[0..], n, " width=\"600\" height=\"34\" style=\"height: 34px;\"");
    assert w_has(o[0..], n, "<button class=\"t27-btn\" type=\"button\" hidden=\"\">Demo design</button>");
}

test the_keys_move_the_pick_and_ask_for_a_scroll {
    open_page();
    w_file("t.json", 100.0, W_TEST_OWN, 0);
    var e : [128]u8 = [0; 128];
    var n : u32 = w_effect(0, e[0..]);
    assert e[0] == 120;
    assert w_effect(1, e[0..]) == 0;
    assert w_key("End") == 1;
    assert PICK == 1;
    n = w_effect(0, e[0..]);
    assert e[0] == 121;
    assert w_has(e[0..], n, ".sw-wrap\n25\n7");
    assert w_effect(1, e[0..]) == 0;
    assert w_key("Home") == 1;
    assert PICK == 0;
    assert w_key("a") == 0;
    var o : [65536]u8 = [0; 65536];
    const rn : u32 = w_render(o[0..]);
    assert w_has(o[0..], rn, "Path 1 of 2: a.Q");
    assert w_key("ArrowDown") == 1;
    const r2 : u32 = w_render(o[0..]);
    assert w_has(o[0..], r2, "<p class=\"sw-title\">Path 2 of 2: b.D</p>");
}

test a_press_on_the_canvas_picks_the_row_under_it {
    open_page();
    w_file("t.json", 100.0, W_TEST_OWN, 0);
    assert w_cpointer(0, 1, 5.0, 26.0, 1) == 1;
    assert PICK == 1;
    assert w_cpointer(0, 1, 5.0, 4.0, 1) == 0;
    assert w_cpointer(0, 1, 5.0, 400.0, 1) == 0;
    assert w_cpointer(1, 1, 5.0, 18.0, 1) == 0;
    assert PICK == 1;
}

test full_and_fit_change_the_range_and_the_buttons {
    open_page();
    w_file("t.json", 100.0, W_TEST_OWN, 0);
    assert X_MAX > 20405.0 and X_MAX < 20405.2;
    w_click(1);
    assert X_MAX > 21205.2 and X_MAX < 21205.4;
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert w_has(o[0..], n, "type=\"button\" aria-pressed=\"false\">Full period</button>");
    assert w_has(o[0..], n, "type=\"button\" aria-pressed=\"true\">Fit paths</button>");
}

test a_nextpnr_report_is_read_with_its_clock_constraint {
    open_page();
    w_file("r.json", 100.0, W_TEST_REPORT, 0);
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert w_has(o[0..], n, "r.json: 1 paths, worst slack +18.500 ns at 50 MHz");
    assert w_has(o[0..], n, "Path 1 of 1: b.D (clk -&gt; clk)");
    assert w_has(o[0..], n, "<td>a.Q</td><td>b.D</td><td>n</td>");
}

test a_file_that_is_not_a_timing_file_says_why {
    open_page();
    var o : [65536]u8 = [0; 65536];
    w_file("x", 5.0, "oops", 0);
    var n : u32 = w_render(o[0..]);
    assert w_has(o[0..], n, ">x is not JSON.</p>");
    w_file("y", 2.0, "{}", 0);
    n = w_render(o[0..]);
    assert w_has(o[0..], n, ">y is neither a nextpnr report (critical_paths, fmax) nor a timing.json.</p>");
    w_file("big", 9000000.0, "", 0);
    n = w_render(o[0..]);
    assert w_has(o[0..], n, ">big is larger than 8 MB.</p>");
    w_file("z", 5.0, "{\"critical_paths\":[null]}", 0);
    n = w_render(o[0..]);
    assert w_has(o[0..], n, ">Reading z...</p>");
    w_file("q", 5.0, "{}", 1);
    n = w_render(o[0..]);
    assert w_has(o[0..], n, ">q is not JSON.</p>");
}

test the_waterfall_asks_the_host_for_log10_and_pow_before_it_draws {
    open_page();
    w_file("t.json", 100.0, W_TEST_OWN, 0);
    var o : [262144]u8 = [0; 262144];
    assert w_bdraw(o[0..]) == 0;
    var q : [64]f64 = [0.0; 64];
    const c : u32 = w_libm_need(q[0..]);
    assert c == 2;
    assert q[0] == 4.0;
    assert q[3] == 5.0;
    assert q[4] == 10.0;
}

test the_drop_label_follows_the_drag {
    open_page();
    assert w_drag(0) == 1;
    assert w_drag(0) == 0;
    var o : [65536]u8 = [0; 65536];
    var n : u32 = w_render(o[0..]);
    assert w_has(o[0..], n, "<label class=\"t27-drop sw-drop is-over\">");
    assert w_drag(1) == 1;
    n = w_render(o[0..]);
    assert w_has(o[0..], n, "<label class=\"t27-drop sw-drop\">");
    assert w_value(0, o[0..]) == 4294967295;
    w_file("x", 5.0, "oops", 0);
    assert w_value(0, o[0..]) == 0;
    assert w_value(0, o[0..]) == 4294967295;
}

/// The splicer follows only the names a module itself mentions, not the names the imported functions
/// mention. This anchor mentions every helper the writer, the JSON reader, the number rules and the
/// canvas writers call. Never called.
pub fn imports_anchor(o: []u8, s: []const u8) -> u32 {
    var n : u32 = 0;
    n = n + (ok(0) as u32);
    n = n + OVER;
    n = n + put(o, 0, 0);
    n = n + raw(o, 0, s);
    n = n + put_escaped(o, 0, 0);
    n = n + text(o, 0, s);
    n = n + num(o, 0, 0);
    n = n + attr(o, 0, s, s);
    n = n + fill(o, 0, s, s, s, s, 0);
    n = n + fill_named(o, 0, s, s, s, s, s, s, s, s, s, s, s, s, s);
    n = n + dec_to(o, 0);
    n = n + (name_is(s, 0, 0, s) as u32);
    n = n + (is_word_byte(0) as u32);
    n = n + (H_LT as u32);
    n = n + (H_GT as u32);
    n = n + (H_AMP as u32);
    n = n + (H_QUOTE as u32);
    n = n + (H_APOS as u32);
    n = n + (H_SPACE as u32);
    n = n + (H_SLASH as u32);
    n = n + (H_EQ as u32);
    n = n + ((NO_SPAN < 0) as u32);
    n = n + ((SPAN > 0) as u32);
    n = n + (J_NONE as u32);
    n = n + (J_OBJECT as u32);
    n = n + (J_ARRAY as u32);
    n = n + (J_STRING as u32);
    n = n + (J_NUMBER as u32);
    n = n + (J_TRUE as u32);
    n = n + (J_FALSE as u32);
    n = n + (J_NULL as u32);
    n = n + (jspan(0, 0) as u32);
    n = n + (span_lo(0) as u32);
    n = n + (span_hi(0) as u32);
    n = n + (skip_ws(s, 0) as u32);
    n = n + (string_end(s, 0) as u32);
    n = n + (value_end(s, 0) as u32);
    n = n + (root(s) as u32);
    n = n + (kind(s, 0) as u32);
    n = n + (key_is(s, 0, 0, s) as u32);
    n = n + (obj_get(s, 0, s) as u32);
    n = n + arr_len(s, 0);
    n = n + (arr_at(s, 0, 0) as u32);
    n = n + hex4(s, 0);
    n = n + escape_at(s, 0, 0);
    n = n + cp_utf8_len(0);
    n = n + (cp_utf8_byte(0, 0) as u32);
    n = n + str_len(s, 0);
    n = n + (str_byte(s, 0, 0) as u32);
    n = n + JN_OVER;
    n = n + JN_CAP;
    n = n + ((JN_TWO52 > 0.0) as u32);
    n = n + ((JN_TWO53 > 0.0) as u32);
    n = n + jn_put(o, 0, 0);
    n = n + jn_raw(o, 0, s);
    n = n + jn_digits(o, 0);
    n = n + jn_mul(o, 0, 0);
    n = n + jn_mul2(o, 0, 0);
    n = n + jn_mul5(o, 0, 0);
    n = n + jn_shift(o, 0, 0);
    n = n + (jn_cmp(s, s, 0) as u32);
    n = n + (jn_expo(0.0) as u32);
    n = n + (jn_mant(0.0) as u32);
    n = n + ((jn_make(0, 0) > 0.0) as u32);
    n = n + jn_exact(o, 0, 0);
    n = n + jn_fscale(0);
    n = n + (js_is_nan(0.0) as u32);
    n = n + ((js_nan(0.0) > 0.0) as u32);
    n = n + ((js_inf(1.0) > 0.0) as u32);
    n = n + ((js_floor(0.0) > 0.0) as u32);
    n = n + ((js_ceil(0.0) > 0.0) as u32);
    n = n + ((js_max(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_min(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_round(0.0) > 0.0) as u32);
    n = n + (jn_shortest(o, 1.0) as u32);
    n = n + jn_copy(o, s, 0);
    n = n + jn_put_run(o, 0, s, 0, 0);
    n = n + jn_layout(o, 0, s, 0, 0);
    n = n + js_str_num(o, 0, 0.0);
    n = n + js_to_fixed(o, 0, 0.0, 0);
    n = n + js_locale_num(o, 0, 0.0);
    n = n + (jn_num_ok(s, 0, 0) as u32);
    n = n + (jn_cmp_text(s, 0, 0, 0, 0) as u32);
    n = n + ((js_parse_num(s, 0, 0) > 0.0) as u32);
    n = n + ((jn_dec_value(s, 0, 0) > 0.0) as u32);
    n = n + (jn_abs(0) as u32);
    n = n + js_str_u64(o, 0, 0);
    n = n + jv_str_to(o, 0, s, 0);
    n = n + jv_text_str(o, 0, s, 0);
    n = n + ((jv_numval(s, 0) > 0.0) as u32);
    n = n + jv_str(o, 0, s, 0);
    n = n + jv_text(o, 0, s, 0);
    n = n + (jv_is(s, 0, s) as u32);
    n = n + (jv_truthy(s, 0) as u32);
    n = n + (jv_is_ws(0) as u32);
    n = n + ((jv_number_of_text(s, 0) > 0.0) as u32);
    n = n + ((jv_num(s, 0) > 0.0) as u32);
    n = n + jv_vput_str(o, 0, s, s);
    n = n + jv_vput_f64(o, 0, s, 0.0);
    n = n + jv_vput_val(o, 0, s, s, 0);
    n = n + jv_vput_defined(o, 0, s, s, 0);
    n = n + jv_vput_fixed(o, 0, s, 0.0, 0);
    n = n + jv_kid(o, 0, s, 0);
    n = n + jv_find(s, 0, s);
    n = n + jv_fill(o, 0, s, s, 0, true);
    n = n + (jv_string_ok(s, 0) as u32);
    n = n + (jv_number_ok(s, 0) as u32);
    n = n + (jv_lit_ok(s, 0, s) as u32);
    n = n + (jv_valid(s) as u32);
    n = n + jv_ws_at(s, 0, 0);
    n = n + jv_ws_before(s, 0, 0);
    n = n + jv_digit_value(0);
    n = n + jv_fill_raw(o, 0, s, s, 0, true);
    n = n + jv_fill_with(o, 0, s, s, 0, true, true);
    n = n + num_grouped(o, 0, 0);
    return n;
}
