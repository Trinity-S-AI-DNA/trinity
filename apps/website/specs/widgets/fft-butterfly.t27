// SPDX-License-Identifier: Apache-2.0
; specs/widgets/fft-butterfly.t27 -- the radix-2 FFT: stages of butterflies, N log N instead of N^2
; Source of truth for public/widgets/fft-butterfly/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/fft-butterfly/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 22 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader picks 4, 8 or 16 points, an input and a stage. The decimation-in-time FFT is
; drawn column by column: inputs in bit-reversed order on the left, each stage's butterflies joining i
; and i XOR 2^s with the twiddle W_N^t on the lower branch, the integer value at every node (up to 8
; points) and the twiddles the chosen stage uses on the unit circle. Tiles count the work.

; WHAT IT DOES NOT CLAIM: values are the spec's integer FFT of 8-bit inputs, every product rounded; no scaling.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_fft_butterfly;

pub const KIND : str = "widget-tool";
pub const ID : str = "fft-butterfly";
pub const TITLE : str = "The FFT butterfly: N log N instead of N^2";
pub const DESCRIPTION : str = "Pick a size, an input and a stage. See every butterfly pair, its twiddle on the unit circle and the values flowing through, and count the work against a direct DFT.";
pub const IMAGE_ALT : str = "FFT butterfly card: an 8-point decimation-in-time FFT of one cycle of cosine. Inputs arrive in bit-reversed order, three stages of four butterflies join them, and bins 1 and 7 come out at 509.";
pub const HOOK : str = "An 8-point FFT is 3 stages of 4 butterflies. At 1024 points the FFT does 5120 butterflies where a direct DFT does 1048576 multiplies.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/fpga/dsp/signals.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "J. W. Cooley, J. W. Tukey, An algorithm for the machine calculation of complex Fourier series, Math. Comp. 19, 1965"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_LENGTHS : [3]u16 = [4, 8, 16];
pub const K_INPUT_BITS : u8 = 8;
pub const K_MAX_STAGE : u8 = 4;
pub const K_BIG_N : u16 = 1024;
pub const K_PAT_DC : u8 = 0;
pub const K_PAT_TONE : u8 = 1;
pub const K_PAT_NYQUIST : u8 = 2;
pub const K_PAT_NOISE : u8 = 3;
pub const K_PRESET_LEN : [4]u8 = [1, 1, 1, 2];
pub const K_PRESET_PATTERN : [4]u8 = [1, 0, 2, 3];
pub const K_PRESET_STAGE : [4]u8 = [1, 3, 2, 4];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["8 points, cosine, stage 1", "8 points, DC, stage 3", "8 points, alternating", "16 points, noise"];
pub const SAY_LEN : str = "Points N";
pub const SAY_PATTERN : str = "Input";
pub const SAY_PATTERNS : [4]str = ["DC, full scale", "one cycle of cosine", "alternating +-max", "LFSR noise"];
pub const SAY_STAGE : str = "Stage to light";
pub const SAY_NET_LABEL : str = "The FFT as columns of butterflies, inputs in bit-reversed order";
pub const SAY_CIRCLE_LABEL : str = "The twiddles of the lit stage on the unit circle";
pub const SAY_IN : str = "input";
pub const SAY_AFTER : str = "stage {0}";
pub const SAY_W : str = "W^{0}/{1}";
pub const SAY_X_IN : str = "x[{0}]";
pub const SAY_X_OUT : str = "X[{0}]";
pub const SAY_STAGE_USES : str = "stage {0} uses {1} twiddle(s)";
pub const SAY_CIRCLE_NOTE : str = "each one a point on the unit circle: cos, -sin";
pub const SAY_NOTE : str = "A butterfly takes a and b, multiplies b by its twiddle and outputs a + Wb and a - Wb: one complex multiply for two outputs.";
pub const SAY_STAGES : str = "stages, log2 N";
pub const SAY_BUTTERFLIES : str = "butterflies, N/2 log2 N";
pub const SAY_DFT : str = "direct DFT, N^2";
pub const SAY_AT_1024 : str = "at 1024 points";
pub const SAY_VS : str = "{0} against {1}";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/signals.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_sizes_are_powers_of_two {
    assert K_LENGTHS[0] == 4;
    assert K_LENGTHS[2] == 16;
    assert K_MAX_STAGE == 4;
    assert K_BIG_N == 1024;
}

test the_patterns_are_the_spec_patterns {
    assert K_PAT_DC == 0;
    assert K_PAT_TONE == 1;
    assert K_PAT_NYQUIST == 2;
    assert K_PAT_NOISE == 3;
    assert K_PRESET_PATTERN[0] == K_PAT_TONE;
}
