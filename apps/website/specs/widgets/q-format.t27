// SPDX-License-Identifier: Apache-2.0
; specs/widgets/q-format.t27 -- Q formats: reading and writing a fixed-point word
; Source of truth for public/widgets/q-format/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO FORMULA of
; its own: every value it draws comes from public/widgets/q-format/logic.js -- the fn bodies of
; gHashTag/t27 specs/fpga/dsp/fixed_point.t27 (t27#8985) compiled to wasm, beside its copy logic.t27.
; Lesson 7 of the course arithmetic-and-dsp. ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader picks Qm.n (m integer bits counting the sign, n fraction bits, at most 24 in
; all) and either drags a value, which is rounded into the word, or taps bits of the word directly. The
; page shows the bits coloured sign, integer and fraction, the binary point, the value, the range and the
; step on a number line.

; WHAT IT DOES NOT CLAIM: other conventions exist (TI writes Q15 for Q1.15; some authors leave the sign out of m); this page uses one and names it.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_q_format;

pub const KIND : str = "widget-tool";
pub const ID : str = "q-format";
pub const TITLE : str = "Q formats: read and write a fixed-point number";
pub const DESCRIPTION : str = "Pick Qm.n, drag a value or tap the bits, and see where the binary point sits, what the word is worth, its range and its step.";
pub const IMAGE_ALT : str = "Q format card: 0.7 in Q1.15. The sign bit, no other integer bit and fifteen fraction bits hold 22938, which stands for 0.70001; the range runs from -1 to 0.99997 in steps of 2^-15.";
pub const HOOK : str = "0.7 has no exact Q1.15 word: the nearest is 22938, worth 0.70001. Every fixed-point design starts by choosing where that point sits.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/fpga/dsp/fixed_point.t27 (t27#8985): every value on the page is its fn bodies, compiled to wasm (logic.js)", "ARM CMSIS-DSP and the Q notation of DSP texts: Qm.n with m integer bits counting the sign (Q1.15 is a 16-bit word)"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Numbers: ranges, presets, and the logic spec's own constants (held equal by widget-logic.mjs)
pub const K_WORD_LIMIT : u8 = 24;
pub const K_MAX_INT_BITS : u8 = 16;
pub const K_MAX_FRAC_BITS : u8 = 16;
pub const K_X_SPAN : u16 = 256;
pub const K_X_STEP_DIV : u16 = 10000;
pub const K_MODE_ROUND : u8 = 1;
pub const K_MAX_TICKS : u16 = 128;
pub const K_PRESET_M : [4]u8 = [1, 4, 2, 8];
pub const K_PRESET_N : [4]u8 = [15, 12, 2, 8];
pub const K_PRESET_X_MILLI : [4]u16 = [700, 3142, 1250, 1500];
pub const K_PRESET_X_NEG : [4]u8 = [0, 0, 0, 1];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_PRESET_NAMES : [4]str = ["0.7 in Q1.15", "3.142 in Q4.12", "Q2.2: every step visible", "-1.5 in Q8.8"];
pub const SAY_M : str = "Integer bits m (with the sign)";
pub const SAY_N : str = "Fraction bits n";
pub const SAY_X : str = "Value to store";
pub const SAY_TOO_WIDE : str = "m + n is more than {0} bits here: make one of them smaller.";
pub const SAY_BITS_LABEL : str = "The word, bit by bit: sign, integer and fraction bits around the binary point";
pub const SAY_LINE_LABEL : str = "The range of the format on a number line, with the value";
pub const SAY_TAP : str = "Tap a bit to flip it: the top bit weighs minus its place, the others plus.";
pub const SAY_BIT : str = "bit {0}";
pub const SAY_POINT : str = "binary point";
pub const SAY_SIGN : str = "sign";
pub const SAY_INTEGER : str = "integer";
pub const SAY_FRACTION : str = "fraction";
pub const SAY_VALUE : str = "value in Q{0}.{1}";
pub const SAY_RAW : str = "the word as an integer";
pub const SAY_RANGE : str = "range";
pub const SAY_STEP : str = "step";
pub const SAY_SOURCE : str = "Logic: t27 spec fpga/dsp/fixed_point.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_word_fits_its_parts {
    assert K_WORD_LIMIT <= 32;
    assert K_MAX_INT_BITS + K_MAX_FRAC_BITS >= K_WORD_LIMIT;
    assert K_PRESET_M[0] + K_PRESET_N[0] == 16;
}

test the_presets_fit_their_formats {
    assert K_PRESET_X_MILLI[0] < 1000;
    assert K_PRESET_X_MILLI[1] < 8000;
    assert K_PRESET_X_NEG[3] == 1;
    assert K_MODE_ROUND == 1;
}
