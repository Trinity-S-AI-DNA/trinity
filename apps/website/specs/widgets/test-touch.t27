pub const SAY_TEST_FILES : str = "{n} of {all} changed files hold test lines";
pub const SAY_CHECKS : str = "checks +{added} / -{removed}; test blocks removed {blocks}";
pub const SAY_NO_LINES : str = "No test line changed in this pull request.";
pub const SAY_MORE_LINES : str = "+{n} more test lines in the pull request";
pub const SAY_OPEN_PR : str = "Open the pull request on GitHub";
pub const SAY_CI_GATE : str = "Also changed a CI workflow or a suite expectation file; those are not counted as test lines.";
pub const SAY_API_ONLY : str = "GitHub lists {n} more file(s) than the merge diff holds; the badge reads the merge diff.";
pub const SAY_EXCLUDED : str = "Left out: {notMaster} merged pull requests whose merge commit is not on master.";
pub const SAY_RULE_TITLE : str = "How a pull request is judged, and where it is wrong";
pub const SAY_RULE : [5]str = ["Lane: the bee's when the head branch is queen-<N>; every other pull request is the human lane.", "Test lines: test, invariant and bench blocks in .t27 files; files under tests/, test/ or conformance/; *_test.* files. Not seals, docs, CI, or JSON reports a tool generated.", "Diff: git diff <merge>^1 <merge>, the patch that landed on master. Lines that only moved are ignored.", "Pairing: a removed check is paired with an added check on the same subject. Then expected value changed, loosened (== to >=, a condition dropped), trivial (cannot fail), tightened, or rewritten. Unpaired: removed.", "Badge: assert removed when a check or test block was removed or a check got weaker; tests changed when other test lines went; tests added when lines were only added."];
pub const SAY_FALSE_POS_TITLE : str = "Known false positives";
pub const SAY_FALSE_POS : [4]str = ["An assert merged, split or rewritten with a new subject reads as removed (#5731 rewrote invariant checks as then checks).", "Two checks in one file can be paired across different tests.", "Reformatted JSON vectors (Infinity to a string) or a renamed status read as changed expected values.", "A syntax-only rewrite of a test reads as tests changed."];
pub const SAY_FALSE_NEG_TITLE : str = "Known false negatives";
pub const SAY_FALSE_NEG : [4]str = ["A CI workflow or suite expectation that stops running a test is not a test line; those pull requests carry a note.", "Asserts in code outside a test block are counted, not judged.", "A constant a test reads can change outside the test.", "An added test that cannot fail still counts as tests added."];
pub const SAY_NOT_INTENT : str = "A badge is not a verdict on intent: a removed test can be right (its function was deleted, it was a placeholder, it was false). It says the tests got smaller or weaker; the lines are there to judge.";

; --- Tests -----------------------------------------------------------------------------------
test every_pull_request_gets_one_badge_and_one_class {
    assert K_SNAP_BEE[1] + K_SNAP_BEE[2] + K_SNAP_BEE[3] + K_SNAP_BEE[4] == K_SNAP_BEE[0];
    assert K_SNAP_BEE[5] + K_SNAP_BEE[6] + K_SNAP_BEE[7] + K_SNAP_BEE[8] == K_SNAP_BEE[0];
    assert K_SNAP_HUMAN[1] + K_SNAP_HUMAN[2] + K_SNAP_HUMAN[3] + K_SNAP_HUMAN[4] == K_SNAP_HUMAN[0];
    assert K_SNAP_HUMAN[5] + K_SNAP_HUMAN[6] + K_SNAP_HUMAN[7] + K_SNAP_HUMAN[8] == K_SNAP_HUMAN[0];
    assert K_SNAP_BEE[10] <= K_SNAP_BEE[4];
    assert K_SNAP_HUMAN[10] <= K_SNAP_HUMAN[4];
}

test the_hook_matches_the_snapshot {
    assert K_SNAP_BEE[0] == 367;
    assert K_SNAP_BEE[4] == 11;
    assert K_SNAP_HUMAN[4] == 17;
    assert K_WINDOW_DAYS == 14;
    assert K_SNAP_DATE == "2026-10-04";
}

test the_fixtures_cover_add_loosen_and_flip {
    assert K_FIX_COUNT == 3;
    assert K_FIX_0_WANT[0] == 1;
    assert K_FIX_0_WANT[2] == 1;
    assert K_FIX_1_WANT[0] == 3;
    assert K_FIX_1_WANT[5] == 1;
    assert K_FIX_2_WANT[0] == 2;
    assert K_FIX_2_WANT[4] == 1;
    assert K_FIX_2_WANT[3] == 0;
}

test the_badges_and_tags_line_up {
    assert SAY_BADGES[3] == "assert removed";
    assert SAY_BADGES[0] == "tests untouched";
    assert K_TAGS[0] == "removed";
    assert K_TAGS[7] == "line";
    assert K_LANES[0] == "bee";
    assert K_BEE_BRANCH_PREFIX == "queen-";
}

test the_page_sends_nothing_and_reads_no_file {
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == false;
    assert K_DATA_FILE == "./data.json";
    assert KIND == "widget-tool";
    assert ID == "test-touch";
}


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, issue #10938, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/test-touch/tool.js (146 lines of hand-written JavaScript).
; The words and numbers above are unchanged. The host protocol is race_the_bee.t27's plus:
;   w_click(i)            button i in document order: 0..2 the lane filter (All, Bee, Human), 3..7 the badge
;                         filter (All, then the four badges from the worst), 8 "Show more"
;   w_toggle(i, open)     details i (document order: the pull request rows, then the rule block) was opened
;                         or closed; 1 when the page changed (the host then re-renders), else 0. A row's
;                         body is built the first time it opens, as tool.js's "toggle" listener does.
;                         The host must not restore open <details> by index for this widget (it does not
;                         when the widget exports w_toggle): the open state is written as the `open` attribute.
; The 607 pull requests of data.json are NOT copied into a tree: DATA holds the file's bytes (1 MiB
; buffer for the 786923-byte file), PRS the byte span of each pull request. The list is sorted ONCE, as
; tool.js does, by V8's own algorithm: Array.prototype.sort is TimSort and the comparator
; (b.badge - a.badge || (a.merged < b.merged ? 1 : -1)) never returns 0, so pull requests with the same
; badge and merge time (the real file has three, #5821 #5675 #5595) come out in the order the algorithm
; happens to compare them. This file ports that algorithm (array-sort.tq: runs, binary insertion,
; galloping merges, the same argument order in every Compare) and checks it against node's sort on tie-heavy
; random lists. Numbers and strings are written as js_num.t27 / js_val.t27 write them.
; Where tool.js throws while it draws (prs no array, a null pull request, lanes without bee / human or a
; lane without a vector array) its catch shows SAY_LOAD_FAILED; so does this page (data_ok). A body
; that tool.js cannot build (a merged stamp that is no string, a line text that is no string) throws inside
; its toggle handler, which leaves the row open and empty; this page then draws the body as empty strings.
; NOT carried over: more than W_PR_CAP (1024) pull requests; a `merged` stamp compared beyond its first 32
; bytes; sort-key `merged` values that are objects or arrays; UTF-16 order of astral characters; the last
; merge time when a bad pull request has a non-string stamp (the default .sort() of mixed values).
; MEMORY: DATA 1 MiB (the file is 786923 bytes), the sort keys 100 KB, the page buffer is the host's: the
; real file renders 17472 bytes at the start, 187106 bytes with all 607 rows listed and closed, and
; 1157198 bytes with all 607 rows open (601 bodies), so the host's output buffer is 1 MiB for the first
; two and must be 2 MiB or more for the last. The wasm module asks for 34 pages (2.2 MB) at start; with
; the host's 17-page buffer area and the data copied in it holds 65 pages (4.3 MB). w_data takes 64 ms in
; node (validate, 607 spans, TimSort, filter), a closed 607-row render 24-45 ms.
; MEASURED 2026-10-19: t27c 0.5.2 gen + a 6-function Zig export wrapper + zig build-exe wasm32-freestanding
; ReleaseSmall give a 35775-byte wasm. The original page (tool.js) and this one ran in two happy-dom
; windows: (1) the real 786923-byte data.json, two sessions of 70 interactions (lane and badge filters,
; show more, rows opened and closed, the rule block): 144 comparisons of tag, attributes and text; (2) 38
; data variants cut to 45 pull requests (no bad bee PR; a bad one with a missing / null / odd stamp; lanes
; and badges and classes out of range or as strings; titles empty / null / markup / numbers; line lists
; empty / odd / many files; flags; counts / author / branch / url missing; merged stamps as numbers; vectors
; short or with strings; excluded and snapshot fields missing; 1, 0, 40, 41 and 80 pull requests) and 8
; data files the page cannot draw (prs missing or an object, a null pull request, lanes or a vector
; missing, a root array): 400 comparisons; (3) the SORT: 156 lists of 2 to 200 pull requests with almost
; all badges and stamps tied (2937 tied pairs; random, ascending, descending, sawtooth, blocks), every
; row listed, all and bee only, the order of the rows compared; (4) the t27 TimSort alone against node's
; Array.prototype.sort with the same comparator over 10560 lists of 2 to 1024 elements (1948600 tied
; pairs): 0 differences everywhere. A negative control (one title in the native DOM changed) is caught;
; a 404 and a body that is not JSON end on the same line in both.
; Not compared, and why: happy-dom's 'toggle' event is the only way a row opening reaches either page (a
; real browser fires it on the user's click as well); CSS; a body for a pull request the original cannot
; build; runs of more than 200 tied pull requests in the DOM (the lists of up to 1024 are compared in
; the sort test only); the host's 'toggle' forwarding is the new host code described in the report.

pub const W_DATA_CAP : u32 = 1048576;
pub const W_PR_CAP : u32 = 1024;
pub const W_PAGE : u32 = 40;
pub var DATA : [1048576]u8 = [0; 1048576];
pub var DATA_LEN : u32 = 0;
pub var DATA_STATE : u8 = 0;
pub var NPR : u32 = 0;
pub var PRS : [1024]i64 = [0; 1024];
pub var KB : [1024]f64 = [0.0; 1024];
pub var KM : [1024]f64 = [0.0; 1024];
pub var KK : [1024]u8 = [0; 1024];
pub var KS : [32768]u8 = [0; 32768];
pub var KL : [1024]u32 = [0; 1024];
pub var ORDER : [1024]u32 = [0; 1024];
pub var WORK : [1024]u32 = [0; 1024];
pub var TMP : [1024]u32 = [0; 1024];
pub var RUN_BASE : [96]i32 = [0; 96];
pub var RUN_LEN : [96]i32 = [0; 96];
pub var RUNS : i32 = 0;
pub var MIN_GALLOP : i32 = 7;
pub var LANE : i32 = 0 - 1;
pub var BADGE : i32 = 0 - 1;
pub var SHOWN : u32 = 40;
pub var ROW_OPEN : [1024]bool = [false; 1024];
pub var ROW_BODY : [1024]bool = [false; 1024];
pub var RULE_OPEN : bool = false;
pub var ROWS : [1024]u32 = [0; 1024];
pub var NROWS : u32 = 0;

pub fn w_init(h: []const u8) -> u32 {
    DATA_STATE = 0;
    DATA_LEN = 0;
    NPR = 0;
    LANE = 0 - 1;
    BADGE = 0 - 1;
    SHOWN = W_PAGE;
    RULE_OPEN = false;
    return 0;
}

fn nullish(d: []const u8, sp: i64) -> bool {
    const k : u8 = kind(d, sp);
    return k == J_NONE or k == J_NULL;
}

// --- V8's TimSort (third_party/v8/builtins/array-sort.tq), over indexes of the pull requests -------------

/// Compare(a, b) of tool.js's comparator: (b.badge - a.badge) || (a.merged < b.merged ? 1 : -1), never 0.
fn cmp(a: u32, b: u32) -> i32 {
    const bd : f64 = KB[b as usize] - KB[a as usize];
    if (bd == bd and bd != 0.0) {
        if (bd < 0.0) { return 0 - 1; }
        return 1;
    }
    var lt : bool = false;
    if (KK[a as usize] == 1 and KK[b as usize] == 1) {
        const la : u32 = KL[a as usize];
        const lb : u32 = KL[b as usize];
        var m : u32 = la;
        if (lb < m) { m = lb; }
        var i : u32 = 0;
        var decided : bool = false;
        while (i < m and !decided) {
            const ca : u8 = KS[(a * 32 + i) as usize];
            const cb : u8 = KS[(b * 32 + i) as usize];
            if (ca != cb) {
                lt = ca < cb;
                decided = true;
            }
            i = i + 1;
        }
        if (!decided) { lt = la < lb; }
    } else {
        lt = KM[a as usize] < KM[b as usize];
    }
    if (lt) { return 1; }
    return 0 - 1;
}

fn get(arr: u32, i: i32) -> u32 {
    if (arr == 0) { return WORK[i as usize]; }
    return TMP[i as usize];
}

fn copy_range(sa: u32, sp: i32, da: u32, dp: i32, len: i32) -> u32 {
    if (len <= 0) { return 0; }
    if (sa == da and sp == dp) { return 0; }
    var k : i32 = 0;
    if (sp < dp and sa == da) {
        k = len - 1;
        while (k >= 0) {
            const v : u32 = get(sa, sp + k);
            if (da == 0) { WORK[(dp + k) as usize] = v; } else { TMP[(dp + k) as usize] = v; }
            k = k - 1;
        }
    } else {
        while (k < len) {
            const v2 : u32 = get(sa, sp + k);
            if (da == 0) { WORK[(dp + k) as usize] = v2; } else { TMP[(dp + k) as usize] = v2; }
            k = k + 1;
        }
    }
    return 0;
}

fn put_w(i: i32, v: u32) -> u32 {
    WORK[i as usize] = v;
    return 0;
}

fn put_t(i: i32, v: u32) -> u32 {
    TMP[i as usize] = v;
    return 0;
}

fn gallop_left(arr: u32, key: u32, base: i32, length: i32, hint: i32) -> i32 {
    var last_ofs : i32 = 0;
    var offset : i32 = 1;
    var order : i32 = cmp(get(arr, base + hint), key);
    if (order < 0) {
        const max_ofs : i32 = length - hint;
        while (offset < max_ofs) {
            order = cmp(get(arr, base + hint + offset), key);
            if (order >= 0) { break; }
            last_ofs = offset;
            offset = offset * 2 + 1;
        }
        if (offset > max_ofs) { offset = max_ofs; }
        last_ofs = last_ofs + hint;
        offset = offset + hint;
    } else {
        const max_ofs2 : i32 = hint + 1;
        while (offset < max_ofs2) {
            order = cmp(get(arr, base + hint - offset), key);
            if (order < 0) { break; }
            last_ofs = offset;
            offset = offset * 2 + 1;
        }
        if (offset > max_ofs2) { offset = max_ofs2; }
        const tmp : i32 = last_ofs;
        last_ofs = hint - offset;
        offset = hint - tmp;
    }
    last_ofs = last_ofs + 1;
    while (last_ofs < offset) {
        const m : i32 = last_ofs + ((offset - last_ofs) / 2);
        order = cmp(get(arr, base + m), key);
        if (order < 0) { last_ofs = m + 1; } else { offset = m; }
    }
    return offset;
}

fn gallop_right(arr: u32, key: u32, base: i32, length: i32, hint: i32) -> i32 {
    var last_ofs : i32 = 0;
    var offset : i32 = 1;
    var order : i32 = cmp(key, get(arr, base + hint));
    if (order < 0) {
        const max_ofs : i32 = hint + 1;
        while (offset < max_ofs) {
            order = cmp(key, get(arr, base + hint - offset));
            if (order >= 0) { break; }
            last_ofs = offset;
            offset = offset * 2 + 1;
        }
        if (offset > max_ofs) { offset = max_ofs; }
        const tmp : i32 = last_ofs;
        last_ofs = hint - offset;
        offset = hint - tmp;
    } else {
        const max_ofs2 : i32 = length - hint;
        while (offset < max_ofs2) {
            order = cmp(key, get(arr, base + hint + offset));
            if (order < 0) { break; }
            last_ofs = offset;
            offset = offset * 2 + 1;
        }
        if (offset > max_ofs2) { offset = max_ofs2; }
        last_ofs = last_ofs + hint;
        offset = offset + hint;
    }
    last_ofs = last_ofs + 1;
    while (last_ofs < offset) {
        const m : i32 = last_ofs + ((offset - last_ofs) / 2);
        order = cmp(key, get(arr, base + m));
        if (order < 0) { offset = m; } else { last_ofs = m + 1; }
    }
    return offset;
}

fn merge_low(base_a: i32, len_a0: i32, base_b: i32, len_b0: i32) -> u32 {
    var len_a : i32 = len_a0;
    var len_b : i32 = len_b0;
    copy_range(0, base_a, 1, 0, len_a);
    var dest : i32 = base_a;
    var ct : i32 = 0;
    var cb : i32 = base_b;
    put_w(dest, WORK[cb as usize]);
    dest = dest + 1;
    cb = cb + 1;
    var mode : u32 = 0;
    len_b = len_b - 1;
    if (len_b == 0) { mode = 1; } else { if (len_a == 1) { mode = 2; } }
    var min_gallop : i32 = MIN_GALLOP;
    while (mode == 0) {
        var wins_a : i32 = 0;
        var wins_b : i32 = 0;
        var inner : bool = true;
        while (inner and mode == 0) {
            const order : i32 = cmp(WORK[cb as usize], TMP[ct as usize]);
            if (order < 0) {
                put_w(dest, WORK[cb as usize]);
                dest = dest + 1;
                cb = cb + 1;
                wins_b = wins_b + 1;
                len_b = len_b - 1;
                wins_a = 0;
                if (len_b == 0) { mode = 1; } else { if (wins_b >= min_gallop) { inner = false; } }
            } else {
                put_w(dest, TMP[ct as usize]);
                dest = dest + 1;
                ct = ct + 1;
                wins_a = wins_a + 1;
                len_a = len_a - 1;
                wins_b = 0;
                if (len_a == 1) { mode = 2; } else { if (wins_a >= min_gallop) { inner = false; } }
            }
        }
        if (mode != 0) { break; }
        min_gallop = min_gallop + 1;
        var first : bool = true;
        while (mode == 0 and (wins_a >= 7 or wins_b >= 7 or first)) {
            first = false;
            min_gallop = min_gallop - 1;
            if (min_gallop < 1) { min_gallop = 1; }
            MIN_GALLOP = min_gallop;
            wins_a = gallop_right(1, WORK[cb as usize], ct, len_a, 0);
            if (wins_a > 0) {
                copy_range(1, ct, 0, dest, wins_a);
                dest = dest + wins_a;
                ct = ct + wins_a;
                len_a = len_a - wins_a;
                if (len_a == 1) { mode = 2; }
                if (len_a == 0) { mode = 1; }
            }
            if (mode == 0) {
                put_w(dest, WORK[cb as usize]);
                dest = dest + 1;
                cb = cb + 1;
                len_b = len_b - 1;
                if (len_b == 0) { mode = 1; }
            }
            if (mode == 0) {
                wins_b = gallop_left(0, TMP[ct as usize], cb, len_b, 0);
                if (wins_b > 0) {
                    copy_range(0, cb, 0, dest, wins_b);
                    dest = dest + wins_b;
                    cb = cb + wins_b;
                    len_b = len_b - wins_b;
                    if (len_b == 0) { mode = 1; }
                }
            }
            if (mode == 0) {
                put_w(dest, TMP[ct as usize]);
                dest = dest + 1;
                ct = ct + 1;
                len_a = len_a - 1;
                if (len_a == 1) { mode = 2; }
            }
        }
        if (mode == 0) {
            min_gallop = min_gallop + 1;
            MIN_GALLOP = min_gallop;
        }
    }
    if (mode == 1) {
        if (len_a > 0) { copy_range(1, ct, 0, dest, len_a); }
    }
    if (mode == 2) {
        copy_range(0, cb, 0, dest, len_b);
        put_w(dest + len_b, TMP[ct as usize]);
    }
    return 0;
}

fn merge_high(base_a: i32, len_a0: i32, base_b: i32, len_b0: i32) -> u32 {
    var len_a : i32 = len_a0;
    var len_b : i32 = len_b0;
    copy_range(0, base_b, 1, 0, len_b);
    var dest : i32 = base_b + len_b - 1;
    var ct : i32 = len_b - 1;
    var ca : i32 = base_a + len_a - 1;
    put_w(dest, WORK[ca as usize]);
    dest = dest - 1;
    ca = ca - 1;
    var mode : u32 = 0;
    len_a = len_a - 1;
    if (len_a == 0) { mode = 1; } else { if (len_b == 1) { mode = 2; } }
    var min_gallop : i32 = MIN_GALLOP;
    while (mode == 0) {
        var wins_a : i32 = 0;
        var wins_b : i32 = 0;
        var inner : bool = true;
        while (inner and mode == 0) {
            const order : i32 = cmp(TMP[ct as usize], WORK[ca as usize]);
            if (order < 0) {
                put_w(dest, WORK[ca as usize]);
                dest = dest - 1;
                ca = ca - 1;
                wins_a = wins_a + 1;
                len_a = len_a - 1;
                wins_b = 0;
                if (len_a == 0) { mode = 1; } else { if (wins_a >= min_gallop) { inner = false; } }
            } else {
                put_w(dest, TMP[ct as usize]);
                dest = dest - 1;
                ct = ct - 1;
                wins_b = wins_b + 1;
                len_b = len_b - 1;
                wins_a = 0;
                if (len_b == 1) { mode = 2; } else { if (wins_b >= min_gallop) { inner = false; } }
            }
        }
        if (mode != 0) { break; }
        min_gallop = min_gallop + 1;
        var first : bool = true;
        while (mode == 0 and (wins_a >= 7 or wins_b >= 7 or first)) {
            first = false;
            min_gallop = min_gallop - 1;
            if (min_gallop < 1) { min_gallop = 1; }
            MIN_GALLOP = min_gallop;
            var k : i32 = gallop_right(0, TMP[ct as usize], base_a, len_a, len_a - 1);
            wins_a = len_a - k;
            if (wins_a > 0) {
                dest = dest - wins_a;
                ca = ca - wins_a;
                copy_range(0, ca + 1, 0, dest + 1, wins_a);
                len_a = len_a - wins_a;
                if (len_a == 0) { mode = 1; }
            }
            if (mode == 0) {
                put_w(dest, TMP[ct as usize]);
                dest = dest - 1;
                ct = ct - 1;
                len_b = len_b - 1;
                if (len_b == 1) { mode = 2; }
            }
            if (mode == 0) {
                k = gallop_left(1, WORK[ca as usize], 0, len_b, len_b - 1);
                wins_b = len_b - k;
                if (wins_b > 0) {
                    dest = dest - wins_b;
                    ct = ct - wins_b;
                    copy_range(1, ct + 1, 0, dest + 1, wins_b);
                    len_b = len_b - wins_b;
                    if (len_b == 1) { mode = 2; }
                    if (len_b == 0) { mode = 1; }
                }
            }
            if (mode == 0) {
                put_w(dest, WORK[ca as usize]);
                dest = dest - 1;
                ca = ca - 1;
                len_a = len_a - 1;
                if (len_a == 0) { mode = 1; }
            }
        }
        if (mode == 0) {
            min_gallop = min_gallop + 1;
            MIN_GALLOP = min_gallop;
        }
    }
    if (mode == 1) {
        if (len_b > 0) { copy_range(1, 0, 0, dest - (len_b - 1), len_b); }
    }
    if (mode == 2) {
        dest = dest - len_a;
        ca = ca - len_a;
        copy_range(0, ca + 1, 0, dest + 1, len_a);
        put_w(dest, TMP[ct as usize]);
    }
    return 0;
}

fn merge_at(i: i32) -> u32 {
    var base_a : i32 = RUN_BASE[i as usize];
    var len_a : i32 = RUN_LEN[i as usize];
    const base_b : i32 = RUN_BASE[(i + 1) as usize];
    var len_b : i32 = RUN_LEN[(i + 1) as usize];
    RUN_LEN[i as usize] = len_a + len_b;
    if (i == RUNS - 3) {
        RUN_BASE[(i + 1) as usize] = RUN_BASE[(i + 2) as usize];
        RUN_LEN[(i + 1) as usize] = RUN_LEN[(i + 2) as usize];
    }
    RUNS = RUNS - 1;
    const key_right : u32 = WORK[base_b as usize];
    const k : i32 = gallop_right(0, key_right, base_a, len_a, 0);
    base_a = base_a + k;
    len_a = len_a - k;
    if (len_a == 0) { return 0; }
    const key_left : u32 = WORK[(base_a + len_a - 1) as usize];
    len_b = gallop_left(0, key_left, base_b, len_b, len_b - 1);
    if (len_b == 0) { return 0; }
    if (len_a <= len_b) { merge_low(base_a, len_a, base_b, len_b); } else { merge_high(base_a, len_a, base_b, len_b); }
    return 0;
}

fn run_ok(n: i32) -> bool {
    if (n < 2) { return true; }
    return RUN_LEN[(n - 2) as usize] > RUN_LEN[(n - 1) as usize] + RUN_LEN[n as usize];
}

fn merge_collapse() -> u32 {
    var go : bool = true;
    while (RUNS > 1 and go) {
        var n : i32 = RUNS - 2;
        if (!run_ok(n + 1) or !run_ok(n)) {
            if (n > 0 and RUN_LEN[(n - 1) as usize] < RUN_LEN[(n + 1) as usize]) { n = n - 1; }
            merge_at(n);
        } else {
            if (RUN_LEN[n as usize] <= RUN_LEN[(n + 1) as usize]) { merge_at(n); } else { go = false; }
        }
    }
    return 0;
}

fn merge_force_collapse() -> u32 {
    while (RUNS > 1) {
        var n : i32 = RUNS - 2;
        if (n > 0 and RUN_LEN[(n - 1) as usize] < RUN_LEN[(n + 1) as usize]) { n = n - 1; }
        merge_at(n);
    }
    return 0;
}

fn count_and_make_run(low_arg: i32, high: i32) -> i32 {
    const low : i32 = low_arg + 1;
    if (low == high) { return 1; }
    var run_length : i32 = 2;
    const element_low : u32 = WORK[low as usize];
    const element_high : u32 = WORK[(low - 1) as usize];
    var order : i32 = cmp(element_low, element_high);
    const desc : bool = order < 0;
    var prev : u32 = element_low;
    var idx : i32 = low + 1;
    var stop : bool = false;
    while (idx < high and !stop) {
        const cur : u32 = WORK[idx as usize];
        order = cmp(cur, prev);
        if (desc) {
            if (order >= 0) { stop = true; }
        } else {
            if (order < 0) { stop = true; }
        }
        if (!stop) {
            prev = cur;
            run_length = run_length + 1;
            idx = idx + 1;
        }
    }
    if (desc) {
        var lo : i32 = low_arg;
        var hi : i32 = low_arg + run_length - 1;
        while (lo < hi) {
            const t : u32 = WORK[lo as usize];
            WORK[lo as usize] = WORK[hi as usize];
            WORK[hi as usize] = t;
            lo = lo + 1;
            hi = hi - 1;
        }
    }
    return run_length;
}

fn binary_insertion_sort(low: i32, start_arg: i32, high: i32) -> u32 {
    var start : i32 = start_arg;
    if (low == start_arg) { start = start_arg + 1; }
    while (start < high) {
        var left : i32 = low;
        var right : i32 = start;
        const pivot : u32 = WORK[right as usize];
        while (left < right) {
            const mid : i32 = left + ((right - left) / 2);
            const order : i32 = cmp(pivot, WORK[mid as usize]);
            if (order < 0) { right = mid; } else { left = mid + 1; }
        }
        var p : i32 = start;
        while (p > left) {
            WORK[p as usize] = WORK[(p - 1) as usize];
            p = p - 1;
        }
        WORK[left as usize] = pivot;
        start = start + 1;
    }
    return 0;
}

fn min_run_length(n0: i32) -> i32 {
    var n : i32 = n0;
    var r : i32 = 0;
    while (n >= 64) {
        r = r | (n & 1);
        n = n / 2;
    }
    return n + r;
}

/// Array.prototype.sort of ORDER[0..n) with cmp, as V8 runs it.
fn timsort(n: i32) -> u32 {
    var i : i32 = 0;
    while (i < n) {
        WORK[i as usize] = i as u32;
        i = i + 1;
    }
    RUNS = 0;
    MIN_GALLOP = 7;
    if (n >= 2) {
        var low : i32 = 0;
        var remaining : i32 = n;
        const min_run : i32 = min_run_length(remaining);
        while (remaining != 0) {
            var cur : i32 = count_and_make_run(low, low + remaining);
            if (cur < min_run) {
                var forced : i32 = min_run;
                if (remaining < forced) { forced = remaining; }
                binary_insertion_sort(low, low + cur, low + forced);
                cur = forced;
            }
            RUN_BASE[RUNS as usize] = low;
            RUN_LEN[RUNS as usize] = cur;
            RUNS = RUNS + 1;
            merge_collapse();
            low = low + cur;
            remaining = remaining - cur;
        }
        merge_force_collapse();
    }
    i = 0;
    while (i < n) {
        ORDER[i as usize] = WORK[i as usize];
        i = i + 1;
    }
    return 0;
}

// --- the data -------------------------------------------------------------------------------------

/// d.lanes[lane].vector is an array of numbers (tool.js reads v[0..4]).
fn lane_vec(d: []const u8, r: i64, lane: []const u8) -> i64 {
    return obj_get(d, obj_get(d, obj_get(d, r, "lanes"), lane), "vector");
}

fn data_ok(d: []const u8, r: i64) -> bool {
    if (kind(d, r) != J_OBJECT) { return false; }
    if (kind(d, obj_get(d, r, "prs")) != J_ARRAY) { return false; }
    if (kind(d, lane_vec(d, r, "bee")) != J_ARRAY or kind(d, lane_vec(d, r, "human")) != J_ARRAY) { return false; }
    if (nullish(d, obj_get(d, obj_get(d, r, "lanes"), "bee"))) { return false; }
    return true;
}

/// Does verdict(d) throw? stamp(last) calls .replace on the greatest stamp of the removed-assert bee pull
/// requests (by String()); that throws when it is a truthy value that is no string.
fn verdict_throws(d: []const u8) -> bool {
    var have : bool = false;
    var last : [96]u8 = [0; 96];
    var ll : u32 = 0;
    var bad_kind : bool = false;
    var missing : bool = false;
    var i : u32 = 0;
    while (i < NPR) {
        const sp : i64 = PRS[i as usize];
        const bv : i64 = obj_get(d, sp, "badge");
        if (jv_is(d, obj_get(d, sp, "lane"), "bee") and kind(d, bv) == J_NUMBER and jv_num(d, bv) == 3.0) {
            const mv : i64 = obj_get(d, sp, "merged");
            if (kind(d, mv) == J_NONE) {
                missing = true;
            } else {
                var cand : [96]u8 = [0; 96];
                const cl : u32 = jv_str(cand[0..], 0, d, mv);
                if (!have or str_gt(cand[0..], cl, last[0..], ll)) {
                    have = true;
                    bad_kind = jv_truthy(d, mv) and kind(d, mv) != J_STRING;
                    var z : u32 = 0;
                    while (z < cl and z < 96) {
                        last[z as usize] = cand[z as usize];
                        z = z + 1;
                    }
                    ll = z;
                }
            }
        }
        i = i + 1;
    }
    if (missing) { return false; }
    return have and bad_kind;
}

pub fn w_data(i: u32, s: []const u8) -> u32 {
    if (s.len > (W_DATA_CAP as usize)) {
        DATA_STATE = 2;
        return 0;
    }
    var k : usize = 0;
    while (k < s.len) {
        DATA[k] = s[k];
        k = k + 1;
    }
    DATA_LEN = s.len as u32;
    DATA_STATE = 1;
    const d : []const u8 = DATA[0..(DATA_LEN as usize)];
    if (!jv_valid(d)) {
        DATA_STATE = 2;
        return 0;
    }
    const r : i64 = root(d);
    if (!data_ok(d, r)) {
        DATA_STATE = 2;
        return 0;
    }
    // the span of every pull request, once (arr_at from the start each time would be quadratic)
    const arr : i64 = obj_get(d, r, "prs");
    const hi : usize = span_hi(arr);
    var p : usize = skip_ws(d, span_lo(arr) + 1);
    var n : u32 = 0;
    while (p < hi - 1 and n < W_PR_CAP) {
        const e : usize = value_end(d, p);
        if (e > hi) { break; }
        const sp : i64 = jspan(p, e);
        if (nullish(d, sp)) {
            DATA_STATE = 2;
            return 0;
        }
        PRS[n as usize] = sp;
        KB[n as usize] = jv_num(d, obj_get(d, sp, "badge"));
        const mv : i64 = obj_get(d, sp, "merged");
        KM[n as usize] = jv_num(d, mv);
        KK[n as usize] = 0;
        KL[n as usize] = 0;
        if (kind(d, mv) == J_STRING) {
            KK[n as usize] = 1;
            var tmp : [64]u8 = [0; 64];
            var l : u32 = jv_str_to(tmp[0..], 0, d, mv);
            if (l > 32) { l = 32; }
            var q : u32 = 0;
            while (q < l) {
                KS[(n * 32 + q) as usize] = tmp[q as usize];
                q = q + 1;
            }
            KL[n as usize] = l;
        }
        n = n + 1;
        p = skip_ws(d, e);
        if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
    }
    NPR = n;
    if (verdict_throws(d)) {
        DATA_STATE = 2;
        return 0;
    }
    timsort(n as i32);
    refilter(d);
    return 0;
}

pub fn w_data_failed(i: u32) -> u32 {
    DATA_STATE = 2;
    return 0;
}

/// render(): the rows after the filters; every row closed and without a body again.
fn refilter(d: []const u8) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < NPR) {
        const pi : u32 = ORDER[i as usize];
        const sp : i64 = PRS[pi as usize];
        var ok_l : bool = true;
        var ok_b : bool = true;
        if (LANE >= 0) { ok_l = jv_is(d, obj_get(d, sp, "lane"), K_LANES[LANE as usize]); }
        if (BADGE >= 0) {
            const bv : i64 = obj_get(d, sp, "badge");
            ok_b = kind(d, bv) == J_NUMBER and jv_num(d, bv) == (BADGE as f64);
        }
        if (ok_l and ok_b) {
            ROWS[n as usize] = pi;
            n = n + 1;
        }
        i = i + 1;
    }
    NROWS = n;
    var j : u32 = 0;
    while (j < W_PR_CAP) {
        ROW_OPEN[j as usize] = false;
        ROW_BODY[j as usize] = false;
        j = j + 1;
    }
    return 0;
}

pub fn w_click(i: u32) -> u32 {
    if (DATA_STATE != 1) { return 0; }
    const d : []const u8 = DATA[0..(DATA_LEN as usize)];
    if (i < 3) {
        LANE = (i as i32) - 1;
        SHOWN = W_PAGE;
        refilter(d);
    }
    if (i >= 3 and i < 8) {
        if (i == 3) { BADGE = 0 - 1; } else { BADGE = 7 - (i as i32); }
        SHOWN = W_PAGE;
        refilter(d);
    }
    if (i == 8) {
        SHOWN = SHOWN + W_PAGE;
        refilter(d);
    }
    return 0;
}

/// Would prBody(p) in tool.js get to its end? (Else its toggle handler throws and the row stays open and empty.)
fn body_ok(d: []const u8, p: i64) -> bool {
    const mv : i64 = obj_get(d, p, "merged");
    if (jv_truthy(d, mv) and kind(d, mv) != J_STRING) { return false; }
    if (nullish(d, obj_get(d, p, "counts"))) { return false; }
    const lines : i64 = obj_get(d, p, "lines");
    if (kind(d, lines) != J_ARRAY) { return false; }
    const lc : u32 = arr_len(d, lines);
    var i : u32 = 0;
    while (i < lc) {
        const l : i64 = arr_at(d, lines, i);
        if (nullish(d, l)) { return false; }
        if (kind(d, obj_get(d, l, "t")) != J_STRING) { return false; }
        i = i + 1;
    }
    if (lc > 0 and nullish(d, obj_get(d, p, "files"))) { return false; }
    return true;
}

pub fn w_toggle(i: u32, open: u32) -> u32 {
    if (DATA_STATE != 1) { return 0; }
    var shown_rows : u32 = NROWS;
    if (SHOWN < shown_rows) { shown_rows = SHOWN; }
    const o : bool = open != 0;
    if (i < shown_rows) {
        var changed : bool = ROW_OPEN[i as usize] != o;
        ROW_OPEN[i as usize] = o;
        if (o and !ROW_BODY[i as usize]) {
            const dd : []const u8 = DATA[0..(DATA_LEN as usize)];
            if (body_ok(dd, PRS[ROWS[i as usize] as usize])) {
                ROW_BODY[i as usize] = true;
                changed = true;
            }
        }
        if (changed) { return 1; }
        return 0;
    }
    if (i == shown_rows) {
        if (RULE_OPEN != o) {
            RULE_OPEN = o;
            return 1;
        }
    }
    return 0;
}

// --- the page -------------------------------------------------------------------------------------

/// stamp(iso): '' for a falsy value, else the first T as a space and a trailing :dd Z cut, as raw bytes.
fn stamp_raw(out: []u8, d: []const u8, sp: i64) -> u32 {
    if (!jv_truthy(d, sp)) { return 0; }
    var l : u32 = jv_str(out, 0, d, sp);
    var k : u32 = 0;
    var done : bool = false;
    while (k < l and !done) {
        if (out[k as usize] == 84) {
            out[k as usize] = 32;
            done = true;
        }
        k = k + 1;
    }
    if (l >= 4 and out[(l - 1) as usize] == 90 and out[(l - 4) as usize] == 58 and out[(l - 3) as usize] >= 48 and out[(l - 3) as usize] <= 57 and out[(l - 2) as usize] >= 48 and out[(l - 2) as usize] <= 57) {
        l = l - 4;
    }
    return l;
}

fn put_esc(dst: []u8, n0: u32, s: []const u8, l: u32) -> u32 {
    var n : u32 = n0;
    var i : u32 = 0;
    while (i < l) {
        n = put_escaped(dst, n, s[i as usize]);
        i = i + 1;
    }
    return n;
}

fn lane_index(d: []const u8, sp: i64) -> i32 {
    var i : usize = 0;
    while (i < K_LANES.len) {
        if (jv_is(d, sp, K_LANES[i])) { return i as i32; }
        i = i + 1;
    }
    return 0 - 1;
}

/// laneName(lane): the word for a known lane, else the data's own text.
fn lane_name(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    const ix : i32 = lane_index(d, sp);
    if (ix >= 0) { return text(dst, n0, SAY_LANE_NAMES[ix as usize]); }
    return jv_kid(dst, n0, d, sp);
}

/// The array index a value names as a property key (arr[v]): an integer number, or a canonical decimal string; -1 else.
fn key_index(d: []const u8, sp: i64) -> i64 {
    const k : u8 = kind(d, sp);
    if (k == J_NUMBER) {
        const v : f64 = jv_num(d, sp);
        if (v >= 0.0 and v < 4294967295.0 and v == js_floor(v)) { return v as i64; }
        return 0 - 1;
    }
    if (k == J_STRING) {
        const l : u32 = str_len(d, sp);
        if (l == 0 or l > 9) { return 0 - 1; }
        var v2 : i64 = 0;
        var i : u32 = 0;
        while (i < l) {
            const c : u8 = str_byte(d, sp, i);
            if (c < 48 or c > 57) { return 0 - 1; }
            if (i == 0 and c == 48 and l > 1) { return 0 - 1; }
            v2 = v2 * 10 + ((c - 48) as i64);
            i = i + 1;
        }
        return v2;
    }
    return 0 - 1;
}

fn badge_span(dst: []u8, n0: u32, d: []const u8, b: i64) -> u32 {
    var n : u32 = raw(dst, n0, "<span class=\"tt-badge tt-b");
    n = jv_text(dst, n, d, b);
    n = raw(dst, n, "\">");
    const bi : i64 = key_index(d, b);
    if (bi >= 0 and bi < (SAY_BADGES.len as i64)) { n = text(dst, n, SAY_BADGES[bi as usize]); }
    return raw(dst, n, "</span>");
}

fn chip_span(dst: []u8, n0: u32, d: []const u8, lane: i64) -> u32 {
    var n : u32 = raw(dst, n0, "<span class=\"tt-chip tt-");
    n = jv_text(dst, n, d, lane);
    n = raw(dst, n, "\">");
    n = lane_name(dst, n, d, lane);
    return raw(dst, n, "</span>");
}

fn vnum(d: []const u8, v: i64, ix: u32) -> i64 {
    return arr_at(d, v, ix);
}

fn lane_card(dst: []u8, n0: u32, d: []const u8, r: i64, li: u32) -> u32 {
    const L : i64 = obj_get(d, obj_get(d, r, "lanes"), K_LANES[li as usize]);
    const v : i64 = obj_get(d, L, "vector");
    var n : u32 = raw(dst, n0, "<section class=\"tt-lane tt-");
    n = text(dst, n, K_LANES[li as usize]);
    n = raw(dst, n, "\"><h2>");
    n = text(dst, n, SAY_LANE_NAMES[li as usize]);
    n = raw(dst, n, "</h2><p class=\"tt-rule\">");
    n = text(dst, n, SAY_LANE_LINES[li as usize]);
    n = raw(dst, n, "</p><p class=\"tt-big\"><span class=\"tt-bad\">");
    n = jv_text(dst, n, d, vnum(d, v, 4));
    n = raw(dst, n, "</span> / ");
    n = jv_text(dst, n, d, vnum(d, v, 0));
    n = raw(dst, n, "<small>");
    n = text(dst, n, SAY_REMOVED_OF);
    n = raw(dst, n, "; ");
    n = jv_text(dst, n, d, vnum(d, v, 0));
    n = put(dst, n, 32);
    n = text(dst, n, SAY_MERGED);
    n = raw(dst, n, "</small></p><div class=\"tt-bar\" role=\"img\" aria-label=\"");
    var q : u32 = 1;
    while (q <= 4) {
        if (q > 1) { n = raw(dst, n, ", "); }
        n = text(dst, n, SAY_BADGES[(q - 1) as usize]);
        n = put(dst, n, 32);
        n = jv_text(dst, n, d, vnum(d, v, q));
        q = q + 1;
    }
    n = raw(dst, n, "\">");
    q = 4;
    while (q >= 1) {
        n = raw(dst, n, "<span class=\"tt-seg tt-b");
        n = js_str_u64(dst, n, (q - 1) as u64);
        n = raw(dst, n, "\" style=\"flex-grow:");
        n = jv_text(dst, n, d, vnum(d, v, q));
        n = raw(dst, n, "\"></span>");
        q = q - 1;
    }
    n = raw(dst, n, "</div><ul class=\"tt-counts\">");
    q = 4;
    while (q >= 1) {
        n = raw(dst, n, "<li><span class=\"tt-badge tt-b");
        n = js_str_u64(dst, n, (q - 1) as u64);
        n = raw(dst, n, "\">");
        n = text(dst, n, SAY_BADGES[(q - 1) as usize]);
        n = raw(dst, n, "</span> <b>");
        n = jv_text(dst, n, d, vnum(d, v, q));
        n = raw(dst, n, "</b></li>");
        q = q - 1;
    }
    n = raw(dst, n, "</ul><dl>");
    var s : usize = 0;
    while (s < SAY_STAT_NAMES.len) {
        n = raw(dst, n, "<dt>");
        n = text(dst, n, SAY_STAT_NAMES[s]);
        n = raw(dst, n, "</dt><dd>");
        if (s == 0) { n = jv_text(dst, n, d, obj_get(d, L, "checksAdded")); }
        if (s == 1) { n = jv_text(dst, n, d, obj_get(d, L, "checksRemoved")); }
        if (s == 2) { n = jv_text(dst, n, d, obj_get(d, L, "testsRemoved")); }
        if (s == 3) { n = jv_text(dst, n, d, obj_get(d, L, "expect")); }
        if (s == 4) { n = jv_text(dst, n, d, obj_get(d, L, "loosened")); }
        n = raw(dst, n, "</dd>");
        s = s + 1;
    }
    return raw(dst, n, "</dl></section>");
}

fn verdict_html(dst: []u8, n0: u32, d: []const u8, r: i64) -> u32 {
    // bad = bee pull requests with badge === 3 ; last = the greatest of their stamps, as .sort().pop() gives it
    var bad : u32 = 0;
    var have_last : bool = false;
    var last_missing : bool = false;
    var last_null : bool = false;
    var last : [64]u8 = [0; 64];
    var ll : u32 = 0;
    var i : u32 = 0;
    while (i < NPR) {
        const sp : i64 = PRS[i as usize];
        const bv : i64 = obj_get(d, sp, "badge");
        if (jv_is(d, obj_get(d, sp, "lane"), "bee") and kind(d, bv) == J_NUMBER and jv_num(d, bv) == 3.0) {
            bad = bad + 1;
            const mv : i64 = obj_get(d, sp, "merged");
            if (kind(d, mv) == J_NONE) {
                last_missing = true;
            } else {
                var cand : [96]u8 = [0; 96];
                const cl : u32 = jv_str(cand[0..], 0, d, mv);
                if (!have_last or str_gt(cand[0..], cl, last[0..], ll)) {
                    have_last = true;
                    last_null = kind(d, mv) == J_NULL;
                    var z : u32 = 0;
                    while (z < cl and z < 64) {
                        last[z as usize] = cand[z as usize];
                        z = z + 1;
                    }
                    ll = z;
                }
            }
        }
        i = i + 1;
    }
    var n : u32 = n0;
    if (bad == 0) {
        n = raw(dst, n, "<section class=\"tt-verdict tt-ok\"><p>");
        n = text(dst, n, SAY_VERDICT_NO);
        return raw(dst, n, "</p></section>");
    }
    const bee : i64 = lane_vec(d, r, "bee");
    const hum : i64 = lane_vec(d, r, "human");
    n = raw(dst, n, "<section class=\"tt-verdict\"><p class=\"tt-verdict-main\">");
    var vb : [1024]u8 = [0; 1024];
    var vn : u32 = jv_vput_val(vb[0..], 0, "beeRemoved", d, vnum(d, bee, 4));
    vn = jv_vput_val(vb[0..], vn, "beePrs", d, vnum(d, bee, 0));
    vn = jv_vput_val(vb[0..], vn, "beeBlocks", d, obj_get(d, obj_get(d, obj_get(d, r, "lanes"), "bee"), "testsRemoved"));
    vn = jv_vput_val(vb[0..], vn, "humanRemoved", d, vnum(d, hum, 4));
    vn = jv_vput_val(vb[0..], vn, "humanPrs", d, vnum(d, hum, 0));
    n = jv_fill(dst, n, SAY_VERDICT_YES, vb[0..], vn, false);
    n = raw(dst, n, "</p><p class=\"tt-verdict-sub\">");
    // after = bee pull requests whose stamp is a string greater than last
    var after : u32 = 0;
    if (have_last and !last_missing and !last_null) {
        i = 0;
        while (i < NPR) {
            const sp2 : i64 = PRS[i as usize];
            const mv2 : i64 = obj_get(d, sp2, "merged");
            if (jv_is(d, obj_get(d, sp2, "lane"), "bee") and kind(d, mv2) == J_STRING) {
                var c2 : [96]u8 = [0; 96];
                const c2l : u32 = jv_str(c2[0..], 0, d, mv2);
                if (str_gt(c2[0..], c2l, last[0..], ll)) { after = after + 1; }
            }
            i = i + 1;
        }
    }
    var lb : [256]u8 = [0; 256];
    var lt : [200]u8 = [0; 200];
    var ltl : u32 = 0;
    if (!last_missing and !last_null) {
        // stamp(last): last is a string here
        var tmp : [96]u8 = [0; 96];
        var z2 : u32 = 0;
        while (z2 < ll) {
            tmp[z2 as usize] = last[z2 as usize];
            z2 = z2 + 1;
        }
        var done : bool = false;
        var k : u32 = 0;
        while (k < ll and !done) {
            if (tmp[k as usize] == 84) {
                tmp[k as usize] = 32;
                done = true;
            }
            k = k + 1;
        }
        var l2 : u32 = ll;
        if (l2 >= 4 and tmp[(l2 - 1) as usize] == 90 and tmp[(l2 - 4) as usize] == 58 and tmp[(l2 - 3) as usize] >= 48 and tmp[(l2 - 3) as usize] <= 57 and tmp[(l2 - 2) as usize] >= 48 and tmp[(l2 - 2) as usize] <= 57) { l2 = l2 - 4; }
        var y : u32 = 0;
        while (y < l2) {
            lt[y as usize] = tmp[y as usize];
            y = y + 1;
        }
        ltl = l2;
    }
    var ln : u32 = jv_vput_str(lb[0..], 0, "last", lt[0..(ltl as usize)]);
    ln = jv_vput_f64(lb[0..], ln, "after", after as f64);
    n = jv_fill(dst, n, SAY_VERDICT_LAST, lb[0..], ln, false);
    return raw(dst, n, "</p></section>");
}

/// a > b as strings (UTF-16 order for BMP text, the bytes here).
fn str_gt(a: []const u8, al: u32, b: []const u8, bl: u32) -> bool {
    var m : u32 = al;
    if (bl < m) { m = bl; }
    var i : u32 = 0;
    while (i < m) {
        if (a[i as usize] != b[i as usize]) { return a[i as usize] > b[i as usize]; }
        i = i + 1;
    }
    return al > bl;
}

fn same_key(d: []const u8, a: i64, b: i64) -> bool {
    const ka : u8 = kind(d, a);
    if (ka != kind(d, b)) { return false; }
    if (ka == J_NUMBER) {
        const x : f64 = jv_num(d, a);
        const y : f64 = jv_num(d, b);
        return x == y or (x != x and y != y);
    }
    if (ka == J_STRING) {
        const l : u32 = str_len(d, a);
        if (l != str_len(d, b)) { return false; }
        var k : u32 = 0;
        while (k < l) {
            if (str_byte(d, a, k) != str_byte(d, b, k)) { return false; }
            k = k + 1;
        }
        return true;
    }
    return ka != J_OBJECT and ka != J_ARRAY and ka != J_NONE;
}

/// replace(/^\s+/, '') then the rest of the string t as escaped text.
fn trimmed_text(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    if (kind(d, sp) != J_STRING) { return n0; }
    var tmp : [4096]u8 = [0; 4096];
    const l : u32 = jv_str_to(tmp[0..], 0, d, sp);
    var lo : u32 = 0;
    var w : u32 = 1;
    while (lo < l and w > 0) {
        w = jv_ws_at(tmp[0..], lo, l);
        lo = lo + w;
    }
    var n : u32 = n0;
    var q : u32 = lo;
    while (q < l) {
        n = put_escaped(dst, n, tmp[q as usize]);
        q = q + 1;
    }
    return n;
}

fn tag_word(dst: []u8, n0: u32, d: []const u8, g: i64) -> u32 {
    var i : usize = 0;
    while (i < K_TAGS.len) {
        if (jv_is(d, g, K_TAGS[i])) { return text(dst, n0, SAY_TAGS[i]); }
        i = i + 1;
    }
    return jv_kid(dst, n0, d, g);
}

fn body_html(dst: []u8, n0: u32, d: []const u8, p: i64) -> u32 {
    var n : u32 = raw(dst, n0, "<div class=\"tt-body\"><p class=\"tt-meta\">");
    var sb : [1100]u8 = [0; 1100];
    const sl : u32 = stamp_raw(sb[0..], d, obj_get(d, p, "merged"));
    n = put_esc(dst, n, sb[0..], sl);
    n = raw(dst, n, ", ");
    n = jv_text(dst, n, d, obj_get(d, p, "author"));
    n = raw(dst, n, ", ");
    n = jv_text(dst, n, d, obj_get(d, p, "branch"));
    n = raw(dst, n, ", ");
    const cls : i64 = obj_get(d, p, "cls");
    const ci : i64 = key_index(d, cls);
    if (ci >= 0 and ci < (SAY_CLASSES.len as i64)) {
        n = text(dst, n, SAY_CLASSES[ci as usize]);
    } else {
        n = raw(dst, n, "undefined");
    }
    n = raw(dst, n, "</p><p class=\"tt-meta\">");
    var vb : [512]u8 = [0; 512];
    var vn : u32 = jv_vput_val(vb[0..], 0, "n", d, obj_get(d, p, "testFiles"));
    vn = jv_vput_val(vb[0..], vn, "all", d, obj_get(d, p, "allFiles"));
    n = jv_fill(dst, n, SAY_TEST_FILES, vb[0..], vn, false);
    n = raw(dst, n, "; ");
    const c : i64 = obj_get(d, p, "counts");
    vn = jv_vput_nn0(vb[0..], 0, "added", d, obj_get(d, c, "checksAdded"));
    vn = jv_vput_nn0(vb[0..], vn, "removed", d, obj_get(d, c, "checksRemoved"));
    vn = jv_vput_nn0(vb[0..], vn, "blocks", d, obj_get(d, c, "testsRemoved"));
    n = jv_fill(dst, n, SAY_CHECKS, vb[0..], vn, false);
    n = raw(dst, n, "</p>");
    const lines : i64 = obj_get(d, p, "lines");
    const lc : u32 = arr_len(d, lines);
    if (lc > 0) {
        // group by file in first-seen order
        var done : [128]bool = [false; 128];
        var a : u32 = 0;
        while (a < lc and a < 128) {
            if (!done[a as usize]) {
                const la : i64 = arr_at(d, lines, a);
                const fa : i64 = obj_get(d, la, "f");
                n = raw(dst, n, "<div class=\"tt-file\"><p class=\"tt-path\">");
                const fidx : i64 = key_index(d, fa);
                if (fidx >= 0) {
                    const fe : i64 = arr_at(d, obj_get(d, p, "files"), fidx as u32);
                    n = nn_text(dst, n, d, obj_get(d, fe, "p"));
                }
                n = raw(dst, n, "</p><ol class=\"tt-lines\">");
                var b : u32 = a;
                while (b < lc and b < 128) {
                    if (!done[b as usize]) {
                        const lb : i64 = arr_at(d, lines, b);
                        if (same_key(d, fa, obj_get(d, lb, "f"))) {
                            done[b as usize] = true;
                            const sgn : i64 = obj_get(d, lb, "s");
                            n = raw(dst, n, "<li class=\"tt-line tt-s");
                            if (jv_is(d, sgn, "-")) { n = raw(dst, n, "m"); } else { n = raw(dst, n, "p"); }
                            n = raw(dst, n, " tt-g-");
                            n = jv_text(dst, n, d, obj_get(d, lb, "g"));
                            n = raw(dst, n, "\"><span class=\"tt-tag\">");
                            n = tag_word(dst, n, d, obj_get(d, lb, "g"));
                            n = raw(dst, n, "</span><code>");
                            n = jv_text(dst, n, d, sgn);
                            n = put(dst, n, 32);
                            n = trimmed_text(dst, n, d, obj_get(d, lb, "t"));
                            n = raw(dst, n, "</code>");
                            if (jv_truthy(d, obj_get(d, lb, "b"))) {
                                n = raw(dst, n, "<span class=\"tt-block\">");
                                n = jv_text(dst, n, d, obj_get(d, lb, "b"));
                                n = raw(dst, n, "</span>");
                            }
                            n = raw(dst, n, "</li>");
                        }
                    }
                    b = b + 1;
                }
                n = raw(dst, n, "</ol></div>");
            }
            a = a + 1;
        }
    } else {
        n = raw(dst, n, "<p class=\"tt-meta\">");
        n = text(dst, n, SAY_NO_LINES);
        n = raw(dst, n, "</p>");
    }
    if (jv_truthy(d, obj_get(d, p, "more"))) {
        n = raw(dst, n, "<p class=\"tt-meta\">");
        var mb : [128]u8 = [0; 128];
        const mn : u32 = jv_vput_val(mb[0..], 0, "n", d, obj_get(d, p, "more"));
        n = jv_fill(dst, n, SAY_MORE_LINES, mb[0..], mn, false);
        n = raw(dst, n, "</p>");
    }
    if (jv_truthy(d, obj_get(d, p, "ciGate"))) {
        n = raw(dst, n, "<p class=\"tt-note\">");
        n = text(dst, n, SAY_CI_GATE);
        n = raw(dst, n, "</p>");
    }
    if (jv_truthy(d, obj_get(d, p, "apiOnly"))) {
        n = raw(dst, n, "<p class=\"tt-note\">");
        var ab : [128]u8 = [0; 128];
        const an : u32 = jv_vput_val(ab[0..], 0, "n", d, obj_get(d, p, "apiOnly"));
        n = jv_fill(dst, n, SAY_API_ONLY, ab[0..], an, false);
        n = raw(dst, n, "</p>");
    }
    const url : i64 = obj_get(d, p, "url");
    n = raw(dst, n, "<a");
    if (!nullish(d, url)) {
        n = raw(dst, n, " href=\"");
        n = jv_text(dst, n, d, url);
        n = raw(dst, n, "\"");
    }
    n = raw(dst, n, " target=\"_blank\" rel=\"noopener\" class=\"tt-open\">");
    n = text(dst, n, SAY_OPEN_PR);
    return raw(dst, n, "</a></div>");
}

/// A pool entry for `{key: x ?? 0}`.
fn jv_vput_nn0(vb: []u8, n0: u32, key: []const u8, d: []const u8, sp: i64) -> u32 {
    if (nullish(d, sp)) { return jv_vput_str(vb, n0, key, "0"); }
    return jv_vput_val(vb, n0, key, d, sp);
}

fn nn_text(dst: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    if (nullish(d, sp)) { return n0; }
    return jv_text(dst, n0, d, sp);
}

fn row_html(dst: []u8, n0: u32, d: []const u8, ri: u32) -> u32 {
    const p : i64 = PRS[ROWS[ri as usize] as usize];
    var n : u32 = raw(dst, n0, "<details class=\"tt-pr tt-r");
    n = jv_text(dst, n, d, obj_get(d, p, "badge"));
    n = raw(dst, n, "\"");
    if (ROW_OPEN[ri as usize]) { n = raw(dst, n, " open=\"\""); }
    n = raw(dst, n, "><summary>");
    n = badge_span(dst, n, d, obj_get(d, p, "badge"));
    n = put(dst, n, 32);
    n = chip_span(dst, n, d, obj_get(d, p, "lane"));
    n = raw(dst, n, " <span class=\"tt-num\">#");
    n = jv_text(dst, n, d, obj_get(d, p, "n"));
    n = raw(dst, n, "</span> <span class=\"tt-title\">");
    const tt : i64 = obj_get(d, p, "title");
    if (jv_truthy(d, tt)) { n = jv_text(dst, n, d, tt); } else { n = text(dst, n, SAY_NO_TITLE); }
    n = raw(dst, n, "</span></summary>");
    if (ROW_BODY[ri as usize]) { n = body_html(dst, n, d, p); }
    return raw(dst, n, "</details>");
}

fn filter_buttons(dst: []u8, n0: u32, which: u32) -> u32 {
    var n : u32 = n0;
    if (which == 0) {
        var i : i32 = 0 - 1;
        while (i < 2) {
            n = raw(dst, n, "<button type=\"button\" class=\"t27-btn\" aria-pressed=\"");
            if (LANE == i) { n = raw(dst, n, "true"); } else { n = raw(dst, n, "false"); }
            n = raw(dst, n, "\">");
            if (i < 0) { n = text(dst, n, SAY_ALL); } else { n = text(dst, n, SAY_LANE_NAMES[i as usize]); }
            n = raw(dst, n, "</button>");
            i = i + 1;
        }
    } else {
        var j : i32 = 0 - 1;
        while (j < 4) {
            var b : i32 = j;
            if (j >= 0) { b = 3 - j; }
            n = raw(dst, n, "<button type=\"button\" class=\"t27-btn\" aria-pressed=\"");
            if (BADGE == b) { n = raw(dst, n, "true"); } else { n = raw(dst, n, "false"); }
            n = raw(dst, n, "\">");
            if (b < 0) { n = text(dst, n, SAY_ALL); } else { n = text(dst, n, SAY_BADGES[b as usize]); }
            n = raw(dst, n, "</button>");
            j = j + 1;
        }
    }
    return n;
}

fn bullets_rule(dst: []u8, n0: u32) -> u32 {
    var n : u32 = raw(dst, n0, "<ul>");
    var i : usize = 0;
    while (i < SAY_RULE.len) {
        n = raw(dst, n, "<li>");
        n = text(dst, n, SAY_RULE[i]);
        n = raw(dst, n, "</li>");
        i = i + 1;
    }
    return raw(dst, n, "</ul>");
}

fn bullets_pos(dst: []u8, n0: u32) -> u32 {
    var n : u32 = raw(dst, n0, "<ul>");
    var i : usize = 0;
    while (i < SAY_FALSE_POS.len) {
        n = raw(dst, n, "<li>");
        n = text(dst, n, SAY_FALSE_POS[i]);
        n = raw(dst, n, "</li>");
        i = i + 1;
    }
    return raw(dst, n, "</ul>");
}

fn bullets_neg(dst: []u8, n0: u32) -> u32 {
    var n : u32 = raw(dst, n0, "<ul>");
    var i : usize = 0;
    while (i < SAY_FALSE_NEG.len) {
        n = raw(dst, n, "<li>");
        n = text(dst, n, SAY_FALSE_NEG[i]);
        n = raw(dst, n, "</li>");
        i = i + 1;
    }
    return raw(dst, n, "</ul>");
}

pub fn w_render(dst: []u8) -> u32 {
    var n : u32 = 0;
    if (DATA_STATE == 0) {
        n = raw(dst, n, "<p class=\"tt-note\">");
        n = text(dst, n, SAY_LOADING);
        n = raw(dst, n, "</p>");
        if (!ok(n)) { return 0; }
        return n;
    }
    if (DATA_STATE == 2) {
        n = raw(dst, n, "<p class=\"tt-note\">");
        n = text(dst, n, SAY_LOAD_FAILED);
        n = raw(dst, n, "</p>");
        if (!ok(n)) { return 0; }
        return n;
    }
    const d : []const u8 = DATA[0..(DATA_LEN as usize)];
    const r : i64 = root(d);
    n = raw(dst, n, "<p class=\"tt-snapshot\">");
    var vb : [1200]u8 = [0; 1200];
    var st : [1100]u8 = [0; 1100];
    const stl : u32 = stamp_raw(st[0..], d, obj_get(d, r, "snapshotAt"));
    var vn : u32 = jv_vput_str(vb[0..], 0, "at", st[0..(stl as usize)]);
    vn = jv_vput_val(vb[0..], vn, "days", d, obj_get(d, r, "days"));
    vn = jv_vput_val(vb[0..], vn, "repo", d, obj_get(d, r, "repo"));
    n = jv_fill(dst, n, SAY_SNAPSHOT, vb[0..], vn, false);
    n = raw(dst, n, "</p>");
    n = verdict_html(dst, n, d, r);
    n = raw(dst, n, "<div class=\"tt-lanes\">");
    n = lane_card(dst, n, d, r, 0);
    n = lane_card(dst, n, d, r, 1);
    n = raw(dst, n, "</div><div class=\"tt-filter\" role=\"group\"");
    n = attr(dst, n, "aria-label", SAY_FILTER_LANE);
    n = raw(dst, n, "><span class=\"tt-flabel\">");
    n = text(dst, n, SAY_FILTER_LANE);
    n = raw(dst, n, "</span>");
    n = filter_buttons(dst, n, 0);
    n = raw(dst, n, "</div><div class=\"tt-filter\" role=\"group\"");
    n = attr(dst, n, "aria-label", SAY_FILTER_BADGE);
    n = raw(dst, n, "><span class=\"tt-flabel\">");
    n = text(dst, n, SAY_FILTER_BADGE);
    n = raw(dst, n, "</span>");
    n = filter_buttons(dst, n, 1);
    n = raw(dst, n, "</div><p class=\"tt-meta\">");
    var cb : [128]u8 = [0; 128];
    var cn : u32 = jv_vput_f64(cb[0..], 0, "n", NROWS as f64);
    cn = jv_vput_f64(cb[0..], cn, "total", NPR as f64);
    n = jv_fill(dst, n, SAY_SHOWING, cb[0..], cn, false);
    n = raw(dst, n, "</p><div class=\"tt-list\">");
    var shown : u32 = NROWS;
    if (SHOWN < shown) { shown = SHOWN; }
    var i : u32 = 0;
    while (i < shown) {
        n = row_html(dst, n, d, i);
        i = i + 1;
    }
    n = raw(dst, n, "</div><button type=\"button\" class=\"t27-btn\" aria-pressed=\"false\"");
    if (NROWS <= SHOWN) { n = raw(dst, n, " hidden=\"\""); }
    n = raw(dst, n, ">");
    n = text(dst, n, SAY_SHOW_MORE);
    n = raw(dst, n, "</button><details class=\"tt-ruleblock\"");
    if (RULE_OPEN) { n = raw(dst, n, " open=\"\""); }
    n = raw(dst, n, "><summary>");
    n = text(dst, n, SAY_RULE_TITLE);
    n = raw(dst, n, "</summary>");
    n = bullets_rule(dst, n);
    n = raw(dst, n, "<h3>");
    n = text(dst, n, SAY_FALSE_POS_TITLE);
    n = raw(dst, n, "</h3>");
    n = bullets_pos(dst, n);
    n = raw(dst, n, "<h3>");
    n = text(dst, n, SAY_FALSE_NEG_TITLE);
    n = raw(dst, n, "</h3>");
    n = bullets_neg(dst, n);
    n = raw(dst, n, "<p>");
    n = text(dst, n, SAY_NOT_INTENT);
    n = raw(dst, n, "</p><p>");
    var eb : [128]u8 = [0; 128];
    const ex : i64 = obj_get(d, obj_get(d, r, "excluded"), "notMaster");
    var en : u32 = 0;
    if (nullish(d, ex)) { en = jv_vput_str(eb[0..], 0, "notMaster", "0"); } else { en = jv_vput_val(eb[0..], 0, "notMaster", d, ex); }
    n = jv_fill(dst, n, SAY_EXCLUDED, eb[0..], en, false);
    n = raw(dst, n, "</p></details>");
    if (!ok(n)) { return 0; }
    return n;
}

/// The splicer follows only the names a module itself mentions, not the names the imported functions
/// mention. This anchor mentions every helper the writer, the JSON reader and the number rules call.
/// Never called.
pub fn imports_anchor(o: []u8, s: []const u8) -> u32 {
    var n : u32 = 0;
    n = n + (ok(0) as u32);
    n = n + OVER;
    n = n + put(o, 0, 0);
    n = n + raw(o, 0, s);
    n = n + put_escaped(o, 0, 0);
    n = n + text(o, 0, s);
    n = n + num(o, 0, 0);
    n = n + attr(o, 0, s, s);
    n = n + fill(o, 0, s, s, s, s, 0);
    n = n + fill_named(o, 0, s, s, s, s, s, s, s, s, s, s, s, s, s);
    n = n + dec_to(o, 0);
    n = n + (name_is(s, 0, 0, s) as u32);
    n = n + (is_word_byte(0) as u32);
    n = n + (H_LT as u32);
    n = n + (H_GT as u32);
    n = n + (H_AMP as u32);
    n = n + (H_QUOTE as u32);
    n = n + (H_APOS as u32);
    n = n + (H_SPACE as u32);
    n = n + (H_SLASH as u32);
    n = n + (H_EQ as u32);
    n = n + ((NO_SPAN < 0) as u32);
    n = n + ((SPAN > 0) as u32);
    n = n + (J_NONE as u32);
    n = n + (J_OBJECT as u32);
    n = n + (J_ARRAY as u32);
    n = n + (J_STRING as u32);
    n = n + (J_NUMBER as u32);
    n = n + (J_TRUE as u32);
    n = n + (J_FALSE as u32);
    n = n + (J_NULL as u32);
    n = n + (jspan(0, 0) as u32);
    n = n + (span_lo(0) as u32);
    n = n + (span_hi(0) as u32);
    n = n + (skip_ws(s, 0) as u32);
    n = n + (string_end(s, 0) as u32);
    n = n + (value_end(s, 0) as u32);
    n = n + (root(s) as u32);
    n = n + (kind(s, 0) as u32);
    n = n + (key_is(s, 0, 0, s) as u32);
    n = n + (obj_get(s, 0, s) as u32);
    n = n + arr_len(s, 0);
    n = n + (arr_at(s, 0, 0) as u32);
    n = n + hex4(s, 0);
    n = n + escape_at(s, 0, 0);
    n = n + cp_utf8_len(0);
    n = n + (cp_utf8_byte(0, 0) as u32);
    n = n + str_len(s, 0);
    n = n + (str_byte(s, 0, 0) as u32);
    n = n + JN_OVER;
    n = n + JN_CAP;
    n = n + ((JN_TWO52 > 0.0) as u32);
    n = n + ((JN_TWO53 > 0.0) as u32);
    n = n + jn_put(o, 0, 0);
    n = n + jn_raw(o, 0, s);
    n = n + jn_digits(o, 0);
    n = n + jn_mul(o, 0, 0);
    n = n + jn_mul2(o, 0, 0);
    n = n + jn_mul5(o, 0, 0);
    n = n + jn_shift(o, 0, 0);
    n = n + (jn_cmp(s, s, 0) as u32);
    n = n + (jn_expo(0.0) as u32);
    n = n + (jn_mant(0.0) as u32);
    n = n + ((jn_make(0, 0) > 0.0) as u32);
    n = n + jn_exact(o, 0, 0);
    n = n + jn_fscale(0);
    n = n + (js_is_nan(0.0) as u32);
    n = n + ((js_nan(0.0) > 0.0) as u32);
    n = n + ((js_inf(1.0) > 0.0) as u32);
    n = n + ((js_floor(0.0) > 0.0) as u32);
    n = n + ((js_ceil(0.0) > 0.0) as u32);
    n = n + ((js_max(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_min(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_round(0.0) > 0.0) as u32);
    n = n + (jn_shortest(o, 1.0) as u32);
    n = n + jn_copy(o, s, 0);
    n = n + jn_put_run(o, 0, s, 0, 0);
    n = n + jn_layout(o, 0, s, 0, 0);
    n = n + js_str_num(o, 0, 0.0);
    n = n + js_to_fixed(o, 0, 0.0, 0);
    n = n + js_locale_num(o, 0, 0.0);
    n = n + (jn_num_ok(s, 0, 0) as u32);
    n = n + (jn_cmp_text(s, 0, 0, 0, 0) as u32);
    n = n + ((js_parse_num(s, 0, 0) > 0.0) as u32);
    n = n + ((jn_dec_value(s, 0, 0) > 0.0) as u32);
    n = n + (jn_abs(0) as u32);
    n = n + js_str_u64(o, 0, 0);
    n = n + jv_str_to(o, 0, s, 0);
    n = n + jv_text_str(o, 0, s, 0);
    n = n + ((jv_numval(s, 0) > 0.0) as u32);
    n = n + jv_str(o, 0, s, 0);
    n = n + jv_text(o, 0, s, 0);
    n = n + (jv_is(s, 0, s) as u32);
    n = n + (jv_truthy(s, 0) as u32);
    n = n + (jv_is_ws(0) as u32);
    n = n + ((jv_number_of_text(s, 0) > 0.0) as u32);
    n = n + ((jv_num(s, 0) > 0.0) as u32);
    n = n + jv_vput_str(o, 0, s, s);
    n = n + jv_vput_f64(o, 0, s, 0.0);
    n = n + jv_vput_val(o, 0, s, s, 0);
    n = n + jv_vput_defined(o, 0, s, s, 0);
    n = n + jv_vput_fixed(o, 0, s, 0.0, 0);
    n = n + jv_kid(o, 0, s, 0);
    n = n + jv_find(s, 0, s);
    n = n + jv_fill(o, 0, s, s, 0, true);
    n = n + (jv_string_ok(s, 0) as u32);
    n = n + (jv_number_ok(s, 0) as u32);
    n = n + (jv_lit_ok(s, 0, s) as u32);
    n = n + (jv_valid(s) as u32);
    n = n + jv_ws_at(s, 0, 0);
    n = n + jv_ws_before(s, 0, 0);
    n = n + jv_digit_value(0);
    n = n + jv_fill_raw(o, 0, s, s, 0, true);
    n = n + jv_fill_with(o, 0, s, s, 0, true, true);
    return n;
}
