; --- Tests: each holds of this file, and scripts/widget-data/cost-curves.mjs runs them again with
; every K_ fact replaced by the value computed from data.json.
test add_luts_grow_with_width {
    assert K_ADD_LUTS[1] > K_ADD_LUTS[0];
    assert K_ADD_LUTS[2] > K_ADD_LUTS[1];
    assert K_ADD_LUTS[3] > K_ADD_LUTS[2];
    assert K_ADD_LUTS[4] > K_ADD_LUTS[3];
    assert K_ADD_LUTS[5] > K_ADD_LUTS[4];
    assert K_ADD_LUTS[6] > K_ADD_LUTS[5];
    assert K_ADD_LUTS[7] > K_ADD_LUTS[6];
}

test nodsp_multiplier_luts_grow_with_width {
    assert K_MUL_NODSP_LUTS[1] > K_MUL_NODSP_LUTS[0];
    assert K_MUL_NODSP_LUTS[2] > K_MUL_NODSP_LUTS[1];
    assert K_MUL_NODSP_LUTS[3] > K_MUL_NODSP_LUTS[2];
    assert K_MUL_NODSP_LUTS[4] > K_MUL_NODSP_LUTS[3];
    assert K_MUL_NODSP_LUTS[5] > K_MUL_NODSP_LUTS[4];
    assert K_MUL_NODSP_LUTS[6] > K_MUL_NODSP_LUTS[5];
    assert K_MUL_NODSP_LUTS[7] > K_MUL_NODSP_LUTS[6];
}

test capacity_is_counted_per_slice {
    assert K_CAP_LUT6 == 4 * (K_CAP_SLICES as u32);
    assert K_CAP_FF == 8 * (K_CAP_SLICES as u32);
    assert K_CAP_CARRY4 == K_CAP_SLICES;
    assert K_CAP_LUT_BELS == 2 * K_CAP_LUT6;
}

test hook_is_the_widest_nodsp_multiplier {
    assert K_HOOK_LUTS == K_MUL_NODSP_LUTS[7];
    assert (K_HOOK_BASIS_POINTS as u32) == (K_HOOK_LUTS as u32) * 10000 / K_CAP_LUT6;
    assert K_MUL_DSP48[7] == 16;
    assert K_WIDTHS[7] == 64;
}

test trit_counts_carry_the_bit_widths {
    assert K_TRIT_COUNTS[0] * K_LOG2_3_MILLI / 1000 <= K_WIDTHS[0];
    assert K_TRIT_COUNTS[0] * K_LOG2_3_MILLI / 1000 + 1 >= K_WIDTHS[0];
    assert K_TRIT_COUNTS[1] * K_LOG2_3_MILLI / 1000 <= K_WIDTHS[1];
    assert K_TRIT_COUNTS[1] * K_LOG2_3_MILLI / 1000 + 1 >= K_WIDTHS[1];
    assert K_TRIT_COUNTS[2] * K_LOG2_3_MILLI / 1000 <= K_WIDTHS[2];
    assert K_TRIT_COUNTS[2] * K_LOG2_3_MILLI / 1000 + 1 >= K_WIDTHS[2];
    assert K_TRIT_COUNTS[3] * K_LOG2_3_MILLI / 1000 <= K_WIDTHS[3];
    assert K_TRIT_COUNTS[3] * K_LOG2_3_MILLI / 1000 + 1 >= K_WIDTHS[3];
    assert K_TRIT_COUNTS[4] * K_LOG2_3_MILLI / 1000 <= K_WIDTHS[4];
    assert K_TRIT_COUNTS[4] * K_LOG2_3_MILLI / 1000 + 1 >= K_WIDTHS[4];
    assert K_TRIT_COUNTS[5] * K_LOG2_3_MILLI / 1000 <= K_WIDTHS[5];
    assert K_TRIT_COUNTS[5] * K_LOG2_3_MILLI / 1000 + 1 >= K_WIDTHS[5];
    assert K_TRIT_COUNTS[6] * K_LOG2_3_MILLI / 1000 <= K_WIDTHS[6];
    assert K_TRIT_COUNTS[6] * K_LOG2_3_MILLI / 1000 + 1 >= K_WIDTHS[6];
    assert K_TRIT_COUNTS[7] * K_LOG2_3_MILLI / 1000 <= K_WIDTHS[7];
    assert K_TRIT_COUNTS[7] * K_LOG2_3_MILLI / 1000 + 1 >= K_WIDTHS[7];
    assert K_T27_INFO_MILLIBITS[3] <= 27 * K_LOG2_3_MILLI;
    assert K_T27_INFO_MILLIBITS[3] + 1 >= 27 * K_LOG2_3_MILLI;
    assert K_T27_INFO_MILLIBITS[4] == K_T27_INFO_MILLIBITS[3];
}

test binary_encoded_trits_cost_more_luts_at_equal_information {
    assert K_TADD_LUTS[0] > K_ADD_LUTS[0];
    assert K_TADD_LUTS[1] > K_ADD_LUTS[1];
    assert K_TADD_LUTS[2] > K_ADD_LUTS[2];
    assert K_TADD_LUTS[3] > K_ADD_LUTS[3];
    assert K_TADD_LUTS[4] > K_ADD_LUTS[4];
    assert K_TADD_LUTS[5] > K_ADD_LUTS[5];
    assert K_TADD_LUTS[6] > K_ADD_LUTS[6];
    assert K_TADD_LUTS[7] > K_ADD_LUTS[7];
    assert K_T27_FA_LUTS > K_TWIN_FA1_LUTS;
    assert K_T27_RIPPLE_LUTS > K_TWIN_ADD2_LUTS;
}

test the_stream_mac_uses_no_dsp {
    assert K_STREAM_MAC_DSP48 == 0;
    assert K_STREAM_MAC_FFS == 32;
    assert K_REJECTED + K_EMPTY > 0;
}


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, issue #10938, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/cost-curves/tool.js (273 lines of hand-written JavaScript).
; The words above are unchanged and are the only words the view prints. Host protocol (jtag_verdict.t27's
; plus, all optional, the host calls what the wasm exports):
;   w_init(hash)              the page opens: state "loading"
;   w_theme(bytes)            the nine colours of the shared frame, one per line, as getComputedStyle gives
;                             them (--w-bg --w-panel --w-line --w-green --w-gold --w-red --w-text --w-muted
;                             --w-subtle), trimmed, empty where a variable is not set (tool.js writes them
;                             into the SVG as they come)
;   w_size(px, root_px, inner_h, embed)   the width of #widget (root_px, 0 when not laid out), the window height
;                             and whether the page is embedded; the host calls it after every draw and when the
;                             page is resized (tool.js's ResizeObserver); 1 means draw again
;   w_data(i, bytes)          data.json (K_DATA_FILES) has been fetched; w_data_failed(i, message) when it
;                             could not be: the message is what tool.js shows, "HTTP 404" or the engine's own
;   w_click(i)                button i was pressed (index among the page's buttons)
;   w_pointer(kind, x, y, bw, bh)  the pointer over the chart: kind 0 moved or went down, 1 left (mouse); x and y
;                             are relative to the SVG's box (getBoundingClientRect), bw and bh its size
;   w_tipsize(w, h)           the tooltip is on screen and is w by h (offsetWidth, offsetHeight); 1: draw again
;   w_render(dst) -> len      the page's HTML (0 on overflow); the host draws again while
;   w_libm_need(dst) -> n     says n calls were missing in that pass: n records of three f64, op, a, b, with op
;                             0 sin 1 cos 2 atan2 3 log2 4 log10 5 pow 6 7 8 the shortest digits of a
;                             (6: digits div 1e8, 7: digits mod 1e8, 8: the position of the decimal point),
;                             which the host takes from Number.prototype.toExponential(); the host answers with
;   w_libm_give(src, n)       the n results in order, and the pass is repeated until none is missing.
; Why the libm service: Math.log2, Math.log10 and ** of the engine are not the portable libm's, and the chart
; prints every coordinate as String(double), shortest digits that read back, which only the engine knows.
; --
; What is NOT carried over from tool.js (also reported in the commit message):
;  * data.json above 262144 bytes, 512 results, 64 findings, 64 specs or 2048 commands show the loading page;
;    a data.json that is JSON but lacks results, capacity, specs, findings, tools, timing, adder_check, spec,
;    compiler, commands, synth or generated_at (tool.js throws and leaves "Reading ...") also shows it;
;  * the tooltip is placed from the size the host reports after the content is drawn (tool.js reads
;    offsetWidth in the same turn), so in a real browser its first position can differ by a pixel or two;
;  * no non-ASCII case mapping (toLowerCase of the operation name).
; --

pub const K_DATA_FILES : [1]str = ["./data.json"];

pub const W_CAP_DATA : u32 = 262144;
pub const W_MAX_RES : u32 = 512;
pub const W_MAX_FIND : u32 = 64;
pub const W_MAX_SPECS : u32 = 64;
pub const W_NO : u32 = 4294967295;

pub var DATA : [262144]u8 = [0; 262144];
pub var DATA_LEN : u32 = 0;
pub var D_STATE : u8 = 0;
pub var ERRMSG : [512]u8 = [0; 512];
pub var ERRMSG_LEN : u32 = 0;
pub var READY : bool = false;
pub var STUCK : bool = false;

// the data, read once
pub var N_RES : u32 = 0;
pub var R_FAM : [512]u8 = [0; 512];
pub var R_OP : [512]u8 = [0; 512];
pub var R_DSP : [512]u8 = [0; 512];
pub var R_OK : [512]u8 = [0; 512];
pub var R_BITS : [512]f64 = [0.0; 512];
pub var R_TRITS : [512]f64 = [0.0; 512];
pub var R_HAS_TRITS : [512]u8 = [0; 512];
pub var R_SEC : [512]f64 = [0.0; 512];
pub var R_MET : [3072]f64 = [0.0; 3072];
pub var R_TOP : [512]i64 = [0; 512];
pub var R_SPEC : [512]i64 = [0; 512];
pub var R_ID : [512]i64 = [0; 512];
pub var R_EL : [512]i64 = [0; 512];
pub var CAP_V : [4]f64 = [0.0; 4];
pub var J_RES : i64 = 0;
pub var J_CAP : i64 = 0;
pub var J_SPECS : i64 = 0;
pub var J_FIND : i64 = 0;
pub var J_TOOLS : i64 = 0;
pub var J_TIMING : i64 = 0;
pub var J_CHECK : i64 = 0;
pub var J_SPEC : i64 = 0;
pub var J_COMP : i64 = 0;
pub var J_CMDS : i64 = 0;
pub var J_ROOT : i64 = 0;

// the page state
pub var OP : u32 = 0;
pub var METRIC : u32 = 0;
pub var DSP : bool = false;
pub var LOGSCALE : bool = true;
pub var TABLE : bool = false;
pub var WROOT : f64 = 0.0;
pub var LAST_RW : f64 = 0.0;
pub var INNER_H : f64 = 0.0;
pub var EMBED : bool = false;
pub var THEME : [288]u8 = [0; 288];
pub var THEME_L : [9]u32 = [0; 9];

// hover state of the chart (reset by every render the events cause)
pub var HOVER_ON : bool = false;
pub var HOVER_MARK : i32 = -1;
pub var TIP_SHOWN : bool = false;
pub var TIP_MARK : i32 = -1;
pub var TIP_STYLE : bool = false;
pub var TIP_LEFT : f64 = 0.0;
pub var TIP_TOP : f64 = 0.0;
pub var TIP_PENDING : bool = false;
pub var BOX_W : f64 = 0.0;
pub var BOX_H : f64 = 0.0;
pub var HALO_X : f64 = 0.0;
pub var HALO_Y : f64 = 0.0;
pub var HALO_ON : bool = false;
pub var HALO_SET : bool = false;

// the marks of the chart as last drawn: for the pointer
pub var MK_R : [512]u32 = [0; 512];
pub var MK_S : [512]u8 = [0; 512];
pub var MK_X : [512]f64 = [0.0; 512];
pub var MK_Y : [512]f64 = [0.0; 512];
pub var MK_N : u32 = 0;
pub var CH_W : f64 = 0.0;
pub var CH_H : f64 = 0.0;

// the libm service
pub var LB_OP : [16384]u8 = [0; 16384];
pub var LB_A : [16384]f64 = [0.0; 16384];
pub var LB_B : [16384]f64 = [0.0; 16384];
pub var LB_R : [16384]f64 = [0.0; 16384];
pub var LB_N : u32 = 0;
pub var RQ_OP : [16384]u8 = [0; 16384];
pub var RQ_A : [16384]f64 = [0.0; 16384];
pub var RQ_B : [16384]f64 = [0.0; 16384];
pub var RQ_N : u32 = 0;
pub var RQ_SENT : u32 = 0;
pub var MISSING : bool = false;

// text scratch
pub var FB : [65536]u8 = [0; 65536];
pub var FB_N : u32 = 0;
pub var FK_O : [32]u32 = [0; 32];
pub var FK_L : [32]u32 = [0; 32];
pub var FV_O : [32]u32 = [0; 32];
pub var FV_L : [32]u32 = [0; 32];
pub var F_N : u32 = 0;
pub var TB : [4096]u8 = [0; 4096];
pub var TB2 : [4096]u8 = [0; 4096];
pub var NB : [64]u8 = [0; 64];

// ------------------------------------------------------------------------------------------------
// numbers, the libm service
// ------------------------------------------------------------------------------------------------

pub var R_MHAS : [3072]u8 = [0; 3072];
pub var SM : u64 = 0;
pub var SK : u32 = 0;

fn pow10f(k: u32) -> f64 {
    var p : f64 = 1.0;
    var i : u32 = 0;
    while (i < k) {
        p = p * 10.0;
        i = i + 1;
    }
    return p;
}

fn jsround(x: f64) -> f64 {
    const r : f64 = @floor(x);
    if (x - r >= 0.5) { return r + 1.0; }
    return r;
}

fn neg_zero(x: f64) -> bool {
    if (x != 0.0) { return false; }
    var y : f64 = x;
    return 1.0 / y < 0.0;
}

fn inf() -> f64 {
    var z : f64 = 0.0;
    return 1.0 / z;
}

fn jsmax(a: f64, b: f64) -> f64 {
    if (a != a) { return a; }
    if (b != b) { return b; }
    if (a > b) { return a; }
    return b;
}

fn jsmin(a: f64, b: f64) -> f64 {
    if (a != a) { return a; }
    if (b != b) { return b; }
    if (a < b) { return a; }
    return b;
}

/// The shortest decimal that reads back as v (v >= 0, finite, below 2^53, not a whole number): SM, SK.
fn shortest_dec(v: f64) -> bool {
    var k : u32 = 0;
    while (k <= 20) {
        const p : f64 = pow10f(k);
        const m : f64 = jsround(v * p);
        if (m >= 9007199254740992.0) { return false; }
        if (m / p == v) {
            SM = m as u64;
            SK = k;
            return true;
        }
        k = k + 1;
    }
    return false;
}

fn same_f64(a: f64, b: f64) -> bool {
    if (a != a) { return b != b; }
    if (a == b) {
        if (a == 0.0) { return neg_zero(a) == neg_zero(b); }
        return true;
    }
    return false;
}

/// A libm call: the answer when the host has given it, else 0.0 and the call is queued for the host.
fn libm(op: u32, a: f64, b: f64) -> f64 {
    var i : u32 = 0;
    while (i < LB_N) {
        if ((LB_OP[i as usize] as u32) == op and same_f64(LB_A[i as usize], a) and same_f64(LB_B[i as usize], b)) { return LB_R[i as usize]; }
        i = i + 1;
    }
    MISSING = true;
    var j : u32 = 0;
    while (j < RQ_N) {
        if ((RQ_OP[j as usize] as u32) == op and same_f64(RQ_A[j as usize], a) and same_f64(RQ_B[j as usize], b)) { return 0.0; }
        j = j + 1;
    }
    if (RQ_N < 16384) {
        RQ_OP[RQ_N as usize] = op as u8;
        RQ_A[RQ_N as usize] = a;
        RQ_B[RQ_N as usize] = b;
        RQ_N = RQ_N + 1;
    }
    return 0.0;
}

pub fn w_libm_need(dst: []f64) -> u32 {
    if (RQ_N == 0) { return 0; }
    var k : u32 = 0;
    while (k < RQ_N and ((k * 3 + 2) as usize) < dst.len) {
        dst[(k * 3) as usize] = RQ_OP[k as usize] as f64;
        dst[(k * 3 + 1) as usize] = RQ_A[k as usize];
        dst[(k * 3 + 2) as usize] = RQ_B[k as usize];
        k = k + 1;
    }
    RQ_SENT = k;
    return k;
}

pub fn w_libm_give(src: []const f64, n: u32) -> u32 {
    var k : u32 = 0;
    while (k < n and k < RQ_SENT and (k as usize) < src.len) {
        if (LB_N >= 16384) { LB_N = 0; }
        LB_OP[LB_N as usize] = RQ_OP[k as usize];
        LB_A[LB_N as usize] = RQ_A[k as usize];
        LB_B[LB_N as usize] = RQ_B[k as usize];
        LB_R[LB_N as usize] = src[k as usize];
        LB_N = LB_N + 1;
        k = k + 1;
    }
    RQ_N = 0;
    RQ_SENT = 0;
    MISSING = false;
    return 0;
}

fn log2f(v: f64) -> f64 { return libm(3, v, 0.0); }
fn log10f(v: f64) -> f64 { return libm(4, v, 0.0); }
fn powf(a: f64, b: f64) -> f64 { return libm(5, a, b); }

/// String(v): whole numbers below 2^53 directly; every other double through the host's shortest digits.
fn put_js(o: []u8, n0: u32, v0: f64) -> u32 {
    var n : u32 = n0;
    if (v0 != v0) { return raw(o, n, "NaN"); }
    if (v0 == inf()) { return raw(o, n, "Infinity"); }
    if (v0 == 0.0 - inf()) { return raw(o, n, "-Infinity"); }
    if (v0 == 0.0) { return put(o, n, 48); }
    var v : f64 = v0;
    if (v < 0.0) {
        n = put(o, n, 45);
        v = 0.0 - v0;
    }
    if (v == @floor(v) and v < 9007199254740992.0) { return num(o, n, v as u64); }
    const hi : f64 = libm(6, v, 0.0);
    const lo : f64 = libm(7, v, 0.0);
    const pos : f64 = libm(8, v, 0.0);
    if (MISSING) { return n; }
    const m : u64 = (hi as u64) * 100000000 + (lo as u64);
    var dg : [24]u8 = [0; 24];
    const k : u32 = dec_to(dg[0..], m);
    const p : i64 = pos as i64;
    var i : u32 = 0;
    if (p >= (k as i64) and p <= 21) {
        while (i < k) { n = put(o, n, dg[i as usize]); i = i + 1; }
        var z : i64 = p - (k as i64);
        while (z > 0) { n = put(o, n, 48); z = z - 1; }
        return n;
    }
    if (p > 0 and p <= 21) {
        while (i < k) {
            if ((i as i64) == p) { n = put(o, n, 46); }
            n = put(o, n, dg[i as usize]);
            i = i + 1;
        }
        return n;
    }
    if (p > -6 and p <= 0) {
        n = raw(o, n, "0.");
        var z : i64 = 0 - p;
        while (z > 0) { n = put(o, n, 48); z = z - 1; }
        while (i < k) { n = put(o, n, dg[i as usize]); i = i + 1; }
        return n;
    }
    n = put(o, n, dg[0]);
    if (k > 1) {
        n = put(o, n, 46);
        i = 1;
        while (i < k) { n = put(o, n, dg[i as usize]); i = i + 1; }
    }
    n = put(o, n, 101);
    var e : i64 = p - 1;
    if (e < 0) {
        n = put(o, n, 45);
        e = 0 - e;
    } else {
        n = put(o, n, 43);
    }
    return num(o, n, e as u64);
}

/// Number(v).toLocaleString('en-US'): groups of three, at most three decimals, "-0" for a negative zero.
fn put_locale(o: []u8, n0: u32, v0: f64) -> u32 {
    var n : u32 = n0;
    if (v0 != v0) { return raw(o, n, "NaN"); }
    var v : f64 = v0;
    if (v0 < 0.0 or neg_zero(v0)) {
        n = put(o, n, 45);
        v = 0.0 - v0;
        if (v0 == 0.0) { v = 0.0; }
    }
    if (v == inf()) {
        n = put(o, n, 226);
        n = put(o, n, 136);
        return put(o, n, 158);
    }
    if (v == @floor(v) and v < 9007199254740992.0) { return num_grouped(o, n, v as u64); }
    var m : u64 = 0;
    var k : u32 = 0;
    if (v < 9007199254740992.0 and shortest_dec(v)) {
        m = SM;
        k = SK;
    } else {
        if (v >= 9007199254740.0) { return num_grouped(o, n, v as u64); }
        // a double with more than 15 digits: three decimals of its value
        m = jsround(v * 1000.0) as u64;
        k = 3;
    }
    while (k > 3) {
        const q : u64 = m / 10;
        const r : u64 = m % 10;
        m = q;
        if (k == 4 and r >= 5) { m = m + 1; }
        k = k - 1;
    }
    while (k > 0 and m % 10 == 0) {
        m = m / 10;
        k = k - 1;
    }
    var p : u64 = 1;
    var i : u32 = 0;
    while (i < k) {
        p = p * 10;
        i = i + 1;
    }
    n = num_grouped(o, n, m / p);
    if (k > 0) {
        n = put(o, n, 46);
        var f : u64 = m % p;
        var d : u32 = 0;
        var div : u64 = p / 10;
        while (d < k) {
            n = put(o, n, ((f / div) as u8) + 48);
            f = f % div;
            if (div > 1) { div = div / 10; }
            d = d + 1;
        }
    }
    return n;
}

/// A CSS length number as the CSSOM writes it back (Chrome, measured): 6 significant digits, no trailing zeros.
/// Only for v >= 1 (the tooltip's left and top are at least 4).
fn put_css6(o: []u8, n0: u32, v: f64) -> u32 {
    if (v >= 1000000.0 or v < 1.0) { return put_js(o, n0, v); }
    var e : u32 = 0;
    while (e < 6 and v >= pow10f(e + 1)) { e = e + 1; }
    const k : u32 = 5 - e;
    var m : u64 = jsround(v * pow10f(k)) as u64;
    var ee : u32 = e;
    if (m >= 1000000) {
        m = 100000;
        ee = e + 1;
    }
    var dg : [8]u8 = [0; 8];
    const len : u32 = dec_to(dg[0..], m);
    var n : u32 = n0;
    var i : u32 = 0;
    // the digits, the point after ee + 1 of them, a fraction without trailing zeros
    var last : u32 = len;
    while (last > ee + 1 and dg[(last - 1) as usize] == 48) { last = last - 1; }
    while (i < last) {
        if (i == ee + 1) { n = put(o, n, 46); }
        n = put(o, n, dg[i as usize]);
        i = i + 1;
    }
    return n;
}

fn put_r(o: []u8, n0: u32, v: f64, d: u32) -> u32 {
    var p : f64 = 10.0;
    if (d == 3) { p = 1000.0; }
    return put_js(o, n0, jsround(v * p) / p);
}

// ------------------------------------------------------------------------------------------------
// text and JSON helpers
// ------------------------------------------------------------------------------------------------

fn copy_to(dst: []u8, src: []const u8, cap: u32) -> u32 {
    var n : u32 = src.len as u32;
    if (n > cap) { n = cap; }
    var k : u32 = 0;
    while (k < n) {
        dst[k as usize] = src[k as usize];
        k = k + 1;
    }
    return n;
}

fn dsl() -> []const u8 {
    return DATA[0..(DATA_LEN as usize)];
}

fn jstr_is(sp: i64, lit: []const u8) -> bool {
    const d : []const u8 = dsl();
    if (kind(d, sp) != J_STRING) { return false; }
    if (str_len(d, sp) != (lit.len as u32)) { return false; }
    var k : usize = 0;
    while (k < lit.len) {
        if (str_byte(d, sp, k as u32) != lit[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// Number(token): up to 15 significant digits and a small exponent through json_scan's reader (one correctly
/// rounded division); anything else through the host, which gets the first 17 digits and the exponent (op 9).
fn jnum(sp: i64) -> f64 {
    const d : []const u8 = dsl();
    if (kind(d, sp) != J_NUMBER) { return 0.0; }
    var i : usize = span_lo(sp);
    const hi : usize = span_hi(sp);
    var neg : bool = false;
    if (i < hi and d[i] == 45) { neg = true; i = i + 1; }
    var dg : [64]u8 = [0; 64];
    var cnt : u32 = 0;
    var point : i64 = 0;
    var seen_point : bool = false;
    var lead : bool = true;
    var frac_digits : i64 = 0;
    while (i < hi and (is_dg(d[i]) or d[i] == 46)) {
        if (d[i] == 46) {
            seen_point = true;
        } else {
            if (seen_point) { frac_digits = frac_digits + 1; }
            if (!(lead and d[i] == 48)) {
                lead = false;
                if (cnt < 64) { dg[cnt as usize] = d[i]; cnt = cnt + 1; } else { point = point + 1; }
            }
        }
        i = i + 1;
    }
    var ex : i64 = 0;
    if (i < hi and (d[i] == 101 or d[i] == 69)) {
        i = i + 1;
        var eneg : bool = false;
        if (i < hi and d[i] == 43) { i = i + 1; }
        if (i < hi and d[i] == 45) { eneg = true; i = i + 1; }
        while (i < hi and is_dg(d[i])) {
            if (ex < 100000) { ex = ex * 10 + ((d[i] - 48) as i64); }
            i = i + 1;
        }
        if (eneg) { ex = 0 - ex; }
    }
    // value = digits x 10^(ex - frac_digits + point), digits without leading zeros
    var e10 : i64 = ex - frac_digits + point;
    while (cnt > 0 and dg[(cnt - 1) as usize] == 48) { cnt = cnt - 1; e10 = e10 + 1; }
    if (cnt == 0) { return num_f64(d, sp); }
    if (cnt <= 15 and e10 >= -22 and e10 <= 22) { return num_f64(d, sp); }
    if (cnt > 17) {
        e10 = e10 + ((cnt - 17) as i64);
        cnt = 17;
    }
    var hi_v : f64 = 0.0;
    var lo_v : f64 = 0.0;
    var k : u32 = 0;
    while (k < cnt) {
        if (cnt - k > 8) { hi_v = hi_v * 10.0 + ((dg[k as usize] - 48) as f64); } else { lo_v = lo_v * 10.0 + ((dg[k as usize] - 48) as f64); }
        k = k + 1;
    }
    var v : f64 = libm(9, hi_v, lo_v * 1000.0 + ((e10 + 500) as f64));
    if (neg) { v = 0.0 - v; }
    return v;
}

fn is_dg(b: u8) -> bool {
    return b >= 48 and b <= 57;
}

fn jget(sp: i64, key: []const u8) -> i64 {
    return obj_get(dsl(), sp, key);
}

fn jkind(sp: i64) -> u8 {
    return kind(dsl(), sp);
}

/// JavaScript's truthiness of the JSON value at sp (absent counts as undefined).
fn jtruthy(sp: i64) -> bool {
    if (sp < 0) { return false; }
    const d : []const u8 = dsl();
    const k : u8 = kind(d, sp);
    if (k == J_NULL or k == J_FALSE) { return false; }
    if (k == J_STRING) { return str_len(d, sp) > 0; }
    if (k == J_NUMBER) { return num_f64(d, sp) != 0.0 and num_f64(d, sp) == num_f64(d, sp); }
    return true;
}

fn jnullish(sp: i64) -> bool {
    if (sp < 0) { return true; }
    return kind(dsl(), sp) == J_NULL;
}

/// The decoded string at sp, escaped as text.
fn put_jtext(o: []u8, n0: u32, sp: i64) -> u32 {
    const d : []const u8 = dsl();
    var n : u32 = n0;
    const len : u32 = str_len(d, sp);
    var k : u32 = 0;
    while (k < len) {
        n = put_escaped(o, n, str_byte(d, sp, k));
        k = k + 1;
    }
    return n;
}

/// The decoded string at sp, appended raw to FB; its offset in FB (length in FB_N difference).
fn fb_str(sp: i64) -> u32 {
    const d : []const u8 = dsl();
    const len : u32 = str_len(d, sp);
    var k : u32 = 0;
    while (k < len and (FB_N as usize) < FB.len) {
        FB[FB_N as usize] = str_byte(d, sp, k);
        FB_N = FB_N + 1;
        k = k + 1;
    }
    return len;
}

fn fb_lit(s: []const u8) -> u32 {
    var k : usize = 0;
    while (k < s.len and (FB_N as usize) < FB.len) {
        FB[FB_N as usize] = s[k];
        FB_N = FB_N + 1;
        k = k + 1;
    }
    return s.len as u32;
}

/// String(value of the JSON value at sp) appended to FB; undefined for an absent value.
fn fb_value(sp: i64) -> u32 {
    if (sp < 0) { return fb_lit("undefined"); }
    const d : []const u8 = dsl();
    const k : u8 = kind(d, sp);
    if (k == J_STRING) { return fb_str(sp); }
    if (k == J_NULL) { return fb_lit("null"); }
    if (k == J_TRUE) { return fb_lit("true"); }
    if (k == J_FALSE) { return fb_lit("false"); }
    if (k == J_NUMBER) {
        const at : u32 = FB_N;
        const m : u32 = put_js(FB[0..], FB_N, num_f64(d, sp));
        if (m == OVER) { return 0; }
        FB_N = m;
        return m - at;
    }
    if (k == J_OBJECT) { return fb_lit("[object Object]"); }
    // an array: its elements, joined by commas
    const cnt : u32 = arr_len(d, sp);
    const at : u32 = FB_N;
    var i : u32 = 0;
    while (i < cnt) {
        if (i > 0) { fb_lit(","); }
        const el : i64 = arr_at(d, sp, i);
        if (kind(d, el) != J_NULL) { fb_value(el); }
        i = i + 1;
    }
    return FB_N - at;
}

fn f_clear() {
    FB_N = 0;
    F_N = 0;
}

fn f_key(key: []const u8) {
    FK_O[F_N as usize] = FB_N;
    FK_L[F_N as usize] = fb_lit(key);
}

fn f_val_end(o: u32) {
    FV_O[F_N as usize] = o;
    FV_L[F_N as usize] = FB_N - o;
    F_N = F_N + 1;
}

/// A variable whose value is the JSON value at sp.
fn f_json(key: []const u8, sp: i64) {
    f_key(key);
    const o : u32 = FB_N;
    fb_value(sp);
    f_val_end(o);
}

fn f_text(key: []const u8, s: []const u8) {
    f_key(key);
    const o : u32 = FB_N;
    fb_lit(s);
    f_val_end(o);
}

fn f_locale(key: []const u8, v: f64) {
    f_key(key);
    const o : u32 = FB_N;
    const m : u32 = put_locale(FB[0..], FB_N, v);
    if (m != OVER) { FB_N = m; }
    f_val_end(o);
}

fn f_js(key: []const u8, v: f64) {
    f_key(key);
    const o : u32 = FB_N;
    const m : u32 = put_js(FB[0..], FB_N, v);
    if (m != OVER) { FB_N = m; }
    f_val_end(o);
}

fn f_none(key: []const u8) {
    f_text(key, SAY_NONE);
}

/// fill(template, vars): each {name} that is a key is replaced by its value; the others stay as written.
fn fill_out(o: []u8, n0: u32, t: []const u8) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    while (i < t.len) {
        var closed : usize = 0;
        if (t[i] == 123) {
            var j : usize = i + 1;
            while (j < t.len and is_word_byte(t[j])) { j = j + 1; }
            if (j > i + 1 and j < t.len and t[j] == 125) { closed = j; }
        }
        if (closed > 0) {
            var found : bool = false;
            var q : u32 = 0;
            while (q < F_N) {
                if (!found and (FK_L[q as usize] as usize) == closed - i - 1) {
                    var same : bool = true;
                    var c : usize = 0;
                    while (c < closed - i - 1) {
                        if (FB[(FK_O[q as usize] as usize) + c] != t[i + 1 + c]) { same = false; }
                        c = c + 1;
                    }
                    if (same) {
                        found = true;
                        n = text(o, n, FB[(FV_O[q as usize] as usize)..((FV_O[q as usize] + FV_L[q as usize]) as usize)]);
                    }
                }
                q = q + 1;
            }
            if (!found) {
                var c2 : usize = i;
                while (c2 <= closed) { n = put(o, n, t[c2]); c2 = c2 + 1; }
            }
            i = closed + 1;
        } else {
            n = put_escaped(o, n, t[i]);
            i = i + 1;
        }
    }
    return n;
}

// ------------------------------------------------------------------------------------------------
// the data
// ------------------------------------------------------------------------------------------------

fn fam_code(sp: i64) -> u8 {
    if (jstr_is(sp, "binary")) { return 0; }
    if (jstr_is(sp, "ternary-ref")) { return 1; }
    if (jstr_is(sp, "t27")) { return 2; }
    if (jstr_is(sp, "twin")) { return 3; }
    return 255;
}

fn op_code(sp: i64) -> u8 {
    var k : u32 = 0;
    while ((k as usize) < K_OPS.len) {
        if (jstr_is(sp, K_OPS[k as usize])) { return k as u8; }
        k = k + 1;
    }
    return 255;
}

/// Read data.json once. 0 read, 1 not the shape tool.js reads, 2 over a capacity of this page.
fn load_data() -> u32 {
    const d : []const u8 = dsl();
    const r : i64 = root(d);
    if (r < 0) { return 1; }
    if (kind(d, r) != J_OBJECT) { return 1; }
    J_ROOT = r;
    J_RES = obj_get(d, r, "results");
    J_CAP = obj_get(d, r, "capacity");
    J_SPECS = obj_get(d, r, "specs");
    J_FIND = obj_get(d, r, "findings");
    J_TOOLS = obj_get(d, r, "tools");
    J_TIMING = obj_get(d, r, "timing");
    J_CHECK = obj_get(d, r, "adder_check");
    J_SPEC = obj_get(d, r, "spec");
    J_COMP = obj_get(d, r, "compiler");
    J_CMDS = obj_get(d, r, "commands");
    if (kind(d, J_RES) != J_ARRAY or kind(d, J_CAP) != J_OBJECT or kind(d, J_SPECS) != J_ARRAY or kind(d, J_FIND) != J_ARRAY) { return 1; }
    if (kind(d, J_TOOLS) != J_OBJECT or kind(d, J_TIMING) != J_OBJECT or kind(d, J_CHECK) != J_OBJECT or kind(d, J_SPEC) != J_OBJECT) { return 1; }
    if (kind(d, J_COMP) != J_OBJECT or kind(d, J_CMDS) != J_ARRAY) { return 1; }
    if (obj_get(d, r, "synth") < 0 or obj_get(d, r, "generated_at") < 0) { return 1; }
    if (kind(d, obj_get(d, J_CAP, "nextpnr")) != J_OBJECT or kind(d, obj_get(d, J_CAP, "prjxray")) != J_OBJECT) { return 1; }
    N_RES = arr_len(d, J_RES);
    if (N_RES > W_MAX_RES or arr_len(d, J_FIND) > W_MAX_FIND or arr_len(d, J_SPECS) > W_MAX_SPECS or arr_len(d, J_CMDS) > 2048) { return 2; }
    var i : u32 = 0;
    while (i < N_RES) {
        const e : i64 = arr_at(d, J_RES, i);
        R_EL[i as usize] = e;
        R_FAM[i as usize] = fam_code(obj_get(d, e, "family"));
        R_OP[i as usize] = op_code(obj_get(d, e, "op"));
        const dsp : i64 = obj_get(d, e, "dsp");
        R_DSP[i as usize] = 2;
        if (kind(d, dsp) == J_TRUE) { R_DSP[i as usize] = 1; }
        if (kind(d, dsp) == J_FALSE) { R_DSP[i as usize] = 0; }
        R_OK[i as usize] = 0;
        if (jstr_is(obj_get(d, e, "status"), "ok")) { R_OK[i as usize] = 1; }
        R_BITS[i as usize] = jnum(obj_get(d, e, "info_bits"));
        const tr : i64 = obj_get(d, e, "trits");
        R_HAS_TRITS[i as usize] = 0;
        R_TRITS[i as usize] = 0.0;
        if (!jnullish(tr)) {
            R_HAS_TRITS[i as usize] = 1;
            R_TRITS[i as usize] = jnum(tr);
        }
        R_SEC[i as usize] = jnum(obj_get(d, e, "seconds"));
        const wd : i64 = obj_get(d, e, "width");
        R_HAS_WID[i as usize] = 0;
        R_WID[i as usize] = 0.0;
        if (kind(d, wd) == J_NUMBER) {
            R_HAS_WID[i as usize] = 1;
            R_WID[i as usize] = jnum(wd);
        }
        R_TOP[i as usize] = obj_get(d, e, "top");
        R_SPEC[i as usize] = obj_get(d, e, "spec");
        R_ID[i as usize] = obj_get(d, e, "id");
        const met : i64 = obj_get(d, e, "metrics");
        var k : u32 = 0;
        while (k < 6) {
            var v : i64 = -1;
            if (k == 0) { v = obj_get(d, met, "lut"); }
            if (k == 1) { v = obj_get(d, met, "ff"); }
            if (k == 2) { v = obj_get(d, met, "carry4"); }
            if (k == 3) { v = obj_get(d, met, "dsp"); }
            if (k == 4) { v = obj_get(d, met, "muxf7"); }
            if (k == 5) { v = obj_get(d, met, "muxf8"); }
            R_MHAS[(i * 6 + k) as usize] = 0;
            R_MET[(i * 6 + k) as usize] = 0.0;
            if (kind(d, v) == J_NUMBER) {
                R_MHAS[(i * 6 + k) as usize] = 1;
                R_MET[(i * 6 + k) as usize] = jnum(v);
            }
            if (kind(d, v) == J_NULL) { R_MHAS[(i * 6 + k) as usize] = 2; }
            k = k + 1;
        }
        i = i + 1;
    }
    CAP_V[0] = jnum(obj_get(d, J_CAP, "lut"));
    CAP_V[1] = jnum(obj_get(d, J_CAP, "ff"));
    CAP_V[2] = jnum(obj_get(d, J_CAP, "carry4"));
    CAP_V[3] = jnum(obj_get(d, J_CAP, "dsp"));
    return 0;
}

pub var RELOAD : bool = false;

pub fn w_init(h: []const u8) -> u32 {
    D_STATE = 0;
    READY = false;
    STUCK = false;
    OP = 0;
    if (K_START_OP != 0) { OP = K_START_OP as u32; }
    METRIC = 0;
    DSP = false;
    LOGSCALE = true;
    TABLE = false;
    WROOT = 0.0;
    LAST_RW = 0.0;
    LB_N = 0;
    RQ_N = 0;
    MISSING = false;
    reset_hover();
    return 0;
}

fn reset_hover() {
    HOVER_ON = false;
    HOVER_MARK = -1;
    TIP_SHOWN = false;
    TIP_MARK = -1;
    TIP_STYLE = false;
    TIP_PENDING = false;
    HALO_ON = false;
    HALO_SET = false;
}

/// render(): the page is built afresh, so nothing of the pointer survives it.
fn do_render() {
    reset_hover();
}

pub fn w_theme(s: []const u8) -> u32 {
    var i : usize = 0;
    var c : u32 = 0;
    var l : u32 = 0;
    var k : u32 = 0;
    while (k < 9) { THEME_L[k as usize] = 0; k = k + 1; }
    while (i < s.len and c < 9) {
        if (s[i] == 10) {
            THEME_L[c as usize] = l;
            c = c + 1;
            l = 0;
        } else {
            if (l < 32) { THEME[(c * 32 + l) as usize] = s[i]; l = l + 1; }
        }
        i = i + 1;
    }
    if (c < 9) { THEME_L[c as usize] = l; }
    return 0;
}

pub fn w_data(i: u32, s: []const u8) -> u32 {
    if (i != 0 or D_STATE != 0) { return 0; }
    if (s.len > (W_CAP_DATA as usize)) {
        STUCK = true;
        D_STATE = 1;
        return 0;
    }
    DATA_LEN = copy_to(DATA[0..], s, W_CAP_DATA);
    D_STATE = 1;
    MISSING = false;
    if (load_data() != 0) {
        STUCK = true;
        return 0;
    }
    RELOAD = MISSING;
    READY = true;
    LAST_RW = WROOT;
    do_render();
    return 0;
}

pub fn w_data_failed(i: u32, msg: []const u8) -> u32 {
    if (i != 0 or D_STATE != 0) { return 0; }
    D_STATE = 2;
    ERRMSG_LEN = copy_to(ERRMSG[0..], msg, 512);
    return 0;
}

pub fn w_size(px: f64, root_px: f64, inner_h: f64, embed: u32) -> u32 {
    WROOT = root_px;
    INNER_H = inner_h;
    EMBED = embed != 0;
    if (!READY) { return 0; }
    if (@abs(root_px - LAST_RW) > 8.0) {
        LAST_RW = root_px;
        if (!TABLE) {
            do_render();
            return 1;
        }
    }
    return 0;
}

pub fn w_click(i: u32) -> u32 {
    if (!READY) { return 0; }
    var at : u32 = i;
    const n0 : u32 = SAY_OPS.len as u32;
    if (at < n0) {
        OP = at;
        do_render();
        return 0;
    }
    at = at - n0;
    const n1 : u32 = SAY_METRICS.len as u32;
    if (at < n1) {
        METRIC = at;
        do_render();
        return 0;
    }
    at = at - n1;
    if (at < 2) {
        DSP = at == 0;
        do_render();
        return 0;
    }
    at = at - 2;
    if (at < 2) {
        LOGSCALE = at == 0;
        do_render();
        return 0;
    }
    at = at - 2;
    if (at < 2) {
        TABLE = at == 1;
        do_render();
    }
    return 0;
}

pub fn w_pointer(kind_of: u32, x: f64, y: f64, bw: f64, bh: f64) -> u32 {
    if (!READY or TABLE) { return 0; }
    if (kind_of == 1) {
        TIP_SHOWN = false;
        HALO_ON = false;
        TIP_PENDING = false;
        return 0;
    }
    BOX_W = bw;
    BOX_H = bh;
    const sx : f64 = (x / bw) * CW;
    const sy : f64 = (y / bh) * CHH;
    var best : i32 = -1;
    var bd : f64 = 44.0 * 44.0;
    var m : u32 = 0;
    while (m < MK_N) {
        const dx : f64 = MK_X[m as usize] - sx;
        const dy : f64 = MK_Y[m as usize] - sy;
        const dd : f64 = dx * dx + dy * dy;
        if (dd < bd) {
            bd = dd;
            best = m as i32;
        }
        m = m + 1;
    }
    if (best < 0) {
        TIP_SHOWN = false;
        HALO_ON = false;
        TIP_PENDING = false;
        return 0;
    }
    HOVER_MARK = best;
    HALO_X = MK_X[best as usize];
    HALO_Y = MK_Y[best as usize];
    HALO_SET = true;
    HALO_ON = true;
    TIP_MARK = best;
    TIP_SHOWN = true;
    TIP_PENDING = true;
    return 0;
}

pub fn w_tipsize(tw: f64, th: f64) -> u32 {
    if (!TIP_PENDING or TIP_MARK < 0) { return 0; }
    TIP_PENDING = false;
    const mx : f64 = MK_X[TIP_MARK as usize];
    const my : f64 = MK_Y[TIP_MARK as usize];
    const left : f64 = (mx / CW) * BOX_W;
    const top : f64 = (my / CHH) * BOX_H;
    var pick_left : f64 = left + 12.0;
    if (left + 12.0 > BOX_W / 2.0) { pick_left = left - tw - 12.0; }
    const l : f64 = jsmax(4.0, jsmin(BOX_W - tw - 4.0, pick_left));
    const t : f64 = jsmax(4.0, jsmin(BOX_H - th - 4.0, top - th / 2.0));
    if (l == l and t == t and l != inf() and t != inf() and l != 0.0 - inf() and t != 0.0 - inf()) {
        TIP_LEFT = l;
        TIP_TOP = t;
        TIP_STYLE = true;
    }
    return 1;
}

// ------------------------------------------------------------------------------------------------
// the view
// ------------------------------------------------------------------------------------------------

pub var R_WID : [512]f64 = [0.0; 512];
pub var R_HAS_WID : [512]u8 = [0; 512];
pub var S_N : [4]u32 = [0; 4];
pub var SP : [2048]u32 = [0; 2048];
pub var CW : f64 = 0.0;
pub var CHH : f64 = 0.0;
pub var CPW : f64 = 0.0;
pub var CPH : f64 = 0.0;
pub var C_XLO : f64 = 0.0;
pub var C_XHI : f64 = 0.0;
pub var C_YTOP : f64 = 0.0;

fn col(o: []u8, n0: u32, i: u32) -> u32 {
    return text(o, n0, THEME[((i * 32) as usize)..((i * 32 + THEME_L[i as usize]) as usize)]);
}

fn series_color(s: u32) -> u32 {
    if (s == 0) { return 3; }
    if (s == 1) { return 4; }
    if (s == 2) { return 5; }
    return 7;
}

fn kind_name(s: u32) -> []const u8 {
    if (s == 0) { return "binary"; }
    if (s == 1) { return "ternary-ref"; }
    if (s == 2) { return "t27"; }
    return "twin";
}

fn lower_op(dst: []u8) -> u32 {
    var n : u32 = 0;
    if ((OP as usize) < SAY_OPS.len) {
        const w : []const u8 = SAY_OPS[OP as usize];
        var k : usize = 0;
        while (k < w.len and n < 64) {
            var b : u8 = w[k];
            if (b >= 65 and b <= 90) { b = b + 32; }
            dst[n as usize] = b;
            n = n + 1;
            k = k + 1;
        }
    }
    return n;
}

/// seriesName(kind) into o.
fn series_name(o: []u8, n0: u32, s: u32) -> u32 {
    f_clear();
    var lo : [64]u8 = [0; 64];
    const l : u32 = lower_op(lo[0..]);
    f_text("op", lo[0..(l as usize)]);
    if ((s as usize) >= SAY_SERIES.len) { return n0; }
    return fill_out(o, n0, SAY_SERIES[s as usize]);
}

fn metric_ok(r: u32, k: u32) -> bool {
    return R_MHAS[(r * 6 + k) as usize] == 1;
}

fn metric_v(r: u32, k: u32) -> f64 {
    if (R_MHAS[(r * 6 + k) as usize] == 1) { return R_MET[(r * 6 + k) as usize]; }
    if (R_MHAS[(r * 6 + k) as usize] == 2) { return 0.0; }
    var z : f64 = 0.0;
    return z / z;
}

/// The series of the chosen op, the dsp mode and each family, points sorted by information (stable).
fn collect_series() {
    var s : u32 = 0;
    while (s < 4) {
        S_N[s as usize] = 0;
        var i : u32 = 0;
        while (i < N_RES) {
            if ((R_OP[i as usize] as u32) == OP and R_FAM[i as usize] == (s as u8)) {
                var dsp_ok : bool = R_DSP[i as usize] == 0;
                if (DSP) { dsp_ok = R_DSP[i as usize] == 1; }
                if (dsp_ok) {
                    // insertion, after every point with information not above this one's
                    var at : u32 = S_N[s as usize];
                    while (at > 0 and R_BITS[SP[(s * 512 + at - 1) as usize] as usize] > R_BITS[i as usize]) {
                        SP[(s * 512 + at) as usize] = SP[(s * 512 + at - 1) as usize];
                        at = at - 1;
                    }
                    SP[(s * 512 + at) as usize] = i;
                    S_N[s as usize] = S_N[s as usize] + 1;
                }
            }
            i = i + 1;
        }
        s = s + 1;
    }
}

fn nice_max(v: f64) -> f64 {
    if (v <= 1.0) { return 1.0; }
    const p : f64 = powf(10.0, @floor(log10f(v)));
    var q : u32 = 0;
    while (q < 5) {
        var m : f64 = 1.0;
        if (q == 1) { m = 2.0; }
        if (q == 2) { m = 2.5; }
        if (q == 3) { m = 5.0; }
        if (q == 4) { m = 10.0; }
        if (m * p >= v) { return m * p; }
        q = q + 1;
    }
    return 10.0 * p;
}

fn cx_of(bits: f64) -> f64 {
    return 50.0 + (((log2f(bits) - C_XLO) / (C_XHI - C_XLO)) * CPW);
}

fn fy(v: f64, logs: bool) -> f64 {
    if (logs) { return log10f(1.0 + v); }
    return v;
}

fn cy_of(v: f64) -> f64 {
    return 16.0 + CPH - ((fy(v, LOGSCALE) / C_YTOP) * CPH);
}

fn a_js(o: []u8, n0: u32, name: []const u8, v: f64) -> u32 {
    var n : u32 = raw(o, n0, " ");
    n = raw(o, n, name);
    n = raw(o, n, "=\"");
    n = put_js(o, n, v);
    return raw(o, n, "\"");
}

fn a_col(o: []u8, n0: u32, name: []const u8, c: u32) -> u32 {
    var n : u32 = raw(o, n0, " ");
    n = raw(o, n, name);
    n = raw(o, n, "=\"");
    n = col(o, n, c);
    return raw(o, n, "\"");
}

fn tick_text(o: []u8, n0: u32, x: f64, y: f64, anchor: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<text");
    n = a_js(o, n, "x", x);
    n = a_js(o, n, "y", y);
    n = raw(o, n, " text-anchor=\"");
    n = raw(o, n, anchor);
    return raw(o, n, "\" class=\"cc-tick\">");
}

fn cap_name(o: []u8, n0: u32, tmpl: []const u8) -> u32 {
    f_clear();
    f_locale("n", CAP_V[METRIC as usize]);
    if ((METRIC as usize) < SAY_CAP_UNITS.len) { f_text("unit", SAY_CAP_UNITS[METRIC as usize]); } else { f_text("unit", "undefined"); }
    return fill_out(o, n0, tmpl);
}

fn chart(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    const key : u32 = METRIC;
    collect_series();
    // dataMax over the ok points
    var data_max : f64 = 1.0;
    var s : u32 = 0;
    while (s < 4) {
        var q : u32 = 0;
        while (q < S_N[s as usize]) {
            const r : u32 = SP[(s * 512 + q) as usize];
            if (R_OK[r as usize] == 1) { data_max = jsmax(data_max, metric_v(r, key)); }
            q = q + 1;
        }
        s = s + 1;
    }
    const cap : f64 = CAP_V[key];
    const cap_shown : bool = LOGSCALE or cap <= data_max * 1.5;
    var rw : f64 = WROOT;
    if (!(rw != 0.0 and rw == rw)) { rw = 640.0; }
    const width : f64 = jsmax(300.0, jsmin(1120.0, rw));
    var ch : f64 = 340.0;
    if (K_CHART_H_PX != 0) { ch = K_CHART_H_PX as f64; }
    var lim3 : f64 = 1000000000.0;
    if (EMBED) { lim3 = INNER_H - 190.0; }
    const height : f64 = jsround(jsmax(210.0, jsmin(jsmin(ch, width * 0.58), lim3)));
    CW = width;
    CHH = height;
    CPW = width - 50.0 - 12.0;
    CPH = height - 16.0 - 40.0;
    C_XLO = log2f(0.8);
    C_XHI = log2f(76.0);
    var top_in : f64 = data_max;
    if (cap_shown) { top_in = jsmax(data_max, cap); } else { top_in = jsmax(data_max, 0.0); }
    if (LOGSCALE) { C_YTOP = fy(top_in * 1.6, true); } else { C_YTOP = nice_max(top_in * 1.05); }
    n = raw(o, n, "<div><div class=\"cc-chart\"><svg");
    n = raw(o, n, " viewBox=\"0 0 ");
    n = put_js(o, n, width);
    n = raw(o, n, " ");
    n = put_js(o, n, height);
    n = raw(o, n, "\"");
    n = a_js(o, n, "width", width);
    n = a_js(o, n, "height", height);
    n = raw(o, n, " role=\"img\"");
    n = attr(o, n, "aria-label", SAY_CHART_LABEL);
    n = raw(o, n, " class=\"cc-svg\">");
    // grid and axes: y ticks
    var t : u32 = 0;
    var ny : u32 = 6;
    if (LOGSCALE) { ny = 8; }
    while (t < ny) {
        var tv : f64 = 0.0;
        if (LOGSCALE) {
            if (t == 1) { tv = 1.0; }
            if (t == 2) { tv = 10.0; }
            if (t == 3) { tv = 100.0; }
            if (t == 4) { tv = 1000.0; }
            if (t == 5) { tv = 10000.0; }
            if (t == 6) { tv = 100000.0; }
            if (t == 7) { tv = 1000000.0; }
        } else {
            tv = (C_YTOP * (t as f64)) / 5.0;
        }
        var draw : bool = true;
        if (LOGSCALE) { draw = fy(tv, true) <= C_YTOP; }
        if (draw) {
            const yy : f64 = cy_of(tv);
            n = raw(o, n, "<line");
            n = a_js(o, n, "x1", 50.0);
            n = a_js(o, n, "x2", width - 12.0);
            n = a_js(o, n, "y1", yy);
            n = a_js(o, n, "y2", yy);
            n = a_col(o, n, "stroke", 2);
            n = raw(o, n, " stroke-width=\"1\"></line>");
            n = tick_text(o, n, 50.0 - 6.0, yy + 4.0, "end");
            if (tv >= 1000.0) {
                n = put_js(o, n, tv / 1000.0);
                n = raw(o, n, "k");
            } else {
                n = put_r(o, n, tv, 1);
            }
            n = raw(o, n, "</text>");
        }
        t = t + 1;
    }
    var xt : u32 = 0;
    while (xt < 7) {
        const tx : f64 = pow2(xt);
        const xx : f64 = cx_of(tx);
        n = raw(o, n, "<line");
        n = a_js(o, n, "x1", xx);
        n = a_js(o, n, "x2", xx);
        n = a_js(o, n, "y1", 16.0);
        n = a_js(o, n, "y2", 16.0 + CPH);
        n = a_col(o, n, "stroke", 2);
        n = raw(o, n, " stroke-width=\"1\" stroke-dasharray=\"2 4\"></line>");
        n = tick_text(o, n, xx, 16.0 + CPH + 16.0, "middle");
        n = put_js(o, n, tx);
        n = raw(o, n, "</text>");
        xt = xt + 1;
    }
    // the x label
    const xwords : []const u8 = SAY_X_AXIS;
    const x_fits : bool = (xwords.len as f64) * 6.4 <= CPW;
    n = raw(o, n, "<text");
    if (x_fits) {
        n = a_js(o, n, "x", 50.0 + CPW / 2.0);
    } else {
        n = a_js(o, n, "x", width / 2.0);
        n = a_js(o, n, "textLength", width - 12.0);
        n = raw(o, n, " lengthAdjust=\"spacingAndGlyphs\"");
    }
    n = a_js(o, n, "y", height - 6.0);
    n = raw(o, n, " text-anchor=\"middle\" class=\"cc-axis\">");
    n = text(o, n, xwords);
    n = raw(o, n, "</text>");
    // the y label
    n = raw(o, n, "<text x=\"12\"");
    n = a_js(o, n, "y", 16.0 + CPH / 2.0);
    n = raw(o, n, " transform=\"rotate(-90 12 ");
    n = put_js(o, n, 16.0 + CPH / 2.0);
    n = raw(o, n, ")\" text-anchor=\"middle\" class=\"cc-axis\">");
    f_clear();
    if ((METRIC as usize) < SAY_METRIC_LONG.len) { f_text("metric", SAY_METRIC_LONG[METRIC as usize]); } else { f_text("metric", "undefined"); }
    if (LOGSCALE) { f_text("scale", SAY_SCALE_LOG); } else { f_text("scale", SAY_SCALE_LIN); }
    n = fill_out(o, n, SAY_Y_AXIS);
    n = raw(o, n, "</text>");
    // capacity
    if (cap_shown) {
        const cyc : f64 = cy_of(cap);
        n = raw(o, n, "<line");
        n = a_js(o, n, "x1", 50.0);
        n = a_js(o, n, "x2", width - 12.0);
        n = a_js(o, n, "y1", cyc);
        n = a_js(o, n, "y2", cyc);
        n = a_col(o, n, "stroke", 6);
        n = raw(o, n, " stroke-width=\"1.2\" stroke-dasharray=\"6 5\" opacity=\"0.75\"></line>");
        n = raw(o, n, "<text");
        n = a_js(o, n, "x", width - 12.0 - 4.0);
        n = a_js(o, n, "y", cyc - 6.0);
        n = raw(o, n, " text-anchor=\"end\" class=\"cc-cap\">");
        n = cap_name(o, n, SAY_CAP);
        n = raw(o, n, "</text>");
    }
    // series
    MK_N = 0;
    s = 0;
    while (s < 4) {
        if (S_N[s as usize] > 0) {
            var okn : u32 = 0;
            var q : u32 = 0;
            while (q < S_N[s as usize]) {
                if (R_OK[SP[(s * 512 + q) as usize] as usize] == 1) { okn = okn + 1; }
                q = q + 1;
            }
            if ((s == 0 or s == 1) and okn > 1) {
                n = raw(o, n, "<polyline points=\"");
                var first : bool = true;
                q = 0;
                while (q < S_N[s as usize]) {
                    const r : u32 = SP[(s * 512 + q) as usize];
                    if (R_OK[r as usize] == 1) {
                        if (!first) { n = raw(o, n, " "); }
                        first = false;
                        n = put_js(o, n, cx_of(R_BITS[r as usize]));
                        n = raw(o, n, ",");
                        n = put_js(o, n, cy_of(metric_v(r, key)));
                    }
                    q = q + 1;
                }
                n = raw(o, n, "\" fill=\"none\"");
                n = a_col(o, n, "stroke", series_color(s));
                n = raw(o, n, " stroke-width=\"2\" stroke-linejoin=\"round\"></polyline>");
            }
            q = 0;
            while (q < S_N[s as usize]) {
                const r : u32 = SP[(s * 512 + q) as usize];
                if (R_OK[r as usize] == 1) {
                    const cx : f64 = cx_of(R_BITS[r as usize]);
                    const cy : f64 = cy_of(metric_v(r, key));
                    if (s == 2) {
                        n = raw(o, n, "<rect");
                        n = a_js(o, n, "x", cx - 5.0);
                        n = a_js(o, n, "y", cy - 5.0);
                        n = raw(o, n, " width=\"10\" height=\"10\" transform=\"rotate(45 ");
                        n = put_js(o, n, cx);
                        n = raw(o, n, " ");
                        n = put_js(o, n, cy);
                        n = raw(o, n, ")\"");
                        n = a_col(o, n, "fill", series_color(s));
                        n = raw(o, n, "></rect>");
                    } else {
                        n = raw(o, n, "<circle");
                        n = a_js(o, n, "cx", cx);
                        n = a_js(o, n, "cy", cy);
                        if (s == 3) { n = raw(o, n, " r=\"4.5\""); } else { n = raw(o, n, " r=\"3.5\""); }
                        if (s == 3) { n = a_col(o, n, "fill", 0); } else { n = a_col(o, n, "fill", series_color(s)); }
                        n = a_col(o, n, "stroke", series_color(s));
                        n = raw(o, n, " stroke-width=\"2\"></circle>");
                    }
                    if (MK_N < 512) {
                        MK_R[MK_N as usize] = r;
                        MK_S[MK_N as usize] = s as u8;
                        MK_X[MK_N as usize] = cx;
                        MK_Y[MK_N as usize] = cy;
                        MK_N = MK_N + 1;
                    }
                }
                q = q + 1;
            }
        }
        s = s + 1;
    }
    // the halo
    n = raw(o, n, "<circle r=\"9\" fill=\"none\"");
    n = a_col(o, n, "stroke", 6);
    n = raw(o, n, " stroke-width=\"1.5\"");
    if (HALO_SET) {
        n = a_js(o, n, "cx", HALO_X);
        n = a_js(o, n, "cy", HALO_Y);
    }
    if (HALO_ON) { n = raw(o, n, " visibility=\"visible\"></circle>"); } else { n = raw(o, n, " visibility=\"hidden\"></circle>"); }
    n = raw(o, n, "</svg>");
    // the tooltip
    n = raw(o, n, "<div class=\"cc-tip\" role=\"status\" aria-live=\"polite\"");
    if (!TIP_SHOWN) { n = raw(o, n, " hidden=\"\""); }
    if (TIP_STYLE) {
        n = raw(o, n, " style=\"left: ");
        n = put_css6(o, n, TIP_LEFT);
        n = raw(o, n, "px; top: ");
        n = put_css6(o, n, TIP_TOP);
        n = raw(o, n, "px;\"");
    }
    n = raw(o, n, ">");
    if (TIP_MARK >= 0) { n = tip_body(o, n, TIP_MARK as u32); }
    n = raw(o, n, "</div></div><ul class=\"cc-legend\">");
    s = 0;
    while (s < 4) {
        if (S_N[s as usize] > 0) {
            n = raw(o, n, "<li><span class=\"cc-swatch cc-");
            n = raw(o, n, kind_name(s));
            n = raw(o, n, "\" style=\"--c:");
            n = col(o, n, series_color(s));
            n = raw(o, n, "\"></span>");
            n = series_name(o, n, s);
            n = raw(o, n, "</li>");
        }
        s = s + 1;
    }
    if (!cap_shown) {
        n = raw(o, n, "<li class=\"cc-cap-off\">");
        n = cap_name(o, n, SAY_CAP_ABOVE);
        n = raw(o, n, "</li>");
    }
    n = raw(o, n, "</ul><p class=\"cc-hint\">");
    n = text(o, n, SAY_HINT);
    n = raw(o, n, "</p></div>");
    return n;
}

fn pow2(k: u32) -> f64 {
    var p : f64 = 1.0;
    var i : u32 = 0;
    while (i < k) { p = p * 2.0; i = i + 1; }
    return p;
}

/// The last path segment of the JSON string at sp, appended to FB; its length.
fn fb_basename(sp: i64) -> u32 {
    const d : []const u8 = dsl();
    const len : u32 = str_len(d, sp);
    var start : u32 = 0;
    var k : u32 = 0;
    while (k < len) {
        if (str_byte(d, sp, k) == 47) { start = k + 1; }
        k = k + 1;
    }
    k = start;
    while (k < len and (FB_N as usize) < FB.len) {
        FB[FB_N as usize] = str_byte(d, sp, k);
        FB_N = FB_N + 1;
        k = k + 1;
    }
    return len - start;
}

fn tip_body(o: []u8, n0: u32, mk: u32) -> u32 {
    var n : u32 = n0;
    const r : u32 = MK_R[mk as usize];
    const s : u32 = MK_S[mk as usize] as u32;
    const key : u32 = METRIC;
    n = raw(o, n, "<strong style=\"color:");
    n = col(o, n, series_color(s));
    n = raw(o, n, "\">");
    if (s == 2) {
        f_clear();
        f_key("spec");
        const o1 : u32 = FB_N;
        fb_basename(R_SPEC[r as usize]);
        f_val_end(o1);
        f_json("top", R_TOP[r as usize]);
        n = fill_out(o, n, SAY_TIP_SPEC);
    } else {
        n = series_name(o, n, s);
        n = raw(o, n, ": ");
        n = put_tip_top(o, n, r);
    }
    n = raw(o, n, "</strong><div>");
    f_clear();
    f_js("bits", jsround(R_BITS[r as usize] * 10.0) / 10.0);
    if (R_HAS_TRITS[r as usize] == 1 and R_TRITS[r as usize] != 0.0 and R_TRITS[r as usize] == R_TRITS[r as usize]) {
        f_js("trits", R_TRITS[r as usize]);
        n = fill_out(o, n, SAY_TIP_TRITS);
    } else {
        n = fill_out(o, n, SAY_TIP_BITS);
    }
    n = raw(o, n, "</div><dl>");
    var i : u32 = 0;
    while (i < 6) {
        n = raw(o, n, "<dt>");
        if (((3 + i) as usize) < SAY_COLS.len) { n = text(o, n, SAY_COLS[(3 + i) as usize]); }
        n = raw(o, n, "</dt><dd");
        if (i == key) { n = raw(o, n, " class=\"cc-on\""); }
        n = raw(o, n, ">");
        if (metric_ok(r, i)) { n = put_locale(o, n, metric_v(r, i)); } else { n = text(o, n, SAY_NONE); }
        n = raw(o, n, "</dd>");
        i = i + 1;
    }
    n = raw(o, n, "</dl><div>");
    f_clear();
    f_key("pct");
    const o2 : u32 = FB_N;
    if (metric_ok(r, key)) {
        const m : u32 = put_r(FB[0..], FB_N, (100.0 * metric_v(r, key)) / CAP_V[key], 3);
        if (m != OVER) { FB_N = m; }
    } else {
        fb_lit("null");
    }
    f_val_end(o2);
    if ((METRIC as usize) < SAY_CAP_UNITS.len) { f_text("unit", SAY_CAP_UNITS[METRIC as usize]); } else { f_text("unit", "undefined"); }
    n = fill_out(o, n, SAY_TIP_SHARE);
    n = raw(o, n, "</div><div class=\"cc-dim\">");
    f_clear();
    f_js("s", R_SEC[r as usize]);
    n = fill_out(o, n, SAY_TIP_SECONDS);
    n = raw(o, n, "</div>");
    return n;
}

fn put_tip_top(o: []u8, n0: u32, r: u32) -> u32 {
    if (R_TOP[r as usize] < 0) { return raw(o, n0, "undefined"); }
    return put_jtext(o, n0, R_TOP[r as usize]);
}

fn btn(o: []u8, n0: u32, pressed: bool, title: []const u8, has_title: bool, label: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<button type=\"button\" class=\"t27-btn\"");
    if (pressed) { n = raw(o, n, " aria-pressed=\"true\""); } else { n = raw(o, n, " aria-pressed=\"false\""); }
    if (has_title) { n = attr(o, n, "title", title); }
    n = raw(o, n, ">");
    n = text(o, n, label);
    return raw(o, n, "</button>");
}

fn group_open(o: []u8, n0: u32, label: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<div class=\"cc-group\" role=\"group\"");
    n = attr(o, n, "aria-label", label);
    n = raw(o, n, "><span class=\"cc-label\">");
    n = text(o, n, label);
    return raw(o, n, "</span>");
}

fn controls(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<div class=\"cc-controls\">");
    n = group_open(o, n, SAY_OP_LABEL);
    var i : u32 = 0;
    while ((i as usize) < SAY_OPS.len) {
        n = btn(o, n, i == OP, SAY_OP_TITLES[i as usize], (i as usize) < SAY_OP_TITLES.len, SAY_OPS[i as usize]);
        i = i + 1;
    }
    n = raw(o, n, "</div>");
    n = group_open(o, n, SAY_METRIC_LABEL);
    i = 0;
    while ((i as usize) < SAY_METRICS.len) {
        n = btn(o, n, i == METRIC, SAY_METRIC_LONG[i as usize], (i as usize) < SAY_METRIC_LONG.len, SAY_METRICS[i as usize]);
        i = i + 1;
    }
    n = raw(o, n, "</div>");
    n = group_open(o, n, SAY_DSP_LABEL);
    n = btn(o, n, DSP, SAY_DSP_ON_TITLE, true, SAY_DSP_ON);
    n = btn(o, n, !DSP, SAY_DSP_OFF_TITLE, true, SAY_DSP_OFF);
    n = raw(o, n, "</div>");
    n = group_open(o, n, SAY_SCALE_LABEL);
    n = btn(o, n, LOGSCALE, "", false, SAY_SCALE_LOG);
    n = btn(o, n, !LOGSCALE, "", false, SAY_SCALE_LIN);
    n = raw(o, n, "</div>");
    n = group_open(o, n, SAY_VIEW_LABEL);
    n = btn(o, n, !TABLE, "", false, SAY_VIEW_CHART);
    n = btn(o, n, TABLE, "", false, SAY_VIEW_TABLE);
    n = raw(o, n, "</div></div>");
    return n;
}

fn table(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<div class=\"cc-table-wrap\"><table class=\"cc-table\"><thead><tr>");
    var c : u32 = 0;
    while ((c as usize) < SAY_COLS.len) {
        n = raw(o, n, "<th scope=\"col\"");
        if (c == 9) { n = attr(o, n, "title", SAY_SHARE_TITLE); }
        n = raw(o, n, ">");
        n = text(o, n, SAY_COLS[c as usize]);
        n = raw(o, n, "</th>");
        c = c + 1;
    }
    n = raw(o, n, "</tr></thead><tbody>");
    collect_series();
    const key : u32 = METRIC;
    var s : u32 = 0;
    while (s < 4) {
        var q : u32 = 0;
        while (q < S_N[s as usize]) {
            const r : u32 = SP[(s * 512 + q) as usize];
            n = raw(o, n, "<tr><th scope=\"row\"><span class=\"cc-swatch cc-");
            n = raw(o, n, kind_name(s));
            n = raw(o, n, "\" style=\"--c:");
            n = col(o, n, series_color(s));
            n = raw(o, n, "\"></span>");
            if (s == 2) {
                f_clear();
                f_key("x");
                const o1 : u32 = FB_N;
                fb_basename(R_SPEC[r as usize]);
                f_val_end(o1);
                n = text(o, n, FB[(FV_O[0] as usize)..((FV_O[0] + FV_L[0]) as usize)]);
            } else {
                if (R_TOP[r as usize] >= 0) { n = put_jtext(o, n, R_TOP[r as usize]); }
            }
            n = raw(o, n, "</th><td>");
            n = put_r(o, n, R_BITS[r as usize], 1);
            n = raw(o, n, "</td><td>");
            if (R_HAS_TRITS[r as usize] == 1) { n = put_js(o, n, R_TRITS[r as usize]); } else { n = text(o, n, SAY_NONE); }
            n = raw(o, n, "</td>");
            if (R_OK[r as usize] == 1) {
                var k : u32 = 0;
                while (k < 6) {
                    n = raw(o, n, "<td");
                    if (k == key) { n = raw(o, n, " class=\"cc-on\""); }
                    n = raw(o, n, ">");
                    if (metric_ok(r, k)) { n = put_locale(o, n, metric_v(r, k)); } else { n = text(o, n, SAY_NONE); }
                    n = raw(o, n, "</td>");
                    k = k + 1;
                }
                n = raw(o, n, "<td>");
                if (metric_ok(r, key)) { n = put_r(o, n, (100.0 * metric_v(r, key)) / CAP_V[key], 3); } else { n = raw(o, n, "null"); }
                n = raw(o, n, "%</td>");
            } else {
                n = raw(o, n, "<td colspan=\"7\" class=\"cc-bad\">");
                n = text(o, n, SAY_REFUSED);
                n = raw(o, n, "</td>");
            }
            n = raw(o, n, "<td>");
            n = put_js(o, n, R_SEC[r as usize]);
            n = raw(o, n, "</td></tr>");
            q = q + 1;
        }
        s = s + 1;
    }
    return raw(o, n, "</tbody></table></div>");
}

/// results.find(r => r.dsp === false && ...)?.metrics?.lut, as the number or SAY_NONE.
fn put_nodsp(o: []u8, n0: u32, fam: u8, want_trits: bool, trits: f64, want_op: bool, op_i: u8, want_wid: bool, wid: f64, spec: i64, twin_lit: []const u8, want_twin: bool) -> u32 {
    var i : u32 = 0;
    while (i < N_RES) {
        var hit : bool = R_DSP[i as usize] == 0 and R_FAM[i as usize] == fam;
        if (hit and want_trits) { hit = R_HAS_TRITS[i as usize] == 1 and R_TRITS[i as usize] == trits; }
        if (hit and want_op) { hit = R_OP[i as usize] == op_i; }
        if (hit and want_wid) { hit = R_HAS_WID[i as usize] == 1 and R_WID[i as usize] == wid; }
        if (hit and spec == -2) { hit = R_SPEC[i as usize] < 0; }
        if (hit and spec >= 0) { hit = same_json_str(R_SPEC[i as usize], spec); }
        if (hit and want_twin) { hit = jstr_is(obj_get(dsl(), R_EL[i as usize], "twin"), twin_lit); }
        if (hit) {
            if (metric_ok(i, 0)) { return put_locale(o, n0, metric_v(i, 0)); }
            return text(o, n0, SAY_NONE);
        }
        i = i + 1;
    }
    return text(o, n0, SAY_NONE);
}

fn same_json_str(a: i64, b: i64) -> bool {
    const d : []const u8 = dsl();
    if (a < 0 or b < 0) { return false; }
    if (kind(d, a) != J_STRING or kind(d, b) != J_STRING) { return false; }
    const l : u32 = str_len(d, a);
    if (l != str_len(d, b)) { return false; }
    var k : u32 = 0;
    while (k < l) {
        if (str_byte(d, a, k) != str_byte(d, b, k)) { return false; }
        k = k + 1;
    }
    return true;
}

/// data.specs.find(s => s.spec.endsWith(stem))?.spec
fn spec_ending(stem: []const u8) -> i64 {
    const d : []const u8 = dsl();
    const n : u32 = arr_len(d, J_SPECS);
    var i : u32 = 0;
    while (i < n) {
        const sp : i64 = obj_get(d, arr_at(d, J_SPECS, i), "spec");
        if (kind(d, sp) == J_STRING) {
            const l : u32 = str_len(d, sp);
            if (l >= (stem.len as u32)) {
                var ok_e : bool = true;
                var k : u32 = 0;
                while (k < (stem.len as u32)) {
                    if (str_byte(d, sp, l - (stem.len as u32) + k) != stem[k as usize]) { ok_e = false; }
                    k = k + 1;
                }
                if (ok_e) { return sp; }
            }
        }
        i = i + 1;
    }
    return -2;
}

fn note(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<section class=\"cc-note\"><h3>");
    n = text(o, n, SAY_NOTE_TITLE);
    n = raw(o, n, "</h3><p>");
    // the words: tadd add fa fa_twin dot, each rendered to FB
    f_clear();
    f_key("tadd");
    var o1 : u32 = FB_N;
    var m : u32 = put_nodsp(FB[0..], FB_N, 1, true, 15.0, false, 0, false, 0.0, -1, "", false);
    FB_N = m;
    f_val_end(o1);
    f_key("add");
    o1 = FB_N;
    m = put_nodsp(FB[0..], FB_N, 0, false, 0.0, true, 0, true, 24.0, -1, "", false);
    FB_N = m;
    f_val_end(o1);
    f_key("fa");
    o1 = FB_N;
    var sp : i64 = spec_ending("ternary_full_adder.t27");
    m = put_nodsp(FB[0..], FB_N, 2, false, 0.0, false, 0, false, 0.0, sp, "", false);
    FB_N = m;
    f_val_end(o1);
    f_key("fa_twin");
    o1 = FB_N;
    m = put_nodsp(FB[0..], FB_N, 3, false, 0.0, false, 0, false, 0.0, -1, "fa1", true);
    FB_N = m;
    f_val_end(o1);
    f_key("dot");
    o1 = FB_N;
    sp = spec_ending("comb_ternary_dot.t27");
    m = put_nodsp(FB[0..], FB_N, 2, false, 0.0, false, 0, false, 0.0, sp, "", false);
    FB_N = m;
    f_val_end(o1);
    if ((OP as usize) < SAY_NOTES.len) { n = fill_out(o, n, SAY_NOTES[OP as usize]); }
    n = raw(o, n, "</p><p class=\"cc-honest\">");
    n = text(o, n, SAY_HONEST);
    n = raw(o, n, "</p><p class=\"cc-dim\">");
    n = text(o, n, SAY_PACK_NOTE);
    return raw(o, n, "</p></section>");
}

fn findings(o: []u8, n0: u32) -> u32 {
    const d : []const u8 = dsl();
    const cnt : u32 = arr_len(d, J_FIND);
    if (cnt == 0) { return n0; }
    var n : u32 = raw(o, n0, "<section class=\"cc-findings\"><h3>");
    n = text(o, n, SAY_FINDINGS_TITLE);
    n = raw(o, n, "</h3><ul>");
    var i : u32 = 0;
    while (i < cnt) {
        const f : i64 = arr_at(d, J_FIND, i);
        n = raw(o, n, "<li>");
        f_clear();
        if (jstr_is(obj_get(d, f, "kind"), "rejected")) {
            var r : i64 = -1;
            var q : u32 = 0;
            while (q < N_RES and r < 0) {
                if (same_json_str(R_ID[q as usize], obj_get(d, f, "id"))) { r = q as i64; }
                q = q + 1;
            }
            const sp : i64 = obj_get(d, f, "spec");
            if (jnullish(sp)) { f_json("spec", obj_get(d, f, "id")); } else { f_json("spec", sp); }
            if (r >= 0 and R_DSP[r as usize] == 1) { f_text("mode", SAY_DSP_ON); } else { f_text("mode", SAY_DSP_OFF); }
            f_json("detail", obj_get(d, f, "detail"));
            const ln : i64 = obj_get(d, f, "line");
            if (jnullish(ln)) { f_none("line"); } else { f_json("line", ln); }
            n = fill_out(o, n, SAY_FINDING_REJECTED);
        } else {
            if (jstr_is(obj_get(d, f, "kind"), "no-data-ports")) {
                const sp : i64 = obj_get(d, f, "spec");
                f_json("spec", sp);
                var topv : i64 = -1;
                var j : u32 = 0;
                const ns : u32 = arr_len(d, J_SPECS);
                while (j < ns and topv < 0) {
                    const se : i64 = arr_at(d, J_SPECS, j);
                    if (same_json_str(obj_get(d, se, "spec"), sp)) {
                        topv = obj_get(d, se, "top");
                        if (topv < 0) { topv = -2; }
                    }
                    j = j + 1;
                }
                if (topv >= 0) { f_json("top", topv); } else { f_json("top", -1); }
                n = fill_out(o, n, SAY_FINDING_NO_PORTS);
            } else {
                if (jstr_is(obj_get(d, f, "kind"), "empty")) {
                    // fill(template, f): every key of f is a variable
                    n = fill_with_object(o, n, SAY_FINDING_EMPTY, f);
                } else {
                    const sp : i64 = obj_get(d, f, "spec");
                    if (jnullish(sp)) { f_json("spec", obj_get(d, f, "id")); } else { f_json("spec", sp); }
                    f_json("detail", obj_get(d, f, "detail"));
                    n = fill_out(o, n, SAY_FINDING_OTHER);
                }
            }
        }
        n = raw(o, n, "</li>");
        i = i + 1;
    }
    return raw(o, n, "</ul></section>");
}

/// fill(t, obj): a {name} is replaced when obj has that key (its String() value); else it stays.
fn fill_with_object(o: []u8, n0: u32, t: []const u8, obj: i64) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    while (i < t.len) {
        var closed : usize = 0;
        if (t[i] == 123) {
            var j : usize = i + 1;
            while (j < t.len and is_word_byte(t[j])) { j = j + 1; }
            if (j > i + 1 and j < t.len and t[j] == 125) { closed = j; }
        }
        if (closed > 0) {
            const v : i64 = obj_get(dsl(), obj, t[(i + 1)..closed]);
            if (v >= 0) {
                f_clear();
                fb_value(v);
                n = text(o, n, FB[0..(FB_N as usize)]);
            } else {
                var c2 : usize = i;
                while (c2 <= closed) { n = put(o, n, t[c2]); c2 = c2 + 1; }
            }
            i = closed + 1;
        } else {
            n = put_escaped(o, n, t[i]);
            i = i + 1;
        }
    }
    return n;
}

fn slice_text(o: []u8, n0: u32, sp: i64, count: u32) -> u32 {
    const d : []const u8 = dsl();
    var n : u32 = n0;
    const len : u32 = str_len(d, sp);
    var k : u32 = 0;
    while (k < len and k < count) {
        n = put_escaped(o, n, str_byte(d, sp, k));
        k = k + 1;
    }
    return n;
}

fn provenance(o: []u8, n0: u32) -> u32 {
    const d : []const u8 = dsl();
    const c : i64 = J_CAP;
    const np : i64 = obj_get(d, c, "nextpnr");
    const px : i64 = obj_get(d, c, "prjxray");
    var n : u32 = raw(o, n0, "<section class=\"cc-prov\"><h3>");
    n = text(o, n, SAY_PROV_TITLE);
    n = raw(o, n, "</h3><p>");
    f_clear();
    f_json("yosys", obj_get(d, J_TOOLS, "yosys"));
    f_json("iverilog", obj_get(d, J_TOOLS, "iverilog"));
    f_json("nextpnr", obj_get(d, np, "version"));
    n = fill_out(o, n, SAY_PROV_TOOLS);
    n = raw(o, n, "</p><p>");
    f_clear();
    f_json("synth", obj_get(d, J_ROOT, "synth"));
    f_json("runs", obj_get(d, J_TIMING, "runs"));
    f_json("sum", obj_get(d, J_TIMING, "sum_seconds"));
    f_json("wall", obj_get(d, J_TIMING, "wall_seconds"));
    f_json("jobs", obj_get(d, J_TIMING, "jobs"));
    n = fill_out(o, n, SAY_PROV_SYNTH);
    n = raw(o, n, "</p><p>");
    f_clear();
    f_json("file", obj_get(d, px, "file"));
    f_locale_json("slicel", obj_get(d, px, "SLICEL"));
    f_locale_json("slicem", obj_get(d, px, "SLICEM"));
    f_locale_json("slices", obj_get(d, c, "slices"));
    f_locale_json("dsp", obj_get(d, c, "dsp"));
    f_json("chipdb", obj_get(d, np, "chipdb"));
    f_locale_json("lutx", obj_get(d, np, "SLICE_LUTX"));
    f_locale_json("ffx", obj_get(d, np, "SLICE_FFX"));
    f_locale_json("carry", obj_get(d, np, "CARRY4"));
    f_locale_json("dspn", obj_get(d, np, "DSP48E1"));
    n = fill_out(o, n, SAY_PROV_CAP);
    n = raw(o, n, "</p><p>");
    f_clear();
    f_json("cases", obj_get(d, J_CHECK, "cases"));
    f_json("trits", obj_get(d, J_CHECK, "trits"));
    if (jtruthy(obj_get(d, J_CHECK, "all_pass"))) { f_text("verdict", SAY_PASS); } else { f_text("verdict", SAY_REFUSED); }
    n = fill_out(o, n, SAY_PROV_CHECK);
    n = raw(o, n, "</p><p class=\"cc-dim\">");
    f_clear();
    f_json("spec", obj_get(d, J_SPEC, "path"));
    f_key("sha");
    var o1 : u32 = FB_N;
    var shs : i64 = obj_get(d, J_SPEC, "sha256");
    var k : u32 = 0;
    while (k < 16 and k < str_len(d, shs)) { FB[FB_N as usize] = str_byte(d, shs, k); FB_N = FB_N + 1; k = k + 1; }
    f_val_end(o1);
    f_json("compiler", obj_get(d, J_COMP, "path"));
    f_key("csha");
    o1 = FB_N;
    shs = obj_get(d, J_COMP, "sha256");
    k = 0;
    while (k < 16 and k < str_len(d, shs)) { FB[FB_N as usize] = str_byte(d, shs, k); FB_N = FB_N + 1; k = k + 1; }
    f_val_end(o1);
    f_json("at", obj_get(d, J_ROOT, "generated_at"));
    n = fill_out(o, n, SAY_PROV_SPEC);
    n = raw(o, n, "</p><details><summary>");
    f_clear();
    f_js("n", arr_len(d, J_CMDS) as f64);
    n = fill_out(o, n, SAY_COMMANDS);
    n = raw(o, n, "</summary><pre>");
    const cn : u32 = arr_len(d, J_CMDS);
    var i : u32 = 0;
    while (i < cn) {
        if (i > 0) { n = put(o, n, 10); }
        n = put_jtext(o, n, arr_at(d, J_CMDS, i));
        i = i + 1;
    }
    return raw(o, n, "</pre></details></section>");
}

fn f_locale_json(key: []const u8, sp: i64) {
    f_key(key);
    const o : u32 = FB_N;
    if (jnullish(sp)) {
        fb_lit(SAY_NONE);
    } else {
        const m : u32 = put_locale(FB[0..], FB_N, jnum(sp));
        if (m != OVER) { FB_N = m; }
    }
    f_val_end(o);
}

/// The whole page, as tool.js leaves it. 0 on overflow. The host draws again while w_libm_need says so.
pub fn w_render(dst: []u8) -> u32 {
    RQ_N = 0;
    MISSING = false;
    if (LB_N > 14000) { LB_N = 0; }
    if (RELOAD) {
        // numbers of data.json that the host has to read (more than 15 digits, or a big exponent) are asked for now
        load_data();
        if (!MISSING) { RELOAD = false; }
    }
    var n : u32 = 0;
    if (!READY) {
        if (D_STATE == 2) {
            n = raw(dst, n, "<p class=\"cc-bad\">");
            f_clear();
            f_text("why", ERRMSG[0..(ERRMSG_LEN as usize)]);
            n = fill_out(dst, n, SAY_ERR_LOAD);
            n = raw(dst, n, "</p>");
        } else {
            n = raw(dst, n, "<p class=\"cc-dim\">");
            n = text(dst, n, SAY_LOADING);
            n = raw(dst, n, "</p>");
        }
        return n;
    }
    n = raw(dst, n, "<div class=\"cc\">");
    n = controls(dst, n);
    n = raw(dst, n, "<p class=\"cc-optitle\">");
    if ((OP as usize) < SAY_OP_TITLES.len) { n = text(dst, n, SAY_OP_TITLES[OP as usize]); }
    n = raw(dst, n, "</p>");
    if (TABLE) { n = table(dst, n); } else { n = chart(dst, n); }
    n = note(dst, n);
    n = findings(dst, n);
    n = provenance(dst, n);
    n = raw(dst, n, "</div>");
    if (!ok(n)) { return 0; }
    return n;
}

/// The splicer follows only the names a module itself mentions, not the names the imported functions
/// mention. This anchor mentions every name of the three libraries, so that they arrive whole. Never called.
pub fn imports_anchor(o: []u8, s: []const u8, w: []u32, d: []f64) -> u32 {
    var n : u32 = 0;
    n = n + ((OVER) as u32);
    n = n + ((H_LT) as u32);
    n = n + ((H_GT) as u32);
    n = n + ((H_AMP) as u32);
    n = n + ((H_QUOTE) as u32);
    n = n + ((H_APOS) as u32);
    n = n + ((H_SPACE) as u32);
    n = n + ((H_SLASH) as u32);
    n = n + ((H_EQ) as u32);
    n = n + ((ok(0)) as u32);
    n = n + ((put(o, 0, 0)) as u32);
    n = n + ((raw(o, 0, s)) as u32);
    n = n + ((put_escaped(o, 0, 0)) as u32);
    n = n + ((text(o, 0, s)) as u32);
    n = n + ((num(o, 0, 0)) as u32);
    n = n + ((num_grouped(o, 0, 0)) as u32);
    n = n + ((attr(o, 0, s, s)) as u32);
    n = n + ((fill(o, 0, s, s, s, s, 0)) as u32);
    n = n + ((name_is(s, 0, 0, s)) as u32);
    n = n + ((is_word_byte(0)) as u32);
    n = n + ((fill_named(o, 0, s, s, s, s, s, s, s, s, s, s, s, s, s)) as u32);
    n = n + ((dec_to(o, 0)) as u32);
    n = n + ((same_bytes(s, 0, s)) as u32);
    n = n + ((NO_SPAN) as u32);
    n = n + ((SPAN) as u32);
    n = n + ((J_OBJECT) as u32);
    n = n + ((J_ARRAY) as u32);
    n = n + ((J_STRING) as u32);
    n = n + ((J_NUMBER) as u32);
    n = n + ((J_TRUE) as u32);
    n = n + ((J_FALSE) as u32);
    n = n + ((J_NULL) as u32);
    n = n + ((J_NONE) as u32);
    n = n + ((jspan(0, 0)) as u32);
    n = n + ((span_lo(0)) as u32);
    n = n + ((span_hi(0)) as u32);
    n = n + ((skip_ws(s, 0)) as u32);
    n = n + ((string_end(s, 0)) as u32);
    n = n + ((value_end(s, 0)) as u32);
    n = n + ((root(s)) as u32);
    n = n + ((kind(s, 0)) as u32);
    n = n + ((key_is(s, 0, 0, s)) as u32);
    n = n + ((obj_get(s, 0, s)) as u32);
    n = n + ((arr_len(s, 0)) as u32);
    n = n + ((arr_at(s, 0, 0)) as u32);
    n = n + ((hex4(s, 0)) as u32);
    n = n + ((escape_at(s, 0, 0)) as u32);
    n = n + ((cp_utf8_len(0)) as u32);
    n = n + ((cp_utf8_byte(0, 0)) as u32);
    n = n + ((str_len(s, 0)) as u32);
    n = n + ((str_byte(s, 0, 0)) as u32);
    n = n + ((is_true(s, 0)) as u32);
    n = n + ((is_false(s, 0)) as u32);
    n = n + ((is_null(s, 0)) as u32);
    n = n + ((num_f64(s, 0)) as u32);
    n = n + ((num_i64(s, 0)) as u32);
    return n;
}

// ------------------------------------------------------------------------------------------------
// tests
// ------------------------------------------------------------------------------------------------

pub var T_BUF : [900000]u8 = [0; 900000];
pub var T_F : [49152]f64 = [0.0; 49152];

fn t_has(n: u32, lit: []const u8) -> bool {
    var i : u32 = 0;
    const l : u32 = lit.len as u32;
    if (n < l) { return false; }
    while (i + l <= n) {
        var k : u32 = 0;
        while (k < l and T_BUF[(i + k) as usize] == lit[k as usize]) { k = k + 1; }
        if (k == l) { return true; }
        i = i + 1;
    }
    return false;
}

fn t_data() -> []const u8 {
    return "{\"generated_at\":\"2026-10-04T17:45:21Z\",\"spec\":{\"path\":\"p/s.t27\",\"sha256\":\"0123456789abcdef0123\"},\"compiler\":{\"path\":\"c.wasm\",\"sha256\":\"fedcba9876543210ffff\"},\"tools\":{\"yosys\":\"Y 1\",\"iverilog\":\"I 2\",\"node\":\"n\"},\"synth\":\"synth_xilinx\",\"commands\":[\"a b\",\"c<d\"],\"sweep\":{},\"adder_check\":{\"trits\":3,\"cases\":729,\"all_pass\":true},\"specs\":[{\"spec\":\"specs/ternary/ternary_full_adder.t27\",\"top\":\"TFA\"}],\"capacity\":{\"lut\":134600,\"ff\":269200,\"carry4\":33650,\"dsp\":740,\"slices\":33650,\"prjxray\":{\"file\":\"f\",\"SLICEL\":22100,\"SLICEM\":11550},\"nextpnr\":{\"chipdb\":\"cd\",\"version\":\"v9\",\"SLICE_LUTX\":1,\"SLICE_FFX\":2,\"CARRY4\":3,\"DSP48E1\":4}},\"timing\":{\"runs\":94,\"sum_seconds\":1560.8,\"wall_seconds\":263.5,\"jobs\":6},\"results\":[{\"family\":\"binary\",\"op\":\"mul\",\"width\":4,\"info_bits\":4,\"top\":\"mul_4\",\"id\":\"mul_4\",\"dsp\":false,\"status\":\"ok\",\"seconds\":15.5,\"metrics\":{\"lut\":24,\"ff\":0,\"carry4\":0,\"dsp\":0,\"muxf7\":0,\"muxf8\":0}},{\"family\":\"binary\",\"op\":\"mul\",\"width\":8,\"info_bits\":8,\"top\":\"mul_8\",\"id\":\"mul_8\",\"dsp\":false,\"status\":\"ok\",\"seconds\":16,\"metrics\":{\"lut\":1300,\"ff\":0,\"carry4\":0,\"dsp\":0,\"muxf7\":0,\"muxf8\":0}},{\"family\":\"t27\",\"op\":\"mul\",\"spec\":\"specs/x/comb.t27\",\"info_bits\":4.5,\"trits\":3,\"top\":\"Comb\",\"id\":\"Comb\",\"dsp\":false,\"status\":\"rejected\",\"seconds\":0.5}],\"findings\":[{\"kind\":\"empty\",\"id\":\"zz\"}]}";
}

/// Answer every queued libm call with 1.0, but the digit calls of 12.34 (digits 1234, point after 2).
fn t_render() -> u32 {
    var n : u32 = 0;
    var rounds : u32 = 0;
    n = w_render(T_BUF[0..900000]);
    while (w_libm_need(T_F[0..49152]) > 0 and rounds < 8) {
        var k : u32 = 0;
        while (k < RQ_SENT) {
            T_F[k as usize] = 1.0;
            k = k + 1;
        }
        w_libm_give(T_F[0..49152], RQ_SENT);
        n = w_render(T_BUF[0..900000]);
        rounds = rounds + 1;
    }
    return n;
}

test numbers_are_written_like_javascript {
    var o : [64]u8 = [0; 64];
    LB_N = 0;
    RQ_N = 0;
    var n : u32 = put_js(o[0..], 0, 2.0);
    assert same_bytes(o[0..], n, "2");
    n = put_js(o[0..], 0, 0.0 - 40.0);
    assert same_bytes(o[0..], n, "-40");
    n = put_js(o[0..], 0, 12.34);
    assert MISSING;
    assert RQ_N == 3;
    assert w_libm_need(T_F[0..49152]) == 3;
    assert T_F[0] == 6.0;
    assert T_F[3] == 7.0;
    assert T_F[6] == 8.0;
    T_F[0] = 0.0;
    T_F[1] = 1234.0;
    T_F[2] = 2.0;
    w_libm_give(T_F[0..49152], 3);
    n = put_js(o[0..], 0, 12.34);
    assert same_bytes(o[0..], n, "12.34");
    n = put_css6(o[0..], 0, 266.27761565156305);
    assert same_bytes(o[0..], n, "266.278");
    n = put_css6(o[0..], 0, 12.0);
    assert same_bytes(o[0..], n, "12");
    n = put_css6(o[0..], 0, 4.5);
    assert same_bytes(o[0..], n, "4.5");
    n = put_css6(o[0..], 0, 99999.96);
    assert same_bytes(o[0..], n, "100000");
    n = put_locale(o[0..], 0, 1234567.0);
    assert same_bytes(o[0..], n, "1,234,567");
    n = put_locale(o[0..], 0, 7.26);
    assert same_bytes(o[0..], n, "7.26");
    n = put_r(o[0..], 0, 4.96, 1);
    assert same_bytes(o[0..], n, "5");
}

test fill_replaces_known_names_and_keeps_unknown_ones {
    var o : [96]u8 = [0; 96];
    f_clear();
    f_text("a", "x<y");
    f_js("b", 7.0);
    const n : u32 = fill_out(o[0..], 0, "{a} {b} {c} {a}{");
    assert same_bytes(o[0..], n, "x&lt;y 7 {c} x&lt;y{");
}

test the_page_loads_draws_a_chart_and_answers_the_pointer {
    w_init("");
    var n : u32 = w_render(T_BUF[0..900000]);
    assert t_has(n, "<p class=\"cc-dim\">Reading the synthesis results...</p>");
    w_data_failed(0, "HTTP 404");
    n = w_render(T_BUF[0..900000]);
    assert t_has(n, "<p class=\"cc-bad\">The synthesis results did not load: HTTP 404</p>");
    w_init("");
    w_data(0, t_data());
    assert OP == 1;
    n = t_render();
    assert n > 0;
    assert t_has(n, "<div class=\"cc\"><div class=\"cc-controls\">");
    assert t_has(n, "aria-pressed=\"true\" title=\"a * b: W-bit unsigned operands, 2W result bits, no clock\">Multiply</button>");
    assert t_has(n, "<p class=\"cc-optitle\">a * b: W-bit unsigned operands, 2W result bits, no clock</p>");
    assert t_has(n, "role=\"img\" aria-label=\"Cost against operand width.");
    assert t_has(n, "<polyline points=\"");
    assert t_has(n, "<circle r=\"9\" fill=\"none\"");
    assert t_has(n, "visibility=\"hidden\"></circle>");
    assert t_has(n, "<div class=\"cc-tip\" role=\"status\" aria-live=\"polite\" hidden=\"\"></div>");
    assert t_has(n, "<li><span class=\"cc-swatch cc-binary\"");
    assert t_has(n, "<li>zz: synthesised to no logic cells.</li>");
    assert t_has(n, "<summary>Every command (2)</summary><pre>a b\nc&lt;d</pre>");
    assert t_has(n, "Run at 2026-10-04T17:45:21Z.");
    assert MK_N == 2;
    w_pointer(0, CW / 2.0, CHH / 2.0, CW, CHH);
}

test the_buttons_change_the_view {
    w_init("");
    w_data(0, t_data());
    w_click(0);
    assert OP == 0;
    w_click(5);
    assert METRIC == 1;
    w_click(8);
    assert DSP;
    w_click(11);
    assert LOGSCALE == false;
    w_click(13);
    assert TABLE;
    const n : u32 = t_render();
    assert t_has(n, "<table class=\"cc-table\"><thead><tr><th scope=\"col\">Design</th>");
    assert w_size(0.0, 700.0, 800.0, 0) == 0;
    assert w_size(0.0, 900.0, 800.0, 0) == 0;
    w_click(12);
    assert TABLE == false;
    assert w_size(0.0, 1000.0, 800.0, 0) == 1;
}
