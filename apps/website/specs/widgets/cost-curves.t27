; operand information in thousandths of a bit, and the binary twin written beside it ("none" when
; the twin is the binary curve itself).
pub const K_T27_SPECS : [5]str = ["ternary/ternary_full_adder.t27", "ternary/ternary_ripple_adder.t27", "base/ternary_add.t27", "ternary/comb_ternary_dot.t27", "ternary/stream_ternary_mac.t27"];
pub const K_T27_OPS : [5]str = ["add", "add", "add", "mul", "mac"];
