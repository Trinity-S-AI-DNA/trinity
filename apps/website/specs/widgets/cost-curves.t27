; matched against nextpnr-xilinx's bel counts (two SLICE_LUTX bels per LUT6 site).
pub const K_CAP_SLICES : u16 = 33650;
pub const K_CAP_LUT6 : u32 = 134600;
pub const K_CAP_FF : u32 = 269200;
pub const K_CAP_CARRY4 : u16 = 33650;
pub const K_CAP_DSP : u16 = 740;
