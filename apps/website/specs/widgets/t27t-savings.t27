// SPDX-License-Identifier: Apache-2.0
; specs/widgets/t27t-savings.t27 -- what a training run saves when t27t moves the forward GEMMs to int8
; Source of truth for public/widgets/t27t-savings/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page. tool.js is
; one import of ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG
; diagram with a <title>, black and white, and holds no words of its own. ASCII only (L3), English
; only (LANG-EN).
; The law and the bench are gHashTag/t27 specs/t27t/t27t.t27 (module T27t, gHashTag/t27#10789): the
; saving is f x (1 - 1/s), where s is the int8 tensor-core speed over bf16 and f is the share of a
; training step spent in forward GEMMs. Every cell of the table is recomputed by the tests below with
; the same integer formula as T27t.saving_e3 (tenths of a percent, rounded half up). The rows f = 1/4
; and f = 1/3 are the #10360 cost table; f = 1/5 and f = 1/2 are what-ifs, because f was never measured.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_t27t_savings;

pub const KIND : str = "widget-tool";
pub const ID : str = "t27t-savings";
pub const TITLE : str = "t27t run savings: int8 tensor cores forward, bf16 gradients";
pub const DESCRIPTION : str = "Forward GEMMs on int8 tensor cores, gradients in bf16: a run saves f x (1 - 1/s), 16% to 24%, or $16 to $24 of every $100. f, the share of a step in forward GEMMs, is not measured.";
pub const IMAGE_ALT : str = "The t27t saving law f x (1 - 1/s). Measured on an RTX 4090: int8 tensor cores 2.9x to 3.5x bf16, dp4a 0.91x to 0.94x. With f between 1/4 and 1/3 a run saves 16% to 24%, $16 to $24 per $100. f is not measured.";
pub const HOOK : str = "Forward GEMMs on int8 tensor cores, gradients in bf16: 16% to 24% off a training run. No custom CUDA backend. f is still an estimate.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [3]str = ["gHashTag/t27 specs/t27t/t27t.t27 (gHashTag/t27#10789, PR #10790): the saving law saving_e3, the bench times and pick_path; t27c 0.5.2 test-report on the Railway lab, 8 of 8 tests pass, 3 invariants, 0 vacuous; tri t27t runs it", "gHashTag/t27#10360: the GEMM bench, one RTX 4090, 2026-10-18, five training GEMM shapes, times printed to four digits; the int8 times are the best CUTLASS 3.5.1 s8 kernel, standing in for torch._int_mm, which was not timed itself", "The rows f = 1/4 and f = 1/3 are the cost table #10360 printed; f = 1/5 and f = 1/2 are what-ifs from the same formula, shown because f has not been measured"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table: one row per f, one column per s ------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Share of the run saved, and dollars saved per $100, for f x (1 - 1/s)";
pub const SAY_TABLE_HEAD : [5]str = ["f, share of step time in forward GEMMs", "s = 2.9x", "s = 3.2x", "s = 3.5x", "Ceiling, s unbounded"];
pub const SAY_TABLE_CELLS : [20]str = [
    "1/5 (what-if)", "13.1%, $13", "13.8%, $14", "14.3%, $14", "20%",
    "1/4 (#10360 low estimate)", "16.4%, $16", "17.2%, $17", "17.9%, $18", "25%",
    "1/3 (#10360 high estimate)", "21.8%, $22", "22.9%, $23", "23.8%, $24", "33.3%",
    "1/2 (what-if)", "32.8%, $33", "34.4%, $34", "35.7%, $36", "50%"
];
pub const K_TABLE_COLS : u8 = 5;
pub const K_TABLE_ROWS : u8 = 4;
pub const K_TABLE_CELLS : u16 = 20;

; --- The numbers behind the cells -------------------------------------------------------------
; s in hundredths (the #10360 columns), f as 1/K_F_DEN, savings in tenths of a percent, row-major.
pub const K_S_E2 : [3]u32 = [290, 320, 350];
pub const K_F_DEN : [4]u32 = [5, 4, 3, 2];
pub const K_SAVING_E3 : [12]u32 = [131, 138, 143, 164, 172, 179, 218, 229, 238, 328, 344, 357];
pub const K_DOLLARS_PER_100 : [12]u32 = [13, 14, 14, 16, 17, 18, 22, 23, 24, 33, 34, 36];
pub const K_LOW_PCT : u32 = 16;
pub const K_HIGH_PCT : u32 = 24;
pub const K_F_MEASURED : bool = false;

; --- The bench (#10360): times in 1e-4 ms, ratios over bf16 in hundredths, as printed ------------
pub const K_T_BF16 : [5]u32 = [2254, 2239, 8540, 8506, 3215];
pub const K_T_INT8_TC : [5]u32 = [770, 773, 2701, 2399, 1007];
pub const K_T_DP4A : [5]u32 = [2406, 2470, 9234, 9278, 3460];
pub const K_X_INT8_TC_PRINTED : [5]u32 = [293, 290, 316, 354, 319];
pub const K_X_DP4A_PRINTED : [5]u32 = [94, 91, 92, 92, 93];

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "Where the saving comes from";
pub const SAY_FLOW_STEPS : [6]str = ["forward GEMMs move to int8", "int8 tensor cores: 2.9x to 3.5x bf16", "backward and gradients: bf16", "saving = f x (1 - 1/s)", "f = 1/4 to 1/3: 16% to 24%", "f itself: an estimate, not measured"];
pub const SAY_NOTE : str = "Measured on one RTX 4090, 2026-10-18 (gHashTag/t27#10360): int8 tensor cores ran 2.90x to 3.54x bf16 on five training GEMM shapes, under the 4x of the datasheet. dp4a on CUDA cores ran 0.91x to 0.94x, slower than bf16 on every shape, so t27t never picks it. No custom CUDA backend is needed: PyTorch reaches the int8 tensor cores through torch._int_mm, and a kernel generated by t27c would take over only at 1.10x of tuned CUTLASS or better. Not measured: f, the share of a training step spent in forward GEMMs; the cost of quantizing activations from bf16 to int8; torch._int_mm itself (the int8 times are the best CUTLASS s8 kernel); and a run end to end, because the runner, gHashTag/igla-coder-gpu, does not call torch._int_mm yet. Run the law yourself: tri t27t.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
    assert K_TABLE_ROWS * 3 == 12;
}

test every_saving_is_f_times_one_minus_one_over_s {
    assert K_SAVING_E3[0] == (2000 * (K_S_E2[0] - 100) + K_F_DEN[0] * K_S_E2[0]) / (2 * K_F_DEN[0] * K_S_E2[0]);
    assert K_SAVING_E3[1] == (2000 * (K_S_E2[1] - 100) + K_F_DEN[0] * K_S_E2[1]) / (2 * K_F_DEN[0] * K_S_E2[1]);
    assert K_SAVING_E3[2] == (2000 * (K_S_E2[2] - 100) + K_F_DEN[0] * K_S_E2[2]) / (2 * K_F_DEN[0] * K_S_E2[2]);
    assert K_SAVING_E3[3] == (2000 * (K_S_E2[0] - 100) + K_F_DEN[1] * K_S_E2[0]) / (2 * K_F_DEN[1] * K_S_E2[0]);
    assert K_SAVING_E3[4] == (2000 * (K_S_E2[1] - 100) + K_F_DEN[1] * K_S_E2[1]) / (2 * K_F_DEN[1] * K_S_E2[1]);
    assert K_SAVING_E3[5] == (2000 * (K_S_E2[2] - 100) + K_F_DEN[1] * K_S_E2[2]) / (2 * K_F_DEN[1] * K_S_E2[2]);
    assert K_SAVING_E3[6] == (2000 * (K_S_E2[0] - 100) + K_F_DEN[2] * K_S_E2[0]) / (2 * K_F_DEN[2] * K_S_E2[0]);
    assert K_SAVING_E3[7] == (2000 * (K_S_E2[1] - 100) + K_F_DEN[2] * K_S_E2[1]) / (2 * K_F_DEN[2] * K_S_E2[1]);
    assert K_SAVING_E3[8] == (2000 * (K_S_E2[2] - 100) + K_F_DEN[2] * K_S_E2[2]) / (2 * K_F_DEN[2] * K_S_E2[2]);
    assert K_SAVING_E3[9] == (2000 * (K_S_E2[0] - 100) + K_F_DEN[3] * K_S_E2[0]) / (2 * K_F_DEN[3] * K_S_E2[0]);
    assert K_SAVING_E3[10] == (2000 * (K_S_E2[1] - 100) + K_F_DEN[3] * K_S_E2[1]) / (2 * K_F_DEN[3] * K_S_E2[1]);
    assert K_SAVING_E3[11] == (2000 * (K_S_E2[2] - 100) + K_F_DEN[3] * K_S_E2[2]) / (2 * K_F_DEN[3] * K_S_E2[2]);
}

test every_dollar_figure_is_its_saving_rounded {
    assert K_DOLLARS_PER_100[0] == (K_SAVING_E3[0] + 5) / 10;
    assert K_DOLLARS_PER_100[1] == (K_SAVING_E3[1] + 5) / 10;
    assert K_DOLLARS_PER_100[2] == (K_SAVING_E3[2] + 5) / 10;
    assert K_DOLLARS_PER_100[3] == (K_SAVING_E3[3] + 5) / 10;
    assert K_DOLLARS_PER_100[4] == (K_SAVING_E3[4] + 5) / 10;
    assert K_DOLLARS_PER_100[5] == (K_SAVING_E3[5] + 5) / 10;
    assert K_DOLLARS_PER_100[6] == (K_SAVING_E3[6] + 5) / 10;
    assert K_DOLLARS_PER_100[7] == (K_SAVING_E3[7] + 5) / 10;
    assert K_DOLLARS_PER_100[8] == (K_SAVING_E3[8] + 5) / 10;
    assert K_DOLLARS_PER_100[9] == (K_SAVING_E3[9] + 5) / 10;
    assert K_DOLLARS_PER_100[10] == (K_SAVING_E3[10] + 5) / 10;
    assert K_DOLLARS_PER_100[11] == (K_SAVING_E3[11] + 5) / 10;
}

test the_headline_range_is_the_estimated_rows {
    assert K_LOW_PCT == (K_SAVING_E3[3] + 5) / 10;
    assert K_HIGH_PCT == (K_SAVING_E3[8] + 5) / 10;
    assert K_F_MEASURED == false;
}

test every_printed_int8_ratio_is_within_one_hundredth_of_the_times {
    assert K_X_INT8_TC_PRINTED[0] + 1 >= (K_T_BF16[0] * 200 + K_T_INT8_TC[0]) / (2 * K_T_INT8_TC[0]);
    assert K_X_INT8_TC_PRINTED[0] <= (K_T_BF16[0] * 200 + K_T_INT8_TC[0]) / (2 * K_T_INT8_TC[0]) + 1;
    assert K_X_INT8_TC_PRINTED[1] + 1 >= (K_T_BF16[1] * 200 + K_T_INT8_TC[1]) / (2 * K_T_INT8_TC[1]);
    assert K_X_INT8_TC_PRINTED[1] <= (K_T_BF16[1] * 200 + K_T_INT8_TC[1]) / (2 * K_T_INT8_TC[1]) + 1;
    assert K_X_INT8_TC_PRINTED[2] + 1 >= (K_T_BF16[2] * 200 + K_T_INT8_TC[2]) / (2 * K_T_INT8_TC[2]);
    assert K_X_INT8_TC_PRINTED[2] <= (K_T_BF16[2] * 200 + K_T_INT8_TC[2]) / (2 * K_T_INT8_TC[2]) + 1;
    assert K_X_INT8_TC_PRINTED[3] + 1 >= (K_T_BF16[3] * 200 + K_T_INT8_TC[3]) / (2 * K_T_INT8_TC[3]);
    assert K_X_INT8_TC_PRINTED[3] <= (K_T_BF16[3] * 200 + K_T_INT8_TC[3]) / (2 * K_T_INT8_TC[3]) + 1;
    assert K_X_INT8_TC_PRINTED[4] + 1 >= (K_T_BF16[4] * 200 + K_T_INT8_TC[4]) / (2 * K_T_INT8_TC[4]);
    assert K_X_INT8_TC_PRINTED[4] <= (K_T_BF16[4] * 200 + K_T_INT8_TC[4]) / (2 * K_T_INT8_TC[4]) + 1;
}

test dp4a_is_slower_than_bf16_on_every_shape {
    assert K_T_DP4A[0] > K_T_BF16[0];
    assert K_T_DP4A[1] > K_T_BF16[1];
    assert K_T_DP4A[2] > K_T_BF16[2];
    assert K_T_DP4A[3] > K_T_BF16[3];
    assert K_T_DP4A[4] > K_T_BF16[4];
    assert K_X_DP4A_PRINTED[0] == (K_T_BF16[0] * 200 + K_T_DP4A[0]) / (2 * K_T_DP4A[0]);
    assert K_X_DP4A_PRINTED[1] == (K_T_BF16[1] * 200 + K_T_DP4A[1]) / (2 * K_T_DP4A[1]);
    assert K_X_DP4A_PRINTED[2] == (K_T_BF16[2] * 200 + K_T_DP4A[2]) / (2 * K_T_DP4A[2]);
    assert K_X_DP4A_PRINTED[3] == (K_T_BF16[3] * 200 + K_T_DP4A[3]) / (2 * K_T_DP4A[3]);
    assert K_X_DP4A_PRINTED[4] == (K_T_BF16[4] * 200 + K_T_DP4A[4]) / (2 * K_T_DP4A[4]);
}
