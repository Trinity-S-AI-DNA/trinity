pub const KIND : str = "widget-tool";
pub const ID : str = "idcode";
pub const TITLE : str = "JTAG IDCODE decoder: 32 bits, four fields, one device";
pub const DESCRIPTION : str = "Paste a 32-bit JTAG IDCODE: version, part number, JEDEC manufacturer and the fixed 1 in bit 0 as clickable bits, then the device from openFPGALoader's own table.";
pub const IMAGE_ALT : str = "IDCODE card for 0x03636093: 32 bits in four coloured fields, version 0x0, part number 0x3636, manufacturer 0x049 (JEP106 bank 1, code 0x49, Xilinx) and bit 0 set to 1, found in openFPGALoader v1.1.1 as xc7a200, artix a7 200t, IR length 6. Our Wukong board reads 0x13636093 raw: version 1, same part.";
pub const HOOK : str = "Paste your board's IDCODE, get its bit fields and its device as a link: #id=0x03636093 is the Artix-7 200T on our bench.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [7]str = ["openFPGALoader v1.1.1, github.com/trabucayre/openFPGALoader commit 85be4fa02b2dd6a83716d7dfac3d25bbd260ff7b, Apache-2.0, Copyright (C) 2019 Gwenhael Goavec-Merou: src/part.hpp (sha256 74ded91a5ef62d1f) fpga_list, misc_dev_list, list_manufacturer", "openFPGALoader v1.1.1 src/board.hpp (sha256 0c955d02921affa5): the FPGA part of each preset board", "openFPGALoader v1.1.1 src/jtag.cpp detectChain and src/main.cpp --detect: the lookup order (full IDCODE, then masked with 0x0fffffff) and the printed lines", "Bench 2026-10-04 UTC: openFPGALoader 1.1.1 -c digilent_hs2 --detect --verbose-level 2 on one QMTech Wukong V1 (XC7A200T): raw IDCODE 0x13636093, printed idcode 0x3636093", "t27 fpga/HARDWARE_SSOT.md, W791 2026-08-17: openFPGALoader 1.1.1 --detect on all three Wukong boards (--busdev-num 1:4, 1:6, 1:8) printed idcode 0x3636093, artix a7 200t, xc7a200", "IEEE Std 1149.1 device identification register: version [31:28], part number [27:12], manufacturer identity [11:1] per JEDEC JEP106, bit 0 always 1", "scripts/widget-data/idcode.mjs: writes public/widgets/idcode/parts.json from the pinned files and checks this spec's K_ numbers against the table and the bench record"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- Numbers the tool relies on ------------------------------------------------------------
pub const K_DATA_FILE : str = "./parts.json";
pub const K_HASH_KEY : str = "id";
; The four fields, most significant first: version, part number, manufacturer, fixed 1.
pub const K_FIELD_LSB : [4]u8 = [28, 12, 1, 0];
pub const K_FIELD_WIDTH : [4]u8 = [4, 16, 11, 1];
; Inside the 11-bit manufacturer field: the low 7 bits are the JEP106 identity code, the high 4
; the number of 0x7F continuation codes before it (bank = that count + 1).
pub const K_MFR_CODE_BITS : u8 = 7;
; openFPGALoader's second lookup: the IDCODE with the version nibble cleared (0x0fffffff).
pub const K_VERSION_MASK : u32 = 268435455;
; 0x03636093, the fpga_list key for xc7a200 (artix a7 200t, IR length 6), and the IDCODE in the
; header of every bitstream we build for the XC7A200T.
pub const K_TABLE_IDCODE : u32 = 56844435;
pub const K_TABLE_PART : u16 = 13878;
pub const K_XILINX_MFR : u16 = 73;
pub const K_XC7A200T_IR_LENGTH : u8 = 6;
; 0x13636093, the raw word one Wukong board shifted out on 2026-10-04 UTC.
pub const K_BENCH_RAW_IDCODE : u32 = 325279891;
pub const K_BENCH_BOARDS_2026_08_17 : u8 = 3;
; What openFPGALoader treats specially: all zeros (TDO stuck low) and all ones (end of chain).
pub const K_STUCK_LOW : u32 = 0;
pub const K_END_OF_CHAIN : u32 = 4294967295;
; The PNG the reader can save.
pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

