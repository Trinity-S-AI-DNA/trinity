; --- Tests ----------------------------------------------------------------------------------
test bit_zero_of_an_idcode_is_one {
    assert K_FIELD_LSB[3] == 0;
    assert K_FIELD_WIDTH[3] == 1;
    assert K_TABLE_IDCODE % 2 == 1;
    assert K_BENCH_RAW_IDCODE % 2 == 1;
    assert K_STUCK_LOW % 2 == 0;
}

test the_four_fields_tile_32_bits {
    assert K_FIELD_WIDTH[0] + K_FIELD_WIDTH[1] + K_FIELD_WIDTH[2] + K_FIELD_WIDTH[3] == 32;
    assert K_FIELD_LSB[0] == K_FIELD_LSB[1] + K_FIELD_WIDTH[1];
    assert K_FIELD_LSB[1] == K_FIELD_LSB[2] + K_FIELD_WIDTH[2];
    assert K_FIELD_LSB[2] == K_FIELD_LSB[3] + K_FIELD_WIDTH[3];
    assert K_FIELD_LSB[0] + K_FIELD_WIDTH[0] == 32;
}

test x03636093_is_xilinx_0x049_part_0x3636 {
    assert K_TABLE_IDCODE == 56844435;
    assert K_XILINX_MFR == (K_TABLE_IDCODE / 2) % 2048;
    assert K_XILINX_MFR == 73;
    assert K_TABLE_PART == (K_TABLE_IDCODE / 4096) % 65536;
    assert K_TABLE_PART == 13878;
    assert K_TABLE_IDCODE / 268435456 == 0;
    assert 147 != (K_TABLE_IDCODE / 2) % 2048;
}

test xilinx_sits_in_jep106_bank_1_as_code_0x49 {
    assert K_XILINX_MFR / 128 == 0;
    assert K_XILINX_MFR % 128 == 73;
    assert K_MFR_CODE_BITS + 4 == K_FIELD_WIDTH[2];
}

test the_bench_word_differs_from_the_table_key_only_in_its_version {
    assert K_BENCH_RAW_IDCODE / 268435456 == 1;
    assert K_BENCH_RAW_IDCODE % 268435456 == K_TABLE_IDCODE;
    assert K_BENCH_RAW_IDCODE != K_TABLE_IDCODE;
    assert K_VERSION_MASK + 1 == 268435456;
    assert K_BENCH_BOARDS_2026_08_17 == 3;
    assert K_XC7A200T_IR_LENGTH == 6;
}

test all_ones_ends_the_chain_though_its_bit_0_is_1 {
    assert K_END_OF_CHAIN % 2 == 1;
    assert K_END_OF_CHAIN == 4294967295;
}

test the_page_reads_nothing_and_sends_nothing {
    assert READS_LOCAL_FILES == false;
    assert SENDS_NOTHING == true;
    assert same_text(CATEGORY, "fpga");
    assert same_text(K_HASH_KEY, "id");
}


; =================================================================================================
; THE NATIVE PAGE (epic gHashTag/t27#10937, issue #10938, stage "page" of specs/t27f/widget_factory.t27)
; Everything below replaces public/widgets/idcode/tool.js (270 lines of hand-written JavaScript). The
; words and numbers above are unchanged (but for two tests, see the end of this header). The page keeps
; its state in module-level `pub var`s and writes the page as HTML; the one shared host (host.js) sets
; it, forwards events and runs the effects. Entry points (all `pub fn`):
;   w_init(hash)          the page opens; hash is the address's #fragment bytes
;   w_data(i, bytes)      parts.json was fetched; w_data_failed(i) when it could not be
;   w_input(i, text)      the IDCODE field changed (i = 0)
;   w_click(i)            the i-th button in document order: the presets (2 + the rows of parts.json "presets"),
;                         then the 32 bits (bit 31 first), then "Copy link", then "Save card PNG"
;   w_hash(hash)          the address changed
;   w_hash_out(dst)       the address to show after the last event: byte 1, then "#id=0x03636093"; the host
;                         puts the origin and the path in front of it (tool.js writes origin + pathname + hash,
;                         so a query string is dropped, as there)
;   w_value(i, dst)       the text the IDCODE field must hold now (4294967295: leave it)
;   w_render(dst)         the page's HTML
;   w_effect(k, dst)      effects after an event: record 117 ("u") copy the link: byte 117, then the hash text
;                         the host appends to origin + pathname; record 80 ("P") save the card as a PNG:
;                         byte 80, then "1200\n630\nidcode-0x03636093.png" (see w_bdraw2); w_copied(ok) answers
;   w_bdraw2(dst)         the card as a BINARY draw list (the protocol of fasm_skyline.t27, plus three property
;                         codes: 36 textBaseline, 37 textAlign, 38 globalAlpha(f64); and a string that holds
;                         byte 1, a CSS variable name, byte 2, a fallback, byte 3 is replaced by the host with
;                         the variable of <html> trimmed, or the fallback when it is empty: tool.js's
;                         `cs.getPropertyValue(v).trim() || fallback`, read when the card is saved)
; STATE tool.js keeps in DOM elements and in the closure, kept here as flags: `table` (parts.json indexed),
; and what each part of the page last showed. tool.js repaints the presets, the bench lines and the credit
; only when parts.json arrives, and the result at every code change. When parts.json is read halfway (a
; missing "source" throws after `table` is set), tool.js leaves the credit at "did not load" while the table
; stays in use, and the parts it did not reach keep their old look until the next change of the code. P_TBL,
; B_TBL, R_TBL and P_PR are those looks. A card the page has not repainted shows what the code was when it
; was painted, which is the current code: the code changes only through set(), which repaints.
; Not carried over from JavaScript (said plainly; the measurement does not cover them):
;  - a row of parts.json, or an element of "presets", that is a STRING is read by JavaScript as its characters
;    (r[0] is the first character); here it has no cells. A value of "raw"/"printed" that is a string or a
;    number reads here as a throw; JavaScript reads r[0] of a string.
;  - an array as a preset label (el() flattens it), a preset label that is an array; "commit" that is an array;
;  - a manufacturer or model cell that is not a string where tool.js calls .toLowerCase() on it (JavaScript
;    throws halfway through draw(); here the text is compared as String(cell));
;  - toLowerCase() folds ASCII only; a cell text is cut at W_CELL_CAP bytes; parts.json above W_DATA_CAP bytes
;    is "did not load"; a duplicate key inside a JSON object reads as the first here, the last in JSON.parse;
;  - decodeURIComponent throws on a malformed %-escape or on bytes that are not UTF-8; here a malformed escape
;    reads as "no code in the address" and bytes are not checked;
;  - parseInt of more than 53 bits of hex digits rounds step by step, not as V8 does; a 12-unit commit cut that
;    would split a surrogate pair is cut before the pair;
;  - the address: tool.js's replaceState is called once per change, so is this page's, after the event.

; MEASURED 2026-10-19: t27c gen + a 12-line Zig export wrapper + zig build-exe wasm32-freestanding ReleaseSmall give a
; 39368-byte wasm. The original page (tool.js) and this one ran in two DOM windows (happy-dom) with a FAKE getContext('2d')
; that records every method call and every property assignment (the card canvas is never in the page: its sequence is
; carried in the text of the downloaded file); after every action the DOM (the input value too), the address, the saved
; files (name, type, the whole recorded call sequence of the card), the clipboard and the blob log were compared:
; 7446 comparisons, 0 differences. They cover the real parts.json with every control (the 11 presets, the 32 bits, copy
; with an allowed, a refused and a missing clipboard, save PNG for 190 codes), every key of the table typed plain and with
; a version, every manufacturer, 10 addresses at load, 12 address changes, 2400 fuzzed typings (hex with and without 0x,
; arrow lines, white space of every kind, underscores, noise, table keys) with bit clicks, saves and address changes,
; 48 variants of parts.json (empty lists, presets missing / null / odd / not iterable, bench missing / odd / throwing,
; source missing / odd, rows that make indexTable throw, duplicate keys, empty and null names, markup and unicode, hex forms
; of every kind, numbers as keys, minified and escaped JSON, truncated JSON), a 404, a non-JSON answer and events before
; the data arrives. Negative controls: a changed DOM node, a changed input value, a rect digit moved by 1e-9, a property
; value moved by 1e-9, a skipped call, a changed CSS fallback, a renamed download, a copy without the hash and a skipped
; address write are each reported. NOT compared (happy-dom has no layout, canvas or clipboard): the pixels, the bytes of
; the PNG, the real clipboard, focus.

pub const W_DATA_CAP : u32 = 262144;
pub const W_CELL_CAP : u32 = 4096;
pub const W_MONO_VAR : str = "--w-mono";
pub const W_MONO_FB : str = "monospace";
pub const W_GREEN_VAR : str = "--w-green";
pub const W_GREEN_FB : str = "#00ff88";
pub const W_GOLD_VAR : str = "--w-gold";
pub const W_GOLD_FB : str = "#ffd700";
pub const W_TEXT_VAR : str = "--w-text";
pub const W_TEXT_FB : str = "#e8fff7";
pub const W_MUTED_VAR : str = "--w-subtle";
pub const W_MUTED_FB : str = "#8fa9a0";
pub const W_RED_VAR : str = "--w-red";
pub const W_RED_FB : str = "#ff4d6d";
pub const W_BLUE : str = "#6cb6ff";
pub const W_FIELD_CLASS : [4]str = ["idc-f-ver", "idc-f-part", "idc-f-mfr", "idc-f-one"];
pub const W_FIELD_DIGITS : [4]u8 = [1, 4, 3, 1];

pub var DATA : [262144]u8 = [0; 262144];
pub var DLEN : u32 = 0;
pub var CODE : u32 = 0;
pub var MSG : u8 = 0;
pub var SHARE : u8 = 0;
pub var WRITE_IN : bool = false;
pub var HASH_PEND : bool = false;
pub var CREDIT : u8 = 0;
pub var TBL : bool = false;
pub var P_TBL : bool = false;
pub var B_TBL : bool = false;
pub var R_TBL : bool = false;
pub var P_PR : bool = false;
pub var EF : [4]u8 = [0; 4];
pub var EF_N : u32 = 0;
pub var H_KIND : u8 = 0;
pub var H_KEY : u32 = 0;
pub var H_MASKED : bool = false;
pub var H_ROW : i64 = -1;
pub var DV : [4]u32 = [0; 4];
pub var D_MFR : u32 = 0;
pub var D_CONT : u32 = 0;
pub var D_ID : u32 = 0;
pub var D_NAME : i64 = -1;

// --- small pieces -----------------------------------------------------------------------------------

fn hexv(b: u8) -> i64 {
    if (b >= 48 and b <= 57) { return (b - 48) as i64; }
    if (b >= 97 and b <= 102) { return (b - 97) as i64 + 10; }
    if (b >= 65 and b <= 70) { return (b - 65) as i64 + 10; }
    return -1;
}

/// 2 ** k.
fn pow2(k: u32) -> u64 {
    var r : u64 = 1;
    var i : u32 = 0;
    while (i < k) {
        r = r * 2;
        i = i + 1;
    }
    return r;
}

/// hexN / printf_x: the lowercase hex digits of v, at least min of them, "0x" in front when prefix; written
/// to o. A word of o that does not fit returns OVER.
fn put_hex(o: []u8, n0: u32, v: u32, min: u32, prefix: bool) -> u32 {
    var n : u32 = n0;
    if (prefix) {
        n = put(o, n, 48);
        n = put(o, n, 120);
    }
    var count : u32 = 1;
    var t : u32 = v / 16;
    while (t > 0) {
        count = count + 1;
        t = t / 16;
    }
    var width : u32 = count;
    if (min > width) { width = min; }
    var k : u32 = width;
    while (k > 0) {
        k = k - 1;
        var d : u32 = v;
        var sh : u32 = 0;
        while (sh < k) {
            d = d / 16;
            sh = sh + 1;
        }
        const nib : u32 = d % 16;
        if (nib < 10) { n = put(o, n, (nib as u8) + 48); } else { n = put(o, n, (nib as u8) + 87); }
    }
    return n;
}

/// The hex text of v as a byte string in tmp; its length.
fn hex_to(tmp: []u8, v: u32, min: u32, prefix: bool) -> u32 {
    const l : u32 = put_hex(tmp, 0, v, min, prefix);
    if (l == OVER) { return 0; }
    return l;
}

/// parseInt(text, 16) >>> 0 for the text b: white space, a sign, an optional 0x, the hex digits; no digit is NaN, which
/// is 0 after the shift.
fn parse_int16(b: []const u8) -> u32 {
    const len : u32 = b.len as u32;
    var i : u32 = 0;
    while (i < len) {
        const w : u32 = jv_ws_at(b, i, len);
        if (w == 0) { break; }
        i = i + w;
    }
    var neg : bool = false;
    if (i < len and (b[i as usize] == 43 or b[i as usize] == 45)) {
        if (b[i as usize] == 45) { neg = true; }
        i = i + 1;
    }
    if (i + 1 < len and b[i as usize] == 48 and (b[(i + 1) as usize] == 120 or b[(i + 1) as usize] == 88)) { i = i + 2; }
    var val : f64 = 0.0;
    var cnt : u32 = 0;
    while (i < len) {
        const h : i64 = hexv(b[i as usize]);
        if (h < 0) { break; }
        val = val * 16.0 + (h as f64);
        cnt = cnt + 1;
        i = i + 1;
    }
    if (cnt == 0) { return 0; }
    if (neg) { val = 0.0 - val; }
    if (val - val != 0.0) { return 0; }
    const m : f64 = val - js_floor(val / 4294967296.0) * 4294967296.0;
    return m as u32;
}

/// Is the value of the JSON text at sp present for `??`: not missing and not null.
fn present(d: []const u8, sp: i64) -> bool {
    const k : u8 = kind(d, sp);
    return k != J_NONE and k != J_NULL;
}

/// parseInt(String(v), 16) >>> 0 of the value at sp.
fn int16_of(d: []const u8, sp: i64) -> u32 {
    var tmp : [4096]u8 = [0; 4096];
    const l : u32 = jv_str(tmp[0..], 0, d, sp);
    if (l == OVER) { return 0; }
    return parse_int16(tmp[0..(l as usize)]);
}

/// The i-th element of the row at sp when the row is an array; a row of another kind has no cells.
fn cell(d: []const u8, row: i64, i: u32) -> i64 {
    if (kind(d, row) != J_ARRAY) { return NO_SPAN; }
    return arr_at(d, row, i);
}

/// String(v) of the value at sp into tmp (cut at the end of tmp); its length.
fn str_of(tmp: []u8, d: []const u8, sp: i64) -> u32 {
    const l : u32 = jv_str(tmp, 0, d, sp);
    if (l == OVER) { return 0; }
    return l;
}

/// A child of el(): missing and null add nothing, the rest is String(v) as escaped text.
fn put_kid(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    if (!present(d, sp)) { return n0; }
    return jv_text(o, n0, d, sp);
}

/// String(v) as escaped text (the template literal and fill() forms).
fn put_val(o: []u8, n0: u32, d: []const u8, sp: i64) -> u32 {
    return jv_text(o, n0, d, sp);
}

fn is_space_only(t: []const u8) -> bool {
    const len : u32 = t.len as u32;
    var i : u32 = 0;
    while (i < len) {
        const w : u32 = jv_ws_at(t, i, len);
        if (w == 0) { return false; }
        i = i + w;
    }
    return true;
}

fn count_hex_run(t: []const u8, p: usize) -> usize {
    var e : usize = p;
    while (e < t.len and hexv(t[e]) >= 0) { e = e + 1; }
    return e;
}

fn run_value(t: []const u8, p: usize, e: usize) -> u64 {
    var v : u64 = 0;
    var i : usize = p;
    while (i < e) {
        v = v * 16 + (hexv(t[i]) as u64);
        i = i + 1;
    }
    return v;
}

/// The regex tail 0x([0-9a-f]{1,8})\b at q: the end of the match (the hex run) or 0 when it does not match; the
/// value is left in M_VAL.
pub var M_VAL : u64 = 0;

fn match_0x(t: []const u8, q: usize) -> usize {
    if (q + 1 >= t.len) { return 0; }
    if (t[q] != 48) { return 0; }
    if (t[q + 1] != 120 and t[q + 1] != 88) { return 0; }
    const p : usize = q + 2;
    const e : usize = count_hex_run(t, p);
    if (e == p or e - p > 8) { return 0; }
    if (e < t.len and is_word_byte(t[e])) { return 0; }
    M_VAL = run_value(t, p, e);
    return e;
}

/// parseCode(text): openFPGALoader's raw line (-> 0x13636093, the first one that is not 0xffffffff), then the
/// first 0x word, then a bare run of up to eight hex digits; -1 when there is none.
fn parse_code(t: []const u8) -> i64 {
    const len : u32 = t.len as u32;
    var p : usize = 0;
    while (p + 1 < t.len) {
        if (t[p] == 45 and t[p + 1] == 62) {
            var q : usize = p + 2;
            while (q < t.len) {
                const w : u32 = jv_ws_at(t, q as u32, len);
                if (w == 0) { break; }
                q = q + (w as usize);
            }
            const e : usize = match_0x(t, q);
            if (e > 0) {
                if (M_VAL != 4294967295) { return M_VAL as i64; }
                p = e;
            } else {
                p = p + 1;
            }
        } else {
            p = p + 1;
        }
    }
    p = 0;
    while (p + 1 < t.len) {
        const e : usize = match_0x(t, p);
        if (e > 0) { return M_VAL as i64; }
        p = p + 1;
    }
    var bare : [64]u8 = [0; 64];
    var bn : usize = 0;
    var i : u32 = 0;
    while (i < len) {
        const w : u32 = jv_ws_at(t, i, len);
        if (w > 0) {
            i = i + w;
        } else {
            if (t[i as usize] == 95) {
                i = i + 1;
            } else {
                if (bn >= 64) { return -1; }
                bare[bn] = t[i as usize];
                bn = bn + 1;
                i = i + 1;
            }
        }
    }
    if (bn < 1 or bn > 8) { return -1; }
    var k : usize = 0;
    var v : u64 = 0;
    while (k < bn) {
        const h : i64 = hexv(bare[k]);
        if (h < 0) { return -1; }
        v = v * 16 + (h as u64);
        k = k + 1;
    }
    return v as i64;
}

/// codeFromHash(): the first [#&]id=value (value: one or more bytes up to the next &) of the address, percent-decoded
/// and read by parseCode; -1 when there is none.
fn code_from_hash(h: []const u8) -> i64 {
    const key : []const u8 = K_HASH_KEY;
    var p : usize = 0;
    while (p < h.len) {
        if (h[p] == 35 or h[p] == 38) {
            var ok_key : bool = p + 1 + key.len < h.len;
            var k : usize = 0;
            while (ok_key and k < key.len) {
                if (h[p + 1 + k] != key[k]) { ok_key = false; }
                k = k + 1;
            }
            if (ok_key and h[p + 1 + key.len] == 61) {
                const a : usize = p + 2 + key.len;
                var e : usize = a;
                while (e < h.len and h[e] != 38) { e = e + 1; }
                if (e > a) {
                    var dec : [256]u8 = [0; 256];
                    var dn : usize = 0;
                    var i : usize = a;
                    while (i < e) {
                        if (dn >= 256) { return -1; }
                        if (h[i] == 37) {
                            if (i + 2 >= e) { return -1; }
                            const hi : i64 = hexv(h[i + 1]);
                            const lo : i64 = hexv(h[i + 2]);
                            if (hi < 0 or lo < 0) { return -1; }
                            dec[dn] = (hi * 16 + lo) as u8;
                            i = i + 3;
                        } else {
                            dec[dn] = h[i];
                            i = i + 1;
                        }
                        dn = dn + 1;
                    }
                    return parse_code(dec[0..dn]);
                }
            }
        }
        p = p + 1;
    }
    return -1;
}

// --- the table: tool.js's indexTable and lookup, read from the bytes of parts.json ----------------------

fn tbl(d: []const u8, name: []const u8) -> i64 {
    return obj_get(d, root(d), name);
}

/// Is the value at arr an array none of whose elements is null (r[0] of a null row throws)?
fn rows_ok(d: []const u8, arr: i64) -> bool {
    if (kind(d, arr) != J_ARRAY) { return false; }
    const hi : usize = span_hi(arr);
    var p : usize = skip_ws(d, span_lo(arr) + 1);
    while (p < hi and d[p] != 93) {
        const e : usize = value_end(d, p);
        if (kind(d, jspan(p, e)) == J_NULL) { return false; }
        p = skip_ws(d, e);
        if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
    }
    return true;
}

/// indexTable(d) does not throw: d is an object whose fpga, misc, manufacturers and shadowed are arrays of non-null rows.
fn table_ok(d: []const u8) -> bool {
    if (kind(d, root(d)) != J_OBJECT) { return false; }
    if (!rows_ok(d, tbl(d, "fpga"))) { return false; }
    if (!rows_ok(d, tbl(d, "misc"))) { return false; }
    if (!rows_ok(d, tbl(d, "manufacturers"))) { return false; }
    return rows_ok(d, tbl(d, "shadowed"));
}

/// The last row of the array at arr whose key (parseInt of its cell 0, as unsigned) is `key`: what new Map(rows)
/// keeps; NO_SPAN when there is none.
fn find_row(d: []const u8, arr: i64, key: u32) -> i64 {
    var res : i64 = NO_SPAN;
    const hi : usize = span_hi(arr);
    var p : usize = skip_ws(d, span_lo(arr) + 1);
    while (p < hi and d[p] != 93) {
        const e : usize = value_end(d, p);
        const r : i64 = jspan(p, e);
        if (int16_of(d, cell(d, r, 0)) == key) { res = r; }
        p = skip_ws(d, e);
        if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
    }
    return res;
}

/// table.mfr.get(key): the second cell of the last manufacturer row of that key (NO_SPAN when there is none).
fn mfr_get(d: []const u8, key: u32) -> i64 {
    const r : i64 = find_row(d, tbl(d, "manufacturers"), key);
    if (r == NO_SPAN) { return NO_SPAN; }
    return cell(d, r, 1);
}

/// lookup(code) with a table (use_table) or without: H_KIND 0 is the null of no table, 1 an fpga row, 2 a misc
/// row, 3 {kind: 'none'}.
fn do_lookup(c: u32, use_table: bool) -> u32 {
    H_KIND = 0;
    H_ROW = NO_SPAN;
    H_MASKED = false;
    H_KEY = 0;
    if (!use_table) { return 0; }
    H_KIND = 3;
    const d : []const u8 = DATA[0..(DLEN as usize)];
    var pass : u32 = 0;
    while (pass < 2) {
        var key : u32 = c;
        if (pass == 1) { key = c % 268435456; }
        const f : i64 = find_row(d, tbl(d, "fpga"), key);
        if (f != NO_SPAN) {
            H_KIND = 1;
            H_KEY = key;
            H_ROW = f;
            H_MASKED = key != c;
            return 0;
        }
        const m : i64 = find_row(d, tbl(d, "misc"), key);
        if (m != NO_SPAN) {
            H_KIND = 2;
            H_KEY = key;
            H_ROW = m;
            H_MASKED = key != c;
            return 0;
        }
        pass = pass + 1;
    }
    return 0;
}

fn field_of(c: u32, i: u32) -> u32 {
    const lsb : u32 = K_FIELD_LSB[i as usize] as u32;
    const width : u32 = K_FIELD_WIDTH[i as usize] as u32;
    return (((c as u64) / pow2(lsb)) % pow2(width)) as u32;
}

/// The field index a bit belongs to: LSB.findIndex((l, i) => bit >= l && bit < l + WIDTH[i]).
fn field_index(bit: u32) -> u32 {
    var i : u32 = 0;
    while (i < 4) {
        const l : u32 = K_FIELD_LSB[i as usize] as u32;
        const w : u32 = K_FIELD_WIDTH[i as usize] as u32;
        if (bit >= l and bit < l + w) { return i; }
        i = i + 1;
    }
    return 4294967295;
}

/// decode(code): the four fields and the manufacturer split; the name from the table when use_table.
fn decode(c: u32, use_table: bool) -> u32 {
    var i : u32 = 0;
    while (i < 4) {
        DV[i as usize] = field_of(c, i);
        i = i + 1;
    }
    D_MFR = DV[2];
    const cb : u32 = pow2(K_MFR_CODE_BITS as u32) as u32;
    D_CONT = D_MFR / cb;
    D_ID = D_MFR % cb;
    D_NAME = NO_SPAN;
    if (use_table) {
        const d : []const u8 = DATA[0..(DLEN as usize)];
        const nm : i64 = mfr_get(d, D_MFR);
        if (present(d, nm)) { D_NAME = nm; }
    }
    return 0;
}

// --- state: tool.js's set(), the events, the data -------------------------------------------------------

fn set_code(c: u32, write_input: bool) -> u32 {
    CODE = c;
    if (write_input) {
        WRITE_IN = true;
        MSG = 0;
    }
    HASH_PEND = true;
    SHARE = 0;
    R_TBL = TBL;
    P_PR = true;
    return 0;
}

pub fn w_init(h: []const u8) -> u32 {
    DLEN = 0;
    CREDIT = 0;
    TBL = false;
    P_TBL = false;
    B_TBL = false;
    R_TBL = false;
    P_PR = false;
    MSG = 0;
    SHARE = 0;
    EF_N = 0;
    const v : i64 = code_from_hash(h);
    var start : u32 = K_TABLE_IDCODE;
    if (v >= 0) { start = v as u32; }
    set_code(start, false);
    WRITE_IN = true;
    return 0;
}

pub fn w_input(i: u32, s: []const u8) -> u32 {
    if (i != 0) { return 0; }
    const v : i64 = parse_code(s);
    if (v < 0) {
        MSG = 0;
        if (!is_space_only(s)) { MSG = 1; }
        return 0;
    }
    MSG = 0;
    set_code(v as u32, false);
    return 0;
}

pub fn w_hash(h: []const u8) -> u32 {
    const v : i64 = code_from_hash(h);
    if (v >= 0 and (v as u32) != CODE) { set_code(v as u32, true); }
    return 0;
}

pub fn w_hash_out(dst: []u8) -> u32 {
    if (!HASH_PEND) { return 0; }
    HASH_PEND = false;
    var n : u32 = put(dst, 0, 1);
    n = raw(dst, n, "#");
    n = raw(dst, n, K_HASH_KEY);
    n = raw(dst, n, "=");
    n = put_hex(dst, n, CODE, 8, true);
    if (n == OVER) { return 0; }
    return n;
}

pub fn w_value(i: u32, dst: []u8) -> u32 {
    if (i != 0 or !WRITE_IN) { return 4294967295; }
    WRITE_IN = false;
    const n : u32 = put_hex(dst, 0, CODE, 8, true);
    if (n == OVER) { return 4294967295; }
    return n;
}

/// The number of buttons in the presets row: the two constants, and the rows of parts.json "presets" once painted.
fn preset_count() -> u32 {
    if (!P_TBL) { return 2; }
    const d : []const u8 = DATA[0..(DLEN as usize)];
    const p : i64 = tbl(d, "presets");
    if (kind(d, p) != J_ARRAY) { return 2; }
    return 2 + arr_len(d, p);
}

pub fn w_click(i: u32) -> u32 {
    const np : u32 = preset_count();
    if (i < np) {
        if (i == 0) {
            set_code(K_BENCH_RAW_IDCODE, true);
        } else {
            if (i == 1) {
                set_code(K_TABLE_IDCODE, true);
            } else {
                const d : []const u8 = DATA[0..(DLEN as usize)];
                const row : i64 = arr_at(d, tbl(d, "presets"), i - 2);
                set_code(int16_of(d, cell(d, row, 2)), true);
            }
        }
        return 0;
    }
    if (i < np + 32) {
        const b : u32 = 31 - (i - np);
        const flip : u32 = pow2(b) as u32;
        var next : u32 = CODE + flip;
        if ((CODE / flip) % 2 == 1) { next = CODE - flip; }
        set_code(next, true);
        return 0;
    }
    if (i == np + 32) {
        EF[0] = 117;
        EF_N = 1;
        return 0;
    }
    if (i == np + 33) {
        EF[0] = 80;
        EF_N = 1;
    }
    return 0;
}

pub fn w_copied(ok_copy: u32) -> u32 {
    SHARE = 2;
    if (ok_copy != 0) { SHARE = 1; }
    return 0;
}

pub fn w_data_failed(i: u32) -> u32 {
    CREDIT = 2;
    return 0;
}

/// The credit text's "commit.slice(0, 12)": the first 12 UTF-16 units of the decoded string at sp, as bytes.
fn commit12(tmp: []u8, d: []const u8, sp: i64) -> u32 {
    var full : [512]u8 = [0; 512];
    var fl : u32 = jv_str(full[0..], 0, d, sp);
    if (fl == OVER) { fl = 0; }
    var i : u32 = 0;
    var units : u32 = 0;
    while (i < fl) {
        const b : u8 = full[i as usize];
        var w : u32 = 1;
        var u : u32 = 1;
        if (b >= 192) { w = 2; }
        if (b >= 224) { w = 3; }
        if (b >= 240) {
            w = 4;
            u = 2;
        }
        if (units + u > 12) { break; }
        units = units + u;
        i = i + w;
    }
    var k : u32 = 0;
    while (k < i and k < fl) {
        tmp[k as usize] = full[k as usize];
        k = k + 1;
    }
    return i;
}

pub fn w_data(i: u32, s: []const u8) -> u32 {
    CREDIT = 2;
    if (s.len > (W_DATA_CAP as usize)) { return 0; }
    var k : usize = 0;
    while (k < s.len) {
        DATA[k] = s[k];
        k = k + 1;
    }
    DLEN = s.len as u32;
    const d : []const u8 = DATA[0..(DLEN as usize)];
    if (!jv_valid(d)) { return 0; }
    if (!table_ok(d)) { return 0; }
    TBL = true;
    // d.source.tag, d.source.commit.slice(0, 12)
    const src : i64 = tbl(d, "source");
    if (kind(d, src) != J_OBJECT) { return 0; }
    if (kind(d, obj_get(d, src, "commit")) != J_STRING) { return 0; }
    CREDIT = 1;
    // drawPresets(): for (const [board, part, hex] of presets ?? [])
    const pr : i64 = tbl(d, "presets");
    const pk : u8 = kind(d, pr);
    if (pk != J_NONE and pk != J_NULL) {
        if (pk != J_ARRAY) {
            CREDIT = 2;
            return 0;
        }
        const hi : usize = span_hi(pr);
        var p : usize = skip_ws(d, span_lo(pr) + 1);
        while (p < hi and d[p] != 93) {
            const e : usize = value_end(d, p);
            const rk : u8 = kind(d, jspan(p, e));
            if (rk == J_NULL or rk == J_NUMBER or rk == J_TRUE or rk == J_FALSE or rk == J_OBJECT) {
                CREDIT = 2;
                return 0;
            }
            p = skip_ws(d, e);
            if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
        }
    }
    P_TBL = true;
    P_PR = false;
    // drawBench(): b.raw[0], b.printed[0], b.date.replace, b.tool.replace
    const b : i64 = tbl(d, "bench");
    if (jv_truthy(d, b)) {
        if (kind(d, b) != J_OBJECT) {
            CREDIT = 2;
            return 0;
        }
        if (kind(d, obj_get(d, b, "raw")) != J_ARRAY or kind(d, obj_get(d, b, "printed")) != J_ARRAY) {
            CREDIT = 2;
            return 0;
        }
        if (kind(d, obj_get(d, b, "date")) != J_STRING or kind(d, obj_get(d, b, "tool")) != J_STRING) {
            CREDIT = 2;
            return 0;
        }
    }
    B_TBL = true;
    // draw()
    R_TBL = true;
    P_PR = true;
    return 0;
}

pub fn w_effect(k: u32, dst: []u8) -> u32 {
    if (k >= EF_N) {
        EF_N = 0;
        return 0;
    }
    var n : u32 = 0;
    if (EF[k as usize] == 117) {
        n = put(dst, 0, 117);
        n = raw(dst, n, "#");
        n = raw(dst, n, K_HASH_KEY);
        n = raw(dst, n, "=");
        n = put_hex(dst, n, CODE, 8, true);
    } else {
        n = put(dst, 0, 80);
        n = num(dst, n, K_CARD_WIDTH as u64);
        n = put(dst, n, 10);
        n = num(dst, n, K_CARD_HEIGHT as u64);
        n = put(dst, n, 10);
        n = raw(dst, n, ID);
        n = raw(dst, n, "-");
        n = put_hex(dst, n, CODE, 8, true);
        n = raw(dst, n, ".png");
    }
    if (n == OVER) { return 0; }
    return n;
}

// --- the page ---------------------------------------------------------------------------------------------

/// One preset button: <button type class data-code title [aria-pressed]>label</button>.
fn put_preset(o: []u8, n0: u32, label: []const u8, kid: bool, d: []const u8, label_sp: i64, value: u32, title: []const u8) -> u32 {
    var n : u32 = raw(o, n0, "<button type=\"button\" class=\"t27-btn\" data-code=\"");
    n = num(o, n, value as u64);
    n = raw(o, n, "\"");
    n = attr(o, n, "title", title);
    if (P_PR) {
        if (value == CODE) { n = raw(o, n, " aria-pressed=\"true\""); } else { n = raw(o, n, " aria-pressed=\"false\""); }
    }
    n = raw(o, n, ">");
    if (kid) { n = put_kid(o, n, d, label_sp); } else { n = text(o, n, label); }
    return raw(o, n, "</button>");
}

fn put_presets(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    var tmp : [16]u8 = [0; 16];
    const tb : u32 = hex_to(tmp[0..], K_BENCH_RAW_IDCODE, 8, true);
    n = put_preset(o, n, SAY_BENCH_PRESET, false, "", NO_SPAN, K_BENCH_RAW_IDCODE, tmp[0..(tb as usize)]);
    const tt : u32 = hex_to(tmp[0..], K_TABLE_IDCODE, 8, true);
    n = put_preset(o, n, SAY_TABLE_PRESET, false, "", NO_SPAN, K_TABLE_IDCODE, tmp[0..(tt as usize)]);
    if (!P_TBL) { return n; }
    const d : []const u8 = DATA[0..(DLEN as usize)];
    const pr : i64 = tbl(d, "presets");
    if (kind(d, pr) != J_ARRAY) { return n; }
    const hi : usize = span_hi(pr);
    var p : usize = skip_ws(d, span_lo(pr) + 1);
    while (p < hi and d[p] != 93) {
        const e : usize = value_end(d, p);
        const row : i64 = jspan(p, e);
        var vb : [8192]u8 = [0; 8192];
        var vn : u32 = jv_vput_val(vb[0..], 0, "0", d, cell(d, row, 0));
        vn = jv_vput_val(vb[0..], vn, "1", d, cell(d, row, 1));
        var title : [8192]u8 = [0; 8192];
        var tl : u32 = jv_fill_raw(title[0..], 0, SAY_PRESET_TITLE, vb[0..], vn, true);
        if (tl == OVER) { tl = 0; }
        n = put_preset(o, n, "", true, d, cell(d, row, 0), int16_of(d, cell(d, row, 2)), title[0..(tl as usize)]);
        p = skip_ws(d, e);
        if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
    }
    return n;
}

fn put_bits(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    var b : u32 = 32;
    while (b > 0) {
        b = b - 1;
        const f : u32 = field_index(b);
        const on : bool = (CODE / (pow2(b) as u32)) % 2 == 1;
        n = raw(o, n, "<button type=\"button\" class=\"idc-bit ");
        n = raw(o, n, W_FIELD_CLASS[f as usize]);
        if (b % 4 == 3 and b != 31) { n = raw(o, n, " idc-nib"); }
        if (b == 0 and !on) { n = raw(o, n, " idc-bad"); }
        n = raw(o, n, "\" data-bit=\"");
        n = num(o, n, b as u64);
        n = raw(o, n, "\"");
        var bt : [16]u8 = [0; 16];
        const bl : u32 = dec_to(bt[0..], b as u64);
        n = raw(o, n, " title=\"");
        n = fill(o, n, SAY_BIT_TITLE, bt[0..(bl as usize)], SAY_FIELD_NAMES[f as usize], "", 2);
        n = raw(o, n, "\"");
        if (on) { n = raw(o, n, " aria-pressed=\"true\"><span class=\"idc-bit-ix\">"); } else { n = raw(o, n, " aria-pressed=\"false\"><span class=\"idc-bit-ix\">"); }
        n = num(o, n, b as u64);
        n = raw(o, n, "</span><span class=\"idc-bit-v\">");
        if (on) { n = put(o, n, 49); } else { n = put(o, n, 48); }
        n = raw(o, n, "</span></button>");
    }
    return n;
}

/// A <p class=cls>...</p> whose text is fill(template, a, b, c).
fn put_line(o: []u8, n0: u32, cls: []const u8, t: []const u8, a: []const u8, b: []const u8, c: []const u8, k: u32) -> u32 {
    var n : u32 = raw(o, n0, "<p class=\"");
    n = raw(o, n, cls);
    n = raw(o, n, "\">");
    n = fill(o, n, t, a, b, c, k);
    return raw(o, n, "</p>");
}

fn put_fields_table(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<table class=\"idc-fields\"><thead><tr>");
    var h : usize = 0;
    while (h < 4) {
        n = raw(o, n, "<th scope=\"col\">");
        n = text(o, n, SAY_COL_HEAD[h]);
        n = raw(o, n, "</th>");
        h = h + 1;
    }
    n = raw(o, n, "</tr></thead><tbody>");
    var i : u32 = 0;
    while (i < 4) {
        n = raw(o, n, "<tr class=\"");
        n = raw(o, n, W_FIELD_CLASS[i as usize]);
        n = raw(o, n, "\"><th scope=\"row\">");
        n = text(o, n, SAY_FIELD_NAMES[i as usize]);
        n = raw(o, n, "</th><td>");
        n = text(o, n, SAY_FIELD_BITS[i as usize]);
        n = raw(o, n, "</td><td>");
        if (i == 3) { n = num(o, n, DV[3] as u64); } else { n = put_hex(o, n, DV[i as usize], W_FIELD_DIGITS[i as usize] as u32, true); }
        n = raw(o, n, "</td><td>");
        n = num(o, n, DV[i as usize] as u64);
        n = raw(o, n, "</td></tr>");
        i = i + 1;
    }
    return raw(o, n, "</tbody></table>");
}

/// The text of fill(template, String(v)) for a JSON value, as escaped text.
fn put_fill1(o: []u8, n0: u32, t: []const u8, d: []const u8, sp: i64) -> u32 {
    var vb : [8192]u8 = [0; 8192];
    const vn : u32 = jv_vput_val(vb[0..], 0, "0", d, sp);
    if (vn == OVER) { return OVER; }
    return jv_fill(o, n0, t, vb[0..], vn, true);
}

/// Does the String(a) lowercased contain the String(b) lowercased (ASCII).
fn lower_byte(b: u8) -> u8 {
    if (b >= 65 and b <= 90) { return b + 32; }
    return b;
}

fn contains_ci(hay: []const u8, nee: []const u8) -> bool {
    if (nee.len == 0) { return true; }
    if (nee.len > hay.len) { return false; }
    var i : usize = 0;
    while (i + nee.len <= hay.len) {
        var k : usize = 0;
        while (k < nee.len and lower_byte(hay[i + k]) == lower_byte(nee[k])) { k = k + 1; }
        if (k == nee.len) { return true; }
        i = i + 1;
    }
    return false;
}

fn put_device(o: []u8, n0: u32, d: []const u8) -> u32 {
    if (H_KIND == 0) { return n0; }
    var n : u32 = raw(o, n0, "<div class=\"idc-device\"><h3>");
    n = text(o, n, SAY_DEVICE_TITLE);
    n = raw(o, n, "</h3>");
    if (H_KIND == 3) {
        n = raw(o, n, "<p class=\"idc-line\">");
        n = text(o, n, SAY_MATCH_NONE);
        return raw(o, n, "</p></div>");
    }
    n = raw(o, n, "<p class=\"idc-line\">");
    if (H_KIND == 2) {
        n = text(o, n, SAY_MATCH_MISC);
    } else {
        if (H_MASKED) { n = put_fill1(o, n, SAY_MATCH_MASKED, d, cell(d, H_ROW, 0)); } else { n = text(o, n, SAY_MATCH_EXACT); }
    }
    n = raw(o, n, "</p><dl>");
    if (H_KIND == 1) {
        var i : u32 = 0;
        while (i < 5) {
            n = raw(o, n, "<dt>");
            n = text(o, n, SAY_DEVICE_FIELDS[i as usize]);
            n = raw(o, n, "</dt><dd>");
            if (i == 0) { n = put_kid(o, n, d, cell(d, H_ROW, 1)); }
            if (i == 1) { n = put_kid(o, n, d, cell(d, H_ROW, 2)); }
            if (i == 2) { n = put_kid(o, n, d, cell(d, H_ROW, 3)); }
            if (i == 3) { n = put_val(o, n, d, cell(d, H_ROW, 4)); }
            if (i == 4) { n = put_kid(o, n, d, cell(d, H_ROW, 0)); }
            n = raw(o, n, "</dd>");
            i = i + 1;
        }
    } else {
        var i : u32 = 0;
        while (i < 3) {
            n = raw(o, n, "<dt>");
            n = text(o, n, SAY_MISC_FIELDS[i as usize]);
            n = raw(o, n, "</dt><dd>");
            if (i == 0) { n = put_kid(o, n, d, cell(d, H_ROW, 1)); }
            if (i == 1) { n = put_val(o, n, d, cell(d, H_ROW, 2)); }
            if (i == 2) { n = put_kid(o, n, d, cell(d, H_ROW, 0)); }
            n = raw(o, n, "</dd>");
            i = i + 1;
        }
    }
    n = raw(o, n, "</dl>");
    if (H_KIND == 1) {
        // the row's own manufacturer against what its key's manufacturer bits say
        const key_mfr : u32 = field_of(H_KEY, 2);
        const named : i64 = mfr_get(d, key_mfr);
        const row1 : i64 = cell(d, H_ROW, 1);
        var bad : bool = !jv_truthy(d, named);
        if (!bad) {
            var a : [4096]u8 = [0; 4096];
            var b : [4096]u8 = [0; 4096];
            const al : u32 = str_of(a[0..], d, named);
            const bl : u32 = str_of(b[0..], d, row1);
            bad = !contains_ci(a[0..(al as usize)], b[0..(bl as usize)]);
        }
        if (bad) {
            var vb : [8192]u8 = [0; 8192];
            var vn : u32 = jv_vput_val(vb[0..], 0, "0", d, row1);
            if (present(d, named)) {
                vn = jv_vput_val(vb[0..], vn, "1", d, named);
            } else {
                var hx : [16]u8 = [0; 16];
                const hl : u32 = hex_to(hx[0..], key_mfr, 3, true);
                vn = jv_vput_str(vb[0..], vn, "1", hx[0..(hl as usize)]);
            }
            n = raw(o, n, "<p class=\"idc-line idc-warn\">");
            if (vn != OVER) { n = jv_fill(o, n, SAY_MFR_MISMATCH, vb[0..], vn, true); } else { n = OVER; }
            n = raw(o, n, "</p>");
        }
        // shadowed rows listed under this key
        const sh : i64 = tbl(d, "shadowed");
        const hi : usize = span_hi(sh);
        var p : usize = skip_ws(d, span_lo(sh) + 1);
        while (p < hi and d[p] != 93) {
            const e : usize = value_end(d, p);
            const r : i64 = jspan(p, e);
            if (int16_of(d, cell(d, r, 0)) == H_KEY) {
                n = raw(o, n, "<p class=\"idc-line idc-warn\">");
                n = put_fill1(o, n, SAY_SHADOWED, d, cell(d, r, 3));
                n = raw(o, n, "</p>");
            }
            p = skip_ws(d, e);
            if (p < hi and d[p] == 44) { p = skip_ws(d, p + 1); }
        }
    }
    return raw(o, n, "</div>");
}

/// One line of the --detect block: fill(template, String(v)) where v is already text.
fn put_detect_line(o: []u8, n0: u32, t: []const u8, v: []const u8, first: bool) -> u32 {
    var n : u32 = n0;
    if (!first) { n = put(o, n, 10); }
    return fill(o, n, t, v, "", "", 1);
}

fn put_detect(o: []u8, n0: u32, d: []const u8) -> u32 {
    if (H_KIND == 0 or CODE == K_STUCK_LOW or CODE == K_END_OF_CHAIN) { return n0; }
    var n : u32 = raw(o, n0, "<div class=\"idc-detect\"><h3>");
    n = text(o, n, SAY_DETECT_TITLE);
    n = raw(o, n, "</h3><pre>");
    var kx : [16]u8 = [0; 16];
    if (H_KIND == 1) {
        const kl : u32 = hex_to(kx[0..], H_KEY, 0, false);
        n = put_detect_line(o, n, SAY_DETECT_FPGA[0], kx[0..(kl as usize)], true);
        var i : u32 = 1;
        while (i < 5) {
            var cv : [4096]u8 = [0; 4096];
            var cl : u32 = 0;
            if (i == 1) { cl = str_of(cv[0..], d, cell(d, H_ROW, 1)); }
            if (i == 2) { cl = str_of(cv[0..], d, cell(d, H_ROW, 2)); }
            if (i == 3) { cl = str_of(cv[0..], d, cell(d, H_ROW, 3)); }
            if (i == 4) { cl = str_of(cv[0..], d, cell(d, H_ROW, 4)); }
            n = put_detect_line(o, n, SAY_DETECT_FPGA[i as usize], cv[0..(cl as usize)], false);
            i = i + 1;
        }
    }
    if (H_KIND == 2) {
        const kl : u32 = hex_to(kx[0..], H_KEY, 0, false);
        n = put_detect_line(o, n, SAY_DETECT_MISC[0], kx[0..(kl as usize)], true);
        var i : u32 = 1;
        while (i < 3) {
            var cv : [4096]u8 = [0; 4096];
            var cl : u32 = 0;
            if (i == 1) { cl = str_of(cv[0..], d, cell(d, H_ROW, 1)); }
            if (i == 2) { cl = str_of(cv[0..], d, cell(d, H_ROW, 2)); }
            n = put_detect_line(o, n, SAY_DETECT_MISC[i as usize], cv[0..(cl as usize)], false);
            i = i + 1;
        }
    }
    if (H_KIND == 3) {
        // jtag.cpp's message for an unknown code: %08x, %03x, the manufacturer name ("" when absent), IDCODE2PART as %02x, IDCODE2VERS as %x
        var vb : [8192]u8 = [0; 8192];
        var t0 : [16]u8 = [0; 16];
        var t1 : [16]u8 = [0; 16];
        var t3 : [16]u8 = [0; 16];
        var t4 : [16]u8 = [0; 16];
        const l0 : u32 = hex_to(t0[0..], CODE, 8, false);
        const l1 : u32 = hex_to(t1[0..], D_MFR, 3, false);
        const part7 : u32 = ((CODE as u64) / pow2(21) % 128) as u32;
        const l3 : u32 = hex_to(t3[0..], part7, 2, false);
        const l4 : u32 = hex_to(t4[0..], DV[0], 0, false);
        var vn : u32 = jv_vput_str(vb[0..], 0, "0", t0[0..(l0 as usize)]);
        vn = jv_vput_str(vb[0..], vn, "1", t1[0..(l1 as usize)]);
        if (D_NAME != NO_SPAN) { vn = jv_vput_val(vb[0..], vn, "2", d, D_NAME); } else { vn = jv_vput_str(vb[0..], vn, "2", ""); }
        vn = jv_vput_str(vb[0..], vn, "3", t3[0..(l3 as usize)]);
        vn = jv_vput_str(vb[0..], vn, "4", t4[0..(l4 as usize)]);
        if (vn != OVER) { n = jv_fill(o, n, SAY_DETECT_NONE, vb[0..], vn, true); } else { n = OVER; }
    }
    n = raw(o, n, "</pre><p class=\"idc-line idc-muted\">");
    n = text(o, n, SAY_DETECT_NOTE);
    return raw(o, n, "</p></div>");
}

/// draw(): the result card for the code, with the table when the page had it at the last repaint.
fn put_result(o: []u8, n0: u32) -> u32 {
    do_lookup(CODE, R_TBL);
    decode(CODE, R_TBL);
    const d : []const u8 = DATA[0..(DLEN as usize)];
    var n : u32 = raw(o, n0, "<div class=\"idc-card-head\"><p class=\"idc-big\">");
    n = put_hex(o, n, CODE, 8, true);
    n = raw(o, n, "</p><p class=\"idc-model\">");
    if (H_KIND == 1) {
        n = put_val(o, n, d, cell(d, H_ROW, 3));
        n = put(o, n, 32);
        n = put(o, n, 194);
        n = put(o, n, 183);
        n = put(o, n, 32);
        n = put_val(o, n, d, cell(d, H_ROW, 2));
    }
    if (H_KIND == 2) { n = put_kid(o, n, d, cell(d, H_ROW, 1)); }
    if (H_KIND == 3) { n = text(o, n, SAY_CARD_NONE); }
    n = raw(o, n, "</p></div>");
    n = put_fields_table(o, n);
    var bank : [16]u8 = [0; 16];
    var cont : [16]u8 = [0; 16];
    var idh : [16]u8 = [0; 16];
    const bl : u32 = dec_to(bank[0..], (D_CONT + 1) as u64);
    const cl : u32 = dec_to(cont[0..], D_CONT as u64);
    const il : u32 = hex_to(idh[0..], D_ID, 2, true);
    n = put_line(o, n, "idc-line idc-f-mfr", SAY_BANK_LINE, bank[0..(bl as usize)], cont[0..(cl as usize)], idh[0..(il as usize)], 3);
    if (D_NAME != NO_SPAN and jv_truthy(d, D_NAME)) {
        n = raw(o, n, "<p class=\"idc-line\">");
        n = put_fill1(o, n, SAY_MFR_KNOWN, d, D_NAME);
        n = raw(o, n, "</p>");
    } else {
        n = put_line(o, n, "idc-line", SAY_MFR_UNKNOWN, bank[0..(bl as usize)], idh[0..(il as usize)], "", 2);
    }
    if (DV[3] == 1) {
        n = put_line(o, n, "idc-line idc-ok", SAY_BIT0_OK, "", "", "", 0);
    } else {
        var sh : [16]u8 = [0; 16];
        const sl : u32 = hex_to(sh[0..], CODE / 2, 8, true);
        n = put_line(o, n, "idc-line idc-warn", SAY_BIT0_BAD, sh[0..(sl as usize)], "", "", 1);
    }
    if (CODE == K_STUCK_LOW) { n = put_line(o, n, "idc-line idc-warn", SAY_STUCK_LOW, "", "", "", 0); }
    if (CODE != K_STUCK_LOW and CODE == K_END_OF_CHAIN) { n = put_line(o, n, "idc-line idc-warn", SAY_END_OF_CHAIN, "", "", "", 0); }
    n = put_device(o, n, d);
    n = put_detect(o, n, d);
    return n;
}

/// drawBench(): the heading, the bench line once the table has said what it was, and the earlier boards.
fn put_bench(o: []u8, n0: u32) -> u32 {
    var n : u32 = raw(o, n0, "<h3>");
    n = text(o, n, SAY_BENCH_TITLE);
    n = raw(o, n, "</h3>");
    if (B_TBL) {
        const d : []const u8 = DATA[0..(DLEN as usize)];
        const b : i64 = tbl(d, "bench");
        if (jv_truthy(d, b)) {
            const raw_v : u32 = int16_of(d, arr_at(d, obj_get(d, b, "raw"), 0));
            const printed : u32 = int16_of(d, arr_at(d, obj_get(d, b, "printed"), 0));
            var vb : [8192]u8 = [0; 8192];
            // date.replace('T', ' '): the first T only
            var date : [4096]u8 = [0; 4096];
            const dl : u32 = str_of(date[0..], d, obj_get(d, b, "date"));
            var di : u32 = 0;
            var done : bool = false;
            while (di < dl) {
                if (!done and date[di as usize] == 84) {
                    date[di as usize] = 32;
                    done = true;
                }
                di = di + 1;
            }
            var vn : u32 = jv_vput_str(vb[0..], 0, "0", date[0..(dl as usize)]);
            var h8 : [16]u8 = [0; 16];
            const hl : u32 = hex_to(h8[0..], raw_v, 8, true);
            vn = jv_vput_str(vb[0..], vn, "1", h8[0..(hl as usize)]);
            var ver : [16]u8 = [0; 16];
            const vl : u32 = dec_to(ver[0..], (raw_v / 268435456) as u64);
            vn = jv_vput_str(vb[0..], vn, "2", ver[0..(vl as usize)]);
            // tool.replace(/^openFPGALoader\s*/, '')
            var tool : [4096]u8 = [0; 4096];
            const tl : u32 = str_of(tool[0..], d, obj_get(d, b, "tool"));
            var ts : u32 = 0;
            const pre : []const u8 = "openFPGALoader";
            var same : bool = tl >= (pre.len as u32);
            var pk : usize = 0;
            while (same and pk < pre.len) {
                if (tool[pk] != pre[pk]) { same = false; }
                pk = pk + 1;
            }
            if (same) {
                ts = pre.len as u32;
                while (ts < tl) {
                    const w : u32 = jv_ws_at(tool[0..(tl as usize)], ts, tl);
                    if (w == 0) { break; }
                    ts = ts + w;
                }
            }
            vn = jv_vput_str(vb[0..], vn, "3", tool[(ts as usize)..(tl as usize)]);
            var pt : [24]u8 = [0; 24];
            pt[0] = 48;
            pt[1] = 120;
            const pl : u32 = put_hex(pt[0..], 2, printed, 0, false);
            vn = jv_vput_str(vb[0..], vn, "4", pt[0..(pl as usize)]);
            n = raw(o, n, "<p class=\"idc-line\">");
            if (vn != OVER) { n = jv_fill(o, n, SAY_BENCH_LINE, vb[0..], vn, true); } else { n = OVER; }
            n = raw(o, n, "</p>");
        }
    }
    n = raw(o, n, "<p class=\"idc-line idc-muted\">");
    var c3 : [8]u8 = [0; 8];
    const cl3 : u32 = dec_to(c3[0..], K_BENCH_BOARDS_2026_08_17 as u64);
    n = fill(o, n, SAY_BENCH_EARLIER, c3[0..(cl3 as usize)], "", "", 1);
    return raw(o, n, "</p>");
}

fn put_credit(o: []u8, n0: u32) -> u32 {
    if (CREDIT == 0) { return text(o, n0, SAY_LOADING); }
    if (CREDIT == 2) { return text(o, n0, SAY_LOAD_FAILED); }
    const d : []const u8 = DATA[0..(DLEN as usize)];
    const src : i64 = tbl(d, "source");
    var vb : [8192]u8 = [0; 8192];
    var vn : u32 = jv_vput_val(vb[0..], 0, "0", d, obj_get(d, src, "tag"));
    var cm : [64]u8 = [0; 64];
    const cl : u32 = commit12(cm[0..], d, obj_get(d, src, "commit"));
    vn = jv_vput_str(vb[0..], vn, "1", cm[0..(cl as usize)]);
    var c2 : [16]u8 = [0; 16];
    var l2 : u32 = dec_to(c2[0..], arr_len(d, tbl(d, "fpga")) as u64);
    vn = jv_vput_str(vb[0..], vn, "2", c2[0..(l2 as usize)]);
    l2 = dec_to(c2[0..], arr_len(d, tbl(d, "misc")) as u64);
    vn = jv_vput_str(vb[0..], vn, "3", c2[0..(l2 as usize)]);
    l2 = dec_to(c2[0..], arr_len(d, tbl(d, "manufacturers")) as u64);
    vn = jv_vput_str(vb[0..], vn, "4", c2[0..(l2 as usize)]);
    if (vn == OVER) { return OVER; }
    return jv_fill(o, n0, SAY_CREDIT, vb[0..], vn, true);
}

pub fn w_render(dst: []u8) -> u32 {
    var n : u32 = raw(dst, 0, "<div class=\"idc-form\"><label class=\"idc-label\" for=\"idc-input\">");
    n = text(dst, n, SAY_INPUT_LABEL);
    n = raw(dst, n, "</label><input id=\"idc-input\" class=\"idc-input\" type=\"text\" inputmode=\"text\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\"");
    n = attr(dst, n, "placeholder", SAY_INPUT_PLACEHOLDER);
    n = raw(dst, n, "><p class=\"idc-msg\" role=\"status\">");
    if (MSG == 1) { n = text(dst, n, SAY_BAD_INPUT); }
    n = raw(dst, n, "</p></div><div class=\"idc-presets-row\"><span class=\"idc-label\">");
    n = text(dst, n, SAY_PRESETS_LABEL);
    n = raw(dst, n, "</span><div class=\"idc-presets\">");
    n = put_presets(dst, n);
    n = raw(dst, n, "</div></div><p class=\"idc-hint\">");
    n = text(dst, n, SAY_BITS_LABEL);
    n = raw(dst, n, "</p><div class=\"idc-bits\" role=\"group\"");
    n = attr(dst, n, "aria-label", SAY_BITS_LABEL);
    n = raw(dst, n, ">");
    n = put_bits(dst, n);
    n = raw(dst, n, "</div><div class=\"idc-legend\">");
    var i : u32 = 0;
    while (i < 4) {
        n = raw(dst, n, "<span class=\"idc-chip ");
        n = raw(dst, n, W_FIELD_CLASS[i as usize]);
        n = raw(dst, n, "\">");
        n = text(dst, n, SAY_FIELD_NAMES[i as usize]);
        n = raw(dst, n, " ");
        n = text(dst, n, SAY_FIELD_BITS[i as usize]);
        n = raw(dst, n, "</span>");
        i = i + 1;
    }
    n = raw(dst, n, "</div><section class=\"idc-card\" aria-live=\"polite\">");
    n = put_result(dst, n);
    n = raw(dst, n, "</section><div class=\"idc-share\"><button type=\"button\" class=\"t27-btn\">");
    n = text(dst, n, SAY_COPY_LINK);
    n = raw(dst, n, "</button><button type=\"button\" class=\"t27-btn\">");
    n = text(dst, n, SAY_SAVE_CARD);
    n = raw(dst, n, "</button><span class=\"idc-share-msg\" role=\"status\">");
    if (SHARE == 1) { n = text(dst, n, SAY_COPIED); }
    if (SHARE == 2) { n = text(dst, n, SAY_COPY_FAILED); }
    n = raw(dst, n, "</span></div><section class=\"idc-bench\">");
    n = put_bench(dst, n);
    n = raw(dst, n, "</section><p class=\"idc-credit\">");
    n = put_credit(dst, n);
    n = raw(dst, n, "</p>");
    if (n == OVER) { return 0; }
    return n;
}

// --- the card the reader can save: a binary draw list (see the header) --------------------------------------

fn bw_b(o: []u8, n: u32, b: u8) -> u32 {
    if (n == OVER or (n as usize) >= o.len) { return OVER; }
    o[n as usize] = b;
    return n + 1;
}

/// The IEEE 754 bits of a finite double (no subnormals, no NaN).
fn f64_bits(x: f64) -> u64 {
    if (x == 0.0) {
        if ((1.0 / x) < 0.0) { return 9223372036854775808; }
        return 0;
    }
    var sign : u64 = 0;
    var ax : f64 = x;
    if (x < 0.0) {
        sign = 9223372036854775808;
        ax = 0.0 - x;
    }
    const m : u64 = jn_mant(ax);
    const e : i32 = jn_expo(ax);
    const be : u64 = ((e + 52 + 1023) as u64);
    return sign + be * 4503599627370496 + (m - 4503599627370496);
}

fn bw_f(o: []u8, n0: u32, x: f64) -> u32 {
    var bits : u64 = f64_bits(x);
    var n : u32 = n0;
    var k : u32 = 0;
    while (k < 8) {
        n = bw_b(o, n, (bits % 256) as u8);
        bits = bits / 256;
        k = k + 1;
    }
    return n;
}

/// A string: u16 length, then the bytes.
fn bw_s(o: []u8, n0: u32, s: []const u8) -> u32 {
    var n : u32 = bw_b(o, n0, (s.len % 256) as u8);
    n = bw_b(o, n, ((s.len / 256) % 256) as u8);
    var k : usize = 0;
    while (k < s.len) {
        n = bw_b(o, n, s[k]);
        k = k + 1;
    }
    return n;
}

fn bw_len(o: []u8, n0: u32, len: u32) -> u32 {
    const n : u32 = bw_b(o, n0, (len % 256) as u8);
    return bw_b(o, n, ((len / 256) % 256) as u8);
}

fn bw_raw(o: []u8, n0: u32, s: []const u8) -> u32 {
    var n : u32 = n0;
    var k : usize = 0;
    while (k < s.len) {
        n = bw_b(o, n, s[k]);
        k = k + 1;
    }
    return n;
}

/// The bytes of a CSS variable with a fallback: 1, name, 2, fallback, 3.
fn bw_varbytes(o: []u8, n0: u32, name: []const u8, fb: []const u8) -> u32 {
    var n : u32 = bw_b(o, n0, 1);
    n = bw_raw(o, n, name);
    n = bw_b(o, n, 2);
    n = bw_raw(o, n, fb);
    return bw_b(o, n, 3);
}

/// A colour property (op 32 fillStyle, 33 strokeStyle) set to a CSS variable with its fallback.
fn bw_color(o: []u8, n0: u32, op: u8, name: []const u8, fb: []const u8) -> u32 {
    var n : u32 = bw_b(o, n0, op);
    n = bw_len(o, n, (name.len as u32) + (fb.len as u32) + 3);
    return bw_varbytes(o, n, name, fb);
}

/// A property set to a plain string.
fn bw_set_s(o: []u8, n0: u32, op: u8, v: []const u8) -> u32 {
    const n : u32 = bw_b(o, n0, op);
    return bw_s(o, n, v);
}

/// g.font = `${weight}${px}px ${mono}`: prefix is "700 26px ".
fn bw_font(o: []u8, n0: u32, prefix: []const u8) -> u32 {
    var n : u32 = bw_b(o, n0, 35);
    n = bw_len(o, n, (prefix.len as u32) + (W_MONO_VAR.len as u32) + (W_MONO_FB.len as u32) + 3);
    n = bw_raw(o, n, prefix);
    return bw_varbytes(o, n, W_MONO_VAR, W_MONO_FB);
}

fn bw_set_f(o: []u8, n0: u32, op: u8, v: f64) -> u32 {
    const n : u32 = bw_b(o, n0, op);
    return bw_f(o, n, v);
}

fn bw_rect(o: []u8, n0: u32, op: u8, a: f64, b: f64, c: f64, d: f64) -> u32 {
    var n : u32 = bw_b(o, n0, op);
    n = bw_f(o, n, a);
    n = bw_f(o, n, b);
    n = bw_f(o, n, c);
    return bw_f(o, n, d);
}

fn bw_pt(o: []u8, n0: u32, op: u8, x: f64, y: f64) -> u32 {
    var n : u32 = bw_b(o, n0, op);
    n = bw_f(o, n, x);
    return bw_f(o, n, y);
}

fn bw_text(o: []u8, n0: u32, s: []const u8, x: f64, y: f64) -> u32 {
    var n : u32 = bw_b(o, n0, 13);
    n = bw_s(o, n, s);
    n = bw_f(o, n, x);
    return bw_f(o, n, y);
}

/// The colour of field f: version gold, part number green, manufacturer blue, the fixed 1 text.
fn bw_field_color(o: []u8, n0: u32, op: u8, f: u32) -> u32 {
    if (f == 0) { return bw_color(o, n0, op, W_GOLD_VAR, W_GOLD_FB); }
    if (f == 1) { return bw_color(o, n0, op, W_GREEN_VAR, W_GREEN_FB); }
    if (f == 2) { return bw_set_s(o, n0, op, W_BLUE); }
    return bw_color(o, n0, op, W_TEXT_VAR, W_TEXT_FB);
}

/// SAY_CARD_BRAND with its first word-bounded S3AI written S, superscript three, AI.
fn brand_to(o: []u8, n0: u32, s: []const u8) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    var done : bool = false;
    while (i < s.len) {
        if (!done and i + 4 <= s.len and s[i] == 83 and s[i + 1] == 51 and s[i + 2] == 65 and s[i + 3] == 73) {
            const before : bool = i == 0 or !is_word_byte(s[i - 1]);
            const after : bool = i + 4 == s.len or !is_word_byte(s[i + 4]);
            if (before and after) {
                n = put(o, n, 83);
                n = put(o, n, 194);
                n = put(o, n, 179);
                n = put(o, n, 65);
                n = put(o, n, 73);
                i = i + 4;
                done = true;
            } else {
                n = put(o, n, s[i]);
                i = i + 1;
            }
        } else {
            n = put(o, n, s[i]);
            i = i + 1;
        }
    }
    return n;
}

/// The card: what tool.js's saveCard() draws on its 1200x630 canvas, call for call.
pub fn w_bdraw2(o: []u8) -> u32 {
    const wd : f64 = K_CARD_WIDTH as f64;
    const ht : f64 = K_CARD_HEIGHT as f64;
    const use_table : bool = TBL;
    do_lookup(CODE, use_table);
    decode(CODE, use_table);
    const d : []const u8 = DATA[0..(DLEN as usize)];
    var n : u32 = bw_set_s(o, 0, 32, "#000");
    n = bw_rect(o, n, 10, 0.0, 0.0, wd, ht);
    n = bw_color(o, n, 32, W_GREEN_VAR, W_GREEN_FB);
    n = bw_font(o, n, "700 26px ");
    n = bw_set_s(o, n, 36, "top");
    n = bw_b(o, n, 1);
    n = bw_pt(o, n, 7, 60.0, 52.0);
    n = bw_pt(o, n, 8, 84.0, 52.0);
    n = bw_pt(o, n, 8, 72.0, 72.0);
    n = bw_b(o, n, 2);
    n = bw_b(o, n, 3);
    var brand : [128]u8 = [0; 128];
    const bl : u32 = brand_to(brand[0..], 0, SAY_CARD_BRAND);
    n = bw_text(o, n, brand[0..(bl as usize)], 98.0, 48.0);
    n = bw_set_s(o, n, 37, "right");
    n = bw_color(o, n, 32, W_MUTED_VAR, W_MUTED_FB);
    n = bw_font(o, n, "22px ");
    n = bw_text(o, n, SAY_CARD_TITLE, wd - 60.0, 52.0);
    n = bw_set_s(o, n, 37, "left");
    n = bw_set_s(o, n, 32, "#fff");
    n = bw_font(o, n, "800 92px ");
    var hx : [16]u8 = [0; 16];
    const hl : u32 = hex_to(hx[0..], CODE, 8, true);
    n = bw_text(o, n, hx[0..(hl as usize)], 60.0, 104.0);
    // the model line
    var model : [8192]u8 = [0; 8192];
    var ml : u32 = 0;
    if (H_KIND == 1) {
        var t : [4096]u8 = [0; 4096];
        var tl : u32 = str_of(t[0..], d, cell(d, H_ROW, 3));
        ml = jn_raw(model[0..], 0, t[0..(tl as usize)]);
        ml = put(model[0..], ml, 32);
        ml = put(model[0..], ml, 194);
        ml = put(model[0..], ml, 183);
        ml = put(model[0..], ml, 32);
        tl = str_of(t[0..], d, cell(d, H_ROW, 2));
        ml = jn_raw(model[0..], ml, t[0..(tl as usize)]);
        ml = put(model[0..], ml, 32);
        ml = put(model[0..], ml, 194);
        ml = put(model[0..], ml, 183);
        ml = put(model[0..], ml, 32);
        ml = jn_raw(model[0..], ml, SAY_DEVICE_FIELDS[3]);
        ml = put(model[0..], ml, 32);
        tl = str_of(t[0..], d, cell(d, H_ROW, 4));
        ml = jn_raw(model[0..], ml, t[0..(tl as usize)]);
    }
    if (H_KIND == 2) { ml = str_of(model[0..], d, cell(d, H_ROW, 1)); }
    if (H_KIND == 0 or H_KIND == 3) { ml = jn_raw(model[0..], 0, SAY_CARD_NONE); }
    if (H_KIND != 0 and H_KIND != 3) {
        n = bw_color(o, n, 32, W_GREEN_VAR, W_GREEN_FB);
    } else {
        n = bw_color(o, n, 32, W_MUTED_VAR, W_MUTED_FB);
    }
    n = bw_font(o, n, "700 30px ");
    n = bw_text(o, n, model[0..(ml as usize)], 60.0, 214.0);
    // 32 bit cells
    const x0 : f64 = 60.0;
    const cw : f64 = (wd - 120.0) / 32.0;
    const y0 : f64 = 290.0;
    const ch : f64 = 70.0;
    var b : u32 = 32;
    while (b > 0) {
        b = b - 1;
        const i : u32 = 31 - b;
        const f : u32 = field_index(b);
        const on : bool = (CODE / (pow2(b) as u32)) % 2 == 1;
        const x : f64 = x0 + (i as f64) * cw;
        if (on) { n = bw_field_color(o, n, 32, f); } else { n = bw_set_s(o, n, 32, "#0b1210"); }
        if (on) { n = bw_set_f(o, n, 38, 0.9); } else { n = bw_set_f(o, n, 38, 1.0); }
        n = bw_rect(o, n, 10, x + 2.0, y0, cw - 4.0, ch);
        n = bw_set_f(o, n, 38, 1.0);
        if (b == 0 and !on) { n = bw_color(o, n, 33, W_RED_VAR, W_RED_FB); } else { n = bw_field_color(o, n, 33, f); }
        n = bw_set_f(o, n, 34, 2.0);
        n = bw_rect(o, n, 11, x + 2.0, y0, cw - 4.0, ch);
        if (on) { n = bw_set_s(o, n, 32, "#000"); } else { n = bw_field_color(o, n, 32, f); }
        n = bw_font(o, n, "700 28px ");
        n = bw_set_s(o, n, 37, "center");
        if (on) { n = bw_text(o, n, "1", x + cw / 2.0, y0 + 20.0); } else { n = bw_text(o, n, "0", x + cw / 2.0, y0 + 20.0); }
        n = bw_color(o, n, 32, W_MUTED_VAR, W_MUTED_FB);
        n = bw_font(o, n, "14px ");
        var bt : [8]u8 = [0; 8];
        const btl : u32 = dec_to(bt[0..], b as u64);
        n = bw_text(o, n, bt[0..(btl as usize)], x + cw / 2.0, y0 + ch + 8.0);
    }
    // field captions under their bits
    var f : u32 = 0;
    while (f < 4) {
        const lsb : f64 = (K_FIELD_LSB[f as usize] as u32) as f64;
        const wdt : f64 = (K_FIELD_WIDTH[f as usize] as u32) as f64;
        const left : f64 = x0 + (31.0 - (lsb + wdt - 1.0)) * cw;
        const right : f64 = x0 + (32.0 - lsb) * cw;
        n = bw_field_color(o, n, 33, f);
        n = bw_set_f(o, n, 34, 2.0);
        n = bw_b(o, n, 1);
        n = bw_pt(o, n, 7, left + 4.0, y0 + ch + 34.0);
        n = bw_pt(o, n, 8, right - 4.0, y0 + ch + 34.0);
        n = bw_b(o, n, 4);
        if (f == 3) { n = bw_set_s(o, n, 37, "right"); } else { n = bw_set_s(o, n, 37, "center"); }
        var cx : f64 = (left + right) / 2.0;
        if (f == 3) { cx = right; }
        n = bw_field_color(o, n, 32, f);
        n = bw_font(o, n, "700 22px ");
        var cap : [16]u8 = [0; 16];
        var cl : u32 = 0;
        if (f == 3) { cl = dec_to(cap[0..], DV[3] as u64); } else { cl = hex_to(cap[0..], DV[f as usize], W_FIELD_DIGITS[f as usize] as u32, true); }
        n = bw_text(o, n, cap[0..(cl as usize)], cx, y0 + ch + 44.0);
        n = bw_color(o, n, 32, W_MUTED_VAR, W_MUTED_FB);
        n = bw_font(o, n, "16px ");
        if (f != 3) { n = bw_text(o, n, SAY_FIELD_NAMES[f as usize], cx, y0 + ch + 72.0); }
        f = f + 1;
    }
    n = bw_set_s(o, n, 37, "left");
    n = bw_color(o, n, 32, W_TEXT_VAR, W_TEXT_FB);
    n = bw_font(o, n, "22px ");
    // fill(SAY_BANK_LINE, bank, cont, hexN(id, 2)) and the manufacturer name
    var line : [8192]u8 = [0; 8192];
    var bankv : [16]u8 = [0; 16];
    var contv : [16]u8 = [0; 16];
    var idv : [16]u8 = [0; 16];
    const bkl : u32 = dec_to(bankv[0..], (D_CONT + 1) as u64);
    const cnl : u32 = dec_to(contv[0..], D_CONT as u64);
    const idl : u32 = hex_to(idv[0..], D_ID, 2, true);
    var ll : u32 = fill_raw3(line[0..], 0, SAY_BANK_LINE, bankv[0..(bkl as usize)], contv[0..(cnl as usize)], idv[0..(idl as usize)], 3);
    if (D_NAME != NO_SPAN and jv_truthy(d, D_NAME)) {
        ll = put(line[0..], ll, 32);
        ll = put(line[0..], ll, 194);
        ll = put(line[0..], ll, 183);
        ll = put(line[0..], ll, 32);
        var nm : [4096]u8 = [0; 4096];
        const nl : u32 = str_of(nm[0..], d, D_NAME);
        ll = jn_raw(line[0..], ll, nm[0..(nl as usize)]);
    }
    n = bw_text(o, n, line[0..(ll as usize)], 60.0, 500.0);
    if (DV[3] == 1) { n = bw_color(o, n, 32, W_MUTED_VAR, W_MUTED_FB); } else { n = bw_color(o, n, 32, W_RED_VAR, W_RED_FB); }
    n = bw_font(o, n, "18px ");
    var b0 : [8192]u8 = [0; 8192];
    var b0l : u32 = 0;
    if (DV[3] == 1) {
        b0l = jn_raw(b0[0..], 0, SAY_BIT0_OK);
    } else {
        var sh : [16]u8 = [0; 16];
        const shl : u32 = hex_to(sh[0..], CODE / 2, 8, true);
        b0l = fill_raw3(b0[0..], 0, SAY_BIT0_BAD, sh[0..(shl as usize)], "", "", 1);
    }
    if (b0l > 92) {
        b0l = 89;
        b0l = jn_raw(b0[0..], b0l, "...");
    }
    n = bw_text(o, n, b0[0..(b0l as usize)], 60.0, 534.0);
    n = bw_color(o, n, 32, W_GREEN_VAR, W_GREEN_FB);
    n = bw_font(o, n, "20px ");
    var url : [256]u8 = [0; 256];
    const ul : u32 = fill_raw3(url[0..], 0, SAY_CARD_URL, hx[0..(hl as usize)], "", "", 1);
    n = bw_text(o, n, url[0..(ul as usize)], 60.0, 580.0);
    if (n == OVER) { return 0; }
    return n;
}

/// fill(template, a, b, c) as plain bytes: {0} {1} {2} replaced by the first k values, other braces as written.
fn fill_raw3(o: []u8, n0: u32, t: []const u8, a: []const u8, b: []const u8, c: []const u8, k: u32) -> u32 {
    var n : u32 = n0;
    var i : usize = 0;
    while (i < t.len) {
        if (t[i] == 123 and i + 2 < t.len and t[i + 2] == 125 and t[i + 1] >= 48 and t[i + 1] <= 50 and ((t[i + 1] - 48) as u32) < k) {
            const w : u8 = t[i + 1] - 48;
            if (w == 0) { n = jn_raw(o, n, a); }
            if (w == 1) { n = jn_raw(o, n, b); }
            if (w == 2) { n = jn_raw(o, n, c); }
            i = i + 3;
        } else {
            n = put(o, n, t[i]);
            i = i + 1;
        }
    }
    return n;
}

pub fn same_text(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// --- Tests of the native page ---------------------------------------------------------------------------------

pub const W_TEST_DATA : str = "{\"source\":{\"tag\":\"v1\",\"commit\":\"0123456789abcdef\"},\"fpga\":[[\"0x03636093\",\"xilinx\",\"artix a7 200t\",\"xc7a200\",6]],\"misc\":[[\"0x4ba00477\",\"ARM\",4]],\"manufacturers\":[[\"0x049\",\"Xilinx\"]],\"shadowed\":[],\"presets\":[[\"board\",\"part\",\"0x0362d093\"]],\"bench\":{\"date\":\"2026-10-04T17:28Z\",\"tool\":\"openFPGALoader v1.1.1\",\"raw\":[\"0x13636093\"],\"printed\":[\"0x03636093\"]}}";

fn w_has(o: []const u8, n: u32, want: []const u8) -> bool {
    if (want.len > (n as usize)) { return false; }
    var i : usize = 0;
    while (i + want.len <= (n as usize)) {
        var k : usize = 0;
        while (k < want.len and o[i + k] == want[k]) { k = k + 1; }
        if (k == want.len) { return true; }
        i = i + 1;
    }
    return false;
}

test parse_code_reads_what_tool_js_reads {
    assert parse_code("0x13636093") == 325279891;
    assert parse_code("0 -> 0x13636093") == 325279891;
    assert parse_code("-> 0xffffffff -> 0x5") == 5;
    assert parse_code("abc 0x12zz 0x34") == 52;
    assert parse_code("0x123456789") == -1;
    assert parse_code(" 12_34 ") == 4660;
    assert parse_code("") == -1;
    assert parse_code("0xffffffff") == 4294967295;
    assert parse_code("zz") == -1;
    assert parse_code("0x") == -1;
    assert parse_code("10x12") == 18;
}

test parse_int16_is_parseInt_16_unsigned {
    assert parse_int16(" 0x1f") == 31;
    assert parse_int16("-1") == 4294967295;
    assert parse_int16("zz") == 0;
    assert parse_int16("1ffffffff") == 4294967295;
    assert parse_int16("false") == 250;
    assert parse_int16("0x04014c35") == 67193909;
    assert parse_int16("+0x1") == 1;
}

test the_address_is_read_the_way_tool_js_reads_it {
    assert code_from_hash("#id=0x13636093") == 325279891;
    assert code_from_hash("#x=1&id=5") == 5;
    assert code_from_hash("#id=") == -1;
    assert code_from_hash("#id=%30x5") == 5;
    assert code_from_hash("#id=%zz") == -1;
    assert code_from_hash("") == -1;
    assert code_from_hash("#id=&id=0x7") == 7;
}

test the_page_opens_on_the_table_key_before_the_table_arrives {
    w_init("");
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert n > 4000;
    assert w_has(o[0..], n, "<p class=\"idc-big\">0x03636093</p><p class=\"idc-model\"></p>");
    assert w_has(o[0..], n, "<button type=\"button\" class=\"idc-bit idc-f-ver\" data-bit=\"31\" title=\"bit 31: version\" aria-pressed=\"false\">");
    assert w_has(o[0..], n, "<p class=\"idc-credit\">Reading openFPGALoader&#39;s device table</p>");
    assert !w_has(o[0..], n, "idc-device");
    var v : [64]u8 = [0; 64];
    assert w_value(0, v[0..]) == 10;
    assert w_value(0, v[0..]) == 4294967295;
    assert w_value(1, v[0..]) == 4294967295;
    var h : [64]u8 = [0; 64];
    const hn : u32 = w_hash_out(h[0..]);
    assert hn == 15;
    assert h[0] == 1;
    assert w_hash_out(h[0..]) == 0;
}

test the_table_names_the_device_the_manufacturer_and_the_bench {
    w_init("");
    w_data(0, W_TEST_DATA);
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert w_has(o[0..], n, "xc7a200");
    assert w_has(o[0..], n, "artix a7 200t");
    assert w_has(o[0..], n, "<pre>idcode 0x3636093\nmanufacturer xilinx\nfamily artix a7 200t\nmodel  xc7a200\nirlength 6</pre>");
    assert w_has(o[0..], n, "<p class=\"idc-line\">Xilinx in openFPGALoader&#39;s manufacturer list</p>");
    assert w_has(o[0..], n, "<p class=\"idc-line\">In openFPGALoader v1.1.1&#39;s table as written.</p>");
    assert w_has(o[0..], n, "2026-10-04 17:28Z: one QMTech Wukong V1 shifted out 0x13636093 (version 1); openFPGALoader v1.1.1 --detect printed 0x3636093.");
    assert w_has(o[0..], n, "openFPGALoader v1, commit 0123456789ab, Apache-2.0, Copyright (C) 2019 Gwenhael Goavec-Merou. 1 FPGA rows, 1 other TAPs, 1 manufacturer codes.");
    assert w_has(o[0..], n, "title=\"openFPGALoader board board: part part\" aria-pressed=\"false\">board</button>");
    assert w_has(o[0..], n, "data-code=\"56844435\" title=\"0x03636093\" aria-pressed=\"true\">our bench, as printed</button>");
}

test a_masked_version_is_found_and_said_so {
    w_init("");
    w_data(0, W_TEST_DATA);
    w_input(0, "0x13636093");
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert w_has(o[0..], n, "<p class=\"idc-line\">In openFPGALoader v1.1.1&#39;s table after the version is masked to 0, as openFPGALoader does: key 0x03636093.</p>");
    assert w_has(o[0..], n, "<p class=\"idc-big\">0x13636093</p>");
}

test an_unknown_code_prints_what_jtag_cpp_prints {
    w_init("");
    w_data(0, W_TEST_DATA);
    w_input(0, "0x12345679");
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert w_has(o[0..], n, "Unknown device with IDCODE: 0x12345679 (manufacturer: 0x33c (), part: 0x11 vers: 0x1");
    assert w_has(o[0..], n, "Not in openFPGALoader v1.1.1&#39;s table, with or without the version.");
    assert w_has(o[0..], n, "not in openFPGALoader&#39;s manufacturer list: look up bank 7, code 0x3c in JEDEC JEP106");
}

test a_bit_flips_and_the_address_follows {
    w_init("");
    w_data(0, W_TEST_DATA);
    assert preset_count() == 3;
    w_click(3);
    assert CODE == 2204328083;
    var h : [64]u8 = [0; 64];
    assert w_hash_out(h[0..]) == 15;
    assert h[1] == 35;
    assert h[14] == 51;
    w_click(3 + 31);
    assert CODE == 2204328082;
    var o : [65536]u8 = [0; 65536];
    const n : u32 = w_render(o[0..]);
    assert w_has(o[0..], n, "idc-bit idc-f-one idc-bad\" data-bit=\"0\"");
    assert w_has(o[0..], n, "Bit 0 is 0: not an IDCODE.");
}

test a_bad_input_says_so_and_a_good_one_clears_it {
    w_init("");
    w_input(0, "zz");
    var o : [65536]u8 = [0; 65536];
    var n : u32 = w_render(o[0..]);
    assert w_has(o[0..], n, "<p class=\"idc-msg\" role=\"status\">No IDCODE here: type up to eight hex digits, like 0x03636093.</p>");
    w_input(0, "  ");
    n = w_render(o[0..]);
    assert w_has(o[0..], n, "<p class=\"idc-msg\" role=\"status\"></p>");
    w_input(0, "0x5");
    assert CODE == 5;
}

test copy_and_save_ask_the_host_for_effects {
    w_init("");
    w_click(2 + 32);
    var e : [128]u8 = [0; 128];
    var n : u32 = w_effect(0, e[0..]);
    assert n == 15;
    assert e[0] == 117;
    assert w_effect(1, e[0..]) == 0;
    w_click(2 + 33);
    n = w_effect(0, e[0..]);
    assert e[0] == 80;
    assert w_has(e[0..], n, "1200\n630\nidcode-0x03636093.png");
    assert w_effect(1, e[0..]) == 0;
    w_copied(1);
    var o : [65536]u8 = [0; 65536];
    const rn : u32 = w_render(o[0..]);
    assert w_has(o[0..], rn, "<span class=\"idc-share-msg\" role=\"status\">Link copied</span>");
    w_copied(0);
    const rn2 : u32 = w_render(o[0..]);
    assert w_has(o[0..], rn2, ">Copy it from the address bar</span>");
}

test the_card_is_a_binary_draw_list_with_css_variables_in_it {
    w_init("");
    w_data(0, W_TEST_DATA);
    var o : [16384]u8 = [0; 16384];
    const n : u32 = w_bdraw2(o[0..]);
    assert n > 1500;
    assert o[0] == 32;
    assert w_has(o[0..], n, "--w-green");
    assert w_has(o[0..], n, "--w-mono");
    assert w_has(o[0..], n, "xc7a200");
    assert w_has(o[0..], n, "t27.ai/widgets/idcode/#id=0x03636093");
}

test the_hash_changes_the_code_once {
    w_init("");
    w_hash("#id=0x03636093");
    assert CODE == 56844435;
    w_hash("#id=0x00000005");
    assert CODE == 5;
    var h : [64]u8 = [0; 64];
    assert w_hash_out(h[0..]) == 15;
    w_hash("#id=zz");
    assert CODE == 5;
}

test a_table_without_a_source_leaves_the_credit_failed_and_the_table_in_use {
    w_init("");
    w_data(0, "{\"fpga\":[[\"0x03636093\",\"xilinx\",\"f\",\"m\",6]],\"misc\":[],\"manufacturers\":[],\"shadowed\":[]}");
    assert TBL;
    assert !P_TBL;
    assert CREDIT == 2;
    var o : [65536]u8 = [0; 65536];
    var n : u32 = w_render(o[0..]);
    assert w_has(o[0..], n, "The device table did not load; the bit fields still work.");
    assert !w_has(o[0..], n, "idc-device");
    w_input(0, "0x03636093");
    n = w_render(o[0..]);
    assert w_has(o[0..], n, "<div class=\"idc-device\">");
}

/// The splicer follows only the names a module itself mentions, not the names the imported functions
/// mention. This anchor mentions every helper the writer, the JSON reader, the number rules and the
/// canvas writers call. Never called.
pub fn imports_anchor(o: []u8, s: []const u8) -> u32 {
    var n : u32 = 0;
    n = n + (ok(0) as u32);
    n = n + OVER;
    n = n + put(o, 0, 0);
    n = n + raw(o, 0, s);
    n = n + put_escaped(o, 0, 0);
    n = n + text(o, 0, s);
    n = n + num(o, 0, 0);
    n = n + attr(o, 0, s, s);
    n = n + fill(o, 0, s, s, s, s, 0);
    n = n + fill_named(o, 0, s, s, s, s, s, s, s, s, s, s, s, s, s);
    n = n + dec_to(o, 0);
    n = n + (name_is(s, 0, 0, s) as u32);
    n = n + (is_word_byte(0) as u32);
    n = n + (H_LT as u32);
    n = n + (H_GT as u32);
    n = n + (H_AMP as u32);
    n = n + (H_QUOTE as u32);
    n = n + (H_APOS as u32);
    n = n + (H_SPACE as u32);
    n = n + (H_SLASH as u32);
    n = n + (H_EQ as u32);
    n = n + ((NO_SPAN < 0) as u32);
    n = n + ((SPAN > 0) as u32);
    n = n + (J_NONE as u32);
    n = n + (J_OBJECT as u32);
    n = n + (J_ARRAY as u32);
    n = n + (J_STRING as u32);
    n = n + (J_NUMBER as u32);
    n = n + (J_TRUE as u32);
    n = n + (J_FALSE as u32);
    n = n + (J_NULL as u32);
    n = n + (jspan(0, 0) as u32);
    n = n + (span_lo(0) as u32);
    n = n + (span_hi(0) as u32);
    n = n + (skip_ws(s, 0) as u32);
    n = n + (string_end(s, 0) as u32);
    n = n + (value_end(s, 0) as u32);
    n = n + (root(s) as u32);
    n = n + (kind(s, 0) as u32);
    n = n + (key_is(s, 0, 0, s) as u32);
    n = n + (obj_get(s, 0, s) as u32);
    n = n + arr_len(s, 0);
    n = n + (arr_at(s, 0, 0) as u32);
    n = n + hex4(s, 0);
    n = n + escape_at(s, 0, 0);
    n = n + cp_utf8_len(0);
    n = n + (cp_utf8_byte(0, 0) as u32);
    n = n + str_len(s, 0);
    n = n + (str_byte(s, 0, 0) as u32);
    n = n + JN_OVER;
    n = n + JN_CAP;
    n = n + ((JN_TWO52 > 0.0) as u32);
    n = n + ((JN_TWO53 > 0.0) as u32);
    n = n + jn_put(o, 0, 0);
    n = n + jn_raw(o, 0, s);
    n = n + jn_digits(o, 0);
    n = n + jn_mul(o, 0, 0);
    n = n + jn_mul2(o, 0, 0);
    n = n + jn_mul5(o, 0, 0);
    n = n + jn_shift(o, 0, 0);
    n = n + (jn_cmp(s, s, 0) as u32);
    n = n + (jn_expo(0.0) as u32);
    n = n + (jn_mant(0.0) as u32);
    n = n + ((jn_make(0, 0) > 0.0) as u32);
    n = n + jn_exact(o, 0, 0);
    n = n + jn_fscale(0);
    n = n + (js_is_nan(0.0) as u32);
    n = n + ((js_nan(0.0) > 0.0) as u32);
    n = n + ((js_inf(1.0) > 0.0) as u32);
    n = n + ((js_floor(0.0) > 0.0) as u32);
    n = n + ((js_ceil(0.0) > 0.0) as u32);
    n = n + ((js_max(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_min(0.0, 0.0) > 0.0) as u32);
    n = n + ((js_round(0.0) > 0.0) as u32);
    n = n + (jn_shortest(o, 1.0) as u32);
    n = n + jn_copy(o, s, 0);
    n = n + jn_put_run(o, 0, s, 0, 0);
    n = n + jn_layout(o, 0, s, 0, 0);
    n = n + js_str_num(o, 0, 0.0);
    n = n + js_to_fixed(o, 0, 0.0, 0);
    n = n + js_locale_num(o, 0, 0.0);
    n = n + (jn_num_ok(s, 0, 0) as u32);
    n = n + (jn_cmp_text(s, 0, 0, 0, 0) as u32);
    n = n + ((js_parse_num(s, 0, 0) > 0.0) as u32);
    n = n + ((jn_dec_value(s, 0, 0) > 0.0) as u32);
    n = n + (jn_abs(0) as u32);
    n = n + js_str_u64(o, 0, 0);
    n = n + jv_str_to(o, 0, s, 0);
    n = n + jv_text_str(o, 0, s, 0);
    n = n + ((jv_numval(s, 0) > 0.0) as u32);
    n = n + jv_str(o, 0, s, 0);
    n = n + jv_text(o, 0, s, 0);
    n = n + (jv_is(s, 0, s) as u32);
    n = n + (jv_truthy(s, 0) as u32);
    n = n + (jv_is_ws(0) as u32);
    n = n + ((jv_number_of_text(s, 0) > 0.0) as u32);
    n = n + ((jv_num(s, 0) > 0.0) as u32);
    n = n + jv_vput_str(o, 0, s, s);
    n = n + jv_vput_f64(o, 0, s, 0.0);
    n = n + jv_vput_val(o, 0, s, s, 0);
    n = n + jv_vput_defined(o, 0, s, s, 0);
    n = n + jv_vput_fixed(o, 0, s, 0.0, 0);
    n = n + jv_kid(o, 0, s, 0);
    n = n + jv_find(s, 0, s);
    n = n + jv_fill(o, 0, s, s, 0, true);
    n = n + (jv_string_ok(s, 0) as u32);
    n = n + (jv_number_ok(s, 0) as u32);
    n = n + (jv_lit_ok(s, 0, s) as u32);
    n = n + (jv_valid(s) as u32);
    n = n + jv_ws_at(s, 0, 0);
    n = n + jv_ws_before(s, 0, 0);
    n = n + jv_digit_value(0);
    n = n + jv_fill_raw(o, 0, s, s, 0, true);
    n = n + jv_fill_with(o, 0, s, s, 0, true, true);
    n = n + num_grouped(o, 0, 0);
    return n;
}
