// SPDX-License-Identifier: Apache-2.0
; specs/widgets/themes.t27 -- the app-level theme templates as spec data. The two templates are
; token overrides on the document element; widget.css owns the token names, this spec owns the
; values, and the generator writes them out as public/widgets/theme.css. A template id or a token
; name that theme.css does not know fails the generator, so the spec and the emitted stylesheet
; cannot drift. Hand-authored CSS for a template would be a second home for these values.

module widget_theme_templates;

pub const KIND : str = "theme-templates";
pub const ID : str = "widgets/themes";
pub const TEMPLATE_COUNT : u8 = 2;
pub const SAY_TEMPLATE_IDS : [2]str = ["slate", "paper"];
pub const TOKEN_COUNT : u8 = 9;

pub const SAY_TOKEN_NAMES : [9]str = ["--w-bg", "--w-panel", "--w-line", "--w-green", "--w-gold", "--w-red", "--w-text", "--w-muted", "--w-subtle"];

; Two monochrome templates: slate is black with white marks, paper is white
; with black marks. GREEN/GOLD/RED are the legacy accent token names; in both
; templates they resolve to the template's own ink (text) colour, so no accent
; hue survives -- every state differs by inversion, not by colour. MUTED and
; SUBTLE are the only non-pure values, two neutral greys for secondary text
; and quiet edges.
; slate: black field, white marks.
pub const T_SLATE_BG : str = "#000000";
pub const T_SLATE_PANEL : str = "#000000";
pub const T_SLATE_LINE : str = "#FFFFFF";
pub const T_SLATE_GREEN : str = "#FFFFFF";
pub const T_SLATE_GOLD : str = "#FFFFFF";
pub const T_SLATE_RED : str = "#FFFFFF";
pub const T_SLATE_TEXT : str = "#FFFFFF";
pub const T_SLATE_MUTED : str = "#B3B3B3";
pub const T_SLATE_SUBTLE : str = "#8C8C8C";

; paper: white field, black marks.
pub const T_PAPER_BG : str = "#FFFFFF";
pub const T_PAPER_PANEL : str = "#FFFFFF";
pub const T_PAPER_LINE : str = "#000000";
pub const T_PAPER_GREEN : str = "#000000";
pub const T_PAPER_GOLD : str = "#000000";
pub const T_PAPER_RED : str = "#000000";
pub const T_PAPER_TEXT : str = "#000000";
pub const T_PAPER_MUTED : str = "#595959";
pub const T_PAPER_SUBTLE : str = "#999999";

test templates_are_complete {
    assert TEMPLATE_COUNT == 2;
    assert SAY_TEMPLATE_IDS[0] == "slate";
    assert SAY_TEMPLATE_IDS[1] == "paper";
    assert TOKEN_COUNT == 9;
    assert SAY_TOKEN_NAMES[0] == "--w-bg";
    assert SAY_TOKEN_NAMES[8] == "--w-subtle";
}

test slate_values_present {
    assert T_SLATE_BG == "#000000";
    assert T_SLATE_PANEL == "#000000";
    assert T_SLATE_LINE == "#FFFFFF";
    assert T_SLATE_TEXT == "#FFFFFF";
}

test paper_values_present {
    assert T_PAPER_BG == "#FFFFFF";
    assert T_PAPER_PANEL == "#FFFFFF";
    assert T_PAPER_LINE == "#000000";
    assert T_PAPER_TEXT == "#000000";
}

; --- Metrics and typography, identical in both templates ----------------------
; The reference design system's own scale (measured off its published stylesheets,
; body and .btn-sm): the system font stack, the 15px body, the pill button and its
; compact toolbar size, the 480px content column. One source, emitted into the
; generated theme.css as .sb2 custom properties.
pub const SB2_FONT_STACK : str = "-apple-system, BlinkMacSystemFont, SF Pro Text, Segoe UI, sans-serif";
pub const SB2_FONT_SIZE_BASE : str = "15px";
pub const SB2_FONT_SIZE_SM : str = "13px";
pub const SB2_FONT_SIZE_BTN : str = "12px";
pub const SB2_LETTER_SPACING : str = "-0.022em";
pub const SB2_RADIUS_PILL : str = "980px";
pub const SB2_BTN_PAD_Y : str = "8px";
pub const SB2_BTN_PAD_X : str = "14px";
pub const SB2_BTN_LINE_H : str = "1.2";
pub const SB2_GAP : str = "12px";
pub const SB2_MAX_W : str = "480px";
pub const SB2_LINE_H_BASE : str = "1.6";

test metrics_are_the_reference_scale {
    assert SB2_FONT_SIZE_BASE == "15px";
    assert SB2_FONT_SIZE_BTN == "12px";
    assert SB2_RADIUS_PILL == "980px";
    assert SB2_BTN_PAD_Y == "8px";
    assert SB2_BTN_PAD_X == "14px";
    assert SB2_MAX_W == "480px";
    assert SB2_LETTER_SPACING == "-0.022em";
}

test accents_are_monochrome {
    assert T_SLATE_GREEN == T_SLATE_TEXT;
    assert T_SLATE_GOLD == T_SLATE_TEXT;
    assert T_SLATE_RED == T_SLATE_TEXT;
    assert T_PAPER_GREEN == T_PAPER_TEXT;
    assert T_PAPER_GOLD == T_PAPER_TEXT;
    assert T_PAPER_RED == T_PAPER_TEXT;
}