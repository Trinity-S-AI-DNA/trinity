// SPDX-License-Identifier: Apache-2.0
; second-brain-kit.t27 -- the component catalog's first page: eight contracts of the
; initial kit, each a record a composition can check against. A contract holds what the
; reference systems (A2UI's registered catalog, json-render's registry) hold and what they
; do not: the source provenance and the tests that pin the behaviour. KIND is not
; widget-tool on purpose; t27c test is its gate.
; phi^2 + 1/phi^2 = 3 | TRINITY

module second_brain_kit;

pub const KIND : str = "component-kit";
pub const CATALOG_VERSION : u8 = 1;
pub const COMPONENT_COUNT : u8 = 8;

; --- Identity: the names a composition is allowed to reference. ----------------
pub const SAY_COMPONENTS : [8]str = ["AppShell", "SearchBox", "GraphView", "Inspector", "List", "TestResults", "ThemeSwitch", "StateReadout"];

; --- Events each component emits; a binding must name one of these. ------------
pub const SAY_GRAPHVIEW_EVENTS : [4]str = ["select", "filter", "pan", "zoom"];
pub const SAY_SEARCHBOX_EVENTS : [1]str = ["query"];
pub const SAY_THEMESWITCH_EVENTS : [1]str = ["theme-change"];
pub const K_STATE_READOUT_EVENTS : u8 = 0;

; --- Slots: what each component accepts as children. An empty list takes none --
pub const K_APPSHELL_SLOTS : u8 = 1;
pub const SAY_APPSHELL_SLOTS : [1]str = ["screen"];
pub const K_LIST_SLOTS : u8 = 1;
pub const SAY_LIST_SLOTS : [1]str = ["item"];
pub const K_GRAPHVIEW_SLOTS : u8 = 0;
pub const K_INSPECTOR_SLOTS : u8 = 0;

; --- State: the five fields of the shared view state, in the kit's order. ------
pub const K_STATE_FIELDS : u8 = 5;
pub const SAY_STATE_FIELDS : [5]str = ["selected", "filter", "panX", "panY", "zoomMilli"];

; --- Provenance: every generated component names its spec. ---------------------
pub const SAY_GRAPHVIEW_SOURCE : str = "graph-kit.js host + second-brain-view-logic.t27 geometry";
pub const SAY_INSPECTOR_SOURCE : str = "spec-index.json from scripts/spec-index.mjs over the pinned compiler";

test catalog_is_complete {
    assert COMPONENT_COUNT == 8;
    assert CATALOG_VERSION == 1;
    assert SAY_COMPONENTS[0] == "AppShell";
    assert SAY_COMPONENTS[7] == "StateReadout";
}

test graphview_events_are_named {
    assert SAY_GRAPHVIEW_EVENTS[0] == "select";
    assert SAY_GRAPHVIEW_EVENTS[3] == "zoom";
}

test slots_are_declared_not_implied {
    assert K_APPSHELL_SLOTS == 1;
    assert K_GRAPHVIEW_SLOTS == 0;
    assert K_INSPECTOR_SLOTS == 0;
    assert SAY_APPSHELL_SLOTS[0] == "screen";
}

test state_fields_are_the_shared_five {
    assert K_STATE_FIELDS == 5;
    assert SAY_STATE_FIELDS[0] == "selected";
    assert SAY_STATE_FIELDS[4] == "zoomMilli";
}

test provenance_names_specs {
    assert SAY_GRAPHVIEW_SOURCE != "";
    assert SAY_INSPECTOR_SOURCE != "";
}
