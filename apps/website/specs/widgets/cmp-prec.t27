// SPDX-License-Identifier: Apache-2.0
; specs/widgets/cmp-prec.t27 -- Who binds tighter: the eleven levels of an expression
; Source of truth for public/widgets/cmp-prec/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English and NO RULE of its
; own: every class, status, count and verdict it shows comes from public/widgets/cmp-prec/logic.js -- the fn
; bodies of gHashTag/t27 specs/compiler/parser.t27 compiled to wasm, beside its copy logic.t27.
; Lesson 4 of the course t27-compiler. ASCII only (L3), English only (LANG-EN).
; A K_ constant is an input, a preset, a range or a constant of the logic spec (widget-logic.mjs holds
; a K_ whose name the logic spec also has equal to it); never the result of a spec fn.

; WHAT IT DOES:  the reader picks the level of the first and of the second operator of a + b * c style expression. The
; widget asks binds_looser both ways and brackets the group the answer names; a grid draws binds_looser for every pair.

; WHAT IT DOES NOT CLAIM:  it does not parse text. Two operators at one level are drawn without brackets: the spec reads them in a
; loop at that level, left to right, and no lowered fn says more. The level numbers are held equal to the spec's PREC_ constants.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_cmp_prec;

pub const KIND : str = "widget-tool";
pub const ID : str = "cmp-prec";
pub const TITLE : str = "Who binds tighter: the eleven levels of an expression";
pub const DESCRIPTION : str = "The t27 parser reads an expression through eleven nested levels, from or down to postfix. Pick two operators and binds_looser says which one splits the expression first.";
pub const IMAGE_ALT : str = "Precedence card: the expression a + b * c with additive and multiplicative picked. binds_looser says additive binds looser than multiplicative, so the plus splits first and the product groups: a + (b * c). Below, an eleven by eleven grid of every answer of binds_looser.";
pub const HOOK : str = "Eleven functions call one another, loosest first, and a single comparison of two levels decides where an expression splits: 1 + 2 * 3 is 1 + (2 * 3).";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["gHashTag/t27 specs/compiler/parser.t27 (t27 master 90e797659): every answer is binds_looser or max_children, fn bodies compiled to wasm (logic.js); the operators of each level are read from parse_expr_* in the same spec", "Course 12 of t27.ai, t27-compiler: lesson 4 opens this widget"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;
pub const K_STAGE : u8 = 1;

; --- Numbers: ranges, presets, and constants the logic spec holds ----------------------------
pub const K_LEVEL_COUNT : u8 = 11;
pub const K_PREC_OR : u8 = 0;
pub const K_PREC_AND : u8 = 1;
pub const K_PREC_COMPARISON : u8 = 2;
pub const K_PREC_BITOR : u8 = 3;
pub const K_PREC_BITXOR : u8 = 4;
pub const K_PREC_BITAND : u8 = 5;
pub const K_PREC_SHIFT : u8 = 6;
pub const K_PREC_ADDITIVE : u8 = 7;
pub const K_PREC_MULTIPLICATIVE : u8 = 8;
pub const K_PREC_UNARY : u8 = 9;
pub const K_PREC_POSTFIX : u8 = 10;
pub const K_PRESET_FIRST : [3]u8 = [7, 1, 6];
pub const K_PRESET_SECOND : [3]u8 = [8, 0, 7];
pub const K_START_PRESET : u8 = 0;

; --- Words on screen ------------------------------------------------------------------------
pub const SAY_PRESETS_LABEL : str = "Start from";
pub const SAY_STAGES : [9]str = ["Read", "Parse", "Types", "Cost", "Emit", "Write", "Seal", "Trust", "Run"];
pub const SAY_STAGE_LINE : str = "The nine stages a spec passes; this lesson is the lit one";
pub const SAY_EMPTY : str = "(nothing)";
pub const SAY_PRESET_NAMES : [3]str = ["a + b * c", "a and b or c", "a << b + c"];
pub const SAY_ASK : str = "In a + b * c, which operator splits the expression first?";
pub const SAY_FIRST : str = "first operator";
pub const SAY_SECOND : str = "second operator";
pub const SAY_LEVELS : [11]str = ["or", "and", "comparison", "bit or", "bit xor", "bit and", "shift", "additive", "multiplicative", "unary", "postfix"];
pub const SAY_LEVEL_OPS : [11]str = ["or", "and", "== != < > <= >= ..", "|", "^", "&", "<< >>", "+ - +%", "* / % **", "- ! ~ &", "call index field"];
pub const SAY_SAMPLE_OPS : [11]str = ["or", "and", "==", "|", "^", "&", "<<", "+", "*", "!", "."];
pub const SAY_EXPR : str = "a {0} b {1} c";
pub const SAY_FIRST_LOOSER : str = "{0} binds looser than {1}: it splits first.";
pub const SAY_SECOND_LOOSER : str = "{1} binds looser than {0}: it splits first.";
pub const SAY_SAME : str = "{0} and {1} are at one level: the loop of that level takes them in order.";
pub const SAY_MAX_CHILDREN : str = "one tree node holds at most {0} children";
pub const SAY_GRID : str = "binds_looser(row, column)";
pub const SAY_NOTE : str = "Each level is one function that reads its operands from the next tighter level, so the tightest operators group first. The grid lights a cell when the row binds looser than the column.";
pub const SAY_SOURCE : str = "Logic: t27 spec compiler/parser.t27, compiled";

test the_card_is_the_share_size {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
    assert K_CARD_WIDTH * 21 == K_CARD_HEIGHT * 40;
}

test the_lesson_has_a_stage_of_nine {
    assert K_STAGE < 9;
    assert K_STAGE == 1;
}

test levels_run_from_or_to_postfix {
    assert K_PREC_OR == 0;
    assert K_PREC_ADDITIVE + 1 == K_PREC_MULTIPLICATIVE;
    assert K_PREC_POSTFIX + 1 == K_LEVEL_COUNT;
}

test the_start_is_a_plus_and_a_times {
    assert K_PRESET_FIRST[0] == K_PREC_ADDITIVE;
    assert K_PRESET_SECOND[0] == K_PREC_MULTIPLICATIVE;
    assert K_PRESET_FIRST[1] == K_PREC_AND;
}
