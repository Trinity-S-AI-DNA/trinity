pub const WIDGET_LINES : [306]str = ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "One issue, one pinned commit, the same tools and gates; only the decision layer changes, and a missing run stays unknown.", "", "", "", "", "", "", ""];
; Why a person would pass this one on: the reason the widget is in the gallery at all.
pub const WIDGET_HOOKS : [306]str = ["The bitstream is byte-identical to openXC7's and runs on a real board: the claim most FPGA people doubt, shown.", "A Xilinx 7-series bitstream assembled with no Vivado anywhere in the path.", "Plant a bug in the bitstream path and watch the tests catch it: mutation testing for hardware.", "Place and route to a loaded bitstream, with the clock on screen.", "RGMII hold margins read from nextpnr's own SDF, not from a datasheet.", "The cable asks which chip is there and the chip answers with its IDCODE.", "Before an edit to a Verilog file: every spec and generator it would touch.", "The whole FPGA flow, one layer per line, from spec to board.", "A spec turned into Verilog inside a post, with the RTL read the way a hardware engineer reads it.", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "17 of 17 conformance specs compile, their test blocks pass, and no generated file has drifted.", "14 of 14 bench tools pass their own self-tests in one sweep: decode 18/18, repin 17/17, firelog 10/10, tmpcheck 9/9, stamps 9/9, keep 9/9.", "Requested 115,200 puts 115,385 on the wire (+0.16 %), 921,600 puts 923,077, and 3,000,000 is exact.", "26 checks, no board, no RTL: every receipt returns, 11 loss and fault cases recover, and a lie stops the run.", "One command reads the bench: cables, locks, and the last board runs: three x7-board runs PASS 51840/51840.", "112 files under /tmp pinned by sha256 in specs: every one has a kept copy, 0 lost, 0 unlocated.", "84 board and model logs scanned for the TRI-NET key: 0 hits, 0 logs of 1 MB or more.", "16 spec-named scripts run their own --self-test, 0 bad; 8 without the flag are listed, not skipped silently.", "The part table in far.t27 matches prjxray-db part.json, all 6 reference bitstreams present, bitwalk reads all 6 in 84.4 ms.", "One command re-runs every sweep: CRC 12/12, ECC 32520/32520 frames, 82/82 pins, 4224/4224 segbits, gold 5/5. audit: CLEAN.", "The CDC spec through the real compiler: 12 tests pass natively and the header says what the model does and does not claim.", "The tri clocks card as a spec: constants a tool page reads, and a native test-report that says so plainly -- 0 tests, because it is not a test suite.", "The board itself as a spec: 15 tests pass natively and the part line names the xc7a200tfgg676 the Wukong carries.", "Clock-tree synthesis in numbers: 15 tests pass natively, and the header pins the Artix-7 teaching delays the tree arithmetic uses.", "The MMCM model through the real compiler: VCO window, M/D/O ranges, fractional multiply in eighths, the 1/56 phase step, 16 tests natively.", "Widen the VCO window with one sed and exactly one test objects -- the rejection test that names the 500 MHz config it calls out.", "Static timing as arithmetic: 25 tests pass natively on arcs, slack and Fmax, with the Artix-7 teaching delays in the header.", "The three reset kinds through the real compiler: async assert with sync release through 2 to 4 flops, and the racy async release, 16 tests natively.", "What the compiler emits for the reset pipe: t27c gen prints the Zig, one struct copy per clock, and wc -l counts it.", "Metastability MTBF without floats: the WP323 form in Q10 log2, one flop negative slack, two flops astronomical, 15 tests natively.", "The CDC model as Zig: t27c gen prints what it compiled and wc -l says how many lines of code the model is.", "The FIFO stdlib through the real compiler: 18 tests pass natively and 6 invariants are proved comptime.", "Move a pointer by 3 instead of 1 and every test still passes: the suite asserts fill and flags, never pointer values.", "Flip one flag assignment and a single test objects: the guard that keeps the FIFO honest.", "The pins-to-XDC emitter spec parsed by the real compiler, and the create_clock lines it exists to write.", "The fpga-rxcap tool card as a spec: constants for a tool page, and a native run that says 0 tests and why.", "168 records: 14 papers entered twice, 141 cite no score, 144 state zero at pass@1.", "67 specs lose 23,578 tokens to parser recovery, each held at its pinned bound.", "Smallest hold 3445 ps on TXD1 against a 1000 ps bench; each TX pin setup and hold from the routed SDF.", "Per-bit setup and hold of an async RX nibble against its RXC edge, from the routed SDF: one nibble changes 2387 to 2486 ps apart, so a binary counter tears where a gray one cannot.", "RX_ER pulses injected at exact nibble positions of a ping -- preamble, mid-frame, IP header -- and the frame state each pulse leaves behind, RTL vs model.", "The Ethernet bring-up plan on the bench: pre-registered steps, logged exits, what ran and what did not.", "The registered IO clients on the bench, read live: names, claims and what each declares it owns.", "The bench claim in action: one client takes the hardware lock and the tool reports who holds it.", "The bench lock given back: the client gives up its claim and the bench reports itself free.", "The next queued step on the bench, read live from the run state.", "The memory map spec through the real compiler: 15 tests pass natively and 6 invariants are proved comptime.", "The SPI testbench through the real compiler: 7 tests pass natively, driving the modes and checking the captures.", "t27c check on the UART spec: 0 errors, 0 warnings -- the first bar every lesson's spec clears.", "t27c check on the SPI spec: 0 errors, 0 warnings -- the first bar every lesson's spec clears.", "t27c check on the APB bridge spec: 0 errors, 0 warnings -- the first bar every lesson's spec clears.", "t27c check on the AXI4 spec: 0 errors, 0 warnings -- the first bar every lesson's spec clears.", "t27c check on the bus bridge spec: 0 errors, 0 warnings -- the first bar every lesson's spec clears.", "t27c check on the memory spec: 0 errors, 0 warnings -- the first bar every lesson's spec clears.", "The UART spec lowered to synthesizable Verilog: the TRINITY banner, the module port list and the datapath as wires.", "The SPI spec lowered to synthesizable Verilog: the TRINITY banner, the module port list and the datapath as wires.", "The APB bridge spec lowered to synthesizable Verilog: port list, PSEL and PENABLE wiring, the address decode.", "The AXI4 spec lowered to synthesizable Verilog: the five channels' wiring and handshakes as generated wires.", "The bus bridge spec lowered to synthesizable Verilog: both sides of the crossing as generated wires.", "The whole design in one spec lowered to synthesizable Verilog: clocks, resets and bus wiring as the compiler emits them.", "The UART testbench spec lowered to Verilog: what a bench looks like when the compiler emits it.", "The APB bridge testbench spec lowered to Verilog: what a bench looks like when the compiler emits it.", "The AXI4 testbench spec lowered to Verilog: what a bench looks like when the compiler emits it.", "The memory testbench spec lowered to Verilog: what a bench looks like when the compiler emits it.", "The integration testbench spec lowered to Verilog: every bus of the design in one bench.", "The top-level testbench spec lowered to Verilog: the whole design under one bench.", "The SPI testbench spec lowered to Verilog: what a bench looks like when the compiler emits it.", "The UART spec lowered to hardware IR: the compiler's own view of the wires and state before Verilog exists.", "The APB bridge spec lowered to hardware IR: PSEL, PENABLE and the decode as the compiler structures them.", "The AXI4 spec lowered to hardware IR: the five channels and their handshakes as the compiler structures them.", "The Ethernet FCS spec through the real compiler: 8 tests pass natively -- the table derived from one bit step, the 0xCBF43926 check value, the 0xDEBB20E3 receiver residue.", "The RGMII spec through the real compiler: 7 tests pass natively and 1 invariant is proved comptime -- the 8 ns gigabit period, a nibble on both edges, the 78 ps tap ladder.", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "The t27 compiler running as WebAssembly in a post: compile, test, seven backends.", "The same spec as Rust, printed by a terminal in the page.", "The only backend that runs in the browser: generate the module, then run it.", "t27c on hello_world.t27, on a real machine, every byte as printed.", "Code that compiles and is wrong: the tool that finds it.", "", "", "The OCP MX scale byte as a spec: 2^(e-127), code 255 is NaN, 18 tests and 9 comptime invariants, compiled on a real machine.", "The same scale byte compiled in your browser: seven backends, the spec's tests run in the page, and every skip says why.", "One outlier sets the scale for 32 weights: MXFP4 flushes 23 of them to zero, MXFP8 E4M3 none. 49 tests pass; a planted bug fails one.", "Ternary weights scaled by phi, compiled in your browser: codes 00, 01, 10, and the fourth code folded to zero.", "13 of 13 tests pass natively, and the report says 8 of them executed no assert; a planted bug fails exactly one.", "Five measured rules for a ternary weight alphabet, and the one formula that passes all five, run in your browser.", "One more trit and the spec does not compile at all: BLOCKED, not failed, because no test ever ran.", "A 17-bit float whose exponent is four balanced trits, 3^4 = 81 values, compiled in your browser.", "34 tests pass natively, none vacuous; swap one XOR for OR and only the test that negates twice fails.", "A neuron's sum squeezed back to one trit: 7 tests pass natively, and turning one > into >= fails only the boundary test.", "One ternary neuron, two functions picked by its weights: 12 tests pass natively, and one weight moved from P to Z fails exactly one.", "A neuron wider than 27 inputs, summed chunk by chunk: 11 tests pass natively, and a loop that stops after one chunk fails exactly one.", "A 27-lane ternary dot product as pure wires: 4 tests pass natively, and one wrong sign in tmul fails exactly one.", "The same dot product added into a register on every clock: 4 tests pass natively, and a lane mask short one bit fails exactly one.", "A whole small ternary network, 3 neurons then 2: 4 tests pass natively, and a trit packed one bit low fails exactly one.", "A signed multiply: 3 tests pass natively, none vacuous, and a sign stuck at 0 fails exactly one, m2.", "A signed add: 3 tests pass natively, and adding where opposite signs must subtract fails exactly one, a2.", "Two signed products summed: 4 tests pass natively, and OR in place of the sign XOR fails exactly one, pp.", "A ReLU: 4 tests pass natively, and letting negative inputs through fails only negz, the one test with a negative input.", "2^x for a softmax: 4 tests pass natively, and dropping the minus sign of k fails exactly one, em1.", "argmax by comparing bits alone: 4 tests pass natively, and >= in place of > fails exactly one, tie_low.", "A loss in bits: 3 tests pass natively, and a zero with the sign bit set fails exactly one, perfect.", "One SGD step: 3 tests pass natively, and g times g in place of eta times g fails exactly one, ascend.", "A 2-layer ReLU net for XOR: 4 tests pass natively, and one relu removed fails exactly one, x00.", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "34 vector files, 512 cases: 2 files executed, 8 debt, 24 prose-only; 19% carry data.", "Four census populations recounted another way all agree; three are named as uncheckable.", "31 of 1,428 seals record no output (16 specs); 3 of those are missing from the debt ledger.", "11 specs refused at parse, 0 blocked only by prose, 23 broken on purpose as fixtures.", "12 Lean files, 15,553 lines and 4 sorry, are reached by no build root: nothing compiles them.", "tri, railway, python3 and the loop directory: each present or not, in one call.", "The terminal for seven t27 backends: every command run on hello_world. 21 pass, 0 fail.", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Pick a lane and see whether the TRI decision layer beats the baseline on the same issue.", "One tick of the Queen's loop: an anomaly scan that reports only what changed.", "The loop's skills checked against snapshots before an agent may use them.", "Three performance bits, and one knockout bitstream per bit to prove each one matters.", "", "", "73 published posts with date, language and revision, newest first.", "6 of 6 self-tests hold: anomalies, blog_drift, lessons, site_gate, tick, vault."];

; --- Ideas: asked for, not built ---------------------------------------------------------------
; From what engineers share today (gh-skyline, Tiny Tapeout renders, Wrapped cards, Gatle-style
; daily puzzles, carbon.now.sh) and what none of them does for FPGA output. Each names the data
; it would read: a file the reader drops, or a run already in this repository. None is shown
; as working. Built ideas move up to WIDGET_IDS (tri widget gallery-add); the shelf refills from research.
pub const IDEA_COUNT : u8 = 6;
pub const IDEA_IDS : [6]str = ["same-circuit", "lut-golf", "wave-card", "die-guessr", "xdc-check", "open-flow-check"];
pub const IDEA_TITLES : [6]str = ["Same circuit?", "LUT golf", "Wave card", "Die guessr", "Ports your XDC forgot to constrain", "Can I build this FPGA without Vivado"];
pub const IDEA_LINES : [6]str = ["Paste two versions of a module: yosys proves them the same circuit in the browser, or prints the input that tells them apart.", "One small function a day and a reference LUT count: write a smaller circuit, prove it equivalent, then compare.", "Drop a .vcd, pick six signals and a window, and get a waveform image of what the simulator printed, with the file hash under it.", "A daily placement picture from a real nextpnr run on an Artix-7 200T: guess which of our specs it is.", "Drop an XDC file and your top-level port list to see ports with no PACKAGE_PIN, no IOSTANDARD, or clocks with no create_clock.", "Type a Xilinx part number and see whether openFPGALoader, prjxray-db and nextpnr-xilinx list it, each with source and date."];
pub const IDEA_SOURCES : [6]str = ["yosys miter -equiv and sat -prove-asserts, run as WebAssembly in the page; sequential designs bounded to N cycles, said on the card", "yosys synth_xilinx stat after an equivalence check, both in the browser", "the reader VCD converted to WaveJSON and drawn by WaveDrom (MIT)", "Competitor sweep 2026-10-05, idea rank 7 (die-guessr), narrowed to our own runs", "ZipCPU clock and constraint posts; nextpnr-xilinx constraint warnings; Mastodon open-toolchain log screenshots", "Vivado 2026.1 Linux free-tier backlash and AMD reversal (HN 48254574, AMDembedded on X); openFPGALoader v1.1.x; openXC7 prebuilt releases"];

; --- Tests -----------------------------------------------------------------------------------
test the_player_embed_is_sixteen_by_nine {
    assert EMBED_WIDTH * 9 == PLAYER_EMBED_HEIGHT * 16;
    assert CAST_EMBED_HEIGHT > PLAYER_EMBED_HEIGHT;
}

test every_category_has_a_name_and_a_line {
    assert CATEGORY_COUNT == 3;
    assert CATEGORY_IDS[0] == "fpga";
    assert CATEGORY_IDS[1] == "compiler";
    assert CATEGORY_IDS[2] == "game";
}

test the_fpga_shelf_comes_first_and_opens_on_the_board {
    assert WIDGET_CATEGORIES[0] == "fpga";
    assert WIDGET_IDS[0] == "x7-board";
    assert WIDGET_KINDS[0] == "cast";
}

test the_arena_is_a_tab_and_says_its_own_words {
    assert WIDGET_IDS[298] == "wars";
    assert WIDGET_KINDS[298] == "tab";
    assert WIDGET_PAGES[298] == "wars";
}

test the_gallery_posts_nothing {
    assert POSTS_NOTHING == true;
}

test the_ai_number_shelf_closes_the_compiler_run {
    assert WIDGET_IDS[132] == "t27c-e8m0";
    assert WIDGET_IDS[133] == "play-e8m0";
    assert WIDGET_PAGES[133] == "play/e8m0/";
    assert WIDGET_IDS[134] == "t27c-ocp-mx";
    assert WIDGET_CATEGORIES[129] == "compiler";
}

test the_ternary_shelf_follows_the_mx_block {
    assert WIDGET_IDS[135] == "play-gfternary";
    assert WIDGET_PAGES[135] == "play/gfternary/";
    assert WIDGET_IDS[138] == "t27c-golden-sieve";
    assert WIDGET_KINDS[136] == "cast";
    assert WIDGET_IDS[140] == "t27c-tnf17";
    assert WIDGET_CATEGORIES[137] == "compiler";
}

test the_verification_shelf_is_rehearsals_and_audits {
    assert WIDGET_IDS[32] == "tri-fpga-specs";
    assert WIDGET_KINDS[32] == "cast";
    assert WIDGET_CATEGORIES[32] == "fpga";
    assert WIDGET_IDS[41] == "tri-x7-audit";
    assert WIDGET_IDS[210] == "t27-tri-vectors";
    assert WIDGET_CATEGORIES[207] == "compiler";
    assert WIDGET_IDS[216] == "play-terminal-gates";
}

test ideas_are_counted_apart_from_widgets {
    assert IDEA_COUNT == 6;
    assert WIDGET_IDS[303] == "gatle";
    assert WIDGET_COUNT == 306;
}

test the_ternary_machine_shelf_runs_before_the_arena {
    assert WIDGET_IDS[217] == "tc-why-three";
    assert WIDGET_PAGES[217] == "widgets/tc-why-three/";
    assert WIDGET_KINDS[243] == "tool";
    assert WIDGET_CATEGORIES[243] == "compiler";
}

test every_tool_lives_under_widgets_and_keeps_its_words_on_its_page {
    assert WIDGET_KINDS[9] == "tool";
    assert WIDGET_PAGES[9] == "widgets/bit-diff/";
    assert WIDGET_HOOKS[9] == "";
    assert WIDGET_KINDS[302] == "tool";
    assert WIDGET_CATEGORIES[302] == "game";
    assert WIDGET_PAGES[302] == "widgets/race-the-bee/";
}

test the_arithmetic_shelf_closes_the_fpga_bench {
    assert WIDGET_IDS[98] == "carry-chain";
    assert WIDGET_KINDS[98] == "tool";
    assert WIDGET_PAGES[98] == "widgets/carry-chain/";
    assert WIDGET_IDS[124] == "fir-on-board";
    assert WIDGET_CATEGORIES[124] == "fpga";
    assert WIDGET_HOOKS[124] == "";
}

test the_neural_network_shelf_runs_before_the_arena {
    assert WIDGET_IDS[244] == "nn-relu";
    assert WIDGET_KINDS[244] == "tool";
    assert WIDGET_PAGES[244] == "widgets/nn-relu/";
    assert WIDGET_IDS[270] == "nn-ppo";
    assert WIDGET_CATEGORIES[270] == "compiler";
    assert WIDGET_IDS[298] == "wars";
}

test the_hive_shelf_runs_before_the_arena {
    assert WIDGET_IDS[271] == "hive-shape";
    assert WIDGET_KINDS[271] == "tool";
    assert WIDGET_PAGES[271] == "widgets/hive-shape/";
    assert WIDGET_IDS[297] == "hive-cell";
    assert WIDGET_CATEGORIES[297] == "game";
    assert WIDGET_IDS[298] == "wars";
}
