module ci_course_chat_workflow;

; specs/ci/course_chat_workflow.t27 -- the workflow .github/workflows/emit-course-chat.yml, written by a spec
; (Trinity-S-AI-DNA/trinity#1813, the course helper chat). The workflow is plumbing around t27c (build it,
; run the chat spec's tests, plant one bug per cap, emit src/lib/courseChat.gen.ts), and a hand-written yml
; was the one non-t27 file the chat pull request carried. Now pub fn workflow_yml fills a buffer with the
; whole file, and the workflow itself runs t27c gen-text --fn workflow_yml on this spec and compares the
; bytes with the committed file (the last gate), so a hand edit of the yml turns the job red, and the
; fix is to edit this spec. A GITHUB_TOKEN push starts no workflow, so the emitted file is committed by
; hand from the artifact "course-chat" of the job, as courseChat.gen.ts is.
; One raw() call per line of the yml, in the order of the file, so a diff of the spec reads as a diff of
; the workflow. The yml holds no backslash, so a line lands in a str const with only the double quote
; escaped. The functions are cut at the sections of the file: head, triggers, setup, test and emit, gates.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

use widgets::views::html_out;
use widgets::views::page_kit;

pub var OUT : [16384]u8 = [0; 16384];

/// Lines 1 to 20 of the yml: the name and the header comment.
pub fn wf_head(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    n = raw(o, n, "name: Course chat spec (t27c test-report and gen-ts)\n");
    n = raw(o, n, "\n");
    n = raw(o, n, "# Written by `t27c gen-text --fn workflow_yml` from apps/website/specs/ci/course_chat_workflow.t27,\n");
    n = raw(o, n, "# never by hand: edit that spec, let this job emit the file, commit the emitted bytes (the last\n");
    n = raw(o, n, "# gate below fails while the committed file differs from the emitted one).\n");
    n = raw(o, n, "# FR-201..FR-208 of Trinity-S-AI-DNA/trinity#1813: the course helper chat is one spec,\n");
    n = raw(o, n, "# apps/website/specs/chat/course-chat.t27. The Mac never runs t27c, so this job is the lab. It\n");
    n = raw(o, n, "#   1. builds t27c from the pinned t27 revision and sets up the Zig that t27 runs its harness with,\n");
    n = raw(o, n, "#   2. runs the tests of the chat spec and of the spec that writes this file (test-report prints\n");
    n = raw(o, n, "#      its verdicts; this job reads what it prints),\n");
    n = raw(o, n, "#   3. runs the negative controls: ten copies of the chat spec, each with one cap or rule turned\n");
    n = raw(o, n, "#      wrong (IP limit, key limit, shared daily cap, turns per conversation, paid fallback, round\n");
    n = raw(o, n, "#      opener corners, opener tap size, offline send, offline probe, Send tap size), must\n");
    n = raw(o, n, "#      each turn its own test red, and the job fails when one stays green,\n");
    n = raw(o, n, "#   4. writes src/lib/courseChat.gen.ts with `t27c gen-ts` and this workflow with `t27c gen-text`,\n");
    n = raw(o, n, "#      and uploads both as the artifact \"course-chat\" (to commit by hand, because a push made with\n");
    n = raw(o, n, "#      GITHUB_TOKEN starts no workflow),\n");
    n = raw(o, n, "#   5. fails when a test did not pass, when a planted bug stayed green, or when a committed file\n");
    n = raw(o, n, "#      (the module, this workflow) differs from the emitted one.\n");
    n = raw(o, n, "# The shell lines below are plumbing around t27c, one tool call per line; the rule is t27.\n");
    n = raw(o, n, "\n");
    return n;
}

/// Lines 21 to 42: the triggers, the permissions, the concurrency and the env.
pub fn wf_triggers(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    n = raw(o, n, "on:\n");
    n = raw(o, n, "  pull_request:\n");
    n = raw(o, n, "    branches: [main]\n");
    n = raw(o, n, "    paths:\n");
    n = raw(o, n, "      - \"apps/website/specs/chat/**\"\n");
    n = raw(o, n, "      - \"apps/website/specs/ci/**\"\n");
    n = raw(o, n, "      - \"apps/website/src/lib/courseChat.gen.ts\"\n");
    n = raw(o, n, "      - \".github/workflows/emit-course-chat.yml\"\n");
    n = raw(o, n, "  workflow_dispatch:\n");
    n = raw(o, n, "\n");
    n = raw(o, n, "permissions:\n");
    n = raw(o, n, "  contents: read\n");
    n = raw(o, n, "\n");
    n = raw(o, n, "concurrency:\n");
    n = raw(o, n, "  group: emit-course-chat-${{ github.ref }}\n");
    n = raw(o, n, "  cancel-in-progress: true\n");
    n = raw(o, n, "\n");
    n = raw(o, n, "env:\n");
    n = raw(o, n, "  # The same t27 revision the widget-page job pins (gHashTag/t27#13568).\n");
    n = raw(o, n, "  T27_EMITTER_REVISION: 06522649ba5006c206d89af4c70c45590461a691\n");
    n = raw(o, n, "  T27_ZIG_VERSION: 0.16.0\n");
    n = raw(o, n, "\n");
    return n;
}

/// Lines 43 to 74: the job and the steps that build t27c and make the folders.
pub fn wf_setup(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    n = raw(o, n, "jobs:\n");
    n = raw(o, n, "  emit:\n");
    n = raw(o, n, "    name: Test the chat spec and emit its TypeScript\n");
    n = raw(o, n, "    runs-on: ubuntu-latest\n");
    n = raw(o, n, "    timeout-minutes: 60\n");
    n = raw(o, n, "    steps:\n");
    n = raw(o, n, "      - uses: actions/checkout@v4\n");
    n = raw(o, n, "\n");
    n = raw(o, n, "      - name: Check out gHashTag/t27 at the emitter revision\n");
    n = raw(o, n, "        uses: actions/checkout@v4\n");
    n = raw(o, n, "        with:\n");
    n = raw(o, n, "          repository: gHashTag/t27\n");
    n = raw(o, n, "          ref: ${{ env.T27_EMITTER_REVISION }}\n");
    n = raw(o, n, "          path: t27-pinned\n");
    n = raw(o, n, "          fetch-depth: 1\n");
    n = raw(o, n, "\n");
    n = raw(o, n, "      # plumbing: build the compiler from that revision with its own Cargo.lock\n");
    n = raw(o, n, "      - name: Build t27c\n");
    n = raw(o, n, "        run: cargo build --release --locked -p t27c --manifest-path t27-pinned/Cargo.toml --target-dir t27c-target\n");
    n = raw(o, n, "\n");
    n = raw(o, n, "      - name: Setup the Zig that t27 runs its harness with\n");
    n = raw(o, n, "        uses: mlugg/setup-zig@v2\n");
    n = raw(o, n, "        with:\n");
    n = raw(o, n, "          version: ${{ env.T27_ZIG_VERSION }}\n");
    n = raw(o, n, "          use-cache: false\n");
    n = raw(o, n, "\n");
    n = raw(o, n, "      # plumbing: put t27c on the PATH, make the output folders\n");
    n = raw(o, n, "      - name: Put t27c on the PATH\n");
    n = raw(o, n, "        run: |\n");
    n = raw(o, n, "          echo \"$PWD/t27c-target/release\" >> \"$GITHUB_PATH\"\n");
    n = raw(o, n, "          mkdir -p emit-out/logs emit-out/negative emit-out/workflow\n");
    n = raw(o, n, "\n");
    return n;
}

/// Lines 75 to 100: test the specs, plant the bugs, emit the module and the workflow.
pub fn wf_test_and_emit(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    n = raw(o, n, "      # plumbing: test-report prints its verdicts and the gates below read them\n");
    n = raw(o, n, "      - name: Test the chat spec and the workflow spec\n");
    n = raw(o, n, "        run: for f in apps/website/specs/chat/course-chat.t27 apps/website/specs/ci/course_chat_workflow.t27; do t27c test-report \"$f\" --specs-dir apps/website/specs; done > emit-out/logs/test-report.log 2>&1 || true\n");
    n = raw(o, n, "\n");
    n = raw(o, n, "      # plumbing: the planted bugs of the negative controls, one sed line and one test-report on a copy each\n");
    n = raw(o, n, "      - name: Plant one bug per cap in a copy of the spec and test each copy\n");
    n = raw(o, n, "        run: |\n");
    n = raw(o, n, "          plant() { sed \"s/$2/$3/\" apps/website/specs/chat/course-chat.t27 > \"emit-out/negative/$1.t27\"; t27c test-report \"emit-out/negative/$1.t27\" --specs-dir apps/website/specs > \"emit-out/logs/bug-$1.log\" 2>&1 || true; }\n");
    n = raw(o, n, "          plant ip 'ip_count >= CHAT_PER_IP_HOUR' 'ip_count > CHAT_PER_IP_HOUR'\n");
    n = raw(o, n, "          plant key 'key_count >= CHAT_PER_KEY_DAY' 'key_count > CHAT_PER_KEY_DAY'\n");
    n = raw(o, n, "          plant global 'global_count >= CHAT_GLOBAL_DAY' 'global_count > CHAT_GLOBAL_DAY'\n");
    n = raw(o, n, "          plant turns 'turn >= CHAT_TURNS_MAX' 'turn > CHAT_TURNS_MAX'\n");
    n = raw(o, n, "          plant paid 'CHAT_PAID_FALLBACK : u32 = 0' 'CHAT_PAID_FALLBACK : u32 = 1'\n");
    n = raw(o, n, "          plant round 'border:1px solid #fff;border-radius:50%' 'border:1px solid #fff;border-radius:4px'\n");
    n = raw(o, n, "          plant tap 'CHAT_AVATAR_PX : u32 = 56' 'CHAT_AVATAR_PX : u32 = 32'\n");
    n = raw(o, n, "          plant send 'if (!up) { return ACT_REPROBE; }' 'if (!up) { return ACT_IGNORE; }'\n");
    n = raw(o, n, "          plant probe 'status == 503) { return REASON_OFF; }' 'status == 503) { return REASON_BUSY; }'\n");
    n = raw(o, n, "          plant gosize 'padding:0 14px;min-width:44px;min-height:44px' 'padding:0 14px;min-width:24px;min-height:24px'\n");
    n = raw(o, n, "\n");
    n = raw(o, n, "      # plumbing: gen-ts prints the module to stdout; its first line is the only one this job keeps apart\n");
    n = raw(o, n, "      - name: Emit courseChat.gen.ts\n");
    n = raw(o, n, "        run: |\n");
    n = raw(o, n, "          mkdir -p emit-out/apps/website/src/lib\n");
    n = raw(o, n, "          t27c gen-ts apps/website/specs/chat/course-chat.t27 > emit-out/apps/website/src/lib/courseChat.gen.ts 2> emit-out/logs/gen-ts.err || echo gen-ts >> emit-out/failed.txt\n");
    n = raw(o, n, "          cp emit-out/apps/website/src/lib/courseChat.gen.ts apps/website/src/lib/courseChat.gen.ts\n");
    n = raw(o, n, "          wc -c apps/website/src/lib/courseChat.gen.ts > emit-out/logs/sizes.txt\n");
    n = raw(o, n, "\n");
    n = raw(o, n, "      # plumbing: gen-text runs the spec's own function and writes the bytes it filled in\n");
    n = raw(o, n, "      - name: Emit this workflow from its spec\n");
    n = raw(o, n, "        run: t27c gen-text apps/website/specs/ci/course_chat_workflow.t27 --fn workflow_yml -o emit-out/workflow/emit-course-chat.yml || echo workflow >> emit-out/failed.txt\n");
    n = raw(o, n, "\n");
    return n;
}

/// Lines 101 to 144: the artifact upload and the gates.
pub fn wf_gates(o: []u8, n0: u32) -> u32 {
    var n : u32 = n0;
    n = raw(o, n, "      - name: Upload the module, the workflow and the logs\n");
    n = raw(o, n, "        if: always()\n");
    n = raw(o, n, "        uses: actions/upload-artifact@v4\n");
    n = raw(o, n, "        with:\n");
    n = raw(o, n, "          name: course-chat\n");
    n = raw(o, n, "          path: emit-out\n");
    n = raw(o, n, "          if-no-files-found: warn\n");
    n = raw(o, n, "\n");
    n = raw(o, n, "      - name: Gate, the module and the workflow emitted\n");
    n = raw(o, n, "        run: |\n");
    n = raw(o, n, "          if test -f emit-out/failed.txt; then cat emit-out/failed.txt; exit 1; fi\n");
    n = raw(o, n, "          test -s apps/website/src/lib/courseChat.gen.ts\n");
    n = raw(o, n, "          test -s emit-out/workflow/emit-course-chat.yml\n");
    n = raw(o, n, "\n");
    n = raw(o, n, "      # test-report prints FAIL <name>, FAIL <n>, BLOCKED <why> and tests <n>; a spec with no test is no proof\n");
    n = raw(o, n, "      - name: Gate, every test passed\n");
    n = raw(o, n, "        run: |\n");
    n = raw(o, n, "          grep -E '^  (FAIL  [^ ]|BLOCKED|FAIL +[1-9]|tests +0$)' emit-out/logs/test-report.log || true\n");
    n = raw(o, n, "          if grep -qE '^  (FAIL  [^ ]|BLOCKED|FAIL +[1-9]|tests +0$)' emit-out/logs/test-report.log; then exit 1; fi\n");
    n = raw(o, n, "          cat emit-out/logs/test-report.log\n");
    n = raw(o, n, "\n");
    n = raw(o, n, "      # FR-208: each planted bug must turn the suite red on its own test, and the copy must differ from the spec\n");
    n = raw(o, n, "      - name: Gate, each planted bug turns its own test red\n");
    n = raw(o, n, "        run: |\n");
    n = raw(o, n, "          grep -qE '^  FAIL  limit_per_ip_per_hour' emit-out/logs/bug-ip.log\n");
    n = raw(o, n, "          grep -qE '^  FAIL  limit_per_key_per_day' emit-out/logs/bug-key.log\n");
    n = raw(o, n, "          grep -qE '^  FAIL  limit_global_per_day' emit-out/logs/bug-global.log\n");
    n = raw(o, n, "          grep -qE '^  FAIL  limit_turns_per_conversation' emit-out/logs/bug-turns.log\n");
    n = raw(o, n, "          grep -qE '^  FAIL  never_a_paid_fallback' emit-out/logs/bug-paid.log\n");
    n = raw(o, n, "          grep -qE '^  FAIL  opener_is_a_circle_with_the_avatar' emit-out/logs/bug-round.log\n");
    n = raw(o, n, "          grep -qE '^  FAIL  opener_is_at_least_a_tap_target' emit-out/logs/bug-tap.log\n");
    n = raw(o, n, "          grep -qE '^  FAIL  a_message_is_kept_in_every_state' emit-out/logs/bug-send.log\n");
    n = raw(o, n, "          grep -qE '^  FAIL  an_offline_probe_says_offline_not_busy' emit-out/logs/bug-probe.log\n");
    n = raw(o, n, "          grep -qE '^  FAIL  send_is_a_real_button_with_a_tap_target' emit-out/logs/bug-gosize.log\n");
    n = raw(o, n, "          for n in ip key global turns paid round tap send probe gosize; do if grep -qE '^  BLOCKED' \"emit-out/logs/bug-$n.log\"; then exit 1; fi; if cmp -s apps/website/specs/chat/course-chat.t27 \"emit-out/negative/$n.t27\"; then exit 1; fi; done\n");
    n = raw(o, n, "\n");
    n = raw(o, n, "      # the committed module is the emitted one, byte for byte\n");
    n = raw(o, n, "      - name: Gate, the committed module equals the emitted one\n");
    n = raw(o, n, "        run: |\n");
    n = raw(o, n, "          git status --porcelain -- apps/website/src/lib/courseChat.gen.ts\n");
    n = raw(o, n, "          test -z \"$(git status --porcelain -- apps/website/src/lib/courseChat.gen.ts)\"\n");
    n = raw(o, n, "\n");
    n = raw(o, n, "      # the committed workflow is the emitted one, byte for byte; a hand edit must be seen\n");
    n = raw(o, n, "      - name: Gate, the committed workflow equals the one its spec writes\n");
    n = raw(o, n, "        run: |\n");
    n = raw(o, n, "          cmp emit-out/workflow/emit-course-chat.yml .github/workflows/emit-course-chat.yml\n");
    n = raw(o, n, "          cp .github/workflows/emit-course-chat.yml emit-out/negative/edited.yml\n");
    n = raw(o, n, "          echo '# edited by hand' >> emit-out/negative/edited.yml\n");
    n = raw(o, n, "          if cmp -s emit-out/workflow/emit-course-chat.yml emit-out/negative/edited.yml; then exit 1; fi\n");
    return n;
}

/// The whole workflow: the five sections in order. The workflow calls exactly this name.
pub fn workflow_yml(out: []u8) -> u32 {
    var n : u32 = wf_head(out, 0);
    n = wf_triggers(out, n);
    n = wf_setup(out, n);
    n = wf_test_and_emit(out, n);
    return wf_gates(out, n);
}

test the_workflow_is_written_whole {
    const n : u32 = workflow_yml(OUT[0..]);
    assert ok(n);
    assert n > 5000;
    assert pk_count(OUT[0..], n, "name: Course chat spec (t27c test-report and gen-ts)") == 1;
    assert pk_count(OUT[0..], n, "\njobs:\n") == 1;
    assert pk_count(OUT[0..], n, "\n    steps:\n") == 1;
}

test the_workflow_pins_the_t27_revision_and_the_zig_once {
    const n : u32 = workflow_yml(OUT[0..]);
    assert pk_count(OUT[0..], n, "06522649ba5006c206d89af4c70c45590461a691") == 1;
    assert pk_count(OUT[0..], n, "T27_ZIG_VERSION: 0.16.0") == 1;
}

test the_workflow_has_no_secret_and_no_write_permission {
    const n : u32 = workflow_yml(OUT[0..]);
    assert pk_count(OUT[0..], n, "secrets.") == 0;
    assert pk_count(OUT[0..], n, "pull_request_target") == 0;
    assert pk_count(OUT[0..], n, "contents: read") == 1;
    assert pk_count(OUT[0..], n, "contents: write") == 0;
}

test the_workflow_watches_both_specs_and_both_generated_files {
    const n : u32 = workflow_yml(OUT[0..]);
    assert pk_count(OUT[0..], n, "      - \"apps/website/specs/chat/**\"\n") == 1;
    assert pk_count(OUT[0..], n, "      - \"apps/website/specs/ci/**\"\n") == 1;
    assert pk_count(OUT[0..], n, "      - \"apps/website/src/lib/courseChat.gen.ts\"\n") == 1;
    assert pk_count(OUT[0..], n, "      - \".github/workflows/emit-course-chat.yml\"\n") == 1;
}

test one_planted_bug_per_cap_and_a_gate_for_each {
    const n : u32 = workflow_yml(OUT[0..]);
    assert pk_count(OUT[0..], n, "          plant ") == 10;
    assert pk_has(OUT[0..], n, "grep -qE '^  FAIL  limit_per_ip_per_hour' emit-out/logs/bug-ip.log");
    assert pk_has(OUT[0..], n, "grep -qE '^  FAIL  limit_per_key_per_day' emit-out/logs/bug-key.log");
    assert pk_has(OUT[0..], n, "grep -qE '^  FAIL  limit_global_per_day' emit-out/logs/bug-global.log");
    assert pk_has(OUT[0..], n, "grep -qE '^  FAIL  limit_turns_per_conversation' emit-out/logs/bug-turns.log");
    assert pk_has(OUT[0..], n, "grep -qE '^  FAIL  never_a_paid_fallback' emit-out/logs/bug-paid.log");
    assert pk_has(OUT[0..], n, "grep -qE '^  FAIL  opener_is_a_circle_with_the_avatar' emit-out/logs/bug-round.log");
    assert pk_has(OUT[0..], n, "grep -qE '^  FAIL  opener_is_at_least_a_tap_target' emit-out/logs/bug-tap.log");
    assert pk_has(OUT[0..], n, "grep -qE '^  FAIL  a_message_is_kept_in_every_state' emit-out/logs/bug-send.log");
    assert pk_has(OUT[0..], n, "grep -qE '^  FAIL  an_offline_probe_says_offline_not_busy' emit-out/logs/bug-probe.log");
    assert pk_has(OUT[0..], n, "grep -qE '^  FAIL  send_is_a_real_button_with_a_tap_target' emit-out/logs/bug-gosize.log");
    assert pk_has(OUT[0..], n, "for n in ip key global turns paid round tap send probe gosize; do");
    assert pk_count(OUT[0..], n, "grep -qE '^  FAIL  ") == 10;
}

test the_workflow_checks_its_own_bytes_and_sees_a_hand_edit {
    const n : u32 = workflow_yml(OUT[0..]);
    assert pk_has(OUT[0..], n, "t27c gen-text apps/website/specs/ci/course_chat_workflow.t27 --fn workflow_yml -o emit-out/workflow/emit-course-chat.yml");
    assert pk_has(OUT[0..], n, "cmp emit-out/workflow/emit-course-chat.yml .github/workflows/emit-course-chat.yml");
    assert pk_has(OUT[0..], n, "echo '# edited by hand' >> emit-out/negative/edited.yml");
    assert pk_has(OUT[0..], n, "if cmp -s emit-out/workflow/emit-course-chat.yml emit-out/negative/edited.yml; then exit 1; fi");
}

test the_file_ends_with_its_last_gate_and_has_no_blank_run {
    const n : u32 = workflow_yml(OUT[0..]);
    assert pk_count(OUT[0..], n, "negative/edited.yml; then exit 1; fi\n") == 1;
    assert pk_count(OUT[0..], n, "\n\n\n") == 0;
}

test a_buffer_that_is_too_small_gives_over_not_zero {
    var tiny : [64]u8 = [0; 64];
    assert workflow_yml(tiny[0..]) == OVER;
}
