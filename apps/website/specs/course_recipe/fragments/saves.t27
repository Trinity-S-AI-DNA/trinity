// SPDX-License-Identifier: Apache-2.0
; specs/course_recipe/fragments/saves.t27 -- module 3 "Save points with git" of the course "Vibecoding from zero with t27"
; A fragment: the words of 3 lessons, in the field names specs/course/ai-numbers.t27 uses per lesson
; (LESSON_IDS, LESSON_MODULES, LESSON_WIDGETS, LESSON_ALSO, LESSON_SPECS, LESSON_TITLES, LESSON_GOALS,
; LESSON_TEXTS, LESSON_TASKS) and per module (MODULE_ID, MODULE_TITLE, MODULE_LINE). The assembly step
; merges it into specs/course/vibecoding.t27; the Russian words are in saves-ru.t27.
; The book's ideas are paraphrased; no market figure and no real key appears. ASCII only, English only.
; DIGITS_* list, per lesson, the digits that appear in the field, in order: the Russian fragment must
; carry the same list.
; phi^2 + 1/phi^2 = 3 | TRINITY

module vibecoding_saves;

pub const KIND : str = "course-fragment";
pub const MODULE_ID : str = "saves";
pub const MODULE_TITLE : str = "Save points with git";
pub const MODULE_LINE : str = "A commit is a save point, a branch is a safe try, and a key is a pair of which one stays private.";

pub const LESSON_IDS : [3]str = ["a-commit-is-a-save", "a-branch-is-a-try", "a-key-is-a-pair"];
pub const LESSON_MODULES : [3]str = ["saves", "saves", "saves"];
pub const LESSON_WIDGETS : [3]str = ["vc-commit", "vc-branch", "vc-key-pair"];
pub const LESSON_ALSO : [3]str = ["", "", ""];
pub const LESSON_SPECS : [3]str = ["specs/vibecoding/commit.t27", "specs/vibecoding/branch.t27", "specs/vibecoding/key_pair.t27"];
pub const LESSON_TITLES : [3]str = ["A commit is a save point", "A branch is a safe try", "A key is a pair"];
pub const LESSON_GOALS : [3]str = [
    "What a commit keeps, why editing afterwards cannot change it, and when to make one.",
    "How a try on a branch is thrown away or merged, and why main is untouched until you choose.",
    "Why a key comes in two halves, which half you may share, and which half never leaves your machine."
];
pub const LESSON_TEXTS : [3]str = [
    "Vibecoding means an agent changes your files while you watch, and some changes break things. A commit is a save point: it keeps every file exactly as it was at that moment, and you can edit as much as you like afterwards, the saved copy does not change. In commit.t27 the file said 10 when it was committed; an agent then made it 99; going back returns 10, not 99. Each commit adds one save point to the history and overwrites nothing: after a third commit there are 3. Commit when the program runs, before you ask for the next change.",
    "A branch is a copy of your line of work where you can try something, and the main line stays as it was until you decide. In branch.t27 main holds 10 and an agent's try turns it into 99 on its own branch. If the try is bad you delete the branch and main still holds 10. If it is good you merge it and main holds 99. While you try there are 2 lines of work, main and the try; after either ending there is 1. Ask an agent for a risky change on a branch, not on main.",
    "To prove who you are to a code host without a password you make a key pair: a public half you hand out and a private half that never leaves your machine. The host keeps the public half and sends a challenge that only the private half can answer. In key_pair.t27 a pair has 2 halves, 1 is shared and 1 is kept, and 0 copies of the private half are ever sent to a host, a chat or a repository. The key text in the spec is a made-up placeholder, not a key. Never paste a real private half into a prompt: an agent that sees it has it."
];
pub const LESSON_TASKS : [3]str = [
    "In the widget, read the value of the file at the three moments and find the one where the agent's edit is undone; then in the spec frame find RESTORED and say what would change if it were set to EDITED.",
    "In the widget, compare the two endings in the table and say which one changes main; then in the spec frame plant the bug MAIN_AFTER_DISCARD = 99 and see which tests turn red.",
    "In the widget, find the half that may be pasted into a host and the half that goes nowhere; then in the spec frame plant PRIVATE_COPIES_SENT = 1 and read which test turns red."
];

; The digits of each field, in order of appearance (an empty string: none).
pub const DIGITS_TEXTS : [3]str = ["27 10 99 10 99 3", "27 10 99 10 99 2 1", "27 2 1 1 0"];
pub const DIGITS_TASKS : [3]str = ["", "99", "1"];

test the_module_is_saves_with_three_lessons {
    assert MODULE_ID == "saves";
    assert LESSON_IDS[0] == "a-commit-is-a-save";
    assert LESSON_IDS[2] == "a-key-is-a-pair";
    assert LESSON_MODULES[2] == "saves";
    assert LESSON_WIDGETS[2] == "vc-key-pair";
    assert LESSON_SPECS[2] == "specs/vibecoding/key_pair.t27";
}

test no_field_is_empty {
    assert MODULE_TITLE != "";
    assert MODULE_LINE != "";
    assert LESSON_TITLES[0] != "";
    assert LESSON_TITLES[2] != "";
    assert LESSON_GOALS[0] != "";
    assert LESSON_GOALS[1] != "";
    assert LESSON_GOALS[2] != "";
    assert LESSON_TEXTS[0] != "";
    assert LESSON_TEXTS[1] != "";
    assert LESSON_TEXTS[2] != "";
    assert LESSON_TASKS[0] != "";
    assert LESSON_TASKS[1] != "";
    assert LESSON_TASKS[2] != "";
}

test the_titles_match_the_plan {
    assert LESSON_TITLES[0] == "A commit is a save point";
    assert LESSON_TITLES[1] == "A branch is a safe try";
    assert LESSON_TITLES[2] == "A key is a pair";
}
