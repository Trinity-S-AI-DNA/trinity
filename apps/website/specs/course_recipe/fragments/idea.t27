// SPDX-License-Identifier: Apache-2.0
; specs/course_recipe/fragments/idea.t27 -- module 1 of the vibecoding course, English texts
; A fragment: the assembly step merges it into specs/course/vibecoding.t27 (lessons 1 to 3 of 27)
; and registers the three widgets in the gallery. The field names are those of
; specs/course/ai-numbers.t27. The Russian words are in idea-ru.t27, the same fields in the same order.
; Every number in a text is a constant of the lesson's spec (specs/vibecoding/) or arithmetic on one.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module vc_fragment_idea;

pub const MODULE_ID : str = "idea";
pub const MODULE_TITLE : str = "What vibecoding is";
pub const MODULE_LINE : str = "You describe, an agent writes, you run it and check. What a program is, and five myths put to a test.";
pub const LESSON_IDS : [3]str = ["what-vibecoding-is", "a-program-is-steps", "five-myths-tested"];
pub const LESSON_WIDGETS : [3]str = ["vc-describe-run-check", "vc-steps-in-order", "vc-myth-tests"];
pub const LESSON_ALSO : [3]str = ["", "", ""];
pub const LESSON_SPECS : [3]str = ["specs/vibecoding/describe_run_check.t27", "specs/vibecoding/steps_in_order.t27", "specs/vibecoding/myth_tests.t27"];

pub const LESSON_TITLES : [3]str = [
    "Describe, run, check",
    "A program is steps in order",
    "Five myths, each put to a test"
];
pub const LESSON_GOALS : [3]str = [
    "Vibecoding is a loop of three steps: you describe what you want, a program runs, and a check says yes or no.",
    "A program is a list of small steps done in order, and the order is part of what the program means.",
    "A sentence that sounds right can be settled by a small case and a test, so you can check a myth instead of arguing about it."
];
pub const LESSON_TEXTS : [3]str = [
    "Vibecoding means you describe what you want in plain words and an AI agent writes the program. Your part does not end there. You run it, and you check the result against your description, because a program can finish without an error and still be wrong. In the spec of this lesson a cafe tab is the number of drinks times the price of one drink: 3 drinks at 4 each is 12. A run that adds instead of multiplying prints 7, finishes cleanly, and is rejected by the check. The check is a test, and the test judges the result, not the person or the program that wrote it.",
    "A program is a list of small steps that the computer does one after another. Take the number 2. Add 3, then double it: you get 10. Double it, then add 3: you get 7. The same two steps in another order give another answer, so when you describe a program to an agent you describe the order too. A loop is one step written once and repeated: add 3 four times, from 2, gives 14. When a result surprises you, read the steps in order and find the first one that does not do what you meant.",
    "Five sentences about vibecoding sound right and are not. If it runs without an error, it is right: the average of 4 and 8 written as a plus b over 2 prints 8, and the answer is 6. One passing test proves the code is right: x times x equals x plus x at 2, and not at 3. The agent remembers the whole conversation: it reads a window, 8 messages of the 20 sent in this case. A step can always be undone: 7 halved and doubled is 6. A check that passes is a good check: one that says yes to everything also says yes to 2 against 3. Each myth is a small case, and a test settles it."
];
pub const LESSON_TASKS : [3]str = [
    "Open the spec in the player and run it: 3 tests pass. Then change RAN_TAB from 12 to 7 and run it again: the test the_run_matches_the_wish turns red. Put the 12 back.",
    "Find the three programs in the spec: add_then_double, double_then_add and add_three_n_times. Change LOOP_RESULT from 14 to 11 and run it: a_loop_is_one_step_repeated fails, because 11 is three steps, not four. Put the 14 back.",
    "Run the spec: 6 tests pass. Change AVG_RAN from 8 to 6 and run it: myth_1_runs_but_wrong fails, because the run no longer matches what the wrong program prints. Then write a sixth myth of your own as a case with numbers and a test."
];

; The digits of each text field, sorted, so the Russian words can be held to the same numbers.
pub const DIGITS_TITLES : [3]str = ["", "", ""];
pub const DIGITS_GOALS : [3]str = ["", "", ""];
pub const DIGITS_TEXTS : [3]str = ["12347", "0112233347", "02222334667888"];
pub const DIGITS_TASKS : [3]str = ["112237", "11111144", "1668"];

test the_module_has_three_lessons_in_order {
    assert MODULE_ID == "idea";
    assert LESSON_IDS[0] == "what-vibecoding-is";
    assert LESSON_IDS[2] == "five-myths-tested";
    assert LESSON_WIDGETS[2] == "vc-myth-tests";
    assert LESSON_ALSO[2] == "";
    assert LESSON_SPECS[2] == "specs/vibecoding/myth_tests.t27";
    assert LESSON_TITLES[2] == "Five myths, each put to a test";
}

test no_field_is_empty {
    assert MODULE_TITLE != "";
    assert MODULE_LINE != "";
    assert LESSON_TITLES[0] != "";
    assert LESSON_TITLES[1] != "";
    assert LESSON_GOALS[0] != "";
    assert LESSON_GOALS[1] != "";
    assert LESSON_GOALS[2] != "";
    assert LESSON_TEXTS[0] != "";
    assert LESSON_TEXTS[1] != "";
    assert LESSON_TEXTS[2] != "";
    assert LESSON_TASKS[0] != "";
    assert LESSON_TASKS[1] != "";
    assert LESSON_TASKS[2] != "";
}

test the_titles_and_goals_carry_no_number {
    assert DIGITS_TITLES[2] == "";
    assert DIGITS_GOALS[2] == "";
}

test the_digit_lists_are_the_ones_the_russian_file_must_match {
    assert DIGITS_TEXTS[0] == "12347";
    assert DIGITS_TEXTS[1] == "0112233347";
    assert DIGITS_TEXTS[2] == "02222334667888";
    assert DIGITS_TASKS[0] == "112237";
    assert DIGITS_TASKS[1] == "11111144";
    assert DIGITS_TASKS[2] == "1668";
}
