// SPDX-License-Identifier: Apache-2.0
; specs/course_recipe/fragments/desk.t27 -- module 2 "Your desk" of the vibecoding course, English
; Lessons 4 to 6 of specs/course/vibecoding.t27: the per-lesson fields, under the names
; specs/course/ai-numbers.t27 uses. The assembly step merges this fragment; the Russian words are
; in desk-ru.t27. LESSON_DIGITS lists the digits each text field carries, in order, and the
; Russian fragment must carry the same ones. ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module vc_desk_fragment;

pub const MODULE_ID : str = "desk";
pub const LESSON_IDS : [3]str = ["editor-with-an-agent", "ten-terminal-commands", "shortcuts-and-errors"];
pub const LESSON_WIDGETS : [3]str = ["vc-editor-agent", "vc-ten-commands", "vc-read-an-error"];
pub const LESSON_SPECS : [3]str = ["specs/vibecoding/editor_agent.t27", "specs/vibecoding/ten_commands.t27", "specs/vibecoding/read_an_error.t27"];

pub const LESSON_TITLES : [3]str = [
    "An editor with an agent beside it",
    "Ten terminal commands",
    "Shortcuts, and reading an error"
];
pub const LESSON_GOALS : [3]str = [
    "How to work with an agent in your editor: you describe the change, it edits, and you decide what stays.",
    "Ten terminal commands that cover a first day, and the one of them that cannot be undone.",
    "How to read an error message part by part, and four shortcuts that save time."
];
pub const LESSON_TEXTS : [3]str = [
    "An editor is where you read and change files. An agent sits beside it: you describe a change in words and it edits the files for you. It edits fast, but you are the one who keeps or rejects each change. The rule in the spec is two checks: can you read the whole change, and do the tests still pass? A change of 3 lines that passes is kept. A change of 12 lines that fails is sent back. A rewrite of 90 lines is sent back even when it passes, because nobody has read it. The spec sets the reading limit at 20 lines; pick your own and keep to it.",
    "The terminal is a window where you type a command and press Enter. Ten commands go a long way: pwd, ls, cd, mkdir, touch, cat, cp, mv, rm and clear. They are safe to try, with one exception: rm deletes a file with no undo, so read it twice before you press Enter. The spec lists all 10 with a one-line meaning each and marks exactly 1 of them as having no undo.",
    "An error message looks like noise, but it has 4 parts in the same order every time: the kind of error, what it says, the file and the line. The line is where the problem was noticed, so the cause can sit just above it: start reading 1 line before. Keep 4 shortcuts at hand: Cmd+S saves, Cmd+Z undoes, Ctrl+C stops a program in the terminal, and the up arrow brings back the previous command. When you ask your agent for help, paste the whole message, not a retelling of it."
];
pub const LESSON_TASKS : [3]str = [
    "In the spec, find READ_LIMIT and the three proposed changes. Change the last KEEP to 1 and run the player: the test that names a change too long to read fails. Then put it back to 0.",
    "In the spec, find the list NO_UNDO. Mark cat with a 1 as well and run the player: the test that counts the commands with no undo fails. Then put it back to 0.",
    "In the spec, find ERROR_LINE and START_LINE. Change START_LINE to 15 and run the player: the test that wants the start one line above the error fails. Then put it back to 13."
];
; The digits of each LESSON_TEXTS field, in order of appearance.
pub const LESSON_DIGITS : [3]str = ["3 12 90 20", "10 1", "4 1 4"];
; The digits of each LESSON_TASKS field, in order of appearance.
pub const TASK_DIGITS : [3]str = ["1 0", "1 0", "15 13"];

test the_module_has_three_lessons {
    assert LESSON_IDS[0] == "editor-with-an-agent";
    assert LESSON_IDS[2] == "shortcuts-and-errors";
    assert LESSON_WIDGETS[2] == "vc-read-an-error";
    assert LESSON_SPECS[2] == "specs/vibecoding/read_an_error.t27";
}

test every_field_has_text {
    assert LESSON_TITLES[0] != "";
    assert LESSON_TITLES[2] != "";
    assert LESSON_GOALS[0] != "";
    assert LESSON_GOALS[2] != "";
    assert LESSON_TEXTS[0] != "";
    assert LESSON_TEXTS[2] != "";
    assert LESSON_TASKS[0] != "";
    assert LESSON_TASKS[2] != "";
}

test the_digits_are_the_ones_the_text_carries {
    assert LESSON_DIGITS[0] == "3 12 90 20";
    assert LESSON_DIGITS[1] == "10 1";
    assert LESSON_DIGITS[2] == "4 1 4";
    assert TASK_DIGITS[2] == "15 13";
}
