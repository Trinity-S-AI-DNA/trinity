// SPDX-License-Identifier: Apache-2.0
; specs/course_recipe/fragments/judge-ru.t27 -- module "judge" of the vibecoding course, Russian text
; The one file of this module that carries Cyrillic: the assembly step moves these fields into the
; Russian bundle of the course (the site spec keeps its own words in English). Same field names as
; judge.t27; FIELD_DIGITS equals the English one, so no number changed in translation.
; phi^2 + 1/phi^2 = 3 | TRINITY

module course_fragment_judge_ru;

pub const MODULE_ID : str = "judge";
pub const LESSON_IDS : [3]str = ["a-test-is-the-judge", "plant-a-bug", "read-the-diff"];

pub const LESSON_TITLES : [3]str = [
    "Тест говорит да или нет",
    "Подложите баг и посмотрите, как тест краснеет",
    "Читайте diff, прежде чем принять"
];
pub const LESSON_GOALS : [3]str = [
    "Как тест сравнивает то, что дал код, с ответом, который вы записали заранее, и почему да значит только то, о чём тест спросил.",
    "Почему тест, который ни разу не падал, доказывает мало, и как один подложенный знак показывает, какой тест видит баг.",
    "Как читать diff агента рядом с вашей просьбой и замечать правку, о которой никто не просил."
];
pub const LESSON_TEXTS : [3]str = [
    "Вы просите агента написать функцию, которая даёт большее из двух чисел. Код пока не читайте: сначала запишите ответ, который ждёте для 3 и 9, это 9. Тест запускает код, а судья сравнивает: да, если вышло 9, нет, если что-то другое. Судья видит только ответ, поэтому да значит лишь одно: для этих входов код согласен с вами. Вторая версия функции с ошибкой, которая всегда отдаёт первое число, даёт 3, и судья говорит нет.",
    "Тест, который ни разу не падал, может смотреть не туда. Возьмите правило, что взрослый это 18 лет и старше, и подложите баг: поменяйте знак так, чтобы сам возраст 18 уже не считался. Слабый тест на возрастах 30 и 5 остаётся зелёным с багом, потому что оба возраста далеко от границы. Тест на возраст 18 краснеет. Баги живут на границах, поставьте тест туда и подложите баг, чтобы увидеть, как он падает.",
    "Агент говорит готово и показывает diff: строки, которые он убрал, и строки, которые добавил. Читайте его рядом с просьбой. Если вы просили изменить строки с 10 по 20, а diff задевает ещё и строку 40, это правка, о которой никто не просил, и теперь её надо прочитать. Принимайте diff, где каждая тронутая строка есть в просьбе. Остальные возвращайте или спросите, зачем. Даже чистый diff всё равно проходит через тесты."
];
pub const LESSON_TASKS : [3]str = [
    "Запишите свой ответ для 3 и 9, запустите обе версии и прочитайте, что судья говорит каждой. Потом попробуйте 9 и 3 и посмотрите, какая версия всё равно получит да.",
    "Поменяйте знак, запустите слабые тесты и тест на границе и посмотрите, какой покраснел. Верните знак и увидите, что все три зелёные. В спецификации найдите тест, который утверждает, что возраст 18 теряется при подложенном правиле.",
    "Прочитайте два diff рядом с просьбой про строки с 10 по 20, отметьте строки вне её, затем примите один diff и верните другой. В спецификации найдите номер строки, которую неряшливый diff задевает вне просьбы."
];
pub const FIELD_DIGITS : [12]str = ["", "", "", "", "", "", "39993", "181830518", "102040", "3993", "18", "1020"];

test every_russian_field_is_filled {
    assert LESSON_TITLES[0] != "";
    assert LESSON_TITLES[1] != "";
    assert LESSON_TITLES[2] != "";
    assert LESSON_GOALS[0] != "";
    assert LESSON_GOALS[1] != "";
    assert LESSON_GOALS[2] != "";
    assert LESSON_TEXTS[0] != "";
    assert LESSON_TEXTS[1] != "";
    assert LESSON_TEXTS[2] != "";
    assert LESSON_TASKS[0] != "";
    assert LESSON_TASKS[1] != "";
    assert LESSON_TASKS[2] != "";
}

test the_ids_match_the_english_fragment {
    assert LESSON_IDS[0] == "a-test-is-the-judge";
    assert LESSON_IDS[2] == "read-the-diff";
}

test the_digits_equal_the_english_ones_field_by_field {
    assert FIELD_DIGITS[6] == "39993";
    assert FIELD_DIGITS[7] == "181830518";
    assert FIELD_DIGITS[8] == "102040";
    assert FIELD_DIGITS[9] == "3993";
    assert FIELD_DIGITS[10] == "18";
    assert FIELD_DIGITS[11] == "1020";
}
