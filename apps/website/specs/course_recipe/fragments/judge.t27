// SPDX-License-Identifier: Apache-2.0
; specs/course_recipe/fragments/judge.t27 -- module "judge" (A test as the judge) of the vibecoding course, English
; A fragment: the assembly step merges the three lessons below into specs/course/vibecoding.t27.
; Lesson order and ids come from specs/course_recipe/vibecoding-plan.t27 (a-test-is-the-judge,
; plant-a-bug, read-the-diff); the field names are the per-lesson fields of specs/course/ai-numbers.t27.
; FIELD_DIGITS lists, field by field (titles, goals, texts, tasks; three lessons each), the digits
; of the text in the order they occur, so the Russian fragment can be held to the same numbers.
; phi^2 + 1/phi^2 = 3 | TRINITY

module course_fragment_judge;

pub const MODULE_ID : str = "judge";
pub const LESSON_IDS : [3]str = ["a-test-is-the-judge", "plant-a-bug", "read-the-diff"];
pub const LESSON_WIDGETS : [3]str = ["vc-test-judge", "vc-plant-bug", "vc-read-diff"];
pub const LESSON_SPECS : [3]str = ["specs/vibecoding/test_judge.t27", "specs/vibecoding/plant_bug.t27", "specs/vibecoding/read_diff.t27"];

pub const LESSON_TITLES : [3]str = [
    "A test says yes or no",
    "Plant a bug and watch it fail",
    "Read the diff before you accept it"
];
pub const LESSON_GOALS : [3]str = [
    "How a test compares what the code gave with the answer you wrote down first, and why a yes means only what the test asked.",
    "Why a test that has never failed proves little, and how one planted sign shows which test can see a bug.",
    "How to read an agent's diff against your request and spot a change nobody asked for."
];
pub const LESSON_TEXTS : [3]str = [
    "You ask an agent for a function that gives the larger of two numbers. Do not read its code yet: first write down the answer you expect for 3 and 9, which is 9. A test runs the code and the judge compares: yes if it gave 9, no if it gave anything else. The judge sees only the answer, so a yes means the code agrees with you for those inputs and nothing more. A second version of the function with a slip in it, always giving the first number, gives 3, and the judge says no.",
    "A test that has never failed may be looking in the wrong place. Take the rule that an adult is 18 or older and plant a bug: change the sign so that 18 itself no longer counts. A weak test on ages 30 and 5 stays green with the bug in, because neither age is near the edge. A test on age 18 turns red. Bugs live at edges, so put a test there, and plant a bug to see it fail.",
    "An agent says done and shows a diff: the lines it removed and the lines it added. Read it against what you asked for. If you asked for a change to lines 10 to 20 and the diff also touches line 40, that is a change nobody requested, and now you have to read it. Accept a diff whose every touched line is in the request. Send back one that is not, or ask why. Even a clean diff still goes through the tests."
];
pub const LESSON_TASKS : [3]str = [
    "Write down your answer for 3 and 9, run both versions, and read what the judge says to each. Then try 9 and 3 and see which version still gets a yes.",
    "Flip the sign, run the weak tests and the boundary test, and see which one turns red. Then put the sign back and see all three go green. In the spec, find the test that asserts age 18 is lost to the planted rule.",
    "Read the two diffs against the request for lines 10 to 20, mark the lines outside it, then accept one diff and send the other back. In the spec, find the line number the sprawling diff touches outside the request."
];
pub const FIELD_DIGITS : [12]str = ["", "", "", "", "", "", "39993", "181830518", "102040", "3993", "18", "1020"];

test every_field_has_three_lessons_and_none_is_empty {
    assert LESSON_TITLES[0] != "";
    assert LESSON_TITLES[2] != "";
    assert LESSON_GOALS[0] != "";
    assert LESSON_GOALS[2] != "";
    assert LESSON_TEXTS[0] != "";
    assert LESSON_TEXTS[2] != "";
    assert LESSON_TASKS[0] != "";
    assert LESSON_TASKS[2] != "";
}

test the_ids_match_the_plan {
    assert LESSON_IDS[0] == "a-test-is-the-judge";
    assert LESSON_IDS[1] == "plant-a-bug";
    assert LESSON_IDS[2] == "read-the-diff";
    assert LESSON_WIDGETS[2] == "vc-read-diff";
    assert LESSON_SPECS[2] == "specs/vibecoding/read_diff.t27";
}

test the_middle_lessons_are_not_empty {
    assert LESSON_TITLES[1] != "";
    assert LESSON_GOALS[1] != "";
    assert LESSON_TEXTS[1] != "";
    assert LESSON_TASKS[1] != "";
}

test the_digits_of_the_texts_are_recorded {
    assert FIELD_DIGITS[6] == "39993";
    assert FIELD_DIGITS[11] == "1020";
}
