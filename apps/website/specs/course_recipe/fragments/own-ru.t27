// SPDX-License-Identifier: Apache-2.0
; specs/course_recipe/fragments/own-ru.t27 -- the Russian words of own.t27 (module 9, "Your own project",
; lessons 25 to 27 of the Vibecoding from zero course). The same field names as own.t27, the same lesson
; order. This is the one file of the lane that carries Cyrillic: the Russian text of the course, kept as
; constants so that an assembly step merges it into the Russian contract. Each field keeps the digits of
; its English field, digit for digit; the sorted digits of every text and task are listed below and tested.
; Code names (IDEA_TESTS, KEPT, PROMISED) and widget words stay in English.
; phi^2 + 1/phi^2 = 3 | TRINITY

module vibecoding_fragment_own_ru;

pub const KIND : str = "course-fragment-i18n";
pub const LOCALE : str = "ru";
pub const SOURCE_LOCALE : str = "en";
pub const SOURCE_SPEC : str = "specs/course_recipe/fragments/own.t27";
pub const MODULE_ID : str = "own";
pub const LESSON_TITLES : [3]str = [
    "Спецификация вашей идеи",
    "Постройте, затем измерьте одно",
    "Честный план на следующий месяц"
];
pub const LESSON_GOALS : [3]str = [
    "Как сказать идею как один вход, один выход и один тест, и почему идея без теста не готова к передаче агенту.",
    "Почему одно число, прочитанное из запуска, лучше ощущения, и чего один запуск сказать не может.",
    "Как написать план, где каждая строка либо измерена, либо прямо названа неизвестной, и нет обещаний о будущем."
];
pub const LESSON_TEXTS : [3]str = [
    "Агент может построить только то, что вы умеете сказать. Самое малое, что можно сказать об идее, состоит из трёх частей: один вход, один выход и один тест, который говорит, что работа закончена. Возьмём выдуманный дневник чтения: вход это одно название книги, выход это сколько книг записано, а тест в том, что после одного названия счёт равен 1. Спецификация этого урока держит эти три части числами и проверяет их 4 тестами. Готово значит по одному каждого: 1 x 1 x 1 = 1. Поставьте число тестов 0, и тесты, которые его называют, покраснеют, потому что идея без теста не готова к передаче. Ваша идея может быть такой же маленькой.",
    "Когда проект запускается, выберите одну вещь для измерения и прочитайте её из самого запуска. Выдуманный пример: дневник чтения запустили на 4 названиях, и он сохранил 3. Доля сохранённых равна 3 x 100 / 4 = 75 из 100. Это весь факт: один запуск, одно число. Он не говорит, что даст следующий запуск, поэтому виджет пишет об этом: пока ничего. В спецификации 3 теста: для измерения нужен хотя бы один запуск, запуск не может сохранить больше, чем ему дали, и доля читается из запуска. Поставьте KEPT равным 5, и два из них покраснеют.",
    "План на следующий месяц честный, когда каждая строка одного из двух видов: то, что вы измерили, с запуском, который это напечатал, или то, чего вы пока не знаете, с запуском, который это покажет. Строке, которая обещает результат, которого никто не измерял, в плане не место. В выдуманном плане для дневника чтения 5 строк: 2 измерены, 3 неизвестны и 0 обещаны, и 2 + 3 + 0 = 5. В спецификации 4 теста: строки складываются в план, что-то измерено, что-то неизвестно и ничего не обещано. Поставьте PROMISED равным 1, и два из них покраснеют. Этот урок не даёт прогноза никакого рода: это способ писать, а не предсказание."
];
pub const LESSON_TASKS : [3]str = [
    "В спецификации поставьте IDEA_TESTS равным 0 и прочитайте, какие 2 теста падают; затем верните как было. Потом запишите свою идею как один вход, один выход и один тест, по одному предложению на каждый.",
    "В спецификации поставьте KEPT равным 5 и прочитайте 2 теста, которые падают; затем верните как было. Выберите одну вещь в своём проекте, которую запуск может напечатать, и запишите, как вы её прочитаете.",
    "В спецификации поставьте PROMISED равным 1 и прочитайте 2 теста, которые падают; затем верните как было. Напишите 5 строк для своего проекта и пометьте каждую измеренной или неизвестной; если строка ни то ни другое, вычеркните её."
];

; The digits of each text and task, sorted. Checked against the field with grep when the file was written;
; the assembly step compares the whole multiset again.
pub const TEXT_DIGITS : [3]str = ["0111114", "00001133344557", "0012233455"];
pub const TASK_DIGITS : [3]str = ["02", "25", "125"];

test the_fragment_is_the_russian_of_the_own_module {
    assert LOCALE == "ru";
    assert SOURCE_LOCALE == "en";
    assert MODULE_ID == "own";
}

test every_title_is_filled {
    assert LESSON_TITLES[0] != "";
    assert LESSON_TITLES[1] != "";
    assert LESSON_TITLES[2] != "";
}

test every_goal_is_filled {
    assert LESSON_GOALS[0] != "";
    assert LESSON_GOALS[1] != "";
    assert LESSON_GOALS[2] != "";
}

test every_text_is_filled {
    assert LESSON_TEXTS[0] != "";
    assert LESSON_TEXTS[1] != "";
    assert LESSON_TEXTS[2] != "";
}

test every_task_is_filled {
    assert LESSON_TASKS[0] != "";
    assert LESSON_TASKS[1] != "";
    assert LESSON_TASKS[2] != "";
}

test the_digit_lists_name_every_text_and_task {
    assert TEXT_DIGITS[0] == "0111114";
    assert TEXT_DIGITS[1] == "00001133344557";
    assert TEXT_DIGITS[2] == "0012233455";
    assert TASK_DIGITS[0] == "02";
    assert TASK_DIGITS[1] == "25";
    assert TASK_DIGITS[2] == "125";
}
