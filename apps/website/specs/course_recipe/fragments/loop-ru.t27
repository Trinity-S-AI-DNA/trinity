// SPDX-License-Identifier: Apache-2.0
; specs/course_recipe/fragments/loop-ru.t27 -- Russian words of the three lessons of module "loop"
; Pair of loop.t27: same field names, same order, one entry per lesson. This is the one file of the
; course lane that carries Cyrillic (owner's brief). Every number is the number of the English
; field, digit for digit: DIGITS_* repeat the sorted digit strings of loop.t27 and the tests pin them.
; phi^2 + 1/phi^2 = 3 | TRINITY

module vibecoding_fragment_loop_ru;

pub const MODULE_ID : str = "loop";
pub const LOCALE : str = "ru";
pub const SOURCE_FRAGMENT : str = "specs/course_recipe/fragments/loop.t27";

pub const LESSON_TITLES : [3]str = [
    "Четыре фазы: идея, сборка, проверка, выпуск",
    "Спросить, запустить, прочитать, исправить",
    "Когда вы застряли"
];
pub const LESSON_GOALS : [3]str = [
    "Почему работа проходит четыре фазы по порядку и почему упавший тест возвращает её к сборке, а не вперёд к выпуску.",
    "Как круг «спросить, запустить, прочитать, исправить» убирает по одной проблеме и почему круг без чтения результата прячет остальные.",
    "Как считать, сколько раз подряд вернулась одна и та же ошибка, и как этот счёт выбирает ваш следующий ход: прочитать, попросить меньше, вернуться к точке сохранения, начать заново."
];
pub const LESSON_TEXTS : [3]str = [
    "У любой работы с агентом одни и те же четыре фазы. Идея: вы одним предложением говорите, чего хотите. Сборка: агент пишет один небольшой кусок. Проверка: вы запускаете его, и тест отвечает да или нет. Выпуск: вы сохраняете результат и кладёте его туда, где им пользуются. Фазы идут не по прямой. Когда тест говорит нет, работа возвращается к сборке, а не идёт вперёд к выпуску, и круг начинается снова. В спеке этого урока две таблицы: куда переходит каждая фаза, когда тесты прошли, и куда, когда они упали. Плеер запускает её 4 теста. Измените одну запись таблицы падения так, чтобы упавший тест вёл к выпуску, и ровно один тест покраснеет.",
    "В круге 4 шага. Попросите агента об одном изменении. Запустите программу. Прочитайте всё, что вернулось. Исправьте одну проблему и идите по кругу снова. Каждый круг убирает одну проблему, поэтому программа с 3 проблемами станет зелёной через 3 круга. Спека держит таблицу того, сколько проблем осталось после каждого круга: 3, 2, 1, 0. Короткий путь, который ломает круг, это круг, где сказано «готово», а результат не прочитан. В виджете можно выключить чтение и увидеть, как счётчик врёт. В спеке тот же короткий путь это одно изменённое число, и ровно один тест краснеет.",
    "Застрять нормально; ходить по кругу это сигнал сменить действие. Считайте, сколько раз подряд вернулась одна и та же ошибка. В первый раз прочитайте ошибку и скажите своими словами, что она утверждает. Во второй раз попросите шаг поменьше. В третий раз вернитесь к последней точке сохранения, к коммиту, который работал. После этого начните новый разговор с короткой сводкой и одной этой ошибкой. Другая ошибка обнуляет счёт, потому что вы прошли предыдущую. Спека держит это как таблицу ходов, где индекс это счёт, и её 4 теста проверяют каждую ступень."
];
pub const LESSON_TASKS : [3]str = [
    "Откройте виджет и проведите идею до выпуска с одним упавшим тестом по пути; посчитайте шаги. Затем в спеке найдите запись таблицы падения, которая возвращает упавший тест к сборке, замените её на 3 и прочитайте, какой тест покраснел.",
    "Пройдите в виджете три круга, затем выключите чтение и пройдите один круг. В спеке замените 1 в таблице на 0 и назовите тест, который покраснел.",
    "В виджете нажмите три раза «та же ошибка» и назовите ход, который он выбирает. Потом нажмите «другая ошибка» и посмотрите, как счёт начнётся заново. В спеке замените ход для счёта 3 с 2 на 1 и прочитайте, какой тест покраснел."
];

pub const DIGITS_TITLES : [3]str = ["", "", ""];
pub const DIGITS_GOALS : [3]str = ["", "", ""];
pub const DIGITS_TEXTS : [3]str = ["4", "0123334", "4"];
pub const DIGITS_TASKS : [3]str = ["3", "01", "123"];

test every_field_is_filled_for_every_lesson {
    assert LESSON_TITLES[0] != "";
    assert LESSON_TITLES[1] != "";
    assert LESSON_TITLES[2] != "";
    assert LESSON_GOALS[0] != "";
    assert LESSON_GOALS[1] != "";
    assert LESSON_GOALS[2] != "";
    assert LESSON_TEXTS[0] != "";
    assert LESSON_TEXTS[1] != "";
    assert LESSON_TEXTS[2] != "";
    assert LESSON_TASKS[0] != "";
    assert LESSON_TASKS[1] != "";
    assert LESSON_TASKS[2] != "";
}

test the_digits_equal_the_english_ones {
    assert DIGITS_TEXTS[0] == "4";
    assert DIGITS_TEXTS[1] == "0123334";
    assert DIGITS_TEXTS[2] == "4";
    assert DIGITS_TASKS[0] == "3";
    assert DIGITS_TASKS[1] == "01";
    assert DIGITS_TASKS[2] == "123";
    assert DIGITS_TITLES[2] == "";
    assert DIGITS_GOALS[2] == "";
}
