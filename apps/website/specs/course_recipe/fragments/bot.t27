// SPDX-License-Identifier: Apache-2.0
; specs/course_recipe/fragments/bot.t27 -- the words of module 8, "A first bot", English
; A fragment of the course Vibecoding from zero (specs/course_recipe/vibecoding-plan.t27). The
; assembly step merges the three entries of each field into the positions 21, 22 and 23 (zero-based)
; of the same-named array in specs/course/vibecoding.t27. The field names are the ones
; specs/course/ai-numbers.t27 uses per lesson; the ids, widgets and spec paths stay in the plan.
; The Russian words live in bot-ru.t27. Numbers on the page come from the lesson specs: the message
; codes and the inbox of message_loop.t27, the three commands and three checks of spec_to_bot.t27.
; No income, market or success figure appears; no hand-written TypeScript or Python is carried over
; from the book. ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module vc_fragment_bot;

pub const KIND : str = "course-fragment";
pub const MODULE_ID : str = "bot";
pub const LESSON_IDS : [3]str = ["a-bot-is-a-message-loop", "from-spec-to-bot", "secrets-stay-out"];
pub const LESSON_COUNT : u8 = 3;

pub const LESSON_TITLES : [3]str = [
    "A bot is a message loop",
    "From a spec to a bot",
    "Secrets stay out of the repository and the prompt"
];

pub const LESSON_GOALS : [3]str = [
    "How a bot waits for a message, picks a reply from a table and goes back to waiting, and why the same message always gets the same reply.",
    "Why a bot starts as a table of commands and replies, and how three checks catch a bad table before any bot exists.",
    "Why the name of a secret may live in the repository while its value may not, whether in a file or in a prompt."
];

pub const LESSON_TEXTS : [3]str = [
    "A bot is not magic. It is a loop with four beats: wait for a message, read it, pick a reply, send it, and wait again. In message_loop.t27 a message is a small number: 1 is start, 2 is help, 3 is stop, and anything else is not understood. A table maps each message to a reply, so one turn of the loop is one lookup. The inbox holds 5 messages and the loop stops at the stop message, so it answers 4. Send the widget a few messages and notice that the same message always gets the same reply.",
    "You do not write a bot, you describe it. spec_to_bot.t27 lists 3 commands and the reply each one gets, as data. Before anything is generated, 3 checks run on that description: every command has a reply, no two commands share a reply, and the number of routes equals the number of commands. A description that fails a check would make a wrong bot, so the table is fixed first and the bot is generated afterwards. Blank a reply in the widget and see which check turns red.",
    "A secret is a value that opens something, such as the token of a bot. The code names it, BOT_TOKEN, and never holds it. The value lives in a file called .env on your machine, and git is told to ignore that file. The repository keeps only .env.example, with a made-up placeholder. In secrets_out.t27 a file that holds a secret is never a file git saves, and the same goes for a message to an agent: write the name of the secret, not its value. A secret that was ever saved or pasted must be treated as lost and replaced."
];

pub const LESSON_TASKS : [3]str = [
    "Send start, then help, then an unknown word, then stop, and count the replies. In the spec frame, find the inbox and the index of its stop message, and the test that turns red when two commands share a reply.",
    "Blank one reply and name the check that turns red. In the spec frame, find the test that a missing reply breaks, and the one line you would change to plant that bug.",
    "Switch the real settings file to saved and read the alarm. In the spec frame, find the test that fails when TRACKED says the real settings file is saved, and the line you would change to plant it."
];

; The digits of each field in reading order, so a translation can be checked against them: the
; Russian bundle must carry the same digits, in the same order, for each field (see bot-ru.t27).
pub const DIGITS_TITLES : [3]str = ["", "", ""];
pub const DIGITS_GOALS : [3]str = ["", "", ""];
pub const DIGITS_TEXTS : [3]str = ["2712354", "2733", "27"];
pub const DIGITS_TASKS : [3]str = ["", "", ""];

test the_module_has_three_lessons {
    assert LESSON_COUNT == 3;
    assert LESSON_IDS[0] == "a-bot-is-a-message-loop";
    assert LESSON_IDS[LESSON_COUNT - 1] == "secrets-stay-out";
}

test the_titles_follow_the_plan {
    assert LESSON_TITLES[0] == "A bot is a message loop";
    assert LESSON_TITLES[1] == "From a spec to a bot";
    assert LESSON_TITLES[2] == "Secrets stay out of the repository and the prompt";
}

test no_field_is_empty {
    assert LESSON_TITLES[0] != "";
    assert LESSON_TITLES[1] != "";
    assert LESSON_TITLES[2] != "";
    assert LESSON_GOALS[0] != "";
    assert LESSON_GOALS[1] != "";
    assert LESSON_GOALS[2] != "";
    assert LESSON_TEXTS[0] != "";
    assert LESSON_TEXTS[1] != "";
    assert LESSON_TEXTS[2] != "";
    assert LESSON_TASKS[0] != "";
    assert LESSON_TASKS[1] != "";
    assert LESSON_TASKS[2] != "";
}

; The digits the texts quote are the constants of the lesson specs: message codes 1, 2, 3, an inbox
; of 5 messages and 4 answers; then 3 commands and 3 checks.
test the_text_digits_are_the_specs_constants {
    assert DIGITS_TEXTS[0] == "2712354";
    assert DIGITS_TEXTS[1] == "2733";
    assert DIGITS_TEXTS[2] == "27";
}
