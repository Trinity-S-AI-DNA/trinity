// SPDX-License-Identifier: Apache-2.0
; specs/course_recipe/fragments/own.t27 -- module 9, "Your own project", lessons 25 to 27 of the
; Vibecoding from zero course (specs/course_recipe/vibecoding-plan.t27). A fragment: an assembly step
; merges these per-lesson arrays into the three slots of specs/course/vibecoding.t27 that belong to
; the own module. The field names are the ones specs/course/ai-numbers.t27 uses per lesson.
; The lesson order here is the plan's: a-spec-for-your-idea, build-and-measure, an-honest-plan.
; Every number in a text is a constant of the lesson's spec or arithmetic on one; no income, market
; size, growth rate or success story is claimed anywhere. ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module vibecoding_fragment_own;

pub const KIND : str = "course-fragment";
pub const MODULE_ID : str = "own";
pub const LESSON_IDS : [3]str = ["a-spec-for-your-idea", "build-and-measure", "an-honest-plan"];
pub const LESSON_WIDGETS : [3]str = ["vc-own-spec", "vc-measure", "vc-honest-plan"];
pub const LESSON_SPECS : [3]str = ["specs/vibecoding/own_spec.t27", "specs/vibecoding/measure.t27", "specs/vibecoding/honest_plan.t27"];
pub const LESSON_ALSO : [3]str = ["", "", ""];
pub const LESSON_TITLES : [3]str = [
    "A spec for your own idea",
    "Build it, then measure one thing",
    "An honest plan for the next month"
];
pub const LESSON_GOALS : [3]str = [
    "How to say an idea as one input, one output and one test, and why an idea with no test is not ready to hand to an agent.",
    "Why one number read from a run beats a feeling, and what one run cannot tell you.",
    "How to write a plan whose every line is either measured or plainly not known yet, with no promise about the future."
];
pub const LESSON_TEXTS : [3]str = [
    "An agent can build only what you can say. The smallest thing you can say about an idea has three parts: one input, one output and one test that tells you it is done. Take a made-up reading log: the input is one book title, the output is how many books are logged, and the test is that after one title the count is 1. The spec of this lesson holds those three as numbers and checks them with 4 tests. Ready means one of each: 1 x 1 x 1 = 1. Set the test count to 0 and the tests that name it go red, because an idea with no test is not ready to hand over. Your own idea can be as small as this one.",
    "When your project runs, pick one thing to measure and read it from the run itself. Made-up example: the reading log was run on 4 titles and kept 3. The share kept is 3 x 100 / 4 = 75 out of 100. That is the whole fact: one run, one number. It does not say what the next run will give, so the widget lists that as nothing yet. The spec has 3 tests: a measure needs at least one run, a run cannot keep more than it was given, and the share is read from the run. Set KEPT to 5 and two of them go red.",
    "A plan for the next month is honest when each line is one of two kinds: a thing you measured, with the run that printed it, or a thing you do not know yet, with the run that would tell you. A line that promises a result nobody has measured does not belong in it. The made-up plan for the reading log has 5 lines: 2 measured, 3 unknown and 0 promised, and 2 + 3 + 0 = 5. The spec has 4 tests: the lines add up, something is measured, something is unknown and nothing is promised. Set PROMISED to 1 and two of them go red. This lesson gives no forecast of any kind: it is a way of writing, not a prediction."
];
pub const LESSON_TASKS : [3]str = [
    "In the spec, set IDEA_TESTS to 0 and read which 2 tests fail; then put it back. Then write your own idea as one input, one output and one test, one sentence each.",
    "In the spec, set KEPT to 5 and read the 2 tests that fail; then put it back. Pick one thing in your own project that a run can print, and write down how you will read it.",
    "In the spec, set PROMISED to 1 and read the 2 tests that fail; then put it back. Write 5 lines for your own project and mark each one measured or unknown; if a line is neither, cross it out."
];

; The digits of each text and task, sorted. Checked against the field with grep when the file was written;
; the assembly step compares the whole multiset again.
pub const TEXT_DIGITS : [3]str = ["0111114", "00001133344557", "0012233455"];
pub const TASK_DIGITS : [3]str = ["02", "25", "125"];

test the_fragment_has_three_lessons_of_the_own_module {
    assert MODULE_ID == "own";
    assert LESSON_IDS[0] == "a-spec-for-your-idea";
    assert LESSON_IDS[2] == "an-honest-plan";
    assert LESSON_WIDGETS[2] == "vc-honest-plan";
    assert LESSON_SPECS[2] == "specs/vibecoding/honest_plan.t27";
    assert LESSON_ALSO[2] == "";
}

test every_title_is_filled {
    assert LESSON_TITLES[0] != "";
    assert LESSON_TITLES[1] != "";
    assert LESSON_TITLES[2] != "";
}

test every_goal_is_filled {
    assert LESSON_GOALS[0] != "";
    assert LESSON_GOALS[1] != "";
    assert LESSON_GOALS[2] != "";
}

test every_text_is_filled {
    assert LESSON_TEXTS[0] != "";
    assert LESSON_TEXTS[1] != "";
    assert LESSON_TEXTS[2] != "";
}

test every_task_is_filled {
    assert LESSON_TASKS[0] != "";
    assert LESSON_TASKS[1] != "";
    assert LESSON_TASKS[2] != "";
}

test the_numbers_the_texts_quote_are_arithmetic_of_the_specs {
    assert 1 * 1 * 1 == 1;
    assert 3 * 100 / 4 == 75;
    assert 2 + 3 + 0 == 5;
}

test the_digit_lists_name_every_text_and_task {
    assert TEXT_DIGITS[0] == "0111114";
    assert TEXT_DIGITS[1] == "00001133344557";
    assert TEXT_DIGITS[2] == "0012233455";
    assert TASK_DIGITS[0] == "02";
    assert TASK_DIGITS[1] == "25";
    assert TASK_DIGITS[2] == "125";
}
