// SPDX-License-Identifier: Apache-2.0
; specs/course_recipe/fragments/desk-ru.t27 -- module 2 "Your desk" of the vibecoding course, Russian
; The same fields as desk.t27, translated. Only this file carries Cyrillic. LESSON_DIGITS and
; TASK_DIGITS list the digits of each field and must equal the English fragment's.
; phi^2 + 1/phi^2 = 3 | TRINITY

module vc_desk_fragment_ru;

pub const MODULE_ID : str = "desk";

pub const LESSON_TITLES : [3]str = [
    "Редактор с агентом рядом",
    "Десять команд терминала",
    "Горячие клавиши и чтение ошибки"
];
pub const LESSON_GOALS : [3]str = [
    "Как работать с агентом в редакторе: вы описываете изменение, он правит, а что останется, решаете вы.",
    "Десять команд терминала на первый день и та из них, которую нельзя отменить.",
    "Как читать сообщение об ошибке по частям и четыре горячие клавиши, которые экономят время."
];
pub const LESSON_TEXTS : [3]str = [
    "Редактор - это место, где вы читаете и меняете файлы. Агент сидит рядом: вы описываете изменение словами, а он правит файлы за вас. Он правит быстро, но принимать или отклонять каждое изменение - ваше дело. Правило в спеке - две проверки: можете ли вы прочитать изменение целиком и проходят ли по-прежнему тесты? Изменение в 3 строки, которое проходит, принимается. Изменение в 12 строк, которое не проходит, возвращается. Переписывание на 90 строк возвращается, даже если проходит, потому что никто его не прочитал. Спека ставит предел чтения в 20 строк; выберите свой и держитесь его.",
    "Терминал - это окно, где вы набираете команду и нажимаете Enter. Десять команд дают очень многое: pwd, ls, cd, mkdir, touch, cat, cp, mv, rm и clear. Их безопасно пробовать, кроме одной: rm удаляет файл без отмены, поэтому прочитайте её дважды, прежде чем нажать Enter. Спека перечисляет все 10 с кратким смыслом каждой и отмечает ровно 1 из них как команду без отмены.",
    "Сообщение об ошибке похоже на шум, но в нём 4 части, всегда в одном порядке: вид ошибки, что она говорит, файл и строка. Строка - это место, где проблему заметили, поэтому причина может быть чуть выше: начинайте читать с 1 строки раньше. Держите под рукой 4 горячие клавиши: Cmd+S сохраняет, Cmd+Z отменяет, Ctrl+C останавливает программу в терминале, а стрелка вверх возвращает прошлую команду. Когда просите агента о помощи, вставьте сообщение целиком, а не пересказ."
];
pub const LESSON_TASKS : [3]str = [
    "В спеке найдите READ_LIMIT и три предложенных изменения. Поставьте последнему KEEP значение 1 и запустите плеер: упадёт тест, где названо изменение, слишком длинное для чтения. Затем верните 0.",
    "В спеке найдите список NO_UNDO. Отметьте cat тоже единицей 1 и запустите плеер: упадёт тест, который считает команды без отмены. Затем верните 0.",
    "В спеке найдите ERROR_LINE и START_LINE. Поставьте START_LINE равным 15 и запустите плеер: упадёт тест, который требует начинать на одну строку выше ошибки. Затем верните 13."
];
pub const LESSON_DIGITS : [3]str = ["3 12 90 20", "10 1", "4 1 4"];
pub const TASK_DIGITS : [3]str = ["1 0", "1 0", "15 13"];

test every_field_has_text {
    assert LESSON_TITLES[0] != "";
    assert LESSON_TITLES[2] != "";
    assert LESSON_GOALS[0] != "";
    assert LESSON_GOALS[2] != "";
    assert LESSON_TEXTS[0] != "";
    assert LESSON_TEXTS[2] != "";
    assert LESSON_TASKS[0] != "";
    assert LESSON_TASKS[2] != "";
}

test the_digits_equal_the_english_ones {
    assert LESSON_DIGITS[0] == "3 12 90 20";
    assert LESSON_DIGITS[1] == "10 1";
    assert LESSON_DIGITS[2] == "4 1 4";
    assert TASK_DIGITS[0] == "1 0";
    assert TASK_DIGITS[2] == "15 13";
}
