; specs/course_recipe/fragments/idea-ru.t27 -- module 1 of the vibecoding course, Russian texts
; The same fields as idea.t27 in the same order; the assembly step moves them into the Russian
; bundle named by specs/course/vibecoding-ru.t27. This is the one file of the lane that carries
; Cyrillic: the course has a Russian version (owner's rule, blog and course texts carry both).
; Identifiers, spec names, test names and numbers stay as in English; only the words are translated.
; phi^2 + 1/phi^2 = 3 | TRINITY

module vc_fragment_idea_ru;

pub const MODULE_ID : str = "idea";
pub const MODULE_TITLE : str = "Что такое вайбкодинг";
pub const MODULE_LINE : str = "Вы описываете, агент пишет, вы запускаете и проверяете. Что такое программа, и пять мифов, проверенных тестом.";

pub const LESSON_TITLES : [3]str = [
    "Описать, запустить, проверить",
    "Программа - это шаги по порядку",
    "Пять мифов, каждый проверен тестом"
];
pub const LESSON_GOALS : [3]str = [
    "Вайбкодинг - это цикл из трёх шагов: вы описываете, что хотите, программа запускается, а проверка отвечает да или нет.",
    "Программа - это список мелких шагов, выполняемых по порядку, и порядок входит в смысл программы.",
    "Фраза, которая звучит верно, проверяется маленьким случаем и тестом, так что миф можно проверить, а не спорить о нём."
];
pub const LESSON_TEXTS : [3]str = [
    "Вайбкодинг значит, что вы описываете простыми словами, чего хотите, а ИИ-агент пишет программу. На этом ваша часть не заканчивается. Вы запускаете программу и сверяете результат со своим описанием, потому что программа может завершиться без ошибки и всё равно быть неверной. В спеке этого урока счёт в кафе - это число напитков, умноженное на цену одного: 3 напитка по 4 - это 12. Запуск, который складывает вместо умножения, печатает 7, спокойно завершается, и проверка его отвергает. Проверка - это тест, и тест судит результат, а не человека и не программу, которая его написала.",
    "Программа - это список мелких шагов, которые компьютер выполняет один за другим. Возьмите число 2. Прибавьте 3, потом удвойте: получится 10. Удвойте, потом прибавьте 3: получится 7. Те же два шага в другом порядке дают другой ответ, поэтому, описывая программу агенту, вы описываете и порядок. Цикл - это один шаг, записанный один раз и повторённый: прибавить 3 четыре раза, начиная с 2, даёт 14. Когда результат вас удивил, прочтите шаги по порядку и найдите первый, который делает не то, что вы имели в виду.",
    "Пять фраз о вайбкодинге звучат верно, но неверны. Если программа запускается без ошибки, она верна: среднее 4 и 8, записанное как a плюс b, делённое на 2, печатает 8, а ответ 6. Один пройденный тест доказывает, что код верен: x умножить на x равно x плюс x при 2, но не при 3. Агент помнит весь разговор: он читает окно, в этом случае 8 сообщений из 20 отправленных. Шаг всегда можно отменить: 7, поделённое пополам и удвоенное, это 6. Проверка, которая проходит, - хорошая проверка: та, что отвечает да на всё, ответит да и на 2 против 3. Каждый миф - это маленький случай, и тест его решает."
];
pub const LESSON_TASKS : [3]str = [
    "Откройте спек в плеере и запустите: 3 теста проходят. Потом поменяйте RAN_TAB с 12 на 7 и запустите снова: тест the_run_matches_the_wish краснеет. Верните 12 на место.",
    "Найдите в спеке три программы: add_then_double, double_then_add и add_three_n_times. Поменяйте LOOP_RESULT с 14 на 11 и запустите: a_loop_is_one_step_repeated падает, потому что 11 - это три шага, а не четыре. Верните 14 на место.",
    "Запустите спек: 6 тестов проходят. Поменяйте AVG_RAN с 8 на 6 и запустите: myth_1_runs_but_wrong падает, потому что запуск больше не совпадает с тем, что печатает неверная программа. Потом запишите шестой миф от себя как случай с числами и тест."
];

; The digits of each field, sorted: the same lists as in idea.t27.
pub const DIGITS_TITLES : [3]str = ["", "", ""];
pub const DIGITS_GOALS : [3]str = ["", "", ""];
pub const DIGITS_TEXTS : [3]str = ["12347", "0112233347", "02222334667888"];
pub const DIGITS_TASKS : [3]str = ["112237", "11111144", "1668"];

test no_field_is_empty {
    assert MODULE_TITLE != "";
    assert MODULE_LINE != "";
    assert LESSON_TITLES[0] != "";
    assert LESSON_TITLES[1] != "";
    assert LESSON_TITLES[2] != "";
    assert LESSON_GOALS[0] != "";
    assert LESSON_GOALS[1] != "";
    assert LESSON_GOALS[2] != "";
    assert LESSON_TEXTS[0] != "";
    assert LESSON_TEXTS[1] != "";
    assert LESSON_TEXTS[2] != "";
    assert LESSON_TASKS[0] != "";
    assert LESSON_TASKS[1] != "";
    assert LESSON_TASKS[2] != "";
}

test the_russian_digits_equal_the_english_ones {
    assert DIGITS_TITLES[2] == "";
    assert DIGITS_GOALS[2] == "";
    assert DIGITS_TEXTS[0] == "12347";
    assert DIGITS_TEXTS[1] == "0112233347";
    assert DIGITS_TEXTS[2] == "02222334667888";
    assert DIGITS_TASKS[0] == "112237";
    assert DIGITS_TASKS[1] == "11111144";
    assert DIGITS_TASKS[2] == "1668";
}
