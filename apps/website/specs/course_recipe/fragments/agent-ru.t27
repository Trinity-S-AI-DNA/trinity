// SPDX-License-Identifier: Apache-2.0
; specs/course_recipe/fragments/agent-ru.t27 -- module 7 of the Vibecoding course: the parts of an agent (Russian)
; The Russian text of the fragment specs/course_recipe/fragments/agent.t27, field by field, with the same
; digits in every field (the assembly step refuses a changed number). Identifiers and file names stay in Latin.
; This is the one file of the course lane that carries Cyrillic, by the owner's brief for the Russian fragments.
; phi^2 + 1/phi^2 = 3 | TRINITY

module vibecoding_fragment_agent_ru;

pub const LOCALE : str = "ru";
pub const SOURCE_SPEC : str = "specs/course_recipe/fragments/agent.t27";
pub const LESSON_IDS : [3]str = ["the-mind-of-an-agent", "the-hands-of-an-agent", "what-an-agent-keeps"];
pub const LESSON_TITLES : [3]str = [
    "Разум: ответ с формой",
    "Руки: инструменты, которые вызывает агент",
    "Память: что агент хранит"
];
pub const LESSON_GOALS : [3]str = [
    "Почему программа просит у агента ответ с фиксированной формой и как она отклоняет ответ с неверной формой.",
    "Что такое инструмент, какие инструменты агент запускает сразу и какой ждёт вашего согласия.",
    "Что агент ещё видит из длинного чата, что выпадает из его окна и что хранит файл в проекте."
];
pub const LESSON_TEXTS : [3]str = [
    "Когда вы говорите с агентом, вы читаете свободный текст. Когда ответ читает программа, свободный текст мешает: она не отличит фразу от просьбы что-то запустить. Поэтому у агента просят ответ с формой: вид и столько аргументов, сколько нужно этому виду. В этой спецификации 3 вида: 0 сказать, 1 спросить и 2 вызвать инструмент. Фразе аргумент не нужен; вопросу и вызову инструмента нужен хотя бы 1. Программа сначала проверяет форму и действует, только если она подходит. Вызов инструмента без имени файла отклоняется до того, как что-либо запустится. Отрицательный контроль вносит ошибку в одном месте: поставьте NEEDS_CALL равным 0, и тест the_bad_reply_is_refused покраснеет, потому что ответ без аргументов больше не считается слишком коротким.",
    "Агент только читает и пишет текст. Сам он не может открыть файл или запустить тест. Инструмент это функция, которую запускает за него хост: агент называет инструмент, хост сверяет имя со списком, запускает его и возвращает результат текстом. В этой спецификации 3 инструмента: 0 прочитать файл, 1 запустить тесты и 2 записать файл. Чтение и тесты ничего не меняют, поэтому идут сразу; запись меняет ваш проект, поэтому ждёт вашего согласия. Цикл тоже ограничен: из 9 вызовов, запрошенных за один ход, хост пропускает 5, так что застрявший агент не будет вызывать инструменты вечно. Внесите ошибку: поставьте FREE_BELOW равным 3, и тест writing_waits_for_a_yes покраснеет: запись пошла бы без вопроса.",
    "Агент не помнит ваш проект; он видит последние сообщения чата, сколько их помещается в окно. Спецификация берёт окно в 6 сообщений и чат в 10, чтобы всё можно было проследить вручную. Агент хранит 6 сообщений и забывает 4: сообщения с 0 по 3 выпали, а самое старое из тех, что он ещё видит, имеет номер 4. То, что вы записали в файл проекта, остаётся, потому что в новом чате агент может прочитать файл снова. Поэтому правило, которое нужно сохранить, записывают в файл, а не в ещё одно сообщение. Внесите ошибку: поставьте WINDOW равным 7, и два теста покраснеют, потому что окно больше не заканчивается там, где чат."
];
pub const LESSON_TASKS : [3]str = [
    "Откройте виджет и найдите, какому виду аргумент не нужен; затем запустите спецификацию, поставьте NEEDS_CALL равным 0 и прочитайте, какой тест падает и почему. Верните строку и запустите снова.",
    "Откройте виджет и назовите два инструмента, которые идут сразу; затем запустите спецификацию, поставьте FREE_BELOW равным 3 и прочитайте, какой тест падает. Верните строку и запустите снова.",
    "Откройте виджет и найдите, сколько сообщений забывает чат из 10 в окне из 6; затем запустите спецификацию, поставьте WINDOW равным 7 и прочитайте, какие два теста падают. Верните строку и запустите снова."
];

test the_russian_keeps_three_lessons {
    assert LESSON_IDS[2] == "what-an-agent-keeps";
    assert LESSON_TITLES[2] != "";
}

test every_title_is_filled {
    assert LESSON_TITLES[0] != "";
    assert LESSON_TITLES[1] != "";
    assert LESSON_TITLES[2] != "";
}

test every_goal_is_filled {
    assert LESSON_GOALS[0] != "";
    assert LESSON_GOALS[1] != "";
    assert LESSON_GOALS[2] != "";
}

test every_text_is_filled {
    assert LESSON_TEXTS[0] != "";
    assert LESSON_TEXTS[1] != "";
    assert LESSON_TEXTS[2] != "";
}

test every_task_is_filled {
    assert LESSON_TASKS[0] != "";
    assert LESSON_TASKS[1] != "";
    assert LESSON_TASKS[2] != "";
}
