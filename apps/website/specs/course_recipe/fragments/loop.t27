// SPDX-License-Identifier: Apache-2.0
; specs/course_recipe/fragments/loop.t27 -- the three lessons of module "loop" for the course "Vibecoding from zero"
; A fragment, not the course: the assembly step merges it into specs/course/vibecoding.t27 (lessons 13 to 15
; of 27). The field names are those of specs/course/ai-numbers.t27, one entry per lesson, in lesson order.
; The Russian words are in loop-ru.t27. The ids, widgets and spec paths are those of
; specs/course_recipe/vibecoding-plan.t27. DIGITS_* name, sorted, every digit a field contains; the
; Russian fragment pins the same strings, so a number added to one language alone turns a test red.
; ASCII only, English only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module vibecoding_fragment_loop;

pub const MODULE_ID : str = "loop";
pub const FIRST_LESSON : u8 = 13;
pub const LESSON_IN_FRAGMENT : u8 = 3;

pub const LESSON_IDS : [3]str = ["four-phases", "ask-run-read-fix", "when-you-are-stuck"];
pub const LESSON_WIDGETS : [3]str = ["vc-four-phases", "vc-the-loop", "vc-unstuck"];
pub const LESSON_SPECS : [3]str = ["specs/vibecoding/four_phases.t27", "specs/vibecoding/the_loop.t27", "specs/vibecoding/unstuck.t27"];
pub const LESSON_ALSO : [3]str = ["", "", ""];

pub const LESSON_TITLES : [3]str = [
    "Four phases: idea, build, test, ship",
    "Ask, run, read, fix",
    "When you are stuck"
];
pub const LESSON_GOALS : [3]str = [
    "Why work goes through four phases in order, and why a failed test sends it back to build and never forward to ship.",
    "How a round of ask, run, read and fix removes one problem, and why a round that skips the reading hides the rest.",
    "How to count the same error coming back, and how that count picks your next move: read it, ask smaller, go back to the save point, start fresh."
];
pub const LESSON_TEXTS : [3]str = [
    "Every piece of work with an agent has the same four phases. Idea: you say in one sentence what you want. Build: the agent writes one small piece. Test: you run it and a test says yes or no. Ship: you save it and put it where it is used. The phases are not a straight line. When the test says no, the work goes back to build, not forward to ship, and the loop runs again. The spec of this lesson holds two tables: where each phase goes next when the tests pass, and where it goes when they fail. The player runs its 4 tests. Change one entry of the fail table so that a failed test goes on to ship, and exactly one test goes red.",
    "A round has 4 steps. Ask the agent for one change. Run the program. Read what came back, all of it. Fix one problem and go round again. Each round removes one problem, so a program with 3 problems is green after 3 rounds. The spec keeps a table of the problems left after each round: 3, 2, 1, 0. The shortcut that breaks the loop is a round that says done without reading the result. In the widget you can switch the reading off and watch the counter lie. In the spec the same shortcut is one changed number, and exactly one test goes red.",
    "Getting stuck is normal; going round in a circle is the signal to change what you do. Count how many times in a row the same error came back. The first time, read the error and say in your own words what it claims. The second time, ask for a smaller step. The third time, go back to the last save point, the commit that worked. After that, start a fresh conversation with a short summary and the one error. A different error resets the count, because it means you got past the last one. The spec holds this as a table of moves indexed by the count, and its 4 tests check each rung."
];
pub const LESSON_TASKS : [3]str = [
    "Open the widget and walk an idea to ship with one failed test on the way; count the steps. Then in the spec find the entry of the fail table that sends a failed test back to build, change it to 3 and read which test goes red.",
    "Run the three rounds in the widget, then switch the reading off and run one round. In the spec change the 1 in the table to 0 and name the test that goes red.",
    "In the widget press the same error three times and name the move it picks. Then press a different error and see the count start again. In the spec change the move for a count of 3 from 2 to 1 and read which test goes red."
];

; Every digit of each field, sorted. An empty string means the field has no digit.
pub const DIGITS_TITLES : [3]str = ["", "", ""];
pub const DIGITS_GOALS : [3]str = ["", "", ""];
pub const DIGITS_TEXTS : [3]str = ["4", "0123334", "4"];
pub const DIGITS_TASKS : [3]str = ["3", "01", "123"];

test the_fragment_has_three_lessons {
    assert LESSON_IN_FRAGMENT == 3;
    assert FIRST_LESSON == 13;
    assert LESSON_IDS[2] == "when-you-are-stuck";
    assert LESSON_WIDGETS[2] == "vc-unstuck";
    assert LESSON_SPECS[2] == "specs/vibecoding/unstuck.t27";
    assert LESSON_ALSO[2] == "";
}

test the_ids_match_the_plan {
    assert LESSON_IDS[0] == "four-phases";
    assert LESSON_IDS[1] == "ask-run-read-fix";
    assert LESSON_WIDGETS[0] == "vc-four-phases";
    assert LESSON_WIDGETS[1] == "vc-the-loop";
    assert LESSON_SPECS[0] == "specs/vibecoding/four_phases.t27";
    assert LESSON_SPECS[1] == "specs/vibecoding/the_loop.t27";
}

test every_field_is_filled_for_every_lesson {
    assert LESSON_TITLES[0] != "";
    assert LESSON_TITLES[1] != "";
    assert LESSON_TITLES[2] != "";
    assert LESSON_GOALS[0] != "";
    assert LESSON_GOALS[1] != "";
    assert LESSON_GOALS[2] != "";
    assert LESSON_TEXTS[0] != "";
    assert LESSON_TEXTS[1] != "";
    assert LESSON_TEXTS[2] != "";
    assert LESSON_TASKS[0] != "";
    assert LESSON_TASKS[1] != "";
    assert LESSON_TASKS[2] != "";
}

test the_digits_are_pinned {
    assert DIGITS_TEXTS[0] == "4";
    assert DIGITS_TEXTS[1] == "0123334";
    assert DIGITS_TEXTS[2] == "4";
    assert DIGITS_TASKS[0] == "3";
    assert DIGITS_TASKS[1] == "01";
    assert DIGITS_TASKS[2] == "123";
}
