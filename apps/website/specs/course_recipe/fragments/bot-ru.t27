// SPDX-License-Identifier: Apache-2.0
; specs/course_recipe/fragments/bot-ru.t27 -- the words of module 8, "A first bot", Russian
; The Russian side of fragments/bot.t27: the same three lessons, the same four fields, the same
; digits in the same order. This file is the one place that carries Cyrillic; the English
; companion is the source, and the assembly step merges both.
; phi^2 + 1/phi^2 = 3 | TRINITY

module vc_fragment_bot_ru;

pub const KIND : str = "course-fragment-ru";
pub const MODULE_ID : str = "bot";
pub const LOCALE : str = "ru";
pub const LESSON_COUNT : u8 = 3;

pub const LESSON_TITLES : [3]str = [
    "Бот — это цикл сообщений",
    "От спецификации к боту",
    "Секреты остаются вне репозитория и промпта"
];

pub const LESSON_GOALS : [3]str = [
    "Как бот ждёт сообщение, берёт ответ из таблицы и снова ждёт, и почему одно и то же сообщение всегда получает один и тот же ответ.",
    "Почему бот начинается с таблицы команд и ответов и как три проверки ловят плохую таблицу ещё до того, как бот существует.",
    "Почему имя секрета может жить в репозитории, а его значение нет: ни в файле, ни в промпте."
];

pub const LESSON_TEXTS : [3]str = [
    "Бот — не магия. Это цикл из четырёх тактов: ждать сообщение, прочитать его, выбрать ответ, отправить его и снова ждать. В message_loop.t27 сообщение — маленькое число: 1 — старт, 2 — помощь, 3 — стоп, всё остальное не понято. Таблица связывает каждое сообщение с ответом, поэтому один оборот цикла — это один поиск. В очереди 5 сообщений, и цикл останавливается на сообщении «стоп», так что отвечает на 4. Отправьте виджету несколько сообщений и заметьте: одно и то же сообщение всегда получает один и тот же ответ.",
    "Бота не пишут, его описывают. spec_to_bot.t27 перечисляет 3 команды и ответ каждой как данные. Прежде чем что-то сгенерируется, над описанием запускаются 3 проверки: у каждой команды есть ответ, у двух команд нет общего ответа, а число маршрутов равно числу команд. Описание, не прошедшее проверку, дало бы неверного бота, поэтому сначала чинят таблицу, а бота генерируют потом. Сотрите ответ в виджете и посмотрите, какая проверка станет красной.",
    "Секрет — это значение, которое что-то открывает, например токен бота. Код называет его, BOT_TOKEN, и никогда не хранит. Значение живёт в файле .env на вашей машине, а git велено этот файл игнорировать. В репозитории лежит только .env.example с выдуманной заглушкой. В secrets_out.t27 файл с секретом никогда не входит в то, что сохраняет git, и то же верно для сообщения агенту: пишите имя секрета, а не его значение. Секрет, который хоть раз был сохранён или вставлен в сообщение, считают утраченным и заменяют."
];

pub const LESSON_TASKS : [3]str = [
    "Отправьте старт, потом помощь, потом незнакомое слово, потом стоп и посчитайте ответы. В кадре со спецификацией найдите очередь и индекс её сообщения «стоп», а также тест, который краснеет, когда у двух команд общий ответ.",
    "Сотрите один ответ и назовите проверку, которая станет красной. В кадре со спецификацией найдите тест, который ломает пропавший ответ, и одну строку, которую вы изменили бы, чтобы подложить эту ошибку.",
    "Переключите файл с настоящими настройками на «сохранять» и прочитайте тревогу. В кадре со спецификацией найдите тест, который падает, когда TRACKED говорит, что файл с настоящими настройками сохранён, и строку, которую вы изменили бы, чтобы подложить это."
];

; The digits of each field in reading order. They must equal the English side (fragments/bot.t27).
pub const DIGITS_TITLES : [3]str = ["", "", ""];
pub const DIGITS_GOALS : [3]str = ["", "", ""];
pub const DIGITS_TEXTS : [3]str = ["2712354", "2733", "27"];
pub const DIGITS_TASKS : [3]str = ["", "", ""];

test the_module_has_three_lessons {
    assert LESSON_COUNT == 3;
    assert LOCALE == "ru";
}

test no_field_is_empty {
    assert LESSON_TITLES[0] != "";
    assert LESSON_TITLES[1] != "";
    assert LESSON_TITLES[2] != "";
    assert LESSON_GOALS[0] != "";
    assert LESSON_GOALS[1] != "";
    assert LESSON_GOALS[2] != "";
    assert LESSON_TEXTS[0] != "";
    assert LESSON_TEXTS[1] != "";
    assert LESSON_TEXTS[2] != "";
    assert LESSON_TASKS[0] != "";
    assert LESSON_TASKS[1] != "";
    assert LESSON_TASKS[2] != "";
}

; The digit strings are the English ones, literally: 2712354, 2733 and 27 for the texts (the 27 of each t27 file name counts), none elsewhere.
test the_digits_equal_the_english_side {
    assert DIGITS_TITLES[0] == "";
    assert DIGITS_TITLES[1] == "";
    assert DIGITS_TITLES[2] == "";
    assert DIGITS_GOALS[0] == "";
    assert DIGITS_GOALS[1] == "";
    assert DIGITS_GOALS[2] == "";
    assert DIGITS_TEXTS[0] == "2712354";
    assert DIGITS_TEXTS[1] == "2733";
    assert DIGITS_TEXTS[2] == "27";
    assert DIGITS_TASKS[0] == "";
    assert DIGITS_TASKS[1] == "";
    assert DIGITS_TASKS[2] == "";
}
