// SPDX-License-Identifier: Apache-2.0
; specs/course_recipe/fragments/saves-ru.t27 -- the Russian words of the fragment saves.t27 (module 3 of the course)
; Same field names as saves.t27, Russian text. The digits of every field are the same, in the same
; order, as in the English fragment (DIGITS_* below are equal to its lists). No real key appears.
; phi^2 + 1/phi^2 = 3 | TRINITY

module vibecoding_saves_ru;

pub const KIND : str = "course-fragment-ru";
pub const LOCALE : str = "ru";
pub const SOURCE_SPEC : str = "specs/course_recipe/fragments/saves.t27";
pub const MODULE_ID : str = "saves";
pub const MODULE_TITLE : str = "Точки сохранения в git";
pub const MODULE_LINE : str = "Коммит это точка сохранения, ветка это безопасная проба, а ключ это пара, одна половина которой остаётся приватной.";

pub const LESSON_TITLES : [3]str = ["Коммит это точка сохранения", "Ветка это безопасная проба", "Ключ это пара"];
pub const LESSON_GOALS : [3]str = [
    "Что хранит коммит, почему последующие правки его не меняют и когда его делать.",
    "Как проба на ветке отбрасывается или вливается и почему main не тронут, пока вы не решите.",
    "Почему у ключа две половины, какую из них можно отдавать и какая никогда не покидает ваш компьютер."
];
pub const LESSON_TEXTS : [3]str = [
    "Вайбкодинг значит, что агент меняет ваши файлы, пока вы смотрите, и часть правок что-то ломает. Коммит это точка сохранения: он хранит каждый файл ровно таким, каким тот был в этот момент, а после можно править сколько угодно, сохранённая копия не меняется. В commit.t27 файл при коммите содержал 10; затем агент сделал его 99; возврат даёт 10, а не 99. Каждый коммит добавляет одну точку сохранения в историю и ничего не перезаписывает: после третьего коммита их 3. Делайте коммит, когда программа работает, до следующей просьбы об изменении.",
    "Ветка это копия вашей линии работы, где можно что-то пробовать, а основная линия остаётся прежней, пока вы не решите. В branch.t27 в main лежит 10, а проба агента превращает это в 99 на своей ветке. Если проба плохая, вы удаляете ветку, и в main по-прежнему 10. Если хорошая, вы вливаете её, и в main лежит 99. Пока вы пробуете, линий работы 2, main и проба; после любого из двух исходов она 1. Просите агента о рискованной правке на ветке, а не в main.",
    "Чтобы доказать хосту кода, кто вы, без пароля, делают пару ключей: публичную половину, которую раздают, и приватную, которая никогда не покидает ваш компьютер. Хост хранит публичную половину и присылает вызов, на который может ответить только приватная. В key_pair.t27 у пары 2 половины, 1 общая и 1 хранится у вас, и 0 копий приватной половины уходят на хост, в чат или в репозиторий. Текст ключа в спецификации выдуманная заглушка, а не ключ. Никогда не вставляйте настоящую приватную половину в запрос: агент, который её увидел, ею владеет."
];
pub const LESSON_TASKS : [3]str = [
    "В виджете прочитайте значение файла в трёх моментах и найдите тот, где правка агента отменена; затем в окне спецификации найдите RESTORED и скажите, что изменится, если задать ему EDITED.",
    "В виджете сравните два исхода в таблице и скажите, какой меняет main; затем в окне спецификации подложите ошибку MAIN_AFTER_DISCARD = 99 и посмотрите, какие тесты покраснеют.",
    "В виджете найдите половину, которую можно вставить на хост, и половину, которая не идёт никуда; затем в окне спецификации подложите PRIVATE_COPIES_SENT = 1 и прочитайте, какой тест покраснеет."
];

pub const DIGITS_TEXTS : [3]str = ["27 10 99 10 99 3", "27 10 99 10 99 2 1", "27 2 1 1 0"];
pub const DIGITS_TASKS : [3]str = ["", "99", "1"];

test the_module_is_saves {
    assert LOCALE == "ru";
    assert MODULE_ID == "saves";
}

test no_russian_field_is_empty {
    assert MODULE_TITLE != "";
    assert MODULE_LINE != "";
    assert LESSON_TITLES[0] != "";
    assert LESSON_TITLES[1] != "";
    assert LESSON_TITLES[2] != "";
    assert LESSON_GOALS[0] != "";
    assert LESSON_GOALS[1] != "";
    assert LESSON_GOALS[2] != "";
    assert LESSON_TEXTS[0] != "";
    assert LESSON_TEXTS[1] != "";
    assert LESSON_TEXTS[2] != "";
    assert LESSON_TASKS[0] != "";
    assert LESSON_TASKS[1] != "";
    assert LESSON_TASKS[2] != "";
}

test the_digits_equal_the_english_digits {
    assert DIGITS_TEXTS[0] == "27 10 99 10 99 3";
    assert DIGITS_TEXTS[1] == "27 10 99 10 99 2 1";
    assert DIGITS_TEXTS[2] == "27 2 1 1 0";
    assert DIGITS_TASKS[0] == "";
    assert DIGITS_TASKS[1] == "99";
    assert DIGITS_TASKS[2] == "1";
}
