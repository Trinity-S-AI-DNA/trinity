; What the course never says (recipe rules no-superlatives and numbers-from-runs, plus the book).
pub const NEVER_SAY_COUNT : u8 = 4;
pub const NEVER_SAY : [4]str = [
    "an income range or a percent of graduates",
    "a market size or a growth rate",
    "a success story that no run or recording backs",
    "a hand-written line of TypeScript or Python as the thing to copy"
];

; What each module lane still has to do before the course ships (recipe step ids, in order).
pub const BEFORE_SHIP_COUNT : u8 = 5;
pub const BEFORE_SHIP : [5]str = ["specs", "words", "russian", "widgets", "generate"];
pub const LANE_COUNT : u8 = 9;

test the_course_is_three_cubed {
    assert MODULE_COUNT == 9;
    assert LESSONS_PER_MODULE == 3;
    assert MODULE_COUNT * LESSONS_PER_MODULE == LESSON_COUNT;
    assert LESSON_COUNT == 3 * 3 * 3;
    assert LANE_COUNT == MODULE_COUNT;
}

test every_array_reaches_its_last_lesson {
    assert MODULE_IDS[8] == "own";
    assert MODULE_TITLES[8] == "Your own project";
    assert LESSON_IDS[26] == "an-honest-plan";
    assert LESSON_MODULES[26] == "own";
    assert LESSON_TITLES[26] == "An honest plan for the next month";
    assert LESSON_BOOK[26] == "cases: honest expectations; master program: ranks";
    assert LESSON_WIDGETS[26] == "vc-honest-plan";
    assert LESSON_SPECS[26] == "specs/vibecoding/honest_plan.t27";
}

test the_modules_run_in_the_order_of_the_book {
    assert MODULE_IDS[0] == "idea";
    assert MODULE_IDS[1] == "desk";
    assert MODULE_IDS[2] == "saves";
    assert MODULE_IDS[3] == "words";
    assert MODULE_IDS[4] == "loop";
    assert MODULE_IDS[5] == "judge";
    assert MODULE_IDS[6] == "agent";
    assert MODULE_IDS[7] == "bot";
}

test each_module_owns_three_lessons_in_a_row {
    assert LESSON_MODULES[0] == MODULE_IDS[0];
    assert LESSON_MODULES[2] == MODULE_IDS[0];
    assert LESSON_MODULES[3] == MODULE_IDS[1];
    assert LESSON_MODULES[5] == MODULE_IDS[1];
    assert LESSON_MODULES[6] == MODULE_IDS[2];
    assert LESSON_MODULES[8] == MODULE_IDS[2];
    assert LESSON_MODULES[9] == MODULE_IDS[3];
    assert LESSON_MODULES[11] == MODULE_IDS[3];
    assert LESSON_MODULES[12] == MODULE_IDS[4];
    assert LESSON_MODULES[14] == MODULE_IDS[4];
    assert LESSON_MODULES[15] == MODULE_IDS[5];
    assert LESSON_MODULES[17] == MODULE_IDS[5];
    assert LESSON_MODULES[18] == MODULE_IDS[6];
    assert LESSON_MODULES[20] == MODULE_IDS[6];
    assert LESSON_MODULES[21] == MODULE_IDS[7];
    assert LESSON_MODULES[23] == MODULE_IDS[7];
    assert LESSON_MODULES[24] == MODULE_IDS[8];
    assert LESSON_MODULES[26] == MODULE_IDS[8];
}

test the_judge_comes_before_the_agent_and_the_bot {
    assert LESSON_IDS[15] == "a-test-is-the-judge";
    assert LESSON_IDS[16] == "plant-a-bug";
    assert LESSON_IDS[18] == "the-mind-of-an-agent";
    assert LESSON_IDS[21] == "a-bot-is-a-message-loop";
}

test the_course_says_no_market_numbers {
    assert NEVER_SAY_COUNT == 4;
    assert NEVER_SAY[0] == "an income range or a percent of graduates";
    assert NEVER_SAY[3] == "a hand-written line of TypeScript or Python as the thing to copy";
}

test the_plan_ships_in_the_recipe_order {
    assert BEFORE_SHIP[0] == "specs";
    assert BEFORE_SHIP[2] == "russian";
    assert BEFORE_SHIP[3] == "widgets";
    assert BEFORE_SHIP[4] == "generate";
}
