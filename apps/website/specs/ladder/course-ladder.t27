// SPDX-License-Identifier: Apache-2.0
; specs/ladder/course-ladder.t27 -- the words and the addresses the courses show on t27.ai
; beyond each course's own words: the catalog, the course cards, the course advert, and the
; TRI CLAW block at the foot of every course page.
; Source of truth for apps/website/scripts/course-ladder-from-spec.mjs (gHashTag/trinity). The
; RULES are not here: they are gHashTag/t27 specs/automation/course-access.t27, vendored byte for
; byte beside this file (specs/ladder/course-access.t27) and run from its own compiled fn bodies
; (src/lib/courseAccess.logic.ts, whose spec-sha256 must be that file's).
; This file holds what only the site needs: the page words in English (Russian in
; i18n/course-ladder.ru.json, every key, no extra) and where the render answers.
; Owner, 2026-10-11: any one course free, the second for the Telegram bot, the third free,
; the fourth for the club. Owner, 2026-10-13: any three courses free (rules VERSION 2).
; Owner, 2026-10-19: "make every course free! our task is to grow the language" (rules
; VERSION 3): step_of is FREE for every rung, so the site draws no lock, no gate and no
; payment form any more, and these words say every course is free.
; What is honest here: the lesson words are in this site's bundle and on its share pages, so
; nothing was ever hidden (CONTENT_HIDDEN in the rules); now nothing is ordered either.
; A reader who opens the bot may still hold a key the render minted; with it his finished
; lessons reach the course author (may_report), and SAY_SHARED says so.
; --
; TRI CLAW AT THE FOOT OF EVERY COURSE PAGE. Owner, 2026-10-19: "advertise TRI CLAW in the
; course footer"; "TRI CLAW has a free path if you add your own API key to use the bot, and you
; can add more keys to it"; "whoever does not want the hassle pays us"; and the footer links to
; installing the TRI CLAW GitHub App. Three paths, each one press:
; - FREE: the reader's own key. The press opens the app's key screen inside Telegram,
;   https://t.me/<bot>?start=app_<CLAW_KEYS_ROUTE>, the bot being BOT of the rules spec (the
;   generator joins them; nothing restates the handle here). The keys screen is added to the
;   app in gHashTag/999-multibots-telegraf.
; - PAID: the existing club, https://t.me/<bot>?start=app_<CLAW_CLUB_ROUTE>. No price in these
;   words: the bot's own card shows it before anything is paid.
; - GITHUB: the TRI CLAW GitHub App (gHashTag/t27 docs/claw: slug tri-claw). Nothing in
;   docs/claw says the App installs for anyone: there is no app-manifest.yml, RELEASE.md defers
;   the Marketplace listing, and specs/claw/github_surface.t27 measures it on the gHashTag
;   account only. So CLAW_APP_PUBLIC is false, the press opens the TRI CLAW post on this site,
;   and the words say the App is not open yet. The owner flips CLAW_APP_PUBLIC once the App's
;   page installs for anyone; the generator then links CLAW_APP_URL with the SAY_CLAW_APP_* words.
; No superlative and no number the repositories do not back.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module course_ladder;

pub const KIND : str = "course-ladder";
pub const SCHEMA_VERSION : u8 = 2;
pub const GENERATED : [1]str = ["src/lib/courseLadder.generated.ts"];
pub const RULES_SPEC : str = "specs/ladder/course-access.t27";
pub const RENDER_BASE : str = "https://vibee-render-production.up.railway.app";
; Where the courses a reader opened and the keys stay: this browser only.
pub const OPEN_KEY : str = "t27-course-open";
pub const KEYS_KEY : str = "t27-course-keys";

; --- Every course is free (rules VERSION 3) ---------------------------------------------------
pub const SAY_LADDER : str = "Every course is free, for everyone: no sign-up, no email, nothing to pay.";
pub const SAY_COURSES : str = "All courses";
pub const SAY_CATALOG_TITLE : str = "Courses";
pub const SAY_CATALOG_LEAD : str = "Every course is 27 short lessons in the browser, each with a live widget or a spec you can run. All of them are free, with no sign-up and no email.";
pub const SAY_CONTINUE : str = "Continue where you left off";
pub const SAY_BADGE_OPEN : str = "Yours";
pub const SAY_BADGE_FREE : str = "Free";
pub const SAY_LESSONS : str = "{0} lessons";
pub const SAY_DONE_OF : str = "{0} of {1} done";
pub const SAY_SHARED : str = "Your finished lessons are shared with the course author.";
; Other courses at the foot of every course page and blog post, and the course advert in the
; footer of the other pages (owner, 2026-10-13).
pub const SAY_MORE_TITLE : str = "More courses";
pub const SAY_PROMO_TITLE : str = "Every course is free, no sign-up";
pub const SAY_PROMO_LINE : str = "Every lesson runs in the browser, with a live widget or a spec you can run. All the courses are free, no sign-up.";
pub const SAY_PROMO_PRESS : str = "See the courses";

; --- TRI CLAW ---------------------------------------------------------------------------------
pub const APP_START_PREFIX : str = "app_";
pub const CLAW_KEYS_ROUTE : str = "keys";
pub const CLAW_CLUB_ROUTE : str = "club";
pub const CLAW_APP_URL : str = "https://github.com/apps/tri-claw";
pub const CLAW_POST_PATH : str = "blog/tri-claw-an-agent-you-can-audit/";
pub const CLAW_APP_PUBLIC : bool = false;
pub const CLAW_PATHS : u8 = 3;

pub const SAY_CLAW_KICKER : str = "TRI CLAW";
pub const SAY_CLAW_TITLE : str = "The agent behind t27, in Telegram and on GitHub";
pub const SAY_CLAW_LINE : str = "TRI CLAW is the project's agent: it writes and checks .t27 specs with you. Three ways to use it.";
pub const SAY_CLAW_FREE_TITLE : str = "Free, with your own key";
pub const SAY_CLAW_FREE_LINE : str = "Add your own API key (NVIDIA or z.ai today) and the agent runs on it. Add more keys any time.";
pub const SAY_CLAW_FREE_PRESS : str = "Add a key in Telegram";
pub const SAY_CLAW_PAID_TITLE : str = "We do it for you";
pub const SAY_CLAW_PAID_LINE : str = "No keys to keep: join the club in our Telegram bot and the agent runs on ours. The bot shows the price before you pay.";
pub const SAY_CLAW_PAID_PRESS : str = "Join the club in Telegram";
; Shown while CLAW_APP_PUBLIC is true.
pub const SAY_CLAW_APP_TITLE : str = "On your repository";
pub const SAY_CLAW_APP_LINE : str = "The TRI CLAW GitHub App checks the .t27 specs a pull request changes.";
pub const SAY_CLAW_APP_PRESS : str = "Install TRI CLAW on your repository";
; Shown while CLAW_APP_PUBLIC is false.
pub const SAY_CLAW_POST_TITLE : str = "On GitHub";
pub const SAY_CLAW_POST_LINE : str = "TRI CLAW is also a GitHub App, built to check the .t27 specs a pull request changes. It is not open to other repositories yet.";
pub const SAY_CLAW_POST_PRESS : str = "Read about TRI CLAW";

test the_words_name_their_rules {
    assert KIND == "course-ladder";
    assert SCHEMA_VERSION == 2;
    assert RULES_SPEC == "specs/ladder/course-access.t27";
}

test the_courses_opened_and_the_keys_stay_in_the_browser {
    assert OPEN_KEY == "t27-course-open";
    assert KEYS_KEY == "t27-course-keys";
    assert OPEN_KEY != KEYS_KEY;
}

; The advert and the catalog say the same thing in their own words: if they became one
; sentence, one of the two places would be saying the other's line.
test the_advert_speaks_for_itself_not_for_the_catalog {
    assert SAY_PROMO_LINE != SAY_CATALOG_LEAD;
    assert SAY_PROMO_TITLE != SAY_CATALOG_TITLE;
    assert SAY_LADDER != SAY_CATALOG_LEAD;
}

; Three paths, three different screens: a key screen and a club screen inside Telegram,
; and the App (or its post) on the web.
test tri_claw_has_three_paths_that_open_three_places {
    assert CLAW_PATHS == 3;
    assert CLAW_KEYS_ROUTE != CLAW_CLUB_ROUTE;
    assert APP_START_PREFIX == "app_";
    assert CLAW_APP_URL == "https://github.com/apps/tri-claw";
    assert SAY_CLAW_FREE_PRESS != SAY_CLAW_PAID_PRESS;
    assert SAY_CLAW_APP_PRESS != SAY_CLAW_POST_PRESS;
}

; Not claimed: the App installing for anyone. docs/claw does not say it does.
test the_app_is_not_called_open_until_it_is {
    assert CLAW_APP_PUBLIC == false;
    assert SAY_CLAW_POST_TITLE != SAY_CLAW_APP_TITLE;
}
