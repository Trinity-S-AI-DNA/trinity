// SPDX-License-Identifier: Apache-2.0
; specs/ladder/course-ladder.t27 -- the words and the address the course ladder shows on t27.ai
; Source of truth for apps/website/scripts/course-ladder-from-spec.mjs (gHashTag/trinity). The
; RULES of the ladder are not here: they are gHashTag/t27 specs/automation/course-access.t27,
; vendored byte for byte beside this file (specs/ladder/course-access.t27) and run from its own
; compiled fn bodies (src/lib/courseAccess.logic.ts, whose spec-sha256 must be that file's).
; This file holds what only the site needs: the page words in English (Russian in
; i18n/course-ladder.ru.json, every key, no extra) and where the render answers.
; Owner, 2026-10-11: any one course free, the second for the Telegram bot, the third free,
; the fourth for the club; every reader past the bot tracked in the CRM.
; Owner, 2026-10-13: any three courses free, with no sign-up, then payment; the bot rung lost every reader
; (rules VERSION 2), so no rung sends a reader to the bot for a key any more.
; Owner, 2026-10-26 (the release day): the announcement is the copy. The labels go - no FREE
; badge, no free-courses-left counter, no free-for-you gate title: a badge does not teach,
; the announcement sentence does. "free" survives only inside the announcement sentences
; (SAY_CATALOG_LEAD, SAY_PROMO_LINE), exactly where the owner's post says it.
; What is honest here: the lesson words are in this site's bundle and on its share pages, so
; the ladder orders the reader's way, it does not hide the words (CONTENT_HIDDEN in the rules).
; Paying on the site in roubles goes through the render (GET/POST /api/course/checkout) once
; it has a price set; until then the club is paid in the bot. Any reader may pay in TON on the
; site once the render has a wallet and a TON rate; dollars by card are paid in the bot.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module course_ladder;

pub const KIND : str = "course-ladder";
pub const SCHEMA_VERSION : u8 = 1;
pub const GENERATED : [1]str = ["src/lib/courseLadder.generated.ts"];
pub const RULES_SPEC : str = "specs/ladder/course-access.t27";
pub const RENDER_BASE : str = "https://vibee-render-production.up.railway.app";
; Where the order of opened courses and the keys stay: this browser only.
pub const OPEN_KEY : str = "t27-course-open";
pub const KEYS_KEY : str = "t27-course-keys";

pub const SAY_LADDER : str = "Your first three courses open with no sign-up and no email; the fourth and every one after it open with the club. You choose which courses are your three.";
pub const SAY_RUNG : str = "Rung {0} of your ladder";
pub const SAY_FREE_TITLE : str = "This course is yours to open";
pub const SAY_FREE_LINE : str = "Open it with one press: no sign-up, no email, and nothing leaves this browser.";
pub const SAY_OPEN : str = "Open the course";
pub const SAY_BOT_TITLE : str = "This course opens in our Telegram bot";
pub const SAY_BOT_LINE : str = "Press the button: the bot opens with this course's link and hands you a key back, and the course opens here.";
pub const SAY_BOT_PRESS : str = "Open in Telegram";
pub const SAY_BOT_SHARES : str = "From this step on, the course author sees which lessons you finish, so they can help. Before it, nothing leaves this browser.";
pub const SAY_PAID_TITLE : str = "This course opens with the club";
pub const SAY_PAID_LINE : str = "The club is paid in Telegram Stars in the bot, which shows the price. Already in the club? The same button hands you the key.";
pub const SAY_PAID_PRESS : str = "Join the club in Telegram";
pub const SAY_PAID_LATER : str = "Paying here by card in dollars is not built yet.";
; The teaser a reader meets INSIDE an open course (lesson one, below the pager): the gate
; above names the club only when a course is locked, and most readers never climb that far.
; No price here either -- the bot's card says it, same honesty as SAY_PAID_LINE.
; The return is the bot's own balance for generations, never $TRI: the token is not sold
; and is earned only by verified work (gHashTag/golden-chain-international FACTS.md s.6).
pub const SAY_CLUB_TITLE : str = "The club opens the rest of the ladder";
pub const SAY_CLUB_LINE : str = "Every course from the fourth on opens with the club: our one subscription, paid in Telegram Stars in the bot, which shows the price. Part of every payment returns to your bot balance, to spend on generations in the bot.";
; Paying on the site (owner, 2026-10-13: payment without going to the bot). The render answers
; GET /api/course/checkout with the price; with no price set there, none of these words show
; and the gate keeps the bot button. One payment for the club days, no auto-renewal.
pub const SAY_PAY_LINE : str = "The club opens every course for {0} days. One payment in roubles, no auto-renewal, no Telegram needed.";
pub const SAY_PAY_EMAIL : str = "Email for the receipt";
pub const SAY_PAY_PRESS : str = "Pay {0} roubles";
pub const SAY_PAY_SAFE : str = "The payment page is Robokassa. You come back here and the course opens by itself.";
pub const SAY_PAY_BAD_EMAIL : str = "This email does not look right.";
pub const SAY_PAY_ERROR : str = "The payment could not start ({0}). Try again in a minute.";
pub const SAY_PAY_WAITING : str = "Waiting for the payment to be confirmed...";
pub const SAY_PAY_SLOW : str = "The payment is not confirmed yet. If you paid, this page keeps checking; you can also reload it later.";
pub const SAY_PAY_DONE : str = "Payment received. Welcome to the club.";
pub const SAY_PAY_OR_BOT : str = "Or pay in Telegram Stars in our bot";
; Paying in TON on the site (owner, 2026-10-13: "or with crypto"). Any language: the render
; answers GET /api/course/checkout with ton.on and the amount at the current TON rate, and
; the order holds that amount for an hour. The comment is how the render finds the payment.
; Only TON is taken here, never $TRI: the token is not sold (golden-chain-international
; FACTS.md s.6).
pub const SAY_TON_LINE : str = "Or pay in TON from any wallet: no card and no Telegram. The amount is the club price at the current TON rate.";
pub const SAY_TON_EMAIL : str = "Email, so the club is yours on any device";
pub const SAY_TON_PRESS : str = "Pay {0} TON";
pub const SAY_TON_SEND : str = "Send exactly {0} TON to this address with this comment. The comment is how we find your payment.";
pub const SAY_TON_ADDRESS : str = "Address";
pub const SAY_TON_AMOUNT : str = "Amount";
pub const SAY_TON_COMMENT : str = "Comment";
pub const SAY_TON_COPY : str = "Copy";
pub const SAY_TON_COPIED : str = "Copied";
pub const SAY_TON_OPEN : str = "Open in a wallet";
pub const SAY_TON_UNTIL : str = "The amount holds until {0}. This page opens the course by itself once the payment arrives.";
pub const SAY_TON_EXPIRED : str = "This TON order ran out before a payment arrived. Start a new one; if you already sent TON, write to us in the bot with the comment.";
; The catalog (#/courses), the header link and the counter of free courses left: a reader
; should know what a press will do before pressing it (owner, 2026-10-13: the navigation
; was too hard to follow).
pub const SAY_COURSES : str = "All courses";
pub const SAY_CATALOG_TITLE : str = "Courses";
pub const SAY_CATALOG_LEAD : str = "Every course is 27 short lessons in the browser, each with a live widget. Pick any three and they are free, with no sign-up and no email; the club opens the rest.";
pub const SAY_FREE_LEFT : str = "You can still pick {0} of your three.";
pub const SAY_FREE_NONE : str = "Your three are picked. The club opens the rest.";
pub const SAY_IN_CLUB : str = "You are in the club: every course is open.";
pub const SAY_CONTINUE : str = "Continue where you left off";
pub const SAY_BADGE_OPEN : str = "Yours";
pub const SAY_BADGE_FREE : str = "Open";
pub const SAY_BADGE_CLUB : str = "Club";
pub const SAY_LESSONS : str = "{0} lessons";
pub const SAY_DONE_OF : str = "{0} of {1} done";
pub const SAY_FREE_SLOT : str = "This is {0} of your three.";
pub const SAY_LAST_FREE : str = "This is the third of your three: after it, courses open with the club.";
pub const SAY_NOT_NOW : str = "Not now: back to the courses";
; Selling where readers already are (owner, 2026-10-13: other courses at the foot of every
; course page, a course advert in the footer and on every blog post). Internal links carry
; ?from=<placement> -- never utm_*, which would overwrite the channel the reader came from --
; and the placement rides on to the order, so a payment names the shelf that sold it.
pub const SAY_MORE_TITLE : str = "More courses";
pub const SAY_PROMO_TITLE : str = "Any three courses, no sign-up";
pub const SAY_PROMO_LINE : str = "Every lesson runs in the browser with a live widget. Pick any three and they are free, with no sign-up and no email; the club opens the rest.";
pub const SAY_PROMO_PRESS : str = "See the courses";
; A reader who joined the club in the bot signs in here with the bot's button: the bot hands
; back https://t27.ai/#/courses?unlock=<key> and the key stays in this browser.
pub const SAY_SIGN_IN : str = "Already in the club? Sign in via Telegram";
pub const SAY_SIGNED_IN : str = "You are signed in: the club key is saved in this browser.";
pub const SAY_CHECKING : str = "Checking your key...";
pub const SAY_KEY_BAD : str = "This key did not open the course ({0}). Press the button again for a fresh one.";
pub const SAY_SHARED : str = "Your finished lessons are shared with the course author.";

test the_words_name_every_rung {
    assert KIND == "course-ladder";
    assert SCHEMA_VERSION == 1;
    assert RULES_SPEC == "specs/ladder/course-access.t27";
}

test the_order_and_the_keys_stay_in_the_browser {
    assert OPEN_KEY == "t27-course-open";
    assert KEYS_KEY == "t27-course-keys";
    assert OPEN_KEY != KEYS_KEY;
}

; The gate's words answer "why is this locked"; the teaser answers "what is next"
; for a reader mid-course. If they ever become the same sentence, one of the two
; pages is saying the wrong thing.
test the_teaser_speaks_for_itself_not_for_the_gate {
    assert SAY_CLUB_TITLE != SAY_PAID_TITLE;
    assert SAY_CLUB_LINE != SAY_PAID_LINE;
    assert SAY_CLUB_LINE != SAY_LADDER;
}

; The release copy is pinned (owner, 2026-10-26): the catalog lead is the announcement
; sentence, and no label - a badge, the counter, the promo title - carries the word the
; announcement itself only says once, in prose. A label that sells is a label that lies.
test the_release_copy_is_the_announcement {
    assert SAY_CATALOG_LEAD == "Every course is 27 short lessons in the browser, each with a live widget. Pick any three and they are free, with no sign-up and no email; the club opens the rest.";
    assert SAY_BADGE_FREE == "Open";
    assert SAY_BADGE_FREE != SAY_BADGE_OPEN;
    assert SAY_PROMO_TITLE == "Any three courses, no sign-up";
    assert SAY_FREE_LEFT != SAY_FREE_NONE;
}
