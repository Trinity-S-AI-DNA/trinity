// SPDX-License-Identifier: Apache-2.0
; specs/ladder/course-ladder.t27 -- the words and the address the course ladder shows on t27.ai
; Source of truth for apps/website/scripts/course-ladder-from-spec.mjs (gHashTag/trinity). The
; RULES of the ladder are not here: they are gHashTag/t27 specs/automation/course-access.t27,
; vendored byte for byte beside this file (specs/ladder/course-access.t27) and run from its own
; compiled fn bodies (src/lib/courseAccess.logic.ts, whose spec-sha256 must be that file's).
; This file holds what only the site needs: the page words in English (Russian in
; i18n/course-ladder.ru.json, every key, no extra) and where the render answers.
; Owner, 2026-10-11: any one course free, the second for the Telegram bot, the third free,
; the fourth for the club; every reader past the bot tracked in the CRM.
; What is honest here: the lesson words are in this site's bundle and on its share pages, so
; the ladder orders the reader's way, it does not hide the words (CONTENT_HIDDEN in the rules).
; Paying on the site in roubles, dollars or crypto is not built; the club is paid in the bot.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module course_ladder;

pub const KIND : str = "course-ladder";
pub const SCHEMA_VERSION : u8 = 1;
pub const GENERATED : [1]str = ["src/lib/courseLadder.generated.ts"];
pub const RULES_SPEC : str = "specs/ladder/course-access.t27";
pub const RENDER_BASE : str = "https://vibee-render-production.up.railway.app";
; Where the order of opened courses and the keys stay: this browser only.
pub const OPEN_KEY : str = "t27-course-open";
pub const KEYS_KEY : str = "t27-course-keys";

pub const SAY_LADDER : str = "The ladder: your first course is free, the second opens in our Telegram bot, the third is free, the fourth and every one after it open with the club. You choose which course goes on which rung.";
pub const SAY_RUNG : str = "Rung {0} of your ladder";
pub const SAY_FREE_TITLE : str = "This course is free for you";
pub const SAY_FREE_LINE : str = "Open it with one press. Nothing is asked and nothing leaves this browser.";
pub const SAY_OPEN : str = "Open the course";
pub const SAY_BOT_TITLE : str = "This course opens in our Telegram bot";
pub const SAY_BOT_LINE : str = "Press the button: the bot opens with this course's link and hands you a key back, and the course opens here.";
pub const SAY_BOT_PRESS : str = "Open in Telegram";
pub const SAY_BOT_SHARES : str = "From this step on, the course author sees which lessons you finish, so they can help. Before it, nothing leaves this browser.";
pub const SAY_PAID_TITLE : str = "This course opens with the club";
pub const SAY_PAID_LINE : str = "The club is paid in Telegram Stars in the bot, which shows the price. Already in the club? The same button hands you the key.";
pub const SAY_PAID_PRESS : str = "Join the club in Telegram";
pub const SAY_PAID_LATER : str = "Paying here in roubles, dollars or crypto is not built yet.";
; The teaser a reader meets INSIDE an open course (lesson one, below the pager): the gate
; above names the club only when a course is locked, and most readers never climb that far.
; No price here either -- the bot's card says it, same honesty as SAY_PAID_LINE.
pub const SAY_CLUB_TITLE : str = "The club opens the rest of the ladder";
pub const SAY_CLUB_LINE : str = "Every course from the fourth on opens with the club: our one subscription, paid in Telegram Stars in the bot, which shows the price. Part of every payment returns to you as tokens.";
pub const SAY_CHECKING : str = "Checking your key...";
pub const SAY_KEY_BAD : str = "This key did not open the course ({0}). Press the button again for a fresh one.";
pub const SAY_SHARED : str = "Your finished lessons are shared with the course author.";

test the_words_name_every_rung {
    assert KIND == "course-ladder";
    assert SCHEMA_VERSION == 1;
    assert RULES_SPEC == "specs/ladder/course-access.t27";
}

test the_order_and_the_keys_stay_in_the_browser {
    assert OPEN_KEY == "t27-course-open";
    assert KEYS_KEY == "t27-course-keys";
    assert OPEN_KEY != KEYS_KEY;
}

; The gate's words answer "why is this locked"; the teaser answers "what is next"
; for a reader mid-course. If they ever become the same sentence, one of the two
; pages is saying the wrong thing.
test the_teaser_speaks_for_itself_not_for_the_gate {
    assert SAY_CLUB_TITLE != SAY_PAID_TITLE;
    assert SAY_CLUB_LINE != SAY_PAID_LINE;
    assert SAY_CLUB_LINE != SAY_LADDER;
}
