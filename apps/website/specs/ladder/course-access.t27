// SPDX-License-Identifier: Apache-2.0
// specs/automation/course-access.t27 -- the ladder to the t27 courses: since VERSION 3
// every course opens free, for every reader, with one press; every reader who reaches
// the bot is filed in the owner's CRM, and the owner is told, live, each step they take.
// Host: 999-multibots-telegraf
//       apps/vibee-editor/render/src/agent/course-access.ts (the key: mint, check; the
//       learner row; the CRM person, tag and touch; the owner's live message) and the routes in
//       render-server.ts (POST /api/course/key for the bot with the server key, GET
//       /api/course/key for the site, POST /api/course/progress for the site);
//       src/navigation/registerCommands.ts, the /start payload course_<step>_<route>.
//       gHashTag/trinity apps/website (t27.ai): the same spec byte for byte beside the
//       course catalog; src/pages/Course.tsx draws the lock and asks for the key.
// Why: owner, 2026-10-11 -- "make any one course free, the second for subscribing to the
//       Telegram bot, the third free, and the fourth for a subscription to the service,
//       paid on the site in roubles, dollars and crypto" and "track every user in the
//       CRM and tell me the status of each client's progress online".
// THE LADDER. The reader chooses which course is which rung: the rungs are steps, not
//       courses. A step is FREE (one press, nothing asked), BOT (the reader opens the
//       bot with a course link; the bot hands back a key) or PAID (the bot checks the
//       club and hands back a key that lives as long as the club does). Which step a
//       rung is, is step_of's; past LADDER_RUNGS it repeats the last. A course opened
//       on a free or a bot rung stays open for that reader; one opened on a paid rung
//       stays open only while he holds a paid key that has not run out (stays_open):
//       the club is a subscription, not a purchase. The order is kept in his browser,
//       the keys prove the two steps that need proof.
// THE KEY. Signed by the render with a secret only the render holds; it carries the
//       step, an opaque learner id and an expiry, never a Telegram id or a name. A BOT
//       key does not expire; a PAID key expires with the club period it was minted
//       under. A FREE step mints nothing. With no secret configured, nothing is minted
//       and the bot says so: no unsigned key ever stands in for a signed one.
// THE CRM. A reader is a person to the owner only from the moment he opens the bot:
//       before that the site knows nobody and sends nothing. The bot step files him in
//       the owner's CRM (crm_people) with the tag "course-bot" and the source
//       "course"; the paid step adds the tag "course-paid". A CRM stage is derived,
//       never set (crm-stages), so the step is a tag, and each step is also a note in
//       his timeline (crm_touches). After the bot step the site reports finished lessons
//       with the key (the course page says so before the press); a finished module (3
//       lessons) and a finished course (27) are told to the owner, a single lesson is
//       only recorded. Every step that is told is told once per learner and course.
// THE PAYMENT. Today the PAID step is the existing club, paid in Telegram Stars in the
//       bot. Paying on the site in roubles, dollars and crypto is not built: the site
//       has no checkout, the render no rouble or crypto link and no card processor
//       exists (gHashTag/999-multibots-telegraf, the course-access issue).
//       SITE_CHECKOUT says so until it is.
// What the gate is and is not: the lesson words and widgets are in the site's static
//       bundle and on its share pages, so the ladder orders the reader's way through
//       the courses; it does not hide them. CONTENT_HIDDEN says so.
// UI words stay in the hosts; the spec holds the rules and the numbers.
// VERSION 2, owner, 2026-10-13 -- "make any three courses free and after that payment
//       without going to the bot, otherwise clients do not understand what to do in the
//       bot". Measured before the change: the ladder went live 2026-10-11 and in two days
//       not one course key was minted (course_learner, the table the first mint creates,
//       did not exist in the render Postgres), while the bot's thirty-day funnel counted
//       50 people at /start and 1 club card. The BOT rung was where readers stopped, so
//       step_of no longer returns it: rungs one to three are FREE, the fourth and every
//       one after it PAID. STEP_BOT stays a step the render mints and may_open and
//       stays_open still honour, so a course already opened with a bot key stays open.
//       Paying on the site is still not built (SITE_CHECKOUT).
// VERSION 3, owner, 2026-10-19 -- "make the courses free for everyone! our task is to
//       grow the language". A course that asks for the club is a reader the language
//       does not get, so step_of returns FREE for every rung: no course needs the club
//       or the bot. The club stays the bot's own subscription, for generations; it is no
//       longer a door to a course. LADDER_RUNGS counts the rungs that differ before
//       step_of repeats its last one: four in VERSION 2 (free, free, free, paid, then
//       paid for good), one now (free, then free for good). STEP_BOT and STEP_PAID stay
//       steps the render mints and may_open, stays_open, mint_ok and key_days still
//       honour, so a key already minted keeps opening what it opened. What this leaves
//       to the hosts: a course a reader stored on a paid rung under VERSION 2 is judged
//       by stays_open with its stored step and closes when his club ends; a host that
//       must keep it open re-rungs it with step_of. With no rung asking for the bot, a
//       reader is filed in the CRM and reports lessons only if he opens the bot himself;
//       the site still sends nothing before that (SENDS_BEFORE_BOT). SITE_CHECKOUT stays
//       false: there is no checkout, and no course needs one.
// Claim status: written before any live run; no key has been minted, no reader filed.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::course_access {

    pub const KIND : str = "automation";
    pub const ID : str = "course-access";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 3;

    // ---- The steps ---------------------------------------------------------------------
    pub const STEP_FREE : u8 = 0;
    pub const STEP_BOT : u8 = 1;
    pub const STEP_PAID : u8 = 2;
    pub const LADDER_RUNGS : u8 = 1;  // one rung, free; every course after it is free too
    pub const COURSES_KNOWN : u8 = 7;  // the catalog today; the ladder does not depend on it

    // ---- The bot link ------------------------------------------------------------------
    pub const BOT : str = "t27ai_bot";
    pub const START_PREFIX : str = "course_";  // course_<step word>_<route>
    pub const START_MAX_CHARS : u8 = 64;  // Telegram's own ceiling for a start payload
    pub const KEY_PARAM : str = "unlock";  // https://t27.ai/#/<route>?unlock=<key>

    // ---- The key -----------------------------------------------------------------------
    pub const BOT_KEY_DAYS : u16 = 3650;  // a bot key does not run out in practice
    pub const LEARNER_ID_CHARS : u8 = 16;  // opaque, random; never a Telegram id
    pub const KEY_CARRIES_TELEGRAM_ID : bool = false;
    pub const MINTS_WITHOUT_SECRET : bool = false;

    // ---- The CRM and the owner ---------------------------------------------------------
    pub const CRM_SOURCE : str = "course";
    pub const LESSONS_PER_MODULE : u8 = 3;
    pub const LESSONS_PER_COURSE : u8 = 27;
    pub const SENDS_BEFORE_BOT : bool = false;  // the site knows nobody before the bot step
    pub const EVENT_KEY_BOT : u8 = 1;
    pub const EVENT_KEY_PAID : u8 = 2;
    pub const EVENT_LESSON : u8 = 3;
    pub const EVENT_MODULE : u8 = 4;
    pub const EVENT_COURSE : u8 = 5;

    // ---- Not claimed -------------------------------------------------------------------
    pub const SITE_CHECKOUT : bool = false;  // roubles, dollars, crypto on the site: not built
    pub const CONTENT_HIDDEN : bool = false;  // the words are public; the ladder orders them
    pub const RUN_LIVE : bool = false;

    // Which step the next course is, given how many this reader has opened already.
    // No rung is BOT since VERSION 2 (the bot step was where readers stopped) and no rung
    // is PAID since VERSION 3: every course is free, to grow the language.
    fn step_of(opened: u8) -> u8 {
        return STEP_FREE;
    }

    // May the reader open the next course: a free step always, a bot step with a bot
    // key, a paid step with a paid key that has not run out.
    fn may_open(step: u8, bot_key: bool, paid_key: bool) -> bool {
        if step == STEP_FREE {
            return true;
        }
        if step == STEP_BOT {
            return bot_key;
        }
        if step == STEP_PAID {
            return paid_key;
        }
        return false;
    }

    // Does a course stay open, given the rung it was opened on: free and bot rungs for
    // good, a paid rung only while a paid key holds.
    fn stays_open(step: u8, paid_key: bool) -> bool {
        if step == STEP_PAID {
            return paid_key;
        }
        return step == STEP_FREE || step == STEP_BOT;
    }

    // May the render mint a key for this step. The bot asks; a bot step needs only that
    // (the person opened the bot), a paid step needs an active club, a free step is
    // never minted, and nothing is minted without the signing secret.
    fn mint_ok(step: u8, club_active: bool, has_secret: bool) -> bool {
        if !has_secret {
            return false;
        }
        if step == STEP_BOT {
            return true;
        }
        if step == STEP_PAID {
            return club_active;
        }
        return false;
    }

    // How many days a minted key lives: a bot key BOT_KEY_DAYS, a paid key as long as
    // the club has left (and a club with no day left mints nothing, so never 0 here).
    fn key_days(step: u8, club_days_left: u16) -> u16 {
        if step == STEP_BOT {
            return BOT_KEY_DAYS;
        }
        if step == STEP_PAID {
            return club_days_left;
        }
        return 0;
    }

    // The tag a step leaves on the reader in the owner's CRM.
    fn crm_tag(step: u8) -> str {
        if step == STEP_BOT {
            return "course-bot";
        }
        if step == STEP_PAID {
            return "course-paid";
        }
        return "";
    }

    // What a finished lesson is, given how many lessons of that course he has finished
    // now: the course's last, a module's last, or one more lesson.
    fn lesson_event(done_in_course: u8) -> u8 {
        if done_in_course == LESSONS_PER_COURSE {
            return EVENT_COURSE;
        }
        if done_in_course % LESSONS_PER_MODULE == 0 {
            return EVENT_MODULE;
        }
        return EVENT_LESSON;
    }

    // Is the owner told of this event, live. A key, a module, a course: yes. A single
    // lesson is only recorded, and the same event is never told twice.
    fn tells_owner(event: u8, told_before: bool) -> bool {
        if told_before {
            return false;
        }
        if event == EVENT_LESSON {
            return false;
        }
        return event >= EVENT_KEY_BOT && event <= EVENT_COURSE;
    }

    // May the site send a finished lesson: only with a valid key, never before the bot.
    fn may_report(has_valid_key: bool) -> bool {
        if SENDS_BEFORE_BOT {
            return true;
        }
        return has_valid_key;
    }

    test "the first course is free, whichever it is" {
        assert(step_of(0) == STEP_FREE);
        assert(may_open(step_of(0), false, false));
    }

    test "the second and the third are free too, no bot asked" {
        assert(step_of(1) == STEP_FREE);
        assert(step_of(2) == STEP_FREE);
        assert(may_open(step_of(1), false, false));
        assert(may_open(step_of(2), false, false));
    }

    test "no rung is the bot any more" {
        assert(step_of(0) != STEP_BOT);
        assert(step_of(1) != STEP_BOT);
        assert(step_of(2) != STEP_BOT);
        assert(step_of(3) != STEP_BOT);
        assert(step_of(255) != STEP_BOT);
    }

    test "a bot key a reader already holds still opens a bot step" {
        assert(!may_open(STEP_BOT, false, false));
        assert(!may_open(STEP_BOT, false, true));
        assert(may_open(STEP_BOT, true, false));
    }

    test "the fourth and every one after it are free too, no club asked" {
        assert(step_of(3) == STEP_FREE);
        assert(step_of(4) == STEP_FREE);
        assert(step_of(6) == STEP_FREE);
        assert(step_of(200) == STEP_FREE);
        assert(may_open(step_of(3), false, false));
        assert(may_open(step_of(200), false, false));
        assert(step_of(3) != STEP_PAID);
        assert(LADDER_RUNGS == 1);
    }

    test "every course is free, for every reader, however many he has opened" {
        var n : u8 = 0;
        while (n < 255) {
            assert(step_of(n) == STEP_FREE);
            assert(step_of(n) == step_of(LADDER_RUNGS - 1));
            assert(may_open(step_of(n), false, false));
            n += 1;
        }
        assert(step_of(255) == STEP_FREE);
        assert(may_open(step_of(255), false, false));
    }

    test "a paid key a reader already holds still opens a paid step" {
        assert(!may_open(STEP_PAID, false, false));
        assert(!may_open(STEP_PAID, true, false));
        assert(may_open(STEP_PAID, false, true));
    }

    test "a club course closes when the club ends, the others stay" {
        assert(stays_open(STEP_FREE, false));
        assert(stays_open(STEP_BOT, false));
        assert(stays_open(STEP_PAID, true));
        assert(!stays_open(STEP_PAID, false));
        assert(!stays_open(3, true));
    }

    test "an unknown step opens nothing" {
        assert(!may_open(3, true, true));
        assert(!may_open(255, true, true));
    }

    test "a key is minted only for a step that needs one, and only signed" {
        assert(mint_ok(STEP_BOT, false, true));
        assert(mint_ok(STEP_PAID, true, true));
        assert(!mint_ok(STEP_PAID, false, true));
        assert(!mint_ok(STEP_FREE, true, true));
        assert(!mint_ok(STEP_BOT, true, false));
        assert(!mint_ok(STEP_PAID, true, false));
        assert(!MINTS_WITHOUT_SECRET);
        assert(!KEY_CARRIES_TELEGRAM_ID);
    }

    test "a paid key lives as long as the club, a bot key does not run out" {
        assert(key_days(STEP_BOT, 0) == BOT_KEY_DAYS);
        assert(key_days(STEP_BOT, 12) == BOT_KEY_DAYS);
        assert(key_days(STEP_PAID, 12) == 12);
        assert(key_days(STEP_PAID, 30) == 30);
        assert(key_days(STEP_FREE, 30) == 0);
        assert(BOT_KEY_DAYS == 3650);
    }

    test "the CRM tag follows the step" {
        assert(crm_tag(STEP_BOT) == "course-bot");
        assert(crm_tag(STEP_PAID) == "course-paid");
        assert(crm_tag(STEP_FREE) == "");
        assert(CRM_SOURCE == "course");
    }

    test "a module is three lessons, a course twenty-seven" {
        assert(lesson_event(1) == EVENT_LESSON);
        assert(lesson_event(2) == EVENT_LESSON);
        assert(lesson_event(3) == EVENT_MODULE);
        assert(lesson_event(4) == EVENT_LESSON);
        assert(lesson_event(24) == EVENT_MODULE);
        assert(lesson_event(26) == EVENT_LESSON);
        assert(lesson_event(27) == EVENT_COURSE);
        assert(LESSONS_PER_MODULE * 9 == LESSONS_PER_COURSE);
    }

    test "the owner hears of keys, modules and courses, once each" {
        assert(tells_owner(EVENT_KEY_BOT, false));
        assert(tells_owner(EVENT_KEY_PAID, false));
        assert(tells_owner(EVENT_MODULE, false));
        assert(tells_owner(EVENT_COURSE, false));
        assert(!tells_owner(EVENT_LESSON, false));
        assert(!tells_owner(EVENT_MODULE, true));
        assert(!tells_owner(EVENT_KEY_BOT, true));
        assert(!tells_owner(0, false));
        assert(!tells_owner(6, false));
    }

    test "the site sends nothing before the bot" {
        assert(!may_report(false));
        assert(may_report(true));
        assert(!SENDS_BEFORE_BOT);
    }

    test "the bot link fits Telegram" {
        assert(BOT == "t27ai_bot");
        assert(START_PREFIX == "course_");
        assert(KEY_PARAM == "unlock");
        assert(START_MAX_CHARS == 64);
        assert(LEARNER_ID_CHARS <= 32);
    }

    test "what is not built is said" {
        assert(!may_report(SENDS_BEFORE_BOT));
        assert(!SITE_CHECKOUT);
        assert(!CONTENT_HIDDEN);
        assert(!RUN_LIVE);
        assert(COURSES_KNOWN == 7);
    }

    test "VERSION says what the header's last note says" {
        assert(VERSION == 3);
        assert(step_of(VERSION) == STEP_FREE);
        assert(step_of(VERSION + 1) == STEP_FREE);
        assert(step_of(VERSION + 1) != STEP_PAID);
    }
}
// phi^2 + 1/phi^2 = 3 | TRINITY
