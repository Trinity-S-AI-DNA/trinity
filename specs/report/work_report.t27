// SPDX-License-Identifier: Apache-2.0
// specs/report/work_report.t27 -- the field rules of the T27 work report: the JSON
// block every pull request body carries between <!-- t27-work-report --> markers.
// The enforcement lives in .github/workflows/pr-blog-report.yml (the "report"
// check); these constants are the single home of the numbers, so a report can be
// checked against the spec before the pull request exists instead of against a
// memory of an error message after CI bounces it.
// Born 2026-10-27 from two bounces in one day: trinity #1763 on
// "work report.tests[2].result must contain 12-4000 characters" and trinity #1766
// on "work report.blog.outline[0] must contain 80-4000 characters" -- both rules
// learnable in seconds locally, both learned from a seven-minute queue instead.
// The bounds are inclusive on both ends. The validator should read these
// constants; until it does, this spec is what a hand check compares against.
// ASCII only, English only. phi^2 + 1/phi^2 = 3 | TRINITY

module work_report;

// The shortest a tests[].result entry may be.
pub const MIN_RESULT : u32 = 12;

// The shortest a blog.outline[] entry may be; an outline line teaches, a label does not.
pub const MIN_OUTLINE : u32 = 80;

// The longest any bounded text field may be.
pub const MAX_FIELD : u32 = 4000;

// One bound rule for every bounded field: inclusive at both ends.
fn entry_len_ok(len : u32, min : u32, max : u32) -> bool {
    len >= min and len <= max
}

test outline_bounds_hold_at_both_ends {
    assert entry_len_ok(MIN_OUTLINE, MIN_OUTLINE, MAX_FIELD) == true;
    assert entry_len_ok(MAX_FIELD, MIN_OUTLINE, MAX_FIELD) == true;
    assert entry_len_ok(MIN_OUTLINE - 1, MIN_OUTLINE, MAX_FIELD) == false;
    assert entry_len_ok(MAX_FIELD + 1, MIN_OUTLINE, MAX_FIELD) == false;
}

test result_bounds_hold_at_the_short_end {
    assert entry_len_ok(MIN_RESULT, MIN_RESULT, MAX_FIELD) == true;
    assert entry_len_ok(MIN_RESULT - 1, MIN_RESULT, MAX_FIELD) == false;
}

test the_mins_are_ordered {
    assert MIN_RESULT < MIN_OUTLINE;
    assert MIN_OUTLINE < MAX_FIELD;
}
