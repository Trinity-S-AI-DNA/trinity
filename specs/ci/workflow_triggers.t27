// SPDX-License-Identifier: Apache-2.0
; The `on:` blocks of five GitHub Actions workflows, as data.
; apps/website/scripts/ci-triggers-from-spec.mjs reads this spec through the
; real compiler and rewrites the `on:` region of each file named in GENERATED.
; A workflow not listed here is not managed: the generator never touches it.
; Why five: these are the builds that pay minutes on every push to main, and
; the four prose filters below existed as parked hand edits (branch
; docs/ci-paths-ignore-website) before they became constants here. The site
; keeps its own gate (website-checks.yml), which deliberately carries no path
; filter -- a filter there made the check absent on most PRs, so it could not
; be required (#1535 merged 70 s after it opened with no site check at all).
module ci_workflow_triggers;

pub const GENERATED : [5]str = ["brain-ci.yml", "ci.yml", "codegen.yml", "koschei-production.yml", "reproduce.yml"];

; One list, four readers. The brain, the CI build, codegen and the production
; deploy all ignore the same three prose trees; reproduce instead names the
; build inputs it runs on. The list lives once so the four cannot drift.
pub const PROSE_PATHS_IGNORE : [3]str = ["apps/website/**", "docs/**", "**/*.md"];

pub const BRAIN_CI_ON_PUSH : bool = true;
pub const BRAIN_CI_PUSH_BRANCHES : [5]str = ["main", "v*", "feat/*", "fix/*", "refactor/*"];
pub const BRAIN_CI_ON_PR : bool = true;
pub const BRAIN_CI_PR_BRANCHES : [2]str = ["main", "v*"];
pub const BRAIN_CI_IGNORES_PROSE : bool = true;
pub const BRAIN_CI_ON_DISPATCH : bool = true;
pub const BRAIN_CI_SCHEDULED : bool = false;
pub const BRAIN_CI_NOTE_PUSH : [2]str = ["The brain is Zig in src/; a website or docs change cannot move its", "health score, and the site carries its own checks."];
pub const BRAIN_CI_NOTE_TAIL : [2]str = ["No schedule: block. The Queen (Inngest app t27-queen) dispatches this workflow", "on '0 0 * * 0' UTC from the card specs/crons/trinity-brain-ci.t27 in gHashTag/t27."];

pub const CI_ON_PUSH : bool = true;
pub const CI_PUSH_BRANCHES : [1]str = ["main"];
pub const CI_ON_PR : bool = true;
pub const CI_PR_BRANCHES : [1]str = ["main"];
pub const CI_IGNORES_PROSE : bool = true;
pub const CI_ON_DISPATCH : bool = true;
pub const CI_SCHEDULED : bool = false;
pub const CI_NOTE_PUSH : [3]str = ["A website or docs change ships no binary: the site carries its own", "checks (website-checks.yml), and this build would test an unchanged", "Zig tree twice for prose."];
pub const CI_NOTE_DISPATCH : [2]str = ["So this workflow's verdict can be refreshed behind a path filter;", "without it, its status is whatever its last accepted run concluded."];

pub const CODEGEN_ON_PUSH : bool = true;
pub const CODEGEN_PUSH_BRANCHES : [3]str = ["main", "ralph/dev-*", "vibee-v5-production"];
pub const CODEGEN_ON_PR : bool = true;
pub const CODEGEN_PR_BRANCHES : [1]str = ["main"];
pub const CODEGEN_IGNORES_PROSE : bool = true;
pub const CODEGEN_ON_DISPATCH : bool = true;
pub const CODEGEN_SCHEDULED : bool = false;
pub const CODEGEN_NOTE_PUSH : [2]str = ["Codegen consumes specs and the compiler in src/, not prose or the", "website; a docs-only merge regenerates byte-identical output."];
pub const CODEGEN_NOTE_TAIL : [2]str = ["No schedule: block. The Queen (Inngest app t27-queen) dispatches this workflow", "on '0 0 * * *' UTC from the card specs/crons/trinity-codegen.t27 in gHashTag/t27."];

pub const KOSCHEI_PRODUCTION_ON_PUSH : bool = true;
pub const KOSCHEI_PRODUCTION_PUSH_BRANCHES : [1]str = ["main"];
pub const KOSCHEI_PRODUCTION_ON_PR : bool = false;
pub const KOSCHEI_PRODUCTION_IGNORES_PROSE : bool = true;
pub const KOSCHEI_PRODUCTION_ON_DISPATCH : bool = true;
pub const KOSCHEI_PRODUCTION_SCHEDULED : bool = false;
pub const KOSCHEI_PRODUCTION_NOTE_PUSH : [2]str = ["A production deploy follows the code and images the swarm is built", "from, not prose: a website or docs merge ships nothing to KOSCHEI."];
pub const KOSCHEI_PRODUCTION_DISPATCH_INPUT_NAME : str = "environment";
pub const KOSCHEI_PRODUCTION_DISPATCH_INPUT_DESC : str = "Deployment environment";
pub const KOSCHEI_PRODUCTION_DISPATCH_INPUT_OPTIONS : [2]str = ["staging", "production"];
pub const KOSCHEI_PRODUCTION_DISPATCH_INPUT_DEFAULT : str = "production";

pub const REPRODUCE_ON_PUSH : bool = true;
pub const REPRODUCE_PUSH_BRANCHES : [1]str = ["main"];
pub const REPRODUCE_ON_PR : bool = true;
pub const REPRODUCE_PR_BRANCHES : [1]str = ["main"];
pub const REPRODUCE_IGNORES_PROSE : bool = false;
pub const REPRODUCE_PATHS : [10]str = ["build.zig", "build.zig.zon", "src/**", "external/**", "deploy/**/*.zig", "tools/reproduce.py", "tools/capabilities.py", "tools/contracts.py", "specs/reproduce/**", ".github/workflows/reproduce.yml"];
pub const REPRODUCE_ON_DISPATCH : bool = true;
pub const REPRODUCE_SCHEDULED : bool = true;
pub const REPRODUCE_SCHEDULE : [1]str = ["23 4 * * 1"];
pub const REPRODUCE_NOTE_PUSH : [3]str = ["The same inputs as the pull_request block: without them, every", "merge to main -- a blog post included -- rebuilt the headless profile", "from a cold cache to prove nothing new."];

test managed_workflows_are_the_five_paying_builds {
    assert GENERATED[0] == "brain-ci.yml";
    assert GENERATED[1] == "ci.yml";
    assert GENERATED[2] == "codegen.yml";
    assert GENERATED[3] == "koschei-production.yml";
    assert GENERATED[4] == "reproduce.yml";
}

test prose_filter_is_one_list_not_four {
    assert PROSE_PATHS_IGNORE[0] == "apps/website/**";
    assert PROSE_PATHS_IGNORE[1] == "docs/**";
    assert PROSE_PATHS_IGNORE[2] == "**/*.md";
    assert BRAIN_CI_IGNORES_PROSE == true;
    assert CI_IGNORES_PROSE == true;
    assert CODEGEN_IGNORES_PROSE == true;
    assert KOSCHEI_PRODUCTION_IGNORES_PROSE == true;
    assert REPRODUCE_IGNORES_PROSE == false;
}

test reproduce_runs_on_build_inputs_only {
    assert REPRODUCE_PATHS[0] == "build.zig";
    assert REPRODUCE_PATHS[4] == "deploy/**/*.zig";
    assert REPRODUCE_PATHS[9] == ".github/workflows/reproduce.yml";
    assert REPRODUCE_SCHEDULED == true;
    assert REPRODUCE_SCHEDULE[0] == "23 4 * * 1";
    assert BRAIN_CI_SCHEDULED == false;
    assert CI_SCHEDULED == false;
    assert CODEGEN_SCHEDULED == false;
    assert KOSCHEI_PRODUCTION_SCHEDULED == false;
}

test only_koschei_dispatches_with_an_input {
    assert BRAIN_CI_ON_DISPATCH == true;
    assert CI_ON_DISPATCH == true;
    assert CODEGEN_ON_DISPATCH == true;
    assert KOSCHEI_PRODUCTION_ON_DISPATCH == true;
    assert REPRODUCE_ON_DISPATCH == true;
    assert KOSCHEI_PRODUCTION_ON_PR == false;
    assert KOSCHEI_PRODUCTION_DISPATCH_INPUT_NAME == "environment";
    assert KOSCHEI_PRODUCTION_DISPATCH_INPUT_OPTIONS[0] == "staging";
    assert KOSCHEI_PRODUCTION_DISPATCH_INPUT_OPTIONS[1] == "production";
    assert KOSCHEI_PRODUCTION_DISPATCH_INPUT_DEFAULT == KOSCHEI_PRODUCTION_DISPATCH_INPUT_OPTIONS[1];
}

test every_managed_workflow_answers_pushes {
    assert BRAIN_CI_ON_PUSH == true;
    assert CI_ON_PUSH == true;
    assert CODEGEN_ON_PUSH == true;
    assert KOSCHEI_PRODUCTION_ON_PUSH == true;
    assert REPRODUCE_ON_PUSH == true;
    assert BRAIN_CI_ON_PR == true;
    assert CI_ON_PR == true;
    assert CODEGEN_ON_PR == true;
    assert REPRODUCE_ON_PR == true;
}
