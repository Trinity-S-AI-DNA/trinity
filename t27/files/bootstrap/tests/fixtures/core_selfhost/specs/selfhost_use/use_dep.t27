// The module the `use` refusal fixtures in ../../refuse import (#7378).
// gen-c looks for `specs/` from the importer's directory upward, so for a
// fixture under bootstrap/tests/fixtures/core_selfhost it finds this tree
// first, and `use selfhost_use::use_dep;` names this file.
module use_dep;
const UD_LIMIT: i64 = 7;
const ud_step: i64 = 3;
let UD_FLOOR: i64 = 1;
var ud_count: i64 = 0;
fn ud_twice(a: i64) -> i64 {
    return a * 2;
}
fn ud_unused() -> i64 {
    return UD_LIMIT + ud_step;
}
test ud_values {
    assert(ud_twice(UD_LIMIT) == 14);
    assert(ud_unused() == 10);
    assert(UD_FLOOR == 1);
    ud_count = ud_count + 1;
    assert(ud_count == 1);
}
