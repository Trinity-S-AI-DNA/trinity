// Nested arrays and list initializers: gen-c writes each list as the same C
// braces, and a[i][j] reads, stores and compound-assigns one scalar.
module nested_arrays;
const K: u8 = 3;
var grid: [2][3]u8 = [_][3]u8{
    [_]u8{ 1, 2, K },
    [_]u8{ 0x4, 1_0, 6, },
};
pub var cells: [2][2]i64 = [_][2]i64{ [_]i64{ -1, 2 * 3 }, [_]i64{ 0, 0 } };
var flat: [3]u16 = [_]u16{ 7, 8, 9 };
fn bump(i: usize, j: usize) -> void {
    grid[i][j] += 1;
    cells[i % 2][j % 2] = cells[i % 2][j % 2] * 2;
}
fn sum() -> i64 {
    var s: i64 = 0;
    var i: usize = 0;
    while (i < 2) {
        var j: usize = 0;
        while (j < 3) {
            s = s + (grid[i][j] as i64);
            j = j + 1;
        }
        i = i + 1;
    }
    return s + (flat[2] as i64);
}
test nested_reads_and_writes {
    assert(sum() == 35);
    bump(1, 2);
    assert(grid[1][2] == 7);
    bump(0, 1);
    assert(cells[0][1] == 12);
    grid[0][0] = 5;
    cells[1][1] -= 4;
    assert(cells[1][1] == -4);
    assert(cells[0][0] == -1);
    assert(sum() == 41);
}
