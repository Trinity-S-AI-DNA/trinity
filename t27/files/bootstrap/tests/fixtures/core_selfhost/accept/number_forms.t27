// #7321: numeric literal forms and `pub`. A `_` separator in a decimal, `0x`
// or `0b` number is written without it; `0b` reaches C as it is; `pub` on a
// const, a var and a fn changes no byte.
module numforms;
const MILLION: i64 = 1_000_000;
pub const MASK: u32 = 0xFF_00;
const BITS: u8 = 0b1010_0101;
const NEG: i64 = -0b11;
const SUM: i64 = -1_000 + 0x1_0;
const N: usize = 1_6;
pub var count: u32 = 0b0;
var big: u64 = 0xFFFF_FFFF_FFFF_FFFF;
var tab: [N]u16 = [_]u16{0x1_0} ** 1_6;
pub var flags: [4]u8 = [_]u8{0b0000_0000} ** 4;
pub fn pick(x: u32) -> u32 {
    var m: u32 = x & MASK;
    if (m > 0x0F_00) {
        m = m >> 0b1000;
    }
    count = count + 0b1;
    return m;
}
fn total() -> usize {
    var s: usize = 0;
    var i: usize = 0;
    while (i < N) {
        s = s + (tab[i] as usize);
        i = i + 1_0 - 9;
    }
    return s;
}
test values {
    assert(MILLION == 1000000);
    assert(MASK == 65280);
    assert(BITS == 165);
    assert(NEG == -3);
    assert(SUM == -984);
    assert(big == 0xFFFF_FFFF_FFFF_FFFF);
    assert(pick(0x12_34) == 18);
    assert(count == 1);
    assert(total() == 256);
    assert(flags[3] == 0);
    assert(tab[1_5] == 16);
}
