// #7377: `pub` on every declaration the core accepts changes no byte: a
// `let`, a char const, a `var` array with a repeated value, a `fn` that
// returns nothing, and `pub` on a line of its own before the word it marks.
module pubshapes;
pub let PS_BASE: i64 = 40;
pub const PS_MARK: u8 = 'k';
pub
var ps_hits: [3]u16 = [_]u16{2} ** 3;
pub fn ps_bump(i: usize) -> void {
    ps_hits[i] = ps_hits[i] + 1;
}
pub
fn ps_total() -> i64 {
    return PS_BASE + (ps_hits[0] as i64) + (ps_hits[2] as i64);
}
test pub_values {
    ps_bump(2);
    assert(ps_total() == 45);
    assert(PS_MARK == 107);
}
