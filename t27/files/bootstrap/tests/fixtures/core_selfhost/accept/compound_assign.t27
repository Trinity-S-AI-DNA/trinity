// #7306: compound assignment, all eight operators gen-c accepts, on a local,
// a module var, an array element, inside loops and in a test block.
module compound;
var g: i64 = 0;
var arr: [4]i64 = [_]i64{0} ** 4;
fn f(x: i64) -> i64 {
    var y: i64 = x;
    y += 1;
    y -= 2;
    y *= 3;
    y /= 2;
    y %= 5;
    y |= 8;
    y &= 13;
    y ^= 1;
    g += y;
    arr[1] += y + 1;
    arr[2] -= - -1;
    return y;
}
fn bits(k: u8) -> u8 {
    var m: u8 = k;
    m &= 0x0F;
    m |= 0x30;
    m ^= 1;
    return m;
}
fn sum(n: usize) -> usize {
    var s: usize = 100;
    var i: usize = 0;
    while (i < n) {
        if (i % 2 == 0) {
            s += i * 10;
        } else {
            s -= i;
        }
        i += 1;
    }
    return s;
}
test values {
    var z: i64 = 1;
    z += 2;
    assert(z == 3);
    assert(f(7) == 13);
    assert(g == 13);
    g += 1;
    assert(g == 14);
    assert(arr[1] == 14);
    assert(arr[2] == -1);
    arr[3] += 4;
    assert(arr[3] == 4);
    assert(bits(69) == 52);
    assert(sum(5) == 156);
}
