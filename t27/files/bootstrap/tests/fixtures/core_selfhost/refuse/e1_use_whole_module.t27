// #7378: `use` names another file, and the core reads one module, so it
// cannot know what gen-c splices in. This import is lossless in gen-c: it
// splices `ud_twice` and `UD_LIMIT` from ../specs/selfhost_use/use_dep.t27.
// The core refuses every `use` until it can read the module it names.
module use_whole;
use selfhost_use::use_dep;
fn uw_sum(a: i64) -> i64 {
    return ud_twice(a) + UD_LIMIT;
}
