// #7378, gen-c defect #7380: the splice pulls the imported const `ud_step`
// because a local has its name, and gen-c writes a const as a C macro, so
// `#define ud_step 3` rewrites the local's declaration into `int64_t 3 = ...`.
// gen-c exits 0 and its C does not build.
module use_capture;
use selfhost_use::use_dep;
fn uc_next(a: i64) -> i64 {
    var ud_step: i64 = a + 1;
    return ud_step;
}
