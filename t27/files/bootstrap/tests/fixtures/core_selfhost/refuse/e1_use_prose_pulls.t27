// #7378, gen-c defect #7379: the splice reads identifiers in `;` prose as
// references, so the prose line below pulls `ud_unused` (and with it
// `UD_LIMIT` and `ud_step`) into the output, though no code calls it.
module use_prose;
use selfhost_use::use_dep;

; up_id does not call ud_unused.

fn up_id(a: i64) -> i64 {
    return a;
}
