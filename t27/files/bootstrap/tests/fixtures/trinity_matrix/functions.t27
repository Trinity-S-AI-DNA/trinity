// trinity_matrix/functions.t27 -- feature functions: parameters, early return, recursion, calls between functions.
module trinity_matrix_functions;

pub fn factorial(n: u32) -> u32 {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

pub fn clamp(x: i32, lo: i32, hi: i32) -> i32 {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

pub fn twice_clamped(x: i32) -> i32 {
    return clamp(x, -10, 10) * 2;
}

test recursion_and_calls {
    assert factorial(5) == 120;
    assert clamp(15, -10, 10) == 10;
    assert twice_clamped(-30) == -20;
}
