// trinity_matrix/arrays.t27 -- feature arrays: fixed-size arrays, indexing and a loop over them.
module trinity_matrix_arrays;

pub const TABLE : [4]u8 = [1, 2, 3, 5];
pub const NAMES : [2]str = ["dot", "join"];

pub fn sum_table() -> u32 {
    var total : u32 = 0;
    var i : u32 = 0;
    while (i < 4) {
        total = total + TABLE[i];
        i = i + 1;
    }
    return total;
}

test indexing_and_sum {
    assert TABLE[0] == 1;
    assert TABLE[3] == 5;
    assert sum_table() == 11;
}

test string_array_elements {
    assert NAMES[1] == "join";
}
