// trinity_matrix/clocked_state.t27 -- feature clocked state: registered variables updated by on_clock and a
// combinational output, the form the Trinity memory RTL specs use; runtime evidence comes from the Verilog
// backend through Icarus (t27c icarus-simulate) and the C backend runs the test blocks.
module trinity_matrix_clocked_state;
var count: u32 = 0;
var tick: bool = false;
var div_bit: bool;
div_bit = (count & 4) == 4;
fn on_clock(hold: bool) {
    tick = !hold && count == 6;
    if (hold) { count = 0; } else { count = (count + 1) & 7; }
}
test wraps_at_eight { assert_eq((7 + 1) & 7, 0); }
test div_bit_is_the_third_bit { assert_eq((4 & 4) == 4, true); }
endmodule
