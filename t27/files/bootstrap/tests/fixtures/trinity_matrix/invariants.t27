// trinity_matrix/invariants.t27 -- feature tests and invariants: constant invariants and a test block that checks them.
module trinity_matrix_invariants;

pub const FRAME_BEATS : u32 = 64;
pub const FRAMES : u32 = 16;
pub const TOTAL_BEATS : u32 = 1024;

invariant total_is_frames_times_beats {
    FRAME_BEATS * FRAMES == TOTAL_BEATS
}

invariant beats_fit_sixteen_bits {
    TOTAL_BEATS < 65536
}

test the_invariants_hold_at_runtime_too {
    assert FRAME_BEATS * FRAMES == TOTAL_BEATS;
    assert TOTAL_BEATS < 65536;
}
