// trinity_matrix/neg_false_assert.t27 -- NEGATIVE: a test whose assertion is false; typecheck stays ok,
// so only a runtime run can reject it, and it must.
module trinity_matrix_neg_false_assert;

pub const ONE : u8 = 1;

test one_is_greater_than_two {
    assert ONE > 2;
}
