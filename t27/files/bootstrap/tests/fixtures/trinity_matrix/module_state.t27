// trinity_matrix/module_state.t27 -- feature module state: a var at module level, read and written by functions.
module trinity_matrix_module_state;

var counter : u32 = 0;

pub fn bump(by: u32) -> u32 {
    counter = counter + by;
    return counter;
}

pub fn reset() {
    counter = 0;
}

test state_persists_between_calls {
    reset();
    assert bump(2) == 2;
    assert bump(3) == 5;
    reset();
    assert bump(1) == 1;
}
