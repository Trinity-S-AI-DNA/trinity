module p1;
test step_without_weight_decay_matches_adam
    given config = AdamWConfig{.learning_rate = 0.001, .beta1 = 0.9, .beta2 = 0.999, .weight_decay = 0.0}
    and   state = init(config, 1)
    and   params = [1.0]
    when result = step(state, params, grads)
    then result.updated_params.len == 1
