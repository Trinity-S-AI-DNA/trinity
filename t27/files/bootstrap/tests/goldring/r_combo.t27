module R4
fn f(x_val: f32) -> f32 {
    var result: f32 = 1.0;
    var term: f32 = 1.0;
    const num_terms: u32 = 5;
    for (0..num_terms) |i| {
        if (i > 0) {
            term *= x_val / @as(f32, @floatFromInt(i));
            result += term;
        }
    }
    return result;
}
test "t" { assert(f(0.0) == 1.0); }
