; bootstrap/src/codegen_python.t27 -- what `t27c gen-python` prints, as constants the compiler
; checks. The implementation is bootstrap/src/codegen_python.rs. Every Python spelling named here
; lives in the value layer that backend shares with gen-js and gen-ts (bootstrap/src/codegen_js.rs,
; target PY), so the three cannot disagree about a value.
; The artifact is DATA. A spec's consts become module-level assignments, an enum becomes a dict
; whose discriminants resume counting after an explicit one, and a struct becomes a descriptor
; dict naming its fields and their types. fn, test, bench and invariant blocks are announced in a
; comment and never stubbed: a signature this backend printed would be invented, not read. The
; module imports nothing, so its dicts are mutable where the JavaScript artifact is frozen. It
; ends with three lists: __STRUCT_ORDER__, __DECL_ORDER__, and __NOT_EMITTED__, which holds one
; record for each declaration the spec has and the module does not bind.
; This file replaces a stub that sketched Python classes and functions for a CLARA deliverable
; and deferred the implementation as P1. The backend that landed took the data-only contract
; gen-js settled on instead, so the stub described a module nobody prints, and its tests asserted
; output this backend is built never to emit.
; Each SAMPLE constant below is lowered to exactly the line in the matching _LINE string.
; bootstrap/tests/gen_python_behaviour.rs generates this file and fails when any _LINE string is
; not a line of the artifact, so this file cannot drift from the backend without a red test.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module codegen_python;

; The command, and the prefix every announcement in the artifact starts with.
pub const COMMAND : str = "gen-python";
pub const ANNOUNCE_PREFIX : str = "# t27c gen-python: ";
; Spellings that differ from the JavaScript artifact.
pub const TRUE_WORD : str = "True";
pub const FALSE_WORD : str = "False";
pub const NULL_WORD : str = "None";
pub const AND_WORD : str = "and";
pub const OR_WORD : str = "or";
pub const NOT_WORD : str = "not";
pub const INTEGER_DIVISION : str = "//";
; The three lists every artifact ends with.
pub const STRUCT_ORDER_NAME : str = "__STRUCT_ORDER__";
pub const DECL_ORDER_NAME : str = "__DECL_ORDER__";
pub const NOT_EMITTED_NAME : str = "__NOT_EMITTED__";
; What is lowered to a value, and what is only announced.
pub const LOWERED : [3]str = ["const", "enum", "struct"];
pub const ANNOUNCED : [4]str = ["fn", "test", "bench", "invariant"];
pub const EMITS_FUNCTIONS : bool = false;
pub const EMITS_CLASSES : bool = false;
pub const EMITS_IMPORTS : bool = false;

; Samples, each beside the line gen-python prints for it.
pub const SAMPLE_HEX : u32 = 0xFF00;
pub const SAMPLE_HEX_LINE : str = "SAMPLE_HEX = 0xFF00";
pub const SAMPLE_ON : bool = true;
pub const SAMPLE_ON_LINE : str = "SAMPLE_ON = True";
pub const SAMPLE_OFF : bool = false;
pub const SAMPLE_OFF_LINE : str = "SAMPLE_OFF = False";
; An integer divided by an integer stays an integer: // and not /.
pub const SAMPLE_HALF : u8 = 7 / 2;
pub const SAMPLE_HALF_LINE : str = "SAMPLE_HALF = (7 // 2)";
pub const SAMPLE_BOTH : bool = SAMPLE_ON && !SAMPLE_OFF;
pub const SAMPLE_BOTH_LINE : str = "SAMPLE_BOTH = (SAMPLE_ON and (not SAMPLE_OFF))";
; A shift is masked to the declared width, because a Python int never overflows on its own.
pub const SAMPLE_WIDE : u64 = 1 << 40;
pub const SAMPLE_WIDE_LINE : str = "SAMPLE_WIDE = ((1 << 40) & 0xFFFFFFFFFFFFFFFF)";
; A byte string is its bytes.
pub const SAMPLE_BYTES : [2]u8 = "v1";
pub const SAMPLE_BYTES_LINE : str = "SAMPLE_BYTES = [118, 49]";
; An enum resumes counting after an explicit discriminant.
pub const SampleLevel = enum { Low, High = 7, Top, };
pub const SAMPLE_LEVEL_LINE : str = "SampleLevel = { \"Low\": 0, \"High\": 7, \"Top\": 8 }";
; A struct is a descriptor of its fields, not a class.
pub struct SamplePair {
    pub low : u8,
    pub set : bool,
}
pub const SAMPLE_PAIR_LINE : str = "SamplePair = {\"__struct__\": \"SamplePair\", \"fields\": [[\"low\", \"u8\"], [\"set\", \"bool\"]]}";
; A fn leaves this one comment line in the artifact and nothing else.
pub fn sample_double(x : u8) -> u8 {
    return x * 2;
}
pub const SAMPLE_FN_LINE : str = "# t27c gen-python: fn sample_double was not emitted -- this backend lowers declarations, not bodies.";

test the_artifact_is_data_and_lists_what_it_left_out {
    assert EMITS_FUNCTIONS == false;
    assert EMITS_CLASSES == false;
    assert EMITS_IMPORTS == false;
    assert NOT_EMITTED_NAME == "__NOT_EMITTED__";
    assert LOWERED[0] == "const";
    assert ANNOUNCED[0] == "fn";
}

test the_samples_hold_the_values_python_reads_back {
    assert SAMPLE_HEX == 65280;
    assert SAMPLE_HALF == 3;
    assert SAMPLE_WIDE == 1099511627776;
    assert SAMPLE_BOTH == true;
    assert sample_double(4) == 8;
}

invariant python_spells_its_literals_and_operators_as_words {
    assert TRUE_WORD == "True";
    assert FALSE_WORD == "False";
    assert NULL_WORD == "None";
    assert AND_WORD == "and";
    assert OR_WORD == "or";
    assert NOT_WORD == "not";
    assert INTEGER_DIVISION == "//";
}
