{
  "mcpServers": {
    "trinity": {
      "command": "/data/trinity/zig-out/bin/trinity-mcp",
      "args": [],
      "env": {"TRINITY_MCP_PORT": "8899"}
    },
    "zig-docs": {
      "command": "npx",
      "args": ["-y", "@nichochar/zig-mcp@latest"],
      "env": {}
    },
    "railway-mcp-server": {
      "command": "npx",
      "args": ["-y", "@railway/mcp-server"]
    },
    "neon": {
      "command": "npx",
      "args": ["-y", "@neondatabase/mcp-server-neon", "start"],
      "env": {
        "NEON_API_KEY": "${NEON_API_KEY}"
      }
    }
  }
}
