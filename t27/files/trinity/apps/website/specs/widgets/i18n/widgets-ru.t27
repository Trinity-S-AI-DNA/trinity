// SPDX-License-Identifier: Apache-2.0
; specs/widgets/i18n/widgets-ru.t27 -- translation contract, Russian, for the widget pages
; Widget specs are English-only (LANG-EN, L3). This module carries no translated word: it
; says WHICH fields of specs/widgets/<id>.t27 the Russian bundle translates, WHERE the
; bundle lives, HOW it is keyed and which widgets must be covered whole.
; The Cyrillic text is in the bundle named by BUNDLE_PATH, never in a .t27 file.
; apps/website/scripts/widget-pages-from-spec.mjs refuses the build when the bundle names a
; widget or a field the specs do not have, changes an array's length, or leaves a SAY_
; field of a covered widget untranslated. A page inlines its Russian words and swaps them
; in when it is opened with ?lang=ru (the course frames do this on Russian pages).
; phi^2 + 1/phi^2 = 3 | TRINITY

module widgets_ru;

pub const KIND : str = "i18n";
pub const LOCALE : str = "ru";
pub const SOURCE_LOCALE : str = "en";
pub const SOURCE_DIR : str = "specs/widgets";
pub const BUNDLE_PATH : str = "apps/website/i18n/widgets.ru.json";
pub const BUNDLE_FORMAT : str = "json";
; The bundle's widgets object is keyed by a widget ID, then by a field name with this prefix.
pub const FIELD_PREFIX : str = "SAY_";
; Widgets whose ID starts with one of these must carry every SAY_ field in Russian.
pub const COVERAGE_PREFIXES : [1]str = ["basics-"];
pub const QUERY_PARAM : str = "lang";
pub const FALLBACK : str = "en";
pub const ORPHANS_ALLOWED : bool = false;

test the_covered_widgets_are_translated_whole {
    assert ORPHANS_ALLOWED == false;
    assert LOCALE == "ru";
    assert FALLBACK == "en";
}

test the_words_are_the_say_fields {
    assert FIELD_PREFIX == "SAY_";
    assert QUERY_PARAM == "lang";
}
