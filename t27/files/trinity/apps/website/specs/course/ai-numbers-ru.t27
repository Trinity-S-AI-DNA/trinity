// SPDX-License-Identifier: Apache-2.0
; specs/course/ai-numbers-ru.t27 -- translation contract, Russian, for the AI numbers course
; Specs are English-only (LANG-EN, L3). This module carries no translated word: it
; says WHICH fields of specs/course/ai-numbers.t27 the Russian bundle translates, WHERE
; the bundle lives, HOW it is keyed and what the page does when a field is missing.
; The Cyrillic text is in the bundle named by BUNDLE_PATH, never in a .t27 file.
; apps/website/scripts/course-from-spec.mjs refuses the build when the bundle misses
; a field (COVERAGE_REQUIRED), carries a key the course does not have
; (ORPHANS_ALLOWED), changes a number, or drops a {placeholder}.
; phi^2 + 1/phi^2 = 3 | TRINITY

module ai_numbers_ru;

pub const KIND : str = "i18n";
pub const LOCALE : str = "ru";
pub const SOURCE_LOCALE : str = "en";
pub const SOURCE_SPEC : str = "specs/course/ai-numbers.t27";
pub const BUNDLE_REPO : str = "trinity";
pub const BUNDLE_PATH : str = "apps/website/i18n/ai-numbers.ru.json";
pub const BUNDLE_FORMAT : str = "json";
; A module entry is keyed by its MODULE_IDS value, a lesson entry by its LESSON_IDS
; value; the page strings sit under the key UI_KEY, keyed by the SAY_ name.
pub const MODULE_FIELDS : [2]str = ["TITLE", "LINE"];
pub const LESSON_FIELDS : [4]str = ["TITLE", "GOAL", "TEXT", "TASK"];
pub const UI_KEY : str = "ui";
pub const FALLBACK : str = "en";
; true: a module, lesson or page string with no Russian fails the build.
pub const COVERAGE_REQUIRED : bool = true;
; false: a bundle key the course does not have fails the build.
pub const ORPHANS_ALLOWED : bool = false;
pub const ENABLED : bool = true;

test the_course_is_translated_whole {
    assert COVERAGE_REQUIRED == true;
    assert ORPHANS_ALLOWED == false;
    assert LOCALE == "ru";
    assert FALLBACK == "en";
}
