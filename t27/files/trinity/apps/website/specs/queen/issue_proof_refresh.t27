// SPDX-License-Identifier: Apache-2.0
; Issue: https://github.com/gHashTag/trinity/issues/1392
; Both issue proof policies (Corona, Memory) fail closed in time as well as in
; content. A positive verdict is published -- written to a cache or returned as
; coverage t27 -- only while all three hold:
; bit 0 = the evidence verified at the observed default-branch HEAD;
; bit 1 = the check is still the current generation for its repository: no
;         invalidate and no newer check for that repository began after it;
; bit 2 = the caller's signal is not aborted.
; invalidateIssueProof and the start of every new check advance the generation,
; so a superseded check ends as unknown and cannot refill a cleared cache.
; Callers of one generation share its single in-flight check.
module queen_issue_proof_refresh;

pub const PUBLISH : [8]u8 = [0,0,0,0,0,0,0,1];
; An observed positive row -- the details cache, the cell stage, the hive and
; the universe snapshot -- survives a refresh only when:
; bit 0 = the refresh succeeded;
; bit 1 = it is the latest request for that row.
; A refresh removes the old row before it reads. On failure every layer
; withdraws coverage and proof and keeps the lifecycle as the last observation.
; Delay inside CACHE_MS after the last successful observation stays allowed.
pub const RETAIN : [4]u8 = [0,0,0,1];

test only_current_verified_live_checks_publish {
    assert PUBLISH[0] == 0;
    assert PUBLISH[1] == 0;
    assert PUBLISH[2] == 0;
    assert PUBLISH[3] == 0;
    assert PUBLISH[4] == 0;
    assert PUBLISH[5] == 0;
    assert PUBLISH[6] == 0;
    assert PUBLISH[7] == 1;
}
test failed_or_superseded_refresh_withdraws {
    assert RETAIN[0] == 0;
    assert RETAIN[1] == 0;
    assert RETAIN[2] == 0;
    assert RETAIN[3] == 1;
}
