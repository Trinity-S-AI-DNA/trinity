// SPDX-License-Identifier: Apache-2.0
; specs/widgets/gf16-calc.t27 -- the GF16 calculator: one number, its 16 GoldenFloat bits, and the
; same number in balanced ternary, trit by trit.
; Source of truth for public/widgets/gf16-calc/ (gHashTag/trinity): every word on that page is a
; SAY_* constant below and every number its logic needs is a K_* constant. tool.js holds neither.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader types a decimal number (or 16 raw bits as hex). The page rounds the
; decimal exactly -- as a fraction of big integers, never through a binary64 first -- to the
; nearest GF16 value, draws the sign, exponent and mantissa fields bit by bit, prints the decoded
; value in full (every GF16 value is a finite binary fraction, so it has a finite decimal), and
; the error of the rounding. Beside it the same number in balanced ternary: digits -1, 0, +1 and
; K_TERNARY_FRAC_TRITS trits after the point. Then the round trip: the decoded value encoded again
; gives the same 16 bits, and the trits read back give the same trits.

; WHERE THE FORMAT COMES FROM (law L6): conformance/FORMAT-SPEC-001.json, formats.GF16, in
; gHashTag/t27 -- bits 16, sign 1, exp 6, mant 9, bias 31, exp_max 63, read on 2026-10-05 -- and
; specs/numeric/gf16.t27. At run time the page reads the layout again from the vendored copy of
; gf16.t27 that t27.ai already serves (K_LAYOUT_FILE: SIGN_SHIFT, EXP_SHIFT, EXP_MAX, BIAS,
; MANT_MASK, GF16_NAN), uses those values, and says so on screen; if that file cannot be read, or
; disagrees with K_* below, the page says that too. The tests below hold K_* to what
; FORMAT-SPEC-001.json says, so a change to the format fails this spec before it reaches a reader.
; Subnormals, the largest normal and overflow to infinity follow the bit-exact pack
; conformance/vectors/gf16_conformance_v0.json, whose finite and infinite vectors the page runs on
; itself at load (K_CHECK_INPUTS, K_CHECK_BITS) and reports.

; WHAT IT DOES NOT CLAIM: that GF16 is better than any other 16-bit format; the page compares GF16
; with nothing. The SSOT names two tie rules -- gf16.t27 says round to nearest, ties to even;
; FORMAT-SPEC-001.json records that the frozen TT4913 Gamma multiplier rounds ties toward zero --
; so the page offers both, says which source each comes from, and starts on ties to even. The two
; tie vectors (K_TIE_*) are this widget's own arithmetic, not vectors from the SSOT. gf16.t27's
; encoder comment says subnormals are flushed to zero; the conformance pack encodes them, and the
; page follows the pack. Balanced ternary here is positional notation, not a GoldenFloat format.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_gf16_calc;

pub const KIND : str = "widget-tool";
pub const ID : str = "gf16-calc";
pub const TITLE : str = "GF16 calculator: a number as 16 GoldenFloat bits and as ternary";
pub const DESCRIPTION : str = "Type a number and see its GF16 sign, exponent and mantissa bit by bit, the exact value it rounds to, the error, and the same number in balanced ternary.";
pub const IMAGE_ALT : str = "The GF16 calculator on phi = 1.6180339887: sixteen bits in three coloured fields, sign 0, exponent 31, mantissa 316, hex 0x3F3C, decoded exactly as 1.6171875 with a relative error of 5.2e-4, and below it phi in balanced ternary as trits T, 0 and 1.";
pub const HOOK : str = "Where does phi land in 16 bits? Type any number and watch it rounded to GF16, field by field, with the error printed exactly.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [3]str = ["https://github.com/gHashTag/t27/blob/master/conformance/FORMAT-SPEC-001.json (formats.GF16, frozen_silicon_anchor)", "https://t27.ai/t27/files/specs/numeric/gf16.t27 (layout constants, read by the page at run time)", "https://github.com/gHashTag/t27/blob/master/conformance/vectors/gf16_conformance_v0.json (vectors the page checks itself against)"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The format, as FORMAT-SPEC-001.json states it (formats.GF16) ------------------------------
pub const K_FORMAT_NAME : str = "GF16";
pub const K_BITS : u8 = 16;
pub const K_SIGN_BITS : u8 = 1;
pub const K_EXP_BITS : u8 = 6;
pub const K_MANT_BITS : u8 = 9;
pub const K_BIAS : u8 = 31;
pub const K_EXP_MAX : u8 = 63;
; 2^K_MANT_BITS: the implicit leading one of a normal number, in mantissa units.
pub const K_MANT_ONE : u16 = 512;
; gf16.t27 GF16_NAN (0xFE01): the code the page writes for a NaN input.
pub const K_NAN_BITS : u16 = 65025;

; --- Where the page reads the layout at run time ------------------------------------------------
; Relative to tool.js, so it resolves on t27.ai and under any path the site is served from.
pub const K_LAYOUT_FILE : str = "../../t27/files/specs/numeric/gf16.t27";
pub const K_LAYOUT_NAMES : [6]str = ["SIGN_SHIFT", "EXP_SHIFT", "EXP_MAX", "BIAS", "MANT_MASK", "GF16_NAN"];

; --- Rounding ----------------------------------------------------------------------------------
pub const K_ROUNDING_IDS : [2]str = ["even", "zero"];
pub const K_DEFAULT_ROUNDING : str = "even";

; --- Balanced ternary ----------------------------------------------------------------------------
pub const K_TERNARY_FRAC_TRITS : u8 = 9;
pub const K_TERNARY_MAX_TRITS : u8 = 48;
; Two notations for the digits -1, 0, +1: the first three, then the last three.
pub const K_TRIT_GLYPHS : [6]str = ["T", "0", "1", "-", "0", "+"];

; --- Input ---------------------------------------------------------------------------------------
pub const K_DEFAULT_INPUT : str = "1.618033988749895";
pub const K_EXAMPLES : [7]str = ["1.618033988749895", "0.1", "-2.5", "3.141592653589793", "1.0029296875", "1e-11", "0x7E00"];
; Decimal exponents beyond this are refused rather than turned into a huge integer.
pub const K_DECIMAL_EXP_LIMIT : u16 = 999;
; Significant digits for errors and approximate values.
pub const K_SIG_DIGITS : u8 = 4;

; --- Self-check at load: gf16_conformance_v0.json, every finite and infinite vector -------------
; Inputs exactly as the pack prints input_f64; bits are its gf16_bits_int.
pub const K_CHECK_COUNT : u8 = 20;
pub const K_CHECK_NAMES : [20]str = ["pos_zero", "neg_zero", "pos_one", "neg_one", "pos_two", "pos_half", "phi", "inv_phi", "phi_squared", "inv_phi_sq", "three", "smallest_subnormal", "largest_subnormal", "smallest_normal", "largest_normal", "overflow_to_inf", "pos_inf", "neg_inf", "e", "pi"];
pub const K_CHECK_INPUTS : [20]str = ["0.0", "-0.0", "1.0", "-1.0", "2.0", "0.5", "1.618033988749895", "0.6180339887498948", "2.618033988749895", "0.3819660112501051", "3.0", "1.8189894035458565e-12", "9.295035852119327e-10", "9.313225746154785e-10", "4290772992.0", "1e+40", "inf", "-inf", "2.718281828459045", "3.141592653589793"];
pub const K_CHECK_BITS : [20]u16 = [0, 32768, 15872, 48640, 16384, 15360, 16188, 15481, 16542, 15118, 16640, 1, 511, 512, 32255, 32256, 32256, 65024, 16568, 16676];

; --- Tie vectors: this widget's arithmetic, not the SSOT's ------------------------------------
; 1 + 2^-10 lies halfway between mantissa 0 and 1; 1 + 3 * 2^-10 halfway between 1 and 2.
pub const K_TIE_INPUTS : [2]str = ["1.0009765625", "1.0029296875"];
pub const K_TIE_BITS_EVEN : [2]u16 = [15872, 15874];
pub const K_TIE_BITS_ZERO : [2]u16 = [15872, 15873];

; --- Every word on the page ---------------------------------------------------------------------
pub const SAY_INPUT_LABEL : str = "A decimal number, or 16 raw bits as hex";
pub const SAY_INPUT_PLACEHOLDER : str = "1.618033988749895 or 0x3F3C";
pub const SAY_EXAMPLES_LABEL : str = "Try";
pub const SAY_ROUNDING_LABEL : str = "Ties";
pub const SAY_ROUNDING_NAMES : [2]str = ["to even", "toward zero"];
pub const SAY_ROUNDING_NOTES : [2]str = ["Round to nearest, ties to even: the rule gf16.t27 states for its encoder.", "Round to nearest, ties toward zero: the frozen TT4913 Gamma multiplier, per FORMAT-SPEC-001.json."];
pub const SAY_NOTATION_LABEL : str = "Trits";
pub const SAY_NOTATION_NAMES : [2]str = ["T 0 1", "- 0 +"];
pub const SAY_COPY_LINK : str = "Copy link";
pub const SAY_COPIED : str = "Copied";
pub const SAY_BAD_INPUT : str = "Not a number this page reads. Use digits with an optional point and exponent (1e-3), inf, nan, or 0x and up to 4 hex digits.";
pub const SAY_GF16_HEADING : str = "GF16";
pub const SAY_FIELD_NAMES : [3]str = ["sign", "exponent", "mantissa"];
pub const SAY_BIT_TITLE : str = "bit {i}";
pub const SAY_SIGN_DETAIL : [2]str = ["0: positive", "1: negative"];
pub const SAY_EXP_DETAIL : str = "{e} - bias {b} = {u}";
pub const SAY_EXP_SUBNORMAL : str = "0: subnormal, scale 2^{u}";
pub const SAY_EXP_SPECIAL : str = "{e}: all ones, infinity or NaN";
pub const SAY_MANT_DETAIL : str = "{m} / {one}";
pub const SAY_CLASS_LABEL : str = "class";
pub const SAY_CLASS_NAMES : [5]str = ["zero", "subnormal", "normal", "infinity", "NaN"];
pub const SAY_HEX_LABEL : str = "hex";
pub const SAY_INPUT_ECHO : str = "you typed";
pub const SAY_RAW_ECHO : str = "raw bits, decoded";
pub const SAY_DECODED : str = "decoded, exactly";
pub const SAY_ERROR : str = "error";
pub const SAY_REL_ERROR : str = "relative error";
pub const SAY_ROUNDED_LABEL : str = "rounding";
pub const SAY_ROUNDED_NAMES : [3]str = ["exact: no rounding", "rounded down in magnitude", "rounded up in magnitude"];
pub const SAY_TIE : str = "a tie, broken {rule}";
pub const SAY_OVERFLOW : str = "beyond the largest finite GF16 value: infinity";
pub const SAY_UNDERFLOW : str = "below half the smallest subnormal: zero";
pub const SAY_TERNARY_HEADING : str = "Balanced ternary";
pub const SAY_TERNARY_NOTE : str = "Base 3 with digits -1, 0, +1 and {f} trits after the point: a notation, not a GoldenFloat format.";
pub const SAY_TERNARY_VALUE : str = "these trits are";
pub const SAY_TRIT_COUNT : str = "{n} trits";
pub const SAY_TRIT_TITLE : str = "{d} x 3^{p}";
pub const SAY_TERNARY_TOO_WIDE : str = "More than {n} trits before the point; not drawn.";
pub const SAY_TERNARY_NONE : str = "Infinity and NaN have no ternary digits.";
pub const SAY_APPROX : str = "about";
pub const SAY_ROUNDTRIP_HEADING : str = "Round trip";
pub const SAY_RT_GF16 : str = "decoded value, encoded again: {hex}";
pub const SAY_RT_TERNARY : str = "trits read back, written again";
pub const SAY_SAME : str = "same";
pub const SAY_DIFFERENT : str = "different";
pub const SAY_CONFORMANCE : str = "{ok} of {n} vectors from gf16_conformance_v0.json encode bit-exact on this page; tie vectors {tok} of {tn}.";
pub const SAY_CONFORMANCE_FAIL : str = "Failed here: {names}.";
pub const SAY_LAYOUT_READ : str = "Layout read from {file}: S{s} E{e} M{m}, bias {b}.";
pub const SAY_LAYOUT_FALLBACK : str = "Could not read {file}; using this widget's spec: S{s} E{e} M{m}, bias {b}.";
pub const SAY_LAYOUT_MISMATCH : str = "{file} and this widget's spec disagree ({names}); the page uses {file}.";

test the_fields_fill_sixteen_bits {
    assert K_SIGN_BITS + K_EXP_BITS + K_MANT_BITS == K_BITS;
    assert K_BITS == 16;
    assert K_MANT_ONE == 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2;
}

test the_layout_is_format_spec_001_gf16 {
    assert K_EXP_BITS == 6;
    assert K_MANT_BITS == 9;
    assert K_BIAS == 31;
    assert K_EXP_MAX == 63;
    assert K_FORMAT_NAME == "GF16";
}

test the_bias_follows_the_closed_form_rule {
    assert K_EXP_MAX + 1 == 2 * 2 * 2 * 2 * 2 * 2;
    assert K_BIAS == (K_EXP_MAX + 1) / 2 - 1;
}

test the_conformance_bits_follow_from_the_layout {
    assert K_CHECK_NAMES[2] == "pos_one";
    assert K_CHECK_BITS[2] == K_BIAS * K_MANT_ONE;
    assert K_CHECK_BITS[3] == K_CHECK_BITS[2] + 32768;
    assert K_CHECK_NAMES[14] == "largest_normal";
    assert K_CHECK_BITS[14] == K_EXP_MAX * K_MANT_ONE - 1;
    assert K_CHECK_NAMES[15] == "overflow_to_inf";
    assert K_CHECK_BITS[15] == K_EXP_MAX * K_MANT_ONE;
    assert K_CHECK_BITS[16] == K_CHECK_BITS[15];
    assert K_CHECK_BITS[13] == K_MANT_ONE;
    assert K_CHECK_BITS[12] == K_MANT_ONE - 1;
    assert K_NAN_BITS == 32768 + K_EXP_MAX * K_MANT_ONE + 1;
}

test the_two_tie_rules_differ_only_on_an_odd_neighbour {
    assert K_TIE_BITS_EVEN[0] == K_TIE_BITS_ZERO[0];
    assert K_TIE_BITS_EVEN[1] == K_TIE_BITS_ZERO[1] + 1;
    assert K_ROUNDING_IDS[0] == K_DEFAULT_ROUNDING;
}

test the_widget_sends_nothing {
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == false;
    assert K_TERNARY_FRAC_TRITS < K_TERNARY_MAX_TRITS;
}
