// SPDX-License-Identifier: Apache-2.0
; specs/widgets/basics-where-next.t27 -- the infographic of lesson 27 of the t27 basics course (specs/course/t27-basics.t27)
; Source of truth for public/widgets/basics-where-next/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/basics/27_where_next.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_basics_where_next;

pub const KIND : str = "widget-tool";
pub const ID : str = "basics-where-next";
pub const TITLE : str = "t27 basics 27: three courses, in order";
pub const DESCRIPTION : str = "The three t27 courses in order, what each one covers and where it starts. Lesson 27 of the t27 basics course.";
pub const IMAGE_ALT : str = "A black and white diagram of three courses in a row: course 0, t27 basics; course 1, FPGA with t27; course 2, AI numbers with t27; each with 27 lessons and what it covers.";
pub const HOOK : str = "Three t27 courses of 27 lessons: basics, then an FPGA, then AI numbers.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/basics/27_where_next.t27, compiled clean on 7 backends by public/t27/t27_compiler.wasm, whose tests pass in the site test runner", "Compiler verdicts, error lines, code and counts quoted on this page are what the same wasm answered in node 22 when the course was authored; words without a run behind them are said to be read, not run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "The courses, in order";
pub const SAY_TABLE_HEAD : [3]str = ["Course", "Covers", "Lessons"];
pub const SAY_TABLE_CELLS : [9]str = ["0: t27 basics", "The language: specs, types, tests, backends", "27", "1: FPGA with t27", "A spec onto an Artix-7 board", "27", "2: AI numbers with t27", "Number formats and a ternary network", "27"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 3;
pub const K_TABLE_CELLS : u16 = 9;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "The order of the courses";
pub const SAY_FLOW_STEPS : [3]str = ["Course 0: t27 basics", "Course 1: FPGA", "Course 2: AI numbers"];
pub const K_FLOW_STEPS : u8 = 3;
pub const SAY_NOTE : str = "Every course is itself a t27 spec in specs/course/ on this site.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 3;
    assert K_FLOW_STEPS > 1;
}
