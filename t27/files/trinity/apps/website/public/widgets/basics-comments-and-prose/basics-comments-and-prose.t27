// SPDX-License-Identifier: Apache-2.0
; specs/widgets/basics-comments-and-prose.t27 -- the infographic of lesson 3 of the t27 basics course (specs/course/t27-basics.t27)
; Source of truth for public/widgets/basics-comments-and-prose/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/basics/03_comments_and_prose.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_basics_comments_and_prose;

pub const KIND : str = "widget-tool";
pub const ID : str = "basics-comments-and-prose";
pub const TITLE : str = "t27 basics 3: where comments may stand";
pub const DESCRIPTION : str = "Prose lines, slash comments and the lone semicolon that breaks a t27 spec, each checked with the real compiler. Lesson 3 of the t27 basics course.";
pub const IMAGE_ALT : str = "A black and white table of four notes in a t27 spec: a prose line with words, a slash comment, a slash comment inside a test, and a lone semicolon line; the last one gets a parse error from the compiler.";
pub const HOOK : str = "A lone semicolon line looks like an empty comment in t27. The compiler calls it a parse error.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/basics/03_comments_and_prose.t27, compiled clean on 7 backends by public/t27/t27_compiler.wasm, whose tests pass in the site test runner", "Compiler verdicts, error lines, code and counts quoted on this page are what the same wasm answered in node 22 when the course was authored; words without a run behind them are said to be read, not run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Notes in a spec, as the compiler answered";
pub const SAY_TABLE_HEAD : [3]str = ["Note", "Where", "Compiler"];
pub const SAY_TABLE_CELLS : [12]str = ["; words", "Top level", "Compiles on all 7 backends", "// words", "After code", "Compiles on all 7 backends", "// words", "Inside a test", "Compiles on all 7 backends", ";", "Alone on a line", "Error: parse error at module level near line 2: Unexpected token in expression: Semicolon (';') at line 2:1"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 4;
pub const K_TABLE_CELLS : u16 = 12;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_NOTE : str = "A semicolon alone on its line is read as an expression with nothing in it.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}
