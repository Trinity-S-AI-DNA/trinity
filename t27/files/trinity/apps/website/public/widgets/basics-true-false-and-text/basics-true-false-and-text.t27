// SPDX-License-Identifier: Apache-2.0
; specs/widgets/basics-true-false-and-text.t27 -- the infographic of lesson 6 of the t27 basics course (specs/course/t27-basics.t27)
; Source of truth for public/widgets/basics-true-false-and-text/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/basics/06_true_false_and_text.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_basics_true_false_and_text;

pub const KIND : str = "widget-tool";
pub const ID : str = "basics-true-false-and-text";
pub const TITLE : str = "t27 basics 6: bool and str";
pub const DESCRIPTION : str = "The two non-number types of t27 in one table, with what a test can do with them. Lesson 6 of the t27 basics course.";
pub const IMAGE_ALT : str = "A black and white table of two t27 types: bool with the values true and false, and str with text in double quotes, each with an example constant and the comparisons a test can make.";
pub const HOOK : str = "Inside double quotes, a semicolon is just text. Two types, one table.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/basics/06_true_false_and_text.t27, compiled clean on 7 backends by public/t27/t27_compiler.wasm, whose tests pass in the site test runner", "Compiler verdicts, error lines, code and counts quoted on this page are what the same wasm answered in node 22 when the course was authored; words without a run behind them are said to be read, not run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "bool and str";
pub const SAY_TABLE_HEAD : [4]str = ["Type", "Values", "Example", "Test with"];
pub const SAY_TABLE_CELLS : [8]str = ["bool", "true, false", "pub const READY : bool = true;", "== and !=", "str", "Text in double quotes", "pub const NAME : str = \"trit\";", "== and !="];
pub const K_TABLE_COLS : u8 = 4;
pub const K_TABLE_ROWS : u8 = 2;
pub const K_TABLE_CELLS : u16 = 8;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_NOTE : str = "Inside quotes a semicolon or two slashes are text, not a note.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}
