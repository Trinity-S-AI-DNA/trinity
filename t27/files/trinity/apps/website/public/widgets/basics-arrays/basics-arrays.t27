// SPDX-License-Identifier: Apache-2.0
; specs/widgets/basics-arrays.t27 -- the infographic of lesson 7 of the t27 basics course (specs/course/t27-basics.t27)
; Source of truth for public/widgets/basics-arrays/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/basics/07_arrays.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_basics_arrays;

pub const KIND : str = "widget-tool";
pub const ID : str = "basics-arrays";
pub const TITLE : str = "t27 basics 7: an array and its indexes";
pub const DESCRIPTION : str = "A t27 array drawn as a row of cells with their indexes, from the lesson spec. Lesson 7 of the t27 basics course.";
pub const IMAGE_ALT : str = "A black and white table of the array PRIMES of type [5]u8: index 0 holds 2, index 1 holds 3, index 2 holds 5, index 3 holds 7, index 4 holds 11.";
pub const HOOK : str = "Five items, last index 4. A t27 array as a row of cells.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/basics/07_arrays.t27, compiled clean on 7 backends by public/t27/t27_compiler.wasm, whose tests pass in the site test runner", "Compiler verdicts, error lines, code and counts quoted on this page are what the same wasm answered in node 22 when the course was authored; words without a run behind them are said to be read, not run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "pub const PRIMES : [5]u8 = [2, 3, 5, 7, 11];";
pub const SAY_TABLE_HEAD : [2]str = ["Index", "PRIMES[i]"];
pub const SAY_TABLE_CELLS : [10]str = ["0", "2", "1", "3", "2", "5", "3", "7", "4", "11"];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 5;
pub const K_TABLE_CELLS : u16 = 10;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_NOTE : str = "The length 5 is part of the type; the last index is one less.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}
