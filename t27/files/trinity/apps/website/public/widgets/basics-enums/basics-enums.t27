// SPDX-License-Identifier: Apache-2.0
; specs/widgets/basics-enums.t27 -- the infographic of lesson 18 of the t27 basics course (specs/course/t27-basics.t27)
; Source of truth for public/widgets/basics-enums/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/basics/18_enums.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_basics_enums;

pub const KIND : str = "widget-tool";
pub const ID : str = "basics-enums";
pub const TITLE : str = "t27 basics 18: two ways to write an enum";
pub const DESCRIPTION : str = "The two enum forms the t27 compiler accepts, side by side with their cases. Lesson 18 of the t27 basics course.";
pub const IMAGE_ALT : str = "A black and white table of two t27 enums from the lesson spec: Color with the cases Red, Green and Blue, and Mode, stored as u8, with the cases Idle and Run.";
pub const HOOK : str = "pub enum Color { Red, Green, Blue } or enum(u8): t27 takes both.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/basics/18_enums.t27, compiled clean on 7 backends by public/t27/t27_compiler.wasm, whose tests pass in the site test runner", "Compiler verdicts, error lines, code and counts quoted on this page are what the same wasm answered in node 22 when the course was authored; words without a run behind them are said to be read, not run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "The enums of the lesson spec";
pub const SAY_TABLE_HEAD : [3]str = ["Enum", "Form", "Cases"];
pub const SAY_TABLE_CELLS : [6]str = ["Color", "pub enum Color { }", "Red, Green, Blue", "Mode", "pub const Mode = enum(u8) { };", "Idle, Run"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 2;
pub const K_TABLE_CELLS : u16 = 6;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_NOTE : str = "Backends that compiled the lesson spec: 7 of 7.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}
