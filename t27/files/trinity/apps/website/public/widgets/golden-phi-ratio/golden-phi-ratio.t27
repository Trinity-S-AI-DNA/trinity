// SPDX-License-Identifier: Apache-2.0
; specs/widgets/golden-phi-ratio.t27 -- the infographic of lesson 2 of the GoldenFloat course (specs/course/goldenfloat.t27)
; Source of truth for public/widgets/golden-phi-ratio/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/numeric/phi_ratio.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_golden_phi_ratio;

pub const KIND : str = "widget-tool";
pub const ID : str = "golden-phi-ratio";
pub const TITLE : str = "GoldenFloat 2: phi as a ratio";
pub const DESCRIPTION : str = "Seven widths split by one rule, and how far each sits from 1 / phi, read from phi_ratio.t27. Lesson 2 of the GoldenFloat course.";
pub const IMAGE_ALT : str = "A black and white table, Seven widths in verify_phi_split, distance from 1 / phi = 0.618: GF4, 1 and 2, 0.118; GF8, 3 and 4, 0.132; GF12, 4 and 7, 0.047; GF16, 6 and 9, 0.049; GF20, 7 and 12, 0.035; GF24, 9 and 14, 0.025; GF32, 12 and 19, 0.014.";
pub const HOOK : str = "Seven widths, one rule, all seven match the family; the distance does not fall at every step.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/numeric/phi_ratio.t27, read when the course was authored; every number in the table is a constant, a test value or arithmetic of that file", "Nothing on this page was measured on hardware or timed; a value written into a test is said to be written in, not computed"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Seven widths in verify_phi_split, distance from 1 / phi = 0.618";
pub const SAY_TABLE_HEAD : [3]str = ["Format", "E and M", "Distance"];
pub const SAY_TABLE_CELLS : [21]str = ["GF4", "1 and 2", "0.118", "GF8", "3 and 4", "0.132", "GF12", "4 and 7", "0.047", "GF16", "6 and 9", "0.049", "GF20", "7 and 12", "0.035", "GF24", "9 and 14", "0.025", "GF32", "12 and 19", "0.014"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 7;
pub const K_TABLE_CELLS : u16 = 21;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "How phi_split picks a split";
pub const SAY_FLOW_STEPS : [3]str = ["N bits, 1 for the sign", "E = round((N - 1) / phi^2)", "M = N - 1 - E"];
pub const K_FLOW_STEPS : u8 = 3;
pub const SAY_NOTE : str = "E and M come from verify_phi_split in phi_ratio.t27; each distance is |E / M - 1 / phi|, arithmetic of those two numbers.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 3;
    assert K_FLOW_STEPS > 1;
}
