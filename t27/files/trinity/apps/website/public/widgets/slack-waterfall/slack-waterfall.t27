// SPDX-License-Identifier: Apache-2.0
; specs/widgets/slack-waterfall.t27 -- every timing path of a routed design, worst first
; Source of truth for public/widgets/slack-waterfall/ (gHashTag/trinity, apps/website). The page
; is written by scripts/widget-pages-from-spec.mjs from this file and hands every constant below
; to tool.js as window.T27_WIDGET. tool.js holds no English of its own: every word on screen is a
; SAY_ constant here, every number the tool relies on is a K_ constant.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: one row per timing endpoint, sorted by slack, worst at the top. Each row is the
; worst path into that endpoint drawn as a waterfall of its segments -- clock-to-Q, logic through
; each LUT or carry, routing on each net, setup -- against the clock period; failing paths are
; red. Tap a row for the path cell by cell. Drop a nextpnr --report JSON and it draws that
; report's critical_paths (the mainline nextpnr schema: path segments of type clk-to-q, source,
; logic, routing, setup with delays in ns), or a timing.json written by fpga-pnr.py for your own
; run. The file is read in the browser with FileReader and sent nowhere.

; DATA PROVENANCE: timing.json is written by scripts/widget-data/fpga-pnr.py from one real run
; made on 2026-10-04: trinity_v3_jtaguart.v from gHashTag/trinity-fpga de4ebda367, yosys
; 0.67+post b8e7da6f40, nextpnr-xilinx 0.9.2-107-g7037c948 on the xc7a200tfbg676-1 chipdb with
; --freq 50 --seed 1. The board's XDC declares its 50 MHz clock on the pad, but this nextpnr
; does not carry it through the IBUF and BUFGCTRL to the clock net, so without --freq the run is
; checked at its 12 MHz default; --freq 50 restates the board's 50 MHz. This nextpnr-xilinx build
; writes --report with critical_paths always empty (only fmax and utilization), so fpga-pnr.py
; walks the run's own SDF (--sdf: INTERCONNECT and IOPATH delays, SETUPHOLD setup) the way
; nextpnr's common/timing.cc walks the netlist, and then checks itself against nextpnr's log: the
; worst endpoint, its 4.8 ns total and every net on its path must equal the critical path the log
; prints, and the slack histogram rebuilt with nextpnr's binning must equal the log's, all 20
; bins. If any check fails the script writes nothing. Results: 159 endpoints, worst path 4767 ps
; (2245 logic, 2522 routing), worst slack 15233 ps at 50 MHz, nextpnr fmax 209.78 MHz.

; WHAT IT DOES NOT CLAIM: that the design was measured at speed on a board; these are nextpnr's
; delay models. Hold time, clock skew and IO timing are not analysed: nextpnr-xilinx treats the
; IO buffers of this flow as untimed, so pads start and end no path here. Only the worst path
; into each endpoint is drawn, not every path. A mainline report lists one critical path per
; clock pair, so a dropped report shows those, not every endpoint.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_slack_waterfall;

pub const KIND : str = "widget-tool";
pub const ID : str = "slack-waterfall";
pub const TITLE : str = "Slack waterfall: every timing path of a routed design, worst first";
pub const DESCRIPTION : str = "159 endpoints of a real nextpnr-xilinx run at 50 MHz as logic and routing waterfalls, checked bin by bin against nextpnr's log. Drop a --report JSON for yours.";
pub const IMAGE_ALT : str = "A waterfall on black: 159 rows, one per timing endpoint, sorted worst first, each a strip of gold logic and green routing segments ending well before a red 20 ns period line, the spare time shaded dark green. Headline: worst slack +15.233 ns, fmax 209.78 MHz.";
pub const HOOK : str = "Where do 4.8 ns go in a 20 ns clock? Every path of a real Artix-7 run, segment by segment, worst first; drop your report for yours.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [5]str = ["gHashTag/trinity-fpga de4ebda367: fpga/openxc7-synth/trinity_v3_jtaguart.v and jtaguart.xdc", "nextpnr-xilinx 0.9.2-107-g7037c948 --chipdb xc7a200tfbg676-1.bin --freq 50 --seed 1: routed.sdf, report.json (fmax) and the log's critical path and slack histogram", "scripts/widget-data/fpga-pnr.py: per-endpoint paths from the SDF, checked against the log, written to timing.json", "nextpnr common/timing.cc and xilinx/arch.cc (nextpnr-xilinx 0.9.2-107-g7037c948): the arrival, setup and port-class rules followed", "A nextpnr --report JSON or a fpga-pnr.py timing.json the reader drops or picks: read in the browser with FileReader, never uploaded"];
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- Numbers the tool relies on ------------------------------------------------------------
pub const K_DATA_FILE : str = "timing.json";
pub const K_SCHEMA : str = "slack-waterfall/1";
; Segment types and their colours; mainline nextpnr uses the same type names.
pub const K_SEG_TYPES : [6]str = ["clk-to-q", "source", "logic", "routing", "setup", "input"];
pub const K_SEG_COLORS : [6]str = ["#ffd700", "#ffd700", "#ffd700", "#00ff88", "#c8c8c8", "#ffd700"];
pub const K_SLACK_COLOR : str = "#002e1c";
pub const K_FAIL_COLOR : str = "#ff4d6d";
pub const K_PS_PER_NS : u16 = 1000;
; Row height of the waterfall in CSS pixels, before it is squeezed to fit, and the floor.
pub const K_ROW_PX : u8 = 7;
pub const K_MIN_ROW_PX : u8 = 2;
pub const K_MAX_CANVAS_PX : u16 = 560;
pub const K_MIN_TARGET_PX : u8 = 32;
pub const K_MAX_FILE_MB : u16 = 256;
; The demo, as fpga-pnr.py measured it; the tool refuses a demo file that disagrees.
pub const K_DEMO_FREQ_MHZ : u8 = 50;
pub const K_DEMO_PERIOD_PS : u32 = 20000;
pub const K_DEMO_ENDPOINTS : u16 = 159;
pub const K_DEMO_WORST_TOTAL_PS : u32 = 4767;
pub const K_DEMO_WORST_LOGIC_PS : u32 = 2245;
pub const K_DEMO_WORST_ROUTING_PS : u32 = 2522;
pub const K_DEMO_WORST_SLACK_PS : u32 = 15233;

; --- Words on screen ------------------------------------------------------------------------
; Templates take {0}, {1}, ... in order.
pub const SAY_FULL_PERIOD : str = "Full period";
pub const SAY_FIT_PATHS : str = "Fit paths";
pub const SAY_WORSE : str = "Worse";
pub const SAY_BETTER : str = "Better";
pub const SAY_DEMO : str = "Demo design";
pub const SAY_SUMMARY : str = "{0}: {1} paths, worst slack {2} ns at {3} MHz";
pub const SAY_SUMMARY_NO_PERIOD : str = "{0}: {1} paths, worst total {2} ns, no clock constraint in the file";
pub const SAY_FMAX_HEAD : [4]str = ["clock", "fmax MHz", "target MHz", ""];
pub const SAY_PASS : str = "PASS";
pub const SAY_FAIL : str = "FAIL";
pub const SAY_CHECK_LINE : str = "Checked against nextpnr's log: worst path {0} ns ending at {1} (SDF walk: {2} ps), {3} of {4} histogram bins equal.";
pub const SAY_NO_PATHS : str = "{0} has no critical_paths: this nextpnr-xilinx build writes fmax only. Run scripts/widget-data/fpga-pnr.py on its --sdf and log for every path.";
pub const SAY_CANVAS_LABEL : str = "Waterfall of timing paths, worst slack at the top: gold is logic, green is routing, grey is setup, dark green is slack, the red line is the clock period. Tap a row for its path.";
pub const SAY_HINT : str = "tap or click a row: its path / arrow keys: step";
pub const SAY_AXIS : str = "{0} ns";
pub const SAY_PATH_TITLE : str = "Path {0} of {1}: {2}";
pub const SAY_PATH_LINE : str = "total {0} ns = {1} logic + {2} routing; slack {3} ns";
pub const SAY_PATH_LINE_NO_PERIOD : str = "total {0} ns = {1} logic + {2} routing";
pub const SAY_SEG_HEAD : [5]str = ["type", "ns", "from", "to", "net"];
pub const SAY_LEGEND : [5]str = ["logic", "routing", "setup", "slack", "period"];
pub const SAY_DROP : str = "Drop a nextpnr --report JSON or a fpga-pnr.py timing.json here, or tap to pick one. It is read in this browser and sent nowhere.";
pub const SAY_LOADING : str = "Loading the paths...";
pub const SAY_READING : str = "Reading {0}...";
pub const SAY_ERR_JSON : str = "{0} is not JSON.";
pub const SAY_ERR_SHAPE : str = "{0} is neither a nextpnr report (critical_paths, fmax) nor a timing.json.";
pub const SAY_ERR_SIZE : str = "{0} is larger than {1} MB.";
pub const SAY_ERR_DEMO : str = "The demo paths did not load.";
pub const SAY_ERR_DEMO_DIFF : str = "The demo file disagrees with this page's spec; not drawn.";
pub const SAY_COMMANDS : str = "How this was made";

; --- Tests ----------------------------------------------------------------------------------
test the_period_is_the_inverse_of_the_frequency {
    assert K_DEMO_PERIOD_PS * K_DEMO_FREQ_MHZ == 1000000;
    assert K_PS_PER_NS == 1000;
}

test the_worst_path_adds_up {
    assert K_DEMO_WORST_LOGIC_PS + K_DEMO_WORST_ROUTING_PS == K_DEMO_WORST_TOTAL_PS;
    assert K_DEMO_WORST_TOTAL_PS + K_DEMO_WORST_SLACK_PS == K_DEMO_PERIOD_PS;
    assert K_DEMO_WORST_TOTAL_PS < K_DEMO_PERIOD_PS;
}

test the_worst_path_rounds_to_nextpnr_log_figures {
    assert 48 == (K_DEMO_WORST_TOTAL_PS + 50) / 100;
    assert 22 == (K_DEMO_WORST_LOGIC_PS + 50) / 100;
    assert 25 == (K_DEMO_WORST_ROUTING_PS + 50) / 100;
}

test every_segment_type_has_a_colour {
    assert K_SEG_TYPES[3] == "routing";
    assert K_SEG_COLORS[3] == "#00ff88";
    assert K_SEG_TYPES[4] == "setup";
}

test the_page_reads_files_and_sends_nothing {
    assert READS_LOCAL_FILES == true;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
}
