; The card.
pub const SAY_CARD_BRAND : str = "TRINITY S3AI  /  LUT TREEMAP";
pub const SAY_CARD_TITLE : str = "Which submodule eats my LUTs?";
pub const SAY_CARD_KIND : str = "yosys synth, not place and route";
pub const SAY_CARD_ROW : str = "{0} x {1} LUT = {2}  ({3})";
