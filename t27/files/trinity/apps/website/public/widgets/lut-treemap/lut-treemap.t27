// SPDX-License-Identifier: Apache-2.0
; specs/widgets/lut-treemap.t27 -- which submodule eats my LUTs: a treemap from yosys `stat -json`
; Source of truth for public/widgets/lut-treemap/ (gHashTag/trinity, apps/website). The page is
; written by scripts/widget-pages-from-spec.mjs from this file; tool.js holds no English of its
; own and reads every word below from window.T27_WIDGET.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader drops the JSON that yosys `stat -json` wrote for a design that was NOT
; flattened. In that JSON every module lists its own cells by type and, under the same map, how
; many instances of each submodule it holds. public/widgets/lut-treemap/treemap.js multiplies down
; the hierarchy: a module's instance count is the sum, over every path from the top, of the
; product of the counts on that path; its share is instances x its own cells. The page draws one
; tile per instance (or one tile marked xN when there are too many), sized by LUTs, FFs, DSPs or
; BRAMs, with a table of every module: instances, cells of one, total, share. It checks that the
; tiles add up to the top's total and to the total yosys printed itself. A second, optional drop
; takes the stat of a flattened run of the same design and shows both totals side by side. Files
; are read in the browser and never leave the page; nothing is sent.

; THE SAMPLE: gf16_matmul4x4_p, a pipelined 4x4 matrix multiplier over GF16 (16 gf16_dot4_p, each
; 3 gf16_add and 4 gf16_mul). Two of its files are in gHashTag/trinity, fpga/gf16-pipelined/, and
; the combinational gf16_add and gf16_mul with ports a, b, result are in gHashTag/t27,
; fpga/vivado/. scripts/widget-data/lut-treemap.mjs reads the four files out of git at the commits
; named below, copies them to a scratch directory and runs Yosys 0.67+post twice: synth_xilinx
; -top gf16_matmul4x4_p, and the same with -flatten, each followed by `tee -q -o <file> stat
; -json`. Both outputs are shipped byte for byte; sample.json holds the commands, the `yosys -V`
; line, exit codes, seconds and the sha256 of every input. Every K_SAMPLE_ fact below is re-read
; from those files by `node scripts/widget-data/lut-treemap.mjs --check`, which also runs this
; spec's tests on the values it read and a negative control that must fail them.

; WHAT IT DOES NOT CLAIM: these are synthesis cell counts, not post-place-and-route utilisation.
; A hierarchical run keeps module boundaries, so yosys cannot optimise across them: the sample's
; flattened run comes out at 18730 LUT against 20464 hierarchical. The per-module split is true of
; the hierarchical build only, and the page says so whenever both totals are shown. stat -json
; names no instances, so the copies of a module are numbered in counting order, not by instance
; name. The cell lists are 7-series names (synth_xilinx, the default family); other cells are
; counted under "other" and are not drawn.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_lut_treemap;

pub const KIND : str = "widget-tool";
pub const ID : str = "lut-treemap";
pub const TITLE : str = "LUT treemap: which submodule eats your LUTs, from yosys stat -json";
pub const DESCRIPTION : str = "Drop yosys stat -json from a run without -flatten: a treemap of LUTs or FFs per submodule, each times its instance count, beside the flattened total. Read in your browser.";
pub const IMAGE_ALT : str = "A treemap on black of a real yosys 0.67 synth_xilinx run of gf16_matmul4x4_p, a 4x4 GF16 matrix multiplier: 16 gf16_dot4_p boxes holding 112 tiles, one per instance. 48 gf16_add of 293 LUT make 14064 LUT (68.7 percent), 64 gf16_mul of 100 LUT make 6400 (31.3 percent): 20464 in all. Flattened, the same design is 18730 LUT (-8.5 percent).";
pub const HOOK : str = "48 copies of a 293-LUT adder eat 69% of this matrix multiplier. Drop your yosys stat -json and see which submodule eats your LUTs.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [6]str = ["Yosys 0.67+post (git sha1 b8e7da6f40ae8f552c116bf6c359b07c6533e159), run by scripts/widget-data/lut-treemap.mjs in a scratch directory: nice -n 10 yosys -q -p \"read_verilog gf16_add.v gf16_mul.v gf16_dot4_p.v gf16_matmul4x4_p.v; synth_xilinx -top gf16_matmul4x4_p; tee -q -o stat.json stat -json\"", "the same command with synth_xilinx -flatten -top gf16_matmul4x4_p, written to flat.stat.json, for the flattened total", "gHashTag/trinity fpga/gf16-pipelined/gf16_dot4_p.v and gf16_matmul4x4_p.v at commit df6cb3e0f654; gHashTag/t27 fpga/vivado/gf16_add.v and gf16_mul.v at commit ea15cd54c8c9; read with git show, sha256 of each in sample.json", "public/widgets/lut-treemap/sample.stat.json and sample.flat.stat.json: the yosys output, byte for byte; sample.json: commands, yosys -V line, exit codes, seconds, input and output sha256", "public/widgets/lut-treemap/treemap.js: the one parser, instance multiplier and treemap layout, run in node for the sample and in the browser for your file; card.png is drawn from sample.json by scripts/widget-data/lut-treemap-card.py", "node scripts/widget-data/lut-treemap.mjs --check: re-reads both stat files and fails if any K_SAMPLE_ fact in this spec disagrees; scripts/widget-data/lut-treemap-paramod.v is the parser fixture for $paramod names"];
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- Which cell type is which (7-series names, as synth_xilinx writes them) ---------------------
pub const K_LUT_TYPES : [6]str = ["LUT1", "LUT2", "LUT3", "LUT4", "LUT5", "LUT6"];
pub const K_FF_TYPES : [4]str = ["FDRE", "FDSE", "FDCE", "FDPE"];
pub const K_DSP_TYPES : [1]str = ["DSP48E1"];
pub const K_BRAM_TYPES : [2]str = ["RAMB18E1", "RAMB36E1"];
; yosys bookkeeping that is no hardware: counted in no group.
pub const K_INTERNAL_TYPES : [1]str = ["$scopeinfo"];

; --- The sample (scripts/widget-data/lut-treemap.mjs re-reads every K_SAMPLE_ fact) -------------
pub const K_SAMPLE_JSON : str = "sample.json";
pub const K_SAMPLE_STAT : str = "sample.stat.json";
pub const K_SAMPLE_FLAT_STAT : str = "sample.flat.stat.json";
pub const K_SAMPLE_TRINITY_COMMIT : str = "df6cb3e0f6540a153fa4e55f591c59b7813f2270";
pub const K_SAMPLE_TRINITY_FILES : [2]str = ["fpga/gf16-pipelined/gf16_dot4_p.v", "fpga/gf16-pipelined/gf16_matmul4x4_p.v"];
pub const K_SAMPLE_T27_COMMIT : str = "ea15cd54c8c92bc84411d2d1ae20904e143ff0ea";
pub const K_SAMPLE_T27_FILES : [2]str = ["fpga/vivado/gf16_add.v", "fpga/vivado/gf16_mul.v"];
; read_verilog takes them in this order: leaves first.
pub const K_SAMPLE_READ_ORDER : [4]str = ["gf16_add.v", "gf16_mul.v", "gf16_dot4_p.v", "gf16_matmul4x4_p.v"];
pub const K_SAMPLE_TOP : str = "gf16_matmul4x4_p";
pub const K_SAMPLE_YOSYS : str = "0.67+post";
; Every module, in the order yosys printed them; how many instances sit under one top; the cells
; of ONE instance, its own only (submodules not included).
pub const K_SAMPLE_MODULES : [4]str = ["gf16_add", "gf16_dot4_p", "gf16_matmul4x4_p", "gf16_mul"];
pub const K_SAMPLE_INST : [4]u16 = [48, 16, 1, 64];
pub const K_SAMPLE_EACH_LUT : [4]u16 = [293, 0, 0, 100];
pub const K_SAMPLE_EACH_FF : [4]u16 = [0, 112, 0, 0];
pub const K_SAMPLE_EACH_DSP : [4]u16 = [0, 0, 0, 1];
; Every "parent holds N of child" entry, as yosys listed them.
pub const K_SAMPLE_EDGE_PARENT : [3]str = ["gf16_dot4_p", "gf16_dot4_p", "gf16_matmul4x4_p"];
pub const K_SAMPLE_EDGE_CHILD : [3]str = ["gf16_add", "gf16_mul", "gf16_dot4_p"];
pub const K_SAMPLE_EDGE_COUNT : [3]u16 = [3, 4, 16];
; The top, submodules expanded, as treemap.js adds it up; and what yosys printed under "design".
pub const K_SAMPLE_TOTAL_LUT : u16 = 20464;
pub const K_SAMPLE_TOTAL_FF : u16 = 1792;
pub const K_SAMPLE_TOTAL_DSP : u16 = 64;
pub const K_SAMPLE_DESIGN_LUT : u16 = 20464;
pub const K_SAMPLE_DESIGN_FF : u16 = 1792;
pub const K_SAMPLE_DESIGN_DSP : u16 = 64;
; The flattened run of the same four files.
pub const K_SAMPLE_FLAT_LUT : u16 = 18730;
pub const K_SAMPLE_FLAT_FF : u16 = 1792;
pub const K_SAMPLE_FLAT_DSP : u16 = 64;
; Tiles the LUT treemap draws for the sample (one per instance holding LUTs).
pub const K_SAMPLE_LUT_TILES : u16 = 112;

; --- How it draws -------------------------------------------------------------------------------
pub const K_CARD_W : u16 = 1200;
pub const K_CARD_H : u16 = 630;
pub const K_MIN_TARGET_PX : u8 = 32;
; A pasted or dropped text over this many characters is not read.
pub const K_MAX_PASTE_CHARS : u32 = 8000000;
; Instances of one submodule are drawn one tile each up to this count; more share one tile "xN".
pub const K_EXPAND_MAX : u16 = 64;
; No more tiles than this in one treemap; past it, instances share tiles.
pub const K_MAX_TILES : u16 = 600;
; A tile gets a text label only when it is at least this wide and tall, in CSS pixels.
pub const K_LABEL_MIN_W : u8 = 46;
pub const K_LABEL_MIN_H : u8 = 18;
; Height of a module's name strip, and the inset around its children, in CSS pixels.
pub const K_HEAD_PX : u8 = 16;
pub const K_PAD_PX : u8 = 2;
; Hues (degrees) given to modules in the order yosys printed them, round robin; tiles keep their
; colour when the metric changes.
pub const K_TILE_HUES : [8]u16 = [152, 46, 200, 340, 268, 20, 96, 184];

