// SPDX-License-Identifier: Apache-2.0
; specs/widgets/basics-tri-commands.t27 -- the infographic of lesson 24 of the t27 basics course (specs/course/t27-basics.t27)
; Source of truth for public/widgets/basics-tri-commands/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/basics/24_tri_commands.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_basics_tri_commands;

pub const KIND : str = "widget-tool";
pub const ID : str = "basics-tri-commands";
pub const TITLE : str = "t27 basics 24: where a tri command goes";
pub const DESCRIPTION : str = "Which tri commands run inside the script and which are handed to t27c, read from scripts/tri in gHashTag/t27. Lesson 24 of the t27 basics course.";
pub const IMAGE_ALT : str = "A black and white table of tri commands from scripts/tri in gHashTag/t27: tri test runs t27c suite, words such as gen and seal go to t27c, and audit, recall, frontier, lesson and help are handled by tri itself.";
pub const HOOK : str = "tri test runs the t27 suite; any word tri does not know goes to t27c. One table.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/basics/24_tri_commands.t27, compiled clean on 7 backends by public/t27/t27_compiler.wasm, whose tests pass in the site test runner", "Compiler verdicts, error lines, code and counts quoted on this page are what the same wasm answered in node 22 when the course was authored; words without a run behind them are said to be read, not run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "tri commands, from scripts/tri";
pub const SAY_TABLE_HEAD : [2]str = ["Command", "Goes to"];
pub const SAY_TABLE_CELLS : [16]str = ["tri test", "t27c suite --repo-root .", "tri gen ...", "t27c gen ...", "tri seal ...", "t27c seal ...", "tri audit", "tri itself", "tri recall", "tri itself", "tri frontier", "tri itself", "tri lesson", "tri itself", "tri help", "tri itself"];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 8;
pub const K_TABLE_CELLS : u16 = 16;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "How tri reads a word";
pub const SAY_FLOW_STEPS : [4]str = ["tri <word>", "A word of its own: tri runs it", "test: t27c suite", "Any other word: t27c <word>"];
pub const K_FLOW_STEPS : u8 = 4;
pub const SAY_NOTE : str = "Read from scripts/tri in gHashTag/t27; the commands were not run for this page.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 4;
    assert K_FLOW_STEPS > 1;
}
