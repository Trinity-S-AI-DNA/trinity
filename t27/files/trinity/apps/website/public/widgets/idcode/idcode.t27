// SPDX-License-Identifier: Apache-2.0
; specs/widgets/idcode.t27 -- a JTAG IDCODE taken apart bit by bit, and named
; Source of truth for public/widgets/idcode/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English of its own: every
; word on screen is a SAY_ constant here, every number the tool relies on is a K_ constant.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader types or pastes a 32-bit IDCODE (or a whole openFPGALoader printout; the
; first hex word is taken). The page draws the 32 bits as buttons in the four IEEE 1149.1 fields --
; version [31:28], part number [27:12], manufacturer [11:1] and the fixed 1 in bit 0 -- splits the
; manufacturer into its JEP106 bank (continuation-code count plus one) and identity code, and then
; looks the code up the way openFPGALoader v1.1.1 does in src/jtag.cpp: the full IDCODE first, then
; with the version masked to 0. It shows the row it found (manufacturer, family, model, IR length),
; the lines `openFPGALoader --detect` would print for it, and a card the reader can save as a PNG.
; The URL hash keeps the code (#id=0x03636093), so a link reproduces the result.

; DATA PROVENANCE: parts.json is extracted by scripts/widget-data/idcode.mjs from openFPGALoader's
; src/part.hpp and src/board.hpp at tag v1.1.1 (commit 85be4fa02b2d), sha256-pinned; it is the
; whole fpga_list, misc_dev_list and list_manufacturer (about 16 KB), plus the part of nine boards.
; The bench numbers come from openFPGALoader 1.1.1 run on this project's own bench.

; WHAT THE BENCH SAID: on 2026-10-04 UTC one QMTech Wukong V1 was attached. With --verbose-level 2,
; openFPGALoader prints the raw word it shifted out: 0x13636093, version 1. Its --detect lines print
; idcode 0x3636093, because jtag.cpp stores the masked key it matched, not the raw word. So the
; 0x03636093 recorded for all three boards on 2026-08-17 (t27 fpga/HARDWARE_SSOT.md, W791) is the
; table key and the IDCODE our bitstreams carry; the raw word of the other two boards is not known
; to this page.

; WHAT IT DOES NOT CLAIM: a name for a manufacturer code outside openFPGALoader's nine-entry list
; (the page gives the bank and code to look up in JEDEC JEP106 instead), a device for a code outside
; its table, or anything about a device beyond its table row. The table has its own slips, shown as
; they are: one row's manufacturer bits do not say Xilinx (0x04ac4033), keys listed twice keep only
; the first row, and the zynqmp_cfgn rows end in a 0 bit, which IEEE 1149.1 does not allow.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_idcode;

pub const KIND : str = "widget-tool";
pub const ID : str = "idcode";
pub const TITLE : str = "JTAG IDCODE decoder: 32 bits, four fields, one device";
pub const DESCRIPTION : str = "Paste a 32-bit JTAG IDCODE: version, part number, JEDEC manufacturer and the fixed 1 in bit 0 as clickable bits, then the device from openFPGALoader's own table.";
pub const IMAGE_ALT : str = "IDCODE card for 0x03636093: 32 bits in four coloured fields, version 0x0, part number 0x3636, manufacturer 0x049 (JEP106 bank 1, code 0x49, Xilinx) and bit 0 set to 1, found in openFPGALoader v1.1.1 as xc7a200, artix a7 200t, IR length 6. Our Wukong board reads 0x13636093 raw: version 1, same part.";
pub const HOOK : str = "Paste your board's IDCODE, get its bit fields and its device as a link: #id=0x03636093 is the Artix-7 200T on our bench.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [7]str = ["openFPGALoader v1.1.1, github.com/trabucayre/openFPGALoader commit 85be4fa02b2dd6a83716d7dfac3d25bbd260ff7b, Apache-2.0, Copyright (C) 2019 Gwenhael Goavec-Merou: src/part.hpp (sha256 74ded91a5ef62d1f) fpga_list, misc_dev_list, list_manufacturer", "openFPGALoader v1.1.1 src/board.hpp (sha256 0c955d02921affa5): the FPGA part of each preset board", "openFPGALoader v1.1.1 src/jtag.cpp detectChain and src/main.cpp --detect: the lookup order (full IDCODE, then masked with 0x0fffffff) and the printed lines", "Bench 2026-10-04 UTC: openFPGALoader 1.1.1 -c digilent_hs2 --detect --verbose-level 2 on one QMTech Wukong V1 (XC7A200T): raw IDCODE 0x13636093, printed idcode 0x3636093", "t27 fpga/HARDWARE_SSOT.md, W791 2026-08-17: openFPGALoader 1.1.1 --detect on all three Wukong boards (--busdev-num 1:4, 1:6, 1:8) printed idcode 0x3636093, artix a7 200t, xc7a200", "IEEE Std 1149.1 device identification register: version [31:28], part number [27:12], manufacturer identity [11:1] per JEDEC JEP106, bit 0 always 1", "scripts/widget-data/idcode.mjs: writes public/widgets/idcode/parts.json from the pinned files and checks this spec's K_ numbers against the table and the bench record"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- Numbers the tool relies on ------------------------------------------------------------
pub const K_DATA_FILE : str = "./parts.json";
pub const K_HASH_KEY : str = "id";
; The four fields, most significant first: version, part number, manufacturer, fixed 1.
pub const K_FIELD_LSB : [4]u8 = [28, 12, 1, 0];
pub const K_FIELD_WIDTH : [4]u8 = [4, 16, 11, 1];
; Inside the 11-bit manufacturer field: the low 7 bits are the JEP106 identity code, the high 4
; the number of 0x7F continuation codes before it (bank = that count + 1).
pub const K_MFR_CODE_BITS : u8 = 7;
; openFPGALoader's second lookup: the IDCODE with the version nibble cleared (0x0fffffff).
pub const K_VERSION_MASK : u32 = 268435455;
; 0x03636093, the fpga_list key for xc7a200 (artix a7 200t, IR length 6), and the IDCODE in the
; header of every bitstream we build for the XC7A200T.
pub const K_TABLE_IDCODE : u32 = 56844435;
pub const K_TABLE_PART : u16 = 13878;
pub const K_XILINX_MFR : u16 = 73;
pub const K_XC7A200T_IR_LENGTH : u8 = 6;
; 0x13636093, the raw word one Wukong board shifted out on 2026-10-04 UTC.
pub const K_BENCH_RAW_IDCODE : u32 = 325279891;
pub const K_BENCH_BOARDS_2026_08_17 : u8 = 3;
; What openFPGALoader treats specially: all zeros (TDO stuck low) and all ones (end of chain).
pub const K_STUCK_LOW : u32 = 0;
pub const K_END_OF_CHAIN : u32 = 4294967295;
; The PNG the reader can save.
pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Words on screen ------------------------------------------------------------------------
; Templates take {0}, {1}, ... in order.
pub const SAY_LOADING : str = "Reading openFPGALoader's device table";
pub const SAY_LOAD_FAILED : str = "The device table did not load; the bit fields still work.";
pub const SAY_INPUT_LABEL : str = "IDCODE";
pub const SAY_INPUT_PLACEHOLDER : str = "0x03636093, or paste openFPGALoader output";
pub const SAY_BAD_INPUT : str = "No IDCODE here: type up to eight hex digits, like 0x03636093.";
pub const SAY_PRESETS_LABEL : str = "Try one";
pub const SAY_BENCH_PRESET : str = "our bench, raw";
pub const SAY_TABLE_PRESET : str = "our bench, as printed";
pub const SAY_PRESET_TITLE : str = "openFPGALoader board {0}: part {1}";
pub const SAY_BITS_LABEL : str = "Bits 31 to 0. Click a bit to flip it.";
pub const SAY_BIT_TITLE : str = "bit {0}: {1}";
pub const SAY_FIELD_NAMES : [4]str = ["version", "part number", "manufacturer", "fixed 1"];
pub const SAY_FIELD_BITS : [4]str = ["[31:28]", "[27:12]", "[11:1]", "[0]"];
pub const SAY_COL_HEAD : [4]str = ["field", "bits", "hex", "decimal"];
pub const SAY_BANK_LINE : str = "JEP106 bank {0} ({1} continuation codes), identity code {2}";
pub const SAY_MFR_KNOWN : str = "{0} in openFPGALoader's manufacturer list";
pub const SAY_MFR_UNKNOWN : str = "not in openFPGALoader's manufacturer list: look up bank {0}, code {1} in JEDEC JEP106";
pub const SAY_BIT0_OK : str = "Bit 0 is 1, as IEEE 1149.1 requires of every IDCODE.";
pub const SAY_BIT0_BAD : str = "Bit 0 is 0: not an IDCODE. A TAP in BYPASS shifts out a 0 first, so a word read one bit late looks like this. Shifted right by one bit it reads {0}.";
pub const SAY_STUCK_LOW : str = "All zeros: openFPGALoader stops here with 'TDO is stuck at 0'.";
pub const SAY_END_OF_CHAIN : str = "All ones: what TDI looks like after the last device; openFPGALoader reads it as the end of the chain.";
pub const SAY_DEVICE_TITLE : str = "Device";
pub const SAY_MATCH_EXACT : str = "In openFPGALoader v1.1.1's table as written.";
pub const SAY_MATCH_MASKED : str = "In openFPGALoader v1.1.1's table after the version is masked to 0, as openFPGALoader does: key {0}.";
pub const SAY_MATCH_MISC : str = "Not an FPGA: a TAP openFPGALoader knows and steps over.";
pub const SAY_MATCH_NONE : str = "Not in openFPGALoader v1.1.1's table, with or without the version.";
pub const SAY_DEVICE_FIELDS : [5]str = ["manufacturer", "family", "model", "IR length", "table key"];
pub const SAY_MISC_FIELDS : [3]str = ["type", "IR length", "table key"];
pub const SAY_SHADOWED : str = "part.hpp also lists {0} under this key; its std::map keeps only the first row.";
pub const SAY_MFR_MISMATCH : str = "The row says {0}, but its manufacturer bits say {1}.";
pub const SAY_DETECT_TITLE : str = "What openFPGALoader --detect prints";
pub const SAY_DETECT_FPGA : [5]str = ["idcode 0x{0}", "manufacturer {0}", "family {0}", "model  {0}", "irlength {0}"];
pub const SAY_DETECT_MISC : [3]str = ["idcode   0x{0}", "type     {0}", "irlength {0}"];
pub const SAY_DETECT_NONE : str = "Unknown device with IDCODE: 0x{0} (manufacturer: 0x{1} ({2}), part: 0x{3} vers: 0x{4}";
pub const SAY_DETECT_NOTE : str = "--detect prints the key it matched, so a masked version does not show. --verbose-level 2 prints the raw word.";
pub const SAY_BENCH_TITLE : str = "Our bench";
pub const SAY_BENCH_LINE : str = "{0}: one QMTech Wukong V1 shifted out {1} (version {2}); openFPGALoader {3} --detect printed {4}.";
pub const SAY_BENCH_EARLIER : str = "On 2026-08-17 all {0} Wukong boards printed idcode 0x3636093 (t27 fpga/HARDWARE_SSOT.md). That line hides the version, so only this board's raw word is known.";
pub const SAY_COPY_LINK : str = "Copy link";
pub const SAY_COPIED : str = "Link copied";
pub const SAY_COPY_FAILED : str = "Copy it from the address bar";
pub const SAY_SAVE_CARD : str = "Save card PNG";
pub const SAY_CARD_TITLE : str = "JTAG IDCODE";
pub const SAY_CARD_BRAND : str = "Trinity S3AI";
pub const SAY_CARD_URL : str = "t27.ai/widgets/idcode/#id={0}";
pub const SAY_CARD_NONE : str = "not in openFPGALoader's table";
pub const SAY_CREDIT : str = "Device table: openFPGALoader {0}, commit {1}, Apache-2.0, Copyright (C) 2019 Gwenhael Goavec-Merou. {2} FPGA rows, {3} other TAPs, {4} manufacturer codes.";
pub const SAY_UNKNOWN : str = "unknown";

; --- Tests ----------------------------------------------------------------------------------
test bit_zero_of_an_idcode_is_one {
    assert K_FIELD_LSB[3] == 0;
    assert K_FIELD_WIDTH[3] == 1;
    assert K_TABLE_IDCODE % 2 == 1;
    assert K_BENCH_RAW_IDCODE % 2 == 1;
    assert K_STUCK_LOW % 2 == 0;
}

test the_four_fields_tile_32_bits {
    assert K_FIELD_WIDTH[0] + K_FIELD_WIDTH[1] + K_FIELD_WIDTH[2] + K_FIELD_WIDTH[3] == 32;
    assert K_FIELD_LSB[0] == K_FIELD_LSB[1] + K_FIELD_WIDTH[1];
    assert K_FIELD_LSB[1] == K_FIELD_LSB[2] + K_FIELD_WIDTH[2];
    assert K_FIELD_LSB[2] == K_FIELD_LSB[3] + K_FIELD_WIDTH[3];
    assert K_FIELD_LSB[0] + K_FIELD_WIDTH[0] == 32;
}

test x03636093_is_xilinx_0x049_part_0x3636 {
    assert K_TABLE_IDCODE == 56844435;
    assert K_XILINX_MFR == (K_TABLE_IDCODE / 2) % 2048;
    assert K_XILINX_MFR == 73;
    assert K_TABLE_PART == (K_TABLE_IDCODE / 4096) % 65536;
    assert K_TABLE_PART == 13878;
    assert K_TABLE_IDCODE / 268435456 == 0;
    assert 147 != (K_TABLE_IDCODE / 2) % 2048;
}

test xilinx_sits_in_jep106_bank_1_as_code_0x49 {
    assert K_XILINX_MFR / 128 == 0;
    assert K_XILINX_MFR % 128 == 73;
    assert K_MFR_CODE_BITS + 4 == K_FIELD_WIDTH[2];
}

test the_bench_word_differs_from_the_table_key_only_in_its_version {
    assert K_BENCH_RAW_IDCODE / 268435456 == 1;
    assert K_BENCH_RAW_IDCODE % 268435456 == K_TABLE_IDCODE;
    assert K_BENCH_RAW_IDCODE != K_TABLE_IDCODE;
    assert K_VERSION_MASK + 1 == 268435456;
    assert K_BENCH_BOARDS_2026_08_17 == 3;
    assert K_XC7A200T_IR_LENGTH == 6;
}

test all_ones_ends_the_chain_though_its_bit_0_is_1 {
    assert K_END_OF_CHAIN % 2 == 1;
    assert K_END_OF_CHAIN == 4294967295;
}

test the_page_reads_nothing_and_sends_nothing {
    assert READS_LOCAL_FILES == false;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
    assert K_HASH_KEY == "id";
}
