// SPDX-License-Identifier: Apache-2.0
; specs/widgets/t27c-stages.t27 -- how the t27c compiler works, stage by stage, on the reader's own text
; Source of truth for public/widgets/t27c-stages/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English of its own: every
; word on screen is a SAY_ constant here, every number the tool relies on is a K_ constant.
; ASCII only (L3), English only (LANG-EN). Lesson of the beginner course, gHashTag/trinity#1418.

; WHAT IT DOES: the reader edits a small t27 spec in a text box. After every pause in typing, the
; page hands the text to the real compiler, public/t27/t27_compiler.wasm (t27c built for the browser
; from gHashTag/t27 bindings/wasm-explorer), through its t27_analyze export, in the reader's tab. The
; answer is shown as six stages the reader clicks: the bytes, the tokens the lexer cut, the tree the
; parser built, the type checker's verdict, the HIR (hardware view) and the code each of seven
; backends wrote. When the lexer or the parser threw part of the text away without an error, the
; page says so above the stages, line by line: that is the compiler dropping text silently.

; WHAT IT DOES NOT CLAIM: that the stages are one straight pipe. In t27c each backend reads the
; parser's tree; the type check reports and does not stop them, and only the "Verilog from HIR"
; backend is written from the HIR. The page says this where it shows. It does not claim the type
; checker is complete: a name that was never declared passes it today. A spec with a `use` line
; shows less here than at the command line: the browser has no checkout to resolve imports from.

; DATA PROVENANCE: nothing on the page is precomputed. The K_EXAMPLE_ numbers below (the card's and
; the hook's) are what the same wasm answered in node for SAY_EXAMPLE_SOURCES[0];
; scripts/widget-data/t27c-stages.mjs re-runs it, writes examples.json and fails when they disagree.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_t27c_stages;

pub const KIND : str = "widget-tool";
pub const ID : str = "t27c-stages";
pub const TITLE : str = "Inside t27c: watch a compiler read your code, stage by stage";
pub const DESCRIPTION : str = "Edit a small t27 spec and see what the real t27c compiler, running as WebAssembly in your tab, makes of it: tokens, tree, type check, HIR and code in seven languages.";
pub const IMAGE_ALT : str = "Inside t27c card: a 12-line t27 spec, a tiny 8-bit adder, goes through six stages of the real compiler: 211 bytes, 45 tokens, a parse tree of 16 nodes 7 levels deep, a passed type check, a 51-line HIR, and 7 backends that wrote 8,060 bytes of Verilog, C, Rust, Zig, JavaScript and TypeScript.";
pub const HOOK : str = "12 lines of t27 become 45 tokens, a 16-node tree and code in 7 languages. Edit them and watch the real compiler redo it in your browser.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [3]str = ["public/t27/t27_compiler.wasm (731,581 bytes, sha256 bb39b9a5ca412a26...): the t27c compiler built for the browser from gHashTag/t27 bindings/wasm-explorer, vendored in trinity commit a41600ad7", "Every stage is computed in your tab by that file's t27_analyze export on the text in the box; nothing on the page is precomputed and nothing is sent", "node 22 scripts/widget-data/t27c-stages.mjs: runs the same wasm on this spec's examples, checks the K_EXAMPLE_ numbers and writes examples.json, from which scripts/widget-data/t27c-stages-card.py draws card.png"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- Numbers the tool relies on ------------------------------------------------------------
; Milliseconds of quiet after the last key before the text is compiled again.
pub const K_DEBOUNCE_MS : u16 = 220;
; Longer texts are refused, so a paste of a whole corpus does not freeze the tab.
pub const K_MAX_SOURCE_BYTES : u32 = 65536;
; How much of each stage is drawn; the counts always cover everything.
pub const K_MAX_TOKEN_CHIPS : u16 = 600;
pub const K_MAX_TREE_ROWS : u16 = 600;
pub const K_SOURCE_HEX_BYTES : u16 = 48;
; The backends the compiler reports; SAY_TARGET_IDS has one entry for each.
pub const K_TARGETS : u8 = 7;

; What the wasm answered for SAY_EXAMPLE_SOURCES[0] (checked by scripts/widget-data/t27c-stages.mjs).
pub const K_EXAMPLE_LINES : u16 = 12;
pub const K_EXAMPLE_BYTES : u16 = 211;
pub const K_EXAMPLE_TOKENS : u16 = 45;
pub const K_EXAMPLE_NODES : u16 = 16;
pub const K_EXAMPLE_DEPTH : u16 = 7;
pub const K_EXAMPLE_TARGETS_OK : u8 = 7;
pub const K_EXAMPLE_TARGET_BYTES : u32 = 8060;

pub const K_CARD_WIDTH : u16 = 1200;
pub const K_CARD_HEIGHT : u16 = 630;

; --- Words on screen ------------------------------------------------------------------------
; Templates take {0}, {1}, ... in order.
pub const SAY_LOADING : str = "Loading the t27c compiler (WebAssembly, about 0.7 MB)...";
pub const SAY_LOAD_FAILED : str = "The compiler did not load: {0}";
pub const SAY_CRASHED : str = "The compiler stopped on this text with an internal error ({0}). Change the text to try again.";
pub const SAY_TOO_BIG : str = "This text is {0} bytes; the page compiles up to {1}.";

pub const SAY_EXAMPLES_LABEL : str = "Start from";
pub const SAY_EXAMPLE_NAMES : [4]str = ["A tiny adder", "A value too big", "A stray character", "Junk after a value"];
pub const SAY_EXAMPLE_SOURCES : [4]str = ["; A tiny adder: 8-bit a plus 8-bit b. Edit anything.\nmodule tiny_adder;\n\npub const WIDTH : u8 = 8;\n\nfn on_comb(a: u8, b: u8) -> u8 {\n    return a + b;\n}\n\ntest adds_two_numbers {\n    assert on_comb(2, 3) == 5;\n}\n", "module too_big;\n\npub const LIMIT : u8 = 300;\n\nfn on_comb(a: u8) -> u8 {\n    return a;\n}\n\ntest passes_a_through {\n    assert on_comb(7) == 7;\n}\n", "module stray;\n\nfn on_comb(a: u8, b: u8) -> u8 {\n    return a $ b;\n}\n\ntest adds_or_not {\n    assert on_comb(2, 3) == 5;\n}\n", "module junk;\n\npub const SIZE : u8 = 4 @@ 2;\n\nfn on_comb(a: u8) -> u8 {\n    return a + SIZE;\n}\n\ntest adds_size {\n    assert on_comb(1) == 5;\n}\n"];
pub const SAY_EDITOR_LABEL : str = "Your t27 spec: edit it, the stages follow";
pub const SAY_EDITOR_FACTS : str = "{0} lines, {1} bytes. Compiled in {2} ms by t27_compiler.wasm, in this tab.";
pub const SAY_EDITOR_WAIT : str = "Compiling...";

pub const SAY_STAGES_LABEL : str = "Compiler stages";
pub const SAY_STAGE_NAMES : [6]str = ["Source", "Lexer", "Parser", "Typecheck", "HIR", "Backends"];
pub const SAY_STAGE_LINES : [6]str = ["To a compiler your text starts as plain bytes: one number per character, with no meaning yet.", "The lexer cuts the bytes into tokens, the words of the language: a keyword, a name, a number, a bracket. Comments and spaces are left out.", "The parser fits the tokens into a tree that says what holds what: the module holds a function, the function a return, the return an addition.", "The type checker walks the tree and asks whether every value fits the type it was given, such as 300 in a u8, which holds 0 to 255.", "HIR is a hardware view of the module: the wires that come in, the wires that go out and the signals inside.", "Each backend walks the tree and writes the program again in another language: Verilog for chips, C, Rust, Zig, JavaScript and TypeScript."];
pub const SAY_CHIP_BYTES : str = "{0} bytes";
pub const SAY_CHIP_TOKENS : str = "{0} tokens";
pub const SAY_CHIP_NODES : str = "{0} nodes";
pub const SAY_CHIP_PASSED : str = "passed";
pub const SAY_CHIP_ERRORS : str = "errors: {0}";
pub const SAY_CHIP_WARNINGS : str = "warnings: {0}";
pub const SAY_CHIP_LINES : str = "{0} lines";
pub const SAY_CHIP_STOPPED : str = "stopped";
pub const SAY_CHIP_BACKENDS : str = "{0} of {1}";

pub const SAY_DROPPED_TITLE : str = "The compiler silently dropped part of your text";
pub const SAY_DROPPED_WHY : str = "No error stopped it: every stage below was computed as if these pieces were not there.";
pub const SAY_DROP_LEXER : str = "line {0}: the lexer threw away the byte {1}";
pub const SAY_DROP_SWALLOWED : str = "line {0}: the parser skipped {1}";
pub const SAY_DROP_DISCARDED : str = "the parser fell back: {0}";
pub const SAY_DROP_BYTES_NOTE : str = "The lexer counts bytes, not characters: one non-ASCII character such as an em dash appears as two or three entries.";
pub const SAY_PARSE_STOPPED : str = "The parser stopped, so the stages after it have nothing to work on: {0}";

pub const SAY_SOURCE_FACTS : str = "{0} bytes on {1} lines.";
pub const SAY_SOURCE_HEX : str = "The first {0} bytes as the compiler receives them, each a number (hex) under its character:";
pub const SAY_SOURCE_VIEW : str = "Coloured by the tokens the lexer found:";

pub const SAY_LEXER_FACTS : str = "{0} tokens. Each shows its text and, under it, its kind.";
pub const SAY_TOKEN_CLASSES : [6]str = ["keyword", "name", "number", "text", "operator", "punctuation"];
pub const SAY_MORE : str = "and {0} more";

pub const SAY_PARSER_FACTS : str = "{0} nodes, {1} levels deep, {2} declarations at the top.";

pub const SAY_TC_OK : str = "Passed: every value fits its type.";
pub const SAY_TC_OK_WARN : str = "Passed. Warnings: {0}.";
pub const SAY_TC_ERRORS : str = "Failed. Errors: {0}, warnings: {1}.";
pub const SAY_TC_FATAL : str = "The type checker could not start: {0}";
pub const SAY_TC_NOT_A_GATE : str = "The backends wrote code anyway: in t27c the type check reports problems, it does not stop the build.";
pub const SAY_TC_LIMITS : str = "This checker is young: it does not catch every mistake yet. A name that was never declared passes it today.";

pub const SAY_HIR_FACTS : str = "{0} lines, printed by the compiler's own debug view of the HIR.";
pub const SAY_HIR_FEEDS : str = "Only the Verilog from HIR backend is written from this view; the other six read the parser's tree.";
pub const SAY_HIR_FAILED : str = "No HIR: {0}";

pub const SAY_BACKENDS_FACTS : str = "{0} of {1} backends wrote code, {2} bytes in all. Pick one:";
pub const SAY_TARGET_IDS : [7]str = ["verilog", "verilog_hir", "c", "rust", "zig", "js", "ts"];
pub const SAY_TARGET_NAMES : [7]str = ["Verilog", "Verilog from HIR", "C", "Rust", "Zig", "JavaScript", "TypeScript"];
pub const SAY_TARGET_BYTES : str = "{0} B";
pub const SAY_TARGET_FAILED : str = "This backend wrote nothing: {0}";
pub const SAY_CARD_KICKER : str = "A compiler, stage by stage";
pub const SAY_CARD_TARGETS : str = "Bytes each backend wrote for these 12 lines";
pub const SAY_CARD_FOOT : str = "The real t27c, as WebAssembly, in your browser. Edit the code; every stage follows.";
pub const SAY_NOT_EMITTED : str = "{0} declarations have no spelling in this language and were left out; the code marks each one.";

test the_card_is_x_shaped {
    assert K_CARD_WIDTH == 1200;
    assert K_CARD_HEIGHT == 630;
}

test the_page_sends_nothing_and_reads_no_files {
    assert SENDS_NOTHING == true;
    assert READS_LOCAL_FILES == false;
    assert CATEGORY == "compiler";
}

test the_example_numbers_hang_together {
    assert K_EXAMPLE_TOKENS > K_EXAMPLE_NODES;
    assert K_EXAMPLE_DEPTH < K_EXAMPLE_NODES;
    assert K_EXAMPLE_TARGETS_OK == K_TARGETS;
    assert K_EXAMPLE_BYTES <= K_MAX_SOURCE_BYTES;
}

test the_page_stays_responsive {
    assert K_DEBOUNCE_MS <= 500;
    assert K_MAX_TOKEN_CHIPS >= K_EXAMPLE_TOKENS;
    assert K_MAX_TREE_ROWS >= K_EXAMPLE_NODES;
}
