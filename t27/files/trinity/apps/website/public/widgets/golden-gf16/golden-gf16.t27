// SPDX-License-Identifier: Apache-2.0
; specs/widgets/golden-gf16.t27 -- the infographic of lesson 13 of the GoldenFloat course (specs/course/goldenfloat.t27)
; Source of truth for public/widgets/golden-gf16/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/numeric/gf16.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_golden_gf16;

pub const KIND : str = "widget-tool";
pub const ID : str = "golden-gf16";
pub const TITLE : str = "GoldenFloat 13: GF16, the primary format";
pub const DESCRIPTION : str = "GF16 special codes, read from gf16.t27. Lesson 13 of the GoldenFloat course.";
pub const IMAGE_ALT : str = "A black and white table, GF16 special codes: +0, 0x0000, GF16_ZERO_POS; -0, 0x8000, GF16_ZERO_NEG; +inf, 0x7E00, GF16_INF_POS; -inf, 0xFE00, GF16_INF_NEG; NaN, 0xFE01, GF16_NAN.";
pub const HOOK : str = "16 bits, 1 + 6 + 9, bias 31: the GoldenFloat the family marks primary.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/numeric/gf16.t27, read when the course was authored; every number in the table is a constant, a test value or arithmetic of that file", "Nothing on this page was measured on hardware or timed; a value written into a test is said to be written in, not computed"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "GF16 special codes";
pub const SAY_TABLE_HEAD : [3]str = ["Value", "Code", "Spec constant"];
pub const SAY_TABLE_CELLS : [15]str = ["+0", "0x0000", "GF16_ZERO_POS", "-0", "0x8000", "GF16_ZERO_NEG", "+inf", "0x7E00", "GF16_INF_POS", "-inf", "0xFE00", "GF16_INF_NEG", "NaN", "0xFE01", "GF16_NAN"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 5;
pub const K_TABLE_CELLS : u16 = 15;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "How GF16 gets its split";
pub const SAY_FLOW_STEPS : [3]str = ["N = 16 bits", "E = round(15 / phi^2) = 6", "M = 16 - 1 - 6 = 9"];
pub const K_FLOW_STEPS : u8 = 3;
pub const SAY_NOTE : str = "Every code above is a constant of gf16.t27; exponent code 63 is kept for infinity and NaN, and BIAS is 31.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 3;
    assert K_FLOW_STEPS > 1;
}
