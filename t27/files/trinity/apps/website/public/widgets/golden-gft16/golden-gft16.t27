// SPDX-License-Identifier: Apache-2.0
; specs/widgets/golden-gft16.t27 -- the infographic of lesson 25 of the GoldenFloat course (specs/course/goldenfloat.t27)
; Source of truth for public/widgets/golden-gft16/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/numeric/gft16.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_golden_gft16;

pub const KIND : str = "widget-tool";
pub const ID : str = "golden-gft16";
pub const TITLE : str = "GoldenFloat 25: GF-T16, six trits";
pub const DESCRIPTION : str = "GF-T16 as the spec lays it out, read from gft16.t27. Lesson 25 of the GoldenFloat course.";
pub const IMAGE_ALT : str = "A black and white table, GF-T16 as the spec lays it out: Sign, 1 bit, SIGN_BITS; Exponent, 6 trits, EXP_TRITS; Mantissa, 9 bits, MANT_BITS; Offset, 364, EXP_OFFSET; Non-finite offset, 728, OFFSET_MAX; Exponent values, 729, exp_values().";
pub const HOOK : str = "Six exponent trits give 729 values; the 9-bit mantissa is the same as GF16.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/numeric/gft16.t27, read when the course was authored; every number in the table is a constant, a test value or arithmetic of that file", "Nothing on this page was measured on hardware or timed; a value written into a test is said to be written in, not computed"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "GF-T16 as the spec lays it out";
pub const SAY_TABLE_HEAD : [3]str = ["Field", "Value", "Spec constant"];
pub const SAY_TABLE_CELLS : [18]str = ["Sign", "1 bit", "SIGN_BITS", "Exponent", "6 trits", "EXP_TRITS", "Mantissa", "9 bits", "MANT_BITS", "Offset", "364", "EXP_OFFSET", "Non-finite offset", "728", "OFFSET_MAX", "Exponent values", "729", "exp_values()"];
pub const K_TABLE_COLS : u8 = 3;
pub const K_TABLE_ROWS : u8 = 6;
pub const K_TABLE_CELLS : u16 = 18;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_NOTE : str = "gft16.t27 tests 1 + 6 + 9 = 16, E / M = 666 thousandths, and OFFSET_MAX = 2 x EXP_OFFSET.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}
