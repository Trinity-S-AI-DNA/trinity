// SPDX-License-Identifier: Apache-2.0
; specs/widgets/vcd-wrapped.t27 -- your simulation, wrapped: a summary card for a VCD file
; Source of truth for public/widgets/vcd-wrapped/ (gHashTag/trinity, apps/website). The page is
; written by scripts/widget-pages-from-spec.mjs from this file; tool.js holds no English of its
; own and reads every word below from window.T27_WIDGET.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: the reader drops a .vcd file (IEEE 1364 value change dump, from iverilog/vvp,
; Verilator, GHDL or any simulator that writes one). The page reads it in the browser with
; public/widgets/vcd-wrapped/vcdstats.js, streaming the file in chunks so a large dump is read in
; the memory of its signal list, never its waveform. It shows one card: the value changes and bit
; flips in the whole run, the busiest nets, the quietest nets, the signals that never leave X or Z,
; the signals that end in X or Z, the simulated time span, and how many signals and scopes the dump
; declares. The card can be saved as a 1200x630 PNG drawn in the page. The file never leaves the
; browser. It is a summary, not a viewer: the test-waves widget draws waveforms.

; HOW IT COUNTS: a value change is a recorded value that differs from the signal's previous value;
; the first value a signal gets (usually from $dumpvars) is its start, not a change. Bit flips count
; the bit positions that differ between the two values. One id code declared in several scopes is
; one signal with several names. A signal stays X/Z when none of its values is fully known.
; Parameters are constants and are counted apart. Values inside $dumpoff are skipped.

; THE SAMPLES: three real Icarus Verilog 12.0 runs, made one at a time by
; scripts/widget-data/vcd-wrapped.mjs. "counter" is specs/ternary/clocked_counter.t27 compiled to
; Verilog by public/t27/t27_compiler.wasm in node and driven by a hand-written testbench,
; scripts/widget-data/vcd-wrapped-counter-tb.v (not generated from the spec). "vsa-bind" and "tmu"
; are RTL committed under fpga/openxc7-synth/ with their own committed testbenches, run as they
; are. The tmu testbench fails all its tests in this repository: tmu.v reads tmu_test_w_wide.mem
; and no such file is committed, so its outputs stay X; it is shipped because that is what a real
; broken run looks like. Each VCD is shipped as vvp dumped it, not trimmed: all are under
; K_MAX_SAMPLE_BYTES. Every K_ fact below is re-read from the shipped VCDs by
; `node scripts/widget-data/vcd-wrapped.mjs --check`.

; WHAT IT DOES NOT CLAIM: that a busy net is a bug, or that a quiet one is fine. A signal stuck at
; X is often a real fault (an unloaded memory, a missing reset) and sometimes harmless (the locals
; of a function never called). The card counts what the dump recorded; a signal the testbench did
; not $dumpvars is not in it. It does not run a simulation.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_vcd_wrapped;

pub const KIND : str = "widget-tool";
pub const ID : str = "vcd-wrapped";
pub const TITLE : str = "VCD wrapped: your simulation, summed up on one card";
pub const DESCRIPTION : str = "Drop a .vcd from any simulator and get a Wrapped-style card: value changes, the busiest net, signals stuck at X or Z, the quietest ones and the time span, read in your browser.";
pub const IMAGE_ALT : str = "A Wrapped-style summary card on black for a real Icarus Verilog 12.0 run of the t27 ClockedCounter: 1,418 value changes over 2.925 us of simulated time, the busiest net clk with 585 changes, 4 signals that never leave X or Z, and 14 signals in 4 scopes.";
pub const HOOK : str = "Your testbench toggled clk 585 times and left 4 signals at X all run. Drop your .vcd and see your simulation, wrapped.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [7]str = ["Icarus Verilog version 12.0 (stable), iverilog and vvp; one run per sample, one at a time: iverilog -g2012 -s <top> -o sim.vvp <testbench> <design>; vvp -n sim.vvp; each command, the tool versions and the testbench's verdict lines in samples.json", "specs/ternary/clocked_counter.t27, compiled to Verilog by public/t27/t27_compiler.wasm in node (sha256 of spec and generated Verilog in samples.json)", "scripts/widget-data/vcd-wrapped-counter-tb.v: a hand-written testbench for the generated ClockedCounter, not from the spec; it checks the spec's own test, hold on en low, the u8 wrap and the asynchronous reset", "fpga/openxc7-synth/vsa_bind_16.v with fpga/openxc7-synth/tb/tb_vsa_bind_16.v, and fpga/openxc7-synth/tmu.v with fpga/openxc7-synth/tmu_tb.v, committed RTL and testbenches run unchanged", "The VCDs are shipped as vvp dumped them, not trimmed; each is under 200000 bytes", "public/widgets/vcd-wrapped/vcdstats.js: the one VCD reader, run in node for the samples and in the browser for your file", "node scripts/widget-data/vcd-wrapped.mjs --check: re-reads the shipped VCDs and fails if any K_ fact in this spec disagrees"];
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- The samples (the data script reads these) -------------------------------------------------
pub const K_SAMPLES_JSON : str = "samples.json";
pub const K_SAMPLE_IDS : [3]str = ["counter", "vsa-bind", "tmu"];
; Where each sample's design comes from: a spec under public/t27/files/specs/ (compiled by the wasm
; compiler), or RTL committed in this repository (path from the repository root).
pub const K_SAMPLE_KINDS : [3]str = ["t27", "repo", "repo"];
pub const K_SAMPLE_SOURCES : [3]str = ["ternary/clocked_counter.t27", "fpga/openxc7-synth/vsa_bind_16.v", "fpga/openxc7-synth/tmu.v"];
; The sample the page opens with and the gallery card is drawn from.
pub const K_CARD_SAMPLE : str = "counter";
; A VCD over this many bytes is not shipped as a sample.
pub const K_MAX_SAMPLE_BYTES : u32 = 200000;

; --- Facts from the run (scripts/widget-data/vcd-wrapped.mjs re-reads every one from the VCDs) ----
; One entry per K_SAMPLE_IDS, in order. Times are in the dump's own $timescale ticks (1ps for all three).
pub const K_CHANGES : [3]u32 = [1418, 152, 1180];
pub const K_FLIPS : [3]u32 = [2766, 751, 2585];
pub const K_SIGNALS : [3]u32 = [14, 32, 129];
pub const K_VARS : [3]u32 = [18, 36, 135];
pub const K_SCOPES : [3]u32 = [4, 2, 70];
pub const K_PARAMS : [3]u32 = [0, 0, 93];
pub const K_STUCK_XZ : [3]u32 = [4, 0, 3];
pub const K_ENDS_XZ : [3]u32 = [0, 0, 4];
pub const K_NEVER_CHANGED : [3]u32 = [6, 1, 6];
pub const K_SPAN : [3]u32 = [2925000, 450000, 1945000];
pub const K_STAMPS : [3]u32 = [595, 46, 390];
pub const K_BUSIEST_CHANGES : [3]u32 = [585, 45, 389];
; The testbench's own verdict, from the lines vvp printed: checks passed, and checks run.
pub const K_CHECKS_PASS : [3]u32 = [7, 6, 0];
pub const K_CHECKS_TOTAL : [3]u32 = [7, 6, 8];

; --- How it reads and draws ------------------------------------------------------------------------
pub const K_MIN_TARGET_PX : u8 = 32;
pub const K_CARD_W : u16 = 1200;
pub const K_CARD_H : u16 = 630;
; Rows in the busiest, quietest and X/Z lists.
pub const K_LIST_MAX : u8 = 5;
; A file is read in slices of this many bytes when the browser has no streaming reader.
pub const K_SLICE_BYTES : u32 = 4194304;
; Refuse a file whose $enddefinitions has not come within this many characters.
pub const K_MAX_HEADER_CHARS : u32 = 67108864;

; --- Every word on the screen -------------------------------------------------------------------
; Templates take {0}, {1}, ... in order.
pub const SAY_SAMPLES_LABEL : str = "Real simulations";
pub const SAY_SAMPLE_NAMES : [3]str = ["t27 ClockedCounter", "VSA bind, 16 trits", "TMU (fails in this repo)"];
pub const SAY_SAMPLE_LINES : [3]str = ["specs/ternary/clocked_counter.t27, compiled to Verilog by this site's wasm compiler and run by Icarus Verilog with a hand-written testbench (not from the spec). The signals stuck at X are the locals of a multiply helper the compiler emits and never calls.", "fpga/openxc7-synth/vsa_bind_16.v with its own committed testbench, run unchanged by Icarus Verilog.", "fpga/openxc7-synth/tmu.v with its own committed testbench, run unchanged: tmu.v reads tmu_test_w_wide.mem, which is not in the repository, so its weights load as X and its tests fail. A real broken run."];
pub const SAY_SAMPLE_VERDICT : str = "The testbench's own verdict: {0} of {1} checks passed.";
pub const SAY_SAMPLE_NOTE : str = "Shipped as vvp dumped it, not trimmed: {0} bytes.";
pub const SAY_OWN_LABEL : str = "Your VCD";
pub const SAY_DROP : str = "Drop a .vcd here, or pick a file";
pub const SAY_PICK : str = "Pick a .vcd file";
pub const SAY_READING : str = "Reading {0}: {1}%";
pub const SAY_PICKED : str = "{0}: {1} bytes";
pub const SAY_LOCAL_NOTE : str = "Read in this tab, in chunks; nothing is uploaded.";
pub const SAY_ERR_READ : str = "Could not read {0}.";
pub const SAY_ERR_LOAD : str = "The sample simulations did not load.";
; Why a file is refused, one entry per reason code vcdstats.js raises. {0} is the token, {1} the time.
pub const SAY_ERR_CODES : [9]str = ["not-vcd", "binary", "empty", "no-defs", "no-vars", "bad-var", "timescale", "unknown-id", "bad-token"];
pub const SAY_ERR_WORDS : [9]str = ["Not a VCD file: a VCD starts with a $ keyword such as $date or $timescale, and this starts with \"{0}\".", "Not a VCD file: it holds binary data. VCD is text; FST, LXT and GHW dumps are not read here.", "The file is empty.", "No $enddefinitions in this file: the header never ends, so this is not a whole VCD.", "The header declares no $var, so there is nothing to count.", "A $var line could not be read: \"{0}\".", "The $timescale could not be read: \"{0}\".", "A value change names id code \"{0}\" at time {1}, and no $var declares it.", "Unexpected text \"{0}\" after time {1}: not a time stamp, a value change or a $ keyword."];

pub const SAY_KICKER : str = "Your simulation, wrapped";
pub const SAY_HEADLINE : str = "{0} value changes";
pub const SAY_SUBHEAD : str = "over {0} of simulated time";
pub const SAY_BUSIEST_LINE : str = "Your busiest net was {0}, with {1} changes.";
pub const SAY_NO_MOVERS : str = "No signal changed after its first value.";
pub const SAY_TILE_NAMES : [6]str = ["bit flips", "signals", "scopes", "time stamps", "never leave X/Z", "end in X/Z"];
pub const SAY_LIST_TITLES : [4]str = ["Busiest nets", "Quietest nets that moved", "Never left X or Z", "End the run in X or Z"];
pub const SAY_ROW : str = "changes {0}, flips {1}";
pub const SAY_WIDTH : str = "{0} bits";
pub const SAY_WIDTH_ONE : str = "1 bit";
pub const SAY_ALIASES : str = "also under {0} other names";
pub const SAY_ALIASES_ONE : str = "also under 1 other name";
pub const SAY_MORE : str = "and {0} more";
pub const SAY_NONE : str = "none";
pub const SAY_NEVER_LINE : str = "{0} of {1} signals never changed after their first value.";
pub const SAY_PARAMS_LINE : str = "{0} parameters are constants and are counted apart.";
pub const SAY_VARS_LINE : str = "{0} $var lines name {1} distinct signals.";
pub const SAY_VERSION : str = "Dumped by {0}";
pub const SAY_TIMESCALE : str = "$timescale {0}{1}";
pub const SAY_UNITS : [6]str = ["s", "ms", "us", "ns", "ps", "fs"];
pub const SAY_NO_TIMESCALE : str = "ticks (no $timescale)";
pub const SAY_RULES : str = "A change is a value that differs from the one before; a signal's first value is not a change. Flips count the bits that differ. Values inside $dumpoff are skipped.";

pub const SAY_PNG_BUTTON : str = "Save as PNG card";
pub const SAY_PNG_FILE : str = "vcd-wrapped-{0}.png";
pub const SAY_CARD_BRAND : str = "TRINITY S3AI  /  VCD WRAPPED";
pub const SAY_CARD_URL : str = "t27.ai/widgets/vcd-wrapped/ -- read in the browser, nothing uploaded";
pub const SAY_HONEST : str = "A busy net is not a bug and a quiet one is not a pass. A signal stuck at X can be a real fault or a function never called. This counts what the dump recorded; it runs no simulation.";

; --- Tests: each holds of this file, and scripts/widget-data/vcd-wrapped.mjs runs them again with
; every K_ fact replaced by the value read from the shipped VCDs.
test the_t27_counter_passes_its_checks_and_clk_is_busiest {
    assert K_SAMPLE_KINDS[0] == "t27";
    assert K_SAMPLE_IDS[0] == K_CARD_SAMPLE;
    assert K_CHECKS_TOTAL[0] > 0;
    assert K_CHECKS_PASS[0] == K_CHECKS_TOTAL[0];
    assert K_BUSIEST_CHANGES[0] > 0;
    assert K_BUSIEST_CHANGES[0] <= K_CHANGES[0];
    assert K_STUCK_XZ[0] > 0;
    assert K_ENDS_XZ[0] == 0;
}

test the_tmu_run_fails_its_checks_and_leaves_x {
    assert K_SAMPLE_SOURCES[2] == "fpga/openxc7-synth/tmu.v";
    assert K_CHECKS_TOTAL[2] > 0;
    assert K_CHECKS_PASS[2] == 0;
    assert K_STUCK_XZ[2] + K_ENDS_XZ[2] > 0;
    assert K_PARAMS[2] > 0;
}

test the_counts_agree_with_each_other {
    assert K_CHANGES[0] <= K_FLIPS[0];
    assert K_CHANGES[1] <= K_FLIPS[1];
    assert K_CHANGES[2] <= K_FLIPS[2];
    assert K_SIGNALS[0] <= K_VARS[0];
    assert K_SIGNALS[1] <= K_VARS[1];
    assert K_SIGNALS[2] <= K_VARS[2];
    assert K_NEVER_CHANGED[0] + K_PARAMS[0] <= K_SIGNALS[0];
    assert K_NEVER_CHANGED[2] + K_PARAMS[2] <= K_SIGNALS[2];
    assert K_STUCK_XZ[0] + K_ENDS_XZ[0] <= K_SIGNALS[0];
    assert K_STUCK_XZ[2] + K_ENDS_XZ[2] <= K_SIGNALS[2];
    assert K_SPAN[0] > 0;
    assert K_SPAN[1] > 0;
    assert K_SPAN[2] > 0;
    assert K_STAMPS[1] > 0;
}

test the_vsa_bind_run_passes_clean {
    assert K_SAMPLE_KINDS[1] == "repo";
    assert K_CHECKS_TOTAL[1] > 0;
    assert K_CHECKS_PASS[1] == K_CHECKS_TOTAL[1];
    assert K_STUCK_XZ[1] == 0;
    assert K_CHANGES[1] > 0;
}

test the_page_reads_files_and_sends_nothing {
    assert READS_LOCAL_FILES == true;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
    assert K_CARD_W == 1200;
    assert K_CARD_H == 630;
    assert K_MIN_TARGET_PX >= 32;
    assert K_MAX_SAMPLE_BYTES <= 200000;
    assert SAY_ERR_CODES[0] == "not-vcd";
    assert SAY_ERR_CODES[8] == "bad-token";
}
