pub const SAY_READ : str = "Lint it";
pub const SAY_CLEAR : str = "Clear";
pub const SAY_LOCAL_NOTE : str = "Read in this tab; nothing is uploaded or stored.";
pub const SAY_TOO_BIG : str = "{0} is {1} bytes; this page reads up to {2}.";
pub const SAY_ERR_READ : str = "Could not read {0}.";
pub const SAY_ERR_DATA : str = "The package data did not load.";
pub const SAY_EMPTY_XDC : str = "No PACKAGE_PIN or LOC on get_ports found.";
pub const SAY_LINT_TITLE : str = "Lint";
pub const SAY_LINT_SUMMARY : str = "Ports placed: {0}. Pass: {1}. Balls flagged as errors: {2}.";
pub const SAY_PARSE_LINE : str = "{0} commands read, {1} place ports or set their IOSTANDARD, {2} are about something else.";
pub const SAY_LINT_CLEAN : str = "Every placed port sits on a user IO ball.";
pub const SAY_LINT_MORE : str = "{0} more not shown.";
pub const SAY_SEV : [3]str = ["error", "warning", "note"];
pub const SAY_LINT_IDS : [9]str = ["noball", "notio", "mgt", "xadc", "twoports", "moved", "nostd", "vcco", "dual"];
pub const SAY_LINT_TEXT : [9]str = ["{0} ({1}): no such ball on this package.", "{0} ({1}): not a user IO. prjxray-db lists no pin here, so it is power, ground or a dedicated pin.", "{0} ({1}): {2} is a transceiver pin, not a user IO.", "{0} ({1}): {2} is the dedicated XADC input, not a user IO.", "{0}: given to more than one port: {2}.", "{0} ({1}): placed again; line {3} had it on {2}.", "{0} ({1}): no IOSTANDARD.", "Bank {2} mixes standards that need different VCCO: {3}.", "{0} ({1}): {2} doubles as a configuration pin; it is user IO once the FPGA is configured."];
pub const SAY_OVERLAY_LEGEND : [3]str = ["port on user IO", "flagged", "matches the search"];
pub const SAY_NOTE_FGG : str = "The board carries the FGG676 part; prjxray-db lists the FBG676. fpga/HARDWARE_SSOT.md (2026-07-05) records the same die and the same BGA-676 pinout.";
pub const SAY_NOTE_UNLISTED : str = "{0} of {1} balls are not in prjxray-db: power, ground and dedicated pins. They are drawn grey, not guessed.";
pub const SAY_NOTE_100T : str = "Many project XDCs name the XC7A100T: its {0} listed balls carry the same pin names on the 200T.";

; --- Tests ------------------------------------------------------------------------------------
test the_grid_is_26_by_26 {
    assert K_GRID_ROWS == 26;
    assert K_GRID_COLS == 26;
    assert K_BALLS == K_GRID_ROWS * K_GRID_COLS;
    assert K_GRID_ROWS == K_ROWS_SINGLE + K_ROWS_DOUBLE;
    assert K_ROWS_SINGLE + K_SKIPPED_LETTERS == 26;
    assert SAY_SKIPPED_LETTERS[0] == "I";
    assert SAY_SKIPPED_LETTERS[5] == "Z";
}

test every_ball_is_listed_or_counted_as_unlisted {
    assert K_LISTED_PINS + K_UNLISTED_BALLS == K_BALLS;
    assert K_LISTED_PINS == K_USER_IO + K_MGT_PINS + K_DEDICATED_LISTED;
    assert K_TYPE_COUNTS[0] + K_TYPE_COUNTS[1] + K_TYPE_COUNTS[2] + K_TYPE_COUNTS[3] + K_TYPE_COUNTS[4] + K_TYPE_COUNTS[5] + K_TYPE_COUNTS[6] + K_TYPE_COUNTS[7] == K_BALLS;
    assert K_TYPE_COUNTS[7] == K_UNLISTED_BALLS;
    assert K_TYPE_COUNTS[5] == K_MGT_PINS;
    assert K_TYPE_COUNTS[6] == K_DEDICATED_LISTED;
}

test the_bank_count_matches_the_data {
    assert K_BANKS == 11;
    assert K_BANKS == K_IO_BANKS + K_MGT_BANKS + 1;
    assert K_USER_IO == K_IO_BANKS * K_IO_PER_BANK;
    assert K_MGT_PINS == K_MGT_BANKS * K_MGT_PINS_PER_BANK;
    assert K_BANK_IDS[0] == 12;
    assert K_BANK_IDS[7] == 35;
    assert K_BANK_IDS[8] == 213;
    assert K_BANK_IDS[9] == 216;
    assert K_BANK_IDS[10] == 0;
}

test the_100t_fits_inside_the_200t_package {
    assert K_A100T_PINS < K_USER_IO;
    assert K_A100T_PINS > 0;
}

test the_demo_counts_add_up {
    assert K_DEMO_OK[0] + K_DEMO_FLAGGED[0] == K_DEMO_PORTS[0];
    assert K_DEMO_OK[1] + K_DEMO_FLAGGED[1] == K_DEMO_PORTS[1];
    assert K_DEMO_OK[2] + K_DEMO_FLAGGED[2] == K_DEMO_PORTS[2];
    assert K_DEMO_OK[3] + K_DEMO_FLAGGED[3] == K_DEMO_PORTS[3];
    assert SAY_DEMO_IDS[0] == "wukong";
    assert K_DEMO_FLAGGED[0] == 13;
}

test the_page_reads_files_and_sends_nothing {
    assert READS_LOCAL_FILES == true;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
    assert K_VCCO_MV[0] == 3300;
    assert SAY_VCCO_STD[0] == "LVCMOS33";
}
