// SPDX-License-Identifier: Apache-2.0
; specs/widgets/pin-map.t27 -- the XC7A200T FGG676 package, ball by ball, with an XDC pin lint
; Source of truth for public/widgets/pin-map/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English of its own: every
; word on screen is a SAY_ constant here, every number the tool relies on is a K_ constant or comes
; from pins.json, which scripts/widget-data/pin-map.mjs writes and checks against this file.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT SHOWS: the 26 by 26 ball grid of the XC7A200T in its 676-ball package, seen from above
; with ball A1 at the top left. The row letters are read from the data, not assumed: prjxray-db
; uses A to Y without I, O, Q, S and X, then AA to AF. Each ball the database lists is coloured by
; bank or by pin type; on top sit the ports of one of the project's XDC files, or the reader's own,
; pasted or dropped, read in the browser and sent nowhere. The lint flags a port placed on a ball
; that does not exist, on a ball with no user IO, on a transceiver or XADC pin, two ports on one
; ball, a port with no IOSTANDARD, and a bank whose standards need different VCCO.

; DATA PROVENANCE: the package is prjxray-db ab1fc60 xc7a200tfbg676-1 package_pins.csv. The board
; carries the FGG676 part; fpga/HARDWARE_SSOT.md in gHashTag/t27 (2026-07-05 update) records that
; the FGG and FBG 676 parts share the die and the BGA-676 pinout, and AMD publishes one pinout file
; for both. The overlays are the project's own XDC files at the commits named in DATA_SOURCES; the
; data script reads each with git show at that commit and lints it with the page's own xdc.js, so
; the counts below are the counts the page shows.

; WHAT IT DOES NOT CLAIM: prjxray-db lists only the balls the fabric reaches (user IO, transceiver
; pads, the XADC pair). The other 234 balls are power, ground or dedicated pins such as JTAG, DONE
; and CCLK, and the database does not say which is which; the page draws them grey and says so
; rather than guessing. The VCCO check covers single-ended standards only and reads AMD UG471, not
; a board schematic. A clean lint does not prove a board works: it proves the balls exist and are
; user IO.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_pin_map;

pub const KIND : str = "widget-tool";
pub const ID : str = "pin-map";
pub const TITLE : str = "Pin map: the XC7A200T FGG676 package ball by ball, with an XDC lint";
pub const DESCRIPTION : str = "All 676 balls of the XC7A200T FGG676 by bank and type, with our board's pins on top. Paste or drop an XDC: it is linted in your browser and sent nowhere.";
pub const IMAGE_ALT : str = "Pin map card: the XC7A200T FGG676 package drawn as chip art, 676 balls in a 26 by 26 grid tinted by bank, grey where prjxray-db lists no pin. The project's Wukong XDC places 49 ports: 36 balls glow green on user IO, 13 glow red because that package has no user IO there.";
pub const HOOK : str = "Our own Wukong XDC puts 13 of its 49 ports on balls with no user IO. Paste yours and see where every pin lands on the XC7A200T.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [8]str = ["prjxray-db ab1fc60 artix7 xc7a200tfbg676-1/package_pins.csv, 442 pins, sha256 3bfc5cc78ac975cc69e677c69d8c7bdc89ab8bd629ea2cef88625002a99858f7; the -2, -2L, -3 and fbv676 files checked byte-identical", "gHashTag/t27 fpga/HARDWARE_SSOT.md at 8fcafe894, 2026-07-05 update: xc7a200tfbg676-1 and xc7a200tfgg676-1 share the die and the BGA-676 pinout", "gHashTag/t27 4832ec6ab specs/fpga/constraints/qmtech_a100t.xdc: the Wukong board XDC, 49 ports", "gHashTag/t27 ea15cd54c fpga/verilog/ternary_mac_demo_top.xdc (the flashed LED demo) and fpga/bscan_spi_qmtech/bscan_spi_qmtech.xdc", "gHashTag/trinity-fpga e1dc687b7 fpga/openxc7-synth/power_modes.xdc: the QMTECH core board pins", "prjxray-db ab1fc60 xc7a100tfgg676-1/package_pins.csv: all 342 balls carry the same pin name on the 200T", "AMD UG471 7 Series FPGAs SelectIO Resources: the VCCO each single-ended IOSTANDARD needs", "scripts/widget-data/pin-map.mjs: derives every K_ count with public/widgets/pin-map/xdc.js and exits 1 when this spec disagrees"];
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- The package, as prjxray-db lists it (pin-map.mjs checks every one) -----------------------
pub const K_GRID_ROWS : u8 = 26;
pub const K_GRID_COLS : u8 = 26;
pub const K_BALLS : u16 = 676;
; Single-letter rows A..Y without I O Q S X; double-letter rows AA..AF.
pub const K_ROWS_SINGLE : u8 = 20;
pub const K_ROWS_DOUBLE : u8 = 6;
pub const K_SKIPPED_LETTERS : u8 = 6;
pub const K_LISTED_PINS : u16 = 442;
pub const K_UNLISTED_BALLS : u16 = 234;
pub const K_IO_BANKS : u8 = 8;
pub const K_IO_PER_BANK : u8 = 50;
pub const K_USER_IO : u16 = 400;
pub const K_MGT_BANKS : u8 = 2;
pub const K_MGT_PINS_PER_BANK : u8 = 20;
pub const K_MGT_PINS : u8 = 40;
; Bank 0 as the database lists it: only VP_0 and VN_0, the XADC pair.
pub const K_DEDICATED_LISTED : u8 = 2;
pub const K_BANKS : u8 = 11;
; User IO banks, then transceiver banks, then bank 0.
pub const K_BANK_IDS : [11]u16 = [12, 13, 14, 15, 16, 33, 34, 35, 213, 216, 0];
; Balls per pin type, in the order of SAY_TYPE_IDS.
pub const K_TYPE_COUNTS : [8]u16 = [243, 64, 48, 32, 13, 40, 2, 234];
; The XC7A100T in the same package: balls whose pin name matches the 200T's.
pub const K_A100T_PINS : u16 = 342;

; --- The demo XDCs, linted by xdc.js in node (order of SAY_DEMO_IDS) ---------------------------
pub const K_DEMO_PORTS : [4]u8 = [49, 2, 8, 3];
pub const K_DEMO_OK : [4]u8 = [36, 2, 8, 2];
pub const K_DEMO_FLAGGED : [4]u8 = [13, 0, 0, 1];

; --- VCCO per single-ended IOSTANDARD (AMD UG471), millivolts --------------------------------
pub const SAY_VCCO_STD : [16]str = ["LVCMOS33", "LVTTL", "LVCMOS25", "LVCMOS18", "LVCMOS15", "LVCMOS12", "SSTL15", "SSTL135", "SSTL18_I", "SSTL18_II", "HSTL_I", "HSTL_II", "HSTL_I_18", "HSTL_II_18", "HSUL_12", "MOBILE_DDR"];
pub const K_VCCO_MV : [16]u16 = [3300, 3300, 2500, 1800, 1500, 1200, 1500, 1350, 1800, 1800, 1500, 1500, 1800, 1800, 1200, 1800];

; --- Page limits ------------------------------------------------------------------------------
pub const K_MAX_XDC_BYTES : u32 = 2000000;
pub const K_MAX_LINT_ROWS : u16 = 200;

; --- Words on screen ------------------------------------------------------------------------
; Templates take {0}, {1}, ... in order.
pub const SAY_PART_LINE : str = "XC7A200T, 676-ball package: {0} rows by {1} columns, {2} pins listed, {3} banks";
pub const SAY_GRID_ALT : str = "Ball grid of the XC7A200T 676-ball package, seen from above, A1 at the top left";
pub const SAY_SKIPPED_LETTERS : [6]str = ["I", "O", "Q", "S", "X", "Z"];
pub const SAY_ROWS_NOTE : str = "Rows run A to AF; the letters {0} are not used.";
pub const SAY_SEARCH_LABEL : str = "Find";
pub const SAY_SEARCH_HINT : str = "ball, signal or pin name: E3, led, MRCC";
pub const SAY_MATCHES : str = "Matching balls: {0}";
pub const SAY_NO_MATCH : str = "Nothing matches.";
pub const SAY_COLOUR_LABEL : str = "Colour by";
pub const SAY_COLOUR_MODES : [2]str = ["bank", "pin type"];
pub const SAY_BANK_LABEL : str = "Bank";
pub const SAY_ALL : str = "all";
pub const SAY_BANK_NAME : str = "bank {0}";
pub const SAY_BANK_KINDS : [3]str = ["user IO", "transceiver", "XADC pair"];
pub const SAY_BANK_LEGEND : str = "{0}: {1}, {2} pins";
pub const SAY_TYPE_IDS : [8]str = ["io", "clock", "config", "analog", "vref", "mgt", "xadc", "unlisted"];
pub const SAY_TYPE_NAMES : [8]str = ["user IO", "clock capable (MRCC, SRCC)", "IO shared with configuration", "IO with an XADC input", "IO or VREF", "transceiver (MGT)", "XADC VP or VN", "not in prjxray-db"];
pub const SAY_TYPE_LEGEND : str = "{0}: {1}";
pub const SAY_DETAIL_HINT : str = "Hover or tap a ball.";
pub const SAY_DETAIL_FIELDS : [9]str = ["ball", "pin name", "bank", "type", "site", "tile", "signal", "IOSTANDARD", "XDC line"];
pub const SAY_NONE : str = "none";
pub const SAY_UNLISTED_LINE : str = "prjxray-db lists no pin here: power, ground or a dedicated pin such as JTAG, DONE or CCLK. The database does not say which.";
pub const SAY_OVERLAY_LABEL : str = "Pins from";
pub const SAY_DEMO_IDS : [4]str = ["wukong", "flashed", "core-board", "spi-proxy"];
pub const SAY_DEMO_NAMES : [4]str = ["Wukong board", "Flashed LED demo", "Core board", "SPI flash proxy"];
pub const SAY_DEMO_LINES : [4]str = ["The project's Wukong board XDC. Its header names the XC7A200T-FGG676 core board and the Wukong expansion.", "The two LEDs of ternary_mac_demo_top, the design fpga/HARDWARE_SSOT.md programs onto the board.", "The QMTECH core board pins used by power_modes: clock, LEDs, UART, two switches and a button.", "The JTAG-to-SPI flash proxy. Its comment calls C8 FCS_B; on this package C8 is a transceiver pin."];
pub const SAY_DEMO_SOURCE : str = "{0} at {1}: {2}";
pub const SAY_YOURS : str = "Your XDC";
pub const SAY_PASTE_HINT : str = "Paste an XDC here, or drop a file on the box below.";
