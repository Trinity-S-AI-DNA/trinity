// SPDX-License-Identifier: Apache-2.0
; specs/widgets/basics-expressions.t27 -- the infographic of lesson 9 of the t27 basics course (specs/course/t27-basics.t27)
; Source of truth for public/widgets/basics-expressions/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/basics/09_expressions.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_basics_expressions;

pub const KIND : str = "widget-tool";
pub const ID : str = "basics-expressions";
pub const TITLE : str = "t27 basics 9: operators on two numbers";
pub const DESCRIPTION : str = "Every arithmetic and comparison operator of a t27 test, applied to 17 and 5 by the lesson spec. Lesson 9 of the t27 basics course.";
pub const IMAGE_ALT : str = "A black and white table of operators applied to A = 17 and B = 5: plus gives 22, minus gives 12, times gives 85, divide gives 3, remainder gives 2, and the comparisons greater, less or equal and not equal give true.";
pub const HOOK : str = "17 / 5 in t27 is 3, and 17 % 5 is 2. Every operator on two numbers.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/basics/09_expressions.t27, compiled clean on 7 backends by public/t27/t27_compiler.wasm, whose tests pass in the site test runner", "Compiler verdicts, error lines, code and counts quoted on this page are what the same wasm answered in node 22 when the course was authored; words without a run behind them are said to be read, not run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "A = 17, B = 5";
pub const SAY_TABLE_HEAD : [2]str = ["Expression", "Result"];
pub const SAY_TABLE_CELLS : [16]str = ["A + B", "22", "A - B", "12", "A * B", "85", "A / B", "3", "A % B", "2", "A > B", "true", "B <= A", "true", "A != B", "true"];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 8;
pub const K_TABLE_CELLS : u16 = 16;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_NOTE : str = "Every row is an assert in the lesson spec, and all of them pass.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}
