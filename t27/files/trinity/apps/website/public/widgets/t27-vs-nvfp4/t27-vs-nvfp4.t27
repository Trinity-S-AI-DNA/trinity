// SPDX-License-Identifier: Apache-2.0
; specs/widgets/t27-vs-nvfp4.t27 -- a scoreboard of 4-bit-class weight formats on one small model
; Source of truth for public/widgets/t27-vs-nvfp4/ (gHashTag/trinity, apps/website). The page is
; written by scripts/widget-pages-from-spec.mjs from this file; tool.js holds no English of its
; own and reads every word below from window.T27_WIDGET, and every number from data.json.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT SHOWS: the second ternary storage search of trinity-fpga, run once on 2026-09-27. Test
; perplexity (lower is better) of SmolLM2-135M on wikitext-2 with its weights stored in BASE
; (unquantised), E2M2, T27_N, NVFP4, MXPLUS and MXFP4; then, for each comparator C, the permille
; ratio r = 1000 * ppl(T27_N) / ppl(C) against the two pre-registered bars, BEAT 990 and TIE 1010.
; A dev / test switch shows both splits; dev is where T27_N was chosen among three T27 cells.

; DATA PROVENANCE: scripts/widget-data/t27-vs-nvfp4.mjs reads the runner's own output
; (research/block/ternary_storage_search_v2.json), compiles the pre-registration
; (specs/numeric/ternary_storage_search_v2.t27) with the site's wasm t27 compiler for the ladder,
; the window count and the storage per 32 weights, cross-checks every perplexity and ratio the
; verdict report prints, and writes public/widgets/t27-vs-nvfp4/data.json. The K_ facts below are
; that file's numbers as integers (perplexity times 10000, ratios times 10); `--check` fails if one
; of them disagrees with the run, runs the tests below on them, and runs a negative control that
; moves T27's perplexity 2 permille and must make the tests fail.

; WHAT IT DOES NOT CLAIM: everything in SAY_LIMITS, taken from the verdict's "What it does not say".
; The only claim that holds is "better than NVFP4 on a ternary substrate". E2M2 was not on the
; pre-registered ladder: its ratio is computed here from the two test perplexities, same formula.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_t27_vs_nvfp4;

pub const KIND : str = "widget-tool";
pub const ID : str = "t27-vs-nvfp4";
pub const TITLE : str = "T27 vs NVFP4: six weight formats on one small language model";
pub const DESCRIPTION : str = "Perplexity of six weight formats on SmolLM2-135M and the pre-registered ladder: T27 better than NVFP4, MX+ and MXFP4 on a trit substrate, worse than E2M2. Every limit listed.";
pub const IMAGE_ALT : str = "Scoreboard on black: SmolLM2-135M wikitext-2 test perplexity, lower is better: BASE 14.49, E2M2 15.81, T27_N 16.29 in gold, NVFP4 17.47, MX+ 17.98, MXFP4 21.94. T27 to NVFP4 is 932 per mille against a 990 bar, MX+ 906, MXFP4 743; against E2M2 it is 1030, a loss. One model, weights only, no confidence interval.";
pub const HOOK : str = "One claim with its limits: T27 beats NVFP4 on a ternary substrate, on one small model, and loses to a 5-bit E2M2. See every number and every caveat.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [4]str = ["trinity-fpga research/block/ternary_storage_search_v2.json @ d31d8523cd (sha256 969e7b196f6afb9a...): the runner's output, perplexity per arm and split, permille ratios and verdicts; python 3.12.12, torch 2.11.0, transformers 4.57.6, run 2026-09-27 11:44:02Z to 11:52:11Z, not retried", "trinity-fpga specs/numeric/ternary_storage_search_v2.t27 @ 49a84ade57 (sha256 88fcf517296ecc77..., the sha the run recorded): the pre-registration, compiled with the wasm t27 compiler for BEAT_PERMILLE, TIE_PERMILLE, NWIN, SEQLEN and the trits and bits per 32 weights", "trinity-fpga research/block/TERNARY_STORAGE_V2_VERDICT_2026-09-27.md @ d31d8523cd: the report; its perplexity and ratio tables are cross-checked against the JSON, and every limit on this page is from its section What it does not say", "node scripts/widget-data/t27-vs-nvfp4.mjs writes data.json; --check re-reads the three files and fails if data.json or a K_ fact here disagrees; card.png is drawn from data.json by scripts/widget-data/t27-vs-nvfp4-card.py"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The run, as integers (scripts/widget-data/t27-vs-nvfp4.mjs --check re-reads every one) -----
pub const K_DATA : str = "data.json";
; The arms in page order. K_PPL_*_E4 is perplexity times 10000, rounded; 0 means not run on that split.
pub const K_ARMS : [6]str = ["BASE", "E2M2", "T27_N", "NVFP4", "MXPLUS", "MXFP4"];
pub const K_BASE_ARM : u8 = 0;
pub const K_T27_ARM : u8 = 2;
pub const K_NVFP4_ARM : u8 = 3;
pub const K_PPL_TEST_E4 : [6]u32 = [144869, 158083, 162892, 174697, 179780, 219353];
pub const K_PPL_DEV_E4 : [6]u32 = [0, 162063, 166880, 180213, 183802, 226285];
; The comparators of T27_N and the arm each one is. r is per mille times 10, rounded.
pub const K_COMPARATORS : [4]str = ["E2M2", "NVFP4", "MXPLUS", "MXFP4"];
pub const K_COMPARATOR_ARM : [4]u8 = [1, 3, 4, 5];
pub const K_R_TEST_X10 : [4]u32 = [10304, 9324, 9061, 7426];
pub const K_R_DEV_X10 : [4]u32 = [10297, 9260, 9079, 7375];
; The pre-registered ladder: r <= BEAT is T27 better, r <= TIE a tie, above that C better.
pub const K_BEAT_PERMILLE : u16 = 990;
pub const K_TIE_PERMILLE : u16 = 1010;
pub const K_WINDOWS : u8 = 40;
pub const K_SEQLEN : u16 = 2048;
; Storage of a 32-weight block, per arm (0 for BASE). Trits are the pre-registered axis; T27's
; bits are a dense packing of its trits.
pub const K_TRITS_32 : [6]u16 = [0, 134, 101, 106, 106, 102];
pub const K_BITS_32 : [6]u16 = [0, 168, 161, 144, 141, 136];
; Excess test perplexity over BASE, times 100, and the share of NVFP4's excess T27 removes.
pub const K_EXCESS_T27_E2 : u16 = 180;
pub const K_EXCESS_NVFP4_E2 : u16 = 298;
pub const K_GAP_CLOSED_PCT : u8 = 40;

; --- Every word on the screen -------------------------------------------------------------------
; Templates take {0}, {1}, ... in order, or {name} for a named value from data.json.
pub const SAY_ARM_NAMES : [6]str = ["BASE", "E2M2", "T27_N", "NVFP4", "MX+", "MXFP4"];
pub const SAY_ARM_NOTES : [6]str = ["unquantised", "5-bit cell, no trits", "3 trits, 27 levels, one power-of-two scale per 32", "E2M1 per 16, E4M3 scale; our reimplementation", "our reimplementation of MX+", "E2M1 per 32, E8M0 scale (rule B)"];
pub const SAY_CLAIM_LABEL : str = "The one claim that holds";
pub const SAY_CLAIM : str = "Better than NVFP4 on a ternary substrate.";
pub const SAY_CLAIM_LINE : str = "Test perplexity {0} against {1} (r = {2} per mille, bar {3}), stored in {4} trits per 32 weights against {5}. It loses to E2M2.";
pub const SAY_SPLIT_LABEL : str = "Split";
pub const SAY_SPLITS : [2]str = ["test", "dev"];
pub const SAY_SPLIT_LINES : [2]str = ["Test: each arm run once, after T27_N was chosen on dev.", "Dev: where T27_N was chosen among three T27 cells. Not the result; shown so the choice is visible."];
pub const SAY_PPL_TITLE : str = "Perplexity, lower is better";
pub const SAY_PPL_LINE : str = "SmolLM2-135M, wikitext-2 {split}, {windows} windows of {seqlen} tokens; weights quantised, activations not.";
pub const SAY_TIMES_BASE : str = "x{0} BASE";
pub const SAY_NOT_RUN : str = "not run on dev";
pub const SAY_CAND_TITLE : str = "The three T27 cells on dev";
pub const SAY_CAND_LINE : str = "The lowest dev perplexity went to test; the other two were never run on test.";
pub const SAY_CHOSEN : str = "chosen";
pub const SAY_R_TITLE : str = "T27_N against each format, per mille";
pub const SAY_R_LINE : str = "r = 1000 x ppl(T27_N) / ppl(C). Bars fixed before the run: r up to {0} is T27 better, up to {1} a tie, above that C better.";
pub const SAY_R_AXIS : str = "r, per mille ({0} = equal)";
pub const SAY_BEAT_MARK : str = "BEAT {0}";
pub const SAY_TIE_MARK : str = "TIE {0}";
pub const SAY_VERDICT_IDS : [3]str = ["beat", "tie", "lose"];
pub const SAY_VERDICT_TEXT : [3]str = ["T27 better", "tie", "T27 loses"];
pub const SAY_OFF_LADDER : str = "not on the pre-registered ladder; computed here from the two perplexities";
pub const SAY_GAP : str = "T27_N removes {0}% of NVFP4's excess over the unquantised model: excess test perplexity {1} against {2}.";
pub const SAY_STORE_TITLE : str = "Storage per 32 weights";
pub const SAY_STORE_HEAD : [3]str = ["format", "trits", "bits"];
pub const SAY_STORE_LINE : str = "Trits are the pre-registered equal-storage axis. In bits, packed densely, T27_N costs {0} against NVFP4's {1}: {2}% more.";
pub const SAY_NOT_TITLE : str = "What this does NOT show";
pub const SAY_LIMITS : [8]str = ["One model and one corpus: SmolLM2-135M on wikitext-2. Weights only: nothing about activations or the KV cache, nothing about other models.", "No confidence interval. Each arm is one point on {windows} windows of {seqlen} tokens; a paired bootstrap was not pre-registered, so none is claimed. Large margins are judgement, not a test.", "NVFP4 and MX+ are our own reimplementations, from NVIDIA's published recipe and from the MX+ paper, not the authors' code. MXFP4 uses a ceil E8M0 scale (rule B).", "T27_N was chosen on dev, the lowest of {ncand} T27 cells there. Test was touched once, after the choice.", "Nothing about binary memory. Packed densely, T27_N costs {t27bits} bits per 32 weights against NVFP4's {nvbits}; E2M2 costs {e2m2bits} and beats T27_N. On a bit substrate this is not an equal-storage comparison.", "Nothing about the cost of a trit cell against a bit cell: nobody has measured it, and ReTern argues it is higher.", "The rulers reproduced the first attempt's numbers on the same machine; the numbers of the main branch's machine were not re-run.", "E2M2 was not on the pre-registered ladder; its ratio here uses the same formula on the two test perplexities."];
pub const SAY_SOURCE : str = "Numbers from trinity-fpga {0} at {1}, ladder from {2} at {3}; read by scripts/widget-data/t27-vs-nvfp4.mjs. Run {4} to {5}, torch {6}, not retried.";
pub const SAY_ERR_LOAD : str = "The data did not load.";
pub const SAY_CHART_ALT : str = "Bars of {split} perplexity per weight format, and dots of T27_N's per-mille ratio to each format against the BEAT and TIE bars.";

; --- Tests --------------------------------------------------------------------------------------
test the_test_ratios_are_the_test_perplexities_within_one_permille {
    assert K_R_TEST_X10[0] * K_PPL_TEST_E4[K_COMPARATOR_ARM[0]] <= 10000 * K_PPL_TEST_E4[K_T27_ARM] + 10 * K_PPL_TEST_E4[K_COMPARATOR_ARM[0]];
    assert 10000 * K_PPL_TEST_E4[K_T27_ARM] <= K_R_TEST_X10[0] * K_PPL_TEST_E4[K_COMPARATOR_ARM[0]] + 10 * K_PPL_TEST_E4[K_COMPARATOR_ARM[0]];
    assert K_R_TEST_X10[1] * K_PPL_TEST_E4[K_COMPARATOR_ARM[1]] <= 10000 * K_PPL_TEST_E4[K_T27_ARM] + 10 * K_PPL_TEST_E4[K_COMPARATOR_ARM[1]];
    assert 10000 * K_PPL_TEST_E4[K_T27_ARM] <= K_R_TEST_X10[1] * K_PPL_TEST_E4[K_COMPARATOR_ARM[1]] + 10 * K_PPL_TEST_E4[K_COMPARATOR_ARM[1]];
    assert K_R_TEST_X10[2] * K_PPL_TEST_E4[K_COMPARATOR_ARM[2]] <= 10000 * K_PPL_TEST_E4[K_T27_ARM] + 10 * K_PPL_TEST_E4[K_COMPARATOR_ARM[2]];
    assert 10000 * K_PPL_TEST_E4[K_T27_ARM] <= K_R_TEST_X10[2] * K_PPL_TEST_E4[K_COMPARATOR_ARM[2]] + 10 * K_PPL_TEST_E4[K_COMPARATOR_ARM[2]];
    assert K_R_TEST_X10[3] * K_PPL_TEST_E4[K_COMPARATOR_ARM[3]] <= 10000 * K_PPL_TEST_E4[K_T27_ARM] + 10 * K_PPL_TEST_E4[K_COMPARATOR_ARM[3]];
    assert 10000 * K_PPL_TEST_E4[K_T27_ARM] <= K_R_TEST_X10[3] * K_PPL_TEST_E4[K_COMPARATOR_ARM[3]] + 10 * K_PPL_TEST_E4[K_COMPARATOR_ARM[3]];
}

test the_dev_ratios_are_the_dev_perplexities_within_one_permille {
    assert K_R_DEV_X10[0] * K_PPL_DEV_E4[K_COMPARATOR_ARM[0]] <= 10000 * K_PPL_DEV_E4[K_T27_ARM] + 10 * K_PPL_DEV_E4[K_COMPARATOR_ARM[0]];
    assert 10000 * K_PPL_DEV_E4[K_T27_ARM] <= K_R_DEV_X10[0] * K_PPL_DEV_E4[K_COMPARATOR_ARM[0]] + 10 * K_PPL_DEV_E4[K_COMPARATOR_ARM[0]];
    assert K_R_DEV_X10[1] * K_PPL_DEV_E4[K_COMPARATOR_ARM[1]] <= 10000 * K_PPL_DEV_E4[K_T27_ARM] + 10 * K_PPL_DEV_E4[K_COMPARATOR_ARM[1]];
    assert 10000 * K_PPL_DEV_E4[K_T27_ARM] <= K_R_DEV_X10[1] * K_PPL_DEV_E4[K_COMPARATOR_ARM[1]] + 10 * K_PPL_DEV_E4[K_COMPARATOR_ARM[1]];
    assert K_R_DEV_X10[2] * K_PPL_DEV_E4[K_COMPARATOR_ARM[2]] <= 10000 * K_PPL_DEV_E4[K_T27_ARM] + 10 * K_PPL_DEV_E4[K_COMPARATOR_ARM[2]];
    assert 10000 * K_PPL_DEV_E4[K_T27_ARM] <= K_R_DEV_X10[2] * K_PPL_DEV_E4[K_COMPARATOR_ARM[2]] + 10 * K_PPL_DEV_E4[K_COMPARATOR_ARM[2]];
    assert K_R_DEV_X10[3] * K_PPL_DEV_E4[K_COMPARATOR_ARM[3]] <= 10000 * K_PPL_DEV_E4[K_T27_ARM] + 10 * K_PPL_DEV_E4[K_COMPARATOR_ARM[3]];
    assert 10000 * K_PPL_DEV_E4[K_T27_ARM] <= K_R_DEV_X10[3] * K_PPL_DEV_E4[K_COMPARATOR_ARM[3]] + 10 * K_PPL_DEV_E4[K_COMPARATOR_ARM[3]];
}

test the_ladder_says_t27_beats_three_and_loses_to_e2m2 {
    assert K_COMPARATORS[1] == "NVFP4";
    assert K_R_TEST_X10[1] <= 10 * K_BEAT_PERMILLE;
    assert K_R_TEST_X10[2] <= 10 * K_BEAT_PERMILLE;
    assert K_R_TEST_X10[3] <= 10 * K_BEAT_PERMILLE;
    assert K_COMPARATORS[0] == "E2M2";
    assert K_R_TEST_X10[0] > 10 * K_TIE_PERMILLE;
    assert K_R_DEV_X10[1] <= 10 * K_BEAT_PERMILLE;
    assert K_R_DEV_X10[0] > 10 * K_TIE_PERMILLE;
    assert K_BEAT_PERMILLE < K_TIE_PERMILLE;
}

test perplexity_orders_the_arms_as_the_page_lists_them {
    assert K_PPL_TEST_E4[0] < K_PPL_TEST_E4[1];
    assert K_PPL_TEST_E4[1] < K_PPL_TEST_E4[2];
    assert K_PPL_TEST_E4[2] < K_PPL_TEST_E4[3];
    assert K_PPL_TEST_E4[3] < K_PPL_TEST_E4[4];
    assert K_PPL_TEST_E4[4] < K_PPL_TEST_E4[5];
    assert K_PPL_DEV_E4[K_BASE_ARM] == 0;
}

test t27_removes_forty_percent_of_nvfp4s_excess {
    assert K_PPL_TEST_E4[K_T27_ARM] - K_PPL_TEST_E4[K_BASE_ARM] + 50 >= 100 * K_EXCESS_T27_E2;
    assert K_PPL_TEST_E4[K_T27_ARM] - K_PPL_TEST_E4[K_BASE_ARM] + 50 < 100 * K_EXCESS_T27_E2 + 100;
    assert K_PPL_TEST_E4[K_NVFP4_ARM] - K_PPL_TEST_E4[K_BASE_ARM] + 50 >= 100 * K_EXCESS_NVFP4_E2;
    assert K_PPL_TEST_E4[K_NVFP4_ARM] - K_PPL_TEST_E4[K_BASE_ARM] + 50 < 100 * K_EXCESS_NVFP4_E2 + 100;
    assert K_GAP_CLOSED_PCT == (200 * (K_PPL_TEST_E4[K_NVFP4_ARM] - K_PPL_TEST_E4[K_T27_ARM]) + K_PPL_TEST_E4[K_NVFP4_ARM] - K_PPL_TEST_E4[K_BASE_ARM]) / (2 * (K_PPL_TEST_E4[K_NVFP4_ARM] - K_PPL_TEST_E4[K_BASE_ARM]));
}

test fewer_trits_than_nvfp4_but_more_bits {
    assert K_TRITS_32[K_T27_ARM] < K_TRITS_32[K_NVFP4_ARM];
    assert K_BITS_32[K_T27_ARM] > K_BITS_32[K_NVFP4_ARM];
    assert K_BITS_32[1] > K_BITS_32[K_T27_ARM];
    assert K_WINDOWS == 40;
    assert K_SEQLEN == 2048;
}

test the_page_reads_nothing_of_yours_and_sends_nothing {
    assert READS_LOCAL_FILES == false;
    assert SENDS_NOTHING == true;
    assert CATEGORY == "fpga";
}
