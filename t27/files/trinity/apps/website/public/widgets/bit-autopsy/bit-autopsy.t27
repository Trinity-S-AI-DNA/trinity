// SPDX-License-Identifier: Apache-2.0
; specs/widgets/bit-autopsy.t27 -- what a Xilinx 7-series bitstream says about itself, read in the browser
; Source of truth for public/widgets/bit-autopsy/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs
; compiles this file, checks its constants, evaluates the tests below and writes the page; the page
; hands every constant to tool.js as window.T27_WIDGET. tool.js holds no English of its own: every
; word on screen is a SAY_ constant here, every number the tool relies on is a K_ constant.
; ASCII only (L3), English only (LANG-EN).

; WHAT IT DOES: reads one bitstream the reader drops or picks (.bit with its header, or a raw .bin),
; in the reader's browser, with FileReader. It prints the header fields as written (design, part,
; date, time), counts the bytes and the zero bytes, finds the sync word, walks the type 1 and type 2
; configuration packets, takes the IDCODE the stream writes (packet 0x30018001 and the word after it)
; and names the part from a table of 7-series IDCODEs with the version nibble masked; anything not
; in the table is "unknown". It counts the FDRI frames, the frames with any bit set (the ECC field of
; word 50 left out), the command and CRC packets, and draws which frames are non-zero, one band per
; configuration row. A Download PNG button saves that autopsy as a card drawn on a canvas.

; DATA PROVENANCE: the six samples are summaries computed by the same parser
; (public/widgets/bit-autopsy/autopsy.js) run in node by scripts/widget-data/bit-autopsy.mjs on the
; real files; the bitstreams themselves are not shipped (3.8 MB and 9.7 MB). Five are the bitstreams
; committed to gHashTag/t27 under fpga/openxc7-synth/ at commit c129a5b9e9f0; one is the build-receipt
; widget's XC7A200T bitstream. Every sample's frame count, non-zero frame count and set-bit count
; equals what prjxray bitread (commit c9f02d85) prints for the same file; the script exits 1 if not.
; The IDCODE table is openFPGALoader v1.1.1 src/part.hpp (the idcode widget's parts.json), checked
; against every Artix-7 die in prjxray-db ab1fc60; the row and column layout is prjxray-db part.json.

; WHAT IT DOES NOT CLAIM: it does not decode the design. Which LUTs, wires or pins a frame sets is
; not shown, and a non-zero frame count is not a size of the logic. It does not say whether a board
; will accept the file; the bench line quotes UG470 on IDCODE mismatch, it did not program a board.
; It refuses encrypted (CBC) and compressed (MFWR) bitstreams, and reads only 7-series streams.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_bit_autopsy;

pub const KIND : str = "widget-tool";
pub const ID : str = "bit-autopsy";
pub const TITLE : str = "Bitstream autopsy: which FPGA a 7-series .bit really targets";
pub const DESCRIPTION : str = "Drop a Xilinx 7-series .bit: header, the IDCODE it writes and the part that names, frames, zero bytes and packets, read in your browser. Nothing is uploaded.";
pub const IMAGE_ALT : str = "Bitstream autopsy card: blink_j26.bit, committed to gHashTag/t27, writes IDCODE 0x03631093, an XC7A100T, while the bench board is an XC7A200T (0x03636093); all 5 t27 .bit files do. 134 of its 9,448 frames are non-zero and 99.96 percent of its 3,825,921 bytes are zero, with a frame map per row. The build-receipt .bit writes the bench IDCODE.";
pub const HOOK : str = "Five bitstreams committed to t27 write the XC7A100T IDCODE; the bench is a 200T. Drop your .bit and see which chip it asks for.";
pub const CATEGORY : str = "fpga";
pub const DATA_SOURCES : [6]str = ["gHashTag/t27 commit c129a5b9e9f0: fpga/openxc7-synth/blink_j26.bit, find_led.bit, static_d5.bit, test_top.bit and phi_temporal/temporal_heartbeat.bit (read with git show; t27#6222)", "build-receipt widget bitstream build_receipt.bit for xc7a200tfbg676-1, sha256 f1da88bc8f4660ff3e68dd050ae9277553a59897739f7a5b0b768fc7868e25a6", "prjxray bitread commit c9f02d85 (2025-06-05): bitread -part_file prjxray-db/artix7/<part>/part.yaml -z -o and -x -z -o; frame, non-zero frame and set-bit counts equal ours for all six samples", "openFPGALoader v1.1.1 (85be4fa0) src/part.hpp via the idcode widget's parts.json, checked against prjxray-db ab1fc60 artix7 part.json (rows, columns, IDCODEs)", "AMD UG470 7 Series FPGAs Configuration: bitstream header, sync word, packet types, registers, commands, IDCODE check and ID_ERROR", "scripts/widget-data/bit-autopsy.mjs: samples.json, parts.json and geometry.json, computed by public/widgets/bit-autopsy/autopsy.js in node"];
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- Numbers the tool relies on ------------------------------------------------------------
; 0xAA995566, the word after which the configuration logic reads packets.
pub const K_SYNC_WORD : u32 = 2862175590;
pub const K_FRAME_WORDS : u8 = 101;
; 0x0FFFFFFF: the IDCODE compared without its top four bits, the silicon version.
pub const K_IDCODE_MASK : u32 = 268435455;
; Every configuration row in the FDRI stream ends with two pad frames.
pub const K_PAD_FRAMES_PER_ROW : u8 = 2;
; The bench: three QMTech Wukong V1 boards, XC7A200T, IDCODE 0x03636093 with the version masked
; (gHashTag/t27 fpga/HARDWARE_SSOT.md). The XC7A100T is 0x03631093.
pub const K_BENCH_IDCODE : u32 = 56844435;
pub const K_XC7A100T_IDCODE : u32 = 56823955;
; Clock-region rows per die, and the two block types an FDRI stream writes (CLB/IO/CLK, block RAM).
pub const K_XC7A100T_ROWS : u8 = 4;
pub const K_XC7A200T_ROWS : u8 = 5;
pub const K_BLOCK_TYPES_WRITTEN : u8 = 2;
; The six samples, in the order of SAY_SAMPLE_IDS; scripts/widget-data/bit-autopsy.mjs exits 1 if
; any of these differs from what the parser and prjxray bitread find in the files.
pub const K_SAMPLE_IDCODES : [6]u32 = [56823955, 56844435, 56823955, 56823955, 56823955, 56823955];
pub const K_SAMPLE_FRAME_SLOTS : [6]u32 = [9464, 24080, 9464, 9464, 9464, 9464];
pub const K_SAMPLE_CONFIG_FRAMES : [6]u32 = [9448, 24060, 9448, 9448, 9448, 9448];
pub const K_SAMPLE_NONZERO_FRAMES : [6]u32 = [134, 230, 152, 9, 75, 137];
pub const K_SAMPLE_BYTES : [6]u32 = [3825921, 9730757, 3825920, 3825921, 3825920, 3825905];
; Cells per band in the frame map.
pub const K_STRIP_BUCKETS : u16 = 160;
; The card the Download PNG button saves.
pub const K_CARD_W : u16 = 1200;
pub const K_CARD_H : u16 = 630;

; --- Words on screen ------------------------------------------------------------------------
; Templates take {0}, {1}, ... in order.
pub const SAY_SAMPLE_LABEL : str = "Real bitstreams, precomputed";
pub const SAY_SAMPLE_IDS : [6]str = ["blink_j26", "build_receipt", "find_led", "static_d5", "test_top", "temporal_heartbeat"];
pub const SAY_SAMPLE_NAMES : [6]str = ["blink_j26", "build receipt", "find_led", "static_d5", "test_top", "temporal_heartbeat"];
pub const SAY_SAMPLE_LINES : [6]str = ["gHashTag/t27 fpga/openxc7-synth/blink_j26.bit, built 2026-05-08 by openXC7.", "The build-receipt widget's bitstream for xc7a200tfbg676-1, built 2026-10-04.", "gHashTag/t27 fpga/openxc7-synth/find_led.bit, built 2026-05-08 by openXC7.", "gHashTag/t27 fpga/openxc7-synth/static_d5.bit, built 2026-05-08 by openXC7.", "gHashTag/t27 fpga/openxc7-synth/test_top.bit, built 2026-05-08 by openXC7.", "gHashTag/t27 fpga/openxc7-synth/phi_temporal/temporal_heartbeat.bit, built 2026-05-09."];
pub const SAY_SAMPLE_NOTE : str = "Computed in node by this page's own parser on the real files and checked against prjxray bitread; the bitstreams are not shipped. Drop one below to compute it again here.";
pub const SAY_OWN_LABEL : str = "Your file";
pub const SAY_DROP : str = "Drop or pick a .bit or .bin";
