pub const SAY_VERDICT_AGREE : str = "The header says {0}; the IDCODE it writes says {1}. They agree.";
pub const SAY_VERDICT_DISAGREE : str = "The header says {0}, but the IDCODE it writes says {1}.";
pub const SAY_VERDICT_NO_HEADER : str = "No header (raw .bin). The IDCODE it writes says {0}.";
pub const SAY_VERDICT_NO_IDCODE : str = "The stream writes no IDCODE, so it names no part.";
pub const SAY_VERDICT_UNKNOWN : str = "The IDCODE {0} is not in the 7-series table here: unknown part.";
