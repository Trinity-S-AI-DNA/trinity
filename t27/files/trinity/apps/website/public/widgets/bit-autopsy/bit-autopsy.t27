pub const SAY_PACKETS_TITLE : str = "Packets and commands";
pub const SAY_PACKET_FIELDS : [8]str = ["type 1", "type 2", "NOP", "register writes", "CMD", "CRC writes", "FAR writes", "FDRI writes"];
