// SPDX-License-Identifier: Apache-2.0
; specs/widgets/basics-loops.t27 -- the infographic of lesson 15 of the t27 basics course (specs/course/t27-basics.t27)
; Source of truth for public/widgets/basics-loops/ (gHashTag/trinity): scripts/widget-pages-from-spec.mjs compiles
; this file, checks its constants, evaluates the tests below and writes the page. tool.js is one import of
; ../infographic.js, which draws SAY_TABLE_* as a real <table> and SAY_FLOW_* as an SVG diagram with a
; <title>, black and white, and holds no words of its own. ASCII only (L3), English only (LANG-EN).
; The lesson spec it illustrates: public/t27/files/specs/basics/15_loops.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module widget_basics_loops;

pub const KIND : str = "widget-tool";
pub const ID : str = "basics-loops";
pub const TITLE : str = "t27 basics 15: three loop forms";
pub const DESCRIPTION : str = "while, for in a range and the Zig-style for, each checked with the real t27 compiler, and a range drawn step by step. Lesson 15 of the t27 basics course.";
pub const IMAGE_ALT : str = "A black and white table of three loop forms in t27 with the compiler verdict for each: while with a condition, for i in 0..n, and for (0..4) |i|; a diagram walks i through 0, 1, 2, 3 and 4 for a range 0..5.";
pub const HOOK : str = "for i in 0..5 visits 0 to 4. Three loop forms, all checked by the compiler.";
pub const CATEGORY : str = "compiler";
pub const DATA_SOURCES : [2]str = ["The lesson spec public/t27/files/specs/basics/15_loops.t27, compiled clean on 7 backends by public/t27/t27_compiler.wasm, whose tests pass in the site test runner", "Compiler verdicts, error lines, code and counts quoted on this page are what the same wasm answered in node 22 when the course was authored; words without a run behind them are said to be read, not run"];
pub const READS_LOCAL_FILES : bool = false;
pub const SENDS_NOTHING : bool = true;

; --- The table -----------------------------------------------------------------------------
pub const SAY_TABLE_CAPTION : str = "Loop forms, as the compiler answered";
pub const SAY_TABLE_HEAD : [2]str = ["Form", "Verdict"];
pub const SAY_TABLE_CELLS : [6]str = ["while (i < n) { }", "Compiles on all 7 backends", "for i in 0..n { }", "Compiles on all 7 backends", "for (0..4) |i| { }", "Compiles on all 7 backends"];
pub const K_TABLE_COLS : u8 = 2;
pub const K_TABLE_ROWS : u8 = 3;
pub const K_TABLE_CELLS : u16 = 6;

; --- The diagram and the note ----------------------------------------------------------------
pub const SAY_FLOW_TITLE : str = "for i in 0..5";
pub const SAY_FLOW_STEPS : [5]str = ["i = 0, s = 0", "i = 1, s = 1", "i = 2, s = 3", "i = 3, s = 6", "i = 4, s = 10"];
pub const K_FLOW_STEPS : u8 = 5;
pub const SAY_NOTE : str = "The range 0..5 stops before 5; the lesson spec tests the sum 10.";

test the_cells_fill_whole_rows {
    assert K_TABLE_ROWS * K_TABLE_COLS == K_TABLE_CELLS;
}

test the_table_has_a_body {
    assert K_TABLE_ROWS > 0;
    assert K_TABLE_COLS > 0;
}

test the_diagram_has_every_step {
    assert K_FLOW_STEPS == 5;
    assert K_FLOW_STEPS > 1;
}
