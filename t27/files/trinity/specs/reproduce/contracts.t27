test the_lock_names_its_source {
    assert KIND == "contract-lock";
    assert T27_REPO == "https://github.com/gHashTag/t27";
    assert VENDOR_DIR == "external/t27";
}

test the_ledgers_hold_together {
    assert PARSE_DISCARD_TOKENS[0] == 48;
    assert TESTS_RUN_MIN == 78;
}
