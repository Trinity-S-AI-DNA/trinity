; The test graph: the floors it may not drop below. A graph that shrank is a partial graph, and a run step
; that ran no test is not a passing one: one does today, the step of external/zig-hslm/src/root.zig, the only
; compiled test root without a test declaration. A skipped test is not a passing one either, and what skips
; depends on the machine: the four x86-64 JIT tests of src/jit.zig and the differential tests of the x86-64
; kernels skip off x86_64, the differential test of the ARM64 kernels off aarch64 -- each counted once per
; root that compiles it. So the floors are per architecture, ARCHES[i] with TESTS_PASSED_MIN[i] and
; TESTS_SKIPPED_MAX[i], and a record from another architecture is not judged against either. Not every pass
; tested something: 23 of the 24 older tests of src/jit_arm64.zig, and 4 of the 5 of src/jit_x86_64.zig,
; return early off their architecture and are counted as passed there.
pub const TEST_STEPS_MIN : u32 = 135;
pub const ARCHES : [2]str = ["x86_64", "aarch64"];
pub const TESTS_PASSED_MIN : [2]u32 = [2773, 2763];
pub const TESTS_SKIPPED_MAX : [2]u32 = [3, 13];
pub const RUN_STEPS_WITH_TESTS_MIN : u32 = 66;
pub const EMPTY_RUN_STEPS_MAX : u32 = 1;
