// SPDX-License-Identifier: Apache-2.0
; specs/reproduce/headless.t27 -- the headless profile of gHashTag/trinity, reproduced from a clean clone
; S12 of gHashTag/trinity#988 (gHashTag/trinity#989): a set of specifications is not a recreated project until
; a clean checkout builds and tests the declared profile, and a failure anywhere fails the gate. This module is
; that profile, measured; tools/reproduce.py runs it and judges every run against it (the command is
; `python3 tools/reproduce.py headless`, the CI job is .github/workflows/reproduce.yml).
; MEASURED twice with Zig 0.15.2 and empty caches: Linux aarch64 in a container, and the jobs of the change that
; brought this version. At afc9d38435ad01c48af6c33c311da422c38f046e (2026-09-30) the test step printed
; "124/135 steps succeeded; 5 failed; 2510/2510 tests passed", and CI reported that summary as a success: its
; test step was `zig build test -Dci=true 2>&1 | tee` under bash without pipefail, so the step's exit code was
; tee's (gHashTag/trinity#616; the tee fix alone is gHashTag/trinity#987). gHashTag/trinity#1207 put this
; module and its judge in front of CI with the five roots that did not compile named as BLOCKED. The next
; change fixed all five on main 3c33adbdb7b0b70a8485fc2efc0429ec1c239c5e -- two module names and libc in
; build.zig, a duplicated `if` in src/c_api.zig, an import of a deleted file in src/e2e_test.zig, and the
; HybridBigInt API of zig-golden-float (the unpacked cache is an array, not an optional; dotProduct, bundle2
; and bundle3 take no allocator) in src/science.zig, src/vm.zig, src/vsa_jit.zig and src/c_api.zig -- and the
; graph now runs whole: "135/135 steps succeeded; 2760/2768 tests passed; 8 skipped" on aarch64, where the
; eight tests of src/jit.zig that execute x86-64 machine code skip themselves; on x86_64 they run.
; Not a claim about any profile but headless; not a claim that the tests that ran test enough.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module reproduce_headless;

pub const KIND : str = "reproduce-profile";
pub const ID : str = "reproduce/headless";
pub const PROFILE : str = "headless";
pub const MEASURED_AT : str = "3c33adbdb7b0b70a8485fc2efc0429ec1c239c5e";
pub const ZIG : str = "0.15.2";
; The documented clean-clone commands. tools/reproduce.py replaces the leading zig with the binary it is given
; and, unless asked to reuse caches, points ZIG_GLOBAL_CACHE_DIR and ZIG_LOCAL_CACHE_DIR at a new empty
; directory, so nothing a developer built before is reused.
pub const BUILD : str = "zig build -Dci=true --summary all";
pub const TEST : str = "zig build test -Dci=true --summary all";
pub const CLEAN_CLONE : str = "git clone https://github.com/gHashTag/trinity && cd trinity && python3 tools/reproduce.py headless";
; The four packages build.zig.zon pins, exactly: zig verifies a package against its hash, so a changed pin is
; a different dependency that builds just as quietly. Changing one is a decision made here, not only there.
pub const DEPENDENCIES : [4]str = ["emsdk", "raylib", "zig_hdc", "zig_golden_float"];
pub const DEPENDENCY_URLS : [4]str = ["git+https://github.com/emscripten-core/emsdk?ref=4.0.9#3bcf1dcd01f040f370e10fe673a092d9ed79ebb5", "git+https://github.com/raylib-zig/raylib-zig#cd71c85d571027ac8033357f83b124ee051825b3", "https://github.com/gHashTag/zig-hdc/archive/b73b2fa29874f4e30297f167a6ea8a3c2ded9d32.tar.gz", "https://github.com/gHashTag/zig-golden-float/archive/e7ce32885de2a8c50b7b6a3030d0592202145dd1.tar.gz"];
pub const DEPENDENCY_HASHES : [4]str = ["N-V-__8AAJl1DwBezhYo_VE6f53mPVm00R-Fk28NPW7P14EQ", "raylib_zig-5.6.0-dev-KE8REENOBQC-m5nK7M2b5aKSIubJPbPLUYcRhT7aT3RN", "zig_hdc-0.1.0-6NS2Eg99FQCG62j7TmpGwVTnq07LhNb1FUHrwUacgWdO", "golden_float-2.1.0-h7LKhUUNCwAtKVHQ56wjridCZVwXY7_oxT2hXD9xCDdF"];
