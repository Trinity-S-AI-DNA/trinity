; The roots that may fail to compile, each with what the compiler says and the capability card of the S01
; manifest it holds back. None today. A root that stops compiling and cannot be fixed in the change that
; breaks it is named here, and only then may it fail; a named root that compiles again fails the gate until
; its line is removed, so the list cannot outlive the defect. At afc9d384 it held five (see the header).
pub const BLOCKED_ROOTS : [0]str = [];
pub const BLOCKED_REASONS : [0]str = [];
pub const BLOCKED_CAPABILITIES : [0]str = [];
pub const EVIDENCE : str = "tools/reproduce.py writes zig-out/reproduce/<command>.json: toolchain, head, cache freshness, each command with its exit code and summary, the compile failures by root, the run steps, the compiled roots, every install with its sha256, and the violations";
pub const ENABLED : bool = true;

test the_profile_is_headless_and_pinned {
    assert PROFILE == "headless";
    assert ZIG == "0.15.2";
    assert BUILD_STEPS_MIN == 94;
}

test the_floors_hold_together {
    assert TESTS_PASSED_MIN[0] == 2773;
    assert TESTS_PASSED_MIN[1] == 2763;
    assert TESTS_SKIPPED_MAX[0] + TESTS_PASSED_MIN[0] == TESTS_SKIPPED_MAX[1] + TESTS_PASSED_MIN[1];
    assert RUN_STEPS_WITH_TESTS_MIN + EMPTY_RUN_STEPS_MAX == 67;
    assert TEST_STEPS_MIN > RUN_STEPS_WITH_TESTS_MIN;
}

invariant every_root_runs {
    assert EMPTY_RUN_STEPS_MAX <= 1;
    assert TESTS_SKIPPED_MAX[0] <= 3;
    assert TESTS_SKIPPED_MAX[1] <= 13;
}
