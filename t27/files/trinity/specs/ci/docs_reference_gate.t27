// SPDX-License-Identifier: Apache-2.0
; Issue: https://github.com/gHashTag/trinity/issues/1360
; Related CI debt: https://github.com/gHashTag/trinity/issues/810
; Check tracked Markdown/MDX under docs/ and the four listed root documents,
; using CommonMark and GitHub-flavored Markdown syntax, including bare URL links,
; rather than code examples. Build/cache files are not inputs.
; Relative paths resolve from their source file; site routes resolve in the actual
; built Docusaurus routes, never by rewriting every root URL to GitHub blob/main.
; Missing local targets, malformed links and definitive HTTP400/404/410 block CI.
; Authorization/rate limits, DNS/timeouts and server outages remain UNKNOWN.
; UNKNOWN is not a verified URL and cannot produce an "all links good" report.
; Probe external links and retain their status/time independently of source errors.
; Public probes omit credentials; local/private endpoints are examples, not probed.
module ci_docs_reference_gate;

pub const DOCS_BASE : str = "/docs/";
pub const DOCS_TREE_ROOT : str = "docs";
pub const ROOT_DOCUMENTS : str = "README.md,AGENTS.md,CLAUDE.md,CONTRIBUTING.md";
pub const MARKDOWN_EXTENSIONS : str = ".md,.mdx";
pub const GFM_AUTOLINKS : u32 = 1;
pub const DOCS_CONTENT_ROOT : str = "docs/docs";
pub const DOCS_STATIC_ROOT : str = "docs/static";
pub const DOCS_BUILD_ROOT : str = "docs/build";
pub const BROKEN : u32 = 0;
pub const VERIFIED : u32 = 1;
pub const UNKNOWN : u32 = 2;
pub const HTTP_VERIFIED_MIN : u32 = 200;
pub const HTTP_VERIFIED_MAX : u32 = 399;
pub const HTTP_STATUS : [14]u32 = [200,202,203,206,301,302,308,400,401,403,404,410,429,503];
pub const HTTP_CLASS : [14]u8 = [1,1,1,1,1,1,1,0,2,2,0,0,2,2];
pub const TIMEOUT_MS : u32 = 10000;
pub const CONCURRENCY : u32 = 6;
pub const MAX_REDIRECTS : u32 = 10;

test verified_responses_are_measured {
    assert GFM_AUTOLINKS == 1;
    assert HTTP_CLASS[0] == 1;
    assert HTTP_CLASS[1] == 1;
    assert HTTP_CLASS[2] == 1;
    assert HTTP_CLASS[3] == 1;
    assert HTTP_CLASS[4] == 1;
    assert HTTP_CLASS[5] == 1;
    assert HTTP_CLASS[6] == 1;
}
test denied_or_unavailable_is_not_alive {
    assert HTTP_CLASS[8] == 2;
    assert HTTP_CLASS[9] == 2;
    assert HTTP_CLASS[12] == 2;
    assert HTTP_CLASS[13] == 2;
    assert UNKNOWN != VERIFIED;
}
test definite_broken_references_block {
    assert HTTP_CLASS[7] == 0;
    assert HTTP_CLASS[10] == 0;
    assert HTTP_CLASS[11] == 0;
    assert BROKEN != UNKNOWN;
}
