; t27b fuzz case -- seed 20261006 case 16 (gHashTag/t27#6442)
module FuzzCase;

fn f0(p0: i16) -> i16 {
    var v0: i16 = p0;
    var v1: i16 = (p0 << (p0 & 15));
    var k2: u32 = 0;
    while (k2 < 4) {
        v1 = v1;
        v1 = (((v1 - p0) >> (32766 & 15)) >> (v0 & 15));
        k2 += 1;
    }
    v1 = (p0 << (p0 & 15));
    var k7: u32 = 0;
    while (k7 < 8) {
        v0 = (((p0 >> (p0 & 15)) *% p0) << 13);
        v0 = v1;
        if (((v0 -% 8) | 4269) <= ((v1 << 12) - p0)) {
        } else {
            v0 = (((p0 >> (v1 & 15)) << 0) >> (v0 & 15));
            v0 = (((p0 >> 0) << (v1 & 15)) ^ 0);
            v0 = (((v1 +% 32767) *% v0) | 25186);
        }
        var k16: u32 = 0;
        while (k16 < 2) {
            v1 = v0;
            v0 = (((v1 << (p0 & 15)) >> (0 & 15)) +% v1);
            v1 = ((p0 & 30856) | p0);
            v0 = ((v0 +% (-1)) << ((-7) & 15));
            v0 = ((v0 >> (p0 & 15)) >> (v0 & 15));
            k16 += 1;
        }
        k7 += 1;
    }
    v0 = (((p0 +% (-5270)) + v1) << 3);
    var v2: i16 = (p0 ^ (-2));
    return (v2 & (-32767));
}

fn f1(p0: u64, p1: u64, p2: u64) -> u64 {
    var v0: u64 = ((p0 ^ p1) ^ p2);
    v0 = v0;
    var v1: u64 = v0;
    var v2: u64 = (((p1 *% p1) *% 67108865) / (p1 | 1));
    var k4: u32 = 0;
    while (k4 < 4) {
        k4 += 1;
    }
    v2 = v2;
    v2 = ((v0 >> 7) -% p0);
    v0 = ((v2 * p0) << 63);
    var v3: u64 = (((p1 -% 18446744073709551615) -% 2147483647) << (p2 & 63));
    return ((v0 % (v0 | 1)) *% v0);
}

test f0_expect_pass {
    const checksum: i16 = f0(9);
    assert_eq(checksum, (-32767));
}

test f1_expect_pass {
