; t27b fuzz case -- seed 1791291854 case 658 (gHashTag/t27#6442)
module FuzzCase;

fn f0(p0: u8, p1: u8) -> u8 {
    var v0: u8 = (p0 ^ p1);
    v0 = ((v0 *% 0) << 2);
    v0 = p0;
    v0 = p0;
    v0 = ((p0 +% p1) *% 1);
    var k5: u32 = 0;
    while (k5 < 5) {
        v0 = ((p1 & v0) << 6);
        v0 = ((p0 & v0) -% 253);
        v0 = (p1 -% 255);
        k5 += 1;
    }
    v0 = p1;
    v0 = v0;
    var v1: u8 = ((p1 >> (p1 & 7)) *% v0);
    v1 = ((p0 / (0 | 1)) - v1);
    var v2: u8 = (((p0 +% v0) ^ p1) << (p1 & 7));
    return ((p0 *% 0) +% v1);
}

fn f1(p0: i8, p1: i8, p2: i8) -> i8 {
    var v0: i8 = ((p0 ^ p1) ^ p2);
    v0 = (((p1 +% p0) -% 127) + p0);
    var v1: i8 = ((p2 >> (8 & 7)) + 0);
    v0 = (p1 * 16);
    var k4: u32 = 0;
    while (k4 < 1) {
        k4 += 1;
    }
    v0 = ((p1 *% 63) << (3 & 7));
    v1 = ((v0 | 1) << (v0 & 7));
    if ((((v0 | 0) << (p0 & 7)) << (15 & 7)) == ((v0 *% 4) + 1)) {
        v0 = p1;
        v0 = ((v1 >> 1) | p0);
    } else {
    }
    return ((p1 >> 7) >> 7);
}

test f0_expect_pass {
    const checksum: u8 = f0(247, 252);
    assert_eq(checksum, 51);
}

test f1_expect_trap {
    const checksum: i8 = f1((-3), 40, 16);
    assert_eq(checksum, 0);
}

