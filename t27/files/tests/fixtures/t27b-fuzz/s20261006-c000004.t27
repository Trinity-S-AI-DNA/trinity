; t27b fuzz case -- seed 20261006 case 4 (gHashTag/t27#6442)
module FuzzCase;

fn f0(p0: i8) -> i8 {
    var v0: i8 = p0;
    var v1: i8 = (v0 - v0);
    v0 = ((v0 *% p0) ^ v1);
    v0 = (((p0 << 6) << 6) & 31);
    v1 = v1;
    v1 = v0;
    v0 = p0;
    v1 = v0;
    var k8: u32 = 0;
    while (k8 < 8) {
        if (((v1 << (v0 & 7)) ^ (-27)) <= v0) {
        } else {
            v0 = (((p0 << 1) ^ (-127 - 1)) *% (-127 - 1));
        }
        if (((v1 << (v1 & 7)) | v0) > v0) {
        } else {
            v0 = p0;
        }
        k8 += 1;
    }
    return (v0 - v0);
}

test f0_expect_pass {
    const checksum: i8 = f0(0);
    assert_eq(checksum, 0);
}

