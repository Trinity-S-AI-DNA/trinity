// tri.zig a Trinity T27 CLI Runtime
// phi^2 + 1/phi^2 = 3 | TRINITY

const std = @import("std");

// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
// AST Types (simplified for CLI runtime)
// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

// The AST namespace (`const AST = struct { const Program = struct {...}; ... }`)
// is flattened: t27 drops declarations nested inside a struct body, so each
// type is declared at top level with an `Ast` prefix (AST.Program is
// AstProgram, AST.TestCase is AstTestCase, and so on). An empty-slice field
// default `&[0]T{}` is written `&.{}` (t27 lowers `[0]T{}` to `.{ 0 }`, and
// a bare `[]` to `.{}`, which Zig rejects for a slice). Inside a struct
// literal (`.errors = []` in parseSimple) the empty slice is written `[]`,
// which lowers there to a typed empty slice.
// C and Rust have no field defaults, so those backends omit them.

const AstProgram = struct {
    constants: []AstConst = &.{},
    spec_decl: ?AstSpecDecl = null,
    test_section: ?AstTestSection = null,
    invariant_section: ?AstInvariantSection = null,
};

const AstConst = struct {
    name: []const u8,
    value: f64,
};

const AstSpecDecl = struct {
    name: []const u8,
    test_blocks: []AstTestBlock = &.{},
    invariants: []AstInvariantBlock = &.{},
};

const AstTestBlock = struct {
    name: []const u8,
    clauses: []AstClause = &.{},
};

const AstInvariantBlock = struct {
    name: []const u8,
    expression: []const u8,
};

const AstTestSection = struct {
    test_cases: []AstTestCase = &.{},
};

const AstInvariantSection = struct {
    invariants: []AstInvariant = &.{},
};

const AstTestCase = struct {
    name: []const u8,
    verify: []const u8 = "",
    setup: []const u8 = "",
    expected_value: []const u8 = "",
};

const AstInvariant = struct {
    name: []const u8,
    statement: []const u8 = "",
    rationale: []const u8 = "",
};

const AstClause = struct {
    kind: AstClauseKind,
    content: []const u8,
};

const AstClauseKind = enum {
    given,
    when,
    then,
    and,
    assert,
    expect,
};

// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
// Parse Context
// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

// ParseContext.Error is declared at top level as ParseContextError (a
// declaration nested in a struct body is dropped by t27).
const ParseContextError = struct {
    line: usize,
    column: usize,
    message: []const u8,
};

const ParseContext = struct {
    ast_root: AstProgram,
    errors: []ParseContextError = &.{},
};

// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
// CLI Entry Point
// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

pub fn main() !void {
    // `GeneralPurposeAllocator(.{}){}` lost its trailing `{}` initializer in
    // every backend, leaving the type instead of a value; the type is named
    // first and then initialized, which lowers intact.
    const Gpa = std.heap.GeneralPurposeAllocator(.{});
    var gpa = Gpa{};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    // Parse command line arguments
    const args = try std.process.argsAlloc(allocator);
    defer allocator.free(args);

    if (args.len < 2) {
        try printUsage();
        return;
    }

    const command = args[1];

    // Route to command handler
    // (Open-ended slices `args[n..]` are written with their explicit end.)
    if (std.mem.eql(u8, command, "spec")) {
        try runSpecCommand(allocator, args[2..args.len]);
    } else if (std.mem.eql(u8, command, "gen")) {
        try runGenCommand(allocator, args[2..args.len]);
    } else if (std.mem.eql(u8, command, "git")) {
        try runGitCommand(allocator, args[2..args.len]);
    } else if (std.mem.eql(u8, command, "lint")) {
        try runLintCommand(allocator, args[2..args.len]);
    } else if (std.mem.eql(u8, command, "help")) {
        try printUsage();
    } else {
        std.debug.print("Unknown command: {s}\n", .{command});
        try printUsage();
        std.process.exit(1);
    }
}

// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
// Command Handlers
// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

// Argument lists are typed `[]const string`, i.e. `[]const []const u8`: the
// t27 type grammar reads one `[]const` prefix before the element name, so the
// inner `[]const u8` is written with its t27 name `string`.
fn runSpecCommand(allocator: std.mem.Allocator, args: []const string) !void {
    if (args.len == 0) {
        try printError("spec command requires subcommand: create, validate, list\n");
        return;
    }

    const subcommand = args[0];

    if (std.mem.eql(u8, subcommand, "create")) {
        if (args.len < 2) {
            try printError("tri spec create <name> [--path <path>]\n");
            return;
        }
        const name = args[1];
        const path = if (args.len >= 4 and std.mem.eql(u8, args[2], "--path"))
            args[3]
        else
            "";

        try specCreate(allocator, name, path);
    } else if (std.mem.eql(u8, subcommand, "validate")) {
        if (args.len < 2) {
            try printError("tri spec validate <spec-path>\n");
            return;
        }
        try specValidate(allocator, args[1]);
    } else if (std.mem.eql(u8, subcommand, "list")) {
        try specList(allocator);
    } else {
        try printErrorFmt("Unknown spec subcommand: {s}\n", .{subcommand});
    }
}

fn runGenCommand(allocator: std.mem.Allocator, args: []const string) !void {
    const options = try parseGenOptions(allocator, args);

    if (options.all) {
        try genAll(allocator, options);
    } else if (options.spec_path != null) {
        // `else if (opt) |spec|`: t27 drops if-payload captures, so the
        // optional is tested against null and unwrapped with `.?` explicitly.
        const spec = options.spec_path.?;
        try gen(allocator, spec, options);
    } else {
        try printError("tri gen <spec> | --all\n");
    }
}

fn runGitCommand(allocator: std.mem.Allocator, args: []const string) !void {
    if (args.len == 0) {
        try printError("git command requires subcommand: commit, push, status\n");
        return;
    }

    const subcommand = args[0];

    // (Open-ended slices `args[1..]` are written with their explicit end.)
    if (std.mem.eql(u8, subcommand, "commit")) {
        try gitCommit(allocator, args[1..args.len]);
    } else if (std.mem.eql(u8, subcommand, "push")) {
        try gitPush(allocator, args[1..args.len]);
    } else if (std.mem.eql(u8, subcommand, "status")) {
        try gitStatusWithCell(allocator);
    } else {
        try printErrorFmt("Unknown git subcommand: {s}\n", .{subcommand});
    }
}

fn runLintCommand(allocator: std.mem.Allocator, args: []const string) !void {
    const all = args.len > 0 and std.mem.eql(u8, args[0], "--all");

    if (all) {
        try lintAll(allocator);
    } else if (args.len == 1) {
        try lintFile(allocator, args[0]);
    } else {
        try lintAll(allocator);
    }
}

// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
// Spec Commands
// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

fn specCreate(allocator: std.mem.Allocator, name: []const u8, path: []const u8) !void {
    // Validate spec name
    if (!isValidSpecName(name)) {
        try printErrorFmt("Invalid spec name: {s}\n", .{name});
        try printError("Spec names must be lowercase alphanumeric with underscores\n");
        return error.InvalidSpecName;
    }

    // Determine output path
    const output_path = if (path.len == 0)
        try std.fmt.allocPrint(allocator, "specs/{s}.t27", .{name})
    else
        try allocator.dupe(u8, path);

    // Check if file exists
    if (fileExists(output_path)) {
        try printErrorFmt("Spec already exists: {s}\n", .{output_path});
        try printError("Use --force to overwrite (not implemented yet)\n");
        return error.FileExists;
    }

    // Create spec with TDD template
    const content = generateSpecTemplate(allocator, name);
    try std.fs.cwd().writeFile(output_path, content);

    std.debug.print("Created spec: {s}\n", .{output_path});
    try std.io.getStdOut().writeAll(
        "Next steps:\n  1. Add constants, functions to your spec\n  2. Add test cases using 'test <name>' blocks\n  3. Add invariants using 'invariant <name>' blocks\n  4. Run 'tri gen {s}.t27' to generate code\n  5. Run 'tri test' to execute tests"
    , .{name});
}

fn specValidate(allocator: std.mem.Allocator, spec_path: []const u8) !void {
    if (!fileExists(spec_path)) {
        try printErrorFmt("Spec not found: {s}\n", .{spec_path});
        return error.FileNotFound;
    }

    const content = try std.fs.cwd().readFileAlloc(allocator, spec_path, 1024 * 1024);
    defer allocator.free(content);

    // Simple parser (placeholder - would use real parser)
    const context = parseSimple(content, spec_path);

    if (context.errors.len > 0) {
        try printErrorFmt("Parse errors in {s}:\n", .{spec_path});
        for (context.errors) |err| {
            try std.io.getStdErr().writer().print(
                "  Line {d}:{d}: {s}\n",
                .{ err.line, err.column, err.message },
            );
        }
        return error.ParseError;
    }

    // Validate TDD compliance
    const tdd_errors = try validateTDDCompliance(allocator, &context.ast_root);

    if (tdd_errors.items.len > 0) {
        try printErrorFmt("TDD compliance violations in {s}:\n", .{spec_path});
        for (tdd_errors.items) |err| {
            try std.io.getStdErr().writer().print("  {s}\n", .{err});
        }
        tdd_errors.deinit();
        return error.TDDViolation;
    }
    tdd_errors.deinit();

    std.debug.print("Spec {s} is TDD compliant\n\n", .{spec_path});

    // Print summary
    try printSummary(&context.ast_root);
}

fn specList(allocator: std.mem.Allocator) !void {
    const spec_dir = "specs";
    // `openDir(...) catch |err| { ... }`: t27 has no `catch`. The open result
    // is kept, its FileNotFound case is tested with `==`, and `try` unwraps it
    // (any other error propagates, as `return err` did).
    const dir_open = std.fs.cwd().openDir(spec_dir);
    if (dir_open == error.FileNotFound) {
        try std.io.getStdOut().writeAll("No specs directory found\n");
        return;
    }
    var dir = try dir_open;
    defer dir.close();

    // `[]const u8` cannot stand in expression position in t27; `string`
    // is t27's name for the same byte-slice type.
    var spec_files = std.ArrayList(string).init(allocator);
    // `defer { free each item; deinit }` as two defers: they run last-in
    // first-out, so the items are freed before the list is deinitialised.
    defer spec_files.deinit();
    defer for (spec_files.items) |f| {
        allocator.free(f);
    }

    var walker = try dir.walk(allocator);
    defer walker.deinit();

    // `while (try walker.next()) |entry|`: t27's while has no payload
    // capture, so the optional is unwrapped explicitly and null ends the loop.
    while (true) {
        const next_entry = try walker.next();
        if (next_entry == null) break;
        const entry = next_entry.?;
        if (entry.kind == .file and std.mem.endsWith(u8, entry.path, ".t27")) {
            const path = try std.fmt.allocPrint(allocator, "{s}/{s}", .{ spec_dir, entry.path });
            try spec_files.append(path);
        }
    }

    if (spec_files.items.len == 0) {
        try std.io.getStdOut().writeAll("No spec files found\n");
        return;
    }

    try std.io.getStdOut().writeAll("Spec files in project:\n\n");

    for (spec_files.items) |spec_path| {
        defer allocator.free(spec_path);

        // Open-ended slice written with its explicit end.
        const rel_path = spec_path["specs/".len..spec_path.len];
        const content = try std.fs.cwd().readFileAlloc(allocator, spec_path, 1024 * 1024);
        defer allocator.free(content);

        // Quick check for tests
        const has_tests = std.mem.indexOf(u8, content, ".test") != null or
                         std.mem.indexOf(u8, content, "test ") != null;

        const status = if (has_tests) "a" else "a";
        try std.io.getStdOut().writer().print("  {s} {s}\n", .{ status, rel_path });
    }
}

// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
// Gen Commands
// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

const GenOptions = struct {
    backend: []const u8 = "zig",
    output_dir: []const u8 = "",
    emit_tests: bool = true,
    emit_conformance: bool = true,
    optimize_level: u8 = 0,
    no_prototype: bool = true,
    all: bool = false,
    spec_path: ?[]const u8 = null,
};

fn parseGenOptions(allocator: std.mem.Allocator, args: []const string) !GenOptions {
    _ = allocator;
    var options = GenOptions{};

    var i: usize = 0;
    while (i < args.len) : (i += 1) {
        const arg = args[i];

        if (std.mem.eql(u8, arg, "--backend")) {
            if (i + 1 < args.len) {
                options.backend = args[i + 1];
                i += 1;
            }
        } else if (std.mem.eql(u8, arg, "--output-dir")) {
            if (i + 1 < args.len) {
                options.output_dir = args[i + 1];
                i += 1;
            }
        } else if (std.mem.eql(u8, arg, "--no-tests")) {
            options.emit_tests = false;
        } else if (std.mem.eql(u8, arg, "--no-conformance")) {
            options.emit_conformance = false;
        } else if (std.mem.eql(u8, arg, "--all")) {
            options.all = true;
        } else if (!std.mem.startsWith(u8, arg, "-")) {
            options.spec_path = arg;
        }
    }

    return options;
}

fn gen(allocator: std.mem.Allocator, spec_path: []const u8, options: GenOptions) !void {
    // Check if spec exists
    if (!fileExists(spec_path)) {
        try printErrorFmt("Spec not found: {s}\n", .{spec_path});
        return error.FileNotFound;
    }

    const content = try std.fs.cwd().readFileAlloc(allocator, spec_path, 1024 * 1024);
    defer allocator.free(content);

    // Validate language policy (no Cyrillic)
    if (!validateNoCyrillic(content, spec_path)) {
        try printErrorFmt("Language policy violation: {s} contains Cyrillic\n", .{spec_path});
        return error.LanguagePolicyViolation;
    }

    // Parse spec
    const context = parseSimple(content, spec_path);

    if (context.errors.len > 0) {
        try printErrorFmt("Parse errors in {s}:\n", .{spec_path});
        for (context.errors) |err| {
            try std.io.getStdErr().writer().print(
                "  Line {d}:{d}: {s}\n",
                .{ err.line, err.column, err.message },
            );
        }
        return error.ParseError;
    }

    // TDD compliance check
    const has_tests = hasTestsOrInvariants(&context.ast_root);

    if (!has_tests) {
        try printError("TDD contract violated: no tests in spec\n\n");
        try std.io.getStdErr().writeAll(
            "The t27 project follows Test-Driven Development where:\n  1. Every spec MUST have at least one 'test' or 'invariant' block\n  2. Tests are written BEFORE or WITH the implementation\n  3. Conformance JSON is generated FROM tests, not hand-written\n\nTo fix this error:\n  1. Add a .test section with test cases to your spec\n  2. Or add a .invariant section with invariant declarations\n  3. Or use the high-level TDD syntax with 'test' and 'invariant' blocks\n\nExample:\n  .test\n      ; my_test\n      ; Verify: functionality works\n      ; Expected: correct result\n\n  .invariant\n      ; my_invariant\n      ; For all valid inputs: output is valid\n\nNOTE: There is NO --allow-no-tests flag (prototype mode is disabled per policy)"
        );
        return error.TDDViolation;
    }

    std.debug.print("TDD contract validated\n", .{});

    // Generate implementation code
    const impl_output = try generateImplementation(allocator, spec_path, &context.ast_root, options);
    defer allocator.free(impl_output);

    // Generate test code
    const test_output = if (options.emit_tests)
        try generateTests(allocator, &context.ast_root, options)
    else
        try allocator.dupe(u8, "");
    defer if (options.emit_tests) allocator.free(test_output);

    // Generate conformance JSON
    const conf_output = if (options.emit_conformance)
        try generateConformance(allocator, &context.ast_root)
    else
        try allocator.dupe(u8, "");
    defer if (options.emit_conformance) allocator.free(conf_output);

    std.debug.print("Code generation complete!\n", .{});
}

fn genAll(allocator: std.mem.Allocator, options: GenOptions) !void {
    const spec_files = try globSpecs(allocator);
    // `defer { free each item; deinit }` as two last-in-first-out defers.
    defer spec_files.deinit();
    defer for (spec_files.items) |f| {
        allocator.free(f);
    }

    if (spec_files.items.len == 0) {
        try std.io.getStdOut().writeAll("No spec files found\n");
        return;
    }

    std.debug.print("Found {d} spec file(s)\n\n", .{spec_files.items.len});

    var success_count: usize = 0;
    var fail_count: usize = 0;

    for (spec_files.items) |spec_path| {
        std.debug.print("Generating: {s}\n", .{spec_path});
        const result = gen(allocator, spec_path, options);

        // `if (result) |_| {...} else |_| {...}`: t27 has no `catch` and drops
        // if-payload captures (the test would lower to a bare `if (result)`),
        // so success is tested with Zig's `std.meta.isError`, which is true
        // exactly when the error union holds an error. Both captures were
        // `_`, so no value is lost.
        if (!std.meta.isError(result)) {
            success_count += 1;
        } else {
            fail_count += 1;
            try std.io.getStdErr().writer().print("  Failed: {s}\n", .{spec_path});
        }
    }

    try std.io.getStdOut().writer().print(
        "\nGeneration complete:\n  Success: {d}\n  Failed: {d}\n",
        .{ success_count, fail_count },
    );

    if (fail_count > 0) {
        return error.GenerationFailed;
    }
}

// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
// Git Commands
// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

fn gitCommit(allocator: std.mem.Allocator, args: []const string) !void {
    _ = allocator;
    var message: []const u8 = "";
    var all = false;
    var mode: []const u8 = "strict";

    var i: usize = 0;
    while (i < args.len) : (i += 1) {
        const arg = args[i];
        if (std.mem.eql(u8, arg, "--all") or std.mem.eql(u8, arg, "-a")) {
            all = true;
        } else if (std.mem.eql(u8, arg, "-m")) {
            if (i + 1 < args.len) {
                message = args[i + 1];
                i += 1;
            }
        } else if (std.mem.eql(u8, arg, "--mode")) {
            if (i + 1 < args.len) {
                mode = args[i + 1];
                i += 1;
            }
        }
    }

    // TODO: Implement full git commit with cell validation
    // For now, delegate to git
    // Array literals of byte strings are written `[_]string{...}`: an array
    // literal's element type must be a single name in t27, and `string` is
    // t27's name for `[]const u8`.
    // The argv was
    //   {"git", "commit"} ++ if (all) {"--all"} else {} ++
    //       if (message.len > 0) {"-m", message} else {}
    // t27 has no `++` on arrays, so the resulting argv is spelled out per
    // case. Zig's `if` expression takes everything after `else` as its else
    // branch, so the original parses as
    //   {"git", "commit"} ++ (if (all) {"--all"} else ({} ++ if (msg) ...))
    // and gives `git commit --all` WITHOUT `-m` when --all is set. That
    // literal behaviour is reproduced here.
    // TODO: the usage text (`git commit [--all] [-m "msg"]`) suggests --all
    // and -m were meant to combine; fixing that is a behaviour change and is
    // left to the owner of this file.
    if (all) {
        try runGitDirect(&[_]string{ "git", "commit", "--all" });
    } else if (message.len > 0) {
        try runGitDirect(&[_]string{ "git", "commit", "-m", message });
    } else {
        try runGitDirect(&[_]string{ "git", "commit" });
    }
    std.debug.print("Mode: {s}\n", .{mode});
}

fn gitPush(allocator: std.mem.Allocator, args: []const string) !void {
    _ = allocator;
    var remote: []const u8 = "origin";
    var branch: []const u8 = "";
    var mode: []const u8 = "strict";

    var i: usize = 0;
    while (i < args.len) : (i += 1) {
        const arg = args[i];
        if (std.mem.eql(u8, arg, "--mode")) {
            if (i + 1 < args.len) {
                mode = args[i + 1];
                i += 1;
            }
        } else if (!std.mem.startsWith(u8, arg, "-")) {
            if (remote.len == 0) {
                remote = arg;
            } else if (branch.len == 0) {
                branch = arg;
            }
        }
    }

    // TODO: Implement full git push with cell validation
    const branch_arg = if (branch.len > 0) branch else "HEAD";
    // (`[_]string{...}` is `[_][]const u8{...}`; see gitCommit.)
    const git_argv = &[_]string{ "git", "push", remote, branch_arg };

    try runGitDirect(git_argv);
    std.debug.print("Mode: {s}\n", .{mode});
}

fn gitStatusWithCell(allocator: std.mem.Allocator) !void {
    _ = allocator;

    // Show git status
    // (`[_]string{...}` is `[_][]const u8{...}`; see gitCommit.)
    try runGitDirect(&[_]string{ "git", "status", "--porcelain" });

    // TODO: Show cell info if registry exists
    const registry_path = ".trinity/cells/registry.json";
    if (fileExists(registry_path)) {
        std.debug.print("\nCell info: TODO - implement\n", .{});
    }
}

// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
// Lint Commands
// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

fn lintFile(allocator: std.mem.Allocator, file_path: []const u8) !void {
    if (!fileExists(file_path)) {
        try printErrorFmt("File not found: {s}\n", .{file_path});
        return error.FileNotFound;
    }

    const content = try std.fs.cwd().readFileAlloc(allocator, file_path, 1024 * 1024);
    defer allocator.free(content);

    var errors: usize = 0;

    // Check 1: Language policy (no Cyrillic)
    if (!validateNoCyrillic(content, file_path)) {
        try printErrorFmt("a Language policy: contains Cyrillic\n", .{});
        errors += 1;
    } else {
        std.debug.print("a Language policy: ASCII-only\n", .{});
    }

    // Check 2: TDD compliance (if .t27 file)
    if (std.mem.endsWith(u8, file_path, ".t27")) {
        const context = parseSimple(content, file_path);

        if (context.errors.len > 0) {
            try printErrorFmt("a Parse errors: {d}\n", .{context.errors.len});
            errors += context.errors.len;
        } else {
            std.debug.print("a Parse: OK\n", .{});
        }

        if (!hasTestsOrInvariants(&context.ast_root)) {
            try printErrorFmt("a TDD contract: no tests or invariants\n", .{});
            errors += 1;
        } else {
            std.debug.print("a TDD contract: has tests/invariants\n", .{});
        }
    }

    if (errors == 0) {
        std.debug.print("\na {s} is compliant\n", .{file_path});
    } else {
        std.debug.print("\na {s} has {d} violation(s)\n", .{ file_path, errors });
        return error.LintFailed;
    }
}

fn lintAll(allocator: std.mem.Allocator) !void {
    const files = try globSourceFiles(allocator);
    // `defer { free each item; deinit }` as two last-in-first-out defers.
    defer files.deinit();
    defer for (files.items) |f| {
        allocator.free(f);
    }

    if (files.items.len == 0) {
        try std.io.getStdOut().writeAll("No source files found\n");
        return;
    }

    std.debug.print("Linting {d} file(s)...\n\n", .{files.items.len});

    var errors: usize = 0;

    for (files.items) |file| {
        // `if (lintFile(...)) |_| {} else |_| { errors += 1; }`: t27 has no
        // `catch` and drops if-payload captures, so the failure is tested
        // with Zig's `std.meta.isError` (true when the error union holds an
        // error). Both captures were `_`; the empty success branch is kept.
        if (!std.meta.isError(lintFile(allocator, file))) {} else {
            errors += 1;
        }
    }

    if (errors == 0) {
        std.debug.print("\na All files are compliant\n", .{});
    } else {
        try std.io.getStdErr().writer().print("\na {d} file(s) have violations\n", .{errors});
        return error.LintFailed;
    }
}

// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
// Helper Functions
// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

fn printUsage() !void {
    try std.io.getStdOut().writeAll(
        "tri - Trinity T27 CLI\n\nUsage:\n  tri <command> [arguments]\n\nCommands:\n  spec create <name> [--path <path>]    Create a new spec with TDD template\n  spec validate <spec>                  Validate spec for TDD compliance\n  spec list                             List all specs in project\n\n  gen <spec>                            Generate code from spec\n    [--backend <zig|c|verilog>]       Target backend (default: zig)\n    [--output-dir <dir>]                Output directory\n    [--no-tests]                        Skip test generation\n    [--no-conformance]                  Skip conformance JSON\n  gen --all                             Generate code for all specs\n\n  git commit [--all] [-m \"msg\"]         Commit with cell validation\n    [--mode strict|normal|local]       Commit mode (default: strict)\n  git push [remote] [branch] [--mode ...] Push with cell validation\n  git status                             Show git status with cell info\n\n  lint [file]                           Check file or all for compliance\n    --all                                Check all source files\n\n  help                                  Show this help message\n\nEnvironment Variables:\n  TRI_BACKEND                           Default backend for gen (default: zig)\n  TRI_OUTPUT_DIR                         Default output directory\n\nSOUL.md Constitutional Laws:\n  Law #1: Source files MUST NOT contain Cyrillic (docs may)\n  Law #2: Every spec MUST have tests or invariants (no prototype mode)\n\nFor more information, see:\n  docs/SOUL.md - Constitutional laws\n  docs/TDD-CONTRACT.md - TDD contract details\n  docs/TRI_SYNTAX_VNEXT.md - Language syntax"
    );
}

// KNOWN DEFECT carried over from the original: 14 call sites pass a format
// string plus an argument tuple to this one-parameter function (they read
// like printErrorFmt calls). They are left as written, not redirected, so
// the translation does not change which function is called.
fn printError(msg: []const u8) !void {
    try std.io.getStdErr().writer().print("{s}\n", .{msg});
}

// `comptime fmt`: t27 parameters have no comptime qualifier, so `fmt` is an
// ordinary parameter here.
fn printErrorFmt(fmt: []const u8, args: anytype) !void {
    const writer = std.io.getStdErr().writer();
    try writer.print(fmt, args);
    try writer.writeByte('\n');
}

fn fileExists(path: []const u8) bool {
    // `openFile(...) catch |err| { ... }`: t27 has no `catch`, so the open
    // result is compared with the error it was matched against. Only
    // FileNotFound means "absent"; success and every other error count as
    // present, exactly as before.
    const opened = std.fs.cwd().openFile(path, .{});
    if (opened == error.FileNotFound) return false;
    return true;
}

fn isValidSpecName(name: []const u8) bool {
    if (name.len == 0) return false;

    // Must start with lowercase letter
    const first = name[0];
    if (first < 'a' or first > 'z') return false;

    // Only alphanumeric and underscores allowed
    for (name) |c| {
        if ((c >= 'a' and c <= 'z') or (c >= '0' and c <= '9') or c == '_') {
            continue;
        }
        return false;
    }

    return true;
}

fn generateSpecTemplate(allocator: std.mem.Allocator, name: []const u8) ![]const u8 {
    return std.fmt.allocPrint(allocator,
        "; {s}.t27 a Specification for {s}\n; phi^2 + 1/phi^2 = 3 | TRINITY\n\n; This file is the source of truth for {s}.\n; Generated code is a derived artifact - DO NOT EDIT generated files.\n;\n; TDD Contract: This spec MUST include at least one test or invariant.\n\nuse base::types\n\n; aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n; Constants\n; aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n\n; Example constant\nconst EXAMPLE_CONSTANT = 42\n\n; aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n; Data Section\n; aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n\n.data\n    .const DATA_INIT 0\n\n; aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n; Code Section\n; aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n\n.code\nmain:\n    ; Your code here\n    HALT\n\n; aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n; TDD-Inside-Spec: Tests and Invariants\n; aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n\n.test\n    ; example_test\n    ; Verify: example functionality works correctly\n    ; Setup: initialize with EXAMPLE_CONSTANT\n    ; Expected: returns expected value\n\n.invariant\n    ; example_invariant\n    ; For all valid inputs: output is in valid range\n    ; Rationale: Ensures function correctness\n\n.bench\n    ; example_benchmark\n    ; Measure: operations per second\n    ; Target: > 1M ops/sec"
    , .{name, name, name, name});
}

fn validateNoCyrillic(content: []const u8, file_path: []const u8) bool {
    // Check if file is in docs/ directory (Cyrillic allowed)
    if (std.mem.indexOf(u8, file_path, "/docs/") != null or
        std.mem.startsWith(u8, file_path, "docs/")) {
        return true;
    }

    // Scan for Cyrillic characters (U+0400aU+04FF)
    var i: usize = 0;
    while (i < content.len) : (i += 1) {
        const c = content[i];

        // Check for 2-byte UTF-8 Cyrillic starting with 0xD0-0xD4
        if (c >= 0xD0 and c <= 0xD4) {
            if (i + 1 < content.len) {
                const next_c = content[i + 1];
                const codepoint = (@as(u16, c) << 8) | next_c;
                // Cyrillic block: U+0400aU+04FF
                if (codepoint >= 0x0400 and codepoint <= 0x04FF) {
                    return false;
                }
            }
        }
    }

    return true;
}

fn hasTestsOrInvariants(ast_root: *const AstProgram) bool {
    // Check test_section
    // `if (opt) |test_section|`: t27 drops if-payload captures, so the optional
    // is tested against null and unwrapped with `.?` explicitly.
    if (ast_root.test_section != null) {
        const test_section = ast_root.test_section.?;
        if (test_section.test_cases.len > 0) return true;
    }

    // Check invariant_section
    // `if (opt) |inv_section|`: t27 drops if-payload captures, so the optional
    // is tested against null and unwrapped with `.?` explicitly.
    if (ast_root.invariant_section != null) {
        const inv_section = ast_root.invariant_section.?;
        if (inv_section.invariants.len > 0) return true;
    }

    // Check spec_decl (high-level TDD)
    // `if (opt) |spec_decl|`: t27 drops if-payload captures, so the optional
    // is tested against null and unwrapped with `.?` explicitly.
    if (ast_root.spec_decl != null) {
        const spec_decl = ast_root.spec_decl.?;
        if (spec_decl.test_blocks.len > 0) return true;
        if (spec_decl.invariants.len > 0) return true;
    }

    return false;
}

fn validateTDDCompliance(allocator: std.mem.Allocator, ast_root: *const AstProgram) !std.ArrayList([]const u8) {
    // `[]const u8` cannot stand in expression position in t27; `string`
    // is t27's name for the same byte-slice type.
    var errors = std.ArrayList(string).init(allocator);

    if (!hasTestsOrInvariants(ast_root)) {
        try errors.append(try allocator.dupe(u8, "TDD contract violated: spec must contain at least one 'test' or 'invariant' block"));
    }

    return errors;
}

fn printSummary(ast_root: *const AstProgram) !void {
    try std.io.getStdOut().writer().print(
        "Summary:\n  Constants: {d}"
    , .{ast_root.constants.len});

    // `if (opt) |spec|`: t27 drops if-payload captures, so the optional
    // is tested against null and unwrapped with `.?` explicitly.
    if (ast_root.spec_decl != null) {
        const spec = ast_root.spec_decl.?;
        try std.io.getStdOut().writer().print(
            "  Tests (spec-style): {d}\n  Invariants (spec-style): {d}"
        , .{ spec.test_blocks.len, spec.invariants.len });
    }

    // The capture was named `test`, a t27 keyword; it is `test_sec` here.
    // `if (opt) |test|`: t27 drops if-payload captures, so the optional
    // is tested against null and unwrapped with `.?` explicitly.
    if (ast_root.test_section != null) {
        const test_sec = ast_root.test_section.?;
        try std.io.getStdOut().writer().print(
            "  Tests (assembly-style): {d}"
        , .{test_sec.test_cases.len});
    }

    // `if (opt) |inv|`: t27 drops if-payload captures, so the optional
    // is tested against null and unwrapped with `.?` explicitly.
    if (ast_root.invariant_section != null) {
        const inv = ast_root.invariant_section.?;
        try std.io.getStdOut().writer().print(
            "  Invariants (assembly-style): {d}"
        , .{inv.invariants.len});
    }

    try std.io.getStdOut().writeByte('\n');
}

// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
// Simple Parser (placeholder - would use real parser.t27)
// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

fn parseSimple(content: []const u8, file_path: []const u8) ParseContext {
    _ = file_path;

    var program = AstProgram{};

    // Simple line-by-line parsing for .test and .invariant sections
    var lines = std.mem.splitScalar(u8, content, '\n');
    var in_test = false;
    var in_invariant = false;
    var test_cases = std.ArrayList(AstTestCase).init(std.heap.page_allocator);
    var invariants = std.ArrayList(AstInvariant).init(std.heap.page_allocator);

    // `while (lines.next()) |line|`: the optional is unwrapped explicitly and
    // null ends the loop (t27's while has no payload capture).
    while (true) {
        const next_line = lines.next();
        if (next_line == null) break;
        const line = next_line.?;
        const trimmed = std.mem.trim(u8, line, " \t\r");

        if (std.mem.startsWith(u8, trimmed, ".test")) {
            in_test = true;
            in_invariant = false;
        } else if (std.mem.startsWith(u8, trimmed, ".invariant")) {
            in_invariant = true;
            in_test = false;
        } else if (std.mem.startsWith(u8, trimmed, ".") and
                  !std.mem.startsWith(u8, trimmed, ".test") and
                  !std.mem.startsWith(u8, trimmed, ".invariant") and
                  !std.mem.startsWith(u8, trimmed, ".bench")) {
            in_test = false;
            in_invariant = false;
        } else if (in_test and trimmed.len > 0 and !std.mem.startsWith(u8, trimmed, ";")) {
            // Found a test case (non-comment, non-empty)
            const name = std.mem.trim(u8, trimmed, " \t\r");
            // `append(...) catch {}` ignored an allocation failure; the result
            // is discarded with `_ =` (t27 has no `catch`).
            _ = test_cases.append(AstTestCase{
                .name = name,
                .verify = "",
                .setup = "",
                .expected = "",
            });
        } else if (in_invariant and trimmed.len > 0 and !std.mem.startsWith(u8, trimmed, ";")) {
            // Found an invariant
            const name = std.mem.trim(u8, trimmed, " \t\r");
            // `append(...) catch {}`: failure ignored, result discarded.
            _ = invariants.append(AstInvariant{
                .name = name,
                .statement = "",
                .rationale = "",
            });
        }
    }

    if (test_cases.items.len > 0) {
        program.test_section = AstTestSection{
            .test_cases = test_cases.toOwnedSlice(),
        };
    }

    if (invariants.items.len > 0) {
        program.invariant_section = AstInvariantSection{
            .invariants = invariants.toOwnedSlice(),
        };
    }

    return ParseContext{
        .ast_root = program,
        .errors = [],
    };
}

// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
// Code Generation Helpers
// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

fn generateImplementation(allocator: std.mem.Allocator, spec_path: []const u8, ast_root: *const AstProgram, options: GenOptions) ![]const u8 {
    _ = spec_path;
    _ = ast_root;
    _ = options;

    // Placeholder
    return try allocator.dupe(u8, "// Generated implementation for spec\n");
}

fn generateTests(allocator: std.mem.Allocator, ast_root: *const AstProgram, options: GenOptions) ![]const u8 {
    _ = options;

    var output = std.ArrayList(u8).init(allocator);
    defer output.deinit();

    try output.appendSlice("// Generated tests for spec\n");

    // `if (opt) |test_section|`: t27 drops if-payload captures, so the optional
    // is tested against null and unwrapped with `.?` explicitly.
    if (ast_root.test_section != null) {
        const test_section = ast_root.test_section.?;
        for (test_section.test_cases) |test_case| {
            try output.appendSlice("test \"");
            try output.appendSlice(test_case.name);
            try output.appendSlice("\" {\n");
            try output.appendSlice("    // TODO: implement test\n");
            try output.appendSlice("}\n\n");
        }
    }

    // `if (opt) |inv_section|`: t27 drops if-payload captures, so the optional
    // is tested against null and unwrapped with `.?` explicitly.
    if (ast_root.invariant_section != null) {
        const inv_section = ast_root.invariant_section.?;
        for (inv_section.invariants) |inv| {
            try output.appendSlice("// invariant: ");
            try output.appendSlice(inv.name);
            try output.appendSlice("\n");
        }
    }

    return output.toOwnedSlice();
}

fn generateConformance(allocator: std.mem.Allocator, ast_root: *const AstProgram) ![]const u8 {
    var output = std.ArrayList(u8).init(allocator);
    defer output.deinit();

    try output.appendSlice("{\n");
    try output.appendSlice("  \"description\": \"t27 conformance\",\n");
    try output.appendSlice("  \"test_vectors\": [\n");

    // `if (opt) |test_section|`: t27 drops if-payload captures, so the optional
    // is tested against null and unwrapped with `.?` explicitly.
    if (ast_root.test_section != null) {
        const test_section = ast_root.test_section.?;
        // `for (test_cases, 0..) |test_case, i|` (two iterables) as an index loop.
        var i: usize = 0;
        while (i < test_section.test_cases.len) : (i += 1) {
            const test_case = test_section.test_cases[i];
            try output.appendSlice("    {\n");
            try output.appendSlice("      \"name\": \"");
            try output.appendSlice(test_case.name);
            try output.appendSlice("\",\n");
            try output.appendSlice("      \"verify\": \"");
            try output.appendSlice(if (test_case.verify.len > 0) test_case.verify else "functionality works correctly");
            try output.appendSlice("\",\n");
            try output.appendSlice("      \"expected\": \"");
            try output.appendSlice(if (test_case.expected.len > 0) test_case.expected else "correct result");
            try output.appendSlice("\"\n");
            try output.appendSlice("    }");
            if (i < test_section.test_cases.len - 1) {
                try output.appendSlice(",");
            }
            try output.appendSlice("\n");
        }
    }

    try output.appendSlice("  ]\n");
    try output.appendSlice("}\n");

    return output.toOwnedSlice();
}

// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
// Git Helpers
// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

fn runGitDirect(argv: []const string) !void {
    // `exec(...) catch |err| { ... }`: t27 has no `catch` and drops
    // if-payload captures, so the error path is selected with Zig's
    // `std.meta.isError` (true when the error union holds an error) and the
    // error is named from the result itself (APPROXIMATION: Zig's
    // @errorName wants the bare error, which only a capture can extract).
    // `try` then unwraps the success value.
    const exec_result = std.process.Child.exec(.{
        .allocator = std.heap.page_allocator,
        .argv = argv,
    });
    if (std.meta.isError(exec_result)) {
        try printErrorFmt("Failed to execute git: {}\n", .{@errorName(exec_result)});
        return error.GitFailed;
    }
    const result = try exec_result;
    defer result.deinit();

    try std.io.getStdOut().writeAll(result.stdout);

    const term = try result.wait();
    if (term != .Exited or term.Exited != 0) {
        try std.io.getStdErr().writeAll(result.stderr);
        return error.GitFailed;
    }
}

// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
// File System Helpers
// aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

fn globSpecs(allocator: std.mem.Allocator) !std.ArrayList([]const u8) {
    // `[]const u8` cannot stand in expression position in t27; `string`
    // is t27's name for the same byte-slice type.
    var spec_files = std.ArrayList(string).init(allocator);

    // `openDir(...) catch |err| { ... }` without `catch`: FileNotFound is
    // tested with `==`; `try` propagates any other error.
    const dir_open = std.fs.cwd().openDir("specs");
    if (dir_open == error.FileNotFound) return spec_files;
    var dir = try dir_open;
    defer dir.close();

    var walker = try dir.walk(allocator);
    defer walker.deinit();

    // `while (try walker.next()) |entry|` with the optional unwrapped explicitly.
    while (true) {
        const next_entry = try walker.next();
        if (next_entry == null) break;
        const entry = next_entry.?;
        if (entry.kind == .file and std.mem.endsWith(u8, entry.path, ".t27")) {
            const path = try std.fmt.allocPrint(allocator, "specs/{s}", .{entry.path});
            try spec_files.append(path);
        }
    }

    return spec_files;
}

fn globSourceFiles(allocator: std.mem.Allocator) !std.ArrayList([]const u8) {
    // `[]const u8` cannot stand in expression position in t27; `string`
    // is t27's name for the same byte-slice type.
    var files = std.ArrayList(string).init(allocator);

    // Common source extensions
    // (`[_]string{...}` is `[_][]const u8{...}`; see gitCommit.)
    const extensions = [_]string{ ".t27", ".tri", ".zig", ".c", ".h", ".v", ".verilog" };

    // Recursively find files
    // `try walk(...) catch |err| { ... }` without `catch`: FileNotFound is
    // tested with `==`; `try` propagates any other error.
    const walk_open = std.fs.cwd().walk(allocator, .{
        .max_depth = 10,
        .skip_hidden_files = true,
    });
    if (walk_open == error.FileNotFound) return files;
    var walker = try walk_open;
    defer walker.deinit();

    // `while (try walker.next()) |entry|` with the optional unwrapped explicitly.
    while (true) {
        const next_entry = try walker.next();
        if (next_entry == null) break;
        const entry = next_entry.?;
        if (entry.kind == .file) {
            const path = entry.path;
            // Skip docs/ directory
            if (std.mem.indexOf(u8, path, "/docs/") != null) continue;
            if (std.mem.indexOf(u8, path, "docs/") == 0) continue;

            for (extensions) |ext| {
                if (std.mem.endsWith(u8, path, ext)) {
                    try files.append(try allocator.dupe(u8, path));
                    break;
                }
            }
        }
    }

    return files;
}

// =====================================================================
// TDD: Tests
// The handwritten runtime carried no test, and L4 requires one. These
// pin the pure helpers above exactly as they are written.
// =====================================================================

test "is_valid_spec_name_accepts_lowercase_snake_case" {
    assert(isValidSpecName("my_spec2"));
    assert(isValidSpecName("a"));
}

test "is_valid_spec_name_rejects_bad_names" {
    assert(!isValidSpecName(""));
    assert(!isValidSpecName("MySpec"));
    assert(!isValidSpecName("2spec"));
    assert(!isValidSpecName("my-spec"));
}

test "validate_no_cyrillic_accepts_ascii_and_docs" {
    assert(validateNoCyrillic("const X = 1;", "specs/x.t27"));
    assert(validateNoCyrillic("anything", "docs/notes.md"));
    assert(validateNoCyrillic("anything", "repo/docs/notes.md"));
}

test "has_tests_or_invariants_false_for_empty_program" {
    const program = AstProgram{};
    assert(!hasTestsOrInvariants(&program));
}

test "has_tests_or_invariants_true_with_one_test_case" {
    // Exercises the explicit `!= null` / `.?` unwrap of test_section.
    var cases = [_]AstTestCase{ AstTestCase{ .name = "t" } };
    const program = AstProgram{ .test_section = AstTestSection{ .test_cases = &cases } };
    assert(hasTestsOrInvariants(&program));
}
