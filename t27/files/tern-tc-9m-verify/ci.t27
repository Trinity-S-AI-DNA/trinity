// SPDX-License-Identifier: Apache-2.0
// specs/hf/ci.t27 -- source of truth for the public CI that checks
// the published tern-tc-9m package.
//
// This is the verify-Space idea on a runner that costs nothing: a small
// public GitHub repository whose only job is a workflow that downloads
// playra/tern-tc-9m from the Hugging Face hub and runs the package's own
// scripts/verify.sh on the downloaded bytes. The dev repository stays
// private; nothing of it is mirrored here -- the checked artifact is the
// publication itself, so a weekly run also catches hub-side changes to it.
//
// Facts restated here from specs/hf/model_card.t27 carry their source in a
// comment; the render script (scripts/ci_from_spec.mjs) compiles BOTH specs
// and refuses to render when the two disagree, so a restated fact cannot
// drift.
// ASCII only (L3), English only (LANG-EN).
// phi^2 + 1/phi^2 = 3 | TRINITY

module hf_ci;

pub const KIND : str = "github-actions-ci";
pub const ID : str = "hf/tern_tc_ci";
// where the workflow lives (public; the dev repo is private)
pub const CI_REPO : str = "gHashTag/tern-tc-9m-verify";
pub const WORKFLOW_NAME : str = "verify";
pub const WORKFLOW_PATH : str = ".github/workflows/verify.yml";
pub const RUNS_ON : str = "ubuntu-latest";
pub const TIMEOUT_MINUTES : u8 = 30;
// re-check the published bytes even when this repo is quiet
pub const CRON : str = "23 4 * * 1";

// the artifact under test (card: MODEL_URL; the hub repo id, not the URL)
pub const MODEL_REPO : str = "playra/tern-tc-9m";
// card: QUICKSTART_EXPECT -- verify.sh's last line on success
pub const VERIFY_EXPECT : str = "ALL CHECKS DONE";
// card: BOARD_IDS -- the greedy ids the C engine must reproduce (rendered
// into the README checklist; the generator drift-gates this against the card)
pub const RECEIPT_IDS : str = "1 3 204 276 405 659 85 1516";
// the package is downloaded from the hub at run time; no copy lives here
pub const NO_MIRROR : bool = true;
pub const VERIFY_STEP : str = "sh scripts/verify.sh";
// what verify.sh checks, in order -- the README checklist is rendered from
// this, so the prose lives in one place only
pub const VERIFY_STEPS : [3]str = [
    "sha256 of `c_infer/model.bin` and `results/data8k/tokenizer.json` against the values the model card states, and against the repo's `sha256sums.txt`;",
    "the C99 engine builds (`make -C c_infer`) and its greedy ids equal the FPGA board receipt (`1 3 204 276 405 659 85 1516`, Xilinx XC7A200T);",
    "the PyTorch parity harness passes on the same weights (torch is installed on the runner)."
];

// ── The published package ───────────────────────────────────────────────────
pub const FILES : [4]str = ["README.md", ".github/workflows/verify.yml", "ci.t27", "sha256sums.txt"];

test wiring {
    assert CI_REPO == "gHashTag/tern-tc-9m-verify";
    assert WORKFLOW_PATH == ".github/workflows/verify.yml";
    assert WORKFLOW_NAME == "verify";
    assert RUNS_ON == "ubuntu-latest";
}

test checks_the_published_artifact {
    assert MODEL_REPO == "playra/tern-tc-9m";
    assert VERIFY_STEP == "sh scripts/verify.sh";
    assert NO_MIRROR == true;
}

test receipt_restates_the_card {
    assert RECEIPT_IDS == "1 3 204 276 405 659 85 1516";
    assert VERIFY_STEPS[2] == "the PyTorch parity harness passes on the same weights (torch is installed on the runner).";
}

test package_is_complete {
    assert FILES[0] == "README.md";
    assert FILES[1] == ".github/workflows/verify.yml";
    assert FILES[2] == "ci.t27";
    assert FILES[3] == "sha256sums.txt";
}

test honesty_holds {
    // a quiet repo still re-checks the hub bytes
    assert CRON != "";
    assert TIMEOUT_MINUTES >= 10;
    assert TIMEOUT_MINUTES <= 60;
}
