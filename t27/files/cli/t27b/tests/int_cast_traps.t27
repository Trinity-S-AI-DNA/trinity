// SPDX-License-Identifier: Apache-2.0
; cli/t27b/tests/int_cast_traps.t27 -- `@intCast(x)` with a value outside its result type (issue #7412).
; Each test's name ends in its verdict, the way specs/tri/t27b/fuzz_oracle.t27 reads a generated test:
; `_expect_pass` passes; `_expect_trap` stops at an `@intCast` line. In Zig 0.16 Debug that stop is a safety
; panic, so `t27c test-report` fails exactly the `_expect_trap` tests; in t27b it is a Cast trap, and the
; interpreter and the JIT must agree on its site. Every assert of an `_expect_trap` test expects the
; truncated value, so a cast that truncated instead of trapping would pass it.
; cli/t27b/tests/tail.rs runs this file. It is not under specs/: its tests fail by design, and the corpus
; counts a spec with a failing test as not passing. The cases that pass are
; specs/tri/t27b/conformance/int_cast.t27; what t27b decides is specs/tri/t27b/int_cast_plan.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bIntCastTraps;

fn ict_narrow(x: u32) -> u16 {
    const r: u16 = @intCast(x);
    return r;
}

fn ict_to_i32(x: i64) -> i32 {
    return @as(i32, @intCast(x));
}

fn ict_to_u64(x: i64) -> u64 {
    return @as(u64, @intCast(x));
}

fn ict_to_i64(x: u64) -> i64 {
    return @as(i64, @intCast(x));
}

fn ict_to_u32(x: i32) -> u32 {
    const r: u32 = @intCast(x);
    return r;
}

fn ict_byte(x: u8) -> u8 {
    return x;
}

// A parameter is the result location.
fn ict_pass_byte(x: u64) -> u8 {
    return ict_byte(@intCast(x));
}

test ict_values_that_fit_expect_pass {
    assert(ict_narrow(65535) == 65535);
    assert(ict_to_i32(-2147483648) == -2147483648);
    assert(ict_to_u64(9223372036854775807) == 9223372036854775807);
    assert(ict_to_i64(9223372036854775807) == 9223372036854775807);
    assert(ict_to_u32(2147483647) == 2147483647);
    assert(ict_pass_byte(255) == 255);
}

test ict_unsigned_narrowing_expect_trap {
    assert(ict_narrow(65536) == 0);
}

test ict_signed_narrowing_below_expect_trap {
    assert(ict_to_i32(-2147483649) == 2147483647);
}

test ict_signed_narrowing_above_expect_trap {
    assert(ict_to_i32(2147483648) == -2147483648);
}

test ict_negative_to_unsigned_expect_trap {
    assert(ict_to_u64(-1) == 18446744073709551615);
}

test ict_unsigned_to_signed_too_big_expect_trap {
    assert(ict_to_i64(9223372036854775808) == -9223372036854775808);
}

test ict_negative_to_u32_expect_trap {
    assert(ict_to_u32(-1) == 4294967295);
}

test ict_through_a_parameter_expect_trap {
    assert(ict_pass_byte(256) == 0);
}
