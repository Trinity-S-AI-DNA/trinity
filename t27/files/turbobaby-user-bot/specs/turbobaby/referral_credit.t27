; --- Functions, mirroring src/trios/referral_credit.rs over integers ---------------------------------------
pub fn rental_is_valid(rental: u32) bool {
  return rental >= 1 and rental <= MAX_RENTAL_AMOUNT_THB;
}

; floor(CREDIT_PERCENT% of (rental - applied)); 0 when the rental is invalid or applied exceeds it.
pub fn credit(rental: u32, applied: u32) u32 {
  if (!rental_is_valid(rental)) {
    return 0;
  }
  if (applied > rental) {
    return 0;
  }
  return (rental - applied) * CREDIT_PERCENT / 100;
}

pub fn available(balance: i64, held: i64) i64 {
  // the hold never counts below zero, and neither does what is left
  var hold : i64 = held;
  if (hold < 0) {
    hold = 0;
  }
  if (balance - hold < 0) {
    return 0;
  }
  return balance - hold;
}

pub fn shown_balance(balance: i64) i64 {
  if (balance < 0) {
    return 0;
  }
  return balance;
}

; The least of the hold, the rental and the balance, never below zero.
pub fn applied(hold: i64, rental: i64, balance: i64) i64 {
  var least : i64 = hold;
  if (rental < least) {
    least = rental;
  }
  if (balance < least) {
    least = balance;
  }
  if (least < 0) {
    return 0;
  }
  return least;
}

; 0 when creditable, else the first refusal in the fixed order.
pub fn first_refusal(no_edge: bool, self_edge: bool, edge_after_order: bool, existing_customer: bool) u8 {
  if (no_edge) {
    return REFUSAL_NO_EDGE;
  }
  if (self_edge) {
    return REFUSAL_SELF_EDGE;
  }
  if (edge_after_order) {
    return REFUSAL_EDGE_AFTER_ORDER;
  }
  if (existing_customer) {
    return REFUSAL_EXISTING_CUSTOMER;
  }
  return 0;
}

pub fn creditable(no_edge: bool, self_edge: bool, edge_after_order: bool, existing_customer: bool) bool {
  return first_refusal(no_edge, self_edge, edge_after_order, existing_customer) == 0;
}

; A record that neither credits nor settles anything is refused and writes nothing.
pub fn record_is_admitted(is_creditable: bool, applied_thb: i64) bool {
  return is_creditable or applied_thb > 0;
}

; A record that would credit its own recorder is refused. A named recorder is compared with the
; inviter; the password token, which names nobody, with the admin list.
pub fn recorder_refused(recorder_is_named: bool, recorder_is_the_inviter: bool, inviter_is_a_listed_admin: bool) bool {
  if (recorder_is_named) {
    return recorder_is_the_inviter;
  }
  return inviter_is_a_listed_admin;
}

pub const REQUEST_OPENED : u8 = 0;
pub const REQUEST_ALREADY_OPEN : u8 = 1;
pub const REQUEST_REFUSED_OTHER_KIND_OPEN : u8 = 2;
pub const REQUEST_REFUSED_NOTHING_AVAILABLE : u8 = 3;

pub fn request_admitted(open_same: bool, open_other: bool, available_thb: i64) u8 {
  if (open_same) {
    return REQUEST_ALREADY_OPEN;
  }
  if (open_other) {
    return REQUEST_REFUSED_OTHER_KIND_OPEN;
  }
  if (available_thb < 1) {
    return REQUEST_REFUSED_NOTHING_AVAILABLE;
  }
  return REQUEST_OPENED;
}

; Paid only on an open payout, and never above the ledger.
pub fn paid_admitted(status_open: bool, is_payout: bool, balance: i64, amount: i64) bool {
  return status_open and is_payout and balance >= amount and amount > 0;
}

; Two friends' recorded rentals, for the tests below: three records of one friend (the last one
; too small to credit a whole baht), and two of another.
pub const EXAMPLE_RENTALS_OF_ONE_FRIEND : [4]u32 = [1000, 2005, 9, 0];
pub const EXAMPLE_RENTALS_OF_ANOTHER : [4]u32 = [1239, 1239, 0, 0];

; What a friend's recorded rentals earn the inviter in all, record by record.
pub fn credits_for_rentals(rentals: [4]u32, count: u8) u32 {
  var total : u32 = 0;
  var i : u8 = 0;
  while (i < count) {
    // one record, one credit: "for each rental of the friend"
    total += credit(rentals[i], 0);
    i += @as(u8, 1);
  }
  return total;
}

; --- Tests ----------------------------------------------------------------------------------------------------

test this_file_owns_its_own_identity {
  assert ID == "turbobaby/referral-credit";
  assert KIND == "contract";
  assert MEASURED_AT == "2026-09-26";
  assert OWNER_R3_DECIDED_AT == MEASURED_AT;
  assert IMPLEMENTATION_CORE == "src/trios/referral_credit.rs";
  assert MIGRATION == "migrations/089_referral_credit.sql";
}

test the_credit_rounds_down_to_whole_baht {
  assert credit(1239, 0) == 123;
  assert credit(1234, 0) == 123;
  assert credit(10, 0) == 1;
  assert credit(9, 0) == 0;
  assert credit(1000, 300) == 70;
  assert credit(1005, 5) == 100;
  assert credit(MAX_RENTAL_AMOUNT_THB, 0) == 10000000;
  assert credit(0, 0) == 0;
  assert credit(MAX_RENTAL_AMOUNT_THB + 1, 0) == 0;
  assert credit(100, 101) == 0;
  assert CREDIT_PERCENT == 10;
  assert CREDIT_ROUNDS_DOWN_TO_WHOLE_BAHT == true;
}

test the_base_is_the_managers_net_rental_charge {
  assert BASE_EXCLUDES_DEPOSIT == true;
  assert BASE_EXCLUDES_DELIVERY == true;
  assert BASE_IS_NET_OF_THE_APPLIED_REFERRAL_BALANCE == true;
  assert BASE_IS_RECORDED_BY_A_MANAGER == true;
  assert BASE_IS_COMPUTED_FROM_A_RATE == false;
  assert rental_is_valid(1) == true;
  assert rental_is_valid(MAX_RENTAL_AMOUNT_THB) == true;
  assert rental_is_valid(0) == false;
  assert rental_is_valid(MAX_RENTAL_AMOUNT_THB + 1) == false;
}

test every_recorded_rental_credits_and_only_the_inviter {
  assert CREDITED_PER_RECORDED_RENTAL == true;
  assert CREDITED_ON_FIRST_ORDER_ONLY == false;
  assert LEVELS_CREDITED == 1;
  assert FRIEND_IS_CREDITED == false;
  assert credits_for_rentals(EXAMPLE_RENTALS_OF_ONE_FRIEND, 3) == 300;
  assert credits_for_rentals(EXAMPLE_RENTALS_OF_ANOTHER, 2) == 246;
  assert credits_for_rentals(EXAMPLE_RENTALS_OF_ANOTHER, 0) == 0;
}

test the_refusals_come_in_their_fixed_order {
  assert creditable(false, false, false, false) == true;
  assert first_refusal(true, true, true, true) == REFUSAL_NO_EDGE;
  assert first_refusal(false, true, true, true) == REFUSAL_SELF_EDGE;
  assert first_refusal(false, false, true, true) == REFUSAL_EDGE_AFTER_ORDER;
  assert first_refusal(false, false, false, true) == REFUSAL_EXISTING_CUSTOMER;
  assert SELF_EDGE_IS_CREDITED == false;
  assert EDGE_AFTER_ORDER_IS_CREDITED == false;
  assert EXISTING_CUSTOMER_IS_CREDITED == false;
  assert RECORDER_MAY_BE_THE_INVITER == false;
  assert ORDER_BEFORE_PROGRAM_IS_CREDITED == false;
  assert record_is_admitted(false, 0) == false;
  assert record_is_admitted(false, 200) == true;
  assert record_is_admitted(true, 0) == true;
}

test holds_are_derived_and_never_negative {
  assert available(450, 0) == 450;
  assert available(450, 450) == 0;
  assert available(450, 200) == 250;
  assert available(-120, 0) == 0;
  assert available(100, -50) == 100;
  assert shown_balance(-120) == 0;
  assert shown_balance(450) == 450;
  assert applied(200, 1000, 250) == 200;
  assert applied(500, 300, 500) == 300;
  assert applied(500, 1000, -40) == 0;
  assert credit(1000, 200) == 80;
  assert credit(300, 300) == 0;
  assert BALANCE_IS_A_STORED_COLUMN == false;
  assert HOLD_IS_DERIVED == true;
}

test one_open_request_per_person_and_no_partial_payout {
  assert OPEN_REQUESTS_PER_PERSON_MAX == 1;
  assert request_admitted(false, false, 123) == REQUEST_OPENED;
  assert request_admitted(true, false, 0) == REQUEST_ALREADY_OPEN;
  assert request_admitted(false, true, 123) == REQUEST_REFUSED_OTHER_KIND_OPEN;
  assert request_admitted(false, false, 0) == REQUEST_REFUSED_NOTHING_AVAILABLE;
  assert PARTIAL_PAYOUT == false;
  assert paid_admitted(true, true, 123, 123) == true;
  assert paid_admitted(true, true, 0, 123) == false;
  assert paid_admitted(true, false, 123, 123) == false;
  assert paid_admitted(false, true, 123, 123) == false;
}

test the_kind_lists_are_the_migrations {
  assert LEDGER_KINDS.len == 5;
  assert LEDGER_KINDS[0] == "accrual";
  assert LEDGER_KINDS[4] == "payout";
  assert REQUEST_KINDS[0] == "payout";
  assert REQUEST_KINDS[1] == "redeem";
  assert REQUEST_STATUSES.len == 4;
  assert REQUEST_STATUSES[0] == "open";
}

test nothing_moves_money_and_the_order_is_untouched {
  assert MONEY_MOVES_AUTOMATICALLY == false;
  assert PAYOUT_IS_MADE_BY_HAND == true;
  assert ORDER_TOTAL_IS_TOUCHED == false;
  assert PROMPTPAY_AMOUNT_IS_TOUCHED == false;
  assert DEPOSIT_IS_TOUCHED == false;
  assert ZERO_TOTAL_QR_REFUSAL_UNCHANGED == true;
  assert ORDER_MONEY_PATH_MENTIONS == 0;
}

test reversal_is_whole_and_a_debt_is_never_collected {
  assert AUTOMATIC_REVERSAL_SITES == 1;
  assert REVERSAL_IS_WHOLE == true;
  assert BALANCE_MAY_GO_NEGATIVE == true;
  assert NEGATIVE_BALANCE_IS_COLLECTED == false;
  assert NEGATIVE_BALANCE_SHOWN_AS_ZERO == true;
  assert available(-123, 0) == 0;
}

test six_routes_each_behind_a_gate {
  assert ROUTE_COUNT == 6;
  assert OWNER_GATED_ROUTE_COUNT + ADMIN_GATED_ROUTE_COUNT + UNGATED_ROUTE_COUNT == ROUTE_COUNT;
  assert UNGATED_ROUTE_COUNT == 0;
  assert STRICT_GATE_SITES == 0;
  assert CUSTOMER_RESPONSE_CARRIES_ENTRIES == false;
  assert BALANCE_REVEALS_A_SINGLE_FRIENDS_SPEND == true;
}

test the_code_keeps_points_and_credit_apart {
  assert POINTS_TOKENS_IN_THE_CREDIT_MODULE == 0;
  assert CREDIT_TOKENS_IN_THE_LOYALTY_ROUTES == 0;
  assert MUTATING_STATEMENTS_IN_THE_MIGRATION == 0;
  assert FAIL_OPEN_READS == 0;
  assert LOCK_NAMESPACE == "referral_credit";
  assert LOCK_KEY_SPACE_IS_TWO_INT4 == true;
  assert PERSON_LOCKS_PER_TRANSACTION_MAX == 1;
}

test the_copy_is_the_operators_and_what_was_missing_is_listed {
  assert COPY_KEYS.len == 5;
  assert COPY_KEYS[0] == "referral.balance";
  assert COPY_KEYS[4] == "referral.subtitle";
  assert COPY_WORDED_BY == "operator 2026-09-26";
  assert COPY_NEEDED_AND_NOT_WORDED.len == 8;
}

test the_nine_reuse_edges_are_named_by_id_and_none_is_this_file {
  assert REUSE_EDGE_COUNT == 9;
  assert REUSE_EDGES[0] == REUSES_REFERRAL_PROGRAM_ID;
  assert REUSE_EDGES[1] == REUSES_LOYALTY_LEDGER_ID;
  assert REUSE_EDGES[2] == REUSES_ORDER_MONEY_ID;
  assert REUSE_EDGES[3] == REUSES_ORDER_STATUS_ID;
  assert REUSE_EDGES[4] == REUSES_COMMERCE_ID;
  assert REUSE_EDGES[5] == REUSES_REQUEST_IDENTITY_ID;
  assert REUSE_EDGES[6] == REUSES_MARKET_ID;
  assert REUSE_EDGES[7] == REUSES_DEPOSIT_TIERS_ID;
  assert REUSE_EDGES[8] == REUSES_NOTIFICATION_QUEUE_ID;
  assert REUSES_REFERRAL_PROGRAM_ID != ID;
}

test the_integration_pins_one_shape_and_names_the_retired_keys {
  assert API_SHAPE_WITNESS == "tests/referral_credit_api_shape_wiring.rs";
  assert API_SHAPE_WITNESS != WIRING_WITNESS;
  assert CLIENT_WIRING_WITNESS != WIRING_WITNESS;
  assert CLIENT_CALLED_ROUTE_COUNT == ROUTE_COUNT;
  assert API_SHAPE_PINNED_AT == OWNER_R3_DECIDED_AT;
  assert COPY_KEYS_RETIRED_2026_09_26.len == 7;
  assert COPY_KEYS_RETIRED_2026_09_26[0] == "referral.invitees.empty";
  assert COPY_KEYS_RETIRED_2026_09_26[6] == "profile.earn_per_ref";
  assert COPY_KEYS_RETIRED_2026_09_26[5] != COPY_KEYS[0];
  assert COPY_NEEDED_AND_NOT_WORDED_FOUND_BY_THE_CLIENT_LANE.len == 1;
  assert COPY_NEEDED_AND_NOT_WORDED.len + COPY_NEEDED_AND_NOT_WORDED_FOUND_BY_THE_CLIENT_LANE.len == 9;
}

test the_recorder_guard_reads_both_admin_identities {
  assert RECORDER_MAY_BE_THE_INVITER == false;
  assert RECORDER_GUARD_REFUSES_A_NAMED_INVITER == true;
  assert RECORDER_GUARD_REFUSES_A_PASSWORD_RECORD_OF_A_LISTED_ADMINS_FRIEND == true;
  assert recorder_refused(true, true, true) == true;
  assert recorder_refused(true, false, true) == false;
  assert recorder_refused(true, false, false) == false;
  assert recorder_refused(false, false, true) == true;
  assert recorder_refused(false, false, false) == false;
  assert RECORDER_GUARD_COVERS_A_PASSWORD_HOLDER_OFF_THE_ADMIN_LIST == false;
  assert PASSWORD_RECORD_NAMES_ITS_RECORDER == false;
  assert RECORDER_GUARD_ADMIN_LIST_READS == 1;
  assert RECORDER_GUARD_ADMIN_LIST_HANDED_TO_THE_RECORD == 1;
  assert RECORDER_GUARD_WITNESS != API_SHAPE_WITNESS;
  assert RECORDER_GUARD_FIXED_AT == OWNER_R3_DECIDED_AT;
}

test the_owner_chose_the_net_base {
  assert OWNER_BASE_ANSWER_AT == OWNER_R3_DECIDED_AT;
  assert OWNER_BASE_ANSWER_WORDS == "After the discount -- 250";
  assert BASE_IS_NET_OF_THE_APPLIED_REFERRAL_BALANCE == true;
  assert BASE_IS_THE_OWNERS_DECISION == true;
  assert BASE_QUESTION_IS_OPEN == false;
  assert BASE_ANSWER_CHANGED_THE_CODE == false;
  assert credit(1000, 0) == 100;
  assert credit(1000, 300) == 70;
  assert credit(1000, 300) < credit(1000, 0);
  assert credit(1000, 1000) == 0;
}

; --- Invariants -----------------------------------------------------------------------------------------

invariant the_credit_never_exceeds_the_owners_rate
  assert credit(1239, 0) * 100 <= 1239 * CREDIT_PERCENT and 1239 * CREDIT_PERCENT - credit(1239, 0) * 100 < 100 and credit(1000, 300) * 100 <= (1000 - 300) * CREDIT_PERCENT and (1000 - 300) * CREDIT_PERCENT - credit(1000, 300) * 100 < 100

invariant the_friend_is_credited_nothing
  assert FRIEND_IS_CREDITED == false and LEVELS_CREDITED == 1

invariant no_path_moves_points_into_this_ledger
  assert POINTS_TOKENS_IN_THE_CREDIT_MODULE == 0 and CREDIT_TOKENS_IN_THE_LOYALTY_ROUTES == 0 and BALANCE_IS_A_STORED_COLUMN == false

invariant a_payout_never_overdraws
  assert paid_admitted(true, true, 122, 123) == false and PARTIAL_PAYOUT == false and MONEY_MOVES_AUTOMATICALLY == false

invariant one_live_record_per_order
  assert AUTOMATIC_REVERSAL_SITES == 1 and REVERSAL_IS_WHOLE == true and ORDER_BEFORE_PROGRAM_IS_CREDITED == false

invariant a_negative_balance_is_shown_as_nothing_and_blocks_a_request
  assert shown_balance(-1) == 0 and request_admitted(false, false, available(-1, 0)) == REQUEST_REFUSED_NOTHING_AVAILABLE

invariant the_order_money_path_is_untouched
  assert ORDER_MONEY_PATH_MENTIONS == 0 and ORDER_TOTAL_IS_TOUCHED == false and PROMPTPAY_AMOUNT_IS_TOUCHED == false and DEPOSIT_IS_TOUCHED == false

invariant no_admin_credits_himself_under_either_identity
  assert RECORDER_MAY_BE_THE_INVITER == false and recorder_refused(true, true, false) == true and recorder_refused(false, false, true) == true

invariant the_base_is_the_owners_net_charge
  assert BASE_IS_NET_OF_THE_APPLIED_REFERRAL_BALANCE == true and BASE_IS_THE_OWNERS_DECISION == true and BASE_QUESTION_IS_OPEN == false and credit(1000, 300) < credit(1000, 0)
