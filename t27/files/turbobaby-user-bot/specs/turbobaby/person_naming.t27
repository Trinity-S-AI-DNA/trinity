pub const END_TO_END_WITNESS : str = "tests/integration_invitee_names.rs";

; --- Ownership edges ----------------------------------------------------------------------------
; Five OUTBOUND edges. This language has no import, so an edge is the owner's ID held as a string
; constant plus a test asserting the literal -- the one shape a grep finds from either end. Each
; note names the sibling's DECLARATION, never a line in it: a line citation goes stale on the
; sibling's next edit and says nothing when it does.
;
; CORRECTED 2026-09-22. This block said four and REUSE_EDGE_COUNT read 4. Further down, a
; constant named HANDLE_BOUND_IS_ALREADY_OWNED_BY already held turbobaby/events-booking as the
; owner of a decision this file leaned on -- an outbound edge in every respect but its name and
; its place, kept outside this block and beside four constants and three functions restating
; that owner's bound. REUSE_EDGE_COUNT counts the REUSES_ constants in this block and nothing
; else; the fifth is one of them now, and that constant is gone.
pub const REUSES_REQUEST_IDENTITY_ID : str = "turbobaby/request-identity";
pub const REUSES_LOCALE_POLICY_ID : str = "turbobaby/locale-policy";
pub const REUSES_PRICING_HONESTY_ID : str = "turbobaby/pricing-honesty";
pub const REUSES_CUSTOMER_SURFACE_ID : str = "turbobaby/customer-surface";
pub const REUSES_EVENTS_BOOKING_ID : str = "turbobaby/events-booking";
pub const REUSE_EDGE_COUNT : u8 = 5;

pub const REQUEST_IDENTITY_SUPPLIES : str = "turbobaby/request-identity owns identity_of_request, IDENTITY_TELEGRAM_USER, FAILED_PROOF_YIELDS_NO_USER and GATE_NAMES. WHO a request is arrives here as a decided identity; this file adds only that the identity is not a name, and restates no proof step, no gate and no call-site count.";
pub const LOCALE_POLICY_SUPPLIES : str = "turbobaby/locale-policy owns locale_is_published, PRIMARY_LOCALE, PUBLISHED_LOCALES, BARE_KEY_FALLBACK_SITES and TABLES_END_WITH_BARE_KEY_FALLBACK. The fallback word is a key looked up in that file's tables, and what an absent key renders as is its ruling, not this one's.";
pub const PRICING_HONESTY_SUPPLIES : str = "turbobaby/pricing-honesty owns RATE_INVALID, rate_absent, is_present, render and NOT_AN_AMOUNT_THB_DAY. The discipline borrowed is the SHAPE -- a tag set where 0 is not constructible, absence with no value slot, and a total renderer -- applied here to a string instead of a number. No rate, tag value or money field of that contract is repeated.";
pub const CUSTOMER_SURFACE_SUPPLIES : str = "turbobaby/customer-surface owns claim_may_render, screen_may_supply_its_own_number and CLAIM_UNSOURCED_NUMBER. Whether a screen may assert a thing at all is its ruling; this file decides only what string may stand in the name slot once the screen is allowed to speak.";
pub const EVENTS_BOOKING_SUPPLIES : str = "turbobaby/events-booking owns the attendee normaliser's handle-length bound, as its comment states it and as its check enforces it, in HANDLE_MIN_DECLARED, HANDLE_MIN_ENFORCED, HANDLE_MAX_DECLARED, HANDLE_MAX_ENFORCED, handle_is_accepted, handle_bounds_agree and length_is_in_the_handle_gap; why the gap between those two readings stayed green, in HANDLE_GAP_EXAMPLES_IN_TESTS and HANDLE_OVER_MAX_EXAMPLES_IN_TESTS; and the module's measured size, in ATTENDEE_SOURCE_LINES and ATTENDEE_SOURCE_TESTS. Whether a value is admitted, and whether it sits below the declared minimum, arrive here as two booleans. No bound, length or count of that contract is repeated here. What stays here is what that contract does not carry: that the normaliser and this file's owner module answer the same input differently, and that only one of them turns its answer into a link.";

