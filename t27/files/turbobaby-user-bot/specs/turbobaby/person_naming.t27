; contract's EDGE_DECLARATION_NAME so a grep from its end finds this one.
pub const IDENTITY_EDGE_DECLARATION_NAME : str = "REUSES_REQUEST_IDENTITY_ID";
pub const NAMED_BY_THE_IDENTITY_CENSUS : bool = false;
pub const IDENTITY_CENSUS_PREDATES_THIS_FILE : bool = true;

