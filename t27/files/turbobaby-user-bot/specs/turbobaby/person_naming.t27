; The sentence src/db/mod.rs:953-954 states in prose, made executable. It is the whole diagnosis of
; the original defect: the column was not mis-rendered, it was never written.
pub fn a_writer_is_a_writer(caller_count: u8) bool {
  return caller_count >= 1;
}

; Three kinds of update reach the bot and each must record the person, because a friend who
; arrives by one and returns by another would otherwise stay nameless depending on which button
; they happened to press.
pub fn every_update_kind_records_the_person(sites: u8) bool {
  return sites >= ENTRY_POINT_CALL_SITES;
}

; --- Where the rule can be executed --------------------------------------------------------------
pub const TRIOS_IS_COMPILED_UNCONDITIONALLY : bool = true;
pub const DB_LAYER_IS_FEATURE_GATED : bool = true;
pub const UI_LAYER_IS_TARGET_GATED : bool = true;
pub const DEFAULT_FEATURE_COUNT : u8 = 0;
pub const WITNESS_IS_FEATURE_GATED : bool = true;
pub const WITNESS_IS_IGNORED_BY_DEFAULT : bool = true;
pub const WITNESS_NEEDS_A_DATABASE : bool = true;

pub fn rule_is_executable_by_cargo_test(module_is_unconditional: bool) bool {
  return module_is_unconditional;
}

pub fn witness_runs_without_being_asked(feature_gated: bool, ignored: bool) bool {
  return !feature_gated and !ignored;
}

; --- What a name may be built from ----------------------------------------------------------------
; Two fields, joined by one space, in that order. A handle is not among them and neither is an
; identifier: both are on file, both would produce a non-empty string, and neither is what the
; shop was told the person is called.
pub const NAME_PART_COUNT : u8 = 2;
pub const NAME_PARTS : [2]str = ["first_name", "last_name"];
pub const NAME_JOIN_IS_A_SINGLE_SPACE : bool = true;
pub const HANDLE_IS_A_NAME : bool = false;
pub const IDENTIFIER_IS_A_NAME : bool = false;
pub const FALLBACK_IS_A_NAME : bool = false;

pub fn field_may_build_a_name(field: str) bool {
  if (field == NAME_PARTS[0]) {
    return true;
  }
  if (field == NAME_PARTS[1]) {
    return true;
  }
  return false;
}

; Blank is absent. The storage column is TEXT with no NOT NULL and no CHECK, so an empty string
; reaches the rule from a legacy row; treating it as a name renders a nameless person with a stray
; space, which reads as a name that failed to load rather than as a person nobody recorded.
pub fn value_is_present(supplied: bool, nonempty_after_trim: bool) bool {
  return supplied and nonempty_after_trim;
}

; --- The three outcomes, and a fourth that nobody constructs ----------------------------------------
; Zero is deliberately NOT a legal constructed outcome, for the reason turbobaby/pricing-honesty
; gives about its own tag set: a zero-filled or default-initialised record must not read as a
; well-formed anything. Here the stakes are sharper than for a number -- if 0 meant NAMED, a record
; nobody built would render as a person with an empty name, which is a blank slot where a customer
; expects a person and looks exactly like a rendering bug rather than like missing data.
pub const NAMING_INVALID : u8 = 0;
pub const NAMING_NAMED : u8 = 1;
pub const NAMING_HANDLE_ONLY : u8 = 2;
pub const NAMING_FALLBACK : u8 = 3;
pub const NAMING_OUTCOME_COUNT : u8 = 3;
pub const NAMING_OUTCOMES : [3]str = ["named", "handle_only", "fallback"];

pub fn outcome_is_constructed(outcome: u8) bool {
  return outcome >= NAMING_NAMED and outcome <= NAMING_FALLBACK;
}

; The whole decision. Either name part is enough; a handle alone stands alone; nothing known falls
; back. Three states and not two -- "no name" is its own case, and dressing it as one of the other
; two is what produced a screen full of identical strangers.
pub fn naming_outcome(first_present: bool, last_present: bool, handle_present: bool) u8 {
  if (first_present or last_present) {
    return NAMING_NAMED;
  }
  if (handle_present) {
    return NAMING_HANDLE_ONLY;
  }
  return NAMING_FALLBACK;
}

; --- What a render may emit -------------------------------------------------------------------------
; Three shapes, and the renderer is total over the outcome set including the one nobody
; constructs. An invalid record lands with the fallback, for the same reason absent and invalid
; land together in turbobaby/pricing-honesty: the customer-facing consequence of "we never
; recorded this" and "this record is malformed" is identical, and neither is a name.
pub const SHAPE_NONE : u8 = 0;
pub const SHAPE_NAME : u8 = 1;
pub const SHAPE_HANDLE : u8 = 2;
pub const SHAPE_FALLBACK : u8 = 3;

pub fn render_shape(outcome: u8) u8 {
  if (outcome == NAMING_NAMED) {
    return SHAPE_NAME;
  }
  if (outcome == NAMING_HANDLE_ONLY) {
    return SHAPE_HANDLE;
  }
  return SHAPE_FALLBACK;
}

pub fn may_print_as_a_name(outcome: u8) bool {
  return outcome == NAMING_NAMED;
}

; The defect of 2026, stated as a predicate rather than as a story. It is the one thing this file
; exists to forbid: a slot that the shop does not know how to fill, filled anyway, in the shape
; a filled slot has.
pub fn is_a_false_record(outcome: u8, printed_shape: u8) bool {
  return !may_print_as_a_name(outcome) and printed_shape == SHAPE_NAME;
}

; --- The fallback, and what makes it recognisable ------------------------------------------------
; Three properties, all three required. The word is the CALLER's, looked up by key, because the
; layer that decides the outcome holds no language and an English noun on a Russian screen is a
; second defect hiding behind the first. The tail keeps two unknown people apart. The marker is a
; boolean on the wire, so the client substitutes its own word instead of parsing one back off a
; string the server formatted -- which would be a contract nobody wrote down and nothing would
; catch breaking.
pub const FALLBACK_KEY : str = "referral.invitee.unknown";
pub const FALLBACK_TEXT_IS_HELD_HERE : bool = false;
pub const FALLBACK_WORD_BELONGS_TO_THE_CALLER : bool = true;
pub const FALLBACK_CARRIES_A_TAIL : bool = true;
pub const FALLBACK_IS_MARKED_ON_THE_WIRE : bool = true;
pub const WIRE_MARKER_FIELDS : [2]str = ["is_anonymous", "suffix"];

pub fn fallback_is_recognisable(shape: u8, word_is_localized: bool, tail_present: bool, marked_on_the_wire: bool) bool {
  return shape == SHAPE_FALLBACK and word_is_localized and tail_present and marked_on_the_wire;
}

; An absent key renders as its own key name -- that is turbobaby/locale-policy's measured ruling
; about both tables, and the consequence HERE is the only part this file owns: a key name in the
; name slot is still not a name, and a reader sees a broken lookup rather than a stranger called
; something. The fallback's own failure mode stays honest.
pub const MISSING_KEY_RENDERS_AS_ITSELF : bool = true;
pub const MISSING_KEY_STILL_IS_NOT_A_NAME : bool = true;

pub fn key_name_in_the_name_slot_is_a_name() bool {
  return false;
}

; --- The tail --------------------------------------------------------------------------------------
; Stable per person and derived from the identifier, which buys two things and costs a third. It
; buys stability without a second column, and it buys a fold rather than a sign, so an identifier
; from the negative range cannot render a minus where a tail belongs. It COSTS four digits of the
; identifier, published to whoever reads the screen. That cost is named here rather than left for
; somebody to discover, because a fallback built out of an identifier is still built out of an
; identifier.
pub const SUFFIX_BUCKETS : u16 = 10000;
pub const SUFFIX_DIGITS : u8 = 4;
pub const SUFFIX_IS_STABLE_PER_PERSON : bool = true;
pub const SUFFIX_IS_UNIQUE_PER_PERSON : bool = false;
pub const SUFFIX_IS_DERIVED_FROM_THE_IDENTIFIER : bool = true;
pub const SUFFIX_PUBLISHES_IDENTIFIER_DIGITS : u8 = 4;
pub const NEGATIVE_IDENTIFIER_IS_FOLDED_NOT_SIGNED : bool = true;
pub const IDENTIFIER_OFFSET_THAT_COLLIDES : u16 = 10000;

; Distinguishable, not unique, and the difference is the whole honesty of the tail. Two people
; whose identifiers differ by exactly one bucket span land on the same four digits, so the claim
; the screen makes is "these are probably different people", and a test that only ever compares
; two near neighbours would report the stronger claim.
pub fn two_unknown_people_are_distinguishable(bucket_a: u16, bucket_b: u16) bool {
  return bucket_a != bucket_b;
}

pub fn identifiers_share_a_bucket(offset: u16) bool {
  return offset == SUFFIX_BUCKETS;
}

; --- An identifier is not a name, and what follows from that ------------------------------------------
; The rule is not "never show a number". It is that a number may occupy the name slot only while it
; is presented AS an identifier, so the customer reads "the shop has no name for this person" and
; not "this person is called that". The live leaderboard row does exactly this: it selects a key
; whose two rows are an identifier label, so the number arrives labelled. The 2026 defect did the
; opposite with the same digits -- a noun glued to a tail, which reads as a name.
pub const IDENTIFIER_MASK_KEY : str = "referral.id_mask";
pub const IDENTIFIER_MASK_IS_LABELLED : bool = true;
pub const LABELLED_IDENTIFIER_IS_ADMISSIBLE : bool = true;
; RETIRED 2026-09-26. That row was the referral page's top-referrers list, and the owner had the list
; removed that day and its address closed ("remove the top and close the address";
; turbobaby/referral-program, OWNER_TOP_LIST_ANSWER_*). Its key went with it, one line for one line
; (turbobaby/locale-policy counts the four keys the list used). The rule above stands; the Mini App
; has no live example of it now, and IDENTIFIER_MASK_KEY keeps the name the key had.
pub const IDENTIFIER_MASK_KEY_IS_DECLARED : bool = false;
pub const IDENTIFIER_MASK_KEY_RETIRED_AT : str = "2026-09-26";

pub fn identifier_may_occupy_the_name_slot(labelled_as_an_identifier: bool) bool {
  return labelled_as_an_identifier;
}

; And the measurement that keeps the previous paragraph from being a comfort. The screen shows four
; digits; the response carries the identifier whole, and the shortening happens in the client. The
; endpoint that serves it names no identity gate at all, while the neighbouring invitees endpoint
; names one. A mask applied after delivery withholds nothing, and this file says so in a function
; rather than in a sentence, because the sentence is the kind a reader skips.
pub const SCREEN_SHOWS_IDENTIFIER_DIGITS : u8 = 4;
pub const WIRE_CARRIES_THE_WHOLE_IDENTIFIER : bool = true;
pub const MASK_IS_APPLIED_CLIENT_SIDE : bool = true;
; The two readings above and the gate below are the 2026-09-21 measurement. SINCE 2026-09-26 the
; leaderboard endpoint names the admin gate as its first statement (turbobaby/referral-program,
; LEADERBOARD_GATE_SITES, bound by gate 3), and no screen shows its digits. The wire still carries
; the whole identifier -- to an admin only -- so the finding stands as a rule: the mask never
; withheld anything, and what closed the exposure is the gate, not a mask.
pub const LEADERBOARD_ENDPOINT_NAMES_AN_IDENTITY_GATE : bool = true;
pub const INVITEES_ENDPOINT_NAMES_AN_IDENTITY_GATE : bool = true;
pub const GATED_ENDPOINTS_OF_THE_TWO : u8 = 2;
pub const LEADERBOARD_ENDPOINT_NAMES_AN_IDENTITY_GATE_BEFORE_THE_TOP_LIST_ANSWER : bool = false;
pub const GATED_ENDPOINTS_OF_THE_TWO_BEFORE_THE_TOP_LIST_ANSWER : u8 = 1;
pub const SCREENS_SHOWING_IDENTIFIER_DIGITS_SINCE_THE_TOP_LIST_ANSWER : u8 = 0;
pub const TOP_LIST_ANSWER_AT : str = "2026-09-26";

pub fn field_is_withheld(wire_omits_it: bool) bool {
  return wire_omits_it;
}

pub fn client_side_mask_withholds_the_field(wire_carries_it: bool) bool {
  return field_is_withheld(!wire_carries_it);
}

; --- The census: one owner, fourteen sites -----------------------------------------------------------
; A SITE is a function in src/ that decides what stands in the name slot when the name is absent.
; Places that carry a nullable name field through unchanged, substituting nothing, are NOT sites:
; they decide nothing and inherit whatever the site upstream of them decided. The method is pinned
; below because the number is only as good as the sweep that produced it, and the first sweep was
; wrong by half.
pub const NAMING_SITES_MEASURED : u8 = 14;
pub const SITES_ROUTED_THROUGH_THE_OWNER : u8 = 1;
pub const SITES_WITH_A_BARE_WORD_FALLBACK : u8 = 10;
pub const SITES_WITH_A_DISTINGUISHABLE_FALLBACK : u8 = 1;
pub const SITES_WITH_NO_FALLBACK_AT_ALL : u8 = 1;
pub const SITES_PRINTING_A_LABELLED_IDENTIFIER : u8 = 1;
pub const SITE_CENSUS_MEASURED_AT : str = "2026-09-21";
; The census is the 2026-09-21 reading and was not re-taken. One of its sites was deleted on
; 2026-09-26: the one that printed a labelled identifier, the referral top list's row (the section
; above), so that column is empty since. The other thirteen were not re-read on that day.
pub const NAMING_SITES_DELETED_WITH_THE_TOP_LIST : u8 = 1;
pub const SITES_PRINTING_A_LABELLED_IDENTIFIER_SINCE_THE_TOP_LIST_ANSWER : u8 = 0;
pub const CENSUS_FIRST_ATTEMPT : u8 = 7;
pub const CENSUS_METHOD : str = "grep over src/ for every literal a missing person-name is replaced by in this tree, plus COALESCE over a name column, then reading every hit. Three hits of one of those literals turned out to be PRODUCT names in three order screens and were excluded; pass-through carriers that substitute nothing were excluded; the remainder was read one function at a time.";
pub const PASS_THROUGH_CARRIERS_ARE_EXCLUDED : bool = true;
pub const PASS_THROUGH_NOTE : str = "Four carriers were seen while counting, in the admin and events APIs, each handing on an optional name exactly as the row held it. That figure is a floor observed in passing and not a census, and no number below rests on it.";
pub const CENSUS_EXCLUDED_PRODUCT_NAME_HITS : u8 = 3;

; Ten sites answer with a bare word and no tail, so two unrecorded people render as the same
; string. Three properties of that ten are worth separating, because each is a different kind of
; wrong and a single total would hide all three.
pub const SITES_WHERE_TWO_UNKNOWN_PEOPLE_RENDER_ALIKE : u8 = 10;
pub const FALLBACKS_COMPUTED_AND_NEVER_READ : u8 = 1;
pub const FALLBACKS_STACKED_ON_ONE_PATH : u8 = 2;
pub const OUTER_STACKED_FALLBACK_IS_REACHABLE : bool = false;
pub const SAME_WORD_SUBSTITUTED_ON_ONE_PATH : u8 = 3;
pub const STACKED_FALLBACK_NOTE : str = "One server handler substitutes a word for an absent name and always sends a string; the client then substitutes a second, different word for a field that is therefore never absent. Two defaults on one path, and the outer one cannot fire while the server behaves. Neither carries a tail.";
pub const DISCARDED_FALLBACK_NOTE : str = "One query computes a fallback name in three SQL arms and the only client of that endpoint does not deserialise the field at all, so the work is done and thrown away. A default nobody reads is not harmless: it is the same decision, unexercised, waiting for a reader.";
pub const REPEATED_WORD_NOTE : str = "One helper substitutes a word when the stored name is absent, and both of its callers substitute the SAME word again when the query itself fails. Three substitutions on one path, and the outer two are worse than the inner one: they answer a failed read with a plausible person instead of with an error.";

; The stand-in that was done properly and that nothing calls. The locale table declares a field for
; exactly this purpose, with a row in each published locale; a grep of src/ finds the declaration
; and the two rows and no reader at all, while the handler that needs a stand-in at that same place
; hard-codes an English word instead. Named by FIELD NAME, never by either row's text.
pub const LOCALIZED_STAND_IN_FIELD : str = "order_anonymous";
pub const LOCALIZED_STAND_IN_EXISTS : bool = true;
pub const LOCALIZED_STAND_IN_HAS_A_READER : bool = false;

pub fn census_adds_up(routed: u8, bare_word: u8, distinguishable: u8, no_fallback: u8, labelled_identifier: u8) bool {
  return routed + bare_word + distinguishable + no_fallback + labelled_identifier == NAMING_SITES_MEASURED;
}

pub fn a_rule_with_one_owner_is_a_rule(sites: u8, routed: u8) bool {
  return routed == sites;
}

; The one site that invents nothing: it returns no name when there is none and the screen asks the
; customer instead. That is the shape absence should have wherever a human is available to answer,
; and it is recorded so the census cannot be read as thirteen failures.
pub const SITE_THAT_ASKS_INSTEAD_OF_INVENTING : u8 = 1;
pub const ASKING_IS_A_LEGITIMATE_ANSWER_TO_ABSENCE : bool = true;

; A stand-in substituted for a FAILED READ is not the same act as one substituted for a recorded
; absence, and this file refuses to let the two share a name. The first says "nobody told us"; the
; second says "we could not find out and decided not to mention it".
pub fn stand_in_hides_an_error(read_failed: bool, stand_in_substituted: bool) bool {
  return read_failed and stand_in_substituted;
}

; --- The handle, and two modules that disagree about it ----------------------------------------------
; The owner accepts a handle, strips ONE leading at-sign because that is the storage convention,
; refuses anything outside the platform alphabet, and never builds a link from it. The attendee
; normaliser strips EVERY leading at-sign and does build a link. The divergence is named rather
; than legislated away: both belong to their own surface, and only one of them can produce a dead
; tap.
pub const OWNER_HANDLE_MAX_CHARS : u8 = 32;
pub const OWNER_HANDLE_MIN_CHARS_ENFORCED : u8 = 1;
pub const OWNER_STRIPS_ONE_LEADING_MARKER : bool = true;
pub const ATTENDEE_STRIPS_EVERY_LEADING_MARKER : bool = true;
pub const OWNER_BUILDS_A_URL_FROM_A_HANDLE : bool = false;
pub const ATTENDEE_BUILDS_A_URL_FROM_A_HANDLE : bool = true;
pub const THE_TWO_HANDLE_RULES_AGREE : bool = false;
pub const HANDLE_RULE_DIVERGENCE_NOTE : str = "A value carrying two leading markers is refused by the owner, whose comment argues that such a value was prefixed twice and that normalising it away would hide the fact, and is admitted by the attendee normaliser, which trims the class rather than one character. Same input, two answers, one file apart.";

; THE REVIEWER'S CLAIM, CHECKED, CONFIRMED -- AND ANSWERED BY ITS OWNER. A review of 2026-09-21
; claimed that the attendee normaliser's length check guards one end of the two-ended range its
; own comment states, so a value shorter than the stated minimum is admitted, turned into a profile
; link and reported as reachable -- the exact dead tap the comment says the check exists to
; prevent. The claim was checked against src/trios/attendees.rs and confirmed. What this file keeps
; is the record that the check was made. The bound itself, both of its readings and what the
; module's tests do and do not offer it are turbobaby/events-booking's, under the declaration
; names in EVENTS_BOOKING_SUPPLIES.
pub const REVIEWER_CLAIM_IS_CONFIRMED : bool = true;
pub const REVIEWER_CLAIM_NOTE : str = "Confirmed 2026-09-21 by reading src/trios/attendees.rs. The bound the claim concerns is turbobaby/events-booking's, declared there as HANDLE_MIN_DECLARED against HANDLE_MIN_ENFORCED; this note records that the claim was checked and holds no reading of the bound, so a fix to the check has one contract to correct and not two.";

; THE OVERLAP, AND HOW IT WAS RESOLVED. Found 2026-09-21: this file restated that bound in four
; constants and three functions, with a test and an invariant over them, while
; turbobaby/events-booking already held it under the six declarations listed below, cited the same
; two lines of the same module, and pinned the disagreement between its two readings with an
; invariant of its own. The overlap was at first only DECLARED -- this block then said "resolving
; the overlap is the two owners' call, not a reviewer's" -- which left two present-tense copies
; that a fix to the check would have had to find in two files, and it named the owner in a
; constant of its own instead of in the edge block.
;
; RESOLVED 2026-09-22 in the one direction the corpus allows: the copy goes, the owner stays, and
; the owner is named by REUSES_EVENTS_BOOKING_ID in the edge block. The seven restated
; declarations are listed by NAME in RESTATEMENT_DROPPED_ON_RESOLUTION, so a grep for any of them
; lands here; the eighth name there is SIBLING_MODULE_LINES from the source block, the same copy
; one step removed. The constant that used to name the owner is named in SUPERSEDED_BY_THE_EDGE.
; Three facts this file held and its owner did NOT were not dropped: they moved to the owner,
; under the names in FACTS_MOVED_TO_THE_OWNER, because a fix to the check flips them and the owner
; is where a gate watches that module. Two were renamed on arrival to what was actually measured.
; The old "one length example" was one OVER-length example, and "the tests cover the lower bound"
; is asked there of the gap between the two minima: length zero IS tested, and the emptiness
; check refuses it before any length is compared, so it tests neither minimum.
;
; The gate-1 floor for this file in scripts/verify_t27_specs.py fell on the same day, from 239
; declarations to 235, measured with the pinned compiler after this resolution; its check floor
; did not move. D16 keeps a floor so that a gate losing sight of what it checks goes red;
; declarations removed on purpose and listed by name above are not that.
;
; What is NOT the owner's is the section above this one: the divergence between the two handle
; rules one file apart, and the consequence that only one of them builds a URL. That stays, and
; the predicate below consumes the owner's verdict. OWNER_HANDLE_MAX_CHARS and
; OWNER_HANDLE_MIN_CHARS_ENFORCED stay too. They describe src/trios/person.rs, this file's own
; owner module, whose check at src/trios/person.rs:74 enforces a non-empty floor and a maximum of
; MAX_HANDLE_LEN (src/trios/person.rs:50). That module builds no link and is not the attendee
; module, so these two are not the attendee bound, and this file does not compare them with it.
pub const THIS_FILE_RESTATES_THE_HANDLE_BOUND : bool = false;
pub const HANDLE_BOUND_IS_CONSUMED_RATHER_THAN_RESTATED : bool = true;
pub const HANDLE_BOUND_OWNER_DECLARATION_COUNT : u8 = 6;
pub const HANDLE_BOUND_OWNER_DECLARATIONS : [6]str = [
  "HANDLE_MIN_DECLARED",
  "HANDLE_MIN_ENFORCED",
  "HANDLE_MAX_DECLARED",
  "HANDLE_MAX_ENFORCED",
  "handle_is_accepted",
  "handle_bounds_agree",
];
pub const HANDLE_BOUND_OVERLAP_FOUND_AT : str = "2026-09-21";
pub const HANDLE_BOUND_OVERLAP_RESOLVED_AT : str = "2026-09-22";
pub const HANDLE_DIVERGENCE_IS_OWNED_ONLY_HERE : bool = true;
pub const RESTATEMENT_DROPPED_COUNT : u8 = 8;
pub const RESTATEMENT_DROPPED_ON_RESOLUTION : [8]str = [
  "ATTENDEE_HANDLE_LOWER_BOUND_STATED",
  "ATTENDEE_HANDLE_UPPER_BOUND_STATED",
  "ATTENDEE_HANDLE_LOWER_BOUND_ENFORCED",
  "ATTENDEE_HANDLE_UPPER_BOUND_ENFORCED",
  "attendee_handle_admits",
  "attendee_handle_admits_as_stated",
  "implementation_matches_its_comment",
  "SIBLING_MODULE_LINES",
];
pub const SUPERSEDED_BY_THE_EDGE : str = "HANDLE_BOUND_IS_ALREADY_OWNED_BY";
pub const FACTS_MOVED_COUNT : u8 = 3;
pub const FACTS_MOVED_TO_THE_OWNER : [3]str = [
  "ATTENDEE_HANDLE_TESTS_COVER_THE_LOWER_BOUND is now HANDLE_GAP_EXAMPLES_IN_TESTS",
  "ATTENDEE_HANDLE_LENGTH_EXAMPLES_IN_TESTS is now HANDLE_OVER_MAX_EXAMPLES_IN_TESTS",
  "SIBLING_MODULE_TESTS is now ATTENDEE_SOURCE_TESTS",
];

; A tap the screen promises and the platform cannot keep. Marked reachable is a claim about the
; world, and this is the input on which the claim is false. Both arguments are the OWNER's
; verdict, consumed and not recomputed: `admitted` is what turbobaby/events-booking's
; handle_is_accepted answers for the value, and `below_the_stated_minimum` is whether its length
; falls under that contract's HANDLE_MIN_DECLARED -- the two together are its
; length_is_in_the_handle_gap. Until 2026-09-22 the tests below fed this from a local copy of the
; check; they now feed it the two booleans, which is all this file is entitled to know.
pub fn tap_is_promised_but_cannot_resolve(admitted: bool, below_the_stated_minimum: bool) bool {
  return admitted and below_the_stated_minimum;
}

; --- The length of a name -----------------------------------------------------------------------------
; A display name is other people's free text arriving in a narrow row, so it is cut. The cut counts
; characters and not bytes, which is the one thing that must be true for a name outside the ASCII
; range to survive being shortened. What the cut does NOT do is trim what it leaves: a name whose
; final kept character is the join space keeps that space, and the single-line form then writes its
; own separator after it. Recorded as a property of the cut rather than as an example, because an
; example would have to carry a name.
pub const MAX_NAME_CHARS : u8 = 48;
pub const TRUNCATION_COUNTS_CHARACTERS_NOT_BYTES : bool = true;
pub const TRUNCATION_TRIMS_ITS_TAIL : bool = false;
pub const TRUNCATION_MARKS_THAT_IT_HAPPENED : bool = false;
pub const TRUNCATED_NAME_IS_STILL_A_NAME : bool = true;

pub fn cut_lands_on_the_join(first_part_chars: u8) bool {
  return first_part_chars + 1 == MAX_NAME_CHARS;
}

pub fn single_line_spacing_is_single(name_ends_with_a_space: bool) bool {
  return !name_ends_with_a_space;
}

; --- Refusals ------------------------------------------------------------------------------------------
; Named, because an unnamed refusal is indistinguishable from an oversight.
pub const PERSON_NAMES_IN_THIS_FILE : u8 = 0;
pub const HANDLES_IN_THIS_FILE : u8 = 0;
pub const IDENTIFIERS_IN_THIS_FILE : u8 = 0;
pub const TEST_FIXTURES_CARRY_A_PERSON : bool = false;
pub const FALLBACK_WORDING_IN_THIS_FILE : u8 = 0;
pub const D14_APPLIES_TO_THIS_SUBJECT : bool = true;

pub const UNNAMED_ROW_COUNT_IS_KNOWN : bool = false;
pub const UNNAMED_ROW_COUNT_NOTE : str = "How many stored people have no recorded name today is not published anywhere this file can read: the figure lives in a running database, the repository holds only schema and code, and no fixture, seed or test in the tree counts it. No estimate is offered in its place.";

pub const BACKFILL_COVERAGE_IS_KNOWN : bool = false;
pub const BACKFILL_COVERAGE_NOTE : str = "The identity migration backfills a name and a handle from past orders, so its reach is exactly the people who have ordered, which is a subset of the people who appear in a friends list. What fraction that is cannot be read from the tree, and this file does not guess it.";

pub const COLLISION_RATE_IS_KNOWN : bool = false;
pub const COLLISION_RATE_NOTE : str = "How often two unrecorded people share a tail depends on the distribution of real identifiers, which this repository does not contain and must not. The bucket count is pinned; the rate is refused.";

pub fn absence_of_a_measurement_is_a_measurement(published: bool, estimated: bool) bool {
  return !published and !estimated;
}

; --- Tests ---------------------------------------------------------------------------------------------

test a_name_is_built_only_from_the_two_name_fields {
  assert field_may_build_a_name("first_name") == true;
  assert field_may_build_a_name("last_name") == true;
  assert field_may_build_a_name("username") == false;
  assert field_may_build_a_name("telegram_id") == false;
  assert NAME_PART_COUNT == 2;
  assert HANDLE_IS_A_NAME == false;
  assert IDENTIFIER_IS_A_NAME == false;
  assert FALLBACK_IS_A_NAME == false;
}

test blank_is_the_same_thing_as_absent {
  assert value_is_present(true, true) == true;
  assert value_is_present(true, false) == false;
  assert value_is_present(false, true) == false;
  assert value_is_present(false, false) == false;
}

test the_boundary_has_three_outcomes_and_no_fourth {
  assert naming_outcome(true, true, true) == NAMING_NAMED;
  assert naming_outcome(true, false, false) == NAMING_NAMED;
  assert naming_outcome(false, true, false) == NAMING_NAMED;
  assert naming_outcome(false, false, true) == NAMING_HANDLE_ONLY;
  assert naming_outcome(false, false, false) == NAMING_FALLBACK;
  assert NAMING_OUTCOME_COUNT == 3;
}

test a_record_nobody_constructed_is_not_a_name {
  assert outcome_is_constructed(NAMING_INVALID) == false;
  assert outcome_is_constructed(NAMING_NAMED) == true;
  assert outcome_is_constructed(NAMING_HANDLE_ONLY) == true;
  assert outcome_is_constructed(NAMING_FALLBACK) == true;
  assert may_print_as_a_name(NAMING_INVALID) == false;
  assert render_shape(NAMING_INVALID) == SHAPE_FALLBACK;
}

test the_render_is_total_over_every_outcome {
  assert render_shape(NAMING_NAMED) == SHAPE_NAME;
  assert render_shape(NAMING_HANDLE_ONLY) == SHAPE_HANDLE;
  assert render_shape(NAMING_FALLBACK) == SHAPE_FALLBACK;
  assert render_shape(NAMING_INVALID) == SHAPE_FALLBACK;
  assert SHAPE_NONE == 0;
}

test only_a_recorded_name_may_be_printed_as_one {
  assert may_print_as_a_name(NAMING_NAMED) == true;
  assert may_print_as_a_name(NAMING_HANDLE_ONLY) == false;
  assert may_print_as_a_name(NAMING_FALLBACK) == false;
}

test the_defect_this_file_exists_to_forbid {
  assert is_a_false_record(NAMING_FALLBACK, SHAPE_NAME) == true;
  assert is_a_false_record(NAMING_INVALID, SHAPE_NAME) == true;
  assert is_a_false_record(NAMING_HANDLE_ONLY, SHAPE_NAME) == true;
  assert is_a_false_record(NAMING_NAMED, SHAPE_NAME) == false;
  assert is_a_false_record(NAMING_FALLBACK, SHAPE_FALLBACK) == false;
}

test a_fallback_must_be_recognisable_as_one {
  assert fallback_is_recognisable(SHAPE_FALLBACK, true, true, true) == true;
  assert fallback_is_recognisable(SHAPE_NAME, true, true, true) == false;
  assert fallback_is_recognisable(SHAPE_FALLBACK, false, true, true) == false;
  assert fallback_is_recognisable(SHAPE_FALLBACK, true, false, true) == false;
  assert fallback_is_recognisable(SHAPE_FALLBACK, true, true, false) == false;
}

test the_fallback_word_is_a_key_and_never_a_string_here {
  assert FALLBACK_KEY == "referral.invitee.unknown";
  assert FALLBACK_TEXT_IS_HELD_HERE == false;
  assert FALLBACK_WORDING_IN_THIS_FILE == 0;
  assert FALLBACK_WORD_BELONGS_TO_THE_CALLER == true;
  assert WIRE_MARKER_FIELDS[0] == "is_anonymous";
  assert WIRE_MARKER_FIELDS[1] == "suffix";
}

test a_missing_translation_still_does_not_produce_a_name {
  assert MISSING_KEY_RENDERS_AS_ITSELF == true;
  assert MISSING_KEY_STILL_IS_NOT_A_NAME == true;
  assert key_name_in_the_name_slot_is_a_name() == false;
}

test the_tail_distinguishes_without_being_unique {
  assert two_unknown_people_are_distinguishable(1, 2) == true;
  assert two_unknown_people_are_distinguishable(11, 11) == false;
  assert identifiers_share_a_bucket(IDENTIFIER_OFFSET_THAT_COLLIDES) == true;
  assert identifiers_share_a_bucket(1) == false;
  assert SUFFIX_IS_STABLE_PER_PERSON == true;
  assert SUFFIX_IS_UNIQUE_PER_PERSON == false;
  assert SUFFIX_BUCKETS == 10000;
  assert SUFFIX_DIGITS == 4;
}

test the_tail_is_made_of_the_identifier_and_says_so {
  assert SUFFIX_IS_DERIVED_FROM_THE_IDENTIFIER == true;
  assert SUFFIX_PUBLISHES_IDENTIFIER_DIGITS == 4;
  assert NEGATIVE_IDENTIFIER_IS_FOLDED_NOT_SIGNED == true;
}

test a_number_in_the_name_slot_must_wear_a_label {
  assert identifier_may_occupy_the_name_slot(true) == true;
  assert identifier_may_occupy_the_name_slot(false) == false;
  assert IDENTIFIER_MASK_KEY == "referral.id_mask";
  assert IDENTIFIER_MASK_IS_LABELLED == true;
  assert LABELLED_IDENTIFIER_IS_ADMISSIBLE == true;
}

test a_mask_applied_after_delivery_withholds_nothing {
  assert field_is_withheld(true) == true;
  assert field_is_withheld(false) == false;
  assert client_side_mask_withholds_the_field(WIRE_CARRIES_THE_WHOLE_IDENTIFIER) == false;
  assert MASK_IS_APPLIED_CLIENT_SIDE == true;
  assert SCREEN_SHOWS_IDENTIFIER_DIGITS == 4;
}

; The 2026-09-21 reading, kept; the test after it holds the one since 2026-09-26.
test one_of_the_two_endpoints_names_a_gate {
  assert INVITEES_ENDPOINT_NAMES_AN_IDENTITY_GATE == true;
  assert LEADERBOARD_ENDPOINT_NAMES_AN_IDENTITY_GATE_BEFORE_THE_TOP_LIST_ANSWER == false;
  assert GATED_ENDPOINTS_OF_THE_TWO_BEFORE_THE_TOP_LIST_ANSWER == 1;
}

test both_endpoints_name_a_gate_and_no_screen_masks_an_identifier_since_the_top_list_answer {
  assert TOP_LIST_ANSWER_AT == "2026-09-26";
  assert IDENTIFIER_MASK_KEY_RETIRED_AT == TOP_LIST_ANSWER_AT;
  assert LEADERBOARD_ENDPOINT_NAMES_AN_IDENTITY_GATE == true;
  assert INVITEES_ENDPOINT_NAMES_AN_IDENTITY_GATE == true;
  assert GATED_ENDPOINTS_OF_THE_TWO == 2;
  assert GATED_ENDPOINTS_OF_THE_TWO - GATED_ENDPOINTS_OF_THE_TWO_BEFORE_THE_TOP_LIST_ANSWER == 1;
  assert SCREENS_SHOWING_IDENTIFIER_DIGITS_SINCE_THE_TOP_LIST_ANSWER == 0;
  assert IDENTIFIER_MASK_KEY_IS_DECLARED == false;
  assert IDENTIFIER_MASK_KEY == "referral.id_mask";
  assert client_side_mask_withholds_the_field(WIRE_CARRIES_THE_WHOLE_IDENTIFIER) == false;
  assert NAMING_SITES_DELETED_WITH_THE_TOP_LIST == SITES_PRINTING_A_LABELLED_IDENTIFIER;
  assert SITES_PRINTING_A_LABELLED_IDENTIFIER_SINCE_THE_TOP_LIST_ANSWER == 0;
  assert identifier_may_occupy_the_name_slot(IDENTIFIER_MASK_IS_LABELLED) == true;
}

test the_census_adds_up_and_the_owner_owns_one_site_of_fourteen {
  assert census_adds_up(SITES_ROUTED_THROUGH_THE_OWNER, SITES_WITH_A_BARE_WORD_FALLBACK, SITES_WITH_A_DISTINGUISHABLE_FALLBACK, SITES_WITH_NO_FALLBACK_AT_ALL, SITES_PRINTING_A_LABELLED_IDENTIFIER) == true;
  assert a_rule_with_one_owner_is_a_rule(NAMING_SITES_MEASURED, SITES_ROUTED_THROUGH_THE_OWNER) == false;
  assert a_rule_with_one_owner_is_a_rule(1, 1) == true;
  assert NAMING_SITES_MEASURED == 14;
  assert SITES_ROUTED_THROUGH_THE_OWNER == 1;
  assert SITES_WHERE_TWO_UNKNOWN_PEOPLE_RENDER_ALIKE == 10;
}

test the_census_carries_its_own_method_and_its_own_correction {
  assert CENSUS_FIRST_ATTEMPT == 7;
  assert CENSUS_FIRST_ATTEMPT != NAMING_SITES_MEASURED;
  assert PASS_THROUGH_CARRIERS_ARE_EXCLUDED == true;
  assert CENSUS_EXCLUDED_PRODUCT_NAME_HITS == 3;
  assert SITE_CENSUS_MEASURED_AT == "2026-09-21";
}

test a_default_nobody_reads_and_a_default_that_cannot_fire {
  assert FALLBACKS_COMPUTED_AND_NEVER_READ == 1;
  assert FALLBACKS_STACKED_ON_ONE_PATH == 2;
  assert OUTER_STACKED_FALLBACK_IS_REACHABLE == false;
  assert SITE_THAT_ASKS_INSTEAD_OF_INVENTING == 1;
  assert ASKING_IS_A_LEGITIMATE_ANSWER_TO_ABSENCE == true;
}

test a_stand_in_for_a_failed_read_is_a_second_offence {
  assert SAME_WORD_SUBSTITUTED_ON_ONE_PATH == 3;
  assert stand_in_hides_an_error(true, true) == true;
  assert stand_in_hides_an_error(false, true) == false;
  assert stand_in_hides_an_error(true, false) == false;
}

test the_localized_stand_in_exists_and_nothing_calls_it {
  assert LOCALIZED_STAND_IN_FIELD == "order_anonymous";
  assert LOCALIZED_STAND_IN_EXISTS == true;
  assert LOCALIZED_STAND_IN_HAS_A_READER == false;
}

test the_writer_chain_was_re_measured_and_the_header_is_out_of_date {
  assert a_writer_is_a_writer(0) == false;
  assert a_writer_is_a_writer(REPLACEMENT_WRITER_PRODUCTION_CALLERS) == true;
  assert THAT_WRITER_STILL_EXISTS == false;
  assert DEFINITIONS_FOUND_TODAY == 0;
  ; The mention census carries its correction the way the site census does.
  assert SURVIVING_MENTIONS_ARE_PROSE == 6;
  assert SURVIVING_MENTION_COUNT_BEFORE_THE_REVIEW != SURVIVING_MENTIONS_ARE_PROSE;
  assert MENTION_SCOPE == "src/, tests/ and migrations/";
  assert THE_HEADERS_DEFECT_IS_LIVE_TODAY == false;
  assert THE_HEADER_STILL_READS_AS_PRESENT_TENSE == true;
  assert WRITER_CHAIN_MEASURED_AT == "2026-09-21";
}

test every_kind_of_update_records_the_person {
  assert ENTRY_POINT_CALL_SITES == 3;
  assert every_update_kind_records_the_person(3) == true;
  assert every_update_kind_records_the_person(2) == false;
  assert ENTRY_POINT_CALL_SITE_LIST[0] == "src/bot/callbacks.rs:134";
  assert ENTRY_POINT_CALL_SITE_LIST[1] == "src/bot/commands.rs:169";
  assert ENTRY_POINT_CALL_SITE_LIST[2] == "src/bot/handlers.rs:30";
}

test the_rule_lives_where_the_test_runner_can_reach_it {
  assert rule_is_executable_by_cargo_test(TRIOS_IS_COMPILED_UNCONDITIONALLY) == true;
  assert rule_is_executable_by_cargo_test(false) == false;
  assert DB_LAYER_IS_FEATURE_GATED == true;
  assert UI_LAYER_IS_TARGET_GATED == true;
  assert DEFAULT_FEATURE_COUNT == 0;
}

test the_end_to_end_witness_does_not_run_unless_it_is_asked {
  assert witness_runs_without_being_asked(WITNESS_IS_FEATURE_GATED, WITNESS_IS_IGNORED_BY_DEFAULT) == false;
  assert witness_runs_without_being_asked(false, false) == true;
  assert WITNESS_NEEDS_A_DATABASE == true;
}

; Replaced 2026-09-22. This read the_attendee_length_check_guards_one_end_of_a_two_ended_range and
; ran over a local copy of the check. The two readings of the bound are turbobaby/events-booking's;
; what stays here is the record of the claim and where its facts went.
test the_reviewers_claim_is_a_record_and_not_a_reading_of_the_bound {
  assert REVIEWER_CLAIM_IS_CONFIRMED == true;
  assert REVIEWER_CLAIM_NOTE != "";
  assert FACTS_MOVED_TO_THE_OWNER.len == FACTS_MOVED_COUNT;
  assert FACTS_MOVED_TO_THE_OWNER[0] == "ATTENDEE_HANDLE_TESTS_COVER_THE_LOWER_BOUND is now HANDLE_GAP_EXAMPLES_IN_TESTS";
  assert FACTS_MOVED_TO_THE_OWNER[1] == "ATTENDEE_HANDLE_LENGTH_EXAMPLES_IN_TESTS is now HANDLE_OVER_MAX_EXAMPLES_IN_TESTS";
  assert FACTS_MOVED_TO_THE_OWNER[2] == "SIBLING_MODULE_TESTS is now ATTENDEE_SOURCE_TESTS";
}

; The resolution, asserted so that neither contract can undo it by an edit of the other. RENAMED
; 2026-09-22: this read the_handle_bound_above_is_a_restatement_of_a_fact_another_contract_owns and
; asserted that the restatement stood. It is a self-report -- the assertion gate reads one file at
; a time and cannot see that a declaration is absent -- so the absence itself is pinned outside the
; corpus, by tests/person_naming_handle_edge_wiring.rs, which names every dropped declaration and
; resolves every consumed one in the owner.
test the_handle_bound_is_consumed_from_its_owner_and_not_restated {
  assert REUSES_EVENTS_BOOKING_ID == "turbobaby/events-booking";
  assert REUSES_EVENTS_BOOKING_ID != ID;
  assert REUSE_EDGE_COUNT == 5;
  assert THIS_FILE_RESTATES_THE_HANDLE_BOUND == false;
  assert HANDLE_BOUND_IS_CONSUMED_RATHER_THAN_RESTATED == true;
  assert HANDLE_BOUND_OWNER_DECLARATIONS.len == HANDLE_BOUND_OWNER_DECLARATION_COUNT;
  assert HANDLE_BOUND_OWNER_DECLARATIONS[0] == "HANDLE_MIN_DECLARED";
  assert HANDLE_BOUND_OWNER_DECLARATIONS[1] == "HANDLE_MIN_ENFORCED";
  assert HANDLE_BOUND_OWNER_DECLARATIONS[2] == "HANDLE_MAX_DECLARED";
  assert HANDLE_BOUND_OWNER_DECLARATIONS[3] == "HANDLE_MAX_ENFORCED";
  assert HANDLE_BOUND_OWNER_DECLARATIONS[4] == "handle_is_accepted";
  assert HANDLE_BOUND_OWNER_DECLARATIONS[5] == "handle_bounds_agree";
  assert HANDLE_BOUND_OVERLAP_FOUND_AT == "2026-09-21";
  assert HANDLE_BOUND_OVERLAP_RESOLVED_AT == "2026-09-22";
  assert RESTATEMENT_DROPPED_ON_RESOLUTION.len == RESTATEMENT_DROPPED_COUNT;
  assert RESTATEMENT_DROPPED_ON_RESOLUTION[0] == "ATTENDEE_HANDLE_LOWER_BOUND_STATED";
  assert RESTATEMENT_DROPPED_ON_RESOLUTION[1] == "ATTENDEE_HANDLE_UPPER_BOUND_STATED";
  assert RESTATEMENT_DROPPED_ON_RESOLUTION[2] == "ATTENDEE_HANDLE_LOWER_BOUND_ENFORCED";
  assert RESTATEMENT_DROPPED_ON_RESOLUTION[3] == "ATTENDEE_HANDLE_UPPER_BOUND_ENFORCED";
  assert RESTATEMENT_DROPPED_ON_RESOLUTION[4] == "attendee_handle_admits";
  assert RESTATEMENT_DROPPED_ON_RESOLUTION[5] == "attendee_handle_admits_as_stated";
  assert RESTATEMENT_DROPPED_ON_RESOLUTION[6] == "implementation_matches_its_comment";
  assert RESTATEMENT_DROPPED_ON_RESOLUTION[7] == "SIBLING_MODULE_LINES";
  assert SUPERSEDED_BY_THE_EDGE == "HANDLE_BOUND_IS_ALREADY_OWNED_BY";
  assert HANDLE_DIVERGENCE_IS_OWNED_ONLY_HERE == true;
  assert THE_TWO_HANDLE_RULES_AGREE == false;
}

; Rewritten 2026-09-22 without changing its name. A "short value" here is the owner's verdict on
; one -- admitted by its handle_is_accepted and below its HANDLE_MIN_DECLARED -- and no longer a
; length this file computes; the lengths themselves are asserted in turbobaby/events-booking.
test a_short_value_becomes_a_link_the_platform_cannot_honour {
  assert tap_is_promised_but_cannot_resolve(true, true) == true;
  assert tap_is_promised_but_cannot_resolve(true, false) == false;
  assert tap_is_promised_but_cannot_resolve(false, true) == false;
  assert ATTENDEE_BUILDS_A_URL_FROM_A_HANDLE == true;
  assert OWNER_BUILDS_A_URL_FROM_A_HANDLE == false;
}

test the_two_handle_rules_are_two_rules {
  assert THE_TWO_HANDLE_RULES_AGREE == false;
  assert OWNER_STRIPS_ONE_LEADING_MARKER == true;
  assert ATTENDEE_STRIPS_EVERY_LEADING_MARKER == true;
  assert OWNER_BUILDS_A_URL_FROM_A_HANDLE == false;
  assert ATTENDEE_BUILDS_A_URL_FROM_A_HANDLE == true;
  assert OWNER_HANDLE_MAX_CHARS == 32;
  assert OWNER_HANDLE_MIN_CHARS_ENFORCED == 1;
}

test a_cut_name_keeps_the_space_it_was_cut_on {
  assert cut_lands_on_the_join(47) == true;
  assert cut_lands_on_the_join(10) == false;
  assert TRUNCATION_TRIMS_ITS_TAIL == false;
  assert single_line_spacing_is_single(true) == false;
  assert single_line_spacing_is_single(false) == true;
  assert TRUNCATION_COUNTS_CHARACTERS_NOT_BYTES == true;
  assert MAX_NAME_CHARS == 48;
}

test this_file_carries_no_person {
  assert PERSON_NAMES_IN_THIS_FILE == 0;
  assert HANDLES_IN_THIS_FILE == 0;
  assert IDENTIFIERS_IN_THIS_FILE == 0;
  assert TEST_FIXTURES_CARRY_A_PERSON == false;
  assert D14_APPLIES_TO_THIS_SUBJECT == true;
  assert DECISIONS[0] == "D9";
  assert DECISIONS[1] == "D14";
}

test three_measurements_are_refused_rather_than_estimated {
  assert absence_of_a_measurement_is_a_measurement(UNNAMED_ROW_COUNT_IS_KNOWN, false) == true;
  assert absence_of_a_measurement_is_a_measurement(BACKFILL_COVERAGE_IS_KNOWN, false) == true;
  assert absence_of_a_measurement_is_a_measurement(COLLISION_RATE_IS_KNOWN, false) == true;
  assert absence_of_a_measurement_is_a_measurement(true, false) == false;
  assert absence_of_a_measurement_is_a_measurement(false, true) == false;
}

; The five edges, asserted rather than merely written. Without an import form a REUSES_ string is
; the only way one contract names another's territory, and a string nothing checks is a comment
; with a type. Each inequality is the cheap guard against a copy-paste that would point an edge
; back at this file and make a loop read as a dependency. RENAMED 2026-09-22 from
; the_four_edges_are_named_by_owner_id, when the fifth edge moved into the block.
test the_five_edges_are_named_by_owner_id {
  assert REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity";
  assert REUSES_LOCALE_POLICY_ID == "turbobaby/locale-policy";
  assert REUSES_PRICING_HONESTY_ID == "turbobaby/pricing-honesty";
  assert REUSES_CUSTOMER_SURFACE_ID == "turbobaby/customer-surface";
  assert REUSES_EVENTS_BOOKING_ID == "turbobaby/events-booking";
  assert REUSE_EDGE_COUNT == 5;
  assert REUSES_REQUEST_IDENTITY_ID != ID;
  assert REUSES_LOCALE_POLICY_ID != ID;
  assert REUSES_PRICING_HONESTY_ID != ID;
  assert REUSES_CUSTOMER_SURFACE_ID != ID;
  assert REUSES_EVENTS_BOOKING_ID != ID;
}

test the_identity_edge_uses_the_declaration_name_that_side_publishes {
  assert IDENTITY_EDGE_DECLARATION_NAME == "REUSES_REQUEST_IDENTITY_ID";
  assert NAMED_BY_THE_IDENTITY_CENSUS == false;
  assert IDENTITY_CENSUS_PREDATES_THIS_FILE == true;
}

test this_contract_identifies_itself {
  assert KIND == "contract";
  assert ID == "turbobaby/person-naming";
  assert WORLD == "gHashTag/turbobaby-user-bot";
  assert MEASURED_AT == "2026-09-21";
  assert OWNER_MODULE == "src/trios/person.rs";
  assert OWNER_MODULE_LINES == 345;
}

; --- Invariants -------------------------------------------------------------------------------------

invariant a_fallback_may_never_be_printed_in_the_shape_of_a_name
  assert is_a_false_record(NAMING_FALLBACK, SHAPE_NAME) == true and may_print_as_a_name(NAMING_FALLBACK) == false

invariant a_handle_is_not_a_name_and_an_identifier_is_not_a_name
  assert HANDLE_IS_A_NAME == false and IDENTIFIER_IS_A_NAME == false and may_print_as_a_name(NAMING_HANDLE_ONLY) == false

invariant a_record_nobody_constructed_renders_as_the_fallback
  assert outcome_is_constructed(NAMING_INVALID) == false and render_shape(NAMING_INVALID) == SHAPE_FALLBACK

invariant the_render_never_leaves_an_outcome_without_a_shape
  assert render_shape(NAMING_NAMED) != SHAPE_NONE and render_shape(NAMING_HANDLE_ONLY) != SHAPE_NONE and render_shape(NAMING_FALLBACK) != SHAPE_NONE and render_shape(NAMING_INVALID) != SHAPE_NONE

invariant a_fallback_without_a_tail_or_a_marker_is_not_recognisable
  assert fallback_is_recognisable(SHAPE_FALLBACK, true, false, true) == false and fallback_is_recognisable(SHAPE_FALLBACK, true, true, false) == false

invariant the_fallback_wording_never_enters_this_file
  assert FALLBACK_TEXT_IS_HELD_HERE == false and FALLBACK_WORDING_IN_THIS_FILE == 0 and FALLBACK_WORD_BELONGS_TO_THE_CALLER == true

invariant a_name_may_be_built_only_from_the_two_name_fields
  assert field_may_build_a_name("username") == false and field_may_build_a_name("telegram_id") == false

invariant a_blank_value_can_never_become_a_name
  assert value_is_present(true, false) == false and naming_outcome(false, false, false) == NAMING_FALLBACK

invariant the_tail_is_claimed_as_distinguishing_and_never_as_unique
  assert SUFFIX_IS_UNIQUE_PER_PERSON == false and two_unknown_people_are_distinguishable(11, 11) == false

invariant an_unlabelled_number_may_not_stand_where_a_name_belongs
  assert identifier_may_occupy_the_name_slot(false) == false

invariant a_client_side_mask_is_never_a_withholding
  assert client_side_mask_withholds_the_field(WIRE_CARRIES_THE_WHOLE_IDENTIFIER) == false and field_is_withheld(false) == false

invariant a_writer_without_callers_is_not_a_writer
  assert a_writer_is_a_writer(0) == false

invariant the_census_must_account_for_every_site_it_counts
  assert census_adds_up(SITES_ROUTED_THROUGH_THE_OWNER, SITES_WITH_A_BARE_WORD_FALLBACK, SITES_WITH_A_DISTINGUISHABLE_FALLBACK, SITES_WITH_NO_FALLBACK_AT_ALL, SITES_PRINTING_A_LABELLED_IDENTIFIER) == true

invariant a_stand_in_substituted_for_a_failed_read_is_named_as_hiding_one
  assert stand_in_hides_an_error(true, true) == true and stand_in_hides_an_error(false, true) == false

; Replaced 2026-09-22. This read the_stated_handle_range_and_the_enforced_one_are_not_the_same_range
; over a local copy of the check. That disagreement is turbobaby/events-booking's, pinned there by
; the_handle_lower_bound_is_declared_and_not_enforced; what this file keeps is the consequence.
invariant an_admitted_value_below_the_stated_minimum_is_a_tap_that_cannot_resolve
  assert tap_is_promised_but_cannot_resolve(true, true) == true and tap_is_promised_but_cannot_resolve(false, true) == false

; Renamed 2026-09-22: this read the_handle_bound_stays_marked_as_another_contracts_fact_until_one_copy_goes,
; and one copy went.
invariant the_handle_bound_is_named_by_its_owner_and_never_restated_here
  assert THIS_FILE_RESTATES_THE_HANDLE_BOUND == false and HANDLE_BOUND_IS_CONSUMED_RATHER_THAN_RESTATED == true and REUSES_EVENTS_BOOKING_ID != ID

invariant three_figures_stay_refused_rather_than_estimated
  assert absence_of_a_measurement_is_a_measurement(UNNAMED_ROW_COUNT_IS_KNOWN, false) == true and absence_of_a_measurement_is_a_measurement(BACKFILL_COVERAGE_IS_KNOWN, false) == true and absence_of_a_measurement_is_a_measurement(COLLISION_RATE_IS_KNOWN, false) == true

invariant no_person_appears_in_this_contract
  assert PERSON_NAMES_IN_THIS_FILE == 0 and HANDLES_IN_THIS_FILE == 0 and IDENTIFIERS_IN_THIS_FILE == 0 and TEST_FIXTURES_CARRY_A_PERSON == false

invariant every_edge_names_another_contract_and_never_this_one
  assert REUSES_REQUEST_IDENTITY_ID != ID and REUSES_LOCALE_POLICY_ID != ID and REUSES_PRICING_HONESTY_ID != ID and REUSES_CUSTOMER_SURFACE_ID != ID and REUSES_EVENTS_BOOKING_ID != ID
