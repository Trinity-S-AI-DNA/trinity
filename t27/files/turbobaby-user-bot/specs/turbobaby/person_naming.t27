pub const NAME : str = "Person naming: a fallback is not a name, and an identifier is not a name";
pub const WORLD : str = "gHashTag/turbobaby-user-bot";
pub const MEASURED_AT : str = "2026-09-21";
pub const DECISIONS : [2]str = ["D9", "D14"];

