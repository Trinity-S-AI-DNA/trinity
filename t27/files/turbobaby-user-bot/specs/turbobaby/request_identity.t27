; The shape of the array, kept honest against the counts that describe it. This is the assertion
; that fails the day a fifteenth declarer is appended without the count being touched.
test the_consumer_census_and_the_array_describe_the_same_list {
    assert CONSUMERS.len == 23;
    assert CONSUMER_COUNT == 23;
    assert CONSUMER_COUNT_BEFORE_2026_09_26 + CONSUMERS_ADDED_2026_09_26 == CONSUMER_COUNT;
    assert CONSUMERS[22] == "turbobaby/referral-credit";
    assert CONSUMERS[22] != ID;
    assert CONSUMER_COUNT_BEFORE_THE_RE_MEASUREMENT == 8;
    assert CONSUMERS_MEASURED_ONLY == 4;
    assert FIRST_MEASURED_ONLY_INDEX == 4;
    assert LAST_MEASURED_ONLY_INDEX == 7;
    assert LAST_MEASURED_ONLY_INDEX - FIRST_MEASURED_ONLY_INDEX + 1 == CONSUMERS_MEASURED_ONLY;
    assert LAST_LATE_DECLARER_INDEX - FIRST_LATE_DECLARER_INDEX + 1 == LATE_DECLARER_COUNT;
    assert LATE_DECLARER_COUNT + CONSUMER_COUNT_BEFORE_THE_RE_MEASUREMENT + CONSUMERS_ADDED_2026_09_26 == CONSUMER_COUNT;
    assert FIRST_MEASURED_ONLY_INDEX + LATE_DECLARER_COUNT + CONSUMERS_ADDED_2026_09_26 == CONSUMERS_DECLARING_THE_EDGE;
    ; The four measured-only entries are exactly the four positions the census says they are.
    assert CONSUMERS[4] == "turbobaby/commerce";
    assert CONSUMERS[5] == "turbobaby/bike-catalog";
    assert CONSUMERS[6] == "turbobaby/availability";
    assert CONSUMERS[7] == "turbobaby/ride-game";
    assert CONSUMER_CENSUS_GREP == "grep -rlE \"^pub const REUSES_REQUEST_IDENTITY_ID\" specs/";
    ; The grep counts declarations. A looser grep for the bare ID answers more files and is not
    ; what this array holds, which is why the census names its own command.
    assert THE_CENSUS_COUNTS_DECLARATIONS_NOT_MENTIONS == true;
}

test both_keys_leave_the_data_check_string_and_only_those_two {
    assert DATA_CHECK_REMOVED_KEYS.len == DATA_CHECK_REMOVED_KEY_COUNT;
    assert DATA_CHECK_REMOVED_KEYS[0] == "hash";
    assert DATA_CHECK_REMOVED_KEYS[1] == "signature";
    assert data_check_string_includes("hash") == false;
    assert data_check_string_includes("signature") == false;
    assert data_check_string_includes("auth_date") == true;
    assert data_check_string_includes("user") == true;
    assert data_check_string_includes("query_id") == true;
    assert SIGNATURE_IS_A_THIRD_PARTY_FIELD == true;
    assert SIGNATURE_LEFT_IN_MAKES_THE_HMAC_NEVER_MATCH == true;
}

test only_the_two_signature_free_hashes_may_admit {
    assert HASH_COMPARISONS_PERFORMED == 3;
    assert HASH_COMPARISONS_THAT_CAN_ADMIT == 2;
    assert HASH_COMPARISONS_THAT_CAN_ADMIT < HASH_COMPARISONS_PERFORMED;
    assert HASH_COMPARISONS_OUTSIDE_THE_VALIDATOR_ARE_DIAGNOSTIC == true;
    assert COMPARISON_IS_CONSTANT_TIME == true;
    assert hash_variant_can_prove_identity(HASH_VARIANT_DECODED) == true;
    assert hash_variant_can_prove_identity(HASH_VARIANT_RAW) == true;
    assert hash_variant_can_prove_identity(HASH_VARIANT_WITH_SIGNATURE) == false;
    assert hash_variant_can_prove_identity(HASH_VARIANT_UNSET) == false;
    assert hash_variant_can_prove_identity(9) == false;
}

test the_input_bound_is_closed_at_4096_and_runs_before_parsing {
    assert INIT_DATA_MAX_BYTES == 4096;
    assert SIZE_CAP_PRECEDES_PARSING == true;
    assert init_data_size_admits(INIT_DATA_MAX_BYTES) == true;
    assert init_data_size_admits(4097) == false;
    assert init_data_size_admits(1) == true;
    assert init_data_present(true, 1) == true;
    assert init_data_present(true, 0) == false;
    assert init_data_present(false, 1) == false;
}

test a_stale_or_future_stamp_is_refused_and_the_edge_is_exact {
    assert AUTH_DATE_MAX_AGE_SECONDS == 86400;
    assert AUTH_DATE_IS_REQUIRED == true;
    assert FUTURE_DATED_STAMP_IS_REFUSED == true;
    assert FRESHNESS_IS_CHECKED_IN_BOTH_PATHS == true;
    assert auth_date_admits(200000, 200000) == true;
    assert auth_date_admits(113600, 200000) == true;
    assert auth_date_admits(113599, 200000) == false;
    assert auth_date_admits(200001, 200000) == false;
}

test a_failed_proof_yields_no_user_even_when_the_payload_parsed {
    assert FAILED_PROOF_YIELDS_NO_USER == true;
    assert FAILED_PROOF_YIELDS_A_DEFAULT_USER == false;
    assert IDENTITY_NONE == 0;
    assert identity_of_request(true, true) == IDENTITY_TELEGRAM_USER;
    assert identity_of_request(false, true) == IDENTITY_NONE;
    assert identity_of_request(true, false) == IDENTITY_NONE;
    assert identity_of_request(false, false) == IDENTITY_NONE;
}

test every_leg_of_the_strict_proof_can_fail_it_alone {
    assert strict_proof_ok(true, true, HASH_VARIANT_DECODED, true, true) == true;
    assert strict_proof_ok(true, true, HASH_VARIANT_RAW, true, true) == true;
    assert strict_proof_ok(false, true, HASH_VARIANT_DECODED, true, true) == false;
    assert strict_proof_ok(true, false, HASH_VARIANT_DECODED, true, true) == false;
    assert strict_proof_ok(true, true, HASH_VARIANT_WITH_SIGNATURE, true, true) == false;
    assert strict_proof_ok(true, true, HASH_VARIANT_DECODED, false, true) == false;
    assert strict_proof_ok(true, true, HASH_VARIANT_DECODED, true, false) == false;
}

test the_admin_gate_tries_init_data_first_and_falls_through_on_a_non_admin {
    assert GATE_NAMES.len == GATE_NAME_COUNT;
    assert GATE_NAMES[0] == "check_admin";
    assert GATE_NAMES[1] == "check_owner";
    assert GATE_NAMES[2] == "check_owner_lenient";
    assert init_data_proves_admin(IDENTITY_TELEGRAM_USER, true) == true;
    assert init_data_proves_admin(IDENTITY_TELEGRAM_USER, false) == false;
    assert init_data_proves_admin(IDENTITY_NONE, true) == false;
    assert admin_gate_step(true, true) == ADMIN_STEP_INIT_DATA;
    assert admin_gate_step(true, false) == ADMIN_STEP_INIT_DATA;
    assert admin_gate_step(false, true) == ADMIN_STEP_PASSWORD_TOKEN;
    assert admin_gate_step(false, false) == ADMIN_STEP_NONE;
    assert VALID_PROOF_OF_A_NON_ADMIN_ENDS_THE_GATE == false;
    assert admin_gate_step(init_data_proves_admin(IDENTITY_TELEGRAM_USER, false), true) == ADMIN_STEP_PASSWORD_TOKEN;
}

test the_password_step_carries_authority_without_naming_a_person {
    assert PASSWORD_STEP_PRINCIPAL_IS_A_SENTINEL == true;
    assert SENTINEL_PRINCIPAL_IS_A_USER == false;
    assert admin_step_names_a_person(ADMIN_STEP_INIT_DATA) == true;
    assert admin_step_names_a_person(ADMIN_STEP_PASSWORD_TOKEN) == false;
    assert admin_step_names_a_person(ADMIN_STEP_NONE) == false;
}

test the_failed_attempt_bound_matches_the_shipped_boundary_test {
    assert ADMIN_RL_WINDOW_SECONDS == 300;
    assert ADMIN_RL_MAX_ATTEMPTS == 10;
    assert ADMIN_RL_MAX_TRACKED_IPS == 10000;
    assert ADMIN_RL_COUNTS_FAILURES_ONLY == true;
    assert ADMIN_RL_IS_PER_IP == true;
    assert ADMIN_RL_IS_SHARED_BY_BOTH_ADMIN_PATHS == true;
    assert admin_attempt_admitted(0) == true;
    assert admin_attempt_admitted(9) == true;
    assert admin_attempt_admitted(ADMIN_RL_MAX_ATTEMPTS) == false;
    assert admin_attempt_admitted(11) == false;
}

test the_lenient_path_is_declared_where_it_actually_lives {
    assert LENIENT_PATH_IS_SHIPPED == true;
    assert LENIENT_PATH_SKIPS_THE_HMAC == true;
    assert LENIENT_PATH_CHECKS_ID_AND_FRESHNESS == true;
    assert LENIENT_PATH_IS_REACHED_FROM_THE_STRICT_GATE == true;
    assert LENIENT_PATH_IS_OPT_IN_PER_CALL_SITE == false;
    assert lenient_cohort(true) == LENIENT_COHORT_RECONSTRUCTED;
    assert lenient_cohort(false) == LENIENT_COHORT_SIGNED_BUT_INVALID;
    assert lenient_admits(true, true, true) == true;
    assert lenient_admits(false, true, true) == false;
    assert lenient_admits(true, false, true) == false;
    assert lenient_admits(true, true, false) == false;
}

test the_owner_gate_admits_an_unsigned_request_and_this_file_says_so {
    assert A_VALID_STRICT_PROOF_IS_TERMINAL == true;
    assert owner_gate_admits(IDENTITY_TELEGRAM_USER, true, true, false, false, false) == true;
    assert owner_gate_admits(IDENTITY_TELEGRAM_USER, false, true, true, true, true) == false;
    assert owner_gate_admits(IDENTITY_NONE, false, true, true, true, true) == true;
    assert owner_gate_admits(IDENTITY_NONE, false, false, true, true, true) == false;
    assert owner_gate_admits(IDENTITY_NONE, false, true, false, true, true) == false;
    assert owner_gate_admits(IDENTITY_NONE, false, true, true, true, false) == false;
    assert hmac_is_necessary_for_owner_access(LENIENT_PATH_IS_SHIPPED) == false;
    assert hmac_is_necessary_for_owner_access(false) == true;
}

test refusals_keep_their_two_distinct_meanings {
    assert owner_gate_outcome(false, false, false) == OUTCOME_UNAUTHORIZED;
    assert owner_gate_outcome(true, true, false) == OUTCOME_ADMITTED;
    assert owner_gate_outcome(true, false, true) == OUTCOME_FORBIDDEN;
    assert owner_gate_outcome(true, false, false) == OUTCOME_UNAUTHORIZED;
    assert refusal_http_status(OUTCOME_UNAUTHORIZED) == HTTP_UNAUTHORIZED;
    assert refusal_http_status(OUTCOME_FORBIDDEN) == HTTP_FORBIDDEN;
    assert refusal_http_status(OUTCOME_RATE_LIMITED) == HTTP_TOO_MANY_REQUESTS;
    assert refusal_http_status(OUTCOME_ADMITTED) == HTTP_STATUS_NOT_OWNED_HERE;
    assert refusal_http_status(OUTCOME_UNSET) == HTTP_STATUS_NOT_OWNED_HERE;
}

test the_gate_census_explains_why_no_endpoint_table_lives_here {
    assert GATE_CALL_SITES_ADMIN == 91;
    assert GATE_CALL_SITES_OWNER == 25;
    assert GATE_CALL_SITES_OWNER_LENIENT == 6;
    assert GATE_CALL_SITES_ADMIN + GATE_CALL_SITES_OWNER + GATE_CALL_SITES_OWNER_LENIENT == GATE_CALL_SITES_TOTAL;
    assert GATE_CALL_SITE_MODULES == 20;
    assert GATE_CALL_SITES_ADMIN_BEFORE_2026_09_26 + GATE_CALL_SITES_OWNER_BEFORE_2026_09_26 + GATE_CALL_SITES_OWNER_LENIENT == GATE_CALL_SITES_TOTAL_BEFORE_2026_09_26;
    assert GATE_CALL_SITES_ADMIN_AFTER_R1_R3 - GATE_CALL_SITES_ADMIN_BEFORE_2026_09_26 == 6;
    assert GATE_CALL_SITES_ADMIN - GATE_CALL_SITES_ADMIN_AFTER_R1_R3 == GATE_CALL_SITES_ADDED_BY_THE_TOP_LIST_ANSWER;
    assert GATE_CALL_SITES_TOTAL - GATE_CALL_SITES_TOTAL_AFTER_R1_R3 == GATE_CALL_SITES_ADDED_BY_THE_TOP_LIST_ANSWER;
    assert GATE_CALL_SITES_ADDED_BY_THE_TOP_LIST_ANSWER == 1;
    assert GATE_CALL_SITES_OWNER - GATE_CALL_SITES_OWNER_BEFORE_2026_09_26 == 2;
    assert GATE_CALL_SITE_MODULES - GATE_CALL_SITE_MODULES_BEFORE_2026_09_26 == 2;
    assert ENDPOINT_TO_GATE_MAP_IS_NOT_OWNED_HERE == true;
}

; The absences this file leans on, re-run rather than recalled. Every literal below was measured
; on 2026-09-21 over all 43 .t27 files, and the test exists so the next reader checks a number.
test the_exclusivity_claims_are_re_measured_and_not_remembered {
    assert REFUSAL_STATUS_CENSUS_MEASURED_AT == "2026-09-21";
    assert REFUSAL_STATUS_COUNT == 3;
    assert CONTRACTS_DECLARING_UNAUTHORIZED == 1;
    assert CONTRACTS_DECLARING_FORBIDDEN == 1;
    assert CONTRACTS_DECLARING_TOO_MANY_REQUESTS == 1;
    assert THE_THREE_REFUSAL_STATUSES_ARE_STILL_EXCLUSIVE == true;
    assert HTTP_UNAUTHORIZED == 401;
    assert HTTP_FORBIDDEN == 403;
    assert HTTP_TOO_MANY_REQUESTS == 429;
    ; And the half that is NOT exclusive, stated as the larger number so the two cannot be mixed.
    assert READ_TRANSPORT_STATUS_OWNER_ID == "turbobaby/catalog-api";
    assert READ_TRANSPORT_STATUS_OWNER_ID != ID;
    assert CONTRACTS_DECLARING_AN_IANA_STATUS == 9;
    assert CONTRACTS_DECLARING_BAD_REQUEST == 4;
    assert CONTRACTS_DECLARING_BAD_REQUEST > CONTRACTS_DECLARING_UNAUTHORIZED;
    assert CONTRACTS_DECLARING_AN_IANA_STATUS > CONTRACTS_DECLARING_BAD_REQUEST;
    ; The census method, pinned: nine by reading, six by prefix grep, three invisible to the grep.
    assert PREFIX_GREP_ANSWER == 6;
    assert CONTRACTS_A_PREFIX_GREP_WOULD_HAVE_MISSED == 3;
    assert PREFIX_GREP_ANSWER + CONTRACTS_A_PREFIX_GREP_WOULD_HAVE_MISSED == CONTRACTS_DECLARING_AN_IANA_STATUS;
    assert A_PEER_CONTRACT_CITES_THIS_FILES_THREE_AS_ITS_PRECEDENT == true;
    assert PEER_CITING_THIS_PRECEDENT_ID == "turbobaby/cart-persistence";
    assert PEER_CITING_THIS_PRECEDENT_ID != ID;
    assert PEER_CITING_THIS_PRECEDENT_ID == CONSUMERS[10];
    ; The two D14 homes, which the re-measurement confirmed rather than corrected.
    assert D14_ENUMERATION_HOMES.len == D14_ENUMERATION_HOME_COUNT;
    assert D14_ENUMERATION_DECLARATIONS.len == D14_ENUMERATION_HOME_COUNT;
    assert D14_ENUMERATION_HOMES[0] == "specs/agents/turbobaby.t27";
    assert D14_ENUMERATION_HOMES[1] == "specs/turbobaby/bike_catalog.t27";
    assert D14_ENUMERATION_DECLARATIONS[0] == "FORBIDDEN_FIELDS";
    assert D14_ENUMERATION_DECLARATIONS[1] == "FORBIDDEN_UNIT_FIELDS";
}

test the_named_absences_are_refused_rather_than_filled_with_a_number {
    assert LOCALHOST_BYPASS_IS_NOT_SHIPPED == true;
    assert OWNER_GATE_RATE_LIMIT_IS_NOT_SHIPPED == true;
    assert REPLAY_NONCE_STORE_IS_NOT_SHIPPED == true;
    assert ADMIN_TOKEN_EXPIRY_IS_NOT_SHIPPED == true;
    assert ADMIN_ID_LIST_IS_NOT_OWNED_HERE == true;
    assert HMAC_ARITHMETIC_IS_AN_EXTERNAL_STANDARD == true;
}

; --- Invariants ----------------------------------------------------------------------------------

invariant the_signature_key_never_reenters_the_data_check_string
    assert data_check_string_includes(DATA_CHECK_REMOVED_KEYS[1]) == false and data_check_string_includes(DATA_CHECK_REMOVED_KEYS[0]) == false

invariant a_hash_computed_over_the_signature_can_never_admit
    assert hash_variant_can_prove_identity(HASH_VARIANT_WITH_SIGNATURE) == false and hash_variant_can_prove_identity(HASH_VARIANT_UNSET) == false

invariant an_oversized_payload_is_refused_before_it_is_parsed
    assert init_data_size_admits(INIT_DATA_MAX_BYTES + 1) == false and SIZE_CAP_PRECEDES_PARSING == true

invariant a_future_dated_stamp_is_never_fresh
    assert auth_date_admits(200001, 200000) == false

invariant a_failed_proof_can_never_produce_a_user
    assert identity_of_request(false, true) == IDENTITY_NONE and identity_of_request(false, false) == IDENTITY_NONE

invariant the_password_step_never_names_a_person
    assert admin_step_names_a_person(ADMIN_STEP_PASSWORD_TOKEN) == false and SENTINEL_PRINCIPAL_IS_A_USER == false

invariant the_eleventh_failed_admin_attempt_in_a_window_is_refused
    assert admin_attempt_admitted(ADMIN_RL_MAX_ATTEMPTS) == false and admin_attempt_admitted(9) == true

invariant the_shipped_lenient_path_makes_the_hmac_sufficient_and_not_necessary
    assert hmac_is_necessary_for_owner_access(LENIENT_PATH_IS_SHIPPED) == false and owner_gate_admits(IDENTITY_NONE, false, LENIENT_PATH_IS_SHIPPED, true, true, true) == true

invariant a_signed_proof_of_the_wrong_person_is_never_retried_leniently
    assert owner_gate_admits(IDENTITY_TELEGRAM_USER, false, LENIENT_PATH_IS_SHIPPED, true, true, true) == false and A_VALID_STRICT_PROOF_IS_TERMINAL == true

invariant a_mismatched_id_is_forbidden_and_an_absent_proof_is_unauthorized
    assert owner_gate_outcome(true, false, true) == OUTCOME_FORBIDDEN and owner_gate_outcome(false, false, false) == OUTCOME_UNAUTHORIZED

invariant this_contract_takes_no_decision_from_another_contract
    assert REUSE_EDGE_COUNT == 0 and IS_OWNERSHIP_ROOT == true and CONSUMERS.len == CONSUMER_COUNT and CONSUMERS_DECLARING_THE_EDGE < CONSUMER_COUNT
