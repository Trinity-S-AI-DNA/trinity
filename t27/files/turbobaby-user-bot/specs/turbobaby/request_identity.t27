    assert CONSUMERS[12] == "turbobaby/client-errors";
    assert CONSUMERS[13] == "turbobaby/deeplink";
    assert CONSUMERS[14] == "turbobaby/events-booking";
    assert CONSUMERS[15] == "turbobaby/loyalty-ledger";
    assert CONSUMERS[16] == "turbobaby/observability";
    assert CONSUMERS[17] == "turbobaby/rate-limit";
    assert CONSUMERS[18] == "turbobaby/referral-program";
    assert CONSUMERS[19] == "turbobaby/upload-media";
    assert CONSUMERS[20] == "turbobaby/validation-bounds";
