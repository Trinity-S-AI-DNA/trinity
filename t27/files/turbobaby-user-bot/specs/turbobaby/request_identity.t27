; Which positions carry which strength, stated as numbers so a test can hold them. The declaring
; set is positions 0-3, 8-21 and, since 2026-09-26, 22; the measured-only set is positions 4-7 and
; nothing else.
pub const FIRST_MEASURED_ONLY_INDEX : u8 = 4;
pub const LAST_MEASURED_ONLY_INDEX : u8 = 7;
pub const FIRST_LATE_DECLARER_INDEX : u8 = 8;
pub const LAST_LATE_DECLARER_INDEX : u8 = 21;
pub const LATE_DECLARER_COUNT : u8 = 14;

; --- The data-check string: what is removed, and what may admit ----------------------------------
; src/api/auth.rs:148 filters BOTH keys before sorting: k != "hash" && k != "signature". `hash`
; is the claimed value and cannot be part of what it signs; `signature` is Telegram's own
; third-party field (:31-34). Removing only the first is the permanent-401 bug.
pub const DATA_CHECK_REMOVED_KEY_COUNT : u8 = 2;
pub const DATA_CHECK_REMOVED_KEYS : [2]str = ["hash", "signature"];
pub const SIGNATURE_IS_A_THIRD_PARTY_FIELD : bool = true;
pub const SIGNATURE_LEFT_IN_MAKES_THE_HMAC_NEVER_MATCH : bool = true;

pub fn data_check_string_includes(key: str) bool {
    if (key == DATA_CHECK_REMOVED_KEYS[0]) {
        return false;
    }
    if (key == DATA_CHECK_REMOVED_KEYS[1]) {
        return false;
    }
    return true;
}

; Inside validate_init_data_debug three candidate hashes are compared in constant time (:343,
; :344, :345) and exactly two of them can set ok (:349, ok = ok_decoded || ok_raw). The
; with-signature variant is computed and compared for diagnostics only and its own comment says
; so (:169). The three alt-secret hashes are computed there and compared by nothing in that
; function: constant_time_eq appears in src/api/auth.rs at :343, :344, :345 and :416 and at no
; other line of it. They ARE compared, four more times, one file away -- src/api/debug.rs:64-78
; reports ok_with_signature and the three ok_alt_secret_* flags as JSON fields. That handler
; decides nothing: it returns diagnostics and never admits a request, which is why the count
; below is of comparisons that can set ok and not of comparisons that exist in the tree. The
; codes below start at ONE so that an unset or unrecognised variant cannot prove anything, which
; is the direction that costs a login rather than grants one.
pub const HASH_VARIANT_UNSET : u8 = 0;
pub const HASH_VARIANT_DECODED : u8 = 1;
pub const HASH_VARIANT_RAW : u8 = 2;
pub const HASH_VARIANT_WITH_SIGNATURE : u8 = 3;
pub const HASH_COMPARISONS_PERFORMED : u8 = 3;
pub const HASH_COMPARISONS_OUTSIDE_THE_VALIDATOR_ARE_DIAGNOSTIC : bool = true;
pub const HASH_COMPARISONS_THAT_CAN_ADMIT : u8 = 2;
pub const COMPARISON_IS_CONSTANT_TIME : bool = true;

pub fn hash_variant_can_prove_identity(variant: u8) bool {
    if (variant == HASH_VARIANT_DECODED) {
        return true;
    }
    if (variant == HASH_VARIANT_RAW) {
        return true;
    }
    return false;
}

; --- The input bound -----------------------------------------------------------------------------
; src/api/auth.rs:70 refuses an initData longer than 4096 bytes BEFORE any parsing, returning the
; error "init_data too long" (:85). The refusal is `len() > 4096`, so the bound is INCLUSIVE:
; 4096 is accepted and 4097 is the first refused length.
; Emptiness is a separate refusal and is checked by the callers (:453, :538).
pub const INIT_DATA_MAX_BYTES : u16 = 4096;
pub const SIZE_CAP_PRECEDES_PARSING : bool = true;

pub fn init_data_size_admits(byte_len: u16) bool {
    return byte_len <= INIT_DATA_MAX_BYTES;
}

pub fn init_data_present(header_supplied: bool, byte_len: u16) bool {
    return header_supplied and byte_len > 0;
}

; --- Freshness, and the stamp from the future ----------------------------------------------------
; The same rule is implemented twice, at :371 in the strict path and at :652 in the lenient one:
; refuse when auth_date > now, and refuse when now - auth_date > 86400. A missing auth_date is
; also a refusal (:378-380). The clause is written here with addition rather than subtraction so
; that no saturating behaviour is invented: now > auth_date + 86400 is the same refusal for every
; ordering this function can be given.
pub const AUTH_DATE_MAX_AGE_SECONDS : u32 = 86400;
pub const AUTH_DATE_IS_REQUIRED : bool = true;
pub const FUTURE_DATED_STAMP_IS_REFUSED : bool = true;
pub const FRESHNESS_IS_CHECKED_IN_BOTH_PATHS : bool = true;

pub fn auth_date_admits(auth_date_seconds: u32, now_seconds: u32) bool {
    if (auth_date_seconds > now_seconds) {
        return false;
    }
    if (now_seconds > auth_date_seconds + AUTH_DATE_MAX_AGE_SECONDS) {
        return false;
    }
    return true;
}

; --- The outcome: no user, never a default -------------------------------------------------------
; validate_init_data (:40) returns an Option and its body is the whole rule: when the check failed
; it answers none (:45) even though the user field was already parsed successfully further up. A
; failed proof therefore produces no identity at all rather than an anonymous, guest or zero user.
; IDENTITY_NONE is zero for the same reason the hash codes start at one.
pub const IDENTITY_NONE : u8 = 0;
pub const IDENTITY_TELEGRAM_USER : u8 = 1;
pub const FAILED_PROOF_YIELDS_NO_USER : bool = true;
pub const FAILED_PROOF_YIELDS_A_DEFAULT_USER : bool = false;

pub fn strict_proof_ok(size_admits: bool, hash_supplied: bool, variant: u8, auth_date_supplied: bool, auth_date_ok: bool) bool {
    if (!size_admits) {
        return false;
    }
    if (!hash_supplied) {
        return false;
    }
    if (!hash_variant_can_prove_identity(variant)) {
        return false;
    }
    if (!auth_date_supplied) {
        return false;
    }
    return auth_date_ok;
}

pub fn identity_of_request(proof_ok: bool, user_field_parsed: bool) u8 {
    if (!proof_ok) {
        return IDENTITY_NONE;
    }
    if (!user_field_parsed) {
        return IDENTITY_NONE;
    }
    return IDENTITY_TELEGRAM_USER;
}

; --- Gate names and precedence, and nothing about endpoints ---------------------------------------
; The counts are call sites, measured on 2026-09-20 by grep over src/ excluding the definitions.
; They are recorded to say why no endpoint-to-gate table lives here: 113 sites over 18 modules
; -- 17 under src/api and src/main.rs:1181, which is the one that is not -- have no single owner,
; and a table that drifts is worse than no table. RE-MEASURED 2026-09-26 (gate 3 binds all four):
; 121 sites over 20 modules. The eight new sites: check_admin in the first line of
; get_leaderboard (src/api/loyalty.rs, R1), in crate::api::admin_or_missing_route (src/api/mod.rs,
; R2), and in the four admin
; routes of src/api/referral_credit.rs (R3); check_owner in its two customer routes. The two new
; modules are those two files. The readings of 2026-09-20 keep their _BEFORE_2026_09_26 names.
pub const GATE_NAME_COUNT : u8 = 3;
pub const GATE_NAMES : [3]str = ["check_admin", "check_owner", "check_owner_lenient"];
pub const GATE_CALL_SITES_ADMIN : u8 = 91;
pub const GATE_CALL_SITES_OWNER : u8 = 25;
pub const GATE_CALL_SITES_OWNER_LENIENT : u8 = 6;
pub const GATE_CALL_SITES_TOTAL : u8 = 122;
pub const GATE_CALL_SITE_MODULES : u8 = 20;
pub const GATE_CALL_SITES_ADMIN_BEFORE_2026_09_26 : u8 = 84;
pub const GATE_CALL_SITES_OWNER_BEFORE_2026_09_26 : u8 = 23;
pub const GATE_CALL_SITES_TOTAL_BEFORE_2026_09_26 : u8 = 113;
pub const GATE_CALL_SITE_MODULES_BEFORE_2026_09_26 : u8 = 18;
pub const ENDPOINT_TO_GATE_MAP_IS_NOT_OWNED_HERE : bool = true;
; RE-MEASURED AGAIN 2026-09-26, after the owner's answer on the referral top list ("remove the top
; and close the address"; turbobaby/referral-program, OWNER_TOP_LIST_ANSWER_*): 122 sites over 20
; modules. The one new site is check_admin in the first line of get_leaderboard in
; src/api/referrals.rs, a module the census already counted for its four check_owner calls. The
; readings after R1-R3, 90 and 121, are kept under _AFTER_R1_R3 names; the paragraph above is theirs.
pub const GATE_CALL_SITES_ADMIN_AFTER_R1_R3 : u8 = 90;
pub const GATE_CALL_SITES_TOTAL_AFTER_R1_R3 : u8 = 121;
pub const GATE_CALL_SITES_ADDED_BY_THE_TOP_LIST_ANSWER : u8 = 1;

; Precedence inside check_admin (:437). initData is tried first (:448-461). A valid proof of a
; non-admin id does NOT end the gate: the code says "Don't return here" and falls through to the
; password step (:462-468, :467), and so does an invalid signature (:469-472, :471). Step 2 is
; the X-Admin-Token branch (:476-477). The two steps do not name the same kind of principal,
; which the next block states.
pub const ADMIN_STEP_NONE : u8 = 0;
pub const ADMIN_STEP_INIT_DATA : u8 = 1;
pub const ADMIN_STEP_PASSWORD_TOKEN : u8 = 2;
pub const VALID_PROOF_OF_A_NON_ADMIN_ENDS_THE_GATE : bool = false;

pub fn init_data_proves_admin(identity: u8, id_is_configured_admin: bool) bool {
    return identity == IDENTITY_TELEGRAM_USER and id_is_configured_admin;
}

pub fn admin_gate_step(init_data_admin: bool, token_admin: bool) u8 {
    if (init_data_admin) {
        return ADMIN_STEP_INIT_DATA;
    }
    if (token_admin) {
        return ADMIN_STEP_PASSWORD_TOKEN;
    }
    return ADMIN_STEP_NONE;
}

; The initData step returns the authenticated id (:461); the password step returns a zero (:481).
; Zero is a sentinel meaning authority without a person, not a user id, and no code path turns it
; into one. A caller that logs it as a telegram_id is logging a user who does not exist.
pub const PASSWORD_STEP_PRINCIPAL_IS_A_SENTINEL : bool = true;
pub const SENTINEL_PRINCIPAL_IS_A_USER : bool = false;

pub fn admin_step_names_a_person(step: u8) bool {
    return step == ADMIN_STEP_INIT_DATA;
}

; --- The bound on failed admin attempts ------------------------------------------------------------
; src/api/auth.rs:433-435: a 5 * 60 second window, 10 attempts, 10000 tracked IPs. The store is
; recorded only on the failure paths (:492 in check_admin, src/api/admin.rs:583 in admin_login),
; so a success costs nothing, and both admin paths share one per-IP bucket by design (:496-501).
; The shipped test pins the boundary: the first 10 calls succeed and the eleventh is refused
; (:1049-1069, and the 429 itself at :515).
pub const ADMIN_RL_WINDOW_SECONDS : u16 = 300;
pub const ADMIN_RL_MAX_ATTEMPTS : u8 = 10;
pub const ADMIN_RL_MAX_TRACKED_IPS : u32 = 10000;
pub const ADMIN_RL_COUNTS_FAILURES_ONLY : bool = true;
pub const ADMIN_RL_IS_PER_IP : bool = true;
pub const ADMIN_RL_IS_SHARED_BY_BOTH_ADMIN_PATHS : bool = true;

pub fn admin_attempt_admitted(prior_failures_in_window: u8) bool {
    return prior_failures_in_window < ADMIN_RL_MAX_ATTEMPTS;
}

; --- The lenient path, pinned as a tripwire ---------------------------------------------------------
; Everything in this block exists so that the guarantee is not overstated. check_owner (:530)
; calls lenient_owner_verify (:596) when strict HMAC validation fails, and that function admits a
; request on a matching user id plus a fresh auth_date read straight out of the payload without
; any HMAC at all (:634-667, extraction at :613). The two failing cohorts are counted separately
; by the X-Telegram-Init-Data-Reconstructed header (:577-595) so that removing the fallback can
; one day be a decision instead of a gamble. This file does not judge the fallback; it refuses to
; hide it, and hmac_is_necessary_for_owner_access below is the sentence that cannot be softened.
pub const LENIENT_PATH_IS_SHIPPED : bool = true;
pub const LENIENT_PATH_SKIPS_THE_HMAC : bool = true;
pub const LENIENT_PATH_CHECKS_ID_AND_FRESHNESS : bool = true;
pub const LENIENT_PATH_IS_REACHED_FROM_THE_STRICT_GATE : bool = true;
pub const LENIENT_PATH_IS_OPT_IN_PER_CALL_SITE : bool = false;
pub const LENIENT_COHORT_UNSET : u8 = 0;
pub const LENIENT_COHORT_RECONSTRUCTED : u8 = 1;
pub const LENIENT_COHORT_SIGNED_BUT_INVALID : u8 = 2;

pub fn lenient_cohort(reconstructed_header_set: bool) u8 {
    if (reconstructed_header_set) {
        return LENIENT_COHORT_RECONSTRUCTED;
    }
    return LENIENT_COHORT_SIGNED_BUT_INVALID;
}

pub fn lenient_admits(user_id_matches: bool, auth_date_supplied: bool, auth_date_ok: bool) bool {
    return user_id_matches and auth_date_supplied and auth_date_ok;
}

; The lenient path is reached ONLY when strict validation produced no user at all. check_owner
; (:545) branches on validate_init_data: a valid proof whose id does not match the expected owner
; returns 403 at :555 and the function ends there, so a strict success is TERMINAL either way and
; the fallback below it is never entered. Writing the fall-through as "strict did not admit"
; instead of "strict produced no user" would state the opposite of :548-556 -- it would say a
; signed proof of the wrong person may be re-tried leniently, which is the one thing the strict
; branch refuses. The first clause therefore returns strict_id_matches rather than true.
pub const A_VALID_STRICT_PROOF_IS_TERMINAL : bool = true;

pub fn owner_gate_admits(strict_identity: u8, strict_id_matches: bool, lenient_shipped: bool, lenient_id_matches: bool, lenient_auth_date_supplied: bool, lenient_auth_date_ok: bool) bool {
    if (strict_identity == IDENTITY_TELEGRAM_USER) {
        return strict_id_matches;
    }
    if (!lenient_shipped) {
        return false;
    }
    return lenient_admits(lenient_id_matches, lenient_auth_date_supplied, lenient_auth_date_ok);
}

pub fn hmac_is_necessary_for_owner_access(lenient_shipped: bool) bool {
    return !lenient_shipped;
}

; --- Refusal outcomes -------------------------------------------------------------------------------
; A missing initData is 401 (:542), a mismatched id is 403 in both the strict (:555) and the
; lenient (:646) path, an unparseable payload is 401 (:637), a stale or future stamp is 401
; (:659), and a rate-limited admin attempt is 429 (:515). Success carries no status of its own:
; each endpoint owns what it returns, which is why the admitted outcome maps to zero here.
pub const HTTP_STATUS_NOT_OWNED_HERE : u16 = 0;
pub const HTTP_UNAUTHORIZED : u16 = 401;
pub const HTTP_FORBIDDEN : u16 = 403;
pub const HTTP_TOO_MANY_REQUESTS : u16 = 429;
; Re-measured 2026-09-21 over all 43 files, because "no contract in this corpus carried these
; before" is an absence and an absence is the one kind of claim a reader never re-runs. Each of
; the three numerals still has exactly one declaration in specs/, and it is the one above.
pub const REFUSAL_STATUS_CENSUS_MEASURED_AT : str = "2026-09-21";
pub const REFUSAL_STATUS_COUNT : u8 = 3;
pub const CONTRACTS_DECLARING_UNAUTHORIZED : u8 = 1;
pub const CONTRACTS_DECLARING_FORBIDDEN : u8 = 1;
pub const CONTRACTS_DECLARING_TOO_MANY_REQUESTS : u8 = 1;
pub const THE_THREE_REFUSAL_STATUSES_ARE_STILL_EXCLUSIVE : bool = true;
; The read-transport numerals, which are NOT exclusive and never were claimed to be after this
; measurement. The owner named here is the one whose contract they answer for, not the only file
; that spells them.
pub const READ_TRANSPORT_STATUS_OWNER_ID : str = "turbobaby/catalog-api";
pub const CONTRACTS_DECLARING_AN_IANA_STATUS : u8 = 9;
pub const CONTRACTS_DECLARING_BAD_REQUEST : u8 = 4;
; The census was taken twice and the first pass was wrong low. A grep on the HTTP_ prefix answers
; six; reading every IANA-valued u16 in specs/ answers nine. The three the prefix drops are named
; here so the smaller number cannot come back.
pub const CONTRACTS_A_PREFIX_GREP_WOULD_HAVE_MISSED : u8 = 3;
pub const PREFIX_GREP_ANSWER : u8 = 6;
pub const A_PEER_CONTRACT_CITES_THIS_FILES_THREE_AS_ITS_PRECEDENT : bool = true;
pub const PEER_CITING_THIS_PRECEDENT_ID : str = "turbobaby/cart-persistence";
; The two homes of the D14 enumerations, re-verified the same day. Named as paths because one of
; them is not a contract at all and has no contract ID to name.
pub const D14_ENUMERATION_HOME_COUNT : u8 = 2;
pub const D14_ENUMERATION_HOMES : [2]str = [
    "specs/agents/turbobaby.t27",
    "specs/turbobaby/bike_catalog.t27",
];
pub const D14_ENUMERATION_DECLARATIONS : [2]str = ["FORBIDDEN_FIELDS", "FORBIDDEN_UNIT_FIELDS"];
pub const OUTCOME_UNSET : u8 = 0;
pub const OUTCOME_ADMITTED : u8 = 1;
pub const OUTCOME_UNAUTHORIZED : u8 = 2;
pub const OUTCOME_FORBIDDEN : u8 = 3;
pub const OUTCOME_RATE_LIMITED : u8 = 4;

pub fn owner_gate_outcome(present: bool, admits: bool, id_mismatch: bool) u8 {
    if (!present) {
        return OUTCOME_UNAUTHORIZED;
    }
    if (admits) {
        return OUTCOME_ADMITTED;
    }
    if (id_mismatch) {
        return OUTCOME_FORBIDDEN;
    }
    return OUTCOME_UNAUTHORIZED;
}

pub fn refusal_http_status(outcome: u8) u16 {
    if (outcome == OUTCOME_UNAUTHORIZED) {
        return HTTP_UNAUTHORIZED;
    }
    if (outcome == OUTCOME_FORBIDDEN) {
        return HTTP_FORBIDDEN;
    }
    if (outcome == OUTCOME_RATE_LIMITED) {
        return HTTP_TOO_MANY_REQUESTS;
    }
    return HTTP_STATUS_NOT_OWNED_HERE;
}

; --- What this repository does not ship, stated rather than guessed ----------------------------------
; Five absences a reader would otherwise assume away. Each is a measurement over this tree on
; 2026-09-20, and each says what would have to exist before the constant may be deleted.
pub const LOCALHOST_BYPASS_IS_NOT_SHIPPED : bool = true;
pub const LOCALHOST_BYPASS_NOTE : str = "A sweep of src/api/auth.rs and src/api/admin.rs for localhost, 127.0.0.1 and bypass returns one line, the header comment at src/api/auth.rs:8, and no code. The absence is measured, not promised.";
pub const OWNER_GATE_RATE_LIMIT_IS_NOT_SHIPPED : bool = true;
pub const OWNER_GATE_RATE_LIMIT_NOTE : str = "record_failed_admin_attempt is called from src/api/auth.rs:492 and src/api/admin.rs:583 only, both admin paths. No owner-gate failure records an attempt, so the 10-per-5-minute bound does not cover check_owner at all. Shipping one needs a failure hook on the owner path and a decision on whether it shares the admin bucket.";
pub const REPLAY_NONCE_STORE_IS_NOT_SHIPPED : bool = true;
pub const REPLAY_NONCE_NOTE : str = "Freshness is the only replay bound: a captured initData stays usable for the remainder of its 86400 seconds. A case-insensitive grep of src/api/auth.rs for nonce, jti and replay returns zero lines -- not a weak store but no vocabulary for one at all. The nearest thing in the file is the staleness refusal itself, the error text at :374 and the expiry test at :932, neither of which remembers a stamp it has already seen. A used-stamp store would need somewhere to persist it, which this repository has not chosen.";
pub const ADMIN_TOKEN_EXPIRY_IS_NOT_SHIPPED : bool = true;
pub const ADMIN_TOKEN_EXPIRY_NOTE : str = "generate_admin_token (src/api/auth.rs:403-412) mixes the bot token and the password and nothing else, so the token carries no issued-at and no expiry and stays valid until one of those two changes. No revocation or logout path exists in this file.";
pub const ADMIN_ID_LIST_IS_NOT_OWNED_HERE : bool = true;
pub const ADMIN_ID_NOTE : str = "Membership is tested against runtime configuration at src/api/auth.rs:455 and arrives here as the boolean id_is_configured_admin. Naming a real admin id in a public spec would be the leak this gate exists to prevent.";
pub const HMAC_ARITHMETIC_IS_AN_EXTERNAL_STANDARD : bool = true;

; --- Tests ---------------------------------------------------------------------------------------

test this_contract_is_a_root_and_names_its_consumers_instead {
    assert IS_OWNERSHIP_ROOT == true;
    assert REUSE_EDGE_COUNT == 0;
    assert CONSUMERS.len == CONSUMER_COUNT;
    ; Re-measured 2026-09-21: 18 of the 22, not the 4 of the first writing; 19 of 23 since 2026-09-26.
    assert CONSUMERS_DECLARING_THE_EDGE == 19;
    assert CONSUMERS_DECLARING_THE_EDGE < CONSUMER_COUNT;
    assert CONSUMERS_DECLARING_THE_EDGE + CONSUMERS_MEASURED_ONLY == CONSUMER_COUNT;
    assert CONSUMER_COUNT > CONSUMER_COUNT_BEFORE_THE_RE_MEASUREMENT;
    assert CONSUMERS[0] == "turbobaby/catalog-write";
    assert CONSUMERS[1] == "turbobaby/game-score";
    assert CONSUMERS[2] == "turbobaby/star-award";
    assert CONSUMERS[3] == "turbobaby/order-status";
    assert CONSUMERS[4] == "turbobaby/commerce";
    assert CONSUMERS[5] == "turbobaby/bike-catalog";
    assert CONSUMERS[6] == "turbobaby/availability";
    assert CONSUMERS[7] == "turbobaby/ride-game";
    assert CONSUMERS[0] != ID;
    assert CONSUMERS[3] != ID;
    assert CONSUMERS[7] != ID;
}

; The first four inbound edges spelled exactly as their own files spell them. If a consumer
; renames this contract's ID on its side, its assert and this one disagree and the pair says which
; moved. The other fourteen declarers found on 2026-09-21 get the same treatment in the test below
; this one; they are kept apart because these four are also the four the file was born naming.
test the_declared_inbound_edges_name_this_contract_by_its_own_id {
    assert ID == "turbobaby/request-identity";
    assert CONSUMERS[0] == "turbobaby/catalog-write";
    assert CONSUMERS[1] == "turbobaby/game-score";
    assert CONSUMERS[2] == "turbobaby/star-award";
    assert CONSUMERS[3] == "turbobaby/order-status";
    assert CONSUMERS[0] != CONSUMERS[1];
    assert CONSUMERS[1] != CONSUMERS[2];
    assert CONSUMERS[0] != CONSUMERS[2];
    assert CONSUMERS[3] != CONSUMERS[0];
    assert CONSUMERS[3] != CONSUMERS[4];
}

