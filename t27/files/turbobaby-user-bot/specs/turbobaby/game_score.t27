// SPDX-License-Identifier: Apache-2.0
; specs/turbobaby/game_score.t27 -- the server-side high-score ledger, and the era it cannot name
; This contract owns one table and the two routes over it: what a submission is admitted on,
; what survives in the row, and what the public board is allowed to prove. It owns nothing the
; client decides. The once-only submission gate belongs to ride_runtime.t27, the star payout
; belongs to star_award.t27, and the proof of who the submitter is belongs to
; request_identity.t27. Each is named below as an ID string and consumed as a boolean, because a
; second copy of a rule that already has an owner is the defect this corpus exists to prevent.
; --
; WHY (measured 2026-09-20, re-run 2026-09-21). Issue #14 asks that the biker game reuse this
; path, "adding only a game_key discriminator if one is absent". It is absent, and the measurement
; is a zero:
;   grep -rn "game_key" migrations/ src/ assets/ | wc -l  ->  0
; No migration, no server source and no shipped game asset carries THAT name. The zero is scoped
; to those three trees ON PURPOSE and the scope is now stated instead of implied, because an
; absence with an unstated scope is the defect this corpus can least afford. Measured the same
; day over the specs/ tree, which the command above never touched: game_key occurs in exactly ONE
; of the 43 .t27 files, this one, where it names the thing that is missing. A game is named
; elsewhere -- the star credit the same submitter sends three lines later does carry one, which is
; recorded below -- so the zero is a property of this ledger and not of the repository. The table is
; migrations/027_game_high_scores.sql, and line 7 is the whole problem: telegram_id is the
; PRIMARY KEY by itself. One player is one row, one row is one number, and src/api/game.rs:120
; merges an arriving submission into that number with GREATEST. A ride-era run and a catch-era
; run by the same player therefore land in the SAME row, the larger number wins, and after the
; write no field anywhere in the row records which game produced the survivor. This file states
; that as a measured consequence with an invariant, not as a worry in a comment.
; --
; WHERE THE ISSUE IS REFUTED. "Adding only a game_key discriminator ... so skate-era rows stay
; distinguishable from ride-era rows" does not follow from adding a COLUMN. While telegram_id
; remains the sole PRIMARY KEY, the upsert at src/api/game.rs:118 still conflicts on the player
; alone, so the second era overwrites the first era's discriminator inside the one row the
; player is allowed to have -- the new column is destroyed by the same statement that would have
; used it. Rows stay distinct only when the KEY is the pair. That is why eras_are_distinguishable
; below takes the column AND its presence in the key, and is false for the column alone.
; --
; WHERE THE OBVIOUS READING IS REFUTED (measured 2026-09-20, every line of it re-run 2026-09-21
; and unchanged). Neither game asset posts to this
; endpoint. assets/game/skate.js does not exist: assets/game/ride.js:3 records that it replaced
; it, and commit 4a230fc deleted it. A grep over assets/ for the endpoint returns nothing at all,
; and the single caller in the repository is src/ui/screens/ride_screen.rs:68, a Rust host.
; assets/game/catch.js -- Woody Catch, the game migration 027 line 1 was written for -- is
; mounted by no code today: the only assets/game import under src/ is ride.js, at
; src/ui/screens/ride_screen.rs:236. These are citations into src/ and assets/ and they stay as
; line numbers, because a line into a tree this file does not own is checkable against that tree;
; what does not stay is a line number into a sibling .t27, and this file carries none. The era collision is therefore not a live race between two
; writers; it is a property of a row that has outlived its first writer and will outlive its
; second. A discriminator justified only by "two games write today" would be justified by
; nothing, and a discriminator refused for the same reason would be refused by nothing.
; --
; WHAT THIS FILE NEVER DOES. It carries no player, no handle, no display-name value, no board
; content, no rank and no money (D14). It invents no column name, no default and no migration
; number for a discriminator this repository has not written: DECISIONS.md D1 keeps the numbering
; gap-free and D2 forbids editing 001-076, so the number belongs to whoever writes the migration
; on the day they write it. It never claims the rows already in the table can be labelled
; afterwards -- nothing in them records a game, so a backfill would be a guess, and the refusal
; below says exactly that. It restates no rule that has an owner: the client gate, the star
; payout and the identity proof arrive here as booleans.
; phi^2 + 1/phi^2 = 3 | TRINITY

module turbobaby-game-score;

pub const KIND : str = "ledger";
pub const ID : str = "turbobaby/game-score";
pub const NAME : str = "TurboBaby server-side high-score ledger";
pub const WORLD : str = "gHashTag/turbobaby-user-bot";
pub const ISSUE : str = "#14";
pub const MEASURED_AT : str = "2026-09-20";

; --- Where every number below was read ----------------------------------------------------------
pub const LEDGER_TABLE : str = "game_high_scores";
pub const LEDGER_MIGRATION : str = "migrations/027_game_high_scores.sql";
pub const DISPLAY_NAME_MIGRATION : str = "migrations/066_garden_social.sql";
pub const SERVER_IMPLEMENTATION : str = "src/api/game.rs";
pub const ONLY_SHIPPED_SUBMITTER : str = "src/ui/screens/ride_screen.rs";
pub const REGRESSION_WITNESS : str = "tests/integration_game_scores.rs";
pub const SUBMIT_ENDPOINT : str = "POST /api/game/high-scores";
pub const BOARD_ENDPOINT : str = "GET /api/game/high-scores";

; --- Ownership edges, spelled as IDs because this language has no import ------------------------
; ride_runtime.t27 decides whether the client may submit at all (its score_submit_allowed, the
; once-only rule keyed on a real terminal end). This file consumes that verdict as one boolean
; and re-derives none of its event algebra. star_award.t27 owns the payout: a score is a number
; in this table, a star is currency elsewhere, and nothing here converts one into the other.
; request_identity.t27 owns the proof that the submitter is the player named in the body.
pub const REUSES_RIDE_RUNTIME_ID : str = "turbobaby/ride-runtime";
pub const REUSES_STAR_AWARD_ID : str = "turbobaby/star-award";
pub const REUSES_REQUEST_IDENTITY_ID : str = "turbobaby/request-identity";
pub const A_SCORE_IS_NOT_A_STAR : bool = true;
; turbobaby/catalog-api owns page budgets for GET /api/bikes -- PAGE_LIMIT_MIN, PAGE_LIMIT_DEFAULT
; and PAGE_LIMIT_MAX -- and calls them CHOSEN protocol budgets.
; The board budgets recorded further down were measured out of src/api/game.rs for a different
; endpoint and happen to carry the same magnitudes. Neither file consumes the other's; this
; constant exists so a reader who notices the coincidence does not read it as one rule twice.
; Re-checked 2026-09-21, and the coincidence is now recorded from BOTH sides rather than only
; this one: that contract's own review the same day found that its three budgets match a shipped
; ladder exactly, named the ladder as src/api/game.rs:33-35 and src/api/game.rs:50 -- which is
; this file's leaderboard limit -- and wrote down that the agreement is precedent and not
; derivation. Two files measuring the same coincidence independently and agreeing on what it is
; NOT is the strongest form this claim can take here, so the constant below is kept and dated
; rather than softened.
pub const CATALOG_API_PAGE_BUDGETS_GOVERN_A_DIFFERENT_ENDPOINT : bool = true;
pub const PAGE_BUDGET_COINCIDENCE_RE_CHECKED_AT : str = "2026-09-21";
pub const PAGE_BUDGET_COINCIDENCE_IS_NAMED_FROM_BOTH_SIDES : bool = true;
pub const PAGE_BUDGET_COINCIDENCE_IS_DERIVATION : bool = false;
pub const CATALOG_API_OWNER_ID : str = "turbobaby/catalog-api";

; --- The shape of the row (migrations/027_game_high_scores.sql) ---------------------------------
; Line 6 creates the table; line 7 makes telegram_id the PRIMARY KEY on its own; line 8 holds one
; INTEGER high_score; line 9 holds updated_at. display_name is not in 027 at all -- it was added
; later by migrations/066_garden_social.sql:33 as a plain column with a placeholder default,
; which is precisely the shape a discriminator must NOT copy.
pub const KEY_COLUMNS_TODAY : u8 = 1;
pub const ROWS_PER_PLAYER : u8 = 1;
pub const STORED_SCORES_PER_PLAYER : u8 = 1;
pub const KEY_COLUMNS_FOR_DISTINCT_ERAS : u8 = 2;
; The zero that makes issue #14 real, from the grep quoted in the header. The tree it was taken
; over is named beside it, because a zero without a scope is a claim nobody can re-run: this one
; counts migrations/, src/ and assets/ and nothing else.
pub const GAME_KEY_OCCURRENCES : u32 = 0;
pub const GAME_KEY_SCOPE : str = "migrations/ src/ assets/";
pub const GAME_KEY_RE_RUN_AT : str = "2026-09-21";
; The other tree, measured separately on the same day so the two are never conflated. The
; measurement over specs/ counts DECLARATIONS and not mentions, and the reason is worth the two
; lines: a draft of this block counted .t27 files MENTIONING the discriminator's name, said one,
; and was made wrong by a second contract writing a sentence about the absence -- the sentence
; contained the name. A count that any contract can break by describing the thing counted is not
; a measurement of the repository, it is a measurement of the prose. So what is pinned is the
; declaration: exactly one contract in the 43 declares the absence, and it is this one.
pub const CORPUS_FILE_COUNT : u8 = 43;
pub const CONTRACTS_DECLARING_THE_ABSENCE : u8 = 1;
pub const THE_ABSENCE_IS_DECLARED_ONLY_HERE : bool = true;
pub const THE_CENSUS_COUNTS_DECLARATIONS_NOT_MENTIONS : bool = true;
; Re-measured 2026-09-22 and deliberately NOT bound: a census of the corpus moves with every new
; contract. CORPUS_FILE_COUNT above is KEPT at 43, the reading the declaration count was taken
; over. 14b01ac added order_presentation.t27 and person_naming.t27 later on 2026-09-21, and specs/
; holds 45 tracked .t27 files. Re-run at a33e500 over the 45, game_key occurs in one file, this
; one, so no other contract can declare the absence and the declaration count is still one.
pub const CORPUS_FILE_COUNT_REMEASURED : u8 = 45;
pub const CORPUS_FILE_COUNT_REMEASURED_AT : str = "2026-09-22";
pub const CONTRACTS_DECLARING_THE_ABSENCE_REMEASURED : u8 = 1;

; --- Who writes to the ledger (measured 2026-09-20) ---------------------------------------------
pub const ENDPOINT_CALLERS_IN_REPOSITORY : u8 = 1;
pub const GAME_ASSETS_POSTING_TO_THE_ENDPOINT : u8 = 0;
pub const SKATE_ERA_ASSET_EXISTS : bool = false;
pub const CATCH_ERA_ASSET_IS_MOUNTED : bool = false;
; CORRECTED 2026-09-25: the catch-era asset no longer exists either. The owner's ruling of that day
; (#12, nothing cannabis-related anywhere) removed assets/game/catch.js, whose falling pieces
; included a leaf and a bud, with the rest of the old shop's served media; the removal is recorded
; by turbobaby/legacy-retirement as ORPHANED_ASSET_REMOVED. No code mounted it before and none mounts
; it now, so CATCH_ERA_ASSET_IS_MOUNTED is unchanged. The refutation paragraph in the header is the
; 2026-09-21 reading: its "neither game asset" now has one member, ride.js, which still does not
; post to this endpoint. The rows the catch era wrote are untouched; nothing here moves a score.
pub const CATCH_ERA_ASSET_EXISTS : bool = false;
pub const CATCH_ERA_ASSET_REMOVED_AT : str = "2026-09-25";
; src/ui/screens/ride_screen.rs:66 sends the run's DISTANCE in the score field. The catch-era
; game the table was built for counted points. Two different quantities have therefore been
; written into one INTEGER column across the eras, which is a second reason the surviving number
; is not comparable across them -- and, like the first, it is unrecorded in the row.
pub const SUBMITTED_QUANTITY_IS_ERA_DEPENDENT : bool = true;

; --- A column is not a key ----------------------------------------------------------------------
; The one function issue #14 turns on. A discriminator distinguishes rows only when it exists AND
; the key selects on it; the column alone leaves the upsert conflicting on the player.
pub fn eras_are_distinguishable(discriminator_column_exists: bool, discriminator_is_in_the_key: bool) bool {
  return discriminator_column_exists and discriminator_is_in_the_key;
}

pub fn key_column_count(key_has_player: bool, key_has_game: bool) u8 {
  if (key_has_player and key_has_game) {
    return KEY_COLUMNS_FOR_DISTINCT_ERAS;
  }
  if (key_has_player or key_has_game) {
    return KEY_COLUMNS_TODAY;
  }
  return 0;
}

pub fn two_runs_share_one_row(same_player: bool, distinguishable: bool) bool {
  return same_player and !distinguishable;
}

pub fn surviving_era_is_recoverable(same_player: bool, distinguishable: bool) bool {
  return !two_runs_share_one_row(same_player, distinguishable);
}

; --- The merge (src/api/game.rs:116-122) ---------------------------------------------------------
; INSERT ... ON CONFLICT (telegram_id) DO UPDATE SET high_score = GREATEST(existing, arriving).
; Stated as a function of two numbers and nothing else: no era, no timestamp, no game enters it.
pub fn surviving_score(stored: i32, submitted: i32) i32 {
  if (submitted > stored) {
    return submitted;
  }
  return stored;
}

; --- Admission (src/api/game.rs:97-106) -----------------------------------------------------------
; MAX_SCORE is src/api/game.rs:25; the floor is src/api/game.rs:100, which refuses a negative and
; admits zero -- tests/integration_game_scores.rs:221-226 pins zero as a real score rather than an
; invalid one. MAX_DISPLAY_NAME_LEN is src/api/game.rs:24 and is enforced at :104 after the blank
; name is replaced at :103; the length is the only thing this file records about that value.
pub const SCORE_MIN_ACCEPTED : i32 = 0;
pub const SCORE_MAX_ACCEPTED : i32 = 10000000;
pub const DISPLAY_NAME_MAX_LEN : u16 = 50;

pub fn submitted_score_is_admissible(score: i32) bool {
  return score >= SCORE_MIN_ACCEPTED and score <= SCORE_MAX_ACCEPTED;
}

; identity_proved is request_identity.t27's verdict, arriving as a boolean. id_param_valid is the
; separate numeric check at src/api/game.rs:97. The two are distinct: a well-formed identifier
; that belongs to somebody else is refused by the first and passed by the second, which is what
; tests/integration_game_scores.rs:330-364 proves by expecting a refusal rather than a write.
pub fn submission_admitted(identity_proved: bool, id_param_valid: bool, score: i32, display_name_len: u16) bool {
  return identity_proved and id_param_valid and submitted_score_is_admissible(score) and display_name_len <= DISPLAY_NAME_MAX_LEN;
}

; --- The client gate the server cannot see --------------------------------------------------------
; src/api/game.rs counts no submissions and carries no nonce; the only once-only gate is the
; client's, at src/ui/screens/ride_screen.rs:164-166, whose rule ride_runtime.t27 owns. So the
; full path is a conjunction, and the server half of it is blind to the client half.
pub const SERVER_ENFORCES_THE_ONCE_ONLY_RULE : bool = false;
pub const SUBMISSION_CARRIES_NO_IDEMPOTENCY_KEY : bool = true;

pub fn score_reaches_the_ledger(client_gate_passed: bool, server_admits_it: bool) bool {
  return client_gate_passed and server_admits_it;
}

; Replay safety here is a property of GREATEST, not of a check. A resubmission that is not larger
; leaves the row untouched, which is why an undetectable replay is harmless; a LARGER replay is
; indistinguishable from a better run and is supposed to win.
pub fn replay_changes_the_stored_row(stored: i32, replayed: i32) bool {
  return surviving_score(stored, replayed) != stored;
}

; --- What the response says, and what the row holds -------------------------------------------------
; src/api/game.rs:160 answers with the score that arrived, and src/api/game.rs:142 counts the
; players standing above the score that arrived. Neither reads the number that survived the merge,
; so both describe the row only when the arriving score is the survivor. The stored half of the
; scenario is witnessed by tests/integration_game_scores.rs:143-164 -- 5000 then 10 leaves 5000
; stored, asserted at :159-163. The reported half is NOT asserted there: that test checks only the
; status of the second submit (:157), so "the second response is computed from 10" is read out of
; :144 and :162 above and no test in the repository pins it.
pub const RESPONSE_REPORTS_THE_ARRIVING_SCORE : bool = true;
pub const RANK_IS_COUNTED_AGAINST_THE_ARRIVING_SCORE : bool = true;

pub fn response_describes_the_stored_row(stored: i32, submitted: i32) bool {
  return submitted == surviving_score(stored, submitted);
}

; --- The board is a window, not the ledger ---------------------------------------------------------
; Default 20 at src/api/game.rs:33-35, clamped into 1..100 at src/api/game.rs:50. The function
; below is stated at the MAXIMUM window on purpose: it describes the most generous board the
; endpoint can serve, so a false from it is unconditional, while a true from it holds only for a
; caller that asked for 100 -- at the default 20 the board stops proving anything five times
; sooner. That is the property tests/integration_game_scores.rs:86-90 had to work around: once the
; table is fuller than the window, not being on the board says nothing about the row.
pub const LEADERBOARD_LIMIT_MIN : u32 = 1;
pub const LEADERBOARD_LIMIT_DEFAULT : u32 = 20;
pub const LEADERBOARD_LIMIT_MAX : u32 = 100;

pub fn board_shows_every_row(rows_in_ledger: u32) bool {
  return rows_in_ledger <= LEADERBOARD_LIMIT_MAX;
}

pub fn absence_from_board_proves_absence_from_ledger(board_is_complete: bool) bool {
  return board_is_complete;
}

; --- Asymmetry of the two routes -------------------------------------------------------------------
; The POST passes an owner gate (src/api/game.rs:98); the GET takes no headers at all
; (src/api/game.rs:46-49) and answers with the name public_display_name allows (src/api/game.rs:80).
; What that gate PROVES is not judged here, and must not be read out of the line above:
; request_identity.t27 owns the gate and pins a lenient path that the strict one falls through to,
; so "passes the gate" is a weaker fact than "the signature verified". This file records which
; route carries a gate and which carries none, and restates no part of that tripwire.
; CORRECTED 2026-09-24. Until that day anonymity of the board was a property of what submitters
; put in the column, not of the endpoint -- and the only shipped submitter built the name out of
; the player's own identifier (src/ui/screens/ride_screen.rs:66 sent "Player" plus the id), which
; the anonymous route published verbatim: every rider's Telegram id was public. Now the endpoint
; enforces it on both routes: public_display_name (src/api/game.rs:178) turns a blank name, a name
; holding the player's own id, or a name holding a run of IDENTIFIER_DIGIT_RUN digits into the
; placeholder, on the read (so rows stored before the fix are covered with no write to the live
; table) and on the write (src/api/game.rs:103). The ride screen sends no name at all. The unit
; test a_name_carrying_the_players_telegram_id_is_never_published in src/api/game.rs pins it, and
; tests/leaderboard_anonymity_wiring.rs pins the screen as text. No name, real or placeholder, is
; carried in this file.
pub const SUBMISSION_PASSES_THE_OWNER_GATE : bool = true;
pub const OWNER_GATE_STRENGTH_IS_NOT_JUDGED_HERE : bool = true;
pub const BOARD_READ_IS_ANONYMOUS : bool = true;
pub const BOARD_RETURNS_THE_STORED_DISPLAY_NAME : bool = false;
pub const SHIPPED_SUBMITTER_DERIVES_THE_NAME_FROM_THE_IDENTIFIER : bool = false;
pub const BOARD_MASKS_A_NAME_THAT_CARRIES_AN_IDENTIFIER : bool = true;
pub const WRITE_STORES_THE_PLACEHOLDER_FOR_A_NAME_THAT_CARRIES_AN_IDENTIFIER : bool = true;
pub const IDENTIFIER_DIGIT_RUN : u8 = 6;
pub const STORED_ROWS_ARE_REWRITTEN_BY_THE_FIX : bool = false;

; A submitter who sends nothing gets the server's placeholder in the row (src/api/game.rs:103),
; and a placeholder is the most anonymous entry a board can show. The unsupplied case is therefore
; anonymous; before 2026-09-24 anonymity failed when a SUPPLIED name was built out of the player's
; own identifier, which is exactly what the one shipped submitter did. The function below keeps
; that reading of a name; the board no longer lets such a name through.
pub fn board_entry_is_anonymous(name_is_submitter_supplied: bool, name_is_derived_from_the_identifier: bool) bool {
  if (!name_is_submitter_supplied) {
    return true;
  }
  return !name_is_derived_from_the_identifier;
}

; --- The gap is in this table, not in the product's vocabulary ------------------------------------
; The one shipped submitter sends both calls from one spawned block: the score at
; src/ui/screens/ride_screen.rs:67-72 and the star credit at :82-86. The star body (:79-81) carries
; a field naming the game that earned the payout and a fresh per-run key minted at :78; the score
; body at :66 carries neither. So a game CAN be named on the wire today, and the credit path
; already names it -- star_award.t27 owns that vocabulary and not one value of it is restated here.
; The absence recorded below is an absence in game_high_scores, not an absence of the idea.
pub const STAR_CALL_NAMES_ITS_GAME : bool = true;
pub const STAR_CALL_CARRIES_A_PER_RUN_KEY : bool = true;
pub const SCORE_CALL_NAMES_NO_GAME : bool = true;
pub const GAME_SOURCE_VOCABULARY_IS_OWNED_ELSEWHERE : bool = true;

; --- Honest refusals -------------------------------------------------------------------------------
; Each of these is a gap in the repository, named rather than filled. A plausible column name or a
; next free migration number written here would read as a decision that nobody made.
pub const GAME_DISCRIMINATOR_IS_NOT_SHIPPED_IN_THIS_LEDGER : bool = true;
pub const DISCRIMINATOR_COLUMN_NAME_IS_NOT_INVENTED_HERE : bool = true;
pub const DISCRIMINATOR_MIGRATION_NUMBER_IS_NOT_INVENTED_HERE : bool = true;
pub const PRE_DISCRIMINATOR_ROW_ERA_IS_NOT_RECOVERABLE : bool = true;
pub const LEADERBOARD_CONTENT_IS_NOT_CARRIED_HERE : bool = true;
pub const NO_DISPLAY_NAME_VALUE_IS_CARRIED_HERE : bool = true;
pub const DISCRIMINATOR_MISSING_NOTE : str = "no game_key column, no default and no migration exists; a forward migration under DECISIONS.md D1 and D2 would have to put the game inside the PRIMARY KEY, not beside it";
pub const BACKFILL_MISSING_NOTE : str = "rows written before a discriminator record no game in any column, so their era can be guessed but never derived";
pub const MIGRATION_NUMBERING_OWNER : str = "DECISIONS.md D1, D2";

; --- Tests -------------------------------------------------------------------------------------

test the_ledger_holds_one_row_and_one_number_per_player {
  assert KEY_COLUMNS_TODAY == 1;
  assert ROWS_PER_PLAYER == 1;
  assert STORED_SCORES_PER_PLAYER == 1;
  assert KEY_COLUMNS_FOR_DISTINCT_ERAS == 2;
  assert KEY_COLUMNS_FOR_DISTINCT_ERAS > KEY_COLUMNS_TODAY;
}

test the_repository_contains_no_game_discriminator {
  assert GAME_KEY_OCCURRENCES == 0;
  assert GAME_DISCRIMINATOR_IS_NOT_SHIPPED_IN_THIS_LEDGER == true;
  assert eras_are_distinguishable(false, false) == false;
  ; The scope of the zero, pinned so the number cannot be quoted without the tree it was taken
  ; over. Re-run 2026-09-21 and still zero.
  assert GAME_KEY_SCOPE == "migrations/ src/ assets/";
  assert GAME_KEY_RE_RUN_AT == "2026-09-21";
  ; And the tree that grep never visited, measured separately and by DECLARATION: one contract of
  ; the 43 declares this absence, and it is this one. Counting mentions instead gives a number
  ; that any contract can change by writing a sentence, which is why it is not the number pinned.
  assert CORPUS_FILE_COUNT == 43;
  assert CONTRACTS_DECLARING_THE_ABSENCE == 1;
  assert CONTRACTS_DECLARING_THE_ABSENCE < CORPUS_FILE_COUNT;
  assert THE_ABSENCE_IS_DECLARED_ONLY_HERE == true;
  assert THE_CENSUS_COUNTS_DECLARATIONS_NOT_MENTIONS == true;
}

; Corrected 2026-09-22: the declaration count above was taken over 43 files, and the corpus grew to
; 45 the same day. Re-run over the 45, it has not moved.
test the_declaration_census_was_re_run_over_the_grown_corpus {
  assert CORPUS_FILE_COUNT_REMEASURED == 45;
  assert CORPUS_FILE_COUNT_REMEASURED_AT == "2026-09-22";
  assert CORPUS_FILE_COUNT_REMEASURED > CORPUS_FILE_COUNT;
  assert CONTRACTS_DECLARING_THE_ABSENCE_REMEASURED == 1;
  assert CONTRACTS_DECLARING_THE_ABSENCE_REMEASURED == CONTRACTS_DECLARING_THE_ABSENCE;
  assert CONTRACTS_DECLARING_THE_ABSENCE_REMEASURED < CORPUS_FILE_COUNT_REMEASURED;
}

; The coincidence with the catalog contract's page budgets, dated and pinned. Both files measured
; it independently on 2026-09-21 and both recorded that it is precedent rather than derivation;
; this assertion is this file's half, and it goes red if a later reader turns the coincidence into
; a consumed edge without either owner agreeing to one.
test the_page_budget_coincidence_is_precedent_and_not_an_edge {
  assert PAGE_BUDGET_COINCIDENCE_RE_CHECKED_AT == "2026-09-21";
  assert CATALOG_API_PAGE_BUDGETS_GOVERN_A_DIFFERENT_ENDPOINT == true;
  assert PAGE_BUDGET_COINCIDENCE_IS_NAMED_FROM_BOTH_SIDES == true;
  assert PAGE_BUDGET_COINCIDENCE_IS_DERIVATION == false;
  assert CATALOG_API_OWNER_ID == "turbobaby/catalog-api";
  assert CATALOG_API_OWNER_ID != ID;
  ; The magnitudes that coincide, stated here so the claim names the numbers it is about.
  assert LEADERBOARD_LIMIT_MIN == 1;
  assert LEADERBOARD_LIMIT_DEFAULT == 20;
  assert LEADERBOARD_LIMIT_MAX == 100;
  ; No REUSES_ constant names the catalog contract, which is what "not an edge" means in a corpus
  ; with no imports. The three that ARE edges are named instead.
  assert CATALOG_API_OWNER_ID != REUSES_RIDE_RUNTIME_ID;
  assert CATALOG_API_OWNER_ID != REUSES_STAR_AWARD_ID;
  assert CATALOG_API_OWNER_ID != REUSES_REQUEST_IDENTITY_ID;
}

test a_discriminator_column_outside_the_key_changes_nothing {
  assert eras_are_distinguishable(true, false) == false;
  assert eras_are_distinguishable(false, true) == false;
  assert eras_are_distinguishable(true, true) == true;
  assert key_column_count(true, false) == KEY_COLUMNS_TODAY;
  assert key_column_count(true, true) == KEY_COLUMNS_FOR_DISTINCT_ERAS;
  assert key_column_count(false, false) == 0;
}

test two_eras_of_one_player_occupy_one_row_today {
  assert two_runs_share_one_row(true, false) == true;
  assert two_runs_share_one_row(true, true) == false;
  assert two_runs_share_one_row(false, false) == false;
  assert surviving_era_is_recoverable(true, false) == false;
  assert surviving_era_is_recoverable(true, true) == true;
  assert surviving_era_is_recoverable(false, false) == true;
}

test the_merge_keeps_the_larger_number_from_either_direction {
  assert surviving_score(5000, 10) == 5000;
  assert surviving_score(10, 5000) == 5000;
  assert surviving_score(900, 900) == 900;
  assert surviving_score(0, 0) == 0;
  assert surviving_score(100, 900) == 900;
}

test the_quantity_in_the_column_is_not_the_same_thing_across_eras {
  assert SUBMITTED_QUANTITY_IS_ERA_DEPENDENT == true;
  assert surviving_era_is_recoverable(true, false) == false;
  assert ENDPOINT_CALLERS_IN_REPOSITORY == 1;
  assert GAME_ASSETS_POSTING_TO_THE_ENDPOINT == 0;
  assert SKATE_ERA_ASSET_EXISTS == false;
  assert CATCH_ERA_ASSET_IS_MOUNTED == false;
  // Removed 2026-09-25 (owner's ruling #12); unmounted before and after.
  assert CATCH_ERA_ASSET_EXISTS == false;
  assert CATCH_ERA_ASSET_REMOVED_AT == "2026-09-25";
}

test score_admission_is_a_closed_interval_that_admits_zero {
  assert submitted_score_is_admissible(0) == true;
  assert submitted_score_is_admissible(-1) == false;
  assert submitted_score_is_admissible(SCORE_MAX_ACCEPTED) == true;
  assert submitted_score_is_admissible(SCORE_MAX_ACCEPTED + 1) == false;
  assert submitted_score_is_admissible(42) == true;
}

test submission_needs_identity_a_valid_parameter_a_score_and_a_short_name {
  assert submission_admitted(true, true, 42, 6) == true;
  assert submission_admitted(false, true, 42, 6) == false;
  assert submission_admitted(true, false, 42, 6) == false;
  assert submission_admitted(true, true, -1, 6) == false;
  assert submission_admitted(true, true, SCORE_MAX_ACCEPTED + 1, 6) == false;
  assert submission_admitted(true, true, 42, DISPLAY_NAME_MAX_LEN) == true;
  assert submission_admitted(true, true, 42, DISPLAY_NAME_MAX_LEN + 1) == false;
}

test the_server_half_of_the_path_is_blind_to_the_client_gate {
  assert SERVER_ENFORCES_THE_ONCE_ONLY_RULE == false;
  assert SUBMISSION_CARRIES_NO_IDEMPOTENCY_KEY == true;
  assert score_reaches_the_ledger(true, true) == true;
  assert score_reaches_the_ledger(false, true) == false;
  assert score_reaches_the_ledger(true, false) == false;
}

test an_undetectable_replay_is_harmless_only_because_the_merge_is_idempotent {
  assert replay_changes_the_stored_row(5000, 5000) == false;
  assert replay_changes_the_stored_row(5000, 10) == false;
  assert replay_changes_the_stored_row(10, 5000) == true;
  assert replay_changes_the_stored_row(0, 0) == false;
}

test the_answer_describes_the_row_only_when_the_arriving_score_wins {
  assert RESPONSE_REPORTS_THE_ARRIVING_SCORE == true;
  assert RANK_IS_COUNTED_AGAINST_THE_ARRIVING_SCORE == true;
  assert response_describes_the_stored_row(10, 5000) == true;
  assert response_describes_the_stored_row(5000, 5000) == true;
  assert response_describes_the_stored_row(5000, 10) == false;
}

test the_board_window_cannot_prove_a_row_absent {
  assert LEADERBOARD_LIMIT_MIN == 1;
  assert LEADERBOARD_LIMIT_DEFAULT == 20;
  assert LEADERBOARD_LIMIT_MAX == 100;
  assert board_shows_every_row(0) == true;
  assert board_shows_every_row(LEADERBOARD_LIMIT_MAX) == true;
  assert board_shows_every_row(LEADERBOARD_LIMIT_MAX + 1) == false;
  assert absence_from_board_proves_absence_from_ledger(board_shows_every_row(LEADERBOARD_LIMIT_MAX + 1)) == false;
}

test the_write_passes_a_gate_and_the_read_passes_none {
  assert SUBMISSION_PASSES_THE_OWNER_GATE == true;
  assert OWNER_GATE_STRENGTH_IS_NOT_JUDGED_HERE == true;
  assert BOARD_READ_IS_ANONYMOUS == true;
  assert BOARD_RETURNS_THE_STORED_DISPLAY_NAME == false;
  assert SHIPPED_SUBMITTER_DERIVES_THE_NAME_FROM_THE_IDENTIFIER == false;
  assert BOARD_MASKS_A_NAME_THAT_CARRIES_AN_IDENTIFIER == true;
  assert WRITE_STORES_THE_PLACEHOLDER_FOR_A_NAME_THAT_CARRIES_AN_IDENTIFIER == true;
  assert IDENTIFIER_DIGIT_RUN == 6;
  assert STORED_ROWS_ARE_REWRITTEN_BY_THE_FIX == false;
  assert board_entry_is_anonymous(true, false) == true;
  assert board_entry_is_anonymous(true, true) == false;
  assert board_entry_is_anonymous(false, false) == true;
}

test the_credit_path_already_names_the_game_this_ledger_cannot {
  assert STAR_CALL_NAMES_ITS_GAME == true;
  assert STAR_CALL_CARRIES_A_PER_RUN_KEY == true;
  assert SCORE_CALL_NAMES_NO_GAME == true;
  assert GAME_SOURCE_VOCABULARY_IS_OWNED_ELSEWHERE == true;
  assert SUBMISSION_CARRIES_NO_IDEMPOTENCY_KEY == true;
  assert GAME_KEY_OCCURRENCES == 0;
}

test the_gaps_are_named_and_not_filled {
  assert DISCRIMINATOR_COLUMN_NAME_IS_NOT_INVENTED_HERE == true;
  assert DISCRIMINATOR_MIGRATION_NUMBER_IS_NOT_INVENTED_HERE == true;
  assert PRE_DISCRIMINATOR_ROW_ERA_IS_NOT_RECOVERABLE == true;
  assert LEADERBOARD_CONTENT_IS_NOT_CARRIED_HERE == true;
  assert NO_DISPLAY_NAME_VALUE_IS_CARRIED_HERE == true;
  assert MIGRATION_NUMBERING_OWNER == "DECISIONS.md D1, D2";
}

test the_ownership_edges_are_literal_and_cannot_be_deleted_silently {
  assert REUSES_RIDE_RUNTIME_ID == "turbobaby/ride-runtime";
  assert REUSES_STAR_AWARD_ID == "turbobaby/star-award";
  assert REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity";
  assert REUSES_RIDE_RUNTIME_ID != ID;
  assert REUSES_STAR_AWARD_ID != ID;
  assert REUSES_REQUEST_IDENTITY_ID != ID;
  assert A_SCORE_IS_NOT_A_STAR == true;
  assert CATALOG_API_PAGE_BUDGETS_GOVERN_A_DIFFERENT_ENDPOINT == true;
}

; --- Invariants --------------------------------------------------------------------------------

invariant one_player_is_one_row_and_one_number
  assert ROWS_PER_PLAYER == 1 and STORED_SCORES_PER_PLAYER == 1 and KEY_COLUMNS_TODAY == 1

invariant a_discriminator_outside_the_key_never_separates_two_eras
  assert eras_are_distinguishable(true, false) == false and key_column_count(true, false) == KEY_COLUMNS_TODAY

invariant distinguishable_eras_require_the_key_to_be_the_pair
  assert eras_are_distinguishable(true, true) == true and key_column_count(true, true) == KEY_COLUMNS_FOR_DISTINCT_ERAS

invariant the_row_keeps_the_larger_number_and_nothing_about_its_game
  assert surviving_score(900, 100) == 900 and surviving_score(100, 900) == 900 and surviving_era_is_recoverable(true, false) == false

invariant the_repository_ships_no_discriminator_today
  assert GAME_KEY_OCCURRENCES == 0 and GAME_DISCRIMINATOR_IS_NOT_SHIPPED_IN_THIS_LEDGER == true and eras_are_distinguishable(false, false) == false

invariant a_negative_score_never_reaches_the_row
  assert submitted_score_is_admissible(-1) == false and submission_admitted(true, true, -1, 0) == false

invariant an_unidentified_submitter_never_reaches_the_row
  assert submission_admitted(false, true, 42, 6) == false

invariant the_server_cannot_be_credited_with_the_once_only_rule
  assert SERVER_ENFORCES_THE_ONCE_ONLY_RULE == false and score_reaches_the_ledger(false, submission_admitted(true, true, 42, 6)) == false

invariant an_exact_replay_of_the_surviving_score_cannot_change_the_row
  assert replay_changes_the_stored_row(5000, 5000) == false and replay_changes_the_stored_row(5000, 10) == false

invariant a_worse_arriving_score_is_reported_although_the_row_kept_the_better_one
  assert response_describes_the_stored_row(5000, 10) == false and surviving_score(5000, 10) == 5000

invariant a_truncated_board_proves_nothing_about_a_missing_row
  assert absence_from_board_proves_absence_from_ledger(board_shows_every_row(LEADERBOARD_LIMIT_MAX + 1)) == false

; CORRECTED 2026-09-24: the conjunct SHIPPED_SUBMITTER_DERIVES_THE_NAME_FROM_THE_IDENTIFIER == true
; recorded the leak; the fix makes it false and moves the refusal onto the board itself.
invariant an_identifier_derived_name_is_not_an_anonymous_board_entry
  assert board_entry_is_anonymous(true, true) == false and SHIPPED_SUBMITTER_DERIVES_THE_NAME_FROM_THE_IDENTIFIER == false and BOARD_MASKS_A_NAME_THAT_CARRIES_AN_IDENTIFIER == true

invariant the_absent_discriminator_is_absent_from_this_ledger_and_not_from_the_product
  assert GAME_DISCRIMINATOR_IS_NOT_SHIPPED_IN_THIS_LEDGER == true and SCORE_CALL_NAMES_NO_GAME == true and STAR_CALL_NAMES_ITS_GAME == true

invariant the_gate_on_the_write_is_recorded_without_being_graded
  assert SUBMISSION_PASSES_THE_OWNER_GATE == true and OWNER_GATE_STRENGTH_IS_NOT_JUDGED_HERE == true and BOARD_READ_IS_ANONYMOUS == true

invariant a_row_without_a_submitted_name_is_an_anonymous_board_entry
  assert board_entry_is_anonymous(false, false) == true and board_entry_is_anonymous(true, true) == false

invariant no_era_is_invented_for_the_rows_already_written
  assert PRE_DISCRIMINATOR_ROW_ERA_IS_NOT_RECOVERABLE == true and DISCRIMINATOR_MIGRATION_NUMBER_IS_NOT_INVENTED_HERE == true
