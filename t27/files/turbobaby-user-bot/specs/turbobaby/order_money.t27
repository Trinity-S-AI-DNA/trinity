// SPDX-License-Identifier: Apache-2.0
; specs/turbobaby/order_money.t27 -- the arithmetic identity a submitted order must satisfy
; This contract owns one equation and the guards standing around it: the total of an order is its
; subtotal less the bonus applied and less the star discount, floored at zero, and a claimed total
; is accepted only if it agrees with that figure to one minor unit. It owns nothing about WHO is
; allowed to name an amount, and nothing about how a line price or a rental total is produced. It
; receives a subtotal, a bonus, a star count and a claimed total as already-decided numbers and
; answers one question: do they add up.
; --
; WHY (measured 2026-09-20). This identity is hand-written THREE times, in two languages, and
; only one of the three is tested. src/api/orders.rs:210 computes the expected total in the Axum
; validator. The Dioxus/WASM checkout computes it twice more: src/ui/screens/checkout_screen.rs:731
; for the figure the customer is shown, and src/ui/screens/checkout_screen.rs:1012 for the figure it
; puts into the request body at src/ui/screens/checkout_screen.rs:1025 as the total field the server
; will then check. src/ui/screens/checkout_screen.rs holds zero occurrences of the test attribute,
; so neither client copy is exercised by anything -- re-counted 2026-09-21 and still zero. Hand-copied computation is exactly the defect
; DECISIONS.md:201-233 (D15) names, and D15's own table lists three copies of the PRICE arithmetic
; and none of these -- the order identity has been a second, unlisted family of copies the whole
; time. D15 closes with the remedy this file is: a .t27 spec pins the arithmetic, so the two
; runtimes are checked against one written contract rather than against each other.
; --
; WHY THE TOLERANCE IS ONE MINOR UNIT AND NOT A FLOAT. The shipped gate at src/api/orders.rs:215
; refuses when the absolute difference between the claimed and the recomputed total exceeds a
; hundredth of a baht. A hundredth is not a magic slack: it is one minor unit of the market
; currency. How many minor digits a market has is owned by turbobaby/market, which declares
; MINOR_DIGITS_MIN, MINOR_DIGITS_MAX and minor_digits_is_legal, and is NOT restated here.
; Re-verified 2026-09-21 and still true in both directions: that contract holds the exponent, and
; no constant in this file is one. This file carries the count of minor units (one) and takes the
; scale as an argument, so the identity holds for a market with a different exponent. Every amount below is an integer in
; minor units for the same reason -- a contract that re-enacted the float would inherit the
; float's undecidable boundary, and the repository never probes that boundary (see the note).
; --
; WHERE THE ISSUE IS REFUTED. The brief for this file says the bonus policy is an unowned input
; never given a number, on the measurement that data/fleet_seed.json contains zero occurrences of
; loyalty and of bonus. The measurement is right and the inference is wrong. The number exists:
; src/trios/loyalty.rs:34-46 is a standing default block that holds max_bonus_usage_pct 30.0 at
; src/trios/loyalty.rs:43 beside three cashback percentages and three tier thresholds. So the
; policy is owned, just not by the seed and not by this file. What is true is narrower, and it is
; what the contract says: the bonus reaches this identity as an amount already decided, the
; identity subtracts it without asking where it came from, and the percentage ceiling is a
; separate gate that runs AFTER this one at src/api/orders.rs:1293-1305.
; --
; WHAT THIS FILE NEVER DOES: it takes no rate and no number of days, so it computes no line price
; and no rental total; it converts no currency and holds no exchange rate; it declares no loyalty
; tier, no cashback percentage and no bonus ceiling; it decides no availability and no deposit; it
; names no customer, handle, phone, plate, key code, debt, purchase price or personal note
; (DECISIONS.md:186-199, D14), and carries no payment credential and no PromptPay payload. It also
; never decides whether a balance covers what the body asks to spend: that is a stored quantity,
; not arithmetic over the submitted numbers.
; phi^2 + 1/phi^2 = 3 | TRINITY

module turbobaby-order-money;

pub const KIND : str = "contract";
pub const ID : str = "turbobaby/order-money";
pub const NAME : str = "TurboBaby order money identity";
pub const IMPLEMENTATION_BOUNDARY : str = "client proposal -> server recomputation -> accepted order";

; --- Reuse edges -------------------------------------------------------------------------------
; Current t27c does not support brace imports, so a neighbour is named by its ID and pinned by a
; test. Each line below is a decision this file consumes and deliberately does not restate.
;
;   commerce        owns WHO may name an amount: the browser origin, the snapshot origin, and the
;                   per-subject dispositions. This file owns only whether the numbers add up, and
;                   it asks no origin of any argument.
;   market          owns the ISO minor-digit count. This file takes the resulting scale as the
;                   minor_unit_scale argument and never writes an exponent of its own.
;   rental-terms    owns rate times span and the class and term discount bands. No function here
;                   accepts a rate or a day count.
;   pricing-honesty owns the door-versus-file divergence decision, whose threshold is also spelled
;                   1. The two ones are different facts: theirs is one baht per day between two
;                   quoted rates, this one is one MINOR unit between a claimed order total and the
;                   server's recomputation of it. Neither is derived from the other.
;   deposit-tiers   owns the deposit ladder and the refund identity, including the no-FX rule. A
;                   deposit is not a term of the order total and does not appear below.
;   star-award      owns how a star is AWARDED and the idempotency of that award.
;   ride-runtime    owns the client-side boundary that may REQUEST an award and the rule that the
;                   server, not the client, decides it.
;                   Between them a star arrives already earned. This file owns only what a star is
;                   worth when it is SPENT as a discount, which is the one fact neither declares.
; THE LAST SENTENCE IS AN ABSENCE, so it was re-run on 2026-09-21 rather than left standing on the
; day it was written. `grep -rn "STAR_VALUE" specs/` answers with this file and no other, and the
; two neighbours name the gap rather than filling it -- star_award.t27 says in its own header that
; "what a Star is worth when SPENT is order_money's too", and it holds REUSES_ORDER_MONEY_ID.
; The re-measurement also found a THIRD file agreeing from outside the pair: loyalty_ledger.t27
; names order-money as the owner of "the identity the bonus is a TERM of, and what a star is worth
; when spent". Four contracts hold REUSES_ORDER_MONEY_ID today (checkout-contact, delivery-terms,
; loyalty-ledger, star-award) and not one of them declares a star value. The count is a constant
; below, because "nobody else declares this" is exactly the claim a reader trusts without checking.
pub const REUSES_COMMERCE_ID : str = "turbobaby/commerce";
pub const REUSES_MARKET_PROFILE_ID : str = "turbobaby/market";
pub const REUSES_RENTAL_TERMS_ID : str = "turbobaby/rental-terms";
pub const REUSES_PRICING_HONESTY_ID : str = "turbobaby/pricing-honesty";
pub const REUSES_DEPOSIT_TIERS_ID : str = "turbobaby/deposit-tiers";
pub const REUSES_RIDE_RUNTIME_ID : str = "turbobaby/ride-runtime";
pub const REUSES_STAR_AWARD_ID : str = "turbobaby/star-award";

; --- The money model ----------------------------------------------------------------------------
; Amounts are integers in minor units. minor_unit_scale is how many minor units make one major
; unit; it is the market contract's fact, supplied as an argument, never a constant here.
pub const ZERO_MINOR : i64 = 0;
; The floor at src/api/orders.rs:210 is exactly zero, not a small negative slack.
pub const TOTAL_FLOOR_MINOR : i64 = ZERO_MINOR;
; src/api/orders.rs:198, :207 and :215 each allow a hundredth of a baht, which is one minor unit.
pub const TOLERANCE_MINOR_UNITS : i64 = 1;
; src/api/orders.rs:59 states the rate and src/api/orders.rs:206 applies it: the star count becomes
; the discount with no coefficient, so one star is one MAJOR unit.
; src/ui/screens/admin_screen.rs:3043 renders a stored star count through the baht formatter,
; which is the same rate seen from the other end of the system.
pub const STAR_VALUE_IN_MAJOR_UNITS : i64 = 1;
; The exclusivity of the line above, measured and not assumed. Re-run 2026-09-21 over all 43 .t27
; files: one declaration of a star's spend value in the corpus, here. The inbound edges are the
; other half of the same measurement -- four contracts point AT this file, and a pointer is only
; worth something while the thing pointed at is the single home of the fact.
pub const STAR_VALUE_CENSUS_MEASURED_AT : str = "2026-09-21";
pub const CONTRACTS_DECLARING_A_STAR_SPEND_VALUE : u8 = 1;
pub const INBOUND_EDGE_COUNT : u8 = 4;
pub const INBOUND_EDGES : [4]str = [
  "turbobaby/checkout-contact",
  "turbobaby/delivery-terms",
  "turbobaby/loyalty-ledger",
  "turbobaby/star-award",
];
; src/api/orders.rs:202 -- the per-transaction ceiling on stars spent, a count and not an amount.
pub const MAX_STARS_PER_TRANSACTION : i64 = 1000000;
; src/api/orders.rs:180 -- the envelope both the subtotal and the total must sit inside, in major
; units, with the sentence that fixes the figure at src/api/orders.rs:177-178.
pub const MAX_ORDER_AMOUNT_MAJOR_UNITS : i64 = 100000000;

; --- Verdicts -----------------------------------------------------------------------------------
; The shipped path answers every one of these with the same transport status, so the status is not
; a discriminant and no HTTP constant is declared here. Re-verified 2026-09-21 against a census of
; the whole corpus: NINE contracts declare a transport status numeral of their own and this file
; is not one of them. The nine were counted by reading every IANA-valued u16 in specs/ rather than
; by grepping the HTTP_ prefix, which answers six -- three contracts spell a status without either
; word in the name. Here the distinction changes nothing, because the count this file cares about
; is its own and that one is zero either way. What differs, and what is worth naming, is
; WHICH gate refused: src/api/orders.rs:189, :192, :196, :199, :204, :208 and :216 are seven
; distinct returns collapsed into one wire answer.
pub const VERDICT_INVALID : u8 = 0;
pub const VERDICT_ACCEPT : u8 = 1;
pub const VERDICT_REFUSE_NOT_FINITE : u8 = 2;
pub const VERDICT_REFUSE_OUT_OF_RANGE : u8 = 3;
pub const VERDICT_REFUSE_BONUS_ABOVE_SUBTOTAL : u8 = 4;
pub const VERDICT_REFUSE_STARS_ABOVE_CEILING : u8 = 5;
pub const VERDICT_REFUSE_DISCOUNT_ABOVE_REMAINDER : u8 = 6;
pub const VERDICT_REFUSE_TOTAL_DISAGREES : u8 = 7;
pub const VERDICT_COUNT : u8 = 7;
pub const REFUSAL_NAMES : [6]str = [
  "not_finite",
  "out_of_range",
  "bonus_above_subtotal",
  "stars_above_ceiling",
  "discount_above_remainder",
  "total_disagrees",
];

pub fn order_money_verdict_is_known(verdict: u8) bool {
  return verdict >= VERDICT_ACCEPT and verdict <= VERDICT_COUNT;
}

pub fn order_money_verdict_is_refusal(verdict: u8) bool {
  return verdict >= VERDICT_REFUSE_NOT_FINITE and verdict <= VERDICT_REFUSE_TOTAL_DISAGREES;
}

; --- The pieces of the identity --------------------------------------------------------------
; The shipped path clamps three times before it subtracts: src/api/orders.rs:194 on the bonus,
; :201 on the star count, :210 on the result. A clamp is not a refusal -- a negative bonus becomes
; no bonus and the order continues -- and writing it as a refusal would reject orders the server
; accepts today.
pub fn order_money_clamp_at_zero(amount_minor: i64) i64 {
  if (amount_minor < ZERO_MINOR) {
    return ZERO_MINOR;
  }
  return amount_minor;
}

; src/api/orders.rs:206. The count becomes an amount with no coefficient of its own; the only
; thing that turns it into minor units is the market's scale.
pub fn order_money_star_discount_minor(stars_used: i64, minor_unit_scale: i64) i64 {
  return order_money_clamp_at_zero(stars_used) * STAR_VALUE_IN_MAJOR_UNITS * minor_unit_scale;
}

; src/api/orders.rs:201-205. The ceiling is compared against the CLAMPED count, so a negative one
; is admissible as zero rather than refused.
pub fn order_money_stars_admissible(stars_used: i64) bool {
  return order_money_clamp_at_zero(stars_used) <= MAX_STARS_PER_TRANSACTION;
}

; src/api/orders.rs:198. Strictly above subtotal plus one minor unit refuses; exactly one minor
; unit above is tolerated, which is the same asymmetry the total gate has.
pub fn order_money_bonus_admissible(bonus_minor: i64, subtotal_minor: i64) bool {
  return order_money_clamp_at_zero(bonus_minor) <= subtotal_minor + TOLERANCE_MINOR_UNITS;
}

; src/api/orders.rs:207. The star discount is bounded by what the bonus left behind, not by the
; subtotal, so the two discounts cannot each consume the whole bill.
pub fn order_money_discount_admissible(star_discount_minor: i64, subtotal_minor: i64, bonus_minor: i64) bool {
  return star_discount_minor <= subtotal_minor - order_money_clamp_at_zero(bonus_minor) + TOLERANCE_MINOR_UNITS;
}

; src/api/orders.rs:210 -- THE IDENTITY. Note which arguments are absent: no claimed total, no
; origin, no authority flag. The figure the server will compare against cannot be moved by
; anything the browser sent, because nothing the browser sent is in this signature.
pub fn order_money_expected_total_minor(subtotal_minor: i64, bonus_minor: i64, star_discount_minor: i64) i64 {
  return order_money_clamp_at_zero(subtotal_minor - order_money_clamp_at_zero(bonus_minor) - star_discount_minor);
}

pub fn order_money_gap_minor(a_minor: i64, b_minor: i64) i64 {
  if (a_minor >= b_minor) {
    return a_minor - b_minor;
  }
  return b_minor - a_minor;
}

; src/api/orders.rs:215. Refusal is strictly-greater-than, so a gap of exactly one minor unit is
; accepted and a gap of two is not.
pub fn order_money_total_agrees(claimed_total_minor: i64, expected_total_minor: i64) bool {
  return order_money_gap_minor(claimed_total_minor, expected_total_minor) <= TOLERANCE_MINOR_UNITS;
}

pub fn order_money_max_amount_minor(minor_unit_scale: i64) i64 {
  return MAX_ORDER_AMOUNT_MAJOR_UNITS * minor_unit_scale;
}

; src/api/orders.rs:188 and :191, minus the finiteness leg, which an integer cannot express.
pub fn order_money_amount_in_range(amount_minor: i64, max_amount_minor: i64) bool {
  return amount_minor >= ZERO_MINOR and amount_minor <= max_amount_minor;
}

; --- The whole gate, in the order the server runs it -------------------------------------------
; The ORDER is a measured fact and not a presentation choice: the envelope check on the total runs
; at src/api/orders.rs:188, before the identity at :215. A body that is both out of range and
; inconsistent is refused by the envelope. Finiteness enters as a declared boolean because a
; non-finite amount has no integer image; the three flags sit where the three shipped checks sit.
pub fn order_money_verdict(subtotal_minor: i64, claimed_total_minor: i64, bonus_minor: i64, stars_used: i64, minor_unit_scale: i64, total_is_finite: bool, subtotal_is_finite: bool, bonus_is_finite: bool) u8 {
  if (!total_is_finite) {
    return VERDICT_REFUSE_NOT_FINITE;
  }
  if (!order_money_amount_in_range(claimed_total_minor, order_money_max_amount_minor(minor_unit_scale))) {
    return VERDICT_REFUSE_OUT_OF_RANGE;
  }
  if (!subtotal_is_finite) {
    return VERDICT_REFUSE_NOT_FINITE;
  }
  if (!order_money_amount_in_range(subtotal_minor, order_money_max_amount_minor(minor_unit_scale))) {
    return VERDICT_REFUSE_OUT_OF_RANGE;
  }
  if (!bonus_is_finite) {
    return VERDICT_REFUSE_NOT_FINITE;
  }
  if (!order_money_bonus_admissible(bonus_minor, subtotal_minor)) {
    return VERDICT_REFUSE_BONUS_ABOVE_SUBTOTAL;
  }
  if (!order_money_stars_admissible(stars_used)) {
    return VERDICT_REFUSE_STARS_ABOVE_CEILING;
  }
  if (!order_money_discount_admissible(order_money_star_discount_minor(stars_used, minor_unit_scale), subtotal_minor, bonus_minor)) {
    return VERDICT_REFUSE_DISCOUNT_ABOVE_REMAINDER;
  }
  if (!order_money_total_agrees(claimed_total_minor, order_money_expected_total_minor(subtotal_minor, bonus_minor, order_money_star_discount_minor(stars_used, minor_unit_scale)))) {
    return VERDICT_REFUSE_TOTAL_DISAGREES;
  }
  return VERDICT_ACCEPT;
}

; --- Propose and recompute ---------------------------------------------------------------------
; Three implementations, one deciding. A client copy is a proposal even when it is correct, and
; there are two of them: the figure the customer is shown and the figure the body carries.
pub const IDENTITY_IMPLEMENTATION_COUNT : u8 = 3;
; Client addresses re-taken 2026-09-21 and re-read at their new lines (:721 -> :731,
; :973 -> :1012) after an unreachable 409 arm was deleted from the same screen and a cart-price
; refusal was added above the submit path. Both copies still compute the same identity; only the
; addresses moved. One RENAME goes with the move and is recorded rather than smoothed over: the
; subtrahend at :1012 reads `priced_subtotal` instead of `cart_total`, because the cart's total is
; an Option now and is None when a line has no published price. That branch never reaches this
; arithmetic -- the handler refuses an unquotable cart before it -- so on every path that gets
; here the two names hold the same number.
pub const IDENTITY_IMPLEMENTATIONS : [3]str = [
  "src/api/orders.rs:210",
  "src/ui/screens/checkout_screen.rs:731",
  "src/ui/screens/checkout_screen.rs:1012",
];
pub const CLIENT_IDENTITY_COPY_COUNT : u8 = 2;
; The two client copies are not even the same shape, and the difference is recorded without
; claiming a disagreement the shipped clamps do not permit.
pub const CLIENT_COPIES_ARE_SHAPED_DIFFERENTLY : bool = true;
pub const CLIENT_COPY_SHAPE_NOTE : str = "src/ui/screens/checkout_screen.rs:728 and :731 floor twice, once after the bonus is subtracted and again after the stars, while src/ui/screens/checkout_screen.rs:1012 subtracts both and floors once, which is the shape src/api/orders.rs:210 uses. Measured 2026-09-20 at :718/:721/:973/:712-720 and re-read 2026-09-21 at the addresses above, unchanged in shape: the clamps at src/ui/screens/checkout_screen.rs:722-730 hold the bonus at or below the cart subtotal and the star count at or below what the bonus left, so no input reachable through the shipped path separates the two shapes. What is claimed here is that three hand-written copies exist, not that they disagree today.";
pub const SERVER_RECOMPUTATION_DECIDES : bool = true;
pub const CLIENT_COMPUTATION_IS_A_PROPOSAL : bool = true;
pub const AUTHORITY_RULE_IS_NOT_OWNED_HERE : bool = true;
pub const PROPOSE_RECOMPUTE_NOTE : str = "src/api/orders.rs:58-60 says it in the struct itself: one star is one baht, the balance is debited server-side and atomically, and the client only proposes the amount and never sets the fiat discount. The debit is a conditional update inside the order transaction at src/api/orders.rs:1488-1504 which refuses when it affects no row, so a star count in the body is a request to spend. Whether that request is authoritative is the commerce contract's rule and not this file's; what this file pins is the structural half -- order_money_expected_total_minor has no argument the browser controls.";

; Balance sufficiency is a stored quantity, not arithmetic over the submitted numbers, and this
; file refuses to pretend otherwise rather than modelling a balance it never sees.
pub const BALANCE_SUFFICIENCY_IS_NOT_DECIDED_HERE : bool = true;

; --- Declared absences --------------------------------------------------------------------------
pub const RATE_TIMES_SPAN_IS_NOT_COMPUTED_HERE : bool = true;
pub const CURRENCY_CONVERSION_IS_NOT_PERFORMED_HERE : bool = true;
pub const MINOR_DIGIT_COUNT_IS_NOT_RESTATED_HERE : bool = true;
pub const MINOR_UNIT_SCALE_IS_AN_ABSTRACT_PARAMETER : bool = true;

; The corrected bonus fact. Both measurements travel together in the note, because the count
; alone invites the wrong inference.
pub const BONUS_POLICY_IS_NOT_A_TERM_OF_THIS_IDENTITY : bool = true;
pub const FLEET_SEED_LOYALTY_MENTIONS : u8 = 0;
pub const FLEET_SEED_BONUS_MENTIONS : u8 = 0;
; The two zeros above are an ABSENCE and were re-run on 2026-09-21 rather than quoted from the
; day they were taken: data/fleet_seed.json is 19434 bytes and still holds zero of each,
; case-insensitive. The corpus now carries a second reader of the same measurement, which is the
; reason to pin the date: loyalty_ledger.t27 re-ran it the same day, records the identical
; numbers, and names THIS file as the owner of the finding rather than restating the inference.
; A measurement with two readers and one owner is the shape this corpus wants; a measurement with
; two readers and two owners is the second table it exists to prevent.
pub const SEED_MEASUREMENT_RE_RUN_AT : str = "2026-09-21";
; CORRECTED 2026-09-24: 19434 was the size of one host's CRLF WORKING COPY, not of the file. The
; committed blob of data/fleet_seed.json, unchanged since a544414 (2026-09-13), is 19084 bytes
; (git cat-file -s HEAD:data/fleet_seed.json) and holds 350 newlines; a checkout with
; core.autocrlf=true writes each one as two bytes, and 19084 + 350 = 19434. So the old figure
; reproduced only on the host that took it, and read 19084 on every LF checkout -- CI, Linux, or
; this repository checked out with autocrlf off. The size declared now is the blob's, which no
; checkout setting moves; the working-copy reading is kept under its _BEFORE_ name, and the line
; count is declared beside both so the two reconcile by arithmetic, and so that gate 3 can bind
; the one line-ending-independent number (Python reads either checkout as the same 350 lines).
; The two zeros above do not depend on line endings; re-read the same day on the blob, the seed
; still holds zero of each, case-insensitive.
; RE-MEASURED 2026-09-25, because the seed changed: the owner's decision of that day on what is
; offered instead of CLICK 125 (DECISIONS.md, the D12 amendment of 2026-09-25) rewrote
; pricing_policy.not_offered.click-125 and added the dated source it rests on, without moving a
; line -- every line citation into the seed from the other contracts still lands where it did. The
; committed blob is 20161 bytes and still 350 lines; 19084 is kept under its _BEFORE_ name, and it
; is the size the 2026-09-24 arithmetic above reconciles. Re-read on the new blob: zero of each
; word, case-insensitive, so the two zeros still stand.
pub const FLEET_SEED_BYTES : u32 = 20161;
pub const FLEET_SEED_BYTES_BEFORE_2026_09_24 : u32 = 19434;
pub const FLEET_SEED_BYTES_BEFORE_2026_09_25 : u32 = 19084;
pub const FLEET_SEED_LINES : u32 = 350;
pub const FLEET_SEED_BYTES_ARE_THE_COMMITTED_BLOB : bool = true;
pub const FLEET_SEED_BYTES_REMEASURED_AT : str = "2026-09-25";
pub const A_SECOND_CONTRACT_CITES_THIS_SEED_MEASUREMENT : bool = true;
pub const SEED_MEASUREMENT_SECOND_READER_ID : str = "turbobaby/loyalty-ledger";
pub const BONUS_POLICY_NOTE : str = "Measured 2026-09-20: data/fleet_seed.json contains zero occurrences of loyalty and zero of bonus, case-insensitive. That does NOT make the policy unowned. src/trios/loyalty.rs:34-46 is a standing default block holding max_bonus_usage_pct 30.0 at src/trios/loyalty.rs:43 next to three cashback percentages and three tier thresholds; src/trios/loyalty.rs:86-92 clamps a stored value into the legal percentage range or falls back to that default; src/api/orders.rs:1293-1305 turns it into a ceiling and refuses above it. All of that runs AFTER the identity here has passed, and none of it is a term of the identity, so restating any number of it here would be the hand-copied computation D15 forbids.";

; The float boundary the repository never probes. Recorded so a later reader does not read the
; integer model as a claim about what the shipped comparison does at exactly one minor unit.
pub const SHIPPED_TOLERANCE_IS_A_FLOAT_COMPARISON : bool = true;
pub const TOLERANCE_BOUNDARY_IS_UNTESTED_IN_THE_REPOSITORY : bool = true;
pub const TOLERANCE_BOUNDARY_NOTE : str = "src/api/orders.rs:215 compares two f64 values against a hundredth. The repository's own tolerance test at src/api/orders.rs:3251-3255 probes a gap of nine thousandths -- strictly inside the tolerance -- and no test anywhere probes a gap of exactly one minor unit, so the shipped behaviour at the boundary is established by no source in this tree. The integer model here fixes the boundary the way the operator is written, accepting a gap equal to the tolerance, and makes no claim about what the float does there.";

; The finiteness guard inspects the output of the clamp, not the field that arrived. This is a
; structural fact about the source; what the clamp yields for a non-finite input is a float
; question no line in this repository answers, and it is not answered here either.
pub const BONUS_FINITENESS_IS_CHECKED_AFTER_THE_CLAMP : bool = true;
pub const BONUS_FINITENESS_NOTE : str = "src/api/orders.rs:194 clamps the body's bonus and src/api/orders.rs:195-197 tests finiteness on that clamped result rather than on the submitted field. The total and the subtotal are tested the other way round, finiteness first, at src/api/orders.rs:188 and :191. This file models all three as declared booleans and places them where the shipped checks sit, so the refusal order is reproduced without asserting float semantics.";

; The refusal order, and the test comment that describes it backwards.
pub const RANGE_GATE_PRECEDES_THE_IDENTITY_GATE : bool = true;
pub const REFUSAL_ORDER_NOTE : str = "The envelope gate on the total is src/api/orders.rs:188 and the identity gate is src/api/orders.rs:215, so the envelope decides first. The comment inside validate_create_order_rejects_total_above_max at src/api/orders.rs:3424-3427 states the opposite -- that the cross-check fires before the upper-bound check -- and says the bonus was set to absorb the gap, while the body it builds sets the bonus to zero and absorbs nothing. The test still passes, because both gates refuse that body, which is how the stale reason survived.";

; --- Tests -------------------------------------------------------------------------------------
; The scales used below are exercise values and not a claim about any market's exponent: the same
; order is run at three of them to show the identity is scale-generic, which is the form the
; no-restatement rule takes here.

test identity_constants_are_pinned {
  assert KIND == "contract";
  assert ID == "turbobaby/order-money";
  assert NAME == "TurboBaby order money identity";
  assert IMPLEMENTATION_BOUNDARY == "client proposal -> server recomputation -> accepted order";
}

test every_reuse_edge_names_its_owner_by_id {
  assert REUSES_COMMERCE_ID == "turbobaby/commerce";
  assert REUSES_MARKET_PROFILE_ID == "turbobaby/market";
  assert REUSES_RENTAL_TERMS_ID == "turbobaby/rental-terms";
  assert REUSES_PRICING_HONESTY_ID == "turbobaby/pricing-honesty";
  assert REUSES_DEPOSIT_TIERS_ID == "turbobaby/deposit-tiers";
  assert REUSES_RIDE_RUNTIME_ID == "turbobaby/ride-runtime";
  assert REUSES_STAR_AWARD_ID == "turbobaby/star-award";
  assert REUSES_STAR_AWARD_ID != REUSES_RIDE_RUNTIME_ID;
  assert REUSES_COMMERCE_ID != ID;
  assert REUSES_MARKET_PROFILE_ID != ID;
}

test the_money_model_constants_are_the_measured_ones {
  assert ZERO_MINOR == 0;
  assert TOTAL_FLOOR_MINOR == ZERO_MINOR;
  assert TOLERANCE_MINOR_UNITS == 1;
  assert STAR_VALUE_IN_MAJOR_UNITS == 1;
  assert MAX_STARS_PER_TRANSACTION == 1000000;
  assert MAX_ORDER_AMOUNT_MAJOR_UNITS == 100000000;
}

test the_verdict_set_is_closed_and_named {
  assert VERDICT_COUNT == 7;
  assert REFUSAL_NAMES.len == 6;
  assert REFUSAL_NAMES[0] == "not_finite";
  assert REFUSAL_NAMES[5] == "total_disagrees";
  assert order_money_verdict_is_known(VERDICT_ACCEPT) == true;
  assert order_money_verdict_is_known(VERDICT_REFUSE_TOTAL_DISAGREES) == true;
  assert order_money_verdict_is_known(VERDICT_INVALID) == false;
  assert order_money_verdict_is_known(VERDICT_COUNT + 1) == false;
  assert order_money_verdict_is_refusal(VERDICT_ACCEPT) == false;
  assert order_money_verdict_is_refusal(VERDICT_REFUSE_NOT_FINITE) == true;
  assert order_money_verdict_is_refusal(VERDICT_REFUSE_TOTAL_DISAGREES) == true;
  assert order_money_verdict_is_refusal(VERDICT_INVALID) == false;
}

test a_clamp_is_not_a_refusal {
  assert order_money_clamp_at_zero(-1) == ZERO_MINOR;
  assert order_money_clamp_at_zero(-9999) == ZERO_MINOR;
  assert order_money_clamp_at_zero(0) == ZERO_MINOR;
  assert order_money_clamp_at_zero(5) == 5;
  assert order_money_bonus_admissible(-500, 10000) == true;
  assert order_money_stars_admissible(-7) == true;
  assert order_money_star_discount_minor(-7, 100) == 0;
}

test one_star_is_one_major_unit_at_every_scale {
  assert order_money_star_discount_minor(0, 100) == 0;
  assert order_money_star_discount_minor(50, 1) == 50;
  assert order_money_star_discount_minor(50, 100) == 5000;
  assert order_money_star_discount_minor(50, 1000) == 50000;
  assert order_money_star_discount_minor(1, 100) == STAR_VALUE_IN_MAJOR_UNITS * 100;
}

test the_star_ceiling_is_a_count_and_fails_closed_one_above {
  assert order_money_stars_admissible(0) == true;
  assert order_money_stars_admissible(MAX_STARS_PER_TRANSACTION) == true;
  assert order_money_stars_admissible(MAX_STARS_PER_TRANSACTION + 1) == false;
  assert order_money_stars_admissible(MAX_STARS_PER_TRANSACTION - 1) == true;
}

test the_bonus_may_reach_the_subtotal_plus_one_minor_unit_and_no_further {
  assert order_money_bonus_admissible(1000, 10000) == true;
  assert order_money_bonus_admissible(10000, 10000) == true;
  assert order_money_bonus_admissible(10001, 10000) == true;
  assert order_money_bonus_admissible(10002, 10000) == false;
  assert order_money_bonus_admissible(10100, 10000) == false;
}

test the_star_discount_is_bounded_by_what_the_bonus_left {
  assert order_money_discount_admissible(0, 10000, 1000) == true;
  assert order_money_discount_admissible(9000, 10000, 1000) == true;
  assert order_money_discount_admissible(9001, 10000, 1000) == true;
  assert order_money_discount_admissible(9002, 10000, 1000) == false;
  assert order_money_discount_admissible(9002, 10000, 0) == true;
}

test the_identity_holds_and_is_floored_at_zero {
  assert order_money_expected_total_minor(10000, 1000, 0) == 9000;
  assert order_money_expected_total_minor(10000, 1000, 9000) == 0;
  assert order_money_expected_total_minor(10000, 0, 10000) == TOTAL_FLOOR_MINOR;
  assert order_money_expected_total_minor(0, 0, 0) == TOTAL_FLOOR_MINOR;
  assert order_money_bonus_admissible(10001, 10000) == true;
  assert order_money_expected_total_minor(10000, 10001, 0) == TOTAL_FLOOR_MINOR;
  assert order_money_expected_total_minor(10000, -500, 0) == 10000;
}

test the_tolerance_accepts_one_minor_unit_and_refuses_two {
  assert order_money_gap_minor(9000, 9000) == 0;
  assert order_money_gap_minor(9001, 9000) == TOLERANCE_MINOR_UNITS;
  assert order_money_gap_minor(9000, 9001) == TOLERANCE_MINOR_UNITS;
  assert order_money_total_agrees(9000, 9000) == true;
  assert order_money_total_agrees(9001, 9000) == true;
  assert order_money_total_agrees(8999, 9000) == true;
  assert order_money_total_agrees(9002, 9000) == false;
  assert order_money_total_agrees(8998, 9000) == false;
}

test the_envelope_is_inclusive_at_the_ceiling_and_closed_above_it {
  assert order_money_max_amount_minor(1) == MAX_ORDER_AMOUNT_MAJOR_UNITS;
  assert order_money_max_amount_minor(100) == MAX_ORDER_AMOUNT_MAJOR_UNITS * 100;
  assert order_money_amount_in_range(0, order_money_max_amount_minor(100)) == true;
  assert order_money_amount_in_range(-1, order_money_max_amount_minor(100)) == false;
  assert order_money_amount_in_range(order_money_max_amount_minor(100), order_money_max_amount_minor(100)) == true;
  assert order_money_amount_in_range(order_money_max_amount_minor(100) + 1, order_money_max_amount_minor(100)) == false;
}

; The repository fixture at src/api/orders.rs:2990-3024 -- subtotal 100, bonus 10, no stars,
; total 90 -- read in minor units at an exercise scale of 100.
test the_shipped_golden_order_is_accepted {
  assert order_money_expected_total_minor(10000, 1000, 0) == 9000;
  assert order_money_verdict(10000, 9000, 1000, 0, 100, true, true, true) == VERDICT_ACCEPT;
}

; src/api/orders.rs:3241-3248 sets the total to 95 against an expected 90.
test a_total_that_disagrees_is_refused_by_the_identity_gate {
  assert order_money_verdict(10000, 9500, 1000, 0, 100, true, true, true) == VERDICT_REFUSE_TOTAL_DISAGREES;
  assert order_money_verdict(10000, 9002, 1000, 0, 100, true, true, true) == VERDICT_REFUSE_TOTAL_DISAGREES;
  assert order_money_verdict(10000, 9001, 1000, 0, 100, true, true, true) == VERDICT_ACCEPT;
  assert order_money_verdict(10000, 8999, 1000, 0, 100, true, true, true) == VERDICT_ACCEPT;
  assert order_money_verdict(10000, 8998, 1000, 0, 100, true, true, true) == VERDICT_REFUSE_TOTAL_DISAGREES;
}

; src/api/orders.rs:3229-3238 sets a bonus of 101 against a subtotal of 100.
test a_bonus_above_the_subtotal_is_refused_before_the_identity_is_reached {
  assert order_money_verdict(10000, 0, 10100, 0, 100, true, true, true) == VERDICT_REFUSE_BONUS_ABOVE_SUBTOTAL;
  assert order_money_verdict(10000, 0, 10001, 0, 100, true, true, true) == VERDICT_ACCEPT;
}

; src/api/orders.rs:3438-3451, the inflated-quantity attack: the body claims an amount far past
; the envelope. The quantity leg of that attack is a line-count axis and is not this file's.
test an_amount_past_the_envelope_is_refused_by_the_envelope_and_not_by_the_identity {
  assert order_money_verdict(10000, order_money_max_amount_minor(100) + 1, 0, 0, 100, true, true, true) == VERDICT_REFUSE_OUT_OF_RANGE;
  assert order_money_verdict(order_money_max_amount_minor(100) + 1, 0, 0, 0, 100, true, true, true) == VERDICT_REFUSE_OUT_OF_RANGE;
  assert RANGE_GATE_PRECEDES_THE_IDENTITY_GATE == true;
}

test the_star_ceiling_refuses_before_the_discount_is_applied {
  assert order_money_verdict(200000000, 100000000, 0, MAX_STARS_PER_TRANSACTION + 1, 100, true, true, true) == VERDICT_REFUSE_STARS_ABOVE_CEILING;
  assert order_money_verdict(10000, 0, 1000, 95, 100, true, true, true) == VERDICT_REFUSE_DISCOUNT_ABOVE_REMAINDER;
  assert order_money_verdict(10000, 0, 1000, 90, 100, true, true, true) == VERDICT_ACCEPT;
}

test a_non_finite_amount_is_refused_wherever_its_flag_sits {
  assert order_money_verdict(10000, 9000, 1000, 0, 100, false, true, true) == VERDICT_REFUSE_NOT_FINITE;
  assert order_money_verdict(10000, 9000, 1000, 0, 100, true, false, true) == VERDICT_REFUSE_NOT_FINITE;
  assert order_money_verdict(10000, 9000, 1000, 0, 100, true, true, false) == VERDICT_REFUSE_NOT_FINITE;
  assert order_money_verdict(10000, order_money_max_amount_minor(100) + 1, 1000, 0, 100, true, false, true) == VERDICT_REFUSE_OUT_OF_RANGE;
}

; The structural half of propose-and-recompute: one expected figure, four different claims.
test a_browser_claim_never_moves_the_expected_figure {
  assert order_money_expected_total_minor(10000, 1000, 0) == 9000;
  assert order_money_verdict(10000, 9000, 1000, 0, 100, true, true, true) == VERDICT_ACCEPT;
  assert order_money_verdict(10000, 500, 1000, 0, 100, true, true, true) == VERDICT_REFUSE_TOTAL_DISAGREES;
  assert order_money_verdict(10000, 99999, 1000, 0, 100, true, true, true) == VERDICT_REFUSE_TOTAL_DISAGREES;
  assert order_money_verdict(10000, 0, 1000, 0, 100, true, true, true) == VERDICT_REFUSE_TOTAL_DISAGREES;
  assert SERVER_RECOMPUTATION_DECIDES == true;
  assert CLIENT_COMPUTATION_IS_A_PROPOSAL == true;
  assert IDENTITY_IMPLEMENTATION_COUNT == 3;
  assert IDENTITY_IMPLEMENTATIONS.len == IDENTITY_IMPLEMENTATION_COUNT;
  assert IDENTITY_IMPLEMENTATIONS[0] == "src/api/orders.rs:210";
  assert IDENTITY_IMPLEMENTATIONS[1] == "src/ui/screens/checkout_screen.rs:731";
  assert IDENTITY_IMPLEMENTATIONS[2] == "src/ui/screens/checkout_screen.rs:1012";
  assert CLIENT_IDENTITY_COPY_COUNT == 2;
  assert CLIENT_IDENTITY_COPY_COUNT + 1 == IDENTITY_IMPLEMENTATION_COUNT;
  assert CLIENT_COPIES_ARE_SHAPED_DIFFERENTLY == true;
  assert CLIENT_COPY_SHAPE_NOTE != "";
}

; One order, three market exponents, one verdict. This is what taking the scale as a parameter
; buys, and it is why no exponent is written in this file.
test the_identity_is_scale_generic {
  assert order_money_verdict(100, 90, 10, 0, 1, true, true, true) == VERDICT_ACCEPT;
  assert order_money_verdict(10000, 9000, 1000, 0, 100, true, true, true) == VERDICT_ACCEPT;
  assert order_money_verdict(100000, 90000, 10000, 0, 1000, true, true, true) == VERDICT_ACCEPT;
  assert order_money_verdict(100, 0, 10, 90, 1, true, true, true) == VERDICT_ACCEPT;
  assert order_money_verdict(10000, 0, 1000, 90, 100, true, true, true) == VERDICT_ACCEPT;
  assert order_money_verdict(100000, 0, 10000, 90, 1000, true, true, true) == VERDICT_ACCEPT;
  assert MINOR_UNIT_SCALE_IS_AN_ABSTRACT_PARAMETER == true;
  assert MINOR_DIGIT_COUNT_IS_NOT_RESTATED_HERE == true;
}

test the_declared_absences_are_declared_and_not_silent {
  assert RATE_TIMES_SPAN_IS_NOT_COMPUTED_HERE == true;
  assert CURRENCY_CONVERSION_IS_NOT_PERFORMED_HERE == true;
  assert AUTHORITY_RULE_IS_NOT_OWNED_HERE == true;
  assert BALANCE_SUFFICIENCY_IS_NOT_DECIDED_HERE == true;
  assert BONUS_POLICY_IS_NOT_A_TERM_OF_THIS_IDENTITY == true;
}

; The measurement and the correction travel together, so the count cannot be quoted alone.
test the_seed_is_silent_about_bonus_and_the_policy_is_still_owned_elsewhere {
  assert FLEET_SEED_LOYALTY_MENTIONS == 0;
  assert FLEET_SEED_BONUS_MENTIONS == 0;
  assert BONUS_POLICY_IS_NOT_A_TERM_OF_THIS_IDENTITY == true;
  assert BONUS_POLICY_NOTE != "";
  ; Re-run 2026-09-21 with the file's size beside the zeros, so a zero taken from a truncated or
  ; missing file cannot pass for a zero taken from the real one.
  assert SEED_MEASUREMENT_RE_RUN_AT == "2026-09-21";
  assert FLEET_SEED_BYTES > 0;
}

; The seed's size, stated so that it reproduces on every checkout (corrected 2026-09-24). The blob
; size plus one byte per line is exactly what the CRLF working copy measured, which is the whole
; of the difference between the old figure and the new one. Since 2026-09-25 that arithmetic is
; about the blob as it stood before the owner's CLICK 125 decision, which the _BEFORE_2026_09_25
; name carries; the seed kept its 350 lines through the change.
test the_seed_size_is_the_blobs_and_not_a_working_copys {
  assert FLEET_SEED_BYTES == 20161;
  assert FLEET_SEED_LINES == 350;
  assert FLEET_SEED_BYTES_BEFORE_2026_09_24 == 19434;
  assert FLEET_SEED_BYTES_BEFORE_2026_09_25 == 19084;
  assert FLEET_SEED_BYTES_BEFORE_2026_09_24 == FLEET_SEED_BYTES_BEFORE_2026_09_25 + FLEET_SEED_LINES;
  assert FLEET_SEED_BYTES != FLEET_SEED_BYTES_BEFORE_2026_09_25;
  assert FLEET_SEED_BYTES_ARE_THE_COMMITTED_BLOB == true;
  assert FLEET_SEED_BYTES_REMEASURED_AT == "2026-09-25";
  assert FLEET_SEED_BYTES_REMEASURED_AT != SEED_MEASUREMENT_RE_RUN_AT;
  assert FLEET_SEED_LOYALTY_MENTIONS == 0;
  assert FLEET_SEED_BONUS_MENTIONS == 0;
}

test the_seed_measurement_has_a_second_reader_and_one_owner {
  assert A_SECOND_CONTRACT_CITES_THIS_SEED_MEASUREMENT == true;
  assert SEED_MEASUREMENT_SECOND_READER_ID == "turbobaby/loyalty-ledger";
  assert SEED_MEASUREMENT_SECOND_READER_ID != ID;
}

; What a star is worth when SPENT has exactly one home, and this is it. The literal below is the
; whole claim: if a second contract ever declares a star value, this count is what has to change
; first, and a reader who quotes the sentence in the header gets sent here instead.
test the_star_spend_value_is_declared_in_this_corpus_exactly_once {
  assert STAR_VALUE_CENSUS_MEASURED_AT == "2026-09-21";
  assert CONTRACTS_DECLARING_A_STAR_SPEND_VALUE == 1;
  assert STAR_VALUE_IN_MAJOR_UNITS == 1;
  ; The neighbours that name the gap instead of filling it, pinned by ID from this side too.
  assert INBOUND_EDGES.len == INBOUND_EDGE_COUNT;
  assert INBOUND_EDGE_COUNT == 4;
  assert INBOUND_EDGES[0] == "turbobaby/checkout-contact";
  assert INBOUND_EDGES[1] == "turbobaby/delivery-terms";
  assert INBOUND_EDGES[2] == "turbobaby/loyalty-ledger";
  assert INBOUND_EDGES[3] == "turbobaby/star-award";
  assert INBOUND_EDGES[3] == REUSES_STAR_AWARD_ID;
  assert INBOUND_EDGES[2] == SEED_MEASUREMENT_SECOND_READER_ID;
  assert INBOUND_EDGES[0] != ID;
  assert INBOUND_EDGES[3] != ID;
  ; star-award is named in BOTH directions, which is the one pair in this list that is a cycle of
  ; naming rather than a one-way pointer, and it is legal because neither restates the other.
  assert REUSES_STAR_AWARD_ID == "turbobaby/star-award";
  assert INBOUND_EDGE_COUNT > CONTRACTS_DECLARING_A_STAR_SPEND_VALUE;
}

test the_float_boundary_and_the_clamped_finiteness_guard_are_recorded {
  assert SHIPPED_TOLERANCE_IS_A_FLOAT_COMPARISON == true;
  assert TOLERANCE_BOUNDARY_IS_UNTESTED_IN_THE_REPOSITORY == true;
  assert TOLERANCE_BOUNDARY_NOTE != "";
  assert BONUS_FINITENESS_IS_CHECKED_AFTER_THE_CLAMP == true;
  assert BONUS_FINITENESS_NOTE != "";
  assert REFUSAL_ORDER_NOTE != "";
  assert PROPOSE_RECOMPUTE_NOTE != "";
}

; --- Invariants --------------------------------------------------------------------------------

invariant the_expected_total_never_goes_below_the_floor
  assert order_money_expected_total_minor(10000, 10001, 0) == TOTAL_FLOOR_MINOR and order_money_expected_total_minor(0, 10000, 10000) == TOTAL_FLOOR_MINOR and TOTAL_FLOOR_MINOR == ZERO_MINOR

invariant the_tolerance_is_one_minor_unit_and_the_second_one_is_refused
  assert TOLERANCE_MINOR_UNITS == 1 and order_money_total_agrees(9001, 9000) == true and order_money_total_agrees(9002, 9000) == false

invariant a_clamp_never_turns_into_a_refusal
  assert order_money_clamp_at_zero(-9999) == ZERO_MINOR and order_money_bonus_admissible(-9999, 10000) == true and order_money_stars_admissible(-9999) == true

invariant the_expected_figure_is_computed_without_any_browser_number
  assert order_money_expected_total_minor(10000, 1000, 0) == 9000 and order_money_verdict(10000, 500, 1000, 0, 100, true, true, true) == VERDICT_REFUSE_TOTAL_DISAGREES and SERVER_RECOMPUTATION_DECIDES == true

invariant the_envelope_decides_before_the_identity_does
  assert order_money_verdict(10000, order_money_max_amount_minor(100) + 1, 0, 0, 100, true, true, true) == VERDICT_REFUSE_OUT_OF_RANGE and RANGE_GATE_PRECEDES_THE_IDENTITY_GATE == true

invariant the_star_ceiling_is_a_count_that_fails_closed
  assert order_money_stars_admissible(MAX_STARS_PER_TRANSACTION) == true and order_money_stars_admissible(MAX_STARS_PER_TRANSACTION + 1) == false

invariant the_two_discounts_cannot_each_consume_the_whole_bill
  assert order_money_discount_admissible(9002, 10000, 1000) == false and order_money_discount_admissible(9002, 10000, 0) == true

invariant the_identity_answers_the_same_at_three_market_exponents
  assert order_money_verdict(100, 90, 10, 0, 1, true, true, true) == order_money_verdict(10000, 9000, 1000, 0, 100, true, true, true) and order_money_verdict(10000, 9000, 1000, 0, 100, true, true, true) == order_money_verdict(100000, 90000, 10000, 0, 1000, true, true, true)

invariant no_neighbouring_contract_is_restated_here_only_named
  assert REUSES_COMMERCE_ID == "turbobaby/commerce" and REUSES_MARKET_PROFILE_ID == "turbobaby/market" and REUSES_RENTAL_TERMS_ID == "turbobaby/rental-terms" and AUTHORITY_RULE_IS_NOT_OWNED_HERE == true and MINOR_DIGIT_COUNT_IS_NOT_RESTATED_HERE == true

invariant an_unmeasured_boundary_is_recorded_rather_than_decided
  assert TOLERANCE_BOUNDARY_IS_UNTESTED_IN_THE_REPOSITORY == true and SHIPPED_TOLERANCE_IS_A_FLOAT_COMPARISON == true

invariant every_hand_written_copy_of_the_identity_is_named
  assert IDENTITY_IMPLEMENTATIONS.len == IDENTITY_IMPLEMENTATION_COUNT and IDENTITY_IMPLEMENTATION_COUNT == 3 and CLIENT_IDENTITY_COPY_COUNT == 2 and SERVER_RECOMPUTATION_DECIDES == true
