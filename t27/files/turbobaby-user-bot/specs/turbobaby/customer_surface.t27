pub const TAB_LABELS_PUBLISHED : [0]str = [];

; Every one of the five resolves. The handlers are at src/ui/routes.rs:92 Home, :266 Ride, :230
; Orders, :203 Cart and :248 Profile, and each mounts a screen component. Home is the one worth
; naming twice: it resolves to two different screens depending on a pending payload, and BOTH of
; them are live, which is why it counts as resolving rather than as a special case.
pub const ROUTER_DECLARED_ROUTES : u8 = 26;
pub const TABS_RESOLVING_TO_A_LIVE_SCREEN : u8 = 5;
pub const TABS_RESOLVING_TO_NOTHING : u8 = 0;
pub const TAB_HANDLER_SITES : [5]str = [
  "src/ui/routes.rs:92",
  "src/ui/routes.rs:266",
  "src/ui/routes.rs:230",
  "src/ui/routes.rs:203",
  "src/ui/routes.rs:248"
];
pub const MENU_IS_A_TAB : bool = false;
pub const MENU_IS_A_HIGHLIGHT_CONDITION : bool = true;

pub fn sum_highlight_routes(counts: [5]u8) u8 {
  return counts[0] + counts[1] + counts[2] + counts[3] + counts[4];
}

pub fn tab_is_admissible(destination_route_declared: bool, route_mounts_a_screen: bool, screen_is_live: bool) bool {
  return destination_route_declared and route_mounts_a_screen and screen_is_live;
}

pub fn tab_is_a_dead_tap(destination_route_declared: bool, route_mounts_a_screen: bool, screen_is_live: bool) bool {
  return !tab_is_admissible(destination_route_declared, route_mounts_a_screen, screen_is_live);
}

pub fn tab_bar_is_sound(tabs_declared: u8, tabs_resolving: u8) bool {
  return tabs_declared == tabs_resolving;
}

; A route the bar does not advertise is not thereby retired, and a route the bar does advertise is
; not thereby live. Both halves are somebody else's: legacy-retirement rules on the first and the
; handler rules on the second. What this file forbids is the shortcut between them.
pub fn absence_from_the_bar_retires_a_route(route_is_absent_from_the_bar: bool) bool {
  return route_is_absent_from_the_bar and false;
}

; --- The witness, and the three things it cannot see -------------------------------------------
; tests/customer_surface_wiring.rs. 820 lines, fifteen #[test] functions, three files pulled in by
; include_str! at :21-23 plus a walk of every .rs under src/ui. It pins the tab count at :116, the
; five destinations at :110 and five retired route names at :118. It is a source-text scan because
; src/lib.rs:17-18 gates pub mod ui on target_arch = "wasm32" and cargo test therefore compiles no
; line of this surface -- so the scan is the only instrument, not the weaker of two.
; CORRECTED 2026-09-25: 812 lines, not 820; still fifteen tests. The owner's ruling of that day (#12,
; nothing cannabis-related anywhere) removed the six member-card images from assets/, whose artwork
; was a cannabis bud, and the six constants in src/ui/assets.rs that named them. The witness's
; asset-constant check kept those six on its decision list; the list is now empty and its parser floor
; fell from seven constants to one, so the file shrank by eight lines and no test was added or
; removed. The 820 of the 2026-09-21 reading is kept under a _BEFORE_ name.
pub const WITNESS_LINES : u16 = 812;
pub const WITNESS_LINES_BEFORE_2026_09_25 : u16 = 820;
pub const WITNESS_TESTS : u8 = 15;
; RE-VERIFIED 2026-09-21, and a trap named while it is fresh. Both numbers above still hold --
; wc -l gives 820 and the witness declares fifteen test functions -- but the obvious re-measurement
; DISAGREES: `grep -c '#\[test\]' tests/customer_surface_wiring.rs` returns 19. The four extra hits
; are not tests. Three are inside the witness's own string literals and one is inside a comment,
; because two of its checks scan source text FOR the attribute (they count `#[test]` lines under
; src/ui and refuse new ones cargo test cannot see) and therefore have to spell it. Counting
; attribute POSITIONS rather than matching lines gives fifteen. Recorded so the next reader who
; runs the fast grep does not "correct" a true fifteen into a false nineteen.
pub const WITNESS_TESTS_BY_NAIVE_GREP : u8 = 19;
pub const WITNESS_TESTS_NAIVE_GREP_IS_CORRECT : bool = false;
pub const WITNESS_TEST_TOKEN_NON_ATTRIBUTE_HITS : u8 = 4;
pub const WITNESS_COUNT_REVERIFIED_AT : str = "2026-09-21";

pub fn test_count_is_trustworthy(counted_attribute_positions: bool) bool {
  return counted_attribute_positions;
}
pub const WITNESS_FILES_READ_BY_INCLUDE : u8 = 3;
pub const WITNESS_IS_A_SOURCE_TEXT_SCAN : bool = true;
pub const WITNESS_COMPILES_THE_SURFACE : bool = false;
pub const WITNESS_COMPILES_THE_SURFACE_REASON : str = "src/lib.rs:17-18 declares pub mod ui under cfg(target_arch = wasm32); the host test binary never builds it, which the witness states in its own header.";
pub const WITNESS_ASSERTS_THE_TAB_COUNT : bool = true;
pub const WITNESS_ASSERTS_A_CLAIM_CLASS : bool = false;
pub const WITNESS_TRUST_KEY_ASSERTIONS : u8 = 0;
pub const WITNESS_TRUST_GREP : str = "grep -rn T_TRUST tests/ on 2026-09-21 -> 0 matches in the whole directory";

pub const WITNESS_BLIND_SPOT_COUNT : u8 = 3;
pub const WITNESS_BLIND_SPOTS : [3]str = ["claim_content", "indirectly_built_route", "runtime_failure"];
pub const WITNESS_BLIND_SPOT_NOTE : str = "First: no assertion reads what a row says, so a class change is invisible to it. Second: it matches the literal Route::<Name> followed by a brace, so a destination assembled by a helper or a formatted string is not seen -- the needle rule is the witness's own and it says so where it is written. Third: it never mounts anything, so a tab whose screen compiles and then fails at runtime passes every check in the file.";

pub fn witness_covers(subject_is_a_source_literal: bool, subject_is_in_a_read_file: bool) bool {
  return subject_is_a_source_literal and subject_is_in_a_read_file;
}

pub fn a_claim_class_is_checked_today(trust_key_assertions: u8) bool {
  return trust_key_assertions >= 1;
}

pub fn a_green_witness_proves_the_claim_rule(claim_assertions: u8) bool {
  return claim_assertions >= 1;
}

; --- Honest refusals -----------------------------------------------------------------------------
; Three things this repository does not publish. Each is declared as a named bool plus a note
; saying what is missing, because a plausible number in any of these slots would be followed.
pub const LEGAL_ENTITY_IS_VERIFIED_IN_REPO : bool = false;
pub const LEGAL_ENTITY_VERIFICATION_NOTE : str = "The legal-entity row is admitted here as a class, not as a verified fact. No registry extract, certificate or incorporation document is tracked in this repository -- DECISIONS.md:386-388 records that the owner's own document folder holds sheets, agreements and passports and that no brand artifact was taken from it -- so nothing here can confirm the company name or its address. What is missing is a document, not a measurement, and the surface rule this file states is that the row must cite one.";

pub const SUPPORT_LINK_FOLLOWS_CONFIGURATION : bool = false;
pub const SUPPORT_LINK_NOTE : str = "The one outbound link in the trust block is a hardcoded literal at src/ui/screens/home_screen.rs:446, so a deployment that renames the bot moves every generated link and leaves this one pointing at the old handle, silently. The knob itself is NOT this file's finding: turbobaby/runtime-config owns BOT_HANDLE_CLIENT_LITERAL_SITES and knob_governs_whole_deployment and already counts this slot among its client literals, and the resolver that half-obeys the variable is measured there, not restated here. What this file adds is the surface half: the trust block's only outbound link is a claim of CONTACT, and a contact claim whose destination cannot follow configuration is a claim that goes stale without an edit. Declared as a refusal rather than repaired: this file measures the surface and changes no code.";

pub const CLAIM_REVIEW_DATE_IS_PUBLISHED : bool = false;
pub const CLAIM_REVIEW_NOTE : str = "Nothing records when a claim on this surface was last checked against the world. D20 is dated by the decision log and the rows themselves carry no review stamp, so a law that changes tomorrow leaves a row that is still permitted by class and no longer true. A staleness rule would need a date field that does not exist, and inventing one here would be the unsourced number this file forbids.";

pub fn refusal_is_declared_rather_than_guessed(fact_is_published: bool, note_names_what_is_missing: bool) bool {
  return !fact_is_published and note_names_what_is_missing;
}

; --- Tests -----------------------------------------------------------------------------------

test the_seven_claim_classes_are_named_and_the_value_set_is_closed {
  assert CLAIM_KIND_COUNT == 7;
  assert claim_kind_is_known(CLAIM_LEGAL_ENTITY) == true;
  assert claim_kind_is_known(CLAIM_UNSOURCED_NUMBER) == true;
  assert claim_kind_is_known(CLAIM_UNSET) == false;
  assert claim_kind_is_known(8) == false;
}

test four_classes_are_admitted_and_three_are_refused {
  assert PERMITTED_CLAIM_COUNT == 4;
  assert REFUSED_CLAIM_COUNT == 3;
  assert PERMITTED_CLAIM_COUNT + REFUSED_CLAIM_COUNT == CLAIM_KIND_COUNT;
  assert PERMITTED_CLAIM_NAMES.len == PERMITTED_CLAIM_COUNT;
  assert REFUSED_CLAIM_NAMES.len == REFUSED_CLAIM_COUNT;
  assert claim_is_permitted(CLAIM_LEGAL_ENTITY) == true;
  assert claim_is_permitted(CLAIM_LAW) == true;
  assert claim_is_permitted(CLAIM_SEED_FACT) == true;
  assert claim_is_permitted(CLAIM_CONTACT) == true;
  assert claim_is_refused(CLAIM_PRODUCT) == true;
  assert claim_is_refused(CLAIM_MEDICAL) == true;
  assert claim_is_refused(CLAIM_UNSOURCED_NUMBER) == true;
}

test an_unclassified_row_is_neither_admitted_nor_a_violation {
  assert claim_is_permitted(CLAIM_UNSET) == false;
  assert claim_is_refused(CLAIM_UNSET) == false;
  assert claim_may_render(CLAIM_UNSET, true) == false;
}

test a_permitted_class_without_a_named_source_is_still_refused {
  assert claim_may_render(CLAIM_LEGAL_ENTITY, true) == true;
  assert claim_may_render(CLAIM_LAW, true) == true;
  assert claim_may_render(CLAIM_LEGAL_ENTITY, false) == false;
  assert claim_may_render(CLAIM_LAW, false) == false;
  assert claim_may_render(CLAIM_SEED_FACT, false) == false;
}

test the_three_refused_classes_cannot_be_rendered_with_any_source {
  assert claim_may_render(CLAIM_PRODUCT, true) == false;
  assert claim_may_render(CLAIM_MEDICAL, true) == false;
  assert claim_may_render(CLAIM_UNSOURCED_NUMBER, true) == false;
}

test a_retired_subject_outranks_a_permitted_class {
  assert claim_may_render_after_retirement(CLAIM_LAW, true, false) == true;
  assert claim_may_render_after_retirement(CLAIM_LAW, true, true) == false;
  assert claim_may_render_after_retirement(CLAIM_LEGAL_ENTITY, true, true) == false;
  assert claim_may_render_after_retirement(CLAIM_PRODUCT, true, false) == false;
}

test a_screen_never_supplies_the_source_of_its_own_figure {
  assert number_may_be_shown(true, true) == true;
  assert number_may_be_shown(false, true) == false;
  assert number_may_be_shown(true, false) == false;
  assert number_may_be_shown(false, false) == false;
  assert screen_may_supply_its_own_number() == false;
}

test the_key_name_is_stale_on_three_of_the_four_slots_and_changes_no_verdict {
  assert TRUST_SLOT_COUNT == 4;
  assert TRUST_KEYS_NAMED_FOR_A_RETIRED_CLAIM == 3;
  assert TRUST_KEYS_NAMED_FOR_WHAT_THEY_CARRY == 1;
  assert TRUST_SLOT_SITES.len == TRUST_SLOT_COUNT;
  assert TRUST_ROW_SITES.len == 2;
  assert slot_accounting_closes(TRUST_SLOT_COUNT, TRUST_KEYS_NAMED_FOR_A_RETIRED_CLAIM, TRUST_KEYS_NAMED_FOR_WHAT_THEY_CARRY) == true;
  assert key_name_is_stale(true, true) == true;
  assert key_name_is_stale(false, true) == false;
  assert key_name_is_stale(true, false) == false;
  assert CLAIM_CLASS_IS_READ_FROM_CONTENT == true;
  assert CLAIM_CLASS_IS_READ_FROM_THE_KEY_NAME == false;
}

test the_surface_conforms_to_d20_at_this_measurement {
  assert HOME_PRODUCT_CLAIM_HITS == 0;
  assert HOME_MEDICAL_CLAIM_HITS == 0;
  assert HOME_SEED_FACTS_ASSERTED == 0;
  assert HOME_FIGURES_PRINTED == 1;
  assert D20_RULE_HOLDS_AT_THIS_MEASUREMENT == true;
  assert surface_conforms(HOME_PRODUCT_CLAIM_HITS, HOME_MEDICAL_CLAIM_HITS, 0) == true;
  assert surface_conforms(1, 0, 0) == false;
  assert surface_conforms(0, 1, 0) == false;
  assert surface_conforms(0, 0, 1) == false;
}

test the_first_screen_is_not_the_claim_surface {
  assert FIRST_SCREEN_CARRIES_THE_TRUST_BLOCK == false;
  assert CLAIM_SURFACE_IS_A_DEEPLINK_LANDING == true;
  assert claim_surface_mounts(false) == false;
  assert claim_surface_mounts(true) == true;
}

test the_four_mounts_split_three_transient_and_one_that_waits {
  assert CLAIM_SURFACE_MOUNT_CONDITIONS == 4;
  assert MOUNTS_THAT_NAVIGATE_IN_THE_SAME_EFFECT == 3;
  assert MOUNTS_THAT_AWAIT_THE_NETWORK == 1;
  assert CLAIM_SURFACE_MOUNT_NAMES.len == CLAIM_SURFACE_MOUNT_CONDITIONS;
  assert mount_accounting_closes(CLAIM_SURFACE_MOUNT_CONDITIONS, MOUNTS_THAT_NAVIGATE_IN_THE_SAME_EFFECT, MOUNTS_THAT_AWAIT_THE_NETWORK) == true;
  assert trust_block_outlives_a_frame(true) == true;
  assert trust_block_outlives_a_frame(false) == false;
}

test the_bar_advertises_five_destinations {
  assert TAB_COUNT == 5;
  assert TABS_RESOLVING_TO_A_LIVE_SCREEN == 5;
  assert TABS_RESOLVING_TO_NOTHING == 0;
  assert TAB_ROUTE_NAMES.len == TAB_COUNT;
  assert TAB_LINK_SITES.len == TAB_COUNT;
  assert TAB_HANDLER_SITES.len == TAB_COUNT;
  assert tab_bar_is_sound(TAB_COUNT, TABS_RESOLVING_TO_A_LIVE_SCREEN) == true;
  assert tab_bar_is_sound(TAB_COUNT, 4) == false;
}

test five_tabs_light_up_on_eight_routes {
  assert TAB_HIGHLIGHT_ROUTE_COUNTS.len == TAB_COUNT;
  assert sum_highlight_routes(TAB_HIGHLIGHT_ROUTE_COUNTS) == HIGHLIGHTED_ROUTE_TOTAL;
  assert HIGHLIGHTED_ROUTE_TOTAL == 8;
  assert HIGHLIGHTED_ROUTE_TOTAL > TAB_COUNT;
  assert MENU_IS_A_TAB == false;
  assert MENU_IS_A_HIGHLIGHT_CONDITION == true;
}

test a_tab_needs_a_route_a_mount_and_a_live_screen {
  assert tab_is_admissible(true, true, true) == true;
  assert tab_is_admissible(false, true, true) == false;
  assert tab_is_admissible(true, false, true) == false;
  assert tab_is_admissible(true, true, false) == false;
  assert tab_is_a_dead_tap(true, true, false) == true;
  assert tab_is_a_dead_tap(true, true, true) == false;
}

test the_bar_is_smaller_than_the_router_and_that_is_not_a_retirement {
  assert ROUTER_DECLARED_ROUTES == 26;
  assert TAB_COUNT < ROUTER_DECLARED_ROUTES;
  assert absence_from_the_bar_retires_a_route(false) == false;
  assert absence_from_the_bar_retires_a_route(true) == false;
}

test the_witness_is_a_scan_and_it_reads_no_claim {
  assert WITNESS_IS_A_SOURCE_TEXT_SCAN == true;
  assert WITNESS_COMPILES_THE_SURFACE == false;
  assert WITNESS_TESTS == 15;
  assert WITNESS_FILES_READ_BY_INCLUDE == 3;
  assert WITNESS_ASSERTS_THE_TAB_COUNT == true;
  assert WITNESS_ASSERTS_A_CLAIM_CLASS == false;
  assert WITNESS_TRUST_KEY_ASSERTIONS == 0;
  assert a_claim_class_is_checked_today(WITNESS_TRUST_KEY_ASSERTIONS) == false;
  assert a_claim_class_is_checked_today(1) == true;
}

test the_witness_covers_literals_in_the_files_it_reads_and_nothing_else {
  assert WITNESS_BLIND_SPOT_COUNT == 3;
  assert WITNESS_BLIND_SPOTS.len == WITNESS_BLIND_SPOT_COUNT;
  assert witness_covers(true, true) == true;
  assert witness_covers(false, true) == false;
  assert witness_covers(true, false) == false;
  assert a_green_witness_proves_the_claim_rule(0) == false;
}

test the_three_refusals_are_declared_with_what_is_missing {
  assert LEGAL_ENTITY_IS_VERIFIED_IN_REPO == false;
  assert SUPPORT_LINK_FOLLOWS_CONFIGURATION == false;
  assert CLAIM_REVIEW_DATE_IS_PUBLISHED == false;
  assert refusal_is_declared_rather_than_guessed(false, true) == true;
  assert refusal_is_declared_rather_than_guessed(false, false) == false;
  assert refusal_is_declared_rather_than_guessed(true, true) == false;
}

test the_reuse_edges_are_named_by_id_and_no_sibling_decision_is_restated {
  assert REUSES_LEGACY_RETIREMENT_ID == "turbobaby/legacy-retirement";
  assert REUSES_PRICING_HONESTY_ID == "turbobaby/pricing-honesty";
  assert REUSES_LOCALE_POLICY_ID == "turbobaby/locale-policy";
  assert REUSES_DEEPLINK_ID == "turbobaby/deeplink";
  assert REUSES_AVAILABILITY_ID == "turbobaby/availability";
  assert REUSES_RUNTIME_CONFIG_ID == "turbobaby/runtime-config";
  assert REUSE_EDGE_COUNT == 6;
}

test the_runtime_config_edge_runs_in_one_direction_and_says_so {
  assert REUSES_RUNTIME_CONFIG_ID == "turbobaby/runtime-config";
  assert RUNTIME_CONFIG_DECLARATIONS_LEANED_ON.len == 3;
  assert RUNTIME_CONFIG_DECLARATIONS_LEANED_ON[0] == "BOT_HANDLE_CLIENT_LITERAL_SITES";
  assert RUNTIME_CONFIG_DECLARATIONS_LEANED_ON[1] == "BOT_HANDLE_SERVER_READS_ENV";
  assert RUNTIME_CONFIG_DECLARATIONS_LEANED_ON[2] == "knob_governs_whole_deployment";
  assert RUNTIME_CONFIG_LITERAL_SITE_COUNT == 6;
  assert THIS_SURFACES_LINK_IS_AMONG_THEM == true;
  assert RUNTIME_CONFIG_NAMES_THIS_CONTRACT_BACK == false;
  assert RUNTIME_CONFIG_MENTIONS_THIS_CONTRACT_IN_PROSE == true;
  assert RUNTIME_CONFIG_PROSE_MENTIONS_OF_THIS_CONTRACT == 1;
  assert RUNTIME_CONFIG_RECIPROCAL_ROWS_AND_THIS_IS_NOT_ONE == 2;
  assert a_prose_mention_is_a_declared_edge(RUNTIME_CONFIG_MENTIONS_THIS_CONTRACT_IN_PROSE, RUNTIME_CONFIG_NAMES_THIS_CONTRACT_BACK) == false;
  assert a_prose_mention_is_a_declared_edge(true, true) == true;
  assert a_prose_mention_is_a_declared_edge(false, true) == true;
  assert RUNTIME_CONFIG_REACHES_THIS_SURFACE_BY_PATH == true;
  assert EDGE_IS_RECIPROCAL_BY_ID == false;
  assert RECIPROCAL_EDGE_GAP != "";
  assert RECIPROCAL_EDGE_GAP_MEASURED_AT == "2026-09-21";
  assert edge_is_named_from_both_ends(true, RUNTIME_CONFIG_NAMES_THIS_CONTRACT_BACK) == false;
  assert edge_is_named_from_both_ends(true, true) == true;
  assert a_path_citation_substitutes_for_an_id_edge(RUNTIME_CONFIG_REACHES_THIS_SURFACE_BY_PATH) == false;
  assert a_path_citation_substitutes_for_an_id_edge(false) == false;
}

test the_wave_census_is_measured_and_the_untimed_interval_is_refused {
  assert CORPUS_T27_FILE_COUNT == 43;
  assert PRIOR_WAVE_NEW_CONTRACTS == 10;
  assert OWN_WAVE_NEW_CONTRACTS == 13;
  assert OWN_WAVE_NEW_CONTRACTS > PRIOR_WAVE_NEW_CONTRACTS;
  assert SIBLING_LINE_CITATIONS_IN_THIS_FILE == 0;
  assert CORPUS_RESIDUE_IS_PINNED_HERE == false;
  assert CORPUS_RESIDUE_NOTE != "";
  assert WAVE_CENSUS_MEASURED_AT == "2026-09-21";
  assert WAVE_CENSUS_SOURCE != "";
  assert STALENESS_INTERVAL_IS_PUBLISHED == false;
  assert edge_is_durable(true, false) == true;
  assert edge_is_durable(true, true) == false;
  assert edge_is_durable(false, false) == false;
}

test the_witness_test_count_survives_its_own_naive_re_measurement {
  assert WITNESS_TESTS == 15;
  // 820 until 2026-09-25, when the member-card constants left the witness's decision list.
  assert WITNESS_LINES == 812;
  assert WITNESS_LINES_BEFORE_2026_09_25 == 820;
  assert WITNESS_LINES < WITNESS_LINES_BEFORE_2026_09_25;
  assert WITNESS_TESTS_BY_NAIVE_GREP == 19;
  assert WITNESS_TESTS_NAIVE_GREP_IS_CORRECT == false;
  assert WITNESS_TEST_TOKEN_NON_ATTRIBUTE_HITS == 4;
  assert WITNESS_TESTS + WITNESS_TEST_TOKEN_NON_ATTRIBUTE_HITS == WITNESS_TESTS_BY_NAIVE_GREP;
  assert WITNESS_COUNT_REVERIFIED_AT == "2026-09-21";
  assert test_count_is_trustworthy(true) == true;
  assert test_count_is_trustworthy(false) == false;
}

test this_file_publishes_no_copy_and_no_label {
  assert CLAIM_TEXT_IS_PUBLISHED_HERE.len == 0;
  assert TAB_LABELS_PUBLISHED.len == 0;
}

test the_identity_of_this_contract_is_fixed {
  assert KIND == "surface-contract";
  assert ID == "turbobaby/customer-surface";
  assert MEASURED_AT == "2026-09-21";
}

; --- Invariants -----------------------------------------------------------------------------

invariant a_product_claim_is_never_admissible_on_this_surface
  assert claim_is_permitted(CLAIM_PRODUCT) == false and claim_may_render(CLAIM_PRODUCT, true) == false and claim_may_render_after_retirement(CLAIM_PRODUCT, true, false) == false

invariant a_medical_claim_is_never_admissible_on_this_surface
  assert claim_is_permitted(CLAIM_MEDICAL) == false and claim_may_render(CLAIM_MEDICAL, true) == false

invariant an_unsourced_number_is_refused_by_class_and_again_by_source
  assert claim_may_render(CLAIM_UNSOURCED_NUMBER, true) == false and number_may_be_shown(false, true) == false and screen_may_supply_its_own_number() == false

invariant no_permitted_class_renders_without_a_named_source
  assert claim_may_render(CLAIM_LEGAL_ENTITY, false) == false and claim_may_render(CLAIM_LAW, false) == false and claim_may_render(CLAIM_SEED_FACT, false) == false and claim_may_render(CLAIM_CONTACT, false) == false

invariant a_retired_subject_can_never_be_rescued_by_its_class
  assert claim_may_render_after_retirement(CLAIM_LEGAL_ENTITY, true, true) == false and claim_may_render_after_retirement(CLAIM_LAW, true, true) == false and claim_may_render_after_retirement(CLAIM_SEED_FACT, true, true) == false and claim_may_render_after_retirement(CLAIM_CONTACT, true, true) == false

invariant the_class_of_a_row_is_never_taken_from_its_key_name
  assert CLAIM_CLASS_IS_READ_FROM_THE_KEY_NAME == false and TRUST_KEYS_NAMED_FOR_A_RETIRED_CLAIM == 3 and slot_accounting_closes(TRUST_SLOT_COUNT, TRUST_KEYS_NAMED_FOR_A_RETIRED_CLAIM, TRUST_KEYS_NAMED_FOR_WHAT_THEY_CARRY) == true

invariant every_tab_resolves_to_a_live_screen
  assert tab_bar_is_sound(TAB_COUNT, TABS_RESOLVING_TO_A_LIVE_SCREEN) == true and TABS_RESOLVING_TO_NOTHING == 0

invariant a_tab_missing_any_of_the_three_is_a_dead_tap
  assert tab_is_a_dead_tap(false, true, true) == true and tab_is_a_dead_tap(true, false, true) == true and tab_is_a_dead_tap(true, true, false) == true

invariant the_highlight_total_cannot_drift_from_its_five_parts
  assert sum_highlight_routes(TAB_HIGHLIGHT_ROUTE_COUNTS) == HIGHLIGHTED_ROUTE_TOTAL

invariant a_route_the_bar_omits_is_not_thereby_retired
  assert absence_from_the_bar_retires_a_route(true) == false and absence_from_the_bar_retires_a_route(false) == false and REUSES_LEGACY_RETIREMENT_ID == "turbobaby/legacy-retirement"

invariant the_first_screen_carries_no_claim
  assert FIRST_SCREEN_CARRIES_THE_TRUST_BLOCK == false and claim_surface_mounts(false) == false

invariant the_witness_never_certifies_a_claim
  assert WITNESS_ASSERTS_A_CLAIM_CLASS == false and a_claim_class_is_checked_today(WITNESS_TRUST_KEY_ASSERTIONS) == false and a_green_witness_proves_the_claim_rule(WITNESS_TRUST_KEY_ASSERTIONS) == false

invariant a_scan_that_compiles_nothing_cannot_report_a_runtime_death
  assert WITNESS_COMPILES_THE_SURFACE == false and WITNESS_BLIND_SPOT_COUNT == 3

invariant an_unpublished_fact_is_refused_rather_than_invented
  assert LEGAL_ENTITY_IS_VERIFIED_IN_REPO == false and SUPPORT_LINK_FOLLOWS_CONFIGURATION == false and CLAIM_REVIEW_DATE_IS_PUBLISHED == false

invariant a_one_sided_edge_is_never_described_as_reciprocal
  assert EDGE_IS_RECIPROCAL_BY_ID == false and edge_is_named_from_both_ends(true, RUNTIME_CONFIG_NAMES_THIS_CONTRACT_BACK) == false and a_path_citation_substitutes_for_an_id_edge(RUNTIME_CONFIG_REACHES_THIS_SURFACE_BY_PATH) == false

invariant a_mention_in_a_comment_never_counts_as_a_declared_edge
  assert a_prose_mention_is_a_declared_edge(RUNTIME_CONFIG_MENTIONS_THIS_CONTRACT_IN_PROSE, RUNTIME_CONFIG_NAMES_THIS_CONTRACT_BACK) == false and RUNTIME_CONFIG_MENTIONS_THIS_CONTRACT_IN_PROSE == true and RUNTIME_CONFIG_NAMES_THIS_CONTRACT_BACK == false

invariant no_edge_of_this_contract_is_carried_by_a_line_number
  assert SIBLING_LINE_CITATIONS_IN_THIS_FILE == 0 and edge_is_durable(true, false) == true and edge_is_durable(true, true) == false

invariant a_number_that_moves_while_it_is_read_is_never_pinned_as_a_constant
  assert CORPUS_RESIDUE_IS_PINNED_HERE == false and CORPUS_RESIDUE_NOTE != "" and SIBLING_LINE_CITATIONS_IN_THIS_FILE == 0

invariant the_witness_count_is_fifteen_and_the_naive_grep_never_overrules_it
  assert WITNESS_TESTS == 15 and WITNESS_TESTS_NAIVE_GREP_IS_CORRECT == false and WITNESS_TESTS + WITNESS_TEST_TOKEN_NON_ATTRIBUTE_HITS == WITNESS_TESTS_BY_NAIVE_GREP

invariant this_contract_publishes_no_copy_and_no_tab_label
  assert CLAIM_TEXT_IS_PUBLISHED_HERE.len == 0 and TAB_LABELS_PUBLISHED.len == 0
