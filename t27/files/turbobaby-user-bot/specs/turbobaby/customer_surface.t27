pub const HOME_FIGURES_PRINTED : u8 = 1;
pub const HOME_FIGURE_SOURCE : str = "server order total, formatted at src/ui/screens/home_screen.rs:322 and rendered at :345";
pub const D20_RULE_HOLDS_AT_THIS_MEASUREMENT : bool = true;

pub fn surface_conforms(product_hits: u8, medical_hits: u8, unsourced_figures: u8) bool {
  return product_hits == 0 and medical_hits == 0 and unsourced_figures == 0;
}

