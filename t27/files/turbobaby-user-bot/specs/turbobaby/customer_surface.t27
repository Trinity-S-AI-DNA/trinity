pub const TRUST_SLOT_COUNT : u8 = 4;
pub const TRUST_KEYS_NAMED_FOR_A_RETIRED_CLAIM : u8 = 3;
pub const TRUST_KEYS_NAMED_FOR_WHAT_THEY_CARRY : u8 = 1;
pub const TRUST_KEY_DECLARATION_SITE : str = "src/trios/i18n.rs:226-229";
pub const TRUST_ROW_SITES : [2]str = ["src/trios/i18n.rs:917-920", "src/trios/i18n.rs:1517-1520"];
pub const TRUST_SLOT_SITES : [4]str = [
  "src/ui/screens/home_screen.rs:441",
  "src/ui/screens/home_screen.rs:442",
  "src/ui/screens/home_screen.rs:444",
  "src/ui/screens/home_screen.rs:445-449"
];
pub const CLAIM_CLASS_IS_READ_FROM_CONTENT : bool = true;
pub const CLAIM_CLASS_IS_READ_FROM_THE_KEY_NAME : bool = false;
pub const CLAIM_TEXT_IS_PUBLISHED_HERE : [0]str = [];

pub fn key_name_is_stale(named_for_retired_claim: bool, carries_permitted_claim: bool) bool {
  return named_for_retired_claim and carries_permitted_claim;
}

pub fn slot_accounting_closes(slots: u8, stale_names: u8, sound_names: u8) bool {
  return slots == stale_names + sound_names;
}

; --- What the surface asserts today -----------------------------------------------------------
; D20's rule holds on this surface at this measurement, and the measurement is a pair of zeros
; over one tracked file: grep -ci insurance src/ui/screens/home_screen.rs -> 0, and the same for
; deposit -> 0. The screen selects seventeen i18n keys in all and four of them are the trust
; slots. It prints exactly one figure, an order total the server computed, through format_baht at
; :318 and rendered at :341; it asserts no fact out of data/fleet_seed.json at all, so the seed
; class is permitted here and currently unused.
