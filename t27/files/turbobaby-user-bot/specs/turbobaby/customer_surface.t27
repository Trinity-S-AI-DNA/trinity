pub const ROUTER_SOURCE : str = "src/ui/routes.rs";
pub const STRING_TABLE_SOURCE : str = "src/trios/i18n.rs";
pub const PROFILE_SURFACE : str = "src/ui/screens/profile_screen.rs";
pub const DELEGATING_SURFACE : str = "src/ui/screens/menu_screen.rs:39-43, a delegation to CatalogScreen";
pub const WITNESS : str = "tests/customer_surface_wiring.rs";

; --- Ownership edges ------------------------------------------------------------------------
; Six OUTBOUND edges. This language has no import, so an edge is the owner's ID held as a string
; constant plus a test asserting the literal: that is the shape a grep can find from either end
; -- when both ends declare one. Outbound is the only end this file controls, and one of the six
; is outbound-only today; that gap is named in RECIPROCAL_EDGE_GAP below rather than assumed away.
; Each note names the sibling's DECLARATION rather than a line in it.
;
; RE-MEASURED 2026-09-21, from git. The count that used to stand here -- ten contracts in the wave
; before this one -- is confirmed: that commit added exactly ten. What it left out is this file's
; OWN wave, which added THIRTEEN more beside it, so the number of siblings moving under a line
; citation was larger than the sentence implied. "Went stale inside the hour" is dropped: nobody
; timed the interval, and this file does not publish a figure it cannot open.
;
; The corpus-wide RESIDUE is refused a constant too, and refusing it is the lesson. Counted at 63
; when this correction began and at 7 a few minutes later, because sibling contracts are being
; repaired in parallel: a total pinned here would be stale before the commit carrying it landed,
; which is the same defect wearing different clothes. What is pinned is what cannot move -- the
; wave sizes, which are git history, and this file's own contribution, which is zero. A name is the
; durable half; a number is not, and a number that moves while you read it is not even that.
pub const CORPUS_T27_FILE_COUNT : u8 = 43;
pub const PRIOR_WAVE_NEW_CONTRACTS : u8 = 10;
pub const OWN_WAVE_NEW_CONTRACTS : u8 = 13;
pub const SIBLING_LINE_CITATIONS_IN_THIS_FILE : u8 = 0;
pub const CORPUS_RESIDUE_IS_PINNED_HERE : bool = false;
pub const CORPUS_RESIDUE_NOTE : str = "Counted twice on 2026-09-21 during this correction: 63 at the start and 7 a few minutes later. The drop is sibling contracts being repaired in parallel, not a measurement error. A live corpus-wide total is therefore refused a constant here, because pinning one would publish a number that goes stale before the commit carrying it lands. Any reader who needs today's figure can grep for it in one line; what this file owes is the two wave counts a grep cannot recover, and those are above.";
pub const WAVE_CENSUS_MEASURED_AT : str = "2026-09-21";
pub const WAVE_CENSUS_SOURCE : str = "git log over specs/turbobaby, added-file counts per commit";
pub const STALENESS_INTERVAL_IS_PUBLISHED : bool = false;

pub fn edge_is_durable(names_a_declaration: bool, names_a_line_number: bool) bool {
  return names_a_declaration and !names_a_line_number;
}
pub const REUSES_LEGACY_RETIREMENT_ID : str = "turbobaby/legacy-retirement";
pub const REUSES_PRICING_HONESTY_ID : str = "turbobaby/pricing-honesty";
pub const REUSES_LOCALE_POLICY_ID : str = "turbobaby/locale-policy";
pub const REUSES_DEEPLINK_ID : str = "turbobaby/deeplink";
pub const REUSES_AVAILABILITY_ID : str = "turbobaby/availability";
pub const REUSES_RUNTIME_CONFIG_ID : str = "turbobaby/runtime-config";
pub const REUSE_EDGE_COUNT : u8 = 6;

pub const LEGACY_RETIREMENT_SUPPLIES : str = "turbobaby/legacy-retirement owns surface_is_retired and retirement_state. Whether the SUBJECT of a claim has been retired arrives here as one boolean; the retirement states, the migrations and the allowlist are not restated.";
pub const PRICING_HONESTY_SUPPLIES : str = "turbobaby/pricing-honesty owns is_present and render. Whether a figure has a published source arrives here as one boolean; this file adds only the surface rule that a screen may not supply the source itself.";
pub const LOCALE_POLICY_SUPPLIES : str = "turbobaby/locale-policy owns locale_is_published and the declared key count. A claim is a row in two tables; which tables exist and what an unpublished variant resolves to are that file's, and no locale, fallback or key total is repeated here.";
pub const DEEPLINK_SUPPLIES : str = "turbobaby/deeplink owns deeplink_landing and deeplink_is_a_dead_tap. A tab is the same destination reached by a tap instead of a link, so the dead-destination rule is shared; the payload grammar, the target list and the landing kinds stay there.";
pub const AVAILABILITY_SUPPLIES : str = "turbobaby/availability owns is_bookable and may_confirm. A seed fact a screen may assert is admissible only because that file decided it; no stock count, unit status or family key appears here.";
pub const RUNTIME_CONFIG_SUPPLIES : str = "turbobaby/runtime-config owns BOT_HANDLE_CLIENT_LITERAL_SITES, BOT_HANDLE_SERVER_READS_ENV and knob_governs_whole_deployment. The trust block's outbound link is one of the client literals that file enumerates; whether the handle knob governs the whole deployment is its ruling and its resolver measurement, and neither the environment variable nor its fallback behaviour is restated here. This file keeps only the surface consequence, in SUPPORT_LINK_FOLLOWS_CONFIGURATION. All three declaration names were opened on 2026-09-21 and all three still stand, and the enumeration was checked rather than assumed: BOT_HANDLE_CLIENT_LITERAL_SITES is a six-element array and src/ui/screens/home_screen.rs:446 -- this surface's one outbound link -- is a member of it, so 'already counts this slot' is a read fact and not a courtesy.";

; --- The one edge that runs in one direction only -------------------------------------------------
; MEASURED 2026-09-21, and declared because the paragraph above would otherwise let a reader assume
; symmetry. The shared fact is co-declared from one side only: this file declares the edge to
; turbobaby/runtime-config, and that owner declares none back.
;
; RE-MEASURED THE SAME DAY, and the first wording of this note had to be corrected. It said "a grep
; of runtime_config.t27 for this contract's ID returns ZERO". That grep now returns ONE -- and the
; one hit is a COMMENT, not a declaration. That owner was counting, in prose, which files declare
; edges TOWARD him, and the sentence naming turbobaby/customer-surface is part of that census; his
; own SHARED_ROWS_WITH_A_RECIPROCAL_EDGE is 2 and this surface is not one of the two. So the
; substance held and the sentence did not, which is why the distinction is now carried in two
; separate constants instead of one: being MENTIONED and being DECLARED are different facts, and a
; bare grep count cannot tell them apart. His BOT_HANDLE_CLIENT_LITERAL_SITES still reaches this
; surface by SOURCE PATH (src/ui/screens/home_screen.rs:446) and never by contract ID.
;
; This file cannot repair the gap -- an edge is declared by the file that carries it, and this file
; does not own runtime_config.t27 -- so what it does is state the gap where a reader meets the
; claim, rather than let "named by ID from both ends" stand as a description of a pair named from
; one. What closing it would take, so the next author need not re-derive it: a reciprocal ID
; constant in turbobaby/runtime-config naming turbobaby/customer-surface as the surface that owns
; the CONTACT-claim consequence of the handle knob. Until that constant exists, a reader starting
; from the runtime-config end finds this file through a source path and a passing comment, and
; learns nowhere that a contract already rules on what that link may claim.
pub const RECIPROCAL_EDGE_GAP : str = "turbobaby/runtime-config mentions turbobaby/customer-surface in one comment and declares no edge constant back to it";
pub const RECIPROCAL_EDGE_GAP_MEASURED_AT : str = "2026-09-21";
pub const RUNTIME_CONFIG_NAMES_THIS_CONTRACT_BACK : bool = false;
pub const RUNTIME_CONFIG_MENTIONS_THIS_CONTRACT_IN_PROSE : bool = true;
pub const RUNTIME_CONFIG_PROSE_MENTIONS_OF_THIS_CONTRACT : u8 = 1;
pub const RUNTIME_CONFIG_RECIPROCAL_ROWS_AND_THIS_IS_NOT_ONE : u8 = 2;
pub const RUNTIME_CONFIG_REACHES_THIS_SURFACE_BY_PATH : bool = true;
pub const RUNTIME_CONFIG_LITERAL_SITE_COUNT : u8 = 6;
pub const THIS_SURFACES_LINK_IS_AMONG_THEM : bool = true;
pub const RUNTIME_CONFIG_DECLARATIONS_LEANED_ON : [3]str = [
  "BOT_HANDLE_CLIENT_LITERAL_SITES",
  "BOT_HANDLE_SERVER_READS_ENV",
  "knob_governs_whole_deployment"
];
pub const EDGE_IS_RECIPROCAL_BY_ID : bool = false;

pub fn edge_is_named_from_both_ends(this_side_names_it: bool, other_side_names_it: bool) bool {
  return this_side_names_it and other_side_names_it;
}

pub fn a_path_citation_substitutes_for_an_id_edge(reached_by_path: bool) bool {
  return reached_by_path and false;
}

; A mention in a comment is not a declared edge, and a grep that counts both cannot tell a reader
; which one he has found. Only the declaration counts.
pub fn a_prose_mention_is_a_declared_edge(mentioned_in_prose: bool, declared_as_a_constant: bool) bool {
  return declared_as_a_constant;
}

; --- Claim classes ----------------------------------------------------------------------------
; Seven classes, four admitted and three refused, and the split is D20's own at :396-397: the
; block carries verifiable rental facts and the product claims it names -- insurance, deposit
; terms -- stay the owner's to make. CLAIM_UNSET is neither admitted nor refused on purpose: an
; unclassified row is not a permitted row, and it is not evidence of a violation either.
pub const CLAIM_UNSET : u8 = 0;
pub const CLAIM_LEGAL_ENTITY : u8 = 1;
pub const CLAIM_LAW : u8 = 2;
pub const CLAIM_SEED_FACT : u8 = 3;
pub const CLAIM_CONTACT : u8 = 4;
pub const CLAIM_PRODUCT : u8 = 5;
pub const CLAIM_MEDICAL : u8 = 6;
pub const CLAIM_UNSOURCED_NUMBER : u8 = 7;
pub const CLAIM_KIND_COUNT : u8 = 7;

pub const PERMITTED_CLAIM_COUNT : u8 = 4;
pub const REFUSED_CLAIM_COUNT : u8 = 3;
pub const PERMITTED_CLAIM_NAMES : [4]str = ["legal_entity", "law", "seed_fact", "contact"];
pub const REFUSED_CLAIM_NAMES : [3]str = ["product_claim", "medical_claim", "unsourced_number"];

pub fn claim_kind_is_known(kind: u8) bool {
  return kind >= CLAIM_LEGAL_ENTITY and kind <= CLAIM_UNSOURCED_NUMBER;
}

pub fn claim_is_permitted(kind: u8) bool {
  return kind == CLAIM_LEGAL_ENTITY or kind == CLAIM_LAW or kind == CLAIM_SEED_FACT or kind == CLAIM_CONTACT;
}

pub fn claim_is_refused(kind: u8) bool {
  return kind == CLAIM_PRODUCT or kind == CLAIM_MEDICAL or kind == CLAIM_UNSOURCED_NUMBER;
}

; Admission. A permitted class is necessary and not sufficient: the row must also name where the
; fact comes from. "Named" means a citation a reader can open -- a registry line, a statute, a
; seed field -- and not the sentence's own confidence.
pub fn claim_may_render(kind: u8, source_is_named: bool) bool {
  if (!claim_is_permitted(kind)) {
    return false;
  }
  return source_is_named;
}

; The retirement gate, consuming legacy-retirement's verdict as a boolean. A retired subject is
; refused whatever class it would otherwise fall under, and the key it arrives under does not
; rescue it: three of the four keys on this surface are still named for retired claims.
pub fn claim_may_render_after_retirement(kind: u8, source_is_named: bool, subject_is_retired: bool) bool {
  if (subject_is_retired) {
    return false;
  }
  return claim_may_render(kind, source_is_named);
}

; The number rule, consuming pricing-honesty's verdict as a boolean. A screen may print a figure
; only when something outside the screen published it AND that published value is present. The
; screen supplies neither half; an absent value is not a zero and a plausible value is not a
; source.
pub fn number_may_be_shown(source_is_published: bool, value_is_present: bool) bool {
  return source_is_published and value_is_present;
}

pub fn screen_may_supply_its_own_number() bool {
  return false;
}

