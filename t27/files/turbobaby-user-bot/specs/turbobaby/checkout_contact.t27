; count they left is turbobaby/locale-policy's (TRANSLATION_KEY_COUNT).
pub const AGE_GATE_I18N_KEYS_DELETED : u8 = 5;
pub const AGE_GATE_I18N_KEYS_DELETED_NAMES : [5]str = [
  "T_CHECKOUT_ERR_AGE",
  "T_CHECKOUT_ERR_AGE_NOT_CONFIRMED",
  "T_CHECKOUT_TRUST_VERIFIED",
