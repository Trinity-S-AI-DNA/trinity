; ------------------------------------------------------------------------------------------
; (6) WHICH FIELDS A CHECKOUT MAY REFUSE TO PROCEED WITHOUT
; ------------------------------------------------------------------------------------------
; The button gate, in the order src/trios/store.rs:460-479 pushes. Its inputs are decisions,
; not strings: name_ok and address_ok come from section (4), phone_ok from a branch of section
; (2) that is not BRANCH_REFUSED, has_identity from turbobaby/request-identity's world, and
; cart_lines from the cart. The age box was a sixth input, the last, until 2026-09-25.
pub fn button_first_blocker(has_identity: bool, cart_lines: u16, name_ok: bool, phone_ok: bool, address_ok: bool) u8 {
  if (!has_identity) {
    return BLOCKER_NO_TELEGRAM;
  }
  if (cart_lines == 0) {
    return BLOCKER_EMPTY_CART;
  }
  if (!name_ok) {
    return BLOCKER_NAME;
  }
  if (!phone_ok) {
    return BLOCKER_PHONE;
  }
  if (!address_ok) {
    return BLOCKER_ADDRESS;
  }
  return BLOCKER_CLEAR;
}

pub fn button_admits(has_identity: bool, cart_lines: u16, name_ok: bool, phone_ok: bool, address_ok: bool) bool {
  return button_first_blocker(has_identity, cart_lines, name_ok, phone_ok, address_ok) == BLOCKER_CLEAR;
}

; The submit handler behind the same button. The VALIDATOR the handler ends in takes five
; arguments over four subjects (src/trios/store.rs:495-501) and has no has_telegram_id
; parameter -- but the handler is the closure at src/ui/screens/checkout_screen.rs:877, and that
; closure refuses a missing identity at :893-897 before it calls the validator at :904. The
; closure is the only production caller, and every entry to it (:1133, :1601, :1680) passes
; through that check. So the handler reaches all five subjects: the absent parameter is a fact
; about the function, not a gap in the gate. Both halves are recorded so the next reader does
; not re-file the signature as a hole -- this file's own first draft did exactly that. Until
; 2026-09-25 the closure also refused an unticked age box at :898-902, a second subject the
; validator lacked; those lines are a comment now, and the counts before that day are kept.
pub const BUTTON_ARGUMENT_COUNT : u8 = 6;
pub const BUTTON_ARGUMENT_COUNT_BEFORE_2026_09_25 : u8 = 7;
pub const VALIDATOR_ARGUMENT_COUNT : u8 = 5;
pub const VALIDATOR_SUBJECT_COUNT : u8 = 4;
pub const SUBJECTS_MISSING_FROM_THE_VALIDATOR : u8 = 1;
pub const SUBJECTS_MISSING_FROM_THE_VALIDATOR_NAMES : [1]str = ["has_telegram_id"];
pub const SUBJECTS_MISSING_FROM_THE_VALIDATOR_BEFORE_2026_09_25 : u8 = 2;
pub const SUBJECTS_MISSING_FROM_THE_VALIDATOR_NAMES_BEFORE_2026_09_25 : [2]str = ["has_telegram_id", "age_confirmed"];
pub const VALIDATOR_PRODUCTION_CALL_SITES : u8 = 1;
pub const THE_CALL_SITE_SUPPLIES_THE_MISSING_SUBJECTS : bool = true;

pub fn handler_admits(has_identity: bool, cart_lines: u16, name_ok: bool, phone_ok: bool, address_ok: bool) bool {
  return has_identity and cart_lines >= 1 and name_ok and phone_ok and address_ok;
}

; Given the SAME verdict on each field, the two client gates are one gate. Everything that can
; split them lives in how each computes name_ok, phone_ok and address_ok -- section (4).
pub fn gates_agree_on_shared_field_verdicts(has_identity: bool, cart_lines: u16, name_ok: bool, phone_ok: bool, address_ok: bool) bool {
  return button_admits(has_identity, cart_lines, name_ok, phone_ok, address_ok) == handler_admits(has_identity, cart_lines, name_ok, phone_ok, address_ok);
}

; The split, stated as a whole checkout: every other subject satisfied, identity present, and
; ONE field whose content clears its cap while its raw length does not. Note the first
; argument: the split is reachable with identity true, which is why "the two gates only differ
; on the arguments the validator lacks" was the wrong story. Until 2026-09-25 a ticked age box
; was one more precondition here; with the box gone the split needs one fewer.
pub fn the_two_client_gates_split(has_identity: bool, cart_lines: u16, trimmed_chars: u16, raw_chars: u16, cap: u16) bool {
  return has_identity and cart_lines >= 1 and padding_splits_the_two_gates(trimmed_chars, raw_chars, cap);
}

; The shipped agreement test, src/trios/store.rs:1047-1068: five hand-written rows at
; src/trios/store.rs:1054-1058. The witness it would need is a padded one, and it has none.
; RE-POINTED 2026-09-24: every src/trios/store.rs line this file cites inside that file's test
; module moved fifteen lines down when served_zone_id (the checkout's saved-zone rule) was added
; above the module; the numbers here and above are re-measured, and nothing they point at changed.
; RE-POINTED 2026-09-25: seventeen lines up (1064-1085 to 1047-1068, 1087-1108 to 1070-1090).
; Every call above the agreement test lost its age argument, two of those calls now fit on two
; lines, and two test comments grew; the rows and assertions are the same, less that argument.
pub const AGREEMENT_ROWS_SHIPPED : u8 = 5;
pub const AGREEMENT_ROWS_CARRYING_PADDING : u8 = 0;

pub fn shipped_agreement_test_can_see_the_split() bool {
  return AGREEMENT_ROWS_CARRYING_PADDING >= 1;
}

; ------------------------------------------------------------------------------------------
; (7) THE THIRD GATE, AND HOW LITTLE OF THE SET SURVIVES IT
; ------------------------------------------------------------------------------------------
; The two client gates demand the same five subjects; the server demands one of them, the
; non-empty cart, and no contact-bearing one. Counted on ONE scale -- subjects demanded, not
; arguments taken -- so the three numbers can honestly be compared.
; SERVER_REQUIRED_CONTACT_SUBJECTS is kept separately because it answers a different question
; and would otherwise be read as the server's whole requirement, which it is not: a non-empty
; cart is still enforced. Until 2026-09-25 the counts were six, six and two, the server's two
; being age and the cart; they are kept under _BEFORE_2026_09_25 names.
pub const GATE_BUTTON : u8 = 1;
pub const GATE_SUBMIT_HANDLER : u8 = 2;
pub const GATE_SERVER : u8 = 3;
pub const GATE_COUNT : u8 = 3;
pub const GATE_NAMES : [3]str = ["button_state", "submit_handler", "server_create_order"];

pub const BUTTON_REQUIRED_SUBJECTS : u8 = 5;
pub const HANDLER_REQUIRED_SUBJECTS : u8 = 5;
pub const SERVER_REQUIRED_SUBJECTS : u8 = 1;
pub const SERVER_REQUIRED_CONTACT_SUBJECTS : u8 = 0;
pub const SERVER_REQUIRED_SUBJECT_NAMES : [1]str = ["cart"];
pub const BUTTON_REQUIRED_SUBJECTS_BEFORE_2026_09_25 : u8 = 6;
pub const HANDLER_REQUIRED_SUBJECTS_BEFORE_2026_09_25 : u8 = 6;
pub const SERVER_REQUIRED_SUBJECTS_BEFORE_2026_09_25 : u8 = 2;
pub const SERVER_REQUIRED_SUBJECT_NAMES_BEFORE_2026_09_25 : [2]str = ["age", "cart"];

pub fn gate_is_known(gate: u8) bool {
  return gate >= GATE_BUTTON and gate <= GATE_SERVER;
}

pub fn gate_required_subjects(gate: u8) u8 {
  if (gate == GATE_BUTTON) {
    return BUTTON_REQUIRED_SUBJECTS;
  }
  if (gate == GATE_SUBMIT_HANDLER) {
    return HANDLER_REQUIRED_SUBJECTS;
  }
  return SERVER_REQUIRED_SUBJECTS;
}

pub fn gates_require_the_same_subject_count(a: u8, b: u8) bool {
  return gate_required_subjects(a) == gate_required_subjects(b);
}

; Same count is not yet the same set, so the claim is made only where it was measured: the two
; client gates are the same five subjects, named in the same order, and the server's one is a
; proper subset of them.
pub fn gate_is_a_client_gate(gate: u8) bool {
  return gate == GATE_BUTTON or gate == GATE_SUBMIT_HANDLER;
}

pub fn gates_require_the_same_set(a: u8, b: u8) bool {
  return a == b or (gate_is_a_client_gate(a) and gate_is_a_client_gate(b));
}

; Measured at src/api/orders.rs. An empty cart is refused (:154); a present phone is capped
; (:123) and shape-checked (:131) but an ABSENT one is never asked for (:122 guards on Some); a
; name is capped when present and never demanded (:117-121); an address is never checked at all
; and its column is bare TEXT (migrations/044_order_delivery_fields.sql:5); and a missing
; identity opens the anonymous rate-limit branch rather than a refusal (:870-885). Age is not
; checked at all any more: until 2026-09-25 it was refused outright at :146-148, with HTTP 422
; rather than the 400 every other refusal of validate_create_order returns, and :145-148 is a
; comment of the same four lines now.
pub const SERVER_REQUIRES_AGE : bool = false;
pub const SERVER_REQUIRED_AGE_BEFORE_2026_09_25 : bool = true;
pub const SERVER_STILL_ACCEPTS_THE_AGE_FIELD : bool = true;
pub const SERVER_STORES_THE_AGE_FIELD_AS_SENT : bool = true;
; Gate 3 binds the first of these: comparisons of the age field (== or !=) in src/api/orders.rs
; outside a line comment, the shape the refusal had. Zero now, one until 2026-09-25, and the
; store line is the witness that the scan still sees the field. A refusal written in another
; shape (a negated unwrap_or, a match) would not be counted: the binding pins the shape that
; was, not every shape one could take.
pub const AGE_FIELD_COMPARISONS_IN_THE_ORDERS_MODULE : u8 = 0;
pub const AGE_FIELD_COMPARISONS_IN_THE_ORDERS_MODULE_BEFORE_2026_09_25 : u8 = 1;
pub const SERVER_REQUIRES_NON_EMPTY_CART : bool = true;
pub const SERVER_REQUIRES_NAME : bool = false;
pub const SERVER_REQUIRES_PHONE : bool = false;
pub const SERVER_REQUIRES_ADDRESS : bool = false;
pub const SERVER_REQUIRES_IDENTITY : bool = false;
pub const SERVER_CAPS_ADDRESS_LENGTH : bool = false;
pub const SERVER_CAPS_NAME_LENGTH_WHEN_PRESENT : bool = true;
pub const SERVER_CHECKS_PHONE_SHAPE_WHEN_PRESENT : bool = true;

; What the server does with the age field under a given policy. A cached old bundle sends the
; field true, a current one does not send it at all, and a hand-made request may send false.
; Under the policy in force since 2026-09-25 none of the three is refused; under the one before
; it only a true field went through.
pub fn server_refuses_on_age(requires_age: bool, field_present: bool, field_true: bool) bool {
  if (!requires_age) {
    return false;
  }
  return !(field_present and field_true);
}

; "The server enforces this reason" and "the server has any check on this field" are two
; different questions, and answering only the first turns the name and phone caps at
; src/api/orders.rs:118 and :131 into checks that appear not to exist. Both are asked.
pub fn server_refuses_on_absence(blocker: u8) bool {
  if (blocker == BLOCKER_EMPTY_CART) {
    return SERVER_REQUIRES_NON_EMPTY_CART;
  }
  return false;
}

pub fn server_checks_the_field_at_all(blocker: u8) bool {
  if (server_refuses_on_absence(blocker)) {
    return true;
  }
  if (blocker == BLOCKER_NAME) {
    return SERVER_CAPS_NAME_LENGTH_WHEN_PRESENT;
  }
  if (blocker == BLOCKER_PHONE) {
    return SERVER_CHECKS_PHONE_SHAPE_WHEN_PRESENT;
  }
  return false;
}

; Four blockers the server never DEMANDS, of which two it does not look at in any way. They
; were four of six until 2026-09-25 and are four of five now: the age box was one the server
; did demand, so its removal moved neither number.
pub fn blocker_presence_is_browser_only(blocker: u8) bool {
  return blocker_is_known(blocker) and !server_refuses_on_absence(blocker);
}

pub fn blocker_is_browser_only(blocker: u8) bool {
  return blocker_is_known(blocker) and !server_checks_the_field_at_all(blocker);
}

pub const BLOCKERS_THE_SERVER_NEVER_DEMANDS : u8 = 4;
pub const BROWSER_ONLY_BLOCKERS : u8 = 2;
pub const BROWSER_ONLY_BLOCKER_NAMES : [2]str = ["no_telegram", "address"];

; ------------------------------------------------------------------------------------------
; (8) WHAT REACHES THE COLUMN
; ------------------------------------------------------------------------------------------
; Two sites format the phone for the wire and BOTH fall back to the typed string when
; normalization returns nothing: src/ui/screens/checkout_screen.rs:1019 and
; src/api/orders.rs:1543-1546. Neither fallback can fire on a request the server accepted,
; because src/api/orders.rs:131 has already rejected anything the normalizer refuses. So the
; column holds E.164 as a consequence of the VALIDATOR, never of the format call -- and if the
; validator at :131 were ever relaxed, both fallbacks would start writing raw input silently.
pub const RAW_FALLBACK_SITES : u8 = 2;
pub const NORMALIZATION_IS_GUARANTEED_BY_THE_FORMAT_CALL : bool = false;
pub const NORMALIZATION_IS_GUARANTEED_BY_THE_VALIDATOR : bool = true;

pub fn stored_phone_is_normalized(phone_present: bool, validator_rejects_unnormalizable: bool) bool {
  return phone_present and validator_rejects_unnormalizable;
}

; ------------------------------------------------------------------------------------------
; (9) HONEST REFUSALS
; ------------------------------------------------------------------------------------------
pub const PHONE_NUMBERS_PUBLISHED : [0]str = [];
pub const ADDRESSES_PUBLISHED : [0]str = [];
pub const CUSTOMER_NAMES_PUBLISHED : [0]str = [];
pub const D14_APPLIES : bool = true;
pub const D14_NOTE : str = "DECISIONS.md:186-200 forbids renter names, Telegram handles and phone numbers in this repository in any form. A contract about phone shape is the easiest place in the corpus to break that rule by accident, so every rule here is stated in digit counts and named shape flags, and the arrays above are pinned empty rather than merely left out.";

; What this contract cannot answer, stated rather than guessed.
pub const PHONE_OWNERSHIP_IS_VERIFIED : bool = false;
pub const PHONE_OWNERSHIP_NOTE : str = "Nothing in the repository proves the number belongs to the person typing it: there is no confirmation code, no callback and no carrier lookup on any path into the create-order handler. The checkout validates SHAPE and never OWNERSHIP, so a normalized number is a well-formed string and not a reachable customer.";
pub const NATIONAL_LENGTH_IS_VALIDATED_PER_COUNTRY : bool = false;
pub const NATIONAL_LENGTH_NOTE : str = "The digit bounds are global and no per-country length table exists anywhere in src/. A number with a plausible calling code and an impossible national length is accepted. Adding such a table is a data question with a source requirement under D11, so nothing is invented here.";

; ------------------------------------------------------------------------------------------
; Tests
; ------------------------------------------------------------------------------------------

test reused_contract_ids_are_the_owners_own_literals {
  assert REUSES_MARKET_ID == "turbobaby/market";
  assert REUSES_COMMERCE_ID == "turbobaby/commerce";
  assert REUSES_DELIVERY_TERMS_ID == "turbobaby/delivery-terms";
  assert REUSES_ORDER_MONEY_ID == "turbobaby/order-money";
  assert REUSES_LOCALE_POLICY_ID == "turbobaby/locale-policy";
  assert REUSES_CLIENT_ERRORS_ID == "turbobaby/client-errors";
  assert REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity";
  assert REUSED_CONTRACT_COUNT == 7;
  assert AGE_BLOCKER_RETIREMENT_OWNER == "turbobaby/legacy-retirement";
}

test this_contract_owns_its_own_identity {
  assert KIND == "contract";
  assert ID == "turbobaby/checkout-contact";
  assert MEASURED_AT == "2026-09-21";
  assert CORE_IMPLEMENTATION == "src/trios/store.rs";
}

test phone_digit_bounds_are_closed_at_both_ends {
  assert phone_digits_admitted(4) == false;
  assert phone_digits_admitted(5) == true;
  assert phone_digits_admitted(15) == true;
  assert phone_digits_admitted(16) == false;
  assert PHONE_DIGITS_MAX_IS_THE_E164_CEILING == true;
  assert PHONE_DIGITS_MIN_IS_AN_E164_RULE == false;
}

test the_raw_field_is_bounded_before_a_digit_is_read {
  assert phone_trimmed_length_admitted(0) == false;
  assert phone_trimmed_length_admitted(1) == true;
  assert phone_trimmed_length_admitted(50) == true;
  assert phone_trimmed_length_admitted(51) == false;
}

test a_normalized_phone_is_a_plus_and_digits {
  assert NORMALIZED_PHONE_LEADS_WITH_PLUS == true;
  assert NORMALIZED_PHONE_HOLDS_DIGITS_ONLY_AFTER_THE_PLUS == true;
}

test the_five_accepting_shapes_are_selected_in_shipped_precedence {
  assert normalizer_branch(14, 11, true, false, false, false) == BRANCH_LEADING_PLUS;
  assert normalizer_branch(13, 13, false, true, false, false) == BRANCH_IDD_ZEROS;
  assert normalizer_branch(11, 11, false, false, true, false) == BRANCH_FOREIGN_TRUNK;
  assert normalizer_branch(10, 10, false, false, false, true) == BRANCH_NATIONAL_TRUNK_ZERO;
  assert normalizer_branch(11, 11, false, false, false, false) == BRANCH_BARE_INTERNATIONAL;
  assert BRANCH_COUNT == 5;
  assert BRANCH_NAMES.len == 5;
}

test a_leading_plus_outranks_every_other_shape {
  assert normalizer_branch(14, 11, true, true, true, true) == BRANCH_LEADING_PLUS;
}

test the_outer_bounds_refuse_before_any_shape_is_considered {
  assert normalizer_branch(0, 11, true, false, false, false) == BRANCH_REFUSED;
  assert normalizer_branch(51, 11, true, false, false, false) == BRANCH_REFUSED;
  assert normalizer_branch(12, 4, false, false, false, false) == BRANCH_REFUSED;
  assert normalizer_branch(20, 16, false, false, false, false) == BRANCH_REFUSED;
}

test a_stripped_prefix_refuses_instead_of_falling_through {
  assert normalizer_branch(7, 6, false, true, false, false) == BRANCH_REFUSED;
  assert normalizer_branch(6, 5, false, false, false, true) == BRANCH_REFUSED;
  assert normalizer_branch(8, 7, false, true, false, false) == BRANCH_IDD_ZEROS;
  assert normalizer_branch(7, 6, false, false, false, true) == BRANCH_NATIONAL_TRUNK_ZERO;
}

test refusal_and_acceptance_partition_the_branch_space {
  assert normalizer_refuses(BRANCH_REFUSED) == true;
  assert branch_is_accepting(BRANCH_REFUSED) == false;
  assert branch_is_accepting(BRANCH_LEADING_PLUS) == true;
  assert branch_is_accepting(BRANCH_BARE_INTERNATIONAL) == true;
  assert branch_is_accepting(6) == false;
}

test exactly_one_branch_of_five_consults_the_market {
  assert branch_reads_the_market_profile(BRANCH_NATIONAL_TRUNK_ZERO) == true;
  assert branch_reads_the_market_profile(BRANCH_LEADING_PLUS) == false;
  assert branch_reads_the_market_profile(BRANCH_IDD_ZEROS) == false;
  assert branch_reads_the_market_profile(BRANCH_FOREIGN_TRUNK) == false;
  assert branch_reads_the_market_profile(BRANCH_BARE_INTERNATIONAL) == false;
  assert BRANCHES_READING_THE_MARKET_PROFILE == 1;
  assert COUNTRY_CODE_LITERALS_INSIDE_THE_NORMALIZER == 1;
  assert market_swap_reaches_every_branch() == false;
}

test the_brief_is_refuted_the_default_is_wired_and_the_record_is_stale {
  assert CALLING_CODE_IS_WIRED_TO_THE_PROFILE == true;
  assert SEED_AND_CONSTANT_ARE_PINNED_BY_A_TEST == true;
  assert DECISION_RECORD_STILL_CALLS_IT_UNWIRED == true;
  assert record_matches_the_code(CALLING_CODE_IS_WIRED_TO_THE_PROFILE, DECISION_RECORD_STILL_CALLS_IT_UNWIRED) == false;
  assert tripwire_is_armed(CALLING_CODE_IS_WIRED_TO_THE_PROFILE, DECISION_RECORD_STILL_CALLS_IT_UNWIRED) == true;
}

test the_tripwire_disarms_only_when_the_record_is_corrected {
  assert tripwire_is_armed(true, false) == false;
  assert tripwire_is_armed(false, true) == false;
  assert tripwire_is_armed(false, false) == true;
}

test the_tripwire_citation_was_reopened_and_still_lands {
  assert DECISION_RECORD_CITATION == "DECISIONS.md:351";
  assert DECISION_RECORD_CITATION_REVERIFIED_AT == "2026-09-21";
  assert DECISION_RECORD_CITATION_STILL_LANDS == true;
  assert ISSUE_35_OCCURRENCES_IN_DECISIONS == 1;
  assert ISSUE_35_OCCURRENCES_IN_DECISIONS == ISSUE_35_OCCURRENCES_AS_AN_ISSUE;
  assert ISSUE_35_TOKEN_OCCURRENCES_UNDER_DOCS_REPORTS == 10;
  assert ISSUE_35_TOKEN_OCCURRENCES_UNDER_DOCS_REPORTS > ISSUE_35_OCCURRENCES_IN_DECISIONS;
  assert DEFAULT_COUNTRY_CODE_READ_SITES_IN_THE_NORMALIZER == 1;
  assert DEFAULT_COUNTRY_CODE_READ_SITES_IN_THE_NORMALIZER == BRANCHES_READING_THE_MARKET_PROFILE;
  assert tripwire_citation_is_sound(DECISION_RECORD_CITATION_STILL_LANDS, THIS_FILE_ASSERTS_THE_STALE_CLAIM_AS_FACT) == true;
  assert tripwire_citation_is_sound(false, false) == false;
  assert tripwire_citation_is_sound(true, true) == false;
}

test this_contract_never_repeats_the_records_stale_claim_as_its_own {
  assert THIS_FILE_ASSERTS_THE_STALE_CLAIM_AS_FACT == false;
  assert CALLING_CODE_IS_WIRED_TO_THE_PROFILE == true;
  assert CALLING_CODE_IS_WIRED_TO_THE_PROFILE != THIS_FILE_ASSERTS_THE_STALE_CLAIM_AS_FACT;
  assert DECISION_RECORD_STILL_CALLS_IT_UNWIRED == true;
}

test the_issue_itself_is_not_published_here {
  assert ISSUE_35_BODY_IS_PUBLISHED_HERE == false;
  assert ISSUE_35_OCCURRENCES_AS_AN_ISSUE == 1;
  assert PROFILE_IS_A_COMPILE_TIME_CONSTANT == true;
}

test a_name_needs_content_and_a_bounded_raw_length {
  assert name_admitted(0, 0) == false;
  assert name_admitted(0, 4) == false;
  assert name_admitted(1, 1) == true;
  assert name_admitted(200, 200) == true;
  assert name_admitted(200, 201) == false;
}

test an_address_is_demanded_only_by_a_delivery_mode {
  assert address_admitted(false, 0, 0) == true;
  assert address_admitted(true, 0, 0) == false;
  assert address_admitted(true, 1, 1) == true;
  assert address_admitted(false, 1, 1) == true;
}

test the_address_cap_sits_outside_the_mode_test {
  assert address_admitted(false, 0, 501) == false;
  assert address_admitted(true, 500, 500) == true;
  assert address_admitted(true, 501, 501) == false;
}

test padding_counts_against_a_cap_that_content_alone_would_clear {
  assert CAP_AND_EMPTINESS_READ_THE_SAME_STRING == false;
  assert EMPTINESS_IS_MEASURED_AFTER_TRIM == true;
  assert LENGTH_CAP_IS_MEASURED_BEFORE_TRIM_AT_THE_BUTTON == true;
  assert LENGTH_CAP_IS_MEASURED_AFTER_TRIM_AT_THE_HANDLER == true;
  assert padding_can_refuse_an_inside_cap_field(200, 1, NAME_CHARS_MAX) == true;
  assert padding_can_refuse_an_inside_cap_field(150, 1, NAME_CHARS_MAX) == false;
  assert padding_can_refuse_an_inside_cap_field(201, 0, NAME_CHARS_MAX) == false;
  assert FIELDS_SHARING_THE_TRIM_ASYMMETRY == 3;
  assert PHONE_RAW_CHARS_MAX_AT_THE_BUTTON == 50;
}

; The two gates, one field at a time. The cap is the same number in both; the string is not.
test one_field_judged_by_each_gate_in_turn {
  assert button_field_ok(200, 200, NAME_CHARS_MAX) == true;
  assert button_field_ok(200, 201, NAME_CHARS_MAX) == false;
  assert handler_field_ok(200, NAME_CHARS_MAX) == true;
  assert handler_field_ok(201, NAME_CHARS_MAX) == false;
  assert handler_field_ok(0, NAME_CHARS_MAX) == false;
  assert button_field_ok(0, 0, NAME_CHARS_MAX) == false;
}

test padding_alone_splits_the_two_client_gates_in_all_three_fields {
  assert padding_splits_the_two_gates(200, 201, NAME_CHARS_MAX) == true;
  assert padding_splits_the_two_gates(500, 501, ADDRESS_CHARS_MAX) == true;
  assert padding_splits_the_two_gates(10, 55, PHONE_RAW_CHARS_MAX_AT_THE_BUTTON) == true;
  assert padding_splits_the_two_gates(200, 200, NAME_CHARS_MAX) == false;
  assert padding_splits_the_two_gates(201, 201, NAME_CHARS_MAX) == false;
  assert padding_splits_the_two_gates(0, 0, NAME_CHARS_MAX) == false;
  assert padding_splits_the_two_gates(0, 5, NAME_CHARS_MAX) == false;
}

test a_filled_address_is_not_a_ready_destination {
  assert a_filled_address_means_the_destination_is_ready() == false;
  assert REUSES_DELIVERY_TERMS_ID == "turbobaby/delivery-terms";
}

test the_blocker_set_is_closed_and_ordered_like_the_form {
  assert blocker_is_known(BLOCKER_NO_TELEGRAM) == true;
  assert blocker_is_known(BLOCKER_ADDRESS) == true;
  assert blocker_is_known(BLOCKER_COUNT) == false;
  assert blocker_is_known(BLOCKER_CLEAR) == false;
  assert BLOCKER_NAMES.len == 5;
  assert BLOCKER_NAMES[0] == "no_telegram";
  assert BLOCKER_NAMES[4] == "address";
}

; The owner's answer of 2026-09-25, as this file records it: the box is out of the set, the
; removal is provisional, and the six-member set of the day before is kept beside the five.
test the_owner_removed_the_age_box_for_now_on_2026_09_25 {
  assert AGE_BLOCKER_REMOVED_AT == "2026-09-25";
  assert AGE_BLOCKER_REMOVED_BY_OWNER_ANSWER == 1;
  assert AGE_BLOCKER_REMOVAL_IS_PROVISIONAL == true;
  assert AGE_BLOCKER_IS_IN_THE_REQUIRED_SET == false;
  assert AGE_BLOCKER_WAS_IN_THE_REQUIRED_SET_BEFORE_2026_09_25 == true;
  assert AGE_BLOCKER_IS_INHERITED_HERITAGE == true;
  assert BLOCKER_AGE_RETIRED == BLOCKER_COUNT;
  assert blocker_is_known(BLOCKER_AGE_RETIRED) == false;
  assert BLOCKER_COUNT_BEFORE_2026_09_25 == BLOCKER_COUNT + 1;
  assert BLOCKER_NAMES_BEFORE_2026_09_25.len == BLOCKER_COUNT_BEFORE_2026_09_25;
  assert BLOCKER_NAMES_BEFORE_2026_09_25[4] == BLOCKER_NAMES[4];
  assert BLOCKER_NAMES_BEFORE_2026_09_25[5] == "age";
}

; What went with it, and what did not: five keys and no new sentence, no migration, no row and no
; storage key. The declared-key count is the locale contract's, named here and not restated.
test the_age_box_left_five_keys_and_wrote_nothing_in_their_place {
  assert AGE_GATE_I18N_KEYS_DELETED == 5;
  assert AGE_GATE_I18N_KEYS_DELETED_NAMES.len == AGE_GATE_I18N_KEYS_DELETED;
  assert AGE_GATE_I18N_KEYS_DELETED_NAMES[0] == "T_CHECKOUT_ERR_AGE";
  assert AGE_GATE_I18N_KEYS_DELETED_NAMES[4] == "T_CHECKOUT_AGE_NOTICE";
  assert AGE_GATE_I18N_KEYS_THAT_WERE_RENDERED + AGE_GATE_I18N_KEYS_THAT_WERE_UNREACHABLE == AGE_GATE_I18N_KEYS_DELETED;
  assert AGE_GATE_SENTENCES_WRITTEN_IN_THEIR_PLACE == 0;
  assert AGE_GATE_KEY_COUNT_OWNER_ID == REUSES_LOCALE_POLICY_ID;
  assert AGE_GATE_REMOVAL_ADDS_A_MIGRATION == false;
  assert AGE_GATE_REMOVAL_WRITES_A_ROW == false;
  assert AGE_GATE_REMOVAL_CLEARS_A_STORAGE_KEY == false;
}

test the_clear_sentinel_cannot_collide_with_a_reason {
  assert BLOCKER_CLEAR > BLOCKER_COUNT;
  assert blocker_is_known(BLOCKER_CLEAR) == false;
}

test the_button_reports_the_first_blocker_in_form_order {
  assert button_first_blocker(false, 0, false, false, false) == BLOCKER_NO_TELEGRAM;
  assert button_first_blocker(true, 0, false, false, false) == BLOCKER_EMPTY_CART;
  assert button_first_blocker(true, 1, false, false, false) == BLOCKER_NAME;
  assert button_first_blocker(true, 1, true, false, false) == BLOCKER_PHONE;
  assert button_first_blocker(true, 1, true, true, false) == BLOCKER_ADDRESS;
  assert button_first_blocker(true, 1, true, true, true) == BLOCKER_CLEAR;
}

test the_button_admits_only_a_completely_clear_form {
  assert button_admits(true, 1, true, true, true) == true;
  assert button_admits(false, 1, true, true, true) == false;
  assert button_admits(true, 0, true, true, true) == false;
  assert button_admits(true, 1, false, true, true) == false;
  assert button_admits(true, 1, true, false, true) == false;
  assert button_admits(true, 1, true, true, false) == false;
}

; The validator's signature is short; the handler is not. Both facts are pinned, because
; asserting only the first is how this file's first draft reached a false conclusion. The
; validator was two subjects short until 2026-09-25; the age box was the second.
test the_validator_is_one_subject_short_and_its_one_call_site_supplies_it {
  assert BUTTON_ARGUMENT_COUNT == 6;
  assert BUTTON_ARGUMENT_COUNT_BEFORE_2026_09_25 == BUTTON_ARGUMENT_COUNT + 1;
  assert VALIDATOR_ARGUMENT_COUNT == 5;
  assert VALIDATOR_SUBJECT_COUNT == 4;
  assert SUBJECTS_MISSING_FROM_THE_VALIDATOR == 1;
  assert SUBJECTS_MISSING_FROM_THE_VALIDATOR_NAMES.len == 1;
  assert SUBJECTS_MISSING_FROM_THE_VALIDATOR_NAMES[0] == "has_telegram_id";
  assert SUBJECTS_MISSING_FROM_THE_VALIDATOR_BEFORE_2026_09_25 == 2;
  assert SUBJECTS_MISSING_FROM_THE_VALIDATOR_NAMES_BEFORE_2026_09_25[1] == "age_confirmed";
  assert VALIDATOR_PRODUCTION_CALL_SITES == 1;
  assert THE_CALL_SITE_SUPPLIES_THE_MISSING_SUBJECTS == true;
  assert VALIDATOR_SUBJECT_COUNT + SUBJECTS_MISSING_FROM_THE_VALIDATOR == HANDLER_REQUIRED_SUBJECTS;
  assert VALIDATOR_SUBJECT_COUNT + SUBJECTS_MISSING_FROM_THE_VALIDATOR_BEFORE_2026_09_25 == HANDLER_REQUIRED_SUBJECTS_BEFORE_2026_09_25;
}

test the_handler_refuses_on_every_subject_the_button_refuses_on {
  assert handler_admits(true, 1, true, true, true) == true;
  assert handler_admits(false, 1, true, true, true) == false;
  assert handler_admits(true, 0, true, true, true) == false;
  assert handler_admits(true, 1, false, true, true) == false;
  assert handler_admits(true, 1, true, false, true) == false;
  assert handler_admits(true, 1, true, true, false) == false;
}

; Given one verdict per field, the two client gates cannot be told apart at any of the 32
; corners of their shared argument space (64 while the age box was a sixth argument); the rows
; below are the ones an identity row would have split under the refuted story.
test the_two_client_gates_never_split_on_a_shared_field_verdict {
  assert gates_agree_on_shared_field_verdicts(true, 1, true, true, true) == true;
  assert gates_agree_on_shared_field_verdicts(false, 1, true, true, true) == true;
  assert gates_agree_on_shared_field_verdicts(false, 1, false, true, true) == true;
  assert gates_agree_on_shared_field_verdicts(true, 0, true, true, true) == true;
  assert gates_agree_on_shared_field_verdicts(true, 1, false, false, false) == true;
}

; Where they DO split, and note the first argument: identity present.
test the_split_is_reachable_with_identity_present {
  assert the_two_client_gates_split(true, 1, 200, 201, NAME_CHARS_MAX) == true;
  assert the_two_client_gates_split(true, 1, 500, 501, ADDRESS_CHARS_MAX) == true;
  assert the_two_client_gates_split(true, 1, 10, 55, PHONE_RAW_CHARS_MAX_AT_THE_BUTTON) == true;
  assert the_two_client_gates_split(true, 1, 200, 200, NAME_CHARS_MAX) == false;
  assert the_two_client_gates_split(false, 1, 200, 201, NAME_CHARS_MAX) == false;
  assert the_two_client_gates_split(true, 0, 200, 201, NAME_CHARS_MAX) == false;
}

test the_shipped_agreement_rows_carry_no_padding_so_they_cannot_witness_it {
  assert AGREEMENT_ROWS_SHIPPED == 5;
  assert AGREEMENT_ROWS_CARRYING_PADDING == 0;
  assert shipped_agreement_test_can_see_the_split() == false;
}

test three_gates_guard_one_path_and_the_server_is_the_odd_one_out {
  assert gate_is_known(GATE_BUTTON) == true;
  assert gate_is_known(GATE_SERVER) == true;
  assert gate_is_known(0) == false;
  assert gate_is_known(4) == false;
  assert GATE_COUNT == 3;
  assert GATE_NAMES.len == 3;
  assert gate_required_subjects(GATE_BUTTON) == 5;
  assert gate_required_subjects(GATE_SUBMIT_HANDLER) == 5;
  assert gate_required_subjects(GATE_SERVER) == 1;
  assert gates_require_the_same_subject_count(GATE_BUTTON, GATE_SUBMIT_HANDLER) == true;
  assert gates_require_the_same_subject_count(GATE_SUBMIT_HANDLER, GATE_SERVER) == false;
  assert gates_require_the_same_subject_count(GATE_BUTTON, GATE_SERVER) == false;
  assert gates_require_the_same_set(GATE_BUTTON, GATE_SUBMIT_HANDLER) == true;
  assert gates_require_the_same_set(GATE_BUTTON, GATE_SERVER) == false;
  assert gates_require_the_same_set(GATE_SUBMIT_HANDLER, GATE_SERVER) == false;
  assert gates_require_the_same_set(GATE_SERVER, GATE_SERVER) == true;
  assert gates_require_the_same_set(GATE_BUTTON, GATE_BUTTON) == true;
  assert SERVER_REQUIRED_SUBJECT_NAMES.len == 1;
  assert SERVER_REQUIRED_SUBJECT_NAMES[0] == "cart";
}

; Each gate lost exactly the age box on 2026-09-25; the counts of the day before are kept.
test every_gate_lost_exactly_the_age_box {
  assert BUTTON_REQUIRED_SUBJECTS_BEFORE_2026_09_25 == BUTTON_REQUIRED_SUBJECTS + 1;
  assert HANDLER_REQUIRED_SUBJECTS_BEFORE_2026_09_25 == HANDLER_REQUIRED_SUBJECTS + 1;
  assert SERVER_REQUIRED_SUBJECTS_BEFORE_2026_09_25 == SERVER_REQUIRED_SUBJECTS + 1;
  assert SERVER_REQUIRED_SUBJECT_NAMES_BEFORE_2026_09_25.len == SERVER_REQUIRED_SUBJECTS_BEFORE_2026_09_25;
  assert SERVER_REQUIRED_SUBJECT_NAMES_BEFORE_2026_09_25[0] == "age";
  assert SERVER_REQUIRED_SUBJECT_NAMES_BEFORE_2026_09_25[1] == SERVER_REQUIRED_SUBJECT_NAMES[0];
  assert BLOCKER_COUNT_BEFORE_2026_09_25 == BUTTON_REQUIRED_SUBJECTS_BEFORE_2026_09_25;
  assert BLOCKER_COUNT == BUTTON_REQUIRED_SUBJECTS;
}

; A bundle cached before the change sends the field true, a current one sends nothing, and a
; hand-made request may send false. None of the three is refused now; before, only true passed.
test a_cached_old_client_and_a_current_one_meet_the_same_server {
  assert SERVER_REQUIRES_AGE == false;
  assert SERVER_REQUIRED_AGE_BEFORE_2026_09_25 == true;
  assert SERVER_STILL_ACCEPTS_THE_AGE_FIELD == true;
  assert SERVER_STORES_THE_AGE_FIELD_AS_SENT == true;
  assert AGE_FIELD_COMPARISONS_IN_THE_ORDERS_MODULE == 0;
  assert AGE_FIELD_COMPARISONS_IN_THE_ORDERS_MODULE_BEFORE_2026_09_25 == 1;
  assert server_refuses_on_age(SERVER_REQUIRES_AGE, true, true) == false;
  assert server_refuses_on_age(SERVER_REQUIRES_AGE, false, false) == false;
  assert server_refuses_on_age(SERVER_REQUIRES_AGE, true, false) == false;
  assert server_refuses_on_age(SERVER_REQUIRED_AGE_BEFORE_2026_09_25, true, true) == false;
  assert server_refuses_on_age(SERVER_REQUIRED_AGE_BEFORE_2026_09_25, false, false) == true;
  assert server_refuses_on_age(SERVER_REQUIRED_AGE_BEFORE_2026_09_25, true, false) == true;
}

test the_server_demands_no_contact_field_at_all {
  assert SERVER_REQUIRED_CONTACT_SUBJECTS == 0;
  assert SERVER_REQUIRED_SUBJECTS == 1;
  assert SERVER_REQUIRES_NAME == false;
  assert SERVER_REQUIRES_PHONE == false;
  assert SERVER_REQUIRES_ADDRESS == false;
  assert SERVER_REQUIRES_IDENTITY == false;
  assert SERVER_CAPS_ADDRESS_LENGTH == false;
  assert SERVER_CAPS_NAME_LENGTH_WHEN_PRESENT == true;
  assert SERVER_CHECKS_PHONE_SHAPE_WHEN_PRESENT == true;
}

; Four the server never demands; only two it never looks at. Reporting the first number as the
; second would erase the name cap and the phone shape check that do run server-side.
test two_blockers_have_no_server_counterpart_and_four_are_merely_undemanded {
  assert blocker_presence_is_browser_only(BLOCKER_NO_TELEGRAM) == true;
  assert blocker_presence_is_browser_only(BLOCKER_NAME) == true;
  assert blocker_presence_is_browser_only(BLOCKER_PHONE) == true;
  assert blocker_presence_is_browser_only(BLOCKER_ADDRESS) == true;
  assert blocker_presence_is_browser_only(BLOCKER_EMPTY_CART) == false;
  assert blocker_presence_is_browser_only(BLOCKER_AGE_RETIRED) == false;
  assert BLOCKERS_THE_SERVER_NEVER_DEMANDS == 4;
  assert blocker_is_browser_only(BLOCKER_NO_TELEGRAM) == true;
  assert blocker_is_browser_only(BLOCKER_ADDRESS) == true;
  assert blocker_is_browser_only(BLOCKER_NAME) == false;
  assert blocker_is_browser_only(BLOCKER_PHONE) == false;
  assert blocker_is_browser_only(BLOCKER_EMPTY_CART) == false;
  assert blocker_is_browser_only(BLOCKER_AGE_RETIRED) == false;
  assert blocker_is_browser_only(BLOCKER_COUNT) == false;
  assert BROWSER_ONLY_BLOCKERS == 2;
  assert BROWSER_ONLY_BLOCKER_NAMES.len == 2;
}

test the_one_server_enforced_reason_is_named {
  assert server_refuses_on_absence(BLOCKER_AGE_RETIRED) == false;
  assert server_refuses_on_absence(BLOCKER_EMPTY_CART) == true;
  assert server_refuses_on_absence(BLOCKER_NAME) == false;
  assert server_refuses_on_absence(BLOCKER_CLEAR) == false;
  assert server_checks_the_field_at_all(BLOCKER_NAME) == true;
  assert server_checks_the_field_at_all(BLOCKER_PHONE) == true;
  assert server_checks_the_field_at_all(BLOCKER_ADDRESS) == false;
  assert server_checks_the_field_at_all(BLOCKER_NO_TELEGRAM) == false;
  assert AGE_BLOCKER_IS_INHERITED_HERITAGE == true;
}

test the_column_holds_e164_because_of_the_validator_not_the_formatter {
  assert RAW_FALLBACK_SITES == 2;
  assert NORMALIZATION_IS_GUARANTEED_BY_THE_FORMAT_CALL == false;
  assert NORMALIZATION_IS_GUARANTEED_BY_THE_VALIDATOR == true;
  assert stored_phone_is_normalized(true, true) == true;
  assert stored_phone_is_normalized(true, false) == false;
  assert stored_phone_is_normalized(false, true) == false;
}

test this_file_publishes_no_person_level_datum {
  assert D14_APPLIES == true;
  assert PHONE_NUMBERS_PUBLISHED.len == 0;
  assert ADDRESSES_PUBLISHED.len == 0;
  assert CUSTOMER_NAMES_PUBLISHED.len == 0;
  assert BLOCKER_SENTENCES_QUOTED_HERE.len == 0;
}

test the_gaps_are_declared_rather_than_filled_with_a_plausible_number {
  assert PHONE_OWNERSHIP_IS_VERIFIED == false;
  assert NATIONAL_LENGTH_IS_VALIDATED_PER_COUNTRY == false;
  assert EVERY_BLOCKER_CARRIES_A_MESSAGE_KEY == true;
  assert BLOCKER_KEY_COVERAGE_IS_PROVEN_PER_PUBLISHED_LOCALE == true;
}

; ------------------------------------------------------------------------------------------
; Invariants
; ------------------------------------------------------------------------------------------

invariant a_phone_outside_the_digit_bounds_never_normalizes
  assert phone_digits_admitted(PHONE_DIGITS_MIN - 1) == false and phone_digits_admitted(PHONE_DIGITS_MAX + 1) == false

invariant an_empty_or_overlong_raw_field_never_reaches_a_shape_test
  assert normalizer_branch(0, 11, true, false, false, false) == BRANCH_REFUSED and normalizer_branch(51, 11, true, false, false, false) == BRANCH_REFUSED

invariant a_refused_branch_is_never_an_accepting_one
  assert normalizer_refuses(BRANCH_REFUSED) == true and branch_is_accepting(BRANCH_REFUSED) == false

invariant a_market_swap_cannot_reach_every_normalizer_branch
  assert market_swap_reaches_every_branch() == false and BRANCHES_READING_THE_MARKET_PROFILE < BRANCH_COUNT

invariant the_market_tripwire_stays_armed_while_the_record_contradicts_the_code
  assert tripwire_is_armed(CALLING_CODE_IS_WIRED_TO_THE_PROFILE, DECISION_RECORD_STILL_CALLS_IT_UNWIRED) == true

invariant a_delivery_mode_never_proceeds_on_an_empty_address
  assert address_admitted(true, 0, 0) == false

invariant a_pickup_mode_never_demands_an_address
  assert address_admitted(false, 0, 0) == true

invariant a_filled_form_field_is_never_a_delivery_guarantee
  assert a_filled_address_means_the_destination_is_ready() == false

invariant the_blocker_set_is_closed_at_five
  assert blocker_is_known(BLOCKER_COUNT) == false and BLOCKER_NAMES.len == 5

invariant the_retired_age_code_is_never_a_known_blocker
  assert blocker_is_known(BLOCKER_AGE_RETIRED) == false and BLOCKER_AGE_RETIRED == BLOCKER_COUNT and AGE_BLOCKER_IS_IN_THE_REQUIRED_SET == false

invariant the_server_refuses_no_order_over_its_age_field
  assert server_refuses_on_age(SERVER_REQUIRES_AGE, true, true) == false and server_refuses_on_age(SERVER_REQUIRES_AGE, false, false) == false and server_refuses_on_age(SERVER_REQUIRES_AGE, true, false) == false

invariant the_clear_sentinel_is_outside_the_reason_range
  assert blocker_is_known(BLOCKER_CLEAR) == false

invariant a_clear_button_means_every_named_reason_is_absent
  assert button_admits(true, 1, true, true, true) == true and button_first_blocker(true, 1, true, true, true) == BLOCKER_CLEAR

invariant dropping_identity_never_splits_the_two_client_gates
  assert gates_agree_on_shared_field_verdicts(false, 1, true, true, true) == true and gates_agree_on_shared_field_verdicts(false, 0, false, false, false) == true

invariant only_padding_splits_them_and_it_splits_them_inside_every_other_pass
  assert the_two_client_gates_split(true, 1, 200, 201, NAME_CHARS_MAX) == true and the_two_client_gates_split(true, 1, 200, 200, NAME_CHARS_MAX) == false

invariant the_split_always_points_the_same_way_button_refuses_handler_admits
  assert padding_splits_the_two_gates(200, 201, NAME_CHARS_MAX) == true and button_field_ok(200, 201, NAME_CHARS_MAX) == false and handler_field_ok(200, NAME_CHARS_MAX) == true

invariant the_shipped_agreement_rows_cannot_witness_the_split
  assert shipped_agreement_test_can_see_the_split() == false

invariant the_two_client_gates_require_one_set_and_the_server_requires_another
  assert gates_require_the_same_set(GATE_BUTTON, GATE_SUBMIT_HANDLER) == true and gates_require_the_same_set(GATE_BUTTON, GATE_SERVER) == false and gates_require_the_same_set(GATE_SUBMIT_HANDLER, GATE_SERVER) == false

invariant the_server_requires_no_contact_field
  assert SERVER_REQUIRED_CONTACT_SUBJECTS == 0 and SERVER_REQUIRES_PHONE == false and SERVER_REQUIRES_ADDRESS == false and SERVER_REQUIRES_IDENTITY == false

invariant an_absent_phone_is_never_reported_as_normalized
  assert stored_phone_is_normalized(false, true) == false

invariant a_relaxed_validator_would_surrender_the_stored_format
  assert stored_phone_is_normalized(true, false) == false and NORMALIZATION_IS_GUARANTEED_BY_THE_FORMAT_CALL == false

invariant no_person_level_datum_is_published_by_this_contract
  assert D14_APPLIES == true and PHONE_NUMBERS_PUBLISHED.len == 0 and ADDRESSES_PUBLISHED.len == 0 and CUSTOMER_NAMES_PUBLISHED.len == 0 and BLOCKER_SENTENCES_QUOTED_HERE.len == 0

invariant the_tripwire_never_stands_on_a_citation_that_stopped_landing
  assert tripwire_citation_is_sound(DECISION_RECORD_CITATION_STILL_LANDS, THIS_FILE_ASSERTS_THE_STALE_CLAIM_AS_FACT) == true and tripwire_is_armed(CALLING_CODE_IS_WIRED_TO_THE_PROFILE, DECISION_RECORD_STILL_CALLS_IT_UNWIRED) == true

invariant the_records_stale_sentence_is_never_this_contracts_own_claim
  assert THIS_FILE_ASSERTS_THE_STALE_CLAIM_AS_FACT == false and CALLING_CODE_IS_WIRED_TO_THE_PROFILE == true

invariant an_unverifiable_claim_is_refused_rather_than_invented
  assert PHONE_OWNERSHIP_IS_VERIFIED == false and NATIONAL_LENGTH_IS_VALIDATED_PER_COUNTRY == false
