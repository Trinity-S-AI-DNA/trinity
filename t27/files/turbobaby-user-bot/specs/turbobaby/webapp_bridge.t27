}

; The line survives and the cart does not pretend to know what it costs. One unpriced line makes
; the whole total unknown: summing the rest understates the cart and presents the understatement
; as a measured figure, which is the defaulted zero wearing a different hat.
test an_unpriced_line_leaves_the_cart_without_a_total {
  assert UNPRICED_LINE_BLOCKS_THE_CART_TOTAL == true;
  assert cart_is_quotable(true) == true;
  assert cart_is_quotable(false) == false;
  assert UNPRICED_CART_CAN_BE_SUBMITTED == false;
  assert LINE_DROPPED_ON_AN_ABSENT_PRICE == false;
  assert price_absence_is_visible(true, false) == true;
}

test the_route_table_always_resolves {
  assert ROUTE_ARM_COUNT == 26;
  assert NAMED_ROUTE_COUNT == 25;
  assert CATCHALL_ROUTE_COUNT == 1;
  assert NAMED_ROUTE_COUNT + CATCHALL_ROUTE_COUNT == ROUTE_ARM_COUNT;
  assert route_resolves(true, true) == true;
  assert route_resolves(false, true) == true;
  assert route_resolves(false, false) == false;
  assert ROUTE_TABLE_CAN_FAIL_TO_RESOLVE == false;
}

; --- Invariants ---------------------------------------------------------------------------------

invariant no_claim_in_this_file_rests_on_a_compiled_test
  assert a_claim_here_rests_on_a_test(HOST_SUITE_COMPILES_THIS_HALF) == false and UNIT_TESTS_NEVER_COMPILED == 32

invariant a_rebuilt_payload_is_never_a_proof
  assert init_data_can_prove_identity(ORIGIN_REBUILT) == false and REBUILT_PAYLOAD_CAN_VERIFY == false

invariant an_absent_host_is_never_a_proof
  assert init_data_can_prove_identity(init_data_origin(false, true, true)) == false

invariant the_label_alone_cannot_separate_an_absence_from_a_proof
  assert reconstruction_label(ORIGIN_SIGNED) == reconstruction_label(ORIGIN_NONE) and LABEL_ALONE_SEPARATES_ABSENCE_FROM_PROOF == false

invariant an_unlabelled_rebuild_misinforms_the_cohort
  assert cohort_input_is_faithful(ORIGIN_REBUILT, false) == false and SITES_OMITTING_THE_LABEL == 2

invariant a_successful_response_is_never_retried
  assert attempt_is_retried(CLASS_SUCCESS) == false and attempts_used(CLASS_SUCCESS) == 1

invariant a_conflict_is_never_retried
  assert attempt_is_retried(CLASS_CONFLICT) == false

invariant the_attempt_ceiling_is_the_loop_and_the_comment_now_says_so
  assert attempts_used(CLASS_SERVER) == ATTEMPT_MAX and ATTEMPTS_CLAIMED_BY_THE_DOC_COMMENT == ATTEMPT_MAX and DOC_COMMENT_AGREES_WITH_THE_LOOP == true and ATTEMPTS_CLAIMED_BEFORE_2026_09_21 + 1 == ATTEMPT_MAX

invariant no_attempt_beyond_the_first_is_immediate
  assert backoff_before(0) == 0 and backoff_before(1) == 1000 and backoff_before(2) == 2000 and backoff_before(3) == 4000

invariant a_retry_with_a_stable_attached_key_cannot_write_twice
  assert retry_can_duplicate_a_write(KEY_IS_ATTACHED_ON_THE_RETRIED_CALL, true) == false

invariant a_missing_key_makes_every_retry_a_possible_duplicate
  assert retry_can_duplicate_a_write(false, true) == true

invariant the_conflict_arm_cannot_fire_because_it_is_not_there
  assert conflict_branch_can_fire(ORDER_CREATE_EVER_RETURNS_409, CONFLICT_ARM_IS_SHIPPED) == false and conflict_branch_can_fire(true, CONFLICT_ARM_IS_SHIPPED) == false

; An unreachable arm and an absent arm differ in what a later server edit can do to them. This is
; the one that survives someone adding a 409 to create.
invariant a_409_is_terminal_and_the_customer_is_told
  assert conflict_is_terminal_and_visible(CONFLICT_ARM_IS_SHIPPED) == true and A_409_NOW_REACHES_THE_CUSTOMER == true and attempt_is_retried(CLASS_CONFLICT) == false

invariant no_request_is_built_from_an_identity_nobody_supplied
  assert NO_REQUEST_IS_BUILT_FROM_A_FABRICATED_ID == true and REMOVED_ARM_USED_A_FABRICATED_ID_WHEN_IDENTITY_WAS_ABSENT == true

invariant a_recovered_order_that_does_not_match_the_key_is_not_provably_ours
  assert recovered_order_is_provably_ours(REMOVED_ARM_MATCHED_THE_KEY) == false

invariant no_deadline_is_invented_where_none_is_shipped
  assert REQUEST_DEADLINE_IS_SHIPPED == false and ABORT_OCCURRENCES_IN_UI == 0

; The refusal replaced a downgrade; it did not buy the client a larger allowance. Both halves are
; asserted, because "we now refuse" would be worth nothing beside a quietly raised cap.
invariant an_oversize_payload_is_refused_here_and_the_cap_is_not_raised
  assert oversize_is_refused(true, false, OVERSIZE_IS_REFUSED_LOUDLY_ON_THE_CLIENT) == true and oversize_becomes_anonymous(true, false, OVERSIZE_IS_REFUSED_LOUDLY_ON_THE_CLIENT) == false and CAP_WAS_RAISED_BY_THE_FIX == false and CAP_VALUE_IS_RESTATED_HERE == false

invariant a_defaulted_number_is_the_only_silent_drop
  assert dropped_field_renders_an_invented_value(true, true) == true and dropped_field_renders_an_invented_value(false, true) == false and dropped_field_breaks_the_client(false, false) == true and dropped_field_breaks_the_client(false, true) == false

; The loud count is what serde refuses, and the four groups close on the declared total. Until
; 2026-09-22 it was 172 - 44 = 128, which counted as loud two combined defaults, thirty Options
; serde fills with None and six fields that are never parsed. No field in those three groups is a
; defaulted number, so the fabricated-zero count was right throughout.
invariant the_loud_count_is_what_serde_refuses_and_the_groups_close
  assert DTO_FIELDS_WITH_A_DEFAULT + DEFAULTS_IN_A_COMBINED_ATTRIBUTE + OPTION_FIELDS_WITHOUT_A_DEFAULT + FIELDS_THAT_BREAK_LOUDLY == DTO_FIELDS_DESERIALIZED and DTO_FIELDS_DESERIALIZED + DTO_FIELDS_NEVER_DESERIALIZED == DTO_FIELD_COUNT and FIELDS_THAT_BREAK_LOUDLY_BEFORE_THE_ETA_FIX + DEFAULTS_IN_A_COMBINED_ATTRIBUTE + OPTION_FIELDS_WITHOUT_A_DEFAULT + DTO_FIELDS_NEVER_DESERIALIZED == FIELDS_THAT_BREAK_LOUDLY_AS_FIRST_STATED and FIELDS_THAT_BREAK_LOUDLY + ETA_FIELDS_MOVED_FROM_LOUD_TO_A_DEFAULTED_OPTION == FIELDS_THAT_BREAK_LOUDLY_BEFORE_THE_ETA_FIX and COMBINED_DEFAULTS_ON_A_NUMBER == 0

invariant the_default_partition_is_complete
  assert DEFAULTS_ON_AN_OPTION + DEFAULTS_ON_A_BARE_NUMBER + DEFAULTS_ON_A_BOOL_STRING_OR_VEC == DTO_FIELDS_WITH_A_DEFAULT and NUMERIC_DEFAULT_SITES.len == DEFAULTS_ON_A_BARE_NUMBER

; One field changed column; none was added or removed. A partition that moved without the total
; moving is the shape of a type change, and a total that also moved would mean the recount was
; wrong.
; Stated on the 2026-09-22 counts since 2026-09-24: the ETA fix moved two more fields, and it moved
; them from the loud column INTO the defaults, so there the total moved by exactly two on purpose.
invariant moving_one_field_between_columns_left_the_total_alone
  assert DEFAULTS_ON_A_BARE_NUMBER + 1 == DEFAULTS_ON_A_BARE_NUMBER_BEFORE_THE_FIX and DEFAULTS_ON_AN_OPTION_BEFORE_THE_ETA_FIX - 1 + DEFAULTS_ON_A_BARE_NUMBER_BEFORE_THE_FIX + DEFAULTS_ON_A_BOOL_STRING_OR_VEC == DTO_FIELDS_WITH_A_DEFAULT_BEFORE_THE_ETA_FIX

; The rule is unchanged and its input changed. A surviving line hides its absence exactly when the
; price field can fabricate a number, which an Option cannot.
invariant a_surviving_line_hides_its_absence_only_when_the_price_field_can_fabricate_one
  assert price_absence_is_visible(true, true) == false and price_absence_is_visible(true, false) == true and ABSENT_PRICE_SURVIVES_AS_A_FREE_LINE == false

invariant an_unpriced_line_is_never_totalled_and_never_submitted
  assert UNPRICED_LINE_BLOCKS_THE_CART_TOTAL == true and UNPRICED_CART_CAN_BE_SUBMITTED == false and cart_is_quotable(false) == false

invariant a_dropped_line_is_a_visible_absence
  assert price_absence_is_visible(false, true) == true

invariant the_catchall_is_what_makes_the_route_table_total
  assert route_resolves(false, true) == true and route_resolves(false, false) == false

invariant every_edge_names_an_owner_that_is_not_this_file
  assert REUSES_REQUEST_IDENTITY_ID != ID and REUSES_CATALOG_API_ID != ID and REUSES_COMMERCE_ID != ID and REUSES_CLIENT_ERRORS_ID != ID and REUSES_DEEPLINK_ID != ID

; An edge names an OWNER and a DECLARATION, and never a line in the owner's file. The count of
; pinned names has to keep its measured length for the same reason the partition above does: an
; emptied list would make every sentence about the edges vacuously true.
invariant every_edge_is_named_by_a_declaration_and_none_of_them_is_missing
  assert EDGE_DECLARATIONS_MISSING_FROM_THEIR_OWNERS == 0 and REQUEST_IDENTITY_DECLARATIONS.len + CATALOG_API_DECLARATIONS.len + COMMERCE_DECLARATIONS.len + CLIENT_ERRORS_DECLARATIONS.len + DEEPLINK_DECLARATIONS.len + LOYALTY_LEDGER_DECLARATIONS.len == EDGE_DECLARATIONS_PINNED and EDGE_DECLARATIONS_PINNED == 11

; The names are pinned; the values are still the owners'. If a later edit copies the cap, the header
; literal or the alias list into this file, this is what fails.
invariant pinning_a_name_never_becomes_copying_a_value
  assert CAP_VALUE_IS_RESTATED_HERE == false and HEADER_LITERAL_IS_RESTATED_HERE == false and ROUTE_ALIASES_ARE_RESTATED_HERE == false and IDEMPOTENCY_ARMS_ARE_RESTATED_HERE == false
