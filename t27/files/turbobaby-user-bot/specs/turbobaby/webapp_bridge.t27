test the_cart_drops_two_unreadable_things_and_keeps_the_third {
  assert cart_line_survives(true, true) == true;
  assert cart_line_survives(false, true) == false;
  assert cart_line_survives(true, false) == false;
  assert LINE_DROPPED_ON_UNKNOWN_KIND == true;
