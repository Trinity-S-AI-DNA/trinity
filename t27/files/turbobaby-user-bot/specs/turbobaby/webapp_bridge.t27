}

test the_mirror_counts_add_up {
  assert DTO_FIELD_COUNT == 172;
  assert DTO_FIELDS_WITH_A_DEFAULT == 46;
  assert DEFAULTS_ON_AN_OPTION == 30;
  assert DTO_FIELDS_WITH_A_DEFAULT == DTO_FIELDS_WITH_A_DEFAULT_BEFORE_THE_ETA_FIX + ETA_FIELDS_MOVED_FROM_LOUD_TO_A_DEFAULTED_OPTION;
  assert DEFAULTS_ON_AN_OPTION == DEFAULTS_ON_AN_OPTION_BEFORE_THE_ETA_FIX + ETA_FIELDS_MOVED_FROM_LOUD_TO_A_DEFAULTED_OPTION;
  assert DEFAULTS_ON_A_BARE_NUMBER == 6;
  assert DEFAULTS_ON_A_BARE_NUMBER_BEFORE_THE_FIX == 7;
  assert DEFAULTS_ON_A_BARE_NUMBER + 1 == DEFAULTS_ON_A_BARE_NUMBER_BEFORE_THE_FIX;
  assert DEFAULTS_ON_A_BOOL_STRING_OR_VEC == 10;
  assert DEFAULTS_ON_AN_OPTION + DEFAULTS_ON_A_BARE_NUMBER + DEFAULTS_ON_A_BOOL_STRING_OR_VEC == DTO_FIELDS_WITH_A_DEFAULT;
  assert FIELDS_THAT_BREAK_LOUDLY == 87;
  assert FIELDS_THAT_BREAK_LOUDLY + ETA_FIELDS_MOVED_FROM_LOUD_TO_A_DEFAULTED_OPTION == FIELDS_THAT_BREAK_LOUDLY_BEFORE_THE_ETA_FIX;
  assert FIELDS_THAT_BREAK_LOUDLY_AS_FIRST_STATED == 128;
  assert DTO_FIELD_COUNT - DTO_FIELDS_WITH_A_DEFAULT_BEFORE_THE_ETA_FIX == FIELDS_THAT_BREAK_LOUDLY_AS_FIRST_STATED;
  assert DTO_STRUCTS_THAT_DERIVE_DESERIALIZE == 22;
  assert DTO_STRUCTS_THAT_ONLY_SERIALIZE == 2;
  assert DTO_STRUCTS_THAT_DERIVE_DESERIALIZE + DTO_STRUCTS_THAT_ONLY_SERIALIZE == DTO_STRUCT_COUNT;
  assert DTO_FIELDS_DESERIALIZED == 166;
  assert DTO_FIELDS_NEVER_DESERIALIZED == 6;
  assert DTO_FIELDS_DESERIALIZED + DTO_FIELDS_NEVER_DESERIALIZED == DTO_FIELD_COUNT;
  assert DEFAULTS_IN_A_COMBINED_ATTRIBUTE == 2;
  assert COMBINED_DEFAULT_SITES.len == DEFAULTS_IN_A_COMBINED_ATTRIBUTE;
  assert COMBINED_DEFAULT_SITES[0] == "src/ui/api/types.rs:122";
  assert COMBINED_DEFAULT_SITES[1] == "src/ui/api/types.rs:131";
  assert COMBINED_DEFAULTS_ON_A_NUMBER == 0;
  assert OPTION_FIELDS_WITHOUT_A_DEFAULT == 31;
  assert A_MISSING_OPTION_WITHOUT_A_DEFAULT_IS_NONE == true;
  assert DTO_FIELDS_WITH_A_DEFAULT + DEFAULTS_IN_A_COMBINED_ATTRIBUTE + OPTION_FIELDS_WITHOUT_A_DEFAULT + FIELDS_THAT_BREAK_LOUDLY == DTO_FIELDS_DESERIALIZED;
  assert FIELDS_THAT_BREAK_LOUDLY_BEFORE_THE_ETA_FIX + DEFAULTS_IN_A_COMBINED_ATTRIBUTE + OPTION_FIELDS_WITHOUT_A_DEFAULT + DTO_FIELDS_NEVER_DESERIALIZED == FIELDS_THAT_BREAK_LOUDLY_AS_FIRST_STATED;
  assert DTO_FIELDS_WITH_A_DEFAULT_BEFORE_THE_ETA_FIX + DEFAULTS_IN_A_COMBINED_ATTRIBUTE + OPTION_FIELDS_WITHOUT_A_DEFAULT + FIELDS_THAT_BREAK_LOUDLY_BEFORE_THE_ETA_FIX == DTO_FIELDS_DESERIALIZED;
  assert DTO_STRUCT_COUNT == 24;
  assert DTO_ENUM_COUNT == 3;
}

test a_dropped_field_is_loud_only_when_it_has_no_default {
