  assert price_absence_is_visible(false, true) == true;
  assert price_absence_is_visible(true, false) == true;
  ; The line this file recorded until 2026-09-21: a surviving line whose price field defaults to a
  ; NUMBER hides the absence. Kept reachable so the fix is checkable and not merely asserted.
  assert price_absence_is_visible(true, true) == false;
  assert ABSENT_PRICE_SURVIVED_AS_A_FREE_LINE_BEFORE_THE_FIX == true;
  assert ABSENT_PRICE_SURVIVES_AS_A_FREE_LINE == false;
  assert NON_FINITE_PRICE_SURVIVES_AS_A_FREE_LINE == false;
