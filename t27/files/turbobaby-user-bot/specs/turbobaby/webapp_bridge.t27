; The old behaviour, kept reachable so the fix is checkable and not merely asserted: the SAME
; capped site with the refusal switched off is exactly the downgrade this file recorded until
; 2026-09-21.
test the_downgrade_this_replaced_is_still_reachable_in_the_model {
  assert OVERSIZE_WAS_REFUSED_LOUDLY_BEFORE_2026_09_21 == false;
  assert oversize_becomes_anonymous(true, false, OVERSIZE_WAS_REFUSED_LOUDLY_BEFORE_2026_09_21) == true;
  assert oversize_is_refused(true, false, OVERSIZE_WAS_REFUSED_LOUDLY_BEFORE_2026_09_21) == false;
  assert OVERSIZE_IS_REFUSED_LOUDLY_ON_THE_CLIENT != OVERSIZE_WAS_REFUSED_LOUDLY_BEFORE_2026_09_21;
}

; The cap is request-identity's number, and this file still does not copy it: what it records is
; that a MIRROR exists for the runtime that cannot link the server, and that something compares
; the two. Naming the mirror's file is not naming the value.
test the_client_mirror_of_the_cap_is_compared_and_not_invented {
  assert CAP_MIRROR_SITE == "src/trios/validation.rs";
