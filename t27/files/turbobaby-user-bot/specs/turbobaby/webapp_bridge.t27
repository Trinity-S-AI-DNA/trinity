pub const TYPED_CLIENT_SOURCE_LINES : u16 = 342;
pub const SHIM_SOURCE_LINES : u16 = 223;
pub const ROUTE_SOURCE_LINES : u16 = 369;

; --- The instrument, declared before anything it measures ------------------------------------
; A contract whose subject no test compiles has to say so first, or every number below reads as
; if a suite stood behind it. None does.
pub const WASM_GATE_SITE : str = "src/lib.rs:17";
pub const SURVEY_CITED_THE_GATE_AT : str = "src/lib.rs:16";
pub const HOST_SUITE_COMPILES_THIS_HALF : bool = false;
pub const CFG_TEST_MODULES_IN_UI : u8 = 5;
pub const UNIT_TESTS_NEVER_COMPILED : u8 = 32;
pub const SHIPPED_INSTRUMENT_IS_A_TEXT_SCAN : bool = true;
pub const SCAN_NEEDLE_COUNT : u8 = 4;
pub const SCAN_SEES_A_DEFAULTED_ZERO : bool = false;
pub const SCAN_GAP_NOTE : str = "tests/money_is_never_invented.rs:116-119 requires one of four literal spellings of unwrap_or on the line. The mirror's own fabricated zero had none: src/ui/api/types.rs:423 carried a serde attribute and no expression at all, and src/ui/state.rs:50 wrote a bare 0.0 on its own line inside an else arm, with no money word beside it. Both sites were inside the scanned corpus and invisible to the scan. CLOSED 2026-09-21, and not by widening the scan: the field is an Option now, so there is no zero to see, and a second instrument reads the DECLARATION rather than hunting expressions.";
; The second instrument, added 2026-09-21 with the fix. It is still a text scan -- nothing
; compiles src/ui -- but it reads the TYPE of a declared field and the SHAPE of a function body
; instead of hunting four spellings of unwrap_or, which is what the note above said closing the
; gap would take. It also re-takes the measurement the 409 removal rests on, so a server that
; starts answering 409 on create fails a test instead of stranding a customer.
pub const TYPE_AWARE_INSTRUMENT : str = "tests/wire_absence_wiring.rs";
pub const TYPE_AWARE_INSTRUMENT_EXISTS : bool = true;
pub const TYPE_AWARE_INSTRUMENT_IS_COMPILED_BY_THE_HOST : bool = true;
; It reads src/ui as text, so it still proves nothing about whether src/ui COMPILES.
pub const TYPE_AWARE_INSTRUMENT_COMPILES_THE_CLIENT : bool = false;

pub fn a_claim_here_rests_on_a_test(host_suite_compiles: bool) bool {
  return host_suite_compiles;
}

; --- Ownership edges --------------------------------------------------------------------------
; The pinned compiler lowers a brace import to an empty UseDecl and the gate rejects it, so a
; cross-contract edge is a string naming the owner's ID plus a test asserting the literal. Each
; edge below is named by the OWNER'S DECLARATION NAME and never by a line in the owner's file.
; request-identity owns who a request is. It holds init_data_size_admits and INIT_DATA_MAX_BYTES,
;   which this file mirrors by naming the owner and not the value; it holds lenient_cohort, whose
;   only input is the label this file decides whether to send; and it holds identity_of_request,
;   which this file consumes as a boolean and never recomputes.
; catalog-api owns the read API's wire shape and its numerals. It holds catalog_api_dto_valid,
;   the server's judgement on a response body. This file declares the CLIENT's reaction to a body
;   that has already left the server, which is a different question and the only half it can see.
; commerce owns the idempotency verdict. It holds commerce_idempotency_decision and the five
;   outcomes that decision names, among them the replay and the conflict. This file restates no
;   arm of it: it declares only whether the client attaches a key and whether that key is stable,
;   and takes the verdict as an abstract boolean.
; client-errors owns what the customer is told. It holds render_kind and checkout_message_source.
;   This file counts response classes for the retry rule and maps none of them to a sentence.
; deeplink owns the link grammar and the entry points. It holds LEGACY_ROUTE_ALIASES and
;   deeplink_landing. This file counts the route table's arms and names none of the aliases.
pub const REUSES_REQUEST_IDENTITY_ID : str = "turbobaby/request-identity";
pub const REUSES_CATALOG_API_ID : str = "turbobaby/catalog-api";
pub const REUSES_COMMERCE_ID : str = "turbobaby/commerce";
pub const REUSES_CLIENT_ERRORS_ID : str = "turbobaby/client-errors";
pub const REUSES_DEEPLINK_ID : str = "turbobaby/deeplink";
pub const REUSE_EDGE_COUNT : u8 = 5;
pub const IDENTITY_VERDICT_INPUT : str = "identity_of_request, supplied by the request-identity contract";
pub const COHORT_INPUT_NAME : str = "lenient_cohort, whose reconstructed_header_set is set by this file";
pub const IDEMPOTENCY_VERDICT_INPUT : str = "commerce_idempotency_decision, supplied by the commerce contract";
pub const SIZE_CAP_IS_OWNED_BY : str = "turbobaby/request-identity";
pub const HEADER_NAME_IS_ALREADY_DECLARED_AT : str = "turbobaby/loyalty-ledger";
; The five counted edges are the owners this file DEFERS A QUESTION to -- a question its own
; subject touches and it refuses to answer. That is the criterion, and it is not "supplies a
; parameter": only request-identity and commerce hand this file an abstract input, while
; catalog-api, client-errors and deeplink are deferred a question and hand back nothing. The two
; declarations above are neither: no question passes to loyalty-ledger, only a literal this file
; declines to copy, and request-identity is counted for its deferred questions and not for the
; cap. So neither line below is a sixth edge, and both are recorded so a later reader does not
; add the copy.
pub const CAP_VALUE_IS_RESTATED_HERE : bool = false;
pub const HEADER_LITERAL_IS_RESTATED_HERE : bool = false;
pub const IDEMPOTENCY_ARMS_ARE_RESTATED_HERE : bool = false;
pub const ROUTE_ALIASES_ARE_RESTATED_HERE : bool = false;

; --- The declaration names the edges rest on, read in the owners' files ---------------------------
; Three of the five edges above named their owner's declarations in PROSE ONLY -- catalog-api's
; catalog_api_dto_valid, client-errors' render_kind and checkout_message_source, deeplink's
; LEGACY_ROUTE_ALIASES and deeplink_landing. A prose name is better than a line number, because it
; survives the owner being edited, but nothing checks it: the owner could rename or delete the
; declaration and every sentence here would read exactly as it does now. The eleven names are
; pinned below so that a rename upstream is a thing this file can be measured against rather than
; a thing a reader has to go and look for.
; WHAT A PIN HERE DOES AND DOES NOT DO. It records that the name was READ in the owner's file on a
; named day and found to mean what the sentence beside it claims. It cannot notice a later rename
; by itself -- no import form resolves, so there is nothing to break -- and it is deliberately a
; NAME and not a value: the cap, the header literal and the alias list stay uncopied, which is what
; the four booleans above say and what the test below re-asserts.
pub const EDGE_DECLARATIONS_VERIFIED_AT : str = "2026-09-21";
pub const EDGE_DECLARATIONS_PINNED : u8 = 11;
pub const EDGE_DECLARATIONS_MISSING_FROM_THEIR_OWNERS : u8 = 0;
pub const REQUEST_IDENTITY_DECLARATIONS : [4]str = [
  "identity_of_request",
  "lenient_cohort",
  "INIT_DATA_MAX_BYTES",
  "init_data_size_admits"
];
pub const CATALOG_API_DECLARATIONS : [1]str = ["catalog_api_dto_valid"];
pub const COMMERCE_DECLARATIONS : [1]str = ["commerce_idempotency_decision"];
pub const CLIENT_ERRORS_DECLARATIONS : [2]str = ["render_kind", "checkout_message_source"];
pub const DEEPLINK_DECLARATIONS : [2]str = ["LEGACY_ROUTE_ALIASES", "deeplink_landing"];
pub const LOYALTY_LEDGER_DECLARATIONS : [1]str = ["IDEMPOTENCY_HEADER"];

; An edge is checkable only while the owner still declares the name it rests on. Written as a
; function so a worker who finds a rename writes the boolean and watches the assert fail, rather
; than silently repairing the sentence.
pub fn edge_rests_on_a_live_declaration(owner_still_declares_it: bool) bool {
  return owner_still_declares_it;
}

; --- Where initData comes from -----------------------------------------------------------------
; get_init_data (src/ui/telegram.rs:573-620) is a single js_sys::eval with three exits, and they
; are not three degrees of the same thing. :578 returns the signed string Telegram supplied.
; :595-611 rebuilds a payload out of initDataUnsafe when the signed string is missing, sorting
; the keys itself and dropping receiver and chat (:598-601); the comment at :582-588 states, in
; the code's own words, that this "can NEVER pass signature validation" and that JSON.stringify
; "cannot reproduce the exact bytes Telegram signed". :614 returns the empty string, and that is
; the exit taken by a browser tab with no Telegram host, because the whole body sits inside the
; `window.Telegram && window.Telegram.WebApp` test at :575.
pub const ORIGIN_NONE : u8 = 0;
pub const ORIGIN_SIGNED : u8 = 1;
pub const ORIGIN_REBUILT : u8 = 2;
pub const ORIGIN_COUNT : u8 = 3;
pub const REBUILT_PAYLOAD_IS_SENT_ANYWAY : bool = true;
pub const REBUILT_PAYLOAD_CAN_VERIFY : bool = false;
pub const KEYS_DROPPED_FROM_THE_REBUILD : u8 = 2;
pub const ABSENT_HOST_YIELDS_AN_EMPTY_STRING : bool = true;
pub const ABSENT_HOST_YIELDS_AN_ERROR : bool = false;

pub fn init_data_origin(host_present: bool, signed_string_present: bool, unsafe_hash_present: bool) u8 {
  if (!host_present) {
    return ORIGIN_NONE;
  }
  if (signed_string_present) {
    return ORIGIN_SIGNED;
  }
  if (unsafe_hash_present) {
    return ORIGIN_REBUILT;
  }
  return ORIGIN_NONE;
}

pub fn origin_is_known(origin: u8) bool {
  return origin == ORIGIN_NONE or origin == ORIGIN_SIGNED or origin == ORIGIN_REBUILT;
}

pub fn init_data_payload_is_empty(origin: u8) bool {
  return origin == ORIGIN_NONE;
}

; A rebuilt payload is a compatibility artefact, not a proof. Whether a proof that reaches the
; server is ACCEPTED is request-identity's question; this is only what the client is holding.
pub fn init_data_can_prove_identity(origin: u8) bool {
  return origin == ORIGIN_SIGNED;
}

; --- What the client does when the bridge is absent ----------------------------------------------
; Nothing stops the call. The empty string flows to every authed helper, and only two sites in
; the whole client half test it: src/ui/api/client.rs:97 (:60 before 2026-09-21) omits the header when it is empty, and
; src/ui/api/http.rs:367 does the same inside AdminAuth. Every one of the seven free functions in
; src/ui/api/http.rs sends the header with an empty value instead. The request is made either
; way and the refusal arrives from the server.
pub const EMPTINESS_TEST_SITES : u8 = 2;
pub const HELPERS_THAT_SEND_AN_EMPTY_HEADER : u8 = 7;
pub const ABSENT_BRIDGE_BLOCKS_THE_CALL : bool = false;
pub const ABSENT_BRIDGE_IS_REPORTED_TO_THE_CUSTOMER_HERE : bool = false;

pub fn call_is_attempted(origin: u8) bool {
  return origin == ORIGIN_NONE or origin == ORIGIN_SIGNED or origin == ORIGIN_REBUILT;
}

pub fn refusal_comes_from_the_server(origin: u8, call_attempted: bool) bool {
  return call_attempted and !init_data_can_prove_identity(origin);
}

; --- The label, and why the flag alone cannot be read --------------------------------------------
; is_reconstructed_init_data (src/ui/telegram.rs:557-571) is a SECOND eval, run separately from
; the one that produced the payload. It returns false at :562 when a signed string exists and
; false at :565 when there is no host at all, so the flag says "not rebuilt" for both a genuine
; proof and a browser tab with nothing in it. The server reads the header at src/api/auth.rs:577
; and defaults a missing one to false (:581), which it then logs as "signed-but-invalid" (:588)
; -- the cohort it means to eventually refuse -- rather than "reconstructed-initdata" (:586), the
; cohort it means to keep working. Recovering the origin therefore needs BOTH the label and the
; emptiness of the payload; either alone is ambiguous.
pub const LABEL_ALONE_SEPARATES_ABSENCE_FROM_PROOF : bool = false;
pub const LABEL_IS_READ_BY_A_SECOND_EVAL : bool = true;
pub const AUTH_HEADER_SITES : u8 = 9;
pub const SITES_SENDING_THE_LABEL : u8 = 7;
pub const SITES_OMITTING_THE_LABEL : u8 = 2;
; client.rs:63 moved to :100 when the constructor grew a refusal; http.rs:368 did not move.
pub const UNLABELLED_SITES : [2]str = ["src/ui/api/http.rs:368", "src/ui/api/client.rs:100"];
; SCOPE, measured 2026-09-22. The nine are the two transport modules named above and nothing
; wider. src/ui holds 44 more `.header("X-Telegram-Init-Data", ...)` calls outside src/ui/api --
; src/ui/screens/admin_screen.rs 34, src/ui/screens/profile_screen.rs 4,
; src/ui/screens/order_detail_screen.rs 3, src/ui/screens/orders_screen.rs 1,
; src/ui/pages/referrals.rs 1 and src/ui/game/shop_game.rs 1 -- plus two spellings that are not a
; .header( call, a JS fetch headers object at admin_screen.rs:638 and a header tuple at :4623. None
; of them sends the label: in src/ui the label literal occurs only in src/ui/api/http.rs, seven
; times. The three counts above are true of their stated scope; read as a census of the whole
; client they would understate how many call sites send the proof without the label.
; RE-PINNED 2026-09-26: the header tuple :4615 -> :4623, when the Loyalty tab grew its referral
; sub-tab (R3) eight lines above it. Re-counted the same day: admin_screen.rs still makes 34
; calls, and the referral credit's panel and page reach the server through src/ui/api/http.rs
; (AdminAuth, fetch_text_authed_full, post_json_authed), so no count above moved.
pub const IDENTITY_HEADER_CALLS_OUTSIDE_THE_TRANSPORT : u8 = 44;
pub const OTHER_IDENTITY_HEADER_SPELLINGS_OUTSIDE_THE_TRANSPORT : u8 = 2;
pub const LABEL_SITES_OUTSIDE_THE_TRANSPORT : u8 = 0;
pub const MISSING_LABEL_DEFAULTS_TO_TAMPERING : bool = true;

pub fn reconstruction_label(origin: u8) bool {
  return origin == ORIGIN_REBUILT;
}

pub fn origin_recovered_by_receiver(label_set: bool, payload_empty: bool) u8 {
  if (payload_empty) {
    return ORIGIN_NONE;
  }
  if (label_set) {
    return ORIGIN_REBUILT;
  }
  return ORIGIN_SIGNED;
}

; True when the boolean this file hands to the owner's lenient_cohort describes the client that
; actually sent the request. A rebuilt payload with no label is the one false case.
pub fn cohort_input_is_faithful(origin: u8, label_sent: bool) bool {
  if (origin == ORIGIN_REBUILT) {
    return label_sent;
  }
  return true;
}

; --- The size cap, mirrored once and not everywhere ----------------------------------------------
; FIXED 2026-09-21, and the old behaviour is recorded rather than overwritten. Until that day
; src/ui/api/client.rs:36-40 replaced an oversize payload with the empty string, which with_auth
; then declined to send, so the request left as an ANONYMOUS one: a payload the server would have
; refused instead became a request claiming to be nobody, and the customer saw whatever an
; unauthenticated call produces with no hint that a 4 KB proof had been discarded on this side of
; the wire. src/ui/api/client.rs:58-70 now returns an error carrying the measured length and the
; cap, and src/ui/api/client.rs:77-82 is a separate, named constructor for the client that carries
; no proof ON PURPOSE -- so "this call is anonymous" is a decision written at the call site
; instead of one a constructor arrives at after discarding something.
; It is still the only cap on the client: the free functions in src/ui/api/http.rs apply none and
; send the oversize string, which the server refuses at src/api/auth.rs:70. Both the byte value
; and the admission rule are request-identity's; neither is copied here. What the client compiles
; against is a MIRROR of the server literal in src/trios/validation.rs -- src/api/auth.rs is
; behind the `backend` feature and a browser cannot link it -- and the mirror is compared with the
; server's own number by tests/wire_absence_wiring.rs, so it is a checked mirror and not a second
; opinion. The cap is NOT raised: the admission rule stays inclusive at the same byte value.
pub const CLIENT_CAP_SITES : u8 = 1;
pub const CAP_APPLIES_TO_THE_FREE_HELPERS : bool = false;
pub const OVERSIZE_IS_REFUSED_LOUDLY_ON_THE_CLIENT : bool = true;
pub const OVERSIZE_WAS_REFUSED_LOUDLY_BEFORE_2026_09_21 : bool = false;
pub const CAP_MIRROR_SITE : str = "src/trios/validation.rs";
pub const CAP_MIRROR_IS_COMPARED_WITH_THE_SERVER : bool = true;
pub const REFUSAL_NAMES_THE_MEASURED_LENGTH : bool = true;
pub const CAP_WAS_RAISED_BY_THE_FIX : bool = false;

; Three inputs, because the third is the one that changed. A capped site that refuses out loud
; hands the caller an error; the same site without the refusal silently downgraded the request.
; Keeping the old arm reachable is what makes the fix checkable rather than merely asserted.
pub fn oversize_becomes_anonymous(capped_site: bool, size_admits: bool, refused_loudly: bool) bool {
  return capped_site and !size_admits and !refused_loudly;
}

pub fn oversize_is_refused(capped_site: bool, size_admits: bool, refused_loudly: bool) bool {
  return capped_site and !size_admits and refused_loudly;
}

; --- Retry ----------------------------------------------------------------------------------------
; submit_order_with_retry (src/ui/screens/checkout_screen.rs:148-191, re-measured 2026-09-21 after
; the 409 arm was removed; it stood at :128-199). The loop at :158-159 is one immediate attempt
; chained to the three backoff delays at :154, so four attempts is the ceiling and the delay at
; :163 is skipped on the first. Which classes continue is written into the arms: the 2xx arm opens
; at :171 and returns at :174 or :177, the 5xx arm opens at :180 and continues at :181, any other
; status -- 409 among them now -- returns at :184, and a transport error continues at :187. The
; class is modelled as constant across attempts, which is what the loop assumes when it exhausts
; the delays.
pub const RETRIED_CALL_COUNT : u8 = 1;
pub const RETRY_SITE : str = "src/ui/screens/checkout_screen.rs:148 submit_order_with_retry";
pub const ATTEMPT_MAX : u8 = 4;
pub const BACKOFF_STEP_COUNT : u8 = 3;
pub const BACKOFF_MS : [3]u16 = [1000, 2000, 4000];
pub const FIRST_ATTEMPT_WAITS : bool = false;
pub const RETRY_LIVES_IN_THE_TRANSPORT : bool = false;
; The doc comment said three until 2026-09-21; the loop always made four. The comment was
; corrected with the 409 removal and now says four (src/ui/screens/checkout_screen.rs:127), so a
; reader sizing the worst case from it no longer misses one request in every four a single tap can
; put on POST /api/orders. The old figure is kept because the correction has to be checkable, not
; merely asserted.
pub const ATTEMPTS_CLAIMED_BY_THE_DOC_COMMENT : u8 = 4;
pub const ATTEMPTS_CLAIMED_BEFORE_2026_09_21 : u8 = 3;
pub const DOC_COMMENT_AGREES_WITH_THE_LOOP : bool = true;
; A retry BUTTON is not a retry. Three screens re-arm a failed resource on a customer tap --
; src/ui/screens/events_screen.rs:924, src/ui/screens/profile_screen.rs:663 and
; src/ui/screens/success_screen.rs:479 (:920, :659 and :476 before the 2026-09-21 edits) --
; and none of the three re-sends anything by itself.
; They are counted here so "one call retries" is read as one AUTOMATIC re-send and not as the
; claim that the customer has no way to ask again.
pub const MANUAL_RETRY_BUTTON_SCREENS : u8 = 3;
pub const MANUAL_RETRY_IS_AN_AUTOMATIC_RESEND : bool = false;

pub const CLASS_NETWORK : u8 = 0;
pub const CLASS_SUCCESS : u8 = 1;
pub const CLASS_CONFLICT : u8 = 2;
pub const CLASS_OTHER_STATUS : u8 = 3;
pub const CLASS_SERVER : u8 = 4;
pub const RESPONSE_CLASS_COUNT : u8 = 5;

pub fn response_class_is_known(response_class: u8) bool {
  return response_class <= CLASS_SERVER;
}

pub fn attempt_is_retried(response_class: u8) bool {
  return response_class == CLASS_NETWORK or response_class == CLASS_SERVER;
}

pub fn attempts_used(response_class: u8) u8 {
  if (attempt_is_retried(response_class)) {
    return ATTEMPT_MAX;
  }
  return 1;
}

pub fn backoff_before(attempt_index: u8) u16 {
  if (attempt_index == 0) {
    return 0;
  }
  return BACKOFF_MS[attempt_index - 1];
}

; --- Whether a retry can become a second order ------------------------------------------------
; It cannot, and the reason is not in the transport. The key is minted once per mounted screen at
; src/ui/screens/checkout_screen.rs:971 (:934 before the 2026-09-21 edits above) and that line is
; the file's only write to the signal, so every attempt inside the loop and every later tap carry
; the same key.
; post_json_authed_idempotent_full (declared at src/ui/api/http.rs:209, attaching the key it was
; handed at :226) mints nothing of its own. The
; same single write is why a customer who edits the cart after a failure and taps again sends the
; old key with a new body: that pairing is what commerce_idempotency_decision resolves, and this
; file names the input rather than the arm.
pub const KEY_IS_ATTACHED_ON_THE_RETRIED_CALL : bool = true;
pub const KEY_IS_MINTED_ONCE_PER_MOUNTED_SCREEN : bool = true;
pub const KEY_WRITE_SITES : u8 = 1;
pub const KEY_IS_REMINTED_AFTER_A_FAILURE : bool = false;
pub const KEY_ROTATES_WHEN_THE_PAYLOAD_CHANGES : bool = false;
pub const KEY_IS_MINTED_BY_THE_TRANSPORT : bool = false;

pub fn retry_can_duplicate_a_write(key_attached: bool, key_stable_across_attempts: bool) bool {
  return !(key_attached and key_stable_across_attempts);
}

pub fn resubmission_reuses_a_key_with_a_new_payload(key_stable: bool, payload_changed: bool, screen_still_mounted: bool) bool {
  return key_stable and payload_changed and screen_still_mounted;
}

; The client never learns which arm the server took. It reads order_id out of a 2xx body
; (src/ui/screens/checkout_screen.rs:173-174) and ignores the idempotent_replay flag the server
; sets beside it at src/api/orders.rs:1374, so a replayed order and a newly created one are
; indistinguishable on this side.
pub const SERVER_REPLAY_STATUS : u16 = 200;
pub const SERVER_REPLAY_FLAG_NAME : str = "idempotent_replay";
pub const CLIENT_READS_THE_REPLAY_FLAG : bool = false;

pub fn client_distinguishes_replay_from_create(reads_replay_flag: bool) bool {
  return reads_replay_flag;
}

; --- The conflict arm that could not fire, and is gone ---------------------------------------------
; REMOVED 2026-09-21. It stood at src/ui/screens/checkout_screen.rs:162-178, treated 409 as
; "already accepted", fetched /api/orders/user/{id} and returned the FIRST element of the array as
; the order the customer had just placed. The list is newest-first -- src/api/orders.rs:2501 orders
; by created_at descending -- so the pick was at least the newest order, but it was chosen by
; recency and not by the key that was sent, and nothing checked that it was the same order. The
; telegram id used to build the recovery URL was itself a fabricated zero when identity was absent
; (src/ui/screens/checkout_screen.rs:1000), so the one path the branch could have taken would have
; queried a user that does not exist.
; Removed rather than repaired, because the measurement says it cannot fire and a correct version
; would have had nothing to guard: POST /api/orders answers a replay with 200
; (src/api/orders.rs:1371-1376), refuses an unusable key with 400 (:876), and the only
; StatusCode::CONFLICT in that file is cancel_order at :2336. A 409 now falls to the terminal arm
; and reaches the customer, which is the honest outcome for a status nothing in the server is known
; to send. The measurement is not trusted to a comment: tests/wire_absence_wiring.rs re-takes it on
; every run and fails if a CONFLICT appears outside cancel_order, so a server that starts answering
; 409 on create costs a red test rather than a stranded customer.
pub const ORDER_CREATE_EVER_RETURNS_409 : bool = false;
pub const CONFLICT_ARM_IS_SHIPPED : bool = false;
pub const A_409_NOW_REACHES_THE_CUSTOMER : bool = true;
pub const REMOVED_ARM_RECOVERY_WAS_POSITIONAL : bool = true;
pub const REMOVED_ARM_MATCHED_THE_KEY : bool = false;
pub const REMOVED_ARM_USED_A_FABRICATED_ID_WHEN_IDENTITY_WAS_ABSENT : bool = true;
pub const NO_REQUEST_IS_BUILT_FROM_A_FABRICATED_ID : bool = true;
pub const CONFLICT_PREMISE_IS_RE_MEASURED_BY_A_TEST : bool = true;

pub fn conflict_branch_can_fire(server_emits_409_on_create: bool, arm_is_shipped: bool) bool {
  return server_emits_409_on_create and arm_is_shipped;
}

; An arm that cannot fire and an arm that is not there differ in exactly one way, and it is the
; one that mattered: the second cannot be repaired into a wrong answer by a later edit to the
; server. Written as a function so a worker who re-adds a 409 arm has to say so here.
pub fn conflict_is_terminal_and_visible(arm_is_shipped: bool) bool {
  return !arm_is_shipped;
}

pub fn recovered_order_is_provably_ours(matches_the_key: bool) bool {
  return matches_the_key;
}

; --- Timeout: an honest refusal ---------------------------------------------------------------
; There is no request deadline. AbortController, AbortSignal and .abort() return zero occurrences
; over src/ui, and gloo_net::http::Request is used without one in all 19 request-making functions
; of src/ui/api/http.rs. A hung socket is bounded by the browser and by nothing this repository
; wrote. No number is declared here because none is implemented.
pub const REQUEST_DEADLINE_IS_SHIPPED : bool = false;
pub const ABORT_OCCURRENCES_IN_UI : u8 = 0;
pub const DEADLINE_NOTE : str = "A deadline needs an AbortController per request, a decision about whether a timed-out write may be retried under the same key, and a customer-facing outcome that client-errors would have to map. None of the three exists, so the period stays unstated. The backoff delays inside the retry loop are not a deadline: they space attempts and bound no attempt.";

pub fn request_can_hang_until_the_browser_gives_up(deadline_shipped: bool) bool {
  return !deadline_shipped;
}

; --- The DTO mirror ------------------------------------------------------------------------------
; src/ui/api/types.rs declares 24 structs and 3 enums over 172 fields. A field the server stops
; sending breaks deserialization -- ApiClient::run turns that into ApiError::Parse -- UNLESS serde
; can fill it, and nothing anywhere notices when it does. It fills it two ways: a field with
; `default` in a serde attribute gets the type's Default, and a field of type Option<T> with no
; default gets None. 44 fields carry the bare `#[serde(default)]`. For the ones that default an
; Option the value is None, which is still an absence and still renderable as one. For the ones
; that default a bare number the value is a zero the server never sent.
; CORRECTED 2026-09-22. Until this date the second sentence ended "UNLESS the field carries
; `#[serde(default)]`, in which case serde writes the type's Default", which names one of the two
; ways and implies that an Option with no attribute breaks. It does not: serde_derive fills a
; missing field that has no default through serde's missing_field, which answers None for an
; Option<T> and an error for every other type (serde 1.0.228, the version Cargo.lock pins). The
; loud count below carried the same assumption and is corrected with it.
; MOVED 2026-09-21: ServerCartItem.unit_price left the bare-number column for the Option column,
; so the split went 27/7 -> 28/6 while the total stayed 44 and the field count stayed 172. One
; field changed type; none was added or removed. The partition is re-counted here rather than
; adjusted by hand -- the six remaining numeric sites are listed below and each was re-read.
; CORRECTED 2026-09-24, with the owner's no-ETA decision (turbobaby/delivery-terms): the two ETA
; fields of DeliveryZone, min_eta_minutes and max_eta_minutes, were bare u32 with no default --
; LOUD, so a zone list without them lost the whole checkout picker. They are Option<u32> carrying
; #[serde(default)] now, because the server sends null for an ETA nobody published. Two fields
; moved from the loud column to the defaulted-Option column; none was added or removed, so the
; field count stays 172, the bare-number column stays 6, and: 46 bare defaults (30 on an Option,
; 6 on a number, 10 on a bool, string or vec), 87 loud, and 166 = 46 + 2 combined + 31 Options +
; 87 loud. The two new attribute lines sit above every site this file cites past types.rs:402, so
; each of those moved two lines down and is re-pointed. The 2026-09-22 figures are kept under
; _BEFORE_THE_ETA_FIX names.
pub const DTO_STRUCT_COUNT : u8 = 24;
pub const DTO_ENUM_COUNT : u8 = 3;
pub const DTO_FIELD_COUNT : u16 = 172;
pub const DTO_FIELDS_WITH_A_DEFAULT : u8 = 46;
pub const DEFAULTS_ON_AN_OPTION : u8 = 30;
pub const DTO_FIELDS_WITH_A_DEFAULT_BEFORE_THE_ETA_FIX : u8 = 44;
pub const DEFAULTS_ON_AN_OPTION_BEFORE_THE_ETA_FIX : u8 = 28;
pub const ETA_FIELDS_MOVED_FROM_LOUD_TO_A_DEFAULTED_OPTION : u8 = 2;
pub const DEFAULTS_ON_A_BARE_NUMBER : u8 = 6;
pub const DEFAULTS_ON_A_BARE_NUMBER_BEFORE_THE_FIX : u8 = 7;
pub const DEFAULTS_ON_A_BOOL_STRING_OR_VEC : u8 = 10;
; CORRECTED 2026-09-22, re-measured at a33e500 by what serde does rather than by which attribute is
; written. FIELDS_THAT_BREAK_LOUDLY read 128 until this date: 172 - 44, which counted as loud every
; field without the bare attribute. Three groups inside that 128 do not break when absent.
;   SIX are never deserialized: BookEventRequest (2 fields, :366) and BroadcastRequest (4, :381)
;   derive Serialize and not Deserialize, so no parse of them exists to fail. The other 22 structs
;   derive both and hold 166 fields.
;   TWO carry `default` inside a combined attribute: :121 `#[serde(rename = "type", default)]`
;   over set_type, a String (:122), and :130 over is_deal_of_day, a bool (:131).
;   THIRTY are Option<T> with no default in any spelling -- among them Strain.thc (:12),
;   Order.updated_at (:166) and BroadcastProduct.image_url (:393) -- and a missing one arrives as
;   None, as the correction above the counts says.
; What remains is the definition from this date: FIELDS_THAT_BREAK_LOUDLY counts the fields of the
; 22 structs that derive Deserialize whose absence makes that derived Deserialize return an error,
; which is exactly a field with no serde default in any spelling and a type other than Option<T>.
; types.rs writes no deserialize_with, flatten, untagged, skip_deserializing or struct-level
; default -- its one skip_serializing_if (:368) sits in a Serialize-only struct -- so nothing else
; changes the answer. 166 = 46 defaulted + 30 Options + 90 loud, and 172 = 166 + 6. It is a
; property of the types: which of the 22 the client actually reads off the wire is not counted.
; The 44 and its 28/6/10 split above are unchanged and still count the bare attribute; counted by
; what serde does, the bool/string/vec column is 12, and the numeric column -- the one that
; fabricates a zero -- is still 6. A missing Option fabricates nothing. A second reading moved with
; the unit_price fix: a plain `grep -c` for the attribute now answers 46 and not the 45 quoted in
; item 2 of the header, because the doc line that fix added at :424 (:426 since 2026-09-24) names
; the attribute too; with the two ETA attributes of 2026-09-24 that grep answers 48.
; CORRECTED 2026-09-23, T27 defect 2: the order endpoints now send null for a money figure the
; server withholds (src/db/orders.rs, money_withheld), so types::Order.total (src/ui/api/types.rs:163)
; is Option<f64> without a default. One field moves from loud to Option: 166 = 46 defaulted +
; 31 Options + 89 loud, and 128 = 89 + 2 + 31 + 6 still holds.
pub const FIELDS_THAT_BREAK_LOUDLY : u16 = 87;
pub const FIELDS_THAT_BREAK_LOUDLY_BEFORE_THE_ETA_FIX : u16 = 89;
pub const FIELDS_THAT_BREAK_LOUDLY_AS_FIRST_STATED : u16 = 128;
pub const DTO_STRUCTS_THAT_DERIVE_DESERIALIZE : u8 = 22;
pub const DTO_STRUCTS_THAT_ONLY_SERIALIZE : u8 = 2;
pub const DTO_FIELDS_DESERIALIZED : u16 = 166;
pub const DTO_FIELDS_NEVER_DESERIALIZED : u8 = 6;
pub const DEFAULTS_IN_A_COMBINED_ATTRIBUTE : u8 = 2;
pub const COMBINED_DEFAULT_SITES : [2]str = ["src/ui/api/types.rs:122", "src/ui/api/types.rs:131"];
pub const COMBINED_DEFAULTS_ON_A_NUMBER : u8 = 0;
pub const OPTION_FIELDS_WITHOUT_A_DEFAULT : u8 = 31;
pub const A_MISSING_OPTION_WITHOUT_A_DEFAULT_IS_NONE : bool = true;
; Still false, and by six fields rather than seven. A count that fell by one is not a rule that
; now holds, and saying so is the difference between a fix and a claim of one.
pub const MIRROR_RULE_HOLDS_ON_EVERY_FIELD : bool = false;
pub const UNKNOWN_EXTRA_FIELDS_ARE_IGNORED : bool = true;
pub const NUMERIC_DEFAULT_SITES : [6]str = [
  "src/ui/api/types.rs:28",
  "src/ui/api/types.rs:40",
  "src/ui/api/types.rs:311",
  "src/ui/api/types.rs:423",
  "src/ui/api/types.rs:450",
  "src/ui/api/types.rs:461"
];
; The site that left the list, and where it went. :423 was ServerCartItem.unit_price; the field is
; now an Option at :436 and the two lines below it that used to be :435 and :446 are :448 and :459.
; RE-POINTED 2026-09-24: two lines further down again, :438, :450 and :461, and the last three list
; entries read :421, :448 and :459 until then. NUMERIC_DEFAULT_SITE_THAT_WAS_FIXED is a line of
; the file as it stood before 2026-09-21 and does not move; that today's quantity site also reads
; :423 is a coincidence of two shifts, not the same line.
pub const NUMERIC_DEFAULT_SITE_THAT_WAS_FIXED : str = "src/ui/api/types.rs:423";
pub const FIXED_SITE_IS_NOW_AN_OPTION_AT : str = "src/ui/api/types.rs:438";

; CORRECTED 2026-09-22: this took one input and answered !field_has_serde_default, the assumption
; the 128 carried. A missing Option<T> with no default arrives as None, so the type is the second
; input. It answers for a field of a struct that derives Deserialize; the six fields of the two
; Serialize-only structs are never parsed and are outside the question.
pub fn dropped_field_breaks_the_client(field_has_serde_default: bool, field_is_an_option: bool) bool {
  return !field_has_serde_default and !field_is_an_option;
}

pub fn dropped_field_renders_an_invented_value(field_has_serde_default: bool, default_is_a_number: bool) bool {
  return field_has_serde_default and default_is_a_number;
}

pub fn mirror_is_faithful(field_has_serde_default: bool, default_is_a_number: bool) bool {
  return !dropped_field_renders_an_invented_value(field_has_serde_default, default_is_a_number);
}

; --- Where a defaulted number reached money, and what it does instead ---------------------------
; FIXED 2026-09-21. CartItem::from_server (src/ui/state.rs:42-71) is the only reader of the server
; cart and it always dropped what it could not read: an unrecognised kind and a zero quantity. It
; did not drop an unreadable price, and it did not carry one either. It replaced a NON-finite
; unit_price with 0.0, and a unit_price the server omitted was already 0.0 from the default at
; src/ui/api/types.rs:423 -- finite, so it passed that test untouched. The line then reached
; recalculate_total as a FREE item: a bike the customer was shown at no charge, and a cart total
; that agreed with it.
; The line still survives, and that is deliberate: dropping it would have replaced a silent zero
; with a silently missing line, which is the same defect wearing better manners. What changed is
; that the absence now travels. src/ui/state.rs:65 routes the wire price through
; published_money -- the same filter the catalog renders through (D15) -- so None, a zero, a
; negative and a non-finite value all land as None; every renderer shows a dash beside the sentence
; D11 requires; and trios::pricing::cart_total refuses to total a cart holding such a line, so the
; checkout has no number to submit and says so instead of quoting one.
; The RULE this section states is unchanged and its INPUT changed: a surviving line hides its
; absence when the price field defaults to a NUMBER, which is no longer the case here.
pub const LINE_DROPPED_ON_UNKNOWN_KIND : bool = true;
pub const LINE_DROPPED_ON_ZERO_QUANTITY : bool = true;
pub const LINE_DROPPED_ON_AN_ABSENT_PRICE : bool = false;
pub const ABSENT_PRICE_SURVIVES_AS_A_FREE_LINE : bool = false;
pub const NON_FINITE_PRICE_SURVIVES_AS_A_FREE_LINE : bool = false;
pub const ABSENT_PRICE_SURVIVED_AS_A_FREE_LINE_BEFORE_THE_FIX : bool = true;
pub const ABSENT_PRICE_IS_CARRIED_AS_AN_ABSENCE : bool = true;
pub const UNPRICED_LINE_BLOCKS_THE_CART_TOTAL : bool = true;
pub const UNPRICED_CART_CAN_BE_SUBMITTED : bool = false;
pub const PRICE_FILTER_IS_SHARED_WITH_THE_CATALOG : bool = true;
pub const PRICE_FILTER_SITE : str = "src/trios/pricing.rs published_money";

pub fn cart_line_survives(kind_known: bool, quantity_positive: bool) bool {
  return kind_known and quantity_positive;
}

; A dropped line is a visible absence by disappearing. A surviving line is a visible absence only
; while its price field cannot fabricate a number -- which is what an Option guarantees and a
; defaulted bare number does not.
pub fn price_absence_is_visible(line_survives: bool, price_default_is_a_number: bool) bool {
  if (!line_survives) {
    return true;
  }
  return !price_default_is_a_number;
}

; A cart is quotable only when every surviving line carries a price. This is the rule the checkout
; refuses on, written here so a later edit that offers a "partial total" has to change it.
pub fn cart_is_quotable(every_line_priced: bool) bool {
  return every_line_priced;
}

; --- The route table ------------------------------------------------------------------------------
; src/ui/routes.rs:26-86 declares 26 route arms: 25 named paths and the catch-all `/:..route` at
; :84-85. The catch-all is why an unknown path lands on a screen rather than failing to resolve.
; Which aliases exist and which surface each one lands on is deeplink's, declared there as
; LEGACY_ROUTE_ALIASES; this file counts arms and names none of them.
pub const ROUTE_ARM_COUNT : u8 = 26;
pub const NAMED_ROUTE_COUNT : u8 = 25;
pub const CATCHALL_ROUTE_COUNT : u8 = 1;
pub const ROUTE_TABLE_CAN_FAIL_TO_RESOLVE : bool = false;
pub const LEGACY_ALIASES_ARE_DECLARED_AT : str = "turbobaby/deeplink";

pub fn route_resolves(path_is_named: bool, catchall_present: bool) bool {
  return path_is_named or catchall_present;
}

; --- Tests -------------------------------------------------------------------------------------

test the_instrument_is_declared_before_the_measurements {
  assert HOST_SUITE_COMPILES_THIS_HALF == false;
  assert a_claim_here_rests_on_a_test(HOST_SUITE_COMPILES_THIS_HALF) == false;
  assert CFG_TEST_MODULES_IN_UI == 5;
  assert UNIT_TESTS_NEVER_COMPILED == 32;
  assert SHIPPED_INSTRUMENT_IS_A_TEXT_SCAN == true;
  assert SCAN_NEEDLE_COUNT == 4;
  assert SCAN_SEES_A_DEFAULTED_ZERO == false;
}

test the_survey_cited_the_wasm_gate_one_line_above_the_attribute {
  assert WASM_GATE_SITE == "src/lib.rs:17";
  assert SURVEY_CITED_THE_GATE_AT == "src/lib.rs:16";
  assert WASM_GATE_SITE != SURVEY_CITED_THE_GATE_AT;
}

test every_reuse_edge_names_an_owner_and_not_a_line {
  assert REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity";
  assert REUSES_CATALOG_API_ID == "turbobaby/catalog-api";
  assert REUSES_COMMERCE_ID == "turbobaby/commerce";
  assert REUSES_CLIENT_ERRORS_ID == "turbobaby/client-errors";
  assert REUSES_DEEPLINK_ID == "turbobaby/deeplink";
  assert REUSE_EDGE_COUNT == 5;
  assert REUSES_REQUEST_IDENTITY_ID != ID;
  assert REUSES_COMMERCE_ID != REUSES_CATALOG_API_ID;
  assert REUSES_DEEPLINK_ID != REUSES_CLIENT_ERRORS_ID;
}

; The eleven names, and the arithmetic that says the five edges account for all of them. The last
; two asserts are the ones that would catch a rename: the count of names missing from their owners
; is zero TODAY, and the day it was read is a literal rather than an impression.
test every_edge_rests_on_a_declaration_that_exists_in_its_owner {
  assert EDGE_DECLARATIONS_VERIFIED_AT == "2026-09-21";
  assert EDGE_DECLARATIONS_VERIFIED_AT == MEASURED_AT;
  assert REQUEST_IDENTITY_DECLARATIONS.len == 4;
  assert REQUEST_IDENTITY_DECLARATIONS[0] == "identity_of_request";
  assert REQUEST_IDENTITY_DECLARATIONS[3] == "init_data_size_admits";
  assert CATALOG_API_DECLARATIONS[0] == "catalog_api_dto_valid";
  assert COMMERCE_DECLARATIONS[0] == "commerce_idempotency_decision";
  assert CLIENT_ERRORS_DECLARATIONS[0] == "render_kind";
  assert CLIENT_ERRORS_DECLARATIONS[1] == "checkout_message_source";
  assert DEEPLINK_DECLARATIONS[0] == "LEGACY_ROUTE_ALIASES";
  assert DEEPLINK_DECLARATIONS[1] == "deeplink_landing";
  assert LOYALTY_LEDGER_DECLARATIONS[0] == "IDEMPOTENCY_HEADER";
  assert REQUEST_IDENTITY_DECLARATIONS.len + CATALOG_API_DECLARATIONS.len + COMMERCE_DECLARATIONS.len + CLIENT_ERRORS_DECLARATIONS.len + DEEPLINK_DECLARATIONS.len + LOYALTY_LEDGER_DECLARATIONS.len == EDGE_DECLARATIONS_PINNED;
  assert EDGE_DECLARATIONS_MISSING_FROM_THEIR_OWNERS == 0;
  assert edge_rests_on_a_live_declaration(true) == true;
  assert edge_rests_on_a_live_declaration(false) == false;
}

; A pinned NAME is not a copied VALUE, and the difference is the whole reason the names may be
; pinned at all. The five counted edges each carry at least one name; the two declarations that are
; not edges carry one each and still copy nothing.
test pinning_a_declaration_name_is_not_copying_the_owners_value {
  assert CATALOG_API_DECLARATIONS.len == 1;
  assert COMMERCE_DECLARATIONS.len == 1;
  assert LOYALTY_LEDGER_DECLARATIONS.len == 1;
  assert CAP_VALUE_IS_RESTATED_HERE == false;
  assert HEADER_LITERAL_IS_RESTATED_HERE == false;
  assert IDEMPOTENCY_ARMS_ARE_RESTATED_HERE == false;
  assert ROUTE_ALIASES_ARE_RESTATED_HERE == false;
  assert REQUEST_IDENTITY_DECLARATIONS[2] != SIZE_CAP_IS_OWNED_BY;
  assert LOYALTY_LEDGER_DECLARATIONS[0] != HEADER_NAME_IS_ALREADY_DECLARED_AT;
}

test nothing_a_sibling_owns_is_copied_here {
  assert CAP_VALUE_IS_RESTATED_HERE == false;
  assert HEADER_LITERAL_IS_RESTATED_HERE == false;
  assert IDEMPOTENCY_ARMS_ARE_RESTATED_HERE == false;
  assert ROUTE_ALIASES_ARE_RESTATED_HERE == false;
  assert SIZE_CAP_IS_OWNED_BY == "turbobaby/request-identity";
  assert HEADER_NAME_IS_ALREADY_DECLARED_AT == "turbobaby/loyalty-ledger";
  assert LEGACY_ALIASES_ARE_DECLARED_AT == "turbobaby/deeplink";
}

test init_data_has_exactly_three_origins {
  assert init_data_origin(true, true, true) == ORIGIN_SIGNED;
  assert init_data_origin(true, true, false) == ORIGIN_SIGNED;
  assert init_data_origin(true, false, true) == ORIGIN_REBUILT;
  assert init_data_origin(true, false, false) == ORIGIN_NONE;
  assert init_data_origin(false, true, true) == ORIGIN_NONE;
  assert origin_is_known(ORIGIN_COUNT) == false;
}

test a_browser_tab_with_no_host_yields_an_empty_string_not_an_error {
