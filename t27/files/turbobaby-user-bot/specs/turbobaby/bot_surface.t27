pub const CO_DECLARER_DECLARES_THE_EDGE_AT : str = "turbobaby/ai-assist declares REUSES_BOT_SURFACE_ID";
pub const CO_DECLARER_PINS_ITS_REFUSAL_AT : str = "turbobaby/ai-assist declares ESCAPE_RULE_IS_RESTATED_HERE";
