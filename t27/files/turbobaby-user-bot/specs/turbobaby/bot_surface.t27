; --- Tests -----------------------------------------------------------------------------------------------

test the_three_command_surfaces_are_three_different_numbers {
  assert ACCEPTED_COMMAND_COUNT == 16;
  assert HELP_ADVERTISED_COMMAND_COUNT == 5;
  assert TELEGRAM_REGISTERED_COMMAND_COUNT == 0;
  assert SET_MY_COMMANDS_CALL_SITES == 0;
  assert command_surface_counts_agree(ACCEPTED_COMMAND_COUNT, HELP_ADVERTISED_COMMAND_COUNT, TELEGRAM_REGISTERED_COMMAND_COUNT) == false;
  assert command_surface_counts_agree(5, 5, 5) == true;
}

test the_roster_is_closed_and_snake_cased {
  assert command_is_accepted("start") == true;
  assert command_is_accepted("promo_on") == true;
  assert command_is_accepted("promoon") == false;
  assert command_is_accepted("refstats") == true;
  assert command_is_accepted("sets") == false;
  assert command_is_accepted("sommelier") == false;
  assert command_is_accepted("") == false;
}

test eleven_accepted_commands_cannot_be_discovered {
  assert undiscoverable_command_count() == 11;
  assert command_is_discoverable("menu") == true;
  assert command_is_discoverable("invite") == false;
  assert command_is_discoverable("refstats") == false;
  assert command_is_discoverable("help") == false;
}

test six_commands_carry_the_gate_and_the_boolean_decides {
  assert ADMIN_GATED_COMMAND_COUNT == 6;
  assert command_is_admin_gated("engage") == true;
  assert command_is_admin_gated("unblock") == true;
  assert command_is_admin_gated("promo") == true;
  assert command_is_admin_gated("promo_on") == false;
  assert command_is_admin_gated("menu") == false;
  assert bot_admin_command_allowed(true, false) == false;
  assert bot_admin_command_allowed(true, true) == true;
  assert bot_admin_command_allowed(false, false) == true;
}

test the_bot_gate_is_the_roster_and_not_the_proof {
  assert BOT_GATE_IS_ROSTER_MEMBERSHIP == true;
  assert BOT_GATE_VERIFIES_INIT_DATA == false;
  assert ROSTER_IS_SHARED_WITH_THE_HTTP_GATE == true;
  assert REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity";
}

test exactly_one_command_describes_a_gate_it_does_not_have {
  assert COMMANDS_DESCRIBED_AS_PRIVILEGED == 7;
  assert ADMIN_GATED_COMMAND_COUNT == 6;
  assert command_is_described_as_privileged("admin") == true;
  assert command_is_admin_gated("admin") == false;
  assert description_and_gate_agree("admin") == false;
  assert description_and_gate_agree("engage") == true;
  assert description_and_gate_agree("menu") == true;
  assert description_and_gate_agree("promo_on") == true;
  assert ITS_SCREEN_GATES_ELSEWHERE == true;
}

test the_referral_grammar_is_a_prefix_and_a_length_bound {
  assert REFERRAL_PREFIX == "ref_";
  assert referral_code_is_within_cap(0) == true;
  assert referral_code_is_within_cap(200) == true;
  assert referral_code_is_within_cap(201) == false;
  assert start_records_a_referral(true, true, true, false) == true;
  assert start_records_a_referral(true, false, true, false) == false;
  assert start_records_a_referral(true, true, false, false) == false;
  assert start_records_a_referral(true, true, true, true) == false;
  assert start_records_a_referral(false, true, true, false) == false;
}

test an_unparseable_referral_is_answered_exactly_like_a_bare_start {
  assert AN_UNPARSEABLE_REFERRAL_IS_SILENT == true;
  assert AN_UNPARSEABLE_REFERRAL_STILL_ANSWERS == true;
  assert REFERRAL_PAYLOAD_IS_A_MINIAPP_TARGET == false;
  assert start_reply_shape_for_any_referral() == START_PAYLOAD_PLAIN;
  assert start_reply_shape(false, false) == START_PAYLOAD_PLAIN;
}

test the_start_branches_are_tried_in_source_order {
  assert START_PAYLOAD_SHAPE_COUNT == 4;
  assert START_PAYLOAD_REFERRAL == 1;
  assert start_reply_shape(true, false) == START_PAYLOAD_CHANNEL;
  assert start_reply_shape(false, true) == START_PAYLOAD_MINIAPP;
  assert start_reply_shape(true, true) == START_PAYLOAD_CHANNEL;
}

test two_branches_run_before_the_length_bound_is_ever_consulted {
  assert CALLBACK_ROUTER_STAGE_COUNT == 5;
  assert PRE_ROUTER_BRANCH_COUNT == 2;
  assert PRE_ROUTER_BRANCHES_PRECEDE_THE_CAP == true;
  assert THE_CAP_IS_THE_THIRD_STAGE_NOT_THE_FIRST == true;
  assert callback_reaches_the_length_check(false) == true;
  assert callback_reaches_the_length_check(true) == false;
  assert ROUTER_EXACT_KEY_COUNT_INCLUDING_PRE_ROUTER == 6;
  assert ROUTER_PREFIX_COUNT_INCLUDING_PRE_ROUTER == 7;
  assert CALLBACK_CAP_IS_MEASURED_IN_BYTES == true;
  assert PROMO_BROADCAST_RESTATES_THE_ROUTING == false;
}

test the_callback_grammar_is_five_keys_then_six_prefixes {
  assert CALLBACK_EXACT_KEY_COUNT == 5;
  assert CALLBACK_PREFIX_COUNT == 6;
  assert CALLBACK_ACTION_COUNT == 9;
  assert EXACT_KEYS_ARE_TRIED_BEFORE_PREFIXES == true;
  assert PREFIX_STRIP_KEEPS_THE_PAYLOAD_INTACT == true;
  assert CALLBACK_EXACT_KEYS[4] == "show_lang";
  assert CALLBACK_PREFIXES[1] == "sotd_next_";
  assert CALLBACK_PREFIXES[3] == "confirm_";
}

test exactly_the_three_order_actions_are_admin_only {
  assert admin_callback_action_count() == 3;
  assert ORDER_ADVANCING_ACTION_COUNT == 3;
  assert callback_action_requires_admin(ACTION_CONFIRM_ORDER) == true;
  assert callback_action_requires_admin(ACTION_COMPLETE_ORDER) == true;
  assert callback_action_requires_admin(ACTION_REJECT_ORDER) == true;
  assert callback_action_requires_admin(ACTION_JOKE) == false;
  assert callback_action_requires_admin(ACTION_SET_LANGUAGE) == false;
  assert callback_action_requires_admin(ACTION_STRAIN_OF_DAY_PAGE) == false;
  assert callback_action_requires_admin(ACTION_UNKNOWN) == false;
}

test the_router_refuses_unknown_and_over_long_data {
  assert callback_data_is_within_cap(200) == true;
  assert callback_data_is_within_cap(201) == false;
  assert callback_may_run(ACTION_UNKNOWN, true, true) == false;
  assert callback_may_run(ACTION_JOKE, false, true) == false;
  assert callback_may_run(ACTION_JOKE, true, false) == true;
  assert callback_may_run(ACTION_CONFIRM_ORDER, true, false) == false;
  assert callback_may_run(ACTION_CONFIRM_ORDER, true, true) == true;
}

test the_escape_set_is_three_characters_in_a_load_bearing_order {
  assert ESCAPED_CHAR_COUNT == 3;
  assert char_needs_escaping("&") == true;
  assert char_needs_escaping("<") == true;
  assert char_needs_escaping(">") == true;
  assert char_needs_escaping("'") == false;
  assert char_needs_escaping("a") == false;
  assert ESCAPE_REPLACEMENTS[0] == "&amp;";
  assert escape_order_is_safe(ESCAPE_AMPERSAND_INDEX, ESCAPE_LT_INDEX, ESCAPE_GT_INDEX) == true;
  assert escape_order_is_safe(1, 0, 2) == false;
  assert escape_order_is_safe(2, 0, 1) == false;
}

test a_forgotten_escape_loses_the_message_and_says_nothing {
  assert message_renders_as_written(true, true) == true;
  assert message_renders_as_written(true, false) == false;
  assert message_renders_as_written(false, false) == true;
  assert FORGOTTEN_ESCAPE_LOSES_THE_WHOLE_MESSAGE == true;
  assert A_TEST_ENFORCES_ESCAPING_BEFORE_SEND == false;
  assert A_WRAPPER_ESCAPES_AUTOMATICALLY == false;
  assert A_PARSE_FAILURE_IS_AN_EXPECTED_SEND_ERROR == false;
  assert EXPECTED_SEND_ERROR_COUNT == 5;
}

test the_bot_modules_declare_more_html_sends_than_they_escape {
  assert BOT_HTML_SEND_SITES == 23;
  assert BOT_ESCAPE_CALL_SITES == 8;
  assert unguarded_html_send_count(BOT_HTML_SEND_SITES, BOT_ESCAPE_CALL_SITES) == 15;
  assert unguarded_html_send_count(REPO_HTML_SEND_SITES, REPO_ESCAPE_CALL_SITES) == 0;
  assert unguarded_html_send_count(8, 23) == 0;
  assert REPO_ESCAPE_GREP_HITS_INCLUDING_THE_HELPER_AND_ITS_TESTS == 46;
  assert unguarded_html_send_count(REPO_ESCAPE_GREP_HITS_INCLUDING_THE_HELPER_AND_ITS_TESTS, REPO_ESCAPE_CALL_SITES) == 6;
  assert FIRE_AND_FORGET_CALL_SITES == 3;
  assert BOT_HTML_SENDS_BEHIND_THE_EXPECTED_ERROR_FILTER == 2;
  assert BOT_HTML_SENDS_BEHIND_THE_EXPECTED_ERROR_FILTER < BOT_HTML_SEND_SITES;
  assert unguarded_html_send_count(BOT_HTML_SEND_SITES, BOT_HTML_SENDS_BEHIND_THE_EXPECTED_ERROR_FILTER) == 21;
  assert send_error_reaches_the_expected_error_filter(true) == true;
  assert send_error_reaches_the_expected_error_filter(false) == false;
  assert CO_DECLARER_BOT_MODULE_SITES == 5;
  assert CO_DECLARER_BOT_MODULE_SITES < BOT_ESCAPE_CALL_SITES;
  assert CO_DECLARER_RESTATES_THE_ESCAPE_RULE == false;
  assert ESCAPE_RULE_IS_CO_DECLARED_WITH != ID;
}

