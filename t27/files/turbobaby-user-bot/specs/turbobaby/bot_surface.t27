; --- Invariants ------------------------------------------------------------------------------------------

invariant the_accepted_surface_is_never_the_advertised_one
  assert command_surface_counts_agree(ACCEPTED_COMMAND_COUNT, HELP_ADVERTISED_COMMAND_COUNT, TELEGRAM_REGISTERED_COMMAND_COUNT) == false

invariant every_advertised_command_is_also_accepted
  assert command_is_accepted("start") and command_is_accepted("menu") and command_is_accepted("joke") and command_is_accepted("fact") and command_is_accepted("lang")

invariant every_gated_command_is_also_accepted
  assert command_is_accepted("engage") and command_is_accepted("factpost") and command_is_accepted("unblock") and command_is_accepted("blocks") and command_is_accepted("errors") and command_is_accepted("promo")

invariant a_gated_command_cannot_run_without_the_roster_boolean
  assert bot_admin_command_allowed(true, false) == false

invariant an_ungated_command_never_consults_the_roster
  assert bot_admin_command_allowed(false, false) == bot_admin_command_allowed(false, true)

invariant the_bot_gate_never_becomes_a_proof_of_identity
  assert BOT_GATE_VERIFIES_INIT_DATA == false and ROSTER_IS_SHARED_WITH_THE_HTTP_GATE == true

invariant the_one_ungated_privileged_description_stays_visible
  assert description_and_gate_agree(DESCRIBED_PRIVILEGED_BUT_UNGATED) == false

invariant a_referral_code_over_the_bound_is_never_recorded
  assert start_records_a_referral(true, false, true, false) == false

invariant a_self_referral_is_never_recorded
  assert start_records_a_referral(true, true, true, true) == false

invariant a_referral_payload_never_opens_a_mini_app_card
  assert start_reply_shape_for_any_referral() == START_PAYLOAD_PLAIN

invariant unrecognised_callback_data_can_never_act
  assert callback_may_run(ACTION_UNKNOWN, true, true) == false

invariant over_long_data_that_reaches_the_router_can_never_act
  assert callback_may_run(ACTION_CONFIRM_ORDER, false, true) == false and callback_may_run(ACTION_JOKE, false, true) == false

invariant the_two_pre_router_branches_are_never_measured_against_the_cap
  assert callback_reaches_the_length_check(true) == false and PRE_ROUTER_BRANCHES_PRECEDE_THE_CAP == true and PRE_ROUTER_BRANCH_COUNT == 2

invariant the_routers_own_counts_are_never_mistaken_for_the_whole_surface
  assert ROUTER_EXACT_KEY_COUNT_INCLUDING_PRE_ROUTER > CALLBACK_EXACT_KEY_COUNT and ROUTER_PREFIX_COUNT_INCLUDING_PRE_ROUTER > CALLBACK_PREFIX_COUNT

invariant exactly_three_callback_actions_require_the_roster
  assert admin_callback_action_count() == ORDER_ADVANCING_ACTION_COUNT

invariant the_ampersand_is_always_replaced_before_the_angle_brackets
  assert escape_order_is_safe(ESCAPE_AMPERSAND_INDEX, ESCAPE_LT_INDEX, ESCAPE_GT_INDEX) == true and escape_order_is_safe(ESCAPE_LT_INDEX, ESCAPE_AMPERSAND_INDEX, ESCAPE_GT_INDEX) == false

invariant an_html_send_of_unescaped_text_never_reaches_the_customer
  assert message_renders_as_written(true, false) == false

invariant nothing_in_the_repository_escapes_on_a_callers_behalf
  assert A_WRAPPER_ESCAPES_AUTOMATICALLY == false and A_TEST_ENFORCES_ESCAPING_BEFORE_SEND == false

invariant the_expected_error_filter_is_never_credited_with_more_sends_than_it_covers
  assert BOT_HTML_SENDS_BEHIND_THE_EXPECTED_ERROR_FILTER < BOT_HTML_SEND_SITES and send_error_reaches_the_expected_error_filter(false) == false

invariant the_legacy_carousel_can_never_answer_with_content
  assert legacy_surface_answers_with_content(LEGACY_TABLE_IS_LIVE, 9) == false

invariant the_legacy_carousel_has_no_first_page_producer
  assert legacy_page_is_reachable(LEGACY_FIRST_PAGE_PRODUCERS) == false

invariant a_retired_carousel_press_never_answers_with_content
  assert legacy_press_answers_with_content(true, true, 9) == false and CAROUSEL_PRESS_READS_A_TABLE == false and LEGACY_BUTTON_PRODUCERS_AFTER_RETIREMENT == 0

invariant this_file_never_rules_on_the_retirement
  assert RETIREMENT_IS_NOT_THIS_FILES_DECISION == true and REUSES_LEGACY_RETIREMENT_ID != ID

; The two drift invariants. Each holds a MARKED COPY equal to the value its owner declares, so
; editing one number here without editing turbobaby/legacy-retirement's DROPPED_TABLE_COUNT or
; ALLOWLIST_SIZE fails the gate in this file rather than leaving two contracts disagreeing.
invariant the_dropped_table_count_never_drifts_from_its_owner
  assert LEGACY_TABLES_DROPPED_BY_THAT_MIGRATION == DROPPED_TABLE_COUNT_OWNERS_VALUE and DROPPED_TABLE_COUNT_OWNER_ID != ID and THESE_TWO_COUNTS_ARE_COPIES == true

invariant the_survivor_allowlist_size_never_drifts_from_its_owner
  assert LEGACY_SURVIVOR_ENTRY_COUNT == ALLOWLIST_SIZE_OWNERS_VALUE and DROPPED_TABLE_COUNT_OWNER_ID == REUSES_LEGACY_RETIREMENT_ID

invariant a_sibling_is_never_cited_by_line_number_again
  assert LEGACY_RETIREMENT_DECLARES_THIS_FILE_AT == "turbobaby/legacy-retirement declares REUSES_BOT_SURFACE_ID" and PROMO_BROADCAST_POINTS_BACK_AT == "turbobaby/promo-broadcast declares REUSES_BOT_SURFACE_ID"

invariant the_withdrawn_characterisation_never_comes_back
  assert EVERY_TELEGRAM_HIT_IS_A_COLUMN_OR_PRIVACY_FIELD == false and ANY_OTHER_SPEC_DECLARES_A_COMMAND_SURFACE == false

invariant the_corpus_counts_are_never_read_without_their_denominator
  assert SPECS_MATCHING_TELEGRAM_2026_09_21 < CORPUS_FILES_OTHER_THAN_THIS_ONE and SPECS_NAMING_A_SLASH_COMMAND_2026_09_21 < CORPUS_FILES_OTHER_THAN_THIS_ONE and SPECS_MATCHING_TELEGRAM_2026_09_22 < CORPUS_FILES_OTHER_THAN_THIS_ONE_REMEASURED and SPECS_NAMING_A_SLASH_COMMAND_2026_09_22 < CORPUS_FILES_OTHER_THAN_THIS_ONE_REMEASURED

invariant the_order_buttons_borrow_their_vocabulary
  assert CALLBACK_OWNS_NO_STATUS_VOCABULARY == true and REUSES_ORDER_STATUS_ID == "turbobaby/order-status"
