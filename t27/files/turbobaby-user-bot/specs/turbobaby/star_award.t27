// SPDX-License-Identifier: Apache-2.0
; specs/turbobaby/star_award.t27 -- the server side of a game Star payout
; This contract owns the decision /api/stars/add makes when a game asks to be paid: which sources
; are capped because a game rather than a purchase produced them, the per-window ceiling for one
; player on one source, the fact that an over-ceiling request is TRIMMED and not refused, the
; separate per-call ceiling, and what the answer lets the caller see. turbobaby/ride-runtime owns
; SERVER_OWNS_AWARD_DECISION, which is true, and CLIENT_OWNS_AWARD_CAP, which is false, and then
; names no server owner. This file is that owner, and it names ride_runtime's ID so the pointer
; becomes an edge instead of a dangling claim. Re-verified 2026-09-21, and scoped more carefully
; than the first writing scoped it: both declarations still exist and still carry those values,
; and ride_runtime.t27 declares exactly ONE reuse edge -- REUSES_RIDE_GAME_ID, pointing at
; turbobaby/ride-game -- so it is not a file without edges, it is a file whose one edge is not
; this one. The award pointer is still undeclared from that side, which is what makes the edge
; below load-bearing in one direction only.
; --
; WHY (measured 2026-09-20). Two ceilings guard the same money and they are not the same size.
; src/api/stars.rs:52 sets the per-call ceiling to 1000000 and src/api/stars.rs:54-59 refuses only
; an amount outside 1 through 1000000, so nothing in the handler's validation layer stops a
; million-Star credit, and on a source outside the capped set the endpoint pays it in full
; (src/api/stars.rs:269-271). The only bound that touches a game is
; src/trios/stars_cap.rs:26, 300 per source per window -- the per-call ceiling exceeds it
; 3333-fold. The amount is supplied by the caller: src/ui/screens/ride_screen.rs:79-81 builds the
; body from the run's own collected count and :82-86 posts it. src/trios/stars_cap.rs:3-7 records
; why that matters: Stars are spendable at checkout, so a game that credits them is a mint, and
; without a per-source ceiling one paused game loop or one hand-replayed request walks off with
; the till.
; --
; WHERE THE ISSUE IS REFUTED. Three readings this file exists to kill.
; 1. "The server refuses an over-cap payout." It does not. src/trios/stars_cap.rs:33-38 and
;    src/api/stars.rs:221-229 record the opposite decision in the same words: the call succeeds
;    and pays what is left, because failing it would end a player's run with an error for doing
;    nothing wrong. An allowance of zero means ACCEPT WITHOUT CREDITING, never reject.
; 2. "The cap bounds what one player earns per day." It bounds one player on ONE source.
;    src/api/stars.rs:236 filters the running total by source, and the capped set has four
;    members, so 1200 is reachable in one window and 300 is not the player's ceiling.
; 3. "A capped source list is a list of live games, so a retired spelling can be deleted."
;    src/trios/stars_cap.rs:16-18 records the opposite: an old spelling stays precisely so an old
;    idempotent retry cannot bypass the cap merely because the UI was renamed. Shortening the set
;    uncaps a source; its LENGTH is therefore the permission and an invariant pins it.
; --
; WHAT THIS FILE NEVER DOES. It publishes no exchange rate and performs no conversion: that
; prohibition is turbobaby/market's (REUSES_MARKET_PROFILE_ID), which owns EXCHANGE_RATES_PUBLISHED
; -- an empty array -- and EXCHANGE_RATE_RULE beside it, both re-read 2026-09-21; the face-value
; sentence at
; src/trios/stars_cap.rs:3 is a shop fact there, not a rate here. It emits no client price (D11)
; and owns no order total -- the total identity is order_money.t27's and the checkout seam around
; it is commerce.t27's, and what a Star is worth when SPENT is order_money's too. It does not restate
; commerce.t27's idempotency decision set; it consumes exactly one boolean from that owner. It
; caps nothing outside the game sources: a manual admin credit and a refund are deliberate and
; pass untrimmed (src/trios/stars_cap.rs:13-15, 90-98). It carries no player, no balance row, no
; leaderboard name and no D14 field. It does not own the high-score table and it does not own the
; missing per-game discriminator: both belong to game_score.t27 (REUSES_GAME_SCORE_ID), which
; names this file as the payout owner in return, so that pair is one edge declared from each side
; rather than one subject declared twice.
; phi^2 + 1/phi^2 = 3 | TRINITY

module turbobaby-star-award;

pub const KIND : str = "contract";
pub const ID : str = "turbobaby/star-award";
pub const NAME : str = "TurboBaby game Star award ceiling";
pub const WORLD : str = "gHashTag/turbobaby-user-bot";
pub const MEASURED_AT : str = "2026-09-20";

; Where each rule below is implemented. The cap lives outside the handler on purpose
; (src/trios/stars_cap.rs:9-11): src/ui and src/api cannot share code otherwise.
pub const CAP_IMPLEMENTATION : str = "src/trios/stars_cap.rs";
pub const ENDPOINT_IMPLEMENTATION : str = "src/api/stars.rs";
pub const CLIENT_CALL_SITE : str = "src/ui/screens/ride_screen.rs";
pub const LEDGER_MIGRATION : str = "migrations/042_stars_currency.sql";

; --- Reuse edges, named because there are no imports -------------------------------------------
; A brace import lowers to an empty UseDecl under the pinned compiler and is rejected, so a
; cross-contract dependency is a string that a test pins to its literal. Deleting one of these
; breaks a test rather than quietly orphaning the edge.
pub const REUSES_RIDE_RUNTIME_ID : str = "turbobaby/ride-runtime";
pub const REUSES_COMMERCE_ID : str = "turbobaby/commerce";
pub const REUSES_MARKET_PROFILE_ID : str = "turbobaby/market";
; game_score.t27 owns the score ledger, the leaderboard content and the absent per-game
; discriminator, and it names this file as the payout owner. The two endpoints share a caller and
; nothing else: a score is a number in that table, a Star is currency here, and neither file
; converts one into the other.
pub const REUSES_GAME_SCORE_ID : str = "turbobaby/game-score";
; The owner check that lets a caller credit only itself (src/api/stars.rs:168) is proved by
; request_identity.t27. This file consumes that proof and re-derives none of it.
pub const REUSES_REQUEST_IDENTITY_ID : str = "turbobaby/request-identity";
; order_money.t27 owns the order total and what a Star is worth when it is SPENT. This file owns
; only the credit. The two are easy to confuse because the repository gives them the SAME NAME at
; the SAME MAGNITUDE in two files: src/api/stars.rs:52 caps what one call may CREDIT and
; src/api/orders.rs:202 caps what one order may SPEND, both spelled MAX_STARS_PER_TX and both
; 1000000. They are two limits on two endpoints in opposite directions; neither is derived from
; the other, and a change to one says nothing about the other. This constant exists so a reader
; who notices the coincidence does not read it as one rule written twice.
pub const REUSES_ORDER_MONEY_ID : str = "turbobaby/order-money";
pub const THE_SPEND_CEILING_IS_A_DIFFERENT_CONSTANT_AT_THE_SAME_MAGNITUDE : bool = true;

; The dangling pointer this file closes. ride_runtime.t27 states that a server owns the award
; decision and that the client owns no cap; until this file existed, no contract answered to that.
pub const RIDE_RUNTIME_DECLARES_A_SERVER_OWNER : bool = true;
pub const THIS_FILE_IS_THAT_SERVER_OWNER : bool = true;

; turbobaby/commerce owns the idempotency decision vocabulary: IDEM_REJECT_KEY, IDEM_CREATE_NEW,
; IDEM_RETURN_PRIOR, IDEM_IN_PROGRESS, IDEM_CONFLICT, closed by IDEM_DECISION_COUNT (reject,
; create, return prior, in progress, conflict). Re-read 2026-09-21: all six declarations still
; exist there and the count still closes the set at five. This file restates none of it. It takes the replay verdict as one inbound
; boolean, and only records WHICH FIELD the endpoint keys on: src/api/stars.rs:34 declares
; external_tx_id as the game-generated id, src/api/stars.rs:192-219 locks and checks it, and
; migrations/042_stars_currency.sql gives it its own table.
pub const THIS_FILE_RESTATES_THE_IDEMPOTENCY_DECISION_SET : bool = false;
pub const IDEMPOTENCY_SUBJECT_FIELD : str = "external_tx_id";
; The bound is the column width, enforced at the door: src/api/stars.rs:69 refuses an empty id or
; one longer than 100, and migrations/042_stars_currency.sql:34 declares the key column
; VARCHAR(100) -- the ledger's own copy of the field (:23) is the same width.
pub const EXTERNAL_TX_ID_MAX_LEN : u16 = 100;
; src/ui/screens/ride_screen.rs:77-78 mints a fresh key per run, so a replay of that run's post
; is the only thing the key can collide with.
pub const CLIENT_KEY_IS_FRESH_PER_RUN : bool = true;

; --- The capped set ----------------------------------------------------------------------------
; src/trios/stars_cap.rs:19, verbatim in order. These are the sources whose payouts are capped
; because a game, not a purchase, produced them. The set is closed: anything absent is untrimmed.
pub const CAPPED_SOURCE_COUNT : u8 = 4;
pub const CAPPED_SOURCES : [4]str = ["ride", "skate", "woodshop", "game"];
; The live Ride posts source "ride" (src/ui/screens/ride_screen.rs:80). "skate" is the retired
; spelling kept deliberately (src/trios/stars_cap.rs:16-18): historical ledger rows and replay
; checks still carry it, and dropping it would let an old idempotent retry bypass the cap because
; the UI was renamed. A rename is therefore an ADDITION to this set, never a substitution.
pub const LIVE_RIDE_SOURCE : str = "ride";
pub const RETAINED_LEGACY_SOURCE : str = "skate";
pub const DROPPING_A_LEGACY_SPELLING_UNCAPS_A_REPLAY : bool = true;
; src/trios/stars_cap.rs:13-15 and its unit test at 90-98. An admin correction and a refund are
; deliberate acts by a human and must not be silently trimmed; "plot" is the debit source
; (src/api/stars.rs:495) and a spend is not a credit at all.
pub const NO_CAP_ON_A_MANUAL_CREDIT_OR_REFUND : bool = true;

pub fn source_is_capped(source: str) bool {
  if (source == CAPPED_SOURCES[0]) {
    return true;
  }
  if (source == CAPPED_SOURCES[1]) {
    return true;
  }
  if (source == CAPPED_SOURCES[2]) {
    return true;
  }
  if (source == CAPPED_SOURCES[3]) {
    return true;
  }
  return false;
}

; --- The per-window ceiling ---------------------------------------------------------------------
; src/trios/stars_cap.rs:26. The justification recorded beside it (lines 21-25) is that the amount
; is roughly one small order, so a dedicated player earns a real but bounded discount and an
; exploit is worth a capped amount rather than an unbounded one. No price is restated here.
pub const PER_SOURCE_WINDOW_CAP : i32 = 300;
; src/api/stars.rs:237 sums the last 24 hours from now, not the calendar day, so the window slides
; and there is no midnight at which a player's allowance resets in a step.
pub const WINDOW_HOURS : u8 = 24;
pub const WINDOW_IS_ROLLING_NOT_CALENDAR : bool = true;
; The ceiling is per (player, source): src/api/stars.rs:236 filters by source as well as player.
; Derived in one visible step and measured nowhere: 300 times the four capped sources. It exists
; so that nobody reads 300 as the most a player can earn from games in a window.
pub const REACHABLE_WINDOW_TOTAL_STARS : i32 = 1200;

; src/trios/stars_cap.rs:43 is a saturating subtraction over a history clamped at zero. Both
; clamps are load-bearing: a corrupt negative history must not become extra headroom, and an
; over-full history must not become a negative remainder that a later addition could spend.
pub fn window_remaining(already_in_window: i32) i32 {
  if (already_in_window <= 0) {
    return PER_SOURCE_WINDOW_CAP;
  }
  if (already_in_window >= PER_SOURCE_WINDOW_CAP) {
    return 0;
  }
  return PER_SOURCE_WINDOW_CAP - already_in_window;
}

; src/trios/stars_cap.rs:39-45. A non-positive request yields zero before the history is ever
; consulted, and an over-ceiling request comes back trimmed to the remainder.
pub fn allowed_credit(requested: i32, already_in_window: i32) i32 {
  if (requested <= 0) {
    return 0;
  }
  if (requested > window_remaining(already_in_window)) {
    return window_remaining(already_in_window);
  }
  return requested;
}

pub fn credit_was_trimmed(requested: i32, already_in_window: i32) bool {
  return allowed_credit(requested, already_in_window) < requested;
}

; --- The per-call ceiling ------------------------------------------------------------------------
; src/api/stars.rs:52 and 54-59. This runs before anything reads the ledger, and it is the only
; branch of the endpoint that answers with a refusal rather than a success.
pub const MAX_STARS_PER_CALL : i32 = 1000000;

pub fn amount_passes_per_call_ceiling(amount: i32) bool {
  return amount >= 1 and amount <= MAX_STARS_PER_CALL;
}

pub fn external_tx_id_length_is_legal(length: u16) bool {
  return length >= 1 and length <= EXTERNAL_TX_ID_MAX_LEN;
}

; --- The outcome ---------------------------------------------------------------------------------
; Server-side outcomes, not HTTP bodies and not player-visible strings. Zero is the unset sentinel
; and star_award_outcome never returns it.
pub const AWARD_OUTCOME_UNSET : u8 = 0;
pub const AWARD_REFUSED_BAD_AMOUNT : u8 = 1;
pub const AWARD_REPLAY_RETURNS_PRIOR : u8 = 2;
pub const AWARD_CREDITED_IN_FULL : u8 = 3;
pub const AWARD_CREDITED_TRIMMED : u8 = 4;
pub const AWARD_ACCEPTED_UNCREDITED : u8 = 5;
pub const AWARD_OUTCOME_COUNT : u8 = 5;

; PRECONDITION, declared because the algebra below cannot express it. star_award_outcome answers
; for a request that has already cleared the door: identity (src/api/stars.rs:167-168, proved by
; request_identity.t27), the block check (src/api/stars.rs:169), the source and reason lengths
; (src/api/stars.rs:171) and the key length (src/api/stars.rs:172). Each of those refuses on its
; own -- the two length gates with a 400 (src/api/stars.rs:63, 70) and the block check with a 403
; (src/api/auth.rs:683) -- and none of them is an award decision.
; So AWARD_REFUSED_BAD_AMOUNT is the only refusal this ALGEBRA returns, and not the only refusal
; the ENDPOINT has. external_tx_id_length_is_legal above states that separate gate; it is
; deliberately not an argument here, because a request failing it never reaches the award
; decision at all.
pub const THE_ALGEBRA_ASSUMES_A_WELL_FORMED_REQUEST : bool = true;
pub const THE_ENDPOINT_HAS_REFUSALS_THIS_ALGEBRA_DOES_NOT_MODEL : bool = true;

; The order of the gates is the handler's order and it is load-bearing. src/api/stars.rs:170
; validates the amount before the idempotency lock at 192, so a replay carrying a bad amount is
; still a refusal; src/api/stars.rs:203-219 returns the prior answer before the cap lookup at 230,
; so a replay never re-reads the window and never pays twice; src/api/stars.rs:269-271 passes an
; uncapped source through untouched. replay_returns_prior is commerce.t27's verdict, consumed
; whole.
pub fn star_award_outcome(amount: i32, replay_returns_prior: bool, source_capped: bool, already_in_window: i32) u8 {
  if (!amount_passes_per_call_ceiling(amount)) {
    return AWARD_REFUSED_BAD_AMOUNT;
  }
  if (replay_returns_prior) {
    return AWARD_REPLAY_RETURNS_PRIOR;
  }
  if (!source_capped) {
    return AWARD_CREDITED_IN_FULL;
  }
  if (allowed_credit(amount, already_in_window) == 0) {
    return AWARD_ACCEPTED_UNCREDITED;
  }
  if (credit_was_trimmed(amount, already_in_window)) {
    return AWARD_CREDITED_TRIMMED;
  }
  return AWARD_CREDITED_IN_FULL;
}

; A player at the ceiling still finishes the run: four of the five outcomes are a 200 and only a
; malformed amount is a refusal (src/api/stars.rs:56, 212-218, 259-266, 373-379).
pub fn award_call_is_http_success(outcome: u8) bool {
  return outcome == AWARD_REPLAY_RETURNS_PRIOR or outcome == AWARD_CREDITED_IN_FULL or outcome == AWARD_CREDITED_TRIMMED or outcome == AWARD_ACCEPTED_UNCREDITED;
}

; --- What the answer lets the caller see ----------------------------------------------------------
; Measured, and narrower than it looks. The capped flag is emitted on one branch only: allowance
; zero (src/api/stars.rs:259-266). A PARTIAL trim takes the ordinary success path, whose body
; echoes the amount that was asked for (src/api/stars.rs:377) while the ledger row stores the
; amount that was paid (src/api/stars.rs:344) and the idempotency row stores the amount that was
; asked for (src/api/stars.rs:360). The caller reads the flag and nothing else
; (src/ui/screens/ride_screen.rs:90) and then prints its own collected count
; (src/ui/screens/ride_screen.rs:106). No field of that response names the trim. The body does
; carry the new balance (src/api/stars.rs:378), so a caller that had kept its own prior balance
; could subtract and see the difference -- the shipped caller keeps none and does not. That is the
; measured claim exactly: not signalled, rather than underivable. This file states it, does not
; repair it, and it is not a licence for the client to compute an award.
pub const CAPPED_FLAG_IS_SET_ONLY_WHEN_NOTHING_IS_CREDITED : bool = true;
pub const LEDGER_ROW_RECORDS_THE_CREDITED_AMOUNT : bool = true;
pub const SUCCESS_BODY_ECHOES_THE_REQUESTED_AMOUNT : bool = true;
pub const SUCCESS_BODY_ALSO_CARRIES_THE_NEW_BALANCE : bool = true;
pub const PARTIAL_TRIM_IS_NOT_SIGNALLED_ON_THE_WIRE : bool = true;

pub fn caller_can_observe_the_trim(outcome: u8) bool {
  return outcome == AWARD_ACCEPTED_UNCREDITED;
}

; --- Refusals --------------------------------------------------------------------------------------
; No rate, no conversion. turbobaby/market owns that prohibition in EXCHANGE_RATES_PUBLISHED and
; EXCHANGE_RATE_RULE; naming it here is what stops
; the face value at src/trios/stars_cap.rs:3 from being read as an FX rate published by this file.
pub const THIS_FILE_PUBLISHES_AN_EXCHANGE_RATE : bool = false;
pub const THIS_FILE_CONVERTS_BETWEEN_CURRENCIES : bool = false;
pub const THIS_FILE_EMITS_A_CLIENT_PRICE : bool = false;
pub const THIS_FILE_OWNS_AN_ORDER_TOTAL : bool = false;

; No person-level data of any kind, pinned structurally rather than promised in prose. The
; endpoint's own identity column is telegram_id (migrations/042_stars_currency.sql) and no value
; of it, nor any display name from the leaderboard, appears in this contract.
pub const PERSON_LEVEL_FIELDS_CARRIED : [0]str = [];

; THE FIRST REFUSAL. The scoreboard is not this file's, and neither is the missing per-game
; discriminator. Both are game_score.t27's, named above. The payout and the score are two writes
; on two endpoints (src/api/stars.rs:22 and src/api/game.rs:20-21) that happen to share one
; caller; a contract over both would be two contracts. The absence itself is measured and stated
; once, over there, and is not re-measured here. Re-checked 2026-09-21 that the sentence still has
; a referent: turbobaby/game-score holds GAME_KEY_OCCURRENCES and the zero it carries, and it is
; the only contract in the corpus that declares it. The check counts DECLARATIONS and not
; mentions, and that choice was forced by getting it wrong once: an earlier draft of this comment
; said the discriminator's name occurred in exactly one .t27 file, and writing that sentence
; raised the count to two, because the sentence contains the name. A measurement a contract can
; break by describing itself is not a measurement. "Stated once, over there" is only safe while
; the over-there exists, so the owner is pinned below by ID and by declaration name.
pub const HIGH_SCORE_TABLE_IS_OWNED_HERE : bool = false;
pub const GAME_DISCRIMINATOR_IS_OWNED_HERE : bool = false;
pub const ABSENCE_OWNER_CHECKED_AT : str = "2026-09-21";
pub const GAME_DISCRIMINATOR_ABSENCE_DECLARATION : str = "GAME_KEY_OCCURRENCES";
pub const CONTRACTS_DECLARING_THE_DISCRIMINATOR_ABSENCE : u8 = 1;

; THE SECOND REFUSAL. What the shipped caller posts is narrower than "on every run end", and the
; non-positive branch of the trio is narrower still: nothing shipped reaches it, in either
; direction. Client side, the Ride posts the award only on the FIRST end of a run
; (src/ui/screens/ride_screen.rs:164-167) and only when at least one Star was collected
; (src/ui/screens/ride_screen.rs:74-76); the unguarded post two statements earlier
; (src/ui/screens/ride_screen.rs:67-72) goes to the score endpoint, which is game_score.t27's
; subject and not this one. Server side, measured: allowed_credit has exactly ONE call site in
; the tree (src/api/stars.rs:248 -- the only match for it in src/ outside the trio itself), and
; src/api/stars.rs:170 has already refused an amount outside 1 through 1000000
; (src/api/stars.rs:55-56) before that line can run. So src/trios/stars_cap.rs:40-42 is dead on
; every shipped path. It is NOT a live defence against a hostile /api/stars/add request -- that
; request dies at the endpoint's first validation gate -- and this file does not claim otherwise:
; it is a defence for a SECOND caller of the trio that the repository does not have. Stated, not
; repaired. The guard stays because the trio compiles and is unit-tested on its own
; (src/trios/stars_cap.rs:79-82) and a second caller is the cheap way to lose the check; what
; would be needed to drop it is that second caller never appearing, which no measurement can
; establish.
pub const THE_SHIPPED_CLIENT_CAN_SEND_A_NONPOSITIVE_REQUEST : bool = false;
pub const THE_ENDPOINT_REFUSES_A_NONPOSITIVE_AMOUNT_BEFORE_THE_TRIO_SEES_IT : bool = true;
pub const ANOTHER_CALLER_OF_THE_TRIO_IS_NOT_SHIPPED : bool = true;
pub const TRIO_CALL_SITE_COUNT : u8 = 1;

; --- Tests -------------------------------------------------------------------------------------

test the_capped_set_is_exactly_the_four_game_sources {
  assert source_is_capped("ride") == true;
  assert source_is_capped("skate") == true;
  assert source_is_capped("woodshop") == true;
  assert source_is_capped("game") == true;
  assert source_is_capped("admin_grant") == false;
  assert source_is_capped("refund") == false;
  assert source_is_capped("plot") == false;
  assert CAPPED_SOURCES.len == CAPPED_SOURCE_COUNT;
}

test the_retired_spelling_is_still_capped_and_is_not_the_live_one {
  assert source_is_capped(RETAINED_LEGACY_SOURCE) == true;
  assert source_is_capped(LIVE_RIDE_SOURCE) == true;
  assert RETAINED_LEGACY_SOURCE != LIVE_RIDE_SOURCE;
  assert CAPPED_SOURCES[0] == LIVE_RIDE_SOURCE;
  assert CAPPED_SOURCES[1] == RETAINED_LEGACY_SOURCE;
}

test the_window_remainder_saturates_at_both_ends {
  assert window_remaining(0) == PER_SOURCE_WINDOW_CAP;
  assert window_remaining(-1000) == PER_SOURCE_WINDOW_CAP;
  assert window_remaining(270) == 30;
  assert window_remaining(PER_SOURCE_WINDOW_CAP) == 0;
  assert window_remaining(PER_SOURCE_WINDOW_CAP + 999) == 0;
}

; The two unit tests at the bottom of src/trios/stars_cap.rs, restated as the contract they check:
; a fresh player is paid what they earned, and a request over the remainder comes back trimmed.
test a_fresh_player_is_paid_in_full_and_an_overrun_is_trimmed {
  assert allowed_credit(50, 0) == 50;
  assert allowed_credit(100, 270) == 30;
  assert credit_was_trimmed(50, 0) == false;
  assert credit_was_trimmed(100, 270) == true;
}

test a_nonpositive_request_yields_nothing_without_consulting_history {
  assert allowed_credit(0, 0) == 0;
  assert allowed_credit(-500, 0) == 0;
  assert allowed_credit(-500, 290) == 0;
  assert THE_SHIPPED_CLIENT_CAN_SEND_A_NONPOSITIVE_REQUEST == false;
}

; The branch above is real code with no live caller, and saying so is the whole point of this
; test: the endpoint's own amount gate refuses 0 and every negative before the trio is reached.
test the_nonpositive_branch_has_no_live_caller {
  assert amount_passes_per_call_ceiling(0) == false;
  assert amount_passes_per_call_ceiling(-500) == false;
  assert THE_ENDPOINT_REFUSES_A_NONPOSITIVE_AMOUNT_BEFORE_THE_TRIO_SEES_IT == true;
  assert ANOTHER_CALLER_OF_THE_TRIO_IS_NOT_SHIPPED == true;
  assert TRIO_CALL_SITE_COUNT == 1;
}

test a_corrupt_history_cannot_raise_the_ceiling {
  assert allowed_credit(10000, -1000) == PER_SOURCE_WINDOW_CAP;
  assert allowed_credit(10000, 0) == PER_SOURCE_WINDOW_CAP;
}

; The exploit the cap exists for: replaying the payout call. Each attempt sees the previous total,
; so the sum cannot pass the ceiling however many times it is sent.
test a_replayed_payout_can_never_pass_the_ceiling {
  assert allowed_credit(250, 0) == 250;
  assert allowed_credit(250, 250) == 50;
  assert allowed_credit(250, PER_SOURCE_WINDOW_CAP) == 0;
}

test the_per_call_ceiling_admits_one_through_a_million {
  assert amount_passes_per_call_ceiling(1) == true;
  assert amount_passes_per_call_ceiling(MAX_STARS_PER_CALL) == true;
  assert amount_passes_per_call_ceiling(0) == false;
  assert amount_passes_per_call_ceiling(-1) == false;
  assert amount_passes_per_call_ceiling(MAX_STARS_PER_CALL + 1) == false;
  assert MAX_STARS_PER_CALL / PER_SOURCE_WINDOW_CAP == 3333;
}

test the_idempotency_key_length_bound_is_the_column_width {
  assert external_tx_id_length_is_legal(0) == false;
  assert external_tx_id_length_is_legal(1) == true;
  assert external_tx_id_length_is_legal(EXTERNAL_TX_ID_MAX_LEN) == true;
  assert external_tx_id_length_is_legal(EXTERNAL_TX_ID_MAX_LEN + 1) == false;
}

test an_over_ceiling_request_is_trimmed_and_never_refused {
  assert star_award_outcome(50, false, true, 0) == AWARD_CREDITED_IN_FULL;
  assert star_award_outcome(100, false, true, 270) == AWARD_CREDITED_TRIMMED;
  assert star_award_outcome(100, false, true, PER_SOURCE_WINDOW_CAP) == AWARD_ACCEPTED_UNCREDITED;
  assert award_call_is_http_success(AWARD_CREDITED_TRIMMED) == true;
  assert award_call_is_http_success(AWARD_ACCEPTED_UNCREDITED) == true;
}

test only_a_malformed_amount_is_refused_by_this_algebra {
  assert star_award_outcome(0, false, true, 0) == AWARD_REFUSED_BAD_AMOUNT;
  assert star_award_outcome(-5, false, true, 0) == AWARD_REFUSED_BAD_AMOUNT;
  assert star_award_outcome(MAX_STARS_PER_CALL + 1, false, true, 0) == AWARD_REFUSED_BAD_AMOUNT;
  assert award_call_is_http_success(AWARD_REFUSED_BAD_AMOUNT) == false;
  assert award_call_is_http_success(AWARD_OUTCOME_UNSET) == false;
  assert THE_ALGEBRA_ASSUMES_A_WELL_FORMED_REQUEST == true;
  assert THE_ENDPOINT_HAS_REFUSALS_THIS_ALGEBRA_DOES_NOT_MODEL == true;
  assert external_tx_id_length_is_legal(0) == false;
}

; The amount gate runs before the replay gate, and the replay gate before the cap lookup.
test the_gate_order_is_amount_then_replay_then_cap {
  assert star_award_outcome(0, true, true, 0) == AWARD_REFUSED_BAD_AMOUNT;
  assert star_award_outcome(100, true, true, PER_SOURCE_WINDOW_CAP) == AWARD_REPLAY_RETURNS_PRIOR;
  assert star_award_outcome(100, true, false, 0) == AWARD_REPLAY_RETURNS_PRIOR;
}

test an_uncapped_source_passes_through_untrimmed {
  assert star_award_outcome(5000, false, false, 0) == AWARD_CREDITED_IN_FULL;
  assert star_award_outcome(MAX_STARS_PER_CALL, false, false, PER_SOURCE_WINDOW_CAP) == AWARD_CREDITED_IN_FULL;
  assert NO_CAP_ON_A_MANUAL_CREDIT_OR_REFUND == true;
}

test a_partial_trim_is_not_signalled_to_the_caller {
  assert caller_can_observe_the_trim(AWARD_ACCEPTED_UNCREDITED) == true;
  assert caller_can_observe_the_trim(AWARD_CREDITED_TRIMMED) == false;
  assert caller_can_observe_the_trim(AWARD_CREDITED_IN_FULL) == false;
  assert CAPPED_FLAG_IS_SET_ONLY_WHEN_NOTHING_IS_CREDITED == true;
  assert SUCCESS_BODY_ECHOES_THE_REQUESTED_AMOUNT == true;
  assert SUCCESS_BODY_ALSO_CARRIES_THE_NEW_BALANCE == true;
  assert PARTIAL_TRIM_IS_NOT_SIGNALLED_ON_THE_WIRE == true;
}

test the_reuse_edges_are_named_and_distinct {
  assert REUSES_RIDE_RUNTIME_ID == "turbobaby/ride-runtime";
  assert REUSES_COMMERCE_ID == "turbobaby/commerce";
  assert REUSES_MARKET_PROFILE_ID == "turbobaby/market";
  assert REUSES_RIDE_RUNTIME_ID != ID;
  assert REUSES_COMMERCE_ID != ID;
  assert REUSES_MARKET_PROFILE_ID != ID;
  assert REUSES_RIDE_RUNTIME_ID != REUSES_COMMERCE_ID;
  assert REUSES_COMMERCE_ID != REUSES_MARKET_PROFILE_ID;
}

; The score side of the graph. game_score.t27 names this file as the payout owner; this assertion
; is the other half of that edge, so neither side can be deleted without a test going red.
test the_score_ledger_edge_is_named_from_this_side_too {
  assert REUSES_GAME_SCORE_ID == "turbobaby/game-score";
  assert REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity";
  assert REUSES_GAME_SCORE_ID != ID;
  assert REUSES_REQUEST_IDENTITY_ID != ID;
  assert REUSES_GAME_SCORE_ID != REUSES_RIDE_RUNTIME_ID;
  assert HIGH_SCORE_TABLE_IS_OWNED_HERE == false;
  assert GAME_DISCRIMINATOR_IS_OWNED_HERE == false;
}

; The credit ceiling and the spend ceiling are two constants, not one. If a later reader collapses
; them, this test is what goes red.
test the_spend_ceiling_belongs_to_another_contract {
  assert REUSES_ORDER_MONEY_ID == "turbobaby/order-money";
  assert REUSES_ORDER_MONEY_ID != ID;
  assert REUSES_ORDER_MONEY_ID != REUSES_COMMERCE_ID;
  assert THE_SPEND_CEILING_IS_A_DIFFERENT_CONSTANT_AT_THE_SAME_MAGNITUDE == true;
  assert THIS_FILE_OWNS_AN_ORDER_TOTAL == false;
}

test the_refusals_are_declared_rather_than_filled_in {
  assert HIGH_SCORE_TABLE_IS_OWNED_HERE == false;
  assert GAME_DISCRIMINATOR_IS_OWNED_HERE == false;
  assert THIS_FILE_PUBLISHES_AN_EXCHANGE_RATE == false;
  assert THIS_FILE_CONVERTS_BETWEEN_CURRENCIES == false;
  assert THIS_FILE_EMITS_A_CLIENT_PRICE == false;
  assert THIS_FILE_OWNS_AN_ORDER_TOTAL == false;
  assert PERSON_LEVEL_FIELDS_CARRIED.len == 0;
}

; A refusal that points somewhere is only as good as the somewhere. This file declines to
; re-measure the discriminator absence and defers to game-score for it, so the deferral itself is
; pinned: the owner's ID, the declaration that carries the zero, and the count of contracts that
; carry it. Re-measured 2026-09-21. If the owner ever drops GAME_KEY_OCCURRENCES, the refusal
; above stops naming anything and this is the test that says so.
test the_deferred_absence_still_has_an_owner_and_a_declaration {
  assert ABSENCE_OWNER_CHECKED_AT == "2026-09-21";
  assert GAME_DISCRIMINATOR_ABSENCE_DECLARATION == "GAME_KEY_OCCURRENCES";
  assert CONTRACTS_DECLARING_THE_DISCRIMINATOR_ABSENCE == 1;
  assert REUSES_GAME_SCORE_ID == "turbobaby/game-score";
  assert GAME_DISCRIMINATOR_IS_OWNED_HERE == false;
  assert HIGH_SCORE_TABLE_IS_OWNED_HERE == false;
  ; One owner, and it is not this file: the deferral would be circular otherwise.
  assert REUSES_GAME_SCORE_ID != ID;
  assert CONTRACTS_DECLARING_THE_DISCRIMINATOR_ABSENCE == 1;
}

; --- Invariants --------------------------------------------------------------------------------

invariant the_capped_set_length_is_the_permission
  assert CAPPED_SOURCES.len == CAPPED_SOURCE_COUNT

invariant dropping_the_retired_spelling_would_uncap_a_replay
  assert source_is_capped(RETAINED_LEGACY_SOURCE) == true and DROPPING_A_LEGACY_SPELLING_UNCAPS_A_REPLAY == true

invariant a_manual_credit_or_refund_is_never_trimmed
  assert source_is_capped("admin_grant") == false and source_is_capped("refund") == false

invariant the_window_remainder_is_never_negative
  assert window_remaining(PER_SOURCE_WINDOW_CAP + 999) == 0 and window_remaining(PER_SOURCE_WINDOW_CAP) == 0

invariant a_negative_history_cannot_become_extra_headroom
  assert window_remaining(-1000) == PER_SOURCE_WINDOW_CAP

invariant a_nonpositive_request_can_never_be_credited
  assert allowed_credit(0, 0) == 0 and allowed_credit(-500, 0) == 0

invariant the_nonpositive_trio_branch_is_unreachable_on_the_shipped_path
  assert amount_passes_per_call_ceiling(0) == false and THE_ENDPOINT_REFUSES_A_NONPOSITIVE_AMOUNT_BEFORE_THE_TRIO_SEES_IT == true and ANOTHER_CALLER_OF_THE_TRIO_IS_NOT_SHIPPED == true and TRIO_CALL_SITE_COUNT == 1

invariant no_single_payout_can_exceed_the_window_cap
  assert allowed_credit(MAX_STARS_PER_CALL, 0) == PER_SOURCE_WINDOW_CAP

invariant the_per_call_ceiling_alone_cannot_bound_a_game_payout
  assert MAX_STARS_PER_CALL > PER_SOURCE_WINDOW_CAP

invariant the_window_bound_is_per_source_and_not_per_player
  assert REACHABLE_WINDOW_TOTAL_STARS == PER_SOURCE_WINDOW_CAP * 4

invariant a_player_at_the_ceiling_still_finishes_the_run
  assert star_award_outcome(10, false, true, PER_SOURCE_WINDOW_CAP) == AWARD_ACCEPTED_UNCREDITED and award_call_is_http_success(AWARD_ACCEPTED_UNCREDITED) == true

invariant an_over_ceiling_request_is_trimmed_and_not_refused
  assert star_award_outcome(100, false, true, 270) == AWARD_CREDITED_TRIMMED and award_call_is_http_success(AWARD_CREDITED_TRIMMED) == true

invariant a_malformed_amount_is_the_only_refusal_this_algebra_returns
  assert award_call_is_http_success(AWARD_REFUSED_BAD_AMOUNT) == false and award_call_is_http_success(AWARD_CREDITED_IN_FULL) == true and award_call_is_http_success(AWARD_REPLAY_RETURNS_PRIOR) == true and THE_ENDPOINT_HAS_REFUSALS_THIS_ALGEBRA_DOES_NOT_MODEL == true

invariant a_replay_is_answered_before_the_window_is_read
  assert star_award_outcome(100, true, true, PER_SOURCE_WINDOW_CAP) == AWARD_REPLAY_RETURNS_PRIOR

invariant an_unknown_outcome_is_not_a_success
  assert award_call_is_http_success(AWARD_OUTCOME_UNSET) == false

invariant the_outcome_codes_are_contiguous_and_counted
  assert AWARD_OUTCOME_UNSET == 0 and AWARD_OUTCOME_COUNT == 5 and AWARD_ACCEPTED_UNCREDITED == AWARD_OUTCOME_COUNT

invariant the_server_owner_ride_runtime_points_at_is_this_file
  assert RIDE_RUNTIME_DECLARES_A_SERVER_OWNER == true and THIS_FILE_IS_THAT_SERVER_OWNER == true and REUSES_RIDE_RUNTIME_ID == "turbobaby/ride-runtime"

invariant the_idempotency_decision_set_is_not_restated_here
  assert THIS_FILE_RESTATES_THE_IDEMPOTENCY_DECISION_SET == false and REUSES_COMMERCE_ID == "turbobaby/commerce"

invariant no_exchange_rate_or_conversion_enters_this_contract
  assert THIS_FILE_PUBLISHES_AN_EXCHANGE_RATE == false and THIS_FILE_CONVERTS_BETWEEN_CURRENCIES == false and REUSES_MARKET_PROFILE_ID == "turbobaby/market"

invariant no_client_price_and_no_order_total_enter_this_contract
  assert THIS_FILE_EMITS_A_CLIENT_PRICE == false and THIS_FILE_OWNS_AN_ORDER_TOTAL == false and REUSES_ORDER_MONEY_ID == "turbobaby/order-money"

invariant the_credit_ceiling_is_not_the_spend_ceiling
  assert THE_SPEND_CEILING_IS_A_DIFFERENT_CONSTANT_AT_THE_SAME_MAGNITUDE == true and MAX_STARS_PER_CALL == 1000000

invariant no_person_level_field_enters_this_contract
  assert PERSON_LEVEL_FIELDS_CARRIED.len == 0

invariant the_score_ledger_and_its_discriminator_belong_to_another_contract
  assert HIGH_SCORE_TABLE_IS_OWNED_HERE == false and GAME_DISCRIMINATOR_IS_OWNED_HERE == false and REUSES_GAME_SCORE_ID == "turbobaby/game-score"
