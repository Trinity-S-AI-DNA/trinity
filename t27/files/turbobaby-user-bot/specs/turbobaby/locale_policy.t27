; --- The parity gate, as measured rather than as reported -------------------------------------
pub const KEY_PARITY_IS_GATED : bool = true;
pub const PARITY_GATE_COUNT : u8 = 2;
pub const PARITY_GATE_PRIMARY : str = "src/trios/i18n.rs:2332 every_declared_key_has_a_russian_and_an_english_translation";
pub const PARITY_GATE_SECOND : str = "src/trios/i18n.rs:2374 every_translation_key_is_translated_in_ru_and_en";
; A cargo test, not a compiler check: the arms are a match, and a match with a catch-all is
; exhaustive whether or not any given key reaches an arm of its own. Nothing about a missing arm
; is visible to rustc.
pub const PARITY_GATE_IS_A_TEST_NOT_A_COMPILER_CHECK : bool = true;
pub const PARITY_GATE_LIMITATION : str = "Stated by the gate itself at src/trios/i18n.rs:2326-2330: has_translation compares the lookup result to the key, so a translation whose text equalled its own key would read as missing. The failure direction is a false alarm, never a silent pass.";
; Both gates read the declarations rather than a second hand-written list, and both carry a
; floor whose only job is to fail loudly if the parser stops matching. A floor is a tripwire,
; not a census: the real count sits far above it on purpose.
pub const PARITY_PARSER_FLOOR_PRIMARY : u16 = 450;
pub const PARITY_PARSER_FLOOR_SECOND : u16 = 90;
; The gates real blind spot, which is not the limitation they state: they walk DECLARED keys, so
; an undeclared literal passed straight to t() is outside their reach.
pub const PARITY_GATE_WALKS_DECLARED_KEYS_ONLY : bool = true;
pub const UNDECLARED_LITERAL_WITNESS : str = "src/trios/i18n.rs:2222-2226 test_translation_fallback asserts an unknown key comes back as itself";

; --- The second translated surface, gated differently ------------------------------------------
; src/locales.rs:4-103 declares Locale with 82 String fields, and src/locales.rs:142 ru() and
; src/locales.rs:231 en() are plain struct literals with no Default spread, so rustc refuses to
; compile either one with a field missing. Same problem, opposite gate: this surface cannot
; drift silently, the key surface can, and only the key surface needed a test written for it.
pub const STRUCT_SURFACE : str = "src/locales.rs:4-103 Locale";
pub const STRUCT_SURFACE_FIELD_COUNT : u16 = 82;
; RE-MEASURED 2026-09-25: 78. Four fields left the struct that day -- the retired carousel's
; heading and its two arrows, and the old shop's unit of sale -- on the owner's ruling that nothing
; cannabis-related may appear anywhere (turbobaby/legacy-retirement, OWNER_RULING_2026_09_25_AT).
; The 82 above is kept as the reading it was. Each removed field was replaced in the struct and in
; both constructors by a comment of the same number of lines, so every src/locales.rs line this
; corpus cites still points where it did; the compiler still refuses a constructor with a field
; missing, which is what made the removal safe.
pub const STRUCT_SURFACE_FIELD_COUNT_2026_09_25 : u16 = 78;
pub const STRUCT_SURFACE_FIELDS_REMOVED_2026_09_25 : u16 = 4;
; RE-MEASURED 2026-09-26: 77. One more field left on the same ruling: the retired garden's message
; for queued friend_watered rows, when turbobaby/notification-queue started holding rows of that
; kind unsent (HELD_KINDS_DECIDED_AT there). It was replaced in the struct and in both
; constructors the same way, by comment lines of the same count, so no citation into
; src/locales.rs moved.
pub const STRUCT_SURFACE_FIELD_COUNT_2026_09_26 : u16 = 77;
pub const STRUCT_SURFACE_FIELDS_REMOVED_2026_09_26 : u16 = 1;
pub const STRUCT_SURFACE_CONSTRUCTOR_COUNT : u8 = 2;
pub const STRUCT_SURFACE_PARITY_IS_COMPILER_ENFORCED : bool = true;

; --- The refusals, in structural form ------------------------------------------------------------
; Three empty arrays, each the prohibition its name states. An empty array cannot be argued with,
; and its length is asserted in an invariant, so filling it breaks the contract.
pub const TRANSLATED_STRINGS_PUBLISHED : [0]str = [];
pub const KEY_LITERALS_PUBLISHED : [0]str = [];
pub const NUMBER_FORMAT_FIELDS_PUBLISHED : [0]str = [];
pub const NUMBER_FORMAT_OWNER_NOTE : str = "Currency symbol code point, symbol placement, group and decimal separators and display exponent are fields of the market profile. Their owner is named by REUSES_MARKET_PROFILE_ID and not one of them is repeated here.";
; THE HONEST REFUSAL, re-measured 2026-09-21. D13 gives a staffing reason and not a
; distribution, and none of the 43 files in this corpus breaks the client dialogs down by
; language: a case-insensitive grep of specs/ for the three phrases a split would be written in
; returns three lines, and all three are in this file, saying what this paragraph says.
; The KB_faq figures the corpus does carry are split by TOPIC -- 710 dialogs and 31245 messages,
; split 481 term / 375 deposit / 180 availability -- and never by the language the client wrote
; in. Those figures belong to turbobaby/rental-terms, which states them in the WHY paragraph of
; its header and in no declaration; they are cited to that contract by name because there is no
; declaration name to cite, and a line number into a neighbour is what this file has just
; stopped depending on. Re-opened 2026-09-21: every figure above still reads as quoted there.
; So the share of clients who would read en, or th, or anything else is unmeasured here, and
; this file will not estimate it. Measuring it would need a per-language count over that dialog
; corpus, which lives outside this repository.
pub const PER_LANGUAGE_DEMAND_MEASUREMENT_IS_NOT_SHIPPED : bool = true;
pub const PER_LANGUAGE_SPLIT_FILES_IN_CORPUS : u8 = 0;
pub const CORPUS_FILES_SEARCHED : u8 = 43;
pub const PER_LANGUAGE_ABSENCE_REMEASURED_AT : str = "2026-09-21";
pub const TOPIC_SPLIT_OWNER_ID : str = "turbobaby/rental-terms";
pub const PER_LANGUAGE_DEMAND_NOTE : str = "D13 states a staffing fact, not a demand estimate. No file here counts clients or messages by language; the KB_faq figures in this corpus are split by topic. A third locale therefore has no measurement to argue from, in either direction.";
; THE SECOND HONEST REFUSAL. That an unpublished variant is REACHABLE is proved by the code path
; above. How often one is actually reached is a different question, and nothing in this
; repository counts it. The one place that emits the resolved value at all is src/lib.rs:84, a
; browser console line printed once per boot: it is not aggregated, not persisted and not read
; by anything, so it is an emission and not a count. No other telemetry, no structured log field
; and no column records the resolved locale of a served request; the stored column named above
; holds a preference, not the resolution of a request. A number here would report a measurement
; nobody took.
pub const UNPUBLISHED_VARIANT_TRAFFIC_IS_NOT_MEASURED : bool = true;
pub const UNPUBLISHED_VARIANT_TRAFFIC_NOTE : str = "Reachability is proved by the pick_lang path; frequency is counted nowhere in this repository. The gap is therefore a fact about the code, never a claim about customers.";

// ================================================================================================
// Predicates. Membership, resolution, and the two silences. Locale codes arrive as plain
// strings; any decision owned by another contract would arrive as a bool, never as a restated
// table.
// ================================================================================================

pub fn locale_is_published(code: str) bool {
  if (code == PUBLISHED_LOCALES[0]) {
    return true;
  }
  if (code == PUBLISHED_LOCALES[1]) {
    return true;
  }
  return false;
}

; Only one of the published pair may be primary, and D13 names which.
pub fn locale_may_be_primary(code: str) bool {
  return locale_is_published(code) and code == PRIMARY_LOCALE;
}

; The whole resolution rule, in the shape src/locales.rs:105-110 implements it: a published code
; resolves to itself, every other code resolves to the one fallback target.
pub fn resolved_target_is(code: str, target: str) bool {
  if (locale_is_published(code)) {
    return target == code;
  }
  return target == FALLBACK_LOCALE;
}

; Totality is a property of the CATCH-ALL ARM, not of the code being asked about. A resolver
; without one leaves an unpublished code unresolved, and this states which of the two facts is
; doing the work.
pub fn resolution_is_total(has_catch_all_arm: bool, code_is_published: bool) bool {
  return has_catch_all_arm or code_is_published;
}

; The gap, computed from the two counts rather than stored as a third number. Guarded for the
; case where the published set outgrows the enumerated one, which would make the difference
; meaningless rather than negative.
pub fn enumerated_variant_gap(enumerated: u8, published: u8) u8 {
  if (enumerated <= published) {
    return 0;
  }
  return enumerated - published;
}

pub fn published_set_admits_a_third(count: u8) bool {
  return count > PUBLISHED_LOCALE_COUNT;
}

pub fn defaults_agree(web_default: str, storage_default: str) bool {
  return web_default == storage_default;
}

; The web half's failure mode: a payload labelled with a locale whose text came from the fallback
; table. A published label always agrees with itself; an unpublished label agrees only if the
; text did NOT come from the fallback table, which in this repository it always does.
pub fn label_and_text_agree(label_locale_is_published: bool, text_table_is_fallback: bool) bool {
  if (label_locale_is_published) {
    return true;
  }
  return !text_table_is_fallback;
}

; A lookup renders the raw identifier whenever the table has no arm for it, declared or not.
pub fn renders_raw_identifier(table_has_arm: bool) bool {
  return !table_has_arm;
}

pub fn parity_gate_covers(key_is_declared: bool) bool {
  return key_is_declared;
}

; The one case that still reaches a customer unseen: no arm AND no declaration, so the raw render
; happens and no gate was ever going to look. A declared key with no arm renders raw too, but a
; gate fails first.
pub fn silent_raw_render_is_possible(key_is_declared: bool, table_has_arm: bool) bool {
  return renders_raw_identifier(table_has_arm) and !parity_gate_covers(key_is_declared);
}

// ================================================================================================
// Tests
// ================================================================================================

test the_published_set_is_two_and_names_its_source {
  assert PUBLISHED_LOCALES.len == PUBLISHED_LOCALE_COUNT;
  assert PUBLISHED_LOCALE_COUNT == 2;
  assert PUBLISHED_LOCALES[0] == PRIMARY_LOCALE;
  assert PUBLISHED_LOCALES[1] == FALLBACK_LOCALE;
  assert PRIMARY_LOCALE != FALLBACK_LOCALE;
  assert locale_is_published(PRIMARY_LOCALE) == true;
  assert locale_is_published(FALLBACK_LOCALE) == true;
  assert PUBLISHED_SET_SOURCE == "src/locales.rs:119-121 supported_langs";
}

// The overlap, asserted. A reviewer grepping this corpus for a restated table will find the two
// codes twice; this test is the answer to that grep, and it fails the day someone decides one
// file may read its set off the other.
test the_shared_value_is_a_coincidence_of_two_measurements_and_not_an_inheritance {
  assert MARKET_LANGUAGE_FIELD == "turbobaby/market TH_LANGUAGES";
  assert PUBLISHED_SET_IS_INHERITED_FROM_THE_MARKET == false;
  assert SETS_COINCIDE_TODAY == true;
  assert PUBLISHED_SET_SOURCE != MARKET_LANGUAGE_FIELD;
  assert REUSES_MARKET_PROFILE_ID == "turbobaby/market";
  assert PUBLISHED_LOCALE_COUNT == 2;
}

; The count above is not this file's to own. This test fails the day the copy stops naming its
; owner. Since 2026-09-24 the owner is the schema census and not the pricing contract, so the edge
; no longer coincides with the reuse edge to pricing-honesty, and the test says that too.
test the_migration_count_is_carried_as_a_copy_and_its_owner_is_named {
  assert MIGRATION_FILES_SEARCHED == 90;
  assert MIGRATION_FILES_SEARCHED == MIGRATION_FILES_SEARCHED_BEFORE_089 + 1;
  assert MIGRATION_FILES_SEARCHED_BEFORE_089 == MIGRATION_FILES_SEARCHED_BEFORE_088 + 1;
  assert MIGRATION_FILES_SEARCHED_BEFORE_088 == MIGRATION_FILES_SEARCHED_BEFORE_087 + 1;
  assert MIGRATION_COUNT_IS_A_COPY == true;
  assert MIGRATION_COUNT_OWNER_ID == "turbobaby/schema-provenance";
  assert MIGRATION_COUNT_OWNER_DECL == "SQL_FILES_RECURSIVE";
  assert MIGRATION_COUNT_OWNER_ID != REUSES_PRICING_HONESTY_ID;
  assert MIGRATION_COUNT_OWNER_ID_BEFORE_2026_09_24 == REUSES_PRICING_HONESTY_ID;
  assert MIGRATION_COUNT_OWNER_DECL_BEFORE_2026_09_24 == "MIGRATION_FILES_SEARCHED";
  assert MIGRATION_COUNT_OWNER_ID != ID;
  assert MIGRATION_COUNT_REMEASURED_AT == "2026-09-24";
  assert MIGRATION_COUNT_OWNER_REPOINTED_AT == "2026-09-24";
}

; The absence, re-measured rather than inherited. A false absence is the one claim a reader
; trusts without checking, so the count it rests on is declared and the date with it.
test no_file_in_this_corpus_splits_the_dialogs_by_language {
  assert PER_LANGUAGE_SPLIT_FILES_IN_CORPUS == 0;
  assert CORPUS_FILES_SEARCHED == 43;
  assert PER_LANGUAGE_DEMAND_MEASUREMENT_IS_NOT_SHIPPED == true;
  assert PER_LANGUAGE_ABSENCE_REMEASURED_AT == "2026-09-21";
  assert TOPIC_SPLIT_OWNER_ID == "turbobaby/rental-terms";
  assert TOPIC_SPLIT_OWNER_ID != ID;
}

test only_the_primary_may_be_primary {
  assert locale_may_be_primary(PRIMARY_LOCALE) == true;
  assert locale_may_be_primary(FALLBACK_LOCALE) == false;
  assert locale_may_be_primary("th") == false;
  assert locale_may_be_primary("") == false;
  assert PRIMARY_LOCALE_DECISION == "DECISIONS.md:181-184 D13";
}

// The six enumerated variants that are not published, plus one code the enum does not carry at
// all (ar, produced by src/locales.rs:137) and the empty string.
test an_unpublished_code_is_refused_membership {
  assert locale_is_published("th") == false;
  assert locale_is_published("zh") == false;
  assert locale_is_published("he") == false;
  assert locale_is_published("de") == false;
  assert locale_is_published("fr") == false;
  assert locale_is_published("es") == false;
  assert locale_is_published("ar") == false;
  assert locale_is_published("") == false;
}

test every_code_resolves_and_an_unpublished_one_resolves_to_english {
  assert resolved_target_is(PRIMARY_LOCALE, PRIMARY_LOCALE) == true;
  assert resolved_target_is(FALLBACK_LOCALE, FALLBACK_LOCALE) == true;
  assert resolved_target_is("th", FALLBACK_LOCALE) == true;
  assert resolved_target_is("zh", FALLBACK_LOCALE) == true;
  assert resolved_target_is("klingon", FALLBACK_LOCALE) == true;
  assert resolved_target_is("", FALLBACK_LOCALE) == true;
  assert resolved_target_is("th", PRIMARY_LOCALE) == false;
  assert resolved_target_is(PRIMARY_LOCALE, FALLBACK_LOCALE) == false;
}

test resolution_is_total_only_because_the_resolver_has_a_catch_all {
  assert BOT_RESOLVER_HAS_CATCH_ALL_ARM == true;
  assert BOT_RESOLVER_COLLAPSES_UNPUBLISHED == true;
  assert resolution_is_total(true, false) == true;
  assert resolution_is_total(true, true) == true;
  assert resolution_is_total(false, true) == true;
  assert resolution_is_total(false, false) == false;
}

test the_gap_between_the_published_set_and_the_enumerated_variants {
  assert ENUMERATED_VARIANT_COUNT == 8;
  assert VARIANTS_WITH_OWN_TABLE == 2;
  assert VARIANTS_FALLING_THROUGH_TO_ENGLISH == 6;
  assert VARIANTS_WITH_OWN_TABLE + VARIANTS_FALLING_THROUGH_TO_ENGLISH == ENUMERATED_VARIANT_COUNT;
  // The gap equals the fall-through count for a reason, and the reason is the next line: the
  // variants that own a table are exactly the variants the shop publishes. Two measurements,
  // one from src/locales.rs and one from src/trios/i18n.rs, and today they agree.
  assert VARIANTS_WITH_OWN_TABLE == PUBLISHED_LOCALE_COUNT;
  assert enumerated_variant_gap(ENUMERATED_VARIANT_COUNT, PUBLISHED_LOCALE_COUNT) == VARIANTS_FALLING_THROUGH_TO_ENGLISH;
  assert enumerated_variant_gap(2, 2) == 0;
  assert enumerated_variant_gap(1, 2) == 0;
}

test the_web_layer_keeps_the_variant_and_the_bot_layer_does_not {
  assert WEB_RESOLVER_KEEPS_UNPUBLISHED_VARIANT == true;
  assert BOT_RESOLVER_COLLAPSES_UNPUBLISHED == true;
  assert label_and_text_agree(true, true) == true;
  assert label_and_text_agree(true, false) == true;
  assert label_and_text_agree(false, true) == false;
  assert label_and_text_agree(false, false) == true;
}

// The shape is modelled above; this test says it is not reached, so no reader takes the model
// for a customer-facing fact. The two live on different lines on purpose.
test the_mislabelled_payload_is_a_shape_in_the_code_and_not_a_shipped_fact {
  assert MISLABELLED_PAYLOAD_IS_NOT_SHIPPED == true;
  assert WEB_LABEL_SITE == "src/trios/i18n.rs:1951 get_translations, stamping Translations.lang at src/trios/i18n.rs:2174-2176";
  assert WEB_LABEL_SITE != WEB_RESOLVER_LIVE_CALL_SITES;
  assert WEB_UNPUBLISHED_RENDERS_ENGLISH_AT != WEB_LABEL_SITE;
  assert label_and_text_agree(false, true) == false;
}

test the_two_defaults_do_not_agree {
  assert WEB_DEFAULT_LOCALE == PRIMARY_LOCALE;
  assert STORAGE_DEFAULT_LOCALE == FALLBACK_LOCALE;
  assert defaults_agree(WEB_DEFAULT_LOCALE, STORAGE_DEFAULT_LOCALE) == false;
  assert defaults_agree(PRIMARY_LOCALE, PRIMARY_LOCALE) == true;
  assert DEFAULTS_AGREE == false;
  assert STORAGE_CONSTRAINS_THE_PUBLISHED_SET == false;
  assert MIGRATION_FILES_SEARCHED == 90;
}

test a_missing_arm_renders_the_identifier_and_only_a_test_catches_it {
  assert TABLES_END_WITH_BARE_KEY_FALLBACK == true;
  assert BARE_KEY_FALLBACK_SITES.len == TRANSLATION_TABLE_COUNT;
  assert BARE_KEY_FALLBACK_SITES[0] == "src/trios/i18n.rs:1330";
  assert BARE_KEY_FALLBACK_SITES[1] == "src/trios/i18n.rs:1930";
  assert MISSING_ARM_FAILS_THE_BUILD == false;
  assert renders_raw_identifier(false) == true;
  assert renders_raw_identifier(true) == false;
  assert silent_raw_render_is_possible(true, false) == false;
  assert silent_raw_render_is_possible(true, true) == false;
  assert silent_raw_render_is_possible(false, true) == false;
}

// The correction, asserted rather than merely written in the header.
test key_parity_is_gated_and_this_file_names_the_gates {
  assert KEY_PARITY_IS_GATED == true;
  assert PARITY_GATE_COUNT == 2;
  assert PARITY_GATE_PRIMARY == "src/trios/i18n.rs:2332 every_declared_key_has_a_russian_and_an_english_translation";
  assert PARITY_GATE_SECOND == "src/trios/i18n.rs:2374 every_translation_key_is_translated_in_ru_and_en";
  assert PARITY_GATE_PRIMARY != PARITY_GATE_SECOND;
  assert PARITY_GATE_IS_A_TEST_NOT_A_COMPILER_CHECK == true;
  assert TRANSLATION_KEY_COUNT > PARITY_PARSER_FLOOR_PRIMARY;
  assert TRANSLATION_KEY_COUNT > PARITY_PARSER_FLOOR_SECOND;
  assert PARITY_PARSER_FLOOR_PRIMARY > PARITY_PARSER_FLOOR_SECOND;
}

test the_gates_blind_spot_is_the_undeclared_literal_not_the_limit_they_state {
  assert PARITY_GATE_WALKS_DECLARED_KEYS_ONLY == true;
  assert parity_gate_covers(true) == true;
  assert parity_gate_covers(false) == false;
  assert silent_raw_render_is_possible(false, false) == true;
  assert silent_raw_render_is_possible(true, false) == false;
  assert UNDECLARED_LITERAL_WITNESS == "src/trios/i18n.rs:2222-2226 test_translation_fallback asserts an unknown key comes back as itself";
}

test the_key_count_is_the_declaration_count_and_not_the_grep_count {
  // 565 and 570 until 2026-09-25, when the cancel key added one, the owner's ruling #12
  // deleted fourteen, answer 5 of the owner's second list that day deleted one more, the
  // removal of the 20+ box (answer 1 of that list) deleted five more, and his answer 3 added one;
  // on 2026-09-26 his answer to question I deleted the Book control's two count reasons, and 19
  // keys of cannabis-era copy no mounted screen printed went the same day. His answer R3 that
  // day retired seven referral keys and declared four, and his answer on the referral top list
  // the same day retired the four keys only that list used.
  assert TRANSLATION_KEY_COUNT == 519;
  assert NAIVE_GREP_COUNT == 524;
  assert TRANSLATION_KEY_COUNT_BEFORE_THE_TOP_LIST_ANSWER == 523;
  assert NAIVE_GREP_COUNT_BEFORE_THE_TOP_LIST_ANSWER == 528;
  assert TRANSLATION_KEY_COUNT_BEFORE_2026_09_26_R3 == 526;
  assert NAIVE_GREP_COUNT_BEFORE_2026_09_26_R3 == 531;
  assert TRANSLATION_KEY_COUNT_BEFORE_2026_09_25 == 565;
  assert NAIVE_GREP_COUNT_BEFORE_2026_09_25 == 570;
  assert TRANSLATION_KEY_COUNT_BEFORE_2026_09_25 + KEYS_ADDED_2026_09_25 - KEYS_DELETED_2026_09_25 - KEYS_DELETED_BY_SECOND_LIST_ANSWER_5 - KEYS_DELETED_2026_09_25_AGE_GATE - KEYS_DELETED_2026_09_26_QUESTION_I - KEYS_DELETED_2026_09_26_LEFTOVERS == TRANSLATION_KEY_COUNT_BEFORE_2026_09_26_R3;
  assert NAIVE_GREP_COUNT_BEFORE_2026_09_25 + KEYS_ADDED_2026_09_25 - KEYS_DELETED_2026_09_25 - KEYS_DELETED_BY_SECOND_LIST_ANSWER_5 - KEYS_DELETED_2026_09_25_AGE_GATE - KEYS_DELETED_2026_09_26_QUESTION_I - KEYS_DELETED_2026_09_26_LEFTOVERS == NAIVE_GREP_COUNT_BEFORE_2026_09_26_R3;
  assert TRANSLATION_KEY_COUNT_BEFORE_2026_09_26_R3 + KEYS_ADDED_2026_09_26_R3 - KEYS_DELETED_2026_09_26_R3 == TRANSLATION_KEY_COUNT_BEFORE_THE_TOP_LIST_ANSWER;
  assert NAIVE_GREP_COUNT_BEFORE_2026_09_26_R3 + KEYS_ADDED_2026_09_26_R3 - KEYS_DELETED_2026_09_26_R3 == NAIVE_GREP_COUNT_BEFORE_THE_TOP_LIST_ANSWER;
  assert TRANSLATION_KEY_COUNT_BEFORE_THE_TOP_LIST_ANSWER - KEYS_DELETED_2026_09_26_TOP_LIST == TRANSLATION_KEY_COUNT;
  assert NAIVE_GREP_COUNT_BEFORE_THE_TOP_LIST_ANSWER - KEYS_DELETED_2026_09_26_TOP_LIST == NAIVE_GREP_COUNT;
  assert KEYS_DELETED_2026_09_26_TOP_LIST == 4;
  assert KEYS_DELETED_2026_09_26_TOP_LIST_RECORDED_BY_ID == "turbobaby/referral-program";
  assert KEYS_DELETED_2026_09_26_TOP_LIST_RECORDED_BY_ID != ID;
  assert KEYS_DELETED_2026_09_26_TOP_LIST_WITNESS == "src/trios/i18n.rs the_referral_top_list_keys_stay_retired";
  assert KEYS_DELETED_2026_09_26_R3 == 7;
  assert KEYS_ADDED_2026_09_26_R3 == 4;
  assert KEYS_ADDED_2026_09_26_R3 < KEYS_DELETED_2026_09_26_R3;
  assert KEYS_2026_09_26_R3_AT == "2026-09-26";
  assert KEYS_ADDED_2026_09_26_R3_RECORDED_BY_ID == "turbobaby/referral-credit";
  assert KEYS_ADDED_2026_09_26_R3_RECORDED_BY_ID != ID;
  assert KEYS_DELETED_2026_09_26_R3_WITNESS == "src/trios/i18n.rs the_referral_keys_r3_retired_stay_retired";
  assert KEYS_DELETED_2026_09_25_RECORDED_BY_ID == "turbobaby/legacy-retirement";
  assert KEYS_DELETED_2026_09_25_RECORDED_BY_ID != ID;
  assert KEYS_DELETED_BY_SECOND_LIST_ANSWER_5 == 1;
  assert KEYS_DELETED_BY_SECOND_LIST_ANSWER_5_RECORDED_BY_ID == "turbobaby/availability";
  assert KEYS_DELETED_BY_SECOND_LIST_ANSWER_5_RECORDED_BY_ID != ID;
  assert KEYS_DELETED_2026_09_25_AGE_GATE == 5;
  assert KEYS_DELETED_2026_09_25_AGE_GATE_RECORDED_BY_ID == "turbobaby/checkout-contact";
  assert KEYS_DELETED_2026_09_25_AGE_GATE_RECORDED_BY_ID != ID;
  assert KEYS_DELETED_2026_09_26_QUESTION_I == 2;
  assert KEYS_DELETED_2026_09_26_QUESTION_I_RECORDED_BY_ID == "turbobaby/availability";
  assert KEYS_DELETED_2026_09_26_QUESTION_I_RECORDED_BY_ID != ID;
  assert KEYS_DELETED_2026_09_26_LEFTOVERS == 19;
  assert KEYS_DELETED_2026_09_26_LEFTOVERS_RECORDED_BY_ID == "turbobaby/legacy-retirement";
  assert KEYS_DELETED_2026_09_26_LEFTOVERS_RECORDED_BY_ID != ID;
  assert KEYS_ADDED_2026_09_25 == 2;
  assert KEYS_ADDED_2026_09_25_RECORDED_BY_ID == "turbobaby/client-errors";
  assert KEYS_ADDED_2026_09_25_RECORDED_BY_ID != ID;
  assert KEYS_ADDED_2026_09_25_SECOND_RECORDED_BY_ID == "turbobaby/order-presentation";
  assert KEYS_ADDED_2026_09_25_SECOND_RECORDED_BY_ID != ID;
  assert NAIVE_GREP_OVERCOUNT == 5;
  assert NAIVE_GREP_COUNT - TRANSLATION_KEY_COUNT == NAIVE_GREP_OVERCOUNT;
  assert NAIVE_GREP_COUNT > TRANSLATION_KEY_COUNT;
  assert TRANSLATION_TABLE_COUNT == 2;
}

test the_struct_surface_is_gated_by_the_compiler_and_the_key_surface_is_not {
  assert STRUCT_SURFACE_FIELD_COUNT == 82;
  assert STRUCT_SURFACE_CONSTRUCTOR_COUNT == TRANSLATION_TABLE_COUNT;
  assert STRUCT_SURFACE_PARITY_IS_COMPILER_ENFORCED == true;
  assert PARITY_GATE_IS_A_TEST_NOT_A_COMPILER_CHECK == true;
  assert STRUCT_SURFACE_FIELD_COUNT < TRANSLATION_KEY_COUNT;
}

test the_struct_surface_lost_four_fields_on_2026_09_25 {
  assert STRUCT_SURFACE_FIELD_COUNT_2026_09_25 == 78;
  assert STRUCT_SURFACE_FIELD_COUNT_2026_09_25 + STRUCT_SURFACE_FIELDS_REMOVED_2026_09_25 == STRUCT_SURFACE_FIELD_COUNT;
  assert STRUCT_SURFACE_PARITY_IS_COMPILER_ENFORCED == true;
}

test the_struct_surface_lost_one_more_field_on_2026_09_26 {
  assert STRUCT_SURFACE_FIELD_COUNT_2026_09_26 == 77;
  assert STRUCT_SURFACE_FIELD_COUNT_2026_09_26 + STRUCT_SURFACE_FIELDS_REMOVED_2026_09_26 == STRUCT_SURFACE_FIELD_COUNT_2026_09_25;
  assert STRUCT_SURFACE_FIELD_COUNT_2026_09_26 < STRUCT_SURFACE_FIELD_COUNT_2026_09_25;
}

test the_refusals_are_structural_and_not_prose {
  assert TRANSLATED_STRINGS_PUBLISHED.len == 0;
  assert KEY_LITERALS_PUBLISHED.len == 0;
  assert NUMBER_FORMAT_FIELDS_PUBLISHED.len == 0;
  assert PER_LANGUAGE_DEMAND_MEASUREMENT_IS_NOT_SHIPPED == true;
  assert UNPUBLISHED_VARIANT_TRAFFIC_IS_NOT_MEASURED == true;
  assert published_set_admits_a_third(PUBLISHED_LOCALE_COUNT) == false;
  assert published_set_admits_a_third(3) == true;
  assert published_set_admits_a_third(1) == false;
}

test the_ownership_edges_are_named_and_nothing_they_own_is_restated {
  assert REUSES_MARKET_PROFILE_ID == "turbobaby/market";
  assert REUSES_PRICING_HONESTY_ID == "turbobaby/pricing-honesty";
  assert REUSES_MARKET_PROFILE_ID != ID;
  assert REUSES_PRICING_HONESTY_ID != ID;
  assert REUSES_MARKET_PROFILE_ID != REUSES_PRICING_HONESTY_ID;
  assert ID == "turbobaby/locale-policy";
  assert KIND == "contract";
  assert DECISIONS.len == 2;
  assert DECISIONS[0] == "D13";
  assert DECISIONS[1] == "D14";
}

// ================================================================================================
// Invariants
// ================================================================================================

invariant the_shop_publishes_exactly_two_locales
  assert PUBLISHED_LOCALES.len == PUBLISHED_LOCALE_COUNT and PUBLISHED_LOCALE_COUNT == 2 and published_set_admits_a_third(PUBLISHED_LOCALE_COUNT) == false

invariant the_single_fallback_target_is_itself_published
  assert locale_is_published(FALLBACK_LOCALE) == true and FALLBACK_LOCALE != PRIMARY_LOCALE and locale_may_be_primary(FALLBACK_LOCALE) == false

invariant every_unpublished_code_resolves_to_the_one_fallback_target
  assert resolved_target_is("th", FALLBACK_LOCALE) == true and resolved_target_is("klingon", FALLBACK_LOCALE) == true and resolution_is_total(BOT_RESOLVER_HAS_CATCH_ALL_ARM, false) == true

invariant resolution_is_total_because_of_the_catch_all_and_for_no_other_reason
  assert resolution_is_total(false, false) == false and resolution_is_total(true, false) == true

invariant the_gap_is_computed_from_the_two_counts_and_is_never_a_third_number
  assert enumerated_variant_gap(ENUMERATED_VARIANT_COUNT, PUBLISHED_LOCALE_COUNT) == VARIANTS_FALLING_THROUGH_TO_ENGLISH and VARIANTS_WITH_OWN_TABLE + VARIANTS_FALLING_THROUGH_TO_ENGLISH == ENUMERATED_VARIANT_COUNT

invariant a_missing_arm_is_caught_by_a_test_and_never_by_the_build
  assert MISSING_ARM_FAILS_THE_BUILD == false and KEY_PARITY_IS_GATED == true and silent_raw_render_is_possible(true, false) == false

invariant only_an_undeclared_literal_can_still_render_raw_unseen
  assert silent_raw_render_is_possible(false, false) == true and PARITY_GATE_WALKS_DECLARED_KEYS_ONLY == true

invariant this_file_carries_no_translated_string_no_key_literal_and_no_number_format
  assert TRANSLATED_STRINGS_PUBLISHED.len == 0 and KEY_LITERALS_PUBLISHED.len == 0 and NUMBER_FORMAT_FIELDS_PUBLISHED.len == 0

invariant the_key_count_never_becomes_the_key_list
  assert TRANSLATION_KEY_COUNT == 519 and KEY_LITERALS_PUBLISHED.len == 0 and TRANSLATION_KEY_COUNT > PARITY_PARSER_FLOOR_PRIMARY

invariant the_two_defaults_disagree_until_one_of_them_is_changed
  assert defaults_agree(WEB_DEFAULT_LOCALE, STORAGE_DEFAULT_LOCALE) == false and DEFAULTS_AGREE == false

invariant an_unpublished_label_never_agrees_with_fallback_text
  assert label_and_text_agree(false, true) == false and label_and_text_agree(true, true) == true

invariant the_modelled_mislabel_is_never_reported_as_a_shipped_fact
  assert MISLABELLED_PAYLOAD_IS_NOT_SHIPPED == true and WEB_RESOLVER_KEEPS_UNPUBLISHED_VARIANT == true and WEB_LABEL_SITE != WEB_RESOLVER_LIVE_CALL_SITES

invariant the_market_language_fact_is_named_here_and_recomputed_nowhere
  assert REUSES_MARKET_PROFILE_ID == "turbobaby/market" and REUSES_MARKET_PROFILE_ID != ID

invariant the_published_set_is_measured_here_and_never_inherited_from_the_market
  assert PUBLISHED_SET_IS_INHERITED_FROM_THE_MARKET == false and PUBLISHED_SET_SOURCE != MARKET_LANGUAGE_FIELD

invariant the_unmeasured_demand_and_the_unmeasured_traffic_are_refused_rather_than_guessed
  assert PER_LANGUAGE_DEMAND_MEASUREMENT_IS_NOT_SHIPPED == true and UNPUBLISHED_VARIANT_TRAFFIC_IS_NOT_MEASURED == true
