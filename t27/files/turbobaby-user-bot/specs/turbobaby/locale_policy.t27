; src/trios/i18n.rs:1930 closes the English one. That is why a key with no arm is not a build
; failure -- t() returns the key, and the customer reads the raw dotted identifier where a
; sentence was meant to be.
pub const BARE_KEY_FALLBACK_SITES : [2]str = ["src/trios/i18n.rs:1330", "src/trios/i18n.rs:1930"];
