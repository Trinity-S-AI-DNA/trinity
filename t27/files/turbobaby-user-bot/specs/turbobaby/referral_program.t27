pub const LEDGER_MOVEMENTS_TOTAL_BEFORE_2026_09_26 : u8 = 10;
pub const THIS_DOMAINS_CREDITS_INSIDE_THE_PAIRED_SIX_BEFORE_2026_09_26 : u8 = 3;
pub const THIS_DOMAINS_CREDITS_AMONG_THE_BYPASSES : u8 = 0;
pub const LEDGER_OWNER_NAMES_THIS_CONTRACT_BACK : bool = true;
pub const LEDGER_AGREEMENT_CHECKED_AT : str = "2026-09-21";
pub const LEDGER_CITATION_IS_BY_ID_IN_BOTH_DIRECTIONS : bool = true;

pub fn ledger_contracts_agree(inside: u8, among_bypasses: u8, paired: u8, total: u8) bool {
  if (among_bypasses != 0) {
    return false;
  }
  return inside <= paired and paired <= total;
}
pub const STAR_AWARD_SUPPLIES : str = "the corpus precedent for a capped credit path -- a per-source rolling ceiling that trims rather than refuses, over a capped SET whose size is that owner's number and is not reproduced here. A referral credit has no equivalent ceiling, which is a fact about this file and not about that one.";
pub const REQUEST_IDENTITY_SUPPLIES : str = "who the caller is and what a failed proof means. That owner declares CONSUMERS as a closed snapshot, and as of 2026-09-21 this file IS named in it -- see the note below, which records that the answer was the opposite earlier the same day. This file records only which of its own five routes stands behind a gate, which that owner explicitly does not carry.";
pub const DEEPLINK_SUPPLIES : str = "the /start payload grammar in its link form, and REFERRAL_TRAVELS_AS_AN_OPAQUE_CODE -- the link-side statement that a referral travels as a code rather than as an identity. This file owns the mint that makes the code opaque, not the transport that carries it.";
pub const BOT_SURFACE_SUPPLIES : str = "start_records_a_referral -- the conjunction of prefix, length bound, referrer lookup and sender comparison that admits an incoming referral at the COMMAND layer. It arrives here as the single boolean start_admitted, and none of its four terms is restated as a term of this file. The self edge recurs here only as a SECOND guard at a second site, the data layer, which that owner does not measure.";
pub const NOTIFICATION_QUEUE_SUPPLIES : str = "the queued mail a referral produces -- the friend-joined row (and, until 2026-09-26, the friend-ordered and milestone rows, which that owner now holds), their kinds and their delivery. This file declares only where those enqueues sat relative to a money commit, and restates no kind, no markup, no retry and no table column.";
pub const REFERRAL_CREDIT_SUPPLIES : str = "what a referral earns since 2026-09-26 (R3): the rate, the rounding, the base, who is creditable, the holds, the settlement, the payout by hand and the THB ledger. This file consumes it as the answer to 'what does a referral pay' and restates none of it; it keeps the edge the credit is read from.";

