}

test the_ledger_agreement_is_pinned_in_both_directions {
  assert REUSES_LOYALTY_LEDGER_ID == "turbobaby/loyalty-ledger";
  assert LEDGER_PAIRED_MOVEMENTS == 3;
  assert LEDGER_MOVEMENTS_TOTAL == 7;
  assert THIS_DOMAINS_CREDITS_INSIDE_THE_PAIRED_SIX == 0;
  assert LEDGER_PAIRED_MOVEMENTS_BEFORE_2026_09_26 == 6;
  assert LEDGER_MOVEMENTS_TOTAL_BEFORE_2026_09_26 == 10;
  assert THIS_DOMAINS_CREDITS_INSIDE_THE_PAIRED_SIX_BEFORE_2026_09_26 == 3;
  assert LEDGER_PAIRED_MOVEMENTS_BEFORE_2026_09_26 - LEDGER_PAIRED_MOVEMENTS == THIS_DOMAINS_CREDITS_INSIDE_THE_PAIRED_SIX_BEFORE_2026_09_26;
  assert LEDGER_MOVEMENTS_TOTAL_BEFORE_2026_09_26 - LEDGER_MOVEMENTS_TOTAL == THIS_DOMAINS_CREDITS_INSIDE_THE_PAIRED_SIX_BEFORE_2026_09_26;
  assert ledger_contracts_agree(THIS_DOMAINS_CREDITS_INSIDE_THE_PAIRED_SIX_BEFORE_2026_09_26, THIS_DOMAINS_CREDITS_AMONG_THE_BYPASSES, LEDGER_PAIRED_MOVEMENTS_BEFORE_2026_09_26, LEDGER_MOVEMENTS_TOTAL_BEFORE_2026_09_26) == true;
  assert THIS_DOMAINS_CREDITS_AMONG_THE_BYPASSES == 0;
  assert LEDGER_OWNER_NAMES_THIS_CONTRACT_BACK == true;
  assert LEDGER_CITATION_IS_BY_ID_IN_BOTH_DIRECTIONS == true;
  assert LEDGER_AGREEMENT_CHECKED_AT == "2026-09-21";
  assert ledger_contracts_agree(THIS_DOMAINS_CREDITS_INSIDE_THE_PAIRED_SIX, THIS_DOMAINS_CREDITS_AMONG_THE_BYPASSES, LEDGER_PAIRED_MOVEMENTS, LEDGER_MOVEMENTS_TOTAL) == true;
  assert ledger_contracts_agree(3, 1, 6, 10) == false;
  assert ledger_contracts_agree(7, 0, 6, 10) == false;
}

