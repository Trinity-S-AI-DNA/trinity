test a_referral_settled_in_bonus_until_r3_and_never_in_stars {
  assert PAYS_IN_BONUS_CURRENCY_BEFORE_2026_09_26 == true;
  assert PAYS_IN_STARS == false;
  assert LEDGER_TX_TYPE_COUNT == 3;
  assert LEDGER_TX_TYPES[0] == "referral_bonus";
  assert LEDGER_TX_TYPES[1] == "referral_welcome";
  assert LEDGER_TX_TYPES[2] == "referral_milestone";
  assert EVERY_CREDIT_PAIRS_WITH_A_LEDGER_ROW == true;
  assert CREDITS_TO_THE_REFERRER == 2;
  assert CREDITS_TO_THE_INVITEE == 1;
  assert CREDITS_TO_THE_REFERRER + CREDITS_TO_THE_INVITEE == LEDGER_TX_TYPE_COUNT;
}

test the_welcome_credit_is_optional_and_the_amounts_are_arguments {
  assert welcome_credit_is_written(true, true) == true;
  assert welcome_credit_is_written(true, false) == false;
  assert welcome_credit_is_written(false, true) == false;
  assert AMOUNTS_ARRIVE_AS_ARGUMENTS == true;
  assert THIS_FILE_DECLARES_AN_AMOUNT == false;
}

test the_earnings_figure_is_the_per_referral_total_only {
  assert earnings_sum_includes(true) == true;
  assert earnings_sum_includes(false) == false;
  assert BONUS_PAID_COVERS_THE_PER_REFERRAL_CREDIT == true;
  assert BONUS_PAID_COVERS_THE_MILESTONE_CREDIT == false;
  assert EARNINGS_SUM_IS_THE_WHOLE_OF_WHAT_A_REFERRER_RECEIVED == false;
}

test the_ladder_is_three_rungs_counted_in_confirmed_referrals {
  assert MILESTONE_RUNG_COUNT == 3;
  assert MILESTONE_THRESHOLDS[0] == 1;
  assert MILESTONE_THRESHOLDS[1] == 3;
  assert MILESTONE_THRESHOLDS[2] == 5;
  assert milestone_reached(0, MILESTONE_THRESHOLDS[0]) == false;
  assert milestone_reached(1, MILESTONE_THRESHOLDS[0]) == true;
  assert milestone_reached(2, MILESTONE_THRESHOLDS[1]) == false;
  assert milestone_reached(3, MILESTONE_THRESHOLDS[1]) == true;
  assert milestone_reached(9, MILESTONE_THRESHOLDS[2]) == true;
}

test a_rung_pays_once_and_is_never_taken_back {
  assert milestone_award_is_written(true, false, true) == true;
  assert milestone_award_is_written(true, true, true) == false;
  assert milestone_award_is_written(false, false, true) == false;
  assert milestone_award_is_written(true, false, false) == false;
  assert milestones_held_after(2, true) == 3;
  assert milestones_held_after(2, false) == 2;
  assert MILESTONE_KEY_IS_THE_PAIR == true;
  assert MILESTONE_CAN_BE_AWARDED_TWICE == false;
  assert MILESTONE_CAN_BE_UN_AWARDED == false;
  assert MILESTONE_SURVIVES_A_SHRINKING_GRAPH == true;
}

test one_rung_has_three_prices_so_this_file_names_none {
  assert MILESTONE_AMOUNT_SOURCE_COUNT == 3;
  assert MILESTONE_AMOUNT_IS_DECLARED_HERE == false;
  assert THE_ROW_IS_THE_RECORD_OF_WHAT_WAS_PAID == true;
  assert THE_CONFIGURATION_IS_THE_RECORD_OF_WHAT_IS_OFFERED == true;
}

test a_rung_added_to_the_ladder_alone_is_offered_and_never_paid {
  assert DEFAULTS_CARRY_A_SECOND_COPY_OF_THE_LADDER == true;
  assert a_new_rung_can_be_offered_and_never_paid(true, false, false) == true;
  assert a_new_rung_can_be_offered_and_never_paid(true, true, false) == false;
  assert a_new_rung_can_be_offered_and_never_paid(true, false, true) == false;
  assert a_new_rung_can_be_offered_and_never_paid(false, false, false) == false;
}

test money_commits_before_any_notice_is_sent {
  assert MILESTONE_AWARD_IS_ONE_TRANSACTION == true;
  assert NOTICE_IS_SENT_AFTER_THE_COMMIT == true;
  assert A_FAILED_NOTICE_ROLLS_BACK_THE_CREDIT == false;
  assert MILESTONE_AWARD_IS_BEST_EFFORT_AT_ITS_CALL_SITE == true;
}

test the_assigned_arm_is_returned_to_the_client_and_stored_nowhere {
  assert SHARE_SOURCE_PRODUCTION_CALLERS == 1;
  assert EVENT_SOURCE_PRODUCTION_WRITERS == 1;
  assert EVENT_SOURCE_DISTINCT_PRODUCTION_VALUES == 1;
  assert experiment_arm_is_recoverable(ASSIGNED_ARM_IS_WRITTEN_TO_THE_EVENT, FUNNEL_METRIC_CARRIES_THE_ARM) == false;
  assert experiment_arm_is_recoverable(true, false) == true;
  assert experiment_arm_is_recoverable(false, true) == true;
}

test the_arm_is_stable_bounded_and_carries_no_identity {
  assert SHARE_SOURCE_IS_DETERMINISTIC == true;
  assert SHARE_SOURCE_DEPENDS_ON_THE_TELEGRAM_ID == true;
  assert SHARE_SOURCE_LEAKS_THE_TELEGRAM_ID == false;
  assert SHARE_SOURCE_FALLBACK == "default";
  assert CONFIGURED_LIST_CAN_BE_EMPTY_IN_PRODUCTION == false;
}

; The 2026-09-21 reading, kept as it was measured; the fifth route is admin-gated since the owner's
; answer of 2026-09-26 (the test after this one).
test four_routes_prove_the_subject_and_the_fifth_publishes_the_id {
  assert ROUTE_COUNT == 5;
  assert OWNER_GATED_ROUTE_COUNT == 4;
  assert UNGATED_ROUTE_COUNT_BEFORE_THE_TOP_LIST_ANSWER == 1;
  assert route_requires_proof_of_the_subject(GATE_OWNER) == true;
  assert route_requires_proof_of_the_subject(GATE_NONE) == false;
  assert an_anonymous_caller_can_read_an_account_id(GATE_NONE, LEADERBOARD_ROW_CARRIES_A_TELEGRAM_ID) == true;
  assert an_anonymous_caller_can_read_an_account_id(GATE_OWNER, LEADERBOARD_ROW_CARRIES_A_TELEGRAM_ID) == false;
  assert an_anonymous_caller_can_read_an_account_id(GATE_NONE, INVITEE_ROW_CARRIES_A_TELEGRAM_ID) == false;
  assert THE_TWO_DECISIONS_AGREE == false;
  assert OWNER_GATED_ROUTE_COUNT + ADMIN_GATED_ROUTE_COUNT_BEFORE_THE_TOP_LIST_ANSWER + UNGATED_ROUTE_COUNT_BEFORE_THE_TOP_LIST_ANSWER == ROUTE_COUNT;
  assert LEADERBOARD_ROUTE == "GET /api/referrals/leaderboard";
  assert A_ROUTE_WAS_REMOVED_FOR_NAMING_A_PERSON_BY_NUMBER == true;
}

test the_fifth_route_answers_an_admin_only_since_the_owners_answer {
  assert OWNER_TOP_LIST_ANSWER_AT == "2026-09-26";
  assert OWNER_TOP_LIST_ANSWER_AT == OWNER_R3_DECIDED_AT;
  assert OWNER_TOP_LIST_ANSWER_WORDS == "Remove the top and close the address";
  assert UNGATED_ROUTE_COUNT == 0;
  assert ADMIN_GATED_ROUTE_COUNT == 1;
  assert OWNER_GATED_ROUTE_COUNT + ADMIN_GATED_ROUTE_COUNT + UNGATED_ROUTE_COUNT == ROUTE_COUNT;
  assert ADMIN_GATED_ROUTE_COUNT - ADMIN_GATED_ROUTE_COUNT_BEFORE_THE_TOP_LIST_ANSWER == UNGATED_ROUTE_COUNT_BEFORE_THE_TOP_LIST_ANSWER - UNGATED_ROUTE_COUNT;
  assert LEADERBOARD_ROUTE_GATE == GATE_ADMIN;
  assert GATE_ADMIN != GATE_NONE;
  assert GATE_ADMIN != GATE_OWNER;
  assert route_requires_proof_of_the_subject(GATE_ADMIN) == false;
  assert an_anonymous_caller_can_read_an_account_id(LEADERBOARD_ROUTE_GATE, LEADERBOARD_ROW_CARRIES_A_TELEGRAM_ID) == false;
  assert LEADERBOARD_ROW_CARRIES_A_TELEGRAM_ID == true;
  assert A_CUSTOMER_IS_SERVED_ANOTHER_ACCOUNT_ID == false;
  assert LEADERBOARD_GATE_SITES == 1;
  assert LEADERBOARD_ANSWERS_A_NON_ADMIN_AS_R1_DOES == true;
  assert LEADERBOARD_QUERY_IS_READ_AFTER_THE_GATE == true;
  assert LEADERBOARD_ROUTE_STAYS_REGISTERED == true;
  assert LEADERBOARD_ROWS_TOUCHED == 0;
  assert REUSES_LOYALTY_LEDGER_ID == "turbobaby/loyalty-ledger";
}

test the_top_list_left_the_mini_app_with_its_four_keys {
  assert TOP_LIST_READERS_IN_THE_MINI_APP == 0;
  assert TOP_LIST_READERS_IN_THE_MINI_APP_BEFORE_THE_ANSWER == 1;
  assert ADMIN_SCREEN_READS_THE_REFERRAL_TOP == false;
  assert TOP_LIST_KEYS_RETIRED.len == 4;
  assert TOP_LIST_KEYS_RETIRED[0] == "referral.top";
  assert TOP_LIST_KEYS_RETIRED[2] == "referral.id_mask";
  assert TOP_LIST_KEYS_RETIRED[3] == "referral.row_meta";
  assert TOP_LIST_KEYS_RETIRED_WITNESS == "src/trios/i18n.rs the_referral_top_list_keys_stay_retired";
  assert TOP_LIST_CLIENT_WITNESS != ADMIN_ONLY_READ_FETCH_WITNESS;
  assert LEADERBOARD_GATE_WIRING_WITNESS != LEADERBOARD_GATE_WITNESS;
  assert LEADERBOARD_CONTENT_CARRIED == false;
  assert REFSTATS_BUTTON_LABEL_FIELD == "referrals_open_app";
  assert REFSTATS_BUTTON_LABEL_FIELD != REFSTATS_BUTTON_LABEL_FIELD_BEFORE_THE_ANSWER;
  assert REFSTATS_BUTTON_LABEL_WORDED_FOR_IT == false;
  assert REFSTATS_BUTTON_WITNESS != LEADERBOARD_GATE_WIRING_WITNESS;
}

test the_refusals_are_measured_and_carry_no_invented_number {
  assert SEED_REFERRAL_OCCURRENCES == 0;
  assert SEED_ZERO_MAKES_THE_LADDER_UNOWNED == false;
  assert PENDING_EVENT_EXPIRY_IS_NOT_SHIPPED == true;
  assert PER_REFERRER_INVITE_RATE_BOUND_IS_NOT_SHIPPED == true;
  assert CODE_FIXTURES_CARRIED == 0;
  assert ACCOUNT_IDS_CARRIED == 0;
  assert LEADERBOARD_CONTENT_CARRIED == false;
  assert PERSON_LEVEL_FIELDS_CARRIED.len == 0;
}

test this_file_restates_no_owned_decision {
  assert RESTATES_THE_START_PAYLOAD_GRAMMAR == false;
  assert RESTATES_THE_LEDGER_STRUCTURE == false;
  assert NAMED_IN_THE_IDENTITY_CONSUMER_SNAPSHOT == true;
}

test the_identity_snapshot_names_this_file_and_moved_the_day_it_was_checked {
  assert NAMED_IN_THE_IDENTITY_CONSUMER_SNAPSHOT == true;
  assert IDENTITY_SNAPSHOT_CHECKED_AT == "2026-09-21";
  assert IDENTITY_SNAPSHOT_SIZE == 22;
  assert IDENTITY_SNAPSHOT_SIZE_BEFORE_THE_RE_MEASUREMENT == 8;
  assert IDENTITY_SNAPSHOT_SIZE > IDENTITY_SNAPSHOT_SIZE_BEFORE_THE_RE_MEASUREMENT;
  assert IDENTITY_SNAPSHOT_MOVED_THE_SAME_DAY == true;
  assert REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity";
}

; --- Invariants -------------------------------------------------------------------------------------

invariant a_code_that_encodes_an_identity_is_not_opaque
  assert code_is_opaque(true, true, CODE_LENGTH) == false

invariant the_mint_never_derives_a_code_from_a_person
  assert CODE_IS_DERIVED_FROM_AN_IDENTITY == false and code_is_opaque(CODE_IS_DERIVED_FROM_AN_IDENTITY, true, CODE_LENGTH) == true

invariant a_unique_index_is_what_makes_two_people_unable_to_share_a_code
  assert two_people_can_hold_one_code(PROFILE_CODE_IS_UNIQUE_IN_THE_SCHEMA) == false

invariant a_stored_code_is_never_replaced_by_a_mint
  assert a_second_code_can_replace_the_first(true, true) == false

invariant a_person_can_never_refer_themselves_through_the_recording_path
  assert edge_may_be_recorded(true, true) == false

invariant nothing_but_the_insert_path_bars_the_self_edge
  assert SELF_EDGE_HAS_A_SCHEMA_CONSTRAINT == false and BACKFILL_EXCLUDES_THE_SELF_EDGE == false and payout_would_credit_the_invitees_own_balance(true, STATUS_PENDING, PAYOUT_RECHECKS_THE_SELF_EDGE) == true

invariant a_backfilled_self_edge_escapes_the_credit_path_and_not_the_ladder
  assert payout_would_credit_the_invitees_own_balance(true, STATUS_CONFIRMED, PAYOUT_RECHECKS_THE_SELF_EDGE) == false and self_edge_advances_its_own_ladder(true, status_counts_as_confirmed(STATUS_CONFIRMED)) == true

invariant no_number_of_taps_creates_a_second_edge
  assert events_after_taps(2) == events_after_taps(1) and events_after_taps(9) == events_after_taps(1)

invariant a_duplicate_tap_returns_an_identifier_that_names_nothing
  assert returned_id_names_a_row(false) == false and RECORD_RETURNS_AN_ID_UNCONDITIONALLY == true

invariant the_paid_status_is_readable_and_unreachable
  assert status_counts_as_confirmed(STATUS_PAID) == true and status_has_a_writer(STATUS_PAID) == false and read_branch_is_reachable(STATUS_PAID) == false

invariant a_confirmed_edge_never_returns_to_pending
  assert status_after_confirmation(STATUS_CONFIRMED, false) == STATUS_CONFIRMED and CONFIRMATION_IS_ONE_WAY == true

invariant an_unfound_pending_event_credits_nothing
  assert confirmation_may_credit(false, true) == false

invariant a_negative_or_unrepresentable_amount_credits_nothing
  assert confirmation_may_credit(true, false) == false

invariant a_referral_never_settles_in_stars
  assert PAYS_IN_STARS == false and PAYS_IN_BONUS_CURRENCY_BEFORE_2026_09_26 == true and PAYS_IN_THE_THB_REFERRAL_CREDIT == true

invariant no_amount_is_declared_in_this_contract
  assert THIS_FILE_DECLARES_AN_AMOUNT == false and MILESTONE_AMOUNT_IS_DECLARED_HERE == false and MILESTONE_AMOUNT_SOURCE_COUNT == 3

invariant a_rung_already_held_cannot_be_written_again
  assert milestone_award_is_written(true, true, true) == false

invariant the_count_of_rungs_held_never_decreases
  assert milestones_held_after(3, false) == 3 and milestones_held_after(3, true) == 4 and MILESTONE_CAN_BE_UN_AWARDED == false

invariant a_rung_below_the_confirmed_count_is_reached_and_one_above_is_not
  assert milestone_reached(3, MILESTONE_THRESHOLDS[1]) == true and milestone_reached(3, MILESTONE_THRESHOLDS[2]) == false

invariant the_experiment_arm_survives_in_neither_place_it_could
  assert experiment_arm_is_recoverable(ASSIGNED_ARM_IS_WRITTEN_TO_THE_EVENT, FUNNEL_METRIC_CARRIES_THE_ARM) == false

; The 2026-09-21 reading (the function over GATE_NONE); the route has been admin-gated since
; 2026-09-26, which the invariant after it holds.
invariant the_one_ungated_route_is_the_one_that_publishes_an_account_id
  assert an_anonymous_caller_can_read_an_account_id(GATE_NONE, LEADERBOARD_ROW_CARRIES_A_TELEGRAM_ID) == true and an_anonymous_caller_can_read_an_account_id(GATE_NONE, INVITEE_ROW_CARRIES_A_TELEGRAM_ID) == false

invariant a_seed_that_never_mentions_referrals_settles_nothing_about_the_ladder
  assert SEED_REFERRAL_OCCURRENCES == 0 and SEED_ZERO_MAKES_THE_LADDER_UNOWNED == false and MILESTONE_RUNG_COUNT == 3

invariant no_edge_of_this_contract_is_carried_by_a_line_number
  assert SIBLING_LINE_CITATIONS_IN_THIS_FILE == 0 and edge_is_durable(true, false) == true and edge_is_durable(true, true) == false

invariant an_unmeasured_interval_is_never_published_as_a_number
  assert STALENESS_INTERVAL_IS_PUBLISHED == false and WAVE_CENSUS_MEASURED_AT == "2026-09-21"

invariant a_number_that_moves_while_it_is_read_is_never_pinned_as_a_constant
  assert CORPUS_RESIDUE_IS_PINNED_HERE == false and CORPUS_RESIDUE_NOTE != "" and SIBLING_LINE_CITATIONS_IN_THIS_FILE == 0

invariant no_credit_of_this_domain_escapes_the_ledger
  assert THIS_DOMAINS_CREDITS_AMONG_THE_BYPASSES == 0 and ledger_contracts_agree(THIS_DOMAINS_CREDITS_INSIDE_THE_PAIRED_SIX, THIS_DOMAINS_CREDITS_AMONG_THE_BYPASSES, LEDGER_PAIRED_MOVEMENTS, LEDGER_MOVEMENTS_TOTAL) == true

invariant this_contract_carries_no_person_and_no_code
  assert CODE_FIXTURES_CARRIED == 0 and ACCOUNT_IDS_CARRIED == 0 and LEADERBOARD_CONTENT_CARRIED == false

invariant r3_no_credit_of_this_domain_survives
  assert CREDITS_TO_THE_REFERRER_SINCE_2026_09_26 + CREDITS_TO_THE_INVITEE_SINCE_2026_09_26 == 0 and REFERRAL_TX_TYPE_WRITERS_SINCE_2026_09_26 == 0 and MILESTONE_AWARD_WRITERS == 0 and points_a_confirmation_credits(false, 2, 1) == 0

invariant r3_the_edge_is_still_confirmed_and_what_was_paid_stays
  assert CONFIRMATION_KEPT_WITHOUT_MONEY == true and CREDITED_POINTS_KEPT == true and CONFIRMATION_IS_ONE_WAY == true

invariant since_the_owners_answer_no_route_of_the_graph_is_ungated
  assert UNGATED_ROUTE_COUNT == 0 and LEADERBOARD_ROUTE_GATE == GATE_ADMIN and an_anonymous_caller_can_read_an_account_id(LEADERBOARD_ROUTE_GATE, LEADERBOARD_ROW_CARRIES_A_TELEGRAM_ID) == false and TOP_LIST_READERS_IN_THE_MINI_APP == 0
