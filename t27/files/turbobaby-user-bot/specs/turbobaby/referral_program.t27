; --- What a referral code may encode -------------------------------------------------------------
; src/db/referrals.rs:78-79. Thirty-two glyphs, eight positions. The alphabet omits 0/O and 1/I/l
; on purpose (:76-77) so a code read aloud or copied by hand survives the trip.
pub const CODE_ALPHABET : str = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
pub const CODE_ALPHABET_SIZE : u8 = 32;
pub const CODE_ALPHABET_OMITS_AMBIGUOUS_GLYPHS : bool = true;
pub const CODE_LENGTH : u16 = 8;

; 32^8 is 2^40. Declared as the exponent because the product does not fit the integer widths this
; corpus uses, and because the exponent is the honest form of a keyspace.
pub const CODE_KEYSPACE_IS_TWO_TO_THE : u8 = 40;
; src/db/referrals.rs:95-96 puts that keyspace at roughly 2.8e12. 2^40 is 1.0995e12, so the
; comment overstates it by a factor of about 2.5. The conclusion drawn beside it -- that a
; collision is remote and the retry loop is defence in depth -- survives the correction, which is
; why this is recorded as a wrong number and not as a wrong design.
pub const SOURCE_COMMENT_OVERSTATES_THE_KEYSPACE : bool = true;

; The generator at src/db/referrals.rs:83-92 takes no argument at all: there is no telegram id in
; scope, so no identity can be recovered from a code by any means, not by inversion and not by
; lookup outside the profiles table. This was not always so.
pub const CODE_IS_DERIVED_FROM_AN_IDENTITY : bool = false;
pub const A_TELEGRAM_ID_WAS_ONCE_THE_CODE : bool = true;
; migrations/035_referral_code_telegram_id.sql:1-3 records the era plainly: the code was the raw
; telegram id, chosen for human-readable deep links, and the column had to be widened to hold
; nineteen digits. migrations/046_opaque_referral_codes.sql:18-36 ended it, rewriting every
; all-digit code in loyalty_profiles and carrying the rewrite into referral_events at :34 so
; attribution survived the deploy.
pub const OPACITY_WAS_RETROFITTED : bool = true;
pub const REWRITE_CARRIED_THROUGH_TO_THE_EVENT_LEDGER : bool = true;

pub fn code_is_opaque(derived_from_an_identity: bool, drawn_from_the_alphabet: bool, length: u16) bool {
  return !derived_from_an_identity and drawn_from_the_alphabet and length == CODE_LENGTH;
}

; Eight of the thirty-two glyphs are digits, so an all-digit minted code has probability
; (8/32)^8 = 4^-8, one in 65536. That matters twice. The legacy test in
; migrations/046_opaque_referral_codes.sql:27 is the regular expression for an all-digit string,
; so a minted code can be indistinguishable from the legacy shape it replaced; the migration is
; ledgered and runs once (src/db/mod.rs:25 names the _schema_migrations table), so this is a trap
; for the next author of such a test rather than a live rotation. And the unit test at
; src/db/referrals.rs:686-691 pins non-derivability by asserting the code is not all digits,
; which fails at exactly that rate.
pub const ALL_DIGIT_CODE_ONE_IN : u32 = 65536;
pub const A_MINTED_CODE_CAN_MATCH_THE_LEGACY_SHAPE : bool = true;
pub const THE_LEGACY_REWRITE_RUNS_ONCE : bool = true;
pub const THE_OPACITY_UNIT_TEST_IS_FLAKY_AT_THAT_RATE : bool = true;

; --- Minting a code, and whether it holds still ---------------------------------------------------
; migrations/001_initial.sql:16 gives loyalty_profiles.referral_code a fifty-character width and a
; UNIQUE index. That index, not the application retry, is what makes two people sharing a code
; impossible: a colliding insert violates it. migrations/007_referral_events.sql:8 gives the
; event's copy of the code no uniqueness at all, and migrations/035_referral_code_telegram_id.sql
; widened it to match.
pub const PROFILE_CODE_COLUMN_MAX_LEN : u16 = 50;
pub const EVENT_CODE_COLUMN_MAX_LEN : u16 = 50;
pub const PROFILE_CODE_IS_UNIQUE_IN_THE_SCHEMA : bool = true;
pub const EVENT_CODE_IS_UNIQUE_IN_THE_SCHEMA : bool = false;
; src/db/referrals.rs:97. The retry bound the mint loop uses (:125, :134). It is declared because
; the comment two lines above it (:94-96) is the one this file corrects, not because the loop is
; what keeps codes distinct -- the UNIQUE index is.
pub const MAX_CODE_RETRIES : u8 = 10;

pub fn code_length_fits_the_column(length: u16) bool {
  return length >= 1 and length <= PROFILE_CODE_COLUMN_MAX_LEN;
}

pub fn two_people_can_hold_one_code(schema_enforces_uniqueness: bool) bool {
  return !schema_enforces_uniqueness;
}

; src/db/referrals.rs:101-161. The read at :112-121 and the write at :150-158 are separate
; statements with no row lock -- contrast :333 in the confirmation path, which takes one -- and
; the conflict action at :152-154 REPLACES the column rather than leaving it. So the only thing
; holding a minted code still is that the read found one. Two first-time calls for the same person
; that interleave end with the second code stored. The chain test at src/db/referrals.rs:791-797
; pins stability across two sequential calls and states why it matters: a code that changes kills
; every link already shared. It cannot pin the interleaved case.
pub const CODE_MINT_TAKES_A_ROW_LOCK : bool = false;
pub const MINT_CONFLICT_ACTION_REPLACES_THE_COLUMN : bool = true;
pub const STABILITY_IS_PINNED_SEQUENTIALLY_ONLY : bool = true;

pub fn mint_returns_the_stored_code(code_already_stored: bool) bool {
  return code_already_stored;
}

pub fn a_second_code_can_replace_the_first(code_already_stored: bool, concurrent_first_mint: bool) bool {
  if (code_already_stored) {
    return false;
  }
  return concurrent_first_mint;
}

; --- The graph ------------------------------------------------------------------------------------
; migrations/007_referral_events.sql:7. The unique key is the INVITEE alone, not the pair. A person
; may be referred once ever, by one referrer, and a referrer has no ceiling on invitees anywhere in
; the schema or the code.
pub const EDGE_IS_DIRECTED : bool = true;
pub const UNIQUE_KEY_IS_THE_INVITEE_ALONE : bool = true;
pub const REFERRERS_PER_INVITEE_MAX : u8 = 1;
pub const INVITEES_PER_REFERRER_HAVE_A_CEILING : bool = false;
; src/db/referrals.rs:251. A pre-existing attribution wins over a later one, expressed as a
; COALESCE because a plain upsert would overwrite it.
pub const FIRST_TOUCH_WINS : bool = true;

; The edge is stored twice and the two copies are read by different paths.
; src/db/referrals.rs:242 writes loyalty_profiles.referred_by; :265 writes
; referral_events.referrer_id. The confirmation reads the event (:341), and so, since 2026-09-26,
; does the referral credit (record_rental in src/db/referral_credit.rs). Until then the milestone
; award read the profile (src/db/orders.rs:446 calling get_referrer_of, src/db/referrals.rs:191-203,
; both at e39221e); since R3 no money path reads referred_by. Nothing compares them.
pub const ATTRIBUTION_IS_STORED_TWICE : bool = true;
pub const THE_TWO_COPIES_ARE_EVER_COMPARED : bool = false;

; Two terms, and referrer_found is deliberately NOT one of them. turbobaby/bot-surface owns
; start_records_a_referral, whose four terms already include the referrer lookup and the sender
; comparison; conjoining the lookup again here would restate a term this file does not measure and
; would describe states that owner's contract forbids (admitted, yet no referrer). What this file
; measures is the SECOND guard, at a second site: src/db/referrals.rs:216-218 refuses a self edge
; in the data layer, so a caller that is not the bot -- an admin tool, a new endpoint -- still
; meets one. The self-edge term therefore stands for that guard, not for the bot's :199.
pub fn edge_may_be_recorded(start_admitted: bool, self_edge: bool) bool {
  return start_admitted and !self_edge;
}

; --- The self edge ----------------------------------------------------------------------------------
; Two guards, both in application code, both on the same path: src/bot/commands.rs:199 compares the
; two ids before calling, and src/db/referrals.rs:216-218 refuses at the data layer. The comment
; above the second (:209-215; :220-226 at e39221e) named the reason until 2026-09-26: a
; self-referral pending event would later be paid out to the user's own balance by the
; confirmation path. Since R3 the confirmation pays nothing, and the referral credit refuses a self
; edge on its own (creditable_inviter's SelfEdge, turbobaby/referral-credit).
pub const SELF_EDGE_GUARD_COUNT : u8 = 2;
pub const SELF_EDGE_GUARDS_ARE_APPLICATION_CODE : bool = true;
; migrations/007_referral_events.sql holds zero CHECK constraints. There is no schema-level
; statement that referrer_id and referred_id differ.
pub const SELF_EDGE_HAS_A_SCHEMA_CONSTRAINT : bool = false;
; The backfill at migrations/007_referral_events.sql:21-32 inserts rows without passing either
; guard, and its WHERE clause (:31) tests only that referred_by is not null. A profile whose
; referred_by equals its own telegram_id satisfies the join at :30 against itself and produces a
; self edge. The confirmation path (confirm_referral at src/db/referrals.rs:319-505 at e39221e;
; confirm_referral_edge_in, :316-388, since 2026-09-26) never re-checks the two ids -- and since R3
; it has no amount to check either.
pub const BACKFILL_PASSES_THROUGH_A_GUARD : bool = false;
pub const BACKFILL_EXCLUDES_THE_SELF_EDGE : bool = false;
pub const PAYOUT_RECHECKS_THE_SELF_EDGE : bool = false;
;
; WHICH MONEY A SELF EDGE CAN ACTUALLY REACH, and the mistake of not asking. The status the row is
; BORN with decides it, and the two ways of making one give different answers.
; A backfilled row is born confirmed (migrations/007_referral_events.sql:26), and the confirmation
; selects on status pending and nothing else (src/db/referrals.rs:332). So the per-referral credit
; path COULD NOT pay a backfilled self edge: it found no pending row and took the no-op (:359-373 at
; e39221e; the early return at :338 since 2026-09-26). The fraud the source comment at :220-226 (at
; e39221e) described -- a self-referral event later paid out to the user's own balance -- was a
; fact about the INSERT path, whose rows are born pending (:268), and that path has both guards.
; The backfilled row was not harmless, and the reachable path was the other one.
; count_confirmed_referrals counts status confirmed OR paid (src/db/referrals.rs:650-651),
; maybe_award_referral_milestones read that count at :790 and paid the ladder off it (:795-796,
; both at e39221e), and on a self edge the referrer IS the invitee -- so the row advanced that
; person's own rung. R3 deleted the award on 2026-09-26, so no rung is advanced any more, and the
; referral credit refuses the self edge by name. get_referrer_stats still counts it the same way at
; :423 and the leaderboards at :470, :484 and :498.
pub const BACKFILLED_EDGE_IS_BORN_CONFIRMED : bool = true;
pub const INSERTED_EDGE_IS_BORN_PENDING : bool = true;
pub const CONFIRMATION_SELECTS_ONLY_PENDING : bool = true;
pub const A_CONFIRMED_SELF_EDGE_ADVANCES_ITS_OWN_LADDER : bool = false;
pub const A_CONFIRMED_SELF_EDGE_ADVANCES_ITS_OWN_LADDER_BEFORE_2026_09_26 : bool = true;
pub const SELF_EDGE_POPULATION_NOTE : str = "Whether such a row exists is a fact about a deployed database, which this repository does not publish and this file does not guess. What is measured is that the only barrier is on the insert path, that the backfill is not on it, and which of the two money paths a row born on each side can reach.";

; The per-referral credit path. Born status is the term the first reading of this file omitted:
; without it the predicate said yes for a backfilled row, which confirm_referral cannot see.
pub fn payout_would_credit_the_invitees_own_balance(self_edge: bool, born_status: u8, payout_rechecks: bool) bool {
  if (payout_rechecks) {
    return false;
  }
  if (born_status != STATUS_PENDING) {
    return false;
  }
  return self_edge;
}

; The milestone path, which does not care how the row was born, only that it counts as confirmed.
pub fn self_edge_advances_its_own_ladder(self_edge: bool, counted_as_confirmed: bool) bool {
  return self_edge and counted_as_confirmed;
}

; --- The event ledger and what makes two taps one event ---------------------------------------------
; src/db/referrals.rs:272-281. Idempotency here is a unique index and a DO NOTHING, not a client
; key header -- this table has no key column and no header is read on this path. The witness is
; tests/integration_invite_counter.rs, and src/db/referrals.rs:829-864 taps three times and
; asserts the counter reads one. Both witnesses need a database and are #[ignore]d
; (src/db/referrals.rs:830, tests/integration_invite_counter.rs:62 and :132, the command spelled
; out at its :20), so neither runs in a default cargo test. The behaviour is pinned by the UNIQUE
; index at migrations/007_referral_events.sql:7 and demonstrated, not guarded, by those two.
pub const THE_IDEMPOTENCY_WITNESSES_RUN_BY_DEFAULT : bool = false;
pub const IDEMPOTENCY_IS_A_UNIQUE_INDEX : bool = true;
pub const IDEMPOTENCY_IS_A_CLIENT_KEY_HEADER : bool = false;

pub fn events_after_taps(taps: u8) u8 {
  if (taps == 0) {
    return 0;
  }
  return 1;
}

; The identifier is minted at src/db/referrals.rs:227, BEFORE the insert that may do nothing, and
; returned unconditionally at :295. On a duplicate tap the caller receives a well-formed uuid that
; names no row. It is harmless today only because the one production caller
; (src/bot/commands.rs:201-211) discards the value and checks the error.
pub const RECORD_RETURNS_AN_ID_UNCONDITIONALLY : bool = true;
pub const THE_ONE_CALLER_DISCARDS_THE_ID : bool = true;

pub fn returned_id_names_a_row(inserted: bool) bool {
  return inserted;
}

; src/db/referrals.rs:197-201 states that the two statements are not wrapped in a transaction,
; matching the raw SQL they replaced. The duplicate probe at :231-236 is a third statement, read
; before either write, and the notice at :284-293 is sent on its result. Two taps that interleave
; can both observe "not yet referred" and both enqueue the joined notice, while the unique index
; still allows only one row. The duplicate is in the notification, not in the graph.
pub const RECORD_IS_ONE_TRANSACTION : bool = false;
pub const DUPLICATE_PROBE_IS_A_SEPARATE_READ : bool = true;
pub const A_RACE_CAN_DUPLICATE_THE_JOINED_NOTICE : bool = true;
pub const A_RACE_CAN_DUPLICATE_THE_EDGE : bool = false;

; --- Status, and the rung nothing writes --------------------------------------------------------
pub const STATUS_UNSET : u8 = 0;
pub const STATUS_PENDING : u8 = 1;
pub const STATUS_CONFIRMED : u8 = 2;
pub const STATUS_PAID : u8 = 3;
pub const STATUS_NAMED_IN_THE_SCHEMA : u8 = 3;
pub const STATUS_VALUES_WITH_A_WRITER : u8 = 2;
pub const PAID_READ_SITE_COUNT : u8 = 5;
pub const PAID_WRITE_SITE_COUNT : u8 = 0;
; The comment that claimed a paid writer left with R3's rewrite of the completion step.
pub const A_COMMENT_CLAIMS_A_PAID_WRITER : bool = false;
pub const A_COMMENT_CLAIMS_A_PAID_WRITER_BEFORE_2026_09_26 : bool = true;
pub const STALE_PAID_CLAIM_SITE_BEFORE_2026_09_26 : str = "src/db/orders.rs:418";

pub fn status_is_named_in_the_schema(status: u8) bool {
  return status >= STATUS_PENDING and status <= STATUS_PAID;
}

pub fn status_has_a_writer(status: u8) bool {
  return status == STATUS_PENDING or status == STATUS_CONFIRMED;
}

; What the five read sites mean by "confirmed" is the disjunction, and it admits a value no writer
; produces. The branch is not wrong, it is unreachable, which is worse to read and cheaper to fix.
pub fn status_counts_as_confirmed(status: u8) bool {
  return status == STATUS_CONFIRMED or status == STATUS_PAID;
}

pub fn read_branch_is_reachable(status: u8) bool {
  return status_counts_as_confirmed(status) and status_has_a_writer(status);
}

; confirm_referral_edge_in (src/db/referrals.rs:316-388) runs on its caller's transaction: its own
; on a completion (confirm_referral_edge, :393-402, opened at :398 and committed at :400), or the
; one record_rental holds. The pending row is taken under an exclusive lock (:333) so two
; confirmations cannot count the friend twice, and a missing pending row returns at :338, the
; wrapper still committing to release the lock. (confirm_referral, :346-503 at e39221e, did the
; same around its three credits.) Nothing anywhere returns a confirmed row to pending.
pub const CONFIRMATION_IS_ONE_TRANSACTION : bool = true;
pub const CONFIRMATION_TAKES_A_ROW_LOCK : bool = true;
pub const CONFIRMATION_IS_ONE_WAY : bool = true;
pub const A_MISSING_PENDING_EVENT_IS_A_NO_OP : bool = true;

; Until 2026-09-26, src/db/referrals.rs:337-339 (at e39221e) refused a non-finite or negative bonus
; before the transaction opened, and :340-344 clamped a non-finite or non-positive welcome amount
; to nothing rather than refusing, because the welcome credit was optional and the referral credit
; was not. Since R3 the confirmation takes no amount; the function below is that history.
pub fn confirmation_may_credit(pending_event_found: bool, amount_is_finite_and_nonnegative: bool) bool {
  return pending_event_found and amount_is_finite_and_nonnegative;
}

pub fn status_after_confirmation(status: u8, credited: bool) u8 {
  if (status != STATUS_PENDING) {
    return status;
  }
  if (credited) {
    return STATUS_CONFIRMED;
  }
  return STATUS_PENDING;
}

; --- What a referral paid in until 2026-09-26 ---------------------------------------------------
; Three credits, all of them rows in the bonus ledger owned by turbobaby/loyalty-ledger, and none
; of them in the Stars currency: a case-insensitive sweep of src/db/referrals.rs for star finds
; only the word start. src/db/referrals.rs:414, :474 and :842 (all at e39221e) named the three
; transaction types. R3 stopped all three on 2026-09-26; the constants below are that record, and
; what a referral pays since is the R3 section's and turbobaby/referral-credit's.
; Since R3 a referral pays in the THB referral credit (turbobaby/referral-credit), not in bonus.
pub const PAYS_IN_BONUS_CURRENCY : bool = false;
pub const PAYS_IN_BONUS_CURRENCY_BEFORE_2026_09_26 : bool = true;
pub const PAYS_IN_THE_THB_REFERRAL_CREDIT : bool = true;
pub const PAYS_IN_STARS : bool = false;
pub const LEDGER_TX_TYPE_COUNT : u8 = 3;
pub const LEDGER_TX_TYPES : [3]str = ["referral_bonus", "referral_welcome", "referral_milestone"];
pub const CREDITS_TO_THE_REFERRER : u8 = 2;
pub const CREDITS_TO_THE_INVITEE : u8 = 1;
; Every one of the three paired a balance movement with a ledger insert, the insert first in each
; case: :429 behind :419, :489 behind :481, :855 behind :847 (at e39221e). turbobaby/loyalty-ledger
; measured the same three from the other side and counted all three among the six movements that
; paired; since R3 it counts three paired movements of seven, none of them this domain's.
pub const EVERY_CREDIT_PAIRS_WITH_A_LEDGER_ROW : bool = true;

; The amounts were parameters, not constants: src/db/referrals.rs:319-323 took both, and they did
; not arrive from the same place. The per-referral bonus was read from shop configuration by the one
; production caller, with a compiled fallback beside it (src/db/orders.rs:423-439, passed at :440).
; The welcome amount was not read there at all -- it was itself a parameter of complete_order
; (src/db/orders.rs:195) and was passed straight through at :440, so its own source was further up
; than this domain (every line number here at e39221e). This file named both seams and wrote down
; neither number. Since R3 neither seam exists: complete_order takes no amount, and the
; confirmation takes none either.
pub const AMOUNTS_ARRIVE_AS_ARGUMENTS : bool = true;
pub const THIS_FILE_DECLARES_AN_AMOUNT : bool = false;

pub fn welcome_credit_is_written(referral_confirmed: bool, welcome_amount_is_positive: bool) bool {
  return referral_confirmed and welcome_amount_is_positive;
}

; src/db/referrals.rs:382 (at e39221e) wrote bonus_paid, and it wrote only the per-referral credit.
; The milestone credit (:855) and the welcome credit (:489) moved balances without touching it. So
; the figure the profile screen calls total bonus earned, summed at :425 and shown at
; src/api/referrals.rs:190, is the per-referral total and not what the referrer received. Nothing
; writes bonus_paid since R3, so that figure freezes as history on 2026-09-26.
pub const BONUS_PAID_COVERS_THE_PER_REFERRAL_CREDIT : bool = true;
pub const BONUS_PAID_COVERS_THE_MILESTONE_CREDIT : bool = false;
pub const EARNINGS_SUM_IS_THE_WHOLE_OF_WHAT_A_REFERRER_RECEIVED : bool = false;

pub fn earnings_sum_includes(credit_is_the_per_referral_bonus: bool) bool {
  return credit_is_the_per_referral_bonus;
}

; --- Milestones, until 2026-09-26 ------------------------------------------------------------------
; src/db/referrals.rs:712 (at e39221e), the single ladder. Three rungs, counted in confirmed
; referrals. R3 deleted the ladder, its defaults and its award on 2026-09-26; gate 3 no longer
; binds these constants to src/ (there is nothing left to bind them to), and they stay as the
; record of what was offered and paid. The rows already awarded are still read and still served.
pub const MILESTONE_RUNG_COUNT : u8 = 3;
pub const MILESTONE_THRESHOLDS : [3]u16 = [1, 3, 5];
; migrations/068_referral_milestones.sql:9. The pair is the primary key, which is the whole of the
; idempotency: src/db/referrals.rs:805-817 (at e39221e) inserted ON CONFLICT DO NOTHING and treated
; a zero rows_affected as "already awarded", so no rung could pay twice even if the routine reran.
pub const MILESTONE_KEY_IS_THE_PAIR : bool = true;
pub const MILESTONE_CAN_BE_AWARDED_TWICE : bool = false;
; No statement in src/ or migrations/ deletes from or updates referral_milestones; the only write
; was the insert at :808 (at e39221e), and since R3 there is none. A rung, once reached, cannot be
; taken back.
pub const MILESTONE_CAN_BE_UN_AWARDED : bool = false;
; The count is recomputed from the events on every call (:642-659, called at :632, and at :790 at
; e39221e) while
; the award row persists. A graph that shrinks therefore leaves the award standing, which is the
; behaviour monotonicity means here.
pub const MILESTONE_SURVIVES_A_SHRINKING_GRAPH : bool = true;

pub fn milestone_reached(confirmed: u16, threshold: u16) bool {
  return confirmed >= threshold;
}

pub fn milestone_award_is_written(reached: bool, already_awarded: bool, amount_is_positive: bool) bool {
  return reached and !already_awarded and amount_is_positive;
}

pub fn milestones_held_after(already_awarded_count: u8, wrote: bool) u8 {
  if (wrote) {
    return already_awarded_count + 1;
  }
  return already_awarded_count;
}

; The three answers to "what does this rung pay", and why no single one of them is a contract
; term: the compiled default at src/db/referrals.rs:716, the live shop value at :918-927, and the
; amount frozen into the row at :810 (all three at e39221e) and read back at :636.
; src/api/referrals.rs put two of them on the wire side by side, awards from the rows and bonuses
; from the configuration, and :111-117 records why they are different numbers; since R3 its
; bonuses are an empty list and only the awards remain.
pub const MILESTONE_AMOUNT_SOURCE_COUNT : u8 = 3;
pub const MILESTONE_AMOUNT_IS_DECLARED_HERE : bool = false;
pub const THE_ROW_IS_THE_RECORD_OF_WHAT_WAS_PAID : bool = true;
pub const THE_CONFIGURATION_IS_THE_RECORD_OF_WHAT_IS_OFFERED : bool = true;
; The defaults literal is keyed by rung, so it carries a second copy of the ladder. A rung added to
; the ladder alone is offered to the customer at zero and never awarded.
pub const DEFAULTS_CARRY_A_SECOND_COPY_OF_THE_LADDER : bool = true;

pub fn a_new_rung_can_be_offered_and_never_paid(in_the_ladder: bool, has_a_default: bool, has_a_configured_amount: bool) bool {
  if (!in_the_ladder) {
    return false;
  }
  return !has_a_default and !has_a_configured_amount;
}

; src/db/referrals.rs:792-871 was one transaction over every rung; the notices at :873-885 were
; sent after the commit on purpose, so a messaging failure could not roll back money. The whole
; routine was best-effort at its call site: src/db/orders.rs:451-459 logged a failure and completed
; the order (every line number here at e39221e; the routine and its call were deleted by R3).
; What those notices ARE -- the row, its kind, its markup and its delivery -- belongs to
; turbobaby/notification-queue, which measures the same enqueues from the mail side. Only their
; position relative to the commit is declared here, and no kind or column of theirs is restated.
pub const MILESTONE_AWARD_IS_ONE_TRANSACTION : bool = true;
pub const NOTICE_IS_SENT_AFTER_THE_COMMIT : bool = true;
pub const A_FAILED_NOTICE_ROLLS_BACK_THE_CREDIT : bool = false;
pub const MILESTONE_AWARD_IS_BEST_EFFORT_AT_ITS_CALL_SITE : bool = true;

; --- The share-source experiment ------------------------------------------------------------------
; src/trios/referrals.rs:14-16: a fixed multiply-add over the telegram id, then a Euclidean
; remainder over the list length, so a negative id still lands in range and the same person always
; lands in the same arm. The empty list is handled at :10-12 and cannot occur in production anyway,
; because src/config.rs:223-244 substitutes a default pair for an absent, blank or fully-rejected
; setting.
pub const SHARE_SOURCE_IS_DETERMINISTIC : bool = true;
pub const SHARE_SOURCE_DEPENDS_ON_THE_TELEGRAM_ID : bool = true;
pub const SHARE_SOURCE_FALLBACK : str = "default";
pub const CONFIGURED_LIST_CAN_BE_EMPTY_IN_PRODUCTION : bool = false;
; An arm is one of a handful of buckets. It narrows an id to a residue class and recovers nothing,
; which is the only reason an owner-gated route may return it at all.
pub const SHARE_SOURCE_LEAKS_THE_TELEGRAM_ID : bool = false;

; The measurement that makes this section worth writing down.
pub const SHARE_SOURCE_PRODUCTION_CALLERS : u8 = 1;
pub const EVENT_SOURCE_PRODUCTION_WRITERS : u8 = 1;
pub const EVENT_SOURCE_DISTINCT_PRODUCTION_VALUES : u8 = 1;
pub const ASSIGNED_ARM_IS_WRITTEN_TO_THE_EVENT : bool = false;
pub const FUNNEL_METRIC_CARRIES_THE_ARM : bool = false;

pub fn experiment_arm_is_recoverable(arm_written_to_the_event: bool, arm_labelled_on_the_metric: bool) bool {
  return arm_written_to_the_event or arm_labelled_on_the_metric;
}

; --- Who may read the graph ----------------------------------------------------------------------
pub const GATE_NONE : u8 = 0;
pub const GATE_OWNER : u8 = 1;
; The admin gate, which the fifth route has called since the owner's answer of 2026-09-26 ("The
; referral top list", below). It proves the caller is an admin, not the subject of the rows.
pub const GATE_ADMIN : u8 = 2;
pub const ROUTE_COUNT : u8 = 5;
pub const OWNER_GATED_ROUTE_COUNT : u8 = 4;
; Bound by gate 3 (the check_admin calls of src/api/referrals.rs). With the two rows on ROUTE_COUNT
; and OWNER_GATED_ROUTE_COUNT it pins the ungated count to 5 - 4 - 1 = 0.
pub const ADMIN_GATED_ROUTE_COUNT : u8 = 1;
pub const UNGATED_ROUTE_COUNT : u8 = 0;
; Until the owner's answer of 2026-09-26 the fifth route called no gate (the header's item 3).
pub const ADMIN_GATED_ROUTE_COUNT_BEFORE_THE_TOP_LIST_ANSWER : u8 = 0;
pub const UNGATED_ROUTE_COUNT_BEFORE_THE_TOP_LIST_ANSWER : u8 = 1;
; The path as a caller types it, not as the module registers it: src/api/referrals.rs:42 registers
; /referrals/leaderboard and src/api/mod.rs:77 nests the whole set under /api. The handler's own
; doc comment at src/api/referrals.rs:212 spells the joined form. Named UNGATED_ROUTE until
; 2026-09-26, when the route stopped being ungated.
pub const LEADERBOARD_ROUTE : str = "GET /api/referrals/leaderboard";
; Still true: what an admin is served is the row as it was, whole id included.
pub const LEADERBOARD_ROW_CARRIES_A_TELEGRAM_ID : bool = true;
pub const INVITEE_ROW_CARRIES_A_TELEGRAM_ID : bool = false;
; The 2026-09-21 reading: the field the owner-gated route withheld, the ungated one published. Since
; 2026-09-26 no customer is served it by either route (A_CUSTOMER_IS_SERVED_ANOTHER_ACCOUNT_ID).
pub const THE_TWO_DECISIONS_AGREE : bool = false;
; src/api/referrals.rs:34-41 records a route that was removed for exactly this class of reason: it
; took a referrer id from a request body, so an inviter could be named by a number a caller typed.
; The removal was the precedent that the leaderboard exposure had not been measured against until
; the owner closed it on 2026-09-26.
pub const A_ROUTE_WAS_REMOVED_FOR_NAMING_A_PERSON_BY_NUMBER : bool = true;

pub fn route_requires_proof_of_the_subject(gate: u8) bool {
  return gate == GATE_OWNER;
}

pub fn an_anonymous_caller_can_read_an_account_id(gate: u8, row_carries_the_id: bool) bool {
  return gate == GATE_NONE and row_carries_the_id;
}

; --- Refusals: what this repository does not publish ---------------------------------------------
; data/fleet_seed.json is the whole of data/ and holds zero occurrences of referral,
; case-insensitive, measured 2026-09-21. It is the fleet, not the programme, and its silence is
; evidence about itself only. The ladder has a published source in src/ and is declared above; the
; amounts have three and are declared nowhere.
pub const SEED_REFERRAL_OCCURRENCES : u8 = 0;
pub const SEED_MEASUREMENT_NOTE : str = "grep -ci referral data/fleet_seed.json returns 0 on 2026-09-21; data/ contains that one file, 19434 bytes. The zero bounds what the seed can be cited for and settles nothing about src/db/referrals.rs:712 (the ladder, at e39221e).";
pub const SEED_ZERO_MAKES_THE_LADDER_UNOWNED : bool = false;

; A pending referral event has no expiry. src/main.rs runs no sweep over this table -- the only
; DELETE statements against referral_events anywhere in src/ are inside the test module at
; src/db/referrals.rs:762 and :840 -- and the schema has no TTL column beyond created_at. An
; invitee who never orders leaves a pending row that is counted forever by
; src/api/referrals.rs:189 as pending.
pub const PENDING_EVENT_EXPIRY_IS_NOT_SHIPPED : bool = true;
pub const PENDING_EXPIRY_NOTE : str = "No sweep exists and no threshold is published, so no expiry period is declared here. Shipping one needs a decision on whether an aged pending edge is deleted, marked, or merely hidden from the counter.";

; No bound exists on how fast one person may create edges. The rate helper this module owns is
; applied at src/bot/commands.rs:348 and :375, both on the assistant commands; the referral branch
; at :188-215 is not behind it. Nothing else in the path counts attempts.
pub const PER_REFERRER_INVITE_RATE_BOUND_IS_NOT_SHIPPED : bool = true;
pub const RATE_BOUND_NOTE : str = "Measured as an absence on one path, not as a claim that the system is unbounded: the transport imposes its own limits, and what a bound here should count -- taps, distinct invitees, or confirmations -- is a decision nobody has recorded.";

pub const PERSON_LEVEL_FIELDS_CARRIED : [0]str = [];
pub const CODE_FIXTURES_CARRIED : u8 = 0;
pub const ACCOUNT_IDS_CARRIED : u8 = 0;
pub const LEADERBOARD_CONTENT_CARRIED : bool = false;

; --- R3: what a referral pays since 2026-09-26 ----------------------------------------------------
; The owner's answer is quoted in the header. This file declares no rate: the 10% is
; turbobaby/referral-credit's (CREDIT_PERCENT), and THIS_FILE_DECLARES_AN_AMOUNT stays false.
pub const OWNER_R3_DECIDED_AT : str = "2026-09-26";
; No loyalty-point credit is written by this domain any more, to either person.
pub const CREDITS_TO_THE_REFERRER_SINCE_2026_09_26 : u8 = 0;
pub const CREDITS_TO_THE_INVITEE_SINCE_2026_09_26 : u8 = 0;
; Both bound by gate 3 over src/: no shipped line composes a referral bonus transaction (the
; tx_type literal referral_ in a Set), and nothing inserts into referral_milestones.
pub const REFERRAL_TX_TYPE_WRITERS_SINCE_2026_09_26 : u8 = 0;
pub const MILESTONE_AWARD_WRITERS : u8 = 0;
; GET /api/referrals/me/:id/milestones serves empty thresholds and bonuses: nothing is offered,
; and a cached bundle's milestones panel renders nothing on an empty list.
pub const MILESTONE_OFFERS_SERVED : u8 = 0;
; The edge is still confirmed (pending -> confirmed, referral_count + 1), with no money: on the
; friend's first completed order (step 7 of complete_order_and_update_loyalty, through
; confirm_referral_edge) and on a creditable rental a manager records (record_rental, through
; confirm_referral_edge_in in the record's own transaction).
pub const CONFIRMATION_KEPT_WITHOUT_MONEY : bool = true;
pub const CONFIRMATION_SITES_SINCE_2026_09_26 : u8 = 2;
; Points already credited stay where they are: bonus_balance, the referral_bonus,
; referral_welcome and referral_milestone rows of bonus_transactions, the referral_milestones rows
; and referral_events.bonus_paid. Nothing is deleted or rewritten.
pub const CREDITED_POINTS_KEPT : bool = true;
; The referral credit refuses a self edge by name (creditable_inviter's SelfEdge), which the old
; payout never re-checked.
pub const CREDIT_RECHECKS_THE_SELF_EDGE : bool = true;

pub fn points_a_confirmation_credits(before_r3: bool, per_referral: u8, welcome: u8) u8 {
  if (before_r3) {
    return per_referral + welcome;
  }
  return 0;
}

; --- The referral top list: the owner's answer of 2026-09-26 -----------------------------------------
; Open question 2 of the DECISIONS.md entry "R1-R3, the owner's answers of 2026-09-26": GET
; /api/referrals/leaderboard answered anyone with the top referrers' Telegram ids and their point
; totals frozen before R3 (total_bonus_earned), and the invite screen's top-referrers list printed
; them, each id cut to four digits on the client, which withholds nothing (turbobaby/person-naming
; records why). The owner answered the same day; the Russian is verbatim in DECISIONS.md, "The base
; of the 10% and the referral top list, the owner's answers of 2026-09-26". In translation: "remove
; the top and close the address". Enforced as the operator read it:
;   * THE ADDRESS. get_leaderboard (ROUTE_IMPLEMENTATION) calls check_admin as its first statement,
;     exactly as the loyalty leaderboard has since R1 (turbobaby/loyalty-ledger,
;     LEADERBOARD_GATE_SITES), and reads its query string only after the gate, through a fallible
;     Query extractor: a caller without admin proof gets check_admin's 401, or 429 once the admin
;     limiter trips, whatever query he sends -- the status, content type and bytes R1's route gives
;     him, compared on PostgreSQL by LEADERBOARD_GATE_WITNESS, which also shows one limiter behind
;     both routes. An admin is served as before; his malformed query is a bare 400, as an unknown
;     period already was. The route stays registered, and no row is read or written differently.
;   * THE TOP. The referral page (src/ui/pages/referrals.rs) neither fetches the address nor renders
;     the list, and the four keys only the list used are retired, each line of src/trios/i18n.rs one
;     for one by a comment line (turbobaby/locale-policy counts them). The rest of the page stands:
;     the link, the three counters, the referral balance with its two requests, the friends panel.
;   * THE ADMIN SCREEN reads no referral top: its Loyalty tab reads R1's leaderboard, and its
;     referral panel reads the four admin routes of turbobaby/referral-credit. Nothing there changed.
;   * THE BOT'S /refstats BUTTON opens the referral page and was labelled with the locale field
;     referral_leaderboard, a chart glyph and the word leaderboard, after the list the page no
;     longer has. It now carries referrals_open_app, the label every referral notification already
;     gives a button to the same page; no sentence was written. referral_leaderboard stays in both
;     bot locales, read by nobody, like the other stopped strings (REFSTATS_BUTTON_WITNESS).
; What an admin is served still carries the whole id and the frozen total; the answer changed who is
; served, not what. A customer is served no other account's id by any of the five routes now.
pub const OWNER_TOP_LIST_ANSWER_AT : str = "2026-09-26";
pub const OWNER_TOP_LIST_ANSWER_WORDS : str = "Remove the top and close the address";
pub const LEADERBOARD_ROUTE_GATE : u8 = 2;
; Bound by gate 3: get_leaderboard's first statement is the admin gate, the shape R1's row binds.
pub const LEADERBOARD_GATE_SITES : u8 = 1;
pub const LEADERBOARD_ANSWERS_A_NON_ADMIN_AS_R1_DOES : bool = true;
pub const LEADERBOARD_QUERY_IS_READ_AFTER_THE_GATE : bool = true;
pub const LEADERBOARD_ROUTE_STAYS_REGISTERED : bool = true;
pub const LEADERBOARD_ROWS_TOUCHED : u8 = 0;
pub const A_CUSTOMER_IS_SERVED_ANOTHER_ACCOUNT_ID : bool = false;
pub const TOP_LIST_READERS_IN_THE_MINI_APP : u8 = 0;
pub const TOP_LIST_READERS_IN_THE_MINI_APP_BEFORE_THE_ANSWER : u8 = 1;
pub const ADMIN_SCREEN_READS_THE_REFERRAL_TOP : bool = false;
pub const TOP_LIST_KEYS_RETIRED : [4]str = ["referral.top", "referral.empty_leaderboard", "referral.id_mask", "referral.row_meta"];
pub const TOP_LIST_KEYS_RETIRED_WITNESS : str = "src/trios/i18n.rs the_referral_top_list_keys_stay_retired";
pub const TOP_LIST_CLIENT_WITNESS : str = "tests/referral_credit_client_wiring.rs the_top_referrers_list_is_gone_and_the_rest_of_the_page_stands";
pub const ADMIN_ONLY_READ_FETCH_WITNESS : str = "tests/ui_endpoints_exist.rs an_admin_only_read_is_fetched_by_the_admin_screen_alone";
pub const LEADERBOARD_GATE_WIRING_WITNESS : str = "tests/referral_credit_wiring.rs the_referral_leaderboard_is_admin_only_like_r1";
pub const LEADERBOARD_GATE_WITNESS : str = "tests/integration_closed_reads.rs the_referral_leaderboard_answers_an_admin_only_like_r1";
pub const REFSTATS_BUTTON_LABEL_FIELD : str = "referrals_open_app";
pub const REFSTATS_BUTTON_LABEL_FIELD_BEFORE_THE_ANSWER : str = "referral_leaderboard";
pub const REFSTATS_BUTTON_LABEL_WORDED_FOR_IT : bool = false;
pub const REFSTATS_BUTTON_WITNESS : str = "tests/referral_credit_wiring.rs the_refstats_button_no_longer_promises_a_leaderboard";

; --- Tests -----------------------------------------------------------------------------------------

test r3_a_referral_writes_no_points_and_offers_no_rung {
  assert OWNER_R3_DECIDED_AT == "2026-09-26";
  assert CREDITS_TO_THE_REFERRER_SINCE_2026_09_26 == 0;
  assert CREDITS_TO_THE_INVITEE_SINCE_2026_09_26 == 0;
  assert REFERRAL_TX_TYPE_WRITERS_SINCE_2026_09_26 == 0;
  assert MILESTONE_AWARD_WRITERS == 0;
  assert MILESTONE_OFFERS_SERVED == 0;
  assert CONFIRMATION_KEPT_WITHOUT_MONEY == true;
  assert CONFIRMATION_SITES_SINCE_2026_09_26 == 2;
  assert CREDITED_POINTS_KEPT == true;
  assert CREDIT_RECHECKS_THE_SELF_EDGE == true;
  assert PAYOUT_RECHECKS_THE_SELF_EDGE == false;
  assert THIS_FILE_DECLARES_AN_AMOUNT == false;
  assert PAYS_IN_BONUS_CURRENCY == false;
  assert PAYS_IN_BONUS_CURRENCY_BEFORE_2026_09_26 == true;
  assert PAYS_IN_THE_THB_REFERRAL_CREDIT == true;
  assert points_a_confirmation_credits(true, CREDITS_TO_THE_REFERRER, CREDITS_TO_THE_INVITEE) == LEDGER_TX_TYPE_COUNT;
  assert points_a_confirmation_credits(false, CREDITS_TO_THE_REFERRER, CREDITS_TO_THE_INVITEE) == 0;
  assert PAYOUT_CALL_SITE == "src/db/orders.rs:400-423";
  assert PAYOUT_CALL_SITE_BEFORE_2026_09_26 == "src/db/orders.rs:423-489";
  assert A_COMMENT_CLAIMS_A_PAID_WRITER == false;
  assert A_COMMENT_CLAIMS_A_PAID_WRITER_BEFORE_2026_09_26 == true;
}


