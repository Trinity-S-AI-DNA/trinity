// SPDX-License-Identifier: Apache-2.0
; specs/turbobaby/happy_hour.t27 -- the time-windowed discount served at GET /api/happy-hour
; BOUNDARY. This file owns four things and nothing else: the shape of the window (which
; endpoint of it is inclusive, whether it may wrap past midnight, at what granularity the
; boundary moves), the admissibility of a discount percentage, what the endpoint serves when
; the stored configuration cannot be read, and how far the resulting number actually travels.
; It owns no clock, no currency, no price and no rental discount axis.
; --
; WHY (measured 2026-09-21). The reader at src/api/happy_hour.rs:38 looks for four keys under
; a nested object config["happy_hour"] -- enabled, start, end, discount. The only configuration
; this repository ships writes four keys with different names at the top level of the same blob
; (migrations/001_initial.sql:98 happy_hour_start=14, :99 happy_hour_end=17, :100
; happy_hour_enabled=false, :101 happy_hour_discount=10), and migrations/001_initial.sql is
; embedded and run at startup (src/db/mod.rs:32). ZERO of the four keys the reader looks for
; exist in the shipped blob, so every read falls through to its literal:
; src/api/happy_hour.rs:39-41 yields enabled=false, start=18, end=21 and :43 yields discount
; 0.0. The window the endpoint publishes -- 18:00 to 21:00 -- is therefore a pair of unwrap_or
; literals, and the only hours any file in this tree states as the shop's are 14 and 17. That
; is D9 and D11 arriving through the front door in the shape D18 warned about: a published fact
; whose whole provenance is that somebody typed it into a fallback. Published, not measured as
; seen: this repository's own HTTP client mentions a path under /api on 21 lines
; (src/ui/api/client.rs) and none of them is /happy-hour, and the five occurrences of the word
; happy anywhere under src/ui/ are the phrase "happy path" in screen doc comments
; (src/ui/screens/home_screen.rs:48, orders_screen.rs:65, order_detail_screen.rs:84,
; profile_screen.rs:313, success_screen.rs:61). Who sees the window is therefore a question
; about clients outside this tree, and this file does not answer it.
; The nested shape the reader wants is written by nothing: it appears only
; inside this file's own unit tests (src/api/happy_hour.rs:160, :172, :180, :188, :207, :214,
; :221, :228, :235), and the canonical defaults blob for this table carries no happy-hour key at
; all (src/trios/loyalty.rs:34-46). Nine green tests over a shape no deployment holds.
; --
; WHERE THE BRIEF IS REFUTED. The brief, following DECISIONS.md:319-321, names this file as one
; of five carrying a hardcoded +7 that the market profile does not reach, and the market
; contract repeats the claim with a line citation into this implementation. Measured 2026-09-21
; the claim is false of all five. src/api/happy_hour.rs:1 imports the profile and :34 derives
; the hour from it; src/api/share.rs:137, src/promo.rs:260, src/api/orders.rs:257 and
; src/ui/screens/events_screen.rs:63-65 do the same; tests/market_clock_wiring.rs:29-37 pins
; seven such sites, two more than D18 could enumerate, and tests/market_clock_wiring.rs:230 pins
; the Rust profile to the seed by reading the JSON. The tripwire is not the one issue #35 names.
; What remains is that the clock is a build-time const (src/trios/market.rs:63-67, :72) and no
; file under src/ reads the seed's market block at runtime: editing data/fleet_seed.json alone
; moves no window, and the agreement between the three copies is held by a Rust test and a
; Python verifier (scripts/verify_fleet_seed.py:89-91) rather than by a read. That is the gap
; pinned below, and it is a smaller and truer one than the brief's.
; --
; WHAT THIS FILE NEVER DOES. It invents no window and no percentage: every hour and every
; percent below carries a file:line, and the file's job is to say which of them the endpoint
; actually publishes -- not who reads it, which is measured here as nobody in this tree and
; left open outside it. It restates no timezone and no offset -- turbobaby/market owns TH_TIMEZONE,
; TH_UTC_OFFSET_HOURS and TH_DST, and the wall-clock hour arrives here as an argument. It never
; makes a discount into a price: turbobaby/pricing-honesty owns price authority, and a percent
; with no rate to stand on emits nothing. It adds no third discount axis to a rental --
; turbobaby/rental-terms owns the term bands and the class discount, and the measurement below
; is that this one reaches no rental line at all. It carries no person-level data, no plate, no
; renter and no named unit.
; phi^2 + 1/phi^2 = 3 | TRINITY

module turbobaby-happy-hour;

pub const KIND : str = "contract";
pub const ID : str = "turbobaby/happy-hour";
pub const NAME : str = "TurboBaby happy hour: a windowed discount that reaches no price";
pub const IMPLEMENTATION : str = "src/api/happy_hour.rs";
pub const ENDPOINT : str = "GET /api/happy-hour";
pub const CONFIG_STORE : str = "loyalty_config singleton row id=1, JSONB column config";
pub const MEASURED_AT : str = "2026-09-21";
pub const DECISIONS : [3]str = ["D9", "D11", "D18"];

; --- Reuse edges -------------------------------------------------------------------------------
; No import exists in this language and none is wanted. A neighbour is named by its ID and by
; the NAME of the declaration that owns the decision, never by a line number. The reason,
; re-measured 2026-09-21 from the git history rather than from memory: the 43 files of this
; corpus arrived in six commits, the two largest waves being ten contracts and then the thirteen
; this file belongs to, and citations written by line between files being edited in parallel
; went stale inside an hour. The convention earned itself again during this edit. Every
; declaration turbobaby/market owns that is named below moved line the same morning --
; TH_TIMEZONE, TH_UTC_OFFSET_HOURS, TH_DST and utc_offset_is_real each by exactly forty-two
; lines -- and not one citation in this file had to change, because not one of them is a
; number.
pub const REUSES_MARKET_ID : str = "turbobaby/market";
pub const REUSES_PRICING_ID : str = "turbobaby/pricing-honesty";
pub const REUSES_RENTAL_TERMS_ID : str = "turbobaby/rental-terms";
pub const REUSES_CATALOG_API_ID : str = "turbobaby/catalog-api";

pub const MARKET_OWNS : str = "turbobaby/market owns TH_TIMEZONE, TH_UTC_OFFSET_HOURS, TH_DST and the utc_offset_is_real bound. The wall-clock hour enters this contract as an i64 argument and the DST case as a bool; no offset appears below.";
pub const PRICING_OWNS : str = "turbobaby/pricing-honesty owns PRICE_AUTHORITY, the absent/present tag set and the rule that an absent rate renders as DASH and never as zero. A discount is not a price authority: applied to an absent rate it produces nothing, not a discounted nothing.";
pub const RENTAL_TERMS_OWNS : str = "turbobaby/rental-terms owns the term-discount bands, SCOOTER_CLASS_DISCOUNT_BP, MOTORCYCLE_CLASS_DISCOUNT_BP and CLASS_TERM_COMPOSITION_IS_PINNED. That last one read false until 2026-09-21, when the owner's published formula pinned the composition as base times season times term step, and this sentence used to lean on the false reading. The finding below never rested on it: it measures that no third discount axis exists in this tree, which is a statement about what is here and not about whether the two axes that are compose. A third axis would still be an invention, and for the same reason.";
pub const CATALOG_API_OWNS : str = "turbobaby/catalog-api owns the HTTP status vocabulary -- HTTP_OK, HTTP_INTERNAL_ERROR and the rest of that set -- and the rule its invariant catalog_api_query_parser_failure_never_becomes_a_default states. This endpoint takes no query parameter at all, so that rule is named and not re-derived; STATUS_OK and STATUS_INTERNAL_ERROR below are this endpoint's two answers under local names, carrying the same numbers and adding no sixth status to that vocabulary.";

; --- The clock this window is computed on (D18) --------------------------------------------------
; src/api/happy_hour.rs:25-30 asks the declared market for the wall-clock hour of a UTC instant
; and falls back to the UTC hour when the market cannot be reduced to a fixed offset. That
; refusal belongs to turbobaby/market; what belongs here is its consequence for a customer: a
; window computed on the fallback is not the shop's window, it is a window on another clock.
pub const HOUR_SOURCE_MARKET : u8 = 1;
pub const HOUR_SOURCE_UTC_FALLBACK : u8 = 2;
pub const HOUR_SOURCE_COUNT : u8 = 2;

; src/api/happy_hour.rs:26-29: Some(local) -> local.hour(), None -> utc.hour().
pub fn hour_source(market_has_fixed_offset: bool) u8 {
  if (market_has_fixed_offset) {
    return HOUR_SOURCE_MARKET;
  }
  return HOUR_SOURCE_UTC_FALLBACK;
}

pub fn window_is_the_shops_own(market_has_fixed_offset: bool) bool {
  return hour_source(market_has_fixed_offset) == HOUR_SOURCE_MARKET;
}

; --- The D18 tripwire, as measured rather than as briefed ------------------------------------------
; DECISIONS.md:319-321 lists five files holding a hardcoded +7; DECISIONS.md:351 calls the set
; unwired debt under issue #35. src/api/happy_hour.rs:1 and :34 read the profile instead, and
; tests/market_clock_wiring.rs:29-37 guards seven sites. The residual gap is narrower and real.
pub const D18_NAMES_THIS_IMPLEMENTATION : bool = true;
pub const D18_HARDCODED_OFFSET_CLAIM_STILL_HOLDS : bool = false;
pub const D18_COUNTED_OFFSET_SITES : u8 = 5;
pub const WIRING_GUARD_COUNTED_SITES : u8 = 7;
pub const MARKET_CLOCK_IS_WIRED : bool = true;
; No file under src/ opens data/fleet_seed.json; every mention of it there is a doc comment.
pub const MARKET_BLOCK_RUNTIME_READERS : u8 = 0;
pub const CLOCK_IS_A_BUILD_TIME_CONST : bool = true;
pub const CLOCK_PIN_KIND : str = "seed pinned to the Rust const by tests/market_clock_wiring.rs and to the contract by scripts/verify_fleet_seed.py:89-91, the three clock rows of its market field map; neither is a read";

; A seed edit reaches the customer only through a rebuild, because nothing reads it at runtime.
pub fn seed_edit_moves_the_window(runtime_reads_the_seed: bool, rebuilt: bool) bool {
  return runtime_reads_the_seed or rebuilt;
}

; --- The window ------------------------------------------------------------------------------------
; src/api/happy_hour.rs:42 is the whole rule: enabled && current_hour >= start && current_hour
; < end. The start is inclusive, the end is exclusive, and the comparison reads an hour only --
; src/api/happy_hour.rs:25-30 takes .hour() and discards the minute, so the boundary moves on
; the hour and never inside it. src/api/happy_hour.rs:177-183 is the repository's own witness
; that hour 21 is outside an 18/21 window.
pub const HOUR_MIN : i64 = 0;
pub const HOUR_MAX : i64 = 23;
pub const HOURS_PER_DAY : i64 = 24;
pub const START_IS_INCLUSIVE : bool = true;
pub const END_IS_INCLUSIVE : bool = false;
pub const GRANULARITY_MINUTES : i64 = 60;
pub const MINUTE_IS_READ : bool = false;

pub fn hour_is_on_the_clock(hour: i64) bool {
  return hour >= HOUR_MIN and hour <= HOUR_MAX;
}

pub fn window_contains_hour(start: i64, end: i64, hour: i64) bool {
  return hour >= start and hour < end;
}

; A window whose start is not strictly before its end admits no hour at all.
; src/api/happy_hour.rs:233-238 pins the 21/18 case as inactive, which is the honest reading of
; the operator but also means an evening window that crosses midnight is silently dead rather
; than refused.
pub const MIDNIGHT_WRAP_IS_SERVED : bool = false;

pub fn window_is_empty(start: i64, end: i64) bool {
  return start >= end;
}

; What the contract requires of a stored window. src/api/happy_hour.rs:40-41 checks none of it:
; as_i64().unwrap_or(..) accepts any integer the blob holds, so a start of -5 or an end of 99 is
; served verbatim. An end of 24 is legal and means "until midnight"; an end of 0 is not.
pub const WINDOW_BOUNDS_ARE_CHECKED_IN_SRC : bool = false;
pub const END_HOUR_MIN : i64 = 1;

pub fn window_bounds_are_legal(start: i64, end: i64) bool {
  return hour_is_on_the_clock(start) and end >= END_HOUR_MIN and end <= HOURS_PER_DAY and start < end;
}

pub fn happy_hour_active(enabled: bool, start: i64, end: i64, hour: i64) bool {
  return enabled and window_contains_hour(start, end, hour);
}

; --- The discount ------------------------------------------------------------------------------------
; src/api/happy_hour.rs:43-48: the stored value is clamped to [0, 100] and a non-finite value
; becomes 0.0 rather than propagating. The percentage is served as a fraction-capable number
; while the only code that would apply it takes a whole percent (src/trios/store.rs:274,
; Option<u32>), so a stored 12.5 could not survive the handoff -- latent only, because the
; handoff does not exist.
pub const PERCENT_MIN : i64 = 0;
pub const PERCENT_MAX : i64 = 100;
pub const NON_FINITE_DISCOUNT_BECOMES_ZERO : bool = true;
pub const SERVED_DISCOUNT_IS_FRACTIONAL : bool = true;
pub const APPLIED_DISCOUNT_IS_WHOLE_PERCENT : bool = true;
pub const FRACTIONAL_PERCENT_SURVIVES_THE_HANDOFF : bool = false;

pub fn clamp_discount_percent(percent: i64) i64 {
  if (percent < PERCENT_MIN) {
    return PERCENT_MIN;
  }
  if (percent > PERCENT_MAX) {
    return PERCENT_MAX;
  }
  return percent;
}

; src/api/happy_hour.rs:71-77 serves the configured percentage whether or not the window is
; open: `active` is the only thing that closes it. A consumer that reads `discount` without
; reading `active` shows a discount that is not in force, which is why the rule is written
; here as a function and not left to the caller.
pub const DISCOUNT_IS_SERVED_WHEN_CLOSED : bool = true;
pub const ACTIVE_IS_THE_ONLY_GATE : bool = true;

pub fn discount_in_force(active: bool, served_percent: i64) i64 {
  if (!active) {
    return PERCENT_MIN;
  }
  return clamp_discount_percent(served_percent);
}

; src/trios/store.rs:307-313 is the only arithmetic in the tree that spends this number:
; total - total * d / 100, in integers, truncating. Truncation of the discount AMOUNT rounds
; the customer's saving down, so the rounding favours the shop. The witness below is arithmetic
; on this contract's own function, not a claim about any shipped total.
; UNITS. The arithmetic is integer and scale-free: it holds for any integer unit the caller
; passes, and this file chooses none. The applier's own operand is an i64 whole unit
; (src/trios/pricing.rs:384-386, was :328-330, records that prices and totals are i64 in the domain, naming
; ProductPrice.price and calculate_cart_total), and the minor-digit count that would relate a
; whole unit to a minor one belongs to turbobaby/market, which owns the money half of the
; profile. The _minor suffix follows the corpus spelling for an integer amount and is not a
; claim that this deployment displays a subunit.
pub fn discount_amount_minor(subtotal_minor: i64, percent: i64) i64 {
  return subtotal_minor * clamp_discount_percent(percent) / 100;
}

pub fn discounted_total_minor(subtotal_minor: i64, percent: i64) i64 {
  return subtotal_minor - discount_amount_minor(subtotal_minor, percent);
}

pub const ROUNDING_FAVOURS_THE_SHOP : bool = true;
pub const ROUNDING_WITNESS_SUBTOTAL_MINOR : i64 = 999;
pub const ROUNDING_WITNESS_PERCENT : i64 = 10;
pub const ROUNDING_WITNESS_GRANTED_TENTHS : i64 = 990;
pub const ROUNDING_WITNESS_EXACT_TENTHS : i64 = 999;

; --- What absence produces (D9, D11) ---------------------------------------------------------------
; turbobaby/pricing-honesty forbids an absent rate rendering as zero, because a zero rate reads
; FREE. A discount is the other direction: zero percent is the identity on a price, so an absent
; discount rendered as zero changes nothing and lies about nothing. A window has no identity
; element. Rendering an absent window as 18/21 is therefore a claim, and it is the one absence
; in this endpoint that must be refused rather than defaulted. Stating the difference explicitly
; is the point: without it a later reader "fixes" this file to match its neighbour and either
; refuses a harmless zero or admits a harmful window.
pub const KIND_DISCOUNT : u8 = 1;
pub const KIND_RATE : u8 = 2;
pub const KIND_WINDOW : u8 = 3;
pub const ABSENCE_KIND_COUNT : u8 = 3;

pub fn zero_is_the_identity(kind: u8) bool {
  return kind == KIND_DISCOUNT;
}

pub fn absence_may_render_zero(kind: u8) bool {
  return zero_is_the_identity(kind);
}

pub const ABSENT_WINDOW_MAY_RENDER_A_DEFAULT : bool = false;

; --- The shipped configuration gap ------------------------------------------------------------------
; The headline measurement. Reader keys: src/api/happy_hour.rs:38-43. Shipped keys:
; migrations/001_initial.sql:98-101, embedded and executed at src/db/mod.rs:32. The admin write
; path replaces the whole blob (src/api/loyalty.rs:772-784) after validating four unrelated flat
; keys (src/api/loyalty.rs:717-732), and the canonical defaults for the blob carry no happy-hour
; key (src/trios/loyalty.rs:34-46), so no surface in this repository produces the nested shape.
; The two arrays are ordered to face each other key for key, not in file order: reader key i and
; seeded key i are the same setting spelled two ways. Reader order is src/api/happy_hour.rs:39,
; :40, :41, :43; the seeded keys sit at migrations/001_initial.sql:100, :98, :99, :101 in that
; same meaning order. The pairwise test below is what makes CONFIG_SHAPES_AGREE checkable
; instead of merely asserted.
pub const READER_CONFIG_PATH : str = "config.happy_hour.{enabled,start,end,discount}";
pub const READER_CONFIG_KEYS : [4]str = ["enabled", "start", "end", "discount"];
pub const SEEDED_CONFIG_KEYS : [4]str = ["happy_hour_enabled", "happy_hour_start", "happy_hour_end", "happy_hour_discount"];
pub const CONFIG_KEY_COUNT : u8 = 4;
pub const CONFIG_SHAPES_AGREE : bool = false;
pub const READER_KEYS_FOUND_IN_SHIPPED_BLOB : u8 = 0;
pub const NESTED_SHAPE_WRITERS_IN_SRC : u8 = 0;
pub const NESTED_SHAPE_LITERALS_ARE_TESTS_ONLY : bool = true;
pub const GREEN_TESTS_OVER_THE_UNSHIPPED_SHAPE : u8 = 9;

; migrations/001_initial.sql:100, :98, :99, :101 in that order.
pub const SEEDED_ENABLED : bool = false;
pub const SEEDED_START_HOUR : i64 = 14;
pub const SEEDED_END_HOUR : i64 = 17;
pub const SEEDED_DISCOUNT_PERCENT : i64 = 10;

; src/api/happy_hour.rs:39-43, and the same pair again in the no-row arm at :79-85.
pub const FALLBACK_ENABLED : bool = false;
pub const FALLBACK_START_HOUR : i64 = 18;
pub const FALLBACK_END_HOUR : i64 = 21;
pub const FALLBACK_DISCOUNT_PERCENT : i64 = 0;
; 18 and 21 appear in this repository as unwrap_or literals (src/api/happy_hour.rs:40-41, :83-84)
; and as test fixtures. One further mention exists and is not a source: src/api/happy_hour.rs:14
; names an 18:00 to 21:00 happy hour as an illustrative example inside the doc comment explaining
; why the offset must come from the market, prefixed "e.g." and asserting nothing. No migration,
; no seed and no document states these hours as the shop's; migrations/001_initial.sql:98-99
; states 14 and 17, and data/fleet_seed.json carries no happy-hour key at all.
pub const FALLBACK_WINDOW_HAS_A_SOURCE : bool = false;

pub fn served_start_hour(reader_finds_the_shape: bool, stored_start: i64) i64 {
  if (reader_finds_the_shape) {
    return stored_start;
  }
  return FALLBACK_START_HOUR;
}

pub fn served_end_hour(reader_finds_the_shape: bool, stored_end: i64) i64 {
  if (reader_finds_the_shape) {
    return stored_end;
  }
  return FALLBACK_END_HOUR;
}

pub fn shipped_served_start_hour() i64 {
  return served_start_hour(CONFIG_SHAPES_AGREE, SEEDED_START_HOUR);
}

pub fn shipped_served_end_hour() i64 {
  return served_end_hour(CONFIG_SHAPES_AGREE, SEEDED_END_HOUR);
}

; What this contract requires instead: an unreadable configuration yields an ABSENT window, and
; the endpoint says so. src/api/happy_hour.rs:40-41 and :83-84 both yield hours instead.
pub const WINDOW_ABSENT : u8 = 0;
pub const WINDOW_HOURS : u8 = 1;
pub const SRC_SERVES_HOURS_WHEN_ABSENT : bool = true;

pub fn window_to_serve(row_present: bool, shape_agrees: bool, bounds_legal: bool) u8 {
  if (!row_present) {
    return WINDOW_ABSENT;
  }
  if (!shape_agrees) {
    return WINDOW_ABSENT;
  }
  if (!bounds_legal) {
    return WINDOW_ABSENT;
  }
  return WINDOW_HOURS;
}

; --- How far the number travels -----------------------------------------------------------------------
; src/trios/store.rs:271-316 is the only function in the tree that spends a happy-hour percent,
; and it is called from five places, all of them its own unit tests (src/trios/store.rs:674,
; :692, :725, :732, :743). No file under src/ui/, assets/ or e2e/ fetches the endpoint. The
; discount is therefore published and unspent: a published number with no customer price behind
; it. That is the honest refusal this file declares in place of an effect it cannot find.
pub const APPLIER : str = "src/trios/store.rs:271-316 calculate_cart_total";
pub const APPLIER_PRODUCTION_CALL_SITES : u8 = 0;
pub const APPLIER_TEST_CALL_SITES : u8 = 5;
pub const HTTP_CONSUMERS_IN_REPO : u8 = 0;
pub const DISCOUNT_REACHES_A_PRICE : bool = false;
; The separate, stronger fact about the client rather than the applier: src/ui/api/client.rs is
; this repository's own HTTP client and mentions a path under /api on 21 lines, none of them
; /happy-hour. "Customer-visible" is therefore a word this file does not use of the window: the
; endpoint publishes it and nothing in this tree renders it.
pub const UI_CLIENT_FETCHES_THIS_ENDPOINT : bool = false;
; RE-POINTED 2026-09-24: the five src/trios/store.rs call sites cited above moved fifteen lines
; down when served_zone_id was added above that file's test module; nothing they point at changed.

pub fn reaches_a_customer_price(http_consumers: u8, production_appliers: u8) bool {
  return http_consumers >= 1 or production_appliers >= 1;
}

; Even wired, the applier would not touch a rental: src/trios/store.rs:279-301 branches over
; five line kinds and no branch is a bike or a rental term. So happy hour is not a third axis
; against the two turbobaby/rental-terms owns, and the composition question that contract leaves
; open is not widened by this one.
pub const APPLIER_LINE_KINDS : [5]str = ["set", "accessory", "tea", "tea_set", "strain"];
pub const APPLIER_LINE_KIND_COUNT : u8 = 5;
pub const RENTAL_LINES_ARE_DISCOUNTED : bool = false;
pub const IS_A_THIRD_RENTAL_DISCOUNT_AXIS : bool = false;
; src/trios/store.rs:280, :286, :292, :298, :300 -- a line whose price is missing contributes 0
; to the subtotal the discount is then taken off. D9's forbidden construct, inside the discount's
; own path. Named here because this contract measured it; the fix belongs to the cart owner.
pub const APPLIER_MISSING_PRICE_BECOMES_ZERO : bool = true;

; --- The transport ---------------------------------------------------------------------------------------
; src/api/happy_hour.rs:8 mounts one route under the /api nest (src/api/mod.rs:77, :92). A
; database error is 500 (src/api/happy_hour.rs:58-64); everything else, including a missing
; singleton row, is 200 with a body (src/api/happy_hour.rs:66-86). Absence is not a 404 here.
; u16 rather than i64, and the reason is a corpus measurement rather than a preference.
; Re-measured 2026-09-21 across all 43 files: NINE contracts declare an HTTP status constant and
; every one of them types it u16 -- turbobaby/cart-persistence, turbobaby/catalog-api,
; turbobaby/client-errors, turbobaby/events-booking, turbobaby/order-status,
; turbobaby/publication, turbobaby/request-identity, turbobaby/upload-media and this file. Not
; one HTTP status anywhere in the corpus is declared at any other width. An earlier version of
; this sentence named three of the nine and read as though three were the whole corpus; all
; three it named are real, but a subset presented as a census is the shape a false absence takes
; when nobody re-runs it. The u8 STATUS_ constants elsewhere in the corpus -- unit availability,
; order status, referral status -- are domain enumerations rather than HTTP, and are counted
; here as neither. A status typed wider than the corpus types it is the kind of drift that makes
; two contracts uncomparable for no gain.
pub const STATUS_OK : u16 = 200;
pub const STATUS_INTERNAL_ERROR : u16 = 500;
pub const MISSING_ROW_STATUS : u16 = 200;
pub const NOT_FOUND_IS_SERVED : bool = false;
pub const HTTP_STATUS_DECLARING_CONTRACTS : u8 = 9;
pub const HTTP_STATUS_CONTRACTS_USING_U16 : u8 = 9;
pub const HTTP_STATUS_WIDTH_CENSUS_AT : str = "2026-09-21";
pub const CORPUS_FILES_SEARCHED : u8 = 43;

pub fn status_for(db_error: bool) u16 {
  if (db_error) {
    return STATUS_INTERNAL_ERROR;
  }
  return STATUS_OK;
}

pub const RESPONSE_FIELDS : [5]str = ["enabled", "active", "discount", "start", "end"];
pub const RESPONSE_FIELD_COUNT : u8 = 5;
pub const RESPONSE_CARRIES_A_PRICE : bool = false;
pub const RESPONSE_CARRIES_A_CURRENCY : bool = false;
; src/api/happy_hour.rs:74 serves discount as a float and :82 serves it as the integer 0, so one
; field has two JSON types depending on whether the singleton row exists.
pub const DISCOUNT_JSON_TYPE_IS_STABLE : bool = false;

; --- Refusals ---------------------------------------------------------------------------------------------
pub const NO_WINDOW_IS_CHOSEN_HERE : bool = true;
pub const NO_DISCOUNT_PERCENT_IS_CHOSEN_HERE : bool = true;
pub const NO_TIMEZONE_IS_RESTATED_HERE : bool = true;
pub const TIMEZONE_OWNER_ID : str = REUSES_MARKET_ID;
pub const PRICE_AUTHORITY_OWNER_ID : str = REUSES_PRICING_ID;

; --- Tests ------------------------------------------------------------------------------------------------

test the_reuse_edges_name_owners_and_not_this_file {
  assert REUSES_MARKET_ID == "turbobaby/market";
  assert REUSES_PRICING_ID == "turbobaby/pricing-honesty";
  assert REUSES_RENTAL_TERMS_ID == "turbobaby/rental-terms";
  assert REUSES_CATALOG_API_ID == "turbobaby/catalog-api";
  assert REUSES_MARKET_ID != ID;
  assert REUSES_PRICING_ID != ID;
  assert REUSES_RENTAL_TERMS_ID != ID;
  assert REUSES_CATALOG_API_ID != ID;
  assert TIMEZONE_OWNER_ID == REUSES_MARKET_ID;
  assert PRICE_AUTHORITY_OWNER_ID == REUSES_PRICING_ID;
}

test the_window_start_is_inclusive_and_the_end_is_not {
  assert window_contains_hour(18, 21, 18) == true;
  assert window_contains_hour(18, 21, 20) == true;
  assert window_contains_hour(18, 21, 21) == false;
  assert window_contains_hour(18, 21, 17) == false;
  assert START_IS_INCLUSIVE == true;
  assert END_IS_INCLUSIVE == false;
}

test a_window_that_would_cross_midnight_is_dead_rather_than_wrapped {
  assert window_contains_hour(21, 18, 22) == false;
  assert window_contains_hour(21, 18, 3) == false;
  assert window_contains_hour(21, 18, 19) == false;
  assert window_is_empty(21, 18) == true;
  assert window_is_empty(18, 18) == true;
  assert window_is_empty(18, 21) == false;
  assert MIDNIGHT_WRAP_IS_SERVED == false;
}

test the_contract_bounds_the_window_where_the_reader_does_not {
  assert window_bounds_are_legal(18, 21) == true;
  assert window_bounds_are_legal(0, 24) == true;
  assert window_bounds_are_legal(23, 24) == true;
  assert window_bounds_are_legal(21, 18) == false;
  assert window_bounds_are_legal(18, 18) == false;
  assert window_bounds_are_legal(0 - 5, 21) == false;
  assert window_bounds_are_legal(18, 25) == false;
  assert WINDOW_BOUNDS_ARE_CHECKED_IN_SRC == false;
}

test enabled_is_a_gate_and_not_a_window {
  assert happy_hour_active(true, 18, 21, 19) == true;
  assert happy_hour_active(false, 18, 21, 19) == false;
  assert happy_hour_active(true, 18, 21, 21) == false;
  assert happy_hour_active(false, 18, 21, 21) == false;
}

test the_boundary_moves_on_the_hour_and_never_inside_it {
  assert GRANULARITY_MINUTES == 60;
  assert MINUTE_IS_READ == false;
  assert hour_is_on_the_clock(0) == true;
  assert hour_is_on_the_clock(23) == true;
  assert hour_is_on_the_clock(24) == false;
  assert hour_is_on_the_clock(0 - 1) == false;
}

test a_dst_market_gets_a_window_on_another_clock {
  assert hour_source(true) == HOUR_SOURCE_MARKET;
  assert hour_source(false) == HOUR_SOURCE_UTC_FALLBACK;
  assert window_is_the_shops_own(true) == true;
  assert window_is_the_shops_own(false) == false;
  assert HOUR_SOURCE_COUNT == 2;
  assert HOUR_SOURCE_MARKET != HOUR_SOURCE_UTC_FALLBACK;
}

test the_hardcoded_offset_this_file_was_briefed_for_is_gone {
  assert D18_NAMES_THIS_IMPLEMENTATION == true;
  assert D18_HARDCODED_OFFSET_CLAIM_STILL_HOLDS == false;
  assert MARKET_CLOCK_IS_WIRED == true;
  assert WIRING_GUARD_COUNTED_SITES > D18_COUNTED_OFFSET_SITES;
  assert NO_TIMEZONE_IS_RESTATED_HERE == true;
}

test the_gap_that_remains_is_a_build_and_not_a_read {
  assert MARKET_BLOCK_RUNTIME_READERS == 0;
  assert CLOCK_IS_A_BUILD_TIME_CONST == true;
  assert seed_edit_moves_the_window(false, false) == false;
  assert seed_edit_moves_the_window(false, true) == true;
  assert seed_edit_moves_the_window(true, false) == true;
}

test the_discount_is_clamped_and_only_counts_while_the_window_is_open {
  assert clamp_discount_percent(10) == 10;
  assert clamp_discount_percent(0 - 10) == PERCENT_MIN;
  assert clamp_discount_percent(150) == PERCENT_MAX;
  assert discount_in_force(true, 10) == 10;
  assert discount_in_force(false, 10) == PERCENT_MIN;
  assert discount_in_force(true, 150) == PERCENT_MAX;
  assert DISCOUNT_IS_SERVED_WHEN_CLOSED == true;
}

test the_discount_arithmetic_matches_the_only_applier_in_the_tree {
  assert discount_amount_minor(2000, 20) == 400;
  assert discounted_total_minor(2000, 20) == 1600;
  assert discounted_total_minor(2000, 100) == 0;
  assert discounted_total_minor(2000, 0) == 2000;
  assert discounted_total_minor(2000, 150) == 0;
  assert discounted_total_minor(2000, 0 - 10) == 2000;
}

test truncation_rounds_the_saving_down_and_the_customer_pays_the_difference {
  assert discount_amount_minor(ROUNDING_WITNESS_SUBTOTAL_MINOR, ROUNDING_WITNESS_PERCENT) == 99;
  assert discount_amount_minor(999, 10) * 10 == ROUNDING_WITNESS_GRANTED_TENTHS;
  assert ROUNDING_WITNESS_GRANTED_TENTHS < ROUNDING_WITNESS_EXACT_TENTHS;
  assert discounted_total_minor(999, 10) == 900;
  assert ROUNDING_FAVOURS_THE_SHOP == true;
}

test zero_is_honest_for_a_discount_and_dishonest_for_a_rate_or_a_window {
  assert absence_may_render_zero(KIND_DISCOUNT) == true;
  assert absence_may_render_zero(KIND_RATE) == false;
  assert absence_may_render_zero(KIND_WINDOW) == false;
  assert zero_is_the_identity(KIND_DISCOUNT) == true;
  assert ABSENT_WINDOW_MAY_RENDER_A_DEFAULT == false;
  assert ABSENCE_KIND_COUNT == 3;
  assert KIND_DISCOUNT != KIND_RATE;
  assert KIND_RATE != KIND_WINDOW;
}

test the_shipped_blob_and_the_reader_look_for_different_keys {
  assert READER_CONFIG_KEYS[0] == "enabled";
  assert READER_CONFIG_KEYS[1] == "start";
  assert READER_CONFIG_KEYS[2] == "end";
  assert READER_CONFIG_KEYS[3] == "discount";
  assert SEEDED_CONFIG_KEYS[0] == "happy_hour_enabled";
  assert SEEDED_CONFIG_KEYS[1] == "happy_hour_start";
  assert SEEDED_CONFIG_KEYS[2] == "happy_hour_end";
  assert SEEDED_CONFIG_KEYS[3] == "happy_hour_discount";
  assert READER_CONFIG_KEYS[0] != SEEDED_CONFIG_KEYS[0];
  assert READER_CONFIG_KEYS[1] != SEEDED_CONFIG_KEYS[1];
  assert READER_CONFIG_KEYS[2] != SEEDED_CONFIG_KEYS[2];
  assert READER_CONFIG_KEYS[3] != SEEDED_CONFIG_KEYS[3];
  assert CONFIG_SHAPES_AGREE == false;
  assert READER_KEYS_FOUND_IN_SHIPPED_BLOB == 0;
  assert NESTED_SHAPE_WRITERS_IN_SRC == 0;
  assert NESTED_SHAPE_LITERALS_ARE_TESTS_ONLY == true;
  assert GREEN_TESTS_OVER_THE_UNSHIPPED_SHAPE == 9;
  assert CONFIG_KEY_COUNT == 4;
}

test the_window_the_customer_sees_is_not_the_window_anybody_stored {
  assert shipped_served_start_hour() == FALLBACK_START_HOUR;
  assert shipped_served_end_hour() == FALLBACK_END_HOUR;
  assert shipped_served_start_hour() != SEEDED_START_HOUR;
  assert shipped_served_end_hour() != SEEDED_END_HOUR;
  assert served_start_hour(true, SEEDED_START_HOUR) == 14;
  assert served_end_hour(true, SEEDED_END_HOUR) == 17;
  assert FALLBACK_WINDOW_HAS_A_SOURCE == false;
}

test an_unreadable_configuration_owes_an_absence_and_not_a_pair_of_hours {
  assert window_to_serve(true, true, true) == WINDOW_HOURS;
  assert window_to_serve(false, true, true) == WINDOW_ABSENT;
  assert window_to_serve(true, false, true) == WINDOW_ABSENT;
  assert window_to_serve(true, true, false) == WINDOW_ABSENT;
  assert SRC_SERVES_HOURS_WHEN_ABSENT == true;
}

test the_published_discount_reaches_no_price_in_this_repository {
  assert APPLIER_PRODUCTION_CALL_SITES == 0;
  assert APPLIER_TEST_CALL_SITES == 5;
  assert HTTP_CONSUMERS_IN_REPO == 0;
  assert reaches_a_customer_price(HTTP_CONSUMERS_IN_REPO, APPLIER_PRODUCTION_CALL_SITES) == false;
  assert reaches_a_customer_price(1, 0) == true;
  assert reaches_a_customer_price(0, 1) == true;
  assert DISCOUNT_REACHES_A_PRICE == false;
  assert UI_CLIENT_FETCHES_THIS_ENDPOINT == false;
}

test happy_hour_is_not_a_third_axis_on_a_rental {
  assert RENTAL_LINES_ARE_DISCOUNTED == false;
  assert IS_A_THIRD_RENTAL_DISCOUNT_AXIS == false;
  assert APPLIER_LINE_KIND_COUNT == 5;
  assert APPLIER_MISSING_PRICE_BECOMES_ZERO == true;
}

test the_endpoint_answers_two_statuses_and_calls_absence_a_success {
  assert status_for(false) == STATUS_OK;
  assert status_for(true) == STATUS_INTERNAL_ERROR;
  assert status_for(false) == MISSING_ROW_STATUS;
  assert NOT_FOUND_IS_SERVED == false;
  assert RESPONSE_FIELD_COUNT == 5;
  assert RESPONSE_CARRIES_A_PRICE == false;
  assert RESPONSE_CARRIES_A_CURRENCY == false;
  assert DISCOUNT_JSON_TYPE_IS_STABLE == false;
}

; The width census, declared so the next reader inherits a number instead of an impression.
; A subset named as though it were the corpus is the defect this test exists to prevent
; recurring: the two counts below are equal because every declaring contract was counted, not
; because three convenient ones agreed.
test every_contract_that_declares_an_http_status_types_it_the_same_width {
  assert HTTP_STATUS_DECLARING_CONTRACTS == 9;
  assert HTTP_STATUS_CONTRACTS_USING_U16 == HTTP_STATUS_DECLARING_CONTRACTS;
  assert CORPUS_FILES_SEARCHED == 43;
  assert HTTP_STATUS_WIDTH_CENSUS_AT == "2026-09-21";
  assert HTTP_STATUS_DECLARING_CONTRACTS < CORPUS_FILES_SEARCHED;
  assert STATUS_OK == 200;
  assert STATUS_INTERNAL_ERROR == 500;
}

test the_two_percent_representations_disagree_where_a_fraction_would_live {
  assert SERVED_DISCOUNT_IS_FRACTIONAL == true;
  assert APPLIED_DISCOUNT_IS_WHOLE_PERCENT == true;
  assert FRACTIONAL_PERCENT_SURVIVES_THE_HANDOFF == false;
  assert NON_FINITE_DISCOUNT_BECOMES_ZERO == true;
}

; --- Invariants --------------------------------------------------------------------------------------------

invariant the_window_end_is_never_inclusive
  assert window_contains_hour(18, 21, 21) == false and END_IS_INCLUSIVE == false

invariant the_window_start_is_always_inclusive
  assert window_contains_hour(18, 21, 18) == true and START_IS_INCLUSIVE == true

invariant a_window_whose_start_is_not_before_its_end_admits_no_hour
  assert window_contains_hour(21, 18, 22) == false and window_contains_hour(21, 18, 3) == false and window_contains_hour(18, 18, 18) == false

invariant a_disabled_happy_hour_is_never_active_at_any_hour
  assert happy_hour_active(false, 18, 21, 19) == false and happy_hour_active(false, 0, 24, 0) == false

invariant a_closed_window_puts_no_percentage_in_force
  assert discount_in_force(false, 100) == PERCENT_MIN

invariant no_served_percentage_can_leave_the_closed_unit_interval
  assert clamp_discount_percent(0 - 1) == PERCENT_MIN and clamp_discount_percent(PERCENT_MAX + 1) == PERCENT_MAX

invariant a_full_discount_zeroes_the_total_and_never_goes_below_it
  assert discounted_total_minor(2000, 100) == 0 and discounted_total_minor(2000, 150) == 0

invariant truncation_never_grants_more_than_the_exact_saving
  assert discount_amount_minor(999, 10) * 10 < 999 * 10 * 10 / 100

invariant an_absent_rate_is_never_zero_and_an_absent_discount_may_be
  assert absence_may_render_zero(KIND_RATE) == false and absence_may_render_zero(KIND_DISCOUNT) == true

invariant an_absent_window_is_never_a_pair_of_default_hours
  assert absence_may_render_zero(KIND_WINDOW) == false and ABSENT_WINDOW_MAY_RENDER_A_DEFAULT == false

invariant the_shipped_window_is_not_the_stored_window
  assert shipped_served_start_hour() != SEEDED_START_HOUR and shipped_served_end_hour() != SEEDED_END_HOUR

invariant the_served_default_window_has_no_source_in_the_tree
  assert FALLBACK_WINDOW_HAS_A_SOURCE == false and READER_KEYS_FOUND_IN_SHIPPED_BLOB == 0

invariant an_unreadable_configuration_yields_an_absence_on_every_branch
  assert window_to_serve(false, true, true) == WINDOW_ABSENT and window_to_serve(true, false, true) == WINDOW_ABSENT and window_to_serve(true, true, false) == WINDOW_ABSENT

invariant the_discount_reaches_no_customer_price
  assert reaches_a_customer_price(HTTP_CONSUMERS_IN_REPO, APPLIER_PRODUCTION_CALL_SITES) == false and DISCOUNT_REACHES_A_PRICE == false and UI_CLIENT_FETCHES_THIS_ENDPOINT == false

invariant no_third_rental_discount_axis_is_declared_here
  assert IS_A_THIRD_RENTAL_DISCOUNT_AXIS == false and RENTAL_LINES_ARE_DISCOUNTED == false

invariant a_window_read_on_the_utc_fallback_is_not_the_shops_window
  assert window_is_the_shops_own(false) == false and hour_source(false) == HOUR_SOURCE_UTC_FALLBACK

invariant a_seed_edit_alone_moves_nothing
  assert seed_edit_moves_the_window(false, false) == false and MARKET_BLOCK_RUNTIME_READERS == 0

invariant this_contract_names_its_neighbours_and_is_none_of_them
  assert REUSES_MARKET_ID != ID and REUSES_PRICING_ID != ID and REUSES_RENTAL_TERMS_ID != ID and REUSES_CATALOG_API_ID != ID

invariant absence_of_the_singleton_row_is_answered_as_success
  assert status_for(false) == MISSING_ROW_STATUS and NOT_FOUND_IS_SERVED == false

invariant nothing_here_publishes_a_price_or_a_currency
  assert RESPONSE_CARRIES_A_PRICE == false and RESPONSE_CARRIES_A_CURRENCY == false and NO_DISCOUNT_PERCENT_IS_CHOSEN_HERE == true
