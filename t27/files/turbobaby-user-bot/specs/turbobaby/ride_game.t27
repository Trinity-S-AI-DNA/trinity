pub const ROSTER_OUTCOME_IS_PLAYER_VISIBLE : bool = true;
pub const EMPTY_ROSTER_IS_CLASSIFIED_DIFFERENTLY_BY_THE_RUNTIME : bool = true;
pub const RIDE_RUNTIME_EDGE_NOTE : str = "turbobaby/ride-runtime at specs/turbobaby/ride_runtime.t27 declares the host event kinds and the four unavailable reason codes, and consumes this file's roster and handling decisions as booleans. Measured 2026-09-20: the four boundaries are the same four in both files, and the classification differs on one of them. An empty filtered roster is ROSTER_OUTCOME_EMPTY here, a player-visible state that is not a failure, and UNAVAILABLE_EMPTY there, a reason under EVENT_UNAVAILABLE. That is a boundary between two contracts and not a drift between a copy and an owner, so it is named rather than pinned: no invariant here can hold the runtime's numbers, and one that tried would be this file legislating for another.";

