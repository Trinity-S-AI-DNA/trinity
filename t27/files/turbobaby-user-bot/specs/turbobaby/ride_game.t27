; --- The seven copies, re-verified element by element after the corpus grew ----------------------
; The audit above was taken on 2026-09-20 against a corpus of 12 tracked specs. 31 more were
; tracked on 2026-09-21, and ALL THREE copy owners were edited that day: deposit-tiers gained 350
; committed lines, and all three carry further edits in the working tree -- availability +72/-13,
; bike-catalog +44/-5, deposit-tiers +78/-17 -- from the same day's work on their own files. A
; copy audit whose owners have all been edited since it was taken is not an audit any more, it is
; a memory of one, so all seven were run again element by element rather than assumed to have
; held. The re-run was made against the WORKING TREE, after those edits, and not against the last
; commit: the tree is what the next reader compiles.
; ALL SEVEN STILL AGREE, and the re-run is the same measurement and not a lighter one: the two
; published sha256 extracts both reproduce byte for byte, the three displacement declaration lines
; are still byte-identical, the four class discriminants still sort and diff clean, and the three
; name-differing rosters still hold their owners' values -- forza-300 with mt-03-300, the single
; click-125, and 11 with 26. What the three owners gained was prose and re-measurement, and not
; one of them touched a table this file copies.
; WHAT THIS DATE DOES NOT DO. It does not refresh MEASURED_AT, which belongs to the fleet reading
; of 2026-09-12, and it does not refresh COPIES_MEASURED_AT, which belongs to the day the audit was
; written. Three dates, three measurements, and none of them renews another.
pub const COPIES_REVERIFIED_AT : str = "2026-09-21";
pub const COPIES_REVERIFIED_COUNT : u8 = 7;
pub const COPIES_FOUND_DRIFTED : u8 = 0;
pub const COPY_OWNERS_EDITED_SINCE_THE_FIRST_MEASUREMENT : u8 = 3;
pub const COPY_OWNER_COUNT : u8 = 3;
pub const TRACKED_SPECS_WHEN_THE_COPIES_WERE_FIRST_MEASURED : u8 = 12;
pub const TRACKED_SPECS_AT_REVERIFICATION : u8 = 43;
pub const ELEVEN_KEY_FAMILY_ARRAYS_ELSEWHERE_IN_SPECS : u8 = 0;
; RE-VERIFIED A SECOND TIME 2026-09-24, on the change that dropped the displacement copy. The six
; copies that remain were compared value by value with their owners' declarations: the class
; algebra with bike-catalog's CLASSES, CLASS_SCOOTER, CLASS_MOTORCYCLE, CLASS_COUNT and CLASS_NONE;
; CATALOG_KEYS with availability's FAMILY_KEYS; PRICE_LIST_ONLY_KEYS with deposit-tiers' array of
; that name and the zero with availability's PRICE_LIST_ONLY_UNITS; the two exclusion rosters with
; OFFERED_OUT_ON_CONTRACT_KEYS and NOT_OFFERED_KEYS; and 11 with 26 against BOOKABLE_FAMILIES and
; FLEET_AVAILABLE. All six agree. The re-run of 2026-09-21 above counted seven, which was every copy
; there was that day, and it keeps its own constants.
pub const COPIES_REVERIFIED_ON_RESOLUTION_AT : str = "2026-09-24";
pub const COPIES_REVERIFIED_ON_RESOLUTION : u8 = 6;
pub const COPIES_FOUND_DRIFTED_ON_RESOLUTION : u8 = 0;

; A re-run counts only if it covered every copy and found every one of them agreeing. Written as a
; function so that a worker who finds a drift writes the number and watches the assert fail,
; instead of editing the booleans above one at a time.
pub fn every_copy_still_agrees(copies_checked: u8, copies_drifted: u8) bool {
  return copies_checked == COPY_COUNT and copies_drifted == 0;
}

pub const SMALL_ROSTER_COPY_NOTE : str = "Three smaller copies, all measured 2026-09-20 and all agreeing in value while differing in name. EXCLUDED_NONE_FREE holds the same two keys as OFFERED_OUT_ON_CONTRACT_KEYS in specs/turbobaby/availability.t27. EXCLUDED_NOT_OFFERED holds the same single key as NOT_OFFERED_KEYS in specs/turbobaby/deposit_tiers.t27. RIDEABLE_FAMILIES_AT_MEASURED_AT and RIDEABLE_UNITS_AT_MEASURED_AT are the same two measured numbers, 11 and 26, as BOOKABLE_FAMILIES and FLEET_AVAILABLE in specs/turbobaby/availability.t27. A copy that differs only in name is the one grep cannot find, which is why each of the three is pinned by an invariant below. RE-VERIFIED 2026-09-21, value by value: OFFERED_OUT_ON_CONTRACT_KEYS is still forza-300 then mt-03-300, NOT_OFFERED_KEYS is still the single click-125, and BOOKABLE_FAMILIES and FLEET_AVAILABLE still read 11 and 26. None of the three moved. Change here only in the commit that changes the owner.";

; The owner's decision arrives as parameters, exactly as bookability does: this function knows
; nothing about which vocabulary it is checking, and so cannot be the place a table is restated.
pub fn copy_tracks_owner(copy_len: u8, owner_len: u8, first_matches: bool, last_matches: bool) bool {
  return copy_len == owner_len and first_matches and last_matches;
}

; The rule as a function rather than a sentence. An untouched copy is always legal, which is why
; the unchanged case returns true -- the same shape as selected_row_respects_live_gate above, and
; for the same reason: a claim nobody made needs no validation.
pub fn copy_edit_is_legal(copy_changed: bool, owner_changed_in_same_commit: bool) bool {
  if (!copy_changed) {
    return true;
  }
  return owner_changed_in_same_commit;
}

; --- Tests -------------------------------------------------------------------------------------

test the_module_names_its_own_world {
  assert KIND == "game";
  assert ID == "turbobaby/ride-game";
  assert WORLD == "gHashTag/turbobaby-user-bot";
  assert MEASURED_AT == "2026-09-12";
}

; The three families issue #20 asks to be pinned, chosen with DISTINCT displacements for the
; reason given in the header. Both classes are covered: nmax-155 and xmax-300 are scooters,
; cb-650r is a motorcycle. Each cc is the family's displacement_cc as the seed records it.
test handling_of_three_real_families {
  // nmax-155, scooter, displacement_cc 155
  assert top_speed(155) == 555;
  assert steer_rate(CLASS_SCOOTER) == 120;
  // xmax-300, scooter, displacement_cc 300
  assert top_speed(300) == 700;
  // cb-650r, motorcycle, displacement_cc 650
  assert top_speed(650) == 1050;
  assert steer_rate(CLASS_MOTORCYCLE) == 90;
  // and across these three distinct displacements the top speed does increase strictly
  assert top_speed(155) < top_speed(300);
  assert top_speed(300) < top_speed(650);
}

; The whole domain the fleet exhibits, as a ladder. Six strict steps over seven values -- the seven
; of turbobaby/bike-catalog's DISPLACEMENTS_CC, each passed as a bare displacement.
test every_distinct_displacement_climbs {
  assert top_speed(125) == 525;
  assert top_speed(155) == 555;
  assert top_speed(300) == 700;
  assert top_speed(350) == 750;
  assert top_speed(400) == 800;
  assert top_speed(650) == 1050;
  assert top_speed(750) == 1150;
  assert top_speed(125) < top_speed(155);
  assert top_speed(155) < top_speed(300);
  assert top_speed(300) < top_speed(350);
  assert top_speed(350) < top_speed(400);
  assert top_speed(400) < top_speed(650);
  assert top_speed(650) < top_speed(750);
}

; The tie the issue's acceptance criterion could not accommodate, pinned as intended
; behaviour. These three families share a displacement and a class, so they share one
; handling pair, and this spec does not reach for `body` to separate them.
test the_three_650_families_share_one_handling_pair {
  assert CATALOG_KEYS[10] == "cb-650r";
  assert CATALOG_KEYS[11] == "cbr-650r";
  assert CATALOG_KEYS[12] == "vulcan-s-650";
  assert top_speed(650) == 1050;
  assert steer_rate(CLASS_MOTORCYCLE) == 90;
}

; Issue #13's acceptance: the smallest and the largest engine must measurably differ. They
; differ in top speed by exactly the displacement span. They do NOT differ in steering, and
; that is the seed's doing rather than an oversight: KB_faq classes the 750 X-ADV with the
; scooters, so both rows read class scooter. click-125 is also not rideable at all, which is
; why this is an arithmetic check on the function and not a claim about a playable bike.
test the_smallest_and_largest_engines_differ {
  assert top_speed(125) == 525;
  assert top_speed(750) == 1150;
  // xadv-750 and click-125: the families at the two extremes the catalog reports.
  assert top_speed(750) - top_speed(125) == 625;
  assert top_speed(750) - top_speed(125) == (750 - 125) * SPEED_PER_CC_GU;
}

test steer_rate_separates_the_two_classes {
  assert CLASS_NAMES[0] == "scooter";
  assert CLASS_NAMES[1] == "motorcycle";
  assert steer_rate(CLASS_SCOOTER) == STEER_RATE_SCOOTER_SU;
  assert steer_rate(CLASS_MOTORCYCLE) == STEER_RATE_MOTORCYCLE_SU;
  assert steer_rate(CLASS_SCOOTER) > steer_rate(CLASS_MOTORCYCLE);
}

; Two unknown codes, not one: 2 is the first value past the domain, and CLASS_NONE is the
; code the catalog spec's own guard returns. This spec answers a number nobody can ride with;
; ride.js expresses the same refusal as null before any rider can mount.
test an_unknown_class_is_refused_not_defaulted {
  assert steer_rate(2) == STEER_RATE_NO_SUCH_CLASS;
  assert steer_rate(2) < 0;
  assert steer_rate(CLASS_NONE) == STEER_RATE_NO_SUCH_CLASS;
  assert CLASS_NONE == 255;
  assert CLASS_NONE > CLASS_MOTORCYCLE;
  assert STEER_RATE_SCOOTER_SU > 0;
  assert STEER_RATE_MOTORCYCLE_SU > 0;
}

test the_mapping_is_one_function {
  const h = handling(155, CLASS_SCOOTER);
  assert h.top_speed_gu == 555;
  assert h.steer_rate_su == 120;
}

; The subset claim, witnessed key by key: every rideable family, and the catalog row it came
; from. Eleven lines, no membership operator, nothing implied.
test every_rideable_family_is_in_the_catalog {
  assert RIDEABLE_KEYS[0] == CATALOG_KEYS[1];
  assert RIDEABLE_KEYS[1] == CATALOG_KEYS[2];
  assert RIDEABLE_KEYS[2] == CATALOG_KEYS[3];
  assert RIDEABLE_KEYS[3] == CATALOG_KEYS[6];
  assert RIDEABLE_KEYS[4] == CATALOG_KEYS[7];
  assert RIDEABLE_KEYS[5] == CATALOG_KEYS[8];
  assert RIDEABLE_KEYS[6] == CATALOG_KEYS[9];
  assert RIDEABLE_KEYS[7] == CATALOG_KEYS[10];
  assert RIDEABLE_KEYS[8] == CATALOG_KEYS[11];
  assert RIDEABLE_KEYS[9] == CATALOG_KEYS[12];
  assert RIDEABLE_KEYS[10] == CATALOG_KEYS[13];
}

; The three catalog rows the rule leaves out, named rather than counted, with the seed's
; reason attached in the comments above each array.
test the_families_excluded_from_riding_are_named {
  assert EXCLUDED_NOT_OFFERED[0] == "click-125";
  assert EXCLUDED_NOT_OFFERED[0] == CATALOG_KEYS[0];
  assert EXCLUDED_NONE_FREE[0] == "forza-300";
  assert EXCLUDED_NONE_FREE[0] == CATALOG_KEYS[4];
  assert EXCLUDED_NONE_FREE[1] == "mt-03-300";
  assert EXCLUDED_NONE_FREE[1] == CATALOG_KEYS[5];
}

test the_price_list_only_families_can_never_be_ridden {
  assert PRICE_LIST_ONLY_KEYS[0] == "pcx-150";
  assert PRICE_LIST_ONLY_KEYS[6] == "r7";
  assert PRICE_LIST_ONLY_KEYS.len == 7;
  assert PRICE_LIST_ONLY_UNITS_TOTAL == 0;
  assert PRICE_LIST_ONLY_UNITS_TOTAL < MIN_UNITS_AVAILABLE_TO_RIDE;
}

test the_measured_counts_are_the_seeds_own {
  assert RIDEABLE_FAMILIES_AT_MEASURED_AT == 11;
  // 5+1+1+3+6+5+1+1+1+1+1, which is the seed's totals.units_available
  assert RIDEABLE_UNITS_AT_MEASURED_AT == 26;
  assert RIDEABLE_KEYS.len == RIDEABLE_FAMILIES_AT_MEASURED_AT;
}

test the_game_offers_no_bike_it_cannot_hand_over {
  assert HAS_FALLBACK_FAMILY == false;
  assert FALLBACK_FAMILY == "";
  assert ON_NONE_RIDEABLE == "show a named empty state and mount no bike";
  assert LABEL_TEXT_SOURCE == "brand, model and variant_label from the catalog row";
}

test live_row_gate_requires_offer_and_stock {
  assert RIDE_BOOKABILITY_OWNER_ID == "turbobaby/availability";
  assert RIDEABLE_RULE == "offered == true AND units_available >= MIN_UNITS_AVAILABLE_TO_RIDE, re-read at mount time";
  assert MIN_UNITS_AVAILABLE_TO_RIDE == 1;
  assert selected_row_respects_live_gate(true, true) == true;
  assert selected_row_respects_live_gate(true, false) == false;
}

test a_drifted_selection_is_rejected_by_the_live_gate {
  assert EXCLUDED_NONE_FREE[0] == "forza-300";
  assert selected_row_respects_live_gate(true, true) == true;
  assert selected_row_respects_live_gate(true, false) == false;
  assert selected_row_respects_live_gate(false, false) == true;
}

test empty_and_unavailable_are_explicit_zero_rider_states {
  assert roster_outcome(true, true, true, 1) == ROSTER_OUTCOME_READY;
  assert roster_outcome(true, true, true, 0) == ROSTER_OUTCOME_EMPTY;
  assert roster_outcome(true, true, false, 0) == ROSTER_OUTCOME_EMPTY;
  assert roster_outcome(false, true, true, 1) == ROSTER_OUTCOME_UNAVAILABLE;
  assert roster_outcome(true, false, true, 1) == ROSTER_OUTCOME_UNAVAILABLE;
  assert roster_outcome(true, true, false, 1) == ROSTER_OUTCOME_UNAVAILABLE;
  assert mounted_rider_count(ROSTER_OUTCOME_READY, 11) == 11;
  assert mounted_rider_count(ROSTER_OUTCOME_EMPTY, 0) == 0;
  assert mounted_rider_count(ROSTER_OUTCOME_UNAVAILABLE, 11) == 0;
  assert ride_can_start(ROSTER_OUTCOME_READY, 1) == true;
  assert ride_can_start(ROSTER_OUTCOME_EMPTY, 0) == false;
  assert ride_can_start(ROSTER_OUTCOME_UNAVAILABLE, 11) == false;
}

test the_replacement_has_no_checkout_or_price_side_effect {
  assert LEGACY_GARDEN_WROTE_FROM_ORDER == true;
  assert LEGACY_GARDEN_FORCED_NONEMPTY_STATE == true;
  assert RIDE_WRITES_TO_ORDER_PATH == false;
  assert RIDE_EMITS_CLIENT_PRICE == false;
  assert HAS_FALLBACK_FAMILY == false;
}


; --- Ownership edge tests (added 2026-09-20) -----------------------------------------------------

; The four owners, asserted rather than merely declared. Without an import a REUSES_ string is the
; only way this file names another contract's territory, and a string nothing checks is a comment
; with a type. The inequalities are the point: the owner named is someone ELSE, so a copy-paste
; that pointed one of them back at this module would fail here.
test the_copied_vocabularies_name_their_owners {
  assert REUSES_CATALOG_ID == "turbobaby/bike-catalog";
  assert REUSES_DEPOSIT_TIERS_ID == "turbobaby/deposit-tiers";
  assert REUSES_RENTAL_TERMS_ID == "turbobaby/rental-terms";
  assert RIDE_BOOKABILITY_OWNER_ID == "turbobaby/availability";
  assert REUSES_CATALOG_ID != ID;
  assert REUSES_DEPOSIT_TIERS_ID != ID;
  assert REUSES_RENTAL_TERMS_ID != ID;
  assert RIDE_BOOKABILITY_OWNER_ID != ID;
  assert REUSES_CATALOG_ID != REUSES_DEPOSIT_TIERS_ID;
  assert REUSES_DEPOSIT_TIERS_ID != REUSES_RENTAL_TERMS_ID;
  assert CATALOG_OWNER_PATH == "specs/turbobaby/bike_catalog.t27";
  assert AVAILABILITY_OWNER_PATH == "specs/turbobaby/availability.t27";
  assert DEPOSIT_TIERS_OWNER_PATH == "specs/turbobaby/deposit_tiers.t27";
}

; The class algebra against its owner's declared values. The array is the case a name search
; misses: it is CLASSES there and CLASS_NAMES here, so only the values can be compared.
test the_class_algebra_copy_tracks_the_catalog {
  assert CLASS_NAMES.len == CATALOG_OWNED_CLASS_LEN;
  assert CLASS_NAMES[0] == CATALOG_OWNED_CLASS_FIRST;
  assert CLASS_NAMES[1] == CATALOG_OWNED_CLASS_LAST;
  assert CLASS_SCOOTER == CATALOG_OWNED_CLASS_SCOOTER;
  assert CLASS_MOTORCYCLE == CATALOG_OWNED_CLASS_MOTORCYCLE;
  assert CLASS_COUNT == CATALOG_OWNED_CLASS_COUNT;
  assert CLASS_NONE == CATALOG_OWNED_CLASS_NONE;
  assert CATALOG_OWNED_CLASS_ARRAY_NAME == "CLASSES";
  assert copy_tracks_owner(CLASS_NAMES.len, CATALOG_OWNED_CLASS_LEN, CLASS_NAMES[0] == CATALOG_OWNED_CLASS_FIRST, CLASS_NAMES[1] == CATALOG_OWNED_CLASS_LAST) == true;
  assert CLASS_ALGEBRA_COPY_AGREES == true;
}

; The displacement domain is the catalog's, named and not copied since 2026-09-24. What this file
; keeps is the edge and the names it dropped; the law never needed the list.
test the_displacement_domain_is_consumed_from_the_catalog {
  assert DISPLACEMENT_DOMAIN_IS_DECLARED_HERE == false;
  assert REUSES_CATALOG_ID == "turbobaby/bike-catalog";
  assert CATALOG_OWNER_PATH == "specs/turbobaby/bike_catalog.t27";
  assert CATALOG_DISPLACEMENT_DECLARATIONS.len == 3;
  assert CATALOG_DISPLACEMENT_DECLARATIONS[0] == "DISPLACEMENTS_CC";
  assert CATALOG_DISPLACEMENT_DECLARATIONS[1] == "DISPLACEMENT_MIN_CC";
  assert CATALOG_DISPLACEMENT_DECLARATIONS[2] == "DISPLACEMENT_MAX_CC";
  assert DISPLACEMENT_RESTATEMENT_DROPPED.len == 6;
  assert DISPLACEMENT_RESTATEMENT_DROPPED[0] == CATALOG_DISPLACEMENT_DECLARATIONS[0];
  assert DISPLACEMENT_RESTATEMENT_DROPPED[1] == CATALOG_DISPLACEMENT_DECLARATIONS[1];
  assert DISPLACEMENT_RESTATEMENT_DROPPED[2] == CATALOG_DISPLACEMENT_DECLARATIONS[2];
  assert DISPLACEMENT_RESTATEMENT_DROPPED[3] == "CATALOG_OWNED_DISPLACEMENT_LEN";
  assert DISPLACEMENT_RESTATEMENT_DROPPED[4] == "CATALOG_OWNED_DISPLACEMENT_FIRST_CC";
  assert DISPLACEMENT_RESTATEMENT_DROPPED[5] == "CATALOG_OWNED_DISPLACEMENT_LAST_CC";
  assert DISPLACEMENT_RESTATEMENT_DROPPED_AT == "2026-09-24";
  assert DISPLACEMENT_DOMAIN_COPY_AGREES_BEFORE_2026_09_24 == true;
  assert COPY_NAMES_BEFORE_2026_09_24[1] == "displacement domain";
  assert COPY_COUNT + 1 == COPY_COUNT_BEFORE_2026_09_24;
}

; The largest of THIS FILE'S seven copies, and the one the measurement hashed. It read "the largest
; copy in the corpus" until 2026-09-21, which was never a measurement: nothing had been measured
; over the corpus, only over these seven, and the corpus has grown from 12 tracked specs to 43
; since. The narrower sentence is the one that was actually taken, so it is the one that stands.
test the_catalog_key_copy_tracks_availability {
  assert CATALOG_KEYS.len == AVAILABILITY_OWNED_KEY_LEN;
  assert CATALOG_KEYS[0] == AVAILABILITY_OWNED_KEY_FIRST;
  assert CATALOG_KEYS[13] == AVAILABILITY_OWNED_KEY_LAST;
  assert AVAILABILITY_OWNED_KEY_ARRAY_NAME == "FAMILY_KEYS";
  assert AVAILABILITY_OWNED_KEY_LEN == 14;
  assert copy_tracks_owner(CATALOG_KEYS.len, AVAILABILITY_OWNED_KEY_LEN, CATALOG_KEYS[0] == AVAILABILITY_OWNED_KEY_FIRST, CATALOG_KEYS[13] == AVAILABILITY_OWNED_KEY_LAST) == true;
  assert CATALOG_KEYS_COPY_AGREES == true;
}

test the_price_list_only_copy_tracks_deposit_tiers {
  assert PRICE_LIST_ONLY_KEYS.len == DEPOSIT_OWNED_PRICE_LIST_LEN;
  assert PRICE_LIST_ONLY_KEYS[0] == DEPOSIT_OWNED_PRICE_LIST_FIRST;
  assert PRICE_LIST_ONLY_KEYS[6] == DEPOSIT_OWNED_PRICE_LIST_LAST;
  assert PRICE_LIST_ONLY_UNITS_TOTAL == AVAILABILITY_OWNED_PRICE_LIST_UNITS;
  assert DEPOSIT_OWNED_PRICE_LIST_UNITS_BEFORE_2026_09_24 == AVAILABILITY_OWNED_PRICE_LIST_UNITS;
  assert DEPOSIT_OWNED_PRICE_LIST_ARRAY_NAME == "PRICE_LIST_ONLY_KEYS";
  assert copy_tracks_owner(PRICE_LIST_ONLY_KEYS.len, DEPOSIT_OWNED_PRICE_LIST_LEN, PRICE_LIST_ONLY_KEYS[0] == DEPOSIT_OWNED_PRICE_LIST_FIRST, PRICE_LIST_ONLY_KEYS[6] == DEPOSIT_OWNED_PRICE_LIST_LAST) == true;
  assert PRICE_LIST_ONLY_COPY_AGREES == true;
}

; The three copies that differ from their owners in nothing but the constant name.
test the_small_roster_copies_track_their_owners {
  assert EXCLUDED_NONE_FREE.len == AVAILABILITY_OWNED_OUT_LEN;
  assert EXCLUDED_NONE_FREE[0] == AVAILABILITY_OWNED_OUT_FIRST;
  assert EXCLUDED_NONE_FREE[1] == AVAILABILITY_OWNED_OUT_LAST;
  assert AVAILABILITY_OWNED_OUT_ARRAY_NAME == "OFFERED_OUT_ON_CONTRACT_KEYS";
  assert EXCLUDED_NOT_OFFERED.len == DEPOSIT_OWNED_NOT_OFFERED_LEN;
  assert EXCLUDED_NOT_OFFERED[0] == DEPOSIT_OWNED_NOT_OFFERED_ONLY;
  assert DEPOSIT_OWNED_NOT_OFFERED_ARRAY_NAME == "NOT_OFFERED_KEYS";
  assert RIDEABLE_FAMILIES_AT_MEASURED_AT == AVAILABILITY_OWNED_BOOKABLE_FAMILIES;
  assert RIDEABLE_UNITS_AT_MEASURED_AT == AVAILABILITY_OWNED_FLEET_AVAILABLE;
  assert OUT_ON_CONTRACT_COPY_AGREES == true;
  assert NOT_OFFERED_COPY_AGREES == true;
  assert BOOKABLE_COUNTS_COPY_AGREES == true;
}

; RIDEABLE_KEYS is the control case and the reason this section is an audit rather than a
; confession: it is the one roster this file measured for itself, and no other contract declares
; an eleven-key family array anywhere in specs/.
; RE-MEASURED 2026-09-21 over all 43 tracked specs, because that sentence was first taken over 12
; and an absence measured on a smaller corpus is the one claim a reader accepts without checking.
; It still holds. The corpus contains exactly one other eleven-element array of any type --
; bike-catalog's FORBIDDEN_UNIT_FIELDS, the field names a unit record may never carry -- and it is
; a roster of forbidden FIELDS, not of families. RIDEABLE_KEYS appears under that name in no other
; file either.
test the_one_roster_this_file_owns_is_not_in_the_copy_list {
  assert RIDEABLE_KEYS.len == RIDEABLE_FAMILIES_AT_MEASURED_AT;
  assert RIDEABLE_KEYS.len != AVAILABILITY_OWNED_KEY_LEN;
  assert COPY_COUNT == 6;
  assert COPY_NAMES.len == COPY_COUNT;
  assert COPY_NAMES[0] == "class algebra";
  assert COPY_NAMES[5] == "bookable counts";
  assert COPY_NAMES_BEFORE_2026_09_24.len == COPY_COUNT_BEFORE_2026_09_24;
  assert ELEVEN_KEY_FAMILY_ARRAYS_ELSEWHERE_IN_SPECS == 0;
}

; The re-run, and the two dates it must not be confused with. The owner count is the assert that
; says the re-run was not vacuous: every one of the three copy owners was edited between the two
; measurements, so the second one had somewhere to find a drift and found none.
test every_copy_was_reverified_against_its_owner_after_the_corpus_grew {
  assert COPIES_REVERIFIED_AT == "2026-09-21";
  assert COPIES_REVERIFIED_AT != COPIES_MEASURED_AT;
  assert COPIES_REVERIFIED_AT != MEASURED_AT;
  assert COPIES_REVERIFIED_COUNT == COPY_COUNT_BEFORE_2026_09_24;
  assert COPIES_REVERIFIED_ON_RESOLUTION == COPY_COUNT;
  assert COPIES_REVERIFIED_ON_RESOLUTION_AT != COPIES_REVERIFIED_AT;
  assert COPIES_FOUND_DRIFTED == 0;
  assert COPY_OWNERS_EDITED_SINCE_THE_FIRST_MEASUREMENT == 3;
  assert COPY_OWNER_COUNT == 3;
  assert COPY_OWNERS_EDITED_SINCE_THE_FIRST_MEASUREMENT == COPY_OWNER_COUNT;
  assert TRACKED_SPECS_WHEN_THE_COPIES_WERE_FIRST_MEASURED == 12;
  assert TRACKED_SPECS_AT_REVERIFICATION == 43;
  assert TRACKED_SPECS_AT_REVERIFICATION > TRACKED_SPECS_WHEN_THE_COPIES_WERE_FIRST_MEASURED;
  assert every_copy_still_agrees(COPIES_REVERIFIED_ON_RESOLUTION, COPIES_FOUND_DRIFTED_ON_RESOLUTION) == true;
  assert every_copy_still_agrees(COPIES_REVERIFIED_ON_RESOLUTION, 1) == false;
  assert every_copy_still_agrees(5, 0) == false;
  assert every_copy_still_agrees(COPIES_REVERIFIED_COUNT, COPIES_FOUND_DRIFTED) == false;
  assert CLASS_ALGEBRA_COPY_AGREES == true;
  assert DISPLACEMENT_DOMAIN_COPY_AGREES_BEFORE_2026_09_24 == true;
  assert CATALOG_KEYS_COPY_AGREES == true;
  assert PRICE_LIST_ONLY_COPY_AGREES == true;
  assert OUT_ON_CONTRACT_COPY_AGREES == true;
  assert NOT_OFFERED_COPY_AGREES == true;
  assert BOOKABLE_COUNTS_COPY_AGREES == true;
}

; The transport array shrank and the pinned value did not. Both halves are asserted, because the
; reassuring half alone would read as though nothing had happened upstream.
test the_owners_filter_array_changed_and_the_pinned_value_survived {
  assert CATALOG_API_FILTER_COUNT_AT_FIRST_MEASUREMENT == 5;
  assert CATALOG_API_FILTER_COUNT_AT_REMEASUREMENT == 4;
  assert CATALOG_API_FILTER_COUNT_AT_REMEASUREMENT < CATALOG_API_FILTER_COUNT_AT_FIRST_MEASUREMENT;
  assert CATALOG_API_FILTER_ARRAY_CHANGED_UNDER_THIS_EDGE == true;
  assert CATALOG_API_OWNED_FILTER_VALUE_SURVIVED == true;
  assert CATALOG_API_OWNED_AVAILABLE_ONLY_FILTER == "available_only";
  assert CATALOG_API_OWNED_LIST_ENDPOINT == "GET /api/bikes";
  assert RIDEABLE_SOURCE_IS_A_COMPOSED_ROUTE == true;
  assert COPY_COUNT == 6;
}

; The rule itself. A copy may change only in the commit that changes its owner; an untouched copy
; is legal whatever the owner did.
test a_copy_may_not_be_edited_without_its_owner {
  assert copy_edit_is_legal(false, false) == true;
  assert copy_edit_is_legal(false, true) == true;
  assert copy_edit_is_legal(true, true) == true;
  assert copy_edit_is_legal(true, false) == false;
  assert copy_tracks_owner(14, 14, true, true) == true;
  assert copy_tracks_owner(13, 14, true, true) == false;
  assert copy_tracks_owner(14, 14, false, true) == false;
  assert copy_tracks_owner(14, 14, true, false) == false;
}

; The refusal, and the date that separates the copy audit from the fleet measurement. They are
; different measurements taken on different days, and neither refreshes the other.
test no_import_form_can_replace_these_copies {
  assert SHARED_VOCABULARY_IMPORT_IS_NOT_SHIPPED == true;
  assert COPIES_MEASURED_AT == "2026-09-20";
  assert MEASURED_AT == "2026-09-12";
  assert COPIES_MEASURED_AT != MEASURED_AT;
}

; The transport edge. RIDEABLE_SOURCE is composed from the owner's path and the owner's filter
; word, and the inequality is what stops the composition from being mistaken for a copy of the
; endpoint constant itself.
test the_rideable_source_is_composed_from_the_transport_contract {
  assert REUSES_CATALOG_API_ID == "turbobaby/catalog-api";
  assert REUSES_CATALOG_API_ID != ID;
  assert CATALOG_API_OWNER_PATH == "specs/turbobaby/catalog_api.t27";
  assert CATALOG_API_OWNED_LIST_ENDPOINT == "GET /api/bikes";
  assert CATALOG_API_OWNED_AVAILABLE_ONLY_FILTER == "available_only";
  assert RIDEABLE_SOURCE == "/api/bikes?available_only=true";
  assert RIDEABLE_SOURCE != CATALOG_API_OWNED_LIST_ENDPOINT;
  assert RIDEABLE_SOURCE_IS_A_COMPOSED_ROUTE == true;
  assert COPY_COUNT == 6;
}

; The class discount pair is quoted in this file and declared in another.
test this_file_declares_no_class_discount {
  assert THIS_FILE_DECLARES_A_CLASS_DISCOUNT == false;
  assert REUSES_RENTAL_TERMS_ID == "turbobaby/rental-terms";
  assert RENTAL_TERMS_OWNER_PATH == "specs/turbobaby/rental_terms.t27";
  assert RIDE_EMITS_CLIENT_PRICE == false;
}

; The floor this file names is the floor availability enforces. The last two asserts say that
; naming it changed nothing else: the price-list-only arithmetic still falls under the same
; number, and no copy was added by writing the edge down.
test the_unit_floor_is_the_availability_owners_floor {
  assert MIN_UNITS_AVAILABLE_TO_RIDE == AVAILABILITY_OWNED_UNIT_FLOOR;
  assert AVAILABILITY_OWNED_UNIT_FLOOR == 1;
  assert MIN_UNITS_FLOOR_IS_THE_OWNERS_FLOOR == true;
  assert AVAILABILITY_OWNED_FLOOR_SITE == "has_an_available_unit returns units_available >= 1";
  assert RIDE_BOOKABILITY_OWNER_ID == "turbobaby/availability";
  assert PRICE_LIST_ONLY_UNITS_TOTAL < AVAILABILITY_OWNED_UNIT_FLOOR;
  assert COPY_COUNT == 6;
}

; The runtime neighbour, named at last. The inequality against the transport path is the cheap
; guard against a copy-paste that would have pointed this edge at the wrong file.
test the_runtime_neighbour_is_named_as_an_edge {
  assert REUSES_RIDE_RUNTIME_ID == "turbobaby/ride-runtime";
  assert REUSES_RIDE_RUNTIME_ID != ID;
  assert REUSES_RIDE_RUNTIME_ID != REUSES_CATALOG_API_ID;
  assert RIDE_RUNTIME_OWNER_PATH == "specs/turbobaby/ride_runtime.t27";
  assert RIDE_RUNTIME_OWNER_PATH != CATALOG_API_OWNER_PATH;
  assert RIDE_RUNTIME_OWNS_THE_HOST_EVENT_KINDS == true;
  assert ROSTER_OUTCOME_IS_PLAYER_VISIBLE == true;
  assert EMPTY_ROSTER_IS_CLASSIFIED_DIFFERENTLY_BY_THE_RUNTIME == true;
  assert ROSTER_OUTCOME_EMPTY != ROSTER_OUTCOME_UNAVAILABLE;
  assert COPY_COUNT == 6;
}

; --- Invariants ---------------------------------------------------------------------------------

; The issue's acceptance criterion, stated where it is true: strictly increasing in
; displacement is a property of the function, and a positive slope is the whole of it. It
; cannot be stated across families, because three families share displacement 650.
invariant top_speed_is_strictly_increasing_in_displacement
  assert SPEED_PER_CC_GU >= 1

; The load-bearing one. RIDEABLE_KEYS, EXCLUDED_NOT_OFFERED and EXCLUDED_NONE_FREE
; partition CATALOG_KEYS -- each key appears in exactly one of the three, and the position
; of every rideable key in the catalog is witnessed in the test above -- so this sum says
; that nothing rideable came from outside the catalog. A key added to the game without a
; catalog row breaks the arithmetic here instead of shipping as a playable bike.
invariant the_rideable_set_is_a_subset_of_the_catalog
  assert RIDEABLE_KEYS.len + EXCLUDED_NOT_OFFERED.len + EXCLUDED_NONE_FREE.len == CATALOG_KEYS.len

; A count of zero is always a bug (D16): if the catalog array is ever emptied by a tidy-up,
; the subset invariant above would hold vacuously with an empty game. Pinning the seed's own
; families_in_stock stops that.
invariant the_catalog_holds_the_whole_in_stock_fleet
  assert CATALOG_KEYS.len == 14

; Why the 7 price-list-only families are excluded by the rule itself and need no blacklist:
; zero units can never satisfy the availability floor.
invariant a_family_with_no_unit_can_never_be_ridden
  assert PRICE_LIST_ONLY_UNITS_TOTAL < MIN_UNITS_AVAILABLE_TO_RIDE

invariant ride_handling_class_map_is_total
  assert CLASS_NAMES.len == CLASS_COUNT

invariant an_unknown_class_yields_no_playable_rate
  assert STEER_RATE_NO_SUCH_CLASS < 0

invariant the_game_never_invents_a_bike
  assert HAS_FALLBACK_FAMILY == false

; The displacement domain is the catalog's (resolved 2026-09-24). These three used to pin a local
; copy to its own ends; they now pin the edge that replaced it, so a copy that comes back without
; this section being rewritten fails here.
invariant the_displacement_domain_is_named_and_not_declared_here
  assert DISPLACEMENT_DOMAIN_IS_DECLARED_HERE == false and CATALOG_DISPLACEMENT_DECLARATIONS.len == 3 and REUSES_CATALOG_ID == "turbobaby/bike-catalog"

invariant every_dropped_displacement_name_is_listed
  assert DISPLACEMENT_RESTATEMENT_DROPPED.len == 6 and DISPLACEMENT_RESTATEMENT_DROPPED[0] == "DISPLACEMENTS_CC" and DISPLACEMENT_RESTATEMENT_DROPPED[2] == "DISPLACEMENT_MAX_CC"

invariant the_copy_list_lost_exactly_the_displacement_domain
  assert COPY_COUNT + 1 == COPY_COUNT_BEFORE_2026_09_24 and COPY_NAMES_BEFORE_2026_09_24[1] == "displacement domain" and COPY_NAMES.len == COPY_COUNT

; The sentinel restated from bike_catalog.t27 earns its width here: it must sit outside the
; class domain, or the guard would alias onto a real class and hand back a playable rate.
invariant the_non_class_sentinel_cannot_collide_with_a_class
  assert CLASS_NONE > CLASS_MOTORCYCLE

invariant a_selected_row_requires_both_offer_and_positive_stock
  assert selected_row_respects_live_gate(true, true) == true and selected_row_respects_live_gate(true, false) == false

invariant an_empty_roster_mounts_no_default_rider
  assert mounted_rider_count(ROSTER_OUTCOME_EMPTY, 0) == 0 and HAS_FALLBACK_FAMILY == false

invariant an_unavailable_roster_cannot_mount_a_rider
  assert mounted_rider_count(ROSTER_OUTCOME_UNAVAILABLE, RIDEABLE_FAMILIES_AT_MEASURED_AT) == 0

invariant the_ride_game_cannot_write_to_checkout
  assert RIDE_WRITES_TO_ORDER_PATH == false

invariant the_ride_game_is_not_a_price_surface
  assert RIDE_EMITS_CLIENT_PRICE == false

; --- Copy invariants: a drift between a copy and its owner cannot pass silently ------------------
; One per copy, each pinning the length and both ends against the owner's declared values. These
; are the teeth of COPY_RULE: the constants above record who owns what, and these lines are what
; fails when the two stop agreeing.

invariant the_class_name_copy_holds_its_owners_length_and_ends
  assert CLASS_NAMES.len == CATALOG_OWNED_CLASS_LEN and CLASS_NAMES[0] == CATALOG_OWNED_CLASS_FIRST and CLASS_NAMES[1] == CATALOG_OWNED_CLASS_LAST

invariant the_class_discriminant_copy_holds_its_owners_codes
  assert CLASS_SCOOTER == CATALOG_OWNED_CLASS_SCOOTER and CLASS_MOTORCYCLE == CATALOG_OWNED_CLASS_MOTORCYCLE and CLASS_NONE == CATALOG_OWNED_CLASS_NONE

; Replaces the displacement copy's length-and-ends pin (2026-09-24). What the law says about the
; domain's two ends is arithmetic on the function, not a table: the speed span of the fleet's
; smallest and largest engines is the slope times their displacement span.
invariant the_top_speed_span_is_the_slope_times_the_displacement_span
  assert top_speed(750) - top_speed(125) == (750 - 125) * SPEED_PER_CC_GU

invariant the_catalog_key_copy_holds_its_owners_length_and_ends
  assert CATALOG_KEYS.len == AVAILABILITY_OWNED_KEY_LEN and CATALOG_KEYS[0] == AVAILABILITY_OWNED_KEY_FIRST and CATALOG_KEYS[13] == AVAILABILITY_OWNED_KEY_LAST

invariant the_price_list_only_copy_holds_its_owners_length_and_ends
  assert PRICE_LIST_ONLY_KEYS.len == DEPOSIT_OWNED_PRICE_LIST_LEN and PRICE_LIST_ONLY_KEYS[0] == DEPOSIT_OWNED_PRICE_LIST_FIRST and PRICE_LIST_ONLY_KEYS[6] == DEPOSIT_OWNED_PRICE_LIST_LAST

invariant the_offered_but_out_copy_holds_its_owners_length_and_ends
  assert EXCLUDED_NONE_FREE.len == AVAILABILITY_OWNED_OUT_LEN and EXCLUDED_NONE_FREE[0] == AVAILABILITY_OWNED_OUT_FIRST and EXCLUDED_NONE_FREE[1] == AVAILABILITY_OWNED_OUT_LAST

invariant the_not_offered_copy_holds_its_owners_length_and_only_key
  assert EXCLUDED_NOT_OFFERED.len == DEPOSIT_OWNED_NOT_OFFERED_LEN and EXCLUDED_NOT_OFFERED[0] == DEPOSIT_OWNED_NOT_OFFERED_ONLY

invariant the_bookable_counts_are_their_owners_two_numbers
  assert RIDEABLE_FAMILIES_AT_MEASURED_AT == AVAILABILITY_OWNED_BOOKABLE_FAMILIES and RIDEABLE_UNITS_AT_MEASURED_AT == AVAILABILITY_OWNED_FLEET_AVAILABLE

; D16's floor applied to the audit itself: an emptied COPY_NAMES would make every sentence above
; vacuously true, so the list has to keep its measured length.
invariant the_copy_list_keeps_its_measured_length
  assert COPY_NAMES.len == COPY_COUNT

invariant a_copy_edited_without_its_owner_is_illegal
  assert copy_edit_is_legal(true, false) == false

invariant the_copies_stay_only_because_no_import_form_exists
  assert SHARED_VOCABULARY_IMPORT_IS_NOT_SHIPPED == true

; The audit carries the day it was last re-run, and that day is not the day it was written. Without
; this, a copy audit taken against a corpus of twelve would go on reading as current against one of
; forty-three, which is the exact way a true measurement turns into a false one without being
; edited.
invariant the_copy_audit_carries_the_day_it_was_last_re_run
  assert every_copy_still_agrees(COPIES_REVERIFIED_ON_RESOLUTION, COPIES_FOUND_DRIFTED_ON_RESOLUTION) == true and COPIES_REVERIFIED_ON_RESOLUTION_AT != COPIES_REVERIFIED_AT and COPIES_REVERIFIED_AT != COPIES_MEASURED_AT and TRACKED_SPECS_AT_REVERIFICATION > TRACKED_SPECS_WHEN_THE_COPIES_WERE_FIRST_MEASURED

; The composed route survived a change to the array it indexes. The pin is on the VALUE, so this
; holds whatever the owner's array length becomes next.
invariant the_composed_route_is_pinned_to_a_value_and_not_to_an_ordinal
  assert CATALOG_API_OWNED_AVAILABLE_ONLY_FILTER == "available_only" and CATALOG_API_FILTER_ARRAY_CHANGED_UNDER_THIS_EDGE == true and CATALOG_API_OWNED_FILTER_VALUE_SURVIVED == true

invariant the_ride_game_declares_no_class_discount
  assert THIS_FILE_DECLARES_A_CLASS_DISCOUNT == false

; The composed route keeps the owner's two literals. A filter renamed upstream cannot be caught
; by anything local to this file, so it is caught here.
invariant the_composed_route_keeps_its_owners_literals
  assert CATALOG_API_OWNED_LIST_ENDPOINT == "GET /api/bikes" and CATALOG_API_OWNED_AVAILABLE_ONLY_FILTER == "available_only" and RIDEABLE_SOURCE_IS_A_COMPOSED_ROUTE == true

invariant the_unit_floor_tracks_its_owners_floor
  assert MIN_UNITS_AVAILABLE_TO_RIDE == AVAILABILITY_OWNED_UNIT_FLOOR and AVAILABILITY_OWNED_UNIT_FLOOR == 1

invariant the_runtime_neighbour_is_named_and_is_not_this_file
  assert REUSES_RIDE_RUNTIME_ID == "turbobaby/ride-runtime" and REUSES_RIDE_RUNTIME_ID != ID and RIDE_RUNTIME_OWNS_THE_HOST_EVENT_KINDS == true
