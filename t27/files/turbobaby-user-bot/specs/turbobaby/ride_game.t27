; that shipped stale for exactly that reason.
; bike-catalog.t27 owns the class algebra and the displacement domain, and its own header names
; this handling model (#13) as one of its readers.
pub const REUSES_CATALOG_ID : str = "turbobaby/bike-catalog";
pub const CATALOG_OWNER_PATH : str = "specs/turbobaby/bike_catalog.t27";
