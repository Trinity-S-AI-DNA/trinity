pub const DRAFT_COPY_CHECK_IS_RESTATED_HERE : bool = false;
pub const ESCAPE_RULE_IS_RESTATED_HERE : bool = false;
pub const RATE_LIMIT_MECHANISM_IS_RESTATED_HERE : bool = false;

pub const IMPLEMENTATION : str = "src/ai.rs";
; RE-MEASURED 2026-09-21 after the sentinel was given a name: 428 before, 454 after. The added
; lines are one const, one predicate and their reasons, all below every line this file cites.
pub const IMPLEMENTATION_LOC : u16 = 454;
pub const SUPERSEDED_IMPLEMENTATION_LOC : u16 = 428;
pub const ENTRY_FUNCTION : str = "src/ai.rs:185-222 ask_grok";
pub const REGRESSION_WITNESS : str = "src/bot/mod.rs:286 every_ask_grok_caller_in_bot_is_rate_limited";
pub const TRUNCATION_HELPER : str = "src/util.rs:8-15 truncate_string";

; --- The six call sites ----------------------------------------------------------------------
; Counted by grep for .ask_grok( over src/ on 2026-09-21. Twelve lines in the tree contain the
; name; six are these call sites. The other six are the definition at src/ai.rs:185, four lines
; of the fitness function and its doc comment in src/bot/mod.rs (:277, :286, :295, :296, :302),
; and nothing else. In particular the src/ai.rs test module calls ask_grok ZERO times -- it
; exercises sanitize_user_text and build_system_prompt only -- so no test call had to be excluded
; from this count, and an earlier draft of this file wrongly said two were.
; RE-MEASURED 2026-09-22: fifteen lines under src/ contain the name, not twelve, and one more
; under tests/, so "and nothing else" above no longer holds. 2c21df1 added four doc comments that
; name ask_grok without calling it -- three under src/ (src/ai.rs:303, src/promo.rs:469 and
; :1117) and one under tests/ (tests/promo_copy_wiring.rs:13, a file that commit created). Over
; src/ and tests/ together the count is 16. "In the tree" above meant src/: three reports under
; docs/reports/ also name ask_grok and were in neither count. The six call sites are unchanged,
; and so is the count below.
pub const CALL_SITE_COUNT : u8 = 6;
pub const CALL_SITES : [6]str = [
  "src/bot/commands.rs:355",
  "src/bot/commands.rs:382",
  "src/bot/callbacks.rs:259",
  "src/bot/callbacks.rs:297",
  "src/bot/handlers.rs:75",
  "src/promo.rs:456"
];
; The brief's figure, kept so the correction is checkable rather than merely asserted.
pub const BRIEF_CLAIMED_CALL_SITES : u8 = 2;

; --- What kind of answer a site asks for -------------------------------------------------------
; Three kinds, and 0 is deliberately not one of them: a record nobody constructed must not read
; as a well-formed entertainment answer, which is the permissive kind.
pub const ANSWER_INVALID : u8 = 0;
pub const ANSWER_ENTERTAINMENT : u8 = 1;
pub const ANSWER_FREE_TEXT : u8 = 2;
pub const ANSWER_DRAFT_COPY : u8 = 3;
pub const ANSWER_KIND_COUNT : u8 = 3;
pub const ANSWER_KIND_NAMES : [3]str = ["entertainment", "free-text", "draft-copy"];

pub const ENTERTAINMENT_CALL_SITES : u8 = 4;
pub const FREE_TEXT_CALL_SITES : u8 = 1;
pub const DRAFT_COPY_CALL_SITES : u8 = 1;

pub fn answer_kind_is_known(kind: u8) bool {
  return kind >= ANSWER_ENTERTAINMENT and kind <= ANSWER_DRAFT_COPY;
}

pub fn call_sites_of_kind(kind: u8) u8 {
  if (kind == ANSWER_ENTERTAINMENT) {
    return ENTERTAINMENT_CALL_SITES;
  }
  if (kind == ANSWER_FREE_TEXT) {
    return FREE_TEXT_CALL_SITES;
  }
  if (kind == ANSWER_DRAFT_COPY) {
    return DRAFT_COPY_CALL_SITES;
  }
  return 0;
}

; The draft is the only kind a human stands in front of: src/promo.rs:629-632 sends it to
; config.admin_ids and to nobody else, and src/promo.rs:674-677 refuses the publish button to a
; presser who is not an owner. Every other kind is delivered the moment it arrives.
pub fn reaches_a_customer_unreviewed(kind: u8) bool {
  if (kind == ANSWER_DRAFT_COPY) {
    return false;
  }
  return answer_kind_is_known(kind);
}

; --- The reserved subjects: what a model answer is never ---------------------------------------
; A model answer is entertainment. It is never the answer of record, and three subjects are
; reserved to named contracts so that "never" has addresses rather than adjectives.
pub const SUBJECT_UNRESERVED : u8 = 0;
pub const SUBJECT_PRICE : u8 = 1;
pub const SUBJECT_AVAILABILITY : u8 = 2;
pub const SUBJECT_TERM : u8 = 3;
pub const RESERVED_SUBJECT_COUNT : u8 = 3;
pub const RESERVED_SUBJECT_OWNERS : [3]str = [
  "turbobaby/pricing-honesty",
  "turbobaby/availability",
  "turbobaby/rental-terms"
];

pub fn subject_is_reserved(subject: u8) bool {
  return subject >= SUBJECT_PRICE and subject <= SUBJECT_TERM;
}

; The delivery rule. A model's own words go out as themselves only while nothing reserved is at
; stake; the moment the question is a price, an availability or a term, the answer of record
; comes from the owner named above and the model's sentence is not it. This file holds no branch
; from a reserved subject to a number, and that missing branch IS the specification.
pub fn model_text_may_be_delivered(kind: u8, subject: u8) bool {
  if (!answer_kind_is_known(kind)) {
    return false;
  }
  return !subject_is_reserved(subject);
}

pub const MODEL_IS_AN_ANSWER_OF_RECORD : bool = false;
pub const MODEL_IS_A_PRICE_AUTHORITY : bool = false;
pub const MODEL_IS_AN_AVAILABILITY_AUTHORITY : bool = false;
pub const MODEL_IS_A_TERM_AUTHORITY : bool = false;

; --- One turn, and what the customer receives ---------------------------------------------------
; The order is the shipped order: the rate gate first (src/bot/commands.rs:348), then the
; injection filter inside the call (src/ai.rs:191-196), then the Option (src/ai.rs:206-221).
; rate_limit_allowed is a verdict, not a computation: REUSES_RATE_LIMIT_ID owns the window that
; produces it and no part of that mechanism is described here.
pub const TURN_INVALID : u8 = 0;
pub const TURN_MODEL_TEXT : u8 = 1;
pub const TURN_PUBLISHED_FALLBACK : u8 = 2;
pub const TURN_RATE_REFUSAL : u8 = 3;
pub const TURN_FILTER_REPLY : u8 = 4;
pub const TURN_OUTCOME_COUNT : u8 = 4;

pub fn turn_outcome(rate_limit_allowed: bool, prompt_filtered: bool, model_answered: bool) u8 {
  if (!rate_limit_allowed) {
    return TURN_RATE_REFUSAL;
  }
  if (prompt_filtered) {
    return TURN_FILTER_REPLY;
  }
  if (model_answered) {
    return TURN_MODEL_TEXT;
  }
  return TURN_PUBLISHED_FALLBACK;
}

pub fn turn_outcome_is_known(outcome: u8) bool {
  return outcome >= TURN_MODEL_TEXT and outcome <= TURN_FILTER_REPLY;
}

; What leaves for the customer. The outcome alone does NOT determine it and an earlier draft of
; this file said it did: the rate refusal is a different object on every kind, so the kind is an
; argument. Measured, not modelled:
;   TURN_MODEL_TEXT        -- the model's sentence, escaped, on all three kinds.
;   TURN_PUBLISHED_FALLBACK -- a locale field on the two customer kinds (joke_fail_fallback /
;     fact_fail_fallback at the four entertainment sites, the menu field at the free-text site)
;     and the written copy at src/trios/promo.rs:237-268 on the draft, which is not a locale
;     field and is owned next door.
;   TURN_FILTER_REPLY      -- the hard-coded English literal of src/ai.rs:192-196 on the two
;     customer kinds, and the WRITTEN FALLBACK on the draft. CORRECTED 2026-09-21: this line used
;     to say the literal on all three, which was measured and true -- the draft site took that
;     sentence for copy and stored it with source = "model" -- and is true no longer. The draft
;     site now asks src/ai.rs:325-327 whether what came back is this repository's own sentinel
;     before it asks whether it is good copy, and answers the first question by identity against
;     the declaration at :314-315 rather than by matching its words.
;   TURN_RATE_REFUSAL      -- an inline bilingual literal chosen by an if on the language at the
;     four entertainment sites (src/bot/commands.rs:179-183, src/bot/callbacks.rs:215-219), and
;     NOTHING AT ALL at the free-text site: src/bot/handlers.rs:58-61 logs a warning and returns
;     Ok(()) without a send. The draft site has no limiter, so the outcome cannot arise there.
; So the never-silence rule holds for a failed MODEL and does not hold for a refused turn, and
; the difference is the one thing this section exists to keep visible.
pub const SENT_NOTHING : u8 = 0;
pub const SENT_MODEL_TEXT : u8 = 1;
pub const SENT_PUBLISHED_KEY : u8 = 2;
pub const SENT_UNLOCALIZED_LITERAL : u8 = 3;
pub const SENT_INLINE_LITERAL : u8 = 4;
pub const SENT_WRITTEN_FALLBACK : u8 = 5;

pub fn what_is_sent(kind: u8, outcome: u8) u8 {
  if (!answer_kind_is_known(kind)) {
    return SENT_NOTHING;
  }
  if (outcome == TURN_MODEL_TEXT) {
    return SENT_MODEL_TEXT;
  }
  if (outcome == TURN_FILTER_REPLY and kind == ANSWER_DRAFT_COPY) {
    return SENT_WRITTEN_FALLBACK;
  }
  if (outcome == TURN_FILTER_REPLY) {
    return SENT_UNLOCALIZED_LITERAL;
  }
  if (outcome == TURN_PUBLISHED_FALLBACK and kind == ANSWER_DRAFT_COPY) {
    return SENT_WRITTEN_FALLBACK;
  }
  if (outcome == TURN_PUBLISHED_FALLBACK) {
    return SENT_PUBLISHED_KEY;
  }
  if (outcome == TURN_RATE_REFUSAL and kind == ANSWER_ENTERTAINMENT) {
    return SENT_INLINE_LITERAL;
  }
  return SENT_NOTHING;
}

; The limiter's reach, and the one site it answers with silence. Five of the six sites call
; ai_rate_limit_allow (src/bot/commands.rs:348 and :375, src/bot/callbacks.rs:250 and :288,
; src/bot/handlers.rs:58); src/promo.rs:456 is the owner sweep and has none, which the fitness
; function at REGRESSION_WITNESS does not cover because it reads only src/bot.
pub const SITES_WITH_A_LIMITER : u8 = 5;
pub const SITES_WITH_NO_LIMITER : u8 = 1;
pub const RATE_REFUSAL_INLINE_SITES : u8 = 4;
pub const RATE_REFUSAL_SILENT_SITES : u8 = 1;

pub fn rate_refusal_is_silent(kind: u8) bool {
  return kind == ANSWER_FREE_TEXT;
}

pub fn site_has_a_limiter(kind: u8) bool {
  return answer_kind_is_known(kind) and kind != ANSWER_DRAFT_COPY;
}

; --- The published failure path -----------------------------------------------------------------
; Cited by field name, never by text: L3 forbids Cyrillic in a spec and both strings ship in two
; languages. Which languages exist, and what an unpublished code resolves to, belongs to
; REUSES_LOCALE_POLICY_ID; what belongs here is that the failure path reads a key at all.
pub const FALLBACK_IS_LOCALIZED : bool = true;
pub const FALLBACK_KEY_COUNT : u8 = 2;
pub const FALLBACK_KEYS : [2]str = ["joke_fail_fallback", "fact_fail_fallback"];
pub const FALLBACK_KEY_DECLARATIONS : str = "src/locales.rs:27 and src/locales.rs:31";
pub const FALLBACK_SEND_SITES : [4]str = [
  "src/bot/commands.rs:369",
  "src/bot/commands.rs:395",
  "src/bot/callbacks.rs:263",
  "src/bot/callbacks.rs:301"
];
; The free-text site uses neither key. Its None branch sends the menu string instead
; (src/bot/handlers.rs:101 for a group and :108 for a private chat), so the rule it satisfies is
; "not silence" and not "the same published apology". Recorded because a reader who trusted the
; brief's two strings would believe five sites share them; four do.
pub const FREE_TEXT_FAILURE_KEY : str = "menu";
pub const FREE_TEXT_USES_A_FAIL_FALLBACK_KEY : bool = false;
pub const DRAFT_FAILURE_FUNCTION : str = "src/trios/promo.rs:237-268 fallback_copy";
; All six: four keys, one menu string, one written copy. No site answers a FAILED MODEL with an
; empty reply. That is a narrower sentence than "this boundary never goes quiet", and it is
; narrowed on purpose: a RATE-REFUSED turn does go quiet at one site, which the next section
; measures. The two must not be read as one rule.
pub const SITES_WITH_A_NON_SILENT_FAILURE : u8 = 6;
pub const SITES_WITH_A_NON_SILENT_RATE_REFUSAL : u8 = 4;

; --- The two answers no locale owns ---------------------------------------------------------------
; TWO, not one, and an earlier draft of this file claimed one. Both are customer-facing strings
; on this path that the locale table does not hold, and they fail differently.
; The first is the injection refusal at src/ai.rs:192-196: when the denylist trips, ask_grok
; returns Some(...) carrying a hard-coded ENGLISH sentence, so the sentinel occupies the MODEL's
; slot and is decorated by the caller as if the model had written it.
; The second is the rate refusal: an inline if on the language picks one of two literals written
; in place at src/bot/commands.rs:179-183 and again at src/bot/callbacks.rs:215-219. It is
; bilingual, so it is not the same defect, but it is duplicated across two files and absent from
; the locale table, so a third language reaches it in English and neither copy moves when the
; other does. A grep for either string over src/locales.rs returns 0 on 2026-09-21.
pub const FILTER_REPLY_IS_LOCALIZED : bool = false;
pub const FILTER_REPLY_LOCALE_KEYS : u8 = 0;
pub const FILTER_REPLY_SITE : str = "src/ai.rs:192-196";
; ADDED 2026-09-21. The sentence is a value this repository OWNS, and until that date it was an
; inline literal that nothing could name. Naming it is what lets a consumer refuse it without
; quoting it: the one consumer that must not publish it compares against the declaration, so a
; reworded sentinel cannot leave that consumer matching words it no longer uses. The five sites
; that SEND it to a chat are unchanged and still treat it as the model's answer, which is the
; defect FILTER_REPLY_NOTE keeps; what changed is the sixth.
pub const FILTER_REPLY_IS_A_NAMED_CONSTANT : bool = true;
pub const FILTER_REPLY_DECLARATION : str = "src/ai.rs:314-315 PROMPT_FILTERED_REPLY";
pub const FILTER_REPLY_RECOGNISER : str = "src/ai.rs:325-327 is_prompt_filtered_reply";
pub const FILTER_REPLY_IS_MATCHED_BY_PROSE : bool = false;
pub const SITES_THAT_TELL_THE_SENTINEL_FROM_A_MODEL_ANSWER : u8 = 1;
pub const SITES_THAT_TREAT_THE_SENTINEL_AS_A_MODEL_ANSWER : u8 = 5;

pub fn sentinel_can_be_published_as_copy(recogniser_exists: bool) bool {
  return !recogniser_exists;
}
pub const RATE_REFUSAL_IS_LOCALIZED : bool = false;
pub const RATE_REFUSAL_LOCALE_KEYS : u8 = 0;
pub const RATE_REFUSAL_LITERAL_DECLARATIONS : str = "src/bot/commands.rs:179-183 and src/bot/callbacks.rs:215-219";
pub const CUSTOMER_STRINGS_NO_LOCALE_OWNS : u8 = 2;
pub const FILTER_REPLY_NOTE : str = "The injection-refusal sentence is a hard-coded English literal returned inside Some, not a locale field: a grep for it over src/locales.rs returns zero on 2026-09-21. Two consequences followed and neither was theoretical. A Russian-speaking customer is answered in English on this branch, and because it is Some rather than None the caller treats it as the model's answer: src/bot/commands.rs:361 decorates it as the joke and sends it as the joke. Closing THAT needs two locale fields and a branch that returns them, not a line here, and it is still open on all five chat sites. The sixth consequence was worse and is closed: the draft site had no chat to answer, so the sentence became a promotional post stored with source = model, one owner press from every subscriber. It is refused there by identity at src/promo.rs:486 against the declaration at src/ai.rs:314-315 -- not by adding its words to a list, because the words are ours to change and a list of them is a second copy that goes stale silently.";
pub const RATE_REFUSAL_NOTE : str = "The too-fast refusal is not a locale field either. Each of the two bot files declares its own if on the language with the two literals written in place, and the four entertainment sites send whichever it picks; a grep for the pair over src/locales.rs returns zero on 2026-09-21. The free-text site sends neither, and nothing else: src/bot/handlers.rs:58-61 warns into the log and returns Ok(()), so a customer who types a second message inside the window is answered by silence. That is the one place on this boundary where a customer gets no reply at all, and it is recorded as a defect rather than blessed as a design.";

; --- Entering the prompt ------------------------------------------------------------------------
; Three clamps, all measured, all applied on the way in. They truncate rather than refuse, so
; they are modelled as clamps and not as gates.
pub const PROMPT_CHAR_CAP : u16 = 2000;
pub const PERSONA_CHAR_CAP : u16 = 100;
pub const FREE_TEXT_CHAR_CAP : u16 = 1500;

pub fn chars_entering_the_prompt(offered: u16) u16 {
  if (offered > PROMPT_CHAR_CAP) {
    return PROMPT_CHAR_CAP;
  }
  return offered;
}

pub fn chars_entering_the_persona(offered: u16) u16 {
  if (offered > PERSONA_CHAR_CAP) {
    return PERSONA_CHAR_CAP;
  }
  return offered;
}

; The entertainment prompts are assembled from closed literal lists in src/ai.rs plus a fixed
; base string read from a locale field. Their lengths are pinned so that a later commit adding a
; database read to either list is a diff against a number rather than an unnoticed widening.
pub const JOKE_STYLE_COUNT : u8 = 23;
pub const FACT_TOPIC_COUNT : u8 = 22;
pub const STYLE_AND_TOPIC_LISTS_READ_THE_DATABASE : bool = false;
; src/ai.rs:58 accepts an order_context and every shipped caller passes None
; (src/bot/commands.rs:353, src/bot/callbacks.rs:242). The only Some is the unit test at
; src/ai.rs:443. A live customer context would change the answer of prompt_carries_customer_datum
; for the entertainment kind, so its deadness is a pinned fact and not a footnote.
pub const ORDER_CONTEXT_PARAMETER_IS_LIVE : bool = false;
pub const ORDER_CONTEXT_LIVE_CALLERS : u8 = 0;

; The denylist. It is defence in depth by its own admission (src/ai.rs:100-105) and this file
; claims nothing more for it: the count and the matching rule are pinned, its sufficiency is not.
pub const INJECTION_MARKER_COUNT : u8 = 25;
pub const MARKER_MATCH_IS_WORD_BOUNDED : bool = true;
pub const DENYLIST_IS_SUFFICIENT : bool = false;
; The two sanitize call sites behave differently and the difference is load-bearing. On the
; prompt (src/ai.rs:191-196) a hit short-circuits before any network call. On the persona
; (src/ai.rs:153-154) the sentinel is substituted into the system prompt and the call proceeds.
pub const FILTER_ON_PROMPT_SHORT_CIRCUITS : bool = true;
pub const FILTER_ON_PERSONA_SHORT_CIRCUITS : bool = false;
; src/ai.rs:100 describes the function as stripping markers; src/ai.rs:138 replaces the whole
; text with the sentinel. The behaviour is the replacement, and a reader who trusted the comment
; would expect a partially cleaned prompt to reach the model. None ever does.
pub const SANITIZER_REPLACES_WHOLE_TEXT : bool = true;

; --- What the prompt carries, by kind -----------------------------------------------------------
; The draft prompt carries a price: src/promo.rs:506-539 reads a price column and formats it at
; :507 (:508 is the branch taken when the column is absent or not positive), and
; src/trios/promo.rs:191-229 puts that string into the instruction. The free-text
; prompt carries the customer's own words and the customer's Telegram display name as persona
; (src/bot/handlers.rs:63-73). The entertainment prompts carry neither, and the evidence is
; structural rather than a grep: get_random_joke_prompt (src/ai.rs:58-67) and
; get_random_fact_prompt (src/ai.rs:69-75) take a base string and nothing else, their two lists
; are const &[&str] literals, and their callers hand them locale.joke_prompt / locale.fact_prompt
; with no Database in scope at any of the four sites. An earlier draft of this file offered a
; grep for price, rate, fleet or bike over src/bot/handlers.rs instead, and claimed it returned
; zero. It does not -- that grep returns 13 lines, because every crate:: path contains rate --
; and it was the wrong file besides: handlers.rs is the free-text site, not an entertainment
; one. The false absence is recorded rather than quietly replaced.
pub fn prompt_carries_shop_facts(kind: u8) bool {
  return kind == ANSWER_DRAFT_COPY;
}

pub fn prompt_carries_customer_datum(kind: u8) bool {
  return kind == ANSWER_FREE_TEXT;
}

; The guarantee this boundary can actually make, and the only one worth writing: the two facts
; above never coincide with the absence of a reviewer. Where a shop fact enters a prompt, an
; owner reads the answer before a customer does; where no owner reads it, the shop told the model
; nothing about itself.
pub fn unreviewed_prompt_carries_shop_facts(kind: u8) bool {
  return reaches_a_customer_unreviewed(kind) and prompt_carries_shop_facts(kind);
}

; --- Leaving the boundary: the measured zero ------------------------------------------------------
; max_tokens and the word ceiling are things the shop ASKS FOR (src/ai.rs:231 and :276 for the
; tokens, src/ai.rs:157 for the words). Neither is read back. The distinction is the whole point
; of this section: a request parameter is not a bound.
pub const REQUESTED_MAX_TOKENS : u16 = 300;
pub const REQUESTED_WORD_CEILING : u16 = 200;
pub const RESPONSE_CHARS_ARE_BOUNDED_ON_ARRIVAL : bool = false;
pub const OUTPUT_CHECK_FUNCTION : str = "src/trios/promo.rs:277-299 usable_copy";
pub const SITES_WITH_AN_OUTPUT_CHECK : u8 = 1;
pub const UNREVIEWED_SITES_WITH_AN_OUTPUT_CHECK : u8 = 0;
; ADDED 2026-09-21. The one site with an output check now applies TWO, and they are different in
; kind rather than in strictness. The first asks whether the answer is this module's own sentinel
; and compares against the declaration; the second is usable_copy, a judgement about text that
; really did come from the model, where its wording is the only evidence there is. The count of
; SITES is unchanged; what is new is that the site's first question can be answered without
; reading the sentence at all.
pub const OUTPUT_CHECKS_ON_THE_DRAFT_SITE : u8 = 2;
pub const THE_FIRST_DRAFT_CHECK_READS_THE_SENTENCE : bool = false;
pub const THE_SECOND_DRAFT_CHECK_READS_THE_SENTENCE : bool = true;
; What every site does apply. The escape rule itself -- its characters, its replacements and its
; call-site counts -- is REUSES_BOT_SURFACE_ID's and is not restated; the one fact kept here is
; that all six of THIS file's sites pass the model's text through it before sending
; (src/bot/commands.rs:361 and :387, src/bot/callbacks.rs:262 and :300, src/bot/handlers.rs:79,
; src/promo.rs:609). Saying it is an escaping pass is the point: it makes the answer safe to
; RENDER, which is a different promise from safe to BELIEVE, and this file makes only the first.
pub const OUTPUT_IS_ESCAPED_AT_EVERY_SITE : bool = true;

; --- The draft path, owned next door ---------------------------------------------------------------
; Everything about turning a drafted post into a sent one belongs to REUSES_PROMO_BROADCAST_ID:
; the boundary, the owner press that crosses it, and the length-and-refusal check applied to the
; drafted copy. Neither its two functions nor its two character figures are copied here. What
; this file keeps is the sentence that is about the MODEL and not about the post -- the text in
; that draft was written by one, which is why the owner reading it is a reviewer rather than a
; formality, and why ANSWER_DRAFT_COPY is the single kind for which reaches_a_customer_unreviewed
; answers false.
pub const DRAFT_SEND_OWNER : str = "turbobaby/promo-broadcast";
pub const DRAFT_TEXT_IS_MODEL_WRITTEN : bool = true;
; MEASURED 2026-09-21, and it is a hole rather than a boundary. This file says usable_copy's four
; figures are turbobaby/promo-broadcast's and are not copied here; that file says they are this
; file's and are not copied there. Both statements are in the tree and both defer, so the floor,
; the ceiling, the length of the refusal head and the number of refusal markers are declared in no
; contract at all -- a reader who follows either edge arrives back where they started. Recorded
; rather than settled: which file should own them is the owner's call, and guessing here would put
; four numbers in a contract that was told twice not to hold them.
pub const COPY_CHECK_FIGURES_PINNED_BY_THIS_FILE : u8 = 0;
pub const COPY_CHECK_FIGURES_PINNED_BY_THE_NAMED_OWNER : u8 = 0;
pub const COPY_CHECK_FIGURE_OWNERSHIP_IS_CIRCULAR : bool = true;
pub const COPY_CHECK_CIRCULARITY_NOTE : str = "turbobaby/promo-broadcast declares COPY_CHECK_OWNER_ID = turbobaby/ai-assist and COPY_BOUNDS_ARE_RESTATED_HERE = false; this file declares DRAFT_COPY_CHECK_IS_RESTATED_HERE = false and names that same contract as the owner of the figures. Neither declares them, so usable_copy's character floor, its ceiling, the length of its refusal head and the count of its refusal markers live only in src/trios/promo.rs:277-299 and are unbound by the corpus. No number is copied into either file to close it, because a figure invented to end a disagreement is worse than a disagreement anybody can see.";

pub fn copy_check_figures_have_an_owner(pinned_here: u8, pinned_there: u8) bool {
  return pinned_here + pinned_there >= 1;
}

; The hole in the one path that carries a price, stated without restating the check. The
; instruction at src/trios/promo.rs:222-223 tells the model to invent no price, discount,
; percentage or date; an instruction is not a check, and the check that exists reads no digit.
pub const DRAFT_CHECK_READS_NUMBERS : bool = false;
pub const NUMERIC_CLAIM_GUARD_IS_NOT_PUBLISHED : bool = true;
pub const NUMERIC_CLAIM_GUARD_NOTE : str = "Nothing in this repository compares a number in a model's answer against the number that was put in its prompt. The only output check that reads the sentence at all -- src/trios/promo.rs:277-299 usable_copy, whose figures are pinned by NOBODY (see COPY_CHECK_CIRCULARITY_NOTE) -- rejects on length and on a refusal in the opening line and reads no digit; the identity check added beside it on 2026-09-21 reads no digit either, because it reads nothing; its thresholds are that contract's and are not copied here. On the five sites a customer reaches unreviewed there is no output check of any kind, so on those the rule that a model answer is never a price rests on the prompt containing no price and on nothing else. On the sixth the exposure is bounded by a human and not by the code. Closing this needs a comparison between the figures in a prompt and the figures in its answer, with a refusal on divergence; no threshold is invented here in its place, and the divergence rule that does exist belongs to turbobaby/pricing-honesty and governs a different pair of numbers.";

; --- The provider is not a guarantee --------------------------------------------------------------
; One attempt at the primary and six at the fallback: two endpoints times three model names
; (src/ai.rs:262-266), each pair tried once. There is no retry of a pair and no backoff; the only
; time bound is the single shared client timeout at src/ai.rs:176.
pub const GROK_ATTEMPTS : u8 = 1;
pub const GLM_ENDPOINTS : u8 = 2;
pub const GLM_MODELS : u8 = 3;
pub const GLM_ATTEMPTS : u8 = 6;
pub const MAX_ATTEMPTS_PER_TURN : u8 = 7;
pub const CLIENT_TIMEOUT_SECONDS : u8 = 30;
pub const RETRIES_OF_THE_SAME_PAIR : u8 = 0;
pub const MODEL_NAMES_IN_CODE : u8 = 4;

pub fn attempts_for(grok_key_present: bool, glm_key_present: bool) u8 {
  if (grok_key_present and glm_key_present) {
    return MAX_ATTEMPTS_PER_TURN;
  }
  if (grok_key_present) {
    return GROK_ATTEMPTS;
  }
  if (glm_key_present) {
    return GLM_ATTEMPTS;
  }
  return 0;
}

; A deployment with neither key configured is legal and expected: src/config.rs:193-195
; ai_enabled is a disjunction over both, and src/config.rs:210-213 lists the feature as OFF at
; boot rather than as a fault. Zero attempts must still answer the customer, which is why the
; published fallback is the floor of this contract and not its error case.
pub fn outcome_with_no_provider_key(rate_limit_allowed: bool) u8 {
  return turn_outcome(rate_limit_allowed, false, false);
}

pub const PROVIDER_IS_PINNED_AS_A_GUARANTEE : bool = false;
pub const PROVIDER_NAMES_PUBLISHED : [0]str = [];
pub const MODEL_NAME_LITERALS_IN_CORPUS : u8 = 0;
pub const ENDPOINT_HOSTS_IN_CORPUS : u8 = 0;
pub const PROVIDER_NOTE : str = "The measured absence is about IDENTITIES, and it is stated the only way that survives its own grep. The code pins seven of them -- the one model name at src/ai.rs:226, the three at src/ai.rs:262, the endpoint host at src/ai.rs:236 and the two at src/ai.rs:264-265 -- and a grep of specs/ for each of those seven literal strings returns zero files on 2026-09-21, this file included. An earlier draft made the wider claim that no vendor WORD appears in the corpus and spelled the search terms into its own sentence, which made the claim refute itself on the next grep and was wrong besides: the family words survive here in the attempt-budget names below and the call name ask_grok appears once in turbobaby/bot-surface, in the prose of the section that re-measures which specs name a slash-prefixed command. That citation used to be a line number into that file and had drifted by eight lines when it was re-read, so it names the ID and the section instead. All seven literals were RE-GREPPED on 2026-09-21 and every one still returns zero files across specs/. The narrow absence is the one worth keeping, because the contract is the Option and not its supplier: any of up to seven attempts across two vendors may fill it, and the same customer sentence may come from either on consecutive turns. Pinning a name here would promise an identity the call path does not keep.";

; --- Refusals ---------------------------------------------------------------------------------------
; No quality claim is made, and no measurement supports one.
pub const OUTPUT_QUALITY_IS_CLAIMED : bool = false;
pub const OUTPUT_LANGUAGE_IS_VERIFIED : bool = false;
pub const OUTPUT_LANGUAGE_NOTE : str = "The reply's language is requested and never confirmed. A locale field named lang_instruction is passed into every call as the third argument of ask_grok and lands in the system prompt at src/ai.rs:155-159; no site reads the answer back and checks what language it is in, and no detector is applied to output anywhere in the tree -- src/locales.rs:123 detect_language is applied to the customer's INPUT at src/bot/handlers.rs:54 and to nothing else. So a reply in the wrong language is delivered exactly like a reply in the right one. Closing this needs a check on the returned text, and until it exists this contract claims the request and not the result.";
pub const PROMPT_TEXT_PUBLISHED : [0]str = [];
pub const CYRILLIC_STRINGS_PUBLISHED : [0]str = [];
pub const PERSONAL_DATA_FIELDS_PUBLISHED : [0]str = [];

; --- Tests ------------------------------------------------------------------------------------------

test the_corpus_edges_are_named_and_distinct {
  assert REUSES_PRICING_HONESTY_ID == "turbobaby/pricing-honesty";
  assert REUSES_AVAILABILITY_ID == "turbobaby/availability";
  assert REUSES_RENTAL_TERMS_ID == "turbobaby/rental-terms";
  assert REUSES_LOCALE_POLICY_ID == "turbobaby/locale-policy";
  assert REUSES_PRICING_HONESTY_ID != ID;
  assert REUSES_AVAILABILITY_ID != ID;
  assert REUSES_RENTAL_TERMS_ID != ID;
  assert REUSES_LOCALE_POLICY_ID != ID;
  assert REUSES_BOT_SURFACE_ID == "turbobaby/bot-surface";
  assert REUSES_PROMO_BROADCAST_ID == "turbobaby/promo-broadcast";
  assert REUSES_RATE_LIMIT_ID == "turbobaby/rate-limit";
  assert REUSES_BOT_SURFACE_ID != ID;
  assert REUSES_PROMO_BROADCAST_ID != ID;
  assert REUSES_RATE_LIMIT_ID != ID;
  assert REUSE_EDGE_COUNT == 7;
}

; The bot-surface edge, re-verified at the TARGET rather than trusted as a string. The four
; declaration names are the ones this file defers to; if any is renamed next door, the deferral
; sentences above are the thing that has gone wrong, and this test is where it shows.
test the_bot_surface_edge_points_at_declarations_that_exist {
  assert BOT_SURFACE_DECLARES_ITS_ID_AT == "turbobaby/bot-surface declares ID";
  assert BOT_SURFACE_EDGE_REVERIFIED_AT == "2026-09-21";
  assert BOT_SURFACE_EDGE_REVERIFIED_AT == MEASURED_AT;
  assert BOT_SURFACE_WAS_ABSENT_AT_FIRST_MEASUREMENT == true;
  assert BOT_SURFACE_TARGET_DECLARATIONS.len == 4;
  assert BOT_SURFACE_TARGET_DECLARATIONS[0] == "COMMANDS";
  assert BOT_SURFACE_TARGET_DECLARATIONS[1] == "ADMIN_GATED_COMMANDS";
  assert BOT_SURFACE_TARGET_DECLARATIONS[2] == "ESCAPED_CHARS";
  assert BOT_SURFACE_TARGET_DECLARATIONS[3] == "ESCAPE_REPLACEMENTS";
  assert SPECS_NAMING_BOT_SURFACE_2026_09_21 == 9;
  assert CORPUS_FILE_COUNT == 43;
  assert SPECS_NAMING_BOT_SURFACE_2026_09_21 < CORPUS_FILE_COUNT;
  assert SPECS_NAMING_BOT_SURFACE_SUPERSEDED_FIGURE == 10;
  assert SPECS_NAMING_BOT_SURFACE_2026_09_21 < SPECS_NAMING_BOT_SURFACE_SUPERSEDED_FIGURE;
  assert SPECS_NAMING_BOT_SURFACE_UNIT == "files";
  assert SPECS_NAMING_BOT_SURFACE_INCLUDES_THIS_FILE == true;
  assert SPECS_NAMING_BOT_SURFACE_AUDITED_AT == "2026-09-21";
  assert SPECS_NAMING_BOT_SURFACE_AUDITED_AT == MEASURED_AT;
}

; The header's opening absence, re-measured and turned into an ownership claim. Equality of the
; first two is what makes "no second contract states it" checkable instead of asserted.
test this_file_is_still_the_only_contract_constraining_the_boundary {
  assert SPECS_NAMING_THIS_FILE_2026_09_21 == 3;
  assert SPECS_DEFERRING_TO_THIS_FILE_2026_09_21 == 3;
  assert SPECS_NAMING_THIS_FILE_2026_09_21 == SPECS_DEFERRING_TO_THIS_FILE_2026_09_21;
  assert SPECS_CONSTRAINING_THE_BOUNDARY_ELSEWHERE == 0;
  assert CORPUS_FILES_OTHER_THAN_THIS_ONE == 42;
  assert CORPUS_FILES_OTHER_THAN_THIS_ONE + 1 == CORPUS_FILE_COUNT;
  assert SPECS_NAMING_THIS_FILE_2026_09_21 < CORPUS_FILES_OTHER_THAN_THIS_ONE;
  assert CORPUS_FILE_COUNT_REMEASURED == 45;
  assert CORPUS_FILES_OTHER_THAN_THIS_ONE_REMEASURED == 44;
  assert CORPUS_FILES_OTHER_THAN_THIS_ONE_REMEASURED + 1 == CORPUS_FILE_COUNT_REMEASURED;
  assert CORPUS_FILE_COUNT_REMEASURED_AT == "2026-09-22";
  assert CORPUS_FILE_COUNT_REMEASURED_AT != MEASURED_AT;
  assert CORPUS_FILE_COUNT_REMEASURED > CORPUS_FILE_COUNT;
  assert SPECS_NAMING_THIS_FILE_2026_09_22 == 3;
  assert SPECS_DEFERRING_TO_THIS_FILE_2026_09_22 == 3;
  assert SPECS_NAMING_THIS_FILE_2026_09_22 == SPECS_DEFERRING_TO_THIS_FILE_2026_09_22;
  assert SPECS_NAMING_THIS_FILE_2026_09_22 < CORPUS_FILES_OTHER_THAN_THIS_ONE_REMEASURED;
  assert SPECS_NAMING_BOT_SURFACE_2026_09_22 == 9;
  assert SPECS_NAMING_BOT_SURFACE_2026_09_22 < CORPUS_FILE_COUNT_REMEASURED;
}

test nothing_a_neighbour_owns_is_restated_here {
  assert DRAFT_SEND_GATE_IS_RESTATED_HERE == false;
  assert DRAFT_COPY_CHECK_IS_RESTATED_HERE == false;
  assert ESCAPE_RULE_IS_RESTATED_HERE == false;
  assert RATE_LIMIT_MECHANISM_IS_RESTATED_HERE == false;
  assert DRAFT_SEND_OWNER == REUSES_PROMO_BROADCAST_ID;
  assert BOT_SURFACE_WAS_ABSENT_AT_FIRST_MEASUREMENT == true;
}

test the_reserved_subjects_carry_their_owners {
  assert RESERVED_SUBJECT_OWNERS.len == RESERVED_SUBJECT_COUNT;
  assert RESERVED_SUBJECT_OWNERS[0] == REUSES_PRICING_HONESTY_ID;
  assert RESERVED_SUBJECT_OWNERS[1] == REUSES_AVAILABILITY_ID;
  assert RESERVED_SUBJECT_OWNERS[2] == REUSES_RENTAL_TERMS_ID;
  assert subject_is_reserved(SUBJECT_UNRESERVED) == false;
  assert subject_is_reserved(SUBJECT_PRICE) == true;
  assert subject_is_reserved(SUBJECT_AVAILABILITY) == true;
  assert subject_is_reserved(SUBJECT_TERM) == true;
  assert subject_is_reserved(4) == false;
}

test the_six_call_sites_are_counted_not_estimated {
  assert CALL_SITES.len == CALL_SITE_COUNT;
  assert CALL_SITE_COUNT == 6;
  assert CALL_SITES[0] == "src/bot/commands.rs:355";
  assert CALL_SITES[5] == "src/promo.rs:456";
  assert ENTERTAINMENT_CALL_SITES + FREE_TEXT_CALL_SITES + DRAFT_COPY_CALL_SITES == CALL_SITE_COUNT;
  assert CALL_SITE_COUNT > BRIEF_CLAIMED_CALL_SITES;
}

test every_kind_reports_its_own_sites {
  assert answer_kind_is_known(ANSWER_INVALID) == false;
  assert answer_kind_is_known(ANSWER_ENTERTAINMENT) == true;
  assert answer_kind_is_known(ANSWER_FREE_TEXT) == true;
  assert answer_kind_is_known(ANSWER_DRAFT_COPY) == true;
  assert answer_kind_is_known(4) == false;
  assert ANSWER_KIND_NAMES.len == ANSWER_KIND_COUNT;
  assert call_sites_of_kind(ANSWER_ENTERTAINMENT) == 4;
  assert call_sites_of_kind(ANSWER_FREE_TEXT) == 1;
  assert call_sites_of_kind(ANSWER_DRAFT_COPY) == 1;
  assert call_sites_of_kind(ANSWER_INVALID) == 0;
}

test only_the_draft_has_a_reader_before_the_customer {
  assert reaches_a_customer_unreviewed(ANSWER_ENTERTAINMENT) == true;
  assert reaches_a_customer_unreviewed(ANSWER_FREE_TEXT) == true;
  assert reaches_a_customer_unreviewed(ANSWER_DRAFT_COPY) == false;
  assert reaches_a_customer_unreviewed(ANSWER_INVALID) == false;
}

test a_reserved_subject_closes_the_door_on_every_kind {
  assert model_text_may_be_delivered(ANSWER_ENTERTAINMENT, SUBJECT_UNRESERVED) == true;
  assert model_text_may_be_delivered(ANSWER_ENTERTAINMENT, SUBJECT_PRICE) == false;
  assert model_text_may_be_delivered(ANSWER_FREE_TEXT, SUBJECT_AVAILABILITY) == false;
  assert model_text_may_be_delivered(ANSWER_DRAFT_COPY, SUBJECT_TERM) == false;
  assert model_text_may_be_delivered(ANSWER_INVALID, SUBJECT_UNRESERVED) == false;
  assert MODEL_IS_AN_ANSWER_OF_RECORD == false;
  assert MODEL_IS_A_PRICE_AUTHORITY == false;
  assert MODEL_IS_AN_AVAILABILITY_AUTHORITY == false;
  assert MODEL_IS_A_TERM_AUTHORITY == false;
}

test the_turn_follows_the_shipped_order {
  assert turn_outcome(false, false, true) == TURN_RATE_REFUSAL;
  assert turn_outcome(false, true, true) == TURN_RATE_REFUSAL;
  assert turn_outcome(true, true, true) == TURN_FILTER_REPLY;
  assert turn_outcome(true, false, true) == TURN_MODEL_TEXT;
  assert turn_outcome(true, false, false) == TURN_PUBLISHED_FALLBACK;
  assert turn_outcome_is_known(TURN_INVALID) == false;
  assert turn_outcome_is_known(TURN_FILTER_REPLY) == true;
  assert turn_outcome_is_known(5) == false;
}

test a_failed_model_is_never_silence_on_any_kind {
  assert what_is_sent(ANSWER_ENTERTAINMENT, TURN_MODEL_TEXT) == SENT_MODEL_TEXT;
  assert what_is_sent(ANSWER_FREE_TEXT, TURN_MODEL_TEXT) == SENT_MODEL_TEXT;
  assert what_is_sent(ANSWER_DRAFT_COPY, TURN_MODEL_TEXT) == SENT_MODEL_TEXT;
  assert what_is_sent(ANSWER_ENTERTAINMENT, TURN_PUBLISHED_FALLBACK) == SENT_PUBLISHED_KEY;
  assert what_is_sent(ANSWER_FREE_TEXT, TURN_PUBLISHED_FALLBACK) == SENT_PUBLISHED_KEY;
  assert what_is_sent(ANSWER_DRAFT_COPY, TURN_PUBLISHED_FALLBACK) == SENT_WRITTEN_FALLBACK;
  assert what_is_sent(ANSWER_ENTERTAINMENT, TURN_PUBLISHED_FALLBACK) != SENT_NOTHING;
  assert what_is_sent(ANSWER_FREE_TEXT, TURN_PUBLISHED_FALLBACK) != SENT_NOTHING;
  assert what_is_sent(ANSWER_DRAFT_COPY, TURN_PUBLISHED_FALLBACK) != SENT_NOTHING;
  assert what_is_sent(ANSWER_INVALID, TURN_PUBLISHED_FALLBACK) == SENT_NOTHING;
  assert what_is_sent(ANSWER_ENTERTAINMENT, TURN_INVALID) == SENT_NOTHING;
}

; The defect, asserted rather than described. Four sites answer a refused turn with a literal
; nobody localized; the free-text site answers it with nothing at all.
test a_refused_turn_is_silence_on_exactly_one_kind {
  assert what_is_sent(ANSWER_ENTERTAINMENT, TURN_RATE_REFUSAL) == SENT_INLINE_LITERAL;
  assert what_is_sent(ANSWER_ENTERTAINMENT, TURN_RATE_REFUSAL) != SENT_PUBLISHED_KEY;
  assert what_is_sent(ANSWER_FREE_TEXT, TURN_RATE_REFUSAL) == SENT_NOTHING;
  assert rate_refusal_is_silent(ANSWER_FREE_TEXT) == true;
  assert rate_refusal_is_silent(ANSWER_ENTERTAINMENT) == false;
  assert rate_refusal_is_silent(ANSWER_DRAFT_COPY) == false;
  assert site_has_a_limiter(ANSWER_ENTERTAINMENT) == true;
  assert site_has_a_limiter(ANSWER_FREE_TEXT) == true;
  assert site_has_a_limiter(ANSWER_DRAFT_COPY) == false;
  assert site_has_a_limiter(ANSWER_INVALID) == false;
  assert SITES_WITH_A_LIMITER + SITES_WITH_NO_LIMITER == CALL_SITE_COUNT;
  assert RATE_REFUSAL_INLINE_SITES + RATE_REFUSAL_SILENT_SITES == SITES_WITH_A_LIMITER;
  assert RATE_REFUSAL_IS_LOCALIZED == false;
  assert RATE_REFUSAL_LOCALE_KEYS == 0;
}

test the_failure_path_reads_a_key_at_four_sites_and_speaks_at_six {
  assert FALLBACK_IS_LOCALIZED == true;
  assert FALLBACK_KEYS.len == FALLBACK_KEY_COUNT;
  assert FALLBACK_KEYS[0] == "joke_fail_fallback";
  assert FALLBACK_KEYS[1] == "fact_fail_fallback";
  assert FALLBACK_SEND_SITES.len == ENTERTAINMENT_CALL_SITES;
  assert FREE_TEXT_USES_A_FAIL_FALLBACK_KEY == false;
  assert SITES_WITH_A_NON_SILENT_FAILURE == CALL_SITE_COUNT;
  assert SITES_WITH_A_NON_SILENT_RATE_REFUSAL == RATE_REFUSAL_INLINE_SITES;
  assert SITES_WITH_A_NON_SILENT_RATE_REFUSAL < SITES_WITH_A_NON_SILENT_FAILURE;
}

test two_customer_strings_have_no_locale_owner {
  assert FILTER_REPLY_IS_LOCALIZED == false;
  assert FILTER_REPLY_LOCALE_KEYS == 0;
  assert FILTER_REPLY_IS_LOCALIZED != FALLBACK_IS_LOCALIZED;
  assert RATE_REFUSAL_IS_LOCALIZED != FALLBACK_IS_LOCALIZED;
  assert CUSTOMER_STRINGS_NO_LOCALE_OWNS == 2;
  assert what_is_sent(ANSWER_ENTERTAINMENT, TURN_FILTER_REPLY) != SENT_PUBLISHED_KEY;
  assert what_is_sent(ANSWER_ENTERTAINMENT, TURN_FILTER_REPLY) != SENT_MODEL_TEXT;
  assert what_is_sent(ANSWER_FREE_TEXT, TURN_FILTER_REPLY) == SENT_UNLOCALIZED_LITERAL;
}

; The sentinel is a value this file owns, and the one path that would have published it refuses it
; without reading it. ADDED 2026-09-21 with the fix it describes.
test the_sentinel_is_named_and_refused_by_identity_on_the_one_path_that_would_publish_it {
  assert FILTER_REPLY_IS_A_NAMED_CONSTANT == true;
  assert FILTER_REPLY_IS_MATCHED_BY_PROSE == false;
  assert FILTER_REPLY_DECLARATION == "src/ai.rs:314-315 PROMPT_FILTERED_REPLY";
  assert FILTER_REPLY_RECOGNISER == "src/ai.rs:325-327 is_prompt_filtered_reply";
  assert SITES_THAT_TELL_THE_SENTINEL_FROM_A_MODEL_ANSWER == DRAFT_COPY_CALL_SITES;
  assert SITES_THAT_TELL_THE_SENTINEL_FROM_A_MODEL_ANSWER + SITES_THAT_TREAT_THE_SENTINEL_AS_A_MODEL_ANSWER == CALL_SITE_COUNT;
  assert sentinel_can_be_published_as_copy(true) == false;
  assert sentinel_can_be_published_as_copy(false) == true;
  assert what_is_sent(ANSWER_DRAFT_COPY, TURN_FILTER_REPLY) == SENT_WRITTEN_FALLBACK;
  assert what_is_sent(ANSWER_DRAFT_COPY, TURN_FILTER_REPLY) != SENT_UNLOCALIZED_LITERAL;
  assert what_is_sent(ANSWER_DRAFT_COPY, TURN_FILTER_REPLY) != SENT_MODEL_TEXT;
  assert OUTPUT_CHECKS_ON_THE_DRAFT_SITE == 2;
  assert THE_FIRST_DRAFT_CHECK_READS_THE_SENTENCE == false;
  assert THE_SECOND_DRAFT_CHECK_READS_THE_SENTENCE == true;
}

; The figures of the check next door belong to nobody, and this test is the only thing in the
; corpus that says so out loud.
test the_copy_checks_figures_are_pinned_by_neither_contract {
  assert COPY_CHECK_FIGURES_PINNED_BY_THIS_FILE == 0;
  assert COPY_CHECK_FIGURES_PINNED_BY_THE_NAMED_OWNER == 0;
  assert COPY_CHECK_FIGURE_OWNERSHIP_IS_CIRCULAR == true;
  assert DRAFT_COPY_CHECK_IS_RESTATED_HERE == false;
  assert copy_check_figures_have_an_owner(COPY_CHECK_FIGURES_PINNED_BY_THIS_FILE, COPY_CHECK_FIGURES_PINNED_BY_THE_NAMED_OWNER) == false;
  assert copy_check_figures_have_an_owner(0, 4) == true;
}

test the_two_inbound_clamps_hold_at_their_edges {
  assert chars_entering_the_prompt(0) == 0;
  assert chars_entering_the_prompt(PROMPT_CHAR_CAP) == PROMPT_CHAR_CAP;
  assert chars_entering_the_prompt(PROMPT_CHAR_CAP + 1) == PROMPT_CHAR_CAP;
  assert chars_entering_the_persona(PERSONA_CHAR_CAP) == PERSONA_CHAR_CAP;
  assert chars_entering_the_persona(PERSONA_CHAR_CAP + 1) == PERSONA_CHAR_CAP;
  assert chars_entering_the_persona(5000) == PERSONA_CHAR_CAP;
  assert FREE_TEXT_CHAR_CAP < PROMPT_CHAR_CAP;
}

test the_entertainment_lists_are_closed_literals {
  assert JOKE_STYLE_COUNT == 23;
  assert FACT_TOPIC_COUNT == 22;
  assert STYLE_AND_TOPIC_LISTS_READ_THE_DATABASE == false;
  assert ORDER_CONTEXT_PARAMETER_IS_LIVE == false;
  assert ORDER_CONTEXT_LIVE_CALLERS == 0;
}

test the_denylist_is_counted_and_not_trusted {
  assert INJECTION_MARKER_COUNT == 25;
  assert MARKER_MATCH_IS_WORD_BOUNDED == true;
  assert DENYLIST_IS_SUFFICIENT == false;
  assert SANITIZER_REPLACES_WHOLE_TEXT == true;
  assert FILTER_ON_PROMPT_SHORT_CIRCUITS == true;
  assert FILTER_ON_PERSONA_SHORT_CIRCUITS == false;
}

test the_prompt_carries_different_things_on_different_paths {
  assert prompt_carries_shop_facts(ANSWER_DRAFT_COPY) == true;
  assert prompt_carries_shop_facts(ANSWER_ENTERTAINMENT) == false;
  assert prompt_carries_shop_facts(ANSWER_FREE_TEXT) == false;
  assert prompt_carries_customer_datum(ANSWER_FREE_TEXT) == true;
  assert prompt_carries_customer_datum(ANSWER_ENTERTAINMENT) == false;
  assert prompt_carries_customer_datum(ANSWER_DRAFT_COPY) == false;
}

test a_shop_fact_never_enters_an_unreviewed_prompt {
  assert unreviewed_prompt_carries_shop_facts(ANSWER_ENTERTAINMENT) == false;
  assert unreviewed_prompt_carries_shop_facts(ANSWER_FREE_TEXT) == false;
  assert unreviewed_prompt_carries_shop_facts(ANSWER_DRAFT_COPY) == false;
  assert unreviewed_prompt_carries_shop_facts(ANSWER_INVALID) == false;
}

test what_is_asked_for_is_not_what_is_checked {
  assert IMPLEMENTATION_LOC == 454;
  assert SUPERSEDED_IMPLEMENTATION_LOC == 428;
  assert REQUESTED_MAX_TOKENS == 300;
  assert REQUESTED_WORD_CEILING == 200;
  assert RESPONSE_CHARS_ARE_BOUNDED_ON_ARRIVAL == false;
  assert SITES_WITH_AN_OUTPUT_CHECK == DRAFT_COPY_CALL_SITES;
  assert UNREVIEWED_SITES_WITH_AN_OUTPUT_CHECK == 0;
  assert OUTPUT_IS_ESCAPED_AT_EVERY_SITE == true;
}

test the_draft_is_model_written_and_its_gate_belongs_next_door {
  assert DRAFT_TEXT_IS_MODEL_WRITTEN == true;
  assert reaches_a_customer_unreviewed(ANSWER_DRAFT_COPY) == false;
  assert DRAFT_SEND_OWNER == "turbobaby/promo-broadcast";
  assert DRAFT_SEND_OWNER != ID;
  assert DRAFT_CHECK_READS_NUMBERS == false;
  assert NUMERIC_CLAIM_GUARD_IS_NOT_PUBLISHED == true;
  assert SITES_WITH_AN_OUTPUT_CHECK == DRAFT_COPY_CALL_SITES;
}

test the_attempt_budget_is_measured_and_the_provider_is_not_promised {
  assert GLM_ENDPOINTS * GLM_MODELS == GLM_ATTEMPTS;
  assert GROK_ATTEMPTS + GLM_ATTEMPTS == MAX_ATTEMPTS_PER_TURN;
  assert attempts_for(true, true) == 7;
  assert attempts_for(true, false) == GROK_ATTEMPTS;
  assert attempts_for(false, true) == GLM_ATTEMPTS;
  assert attempts_for(false, false) == 0;
  assert RETRIES_OF_THE_SAME_PAIR == 0;
  assert CLIENT_TIMEOUT_SECONDS == 30;
  assert MODEL_NAMES_IN_CODE == 4;
  assert PROVIDER_IS_PINNED_AS_A_GUARANTEE == false;
  assert PROVIDER_NAMES_PUBLISHED.len == 0;
  assert MODEL_NAME_LITERALS_IN_CORPUS == 0;
  assert ENDPOINT_HOSTS_IN_CORPUS == 0;
}

test a_deployment_with_no_key_still_answers {
  assert outcome_with_no_provider_key(true) == TURN_PUBLISHED_FALLBACK;
  assert outcome_with_no_provider_key(false) == TURN_RATE_REFUSAL;
  assert what_is_sent(ANSWER_ENTERTAINMENT, outcome_with_no_provider_key(true)) == SENT_PUBLISHED_KEY;
  assert what_is_sent(ANSWER_FREE_TEXT, outcome_with_no_provider_key(true)) == SENT_PUBLISHED_KEY;
  assert what_is_sent(ANSWER_ENTERTAINMENT, outcome_with_no_provider_key(true)) != SENT_NOTHING;
}

test this_file_claims_nothing_about_the_text_itself {
  assert OUTPUT_QUALITY_IS_CLAIMED == false;
  assert OUTPUT_LANGUAGE_IS_VERIFIED == false;
  assert PROMPT_TEXT_PUBLISHED.len == 0;
  assert CYRILLIC_STRINGS_PUBLISHED.len == 0;
  assert PERSONAL_DATA_FIELDS_PUBLISHED.len == 0;
}

; --- Invariants -------------------------------------------------------------------------------

invariant a_model_answer_is_never_the_answer_of_record
  assert MODEL_IS_AN_ANSWER_OF_RECORD == false and MODEL_IS_A_PRICE_AUTHORITY == false and MODEL_IS_AN_AVAILABILITY_AUTHORITY == false and MODEL_IS_A_TERM_AUTHORITY == false

invariant no_kind_may_deliver_a_model_answer_on_a_price
  assert model_text_may_be_delivered(ANSWER_ENTERTAINMENT, SUBJECT_PRICE) == false and model_text_may_be_delivered(ANSWER_FREE_TEXT, SUBJECT_PRICE) == false and model_text_may_be_delivered(ANSWER_DRAFT_COPY, SUBJECT_PRICE) == false

invariant availability_and_terms_are_closed_to_the_model_on_every_kind
  assert model_text_may_be_delivered(ANSWER_ENTERTAINMENT, SUBJECT_AVAILABILITY) == false and model_text_may_be_delivered(ANSWER_FREE_TEXT, SUBJECT_AVAILABILITY) == false and model_text_may_be_delivered(ANSWER_ENTERTAINMENT, SUBJECT_TERM) == false and model_text_may_be_delivered(ANSWER_FREE_TEXT, SUBJECT_TERM) == false

invariant a_model_that_answers_or_fails_is_never_met_with_silence
  assert what_is_sent(ANSWER_ENTERTAINMENT, TURN_MODEL_TEXT) != SENT_NOTHING and what_is_sent(ANSWER_FREE_TEXT, TURN_MODEL_TEXT) != SENT_NOTHING and what_is_sent(ANSWER_ENTERTAINMENT, TURN_PUBLISHED_FALLBACK) != SENT_NOTHING and what_is_sent(ANSWER_FREE_TEXT, TURN_PUBLISHED_FALLBACK) != SENT_NOTHING and what_is_sent(ANSWER_ENTERTAINMENT, TURN_FILTER_REPLY) != SENT_NOTHING

; The counterpart, and the reason the invariant above is worded about the MODEL and not about the
; turn: a refused turn IS silence on one kind, and this file asserts that rather than hiding it.
; The sentinel never becomes a post. It is the one customer-facing sentence this repository writes
; itself, and the only path on this boundary that could broadcast it is the drafted one.
invariant the_filter_reply_is_never_the_text_of_a_promotional_draft
  assert what_is_sent(ANSWER_DRAFT_COPY, TURN_FILTER_REPLY) == SENT_WRITTEN_FALLBACK and FILTER_REPLY_IS_A_NAMED_CONSTANT == true and sentinel_can_be_published_as_copy(true) == false

; And it is refused without being quoted: the day this reads true by prose, a reworded sentinel
; gets published again.
invariant the_sentinel_is_refused_by_identity_and_not_by_its_words
  assert FILTER_REPLY_IS_MATCHED_BY_PROSE == false and SITES_THAT_TELL_THE_SENTINEL_FROM_A_MODEL_ANSWER == DRAFT_COPY_CALL_SITES and THE_FIRST_DRAFT_CHECK_READS_THE_SENTENCE == false

invariant a_refused_turn_is_silence_on_the_free_text_kind_alone
  assert what_is_sent(ANSWER_FREE_TEXT, TURN_RATE_REFUSAL) == SENT_NOTHING and what_is_sent(ANSWER_ENTERTAINMENT, TURN_RATE_REFUSAL) != SENT_NOTHING and RATE_REFUSAL_SILENT_SITES == 1

invariant a_silent_model_is_answered_by_a_published_key_on_both_customer_kinds
  assert what_is_sent(ANSWER_ENTERTAINMENT, turn_outcome(true, false, false)) == SENT_PUBLISHED_KEY and what_is_sent(ANSWER_FREE_TEXT, turn_outcome(true, false, false)) == SENT_PUBLISHED_KEY

invariant an_absent_provider_key_is_not_an_error_case
  assert outcome_with_no_provider_key(true) == TURN_PUBLISHED_FALLBACK and attempts_for(false, false) == 0

invariant a_shop_fact_never_reaches_an_unreviewed_prompt
  assert unreviewed_prompt_carries_shop_facts(ANSWER_ENTERTAINMENT) == false and unreviewed_prompt_carries_shop_facts(ANSWER_FREE_TEXT) == false and unreviewed_prompt_carries_shop_facts(ANSWER_DRAFT_COPY) == false

invariant the_only_prompt_carrying_a_price_is_read_by_an_owner_first
  assert prompt_carries_shop_facts(ANSWER_DRAFT_COPY) == true and reaches_a_customer_unreviewed(ANSWER_DRAFT_COPY) == false

invariant the_draft_gate_and_its_copy_check_are_named_never_copied
  assert DRAFT_SEND_GATE_IS_RESTATED_HERE == false and DRAFT_COPY_CHECK_IS_RESTATED_HERE == false and DRAFT_SEND_OWNER == REUSES_PROMO_BROADCAST_ID

invariant what_enters_a_prompt_is_clamped_at_both_doors
  assert chars_entering_the_prompt(PROMPT_CHAR_CAP + 1) == PROMPT_CHAR_CAP and chars_entering_the_persona(PERSONA_CHAR_CAP + 1) == PERSONA_CHAR_CAP

invariant what_leaves_is_bounded_nowhere_a_customer_can_see
  assert RESPONSE_CHARS_ARE_BOUNDED_ON_ARRIVAL == false and UNREVIEWED_SITES_WITH_AN_OUTPUT_CHECK == 0 and SITES_WITH_AN_OUTPUT_CHECK == 1

invariant the_denylist_is_never_promoted_to_a_guarantee
  assert DENYLIST_IS_SUFFICIENT == false and FILTER_ON_PERSONA_SHORT_CIRCUITS == false

invariant no_provider_and_no_quality_is_promised_by_this_file
  assert PROVIDER_IS_PINNED_AS_A_GUARANTEE == false and PROVIDER_NAMES_PUBLISHED.len == 0 and MODEL_NAME_LITERALS_IN_CORPUS == 0 and OUTPUT_QUALITY_IS_CLAIMED == false and OUTPUT_LANGUAGE_IS_VERIFIED == false

invariant this_file_publishes_no_prompt_no_cyrillic_and_no_person
  assert PROMPT_TEXT_PUBLISHED.len == 0 and CYRILLIC_STRINGS_PUBLISHED.len == 0 and PERSONAL_DATA_FIELDS_PUBLISHED.len == 0

invariant the_brief_undercounted_the_call_sites_and_the_count_here_is_measured
  assert CALL_SITE_COUNT > BRIEF_CLAIMED_CALL_SITES and CALL_SITES.len == CALL_SITE_COUNT

invariant the_escape_rule_and_the_limiter_are_consumed_never_described
  assert ESCAPE_RULE_IS_RESTATED_HERE == false and RATE_LIMIT_MECHANISM_IS_RESTATED_HERE == false and REUSE_EDGE_COUNT == 7
