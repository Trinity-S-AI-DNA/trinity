; turbobaby/bot-surface has since landed and declares it as its ID. It owns the command
; surface, the admin gate and the escape rule, so none of those three appears below as a table.
; THE EDGE WAS RE-VERIFIED 2026-09-21 AT THE TARGET, not assumed from the string: that file
; declares pub const ID = "turbobaby/bot-surface", the literal below matches it exactly, and the
; three subjects this file defers to are still declared there -- COMMANDS and
; ADMIN_GATED_COMMANDS for the surface and its gate, ESCAPED_CHARS and ESCAPE_REPLACEMENTS for
; the escape rule. The edge points at declarations that exist.
pub const REUSES_BOT_SURFACE_ID : str = "turbobaby/bot-surface";
pub const BOT_SURFACE_WAS_ABSENT_AT_FIRST_MEASUREMENT : bool = true;
pub const BOT_SURFACE_DECLARES_ITS_ID_AT : str = "turbobaby/bot-surface declares ID";
pub const BOT_SURFACE_EDGE_REVERIFIED_AT : str = "2026-09-21";
pub const BOT_SURFACE_TARGET_DECLARATIONS : [4]str = [
    "COMMANDS", "ADMIN_GATED_COMMANDS", "ESCAPED_CHARS", "ESCAPE_REPLACEMENTS",
];
; The count is FILES, not lines and not matches, and it INCLUDES this file and the owner itself.
; Corrected from 10 to 9 by the corpus audit of 2026-09-21; the superseded figure is kept beside
; it so the movement is a measurement and not an edit nobody can see.
pub const SPECS_NAMING_BOT_SURFACE_2026_09_21 : u8 = 9;
pub const SPECS_NAMING_BOT_SURFACE_SUPERSEDED_FIGURE : u8 = 10;
pub const SPECS_NAMING_BOT_SURFACE_UNIT : str = "files";
pub const SPECS_NAMING_BOT_SURFACE_INCLUDES_THIS_FILE : bool = true;
pub const SPECS_NAMING_BOT_SURFACE_AUDITED_AT : str = "2026-09-21";
pub const CORPUS_FILE_COUNT : u8 = 43;
pub const CORPUS_FILES_OTHER_THAN_THIS_ONE : u8 = 42;
; RE-MEASURED 2026-09-21. Files naming this file's ID, and how many of them DEFER rather than
; state a rival boundary. The two figures are equal on purpose: the day they differ, a second
; contract has started owning the model boundary and the header's opening claim is stale again.
pub const SPECS_NAMING_THIS_FILE_2026_09_21 : u8 = 3;
pub const SPECS_DEFERRING_TO_THIS_FILE_2026_09_21 : u8 = 3;
pub const SPECS_CONSTRAINING_THE_BOUNDARY_ELSEWHERE : u8 = 0;
; Re-measured 2026-09-22 and deliberately NOT bound: a census of the corpus moves with every new
; contract. CORPUS_FILE_COUNT and CORPUS_FILES_OTHER_THAN_THIS_ONE above are KEPT at 43 and 42,
; the 2026-09-21 reading and the denominator of the 2026_09_21 counts. The header's "finished
; 43-file corpus" was not finished: 14b01ac added order_presentation.t27 and person_naming.t27
; later on 2026-09-21, and specs/ holds 45 tracked .t27 files. Both censuses were re-run at a33e500
; over the 45, and neither new file names either ID. The files naming the bot-surface ID are
; still 9, this one and the owner included. The files other than this one naming this file's ID
; are the same three, and all three still defer: turbobaby/bot-surface and turbobaby/rate-limit
; name it exactly as they did, and turbobaby/promo-broadcast, which 2c21df1 edited, adds two
; declarations that name this file as an owner and states no boundary of its own.
pub const CORPUS_FILE_COUNT_REMEASURED : u8 = 45;
pub const CORPUS_FILES_OTHER_THAN_THIS_ONE_REMEASURED : u8 = 44;
pub const CORPUS_FILE_COUNT_REMEASURED_AT : str = "2026-09-22";
