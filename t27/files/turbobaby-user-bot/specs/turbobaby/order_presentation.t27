test a_cancellation_has_four_answers_three_outcomes_and_only_a_success_closes_the_dialog {
  assert order_presentation_cancel_answer(true, true, false) == CANCEL_ANSWER_CANCELLED;
  assert order_presentation_cancel_answer(true, false, false) == CANCEL_ANSWER_REFUSED;
  assert order_presentation_cancel_answer(true, false, true) == CANCEL_ANSWER_SERVER_FAILED;
  assert order_presentation_cancel_answer(false, false, false) == CANCEL_ANSWER_NO_ANSWER;
  assert order_presentation_cancel_answer(false, true, false) == CANCEL_ANSWER_NO_ANSWER;
  assert order_presentation_cancel_answer(false, false, true) == CANCEL_ANSWER_NO_ANSWER;
  assert order_presentation_cancel_answer_is_known(CANCEL_ANSWER_UNSET) == false;
  assert order_presentation_cancel_answer_is_known(CANCEL_ANSWER_CANCELLED) == true;
  assert order_presentation_cancel_answer_is_known(CANCEL_ANSWER_REFUSED) == true;
  assert order_presentation_cancel_answer_is_known(CANCEL_ANSWER_NO_ANSWER) == true;
  assert order_presentation_cancel_answer_is_known(CANCEL_ANSWER_SERVER_FAILED) == true;
  assert order_presentation_cancel_answer_is_known(5) == false;
  assert order_presentation_cancel_dialog_closes(CANCEL_ANSWER_CANCELLED) == true;
  assert order_presentation_cancel_dialog_closes(CANCEL_ANSWER_REFUSED) == false;
  assert order_presentation_cancel_dialog_closes(CANCEL_ANSWER_NO_ANSWER) == false;
  assert order_presentation_cancel_dialog_closes(CANCEL_ANSWER_SERVER_FAILED) == false;
  assert order_presentation_cancel_dialog_closes(CANCEL_ANSWER_UNSET) == false;
  assert order_presentation_cancel_told_as_success(CANCEL_ANSWER_CANCELLED) == true;
  assert order_presentation_cancel_told_as_success(CANCEL_ANSWER_REFUSED) == false;
  assert order_presentation_cancel_told_as_success(CANCEL_ANSWER_NO_ANSWER) == false;
  assert order_presentation_cancel_told_as_success(CANCEL_ANSWER_SERVER_FAILED) == false;
  assert CANCEL_ANSWER_KIND_COUNT == 4;
  assert CANCEL_ANSWER_SERVER_FAILED == CANCEL_ANSWER_KIND_COUNT;
  assert CANCEL_OUTCOME_KIND_COUNT == 3;
  assert order_presentation_cancel_outcome_is_unknown(CANCEL_ANSWER_CANCELLED) == false;
  assert order_presentation_cancel_outcome_is_unknown(CANCEL_ANSWER_REFUSED) == false;
  assert order_presentation_cancel_outcome_is_unknown(CANCEL_ANSWER_NO_ANSWER) == true;
  assert order_presentation_cancel_outcome_is_unknown(CANCEL_ANSWER_SERVER_FAILED) == true;
  assert order_presentation_cancel_outcome_is_unknown(CANCEL_ANSWER_UNSET) == false;
}

test every_answer_rereads_the_status_and_an_unknown_one_waits_for_the_reading {
  assert order_presentation_cancel_rereads_status(CANCEL_ANSWER_CANCELLED) == true;
  assert order_presentation_cancel_rereads_status(CANCEL_ANSWER_REFUSED) == true;
  assert order_presentation_cancel_rereads_status(CANCEL_ANSWER_NO_ANSWER) == true;
  assert order_presentation_cancel_rereads_status(CANCEL_ANSWER_SERVER_FAILED) == true;
  assert order_presentation_cancel_rereads_status(CANCEL_ANSWER_UNSET) == false;
  assert order_presentation_cancel_may_send(true, CANCEL_ANSWER_UNSET, REREAD_NOT_YET) == false;
  assert order_presentation_cancel_may_send(false, CANCEL_ANSWER_UNSET, REREAD_NOT_YET) == true;
  assert order_presentation_cancel_may_send(false, CANCEL_ANSWER_NO_ANSWER, REREAD_NOT_YET) == false;
  assert order_presentation_cancel_may_send(false, CANCEL_ANSWER_NO_ANSWER, REREAD_UNREADABLE) == false;
  assert order_presentation_cancel_may_send(false, CANCEL_ANSWER_NO_ANSWER, REREAD_LEFT_PENDING) == false;
  assert order_presentation_cancel_may_send(false, CANCEL_ANSWER_NO_ANSWER, REREAD_STILL_CANCELLABLE) == true;
  assert order_presentation_cancel_may_send(false, CANCEL_ANSWER_SERVER_FAILED, REREAD_NOT_YET) == false;
  assert order_presentation_cancel_may_send(false, CANCEL_ANSWER_SERVER_FAILED, REREAD_UNREADABLE) == false;
  assert order_presentation_cancel_may_send(false, CANCEL_ANSWER_SERVER_FAILED, REREAD_LEFT_PENDING) == false;
  assert order_presentation_cancel_may_send(false, CANCEL_ANSWER_SERVER_FAILED, REREAD_STILL_CANCELLABLE) == true;
  assert order_presentation_cancel_may_send(false, CANCEL_ANSWER_REFUSED, REREAD_NOT_YET) == true;
  assert order_presentation_cancel_may_send(true, CANCEL_ANSWER_REFUSED, REREAD_STILL_CANCELLABLE) == false;
  assert UNANSWERED_CANCELLATION_WAITS_FOR_A_FRESH_READING == true;
  assert SERVER_FAILED_CANCELLATION_WAITS_FOR_A_FRESH_READING == true;
  assert CANCEL_REREAD_OBSERVED_SITE != CANCEL_RESEND_GATE_SITE;
  assert CANCEL_REREAD_OBSERVED_SITE != CANCEL_LINE_SITE;
  assert STATUS_IS_REREAD_AFTER_EVERY_CANCEL_ANSWER == true;
  assert CARD_MUTATES_THE_SCREENS_RESOURCE == false;
  assert CANCEL_REREAD_REQUEST_SITE != CANCEL_REREAD_HANDLER_SITE;
}

test the_answer_is_told_above_the_pending_gate_and_the_label_answers_what_nobody_knows {
  assert order_presentation_cancel_is_told_by_a_line(CANCEL_ANSWER_CANCELLED, REREAD_LEFT_PENDING) == true;
  assert order_presentation_cancel_is_told_by_a_line(CANCEL_ANSWER_REFUSED, REREAD_LEFT_PENDING) == true;
  assert order_presentation_cancel_is_told_by_a_line(CANCEL_ANSWER_NO_ANSWER, REREAD_NOT_YET) == true;
  assert order_presentation_cancel_is_told_by_a_line(CANCEL_ANSWER_NO_ANSWER, REREAD_UNREADABLE) == true;
  assert order_presentation_cancel_is_told_by_a_line(CANCEL_ANSWER_NO_ANSWER, REREAD_STILL_CANCELLABLE) == true;
  assert order_presentation_cancel_is_told_by_a_line(CANCEL_ANSWER_NO_ANSWER, REREAD_LEFT_PENDING) == false;
  assert order_presentation_cancel_is_told_by_a_line(CANCEL_ANSWER_SERVER_FAILED, REREAD_NOT_YET) == true;
  assert order_presentation_cancel_is_told_by_a_line(CANCEL_ANSWER_SERVER_FAILED, REREAD_STILL_CANCELLABLE) == true;
  assert order_presentation_cancel_is_told_by_a_line(CANCEL_ANSWER_SERVER_FAILED, REREAD_LEFT_PENDING) == false;
  assert order_presentation_cancel_is_told_by_a_line(CANCEL_ANSWER_UNSET, REREAD_NOT_YET) == false;
  assert CANCEL_ANSWER_IS_TOLD == true;
  assert CANCEL_ANSWER_WAS_TOLD_BEFORE_REPAIR == false;
  assert CANCEL_ANSWER_IS_TOLD_OUTSIDE_THE_PENDING_GATE == true;
  assert CANCEL_LINE_SITE != CANCEL_OFFER_GATE_SITE;
}

test the_cancel_offer_is_withdrawn_once_the_server_confirms {
  assert order_presentation_cancel_offered(ARM_PENDING, true, CANCEL_ANSWER_UNSET) == true;
  assert order_presentation_cancel_offered(ARM_PENDING, true, CANCEL_ANSWER_REFUSED) == true;
  assert order_presentation_cancel_offered(ARM_PENDING, true, CANCEL_ANSWER_NO_ANSWER) == true;
  assert order_presentation_cancel_offered(ARM_PENDING, true, CANCEL_ANSWER_SERVER_FAILED) == true;
  assert order_presentation_cancel_offered(ARM_PENDING, true, CANCEL_ANSWER_CANCELLED) == false;
  assert order_presentation_cancel_offered(ARM_CONFIRMED, true, CANCEL_ANSWER_UNSET) == false;
  assert order_presentation_cancel_offered(ARM_PENDING, false, CANCEL_ANSWER_UNSET) == false;
  assert order_presentation_cancel_offer_withdrawn(CANCEL_ANSWER_REFUSED) == false;
  assert CANCEL_OFFER_IS_WITHDRAWN_AFTER_A_CONFIRMED_SUCCESS == true;
  assert NO_BUTTON_STAYS_ENABLED_WHILE_A_REQUEST_IS_OUT == true;
  assert CLIENT_CAN_END_A_REQUEST_THAT_NEVER_ANSWERS == false;
}

