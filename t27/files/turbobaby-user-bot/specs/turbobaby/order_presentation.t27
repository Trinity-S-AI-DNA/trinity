  assert DETAIL_STATUS_LITERAL_COUNT_BEFORE_REPAIR == 23;
  assert STEPPER_STATUS_LITERAL_COUNT_BEFORE_REPAIR == 33;
  assert READING_IS_A_READER_NOT_A_COLUMN_ENUMERATION == true;
  assert READING_ARMS_ARE_BOUND_TO_THE_VOCABULARY == true;
}

test the_status_helper_block_left_this_boundary {
  assert HELPER_BLOCK_COPY_COUNT == 0;
