; --- The progress bar, and what it says about a status nobody recognised -----------------------
; The pipeline CONTENT is the order-status contract's. What is owned here is the rendering rule
; applied to a name that pipeline does not carry, and its consequence. The lookup resolves such a
; name to the index AFTER the last step (UNRESOLVED_INDEX_RULE_SITE_BEFORE_REPAIR, unwrap_or on
; the slice length) and a segment is drawn filled whenever its index is at or below the current
; one (SEGMENT_FILL_RULE_SITE_BEFORE_REPAIR). Every segment therefore fills. The functions below
; take the pipeline length as an ARGUMENT and are asserted at three different lengths, so the
; claim made here is about the SHAPE of the rule and not about any number belonging to the owner.
; CORRECTED 2026-09-22: that was the rule at commit 14b01ac, and its two functions are kept under
; _before_repair names. Since the repair a status resolves to one of four PROGRESS answers. A
; string the reading cannot read is UNREADABLE and a cancelled or rejected order is STOPPED: both
; draw one flat bar in the arm's own colour (FLAT_BAR_SITE) and fill nothing. A finished order is
; FINISHED through its own arm and fills everything. Every other known arm is AT a step of the
; pipeline. The naive repair -- a name off the pipeline fills nothing -- would have emptied the bar
; of every finished order, because the persisted alias is off the pipeline; FINISHED is why it did
; not. A mixed-case cancelled order drew the FULL GREEN bar under a red cancelled label before the
; repair, because the stepper's flat-bar check compared raw and its label folded case.
pub const PROGRESS_AT_STEP : u8 = 1;
pub const PROGRESS_FINISHED : u8 = 2;
pub const PROGRESS_STOPPED : u8 = 3;
pub const PROGRESS_UNREADABLE : u8 = 4;
pub const UNRESOLVED_INDEX_RULE_SITE_BEFORE_REPAIR : str = "src/ui/components/status_stepper.rs:29";
pub const SEGMENT_FILL_RULE_SITE : str = "src/trios/order_status_view.rs:238";
pub const SEGMENT_FILL_RULE_SITE_BEFORE_REPAIR : str = "src/ui/components/status_stepper.rs:73-74";
pub const UNREADABLE_PROGRESS_SITE : str = "src/trios/order_status_view.rs:225";
pub const FLAT_BAR_RULE_SITE : str = "src/trios/order_status_view.rs:246";
pub const FLAT_BAR_SITE : str = "src/ui/components/status_stepper.rs:63";
pub const PIPELINE_LENGTH_IS_DECLARED_HERE : bool = false;
; Where the pipeline sits is the order-status contract's citation (PIPELINE_SITE_DECLARATION): it
; moved into READING_IMPLEMENTATION on 2026-09-22 so host tests can read it. The module is owned
; here, the content is not, and the host tests pin it to the owner's declarations.
pub const PIPELINE_CONTENT_IS_OWNED_HERE : bool = false;
pub const PIPELINE_CONTENT_IS_PINNED_BY_HOST_TESTS : bool = true;

pub fn order_presentation_unresolved_index(pipeline_length: u8) u8 {
  return pipeline_length;
}

pub fn order_presentation_bar_index_before_repair(carried_by_the_pipeline: bool, index_if_carried: u8, pipeline_length: u8) u8 {
  if (!carried_by_the_pipeline) {
    return order_presentation_unresolved_index(pipeline_length);
  }
  return index_if_carried;
}

pub fn order_presentation_segments_filled(current: u8, pipeline_length: u8) u8 {
  if (current + 1 >= pipeline_length) {
    return pipeline_length;
  }
  return current + 1;
}

pub fn order_presentation_last_index(pipeline_length: u8) u8 {
  if (pipeline_length == 0) {
    return 0;
  }
  return pipeline_length - 1;
}

pub fn order_presentation_reads_as_finished_before_repair(carried_by_the_pipeline: bool, index_if_carried: u8, pipeline_length: u8) bool {
  return order_presentation_segments_filled(order_presentation_bar_index_before_repair(carried_by_the_pipeline, index_if_carried, pipeline_length), pipeline_length) == pipeline_length;
}

; The repaired rule. carried_by_the_pipeline is whether the pipeline holds a step for the arm; it
; is only consulted for an arm that is neither unresolved, stopped nor finished.
pub fn order_presentation_progress_of(arm: u8, carried_by_the_pipeline: bool) u8 {
  if (arm == ARM_UNRESOLVED) {
    return PROGRESS_UNREADABLE;
  }
  if (arm == ARM_CANCELLED_OR_REJECTED) {
    return PROGRESS_STOPPED;
  }
  if (arm == ARM_DELIVERED_OR_COMPLETED) {
    return PROGRESS_FINISHED;
  }
  if (!carried_by_the_pipeline) {
    return PROGRESS_UNREADABLE;
  }
  return PROGRESS_AT_STEP;
}

pub fn order_presentation_filled(progress: u8, index_if_at_step: u8, pipeline_length: u8) u8 {
  if (progress == PROGRESS_FINISHED) {
    return pipeline_length;
  }
  if (progress == PROGRESS_AT_STEP) {
    return order_presentation_segments_filled(index_if_at_step, pipeline_length);
  }
  return 0;
}

pub fn order_presentation_draws_one_flat_bar(progress: u8) bool {
  return progress == PROGRESS_STOPPED or progress == PROGRESS_UNREADABLE;
}

pub fn order_presentation_reads_as_finished(progress: u8, index_if_at_step: u8, pipeline_length: u8) bool {
  return order_presentation_filled(progress, index_if_at_step, pipeline_length) == pipeline_length;
}

