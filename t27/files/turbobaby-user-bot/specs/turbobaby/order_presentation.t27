; The six figures, as this file's own enumeration: the five money figures and the star count,
; which is a count and not an amount but shares the bonus row's rule.
pub const FIGURE_LINE_TOTAL : u8 = 1;
pub const FIGURE_LIST_TOTAL : u8 = 2;
pub const FIGURE_SUBTOTAL : u8 = 3;
pub const FIGURE_BONUS : u8 = 4;
pub const FIGURE_TOTAL : u8 = 5;
pub const FIGURE_STARS : u8 = 6;
pub const FIGURE_COUNT : u8 = 6;

; Where a zero is a measurement. Each answer is taken from the place that owns it, and none is
; invented here. A TOTAL of zero is a measurement: the order-money contract floors its identity at
; zero (TOTAL_FLOOR_DECLARATION), so an order the discounts paid in full totals zero, and the list
; total is the same stored figure. A BONUS or STAR discount of zero means none was applied. A LINE
; price of zero is absent: D9 measured that a price of 0 reads as FREE, and the published filter
; refuses it. The SUBTOTAL is the sum of the line prices, so its zero is a sum of absences and is
; absent too; before the repair it printed as a zero four lines below a dashed line, which is the
; very shape the 2026-09-21 reading called broken.
pub const TOTAL_ZERO_IS_A_MEASUREMENT : bool = true;
pub const SUBTOTAL_ZERO_IS_A_MEASUREMENT : bool = false;
pub const LINE_PRICE_ZERO_IS_A_MEASUREMENT : bool = false;
pub const DISCOUNT_ZERO_OMITS_ITS_ROW : bool = true;

pub fn order_presentation_zero_is_a_measurement(figure: u8) bool {
  return figure == FIGURE_LIST_TOTAL or figure == FIGURE_TOTAL or figure == FIGURE_BONUS or figure == FIGURE_STARS;
}

pub fn order_presentation_figure_is_a_discount(figure: u8) bool {
  return figure == FIGURE_BONUS or figure == FIGURE_STARS;
}

; The repaired rule, one shape of absence. value_is_usable is the order rule's filter: finite and
; not negative for an amount, not negative for the star count.
pub fn order_presentation_figure_shape(figure: u8, field_present: bool, value_is_usable: bool, value_is_zero: bool) u8 {
  if (!field_present) {
    return ABSENCE_RENDERS_AS_DASH;
  }
  if (!value_is_usable) {
    return ABSENCE_RENDERS_AS_DASH;
  }
  if (value_is_zero and !order_presentation_zero_is_a_measurement(figure)) {
    return ABSENCE_RENDERS_AS_DASH;
  }
  if (value_is_zero and order_presentation_figure_is_a_discount(figure)) {
    return MEASURED_ZERO_OMITS_ITS_ROW;
  }
  return FIGURE_SHOWN;
}

; The rule at commit 14b01ac, kept executable as the record of the four shapes.
pub fn order_presentation_figure_shape_before_repair(field_present: bool, value_is_usable: bool, filtered_by_published: bool, row_is_conditional: bool) u8 {
  if (!field_present and !filtered_by_published) {
    return ABSENCE_RENDERS_AS_A_LOST_SCREEN;
  }
  if (value_is_usable) {
    return FIGURE_SHOWN;
  }
  if (filtered_by_published) {
    return ABSENCE_RENDERS_AS_DASH;
  }
  if (row_is_conditional) {
    return ABSENCE_RENDERS_AS_OMITTED_ROW;
  }
  return ABSENCE_RENDERS_AS_ZERO;
}

pub fn order_presentation_absence_is_honest(shape: u8) bool {
  return shape == ABSENCE_RENDERS_AS_DASH;
}

pub fn order_presentation_shape_is_an_absence(shape: u8) bool {
  return shape >= ABSENCE_RENDERS_AS_DASH and shape <= ABSENCE_RENDERS_AS_A_LOST_SCREEN;
}

; The detail screen shows all four terms of the order-money identity -- subtotal, bonus, stars and
; total -- one under the other, and checks none of them against each other. The arithmetic belongs
; to that contract and is not restated here; what is owned here is the display fact, which is that
; a customer is handed four numbers that are supposed to agree and a screen that never asks
; whether they do. A disagreement between them reaches the customer silently.
; CORRECTED 2026-09-22, the money repair: the four sites are the same lines, now printing the order
; rule's text and not a formatted bare number. Still nothing checks them against each other, and
; the repair adds no check on purpose: a check on the screen would be a fourth copy of the
; order-money identity, whose copies that contract counts (IDENTITY_CENSUS_DECLARATION). It is the
; one thing that could tell the server's substituted zero from a real one, and it is not built here.
; (2026-09-23: the server no longer substitutes; the check would now guard only a stored finite
; figure that breaks the identity, and it is still not built here.)
pub const IDENTITY_TERMS_SHOWN : u8 = 4;
pub const IDENTITY_TERM_SITES : [4]str = [
