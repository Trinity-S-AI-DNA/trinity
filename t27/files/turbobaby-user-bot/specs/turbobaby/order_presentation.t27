test an_order_of_the_previous_shop_is_not_shown_at_all {
  assert PREVIOUS_SHOP_ORDER_DECIDED_AT == "2026-09-26";
  assert PREVIOUS_SHOP_ORDER_DECIDED_AT == RETIRED_SHOP_DECIDED_AT;
  assert PREVIOUS_SHOP_ORDER_READ_AS != "";
  assert PREVIOUS_SHOP_ORDER_SHOWN == false;
  assert order_presentation_order_is_shown(true, true) == false;
  assert order_presentation_order_is_shown(true, false) == false;
  assert order_presentation_order_is_shown(false, false) == false;
  assert order_presentation_order_is_shown(false, true) == true;
  assert PREVIOUS_SHOP_ORDER_BY_ID_ANSWERS_AS_MISSING == true;
  assert PREVIOUS_SHOP_ORDER_BY_ID_STATUS == 404;
  // the detail, the status and the cancel ask by id; the list and the profile count are the other two
  assert PREVIOUS_SHOP_ORDER_BY_ID_READS + 2 == PREVIOUS_SHOP_ORDER_CUSTOMER_READ_COUNT;
  assert PREVIOUS_SHOP_ORDER_TAKES_A_LIST_PLACE == false;
  assert PREVIOUS_SHOP_ORDER_LIST_LIMIT == 50;
  assert PREVIOUS_SHOP_ORDER_CUSTOMER_READS.len == PREVIOUS_SHOP_ORDER_CUSTOMER_READ_COUNT;
  // the two reads that mask a line are the first two that ask the order rule
  assert PREVIOUS_SHOP_ORDER_CUSTOMER_READS[0] == RETIRED_LINE_CUSTOMER_READS[0];
  assert PREVIOUS_SHOP_ORDER_CUSTOMER_READS[1] == RETIRED_LINE_CUSTOMER_READS[1];
  assert PREVIOUS_SHOP_ORDER_CUSTOMER_READS[4] == "get_profile";
  assert PREVIOUS_SHOP_ORDER_ADMIN_READS_CHANGED == false;
  assert RETIRED_LINE_ADMIN_READS_KEEP_THE_ROW == true;
  assert PREVIOUS_SHOP_ORDER_WRITES_A_ROW == false;
  assert RETIRED_LINE_WRITES_A_ROW == false;
}

test the_neutral_name_is_served_only_beside_a_rental_line {
  assert PREVIOUS_SHOP_ORDER_MIXED_IS_SHOWN == true;
  // a mixed order is shown, and its line of a retired kind keeps the neutral name and figures
  assert order_presentation_order_is_shown(false, true) == true;
  assert order_presentation_line_is_retired(false) == true;
  assert order_presentation_retired_line_field_count(true, true) == RETIRED_LINE_KEPT_FIELD_COUNT + 1;
  // an order of retired lines alone is not shown, so none of its lines reaches a customer
  assert order_presentation_order_is_shown(false, false) == false;
  // naming the previous shop outranks a bike line
  assert order_presentation_order_is_shown(true, true) == false;
}

test a_bike_line_is_named_by_its_stored_name_else_its_family_key {
  assert BIKE_LINE_NAME_FIXED_AT == "2026-09-26";
  assert BIKE_LINE_NAME_RULE == "src/trios/order_line.rs";
  // the stored name is tried first, the family key second, and nothing else
  assert BIKE_LINE_NAME_FIELDS.len == 2;
  assert BIKE_LINE_NAME_FIELDS[0] == "bike_name";
  assert BIKE_LINE_NAME_FIELDS[1] == "bike_key";
  assert order_presentation_bike_line_name_source(true, true) == BIKE_LINE_NAME_FROM_NAME;
  assert order_presentation_bike_line_name_source(true, false) == BIKE_LINE_NAME_FROM_NAME;
  assert order_presentation_bike_line_name_source(false, true) == BIKE_LINE_NAME_FROM_KEY;
  assert order_presentation_bike_line_name_source(false, false) == BIKE_LINE_NAME_FROM_NOTHING;
  assert BIKE_LINE_NAME_FROM_NAME != BIKE_LINE_NAME_FROM_KEY;
  // what a bike line printed until then, and what it prints now
  assert BIKE_LINE_PRINTED_UNKNOWN_BEFORE_2026_09_26 == true;
  assert BIKE_LINE_PRINTS_UNKNOWN == false;
  assert BIKE_LINE_NAME_IS_LOOKED_UP == false;
  assert BIKE_LINE_NAME_IS_INVENTED == false;
  // a bike line is never a retired line, so the neutral name never stands in for a bike
  assert order_presentation_line_is_retired(true) == false;
  // the keyless fallback stays on its cited lines, and no cited line moved
  assert BIKE_LINE_UNKNOWN_FALLBACK_KEPT == true;
  assert KEYLESS_CUSTOMER_STRING_SITE_COUNT == 6;
  assert KEYLESS_CUSTOMER_STRING_SITES[0] == "src/ui/screens/orders_screen.rs:53";
  assert KEYLESS_CUSTOMER_STRING_SITES[3] == "src/ui/screens/order_detail_screen.rs:152";
  assert LIST_LINE_COUNT == 411;
  assert DETAIL_LINE_COUNT == 589;
  // one name site per screen that prints a line, the same screens as the retired line's
  assert BIKE_LINE_NAME_SITES.len == RETIRED_LINE_PRINT_SITES.len;
  assert BIKE_LINE_NAME_WITNESS == "tests/order_presentation_wiring.rs";
}

; --- Invariants -----------------------------------------------------------------------------------

invariant an_order_of_the_previous_shop_is_never_shown_and_nothing_is_written_for_it
  assert order_presentation_order_is_shown(true, true) == false and order_presentation_order_is_shown(false, false) == false and PREVIOUS_SHOP_ORDER_SHOWN == false and PREVIOUS_SHOP_ORDER_WRITES_A_ROW == false

invariant an_order_of_the_previous_shop_never_reads_as_this_one
  assert RETIRED_SHOP_READS_AS_THIS_SHOP == false and RETIRED_SHOP_LABEL_SHOWN == false and THIS_SHOPS_ORDERS_KEEP_THEIR_LABEL == true

invariant a_line_of_the_old_catalogue_is_never_served_more_than_its_name_and_stored_figures
  assert order_presentation_retired_line_field_count(true, true) == 3 and RETIRED_LINE_SERVES_AN_ID == false and RETIRED_LINE_SERVES_AN_UNDECLARED_KEY == false and RETIRED_LINE_WRITES_A_ROW == false

invariant only_a_confirmed_success_closes_the_cancel_dialog
  assert order_presentation_cancel_dialog_closes(CANCEL_ANSWER_CANCELLED) == true and order_presentation_cancel_dialog_closes(CANCEL_ANSWER_REFUSED) == false and order_presentation_cancel_dialog_closes(CANCEL_ANSWER_NO_ANSWER) == false and order_presentation_cancel_dialog_closes(CANCEL_ANSWER_SERVER_FAILED) == false

invariant a_refused_or_unanswered_cancellation_is_never_told_as_a_success
  assert order_presentation_cancel_told_as_success(CANCEL_ANSWER_REFUSED) == false and order_presentation_cancel_told_as_success(CANCEL_ANSWER_NO_ANSWER) == false and order_presentation_cancel_told_as_success(CANCEL_ANSWER_SERVER_FAILED) == false

invariant every_cancel_answer_rereads_the_status
  assert order_presentation_cancel_rereads_status(CANCEL_ANSWER_CANCELLED) == true and order_presentation_cancel_rereads_status(CANCEL_ANSWER_REFUSED) == true and order_presentation_cancel_rereads_status(CANCEL_ANSWER_NO_ANSWER) == true and order_presentation_cancel_rereads_status(CANCEL_ANSWER_SERVER_FAILED) == true

invariant an_unanswered_cancellation_is_never_repeated_before_a_fresh_reading
  assert order_presentation_cancel_may_send(false, CANCEL_ANSWER_NO_ANSWER, REREAD_NOT_YET) == false and order_presentation_cancel_may_send(false, CANCEL_ANSWER_NO_ANSWER, REREAD_UNREADABLE) == false and order_presentation_cancel_may_send(true, CANCEL_ANSWER_REFUSED, REREAD_STILL_CANCELLABLE) == false

invariant a_failure_of_the_servers_own_is_never_repeated_before_a_fresh_reading
  assert order_presentation_cancel_may_send(false, CANCEL_ANSWER_SERVER_FAILED, REREAD_NOT_YET) == false and order_presentation_cancel_may_send(false, CANCEL_ANSWER_SERVER_FAILED, REREAD_UNREADABLE) == false and order_presentation_cancel_may_send(false, CANCEL_ANSWER_SERVER_FAILED, REREAD_LEFT_PENDING) == false and order_presentation_cancel_outcome_is_unknown(CANCEL_ANSWER_SERVER_FAILED) == true

invariant the_dialog_has_two_closes_and_only_one_answers_the_server
  assert CANCEL_DIALOG_CLOSES == CANCEL_DIALOG_CLOSES_UNDER_THE_VERDICT + CANCEL_DIALOG_CLOSES_ON_THE_CUSTOMERS_NO and CANCEL_DIALOG_CLOSES_UNDER_THE_VERDICT == 1 and DIALOG_CLOSES_THAT_FOLLOW_ANOTHER_STATEMENT == 0

invariant the_customer_has_no_label_that_separates_the_alias_pair
  assert order_presentation_arm_is_shared(ARM_DELIVERED_OR_COMPLETED) == true and CUSTOMER_VISIBLE_DIFFERENCE_BETWEEN_THE_PAIR == 0 and NO_COMPLETED_LABEL_KEY_EXISTS == true

invariant nine_names_reach_eight_keys_and_the_shortfall_is_two_shared_arms
  assert SERVER_NAME_COUNT_CONSUMED - NON_FALLBACK_ARM_COUNT == SHARED_ARM_COUNT and ARM_COUNT == LABEL_KEY_COUNT and LABEL_KEY_NAMES.len == LABEL_KEY_COUNT

invariant no_arm_resolves_to_two_keys_and_no_arm_resolves_to_none
  assert order_presentation_label_key(ARM_UNRESOLVED) == LABEL_KEY_NAMES[7] and order_presentation_label_key(ARM_PENDING) == LABEL_KEY_NAMES[0] and order_presentation_label_key(ARM_CANCELLED_OR_REJECTED) == LABEL_KEY_NAMES[6]

invariant every_arm_lands_under_exactly_one_partitioning_chip
  assert order_presentation_chip_of(ARM_DELIVERED_OR_COMPLETED, true) == CHIP_COMPLETED and order_presentation_chip_of(ARM_CANCELLED_OR_REJECTED, true) == CHIP_CANCELLED and order_presentation_chip_of(ARM_PENDING, true) == CHIP_ACTIVE and order_presentation_chip_of(ARM_UNRESOLVED, true) == CHIP_ACTIVE

invariant a_status_this_software_cannot_read_is_never_filtered_out_of_sight
  assert order_presentation_is_shown_under(CHIP_ALL, ARM_UNRESOLVED, true) == true and order_presentation_chip_of(ARM_UNRESOLVED, true) == CHIP_ACTIVE and UNRESOLVED_STATUS_IS_FILTERED_AS_ACTIVE == true

invariant a_different_spelling_moves_the_label_and_the_chip_together
  assert order_presentation_chip_of(ARM_DELIVERED_OR_COMPLETED, false) == CHIP_ACTIVE and order_presentation_label_key(order_presentation_arm_as_read(ARM_DELIVERED_OR_COMPLETED, false)) == LABEL_KEY_NAMES[7] and READERS_AGREE_ON_CASE == true

invariant a_different_spelling_removes_every_action_the_customer_had
  assert order_presentation_cancel_button_shown(ARM_PENDING, false) == false and order_presentation_reorder_button_shown(ARM_DELIVERED_OR_COMPLETED, false) == false

invariant one_reading_of_the_string_is_shipped_and_it_is_exact
  assert CASE_NORMALIZING_READER_COUNT + RAW_READER_COUNT == STATUS_READER_COUNT and STATUS_READER_COUNT == 1 and CASE_NORMALIZING_READER_COUNT == 0 and STATUS_READING_IS_EXACT == true and STATUS_IS_NORMALISED_BEFORE_IT_REACHES_THE_SCREENS == false

invariant an_unreadable_status_reads_as_finished_at_no_pipeline_length
  assert order_presentation_reads_as_finished(PROGRESS_UNREADABLE, 0, 4) == false and order_presentation_reads_as_finished(PROGRESS_UNREADABLE, 0, 6) == false and order_presentation_reads_as_finished(PROGRESS_UNREADABLE, 0, 9) == false

invariant a_step_before_the_last_never_reads_as_finished
  assert order_presentation_reads_as_finished(PROGRESS_AT_STEP, 0, 6) == false and order_presentation_reads_as_finished(PROGRESS_AT_STEP, 4, 6) == false and order_presentation_reads_as_finished(PROGRESS_AT_STEP, 5, 6) == true

invariant completed_reaches_the_last_step_through_its_arm_not_by_accident
  assert order_presentation_progress_of(ARM_DELIVERED_OR_COMPLETED, false) == PROGRESS_FINISHED and order_presentation_reads_as_finished(PROGRESS_FINISHED, 0, 6) == true and COMPLETED_SHARES_THE_UNRESOLVED_BRANCH_IN_THE_STEPPER == false

invariant a_stopped_or_unreadable_order_draws_one_flat_bar_and_fills_nothing
  assert order_presentation_draws_one_flat_bar(PROGRESS_STOPPED) == true and order_presentation_draws_one_flat_bar(PROGRESS_UNREADABLE) == true and order_presentation_filled(PROGRESS_STOPPED, 5, 6) == 0 and order_presentation_filled(PROGRESS_UNREADABLE, 5, 6) == 0

invariant only_the_dash_is_an_honest_answer_to_an_absent_figure
  assert order_presentation_absence_is_honest(ABSENCE_RENDERS_AS_DASH) == true and order_presentation_absence_is_honest(ABSENCE_RENDERS_AS_ZERO) == false and order_presentation_absence_is_honest(ABSENCE_RENDERS_AS_OMITTED_ROW) == false and order_presentation_absence_is_honest(ABSENCE_RENDERS_AS_A_LOST_SCREEN) == false

invariant before_the_repair_an_unfiltered_figure_could_never_produce_a_dash
  assert order_presentation_figure_shape_before_repair(true, false, false, false) == ABSENCE_RENDERS_AS_ZERO and order_presentation_figure_shape_before_repair(true, false, true, false) == ABSENCE_RENDERS_AS_DASH

invariant absence_has_exactly_one_shape_on_these_screens
  assert order_presentation_figure_shape(FIGURE_TOTAL, false, false, false) == ABSENCE_RENDERS_AS_DASH and order_presentation_figure_shape(FIGURE_BONUS, true, false, false) == ABSENCE_RENDERS_AS_DASH and order_presentation_figure_shape(FIGURE_STARS, true, false, true) == ABSENCE_RENDERS_AS_DASH and ABSENCE_SHAPE_COUNT == 1

invariant a_measured_zero_is_never_rendered_as_an_absence
  assert order_presentation_figure_shape(FIGURE_TOTAL, true, true, true) == FIGURE_SHOWN and order_presentation_figure_shape(FIGURE_LIST_TOTAL, true, true, true) == FIGURE_SHOWN and order_presentation_shape_is_an_absence(order_presentation_figure_shape(FIGURE_BONUS, true, true, true)) == false

invariant a_zero_line_price_or_subtotal_is_never_printed_as_a_price
  assert order_presentation_figure_shape(FIGURE_LINE_TOTAL, true, true, true) == ABSENCE_RENDERS_AS_DASH and order_presentation_figure_shape(FIGURE_SUBTOTAL, true, true, true) == ABSENCE_RENDERS_AS_DASH

invariant no_money_site_is_unfiltered_and_the_wire_withholds_what_nobody_computed
  assert DASH_FILTERED_SITE_COUNT + UNFILTERED_SITE_COUNT == MONEY_RENDER_SITE_COUNT and UNFILTERED_SITE_COUNT == 0 and A_FIGURE_NOBODY_COMPUTED_REACHES_THE_CUSTOMER_AS_THE_DASH == true and WIRE_SUBSTITUTES_ZERO_FOR_AN_UNUSABLE_STORED_FIGURE == false

; CORRECTED 2026-09-24: this invariant read the_wire_says_absent_and_the_committed_dist_does_not_read_it_yet
; and pinned SHIPPED_CLIENT_REBUILT_WITH_THIS_CHANGE == false; the landing change rebuilt dist/.
invariant the_wire_says_absent_and_the_committed_dist_reads_it
  assert SERVER_MAY_SEND_AN_ABSENT_FIGURE == true and CUSTOMER_VISIBLE_ABSENCE_SHAPE_COUNT == ABSENCE_SHAPE_COUNT and ABSENCE_READING_SITES.len == 4 and SHIPPED_CLIENT_REBUILT_WITH_THIS_CHANGE == true and SHIPPING_THIS_SERVER_WITH_THE_COMMITTED_DIST_LOSES_SCREENS == false and SHIPPING_THIS_SERVER_WITH_THE_COMMITTED_DIST_LOST_SCREENS_BEFORE_THE_REBUILD == true and D9_IS_OBEYED_BY_EVERY_FIGURE_ON_THESE_SCREENS == false

invariant no_sentence_and_no_bike_line_rule_is_supplied_here
  assert ORDER_FIGURE_DASH_HAS_A_PUBLISHED_SENTENCE == false and BIKE_LINE_ORDER_TOTAL_HAS_A_DISPLAY_RULE == false and OWNER_QUESTION_ORDER_FIGURE_SENTENCE_IS_OPEN == true and OWNER_QUESTION_BIKE_LINE_TOTAL_IS_OPEN == true

invariant the_delivery_payload_stays_wider_than_what_the_customer_is_shown
  assert STATUS_PAYLOAD_FIELD_COUNT > FIELDS_DECLARED_BY_THE_SCREEN and FIELDS_DECLARED_BY_THE_SCREEN > FIELDS_THAT_REACH_THE_CUSTOMER and NO_DELIVERY_FIGURE_REACHES_EITHER_OWNED_SCREEN == true

invariant the_live_badge_is_keyed_on_presence_because_there_is_no_age_to_key_it_on
  assert order_presentation_live_badge_shown(true) == true and STATUS_PAYLOAD_CARRIES_A_TIMESTAMP == false and order_presentation_poll_horizon_ms(POLL_INTERVAL_MS, POLL_TICK_LIMIT) == POLL_HORIZON_MS

invariant this_contract_names_other_owners_and_copies_none_of_their_tables
  assert REUSES_ORDER_STATUS_ID != ID and REUSES_ORDER_MONEY_ID != ID and REUSES_PRICING_HONESTY_ID != ID and REUSES_CLIENT_ERRORS_ID != ID and REUSES_COMMERCE_ID != ID and THIS_FILE_RESTATES_A_NEIGHBOUR_TABLE == false

invariant the_alias_question_stays_open_and_no_status_name_is_invented_here
  assert THIS_FILE_RESOLVES_THE_ALIAS == false and NO_STATUS_NAME_IS_INVENTED_HERE == true and order_presentation_arm_is_known(ARM_UNRESOLVED) == false and OWNER_QUESTION_ALIAS_LABEL_IS_OPEN == true

invariant no_order_identity_and_no_user_copy_ever_enters_this_file
  assert NO_ORDER_IDENTITY_IS_CARRIED_HERE == true and D14_NOTE != "" and LABEL_KEY_NAMES[7] == "T_ORDERS_STATUS_UNKNOWN"

; Since 2026-09-26 a bike line is named by what the line itself says, and never by a guess.
invariant a_bike_line_is_named_by_the_line_and_never_by_a_guess
  assert BIKE_LINE_PRINTS_UNKNOWN == false and BIKE_LINE_NAME_IS_INVENTED == false and BIKE_LINE_NAME_IS_LOOKED_UP == false and order_presentation_bike_line_name_source(false, true) == BIKE_LINE_NAME_FROM_KEY
