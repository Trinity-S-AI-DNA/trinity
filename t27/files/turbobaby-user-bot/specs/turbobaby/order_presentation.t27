; Where a bike line's printed name comes from, given whether each field has text.
pub fn order_presentation_bike_line_name_source(name_has_text: bool, key_has_text: bool) u8 {
  if (name_has_text) {
    return BIKE_LINE_NAME_FROM_NAME;
  }
  if (key_has_text) {
    return BIKE_LINE_NAME_FROM_KEY;
  }
  return BIKE_LINE_NAME_FROM_NOTHING;
}

; --- The live view, and what it promises --------------------------------------------------------
; The detail screen polls the status endpoint on a bounded schedule: 360 ticks, ten seconds apart
; (src/ui/screens/order_detail_screen.rs:439-446), which is one hour and then silence. A live
; badge is shown whenever a status response EXISTS (:247). It is not shown on the freshness of
; that response, and could not be: the payload carries no timestamp of any kind. So the badge
; makes a promise about currency that nothing in the payload can support, and when the hour is up
; it keeps making it. order_presentation_live_badge_shown takes no age argument, and that omission
; is the specification: there is no age to take.
pub const POLL_INTERVAL_MS : u32 = 10000;
pub const POLL_TICK_LIMIT : u32 = 360;
pub const POLL_HORIZON_MS : u32 = 3600000;
pub const POLL_SITE : str = "src/ui/screens/order_detail_screen.rs:439-446";
pub const LIVE_BADGE_SITE : str = "src/ui/screens/order_detail_screen.rs:247-252";
pub const STATUS_PAYLOAD_CARRIES_A_TIMESTAMP : bool = false;
pub const LIVE_BADGE_IS_KEYED_ON_PRESENCE : bool = true;

pub fn order_presentation_poll_horizon_ms(interval_ms: u32, tick_limit: u32) u32 {
  return interval_ms * tick_limit;
}

pub fn order_presentation_live_badge_shown(status_response_present: bool) bool {
  return status_response_present;
}

; CORRECTED 2026-09-22, the cancel repair. "One hour and then silence" is no longer the whole of
; it. Every answer to a cancellation -- a success, a refusal, a failure of the server's own and no
; answer alike -- drops the last reading and reads the status once more
; (CANCEL_REREAD_HANDLER_SITE), outside the tick schedule and past the hour as well as within it.
; The poll itself is unchanged, 360 ticks ten seconds apart, and nothing else reads. The badge is
; withdrawn between the answer and the fresh reading, because the reading it was keyed on is the
; one that was dropped; it is still keyed on presence and never on age. The count below is of places that trigger a status read other than the tick
; schedule. The fresh reading is the read the resource already makes, asked once more: it re-sends
; no failed call, so the webapp-bridge contract's count of automatic re-sends is not moved by it
; (RESEND_CENSUS_DECLARATION).
pub const STATUS_READS_OUTSIDE_THE_POLL : u8 = 1;
pub const STATUS_READS_OUTSIDE_THE_POLL_BEFORE_REPAIR : u8 = 0;
pub const STATUS_IS_REREAD_AFTER_EVERY_CANCEL_ANSWER : bool = true;
pub const CANCEL_REREAD_IGNORES_THE_POLL_HORIZON : bool = true;
pub const LIVE_BADGE_IS_WITHDRAWN_UNTIL_THE_REREAD_LANDS : bool = true;
pub const CANCEL_REREAD_IS_A_RESEND : bool = false;
pub const RESEND_CENSUS_DECLARATION : str = "RETRIED_CALL_COUNT, declared by the webapp-bridge contract";

; --- The two things a customer can DO, and what they are told afterwards ------------------------
; The cancel button appears on a raw comparison against one name and the reorder button on the
; raw terminal predicate. Both therefore disappear entirely for a status spelled in any other
; case, while the label above them stays correct.
; CORRECTED 2026-09-22: that was the record of commit 14b01ac. Since the repair both buttons come
; from the one exact reading -- the cancel button at CANCEL_BUTTON_CONDITION_SITE asks the named
; copy of the order-status precondition, and the reorder buttons at REORDER_SITES ask terminality
; -- so a status spelled in any other case still shows neither, and the label above them now says
; unknown as well, instead of contradicting the missing buttons.
; Whether a cancellation is ALLOWED is the order-status contract's precondition, not this file's.
; Whether the customer is TOLD the answer is this file's, and the answer is that they are not: the
; response is discarded at CANCEL_RESULT_DISCARDED_AT_BEFORE_REPAIR and the dialog closes
; unconditionally at CANCEL_DIALOG_CLOSED_UNCONDITIONALLY_AT_BEFORE_REPAIR, so a refusal and a
; success look identical until a later poll tick happens to disagree -- or, past the hour, never.
; No rule is supplied for that here. The screens have none, and inventing one would be this
; contract legislating for code it only describes.
; CORRECTED 2026-09-22, the cancel repair: the paragraph above is the record of commit 14b01ac, and
; its two sites are kept under _BEFORE_REPAIR names (that commit's lines). The screen has had a rule
; since, and this file records it as the screen's without legislating it:
;   * the answer is READ into four kinds (CANCEL_ANSWER_READER): a success, which the server
;     gives only after its commit; a refusal, which that route and the gates in front of it give
;     before anything is written; a failure of the server's own, a status of the server class,
;     whose outcome is UNKNOWN because the handler answers one when its own commit fails and a
;     proxy in front of it can answer one after the commit landed; and no answer at all, whose
;     outcome is UNKNOWN too. That is three outcomes: done, not done and unknown;
;   * the dialog closes on a success and on nothing else (CANCEL_DIALOG_CLOSE_SITE), which is
;     AGENTS.md lesson 4, and the offer is withdrawn for the rest of the view once the server has
;     confirmed, even while a stale reading still says pending (CANCEL_OFFER_GATE_SITE);
;   * every answer asks the screen to drop its last reading and read the status again
;     (CANCEL_REREAD_REQUEST_SITE, CANCEL_REREAD_HANDLER_SITE). The card only asks: the resource is
;     the screen's, and AGENTS.md lesson 5 forbids a child mutating a parent's state from its task;
;   * after an unknown outcome the next attempt waits for a fresh reading that shows the order
;     still cancellable (CANCEL_RESEND_GATE_SITE). That is the owner's rule for the bot's service
;     receipt and cash desk -- when the outcome is unknown, look again BEFORE repeating
;     (brain:knowledge_base:840-845 and brain:knowledge_base:870-873, a read-only dump read on
;     2026-09-22, translated, not a repository path and checked by no gate) -- followed here
;     because the Mini App has no rule of its own. A refusal was given before anything was
;     written, so repeating one is not blind and is not held. The gate and the line read ONE
;     verdict of what has landed since the answer, derived from the screen's own resource and the
;     pending gate (CANCEL_REREAD_OBSERVED_SITE): a constant there would pass every other check and
;     reopen Confirm the moment an answer went missing;
;   * the answer is told ABOVE the pending gate (CANCEL_LINE_SITE), so a refusal whose re-read
;     removes the whole pending block, dialog included, is still told. Which sentence each answer
;     gets is the client-errors contract's (FAILURE_SENTENCE_DECLARATION).
; One case is told by the card's status label and not by a line: an unknown outcome, followed by a
; fresh reading that shows the order has left pending. What THIS attempt did is then unknown for
; good -- it may have cancelled the order, or the shop may have moved it first -- and the label is
; the one true sentence left. The arm condition at CANCEL_BUTTON_CONDITION_SITE is now necessary
; and not sufficient: the offer also asks whether the server has already confirmed.
; Two limits are recorded rather than hidden. The unknown branch holds Confirm shut until a
; reading LANDS; past the hour the poll no longer supplies one, so a fresh reading that failed
; leaves the attempt held until the screen is opened again. And "no" stays enabled while a request
; is out: it only hides the dialog, the answer still lands, and nothing in the client can end a
; request that never answers.
pub const CANCEL_BUTTON_CONDITION_SITE : str = "src/ui/screens/order_detail_screen.rs:211";
pub const CANCEL_RESULT_DISCARDED_AT_BEFORE_REPAIR : str = "src/ui/screens/order_detail_screen.rs:352";
pub const CANCEL_DIALOG_CLOSED_UNCONDITIONALLY_AT_BEFORE_REPAIR : str = "src/ui/screens/order_detail_screen.rs:358";
pub const CANCEL_ANSWER_READER : str = "order_cancel_answer and order_cancel_line, src/trios/api_errors.rs";
pub const CANCEL_SEND_SITE : str = "src/ui/screens/order_detail_screen.rs:551";
pub const CANCEL_ANSWER_READ_AT : str = "src/ui/screens/order_detail_screen.rs:575";
pub const CANCEL_DIALOG_CLOSE_SITE : str = "src/ui/screens/order_detail_screen.rs:576";
pub const CANCEL_REREAD_REQUEST_SITE : str = "src/ui/screens/order_detail_screen.rs:583";
pub const CANCEL_REREAD_HANDLER_SITE : str = "src/ui/screens/order_detail_screen.rs:513-515";
