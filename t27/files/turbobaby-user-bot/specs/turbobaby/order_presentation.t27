  assert order_presentation_figure_shape(FIGURE_TOTAL, true, true, true) == FIGURE_SHOWN;
  assert order_presentation_figure_shape(FIGURE_LIST_TOTAL, true, true, true) == FIGURE_SHOWN;
  assert order_presentation_figure_shape(FIGURE_BONUS, true, true, true) == MEASURED_ZERO_OMITS_ITS_ROW;
  assert order_presentation_figure_shape(FIGURE_STARS, true, true, true) == MEASURED_ZERO_OMITS_ITS_ROW;
  assert order_presentation_figure_shape(FIGURE_BONUS, true, true, false) == FIGURE_SHOWN;
  assert order_presentation_figure_shape(FIGURE_STARS, true, true, false) == FIGURE_SHOWN;
  assert order_presentation_figure_is_a_discount(FIGURE_TOTAL) == false;
  assert CONDITIONAL_ROW_OMITS_ONLY_A_MEASURED_ZERO == true;
  assert CONDITIONAL_ROW_HID_A_NEGATIVE_LIKE_A_ZERO_BEFORE_REPAIR == true;
  assert CONDITIONAL_ROW_SITES.len == CONDITIONAL_ROW_COUNT;
  assert CONDITIONAL_ROW_SITES_BEFORE_REPAIR.len == CONDITIONAL_ROW_COUNT;
  assert DETAIL_ROW_COMPARISON_COUNT == 0;
  assert DETAIL_ROW_COMPARISON_COUNT_BEFORE_REPAIR == CONDITIONAL_ROW_COUNT;
}

