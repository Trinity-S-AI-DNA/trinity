  assert ALIAS_ARM_FILES_UNDER_SRC_UI_BEFORE_REPAIR == 7;
  assert OUTSIDE_CENSUS_IS_BOUND_BY_ANY_GATE == false;
}

test a_name_this_software_cannot_read_fills_no_segment {
  assert order_presentation_progress_of(ARM_UNRESOLVED, false) == PROGRESS_UNREADABLE;
  assert order_presentation_progress_of(ARM_UNRESOLVED, true) == PROGRESS_UNREADABLE;
  assert order_presentation_progress_of(ARM_READY, false) == PROGRESS_UNREADABLE;
  assert order_presentation_progress_of(ARM_CANCELLED_OR_REJECTED, true) == PROGRESS_STOPPED;
  assert order_presentation_progress_of(ARM_READY, true) == PROGRESS_AT_STEP;
  assert order_presentation_filled(PROGRESS_UNREADABLE, 0, 6) == 0;
  assert order_presentation_filled(PROGRESS_STOPPED, 0, 6) == 0;
  assert order_presentation_filled(PROGRESS_FINISHED, 0, 6) == 6;
  assert order_presentation_filled(PROGRESS_AT_STEP, 3, 6) == 4;
  assert order_presentation_reads_as_finished(PROGRESS_UNREADABLE, 0, 4) == false;
  assert order_presentation_reads_as_finished(PROGRESS_UNREADABLE, 0, 6) == false;
  assert order_presentation_reads_as_finished(PROGRESS_UNREADABLE, 0, 9) == false;
  assert order_presentation_draws_one_flat_bar(PROGRESS_UNREADABLE) == true;
  assert order_presentation_draws_one_flat_bar(PROGRESS_STOPPED) == true;
  assert order_presentation_draws_one_flat_bar(PROGRESS_FINISHED) == false;
  assert order_presentation_draws_one_flat_bar(PROGRESS_AT_STEP) == false;
  assert order_presentation_last_index(6) == 5;
  assert UNRESOLVED_STATUS_FILLS_EVERY_SEGMENT == false;
  assert ABSENCE_RENDERS_AS_COMPLETION == false;
  assert UNREADABLE_STATUS_DRAWS_ONE_FLAT_BAR_IN_ITS_OWN_COLOUR == true;
  assert PIPELINE_LENGTH_IS_DECLARED_HERE == false;
  assert PIPELINE_CONTENT_IS_OWNED_HERE == false;
  assert PIPELINE_CONTENT_IS_PINNED_BY_HOST_TESTS == true;
  assert SEGMENT_FILL_RULE_SITE != SEGMENT_FILL_RULE_SITE_BEFORE_REPAIR;
}

test before_the_repair_a_name_the_pipeline_did_not_carry_rendered_as_a_finished_delivery {
  assert order_presentation_unresolved_index(6) == 6;
  assert order_presentation_segments_filled(6, 6) == 6;
  assert order_presentation_reads_as_finished_before_repair(false, 0, 6) == true;
  assert order_presentation_reads_as_finished_before_repair(false, 0, 4) == true;
  assert order_presentation_reads_as_finished_before_repair(false, 0, 9) == true;
  assert order_presentation_reads_as_finished_before_repair(true, 0, 6) == false;
  assert order_presentation_reads_as_finished_before_repair(true, 4, 6) == false;
  assert order_presentation_reads_as_finished_before_repair(true, 5, 6) == true;
  assert UNRESOLVED_STATUS_FILLS_EVERY_SEGMENT_BEFORE_REPAIR == true;
  assert ABSENCE_RENDERS_AS_COMPLETION_BEFORE_REPAIR == true;
  assert MIXED_CASE_CANCELLED_DREW_A_FULL_GREEN_BAR_BEFORE_REPAIR == true;
  assert UNRESOLVED_INDEX_RULE_SITE_BEFORE_REPAIR != SEGMENT_FILL_RULE_SITE_BEFORE_REPAIR;
}

