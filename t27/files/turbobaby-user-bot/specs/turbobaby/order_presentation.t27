pub const ORDER_FIGURE_DASH_NOTE : str = "Owner question E. Which sentence, if any, a customer reads beside a dashed figure of an order that is already placed: the total, the subtotal or a discount row. What is missing is the owner's ruling and an owner-approved ru and en pair. The only published sentence for an absent price, T_BIKE_PRICE_ON_REQUEST, is D11's for a rate the door did not quote and is worded about a bike model's price, and T_BIKE_QUOTE_NOTE is a note about a quote as well; neither is reused, and nothing is invented. Until the owner rules the dash travels alone, as the line total's always has, and a text guard (tests/order_money_wiring.rs) refuses both keys on both screens so that no default ships by accident.";
; The second is a FIGURE. An order holding a bike line stores sums that leave the rental out: the
; server's own comment says a bike-only cart claims a subtotal of zero (BIKE_LINE_SUM_SITE), and
; which lines the stored sums include is the commerce contract's ledger (REUSES_COMMERCE_ID). So
; the stored total of such an order is not its price. These screens print it anyway -- a zero for a
; bike-only order -- because nothing decides otherwise. No shipped client submits a bike line
; (CHECKOUT_SUBMISSION_SITE builds four shapes of line and none carries a bike), so this is
; reachability and not traffic, and gate 3 binds that zero to the submission map.
pub const BIKE_LINE_ORDER_TOTAL_HAS_A_DISPLAY_RULE : bool = false;
pub const BIKE_LINE_SUM_SITE : str = "src/api/orders.rs:495-503";
pub const NO_SHIPPED_CLIENT_SUBMITS_A_BIKE_LINE : bool = true;
pub const CHECKOUT_SUBMISSION_SITE : str = "src/ui/screens/checkout_screen.rs:975-1006";
pub const CHECKOUT_BIKE_LINE_KEY_COUNT : u8 = 0;
pub const BIKE_LINE_ORDER_TOTAL_NOTE : str = "Owner question F. What an order holding a bike line should show as its subtotal and total. The stored sums leave the rental out by construction, so a bike-only order stores zero for both. Since the money repair its subtotal renders as a dash, because a zero subtotal is a sum of absent line prices, and its total prints the stored zero, because a zero total is otherwise a measurement and nothing here may rule that a bike line makes it one no longer. What is missing is the owner's ruling -- a dash for the whole order, or the catalog part with a qualifier -- and, for the second, owner-approved ru and en copy. A rule that inferred a bike line from the absence of four catalog ids was designed and dropped: it went past the recorded defects, it would have shipped this ruling by default, and it read an empty id differently from the server.";

; --- What the owner is asked, and what ships until they answer ----------------------------------
; Three questions from the status repair belong to the owner. Each is open, and each is a one-line
; change of READING_IMPLEMENTATION once answered. A: does completed stay an alias of delivered on
; these screens -- it does until the owner rules (COMPLETED_KEY_NOTE). B: should a rejected order
; be labelled apart from a cancelled one, as the bot push already does (REJECTED_KEY_NOTE). C: is
; the one answer an unreadable status now gets the right one, and is reading the status exactly,
; as the server does, acceptable, knowing the cost in CROSS_SURFACE_NOTE (OUTSIDE_VOCABULARY_NOTE).
; Added 2026-09-22 with the cancel repair: question D, what a customer reads when the cancellation
; is refused because the order has left pending. It is a question about a SENTENCE, so it is the
; client-errors contract's to hold (FAILURE_SENTENCE_DECLARATION) and is only named here. It is
; listed with the other three.
; ANSWERED 2026-09-25: the owner delegated question D, and a 409 is told a key of its own since
; that day. The client-errors contract holds the decision and the one named limit still open, the
; other closed by rewording that day (CONFLICTED_CANCELLATION_DECISION); A, B and C are untouched.
; Added 2026-09-22 with the money repair: questions E and F, both named refusals above -- which
; sentence, if any, stands beside a dashed order figure (ORDER_FIGURE_DASH_NOTE), and what an order
; holding a bike line shows as its total (BIKE_LINE_ORDER_TOTAL_NOTE). Letting the server send an
; absent figure is NOT an owner question: it is cross-contract work, recorded in WIRE_ZERO_NOTE.
; That work was taken 2026-09-23 (T27 defect 2); E and F stay open and unchanged by it.
pub const OWNER_QUESTION_ALIAS_LABEL_IS_OPEN : bool = true;
pub const OWNER_QUESTION_REJECTED_LABEL_IS_OPEN : bool = true;
pub const OWNER_QUESTION_UNREADABLE_PICTURE_IS_OPEN : bool = true;
pub const OWNER_QUESTION_ORDER_FIGURE_SENTENCE_IS_OPEN : bool = true;
pub const OWNER_QUESTION_BIKE_LINE_TOTAL_IS_OPEN : bool = true;
pub const THE_SERVERS_ABSENT_FIGURE_IS_AN_OWNER_QUESTION : bool = false;
pub const UNREADABLE_PICTURE_IS_THE_OWNERS_DEFAULT : bool = true;
pub const OWNER_QUESTIONS_ARE_LISTED_IN : str = "docs/t27-handover.md";

; --- Who checks the repair ------------------------------------------------------------------------
; The logic lives in READING_IMPLEMENTATION and is unit-tested there on the host. The three UI files
; compile only for wasm32, so what reaches them from cargo test is a text guard, WITNESS: it fails
; if either screen reads the status string itself, if the stepper decides anything, and if a site
; this file cites stops landing on its code. Gate 3 binds the four line counts, the zero status
; literals in the three UI files, LABEL_KEY_NAMES to the label arms, and the order-status
; contract's STATUS_NAMES and TERMINAL_NAMES to the reading's arms.
pub const WITNESS : str = "tests/order_presentation_wiring.rs";
pub const WITNESS_IS_TEXT_ONLY : bool = true;
pub const UNIT_TESTS_LIVE_IN : str = "src/trios/order_status_view.rs";
; The cancel repair has a witness of its own, because its reading lives in a different module.
; CANCEL_WITNESS guards the detail screen as text: the answer is read and never discarded; across
; the card and the sender together the dialog has exactly two closes, the verdict's and the
; customer's own "no", and a write to it of any other shape is refused; every answer asks the
; screen for a fresh reading while the card mutates nothing of the screen's; the answer is told
; above the pending gate; Confirm and the line both read the one verdict derived from the
; screen's own resource and the pending gate; and the attempt's state has two writers only, the
; send marking it in flight and the task recording the answer, so nothing can forget an unknown
; outcome and let Confirm send again blind. WITNESS checks that every cancel site cited above
; lands on its code, CANCEL_REREAD_OBSERVED_SITE included. Gate 3 binds
; CANCEL_POSTS_WITH_A_DISCARDED_ANSWER, DIALOG_CLOSES_THAT_FOLLOW_ANOTHER_STATEMENT and the three
; close counts.
pub const CANCEL_WITNESS : str = "tests/order_cancel_wiring.rs";
pub const CANCEL_UNIT_TESTS_LIVE_IN : str = "src/trios/api_errors.rs";
; The money repair has a witness of its own too, and its rule lives in the shared price module,
; where the host tests it: which figure is absent, which zero is a measurement, and the payload
; shapes the two screens read, the flattened detail block and the list's Option total included.
; MONEY_WITNESS guards both screens as text: no order figure reaches format_baht, neither DTO
; declares a figure as a bare number, the detail decides no row by a comparison of its own, both
; screens hand the rule the line total's own dash, neither names a sentence key beside a figure
; (question E), and the server's copy of the order filter stays the same predicate as the shared
; one (a tripwire, since the server is not changed here). WITNESS checks that every money site
; cited above lands on its code. Gate 3 binds the two format_baht counts, the two bare-figure
; counts, the row comparisons on the detail and the checkout's bike-line keys, each zero with a
; witness (D16).
pub const MONEY_WITNESS : str = "tests/order_money_wiring.rs";
pub const MONEY_UNIT_TESTS_LIVE_IN : str = "src/trios/pricing.rs";
pub const DETAIL_BARE_FIGURE_FIELD_COUNT : u8 = 0;
pub const LIST_BARE_FIGURE_FIELD_COUNT : u8 = 0;
pub const DETAIL_BARE_FIGURE_FIELD_COUNT_BEFORE_REPAIR : u8 = 4;
pub const LIST_BARE_FIGURE_FIELD_COUNT_BEFORE_REPAIR : u8 = 1;
pub const DETAIL_ROW_COMPARISON_COUNT : u8 = 0;
pub const DETAIL_ROW_COMPARISON_COUNT_BEFORE_REPAIR : u8 = 2;

; --- Tests ---------------------------------------------------------------------------------------

test the_owned_surface_is_two_screens_one_component_and_one_reading {
  assert LIST_LINE_COUNT == 411;
  assert DETAIL_LINE_COUNT == 589;
  assert LIST_LINE_COUNT + DETAIL_LINE_COUNT == OWNED_LINE_COUNT;
  assert OWNED_LINE_COUNT == 1000;
  assert LIST_LINE_COUNT_AFTER_THE_STATUS_REPAIR == 410;
  assert LIST_LINE_COUNT_AFTER_THE_STATUS_REPAIR + 1 == LIST_LINE_COUNT;
  assert LIST_LINE_COUNT_AFTER_THE_STATUS_REPAIR + DETAIL_LINE_COUNT == OWNED_LINE_COUNT_AFTER_THE_CANCEL_REPAIR;
  assert OWNED_LINE_COUNT_AFTER_THE_CANCEL_REPAIR == 999;
  assert DETAIL_LINE_COUNT_AFTER_THE_STATUS_REPAIR == 525;
  assert LIST_LINE_COUNT_AFTER_THE_STATUS_REPAIR + DETAIL_LINE_COUNT_AFTER_THE_STATUS_REPAIR == OWNED_LINE_COUNT_AFTER_THE_STATUS_REPAIR;
  assert DETAIL_LINE_COUNT > DETAIL_LINE_COUNT_AFTER_THE_STATUS_REPAIR;
  assert MONEY_REPAIRED_AT == "2026-09-22";
  assert SHARED_COMPONENT_LINE_COUNT == 72;
  assert READING_LINE_COUNT == 657;
  assert LIST_LINE_COUNT_BEFORE_REPAIR == 440;
  assert DETAIL_LINE_COUNT_BEFORE_REPAIR == 556;
  assert LIST_LINE_COUNT_BEFORE_REPAIR + DETAIL_LINE_COUNT_BEFORE_REPAIR == OWNED_LINE_COUNT_BEFORE_REPAIR;
  assert OWNED_LINE_COUNT_BEFORE_REPAIR == 996;
  assert SHARED_COMPONENT_LINE_COUNT_BEFORE_REPAIR == 122;
  assert SHARED_COMPONENT_LINE_COUNT < SHARED_COMPONENT_LINE_COUNT_BEFORE_REPAIR;
  assert SHARED_COMPONENT_IS_OWNED_HERE == false;
  assert SHARED_COMPONENT_DECIDES_NOTHING_ITSELF == true;
  assert READING_IS_OWNED_HERE == true;
  assert READING_IS_HOST_COMPILED == true;
  assert LIST_IMPLEMENTATION != DETAIL_IMPLEMENTATION;
  assert READING_IMPLEMENTATION != SHARED_COMPONENT;
  assert STATUS_READING_REPAIRED_AT == "2026-09-22";
  assert PRE_REPAIR_COMMIT == "14b01ac";
  assert THIRD_CUSTOMER_SURFACE_SHOWS_AN_ORDER_STATUS == true;
  assert THIRD_CUSTOMER_SURFACE_IS_OWNED_HERE == false;
  assert THIRD_CUSTOMER_SURFACE_OWNER != ID;
  assert THIRD_CUSTOMER_SURFACE_SITE != LIST_IMPLEMENTATION;
  assert THIRD_CUSTOMER_SURFACE_SITE != DETAIL_IMPLEMENTATION;
}

