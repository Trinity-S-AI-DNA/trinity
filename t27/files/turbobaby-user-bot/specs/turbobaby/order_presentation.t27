  assert NEIGHBOURS[7] == REUSES_CLIENT_ERRORS_ID;
  assert REUSES_CLIENT_ERRORS_ID == "turbobaby/client-errors";
  assert REUSES_CLIENT_ERRORS_ID != ID;
  assert CLIENT_ERRORS_EDGE_ADDED_AT == "2026-09-22";
