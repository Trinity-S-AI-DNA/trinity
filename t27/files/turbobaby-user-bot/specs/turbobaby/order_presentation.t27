  assert NEIGHBOURS.len == NEIGHBOUR_COUNT;
  assert NEIGHBOUR_COUNT == 9;
  assert NEIGHBOUR_COUNT_BEFORE_THE_MONEY_REPAIR + 1 == NEIGHBOUR_COUNT;
  assert NEIGHBOUR_COUNT_BEFORE_THE_CANCEL_REPAIR + 1 == NEIGHBOUR_COUNT_BEFORE_THE_MONEY_REPAIR;
  assert NEIGHBOURS[8] == REUSES_COMMERCE_ID;
