  assert POLLED_STATUS_OVERRIDES_THE_LOADED_ONE_AT == "src/ui/screens/order_detail_screen.rs:196";
  assert READING_SITE != READING_CALL_IN_THE_STEPPER_SITE;
  assert OWNED_SCREEN_STATUS_LITERAL_COUNT == 0;
