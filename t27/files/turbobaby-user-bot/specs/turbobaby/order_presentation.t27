; --- The four chips, and the mapping nobody had written down -----------------------------------
; src/ui/screens/orders_screen.rs:221 offers four chips. All shows everything. The other three
; partition the rest, but by two unrelated rules written in two places: Active is the NEGATION of
; the terminal predicate (src/ui/screens/orders_screen.rs:174 at 14b01ac), while Completed and
; Cancelled are literal disjunctions (:175, :176 at 14b01ac). The partition holds today. It holds by coincidence of two
; independent edits, not by construction, and nothing in the tree checks it -- which is why it is
; written down here.
; CORRECTED 2026-09-22: apart from the first sentence, re-pointed to where the chips are offered
; today (LIST_CHIPS_SITE), the paragraph above is the record of commit 14b01ac. The partition has
; held BY CONSTRUCTION since the repair, and not by coincidence: every
; chip is decided by one function of the arm (CHIP_RULE_SITE), the list's filter asks it
; (CHIP_SITE), and a host test in READING_IMPLEMENTATION checks that every arm lands under exactly
; one of the three partitioning chips.
pub const CHIP_ALL : u8 = 1;
pub const CHIP_ACTIVE : u8 = 2;
pub const CHIP_COMPLETED : u8 = 3;
pub const CHIP_CANCELLED : u8 = 4;
pub const CHIP_COUNT : u8 = 4;
pub const PARTITIONING_CHIP_COUNT : u8 = 3;
pub const LIST_CHIPS_SITE : str = "src/ui/screens/orders_screen.rs:221";
pub const CHIP_SITE : str = "src/ui/screens/orders_screen.rs:144-152";
pub const CHIP_RULE_SITE : str = "src/trios/order_status_view.rs:196";
pub const CHIP_SITE_BEFORE_REPAIR : str = "src/ui/screens/orders_screen.rs:171-178";
pub const CHIP_RULES_ARE_WRITTEN_TWICE_AND_INDEPENDENTLY : bool = false;
pub const CHIP_RULES_ARE_WRITTEN_TWICE_AND_INDEPENDENTLY_BEFORE_REPAIR : bool = true;
pub const CHIP_PARTITION_IS_BY_CONSTRUCTION : bool = true;

; spelled_as_the_vocabulary is the fact the nine raw comparison sites depend on and the six
; lower-casing sites do not: it is true when the status string arriving from the server is
; character-for-character the lower-case name the raw comparisons expect. It is a separate
; argument rather than a string operation because this file holds no status strings at all.
pub fn order_presentation_chip_of(arm: u8, spelled_as_the_vocabulary: bool) u8 {
  if (!spelled_as_the_vocabulary) {
    return CHIP_ACTIVE;
  }
  if (arm == ARM_CANCELLED_OR_REJECTED) {
    return CHIP_CANCELLED;
  }
  if (arm == ARM_DELIVERED_OR_COMPLETED) {
    return CHIP_COMPLETED;
  }
  return CHIP_ACTIVE;
}

pub fn order_presentation_is_shown_under(chip: u8, arm: u8, spelled_as_the_vocabulary: bool) bool {
  if (chip == CHIP_ALL) {
    return true;
  }
  return chip == order_presentation_chip_of(arm, spelled_as_the_vocabulary);
}

; An unresolved status is not filtered out and it is not given a chip of its own: it lands in
; Active, because Active is defined as everything the terminal predicate refuses. A customer who
; taps Active is therefore shown every order this software failed to understand, alongside the
; ones genuinely in flight, with no mark distinguishing the two.
; CORRECTED 2026-09-22: the first half stands and is deliberate -- an order this software cannot
; read is never filtered out of sight. The second half is no longer true: such an order now wears
; the unknown label, the grey of no information and one flat grey bar, so it is marked.
pub const UNRESOLVED_STATUS_IS_FILTERED_AS_ACTIVE : bool = true;
pub const UNRESOLVED_STATUS_IS_MARKED_IN_THE_ACTIVE_LIST : bool = true;
pub const UNRESOLVED_STATUS_IS_MARKED_IN_THE_ACTIVE_LIST_BEFORE_REPAIR : bool = false;

; --- One string, fifteen readers, two readings of case -----------------------------------------
; Six sites lower-case the status before deciding and nine compare it raw. Every site in the first
; group decides what the customer READS; every site in the second decides what the customer can
; FIND, DO, or SEE PROGRESS ON. So a status spelled in any other case keeps its correct label and
; loses its chip, its cancel button, its reorder button and its place in the pipeline at once.
; No source in this tree normalises the status before it reaches these screens: the detail screen
; assigns the polled value straight over the loaded one at
; src/ui/screens/order_detail_screen.rs:196 with no vocabulary check of any kind.
; CORRECTED 2026-09-22: the first four sentences are the record of commit 14b01ac, and the fifteen
; sites are kept below under _BEFORE_REPAIR names. Since the repair ONE function reads the string,
; arm_of (READING_SITE), and every decision on the three files asks it -- the stepper included,
; which finds its step by the arm of each pipeline entry rather than by comparing the string a
; second time. The reading is EXACT, because the server's is (EXACT_READING_REASON), so a status
; spelled in any other case is now read as unresolved by every answer at once: the label, the
; chip, both buttons and the bar move together. The last sentence above still holds: nothing
; normalises the string, deliberately, because folding case would draw a cancel button the server
; refuses.
