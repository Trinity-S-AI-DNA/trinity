  assert HELPER_BLOCK_COPY_COUNT_BEFORE_REPAIR == 3;
  assert HELPER_BLOCK_COPIES_WERE_BYTE_IDENTICAL_BEFORE_REPAIR == true;
  assert TERMINAL_PREDICATE_SITES_BEFORE_REPAIR.len == TERMINAL_PREDICATE_COPY_COUNT_BEFORE_REPAIR;
  assert HELPER_BLOCK_COPY_COUNT_BEFORE_REPAIR > TERMINAL_PREDICATE_COPY_COUNT_BEFORE_REPAIR;
  assert TERMINALITY_COPY_OWNER == REUSES_ORDER_STATUS_ID;
  assert TERMINALITY_COPY_IS_BOUND_TO_ITS_OWNER == true;
  assert CANCEL_PRECONDITION_COPY_IS_TESTED_AGAINST_ITS_OWNER == true;
  assert TERMINALITY_COPY_SITE != CANCEL_PRECONDITION_COPY_SITE;
}

