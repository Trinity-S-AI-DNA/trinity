; An arm as the one exact reading gives it. A string that is not spelled as the vocabulary spells
; it is read as unresolved, whatever arm its letters would have matched after folding.
pub fn order_presentation_arm_as_read(arm_if_spelled_exactly: u8, spelled_as_the_vocabulary: bool) u8 {
  if (!spelled_as_the_vocabulary) {
    return ARM_UNRESOLVED;
  }
  return arm_if_spelled_exactly;
}

