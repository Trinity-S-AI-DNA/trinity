pub const CANCEL_OFFER_GATE_SITE : str = "src/ui/screens/order_detail_screen.rs:319";
pub const CANCEL_RESEND_GATE_SITE : str = "src/ui/screens/order_detail_screen.rs:326";
pub const CANCEL_REREAD_OBSERVED_SITE : str = "src/ui/screens/order_detail_screen.rs:215-216";
