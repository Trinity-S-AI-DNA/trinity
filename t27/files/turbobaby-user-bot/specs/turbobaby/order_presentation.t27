test absence_had_four_shapes_before_the_repair_and_only_one_was_honest {
  assert order_presentation_figure_shape_before_repair(true, false, true, false) == ABSENCE_RENDERS_AS_DASH;
  assert order_presentation_figure_shape_before_repair(false, false, true, false) == ABSENCE_RENDERS_AS_DASH;
  assert order_presentation_figure_shape_before_repair(true, false, false, false) == ABSENCE_RENDERS_AS_ZERO;
  assert order_presentation_figure_shape_before_repair(true, false, false, true) == ABSENCE_RENDERS_AS_OMITTED_ROW;
  assert order_presentation_figure_shape_before_repair(false, false, false, false) == ABSENCE_RENDERS_AS_A_LOST_SCREEN;
  assert order_presentation_figure_shape_before_repair(true, true, false, false) == FIGURE_SHOWN;
  assert order_presentation_figure_shape_before_repair(true, true, true, false) == FIGURE_SHOWN;
  assert order_presentation_absence_is_honest(ABSENCE_RENDERS_AS_DASH) == true;
  assert order_presentation_absence_is_honest(ABSENCE_RENDERS_AS_ZERO) == false;
  assert order_presentation_absence_is_honest(ABSENCE_RENDERS_AS_OMITTED_ROW) == false;
  assert order_presentation_absence_is_honest(ABSENCE_RENDERS_AS_A_LOST_SCREEN) == false;
  assert ABSENCE_SHAPE_COUNT_BEFORE_REPAIR == 4;
}

test absence_has_one_shape_on_every_figure {
  assert ABSENCE_SHAPE_COUNT == 1;
  assert FIGURE_COUNT == 6;
  assert order_presentation_figure_shape(FIGURE_LINE_TOTAL, false, false, false) == ABSENCE_RENDERS_AS_DASH;
  assert order_presentation_figure_shape(FIGURE_LIST_TOTAL, false, false, false) == ABSENCE_RENDERS_AS_DASH;
  assert order_presentation_figure_shape(FIGURE_SUBTOTAL, false, false, false) == ABSENCE_RENDERS_AS_DASH;
  assert order_presentation_figure_shape(FIGURE_BONUS, false, false, false) == ABSENCE_RENDERS_AS_DASH;
  assert order_presentation_figure_shape(FIGURE_TOTAL, false, false, false) == ABSENCE_RENDERS_AS_DASH;
  assert order_presentation_figure_shape(FIGURE_STARS, false, false, false) == ABSENCE_RENDERS_AS_DASH;
  assert order_presentation_figure_shape(FIGURE_LIST_TOTAL, true, false, false) == ABSENCE_RENDERS_AS_DASH;
  assert order_presentation_figure_shape(FIGURE_SUBTOTAL, true, false, false) == ABSENCE_RENDERS_AS_DASH;
  assert order_presentation_figure_shape(FIGURE_BONUS, true, false, false) == ABSENCE_RENDERS_AS_DASH;
  assert order_presentation_figure_shape(FIGURE_TOTAL, true, false, false) == ABSENCE_RENDERS_AS_DASH;
  assert order_presentation_figure_shape(FIGURE_STARS, true, false, false) == ABSENCE_RENDERS_AS_DASH;
  assert order_presentation_absence_is_honest(order_presentation_figure_shape(FIGURE_TOTAL, false, false, false)) == true;
  assert order_presentation_shape_is_an_absence(MEASURED_ZERO_OMITS_ITS_ROW) == false;
  assert order_presentation_shape_is_an_absence(FIGURE_SHOWN) == false;
  assert order_presentation_shape_is_an_absence(ABSENCE_RENDERS_AS_OMITTED_ROW) == true;
}

test an_honest_zero_keeps_its_figure_and_a_zero_discount_omits_its_row {
  assert TOTAL_ZERO_IS_A_MEASUREMENT == true;
  assert DISCOUNT_ZERO_OMITS_ITS_ROW == true;
