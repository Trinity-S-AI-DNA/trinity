pub fn order_presentation_cancel_button_shown(arm: u8, spelled_as_the_vocabulary: bool) bool {
  if (!spelled_as_the_vocabulary) {
    return false;
  }
  return arm == ARM_PENDING;
}

pub fn order_presentation_reorder_button_shown(arm: u8, spelled_as_the_vocabulary: bool) bool {
  if (!spelled_as_the_vocabulary) {
    return false;
  }
  return order_presentation_arm_is_shared(arm);
}

; The cancel answers, as u8 discriminants of this file's own. No HTTP numeral is declared: the
; refusal's numeral is order-status's (CONFLICT_REFUSAL_DECLARATION), the server class is read by
; CANCEL_ANSWER_READER and consumed here as a boolean, and the four answers are classes of what
; arrived, not statuses. UNSET stands for "nothing answered yet" -- nothing sent, or a request
; still out. CANCEL_ANSWER_KIND_COUNT counts the four real answers and nothing else; the predicate
; below names its inclusive bounds rather than lean on the count. The four reach three outcomes,
; and two of them -- a failure of the server's own and no answer at all -- are the unknown one.
pub const CANCEL_ANSWER_UNSET : u8 = 0;
pub const CANCEL_ANSWER_CANCELLED : u8 = 1;
pub const CANCEL_ANSWER_REFUSED : u8 = 2;
pub const CANCEL_ANSWER_NO_ANSWER : u8 = 3;
pub const CANCEL_ANSWER_SERVER_FAILED : u8 = 4;
pub const CANCEL_ANSWER_KIND_COUNT : u8 = 4;
pub const CANCEL_OUTCOME_KIND_COUNT : u8 = 3;
; What has been read of the status since the answer arrived. Only an unknown outcome asks.
pub const REREAD_NOT_YET : u8 = 1;
pub const REREAD_UNREADABLE : u8 = 2;
pub const REREAD_STILL_CANCELLABLE : u8 = 3;
pub const REREAD_LEFT_PENDING : u8 = 4;

pub fn order_presentation_cancel_answer(answered: bool, success: bool, server_failed: bool) u8 {
  if (!answered) {
    return CANCEL_ANSWER_NO_ANSWER;
  }
  if (success) {
    return CANCEL_ANSWER_CANCELLED;
  }
  if (server_failed) {
    return CANCEL_ANSWER_SERVER_FAILED;
  }
  return CANCEL_ANSWER_REFUSED;
}

pub fn order_presentation_cancel_answer_is_known(answer: u8) bool {
  return answer >= CANCEL_ANSWER_CANCELLED and answer <= CANCEL_ANSWER_SERVER_FAILED;
}

pub fn order_presentation_cancel_outcome_is_unknown(answer: u8) bool {
  return answer == CANCEL_ANSWER_NO_ANSWER or answer == CANCEL_ANSWER_SERVER_FAILED;
}

pub fn order_presentation_cancel_dialog_closes(answer: u8) bool {
  return answer == CANCEL_ANSWER_CANCELLED;
}

pub fn order_presentation_cancel_told_as_success(answer: u8) bool {
  return answer == CANCEL_ANSWER_CANCELLED;
}

pub fn order_presentation_cancel_rereads_status(answer: u8) bool {
  return order_presentation_cancel_answer_is_known(answer);
}

pub fn order_presentation_cancel_offer_withdrawn(answer: u8) bool {
  return answer == CANCEL_ANSWER_CANCELLED;
}

pub fn order_presentation_cancel_offered(arm: u8, spelled_as_the_vocabulary: bool, answer: u8) bool {
  if (order_presentation_cancel_offer_withdrawn(answer)) {
    return false;
  }
  return order_presentation_cancel_button_shown(arm, spelled_as_the_vocabulary);
}

pub fn order_presentation_cancel_may_send(request_out: bool, answer: u8, reread: u8) bool {
  if (request_out) {
    return false;
  }
  if (order_presentation_cancel_outcome_is_unknown(answer)) {
    return reread == REREAD_STILL_CANCELLABLE;
  }
  return true;
}

pub fn order_presentation_cancel_is_told_by_a_line(answer: u8, reread: u8) bool {
  if (!order_presentation_cancel_answer_is_known(answer)) {
    return false;
  }
  if (order_presentation_cancel_outcome_is_unknown(answer) and reread == REREAD_LEFT_PENDING) {
    return false;
  }
  return true;
}

; --- Named refusals -----------------------------------------------------------------------------
; Each of these is a place where the tree publishes nothing and this file declines to invent it.
; A refusal is a named boolean plus a note saying exactly what is missing, so that a later reader
; can tell "nobody decided this" from "somebody decided it elsewhere".
; CORRECTED 2026-09-22, the cancel repair: the screen has a rule for a refused cancellation since
; that day, so the first refusal below flipped, and the live view's note changed with it. Both
; superseded readings are kept verbatim under _BEFORE_REPAIR names, as committed (their sites are
; commit 14b01ac's). What is still unpublished about a cancellation is a SENTENCE, and a sentence
; is the client-errors contract's refusal to hold (FAILURE_SENTENCE_DECLARATION), not this file's.
pub const SCREEN_HAS_NO_RULE_FOR_A_REFUSED_CANCELLATION : bool = false;
pub const SCREEN_HAS_NO_RULE_FOR_A_REFUSED_CANCELLATION_BEFORE_REPAIR : bool = true;
; CORRECTED 2026-09-25: the note's last two sentences named an unpublished sentence and the interim
; shipped in its place. Owner question D was answered by delegation that day, so they now say
; where the answer is recorded. Nothing the screen does changed with it.
pub const REFUSED_CANCELLATION_NOTE : str = "Since 2026-09-22 the screen reads the answer to a customer's cancellation through order_cancel_answer in src/trios/api_errors.rs, closes the dialog only on a confirmed success, withdraws the offer once the server has confirmed, reads the status again after every answer, holds an attempt whose outcome is unknown -- no answer, or a failure of the server's own -- until a fresh reading shows the order still cancellable, and tells every answer above the pending gate. The sentence for the refusal the order-status contract declares once the order has left pending belongs to the client-errors contract. It was an interim from 2026-09-22 to 2026-09-25, when owner question D was answered by delegation, and what was decided and what it leaves open are recorded there (CONFLICTED_CANCELLATION_DECISION).";
pub const REFUSED_CANCELLATION_NOTE_BEFORE_REPAIR : str = "The POST result is bound to a discarded local at src/ui/screens/order_detail_screen.rs:352 and the confirmation dialog is closed at :358 on both paths. No branch reads a status code, no state records a failure, and no i18n key exists for one. What the customer is told after a refused cancellation is therefore nothing, and this file declares the absence rather than a message.";
pub const SCREEN_HAS_NO_RULE_FOR_AN_EXPIRED_LIVE_VIEW : bool = true;
pub const EXPIRED_LIVE_VIEW_NOTE : str = "The tick loop at src/ui/screens/order_detail_screen.rs:439-446 ends after 360 iterations. Since 2026-09-22 one thing still reads the status after it: an answer to a cancellation, which drops the last reading and asks once more (CANCEL_REREAD_HANDLER_SITE), past the hour as within it. Nothing else runs. The badge at :247 depends on the presence of the last response and not on its age, and the payload at src/api/orders.rs:1908-1921 carries no timestamp that a freshness rule could consult, so there is still no shipped freshness rule to describe.";
pub const EXPIRED_LIVE_VIEW_NOTE_BEFORE_REPAIR : str = "The tick loop at src/ui/screens/order_detail_screen.rs:463-470 ends after 360 iterations and nothing runs afterwards. The badge at :270 remains rendered because it depends on the presence of the last response and not on its age, and the payload at src/api/orders.rs:1782-1795 carries no timestamp that a freshness rule could consult. There is no shipped rule here to describe.";
; CORRECTED 2026-09-22: the screens have had one rule for a status outside the vocabulary since
; the repair, so the refusal below flipped. It is the owner's DEFAULT, not this file's ruling: the
; unknown label key, the grey of no information, one flat grey bar with nothing filled, no step
