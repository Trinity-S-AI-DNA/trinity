// SPDX-License-Identifier: Apache-2.0
; specs/turbobaby/observability.t27 -- the correlation identifier, and what a metric may say
; This contract owns two boundaries no other file in specs/turbobaby touches: the header a
; request is correlated by, and the rule that a metric name exists only where the binary emits
; it. It owns the acceptance test for an inbound correlation id, the mint-when-missing rule, the
; echo-on-response rule, the span name and its field names, the naming rule for a counter or a
; gauge, and the three-part resolution test a dashboard or alert reference has to pass. It owns
; one more boundary because nothing else does: what the admin health digest CLAIMS and what it
; cannot know.
; --
; OWNERSHIP EDGES, spelled as IDs because this language has no import. request_identity.t27 owns
; WHO a request is. This file owns only WHICH request it was, and the two are not the same thing:
; an inbound id is up to 128 bytes of client-supplied text that passes no proof of any kind, and
; the state "correlated and unidentified" is reachable on every request in the tree. catalog_api.t27
; owns HTTP outcomes, so not one status code appears below -- this file says whether a header is
; present and never what the response was. publication.t27 owns the discipline the health section
; borrows: a thing is claimed only where it was observed, and an empty report is evidence about
; the record, not about the system. One number below is a neighbour's and is marked as such:
; turbobaby/request-identity counts the six check_owner_lenient call sites as
; GATE_CALL_SITES_OWNER_LENIENT, and the six sites that hand that gate a label it drops are the
; same six, taken from there. Every citation into a sibling below names the owner ID and the
; DECLARATION, never a line number: a line in another .t27 goes stale the moment that file is
; edited, and the 12 line citations this file carried were converted on 2026-09-21 for that
; reason. Citations into src/, docs/ and migrations/ are line-accurate and stay as lines.
; --
; WHY (measured 2026-09-21). Epic #31 asks that request ids correlate API failures, alerts and
; logs, and that dashboards name metrics the binary actually emits. Both halves are unowned in
; this corpus and one half is already broken in the tree.
; The correlation half is implemented and unspecified. src/api/observability.rs is 190 lines and
; carries its entire specification in the eleven unit tests at its bottom (:96-189) and nowhere
; else. The one integration guard, tests/observability_ownership.rs, checks where the module is
; DECLARED and never what it DOES: not the header name, not the 128-byte cap, not one rejected
; character, not the echo.
; The metric half is worse. This repository ships TWO Grafana dashboards --
; monitoring/grafana-dashboard.json and docs/grafana-dashboard.json -- and the name guard at
; src/main.rs:3798 reads the first path only (src/main.rs:3801). Measured against the 29 metric
; names the binary emits: the guarded dashboard names 0 that do not exist; the unguarded pair,
; docs/grafana-dashboard.json and docs/prometheus-alerts.yaml, which no Rust test in this
; repository reads at all, names 5, across 9 PromQL expressions and 3 of the 10 alert rules. All
; five are the db_pool family, orphaned when cycle #108 deleted the helper that emitted the first
; of them (src/metrics.rs:320-328) and never emitted the other four at all
; (grep -rnE "db_pool_(waiting|size|available|max_size)" --include=*.rs . returns 0). The
; docstring of the guard says the failure mode out loud -- a renamed metric makes a panel show
; "No data" and nobody notices until an incident (src/main.rs:3649-3657) -- and then reads the
; other file. That is the whole reason this contract exists: the forward direction
; (declared -> wired) has a test and holds; the reverse direction (referenced -> emitted) has a
; test that covers one of the FOUR published artifacts. Re-measured 2026-09-21 over docs/ and
; monitoring/ for a PromQL carrier -- a JSON "expr" key or a YAML expr: line -- the answer is 4,
; not the 3 this file first wrote: monitoring/grafana-dashboard.json, docs/grafana-dashboard.json,
; docs/prometheus-alerts.yaml and docs/prometheus-recording-rules.yaml. The fourth was missed on
; the first pass. It carries 12 recording-rule expressions, no Rust test reads it, and it names no
; dead metric -- every series it touches is an axum_ built-in or another wwb: rule -- so the
; dead-name count below does not move and only the coverage fraction does.
; (Corrected 2026-09-22: the binary emits 41 names, not 29 -- the note above
; EMITTED_METRIC_NAME_COUNT says where the 29 came from. Against 41 the guarded dashboard still
; names 0 that do not exist, and the dead names are still the same five: none of the 41 is a
; db_pool_ name.)
; --
; WHERE THE BRIEF IS REFUTED, three times, all measured 2026-09-21.
; FIRST, and it is the brief's headline number. The brief calls
; grep -ril "request_id\|metric" specs/ "the measured zero". It is not zero, and it does not hold
; still, which is the whole lesson: measured 2026-09-21 over the 30 files the corpus then held and
; excluding this one, it was 14 files and 42 matches case-sensitive, 89 with -i. RE-MEASURED
; 2026-09-21 over the 43 the corpus holds now -- 42 under specs/turbobaby plus
; specs/agents/turbobaby.t27 -- the same greps return 25 files and 51 matches case-sensitive, 150
; with -i. Both readings are kept because the pair is the evidence, and the second was taken while
; the siblings were being edited in the same pass, which is the condition and not a caveat: a grep
; over a corpus still being written is a snapshot with a date, never a property. The direction of
; the drift is itself informative -- the case-sensitive count FELL from 58 earlier the same day,
; because a sibling converting a citation from request_identity.t27 to turbobaby/request-identity
; removes a match and adds none.
; What the 51 are: 12 name request_identity.t27 in prose, 4 are
; the word "symmetric" in a sibling sentence about a predicate (deposit_tiers.t27,
; pricing_honesty.t27, and schema_provenance.t27 twice -- named by file, because a grep census is
; about files and a line in a sibling goes stale), 1 is the ignored Rust parameter that
; request_identity.t27 refuses the brief over, and the rest are the word metric deferring here.
; Exactly one match is a real metric name: turbobaby/rate-limit declares BLOCKED_METRIC_NAME for
; the counter that contract owns, and -i is what catches it, because this corpus spells its
; constants in capitals. So "not one is on subject" is refused as well: one is, and it is a
; neighbour's declaration rather than a gap. That single figure is the one number here that
; re-measurement did NOT move.
; The honest absence greps, pinned as constants below, are
; grep -ril "x-request-id" specs/ -> 0 files other than this one, re-verified 2026-09-21 and
; still 0 across all 43, and
; grep -rilE "prometheus|grafana|dashboard|observability|gauge|correlation|scrape" specs/ -> 7
; files other than this one: not the 3 pinned here before, and not the 0 claimed before that.
; Four of the seven -- api_surface.t27, client_errors.t27, rate_limit.t27 and
; request_identity.t27 -- match only in sentences that name THIS contract or report what it owns:
; the word observability itself in all four, plus correlation in api_surface.t27 and dashboards in
; rate_limit.t27, each reporting this file's subject rather than declaring one of its own.
; They are inbound edges and not occupants.
; The other three match on their own subject: schema_provenance.t27 owns the VALUE of the
; schema_missing_columns gauge, runtime_config.t27 names that same gauge as what a missing column
; raises, and notification_queue.t27 counts the four monitoring artifacts and says a queue-depth
; gauge is the missing input without coining a name for it. All three defer the naming RULE to
; here, which is why the count moved and the ownership did not.
; SECOND. The brief calls tests/observability_ownership.rs "the only existing guard". There is a
; second one: src/main.rs:3659-3914, the module grafana_dashboard_tests (its name test occupies
; :3798-3851 of that span), which parses a dashboard
; and asserts every PromQL name is declared in src/metrics.rs, is an axum_ built-in, or is a wwb:
; recording rule. It is a real guard and it is green -- because of the path it reads, not because
; the tree is clean. Calling it absent would have made this contract claim a gap that is half
; closed; calling it sufficient would miss that it covers 1 of the 4 files that carry PromQL.
; THIRD, and it moves the refusal. The brief asks for "no log line format that the code does not
; fix". The code fixes two, by environment: src/main.rs:394-405 installs a JSON subscriber in
; production and the human formatter otherwise. So the refusal below is not "the format is
; unfixed" but "there are two renderings and this file names neither". What IS fixed, and what
; this file therefore owns, is the span name and the three field names at
; src/api/observability.rs:70-75, which survive both renderings.
; --
; WHAT THIS FILE NEVER DOES. It publishes no dashboard JSON and no panel. It invents no alert
; threshold: every number in docs/prometheus-alerts.yaml is an operator's chosen burn rate, queue
; depth or ratio with no measurement in this repository behind it, and not one of them is copied
; below. It fixes no log line format, for the reason above. It transcribes no counter: the 29
; emitted names are a COUNT here, the naming RULE is the subject, and the only names written out
; are the five that are referenced and never emitted -- which is the measurement, not the table.
; (41 emitted names since the correction of 2026-09-22; still a count, still not transcribed.)
; It declares no HTTP status code, no gate, no identity rule. The digest strings in
; src/trios/health.rs are shipped Russian sentences: they are cited by path and line and never
; quoted, here or in a test. It carries nothing from D14 -- no renter, handle, phone, key code,
; plate, debt, purchase cost or personal note, in a constant, a fixture or a comment.
; phi^2 + 1/phi^2 = 3 | TRINITY

module turbobaby-observability;

pub const KIND : str = "observability-contract";
pub const ID : str = "turbobaby/observability";
pub const NAME : str = "TurboBaby request correlation and metric-name honesty";
pub const WORLD : str = "gHashTag/turbobaby-user-bot";
pub const CORRELATION_IMPLEMENTATION : str = "src/api/observability.rs";
pub const METRIC_IMPLEMENTATION : str = "src/metrics.rs";
pub const HEALTH_DIGEST_IMPLEMENTATION : str = "src/trios/health.rs";
pub const OWNERSHIP_WITNESS : str = "tests/observability_ownership.rs";
pub const DASHBOARD_NAME_GUARD : str = "src/main.rs";

; --- Ownership edges ----------------------------------------------------------------------------
; Three abstract parameters, three owners, nothing restated. The first edge is the one a reader is
; most likely to collapse, so it carries its own named refusal rather than only an ID string.
pub const REUSES_REQUEST_IDENTITY_ID : str = "turbobaby/request-identity";
pub const A_REQUEST_ID_IS_NOT_AN_IDENTITY : bool = true;
pub const REQUEST_ID_IS_CLIENT_SUPPLIED : bool = true;
pub const REQUEST_ID_IS_PROVED_BY_NOTHING : bool = true;
pub const REUSES_CATALOG_API_ID : str = "turbobaby/catalog-api";
pub const THIS_FILE_DECLARES_NO_HTTP_STATUS : bool = true;
pub const REUSES_PUBLICATION_ID : str = "turbobaby/publication";
pub const OBSERVED_IS_NOT_THE_SAME_AS_TRUE : bool = true;
; The fourth edge is narrower than the other three and was added after a grep rather than from the
; brief. rate_limit.t27 owns the throttle limiter, including which kinds its call sites pass and
; how many do. This file judges a label REFERENCE against that set and never republishes the set.
pub const REUSES_RATE_LIMIT_ID : str = "turbobaby/rate-limit";
pub const LIMITER_CALL_SITE_CENSUS_IS_OWNED_THERE : bool = true;

; --- The correlation header ----------------------------------------------------------------------
; src/api/observability.rs:32. HeaderName::from_static requires the lowercase spelling; the wire
; name is case-insensitive, so the lowercase literal is the one fact and not a second name.
pub const REQUEST_ID_HEADER : str = "x-request-id";
; :35. The cap is measured in BYTES of the TRIMMED value (:42 reads trimmed.len()), not in
; characters. That distinction is invisible today because every multi-byte value is refused by the
; charset test anyway; it becomes visible the day the charset is widened, which is why it is named.
pub const REQUEST_ID_MAX_BYTES : u16 = 128;
pub const REQUEST_ID_CAP_IS_BYTES_NOT_CHARS : bool = true;
; :57 mints uuid::Uuid::new_v4().to_string(); the test at :154-155 pins its length at 36.
pub const MINTED_REQUEST_ID_LEN : u16 = 36;
; :45 is trimmed.bytes().all(|b| b.is_ascii_graphic()). is_ascii_graphic is U+0021..=U+007E, so
; space is out and every control byte and every non-ASCII byte is out. The tests enumerate the
; refusals: newline (:132), tab (:133), an inner space (:134), a Latin letter with a diacritic
; (:139) and an emoji (:140).
pub const REQUEST_ID_BYTE_MIN : u16 = 33;
pub const REQUEST_ID_BYTE_MAX : u16 = 126;
; :41 trims before judging, which is why an all-whitespace value becomes empty (:120) while a
; value with an interior space stays non-empty and is refused by the charset test instead (:134).
pub const WHITESPACE_IS_TRIMMED_BEFORE_JUDGEMENT : bool = true;

pub fn request_id_byte_is_accepted(byte: u16) bool {
  return byte >= REQUEST_ID_BYTE_MIN and byte <= REQUEST_ID_BYTE_MAX;
}

; Refusal discriminants. They are a REFINEMENT of the code, declared as one: :43 and :46 both
; return None, so which reason applied is not observable by any caller and never reaches the wire.
; The order below is the order the code tests in (:42 before :45) and nothing depends on it.
pub const REFUSE_NONE : u8 = 0;
pub const REFUSE_EMPTY : u8 = 1;
pub const REFUSE_OVERSIZED : u8 = 2;
pub const REFUSE_NONGRAPHIC : u8 = 3;
pub const REFUSAL_REASON_COUNT : u8 = 4;
pub const REFUSAL_REASON_IS_VISIBLE_ON_THE_WIRE : bool = false;

pub fn inbound_request_id_refusal(trimmed_byte_len: u16, every_byte_graphic: bool) u8 {
  if (trimmed_byte_len == 0) {
    return REFUSE_EMPTY;
  }
  if (trimmed_byte_len > REQUEST_ID_MAX_BYTES) {
    return REFUSE_OVERSIZED;
  }
  if (!every_byte_graphic) {
    return REFUSE_NONGRAPHIC;
  }
  return REFUSE_NONE;
}

pub fn inbound_request_id_accepted(trimmed_byte_len: u16, every_byte_graphic: bool) bool {
  return inbound_request_id_refusal(trimmed_byte_len, every_byte_graphic) == REFUSE_NONE;
}

; --- Mint, inherit, echo ---------------------------------------------------------------------
; :53-57. A missing header and a refused header take the same branch, so a hostile value buys an
; attacker nothing but a fresh UUID. Exactly one of the two functions below is true for every
; request; that is the whole "no request is uncorrelated" guarantee, and it is stated as a pair
; rather than as a constant so it can be checked at all four input combinations.
pub fn request_id_is_inherited(header_present: bool, inbound_accepted: bool) bool {
  return header_present and inbound_accepted;
}

pub fn request_id_is_minted(header_present: bool, inbound_accepted: bool) bool {
  return !header_present or !inbound_accepted;
}

; The guarantee itself, given a name so it can be checked at each of the four combinations rather
; than asserted as one long chain whose reading depends on operator precedence.
pub fn request_id_always_exists(header_present: bool, inbound_accepted: bool) bool {
  return request_id_is_inherited(header_present, inbound_accepted) or request_id_is_minted(header_present, inbound_accepted);
}

; :79-81. The insert is conditional on HeaderValue::from_str succeeding. Measured: it has no
; reachable false branch, because every byte an accepted id may carry is in 0x21..0x7E and a
; minted UUID is hex and hyphens. The argument is kept anyway -- this contract records that the
; code guards the conversion, and does not assume the guard away.
pub fn response_echoes_request_id(id_is_a_legal_header_value: bool) bool {
  return id_is_a_legal_header_value;
}

pub const ECHO_HAS_NO_REACHABLE_FAILURE_TODAY : bool = true;

pub fn correlation_is_available(header_present: bool, inbound_accepted: bool, id_is_a_legal_header_value: bool) bool {
  if (!response_echoes_request_id(id_is_a_legal_header_value)) {
    return false;
  }
  return request_id_is_inherited(header_present, inbound_accepted) or request_id_is_minted(header_present, inbound_accepted);
}

; The edge to request_identity.t27, written as a reachable state rather than as a sentence. A
; correlated request whose sender is unproved is the ordinary case, not an error.
pub fn correlated_but_unidentified(correlated: bool, identity_proved: bool) bool {
  return correlated and !identity_proved;
}

; --- The span ------------------------------------------------------------------------------------
; :70-75. This is the part of the log line the code really does fix, and it survives both
; renderings selected at src/main.rs:394-405. The rendering itself is named by neither.
pub const REQUEST_ID_SPAN_NAME : str = "http_request";
pub const SPAN_FIELD_NAMES : [3]str = ["request_id", "method", "path"];
pub const SPAN_FIELD_COUNT : u8 = 3;
pub const LOG_LINE_RENDERING_COUNT : u8 = 2;
pub const THIS_FILE_FIXES_A_LOG_LINE_FORMAT : bool = false;
pub const LOG_RENDERING_NOTE : str = "src/main.rs:394-405 installs a JSON subscriber when is_production_env holds and the human formatter otherwise, so the repository fixes two renderings and picks by environment. What is fixed in both is the span name and the three field names at src/api/observability.rs:70-75. A consumer that greps a rendered line shape is reading one of the two, and this file names neither.";

; --- What a metric name is -------------------------------------------------------------------
; A name exists in exactly one place: a string literal inside counter!(...) or gauge!(...). Nothing
; in src/ composes a metric name at runtime, so the set of emitted names is decidable by reading
; the source, which is what both guards below do.
; CORRECTED 2026-09-22: 41, not 29, and 29 was never right. src/metrics.rs holds 41 counter!/gauge!
; name literals -- 41 distinct names, every one above its #[cfg(test)] at :330 -- and held the same
; 41 when this file was first committed (d1877db); no metric macro is invoked anywhere else under
; src/. 29 is the dashboard name guard's view: declared_metrics in src/main.rs searches for the
; markers `counter!("` and `gauge!("`, so the twelve literals opened as `counter!(` with the name
; on the next line -- src/metrics.rs:21, :35, :127, :141, :150, :159, :168, :233, :242, :256, :295
; and :303 -- are invisible to it, and this count copied what it sees. (RE-MEASURED 2026-09-26:
; eleven. :168 was milestone_awarded's referral_milestone_awarded_total, deleted when its one
; caller, the milestone award, stopped with R3; the file keeps its length, so :330 and every other
; line cited here is unmoved. 40 names are emitted, the guard still reads 29, and the count is
; kept under EMITTED_METRIC_NAME_COUNT_BEFORE_2026_09_26.) "What both guards below do"
; is therefore too strong for the name guard: it reads 29 of the 41 names. None of the twelve is
; referenced by any of the four PromQL artifacts today, so no finding below moves; a panel that
; used one would be refused by that guard as undeclared. The count is now held to src/metrics.rs
; by scripts/verify_t27_against_source.py.
pub const EMITTED_METRIC_NAME_COUNT : u16 = 40;
pub const EMITTED_METRIC_NAME_COUNT_BEFORE_2026_09_26 : u16 = 41;
pub const METRIC_NAME_IS_A_STRING_LITERAL : bool = true;
pub const METRIC_NAME_IS_COMPOSED_AT_RUNTIME : bool = false;
; src/metrics.rs:508, every_metric_helper_is_wired: a declared helper with zero call sites fails
; the test. src/metrics.rs:436-438, ALLOWED_UNUSED_METRICS, is empty, so the forward direction has
; no exemptions today.
pub const DECLARED_TO_WIRED_IS_GUARDED : bool = true;
pub const UNWIRED_HELPER_EXEMPTIONS : u8 = 0;

pub fn metric_name_is_emitted(declared_as_a_literal: bool, helper_has_a_call_site: bool) bool {
  return declared_as_a_literal and helper_has_a_call_site;
}

; A reference in a dashboard or an alert resolves only if all three of its parts exist. A label
; SELECTOR that names a key the emitter never attaches, or a value it never passes, returns an
; empty vector exactly as a missing metric does -- the panel is blank and the alert never fires.
pub fn metric_reference_resolves(name_emitted: bool, label_used: bool, label_key_emitted: bool, label_value_emitted: bool) bool {
  if (!name_emitted) {
    return false;
  }
  if (!label_used) {
    return true;
  }
  return label_key_emitted and label_value_emitted;
}

; The failure this contract exists for. An unresolved reference is not loud: Prometheus returns an
; empty result and Grafana draws "No data", which a reader scans as a quiet system. It becomes
; visible only when a test reads the artifact and compares its names against the emitted set.
pub fn reference_failure_is_silent(reference_resolves: bool, a_test_reads_this_artifact: bool) bool {
  return !reference_resolves and !a_test_reads_this_artifact;
}

; --- The measured mismatch ----------------------------------------------------------------------
pub const DASHBOARD_FILE_COUNT : u8 = 2;
pub const DASHBOARD_FILES_READ_BY_A_TEST : u8 = 1;
pub const GUARDED_DASHBOARD_PATH : str = "monitoring/grafana-dashboard.json";
pub const UNGUARDED_DASHBOARD_PATH : str = "docs/grafana-dashboard.json";
pub const UNGUARDED_ALERT_PATH : str = "docs/prometheus-alerts.yaml";
; grep -rn "prometheus-alerts" --include=*.rs . returns 0 outside target/: the alert file has no
; guard of any kind, not a weaker one.
pub const ALERT_FILES_READ_BY_A_TEST : u8 = 0;

; The recording rules are the fourth carrier of PromQL in the tree and were missed when this
; block was first written. Re-measured 2026-09-21: a grep over docs/ and monitoring/ for a JSON
; "expr" key or a YAML expr: line returns 4 files, and grep -rn "prometheus-recording-rules"
; --include=*.rs . returns 0, so it is unguarded exactly as the alert file is. It references only
; axum_ built-ins and other wwb: rules, so it adds no dead name: what it widens is coverage.
pub const PROMQL_ARTIFACT_COUNT : u8 = 4;
pub const PROMQL_ARTIFACTS_READ_BY_A_TEST : u8 = 1;
pub const RECORDING_RULES_PATH : str = "docs/prometheus-recording-rules.yaml";
pub const RECORDING_RULES_READ_BY_A_TEST : bool = false;
pub const RECORDING_RULE_EXPRESSIONS : u8 = 12;
pub const RECORDING_RULES_DEAD_NAMES : u8 = 0;
; The older test below is named the_measured_coverage_gap_is_two_files_of_three. Its asserts are
; still true -- there are two Grafana dashboards and one of them is read -- but its NAME records
; the three-artifact reading this block has since corrected to four. The constants are the
; measurement; the name is a birthmark, and it is left standing rather than quietly rewritten.
; CORRECTED 2026-09-25: the two greps quoted above, grep -rn "prometheus-alerts" --include=*.rs .
; and grep -rn "prometheus-recording-rules" --include=*.rs ., now return 1 each outside target/,
; and "which no Rust test in this repository reads at all" in the header is no longer literally
; true. The owner's ruling of that day (#12, nothing cannabis-related anywhere) rebranded the
; three unguarded artifacts -- the alert names, the dashboard title and the file headers -- and
; tests/legacy_vocabulary_wiring.rs (the_dev_and_ops_files_carry_neither_the_old_name_nor_the_vocabulary,
; its DEV_OPS_FILES list) now reads docs/grafana-dashboard.json, docs/prometheus-alerts.yaml and
; docs/prometheus-recording-rules.yaml whole, for the old shop's name and the retired vocabulary
; and for nothing else. It compares no metric name against the emitted set, so none of the three
; is guarded in this contract's sense (reference_failure_is_silent), and every _READ_BY_A_TEST
; constant here keeps its value: they count reads that compare names. The rename was one line for
; one line, so every line of those files cited in this contract still carries the same expression;
; the wwb: recording-rule prefix was not renamed, because it is the stored series name that the
; alert expressions and any recorded history select.

; The five names referenced by a published artifact and emitted by nothing. The first was a real
; helper until cycle #108 removed it with its pool (src/metrics.rs:320-328); the other four were
; never emitted at all. They are written out because they are the finding, not because this file
; keeps a metric table.
pub const DEAD_METRIC_NAME_COUNT : u8 = 5;
pub const DEAD_METRIC_NAMES : [5]str = ["db_pool_acquire_failed_total", "db_pool_size", "db_pool_available", "db_pool_max_size", "db_pool_waiting"];
; 6 PromQL target expressions in docs/grafana-dashboard.json (:133, :172, :173, :174, :184, :207)
; and 3 alert expressions in docs/prometheus-alerts.yaml (:75, :89, :101). Two further mentions in
; that file are annotation prose (:38, :82) and are not counted as references.
pub const DEAD_NAME_EXPRESSION_SITES : u8 = 9;
pub const ALERT_RULE_COUNT : u8 = 10;
pub const ALERT_RULES_ON_A_DEAD_NAME : u8 = 3;
; The guarded dashboard is clean, and saying so is the point: the guard works, the coverage does not.
pub const GUARDED_DASHBOARD_DEAD_NAMES : u8 = 0;

; A second failure of the same family, one step subtler, because the metric name here is real.
; src/metrics.rs:191 attaches the label key kind. docs/prometheus-alerts.yaml:116 and :127 and
; docs/grafana-dashboard.json:152 select or group by endpoint, so all three select a key the
; emitter never attaches. The alert at :116 goes one further and pins the value admin_login, which
; is the name of a ROUTE and its handler (src/api/admin.rs:136 and :545) and reaches the counter
; from nowhere: grep -rn admin_login src/ returns 12 hits and not one of them is an argument to
; the helper. WHICH kinds the limiter does pass, and from how many sites, is that contract's
; census and not this file's: turbobaby/rate-limit owns it, this file takes only the fact that the
; pinned value is absent from the set, and the two numbers are not restated here.
pub const RATE_LIMIT_EMITTED_LABEL_KEY : str = "kind";
pub const RATE_LIMIT_REFERENCED_LABEL_KEY : str = "endpoint";
pub const ALERT_PINNED_LABEL_VALUE : str = "admin_login";
pub const ALERT_PINNED_LABEL_VALUE_CALL_SITES : u8 = 0;
pub const LABEL_KEY_MISMATCH_SITES : u8 = 3;
pub const LABEL_VALUE_NEVER_EMITTED_SITES : u8 = 1;

; And a third, inside the binary rather than the docs: src/api/auth.rs:602-609 takes a metric kind
; and drops it. The parameter is named _metric_kind at :606 and the body delegates without reading
; it, so six call sites pass a label that is never attached to anything. Named because it is the
; same defect class as a dead dashboard name, and greppable from the opposite side.
; The SIX is not this file's census, and unlike the coincident six next door it is not a
; coincidence either. turbobaby/rate-limit declares CALL_SITES_EMITTING_THE_BLOCKED_METRIC 6 for
; the limiter refusals that reach its counter, and records in the same block that no constant of
; this file opposes that figure. turbobaby/request-identity owns check_owner_lenient as a gate and
; already publishes exactly these call sites as GATE_CALL_SITES_OWNER_LENIENT; the same contract's
; refusal of the brief is where the dropped _metric_kind parameter is noted. Neither is cited by
; line, because a sibling's lines move and its declaration names do not. It is literally the
; same six sites, counted once, there. This file recounts neither the gate nor the sites; it takes
; the owner's figure and adds only the part that is observability's -- that every one of those
; sites hands over a label the callee never attaches. If the two ever disagree, the owner's number
; is the right one and this copy is the stale one.
pub const IGNORED_METRIC_KIND_SITE : str = "src/api/auth.rs:606";
pub const IGNORED_METRIC_KIND_CALL_SITES : u8 = 6;
pub const IGNORED_METRIC_KIND_CENSUS_IS_OWNED_BY_REQUEST_IDENTITY : bool = true;
pub const IGNORED_METRIC_KIND_CENSUS_OWNER_CONSTANT : str = "turbobaby/request-identity GATE_CALL_SITES_OWNER_LENIENT";

pub fn artifact_is_guarded(path_is_read_by_a_test: bool) bool {
  return path_is_read_by_a_test;
}

; --- The health digest ----------------------------------------------------------------------------
; src/trios/health.rs:39, format_health_digest(window_hours, groups). Its shipped strings are
; Russian and are cited by line, never quoted.
pub const HEALTH_DIGEST_GROUP_LIMIT : u16 = 10;
pub const HEALTH_DIGEST_MESSAGE_CHARS : u16 = 200;
pub const HEALTH_DIGEST_PATH_CHARS : u16 = 80;
; :36-43 and the test at :85-90. The window is printed even when there is nothing to report,
; because "no errors" with no period stated reads as "we did not look".
pub const HEALTH_DIGEST_STATES_ITS_WINDOW : bool = true;
; :45-50 and the test at :93-99. Occurrences and distinct kinds are two numbers and are never
; collapsed: one bug hitting a hundred people and a hundred bugs need different reactions.
pub const HEALTH_DIGEST_SEPARATES_OCCURRENCES_FROM_KINDS : bool = true;
; grep -c "request_id\|metrics::" src/trios/health.rs returns 0. The digest reports front-end
; error records and cannot be joined to a span or to a counter by anything it contains.
pub const HEALTH_DIGEST_CARRIES_A_REQUEST_ID : bool = false;
pub const HEALTH_DIGEST_READS_A_METRIC : bool = false;

pub fn health_digest_lists_every_group(group_count: u16) bool {
  return group_count <= HEALTH_DIGEST_GROUP_LIMIT;
}

; :51 takes ten and :64-66 counts the rest. The remainder is stated, so a truncated digest is
; visibly truncated rather than quietly short.
pub fn health_digest_remainder(group_count: u16) u16 {
  if (group_count <= HEALTH_DIGEST_GROUP_LIMIT) {
    return 0;
  }
  return group_count - HEALTH_DIGEST_GROUP_LIMIT;
}

; The publication-discipline edge, made concrete. An empty digest is evidence only when the window
; is stated AND the intake was known to be reachable across it. The second half is not proved
; anywhere, so the answer today is false -- which is the honest verdict, not a defect in the digest.
pub fn empty_digest_proves_health(window_stated: bool, intake_liveness_proved: bool) bool {
  return window_stated and intake_liveness_proved;
}

pub const INTAKE_LIVENESS_IS_NOT_PROVED : bool = true;
pub const INTAKE_LIVENESS_NOTE : str = "Nothing joins the digest to a liveness fact. The counter that would carry one exists -- client_errors_received_total at src/metrics.rs:317 -- and src/trios/health.rs reads no metric at all (grep for metrics:: in that file returns 0), so a window with zero groups is indistinguishable from a window in which the intake was down. What is missing is a reachability witness for the window, not a bigger digest. Inventing a default of healthy would turn an outage into a green report, which is the exact failure the stated window was added to prevent.";

; --- What the existing guard covers -------------------------------------------------------------
; tests/observability_ownership.rs:28-54. It counts four accepted spellings of the declaration
; (:19-23), requires exactly one in src/main.rs, zero in src/api/mod.rs, and an explicit
; #[path = "api/observability.rs"] attribute (:50-53). That is a compilation-ownership guard and
; it is the right one for what it names; it is not a behaviour guard, and this file does not
; pretend it is.
pub const OWNERSHIP_WITNESS_DECLARATION_FORMS : u8 = 4;
pub const OWNERSHIP_WITNESS_MAIN_DECLARATIONS : u8 = 1;
pub const OWNERSHIP_WITNESS_API_MOD_DECLARATIONS : u8 = 0;
pub const OWNERSHIP_WITNESS_CHECKS_HEADER_NAME : bool = false;
pub const OWNERSHIP_WITNESS_CHECKS_THE_LENGTH_CAP : bool = false;
pub const OWNERSHIP_WITNESS_CHECKS_A_METRIC_NAME : bool = false;
pub const OWNERSHIP_WITNESS_CHECKS_AN_ALERT_FILE : bool = false;
; The eleven tests at src/api/observability.rs:96-189 are unit tests inside the module, so they
; travel with the code they check and are the specification the code already carries.
pub const CORRELATION_UNIT_TEST_COUNT : u8 = 11;

pub fn observability_module_ownership_holds(main_declarations: u8, api_mod_declarations: u8, explicit_path_present: bool) bool {
  return main_declarations == OWNERSHIP_WITNESS_MAIN_DECLARATIONS and api_mod_declarations == OWNERSHIP_WITNESS_API_MOD_DECLARATIONS and explicit_path_present;
}

; --- The corpus absence, measured the way it is written ------------------------------------------
; Every count here EXCLUDES this file. Two readings are kept for each grep, because one reading
; would be a claim and two are a measurement: the figure taken when this file was written, over
; the 30 files the corpus then held, and the figure re-measured 2026-09-21 over the 43 it holds
; now. The first writing of this section claimed 0 where the answer was 3; the answer is now 7.
; Leaving a stale absence standing is the one defect a reader cannot catch by reading.
; grep -ril "x-request-id" specs/ -> 0 other files, then and now. That header really is unheld
; anywhere else, and it is the only absence here that survived the growth from 30 files to 43.
; grep -rilE "prometheus|grafana|dashboard|observability|gauge|correlation|scrape" specs/ -> 7
; other files. Four of them -- api_surface.t27, client_errors.t27, rate_limit.t27 and
; request_identity.t27 -- match only in sentences that name this contract or report what it owns,
; so they are inbound edges. The other three match on their own subject: schema_provenance.t27
; owns the VALUE of the
; schema_missing_columns gauge, runtime_config.t27 names that gauge as what a missing column
; raises, and notification_queue.t27 counts the four monitoring artifacts and names the
; queue-depth gauge it does NOT coin. Each of the three defers the naming rule to this file, so
; seven files touch the vocabulary and none of them owns it.
; The brief's own grep is recorded beside them so the difference cannot be lost: 25 files and 51
; matches case-sensitive, 150 with -i, against 14 / 42 / 89 at first writing. Exactly one of
; those is on subject -- turbobaby/rate-limit declares BLOCKED_METRIC_NAME, the literal name of
; the counter it owns -- so the on-subject count is 1 and not 0, and it is the only figure in
; this block that re-measurement left where it was.
pub const CORPUS_FILE_COUNT_AT_REMEASUREMENT : u8 = 43;
pub const CORPUS_FILE_COUNT_AT_FIRST_WRITING : u8 = 30;
pub const CORPUS_FILES_NAMING_A_CORRELATION_HEADER : u8 = 0;
pub const CORPUS_FILES_NAMING_A_METRIC_VOCABULARY : u8 = 7;
pub const CORPUS_FILES_NAMING_IT_ONLY_BY_THIS_CONTRACTS_ID : u8 = 4;
pub const CORPUS_FILES_NAMING_A_METRIC_ON_THEIR_OWN_SUBJECT : u8 = 3;
pub const CORPUS_FILES_NAMING_A_METRIC_VOCABULARY_AT_FIRST_WRITING : u8 = 3;
pub const NEIGHBOUR_SCHEMA_PROVENANCE_ID : str = "turbobaby/schema-provenance";
pub const NEIGHBOUR_RUNTIME_CONFIG_ID : str = "turbobaby/runtime-config";
pub const NEIGHBOUR_NOTIFICATION_QUEUE_ID : str = "turbobaby/notification-queue";
pub const BRIEF_GREP_FILE_COUNT : u8 = 25;
pub const BRIEF_GREP_MATCH_COUNT : u8 = 51;
pub const BRIEF_GREP_MATCH_COUNT_CASE_INSENSITIVE : u8 = 150;
pub const BRIEF_GREP_MATCHES_ON_SUBJECT : u8 = 1;
pub const ON_SUBJECT_MATCH_SITE : str = "turbobaby/rate-limit BLOCKED_METRIC_NAME";
pub const BRIEF_GREP_FILE_COUNT_AT_FIRST_WRITING : u8 = 14;
pub const BRIEF_GREP_MATCH_COUNT_AT_FIRST_WRITING : u8 = 42;
pub const BRIEF_GREP_MATCH_COUNT_CASE_INSENSITIVE_AT_FIRST_WRITING : u8 = 89;

; --- Tests ---------------------------------------------------------------------------------------

test the_owner_contracts_are_named_and_none_of_them_is_restated {
  assert REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity";
  assert REUSES_CATALOG_API_ID == "turbobaby/catalog-api";
  assert REUSES_PUBLICATION_ID == "turbobaby/publication";
  assert REUSES_REQUEST_IDENTITY_ID != ID;
  assert REUSES_CATALOG_API_ID != ID;
  assert REUSES_PUBLICATION_ID != ID;
  assert REUSES_REQUEST_IDENTITY_ID != REUSES_CATALOG_API_ID;
  assert REUSES_CATALOG_API_ID != REUSES_PUBLICATION_ID;
  assert REUSES_RATE_LIMIT_ID == "turbobaby/rate-limit";
  assert REUSES_RATE_LIMIT_ID != ID;
  assert REUSES_RATE_LIMIT_ID != REUSES_REQUEST_IDENTITY_ID;
  assert A_REQUEST_ID_IS_NOT_AN_IDENTITY == true;
  assert THIS_FILE_DECLARES_NO_HTTP_STATUS == true;
  assert OBSERVED_IS_NOT_THE_SAME_AS_TRUE == true;
  assert LIMITER_CALL_SITE_CENSUS_IS_OWNED_THERE == true;
}

test the_accepted_byte_range_is_visible_ascii_only {
  assert request_id_byte_is_accepted(32) == false;
  assert request_id_byte_is_accepted(33) == true;
  assert request_id_byte_is_accepted(126) == true;
  assert request_id_byte_is_accepted(127) == false;
  assert request_id_byte_is_accepted(9) == false;
  assert request_id_byte_is_accepted(10) == false;
  assert request_id_byte_is_accepted(200) == false;
}

test the_live_unit_tests_are_reproduced_as_acceptance_cases {
  assert inbound_request_id_accepted(36, true) == true;
  assert inbound_request_id_accepted(8, true) == true;
  assert inbound_request_id_accepted(0, true) == false;
  assert inbound_request_id_accepted(200, true) == false;
  assert inbound_request_id_accepted(11, false) == false;
}

test every_refusal_the_code_can_reach_has_a_named_reason {
  assert inbound_request_id_refusal(0, true) == REFUSE_EMPTY;
  assert inbound_request_id_refusal(0, false) == REFUSE_EMPTY;
  assert inbound_request_id_refusal(129, true) == REFUSE_OVERSIZED;
  assert inbound_request_id_refusal(200, false) == REFUSE_OVERSIZED;
  assert inbound_request_id_refusal(10, false) == REFUSE_NONGRAPHIC;
  assert inbound_request_id_refusal(36, true) == REFUSE_NONE;
  assert REFUSAL_REASON_IS_VISIBLE_ON_THE_WIRE == false;
}

test the_cap_is_inclusive_at_one_hundred_and_twenty_eight {
  assert inbound_request_id_accepted(REQUEST_ID_MAX_BYTES, true) == true;
  assert inbound_request_id_accepted(REQUEST_ID_MAX_BYTES + 1, true) == false;
  assert MINTED_REQUEST_ID_LEN < REQUEST_ID_MAX_BYTES;
  assert REQUEST_ID_CAP_IS_BYTES_NOT_CHARS == true;
}

test a_missing_and_a_refused_header_take_the_same_branch {
  assert request_id_is_minted(false, false) == true;
  assert request_id_is_minted(false, true) == true;
  assert request_id_is_minted(true, false) == true;
  assert request_id_is_minted(true, true) == false;
  assert request_id_is_inherited(true, true) == true;
  assert request_id_is_inherited(true, false) == false;
  assert request_id_is_inherited(false, true) == false;
  assert request_id_is_inherited(false, false) == false;
  assert request_id_always_exists(true, true) == true;
  assert request_id_always_exists(true, false) == true;
  assert request_id_always_exists(false, true) == true;
  assert request_id_always_exists(false, false) == true;
}

test the_response_carries_the_id_on_every_reachable_value {
  assert response_echoes_request_id(true) == true;
  assert response_echoes_request_id(false) == false;
  assert ECHO_HAS_NO_REACHABLE_FAILURE_TODAY == true;
  assert correlation_is_available(true, true, true) == true;
  assert correlation_is_available(false, false, true) == true;
  assert correlation_is_available(true, false, true) == true;
  assert correlation_is_available(true, true, false) == false;
}

test a_correlated_request_is_still_an_unidentified_one {
  assert correlated_but_unidentified(true, false) == true;
  assert correlated_but_unidentified(true, true) == false;
  assert correlated_but_unidentified(false, false) == false;
  assert REQUEST_ID_IS_CLIENT_SUPPLIED == true;
  assert REQUEST_ID_IS_PROVED_BY_NOTHING == true;
}

test the_span_fixes_three_field_names_and_no_rendering {
  assert REQUEST_ID_SPAN_NAME == "http_request";
  assert SPAN_FIELD_NAMES.len == SPAN_FIELD_COUNT;
  assert SPAN_FIELD_NAMES[0] == "request_id";
  assert SPAN_FIELD_NAMES[1] == "method";
  assert SPAN_FIELD_NAMES[2] == "path";
  assert THIS_FILE_FIXES_A_LOG_LINE_FORMAT == false;
  assert LOG_LINE_RENDERING_COUNT == 2;
}

test the_header_name_is_the_lowercase_wire_spelling {
  assert REQUEST_ID_HEADER == "x-request-id";
  assert WHITESPACE_IS_TRIMMED_BEFORE_JUDGEMENT == true;
}

test a_metric_name_exists_only_where_a_literal_and_a_call_site_do {
  assert metric_name_is_emitted(true, true) == true;
  assert metric_name_is_emitted(true, false) == false;
  assert metric_name_is_emitted(false, true) == false;
  assert metric_name_is_emitted(false, false) == false;
  assert METRIC_NAME_IS_A_STRING_LITERAL == true;
  assert METRIC_NAME_IS_COMPOSED_AT_RUNTIME == false;
  assert DECLARED_TO_WIRED_IS_GUARDED == true;
  assert UNWIRED_HELPER_EXEMPTIONS == 0;
  // 29 until 2026-09-22: the name guard's view, blind to the twelve multi-line literals;
  // 40 since 2026-09-26, when one of those twelve left with the milestone award (R3).
  assert EMITTED_METRIC_NAME_COUNT == 40;
  assert EMITTED_METRIC_NAME_COUNT_BEFORE_2026_09_26 - EMITTED_METRIC_NAME_COUNT == 1;
}

test a_reference_resolves_only_when_name_key_and_value_all_exist {
  assert metric_reference_resolves(true, false, false, false) == true;
  assert metric_reference_resolves(true, true, true, true) == true;
  assert metric_reference_resolves(false, false, false, false) == false;
  assert metric_reference_resolves(false, true, true, true) == false;
  assert metric_reference_resolves(true, true, false, true) == false;
  assert metric_reference_resolves(true, true, true, false) == false;
}

test the_label_key_mismatch_is_a_real_unresolved_reference {
  assert RATE_LIMIT_EMITTED_LABEL_KEY == "kind";
  assert RATE_LIMIT_REFERENCED_LABEL_KEY == "endpoint";
  assert RATE_LIMIT_EMITTED_LABEL_KEY != RATE_LIMIT_REFERENCED_LABEL_KEY;
  assert metric_reference_resolves(true, true, false, true) == false;
  assert LABEL_KEY_MISMATCH_SITES == 3;
  assert LABEL_VALUE_NEVER_EMITTED_SITES == 1;
  assert ALERT_PINNED_LABEL_VALUE == "admin_login";
  assert ALERT_PINNED_LABEL_VALUE_CALL_SITES == 0;
  assert metric_reference_resolves(true, true, true, false) == false;
}

test a_dead_name_in_an_unguarded_artifact_fails_without_a_sound {
  assert reference_failure_is_silent(false, false) == true;
  assert reference_failure_is_silent(false, true) == false;
  assert reference_failure_is_silent(true, false) == false;
  assert reference_failure_is_silent(true, true) == false;
}

test the_measured_coverage_gap_is_two_files_of_three {
  assert DASHBOARD_FILE_COUNT == 2;
  assert DASHBOARD_FILES_READ_BY_A_TEST == 1;
  assert ALERT_FILES_READ_BY_A_TEST == 0;
  assert GUARDED_DASHBOARD_PATH != UNGUARDED_DASHBOARD_PATH;
  assert artifact_is_guarded(true) == true;
  assert artifact_is_guarded(false) == false;
  assert DASHBOARD_FILES_READ_BY_A_TEST < DASHBOARD_FILE_COUNT;
}

test the_five_dead_names_are_named_and_counted {
  assert DEAD_METRIC_NAMES.len == DEAD_METRIC_NAME_COUNT;
  assert DEAD_METRIC_NAMES[0] == "db_pool_acquire_failed_total";
  assert DEAD_METRIC_NAMES[1] == "db_pool_size";
  assert DEAD_METRIC_NAMES[2] == "db_pool_available";
  assert DEAD_METRIC_NAMES[3] == "db_pool_max_size";
  assert DEAD_METRIC_NAMES[4] == "db_pool_waiting";
  assert DEAD_NAME_EXPRESSION_SITES == 9;
  assert ALERT_RULES_ON_A_DEAD_NAME == 3;
  assert ALERT_RULES_ON_A_DEAD_NAME < ALERT_RULE_COUNT;
}

test the_guarded_dashboard_is_clean_and_that_is_the_point {
  assert GUARDED_DASHBOARD_DEAD_NAMES == 0;
  assert DEAD_METRIC_NAME_COUNT > GUARDED_DASHBOARD_DEAD_NAMES;
  assert reference_failure_is_silent(false, true) == false;
}

test the_recording_rules_are_the_fourth_artifact_and_nothing_reads_them {
  assert PROMQL_ARTIFACT_COUNT == 4;
  assert PROMQL_ARTIFACTS_READ_BY_A_TEST == 1;
  assert RECORDING_RULES_PATH == "docs/prometheus-recording-rules.yaml";
  assert RECORDING_RULES_READ_BY_A_TEST == false;
  assert RECORDING_RULE_EXPRESSIONS == 12;
  assert RECORDING_RULES_DEAD_NAMES == 0;
  assert PROMQL_ARTIFACT_COUNT > DASHBOARD_FILE_COUNT;
  assert PROMQL_ARTIFACT_COUNT > PROMQL_ARTIFACTS_READ_BY_A_TEST;
  assert artifact_is_guarded(RECORDING_RULES_READ_BY_A_TEST) == false;
}

test a_metric_kind_is_dropped_inside_the_binary_too {
  assert IGNORED_METRIC_KIND_SITE == "src/api/auth.rs:606";
  assert IGNORED_METRIC_KIND_CALL_SITES == 6;
  assert metric_name_is_emitted(false, true) == false;
  assert IGNORED_METRIC_KIND_CENSUS_IS_OWNED_BY_REQUEST_IDENTITY == true;
  assert IGNORED_METRIC_KIND_CENSUS_OWNER_CONSTANT == "turbobaby/request-identity GATE_CALL_SITES_OWNER_LENIENT";
}

test the_digest_states_its_window_and_counts_what_it_cut {
  assert HEALTH_DIGEST_STATES_ITS_WINDOW == true;
  assert HEALTH_DIGEST_SEPARATES_OCCURRENCES_FROM_KINDS == true;
  assert health_digest_lists_every_group(0) == true;
  assert health_digest_lists_every_group(10) == true;
  assert health_digest_lists_every_group(12) == false;
  assert health_digest_remainder(0) == 0;
  assert health_digest_remainder(10) == 0;
  assert health_digest_remainder(12) == 2;
}

test the_digest_cannot_correlate_and_says_so {
  assert HEALTH_DIGEST_CARRIES_A_REQUEST_ID == false;
  assert HEALTH_DIGEST_READS_A_METRIC == false;
  assert empty_digest_proves_health(true, false) == false;
  assert empty_digest_proves_health(false, true) == false;
  assert empty_digest_proves_health(true, true) == true;
  assert INTAKE_LIVENESS_IS_NOT_PROVED == true;
}

test the_existing_guard_owns_declarations_and_nothing_else {
  assert observability_module_ownership_holds(1, 0, true) == true;
  assert observability_module_ownership_holds(0, 0, true) == false;
  assert observability_module_ownership_holds(2, 0, true) == false;
  assert observability_module_ownership_holds(1, 1, true) == false;
  assert observability_module_ownership_holds(1, 0, false) == false;
  assert OWNERSHIP_WITNESS_DECLARATION_FORMS == 4;
  assert OWNERSHIP_WITNESS_CHECKS_HEADER_NAME == false;
  assert OWNERSHIP_WITNESS_CHECKS_THE_LENGTH_CAP == false;
  assert OWNERSHIP_WITNESS_CHECKS_A_METRIC_NAME == false;
  assert OWNERSHIP_WITNESS_CHECKS_AN_ALERT_FILE == false;
  assert CORRELATION_UNIT_TEST_COUNT == 11;
}

test the_corpus_absence_is_recorded_with_the_brief_it_corrects {
  assert CORPUS_FILE_COUNT_AT_REMEASUREMENT == 43;
  assert CORPUS_FILE_COUNT_AT_FIRST_WRITING == 30;
  assert CORPUS_FILE_COUNT_AT_REMEASUREMENT > CORPUS_FILE_COUNT_AT_FIRST_WRITING;
  assert CORPUS_FILES_NAMING_A_CORRELATION_HEADER == 0;
  assert CORPUS_FILES_NAMING_A_METRIC_VOCABULARY == 7;
  assert CORPUS_FILES_NAMING_A_METRIC_VOCABULARY_AT_FIRST_WRITING == 3;
  assert CORPUS_FILES_NAMING_A_METRIC_VOCABULARY > CORPUS_FILES_NAMING_A_METRIC_VOCABULARY_AT_FIRST_WRITING;
  assert CORPUS_FILES_NAMING_IT_ONLY_BY_THIS_CONTRACTS_ID + CORPUS_FILES_NAMING_A_METRIC_ON_THEIR_OWN_SUBJECT == CORPUS_FILES_NAMING_A_METRIC_VOCABULARY;
  assert NEIGHBOUR_SCHEMA_PROVENANCE_ID == "turbobaby/schema-provenance";
  assert NEIGHBOUR_SCHEMA_PROVENANCE_ID != ID;
  assert NEIGHBOUR_RUNTIME_CONFIG_ID == "turbobaby/runtime-config";
  assert NEIGHBOUR_NOTIFICATION_QUEUE_ID == "turbobaby/notification-queue";
  assert NEIGHBOUR_RUNTIME_CONFIG_ID != NEIGHBOUR_SCHEMA_PROVENANCE_ID;
  assert NEIGHBOUR_NOTIFICATION_QUEUE_ID != NEIGHBOUR_RUNTIME_CONFIG_ID;
  assert NEIGHBOUR_NOTIFICATION_QUEUE_ID != ID;
  assert BRIEF_GREP_FILE_COUNT == 25;
  assert BRIEF_GREP_MATCH_COUNT == 51;
  assert BRIEF_GREP_MATCH_COUNT_CASE_INSENSITIVE == 150;
  assert BRIEF_GREP_MATCHES_ON_SUBJECT == 1;
  assert ON_SUBJECT_MATCH_SITE == "turbobaby/rate-limit BLOCKED_METRIC_NAME";
  assert BRIEF_GREP_FILE_COUNT_AT_FIRST_WRITING == 14;
  assert BRIEF_GREP_MATCH_COUNT_AT_FIRST_WRITING == 42;
  assert BRIEF_GREP_MATCH_COUNT_CASE_INSENSITIVE_AT_FIRST_WRITING == 89;
  assert BRIEF_GREP_FILE_COUNT > BRIEF_GREP_FILE_COUNT_AT_FIRST_WRITING;
  assert BRIEF_GREP_MATCH_COUNT > BRIEF_GREP_MATCH_COUNT_AT_FIRST_WRITING;
  assert BRIEF_GREP_FILE_COUNT > CORPUS_FILES_NAMING_A_CORRELATION_HEADER;
  assert BRIEF_GREP_MATCH_COUNT_CASE_INSENSITIVE > BRIEF_GREP_MATCH_COUNT;
}

; --- Invariants ------------------------------------------------------------------------------------

invariant no_request_leaves_the_middleware_uncorrelated
  assert request_id_always_exists(true, true) and request_id_always_exists(true, false) and request_id_always_exists(false, true) and request_id_always_exists(false, false)

invariant an_inherited_id_and_a_minted_id_are_never_both_true
  assert !request_id_is_inherited(true, false) and !request_id_is_inherited(false, true) and !request_id_is_inherited(false, false) and !request_id_is_minted(true, true)

invariant an_empty_or_oversized_or_nongraphic_value_is_never_inherited
  assert inbound_request_id_accepted(0, true) == false and inbound_request_id_accepted(REQUEST_ID_MAX_BYTES + 1, true) == false and inbound_request_id_accepted(36, false) == false

invariant the_accepted_byte_range_excludes_space_and_delete
  assert request_id_byte_is_accepted(32) == false and request_id_byte_is_accepted(127) == false and request_id_byte_is_accepted(REQUEST_ID_BYTE_MIN) == true and request_id_byte_is_accepted(REQUEST_ID_BYTE_MAX) == true

invariant a_minted_id_always_fits_the_cap_it_bypasses
  assert MINTED_REQUEST_ID_LEN > 0 and MINTED_REQUEST_ID_LEN <= REQUEST_ID_MAX_BYTES

invariant correlation_never_amounts_to_identification
  assert correlated_but_unidentified(true, false) == true and A_REQUEST_ID_IS_NOT_AN_IDENTITY == true and REQUEST_ID_IS_PROVED_BY_NOTHING == true

invariant an_unemitted_name_can_never_resolve_however_its_labels_read
  assert metric_reference_resolves(false, false, false, false) == false and metric_reference_resolves(false, true, true, true) == false

invariant a_wrong_label_key_fails_exactly_as_a_wrong_name_does
  assert metric_reference_resolves(true, true, false, true) == false and metric_reference_resolves(true, true, true, false) == false

invariant an_unguarded_artifact_is_the_only_way_a_dead_name_stays_quiet
  assert reference_failure_is_silent(false, false) == true and reference_failure_is_silent(false, true) == false and reference_failure_is_silent(true, false) == false

invariant the_published_artifacts_outnumber_the_guarded_ones
  assert DASHBOARD_FILES_READ_BY_A_TEST < DASHBOARD_FILE_COUNT and ALERT_FILES_READ_BY_A_TEST == 0 and DEAD_METRIC_NAME_COUNT > GUARDED_DASHBOARD_DEAD_NAMES

invariant the_dead_name_list_cannot_be_emptied_without_a_test_going_red
  assert DEAD_METRIC_NAMES.len == DEAD_METRIC_NAME_COUNT and DEAD_METRIC_NAME_COUNT > 0 and DEAD_NAME_EXPRESSION_SITES >= DEAD_METRIC_NAME_COUNT

invariant a_truncated_digest_states_what_it_cut
  assert health_digest_lists_every_group(HEALTH_DIGEST_GROUP_LIMIT) == true and health_digest_remainder(HEALTH_DIGEST_GROUP_LIMIT + 2) == 2

invariant silence_in_the_digest_is_never_by_itself_a_claim_of_health
  assert empty_digest_proves_health(true, false) == false and INTAKE_LIVENESS_IS_NOT_PROVED == true and HEALTH_DIGEST_READS_A_METRIC == false

invariant the_ownership_guard_proves_nothing_about_behaviour
  assert OWNERSHIP_WITNESS_CHECKS_HEADER_NAME == false and OWNERSHIP_WITNESS_CHECKS_THE_LENGTH_CAP == false and OWNERSHIP_WITNESS_CHECKS_A_METRIC_NAME == false and OWNERSHIP_WITNESS_CHECKS_AN_ALERT_FILE == false

invariant the_dropped_label_count_is_a_marked_copy_of_the_gate_census
  assert IGNORED_METRIC_KIND_CENSUS_IS_OWNED_BY_REQUEST_IDENTITY == true and IGNORED_METRIC_KIND_CALL_SITES == 6 and REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity"

invariant the_vocabulary_absence_is_a_count_and_never_a_claim_of_zero
  assert CORPUS_FILES_NAMING_IT_ONLY_BY_THIS_CONTRACTS_ID + CORPUS_FILES_NAMING_A_METRIC_ON_THEIR_OWN_SUBJECT == CORPUS_FILES_NAMING_A_METRIC_VOCABULARY and CORPUS_FILES_NAMING_A_METRIC_ON_THEIR_OWN_SUBJECT > 0 and BRIEF_GREP_MATCHES_ON_SUBJECT > 0

invariant this_file_publishes_no_transport_outcome_and_no_threshold
  assert THIS_FILE_DECLARES_NO_HTTP_STATUS == true and THIS_FILE_FIXES_A_LOG_LINE_FORMAT == false
