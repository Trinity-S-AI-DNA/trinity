pub const CONTRACTS_MENTIONING_STARTAPP_2026_09_22 : u8 = 0;

; --- Ownership edges ------------------------------------------------------------------------------
; The pinned compiler lowers a brace import to an empty UseDecl, so an edge is a named ID plus a
; test asserting the literal. Each owner's decision enters this file as an abstract parameter,
; never as a copied table.
pub const REUSES_LEGACY_RETIREMENT_ID : str = "turbobaby/legacy-retirement";
pub const REUSES_REQUEST_IDENTITY_ID : str = "turbobaby/request-identity";
pub const REUSES_LOCALE_POLICY_ID : str = "turbobaby/locale-policy";
pub const REUSE_EDGE_COUNT : u8 = 3;
pub const LEGACY_RETIREMENT_SUPPLIES : str = "retirement_keeps_the_route -- whether a retired surface keeps a resolvable path at all. Written in parallel with this file; this contract holds the link-side membership and its evidence lines, not the retirement rule.";
pub const REQUEST_IDENTITY_SUPPLIES : str = "identity_proof_passed -- a resolved link is a destination and never an authority.";
pub const LOCALE_POLICY_SUPPLIES : str = "the published locale set and its fallback; this file only records that the payload carries no locale segment.";

; --- Inbound: who takes this file's decisions -------------------------------------------------------
; ONE consumer when this file was written; FIVE on 2026-09-21. The count below is the re-measured
; one, and the earlier figure is kept beside it rather than overwritten silently, because "one
; contract takes this file's decisions" is exactly the kind of sentence a reader believes without
; re-running anything. Each of the five declares the edge from its own side as
; REUSES_DEEPLINK_ID = "turbobaby/deeplink", and each was opened and re-read on 2026-09-21 rather
; than counted from a grep alone: turbobaby/promo-broadcast, whose note states that the prefix set
; is taken as a PARAMETER and its members are deliberately not counted there;
; turbobaby/customer-surface, which also carries DEEPLINK_SUPPLIES naming deeplink_landing and
; deeplink_is_a_dead_tap; turbobaby/notification-queue, which takes the payload its one button
; carries; turbobaby/referral-program, which takes the link form of the start payload and
; disclaims the grammar; and turbobaby/webapp-bridge, which also points here through
; LEGACY_ALIASES_ARE_DECLARED_AT. That is the shape this corpus wants, and it is recorded here so
; every edge is greppable from both ends.
; WHY NO LINE NUMBERS. The three that used to stand here -- the edge, its assertion and the note
; next door -- moved TWICE while this file was under review, and they were :88, :581 and :85 an
; hour before that. The durable half of a citation is the constant NAME, so names are all that is
; cited now; a reader who cannot find one should grep for it rather than conclude the edge is gone.
; turbobaby/request-identity also names this file, but in the OTHER direction -- it lists
; turbobaby/deeplink among ITS consumers, matching REUSES_REQUEST_IDENTITY_ID below. It is not a
; consumer of this file and is deliberately not counted as one.
pub const CONSUMER_COUNT : u8 = 5;
pub const CONSUMERS : [5]str = [
    "turbobaby/promo-broadcast",
    "turbobaby/customer-surface",
    "turbobaby/notification-queue",
    "turbobaby/referral-program",
    "turbobaby/webapp-bridge",
];
pub const CONSUMER_COUNT_WHEN_THIS_FILE_WAS_WRITTEN : u8 = 1;
pub const CONSUMERS_MEASURED_AT : str = "2026-09-21";
pub const CONSUMER_EDGE_DECLARATION : str = "REUSES_DEEPLINK_ID";

; ONE FACT IS CO-DECLARED, AND THE OVERLAP IS ADJUDICATED RATHER THAN IGNORED.
; turbobaby/bot-surface declares REFERRAL_PAYLOAD_IS_A_MINIAPP_TARGET = false, the
; same boolean as REFERRAL_CODE_IS_A_MINIAPP_TARGET below, and cites the same two source lines
; (src/trios/deeplink.rs:262-263). It was written in parallel and does not carry a reuse edge to
; this file -- re-measured 2026-09-21: it declares no REUSES_DEEPLINK_ID, so it is correctly
; absent from the consumer list above. The split that keeps both honest: the referral PREFIX and
; the length bound on its code are the bot surface's own grammar, which it owns as REFERRAL_PREFIX
; and REFERRAL_CODE_MAX_LEN, both read from src/bot/commands.rs:188-190,
; while whether that payload is a Mini App TARGET is a property of the parser's target set, and the
; parser is this contract's subject. A future edit that changes the answer must change it here
; first; the copy over there is evidence, not a second opinion.
; THE VALUE BELOW USED TO BE A LINE NUMBER, AND THE LINE HAD MOVED. A constant whose VALUE is a
; stale line reference is worse than a stale comment: a comment is read by a human who can see it
; is wrong, while this string is what a tool would resolve. It names the ID and the declaration now.
pub const CO_DECLARED_FACT_COUNT : u8 = 1;
pub const CO_DECLARED_FACT_SITE : str = "turbobaby/bot-surface declares REFERRAL_PAYLOAD_IS_A_MINIAPP_TARGET -- re-measured 2026-09-21; the ID and the declaration name are the durable halves, a line number is not";
pub const CO_DECLARED_FACT_OWNER_ID : str = "turbobaby/bot-surface";
pub const CO_DECLARED_FACT_DECLARATION : str = "REFERRAL_PAYLOAD_IS_A_MINIAPP_TARGET";
pub const CO_DECLARER_CARRIES_NO_EDGE_BACK : bool = true;
pub const BOT_SURFACE_GRAMMAR_DECLARATIONS : [2]str = ["REFERRAL_PREFIX", "REFERRAL_CODE_MAX_LEN"];

; --- The four-stage pipeline ----------------------------------------------------------------------
; src/trios/deeplink.rs:3-10 names all four. Build: the Mini App turns a target into a t.me link
; carrying `?start=<payload>` (src/ui/share.rs:137-151). Classify: the BOT decides whether an
; incoming `/start <payload>` addresses the Mini App (src/bot/mod.rs:189-209). Carry: the answering
; button's URL carries the payload onward as `?startapp=` beside a locale and a cache-bust
; (src/bot/commands.rs:114-117). Parse: the Mini App reads it back (src/ui/app.rs:174).
pub const STAGE_COUNT : u8 = 4;
pub const STAGE_BUILD : u8 = 1;
pub const STAGE_CLASSIFY : u8 = 2;
pub const STAGE_CARRY : u8 = 3;
pub const STAGE_PARSE : u8 = 4;
pub const STAGE_NAMES : [4]str = ["build", "classify", "carry", "parse"];

pub const OWNER_NONE : u8 = 0;
pub const OWNER_MINIAPP : u8 = 1;
pub const OWNER_BOT : u8 = 2;

pub fn deeplink_stage_is_known(stage: u8) bool {
  return stage >= STAGE_BUILD and stage <= STAGE_PARSE;
}

pub fn deeplink_stage_owner(stage: u8) u8 {
  if (stage == STAGE_BUILD) {
    return OWNER_MINIAPP;
  }
  if (stage == STAGE_CLASSIFY) {
    return OWNER_BOT;
  }
  if (stage == STAGE_CARRY) {
    return OWNER_BOT;
  }
  if (stage == STAGE_PARSE) {
    return OWNER_MINIAPP;
  }
  return OWNER_NONE;
}

; Stage 1 may refuse. It may NOT emit a payload it knows cannot travel: src/trios/deeplink.rs:214-216
; states the refusal and :226 performs it, and the caller at src/ui/share.rs:145-150 degrades to the
; plain bot link rather than to a link that opens the wrong place with no error anywhere.
pub fn deeplink_build_emits_a_link(target_known: bool, payload_transportable: bool) bool {
  return target_known and payload_transportable;
}

; Stage 2 may NOT hold a second opinion. `is_miniapp_payload` is `parse(payload).is_some()`
; (src/trios/deeplink.rs:264-265) and the bot delegates to it (src/bot/mod.rs:209), so the set the
; bot answers and the set the app can open are one set by construction, not by agreement.
pub const CLASSIFIER_DELEGATES_TO_THE_PARSER : bool = true;
pub const CLASSIFIER_HELD_A_SECOND_LIST_ONCE : bool = true;
pub const PAYLOADS_THE_TWO_LISTS_DISAGREED_ON : u8 = 12;
pub const PAYLOAD_SWEEP_SIZE : u8 = 46;

pub fn deeplink_bot_answers_with_miniapp_button(payload_parses: bool) bool {
  return payload_parses;
}

pub fn deeplink_classifier_agrees_with_parser(payload_parses: bool) bool {
  if (deeplink_bot_answers_with_miniapp_button(payload_parses)) {
    return payload_parses;
  }
  return !payload_parses;
}

; --- The payload grammar --------------------------------------------------------------------------
; src/trios/deeplink.rs:24-28 declares the cap and names its origin: both limits are Telegram's, so
; a payload that breaks them is not a link that works badly, it is a link that is never carried.
; src/trios/deeplink.rs:106-112 enforces all three conditions together.
pub const PAYLOAD_MIN_LEN : u16 = 1;
pub const PAYLOAD_MAX_LEN : u16 = 64;
pub const PAYLOAD_LIMITS_ARE_TELEGRAMS_NOT_OURS : bool = true;
pub const PAYLOAD_CHAR_CLASS : str = "A-Za-z0-9_-";
pub const PAYLOAD_CHAR_CLASS_SITE : str = "src/trios/deeplink.rs:111 is_ascii_alphanumeric or underscore or hyphen";

pub fn deeplink_payload_transportable(length: u16, all_chars_in_class: bool) bool {
  if (length < PAYLOAD_MIN_LEN) {
    return false;
  }
  if (length > PAYLOAD_MAX_LEN) {
    return false;
  }
  return all_chars_in_class;
}

; The attribution segment: a trailing `__<source>` naming where the link was published, separated
; by a doubled underscore so one convention covers every target (src/trios/deeplink.rs:127-137).
; Its own bound is narrower than the payload's (src/trios/deeplink.rs:115-120).
pub const SOURCE_SEPARATOR : str = "__";
pub const SOURCE_SEGMENT_MIN_LEN : u16 = 1;
pub const SOURCE_SEGMENT_MAX_LEN : u16 = 50;

pub fn deeplink_source_segment_usable(length: u16, all_chars_in_class: bool) bool {
  if (length < SOURCE_SEGMENT_MIN_LEN) {
    return false;
  }
  if (length > SOURCE_SEGMENT_MAX_LEN) {
    return false;
  }
  return all_chars_in_class;
}

; --- The target set and its wire shapes -------------------------------------------------------------
; Five targets (src/trios/deeplink.rs:75-103). Five product prefixes (src/trios/deeplink.rs:51-59),
; each carrying its own underscore, which is why the parser strips a prefix rather than splitting on
; the first separator (src/trios/deeplink.rs:139-143). The non-product shapes are pinned by the
; round-trip table at src/trios/deeplink.rs:449-465; the placeholders below stand where a real id
; would go, because a spec with a live id in it is a fixture, not a grammar.
pub const TARGET_COUNT : u8 = 5;
pub const TARGET_NAMES : [5]str = ["product", "order", "cart", "reorder", "referrals"];
pub const PRODUCT_PREFIX_COUNT : u8 = 5;
pub const PRODUCT_PREFIXES : [5]str = ["p_strain", "p_acc", "p_set", "p_tea", "p_event"];
pub const NON_PRODUCT_SHAPE_COUNT : u8 = 5;
pub const NON_PRODUCT_WIRE_SHAPES : [5]str = ["cart", "cart__<source>", "o_<id>", "reorder__<id>", "referrals"];
pub const PREFIX_IS_STRIPPED_NOT_SPLIT : bool = true;
pub const A_BARE_PREFIX_WITH_NO_ID_IS_REFUSED : bool = true;

; --- Where an unparseable payload goes --------------------------------------------------------------
; The named outcomes. LANDING_APP_ROOT is a real destination and a legitimate one for a customer who
; opened the app with no payload at all; it becomes a DEFECT only when a link promised something
; else, which is the distinction `deeplink_is_a_dead_tap` draws and no boolean in the code does.
pub const LANDING_NONE : u8 = 0;
pub const LANDING_BOT_WELCOME : u8 = 1;
pub const LANDING_TARGET_SCREEN : u8 = 2;
pub const LANDING_APP_ROOT : u8 = 3;
pub const LANDING_KIND_COUNT : u8 = 3;

; An unparseable payload never reaches the app. `parse` falls through to None
; (src/trios/deeplink.rs:201), the classifier therefore refuses, and the handler continues past the
; Mini App branch (src/bot/commands.rs:232-253) past the idempotent seeding of the profile and the
; referral code at :255-259 and into the ordinary welcome at :290-317, so the customer is not
; merely told no. A payload that
; parses but that the app declines to consume leaves every signal unset, and the root renders the
; live catalog rather than the compatibility controller (src/ui/routes.rs:91-117). Both are named
; screens. Neither is a guess.
pub fn deeplink_landing(payload_parses: bool, app_consumes_target: bool) u8 {
  if (!payload_parses) {
    return LANDING_BOT_WELCOME;
  }
  if (!app_consumes_target) {
    return LANDING_APP_ROOT;
  }
  return LANDING_TARGET_SCREEN;
}

pub fn deeplink_landing_is_known(landing: u8) bool {
  return landing >= LANDING_BOT_WELCOME and landing <= LANDING_APP_ROOT;
}

; The defect shape, stated so it can be tested rather than noticed in production: the bot rendered a
; button, the customer tapped it, and the app placed them where the link did not point. This is what
; the retired Garden target did (src/trios/deeplink.rs:231-237) and what the target that replaced it
; does today (src/ui/share.rs:119, no reader for the fifth target).
pub fn deeplink_is_a_dead_tap(payload_parses: bool, app_consumes_target: bool) bool {
  return payload_parses and !app_consumes_target;
}

pub const TARGETS_DECLARED : u8 = 5;
pub const TARGETS_WITH_A_LIVE_LANDING : u8 = 4;
pub const UNCONSUMED_TARGET_NAME : str = "referrals";
pub const DESTINATION_TABLE_HAS_A_PRODUCTION_CALLER : bool = false;
pub const SHIPPED_LANDING_SITE : str = "src/ui/share.rs:87-91 ProductKind::route, single caller src/ui/screens/home_screen.rs:181";
pub const GATED_LANDING_SITE : str = "src/trios/deeplink.rs:242-256 destination, five call sites all inside its own cfg(test) module";
pub const TWO_LANDING_TABLES_DISAGREE : bool = true;
pub const THE_DISAGREEMENT_IS_UNREACHABLE_BY_THE_HOST_SUITE : bool = true;
pub const WHICH_SCREEN_A_KIND_LANDS_ON_IS_NOT_DECLARED_HERE : bool = true;

; --- The compatibility set ---------------------------------------------------------------------------
; Three route aliases survive their screens, and each is kept for the same measured reason: shared
; links do not expire. src/ui/routes.rs:132-134 says months of one payload sit in customers' Telegram
; histories forever and a router miss is worse than the catalog; :145-148 says the same of the second;
; :277-278 says old shared links keep working for the third. What each renders is a LIVE surface,
; never the retired one: two land on the catalog (src/ui/routes.rs:135-140, :150-155) and one on the
; ride screen without importing the retired asset (src/ui/routes.rs:68-71, :275-282). WHY a retirement
; keeps its path is REUSES_LEGACY_RETIREMENT_ID's decision, and it arrives below as a parameter.
; THE OTHER HALF OF THAT EDGE IS A PARTIAL OVERLAP, AND IT IS ADJUDICATED RATHER THAN LEFT TO A
; READER. turbobaby/legacy-retirement declares REPOINTED_ROUTE_COUNT = 2 over the
; same two paths, /sets and /sommelier, and its scope note states that /skate belongs to
; turbobaby/ride-game and turbobaby/star-award and enters none of its counts -- both re-read
; 2026-09-21, and the line the count used to be cited at had already moved by one. The two counts are
; therefore three and two over different questions and neither is a copy of the other: that file
; counts paths whose SCREEN was deleted while the path survived, a retirement state; this file
; counts paths kept RESOLVABLE for links already sent, a link-compatibility set, which is why
; /skate is a member here and not there. A future edit that adds or drops an alias must move both
; numbers, and they are not equal by construction.
pub const LEGACY_ALIAS_COUNT : u8 = 13;
pub const LEGACY_ROUTE_ALIASES : [13]str = ["/skate", "/sets", "/sommelier", "/events", "/events/:id", "/my-bookings", "/accessories", "/tea", "/game", "/treasure-hunt", "/ar-hunt", "/location-quest", "/tech-tree"];
pub const LEGACY_ALIAS_SURFACES : [13]str = ["ride", "catalog", "catalog", "catalog", "catalog", "catalog", "catalog", "catalog", "catalog", "catalog", "catalog", "catalog", "catalog"];
pub const A_LEGACY_ALIAS_NEVER_MOUNTS_THE_RETIRED_SCREEN : bool = true;
pub const LEGACY_LINKS_DO_NOT_EXPIRE : bool = true;
; CORRECTED 2026-09-24: the compatibility set was three paths and is six. On the owner's ruling of
; that day (rental only, Phuket only; REUSES_LEGACY_RETIREMENT_ID records it) the three events
; paths -- /events, /events/:id and /my-bookings, src/ui/routes.rs:39-44 -- stopped mounting the
; events screens and render the live catalog from their handlers at src/ui/routes.rs:175-200, for
; the reason the paragraph above gives for the first three: a link already sent never expires. The
; paragraph above is kept as the reading it was, and so is its adjudication, whose numbers moved
; together as it said they must: this set grew by the three events paths, and so did
; turbobaby/legacy-retirement's REPOINTED_ROUTE_COUNT, whose value is that file's and is not
; restated here. The two still answer different questions and are still not equal by construction:
; /skate is a member here and not there. What a p_event payload lands on did not change: the shipped
; landing (SHIPPED_LANDING_SITE) already sent it to the fleet, and the parser still answers it.
pub const LEGACY_ALIAS_COUNT_BEFORE_2026_09_24 : u8 = 3;
pub const LEGACY_ROUTE_ALIASES_BEFORE_2026_09_24 : [3]str = ["/skate", "/sets", "/sommelier"];
pub const LEGACY_ALIAS_SURFACES_BEFORE_2026_09_24 : [3]str = ["ride", "catalog", "catalog"];
pub const EVENT_PAYLOAD_STAYS_ANSWERABLE : bool = true;
; CORRECTED 2026-09-25: the compatibility set was six paths and is thirteen. On the owner's answer of
; that day (REUSES_LEGACY_RETIREMENT_ID records it and splits the eight legacy paths) seven more
; client paths -- /accessories, /tea, /game, /treasure-hunt, /ar-hunt, /location-quest and
; /tech-tree -- stopped mounting their screens and render the live catalog; each is declared in
; src/ui/routes.rs as before and answered by the handler of the same name there (fn Accessories,
; fn Tea, fn Game, fn TreasureHunt, fn ArHunt, fn LocationQuest, fn TechTree), for the reason this
; set exists: a link already sent never expires. They are appended after the events paths, so every
; index above keeps its member. The adjudication above held again: this set grew by seven, and so did
; turbobaby/legacy-retirement's REPOINTED_ROUTE_COUNT, whose value is that file's and is not
; restated here. The eighth legacy path, /quest/:id, is not a member: the owner kept its screen, so
; it is a live route and not an alias. What a shared accessory or tea payload lands on did not
; change: the shipped landing (SHIPPED_LANDING_SITE) already sent every product kind to the fleet.
pub const LEGACY_ALIAS_COUNT_BEFORE_2026_09_25 : u8 = 6;
pub const LEGACY_ROUTE_ALIASES_BEFORE_2026_09_25 : [6]str = ["/skate", "/sets", "/sommelier", "/events", "/events/:id", "/my-bookings"];
pub const LEGACY_ALIAS_SURFACES_BEFORE_2026_09_25 : [6]str = ["ride", "catalog", "catalog", "catalog", "catalog", "catalog"];
pub const LEGACY_ALIASES_ADDED_ON_2026_09_25 : u8 = 7;

; The counter-member, and it is the more important half. One retired surface is deliberately given
; NO alias and NO parse, because nothing survives behind it to render: src/ui/routes.rs:57-61 draws
; exactly that contrast against the aliased route, src/trios/deeplink.rs:195-201 drops every one of
; its payload shapes to None, and src/trios/deeplink.rs:629-646 gates both halves at once -- the
; parser must refuse it AND the classifier must not answer it, because a button that opens a route
; that no longer exists is worse than no button. Its builders were deleted rather than repointed
; (src/ui/share.rs:271-276, src/ui/app.rs:145-152).
pub const RETIRED_WITHOUT_AN_ALIAS_COUNT : u8 = 1;
pub const A_RETIRED_PAYLOAD_MUST_BE_UNANSWERABLE_BOTH_SIDES : bool = true;

pub fn deeplink_legacy_route_may_be_kept(retirement_keeps_the_route: bool, surviving_surface_is_live: bool) bool {
  return retirement_keeps_the_route and surviving_surface_is_live;
}

; A payload stays answerable only while something live is behind it. When the surface goes, the
; payload goes with it -- on BOTH sides, in one step, which is the whole reason the classifier and
; the parser are one function.
pub fn deeplink_payload_may_stay_answerable(surviving_surface_is_live: bool) bool {
  return surviving_surface_is_live;
}

; --- A link carries a destination, never identity and never money -------------------------------------
; The prohibition is measured, not asserted. One retired payload shape carried an inviter's raw
; telegram id in the payload itself (src/trios/deeplink.rs:97-101): a person-level identifier a
; stranger could type into a link and forward. It is gone, and the surviving invite path carries an
; OPAQUE CODE instead, recorded by the bot against the inviter (src/bot/commands.rs:188-189), never
; by the app and never from the link's own claim. That code is deliberately NOT a Mini App target
; (src/trios/deeplink.rs:262-263, gated at :544-550): answering it with a card would stop the
; referral being recorded at all. Money is excluded the same way -- a shared card's price is read
; from the database server-side and the caller names only which product
; (src/api/share.rs:15-17, :220-227) -- and the one identifier the share endpoint does need travels
; in a POST body, not a query string (src/api/share.rs:31-41, src/ui/share.rs:373). The repository
; also holds a measured leak of the opposite kind, and it is why "never in a URL" is written as a
; rule here: a Bot API URL carries the bot token in its path, and a verbatim error dump put that live
; token in plaintext in the production log (src/api/share.rs:197-213).
pub const LINK_MAY_CARRY_IDENTITY : bool = false;
pub const LINK_MAY_CARRY_MONEY : bool = false;
pub const A_RETIRED_PAYLOAD_CARRIED_A_RAW_TELEGRAM_ID : bool = true;
pub const REFERRAL_TRAVELS_AS_AN_OPAQUE_CODE : bool = true;
pub const REFERRAL_CODE_IS_A_MINIAPP_TARGET : bool = false;
pub const SHARE_ID_TRAVELS_IN_THE_BODY_NOT_THE_QUERY : bool = true;
pub const A_SECRET_IN_A_URL_IS_A_MEASURED_LEAK : bool = true;

pub fn deeplink_payload_may_carry(is_identity: bool, is_money: bool, is_opaque_target_key: bool) bool {
  if (is_identity) {
    return false;
  }
  if (is_money) {
    return false;
  }
  return is_opaque_target_key;
}

; A resolved link is a destination and not an authority. The proof is the owner's subject
; (REUSES_REQUEST_IDENTITY_ID); all this file states is that resolving a link adds nothing to it.
pub fn deeplink_may_act_as_owner(link_resolved: bool, identity_proof_passed: bool) bool {
  if (link_resolved and !identity_proof_passed) {
    return false;
  }
  return identity_proof_passed;
}

; --- The landing screen is localized, and the payload is not ------------------------------------------
; `grep -cin "lang|locale" src/trios/deeplink.rs` returns 0: the grammar has no locale segment, and a
; forwarded link therefore cannot pin a stranger to the sender's language. The locale rides beside the
; payload on the carrying URL instead (src/bot/commands.rs:114-117, one `lang` parameter and one
; `startapp` parameter), and both the Mini App button copy and the fallback welcome are rendered from
; the resolved locale (src/bot/commands.rs:234-244, :290-317). Which locales exist and what an
; unpublished one falls to is REUSES_LOCALE_POLICY_ID's subject, restated nowhere here.
; RE-MEASURED 2026-09-22: the command quoted above was blind to the hits it looks for. It is a basic
; regex, where an unescaped `|` is a literal, so it counts only lines holding the string
; "lang|locale"; a line naming lang or locale alone is not counted (on a three-line probe: -cin 1,
; -ciE 3). The alternation it meant, `grep -ciE "lang|locale" src/trios/deeplink.rs`, also returns
; 0, so the zero below stands. The command this file cited could not see a hit, and this
; re-measurement is the first command in the file's history that could: `git log -S'lang|locale'`
; on this file finds one commit, d1877db, and it wrote the basic form.
pub const PAYLOAD_HAS_A_LOCALE_SEGMENT : bool = false;
pub const PAYLOAD_LOCALE_GREP_HITS : u8 = 0;
pub const TRANSPORT_CARRIES_THE_LOCALE : bool = true;

pub fn deeplink_landing_locale_comes_from_outside_the_payload(payload_has_locale_segment: bool, transport_carries_locale: bool) bool {
  return !payload_has_locale_segment and transport_carries_locale;
}

; --- The whole chain ------------------------------------------------------------------------------------
; One function for the property the module was created to hold: a link works when every stage holds,
; and the absence of any single one is indistinguishable to a customer from the absence of all four.
pub fn deeplink_chain_survives(payload_transportable: bool, payload_parses: bool, app_consumes_target: bool, surviving_surface_is_live: bool) bool {
  return payload_transportable and payload_parses and app_consumes_target and surviving_surface_is_live;
}

; --- Tests -------------------------------------------------------------------------------------------

test deeplink_closes_a_measured_zero_in_the_corpus {
  assert CONTRACTS_BEFORE_THIS_ONE == 20;
  assert CONTRACTS_MENTIONING_DEEPLINK == 0;
  assert CONTRACTS_MENTIONING_STARTAPP == 0;
  assert ZERO_GREP_COMMANDS.len == 2;
}

; The zero is a dated measurement, not a standing property. Asserting that the later count is
; greater is what stops a reader treating the two as the same claim.
test deeplink_the_measured_zero_is_scoped_to_the_corpus_it_was_taken_over {
  assert CONTRACTS_MENTIONING_DEEPLINK_AFTER_THIS_WAVE == 2;
  assert CONTRACTS_MENTIONING_DEEPLINK_AFTER_THIS_WAVE > CONTRACTS_MENTIONING_DEEPLINK;
}

; The wave reading drifted again. Both later figures carry a date and a denominator so that the
; next reader can tell a grown corpus from a broken claim.
test deeplink_the_wave_reading_is_superseded_by_a_dated_one {
  assert CORPUS_FILE_COUNT == 43;
  assert CORPUS_FILES_OTHER_THAN_THIS_ONE == 42;
  assert CORPUS_FILES_OTHER_THAN_THIS_ONE + 1 == CORPUS_FILE_COUNT;
  assert CONTRACTS_MENTIONING_DEEPLINK_2026_09_21 == 7;
  assert CONTRACTS_MENTIONING_DEEPLINK_2026_09_21 > CONTRACTS_MENTIONING_DEEPLINK_AFTER_THIS_WAVE;
  assert CONTRACTS_MENTIONING_DEEPLINK_2026_09_21 < CORPUS_FILES_OTHER_THAN_THIS_ONE;
}

; Corrected 2026-09-22: the dated reading above was taken over 43 files, and the corpus grew to 45
; the same day. Each reading is compared only with the corpus it was taken over.
test deeplink_the_dated_reading_was_re_run_over_the_grown_corpus {
  assert CORPUS_FILE_COUNT_REMEASURED == 45;
  assert CORPUS_FILES_OTHER_THAN_THIS_ONE_REMEASURED == 44;
  assert CORPUS_FILES_OTHER_THAN_THIS_ONE_REMEASURED + 1 == CORPUS_FILE_COUNT_REMEASURED;
  assert CORPUS_FILE_COUNT_REMEASURED_AT == "2026-09-22";
  assert CORPUS_FILE_COUNT_REMEASURED > CORPUS_FILE_COUNT;
  assert CONTRACTS_MENTIONING_DEEPLINK_2026_09_22 == 8;
  assert CONTRACTS_MENTIONING_DEEPLINK_2026_09_22 == CONTRACTS_MENTIONING_DEEPLINK_2026_09_21 + 1;
  assert CONTRACTS_MENTIONING_DEEPLINK_2026_09_22 < CORPUS_FILES_OTHER_THAN_THIS_ONE_REMEASURED;
  assert CONTRACTS_MENTIONING_STARTAPP_2026_09_22 == 0;
  assert CONTRACTS_MENTIONING_STARTAPP_2026_09_22 == CONTRACTS_MENTIONING_STARTAPP;
}

; The startapp zero is the one absence that did NOT move, and it is asserted as its own claim so
; that it never rides along on the deeplink count's coat-tails.
test deeplink_the_startapp_zero_is_the_one_absence_still_standing {
  assert CONTRACTS_MENTIONING_STARTAPP_2026_09_21 == 0;
  assert CONTRACTS_MENTIONING_STARTAPP_2026_09_21 == CONTRACTS_MENTIONING_STARTAPP;
  assert THE_STARTAPP_ZERO_STILL_HOLDS == true;
  assert ZERO_GREP_COMMANDS[1] == "grep -rl startapp specs/";
}

test deeplink_names_its_three_owners_and_restates_none_of_them {
  assert REUSE_EDGE_COUNT == 3;
  assert REUSES_LEGACY_RETIREMENT_ID == "turbobaby/legacy-retirement";
  assert REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity";
  assert REUSES_LOCALE_POLICY_ID == "turbobaby/locale-policy";
}

test deeplink_records_its_one_inbound_edge_and_its_one_co_declared_fact {
  assert CONSUMERS.len == CONSUMER_COUNT;
  assert CONSUMERS[0] == "turbobaby/promo-broadcast";
  assert CONSUMERS[0] != ID;
  assert CO_DECLARED_FACT_COUNT == 1;
  assert REFERRAL_CODE_IS_A_MINIAPP_TARGET == false;
}

; The inbound edge count grew from one to five while nothing here was edited. Every member is
; asserted by name, so a consumer that drops its edge fails this test instead of leaving the
; count quietly too high.
test deeplink_has_five_consumers_not_the_one_it_was_written_with {
  assert CONSUMER_COUNT == 5;
  assert CONSUMER_COUNT_WHEN_THIS_FILE_WAS_WRITTEN == 1;
  assert CONSUMER_COUNT > CONSUMER_COUNT_WHEN_THIS_FILE_WAS_WRITTEN;
  assert CONSUMERS.len == CONSUMER_COUNT;
  assert CONSUMERS[1] == "turbobaby/customer-surface";
  assert CONSUMERS[2] == "turbobaby/notification-queue";
  assert CONSUMERS[3] == "turbobaby/referral-program";
  assert CONSUMERS[4] == "turbobaby/webapp-bridge";
  assert CONSUMERS[4] != ID;
  assert CONSUMERS_MEASURED_AT == "2026-09-21";
  assert CONSUMER_EDGE_DECLARATION == "REUSES_DEEPLINK_ID";
}

; The co-declarer is NOT a consumer, and the two are counted separately on purpose.
test deeplink_the_co_declared_fact_names_an_id_and_a_declaration_not_a_line {
  assert CO_DECLARED_FACT_OWNER_ID == "turbobaby/bot-surface";
  assert CO_DECLARED_FACT_OWNER_ID != ID;
  assert CO_DECLARED_FACT_DECLARATION == "REFERRAL_PAYLOAD_IS_A_MINIAPP_TARGET";
  assert CO_DECLARER_CARRIES_NO_EDGE_BACK == true;
  assert CO_DECLARED_FACT_OWNER_ID != CONSUMERS[0];
  assert BOT_SURFACE_GRAMMAR_DECLARATIONS.len == 2;
  assert BOT_SURFACE_GRAMMAR_DECLARATIONS[0] == "REFERRAL_PREFIX";
  assert BOT_SURFACE_GRAMMAR_DECLARATIONS[1] == "REFERRAL_CODE_MAX_LEN";
}

test deeplink_pipeline_has_four_stages_owned_by_two_halves {
  assert STAGE_NAMES.len == STAGE_COUNT;
  assert STAGE_NAMES[0] == "build";
  assert STAGE_NAMES[1] == "classify";
  assert STAGE_NAMES[2] == "carry";
  assert STAGE_NAMES[3] == "parse";
  assert deeplink_stage_is_known(0) == false;
  assert deeplink_stage_is_known(STAGE_BUILD) == true;
  assert deeplink_stage_is_known(STAGE_PARSE) == true;
  assert deeplink_stage_is_known(5) == false;
}

test deeplink_the_bot_owns_the_middle_two_stages_and_only_those {
  assert deeplink_stage_owner(STAGE_BUILD) == OWNER_MINIAPP;
  assert deeplink_stage_owner(STAGE_CLASSIFY) == OWNER_BOT;
  assert deeplink_stage_owner(STAGE_CARRY) == OWNER_BOT;
  assert deeplink_stage_owner(STAGE_PARSE) == OWNER_MINIAPP;
  assert deeplink_stage_owner(0) == OWNER_NONE;
  assert deeplink_stage_owner(5) == OWNER_NONE;
}

test deeplink_build_refuses_rather_than_emitting_a_link_that_cannot_travel {
  assert deeplink_build_emits_a_link(true, true) == true;
  assert deeplink_build_emits_a_link(true, false) == false;
  assert deeplink_build_emits_a_link(false, true) == false;
  assert deeplink_build_emits_a_link(false, false) == false;
}

test deeplink_classifier_and_parser_cannot_disagree {
  assert CLASSIFIER_DELEGATES_TO_THE_PARSER == true;
  assert CLASSIFIER_HELD_A_SECOND_LIST_ONCE == true;
  assert PAYLOADS_THE_TWO_LISTS_DISAGREED_ON == 12;
  assert PAYLOAD_SWEEP_SIZE == 46;
  assert deeplink_bot_answers_with_miniapp_button(true) == true;
  assert deeplink_bot_answers_with_miniapp_button(false) == false;
  assert deeplink_classifier_agrees_with_parser(true) == true;
  assert deeplink_classifier_agrees_with_parser(false) == true;
}

test deeplink_payload_grammar_is_bounded_at_both_ends_and_by_character_class {
  assert PAYLOAD_LIMITS_ARE_TELEGRAMS_NOT_OURS == true;
  assert PAYLOAD_CHAR_CLASS == "A-Za-z0-9_-";
  assert deeplink_payload_transportable(0, true) == false;
  assert deeplink_payload_transportable(1, true) == true;
  assert deeplink_payload_transportable(64, true) == true;
  assert deeplink_payload_transportable(65, true) == false;
  assert deeplink_payload_transportable(32, false) == false;
  assert deeplink_payload_transportable(0, false) == false;
}

test deeplink_attribution_segment_is_bounded_more_tightly_than_the_payload {
  assert SOURCE_SEPARATOR == "__";
  assert SOURCE_SEGMENT_MAX_LEN < PAYLOAD_MAX_LEN;
  assert deeplink_source_segment_usable(0, true) == false;
  assert deeplink_source_segment_usable(1, true) == true;
  assert deeplink_source_segment_usable(50, true) == true;
  assert deeplink_source_segment_usable(51, true) == false;
  assert deeplink_source_segment_usable(10, false) == false;
}

test deeplink_target_and_prefix_vocabularies_are_closed {
  assert TARGET_NAMES.len == TARGET_COUNT;
  assert TARGET_NAMES[0] == "product";
  assert TARGET_NAMES[4] == "referrals";
  assert PRODUCT_PREFIXES.len == PRODUCT_PREFIX_COUNT;
  assert PRODUCT_PREFIXES[0] == "p_strain";
  assert PRODUCT_PREFIXES[4] == "p_event";
  assert NON_PRODUCT_WIRE_SHAPES.len == NON_PRODUCT_SHAPE_COUNT;
  assert NON_PRODUCT_WIRE_SHAPES[0] == "cart";
  assert PREFIX_IS_STRIPPED_NOT_SPLIT == true;
  assert A_BARE_PREFIX_WITH_NO_ID_IS_REFUSED == true;
}

test deeplink_every_failure_reaches_a_named_screen {
  assert deeplink_landing(false, false) == LANDING_BOT_WELCOME;
  assert deeplink_landing(false, true) == LANDING_BOT_WELCOME;
  assert deeplink_landing(true, false) == LANDING_APP_ROOT;
  assert deeplink_landing(true, true) == LANDING_TARGET_SCREEN;
  assert deeplink_landing_is_known(deeplink_landing(false, false)) == true;
  assert deeplink_landing_is_known(deeplink_landing(true, false)) == true;
  assert deeplink_landing_is_known(deeplink_landing(true, true)) == true;
  assert deeplink_landing_is_known(LANDING_NONE) == false;
  assert deeplink_landing_is_known(4) == false;
}

test deeplink_a_promised_target_that_is_not_consumed_is_the_named_defect {
  assert deeplink_is_a_dead_tap(true, false) == true;
  assert deeplink_is_a_dead_tap(true, true) == false;
  assert deeplink_is_a_dead_tap(false, false) == false;
  assert deeplink_is_a_dead_tap(false, true) == false;
}

test deeplink_one_declared_target_in_five_has_no_landing_today {
  assert TARGETS_DECLARED == TARGET_COUNT;
  assert TARGETS_WITH_A_LIVE_LANDING == 4;
  assert TARGETS_WITH_A_LIVE_LANDING < TARGETS_DECLARED;
  assert UNCONSUMED_TARGET_NAME == "referrals";
  assert DESTINATION_TABLE_HAS_A_PRODUCTION_CALLER == false;
  assert TWO_LANDING_TABLES_DISAGREE == true;
  assert THE_DISAGREEMENT_IS_UNREACHABLE_BY_THE_HOST_SUITE == true;
  assert WHICH_SCREEN_A_KIND_LANDS_ON_IS_NOT_DECLARED_HERE == true;
}

test deeplink_compatibility_set_keeps_three_paths_on_live_surfaces {
  // Three paths until 2026-09-24; the three events paths made it six, and the seven legacy paths
  // of 2026-09-25 made it thirteen. The name is the old reading.
  assert LEGACY_ROUTE_ALIASES.len == LEGACY_ALIAS_COUNT;
  assert LEGACY_ALIAS_SURFACES.len == LEGACY_ALIAS_COUNT;
  assert LEGACY_ALIAS_COUNT == 13;
  assert LEGACY_ALIAS_COUNT_BEFORE_2026_09_25 == 6;
  assert LEGACY_ROUTE_ALIASES_BEFORE_2026_09_25.len == LEGACY_ALIAS_COUNT_BEFORE_2026_09_25;
  assert LEGACY_ALIAS_SURFACES_BEFORE_2026_09_25.len == LEGACY_ALIAS_COUNT_BEFORE_2026_09_25;
  assert LEGACY_ALIAS_COUNT == LEGACY_ALIAS_COUNT_BEFORE_2026_09_25 + LEGACY_ALIASES_ADDED_ON_2026_09_25;
  assert LEGACY_ROUTE_ALIASES[6] == "/accessories";
  assert LEGACY_ROUTE_ALIASES[8] == "/game";
  assert LEGACY_ROUTE_ALIASES[12] == "/tech-tree";
  assert LEGACY_ALIAS_SURFACES[6] == "catalog";
  assert LEGACY_ALIAS_SURFACES[8] == "catalog";
  assert LEGACY_ALIAS_SURFACES[12] == "catalog";
  assert LEGACY_ALIAS_COUNT_BEFORE_2026_09_24 == 3;
  assert LEGACY_ROUTE_ALIASES_BEFORE_2026_09_24.len == LEGACY_ALIAS_COUNT_BEFORE_2026_09_24;
  assert LEGACY_ALIAS_SURFACES_BEFORE_2026_09_24.len == LEGACY_ALIAS_COUNT_BEFORE_2026_09_24;
  assert LEGACY_ROUTE_ALIASES[0] == "/skate";
  assert LEGACY_ALIAS_SURFACES[0] == "ride";
  assert LEGACY_ALIAS_SURFACES[1] == "catalog";
  assert LEGACY_ALIAS_SURFACES[2] == "catalog";
  assert LEGACY_ROUTE_ALIASES[3] == "/events";
  assert LEGACY_ROUTE_ALIASES[5] == "/my-bookings";
  assert LEGACY_ALIAS_SURFACES[3] == "catalog";
  assert LEGACY_ALIAS_SURFACES[4] == "catalog";
  assert LEGACY_ALIAS_SURFACES[5] == "catalog";
  assert EVENT_PAYLOAD_STAYS_ANSWERABLE == true;
  assert deeplink_payload_may_stay_answerable(true) == EVENT_PAYLOAD_STAYS_ANSWERABLE;
  assert A_LEGACY_ALIAS_NEVER_MOUNTS_THE_RETIRED_SCREEN == true;
  assert LEGACY_LINKS_DO_NOT_EXPIRE == true;
}

test deeplink_a_path_is_kept_only_when_both_owners_agree {
  assert deeplink_legacy_route_may_be_kept(true, true) == true;
  assert deeplink_legacy_route_may_be_kept(true, false) == false;
  assert deeplink_legacy_route_may_be_kept(false, true) == false;
  assert deeplink_legacy_route_may_be_kept(false, false) == false;
}

test deeplink_a_dead_surface_takes_its_payload_with_it {
  assert RETIRED_WITHOUT_AN_ALIAS_COUNT == 1;
  assert A_RETIRED_PAYLOAD_MUST_BE_UNANSWERABLE_BOTH_SIDES == true;
  assert deeplink_payload_may_stay_answerable(true) == true;
  assert deeplink_payload_may_stay_answerable(false) == false;
}

test deeplink_a_link_carries_a_destination_and_nothing_personal {
  assert LINK_MAY_CARRY_IDENTITY == false;
  assert LINK_MAY_CARRY_MONEY == false;
  assert A_RETIRED_PAYLOAD_CARRIED_A_RAW_TELEGRAM_ID == true;
  assert REFERRAL_TRAVELS_AS_AN_OPAQUE_CODE == true;
  assert REFERRAL_CODE_IS_A_MINIAPP_TARGET == false;
  assert SHARE_ID_TRAVELS_IN_THE_BODY_NOT_THE_QUERY == true;
  assert A_SECRET_IN_A_URL_IS_A_MEASURED_LEAK == true;
  assert deeplink_payload_may_carry(false, false, true) == true;
  assert deeplink_payload_may_carry(true, false, true) == false;
  assert deeplink_payload_may_carry(false, true, true) == false;
  assert deeplink_payload_may_carry(false, false, false) == false;
}

test deeplink_resolving_a_link_grants_no_authority {
  assert deeplink_may_act_as_owner(true, false) == false;
  assert deeplink_may_act_as_owner(true, true) == true;
  assert deeplink_may_act_as_owner(false, true) == true;
  assert deeplink_may_act_as_owner(false, false) == false;
}

test deeplink_locale_rides_beside_the_payload_never_inside_it {
  assert PAYLOAD_HAS_A_LOCALE_SEGMENT == false;
  assert PAYLOAD_LOCALE_GREP_HITS == 0;
  assert TRANSPORT_CARRIES_THE_LOCALE == true;
  assert deeplink_landing_locale_comes_from_outside_the_payload(false, true) == true;
  assert deeplink_landing_locale_comes_from_outside_the_payload(true, true) == false;
  assert deeplink_landing_locale_comes_from_outside_the_payload(false, false) == false;
}

test deeplink_the_chain_is_conjunctive_and_every_gap_looks_the_same {
  assert deeplink_chain_survives(true, true, true, true) == true;
  assert deeplink_chain_survives(false, true, true, true) == false;
  assert deeplink_chain_survives(true, false, true, true) == false;
  assert deeplink_chain_survives(true, true, false, true) == false;
  assert deeplink_chain_survives(true, true, true, false) == false;
}

; --- Invariants ----------------------------------------------------------------------------------------

invariant deeplink_this_file_closes_a_measured_zero
  assert CONTRACTS_MENTIONING_DEEPLINK == 0 and CONTRACTS_MENTIONING_STARTAPP == 0

; The zero above is HISTORICAL and the invariant below is what keeps it from being read as
; current: the deeplink count has grown past it and is never again allowed to equal it, while
; the startapp zero is asserted separately because it is the one that genuinely still holds.
invariant deeplink_the_historical_zero_is_never_mistaken_for_todays_count
  assert CONTRACTS_MENTIONING_DEEPLINK_2026_09_21 > CONTRACTS_MENTIONING_DEEPLINK and CONTRACTS_MENTIONING_STARTAPP_2026_09_21 == CONTRACTS_MENTIONING_STARTAPP

invariant deeplink_every_inbound_edge_is_counted_from_both_ends
  assert CONSUMERS.len == CONSUMER_COUNT and CONSUMER_COUNT > CONSUMER_COUNT_WHEN_THIS_FILE_WAS_WRITTEN and CO_DECLARER_CARRIES_NO_EDGE_BACK == true

invariant deeplink_the_pipeline_has_exactly_four_stages
  assert STAGE_NAMES.len == STAGE_COUNT and deeplink_stage_is_known(STAGE_PARSE) == true and deeplink_stage_is_known(5) == false

invariant deeplink_the_classifier_can_never_diverge_from_the_parser
  assert deeplink_classifier_agrees_with_parser(true) == true and deeplink_classifier_agrees_with_parser(false) == true

invariant deeplink_an_untransportable_payload_is_never_built_into_a_link
  assert deeplink_build_emits_a_link(true, false) == false and deeplink_payload_transportable(65, true) == false and deeplink_payload_transportable(0, true) == false

invariant deeplink_the_character_class_is_a_gate_no_length_can_open
  assert deeplink_payload_transportable(PAYLOAD_MIN_LEN, false) == false and deeplink_payload_transportable(PAYLOAD_MAX_LEN, false) == false

invariant deeplink_the_attribution_segment_can_never_fill_the_payload
  assert SOURCE_SEGMENT_MAX_LEN < PAYLOAD_MAX_LEN and deeplink_source_segment_usable(51, true) == false

invariant deeplink_every_outcome_is_a_named_screen
  assert deeplink_landing_is_known(deeplink_landing(false, false)) == true and deeplink_landing_is_known(deeplink_landing(true, false)) == true and deeplink_landing_is_known(deeplink_landing(true, true)) == true

invariant deeplink_an_unparseable_payload_never_reaches_the_app
  assert deeplink_landing(false, true) == LANDING_BOT_WELCOME and deeplink_landing(false, false) == LANDING_BOT_WELCOME

invariant deeplink_a_promised_target_with_no_consumer_is_a_defect_not_a_landing
  assert deeplink_is_a_dead_tap(true, false) == true and deeplink_landing(true, false) != LANDING_TARGET_SCREEN

invariant deeplink_the_corpus_records_that_one_target_is_still_unconsumed
  assert TARGETS_WITH_A_LIVE_LANDING < TARGETS_DECLARED and DESTINATION_TABLE_HAS_A_PRODUCTION_CALLER == false

invariant deeplink_a_legacy_alias_is_kept_only_over_a_live_surface
  assert deeplink_legacy_route_may_be_kept(true, false) == false and LEGACY_ALIAS_SURFACES.len == LEGACY_ALIAS_COUNT

invariant deeplink_a_retired_surface_leaves_no_answerable_payload_behind
  assert deeplink_payload_may_stay_answerable(false) == false and A_RETIRED_PAYLOAD_MUST_BE_UNANSWERABLE_BOTH_SIDES == true

invariant deeplink_no_link_ever_carries_identity_or_money
  assert LINK_MAY_CARRY_IDENTITY == false and LINK_MAY_CARRY_MONEY == false and deeplink_payload_may_carry(true, false, true) == false and deeplink_payload_may_carry(false, true, true) == false

invariant deeplink_a_resolved_link_is_not_a_proof_of_identity
  assert deeplink_may_act_as_owner(true, false) == false

invariant deeplink_the_payload_never_pins_a_language
  assert PAYLOAD_HAS_A_LOCALE_SEGMENT == false and deeplink_landing_locale_comes_from_outside_the_payload(true, true) == false

invariant deeplink_every_stage_is_load_bearing
  assert deeplink_chain_survives(false, true, true, true) == false and deeplink_chain_survives(true, false, true, true) == false and deeplink_chain_survives(true, true, false, true) == false and deeplink_chain_survives(true, true, true, false) == false

invariant deeplink_every_alias_of_a_retired_events_path_lands_on_the_catalog
  assert LEGACY_ALIAS_SURFACES[3] == "catalog" and LEGACY_ALIAS_SURFACES[4] == "catalog" and LEGACY_ALIAS_SURFACES[5] == "catalog" and LEGACY_ALIAS_COUNT_BEFORE_2026_09_25 == 6

invariant deeplink_every_alias_of_a_previous_shop_path_lands_on_the_catalog
  assert LEGACY_ALIAS_SURFACES[6] == "catalog" and LEGACY_ALIAS_SURFACES[7] == "catalog" and LEGACY_ALIAS_SURFACES[8] == "catalog" and LEGACY_ALIAS_SURFACES[9] == "catalog" and LEGACY_ALIAS_SURFACES[10] == "catalog" and LEGACY_ALIAS_SURFACES[11] == "catalog" and LEGACY_ALIAS_SURFACES[12] == "catalog" and LEGACY_ALIAS_COUNT == 13
