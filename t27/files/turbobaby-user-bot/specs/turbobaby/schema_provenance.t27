pub const MEASURED_AT : str = "2026-09-21";
pub const DECISION_RECORD : str = "DECISIONS.md";
pub const RUNNER_IMPLEMENTATION : str = "src/db/mod.rs";
pub const FAIL_OPEN_MACRO_IMPLEMENTATION : str = "src/db/macros.rs";
pub const SEED_GATE : str = "scripts/verify_fleet_seed.py";
pub const SPEC_GATE : str = "scripts/verify_t27_specs.py";

; --- Reuse edges ---------------------------------------------------------------------------
; Each of these owns a table of numbers this file deliberately does not carry. The seed gate
; compares the market block to market_profile.t27's constants and the seeded rows to the JSON;
; what those rows SAY about the fleet is availability.t27's and bike_catalog.t27's decision, and
; how an absent price renders is pricing_honesty.t27's. publication.t27 owns the compiler and
; scanner evidence rules, including the probe floor whose shape D16 names.
pub const REUSES_MARKET_ID : str = "turbobaby/market";
pub const REUSES_AVAILABILITY_ID : str = "turbobaby/availability";
pub const REUSES_CATALOG_ID : str = "turbobaby/bike-catalog";
pub const REUSES_PRICING_HONESTY_ID : str = "turbobaby/pricing-honesty";
pub const REUSES_PUBLICATION_ID : str = "turbobaby/publication";
; ADDED at review 2026-09-21, and it was a missing edge rather than an absent subject. This file
; names two observability artefacts on its own pages: the Prometheus gauge schema_missing_columns
; (BOOT_HALT_NOTE, set at src/main.rs:460) and the tracing log target db.schema_drift
; (FAIL_OPEN_EVIDENCE, emitted inside src/db/macros.rs:28-44). turbobaby/observability owns the
; rule that a metric name exists only where the binary emits it, and the naming rule for a gauge
; or a counter; what this file owns is the VALUE that gauge carries and the fact that the log
; target is the only evidence a fail-open read leaves behind. That contract already names this
; one from its side, as NEIGHBOUR_SCHEMA_PROVENANCE_ID, so the edge existed in one direction
; only and this declaration closes it. No metric name is coined here and none is restated.
pub const REUSES_OBSERVABILITY_ID : str = "turbobaby/observability";

; --- The sequence law (D1, D2) ---------------------------------------------------------------
; ls migrations/*.sql | wc -l -> 86, and the numeric prefixes run 001..086 with no gap and no
; duplicate (verified by sorting the prefixes: first 001, last 086, count 86, no index mismatch).
; wc -l migrations/*.sql -> 4271 total. src/db/mod.rs:29 holds the same 86 as include_str!
; entries, so disk and code agree by count as well as by name.
; CORRECTED 2026-09-24: 87 files, 001..087, 4362 lines, and 87 include_str! entries.
; migrations/087_delivery_zones_phuket.sql (91 lines) carries the owner's Phuket delivery zones
; (turbobaby/delivery-terms) and took the next free number, as D1 requires. Every src/db/mod.rs
; line this file cites past line 385 moved four lines down with it and is re-pointed; the old
; numbers are the new ones minus four. The 2026-09-21 census is kept under _BEFORE_087 names.
; CORRECTED 2026-09-24, the same day: 88 files, 001..088, 4387 lines, and 88 include_str!
; entries. migrations/088_unpublish_events.sql (25 lines) hides every event still public, on
; the owner's rental-only ruling (turbobaby/events-booking), and took the next free number. Its
; MIGRATIONS entry moved every src/db/mod.rs line past 389 four more lines, so the citations
; below are re-measured after both insertions. The census between the two changes is kept under
; _BEFORE_088 names, and the one before either under _BEFORE_087.
; CORRECTED 2026-09-26: 89 files, 001..089, 4462 lines, and 89 include_str! entries.
; migrations/089_referral_credit.sql (75 lines) creates the referral credit's three tables on the
; owner's R3 answer (turbobaby/referral-credit) and took the next free number; it creates only,
; reading and writing no existing row. Its MIGRATIONS entry moved every src/db/mod.rs line past
; 393 four lines down, and the citations below are re-pinned. The census before it is kept under
; _BEFORE_089 names.
