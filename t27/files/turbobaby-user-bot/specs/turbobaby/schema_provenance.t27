pub const SQL_FILES_RECURSIVE_BEFORE_089 : u8 = 89;
pub const SQL_FILES_TOP_LEVEL_BEFORE_088 : u8 = 87;
pub const SQL_FILES_RECURSIVE_BEFORE_088 : u8 = 88;
pub const SQL_FILES_TOP_LEVEL_BEFORE_087 : u8 = 86;
pub const SQL_FILES_RECURSIVE_BEFORE_087 : u8 = 87;
