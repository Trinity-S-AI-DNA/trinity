; --- The clamp, modelled without a float -------------------------------------------------------
; No contract in this corpus declares an f64, and inventing one here would imply an arithmetic
; the gate cannot check. RE-RUN 2026-09-21 at review, because an absence measured over specs/
; while the corpus was still being written is the one claim in this file that could have gone
; false without anyone noticing: a grep of all 43 .t27 files for a declaration typed f64 returns
; 0, so the sentence holds. It holds as of that reading and not for ever -- several siblings
; discuss f64 in prose, about floats in src/, and any one of them could declare one tomorrow.
; So the two facts a float carries are split: finiteness is a boolean the caller supplies, and
; magnitude is an integer in hundredths of a unit. NaN and both infinities collapse into
; finite = false, which is precisely the distinction clamp_finite_in_range makes at
; src/trios/validation.rs:204 with v.is_finite().
pub const CORPUS_FILES_MEASURED_FOR_F64 : u8 = 43;
pub const F64_DECLARATIONS_IN_CORPUS : u8 = 0;
pub const F64_ABSENCE_WAS_RE_RUN_AT_REVIEW : bool = true;
pub const SCALE_PER_UNIT : i32 = 100;
pub const LAT_MIN_CENTI : i32 = -9000;
pub const LAT_MAX_CENTI : i32 = 9000;
pub const LON_MIN_CENTI : i32 = -18000;
pub const LON_MAX_CENTI : i32 = 18000;
; The fallback every live call site passes (src/api/quest.rs:95, :96, :276, :282).
pub const READ_PATH_FALLBACK_CENTI : i32 = 0;
; From the shipped regression tests. src/trios/validation.rs:495-504 uses a capital city to prove
; the cycle #147 fix -- a legitimately negative coordinate must survive -- and :486 uses the first
; value past the ceiling (:460 until 2c21df1 moved the file, re-read 2026-09-22).
pub const SOUTHERN_SAMPLE_LAT_CENTI : i32 = -4129;
pub const SOUTHERN_SAMPLE_LON_CENTI : i32 = 17478;
pub const JUST_ABOVE_THE_CEILING_LAT_CENTI : i32 = 9010;

pub const CLAMP_OUT_UNSET : u8 = 0;
pub const CLAMP_OUT_PASSTHROUGH : u8 = 1;
pub const CLAMP_OUT_SUBSTITUTED : u8 = 2;
pub const CLAMP_OUTCOME_COUNT : u8 = 2;

; src/trios/validation.rs:203-209. Finite AND within the inclusive interval is the only
; passthrough; everything else -- NaN, either infinity, below the floor, above the ceiling --
; takes the fallback.
pub fn clamp_outcome(finite: bool, value: i32, min: i32, max: i32) u8 {
    if (!finite) {
        return CLAMP_OUT_SUBSTITUTED;
    }
    if (value < min) {
        return CLAMP_OUT_SUBSTITUTED;
    }
    if (value > max) {
        return CLAMP_OUT_SUBSTITUTED;
    }
    return CLAMP_OUT_PASSTHROUGH;
}

pub fn clamp_result(finite: bool, value: i32, min: i32, max: i32, fallback: i32) i32 {
    if (clamp_outcome(finite, value, min, max) == CLAMP_OUT_PASSTHROUGH) {
        return value;
    }
    return fallback;
}

; The function the NAME promises, kept here only so the difference is checkable. A clamp maps an
; out-of-range value to the nearest bound; clamp_finite_in_range maps it to a fourth argument
; that need not be near anything. The shipped test at src/trios/validation.rs:486 asserts the
; substituting behaviour, so this is not a defect in the code, it is a defect in the name -- and
; the name is what a call site reads.
pub fn saturating_result(finite: bool, value: i32, min: i32, max: i32, fallback: i32) i32 {
    if (!finite) {
        return fallback;
    }
    if (value < min) {
        return min;
    }
    if (value > max) {
        return max;
    }
    return value;
}

pub const SHARED_CLAMP_SATURATES_AT_THE_BOUND : bool = false;
pub const SHARED_CLAMP_SUBSTITUTES_A_FOURTH_ARGUMENT : bool = true;

; The trap, stated as a predicate rather than as prose. When the fallback is itself a value the
; interval admits, the substituted output is a legal reading, and no consumer downstream can
; separate it from a measurement. Zero is inside every one of the four live intervals.
pub fn fallback_is_a_legal_reading(fallback: i32, min: i32, max: i32) bool {
    return fallback >= min and fallback <= max;
}

pub fn substitution_is_undetectable(finite: bool, value: i32, min: i32, max: i32, fallback: i32) bool {
    return clamp_outcome(finite, value, min, max) == CLAMP_OUT_SUBSTITUTED and fallback_is_a_legal_reading(fallback, min, max);
}

; --- The non-negative companion ---------------------------------------------------------------
; src/trios/validation.rs:225-231, one caller, at src/db/orders.rs:1186, on revenue. Its floor is
; a true clamp for a negative input and a substitution for a non-finite one, and in both cases
; the output is zero, which for a revenue figure is an ordinary quiet day. Same trap, money slot.
pub const NON_NEGATIVE_FLOOR : i32 = 0;

pub fn non_negative_result(finite: bool, value: i32) i32 {
    if (!finite) {
        return NON_NEGATIVE_FLOOR;
    }
    if (value < NON_NEGATIVE_FLOOR) {
        return NON_NEGATIVE_FLOOR;
    }
    return value;
}

pub fn non_negative_substituted(finite: bool, value: i32) bool {
    return !finite or value < NON_NEGATIVE_FLOOR;
}

; --- The boundary: where a clamp is legitimate --------------------------------------------------
; This is the point of the file. A clamp is legitimate on a BOUNDED CONTROL INPUT, where the
; interval is the definition of the quantity rather than a guess about it, where the caller
; supplying an out-of-range value is a synthetic caller rather than a damaged measurement, and
; where the output steers something and is never shown to anyone. The ride runtime contract owns
; that case and its bounds; this file names the edge and copies nothing.
; A clamp is FORBIDDEN on anything a customer reads as a fact and on anything anyone reads as
; money, because there the interval is a sanity check over a measurement, and a value failing it
; is evidence that the measurement is unknown -- which is the one thing the output can no longer
; say.
pub const USE_UNSET : u8 = 0;
pub const USE_BOUNDED_CONTROL : u8 = 1;
pub const USE_PUBLISHED_FACT : u8 = 2;
pub const USE_PUBLISHED_MONEY : u8 = 3;
pub const USE_KIND_COUNT : u8 = 3;
pub const USE_KIND_NAMES : [3]str = ["bounded_control", "published_fact", "published_money"];

pub fn clamp_is_legitimate(use_kind: u8) bool {
    return use_kind == USE_BOUNDED_CONTROL;
}

pub fn use_kind_is_published(use_kind: u8) bool {
    return use_kind == USE_PUBLISHED_FACT or use_kind == USE_PUBLISHED_MONEY;
}

; The rule, and the whole reason the file exists: a substituted value may never become a
; published number. A control value never reaches a published slot at all -- it is steering, not
; a fact -- and an unset use is refused rather than guessed.
pub fn value_may_reach_a_published_slot(use_kind: u8, was_substituted: bool) bool {
    if (use_kind == USE_UNSET) {
        return false;
    }
    if (use_kind == USE_BOUNDED_CONTROL) {
        return false;
    }
    return !was_substituted;
}

pub fn clamp_call_is_permitted(use_kind: u8, fallback: i32, min: i32, max: i32) bool {
    if (clamp_is_legitimate(use_kind)) {
        return true;
    }
    return !fallback_is_a_legal_reading(fallback, min, max);
}

; --- What the published slot should hold instead -------------------------------------------------
; Absence, and the rendering of absence, is the pricing contract's decision; this file only
; routes to it. There is deliberately no function from SLOT_ABSENT to a number anywhere below.
pub const SLOT_UNSET : u8 = 0;
pub const SLOT_ABSENT : u8 = 1;
pub const SLOT_MEASURED : u8 = 2;
pub const SLOT_KIND_COUNT : u8 = 2;
pub const NO_FUNCTION_FROM_ABSENCE_TO_A_NUMBER : bool = true;

pub fn published_slot(finite: bool, value: i32, min: i32, max: i32) u8 {
    if (clamp_outcome(finite, value, min, max) == CLAMP_OUT_PASSTHROUGH) {
        return SLOT_MEASURED;
    }
    return SLOT_ABSENT;
}

; --- The honest counterexample, already shipped ---------------------------------------------------
; src/ui/screens/admin_screen.rs:379-384 is the shape a money field gets right today: an empty
; input is ABSENT rather than zero, and a present-but-bad input is REFUSED with the field named,
; never replaced. It reaches parse_finite_float_in_range (src/trios/validation.rs:170-190), which
; rejects empty, malformed, NaN, both infinities and out-of-range alike. The ceilings that
; function is called with belong to the catalog write contract, so only the SHAPE is pinned here.
pub const PARSE_UNSET : u8 = 0;
pub const PARSE_ABSENT : u8 = 1;
pub const PARSE_REFUSED : u8 = 2;
pub const PARSE_ADMITTED : u8 = 3;
pub const PARSE_OUTCOME_COUNT : u8 = 3;
pub const EMPTY_INPUT_IS_ABSENCE_NOT_ZERO : bool = true;

pub fn parse_outcome(nonempty_after_trim: bool, parsed: bool, finite: bool, value: i32, min: i32, max: i32) u8 {
    if (!nonempty_after_trim) {
        return PARSE_ABSENT;
    }
    if (!parsed) {
        return PARSE_REFUSED;
    }
    if (!finite) {
        return PARSE_REFUSED;
    }
    if (value < min) {
        return PARSE_REFUSED;
    }
    if (value > max) {
        return PARSE_REFUSED;
    }
    return PARSE_ADMITTED;
}

pub fn parse_invented_a_number(nonempty_after_trim: bool, parsed: bool, finite: bool, value: i32, min: i32, max: i32) bool {
    return parse_outcome(nonempty_after_trim, parsed, finite, value, min, max) == PARSE_UNSET;
}

; --- The QR token grammar ------------------------------------------------------------------------
; src/trios/validation.rs:69-81. Exactly sixteen characters, every one ASCII alphanumeric. The
; grammar is pinned by a count and a class predicate and never by an example, because a spec is a
; public file and a plausible sixteen-character token is a guess at a real one.
pub const SHARED_TOKEN_EXACT_CHARS : u16 = 16;
pub const SHARED_TOKEN_ALPHABET_SIZE : u16 = 62;
pub const SHARED_TOKEN_LENGTH_IS_EXACT_NOT_A_CEILING : bool = true;
; The shipped length test counts BYTES, not characters: src/trios/validation.rs:70 is
; s.len() != 16 and Rust str::len returns UTF-8 bytes. On the strict grammar the two numbers
; coincide for every string it ADMITS, because :49 then requires every character ASCII
; alphanumeric and an ASCII character is one byte -- so the model below is exact here. The unit
; is recorded anyway, because the live grammar further down has no alphabet check and the two
; numbers part company there.
pub const SHARED_TOKEN_LENGTH_IS_MEASURED_IN_BYTES : bool = true;
pub const SHARED_TOKEN_BYTES_AND_CHARS_COINCIDE_ON_ADMITTED_STRINGS : bool = true;
pub const TOKEN_FIXTURE_IS_REFUSED : bool = true;
pub const TOKEN_FIXTURE_NOTE : str = "No token literal appears in this file. The shipped unit test carries one at src/trios/validation.rs:326 because it must call the function; a spec must not, because a spec is read by people looking for the shape of a valid token. The count and the alphabet size say everything the grammar says.";

pub fn shared_token_admits(char_count: u16, all_ascii_alphanumeric: bool) bool {
    return char_count == SHARED_TOKEN_EXACT_CHARS and all_ascii_alphanumeric;
}

; src/api/quest.rs:617-626 -- the grammar the live scan endpoint actually applies before the token
; reaches a parameterised lookup at :644-648. Non-empty, at most two hundred characters, no
; alphabet check of any kind, and two accepted body keys with a fixed precedence.
pub const LIVE_TOKEN_MIN_CHARS : u16 = 1;
pub const LIVE_TOKEN_MAX_CHARS : u16 = 200;
pub const LIVE_TOKEN_CHECKS_THE_ALPHABET : bool = false;
pub const LIVE_TOKEN_BODY_KEY_COUNT : u8 = 2;
pub const LIVE_TOKEN_BODY_KEYS : [2]str = ["qr_token", "code"];
pub const LIVE_TOKEN_KEY_PRECEDENCE_IS_TESTED : bool = true;
pub const SHARED_GRAMMAR_IS_ENFORCED_ON_THE_LIVE_PATH : bool = false;
pub const SHARED_TOKEN_VALIDATOR_CALL_SITES : u8 = 0;
; src/api/quest.rs:622 is token.len() > 200, so the live ceiling is 200 BYTES, and with no
; alphabet check anywhere on this path a multibyte token reaches it. A 200-CHARACTER token of
; two-byte characters is 400 bytes and is refused, although live_token_admits(200) below says
; admitted. That function is therefore a model of the byte length; this pair of booleans states
; the difference rather than re-reading the source as if it counted characters.
pub const LIVE_TOKEN_LENGTH_IS_MEASURED_IN_BYTES : bool = true;
pub const LIVE_TOKEN_MODEL_ASSUMES_ONE_BYTE_PER_CHARACTER : bool = true;
pub const LIVE_TOKEN_ALPHABET_CHECK_WOULD_MAKE_THE_UNITS_COINCIDE : bool = true;

pub fn live_token_admits(char_count: u16) bool {
    return char_count >= LIVE_TOKEN_MIN_CHARS and char_count <= LIVE_TOKEN_MAX_CHARS;
}

; The two grammars are not equal and one is not a tightening of the other in practice, because
; only the loose one runs. Anything the strict grammar admits, the loose one admits too; the
; reverse fails on both axes, length and alphabet.
pub fn grammars_disagree(char_count: u16, all_ascii_alphanumeric: bool) bool {
    return live_token_admits(char_count) and !shared_token_admits(char_count, all_ascii_alphanumeric);
}

pub fn token_reaches_the_lookup(char_count: u16, all_ascii_alphanumeric: bool) bool {
    if (SHARED_GRAMMAR_IS_ENFORCED_ON_THE_LIVE_PATH) {
        return live_token_admits(char_count) and shared_token_admits(char_count, all_ascii_alphanumeric);
    }
    return live_token_admits(char_count);
}

; --- The Telegram id: three gates, none of them an identity ---------------------------------------
; src/trios/validation.rs:40-66. The numeric bound is positive and at most 2^53-1, the ceiling
; named in the source comment at :46 (:20 until 2c21df1 moved the file, re-read 2026-09-22) for
; JavaScript safety. The string form adds a grammar first:
; src/trios/validation.rs:6-8 requires one to twenty characters, every one an ASCII digit, which
; is why a leading minus fails the GRAMMAR and never the range.
pub const ID_MIN : i64 = 1;
pub const ID_MAX_SAFE : i64 = 9007199254740991;
pub const ID_FIRST_UNSAFE : i64 = 9007199254740992;
pub const ID_MAX_SAFE_IS_A_DOUBLE_PRECISION_PROPERTY : bool = true;
pub const ID_STRING_MIN_DIGITS : u8 = 1;
pub const ID_STRING_MAX_DIGITS : u8 = 20;
; Twenty digits exceeds i64 entirely, whose largest value has nineteen, so the grammar admits
; strings the parse must then refuse. That is the third gate and it is reachable.
pub const I64_MAX_DIGITS : u8 = 19;
pub const GRAMMAR_ADMITS_MORE_DIGITS_THAN_I64_HOLDS : bool = true;

pub fn id_range_admits(id: i64) bool {
    return id >= ID_MIN and id <= ID_MAX_SAFE;
}

pub fn id_string_grammar_admits(digit_count: u8, all_ascii_digits: bool) bool {
    return digit_count >= ID_STRING_MIN_DIGITS and digit_count <= ID_STRING_MAX_DIGITS and all_ascii_digits;
}

pub const GATE_NONE : u8 = 0;
pub const GATE_GRAMMAR : u8 = 1;
pub const GATE_PARSE : u8 = 2;
pub const GATE_RANGE : u8 = 3;
pub const GATE_COUNT : u8 = 3;

pub fn id_string_refusal_gate(digit_count: u8, all_ascii_digits: bool, parsed: bool, id: i64) u8 {
    if (!id_string_grammar_admits(digit_count, all_ascii_digits)) {
        return GATE_GRAMMAR;
    }
    if (!parsed) {
        return GATE_PARSE;
    }
    if (!id_range_admits(id)) {
        return GATE_RANGE;
    }
    return GATE_NONE;
}

; The second copy. src/api/auth.rs:699-707 applies the same two bounds and returns a status code
; instead of a labelled error; it has 30 call sites across 10 consumer modules, and the shared
; validator has none. D15 forbids exactly this shape for the price arithmetic; it is the same
; shape, in a different domain, and on 2026-09-21 nothing pinned the two copies equal (corrected
; 2026-09-22 below).
pub const PARAM_VALIDATOR_IS_A_SECOND_COPY : bool = true;
pub const PARAM_VALIDATOR_CALL_SITES : u8 = 30;
pub const PARAM_VALIDATOR_CONSUMER_MODULES : u8 = 10;
pub const SHARED_ID_VALIDATOR_CALL_SITES : u8 = 0;
pub const THE_TWO_COPIES_AGREE_TODAY : bool = true;
; CORRECTED 2026-09-22: A_TEST_PINS_THE_TWO_COPIES_EQUAL was false and is true; the paragraph above
; said "nothing pins the two copies equal" on 2026-09-21. scripts/verify_t27_against_source.py now
; binds ID_MAX_SAFE to the ceiling of BOTH copies -- validate_telegram_id_param in src/api/auth.rs
; and validate_telegram_id in src/trios/validation.rs -- and each row's anchor requires the
; `if id <= 0` floor in front of the ceiling it reads. tests/t27_gates_run.rs runs that gate under
; cargo test, which CI runs. Planted on 2026-09-22, each of four drifts fails the gate: either
; copy's ceiling moved down by one, and either copy's floor written `if id < 0`. So a test holds both
; ceilings to ID_MAX_SAFE and both floors to the same text, and two copies held to one value are
; held equal. What the pin is NOT: no test compares the two literals with each other, so a drift in
; both copies together still fails, against ID_MAX_SAFE; and it runs through this file's constant
; and through tests/t27_gates_run.rs, whose header says it runs the gates here until the workflow
; jobs land. The 2026-09-21 reading is kept as A_TEST_PINS_THE_TWO_COPIES_EQUAL_2026_09_21, and the
; two tests and the invariant whose names record it assert that dated reading.
pub const A_TEST_PINS_THE_TWO_COPIES_EQUAL : bool = true;
pub const A_TEST_PINS_THE_TWO_COPIES_EQUAL_2026_09_21 : bool = false;
pub const THE_PIN_RUNS_THROUGH_ID_MAX_SAFE : bool = true;
pub const A_TEST_COMPARES_THE_TWO_LITERALS_DIRECTLY : bool = false;
pub const ID_PIN_MEASURED_AT : str = "2026-09-22";

; An id's validity is not an identity, and the gap is the whole of the identity contract. A
; well-formed integer in a safe range says nothing about who sent the request; the proof does.
pub const A_VALID_ID_IS_NOT_A_PROVEN_IDENTITY : bool = true;

pub fn identity_after_id_check(range_admits: bool, proof_ok: bool) bool {
    return range_admits and proof_ok;
}

; --- Named refusals -----------------------------------------------------------------------------
pub const CLAMP_FIRING_RATE_IS_NOT_MEASURED : bool = true;
pub const CLAMP_FIRING_RATE_NOTE : str = "How often either clamp actually substitutes in production is unknown here, and not by deferral: neither emits a log line, no counter in src/metrics wraps them, and the repository stores no sample of the quest rows they read. Closing this needs a counter at the substitution branch, which is also the cheapest way to learn whether the four call sites matter at all.";
pub const QUEST_ROW_CORPUS_IS_NOT_MEASURED : bool = true;
pub const QUEST_ROW_CORPUS_NOTE : str = "Whether any stored quest place or treasure hunt holds a non-finite or out-of-range coordinate cannot be answered from this tree: the rows live in a database and data/ carries no fixture of them. The defect pinned here is that the code cannot tell a caller which case it served, and that is true whether the corpus is empty or not.";
pub const LIVE_TOKEN_ENTROPY_IS_NOT_MEASURED : bool = true;
pub const LIVE_TOKEN_ENTROPY_NOTE : str = "Nothing in src/ generates a qr_token. The column is populated by an admin write and the scan path only looks it up, so the length and alphabet of a real token are set outside this repository and no number for them may be published here. That is also why the strict grammar being unenforced is a finding and not obviously a bug: the tokens in use may not be sixteen alphanumeric characters at all.";

; --- Tests ---------------------------------------------------------------------------------------

test the_owner_contracts_are_named_and_none_of_them_is_restated {
    assert REUSES_PRICING_ID == "turbobaby/pricing-honesty";
    assert REUSES_RIDE_RUNTIME_ID == "turbobaby/ride-runtime";
    assert REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity";
    assert REUSES_CATALOG_WRITE_ID == "turbobaby/catalog-write";
    assert REUSE_EDGE_COUNT == 4;
    assert REUSES_PRICING_ID != ID;
    assert REUSES_RIDE_RUNTIME_ID != ID;
    assert REUSES_REQUEST_IDENTITY_ID != ID;
    assert REUSES_CATALOG_WRITE_ID != ID;
    assert REUSES_PRICING_ID != REUSES_RIDE_RUNTIME_ID;
    assert REUSES_RIDE_RUNTIME_ID != REUSES_REQUEST_IDENTITY_ID;
    assert REUSES_REQUEST_IDENTITY_ID != REUSES_CATALOG_WRITE_ID;
    assert ABSENCE_INPUT == "absence is not zero, and the rendering of it, owned by the pricing contract";
    assert LEGITIMATE_CLAMP_INPUT == "the bounded control clamp owned by the ride runtime contract";
}

test the_legitimate_clamp_is_named_by_declaration_and_its_numbers_are_left_alone {
    assert LEGITIMATE_CLAMP_DECLARATION == "clamp_horizontal_control";
    assert LEGITIMATE_CLAMP_SATURATES_AT_THE_BOUND == true;
    assert LEGITIMATE_CLAMP_OUTPUT_IS_EVER_PUBLISHED == false;
    assert SHARED_CLAMP_SATURATES_AT_THE_BOUND == false;
    assert LEGITIMATE_CLAMP_SATURATES_AT_THE_BOUND != SHARED_CLAMP_SATURATES_AT_THE_BOUND;
}

test naming_one_legitimate_clamp_is_not_a_uniqueness_claim_over_the_corpus {
    assert CORPUS_FILES_DECLARING_A_CLAMP_FN == 6;
    assert SIBLING_FILES_DECLARING_A_CLAMP_FN == 5;
    assert SIBLING_CLAMP_OWNER_IDS.len == SIBLING_FILES_DECLARING_A_CLAMP_FN;
    assert SIBLING_FILES_DECLARING_A_CLAMP_FN + 1 == CORPUS_FILES_DECLARING_A_CLAMP_FN;
    assert CLAMP_FNS_DECLARED_HERE == 4;
    assert SIBLING_CLAMP_OWNER_IDS[3] == REUSES_RIDE_RUNTIME_ID;
    assert SIBLING_CLAMP_OWNER_IDS[0] != ID;
    assert SIBLING_CLAMP_OWNER_IDS[4] != ID;
    assert LEGITIMATE_CLAMP_IS_A_UNIQUENESS_CLAIM == false;
    assert SIBLING_CLAMP_LEGITIMACY_IS_JUDGED_HERE == false;
}

test the_f64_absence_is_a_dated_reading_and_carries_its_denominator {
    assert F64_DECLARATIONS_IN_CORPUS == 0;
    assert CORPUS_FILES_MEASURED_FOR_F64 == 43;
    assert F64_ABSENCE_WAS_RE_RUN_AT_REVIEW == true;
    assert MEASURED_AT == "2026-09-21";
}

; Corrected 2026-09-22: the census literals were 502, 13 and 5 and the split summed three parts.
; They now carry the re-measured 542, 15 and 7, and the split sums four parts, the fourth being the
; two items 2c21df1 added (REACHED_ITEMS_OUTSIDE_THE_SPLIT). These asserts compare constants with
; literals, so they catch an edit to this file and never a drift in the tree.
test the_census_of_the_validator_module_is_pinned {
    assert VALIDATOR_SOURCE == "src/trios/validation.rs";
    assert TYPE_ALIAS_SOURCE == "src/trios/core.rs";
    assert MEASURED_AT == "2026-09-21";
    assert VALIDATOR_CENSUS_REMEASURED_AT == "2026-09-22";
    assert VALIDATOR_SOURCE_LINES == 542;
    assert VALIDATOR_PUBLIC_ITEMS == 15;
    assert VALIDATOR_ITEMS_REACHED_BY_LIVE_CODE == 7;
    assert VALIDATOR_ITEMS_REACHED_BY_NOTHING == 8;
    assert VALIDATOR_ITEMS_REACHED_BY_LIVE_CODE + VALIDATOR_ITEMS_REACHED_BY_NOTHING == VALIDATOR_PUBLIC_ITEMS;
    assert REACHED_ITEMS_THAT_REFUSE + REACHED_ITEMS_THAT_REWRITE + REACHED_ITEMS_THAT_SUBSTITUTE + REACHED_ITEMS_OUTSIDE_THE_SPLIT == VALIDATOR_ITEMS_REACHED_BY_LIVE_CODE;
    assert REACHED_ITEMS_OUTSIDE_THE_SPLIT == 2;
    assert REACHED_ITEMS_THAT_REFUSE == 2;
    assert REACHED_ITEMS_THAT_REWRITE == 1;
    assert REWRITER_HAS_A_REFUSING_BRANCH == false;
    assert SCALE_PER_UNIT == 100;
    assert READ_CLAMP_IMPORTERS == 1;
    assert READ_CLAMP_CALL_SITES == 4;
    assert READ_CLAMP_CALL_SITES_ON_A_PUBLISHED_FIELD == READ_CLAMP_CALL_SITES;
    assert MONEY_CLAMP_CALL_SITES == 1;
}

test the_silent_member_of_the_family_is_named_as_such {
    assert CLAMP_LOGS_ITS_SUBSTITUTION == false;
    assert TRY_GET_WARN_LOGS_ITS_SUBSTITUTION == true;
    assert CLAMP_LOGS_ITS_SUBSTITUTION != TRY_GET_WARN_LOGS_ITS_SUBSTITUTION;
    assert CONSTRUCTS_THIS_FILE_ADDS_TO_THE_FAMILY == 2;
    assert D9_NAMED_CONSTRUCT_COUNT == 3;
    assert D9_FOURTH_CONSTRUCT_IS_THE_CART_COLUMN == true;
}

test every_d9_citation_was_opened_and_one_of_them_was_wrong {
    assert D9_CITATIONS_OPENED == 4;
    assert D9_CITATIONS_CONFIRMED == 3;
    assert D9_CITATIONS_CORRECTED == 1;
    assert D9_CITATIONS_CONFIRMED + D9_CITATIONS_CORRECTED == D9_CITATIONS_OPENED;
    assert D9_STALE_CITATION_DRIFT_LINES == 6;
    assert D9_TITLE == "Money fields are nullable, and absent stays absent";
}

test a_finite_in_range_reading_survives_including_a_negative_one {
    assert clamp_outcome(true, SOUTHERN_SAMPLE_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI) == CLAMP_OUT_PASSTHROUGH;
    assert clamp_result(true, SOUTHERN_SAMPLE_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI, READ_PATH_FALLBACK_CENTI) == SOUTHERN_SAMPLE_LAT_CENTI;
    assert clamp_outcome(true, SOUTHERN_SAMPLE_LON_CENTI, LON_MIN_CENTI, LON_MAX_CENTI) == CLAMP_OUT_PASSTHROUGH;
    assert clamp_result(true, SOUTHERN_SAMPLE_LON_CENTI, LON_MIN_CENTI, LON_MAX_CENTI, READ_PATH_FALLBACK_CENTI) == SOUTHERN_SAMPLE_LON_CENTI;
    assert clamp_outcome(true, LAT_MAX_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI) == CLAMP_OUT_PASSTHROUGH;
    assert clamp_outcome(true, LAT_MIN_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI) == CLAMP_OUT_PASSTHROUGH;
    assert CLAMP_OUTCOME_COUNT == 2;
    assert CLAMP_OUT_UNSET == 0;
}

test a_non_finite_input_leaves_as_the_fallback_and_not_as_an_error {
    assert clamp_outcome(false, READ_PATH_FALLBACK_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI) == CLAMP_OUT_SUBSTITUTED;
    assert clamp_result(false, SOUTHERN_SAMPLE_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI, READ_PATH_FALLBACK_CENTI) == READ_PATH_FALLBACK_CENTI;
    assert clamp_outcome(true, JUST_ABOVE_THE_CEILING_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI) == CLAMP_OUT_SUBSTITUTED;
    assert clamp_result(true, JUST_ABOVE_THE_CEILING_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI, READ_PATH_FALLBACK_CENTI) == READ_PATH_FALLBACK_CENTI;
}

test the_name_says_clamp_and_the_body_says_substitute {
    assert clamp_result(true, JUST_ABOVE_THE_CEILING_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI, READ_PATH_FALLBACK_CENTI) == 0;
    assert saturating_result(true, JUST_ABOVE_THE_CEILING_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI, READ_PATH_FALLBACK_CENTI) == LAT_MAX_CENTI;
    assert clamp_result(true, JUST_ABOVE_THE_CEILING_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI, READ_PATH_FALLBACK_CENTI) != saturating_result(true, JUST_ABOVE_THE_CEILING_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI, READ_PATH_FALLBACK_CENTI);
    assert saturating_result(true, -18001, LON_MIN_CENTI, LON_MAX_CENTI, READ_PATH_FALLBACK_CENTI) == LON_MIN_CENTI;
    assert saturating_result(false, JUST_ABOVE_THE_CEILING_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI, READ_PATH_FALLBACK_CENTI) == READ_PATH_FALLBACK_CENTI;
    assert SHARED_CLAMP_SUBSTITUTES_A_FOURTH_ARGUMENT == true;
}

test the_live_fallback_is_itself_a_legal_reading_which_is_the_whole_defect {
    assert fallback_is_a_legal_reading(READ_PATH_FALLBACK_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI) == true;
    assert fallback_is_a_legal_reading(READ_PATH_FALLBACK_CENTI, LON_MIN_CENTI, LON_MAX_CENTI) == true;
    assert substitution_is_undetectable(false, READ_PATH_FALLBACK_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI, READ_PATH_FALLBACK_CENTI) == true;
    assert substitution_is_undetectable(true, JUST_ABOVE_THE_CEILING_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI, READ_PATH_FALLBACK_CENTI) == true;
    assert substitution_is_undetectable(true, SOUTHERN_SAMPLE_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI, READ_PATH_FALLBACK_CENTI) == false;
}

test a_fallback_outside_the_interval_is_at_least_detectable {
    assert fallback_is_a_legal_reading(-9001, LAT_MIN_CENTI, LAT_MAX_CENTI) == false;
    assert substitution_is_undetectable(false, 0, LAT_MIN_CENTI, LAT_MAX_CENTI, -9001) == false;
    assert clamp_call_is_permitted(USE_PUBLISHED_FACT, -9001, LAT_MIN_CENTI, LAT_MAX_CENTI) == true;
    assert clamp_call_is_permitted(USE_PUBLISHED_FACT, READ_PATH_FALLBACK_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI) == false;
    assert clamp_call_is_permitted(USE_BOUNDED_CONTROL, READ_PATH_FALLBACK_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI) == true;
}

test the_money_companion_repeats_the_trap_in_a_money_slot {
    assert non_negative_result(true, 4500) == 4500;
    assert non_negative_result(true, -1) == NON_NEGATIVE_FLOOR;
    assert non_negative_result(false, 4500) == NON_NEGATIVE_FLOOR;
    assert non_negative_substituted(false, 4500) == true;
    assert non_negative_substituted(true, -1) == true;
    assert non_negative_substituted(true, 0) == false;
    assert MONEY_CLAMP_CALL_SITES == 1;
}

test only_a_bounded_control_input_may_be_clamped {
    assert clamp_is_legitimate(USE_BOUNDED_CONTROL) == true;
    assert clamp_is_legitimate(USE_PUBLISHED_FACT) == false;
    assert clamp_is_legitimate(USE_PUBLISHED_MONEY) == false;
    assert clamp_is_legitimate(USE_UNSET) == false;
    assert use_kind_is_published(USE_PUBLISHED_FACT) == true;
    assert use_kind_is_published(USE_PUBLISHED_MONEY) == true;
    assert use_kind_is_published(USE_BOUNDED_CONTROL) == false;
    assert USE_KIND_COUNT == 3;
    assert USE_KIND_NAMES[0] == "bounded_control";
    assert USE_KIND_NAMES[1] == "published_fact";
    assert USE_KIND_NAMES[2] == "published_money";
    assert USE_UNSET == 0;
    assert USE_BOUNDED_CONTROL == 1;
    assert USE_PUBLISHED_FACT == 2;
    assert USE_PUBLISHED_MONEY == 3;
}

test a_substituted_value_never_reaches_a_published_slot {
    assert value_may_reach_a_published_slot(USE_PUBLISHED_FACT, false) == true;
    assert value_may_reach_a_published_slot(USE_PUBLISHED_FACT, true) == false;
    assert value_may_reach_a_published_slot(USE_PUBLISHED_MONEY, true) == false;
    assert value_may_reach_a_published_slot(USE_PUBLISHED_MONEY, false) == true;
    assert value_may_reach_a_published_slot(USE_BOUNDED_CONTROL, false) == false;
    assert value_may_reach_a_published_slot(USE_UNSET, false) == false;
}

test the_published_slot_holds_a_measurement_or_an_absence_and_nothing_else {
    assert published_slot(true, SOUTHERN_SAMPLE_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI) == SLOT_MEASURED;
    assert published_slot(false, 0, LAT_MIN_CENTI, LAT_MAX_CENTI) == SLOT_ABSENT;
    assert published_slot(true, JUST_ABOVE_THE_CEILING_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI) == SLOT_ABSENT;
    assert published_slot(true, READ_PATH_FALLBACK_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI) == SLOT_MEASURED;
    assert SLOT_KIND_COUNT == 2;
    assert NO_FUNCTION_FROM_ABSENCE_TO_A_NUMBER == true;
}

; The interval here is the coordinate one, not a money one: the money ceilings this parser is
; actually called with are the write contract's, and copying them would be restating what it owns.
test the_shipped_write_path_already_does_it_the_honest_way {
    assert parse_outcome(false, false, false, 0, LAT_MIN_CENTI, LAT_MAX_CENTI) == PARSE_ABSENT;
    assert parse_outcome(true, false, true, 0, LAT_MIN_CENTI, LAT_MAX_CENTI) == PARSE_REFUSED;
    assert parse_outcome(true, true, false, 0, LAT_MIN_CENTI, LAT_MAX_CENTI) == PARSE_REFUSED;
    assert parse_outcome(true, true, true, JUST_ABOVE_THE_CEILING_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI) == PARSE_REFUSED;
    assert parse_outcome(true, true, true, SOUTHERN_SAMPLE_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI) == PARSE_ADMITTED;
    assert parse_outcome(true, true, true, -9001, LAT_MIN_CENTI, LAT_MAX_CENTI) == PARSE_REFUSED;
    assert EMPTY_INPUT_IS_ABSENCE_NOT_ZERO == true;
    assert PARSE_OUTCOME_COUNT == 3;
    assert PARSE_UNSET == 0;
}

test the_parser_and_the_clamp_diverge_on_exactly_the_unknown_input {
    assert parse_outcome(true, true, false, 0, LAT_MIN_CENTI, LAT_MAX_CENTI) == PARSE_REFUSED;
    assert clamp_outcome(false, 0, LAT_MIN_CENTI, LAT_MAX_CENTI) == CLAMP_OUT_SUBSTITUTED;
    assert parse_invented_a_number(true, true, false, 0, LAT_MIN_CENTI, LAT_MAX_CENTI) == false;
    assert parse_invented_a_number(false, false, false, 0, LAT_MIN_CENTI, LAT_MAX_CENTI) == false;
    assert parse_invented_a_number(true, true, true, 10, LAT_MIN_CENTI, LAT_MAX_CENTI) == false;
}

test the_shared_token_grammar_is_a_count_and_a_class_and_never_an_example {
    assert SHARED_TOKEN_EXACT_CHARS == 16;
    assert SHARED_TOKEN_ALPHABET_SIZE == 62;
    assert SHARED_TOKEN_LENGTH_IS_EXACT_NOT_A_CEILING == true;
    assert shared_token_admits(16, true) == true;
    assert shared_token_admits(16, false) == false;
    assert shared_token_admits(15, true) == false;
    assert shared_token_admits(17, true) == false;
    assert shared_token_admits(0, true) == false;
    assert TOKEN_FIXTURE_IS_REFUSED == true;
    assert SHARED_TOKEN_LENGTH_IS_MEASURED_IN_BYTES == true;
    assert SHARED_TOKEN_BYTES_AND_CHARS_COINCIDE_ON_ADMITTED_STRINGS == true;
}

; The unit the two shipped length tests actually use. Recording it is the point: the strict
; grammar's alphabet check makes bytes and characters the same number on everything it admits,
; the live grammar has no alphabet check, and there the two differ -- so live_token_admits is a
; model of a byte count and says so rather than quietly claiming to count characters.
test the_shipped_length_tests_count_bytes_and_only_one_grammar_makes_that_harmless {
    assert SHARED_TOKEN_LENGTH_IS_MEASURED_IN_BYTES == true;
    assert LIVE_TOKEN_LENGTH_IS_MEASURED_IN_BYTES == true;
    assert SHARED_TOKEN_BYTES_AND_CHARS_COINCIDE_ON_ADMITTED_STRINGS == true;
    assert LIVE_TOKEN_MODEL_ASSUMES_ONE_BYTE_PER_CHARACTER == true;
    assert LIVE_TOKEN_CHECKS_THE_ALPHABET == false;
    assert LIVE_TOKEN_ALPHABET_CHECK_WOULD_MAKE_THE_UNITS_COINCIDE == true;
    assert SHARED_TOKEN_BYTES_AND_CHARS_COINCIDE_ON_ADMITTED_STRINGS != LIVE_TOKEN_CHECKS_THE_ALPHABET;
}

test the_live_scan_path_applies_a_different_and_looser_grammar {
    assert live_token_admits(LIVE_TOKEN_MIN_CHARS) == true;
    assert live_token_admits(LIVE_TOKEN_MAX_CHARS) == true;
    assert LIVE_TOKEN_MIN_CHARS == 1;
    assert LIVE_TOKEN_MAX_CHARS == 200;
    assert live_token_admits(201) == false;
    assert live_token_admits(0) == false;
    assert LIVE_TOKEN_CHECKS_THE_ALPHABET == false;
    assert LIVE_TOKEN_BODY_KEY_COUNT == 2;
    assert LIVE_TOKEN_BODY_KEYS[0] == "qr_token";
    assert LIVE_TOKEN_BODY_KEYS[1] == "code";
    assert LIVE_TOKEN_KEY_PRECEDENCE_IS_TESTED == true;
}

test the_strict_grammar_is_shipped_and_enforced_on_nothing {
    assert SHARED_GRAMMAR_IS_ENFORCED_ON_THE_LIVE_PATH == false;
    assert SHARED_TOKEN_VALIDATOR_CALL_SITES == 0;
    assert grammars_disagree(16, false) == true;
    assert grammars_disagree(5, true) == true;
    assert grammars_disagree(200, false) == true;
    assert grammars_disagree(16, true) == false;
    assert grammars_disagree(201, false) == false;
    assert token_reaches_the_lookup(5, false) == true;
    assert token_reaches_the_lookup(201, true) == false;
}

test the_id_bound_is_the_double_precision_ceiling_and_the_floor_is_one {
    assert ID_MIN == 1;
    assert ID_MAX_SAFE == 9007199254740991;
    assert ID_FIRST_UNSAFE == 9007199254740992;
    assert ID_FIRST_UNSAFE == ID_MAX_SAFE + 1;
    assert id_range_admits(ID_MIN) == true;
    assert id_range_admits(ID_MAX_SAFE) == true;
    assert id_range_admits(ID_FIRST_UNSAFE) == false;
    assert id_range_admits(0) == false;
    assert id_range_admits(-1) == false;
}

test each_of_the_three_gates_refuses_a_different_string {
    assert id_string_refusal_gate(3, false, false, 0) == GATE_GRAMMAR;
    assert id_string_refusal_gate(2, false, false, 0) == GATE_GRAMMAR;
    assert id_string_refusal_gate(21, true, false, 0) == GATE_GRAMMAR;
    assert id_string_refusal_gate(0, true, false, 0) == GATE_GRAMMAR;
    assert id_string_refusal_gate(20, true, false, 0) == GATE_PARSE;
    assert id_string_refusal_gate(1, true, true, 0) == GATE_RANGE;
    assert id_string_refusal_gate(16, true, true, ID_FIRST_UNSAFE) == GATE_RANGE;
    assert id_string_refusal_gate(1, true, true, ID_MIN) == GATE_NONE;
    assert GATE_COUNT == 3;
    assert GATE_NONE == 0;
    assert ID_STRING_MIN_DIGITS == 1;
    assert id_string_grammar_admits(ID_STRING_MIN_DIGITS, true) == true;
}

test the_grammar_admits_more_digits_than_the_integer_can_hold {
    assert ID_STRING_MAX_DIGITS == 20;
    assert I64_MAX_DIGITS == 19;
    assert ID_STRING_MAX_DIGITS > I64_MAX_DIGITS;
    assert GRAMMAR_ADMITS_MORE_DIGITS_THAN_I64_HOLDS == true;
    assert id_string_grammar_admits(20, true) == true;
}

; The name records the 2026-09-21 reading, so the pin assert reads the dated constant. The current
; reading is asserted by the_two_copies_of_the_id_bound_are_pinned_through_one_constant.
test the_id_bound_is_written_twice_and_pinned_nowhere {
    assert PARAM_VALIDATOR_IS_A_SECOND_COPY == true;
    assert PARAM_VALIDATOR_CALL_SITES == 30;
    assert PARAM_VALIDATOR_CONSUMER_MODULES == 10;
    assert SHARED_ID_VALIDATOR_CALL_SITES == 0;
    assert PARAM_VALIDATOR_CALL_SITES > SHARED_ID_VALIDATOR_CALL_SITES;
    assert THE_TWO_COPIES_AGREE_TODAY == true;
    assert A_TEST_PINS_THE_TWO_COPIES_EQUAL_2026_09_21 == false;
}

; CORRECTED 2026-09-22: the two copies are still two, and one test now holds both to one value.
test the_two_copies_of_the_id_bound_are_pinned_through_one_constant {
    assert PARAM_VALIDATOR_IS_A_SECOND_COPY == true;
    assert A_TEST_PINS_THE_TWO_COPIES_EQUAL == true;
    assert A_TEST_PINS_THE_TWO_COPIES_EQUAL != A_TEST_PINS_THE_TWO_COPIES_EQUAL_2026_09_21;
    assert THE_PIN_RUNS_THROUGH_ID_MAX_SAFE == true;
    assert A_TEST_COMPARES_THE_TWO_LITERALS_DIRECTLY == false;
    assert ID_PIN_MEASURED_AT == "2026-09-22";
    assert ID_PIN_MEASURED_AT != MEASURED_AT;
    assert ID_MAX_SAFE == 9007199254740991;
}

test a_well_formed_id_is_not_a_person {
    assert A_VALID_ID_IS_NOT_A_PROVEN_IDENTITY == true;
    assert identity_after_id_check(true, true) == true;
    assert identity_after_id_check(true, false) == false;
    assert identity_after_id_check(false, true) == false;
    assert identity_after_id_check(false, false) == false;
    assert REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity";
}

; The unpinned id bound is kept here as the gap this file found on 2026-09-21; it was closed on
; 2026-09-22 by the source-binding gate, and the dated constant is what this test still holds.
test the_gaps_this_file_found_are_named_rather_than_filled {
    assert CLAMP_FIRING_RATE_IS_NOT_MEASURED == true;
    assert QUEST_ROW_CORPUS_IS_NOT_MEASURED == true;
    assert LIVE_TOKEN_ENTROPY_IS_NOT_MEASURED == true;
    assert A_TEST_PINS_THE_TWO_COPIES_EQUAL_2026_09_21 == false;
    assert SHARED_GRAMMAR_IS_ENFORCED_ON_THE_LIVE_PATH == false;
}

; --- Invariants -----------------------------------------------------------------------------------

invariant a_substituted_value_can_never_be_published
  assert value_may_reach_a_published_slot(USE_PUBLISHED_FACT, true) == false and value_may_reach_a_published_slot(USE_PUBLISHED_MONEY, true) == false

invariant this_file_judges_no_siblings_clamp_and_counts_them_instead
  assert LEGITIMATE_CLAMP_IS_A_UNIQUENESS_CLAIM == false and SIBLING_CLAMP_LEGITIMACY_IS_JUDGED_HERE == false and SIBLING_CLAMP_OWNER_IDS.len == SIBLING_FILES_DECLARING_A_CLAMP_FN and SIBLING_FILES_DECLARING_A_CLAMP_FN + 1 == CORPUS_FILES_DECLARING_A_CLAMP_FN

invariant the_corpus_carries_no_float_declaration_as_of_the_dated_reading
  assert F64_DECLARATIONS_IN_CORPUS == 0 and F64_ABSENCE_WAS_RE_RUN_AT_REVIEW == true and CORPUS_FILES_MEASURED_FOR_F64 == 43

invariant a_clamp_is_legitimate_on_one_use_kind_and_no_other
  assert clamp_is_legitimate(USE_BOUNDED_CONTROL) == true and clamp_is_legitimate(USE_PUBLISHED_FACT) == false and clamp_is_legitimate(USE_PUBLISHED_MONEY) == false and clamp_is_legitimate(USE_UNSET) == false

invariant a_control_value_is_steering_and_never_a_published_number
  assert value_may_reach_a_published_slot(USE_BOUNDED_CONTROL, false) == false and LEGITIMATE_CLAMP_OUTPUT_IS_EVER_PUBLISHED == false

invariant an_unknown_input_never_leaves_this_contract_as_a_number
  assert published_slot(false, 0, LAT_MIN_CENTI, LAT_MAX_CENTI) == SLOT_ABSENT and published_slot(true, JUST_ABOVE_THE_CEILING_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI) == SLOT_ABSENT

invariant the_shipped_helper_substitutes_where_its_name_promises_saturation
  assert clamp_result(true, JUST_ABOVE_THE_CEILING_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI, READ_PATH_FALLBACK_CENTI) != saturating_result(true, JUST_ABOVE_THE_CEILING_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI, READ_PATH_FALLBACK_CENTI)

invariant the_live_fallback_is_indistinguishable_from_a_real_reading
  assert substitution_is_undetectable(false, READ_PATH_FALLBACK_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI, READ_PATH_FALLBACK_CENTI) == true

invariant a_legitimate_reading_is_never_reported_as_substituted
  assert substitution_is_undetectable(true, SOUTHERN_SAMPLE_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI, READ_PATH_FALLBACK_CENTI) == false

invariant a_negative_coordinate_survives_the_clamp
  assert clamp_result(true, SOUTHERN_SAMPLE_LAT_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI, READ_PATH_FALLBACK_CENTI) == SOUTHERN_SAMPLE_LAT_CENTI

invariant a_clamp_on_a_published_slot_needs_a_fallback_the_interval_refuses
  assert clamp_call_is_permitted(USE_PUBLISHED_FACT, READ_PATH_FALLBACK_CENTI, LAT_MIN_CENTI, LAT_MAX_CENTI) == false

invariant the_money_floor_is_a_substitution_and_not_a_measurement
  assert non_negative_substituted(false, 4500) == true and non_negative_result(false, 4500) == NON_NEGATIVE_FLOOR

invariant the_parser_refuses_where_the_clamp_answers
  assert parse_outcome(true, true, false, 0, LAT_MIN_CENTI, LAT_MAX_CENTI) == PARSE_REFUSED and clamp_outcome(false, 0, LAT_MIN_CENTI, LAT_MAX_CENTI) == CLAMP_OUT_SUBSTITUTED

invariant an_empty_input_is_an_absence_and_never_a_zero
  assert parse_outcome(false, false, false, 0, LAT_MIN_CENTI, LAT_MAX_CENTI) == PARSE_ABSENT

invariant no_argument_makes_the_parser_invent_a_number
  assert parse_invented_a_number(true, true, false, 0, LAT_MIN_CENTI, LAT_MAX_CENTI) == false and parse_invented_a_number(false, true, true, 10, LAT_MIN_CENTI, LAT_MAX_CENTI) == false

invariant the_token_length_is_exact_and_a_shorter_string_is_refused
  assert shared_token_admits(SHARED_TOKEN_EXACT_CHARS, true) == true and shared_token_admits(15, true) == false and shared_token_admits(17, true) == false

invariant a_token_of_the_right_length_and_the_wrong_alphabet_is_refused
  assert shared_token_admits(SHARED_TOKEN_EXACT_CHARS, false) == false

invariant every_token_the_strict_grammar_admits_the_live_path_admits_too
  assert live_token_admits(SHARED_TOKEN_EXACT_CHARS) == true

invariant the_live_path_admits_tokens_the_strict_grammar_refuses
  assert grammars_disagree(5, true) == true and grammars_disagree(SHARED_TOKEN_EXACT_CHARS, false) == true

invariant the_strict_grammar_gates_nothing_that_ships
  assert SHARED_GRAMMAR_IS_ENFORCED_ON_THE_LIVE_PATH == false and SHARED_TOKEN_VALIDATOR_CALL_SITES == 0

invariant a_non_positive_id_is_refused_at_the_range_and_not_admitted
  assert id_range_admits(0) == false and id_range_admits(-1) == false

invariant the_unsafe_successor_of_the_ceiling_is_refused
  assert id_range_admits(ID_FIRST_UNSAFE) == false and id_range_admits(ID_MAX_SAFE) == true

invariant a_leading_minus_fails_the_grammar_and_never_reaches_the_range
  assert id_string_refusal_gate(2, false, false, 0) == GATE_GRAMMAR

invariant the_parse_gate_is_reachable_because_the_grammar_is_wider_than_the_integer
  assert id_string_refusal_gate(ID_STRING_MAX_DIGITS, true, false, 0) == GATE_PARSE and ID_STRING_MAX_DIGITS > I64_MAX_DIGITS

invariant a_valid_id_without_a_proof_is_never_an_identity
  assert identity_after_id_check(true, false) == false

; The name records the 2026-09-21 reading and asserts it as dated; the invariant below it holds the
; 2026-09-22 one.
invariant the_two_copies_of_the_id_bound_are_unpinned_and_the_file_says_so
  assert PARAM_VALIDATOR_IS_A_SECOND_COPY == true and A_TEST_PINS_THE_TWO_COPIES_EQUAL_2026_09_21 == false

invariant the_two_copies_of_the_id_bound_are_held_to_one_value_by_a_test
  assert PARAM_VALIDATOR_IS_A_SECOND_COPY == true and A_TEST_PINS_THE_TWO_COPIES_EQUAL == true and THE_PIN_RUNS_THROUGH_ID_MAX_SAFE == true and A_TEST_COMPARES_THE_TWO_LITERALS_DIRECTLY == false

invariant the_substitution_leaves_no_trace_while_the_construct_d9_counted_does
  assert CLAMP_LOGS_ITS_SUBSTITUTION == false and TRY_GET_WARN_LOGS_ITS_SUBSTITUTION == true

invariant every_d9_citation_was_opened_and_the_correction_is_carried
  assert D9_CITATIONS_CONFIRMED + D9_CITATIONS_CORRECTED == D9_CITATIONS_OPENED and D9_CITATIONS_CORRECTED == 1

invariant this_file_names_its_owners_and_declares_none_of_their_vocabularies
  assert REUSE_EDGE_COUNT == 4 and REUSES_PRICING_ID != ID and REUSES_RIDE_RUNTIME_ID != ID and REUSES_REQUEST_IDENTITY_ID != ID and REUSES_CATALOG_WRITE_ID != ID

invariant the_named_absences_are_refused_rather_than_filled_with_a_number
  assert CLAMP_FIRING_RATE_IS_NOT_MEASURED == true and QUEST_ROW_CORPUS_IS_NOT_MEASURED == true and LIVE_TOKEN_ENTROPY_IS_NOT_MEASURED == true
