test this_file_refuses_to_choose_the_next_surface {
    assert THIS_FILE_PICKS_THE_NEXT_SURFACE == false;
    assert THIS_FILE_CARRIES_A_DELETION_DATE == false;
    assert RETIREMENT_ORDER_IS_PUBLISHED == false;
    assert next_surface_is_decided_here(true) == false;
    assert next_surface_is_decided_here(false) == false;
}

test the_owners_ruling_is_classified_per_surface_and_claims_no_completed_retirement {
    assert OWNER_RULING_AT == "2026-09-24";
    assert OWNER_RULING_KEEPS_ROWS == true;
    assert OWNER_RULING_DROPS_A_TABLE == false;
    assert OWNER_RULED_SURFACES.len == OWNER_RULED_SURFACE_COUNT;
    assert OWNER_RULED_SURFACES[0] == "events";
    assert OWNER_RULED_SURFACES[1] == "bike_sale";
    assert OWNER_KEPT_SURFACES.len == OWNER_KEPT_SURFACE_COUNT;
    assert OWNER_KEPT_SURFACES[0] == "referrals";
    assert OWNER_KEPT_SURFACES[2] == "ride_game";
    assert OWNER_RULED_EVENTS_STATE == STATE_DATA_HIDDEN;
    assert ruled_surface_state(false, OWNER_RULED_EVENTS_ROWS_HIDDEN) == OWNER_RULED_EVENTS_STATE;
    // Bike sales: no row hidden, the offer masked on read. The true input gives STATE_LIVE, and
    // no state of the five names the mask.
    assert OWNER_RULED_BIKE_SALE_ROWS_HIDDEN == false;
    assert OWNER_RULED_BIKE_SALE_MASKED_ON_READ == true;
    assert OWNER_RULED_BIKE_SALE_STATE == STATE_LIVE;
    assert ruled_surface_state(false, OWNER_RULED_BIKE_SALE_ROWS_HIDDEN) == OWNER_RULED_BIKE_SALE_STATE;
    assert A_MASK_ON_READ_HAS_A_STATE_HERE == false;
    assert ruled_surface_state(true, true) == STATE_SURFACE_LIVE;
    assert surface_is_retired(false, OWNER_RULING_DROPS_A_TABLE, false, OWNER_RULED_EVENTS_ROWS_HIDDEN) == false;
    assert surface_is_retired(false, OWNER_RULING_DROPS_A_TABLE, false, OWNER_RULED_BIKE_SALE_ROWS_HIDDEN) == false;
    assert OWNER_RULING_COMPLETES_A_RETIREMENT == false;
    assert COMPLETED_RETIREMENT_COUNT == 1;
    // The two briefed surfaces are not among the eight; whether the ruling reached the eight was
    // open on 2026-09-24 and was answered on 2026-09-25.
    assert OWNER_RULING_BRIEFED_SURFACES_ARE_AMONG_THE_EIGHT == false;
    assert OWNER_RULING_SCOPE_OVER_THE_EIGHT_IS_OPEN_BEFORE_2026_09_25 == true;
    assert OWNER_RULING_SCOPE_OVER_THE_EIGHT_IS_OPEN == false;
    assert next_surface_is_decided_here(false) == false;
    assert RETIREMENT_ORDER_IS_PUBLISHED == false;
}

test the_owners_answer_of_2026_09_25_is_classified_path_by_path {
    assert OWNER_ANSWER_AT == "2026-09-25";
    assert OWNER_ANSWER_AT != OWNER_RULING_AT;
    assert OWNER_ANSWER_NUMBER == 7;
    // Seven repointed, one kept, and that is all eight.
    assert LEGACY_PATHS_REPOINTED_ON_2026_09_25.len == OWNER_ANSWER_REPOINTED_COUNT;
    assert OWNER_ANSWER_REPOINTED_COUNT == 7;
    assert OWNER_ANSWER_KEPT_LEGACY_PATH_COUNT == LEGACY_LIVE_ROUTE_COUNT;
    assert owner_answer_covers_the_eight(OWNER_ANSWER_REPOINTED_COUNT, OWNER_ANSWER_KEPT_LEGACY_PATH_COUNT) == true;
    assert owner_answer_covers_the_eight(OWNER_ANSWER_REPOINTED_COUNT, 0) == false;
    assert owner_answer_covers_the_eight(LEGACY_PATH_DECLARED_COUNT, OWNER_ANSWER_KEPT_LEGACY_PATH_COUNT) == false;
    assert LEGACY_PATHS_REPOINTED_ON_2026_09_25[0] == "/accessories";
    assert LEGACY_PATHS_REPOINTED_ON_2026_09_25[2] == "/game";
    assert LEGACY_PATHS_REPOINTED_ON_2026_09_25[6] == "/tech-tree";
    // The seventh is this file's reading of the answer, not the answer's word.
    assert OWNER_ANSWER_NAMES_THE_TECH_TREE == false;
    assert OWNER_ANSWER_KEEPS_THE_QUEST == true;
    assert LEGACY_LIVE_ROUTES[0] == "/quest/:id";
    // Each path on its own inputs: the goods over tables 085 hid, the rest over none, and the kept
    // quest still reachable.
    assert OWNER_ANSWER_GOODS_STATE == STATE_DATA_HIDDEN;
    assert ruled_surface_state(false, OWNER_ANSWER_GOODS_ROWS_HIDDEN) == OWNER_ANSWER_GOODS_STATE;
    assert OWNER_ANSWER_OTHER_STATE == STATE_LIVE;
    assert ruled_surface_state(false, OWNER_ANSWER_OTHER_ROWS_HIDDEN) == OWNER_ANSWER_OTHER_STATE;
    assert OWNER_ANSWER_KEPT_QUEST_STATE == STATE_SURFACE_LIVE;
    assert ruled_surface_state(OWNER_ANSWER_KEEPS_THE_QUEST, false) == OWNER_ANSWER_KEPT_QUEST_STATE;
    assert HIDDEN_TABLES[1] == "accessories";
    assert HIDDEN_TABLES[3] == "tea_products";
    // Not a completed retirement, and nothing the answer did not name was moved.
    assert OWNER_ANSWER_DROPS_A_TABLE == false;
    assert surface_is_retired(false, OWNER_ANSWER_DROPS_A_TABLE, false, OWNER_ANSWER_GOODS_ROWS_HIDDEN) == false;
    assert surface_is_retired(false, OWNER_ANSWER_DROPS_A_TABLE, false, OWNER_ANSWER_OTHER_ROWS_HIDDEN) == false;
    assert OWNER_ANSWER_COMPLETES_A_RETIREMENT == false;
    assert COMPLETED_RETIREMENT_COUNT == 1;
    assert OWNER_ANSWER_CHANGES_AN_HTTP_ROUTE == false;
    assert LEGACY_HTTP_ROUTE_COUNT == 43;
    assert THIS_FILE_PICKS_THE_NEXT_SURFACE == false;
}

test the_quests_purchase_line_is_removed_and_no_sentence_was_written {
    assert QUEST_PURCHASE_KEY == "T_PURCHASE_MIN";
    assert QUEST_PURCHASE_LINE_RENDERED_BEFORE_2026_09_25 == true;
    assert QUEST_PURCHASE_LINE_RENDERED == false;
    assert QUEST_PURCHASE_KEY_STAYS_TRANSLATED == true;
    assert QUEST_COPY_WRITTEN_NEW == false;
}

test the_repointed_set_is_split_by_what_each_path_lost {
    assert REPOINTED_WITH_THE_SCREEN_DELETED == REPOINTED_ROUTE_COUNT_BEFORE_2026_09_24;
    assert REPOINTED_KEPT_SCREEN_COUNT_OWNER_ID == REUSES_EVENTS_BOOKING_ID;
    assert REPOINTED_KEPT_SCREEN_COUNT_OWNER_DECL == "EVENT_SCREENS_UNROUTED_BY_THE_RULING";
    // Only the whole of the set splits: the deleted half alone is not it, and neither is a kept
    // half that would put the total past REPOINTED_ROUTE_COUNT.
    assert repointed_set_splits(REPOINTED_WITH_THE_SCREEN_DELETED, REPOINTED_ROUTE_COUNT - REPOINTED_WITH_THE_SCREEN_DELETED) == true;
    assert repointed_set_splits(REPOINTED_WITH_THE_SCREEN_DELETED, 0) == false;
    assert repointed_set_splits(REPOINTED_WITH_THE_SCREEN_DELETED, REPOINTED_ROUTE_COUNT) == false;
    // Since 2026-09-25 the kept half is the events screens (their owner's count, passed in) and
    // the seven legacy screens (this file's).
    assert REPOINTED_LEGACY_SCREENS_KEPT_UNMOUNTED == LEGACY_PATHS_REPOINTED_ON_2026_09_25.len;
    assert repointed_kept_half_splits(REPOINTED_ROUTE_COUNT_BEFORE_2026_09_25 - REPOINTED_WITH_THE_SCREEN_DELETED, REPOINTED_LEGACY_SCREENS_KEPT_UNMOUNTED) == true;
    assert repointed_kept_half_splits(REPOINTED_ROUTE_COUNT_BEFORE_2026_09_25 - REPOINTED_WITH_THE_SCREEN_DELETED, 0) == false;
    assert repointed_kept_half_splits(0, REPOINTED_LEGACY_SCREENS_KEPT_UNMOUNTED) == false;
    // A kept path over a kept screen file is never a gone surface, however dark it is.
    assert may_claim_surface_is_gone(1, 1, 1) == false;
}

test the_2026_09_25_ruling_changes_surfaces_and_no_data {
    assert OWNER_RULING_2026_09_25_AT == "2026-09-25";
    assert OWNER_RULING_2026_09_25_ADDS_A_MIGRATION == false;
    assert OWNER_RULING_2026_09_25_DELETES_ROWS == false;
    assert OWNER_RULING_2026_09_25_SERVER_SURFACES.len == OWNER_RULING_2026_09_25_SERVER_SURFACE_COUNT;
    assert OWNER_RULING_2026_09_25_SERVER_SURFACES[0] == "retired_carousel_buttons";
    assert OWNER_RULING_2026_09_25_SERVER_SURFACES[2] == "tech_tree_reads";
    assert OWNER_RULING_2026_09_25_SERVER_SURFACES[6] == "promo_report_names";
    // The tech tree: rows kept, none hidden, masked on read -- the bike-sale shape.
    assert TECH_TREE_ROWS_HIDDEN == OWNER_RULED_BIKE_SALE_ROWS_HIDDEN;
    assert TECH_TREE_MASKED_ON_READ == OWNER_RULED_BIKE_SALE_MASKED_ON_READ;
    assert TECH_TREE_STATE == STATE_LIVE;
    assert ruled_surface_state(false, TECH_TREE_ROWS_HIDDEN) == TECH_TREE_STATE;
    assert A_MASK_ON_READ_HAS_A_STATE_HERE == false;
    // The dropped table's reader stays, allowlisted, so the allowlist does not move.
    assert RETIRED_READER_STATE_AFTER_THE_2026_09_25_RULING == STATE_READER_ALLOWLISTED;
    assert retirement_state(false, true, true, false) == RETIRED_READER_STATE_AFTER_THE_2026_09_25_RULING;
    assert ALLOWLIST_SIZE_MOVED_BY_THE_2026_09_25_RULING == false;
    assert ALLOWLIST_SIZE == 4;
    assert TECH_TREE_HTTP_ROUTE_COUNT == 4;
    assert LEGACY_HTTP_ROUTE_COUNT == 43;
    assert COMPLETED_RETIREMENT_COUNT == 1;
    assert REUSES_BOT_SURFACE_ID == "turbobaby/bot-surface";
}

test the_promo_report_withholds_the_dropped_tables_names_and_keeps_every_row {
    assert PROMO_REPORT_NAME_DECIDED_AT == OWNER_RULING_2026_09_25_AT;
    assert PROMO_REPORT_NAME_DECIDED_BY == "operator, applying the owner's ruling of 2026-09-25 (answer 12)";
    assert PROMO_REPORT_NAME_SITE == "src/promo.rs report";
    assert PROMO_REPORT_NAME_DECISION == "src/trios/promo.rs report_kind_and_name";
    assert PROMO_REPORT_NAME_LABEL == "src/trios/promo.rs REPORT_WITHHELD_NAME";
    assert PROMO_REPORT_NAME_WIRING_TEST == "tests/promo_report_names_wiring.rs";
    assert PROMO_REPORT_READER_COUNT == 2;
    // A live kind with its own link, or with no link and one table behind it: printed.
    assert report_prints_stored_name(true, true, true, false) == true;
    assert report_prints_stored_name(true, true, true, true) == true;
    assert report_prints_stored_name(true, false, false, false) == true;
    // A bestseller whose link opens the dropped table, or with no link to tell: withheld.
    assert report_prints_stored_name(true, true, false, true) == false;
    assert report_prints_stored_name(true, false, false, true) == false;
    // A kind no live subject writes, whatever its link says: withheld.
    assert report_prints_stored_name(false, true, true, false) == false;
    assert report_prints_stored_name(false, false, false, false) == false;
    assert PROMO_REPORT_UNCLASSIFIED_KIND_IS_WITHHELD == true;
    // Rows and totals stay; nothing is written; the send question is another file's.
    assert PROMO_REPORT_ROWS_HIDDEN == false;
    assert PROMO_REPORT_WRITES_THE_TABLE == false;
    assert PROMO_REPORT_ROWS_HIDDEN == OWNER_RULING_2026_09_25_DELETES_ROWS;
    assert PROMO_REPORT_OTHER_TABLES_NAMES_PRINTED == true;
    assert PROMO_PUBLISH_REFUSAL_OWNER_ID != ID;
}

