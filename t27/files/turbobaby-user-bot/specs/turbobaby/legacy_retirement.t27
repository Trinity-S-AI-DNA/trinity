; --- Cannabis-era copy the bundle still carried, retired 2026-09-26 ------------------------------
; A review of 405f30e found copy of the previous shop in the public bundle that no mounted screen
; printed. Every arm of src/trios/i18n.rs ships in the wasm whether a screen uses it or not: the
; committed dist/turbobaby-bot-f81e946a9d640a39_bg.wasm holds each of the phrases below once
; (grep -c -a -F, 2026-09-26). Under the owner's rulings of 2026-09-25 -- nothing cannabis-related
; anywhere (#12) and analyse all of it (answer 3) -- the operator had them retired on 2026-09-26.
; Nineteen keys were deleted outright: each declaration, each arm, and each of the thirteen rows
; the second parity gate's own list held, one-for-one by a comment line, so no line of that file
; moved. turbobaby/locale-policy owns the count (526 after it). What they were:
;   * the garden's bonus label, which no screen has printed since answer 3 relabelled a garden row
;     with the generic one (LEFTOVERS_2026_09_26_GARDEN_KEYS);
;   * the accessories screen's last two paraphernalia categories, storage and the lighter, with
;     their chips, emoji, colours and labels; ruling #12 had removed four of their siblings
;     (LEFTOVERS_2026_09_26_PARAPHERNALIA_KEYS);
;   * the strain card's lab-certificate link, printed by no screen since the cut-over of
;     2026-09-13 removed the lab results it sat beside (LEFTOVERS_2026_09_26_STRAIN_CARD_KEYS);
;   * the farm of the previous shop's shop game: plant, water and harvest, the plot states, the farm
;     tab and title, three log lines, the harvested counter and the random event whose herb half
;     ruling #12 had cut (LEFTOVERS_2026_09_26_FARM_KEYS). The game is unmounted since answer 7 and
;     stays compiled and exported, as that answer's paragraph above says; its farm zone, plots,
;     growth loop, event and star credit were removed from src/ui/game/shop_game.rs, and git keeps
;     them. No other screen used any of the nineteen.
; LEFT, EACH WITH ITS REASON. The ride game is answer 2's and was not touched. The accessories
; screen's clothing, souvenir and other categories, the shop game's cafe, grill and DJ copy, and
; the old menu's sort and badge labels are generic words that carry nothing cannabis-related. The
; tea model's fold list (src/trios/drink_categories.rs) still spells a CBD tea label: it is not in
; the bundle (its one reader is the unmounted tea screen, and the linker drops it: 0 hits in the
; same wasm), and it folds a stored label of that name into the generic tea category, so removing
; it would surface the word, not hide it (LEFTOVERS_2026_09_26_FOLD_WORD_IN_BUNDLE).
; No row, no migration, no sentence. tests/no_cannabis_client_wiring.rs keeps the nineteen keys and
; their copy out of the tables and out of every string literal under src/ui.
pub const LEFTOVERS_2026_09_26_AT : str = "2026-09-26";
pub const LEFTOVERS_2026_09_26_DECIDED_BY : str = "operator, under the owner's rulings of 2026-09-25 (#12 and answer 3)";
pub const LEFTOVERS_2026_09_26_KEYS_DELETED : u8 = 19;
pub const LEFTOVERS_2026_09_26_GARDEN_KEYS : u8 = 1;
pub const LEFTOVERS_2026_09_26_PARAPHERNALIA_KEYS : u8 = 2;
pub const LEFTOVERS_2026_09_26_STRAIN_CARD_KEYS : u8 = 1;
pub const LEFTOVERS_2026_09_26_FARM_KEYS : u8 = 15;
pub const LEFTOVERS_2026_09_26_PARITY_LIST_ROWS : u8 = 13;
pub const LEFTOVERS_2026_09_26_SENTENCES_WRITTEN : u8 = 0;
pub const LEFTOVERS_2026_09_26_TOUCHES_THE_RIDE_GAME : bool = false;
pub const LEFTOVERS_2026_09_26_UNMOUNTS_OR_DELETES_A_SCREEN : bool = false;
pub const LEFTOVERS_2026_09_26_WRITES_ROWS : bool = false;
pub const LEFTOVERS_2026_09_26_ADDS_A_MIGRATION : bool = false;
pub const LEFTOVERS_2026_09_26_FOLD_WORD_IN_BUNDLE : bool = false;
pub const LEFTOVERS_2026_09_26_KEY_COUNT_OWNER_ID : str = "turbobaby/locale-policy";
pub const LEFTOVERS_2026_09_26_WITNESS : str = "tests/no_cannabis_client_wiring.rs";

; --- Tests -----------------------------------------------------------------------------------------

test the_three_partial_states_are_named_and_the_value_set_is_closed {
    assert PARTIAL_STATE_NAMES.len == PARTIAL_STATE_COUNT;
    assert PARTIAL_STATE_COUNT == 3;
    assert PARTIAL_STATE_NAMES[0] == "data_hidden";
    assert PARTIAL_STATE_NAMES[1] == "surface_live";
    assert PARTIAL_STATE_NAMES[2] == "reader_allowlisted";
    assert state_is_known(STATE_LIVE) == true;
    assert state_is_known(STATE_FULLY_RETIRED) == true;
    assert state_is_known(STATE_COUNT) == false;
}

test each_of_the_three_partial_states_is_reachable_and_distinct {
    assert retirement_state(false, false, false, true) == STATE_DATA_HIDDEN;
    assert retirement_state(true, false, false, false) == STATE_SURFACE_LIVE;
    assert retirement_state(false, true, true, false) == STATE_READER_ALLOWLISTED;
    assert retirement_state(false, true, false, false) == STATE_FULLY_RETIRED;
    assert retirement_state(false, false, false, false) == STATE_LIVE;
}

test a_hidden_row_is_not_a_retired_surface {
    assert retirement_state(true, false, false, true) == STATE_SURFACE_LIVE;
    assert surface_is_retired(true, false, false, true) == false;
    assert surface_is_retired(false, false, false, true) == false;
    assert data_decision_changes_the_surface(true, false) == false;
    assert data_decision_changes_the_surface(false, true) == false;
    assert data_decision_changes_the_surface(true, true) == false;
}

test a_reachable_surface_outranks_every_decision_beneath_it {
    assert retirement_state(true, true, true, true) == STATE_SURFACE_LIVE;
    assert retirement_state(true, true, false, false) == STATE_SURFACE_LIVE;
    assert surface_is_retired(true, true, false, false) == false;
}

test only_the_completed_state_counts_as_a_retired_surface {
    assert surface_is_retired(false, true, false, false) == true;
    assert surface_is_retired(false, true, true, false) == false;
    assert surface_is_retired(false, false, false, false) == false;
}

test migration_085_has_the_shape_d19_mandates {
    assert HIDDEN_TABLES.len == HIDDEN_TABLE_COUNT;
    assert HIDDEN_TABLE_COUNT == 6;
    assert HIDDEN_TABLES[0] == "events";
    assert HIDDEN_TABLES[5] == "sets";
    assert HIDING_ROW_DELETES == 0;
    assert HIDING_TABLE_DROPS == 0;
    assert HIDING_VISIBILITY_UPDATES == 6;
    assert hiding_migration_is_conformant(HIDING_ROW_DELETES, HIDING_TABLE_DROPS, HIDING_VISIBILITY_UPDATES) == true;
}

test a_migration_that_deletes_or_drops_is_not_a_hiding_migration {
    assert hiding_migration_is_conformant(1, 0, 6) == false;
    assert hiding_migration_is_conformant(0, 1, 6) == false;
    assert hiding_migration_is_conformant(0, 0, 0) == false;
    assert hidden_data_is_reversible(true, true) == true;
    assert hidden_data_is_reversible(false, true) == false;
    assert hidden_data_is_reversible(true, false) == false;
}

test migration_083_drops_six_tables_and_one_of_them_keeps_every_reader {
    assert DROPPED_TABLES.len == DROPPED_TABLE_COUNT;
    assert DROPPED_TABLE_COUNT == 6;
    assert DROPPED_TABLES[0] == "lab_certificates";
    assert DROPPED_TABLES[2] == "strains";
    assert DROPPED_TABLES[5] == "garden_config";
    assert DROPPED_TABLES_WITH_A_SURVIVING_READER == 1;
    assert DROPPED_TABLES_WITH_NO_READER == 5;
    assert DROPPED_TABLES_WITH_A_SURVIVING_READER + DROPPED_TABLES_WITH_NO_READER == DROPPED_TABLE_COUNT;
}

test this_file_owns_both_numbers_that_bot_surface_copies {
    assert DROPPED_TABLE_COUNT_IS_OWNED_HERE == true;
    assert ALLOWLIST_SIZE_IS_OWNED_HERE == true;
    assert DROPPED_TABLE_COUNT_COPIED_BY_ID == "turbobaby/bot-surface";
    assert DROPPED_TABLE_COUNT_COPIED_BY_ID == REUSES_BOT_SURFACE_ID;
    assert DROPPED_TABLE_COUNT_COPIED_BY_ID != ID;
    assert DROPPED_TABLE_COUNT_COPY_DECLARATION == "LEGACY_TABLES_DROPPED_BY_THAT_MIGRATION";
    assert ALLOWLIST_SIZE_COPY_DECLARATION == "LEGACY_SURVIVOR_ENTRY_COUNT";
    assert DROPPED_TABLE_COUNT_COPY_DECLARATION != ALLOWLIST_SIZE_COPY_DECLARATION;
}

test the_retirement_distinction_is_still_declared_nowhere_else {
    // 43 and 42 are the 2026-09-21 reading; 45 and 44 were re-taken at a33e500 on 2026-09-22.
    assert CORPUS_FILE_COUNT == 43;
    assert CORPUS_FILES_OTHER_THAN_THIS_ONE == 42;
    assert CORPUS_FILES_OTHER_THAN_THIS_ONE + 1 == CORPUS_FILE_COUNT;
    assert CORPUS_FILE_COUNT_REMEASURED == 45;
    assert CORPUS_FILES_OTHER_THAN_THIS_ONE_REMEASURED == 44;
    assert CORPUS_FILES_OTHER_THAN_THIS_ONE_REMEASURED + 1 == CORPUS_FILE_COUNT_REMEASURED;
    assert CORPUS_FILE_COUNT_REMEASURED_AT == "2026-09-22";
    assert CORPUS_FILE_COUNT_REMEASURED_AT != MEASURED_AT;
    assert SPECS_CONTAINING_THE_WORD_RETIRE_2026_09_22 == 19;
    assert SPECS_NAMING_THE_STATE_MACHINE_2026_09_22 == 1;
    assert SPECS_DECLARING_THE_RETIREMENT_DISTINCTION_2026_09_22 == 0;
    assert SPECS_DECLARING_THE_RETIREMENT_DISTINCTION_2026_09_22 < SPECS_NAMING_THE_STATE_MACHINE_2026_09_22;
    assert SPECS_CONTAINING_THE_WORD_RETIRE_2026_09_22 < CORPUS_FILES_OTHER_THAN_THIS_ONE_REMEASURED;
    assert SPECS_CONTAINING_THE_WORD_RETIRE_2026_09_21 == 16;
    assert SPECS_DECLARING_THE_RETIREMENT_DISTINCTION_2026_09_21 == 0;
    assert SPECS_CONTAINING_THE_WORD_RETIRE_2026_09_21 > SPECS_DECLARING_THE_RETIREMENT_DISTINCTION_2026_09_21;
    assert SPECS_CONTAINING_THE_WORD_RETIRE_2026_09_21 < CORPUS_FILES_OTHER_THAN_THIS_ONE;
    assert THE_WORD_IS_SHARED_THE_SUBJECT_IS_NOT == true;
}

test the_allowlist_is_pinned_by_size_and_rule_not_by_contents {
    assert ALLOWLIST_SIZE == 4;
    assert ALLOWLIST_DISTINCT_TABLES == 1;
    assert ALLOWLIST_DISTINCT_TABLES < DROPPED_TABLE_COUNT;
    assert ALLOWLIST_CHECK_COUNT == 3;
    assert ALLOWLIST_DETECTION_SHAPE_COUNT == 3;
    assert ALLOWLIST_TABLE_POSITION_KEYWORDS == 5;
}

test an_allowlist_entry_needs_a_path_a_table_a_reason_and_a_live_match {
    assert allowlist_entry_is_valid(true, true, 41, true) == true;
    assert allowlist_entry_is_valid(false, true, 41, true) == false;
    assert allowlist_entry_is_valid(true, false, 41, true) == false;
    assert allowlist_entry_is_valid(true, true, 41, false) == false;
    assert allowlist_entry_is_valid(true, true, 40, true) == false;
    assert allowlist_entry_is_valid(true, true, 0, true) == false;
}

test the_allowlist_is_checked_from_both_ends {
    assert allowlist_is_sound(true, true, true) == true;
    assert allowlist_is_sound(false, true, true) == false;
    assert allowlist_is_sound(true, false, true) == false;
    assert allowlist_is_sound(true, true, false) == false;
}

test keeping_something_requires_naming_it_with_a_reason {
    assert keeping_is_permitted(true, 41) == true;
    assert keeping_is_permitted(false, 41) == false;
    assert keeping_is_permitted(true, 40) == false;
    assert keeping_is_permitted(false, 0) == false;
}

test the_retired_set_is_derived_rather_than_listed {
    assert retired_set_is_trustworthy(true, true, true) == true;
    assert retired_set_is_trustworthy(false, true, true) == false;
    assert retired_set_is_trustworthy(true, false, true) == false;
    assert retired_set_is_trustworthy(true, true, false) == false;
}

test the_live_legacy_surface_is_counted_and_repointed_paths_are_counted_apart {
    // 8 until 2026-09-25, when seven of the eight began to render the catalog.
    assert LEGACY_LIVE_ROUTES.len == LEGACY_LIVE_ROUTE_COUNT;
    assert LEGACY_LIVE_ROUTE_COUNT == 1;
    assert LEGACY_LIVE_ROUTES[0] == "/quest/:id";
    assert LEGACY_LIVE_ROUTES_BEFORE_2026_09_25.len == LEGACY_LIVE_ROUTE_COUNT_BEFORE_2026_09_25;
    assert LEGACY_LIVE_ROUTE_COUNT_BEFORE_2026_09_25 == 8;
    assert LEGACY_LIVE_ROUTES_BEFORE_2026_09_25[0] == "/accessories";
    assert LEGACY_LIVE_ROUTES_BEFORE_2026_09_25[3] == "/game";
    assert LEGACY_LIVE_ROUTES_BEFORE_2026_09_25[7] == "/tech-tree";
    // Every one of the eight is still declared: a link already sent never expires.
    assert LEGACY_PATHS_DECLARED.len == LEGACY_PATH_DECLARED_COUNT;
    assert LEGACY_PATH_DECLARED_COUNT == LEGACY_LIVE_ROUTE_COUNT_BEFORE_2026_09_25;
    assert LEGACY_PATHS_DECLARED[0] == "/accessories";
    assert LEGACY_PATHS_DECLARED[2] == LEGACY_LIVE_ROUTES[0];
    assert LEGACY_PATHS_DECLARED[7] == "/tech-tree";
    // 2 until 2026-09-24, when the three event paths joined /sets and /sommelier; 5 until
    // 2026-09-25, when seven of the eight legacy paths joined them.
    assert REPOINTED_ROUTE_COUNT == 12;
    assert REPOINTED_ROUTE_COUNT_BEFORE_2026_09_25 == 5;
    assert REPOINTED_ROUTE_COUNT_BEFORE_2026_09_24 == 2;
    assert REPOINTED_ROUTE_COUNT == REPOINTED_ROUTE_COUNT_BEFORE_2026_09_25 + LEGACY_PATHS_REPOINTED_ON_2026_09_25.len;
}

test the_legacy_http_route_total_is_the_sum_of_its_three_modules {
    assert CATALOG_HTTP_ROUTE_COUNT == 27;
    // 13 until 2026-09-22: 2c21df1 removed /api/test from the quest router on 2026-09-21.
    assert QUEST_HTTP_ROUTE_COUNT == 12;
    assert TECH_TREE_HTTP_ROUTE_COUNT == 4;
    assert CATALOG_HTTP_ROUTE_COUNT + QUEST_HTTP_ROUTE_COUNT + TECH_TREE_HTTP_ROUTE_COUNT == LEGACY_HTTP_ROUTE_COUNT;
    // 44 until 2026-09-22, for the same reason.
    assert LEGACY_HTTP_ROUTE_COUNT == 43;
}

test the_footprint_is_a_list_that_can_be_re_added {
    assert TOTAL_SOURCE_FILE_COUNT == 182;
    assert LEGACY_SOURCE_FILE_COUNT == 25;
    assert LEGACY_SOURCE_LOC == 9193;
    assert legacy_footprint_is_measured(LEGACY_SOURCE_FILE_COUNT, TOTAL_SOURCE_FILE_COUNT, LEGACY_SOURCE_LOC) == true;
    assert legacy_footprint_is_measured(0, TOTAL_SOURCE_FILE_COUNT, LEGACY_SOURCE_LOC) == false;
    assert legacy_footprint_is_measured(LEGACY_SOURCE_FILE_COUNT, TOTAL_SOURCE_FILE_COUNT, 0) == false;
    assert SURVEY_LOC_CLAIM_REPRODUCED == false;
}

test a_gone_surface_is_proved_by_declarations_not_by_a_word_count {
    assert may_claim_surface_is_gone(GARDEN_ROUTE_DECLARATIONS, 0, 0) == true;
    assert GARDEN_ROUTE_DECLARATIONS == 0;
    assert GARDEN_WORD_HITS_IN_CLIENT_ROUTER == 4;
    assert GARDEN_WORD_HITS_IN_CLIENT_ROUTER > GARDEN_ROUTE_DECLARATIONS;
    assert COMPLETED_RETIREMENT_COUNT == 1;
}

test a_surviving_declaration_of_any_kind_defeats_the_claim {
    assert may_claim_surface_is_gone(1, 0, 0) == false;
    assert may_claim_surface_is_gone(0, 1, 0) == false;
    assert may_claim_surface_is_gone(0, 0, 1) == false;
}

test an_orphaned_asset_is_none_of_the_three_states {
    assert asset_is_orphaned(false, 0, ORPHAN_ASSET_TEXT_REFERENCES) == true;
    assert asset_is_orphaned(true, 0, 1) == false;
    assert asset_is_orphaned(false, 1, 1) == false;
    assert asset_is_orphaned(false, 0, 0) == false;
    assert ORPHAN_ASSET_TEXT_REFERENCES == 1;
    // The 2026-09-21 orphan is gone since 2026-09-25; the rule stays for the next one.
    assert ORPHANED_ASSET_REMOVED == true;
    assert ORPHANED_ASSET_REMOVED_AT == CANNABIS_RULING_AT;
}

test the_cannabis_ruling_removes_media_no_rental_path_loaded {
    assert CANNABIS_RULING_SERVED_FILES_REMOVED + CANNABIS_RULING_SERVED_FILES_KEPT == CANNABIS_RULING_SERVED_FILES_BEFORE;
    assert CANNABIS_RULING_SERVED_FILES_REMOVED == 128;
    assert CANNABIS_RULING_SERVED_FILES_KEPT == 13;
    assert CANNABIS_RULING_REMOVED_FILES_A_RENTAL_PATH_LOADED == 0;
    assert CANNABIS_RULING_DROPS_A_TABLE == false;
}

test the_cannabis_ruling_deletes_and_cuts_copy_and_invents_none {
    assert CANNABIS_RULING_AT == "2026-09-25";
    assert CANNABIS_RULING_ITEM == "#12";
    assert CANNABIS_RULING_I18N_KEYS_DELETED == 14;
    assert CANNABIS_RULING_I18N_KEYS_DELETED_UNRENDERED + CANNABIS_RULING_I18N_KEYS_DELETED_RENDERED == CANNABIS_RULING_I18N_KEYS_DELETED;
    assert CANNABIS_RULING_ARMS_CUT == 5;
    assert CANNABIS_RULING_ARMS_ALIGNED_TO_THEIR_TWIN == 2;
    assert CANNABIS_RULING_SENTENCES_INVENTED == 0;
    assert CANNABIS_RULING_KEY_COUNT_OWNER_ID == "turbobaby/locale-policy";
    assert CANNABIS_RULING_KEY_COUNT_OWNER_ID != ID;
    assert CANNABIS_RULING_KEY_COUNT_OWNER_DECL == "TRANSLATION_KEY_COUNT";
    // A copy ruling: no route, no table, no storage key, and the age gate beside the cut clause
    // stayed under it. A later answer the same day removed the gate; see the next test.
    assert CANNABIS_RULING_MOVES_A_ROUTE == false;
    assert CANNABIS_RULING_DROPS_A_TABLE == false;
    assert CANNABIS_RULING_RENAMES_A_STORAGE_KEY == false;
    assert CANNABIS_RULING_RETIRES_THE_AGE_GATE == false;
    assert COMPLETED_RETIREMENT_COUNT == 1;
}

test the_age_gate_question_is_answered_and_recorded_where_the_gate_lived {
    assert AGE_GATE_ANSWER_AT == "2026-09-25";
    assert AGE_GATE_ANSWER_AT == CANNABIS_RULING_AT;
    assert AGE_GATE_ANSWER_LIST == 2;
    assert AGE_GATE_ANSWER_NUMBER == 1;
    assert AGE_GATE_ANSWER_IS_PROVISIONAL == true;
    assert AGE_GATE_DECISION_RECORDED_BY_ID == "turbobaby/checkout-contact";
    assert AGE_GATE_DECISION_RECORDED_BY_ID != ID;
    // Not a surface this file's machine runs, and nothing stored moved.
    assert AGE_GATE_ANSWER_IS_A_SURFACE_RETIREMENT == false;
    assert AGE_GATE_ANSWER_ADDS_A_MIGRATION == false;
    assert AGE_GATE_ANSWER_WRITES_A_ROW == false;
    assert AGE_GATE_ANSWER_RENAMES_A_STORAGE_KEY == false;
    assert CANNABIS_RULING_RETIRES_THE_AGE_GATE == false;
    assert COMPLETED_RETIREMENT_COUNT == 1;
}

test the_reuse_edges_are_named_and_no_sibling_decision_is_restated {
    assert REUSES_BOT_SURFACE_ID == "turbobaby/bot-surface";
    assert REUSES_CATALOG_API_ID == "turbobaby/catalog-api";
