pub const REPOINTED_ROUTE_COUNT_BEFORE_2026_09_24 : u8 = 2;
pub const REPOINTED_WITH_THE_SCREEN_DELETED : u8 = 2;
pub const REPOINTED_KEPT_SCREEN_COUNT_OWNER_ID : str = "turbobaby/events-booking";
pub const REPOINTED_KEPT_SCREEN_COUNT_OWNER_DECL : str = "EVENT_SCREENS_UNROUTED_BY_THE_RULING";
; CORRECTED 2026-09-25: REPOINTED_ROUTE_COUNT was 5, and 5 stays as the reading of 2026-09-24. On the
; owner's answer of 2026-09-25 seven of the eight legacy paths -- LEGACY_PATHS_REPOINTED_ON_2026_09_25
; below -- render the live catalog from their handlers, as /sets and the events paths do, so
; 5 + 7 = 12. They are counted in the kept-screen half: their screens stay compiled and exported
; and are mounted by no handler, like the events screens. Unlike those, the seven are THIS file's
; subject, so their count is declared here and the events count still arrives from its owner.
pub const REPOINTED_ROUTE_COUNT_BEFORE_2026_09_25 : u8 = 5;
pub const REPOINTED_LEGACY_SCREENS_KEPT_UNMOUNTED : u8 = 7;
pub const LEGACY_PATHS_REPOINTED_ON_2026_09_25 : [7]str = ["/accessories", "/tea", "/game", "/treasure-hunt", "/ar-hunt", "/location-quest", "/tech-tree"];

; The split, with the kept half as a parameter: the paths whose screen was deleted are this file's
; count, and the paths whose screen was kept are the owner's above. The set is split when the two
; halves are the whole of REPOINTED_ROUTE_COUNT.
pub fn repointed_set_splits(screens_deleted: u8, screens_kept_unmounted: u8) bool {
    return screens_deleted + screens_kept_unmounted == REPOINTED_ROUTE_COUNT;
}

; The kept half, split again since 2026-09-25: the events screens (their owner's count, a parameter)
; and the seven legacy screens (this file's). The whole set is three parts and nothing else.
pub fn repointed_kept_half_splits(event_screens_kept: u8, legacy_screens_kept: u8) bool {
    return REPOINTED_WITH_THE_SCREEN_DELETED + event_screens_kept + legacy_screens_kept == REPOINTED_ROUTE_COUNT;
}

