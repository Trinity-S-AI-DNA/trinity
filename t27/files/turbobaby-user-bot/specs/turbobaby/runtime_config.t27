// SPDX-License-Identifier: Apache-2.0
; specs/turbobaby/runtime_config.t27 -- what a default is allowed to say, and what an absent
; value is allowed to do
; This contract owns one rule and its census: a default must never name another business and
; must never point off this deployment. Around that rule it owns four measurements nothing else
; in this corpus carries -- the classes of configuration this binary actually reads, the closed
; set of outcomes an absent or malformed value produces, the three places a boot really halts,
; and the inventory of background loops with the intervals their spawn sites declare. It owns no
; value of any variable, decides no feature's behaviour, and starts nothing.
; --
; WHY (measured 2026-09-21). DECISIONS.md:362-363 records the defect exactly: WEB_APP_URL unset
; fell back to the other shop's production URL and BOT_USERNAME defaulted to the other shop's
; bot, so the Telegram menu button and every share link opened another business. Both halves of
; that one defect were repaired on 2026-09-14 and the repairs are NOT the same size. WEB_APP_URL
; got a guard: src/config.rs:118-125 substitutes this deployment's canonical URL when the value
; is blank or contains either of two legacy hostname fragments (:119, :120). BOT_USERNAME got
; none: src/config.rs:135-143 substitutes only when the value is blank or whitespace, and checks
; the content against nothing. So the number that forces this file is a two and a zero. A
; denylist of two entries is not a rule about where a default may point; it is a memory of the
; two hostnames somebody had in front of him, and the third one passes.
; --
; AND THE KNOB ONLY HALF THE DEPLOYMENT OBEYS -- though not by the mechanism a first reading
; suggests. BOT_USERNAME governs the server, and the client reads that variable at 0 sites. The
; client carries the handle as a compile-time literal at six shipped sites across four files, and
; the six are NOT alike. Four are reached only when the Telegram WebApp SDK supplies no username:
; src/ui/share.rs:24 is a const consumed solely through src/ui/share.rs:126, which on wasm32
; prefers TelegramApp::init().bot_username() and falls back to the const, and
; src/ui/screens/profile_screen.rs:744, :898 and :911 each unwrap_or_else over that same read.
; The resolver behind all four is src/ui/telegram.rs:486, which reads initDataUnsafe. Two are
; unconditional and consult nothing: src/ui/pages/referrals.rs:225, the placeholder invite link
; built when telegram_id is 0, and src/ui/screens/home_screen.rs:446, a support href. So the
; defect is open and its mechanism is the platform rather than the compiler -- the client tracks
; whichever bot Telegram says is serving, the server tracks BOT_USERNAME, and nothing makes the
; two agree -- plus two sites that are wrong whatever either of them says. An earlier draft of
; this file called all six unconditional compile-time literals. That was overstated, the four
; fallbacks do track the live bot whenever the SDK answers, and the count is split below.
; --
; WHERE THE BRIEF IS REFUTED, five times, every citation opened on 2026-09-21.
;   1. The brief's reuse list names turbobaby/notification-queue while the thirty IDs the brief
;      itself enumerates do not contain it. The list is right and the enumeration is short: the
;      contract exists. This file's FIRST DRAFT declared the opposite as a refutation -- that no
;      owner existed for that id and that reading the ID line of every file under
;      specs/turbobaby found it nowhere -- and that refutation was a false absence, the one
;      defect a reader trusts without checking. It has been re-measured twice since, the second
;      time on 2026-09-21 at review, by opening every ID line in the corpus rather than by
;      remembering the brief: 43 ID lines read, 42 under specs/turbobaby plus
;      specs/agents/turbobaby.t27, and specs/turbobaby/notification_queue.t27 declares
;      turbobaby/notification-queue and owns the drain's poll interval under the name
;      POLL_INTERVAL_SECONDS. The way the first draft got there is the lesson: an absence
;      measured over specs/ while the corpus is being written is false by the time it is read,
;      and it goes on sounding authoritative for as long as nobody re-runs it. The edge is
;      declared below, the drain's row in the inventory is a marked copy, and the counts are
;      pinned as constants so the next reader re-runs a number instead of trusting a sentence.
;      The source citation src/notification_queue.rs:19 (was :18) stays, because a line into src/ does not
;      go stale the way a line into a sibling spec does.
;   2. The brief attaches "(boot halts)" to turbobaby/schema-provenance. It does not halt, that
;      contract already says so, and this file takes the weaker claim as given: src/main.rs:455
;      reads the missing columns, :460 publishes them as a gauge, :464-470 logs an error and still
;      prints that the database is connected. The boot continues. The three steps that really do
;      halt are named below and the schema check is not one of them.
;   3. The brief lists four background loops -- promo sweep, cart abandonment, notification
;      drain, event reminders. The measured count of recurring interval loops in the shipped
;      binary is eight: those four plus three TTL sweeps (src/main.rs:580, :589, :598) and the
;      six-hourly health digest (:613). Two further spawns exist and are one-shot delayed sends,
;      counted separately below, because an interval invented for a task that runs once would be
;      fiction.
;   4. "src/config.rs (about 556 lines of env resolution)" is 556 lines of file, not of env
;      resolution. The resolver is :69-185; the test module is :316-556, which is 241 of the 556.
;   5. "src/main.rs's wiring of the background loops (about 4599 lines)" is 4599 exactly, and
;      every spawn in that file's shipped code sits above :1243, where the test module opens.
;      Three of the eight loops are not spawned in it at all, so a census taken there alone is
;      short by three; the full spawn census and its four categories are below.
; --
; WHAT THIS FILE NEVER DOES. It publishes no value: not a token, not an API key, not a password,
; not a channel id, not a merchant id, not a database URL, not the canonical web app URL and not
; the two legacy hostname fragments. Those live at src/config.rs:117 and :119-120 and are cited
; by line, never transcribed -- putting another business's hostnames into a published spec buys
; nothing and spreads them. Variables appear by NAME only, and a name is not a value. It did not
; open .env, and it did not open the tracked .env.template either, so whether that template
; covers the names counted here is declared unmeasured below rather than guessed. It invents no
; interval: the eight below are literals read off their spawn sites, and the two one-shot delays
; are named as delays and never as periods. It decides nothing a sibling owns -- not the promo
; sweep's behaviour, not the delivery zone table, not the health digest's claims, not what a
; retired surface is -- and it restates no zone, price, deposit, route, metric name or rate. It
; holds no renter, handle, phone, key code, plate, debt, purchase price or personal note (D14):
; every constant here is a variable name, a file path, a boolean or a count.
; RE-POINTED 2026-09-24: the src/db/mod.rs lines this file cites past line 385 moved four lines
; down when migrations/087_delivery_zones_phuket.sql joined MIGRATIONS, and src/delivery.rs was
; rewritten for the owner's Phuket zones; every such citation below is re-measured. The same
; day migrations/088_unpublish_events.sql joined MIGRATIONS too and moved every src/db/mod.rs
; line past 389 four more; the two cited here are re-measured after it.
; phi^2 + 1/phi^2 = 3 | TRINITY

module turbobaby-runtime-config;

pub const KIND : str = "runtime-configuration-contract";
pub const ID : str = "turbobaby/runtime-config";
pub const NAME : str = "TurboBaby runtime configuration and boot defaults";
pub const WORLD : str = "gHashTag/turbobaby-user-bot";
pub const MEASURED_AT : str = "2026-09-21";
pub const DECISION_RECORD : str = "DECISIONS.md";
pub const GOVERNING_DECISION : str = "D19";
pub const RESOLVER_IMPLEMENTATION : str = "src/config.rs";
pub const BOOT_IMPLEMENTATION : str = "src/main.rs";
pub const POOL_IMPLEMENTATION : str = "src/db/mod.rs";
pub const DEPLOY_NOTICE_IMPLEMENTATION : str = "src/notify.rs";

; --- Reuse edges -------------------------------------------------------------------------------
; Each ID owns a decision this file needs as an abstract parameter and does not restate. The
; boot-halt question is schema-provenance's and its answer for the schema check is no.
; observability owns what a metric and the health digest may claim; this file owns only that the
; digest loop exists and how often it ticks. promo-broadcast owns the sweep's behaviour and its
; interval, which appears in the inventory below as a copied row, not a second decision.
; legacy-retirement owns what the other shop's names are and what "retired" means, so the one
; deliberately-kept retired variable name below is counted here and judged there. delivery-terms
; owns the zone table and the direction of its override's failure, which is the third default
; with a business-identity consequence (the one still open until 2026-09-24; repaired that day). publication owns the rule that a
; thing is claimed only where it was observed, which is why the unread template is a refusal.
; The last three edges, with promo-broadcast, are the contracts that own the WORK of a loop this
; file inventories: notification-queue the drain, events-booking the reminder sweep,
; cart-persistence the abandonment nudge. Each carries its own loop's seconds as a fact of its own
; subject, and this file carries the same seconds as a row of the cadence census. Neither side
; sources the other -- both read one literal in src/, named per row below, and the literal
; arbitrates. cart-persistence states the same division from its side.
pub const REUSES_SCHEMA_PROVENANCE_ID : str = "turbobaby/schema-provenance";
pub const REUSES_OBSERVABILITY_ID : str = "turbobaby/observability";
pub const REUSES_PROMO_BROADCAST_ID : str = "turbobaby/promo-broadcast";
pub const REUSES_LEGACY_RETIREMENT_ID : str = "turbobaby/legacy-retirement";
pub const REUSES_PUBLICATION_ID : str = "turbobaby/publication";
pub const REUSES_DELIVERY_TERMS_ID : str = "turbobaby/delivery-terms";
pub const REUSES_NOTIFICATION_QUEUE_ID : str = "turbobaby/notification-queue";
pub const REUSES_EVENTS_BOOKING_ID : str = "turbobaby/events-booking";
pub const REUSES_CART_PERSISTENCE_ID : str = "turbobaby/cart-persistence";
pub const REUSE_EDGE_COUNT : u8 = 9;

; The re-measurement behind edge seven, pinned so it can be re-run rather than believed. Counted
; by opening the ID line of every .t27 file in the corpus on 2026-09-21 at review, not by reading
; a list handed to this file. A file path is carried instead of a line number on purpose: the
; path is what rglob discovers and it does not move when the sibling is edited.
pub const SPEC_ID_LINES_READ_AT_REVIEW : u8 = 43;
pub const SPEC_ID_LINES_UNDER_TURBOBABY : u8 = 42;
pub const SPEC_ID_LINES_AGENT_CARDS : u8 = 1;
pub const NOTIFICATION_QUEUE_OWNER_EXISTS : bool = true;
pub const NOTIFICATION_QUEUE_OWNER_FILE : str = "specs/turbobaby/notification_queue.t27";
pub const NOTIFICATION_QUEUE_INTERVAL_DECLARATION : str = "POLL_INTERVAL_SECONDS";

; --- The census --------------------------------------------------------------------------------
; Distinct environment variable names the shipped binary reads, counted by opening every
; std::env::var call under src/ plus the two names handed to the collector as literals at
; src/config.rs:77. 24 names reach env::var inside src/config.rs; BOT_TOKEN and DATABASE_URL are
; read through the closure at :77-79 and so appear in no env::var call there; seven further names
; are read only outside the resolver -- DB_POOL_MAX (src/db/mod.rs:598), DELIVERY_ZONES_JSON
; (src/delivery.rs:105), PROMPTPAY_ID (src/promptpay.rs:28), RUST_LOG (src/main.rs:393) and the
; three RAILWAY_GIT_* names (src/notify.rs:78, :84, :85). Configuration is not resolved in one
; place, and the seven are the measure of that.
pub const ENV_NAMES_TOTAL : u8 = 33;
pub const ENV_NAMES_RESOLVED_IN_CONFIG : u8 = 26;
pub const ENV_NAMES_RESOLVED_ELSEWHERE : u8 = 7;
pub const CONFIG_IS_THE_ONLY_RESOLVER : bool = false;
pub const DOTENV_FILE_IS_LOADED_BEST_EFFORT : bool = true;

; --- The classes -------------------------------------------------------------------------------
; A secret is a value whose disclosure is itself the harm. A deployment address names where
; something lives. A behaviour switch changes what the code does without naming a place. The
; brief offers those three; the measured surface needs five, and the two extra classes are
; exactly where the rules differ. A roster is an authorization list whose absence is fatal in
; production and merely loud outside it. A platform fact is injected by the host and its absence
; is not a configuration error at all, so no default of it can be wrong in the D19 sense.
pub const CLASS_SECRET : u8 = 1;
pub const CLASS_ADDRESS : u8 = 2;
pub const CLASS_SWITCH : u8 = 3;
pub const CLASS_ROSTER : u8 = 4;
pub const CLASS_PLATFORM_FACT : u8 = 5;
pub const CLASS_COUNT : u8 = 5;
pub const BRIEF_CLASS_COUNT : u8 = 3;

; Membership, counted by name over the 33. SECRET: BOT_TOKEN, DATABASE_URL, GROK_API_KEY,
; GLM_API_KEY, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, ADMIN_PASSWORD, PROMPTPAY_ID. ADDRESS:
; WEB_APP_URL, APP_URL, WEBHOOK_PATH, PORT, BOT_USERNAME, PROMO_CHANNEL_ID and the five S3
; location names. SWITCH: BACKUP_ASSETS, HIDE_MARKETING_BADGES, REFERRAL_WELCOME_BONUS,
; REFERRAL_SHARE_SOURCES, GARDEN_SHARE_SOURCES, DELIVERY_ZONES_JSON, DB_POOL_MAX, RUST_LOG.
; REFERRAL_WELCOME_BONUS is still parsed into Config::referral_welcome_bonus and read by nobody
; since 2026-09-26: the owner retired the welcome credit (R3, turbobaby/referral-credit), and the
; field stays parsed so that no variable and no count here moves (Config::delivery_zones is the
; precedent of a parsed field nothing reads).
; ROSTER: ADMIN_IDS. PLATFORM_FACT: NODE_ENV, RAILWAY_ENVIRONMENT and the three RAILWAY_GIT_*.
pub const CLASS_COUNTS : [5]u8 = [8, 11, 8, 1, 5];

pub fn class_is_known(class: u8) bool {
  return class >= CLASS_SECRET and class <= CLASS_PLATFORM_FACT;
}

pub fn class_census_total() u8 {
  var total : u8 = 0;
  var i : u8 = 0;
  while (i < CLASS_COUNTS.len) {
    total += CLASS_COUNTS[i];
    i += @as(u8, 1);
  }
  return total;
}

; PROMPTPAY_ID is classed a secret rather than an address on purpose: src/promptpay.rs:19-21
; documents it as a Thai mobile number or a 13-digit national ID, which is a personal identifier
; and a D14 field. The code names it and this repository stores no value of it, which is the only
; correct handling and is recorded here so a future reader does not reclass it as a merchant tag.
pub const MERCHANT_IDENTIFIER_IS_A_D14_FIELD : bool = true;
pub const MERCHANT_IDENTIFIER_VALUE_IS_STORED_IN_REPOSITORY : bool = false;

; --- The rule ----------------------------------------------------------------------------------
; A default is admissible when it names no other business and points nowhere off this deployment.
; Both conditions are needed and neither implies the other: a bare hostname of a dead sibling
; service names no business and still points away, and a branded handle on this host names a
; business without leaving it.
pub fn default_is_admissible(names_another_business: bool, points_off_this_deployment: bool) bool {
  return !names_another_business and !points_off_this_deployment;
}

; Three defaults in the shipped tree have a business-identity consequence. Two were repaired on
; 2026-09-14 (DECISIONS.md:362-363, src/config.rs:110-125 and :135-143). The third is the
; built-in delivery zone table reached when DELIVERY_ZONES_JSON is unset or unparseable; it
; describes another island's villages and its own doc comment says so at src/config.rs:50-52.
; That one is turbobaby/delivery-terms' subject and its verdict is that contract's; counted here
; because a census that dropped it would report the rule as fully satisfied.
; CORRECTED 2026-09-24: all three are repaired. The owner defined TurboBaby's Phuket zones that day
; and src/delivery.rs now carries them as its built-in table (turbobaby/delivery-terms records the
; decision and the rows), so the default no longer names another business's geography; the
; doc comment at src/config.rs:50-52 says so in the same three lines. Measured the same day, and
; narrower than the census suggests: no handler reads that built-in table at all -- the field is
; built at src/config.rs:166 and read nowhere, and the zones customers see are delivery_zones rows.
; The owner edge stays, renamed by what it now records. The 2026-09-22 counts keep their names.
pub const IDENTITY_BEARING_DEFAULTS : u8 = 3;
pub const IDENTITY_BEARING_DEFAULTS_REPAIRED : u8 = 3;
pub const IDENTITY_BEARING_DEFAULTS_OPEN : u8 = 0;
pub const IDENTITY_BEARING_DEFAULTS_REPAIRED_BEFORE_2026_09_24 : u8 = 2;
pub const IDENTITY_BEARING_DEFAULTS_OPEN_BEFORE_2026_09_24 : u8 = 1;
pub const OPEN_DEFAULT_OWNER_ID : str = "turbobaby/delivery-terms";
pub const THIRD_DEFAULT_REPAIRED_AT : str = "2026-09-24";
pub const BUILT_IN_ZONE_TABLE_IS_READ_BY_A_HANDLER : bool = false;

; --- The guard, and its shape --------------------------------------------------------------------
; src/config.rs:118-125. Blank or whitespace, or a value containing either of two legacy hostname
; fragments (:119, :120), is replaced by the canonical URL declared at :117. That is a denylist.
; An allowlist would ask whether the value IS this deployment; a denylist asks whether it is one
; of two remembered wrong answers, and every other wrong answer is admitted.
pub const WEB_APP_URL_GUARD_IS_DENYLIST : bool = true;
pub const WEB_APP_URL_GUARD_IS_ALLOWLIST : bool = false;
pub const WEB_APP_URL_DENYLIST_ENTRIES : u8 = 2;
pub const BOT_USERNAME_CONTENT_CHECKS : u8 = 0;
pub const BOT_USERNAME_BLANK_CHECK_EXISTS : bool = true;
; Re-measured 2026-09-22: still false, and its scope is now worth stating. From that date
; scripts/verify_t27_against_source.py holds WEB_APP_URL_DENYLIST_ENTRIES to the count of
; contains() arms at src/config.rs:119-120, and tests/t27_gates_run.rs runs that script under
; cargo test, so the SIZE of the denylist is pinned. What the guard DOES is not: the test module
; of src/config.rs (:316-556) never resolves WEB_APP_URL, and no file under tests/ calls
; Config::from_env, so a guard that stopped substituting the canonical URL would still pass.
pub const GUARD_IS_PINNED_BY_A_TEST : bool = false;

pub fn wrong_target_is_caught(value_is_blank: bool, value_matches_denylist: bool) bool {
  return value_is_blank or value_matches_denylist;
}

; The resolved value reaches customers through one task: src/main.rs:524-554 sets the Telegram
; default menu button on every boot from config.web_app_url. That task parses the URL (:526) and
; asks nothing about whose it is. So the whole of the admissibility decision lives in the
; resolver, and the delivery path would carry a wrong value to every customer without complaint.
pub const MENU_BUTTON_TASK_SITE : str = "src/main.rs:524";
pub const MENU_BUTTON_TASK_VALIDATES_OWNERSHIP : bool = false;
pub const MENU_BUTTON_TASK_RUNS_EVERY_BOOT : bool = true;

; --- The half-obeyed knob --------------------------------------------------------------------------
pub const BOT_HANDLE_CLIENT_LITERAL_SITES : [6]str = [
  "src/ui/share.rs:24",
  "src/ui/pages/referrals.rs:225",
  "src/ui/screens/home_screen.rs:446",
  "src/ui/screens/profile_screen.rs:744",
  "src/ui/screens/profile_screen.rs:898",
  "src/ui/screens/profile_screen.rs:911"
];
; Addresses re-taken 2026-09-21 and re-read at their new lines after the cart-price edits added
; three lines above each: home_screen :442 -> :445 and profile_screen :740/:894/:907 ->
; :743/:897/:910. Six literals, four files, one claim -- unchanged. Re-taken 2026-09-23: one line
; more above each after T27 defect 2 (home :446, profile :744/:898/:911), same literals.
; Re-taken 2026-09-26 (R3, the referral credit): the referral page's placeholder :184 -> :229, the
; page's request helpers landing above it; same literal. The profile's three kept their lines.
; Re-taken 2026-09-26 again (the referral top list removed on the owner's answer of that day): the
; placeholder :229 -> :225, the list's type, signal and handle leaving above it; same literal.
pub const BOT_HANDLE_CLIENT_LITERAL_FILES : u8 = 4;
pub const BOT_HANDLE_SERVER_READS_ENV : bool = true;

; The six split two ways and the split is the whole finding. Four are fallbacks behind the
; Telegram WebApp SDK: src/ui/share.rs:24 is reached only through src/ui/share.rs:126, and
; src/ui/screens/profile_screen.rs:744, :898, :911 each unwrap_or_else over the same read. The
; resolver they all defer to is src/ui/telegram.rs:486, which takes the handle from initDataUnsafe
; -- so when the SDK answers, those four are right, and they are right about the bot Telegram is
; actually serving rather than about BOT_USERNAME. Two consult nothing and are wrong whenever the
; compiled handle is wrong: src/ui/pages/referrals.rs:225 and src/ui/screens/home_screen.rs:446.
; What holds in every case is that the client reads the environment variable at 0 sites, so the
; server knob does not reach the client by any path, agreeing or not.
pub const BOT_HANDLE_CLIENT_LITERAL_SITES_SDK_FALLBACK : u8 = 4;
pub const BOT_HANDLE_CLIENT_LITERAL_SITES_UNCONDITIONAL : u8 = 2;
pub const BOT_HANDLE_CLIENT_READS_ENV : bool = false;
pub const BOT_HANDLE_CLIENT_RESOLVER_SITE : str = "src/ui/telegram.rs:486";

pub fn knob_governs_whole_deployment(server_reads_env: bool, client_literal_sites: u8) bool {
  return server_reads_env and client_literal_sites == 0;
}

; A client site ships the wrong handle when it consults nothing, or when it would have consulted
; the SDK and the SDK stayed silent.
pub fn handle_is_wrong_when_the_compiled_value_is(sdk_supplies_handle: bool, site_is_unconditional: bool) bool {
  return site_is_unconditional or !sdk_supplies_handle;
}

; --- What an absent or malformed value does ------------------------------------------------------
; A closed set of four outcomes. The order matters only for the range check.
pub const OUTCOME_REFUSE : u8 = 1;
pub const OUTCOME_SUBSTITUTE : u8 = 2;
pub const OUTCOME_DISABLE_ANNOUNCED : u8 = 3;
pub const OUTCOME_DISABLE_UNANNOUNCED : u8 = 4;
pub const OUTCOME_COUNT : u8 = 4;

pub fn outcome_is_known(outcome: u8) bool {
  return outcome >= OUTCOME_REFUSE and outcome <= OUTCOME_DISABLE_UNANNOUNCED;
}

; Refusal is loud and happens before anything serves. Substitution is the quiet one, and it is
; quiet in a specific way that D19 depended on: src/main.rs:435 prints the RESOLVED web app URL
; at boot, and nowhere says it was substituted, so a reader who does not already know the
; canonical value cannot see the fallback in the log he is looking at.
pub fn absence_is_named_at_boot(outcome: u8) bool {
  return outcome == OUTCOME_REFUSE or outcome == OUTCOME_DISABLE_ANNOUNCED;
}
pub const SUBSTITUTION_IS_LABELLED_IN_THE_BOOT_LOG : bool = false;

; Two names are required on every deployment (src/config.rs:77, collected together at :77-85 so
; one boot reports both). One more is required only in production (:99-104), and outside
; production its absence is a warning and admin endpoints reject everything (:106).
pub const REQUIRED_ALWAYS : u8 = 2;
pub const REQUIRED_IN_PRODUCTION_ONLY : u8 = 1;
pub const REQUIRED_NAMES_REPORTED_TOGETHER : bool = true;

pub fn absent_value_refuses_boot(required_always: bool, required_in_production: bool, in_production: bool) bool {
  if (required_always) {
    return true;
  }
  return required_in_production and in_production;
}

; Two names are parsed strictly, so a malformed value refuses the boot rather than being
; swallowed: PORT (src/config.rs:299-314, unset and empty still default) and DB_POOL_MAX
; (src/db/mod.rs:553-575, which also refuses a zero because it would deadlock the first query).
; Six are parsed tolerantly and fall back on garbage. The direction is the finding: strictness is
; the exception, and one of the six tolerant fallbacks is the identity-bearing default that stayed
; open until 2026-09-24 (src/delivery.rs:105-115, :91-101 before that day's rewrite of the file).
pub const STRICTLY_PARSED_NAMES : [2]str = ["PORT", "DB_POOL_MAX"];
pub const TOLERANTLY_PARSED_SITES : [6]str = [
  "src/config.rs:159",
  "src/config.rs:163-165",
  "src/config.rs:168-172",
  "src/config.rs:230-243",
  "src/delivery.rs:105-115",
  "src/promptpay.rs:40-44"
];

pub fn malformed_value_refuses_boot(strictly_parsed: bool) bool {
  return strictly_parsed;
}

; --- What absence turns off, and who is told ------------------------------------------------------
; src/config.rs:202-218 lists the capabilities that are off for want of config, and the boot loop
; at src/main.rs:439-441 warns one line each. The list has exactly two entries and the pure core
; at :209-218 can return no third. Five absences actually turn something off; three of them
; announce themselves only at the moment of use, which is the same shape as the substitution
; above: the boot log understates what this process cannot do.
pub const CAPABILITY_ABSENCES_MEASURED : u8 = 5;
pub const CAPABILITY_ABSENCES_ANNOUNCED_AT_BOOT : u8 = 2;
pub const CAPABILITY_ABSENCES_ANNOUNCED_AT_USE : u8 = 3;
pub const ABSENCE_HANDLING_SITES : [5]str = [
  "src/config.rs:193-195",
  "src/config.rs:187-189",
  "src/api/auth.rs:485-486",
  "src/promo.rs:730",
  "src/promptpay.rs:39-47"
];

; The auth one fails in the safe direction and is recorded because the direction is not
; automatic: with ADMIN_PASSWORD absent the password branch evaluates to false outright
; (src/api/admin.rs:563-564) and the header path warns and falls through (src/api/auth.rs:486).
; An absent secret that opened the door instead would look identical in the boot log.
pub const ABSENT_ADMIN_PASSWORD_FAILS_CLOSED : bool = true;

; --- Where a boot really halts ----------------------------------------------------------------------
; Three steps, each an unhandled Err out of main: config resolution (src/main.rs:409), the
; database connection (:450) and the migration run (:451). One check deliberately does not halt,
; and turbobaby/schema-provenance owns that verdict.
pub const BOOT_HALTING_STEPS : u8 = 3;
pub const BOOT_HALTING_SITES : [3]str = ["src/main.rs:409", "src/main.rs:450", "src/main.rs:451"];
pub const BOOT_NON_HALTING_CHECKS : u8 = 1;
pub const BOOT_NON_HALTING_CHECK_SITE : str = "src/main.rs:455";
pub const SCHEMA_CHECK_HALTS_BOOT : bool = false;

pub fn boot_reaches_serving(config_resolved: bool, database_connected: bool, migrations_applied: bool) bool {
  return config_resolved and database_connected and migrations_applied;
}

; --- Deployment class -------------------------------------------------------------------------------
; Three independent sites resolve the same question with the same OR: src/config.rs:91-92,
; src/main.rs:338-340 and src/notify.rs:10-11. src/main.rs:326-329 admits the duplication and
; gives its reason -- the subscriber has to exist before Config is parsed. The consequence worth
; naming is that there is no third class: src/main.rs:1576-1583 pins that ANY value of
; RAILWAY_ENVIRONMENT, including "staging" and the empty string, is production, so a staging
; deployment inherits production's mandatory roster.
pub const PRODUCTION_DETECTORS : u8 = 3;
pub const PRODUCTION_DETECTOR_SITES : [3]str = [
  "src/config.rs:91-92",
  "src/main.rs:338-340",
  "src/notify.rs:10-11"
];
pub const DEPLOYMENT_CLASSES : u8 = 2;
pub const STAGING_IS_A_DISTINCT_CLASS : bool = false;

pub fn production_detected(node_env_is_production: bool, railway_env_present: bool) bool {
  return node_env_is_production or railway_env_present;
}

; --- One retired name kept on purpose -------------------------------------------------------------
; src/config.rs:178-183 reads REFERRAL_SHARE_SOURCES and falls back to a variable named after the
; retired garden mechanic. src/config.rs:173-177 states the reason: the old name is set on the
; running deployment, and renaming a key in code does not rename it in the platform, so dropping
; it would revert the live split to defaults under cover of a rename. turbobaby/legacy-retirement
; owns what retirement means; this file owns only that the rename would have been a silent
; configuration change, and the rule that makes that judgement general.
pub const RETIRED_NAMES_KEPT_AS_LIVE_FALLBACKS : u8 = 1;
pub const RETIRED_NAME_FALLBACK_SITE : str = "src/config.rs:178-183";
pub const RETIRED_NAME_FALLBACK_REASON_IS_RECORDED : bool = true;

pub fn renaming_a_key_is_safe(old_name_still_read: bool, deployment_still_sets_old_name: bool) bool {
  return old_name_still_read or !deployment_still_sets_old_name;
}

; --- The background loops ---------------------------------------------------------------------------
; Eight recurring interval loops in the shipped binary, in spawn order. Every interval below is a
; literal at the site named, never an environment value. THE INVENTORY IS THIS FILE'S -- how many
; loops there are, what each one waits, and where each literal sits is the measurement nothing
; else in the corpus carries, and turbobaby/cart-persistence says so from its side. What this file
; does NOT own is any loop's BEHAVIOUR. Four rows have a sibling that owns the work its loop does
; and carries the same seconds as a fact of its own subject: index 0 and
; turbobaby/promo-broadcast's SWEEP_INTERVAL_SECONDS, index 5 and turbobaby/events-booking's
; REMINDER_SWEEP_SECONDS, index 6 and turbobaby/cart-persistence's
; ABANDON_SWEEP_INTERVAL_SECONDS, index 7 and turbobaby/notification-queue's
; POLL_INTERVAL_SECONDS -- the last being the contract an earlier draft of this file reported as
; nonexistent. Neither side is the other's source. Both read the same literal in src/, named per
; row below, and if the two ever disagree THE LITERAL is right and both are stale. Index 4's
; six-hour window is the same six the digest reports on (src/main.rs:612), and what the digest may
; CLAIM is turbobaby/observability's.
pub const RECURRING_LOOPS : u8 = 8;
pub const ROWS_WITH_A_BEHAVIOUR_OWNER : u8 = 4;
pub const ROWS_WITH_NO_OTHER_CONTRACT : u8 = 4;
pub const SHARED_ROW_INDICES : [4]u8 = [0, 5, 6, 7];
pub const SHARED_ROW_BEHAVIOUR_OWNER_IDS : [4]str = [
  "turbobaby/promo-broadcast",
  "turbobaby/events-booking",
  "turbobaby/cart-persistence",
  "turbobaby/notification-queue"
];
pub const INTERVAL_ARBITER_IS_THE_SOURCE_LITERAL : bool = true;

; THE EDGE BACK IS NOT SYMMETRIC, and the asymmetry is measured rather than assumed (2026-09-21
; at review, by opening the reuse constants of all four behaviour owners). Two of the four declare
; turbobaby/runtime-config and two declare nothing. turbobaby/cart-persistence declares
; REUSES_RUNTIME_CONFIG_ID and marks its ABANDON_SWEEP_INTERVAL_SECONDS as a copy of a row in this
; inventory; turbobaby/notification-queue declares REUSES_RUNTIME_CONFIG_ID and marks
; POLL_INTERVAL_SECONDS the same way. turbobaby/promo-broadcast declares SWEEP_INTERVAL_SECONDS and
; turbobaby/events-booking declares REMINDER_SWEEP_SECONDS, and neither of those two names this
; contract at all -- the string turbobaby/runtime-config does not occur in either file, in a
; constant or in prose, read one file at a time on that date. Other contracts DO name this one for
; reasons that have nothing to do with a loop cadence; turbobaby/customer-surface declares
; REUSES_RUNTIME_CONFIG_ID and carries no interval of its own. How many files name this contract in
; total is deliberately NOT pinned here: that figure moved while this section was being written,
; because the rest of the corpus was under edit at the same time, and a number that moves between
; two readings of the same afternoon is not a measurement of anything. The per-owner reading is,
; and it is what the constants below record. Both missing halves live in files this contract is not
; editing, so what is done here is to count the gap and name it where it can be seen. The count is
; worth a constant because an unreciprocated copy is exactly how a number in two places drifts in
; silence: both rows read one literal in src/, and if only one side knows the other exists, only
; one side ever gets corrected when the literal moves.
pub const SHARED_ROWS_WITH_A_RECIPROCAL_EDGE : u8 = 2;
pub const SHARED_ROWS_WITHOUT_A_RECIPROCAL_EDGE : u8 = 2;
pub const RECIPROCAL_EDGE_OWNER_IDS : [2]str = [
  "turbobaby/cart-persistence",
  "turbobaby/notification-queue"
];
pub const MISSING_RECIPROCAL_EDGE_OWNER_IDS : [2]str = [
  "turbobaby/promo-broadcast",
  "turbobaby/events-booking"
];
pub const MISSING_RECIPROCAL_EDGE_DECLARATIONS : [2]str = [
  "SWEEP_INTERVAL_SECONDS",
  "REMINDER_SWEEP_SECONDS"
];
pub const MISSING_RECIPROCAL_EDGES_ARE_FIXED_HERE : bool = false;
pub const LOOP_NAMES : [8]str = [
  "promo_sweep",
  "idempotency_ttl_sweep",
  "fraud_events_ttl_sweep",
  "block_history_ttl_sweep",
  "health_digest",
  "event_reminders",
  "cart_abandonment",
  "notification_drain"
];
pub const LOOP_INTERVAL_SECONDS : [8]u32 = [900, 3600, 86400, 86400, 21600, 300, 300, 30];
pub const LOOP_SPAWN_SITES : [8]str = [
  "src/main.rs:498",
  "src/main.rs:580",
  "src/main.rs:589",
  "src/main.rs:598",
  "src/main.rs:613",
  "src/main.rs:641",
  "src/main.rs:656",
  "src/main.rs:669"
];
pub const LOOP_INTERVAL_LITERAL_SITES : [8]str = [
  "src/main.rs:499",
  "src/main.rs:580",
  "src/main.rs:589",
  "src/main.rs:598",
  "src/main.rs:614",
  "src/main.rs:641",
  "src/main.rs:660",
  "src/notification_queue.rs:19"
];
pub const LOOP_INTERVALS_DECLARED_IN_MAIN : u8 = 7;
pub const LOOP_INTERVALS_DECLARED_ELSEWHERE : u8 = 1;
pub const LOOP_INTERVALS_READ_FROM_ENV : u8 = 0;

; All eight discard their first tick, so a cold start never competes with migrations and the
; first requests: src/main.rs:502 and :306 and :615, src/api/events.rs:2168 (was :1800, then :2028),
; src/cart_abandonment.rs:27, src/notification_queue.rs:33 (was :32). This is a property of the whole set,
; which is why it is worth a number rather than a note.
pub const LOOPS_DISCARDING_FIRST_TICK : u8 = 8;

pub fn first_work_is_due_after(interval_seconds: u32, first_tick_discarded: bool) u32 {
  if (first_tick_discarded) {
    return interval_seconds + interval_seconds;
  }
  return interval_seconds;
}

pub fn shortest_loop_interval() u32 {
  var shortest : u32 = LOOP_INTERVAL_SECONDS[0];
  var i : u8 = 1;
  while (i < RECURRING_LOOPS) {
    if (LOOP_INTERVAL_SECONDS[i] < shortest) {
      shortest = LOOP_INTERVAL_SECONDS[i];
    }
    i += @as(u8, 1);
  }
  return shortest;
}

pub fn longest_loop_interval() u32 {
  var longest : u32 = LOOP_INTERVAL_SECONDS[0];
  var i : u8 = 1;
  while (i < RECURRING_LOOPS) {
    if (LOOP_INTERVAL_SECONDS[i] > longest) {
      longest = LOOP_INTERVAL_SECONDS[i];
    }
    i += @as(u8, 1);
  }
  return longest;
}

; --- What else is spawned, counted apart ------------------------------------------------------------
; Nineteen tokio::spawn expressions exist in shipped code and only nine are reached by a boot.
; The boot nine: six in src/main.rs (:304, :498, :524, :563, :613, :676) and three in the loop
; modules (src/api/events.rs:2166 -- :1798, then :2026, as the 2026-09-21 events edits moved it --
; src/cart_abandonment.rs:25, src/notification_queue.rs:29 -- was :28, moved by the 2026-09-21
; drain rewrite, which added one import line and no spawn). The
; other ten are fire-and-forget, spawned per request or per event -- src/main.rs:185 and
; src/api/client_errors.rs:462, src/api/orders.rs:1596, :2269, :2468, src/api/quest.rs:175, :413,
; :659, src/bot/commands.rs:285, src/promo.rs:762 -- and not one of the ten opens an interval or
; a loop, which is what holds the recurring count at eight. Counting spawn expressions and
; calling the answer the number of loops would have returned nineteen; counting only the ones in
; src/main.rs would have returned seven and missed three real loops. Expressions are not tasks
; either: :304 is the shared TTL helper, called three times (:580, :589, :598), so it yields two
; tasks more than it has expressions. Of the eleven long-lived tasks a boot leaves running, eight
; are the loops above, two are one-shot delayed sends -- the menu button after two seconds
; (:524-525) and the deploy notice after three (:563-565) -- and one is the dispatcher (:676).
; RE-MEASURED 2026-09-26: twenty expressions. The eleventh fire-and-forget one is the admins'
; notice of a new referral-credit request (post_my_request in src/api/referral_credit.rs, R3),
; spawned after the request's commit so a failed send never fails the request; it opens no
; interval or loop, so the recurring count still holds at eight. The readings before keep their
; _BEFORE_2026_09_26 names.
pub const SPAWN_EXPRESSIONS_IN_SHIPPED_CODE : u8 = 20;
pub const BOOT_SPAWN_EXPRESSIONS : u8 = 9;
pub const BOOT_SPAWN_EXPRESSIONS_IN_MAIN : u8 = 6;
pub const BOOT_SPAWN_EXPRESSIONS_ELSEWHERE : u8 = 3;
pub const FIRE_AND_FORGET_SPAWN_EXPRESSIONS : u8 = 11;
pub const SPAWN_EXPRESSIONS_IN_SHIPPED_CODE_BEFORE_2026_09_26 : u8 = 19;
pub const FIRE_AND_FORGET_SPAWN_EXPRESSIONS_BEFORE_2026_09_26 : u8 = 10;
pub const FIRE_AND_FORGET_RECURRING_LOOPS : u8 = 0;
pub const TTL_SWEEP_CALL_SITES : u8 = 3;
pub const EXTRA_TTL_INVOCATIONS : u8 = 2;
pub const ONE_SHOT_DELAYED_TASKS : u8 = 2;
pub const ONE_SHOT_DELAY_SECONDS : [2]u32 = [2, 3];
pub const DISPATCHER_TASKS : u8 = 1;
pub const LONG_LIVED_TASKS_AT_BOOT : u8 = 11;
pub const REFERRAL_WELCOME_BONUS_IS_READ : bool = false;
pub const REFERRAL_WELCOME_BONUS_UNREAD_SINCE : str = "2026-09-26";

pub fn boot_tasks_from_expressions(boot_expressions: u8, extra_ttl_invocations: u8) u8 {
  return boot_expressions + extra_ttl_invocations;
}

; A one-shot delay is not a period, and the distinction is load-bearing: the menu button task is
; the only thing that carries the resolved web app URL to Telegram, it runs once per boot, and a
; wrong value therefore persists for the life of the process with no second chance to notice it.
pub fn delay_is_a_period(task_repeats: bool) bool {
  return task_repeats;
}

; --- Refusals ------------------------------------------------------------------------------------
; Three things this repository does not publish, declared rather than estimated.
pub const LIVE_VALUES_PUBLISHED : [0]str = [];
pub const CONFIG_TEMPLATE_IS_TRACKED : bool = true;
pub const CONFIG_TEMPLATE_WAS_OPENED : bool = false;
pub const TEMPLATE_COVERAGE_NOTE : str = "A file named .env.template is tracked in this repository. This contract did not open it: it is a configuration file by name, and the rule that keeps a spec from carrying secrets is worth more than one coverage number. So whether the template names all 33 measured variables, or a subset, or names some that no code reads, is UNMEASURED here rather than asserted. Closing it needs a reader who is allowed to open configuration files, or a test that diffs the template's keys against the env::var call sites under src/ -- which does not exist: no test in this tree reads that file.";
pub const DEPLOYMENT_ENV_IS_READABLE_FROM_THIS_REPOSITORY : bool = false;
pub const DEPLOYMENT_ENV_NOTE : str = "Which variables are actually set on the running deployment cannot be established from this tree, and three statements in the code depend on it being one way rather than another: src/config.rs:173-177 asserts that the platform still holds the retired share-sources key, src/config.rs:110-115 asserts that WEB_APP_URL was unset in production before 2026-09-14, and the whole admissibility rule is only interesting where a default is actually reached. All three are recorded as the code's claims, cited by line, and none is upgraded here into a measurement. The honest state is that this file measures what the code DOES with an absent value and never how often a value is absent.";
pub const DEFAULT_MISUSE_FREQUENCY_IS_MEASURED : bool = false;
pub const MISUSE_FREQUENCY_NOTE : str = "How long the D19 defect was live, and how many customers opened the other shop, is not in this repository. There is no log corpus, no analytics table and no incident record here; DECISIONS.md:356-363 gives the owner's mandate and the fact of the defect, with no interval and no count. A number for either would have to be invented, so none is given. What replaces it is the structural measurement above: the guard is a denylist of two, the second half of the same defect has a guard of zero, and the delivery task validates nothing -- three facts that hold whatever the frequency was.";

; --- Tests -------------------------------------------------------------------------------------------

test the_class_census_closes_over_the_measured_surface {
  assert ENV_NAMES_RESOLVED_IN_CONFIG + ENV_NAMES_RESOLVED_ELSEWHERE == ENV_NAMES_TOTAL;
  assert class_census_total() == ENV_NAMES_TOTAL;
  assert CLASS_COUNTS.len == CLASS_COUNT;
  assert CLASS_COUNT > BRIEF_CLASS_COUNT;
  assert class_is_known(CLASS_SECRET) == true;
  assert class_is_known(CLASS_PLATFORM_FACT) == true;
  assert class_is_known(0) == false;
  assert class_is_known(6) == false;
}

test configuration_is_not_resolved_in_one_place {
  assert CONFIG_IS_THE_ONLY_RESOLVER == false;
  assert ENV_NAMES_RESOLVED_ELSEWHERE == 7;
  assert DOTENV_FILE_IS_LOADED_BEST_EFFORT == true;
}

test a_default_must_clear_both_halves_of_the_rule {
  assert default_is_admissible(false, false) == true;
  assert default_is_admissible(true, false) == false;
  assert default_is_admissible(false, true) == false;
  assert default_is_admissible(true, true) == false;
}

test the_identity_bearing_defaults_are_counted_and_none_is_open_since_the_zone_decision {
  assert IDENTITY_BEARING_DEFAULTS_REPAIRED + IDENTITY_BEARING_DEFAULTS_OPEN == IDENTITY_BEARING_DEFAULTS;
  assert IDENTITY_BEARING_DEFAULTS_OPEN == 0;
  assert IDENTITY_BEARING_DEFAULTS_REPAIRED == IDENTITY_BEARING_DEFAULTS;
  assert IDENTITY_BEARING_DEFAULTS_OPEN_BEFORE_2026_09_24 == 1;
  assert IDENTITY_BEARING_DEFAULTS_REPAIRED_BEFORE_2026_09_24 + IDENTITY_BEARING_DEFAULTS_OPEN_BEFORE_2026_09_24 == IDENTITY_BEARING_DEFAULTS;
  assert THIRD_DEFAULT_REPAIRED_AT == "2026-09-24";
  assert BUILT_IN_ZONE_TABLE_IS_READ_BY_A_HANDLER == false;
  assert OPEN_DEFAULT_OWNER_ID == "turbobaby/delivery-terms";
  assert OPEN_DEFAULT_OWNER_ID != ID;
}

test a_denylist_of_two_admits_the_third_wrong_answer {
  assert WEB_APP_URL_GUARD_IS_DENYLIST == true;
  assert WEB_APP_URL_GUARD_IS_ALLOWLIST == false;
  assert WEB_APP_URL_DENYLIST_ENTRIES == 2;
  assert wrong_target_is_caught(true, false) == true;
  assert wrong_target_is_caught(false, true) == true;
  assert wrong_target_is_caught(false, false) == false;
}

test the_second_half_of_the_same_defect_got_no_guard {
  assert BOT_USERNAME_CONTENT_CHECKS == 0;
  assert BOT_USERNAME_BLANK_CHECK_EXISTS == true;
  assert BOT_USERNAME_CONTENT_CHECKS < WEB_APP_URL_DENYLIST_ENTRIES;
  assert GUARD_IS_PINNED_BY_A_TEST == false;
}

test the_delivery_path_asks_nothing_about_whose_url_it_carries {
  assert MENU_BUTTON_TASK_VALIDATES_OWNERSHIP == false;
  assert MENU_BUTTON_TASK_RUNS_EVERY_BOOT == true;
  assert delay_is_a_period(false) == false;
  assert delay_is_a_period(true) == true;
}

test the_handle_knob_governs_the_server_only {
  assert BOT_HANDLE_CLIENT_LITERAL_SITES.len == 6;
  assert BOT_HANDLE_CLIENT_LITERAL_FILES == 4;
  assert knob_governs_whole_deployment(true, 6) == false;
  assert knob_governs_whole_deployment(true, 0) == true;
  assert knob_governs_whole_deployment(false, 0) == false;
  assert BOT_HANDLE_CLIENT_READS_ENV == false;
}

test the_six_client_sites_are_not_alike {
  assert BOT_HANDLE_CLIENT_LITERAL_SITES_SDK_FALLBACK + BOT_HANDLE_CLIENT_LITERAL_SITES_UNCONDITIONAL == 6;
  assert BOT_HANDLE_CLIENT_LITERAL_SITES_SDK_FALLBACK == 4;
  assert BOT_HANDLE_CLIENT_LITERAL_SITES_UNCONDITIONAL == 2;
  assert handle_is_wrong_when_the_compiled_value_is(true, false) == false;
  assert handle_is_wrong_when_the_compiled_value_is(false, false) == true;
  assert handle_is_wrong_when_the_compiled_value_is(true, true) == true;
  assert handle_is_wrong_when_the_compiled_value_is(false, true) == true;
  assert BOT_HANDLE_CLIENT_RESOLVER_SITE == "src/ui/telegram.rs:486";
}

test the_outcomes_of_an_absent_value_form_a_closed_set {
  assert outcome_is_known(OUTCOME_REFUSE) == true;
  assert outcome_is_known(OUTCOME_SUBSTITUTE) == true;
  assert outcome_is_known(OUTCOME_DISABLE_ANNOUNCED) == true;
  assert outcome_is_known(OUTCOME_DISABLE_UNANNOUNCED) == true;
  assert outcome_is_known(0) == false;
  assert outcome_is_known(5) == false;
  assert OUTCOME_DISABLE_UNANNOUNCED == OUTCOME_COUNT;
}

test only_refusal_and_an_announced_disable_are_visible_at_boot {
  assert absence_is_named_at_boot(OUTCOME_REFUSE) == true;
  assert absence_is_named_at_boot(OUTCOME_DISABLE_ANNOUNCED) == true;
  assert absence_is_named_at_boot(OUTCOME_SUBSTITUTE) == false;
  assert absence_is_named_at_boot(OUTCOME_DISABLE_UNANNOUNCED) == false;
  assert SUBSTITUTION_IS_LABELLED_IN_THE_BOOT_LOG == false;
}

test refusal_to_start_depends_on_the_deployment_class_for_exactly_one_name {
  assert absent_value_refuses_boot(true, false, false) == true;
  assert absent_value_refuses_boot(true, false, true) == true;
  assert absent_value_refuses_boot(false, true, true) == true;
  assert absent_value_refuses_boot(false, true, false) == false;
  assert absent_value_refuses_boot(false, false, true) == false;
  assert REQUIRED_ALWAYS == 2;
  assert REQUIRED_IN_PRODUCTION_ONLY == 1;
}

test strict_parsing_is_the_exception {
  assert STRICTLY_PARSED_NAMES.len == 2;
  assert TOLERANTLY_PARSED_SITES.len == 6;
  assert TOLERANTLY_PARSED_SITES.len > STRICTLY_PARSED_NAMES.len;
  assert malformed_value_refuses_boot(true) == true;
  assert malformed_value_refuses_boot(false) == false;
}

test the_boot_log_understates_what_is_off {
  assert CAPABILITY_ABSENCES_ANNOUNCED_AT_BOOT + CAPABILITY_ABSENCES_ANNOUNCED_AT_USE == CAPABILITY_ABSENCES_MEASURED;
  assert ABSENCE_HANDLING_SITES.len == CAPABILITY_ABSENCES_MEASURED;
  assert CAPABILITY_ABSENCES_ANNOUNCED_AT_BOOT == 2;
  assert ABSENT_ADMIN_PASSWORD_FAILS_CLOSED == true;
}

test three_steps_halt_a_boot_and_the_schema_check_is_not_one {
  assert BOOT_HALTING_SITES.len == BOOT_HALTING_STEPS;
  assert SCHEMA_CHECK_HALTS_BOOT == false;
  assert BOOT_NON_HALTING_CHECKS == 1;
  assert boot_reaches_serving(true, true, true) == true;
  assert boot_reaches_serving(false, true, true) == false;
  assert boot_reaches_serving(true, false, true) == false;
  assert boot_reaches_serving(true, true, false) == false;
}

test one_question_is_answered_in_three_places_and_admits_two_classes {
  assert PRODUCTION_DETECTOR_SITES.len == PRODUCTION_DETECTORS;
  assert production_detected(true, false) == true;
  assert production_detected(false, true) == true;
  assert production_detected(true, true) == true;
  assert production_detected(false, false) == false;
  assert DEPLOYMENT_CLASSES == 2;
  assert STAGING_IS_A_DISTINCT_CLASS == false;
}

test renaming_a_live_key_is_a_configuration_change_in_disguise {
  assert renaming_a_key_is_safe(true, true) == true;
  assert renaming_a_key_is_safe(false, true) == false;
  assert renaming_a_key_is_safe(false, false) == true;
  assert renaming_a_key_is_safe(true, false) == true;
  assert RETIRED_NAMES_KEPT_AS_LIVE_FALLBACKS == 1;
  assert RETIRED_NAME_FALLBACK_REASON_IS_RECORDED == true;
}

test the_loop_inventory_is_complete_and_every_row_has_its_line {
  assert LOOP_NAMES.len == RECURRING_LOOPS;
  assert LOOP_INTERVAL_SECONDS.len == RECURRING_LOOPS;
  assert LOOP_SPAWN_SITES.len == RECURRING_LOOPS;
  assert LOOP_INTERVAL_LITERAL_SITES.len == RECURRING_LOOPS;
  assert LOOP_INTERVALS_DECLARED_IN_MAIN + LOOP_INTERVALS_DECLARED_ELSEWHERE == RECURRING_LOOPS;
  assert LOOPS_DISCARDING_FIRST_TICK == RECURRING_LOOPS;
}

test every_shared_interval_row_names_the_contract_that_owns_its_behaviour {
  assert ROWS_WITH_A_BEHAVIOUR_OWNER + ROWS_WITH_NO_OTHER_CONTRACT == RECURRING_LOOPS;
  assert SHARED_ROW_BEHAVIOUR_OWNER_IDS.len == ROWS_WITH_A_BEHAVIOUR_OWNER;
  assert SHARED_ROW_INDICES.len == ROWS_WITH_A_BEHAVIOUR_OWNER;
  assert SHARED_ROW_BEHAVIOUR_OWNER_IDS[0] == REUSES_PROMO_BROADCAST_ID;
  assert SHARED_ROW_BEHAVIOUR_OWNER_IDS[1] == REUSES_EVENTS_BOOKING_ID;
  assert SHARED_ROW_BEHAVIOUR_OWNER_IDS[2] == REUSES_CART_PERSISTENCE_ID;
  assert SHARED_ROW_BEHAVIOUR_OWNER_IDS[3] == REUSES_NOTIFICATION_QUEUE_ID;
  assert SHARED_ROW_INDICES[0] == 0;
  assert SHARED_ROW_INDICES[3] == 7;
  assert SHARED_ROW_BEHAVIOUR_OWNER_IDS[3] != ID;
  assert INTERVAL_ARBITER_IS_THE_SOURCE_LITERAL == true;
}

test the_measured_intervals_span_thirty_seconds_to_a_day {
  assert shortest_loop_interval() == 30;
  assert longest_loop_interval() == 86400;
  assert LOOP_INTERVAL_SECONDS[0] == 900;
  assert LOOP_INTERVAL_SECONDS[4] == 21600;
  assert LOOP_INTERVAL_SECONDS[5] == LOOP_INTERVAL_SECONDS[6];
  assert LOOP_INTERVALS_READ_FROM_ENV == 0;
}

test a_discarded_first_tick_doubles_the_wait_for_first_work {
  assert first_work_is_due_after(300, true) == 600;
  assert first_work_is_due_after(300, false) == 300;
  assert first_work_is_due_after(30, true) == 60;
  assert first_work_is_due_after(86400, true) == 172800;
}

test spawn_expressions_and_boot_tasks_are_different_counts_and_reconcile {
  assert BOOT_SPAWN_EXPRESSIONS_IN_MAIN + BOOT_SPAWN_EXPRESSIONS_ELSEWHERE == BOOT_SPAWN_EXPRESSIONS;
  assert BOOT_SPAWN_EXPRESSIONS + FIRE_AND_FORGET_SPAWN_EXPRESSIONS == SPAWN_EXPRESSIONS_IN_SHIPPED_CODE;
  assert BOOT_SPAWN_EXPRESSIONS + FIRE_AND_FORGET_SPAWN_EXPRESSIONS_BEFORE_2026_09_26 == SPAWN_EXPRESSIONS_IN_SHIPPED_CODE_BEFORE_2026_09_26;
  assert SPAWN_EXPRESSIONS_IN_SHIPPED_CODE - SPAWN_EXPRESSIONS_IN_SHIPPED_CODE_BEFORE_2026_09_26 == 1;
  assert FIRE_AND_FORGET_RECURRING_LOOPS == 0;
  assert TTL_SWEEP_CALL_SITES - 1 == EXTRA_TTL_INVOCATIONS;
  assert boot_tasks_from_expressions(BOOT_SPAWN_EXPRESSIONS, EXTRA_TTL_INVOCATIONS) == LONG_LIVED_TASKS_AT_BOOT;
  assert RECURRING_LOOPS + ONE_SHOT_DELAYED_TASKS + DISPATCHER_TASKS == LONG_LIVED_TASKS_AT_BOOT;
  assert ONE_SHOT_DELAY_SECONDS.len == ONE_SHOT_DELAYED_TASKS;
  assert ONE_SHOT_DELAY_SECONDS[0] == 2;
  assert ONE_SHOT_DELAY_SECONDS[1] == 3;
}

test the_notification_queue_owner_exists_and_was_re_measured_at_review {
  assert NOTIFICATION_QUEUE_OWNER_EXISTS == true;
  assert SPEC_ID_LINES_UNDER_TURBOBABY + SPEC_ID_LINES_AGENT_CARDS == SPEC_ID_LINES_READ_AT_REVIEW;
  assert SPEC_ID_LINES_READ_AT_REVIEW == 43;
  assert NOTIFICATION_QUEUE_OWNER_FILE == "specs/turbobaby/notification_queue.t27";
  assert NOTIFICATION_QUEUE_INTERVAL_DECLARATION == "POLL_INTERVAL_SECONDS";
  assert REUSES_NOTIFICATION_QUEUE_ID == SHARED_ROW_BEHAVIOUR_OWNER_IDS[3];
}

test two_of_the_four_behaviour_owners_declare_the_edge_back_and_two_do_not {
  assert SHARED_ROWS_WITH_A_RECIPROCAL_EDGE + SHARED_ROWS_WITHOUT_A_RECIPROCAL_EDGE == ROWS_WITH_A_BEHAVIOUR_OWNER;
  assert RECIPROCAL_EDGE_OWNER_IDS.len == SHARED_ROWS_WITH_A_RECIPROCAL_EDGE;
  assert MISSING_RECIPROCAL_EDGE_OWNER_IDS.len == SHARED_ROWS_WITHOUT_A_RECIPROCAL_EDGE;
  assert MISSING_RECIPROCAL_EDGE_DECLARATIONS.len == SHARED_ROWS_WITHOUT_A_RECIPROCAL_EDGE;
  assert RECIPROCAL_EDGE_OWNER_IDS[0] == REUSES_CART_PERSISTENCE_ID;
  assert RECIPROCAL_EDGE_OWNER_IDS[1] == REUSES_NOTIFICATION_QUEUE_ID;
  assert MISSING_RECIPROCAL_EDGE_OWNER_IDS[0] == REUSES_PROMO_BROADCAST_ID;
  assert MISSING_RECIPROCAL_EDGE_OWNER_IDS[1] == REUSES_EVENTS_BOOKING_ID;
  assert MISSING_RECIPROCAL_EDGE_DECLARATIONS[0] == "SWEEP_INTERVAL_SECONDS";
  assert MISSING_RECIPROCAL_EDGE_DECLARATIONS[1] == "REMINDER_SWEEP_SECONDS";
  assert MISSING_RECIPROCAL_EDGES_ARE_FIXED_HERE == false;
}

test the_reuse_edges_are_ids_and_none_of_them_is_this_file {
  assert REUSES_SCHEMA_PROVENANCE_ID == "turbobaby/schema-provenance";
  assert REUSES_OBSERVABILITY_ID == "turbobaby/observability";
  assert REUSES_PROMO_BROADCAST_ID == "turbobaby/promo-broadcast";
  assert REUSES_LEGACY_RETIREMENT_ID == "turbobaby/legacy-retirement";
  assert REUSES_PUBLICATION_ID == "turbobaby/publication";
  assert REUSES_DELIVERY_TERMS_ID == "turbobaby/delivery-terms";
  assert REUSES_NOTIFICATION_QUEUE_ID == "turbobaby/notification-queue";
  assert REUSES_EVENTS_BOOKING_ID == "turbobaby/events-booking";
  assert REUSES_CART_PERSISTENCE_ID == "turbobaby/cart-persistence";
  assert REUSE_EDGE_COUNT == 9;
  assert REUSES_SCHEMA_PROVENANCE_ID != ID;
  assert REUSES_PROMO_BROADCAST_ID != ID;
  assert REUSES_NOTIFICATION_QUEUE_ID != ID;
}

test what_is_not_measured_says_so {
  assert LIVE_VALUES_PUBLISHED.len == 0;
  assert CONFIG_TEMPLATE_IS_TRACKED == true;
  assert CONFIG_TEMPLATE_WAS_OPENED == false;
  assert DEPLOYMENT_ENV_IS_READABLE_FROM_THIS_REPOSITORY == false;
  assert DEFAULT_MISUSE_FREQUENCY_IS_MEASURED == false;
  assert MERCHANT_IDENTIFIER_VALUE_IS_STORED_IN_REPOSITORY == false;
}

; --- Invariants ----------------------------------------------------------------------------------------

invariant every_measured_variable_belongs_to_exactly_one_class
  assert class_census_total() == ENV_NAMES_TOTAL and ENV_NAMES_RESOLVED_IN_CONFIG + ENV_NAMES_RESOLVED_ELSEWHERE == ENV_NAMES_TOTAL

invariant a_default_that_names_another_business_is_never_admissible
  assert default_is_admissible(true, false) == false and default_is_admissible(true, true) == false

invariant a_default_that_points_off_this_deployment_is_never_admissible
  assert default_is_admissible(false, true) == false and default_is_admissible(true, true) == false

invariant the_shipped_guard_is_a_denylist_and_lets_an_unlisted_wrong_target_through
  assert WEB_APP_URL_GUARD_IS_ALLOWLIST == false and wrong_target_is_caught(false, false) == false

invariant the_handle_default_has_strictly_fewer_checks_than_the_url_default
  assert BOT_USERNAME_CONTENT_CHECKS == 0 and BOT_USERNAME_CONTENT_CHECKS < WEB_APP_URL_DENYLIST_ENTRIES

invariant a_knob_with_a_compiled_in_copy_does_not_govern_the_deployment
  assert knob_governs_whole_deployment(true, 6) == false and BOT_HANDLE_CLIENT_LITERAL_SITES.len == 6

invariant the_client_never_reads_the_server_knob_however_the_six_sites_split
  assert BOT_HANDLE_CLIENT_READS_ENV == false and BOT_HANDLE_CLIENT_LITERAL_SITES_SDK_FALLBACK + BOT_HANDLE_CLIENT_LITERAL_SITES_UNCONDITIONAL == 6

invariant an_unconditional_client_site_is_wrong_whatever_the_platform_says
  assert handle_is_wrong_when_the_compiled_value_is(true, true) == true and handle_is_wrong_when_the_compiled_value_is(true, false) == false

invariant a_substitution_is_never_named_at_boot
  assert absence_is_named_at_boot(OUTCOME_SUBSTITUTE) == false and SUBSTITUTION_IS_LABELLED_IN_THE_BOOT_LOG == false

invariant an_always_required_name_refuses_the_boot_in_every_deployment_class
  assert absent_value_refuses_boot(true, false, false) == true and absent_value_refuses_boot(true, false, true) == true

invariant the_roster_is_fatal_in_production_and_loud_outside_it
  assert absent_value_refuses_boot(false, true, true) == true and absent_value_refuses_boot(false, true, false) == false

invariant the_announced_absences_do_not_cover_the_measured_ones
  assert CAPABILITY_ABSENCES_ANNOUNCED_AT_BOOT + CAPABILITY_ABSENCES_ANNOUNCED_AT_USE == CAPABILITY_ABSENCES_MEASURED and CAPABILITY_ABSENCES_ANNOUNCED_AT_BOOT < CAPABILITY_ABSENCES_MEASURED

invariant the_schema_check_is_not_one_of_the_three_halting_steps
  assert SCHEMA_CHECK_HALTS_BOOT == false and BOOT_HALTING_SITES.len == BOOT_HALTING_STEPS and REUSES_SCHEMA_PROVENANCE_ID != ID

invariant serving_requires_all_three_halting_steps_to_pass
  assert boot_reaches_serving(true, true, true) == true and boot_reaches_serving(false, true, true) == false and boot_reaches_serving(true, false, true) == false and boot_reaches_serving(true, true, false) == false

invariant any_railway_environment_value_is_production_so_there_is_no_third_class
  assert production_detected(false, true) == true and DEPLOYMENT_CLASSES == 2 and STAGING_IS_A_DISTINCT_CLASS == false

invariant dropping_a_key_the_deployment_still_sets_is_unsafe
  assert renaming_a_key_is_safe(false, true) == false

invariant every_loop_row_carries_a_name_an_interval_and_two_line_citations
  assert LOOP_NAMES.len == RECURRING_LOOPS and LOOP_INTERVAL_SECONDS.len == RECURRING_LOOPS and LOOP_SPAWN_SITES.len == RECURRING_LOOPS and LOOP_INTERVAL_LITERAL_SITES.len == RECURRING_LOOPS

invariant no_loop_interval_is_configurable_and_all_eight_skip_the_cold_start
  assert LOOP_INTERVALS_READ_FROM_ENV == 0 and LOOPS_DISCARDING_FIRST_TICK == RECURRING_LOOPS

invariant every_shared_interval_row_names_its_behaviour_owner_and_defers_to_the_literal
  assert SHARED_ROW_BEHAVIOUR_OWNER_IDS.len == ROWS_WITH_A_BEHAVIOUR_OWNER and SHARED_ROW_INDICES.len == ROWS_WITH_A_BEHAVIOUR_OWNER and ROWS_WITH_A_BEHAVIOUR_OWNER + ROWS_WITH_NO_OTHER_CONTRACT == RECURRING_LOOPS and INTERVAL_ARBITER_IS_THE_SOURCE_LITERAL == true and LOOP_INTERVAL_SECONDS[0] == 900 and LOOP_INTERVAL_SECONDS[5] == 300 and LOOP_INTERVAL_SECONDS[6] == 300 and LOOP_INTERVAL_SECONDS[7] == 30

invariant the_owner_of_the_drain_interval_exists_and_is_not_this_file
  assert NOTIFICATION_QUEUE_OWNER_EXISTS == true and REUSES_NOTIFICATION_QUEUE_ID != ID and SPEC_ID_LINES_UNDER_TURBOBABY + SPEC_ID_LINES_AGENT_CARDS == SPEC_ID_LINES_READ_AT_REVIEW

invariant every_behaviour_owner_is_either_reciprocating_or_counted_as_not
  assert SHARED_ROWS_WITH_A_RECIPROCAL_EDGE + SHARED_ROWS_WITHOUT_A_RECIPROCAL_EDGE == ROWS_WITH_A_BEHAVIOUR_OWNER and RECIPROCAL_EDGE_OWNER_IDS.len + MISSING_RECIPROCAL_EDGE_OWNER_IDS.len == ROWS_WITH_A_BEHAVIOUR_OWNER and MISSING_RECIPROCAL_EDGE_DECLARATIONS.len == SHARED_ROWS_WITHOUT_A_RECIPROCAL_EDGE and MISSING_RECIPROCAL_EDGES_ARE_FIXED_HERE == false

invariant the_measured_interval_range_is_pinned_by_a_scan_not_by_a_row
  assert shortest_loop_interval() == 30 and longest_loop_interval() == 86400

invariant boot_tasks_reconcile_with_spawn_expressions
  assert boot_tasks_from_expressions(BOOT_SPAWN_EXPRESSIONS, EXTRA_TTL_INVOCATIONS) == LONG_LIVED_TASKS_AT_BOOT and RECURRING_LOOPS + ONE_SHOT_DELAYED_TASKS + DISPATCHER_TASKS == LONG_LIVED_TASKS_AT_BOOT

invariant no_fire_and_forget_spawn_is_a_recurring_loop
  assert FIRE_AND_FORGET_RECURRING_LOOPS == 0 and BOOT_SPAWN_EXPRESSIONS + FIRE_AND_FORGET_SPAWN_EXPRESSIONS == SPAWN_EXPRESSIONS_IN_SHIPPED_CODE

invariant a_one_shot_delay_is_not_a_period
  assert delay_is_a_period(false) == false and ONE_SHOT_DELAY_SECONDS.len == ONE_SHOT_DELAYED_TASKS

invariant no_value_of_any_variable_is_published_here
  assert LIVE_VALUES_PUBLISHED.len == 0 and MERCHANT_IDENTIFIER_VALUE_IS_STORED_IN_REPOSITORY == false

invariant an_unopened_template_is_a_refusal_and_not_a_coverage_claim
  assert CONFIG_TEMPLATE_IS_TRACKED == true and CONFIG_TEMPLATE_WAS_OPENED == false

invariant the_frequency_of_the_defect_is_refused_rather_than_estimated
  assert DEFAULT_MISUSE_FREQUENCY_IS_MEASURED == false and DEPLOYMENT_ENV_IS_READABLE_FROM_THIS_REPOSITORY == false
