// SPDX-License-Identifier: Apache-2.0
; specs/turbobaby/order_status.t27 -- the order status vocabulary of the shipped write path
; This contract owns five things and nothing else: which status names the admin write path
; accepts, which of them are terminal, which name is an alias of another, the length caps on the
; two path inputs, and the single status precondition on a customer cancellation. It is the
; producer of one boolean that already had a consumer and no source: turbobaby/commerce owns
; commerce_order_transition_allowed, which takes current_is_terminal as an abstract argument and
; says in its own comment that the order-status vocabulary remains in the order owner. Until this
; file existed there was no order owner. order_status_current_is_terminal is that source, and
; commerce still owns the gate. The edge is now declared from the other side too: re-measured
; 2026-09-21, TWO contracts hold REUSES_ORDER_STATUS_ID -- turbobaby/bot-surface and
; turbobaby/cart-persistence -- so "no order owner" is a statement about the past and the count
; below is what a reader should check instead of trusting this sentence.
; ASCII only (L3), English only (LANG-EN).
; --
; WHY (measured 2026-09-20): one VARCHAR(30) column is closed by FIVE separate declarations in
; this repository, carrying FOUR different vocabularies, and no two of the four agree. The admin
; write path whitelists nine names (src/api/orders.rs:1991-2001); src/trios/store.rs:175-182
; enumerates six and is missing preparing, out_for_delivery and delivered;
; src/ui/api/types.rs:179-189 enumerates nine that are not the same nine -- it adds processing and
; shipped and drops preparing and out_for_delivery; and two const ORDER_PIPELINE slices, at
; src/trios/order_status_view.rs:65-72 and src/ui/screens/admin_screen.rs:2910-2917 (both re-pointed 2026-09-22: the first moved out of src/ui/components/status_stepper.rs that day, the second had drifted one line since 2c21df1), carry the
; same six display names and drop completed, rejected and cancelled. The matching count is the
; trap: nine equals nine and the write-path and UI sets still differ by four names, so any check
; written on totals alone reports agreement between two models that share only seven values. It is
; not theoretical either. A shipped test asserts that the name shipped is a 400
; (src/api/orders.rs:3279-3283), so the UI type declares a variant the server refuses by name. The
; readers disagree once more on terminality alone: src/bot/callbacks.rs:120-122 treats exactly two
; names as terminal where the API reject path at src/api/orders.rs:2094-2097 treats four, and the
; repository's own test for it is called
; should_refund_bonus_is_dangerously_true_for_unknown_status (src/bot/callbacks.rs:1090-1096). The
; column constrains none of this: migrations/001_initial.sql:67 is status VARCHAR(30) NOT NULL
; DEFAULT 'pending' with no CHECK clause, so the names live in Rust only, and nothing at the
; database stops one more writer from storing a tenth. That is the number that forced this file:
; five enumerations, four vocabularies, zero constraints, one column.
; --
; WHERE THE BRIEF IS REFUTED (twice, both measured). First: src/trios/store.rs is not the second
; model of two, it is one of five, and counting READERS is itself the trap -- src/bot/callbacks.rs
; is a reader, and so is every match arm in six UI screens (corrected 2026-09-22: four screens since then -- the orders list, the order detail screen and the stepper they share now read through src/trios/order_status_view.rs, whose arm_of is itself a reader), so the count rises with the next grep
; and settles nowhere. The countable thing is a declaration that CLOSES the vocabulary, and there
; are exactly five of those. The measurements below are therefore recorded per declaration, each
; with its own missing and extra list, instead of as one pairwise disagreement. Second, and
; load-bearing:
; src/api/orders.rs:1998 carries the in-source comment calling completed a legacy alias for
; delivered, which reads as completed being the alias. The write path runs the other way. Both
; names enter the same branch (src/api/orders.rs:2054) and that branch writes the literal
; completed into the column at src/db/orders.rs:222 and :266. So delivered is accepted at the
; door, routed, and never persisted by this path: the alias resolves delivered -> completed, and
; a reader who trusts the comment will look for stored rows that cannot exist.
; --
; WHAT THIS FILE NEVER DOES: no money of any kind -- no total, subtotal, bonus, stars, deposit,
; refund amount, fee or currency. The refund guard appears below only as a COUNT of names in a
; terminal set, never as a refund rule, because the two disagreeing terminal sets are a
; vocabulary fact and the refund they gate is not this file's business. Nothing about WHO may
; transition: authorization is checked at src/api/orders.rs:2015, one line after the vocabulary
; check at :2014, and this file owns the first and is silent about the second. No cart, no quote
; snapshot, no idempotency decision -- commerce.t27 owns all three. No unit status: the four wire
; values of bike_units belong to availability.t27 and are a different table with a different set,
; named here only so the two are never confused. No delivery ETA, no notification text, no locale
; string, no order id, no customer row, no telegram id. D14 data cannot appear here because no row
; appears here: every value below is a name, a count, a length, or a protocol numeral.
; phi^2 + 1/phi^2 = 3 | TRINITY

module turbobaby-order-status;

pub const KIND : str = "contract";
pub const ID : str = "turbobaby/order-status";
pub const NAME : str = "TurboBaby order status vocabulary";
pub const IMPLEMENTATION : str = "src/api/orders.rs";
pub const STORAGE : str = "migrations/001_initial.sql:67";
pub const MEASURED_AT : str = "2026-09-20";

; Current t27c does not support brace imports. These three strings are the whole of the
; cross-contract wiring, and each names an owner this file refuses to restate.
; turbobaby/commerce owns the transition GATE -- its commerce_order_transition_allowed
; consumes current_is_terminal, same_state and transition_authorized. This file supplies the first
; of those three from the vocabulary and declares no gate of its own; the checkout join, the cart
; states and the idempotency decisions stay there and appear nowhere below.
pub const REUSES_COMMERCE_ID : str = "turbobaby/commerce";
; turbobaby/availability owns the UNIT status set of bike_units -- available, rented, service,
; retired. That is a different table, a different vocabulary and a different question (is a machine
; rentable now), and none of its four values is repeated here. Named because the confusion is one
; grep away: both tables have a column called status. Re-verified 2026-09-21 and all four halves
; still hold -- availability.t27 declares exactly those four values, this file repeats none of
; them, orders.status is migrations/001_initial.sql:67 and bike_units.status is indexed at
; migrations/078_bike_units.sql:43. What the sentence was MISSING is the sharper half of the same
; confusion, and it is recorded below the vocabulary as a census: the grep collides on DECLARATION
; NAMES too, and not only with availability.
pub const REUSES_AVAILABILITY_ID : str = "turbobaby/availability";
; turbobaby/request-identity owns the GATES -- check_admin, check_owner and check_owner_lenient,
; carried in its GATE_NAMES array -- and names src/api/orders.rs among the files it covers. That
; array is cited by its DECLARATION NAME and never by a line: an earlier revision of this sentence
; pointed at a line number inside that file, the line it named was not the array even when it was
; written, and the array had moved again before either file was finished. A line number into a
; sibling stops being checkable the moment the sibling is edited, which is why every cross-contract
; citation in this file names an owner ID plus a declaration. Line numbers into src/ are a
; different thing and stay: the authorization at src/api/orders.rs:2015 is check_admin, one line
; after the vocabulary check this file owns at :2014, both re-read on 2026-09-21. Named so the
; seam is greppable; no gate, no precedence order and no attempt bound of that contract is
; repeated below.
pub const REUSES_REQUEST_IDENTITY_ID : str = "turbobaby/request-identity";

; The edges pointing the OTHER way, measured 2026-09-21 by grepping specs/ for this file's own ID.
; The header calls this file the first order owner, which is a claim about the past; the count here
; is the claim about today, and it is the one that can be re-run. Two contracts declare the edge
; from their own side, both by holding REUSES_ORDER_STATUS_ID = this file's ID.
pub const INBOUND_EDGE_CENSUS_MEASURED_AT : str = "2026-09-21";
pub const INBOUND_EDGE_COUNT : u8 = 2;
pub const INBOUND_EDGES : [2]str = ["turbobaby/bot-surface", "turbobaby/cart-persistence"];

; --- The nine accepted names --------------------------------------------------------------------
; src/api/orders.rs:1991-2001, the VALID_STATUSES slice of validate_update_order_status. The u8
; codes are this file's own ordinals in the slice's own order; the strings are what the column
; stores. Zero is UNSET and is never an accepted status, for the reason availability.t27 gives for
; its own set: an unwritten slot in a fixed-length array already holds zero, and a vocabulary
; whose first real value is zero converts an unwritten slot into a confident answer. Here the
; residual error falls towards refusing a write, which costs an admin a retry, rather than
; towards admitting one, which mutates an order nobody named.
pub const STATUS_UNSET : u8 = 0;
pub const STATUS_PENDING : u8 = 1;
pub const STATUS_CONFIRMED : u8 = 2;
pub const STATUS_PREPARING : u8 = 3;
pub const STATUS_READY : u8 = 4;
pub const STATUS_OUT_FOR_DELIVERY : u8 = 5;
pub const STATUS_DELIVERED : u8 = 6;
pub const STATUS_COMPLETED : u8 = 7;
pub const STATUS_REJECTED : u8 = 8;
pub const STATUS_CANCELLED : u8 = 9;
pub const STATUS_COUNT : u8 = 9;
; Indexed by code minus one.
pub const STATUS_NAMES : [9]str = [
  "pending", "confirmed", "preparing", "ready", "out_for_delivery",
  "delivered", "completed", "rejected", "cancelled",
];

; --- The bare STATUS_ names, and who else spells them ---------------------------------------------
; Measured 2026-09-21 with `grep -rn "^pub const STATUS_" specs/` over all 43 files. FOUR contracts
; declare bare STATUS_ constants -- this one, availability.t27, referral_program.t27 and
; happy_hour.t27 -- and FOUR of the bare names are declared by more than one of them. NOTHING IS
; RENAMED to dodge this. The pinned compiler has no imports, so a collision cannot break a build;
; it breaks a READER, and a rename would cost the vocabulary its own words to buy back a grep. So
; the collision is recorded as data instead, greppable from either end by the names below.
;   STATUS_NAMES     -- [9]str here, [4]str in availability.t27. SAME NAME, DIFFERENT ARITY, and
;                       the two lists share no value at all. This is the one that misleads worst:
;                       a reader who greps STATUS_NAMES gets two closed vocabularies of one word.
;   STATUS_UNSET     -- 0 here, 0 in availability.t27, 0 in referral_program.t27. Three files and
;                       one meaning; the agreement IS the finding, because it says the zero rule is
;                       a corpus habit and not a local trick.
;   STATUS_PENDING   -- 1 here over the ORDER pipeline, 1 in referral_program.t27 over the REFERRAL
;   STATUS_CONFIRMED -- 2 here, 2 in referral_program.t27. Same two codes, two different tables,
;                       two different vocabularies. The codes agreeing is a coincidence of writing
;                       order, not a shared model, and reading it as one is the whole trap.
; STATUS_COUNT and STATUS_CHARS_MAX are this file's alone, which is why they are not in the list.
pub const BARE_STATUS_NAME_CENSUS_MEASURED_AT : str = "2026-09-21";
pub const CONTRACTS_DECLARING_BARE_STATUS_NAMES : u8 = 4;
pub const COLLIDING_BARE_STATUS_NAME_COUNT : u8 = 4;
pub const COLLIDING_BARE_STATUS_NAMES : [4]str = [
  "STATUS_NAMES", "STATUS_UNSET", "STATUS_PENDING", "STATUS_CONFIRMED",
];
pub const STATUS_NAMES_ARITY_HERE : u8 = 9;
pub const STATUS_NAMES_ARITY_IN_AVAILABILITY : u8 = 4;
pub const STATUS_NAMES_ARITIES_DIFFER : bool = true;
pub const STATUS_NAMES_SHARE_NO_VALUE_WITH_AVAILABILITY : bool = true;
pub const STATUS_UNSET_DECLARER_COUNT : u8 = 3;
pub const STATUS_UNSET_AGREES_ACROSS_EVERY_DECLARER : bool = true;
pub const COLLIDING_WITH_REFERRAL_PROGRAM_ID : str = "turbobaby/referral-program";
pub const NO_DECLARATION_IS_RENAMED_TO_AVOID_THE_COLLISION : bool = true;

pub fn order_status_bare_name_collides(name: str) bool {
  if (name == COLLIDING_BARE_STATUS_NAMES[0]) {
    return true;
  }
  if (name == COLLIDING_BARE_STATUS_NAMES[1]) {
    return true;
  }
  if (name == COLLIDING_BARE_STATUS_NAMES[2]) {
    return true;
  }
  if (name == COLLIDING_BARE_STATUS_NAMES[3]) {
    return true;
  }
  return false;
}

pub fn order_status_is_known(code: u8) bool {
  return code >= STATUS_PENDING and code <= STATUS_CANCELLED;
}

; Name to code, closed over the whitelist. A name the slice does not carry -- a misspelling, a
; different case, a variant of another model, an empty string -- yields UNSET, which is the same
; verdict the shipped path gives it at src/api/orders.rs:2002-2004: a 400, never a stored value.
pub fn order_status_code_of(name: str) u8 {
  if (name == "pending") {
    return STATUS_PENDING;
  }
  if (name == "confirmed") {
    return STATUS_CONFIRMED;
  }
  if (name == "preparing") {
    return STATUS_PREPARING;
  }
  if (name == "ready") {
    return STATUS_READY;
  }
  if (name == "out_for_delivery") {
    return STATUS_OUT_FOR_DELIVERY;
  }
  if (name == "delivered") {
    return STATUS_DELIVERED;
  }
  if (name == "completed") {
    return STATUS_COMPLETED;
  }
  if (name == "rejected") {
    return STATUS_REJECTED;
  }
  if (name == "cancelled") {
    return STATUS_CANCELLED;
  }
  return STATUS_UNSET;
}

; --- Terminality, and the one boolean this file exports -------------------------------------------
; src/api/orders.rs:2046-2049. Four of the nine are terminal, in the source's own order. The same
; four appear again in the API reject path at src/api/orders.rs:2094-2097, which is why the
; disagreement recorded further down is with a fourth reader and not with this list.
pub const TERMINAL_COUNT : u8 = 4;
pub const TERMINAL_NAMES : [4]str = ["completed", "delivered", "rejected", "cancelled"];
; The same four as codes: STATUS_COMPLETED, STATUS_DELIVERED, STATUS_REJECTED, STATUS_CANCELLED.
pub const TERMINAL_CODES : [4]u8 = [7, 6, 8, 9];

pub fn order_status_is_terminal(code: u8) bool {
  return code == STATUS_COMPLETED or code == STATUS_DELIVERED or code == STATUS_REJECTED or code == STATUS_CANCELLED;
}

; THE EXPORT. turbobaby/commerce owns commerce_order_transition_allowed, which takes
; current_is_terminal as an argument and deliberately does not compute it.
; This is the function that computes it, and it is a separate name from order_status_is_terminal
; on purpose: the argument commerce receives is about the CURRENT stored state of one order, and
; the distinction is what makes the fail-open below legible instead of invisible.
pub fn order_status_current_is_terminal(current: u8) bool {
  return order_status_is_terminal(current);
}

; MEASURED FAIL-OPEN, recorded rather than smoothed. src/api/orders.rs:2046 is a matches! over the
; raw column string, so a stored value outside the nine -- written by a fifth reader, a migration,
; or a hand-edited row, all possible because the column carries no CHECK -- does not match,
; is_terminal is false, and the write proceeds. The direction is the opposite of the vocabulary
; gate above: an unreadable status admits a mutation instead of refusing one. This file does not
; correct the shipped behaviour, it states it, so that a future edit changing it has something to
; contradict.
pub const UNKNOWN_STORED_STATUS_IS_TREATED_AS_NON_TERMINAL : bool = true;

; The equal-status exemption of src/api/orders.rs:2050: a terminal order refuses every transition
; except the one that asks for the state it is already in. The requested name must be in the
; vocabulary first, because the shipped guard is reached only after the whitelist passes -- so two
; unreadable statuses are never an exemption for each other.
pub fn order_status_same_state(current: u8, requested: u8) bool {
  return order_status_is_known(requested) and current == requested;
}

; src/api/orders.rs:2002-2004 and :2050-2052 in one predicate: the requested name is in the
; vocabulary, and either it repeats the current state or the current state is not terminal.
pub fn order_status_write_admitted(current: u8, requested: u8) bool {
  if (!order_status_is_known(requested)) {
    return false;
  }
  if (order_status_same_state(current, requested)) {
    return true;
  }
  return !order_status_is_terminal(current);
}

; --- The alias, which runs the other way ----------------------------------------------------------
; src/api/orders.rs:2054 sends completed and delivered into one branch; src/db/orders.rs:222 and
; :266 write the literal completed. Nothing in the shipped write path ever stores delivered.
pub const ALIAS_ACCEPTED_NAME : str = "delivered";
pub const ALIAS_PERSISTED_NAME : str = "completed";
pub const IN_SOURCE_COMMENT_CALLS_COMPLETED_THE_ALIAS : bool = true;
pub const IN_SOURCE_COMMENT_ALIAS_DIRECTION_IS_REVERSED : bool = true;
pub const DELIVERED_IS_NEVER_PERSISTED_BY_THE_WRITE_PATH : bool = true;
pub const ALIAS_NOTE : str = "src/api/orders.rs:1998 comments completed as a legacy alias for delivered, and src/ui/screens/admin_screen.rs:2908-2909 repeats the same sentence (re-pointed 2026-09-22: one line of drift since 2c21df1); the branch at :2040 and the writes at src/db/orders.rs:222 and :266 persist completed for both names, and no line under src/ writes the literal delivered, so the resolution is delivered -> completed and both comments name the wrong side.";

; Every other accepted name is written verbatim by the generic branch at
; src/api/orders.rs:2240-2246, so preparing, ready and out_for_delivery are storable values and
; not display-only labels.
pub fn order_status_persisted_code(requested: u8) u8 {
  if (!order_status_is_known(requested)) {
    return STATUS_UNSET;
  }
  if (requested == STATUS_DELIVERED) {
    return STATUS_COMPLETED;
  }
  return requested;
}

; --- Path input caps ------------------------------------------------------------------------------
; src/api/orders.rs:1984-1990, both breaches a 400, checked before the whitelist. The order of the
; three refusals below is the shipped order; all three carry the same HTTP code, so the reason
; discriminant exists to keep the precedence checkable rather than to change an answer.
pub const ORDER_ID_CHARS_MAX : u16 = 200;
pub const STATUS_CHARS_MAX : u16 = 50;
; Protocol numerals, not a domain table. They are restated here for the same reason NINE of the
; 43 contracts restate their own: an IANA status code is not a rule any contract owns.
; turbobaby/publication owns HTTP_OK, HTTP_NOT_FOUND and HTTP_BAD_GATEWAY; turbobaby/catalog-api
; owns HTTP_OK, HTTP_NOT_MODIFIED, HTTP_BAD_REQUEST, HTTP_NOT_FOUND and HTTP_INTERNAL_ERROR.
; Neither of those two covers this surface, which is re-verified and not remembered.
; CORRECTED 2026-09-21: this sentence used to cite both neighbours by line and to name them as if
; they were the only precedent. Both halves had rotted. One of the two line ranges had drifted off
; its declarations entirely, and the precedent is nine contracts rather than two -- the count
; below is a constant so the next reader checks a number instead of a memory.
; HOW THE NINE WERE COUNTED, because a census with an unstated method is the next stale claim.
; The re-measurement was taken twice, and the FIRST pass was wrong in the direction that matters.
; That pass grepped for the HTTP_ prefix and answered six; a second pass over every u16 constant
; in the corpus whose value is a three-digit IANA code, read declaration by declaration, answered
; nine. Three contracts declare transport statuses under names carrying neither HTTP nor STATUS:
; turbobaby/cart-persistence spells its three CART_WRITE_BAD_REQUEST, CART_WRITE_UNPROCESSABLE and
; CART_WRITE_SERVER_ERROR, turbobaby/happy-hour spells two of its STATUS_OK and
; STATUS_INTERNAL_ERROR, and turbobaby/webapp-bridge spells one SERVER_REPLAY_STATUS. A grep on
; the prefix would have published a smaller number with the same confidence, which is how the
; sentence this block replaces went wrong the first time.
pub const REFUSAL_NONE : u16 = 0;
pub const HTTP_BAD_REQUEST : u16 = 400;
pub const HTTP_CONFLICT : u16 = 409;
; Measured 2026-09-21 by grepping specs/ for a u16 constant whose value is an IANA status code.
; The two counts below are what makes the "neither covers this surface" claim checkable rather
; than rhetorical: 400 is a crowd and 409 is this file alone.
pub const IANA_STATUS_CENSUS_MEASURED_AT : str = "2026-09-21";
pub const CONTRACTS_DECLARING_AN_IANA_STATUS : u8 = 9;
pub const CONTRACTS_DECLARING_FOUR_HUNDRED : u8 = 4;
pub const CONTRACTS_DECLARING_FOUR_HUNDRED_AND_NINE : u8 = 1;
; The nine, enumerated rather than left as a total, because a total is the thing that rots first
; and a list can be re-checked one name at a time. Three of them (cart-persistence, happy-hour,
; webapp-bridge) are invisible to a grep on the HTTP_ prefix.
pub const IANA_STATUS_DECLARERS : [9]str = [
  "turbobaby/cart-persistence",
  "turbobaby/catalog-api",
  "turbobaby/client-errors",
  "turbobaby/happy-hour",
  "turbobaby/order-status",
  "turbobaby/publication",
  "turbobaby/request-identity",
  "turbobaby/upload-media",
  "turbobaby/webapp-bridge",
];
pub const IANA_STATUS_DECLARERS_MISSED_BY_A_PREFIX_GREP : u8 = 3;
pub const IANA_STATUS_PRECEDENT_A : str = "turbobaby/publication";
pub const IANA_STATUS_PRECEDENT_B : str = "turbobaby/catalog-api";
pub const NEITHER_PRECEDENT_COVERS_THIS_SURFACE : bool = true;

pub const REFUSAL_REASON_NONE : u8 = 0;
pub const REFUSAL_REASON_ID_TOO_LONG : u8 = 1;
pub const REFUSAL_REASON_STATUS_TOO_LONG : u8 = 2;
pub const REFUSAL_REASON_STATUS_UNKNOWN : u8 = 3;

pub fn order_status_validation_reason(id_chars: u16, status_chars: u16, requested: u8) u8 {
  if (id_chars > ORDER_ID_CHARS_MAX) {
    return REFUSAL_REASON_ID_TOO_LONG;
  }
  if (status_chars > STATUS_CHARS_MAX) {
    return REFUSAL_REASON_STATUS_TOO_LONG;
  }
  if (!order_status_is_known(requested)) {
    return REFUSAL_REASON_STATUS_UNKNOWN;
  }
  return REFUSAL_REASON_NONE;
}

pub fn order_status_validation_refusal(id_chars: u16, status_chars: u16, requested: u8) u16 {
  if (order_status_validation_reason(id_chars, status_chars, requested) == REFUSAL_REASON_NONE) {
    return REFUSAL_NONE;
  }
  return HTTP_BAD_REQUEST;
}

; The column is narrower than the door cap: migrations/001_initial.sql:67 declares VARCHAR(30)
; while the door accepts 50 characters before looking at the name. The gap is unreachable only
; because the whitelist runs after the cap, and the longest accepted name is out_for_delivery at
; 16 characters. That is a fact about today's nine names, not a guarantee: a tenth name of 31
; characters would pass both caps and fail at the database.
pub const DB_STATUS_COLUMN_CHARS : u16 = 30;
pub const LONGEST_ACCEPTED_NAME_CHARS : u16 = 16;
pub const DOOR_CAP_EXCEEDS_COLUMN_WIDTH : bool = true;

pub fn order_status_name_fits_column(name_chars: u16) bool {
  return name_chars <= DB_STATUS_COLUMN_CHARS;
}

; --- The one status precondition on a customer cancellation ---------------------------------------
; src/api/orders.rs:2335-2337: a self-service cancellation refuses with 409 unless the order is
; still pending. The write it performs is cancelled (src/api/orders.rs:2447). Ownership, blocking
; and the telegram id parameter are checked in the same handler and are not status facts, so they
; are not modelled here.
pub const CANCEL_WRITES_NAME : str = "cancelled";
pub const CANCEL_PRECONDITION_NOTE : str = "The only status a customer cancellation accepts is pending; every other current status, terminal or not, is a 409. confirmed, preparing, ready and out_for_delivery are refused exactly like completed.";

pub fn order_status_customer_cancel_admitted(current: u8) bool {
  return current == STATUS_PENDING;
}

pub fn order_status_customer_cancel_refusal(current: u8) u16 {
  if (order_status_customer_cancel_admitted(current)) {
    return REFUSAL_NONE;
  }
  return HTTP_CONFLICT;
}

; --- The drift, counted so a fix has to flip it ----------------------------------------------------
; Three typed models of one column. Measured 2026-09-20 by reading each declaration.
pub const WRITE_PATH_MODEL : str = "src/api/orders.rs:1991-2001";
pub const TRIOS_STORE_MODEL : str = "src/trios/store.rs:175-182";
pub const UI_TYPES_MODEL : str = "src/ui/api/types.rs:179-189";
pub const TRIOS_STORE_VARIANT_COUNT : u8 = 6;
pub const TRIOS_STORE_MISSING_COUNT : u8 = 3;
pub const TRIOS_STORE_MISSING_NAMES : [3]str = ["preparing", "out_for_delivery", "delivered"];
pub const TRIOS_STORE_EXTRA_COUNT : u8 = 0;
pub const UI_TYPES_VARIANT_COUNT : u8 = 9;
pub const UI_TYPES_MISSING_COUNT : u8 = 2;
pub const UI_TYPES_MISSING_NAMES : [2]str = ["preparing", "out_for_delivery"];
pub const UI_TYPES_EXTRA_COUNT : u8 = 2;
pub const UI_TYPES_EXTRA_NAMES : [2]str = ["processing", "shipped"];
; src/api/orders.rs:3279-3283 asserts one of those two extras is a 400 by name. The other has no
; test, which is a smaller fact and not a safer one.
pub const SHIPPED_TEST_PINS_SHIPPED_AS_A_BAD_REQUEST : bool = true;
; THE CONSTANT A FUTURE FIX MUST FLIP. It is not an opinion held beside the counts: the invariant
; below pins it equal to the predicate applied to the measured counts, so the day the Rust agrees,
; this constant is wrong and the gate says which model moved.
pub const TYPED_MODELS_AGREE : bool = false;

pub fn order_status_models_agree(trios_variants: u8, trios_missing: u8, trios_extra: u8, ui_variants: u8, ui_missing: u8, ui_extra: u8) bool {
  return trios_variants == STATUS_COUNT and trios_missing == 0 and trios_extra == 0 and ui_variants == STATUS_COUNT and ui_missing == 0 and ui_extra == 0;
}

; The fourth and fifth declarations, and the only two that agree with each other. Both are a
; const ORDER_PIPELINE : &[&str] of the SAME six display names, so neither carries completed,
; rejected or cancelled -- the three names a reader most needs when an order has stopped moving.
; The customer stepper's, src/trios/order_status_view.rs:65-72, only renders. The other one is
; not display-only: src/ui/screens/admin_screen.rs:2910-2917 is read by next_pipeline_status at
; :2945-2949, and the admin advance button PUTs whatever that returns to
; /api/orders/{id}/status at :3346-3366. They are kept out of order_status_models_agree
; deliberately: that predicate pins the two declarations that claim to TYPE the column, and these
; two claim to order it.
; CORRECTED 2026-09-22, two moves and no new declaration. FIRST, model A moved. It was a private
; const of src/ui/components/status_stepper.rs:16-23, a file compiled only for wasm32, so no host
; test could read it. It is now a pub const of src/trios/order_status_view.rs, the module
; turbobaby/order-presentation owns, and the host tests there read THIS file's STATUS_NAMES,
; DISPLAY_PIPELINE_MISSING_NAMES and DISPLAY_PIPELINE_VARIANT_COUNT and fail when its content
; disagrees. The content is still this file's: the declaration moved, it was not written a second
; time, so COLUMN_ENUMERATION_COUNT stays five. The same module's arm_of is a READER -- a match
; with a fallback that answers every string -- and not a sixth declaration that closes the
; vocabulary; gate 3 binds its arms set-equal to STATUS_NAMES and its terminal arms set-equal to
; TERMINAL_NAMES, so it cannot drift from either in silence. SECOND, model B and the two admin
; sites that go with it had drifted one line since 2c21df1 inserted an import above them, and are
; re-pointed here and below.
pub const DISPLAY_PIPELINE_MODEL_A : str = "src/trios/order_status_view.rs:65-72";
pub const DISPLAY_PIPELINE_MODEL_A_BEFORE_REPAIR : str = "src/ui/components/status_stepper.rs:16-23";
pub const DISPLAY_PIPELINE_MODEL_A_MOVED_AT : str = "2026-09-22";
pub const DISPLAY_PIPELINE_MODEL_A_IS_HOST_COMPILED : bool = true;
pub const DISPLAY_PIPELINE_MODEL_B : str = "src/ui/screens/admin_screen.rs:2910-2917";
pub const ADMIN_SITES_REPOINTED_AT : str = "2026-09-22";
pub const DISPLAY_PIPELINE_VARIANT_COUNT : u8 = 6;
pub const DISPLAY_PIPELINE_MISSING_COUNT : u8 = 3;
pub const DISPLAY_PIPELINE_MISSING_NAMES : [3]str = ["completed", "rejected", "cancelled"];
pub const DISPLAY_PIPELINE_EXTRA_COUNT : u8 = 0;
pub const DISPLAY_PIPELINES_ARE_IDENTICAL : bool = true;
pub const DISPLAY_PIPELINES_AGREE : bool = false;
; Five declarations close the vocabulary; two of them carry the same names, so four vocabularies.
pub const COLUMN_ENUMERATION_COUNT : u8 = 5;
pub const DISTINCT_VOCABULARY_COUNT : u8 = 4;

pub fn order_status_display_pipeline_agrees(variant_count: u8, missing_count: u8, extra_count: u8) bool {
  return variant_count == STATUS_COUNT and missing_count == 0 and extra_count == 0;
}

; The fourth reader, and the only one that disagrees about terminality rather than about the
; vocabulary. src/bot/callbacks.rs:120-122 is status != "rejected" && status != "completed", so
; delivered and cancelled read as non-terminal there while src/api/orders.rs:2094-2097 reads all
; four. src/bot/callbacks.rs:648 is the raw-SQL read that feeds it, and the repository's own test
; at src/bot/callbacks.rs:1090-1096 already names the unknown-status case dangerous.
pub const REFUND_GUARD_SOURCE : str = "src/bot/callbacks.rs:120-122";
pub const REFUND_GUARD_TERMINAL_COUNT : u8 = 2;
pub const REFUND_GUARD_MISSING_COUNT : u8 = 2;
pub const REFUND_GUARD_MISSING_NAMES : [2]str = ["delivered", "cancelled"];
pub const API_REJECT_GUARD_TERMINAL_COUNT : u8 = 4;
pub const API_REJECT_GUARD_MISSING_COUNT : u8 = 0;
pub const TERMINAL_GUARDS_AGREE : bool = false;
; DATED NOTE, 2026-09-26 (R3, turbobaby/referral-credit). The bot's reject, CallbackAction::RejectOrder,
; is the one path that can move a completed order to rejected, because the guard above does not read
; completed as terminal. Since that day it also reverses the order's referral-credit record, whole,
; inside the same transaction and before the flip, and a failed reversal rolls the whole reject back
; (fail closed). It moves no status and changes no guard: TERMINAL_GUARDS_AGREE stays false, and the
; reject is still the only un-completion. update_order_status and cancel_order cannot reach a
; completed order, so neither needs the hook.
pub const REFERRAL_CREDIT_ID : str = "turbobaby/referral-credit";
pub const BOT_REJECT_REVERSES_A_REFERRAL_CREDIT_RECORD : bool = true;
pub const BOT_REJECT_REVERSAL_IS_IN_THE_REJECT_TRANSACTION : bool = true;
pub const BOT_REJECT_REVERSAL_FAILS_CLOSED : bool = true;
pub const REFERRAL_CREDIT_REVERSAL_NOTED_AT : str = "2026-09-26";

pub fn order_status_terminal_guard_agrees(guard_terminal_count: u8, guard_missing_count: u8) bool {
  return guard_terminal_count == TERMINAL_COUNT and guard_missing_count == 0;
}

; --- What the repository does not ship -------------------------------------------------------------
; Named refusals, not gaps filled with a plausible rule.
pub const NO_SERVER_SIDE_TRANSITION_EDGE_TABLE_IS_SHIPPED : bool = true;
pub const NO_TRANSITION_EDGE_TABLE_NOTE : str = "No SERVER source constrains which non-terminal status may follow which. The only shipped server constraints are the whitelist, the terminal guard and the pending-only cancellation; the generic branch at src/api/orders.rs:2240-2246 writes any accepted name over any non-terminal one, so ready -> pending and pending -> out_for_delivery are both admitted today. An ENFORCED edge table would have to be measured from a decision that does not exist yet, so none is declared here.";
; An earlier draft of this file said no source in this repository declares which status may
; follow which. That is refuted by one grep and the refutation is kept rather than the claim: an
; ORDERING does exist, it is client-side and nothing enforces it.
; src/ui/screens/admin_screen.rs:2910-2917 lists six names in order, next_pipeline_status at
; :2945-2949 returns the element after the current one and None past the end, and the advance
; button at :3346-3366 PUTs exactly that name (all three re-pointed 2026-09-22, one line of drift
; since 2c21df1). So the admin UI walks pending -> confirmed ->
; preparing -> ready -> out_for_delivery -> delivered and offers no other move, while the server
; accepts any of the nine in any direction. What is true is not that no order is declared; it is
; that no order is enforced, and that the one declared order stops at a name the write path never
; stores (ALIAS_ACCEPTED_NAME above).
pub const CLIENT_SIDE_TRANSITION_ORDER_IS_SHIPPED : bool = true;
pub const CLIENT_PIPELINE_SOURCE : str = "src/ui/screens/admin_screen.rs:2910-2917";
pub const CLIENT_PIPELINE_ADVANCE_SOURCE : str = "src/ui/screens/admin_screen.rs:2945-2949";
pub const CLIENT_PIPELINE_LENGTH : u8 = 6;
pub const CLIENT_PIPELINE_IS_ENFORCED_ANYWHERE : bool = false;
pub const CLIENT_PIPELINE_LAST_NAME : str = "delivered";
pub const BACKWARD_TRANSITION_IS_ADMITTED : bool = true;
pub const ORDER_STATUS_HAS_NO_DATABASE_CONSTRAINT : bool = true;
pub const ORDER_STATUS_DATABASE_NOTE : str = "migrations/001_initial.sql:67 declares status VARCHAR(30) NOT NULL DEFAULT 'pending' with no CHECK clause, and no later migration adds one. The nine names are enforced in Rust by one function on one route; a writer that does not call it is bounded by the column width alone.";
pub const TRANSITION_AUTHORITY_IS_NOT_OWNED_HERE : bool = true;
pub const TRANSITION_AUTHORITY_NOTE : str = "Who may move an order is decided at src/api/orders.rs:2015, one line after the vocabulary check at :2014, and belongs to the request-identity owner. This file answers only whether a name is in the vocabulary and whether the current state permits a write.";

; --- Tests ------------------------------------------------------------------------------------------

test order_status_vocabulary_is_exactly_the_nine_names_of_the_write_path {
  assert STATUS_COUNT == 9;
  assert STATUS_NAMES.len == STATUS_COUNT;
  assert STATUS_NAMES[0] == "pending";
  assert STATUS_NAMES[1] == "confirmed";
  assert STATUS_NAMES[2] == "preparing";
  assert STATUS_NAMES[3] == "ready";
  assert STATUS_NAMES[4] == "out_for_delivery";
  assert STATUS_NAMES[5] == "delivered";
  assert STATUS_NAMES[6] == "completed";
  assert STATUS_NAMES[7] == "rejected";
  assert STATUS_NAMES[8] == "cancelled";
  assert order_status_is_known(STATUS_PENDING) == true;
  assert order_status_is_known(STATUS_CANCELLED) == true;
  assert order_status_is_known(STATUS_UNSET) == false;
  assert order_status_is_known(10) == false;
}

test order_status_name_lookup_is_closed_over_the_whitelist {
  assert order_status_code_of("pending") == STATUS_PENDING;
  assert order_status_code_of("out_for_delivery") == STATUS_OUT_FOR_DELIVERY;
  assert order_status_code_of("delivered") == STATUS_DELIVERED;
  assert order_status_code_of("completed") == STATUS_COMPLETED;
  assert order_status_code_of("cancelled") == STATUS_CANCELLED;
  ; The two names the UI type declares and the server refuses, plus the shapes a caller guesses.
  assert order_status_code_of("processing") == STATUS_UNSET;
  assert order_status_code_of("shipped") == STATUS_UNSET;
  assert order_status_code_of("Pending") == STATUS_UNSET;
  assert order_status_code_of("canceled") == STATUS_UNSET;
  assert order_status_code_of("") == STATUS_UNSET;
}

test order_status_terminal_set_is_four_of_the_nine {
  assert TERMINAL_COUNT == 4;
  assert TERMINAL_NAMES.len == TERMINAL_COUNT;
  assert TERMINAL_CODES.len == TERMINAL_COUNT;
  assert TERMINAL_CODES[0] == STATUS_COMPLETED;
  assert TERMINAL_CODES[1] == STATUS_DELIVERED;
  assert TERMINAL_CODES[2] == STATUS_REJECTED;
  assert TERMINAL_CODES[3] == STATUS_CANCELLED;
  assert order_status_is_terminal(STATUS_COMPLETED) == true;
  assert order_status_is_terminal(STATUS_DELIVERED) == true;
  assert order_status_is_terminal(STATUS_REJECTED) == true;
  assert order_status_is_terminal(STATUS_CANCELLED) == true;
  assert order_status_is_terminal(STATUS_PENDING) == false;
  assert order_status_is_terminal(STATUS_CONFIRMED) == false;
  assert order_status_is_terminal(STATUS_PREPARING) == false;
  assert order_status_is_terminal(STATUS_READY) == false;
  assert order_status_is_terminal(STATUS_OUT_FOR_DELIVERY) == false;
}

test order_status_produces_the_boolean_commerce_takes_as_an_input {
  assert REUSES_COMMERCE_ID == "turbobaby/commerce";
  assert REUSES_COMMERCE_ID != ID;
  assert order_status_current_is_terminal(STATUS_COMPLETED) == true;
  assert order_status_current_is_terminal(STATUS_PENDING) == false;
  ; The fail-open, stated as a value and not as a silence: an unrecognised stored status is not
  ; terminal, so it does not stop a write.
  assert UNKNOWN_STORED_STATUS_IS_TREATED_AS_NON_TERMINAL == true;
  assert order_status_current_is_terminal(STATUS_UNSET) == false;
  assert order_status_current_is_terminal(10) == false;
}

test order_status_terminal_order_refuses_every_move_but_its_own_state {
  assert order_status_write_admitted(STATUS_PENDING, STATUS_CONFIRMED) == true;
  assert order_status_write_admitted(STATUS_READY, STATUS_OUT_FOR_DELIVERY) == true;
  assert order_status_write_admitted(STATUS_COMPLETED, STATUS_CONFIRMED) == false;
  assert order_status_write_admitted(STATUS_CANCELLED, STATUS_PENDING) == false;
  assert order_status_write_admitted(STATUS_REJECTED, STATUS_COMPLETED) == false;
  assert order_status_write_admitted(STATUS_COMPLETED, STATUS_COMPLETED) == true;
  assert order_status_write_admitted(STATUS_CANCELLED, STATUS_CANCELLED) == true;
  assert order_status_same_state(STATUS_COMPLETED, STATUS_COMPLETED) == true;
  assert order_status_same_state(STATUS_UNSET, STATUS_UNSET) == false;
  assert order_status_same_state(STATUS_PENDING, STATUS_CONFIRMED) == false;
}

test order_status_unknown_requested_name_is_never_admitted {
  assert order_status_write_admitted(STATUS_PENDING, STATUS_UNSET) == false;
  assert order_status_write_admitted(STATUS_PENDING, 10) == false;
  assert order_status_write_admitted(STATUS_PENDING, order_status_code_of("shipped")) == false;
  assert order_status_write_admitted(STATUS_PENDING, order_status_code_of("processing")) == false;
  ; And the other direction: an unreadable CURRENT state admits the write, which is the shipped
  ; behaviour and the opposite direction of failure from the line above.
  assert order_status_write_admitted(STATUS_UNSET, STATUS_CONFIRMED) == true;
  assert order_status_write_admitted(10, STATUS_CONFIRMED) == true;
}

test order_status_delivered_is_accepted_and_never_stored {
  assert ALIAS_ACCEPTED_NAME == "delivered";
  assert ALIAS_PERSISTED_NAME == "completed";
  assert IN_SOURCE_COMMENT_CALLS_COMPLETED_THE_ALIAS == true;
  assert IN_SOURCE_COMMENT_ALIAS_DIRECTION_IS_REVERSED == true;
  assert DELIVERED_IS_NEVER_PERSISTED_BY_THE_WRITE_PATH == true;
  assert order_status_code_of(ALIAS_ACCEPTED_NAME) == STATUS_DELIVERED;
  assert order_status_persisted_code(STATUS_DELIVERED) == STATUS_COMPLETED;
  assert order_status_persisted_code(STATUS_COMPLETED) == STATUS_COMPLETED;
  assert order_status_persisted_code(STATUS_DELIVERED) == order_status_code_of(ALIAS_PERSISTED_NAME);
  ; Every other accepted name is stored as itself.
  assert order_status_persisted_code(STATUS_PREPARING) == STATUS_PREPARING;
  assert order_status_persisted_code(STATUS_OUT_FOR_DELIVERY) == STATUS_OUT_FOR_DELIVERY;
  assert order_status_persisted_code(STATUS_CANCELLED) == STATUS_CANCELLED;
  assert order_status_persisted_code(STATUS_UNSET) == STATUS_UNSET;
  assert order_status_persisted_code(10) == STATUS_UNSET;
}

test order_status_path_input_caps_refuse_with_four_hundred_in_shipped_order {
  assert ORDER_ID_CHARS_MAX == 200;
  assert STATUS_CHARS_MAX == 50;
  assert order_status_validation_reason(200, 9, STATUS_CONFIRMED) == REFUSAL_REASON_NONE;
  assert order_status_validation_reason(201, 9, STATUS_CONFIRMED) == REFUSAL_REASON_ID_TOO_LONG;
  assert order_status_validation_reason(6, 51, STATUS_CONFIRMED) == REFUSAL_REASON_STATUS_TOO_LONG;
  assert order_status_validation_reason(6, 7, STATUS_UNSET) == REFUSAL_REASON_STATUS_UNKNOWN;
  ; Precedence: the id cap answers first even when every later check would also refuse.
  assert order_status_validation_reason(201, 51, STATUS_UNSET) == REFUSAL_REASON_ID_TOO_LONG;
  assert order_status_validation_reason(6, 51, STATUS_UNSET) == REFUSAL_REASON_STATUS_TOO_LONG;
  assert order_status_validation_refusal(200, 9, STATUS_CONFIRMED) == REFUSAL_NONE;
  assert order_status_validation_refusal(201, 9, STATUS_CONFIRMED) == HTTP_BAD_REQUEST;
  assert order_status_validation_refusal(6, 51, STATUS_CONFIRMED) == HTTP_BAD_REQUEST;
  assert order_status_validation_refusal(6, 7, STATUS_UNSET) == HTTP_BAD_REQUEST;
}

test order_status_every_accepted_name_fits_the_column_today {
  assert DB_STATUS_COLUMN_CHARS == 30;
  assert LONGEST_ACCEPTED_NAME_CHARS == 16;
  assert DOOR_CAP_EXCEEDS_COLUMN_WIDTH == true;
  assert STATUS_CHARS_MAX > DB_STATUS_COLUMN_CHARS;
  assert order_status_name_fits_column(LONGEST_ACCEPTED_NAME_CHARS) == true;
  assert order_status_name_fits_column(DB_STATUS_COLUMN_CHARS) == true;
  assert order_status_name_fits_column(31) == false;
  ; A name inside the door cap and outside the column is representable at the door and not in the
  ; column, which is why the gap is recorded instead of being called safe.
  assert order_status_name_fits_column(STATUS_CHARS_MAX) == false;
}

test order_status_customer_cancellation_needs_pending_and_refuses_with_conflict {
  assert CANCEL_WRITES_NAME == "cancelled";
  assert order_status_code_of(CANCEL_WRITES_NAME) == STATUS_CANCELLED;
  assert order_status_customer_cancel_admitted(STATUS_PENDING) == true;
  assert order_status_customer_cancel_admitted(STATUS_CONFIRMED) == false;
  assert order_status_customer_cancel_admitted(STATUS_PREPARING) == false;
  assert order_status_customer_cancel_admitted(STATUS_READY) == false;
  assert order_status_customer_cancel_admitted(STATUS_OUT_FOR_DELIVERY) == false;
  assert order_status_customer_cancel_admitted(STATUS_COMPLETED) == false;
  assert order_status_customer_cancel_admitted(STATUS_CANCELLED) == false;
  assert order_status_customer_cancel_admitted(STATUS_UNSET) == false;
  assert order_status_customer_cancel_refusal(STATUS_PENDING) == REFUSAL_NONE;
  assert order_status_customer_cancel_refusal(STATUS_CONFIRMED) == HTTP_CONFLICT;
  assert order_status_customer_cancel_refusal(STATUS_COMPLETED) == HTTP_CONFLICT;
  ; A non-terminal status is still a refusal here, so cancellation is NOT the terminal test.
  assert order_status_is_terminal(STATUS_CONFIRMED) == false;
}

test order_status_five_declarations_of_one_column_carry_four_vocabularies {
  assert WRITE_PATH_MODEL == "src/api/orders.rs:1991-2001";
  assert TRIOS_STORE_MODEL == "src/trios/store.rs:175-182";
  assert UI_TYPES_MODEL == "src/ui/api/types.rs:179-189";
  assert TRIOS_STORE_VARIANT_COUNT == 6;
  assert TRIOS_STORE_MISSING_COUNT == 3;
  assert TRIOS_STORE_MISSING_NAMES.len == TRIOS_STORE_MISSING_COUNT;
  assert TRIOS_STORE_MISSING_NAMES[0] == "preparing";
  assert TRIOS_STORE_MISSING_NAMES[1] == "out_for_delivery";
  assert TRIOS_STORE_MISSING_NAMES[2] == "delivered";
  assert UI_TYPES_VARIANT_COUNT == 9;
  assert UI_TYPES_MISSING_NAMES.len == UI_TYPES_MISSING_COUNT;
  assert UI_TYPES_EXTRA_NAMES.len == UI_TYPES_EXTRA_COUNT;
  assert UI_TYPES_EXTRA_NAMES[0] == "processing";
  assert UI_TYPES_EXTRA_NAMES[1] == "shipped";
  assert SHIPPED_TEST_PINS_SHIPPED_AS_A_BAD_REQUEST == true;
  assert order_status_code_of(UI_TYPES_EXTRA_NAMES[1]) == STATUS_UNSET;
  assert TYPED_MODELS_AGREE == false;
  assert TYPED_MODELS_AGREE == order_status_models_agree(TRIOS_STORE_VARIANT_COUNT, TRIOS_STORE_MISSING_COUNT, TRIOS_STORE_EXTRA_COUNT, UI_TYPES_VARIANT_COUNT, UI_TYPES_MISSING_COUNT, UI_TYPES_EXTRA_COUNT);
  ; The fourth and fifth, which the first draft of this file did not count at all.
  assert DISPLAY_PIPELINE_MODEL_A == "src/trios/order_status_view.rs:65-72";
  assert DISPLAY_PIPELINE_MODEL_A_BEFORE_REPAIR == "src/ui/components/status_stepper.rs:16-23";
  assert DISPLAY_PIPELINE_MODEL_A != DISPLAY_PIPELINE_MODEL_A_BEFORE_REPAIR;
  assert DISPLAY_PIPELINE_MODEL_A_MOVED_AT == "2026-09-22";
  assert DISPLAY_PIPELINE_MODEL_A_IS_HOST_COMPILED == true;
  assert DISPLAY_PIPELINE_MODEL_B == "src/ui/screens/admin_screen.rs:2910-2917";
  assert ADMIN_SITES_REPOINTED_AT == "2026-09-22";
  assert DISPLAY_PIPELINE_VARIANT_COUNT == 6;
  assert DISPLAY_PIPELINE_MISSING_NAMES.len == DISPLAY_PIPELINE_MISSING_COUNT;
  assert DISPLAY_PIPELINE_MISSING_NAMES[0] == "completed";
  assert DISPLAY_PIPELINE_MISSING_NAMES[1] == "rejected";
  assert DISPLAY_PIPELINE_MISSING_NAMES[2] == "cancelled";
  ; All three names the pipelines drop are terminal, which is what makes dropping them costly.
  assert order_status_is_terminal(order_status_code_of(DISPLAY_PIPELINE_MISSING_NAMES[0])) == true;
  assert order_status_is_terminal(order_status_code_of(DISPLAY_PIPELINE_MISSING_NAMES[1])) == true;
  assert order_status_is_terminal(order_status_code_of(DISPLAY_PIPELINE_MISSING_NAMES[2])) == true;
  assert DISPLAY_PIPELINES_AGREE == false;
  assert DISPLAY_PIPELINES_AGREE == order_status_display_pipeline_agrees(DISPLAY_PIPELINE_VARIANT_COUNT, DISPLAY_PIPELINE_MISSING_COUNT, DISPLAY_PIPELINE_EXTRA_COUNT);
  assert order_status_display_pipeline_agrees(STATUS_COUNT, 0, 0) == true;
  ; Five declarations, two of them identical, so four vocabularies.
  assert COLUMN_ENUMERATION_COUNT == 5;
  assert DISTINCT_VOCABULARY_COUNT == 4;
  assert DISPLAY_PIPELINES_ARE_IDENTICAL == true;
  assert COLUMN_ENUMERATION_COUNT == DISTINCT_VOCABULARY_COUNT + 1;
}

test order_status_equal_variant_counts_do_not_prove_agreement {
  ; The measured UI model has the same nine variants as the write path and shares only seven
  ; names. A predicate on totals alone would call that agreement, so the predicate takes the
  ; missing and extra lists too.
  assert UI_TYPES_VARIANT_COUNT == STATUS_COUNT;
  assert order_status_models_agree(9, 0, 0, 9, 2, 2) == false;
  assert order_status_models_agree(9, 0, 0, 9, 0, 2) == false;
  assert order_status_models_agree(9, 0, 0, 9, 2, 0) == false;
  assert order_status_models_agree(6, 3, 0, 9, 0, 0) == false;
  assert order_status_models_agree(9, 3, 0, 9, 0, 0) == false;
  ; The only shape that agrees, which is what a future fix has to produce.
  assert order_status_models_agree(9, 0, 0, 9, 0, 0) == true;
}

test order_status_the_fourth_reader_recognises_two_of_the_four_terminal_names {
  assert REFUND_GUARD_SOURCE == "src/bot/callbacks.rs:120-122";
  assert REFUND_GUARD_TERMINAL_COUNT == 2;
  assert REFUND_GUARD_MISSING_COUNT == 2;
  assert REFUND_GUARD_MISSING_NAMES.len == REFUND_GUARD_MISSING_COUNT;
  assert REFUND_GUARD_MISSING_NAMES[0] == "delivered";
  assert REFUND_GUARD_MISSING_NAMES[1] == "cancelled";
  assert order_status_is_terminal(order_status_code_of(REFUND_GUARD_MISSING_NAMES[0])) == true;
  assert order_status_is_terminal(order_status_code_of(REFUND_GUARD_MISSING_NAMES[1])) == true;
  assert REFUND_GUARD_TERMINAL_COUNT + REFUND_GUARD_MISSING_COUNT == TERMINAL_COUNT;
  assert TERMINAL_GUARDS_AGREE == false;
  assert TERMINAL_GUARDS_AGREE == order_status_terminal_guard_agrees(REFUND_GUARD_TERMINAL_COUNT, REFUND_GUARD_MISSING_COUNT);
  ; The API reject path reads the full four, so the disagreement is between two guards and not
  ; between one guard and this file.
  assert order_status_terminal_guard_agrees(API_REJECT_GUARD_TERMINAL_COUNT, API_REJECT_GUARD_MISSING_COUNT) == true;
}

test order_status_names_its_owners_instead_of_restating_them {
  assert REUSES_COMMERCE_ID == "turbobaby/commerce";
  assert REUSES_AVAILABILITY_ID == "turbobaby/availability";
  assert REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity";
  assert REUSES_COMMERCE_ID != ID;
  assert REUSES_AVAILABILITY_ID != ID;
  assert REUSES_REQUEST_IDENTITY_ID != ID;
  assert REUSES_COMMERCE_ID != REUSES_AVAILABILITY_ID;
  assert REUSES_COMMERCE_ID != REUSES_REQUEST_IDENTITY_ID;
  assert REUSES_AVAILABILITY_ID != REUSES_REQUEST_IDENTITY_ID;
  assert ID == "turbobaby/order-status";
  assert KIND == "contract";
  assert IMPLEMENTATION == "src/api/orders.rs";
  assert STORAGE == "migrations/001_initial.sql:67";
  assert MEASURED_AT == "2026-09-20";
}

test order_status_declares_the_rules_this_repository_does_not_ship {
  assert NO_SERVER_SIDE_TRANSITION_EDGE_TABLE_IS_SHIPPED == true;
  ; And the half of it that is NOT an absence: an ordering is shipped client-side, unenforced.
  assert CLIENT_SIDE_TRANSITION_ORDER_IS_SHIPPED == true;
  assert CLIENT_PIPELINE_IS_ENFORCED_ANYWHERE == false;
  assert CLIENT_PIPELINE_LENGTH == DISPLAY_PIPELINE_VARIANT_COUNT;
  assert CLIENT_PIPELINE_SOURCE == DISPLAY_PIPELINE_MODEL_B;
  ; The one move the admin UI offers last is the name the write path never stores.
  assert CLIENT_PIPELINE_LAST_NAME == ALIAS_ACCEPTED_NAME;
  assert order_status_persisted_code(order_status_code_of(CLIENT_PIPELINE_LAST_NAME)) == STATUS_COMPLETED;
  assert BACKWARD_TRANSITION_IS_ADMITTED == true;
  ; Backwards and skipping are both admitted today, and both are consequences of there being no
  ; edge table rather than decisions anyone recorded.
  assert order_status_write_admitted(STATUS_READY, STATUS_PENDING) == true;
  assert order_status_write_admitted(STATUS_PENDING, STATUS_OUT_FOR_DELIVERY) == true;
  assert ORDER_STATUS_HAS_NO_DATABASE_CONSTRAINT == true;
  assert TRANSITION_AUTHORITY_IS_NOT_OWNED_HERE == true;
}

; The collision census, pinned to its literals so the day availability.t27 or referral_program.t27
; renames one of these, this test is the thing that notices.
test order_status_bare_names_collide_with_two_other_contracts {
  assert BARE_STATUS_NAME_CENSUS_MEASURED_AT == "2026-09-21";
  assert CONTRACTS_DECLARING_BARE_STATUS_NAMES == 4;
  assert COLLIDING_BARE_STATUS_NAMES.len == COLLIDING_BARE_STATUS_NAME_COUNT;
  assert COLLIDING_BARE_STATUS_NAMES[0] == "STATUS_NAMES";
  assert COLLIDING_BARE_STATUS_NAMES[1] == "STATUS_UNSET";
  assert COLLIDING_BARE_STATUS_NAMES[2] == "STATUS_PENDING";
  assert COLLIDING_BARE_STATUS_NAMES[3] == "STATUS_CONFIRMED";
  assert order_status_bare_name_collides("STATUS_NAMES") == true;
  assert order_status_bare_name_collides("STATUS_CONFIRMED") == true;
  ; The two this file owns outright, which is the other half of the finding.
  assert order_status_bare_name_collides("STATUS_COUNT") == false;
  assert order_status_bare_name_collides("STATUS_CHARS_MAX") == false;
  assert order_status_bare_name_collides("STATUS_OUT_FOR_DELIVERY") == false;
  ; The arity difference, which is what makes STATUS_NAMES the worst of the four.
  assert STATUS_NAMES_ARITY_HERE == 9;
  assert STATUS_NAMES_ARITY_IN_AVAILABILITY == 4;
  assert STATUS_NAMES_ARITIES_DIFFER == true;
  assert STATUS_NAMES_ARITY_HERE != STATUS_NAMES_ARITY_IN_AVAILABILITY;
  assert STATUS_NAMES_ARITY_HERE == STATUS_COUNT;
  assert STATUS_NAMES.len == STATUS_NAMES_ARITY_HERE;
  assert STATUS_NAMES_SHARE_NO_VALUE_WITH_AVAILABILITY == true;
  ; availability.t27's four values, asked of this file's own lookup: all four are unknown here.
  assert order_status_code_of("available") == STATUS_UNSET;
  assert order_status_code_of("rented") == STATUS_UNSET;
  assert order_status_code_of("service") == STATUS_UNSET;
  assert order_status_code_of("retired") == STATUS_UNSET;
  ; The zero that three contracts agree on, and the collision nobody renamed away.
  assert STATUS_UNSET_DECLARER_COUNT == 3;
  assert STATUS_UNSET_AGREES_ACROSS_EVERY_DECLARER == true;
  assert STATUS_UNSET == 0;
  assert COLLIDING_WITH_REFERRAL_PROGRAM_ID == "turbobaby/referral-program";
  assert COLLIDING_WITH_REFERRAL_PROGRAM_ID != ID;
  assert COLLIDING_WITH_REFERRAL_PROGRAM_ID != REUSES_AVAILABILITY_ID;
  assert NO_DECLARATION_IS_RENAMED_TO_AVOID_THE_COLLISION == true;
}

test order_status_the_iana_precedent_is_nine_contracts_and_not_two {
  assert IANA_STATUS_CENSUS_MEASURED_AT == "2026-09-21";
  assert CONTRACTS_DECLARING_AN_IANA_STATUS == 9;
  assert CONTRACTS_DECLARING_AN_IANA_STATUS > 2;
  assert IANA_STATUS_DECLARERS.len == CONTRACTS_DECLARING_AN_IANA_STATUS;
  assert CONTRACTS_DECLARING_FOUR_HUNDRED == 4;
  assert CONTRACTS_DECLARING_FOUR_HUNDRED_AND_NINE == 1;
  assert CONTRACTS_DECLARING_FOUR_HUNDRED > CONTRACTS_DECLARING_FOUR_HUNDRED_AND_NINE;
  assert IANA_STATUS_PRECEDENT_A == "turbobaby/publication";
  assert IANA_STATUS_PRECEDENT_B == "turbobaby/catalog-api";
  assert IANA_STATUS_PRECEDENT_A != IANA_STATUS_PRECEDENT_B;
  assert IANA_STATUS_PRECEDENT_A != ID;
  assert IANA_STATUS_PRECEDENT_B != ID;
  assert NEITHER_PRECEDENT_COVERS_THIS_SURFACE == true;
  assert HTTP_BAD_REQUEST == 400;
  assert HTTP_CONFLICT == 409;
  ; The list, pinned name by name. This file is in it, which is the point: the sentence above is
  ; about a habit this contract shares and not about a licence only neighbours have.
  assert IANA_STATUS_DECLARERS[0] == "turbobaby/cart-persistence";
  assert IANA_STATUS_DECLARERS[1] == "turbobaby/catalog-api";
  assert IANA_STATUS_DECLARERS[2] == "turbobaby/client-errors";
  assert IANA_STATUS_DECLARERS[3] == "turbobaby/happy-hour";
  assert IANA_STATUS_DECLARERS[4] == ID;
  assert IANA_STATUS_DECLARERS[5] == "turbobaby/publication";
  assert IANA_STATUS_DECLARERS[6] == "turbobaby/request-identity";
  assert IANA_STATUS_DECLARERS[7] == "turbobaby/upload-media";
  assert IANA_STATUS_DECLARERS[8] == "turbobaby/webapp-bridge";
  assert IANA_STATUS_DECLARERS[1] == IANA_STATUS_PRECEDENT_B;
  assert IANA_STATUS_DECLARERS[5] == IANA_STATUS_PRECEDENT_A;
  assert IANA_STATUS_DECLARERS[6] == REUSES_REQUEST_IDENTITY_ID;
  ; The three a prefix grep does not see, which is why the total is nine and not six.
  assert IANA_STATUS_DECLARERS_MISSED_BY_A_PREFIX_GREP == 3;
  assert CONTRACTS_DECLARING_AN_IANA_STATUS - IANA_STATUS_DECLARERS_MISSED_BY_A_PREFIX_GREP == 6;
}

test order_status_is_named_as_the_order_owner_from_two_other_sides {
  assert INBOUND_EDGE_CENSUS_MEASURED_AT == "2026-09-21";
  assert INBOUND_EDGES.len == INBOUND_EDGE_COUNT;
  assert INBOUND_EDGES[0] == "turbobaby/bot-surface";
  assert INBOUND_EDGES[1] == "turbobaby/cart-persistence";
  assert INBOUND_EDGES[0] != INBOUND_EDGES[1];
  assert INBOUND_EDGES[0] != ID;
  assert INBOUND_EDGES[1] != ID;
  ; An inbound edge is not an outbound one: neither of those two is named above as an owner here.
  assert INBOUND_EDGES[0] != REUSES_COMMERCE_ID;
  assert INBOUND_EDGES[1] != REUSES_COMMERCE_ID;
  assert INBOUND_EDGES[0] != REUSES_AVAILABILITY_ID;
  assert INBOUND_EDGES[1] != REUSES_REQUEST_IDENTITY_ID;
}

; --- Invariants ---------------------------------------------------------------------------------

invariant order_status_zero_is_never_an_accepted_status
  assert order_status_is_known(STATUS_UNSET) == false and order_status_write_admitted(STATUS_PENDING, STATUS_UNSET) == false

invariant order_status_terminal_codes_are_a_subset_of_the_vocabulary
  assert order_status_is_known(TERMINAL_CODES[0]) == true and order_status_is_known(TERMINAL_CODES[3]) == true and order_status_is_terminal(TERMINAL_CODES[1]) == true and order_status_is_terminal(TERMINAL_CODES[2]) == true

invariant order_status_a_terminal_order_never_moves_to_a_different_state
  assert order_status_write_admitted(STATUS_COMPLETED, STATUS_PENDING) == false and order_status_write_admitted(STATUS_CANCELLED, STATUS_CONFIRMED) == false and order_status_write_admitted(STATUS_REJECTED, STATUS_READY) == false and order_status_write_admitted(STATUS_DELIVERED, STATUS_PENDING) == false

invariant order_status_a_self_transition_is_admitted_only_for_a_known_name
  assert order_status_write_admitted(STATUS_COMPLETED, STATUS_COMPLETED) == true and order_status_same_state(STATUS_UNSET, STATUS_UNSET) == false

invariant order_status_delivered_never_survives_the_write_path
  assert order_status_persisted_code(STATUS_DELIVERED) == STATUS_COMPLETED and DELIVERED_IS_NEVER_PERSISTED_BY_THE_WRITE_PATH == true

invariant order_status_an_unknown_name_is_refused_before_anything_else_is_decided
  assert order_status_validation_reason(6, 7, STATUS_UNSET) == REFUSAL_REASON_STATUS_UNKNOWN and order_status_validation_refusal(6, 7, STATUS_UNSET) == HTTP_BAD_REQUEST

invariant order_status_an_oversized_input_is_refused_before_the_vocabulary_is_consulted
  assert order_status_validation_reason(201, 51, STATUS_UNSET) == REFUSAL_REASON_ID_TOO_LONG and order_status_validation_reason(6, 51, STATUS_UNSET) == REFUSAL_REASON_STATUS_TOO_LONG

invariant order_status_cancellation_is_admitted_from_pending_and_from_nothing_else
  assert order_status_customer_cancel_admitted(STATUS_PENDING) == true and order_status_customer_cancel_refusal(STATUS_CONFIRMED) == HTTP_CONFLICT and order_status_customer_cancel_refusal(STATUS_COMPLETED) == HTTP_CONFLICT

invariant order_status_no_accepted_name_can_overflow_the_column
  assert order_status_name_fits_column(LONGEST_ACCEPTED_NAME_CHARS) == true and LONGEST_ACCEPTED_NAME_CHARS <= DB_STATUS_COLUMN_CHARS

invariant order_status_typed_models_stay_marked_as_disagreeing_until_the_rust_agrees
  assert TYPED_MODELS_AGREE == order_status_models_agree(TRIOS_STORE_VARIANT_COUNT, TRIOS_STORE_MISSING_COUNT, TRIOS_STORE_EXTRA_COUNT, UI_TYPES_VARIANT_COUNT, UI_TYPES_MISSING_COUNT, UI_TYPES_EXTRA_COUNT) and TYPED_MODELS_AGREE == false

invariant order_status_the_two_terminal_guards_stay_marked_as_disagreeing
  assert TERMINAL_GUARDS_AGREE == order_status_terminal_guard_agrees(REFUND_GUARD_TERMINAL_COUNT, REFUND_GUARD_MISSING_COUNT) and order_status_terminal_guard_agrees(API_REJECT_GUARD_TERMINAL_COUNT, API_REJECT_GUARD_MISSING_COUNT) == true

invariant order_status_the_display_pipelines_stay_marked_as_disagreeing
  assert DISPLAY_PIPELINES_AGREE == order_status_display_pipeline_agrees(DISPLAY_PIPELINE_VARIANT_COUNT, DISPLAY_PIPELINE_MISSING_COUNT, DISPLAY_PIPELINE_EXTRA_COUNT) and DISPLAY_PIPELINES_AGREE == false

invariant order_status_no_edge_table_is_enforced_but_one_is_declared
  assert NO_SERVER_SIDE_TRANSITION_EDGE_TABLE_IS_SHIPPED == true and CLIENT_SIDE_TRANSITION_ORDER_IS_SHIPPED == true and CLIENT_PIPELINE_IS_ENFORCED_ANYWHERE == false and BACKWARD_TRANSITION_IS_ADMITTED == true and order_status_write_admitted(STATUS_READY, STATUS_PENDING) == true

test the_bot_reject_reverses_a_referral_credit_record_and_changes_no_guard {
  assert REFERRAL_CREDIT_ID == "turbobaby/referral-credit";
  assert BOT_REJECT_REVERSES_A_REFERRAL_CREDIT_RECORD == true;
  assert BOT_REJECT_REVERSAL_IS_IN_THE_REJECT_TRANSACTION == true;
  assert BOT_REJECT_REVERSAL_FAILS_CLOSED == true;
  assert REFERRAL_CREDIT_REVERSAL_NOTED_AT == "2026-09-26";
  assert TERMINAL_GUARDS_AGREE == false;
}
