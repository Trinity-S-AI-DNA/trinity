pub const MANIFEST_BYTES : u32 = 1478541;
pub const MANIFEST_REPO_KEY : str = "turbobaby-user-bot";
pub const MANIFEST_CATEGORY_KEY : str = "turbobaby-user-bot/specs";
pub const MANIFEST_SPEC_COUNT : u8 = 12;
pub const MANIFEST_CATEGORY_SPEC_COUNT : u8 = 12;
; This repository's own figure, identical in its repos entry and its discovery.worlds entry. The
; manifest-wide field of the same name reads 29 across all five scanned worlds, so the unqualified
; reading "the scan skipped no duplicates" is exactly the sentence this comment exists to block.
pub const MANIFEST_DUPLICATES_SKIPPED : u8 = 0;
pub const MANIFEST_DISCOVERED_AT : str = "2026-09-15T14:46:43.844Z";
; The commit the manifest published, and the local check that it is ours: git log --oneline -1
; e9356f1f resolves in this repository to the iteration 2 loop journal commit. A manifest that
; answers about a commit this repository never made would prove somebody else is published.
pub const PUBLISHED_COMMIT : str = "e9356f1f0664e8f6d963c52035a9d310761ca9a8";
pub const PUBLISHED_COMMIT_IS_IN_LOCAL_HISTORY : bool = true;
; git ls-files over specs/ on the observation date. It equalled the published count on that date,
; which is a dated witness of completeness and not a rule: adding a canonical file moves this
; number first and the manifest number only after the next scan, so a future inequality is lag,
; not loss.
; THE FUTURE THAT SENTENCE DESCRIBED HAS ARRIVED (re-measured 2026-09-21). Until this edit the
; line above read "It equals the published count today", and the "today" in it was 2026-09-20.
; It is false now, and the constant beside it is not the thing that went wrong: git ls-files over
; specs/ answers 43, because 31 further canonical files were tracked after the observation, and
; the manifest still answers 12 because it has not been scanned since. That is the lag this
; paragraph predicted, so the dated constant keeps its measured 12 and the live count is declared
; separately instead of typed over it. Neither number is a network reading: both are git ls-files
; against this repository, and no t27.ai surface was re-probed for this correction.
pub const TRACKED_SPEC_COUNT_AT_OBSERVED_AT : u8 = 12;
pub const TRACKED_SPEC_COUNT_REMEASURED_AT : str = "2026-09-21";
pub const TRACKED_SPEC_COUNT_REMEASURED : u8 = 43;
pub const TRACKED_SPEC_COUNT_EXCEEDS_THE_PUBLISHED_COUNT : bool = true;
pub const SPEC_COUNT_INEQUALITY_IS_SCAN_LAG : bool = true;
; The direction is the whole verdict. More tracked than published is a scan that has not caught up;
; fewer tracked than published would be a manifest answering about files this repository no longer
; has, which is loss and not lag. One comparison separates them, so neither reading can be taken
; for the other by a reader who meets the two numbers side by side.
pub fn spec_count_gap_is_scan_lag(tracked_now: u8, published_count: u8) bool {
  return tracked_now >= published_count;
}

