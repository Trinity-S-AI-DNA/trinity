}

; --- Queen proof and external gate -------------------------------------------------------------
pub const QUEEN_BOARD_SUPPORTS_MULTIPLE_REPOSITORIES : bool = false;
pub const QUEEN_CHANGE_IS_OWNED_BY_THIS_REPOSITORY : bool = false;
pub const QUEEN_PUBLICATION_IS_EXTERNALLY_BLOCKED : bool = true;
pub const THIS_FILE_CLAIMS_QUEEN_IS_LIVE : bool = false;

pub fn queen_publish_proved(board_supports_world: bool, board_payload_has_world: bool, board_payload_has_issue: bool, deployed_route_resolves_issue: bool) bool {
  return board_supports_world and board_payload_has_world and board_payload_has_issue and deployed_route_resolves_issue;
}

pub fn queen_block_is_external(board_supports_multiple_repositories: bool, change_owned_here: bool) bool {
  return !board_supports_multiple_repositories and !change_owned_here;
}

; --- Queen witnesses (measured 2026-09-20) ------------------------------------------------------
; THE CORRECTION. On 2026-09-13 the board was recorded as blocked AND the endpoint as absent: it
; answered 404. The absence is the part that was wrong. Today the endpoint served a payload: 200,
; with columns, a pulse and 1080 cards. Every QUEEN_* verdict above stands unchanged, because none
; of them rested on silence. They rest on the board being single-repo, and the payload that
; arrived is single-repo. An endpoint that starts answering is a fact about the endpoint, not a
; step toward publication of this world.
pub const QUEEN_BOARD_OBSERVED_AT : str = "2026-09-20";
pub const QUEEN_BOARD_URL : str = "https://trios-agent-server-production.up.railway.app/queen/public-board";
pub const QUEEN_BOARD_HTTP_STATUS_WHEN_THIS_FILE_WAS_WRITTEN : u16 = 404;
pub const QUEEN_BOARD_HTTP_STATUS : u16 = 200;
pub const QUEEN_BOARD_SERVED_A_PAYLOAD : bool = true;
; One repo string for the whole payload. The card shape is number, title, column, criteria and
; needs -- five fields, none of them a repository, so there is no field in this shape that a
; TurboBaby card could occupy even if one were pushed. Corrected 2026-09-20: an earlier reading of
; this block said the cards carry number, title and column ONLY, and that missed two fields
; without changing the conclusion. The count is the volatile part -- a re-read later the same day
; returned 1081 -- so QUEEN_BOARD_CARD_COUNT is a dated sample of a live board, never its size.
pub const QUEEN_BOARD_PAYLOAD_REPO : str = "gHashTag/t27";
pub const QUEEN_BOARD_PAYLOAD_REPO_COUNT : u8 = 1;
pub const QUEEN_BOARD_CARD_COUNT : u16 = 1080;
pub const QUEEN_BOARD_CARD_HAS_REPOSITORY_FIELD : bool = false;
; The same single-repo payload comes back with and without ?world=gHashTag/turbobaby-user-bot:
; same repo string, same columns, same card population, differing only where the live board moves
; under two successive reads. It is not byte-identical and does not need to be. So a 200
; on a world-scoped URL is not evidence that the world is scoped; it is evidence the parameter was
; accepted and dropped, which is the most convincing possible way to look published and not be.
pub const QUEEN_BOARD_WORLD_PARAMETER_IS_IGNORED : bool = true;
; Sibling routes read in the same sweep, kept so a later reader can tell a missing route from a
; failing host without re-probing, and can see that no per-world route exists to ask.
pub const QUEEN_STATUS_HTTP_STATUS : u16 = 200;
pub const QUEEN_WORLDS_HTTP_STATUS : u16 = 404;
pub const API_QUEEN_WORLDS_HTTP_STATUS : u16 = 404;
pub const QUEEN_PUBLIC_MODULES_HTTP_STATUS : u16 = 404;
pub const API_STATUS_HTTP_STATUS : u16 = 404;
; The three legs of queen_publish_proved that a payload could have witnessed and this one did not.
pub const QUEEN_BOARD_PAYLOAD_HAS_THIS_WORLD : bool = false;
pub const QUEEN_BOARD_PAYLOAD_HAS_THIS_ISSUE : bool = false;
pub const QUEEN_DEPLOYED_ROUTE_RESOLVES_THIS_ISSUE : bool = false;
pub const QUEEN_BOARD_IS_MULTI_REPO_AT_OBSERVED_AT : bool = false;
; The upstream work that would make a multi-repo board exist, and the day its state was read.
pub const QUEEN_MULTI_REPO_EPIC : str = "gHashTag/tri-27#3";
pub const QUEEN_MULTI_REPO_EPIC_IS_OPEN : bool = true;
pub const QUEEN_MULTI_REPO_EPIC_OBSERVED_AT : str = "2026-09-13";

; --- The recheck, and why it decides nothing (measured 2026-09-20) -----------------------------
; The board was re-probed later the same day and returned 502 three times running, a 109-byte body
; from the Railway edge reading "Application failed to respond", not a reply from the application.
; A fourth probe of a path that cannot exist returned the IDENTICAL status and byte count, which
; is what proves the 502 host-level and path-independent: it says the host is down, and says
; nothing at all about whether /queen/public-board exists. It therefore does not refute the 200,
; and it must never be read as a return to the 404 -- that reading would resurrect the exact stale
; fact this section was written to correct. Route existence rests on the payload-bearing
; observation alone, which is why that observation carries its date.
pub const QUEEN_BOARD_RECHECK_HTTP_STATUS : u16 = 502;
pub const QUEEN_BOARD_RECHECK_ATTEMPTS : u8 = 3;
pub const QUEEN_BOARD_RECHECK_BODY_BYTES : u16 = 109;
pub const ABSENT_PATH_RECHECK_HTTP_STATUS : u16 = 502;
pub const ABSENT_PATH_RECHECK_BODY_BYTES : u16 = 109;
pub const QUEEN_BOARD_RECHECK_IS_HOST_LEVEL : bool = true;
pub const QUEEN_BOARD_AVAILABILITY_IS_INTERMITTENT : bool = true;

; --- The world view card, which is a catalog snapshot and not the board -------------------------
; /#/queen?world=ghashtag%2Fturbobaby-user-bot does render a TurboBaby card reading 12 .t27 and 33
; open issues. That card is the strongest thing here that could be mistaken for board publication,
; so the page's own label for its own data is recorded verbatim beside it. The page says not live.
pub const WORLD_VIEW_ROUTE : str = "https://t27.ai/#/queen?world=ghashtag%2Fturbobaby-user-bot";
pub const WORLD_VIEW_CARD_IS_RENDERED : bool = true;
pub const WORLD_VIEW_CARD_SPEC_COUNT : u8 = 12;
pub const WORLD_VIEW_CARD_OPEN_ISSUE_COUNT : u8 = 33;
pub const WORLD_VIEW_PAGE_LABEL : str = "Observed: 9/15/2026, 10:25:38 PM - not live";
pub const WORLD_VIEW_CARD_IS_LABELLED_LIVE : bool = false;
pub const WORLD_VIEW_CARD_IS_CATALOG_SNAPSHOT : bool = true;

pub fn queen_board_answered(status: u16) bool {
  return status == HTTP_OK;
}

; Multi-repo needs at least one of three things: more than one repository in the payload, a
; repository on the card, or a world parameter that actually filters. This board has none.
pub fn queen_board_is_multi_repo(payload_repo_count: u8, card_has_repository_field: bool, world_parameter_ignored: bool) bool {
  return payload_repo_count > 1 or card_has_repository_field or !world_parameter_ignored;
}

; The whole point of this section: both halves are true at once, and the pair is not publication.
pub fn queen_board_answers_but_is_single_repo(board_answered: bool, board_is_multi_repo: bool) bool {
  return board_answered and !board_is_multi_repo;
}

; A later non-200 refutes an earlier payload observation only when it came from the application.
; A host-level status is identical for every path, including paths that cannot exist, so it
; carries no verdict about any one route.
pub fn recheck_refutes_payload_observation(recheck_status: u16, recheck_is_host_level: bool) bool {
  return recheck_status != HTTP_OK and !recheck_is_host_level;
}

pub fn queen_board_route_is_witnessed(payload_observed: bool, recheck_refutes: bool) bool {
  return payload_observed and !recheck_refutes;
}

; A rendered world card is board publication only if the page rendering it calls its data live.
pub fn world_view_card_is_board_publication(card_rendered: bool, card_labelled_live: bool) bool {
  return card_rendered and card_labelled_live;
}

; --- Tests -------------------------------------------------------------------------------------

test this_standalone_derivative_is_scanner_eligible_after_tracking {
  assert DISCOVERY_OWNER_MATCHES == true;
  assert REPOSITORY_IS_PUBLIC == true;
  assert REPOSITORY_IS_FORMAL_FORK == false;
  assert REPOSITORY_IS_STANDALONE_DERIVATIVE == true;
  assert world_scan_eligible(true, true, false, 1, 4096, 1) == true;
}

test a_formal_fork_is_deliberately_not_scanner_eligible {
  assert WORLD_SCAN_SKIPS_FORMAL_FORKS == true;
  assert world_scan_eligible(true, true, true, 1, 4096, 20) == false;
  assert world_scan_eligible(true, false, false, 1, 4096, 20) == false;
  assert world_scan_eligible(false, true, false, 1, 4096, 20) == false;
}

; The bounds carry a named publisher since 2026-09-24, and the test says how far that goes: the
; source is named, it was read from the published mirror, and no gate re-reads it.
test the_scanner_bounds_name_their_publisher {
  assert SCANNER_BOUNDS_SOURCE_IS_NAMED == true;
  assert SCANNER_BOUNDS_SOURCE_ID == "catalog/discovery";
  assert SCANNER_BOUNDS_SOURCE_ID != ID;
  assert SCANNER_BOUNDS_SOURCE_PATH == "t27/files/specs/catalog/discovery.t27";
  assert SCANNER_BOUNDS_SOURCE_NAMES.len == 3;
  assert SCANNER_BOUNDS_SOURCE_NAMES[0] == "PROBE_FILES";
  assert SCANNER_BOUNDS_SOURCE_NAMES[1] == "MIN_DECLARATIONS";
  assert SCANNER_BOUNDS_SOURCE_NAMES[2] == "MAX_FILE_BYTES";
  assert SCANNER_BOUNDS_READ_AT == "2026-09-24";
  assert SCANNER_BOUNDS_WERE_READ_FROM_THE_PUBLISHED_MIRROR == true;
  assert SCANNER_BOUNDS_UPSTREAM_WAS_REREAD == false;
  assert SCANNER_BOUNDS_ARE_CHECKED_BY_A_GATE == false;
}

test scanner_probe_window_and_file_size_fail_closed {
  assert PROBE_FILES == 8;
  assert MAX_FILE_BYTES == 1048576;
  assert scanner_probe_witness_valid(1, MAX_FILE_BYTES, 1) == true;
  assert scanner_probe_witness_valid(PROBE_FILES, MAX_FILE_BYTES, 1) == true;
  assert scanner_probe_witness_valid(0, 4096, 1) == false;
  assert scanner_probe_witness_valid(PROBE_FILES + 1, 4096, 1) == false;
  assert scanner_probe_witness_valid(1, MAX_FILE_BYTES + 1, 1) == false;
  assert scanner_probe_witness_valid(1, 4096, 0) == false;
}

test untracked_or_empty_canonical_source_is_not_discoverable {
  assert canonical_source_discoverable(true, true, 1) == true;
  assert canonical_source_discoverable(true, false, 1) == false;
  assert canonical_source_discoverable(false, true, 1) == false;
  assert canonical_source_discoverable(true, true, 0) == false;
}

test parse_and_typecheck_evidence_is_nonvacuous {
  assert parse_evidence_valid(true, 1) == true;
  assert parse_evidence_valid(true, 0) == false;
  assert parse_evidence_valid(false, 8) == false;
  assert typecheck_evidence_valid(true, 0, 0) == true;
  assert typecheck_evidence_valid(true, 1, 0) == false;
  assert typecheck_evidence_valid(true, 0, 1) == false;
  assert typecheck_evidence_valid(false, 0, 0) == false;
}

test tests_must_be_found_and_all_five_generators_must_emit {
  assert test_inventory_evidence_valid(1) == true;
  assert test_inventory_evidence_valid(0) == false;
  assert REQUIRED_GENERATOR_COUNT == 5;
  assert five_generators_emitted(true, true, true, true, true) == true;
  assert five_generators_emitted(true, true, true, true, false) == false;
  assert five_generators_emitted(false, true, true, true, true) == false;
}

test compiler_evidence_requires_every_independent_lane {
  assert compiler_evidence_complete(true, true, true, true) == true;
  assert compiler_evidence_complete(false, true, true, true) == false;
  assert compiler_evidence_complete(true, false, true, true) == false;
  assert compiler_evidence_complete(true, true, false, true) == false;
  assert compiler_evidence_complete(true, true, true, false) == false;
}

test spec_browser_live_status_requires_deployed_proof {
  assert SPEC_BROWSER_DISCOVERY_AUTOMATIC == true;
  assert SPEC_BROWSER_DEPLOY_IS_OWNER_GATE == true;
  // Was: THIS_FILE_CLAIMS_SPEC_BROWSER_IS_LIVE == false. On 2026-09-20 the three legs were
  // witnessed, so the claim is pinned to the legs rather than to a constant false.
  assert THIS_FILE_CLAIMS_SPEC_BROWSER_IS_LIVE == spec_browser_publish_proved(MANIFEST_HAS_THIS_WORLD, MANIFEST_HAS_THIS_MODULE_CATEGORY, DEPLOYED_ROUTE_RESOLVES_THIS_MODULE);
  assert spec_browser_publish_proved(true, true, true) == true;
  assert spec_browser_publish_proved(true, true, false) == false;
}

test namespaced_agent_source_is_not_publication_proof {
  assert AGENT_CARD_PATH == "specs/agents/turbobaby.t27";
  assert AGENT_CARD_ID == "turbobaby/BOT";
  assert AGENT_CARD_IS_NAMESPACED == true;
  assert AGENT_CARD_CLAIMS_ALPHABET_SEAT == false;
  assert agent_card_source_ready(true, true, true) == true;
  assert agent_card_publish_proved(true, false, false) == false;
  assert CURRENT_UPSTREAM_ACCEPTS_NAMESPACED_AGENT_CARD == false;
  assert THIS_FILE_CLAIMS_AGENT_CARD_IS_LIVE == false;
}

test queen_remains_external_until_every_proof_lane_exists {
  assert QUEEN_BOARD_SUPPORTS_MULTIPLE_REPOSITORIES == false;
  assert QUEEN_CHANGE_IS_OWNED_BY_THIS_REPOSITORY == false;
  assert QUEEN_PUBLICATION_IS_EXTERNALLY_BLOCKED == true;
  assert THIS_FILE_CLAIMS_QUEEN_IS_LIVE == false;
  assert queen_block_is_external(false, false) == true;
  assert queen_publish_proved(false, false, false, false) == false;
  assert queen_publish_proved(true, true, true, true) == true;
}

test publication_contract_contains_no_domain_payload {
  assert CANONICAL_DIRECTORY == "specs/turbobaby";
  assert COMPILER_EVIDENCE_SCOPE == "parse structure, typecheck report, declaration enumeration, and non-empty generator emission";
  assert TEST_COMMAND_EXECUTES_ASSERTIONS == false;
}

; The dated count and the live one, kept apart on purpose. The first is what was true when the
; manifest was read and is what the witness test above compares against; the second is what is
; true today and is compared against nothing published, because nothing published has been read
; since. The last assert is the one that matters to a later reader: the two dates differ, so the
; two numbers are not two readings of one measurement.
test the_tracked_count_outgrew_the_published_one_and_that_is_lag_not_loss {
  assert TRACKED_SPEC_COUNT_AT_OBSERVED_AT == 12;
  assert TRACKED_SPEC_COUNT_REMEASURED == 43;
  assert TRACKED_SPEC_COUNT_REMEASURED_AT == "2026-09-21";
  assert TRACKED_SPEC_COUNT_REMEASURED > TRACKED_SPEC_COUNT_AT_OBSERVED_AT;
  assert TRACKED_SPEC_COUNT_REMEASURED > MANIFEST_SPEC_COUNT;
  assert TRACKED_SPEC_COUNT_EXCEEDS_THE_PUBLISHED_COUNT == true;
  assert SPEC_COUNT_INEQUALITY_IS_SCAN_LAG == true;
  assert spec_count_gap_is_scan_lag(TRACKED_SPEC_COUNT_REMEASURED, MANIFEST_SPEC_COUNT) == true;
  assert spec_count_gap_is_scan_lag(TRACKED_SPEC_COUNT_AT_OBSERVED_AT, MANIFEST_SPEC_COUNT) == true;
  assert spec_count_gap_is_scan_lag(11, MANIFEST_SPEC_COUNT) == false;
  assert TRACKED_SPEC_COUNT_REMEASURED_AT != SPEC_BROWSER_OBSERVED_AT;
}

test spec_browser_manifest_witness_was_observed_and_is_nonvacuous {
  assert SPEC_BROWSER_OBSERVED_AT == "2026-09-20";
  assert MANIFEST_HTTP_STATUS == HTTP_OK;
  assert MANIFEST_BYTES == 1478541;
  assert MANIFEST_REPO_KEY == "turbobaby-user-bot";
  assert MANIFEST_CATEGORY_KEY == "turbobaby-user-bot/specs";
  assert MANIFEST_SPEC_COUNT == 12;
  assert MANIFEST_CATEGORY_SPEC_COUNT == MANIFEST_SPEC_COUNT;
  assert MANIFEST_DUPLICATES_SKIPPED == 0;
  assert MANIFEST_DISCOVERED_AT == "2026-09-15T14:46:43.844Z";
  assert TRACKED_SPEC_COUNT_AT_OBSERVED_AT == MANIFEST_SPEC_COUNT;
  assert manifest_witness_valid(MANIFEST_HTTP_STATUS, MANIFEST_BYTES, MANIFEST_SPEC_COUNT) == true;
  assert manifest_witness_valid(HTTP_NOT_FOUND, MANIFEST_BYTES, MANIFEST_SPEC_COUNT) == false;
  assert manifest_witness_valid(HTTP_OK, 0, MANIFEST_SPEC_COUNT) == false;
  assert manifest_witness_valid(HTTP_OK, MANIFEST_BYTES, 0) == false;
}

test the_deployed_route_resolves_modules_of_this_repository {
  assert SHARED_CORE_HTTP_STATUS == HTTP_OK;
  assert SHARED_CORE_BYTES == 2329087;
  assert RESOLVED_MODULE_COUNT == 12;
  assert RESOLVED_MODULE_COUNT == TRACKED_SPEC_COUNT_AT_OBSERVED_AT;
  assert SAMPLED_RESOLVED_MODULE_COUNT == 3;
  assert RESOLVED_MODULE_PATHS.len == SAMPLED_RESOLVED_MODULE_COUNT;
  assert RESOLVED_MODULE_PATHS[0] == "turbobaby-user-bot/specs/turbobaby/commerce.t27";
  assert RESOLVED_MODULE_PATHS[1] == "turbobaby-user-bot/specs/turbobaby/catalog_api.t27";
  assert RESOLVED_MODULE_PATHS[2] == "turbobaby-user-bot/specs/turbobaby/rental_terms.t27";
  assert deployed_route_witness_valid(SHARED_CORE_HTTP_STATUS, RESOLVED_MODULE_COUNT) == true;
  assert deployed_route_witness_valid(HTTP_NOT_FOUND, RESOLVED_MODULE_COUNT) == false;
  assert deployed_route_witness_valid(HTTP_OK, 0) == false;
}

test spec_browser_live_claim_agrees_with_its_witnesses {
  assert MANIFEST_HAS_THIS_WORLD == true;
  assert MANIFEST_HAS_THIS_MODULE_CATEGORY == true;
  assert DEPLOYED_ROUTE_RESOLVES_THIS_MODULE == true;
  assert PUBLISHED_COMMIT == "e9356f1f0664e8f6d963c52035a9d310761ca9a8";
  assert PUBLISHED_COMMIT_IS_IN_LOCAL_HISTORY == true;
  assert THIS_FILE_CLAIMS_SPEC_BROWSER_IS_LIVE == true;
  assert THIS_FILE_CLAIMS_SPEC_BROWSER_IS_LIVE == spec_browser_live_claim_follows(MANIFEST_HAS_THIS_WORLD, MANIFEST_HAS_THIS_MODULE_CATEGORY, DEPLOYED_ROUTE_RESOLVES_THIS_MODULE, PUBLISHED_COMMIT_IS_IN_LOCAL_HISTORY);
  assert spec_browser_live_claim_follows(false, true, true, true) == false;
  assert spec_browser_live_claim_follows(true, false, true, true) == false;
  assert spec_browser_live_claim_follows(true, true, false, true) == false;
  assert spec_browser_live_claim_follows(true, true, true, false) == false;
}

test the_queen_endpoint_answers_now_and_that_changes_no_verdict {
  assert QUEEN_BOARD_OBSERVED_AT == "2026-09-20";
  assert QUEEN_BOARD_HTTP_STATUS_WHEN_THIS_FILE_WAS_WRITTEN == HTTP_NOT_FOUND;
  assert QUEEN_BOARD_HTTP_STATUS == HTTP_OK;
  assert QUEEN_BOARD_SERVED_A_PAYLOAD == true;
  assert queen_board_answered(QUEEN_BOARD_HTTP_STATUS) == true;
  assert queen_board_answered(QUEEN_BOARD_HTTP_STATUS_WHEN_THIS_FILE_WAS_WRITTEN) == false;
  assert QUEEN_STATUS_HTTP_STATUS == HTTP_OK;
  assert QUEEN_WORLDS_HTTP_STATUS == HTTP_NOT_FOUND;
  assert API_QUEEN_WORLDS_HTTP_STATUS == HTTP_NOT_FOUND;
  assert QUEEN_PUBLIC_MODULES_HTTP_STATUS == HTTP_NOT_FOUND;
  assert API_STATUS_HTTP_STATUS == HTTP_NOT_FOUND;
  assert QUEEN_PUBLICATION_IS_EXTERNALLY_BLOCKED == true;
  assert THIS_FILE_CLAIMS_QUEEN_IS_LIVE == false;
}

test an_answering_single_repo_board_is_not_publication_of_this_world {
  assert QUEEN_BOARD_PAYLOAD_REPO == "gHashTag/t27";
  assert QUEEN_BOARD_PAYLOAD_REPO_COUNT == 1;
  assert QUEEN_BOARD_CARD_COUNT == 1080;
  assert QUEEN_BOARD_CARD_HAS_REPOSITORY_FIELD == false;
  assert QUEEN_BOARD_WORLD_PARAMETER_IS_IGNORED == true;
  assert QUEEN_BOARD_IS_MULTI_REPO_AT_OBSERVED_AT == false;
  assert queen_board_is_multi_repo(QUEEN_BOARD_PAYLOAD_REPO_COUNT, QUEEN_BOARD_CARD_HAS_REPOSITORY_FIELD, QUEEN_BOARD_WORLD_PARAMETER_IS_IGNORED) == QUEEN_BOARD_IS_MULTI_REPO_AT_OBSERVED_AT;
  assert queen_board_answers_but_is_single_repo(QUEEN_BOARD_SERVED_A_PAYLOAD, QUEEN_BOARD_IS_MULTI_REPO_AT_OBSERVED_AT) == true;
  assert queen_publish_proved(QUEEN_BOARD_SUPPORTS_MULTIPLE_REPOSITORIES, QUEEN_BOARD_PAYLOAD_HAS_THIS_WORLD, QUEEN_BOARD_PAYLOAD_HAS_THIS_ISSUE, QUEEN_DEPLOYED_ROUTE_RESOLVES_THIS_ISSUE) == false;
  assert THIS_FILE_CLAIMS_QUEEN_IS_LIVE == false;
}

test every_missing_multi_repo_signal_is_named_one_by_one {
  assert queen_board_is_multi_repo(2, false, true) == true;
  assert queen_board_is_multi_repo(1, true, true) == true;
  assert queen_board_is_multi_repo(1, false, false) == true;
  assert queen_board_is_multi_repo(1, false, true) == false;
  assert queen_board_answers_but_is_single_repo(true, true) == false;
  assert queen_board_answers_but_is_single_repo(false, false) == false;
  assert queen_board_answers_but_is_single_repo(true, false) == true;
}

test a_host_level_recheck_neither_refutes_the_payload_nor_restores_the_404 {
  assert QUEEN_BOARD_RECHECK_HTTP_STATUS == HTTP_BAD_GATEWAY;
  assert QUEEN_BOARD_RECHECK_ATTEMPTS == 3;
  assert QUEEN_BOARD_RECHECK_HTTP_STATUS == ABSENT_PATH_RECHECK_HTTP_STATUS;
  assert QUEEN_BOARD_RECHECK_BODY_BYTES == ABSENT_PATH_RECHECK_BODY_BYTES;
  assert QUEEN_BOARD_RECHECK_IS_HOST_LEVEL == true;
  assert QUEEN_BOARD_AVAILABILITY_IS_INTERMITTENT == true;
  assert QUEEN_BOARD_RECHECK_HTTP_STATUS != QUEEN_BOARD_HTTP_STATUS_WHEN_THIS_FILE_WAS_WRITTEN;
  assert recheck_refutes_payload_observation(QUEEN_BOARD_RECHECK_HTTP_STATUS, QUEEN_BOARD_RECHECK_IS_HOST_LEVEL) == false;
  assert recheck_refutes_payload_observation(HTTP_NOT_FOUND, false) == true;
  assert recheck_refutes_payload_observation(HTTP_OK, false) == false;
  assert queen_board_route_is_witnessed(QUEEN_BOARD_SERVED_A_PAYLOAD, false) == true;
  assert queen_board_route_is_witnessed(QUEEN_BOARD_SERVED_A_PAYLOAD, true) == false;
  assert queen_board_route_is_witnessed(false, false) == false;
}

test the_world_view_card_is_a_catalog_snapshot_and_not_the_board {
  assert WORLD_VIEW_CARD_IS_RENDERED == true;
  assert WORLD_VIEW_CARD_SPEC_COUNT == MANIFEST_SPEC_COUNT;
  assert WORLD_VIEW_CARD_OPEN_ISSUE_COUNT == 33;
  assert WORLD_VIEW_PAGE_LABEL == "Observed: 9/15/2026, 10:25:38 PM - not live";
  assert WORLD_VIEW_CARD_IS_LABELLED_LIVE == false;
  assert WORLD_VIEW_CARD_IS_CATALOG_SNAPSHOT == true;
  assert world_view_card_is_board_publication(WORLD_VIEW_CARD_IS_RENDERED, WORLD_VIEW_CARD_IS_LABELLED_LIVE) == false;
  assert world_view_card_is_board_publication(true, true) == true;
  assert world_view_card_is_board_publication(false, true) == false;
}

test the_multi_repo_gate_is_upstream_and_still_open {
  assert QUEEN_MULTI_REPO_EPIC == "gHashTag/tri-27#3";
  assert QUEEN_MULTI_REPO_EPIC_IS_OPEN == true;
  assert QUEEN_MULTI_REPO_EPIC_OBSERVED_AT == "2026-09-13";
  assert QUEEN_CHANGE_IS_OWNED_BY_THIS_REPOSITORY == false;
  assert queen_block_is_external(QUEEN_BOARD_SUPPORTS_MULTIPLE_REPOSITORIES, QUEEN_CHANGE_IS_OWNED_BY_THIS_REPOSITORY) == true;
}

test the_agent_surface_was_not_measured_by_this_sweep {
  assert AGENT_CARD_IS_IN_MANIFEST_SPEC_LIST == true;
  assert AGENT_ROUTE_RESOLUTION_IS_NOT_MEASURED == true;
  assert CURRENT_UPSTREAM_ACCEPTS_NAMESPACED_AGENT_CARD == false;
  assert THIS_FILE_CLAIMS_AGENT_CARD_IS_LIVE == false;
  assert agent_card_publish_proved(true, false, false) == false;
}

; --- Invariants --------------------------------------------------------------------------------

invariant formal_forks_remain_ineligible_for_this_scan
  assert WORLD_SCAN_SKIPS_FORMAL_FORKS == true and world_scan_eligible(true, true, true, 1, 4096, 1) == false

invariant scanner_eligibility_requires_an_early_bounded_probe_witness
  assert scanner_probe_witness_valid(PROBE_FILES, MAX_FILE_BYTES, 1) == true and scanner_probe_witness_valid(PROBE_FILES + 1, MAX_FILE_BYTES, 1) == false and scanner_probe_witness_valid(PROBE_FILES, MAX_FILE_BYTES + 1, 1) == false

invariant canonical_discovery_requires_a_tracked_nonempty_source
  assert canonical_source_discoverable(true, true, 1) == true and canonical_source_discoverable(true, false, 1) == false and canonical_source_discoverable(true, true, 0) == false

invariant compiler_evidence_cannot_pass_with_an_empty_ast
  assert parse_evidence_valid(true, 0) == false

invariant compiler_evidence_cannot_pass_with_a_reported_error_or_warning
  assert typecheck_evidence_valid(true, 1, 0) == false and typecheck_evidence_valid(true, 0, 1) == false

invariant every_required_generator_must_emit_nonempty_output
  assert five_generators_emitted(true, true, true, true, true) == true and five_generators_emitted(true, true, true, true, false) == false

invariant a_manifest_entry_alone_is_not_spec_browser_publication
  assert spec_browser_publish_proved(true, true, false) == false

; The dated witness may not be refreshed in place. A worker who re-measures the corpus writes the
; new number beside the old one, because overwriting 12 with 43 would silently convert a 2026-09-20
; observation into a claim about a scan that never happened.
invariant the_dated_tracked_count_is_never_overwritten_by_a_later_measurement
  assert TRACKED_SPEC_COUNT_AT_OBSERVED_AT == MANIFEST_SPEC_COUNT and TRACKED_SPEC_COUNT_REMEASURED > TRACKED_SPEC_COUNT_AT_OBSERVED_AT and spec_count_gap_is_scan_lag(TRACKED_SPEC_COUNT_REMEASURED, MANIFEST_SPEC_COUNT) == true

invariant a_tracked_agent_card_alone_is_not_public_agent_proof
  assert agent_card_publish_proved(true, false, false) == false

invariant queen_cannot_be_claimed_from_this_repository_alone
  assert queen_block_is_external(QUEEN_BOARD_SUPPORTS_MULTIPLE_REPOSITORIES, QUEEN_CHANGE_IS_OWNED_BY_THIS_REPOSITORY) == true and THIS_FILE_CLAIMS_QUEEN_IS_LIVE == false

; Was: all three claims pinned to false. The spec browser leg is now pinned to its witnesses
; instead, which is the same rule and not a weaker one -- a claim is allowed exactly as far as the
; evidence that produced it, and the other two surfaces have no such evidence.
invariant no_public_surface_is_claimed_live_without_external_evidence
  assert THIS_FILE_CLAIMS_SPEC_BROWSER_IS_LIVE == spec_browser_publish_proved(MANIFEST_HAS_THIS_WORLD, MANIFEST_HAS_THIS_MODULE_CATEGORY, DEPLOYED_ROUTE_RESOLVES_THIS_MODULE) and THIS_FILE_CLAIMS_AGENT_CARD_IS_LIVE == false and THIS_FILE_CLAIMS_QUEEN_IS_LIVE == false

invariant the_spec_browser_claim_never_outlives_the_witnesses_that_produced_it
  assert THIS_FILE_CLAIMS_SPEC_BROWSER_IS_LIVE == spec_browser_live_claim_follows(MANIFEST_HAS_THIS_WORLD, MANIFEST_HAS_THIS_MODULE_CATEGORY, DEPLOYED_ROUTE_RESOLVES_THIS_MODULE, PUBLISHED_COMMIT_IS_IN_LOCAL_HISTORY)

invariant an_answering_board_is_still_not_publication_of_this_world
  assert queen_board_answered(QUEEN_BOARD_HTTP_STATUS) == true and queen_board_is_multi_repo(QUEEN_BOARD_PAYLOAD_REPO_COUNT, QUEEN_BOARD_CARD_HAS_REPOSITORY_FIELD, QUEEN_BOARD_WORLD_PARAMETER_IS_IGNORED) == false and THIS_FILE_CLAIMS_QUEEN_IS_LIVE == false

invariant a_host_level_status_is_never_read_as_a_verdict_about_one_route
  assert recheck_refutes_payload_observation(QUEEN_BOARD_RECHECK_HTTP_STATUS, QUEEN_BOARD_RECHECK_IS_HOST_LEVEL) == false and QUEEN_BOARD_RECHECK_HTTP_STATUS == ABSENT_PATH_RECHECK_HTTP_STATUS

invariant a_rendered_world_card_labelled_not_live_is_not_the_board
  assert world_view_card_is_board_publication(WORLD_VIEW_CARD_IS_RENDERED, WORLD_VIEW_CARD_IS_LABELLED_LIVE) == false and WORLD_VIEW_CARD_IS_CATALOG_SNAPSHOT == true

invariant the_unmeasured_agent_surface_is_refused_rather_than_guessed
  assert AGENT_ROUTE_RESOLUTION_IS_NOT_MEASURED == true and AGENT_CARD_IS_IN_MANIFEST_SPEC_LIST == true and THIS_FILE_CLAIMS_AGENT_CARD_IS_LIVE == false
