pub const MANIFEST_HAS_THIS_MODULE_CATEGORY : bool = true;
pub const DEPLOYED_ROUTE_RESOLVES_THIS_MODULE : bool = true;

pub fn manifest_witness_valid(status: u16, bytes: u32, spec_count: u8) bool {
  return status == HTTP_OK and bytes > 0 and spec_count >= 1;
}

pub fn deployed_route_witness_valid(status: u16, resolved_module_count: u8) bool {
  return status == HTTP_OK and resolved_module_count >= 1;
}

; The claim, spelled as what produced it: the three published legs plus the local check that the
; published commit is ours.
pub fn spec_browser_live_claim_follows(manifest_has_world: bool, manifest_has_module: bool, deployed_route_resolves_module: bool, published_commit_in_local_history: bool) bool {
  return spec_browser_publish_proved(manifest_has_world, manifest_has_module, deployed_route_resolves_module) and published_commit_in_local_history;
}

