test every_month_length_and_both_century_rules {
  assert divides(2000, LEAP_CYCLE_LONG) == true;
  assert divides(1900, LEAP_CYCLE_LONG) == false;
  assert divides(1900, LEAP_CYCLE_CENTURY) == true;
  assert is_leap_year(2026) == false;
  assert is_leap_year(2028) == true;
  assert is_leap_year(1900) == false;
  assert is_leap_year(2000) == true;
  assert days_in_month(2026, 1) == 31;
  assert days_in_month(2026, 2) == 28;
  assert days_in_month(2028, 2) == 29;
  assert days_in_month(2026, 4) == 30;
  assert days_in_month(2026, 6) == 30;
  assert days_in_month(2026, 9) == 30;
  assert days_in_month(2026, 11) == 30;
  assert days_in_month(2026, 12) == 31;
}

test shifting_months_crosses_a_year_without_skipping_one {
  assert month_of_index(shift_month_index(2026, 8, 1)) == 9;
  assert year_of_index(shift_month_index(2026, 8, 1)) == 2026;
  assert month_of_index(shift_month_index(2026, 12, 1)) == 1;
  assert year_of_index(shift_month_index(2026, 12, 1)) == 2027;
  assert month_of_index(shift_month_index(2026, 12, 13)) == 1;
  assert year_of_index(shift_month_index(2026, 12, 13)) == 2028;
  assert SHIFT_MONTH_LANDS_ON_DAY == 1;
  assert SHIFT_MONTH_PRESERVES_THE_DAY == false;
}

test a_month_shift_round_trips {
  assert unshift_month_index(shift_month_index(2026, 8, 13), 13) == month_index(2026, 8);
  assert month_of_index(unshift_month_index(shift_month_index(2026, 8, 13), 13)) == 8;
  assert year_of_index(unshift_month_index(shift_month_index(2026, 8, 13), 13)) == 2026;
  assert month_of_index(unshift_month_index(month_index(2026, 1), 1)) == 12;
  assert year_of_index(unshift_month_index(month_index(2026, 1), 1)) == 2025;
}

test the_current_month_starts_at_today_and_every_other_month_at_the_first {
  assert visible_day_count(31, true, 10) == 22;
  assert visible_day_count(30, false, 10) == 30;
  assert visible_day_count(31, false, 1) == 31;
  assert is_current_month(2026, 8, 2026, 8) == true;
  assert is_current_month(2027, 8, 2026, 8) == false;
  assert visible_day_count(31, is_current_month(2027, 8, 2026, 8), 10) == 31;
}

test the_last_day_of_a_month_leaves_exactly_today {
  assert visible_day_count(31, true, 31) == 1;
  assert visible_day_count(28, true, 28) == 1;
  assert month_end_leaves_at_least_today(31, 31) == true;
  assert month_end_leaves_at_least_today(28, 28) == true;
  assert month_end_leaves_at_least_today(31, 1) == true;
}

