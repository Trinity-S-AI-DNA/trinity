  assert CUSTOMER_BOOKINGS_SCREEN_IS_MOUNTED == false;
  assert CUSTOMER_BOOKINGS_SCREEN_IS_MOUNTED_BEFORE_2026_09_24 == true;
  // kept until 2026-09-26, reversed that day for hidden events (next test)
  assert REMINDER_KEPT_FOR_SEATS_ALREADY_HELD_BEFORE_2026_09_26 == true;
  assert REMINDER_KEPT_FOR_SEATS_ALREADY_HELD == false;
}

test a_hidden_event_is_never_reminded_and_a_held_seat_keeps_its_refund {
  assert REMINDER_REVERSED_AT == "2026-09-26";
  assert REMINDER_REVERSED_BY != "";
  assert REMINDER_REVERSAL_READS != "";
  assert REMINDER_FILTERS_THE_FLAG == true;
  assert REMINDER_FLAG_FILTERED_JOINS == 1;
  assert reminder_is_sent(false) == false;
  assert reminder_is_sent(true) == true;
  // every event is hidden since 088 and the admin API can make none public, so none is reminded
  assert EVENTS_PUBLISHABLE == false;
  assert reminder_is_sent(a_public_row_survives(true, true, false, EVENTS_PUBLISHABLE)) == false;
  assert reminder_is_sent(new_event_is_stored_public(true, true, EVENTS_PUBLISHABLE)) == false;
  // flipped back, a public event is reminded again
  assert reminder_is_sent(new_event_is_stored_public(true, true, EVENTS_PUBLISHABLE_BEFORE_2026_09_24)) == true;
  assert REMINDER_REVERSAL_TOUCHES_A_REFUND == false;
  assert KEPT_CUSTOMER_EVENT_HTTP_PATHS == 2;
  assert REMINDER_REVERSAL_WRITES_A_ROW == false;
  // the reversal changed the reminder in place and added a test below every cited line
  assert HTTP_SOURCE_LINES_BEFORE_2026_09_26 == 2545;
  assert HTTP_SOURCE_LINES > HTTP_SOURCE_LINES_BEFORE_2026_09_26;
}

