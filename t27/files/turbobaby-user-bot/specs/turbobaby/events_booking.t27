; --- Invariants ---------------------------------------------------------------------------------

invariant the_seat_that_fills_the_room_is_sold_and_not_refused
  assert booking_fits(true, 10, 9, 1) == true and booking_fits(true, 1, 0, 1) == true

invariant a_full_room_refuses_the_next_seat
  assert booking_fits(true, 10, 10, 1) == false and booking_fits(true, 1, 1, 1) == false

invariant booking_and_the_waitlist_are_never_open_at_once
  assert exactly_one_door_is_open(1, 0) == true and exactly_one_door_is_open(1, 1) == true and exactly_one_door_is_open(10, 9) == true and exactly_one_door_is_open(10, 10) == true

invariant an_undeclared_capacity_opens_no_waitlist_and_closes_no_door
  assert booking_fits(false, 0, 99999, 1) == true and waitlist_open(false, 0, 99999) == false

invariant a_zero_capacity_event_leaves_the_customer_nowhere_to_go
  assert booking_fits(true, 0, 0, 1) == false and waitlist_open(true, 0, 0) == false

invariant the_api_never_publishes_a_negative_seat_count
  assert seats_available(true, 10, 12) == 0 and seats_available(true, 10, 10) == 0

invariant the_api_and_the_screen_clamp_the_seat_count_the_same_way
  assert API_CLAMPS_SEATS_AT_ZERO == SCREEN_CLAMPS_SEATS_AT_ZERO and SEATS_FREE_IMPLEMENTATION_COUNT == 1

invariant a_waitlisted_row_never_counts_as_a_seat
  assert state_occupies_a_seat(BOOKING_STATE_WAITLISTED) == false and state_occupies_a_seat(BOOKING_STATE_CANCELLED) == false

invariant an_unwritten_state_slot_is_never_a_known_state
  assert booking_state_is_known(BOOKING_STATE_UNSET) == false and booking_state_code_of("") == BOOKING_STATE_UNSET

invariant a_started_event_admits_nobody
  assert booking_door_open(true, true, true, 10, 0) == false

invariant the_two_duplicate_guards_do_not_agree
  assert duplicate_guard_sees(BOOKING_STATE_WAITLISTED, true) != duplicate_guard_sees(BOOKING_STATE_WAITLISTED, false)

invariant promotion_cannot_run_without_a_cancel
  assert promotion_runs(false, true, 10, 0, true) == false

invariant cancelling_a_waitlisted_row_frees_no_seat_and_promotes_nobody
  assert promotion_runs(true, true, 10, 10, true) == false

invariant at_most_one_person_is_promoted_per_cancellation
  assert PROMOTIONS_PER_CANCEL_MAX == 1 and CANDIDATES_READ_PER_CANCEL >= PROMOTIONS_PER_CANCEL_MAX

invariant a_head_who_cannot_pay_no_longer_decides_for_the_line
  assert seat_reaches(500, 0, 900) == 2 and PROMOTION_SKIPS_TO_THE_NEXT_PAYER == true

invariant a_line_where_nobody_can_pay_leaves_the_seat_empty_and_says_so
  assert seat_stays_empty_after_cancel(true, 500, 499) == true and PROMOTION_EXHAUSTED_SCAN_IS_LOGGED == true

invariant a_second_cancel_refunds_nothing
  assert cancel_has_effect(BOOKING_STATE_CANCELLED) == false and refund_amount(false, 300) == 0

invariant deleting_an_event_returns_no_money
  assert money_returns_on(false, 300) == 0 and DELETE_REFUNDS == false

; Renamed 2026-09-21 with the escape hatch: this read a_delete_never_destroys_a_paid_booking, which
; the door makes false as a sentence. What survives the door, and is the half worth an invariant,
; is that nothing destroys a paid booking NOBODY NAMED.
invariant a_delete_never_destroys_a_paid_booking_nobody_named
  assert delete_is_admitted(1) == false and delete_is_admitted_with_ack(3, 1, true) == false and DELETE_DESTROYS_PAID_BOOKINGS_UNASKED == false

invariant the_hatch_opens_only_on_the_servers_own_count
  assert delete_is_admitted_with_ack(3, 3, true) == true and delete_is_admitted_with_ack(3, 0, true) == false and DELETE_HATCH_REFUNDS == false

invariant no_attendee_reachout_on_this_surface_is_a_queue_row
  assert ATTENDEE_REACHOUT_IS_A_QUEUE_ROW == false and QUEUE_ENQUEUE_SITES_FOR_EVENTS == 0

invariant the_queue_budget_here_is_a_marked_copy_of_its_owners_number
  assert QUEUE_MAX_ATTEMPTS_IS_A_COPY == true and QUEUE_MAX_ATTEMPTS_OWNER == REUSES_NOTIFICATION_QUEUE_ID and QUEUE_MAX_ATTEMPTS > DIRECT_SEND_ATTEMPTS_PER_SWEEP

invariant a_reminder_never_reaches_someone_who_holds_no_seat
  assert reminder_is_due(BOOKING_STATE_WAITLISTED, false, false, 1, REMINDER_WINDOW_HOURS) == false and reminder_is_due(BOOKING_STATE_CANCELLED, false, false, 1, REMINDER_WINDOW_HOURS) == false

invariant a_delivered_reminder_is_never_sent_twice
  assert reminder_is_due(BOOKING_STATE_CONFIRMED, true, false, 1, REMINDER_WINDOW_HOURS) == false and reminder_retried_next_sweep(true, false) == false

invariant the_calendar_day_is_the_market_day_and_the_utc_day_can_differ
  assert events_share_a_day(25, 8, 24, 18, 7) == true and utc_day_comparison_agrees(25, 8, 24, 18, 7) == false

invariant february_matches_the_derivation_in_every_century_case
  assert days_in_month(2026, 2) == 28 and days_in_month(2028, 2) == 29 and days_in_month(1900, 2) == 28 and days_in_month(2000, 2) == 29

invariant a_month_shift_skips_no_month_at_a_long_month_end
  assert month_of_index(shift_month_index(2026, 1, 1)) == 2 and SHIFT_MONTH_PRESERVES_THE_DAY == false

invariant a_month_shift_round_trips_to_the_same_month
  assert unshift_month_index(shift_month_index(2026, 8, 13), 13) == month_index(2026, 8)

invariant the_strip_never_empties_at_a_month_end
  assert visible_day_count(31, true, 31) == 1 and visible_day_count(28, true, 28) == 1

invariant the_same_month_number_in_another_year_is_not_the_current_month
  assert is_current_month(2027, 8, 2026, 8) == false and visible_day_count(31, is_current_month(2027, 8, 2026, 8), 10) == 31

invariant an_empty_day_carries_no_marker
  assert day_mark(0) == DAY_MARK_EMPTY

invariant hiding_rows_retired_neither_a_route_nor_a_screen
  assert hide_retired_the_surface(true, false, false) == false and EVENT_ROUTES_RETIRED_BY_THE_HIDE == 0

invariant a_new_event_is_public_by_default
  assert new_event_is_public(false, false) == true

invariant the_handle_lower_bound_is_declared_and_not_enforced
  assert handle_bounds_agree(HANDLE_MIN_DECLARED, HANDLE_MIN_ENFORCED) == false and handle_is_accepted(3) == true

invariant no_capacity_is_invented_for_an_event_type_the_tree_does_not_define
  assert EVENT_TYPE_COUNT == 0 and DEFAULT_CAPACITY_PUBLISHED == false

invariant every_refusal_stays_a_refusal
  assert WAITLIST_POSITION_PUBLISHED == false and PROMOTION_NOTICE_PUBLISHED == false and PROMOTION_OFFER_TTL_PUBLISHED == false and WAITLIST_LENGTH_CAP_PUBLISHED == false

invariant no_edge_of_this_contract_is_carried_by_a_line_number
  assert SIBLING_LINE_CITATIONS_IN_THIS_FILE == 0 and edge_is_durable(true, false) == true and edge_is_durable(true, true) == false

invariant the_wave_that_wrote_this_file_is_never_undercounted_again
  assert OWN_WAVE_NEW_CONTRACTS == 13 and OWN_WAVE_NEW_CONTRACTS > PRIOR_WAVE_NEW_CONTRACTS and STALENESS_INTERVAL_IS_PUBLISHED == false

invariant a_number_that_moves_while_it_is_read_is_never_pinned_as_a_constant
  assert CORPUS_RESIDUE_IS_PINNED_HERE == false and CORPUS_RESIDUE_NOTE != "" and SIBLING_LINE_CITATIONS_IN_THIS_FILE == 0

invariant this_contract_names_no_person
  assert CARRIES_AN_ATTENDEE == false and CARRIES_A_PHONE == false and CARRIES_AN_EVENT_FIXTURE == false

invariant no_event_is_stored_public_while_events_are_retired_by_the_owner
  assert new_event_is_stored_public(false, false, EVENTS_PUBLISHABLE) == false and new_event_is_stored_public(true, true, EVENTS_PUBLISHABLE) == false and edit_stores_public(true, true, EVENTS_PUBLISHABLE, false) == false

invariant no_client_path_mounts_an_events_screen_and_every_path_stays_declared
  assert EVENT_SCREENS_MOUNTED_BY_THE_CLIENT_ROUTER == 0 and SCREEN_ROUTES.len == SCREEN_ROUTE_COUNT and SCREEN_ROUTE_COUNT == 3

invariant no_public_event_row_survives_a_deployed_088
  assert a_public_row_survives(true, true, false, EVENTS_PUBLISHABLE) == false and a_public_row_survives(false, true, true, EVENTS_PUBLISHABLE) == false and RULING_HIDE_ROW_DELETES == 0 and RULING_HIDE_TABLE_DROPS == 0

invariant a_hidden_event_is_never_reminded
  assert reminder_is_sent(false) == false and REMINDER_FILTERS_THE_FLAG == true and REMINDER_REVERSAL_WRITES_A_ROW == false and REMINDER_REVERSAL_TOUCHES_A_REFUND == false
