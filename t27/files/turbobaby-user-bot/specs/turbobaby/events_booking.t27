  assert reminder_is_due(BOOKING_STATE_CONFIRMED, true, false, 10, REMINDER_WINDOW_HOURS) == false;
  assert reminder_is_due(BOOKING_STATE_WAITLISTED, false, false, 10, REMINDER_WINDOW_HOURS) == false;
  assert reminder_is_due(BOOKING_STATE_CANCELLED, false, false, 10, REMINDER_WINDOW_HOURS) == false;
  assert reminder_is_due(BOOKING_STATE_CONFIRMED, false, true, 0, REMINDER_WINDOW_HOURS) == false;
  assert reminder_is_due(BOOKING_STATE_CONFIRMED, false, false, 25, REMINDER_WINDOW_HOURS) == false;
  assert reminder_is_due(BOOKING_STATE_CONFIRMED, false, false, 24, REMINDER_WINDOW_HOURS) == true;
}

