test the_handle_check_enforces_one_of_its_two_declared_bounds {
  assert handle_is_accepted(3) == true;
  assert handle_is_accepted(5) == true;
  assert handle_is_accepted(32) == true;
  assert handle_is_accepted(33) == false;
  assert handle_is_accepted(0) == false;
  assert handle_bounds_agree(HANDLE_MIN_DECLARED, HANDLE_MIN_ENFORCED) == false;
  assert handle_bounds_agree(HANDLE_MAX_DECLARED, HANDLE_MAX_ENFORCED) == true;
}

; Added 2026-09-22 with the three constants that moved here from turbobaby/person-naming.
test the_checks_own_tests_never_offer_a_length_in_the_gap {
  assert length_is_in_the_handle_gap(3) == true;
  assert length_is_in_the_handle_gap(HANDLE_MIN_ENFORCED) == true;
  assert length_is_in_the_handle_gap(HANDLE_MIN_DECLARED) == false;
  assert length_is_in_the_handle_gap(0) == false;
  assert length_is_in_the_handle_gap(33) == false;
  assert HANDLE_GAP_EXAMPLES_IN_TESTS == 0;
  assert HANDLE_OVER_MAX_EXAMPLES_IN_TESTS == 1;
  assert ATTENDEE_SOURCE_TESTS == 16;
}

; Added 2026-09-22. The source-side reason HANDLE_MIN_ENFORCED is the emptiness check and nothing
; more, under its own name, so that a floor fixed in place has a bound fact to trip: the module
; compares a length once, and that once is the upper bound. A fix that raises the count flips
; HANDLE_MIN_ENFORCED with it, and the invariant the_handle_lower_bound_is_declared_and_not_enforced
; after both.
test the_attendee_module_compares_a_length_once_and_from_above {
  assert ATTENDEE_SOURCE_LENGTH_COMPARISONS == 1;
  assert handle_bounds_agree(HANDLE_MAX_DECLARED, HANDLE_MAX_ENFORCED) == true;
  assert HANDLE_MIN_ENFORCED == 1;
  assert handle_is_accepted(HANDLE_MIN_ENFORCED) == true;
  assert handle_is_accepted(0) == false;
}

