test no_event_is_stored_public_while_events_are_retired {
  assert EVENTS_PUBLISHABLE == false;
  assert EVENTS_PUBLISHABLE_BEFORE_2026_09_24 == true;
  assert new_event_is_stored_public(false, false, EVENTS_PUBLISHABLE) == false;
  assert new_event_is_stored_public(true, true, EVENTS_PUBLISHABLE) == false;
  assert new_event_is_stored_public(true, false, EVENTS_PUBLISHABLE) == false;
  // Flipped back, the old behaviour returns exactly.
  assert new_event_is_stored_public(false, false, EVENTS_PUBLISHABLE_BEFORE_2026_09_24) == true;
  assert new_event_is_stored_public(true, false, EVENTS_PUBLISHABLE_BEFORE_2026_09_24) == false;
  assert edit_stores_public(true, true, EVENTS_PUBLISHABLE, false) == false;
  assert edit_stores_public(true, true, EVENTS_PUBLISHABLE, true) == false;
  assert edit_stores_public(true, true, EVENTS_PUBLISHABLE_BEFORE_2026_09_24, false) == true;
  // An edit that does not name the flag leaves the stored one: the edit does not reach a row 085
  // missed. 088 does, below.
  assert edit_stores_public(false, false, EVENTS_PUBLISHABLE, true) == true;
}

test a_row_made_public_after_085_does_not_survive_088 {
  assert RULING_HIDE_MIGRATION == "migrations/088_unpublish_events.sql";
  assert RULING_HIDE_MIGRATION != HIDE_MIGRATION;
  assert RULING_HIDE_VISIBILITY_UPDATES_ON_EVENTS == HIDE_VISIBILITY_UPDATES_ON_EVENTS;
  assert RULING_HIDE_ROW_DELETES == 0;
  assert RULING_HIDE_TABLE_DROPS == 0;
  assert RULING_HIDE_READ_PRODUCTION_FIRST == false;
  // Undeployed, such a row is still served; deployed, it is not, whichever way it was made.
  assert a_public_row_survives(true, false, false, EVENTS_PUBLISHABLE) == true;
  assert a_public_row_survives(true, true, false, EVENTS_PUBLISHABLE) == false;
  assert a_public_row_survives(false, true, true, EVENTS_PUBLISHABLE) == false;
  assert a_public_row_survives(false, true, false, EVENTS_PUBLISHABLE) == false;
  // An edit that leaves the flag alone after 088 leaves it hidden.
  assert edit_stores_public(false, false, EVENTS_PUBLISHABLE, a_public_row_survives(true, true, false, EVENTS_PUBLISHABLE)) == false;
  // Flipped back, the admin API publishes again, and 088 is no obstacle to that.
  assert a_public_row_survives(false, true, true, EVENTS_PUBLISHABLE_BEFORE_2026_09_24) == true;
  // Hiding is still not retiring: the router is merged.
  assert hide_retired_the_surface(true, false, true) == false;
}

test the_screens_left_on_the_ruling_and_the_router_did_not {
  assert hide_retired_the_surface(true, false, true) == false;
  assert EVENT_HTTP_ROUTER_STILL_MERGED == true;
