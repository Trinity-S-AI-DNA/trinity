; The counts and the corpus they were taken over. One claim FELL and the mechanism that was built
; to catch it caught it: SECOND_PUBLISHED_AREA_PRICE_SOURCES_FOUND is now 2, so the function that
; decides whether an absence still holds answers FALSE for it, without one word of the prose being
; edited to hide the change. The superseded count is asserted beside the new one, the claim total
; drops from three to two, and the two survivors are asserted as survivors of a wider search than
; the one they started with -- the brain was read and answers zero for both.
test the_absence_claims_were_remeasured_and_one_of_them_fell {
    assert ABSENCE_CLAIMS_REMEASURED_AT == "2026-09-21";
    assert TRACKED_SPECS_WHEN_FIRST_MEASURED == 12;
    assert TRACKED_SPECS_AT_REMEASURE == 43;
    assert TRACKED_SPECS_AT_REMEASURE > TRACKED_SPECS_WHEN_FIRST_MEASURED;
    assert SUPERSEDED_ABSENCE_CLAIM_COUNT == 3;
    assert ABSENCE_CLAIM_COUNT == 2;
    assert ABSENCE_CLAIMS_ANSWERED_BY_THE_BRAIN == 1;
    assert ABSENCE_CLAIM_COUNT + ABSENCE_CLAIMS_ANSWERED_BY_THE_BRAIN == SUPERSEDED_ABSENCE_CLAIM_COUNT;
    assert SECOND_PUBLISHED_AREA_PRICE_SOURCES_FOUND == 2;
    assert SECOND_PUBLISHED_AREA_PRICE_SOURCES_FOUND == BRAIN_LADDER_SOURCE_COUNT;
    assert SUPERSEDED_SECOND_AREA_PRICE_SOURCES_FOUND == 0;
    assert absence_claim_still_holds(SECOND_PUBLISHED_AREA_PRICE_SOURCES_FOUND) == false;
    assert absence_claim_still_holds(SUPERSEDED_SECOND_AREA_PRICE_SOURCES_FOUND) == true;
    assert CLOSING_TIME_SOURCES_FOUND == 0;
    assert COVERAGE_ISLAND_ETA_SOURCES_FOUND == 0;
    assert BRAIN_ETA_SOURCES_FOUND == 0;
    assert BRAIN_OFFICE_CLOSING_HOUR_SOURCES_FOUND == 0;
    assert absence_claim_still_holds(CLOSING_TIME_SOURCES_FOUND) == true;
    assert absence_claim_still_holds(COVERAGE_ISLAND_ETA_SOURCES_FOUND) == true;
    assert absence_claim_still_holds(BRAIN_ETA_SOURCES_FOUND) == true;
    assert absence_claim_still_holds(BRAIN_OFFICE_CLOSING_HOUR_SOURCES_FOUND) == true;
    assert ABSENCE_CLAIMS_SURVIVED_THE_REMEASURE == true;
    assert ABSENCE_CLAIMS_REMEASURED_AT != MEASURED_AT;
    assert absence_claim_still_holds(1) == false;
}

; The consumer edge, re-verified by NAME on 2026-09-21 after its line citation was removed from the
; header. The owner and the declaration are both literals here, so the edge cannot decay into a
; comment the way a line number does.
test the_consumer_edge_names_an_owner_and_a_declaration_and_not_a_line {
    assert REUSES_COMMERCE_ID == "turbobaby/commerce";
    assert CONSUMER_FUNCTION == "commerce_fulfillment_valid";
    assert PRODUCES == "delivery_destination_ready";
    assert REUSES_COMMERCE_ID != ID;
    assert CONSUMER_FUNCTION != PRODUCES;
}

test this_contract_charges_nothing_and_totals_nothing {
    assert THIS_FILE_ADDS_NO_FEE_TO_ANY_TOTAL == true;
    assert FEE_ENTERS_NO_SHIPPED_TOTAL == true;
    assert KIND == "contract";
    assert ID == "turbobaby/delivery-terms";
    assert SOURCE == "data/fleet_seed.json";
    assert SOURCE_MEASURED_AT == "2026-09-12";
    assert MEASURED_AT == "2026-09-20";
}

; ==================================================================================================
; Invariants
; ==================================================================================================

; THE LADDER'S SHAPE. Until 2026-09-21 this invariant read "exactly one delivery fee is published"
; and pinned an array of one, because one row was all this file had found. The length is now a
; MEASUREMENT -- the extent of the published ladder -- and what the invariant pins is that the three
; parallel tables cannot drift apart and that the recount agrees with the declared histogram. A row
; added to the names without a fee, or a fee moved between steps, fails here.
invariant the_ladder_tables_stay_parallel_and_the_recount_agrees
    assert LADDER_DISTRICT_NAMES.len == LADDER_DISTRICT_COUNT and LADDER_DISTRICT_FEE_THB.len == LADDER_DISTRICT_COUNT and LADDER_DISTRICT_FACT_KIND.len == LADDER_DISTRICT_COUNT and LADDER_FLOW_MENTIONS.len == LADDER_DISTRICT_COUNT and districts_at_step(290) + districts_at_step(390) + districts_at_step(490) + districts_at_step(590) + districts_at_step(990) == LADDER_DISTRICT_COUNT

; The seed's one row is still one row, and it is the ladder's first rung rather than a separate
; claim. This is the cross-source agreement stated as an assert: the name and the figure the
; repository ships are the name and the figure the shop publishes at the 290 step.
invariant the_seed_row_is_the_first_rung_and_still_the_only_one_in_this_repository
    assert DOCUMENTED_AREA_DELIVERY_FEE_THB.len == 1 and DOCUMENTED_AREA_NAMES.len == DOCUMENTED_AREA_DELIVERY_FEE_THB.len and DOCUMENTED_AREA_COUNT == 1 and LADDER_DISTRICT_NAMES[0] == DOCUMENTED_AREA_NAMES[0] and LADDER_DISTRICT_FEE_THB[0] == DOCUMENTED_DELIVERY_FEE_THB and LADDER_DISTRICT_COUNT > DOCUMENTED_AREA_COUNT

; The interpolation ban, mechanically, and it is the part of the old prohibition that SURVIVES: a
; district in neither table is absent, not a fraction of 290, not the nearest step and not a
; neighbour's price. There is no function in this file from an unlisted district to a number.
; RENAMED 2026-09-24 from no_district_off_the_ladder_ever_acquires_a_fee: six districts off the
; ladder acquired fees that day, by the owner's word in the zone table, and none by derivation.
invariant no_district_acquires_a_fee_by_derivation
    assert area_fee_thb(LADDER_DISTRICT_COUNT) == FEE_ABSENT and area_fee_thb(LADDER_DISTRICT_COUNT + 1) == FEE_ABSENT and area_fee_thb(-1) == FEE_ABSENT and zone_fee_thb(PHUKET_ZONE_COUNT) == FEE_ABSENT and zone_fee_thb(-1) == FEE_ABSENT and FEE_MAY_BE_INTERPOLATED == false and A_DISTRICT_IN_NEITHER_TABLE_HAS_NO_FEE == true

; The owner's word and the measurement stay different kinds of fact. Paklok's live figure is not its
; measured one, the superseded figure survives beside it, and Karon -- which the decision explicitly
; did not touch -- is still on the step Paklok left.
invariant the_owners_word_outranks_the_measurement_and_says_where
    assert fee_is_the_owners_word(PAKLOK_LADDER_INDEX) == true and fee_is_the_owners_word(MAIKHAO_LADDER_INDEX) == true and fee_is_the_owners_word(KARON_LADDER_INDEX) == false and area_fee_thb(PAKLOK_LADDER_INDEX) != PAKLOK_SUPERSEDED_FEE_THB and area_fee_thb(KARON_LADDER_INDEX) == PAKLOK_SUPERSEDED_FEE_THB

; A published tariff is not a quote. Flipping either constant is the edit that would put an
; indicative figure in front of a client as that client's price, so it fails here (D11).
invariant a_published_tariff_never_becomes_a_quote
    assert EVERY_PUBLISHED_FEE_IS_INDICATIVE == true and THE_EXACT_FEE_IS_NAMED_BY_A_HUMAN == true and PUBLISHING_A_FEE_IS_NOT_QUOTING_ONE == true and THIS_FILE_PRODUCES_NO_CLIENT_FACING_FEE == true

; The airport range never collapses to a number, and no district is ever placed on 690.
invariant the_airport_range_never_collapses
    assert AIRPORT_HOTEL_FEE_MIN_THB < AIRPORT_HOTEL_FEE_MAX_THB and AIRPORT_HOTEL_FEE_IS_A_RANGE == true and NO_MIDPOINT_IS_DERIVED_FROM_THE_AIRPORT_RANGE == true and districts_at_step(AIRPORT_HOTEL_FEE_MAX_THB) == 0 and AIRPORT_ITSELF_IS_NOT_A_DELIVERY_DESTINATION == true

; The owner's cut-off escalates and never refuses. If a later edit makes the cut-off a ceiling on
; window_start_is_allowed, the second assert stops holding -- which is the rule the owner stated,
; written where a change to it cannot pass quietly.
invariant the_cutoff_hands_over_and_never_refuses
    assert window_start_needs_a_human(DELIVERY_CUTOFF_MIN + 1) == true and window_start_is_allowed(DELIVERY_CUTOFF_MIN + 1, 0) == true and PAST_CUTOFF_IS_ESCALATED_NOT_REFUSED == true and PAST_CUTOFF_IS_NOT_PROMISED_EITHER == true and THE_CUTOFF_IS_NOT_AN_OFFICE_CLOSING_HOUR == true

; D9, on the one leg this file owns. The published zero belongs to the collection leg; a district
; nobody priced is absent, and the two never collapse into each other. Kamala is the row where the
; mistake would be easiest -- a free self-pickup at the base sits beside a 290 delivery -- so the
; assert names it.
invariant an_absent_fee_is_never_the_published_zero
    assert FEE_ABSENT != DOCUMENTED_COLLECTION_FEE_THB and fee_is_absent(DOCUMENTED_COLLECTION_FEE_THB) == false and fee_is_absent(area_fee_thb(LADDER_DISTRICT_COUNT)) == true and area_fee_thb(KAMALA_LADDER_INDEX) != DOCUMENTED_COLLECTION_FEE_THB and districts_at_step(0) == 0

; Off the island there is no delivery at any price and in any window.
invariant no_window_or_agreement_delivers_off_the_island
    assert delivery_destination_ready(false, POINT_DEFAULT, true, true, EARLIEST_WINDOW_START_MIN, DEFAULT_WINDOW_MIN, 0) == false and OFF_ISLAND_MEANS_NO_DELIVERY == true

; The hour a reader would otherwise assume away: the office opens before the earliest window, and
; the earliest window is exactly one default-length window wide.
invariant the_earliest_window_opens_an_hour_after_the_office_does
    assert EARLIEST_WINDOW_START_MIN - OFFICE_OPENS_MIN == MINUTES_PER_HOUR and EARLIEST_WINDOW_END_MIN - EARLIEST_WINDOW_START_MIN == DEFAULT_WINDOW_MIN

; The same-day floor. An early booking does not buy an earlier slot, and a late one is not pulled
; back to the floor either.
invariant same_day_lead_never_beats_the_earliest_window
    assert earliest_start_min(0) == EARLIEST_WINDOW_START_MIN and earliest_start_min(OFFICE_OPENS_MIN) == OFFICE_OPENS_MIN + SAME_DAY_LEAD_MIN

; Two published lengths, and their sum is not a third one.
invariant only_the_two_published_window_lengths_are_offered
    assert WINDOW_LENGTHS_MIN.len == 2 and window_length_is_published(DEFAULT_WINDOW_MIN) == true and window_length_is_published(NARROW_WINDOW_MIN) == true and window_length_is_published(DEFAULT_WINDOW_MIN + NARROW_WINDOW_MIN) == false

; "By explicit agreement only", mechanically. The discriminant alone never settles the secondary
; point, and an unknown point never falls back to the default.
invariant the_secondary_point_never_settles_itself
    assert handover_point_is_settled(POINT_SECONDARY, false) == false and handover_point_is_settled(POINT_NONE, true) == false and handover_point_is_settled(POINT_DEFAULT, false) == true

; The map link is part of the promise, not a courtesy: readiness fails without it even when every
; other leg holds.
invariant the_map_link_obligation_is_load_bearing
    assert delivery_destination_ready(true, POINT_DEFAULT, true, false, EARLIEST_WINDOW_START_MIN, DEFAULT_WINDOW_MIN, 0) == false and MUST_SEND_MAP_LINK == true

; The producer is not vacuous: one case is ready, so every refusal above means something.
invariant a_complete_destination_leg_is_actually_reachable
    assert delivery_destination_ready(true, POINT_DEFAULT, false, true, EARLIEST_WINDOW_START_MIN, DEFAULT_WINDOW_MIN, 0) == true

; The shipped table answers for the coverage island, its nineteen rows account for themselves, and
; where it meets the ladder it says the ladder's number. RENAMED 2026-09-24 from
; the_shipped_zone_table_answers_for_no_part_of_the_coverage_area, which was true of the five Koh
; Phangan rows and is kept as a fact about them in the last two terms.
invariant the_shipped_zone_table_answers_for_the_coverage_island_and_agrees_with_the_ladder
    assert shipped_table_answers_for_coverage(SHIPPED_ZONE_PLACES_IN_COVERAGE) == true and SHIPPED_ZONE_PLACE_COUNT + SHIPPED_ZONE_HANDOVER_COUNT == SHIPPED_ZONE_DEFAULT_COUNT and zones_that_disagree_with_the_ladder() == 0 and shipped_table_answers_for_coverage(SHIPPED_ZONE_PLACES_IN_COVERAGE_BEFORE_PHUKET) == false and SHIPPED_ZONE_PLACE_COUNT_BEFORE_PHUKET + SHIPPED_ZONE_HANDOVER_COUNT == SHIPPED_ZONE_DEFAULT_COUNT_BEFORE_PHUKET

; The zone table's parallel arrays cannot drift apart, and its histogram is a recount.
invariant the_zone_table_arrays_stay_parallel_and_the_recount_agrees
    assert PHUKET_ZONE_NAMES_EN.len == PHUKET_ZONE_COUNT and PHUKET_ZONE_FEE_THB.len == PHUKET_ZONE_COUNT and PHUKET_ZONE_SORT_ORDER.len == PHUKET_ZONE_COUNT and PHUKET_ZONE_SOURCE.len == PHUKET_ZONE_COUNT and PHUKET_ZONE_LADDER_INDEX.len == PHUKET_ZONE_COUNT and zones_at_fee(290) + zones_at_fee(390) + zones_at_fee(490) + zones_at_fee(590) + zones_at_fee(690) + zones_at_fee(990) == PHUKET_ZONE_COUNT

; No shipped zone carries minutes, and nothing prints one in their place.
invariant no_shipped_zone_carries_an_eta
    assert ZONE_ROWS_WITH_AN_ETA_AFTER_087 == 0 and BUILT_IN_ZONES_WITH_AN_ETA == 0 and CHECKOUT_ETA_FALLBACK_LITERALS == 0 and SUCCESS_SCREEN_ETA_FALLBACK_LITERALS == 0 and ETA_IS_NOT_PUBLISHED == true

; This contract quotes nothing and charges nothing. Flipping either constant is the edit that would
; turn a promise into an invoice, so it fails here.
invariant this_contract_never_becomes_a_charge
    assert THIS_FILE_ADDS_NO_FEE_TO_ANY_TOTAL == true and ETA_IS_NOT_PUBLISHED == true

; An absence is a measurement and carries the corpus it was taken over. If either surviving count
; ever leaves zero, this fails rather than the sentence quietly becoming false. The third term is
; the one that already fell: the tariff claim is asserted NOT to hold, so restoring it to zero --
; quietly deciding the brain does not count -- breaks the invariant instead of the truth.
invariant an_absence_claim_here_holds_only_while_its_count_is_zero
    assert absence_claim_still_holds(CLOSING_TIME_SOURCES_FOUND) == true and absence_claim_still_holds(COVERAGE_ISLAND_ETA_SOURCES_FOUND) == true and absence_claim_still_holds(SECOND_PUBLISHED_AREA_PRICE_SOURCES_FOUND) == false and TRACKED_SPECS_AT_REMEASURE > TRACKED_SPECS_WHEN_FIRST_MEASURED

; The ownership edges, pinned as literals because without imports a REUSES_* string is the only
; thing standing between reuse and a second copy of somebody else's table.
invariant every_reuse_edge_names_another_contract
    assert REUSES_PRICING_HONESTY_ID != ID and REUSES_MARKET_PROFILE_ID != ID and REUSES_COMMERCE_ID != ID and REUSES_ORDER_MONEY_ID != ID and REUSES_PRICING_HONESTY_ID != REUSES_COMMERCE_ID
