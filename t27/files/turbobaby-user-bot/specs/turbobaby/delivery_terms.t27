    assert zone_fee_thb(0) == DOCUMENTED_DELIVERY_FEE_THB;
    assert zone_fee_agrees_with_the_ladder(KATHU_ZONE_INDEX) == true;
    assert zone_fee_agrees_with_the_ladder(NAIHARN_ZONE_INDEX) == true;
    assert zone_is_a_ladder_district(PHUKET_ZONE_COUNT) == false;
}

