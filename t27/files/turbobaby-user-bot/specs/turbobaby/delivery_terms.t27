    assert zones_on_ladder_district(3) == 1;
    assert zones_on_ladder_district(4) == 1;
    assert zones_on_ladder_district(5) == 1;
    assert zones_on_ladder_district(6) == 1;
    assert zones_on_ladder_district(7) == 1;
    assert zones_on_ladder_district(8) == 1;
    assert zones_on_ladder_district(9) == 1;
    assert zones_on_ladder_district(10) == 1;
