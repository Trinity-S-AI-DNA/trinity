; --- Fees and totals ------------------------------------------------------------------------------
; Measured 2026-09-20: the zone fee is READ at two endpoints (src/api/orders.rs:1920 and :2541)
; and rendered on one screen (src/ui/screens/checkout_screen.rs:818-825, :1547; the fee is at
; :826-836 since 2026-09-24, the ETA block now standing above it). It appears in no
; total expression anywhere: the order total the server accepts is subtotal minus bonus minus
; stars (src/api/orders.rs:210), with no delivery term in it. The shipped delivery fee is
; therefore displayed and never charged. This file neither changes that nor restates the identity.
; Re-verified 2026-09-21: src/ is byte-identical to the tree that measurement was taken against,
; and the contracts written since put the total elsewhere rather than here -- turbobaby/order-money
; owns the identity and turbobaby/checkout-contact states in its own words that it computes no
; total and decides no delivery. No contract in the grown corpus adds a delivery term to a total.
pub const FEE_ENTERS_NO_SHIPPED_TOTAL : bool = true;
pub const THIS_FILE_ADDS_NO_FEE_TO_ANY_TOTAL : bool = true;

; --- The absence claims, and the one the brain answered --------------------------------------------
; Three sentences in this file said that something exists NOWHERE: no closing hour, no second
; published area price, no ETA for the coverage island. All three were measured on 2026-09-20 over
; 12 tracked specs and re-run on 2026-09-21 over 43, and all three still answered zero over the
; REPOSITORY. On 2026-09-21 the owner's knowledge base was read for the first time and one of the
; three fell.
; THE MECHANISM WAS BUILT FOR THIS AND IS USED AS BUILT. The rule below is that a claim of absence
; holds only while its count is zero, "written as a function so that a worker who finds one source
; writes the number and watches the assert fail, instead of editing the prose". Two brain nodes
; publish the tariff, so the count is 2 and the claim is retired rather than quietly reworded: the
; constant keeps its name, keeps a non-zero value, and absence_claim_still_holds now answers false
; for it. The superseded count is kept beside the new one.
; THE OTHER TWO SURVIVED THE BRAIN READ, and surviving a search is not the same as never having been
; searched. The brain publishes no travel-time estimate for any district -- a delivery WINDOW is the
; promise there too -- and it publishes no office closing hour. What it does publish is a delivery
; cut-off, which is a different fact and is declared above rather than folded into either claim.
pub const ABSENCE_CLAIMS_REMEASURED_AT : str = "2026-09-21";
pub const TRACKED_SPECS_WHEN_FIRST_MEASURED : i32 = 12;
pub const TRACKED_SPECS_AT_REMEASURE : i32 = 43;
pub const ABSENCE_CLAIM_COUNT : i32 = 2;
pub const SUPERSEDED_ABSENCE_CLAIM_COUNT : i32 = 3;
pub const ABSENCE_CLAIMS_ANSWERED_BY_THE_BRAIN : i32 = 1;
pub const CLOSING_TIME_SOURCES_FOUND : i32 = 0;
pub const SECOND_PUBLISHED_AREA_PRICE_SOURCES_FOUND : i32 = 2;
pub const SUPERSEDED_SECOND_AREA_PRICE_SOURCES_FOUND : i32 = 0;
pub const COVERAGE_ISLAND_ETA_SOURCES_FOUND : i32 = 0;
pub const BRAIN_ETA_SOURCES_FOUND : i32 = 0;
pub const BRAIN_OFFICE_CLOSING_HOUR_SOURCES_FOUND : i32 = 0;
pub const ABSENCE_CLAIMS_SURVIVED_THE_REMEASURE : bool = true;
; A claim of absence holds only while its count is zero. Written as a function so that a worker who
; finds one source writes the number and watches the assert fail, instead of editing the prose.
pub fn absence_claim_still_holds(sources_found: i32) bool {
    return sources_found == 0;
}

; ==================================================================================================
; Functions. Each takes plain arguments: the compiler has no struct type, and every decision this
; file does not own arrives as a boolean produced elsewhere.
; ==================================================================================================

; Is this district on the published ladder? Index form, so the answer is bounded by the published
; count rather than by a name comparison that a rename would silently break.
; UNTIL 2026-09-21 this function was bounded by DOCUMENTED_AREA_COUNT, which is 1, so it answered
; true for exactly one index and false for the rest of the island. Both constants still exist and
; the bound is the one that moved: the seed still prices one area, the shop publishes twelve, and
; the function answers for what the SHOP publishes because that is what its name has always meant.
pub fn area_fee_is_documented(area_index: i32) bool {
    return area_index >= 0 and area_index < LADDER_DISTRICT_COUNT;
}

; The fee, or the sentinel. There is no third branch and no default: a district off the ladder
; produces an ABSENCE, which turbobaby/pricing-honesty renders as a dash carrying the sentence that
; a human quotes the price. The published figure is READ from the ladder and never computed: there
; is no arithmetic here on a fee, no nearest-step search and no distance, which is the interpolation
; prohibition expressed as a missing function rather than as a comment asking for good behaviour.
pub fn area_fee_thb(area_index: i32) i32 {
    if (area_fee_is_documented(area_index)) {
        return LADDER_DISTRICT_FEE_THB[area_index];
    }
    return FEE_ABSENT;
}

; Is this row the owner's word rather than the measurement? The two kinds of fact do not collapse
; into "published", and a consumer that wants to show provenance reads it here instead of guessing
; from the number.
pub fn fee_is_the_owners_word(area_index: i32) bool {
    if (area_fee_is_documented(area_index)) {
        return LADDER_DISTRICT_FACT_KIND[area_index] == FACT_OWNER_WORD;
    }
    return false;
}

; How many districts sit on one step, RECOUNTED from the ladder rather than read off
; DISTRICTS_AT_EACH_FLAT_STEP. That is what turns the histogram from a restatement into a
; measurement: a permuted or edited ladder now disagrees with the recount and fails.
; THE STEP GOES IN THE BODY, AND THAT IS NOT A MATTER OF TASTE. Written 2026-09-21 with the
; Zig-style continue expression -- while (i < LADDER_DISTRICT_COUNT) : (i += 1) -- this function
; was read by the two front ends differently: the pinned t27c @ 40003ed stops at the ':' and
; silently discards the loop, the increment and the return, while still answering
; typecheck ok with zero errors, so the generated C and Rust would carry a value-returning
; function with no return in it. scripts/execute_t27_assertions.py reports that as a structural
; problem and exits non-zero when it is given the compiler (KNOWN_FRONTEND_DISAGREEMENTS pins
; the three standing cases in commerce.t27 and deposit_tiers.t27; this was a fourth and a new
; one). CORRECTED BY REVIEW the same day, by moving the step inside the braces -- the form
; turbobaby/availability already uses in sum_column and turbobaby/bot-surface in
; command_is_accepted, which both front ends read the same way. The arithmetic is unchanged and
; every assert below reads as it did.
; RE-POINTED 2026-09-24. Those two examples were cited as sibling FILE:LINE pairs until this edit.
; Both still landed on their loops that day, but a sibling that gains one line above either point
; would have made this sentence cite something else in silence, so they are named by contract ID
; and function, which move only when someone renames them.
pub fn districts_at_step(fee_thb: i32) i32 {
    var found : i32 = 0;
    var i : i32 = 0;
    while (i < LADDER_DISTRICT_COUNT) {
        if (LADDER_DISTRICT_FEE_THB[i] == fee_thb) {
            found = found + 1;
        }
        i += 1;
    }
    return found;
}

; The distinction that the shipped client half loses: absent is not zero.
pub fn fee_is_absent(fee_thb: i32) bool {
    return fee_thb == FEE_ABSENT;
}

; The default point is settled by being chosen. The secondary point is settled only by an explicit
; agreement. Anything else -- including the unset discriminant -- is unsettled, and no branch falls
; back to the default.
pub fn handover_point_is_settled(point: u8, explicit_agreement: bool) bool {
    if (point == POINT_DEFAULT) {
        return true;
    }
    if (point == POINT_SECONDARY) {
        return explicit_agreement;
    }
    return false;
}

; Exactly two lengths are published. A length the shop never offered is not a shorter promise, it
; is an unpublished one.
pub fn window_length_is_published(length_min: i32) bool {
    return length_min == DEFAULT_WINDOW_MIN or length_min == NARROW_WINDOW_MIN;
}

; The same-day rule and its floor, as one function. Two hours after the booking, but never before
; the earliest window -- so a booking completed at breakfast does not buy a 09:00 delivery.
pub fn earliest_start_min(booking_completed_min: i32) i32 {
    if (booking_completed_min + SAME_DAY_LEAD_MIN < EARLIEST_WINDOW_START_MIN) {
        return EARLIEST_WINDOW_START_MIN;
    }
    return booking_completed_min + SAME_DAY_LEAD_MIN;
}

pub fn window_start_is_allowed(start_min: i32, booking_completed_min: i32) bool {
    return start_min >= earliest_start_min(booking_completed_min);
}

pub fn window_shape_is_published(start_min: i32, length_min: i32, booking_completed_min: i32) bool {
    return window_length_is_published(length_min) and window_start_is_allowed(start_min, booking_completed_min);
}

; The owner's cut-off, as the third outcome it is. Inside it the shop's own rule answers; outside it
; NOBODY here answers, and that is the published behaviour rather than a gap in this file. The pair
; is deliberately not a single tri-state integer: a consumer that forgets the second call gets a
; missing branch at the call site, not a value it can mistake for a yes.
pub fn window_start_is_within_the_cutoff(start_min: i32) bool {
    return start_min <= DELIVERY_CUTOFF_MIN;
}

pub fn window_start_needs_a_human(start_min: i32) bool {
    return !window_start_is_within_the_cutoff(start_min);
}

; THE PRODUCER. Everything the destination leg of a delivery needs, and nothing about whether the
; order itself may proceed: commerce_fulfillment_valid takes this answer together with its own
; delivery_allowed and decides that. Four independent legs, all required, none defaulted.
pub fn delivery_destination_ready(on_coverage_island: bool, point: u8, explicit_agreement: bool, map_link_sent: bool, window_start_min: i32, window_length_min: i32, booking_completed_min: i32) bool {
    return on_coverage_island and handover_point_is_settled(point, explicit_agreement) and map_link_sent and window_shape_is_published(window_start_min, window_length_min, booking_completed_min);
}

; A table answers for the coverage area only if it has at least one row inside it. Written as a
; function so the shipped count can be handed to it instead of asserted about in prose.
pub fn shipped_table_answers_for_coverage(zones_in_coverage: i32) bool {
    return zones_in_coverage > 0;
}

; The shipped zone table, read the way the ladder is: by index, bounded by the declared count, and
; FEE_ABSENT off it. Nothing is derived; a fee is either a row of the owner's table or absent.
pub fn zone_fee_thb(zone_index: i32) i32 {
    if (zone_index >= 0 and zone_index < PHUKET_ZONE_COUNT) {
        return PHUKET_ZONE_FEE_THB[zone_index];
    }
    return FEE_ABSENT;
}

pub fn zone_is_a_ladder_district(zone_index: i32) bool {
    if (zone_index >= 0 and zone_index < PHUKET_ZONE_COUNT) {
        return PHUKET_ZONE_LADDER_INDEX[zone_index] != NOT_A_LADDER_DISTRICT;
    }
    return false;
}

; Where the two tables meet they must say the same number. A zone off the ladder has nothing to
; disagree with, and it is the owner's word alone that prices it.
pub fn zone_fee_agrees_with_the_ladder(zone_index: i32) bool {
    if (zone_is_a_ladder_district(zone_index)) {
        return zone_fee_thb(zone_index) == area_fee_thb(PHUKET_ZONE_LADDER_INDEX[zone_index]);
    }
    return true;
}

pub fn zones_that_disagree_with_the_ladder() i32 {
    var found : i32 = 0;
    var i : i32 = 0;
    while (i < PHUKET_ZONE_COUNT) {
        if (!zone_fee_agrees_with_the_ladder(i)) {
            found = found + 1;
        }
        i += 1;
    }
    return found;
}

pub fn zones_on_ladder_district(ladder_index: i32) i32 {
    var found : i32 = 0;
    var i : i32 = 0;
    while (i < PHUKET_ZONE_COUNT) {
        if (PHUKET_ZONE_LADDER_INDEX[i] == ladder_index) {
            found = found + 1;
        }
        i += 1;
    }
    return found;
}

pub fn zones_at_fee(fee_thb: i32) i32 {
    var found : i32 = 0;
    var i : i32 = 0;
    while (i < PHUKET_ZONE_COUNT) {
        if (PHUKET_ZONE_FEE_THB[i] == fee_thb) {
            found = found + 1;
        }
        i += 1;
    }
    return found;
}

pub fn zones_from_source(source: u8) i32 {
    var found : i32 = 0;
    var i : i32 = 0;
    while (i < PHUKET_ZONE_COUNT) {
        if (PHUKET_ZONE_SOURCE[i] == source) {
            found = found + 1;
        }
        i += 1;
    }
    return found;
}

; ==================================================================================================
; Tests. The gate enumerates these; it does not execute the asserts, so each one below was
; hand-evaluated against the function above it.
; ==================================================================================================

test the_reuse_edges_are_named_by_id_and_are_not_this_file {
    assert REUSES_PRICING_HONESTY_ID == "turbobaby/pricing-honesty";
    assert REUSES_MARKET_PROFILE_ID == "turbobaby/market";
    assert REUSES_COMMERCE_ID == "turbobaby/commerce";
    assert REUSES_ORDER_MONEY_ID == "turbobaby/order-money";
    assert REUSES_PRICING_HONESTY_ID != ID;
    assert REUSES_MARKET_PROFILE_ID != ID;
    assert REUSES_COMMERCE_ID != ID;
    assert REUSES_ORDER_MONEY_ID != ID;
    assert PRODUCES == "delivery_destination_ready";
    assert CONSUMER_FUNCTION == "commerce_fulfillment_valid";
}

; The three tables line up: twelve names, twelve fees, twelve provenance codes. A row added to one
; without the others fails here rather than rendering a fee with no district or a district with no
; source. The histogram is RECOUNTED from the ladder, so a permuted or edited ladder disagrees with
; the declared shape instead of quietly restating it.
test the_ladder_is_twelve_districts_and_the_three_tables_agree {
    assert LADDER_DISTRICT_COUNT == 12;
    assert LADDER_DISTRICT_NAMES.len == LADDER_DISTRICT_COUNT;
    assert LADDER_DISTRICT_FEE_THB.len == LADDER_DISTRICT_COUNT;
    assert LADDER_DISTRICT_FACT_KIND.len == LADDER_DISTRICT_COUNT;
    assert LADDER_FLOW_MENTIONS.len == LADDER_DISTRICT_COUNT;
    assert districts_at_step(290) == 4;
    assert districts_at_step(390) == 1;
    assert districts_at_step(490) == 3;
    assert districts_at_step(590) == 3;
    assert districts_at_step(990) == 1;
    assert districts_at_step(290) + districts_at_step(390) + districts_at_step(490) + districts_at_step(590) + districts_at_step(990) == LADDER_DISTRICT_COUNT;
    assert DISTRICTS_AT_EACH_FLAT_STEP[0] == districts_at_step(FLAT_STEPS_TODAY_THB[0]);
    assert DISTRICTS_AT_EACH_FLAT_STEP[4] == districts_at_step(FLAT_STEPS_TODAY_THB[4]);
}

; Every rung read back by index, so a transposition inside either array shows up as a wrong fee for
; a named district rather than as a tidy table that is wrong in two places at once.
test each_district_reads_back_at_its_published_step {
    assert area_fee_thb(0) == 290;
    assert area_fee_thb(1) == 290;
    assert area_fee_thb(2) == 290;
    assert area_fee_thb(3) == 290;
    assert area_fee_thb(4) == 390;
    assert area_fee_thb(5) == 490;
    assert area_fee_thb(6) == 490;
    assert area_fee_thb(7) == 490;
    assert area_fee_thb(8) == 590;
    assert area_fee_thb(9) == 590;
    assert area_fee_thb(10) == 590;
    assert area_fee_thb(11) == 990;
    assert LADDER_DISTRICT_NAMES[4] == "Karon";
    assert LADDER_DISTRICT_NAMES[7] == "Paklok";
    assert LADDER_DISTRICT_NAMES[11] == "Maikhao";
    assert LADDER_DISTRICT_NAMES[KAMALA_LADDER_INDEX] == "Kamala";
    assert STEP_IS_A_FUNCTION_OF_DISTRICT_ALONE == true;
}

; THE SUPERSEDED READING, KEPT SO IT CAN BE TOLD FROM A CLAIM NEVER MADE. Until 2026-09-21 this file
; declared one fee and made the array length the prohibition; that was true of the seed and is still
; true OF THE SEED, which is why both sets of constants survive. The last two asserts are the point:
; the seed's single row is ladder index 0 and carries the ladder's own 290, so the figure this file
; already had is the 290 step rather than a coincidence that happens to match one.
test the_ladder_replaced_a_one_row_table_and_the_old_reading_is_kept {
    assert SUPERSEDED_PUBLISHED_AREA_COUNT == 1;
    assert SUPERSEDED_ONE_FEE_WAS_THE_WHOLE_PUBLISHED_TARIFF == true;
    assert SUPERSEDED_ARRAY_LENGTH_WAS_THE_PROHIBITION == true;
    assert LADDER_LENGTH_IS_A_MEASURED_EXTENT_NOT_A_PROHIBITION == true;
    assert LADDER_DISTRICT_COUNT > SUPERSEDED_PUBLISHED_AREA_COUNT;
    assert DOCUMENTED_AREA_COUNT == 1;
    assert SEED_STILL_PRICES_EXACTLY_ONE_AREA == true;
    assert DOCUMENTED_AREA_DELIVERY_FEE_THB.len == DOCUMENTED_AREA_COUNT;
    assert DOCUMENTED_AREA_NAMES.len == DOCUMENTED_AREA_COUNT;
    assert DOCUMENTED_AREA_DELIVERY_FEE_THB[0] == DOCUMENTED_DELIVERY_FEE_THB;
    assert DOCUMENTED_DELIVERY_FEE_THB == 290;
    assert DOCUMENTED_AREA_INDEX == 0;
    assert LADDER_DISTRICT_NAMES[0] == DOCUMENTED_AREA_NAMES[0];
    assert LADDER_DISTRICT_FEE_THB[0] == DOCUMENTED_DELIVERY_FEE_THB;
    assert SEED_ROW_IS_LADDER_INDEX_ZERO == true;
    assert SEED_ROW_IS_THE_290_STEP == true;
}

; TWO ROWS ARE THE OWNER'S WORD, AND THE FILE CAN SAY WHICH. Paklok moved 390 -> 490 on 2026-09-06
; and Maikhao arrived at 990 the same day; the ten others are the measurement. The superseded
; Paklok figure is declared beside the live one, and the mention count that supports it is flagged
; as supporting the OLD number so nobody reads two dialogs as evidence for 490.
test the_owner_decided_rows_are_marked_and_the_measured_ones_are_not {
    assert FACT_MEASURED != FACT_OWNER_WORD;
    assert OWNER_DECIDED_ROWS == 2;
    assert fee_is_the_owners_word(PAKLOK_LADDER_INDEX) == true;
    assert fee_is_the_owners_word(MAIKHAO_LADDER_INDEX) == true;
    assert fee_is_the_owners_word(0) == false;
    assert fee_is_the_owners_word(KARON_LADDER_INDEX) == false;
    assert fee_is_the_owners_word(LADDER_DISTRICT_COUNT) == false;
    assert area_fee_thb(PAKLOK_LADDER_INDEX) == PAKLOK_FEE_THB;
    assert PAKLOK_FEE_THB != PAKLOK_SUPERSEDED_FEE_THB;
    assert PAKLOK_SUPERSEDED_FEE_THB == 390;
    assert PAKLOK_FLOW_MENTIONS_SUPPORT_THE_SUPERSEDED_FEE == true;
    assert area_fee_thb(KARON_LADDER_INDEX) == PAKLOK_SUPERSEDED_FEE_THB;
    assert KARON_WAS_NOT_MOVED_WITH_PAKLOK == true;
    assert area_fee_thb(MAIKHAO_LADDER_INDEX) == MAIKHAO_FEE_THB;
    assert MAIKHAO_WAS_UNMENTIONED_BEFORE_THE_DECISION == true;
    assert PAKLOK_DECIDED_AT == MAIKHAO_DECIDED_AT;
    assert A_MEASUREMENT_DOES_NOT_OVERRULE_THE_OWNER == true;
}

; The counts, kept as the brain writes them. Three rows have no plain number and carry sentinels
; instead of a guess, and the three sentinels are distinct from each other and from any real
; count: a row with the count left off, a count written as a range, and a district the table does
; not list at all.
test the_mention_counts_are_carried_and_the_two_gaps_are_sentinels {
    assert LADDER_FLOW_MENTIONS[1] == 17;
    assert LADDER_FLOW_MENTIONS[0] == 13;
    assert LADDER_FLOW_MENTIONS[1] > LADDER_FLOW_MENTIONS[0];
    assert LADDER_FLOW_MENTIONS[KAMALA_LADDER_INDEX] == FLOW_MENTIONS_NOT_RECORDED;
    assert LADDER_FLOW_MENTIONS[9] == FLOW_MENTIONS_IS_A_RANGE;
    assert LADDER_FLOW_MENTIONS[MAIKHAO_LADDER_INDEX] == FLOW_MENTIONS_DISTRICT_ABSENT_FROM_THE_TABLE;
    assert LADDER_FLOW_MENTIONS[MAIKHAO_LADDER_INDEX] != LADDER_FLOW_MENTIONS[KAMALA_LADDER_INDEX];
    assert FLOW_MENTIONS_NOT_RECORDED != FLOW_MENTIONS_IS_A_RANGE;
    assert FLOW_MENTIONS_NOT_RECORDED != FLOW_MENTIONS_DISTRICT_ABSENT_FROM_THE_TABLE;
    assert FLOW_MENTIONS_IS_A_RANGE != FLOW_MENTIONS_DISTRICT_ABSENT_FROM_THE_TABLE;
    assert FLOW_MENTIONS_NOT_RECORDED < 0;
    assert FLOW_MENTIONS_IS_A_RANGE < 0;
    assert FLOW_MENTIONS_DISTRICT_ABSENT_FROM_THE_TABLE < 0;
    assert SENTINEL_FLOW_MENTION_ROWS == 3;
    assert NAIHARN_FLOW_MENTIONS_MIN < NAIHARN_FLOW_MENTIONS_MAX;
    assert NAIHARN_FLOW_MENTIONS_MIN == 3;
    assert NAIHARN_FLOW_MENTIONS_MAX == 5;
    assert REPLY_COUNTS[0] == 71;
    assert REPLY_COUNT_STEPS_THB[0] == 290;
    assert REPLY_COUNTS.len == MEASURED_STEP_COUNT;
    assert REPLY_COUNT_STEPS_THB.len == MEASURED_STEP_COUNT;
    assert REPLY_COUNTS[0] > LADDER_FLOW_MENTIONS[1];
    assert THE_TWO_SOURCES_COUNT_DIFFERENT_OBJECTS == true;
    assert BRAIN_LADDER_SOURCE_COUNT == 2;
}

; The airport is the one case with no single number, and it stays that way. The range is two
