  assert REUSES_CATALOG_API_ID == "turbobaby/catalog-api";
  assert REUSES_LOCALE_POLICY_ID == "turbobaby/locale-policy";
  assert REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity";
  assert REUSES_PRICING_HONESTY_ID == "turbobaby/pricing-honesty";
  assert REUSES_RATE_LIMIT_ID == "turbobaby/rate-limit";
  assert REUSES_OBSERVABILITY_ID == "turbobaby/observability";
  assert REUSES_CATALOG_API_ID != ID;
  assert REUSES_LOCALE_POLICY_ID != REUSES_REQUEST_IDENTITY_ID;
  assert REUSES_PRICING_HONESTY_ID != REUSES_CATALOG_API_ID;
  assert REUSES_RATE_LIMIT_ID != REUSES_OBSERVABILITY_ID;
  assert REUSES_RATE_LIMIT_ID != ID;
}

test the_sources_and_the_measurement_date_are_pinned {
  assert MEASURED_AT == "2026-09-21";
  assert INTAKE_SOURCE == "src/api/client_errors.rs";
  assert MESSAGE_SOURCES.len == 2;
  assert MESSAGE_SOURCES[0] == "src/trios/api_errors.rs";
  assert MESSAGE_SOURCES[1] == "src/trios/checkout_errors.rs";
  assert INTAKE_SOURCE_LINES == 847;
  assert BOUND_COUNT == 5;
}

test a_third_surface_tells_the_customer_what_a_cancellation_did {
  assert surface_is_known(SURFACE_ORDER_CANCEL) == true;
  assert surface_is_known(SURFACE_API) == true;
  assert surface_is_known(4) == false;
  assert SURFACE_COUNT == 3;
  assert SURFACE_COUNT_BEFORE_THE_CANCEL_SURFACE == 2;
  assert renders_a_bare_code(SURFACE_ORDER_CANCEL, false) == false;
  assert renders_a_bare_code(SURFACE_ORDER_CANCEL, true) == false;
  assert render_kind(SURFACE_ORDER_CANCEL, false, true) == RENDER_LOCALIZED;
  assert render_kind(SURFACE_ORDER_CANCEL, true, false) == RENDER_BARE_KEY;
  assert MESSAGE_SOURCES.len == 2;
  assert MESSAGE_SOURCES[0] == "src/trios/api_errors.rs";
  assert ORDER_CANCEL_READER == "order_cancel_line, src/trios/api_errors.rs";
  assert ORDER_CANCEL_SURFACE_ADDED_AT == "2026-09-22";
  assert ORDER_CANCEL_SETTLED_UNKNOWN_IS_TOLD_BY_THE_STATUS_LABEL == true;
  assert RENDER_EMPTY_STRING_IS_POSSIBLE == false;
}

test the_cancel_surface_delegates_where_the_general_sentence_is_true_and_is_counted_apart {
  assert ORDER_CANCEL_READER_DELEGATES_TO_THE_API_MAPPER == true;
  assert ORDER_CANCEL_DELEGATED_STATUS_CLASSES == 4;
  assert API_MAPPER_DELEGATION_SITES == 1;
  assert TRIO_MODULES_CALLING_THE_API_MAPPER == 1;
  assert ORDER_CANCEL_SERVER_SENTENCE_WAITS_FOR_THE_CHECK == true;
  assert API_MAPPER_CALL_SITES == 10;
  assert API_MAPPER_CALL_SITE_SCREENS == 6;
  assert API_MAPPER_REACHES_A_SCREEN_THROUGH_A_TRIO == true;
  assert ORDER_CANCEL_OWN_KEY_NAMES.len == ORDER_CANCEL_OWN_KEY_COUNT;
  assert ORDER_CANCEL_OWN_KEY_COUNT == 7;
  assert ORDER_CANCEL_OWN_KEY_COUNT_BEFORE_DELEGATION + 1 == ORDER_CANCEL_OWN_KEY_COUNT;
  assert ORDER_CANCEL_OWN_KEY_NAMES[0] == "T_ORDER_DETAIL_CANCELLED_BY_USER";
  assert ORDER_CANCEL_OWN_KEY_NAMES[2] == "T_API_ERR_UNKNOWN";
  assert ORDER_CANCEL_OWN_KEY_NAMES[6] == "T_ORDER_DETAIL_CANCEL_REFUSED";
  assert ORDER_CANCEL_KEYS_OUTSIDE_THE_FAILURE_UNION + 1 == ORDER_CANCEL_OWN_KEY_COUNT;
  assert FAILURE_KEY_COUNT == 11;
  assert ORDER_CANCEL_SUCCESS_KEY_WAS_READ_BY_NOTHING_BEFORE_THE_SURFACE == true;
}

test the_refused_cancellation_is_worded_by_delegation_and_its_limits_are_named {
  assert CONFLICTED_CANCELLATION_HAS_A_PUBLISHED_SENTENCE == true;
  assert CONFLICTED_CANCELLATION_HAD_A_PUBLISHED_SENTENCE_BEFORE_DELEGATION == false;
  assert CONFLICTED_CANCELLATION_KEY_NAME == "T_ORDER_DETAIL_CANCEL_REFUSED";
  assert CONFLICTED_CANCELLATION_KEY_NAME == ORDER_CANCEL_OWN_KEY_NAMES[6];
  assert CONFLICTED_CANCELLATION_KEY_NAME != CONFLICTED_CANCELLATION_INTERIM_KEY_NAME;
  assert CONFLICTED_CANCELLATION_WORDED_AT == "2026-09-25";
  assert CONFLICTED_CANCELLATION_WORDING_IS_THE_OWNERS_OWN == false;
  assert CONFLICTED_CANCELLATION_SENTENCE_IS_TRUE_OF_EVERY_CONFLICT == true;
  assert CONFLICTED_CANCELLATION_FIRST_WORDING_WAS_TRUE_OF_EVERY_CONFLICT == false;
  assert CONFLICTED_CANCELLATION_SENTENCE_IS_TRUE_OF_EVERY_CONFLICT != CONFLICTED_CANCELLATION_FIRST_WORDING_WAS_TRUE_OF_EVERY_CONFLICT;
  assert CONFLICTED_CANCELLATION_REWORDED_AT == "2026-09-25";
  assert CONFLICTED_CANCELLATION_REWORDED_AT == CONFLICTED_CANCELLATION_WORDED_AT;
  assert CONFLICTED_CANCELLATION_NAMED_LIMITS_OPEN == 1;
  assert CONFLICTED_CANCELLATION_NAMED_LIMITS_OPEN_BEFORE_REWORDING == CONFLICTED_CANCELLATION_NAMED_LIMITS_OPEN + 1;
  assert CONFLICTED_CANCELLATION_NEXT_STEP_HAS_A_CHANNEL_ON_THE_CARD == false;
  assert CONFLICTED_CANCELLATION_INTERIM_KEY_NAME == "T_API_ERR_UNKNOWN";
  assert CONFLICTED_CANCELLATION_INTERIM_KEY_NAME == ORDER_CANCEL_OWN_KEY_NAMES[2];
  assert CONFLICTED_CANCELLATION_INTERIM_INVITES_A_REPEAT_THAT_CANNOT_SUCCEED == true;
  assert UNKNOWN_CANCELLATION_HAS_A_PUBLISHED_SENTENCE == false;
  assert ORDER_CANCEL_EVERY_REFUSAL_CARRIES_A_TRUE_NEXT_STEP == false;
  assert OWNER_QUESTION_CONFLICTED_CANCELLATION_SENTENCE_IS_OPEN == false;
  assert CONFLICTED_CANCELLATION_DECISION != "";
  assert CONFLICTED_CANCELLATION_NOTE != "";
  assert CONFLICTED_CANCELLATION_NOTE_BEFORE_DELEGATION != "";
  assert CONFLICTED_CANCELLATION_NOTE != CONFLICTED_CANCELLATION_NOTE_BEFORE_DELEGATION;
  assert CONFLICTED_CANCELLATION_NOTE_BEFORE_REWORDING != "";
  assert CONFLICTED_CANCELLATION_NOTE != CONFLICTED_CANCELLATION_NOTE_BEFORE_REWORDING;
  assert CONFLICTED_CANCELLATION_NOTE_BEFORE_REWORDING != CONFLICTED_CANCELLATION_NOTE_BEFORE_DELEGATION;
  assert UNKNOWN_CANCELLATION_NOTE != "";
  assert CONFLICTED_CANCELLATION_NOTE != UNKNOWN_CANCELLATION_NOTE;
}

; --- Invariants ---------------------------------------------------------------------------------

invariant the_cancel_surface_never_renders_a_bare_code
  assert surface_is_known(SURFACE_ORDER_CANCEL) == true and renders_a_bare_code(SURFACE_ORDER_CANCEL, false) == false and render_kind_is_known(render_kind(SURFACE_ORDER_CANCEL, false, true)) == true

invariant a_worded_refusal_is_told_its_own_key_and_the_decision_is_recorded
  assert CONFLICTED_CANCELLATION_HAS_A_PUBLISHED_SENTENCE == true and OWNER_QUESTION_CONFLICTED_CANCELLATION_SENTENCE_IS_OPEN == false and CONFLICTED_CANCELLATION_KEY_NAME == ORDER_CANCEL_OWN_KEY_NAMES[6] and CONFLICTED_CANCELLATION_DECISION != "" and CONFLICTED_CANCELLATION_SENTENCE_IS_TRUE_OF_EVERY_CONFLICT == true

invariant an_unauthenticated_write_never_reaches_the_admin_read
  assert INTAKE_GATE_COUNT == 0 and route_is_gated(false) == false and route_is_gated(true) == true

invariant a_throttled_request_is_never_judged_for_shape
  assert intake_outcome(false, false, false) == OUTCOME_THROTTLED and intake_outcome(false, true, true) == OUTCOME_THROTTLED

invariant only_a_complete_intake_is_accepted
  assert intake_outcome(true, true, true) == OUTCOME_ACCEPTED and intake_outcome(true, true, false) == OUTCOME_SINK_FAILED and intake_outcome(true, false, true) == OUTCOME_MALFORMED

invariant this_file_declares_one_http_numeral_and_defers_the_rest
  assert outcome_http_status(OUTCOME_ACCEPTED) == HTTP_ACCEPTED and outcome_http_status(OUTCOME_MALFORMED) == HTTP_STATUS_OWNED_ELSEWHERE and outcome_http_status(OUTCOME_THROTTLED) == HTTP_STATUS_OWNED_ELSEWHERE and outcome_http_status(OUTCOME_SINK_FAILED) == HTTP_STATUS_OWNED_ELSEWHERE

invariant the_ceiling_is_the_first_refused_count_not_the_last_admitted_one
  assert budget_admits(RATE_MAX_REQUESTS - 1) == true and budget_admits(RATE_MAX_REQUESTS) == false

invariant the_limiter_contract_is_named_rather_than_copied
  assert SHARED_BUCKET_TRIPWIRE_IS_RESTATED_HERE == false and KEY_SOURCE_RULE_IS_RESTATED_HERE == false and REUSES_RATE_LIMIT_ID == "turbobaby/rate-limit"

invariant a_stored_row_is_never_longer_than_its_cap
  assert sanitized_length(65535, SERVER_MESSAGE_CAP_CHARS) == SERVER_MESSAGE_CAP_CHARS and sanitized_length(65535, SERVER_STACK_CAP_CHARS) == SERVER_STACK_CAP_CHARS

invariant a_full_browser_stack_cannot_survive_the_server_cap
  assert BROWSER_STACK_CAP_CHARS > SERVER_STACK_CAP_CHARS and stack_survives_the_round_trip(BROWSER_STACK_CAP_CHARS) == false

invariant no_identity_is_ever_derived_from_a_header
  assert ID_IS_DERIVED_FROM_HEADERS == false and stored_report_is_attributable(false) == false

invariant a_retention_period_is_not_claimed_without_a_sweep
  assert TELEMETRY_RETENTION_IS_IMPLEMENTED == false and TELEMETRY_TABLES_ENROLLED_IN_THE_SWEEP == 0

invariant one_present_coordinate_defeats_the_opaque_refusal
  assert report_is_opaque(true, false, true, true) == false and report_is_opaque(true, true, false, true) == false and report_is_opaque(true, true, true, false) == false

invariant a_fully_opaque_report_never_reaches_the_customer
  assert listener_report_is_reportable(false, true, true, true, true) == false

invariant noise_is_refused_whatever_its_location
  assert listener_report_is_reportable(true, false, false, false, false) == false

invariant a_filtered_report_is_lost_to_the_shop_as_well_as_to_the_customer
  assert filtering_costs_the_record(PATH_LISTENER) == true and filtering_costs_the_record(PATH_REJECTION) == true

invariant the_panic_path_is_the_only_one_that_records_without_showing
  assert path_records_without_showing(PATH_PANIC) == true and path_records_without_showing(PATH_LISTENER) == false and path_records_without_showing(PATH_REJECTION) == false

invariant the_panel_cannot_cover_the_shop_without_a_customer_tap
  assert PANEL_IS_EXPANDED_BY_DEFAULT == false and panel_blocks_the_screen(true, false) == false and panel_blocks_the_screen(true, true) == true

invariant an_empty_report_list_renders_nothing_at_all
  assert anything_renders(false) == false and panel_blocks_the_screen(false, true) == false

invariant a_normalized_source_makes_the_fatal_trigger_unreachable
  assert alert_fatal_branch_can_fire(true) == false and alert_is_raised(true, true, false, false) == false

invariant the_purchase_path_is_the_only_live_trigger
  assert ALERT_TRIGGERS_REACHABLE_IN_PRODUCTION == 1 and alert_is_raised(true, true, true, false) == true and alert_is_raised(true, true, false, false) == false

invariant the_cooldown_outranks_every_trigger
  assert alert_is_raised(false, true, true, true) == false and alert_is_raised(true, false, true, true) == false

invariant no_failure_renders_an_empty_string
  assert RENDER_EMPTY_STRING_IS_POSSIBLE == false and render_kind_is_known(render_kind(SURFACE_API, false, false)) == true and render_kind_is_known(render_kind(SURFACE_CHECKOUT, false, true)) == true

invariant the_general_surface_never_renders_a_bare_code
  assert renders_a_bare_code(SURFACE_API, false) == false and renders_a_bare_code(SURFACE_API, true) == false

invariant the_checkout_surface_renders_one_and_that_is_the_refutation
  assert renders_a_bare_code(SURFACE_CHECKOUT, false) == true and CHECKOUT_MAPPER_IS_A_WRAPPER_OF_THE_API_MAPPER == false

invariant an_unmapped_body_code_falls_to_the_status_and_is_never_shown
  assert checkout_message_source(false, true) == MESSAGE_FROM_STATUS and UNKNOWN_BODY_CODE_IS_EVER_RENDERED == false

invariant a_failure_is_not_a_price
  assert FAILURE_CARRIES_A_PRICE == false and REUSES_PRICING_HONESTY_ID == "turbobaby/pricing-honesty"
