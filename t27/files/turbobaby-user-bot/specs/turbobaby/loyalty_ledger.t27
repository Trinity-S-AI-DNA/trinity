  assert SEED_LOYALTY_MENTIONS_PINNED_COPY == 0;
  assert SEED_BONUS_MENTIONS_PINNED_COPY == 0;
  assert seed_copy_agrees_with_the_owner(SEED_LOYALTY_MENTIONS_PINNED_COPY, SEED_BONUS_MENTIONS_PINNED_COPY, 0, 0) == true;
  assert seed_copy_agrees_with_the_owner(SEED_LOYALTY_MENTIONS_PINNED_COPY, SEED_BONUS_MENTIONS_PINNED_COPY, 1, 0) == false;
  assert seed_copy_agrees_with_the_owner(SEED_LOYALTY_MENTIONS_PINNED_COPY, SEED_BONUS_MENTIONS_PINNED_COPY, 0, 2) == false;
}

test the_cashback_zero_is_this_files_own_and_is_dated {
  assert SEED_CASHBACK_MENTIONS_MEASURED_HERE == 0;
  assert SEED_CASHBACK_HAS_AN_OWNER_ELSEWHERE == false;
  assert SEED_MEASUREMENT_RERUN_AT == "2026-09-21";
  assert SEED_MEASUREMENT_RERUN_AT != SEED_MEASUREMENT_OWNER_MEASURED_AT;
}

test this_file_is_named_in_the_identity_snapshot_and_declares_the_edge_back {
  assert NAMED_IN_THE_IDENTITY_CONSUMER_SNAPSHOT == true;
  assert IDENTITY_CONSUMER_SNAPSHOT_SIZE == 22;
  assert IDENTITY_EDGE_DECLARERS_IN_CORPUS == 18;
  assert IDENTITY_EDGE_DECLARERS_INSIDE_THE_SNAPSHOT == 18;
  assert IDENTITY_EDGE_DECLARERS_OUTSIDE_THE_SNAPSHOT == 0;
  assert NAMED_BY_THE_OWNER_WITHOUT_DECLARING_THE_EDGE == 4;
  assert identity_edge_census_closes(IDENTITY_EDGE_DECLARERS_INSIDE_THE_SNAPSHOT, IDENTITY_EDGE_DECLARERS_OUTSIDE_THE_SNAPSHOT, IDENTITY_EDGE_DECLARERS_IN_CORPUS) == true;
  assert identity_edge_census_closes(4, 13, 18) == false;
  assert snapshot_accounting_closes(IDENTITY_EDGE_DECLARERS_INSIDE_THE_SNAPSHOT, NAMED_BY_THE_OWNER_WITHOUT_DECLARING_THE_EDGE, IDENTITY_CONSUMER_SNAPSHOT_SIZE) == true;
  assert snapshot_accounting_closes(18, 3, 22) == false;
  assert IDENTITY_EDGE_DECLARERS_INSIDE_THE_SNAPSHOT < IDENTITY_CONSUMER_SNAPSHOT_SIZE;
  assert IDENTITY_EDGE_CENSUS_MEASURED_AT == "2026-09-21";
  assert CORPUS_T27_FILE_COUNT == 43;
  assert CORPUS_T27_FILE_COUNT_REMEASURED == 45;
  assert CORPUS_T27_FILE_COUNT_REMEASURED_AT == "2026-09-22";
  assert CORPUS_T27_FILE_COUNT_REMEASURED_AT != IDENTITY_EDGE_CENSUS_MEASURED_AT;
  assert CORPUS_T27_FILE_COUNT_REMEASURED > CORPUS_T27_FILE_COUNT;
}

; Corrected 2026-09-22: the census re-run over the 45 files, beside the 2026-09-21 reading above.
test the_identity_census_re_run_found_a_declarer_outside_the_snapshot {
  assert IDENTITY_EDGE_CENSUS_REMEASURED_AT == "2026-09-22";
  assert IDENTITY_EDGE_CENSUS_REMEASURED_AT == CORPUS_T27_FILE_COUNT_REMEASURED_AT;
  assert IDENTITY_EDGE_CENSUS_REMEASURED_AT != IDENTITY_EDGE_CENSUS_MEASURED_AT;
  assert IDENTITY_EDGE_DECLARERS_IN_CORPUS_REMEASURED == 19;
  assert IDENTITY_EDGE_DECLARERS_INSIDE_THE_SNAPSHOT_REMEASURED == 18;
  assert IDENTITY_EDGE_DECLARERS_OUTSIDE_THE_SNAPSHOT_REMEASURED == 1;
  assert IDENTITY_EDGE_DECLARER_OUTSIDE_THE_SNAPSHOT == "turbobaby/person-naming";
  assert IDENTITY_EDGE_DECLARER_OUTSIDE_THE_SNAPSHOT != ID;
  assert IDENTITY_CONSUMER_SNAPSHOT_SIZE_REMEASURED == 22;
  assert IDENTITY_CONSUMER_SNAPSHOT_SIZE_REMEASURED == IDENTITY_CONSUMER_SNAPSHOT_SIZE;
  assert NAMED_BY_THE_OWNER_WITHOUT_DECLARING_THE_EDGE_REMEASURED == 4;
  assert identity_edge_census_closes(IDENTITY_EDGE_DECLARERS_INSIDE_THE_SNAPSHOT_REMEASURED, IDENTITY_EDGE_DECLARERS_OUTSIDE_THE_SNAPSHOT_REMEASURED, IDENTITY_EDGE_DECLARERS_IN_CORPUS_REMEASURED) == true;
  assert snapshot_accounting_closes(IDENTITY_EDGE_DECLARERS_INSIDE_THE_SNAPSHOT_REMEASURED, NAMED_BY_THE_OWNER_WITHOUT_DECLARING_THE_EDGE_REMEASURED, IDENTITY_CONSUMER_SNAPSHOT_SIZE_REMEASURED) == true;
  assert IDENTITY_EDGE_DECLARERS_IN_CORPUS_REMEASURED == IDENTITY_EDGE_DECLARERS_IN_CORPUS + 1;
  assert IDENTITY_EDGE_DECLARERS_OUTSIDE_THE_SNAPSHOT_REMEASURED > IDENTITY_EDGE_DECLARERS_OUTSIDE_THE_SNAPSHOT;
  assert PER_WINDOW_CEILING_SENTENCES_RERUN_AT == CORPUS_T27_FILE_COUNT_REMEASURED_AT;
  assert THIS_LEDGER_HAS_A_PER_WINDOW_CEILING == false;
}

test the_identity_snapshot_moved_under_this_file_and_the_date_is_what_saved_it {
  assert SNAPSHOT_MOVED_WHILE_THIS_FILE_WAS_BEING_CORRECTED == true;
  assert IDENTITY_CONSUMER_SNAPSHOT_SIZE_BEFORE_THE_RE_MEASUREMENT == 8;
  assert IDENTITY_CONSUMER_SNAPSHOT_SIZE > IDENTITY_CONSUMER_SNAPSHOT_SIZE_BEFORE_THE_RE_MEASUREMENT;
  assert IDENTITY_CONSUMER_SNAPSHOT_MEASURED_AT == "2026-09-21";
  assert IDENTITY_CONSUMER_SNAPSHOT_MEASURED_AT == IDENTITY_EDGE_CENSUS_MEASURED_AT;
  assert a_snapshot_figure_may_be_quoted_flatly(IDENTITY_CONSUMER_SNAPSHOT_MEASURED_AT, IDENTITY_EDGE_CENSUS_MEASURED_AT, SNAPSHOT_MOVED_WHILE_THIS_FILE_WAS_BEING_CORRECTED) == false;
  assert a_snapshot_figure_may_be_quoted_flatly("2026-09-20", "2026-09-21", false) == false;
  assert a_snapshot_figure_may_be_quoted_flatly("2026-09-21", "2026-09-21", false) == true;
  assert a_snapshot_figure_may_be_quoted_flatly("2026-09-21", "2026-09-21", true) == false;
}

test the_referral_contract_is_named_by_id_and_the_two_agree {
  assert REFERRAL_PROGRAM_ID == "turbobaby/referral-program";
  assert REFERRAL_CREDIT_SITES_INSIDE_THE_PAIRED_SIX == 0;
  assert REFERRAL_CREDIT_SITES_INSIDE_THE_PAIRED_SIX_BEFORE_2026_09_26 == 3;
  assert REFERRAL_CREDIT_SITES_AMONG_THE_BYPASSES == 0;
  assert REFERRAL_CREDIT_SITES_INSIDE_THE_PAIRED_SIX < BALANCE_WRITES_WITH_A_LEDGER_ROW;
  assert BALANCE_WRITES_WITH_A_LEDGER_ROW_BEFORE_2026_09_26 - REFERRAL_CREDIT_SITES_INSIDE_THE_PAIRED_SIX_BEFORE_2026_09_26 == BALANCE_WRITES_WITH_A_LEDGER_ROW;
  assert REFERRAL_CREDIT_ID == "turbobaby/referral-credit";
  assert REFERRAL_CREDIT_IS_THIS_LEDGER == false;
  assert LEDGER_ORDERING_AGREES_WITH_THE_REFERRAL_CONTRACT == true;
  assert LEDGER_ORDERING_AGREEMENT_CHECKED_AT == "2026-09-21";
  assert the_two_ledger_contracts_agree(REFERRAL_CREDIT_SITES_INSIDE_THE_PAIRED_SIX, REFERRAL_CREDIT_SITES_AMONG_THE_BYPASSES, BALANCE_WRITES_WITH_A_LEDGER_ROW) == true;
  assert the_two_ledger_contracts_agree(3, 1, 6) == false;
}

test no_expiry_period_is_published_anywhere {
  assert DECLARES_AN_EXPIRY_PERIOD == false;
  assert BONUS_EXPIRY_NAME_OCCURRENCES == 0;
  assert BONUS_EXPIRY_IS_PUBLISHED_ANYWHERE == false;
  assert a_bonus_expires(BONUS_EXPIRY_IS_PUBLISHED_ANYWHERE) == false;
  assert a_bonus_expires(true) == true;
}

test reuse_edges_are_declared_and_nothing_is_restated {
  assert REUSE_EDGES.len == REUSE_EDGE_COUNT;
  assert REUSES_ORDER_MONEY_ID == "turbobaby/order-money";
  assert REUSES_STAR_AWARD_ID == "turbobaby/star-award";
  assert REUSES_COMMERCE_ID == "turbobaby/commerce";
  assert REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity";
  assert REUSES_MARKET_PROFILE_ID == "turbobaby/market";
  assert RESTATES_THE_COMMERCE_DECISION_SET == false;
  assert DECLARES_AN_EXCHANGE_RATE == false;
  assert NAMED_IN_THE_IDENTITY_CONSUMER_SNAPSHOT == true;
}

; --- Invariants --------------------------------------------------------------------------------------

invariant a_key_alone_decides_whether_two_requests_are_one
  assert replay_is_answered_from_the_key_alone(true) == true and a_differing_payload_is_detected(true, KEY_TABLE_STORES_A_PAYLOAD_DIGEST) == false

invariant an_absent_header_leaves_the_write_unprotected
  assert IDEMPOTENCY_HEADER_IS_REQUIRED == false and write_is_replay_protected(false) == false

invariant one_namespace_lets_a_credit_key_answer_on_the_debit_route
  assert a_key_minted_for_one_direction_replays_on_the_other(DIRECTION_CREDIT, DIRECTION_DEBIT, true) == true

invariant the_commerce_conflict_verdict_cannot_be_produced_here
  assert COMMERCE_CONFLICT_VERDICT_IS_REACHABLE_HERE == false and a_differing_payload_is_detected(true, false) == false

invariant a_money_route_never_proves_the_caller_is_the_subject
  assert subject_is_proven_to_be_the_caller(MONEY_ROUTE_GATE) == false and a_third_party_may_move_this_balance(MONEY_ROUTE_GATE) == true

invariant no_admitted_debit_can_drive_the_balance_below_zero
  assert balance_after_debit(200, 200, true, 100000000) == 0 and balance_after_debit(0, 1, true, 100000000) == 0 and balance_after_debit(199, 200, true, 100000000) == 199

invariant the_guard_and_not_the_clamp_is_load_bearing
  assert clamp_fires_under_the_guard(0, 1, true) == false and clamp_would_fire(0, 1) == true

invariant a_zero_amount_parts_the_two_routes
  assert zero_amount_is_admitted(DIRECTION_CREDIT, 100000000) == true and zero_amount_is_admitted(DIRECTION_DEBIT, 100000000) == false

invariant the_ledger_cannot_reconstruct_the_balance_while_a_bypass_survives
  assert ledger_sums_to_the_balance(BALANCE_WRITES_WITHOUT_A_LEDGER_ROW) == false and ledger_sums_to_the_balance(0) == true

invariant every_bypass_site_is_named_and_counted
  assert LEDGER_BYPASS_SITES.len == BALANCE_WRITES_WITHOUT_A_LEDGER_ROW and BALANCE_WRITES_WITH_A_LEDGER_ROW + BALANCE_WRITES_WITHOUT_A_LEDGER_ROW == BALANCE_WRITE_SITE_COUNT

invariant an_unswept_key_table_makes_every_key_permanent
  assert key_is_permanent(LOYALTY_KEY_TABLE_IS_SWEPT) == true and key_namespace_is_bounded(LOYALTY_KEY_TABLE_IS_SWEPT) == false

invariant no_rate_tier_ceiling_or_expiry_is_declared_in_this_file
  assert DECLARES_A_TIER_TABLE == false and DECLARES_A_CASHBACK_PERCENT == false and DECLARES_A_USAGE_CEILING == false and DECLARES_AN_EXPIRY_PERIOD == false

invariant the_seed_zero_is_never_re_owned_by_this_file
  assert SEED_MENTIONS_ARE_A_PINNED_COPY == true and SEED_MEASUREMENT_OWNER_ID == "turbobaby/order-money" and seed_copy_agrees_with_the_owner(SEED_LOYALTY_MENTIONS_PINNED_COPY, SEED_BONUS_MENTIONS_PINNED_COPY, 0, 0) == true

invariant a_missing_name_in_the_identity_snapshot_is_never_read_as_a_missing_edge
  assert identity_edge_census_closes(IDENTITY_EDGE_DECLARERS_INSIDE_THE_SNAPSHOT, IDENTITY_EDGE_DECLARERS_OUTSIDE_THE_SNAPSHOT, IDENTITY_EDGE_DECLARERS_IN_CORPUS) == true and snapshot_accounting_closes(IDENTITY_EDGE_DECLARERS_INSIDE_THE_SNAPSHOT, NAMED_BY_THE_OWNER_WITHOUT_DECLARING_THE_EDGE, IDENTITY_CONSUMER_SNAPSHOT_SIZE) == true

invariant a_snapshot_figure_is_never_quoted_without_the_day_it_was_taken
  assert a_snapshot_figure_may_be_quoted_flatly(IDENTITY_CONSUMER_SNAPSHOT_MEASURED_AT, IDENTITY_EDGE_CENSUS_MEASURED_AT, SNAPSHOT_MOVED_WHILE_THIS_FILE_WAS_BEING_CORRECTED) == false and SNAPSHOT_MOVED_WHILE_THIS_FILE_WAS_BEING_CORRECTED == true

invariant no_referral_credit_is_a_ledger_bypass
  assert REFERRAL_CREDIT_SITES_AMONG_THE_BYPASSES == 0 and the_two_ledger_contracts_agree(REFERRAL_CREDIT_SITES_INSIDE_THE_PAIRED_SIX, REFERRAL_CREDIT_SITES_AMONG_THE_BYPASSES, BALANCE_WRITES_WITH_A_LEDGER_ROW) == true

invariant the_grant_ceiling_bounds_one_call_and_not_the_balance
  assert BALANCE_HAS_NO_CEILING == true and credit_is_admitted(100000001, true, 100000000) == false and balance_after_credit(100000000000, 100000000, true, 100000000) == 100100000000

invariant the_referral_credit_is_not_this_ledger
  assert REFERRAL_CREDIT_IS_THIS_LEDGER == false and REFERRAL_CREDIT_SITES_INSIDE_THE_PAIRED_SIX == 0

invariant the_leaderboard_answers_an_admin_only_and_the_config_read_is_closed
  assert LEADERBOARD_GATE_SITES == 1 and CLOSED_READ_ROUTE_COUNT == 1 and UNGATED_ROUTE_COUNT == 1
