  assert SEED_MEASUREMENT_OWNER_DECLARATIONS[0] == "FLEET_SEED_LOYALTY_MENTIONS";
  assert SEED_MEASUREMENT_OWNER_DECLARATIONS[1] == "FLEET_SEED_BONUS_MENTIONS";
