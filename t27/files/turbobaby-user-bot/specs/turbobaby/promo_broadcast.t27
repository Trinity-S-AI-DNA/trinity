// SPDX-License-Identifier: Apache-2.0
module turbobaby-promo-broadcast;

; specs/turbobaby/promo_broadcast.t27 -- what may be promoted and what may be sent
; This contract owns the promotion mechanism: the sweeper's admission rule for a promotable
; row, the ordering shape, the repeat identity that keeps one subject from returning, the
; boundary between a drafted message and a sent one, and the two send paths with the guards
; each of them actually has. It owns no catalog row, no message text, no recipient and no
; schedule beyond the two intervals the repository declares.
;
; WHY (measured 2026-09-21). DECISIONS.md D19 records that this database forked from another
; shop's bot carrying that shop's live catalogue, and that while it stayed public this bot
; promoted it. migrations/085_unpublish_woody_catalog.sql issues 7 UPDATE statements -- 6
; flipping visibility flags at :25-30, 1 renaming a pickup zone at :36 -- and 0 DELETE and 0
; DROP statements, by decision (:12-23, D19 at DECISIONS.md:365-370). That stopped the DATA.
; It stopped no LOGIC. Of the 6 tables those UPDATEs hid, 4 are still scanned by the sweeper
; every tick -- accessories and tea_products at src/promo.rs:155-158, sets at :189-190,
; events at :215-216 and :245-247 -- and every one of those scans admits a row on the single
; test is_available = TRUE or is_public = TRUE. (The other 2, accessory_sets and tea_sets,
; are named 0 times in src/promo.rs; the sweeper never reached them.) That test asks whether
; a row is live. Nothing in the path asks whose row it is. Flip one flag back and the other
; shop's goods are promoted again, with no code change and no warning, because the guard that
; was applied was applied to the data and not to the decision.
;
; WHY (measured 2026-09-21, the two send paths). There are two ways a message reaches every
; customer and they do not have the same guards. The Publish button (src/promo.rs:667)
; subtracts the opt-out, the fraud block and the owners from its recipient query
; (:833-839), paces itself at 500 ms per send (:871) and records an outcome row per person
; (:951). The admin HTTP route (src/api/admin.rs:718) has a cooldown of 1 attempt per 600
; seconds (:36-37) and reads its recipients as user_languages UNION loyalty_profiles
; (:795-798) with no opt-out term, no block term, no owner term and no pacing: promo_muted
; occurs 0 times in src/api/admin.rs and the send loop at :815-861 contains 0 sleeps. So the
; path that honours the unsubscribe has no cooldown, and the path that has a cooldown does
; not honour the unsubscribe. Neither path is fully guarded, and that is the fact, not an
; inference.
;
; WHERE THE BRIEF IS REFUTED. The survey cites src/promo.rs:1-5 for the four questions the
; sweeper asks. The sentence runs :3-6, and the four it names are not the four the code runs.
; The doc comment still asks for "a strain", which migration 083 removed -- :145-148 says so
; in the same file -- and it omits the bestseller scan (:306) that is the live fourth. The
; retired vocabulary survives in more than a comment: the six subject kinds at
; src/trios/promo.rs:130-135, and the prefix set they map into (src/trios/deeplink.rs:42-48,
; owned by turbobaby/deeplink), belong entirely to the retired catalog. src/api/admin.rs:71
; still accepts a "strain" CTA even though migration 083 dropped that table, and greps
; on 2026-09-21 return 0 occurrences of a bike table in src/promo.rs and 0 of "bike" in
; src/trios/promo.rs. The shop rents motorbikes and no promotion mechanism can name one.
; turbobaby/legacy-retirement owns that retirement; this file only pins where the mechanism
; still speaks its language.
;
; WHAT THIS FILE NEVER DOES. It carries no message text, no subject line, no recipient, no
; customer count, no locale table, no price, no per-kind ranking weight (those are
; unmeasured by their own source and named as such below) and no bound on a model's output.
; No Cyrillic string is quoted; the shipped copy is cited by path and line. Liveness is taken
; as a boolean from turbobaby/availability, price provenance from turbobaby/pricing-honesty,
; the locale set from turbobaby/locale-policy, the admin entry point from
; turbobaby/bot-surface, the sliding-window limiter under the admin route's cooldown from
; turbobaby/rate-limit, and the draft copy check -- its floor, its ceiling, its refusal head
; and its marker count -- from turbobaby/ai-assist, whose verdict enters here as one boolean.
; Where the repository publishes no bound, a named refusal stands in place of a plausible
; number.
; phi^2 + 1/phi^2 = 3 | TRINITY

pub const KIND : str = "promotion-contract";
pub const ID : str = "turbobaby/promo-broadcast";
pub const NAME : str = "TurboBaby promotion and broadcast bounds";
pub const WORLD : str = "gHashTag/turbobaby-user-bot";
pub const SWEEPER_IMPLEMENTATION : str = "src/promo.rs";
pub const RULES_IMPLEMENTATION : str = "src/trios/promo.rs";
pub const ADMIN_ROUTE_IMPLEMENTATION : str = "src/api/admin.rs";
pub const RETIREMENT_MIGRATION : str = "migrations/085_unpublish_woody_catalog.sql";
pub const DECISION_SOURCE : str = "DECISIONS.md D19";

; --- Reuse edges --------------------------------------------------------------------------
; Each names an owner whose decision this file consumes as an abstract parameter. Not one of
; their tables, thresholds or enumerations is restated here.
pub const REUSES_LEGACY_RETIREMENT_ID : str = "turbobaby/legacy-retirement";
pub const REUSES_AVAILABILITY_ID : str = "turbobaby/availability";
pub const REUSES_PRICING_HONESTY_ID : str = "turbobaby/pricing-honesty";
pub const REUSES_LOCALE_POLICY_ID : str = "turbobaby/locale-policy";
pub const REUSES_BOT_SURFACE_ID : str = "turbobaby/bot-surface";
; The sliding-window limiter itself, its caller-key derivation and the fact that the broadcast
; refusal emits no blocked-metric are turbobaby/rate-limit's, measured there at
; src/api/admin.rs:773-777. That contract owns the shape of the guarded surface and states
; that it keeps no per-route table, so the two figures this route is configured with are kept
; here, beside the path they gate, and the mechanism behind them is not described twice.
pub const REUSES_RATE_LIMIT_ID : str = "turbobaby/rate-limit";
; The start-payload shape and the product-prefix set a promotion links through are
; turbobaby/deeplink's. Its set is taken below as a parameter and its members are not counted
; again here; what this file owns is the mapping from a promotable subject into it
; (src/trios/promo.rs:140-159) and the attribution segment that mapping attaches (:364-366).
pub const REUSES_DEEPLINK_ID : str = "turbobaby/deeplink";
; ADDED 2026-09-21 by review, after a corpus sweep found the collision this file had missed.
; turbobaby/ai-assist owns the model boundary and, with it, the draft copy check at
; src/trios/promo.rs:277-299: it pins that function's character floor, its ceiling, the length
; of the refusal head and the number of refusal markers, and it measures that the check reads
; no digit. This file was carrying two of those four numbers as its own. They are gone; the
; owner's verdict now enters as a single boolean parameter, and the fact that a model may state
; an unchecked figure is that contract's finding, not a guarantee made here.
pub const REUSES_AI_ASSIST_ID : str = "turbobaby/ai-assist";
pub const REUSE_EDGE_COUNT : u8 = 8;

; --- The tick ------------------------------------------------------------------------------
; src/main.rs:499 spawns the sweep on a 15-minute interval and discards the first tick
; (:500-502). src/promo.rs:37 caps one tick at five drafts so a bulk import cannot arrive as
; one message per row; the remainder is not dropped, it waits for the next tick (:33-36).
pub const SWEEP_INTERVAL_SECONDS : u32 = 900;
pub const FIRST_TICK_IS_DISCARDED : bool = true;
pub const MAX_DRAFTS_PER_TICK : u16 = 5;

pub fn drafts_this_tick(found: u16) u16 {
  if (found > MAX_DRAFTS_PER_TICK) {
    return MAX_DRAFTS_PER_TICK;
  }
  return found;
}

pub fn tick_is_capped(found: u16) bool {
  return found > MAX_DRAFTS_PER_TICK;
}

; A silent loop and a stopped loop look identical in a log (src/promo.rs:12-14). An empty
; tick says so at :76; a capped tick says so at :92-96.
pub const EMPTY_TICK_REPORTS_ITSELF : bool = true;
pub const CAPPED_TICK_REPORTS_ITSELF : bool = true;

; --- What may be promoted --------------------------------------------------------------------
; A row is usable only with both an id and a non-blank name (src/promo.rs:175-177, :198).
pub fn row_is_usable(id_present: bool, name_present: bool) bool {
  return id_present and name_present;
}

; The contract. A promotable item is a live, offered thing OF THIS SHOP. flagged_live is the
; owner's answer from turbobaby/availability, not a flag reinterpreted here.
pub fn item_is_promotable(id_present: bool, name_present: bool, flagged_live: bool, offered_by_this_shop: bool) bool {
  return row_is_usable(id_present, name_present) and flagged_live and offered_by_this_shop;
}

; What ships: the same rule minus the third term. Measured against the retirement, 4 of the 6
; tables migration 085 hid are still named in src/promo.rs -- events, accessories,
; tea_products and sets -- while accessory_sets and tea_sets are named 0 times there, so the
; sweeper never reached those two and the retirement removed no scan it had.
pub const HIDDEN_TABLES_STILL_SCANNED : u8 = 4;
pub const HIDDEN_TABLES_NEVER_SCANNED : u8 = 2;
pub const SHIPPED_CHECKS_SHOP_OWNERSHIP : bool = false;

pub fn shipped_promotable(id_present: bool, name_present: bool, flagged_live: bool) bool {
  return row_is_usable(id_present, name_present) and flagged_live;
}

pub const SHOP_OWNERSHIP_NOTE : str = "No promotable table carries a shop or tenant column. accessories is migrations/002_catalog.sql:2, tea_products :30 and sets :57, all three older than the rebrand, and events is migrations/043_events_booking.sql:5. A grep for shop_id, tenant_id or owner_shop over src/ and migrations/ on 2026-09-21 returns 19 hits and every one of them is the pickup-shop selector carried on an order, declared at migrations/001_initial.sql:68; not one is a column on a promotable row. The sweeper therefore cannot ask whose goods it is about to write about, only whether the row is flagged live. What is missing is an owner column on the promotable tables, or a scan rewritten onto this shop's own tables. Neither is invented here, and offered_by_this_shop stays an input this repository cannot yet produce.";

; --- The retired vocabulary --------------------------------------------------------------
; src/trios/promo.rs:128-137 fixes the words that travel into the dedup key, the logs and the
; attribution source, and says changing one re-promotes everything of that kind. All six
; belong to the catalog turbobaby/legacy-retirement retires. The deep-link kinds at
; src/trios/deeplink.rs:42-48 are five and the first of them is still the strain that
; migration 083 dropped (:53). src/api/admin.rs:70-77 accepts the same five from the admin UI.
pub const SUBJECT_KIND_COUNT : u8 = 6;
pub const SUBJECT_KINDS : [6]str = [
  "accessory",
  "tea",
  "set",
  "event",
  "event_soon",
  "bestseller"
];
pub const RENTAL_SUBJECT_KIND_COUNT : u8 = 0;
pub const ADMIN_CTA_ACCEPTS_RETIRED_STRAIN_KIND : bool = true;

pub fn vocabulary_is_wholly_retired(kind_count: u8, rental_kind_count: u8) bool {
  return kind_count >= 1 and rental_kind_count == 0;
}

; A promotion can point at a rental only if both ends of the mapping have one: a subject kind
; to start from, and a member of turbobaby/deeplink's prefix set to land on. Neither end does
; today, and this file asserts only its own end -- the other is an input.
pub fn promotion_can_link_to_a_rental(subject_kind_exists: bool, deeplink_kind_exists: bool) bool {
  return subject_kind_exists and deeplink_kind_exists;
}

pub const RENTAL_INVISIBILITY_NOTE : str = "The shop rents motorbikes and no promotion mechanism can name one. Greps on 2026-09-21 return 0 occurrences of bikes or bike_units in src/promo.rs and 0 occurrences of bike in src/trios/promo.rs, so no scan site, no subject kind and no deep-link kind reaches the rental catalog that migrations/077_bikes.sql and migrations/078_bike_units.sql declare. A promotion about a motorbike is not badly worded in this repository, it is unrepresentable. Closing this is turbobaby/legacy-retirement's decision to state and a scan rewrite to carry; no rental kind is added here.";

; --- Ordering --------------------------------------------------------------------------------
; src/trios/promo.rs:349-356 ranks by value and keeps ties in arrival order, which is
; oldest-first, so among equals the thing that has waited longest still goes first (:347-348).
; A sold-out event scores zero at :321-324: there is nothing left to sell and the post would
; spend the tick's cap on it.
;
; CORRECTED BY REVIEW 2026-09-21: scoring zero is a POSITION, not an exclusion, and the
; difference is visible in the sweep. rank (:349-356) sorts and returns every candidate it was
; given -- it filters nothing -- and the only thing that ever removes a subject is the cap,
; src/promo.rs:97 truncate. So a sold-out event goes last, and last is still sent whenever the
; tick found five or fewer subjects. The function below states the ordering rule it really is;
; a reader must not take it for a gate.
pub const ORDER_IS_BY_VALUE_NOT_AGE : bool = true;
pub const TIES_KEEP_ARRIVAL_ORDER : bool = true;
pub const SOLD_OUT_IS_RANKED_LAST_NOT_DROPPED : bool = true;

pub fn subject_is_worth_ordering(seat_count_known: bool, seats_left: u16) bool {
  if (seat_count_known and seats_left == 0) {
    return false;
  }
  return true;
}

; What actually keeps a subject out of this tick. Only the cap does, and only once the tick has
; found more than it may send -- which is why the rule above cannot be read as a gate.
pub fn subject_is_dropped_from_this_tick(worth_ordering: bool, found: u16, position: u16) bool {
  return position >= MAX_DRAFTS_PER_TICK and tick_is_capped(found);
}

pub const RANK_WEIGHTS_ARE_UNMEASURED : bool = true;
pub const RANK_WEIGHT_NOTE : str = "The per-kind multipliers at src/trios/promo.rs:318-335 are not copied into this file and must not be. Their own comment at :308-312 calls them stated preferences rather than measurements, records that the shop has no margin data so price stands in for value, and says they are to be replaced once promo_posts holds enough published rows to show which kind converts. Pinning an unmeasured weight in a contract would make a preference read as a finding. What is pinned instead is the shape the ordering must keep: value before age, a sold-out event at the bottom, and ties in arrival order.";

; --- Repeat identity -------------------------------------------------------------------------
; migrations/074_promo_posts.sql:19 makes dedup_key UNIQUE and calls that the whole point of
; the table: it is what makes promote-once true across a restart, a crash mid-send and two
; instances overlapping. src/promo.rs:105-112 claims the row BEFORE writing the copy, so a
; crash between the two loses a post rather than repeating one. A recurring subject carries
; an ISO week in its key (src/trios/promo.rs:97-100, :171-173), which is a bucket and not a
; rolling window: a rolling window moves the key every tick and would repost every 15 minutes.
pub const DEDUP_KEY_IS_UNIQUE : bool = true;
pub const CLAIM_PRECEDES_COPY : bool = true;
pub const RECURRING_BUCKET_IS_THE_ISO_WEEK : bool = true;

pub fn subject_may_repeat(is_recurring: bool, same_bucket: bool) bool {
  if (!is_recurring) {
    return false;
  }
  return !same_bucket;
}

; --- The draft / send boundary ------------------------------------------------------------
; src/promo.rs:8-10 states the rule the code keeps: nothing in the sweeper posts publicly, the
; button does, and only when a human presses it. migrations/074_promo_posts.sql:32-34 makes
; the two states a column: published_at NULL means written and not published, and it is the
; state everything starts in. The press arrives through turbobaby/bot-surface's callback
; routing at src/bot/callbacks.rs:136-145.
pub const DRAFT_IS_NOT_A_SEND : bool = true;
pub const SEND_REQUIRES_A_HUMAN_DECISION : bool = true;

pub fn draft_reaches_owner(row_claimed: bool, owner_opted_out: bool) bool {
  return row_claimed and !owner_opted_out;
}

; Three gates, all of them checked before any customer is addressed: an admin pressed it
; (src/promo.rs:674-677), a human pressed it rather than a timer, and the post is not already
; published (:694-698). Since 2026-09-25 the button asks a fourth, the draft's kind; that gate
; and the decision behind it are publish_is_authorized in the next section, and this function is
; kept as the three it always was.
pub fn send_is_authorized(human_pressed: bool, presser_is_admin: bool, already_published: bool) bool {
  return human_pressed and presser_is_admin and !already_published;
}

; src/promo.rs:711-722 stamps published_at BEFORE the fan-out starts, because a broadcast
; takes minutes and must not be launchable twice off one button. The fan-out itself is handed
; to a background task at :762-764 and the button returns immediately, which is why the stamp
; has to be the thing that bounds a second press: at the moment the second press arrives the
; first send may not have written a single row. The summary reports what actually went out, so
; a total failure never reads as success.
pub const PUBLISHED_STAMP_PRECEDES_FANOUT : bool = true;
pub const FANOUT_RUNS_DETACHED : bool = true;

; --- A draft about something retired is not published ----------------------------------------
; DECIDED 2026-09-25, operator decision under the owner's delegation. That day the owner answered
; a numbered list of open questions, and the answer given to item 13 and everything after it
; handed those items to the operator to think through. This is one of the operator's decisions
; under that answer:
; the Publish button refuses a draft about an event and a draft about the retired shop's goods,
; and tells the admin why in the same alert its other refusals use. Nothing is deleted -- the row
; stays, published_at stays NULL, the owners' draft message keeps its button.
;
; WHY (measured 2026-09-25). promo_posts keeps every draft the sweeper ever wrote, and publish
; (src/promo.rs, by name) asked who pressed, whether the row exists and whether it was already
; published -- never what the draft is about. Events left every customer surface with the owner's
; rental-only ruling of 2026-09-24, which turbobaby/legacy-retirement records: the admin API can
; no longer make an event public (EVENTS_PUBLISHABLE, turbobaby/events-booking) and migration 088
; hides any event row still public. Neither reaches a draft already written: the sweeper drafted
; posts about the other shop's events (D19), an unpublished draft keeps its button in the owners'
; chat, and one press sent it to every customer the button reaches. The same held for that shop's
; goods. Whether production holds such a row today was not read -- this change reads no production
; -- and the refusal does not depend on the answer. The history of Subject::kind
; (src/trios/promo.rs) has written seven words into the kind column: the six of SUBJECT_KINDS and
; strain, whose variant left with migration 083 while drafts written under it did not. All seven
; belong to the retired catalog or its events, and RENTAL_SUBJECT_KIND_COUNT above is zero, so no
; draft in that table can be about a rental.
;
; THE RULE. A draft is sent only when its kind is declared publishable, and none is
; (PUBLISHABLE_DRAFT_KIND_COUNT = 0): the button refuses every draft today, including a kind it
; does not recognise, because this database forked from another shop's bot (DECISIONS.md D19) and
; a kind that bot wrote is a kind nobody here has classified. The decision is publish_refusal and
; its lists are PUBLISHABLE_KINDS and RETIRED_EVENT_KINDS, all in src/promo.rs. Two answers, cited
; by name and not quoted: PUBLISH_REFUSED_EVENT for the two event kinds, PUBLISH_REFUSED_NOT_RENTAL
; for every other kind. The refusal is taken after the already-published answer and BEFORE the
; published_at stamp, so a refused row is never marked published and nothing is written. The first
; promotion about a bike declares its kind in PUBLISHABLE_KINDS and raises the count here.
;
; WHAT IT DOES NOT CHANGE. The sweeper's admission still asks no shop question
; (SHIPPED_CHECKS_SHOP_OWNERSHIP) and a flag flipped back still DRAFTS; the draft now stops at the
; owner. The admin HTTP broadcast, the other send path, sends admin-typed text rather than a draft
; and still accepts a retired call-to-action kind (ADMIN_CTA_ACCEPTS_RETIRED_STRAIN_KIND); this
; decision is about drafts and leaves it as it was.
;
; WHERE THIS IS TIED TO THE CODE. Unit tests beside publish_refusal execute the decision for the
; six kinds written today, for unrecognised kinds, and for one of each Subject variant through a
; match with no wildcard, so a new variant cannot compile unclassified. The seventh kind, the one
; that left with 083, is not run there: nothing outside a comment under src/ may name it
; (tests/legacy_vocabulary_wiring.rs; the owner's ruling of 2026-09-25, item 12), and no list
; classifies it, so it takes the same last branch as an unrecognised kind.
; tests/promo_publish_wiring.rs reads publish as text and holds that it selects the row's kind,
; asks the decision and returns its answer before the stamp and before any send; that the
; decision, the stamp and the caller of publish each exist once under src/; that the lists below
; equal the code's; and that no retired shop kind sits in a list that answers otherwise.
;
; LINE CITATIONS RE-MEASURED 2026-09-25. The refusal adds 8 lines inside publish and the decision
; 45 more after it, so every src/promo.rs line this file cites from the published_at stamp down
; moved: by 8 inside publish, by 53 below it. Each was re-read against the file and rewritten in
; place. Nine of them -- the send-path WHY at the head of this file (:833-839, :871, :951), the
; fan-out (:762-764), the already-published answer (:694-698), the customer's mute button
; (:858-861), the unwrap_or (:1032), the NOT EXISTS term (:834-835) and the failed recipient read
; (:741-747) -- were ALREADY 29 lines short on the base commit, where every other citation from
; publish down was current; each landed on its code at +29 there, and was corrected in the same
; pass. Lines above publish's stamp did not move; of those, only publish's own head (:667,
; :674-677) and the already-published answer were re-read. New text in this file cites
; src/promo.rs by name.
pub const PUBLISH_REFUSAL_DECIDED_AT : str = "2026-09-25";
pub const PUBLISH_REFUSAL_DECIDED_BY : str = "operator decision under the owner's delegation";
pub const PUBLISH_REFUSAL_SITE : str = "src/promo.rs publish";
pub const PUBLISH_REFUSAL_DECISION : str = "src/promo.rs publish_refusal";
pub const PUBLISH_REFUSAL_WIRING_TEST : str = "tests/promo_publish_wiring.rs";
pub const PUBLISHABLE_DRAFT_KIND_COUNT : u8 = 0;
pub const RETIRED_EVENT_DRAFT_KINDS : [2]str = ["event", "event_soon"];
pub const RETIRED_SHOP_DRAFT_KINDS : [5]str = ["strain", "accessory", "tea", "set", "bestseller"];
pub const DRAFT_KINDS_EVER_WRITTEN : u8 = 7;
pub const UNRECOGNISED_DRAFT_KIND_IS_REFUSED : bool = true;
pub const PUBLISH_REFUSAL_ANSWER_COUNT : u8 = 2;
pub const REFUSAL_PRECEDES_THE_PUBLISHED_STAMP : bool = true;
pub const A_REFUSED_DRAFT_IS_STAMPED_PUBLISHED : bool = false;
pub const A_REFUSED_DRAFT_IS_DELETED : bool = false;

pub fn draft_kind_may_be_sent(kind_is_declared_publishable: bool) bool {
  return kind_is_declared_publishable;
}

; The four gates the button asks now. The first three are send_is_authorized's, unchanged.
pub fn publish_is_authorized(human_pressed: bool, presser_is_admin: bool, already_published: bool, kind_is_declared_publishable: bool) bool {
  return send_is_authorized(human_pressed, presser_is_admin, already_published) and draft_kind_may_be_sent(kind_is_declared_publishable);
}

; Which of the two answers the admin reads: 0 when the draft may be sent, else the answer's number.
pub const REFUSAL_ANSWER_NONE : u8 = 0;
pub const REFUSAL_ANSWER_EVENT : u8 = 1;
pub const REFUSAL_ANSWER_NOT_RENTAL : u8 = 2;

pub fn refusal_answer(kind_is_declared_publishable: bool, kind_is_an_event: bool) u8 {
  if (kind_is_declared_publishable) {
    return REFUSAL_ANSWER_NONE;
  }
  if (kind_is_an_event) {
    return REFUSAL_ANSWER_EVENT;
  }
  return REFUSAL_ANSWER_NOT_RENTAL;
}

; --- The two send paths ---------------------------------------------------------------------
pub const PATH_BUTTON : u8 = 1;
pub const PATH_ADMIN_API : u8 = 2;
pub const SEND_PATH_COUNT : u8 = 2;

pub fn send_path_is_known(path: u8) bool {
  return path == PATH_BUTTON or path == PATH_ADMIN_API;
}

; src/promo.rs:834-835 subtracts promo_muted; src/api/admin.rs mentions promo_muted 0 times.
pub fn path_honours_optout(path: u8) bool {
  return path == PATH_BUTTON;
}

; src/promo.rs:836-837 subtracts a blocked loyalty profile; the UNION at
; src/api/admin.rs:795-798 has no such term.
pub fn path_excludes_blocked(path: u8) bool {
  return path == PATH_BUTTON;
}

; src/promo.rs:838 excludes the owners, who already hold the draft; the admin route does not.
pub fn path_excludes_owners(path: u8) bool {
  return path == PATH_BUTTON;
}

; src/promo.rs:871 waits 500 ms between customers; the loop at src/api/admin.rs:815-861
; contains 0 sleeps.
pub fn path_paces_sends(path: u8) bool {
  return path == PATH_BUTTON;
}

; src/promo.rs:951 writes one promo_deliveries row per customer; the admin route writes none.
pub fn path_records_delivery(path: u8) bool {
  return path == PATH_BUTTON;
}

; src/api/admin.rs:36-37 and :766-777: one attempt per 600 seconds, keyed by admin id. The
; Publish button has no equivalent; its only repeat guard is the published_at stamp, which
; bounds one post and not one owner.
pub fn path_has_attempt_cooldown(path: u8) bool {
  return path == PATH_ADMIN_API;
}

pub const ADMIN_API_COOLDOWN_SECONDS : u32 = 600;
pub const ADMIN_API_ATTEMPTS_PER_WINDOW : u8 = 1;
pub const BUTTON_PATH_COOLDOWN_SECONDS : u32 = 0;

; The measured shape of the disagreement: a send path is fully guarded when it both honours
; the unsubscribe and bounds how often it may be fired. Neither shipped path does both.
pub fn path_is_fully_guarded(path: u8) bool {
  return path_honours_optout(path) and path_has_attempt_cooldown(path);
}

; --- Reach --------------------------------------------------------------------------------
; src/promo.rs:833-839, read as a rule rather than as SQL.
pub fn button_path_may_reach(seen_by_bot: bool, opted_out: bool, blocked_for_fraud: bool, is_owner: bool) bool {
  return seen_by_bot and !opted_out and !blocked_for_fraud and !is_owner;
}

; src/api/admin.rs:790-818: the union of two tables, then a positive id and a first
; occurrence. Those are the only three conditions; the parameters the button path takes have
; no counterpart to pass in.
pub fn admin_api_may_reach(seen_by_bot: bool, telegram_id_positive: bool, first_occurrence: bool) bool {
  return seen_by_bot and telegram_id_positive and first_occurrence;
}

; THE PREDICATE TWO INVARIANT NAMES WERE PROMISING AND NOT COMPOSING. Two invariants below are
; named for an OPTED-OUT customer and for a customer BLOCKED FOR FRAUD, and both used to be
; asserted against admin_api_may_reach, which takes neither parameter. The assertion was true and
; the names were not wrong about the world -- but the predicate could not SEE the condition its
; name turned on, so what was actually proved was "the admin route admits a customer meeting its
; three conditions", and the opt-out half was left to the reader's trust. That is the same defect
; as a stale citation, one level up: a name asserting more than the thing under it can decide.
; This predicate takes both parameters and returns the same answer whichever way they go. The
; two branches are deliberately identical: the equality IS the measurement, and writing it as one
; branch would hide the very fact being pinned.
; MEASURED AT SOURCE 2026-09-21, not inferred from the signature: src/api/admin.rs mentions
; promo_muted ZERO times, and its only two occurrences of "blocked" (:241 and :257) sit in the
; customer LISTING query, not in the broadcast route at :790-818, whose sole filters are
; telegram_id <= 0 and a dedup insert. The route does not read the opt-out table at all.
pub const ADMIN_ROUTE_READS_THE_OPT_OUT : bool = false;
pub const ADMIN_ROUTE_READS_THE_FRAUD_BLOCK : bool = false;
pub const ADMIN_ROUTE_PROMO_MUTED_MENTIONS : u8 = 0;
pub const ADMIN_ROUTE_FILTER_COUNT : u8 = 2;

pub fn admin_api_may_reach_regardless_of_opt_out(seen_by_bot: bool, telegram_id_positive: bool, first_occurrence: bool, opted_out: bool, blocked_for_fraud: bool) bool {
  if (opted_out or blocked_for_fraud) {
    return admin_api_may_reach(seen_by_bot, telegram_id_positive, first_occurrence);
  }
  return admin_api_may_reach(seen_by_bot, telegram_id_positive, first_occurrence);
}

; The difference between the two paths, now provable in one expression rather than by reading
; two signatures side by side: the button path CHANGES its answer when a customer opts out, and
; the admin path does not.
pub fn opt_out_changes_the_answer_on_the_admin_route() bool {
  return admin_api_may_reach_regardless_of_opt_out(true, true, true, false, false) != admin_api_may_reach_regardless_of_opt_out(true, true, true, true, false);
}

pub fn opt_out_changes_the_answer_on_the_button_path() bool {
  return button_path_may_reach(true, false, false, false) != button_path_may_reach(true, true, false, false);
}

; The unsubscribe itself. migrations/075_promo_muted.sql:9-12 stores a row per silenced
; person rather than a flag on the agent, so one owner muting it does not silence the others.
; The button rides in both messages a promotion travels in -- the owner's draft
; (src/promo.rs:623-626) and the customer's broadcast (:858-861) -- because an opt-out a reader
; has to go looking for is not an opt-out. The reverse command is deliberately not admin-gated
; (src/bot/commands.rs:685-697).
;
; CORRECTED BY REVIEW 2026-09-21. The two reads of that one table fail in OPPOSITE directions,
; and a single "fails open" constant hid it behind the more alarming of the two. The owner's
; draft read is a function that swallows its error (src/promo.rs:1023-1033, the unwrap_or at
; :1032): a database hiccup SENDS the draft, deliberately, because silence caused by an error is
; indistinguishable from a dead agent and an owner who muted it can mute it again. The
; customer's read is a NOT EXISTS term inside the recipient query (:834-835), and a failure of
; that query returns before the fan-out ever starts (:741-747): nothing is sent to anybody. So
; no hiccup has ever put a message in front of a customer who muted it. What reaches that
; customer anyway is the other send path, and that is a routing fact, not a failure mode.
pub const OPTOUT_IS_PER_PERSON : bool = true;
pub const OPTOUT_BUTTON_RIDES_WITH_THE_MESSAGE : bool = true;
pub const OWNER_DRAFT_OPTOUT_READ_FAILS_OPEN : bool = true;
pub const CUSTOMER_OPTOUT_READ_FAILS_CLOSED : bool = true;

; No bound exists on how often one customer may be reached.
pub const PER_CUSTOMER_REACH_CAP_IS_NOT_SHIPPED : bool = true;

pub fn per_customer_sends_are_bounded(cap_shipped: bool) bool {
  return cap_shipped;
}

pub const PER_CUSTOMER_REACH_CAP_NOTE : str = "Nothing bounds how often one customer is written to. promo_deliveries (migrations/076_promo_broadcast.sql:25-36) records one row per customer per published post, and src/promo.rs:951 is its only occurrence anywhere in src/ -- an INSERT, never a SELECT -- so the ledger reports and does not gate. The only per-customer gate that exists is the opt-out row of migrations/075_promo_muted.sql:9-12, which is all-or-nothing and honoured on one send path of the two. Greps over src/ and migrations/ on 2026-09-21 return 0 for last_sent, per_user_cap, max_per_day and promo_frequency. The count for cooldown or frequency depends on the flag, so the flag is named: case-INSENSITIVELY the pair returns 9 hits over src/ and 0 over migrations/, and not one of the 9 bounds a customer -- six are the per-user AI-request limiter (src/bot/mod.rs:13, :17, :24, :28, :33, :65), two are an operator alert throttle (src/api/client_errors.rs:47, :439) and one is a prose line about the sweep interval (src/main.rs:491). Case-SENSITIVELY the same pair returns 3, and they are src/bot/mod.rs:28, :65 and src/main.rs:491 -- the uppercase constants drop out, which is exactly how a reader talks himself into a smaller number than the one he measured. src/api/admin.rs contains neither word: the 600-second bound this file pins on that route is spelled as a rate-limit, so a grep for cooldown misses the one real interval in a send path. Closing this needs the owner's decision about how often one customer may be written to, and a read of promo_deliveries at the recipient query. No interval is invented here in its place, and the 600-second bound of the admin route is not one: it limits an admin's attempts, not a customer's exposure.";

; --- What a promotion may say -----------------------------------------------------------------
; src/promo.rs:504-505 reads the facts from the database rather than leaving them to a model
; that does not know this shop's prices, and :506-509 admits a price to the fact block only
; when the shop publishes a positive one -- otherwise the name goes alone. An absent amount is
; rendered by turbobaby/pricing-honesty and is not filled in here. The prompt at
; src/trios/promo.rs:222-223 tells the model to invent no price, discount, percentage or date.
pub const FACTS_COME_FROM_THE_SHOP : bool = true;

; CORRECTED BY REVIEW 2026-09-21. This constant was named MODEL_IS_FORBIDDEN_TO_INVENT, which
; reads as a guarantee, and src/trios/promo.rs:222-223 is an instruction in a prompt. Whether
; anything enforces it is turbobaby/ai-assist's measurement and its answer is no: that contract
; records that the output check reads no digit, so an invented figure in a well-formed post of
; the right length passes. The word here is INSTRUCTED, and this file promises nothing further.
pub const MODEL_IS_INSTRUCTED_NOT_TO_INVENT : bool = true;

pub fn fact_block_may_carry_price(price_published: bool, price_positive: bool) bool {
  return price_published and price_positive;
}

; An amount a post states is verified only when both halves hold: the fact block carried a
; figure the shop published, and something read the digits back out of what the model wrote.
; The second half is turbobaby/ai-assist's to answer and is taken here as a parameter, never
; assumed. Passing an instruction in its place is the mistake this function exists to prevent.
pub fn a_stated_amount_is_verified(fact_block_from_shop: bool, output_digits_are_checked: bool) bool {
  return fact_block_from_shop and output_digits_are_checked;
}

; The draft copy check belongs to turbobaby/ai-assist (REUSES_AI_ASSIST_ID). It owns
; src/trios/promo.rs:277-299 usable_copy, and this file restates none of that function's four
; figures -- the character floor, the ceiling, the length of the refusal head and the number of
; refusal markers. An earlier draft of this file carried two of them and that was a restated rule,
; not a measurement of this mechanism. What belongs here is only the consequence for a broadcast:
; the owner's verdict arrives as one boolean, and a draft it rejects is never the text that ships.
; The written fallback goes instead (an apology under the shop's name is worse than a plain post),
; and the fallback is the live path today because no model key is set in production --
; migrations/074_promo_posts.sql:26-29 says so on the column that records which of the two wrote
; the body.
; CORRECTED BY MEASUREMENT 2026-09-21. The sentence above used to say that turbobaby/ai-assist
; "pins all four of that function's figures", and it does not: that contract declares
; DRAFT_COPY_CHECK_IS_RESTATED_HERE = false and names THIS file as the owner of the same four.
; Both files defer and neither declares, so the figures are pinned by no contract at all. The
; measurement is a MARKED COPY of that contract's COPY_CHECK_CIRCULARITY_NOTE and is repeated here
; because a deferral that names a nonexistent owner reads as coverage from either side; it is not
; resolved here, because guessing which file should hold four numbers is an owner's decision and
; inventing them is the defect both refusals exist to avoid.
pub const COPY_CHECK_OWNER_ID : str = "turbobaby/ai-assist";
pub const COPY_BOUNDS_ARE_RESTATED_HERE : bool = false;
pub const COPY_CHECK_FIGURES_PINNED_BY_THE_NAMED_OWNER : u8 = 0;
pub const COPY_CHECK_FIGURE_OWNERSHIP_IS_CIRCULAR : bool = true;
pub const CIRCULARITY_COPY_OWNER_ID : str = "turbobaby/ai-assist";

pub fn copy_may_be_sent_as_written(owner_check_passed: bool) bool {
  return owner_check_passed;
}

pub const UNUSABLE_COPY_FALLS_BACK : bool = true;
pub const FALLBACK_IS_THE_LIVE_PATH : bool = true;

; --- The answer that was never the model's ----------------------------------------------------
; MEASURED AND FIXED 2026-09-21. src/ai.rs answers a prompt its sanitiser tripped on with a
; sentence this repository wrote, returned inside the same Some a real answer arrives in. Five
; call sites are chats and send it as the reply, which is why it exists. The sixth is this path,
; and here there is no chat: what comes back becomes the BODY of a promotional post. It passed the
; owner's check -- that check's refusal list carries no marker this sentence matches, and the
; sentence is well inside its length bounds -- so the draft was stored with source = "model" and
; sat one owner press from every subscriber. The refusal now happens before that check, at
; src/promo.rs:486, by identity against the declaration in src/ai.rs rather than by matching the
; sentence; the sentinel and its recogniser are turbobaby/ai-assist's and neither is copied here.
; What this file records is the consequence for a broadcast: the body is the written fallback and
; the source column says so, so nothing that reaches a subscriber is attributed to a model that
; never wrote it.
; WHERE THIS IS TIED TO THE CODE, added 2026-09-21 after an adversarial pass found that the unit
; tests execute the extracted decision and not the live site: inline the old match back into
; write_copy and four green tests stay green behind a sweeper that publishes the sentinel again.
; tests/promo_copy_wiring.rs reads src/promo.rs as text and holds three things the unit tests
; cannot -- that write_copy still routes through the decision, that the decision still asks the
; recogniser, and that it asks BEFORE the copy check, which matters because that check hands the
; sentence straight back. It also reads SENTINEL_REFUSAL_SITE back out of this file and
; re-measures it, so the citation below cannot drift off the line it names.
pub const SENTINEL_IS_REFUSED_BEFORE_THE_COPY_CHECK : bool = true;
pub const SENTINEL_REFUSAL_SITE : str = "src/promo.rs:486";
pub const SENTINEL_OWNER_ID : str = "turbobaby/ai-assist";
pub const SENTINEL_IS_MATCHED_BY_PROSE_HERE : bool = false;
pub const SOURCE_MODEL : str = "model";
pub const SOURCE_FALLBACK : str = "fallback";
pub const SUPERSEDED_SENTINEL_WAS_STORED_AS_MODEL : bool = true;

; What the body is and what the source column says, for each of the three things that can come
; back. The sentinel arm is the one that changed on 2026-09-21; the other two are unchanged.
pub fn body_is_the_written_fallback(answered: bool, answer_is_the_sentinel: bool, copy_is_usable: bool) bool {
  if (!answered) {
    return true;
  }
  if (answer_is_the_sentinel) {
    return SENTINEL_IS_REFUSED_BEFORE_THE_COPY_CHECK;
  }
  return !copy_is_usable;
}

pub fn source_is_the_model(answered: bool, answer_is_the_sentinel: bool, copy_is_usable: bool) bool {
  return !body_is_the_written_fallback(answered, answer_is_the_sentinel, copy_is_usable);
}

; A broadcast is localized. This one is not.
; src/promo.rs:454 passes the literal "ru" into the prompt, and src/api/admin.rs:46-51 takes
; one text field for every recipient. The recipient query at src/promo.rs:833 selects
; telegram_id FROM user_languages -- the very table whose language column is declared at
; migrations/001_initial.sql:4 -- and does not select that column. The published locale set
; and its fallback belong to turbobaby/locale-policy and are not restated here; what is
; stated is that this path consults neither.
pub const COPY_LOCALE_IS_A_LITERAL : bool = true;
pub const RECIPIENT_LANGUAGE_COLUMN_EXISTS : bool = true;
pub const RECIPIENT_LANGUAGE_IS_READ : bool = false;

pub fn broadcast_respects_recipient_locale(locale_taken_from_recipient: bool) bool {
  return locale_taken_from_recipient;
}

pub const LOCALE_NOTE : str = "The broadcast is single-locale by construction on both paths, and the missing input is already in hand on one of them. src/promo.rs:833 reads the recipient list out of user_languages and asks it for telegram_id only, while the language column it declines to read sits on the same row (migrations/001_initial.sql:4, NOT NULL with a default). src/promo.rs:454 supplies the copy locale as a literal, so a recipient's own language cannot reach the prompt even if it were selected. Closing this needs the language in the recipient query and a copy variant per published locale, with the locale set and the fallback taken from turbobaby/locale-policy rather than restated. No locale list and no per-locale text is written here.";

; --- The retirement: data hidden, logic intact ----------------------------------------------
; MARKED COPY, added by review 2026-09-21. The shape of migration 085 is
; turbobaby/legacy-retirement's and is measured there as HIDING_VISIBILITY_UPDATES = 6,
; HIDING_ROW_DELETES = 0, HIDING_TABLE_DROPS = 0 and a reversibility function; that contract
; deliberately excludes the delivery_zones rename at :36-38, whose owner is
; turbobaby/delivery-terms (ZONE_RENAME_MIGRATION). The three figures are repeated here only
; because this file's own measurement -- which of the hidden tables the sweeper still reads --
; is taken against them and would be unreadable without them. The drift invariant at the end of
; this file fails the moment a copy stops agreeing with the sum it was copied for. Nothing else
; of that contract is taken: the hidden-table list, the conformance rule and the reversibility
; function stay there, and this file states none of them.
pub const RETIREMENT_COPY_OWNER_ID : str = "turbobaby/legacy-retirement";
pub const RETIREMENT_VISIBILITY_UPDATE_COUNT : u8 = 6;
pub const RETIREMENT_DELETE_COUNT : u8 = 0;
pub const RETIREMENT_DROP_COUNT : u8 = 0;
pub const RETIREMENT_IS_REVERSIBLE : bool = true;

; This file's own reading of the same migration, and the one figure neither owner publishes,
; because it crosses both of them: every UPDATE the file issues. Six visibility flips at :25-30
; belong to turbobaby/legacy-retirement and the single zone rename at :36 belongs to
; turbobaby/delivery-terms, so 7 is a statement about the FILE and about no contract's subject.
; It is kept because the brief was told 6 and the file issues 7.
pub const RETIREMENT_ZONE_RENAME_UPDATE_COUNT : u8 = 1;
pub const RETIREMENT_UPDATE_COUNT : u8 = 7;

; A retirement stops a mechanism only when the rows are hidden AND the scan sites are gone.
pub fn retirement_stops_the_sweep(rows_hidden: bool, scan_sites_removed: bool) bool {
  return rows_hidden and scan_sites_removed;
}

; The live hazard, stated as a function so it can be read off rather than argued. A flag
; flipped back meets a scan site that is still open and a shop test that was never written.
pub fn a_reflipped_flag_republishes(flag_back_to_live: bool, scan_site_present: bool, shop_check_present: bool) bool {
  return flag_back_to_live and scan_site_present and !shop_check_present;
}

; ADDED 2026-09-25 with the publish refusal above. The hazard still DRAFTS: nothing in the sweep
; changed. Whether the draft then reaches a customer is the button's question now, and for a kind
; not declared publishable -- every kind the sweeper writes today -- the answer is no.
pub fn a_reflipped_flag_reaches_a_customer(flag_back_to_live: bool, scan_site_present: bool, shop_check_present: bool, kind_is_declared_publishable: bool) bool {
  return a_reflipped_flag_republishes(flag_back_to_live, scan_site_present, shop_check_present) and draft_kind_may_be_sent(kind_is_declared_publishable);
}

pub const RETIREMENT_SCOPE_NOTE : str = "Migration 085 is a visibility change and says so: rows are KEPT and only the flags flip (migrations/085_unpublish_woody_catalog.sql:12-18), no table is dropped and no row is deleted (:23), and DECISIONS.md:365-370 records that the separation is reversible by flipping the flags back so old orders and bookings still resolve their item names. That is the right decision for the data and it is not a decision about this mechanism. The scans of the 4 tables it hid that the sweeper actually reads, the 6 subject kinds, the prefix set they map into and the admin route's acceptance of a retired kind all survive it untouched: not one line of src/promo.rs or src/trios/promo.rs changed with it. turbobaby/legacy-retirement owns what is retired and whether it stays retired; this file owns only the fact that the promoter never asks.";

; --- Tests -----------------------------------------------------------------------------------

test the_tick_cap_bounds_drafts_without_dropping_the_rest {
  assert MAX_DRAFTS_PER_TICK == 5;
  assert drafts_this_tick(0) == 0;
  assert drafts_this_tick(5) == 5;
  assert drafts_this_tick(6) == 5;
  assert drafts_this_tick(137) == 5;
  assert tick_is_capped(5) == false;
  assert tick_is_capped(6) == true;
}

test a_tick_that_finds_nothing_still_says_so {
  assert SWEEP_INTERVAL_SECONDS == 900;
  assert FIRST_TICK_IS_DISCARDED == true;
  assert EMPTY_TICK_REPORTS_ITSELF == true;
  assert CAPPED_TICK_REPORTS_ITSELF == true;
}

test a_promotable_item_needs_an_identity_before_anything_else {
  assert row_is_usable(true, true) == true;
  assert row_is_usable(false, true) == false;
  assert row_is_usable(true, false) == false;
}

test the_contract_demands_this_shop_and_the_shipped_check_does_not {
  assert item_is_promotable(true, true, true, true) == true;
  assert item_is_promotable(true, true, true, false) == false;
  assert item_is_promotable(true, true, false, true) == false;
  assert item_is_promotable(false, true, true, true) == false;
  assert shipped_promotable(true, true, true) == true;
  assert SHIPPED_CHECKS_SHOP_OWNERSHIP == false;
  assert HIDDEN_TABLES_STILL_SCANNED == 4;
  assert HIDDEN_TABLES_NEVER_SCANNED == 2;
  assert HIDDEN_TABLES_STILL_SCANNED + HIDDEN_TABLES_NEVER_SCANNED == RETIREMENT_VISIBILITY_UPDATE_COUNT;
}

test the_subject_vocabulary_belongs_entirely_to_the_retired_catalog {
  assert SUBJECT_KINDS.len == SUBJECT_KIND_COUNT;
  assert SUBJECT_KIND_COUNT == 6;
  assert SUBJECT_KINDS[0] == "accessory";
  assert SUBJECT_KINDS[1] == "tea";
  assert SUBJECT_KINDS[5] == "bestseller";
  assert RENTAL_SUBJECT_KIND_COUNT == 0;
  assert ADMIN_CTA_ACCEPTS_RETIRED_STRAIN_KIND == true;
  assert vocabulary_is_wholly_retired(SUBJECT_KIND_COUNT, RENTAL_SUBJECT_KIND_COUNT) == true;
  assert vocabulary_is_wholly_retired(SUBJECT_KIND_COUNT, 1) == false;
}

test a_promotion_cannot_point_at_a_rental_from_either_end {
  assert promotion_can_link_to_a_rental(false, false) == false;
  assert promotion_can_link_to_a_rental(false, true) == false;
  assert promotion_can_link_to_a_rental(true, false) == false;
  assert promotion_can_link_to_a_rental(true, true) == true;
}

test a_sold_out_event_is_ranked_last_and_last_is_not_the_same_as_dropped {
  assert subject_is_worth_ordering(true, 0) == false;
  assert subject_is_worth_ordering(true, 1) == true;
  assert subject_is_worth_ordering(false, 0) == true;
  assert ORDER_IS_BY_VALUE_NOT_AGE == true;
  assert TIES_KEEP_ARRIVAL_ORDER == true;
  assert RANK_WEIGHTS_ARE_UNMEASURED == true;
  assert SOLD_OUT_IS_RANKED_LAST_NOT_DROPPED == true;
  assert subject_is_dropped_from_this_tick(false, 3, 0) == false;
  assert subject_is_dropped_from_this_tick(false, 3, 2) == false;
  assert subject_is_dropped_from_this_tick(true, 9, 5) == true;
  assert subject_is_dropped_from_this_tick(true, 5, 4) == false;
}

test a_subject_returns_only_in_a_new_bucket_and_a_one_shot_never_does {
  assert subject_may_repeat(false, false) == false;
  assert subject_may_repeat(false, true) == false;
  assert subject_may_repeat(true, true) == false;
  assert subject_may_repeat(true, false) == true;
  assert DEDUP_KEY_IS_UNIQUE == true;
  assert CLAIM_PRECEDES_COPY == true;
  assert RECURRING_BUCKET_IS_THE_ISO_WEEK == true;
}

test a_draft_reaches_an_owner_and_only_a_human_turns_it_into_a_send {
  assert draft_reaches_owner(true, false) == true;
  assert draft_reaches_owner(true, true) == false;
  assert draft_reaches_owner(false, false) == false;
  assert send_is_authorized(true, true, false) == true;
  assert send_is_authorized(false, true, false) == false;
  assert send_is_authorized(true, false, false) == false;
  assert send_is_authorized(true, true, true) == false;
  assert DRAFT_IS_NOT_A_SEND == true;
  assert SEND_REQUIRES_A_HUMAN_DECISION == true;
  assert PUBLISHED_STAMP_PRECEDES_FANOUT == true;
}

test the_publish_refusal_is_recorded_as_the_operators_dated_decision {
  assert PUBLISH_REFUSAL_DECIDED_AT == "2026-09-25";
  assert PUBLISH_REFUSAL_DECIDED_BY == "operator decision under the owner's delegation";
  assert PUBLISH_REFUSAL_SITE == "src/promo.rs publish";
  assert PUBLISH_REFUSAL_DECISION == "src/promo.rs publish_refusal";
  assert PUBLISH_REFUSAL_WIRING_TEST == "tests/promo_publish_wiring.rs";
}

test every_draft_kind_ever_written_is_retired_and_none_is_publishable {
  assert PUBLISHABLE_DRAFT_KIND_COUNT == 0;
  assert PUBLISHABLE_DRAFT_KIND_COUNT == RENTAL_SUBJECT_KIND_COUNT;
  assert RETIRED_EVENT_DRAFT_KINDS.len == 2;
  assert RETIRED_SHOP_DRAFT_KINDS.len == 5;
  assert RETIRED_EVENT_DRAFT_KINDS.len + RETIRED_SHOP_DRAFT_KINDS.len == DRAFT_KINDS_EVER_WRITTEN;
  assert DRAFT_KINDS_EVER_WRITTEN == SUBJECT_KIND_COUNT + 1;
  assert RETIRED_EVENT_DRAFT_KINDS[0] == SUBJECT_KINDS[3];
  assert RETIRED_EVENT_DRAFT_KINDS[1] == SUBJECT_KINDS[4];
  assert RETIRED_SHOP_DRAFT_KINDS[0] == "strain";
  assert RETIRED_SHOP_DRAFT_KINDS[1] == SUBJECT_KINDS[0];
  assert RETIRED_SHOP_DRAFT_KINDS[2] == SUBJECT_KINDS[1];
  assert RETIRED_SHOP_DRAFT_KINDS[3] == SUBJECT_KINDS[2];
  assert RETIRED_SHOP_DRAFT_KINDS[4] == SUBJECT_KINDS[5];
  assert UNRECOGNISED_DRAFT_KIND_IS_REFUSED == true;
}

test the_button_asks_four_gates_and_the_kind_can_stop_an_otherwise_authorized_send {
  assert publish_is_authorized(true, true, false, true) == true;
  assert publish_is_authorized(true, true, false, false) == false;
  assert publish_is_authorized(false, true, false, true) == false;
  assert publish_is_authorized(true, false, false, true) == false;
  assert publish_is_authorized(true, true, true, true) == false;
  assert send_is_authorized(true, true, false) == true;
  assert draft_kind_may_be_sent(false) == false;
  assert draft_kind_may_be_sent(true) == true;
}

test a_refusal_names_one_of_two_answers_and_writes_nothing {
  assert PUBLISH_REFUSAL_ANSWER_COUNT == 2;
  assert refusal_answer(true, false) == REFUSAL_ANSWER_NONE;
  assert refusal_answer(true, true) == REFUSAL_ANSWER_NONE;
  assert refusal_answer(false, true) == REFUSAL_ANSWER_EVENT;
  assert refusal_answer(false, false) == REFUSAL_ANSWER_NOT_RENTAL;
  assert REFUSAL_ANSWER_NOT_RENTAL == PUBLISH_REFUSAL_ANSWER_COUNT;
  assert REFUSAL_PRECEDES_THE_PUBLISHED_STAMP == true;
  assert A_REFUSED_DRAFT_IS_STAMPED_PUBLISHED == false;
  assert A_REFUSED_DRAFT_IS_DELETED == false;
}

test a_reflipped_flag_still_drafts_and_its_draft_stops_at_the_owner {
  assert a_reflipped_flag_republishes(true, true, false) == true;
  assert a_reflipped_flag_reaches_a_customer(true, true, false, false) == false;
  assert a_reflipped_flag_reaches_a_customer(true, true, false, true) == true;
  assert a_reflipped_flag_reaches_a_customer(true, true, true, true) == false;
  assert a_reflipped_flag_reaches_a_customer(false, true, false, true) == false;
}

test the_two_send_paths_are_a_closed_set {
  assert SEND_PATH_COUNT == 2;
  assert send_path_is_known(PATH_BUTTON) == true;
  assert send_path_is_known(PATH_ADMIN_API) == true;
  assert send_path_is_known(0) == false;
  assert send_path_is_known(3) == false;
}

test the_button_path_carries_every_guard_except_a_cooldown {
  assert path_honours_optout(PATH_BUTTON) == true;
  assert path_excludes_blocked(PATH_BUTTON) == true;
  assert path_excludes_owners(PATH_BUTTON) == true;
  assert path_paces_sends(PATH_BUTTON) == true;
  assert path_records_delivery(PATH_BUTTON) == true;
  assert path_has_attempt_cooldown(PATH_BUTTON) == false;
  assert BUTTON_PATH_COOLDOWN_SECONDS == 0;
}

test the_admin_route_carries_a_cooldown_and_nothing_else {
  assert path_has_attempt_cooldown(PATH_ADMIN_API) == true;
  assert ADMIN_API_COOLDOWN_SECONDS == 600;
  assert ADMIN_API_ATTEMPTS_PER_WINDOW == 1;
  assert path_honours_optout(PATH_ADMIN_API) == false;
  assert path_excludes_blocked(PATH_ADMIN_API) == false;
  assert path_excludes_owners(PATH_ADMIN_API) == false;
  assert path_paces_sends(PATH_ADMIN_API) == false;
  assert path_records_delivery(PATH_ADMIN_API) == false;
}

test neither_shipped_path_is_fully_guarded {
  assert path_is_fully_guarded(PATH_BUTTON) == false;
  assert path_is_fully_guarded(PATH_ADMIN_API) == false;
}

test the_button_path_subtracts_four_kinds_of_person {
  assert button_path_may_reach(true, false, false, false) == true;
  assert button_path_may_reach(false, false, false, false) == false;
  assert button_path_may_reach(true, true, false, false) == false;
  assert button_path_may_reach(true, false, true, false) == false;
  assert button_path_may_reach(true, false, false, true) == false;
}

test the_admin_route_asks_only_whether_the_chat_exists_once {
  assert admin_api_may_reach(true, true, true) == true;
  assert admin_api_may_reach(false, true, true) == false;
  assert admin_api_may_reach(true, false, true) == false;
  assert admin_api_may_reach(true, true, false) == false;
  assert admin_api_may_reach_regardless_of_opt_out(true, true, true, false, false) == true;
  assert admin_api_may_reach_regardless_of_opt_out(true, true, true, true, false) == true;
  assert admin_api_may_reach_regardless_of_opt_out(true, true, true, false, true) == true;
  assert admin_api_may_reach_regardless_of_opt_out(true, true, true, true, true) == true;
  assert admin_api_may_reach_regardless_of_opt_out(false, true, true, true, true) == false;
  assert admin_api_may_reach_regardless_of_opt_out(true, false, true, true, true) == false;
  assert admin_api_may_reach_regardless_of_opt_out(true, true, false, true, true) == false;
}

; The literals behind the two invariant names, asserted so the names rest on a measurement and
; not on a reading of a function signature.
test the_admin_route_reads_neither_the_opt_out_nor_the_block {
  assert ADMIN_ROUTE_READS_THE_OPT_OUT == false;
  assert ADMIN_ROUTE_READS_THE_FRAUD_BLOCK == false;
  assert ADMIN_ROUTE_PROMO_MUTED_MENTIONS == 0;
  assert ADMIN_ROUTE_FILTER_COUNT == 2;
  assert path_honours_optout(PATH_ADMIN_API) == false;
  assert opt_out_changes_the_answer_on_the_admin_route() == false;
  assert opt_out_changes_the_answer_on_the_button_path() == true;
  assert opt_out_changes_the_answer_on_the_admin_route() != opt_out_changes_the_answer_on_the_button_path();
}

test the_opt_out_is_per_person_visible_and_its_two_reads_fail_opposite_ways {
  assert OPTOUT_IS_PER_PERSON == true;
  assert OPTOUT_BUTTON_RIDES_WITH_THE_MESSAGE == true;
  assert OWNER_DRAFT_OPTOUT_READ_FAILS_OPEN == true;
  assert CUSTOMER_OPTOUT_READ_FAILS_CLOSED == true;
}

test no_bound_exists_on_how_often_one_customer_is_reached {
  assert PER_CUSTOMER_REACH_CAP_IS_NOT_SHIPPED == true;
  assert per_customer_sends_are_bounded(false) == false;
  assert per_customer_sends_are_bounded(true) == true;
}

test a_promotion_states_a_price_only_when_the_shop_publishes_one {
  assert fact_block_may_carry_price(true, true) == true;
  assert fact_block_may_carry_price(true, false) == false;
  assert fact_block_may_carry_price(false, true) == false;
  assert fact_block_may_carry_price(false, false) == false;
  assert FACTS_COME_FROM_THE_SHOP == true;
  assert MODEL_IS_INSTRUCTED_NOT_TO_INVENT == true;
  assert a_stated_amount_is_verified(true, true) == true;
  assert a_stated_amount_is_verified(true, false) == false;
  assert a_stated_amount_is_verified(false, true) == false;
  assert a_stated_amount_is_verified(false, false) == false;
}

test the_copy_check_is_borrowed_whole_and_a_rejected_draft_never_ships {
  assert COPY_CHECK_OWNER_ID == "turbobaby/ai-assist";
  assert COPY_CHECK_OWNER_ID == REUSES_AI_ASSIST_ID;
  assert COPY_BOUNDS_ARE_RESTATED_HERE == false;
  assert copy_may_be_sent_as_written(true) == true;
  assert copy_may_be_sent_as_written(false) == false;
  assert UNUSABLE_COPY_FALLS_BACK == true;
  assert FALLBACK_IS_THE_LIVE_PATH == true;
  assert COPY_CHECK_FIGURES_PINNED_BY_THE_NAMED_OWNER == 0;
  assert COPY_CHECK_FIGURE_OWNERSHIP_IS_CIRCULAR == true;
  assert CIRCULARITY_COPY_OWNER_ID == REUSES_AI_ASSIST_ID;
}

; The sentence the shop wrote for one customer is not copy for all of them.
test the_prompt_filters_own_sentence_is_never_the_body_of_a_post {
  assert SENTINEL_IS_REFUSED_BEFORE_THE_COPY_CHECK == true;
  assert SENTINEL_IS_MATCHED_BY_PROSE_HERE == false;
  assert SENTINEL_OWNER_ID == REUSES_AI_ASSIST_ID;
  assert SUPERSEDED_SENTINEL_WAS_STORED_AS_MODEL == true;
  assert body_is_the_written_fallback(true, true, true) == true;
  assert source_is_the_model(true, true, true) == false;
  assert body_is_the_written_fallback(true, false, true) == false;
  assert source_is_the_model(true, false, true) == true;
  assert body_is_the_written_fallback(true, false, false) == true;
  assert source_is_the_model(true, false, false) == false;
  assert body_is_the_written_fallback(false, false, false) == true;
  assert source_is_the_model(false, false, false) == false;
  assert SOURCE_MODEL == "model";
  assert SOURCE_FALLBACK == "fallback";
}

test the_broadcast_is_not_localized_and_the_column_it_ignores_exists {
  assert COPY_LOCALE_IS_A_LITERAL == true;
  assert RECIPIENT_LANGUAGE_COLUMN_EXISTS == true;
  assert RECIPIENT_LANGUAGE_IS_READ == false;
  assert broadcast_respects_recipient_locale(RECIPIENT_LANGUAGE_IS_READ) == false;
  assert broadcast_respects_recipient_locale(true) == true;
}

test the_retirement_hid_rows_and_removed_no_scan_site {
  assert RETIREMENT_UPDATE_COUNT == 7;
  assert RETIREMENT_VISIBILITY_UPDATE_COUNT == 6;
  assert RETIREMENT_ZONE_RENAME_UPDATE_COUNT == 1;
  assert RETIREMENT_VISIBILITY_UPDATE_COUNT + RETIREMENT_ZONE_RENAME_UPDATE_COUNT == RETIREMENT_UPDATE_COUNT;
  assert RETIREMENT_COPY_OWNER_ID == REUSES_LEGACY_RETIREMENT_ID;
  assert RETIREMENT_DELETE_COUNT == 0;
  assert RETIREMENT_DROP_COUNT == 0;
  assert RETIREMENT_IS_REVERSIBLE == true;
  assert retirement_stops_the_sweep(true, true) == true;
  assert retirement_stops_the_sweep(true, false) == false;
  assert retirement_stops_the_sweep(false, true) == false;
}

test a_reflipped_flag_walks_back_into_the_open_scan {
  assert a_reflipped_flag_republishes(true, true, false) == true;
  assert a_reflipped_flag_republishes(true, true, true) == false;
  assert a_reflipped_flag_republishes(true, false, false) == false;
  assert a_reflipped_flag_republishes(false, true, false) == false;
}

test every_borrowed_decision_names_its_owner {
  assert REUSE_EDGE_COUNT == 8;
  assert REUSES_AI_ASSIST_ID == "turbobaby/ai-assist";
  assert REUSES_DEEPLINK_ID == "turbobaby/deeplink";
  assert REUSES_RATE_LIMIT_ID == "turbobaby/rate-limit";
  assert REUSES_LEGACY_RETIREMENT_ID == "turbobaby/legacy-retirement";
  assert REUSES_AVAILABILITY_ID == "turbobaby/availability";
  assert REUSES_PRICING_HONESTY_ID == "turbobaby/pricing-honesty";
  assert REUSES_LOCALE_POLICY_ID == "turbobaby/locale-policy";
  assert REUSES_BOT_SURFACE_ID == "turbobaby/bot-surface";
}

test the_identity_of_this_contract_is_fixed {
  assert KIND == "promotion-contract";
  assert ID == "turbobaby/promo-broadcast";
  assert SWEEPER_IMPLEMENTATION == "src/promo.rs";
  assert RULES_IMPLEMENTATION == "src/trios/promo.rs";
  assert RETIREMENT_MIGRATION == "migrations/085_unpublish_woody_catalog.sql";
  assert DECISION_SOURCE == "DECISIONS.md D19";
}

; --- Invariants --------------------------------------------------------------------------------

invariant one_tick_can_never_exceed_the_draft_cap
  assert drafts_this_tick(137) == MAX_DRAFTS_PER_TICK and drafts_this_tick(MAX_DRAFTS_PER_TICK) == MAX_DRAFTS_PER_TICK

invariant a_thing_of_another_shop_is_not_promotable_however_live_it_is
  assert item_is_promotable(true, true, true, false) == false

invariant the_shipped_admission_rule_cannot_ask_the_question_the_contract_asks
  assert shipped_promotable(true, true, true) == true and item_is_promotable(true, true, true, false) == false and SHIPPED_CHECKS_SHOP_OWNERSHIP == false

invariant no_promotion_vocabulary_can_name_a_rental
  assert RENTAL_SUBJECT_KIND_COUNT == 0 and vocabulary_is_wholly_retired(SUBJECT_KIND_COUNT, RENTAL_SUBJECT_KIND_COUNT) == true and promotion_can_link_to_a_rental(false, true) == false

invariant a_sold_out_event_is_ranked_below_everything_that_still_has_a_seat
  assert subject_is_worth_ordering(true, 0) == false and SOLD_OUT_IS_RANKED_LAST_NOT_DROPPED == true

invariant worthlessness_alone_never_keeps_a_subject_out_of_an_uncapped_tick
  assert subject_is_dropped_from_this_tick(false, 3, 0) == false and subject_is_dropped_from_this_tick(true, 9, 5) == true

invariant a_one_shot_subject_never_returns
  assert subject_may_repeat(false, false) == false and subject_may_repeat(false, true) == false

invariant a_recurring_subject_cannot_return_twice_in_one_bucket
  assert subject_may_repeat(true, true) == false

invariant no_timer_and_no_non_admin_can_turn_a_draft_into_a_send
  assert send_is_authorized(false, true, false) == false and send_is_authorized(true, false, false) == false

invariant one_published_post_cannot_be_broadcast_twice
  assert send_is_authorized(true, true, true) == false and PUBLISHED_STAMP_PRECEDES_FANOUT == true

invariant no_draft_of_a_retired_kind_reaches_a_customer_however_it_is_pressed
  assert publish_is_authorized(true, true, false, false) == false and PUBLISHABLE_DRAFT_KIND_COUNT == 0 and UNRECOGNISED_DRAFT_KIND_IS_REFUSED == true

invariant a_refused_draft_stays_a_draft
  assert REFUSAL_PRECEDES_THE_PUBLISHED_STAMP == true and A_REFUSED_DRAFT_IS_STAMPED_PUBLISHED == false and A_REFUSED_DRAFT_IS_DELETED == false

invariant a_flag_flipped_back_drafts_but_no_longer_mails
  assert a_reflipped_flag_republishes(true, true, false) == true and a_reflipped_flag_reaches_a_customer(true, true, false, false) == false

invariant an_owner_who_opted_out_is_sent_no_draft
  assert draft_reaches_owner(true, true) == false

invariant neither_send_path_honours_the_opt_out_and_bounds_its_rate
  assert path_is_fully_guarded(PATH_BUTTON) == false and path_is_fully_guarded(PATH_ADMIN_API) == false

invariant the_path_with_the_cooldown_is_the_path_without_the_opt_out
  assert path_has_attempt_cooldown(PATH_BUTTON) == false and path_honours_optout(PATH_ADMIN_API) == false

; Both invariants now compose the predicate that TAKES the condition its name turns on, so the
; opted-out and blocked arguments are passed in explicitly and the admin route is shown admitting
; the customer anyway. The old composition is kept in the same assertion rather than dropped: it
; still holds, and keeping it proves the new predicate agrees with the one it wraps.
invariant an_opted_out_customer_is_still_reachable_on_the_admin_route
  assert button_path_may_reach(true, true, false, false) == false and admin_api_may_reach_regardless_of_opt_out(true, true, true, true, false) == true and admin_api_may_reach(true, true, true) == true

invariant a_customer_blocked_for_fraud_is_still_reachable_on_the_admin_route
  assert button_path_may_reach(true, false, true, false) == false and admin_api_may_reach_regardless_of_opt_out(true, true, true, false, true) == true and admin_api_may_reach(true, true, true) == true

invariant the_admin_route_never_starts_reading_the_opt_out_unnoticed
  assert opt_out_changes_the_answer_on_the_admin_route() == false and opt_out_changes_the_answer_on_the_button_path() == true and ADMIN_ROUTE_READS_THE_OPT_OUT == false

invariant nothing_in_this_repository_bounds_one_customers_exposure
  assert PER_CUSTOMER_REACH_CAP_IS_NOT_SHIPPED == true and per_customer_sends_are_bounded(false) == false

invariant a_fact_block_never_states_an_amount_the_shop_has_not_published
  assert fact_block_may_carry_price(false, true) == false and fact_block_may_carry_price(true, false) == false

invariant an_instruction_alone_never_makes_a_stated_amount_verified
  assert MODEL_IS_INSTRUCTED_NOT_TO_INVENT == true and a_stated_amount_is_verified(true, false) == false

invariant a_draft_the_owners_check_rejects_is_never_the_text_that_ships
  assert copy_may_be_sent_as_written(false) == false and UNUSABLE_COPY_FALLS_BACK == true

; A post is attributed to a model only when a model wrote it. The sentinel is the one sentence on
; this path that looks like an answer and is not one.
invariant a_post_attributed_to_the_model_was_written_by_the_model
  assert source_is_the_model(true, true, true) == false and body_is_the_written_fallback(true, true, true) == true and SENTINEL_IS_REFUSED_BEFORE_THE_COPY_CHECK == true

invariant the_copy_bounds_stay_with_their_owner
  assert COPY_BOUNDS_ARE_RESTATED_HERE == false and COPY_CHECK_OWNER_ID == REUSES_AI_ASSIST_ID

invariant the_shipped_broadcast_does_not_follow_the_recipients_language
  assert RECIPIENT_LANGUAGE_IS_READ == false and broadcast_respects_recipient_locale(RECIPIENT_LANGUAGE_IS_READ) == false and RECIPIENT_LANGUAGE_COLUMN_EXISTS == true

invariant hiding_the_rows_did_not_stop_the_mechanism
  assert retirement_stops_the_sweep(true, false) == false and RETIREMENT_DELETE_COUNT == 0 and RETIREMENT_DROP_COUNT == 0 and HIDDEN_TABLES_STILL_SCANNED == 4

invariant a_flag_flipped_back_republishes_because_no_shop_test_stands_in_the_way
  assert a_reflipped_flag_republishes(true, true, false) == true and a_reflipped_flag_republishes(true, true, true) == false

invariant the_retirement_itself_is_owned_elsewhere
  assert REUSES_LEGACY_RETIREMENT_ID == "turbobaby/legacy-retirement" and REUSE_EDGE_COUNT == 8

; The drift guard on the marked copy above. Six flips plus one rename is the whole file, and if
; a copied figure is ever edited without its neighbour this stops adding up.
invariant the_copied_retirement_figures_still_add_up_to_the_migration_they_came_from
  assert RETIREMENT_VISIBILITY_UPDATE_COUNT + RETIREMENT_ZONE_RENAME_UPDATE_COUNT == RETIREMENT_UPDATE_COUNT and RETIREMENT_DELETE_COUNT == 0 and RETIREMENT_DROP_COUNT == 0 and RETIREMENT_COPY_OWNER_ID == REUSES_LEGACY_RETIREMENT_ID

invariant the_limiter_behind_the_admin_cooldown_is_owned_elsewhere
  assert REUSES_RATE_LIMIT_ID == "turbobaby/rate-limit" and path_has_attempt_cooldown(PATH_ADMIN_API) == true
