pub const NEXT_LARGEST_SOURCE_LINES : u16 = 4603;
pub const NEXT_LARGEST_SOURCE_LINES_BEFORE_2026_09_26 : u16 = 4599;

; --- Who cites this screen, counted over the corpus as it stands now -------------------------
; The header's count of citing contracts was TWO and is FIVE. It is pinned as a literal here
; because the wrong number was doing real work in the argument: two passing render-side mentions
; read as a screen nobody looks at, and five contracts across both sides of the boundary read as
; a screen everyone depends on and nobody owns -- which is the actual case, and the stronger
; reason for this file. Measured over the 43-file corpus, 2026-09-21, excluding this file.
pub const CONTRACTS_CITING_ADMIN_SCREEN : u8 = 5;
pub const CONTRACTS_CITING_IT_RENDER_SIDE : u8 = 3;
pub const CONTRACTS_CITING_IT_INPUT_SIDE : u8 = 2;
pub const CONTRACTS_OWNING_ITS_WRITE_BOUNDS : u8 = 0;
pub const ADMIN_SCREEN_CITERS_NOTE : str = "turbobaby/availability, turbobaby/order-money and turbobaby/order-status cite src/ui/screens/admin_screen.rs for something it renders; turbobaby/upload-media and turbobaby/validation-bounds cite it as the caller on the input side, each through a declared constant (CALLER_SOURCE and HONEST_PARSER_CALLER). None of the five claims the write bounds: turbobaby/validation-bounds states it owns no admin write bound and names turbobaby/catalog-write, and turbobaby/upload-media states it owns no catalog column bound. Measured 2026-09-21 over the 43 files under specs/; the header of this file said TWO, which was true when written and had stopped being true.";

; --- Where a write is judged twice ----------------------------------------------------------------
; Every bounded field is judged by the API first and by the column second. The two judgements are
; independent, so the interesting states are not "passes" and "fails" but "passes both",
; "refused early" and "admitted then refused" -- the last being the one that reaches the owner as
; a blank 500 (src/api/bikes.rs:1157-1158).
pub fn write_reaches_storage(api_admits: bool, column_admits: bool) bool {
    return api_admits and column_admits;
}

pub fn admitted_then_refused(api_admits: bool, column_admits: bool) bool {
    return api_admits and !column_admits;
}

; How well a field is guarded, as one value. GUARD_BOTH and GUARD_BOTH_PINNED look the same in a
; code review and behave differently: only the pinned one cannot drift, because only it has a
; test reading the migration back.
pub const GUARD_NONE : u8 = 0;
pub const GUARD_COLUMN_ONLY : u8 = 1;
pub const GUARD_API_ONLY : u8 = 2;
pub const GUARD_BOTH : u8 = 3;
pub const GUARD_BOTH_PINNED : u8 = 4;

pub fn guard_level(api_checks: bool, column_checks: bool, pinned_equal: bool) u8 {
    if (api_checks and column_checks and pinned_equal) {
        return GUARD_BOTH_PINNED;
    }
    if (api_checks and column_checks) {
        return GUARD_BOTH;
    }
    if (api_checks) {
        return GUARD_API_ONLY;
    }
    if (column_checks) {
        return GUARD_COLUMN_ONLY;
    }
    return GUARD_NONE;
}

; The state that produces a blank 500: both sides check and nothing proves they agree.
pub fn guards_can_diverge(level: u8) bool {
    return level == GUARD_BOTH;
}

; --- The displacement ceiling ---------------------------------------------------------------------
; src/api/bikes.rs:949 declares the ceiling and 1040 applies it; the stated purpose at 946-948 is
; to catch a slipped decimal point rather than to express an opinion about motorcycles. It is a
; CHOSEN budget, not a fleet measurement, which is exactly why bike_catalog.t27 would not have it:
; that file's own words at line 159 are quoted below.
pub const WRITE_DISPLACEMENT_MAX_CC : i32 = 3000;
pub const WRITE_DISPLACEMENT_CEILING_IS_CHOSEN : bool = true;
pub const WRITE_DISPLACEMENT_CEILING_PURPOSE : str = "catch a slipped decimal point";
pub const CATALOG_DECLINES_A_DISPLACEMENT_BOUND : bool = true;
pub const CATALOG_DECLINED_BOUND_QUOTE : str = "Measured extremes of the fleet of 2026-09-12. Reported, never used as a bound.";
; The API floor and the column floor, as the two different numbers they are.
; src/api/bikes.rs:1040 refuses cc < 0, so 0 is admitted.
; migrations/077_bikes.sql:67 CHECK (displacement_cc > 0), so the smallest value stored is 1.
pub const WRITE_DISPLACEMENT_MIN_ADMITTED_CC : i32 = 0;
pub const COLUMN_DISPLACEMENT_MIN_CC : i32 = 1;
; The column carries no ceiling of its own: displacement_cc is INT with one CHECK, and that CHECK
; is a floor. So the upper bound is the API's alone and has no second opinion anywhere.
pub const COLUMN_HAS_A_DISPLACEMENT_CEILING : bool = false;

pub fn write_admits_displacement(cc: i32) bool {
    return cc >= WRITE_DISPLACEMENT_MIN_ADMITTED_CC and cc <= WRITE_DISPLACEMENT_MAX_CC;
}

pub fn column_admits_displacement(cc: i32) bool {
    return cc >= COLUMN_DISPLACEMENT_MIN_CC;
}

pub fn displacement_reaches_storage(cc: i32) bool {
    return write_reaches_storage(write_admits_displacement(cc), column_admits_displacement(cc));
}

pub fn displacement_is_admitted_then_refused(cc: i32) bool {
    return admitted_then_refused(write_admits_displacement(cc), column_admits_displacement(cc));
}

; The ceiling is useful only while it sits above whatever the fleet holds, and the fleet's largest
; displacement is bike_catalog.t27's measurement, not this file's. It arrives as an argument.
pub fn ceiling_clears_the_measured_fleet(fleet_max_cc: i32) bool {
    return WRITE_DISPLACEMENT_MAX_CC > fleet_max_cc;
}

; --- The money floor, which has the same shape -----------------------------------------------------
; src/api/bikes.rs:1005-1012 refuses a non-finite number and a number below zero, and admits zero.
; migrations/077_bikes.sql:59-66 gives all four money columns CHECK (col IS NULL OR col > 0), and
; the migration's own comment says those checks make the confident-zero defect unwritable. They do
; -- at the column. At the API, zero is still writable, and the refusal arrives without a sentence.
; No value of any of these columns appears in this file; these are the names of the CHECKs.
pub const ZERO_REFUSING_COLUMN_COUNT : u8 = 5;
pub const ZERO_REFUSING_COLUMNS : [5]str = [
    "displacement_cc",
    "base_rate_thb_day",
    "deposit_thb",
    "monthly_low_season_thb",
    "sale_price_thb",
];
pub const WRITE_ADMITS_ZERO : bool = true;
pub const COLUMN_ADMITS_ZERO : bool = false;
; Absence is not a bound and is never rewritten into one: an omitted money field stays omitted
; through the whole validator. The discipline that absence is honest belongs to the pricing
; contract (REUSES_PRICING_ID); what belongs here is that the write path never substitutes a
; number for it.
pub const WRITE_SUBSTITUTES_A_NUMBER_FOR_ABSENCE : bool = false;

pub fn write_admits_money(supplied: bool, finite: bool, negative: bool) bool {
    if (!supplied) {
        return true;
    }
    return finite and !negative;
}

pub fn money_reaches_storage(supplied: bool, finite: bool, negative: bool, positive: bool) bool {
    if (!supplied) {
        return true;
    }
    return write_reaches_storage(write_admits_money(true, finite, negative), positive);
}

; A family may be on the forecourt with no asking price: src/api/bikes.rs:2365-2375 is the test,
; and its reason is that requiring a price alongside the flag forces the shop to invent a number.
; The constant is the coupling, so the function stays honest if the coupling ever ships.
pub const WRITE_COUPLES_FOR_SALE_TO_A_PRICE : bool = false;
pub const FOR_SALE_WITHOUT_A_PRICE_TEST : str = "a_family_can_be_for_sale_with_no_asking_price";

pub fn for_sale_write_admitted(for_sale: bool, price_supplied: bool) bool {
    if (WRITE_COUPLES_FOR_SALE_TO_A_PRICE and for_sale) {
        return price_supplied;
    }
    return true;
}

; --- The text ceilings ------------------------------------------------------------------------------
; Ten application sites: nine in the family validator (src/api/bikes.rs:1019-1065) and one in the
; unit validator (src/api/bikes.rs:1394). Three of the ten reach for a named constant and seven
; carry an inline literal, and there are only TWO named constants because MAX_TEXT_LEN
; (src/api/bikes.rs:953) is used at two of those three sites -- the descriptions at
; src/api/bikes.rs:1064-1065 -- while MAX_KEY_LEN is used at one. Sites and constants are counted
; separately below for that reason: nine literals in a row look like nine independent decisions
; and are not.
pub const WRITE_TEXT_MAX_CHARS : u16 = 4000;
pub const WRITE_TEXT_MAX_CHARS_FIELD_COUNT : u8 = 2;
pub const WRITE_TEXT_MAX_CHARS_FIELDS : [2]str = ["description_ru", "description_en"];
pub const WRITE_KEY_MAX_CHARS : u16 = 200;
pub const WRITE_BRAND_MAX_CHARS : u16 = 200;
pub const WRITE_MODEL_MAX_CHARS : u16 = 200;
pub const WRITE_VARIANT_LABEL_MAX_CHARS : u16 = 200;
pub const WRITE_CLASS_MAX_CHARS : u16 = 32;
pub const WRITE_BODY_MAX_CHARS : u16 = 64;
pub const WRITE_IMAGE_URL_MAX_CHARS : u16 = 2048;
pub const WRITE_UNIT_CODE_MAX_CHARS : u16 = 64;
pub const NAMED_TEXT_CEILING_CONSTANT_COUNT : u8 = 2;
pub const NAMED_TEXT_CEILING_SITE_COUNT : u8 = 3;
pub const INLINE_TEXT_CEILING_SITE_COUNT : u8 = 7;
pub const TEXT_CEILING_SITE_COUNT : u8 = 10;
; The ceiling counts CHARACTERS, not bytes: src/api/bikes.rs:983 and 996 both compare
; chars().count(). That is the honest unit for a field an owner types, and it means the byte
; length of an accepted description is not bounded by this number at all. Nothing downstream
; needs it to be: description_ru and description_en are plain TEXT at migrations/077_bikes.sql:53-54
; with no length constraint, so the ceiling is a form bound and never a storage bound.
pub const TEXT_CEILING_COUNTS_CHARACTERS : bool = true;
pub const TEXT_CEILING_COUNTS_BYTES : bool = false;
pub const COLUMN_HAS_A_TEXT_CEILING : bool = false;
; Trim happens before the count, and an optional field that trims to nothing becomes absent rather
; than an empty string (src/api/bikes.rs:993-995). A required field that trims to nothing is
; refused (src/api/bikes.rs:979-982). Two different answers to the same input, both deliberate.
pub const CEILING_IS_APPLIED_AFTER_TRIM : bool = true;

pub fn text_within_ceiling(char_count: u16, ceiling_chars: u16) bool {
    return char_count <= ceiling_chars;
}

pub fn required_text_admitted(nonempty_after_trim: bool, char_count: u16, ceiling_chars: u16) bool {
    return nonempty_after_trim and text_within_ceiling(char_count, ceiling_chars);
}

; True when the value is stored; false is the absent case, which is legal and is not a rejection.
pub fn optional_text_is_stored(nonempty_after_trim: bool, char_count: u16, ceiling_chars: u16) bool {
    if (!nonempty_after_trim) {
        return false;
    }
    return text_within_ceiling(char_count, ceiling_chars);
}

pub fn optional_text_admitted(nonempty_after_trim: bool, char_count: u16, ceiling_chars: u16) bool {
    if (!nonempty_after_trim) {
        return true;
    }
    return text_within_ceiling(char_count, ceiling_chars);
}

; --- The family key is write-once --------------------------------------------------------------------
; src/api/bikes.rs:1188-1190: model.key is deliberately NOT written on update, because the key is a
; live cart line's catalog_id (D8) and a rename would leave those lines pointing at a family that
; no longer answers under that name. src/api/bikes.rs:891-895 states the same rule at the request
; shape: required on create, ignored on update, and the server does not accept it as a field even
; against a request made by hand.
pub const WRITE_MODE_NONE : u8 = 0;
pub const WRITE_MODE_CREATE : u8 = 1;
pub const WRITE_MODE_UPDATE : u8 = 2;
pub const WRITE_MODE_COUNT : u8 = 2;
pub const FAMILY_KEY_IS_WRITE_ONCE : bool = true;
pub const FAMILY_KEY_IMMUTABILITY_REASON : str = "the family key is a live cart line's catalog_id (D8), so a rename orphans every line that holds one";
; The honest limit of the rule. A row can be removed and a new one created under another key; that
; is not a rename and it does not rescue the cart line, which is orphaned either way. So the rule
; protects the line from a silent rename, not from every way a key can stop answering.
pub const REMOVE_AND_RECREATE_IS_A_RENAME : bool = false;

pub fn family_key_is_persisted(write_mode: u8) bool {
    if (write_mode == WRITE_MODE_CREATE) {
        return true;
    }
    return false;
}

; The only mode that writes the key is the only mode that demands one, so this is the same
; predicate rather than a second copy of it. src/api/bikes.rs:1111-1114 rejects a create with no
; key; the update handler never reads the field.
pub fn family_key_is_required(write_mode: u8) bool {
    return family_key_is_persisted(write_mode);
}

; False for every argument today, and false BY WAY OF family_key_is_persisted rather than by a
; constant. The day an update writes the key, that function flips and this one flips with it.
pub fn rename_is_expressible(write_mode: u8, key_supplied: bool) bool {
    if (write_mode == WRITE_MODE_UPDATE and key_supplied) {
        return family_key_is_persisted(write_mode);
    }
    return false;
}

; --- The unit-status set is closed, and pinned -----------------------------------------------------
; The four wire values and their names belong to availability.t27 (REUSES_AVAILABILITY_ID) and are
; not repeated here. What belongs here: the set is closed by the CHECK at
; migrations/078_bike_units.sql:32, the API refuses a non-member first at two validation sites
; (src/api/bikes.rs:1400, reached from the two unit handlers at 1478 and 1523, and
; src/api/bikes.rs:1577), and the API's copy is pinned to the migration by a shipped test. That
; pin is what the displacement floor and the money floors do not have.
pub const UNIT_STATUS_SET_IS_CLOSED : bool = true;
pub const UNIT_STATUS_COLUMN_CHECK_EXISTS : bool = true;
pub const UNIT_STATUS_API_VALIDATION_SITE_COUNT : u8 = 2;
pub const UNIT_STATUS_API_HANDLER_COUNT : u8 = 3;
pub const UNIT_STATUS_IS_PINNED_TO_THE_COLUMN : bool = true;
pub const UNIT_STATUS_PIN_TEST : str = "the_four_statuses_match_the_check_constraint";
; A status the API somehow let through would not be folded into a known bucket downstream: the
; rollup at src/api/bikes.rs:817-820 gives an unexpected value its own bucket on purpose, so a
; surprising status is visible rather than absorbed. That is a read-side behaviour recorded here
; only as the reason the write-side closure is allowed to fail loudly.
pub const UNKNOWN_STATUS_IS_ABSORBED_DOWNSTREAM : bool = false;

; Membership is decided by the owner of the vocabulary and arrives as a boolean.
pub fn unit_status_write_admitted(status_in_declared_set: bool) bool {
    return status_in_declared_set;
}

pub fn unit_status_reaches_storage(status_in_declared_set: bool, column_admits: bool) bool {
    return write_reaches_storage(unit_status_write_admitted(status_in_declared_set), column_admits);
}

; --- The body vocabulary has no guard ----------------------------------------------------------------
; THE TRIPWIRE. src/api/bikes.rs:1055 checks the body field's length and nothing else;
; migrations/077_bikes.sql:37 declares the column with no CHECK, and 35-36 gives the reason. The
; six styles exist on the write path only as form options, in the create form at
; src/ui/screens/admin_screen.rs:1112-1121 and again in the edit card at 2447-2450, and a request
; made by hand never meets either. The vocabulary itself stays bike_catalog.t27's
; (REUSES_CATALOG_ID); the counts below count controls and the options inside one of them, and no
; style name is written in this file.
pub const BODY_API_CHECKS_VOCABULARY : bool = false;
pub const BODY_COLUMN_CHECKS_VOCABULARY : bool = false;
pub const BODY_WRITE_CHECK_IS_LENGTH_ONLY : bool = true;
pub const BODY_FORM_OPTION_COUNT : u8 = 6;
; Two controls carry those six options, not one: the create form and the edit card. Both are the
; same list typed twice, and neither is on the path a hand-made request takes.
pub const BODY_FORM_CONTROL_COUNT : u8 = 2;
pub const BODY_FORM_IS_THE_ONLY_GUARD : bool = true;
pub const BODY_VOCABULARY_GUARD_IS_NOT_SHIPPED : bool = true;
pub const BODY_VOCABULARY_GUARD_NOTE : str = "No server-side check of the body value exists. src/api/bikes.rs:1055 bounds its length only and migrations/077_bikes.sql:37 leaves the column unconstrained by decision, so the six styles are enforced by two form controls -- the create form at src/ui/screens/admin_screen.rs:1112-1121 and the edit card at src/ui/screens/admin_screen.rs:2447-2450, the same list typed twice -- and by nothing a hand-made request passes through. Closing this needs a membership check against the catalog contract's body list at the write path, and a test reading it back the way the class allowlist is read back from the migration at src/api/bikes.rs:2251.";
; The class field is the shipped counter-example, and it is what a body guard would look like:
; an API allowlist at src/api/bikes.rs:944, a column CHECK at migrations/077_bikes.sql:33, and a
; test at src/api/bikes.rs:2251 that reads the migration back in both directions.
pub const CLASS_API_CHECKS_VOCABULARY : bool = true;
pub const CLASS_COLUMN_CHECKS_VOCABULARY : bool = true;
pub const CLASS_IS_PINNED_TO_THE_COLUMN : bool = true;

; Refused only when something checks and the value is outside. With both guards measured false,
; nothing refuses it -- which is the tripwire, and it clears itself the day either guard ships.
pub fn body_value_is_refused(api_checks_vocabulary: bool, column_checks_vocabulary: bool, value_in_vocabulary: bool) bool {
    if (value_in_vocabulary) {
        return false;
    }
    return api_checks_vocabulary or column_checks_vocabulary;
}

; --- What this file refuses to answer ------------------------------------------------------------
; Named refusals, in the corpus form: a bool plus a note saying what is missing and what would
; close it. None of them is filled with a plausible number.
pub const DISPLACEMENT_FLOOR_AGREEMENT_IS_NOT_SHIPPED : bool = true;
pub const DISPLACEMENT_FLOOR_AGREEMENT_NOTE : str = "Nothing proves the API floor and the column floor agree. A grep over src/, scripts/ and tests/ for the constraint name bikes_displacement_positive returns no match on 2026-09-20, so no test reads migrations/077_bikes.sql:67 the way src/api/bikes.rs:2251 reads the class CHECK. Closing this needs that test, or an API floor of 1.";
pub const LONGEST_SUBMITTED_TEXT_IS_NOT_MEASURED : bool = true;
pub const LONGEST_SUBMITTED_TEXT_NOTE : str = "Whether the 4000-character ceiling has ever bound anything is unknown here. data/fleet_seed.json carries no description field on any family, and the repository stores no sample of admin-submitted text, so there is no corpus to measure a longest value against. Closing this needs a measurement of stored descriptions, not a guess.";

; --- Tests ---------------------------------------------------------------------------------------

test the_owner_contracts_are_named_and_none_of_them_is_restated {
    assert REUSES_CATALOG_ID == "turbobaby/bike-catalog";
    assert REUSES_AVAILABILITY_ID == "turbobaby/availability";
    assert REUSES_PRICING_ID == "turbobaby/pricing-honesty";
    assert REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity";
    assert REUSES_CATALOG_ID != ID;
    assert REUSES_AVAILABILITY_ID != ID;
    assert REUSES_PRICING_ID != ID;
    assert REUSES_REQUEST_IDENTITY_ID != ID;
    assert REUSES_CATALOG_ID != REUSES_AVAILABILITY_ID;
    assert REUSES_AVAILABILITY_ID != REUSES_PRICING_ID;
    assert REUSES_PRICING_ID != REUSES_REQUEST_IDENTITY_ID;
    assert CLASS_AND_BODY_VOCABULARY_INPUT == "membership boolean supplied by the catalog contract";
    assert UNIT_STATUS_VOCABULARY_INPUT == "membership boolean supplied by the availability contract";
    assert MONEY_ABSENCE_INPUT == "absence discipline owned by the pricing contract";
    assert WHO_MAY_WRITE_IS_NOT_THIS_FILES_SUBJECT == true;
}

; The header's census of who else cites the screen, as literals. Pinned because the number was
; wrong in the direction that weakens the argument, and because a count of citers is exactly the
; kind of sentence that ages without anyone noticing: every new contract that mentions the screen
; falsifies it silently.
test the_screen_is_cited_by_five_contracts_and_owned_by_none {
    assert CONTRACTS_CITING_ADMIN_SCREEN == 5;
    // The split adds up, so neither side can be dropped and leave a plausible total.
    assert CONTRACTS_CITING_IT_RENDER_SIDE + CONTRACTS_CITING_IT_INPUT_SIDE == CONTRACTS_CITING_ADMIN_SCREEN;
    assert CONTRACTS_CITING_IT_RENDER_SIDE == 3;
    assert CONTRACTS_CITING_IT_INPUT_SIDE == 2;
    // The claim the wrong count was propping up, and the reason this file exists. The two
    // input-side citers each disclaim the write bounds in their own headers.
    assert CONTRACTS_OWNING_ITS_WRITE_BOUNDS == 0;
    assert ADMIN_SCREEN == "src/ui/screens/admin_screen.rs";
}

test the_sources_these_bounds_were_read_from_are_pinned {
    assert WRITE_SOURCE == "src/api/bikes.rs";
    assert FAMILY_MIGRATION == "migrations/077_bikes.sql";
    assert UNIT_MIGRATION == "migrations/078_bike_units.sql";
    assert ADMIN_SCREEN == "src/ui/screens/admin_screen.rs";
    assert MEASURED_AT == "2026-09-20";
    assert ADMIN_SCREEN_LINES == 6627;
    assert ADMIN_SCREEN_LINES_BEFORE_2026_09_26 == 5910;
    assert ADMIN_SCREEN_LINES - ADMIN_SCREEN_LINES_BEFORE_2026_09_26 == 717;
    assert ADMIN_SCREEN_LINES_BEFORE_2026_09_24 == 5881;
    assert ADMIN_SCREEN_LINES_BEFORE_2026_09_26 - ADMIN_SCREEN_LINES_BEFORE_2026_09_24 == 29;
    assert ADMIN_SCREEN_LINES > NEXT_LARGEST_SOURCE_LINES;
}

test the_write_ceiling_exists_because_the_catalog_declined_to_own_one {
    assert CATALOG_DECLINES_A_DISPLACEMENT_BOUND == true;
    assert CATALOG_DECLINED_BOUND_QUOTE == "Measured extremes of the fleet of 2026-09-12. Reported, never used as a bound.";
    assert WRITE_DISPLACEMENT_CEILING_IS_CHOSEN == true;
    assert WRITE_DISPLACEMENT_CEILING_PURPOSE == "catch a slipped decimal point";
    assert WRITE_DISPLACEMENT_MAX_CC == 3000;
    // The fleet's largest displacement belongs to the catalog contract, so it arrives as an
    // argument rather than as a constant here. The value probed is the one src/api/bikes.rs:946-947
    // names as the reason the ceiling sits where it does, so this file reads it from its own
    // source and copies no table.
    assert ceiling_clears_the_measured_fleet(750) == true;
    assert ceiling_clears_the_measured_fleet(900) == true;
    assert ceiling_clears_the_measured_fleet(3000) == false;
}

test the_displacement_ceiling_is_where_the_constant_says_it_is {
    assert write_admits_displacement(1) == true;
    assert write_admits_displacement(750) == true;
    assert write_admits_displacement(WRITE_DISPLACEMENT_MAX_CC) == true;
    assert write_admits_displacement(WRITE_DISPLACEMENT_MAX_CC + 1) == false;
    assert write_admits_displacement(-1) == false;
    assert COLUMN_HAS_A_DISPLACEMENT_CEILING == false;
    assert column_admits_displacement(WRITE_DISPLACEMENT_MAX_CC + 1) == true;
}

; The gap, value by value. Zero is the only displacement the API admits and the column refuses:
; 1 passes both, -1 and 3001 are refused by the API before the column is reached, and only 0 gets
; all the way to Postgres and comes back as a blank 500.
test zero_displacement_is_admitted_by_the_api_and_refused_by_the_column {
    assert WRITE_DISPLACEMENT_MIN_ADMITTED_CC == 0;
    assert COLUMN_DISPLACEMENT_MIN_CC == 1;
    assert write_admits_displacement(0) == true;
    assert column_admits_displacement(0) == false;
    assert displacement_is_admitted_then_refused(0) == true;
    assert displacement_reaches_storage(0) == false;
    assert displacement_is_admitted_then_refused(1) == false;
    assert displacement_reaches_storage(1) == true;
    assert displacement_is_admitted_then_refused(-1) == false;
    assert displacement_is_admitted_then_refused(WRITE_DISPLACEMENT_MAX_CC + 1) == false;
    assert displacement_reaches_storage(WRITE_DISPLACEMENT_MAX_CC + 1) == false;
}

test the_two_judgements_are_independent {
    assert write_reaches_storage(true, true) == true;
    assert write_reaches_storage(true, false) == false;
    assert write_reaches_storage(false, true) == false;
    assert write_reaches_storage(false, false) == false;
    assert admitted_then_refused(true, false) == true;
    assert admitted_then_refused(true, true) == false;
    assert admitted_then_refused(false, false) == false;
    assert admitted_then_refused(false, true) == false;
}

; The four measured fields side by side. Class and unit status are guarded twice and pinned;
; displacement and money are guarded twice and not pinned, which is the divergent state; body is
; not guarded at all.
test every_bounded_field_gets_the_guard_level_its_evidence_supports {
    assert guard_level(CLASS_API_CHECKS_VOCABULARY, CLASS_COLUMN_CHECKS_VOCABULARY, CLASS_IS_PINNED_TO_THE_COLUMN) == GUARD_BOTH_PINNED;
    assert guard_level(true, UNIT_STATUS_COLUMN_CHECK_EXISTS, UNIT_STATUS_IS_PINNED_TO_THE_COLUMN) == GUARD_BOTH_PINNED;
    assert guard_level(true, true, false) == GUARD_BOTH;
    assert guard_level(BODY_API_CHECKS_VOCABULARY, BODY_COLUMN_CHECKS_VOCABULARY, false) == GUARD_NONE;
    assert guard_level(true, false, false) == GUARD_API_ONLY;
    assert guard_level(false, true, false) == GUARD_COLUMN_ONLY;
    // A pin claimed without both checks does not lift the level: the pin is a proof that two
    // guards agree, and one guard cannot agree with an absent one.
    assert guard_level(true, false, true) == GUARD_API_ONLY;
    assert guard_level(false, false, true) == GUARD_NONE;
}

test only_an_unpinned_pair_of_guards_can_diverge {
    assert guards_can_diverge(GUARD_BOTH) == true;
    assert guards_can_diverge(GUARD_BOTH_PINNED) == false;
    assert guards_can_diverge(GUARD_API_ONLY) == false;
    assert guards_can_diverge(GUARD_COLUMN_ONLY) == false;
    assert guards_can_diverge(GUARD_NONE) == false;
}

test the_five_zero_refusing_columns_are_the_ones_the_migration_checks {
    assert ZERO_REFUSING_COLUMNS.len == ZERO_REFUSING_COLUMN_COUNT;
    assert ZERO_REFUSING_COLUMN_COUNT == 5;
    assert ZERO_REFUSING_COLUMNS[0] == "displacement_cc";
    assert ZERO_REFUSING_COLUMNS[4] == "sale_price_thb";
    assert WRITE_ADMITS_ZERO == true;
    assert COLUMN_ADMITS_ZERO == false;
    assert admitted_then_refused(WRITE_ADMITS_ZERO, COLUMN_ADMITS_ZERO) == true;
    assert write_reaches_storage(WRITE_ADMITS_ZERO, COLUMN_ADMITS_ZERO) == false;
}

test a_money_field_is_absent_or_a_real_non_negative_number {
    // Absent passes whatever the other bits say, because they describe a value that is not there.
    assert write_admits_money(false, false, true) == true;
    assert write_admits_money(false, true, false) == true;
    assert write_admits_money(true, true, false) == true;
    // Not finite: NaN and infinity are refused rather than filtered to absent.
    assert write_admits_money(true, false, false) == false;
    // Below zero.
    assert write_admits_money(true, true, true) == false;
    assert WRITE_SUBSTITUTES_A_NUMBER_FOR_ABSENCE == false;
}

test a_zero_money_value_passes_the_api_and_dies_at_the_column {
    assert money_reaches_storage(false, false, false, false) == true;
    assert money_reaches_storage(true, true, false, true) == true;
    // Supplied, finite, not negative, not positive: the value is zero.
    assert money_reaches_storage(true, true, false, false) == false;
    assert write_admits_money(true, true, false) == true;
    assert money_reaches_storage(true, false, false, true) == false;
    assert money_reaches_storage(true, true, true, false) == false;
}

test a_family_may_be_for_sale_with_no_asking_price {
    assert WRITE_COUPLES_FOR_SALE_TO_A_PRICE == false;
    assert FOR_SALE_WITHOUT_A_PRICE_TEST == "a_family_can_be_for_sale_with_no_asking_price";
    assert for_sale_write_admitted(true, false) == true;
    assert for_sale_write_admitted(true, true) == true;
    assert for_sale_write_admitted(false, false) == true;
    assert for_sale_write_admitted(false, true) == true;
}

test the_ten_text_ceiling_sites_rest_on_only_two_named_constants {
    assert WRITE_TEXT_MAX_CHARS == 4000;
    assert WRITE_TEXT_MAX_CHARS_FIELDS.len == WRITE_TEXT_MAX_CHARS_FIELD_COUNT;
    assert WRITE_TEXT_MAX_CHARS_FIELDS[0] == "description_ru";
    assert WRITE_TEXT_MAX_CHARS_FIELDS[1] == "description_en";
    assert NAMED_TEXT_CEILING_CONSTANT_COUNT == 2;
    assert NAMED_TEXT_CEILING_SITE_COUNT == 3;
    assert INLINE_TEXT_CEILING_SITE_COUNT == 7;
    assert NAMED_TEXT_CEILING_SITE_COUNT + INLINE_TEXT_CEILING_SITE_COUNT == TEXT_CEILING_SITE_COUNT;
    // More sites than constants, because MAX_TEXT_LEN serves both description fields.
    assert NAMED_TEXT_CEILING_SITE_COUNT > NAMED_TEXT_CEILING_CONSTANT_COUNT;
    assert NAMED_TEXT_CEILING_SITE_COUNT - WRITE_TEXT_MAX_CHARS_FIELD_COUNT == 1;
    assert WRITE_KEY_MAX_CHARS == 200;
    assert WRITE_CLASS_MAX_CHARS == 32;
    assert WRITE_BODY_MAX_CHARS == 64;
    assert WRITE_UNIT_CODE_MAX_CHARS == 64;
    assert WRITE_IMAGE_URL_MAX_CHARS == 2048;
}

test a_text_ceiling_is_inclusive_and_counted_in_characters {
    assert TEXT_CEILING_COUNTS_CHARACTERS == true;
    assert TEXT_CEILING_COUNTS_BYTES == false;
    assert COLUMN_HAS_A_TEXT_CEILING == false;
    assert CEILING_IS_APPLIED_AFTER_TRIM == true;
    assert text_within_ceiling(WRITE_TEXT_MAX_CHARS, WRITE_TEXT_MAX_CHARS) == true;
    assert text_within_ceiling(WRITE_TEXT_MAX_CHARS + 1, WRITE_TEXT_MAX_CHARS) == false;
    assert text_within_ceiling(0, WRITE_TEXT_MAX_CHARS) == true;
    assert text_within_ceiling(WRITE_BODY_MAX_CHARS, WRITE_BODY_MAX_CHARS) == true;
    assert text_within_ceiling(WRITE_BODY_MAX_CHARS + 1, WRITE_BODY_MAX_CHARS) == false;
}

; Required and optional give different answers to the same empty input, and that is the point:
; an absent optional is legal and stores nothing, an absent required is a rejection.
test an_empty_required_field_is_refused_and_an_empty_optional_one_is_absent {
    assert required_text_admitted(true, 200, WRITE_BRAND_MAX_CHARS) == true;
    assert required_text_admitted(false, 0, WRITE_BRAND_MAX_CHARS) == false;
    assert required_text_admitted(true, WRITE_BRAND_MAX_CHARS + 1, WRITE_BRAND_MAX_CHARS) == false;
    assert optional_text_admitted(false, 0, WRITE_TEXT_MAX_CHARS) == true;
    assert optional_text_is_stored(false, 0, WRITE_TEXT_MAX_CHARS) == false;
    assert optional_text_is_stored(true, 10, WRITE_TEXT_MAX_CHARS) == true;
    assert optional_text_admitted(true, WRITE_TEXT_MAX_CHARS + 1, WRITE_TEXT_MAX_CHARS) == false;
    assert optional_text_is_stored(true, WRITE_TEXT_MAX_CHARS + 1, WRITE_TEXT_MAX_CHARS) == false;
}

test the_family_key_is_written_on_create_and_never_on_update {
    assert FAMILY_KEY_IS_WRITE_ONCE == true;
    assert WRITE_MODE_COUNT == 2;
    assert family_key_is_persisted(WRITE_MODE_CREATE) == true;
    assert family_key_is_persisted(WRITE_MODE_UPDATE) == false;
    assert family_key_is_persisted(WRITE_MODE_NONE) == false;
    assert family_key_is_required(WRITE_MODE_CREATE) == true;
    assert family_key_is_required(WRITE_MODE_UPDATE) == false;
    assert FAMILY_KEY_IMMUTABILITY_REASON == "the family key is a live cart line's catalog_id (D8), so a rename orphans every line that holds one";
}

test no_write_mode_expresses_a_rename {
    assert rename_is_expressible(WRITE_MODE_CREATE, true) == false;
    assert rename_is_expressible(WRITE_MODE_CREATE, false) == false;
    assert rename_is_expressible(WRITE_MODE_UPDATE, true) == false;
    assert rename_is_expressible(WRITE_MODE_UPDATE, false) == false;
    assert rename_is_expressible(WRITE_MODE_NONE, true) == false;
    // And the honest limit: removing the row and creating another is not a rename either, because
    // the cart line D8 protects is orphaned by that path just the same.
    assert REMOVE_AND_RECREATE_IS_A_RENAME == false;
}

test the_unit_status_set_is_closed_and_its_copy_is_pinned {
    assert UNIT_STATUS_SET_IS_CLOSED == true;
    assert UNIT_STATUS_COLUMN_CHECK_EXISTS == true;
    assert UNIT_STATUS_API_VALIDATION_SITE_COUNT == 2;
    assert UNIT_STATUS_API_HANDLER_COUNT == 3;
    assert UNIT_STATUS_API_HANDLER_COUNT > UNIT_STATUS_API_VALIDATION_SITE_COUNT;
    assert UNIT_STATUS_IS_PINNED_TO_THE_COLUMN == true;
    assert UNIT_STATUS_PIN_TEST == "the_four_statuses_match_the_check_constraint";
    assert UNKNOWN_STATUS_IS_ABSORBED_DOWNSTREAM == false;
}

; Membership is somebody else's decision and arrives as a bit. This file never asks which four
; strings the set holds, which is exactly why adding a fifth upstream cannot make it wrong.
test a_status_outside_the_declared_set_reaches_no_column {
    assert unit_status_write_admitted(true) == true;
    assert unit_status_write_admitted(false) == false;
    assert unit_status_reaches_storage(true, true) == true;
    assert unit_status_reaches_storage(false, true) == false;
    assert unit_status_reaches_storage(true, false) == false;
    assert unit_status_reaches_storage(false, false) == false;
}

test nothing_on_the_write_path_checks_the_body_value {
    assert BODY_API_CHECKS_VOCABULARY == false;
    assert BODY_COLUMN_CHECKS_VOCABULARY == false;
    assert BODY_WRITE_CHECK_IS_LENGTH_ONLY == true;
    assert BODY_FORM_IS_THE_ONLY_GUARD == true;
    assert BODY_FORM_OPTION_COUNT == 6;
    // The same six options are typed into two controls, so "the form" is two forms.
    assert BODY_FORM_CONTROL_COUNT == 2;
    assert BODY_VOCABULARY_GUARD_IS_NOT_SHIPPED == true;
    // A style outside the vocabulary is not refused today, and would be by either guard.
    assert body_value_is_refused(BODY_API_CHECKS_VOCABULARY, BODY_COLUMN_CHECKS_VOCABULARY, false) == false;
    assert body_value_is_refused(true, false, false) == true;
    assert body_value_is_refused(false, true, false) == true;
    assert body_value_is_refused(true, true, false) == true;
    assert body_value_is_refused(false, false, true) == false;
}

; The shipped counter-example, so the tripwire above is a gap against something real rather than
; against an idea of how a guard should look.
test the_class_field_shows_what_a_guarded_vocabulary_looks_like {
    assert CLASS_API_CHECKS_VOCABULARY == true;
    assert CLASS_COLUMN_CHECKS_VOCABULARY == true;
    assert CLASS_IS_PINNED_TO_THE_COLUMN == true;
    assert body_value_is_refused(CLASS_API_CHECKS_VOCABULARY, CLASS_COLUMN_CHECKS_VOCABULARY, false) == true;
    assert guard_level(CLASS_API_CHECKS_VOCABULARY, CLASS_COLUMN_CHECKS_VOCABULARY, CLASS_IS_PINNED_TO_THE_COLUMN) > guard_level(BODY_API_CHECKS_VOCABULARY, BODY_COLUMN_CHECKS_VOCABULARY, false);
}

test the_refusals_are_named_and_not_filled_with_a_number {
    assert DISPLACEMENT_FLOOR_AGREEMENT_IS_NOT_SHIPPED == true;
    assert LONGEST_SUBMITTED_TEXT_IS_NOT_MEASURED == true;
    assert BODY_VOCABULARY_GUARD_IS_NOT_SHIPPED == true;
    assert DISPLACEMENT_FLOOR_AGREEMENT_NOTE != "";
    assert LONGEST_SUBMITTED_TEXT_NOTE != "";
    assert BODY_VOCABULARY_GUARD_NOTE != "";
}

; --- Invariants -----------------------------------------------------------------------------------

invariant the_write_ceiling_is_a_chosen_budget_and_not_a_fleet_measurement
  assert WRITE_DISPLACEMENT_CEILING_IS_CHOSEN == true and CATALOG_DECLINES_A_DISPLACEMENT_BOUND == true

invariant the_api_floor_sits_below_the_column_floor_and_the_gap_is_exactly_zero_cc
  assert WRITE_DISPLACEMENT_MIN_ADMITTED_CC < COLUMN_DISPLACEMENT_MIN_CC and displacement_is_admitted_then_refused(0) == true and displacement_is_admitted_then_refused(COLUMN_DISPLACEMENT_MIN_CC) == false

invariant a_displacement_above_the_ceiling_never_reaches_the_column
  assert write_admits_displacement(WRITE_DISPLACEMENT_MAX_CC + 1) == false and displacement_reaches_storage(WRITE_DISPLACEMENT_MAX_CC + 1) == false

invariant a_value_refused_by_the_api_is_never_counted_as_a_column_divergence
  assert admitted_then_refused(false, false) == false and admitted_then_refused(false, true) == false

invariant zero_is_admitted_by_the_api_and_refused_by_every_one_of_the_five_columns
  assert admitted_then_refused(WRITE_ADMITS_ZERO, COLUMN_ADMITS_ZERO) == true and ZERO_REFUSING_COLUMNS.len == ZERO_REFUSING_COLUMN_COUNT

invariant an_absent_money_field_is_never_turned_into_a_number
  assert WRITE_SUBSTITUTES_A_NUMBER_FOR_ABSENCE == false and write_admits_money(false, false, true) == true

invariant a_non_finite_or_negative_money_value_is_refused_rather_than_defaulted
  assert write_admits_money(true, false, false) == false and write_admits_money(true, true, true) == false

invariant the_sale_flag_never_forces_a_price_to_be_invented
  assert WRITE_COUPLES_FOR_SALE_TO_A_PRICE == false and for_sale_write_admitted(true, false) == true

invariant a_text_ceiling_admits_its_own_value_and_refuses_the_next_one
  assert text_within_ceiling(WRITE_TEXT_MAX_CHARS, WRITE_TEXT_MAX_CHARS) == true and text_within_ceiling(WRITE_TEXT_MAX_CHARS + 1, WRITE_TEXT_MAX_CHARS) == false

invariant every_text_ceiling_site_is_either_named_or_inline
  assert NAMED_TEXT_CEILING_SITE_COUNT + INLINE_TEXT_CEILING_SITE_COUNT == TEXT_CEILING_SITE_COUNT and NAMED_TEXT_CEILING_SITE_COUNT > NAMED_TEXT_CEILING_CONSTANT_COUNT

invariant the_text_ceiling_is_a_form_bound_and_never_a_storage_bound
  assert TEXT_CEILING_COUNTS_CHARACTERS == true and COLUMN_HAS_A_TEXT_CEILING == false

invariant an_empty_optional_field_is_stored_as_absent_and_not_as_an_empty_string
  assert optional_text_is_stored(false, 0, WRITE_TEXT_MAX_CHARS) == false and optional_text_admitted(false, 0, WRITE_TEXT_MAX_CHARS) == true

invariant the_family_key_is_persisted_by_exactly_one_write_mode
  assert family_key_is_persisted(WRITE_MODE_CREATE) == true and family_key_is_persisted(WRITE_MODE_UPDATE) == false and family_key_is_persisted(WRITE_MODE_NONE) == false

invariant no_argument_makes_a_rename_expressible
  assert rename_is_expressible(WRITE_MODE_UPDATE, true) == false and rename_is_expressible(WRITE_MODE_CREATE, true) == false

invariant a_status_outside_the_declared_set_is_refused_before_the_column_is_asked
  assert unit_status_write_admitted(false) == false and unit_status_reaches_storage(false, true) == false

invariant the_unit_status_copy_is_pinned_and_the_displacement_floor_is_not
  assert UNIT_STATUS_IS_PINNED_TO_THE_COLUMN == true and DISPLACEMENT_FLOOR_AGREEMENT_IS_NOT_SHIPPED == true

invariant the_body_value_is_guarded_by_nothing_a_hand_made_request_passes_through
  assert guard_level(BODY_API_CHECKS_VOCABULARY, BODY_COLUMN_CHECKS_VOCABULARY, false) == GUARD_NONE and body_value_is_refused(BODY_API_CHECKS_VOCABULARY, BODY_COLUMN_CHECKS_VOCABULARY, false) == false

invariant only_an_unpinned_pair_of_guards_is_allowed_to_diverge
  assert guards_can_diverge(GUARD_BOTH) == true and guards_can_diverge(GUARD_BOTH_PINNED) == false and guards_can_diverge(GUARD_NONE) == false

invariant this_file_names_its_owners_and_declares_none_of_their_vocabularies
  assert REUSES_CATALOG_ID != ID and REUSES_AVAILABILITY_ID != ID and REUSES_PRICING_ID != ID and REUSES_REQUEST_IDENTITY_ID != ID

invariant the_sender_of_a_write_is_never_this_files_subject
  assert WHO_MAY_WRITE_IS_NOT_THIS_FILES_SUBJECT == true and REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity"

invariant every_gap_this_file_found_is_named_rather_than_filled
  assert BODY_VOCABULARY_GUARD_IS_NOT_SHIPPED == true and DISPLACEMENT_FLOOR_AGREEMENT_IS_NOT_SHIPPED == true and LONGEST_SUBMITTED_TEXT_IS_NOT_MEASURED == true
