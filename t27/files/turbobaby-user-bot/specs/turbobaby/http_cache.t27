  assert DECISION == "D11";
}

; Provenance. The rule is a dated ruling in force; the census beside it is a measurement of
; another system; neither is the other and neither is about this repository. THE NAME OF THIS
; TEST CHANGED on 2026-09-21 and its subject did not: it was
; the_rule_is_the_owners_word_and_the_census_beside_it_is_somebody_elses_measurement, on an
; attribution the node never made. The third and fourth asserts are the correction, and the
; fifth keeps the withdrawn claim readable instead of letting it vanish.
test the_rule_is_a_dated_ruling_and_the_census_beside_it_is_somebody_elses_measurement {
  assert RULE_IS_A_RULING_IN_FORCE == true;
  assert RULE_IS_A_MEASUREMENT == false;
  assert RULE_AUTHOR_IS_NAMED_IN_THE_NODE == false;
  assert RULE_NODE_OWNER_WORD_MARKERS == 0;
  assert RULE_WAS_DECLARED_THE_OWNERS_DECISION_UNTIL == "2026-09-21";
  assert RULE_DECIDED_AT == "2026-08-13";
  assert RULE_READ_AT == "2026-09-21";
  assert RULE_CITATION_FORM == "brain:<node>:<line>";
  assert CENSUS_SOURCE == "brain:knowledge_base:875";
  assert CENSUS_DAYS == 73;
  assert CENSUS_IS_ABOUT_THIS_REPOSITORY == false;
  assert census_adds_up(CENSUS_ANSWERS_WITH_A_FIGURE, CENSUS_RECOMPUTED, CENSUS_FROM_CACHE) == true;
  assert census_adds_up(CENSUS_ANSWERS_WITH_A_FIGURE, CENSUS_RECOMPUTED, 0) == false;
  assert CENSUS_FROM_CACHE == 1;
  assert BRAIN_CITERS_IN_THE_CORPUS_ARE_COUNTED == false;
}

; The incident, with the one thing about it that is not published left unsaid.
