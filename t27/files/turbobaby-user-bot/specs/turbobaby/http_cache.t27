  assert BRAIN_NEAR_MISS_PARTIAL_WRITE_IS_AN_EVICTION_RULE == false;
  assert MAX_ENTRIES == NOT_A_COUNT;
  assert map_entries_are_bounded(ENTRY_LIMIT_IS_SET, EVICTION_RULE_EXISTS) == false;
  assert GROWTH_IS_ANNOUNCED == true;
}

; The second node agrees with what this file already measured, and states the general rule of
; which the section above is the temporal case. Four statements, two of them the owner's.
test the_owner_recomputes_rather_than_stores_and_names_absence_as_absence {
  assert SECOND_RULE_SOURCE == "brain:business_rules:71";
  assert SECOND_RULE_NODE_MOVED_AT == "2026-08-01";
  assert THE_OWNER_ALSO_RECOMPUTES_RATHER_THAN_STORES == true;
  assert ORIGIN_REMEMBERS_A_BODY == false;
  assert BODY_IS_REBUILT_PER_REQUEST == true;
  assert ABSENCE_RULE_SOURCE == "brain:business_rules:32-34";
  assert ABSENCE_RULE_OUTCOMES == 3;
  assert statement_census_adds_up(ABSENCE_RULE_STATEMENTS, ABSENCE_RULE_STATEMENTS_THE_OWNERS, ABSENCE_RULE_STATEMENTS_THIS_REPOSITORYS) == true;
  assert statement_census_adds_up(ABSENCE_RULE_STATEMENTS, ABSENCE_RULE_STATEMENTS_THE_OWNERS, 1) == false;
  assert SECOND_RULE_SOURCE != RULE_SOURCE;
}

test an_aged_availability_claim_is_not_a_confirmation {
  assert A_HELD_COPY_IS_A_LIVE_CHECK == false;
  assert served_copy_is_a_confirmation(true, 0) == true;
  assert served_copy_is_a_confirmation(true, 1) == false;
  assert served_copy_is_a_confirmation(true, 59) == false;
  assert served_copy_is_a_confirmation(false, 0) == false;
  assert WHAT_CONFIRMS_A_UNIT_COUNT_IS_OWNED_THERE == true;
}

test the_map_is_process_local_and_todays_coherence_is_a_deployment_fact {
  assert BACKING_STORE == "process memory";
  assert MAP_CONSTRUCTIONS_IN_THE_BINARY == 1;
  assert SHARED_STORE_DEPENDENCIES == 0;
  assert STORE_IS_SHARED_ACROSS_PROCESSES == false;
  assert DECLARED_REGIONS == 1;
  assert DECLARED_REPLICAS == 1;
  assert COHERENCE_IS_A_DEPLOYMENT_FACT == true;
  assert map_is_coherent_across_the_fleet(DECLARED_REPLICAS, STORE_IS_SHARED_ACROSS_PROCESSES) == true;
  assert map_is_coherent_across_the_fleet(2, false) == false;
  assert map_is_coherent_across_the_fleet(2, true) == true;
}

test a_cold_replica_costs_bandwidth_and_never_correctness {
  assert replica_miss_can_serve_a_wrong_body(BODY_IS_REBUILT_PER_REQUEST) == false;
  assert replica_miss_can_serve_a_wrong_body(false) == true;
  assert outcome_on_a_cold_replica(true, true) == OUTCOME_FULL_BODY;
  assert outcome_on_a_cold_replica(false, false) == OUTCOME_FULL_BODY;
  assert outcome_kind(true, true, true) == OUTCOME_NOT_MODIFIED;
}

test an_edit_surface_is_never_cached {
  assert ADMIN_EDIT_SURFACE_IS_CACHED == false;
  assert surface_may_be_cached(true) == false;
  assert surface_may_be_cached(false) == true;
}

; --- Invariants --------------------------------------------------------------------------------

invariant the_origin_never_holds_a_body
  assert ORIGIN_REMEMBERS_A_BODY == false and ORIGIN_REMEMBERS_A_DIGEST == true and BODY_IS_REBUILT_PER_REQUEST == true

invariant the_tag_is_derived_from_the_body_and_from_nothing_else
  assert tag_depends_only_on_the_body(TAG_HASHES_THE_BODY, TAG_HASHES_THE_KEY, TAG_HASHES_A_HEADER) == true and tag_depends_only_on_the_body(true, true, false) == false and tag_depends_only_on_the_body(true, false, true) == false

invariant the_whole_digest_is_kept_and_nothing_is_discarded
  assert tag_bits_kept(TAG_KEPT_BYTES) == 256 and tag_hex_chars(TAG_KEPT_BYTES) == 64 and tag_bytes_discarded(DIGEST_BYTES, TAG_KEPT_BYTES) == 0 and TAG_KEPT_BYTES == DIGEST_BYTES

; The old width, held as an invariant so the repair cannot be undone quietly: a return to eight
; bytes makes the two constants equal and this fails.
invariant the_shipped_width_is_not_the_width_that_was_repaired
  assert TAG_KEPT_BYTES != TAG_KEPT_BYTES_BEFORE_REPAIR and tag_bits_kept(TAG_KEPT_BYTES_BEFORE_REPAIR) == 64 and tag_bytes_discarded(DIGEST_BYTES, TAG_KEPT_BYTES_BEFORE_REPAIR) == 24

invariant no_collision_rate_is_stated_and_the_consequence_is
  assert COLLISION_RATE_IS_MEASURED == false and changed_body_reads_as_unchanged(true, true) == true and origin_can_confirm_a_stale_body(true, false, true) == true

invariant a_short_answer_requires_all_three_conditions
  assert may_answer_not_modified(false, true, true) == false and may_answer_not_modified(true, false, true) == false and may_answer_not_modified(true, true, false) == false and may_answer_not_modified(true, true, true) == true

invariant rehashing_alone_keeps_the_origin_honest_about_a_changed_body
  assert origin_can_confirm_a_stale_body(true, false, false) == false and origin_can_confirm_a_stale_body(false, false, false) == true

invariant not_one_invalidator_names_a_live_key
  assert INVALIDATORS_NAMING_A_LIVE_KEY == 0 and a_write_can_clear_this_key(false, true) == false and INVALIDATOR_FUNCTIONS == 4

invariant no_entry_carries_a_timer_so_only_restart_or_removal_ends_one
  assert ENTRY_HAS_A_TIMER == false and entry_is_gone(false, false) == false and entry_is_gone(true, false) == true and entry_is_gone(false, true) == true

invariant no_entry_ceiling_is_invented
  assert ENTRY_LIMIT_IS_SET == false and EVICTION_RULE_EXISTS == false and MAX_ENTRIES == NOT_A_COUNT and map_entries_are_bounded(ENTRY_LIMIT_IS_SET, EVICTION_RULE_EXISTS) == false

; Unbounded and unseen are two states, and only the second one was fixed. An announcement must
; never be read as a bound: both halves are asserted together so neither can drift into the other.
invariant growth_is_visible_and_still_unbounded
  assert growth_is_observable(ENTRY_LIMIT_IS_SET, EVICTION_RULE_EXISTS, GROWTH_IS_ANNOUNCED) == true and map_entries_are_bounded(ENTRY_LIMIT_IS_SET, EVICTION_RULE_EXISTS) == false and GROWTH_NOTICE_IS_A_CEILING == false and MAX_ENTRIES == NOT_A_COUNT

invariant the_key_space_is_not_bounded_by_the_fleet
  assert key_space_is_bounded_by_the_fleet(CC_BOUND_IS_CAPPED, CLASS_VALUE_SET_IS_CLOSED) == false and CC_BOUND_IS_CAPPED == false

invariant nothing_forces_a_client_to_ask_inside_the_budget
  assert client_may_reuse_without_asking(59, CATALOG_MAX_AGE_SECONDS, MUST_REVALIDATE_IS_SET) == true and conditional_request_is_reached(59, CATALOG_MAX_AGE_SECONDS, MUST_REVALIDATE_IS_SET) == false and last_reusable_age_seconds(CATALOG_MAX_AGE_SECONDS) == 59

invariant the_origin_cannot_recall_a_copy_a_client_already_holds
  assert REMOVING_A_KEY_RECALLS_A_HELD_COPY == false and held_copy_is_recallable(MUST_REVALIDATE_IS_SET) == false

invariant an_aged_number_is_never_the_authority_and_never_a_confirmation
  assert price_in_a_served_body_is_authoritative(true, 1) == false and served_copy_is_a_confirmation(true, 1) == false and A_CACHE_MAY_BECOME_THE_PRICE_AUTHORITY == false and A_HELD_COPY_IS_A_LIVE_CHECK == false

invariant an_undecided_age_policy_never_returns_acceptable
  assert ACCEPTABLE_PRICE_AGE_IS_DECIDED == false and age_verdict(ACCEPTABLE_PRICE_AGE_IS_DECIDED, 0, 0) == AGE_UNDECIDED and age_verdict(false, 59, 60) == AGE_UNDECIDED and acceptable_price_age_seconds() == NOT_A_DURATION_SECONDS

invariant the_stale_price_window_arms_itself_the_day_the_door_is_wired
  assert stale_door_price_is_reachable(DOOR_IS_WIRED, CATALOG_MAX_AGE_SECONDS) == false and stale_door_price_is_reachable(true, CATALOG_MAX_AGE_SECONDS) == true and DOOR_IS_WIRED == false

invariant coherence_is_claimed_for_one_replica_only_and_never_for_the_code
  assert map_is_coherent_across_the_fleet(2, false) == false and map_is_coherent_across_the_fleet(DECLARED_REPLICAS, STORE_IS_SHARED_ACROSS_PROCESSES) == true and STORE_IS_SHARED_ACROSS_PROCESSES == false and COHERENCE_IS_A_DEPLOYMENT_FACT == true

invariant a_cold_replica_never_serves_a_wrong_body
  assert replica_miss_can_serve_a_wrong_body(BODY_IS_REBUILT_PER_REQUEST) == false and outcome_on_a_cold_replica(true, true) == OUTCOME_FULL_BODY

invariant an_edit_surface_is_never_cached_at_all
  assert surface_may_be_cached(true) == false and ADMIN_EDIT_SURFACE_IS_CACHED == false

invariant this_file_declares_no_wire_number
  assert THIS_FILE_DECLARES_NO_HTTP_STATUS == true and OUTCOME_NOT_MODIFIED == 1 and OUTCOME_FULL_BODY == 2 and REUSES_CATALOG_API_ID == "turbobaby/catalog-api"

; A figure from a cache travels with both halves of its label or it does not travel. Both permitted
; time labels are asserted here, because dropping the dateless one is precisely how the published
; rule would quietly become the stricter thing it is not.
invariant an_unreconciled_figure_never_reaches_a_reader_bare
  assert figure_may_be_shown(FIGURE_UNRECONCILED, true, TIME_LABEL_NONE) == false and figure_may_be_shown(FIGURE_UNRECONCILED, false, TIME_LABEL_DATED) == false and figure_may_be_shown(FIGURE_UNRECONCILED, true, TIME_LABEL_DATED) == true and figure_may_be_shown(FIGURE_UNRECONCILED, true, TIME_LABEL_UNKNOWN) == true

invariant a_withheld_figure_is_replaced_by_nothing_and_never_by_a_zero
  assert figure_may_be_shown(FIGURE_WITHHELD, true, TIME_LABEL_DATED) == false and figure_may_be_shown(FIGURE_WITHHELD, false, TIME_LABEL_NONE) == false and zero_may_stand_in_for_a_withheld_figure() == false and ZERO_STANDS_IN_FOR_A_WITHHELD_FIGURE == false

invariant an_unknown_time_is_never_dressed_as_a_recent_one
  assert time_label(false) == TIME_LABEL_UNKNOWN and time_label(false) != TIME_LABEL_PROBABLY_RECENT and time_label(true) != TIME_LABEL_PROBABLY_RECENT and time_label_is_permitted(TIME_LABEL_PROBABLY_RECENT) == false

invariant a_label_never_promotes_a_figure_to_the_authority
  assert served_figure_is_authoritative(FIGURE_UNRECONCILED, true, 0) == false and served_figure_is_authoritative(FIGURE_RECOMPUTED, true, 1) == false and served_figure_is_authoritative(FIGURE_RECOMPUTED, true, 0) == true and A_CACHE_MAY_BECOME_THE_PRICE_AUTHORITY == false

; The published rule answered the label question and not the ceiling question. Both halves are
; asserted together so that neither can drift into the other later.
invariant the_seconds_ceiling_stays_refused_while_the_label_rule_is_published
  assert A_SECONDS_CEILING_IS_PUBLISHED == false and ACCEPTABLE_PRICE_AGE_IS_DECIDED == false and ACCEPTABLE_PRICE_AGE_SECONDS == NOT_A_DURATION_SECONDS and A_LABEL_RULE_IS_PUBLISHED == true and AGE_RULE_REFUSAL_WAS_TRUE_OF_THIS_REPOSITORY == true

; The rule and the measurement beside it never merge, and the rule never re-acquires an author
; the node does not give it. Until 2026-09-21 the first term of this invariant read
; RULE_IS_THE_OWNERS_DECISION == true; the attribution was withdrawn by review and the guard
; against merging the two kinds of fact stayed where it was.
invariant the_ruling_never_merges_with_the_measurement_beside_it
  assert RULE_IS_A_RULING_IN_FORCE == true and RULE_IS_A_MEASUREMENT == false and RULE_AUTHOR_IS_NAMED_IN_THE_NODE == false and CENSUS_IS_ABOUT_THIS_REPOSITORY == false and census_adds_up(CENSUS_ANSWERS_WITH_A_FIGURE, CENSUS_RECOMPUTED, CENSUS_FROM_CACHE) == true

invariant the_derived_withhold_is_never_read_back_as_the_owners_word
  assert body_can_carry_the_published_label(BODY_CARRIES_A_SOURCE_FIELD, BODY_CARRIES_A_TIME_FIELD) == false and outcome_this_transport_can_honestly_produce(false, true, false) == FIGURE_WITHHELD and WITHHOLD_WITHOUT_A_LABEL_FIELD_IS_DERIVED_HERE == true and THE_OWNER_PUBLISHED_A_WITHHOLD_FOR_A_MISSING_DATE == false and THE_OWNER_PUBLISHED_A_WITHHOLD_FOR_NO_CACHE == true

invariant neither_source_publishes_a_ceiling_or_an_eviction_rule
  assert BRAIN_PUBLISHES_AN_ENTRY_CEILING == false and BRAIN_PUBLISHES_AN_EVICTION_RULE == false and ENTRY_LIMIT_IS_SET == false and EVICTION_RULE_EXISTS == false and MAX_ENTRIES == NOT_A_COUNT and BRAIN_NEAR_MISS_IS_A_CACHE_TTL == false and BRAIN_NEAR_MISS_PARTIAL_WRITE_IS_AN_EVICTION_RULE == false

invariant the_figure_vocabulary_and_the_response_vocabulary_share_no_value
  assert FIGURE_RECOMPUTED != OUTCOME_NOT_MODIFIED and FIGURE_RECOMPUTED != OUTCOME_FULL_BODY and FIGURE_UNRECONCILED != OUTCOME_NOT_MODIFIED and FIGURE_UNRECONCILED != OUTCOME_FULL_BODY and FIGURE_WITHHELD != OUTCOME_NOT_MODIFIED and FIGURE_WITHHELD != OUTCOME_FULL_BODY
