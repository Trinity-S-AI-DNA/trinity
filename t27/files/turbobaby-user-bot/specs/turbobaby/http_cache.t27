}

test all_three_conditions_are_required_for_the_short_answer {
  assert outcome_kind(true, true, true) == OUTCOME_NOT_MODIFIED;
  assert outcome_kind(false, true, true) == OUTCOME_FULL_BODY;
  assert outcome_kind(true, false, true) == OUTCOME_FULL_BODY;
  assert outcome_kind(true, true, false) == OUTCOME_FULL_BODY;
  assert may_answer_not_modified(false, false, false) == false;
}

test rehashing_closes_the_stale_confirmation_except_on_a_collision {
  assert origin_can_confirm_a_stale_body(true, false, false) == false;
  assert origin_can_confirm_a_stale_body(true, true, false) == false;
