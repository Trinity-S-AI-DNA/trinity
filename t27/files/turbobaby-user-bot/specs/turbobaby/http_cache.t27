  assert BODY_SOURCE_FIELD_VALUE_COUNT == 2;
  assert BODY_SOURCE_FIELD_VALUES[0] == "door";
  assert BODY_SOURCE_FIELD_VALUES[1] == "unavailable";
  assert RULE_NEEDS_A_SOURCE_VALUE_THAT_DOES_NOT_EXIST_YET == true;
  assert body_can_carry_the_published_label(BODY_CARRIES_A_SOURCE_FIELD, BODY_CARRIES_A_TIME_FIELD) == false;
  assert body_can_carry_the_published_label(true, true) == true;
  assert body_can_carry_the_published_label(false, true) == false;
  assert WITHHOLD_WITHOUT_A_LABEL_FIELD_IS_DERIVED_HERE == true;
  assert THE_OWNER_PUBLISHED_A_WITHHOLD_FOR_NO_CACHE == true;
  assert outcome_this_transport_can_honestly_produce(true, false, false) == FIGURE_RECOMPUTED;
  assert outcome_this_transport_can_honestly_produce(false, true, false) == FIGURE_WITHHELD;
  assert outcome_this_transport_can_honestly_produce(false, true, true) == FIGURE_UNRECONCILED;
  assert outcome_this_transport_can_honestly_produce(false, false, true) == FIGURE_WITHHELD;
}

