  assert origin_can_confirm_a_stale_body(false, true, false) == false;
  assert origin_can_confirm_a_stale_body(true, false, true) == true;
  assert changed_body_reads_as_unchanged(true, true) == true;
  assert changed_body_reads_as_unchanged(true, false) == false;
  assert changed_body_reads_as_unchanged(false, true) == false;
  assert COLLISION_RATE_IS_MEASURED == false;
}

