  assert client_may_reuse_without_asking(0, CATALOG_MAX_AGE_SECONDS, MUST_REVALIDATE_IS_SET) == true;
  assert client_may_reuse_without_asking(59, CATALOG_MAX_AGE_SECONDS, MUST_REVALIDATE_IS_SET) == true;
  assert client_may_reuse_without_asking(60, CATALOG_MAX_AGE_SECONDS, MUST_REVALIDATE_IS_SET) == false;
  assert client_may_reuse_without_asking(0, CATALOG_MAX_AGE_SECONDS, true) == false;
  assert last_reusable_age_seconds(CATALOG_MAX_AGE_SECONDS) == 59;
  assert conditional_request_is_reached(0, CATALOG_MAX_AGE_SECONDS, false) == false;
  assert conditional_request_is_reached(60, CATALOG_MAX_AGE_SECONDS, false) == true;
  assert conditional_request_is_reached(0, CATALOG_MAX_AGE_SECONDS, true) == true;
}

