; The half the second brief got backwards, executable so it cannot drift back. No date is not no
; label: a dateless figure is served and says the time is unknown, and the sentence it must never
; say has a name here so a test can refuse it.
test a_dateless_figure_is_still_served_and_says_the_time_is_unknown {
  assert time_label(true) == TIME_LABEL_DATED;
  assert time_label(false) == TIME_LABEL_UNKNOWN;
  assert time_label(false) != TIME_LABEL_PROBABLY_RECENT;
  assert time_label(true) != TIME_LABEL_PROBABLY_RECENT;
  assert time_label_is_permitted(TIME_LABEL_DATED) == true;
  assert time_label_is_permitted(TIME_LABEL_UNKNOWN) == true;
  assert time_label_is_permitted(TIME_LABEL_NONE) == false;
  assert time_label_is_permitted(TIME_LABEL_PROBABLY_RECENT) == false;
  assert figure_may_be_shown(FIGURE_UNRECONCILED, true, TIME_LABEL_UNKNOWN) == true;
  assert THE_OWNER_PUBLISHED_A_WITHHOLD_FOR_A_MISSING_DATE == false;
  assert MUST_NOT_SAY == "probably recent";
  assert SAY_TIME_UNKNOWN == "time unknown";
}

; What may reach a reader, and the one thing that may not stand in for what may not.
test an_unreconciled_figure_travels_with_both_halves_of_its_label_or_not_at_all {
  assert figure_may_be_shown(FIGURE_UNRECONCILED, true, TIME_LABEL_DATED) == true;
  assert figure_may_be_shown(FIGURE_UNRECONCILED, false, TIME_LABEL_DATED) == false;
  assert figure_may_be_shown(FIGURE_UNRECONCILED, true, TIME_LABEL_NONE) == false;
  assert figure_may_be_shown(FIGURE_UNRECONCILED, true, TIME_LABEL_PROBABLY_RECENT) == false;
  assert figure_may_be_shown(FIGURE_RECOMPUTED, false, TIME_LABEL_NONE) == true;
  assert figure_may_be_shown(FIGURE_WITHHELD, true, TIME_LABEL_DATED) == false;
  assert figure_may_be_shown(FIGURE_WITHHELD, false, TIME_LABEL_NONE) == false;
  assert zero_may_stand_in_for_a_withheld_figure() == false;
  assert ZERO_STANDS_IN_FOR_A_WITHHELD_FIGURE == false;
  assert SAY_NOT_RECONCILED == "not reconciled";
  assert LABEL_WORDING_IS_OWNED_HERE == false;
}

; A label makes a number honest; it does not make it the door's answer now. D11 is untouched and
; the neighbour that owns it is named by ID.
test a_labelled_figure_is_honest_and_is_still_not_the_authority {
  assert served_figure_is_authoritative(FIGURE_RECOMPUTED, true, 0) == true;
  assert served_figure_is_authoritative(FIGURE_RECOMPUTED, true, 1) == false;
  assert served_figure_is_authoritative(FIGURE_RECOMPUTED, false, 0) == false;
  assert served_figure_is_authoritative(FIGURE_UNRECONCILED, true, 0) == false;
