; The rule is published and this transport cannot obey it: the body says where a number came from
; and has nowhere to say when it was true. The withhold that follows is this file's derivation and
; is labelled as one.
test the_body_can_say_what_a_number_is_and_not_when_it_was_true {
  assert BODY_CARRIES_A_SOURCE_FIELD == true;
  assert BODY_CARRIES_A_TIME_FIELD == false;
