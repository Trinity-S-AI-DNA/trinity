  assert CONTRACTS_MENTIONING_AN_ENTITY_TAG == 2;
  assert CONTRACTS_DECLARING_A_MAX_AGE == 2;
  assert OTHER_MAX_AGE_OWNER_ID == "turbobaby/request-identity";
  assert OTHER_ENTITY_TAG_MENTIONER_ID == "turbobaby/catalog-api";
  assert OTHER_ENTITY_TAG_MENTIONER_ID == REUSES_CATALOG_API_ID;
  assert OTHER_MAX_AGE_OWNER_ID != ID;
  assert OTHER_ENTITY_TAG_MENTIONER_ID != ID;
}

test the_owner_contracts_are_named_and_none_of_them_is_restated {
  assert REUSES_CATALOG_API_ID == "turbobaby/catalog-api";
  assert REUSES_PRICING_HONESTY_ID == "turbobaby/pricing-honesty";
  assert REUSES_AVAILABILITY_ID == "turbobaby/availability";
  assert REUSES_LEGACY_RETIREMENT_ID == "turbobaby/legacy-retirement";
  assert NEIGHBOUR_RATE_LIMIT_ID == "turbobaby/rate-limit";
  assert REUSES_CATALOG_API_ID != ID;
  assert REUSES_PRICING_HONESTY_ID != ID;
  assert REUSES_AVAILABILITY_ID != ID;
  assert REUSES_LEGACY_RETIREMENT_ID != ID;
  assert NEIGHBOUR_RATE_LIMIT_ID != ID;
  assert REUSES_CATALOG_API_ID != REUSES_PRICING_HONESTY_ID;
  assert REUSES_AVAILABILITY_ID != REUSES_LEGACY_RETIREMENT_ID;
  assert REUSE_EDGE_COUNT == 5;
  assert THIS_FILE_DECLARES_NO_HTTP_STATUS == true;
}

test the_local_outcome_discriminants_are_not_wire_numbers {
  assert OUTCOME_NOT_MODIFIED == 1;
  assert OUTCOME_FULL_BODY == 2;
  assert OUTCOME_KIND_COUNT == 2;
  assert OUTCOME_NOT_MODIFIED != OUTCOME_FULL_BODY;
  assert THE_CONDITIONAL_OUTCOME_IS_OWNED_THERE == true;
}

test the_tag_is_the_whole_digest_of_the_body_alone {
  assert HASH_ALGORITHM == "sha256";
  assert DIGEST_BYTES == 32;
  assert TAG_KEPT_BYTES == 32;
  assert TAG_KEPT_BYTES == DIGEST_BYTES;
  assert tag_bits_kept(TAG_KEPT_BYTES) == 256;
  assert tag_hex_chars(TAG_KEPT_BYTES) == 64;
  assert tag_bytes_discarded(DIGEST_BYTES, TAG_KEPT_BYTES) == 0;
  assert tag_depends_only_on_the_body(TAG_HASHES_THE_BODY, TAG_HASHES_THE_KEY, TAG_HASHES_A_HEADER) == true;
  assert tag_depends_only_on_the_body(true, true, false) == false;
  assert tag_depends_only_on_the_body(true, false, true) == false;
  assert tag_depends_only_on_the_body(false, false, false) == false;
}

; The width the tag had until 2026-09-21, kept executable rather than described. The same three
; functions answer it, which is what makes the two states comparable at all.
test the_old_width_is_still_readable_and_is_no_longer_the_shipped_one {
  assert TAG_KEPT_BYTES_BEFORE_REPAIR == 8;
  assert TAG_WIDTH_REPAIRED_AT == "2026-09-21";
  assert tag_bits_kept(TAG_KEPT_BYTES_BEFORE_REPAIR) == 64;
  assert tag_hex_chars(TAG_KEPT_BYTES_BEFORE_REPAIR) == 16;
  assert tag_bytes_discarded(DIGEST_BYTES, TAG_KEPT_BYTES_BEFORE_REPAIR) == 24;
  assert TAG_KEPT_BYTES != TAG_KEPT_BYTES_BEFORE_REPAIR;
  assert IMPLEMENTATION_LINES_BEFORE_REPAIR == 150;
  assert IMPLEMENTATION_UNIT_TESTS_BEFORE_REPAIR == 5;
  assert IMPLEMENTATION_LINES > IMPLEMENTATION_LINES_BEFORE_REPAIR;
  assert IMPLEMENTATION_UNIT_TESTS > IMPLEMENTATION_UNIT_TESTS_BEFORE_REPAIR;
}

test a_shared_tag_across_keys_means_identical_bytes_and_nothing_worse {
  assert two_keys_can_share_a_tag(true) == true;
  assert two_keys_can_share_a_tag(false) == false;
  assert may_answer_not_modified(true, true, true) == true;
  assert may_answer_not_modified(true, false, true) == false;
}

test the_origin_stores_a_digest_and_never_a_body {
