# Trinity TRI-NET SSOT -- how an accepted .t27 spec becomes minted TRI on-chain
# Companion of record: specs/trinet/settlement_law.t27 (what earns a credit),
#                      docs/docs/depin/minting.md (the human-readable design).
# Status: DESIGN. Nothing here is deployed. No contract, key or mint exists yet.

spec MintOnAcceptance version 0.1.0

description """
The settlement law says who has earned a TRI. This spec says how that earning
becomes a real, transferable token on TON and Solana -- without a pre-mine,
because 100% of $TRI is mined by accepted work.

The problem in one sentence: a blockchain cannot run t27c, so the chain cannot
itself check that a spec was accepted. Every honest design for this is therefore
about WHO the chain trusts to say "this work was accepted", and how wrong that
party can be. This spec makes that trust assumption explicit and versions it
from "an attestor quorum we run" toward "a proof anyone can check", rather than
pretending the first is the last.

Genesis minted supply is ZERO. The only mint path is a valid acceptance
attestation. The cap is 3^21 and is enforced on-chain.
"""

constants {
  CAP_TRI 10460353203          // 3^21 WHOLE TRI, the Trinity identity
  MTRI_PER_TRI 1000            // every amount on the wire and on-chain is mTRI
  DECIMALS 3                   // the jetton / SPL base unit IS the ledger's mTRI
  CAP_MTRI 10460353203000      // the cap as enforced on-chain; fits u64
  GENESIS_MINTED 0             // no pre-mine, no allocation, no sale
  CHAINS "TON, Solana"        // one canonical supply, mirrored (see BRIDGE)
}

// ---------------------------------------------------------------------------
// The flow, off-chain to on-chain
// ---------------------------------------------------------------------------

flow ACCEPTANCE_TO_MINT {
  step_1 "a worker gets a .t27 spec accepted, or a node returns a correct receipt-backed job (specs/trinet/settlement_law.t27)"
  step_2 "the coordinator's ledger records the earning as it does today (src/trinet/ledger.zig)"
  step_3 "attestors sign an ACCEPTANCE_ATTESTATION binding worker, work, amount, chain and a unique nonce"
  step_4 "anyone submits the signed attestation to the mint contract on the chosen chain"
  step_5 "the contract verifies the quorum and the unspent nonce, checks the cap, and mints to the worker"
  invariant "no attestation => no mint; a spent nonce => no mint; over-cap => no mint"
}

message ACCEPTANCE_ATTESTATION {
  fields "(worker_address, work_id, chain_id, amount_mtri, global_nonce, epoch)"
  work_id "hash of the accepted spec/job and its receipt -- ties the mint to specific verified work, not a bare number"
  global_nonce "unique across BOTH chains; the mint contracts share a spent-nonce view via BRIDGE so one earning cannot be minted twice"
  signed_by "M of N attestor keys (EIP-712 style typed data on Solana/EVM; a cell hash signature on TON)"
  mirrors "the settlement law's own anti-replay and anti-identity-theft rules -- a tag never decides whose account a credit belongs in"
}

// ---------------------------------------------------------------------------
// Who the chain trusts -- versioned honestly, weakest-but-shippable first
// ---------------------------------------------------------------------------

trust_model ATTESTOR_QUORUM_V1 {
  mechanism   "M-of-N attestor signatures; the contract's only mint authority is a valid quorum"
  trust       "an honest MAJORITY of the attestor set. This is NOT trustless -- a colluding quorum could mint without work."
  honest_limit "as decentralised as its attestor set and no more; label it that way in public, never 'trustless'"
  shippable   true
  status      "[design; the version to build first]"
}

trust_model OPTIMISTIC_CHALLENGE_V2 {
  mechanism   "an acceptance is posted with a bond and mints after a challenge window unless a challenger re-runs t27c off-chain and submits a fraud proof"
  trust       "at least one honest challenger watching, plus a bond that makes a false claim lose money"
  status      "[design; reduces trust from a quorum to one honest watcher]"
}

trust_model RECEIPT_PROOF_V3 {
  mechanism   "acceptance produces a succinct proof (zk) that t27c accepted the spec / the board signed the receipt, verified on-chain"
  trust       "the proof system only; no attestor, no challenger"
  blocker     "proving a real Rust compiler run in a zkVM is a research project; the FPGA receipt path may be nearer, since the board already signs"
  status      "[research; the honest end state, not a near-term promise]"
}

// ---------------------------------------------------------------------------
// One token on two chains
// ---------------------------------------------------------------------------

rule BRIDGE_KEEPS_ONE_SUPPLY {
  name    "TON and Solana are one token, not two"
  formula "sum of minted supply across all chains <= CAP_TRI, and every global_nonce is spent at most once across all chains"
  how     "the attestor set signs for a specific chain_id and shares one spent-nonce set; a lock-and-mint bridge moves an existing balance between chains without minting new supply"
  why     "without this, the same earning mints on both chains and the cap is a fiction"
  trust_tier CONJECTURAL
}

// ---------------------------------------------------------------------------
// What this replaces, and what it must never reintroduce
// ---------------------------------------------------------------------------

finding EXISTING_CONTRACT_IS_A_PREMINE {
  severity HIGH
  resolved false
  statement """
    trinity/t13/deploy/.../src/TrinityToken.sol mints all 40/20/20/10/10
    allocations at deploy and vests them. That is the pre-mine model the owner
    deleted on 2026-09-24. It cannot be patched into a mined token -- its whole
    structure is allocation plus vesting -- so it is SUPERSEDED, not amended.
  """
  action "the mint-on-acceptance contract starts from genesis supply 0 and has no allocation addresses, no vesting, no founder/treasury/liquidity mint"
}

open_question KEY_CUSTODY_AND_ATTESTOR_SET {
  do_not_guess true
  owner author
  question "who holds the N attestor keys, what M is, and how a key is rotated or removed. This decides how honest V1 actually is, and it is a governance choice, not a code default."
}

open_question CROSS_CHAIN_DOUBLE_MINT {
  do_not_guess true
  owner author
  question "the exact mechanism by which the TON and Solana minters share ONE ledger (spent nonces AND minted total) in real time. A naive per-chain nonce set double-mints across chains; a per-chain minted total lets the chains together mint up to 2x the cap. Until this is answered exactly one minter is deployed (TON, the chain of record)."
}

scope_limits {
  not_covered { "deployment of any contract", "custody of any key", "any real mint", "a security audit", "legal review of issuance and secondary trading" }
  these_are "the owner's and counsel's actions, gated and out of scope for this design"
  superiority_claimed false
}
