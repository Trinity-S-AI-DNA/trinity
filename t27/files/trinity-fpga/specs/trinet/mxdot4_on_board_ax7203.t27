// SPDX-License-Identifier: Apache-2.0
; specs/trinet/mxdot4_on_board_ax7203.t27 -- one 32-element block dot product, MXFP4 and TNF4, on the ALINX AX7203
; The one source for the block-dot cell. conformance/mxdot4_board_from_spec.mjs compiles this file
; with the t27 compiler (wasm), evaluates every test block below against the constants, and writes
; fpga/tnet/mxdot4_board_params.v (RTL macros) and conformance/mxdot4_board_params.py (host,
; vectors, golden). No number below is typed a second time anywhere; `--check` fails on drift.
; ASCII only, English only.

; WHY. The owner, 2026-09-27: TNF against MXFP4, on the block. The publication stop rule is that
; TNF must beat MXFP4 on the block axis. Quality on that axis is already measured on main
; (research/block/BLOCK_AXIS_VERDICT_2026-08-10.md: SmolLM2-135M perplexity, MXFP4 21.9397 against
; TNF4 36.7214; conformance/block_axis_tef_vs_mxfp4.py, re-run offline 2026-09-27 on its synthetic
; sets: per-block relative error 0.234 and 0.345 for MXFP4 against 0.834 and 0.866 for TNF(1,1)).
; No block datapath for TNF exists, and no block-level cost figure for TNF against MXFP4.

; THE TWO LEVEL SETS. TNF4 here is the verdict's: research/block/block_tnf.py tnf_levels(4, 1),
; seven magnitudes of eight codes. Scaled so both tops are 12, it is E2M1 with the level 1 (the
; E2M1 subnormal, 0.5) removed, and nothing added. Under one E8M0 scale rule, rounding to a subset
; of a level set can never give a smaller error on any element. So this cell cannot move the
; quality verdict and is not built to: it prices the two datapaths and checks both bit-exact.

; WHAT A PASS SAYS. This RTL computes the exact 32-element block dot product, element codes and
; E8M0 scales in, (sum, exponent, NaN) out, for both formats, on this board, for every request
; listed here, against a golden built on conformance/mxfp_ref.py and block_tnf.py.
; WHAT IT DOES NOT SAY. Nothing about accuracy: the result is exact by construction, so the only
; difference between the formats is which values the elements can hold. The core's LUT count on
; the board sits beside a UART; the cost figures come from core-only synthesis, one per format.

module trinet_mxdot4_on_board_ax7203;

pub const KIND : str = "board-cell";
pub const ID : str = "trinet/mxdot4_on_board_ax7203";
pub const GENERATED : [2]str = ["fpga/tnet/mxdot4_board_params.v", "conformance/mxdot4_board_params.py"];

; --- Board ------------------------------------------------------------------------------
pub const BOARD : str = "ALINX AX7203";
pub const PART : str = "xc7a200tfbg484-2";
pub const IDCODE : u32 = 325279891;
pub const TOP : str = "mxdot4_board_ax7203";
pub const XDC : str = "specs/fpga/constraints/gf16_clean_ax7203.xdc";

; --- References ---------------------------------------------------------------------------
; mxfp_ref.py is this branch's copy; its MXFP4 decode equals main's at 9947512ff on all 16 codes.
; block_tnf.py is byte-identical to main at 9947512ff (last changed there in 8aaf30ed2).
pub const MXFP_REF_FILE : str = "conformance/mxfp_ref.py";
pub const MXFP_REF_SHA256 : str = "7e4dc70140ebd3c26fdbb8bd00e99339f1ef864cc8b027643e59bc7ef34c3ab6";
pub const TNF_LEVELS_FILE : str = "research/block/block_tnf.py";
pub const TNF_LEVELS_SHA256 : str = "cd39ef2305ed6e0518a2b75851327158e206bef6b35c1f507fe3eeed902ad678";
pub const TNF_LEVELS_BITS : u8 = 4;
pub const TNF_LEVELS_ET : u8 = 1;

; --- Block --------------------------------------------------------------------------------
; OCP MX v1.0 block: 32 elements, one E8M0 scale X = 2^(s - 127); s = 255 is NaN.
pub const BLOCK : u8 = 32;
pub const ELEM_BITS : u8 = 4;
pub const SIGN_BIT : u8 = 8;
pub const MAG_CODES : u8 = 8;
pub const SCALE_BIAS : u8 = 127;
pub const SCALE_NAN : u8 = 255;

; Element value = sign * INT[magnitude code] / 2^UNIT_SHIFT * X.
; E2M1 (mxfp_ref.py mxfp4): 0, 0.5, 1, 1.5, 2, 3, 4, 6.
pub const E2M1_INT : [8]u8 = [0, 1, 2, 3, 4, 6, 8, 12];
pub const E2M1_UNIT_SHIFT : u8 = 1;
; TNF4, E_t = 1, M = 1: (1 + m/2) * 2^-e for trit e in {0, 1, 2} and bit m, and zero; codes in
; ascending order: 0, 0.25, 0.375, 0.5, 0.75, 1, 1.5. block_tnf.py gives levels only, no codes;
; this ascending assignment is this cell's. Code 7 is not a level. It reads as zero, the cheapest
; reading, so TNF4's cost carries no check that MXFP4 does not need.
pub const TNF4_INT : [8]u8 = [0, 2, 3, 4, 6, 8, 12, 0];
pub const TNF4_UNIT_SHIFT : u8 = 3;
pub const TNF4_HOLE_CODE : u8 = 7;
pub const TNF4_LEVELS : u8 = 7;
; The E2M1 code holding each TNF4 level: every one but E2M1 code 1.
pub const TNF4_AT_E2M1 : [7]u8 = [0, 2, 3, 4, 5, 6, 7];
pub const E2M1_ONLY_CODE : u8 = 1;
pub const TOP_INT : u8 = 12;

; --- Result word --------------------------------------------------------------------------
; Exact: S = sum of sign_a * sign_b * INT_a * INT_b over the 32 lanes, E = s_a + s_b, and the
; block value is S * 2^(E - 2 * SCALE_BIAS - 2 * UNIT_SHIFT). No rounding anywhere.
; Word: bits 0..13 S in two's complement, bits 14..22 E, bit 23 NaN. If s_a or s_b is 255 the
; word is NAN_WORD, whatever the elements are.
pub const PROD_MAX : u16 = 144;
pub const SUM_MAX : u16 = 4608;
pub const SUM_BITS : u8 = 14;
pub const SUM_LIMIT : u16 = 8192;
pub const EXP_BITS : u8 = 9;
pub const EXP_MAX : u16 = 508;
pub const EXP_LIMIT : u16 = 512;
pub const EXP_SHIFT : u8 = 14;
pub const NAN_BIT : u8 = 23;
pub const NAN_WORD : u32 = 8388608;
pub const WORD_BITS : u8 = 24;
pub const RESULT_BYTES : u8 = 3;

; --- Wire ---------------------------------------------------------------------------------
; The TRI-NET node's UART, divider and host rate, as the TNF16 cell (tnf16_on_board_ax7203.t27).
pub const UART_SOURCE : str = "fpga/portable/trinet_node_core.v";
pub const BAUD_DIV : u8 = 60;
pub const HOST_BAUD : u32 = 1144744;
pub const CP2102N_REF_HZ : u32 = 24000000;
pub const CP2102N_N : u8 = 21;
pub const WIRE_BAUD : u32 = 1142857;
pub const CFGMCLK_MIN_HZ : u32 = 65600000;
pub const CFGMCLK_MAX_HZ : u32 = 68700000;
; Request: SYNC0 SYNC1 OP SEQ SA SB A0..A15 B0..B15. Element i is the low nibble of byte i/2
; when i is even, the high nibble when odd. Response: RESP_OK SEQ r0 r1 r2, little-endian word;
; an unknown OP gets RESP_BADOP SEQ 0 0 0.
pub const SYNC0 : u8 = 170;
pub const SYNC1 : u8 = 85;
pub const RESP_OK : u8 = 165;
pub const RESP_BADOP : u8 = 229;
pub const OP_MXFP4 : u8 = 1;
pub const OP_TNF4 : u8 = 2;
pub const BLOCK_BYTES : u8 = 16;
pub const REQ_BYTES : u8 = 38;
pub const RESP_BYTES : u8 = 5;
; The TNF16 run moved 1035886 requests with 24 in flight at 10 bytes, 240 bytes, and lost none;
; 64 in flight lost bytes on this link. The request here is 38 bytes, so the window is sized by
; bytes in flight, not by requests.
pub const PASSED_BYTES_IN_FLIGHT : u16 = 240;
pub const WINDOW : u8 = 6;
; Clocks from a request entering the core to its result: decode and multiply, eight sums of
; four, one sum of eight.
pub const CORE_STAGES : u8 = 3;

; --- Vectors, per op ----------------------------------------------------------------------
; Pinned: named blocks (zeros, negative zeros, full-scale sums of both signs, one lane, the
; hole code, NaN scales, scale ends). Edge: every (a code, b code) pair in every lane.
; Scales: every (s_a, s_b) pair, elements random. Random: uniform codes and scales. Top: codes
; from the two largest magnitudes of the op's table, random signs, where the adder carries.
; splitmix64 from RANDOM_SEED; expected words from the golden.
pub const RANDOM_SEED : u32 = 20260927;
pub const PINNED_PER_OP : u16 = 16;
pub const EDGE_PER_OP : u16 = 256;
pub const SCALE_PAIRS_PER_OP : u32 = 65536;
pub const RANDOM_UNIFORM_PER_OP : u32 = 50000;
pub const RANDOM_TOP_PER_OP : u32 = 10000;
pub const REQUESTS_PER_OP : u32 = 125808;
pub const TOTAL_REQUESTS : u32 = 251616;

; --- Cost, pre-registered before any synthesis ----------------------------------------------
; Measured: yosys logic cells of the core alone, one build per format (FORMATS = 1, then 2),
; the build script's synth_xilinx flags. Predicted: the two differ by under PREDICT_LUT_DIFF_PCT,
; because the product tables are the same integers bar one row. A larger gap refutes it.
pub const PREDICT_LUT_DIFF_PCT : u8 = 5;

; --- Run and pass rule --------------------------------------------------------------------
pub const RUN_NAME : str = "mxdot4_board_ax7203";
pub const RUN_LIMIT_S : u16 = 1800;
pub const PASS_LINE : str = "MXDOT4 RESULT: 251616/251616 bit-exact (fails=0, lost=0)";
pub const SIM_PASS_LINE : str = "MXDOT4 SIM: 251616/251616 bit-exact (fails=0)";

test tnf4_is_e2m1_without_one_level {
    assert TNF4_INT[0] == E2M1_INT[TNF4_AT_E2M1[0]];
    assert TNF4_INT[1] == E2M1_INT[TNF4_AT_E2M1[1]];
    assert TNF4_INT[2] == E2M1_INT[TNF4_AT_E2M1[2]];
    assert TNF4_INT[3] == E2M1_INT[TNF4_AT_E2M1[3]];
    assert TNF4_INT[4] == E2M1_INT[TNF4_AT_E2M1[4]];
    assert TNF4_INT[5] == E2M1_INT[TNF4_AT_E2M1[5]];
    assert TNF4_INT[6] == E2M1_INT[TNF4_AT_E2M1[6]];
    assert TNF4_AT_E2M1[0] < E2M1_ONLY_CODE;
    assert TNF4_AT_E2M1[1] == E2M1_ONLY_CODE + 1;
    assert TNF4_LEVELS + 1 == MAG_CODES;
    assert TNF4_INT[TNF4_HOLE_CODE] == 0;
    assert E2M1_INT[MAG_CODES - 1] == TOP_INT;
    assert TNF4_INT[TNF4_LEVELS - 1] == TOP_INT;
}

; E2M1's top is 6 = 12/2, TNF4's is 1.5 = 12/8: the one factor between the two lattices is 4,
; a power of two, which an E8M0 scale absorbs.
test tops_and_units {
    assert TNF4_UNIT_SHIFT == E2M1_UNIT_SHIFT + 2;
    assert SIGN_BIT == MAG_CODES;
    assert BLOCK_BYTES * 2 == BLOCK;
}

test result_word_holds_every_block {
    assert PROD_MAX == TOP_INT * TOP_INT;
    assert SUM_MAX == BLOCK * PROD_MAX;
    assert SUM_MAX < SUM_LIMIT;
    assert SUM_LIMIT / 2 <= SUM_MAX;
    assert EXP_MAX == 2 * (SCALE_NAN - 1);
    assert EXP_MAX < EXP_LIMIT;
    assert EXP_LIMIT / 2 <= EXP_MAX;
    assert EXP_SHIFT == SUM_BITS;
    assert NAN_BIT == EXP_SHIFT + EXP_BITS;
    assert WORD_BITS == NAN_BIT + 1;
    assert WORD_BITS == 8 * RESULT_BYTES;
}

test wire_is_the_node_link {
    assert WIRE_BAUD == CP2102N_REF_HZ / CP2102N_N;
    assert WIRE_BAUD * BAUD_DIV >= CFGMCLK_MIN_HZ;
    assert WIRE_BAUD * BAUD_DIV <= CFGMCLK_MAX_HZ;
    assert HOST_BAUD > WIRE_BAUD;
    assert BLOCK_BYTES * 8 == BLOCK * ELEM_BITS;
    assert REQ_BYTES == 4 + 2 + 2 * BLOCK_BYTES;
    assert RESP_BYTES == 2 + RESULT_BYTES;
    assert WINDOW * REQ_BYTES <= PASSED_BYTES_IN_FLIGHT;
    assert WINDOW * REQ_BYTES + REQ_BYTES > PASSED_BYTES_IN_FLIGHT;
    assert OP_MXFP4 != OP_TNF4;
    assert RESP_OK != RESP_BADOP;
}

test one_response_buffer_never_overruns {
    assert RESP_BYTES + 1 < REQ_BYTES;
    assert CORE_STAGES < BAUD_DIV;
}

test vector_counts {
    assert EDGE_PER_OP == 16 * 16;
    assert SCALE_PAIRS_PER_OP == 256 * 256;
    assert REQUESTS_PER_OP == PINNED_PER_OP + EDGE_PER_OP + SCALE_PAIRS_PER_OP + RANDOM_UNIFORM_PER_OP + RANDOM_TOP_PER_OP;
    assert TOTAL_REQUESTS == 2 * REQUESTS_PER_OP;
}

test run_fits_its_limit {
    assert TOTAL_REQUESTS * REQ_BYTES * 10 / WIRE_BAUD < RUN_LIMIT_S / 4;
}
