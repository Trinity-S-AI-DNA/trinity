// SPDX-License-Identifier: Apache-2.0
; specs/trinet/tnf16_on_board_ax7203.t27 -- TNF16 add and mul on the ALINX AX7203: format, wire, vectors, pass rule
; The one source for the TNF16 board cell. conformance/tnf16_board_from_spec.mjs compiles this file
; with the t27 compiler (wasm), evaluates every test block below against the constants, and writes
; fpga/tnet/tnf16_board_params.v (RTL macros) and conformance/tnf16_board_params.py (host). No
; number below is typed a second time anywhere; `--check` fails when a generated file drifts.
; ASCII only, English only.

; WHY. The owner, 2026-09-27: TNF is the best format; put it on the board now. TNF has never run
; on a board (conformance/FORMATS_ON_BOARD.md, section 4): its LUT and Fmax figures are post-route.

; WHAT A PASS SAYS. This RTL computes the reference TNF16 add and mul bit-exact on this board for
; every vector listed here. The reference is conformance/tnf_ref.py, TNFFormat(4, 11), ladder
; v2-spec, the format the pinned vectors were generated from.
; WHAT IT DOES NOT SAY. Nothing about TNF against other formats. The top carries a UART and a
; frame parser next to the core, and the core is cut into CORE_STAGES stages for a slow clock, so
; its LUT count is not a TNF cost figure.

module trinet_tnf16_on_board_ax7203;

pub const KIND : str = "board-cell";
pub const ID : str = "trinet/tnf16_on_board_ax7203";
pub const GENERATED : [2]str = ["fpga/tnet/tnf16_board_params.v", "conformance/tnf16_board_params.py"];

; --- Board ------------------------------------------------------------------------------
pub const BOARD : str = "ALINX AX7203";
pub const PART : str = "xc7a200tfbg484-2";
; JTAG IDCODE 0x13636093, read by every load on this board today.
pub const IDCODE : u32 = 325279891;
pub const TOP : str = "tnf16_board_ax7203";
pub const XDC : str = "specs/fpga/constraints/gf16_clean_ax7203.xdc";

; --- Format: the reference, TNFFormat(4, 11) ----------------------------------------------
; Both reference files and the vector file are byte-identical to main at 9947512ff (last changed
; there in 85bf964f6); this branch took them with `git checkout origin/HEAD -- <path>`.
pub const REF_FILE : str = "conformance/tnf_ref.py";
pub const REF_SHA256 : str = "f1cc7a74641f77b62a2abebf7c48fd7d2fe40df0c860744c23675d4bdb6fad3c";
pub const REF_VERSIONS_FILE : str = "conformance/tnf_ladder_versions.py";
pub const REF_VERSIONS_SHA256 : str = "958e1001cde3d65a8a357cb35808d6bca871c4f7314e062a099bd9b15573df17";
pub const REF_LADDER : str = "v2-spec";
pub const EXP_TRITS : u8 = 4;
pub const MANT_BITS : u8 = 11;
; The ladder's width rule counts one position per trit: 1 + EXP_TRITS + MANT_BITS.
pub const NOMINAL_WIDTH : u8 = 16;
; 3^EXP_TRITS exponent values; the top one is the special row (inf, NaN).
pub const EXP_VALUES : u8 = 81;
pub const OFFSET_MAX : u8 = 80;
pub const EXP_OFFSET : u8 = 40;
; On binary the offset is a 7-bit field, so the word is 19 bits, not 16.
pub const OFF_BITS : u8 = 7;
pub const OFF_CODES : u8 = 128;
pub const EXP_SHIFT : u8 = 11;
pub const SIGN_SHIFT : u8 = 18;
pub const WORD_BITS : u8 = 19;
pub const MANT_SCALE : u32 = 2048;
pub const SIGN_BIT : u32 = 262144;
pub const POS_INF : u32 = 163840;
pub const NEG_INF : u32 = 425984;
; Any operation with an operand on the special row returns this one word, whatever the other
; operand is: inf + 1 is NaN, not inf (tnf_ref.tef_add, tef_mul).
pub const CANON_NAN : u32 = 163841;
pub const ONE : u32 = 81920;
pub const MIN_NORMAL : u32 = 2048;
; Offset 0 decodes to zero whatever its sign and mantissa. An exact zero result encodes as +0;
; an underflow keeps its sign. Below MIN_NORMAL there are no subnormals: a result rounds to
; signed zero if |x| <= 2^-40, else to the signed smallest normal.
pub const UNDERFLOW_ZERO_LOG2 : u8 = 40;
; Offsets 81..127 fit the 7-bit field. The reference decodes them as ordinary finite values,
; 2^41 up to 2^87, larger than its own infinity. No written TNF16 rule covers them. The RTL
; follows the reference, and the uniform random set sends them in about 37 % of operands.
pub const NONCANON_OFF_MIN : u8 = 81;
pub const NONCANON_OFF_MAX : u8 = 127;
; Operand bits 19..23 on the wire are ignored, as the reference ignores them.

; --- Four TNF16 definitions, 2026-09-27 (each file read) -----------------------------------
; Entry 0 is in the t27 tree (last changed b3b8d995); its word bits are derived: exp_offset()
; takes four 2-bit trit codes. Its header still says "9-bit precision" beside M = 11.
; Entries 2 and 3 are on main at 9947512ff, not on this branch.
pub const DEFS : [4]str = ["t27 specs/numeric/tnf16.t27: sign, 4 trits as codes 0/1/2, M=11", "conformance/tnf_ref.py TNFFormat(4, 11), ladder v2-spec: 7-bit binary offset, M=11", "conformance/tnf16_ref.py TNFFormat(4, 9), ladder v1-research", "fpga/tnet/bnf_decode.v tnf16_decode: 7-bit offset, M=8, no zero row, no special row"];
pub const DEF_MANT_BITS : [4]u8 = [11, 11, 9, 8];
pub const DEF_WORD_BITS : [4]u8 = [20, 19, 17, 16];
; Indices count from 0. This cell builds entry 1. Entry 3 is the RTL behind the TNF16 row of
; fpga/tnet/MATRIX.md on main (514 LUT, 74.37 MHz), so that figure is not one for this format.
pub const DEF_ON_BOARD : u8 = 1;
pub const DEF_BEHIND_MATRIX : u8 = 3;

; --- Wire ---------------------------------------------------------------------------------
; The TRI-NET node's UART (fpga/portable/trinet_node_core.v), same divider, same clock, same
; host rate: 403200/403200 jobs at window 24 on this board today, over the same adapter.
pub const UART_SOURCE : str = "fpga/portable/trinet_node_core.v";
pub const BAUD_DIV : u8 = 60;
pub const HOST_BAUD : u32 = 1144744;
; The CP2102N sends 24 MHz / N; 1144744 is N = 21 on the wire.
pub const CP2102N_REF_HZ : u32 = 24000000;
pub const CP2102N_N : u8 = 21;
pub const WIRE_BAUD : u32 = 1142857;
; CFGMCLK is only bounded on this board (TERN_TC_WEAK_POINTS.md, point 6).
pub const CFGMCLK_MIN_HZ : u32 = 65600000;
pub const CFGMCLK_MAX_HZ : u32 = 68700000;
; Requests in flight. Window 64 lost bytes on this link and 24 did not (LESSONS.md).
pub const WINDOW : u8 = 24;
; Request: SYNC0 SYNC1 OP SEQ a0 a1 a2 b0 b1 b2, operands little-endian.
; Response: RESP_OK SEQ r0 r1 r2; an unknown OP gets RESP_BADOP SEQ 0 0 0.
; SEQ comes back as sent, so a lost or shifted byte is a link failure, never a wrong result.
pub const SYNC0 : u8 = 170;
pub const SYNC1 : u8 = 85;
pub const RESP_OK : u8 = 165;
pub const RESP_BADOP : u8 = 229;
pub const OP_ADD : u8 = 1;
pub const OP_MUL : u8 = 2;
pub const OPERAND_BYTES : u8 = 3;
pub const REQ_BYTES : u8 = 10;
pub const RESP_BYTES : u8 = 5;
; Clocks from a request entering the core to its result, fixed; tnf16_core_tb measures it.
pub const CORE_STAGES : u8 = 6;
; The adder aligns the smaller operand into GUARD_BITS bits below its significand and ORs every
; bit shifted further out into the lowest one. An inexact sum is then odd, so it never sits on a
; tie and rounds as the exact sum does. With 2 guard bits the RTL model and the RTL both miss
; the reference on 1358 of the requests below; with 3 on none (conformance/tnf16_rtl_model.py).
pub const GUARD_BITS : u8 = 3;

; --- Vectors ------------------------------------------------------------------------------
pub const VEC_FILE : str = "conformance/vectors/tnf/tnf16_v2-spec_tnf-vectors-3.vec";
pub const VEC_SHA256 : str = "aa1e9ac3628c311e658860bdf93d4ae4af17b123f17aa766c634a21a92e76634";
pub const VEC_SPEC_VERSION : str = "tnf-vectors-3";
pub const VEC_ADD : u16 = 519;
pub const VEC_MUL : u16 = 519;
pub const VEC_ROWS : u16 = 1038;
; Edge set: every sign, offset and mantissa below crossed with itself, for each op.
pub const EDGE_OFFSETS : [11]u8 = [0, 1, 2, 39, 40, 41, 78, 79, 80, 81, 127];
pub const EDGE_MANTS : [6]u16 = [0, 1, 1023, 1024, 2046, 2047];
pub const EDGE_CODES : u16 = 132;
pub const EDGE_PAIRS_PER_OP : u32 = 17424;
; Random sets, splitmix64 from RANDOM_SEED, expected words from the reference.
; Uniform: both operands any 19-bit word.
; Near: both offsets 1..79 and random signs. Add: |offset a - offset b| <= NEAR_ADD_MAX_GAP,
; where cancellation and rounding live. Mul: offset a + offset b inside one of the three
; NEAR_MUL_SUM_BANDS pairs, around underflow, unity and overflow.
pub const RANDOM_SEED : u32 = 20260927;
pub const RANDOM_UNIFORM_PER_OP : u32 = 250000;
pub const RANDOM_NEAR_PER_OP : u32 = 250000;
pub const NEAR_ADD_MAX_GAP : u8 = 13;
pub const NEAR_MUL_SUM_BANDS : [6]u8 = [30, 50, 70, 90, 110, 130];
pub const TOTAL_REQUESTS : u32 = 1035886;

; --- Run and pass rule --------------------------------------------------------------------
; One attempt. A second only if the first fails before its first response; both logs are kept.
pub const RUN_NAME : str = "tnf16_board_ax7203";
pub const RUN_LIMIT_S : u16 = 1800;
pub const PASS_LINE : str = "TNF16 RESULT: 1035886/1035886 bit-exact (fails=0, lost=0)";
pub const SIM_PASS_LINE : str = "TNF16 SIM: 1035886/1035886 bit-exact (fails=0)";

test format_is_tnf_4_11 {
    assert EXP_VALUES == 3 * 3 * 3 * 3;
    assert OFFSET_MAX == EXP_VALUES - 1;
    assert EXP_OFFSET * 2 == OFFSET_MAX;
    assert 1 + EXP_TRITS + MANT_BITS == NOMINAL_WIDTH;
    assert OFFSET_MAX < OFF_CODES;
    assert OFFSET_MAX >= OFF_CODES / 2;
    assert EXP_SHIFT == MANT_BITS;
    assert SIGN_SHIFT == MANT_BITS + OFF_BITS;
    assert WORD_BITS == SIGN_SHIFT + 1;
    assert WORD_BITS > NOMINAL_WIDTH;
}

test special_words {
    assert SIGN_BIT == MANT_SCALE * OFF_CODES;
    assert POS_INF == OFFSET_MAX * MANT_SCALE;
    assert NEG_INF == SIGN_BIT + POS_INF;
    assert CANON_NAN == POS_INF + 1;
    assert ONE == EXP_OFFSET * MANT_SCALE;
    assert MIN_NORMAL == MANT_SCALE;
    assert UNDERFLOW_ZERO_LOG2 == EXP_OFFSET;
    assert NONCANON_OFF_MIN == OFFSET_MAX + 1;
    assert NONCANON_OFF_MAX == OFF_CODES - 1;
}

test definitions_disagree {
    assert DEF_MANT_BITS[DEF_ON_BOARD] == MANT_BITS;
    assert DEF_WORD_BITS[DEF_ON_BOARD] == WORD_BITS;
    assert DEF_MANT_BITS[0] == MANT_BITS;
    assert DEF_WORD_BITS[0] != WORD_BITS;
    assert DEF_MANT_BITS[2] != MANT_BITS;
    assert DEF_MANT_BITS[DEF_BEHIND_MATRIX] != MANT_BITS;
    assert DEF_WORD_BITS[DEF_BEHIND_MATRIX] == NOMINAL_WIDTH;
}

test wire_is_the_node_link {
    assert WIRE_BAUD == CP2102N_REF_HZ / CP2102N_N;
    assert WIRE_BAUD * BAUD_DIV >= CFGMCLK_MIN_HZ;
    assert WIRE_BAUD * BAUD_DIV <= CFGMCLK_MAX_HZ;
    assert HOST_BAUD > WIRE_BAUD;
    assert HOST_BAUD - WIRE_BAUD < WIRE_BAUD / 500;
    assert WINDOW <= 24;
    assert REQ_BYTES == 4 + 2 * OPERAND_BYTES;
    assert RESP_BYTES == 2 + OPERAND_BYTES;
    assert OPERAND_BYTES * 8 >= WORD_BITS;
    assert OP_ADD != OP_MUL;
    assert RESP_OK != RESP_BADOP;
}

test one_response_buffer_never_overruns {
    assert 10 * (RESP_BYTES + 1) < 10 * REQ_BYTES;
    assert CORE_STAGES < BAUD_DIV;
}

test datapath_is_narrow {
    assert GUARD_BITS > 2;
    assert GUARD_BITS < MANT_BITS;
}

test vector_counts {
    assert VEC_ADD + VEC_MUL == VEC_ROWS;
    assert EDGE_CODES == 11 * 6 * 2;
    assert EDGE_OFFSETS[8] == OFFSET_MAX;
    assert EDGE_OFFSETS[9] == NONCANON_OFF_MIN;
    assert EDGE_OFFSETS[10] == NONCANON_OFF_MAX;
    assert EDGE_MANTS[5] == MANT_SCALE - 1;
    assert EDGE_PAIRS_PER_OP == EDGE_CODES * EDGE_CODES;
    assert NEAR_MUL_SUM_BANDS[0] < NEAR_MUL_SUM_BANDS[1];
    assert NEAR_MUL_SUM_BANDS[2] < NEAR_MUL_SUM_BANDS[3];
    assert NEAR_MUL_SUM_BANDS[4] < NEAR_MUL_SUM_BANDS[5];
    assert NEAR_MUL_SUM_BANDS[5] <= 2 * (OFFSET_MAX - 1);
    assert TOTAL_REQUESTS == VEC_ROWS + 2 * EDGE_PAIRS_PER_OP + 2 * (RANDOM_UNIFORM_PER_OP + RANDOM_NEAR_PER_OP);
}

test run_fits_its_limit {
    assert TOTAL_REQUESTS * REQ_BYTES * 10 / WIRE_BAUD < RUN_LIMIT_S / 4;
}
