// SPDX-License-Identifier: Apache-2.0
; specs/trinet/uart_loss_diag_ax7203.t27 -- pre-registration: how often the AX7203 UART link loses bytes
; The one source for this diagnostic. conformance/uart_loss_diag_from_spec.mjs compiles this file
; with the t27 compiler (wasm), evaluates every test block below against the constants, checks the
; pinned files, and writes conformance/uart_loss_diag_params.py, which the runner
; conformance/uart_loss_diag_ax7203.py reads. No number below is typed a second time; `--check`
; fails on drift. Written 2026-09-27 before any arm of this diagnostic ran. ASCII, English.

; WHY. The owner, 2026-09-27 ("vse tri", item 2): measure the UART loss rate with a separate mode
; that continues after a hole and counts the losses, pre-registered in .t27; the main harness and
; its PASS criterion are not touched; quit BrowserOS and count FwUpdateManagerd's connections first.

; WHAT IS KNOWN. conformance/tern_tc_layer_ax7203.py stops at the first unframed read, so each board
; run gives at most one event. Recorded first holes (tri fpga-hole):
;   window 64, FE1.1s hub path:  after 6679 accepted answers, 59 bytes
;   window 30, FE1.1s hub path:  after 149986, 7 bytes
;   window 64, Genesys hub path: after 188936, 53 bytes (E 0x3e208, anchor 0x3e20b at +4)
;   window 24 twice and 26 once, FE1.1s path: 403200 of 403200 each, no hole
; One event per run is a waiting time, not a rate. This diagnostic counts every event in a fixed
; number of jobs, so it gives a rate with an interval.

; WHAT THE DIAGNOSTIC DOES. The same jobs, requests, parse, key and link as the harness, imported
; from it unchanged (its bytes are pinned below). The same I/O pattern while nothing is wrong: keep
; WINDOW requests in flight, read RESP_LEN bytes, check it. On a frame that fails, it scans the
; bytes forward for the next ANCHOR: magic, status ok, the pinned node id, a nonce still in flight,
; AND a SipHash tag that verifies under the key for that nonce's own job. Then
;   lost answers = M - E,  hole bytes = RESP_LEN * (M - E) - q
; where E is the first unanswered job, M the anchor's job and q the bytes read from where E's answer
; should have started to the anchor. hole > 0 is lost bytes; hole == 0 is a frame damaged in place
; (bit error, or a request the node misread); hole < 0 is inserted bytes. If no anchor turns up
; within RESP_LEN * (WINDOW + 2) bytes, or a read times out, the event is UNRESOLVED: the runner
; stops sending, drains the link until it is quiet, and counts every job in flight as lost.

; WHAT A RESULT SAYS. Per arm: events per job with an exact Poisson 95 % interval, every event's
; job index and hole size, and the host's longest pause. Between arms: whether window 64 loses more
; often than window 24 on this USB path (CLAIM_W64_WORSE below).
; WHAT IT DOES NOT SAY.
;   Nothing about the harness PASS criterion or any past run. The diagnostic never prints the words
;   the harness reserves for a full pass. Zero events in an arm bounds the rate below 3 / N (95 %),
;   it does not make it zero. One USB path, one host, one evening. It does not find the cause; the
;   predictions below only say which cause the numbers would fit.

module trinet_uart_loss_diag_ax7203;

pub const KIND : str = "board-diagnostic-preregistration";
pub const ID : str = "trinet/uart_loss_diag_ax7203";
pub const GENERATED : [1]str = ["conformance/uart_loss_diag_params.py"];
pub const RUNNER : str = "conformance/uart_loss_diag_ax7203.py";
pub const RECORD_DOC : str = "conformance/UART_LOSS_DIAG.md";

; --- Code of record: imported, never edited --------------------------------------------------
pub const HARNESS_FILE : str = "conformance/tern_tc_layer_ax7203.py";
pub const HARNESS_SHA256 : str = "8a9a5f6ef57fdad6e1f6afddb3cbdb1b8f806fbf3e3cb5c11b2c060e1b3729aa";
pub const MAC32_FILE : str = "conformance/trinet_mac32_conformance_ax7203.py";
pub const MAC32_SHA256 : str = "11fa651938a0e360a311f63ec4c04de15241ad9a7c6e26175ead084e07ababa2";

; --- The board and the link -----------------------------------------------------------------
; The node on the board since 08:49Z (CI artifact); its node id is "TRIN" read little-endian.
pub const BITSTREAM : str = "trinet_node0_ci30762491794.bit";
pub const NODE_ID : u32 = 1414678862;
pub const BAUD : u32 = 1144744;
pub const USB_PATH : str = "CP2102N at 0x00110000 behind a Genesys USB2.1 hub (05e3:0610) on bus 0x00";
pub const REQ_LEN : u8 = 24;
pub const RESP_LEN : u8 = 19;
pub const MAGIC_RESP : u8 = 165;
pub const STATUS_OK : u8 = 1;
pub const FIRST_JOB_NONCE : u32 = 65536;
; CP2102N receive buffer (datasheet); the node has no RTS/CTS.
pub const CP2102N_RX_BYTES : u16 = 512;
pub const READ_TIMEOUT_S : u8 = 2;

; --- Jobs -----------------------------------------------------------------------------------
; The harness's --all job list (7 kinds x 6 layers, 2 ternary x-vectors, seed 0x7213), repeated
; PASSES times; job i uses list entry i mod JOBS_PER_PASS and nonce FIRST_JOB_NONCE + i.
pub const MODEL : str = "~/igla-coder-gpu/c_infer/model.bin";
pub const SEED : u16 = 29203;
pub const N_X : u8 = 2;
pub const JOBS_PER_PASS : u32 = 403200;
pub const PASSES : u8 = 5;
pub const JOBS_PER_ARM : u32 = 2016000;

; --- Arms, in this order, each once ---------------------------------------------------------
; Window 64 first: 1216 bytes can be in flight, over the 512-byte buffer. Then window 24: 456 bytes,
; under it. Each arm is its own `tri fpga-run` log.
pub const ARM_WINDOWS : [2]u8 = [64, 24];
pub const ARM_LOGS : [2]str = ["uart_loss_w64", "uart_loss_w24"];
pub const ARM_LIMIT_S : u16 = 1200;
; Throughput floor the limit assumes; the W24 reload measured 4679 answers per second.
pub const MIN_ANSWERS_PER_S : u16 = 2000;
; Anchor search span, in frames past the window.
pub const RESYNC_SPARE_FRAMES : u8 = 2;
; This many unresolved events with no accepted answer between them end the arm (node not answering).
pub const STALLS_TO_ABORT : u8 = 3;
; At most this many event lines are printed per arm; the counts cover all of them.
pub const EVENT_LINES_MAX : u16 = 300;

; --- Predictions, written before the run ----------------------------------------------------
; PRED_BUFFER: if the losses are the 512-byte buffer overrunning while the host is away, the W24 arm
; has 0 events with hole > 0 and the W64 arm has at least 1.
; PRED_RATE: the one Genesys W64 event, 1 in 189001 jobs, predicts about JOBS_PER_ARM / 189001 = 10
; events in the W64 arm. One event is a weak prior; any count from 1 to 30 is unsurprising.
pub const PRED_W64_EVENTS : u8 = 10;
pub const PRIOR_GENESYS_W64_JOBS : u32 = 189001;

; --- Claim rule -----------------------------------------------------------------------------
; CLAIM_W64_WORSE: with equal job counts, n = e64 + e24 events (hole > 0 or unresolved) and, under
; equal rates, e64 ~ Binomial(n, 1/2). Claimed iff P[X >= e64] <= 1 / ALPHA_INV. With e24 = 0 that
; needs e64 >= MIN_E64_ALONE. Nothing else is claimed.
pub const ALPHA_INV : u8 = 100;
pub const MIN_E64_ALONE : u8 = 7;
; A compute fault outranks everything: any answer whose tag verifies but whose y is wrong is the
; headline, and it is not a UART loss.
; INSTRUMENT CHECK: accepted + lost + wrong-y + unmatched == jobs sent, per arm; otherwise the arm is
; recorded as instrument-broken and its rate is not reported.

; --- Worked example the arithmetic must reproduce (the Genesys W64 hole) --------------------
pub const EX_E : u32 = 254472;
pub const EX_M : u32 = 254475;
pub const EX_Q : u8 = 4;
pub const EX_HOLE : u8 = 53;

test node_id_is_trin {
    assert NODE_ID == 84 * 16777216 + 82 * 65536 + 73 * 256 + 78;
    assert MAGIC_RESP == 10 * 16 + 5;
}

test windows_sit_either_side_of_the_buffer {
    assert RESP_LEN * ARM_WINDOWS[0] > CP2102N_RX_BYTES;
    assert RESP_LEN * ARM_WINDOWS[1] < CP2102N_RX_BYTES;
    assert RESP_LEN * ARM_WINDOWS[0] == 1216;
    assert RESP_LEN * ARM_WINDOWS[1] == 456;
}

test job_counts {
    assert JOBS_PER_ARM == JOBS_PER_PASS * PASSES;
    assert JOBS_PER_PASS == 403200;
    assert FIRST_JOB_NONCE == 65536;
    assert FIRST_JOB_NONCE + JOBS_PER_ARM < 16777216;
}

test arm_fits_its_limit {
    assert ARM_LIMIT_S * MIN_ANSWERS_PER_S >= JOBS_PER_ARM;
    assert ARM_LIMIT_S <= 1800;
}

test hole_arithmetic_reproduces_the_genesys_hole {
    assert EX_E == FIRST_JOB_NONCE + 188936;
    assert RESP_LEN * (EX_M - EX_E) - EX_Q == EX_HOLE;
    assert EX_HOLE == RESP_LEN * 2 + 15;
}

test claim_threshold {
    assert 2 * 2 * 2 * 2 * 2 * 2 * 2 >= ALPHA_INV;
    assert 2 * 2 * 2 * 2 * 2 * 2 < ALPHA_INV;
    assert MIN_E64_ALONE == 7;
}

test prediction_from_the_prior {
    assert PRED_W64_EVENTS * PRIOR_GENESYS_W64_JOBS <= JOBS_PER_ARM;
    assert JOBS_PER_ARM < PRIOR_GENESYS_W64_JOBS * 11;
}
