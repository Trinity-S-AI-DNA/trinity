// SPDX-License-Identifier: Apache-2.0
; Issue: https://github.com/gHashTag/tt-trinity-corona/issues/1
; Proof-chain follow-up: https://github.com/gHashTag/tt-trinity-corona/issues/12
; conformance/corona_phase_a.json replays accepts through generated Rust.
; Its independent boundary matrix includes zero/max integers, equality at the
; core-area limit, failing DRC, each receipt boolean and incorrect anchors.
; A saved native seal binds this source and all generated backend hashes.
; Phase A acceptance and the measured full-design GF180MCU baseline.
; [Empirical fit] Run 35509472314, source 2a5eefc43ab28e74a07831cb56a77489a99c59d3.
; Receipts and derivation: docs/phase_a/README.md. This was NOT a stub run.
; The old 8x2/8x4 candidates are superseded by the measured 4x4 design.
; No maximum cells/tile, SKY130 density ratio, timing signoff or silicon claim.
; phi^2 + phi^-2 = 3 | TRINITY

module corona_phase_a;

pub const TILE_COLUMNS : u32 = 4;
pub const TILE_ROWS : u32 = 4;
pub const TILE_COUNT : u32 = 16;
pub const MAPPED_CELLS : u32 = 1356;
; Unit is 1/10000 square micrometre; preserve the original report precision.
pub const CELL_AREA_1E4 : u64 = 279800192;
pub const CORE_AREA_1E4 : u64 = 10452664320;
pub const ANCHOR_VALUE : u32 = 0x47C0;
pub const PRECHECK_CASES : u32 = 12;
pub const FL002_PROMOTED : bool = false;
pub const SILICON_EXPECTED : bool = false;
pub const TIMING_SIGNOFF : bool = false;

; Digital Phase A: positive area within the core, nonempty mapped design,
; zero independently reported DRC items, passing mandatory receipts and anchor.
; This does not waive timing warnings or establish fabrication.
pub fn accepts(cells: u32, area: u64, core: u64, drc_items: u32,
               precheck_ok: bool, anchor: u32, claim_lint_ok: bool) -> bool {
    return cells > 0 && area > 0 && core > 0 && area < core
        && drc_items == 0 && precheck_ok && anchor == ANCHOR_VALUE
        && claim_lint_ok;
}

test measured_full_design_is_accepted {
    assert TILE_COLUMNS * TILE_ROWS == TILE_COUNT;
    assert accepts(MAPPED_CELLS, CELL_AREA_1E4, CORE_AREA_1E4, 0, true, 0x47C0, true);
}

test failed_receipts_are_rejected {
    assert accepts(1356, 279800192, 10452664320, 1, true, 0x47C0, true) == false;
    assert accepts(1356, 279800192, 10452664320, 0, false, 0x47C0, true) == false;
    assert accepts(1356, 279800192, 10452664320, 0, true, 0, true) == false;
    assert accepts(1356, 279800192, 10452664320, 0, true, 0x47C0, false) == false;
}

test empty_or_oversized_design_is_rejected {
    assert accepts(0, 279800192, 10452664320, 0, true, 0x47C0, true) == false;
    assert accepts(1356, 0, 10452664320, 0, true, 0x47C0, true) == false;
    assert accepts(1356, 279800192, 0, 0, true, 0x47C0, true) == false;
    assert accepts(1356, 10452664320, 10452664320, 0, true, 0x47C0, true) == false;
}

test evidence_boundaries_stay_explicit {
    assert FL002_PROMOTED == false;
    assert SILICON_EXPECTED == false;
    assert TIMING_SIGNOFF == false;
}

test strict_area_boundary {
    assert accepts(1, 1, 2, 0, true, ANCHOR_VALUE, true);
    assert accepts(1, 2, 2, 0, true, ANCHOR_VALUE, true) == false;
    assert accepts(1, 3, 2, 0, true, ANCHOR_VALUE, true) == false;
}

test unsigned_extremes_do_not_overflow {
    assert accepts(4294967295, 18446744073709551614, 18446744073709551615, 0, true, ANCHOR_VALUE, true);
    assert accepts(1, 18446744073709551615, 18446744073709551615, 0, true, ANCHOR_VALUE, true) == false;
    assert accepts(1, 1, 2, 4294967295, true, ANCHOR_VALUE, true) == false;
}
