// SPDX-License-Identifier: MIT
; Specs/fingerprint.t27 -- DiskBloom: the content fingerprint that proves a folder did not change
; Every scanned item gets a fingerprint; a folder's fingerprint combines its children's. Before any
; move DiskBloom measures the item again and refuses when the fingerprints differ. Swift writes the
; text of one item ("d" or "f", name, identity, size, time bits, separated by "|") and hands its
; UTF-8 bytes here, in chunks of at most FP_CHUNK bytes. ASCII only.
; Generated C: Sources/Generated/fingerprint.h (Specs/generate.sh).

module DiskBloomFingerprint;

pub const FP_CHUNK : u32 = 4096;
; FNV-1a, 64 bit
pub const FP_OFFSET_BASIS : u64 = 0xcbf29ce484222325;
pub const FP_PRIME : u64 = 1099511628211;
; The multiplier that spreads a child's sum before it is added
pub const FP_SPREAD : u64 = 0x9E3779B185EBCA87;

; --- Hashing the text of one item ---------------------------------------------------------------

pub fn fp_hash_continue(hash: u64, bytes: [4096]u8, len: u32) -> u64 {
    var h: u64 = hash;
    var n: u32 = len;
    if (n > FP_CHUNK) { n = FP_CHUNK; }
    var i: u32 = 0;
    while (i < n) {
        h = h ^ bytes[i];
        h = h * FP_PRIME;
        i = i + 1;
    }
    return h;
}

; --- Combining ------------------------------------------------------------------------------------
; A fingerprint is three words: xor, sum and item count. A leaf adds its hash to all three;
; a child is folded in rotated by (its item count mod 63) + 1, so order and nesting matter.

pub fn fp_rotate_left(x: u64, amount: u64) -> u64 {
    var shift: u64 = amount & 63;
    if (shift == 0) { return x; }
    return (x << shift) | (x >> (64 - shift));
}

pub fn fp_child_shift(child_count: u64) -> u64 {
    return (child_count % 63) + 1;
}

pub fn fp_combine_xor(xor: u64, child_xor: u64, child_count: u64) -> u64 {
    return xor ^ fp_rotate_left(child_xor, fp_child_shift(child_count));
}

pub fn fp_combine_sum(sum: u64, child_sum: u64) -> u64 {
    return sum + child_sum * FP_SPREAD;
}

pub fn fp_combine_count(count: u64, child_count: u64) -> u64 {
    return count + child_count;
}

pub fn fp_leaf_xor(xor: u64, hash: u64) -> u64 {
    return xor ^ hash;
}

pub fn fp_leaf_sum(sum: u64, hash: u64) -> u64 {
    return sum + hash;
}

pub fn fp_leaf_count(count: u64) -> u64 {
    return count + 1;
}

; An item has a fingerprint only with a known identity, and a folder only with its children's.
pub fn fp_node_exists(has_identity: bool, directory: bool, has_children: bool) -> bool {
    if (has_identity == false) { return false; }
    if (directory and has_children == false) { return false; }
    return true;
}

test fp_hash_is_fnv1a {
    var b: [4096]u8 = [0; 4096];
    // FNV-1a("a") = 0xaf63dc4c8601ec8c
    b[0] = 97;
    assert fp_hash_continue(FP_OFFSET_BASIS, b, 1) == 0xaf63dc4c8601ec8c;
    assert fp_hash_continue(FP_OFFSET_BASIS, b, 0) == FP_OFFSET_BASIS;
}

test fp_combining_rotates_and_spreads {
    assert fp_rotate_left(1, 1) == 2;
    assert fp_rotate_left(1, 64) == 1;
    assert fp_rotate_left(0x8000000000000000, 1) == 1;
    assert fp_child_shift(0) == 1;
    assert fp_child_shift(62) == 63;
    assert fp_child_shift(63) == 1;
    assert fp_combine_xor(0, 1, 0) == 2;
    assert fp_combine_sum(1, 1) == 0x9E3779B185EBCA88;
    assert fp_combine_count(2, 3) == 5;
    assert fp_leaf_xor(3, 1) == 2;
    assert fp_leaf_sum(3, 1) == 4;
    assert fp_leaf_count(3) == 4;
    assert fp_node_exists(false, false, true) == false;
    assert fp_node_exists(true, true, false) == false;
    assert fp_node_exists(true, false, false) == true;
    assert fp_node_exists(true, true, true) == true;
}
