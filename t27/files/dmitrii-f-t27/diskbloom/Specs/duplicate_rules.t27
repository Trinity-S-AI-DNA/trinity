// SPDX-License-Identifier: MIT
; Specs/duplicate_rules.t27 -- DiskBloom Duplicate Files: which files are compared, and how they are proven equal
; Sources/DuplicateFinder.swift walks the chosen folder; for every entry it asks this spec what to do,
; groups candidates by size, hashes them with the SHA-256 written here, and confirms every group byte
; by byte with du_bytes_equal. It also decides when a file counts as unchanged, how buckets and groups
; are ordered and how many bytes the extra copies take. ASCII only.
; Generated C: Sources/Generated/duplicate_rules.h (Specs/generate.sh).

module DiskBloomDuplicateRules;

pub const DU_MIN_CHUNK : i64 = 4096;
pub const DU_BLOCK : u32 = 4096;
pub const DU_INT64_MAX : i64 = 9223372036854775807;

; --- Folders never entered (exact last path component) --------------------------------------------
; .Trash .Trashes Backups.backupdb .MobileBackups
pub const DU_BLOCKED_BYTES : [44]u8 = [46, 84, 114, 97, 115, 104, 46, 84, 114, 97, 115, 104, 101, 115, 66, 97, 99, 107, 117, 112, 115, 46, 98, 97, 99, 107, 117, 112, 100, 98, 46, 77, 111, 98, 105, 108, 101, 66, 97, 99, 107, 117, 112, 115];
pub const DU_BLOCKED_OFFSETS : [4]u32 = [0, 6, 14, 30];
pub const DU_BLOCKED_LENGTHS : [4]u32 = [6, 8, 16, 14];

pub fn du_chunk_size(requested: i64) -> i64 {
    if (requested < DU_MIN_CHUNK) { return DU_MIN_CHUNK; }
    return requested;
}

pub fn du_blocked_directory(name: [4096]u8, len: u32) -> bool {
    var entry: u32 = 0;
    while (entry < 4) {
        if (DU_BLOCKED_LENGTHS[entry] == len) {
            var same: bool = true;
            var i: u32 = 0;
            while (i < len) {
                if (name[i] != DU_BLOCKED_BYTES[DU_BLOCKED_OFFSETS[entry] + i]) { same = false; }
                i = i + 1;
            }
            if (same) { return true; }
        }
        entry = entry + 1;
    }
    return false;
}

; --- The chosen folder ------------------------------------------------------------------------------
pub fn du_root_ok(resolves_to_itself: bool, has_metadata: bool, directory: bool, volume_local: bool) -> bool {
    return resolves_to_itself and has_metadata and directory and volume_local;
}

; --- One entry of the walk ---------------------------------------------------------------------------
pub const DU_SKIP_LINK : u32 = 0;
pub const DU_SKIP_LINK_FOLDER : u32 = 1;
pub const DU_UNREADABLE : u32 = 2;
pub const DU_SKIP_PACKAGE : u32 = 3;
pub const DU_UNREADABLE_FOLDER : u32 = 4;
pub const DU_SKIP_MOUNT_FOLDER : u32 = 5;
pub const DU_ENTER : u32 = 6;
pub const DU_IGNORE : u32 = 7;
pub const DU_SKIP_MOUNT_FILE : u32 = 8;
pub const DU_EMPTY : u32 = 9;
pub const DU_SKIP_CLOUD : u32 = 10;
pub const DU_SKIP_HARD_LINK : u32 = 11;
pub const DU_CANDIDATE : u32 = 12;

; Facts:
;   inside_root        strictly inside the chosen folder, with no link on the way
;   was_folder         (when not inside_root) the escaped entry is a folder
;   readable           its resource values could be read
;   symlink, directory, package, blocked_name
;   has_metadata       lstat succeeded
;   same_device        on the chosen folder's volume
;   regular_by_values  the resource values report a regular file
;   regular_by_mode    lstat reports a regular file
;   size, cloud_placeholder (an iCloud file that is not downloaded), link_count
pub fn du_entry_action(inside_root: bool, was_folder: bool, readable: bool, symlink: bool, directory: bool, package: bool, blocked_name: bool, has_metadata: bool, same_device: bool, regular_by_values: bool, regular_by_mode: bool, size: i64, cloud_placeholder: bool, link_count: u32) -> u32 {
    if (inside_root == false) {
        if (was_folder) { return DU_SKIP_LINK_FOLDER; }
        return DU_SKIP_LINK;
    }
    if (readable == false) { return DU_UNREADABLE; }
    if (symlink) {
        if (directory) { return DU_SKIP_LINK_FOLDER; }
        return DU_SKIP_LINK;
    }
    if (directory) {
        if (package or blocked_name) { return DU_SKIP_PACKAGE; }
        if (has_metadata == false) { return DU_UNREADABLE_FOLDER; }
        if (same_device == false) { return DU_SKIP_MOUNT_FOLDER; }
        return DU_ENTER;
    }
    if (regular_by_values == false or has_metadata == false or regular_by_mode == false) { return DU_IGNORE; }
    if (same_device == false) { return DU_SKIP_MOUNT_FILE; }
    if (size <= 0) { return DU_EMPTY; }
    if (cloud_placeholder) { return DU_SKIP_CLOUD; }
    if (link_count > 1) { return DU_SKIP_HARD_LINK; }
    return DU_CANDIDATE;
}

; Files that reach the size check count as examined.
pub fn du_examined(action: u32) -> bool {
    return action >= DU_SKIP_MOUNT_FILE;
}

; --- File metadata (lstat / fstat) ---------------------------------------------------------------------
pub const DU_TYPE_MASK : u32 = 61440;
pub const DU_TYPE_REGULAR : u32 = 32768;
pub const DU_TYPE_DIRECTORY : u32 = 16384;
pub const DU_TYPE_LINK : u32 = 40960;

pub fn du_mode_is(mode: u32, kind: u32) -> bool {
    return (mode & DU_TYPE_MASK) == kind;
}

pub fn du_allocated_size(blocks: i64) -> i64 {
    if (blocks <= 0) { return 0; }
    if (blocks > DU_INT64_MAX / 512) { return DU_INT64_MAX; }
    return blocks * 512;
}

pub fn du_logical_size(size: i64) -> i64 {
    if (size < 0) { return 0; }
    return size;
}

; A file counts as unchanged only when every recorded field is the same.
pub fn du_metadata_same(device_a: u64, device_b: u64, inode_a: u64, inode_b: u64, mode_a: u32, mode_b: u32, links_a: u32, links_b: u32, size_a: i64, size_b: i64, allocated_a: i64, allocated_b: i64, mtime_a: i64, mtime_b: i64, mtime_ns_a: i64, mtime_ns_b: i64, ctime_a: i64, ctime_b: i64, ctime_ns_a: i64, ctime_ns_b: i64) -> bool {
    if (device_a != device_b or inode_a != inode_b or mode_a != mode_b or links_a != links_b) { return false; }
    if (size_a != size_b or allocated_a != allocated_b) { return false; }
    if (mtime_a != mtime_b or mtime_ns_a != mtime_ns_b) { return false; }
    if (ctime_a != ctime_b or ctime_ns_a != ctime_ns_b) { return false; }
    return true;
}

; --- Candidates and groups -------------------------------------------------------------------------------
pub fn du_worth_hashing(files_of_this_size: u32) -> bool {
    return files_of_this_size > 1;
}

pub const DU_FIRST : u32 = 0;
pub const DU_SECOND : u32 = 1;
pub const DU_TIE : u32 = 2;

; Larger first; ties fall back to the paths (Swift compares them).
pub fn du_larger_first(a: i64, b: i64) -> u32 {
    if (a > b) { return DU_FIRST; }
    if (a < b) { return DU_SECOND; }
    return DU_TIE;
}

; After comparing a file with a partition's first file: join it, start a new partition, or drop it
; (a read error ends its comparisons and counts it as unreadable).
pub const DU_JOIN : u32 = 0;
pub const DU_TRY_NEXT : u32 = 1;
pub const DU_DROP : u32 = 2;

pub fn du_after_compare(compared: bool, identical: bool) -> u32 {
    if (compared == false) { return DU_DROP; }
    if (identical) { return DU_JOIN; }
    return DU_TRY_NEXT;
}

pub fn du_is_group(files: u32) -> bool {
    return files > 1;
}

; How many of a group's files are extra copies.
pub fn du_extra_copies(files: u32) -> u32 {
    if (files <= 1) { return 0; }
    return files - 1;
}

; Bytes the extra copies take, saturating at the largest Int64.
pub fn du_duplicate_bytes(size: i64, files: u32) -> i64 {
    if (files <= 1 or size <= 0) { return 0; }
    var copies: i64 = files - 1;
    if (size > DU_INT64_MAX / copies) { return DU_INT64_MAX; }
    return size * copies;
}

pub fn du_saturating_add(a: i64, b: i64) -> i64 {
    if (b > 0 and a > DU_INT64_MAX - b) { return DU_INT64_MAX; }
    return a + b;
}

; --- Byte comparison, one block at a time -----------------------------------------------------------------
pub fn du_bytes_equal(a: [4096]u8, b: [4096]u8, len: u32) -> bool {
    var n: u32 = len;
    if (n > DU_BLOCK) { n = DU_BLOCK; }
    var i: u32 = 0;
    while (i < n) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

; --- SHA-256 (FIPS 180-4) ---------------------------------------------------------------------------------
pub const DU_SHA_K : [64]u32 = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2];
pub const DU_SHA_H0 : [8]u32 = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];

pub fn du_rotr(x: u32, n: u32) -> u32 {
    return (x >> n) | (x << (32 - n));
}

pub fn du_sha256_init(state: [8]u32) -> u32 {
    var i: u32 = 0;
    while (i < 8) { state[i] = DU_SHA_H0[i]; i = i + 1; }
    return 8;
}

; Compresses `blocks` 64-byte blocks of data (at most 64) into state.
pub fn du_sha256_blocks(state: [8]u32, data: [4096]u8, blocks: u32) -> u32 {
    var count: u32 = blocks;
    if (count > 64) { count = 64; }
    var w: [64]u32 = [0; 64];
    var block: u32 = 0;
    while (block < count) {
        var base: u32 = block * 64;
        var t: u32 = 0;
        while (t < 16) {
            var p: u32 = base + t * 4;
            var b0: u32 = data[p];
            var b1: u32 = data[p + 1];
            var b2: u32 = data[p + 2];
            var b3: u32 = data[p + 3];
            w[t] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
            t = t + 1;
        }
        while (t < 64) {
            var x: u32 = w[t - 15];
            var y: u32 = w[t - 2];
            var s0: u32 = du_rotr(x, 7) ^ du_rotr(x, 18) ^ (x >> 3);
            var s1: u32 = du_rotr(y, 17) ^ du_rotr(y, 19) ^ (y >> 10);
            w[t] = w[t - 16] + s0 + w[t - 7] + s1;
            t = t + 1;
        }
        var a: u32 = state[0];
        var b: u32 = state[1];
        var c: u32 = state[2];
        var d: u32 = state[3];
        var e: u32 = state[4];
        var f: u32 = state[5];
        var g: u32 = state[6];
        var h: u32 = state[7];
        t = 0;
        while (t < 64) {
            var big1: u32 = du_rotr(e, 6) ^ du_rotr(e, 11) ^ du_rotr(e, 25);
            var choose: u32 = (e & f) ^ ((~e) & g);
            var t1: u32 = h + big1 + choose + DU_SHA_K[t] + w[t];
            var big0: u32 = du_rotr(a, 2) ^ du_rotr(a, 13) ^ du_rotr(a, 22);
            var majority: u32 = (a & b) ^ (a & c) ^ (b & c);
            var t2: u32 = big0 + majority;
            h = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
            t = t + 1;
        }
        state[0] = state[0] + a;
        state[1] = state[1] + b;
        state[2] = state[2] + c;
        state[3] = state[3] + d;
        state[4] = state[4] + e;
        state[5] = state[5] + f;
        state[6] = state[6] + g;
        state[7] = state[7] + h;
        block = block + 1;
    }
    return count;
}

; The final padded blocks: the last tail_len (< 64) bytes, 0x80, zeros, and the bit length.
; Writes them to out and returns how many bytes (64 or 128) to compress.
pub fn du_sha256_padding(tail: [4096]u8, tail_len: u32, total_bytes: u64, out: [4096]u8) -> u32 {
    var n: u32 = tail_len;
    if (n > 63) { n = 63; }
    var i: u32 = 0;
    while (i < n) { out[i] = tail[i]; i = i + 1; }
    out[n] = 128;
    var length: u32 = 64;
    if (n >= 56) { length = 128; }
    i = n + 1;
    while (i < length - 8) { out[i] = 0; i = i + 1; }
    var bits: u64 = total_bytes * 8;
    var k: u32 = 0;
    while (k < 8) {
        out[length - 1 - k] = (bits >> (k * 8)) & 255;
        k = k + 1;
    }
    return length;
}

; Lowercase hex of the state, 64 characters.
pub fn du_sha256_hex(state: [8]u32, out: [4096]u8) -> u32 {
    var i: u32 = 0;
    while (i < 64) {
        var word: u32 = state[i / 8];
        var nibble: u32 = (word >> (28 - (i % 8) * 4)) & 15;
        if (nibble < 10) { out[i] = 48 + nibble; } else { out[i] = 87 + nibble; }
        i = i + 1;
    }
    return 64;
}

test du_walk_rules {
    assert du_chunk_size(1) == 4096;
    assert du_chunk_size(1048576) == 1048576;
    assert du_root_ok(true, true, true, true) == true;
    assert du_root_ok(true, true, false, true) == false;
    assert du_entry_action(false, true, true, false, true, false, false, true, true, false, false, 0, false, 1) == DU_SKIP_LINK_FOLDER;
    assert du_entry_action(false, false, true, false, false, false, false, true, true, true, true, 5, false, 1) == DU_SKIP_LINK;
    assert du_entry_action(true, false, false, false, false, false, false, true, true, true, true, 5, false, 1) == DU_UNREADABLE;
    assert du_entry_action(true, false, true, true, true, false, false, true, true, false, false, 0, false, 1) == DU_SKIP_LINK_FOLDER;
    assert du_entry_action(true, false, true, true, false, false, false, true, true, true, true, 5, false, 1) == DU_SKIP_LINK;
    assert du_entry_action(true, false, true, false, true, true, false, true, true, false, false, 0, false, 1) == DU_SKIP_PACKAGE;
    assert du_entry_action(true, false, true, false, true, false, true, true, true, false, false, 0, false, 1) == DU_SKIP_PACKAGE;
    assert du_entry_action(true, false, true, false, true, false, false, false, true, false, false, 0, false, 1) == DU_UNREADABLE_FOLDER;
    assert du_entry_action(true, false, true, false, true, false, false, true, false, false, false, 0, false, 1) == DU_SKIP_MOUNT_FOLDER;
    assert du_entry_action(true, false, true, false, true, false, false, true, true, false, false, 0, false, 1) == DU_ENTER;
    assert du_entry_action(true, false, true, false, false, false, false, true, true, false, true, 5, false, 1) == DU_IGNORE;
    assert du_entry_action(true, false, true, false, false, false, false, true, false, true, true, 5, false, 1) == DU_SKIP_MOUNT_FILE;
    assert du_entry_action(true, false, true, false, false, false, false, true, true, true, true, 0, false, 1) == DU_EMPTY;
    assert du_entry_action(true, false, true, false, false, false, false, true, true, true, true, 5, true, 1) == DU_SKIP_CLOUD;
    assert du_entry_action(true, false, true, false, false, false, false, true, true, true, true, 5, false, 2) == DU_SKIP_HARD_LINK;
    assert du_entry_action(true, false, true, false, false, false, false, true, true, true, true, 5, false, 1) == DU_CANDIDATE;
    assert du_examined(DU_CANDIDATE) == true;
    assert du_examined(DU_ENTER) == false;
    var n: [4096]u8 = [0; 4096];
    n[0] = 66; n[1] = 97; n[2] = 99; n[3] = 107; n[4] = 117; n[5] = 112; n[6] = 115; n[7] = 46; n[8] = 98; n[9] = 97; n[10] = 99; n[11] = 107; n[12] = 117; n[13] = 112; n[14] = 100; n[15] = 98;
    assert du_blocked_directory(n, 16) == true;
    assert du_blocked_directory(n, 15) == false;
}

test du_metadata_and_groups {
    assert du_mode_is(33188, DU_TYPE_REGULAR) == true;
    assert du_mode_is(16877, DU_TYPE_DIRECTORY) == true;
    assert du_mode_is(41453, DU_TYPE_LINK) == true;
    assert du_allocated_size(8) == 4096;
    assert du_allocated_size(-1) == 0;
    assert du_allocated_size(DU_INT64_MAX) == DU_INT64_MAX;
    assert du_logical_size(-5) == 0;
    assert du_metadata_same(1, 1, 2, 2, 3, 3, 1, 1, 9, 9, 8, 8, 5, 5, 6, 6, 7, 7, 4, 4) == true;
    assert du_metadata_same(1, 1, 2, 2, 3, 3, 1, 1, 9, 9, 8, 8, 5, 5, 6, 6, 7, 7, 4, 3) == false;
    assert du_worth_hashing(2) == true;
    assert du_worth_hashing(1) == false;
    assert du_larger_first(5, 3) == DU_FIRST;
    assert du_larger_first(3, 5) == DU_SECOND;
    assert du_larger_first(3, 3) == DU_TIE;
    assert du_after_compare(false, true) == DU_DROP;
    assert du_after_compare(true, true) == DU_JOIN;
    assert du_after_compare(true, false) == DU_TRY_NEXT;
    assert du_is_group(2) == true;
    assert du_extra_copies(3) == 2;
    assert du_extra_copies(0) == 0;
    assert du_duplicate_bytes(10, 3) == 20;
    assert du_duplicate_bytes(10, 1) == 0;
    assert du_duplicate_bytes(DU_INT64_MAX, 3) == DU_INT64_MAX;
    assert du_saturating_add(DU_INT64_MAX, 1) == DU_INT64_MAX;
    assert du_saturating_add(2, 3) == 5;
    var a: [4096]u8 = [0; 4096];
    var b: [4096]u8 = [0; 4096];
    a[3] = 1;
    assert du_bytes_equal(a, b, 3) == true;
    assert du_bytes_equal(a, b, 4) == false;
}

test du_sha256_vectors {
    var state: [8]u32 = [0; 8];
    var tail: [4096]u8 = [0; 4096];
    var pad: [4096]u8 = [0; 4096];
    var hex: [4096]u8 = [0; 4096];
    // SHA-256("abc") = ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
    assert du_sha256_init(state) == 8;
    tail[0] = 97; tail[1] = 98; tail[2] = 99;
    assert du_sha256_padding(tail, 3, 3, pad) == 64;
    assert du_sha256_blocks(state, pad, 1) == 1;
    assert state[0] == 0xba7816bf;
    assert state[7] == 0xf20015ad;
    assert du_sha256_hex(state, hex) == 64;
    assert hex[0] == 98;
    assert hex[1] == 97;
    // 56 bytes of tail need two padding blocks
    assert du_sha256_padding(tail, 56, 56, pad) == 128;
    assert du_rotr(1, 1) == 0x80000000;
}
