// SPDX-License-Identifier: MIT
; Specs/format_rules.t27 -- DiskBloom: numbers the interface shows
; Short sizes ("3.55 GB"), singular or plural nouns, how full the disk is, and how often a running scan
; refreshes its progress line. Swift only turns the numbers this spec picks into text. ASCII only.
; Generated C: Sources/Generated/format_rules.h (Specs/generate.sh).

module DiskBloomFormatRules;

; --- Short sizes in decimal units -------------------------------------------------------------------
; B KB MB GB TB
pub const FM_UNIT_BYTES : [9]u8 = [66, 75, 66, 77, 66, 71, 66, 84, 66];
pub const FM_UNIT_OFFSETS : [5]u32 = [0, 1, 3, 5, 7];
pub const FM_UNIT_LENGTHS : [5]u32 = [1, 2, 2, 2, 2];
pub const FM_UNITS : u32 = 5;

; The unit a size is shown in: divide by 1000 while the value is at least 1000 and a larger unit exists.
pub fn fm_unit(bytes: i64) -> u32 {
    var value: f64 = 0.0;
    if (bytes > 0) { value = bytes; }
    var index: u32 = 0;
    while (value >= 1000.0 and index < FM_UNITS - 1) {
        value = value / 1000.0;
        index = index + 1;
    }
    return index;
}

pub fn fm_scaled(bytes: i64) -> f64 {
    var value: f64 = 0.0;
    if (bytes > 0) { value = bytes; }
    var index: u32 = 0;
    while (value >= 1000.0 and index < FM_UNITS - 1) {
        value = value / 1000.0;
        index = index + 1;
    }
    return value;
}

; Digits after the point: none for bytes or from 100 up, one from 10 up, two below 10.
pub fn fm_fraction_digits(value: f64, unit: u32) -> u32 {
    if (unit == 0) { return 0; }
    if (value >= 100.0) { return 0; }
    if (value >= 10.0) { return 1; }
    return 2;
}

pub fn fm_unit_text(unit: u32, out: [4096]u8) -> u32 {
    if (unit >= FM_UNITS) { return 0; }
    var i: u32 = 0;
    while (i < FM_UNIT_LENGTHS[unit]) {
        out[i] = FM_UNIT_BYTES[FM_UNIT_OFFSETS[unit] + i];
        i = i + 1;
    }
    return FM_UNIT_LENGTHS[unit];
}

; --- Nouns -------------------------------------------------------------------------------------------
pub fn fm_singular(count: i64) -> bool {
    return count == 1 or count == -1;
}

; --- How full the disk is -----------------------------------------------------------------------------
pub fn fm_used(total: i64, available: i64) -> i64 {
    var used: i64 = total - available;
    if (used < 0) { return 0; }
    return used;
}

pub fn fm_used_fraction(total: i64, available: i64) -> f64 {
    if (total <= 0) { return 0.0; }
    var used: f64 = fm_used(total, available);
    var whole: f64 = total;
    var fraction: f64 = used / whole;
    if (fraction < 0.0) { return 0.0; }
    if (fraction > 1.0) { return 1.0; }
    return fraction;
}

; --- Progress lines ---------------------------------------------------------------------------------------
; The disk scan shows a new current path every 32 items, or when it has none yet.
pub fn fm_scan_progress_shows(item_count: i64, has_path: bool) -> bool {
    return item_count % 32 == 0 or has_path == false;
}

; The duplicate finder shows the first examined file and then every 32nd.
pub fn fm_duplicate_progress_shows(examined: i64) -> bool {
    return examined == 1 or examined % 32 == 0;
}

test fm_sizes {
    assert fm_unit(0) == 0;
    assert fm_unit(999) == 0;
    assert fm_unit(1000) == 1;
    assert fm_unit(3550000000) == 3;
    assert fm_unit(-5) == 0;
    assert fm_unit(9000000000000000) == 4;
    assert fm_scaled(1500) == 1.5;
    assert fm_scaled(-2) == 0.0;
    assert fm_fraction_digits(5.0, 0) == 0;
    assert fm_fraction_digits(150.0, 2) == 0;
    assert fm_fraction_digits(15.0, 2) == 1;
    assert fm_fraction_digits(1.5, 2) == 2;
    var out: [4096]u8 = [0; 4096];
    assert fm_unit_text(1, out) == 2;
    assert out[0] == 75;
    assert fm_unit_text(5, out) == 0;
}

test fm_nouns_disk_progress {
    assert fm_singular(1) == true;
    assert fm_singular(-1) == true;
    assert fm_singular(2) == false;
    assert fm_used(10, 4) == 6;
    assert fm_used(4, 10) == 0;
    assert fm_used_fraction(0, 0) == 0.0;
    assert fm_used_fraction(4, 1) == 0.75;
    assert fm_used_fraction(4, 9) == 0.0;
    assert fm_scan_progress_shows(64, true) == true;
    assert fm_scan_progress_shows(3, true) == false;
    assert fm_scan_progress_shows(3, false) == true;
    assert fm_duplicate_progress_shows(1) == true;
    assert fm_duplicate_progress_shows(32) == true;
    assert fm_duplicate_progress_shows(33) == false;
}
