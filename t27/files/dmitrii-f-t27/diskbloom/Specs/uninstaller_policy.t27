// SPDX-License-Identifier: MIT
; Specs/uninstaller_policy.t27 -- DiskBloom App Uninstaller: what a removal plan offers and what may move
; Swift (Sources/AppRemoval.swift) finds an application, reads its signature, builds only pre-approved
; exact paths in ~/Library and measures them. This spec decides from those facts: what each rule is and
; how risky it is, which plan items start selected or are blocked, whether the application may be
; removed at all, whether one item may move right now, and whether an old plan may continue after the
; application already went to the Trash. The re-verification of the signature and the move loop itself
; stay in Swift: their order of disk work is the point of that code. ASCII only.
; Generated C: Sources/Generated/uninstaller_policy.h (Specs/generate.sh).

module DiskBloomUninstallerPolicy;

; --- Rules, in the order Swift declares AppRemovalRule -------------------------------------------
pub const UN_RULE_APPLICATION : u32 = 0;
pub const UN_RULE_ID_APPLICATION_SUPPORT : u32 = 1;
pub const UN_RULE_ID_CACHE : u32 = 2;
pub const UN_RULE_ID_PREFERENCE : u32 = 3;
pub const UN_RULE_ID_SAVED_STATE : u32 = 4;
pub const UN_RULE_ID_HTTP_STORAGE : u32 = 5;
pub const UN_RULE_ID_WEBKIT : u32 = 6;
pub const UN_RULE_ID_LOG : u32 = 7;
pub const UN_RULE_ID_COOKIE : u32 = 8;
pub const UN_RULE_ID_CONTAINER : u32 = 9;
pub const UN_RULE_ID_APPLICATION_SCRIPTS : u32 = 10;
pub const UN_RULE_ID_LAUNCH_AGENT : u32 = 11;
pub const UN_RULE_NAME_APPLICATION_SUPPORT : u32 = 12;
pub const UN_RULE_NAME_CACHE : u32 = 13;
pub const UN_RULE_NAME_PREFERENCE : u32 = 14;
pub const UN_RULE_NAME_SAVED_STATE : u32 = 15;
pub const UN_RULE_NAME_LOG : u32 = 16;
pub const UN_RULE_GROUP_CONTAINER : u32 = 17;
pub const UN_RULE_GROUP_APPLICATION_SCRIPTS : u32 = 18;
pub const UN_RULE_COUNT : u32 = 19;

; --- How a path was matched, and how risky it is --------------------------------------------------
pub const UN_MATCH_APPLICATION : u32 = 0;
pub const UN_MATCH_EXACT_ID : u32 = 1;
pub const UN_MATCH_EXACT_NAME : u32 = 2;
pub const UN_MATCH_GROUP : u32 = 3;

pub const UN_RISK_APPLICATION : u32 = 0;
pub const UN_RISK_DISPOSABLE : u32 = 1;
pub const UN_RISK_PERSISTENT : u32 = 2;
pub const UN_RISK_SHARED : u32 = 3;

; --- Trust in the bundle ID behind an exact-ID path ------------------------------------------------
pub const UN_TRUST_OK : u32 = 0;
pub const UN_TRUST_DUPLICATE : u32 = 1;
pub const UN_TRUST_UNSIGNED : u32 = 2;

; --- Why a measured item is incomplete -------------------------------------------------------------
pub const UN_SNAP_OK : u32 = 0;
pub const UN_SNAP_INCOMPLETE : u32 = 1;
pub const UN_SNAP_UNREADABLE : u32 = 2;
pub const UN_SNAP_FOREIGN_MOUNT : u32 = 3;

; --- What blocks a plan item from being selected ----------------------------------------------------
pub const UN_BLOCK_NONE : u32 = 0;
pub const UN_BLOCK_SNAPSHOT : u32 = 1;
pub const UN_BLOCK_APPLICATION : u32 = 2;

; --- Why the application itself may not be removed --------------------------------------------------
pub const UN_APP_OK : u32 = 0;
pub const UN_APP_NOT_BUNDLE : u32 = 1;
pub const UN_APP_SYMLINK : u32 = 2;
pub const UN_APP_SYSTEM : u32 = 3;
pub const UN_APP_APPLE : u32 = 4;
pub const UN_APP_SELF : u32 = 5;
pub const UN_APP_USER_ROOT : u32 = 6;
pub const UN_APP_IN_TRASH : u32 = 7;
pub const UN_APP_TYPE_UNCONFIRMED : u32 = 8;
pub const UN_APP_NETWORK : u32 = 9;
pub const UN_APP_READ_ONLY : u32 = 10;
pub const UN_APP_CLOUD : u32 = 11;

; --- Why one item may not move right now -----------------------------------------------------------
pub const UN_ITEM_OK : u32 = 0;
pub const UN_ITEM_APPLICATION : u32 = 1;
pub const UN_ITEM_BLOCKED : u32 = 2;
pub const UN_ITEM_UNSAFE_KEY : u32 = 3;
pub const UN_ITEM_PATH_CHANGED : u32 = 4;
pub const UN_ITEM_RULE_MISMATCH : u32 = 5;
pub const UN_ITEM_SYMLINK : u32 = 6;
pub const UN_ITEM_VOLUME_UNKNOWN : u32 = 7;
pub const UN_ITEM_NOT_LOCAL : u32 = 8;
pub const UN_ITEM_READ_ONLY : u32 = 9;
pub const UN_ITEM_CLOUD : u32 = 10;
pub const UN_ITEM_BUNDLE_ID_CHANGED : u32 = 11;
pub const UN_ITEM_OUTSIDE_LIBRARY : u32 = 12;

; --- Why an old plan may not continue after the application moved -----------------------------------
pub const UN_CONT_OK : u32 = 0;
pub const UN_CONT_SAME_ID_INSTALLED : u32 = 1;
pub const UN_CONT_REGISTERED_COPY : u32 = 2;
pub const UN_CONT_SAME_NAME_INSTALLED : u32 = 3;
pub const UN_CONT_REAPPEARED : u32 = 4;
pub const UN_CONT_RUNNING : u32 = 5;

; --- The rule tables ---------------------------------------------------------------------------------

pub fn un_rule_match(rule: u32) -> u32 {
    if (rule == UN_RULE_APPLICATION) { return UN_MATCH_APPLICATION; }
    if (rule >= UN_RULE_NAME_APPLICATION_SUPPORT and rule <= UN_RULE_NAME_LOG) { return UN_MATCH_EXACT_NAME; }
    if (rule == UN_RULE_GROUP_CONTAINER or rule == UN_RULE_GROUP_APPLICATION_SCRIPTS) { return UN_MATCH_GROUP; }
    return UN_MATCH_EXACT_ID;
}

pub fn un_rule_risk(rule: u32) -> u32 {
    if (rule == UN_RULE_APPLICATION) { return UN_RISK_APPLICATION; }
    if (rule == UN_RULE_ID_APPLICATION_SUPPORT or rule == UN_RULE_ID_CONTAINER) { return UN_RISK_PERSISTENT; }
    if (rule == UN_RULE_ID_APPLICATION_SCRIPTS or rule == UN_RULE_NAME_APPLICATION_SUPPORT) { return UN_RISK_PERSISTENT; }
    if (rule == UN_RULE_GROUP_CONTAINER or rule == UN_RULE_GROUP_APPLICATION_SCRIPTS) { return UN_RISK_SHARED; }
    if (rule >= UN_RULE_NAME_CACHE and rule <= UN_RULE_NAME_LOG) { return UN_RISK_SHARED; }
    return UN_RISK_DISPOSABLE;
}

; Selected without asking: the bundle and the low-risk exact-ID state an app recreates.
pub fn un_rule_normally_selected(rule: u32) -> bool {
    if (rule == UN_RULE_APPLICATION) { return true; }
    if (rule >= UN_RULE_ID_CACHE and rule <= UN_RULE_ID_COOKIE) { return true; }
    return false;
}

pub fn un_risk_needs_acknowledgement(risk: u32) -> bool {
    return risk == UN_RISK_PERSISTENT or risk == UN_RISK_SHARED;
}

; --- One item of a removal plan ---------------------------------------------------------------------
; Facts:
;   duplicate          another installed application declares the same bundle ID
;   signature_backed   the bundle ID is the signing identifier of a strictly valid signature with an
;                      Apple trust anchor and a non-empty Team ID, read from an unchanged bundle

pub fn un_trust(rule: u32, duplicate: bool, signature_backed: bool) -> u32 {
    if (un_rule_match(rule) != UN_MATCH_EXACT_ID) { return UN_TRUST_OK; }
    if (duplicate) { return UN_TRUST_DUPLICATE; }
    if (signature_backed == false) { return UN_TRUST_UNSIGNED; }
    return UN_TRUST_OK;
}

; An exact-ID path whose bundle ID is not trusted stays selectable, but counts as shared data.
pub fn un_effective_risk(rule: u32, duplicate: bool, signature_backed: bool) -> u32 {
    if (un_trust(rule, duplicate, signature_backed) != UN_TRUST_OK) { return UN_RISK_SHARED; }
    return un_rule_risk(rule);
}

pub fn un_snapshot_issue(complete: bool, unreadable: bool, foreign_mount: bool) -> u32 {
    if (complete == false) { return UN_SNAP_INCOMPLETE; }
    if (unreadable) { return UN_SNAP_UNREADABLE; }
    if (foreign_mount) { return UN_SNAP_FOREIGN_MOUNT; }
    return UN_SNAP_OK;
}

; A related item is blocked only by an incomplete measurement; the bundle also by its own ineligibility.
pub fn un_item_block(snapshot_issue: u32, required: bool, application_ineligible: bool) -> u32 {
    if (snapshot_issue != UN_SNAP_OK) { return UN_BLOCK_SNAPSHOT; }
    if (required and application_ineligible) { return UN_BLOCK_APPLICATION; }
    return UN_BLOCK_NONE;
}

pub fn un_selected_by_default(rule: u32, duplicate: bool, signature_backed: bool, block: u32) -> bool {
    if (block != UN_BLOCK_NONE) { return false; }
    if (rule == UN_RULE_APPLICATION) { return true; }
    if (un_rule_match(rule) != UN_MATCH_EXACT_ID) { return false; }
    if (duplicate or signature_backed == false) { return false; }
    return un_rule_normally_selected(rule);
}

; --- May this application be removed at all? -----------------------------------------------------------
; Facts, checked in this order:
;   app_extension      the path ends in .app
;   symlinked          a component of the path is a symbolic link
;   system_root        under /System, /usr, /bin, /sbin, /private or /Library
;   apple_id           the bundle ID starts with com.apple.
;   is_self            the bundle is the running DiskBloom or contains it
;   protected_user     under ~/Library, ~/.Trash or a cloud folder in the home folder
;   in_trash           a path component is .Trash or .Trashes
;   type_confirmed     the item reports itself as a directory and a package, not a link
;   volume_local, volume_read_only, ubiquitous

pub fn un_application_issue(app_extension: bool, symlinked: bool, system_root: bool, apple_id: bool, is_self: bool, protected_user: bool, in_trash: bool, type_confirmed: bool, volume_local: bool, volume_read_only: bool, ubiquitous: bool) -> u32 {
    if (app_extension == false) { return UN_APP_NOT_BUNDLE; }
    if (symlinked) { return UN_APP_SYMLINK; }
    if (system_root) { return UN_APP_SYSTEM; }
    if (apple_id) { return UN_APP_APPLE; }
    if (is_self) { return UN_APP_SELF; }
    if (protected_user) { return UN_APP_USER_ROOT; }
    if (in_trash) { return UN_APP_IN_TRASH; }
    if (type_confirmed == false) { return UN_APP_TYPE_UNCONFIRMED; }
    if (volume_local == false) { return UN_APP_NETWORK; }
    if (volume_read_only) { return UN_APP_READ_ONLY; }
    if (ubiquitous) { return UN_APP_CLOUD; }
    return UN_APP_OK;
}

; --- May this item move right now? ---------------------------------------------------------------------
; Swift runs the snapshot comparison only after UN_ITEM_OK.
;   application_blocked  the application must still be present and is not eligible
;   item_blocked         the plan marked the item as blocked
;   key_safe             the identifier or name the path was built from still passes its safety check
;   path_unchanged       the coordinated path is the planned path
;   rule_matches         the rule rebuilds exactly this path from the key
;   symlinked, volume_readable, volume_local, volume_read_only, ubiquitous
;   is_application       the item is the bundle itself
;   bundle_id_unchanged  (bundle) the bundle still declares the analysed bundle ID
;   inside_library       (related item) strictly inside ~/Library

pub fn un_item_issue(application_blocked: bool, item_blocked: bool, key_safe: bool, path_unchanged: bool, rule_matches: bool, symlinked: bool, volume_readable: bool, volume_local: bool, volume_read_only: bool, ubiquitous: bool, is_application: bool, bundle_id_unchanged: bool, inside_library: bool) -> u32 {
    if (application_blocked) { return UN_ITEM_APPLICATION; }
    if (item_blocked) { return UN_ITEM_BLOCKED; }
    if (key_safe == false) { return UN_ITEM_UNSAFE_KEY; }
    if (path_unchanged == false) { return UN_ITEM_PATH_CHANGED; }
    if (rule_matches == false) { return UN_ITEM_RULE_MISMATCH; }
    if (symlinked) { return UN_ITEM_SYMLINK; }
    if (volume_readable == false) { return UN_ITEM_VOLUME_UNKNOWN; }
    if (volume_local == false) { return UN_ITEM_NOT_LOCAL; }
    if (volume_read_only) { return UN_ITEM_READ_ONLY; }
    if (ubiquitous) { return UN_ITEM_CLOUD; }
    if (is_application) {
        if (bundle_id_unchanged == false) { return UN_ITEM_BUNDLE_ID_CHANGED; }
        return UN_ITEM_OK;
    }
    if (inside_library == false) { return UN_ITEM_OUTSIDE_LIBRARY; }
    return UN_ITEM_OK;
}

; --- May an old plan continue after the application went to the Trash? -------------------------------
;   has_identifier          the analysed application had a bundle ID
;   same_id_installed       a standard application folder holds a copy with that bundle ID
;   registered_copy         LaunchServices knows another existing copy outside the Trash
;   same_name_installed     (no bundle ID) an installed application has the same name
;   original_exists         something exists again at the original path
;   running                 a process of the application is running

pub fn un_continuation(has_identifier: bool, same_id_installed: bool, registered_copy: bool, same_name_installed: bool, original_exists: bool, running: bool) -> u32 {
    if (has_identifier) {
        if (same_id_installed) { return UN_CONT_SAME_ID_INSTALLED; }
        if (registered_copy) { return UN_CONT_REGISTERED_COPY; }
    }
    if (has_identifier == false and same_name_installed) { return UN_CONT_SAME_NAME_INSTALLED; }
    if (original_exists) { return UN_CONT_REAPPEARED; }
    if (running) { return UN_CONT_RUNNING; }
    return UN_CONT_OK;
}

; --- Plan order ------------------------------------------------------------------------------------
; The bundle first, then items selected by default; ties fall back to the paths.
pub const UN_ORDER_FIRST : u32 = 0;
pub const UN_ORDER_SECOND : u32 = 1;
pub const UN_ORDER_TIE : u32 = 2;

pub fn un_plan_order(required_a: bool, required_b: bool, default_a: bool, default_b: bool) -> u32 {
    if (required_a != required_b) {
        if (required_a) { return UN_ORDER_FIRST; }
        return UN_ORDER_SECOND;
    }
    if (default_a != default_b) {
        if (default_a) { return UN_ORDER_FIRST; }
        return UN_ORDER_SECOND;
    }
    return UN_ORDER_TIE;
}

; The move queue: the bundle first; ties fall back to the paths.
pub fn un_queue_order(required_a: bool, required_b: bool) -> u32 {
    if (required_a != required_b) {
        if (required_a) { return UN_ORDER_FIRST; }
        return UN_ORDER_SECOND;
    }
    return UN_ORDER_TIE;
}

; --- Laws ------------------------------------------------------------------------------------------------
invariant un_ok_codes_are_zero { assert UN_APP_OK == 0 and UN_ITEM_OK == 0 and UN_CONT_OK == 0 and UN_BLOCK_NONE == 0; }
invariant un_rules_are_contiguous { assert UN_RULE_GROUP_APPLICATION_SCRIPTS + 1 == UN_RULE_COUNT; }

test un_rule_tables {
    assert un_rule_match(UN_RULE_APPLICATION) == UN_MATCH_APPLICATION;
    assert un_rule_match(UN_RULE_ID_CACHE) == UN_MATCH_EXACT_ID;
    assert un_rule_match(UN_RULE_ID_LAUNCH_AGENT) == UN_MATCH_EXACT_ID;
    assert un_rule_match(UN_RULE_NAME_APPLICATION_SUPPORT) == UN_MATCH_EXACT_NAME;
    assert un_rule_match(UN_RULE_NAME_LOG) == UN_MATCH_EXACT_NAME;
    assert un_rule_match(UN_RULE_GROUP_CONTAINER) == UN_MATCH_GROUP;
    assert un_rule_risk(UN_RULE_APPLICATION) == UN_RISK_APPLICATION;
    assert un_rule_risk(UN_RULE_ID_CACHE) == UN_RISK_DISPOSABLE;
    assert un_rule_risk(UN_RULE_ID_LAUNCH_AGENT) == UN_RISK_DISPOSABLE;
    assert un_rule_risk(UN_RULE_ID_CONTAINER) == UN_RISK_PERSISTENT;
    assert un_rule_risk(UN_RULE_NAME_APPLICATION_SUPPORT) == UN_RISK_PERSISTENT;
    assert un_rule_risk(UN_RULE_NAME_CACHE) == UN_RISK_SHARED;
    assert un_rule_risk(UN_RULE_GROUP_APPLICATION_SCRIPTS) == UN_RISK_SHARED;
    assert un_rule_normally_selected(UN_RULE_ID_COOKIE) == true;
    assert un_rule_normally_selected(UN_RULE_ID_APPLICATION_SUPPORT) == false;
    assert un_rule_normally_selected(UN_RULE_ID_CONTAINER) == false;
    assert un_rule_normally_selected(UN_RULE_NAME_CACHE) == false;
    assert un_risk_needs_acknowledgement(UN_RISK_SHARED) == true;
    assert un_risk_needs_acknowledgement(UN_RISK_DISPOSABLE) == false;
}

test un_untrusted_ids_turn_default_selection_off {
    assert un_selected_by_default(UN_RULE_ID_CACHE, false, true, UN_BLOCK_NONE) == true;
    assert un_selected_by_default(UN_RULE_ID_CACHE, true, true, UN_BLOCK_NONE) == false;
    assert un_selected_by_default(UN_RULE_ID_CACHE, false, false, UN_BLOCK_NONE) == false;
    assert un_selected_by_default(UN_RULE_APPLICATION, true, false, UN_BLOCK_NONE) == true;
    assert un_selected_by_default(UN_RULE_APPLICATION, false, true, UN_BLOCK_APPLICATION) == false;
    assert un_selected_by_default(UN_RULE_NAME_CACHE, false, true, UN_BLOCK_NONE) == false;
    assert un_selected_by_default(UN_RULE_ID_CACHE, false, true, UN_BLOCK_SNAPSHOT) == false;
    assert un_trust(UN_RULE_ID_CACHE, true, true) == UN_TRUST_DUPLICATE;
    assert un_trust(UN_RULE_ID_CACHE, false, false) == UN_TRUST_UNSIGNED;
    assert un_trust(UN_RULE_GROUP_CONTAINER, true, false) == UN_TRUST_OK;
    assert un_effective_risk(UN_RULE_ID_CACHE, false, false) == UN_RISK_SHARED;
    assert un_effective_risk(UN_RULE_ID_CACHE, false, true) == UN_RISK_DISPOSABLE;
}

test un_incomplete_measurements_block_items {
    assert un_snapshot_issue(false, true, true) == UN_SNAP_INCOMPLETE;
    assert un_snapshot_issue(true, true, true) == UN_SNAP_UNREADABLE;
    assert un_snapshot_issue(true, false, true) == UN_SNAP_FOREIGN_MOUNT;
    assert un_snapshot_issue(true, false, false) == UN_SNAP_OK;
    assert un_item_block(UN_SNAP_UNREADABLE, false, false) == UN_BLOCK_SNAPSHOT;
    assert un_item_block(UN_SNAP_OK, true, true) == UN_BLOCK_APPLICATION;
    assert un_item_block(UN_SNAP_OK, false, true) == UN_BLOCK_NONE;
}

test un_application_checks_in_order {
    assert un_application_issue(true, false, false, false, false, false, false, true, true, false, false) == UN_APP_OK;
    assert un_application_issue(false, true, true, true, true, true, true, false, false, true, true) == UN_APP_NOT_BUNDLE;
    assert un_application_issue(true, true, true, true, true, true, true, false, false, true, true) == UN_APP_SYMLINK;
    assert un_application_issue(true, false, true, true, true, true, true, false, false, true, true) == UN_APP_SYSTEM;
    assert un_application_issue(true, false, false, true, true, true, true, false, false, true, true) == UN_APP_APPLE;
    assert un_application_issue(true, false, false, false, true, true, true, false, false, true, true) == UN_APP_SELF;
    assert un_application_issue(true, false, false, false, false, true, true, false, false, true, true) == UN_APP_USER_ROOT;
    assert un_application_issue(true, false, false, false, false, false, true, false, false, true, true) == UN_APP_IN_TRASH;
    assert un_application_issue(true, false, false, false, false, false, false, false, false, true, true) == UN_APP_TYPE_UNCONFIRMED;
    assert un_application_issue(true, false, false, false, false, false, false, true, false, true, true) == UN_APP_NETWORK;
    assert un_application_issue(true, false, false, false, false, false, false, true, true, true, true) == UN_APP_READ_ONLY;
    assert un_application_issue(true, false, false, false, false, false, false, true, true, false, true) == UN_APP_CLOUD;
}

test un_item_checks_in_order {
    assert un_item_issue(false, false, true, true, true, false, true, true, false, false, true, true, false) == UN_ITEM_OK;
    assert un_item_issue(false, false, true, true, true, false, true, true, false, false, false, false, true) == UN_ITEM_OK;
    assert un_item_issue(true, true, false, false, false, true, false, false, true, true, false, false, false) == UN_ITEM_APPLICATION;
    assert un_item_issue(false, true, false, false, false, true, false, false, true, true, false, false, false) == UN_ITEM_BLOCKED;
    assert un_item_issue(false, false, false, false, false, true, false, false, true, true, false, false, false) == UN_ITEM_UNSAFE_KEY;
    assert un_item_issue(false, false, true, false, false, true, false, false, true, true, false, false, false) == UN_ITEM_PATH_CHANGED;
    assert un_item_issue(false, false, true, true, false, true, false, false, true, true, false, false, false) == UN_ITEM_RULE_MISMATCH;
    assert un_item_issue(false, false, true, true, true, true, false, false, true, true, false, false, false) == UN_ITEM_SYMLINK;
    assert un_item_issue(false, false, true, true, true, false, false, false, true, true, false, false, false) == UN_ITEM_VOLUME_UNKNOWN;
    assert un_item_issue(false, false, true, true, true, false, true, false, true, true, false, false, false) == UN_ITEM_NOT_LOCAL;
    assert un_item_issue(false, false, true, true, true, false, true, true, true, true, false, false, false) == UN_ITEM_READ_ONLY;
    assert un_item_issue(false, false, true, true, true, false, true, true, false, true, false, false, false) == UN_ITEM_CLOUD;
    assert un_item_issue(false, false, true, true, true, false, true, true, false, false, true, false, true) == UN_ITEM_BUNDLE_ID_CHANGED;
    assert un_item_issue(false, false, true, true, true, false, true, true, false, false, false, true, false) == UN_ITEM_OUTSIDE_LIBRARY;
}

test un_an_old_plan_stops_when_any_copy_returns {
    assert un_continuation(true, false, false, true, false, false) == UN_CONT_OK;
    assert un_continuation(true, true, true, true, true, true) == UN_CONT_SAME_ID_INSTALLED;
    assert un_continuation(true, false, true, true, true, true) == UN_CONT_REGISTERED_COPY;
    assert un_continuation(false, true, true, true, true, true) == UN_CONT_SAME_NAME_INSTALLED;
    assert un_continuation(false, true, true, false, true, true) == UN_CONT_REAPPEARED;
    assert un_continuation(true, false, false, false, false, true) == UN_CONT_RUNNING;
}

test un_orders {
    assert un_plan_order(true, false, false, true) == UN_ORDER_FIRST;
    assert un_plan_order(false, true, true, false) == UN_ORDER_SECOND;
    assert un_plan_order(false, false, true, false) == UN_ORDER_FIRST;
    assert un_plan_order(false, false, false, true) == UN_ORDER_SECOND;
    assert un_plan_order(true, true, true, true) == UN_ORDER_TIE;
    assert un_queue_order(true, false) == UN_ORDER_FIRST;
    assert un_queue_order(false, true) == UN_ORDER_SECOND;
    assert un_queue_order(false, false) == UN_ORDER_TIE;
}
