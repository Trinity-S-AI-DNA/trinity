// SPDX-License-Identifier: MIT
; Specs/assistant_rules.t27 -- DiskBloom assistant: how its words, paths, addresses and replies are read
; The assistant (Sources/Assistant.swift, Sources/AssistantBackends.swift) talks to a model and runs
; tools. This spec decides which section or cache filter a tool argument names, what form a path the
; model gives has, how a path is shown, how an API address is normalised and whether it is local,
; which models can chat and which handle tools, what an HTTP error means, where old conversation turns
; are cut, how reasoning in <think> tags is removed from a reply, and when choosing a provider replaces
; the model. Swift lowercases and trims Unicode text before asking, and keeps the texts users read.
; Generated C: Sources/Generated/assistant_rules.h (Specs/generate.sh). Table texts are UTF-8.

module DiskBloomAssistantRules;

pub const AS_TABLE_SECTION : u32 = 0;
pub const AS_TABLE_VERDICT : u32 = 1;
pub const AS_TABLE_LOCAL_HOST : u32 = 2;
pub const AS_TABLE_NON_CHAT : u32 = 3;
pub const AS_TABLE_TOOL_FAMILY : u32 = 4;
pub const AS_TABLE_YES_WORD : u32 = 5;
pub const AS_TABLE_HTTP_HINT : u32 = 6;
pub const AS_NONE : u32 = 4294967295;
pub const AS_REPLY_MAX : u32 = 1048576;

