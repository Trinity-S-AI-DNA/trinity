; --- Rows ------------------------------------------------------------------------------------------------
pub fn as_row_matches(row: u32, text: [4096]u8, len: u32, how: u32) -> bool {
    // how: 0 equal, 1 contained, 2 suffix
    if (row >= AS_ROWS) { return false; }
    var plen: u32 = AS_ROW_F0_LENGTH[row];
    var start: u32 = AS_ROW_F0_OFFSET[row];
    if (len < plen) { return false; }
    if (how == 0 and len != plen) { return false; }
    var first: u32 = 0;
    var last: u32 = len - plen;
    if (how == 0) { last = 0; }
    if (how == 2) { first = len - plen; }
    var at: u32 = first;
    while (at <= last) {
        var same: bool = true;
        var i: u32 = 0;
        while (i < plen) {
            if (text[at + i] != AS_TEXT[start + i]) { same = false; }
            i = i + 1;
        }
        if (same) { return true; }
        at = at + 1;
    }
    return false;
}

pub fn as_find(table: u32, text: [4096]u8, len: u32, how: u32) -> u32 {
    if (len > 4096) { return AS_NONE; }
    var row: u32 = 0;
    while (row < AS_ROWS) {
        if (AS_ROW_TABLE[row] == table and as_row_matches(row, text, len, how)) { return row; }
        row = row + 1;
    }
    return AS_NONE;
}

pub fn as_row_code(row: u32) -> u32 {
    if (row >= AS_ROWS) { return AS_NONE; }
    return AS_ROW_CODE[row];
}

pub fn as_row_text(row: u32, field: u32, out: [4096]u8) -> u32 {
    if (row >= AS_ROWS) { return 0; }
    var start: u32 = AS_ROW_F0_OFFSET[row];
    var length: u32 = AS_ROW_F0_LENGTH[row];
    if (field == 1) {
        start = AS_ROW_F1_OFFSET[row];
        length = AS_ROW_F1_LENGTH[row];
    }
    var i: u32 = 0;
    while (i < length) {
        out[i] = AS_TEXT[start + i];
        i = i + 1;
    }
    return length;
}

; --- Tool arguments (already lowercased by Swift) --------------------------------------------------------
; A section name: spaces count as underscores. Returns the WorkspaceSection index or AS_NONE.
pub fn as_section(lower: [4096]u8, len: u32) -> u32 {
    if (len > 4096) { return AS_NONE; }
    var name: [4096]u8 = [0; 4096];
    var i: u32 = 0;
    while (i < len) {
        var c: u8 = lower[i];
        if (c == 32) { c = 95; }
        name[i] = c;
        i = i + 1;
    }
    return as_row_code(as_find(AS_TABLE_SECTION, name, len, 0));
}

; A cache filter name: the CV_* verdict code, or AS_NONE for "all" and anything unknown.
pub fn as_verdict(lower: [4096]u8, len: u32) -> u32 {
    return as_row_code(as_find(AS_TABLE_VERDICT, lower, len, 0));
}

pub fn as_yes_word(lower: [4096]u8, len: u32) -> bool {
    return as_find(AS_TABLE_YES_WORD, lower, len, 0) != AS_NONE;
}

; --- Paths the model gives ----------------------------------------------------------------------------------
pub const AS_PATH_EMPTY : u32 = 0;
pub const AS_PATH_HOME : u32 = 1;
pub const AS_PATH_UNDER_HOME : u32 = 2;
pub const AS_PATH_RELATIVE : u32 = 3;
pub const AS_PATH_ABSOLUTE : u32 = 4;

; On the trimmed text: "" none, "~" home, "~/x" under home (drop the "~"), "x" relative to home, "/x" as is.
pub fn as_path_form(text: [4096]u8, len: u32) -> u32 {
    if (len == 0) { return AS_PATH_EMPTY; }
    if (len == 1 and text[0] == 126) { return AS_PATH_HOME; }
    if (len >= 2 and text[0] == 126 and text[1] == 47) { return AS_PATH_UNDER_HOME; }
    if (text[0] != 47) { return AS_PATH_RELATIVE; }
    return AS_PATH_ABSOLUTE;
}

pub const AS_SHOW_HOME : u32 = 0;
pub const AS_SHOW_TILDE : u32 = 1;
pub const AS_SHOW_FULL : u32 = 2;

; How a path is shown: the home folder as "Home", anything inside it from "~", the rest in full.
pub fn as_display_form(same_as_home: bool, inside_home: bool) -> u32 {
    if (same_as_home) { return AS_SHOW_HOME; }
    if (inside_home) { return AS_SHOW_TILDE; }
    return AS_SHOW_FULL;
}

; --- API addresses -----------------------------------------------------------------------------------------
; The length of the trimmed address after dropping trailing slashes, then "/chat/completions",
; then "/models" (each at most once, in that order).
pub const AS_W_COMPLETIONS : [17]u8 = [47, 99, 104, 97, 116, 47, 99, 111, 109, 112, 108, 101, 116, 105, 111, 110, 115];
pub const AS_W_MODELS : [7]u8 = [47, 109, 111, 100, 101, 108, 115];

pub fn as_ends_with(text: [4096]u8, len: u32, word: u32) -> bool {
    var wlen: u32 = 17;
    if (word == 1) { wlen = 7; }
    if (len < wlen) { return false; }
    var i: u32 = 0;
    while (i < wlen) {
        var expected: u8 = AS_W_COMPLETIONS[0];
        if (word == 0) { expected = AS_W_COMPLETIONS[i]; } else { expected = AS_W_MODELS[i]; }
        if (text[len - wlen + i] != expected) { return false; }
        i = i + 1;
    }
    return true;
}

pub fn as_base_url_length(text: [4096]u8, len: u32) -> u32 {
    if (len > 4096) { return len; }
    var n: u32 = len;
    while (n > 0 and text[n - 1] == 47) { n = n - 1; }
    if (as_ends_with(text, n, 0)) { n = n - 17; }
    if (as_ends_with(text, n, 1)) { n = n - 7; }
    return n;
}

; A host (lowercased) that never leaves this Mac.
pub fn as_local_host(lower: [4096]u8, len: u32) -> bool {
    if (as_find(AS_TABLE_LOCAL_HOST, lower, len, 0) != AS_NONE) { return true; }
    if (len < 6) { return false; }
    return lower[len - 6] == 46 and lower[len - 5] == 108 and lower[len - 4] == 111 and lower[len - 3] == 99 and lower[len - 2] == 97 and lower[len - 1] == 108;
}

; --- Models (identifiers lowercased) -------------------------------------------------------------------------
pub fn as_chat_model(lower: [4096]u8, len: u32) -> bool {
    return as_find(AS_TABLE_NON_CHAT, lower, len, 1) == AS_NONE;
}

; Recommended for the assistant: the provider says it takes tools, or (when it does not say) its
; family is known to handle them; never a model that cannot chat.
pub fn as_recommended_model(lower: [4096]u8, len: u32, declared: bool, declares_tools: bool) -> bool {
    var chat: bool = as_chat_model(lower, len);
    if (declared) { return declares_tools and chat; }
    return chat and as_find(AS_TABLE_TOOL_FAMILY, lower, len, 1) != AS_NONE;
}

; Choosing a provider replaces the model when none is set or it is not one of the provider's suggestions.
pub fn as_replace_model(has_suggestion: bool, model_empty: bool, model_suggested: bool) -> bool {
    return has_suggestion and (model_empty or model_suggested == false);
}

; --- HTTP errors ----------------------------------------------------------------------------------------------
; The row of the hint for an HTTP status, or AS_NONE.
pub fn as_http_hint_row(status: u32) -> u32 {
    var row: u32 = 0;
    while (row < AS_ROWS) {
        if (AS_ROW_TABLE[row] == AS_TABLE_HTTP_HINT and AS_ROW_CODE[row] == status) { return row; }
        row = row + 1;
    }
    return AS_NONE;
}

pub fn as_http_ok(status: i64) -> bool {
    return status >= 200 and status < 300;
}

; --- Conversation ---------------------------------------------------------------------------------------------
; roles: 1 for a user turn, 0 otherwise. With more than `keep` entries, drop old ones but cut only at a
; user turn, so a tool call keeps its result; returns the first kept index (the system prompt, entry 0,
; always stays), or 0 when nothing is dropped.
pub fn as_history_cut(roles: [4096]u8, count: u32, keep: u32) -> u32 {
    if (count <= keep or count > 4096) { return 0; }
    var index: u32 = count - keep;
    while (index < count and roles[index] != 1) { index = index + 1; }
    if (index >= count) { return 0; }
    return index;
}

; Removes "<think> ... </think>" blocks from a reply the way the replaced Swift did: find the first
; "<think>", cut through the first "</think>" after it (or to the end when there is none), and look again
; from the start, so a tag that only forms after a cut is removed too. Works in place in out; returns
; the remaining length. A reply longer than AS_REPLY_MAX is left as it is (length returned unchanged).
pub fn as_is_open_tag(t: [1048576]u8, n: u32, at: u32) -> bool {
    if (at + 7 > n) { return false; }
    return t[at] == 60 and t[at + 1] == 116 and t[at + 2] == 104 and t[at + 3] == 105 and t[at + 4] == 110 and t[at + 5] == 107 and t[at + 6] == 62;
}

pub fn as_is_close_tag(t: [1048576]u8, n: u32, at: u32) -> bool {
    if (at + 8 > n) { return false; }
    return t[at] == 60 and t[at + 1] == 47 and t[at + 2] == 116 and t[at + 3] == 104 and t[at + 4] == 105 and t[at + 5] == 110 and t[at + 6] == 107 and t[at + 7] == 62;
}

pub fn as_strip_thinking(text: [1048576]u8, len: u32, out: [1048576]u8) -> u32 {
    var n: u32 = len;
    var i: u32 = 0;
    while (i < len and i < AS_REPLY_MAX) { out[i] = text[i]; i = i + 1; }
    if (len > AS_REPLY_MAX) { return len; }
    var searching: bool = true;
    while (searching) {
        var start: u32 = 0;
        var found: bool = false;
        while (start < n and found == false) {
            if (as_is_open_tag(out, n, start)) { found = true; } else { start = start + 1; }
        }
        if (found == false) {
            searching = false;
        } else {
            var end: u32 = n;
            var k: u32 = start + 7;
            var closed: bool = false;
            while (k < n and closed == false) {
                if (as_is_close_tag(out, n, k)) { closed = true; end = k + 8; } else { k = k + 1; }
            }
            var removed: u32 = end - start;
            var m: u32 = start;
            while (m + removed < n) {
                out[m] = out[m + removed];
                m = m + 1;
            }
            n = n - removed;
        }
    }
    return n;
}

; --- Conversation turns ------------------------------------------------------------------------------
pub const AS_MAX_TOOL_ROUNDS : u32 = 8;

; A message is sent only with text and while no answer is pending.
pub fn as_can_send(text_empty: bool, thinking: bool) -> bool {
    return text_empty == false and thinking == false;
}

; A model message without tool calls is the final answer; after AS_MAX_TOOL_ROUNDS rounds the
; assistant stops asking.
pub fn as_reply_is_final(tool_calls: u32) -> bool {
    return tool_calls == 0;
}

pub fn as_another_round(rounds_done: u32) -> bool {
    return rounds_done < AS_MAX_TOOL_ROUNDS;
}

; A JSON number is written without a fraction when it is whole.
pub fn as_is_whole(value: f64) -> bool {
    var truncated: i64 = value;
    var back: f64 = truncated;
    return back == value;
}

; --- What each tool does -------------------------------------------------------------------------------
pub const AS_MAP_SCANNING : u32 = 0;
pub const AS_MAP_SHOWS : u32 = 1;
pub const AS_MAP_EMPTY : u32 = 2;

pub fn as_overview_map(scanning: bool, has_focus: bool) -> u32 {
    if (scanning) { return AS_MAP_SCANNING; }
    if (has_focus) { return AS_MAP_SHOWS; }
    return AS_MAP_EMPTY;
}

; largest_items: open the given folder (focus it if the map already holds it, scan it otherwise), refuse
; a file, or with no path use the map that is open, starting the home scan if nothing is.
pub const AS_LARGEST_NO_SUCH_PATH : u32 = 0;
pub const AS_LARGEST_FOCUSED : u32 = 1;
pub const AS_LARGEST_NOT_A_FOLDER : u32 = 2;
pub const AS_LARGEST_SCAN_FOLDER : u32 = 3;
pub const AS_LARGEST_START_CURRENT : u32 = 4;
pub const AS_LARGEST_USE_CURRENT : u32 = 5;

pub fn as_largest_plan(has_path: bool, path_exists: bool, focused: bool, is_folder: bool, has_focus: bool, scanning: bool) -> u32 {
    if (has_path) {
        if (path_exists == false) { return AS_LARGEST_NO_SUCH_PATH; }
        if (focused) { return AS_LARGEST_FOCUSED; }
        if (is_folder == false) { return AS_LARGEST_NOT_A_FOLDER; }
        return AS_LARGEST_SCAN_FOLDER;
    }
    if (has_focus == false and scanning == false) { return AS_LARGEST_START_CURRENT; }
    return AS_LARGEST_USE_CURRENT;
}

; After waiting for a scan: still running, nothing measured, or results.
pub const AS_WAIT_STILL_RUNNING : u32 = 0;
pub const AS_WAIT_NOTHING : u32 = 1;
pub const AS_WAIT_READY : u32 = 2;

pub fn as_after_wait(still_running: bool, has_result: bool) -> u32 {
    if (still_running) { return AS_WAIT_STILL_RUNNING; }
    if (has_result == false) { return AS_WAIT_NOTHING; }
    return AS_WAIT_READY;
}

pub fn as_should_start_measuring(has_analysis: bool, scanning: bool) -> bool {
    return has_analysis == false and scanning == false;
}

; select_caches
pub const AS_SELECT_NOT_MEASURED : u32 = 0;
pub const AS_SELECT_UNKNOWN_REFS : u32 = 1;
pub const AS_SELECT_ONLY_REFUSED : u32 = 2;
pub const AS_SELECT_DONE : u32 = 3;
pub const AS_SELECT_DONE_WITH_SKIPPED : u32 = 4;

pub fn as_select_plan(measured: bool, chosen: i64, refused: i64) -> u32 {
    if (measured == false) { return AS_SELECT_NOT_MEASURED; }
    if (chosen == 0) {
        if (refused == 0) { return AS_SELECT_UNKNOWN_REFS; }
        return AS_SELECT_ONLY_REFUSED;
    }
    if (refused > 0) { return AS_SELECT_DONE_WITH_SKIPPED; }
    return AS_SELECT_DONE;
}

; queue_for_cleanup
pub const AS_QUEUE_NO_SUCH_PATH : u32 = 0;
pub const AS_QUEUE_NOT_IN_MAP : u32 = 1;
pub const AS_QUEUE_ALREADY : u32 = 2;
pub const AS_QUEUE_REFUSED : u32 = 3;
pub const AS_QUEUE_ADD : u32 = 4;

pub fn as_queue_plan(path_exists: bool, in_map: bool, already: bool, refused: bool) -> u32 {
    if (path_exists == false) { return AS_QUEUE_NO_SUCH_PATH; }
    if (in_map == false) { return AS_QUEUE_NOT_IN_MAP; }
    if (already) { return AS_QUEUE_ALREADY; }
    if (refused) { return AS_QUEUE_REFUSED; }
    return AS_QUEUE_ADD;
}

; find_app
pub const AS_FIND_ASK_NAME : u32 = 0;
pub const AS_FIND_NONE : u32 = 1;
pub const AS_FIND_OPEN_ONE : u32 = 2;
pub const AS_FIND_LIST : u32 = 3;

pub fn as_find_plan(query_empty: bool, matches: i64) -> u32 {
    if (query_empty) { return AS_FIND_ASK_NAME; }
    if (matches == 0) { return AS_FIND_NONE; }
    if (matches == 1) { return AS_FIND_OPEN_ONE; }
    return AS_FIND_LIST;
}

; Choosing a preset keeps a custom address when the preset has none.
pub fn as_preset_sets_address(preset_address_empty: bool) -> bool {
    return preset_address_empty == false;
}

; --- Application catalog ------------------------------------------------------------------------------------
pub const AS_CATALOG_SKIP : u32 = 0;
pub const AS_CATALOG_ADD : u32 = 1;
pub const AS_CATALOG_DESCEND : u32 = 2;

; An entry of an application folder: an .app is added, another folder is searched while depth remains.
pub fn as_catalog_entry(readable: bool, directory: bool, symlink: bool, app_extension: bool, depth_left: i64, package: bool) -> u32 {
    if (readable == false or directory == false or symlink) { return AS_CATALOG_SKIP; }
    if (app_extension) { return AS_CATALOG_ADD; }
    if (depth_left > 0 and package == false) { return AS_CATALOG_DESCEND; }
    return AS_CATALOG_SKIP;
}

test as_words {
    var t: [4096]u8 = [0; 4096];
    t[0] = 112; t[1] = 111; t[2] = 115; t[3] = 115; t[4] = 105; t[5] = 98; t[6] = 108; t[7] = 101; t[8] = 32; t[9] = 108; t[10] = 101; t[11] = 102; t[12] = 116; t[13] = 111; t[14] = 118; t[15] = 101; t[16] = 114; t[17] = 115;
    assert as_section(t, 18) == 2;
    t[0] = 109; t[1] = 97; t[2] = 112;
    assert as_section(t, 3) == 0;
    assert as_section(t, 2) == AS_NONE;
    t[0] = 105; t[1] = 110; t[2] = 95; t[3] = 117; t[4] = 115; t[5] = 101;
    assert as_verdict(t, 6) == 2;
    assert as_verdict(t, 5) == AS_NONE;
    t[0] = 121; t[1] = 101; t[2] = 115;
    assert as_yes_word(t, 3) == true;
    assert as_yes_word(t, 2) == false;
    t[0] = 98; t[1] = 111; t[2] = 120; t[3] = 46; t[4] = 108; t[5] = 111; t[6] = 99; t[7] = 97; t[8] = 108;
    assert as_local_host(t, 9) == true;
    t[0] = 58; t[1] = 58; t[2] = 49;
    assert as_local_host(t, 3) == true;
    assert as_local_host(t, 2) == false;
    t[0] = 110; t[1] = 118; t[2] = 105; t[3] = 100; t[4] = 105; t[5] = 97; t[6] = 47; t[7] = 101; t[8] = 109; t[9] = 98; t[10] = 101; t[11] = 100; t[12] = 45; t[13] = 113; t[14] = 97; t[15] = 45; t[16] = 52;
    assert as_chat_model(t, 17) == false;
    t[0] = 109; t[1] = 111; t[2] = 111; t[3] = 110; t[4] = 115; t[5] = 104; t[6] = 111; t[7] = 116; t[8] = 97; t[9] = 105; t[10] = 47; t[11] = 107; t[12] = 105; t[13] = 109; t[14] = 105; t[15] = 45; t[16] = 107; t[17] = 51;
    assert as_chat_model(t, 18) == true;
    assert as_recommended_model(t, 18, false, false) == true;
    assert as_recommended_model(t, 18, true, false) == false;
    t[0] = 102; t[1] = 111; t[2] = 111; t[3] = 47; t[4] = 98; t[5] = 97; t[6] = 114;
    assert as_recommended_model(t, 7, false, false) == false;
    assert as_recommended_model(t, 7, true, true) == true;
    var out: [4096]u8 = [0; 4096];
    var row: u32 = as_http_hint_row(404);
    assert as_row_code(row) == 404;
    assert as_row_text(row, 1, out) > 10;
    assert as_row_text(row, 0, out) == 3;
    assert as_http_hint_row(500) == AS_NONE;
    assert as_row_code(AS_ROWS) == AS_NONE;
    assert as_row_text(AS_ROWS, 0, out) == 0;
    assert as_row_matches(AS_ROWS, t, 3, 0) == false;
    assert as_find(AS_TABLE_SECTION, t, 5000, 0) == AS_NONE;
    assert as_http_ok(204) == true;
    assert as_http_ok(301) == false;
    assert as_replace_model(true, true, false) == true;
    assert as_replace_model(true, false, true) == false;
    assert as_replace_model(false, true, false) == false;
}

