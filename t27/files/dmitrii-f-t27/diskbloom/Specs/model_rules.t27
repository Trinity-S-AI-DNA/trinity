; Specs/model_rules.t27 -- DiskBloom: what each screen allows, and where navigation goes
; The view models (AppModel, CacheExplorerModel, OrphanedAppDataModel, AppUninstallerModel and the
; assistant's toolbox) hold state and talk to the system; every decision they make from that state is
; here: where Back and Enter lead, what the cleanup queue does with an item, how a disk is labelled,
; which actions are locked while a review or a move runs, which items count as selected, when extra
; confirmation is needed, when an uncertain earlier move still blocks work, the order of the checks
; before an uninstall review, and when the assistant is busy or ready. ASCII only apart from the
; labels, which are UTF-8 bytes. Generated C: Sources/Generated/model_rules.h (Specs/generate.sh).

module DiskBloomModelRules;

; --- Disk Map navigation --------------------------------------------------------------------------------
pub fn md_can_go_back(focus_depth: i64, history: i64) -> bool {
    return focus_depth > 1 or history > 0;
}

pub fn md_starts_initial_scan(has_snapshot: bool, scanning: bool, has_access: bool) -> bool {
    return has_snapshot == false and scanning == false and has_access;
}

pub const MD_SECTION_NONE : u32 = 0;
pub const MD_SECTION_CANCEL_SCAN : u32 = 1;
pub const MD_SECTION_START_INITIAL : u32 = 2;

pub fn md_section_change(to_map: bool, scanning: bool, has_snapshot: bool) -> u32 {
    if (to_map == false and scanning) { return MD_SECTION_CANCEL_SCAN; }
    if (to_map and has_snapshot == false) { return MD_SECTION_START_INITIAL; }
    return MD_SECTION_NONE;
}

pub const MD_ENTER_INSPECT : u32 = 0;
pub const MD_ENTER_RESCAN : u32 = 1;
pub const MD_ENTER_FOCUS : u32 = 2;

; A folder with no children in the snapshot is below the scan depth and gets its own scan.
pub fn md_enter(directory: bool, virtual_group: bool, children_empty: bool, has_url: bool) -> u32 {
    if (directory == false or virtual_group) { return MD_ENTER_INSPECT; }
    if (children_empty and has_url) { return MD_ENTER_RESCAN; }
    return MD_ENTER_FOCUS;
}

pub const MD_BACK_NONE : u32 = 0;
pub const MD_BACK_POP_FOCUS : u32 = 1;
pub const MD_BACK_RESTORE_SCAN : u32 = 2;

pub fn md_back(focus_depth: i64, history: i64) -> u32 {
    if (focus_depth > 1) { return MD_BACK_POP_FOCUS; }
    if (history > 0) { return MD_BACK_RESTORE_SCAN; }
    return MD_BACK_NONE;
}

pub const MD_FOCUS_FAIL : u32 = 0;
pub const MD_FOCUS_FOLDER : u32 = 1;
pub const MD_FOCUS_PARENT : u32 = 2;
pub const MD_FOCUS_ROOT : u32 = 3;

; Focusing a path already in the snapshot: open a mapped folder, or show a file (or a package, or an
; unmapped folder fails) inside its parent.
pub fn md_focus(directory: bool, package: bool, children_empty: bool, chain_length: i64) -> u32 {
    if (directory and package == false) {
        if (children_empty) { return MD_FOCUS_FAIL; }
        return MD_FOCUS_FOLDER;
    }
    if (chain_length > 1) { return MD_FOCUS_PARENT; }
    return MD_FOCUS_ROOT;
}

pub const MD_HISTORY_KEEP : u32 = 0;
pub const MD_HISTORY_PUSH : u32 = 1;
pub const MD_HISTORY_CLEAR : u32 = 2;

pub fn md_scan_history(remember_current: bool, has_snapshot: bool, focus_nonempty: bool, reset_navigation: bool) -> u32 {
    if (remember_current and has_snapshot and focus_nonempty) { return MD_HISTORY_PUSH; }
    if (reset_navigation) { return MD_HISTORY_CLEAR; }
    return MD_HISTORY_KEEP;
}

; --- The cleanup queue ---------------------------------------------------------------------------------------
pub const MD_QUEUE_REMOVE : u32 = 0;
pub const MD_QUEUE_REFUSE : u32 = 1;
pub const MD_QUEUE_IGNORE : u32 = 2;
pub const MD_QUEUE_ALREADY_INCLUDED : u32 = 3;
pub const MD_QUEUE_ADD : u32 = 4;

; Adding an item drops any queued items inside it; an item inside a queued folder is already included.
pub fn md_queue_toggle(queued: bool, refused: bool, has_url: bool, inside_queued: bool) -> u32 {
    if (queued) { return MD_QUEUE_REMOVE; }
    if (refused) { return MD_QUEUE_REFUSE; }
    if (has_url == false) { return MD_QUEUE_IGNORE; }
    if (inside_queued) { return MD_QUEUE_ALREADY_INCLUDED; }
    return MD_QUEUE_ADD;
}

pub fn md_queue_can_review(queued: i64, reviewing: bool) -> bool {
    return queued > 0 and reviewing == false;
}

pub fn md_queue_can_move(queued: i64, moving: bool) -> bool {
    return queued > 0 and moving == false;
}

; --- Disk labels -------------------------------------------------------------------------------------------------
pub const MD_VOLUME_NETWORK : u32 = 0;
pub const MD_VOLUME_INTERNAL : u32 = 1;
pub const MD_VOLUME_REMOVABLE : u32 = 2;
pub const MD_VOLUME_EXTERNAL : u32 = 3;
pub const MD_VOLUME_OTHER : u32 = 4;

; Each fact may be unknown (*_known false), as URL resource values can be missing.
pub fn md_volume_kind(local_known: bool, local: bool, internal_known: bool, internal: bool, removable_known: bool, removable: bool) -> u32 {
    if (local_known and local == false) { return MD_VOLUME_NETWORK; }
    if (internal_known and internal) { return MD_VOLUME_INTERNAL; }
    if (removable_known and removable) { return MD_VOLUME_REMOVABLE; }
    if (internal_known and internal == false) { return MD_VOLUME_EXTERNAL; }
    return MD_VOLUME_OTHER;
}

; Labels: per kind a subtitle (text 2k) and an SF Symbol name (text 2k+1); text 10 is the read-only
; suffix and text 11 the name of a disk without one.
pub const MD_TEXT_BYTES : [165]u8 = [78, 101, 116, 119, 111, 114, 107, 32, 118, 111, 108, 117, 109, 101, 110, 101, 116, 119, 111, 114, 107, 73, 110, 116, 101, 114, 110, 97, 108, 32, 100, 105, 115, 107, 105, 110, 116, 101, 114, 110, 97, 108, 100, 114, 105, 118, 101, 46, 102, 105, 108, 108, 82, 101, 109, 111, 118, 97, 98, 108, 101, 32, 118, 111, 108, 117, 109, 101, 101, 120, 116, 101, 114, 110, 97, 108, 100, 114, 105, 118, 101, 46, 98, 97, 100, 103, 101, 46, 112, 108, 117, 115, 69, 120, 116, 101, 114, 110, 97, 108, 32, 100, 105, 115, 107, 101, 120, 116, 101, 114, 110, 97, 108, 100, 114, 105, 118, 101, 46, 102, 105, 108, 108, 79, 116, 104, 101, 114, 32, 118, 111, 108, 117, 109, 101, 101, 120, 116, 101, 114, 110, 97, 108, 100, 114, 105, 118, 101, 32, 194, 183, 32, 114, 101, 97, 100, 45, 111, 110, 108, 121, 68, 105, 115, 107];
pub const MD_TEXT_OFFSETS : [12]u32 = [0, 14, 21, 34, 52, 68, 92, 105, 123, 135, 148, 161];
pub const MD_TEXT_LENGTHS : [12]u32 = [14, 7, 13, 18, 16, 24, 13, 18, 12, 13, 13, 4];
pub const MD_TEXTS : u32 = 12;
pub const MD_TEXT_READ_ONLY : u32 = 10;
pub const MD_TEXT_UNNAMED_DISK : u32 = 11;

pub fn md_text(index: u32, out: [4096]u8) -> u32 {
    if (index >= MD_TEXTS) { return 0; }
    var i: u32 = 0;
    while (i < MD_TEXT_LENGTHS[index]) {
        out[i] = MD_TEXT_BYTES[MD_TEXT_OFFSETS[index] + i];
        i = i + 1;
    }
    return MD_TEXT_LENGTHS[index];
}

pub fn md_volume_subtitle(kind: u32) -> u32 { return kind * 2; }
pub fn md_volume_icon(kind: u32) -> u32 { return kind * 2 + 1; }

; --- Caches screen -----------------------------------------------------------------------------------------------
pub fn md_cache_locked(reviewing: bool, moving: bool, review_shown: bool) -> bool {
    return reviewing or moving or review_shown;
}

pub fn md_cache_can_measure(reviewing: bool, moving: bool) -> bool {
    return reviewing == false and moving == false;
}

pub fn md_cache_can_toggle(selectable: bool, locked: bool) -> bool {
    return selectable and locked == false;
}

pub fn md_cache_can_review(selected: i64, scanning: bool, moving: bool, reviewing: bool) -> bool {
    return selected > 0 and scanning == false and moving == false and reviewing == false;
}

pub fn md_cache_can_move(review_shown: bool, selected: i64, moving: bool) -> bool {
    return review_shown and selected > 0 and moving == false;
}

; --- Possible Leftovers screen ---------------------------------------------------------------------------------------
pub fn md_leftovers_locked(reviewing: bool, moving: bool, review_shown: bool, outcome_shown: bool) -> bool {
    return reviewing or moving or review_shown or outcome_shown;
}

pub fn md_counts_as_selected(selected: bool, already_moved: bool) -> bool {
    return selected and already_moved == false;
}

pub fn md_needs_acknowledgement(process_check_unavailable: bool, risky_selected: bool) -> bool {
    return process_check_unavailable or risky_selected;
}

; An earlier move whose result is uncertain blocks work until every uncertain path is acknowledged.
pub fn md_uncertain_open(has_uncertain_paths: bool, all_acknowledged: bool) -> bool {
    return has_uncertain_paths and all_acknowledged == false;
}

pub fn md_leftovers_can_analyse(reviewing: bool, moving: bool, uncertain: bool) -> bool {
    return reviewing == false and moving == false and uncertain == false;
}

pub fn md_leftovers_can_toggle(selectable: bool, already_moved: bool, reviewing: bool, moving: bool, uncertain: bool) -> bool {
    return selectable and already_moved == false and reviewing == false and moving == false and uncertain == false;
}

pub fn md_leftovers_can_review(selected: i64, scanning: bool, moving: bool, uncertain: bool) -> bool {
    return selected > 0 and scanning == false and moving == false and uncertain == false;
}

pub fn md_leftovers_can_move(review_shown: bool, selected: i64, moving: bool, uncertain: bool) -> bool {
    return review_shown and selected > 0 and moving == false and uncertain == false;
}

pub fn md_can_recheck_uncertain(has_uncertain_paths: bool, reviewing: bool, moving: bool) -> bool {
    return has_uncertain_paths and reviewing == false and moving == false;
}

pub fn md_can_clear_outcome(moving: bool, uncertain: bool) -> bool {
    return moving == false and uncertain == false;
}

; --- App Uninstaller screen -----------------------------------------------------------------------------------------
; The bundle counts as selected until it moved; related items while selected and not yet moved.
pub fn md_uninstall_selected(required: bool, app_moved: bool, selected: bool, already_moved: bool) -> bool {
    if (required) { return app_moved == false; }
    return selected and already_moved == false;
}

pub fn md_uninstall_can_reanalyse(has_application: bool, moving: bool, app_moved: bool, nothing_moved: bool, uncertain: bool) -> bool {
    return has_application and moving == false and app_moved == false and nothing_moved and uncertain == false;
}

pub fn md_uninstall_can_toggle(moving: bool, required: bool, selectable: bool, already_moved: bool) -> bool {
    return moving == false and required == false and selectable and already_moved == false;
}

pub fn md_uninstall_can_reveal(moving: bool, already_moved: bool) -> bool {
    return moving == false and already_moved == false;
}

pub fn md_uninstall_can_move(has_plan: bool, moving: bool, uncertain: bool) -> bool {
    return has_plan and moving == false and uncertain == false;
}

; The checks before the uninstall review opens, in order; Swift runs them one at a time.
pub const MD_REVIEW_END : u32 = 0;
pub const MD_REVIEW_UNCERTAIN : u32 = 1;
pub const MD_REVIEW_APPLICATION : u32 = 2;
pub const MD_REVIEW_FOLDER_ACCESS : u32 = 3;
pub const MD_REVIEW_SOMETHING_SELECTED : u32 = 4;
pub const MD_REVIEW_BUNDLE_CHECKED : u32 = 5;
pub const MD_REVIEW_OVERLAP : u32 = 6;

pub fn md_review_step(index: u32, app_moved: bool, sandboxed: bool) -> u32 {
    var steps: [6]u32 = [0; 6];
    var count: u32 = 0;
    steps[count] = MD_REVIEW_UNCERTAIN;
    count = count + 1;
    if (app_moved == false) {
        steps[count] = MD_REVIEW_APPLICATION;
        count = count + 1;
        if (sandboxed) {
            steps[count] = MD_REVIEW_FOLDER_ACCESS;
            count = count + 1;
        }
    }
    steps[count] = MD_REVIEW_SOMETHING_SELECTED;
    count = count + 1;
    if (app_moved == false) {
        steps[count] = MD_REVIEW_BUNDLE_CHECKED;
        count = count + 1;
    }
    steps[count] = MD_REVIEW_OVERLAP;
    count = count + 1;
    if (index >= count) { return MD_REVIEW_END; }
    return steps[index];
}

pub fn md_can_open_uninstall_review(has_plan: bool, reviewing: bool, moving: bool) -> bool {
    return has_plan and reviewing == false and moving == false;
}

pub fn md_running_check_applies(app_moved: bool, has_application: bool) -> bool {
    return app_moved == false and has_application;
}

; --- Small decisions of the screens -----------------------------------------------------------------
; A folder needs the system open panel first when the sandbox has not granted it.
pub fn md_needs_permission(has_access: bool) -> bool {
    return has_access == false;
}

pub fn md_can_start_scan(moving: bool) -> bool {
    return moving == false;
}

; Entering an unmapped folder drops queued items around it; the person is told when any were dropped.
pub fn md_queue_trimmed(before: i64, after: i64) -> bool {
    return after != before;
}

; A review opens only when every selected item passed its checks.
pub fn md_review_passes(failures: i64) -> bool {
    return failures == 0;
}

; Re-checking an uncertain move works only when every disputed path still has its original snapshot.
pub fn md_disputed_all_known(found: i64, disputed: i64) -> bool {
    return found == disputed;
}

pub fn md_can_repeat_duplicate_scan(has_root: bool, scanning: bool) -> bool {
    return has_root and scanning == false;
}

; A Library or cache folder is read only when it is a real folder that could be listed.
pub fn md_location_usable(symlinked: bool, listed: bool) -> bool {
    return symlinked == false and listed;
}

; Empty entries are not listed as caches.
pub fn md_worth_listing(size: i64) -> bool {
    return size > 0;
}

; A stored folder grant is renewed when the system says it went stale and a new one could be made.
pub fn md_renew_grant(stale: bool, renewed: bool) -> bool {
    return stale and renewed;
}

; --- The assistant -----------------------------------------------------------------------------------------------
pub fn md_assistant_busy(map_moving: bool, map_review_shown: bool, uninstaller_moving: bool, uninstaller_reviewing: bool, uninstaller_review_shown: bool, uninstaller_outcome_shown: bool, leftovers_locked: bool, caches_locked: bool) -> bool {
    return map_moving or map_review_shown or uninstaller_moving or uninstaller_reviewing or uninstaller_review_shown or uninstaller_outcome_shown or leftovers_locked or caches_locked;
}

pub const MD_API_READY : u32 = 0;
pub const MD_API_NO_ADDRESS : u32 = 1;
pub const MD_API_NO_MODEL : u32 = 2;
pub const MD_API_NO_KEY : u32 = 3;

pub fn md_api_status(has_host: bool, has_model: bool, local: bool, has_key: bool) -> u32 {
    if (has_host == false) { return MD_API_NO_ADDRESS; }
    if (has_model == false) { return MD_API_NO_MODEL; }
    if (local == false and has_key == false) { return MD_API_NO_KEY; }
    return MD_API_READY;
}

; How many items a tool returns: the asked number within 1...maximum, or the default.
pub fn md_tool_limit(asked: i64, has_asked: bool, fallback: i64, maximum: i64) -> i64 {
    var n: i64 = fallback;
    if (has_asked) { n = asked; }
    if (n < 1) { n = 1; }
    if (n > maximum) { n = maximum; }
    return n;
}

test md_navigation {
    assert md_can_go_back(2, 0) == true;
    assert md_can_go_back(1, 1) == true;
    assert md_can_go_back(1, 0) == false;
    assert md_starts_initial_scan(false, false, true) == true;
    assert md_starts_initial_scan(true, false, true) == false;
    assert md_starts_initial_scan(false, false, false) == false;
    assert md_section_change(false, true, true) == MD_SECTION_CANCEL_SCAN;
    assert md_section_change(true, true, false) == MD_SECTION_START_INITIAL;
    assert md_section_change(true, false, true) == MD_SECTION_NONE;
    assert md_section_change(false, false, false) == MD_SECTION_NONE;
    assert md_enter(false, false, true, true) == MD_ENTER_INSPECT;
    assert md_enter(true, true, true, true) == MD_ENTER_INSPECT;
    assert md_enter(true, false, true, true) == MD_ENTER_RESCAN;
    assert md_enter(true, false, true, false) == MD_ENTER_FOCUS;
    assert md_enter(true, false, false, true) == MD_ENTER_FOCUS;
    assert md_back(2, 1) == MD_BACK_POP_FOCUS;
    assert md_back(1, 1) == MD_BACK_RESTORE_SCAN;
    assert md_back(1, 0) == MD_BACK_NONE;
    assert md_focus(true, false, true, 3) == MD_FOCUS_FAIL;
    assert md_focus(true, false, false, 3) == MD_FOCUS_FOLDER;
    assert md_focus(true, true, false, 3) == MD_FOCUS_PARENT;
    assert md_focus(false, false, true, 1) == MD_FOCUS_ROOT;
    assert md_scan_history(true, true, true, true) == MD_HISTORY_PUSH;
    assert md_scan_history(true, false, true, true) == MD_HISTORY_CLEAR;
    assert md_scan_history(false, true, true, false) == MD_HISTORY_KEEP;
}

test md_queue_and_labels {
    assert md_queue_toggle(true, true, false, true) == MD_QUEUE_REMOVE;
    assert md_queue_toggle(false, true, true, true) == MD_QUEUE_REFUSE;
    assert md_queue_toggle(false, false, false, true) == MD_QUEUE_IGNORE;
    assert md_queue_toggle(false, false, true, true) == MD_QUEUE_ALREADY_INCLUDED;
    assert md_queue_toggle(false, false, true, false) == MD_QUEUE_ADD;
    assert md_queue_can_review(1, false) == true;
    assert md_queue_can_review(0, false) == false;
    assert md_queue_can_move(1, true) == false;
    assert md_volume_kind(true, false, true, true, true, true) == MD_VOLUME_NETWORK;
    assert md_volume_kind(false, false, true, true, true, true) == MD_VOLUME_INTERNAL;
    assert md_volume_kind(true, true, false, false, true, true) == MD_VOLUME_REMOVABLE;
    assert md_volume_kind(true, true, true, false, false, false) == MD_VOLUME_EXTERNAL;
    assert md_volume_kind(true, true, false, false, false, false) == MD_VOLUME_OTHER;
    var out: [4096]u8 = [0; 4096];
    assert md_text(md_volume_subtitle(MD_VOLUME_INTERNAL), out) == 13;
    assert out[0] == 73;
    assert md_text(md_volume_icon(MD_VOLUME_NETWORK), out) == 7;
    assert md_text(MD_TEXTS, out) == 0;
}

test md_screens {
    assert md_cache_locked(false, false, true) == true;
    assert md_cache_locked(false, false, false) == false;
    assert md_cache_can_measure(false, false) == true;
    assert md_cache_can_toggle(true, false) == true;
    assert md_cache_can_toggle(false, false) == false;
    assert md_cache_can_review(1, false, false, false) == true;
    assert md_cache_can_review(1, true, false, false) == false;
    assert md_cache_can_move(true, 1, false) == true;
    assert md_cache_can_move(false, 1, false) == false;
    assert md_leftovers_locked(false, false, false, true) == true;
    assert md_counts_as_selected(true, false) == true;
    assert md_counts_as_selected(true, true) == false;
    assert md_needs_acknowledgement(true, false) == true;
    assert md_uncertain_open(true, false) == true;
    assert md_uncertain_open(true, true) == false;
    assert md_leftovers_can_analyse(false, false, true) == false;
    assert md_leftovers_can_toggle(true, false, false, false, false) == true;
    assert md_leftovers_can_toggle(true, true, false, false, false) == false;
    assert md_leftovers_can_review(1, false, false, false) == true;
    assert md_leftovers_can_move(true, 1, false, true) == false;
    assert md_can_recheck_uncertain(true, false, false) == true;
    assert md_can_clear_outcome(false, false) == true;
    assert md_uninstall_selected(true, false, false, false) == true;
    assert md_uninstall_selected(true, true, true, false) == false;
    assert md_uninstall_selected(false, false, true, false) == true;
    assert md_uninstall_selected(false, false, true, true) == false;
    assert md_uninstall_can_reanalyse(true, false, false, true, false) == true;
    assert md_uninstall_can_reanalyse(true, false, false, false, false) == false;
    assert md_uninstall_can_toggle(false, false, true, false) == true;
    assert md_uninstall_can_toggle(false, true, true, false) == false;
    assert md_uninstall_can_reveal(false, false) == true;
    assert md_uninstall_can_move(true, false, false) == true;
    assert md_can_open_uninstall_review(true, false, false) == true;
    assert md_running_check_applies(false, true) == true;
    assert md_running_check_applies(true, true) == false;
}

test md_review_steps_and_assistant {
    assert md_review_step(0, false, true) == MD_REVIEW_UNCERTAIN;
    assert md_review_step(1, false, true) == MD_REVIEW_APPLICATION;
    assert md_review_step(2, false, true) == MD_REVIEW_FOLDER_ACCESS;
    assert md_review_step(3, false, true) == MD_REVIEW_SOMETHING_SELECTED;
    assert md_review_step(4, false, true) == MD_REVIEW_BUNDLE_CHECKED;
    assert md_review_step(5, false, true) == MD_REVIEW_OVERLAP;
    assert md_review_step(6, false, true) == MD_REVIEW_END;
    assert md_review_step(2, false, false) == MD_REVIEW_SOMETHING_SELECTED;
    assert md_review_step(1, true, true) == MD_REVIEW_SOMETHING_SELECTED;
    assert md_review_step(2, true, true) == MD_REVIEW_OVERLAP;
    assert md_review_step(3, true, true) == MD_REVIEW_END;
    assert md_assistant_busy(false, false, false, false, false, false, false, false) == false;
    assert md_assistant_busy(false, false, false, false, false, false, false, true) == true;
    assert md_api_status(false, true, true, true) == MD_API_NO_ADDRESS;
    assert md_api_status(true, false, true, true) == MD_API_NO_MODEL;
    assert md_api_status(true, true, false, false) == MD_API_NO_KEY;
    assert md_api_status(true, true, true, false) == MD_API_READY;
    assert md_tool_limit(50, true, 8, 15) == 15;
    assert md_tool_limit(0, true, 8, 15) == 1;
    assert md_tool_limit(0, false, 8, 15) == 8;
}

test md_small_decisions {
    assert md_needs_permission(false) == true;
    assert md_can_start_scan(true) == false;
    assert md_queue_trimmed(3, 2) == true;
    assert md_queue_trimmed(2, 2) == false;
    assert md_review_passes(0) == true;
    assert md_review_passes(1) == false;
    assert md_disputed_all_known(2, 2) == true;
    assert md_disputed_all_known(1, 2) == false;
    assert md_can_repeat_duplicate_scan(true, false) == true;
    assert md_can_repeat_duplicate_scan(false, false) == false;
    assert md_location_usable(false, true) == true;
    assert md_location_usable(true, true) == false;
    assert md_worth_listing(1) == true;
    assert md_worth_listing(0) == false;
    assert md_renew_grant(true, true) == true;
    assert md_renew_grant(true, false) == false;
}
