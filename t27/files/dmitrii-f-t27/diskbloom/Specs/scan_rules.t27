// SPDX-License-Identifier: MIT
; Specs/scan_rules.t27 -- DiskBloom: how the scanner treats each entry, and when a snapshot still holds
; Sources/DiskScanner.swift walks the disk; for every entry it asks this spec what to do with it, which
; reported size counts, which children stay visible and which fold into "Other", and in which order the
; visible children are listed. Sources/AppModel.swift (SnapshotValidator) asks it whether an item still
; matches its snapshot: first the cheap checks, then, only when they pass, the comparison with a fresh
; measurement. ASCII only. Generated C: Sources/Generated/scan_rules.h (Specs/generate.sh).

module DiskBloomScanRules;

; --- Limits ----------------------------------------------------------------------------------------
pub const SR_MIN_DEPTH : i64 = 2;
pub const SR_MIN_VISIBLE_CHILDREN : i64 = 12;

pub fn sr_depth_limit(requested: i64) -> i64 {
    if (requested < 2) { return SR_MIN_DEPTH; }
    if (requested > 1000000) { return 1000000; }
    return requested;
}

pub fn sr_visible_children_limit(requested: i64) -> i64 {
    if (requested < 12) { return SR_MIN_VISIBLE_CHILDREN; }
    if (requested > 1000000) { return 1000000; }
    return requested;
}

; One slot is kept for "Other", so a folder retains one child fewer than it may show.
pub fn sr_retained_limit(visible: u32) -> u32 {
    if (visible <= 1) { return 1; }
    return visible - 1;
}

; --- What to do with one entry of a folder being mapped (scanNode) ---------------------------------
pub const SR_UNREADABLE : u32 = 0;
pub const SR_SYMLINK : u32 = 1;
pub const SR_SKIP_MOUNT : u32 = 2;
pub const SR_FILE : u32 = 3;
pub const SR_FILE_REPEAT_LINK : u32 = 4;
pub const SR_SKIP_SEEN_FOLDER : u32 = 5;
pub const SR_MEASURE : u32 = 6;
pub const SR_DESCEND : u32 = 7;

; Facts:
;   readable          the entry's resource values could be read
;   symlink, volume, directory, package
;   depth             0 for the folder the scan started at
;   max_depth         the depth limit
;   link_seen         (file) another hard link to the same file was already counted
;   has_identity      (folder) its identity could be read
;   folder_seen       (folder) a folder with that identity was already scanned

pub fn sr_map_action(readable: bool, symlink: bool, volume: bool, directory: bool, package: bool, depth: u32, max_depth: u32, link_seen: bool, has_identity: bool, folder_seen: bool) -> u32 {
    if (readable == false) { return SR_UNREADABLE; }
    if (symlink) { return SR_SYMLINK; }
    if (depth > 0 and volume) { return SR_SKIP_MOUNT; }
    if (directory == false) {
        if (link_seen) { return SR_FILE_REPEAT_LINK; }
        return SR_FILE;
    }
    if (depth > 0 and has_identity and folder_seen) { return SR_SKIP_SEEN_FOLDER; }
    if (depth >= max_depth) { return SR_MEASURE; }
    if (package and depth > 0) { return SR_MEASURE; }
    return SR_DESCEND;
}

; --- What to do with one entry of a folder only being measured (measureDirectory) -----------------

pub fn sr_measure_action(readable: bool, symlink: bool, volume: bool, directory: bool, link_seen: bool, has_identity: bool, folder_seen: bool) -> u32 {
    if (readable == false) { return SR_UNREADABLE; }
    if (symlink) { return SR_SYMLINK; }
    if (volume) { return SR_SKIP_MOUNT; }
    if (directory) {
        if (has_identity and folder_seen) { return SR_SKIP_SEEN_FOLDER; }
        return SR_MEASURE;
    }
    if (link_seen) { return SR_FILE_REPEAT_LINK; }
    return SR_FILE;
}

; --- Which reported size counts: allocated sizes first, then logical ones --------------------------

pub fn sr_allocated_size(has_total_allocated: bool, total_allocated: i64, has_allocated: bool, allocated: i64, has_total: bool, total: i64, has_size: bool, size: i64) -> i64 {
    if (has_total_allocated) { return total_allocated; }
    if (has_allocated) { return allocated; }
    if (has_total) { return total; }
    if (has_size) { return size; }
    return 0;
}

; Sizes and counts are never negative.
pub fn sr_non_negative(value: i64) -> i64 {
    if (value < 0) { return 0; }
    return value;
}

; --- Which children stay visible ----------------------------------------------------------------------
pub const SR_RETAIN : u32 = 0;
pub const SR_DISPLACE_SMALLEST : u32 = 1;
pub const SR_FOLD_INTO_OTHER : u32 = 2;

; retained: how many children are kept so far; smallest: the smallest kept size.
pub fn sr_keep_child(retained: u32, limit: u32, smallest: i64, size: i64) -> u32 {
    if (retained < limit) { return SR_RETAIN; }
    if (retained == 0) { return SR_FOLD_INTO_OTHER; }
    if (size > smallest) { return SR_DISPLACE_SMALLEST; }
    return SR_FOLD_INTO_OTHER;
}

; Visible children are listed largest first; equal sizes fall back to the names (Swift compares them).
pub const SR_FIRST : u32 = 0;
pub const SR_SECOND : u32 = 1;
pub const SR_BY_NAME : u32 = 2;

pub fn sr_order(size_a: i64, size_b: i64) -> u32 {
    if (size_a > size_b) { return SR_FIRST; }
    if (size_a < size_b) { return SR_SECOND; }
    return SR_BY_NAME;
}

; A folder's own fingerprint holds only if its identity did not change while its children were read.
pub fn sr_folder_fingerprint_holds(identity_before_known: bool, identity_after_known: bool, identities_equal: bool) -> bool {
    if (identity_before_known != identity_after_known) { return false; }
    if (identity_before_known == false) { return true; }
    return identities_equal;
}

; --- Does an item still match its snapshot? ----------------------------------------------------------
pub const SN_OK : u32 = 0;
pub const SN_AGGREGATE : u32 = 1;
pub const SN_PATH_CHANGED : u32 = 2;
pub const SN_GONE : u32 = 3;
pub const SN_VALUES_UNREADABLE : u32 = 4;
pub const SN_BECAME_SYMLINK : u32 = 5;
pub const SN_IDENTITY_UNKNOWN : u32 = 6;
pub const SN_IDENTITY_CHANGED : u32 = 7;
pub const SN_NO_FINGERPRINT : u32 = 8;
pub const SN_REMEASURE_FAILED : u32 = 9;
pub const SN_CONTENTS_CHANGED : u32 = 10;

; The cheap checks, in order. Swift measures again only after SN_OK.
pub fn sn_precheck(aggregate: bool, path_unchanged: bool, exists: bool, values_readable: bool, symlink: bool, identities_known: bool, identity_equal: bool, has_fingerprint: bool) -> u32 {
    if (aggregate) { return SN_AGGREGATE; }
    if (path_unchanged == false) { return SN_PATH_CHANGED; }
    if (exists == false) { return SN_GONE; }
    if (values_readable == false) { return SN_VALUES_UNREADABLE; }
    if (symlink) { return SN_BECAME_SYMLINK; }
    if (identities_known == false) { return SN_IDENTITY_UNKNOWN; }
    if (identity_equal == false) { return SN_IDENTITY_CHANGED; }
    if (has_fingerprint == false) { return SN_NO_FINGERPRINT; }
    return SN_OK;
}

; The fresh measurement against the snapshot.
pub fn sn_compare(remeasured: bool, identity_same: bool, kind_same: bool, fingerprint_same: bool, size_same: bool, files_same: bool, folders_same: bool) -> u32 {
    if (remeasured == false) { return SN_REMEASURE_FAILED; }
    if (identity_same and kind_same and fingerprint_same and size_same and files_same and folders_same) { return SN_OK; }
    return SN_CONTENTS_CHANGED;
}

invariant sr_retained_fits { assert SR_MIN_VISIBLE_CHILDREN > 1; }

test sr_limits {
    assert sr_depth_limit(0) == 2;
    assert sr_depth_limit(6) == 6;
    assert sr_depth_limit(-5) == 2;
    assert sr_depth_limit(5000000) == 1000000;
    assert sr_visible_children_limit(5) == 12;
    assert sr_visible_children_limit(72) == 72;
    assert sr_visible_children_limit(9000000) == 1000000;
    assert sr_retained_limit(72) == 71;
    assert sr_retained_limit(1) == 1;
    assert sr_retained_limit(0) == 1;
    assert sr_non_negative(-3) == 0;
    assert sr_non_negative(4) == 4;
}

test sr_entries {
    assert sr_map_action(false, true, true, true, true, 3, 6, true, true, true) == SR_UNREADABLE;
    assert sr_map_action(true, true, true, true, true, 3, 6, true, true, true) == SR_SYMLINK;
    assert sr_map_action(true, false, true, true, true, 3, 6, true, true, true) == SR_SKIP_MOUNT;
    assert sr_map_action(true, false, true, true, false, 0, 6, false, true, true) == SR_DESCEND;
    assert sr_map_action(true, false, false, false, false, 2, 6, true, false, false) == SR_FILE_REPEAT_LINK;
    assert sr_map_action(true, false, false, false, false, 2, 6, false, false, false) == SR_FILE;
    assert sr_map_action(true, false, false, true, false, 2, 6, false, true, true) == SR_SKIP_SEEN_FOLDER;
    assert sr_map_action(true, false, false, true, false, 2, 6, false, false, true) == SR_DESCEND;
    assert sr_map_action(true, false, false, true, false, 6, 6, false, true, false) == SR_MEASURE;
    assert sr_map_action(true, false, false, true, true, 1, 6, false, true, false) == SR_MEASURE;
    assert sr_map_action(true, false, false, true, true, 0, 6, false, true, false) == SR_DESCEND;
    assert sr_measure_action(false, true, true, true, true, true, true) == SR_UNREADABLE;
    assert sr_measure_action(true, true, true, true, true, true, true) == SR_SYMLINK;
    assert sr_measure_action(true, false, true, true, true, true, true) == SR_SKIP_MOUNT;
    assert sr_measure_action(true, false, false, true, false, true, true) == SR_SKIP_SEEN_FOLDER;
    assert sr_measure_action(true, false, false, true, false, false, true) == SR_MEASURE;
    assert sr_measure_action(true, false, false, false, true, false, false) == SR_FILE_REPEAT_LINK;
    assert sr_measure_action(true, false, false, false, false, false, false) == SR_FILE;
}

test sr_sizes_children_order {
    assert sr_allocated_size(true, 1, true, 2, true, 3, true, 4) == 1;
    assert sr_allocated_size(false, 1, true, 2, true, 3, true, 4) == 2;
    assert sr_allocated_size(false, 1, false, 2, true, 3, true, 4) == 3;
    assert sr_allocated_size(false, 1, false, 2, false, 3, true, 4) == 4;
    assert sr_allocated_size(false, 1, false, 2, false, 3, false, 4) == 0;
    assert sr_keep_child(3, 4, 10, 1) == SR_RETAIN;
    assert sr_keep_child(4, 4, 10, 11) == SR_DISPLACE_SMALLEST;
    assert sr_keep_child(4, 4, 10, 10) == SR_FOLD_INTO_OTHER;
    assert sr_keep_child(0, 0, 0, 5) == SR_FOLD_INTO_OTHER;
    assert sr_order(2, 1) == SR_FIRST;
    assert sr_order(1, 2) == SR_SECOND;
    assert sr_order(2, 2) == SR_BY_NAME;
    assert sr_folder_fingerprint_holds(true, true, true) == true;
    assert sr_folder_fingerprint_holds(true, true, false) == false;
    assert sr_folder_fingerprint_holds(true, false, false) == false;
    assert sr_folder_fingerprint_holds(false, false, false) == true;
}

test sn_snapshots {
    assert sn_precheck(false, true, true, true, false, true, true, true) == SN_OK;
    assert sn_precheck(true, false, false, false, true, false, false, false) == SN_AGGREGATE;
    assert sn_precheck(false, false, false, false, true, false, false, false) == SN_PATH_CHANGED;
    assert sn_precheck(false, true, false, false, true, false, false, false) == SN_GONE;
    assert sn_precheck(false, true, true, false, true, false, false, false) == SN_VALUES_UNREADABLE;
    assert sn_precheck(false, true, true, true, true, false, false, false) == SN_BECAME_SYMLINK;
    assert sn_precheck(false, true, true, true, false, false, false, false) == SN_IDENTITY_UNKNOWN;
    assert sn_precheck(false, true, true, true, false, true, false, false) == SN_IDENTITY_CHANGED;
    assert sn_precheck(false, true, true, true, false, true, true, false) == SN_NO_FINGERPRINT;
    assert sn_compare(false, true, true, true, true, true, true) == SN_REMEASURE_FAILED;
    assert sn_compare(true, true, true, true, true, true, true) == SN_OK;
    assert sn_compare(true, true, true, true, true, true, false) == SN_CONTENTS_CHANGED;
    assert sn_compare(true, false, true, true, true, true, true) == SN_CONTENTS_CHANGED;
}
