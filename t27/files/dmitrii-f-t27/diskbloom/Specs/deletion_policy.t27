// SPDX-License-Identifier: MIT
; Specs/deletion_policy.t27 -- DiskBloom: may this item go to the Trash?
; Every move from the Disk Map queue and from the Caches section asks this rule set, first when the
; item is queued and again inside the file coordinator right before the move. Swift reads the facts
; about the path (Sources/AppModel.swift, DeletionPolicy.facts) and this spec decides, in a fixed
; order, the first reason to refuse. Nothing here touches the disk. ASCII only.
; Generated C: Sources/Generated/deletion_policy.h (Specs/generate.sh).

module DiskBloomDeletionPolicy;

; --- Where under the home folder the item is -----------------------------------------------------
pub const DP_LIB_NONE : u32 = 0;
pub const DP_LIB_ALLOWED_CACHE : u32 = 1;
pub const DP_LIB_OTHER : u32 = 2;

; --- The first reason to refuse, in the order they are checked ------------------------------------
pub const DP_ALLOWED : u32 = 0;
pub const DP_AGGREGATE : u32 = 1;
pub const DP_PATH_CHANGED : u32 = 2;
pub const DP_SYMLINK : u32 = 3;
pub const DP_HOME_ROOT : u32 = 4;
pub const DP_WHOLE_DISK : u32 = 5;
pub const DP_SCAN_ROOT : u32 = 6;
pub const DP_OUTSIDE_SCAN : u32 = 7;
pub const DP_CONTAINS_ACTIVE_SCAN : u32 = 8;
pub const DP_SYSTEM_AREA : u32 = 9;
pub const DP_LIBRARY : u32 = 10;
pub const DP_HIDDEN : u32 = 11;
pub const DP_PROTECTED_HOME : u32 = 12;
pub const DP_TRASH : u32 = 13;
pub const DP_NETWORK : u32 = 14;
pub const DP_READ_ONLY : u32 = 15;
pub const DP_OTHER_VOLUME : u32 = 16;
pub const DP_RUNNING_APP : u32 = 17;
pub const DP_NO_IDENTITY : u32 = 18;

; Facts:
;   aggregate             a virtual group of small items, or no exact path
;   path_changed          the coordinated path differs from the confirmed one
;   symlinked             the path resolves somewhere else
;   home_root             the item is the home folder itself
;   scan_root_is_disk     the analysis covers the whole system disk (/)
;   is_scan_root          the item is the root of the current analysis
;   inside_scan_root      the item is strictly inside the analysis root
;   contains_active_scan  the item is, or contains, the folder being viewed
;   inside_home           strictly inside the home folder
;   on_external_volume    under /Volumes/<name>/
;   library               DP_LIB_* (only read inside the home folder)
;   hidden                the first component under home starts with a dot and is not .cache
;   protected_home        under ~/mlx/profiles or ~/My Drive
;   in_trash              a path component is .Trash or .Trashes
;   volume_local          the volume reports itself as local
;   volume_read_only      the volume is read-only
;   same_device           the item is on the analysis root's volume
;   holds_running_app     the item is the running DiskBloom or contains it
;   has_identity          the scan recorded the item's file identity

pub fn dp_rejection(aggregate: bool, path_changed: bool, symlinked: bool, home_root: bool, scan_root_is_disk: bool, is_scan_root: bool, inside_scan_root: bool, contains_active_scan: bool, inside_home: bool, on_external_volume: bool, library: u32, hidden: bool, protected_home: bool, in_trash: bool, volume_local: bool, volume_read_only: bool, same_device: bool, holds_running_app: bool, has_identity: bool) -> u32 {
    if (aggregate) { return DP_AGGREGATE; }
    if (path_changed) { return DP_PATH_CHANGED; }
    if (symlinked) { return DP_SYMLINK; }
    if (home_root) { return DP_HOME_ROOT; }
    if (scan_root_is_disk) { return DP_WHOLE_DISK; }
    if (is_scan_root) { return DP_SCAN_ROOT; }
    if (inside_scan_root == false) { return DP_OUTSIDE_SCAN; }
    if (contains_active_scan) { return DP_CONTAINS_ACTIVE_SCAN; }
    if (inside_home == false and on_external_volume == false) { return DP_SYSTEM_AREA; }
    if (inside_home) {
        if (library == DP_LIB_OTHER) { return DP_LIBRARY; }
        if (hidden) { return DP_HIDDEN; }
        if (protected_home) { return DP_PROTECTED_HOME; }
    }
    if (in_trash) { return DP_TRASH; }
    if (volume_local == false) { return DP_NETWORK; }
    if (volume_read_only) { return DP_READ_ONLY; }
    if (same_device == false) { return DP_OTHER_VOLUME; }
    if (holds_running_app) { return DP_RUNNING_APP; }
    if (has_identity == false) { return DP_NO_IDENTITY; }
    return DP_ALLOWED;
}

pub fn dp_allowed(reason: u32) -> bool {
    return reason == DP_ALLOWED;
}

invariant dp_allowed_is_zero { assert DP_ALLOWED == 0; }
invariant dp_library_codes_differ { assert DP_LIB_NONE < DP_LIB_ALLOWED_CACHE and DP_LIB_ALLOWED_CACHE < DP_LIB_OTHER; }

test dp_an_ordinary_file_in_the_home_folder_may_move {
    // aggregate changed symlink homeRoot disk scanRoot inside active home external library hidden protected trash local ro device app identity
    assert dp_rejection(false, false, false, false, false, false, true, false, true, false, DP_LIB_NONE, false, false, false, true, false, true, false, true) == DP_ALLOWED;
    assert dp_rejection(false, false, false, false, false, false, true, false, true, false, DP_LIB_ALLOWED_CACHE, false, false, false, true, false, true, false, true) == DP_ALLOWED;
    assert dp_rejection(false, false, false, false, false, false, true, false, false, true, DP_LIB_NONE, false, false, false, true, false, true, false, true) == DP_ALLOWED;
    assert dp_allowed(DP_ALLOWED) == true;
    assert dp_allowed(DP_LIBRARY) == false;
}

test dp_structural_refusals_come_first {
    assert dp_rejection(true, true, true, true, true, true, false, true, false, false, DP_LIB_OTHER, true, true, true, false, true, false, true, false) == DP_AGGREGATE;
    assert dp_rejection(false, true, true, true, true, true, false, true, false, false, DP_LIB_OTHER, true, true, true, false, true, false, true, false) == DP_PATH_CHANGED;
    assert dp_rejection(false, false, true, true, true, true, false, true, false, false, DP_LIB_OTHER, true, true, true, false, true, false, true, false) == DP_SYMLINK;
    assert dp_rejection(false, false, false, true, true, true, false, true, false, false, DP_LIB_OTHER, true, true, true, false, true, false, true, false) == DP_HOME_ROOT;
    assert dp_rejection(false, false, false, false, true, true, false, true, false, false, DP_LIB_OTHER, true, true, true, false, true, false, true, false) == DP_WHOLE_DISK;
    assert dp_rejection(false, false, false, false, false, true, false, true, false, false, DP_LIB_OTHER, true, true, true, false, true, false, true, false) == DP_SCAN_ROOT;
    assert dp_rejection(false, false, false, false, false, false, false, true, false, false, DP_LIB_OTHER, true, true, true, false, true, false, true, false) == DP_OUTSIDE_SCAN;
    assert dp_rejection(false, false, false, false, false, false, true, true, false, false, DP_LIB_OTHER, true, true, true, false, true, false, true, false) == DP_CONTAINS_ACTIVE_SCAN;
}

test dp_only_the_home_folder_and_external_disks_can_be_cleaned {
    assert dp_rejection(false, false, false, false, false, false, true, false, false, false, DP_LIB_NONE, false, false, false, true, false, true, false, true) == DP_SYSTEM_AREA;
    assert dp_rejection(false, false, false, false, false, false, true, false, true, false, DP_LIB_OTHER, false, false, false, true, false, true, false, true) == DP_LIBRARY;
    assert dp_rejection(false, false, false, false, false, false, true, false, true, false, DP_LIB_NONE, true, false, false, true, false, true, false, true) == DP_HIDDEN;
    assert dp_rejection(false, false, false, false, false, false, true, false, true, false, DP_LIB_NONE, false, true, false, true, false, true, false, true) == DP_PROTECTED_HOME;
    // Library, hidden and protected are home-folder rules; an external disk ignores them.
    assert dp_rejection(false, false, false, false, false, false, true, false, false, true, DP_LIB_OTHER, true, true, false, true, false, true, false, true) == DP_ALLOWED;
}

test dp_the_volume_and_the_item_itself_are_checked_last {
    assert dp_rejection(false, false, false, false, false, false, true, false, true, false, DP_LIB_NONE, false, false, true, true, false, true, false, true) == DP_TRASH;
    assert dp_rejection(false, false, false, false, false, false, true, false, true, false, DP_LIB_NONE, false, false, false, false, false, true, false, true) == DP_NETWORK;
    assert dp_rejection(false, false, false, false, false, false, true, false, true, false, DP_LIB_NONE, false, false, false, true, true, true, false, true) == DP_READ_ONLY;
    assert dp_rejection(false, false, false, false, false, false, true, false, true, false, DP_LIB_NONE, false, false, false, true, false, false, false, true) == DP_OTHER_VOLUME;
    assert dp_rejection(false, false, false, false, false, false, true, false, true, false, DP_LIB_NONE, false, false, false, true, false, true, true, true) == DP_RUNNING_APP;
    assert dp_rejection(false, false, false, false, false, false, true, false, true, false, DP_LIB_NONE, false, false, false, true, false, true, false, false) == DP_NO_IDENTITY;
}
