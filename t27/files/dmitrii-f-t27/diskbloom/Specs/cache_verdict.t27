; Words the updater and crash-report rules look for: .shipit updater crashpad sentrycrash com.crashlytics huggingface
pub const CV_WORD_SHIPIT : u32 = 0;
pub const CV_WORD_UPDATER : u32 = 1;
pub const CV_WORD_CRASHPAD : u32 = 2;
pub const CV_WORD_SENTRYCRASH : u32 = 3;
pub const CV_WORD_CRASHLYTICS : u32 = 4;
pub const CV_WORD_HUGGINGFACE : u32 = 5;
pub const CV_WORD_BYTES : [59]u8 = [46, 115, 104, 105, 112, 105, 116, 117, 112, 100, 97, 116, 101, 114, 99, 114, 97, 115, 104, 112, 97, 100, 115, 101, 110, 116, 114, 121, 99, 114, 97, 115, 104, 99, 111, 109, 46, 99, 114, 97, 115, 104, 108, 121, 116, 105, 99, 115, 104, 117, 103, 103, 105, 110, 103, 102, 97, 99, 101];
pub const CV_WORD_OFFSETS : [6]u32 = [0, 7, 14, 22, 33, 48];
pub const CV_WORD_LENGTHS : [6]u32 = [7, 7, 8, 11, 15, 11];

; Classes of the Characters of a DerivedData folder name, as Swift reports them.
pub const CV_CHAR_OTHER : u8 = 0;
pub const CV_CHAR_LOWER_LETTER : u8 = 1;
pub const CV_CHAR_DASH : u8 = 2;

pub fn cv_row_offset(row: u32, field: u32) -> u32 {
    if (row >= CV_ROWS) { return 0; }
    if (field == 0) { return CV_ROW_F0_OFFSET[row]; }
    if (field == 1) { return CV_ROW_F1_OFFSET[row]; }
    return CV_ROW_F2_OFFSET[row];
}

pub fn cv_row_length(row: u32, field: u32) -> u32 {
    if (row >= CV_ROWS or field > 2) { return 0; }
    if (field == 0) { return CV_ROW_F0_LENGTH[row]; }
    if (field == 1) { return CV_ROW_F1_LENGTH[row]; }
    return CV_ROW_F2_LENGTH[row];
}

pub fn cv_row_table(row: u32) -> u32 {
    if (row >= CV_ROWS) { return CV_NO_ROW; }
    return CV_ROW_TABLE[row];
}

pub fn cv_row_code(row: u32) -> u32 {
    if (row >= CV_ROWS) { return 0; }
    return CV_ROW_CODE[row];
}

; Copies one text field of a row into out and returns its length.
pub fn cv_row_text(row: u32, field: u32, out: [4096]u8) -> u32 {
    var length: u32 = cv_row_length(row, field);
    var start: u32 = cv_row_offset(row, field);
    var i: u32 = 0;
    while (i < length) {
        out[i] = CV_TEXT[start + i];
        i = i + 1;
    }
    return length;
}

; Field 0 of the row equals the name (prefix: starts the name).
pub fn cv_row_matches(row: u32, name: [4096]u8, len: u32, prefix: bool) -> bool {
    if (row >= CV_ROWS) { return false; }
    var length: u32 = cv_row_length(row, 0);
    if (prefix) {
        if (len < length) { return false; }
    } else {
        if (len != length) { return false; }
    }
    var start: u32 = cv_row_offset(row, 0);
    var i: u32 = 0;
    while (i < length) {
        if (name[i] != CV_TEXT[start + i]) { return false; }
        i = i + 1;
    }
    return true;
}

; The first row of a table whose name matches; KEEP_PREFIX rows match as prefixes.
pub fn cv_find(table: u32, name: [4096]u8, len: u32) -> u32 {
    var row: u32 = 0;
    while (row < CV_ROWS) {
        if (CV_ROW_TABLE[row] == table) {
            if (cv_row_matches(row, name, len, table == CV_TABLE_KEEP_PREFIX)) { return row; }
        }
        row = row + 1;
    }
    return CV_NO_ROW;
}

; Where a word occurs: 0 exact, 1 prefix, 2 suffix, 3 anywhere.
pub fn cv_has_word(name: [4096]u8, len: u32, word: u32, place: u32) -> bool {
    var wlen: u32 = CV_WORD_LENGTHS[word];
    var wstart: u32 = CV_WORD_OFFSETS[word];
    if (len < wlen) { return false; }
    if (place == 0 and len != wlen) { return false; }
    var first: u32 = 0;
    var last: u32 = len - wlen;
    if (place == 0 or place == 1) { last = 0; }
    if (place == 2) { first = len - wlen; }
    var at: u32 = first;
    while (at <= last) {
        var same: bool = true;
        var i: u32 = 0;
        while (i < wlen) {
            if (name[at + i] != CV_WORD_BYTES[wstart + i]) { same = false; }
            i = i + 1;
        }
        if (same) { return true; }
        at = at + 1;
    }
    return false;
}

; What the lowercased name of an entry of ~/Library/Caches matched.
pub fn cv_name_kind(lower: [4096]u8, len: u32) -> u32 {
    if (len > 4096) { return CV_KIND_OTHER; }
    if (cv_find(CV_TABLE_KEEP, lower, len) != CV_NO_ROW) { return CV_KIND_KEEP; }
    if (cv_find(CV_TABLE_KEEP_PREFIX, lower, len) != CV_NO_ROW) { return CV_KIND_KEEP; }
    var package: u32 = cv_find(CV_TABLE_PACKAGE, lower, len);
    if (package != CV_NO_ROW) { return CV_ROW_CODE[package]; }
    if (cv_find(CV_TABLE_BROWSER, lower, len) != CV_NO_ROW) { return CV_KIND_BROWSER; }
    if (cv_has_word(lower, len, CV_WORD_SHIPIT, 2) or cv_has_word(lower, len, CV_WORD_UPDATER, 3)) { return CV_KIND_UPDATE_DOWNLOAD; }
    if (cv_has_word(lower, len, CV_WORD_CRASHPAD, 3) or cv_has_word(lower, len, CV_WORD_SENTRYCRASH, 0)) { return CV_KIND_CRASH_REPORTS; }
    if (cv_has_word(lower, len, CV_WORD_CRASHLYTICS, 1)) { return CV_KIND_CRASH_REPORTS; }
    return CV_KIND_OTHER;
}

; What the lowercased name of an entry of ~/.cache matched: only package rows count there.
pub fn cv_dot_cache_kind(lower: [4096]u8, len: u32) -> u32 {
    if (len > 4096) { return CV_KIND_OTHER; }
    var package: u32 = cv_find(CV_TABLE_PACKAGE, lower, len);
    if (package != CV_NO_ROW) { return CV_ROW_CODE[package]; }
    return CV_KIND_OTHER;
}

; Xcode names project folders "<Project>-<28 lowercase letters>". Given the class and the UTF-8 length
; of every Character of the name, returns the byte length of <Project>, or 0 when the name is not so.
pub fn cv_xcode_project_length(classes: [4096]u8, lengths: [4096]u8, count: u32) -> u32 {
    if (count > 4096) { return 0; }
    var dash: u32 = count;
    var i: u32 = count;
    while (i > 0) {
        i = i - 1;
        if (classes[i] == CV_CHAR_DASH) { dash = i; i = 0; }
    }
    if (dash == count) { return 0; }
    if (count - dash - 1 != 28) { return 0; }
    var k: u32 = dash + 1;
    while (k < count) {
        if (classes[k] != CV_CHAR_LOWER_LETTER) { return 0; }
        k = k + 1;
    }
    var bytes: u32 = 0;
    var c: u32 = 0;
    while (c < dash) {
        bytes = bytes + lengths[c];
        c = c + 1;
    }
    return bytes;
}

; An updater folder is named after its app: drop every "@", then every "-updater" (ASCII case
; ignored), then turn "_" into " ". Writes the result to out and returns its length.
pub fn cv_updater_owner_name(name: [4096]u8, len: u32, out: [4096]u8) -> u32 {
    if (len > 4096) { return 0; }
    var first: [4096]u8 = [0; 4096];
    var flen: u32 = 0;
    var i: u32 = 0;
    while (i < len) {
        if (name[i] != 64) { first[flen] = name[i]; flen = flen + 1; }
        i = i + 1;
    }
    var olen: u32 = 0;
    var wstart: u32 = CV_WORD_OFFSETS[CV_WORD_UPDATER];
    i = 0;
    while (i < flen) {
        var removed: bool = false;
        if (first[i] == 45 and i + 8 <= flen) {
            var same: bool = true;
            var k: u32 = 0;
            while (k < 7) {
                var c: u8 = first[i + 1 + k];
                if (c >= 65 and c <= 90) { c = c + 32; }
                if (c != CV_WORD_BYTES[wstart + k]) { same = false; }
                k = k + 1;
            }
            if (same) { removed = true; }
        }
        if (removed) {
            i = i + 8;
        } else {
            var b: u8 = first[i];
            if (b == 95) { b = 32; }
            out[olen] = b;
            olen = olen + 1;
            i = i + 1;
        }
    }
    return olen;
}

; --- The reason: the one decision the verdict and the category are read from --------------------
; Facts:
;   location        CV_LOC_*
;   kind            CV_KIND_* (what the name matched)
;   unreadable      part of the folder could not be read (macOS protects it)
;   apple           the name starts with com.apple.
;   directory       the entry is a folder, not a loose file
;   bundle_id       the name is shaped like a bundle ID
;   owner_known     an installed or running app owns it
;   owner_running   that owner (for DerivedData: Xcode) is running now

pub fn cv_reason(location: u32, kind: u32, unreadable: bool, apple: bool, directory: bool, bundle_id: bool, owner_known: bool, owner_running: bool) -> u32 {
    if (unreadable) { return CV_R_PROTECTED; }
    if (location == CV_LOC_DERIVED_DATA) {
        if (owner_running) { return CV_R_XCODE_RUNNING; }
        return CV_R_XCODE_BUILD;
    }
    if (location == CV_LOC_DOT_CACHE) {
        if (kind == CV_KIND_MODELS) { return CV_R_MODELS; }
        if (kind == CV_KIND_PACKAGE) { return CV_R_TOOL_CACHE; }
        return CV_R_DOT_CACHE;
    }
    if (kind == CV_KIND_KEEP) { return CV_R_SYSTEM_STATE; }
    if (kind == CV_KIND_PACKAGE or kind == CV_KIND_MODELS) { return CV_R_PACKAGE_DOWNLOADS; }
    if (kind == CV_KIND_BROWSER) {
        if (owner_running) { return CV_R_BROWSER_RUNNING; }
        return CV_R_BROWSER_CACHE;
    }
    if (kind == CV_KIND_UPDATE_DOWNLOAD) {
        if (owner_running) { return CV_R_UPDATE_IN_PROGRESS; }
        return CV_R_UPDATES;
    }
    if (kind == CV_KIND_CRASH_REPORTS) { return CV_R_UPDATES; }
    if (owner_known and owner_running) { return CV_R_APP_RUNNING; }
    if (apple) { return CV_R_APPLE; }
    if (directory == false) { return CV_R_LOOSE_FILE; }
    if (owner_known) { return CV_R_APP_CACHE; }
    if (bundle_id) { return CV_R_UNINSTALLED; }
    return CV_R_UNKNOWN_OWNER;
}

pub fn cv_verdict_of_reason(reason: u32) -> u32 {
    if (reason == CV_R_PROTECTED or reason == CV_R_SYSTEM_STATE) { return CV_KEEP; }
    if (reason == CV_R_XCODE_RUNNING or reason == CV_R_BROWSER_RUNNING) { return CV_QUIT_FIRST; }
    if (reason == CV_R_UPDATE_IN_PROGRESS or reason == CV_R_APP_RUNNING) { return CV_QUIT_FIRST; }
    if (reason == CV_R_MODELS or reason == CV_R_TOOL_CACHE or reason == CV_R_DOT_CACHE) { return CV_OPTIONAL; }
    if (reason == CV_R_PACKAGE_DOWNLOADS or reason == CV_R_APPLE or reason == CV_R_UNKNOWN_OWNER) { return CV_OPTIONAL; }
    return CV_SAFE;
}

pub fn cv_verdict(location: u32, kind: u32, unreadable: bool, apple: bool, directory: bool, bundle_id: bool, owner_known: bool, owner_running: bool) -> u32 {
    return cv_verdict_of_reason(cv_reason(location, kind, unreadable, apple, directory, bundle_id, owner_known, owner_running));
}

pub fn cv_category(location: u32, kind: u32, unreadable: bool, apple: bool, directory: bool, bundle_id: bool, owner_known: bool, owner_running: bool) -> u32 {
    var reason: u32 = cv_reason(location, kind, unreadable, apple, directory, bundle_id, owner_known, owner_running);
    if (reason == CV_R_PROTECTED) {
        if (apple) { return CV_CAT_SYSTEM; }
        return CV_CAT_UNKNOWN;
    }
    if (reason == CV_R_XCODE_RUNNING or reason == CV_R_XCODE_BUILD) { return CV_CAT_DEVELOPER; }
    if (reason == CV_R_MODELS or reason == CV_R_TOOL_CACHE or reason == CV_R_DOT_CACHE) { return CV_CAT_PACKAGE; }
    if (reason == CV_R_PACKAGE_DOWNLOADS) { return CV_CAT_PACKAGE; }
    if (reason == CV_R_SYSTEM_STATE or reason == CV_R_APPLE) { return CV_CAT_SYSTEM; }
    if (reason == CV_R_BROWSER_RUNNING or reason == CV_R_BROWSER_CACHE) { return CV_CAT_BROWSER; }
    if (reason == CV_R_UPDATE_IN_PROGRESS or reason == CV_R_UPDATES) { return CV_CAT_UPDATER; }
    if (reason == CV_R_APP_RUNNING) {
        if (apple) { return CV_CAT_SYSTEM; }
        return CV_CAT_APPLICATION;
    }
    if (reason == CV_R_LOOSE_FILE) {
        if (owner_known) { return CV_CAT_APPLICATION; }
        return CV_CAT_UNKNOWN;
    }
    if (reason == CV_R_UNKNOWN_OWNER) { return CV_CAT_UNKNOWN; }
    return CV_CAT_APPLICATION;
}

pub fn cv_selectable(verdict: u32) -> bool {
    return verdict == CV_SAFE or verdict == CV_OPTIONAL;
}

; --- Right before the move ---------------------------------------------------------------------
; Facts, read again inside the file coordinator:
;   verdict             the verdict the list showed
;   owner_running_now   the owner started since the scan
;   developer           the cache is Xcode build data
;   xcode_running_now   Xcode is running now
;   path_unchanged      the coordinated path is the scanned path
;   direct_child        the item still sits directly inside the folder it was found in
;   symlink_on_path     a component of the path is a symbolic link

pub fn cv_move_block(verdict: u32, owner_running_now: bool, developer: bool, xcode_running_now: bool, path_unchanged: bool, direct_child: bool, symlink_on_path: bool) -> u32 {
    if (cv_selectable(verdict) == false) { return CV_MOVE_NOT_SELECTABLE; }
    if (owner_running_now) { return CV_MOVE_OWNER_RUNNING; }
    if (developer and xcode_running_now) { return CV_MOVE_XCODE_RUNNING; }
    if (path_unchanged == false) { return CV_MOVE_PATH_CHANGED; }
    if (direct_child == false) { return CV_MOVE_NOT_DIRECT_CHILD; }
    if (symlink_on_path) { return CV_MOVE_SYMLINK; }
    return CV_MOVE_ALLOWED;
}

; --- List order ------------------------------------------------------------------------------------
; Actionable verdicts first, then larger caches; ties fall back to the paths (CV_ORDER_TIE).
pub const CV_ORDER_FIRST : u32 = 0;
pub const CV_ORDER_SECOND : u32 = 1;
pub const CV_ORDER_TIE : u32 = 2;

pub fn cv_list_order(verdict_a: u32, verdict_b: u32, size_a: i64, size_b: i64) -> u32 {
    if (verdict_a < verdict_b) { return CV_ORDER_FIRST; }
    if (verdict_a > verdict_b) { return CV_ORDER_SECOND; }
    if (size_a > size_b) { return CV_ORDER_FIRST; }
    if (size_a < size_b) { return CV_ORDER_SECOND; }
    return CV_ORDER_TIE;
}

; --- Laws ----------------------------------------------------------------------------------------
invariant cv_verdicts_are_ranked { assert CV_SAFE < CV_OPTIONAL and CV_OPTIONAL < CV_QUIT_FIRST and CV_QUIT_FIRST < CV_USE_TOOL and CV_USE_TOOL < CV_KEEP; }
invariant cv_allowed_is_zero { assert CV_MOVE_ALLOWED == 0; }

test cv_protected_folders_are_kept_whatever_else_holds {
    assert cv_verdict(CV_LOC_USER_CACHES, CV_KIND_OTHER, true, false, true, true, true, false) == CV_KEEP;
    assert cv_verdict(CV_LOC_DERIVED_DATA, CV_KIND_OTHER, true, false, true, false, true, false) == CV_KEEP;
    assert cv_verdict(CV_LOC_DOT_CACHE, CV_KIND_PACKAGE, true, false, true, false, false, false) == CV_KEEP;
    assert cv_category(CV_LOC_USER_CACHES, CV_KIND_OTHER, true, true, true, true, false, false) == CV_CAT_SYSTEM;
    assert cv_category(CV_LOC_USER_CACHES, CV_KIND_OTHER, true, false, true, true, false, false) == CV_CAT_UNKNOWN;
}

test cv_derived_data_waits_for_xcode {
    assert cv_verdict(CV_LOC_DERIVED_DATA, CV_KIND_OTHER, false, false, true, false, true, true) == CV_QUIT_FIRST;
    assert cv_verdict(CV_LOC_DERIVED_DATA, CV_KIND_OTHER, false, false, true, false, true, false) == CV_SAFE;
    assert cv_category(CV_LOC_DERIVED_DATA, CV_KIND_OTHER, false, false, true, false, true, false) == CV_CAT_DEVELOPER;
}

test cv_tool_caches_are_optional_and_keep_names_do_not_apply_there {
    assert cv_reason(CV_LOC_DOT_CACHE, CV_KIND_MODELS, false, false, true, false, false, false) == CV_R_MODELS;
    assert cv_reason(CV_LOC_DOT_CACHE, CV_KIND_PACKAGE, false, false, true, false, false, false) == CV_R_TOOL_CACHE;
    assert cv_reason(CV_LOC_DOT_CACHE, CV_KIND_KEEP, false, false, true, false, false, false) == CV_R_DOT_CACHE;
    assert cv_verdict(CV_LOC_DOT_CACHE, CV_KIND_OTHER, false, false, true, false, false, false) == CV_OPTIONAL;
}

test cv_sign_in_state_is_kept_and_downloads_are_optional {
    assert cv_verdict(CV_LOC_USER_CACHES, CV_KIND_KEEP, false, true, true, true, false, false) == CV_KEEP;
    assert cv_verdict(CV_LOC_USER_CACHES, CV_KIND_PACKAGE, false, false, true, false, false, false) == CV_OPTIONAL;
    assert cv_verdict(CV_LOC_USER_CACHES, CV_KIND_MODELS, false, false, true, false, false, false) == CV_OPTIONAL;
    assert cv_category(CV_LOC_USER_CACHES, CV_KIND_KEEP, false, true, true, true, false, false) == CV_CAT_SYSTEM;
}

test cv_a_running_owner_blocks_browsers_updates_and_apps {
    assert cv_verdict(CV_LOC_USER_CACHES, CV_KIND_BROWSER, false, false, true, false, true, true) == CV_QUIT_FIRST;
    assert cv_verdict(CV_LOC_USER_CACHES, CV_KIND_BROWSER, false, false, true, false, true, false) == CV_SAFE;
    assert cv_verdict(CV_LOC_USER_CACHES, CV_KIND_UPDATE_DOWNLOAD, false, false, true, true, true, true) == CV_QUIT_FIRST;
    assert cv_verdict(CV_LOC_USER_CACHES, CV_KIND_CRASH_REPORTS, false, false, true, false, true, true) == CV_SAFE;
    assert cv_verdict(CV_LOC_USER_CACHES, CV_KIND_OTHER, false, false, true, true, true, true) == CV_QUIT_FIRST;
    assert cv_category(CV_LOC_USER_CACHES, CV_KIND_OTHER, false, true, true, true, true, true) == CV_CAT_SYSTEM;
}

test cv_idle_owners_uninstalled_apps_and_strangers {
    assert cv_reason(CV_LOC_USER_CACHES, CV_KIND_OTHER, false, true, true, true, false, false) == CV_R_APPLE;
    assert cv_reason(CV_LOC_USER_CACHES, CV_KIND_OTHER, false, false, false, false, false, false) == CV_R_LOOSE_FILE;
    assert cv_reason(CV_LOC_USER_CACHES, CV_KIND_OTHER, false, false, true, true, true, false) == CV_R_APP_CACHE;
    assert cv_reason(CV_LOC_USER_CACHES, CV_KIND_OTHER, false, false, true, true, false, false) == CV_R_UNINSTALLED;
    assert cv_reason(CV_LOC_USER_CACHES, CV_KIND_OTHER, false, false, true, false, false, false) == CV_R_UNKNOWN_OWNER;
    assert cv_verdict(CV_LOC_USER_CACHES, CV_KIND_OTHER, false, false, true, true, false, false) == CV_SAFE;
    assert cv_verdict(CV_LOC_USER_CACHES, CV_KIND_OTHER, false, false, true, false, false, false) == CV_OPTIONAL;
    assert cv_category(CV_LOC_USER_CACHES, CV_KIND_OTHER, false, false, false, false, true, false) == CV_CAT_APPLICATION;
}

test cv_the_move_is_refused_when_anything_changed {
    assert cv_move_block(CV_SAFE, false, false, false, true, true, false) == CV_MOVE_ALLOWED;
    assert cv_move_block(CV_OPTIONAL, false, false, false, true, true, false) == CV_MOVE_ALLOWED;
    assert cv_move_block(CV_KEEP, false, false, false, true, true, false) == CV_MOVE_NOT_SELECTABLE;
    assert cv_move_block(CV_USE_TOOL, false, false, false, true, true, false) == CV_MOVE_NOT_SELECTABLE;
    assert cv_move_block(CV_SAFE, true, false, false, true, true, false) == CV_MOVE_OWNER_RUNNING;
    assert cv_move_block(CV_SAFE, false, true, true, true, true, false) == CV_MOVE_XCODE_RUNNING;
    assert cv_move_block(CV_SAFE, false, false, true, true, true, false) == CV_MOVE_ALLOWED;
    assert cv_move_block(CV_SAFE, false, false, false, false, true, false) == CV_MOVE_PATH_CHANGED;
    assert cv_move_block(CV_SAFE, false, false, false, true, false, false) == CV_MOVE_NOT_DIRECT_CHILD;
    assert cv_move_block(CV_SAFE, false, false, false, true, true, true) == CV_MOVE_SYMLINK;
}

test cv_every_reason_maps_to_one_verdict {
    assert cv_verdict_of_reason(CV_R_PROTECTED) == CV_KEEP;
    assert cv_verdict_of_reason(CV_R_SYSTEM_STATE) == CV_KEEP;
    assert cv_verdict_of_reason(CV_R_XCODE_RUNNING) == CV_QUIT_FIRST;
    assert cv_verdict_of_reason(CV_R_BROWSER_RUNNING) == CV_QUIT_FIRST;
    assert cv_verdict_of_reason(CV_R_UPDATE_IN_PROGRESS) == CV_QUIT_FIRST;
    assert cv_verdict_of_reason(CV_R_APP_RUNNING) == CV_QUIT_FIRST;
    assert cv_verdict_of_reason(CV_R_MODELS) == CV_OPTIONAL;
    assert cv_verdict_of_reason(CV_R_TOOL_CACHE) == CV_OPTIONAL;
    assert cv_verdict_of_reason(CV_R_DOT_CACHE) == CV_OPTIONAL;
    assert cv_verdict_of_reason(CV_R_PACKAGE_DOWNLOADS) == CV_OPTIONAL;
    assert cv_verdict_of_reason(CV_R_APPLE) == CV_OPTIONAL;
    assert cv_verdict_of_reason(CV_R_UNKNOWN_OWNER) == CV_OPTIONAL;
    assert cv_verdict_of_reason(CV_R_XCODE_BUILD) == CV_SAFE;
    assert cv_verdict_of_reason(CV_R_BROWSER_CACHE) == CV_SAFE;
    assert cv_verdict_of_reason(CV_R_UPDATES) == CV_SAFE;
    assert cv_verdict_of_reason(CV_R_LOOSE_FILE) == CV_SAFE;
    assert cv_verdict_of_reason(CV_R_APP_CACHE) == CV_SAFE;
    assert cv_verdict_of_reason(CV_R_UNINSTALLED) == CV_SAFE;
}

test cv_only_safe_and_optional_can_be_selected {
    assert cv_selectable(CV_SAFE) == true;
    assert cv_selectable(CV_OPTIONAL) == true;
    assert cv_selectable(CV_QUIT_FIRST) == false;
    assert cv_selectable(CV_USE_TOOL) == false;
    assert cv_selectable(CV_KEEP) == false;
}

test cv_names_match_their_tables {
    var n: [4096]u8 = [0; 4096];
    n[0] = 104; n[1] = 111; n[2] = 109; n[3] = 101; n[4] = 98; n[5] = 114; n[6] = 101; n[7] = 119;
    assert cv_name_kind(n, 8) == CV_KIND_PACKAGE;
    n[0] = 104; n[1] = 117; n[2] = 103; n[3] = 103; n[4] = 105; n[5] = 110; n[6] = 103; n[7] = 102; n[8] = 97; n[9] = 99; n[10] = 101;
    assert cv_name_kind(n, 11) == CV_KIND_MODELS;
    n[0] = 99; n[1] = 108; n[2] = 111; n[3] = 117; n[4] = 100; n[5] = 107; n[6] = 105; n[7] = 116;
    assert cv_name_kind(n, 8) == CV_KIND_KEEP;
    n[0] = 99; n[1] = 111; n[2] = 109; n[3] = 46; n[4] = 97; n[5] = 112; n[6] = 112; n[7] = 108; n[8] = 101; n[9] = 46; n[10] = 115; n[11] = 101; n[12] = 99; n[13] = 117; n[14] = 114; n[15] = 105; n[16] = 116; n[17] = 121; n[18] = 46; n[19] = 97; n[20] = 103; n[21] = 101; n[22] = 110; n[23] = 116;
    assert cv_name_kind(n, 24) == CV_KIND_KEEP;
    n[0] = 103; n[1] = 111; n[2] = 111; n[3] = 103; n[4] = 108; n[5] = 101;
    assert cv_name_kind(n, 6) == CV_KIND_BROWSER;
    n[0] = 99; n[1] = 111; n[2] = 109; n[3] = 46; n[4] = 118; n[5] = 101; n[6] = 110; n[7] = 100; n[8] = 111; n[9] = 114; n[10] = 46; n[11] = 97; n[12] = 112; n[13] = 112; n[14] = 46; n[15] = 115; n[16] = 104; n[17] = 105; n[18] = 112; n[19] = 105; n[20] = 116;
    assert cv_name_kind(n, 21) == CV_KIND_UPDATE_DOWNLOAD;
    n[0] = 118; n[1] = 101; n[2] = 110; n[3] = 100; n[4] = 111; n[5] = 114; n[6] = 45; n[7] = 117; n[8] = 112; n[9] = 100; n[10] = 97; n[11] = 116; n[12] = 101; n[13] = 114; n[14] = 45; n[15] = 120;
    assert cv_name_kind(n, 16) == CV_KIND_UPDATE_DOWNLOAD;
    n[0] = 99; n[1] = 104; n[2] = 114; n[3] = 111; n[4] = 109; n[5] = 101; n[6] = 95; n[7] = 99; n[8] = 114; n[9] = 97; n[10] = 115; n[11] = 104; n[12] = 112; n[13] = 97; n[14] = 100; n[15] = 95; n[16] = 104; n[17] = 97; n[18] = 110; n[19] = 100; n[20] = 108; n[21] = 101; n[22] = 114;
    assert cv_name_kind(n, 23) == CV_KIND_CRASH_REPORTS;
    n[0] = 115; n[1] = 101; n[2] = 110; n[3] = 116; n[4] = 114; n[5] = 121; n[6] = 99; n[7] = 114; n[8] = 97; n[9] = 115; n[10] = 104;
    assert cv_name_kind(n, 11) == CV_KIND_CRASH_REPORTS;
    n[0] = 99; n[1] = 111; n[2] = 109; n[3] = 46; n[4] = 99; n[5] = 114; n[6] = 97; n[7] = 115; n[8] = 104; n[9] = 108; n[10] = 121; n[11] = 116; n[12] = 105; n[13] = 99; n[14] = 115; n[15] = 46; n[16] = 100; n[17] = 97; n[18] = 116; n[19] = 97;
    assert cv_name_kind(n, 20) == CV_KIND_CRASH_REPORTS;
    n[0] = 115; n[1] = 101; n[2] = 110; n[3] = 116; n[4] = 114; n[5] = 121; n[6] = 99; n[7] = 114; n[8] = 97; n[9] = 115; n[10] = 104; n[11] = 120;
    assert cv_name_kind(n, 12) == CV_KIND_OTHER;
    n[0] = 109; n[1] = 121; n[2] = 115; n[3] = 116; n[4] = 101; n[5] = 114; n[6] = 121; n[7] = 116; n[8] = 111; n[9] = 111; n[10] = 108;
    assert cv_name_kind(n, 11) == CV_KIND_OTHER;
    n[0] = 104; n[1] = 117; n[2] = 103; n[3] = 103; n[4] = 105; n[5] = 110; n[6] = 103; n[7] = 102; n[8] = 97; n[9] = 99; n[10] = 101;
    assert cv_dot_cache_kind(n, 11) == CV_KIND_MODELS;
    n[0] = 103; n[1] = 111; n[2] = 111; n[3] = 103; n[4] = 108; n[5] = 101;
    assert cv_dot_cache_kind(n, 6) == CV_KIND_OTHER;
    assert cv_find(CV_TABLE_PACKAGE, n, 6) == CV_NO_ROW;
    assert cv_row_table(CV_ROWS) == CV_NO_ROW;
    assert cv_row_code(CV_ROWS) == 0;
    assert cv_row_length(CV_ROWS, 0) == 0;
    var out: [4096]u8 = [0; 4096];
    var row: u32 = cv_find(CV_TABLE_BROWSER, n, 6);
    assert cv_row_table(row) == CV_TABLE_BROWSER;
    assert cv_row_code(row) == 0;
    assert cv_row_text(row, 1, out) == 13;
    assert out[0] == 71;
    assert cv_row_offset(row, 2) > cv_row_offset(row, 1);
    n[0] = 97; n[1] = 98;
    assert cv_row_matches(cv_find(CV_TABLE_KEEP_PREFIX, n, 2), n, 2, true) == false;
    n[0] = 118; n[1] = 101; n[2] = 110; n[3] = 100; n[4] = 111; n[5] = 114; n[6] = 45; n[7] = 97; n[8] = 112; n[9] = 112;
    assert cv_has_word(n, 10, CV_WORD_UPDATER, 3) == false;
}

test cv_xcode_projects_and_updater_owners {
    var classes: [4096]u8 = [0; 4096];
    var lengths: [4096]u8 = [0; 4096];
    // "App-" + 28 lowercase letters
    var i: u32 = 0;
    while (i < 32) { lengths[i] = 1; classes[i] = 1; i = i + 1; }
    classes[3] = 2;
    assert cv_xcode_project_length(classes, lengths, 32) == 3;
    assert cv_xcode_project_length(classes, lengths, 31) == 0;
    classes[10] = 0;
    assert cv_xcode_project_length(classes, lengths, 32) == 0;
    classes[3] = 0;
    assert cv_xcode_project_length(classes, lengths, 32) == 0;
    var n: [4096]u8 = [0; 4096];
    var out: [4096]u8 = [0; 4096];
    n[0] = 64; n[1] = 118; n[2] = 101; n[3] = 110; n[4] = 100; n[5] = 111; n[6] = 114; n[7] = 95; n[8] = 97; n[9] = 112; n[10] = 112; n[11] = 45; n[12] = 85; n[13] = 80; n[14] = 68; n[15] = 65; n[16] = 84; n[17] = 69; n[18] = 82;
    assert cv_updater_owner_name(n, 19, out) == 10;
    assert out[0] == 118;
    assert out[6] == 32;
}

test cv_list_order_ranks_then_sizes {
    assert cv_list_order(CV_SAFE, CV_KEEP, 1, 100) == CV_ORDER_FIRST;
    assert cv_list_order(CV_KEEP, CV_SAFE, 100, 1) == CV_ORDER_SECOND;
    assert cv_list_order(CV_SAFE, CV_SAFE, 5, 3) == CV_ORDER_FIRST;
    assert cv_list_order(CV_SAFE, CV_SAFE, 3, 5) == CV_ORDER_SECOND;
    assert cv_list_order(CV_SAFE, CV_SAFE, 3, 3) == CV_ORDER_TIE;
}
