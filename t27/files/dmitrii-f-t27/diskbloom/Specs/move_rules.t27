// SPDX-License-Identifier: MIT
; Specs/move_rules.t27 -- DiskBloom: the order of checks around a move to the Trash, and what its result means
; Four places move items to the Trash: the Disk Map queue, Caches, Possible Leftovers and the App
; Uninstaller. For each, this spec gives the sequence of checks Swift runs before the queue starts,
; inside the file coordinator before each item moves, and around re-reading the application's
; signature; Swift runs one step at a time and stops at the first that fails, so expensive steps run
; only when the cheaper ones passed. After a move it decides whether the move is confirmed, whether a
; failed move counts as uncertain, and whether the rest of the queue continues. ASCII only.
; Generated C: Sources/Generated/move_rules.h (Specs/generate.sh).

module DiskBloomMoveRules;

; --- Where the move happens ------------------------------------------------------------------------
pub const MV_DISK_MAP : u32 = 0;
pub const MV_CACHES : u32 = 1;
pub const MV_LEFTOVERS : u32 = 2;
pub const MV_UNINSTALLER : u32 = 3;

; --- Phases and steps -------------------------------------------------------------------------------
pub const MV_PHASE_QUEUE : u32 = 0;
pub const MV_PHASE_ITEM : u32 = 1;
pub const MV_PHASE_SIGNATURE : u32 = 2;

pub const MV_STEP_END : u32 = 0;
pub const MV_STEP_OVERLAP : u32 = 1;
pub const MV_STEP_OWNERS : u32 = 2;
pub const MV_STEP_RUNNING : u32 = 3;
pub const MV_STEP_SIGNATURE : u32 = 4;
pub const MV_STEP_CONTINUATION : u32 = 5;
pub const MV_STEP_VALIDATE_ALL : u32 = 6;
pub const MV_STEP_VALIDATE : u32 = 7;
pub const MV_STEP_CAPTURE_IDENTITY : u32 = 8;
pub const MV_STEP_PATH_UNCHANGED : u32 = 9;
pub const MV_STEP_HAS_BUNDLE_SNAPSHOT : u32 = 10;
pub const MV_STEP_SNAPSHOT : u32 = 11;
pub const MV_STEP_SIGNATURE_UNCHANGED : u32 = 12;
; Leftovers check each item's owners and then its folder before moving to the next item.
pub const MV_STEP_OWNERS_AND_VALIDATE_EACH : u32 = 13;

; The step at `index` of a phase; MV_STEP_END after the last.
;   required    (item phase, uninstaller) the item is the application bundle
;   app_moved   (uninstaller) the application already went to the Trash in an earlier run or step
;   has_signature (signature phase) the plan recorded a trusted signature
pub fn mv_step(kind: u32, phase: u32, index: u32, required: bool, app_moved: bool, has_signature: bool) -> u32 {
    if (phase == MV_PHASE_QUEUE) {
        if (kind == MV_UNINSTALLER) {
            if (index == 0) { return MV_STEP_OVERLAP; }
            if (app_moved) {
                if (index == 1) { return MV_STEP_CONTINUATION; }
                if (index == 2) { return MV_STEP_VALIDATE_ALL; }
                return MV_STEP_END;
            }
            if (index == 1) { return MV_STEP_RUNNING; }
            if (index == 2) { return MV_STEP_SIGNATURE; }
            if (index == 3) { return MV_STEP_VALIDATE_ALL; }
            return MV_STEP_END;
        }
        if (kind == MV_LEFTOVERS) {
            if (index == 0) { return MV_STEP_OVERLAP; }
            if (index == 1) { return MV_STEP_OWNERS_AND_VALIDATE_EACH; }
            return MV_STEP_END;
        }
        return MV_STEP_END;
    }
    if (phase == MV_PHASE_ITEM) {
        if (kind == MV_UNINSTALLER) {
            if (required) {
                if (index == 0) { return MV_STEP_RUNNING; }
                if (index == 1) { return MV_STEP_SIGNATURE; }
                if (index == 2) { return MV_STEP_VALIDATE; }
                if (index == 3) { return MV_STEP_CAPTURE_IDENTITY; }
                if (index == 4) { return MV_STEP_RUNNING; }
                return MV_STEP_END;
            }
            if (index == 0) { return MV_STEP_VALIDATE; }
            if (index == 1) { return MV_STEP_CAPTURE_IDENTITY; }
            if (index == 2 and app_moved) { return MV_STEP_CONTINUATION; }
            return MV_STEP_END;
        }
        if (kind == MV_LEFTOVERS) {
            if (index == 0) { return MV_STEP_OWNERS; }
            if (index == 1) { return MV_STEP_VALIDATE; }
            if (index == 2) { return MV_STEP_OWNERS; }
            if (index == 3) { return MV_STEP_VALIDATE; }
            if (index == 4) { return MV_STEP_CAPTURE_IDENTITY; }
            return MV_STEP_END;
        }
        if (index == 0) { return MV_STEP_VALIDATE; }
        if (index == 1) { return MV_STEP_CAPTURE_IDENTITY; }
        return MV_STEP_END;
    }
    if (phase == MV_PHASE_SIGNATURE) {
        if (has_signature == false) { return MV_STEP_END; }
        if (index == 0) { return MV_STEP_PATH_UNCHANGED; }
        if (index == 1) { return MV_STEP_HAS_BUNDLE_SNAPSHOT; }
        if (index == 2) { return MV_STEP_SNAPSHOT; }
        if (index == 3) { return MV_STEP_SIGNATURE_UNCHANGED; }
        if (index == 4) { return MV_STEP_SNAPSHOT; }
        return MV_STEP_END;
    }
    return MV_STEP_END;
}

; --- After the move -----------------------------------------------------------------------------------
pub const MV_NOTHING : u32 = 0;
pub const MV_MOVED : u32 = 1;
pub const MV_FAILED : u32 = 2;

; The Trash gave back a path whose identity is the moved item's (and, where the kind is checked, a
; folder stays a folder and a file a file; leftovers are always folders; caches do not check).
; kind_known: the moved item's kind could be read at all; an unreadable kind confirms nothing.
pub fn mv_confirmed(kind: u32, moved_path_returned: bool, identity_matches: bool, kind_known: bool, is_directory_after: bool, expected_directory: bool) -> bool {
    if (moved_path_returned == false or identity_matches == false) { return false; }
    if (kind == MV_CACHES) { return true; }
    if (kind_known == false) { return false; }
    if (kind == MV_LEFTOVERS) { return is_directory_after; }
    return is_directory_after == expected_directory;
}

; How one item ended. A coordinator error or a refusal is a failure; a move only counts when it ran.
pub fn mv_result(coordination_error: bool, failure: bool, moved: bool) -> u32 {
    if (coordination_error or failure) { return MV_FAILED; }
    if (moved) { return MV_MOVED; }
    return MV_NOTHING;
}

; Whether a failed move may have happened anyway, so automatic retry must stay blocked.
pub const MV_FAILED_UNCONFIRMED : u32 = 0;
pub const MV_FAILED_THREW : u32 = 1;
pub const MV_FAILED_COORDINATOR : u32 = 2;

pub fn mv_uncertain(kind: u32, how: u32, source_still_exists: bool) -> bool {
    if (kind == MV_DISK_MAP or kind == MV_CACHES) { return false; }
    if (how == MV_FAILED_UNCONFIRMED and kind == MV_UNINSTALLER) { return true; }
    return source_still_exists == false;
}

; The Disk Map and Caches move independent items and go on after a failure; leftovers and the
; uninstaller stop, because the next item may depend on the one that failed.
pub fn mv_stop_after_failure(kind: u32) -> bool {
    return kind == MV_LEFTOVERS or kind == MV_UNINSTALLER;
}

test mv_queue_steps {
    assert mv_step(MV_UNINSTALLER, MV_PHASE_QUEUE, 0, false, false, false) == MV_STEP_OVERLAP;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_QUEUE, 1, false, false, false) == MV_STEP_RUNNING;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_QUEUE, 2, false, false, false) == MV_STEP_SIGNATURE;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_QUEUE, 3, false, false, false) == MV_STEP_VALIDATE_ALL;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_QUEUE, 4, false, false, false) == MV_STEP_END;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_QUEUE, 1, false, true, false) == MV_STEP_CONTINUATION;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_QUEUE, 2, false, true, false) == MV_STEP_VALIDATE_ALL;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_QUEUE, 3, false, true, false) == MV_STEP_END;
    assert mv_step(MV_LEFTOVERS, MV_PHASE_QUEUE, 0, false, false, false) == MV_STEP_OVERLAP;
    assert mv_step(MV_LEFTOVERS, MV_PHASE_QUEUE, 1, false, false, false) == MV_STEP_OWNERS_AND_VALIDATE_EACH;
    assert mv_step(MV_LEFTOVERS, MV_PHASE_QUEUE, 2, false, false, false) == MV_STEP_END;
    assert mv_step(MV_CACHES, MV_PHASE_QUEUE, 0, false, false, false) == MV_STEP_END;
    assert mv_step(MV_CACHES, 9, 0, false, false, false) == MV_STEP_END;
}

test mv_item_and_signature_steps {
    assert mv_step(MV_UNINSTALLER, MV_PHASE_ITEM, 0, true, false, false) == MV_STEP_RUNNING;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_ITEM, 1, true, false, false) == MV_STEP_SIGNATURE;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_ITEM, 2, true, false, false) == MV_STEP_VALIDATE;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_ITEM, 3, true, false, false) == MV_STEP_CAPTURE_IDENTITY;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_ITEM, 4, true, false, false) == MV_STEP_RUNNING;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_ITEM, 5, true, false, false) == MV_STEP_END;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_ITEM, 0, false, true, false) == MV_STEP_VALIDATE;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_ITEM, 1, false, true, false) == MV_STEP_CAPTURE_IDENTITY;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_ITEM, 2, false, true, false) == MV_STEP_CONTINUATION;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_ITEM, 2, false, false, false) == MV_STEP_END;
    assert mv_step(MV_LEFTOVERS, MV_PHASE_ITEM, 0, false, false, false) == MV_STEP_OWNERS;
    assert mv_step(MV_LEFTOVERS, MV_PHASE_ITEM, 3, false, false, false) == MV_STEP_VALIDATE;
    assert mv_step(MV_LEFTOVERS, MV_PHASE_ITEM, 4, false, false, false) == MV_STEP_CAPTURE_IDENTITY;
    assert mv_step(MV_LEFTOVERS, MV_PHASE_ITEM, 5, false, false, false) == MV_STEP_END;
    assert mv_step(MV_DISK_MAP, MV_PHASE_ITEM, 0, false, false, false) == MV_STEP_VALIDATE;
    assert mv_step(MV_CACHES, MV_PHASE_ITEM, 1, false, false, false) == MV_STEP_CAPTURE_IDENTITY;
    assert mv_step(MV_CACHES, MV_PHASE_ITEM, 2, false, false, false) == MV_STEP_END;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_SIGNATURE, 0, false, false, false) == MV_STEP_END;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_SIGNATURE, 0, false, false, true) == MV_STEP_PATH_UNCHANGED;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_SIGNATURE, 2, false, false, true) == MV_STEP_SNAPSHOT;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_SIGNATURE, 3, false, false, true) == MV_STEP_SIGNATURE_UNCHANGED;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_SIGNATURE, 4, false, false, true) == MV_STEP_SNAPSHOT;
    assert mv_step(MV_UNINSTALLER, MV_PHASE_SIGNATURE, 5, false, false, true) == MV_STEP_END;
}

test mv_results {
    assert mv_confirmed(MV_CACHES, true, true, false, false, true) == true;
    assert mv_confirmed(MV_CACHES, false, true, true, true, true) == false;
    assert mv_confirmed(MV_LEFTOVERS, true, true, true, false, false) == false;
    assert mv_confirmed(MV_LEFTOVERS, true, true, true, true, false) == true;
    assert mv_confirmed(MV_LEFTOVERS, true, true, false, true, false) == false;
    assert mv_confirmed(MV_DISK_MAP, true, true, true, false, true) == false;
    assert mv_confirmed(MV_DISK_MAP, true, true, false, false, false) == false;
    assert mv_confirmed(MV_UNINSTALLER, true, false, true, true, true) == false;
    assert mv_confirmed(MV_UNINSTALLER, true, true, true, true, true) == true;
    assert mv_result(true, false, true) == MV_FAILED;
    assert mv_result(false, true, false) == MV_FAILED;
    assert mv_result(false, false, true) == MV_MOVED;
    assert mv_result(false, false, false) == MV_NOTHING;
    assert mv_uncertain(MV_DISK_MAP, MV_FAILED_THREW, false) == false;
    assert mv_uncertain(MV_UNINSTALLER, MV_FAILED_UNCONFIRMED, true) == true;
    assert mv_uncertain(MV_LEFTOVERS, MV_FAILED_UNCONFIRMED, true) == false;
    assert mv_uncertain(MV_LEFTOVERS, MV_FAILED_UNCONFIRMED, false) == true;
    assert mv_uncertain(MV_UNINSTALLER, MV_FAILED_THREW, true) == false;
    assert mv_uncertain(MV_UNINSTALLER, MV_FAILED_COORDINATOR, false) == true;
    assert mv_stop_after_failure(MV_CACHES) == false;
    assert mv_stop_after_failure(MV_UNINSTALLER) == true;
}
