// SPDX-License-Identifier: MIT
; Specs/leftovers_policy.t27 -- DiskBloom Possible Leftovers: which Library folders may be offered and moved
; Swift (Sources/OrphanedAppData.swift) lists the direct entries of eight ~/Library folders, looks up
; every owner it can find (installed apps, their embedded bundles, running apps, LaunchServices,
; launchd) and walks each candidate folder. This spec decides from those facts: whether an entry is a
; candidate at all, whether an owner claims it, how risky and how certain it is, whether any single file
; inside makes the folder unsafe, and whether the folder may move right now. ASCII only.
; Generated C: Sources/Generated/leftovers_policy.h (Specs/generate.sh).

module DiskBloomLeftoversPolicy;

; --- Library folders, in the order Swift declares OrphanDataRule -----------------------------------
pub const LO_RULE_APPLICATION_SUPPORT : u32 = 0;
pub const LO_RULE_CACHE : u32 = 1;
pub const LO_RULE_SAVED_STATE : u32 = 2;
pub const LO_RULE_HTTP_STORAGE : u32 = 3;
pub const LO_RULE_WEBKIT : u32 = 4;
pub const LO_RULE_LOG : u32 = 5;
pub const LO_RULE_CONTAINER : u32 = 6;
pub const LO_RULE_APPLICATION_SCRIPTS : u32 = 7;

pub const LO_RISK_DISPOSABLE : u32 = 0;
pub const LO_RISK_PRIVATE : u32 = 1;
pub const LO_RISK_PERSISTENT : u32 = 2;

pub const LO_PROBABLE : u32 = 0;
pub const LO_POSSIBLE : u32 = 1;

; --- Who claims a bundle ID -----------------------------------------------------------------------------
pub const LO_CLAIM_NONE : u32 = 0;
pub const LO_CLAIM_INVALID_ID : u32 = 1;
pub const LO_CLAIM_EXACT : u32 = 2;
pub const LO_CLAIM_RELATED : u32 = 3;
pub const LO_CLAIM_NAMESPACE : u32 = 4;

; --- Why one file inside a candidate folder makes it unsafe ---------------------------------------------
pub const LO_ENTRY_OK : u32 = 0;
pub const LO_ENTRY_NO_STAT : u32 = 1;
pub const LO_ENTRY_OTHER_USER : u32 = 2;
pub const LO_ENTRY_FLAGS : u32 = 3;
pub const LO_ENTRY_OTHER_VOLUME : u32 = 4;
pub const LO_ENTRY_SYMLINK : u32 = 5;
pub const LO_ENTRY_EXECUTABLE_BUNDLE : u32 = 6;
pub const LO_ENTRY_EXECUTABLE_FILE : u32 = 7;

; --- Why a measured folder cannot be selected -------------------------------------------------------------
pub const LO_TREE_OK : u32 = 0;
pub const LO_TREE_NO_PATH : u32 = 1;
pub const LO_TREE_INCOMPLETE : u32 = 2;
pub const LO_TREE_UNREADABLE : u32 = 3;
pub const LO_TREE_OUTSIDE_LIBRARY : u32 = 4;
pub const LO_TREE_CONTENTS : u32 = 5;

; --- Why a folder may not move right now -------------------------------------------------------------------
pub const LO_MOVE_OK : u32 = 0;
pub const LO_MOVE_BLOCKED : u32 = 1;
pub const LO_MOVE_ID_CHANGED : u32 = 2;
pub const LO_MOVE_PATH_CHANGED : u32 = 3;
pub const LO_MOVE_RULE_MISMATCH : u32 = 4;
pub const LO_MOVE_SYMLINK : u32 = 5;
pub const LO_MOVE_NOT_FOLDER : u32 = 6;
pub const LO_MOVE_NETWORK : u32 = 7;
pub const LO_MOVE_READ_ONLY : u32 = 8;
pub const LO_MOVE_CLOUD : u32 = 9;
pub const LO_MOVE_CONTENTS : u32 = 10;

; --- Risk and certainty ---------------------------------------------------------------------------------------

pub fn lo_rule_risk(rule: u32) -> u32 {
    if (rule == LO_RULE_CACHE or rule == LO_RULE_SAVED_STATE or rule == LO_RULE_LOG) { return LO_RISK_DISPOSABLE; }
    if (rule == LO_RULE_HTTP_STORAGE or rule == LO_RULE_WEBKIT) { return LO_RISK_PRIVATE; }
    return LO_RISK_PERSISTENT;
}

pub fn lo_risk_needs_acknowledgement(risk: u32) -> bool {
    return risk != LO_RISK_DISPOSABLE;
}

; The same exact bundle ID in two or more independent Library folders is a probable leftover.
pub fn lo_confidence(distinct_rules: u32) -> u32 {
    if (distinct_rules >= 2) { return LO_PROBABLE; }
    return LO_POSSIBLE;
}

; --- Is a Library entry a candidate at all? ---------------------------------------------------------------------
;   identifier_parsed    the entry's name yields an identifier for its folder (.savedState needs the suffix)
;   canonical            the identifier passes the bundle ID safety check
;   apple, app_group     it starts with com.apple. or group.
;   path_matches_rule    the folder's rule rebuilds exactly this path from the identifier
;   values_readable, directory, symlink, volume_local, volume_read_only, ubiquitous
;   symlinked_component  a component of the path is a symbolic link

pub fn lo_is_candidate(identifier_parsed: bool, canonical: bool, apple: bool, app_group: bool, path_matches_rule: bool, values_readable: bool, directory: bool, symlink: bool, volume_local: bool, volume_read_only: bool, ubiquitous: bool, symlinked_component: bool) -> bool {
    if (identifier_parsed == false or canonical == false) { return false; }
    if (apple or app_group) { return false; }
    if (path_matches_rule == false or values_readable == false) { return false; }
    if (directory == false or symlink) { return false; }
    if (volume_local == false or volume_read_only or ubiquitous) { return false; }
    if (symlinked_component) { return false; }
    return true;
}

; --- Does an owner claim the bundle ID? --------------------------------------------------------------------------
;   canonical          the ID passes the safety check
;   exact              an owner has exactly this ID
;   related            an owner's ID is this ID plus a suffix, or this ID's prefix
;   namespace_sibling  an owner shares the first two components (the vendor namespace)

pub fn lo_claim(canonical: bool, exact: bool, related: bool, namespace_sibling: bool) -> u32 {
    if (canonical == false) { return LO_CLAIM_INVALID_ID; }
    if (exact) { return LO_CLAIM_EXACT; }
    if (related) { return LO_CLAIM_RELATED; }
    if (namespace_sibling) { return LO_CLAIM_NAMESPACE; }
    return LO_CLAIM_NONE;
}

; --- One file or folder inside a candidate --------------------------------------------------------------------------
;   stat_ok            lstat succeeded
;   owned_by_user      owned by the current user
;   immutable          an immutable or append-only flag is set
;   same_device        on the candidate folder's volume
;   symlink            it is a symbolic link
;   executable_bundle  an .app, .appex, .xpc or .systemextension
;   executable_file    a regular file with an execute bit

pub fn lo_entry_issue(stat_ok: bool, owned_by_user: bool, immutable: bool, same_device: bool, symlink: bool, executable_bundle: bool, executable_file: bool) -> u32 {
    if (stat_ok == false) { return LO_ENTRY_NO_STAT; }
    if (owned_by_user == false) { return LO_ENTRY_OTHER_USER; }
    if (immutable) { return LO_ENTRY_FLAGS; }
    if (same_device == false) { return LO_ENTRY_OTHER_VOLUME; }
    if (symlink) { return LO_ENTRY_SYMLINK; }
    if (executable_bundle) { return LO_ENTRY_EXECUTABLE_BUNDLE; }
    if (executable_file) { return LO_ENTRY_EXECUTABLE_FILE; }
    return LO_ENTRY_OK;
}

; --- Can a measured folder be selected? -------------------------------------------------------------------------------
;   has_path, snapshot_complete, unreadable, inside_library
;   contents_ok        the walk found no unsafe entry and no enumeration error

pub fn lo_tree_issue(has_path: bool, snapshot_complete: bool, unreadable: bool, inside_library: bool, contents_ok: bool) -> u32 {
    if (has_path == false) { return LO_TREE_NO_PATH; }
    if (snapshot_complete == false) { return LO_TREE_INCOMPLETE; }
    if (unreadable) { return LO_TREE_UNREADABLE; }
    if (inside_library == false) { return LO_TREE_OUTSIDE_LIBRARY; }
    if (contents_ok == false) { return LO_TREE_CONTENTS; }
    return LO_TREE_OK;
}

; --- May the folder move right now? Swift compares the snapshot only after LO_MOVE_OK. --------------------------------
;   item_blocked        the analysis marked the folder as not selectable
;   id_still_canonical  the identifier still passes and still canonicalises to the analysed ID
;   path_unchanged, path_matches_rule, symlinked_component
;   regular_folder      readable, a directory and not a link
;   volume_local, volume_read_only, ubiquitous
;   tree_ok             lo_tree_issue is LO_TREE_OK again now

pub fn lo_move_issue(item_blocked: bool, id_still_canonical: bool, path_unchanged: bool, path_matches_rule: bool, symlinked_component: bool, regular_folder: bool, volume_local: bool, volume_read_only: bool, ubiquitous: bool, tree_ok: bool) -> u32 {
    if (item_blocked) { return LO_MOVE_BLOCKED; }
    if (id_still_canonical == false) { return LO_MOVE_ID_CHANGED; }
    if (path_unchanged == false) { return LO_MOVE_PATH_CHANGED; }
    if (path_matches_rule == false) { return LO_MOVE_RULE_MISMATCH; }
    if (symlinked_component) { return LO_MOVE_SYMLINK; }
    if (regular_folder == false) { return LO_MOVE_NOT_FOLDER; }
    if (volume_local == false) { return LO_MOVE_NETWORK; }
    if (volume_read_only) { return LO_MOVE_READ_ONLY; }
    if (ubiquitous) { return LO_MOVE_CLOUD; }
    if (tree_ok == false) { return LO_MOVE_CONTENTS; }
    return LO_MOVE_OK;
}

; --- Group order ------------------------------------------------------------------------------------
; Probable leftovers first, then larger groups; ties fall back to the identifiers (Swift compares them
; with the system's localised order).
pub const LO_ORDER_FIRST : u32 = 0;
pub const LO_ORDER_SECOND : u32 = 1;
pub const LO_ORDER_TIE : u32 = 2;

pub fn lo_group_order(confidence_a: u32, confidence_b: u32, size_a: i64, size_b: i64) -> u32 {
    if (confidence_a != confidence_b) {
        if (confidence_a == LO_PROBABLE) { return LO_ORDER_FIRST; }
        return LO_ORDER_SECOND;
    }
    if (size_a > size_b) { return LO_ORDER_FIRST; }
    if (size_a < size_b) { return LO_ORDER_SECOND; }
    return LO_ORDER_TIE;
}

; --- Laws ----------------------------------------------------------------------------------------------------------------
invariant lo_ok_codes_are_zero { assert LO_ENTRY_OK == 0 and LO_TREE_OK == 0 and LO_MOVE_OK == 0 and LO_CLAIM_NONE == 0; }

test lo_risk_and_certainty {
    assert lo_rule_risk(LO_RULE_CACHE) == LO_RISK_DISPOSABLE;
    assert lo_rule_risk(LO_RULE_SAVED_STATE) == LO_RISK_DISPOSABLE;
    assert lo_rule_risk(LO_RULE_LOG) == LO_RISK_DISPOSABLE;
    assert lo_rule_risk(LO_RULE_HTTP_STORAGE) == LO_RISK_PRIVATE;
    assert lo_rule_risk(LO_RULE_WEBKIT) == LO_RISK_PRIVATE;
    assert lo_rule_risk(LO_RULE_APPLICATION_SUPPORT) == LO_RISK_PERSISTENT;
    assert lo_rule_risk(LO_RULE_CONTAINER) == LO_RISK_PERSISTENT;
    assert lo_rule_risk(LO_RULE_APPLICATION_SCRIPTS) == LO_RISK_PERSISTENT;
    assert lo_risk_needs_acknowledgement(LO_RISK_DISPOSABLE) == false;
    assert lo_risk_needs_acknowledgement(LO_RISK_PRIVATE) == true;
    assert lo_confidence(1) == LO_POSSIBLE;
    assert lo_confidence(2) == LO_PROBABLE;
    assert lo_confidence(5) == LO_PROBABLE;
}

test lo_only_plain_local_exact_id_folders_are_candidates {
    assert lo_is_candidate(true, true, false, false, true, true, true, false, true, false, false, false) == true;
    assert lo_is_candidate(false, true, false, false, true, true, true, false, true, false, false, false) == false;
    assert lo_is_candidate(true, false, false, false, true, true, true, false, true, false, false, false) == false;
    assert lo_is_candidate(true, true, true, false, true, true, true, false, true, false, false, false) == false;
    assert lo_is_candidate(true, true, false, true, true, true, true, false, true, false, false, false) == false;
    assert lo_is_candidate(true, true, false, false, false, true, true, false, true, false, false, false) == false;
    assert lo_is_candidate(true, true, false, false, true, false, true, false, true, false, false, false) == false;
    assert lo_is_candidate(true, true, false, false, true, true, false, false, true, false, false, false) == false;
    assert lo_is_candidate(true, true, false, false, true, true, true, true, true, false, false, false) == false;
    assert lo_is_candidate(true, true, false, false, true, true, true, false, false, false, false, false) == false;
    assert lo_is_candidate(true, true, false, false, true, true, true, false, true, true, false, false) == false;
    assert lo_is_candidate(true, true, false, false, true, true, true, false, true, false, true, false) == false;
    assert lo_is_candidate(true, true, false, false, true, true, true, false, true, false, false, true) == false;
}

test lo_any_owner_claims_in_order {
    assert lo_claim(false, true, true, true) == LO_CLAIM_INVALID_ID;
    assert lo_claim(true, true, true, true) == LO_CLAIM_EXACT;
    assert lo_claim(true, false, true, true) == LO_CLAIM_RELATED;
    assert lo_claim(true, false, false, true) == LO_CLAIM_NAMESPACE;
    assert lo_claim(true, false, false, false) == LO_CLAIM_NONE;
}

test lo_one_unsafe_file_blocks_the_folder {
    assert lo_entry_issue(true, true, false, true, false, false, false) == LO_ENTRY_OK;
    assert lo_entry_issue(false, false, true, false, true, true, true) == LO_ENTRY_NO_STAT;
    assert lo_entry_issue(true, false, true, false, true, true, true) == LO_ENTRY_OTHER_USER;
    assert lo_entry_issue(true, true, true, false, true, true, true) == LO_ENTRY_FLAGS;
    assert lo_entry_issue(true, true, false, false, true, true, true) == LO_ENTRY_OTHER_VOLUME;
    assert lo_entry_issue(true, true, false, true, true, true, true) == LO_ENTRY_SYMLINK;
    assert lo_entry_issue(true, true, false, true, false, true, true) == LO_ENTRY_EXECUTABLE_BUNDLE;
    assert lo_entry_issue(true, true, false, true, false, false, true) == LO_ENTRY_EXECUTABLE_FILE;
    assert lo_tree_issue(true, true, false, true, true) == LO_TREE_OK;
    assert lo_tree_issue(false, false, true, false, false) == LO_TREE_NO_PATH;
    assert lo_tree_issue(true, false, true, false, false) == LO_TREE_INCOMPLETE;
    assert lo_tree_issue(true, true, true, false, false) == LO_TREE_UNREADABLE;
    assert lo_tree_issue(true, true, false, false, false) == LO_TREE_OUTSIDE_LIBRARY;
    assert lo_tree_issue(true, true, false, true, false) == LO_TREE_CONTENTS;
}

test lo_move_checks_in_order {
    assert lo_move_issue(false, true, true, true, false, true, true, false, false, true) == LO_MOVE_OK;
    assert lo_move_issue(true, false, false, false, true, false, false, true, true, false) == LO_MOVE_BLOCKED;
    assert lo_move_issue(false, false, false, false, true, false, false, true, true, false) == LO_MOVE_ID_CHANGED;
    assert lo_move_issue(false, true, false, false, true, false, false, true, true, false) == LO_MOVE_PATH_CHANGED;
    assert lo_move_issue(false, true, true, false, true, false, false, true, true, false) == LO_MOVE_RULE_MISMATCH;
    assert lo_move_issue(false, true, true, true, true, false, false, true, true, false) == LO_MOVE_SYMLINK;
    assert lo_move_issue(false, true, true, true, false, false, false, true, true, false) == LO_MOVE_NOT_FOLDER;
    assert lo_move_issue(false, true, true, true, false, true, false, true, true, false) == LO_MOVE_NETWORK;
    assert lo_move_issue(false, true, true, true, false, true, true, true, true, false) == LO_MOVE_READ_ONLY;
    assert lo_move_issue(false, true, true, true, false, true, true, false, true, false) == LO_MOVE_CLOUD;
    assert lo_move_issue(false, true, true, true, false, true, true, false, false, false) == LO_MOVE_CONTENTS;
}

test lo_group_order_probable_then_size {
    assert lo_group_order(LO_PROBABLE, LO_POSSIBLE, 1, 9) == LO_ORDER_FIRST;
    assert lo_group_order(LO_POSSIBLE, LO_PROBABLE, 9, 1) == LO_ORDER_SECOND;
    assert lo_group_order(LO_POSSIBLE, LO_POSSIBLE, 9, 1) == LO_ORDER_FIRST;
    assert lo_group_order(LO_POSSIBLE, LO_POSSIBLE, 1, 9) == LO_ORDER_SECOND;
    assert lo_group_order(LO_PROBABLE, LO_PROBABLE, 4, 4) == LO_ORDER_TIE;
}
