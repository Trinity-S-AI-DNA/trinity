// SPDX-License-Identifier: MIT
; Specs/sunburst_rules.t27 -- DiskBloom: the geometry and colours of the ring map
; Sources/SunburstView.swift draws one ring per depth; this spec decides how far the map goes, how each
; child's angle follows from its share of the size, which branch colour a segment inherits, the ring
; radii for the space available, the gap between sectors, and which ring and angle a pointer is on.
; Swift supplies atan2 and hypot from the maths library and draws the paths. Angles are radians,
; measured from the top of the circle (-pi/2) clockwise round to 3*pi/2. ASCII only.
; Generated C: Sources/Generated/sunburst_rules.h (Specs/generate.sh).

module DiskBloomSunburstRules;

pub const SB_MAX_DEPTH : i64 = 6;
pub const SB_MAX_SEGMENTS : i64 = 2400;
pub const SB_PI : f64 = 3.141592653589793;
pub const SB_START_ANGLE : f64 = -1.5707963267948966;
pub const SB_END_ANGLE : f64 = 4.71238898038469;
pub const SB_MIN_SPAN : f64 = 0.00001;
pub const SB_SECTOR_GAP : f64 = 0.006;

; --- Layout --------------------------------------------------------------------------------------------
pub fn sb_lays_out(depth: i64, children: i64, segments: i64) -> bool {
    return depth < SB_MAX_DEPTH and children > 0 and segments < SB_MAX_SEGMENTS;
}

pub fn sb_has_room(segments: i64) -> bool {
    return segments < SB_MAX_SEGMENTS;
}

; A child's share of its parent's ring; negative sizes count as zero.
pub fn sb_share(size: i64, total: i64) -> f64 {
    if (total <= 0 or size <= 0) { return 0.0; }
    var part: f64 = size;
    var whole: f64 = total;
    return part / whole;
}

; Where a child's sector ends: the last child closes the parent's span exactly.
pub fn sb_child_end(cursor: f64, span: f64, share: f64, parent_end: f64, last: bool) -> f64 {
    if (last) { return parent_end; }
    return cursor + span * share;
}

pub fn sb_visible(start: f64, end: f64) -> bool {
    return end - start > SB_MIN_SPAN;
}

; The first ring gives each child its own branch; deeper rings keep their parent's.
pub fn sb_branch(depth: i64, index: i64, inherited: i64) -> i64 {
    if (depth == 0) { return index; }
    return inherited;
}

; --- Colours (hue, saturation, brightness in 0...1) -----------------------------------------------------
pub const SB_HUES : [8]f64 = [0.48, 0.39, 0.15, 0.075, 0.93, 0.73, 0.56, 0.29];
pub const SB_VIRTUAL_RED : f64 = 0.35;
pub const SB_VIRTUAL_GREEN : f64 = 0.39;
pub const SB_VIRTUAL_BLUE : f64 = 0.46;

pub fn sb_hue(branch: i64) -> f64 {
    var b: i64 = branch;
    if (b < 0) { b = 0 - b; }
    return SB_HUES[b % 8];
}

pub fn sb_saturation(depth: i64) -> f64 {
    var d: f64 = depth;
    var s: f64 = 0.82 - d * 0.055;
    if (s < 0.46) { return 0.46; }
    return s;
}

pub fn sb_brightness(depth: i64) -> f64 {
    var d: f64 = depth;
    var v: f64 = 0.96 - d * 0.045;
    if (v < 0.68) { return 0.68; }
    return v;
}

; --- Rings for the space available -----------------------------------------------------------------------
pub fn sb_outer_radius(side: f64) -> f64 {
    var r: f64 = side / 2.0 - 20.0;
    if (r < 110.0) { return 110.0; }
    return r;
}

pub fn sb_inner_radius(outer: f64) -> f64 {
    var r: f64 = outer * 0.24;
    if (r > 84.0) { r = 84.0; }
    if (r < 54.0) { r = 54.0; }
    return r;
}

pub fn sb_ring_count(deepest: i64) -> i64 {
    if (deepest + 1 < 1) { return 1; }
    return deepest + 1;
}

pub fn sb_ring_width(outer: f64, inner: f64, rings: i64) -> f64 {
    var n: f64 = rings;
    var w: f64 = (outer - inner) / n;
    if (w < 12.0) { return 12.0; }
    return w;
}

pub fn sb_ring_inner(inner: f64, depth: i64, width: f64) -> f64 {
    var d: f64 = depth;
    return inner + d * width;
}

pub fn sb_ring_outer(outer: f64, ring_inner: f64, width: f64) -> f64 {
    var r: f64 = ring_inner + width - 2.0;
    if (r > outer) { return outer; }
    return r;
}

; Each sector is trimmed at both ends by the gap, but never by more than a fifth of its span.
pub fn sb_sector_inset(start: f64, end: f64, gap: f64) -> f64 {
    var span: f64 = end - start;
    if (span < 0.0) { span = 0.0; }
    var limit: f64 = span * 0.2;
    if (gap < limit) { return gap; }
    return limit;
}

pub fn sb_center_side(inner: f64) -> f64 {
    return inner * 1.72;
}

pub fn sb_hover_y(height: f64) -> f64 {
    var y: f64 = height - 36.0;
    if (y < 42.0) { return 42.0; }
    return y;
}

; --- Pointing ------------------------------------------------------------------------------------------------
; Inside the centre circle the pointer means "go back".
pub fn sb_in_center(radius: f64, inner: f64) -> bool {
    return radius < inner;
}

; The ring under the pointer, or -1 outside the rings.
pub fn sb_hit_ring(radius: f64, inner: f64, outer: f64, width: f64) -> i64 {
    if (radius < inner or radius > outer) { return -1; }
    var depth: i64 = (radius - inner) / width;
    return depth;
}

; atan2 gives -pi...pi; angles left of the top are moved round so they compare with the layout.
pub fn sb_layout_angle(angle: f64) -> f64 {
    if (angle < SB_START_ANGLE) { return angle + SB_PI * 2.0; }
    return angle;
}

pub fn sb_segment_hit(segment_depth: i64, start: f64, end: f64, depth: i64, angle: f64) -> bool {
    return segment_depth == depth and angle >= start and angle <= end;
}

test sb_layout {
    assert sb_lays_out(0, 3, 0) == true;
    assert sb_lays_out(6, 3, 0) == false;
    assert sb_lays_out(0, 0, 0) == false;
    assert sb_lays_out(0, 3, 2400) == false;
    assert sb_has_room(2399) == true;
    assert sb_share(1, 4) == 0.25;
    assert sb_share(-1, 4) == 0.0;
    assert sb_share(1, 0) == 0.0;
    assert sb_child_end(1.0, 2.0, 0.25, 9.0, false) == 1.5;
    assert sb_child_end(1.0, 2.0, 0.25, 9.0, true) == 9.0;
    assert sb_visible(1.0, 1.1) == true;
    assert sb_visible(1.0, 1.000001) == false;
    assert sb_branch(0, 3, 7) == 3;
    assert sb_branch(2, 3, 7) == 7;
}

test sb_colours_and_rings {
    assert sb_hue(0) == 0.48;
    assert sb_hue(9) == 0.39;
    assert sb_hue(-3) == 0.075;
    assert sb_saturation(0) == 0.82;
    assert sb_saturation(20) == 0.46;
    assert sb_brightness(0) == 0.96;
    assert sb_brightness(20) == 0.68;
    assert sb_outer_radius(100.0) == 110.0;
    assert sb_outer_radius(800.0) == 380.0;
    assert sb_inner_radius(100.0) == 54.0;
    assert sb_inner_radius(1000.0) == 84.0;
    assert sb_inner_radius(300.0) == 72.0;
    assert sb_ring_count(-5) == 1;
    assert sb_ring_count(5) == 6;
    assert sb_ring_width(100.0, 90.0, 2) == 12.0;
    assert sb_ring_width(300.0, 60.0, 4) == 60.0;
    assert sb_ring_inner(60.0, 2, 30.0) == 120.0;
    assert sb_ring_outer(100.0, 90.0, 30.0) == 100.0;
    assert sb_ring_outer(200.0, 90.0, 30.0) == 118.0;
    assert sb_sector_inset(0.0, 1.0, 0.006) == 0.006;
    assert sb_sector_inset(0.0, 0.01, 0.006) == 0.002;
    assert sb_sector_inset(1.0, 0.0, 0.006) == 0.0;
    assert sb_center_side(50.0) == 86.0;
    assert sb_hover_y(50.0) == 42.0;
    assert sb_hover_y(500.0) == 464.0;
}

test sb_pointing {
    assert sb_in_center(10.0, 54.0) == true;
    assert sb_hit_ring(10.0, 54.0, 300.0, 40.0) == -1;
    assert sb_hit_ring(301.0, 54.0, 300.0, 40.0) == -1;
    assert sb_hit_ring(95.0, 54.0, 300.0, 40.0) == 1;
    assert sb_layout_angle(-2.0) > 4.0;
    assert sb_layout_angle(0.5) == 0.5;
    assert sb_segment_hit(1, 0.0, 1.0, 1, 0.5) == true;
    assert sb_segment_hit(1, 0.0, 1.0, 2, 0.5) == false;
    assert sb_segment_hit(1, 0.0, 1.0, 1, 1.5) == false;
}
