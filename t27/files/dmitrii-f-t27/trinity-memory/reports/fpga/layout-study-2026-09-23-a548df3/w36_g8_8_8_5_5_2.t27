module TrinityBramLayoutB8B8B8B5B5B2T27;

// Decoder of the layout (8, 8, 8, 5, 5, 2): groups of these many bits from bit 0 up, each a
// base-3 number of n*(bits) trits. Generated by tools/bram-layout-study.py.
fn lane_of_digit(digit: u16) -> u64 {
    if (digit == 0) { return 2; }
    if (digit == 1) { return 0; }
    return 1;
}

fn group2(code: u16) -> u64 {
    if (code < 3) { return lane_of_digit(code % 3); }
    return 0;
}

fn bad2(code: u16) -> u64 {
    if (code < 3) { return 0; }
    return 1;
}

fn group5(code: u16) -> u64 {
    if (code < 27) { return lane_of_digit(code % 3) | (lane_of_digit((code / 3) % 3) << 2) | (lane_of_digit((code / 9) % 3) << 4); }
    return 0;
}

fn bad5(code: u16) -> u64 {
    if (code < 27) { return 0; }
    return 1;
}

fn group8(code: u16) -> u64 {
    if (code < 243) { return lane_of_digit(code % 3) | (lane_of_digit((code / 3) % 3) << 2) | (lane_of_digit((code / 9) % 3) << 4) | (lane_of_digit((code / 27) % 3) << 6) | (lane_of_digit((code / 81) % 3) << 8); }
    return 0;
}

fn bad8(code: u16) -> u64 {
    if (code < 243) { return 0; }
    return 1;
}

fn decode(word: u64) -> u64 {
    var lanes: u64 = (group8(((word >> 0) & 255) as u16) << 0)
        | (group8(((word >> 8) & 255) as u16) << 10)
        | (group8(((word >> 16) & 255) as u16) << 20)
        | (group5(((word >> 24) & 31) as u16) << 30)
        | (group5(((word >> 29) & 31) as u16) << 36)
        | (group2(((word >> 34) & 3) as u16) << 42);
    var bad: u64 = bad8(((word >> 0) & 255) as u16) + bad8(((word >> 8) & 255) as u16) + bad8(((word >> 16) & 255) as u16) + bad5(((word >> 24) & 31) as u16) + bad5(((word >> 29) & 31) as u16) + bad2(((word >> 34) & 3) as u16);
    return lanes | (bad << 48);
}

fn on_comb(x: u64) -> u64 {
    return decode(x);
}

endmodule
