module TrinityBramLayoutB13B8B8B7T27;

// Decoder of the layout (13, 8, 8, 7): groups of these many bits from bit 0 up, each a
// base-3 number of n*(bits) trits. Generated by tools/bram-layout-study.py.
fn lane_of_digit(digit: u16) -> u64 {
    if (digit == 0) { return 2; }
    if (digit == 1) { return 0; }
    return 1;
}

fn group7(code: u16) -> u64 {
    if (code < 81) { return lane_of_digit(code % 3) | (lane_of_digit((code / 3) % 3) << 2) | (lane_of_digit((code / 9) % 3) << 4) | (lane_of_digit((code / 27) % 3) << 6); }
    return 0;
}

fn bad7(code: u16) -> u64 {
    if (code < 81) { return 0; }
    return 1;
}

fn group8(code: u16) -> u64 {
    if (code < 243) { return lane_of_digit(code % 3) | (lane_of_digit((code / 3) % 3) << 2) | (lane_of_digit((code / 9) % 3) << 4) | (lane_of_digit((code / 27) % 3) << 6) | (lane_of_digit((code / 81) % 3) << 8); }
    return 0;
}

fn bad8(code: u16) -> u64 {
    if (code < 243) { return 0; }
    return 1;
}

fn group13(code: u16) -> u64 {
    if (code < 6561) { return lane_of_digit(code % 3) | (lane_of_digit((code / 3) % 3) << 2) | (lane_of_digit((code / 9) % 3) << 4) | (lane_of_digit((code / 27) % 3) << 6) | (lane_of_digit((code / 81) % 3) << 8) | (lane_of_digit((code / 243) % 3) << 10) | (lane_of_digit((code / 729) % 3) << 12) | (lane_of_digit((code / 2187) % 3) << 14); }
    return 0;
}

fn bad13(code: u16) -> u64 {
    if (code < 6561) { return 0; }
    return 1;
}

fn decode(word: u64) -> u64 {
    var lanes: u64 = (group13(((word >> 0) & 8191) as u16) << 0)
        | (group8(((word >> 13) & 255) as u16) << 16)
        | (group8(((word >> 21) & 255) as u16) << 26)
        | (group7(((word >> 29) & 127) as u16) << 36);
    var bad: u64 = bad13(((word >> 0) & 8191) as u16) + bad8(((word >> 13) & 255) as u16) + bad8(((word >> 21) & 255) as u16) + bad7(((word >> 29) & 127) as u16);
    return lanes | (bad << 48);
}

fn on_comb(x: u64) -> u64 {
    return decode(x);
}

endmodule
