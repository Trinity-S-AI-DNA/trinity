module TrinityBramLayoutB13B13B10T27;

// Decoder of the layout (13, 13, 10): groups of these many bits from bit 0 up, each a
// base-3 number of n*(bits) trits. Generated by tools/bram-layout-study.py.
fn lane_of_digit(digit: u16) -> u64 {
    if (digit == 0) { return 2; }
    if (digit == 1) { return 0; }
    return 1;
}

fn group10(code: u16) -> u64 {
    if (code < 729) { return lane_of_digit(code % 3) | (lane_of_digit((code / 3) % 3) << 2) | (lane_of_digit((code / 9) % 3) << 4) | (lane_of_digit((code / 27) % 3) << 6) | (lane_of_digit((code / 81) % 3) << 8) | (lane_of_digit((code / 243) % 3) << 10); }
    return 0;
}

fn bad10(code: u16) -> u64 {
    if (code < 729) { return 0; }
    return 1;
}

fn group13(code: u16) -> u64 {
    if (code < 6561) { return lane_of_digit(code % 3) | (lane_of_digit((code / 3) % 3) << 2) | (lane_of_digit((code / 9) % 3) << 4) | (lane_of_digit((code / 27) % 3) << 6) | (lane_of_digit((code / 81) % 3) << 8) | (lane_of_digit((code / 243) % 3) << 10) | (lane_of_digit((code / 729) % 3) << 12) | (lane_of_digit((code / 2187) % 3) << 14); }
    return 0;
}

fn bad13(code: u16) -> u64 {
    if (code < 6561) { return 0; }
    return 1;
}

fn decode(word: u64) -> u64 {
    var lanes: u64 = (group13(((word >> 0) & 8191) as u16) << 0)
        | (group13(((word >> 13) & 8191) as u16) << 16)
        | (group10(((word >> 26) & 1023) as u16) << 32);
    var bad: u64 = bad13(((word >> 0) & 8191) as u16) + bad13(((word >> 13) & 8191) as u16) + bad10(((word >> 26) & 1023) as u16);
    return lanes | (bad << 48);
}

fn on_comb(x: u64) -> u64 {
    return decode(x);
}

endmodule
