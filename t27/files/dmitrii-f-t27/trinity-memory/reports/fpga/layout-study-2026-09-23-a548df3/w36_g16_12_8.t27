module TrinityBramLayoutB16B12B8T27;

// Decoder of the layout (16, 12, 8): groups of these many bits from bit 0 up, each a
// base-3 number of n*(bits) trits. Generated by tools/bram-layout-study.py.
fn lane_of_digit(digit: u16) -> u64 {
    if (digit == 0) { return 2; }
    if (digit == 1) { return 0; }
    return 1;
}

fn group8(code: u16) -> u64 {
    if (code < 243) { return lane_of_digit(code % 3) | (lane_of_digit((code / 3) % 3) << 2) | (lane_of_digit((code / 9) % 3) << 4) | (lane_of_digit((code / 27) % 3) << 6) | (lane_of_digit((code / 81) % 3) << 8); }
    return 0;
}

fn bad8(code: u16) -> u64 {
    if (code < 243) { return 0; }
    return 1;
}

fn group12(code: u16) -> u64 {
    if (code < 2187) { return lane_of_digit(code % 3) | (lane_of_digit((code / 3) % 3) << 2) | (lane_of_digit((code / 9) % 3) << 4) | (lane_of_digit((code / 27) % 3) << 6) | (lane_of_digit((code / 81) % 3) << 8) | (lane_of_digit((code / 243) % 3) << 10) | (lane_of_digit((code / 729) % 3) << 12); }
    return 0;
}

fn bad12(code: u16) -> u64 {
    if (code < 2187) { return 0; }
    return 1;
}

fn group16(code: u16) -> u64 {
    if (code < 59049) { return lane_of_digit(code % 3) | (lane_of_digit((code / 3) % 3) << 2) | (lane_of_digit((code / 9) % 3) << 4) | (lane_of_digit((code / 27) % 3) << 6) | (lane_of_digit((code / 81) % 3) << 8) | (lane_of_digit((code / 243) % 3) << 10) | (lane_of_digit((code / 729) % 3) << 12) | (lane_of_digit((code / 2187) % 3) << 14) | (lane_of_digit((code / 6561) % 3) << 16) | (lane_of_digit((code / 19683) % 3) << 18); }
    return 0;
}

fn bad16(code: u16) -> u64 {
    if (code < 59049) { return 0; }
    return 1;
}

fn decode(word: u64) -> u64 {
    var lanes: u64 = (group16(((word >> 0) & 65535) as u16) << 0)
        | (group12(((word >> 16) & 4095) as u16) << 20)
        | (group8(((word >> 28) & 255) as u16) << 34);
    var bad: u64 = bad16(((word >> 0) & 65535) as u16) + bad12(((word >> 16) & 4095) as u16) + bad8(((word >> 28) & 255) as u16);
    return lanes | (bad << 48);
}

fn on_comb(x: u64) -> u64 {
    return decode(x);
}

endmodule
