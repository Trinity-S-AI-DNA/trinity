// TMEM v1 framing. Include generated codecs C header before this header.
// Caller-owned buffers; no allocation. Valid input/output ranges must not overlap.
module TrinityMemoryContainer {
    fn tm_crc32_update(data: []u8, count: usize, state: u32) -> u32 {
        var crc: u32 = state;
        var i: usize = 0;
        while (i < count) {
            crc = crc ^ (data[i] as u32);
            var bit: u32 = 0;
            while (bit < 8) {
                if ((crc & 1) != 0) { crc = (crc >> 1) ^ 0xedb88320; }
                else { crc = crc >> 1; }
                bit = bit + 1;
            }
            i = i + 1;
        }
        return crc;
    }

    fn tm_crc32(data: []u8, count: usize) -> u32 {
        return tm_crc32_update(data, count, 0xffffffff) ^ 0xffffffff;
    }

    fn tm_read_u32(data: []u8, offset: usize) -> u32 {
        var value: u32 = 0;
        var i: usize = 0;
        while (i < 4) { value = value | ((data[offset + i] as u32) << (8 * i)); i = i + 1; }
        return value;
    }

    fn tm_read_u64(data: []u8, offset: usize) -> u64 {
        var value: u64 = 0;
        var i: usize = 0;
        while (i < 8) { value = value | ((data[offset + i] as u64) << (8 * i)); i = i + 1; }
        return value;
    }

    fn tm_write_u32(data: []u8, offset: usize, value: u32) -> void {
        var i: usize = 0;
        while (i < 4) { data[offset + i] = ((value >> (8 * i)) & 255) as u8; i = i + 1; }
    }

    fn tm_write_u64(data: []u8, offset: usize, value: u64) -> void {
        var i: usize = 0;
        while (i < 8) { data[offset + i] = ((value >> (8 * i)) & 255) as u8; i = i + 1; }
    }

    fn tm_pack(codec: i32, values: []i32, count: usize, out: []u8, capacity: usize) -> i64 {
        var payload: i64 = tm_payload_size(codec, count as u64);
        if (payload < 0) { return payload; }
        if ((payload as u64) > 0xffffffff) { return TM_ERR_LIMIT as i64; }
        if (capacity < 24 || (payload as u64) > ((capacity - 24) as u64)) {
            return TM_ERR_CAPACITY as i64;
        }
        var encoded: i64 = tm_encode(codec, values, count, &out[24], capacity - 24);
        if (encoded < 0) { return encoded; }
        out[0] = 84; out[1] = 77; out[2] = 69; out[3] = 77;
        out[4] = 1; out[5] = codec as u8; out[6] = 0; out[7] = 0;
        tm_write_u64(out, 8, count as u64);
        tm_write_u32(out, 16, payload as u32);
        var crc: u32 = tm_crc32_update(out, 20, 0xffffffff);
        crc = tm_crc32_update(&out[24], payload as usize, crc) ^ 0xffffffff;
        tm_write_u32(out, 20, crc);
        return payload + 24;
    }

    fn tm_unpack(data: []u8, size: usize, out: []i32, capacity: usize) -> i64 {
        if (size < 24) { return TM_ERR_LENGTH as i64; }
        if (data[0] != 84 || data[1] != 77 || data[2] != 69 || data[3] != 77) {
            return TM_ERR_HEADER as i64;
        }
        if (data[4] != 1 || data[6] != 0 || data[7] != 0) { return TM_ERR_HEADER as i64; }
        var codec: i32 = data[5] as i32;
        var count: u64 = tm_read_u64(data, 8);
        var payload: u32 = tm_read_u32(data, 16);
        var expected: i64 = tm_payload_size(codec, count);
        if (expected < 0) { return expected; }
        if ((expected as u64) != (payload as u64) || (size - 24) as u64 != (payload as u64)) {
            return TM_ERR_LENGTH as i64;
        }
        if (count > (capacity as u64)) { return TM_ERR_CAPACITY as i64; }
        var crc: u32 = tm_crc32_update(data, 20, 0xffffffff);
        crc = tm_crc32_update(&data[24], payload as usize, crc) ^ 0xffffffff;
        if (crc != tm_read_u32(data, 20)) { return TM_ERR_CHECKSUM as i64; }
        var result: i32 = tm_decode(codec, &data[24], payload as usize, count as usize, out, capacity);
        if (result != 0) { return result as i64; }
        return count as i64;
    }
}
