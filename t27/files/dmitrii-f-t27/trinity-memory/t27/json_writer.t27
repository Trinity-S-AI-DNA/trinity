// Shared bounded JSON writer. Include generated json.h before this header.
// No heap, no implicit NUL terminator. Check error==0 before using output.
// Errors are sticky; a failed compound write may leave an incomplete prefix.
module TrinityMemoryJsonWriter {
    struct TMJsonWriter { data: []u8, capacity: usize, used: usize, error: i32, }
    fn tm_json_writer_init(data: []u8, capacity: usize, writer: *TMJsonWriter) -> void {
        writer.data = data; writer.capacity = capacity; writer.used = 0; writer.error = 0;
    }
    fn tm_json_write_byte(w: *TMJsonWriter, value: u8) -> i32 {
        if (w.error != 0) { return w.error; }
        if (w.used >= w.capacity) { w.error = TM_JSON_ERR_CAPACITY; return w.error; }
        w.data[w.used] = value; w.used = w.used + 1; return 0;
    }
    fn tm_json_write_bytes(w: *TMJsonWriter, data: []u8, size: usize) -> i32 {
        if (w.error != 0) { return w.error; }
        if (w.used > w.capacity || size > w.capacity - w.used) { w.error = TM_JSON_ERR_CAPACITY; return w.error; }
        var i: usize = 0;
        while (i < size) { w.data[w.used + i] = data[i]; i = i + 1; }
        w.used = w.used + size; return 0;
    }
    fn tm_json_write_u64(w: *TMJsonWriter, value: u64) -> i32 {
        if (w.error != 0) { return w.error; }
        var divisor: u64 = 1;
        while (value / divisor >= 10) { divisor = divisor * 10; }
        var remainder: u64 = value;
        while (divisor > 0) {
            var status: i32 = tm_json_write_byte(w, (48 + remainder / divisor) as u8);
            if (status != 0) { return status; }
            remainder = remainder % divisor; divisor = divisor / 10;
        }
        return 0;
    }
    fn tm_json_write_i64(w: *TMJsonWriter, value: i64) -> i32 {
        if (w.error != 0) { return w.error; }
        var magnitude: u64 = value as u64;
        if (value < 0) {
            var status: i32 = tm_json_write_byte(w, 45);
            if (status != 0) { return status; }
            magnitude = (-(value + 1)) as u64 + 1;
        }
        return tm_json_write_u64(w, magnitude);
    }
    fn tm_json_write_bool(w: *TMJsonWriter, value: bool) -> i32 {
        if (value) {
            tm_json_write_byte(w, 116); tm_json_write_byte(w, 114);
            tm_json_write_byte(w, 117); tm_json_write_byte(w, 101);
        } else {
            tm_json_write_byte(w, 102); tm_json_write_byte(w, 97);
            tm_json_write_byte(w, 108); tm_json_write_byte(w, 115); tm_json_write_byte(w, 101);
        }
        return w.error;
    }
    fn tm_json_write_null(w: *TMJsonWriter) -> i32 {
        tm_json_write_byte(w, 110); tm_json_write_byte(w, 117);
        tm_json_write_byte(w, 108); tm_json_write_byte(w, 108); return w.error;
    }
    fn tm_json_write_quoted(w: *TMJsonWriter, data: []u8, size: usize) -> i32 {
        if (w.error != 0) { return w.error; }
        // Validate UTF-8 and account exact escaped size before any write.
        if (w.used > w.capacity || w.capacity - w.used < 2) { w.error = TM_JSON_ERR_CAPACITY; return w.error; }
        var available: usize = w.capacity - w.used;
        var needed: usize = 2; var i: usize = 0;
        while (i < size) {
            var c: u8 = data[i]; var width: usize = tm_json_utf8_width(data, size, i);
            if (width == 0) { w.error = TM_JSON_ERR_UTF8; return w.error; }
            var extra: usize = width;
            if (c == 34 || c == 92) { extra = 2; }
            if (c < 32) {
                extra = 6;
                if (c == 8 || c == 9 || c == 10 || c == 12 || c == 13) { extra = 2; }
            }
            if (extra > available - needed) { w.error = TM_JSON_ERR_CAPACITY; return w.error; }
            needed = needed + extra; i = i + width;
        }
        tm_json_write_byte(w, 34); i = 0;
        while (i < size) {
            var c: u8 = data[i];
            if (c == 34 || c == 92) { tm_json_write_byte(w, 92); tm_json_write_byte(w, c); }
            else {
                if (c < 32) {
                    tm_json_write_byte(w, 92);
                    var escape_code: u8 = 0;
                    if (c == 8) { escape_code = 98; }
                    if (c == 9) { escape_code = 116; }
                    if (c == 10) { escape_code = 110; }
                    if (c == 12) { escape_code = 102; }
                    if (c == 13) { escape_code = 114; }
                    if (escape_code != 0) { tm_json_write_byte(w, escape_code); }
                    else {
                        tm_json_write_byte(w, 117); tm_json_write_byte(w, 48); tm_json_write_byte(w, 48);
                        var hi: u8 = c / 16; var lo: u8 = c % 16;
                        tm_json_write_byte(w, 48 + hi);
                        if (lo < 10) { tm_json_write_byte(w, 48 + lo); }
                        else { tm_json_write_byte(w, 87 + lo); }
                    }
                } else { tm_json_write_byte(w, c); }
            }
            i = i + 1;
        }
        tm_json_write_byte(w, 34); return w.error;
    }

    // Formatting primitive returns shortest finite scientific decimal, so even
    // integral REAL values remain JSON real tokens (for example, 1e+00).
    fn tm_json_write_f64(w: *TMJsonWriter, value: f64) -> i32 {
        if (w.error != 0) { return w.error; }
        if (!(value <= 1.7976931348623157e308 && value >= -1.7976931348623157e308)) {
            w.error = TM_JSON_ERR_NUMBER; return w.error;
        }
        var scratch: [64]u8 = [0];
        var size: usize = tm_float_shortest(value, scratch, 64);
        if (size == 0 || size > 64) { w.error = TM_JSON_ERR_NUMBER; return w.error; }
        return tm_json_write_bytes(w, scratch, size);
    }
    // Parsed trees are trusted for string buffer validity; indexes and graph
    // traversal remain bounded even if callers corrupt token relationships.
    fn tm_json_write_tree_inner(w: *TMJsonWriter, tokens: []TMJsonToken, count: usize,
                               index: i64, depth: usize, remaining: *usize) -> i32 {
        if (w.error != 0) { return w.error; }
        if (index < 0 || (index as u64) >= (count as u64) || remaining[0] == 0) {
            w.error = TM_JSON_ERR_SYNTAX; return w.error;
        }
        if (depth > 64) { w.error = TM_JSON_ERR_DEPTH; return w.error; }
        remaining[0] = remaining[0] - 1;
        var token: *TMJsonToken = &tokens[index as usize];
        if (token[0].kind == TM_JSON_NULL) { return tm_json_write_null(w); }
        if (token[0].kind == TM_JSON_FALSE) { return tm_json_write_bool(w, false); }
        if (token[0].kind == TM_JSON_TRUE) { return tm_json_write_bool(w, true); }
        if (token[0].kind == TM_JSON_STRING) { return tm_json_write_quoted(w, token[0].text, token[0].text_size); }
        if (token[0].kind == TM_JSON_REAL) { return tm_json_write_f64(w, token[0].real); }
        if (token[0].kind == TM_JSON_INTEGER) {
            if (token[0].negative) {
                if (token[0].uinteger > 0x8000000000000000) { w.error = TM_JSON_ERR_NUMBER; return w.error; }
                tm_json_write_byte(w, 45);
            }
            return tm_json_write_u64(w, token[0].uinteger);
        }
        if (token[0].kind != TM_JSON_ARRAY && token[0].kind != TM_JSON_OBJECT) {
            w.error = TM_JSON_ERR_SYNTAX; return w.error;
        }
        if (depth >= 64) { w.error = TM_JSON_ERR_DEPTH; return w.error; }
        var object: bool = token[0].kind == TM_JSON_OBJECT;
        if (object) { tm_json_write_byte(w, 123); } else { tm_json_write_byte(w, 91); }
        var child: i64 = token[0].first; var seen: usize = 0;
        while (child != -1 && w.error == 0) {
            if (child < 0 || (child as u64) >= (count as u64) || seen >= count) {
                w.error = TM_JSON_ERR_SYNTAX; return w.error;
            }
            if (seen > 0) { tm_json_write_byte(w, 44); }
            var entry: *TMJsonToken = &tokens[child as usize];
            if (object) {
                if (entry[0].kind != TM_JSON_STRING || remaining[0] == 0) { w.error = TM_JSON_ERR_SYNTAX; return w.error; }
                remaining[0] = remaining[0] - 1;
                tm_json_write_quoted(w, entry[0].text, entry[0].text_size);
                tm_json_write_byte(w, 58);
                tm_json_write_tree_inner(w, tokens, count, entry[0].first, depth + 1, remaining);
            } else { tm_json_write_tree_inner(w, tokens, count, child, depth + 1, remaining); }
            child = entry[0].next; seen = seen + 1;
        }
        if (object) { tm_json_write_byte(w, 125); } else { tm_json_write_byte(w, 93); }
        return w.error;
    }
    fn tm_json_write_tree(w: *TMJsonWriter, tokens: []TMJsonToken,
                          token_count: usize, index: i64) -> i32 {
        var remaining: usize = token_count;
        return tm_json_write_tree_inner(w, tokens, token_count, index, 0, &remaining);
    }
}
