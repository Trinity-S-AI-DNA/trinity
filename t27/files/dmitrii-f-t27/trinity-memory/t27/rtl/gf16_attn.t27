var rne_num: u64 = 0; var rne_bits: u32 = 0; var rne_return: u32 = 0;
var rne_q: u64 = 0; var rne_rem: u64 = 0; var rne_half: u64 = 0;
var div_round_up: bool = false;
var sqrt_shift: u32 = 0;
var sqrt_upper: bool = false;
var rne_up: bool = false; var rne_result: u64 = 0;

// One registered read port per RAM. The 1000+consumer state presents
// stable addresses for a full cycle; the following consumer sees the latched
// word. Index/head/position updates complete before the prefetch state.
// Combinational addresses have no reset register (one driver each).
var va: u32; var ga: u32; var ua: u32;
var vr2: u32 = 0; var gr2: u32 = 0; var ur2: u32 = 0;
va = pick(state == 1021 || state == 1040 || state == 1180, index,
    pick(state == 1150 || state == 1152 || state == 1154 || state == 1157, hidden+kvcount+jj,
    pick(state == 1161, hidden+jj*kv+(head / group) * head_dim+dd, 0)));
