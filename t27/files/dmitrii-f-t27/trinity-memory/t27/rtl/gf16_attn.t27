    pick(state == 1074, col,
    pick(state == 1095, hidden+head*head_dim+pair,
    pick(state == 1096, hidden+head*head_dim+pair+pairs,
    pick(state == 1110 || state == 1180, hidden+index,
    pick(state == 1141, hidden+head*head_dim+col, 0))))));
ua = pick(state == 1021 || state == 1040, kvcount+index,
    pick(state == 1120, pos*kv+head*head_dim+pair,
    pick(state == 1121, pos*kv+head*head_dim+pair+pairs,
    pick(state == 1135, pos*kv+index,
    pick(state == 1141, jj*kv+(head / group) * head_dim+col, 0)))));
group = heads / kv_heads;
s_idle = !sbuf;

fn on_clock(calib: bool, stall: bool, ack: bool, rdata_lo: u64, rdata_hi: u64,
            hidden: u32, kv: u32, heads: u32, kv_heads: u32, head_dim: u32,
            line_idle: bool, s_go: bool, s_tag: u32, s_a: u32, s_b: u64) {
