var mul_left: u64 = 0; var mul_right: u64 = 0; var mul_product: u64 = 0;
var mul_bit: u32 = 0; var mul_return: u32 = 0;
var scale_low_product: u64 = 0; var scale_high_carry: u64 = 0;
var exp_z: u64 = 0; var exp_m: u32 = 0; var exp_j: u32 = 0;
var exp_g: u64 = 0; var exp_h: u64 = 0;
var exp_a2: u64 = 0; var exp_a1: u64 = 0; var exp_a0: u64 = 0;
var exp_b1: u64 = 0; var exp_b0: u64 = 0; var exp_p: u64 = 0; var exp_y: u64 = 0;

