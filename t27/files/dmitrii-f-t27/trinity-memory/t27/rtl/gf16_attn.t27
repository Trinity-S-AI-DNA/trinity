    if (state == 1120) {
        state = 120;
    }
    if (state == 1121) {
        state = 121;
    }
    if (state == 1135) {
        state = 135;
    }
    if (state == 1141) {
        state = 141;
    }
    if (state == 1150) {
        state = 150;
    }
    if (state == 1152) {
        state = 152;
    }
    if (state == 1154) {
        state = 154;
    }
    if (state == 1157) {
        state = 157;
    }
    if (state == 1161) {
        state = 161;
    }
    if (state == 1180) {
        state = 180;
    }
    if (state == 2023) {
        add0 = sumsq0+mul_product; add_carry = carry(sumsq0,mul_product); state = 24;
    }
    if (state == 2041) {
        num_mag = mul_product << 16; rem0 = 0; quo0 = 0; bitpos = 63; state = 42;
    }
    if (state == 2077) {
        rne_num = mul_product; rne_bits = 16; rne_return = 6077; state = 500;
    }
    if (state == 2097) {
        term0 = mul_product;
        state = 98;
    }
    if (state == 2098) {
        term1 = mul_product;
        state = 99;
    }
    if (state == 2103) {
        term3 = mul_product;
        state = 104;
    }
    if (state == 2112) {
        term2 = mul_product;
        state = 103;
    }
    if (state == 2122) {
        term0 = mul_product;
        state = 123;
    }
    if (state == 2123) {
        term1 = mul_product;
        state = 124;
    }
    if (state == 2128) {
        term3 = mul_product;
        state = 129;
    }
    if (state == 2137) {
        term2 = mul_product;
        state = 128;
    }
    if (state == 2141) {
        lane = mul_product;
        state = 142;
    }
    if (state == 2145) {
        scale_low_product = mul_product; mul_a = scale_attn as u64; mul_b = out_mag >> 32; mul_return = 2146; state = 400;
    }
    if (state == 2146) {
        rem0 = scale_low_product & 4294967295;
        add0 = (mul_product+(scale_low_product >> 32)) & 4294967295;
        scale_high_carry = (mul_product+(scale_low_product >> 32)) >> 32;
        mul_a = scale_attn as u64; mul_b = rem1; mul_return = 2147; state = 400;
    }
    if (state == 2147) {
        add1 = mul_product+scale_high_carry; state = 146;
    }
    if (state == 2157) {
        lane = mul_product;
        state = 162;
    }
    if (state == 3142) {
        add1 = acc1+pick((lane >> 63) != 0,18446744073709551615,0)+add_carry; state = 143;
    }
    if (state == 4101) {
        quant = rne_result; state = 102;
    }
    if (state == 4107) {
        quant = rne_result; state = 113;
    }
    if (state == 4126) {
        quant = rne_result; state = 127;
    }
    if (state == 4132) {
        quant = rne_result; state = 138;
    }
    if (state == 4718) {
        exp_value = rne_result as u32; state = 155;
    }
    if (state == 6077) {
        quant = rne_result; state = 78;
    }
    if (state == 7028) {
        add0 = quo0+pick(div_round_up,1,0);
        add_carry = carry(quo0,pick(div_round_up,1,0));
        state = 30;
    }
    if (state == 7031) {
        rem1 = ((quo1+add_carry) << 32) | (add0 >> 32); rem0 = add0 << 32;
        root = 0; bitpos = 94; state = 32;
    }
    if (state == 7044) {
        out_mag = quo0+pick(div_round_up,1,0);
        state = 45;
    }
    if (state == 7146) {
        quant = ((add1 << 32) | add0)+pick(div_round_up,1,0);
        state = 147;
    }
    if (state == 7166) {
        out_mag = quo0+pick(div_round_up,1,0);
        state = 167;
    }
    if (state == 8032) {
        // Restoring isqrt subtrahend (4*root+1) << bitpos, two limbs.
        if (sqrt_upper) { cmp1 = ((root << 2) | 1) << sqrt_shift; cmp0 = 0; }
        else { cmp1 = ((root << 2) | 1) >> sqrt_shift; cmp0 = ((root << 2) | 1) << bitpos; }
        state = 33;
    }
    if (active && !calib) { error_code = 2; state = 900; }
    if (ack && state != 200 && state != 201) { error_code = 5; state = 900; }
    line_go = false;
    if (s_go) { sbuf = true; sb_tag = s_tag; sb_a = s_a; sb_b = s_b; }
    if (arb == 0) {
        if (line_idle && sbuf) { line_go = true; line_tag = sb_tag; line_a = sb_a; line_b = sb_b; sbuf = false; arb = 1; }
        else if (line_idle && pending) { line_go = true; line_tag = ptag; line_a = pa; line_b = pb; pending = false; arb = 1; }
    } else if (arb == 1) { arb = 2; }
    else if (line_idle) { arb = 0; }
}

test exp_zero { assert_eq(exp_q16(0),65536); }
test exp_unit { assert_eq(exp_q16(4294967295),65535); }
test exp_deep { assert_eq(exp_q16(4293918720),0); }
test exp_one { assert_eq(exp_q16(4294901760),24109); }
