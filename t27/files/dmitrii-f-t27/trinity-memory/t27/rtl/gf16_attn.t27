module TrinityGf16AttnT27;
// Issue #115. gf16-attn-v1: generated layer-0 attention/residual controller.
//
// Board profile: every stage value is an exact Q16.16 s32 word, NOT a GF16
// float. The attention oracle (tools/attn_reference.py) contracts Q16.16
// stages; in Q16.16 every datapath product fits one or two u64 limbs and the
// merged oracle is the direct bit-exact validation target.
//
// Causal S-position chain (doorbell positions, 1..8): per position t
//   input_layernorm -> q/k/v ternary projections (20 heads x 128, GQA 4:1
//   over 5 kv heads) -> RoPE (theta 500000, rotate_half from a Q16.16
//   cos/sin table; identity at position 0) -> scaled QK^T scores over the
//   cached keys j <= t -> softmax (the shared integer exp_q16 over the
//   exact delta from the row maximum, exact integer denominator) ->
//   context -> attn_sub_norm -> o_proj -> residual add. Keys and values
//   live in in-chip RAM caches; stage values stream out over the report
//   line (result-only mode keeps just the residual words).
//
// Every state body obeys the single-pass rule: a value assigned in the
// body is never read again inside the same body (t27 assigns are
// non-blocking).
//
// Memory map (128-bit words, 16 bytes each):
//   64       doorbell: run_id | 0x41545431<<32; read1 = positions | (result<<32)
//   80..84   scales q,k,v,o (Q16.16) and attention scaling head_dim**-0.5
//   4096+    input_layernorm weights, H words
//   8192+    attn_sub_norm weights, H words
//   32768+   x, S * H Q16.16 words (position-major)
//   65536+   q_proj trits, H rows x ceil(H/64) words (64 lanes of 2 bits)
//   167936+  k_proj trits, KV x ceil(H/64)
//   193536+  v_proj trits, KV x ceil(H/64)
//   219136+  o_proj trits, H x ceil(H/64)
//   321536+  RoPE cos/sin: position t, pair i -> 321536 + t*HD + 2*i (+1)
// RAM caches (8192 u32 each): gate[0..H-1]=n/c, gate[H..2H-1]=q/o,
// gate[2H..3H-1]=w_in; up[0..S*KV-1]=rotated k cache,
// up[S*KV..S*KV+H-1]=context; vec[0..H-1]=x, vec[H..H+S*KV-1]=v cache,
// vec[H+S*KV..+7]=score/exp scratch.
// Report tags: 71 header, 100 run, 99 cycles, 118 counters, 122 done,
// 69 error; stages n=103,q=104,k=105,v=106,qr=107,kr=108,sc=109,a=110,
// c=111,o=112,r=113.
fn pick(flag: bool, a: u64, b: u64) -> u64 { if (flag) { return a; } return b; }
fn carry(a: u64, b: u64) -> u64 {
    // Carry-out from the sign bit of the wrapped sum. Reuse the adder;
    // comparing the full sum with a would add another 64-bit carry chain.
    return ((a & b) | ((a | b) & ((a+b) ^ 18446744073709551615))) >> 63;
}
fn rne_shift(num: u64, shift: u32) -> u64 {
    let q: u64 = num >> shift;
    let rem: u64 = num & (((1 as u64) << shift)-1);
    let half: u64 = (1 as u64) << (shift-1);
    if (rem > half) { return q+1; }
    if (rem == half) { if ((q & 1) != 0) { return q+1; } }
    return q;
}
fn exp_q16(delta: u32) -> u32 {
    let z: u64 = ((0 as u64)-(delta as u64)) & 4294967295;
    if (z >= 772244) { return 0; }
    let u: u64 = z*6196328019;
    let m: u32 = (u >> 48) as u32;
    let f: u64 = u & 281474976710655;
    let j: u32 = (f >> 44) as u32;
    let g: u64 = (f & 17592186044415) >> 16;
    let h: u64 = (g*g) >> 32;
    var t: [16]u64 = [4294967296,4112874773,3938502376,3771522796,3611622603,3458501653,3311872529,3171459999,3037000500,2908241642,2784941738,2666869345,2553802834,2445529972,2341847524,2242560872];
    var a2: u64 = ((661577*h) >> 32)+41309550;
    var a1: u64 = ((a2*h) >> 32)+1031764991;
    var a0: u64 = ((a1*h) >> 32)+4294967296;
    var b1: u64 = ((5726720*h) >> 32)+238388332;
    var b0: u64 = ((b1*h) >> 32)+2977044472;
    var p: u64 = a0-((g*b0) >> 32);
    let y: u64 = pick(j == 0,p,(t[j]*p) >> 32);
    return rne_shift(y, 16+m) as u32;
}
fn sign64(word: u32) -> bool { return (word >> 31) != 0; }
fn sgt(a: u64, b: u64) -> bool {
    // signed greater-than over u64 two's complements. Sign extension adds
    // the same 2**64 to every negative, so within equal signs the plain
    // unsigned order IS the signed order; only mixed signs need the flip.
    if (((a >> 63) != 0) != ((b >> 63) != 0)) { return (a >> 63) == 0; }
    return a > b;
}
fn extend(word: u32) -> u64 {
    // Q16.16 u32 pattern, sign-extended into u64 two's complement.
    if ((word >> 31) != 0) { return ((word as u64) | 18446744069414584320); }
    return word as u64;
}
fn mag64(word: u32) -> u64 {
    // u64 subtraction masked to 32 bits: 2**32 - pattern = |value|.
    // (A bare u32 negation widens to the return width in the Verilog backend
    // and disagrees with the C backend, so the wrap is explicit here.)
    if ((word >> 31) != 0) { return ((0 as u64)-(word as u64)) & 4294967295; }
    return word as u64;
}

fn exp_lut(j: u32) -> u64 {
    var t: [16]u64 = [4294967296,4112874773,3938502376,3771522796,3611622603,3458501653,3311872529,3171459999,3037000500,2908241642,2784941738,2666869345,2553802834,2445529972,2341847524,2242560872];
    return t[j];
}

var state: u32 = 0;
