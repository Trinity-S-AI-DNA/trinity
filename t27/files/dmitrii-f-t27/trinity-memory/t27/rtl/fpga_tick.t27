module TrinityFpgaTickT27;

// Tick generator for the AX7203 trace player. A free-running three-bit counter
// on the 200 MHz board clock: div_bit toggles every four clocks (a divide-by-eight
// clock when the adapter feeds it to a BUFG) and tick is high for one clock in
// eight (the enable of every register in the tick-enable variant). Outputs are
// computed from the previous count, so the C and Verilog backends agree.
var count: u32 = 0;
var tick: bool = false;
var div_bit: bool;
div_bit = (count & 4) == 4;

fn on_clock(hold: bool) {
    tick = !hold && count == 6;
    if (hold) { count = 0; } else { count = (count + 1) & 7; }
}

test wraps_at_eight { assert_eq((7 + 1) & 7, 0); }
test div_bit_is_the_third_bit { assert_eq((4 & 4) == 4, true); }
endmodule
