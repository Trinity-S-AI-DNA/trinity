module TrinityStreamJoinT27;

// Joins one stored word from the ready-capable sequencer and one activation
// beat into one beat of the framed dot pipeline. Purely combinational: a beat
// fires when the word, the activations and the pipeline are all present, and
// each source sees "ready" only when the other two are, so no word and no
// activation beat is ever dropped and no buffer is needed (issue #15).
// Packed result: [0] fire, [1] word_ready (to the sequencer), [2] act_ready
// (to the activation source), [3] in_valid (to the pipeline), [4] in_last,
// [12:5] in_mask: 31, or the tail mask on the last word.
fn join_mask(last: bool, tail_mask: u8) -> u16 {
    if (last) { return tail_mask as u16; }
    return 31;
}

fn on_comb(word_valid: bool, word_last: bool, act_valid: bool, dot_ready: bool,
           tail_mask: u8) -> u16 {
    var fire: u16 = 0;
    var word_ready: u16 = 0;
    var act_ready: u16 = 0;
    var in_valid: u16 = 0;
    var in_last: u16 = 0;
    if (word_valid && act_valid && dot_ready) { fire = 1; }
    if (act_valid && dot_ready) { word_ready = 2; }
    if (word_valid && dot_ready) { act_ready = 4; }
    if (word_valid && act_valid) { in_valid = 8; }
    if (word_last) { in_last = 16; }
    return fire | word_ready | act_ready | in_valid | in_last
        | (join_mask(word_last, tail_mask) << 5);
}

test idle { assert_eq(on_comb(false, false, false, true, 3), 992); }
test fires_when_all_present { assert_eq(on_comb(true, false, true, true, 3), 1007); }
test waits_for_activations { assert_eq(on_comb(true, false, false, true, 3), 996); }
test waits_for_word { assert_eq(on_comb(false, false, true, true, 3), 994); }
test pipeline_stall_holds_both { assert_eq(on_comb(true, true, true, false, 3), 120); }
test tail_mask_on_last { assert_eq(on_comb(true, true, true, true, 7), 255); }
endmodule
