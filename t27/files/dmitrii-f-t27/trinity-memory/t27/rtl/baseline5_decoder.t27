module TrinityBaseline5DecoderT27;

// Native five-lane 2-bit decoding. Bit 10 is validity; low ten bits are lanes.
fn on_comb(code: u16) -> u16 {
    if (code < 1024 && (code & 3) < 3 && ((code >> 2) & 3) < 3
        && ((code >> 4) & 3) < 3 && ((code >> 6) & 3) < 3
        && ((code >> 8) & 3) < 3) {
        return 1024 | code;
    }
    return 0;
}

test logical_zero { assert_eq(on_comb(0), 1024); }
test negative_five { assert_eq(on_comb(682), 1706); }
test positive_five { assert_eq(on_comb(341), 1365); }
test reserved_lane { assert_eq(on_comb(3), 0); }
test reserved_tail { assert_eq(on_comb(768), 0); }
test outside_word { assert_eq(on_comb(1024), 0); }
endmodule
