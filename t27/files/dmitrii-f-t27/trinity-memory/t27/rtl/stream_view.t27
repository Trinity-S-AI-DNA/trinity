module TrinityStreamViewT27;

// Decode a stored group, expose its logical lane mask, and zero inactive or
// invalid lanes. Packed result: [9:0] lanes, [14:10] mask, [15] code valid.
fn dense_digit(code: u16, divisor: u16) -> u16 {
    var digit: u16 = (code / divisor) % 3;
    if (digit == 0) { return 2; }
    if (digit == 1) { return 0; }
    return 1;
}

fn decode(code: u16, dense_mode: bool) -> u16 {
    if (dense_mode) {
        if (code < 243) {
            return 1024 | dense_digit(code, 1) | (dense_digit(code, 3) << 2)
                | (dense_digit(code, 9) << 4) | (dense_digit(code, 27) << 6)
                | (dense_digit(code, 81) << 8);
        }
        return 0;
    }
    if (code < 1024 && (code & 3) < 3 && ((code >> 2) & 3) < 3
        && ((code >> 4) & 3) < 3 && ((code >> 6) & 3) < 3
        && ((code >> 8) & 3) < 3) { return 1024 | code; }
    return 0;
}

fn visible_lane(lanes: u16, mask: u16, lane: u32) -> u16 {
    if (((mask >> lane) & 1) == 1) { return lanes & (3 << (lane << 1)); }
    return 0;
}

fn on_comb(code: u16, valid: bool, last: bool, tail_mask: u8,
           dense_mode: bool) -> u16 {
    if (valid) {
        var mask: u16 = 31;
        if (last) { mask = tail_mask as u16; }
        var decoded: u16 = decode(code, dense_mode);
        if ((decoded & 1024) == 1024) {
            return 32768 | (mask << 10) | visible_lane(decoded, mask, 0)
                | visible_lane(decoded, mask, 1) | visible_lane(decoded, mask, 2)
                | visible_lane(decoded, mask, 3) | visible_lane(decoded, mask, 4);
        }
        return mask << 10;
    }
    return 0;
}

test idle { assert_eq(on_comb(242, false, false, 31, true), 0); }
test dense_all_positive { assert_eq(on_comb(242, true, false, 31, true), 64853); }
test dense_tail { assert_eq(on_comb(242, true, true, 3, true), 35845); }
test baseline_tail { assert_eq(on_comb(341, true, true, 3, false), 35845); }
test invalid_dense { assert_eq(on_comb(255, true, true, 3, true), 3072); }
test invalid_baseline { assert_eq(on_comb(3, true, false, 31, false), 31744); }
endmodule
