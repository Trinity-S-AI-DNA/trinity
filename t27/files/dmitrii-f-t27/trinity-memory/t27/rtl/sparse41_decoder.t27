module TrinitySparse41DecoderT27;

// Native sparse(4,<=1) decoding. Bit 8 is validity; low eight bits are lanes.
fn on_comb(code: u8) -> u16 {
    if (code == 0) { return 256; }
    if (code >= 1 && code <= 8) {
        var position: u16 = ((code as u16) - 1) / 2;
        if ((code & 1) == 1) { return 256 | (2 << (position << 1)); }
        return 256 | (1 << (position << 1));
    }
    return 0;
}

test logical_zero { assert_eq(on_comb(0), 256); }
test first_negative { assert_eq(on_comb(1), 258); }
test first_positive { assert_eq(on_comb(2), 257); }
test last_negative { assert_eq(on_comb(7), 384); }
test last_positive { assert_eq(on_comb(8), 320); }
test reserved { assert_eq(on_comb(9), 0); }
endmodule
