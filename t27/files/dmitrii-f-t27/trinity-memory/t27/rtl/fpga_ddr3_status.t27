module TrinityFpgaDdr3StatusT27;

// Calibration status reporter of the AX7203 DDR3 build (fpga/ax7203/ddr3/,
// issue #60). It runs on UberDDR3's controller clock and watches the
// controller's calibration state (ddr3_top o_debug1[4:0]; 0 is IDLE, 23 is
// DONE_CALIBRATE) and o_calib_complete. After reset it sends one header line and
// one status line, then a status line whenever the line emitter is free and either the state or
// calib_complete changed since the last line or `period` clocks have passed.
// Changes during a line are coalesced: the next line carries the latest state.
// Every return to IDLE (a state of 0 after a state other than 0) is counted
// (`recals`, a name kept from before; the docs say "returns to IDLE"). UberDDR3
// returns to IDLE on a wrong read in its built-in self-test (BIST_MODE 1) and on
// a failed read-alignment step, both only before calibration completes; the S
// line keeps the highest state, not the state before a return, so a count does
// not say which cause it had.
// Every statement reads a variable before the same tick writes it, so the C
// and the Verilog backends agree.
// Report lines (tag, a, b), b is 40 bits:
//   H a=build id
//     b=(REPORT_FORMAT << 32) | (byte lanes << 24) | DDR3 clock period in ps
//   S a=(calib_complete << 24) | (state << 16) | (highest state << 8) | returns to IDLE
//     (the count saturates at 255)
//     b=controller clocks since reset (low 40 bits)
const S_HEADER: u32 = 0;
const S_LINE_START: u32 = 1;
const S_LINE_WAIT: u32 = 2;
const S_WATCH: u32 = 3;

const REPORT_FORMAT: u64 = 1;
const B40: u64 = 1099511627775;
const TAG_H: u32 = 72;
const TAG_S: u32 = 83;

var phase: u32 = 0;
var cycles: u64 = 0;
var since: u32 = 0;
var prev_state: u32 = 0;
var highest: u32 = 0;
var recals: u32 = 0;
var sent_state: u32 = 255;
var sent_calib: bool = false;
var line_go: bool = false;
var line_tag: u32 = 0;
var line_a: u32 = 0;
var line_b: u64 = 0;
var recalibrated: bool;
recalibrated = recals != 0;

// The H line's b field. A typed local, not the constant: gen-c emits constants as
// untyped macros, and REPORT_FORMAT << 32 would be a 32-bit int shift in C.
fn header_b(lanes: u32, period_ps: u32) -> u64 {
    var fmt: u64 = REPORT_FORMAT;
    return (fmt << 32) | (((lanes & 255) as u64) << 24) | ((period_ps & 16777215) as u64);
}

fn status_a(calib: bool, state: u32, top: u32, n: u32) -> u32 {
    var c: u32 = 0;
    if (calib) { c = 1; }
    return (c << 24) | ((state & 31) << 16) | ((top & 31) << 8) | (n & 255);
}

fn bump(n: u32) -> u32 {
    if (n >= 255) { return 255; }
    return n + 1;
}

// The highest state and the count of returns to IDLE including this tick's state, so
// that a line sent on a change already counts it.
fn top_of(top: u32, s: u32) -> u32 {
    if (s > top) { return s; }
    return top;
}

fn recals_next(n: u32, prev: u32, s: u32) -> u32 {
    if (s == 0 && prev != 0) { return bump(n); }
    return n;
}

fn on_clock(state: u32, calib: bool, line_idle: bool, build_id: u32, lanes: u32,
            period_ps: u32, period: u32) {
    line_go = false;
    if (phase == S_HEADER) {
        line_tag = TAG_H;
        line_a = build_id;
        line_b = header_b(lanes, period_ps);
        line_go = true;
        since = 0;
        phase = S_LINE_START;
    } else if (phase == S_LINE_START) {
        since = 0;
        phase = S_LINE_WAIT;
    } else if (phase == S_LINE_WAIT) {
        since = 0;
        if (line_idle) { phase = S_WATCH; }
    } else {
        if ((state & 31) != sent_state || calib != sent_calib || since >= period) {
            line_tag = TAG_S;
            line_a = status_a(calib, state, top_of(highest, state & 31), recals_next(recals, prev_state, state & 31));
            line_b = cycles & B40;
            line_go = true;
            sent_state = state & 31;
            sent_calib = calib;
            since = 0;
            phase = S_LINE_START;
        } else {
            since = since + 1;
        }
    }
    recals = recals_next(recals, prev_state, state & 31);
    highest = top_of(highest, state & 31);
    prev_state = state & 31;
    cycles = cycles + 1;
}

test header_fields { assert_eq(header_b(2, 3000), 4328524728); assert_eq(header_b(4, 3125), 4362079285); }
test status_fields { assert_eq(status_a(true, 23, 23, 0), 18290432); assert_eq(status_a(false, 0, 22, 3), 5635); }
test recalibration_is_a_return_to_idle { assert_eq(recals_next(0, 5, 0), 1); assert_eq(recals_next(1, 0, 0), 1); assert_eq(recals_next(1, 5, 6), 1); }
test highest_state { assert_eq(top_of(22, 0), 22); assert_eq(top_of(22, 23), 23); }
test recalibrations_saturate { assert_eq(bump(0), 1); assert_eq(bump(254), 255); assert_eq(bump(255), 255); }
test tags_are_ascii { assert_eq(TAG_H, 72); assert_eq(TAG_S, 83); }
endmodule
