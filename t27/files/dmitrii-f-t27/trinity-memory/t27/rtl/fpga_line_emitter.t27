module TrinityFpgaLineEmitterT27;

// Report line serializer: one 20-byte line per request, tag, eight hex digits
// of a, ten hex digits of b, newline, handed byte by byte to the UART
// transmitter. idle is high when no line and no byte is in flight.
var line_busy: bool = false;
var pos: u32 = 0;
var tag_q: u32 = 0;
var a_q: u32 = 0;
var b_q: u64 = 0;
var tx_start: bool = false;
var tx_byte: u32 = 0;
var idle: bool;

fn hex(nibble: u32) -> u32 {
    if (nibble < 10) { return 48 + nibble; }
    return 87 + nibble;
}

fn line_char(p: u32, tag: u32, a: u32, b: u64) -> u32 {
    if (p == 0) { return tag; }
    if (p <= 8) { return hex((a >> ((8 - p) * 4)) & 15); }
    if (p <= 18) { return hex(((b >> ((18 - p) * 4)) & 15) as u32); }
    return 10;
}

fn on_clock(go: bool, tag: u32, a: u32, b: u64, tx_busy: bool) {
    tx_start = false;
    if (!line_busy) {
        if (go) {
            line_busy = true;
            pos = 0;
            tag_q = tag;
            a_q = a;
            b_q = b;
        }
    } else if (!tx_busy && !tx_start) {
        tx_byte = line_char(pos, tag_q, a_q, b_q);
        tx_start = true;
        if (pos == 19) { line_busy = false; } else { pos = pos + 1; }
    }
}
idle = !line_busy && !tx_start;

test hex_digits { assert_eq(hex(0), 48); assert_eq(hex(9), 57); assert_eq(hex(10), 97); assert_eq(hex(15), 102); }
test first_hex_of_a_is_its_top_nibble { assert_eq(line_char(1, 72, 2882400001, 0), 97); }
test last_hex_of_b_is_its_low_nibble { assert_eq(line_char(18, 72, 0, 11), 98); }
test newline_closes_the_line { assert_eq(line_char(19, 72, 0, 0), 10); }
endmodule
