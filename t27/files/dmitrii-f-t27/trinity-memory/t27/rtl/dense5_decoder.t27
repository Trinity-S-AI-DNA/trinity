module TrinityDense5DecoderT27;

// Native base-3 decoding. Bit 10 is validity; bits 9:0 are five lanes.
// Lane encoding: 00=0, 01=+1, 10=-1. No embedded backend-language text.
fn dense_digit(code: u8, divisor: u16) -> u16 {
    var digit: u16 = ((code as u16) / divisor) % 3;
    if (digit == 0) { return 2; }
    if (digit == 1) { return 0; }
    return 1;
}

fn on_comb(code: u8) -> u16 {
    // Positive guard also rejects unknown code bits in generated simulation.
    if (code < 243) {
        return 1024 | dense_digit(code, 1) | (dense_digit(code, 3) << 2)
            | (dense_digit(code, 9) << 4) | (dense_digit(code, 27) << 6)
            | (dense_digit(code, 81) << 8);
    }
    return 0;
}

test negative_five { assert_eq(on_comb(0), 1706); }
test logical_zero { assert_eq(on_comb(121), 1024); }
test positive_five { assert_eq(on_comb(242), 1365); }
test reserved_low { assert_eq(on_comb(243), 0); }
test reserved_high { assert_eq(on_comb(255), 0); }
endmodule
