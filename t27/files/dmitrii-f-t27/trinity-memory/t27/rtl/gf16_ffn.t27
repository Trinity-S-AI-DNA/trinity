    } else if (state == 601) {
        if (!pending) { ptag = 107; pa = 0; pb = report_cycles; pending = true; state = 602; }
    } else if (state == 602) {
        if (!pending) { ptag = 107; pa = 1; pb = memory_cycles; pending = true; state = 604; }
    } else if (state == 604) {
        if (!pending) { ptag = 107; pa = 2; pb = projection_cycles; pending = true; summary_index = 0; state = 605; }
    } else if (state == 605) {
