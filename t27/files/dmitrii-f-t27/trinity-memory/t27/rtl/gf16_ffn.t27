var phase: u32 = 0;
// Registered address selection: avoid a state-range decoder on the RAM path.
var projection_read: bool = false;
var phase0: u64 = 0;
var phase1: u64 = 0;
var phase2: u64 = 0;
var phase3: u64 = 0;
