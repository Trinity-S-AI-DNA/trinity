            if (read1 > 1) { error_code = 10; state = 900; }
            if (hidden == 0 || hidden > 2560 || inner == 0 || inner > 6912 || output_rows == 0 || output_rows > 2560) { error_code = 1; state = 900; }
        }
    } else if (state == 8) {
        if (!pending) { ptag = 100; pa = run_id; pb = pick(result_only,2,1); pending = true; state = 3; }
    } else if (state == 3) {
        wb_addr = 80+index; wb_stb = true; response = 4; state = 200; quiet = 0;
    } else if (state == 4) {
        if (index == 0) { scale_g = read0 as u32; }
        if (index == 1) { scale_u = read0 as u32; }
        if (index == 2) { scale_d = read0 as u32; index = 0; state = 10; }
        else { index = index+1; state = 3; }
        if (!valid_word(read0,read1)) { error_code = 6; state = 900; }
    } else if (state == 10) {
        projection_read = false; phase = 1; norm_kind = 0; norm_length = hidden; length = hidden; norm_start = true; index = 0; state = 11;
    } else if (state == 11) {
        wb_addr = 4096+index; wb_stb = true; response = 12; state = 200; quiet = 0;
    } else if (state == 12) {
        sample = read0 as u32; state = 13;
        if (!valid_word(read0,read1)) { error_code = 6; state = 900; }
    } else if (state == 13) {
        wb_addr = choose(norm_kind == 0,8192,12288)+index; wb_stb = true; response = 14; state = 200; quiet = 0;
    } else if (state == 14) {
        norm_weight = read0 as u32; state = 15;
        if (!valid_word(read0,read1)) { error_code = 6; state = 900; }
    } else if (state == 15) {
