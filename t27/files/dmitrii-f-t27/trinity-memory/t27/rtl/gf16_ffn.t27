            vec[index & 8191] = norm_value & 65535; emit_index = index; emit_value = norm_value; emit_product = norm_product;
            emit_tag = choose(norm_kind == 0,104,115); after_emit = 21; state = choose(result_only,21,choose(norm_kind == 0,300,22));
            if (!finite(norm_value)) { error_code = 7; state = 900; }
