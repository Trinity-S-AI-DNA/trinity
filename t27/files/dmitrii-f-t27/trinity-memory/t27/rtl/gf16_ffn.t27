        if (phase == 2) { phase2 = phase2+1; }
        if (phase == 3) { phase3 = phase3+1; }
        if (phase == 4) { phase4 = phase4+1; }
        if (phase == 5) { phase5 = phase5+1; }
        if (phase == 6) { phase6 = phase6+1; }
        if (phase == 7) { phase7 = phase7+1; }
        if (state == 73 || state == 83 || state == 74 || state == 75 || state == 76) { projection_cycles = projection_cycles+1; }
    }
    if (state == 0) {
        if (calib) { wb_cyc = true; ptag = 71; pa = hidden; pb = inner as u64; pending = true; state = 1; }
    } else if (state == 1) {
