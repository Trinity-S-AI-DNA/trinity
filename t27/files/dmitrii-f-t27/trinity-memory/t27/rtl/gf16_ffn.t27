module TrinityGf16FfnT27;
// Issues #111/#113. gf16-ffn-v1: generated full FFN controller.
// Clocked scalar arithmetic is shared with the wide norm via wiring adapters.
// Exact signed128 Q39 ternary sums; rational ActQuant; both norms use that kernel.
fn finite(v: u32) -> bool { return v <= 65535 && (v & 32256) != 32256; }
fn pick(flag: bool, a: u64, b: u64) -> u64 { if (flag) { return a; } return b; }
fn carry(a: u64, b: u64) -> u64 { if (a+b < a) { return 1; } return 0; }
fn msb(value: u64) -> u32 {
    var v: u64 = value; var k: u32 = 0;
    if (v >= ((1 as u64) << 32)) { v = v >> 32; k = k+32; }
    if (v >= 65536) { v = v >> 16; k = k+16; }
    if (v >= 256) { v = v >> 8; k = k+8; }
    if (v >= 16) { v = v >> 4; k = k+4; }
    if (v >= 4) { v = v >> 2; k = k+2; }
    if (v >= 2) { k = k+1; }
    return k;
}
fn mant(v: u32) -> u64 {
    if ((v & 32256) == 0) { return (v & 511) as u64; }
    return ((v & 511) | 512) as u64;
}
fn rne_inc(q: u64, r0: u64, r1: u64, d0: u64, d1: u64) -> u64 {
    let t0: u64 = r0 << 1;
    let t1: u64 = (r1 << 1) | (r0 >> 63);
    return pick(t1 > d1 || (t1 == d1 && (t0 > d0 || (t0 == d0 && (q & 1) != 0))),1,0);
}

fn choose(flag: bool, a: u32, b: u32) -> u32 { if (flag) { return a; } return b; }
fn fixed0(word: u32) -> u64 {
    let e: u32 = (word >> 9) & 63;
    if (e == 0) { return (word & 511) as u64; }
    return mant(word) << (e-1);
}
fn fixed1(word: u32) -> u64 {
    let e: u32 = (word >> 9) & 63;
    if (e <= 1) { return 0; }
    return mant(word) >> (65-e);
}
fn pack39(lo: u64, hi: u64, r0: u64, r1: u64, d0: u64, d1: u64, sign: u32) -> u32 {
    // floor(value * 2^39) in two limbs, with an exact division remainder.
    if (hi >= 128) { return sign | 32256; }
    if (hi == 0 && lo < 1024) { return sign | ((lo+rne_inc(lo,r0,r1,d0,d1)) as u32); }
    var k: u32 = msb(lo);
    if (hi != 0) { k = 64+msb(hi); }
    let shift: u32 = k-9;
    let m: u64 = (lo >> shift) | (hi << (64-shift));
    let rem: u64 = lo & (((1 as u64) << shift)-1);
    let half: u64 = (1 as u64) << (shift-1);
    let inc: u64 = pick(rem > half || (rem == half && (r0 != 0 || r1 != 0 || (m & 1) != 0)),1,0);
    return sign | ((shift << 9)+((m+inc) as u32));
}
fn valid_word(lo: u64, hi: u64) -> bool { return (lo >> 32) == 0 && hi == 0 && finite(lo as u32); }
fn output_tag(stage: u32) -> u32 {
    if (stage == 1) { return 103; } if (stage == 2) { return 117; } return 121;
}

