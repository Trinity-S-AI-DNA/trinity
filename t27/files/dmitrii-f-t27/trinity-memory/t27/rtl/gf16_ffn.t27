value40lo = magnitude0 << 1; value40hi = (magnitude1 << 1) | (magnitude0 >> 63);
numerator0 = value40lo << 7; numerator1 = (value40hi << 7) | (value40lo >> 57);
trit_negative = ((weight0 & 3) == 2) != ((vr & 32768) != 0);
trit0 = pick((weight0 & 3) == 0,0,pick(trit_negative,0-magnitude0,magnitude0));
trit1 = pick((weight0 & 3) == 0,0,pick(trit_negative,(0 as u64)-magnitude1-pick(magnitude0 != 0,1,0),magnitude1));

fn on_clock(calib: bool, stall: bool, ack: bool, rdata_lo: u64, rdata_hi: u64,
            hidden: u32, inner: u32, output_rows: u32,
            math_done: bool, math_fault: bool, q0: u64, q1: u64, q2: u64, r0: u64, r1: u64,
            norm_in_ready: bool, norm_out_valid: bool, norm_value: u32, norm_product: u32,
            norm_index: u32, norm_done: bool, norm_fault: bool,
            scalar_done: bool, scalar_fault: bool, scalar_value: u64,
            line_idle: bool, s_go: bool, s_tag: u32, s_a: u32, s_b: u64) {
    vr = vec[vec_addr]; gr = gate[index & 8191]; ur = up[index & 8191];
    magnitude0 = fixed0(vr); magnitude1 = fixed1(vr);
    done1 = math_done; done2 = done1; done3 = done2; result_ready = done3;
