            cycles = 0; report_cycles = 0; memory_cycles = 0; error_code = 0; state = 8;
            projection_read = false; phase = 0; phase0 = 0; phase1 = 0; phase2 = 0; phase3 = 0;
            phase4 = 0; phase5 = 0; phase6 = 0; phase7 = 0; projection_cycles = 0;
