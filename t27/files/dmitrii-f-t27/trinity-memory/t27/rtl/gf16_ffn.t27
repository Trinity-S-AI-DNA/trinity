}

test fixed_one { assert_eq(fixed0(15872),(1 as u64) << 39); assert_eq(fixed1(15872),0); }
test fixed_max { assert_eq(fixed1(32255),127); }
test packing_one { assert_eq(pack39((1 as u64) << 39,0,0,0,1,0,0),15872); }
