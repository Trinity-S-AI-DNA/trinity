var sbuf: bool = false;
var sb_tag: u32 = 0;
var sb_a: u32 = 0;
var sb_b: u64 = 0;
var line_go: bool = false;
var line_tag: u32 = 0;
var line_a: u32 = 0;
var line_b: u64 = 0;
var s_idle: bool;
var vec_addr: u32;
var magnitude0: u64 = 0;
var magnitude1: u64 = 0;
var value40lo: u64;
var value40hi: u64;
var quant_product0: u64 = 0;
var quant_product1: u64 = 0;
var numerator0: u64;
var numerator1: u64;
var trit_negative: bool;
var trit0: u64;
var trit1: u64;
var done1: bool = false;
var done2: bool = false;
var done3: bool = false;
var result_ready: bool = false;
var rounded_code: u64 = 0;
var dot_m0: u64 = 0;
var dot_m1: u64 = 0;
