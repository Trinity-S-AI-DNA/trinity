        else if ((col & 63) == 0) { weight_addr = weight_addr+1; state = 71; }
        else { state = 74; }
    } else if (state == 77) { state = 78;
    } else if (state == 78) {
        scalar_mode = 3; scalar_x = dot_m0; scalar_y = dot_m1; scalar_r0 = 0; scalar_r1 = 0;
        scalar_d0 = 1; scalar_d1 = 0; scalar_negative = dot_sign != 0; scalar_start = true; state = 79;
    } else if (state == 79) {
        if (scalar_done) {
