        if (!pending) { ptag = 69; pa = error_code; pb = run_id as u64; pending = true; state = 901; }
    }
    if (active && (!calib || math_fault || (norm_done && norm_fault) || (scalar_done && scalar_fault))) { error_code = 2; state = 900; }
