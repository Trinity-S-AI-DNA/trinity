        // two-stage signed128 accumulator, vr and its Q39 magnitude fetch
        // the next lane. Startup states73/83 are needed only after a DDR word.
        weight0 = (weight0 >> 2) | (weight1 << 62); weight1 = weight1 >> 2; col = col+1;
        if ((weight0 & 3) == 3) { error_code = 3; state = 900; }
    } else if (state == 75) {
        add0 = acc0+term0; add1 = acc1+term1; add_carry = carry(acc0,term0); state = 76;
    } else if (state == 76) {
        acc0 = add0; acc1 = add1+add_carry;
