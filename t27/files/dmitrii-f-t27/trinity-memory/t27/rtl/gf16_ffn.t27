            code = rounded_code; negative = negative && rounded_code != 0; state = 58;
            if (q0 > 127 || q1 != 0 || q2 != 0 || rounded_code > 127) { error_code = 9; state = 900; }
        }
    } else if (state == 58) {
        a0 = maximum0; a1 = 0; a2 = 0; b0 = code; b1 = 0; math_mode = 1; math_start = true; state = 59;
    } else if (state == 59) {
        if (result_ready) {
            quant_product0 = q0; quant_product1 = q1;
            a0 = maximum1; a1 = 0; a2 = 0; b0 = code; b1 = 0;
            math_mode = 1; math_start = true; state = 63;
        }
    } else if (state == 63) {
        if (result_ready) {
            a0 = quant_product0; a1 = quant_product1+q0; a2 = 0; b0 = 254; b1 = 0;
            math_mode = 2; math_start = true; state = 60;
        }
    } else if (state == 60) {
        if (result_ready) {
            scalar_mode = 3; scalar_x = q0; scalar_y = q1; scalar_r0 = r0; scalar_r1 = r1;
            scalar_d0 = b0; scalar_d1 = b1; scalar_negative = negative; scalar_start = true; state = 62;
        }
    } else if (state == 62) {
        if (scalar_done) {
            vec[index & 8191] = (scalar_value as u32) & 65535;
            emit_index = index; emit_value = (scalar_value as u32) | (((pick(negative,0-code,code) as u32) & 255) << 16);
            emit_tag = choose(norm_kind == 0,112,118); after_emit = 61; state = choose(result_only,61,300);
            if (!finite(scalar_value as u32)) { error_code = 7; state = 900; }
        }
    } else if (state == 61) {
        if (index+1 == length) { stage = choose(norm_kind == 0,1,5); state = 70; }
        else { index = index+1; state = 55; }
    } else if (state == 70) {
        projection_read = true; phase = choose(stage == 1,3,choose(stage == 2,4,7));
        row = 0; col = 0; acc0 = 0; acc1 = 0;
        ncols = choose(stage == 5,inner,hidden); nrows = choose(stage == 5,output_rows,inner);
        weight_addr = choose(stage == 1,65536,choose(stage == 2,393216,720896)); state = 71;
    } else if (state == 71) {
        wb_addr = weight_addr; wb_stb = true; response = 72; state = 200; quiet = 0;
    } else if (state == 72) {
        weight0 = read0; weight1 = read1; state = 73;
    } else if (state == 73) { state = 83;
    } else if (state == 83) { state = 74;
    } else if (state == 74) {
        term0 = trit0; term1 = trit1; state = 75;
