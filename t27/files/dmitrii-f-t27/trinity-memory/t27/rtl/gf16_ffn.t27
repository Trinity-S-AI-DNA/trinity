        negative = (vr & 32768) != 0;
        a0 = numerator0-value40lo; a1 = numerator1-value40hi-pick(numerator0 < value40lo,1,0); a2 = 0;
        b0 = maximum0; b1 = maximum1; math_mode = 2; math_start = true; state = 57;
    } else if (state == 57) {
