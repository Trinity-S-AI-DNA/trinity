        if (stage == 2) { up[row & 8191] = (scalar_value as u32) & 65535; }
        if (stage == 5 && result_only) { gate[row & 8191] = (scalar_value as u32) & 65535; }
        emit_tag = output_tag(stage); emit_index = row; emit_value = scalar_value as u32; after_emit = 81; state = choose(result_only,81,300);
        if (!finite(scalar_value as u32)) { error_code = 7; state = 900; }
