    } else if (state == 23) {
        if (!pending) { state = 300; }
    } else if (state == 21) {
        if (index+1 == length) { state = 50; }
        else { index = index+1; state = 20; }
    } else if (state == 40) {
        projection_read = false; phase = 5; norm_kind = 1; norm_length = inner; length = inner; norm_start = true; index = 0; state = 13;
    } else if (state == 50) {
        phase = choose(norm_kind == 0,2,6); peak = 0; index = 0; state = 51;
    } else if (state == 51) { state = 52;
    } else if (state == 52) {
        if ((vr & 32767) > peak) { peak = vr & 32767; }
        if (index+1 == length) { state = 53; }
        else { index = index+1; state = 51; }
    } else if (state == 53) {
        maximum0 = fixed0(peak) << 1; maximum1 = (fixed1(peak) << 1) | (fixed0(peak) >> 63); state = 54;
    } else if (state == 54) {
