    dot_m0 = pick((acc1 >> 63) != 0,0-acc0,acc0);
    dot_m1 = pick((acc1 >> 63) != 0,(0 as u64)-acc1-pick(acc0 != 0,1,0),acc1);
    math_start = false; norm_start = false; scalar_start = false;
    if (active) {
