module TrinityGf16CodecT27;

// Issue #103. Candidate profile gf16-rne-gradual-v1; see docs/gf16-contract.md.
// Integer bit patterns only. This is a converter, not a GF16 arithmetic unit.
fn round_even(value: u32, shift: u32) -> u32 {
    let q: u32 = value >> shift;
    let remainder: u32 = value & ((1 << shift) - 1);
    let half: u32 = 1 << (shift - 1);
    if (remainder > half || (remainder == half && (q & 1) != 0)) {
        return q + 1;
    }
    return q;
}

fn encode(bits: u32) -> u32 {
    let sign: u32 = (bits >> 16) & 32768;
    let exponent: u32 = (bits >> 23) & 255;
    let mantissa: u32 = bits & 8388607;
    if (exponent == 255) {
        if (mantissa != 0) { return 32257; }
        return sign | 32256;
    }
    if (exponent > 158) { return sign | 32256; }
    if (exponent < 87) { return sign; }
    if (exponent < 97) {
        return sign | round_even(8388608 | mantissa, 111 - exponent);
    }
    // Addition propagates a rounded significand carry into the exponent,
    // including the maximum-finite to infinity boundary.
    return sign | (((exponent - 96) << 9) + round_even(mantissa, 14));
}

fn decode(bits: u32) -> u32 {
    let sign: u32 = (bits & 32768) << 16;
    let exponent: u32 = (bits >> 9) & 63;
    let mantissa: u32 = bits & 511;
    if (exponent == 63) {
        if (mantissa != 0) { return 2143289344; }
        return sign | 2139095040;
    }
    if (exponent != 0) {
        return sign | ((exponent + 96) << 23) | (mantissa << 14);
    }
    if (mantissa == 0) { return sign; }
    // Bounded priority encoder, explicitly unrolled for both backends.
    if (mantissa >= 256) { return sign | (96 << 23) | ((mantissa - 256) << 15); }
    if (mantissa >= 128) { return sign | (95 << 23) | ((mantissa - 128) << 16); }
    if (mantissa >= 64) { return sign | (94 << 23) | ((mantissa - 64) << 17); }
    if (mantissa >= 32) { return sign | (93 << 23) | ((mantissa - 32) << 18); }
    if (mantissa >= 16) { return sign | (92 << 23) | ((mantissa - 16) << 19); }
    if (mantissa >= 8) { return sign | (91 << 23) | ((mantissa - 8) << 20); }
    if (mantissa >= 4) { return sign | (90 << 23) | ((mantissa - 4) << 21); }
    if (mantissa >= 2) { return sign | (89 << 23) | ((mantissa - 2) << 22); }
    return sign | (88 << 23);
}

var gf16_out: u32 = 0;
var f32_out: u32 = 0;
fn on_clock(f32_in: u32, gf16_in: u32) {
    gf16_out = encode(f32_in);
    f32_out = decode(gf16_in);
}
