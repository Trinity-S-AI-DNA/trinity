module TrinityFfnWideT27;

// Issue #92. Unsigned, exact multi-cycle arithmetic for the FFN contract.
// Limbs are little endian u64; no implicit u128/192 compiler type is used.
// mode 1: a0*b0 -> q[127:0], 128 clocks.
// mode 2: a[191:0]/b[127:0] -> quotient q and remainder r, 384 clocks.
//         Require 0 < b < 2^127 (FFN divisors are at most 96 bits).
// mode 3: floor(sqrt(a[191:0])) -> q[95:0], remainder a-q*q, 192 clocks.
// start is accepted only while idle. Outputs hold until the next operation;
// done pulses once, including a rejected mode/divisor (fault=true).
var busy: bool = false;
var done: bool = false;
var fault: bool = false;
var op: u32 = 0;
var count: u32 = 0;
var n0: u64 = 0;
var n1: u64 = 0;
var n2: u64 = 0;
var d0: u64 = 0;
var d1: u64 = 0;
var q0: u64 = 0;
var q1: u64 = 0;
var q2: u64 = 0;
var r0: u64 = 0;
var r1: u64 = 0;
var half: bool = false;
var step_take: bool = false;
var step_low: u64 = 0;
var step_high: u64 = 0;
var step_carry: u64 = 0;
var step_shift0: u64 = 0;
var step_shift1: u64 = 0;

fn carry(a: u64, b: u64) -> u64 {
    if (a + b < a) { return 1; }
    return 0;
}
fn borrow(a: u64, b: u64) -> u64 {
    if (a < b) { return 1; }
    return 0;
}
fn ge128(a0: u64, a1: u64, b0: u64, b1: u64) -> bool {
    return a1 > b1 || (a1 == b1 && a0 >= b0);
}
fn pick(flag: bool, a: u64, b: u64) -> u64 {
    if (flag) { return a; }
    return b;
}

var shifted0: u64;
var shifted1: u64;
var trial0: u64;
var trial1: u64;
var take: bool;
shifted0 = pick(op == 3, (r0 << 2) | (n2 >> 62), (r0 << 1) | (n2 >> 63));
shifted1 = pick(op == 3, (r1 << 2) | (r0 >> 62), (r1 << 1) | (r0 >> 63));
trial0 = pick(op == 3, (q0 << 2) | 1, d0);
trial1 = pick(op == 3, (q1 << 2) | (q0 >> 62), d1);
take = ge128(shifted0, shifted1, trial0, trial1);

fn on_clock(start: bool, mode: u32, a0: u64, a1: u64, a2: u64, b0: u64, b1: u64) {
    done = false;
    if (!busy) {
        if (start) {
            op = mode;
            fault = false;
            q0 = 0; q1 = 0; q2 = 0;
            r0 = 0; r1 = 0;
            n0 = a0; n1 = a1; n2 = a2;
            d0 = b0; d1 = b1;
            busy = true;
            half = false;
            if (mode == 1) {
                n1 = 0; n2 = 0; count = 64;
            } else if (mode == 2) {
                count = 192;
                if ((b0 == 0 && b1 == 0) || (b1 >> 63) != 0) {
                    busy = false; done = true; fault = true;
                }
            } else if (mode == 3) {
                count = 96;
            } else {
                busy = false; done = true; fault = true;
            }
        }
    } else if (!half) {
        half = true;
        if (op == 1) {
            step_low = q0 + pick((d0 & 1) != 0,n0,0);
            step_high = q1 + pick((d0 & 1) != 0,n1,0);
            step_carry = pick((d0 & 1) != 0,carry(q0,n0),0);
        } else {
            step_take = take; step_shift0 = shifted0; step_shift1 = shifted1;
            step_low = shifted0-trial0; step_high = shifted1-trial1;
            step_carry = borrow(shifted0,trial0);
        }
    } else {
        half = false;
        count = count - 1;
        if (count == 1) { busy = false; done = true; }
        if (op == 1) {
            q0 = step_low; q1 = step_high + step_carry;
            n0 = n0 << 1; n1 = (n1 << 1) | (n0 >> 63);
            d0 = d0 >> 1;
        } else {
            r0 = pick(step_take,step_low,step_shift0);
            r1 = pick(step_take,step_high-step_carry,step_shift1);
            q0 = (q0 << 1) | pick(step_take, 1, 0);
            q1 = (q1 << 1) | (q0 >> 63);
            q2 = (q2 << 1) | (q1 >> 63);
            if (op == 3) {
                n0 = n0 << 2; n1 = (n1 << 2) | (n0 >> 62);
                n2 = (n2 << 2) | (n1 >> 62);
            } else {
                n0 = n0 << 1; n1 = (n1 << 1) | (n0 >> 63);
                n2 = (n2 << 1) | (n1 >> 63);
            }
        }
    }
}

test carry_at_boundary { assert_eq(carry(18446744073709551615, 1), 1); assert_eq(carry(4, 5), 0); }
test limb_comparison { assert_eq(ge128(0, 1, 18446744073709551615, 0), true); assert_eq(ge128(5, 0, 6, 0), false); }
test borrow_at_boundary { assert_eq(borrow(0, 1), 1); assert_eq(borrow(1, 1), 0); }
