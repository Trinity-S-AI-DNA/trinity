module TrinityFpgaUartRxT27;

// 8N1 UART receiver (issue #63): one start bit, eight data bits LSB first, one
// stop bit, baud_div enabled clocks per bit (the transmitter's divisor,
// t27/rtl/fpga_uart_tx.t27). The line passes through three flip-flops (rx1-rx3,
// the synchroniser of the benches); the receiver reads rx2, rx3 is its previous
// value.
//
// Idle: a low rx2 starts a character. The start bit is sampled again
// (baud_div >> 1) clocks after the line fell, plus the 0..1 clock between the fall
// and the clock edge that saw it: count starts at (baud_div >> 1) - 1 because IDLE
// and the last step of START take one clock each, and every sample reads rx2, so
// the synchroniser delay cancels. That puts the sample 0..1 clock after the middle
// of the bit for an even baud_div, -0.5..+0.5 clock for an odd one. Still low
// there, the character goes on; high again, it was a glitch of about half a bit or
// less (false_starts + 1) and the receiver is idle again. The data bits and the
// stop bit are sampled baud_div clocks apart, each as close to the middle of its bit;
// the host's bit period may then be off by about 5 % either way at 217 clocks per
// bit (arithmetic in docs/uart-loader.md, "Receiver").
// At the stop sample `valid` is high for one clock with `data`, and `ferr` says
// the stop bit was low (a framing error, framing_errors + 1). After a framing
// error the receiver waits for the line to go high before it looks for the next
// start bit, so a break (the line held low) gives one character, not a stream
// of zero bytes. `bytes` counts every character delivered, framing errors
// included.
// Every statement reads a variable before the same tick writes it, so the C and
// the Verilog backends agree.
const R_IDLE: u32 = 0;
const R_START: u32 = 1;
const R_DATA: u32 = 2;
const R_STOP: u32 = 3;
const R_WAIT_HIGH: u32 = 4;

var rx1: bool = true;
var rx2: bool = true;
var rx3: bool = true;
var state: u32 = 0;
var count: u32 = 0;
var bitn: u32 = 0;
var shift: u32 = 0;
var valid: bool = false;
var data: u32 = 0;
var ferr: bool = false;
var bytes: u32 = 0;
var framing_errors: u32 = 0;
var false_starts: u32 = 0;

// The data register after one more sampled bit: bits enter at the top and move
// down, so after eight samples the first (least significant) bit is bit 0.
fn shift_in(s: u32, one: bool) -> u32 {
    if (one) { return (s >> 1) | 128; }
    return s >> 1;
}

fn on_clock(uart_rx: bool, baud_div: u32) {
    valid = false;
    if (state == R_IDLE) {
        if (!rx2) {
            count = (baud_div >> 1) - 1;
            state = R_START;
        }
    } else if (state == R_START) {
        if (count != 0) {
            count = count - 1;
        } else if (rx2) {
            false_starts = false_starts + 1;
            state = R_IDLE;
        } else {
            count = baud_div - 1;
            bitn = 0;
            state = R_DATA;
        }
    } else if (state == R_DATA) {
        if (count != 0) {
            count = count - 1;
        } else {
            shift = shift_in(shift, rx2);
            count = baud_div - 1;
            if (bitn == 7) { state = R_STOP; } else { bitn = bitn + 1; }
        }
    } else if (state == R_STOP) {
        if (count != 0) {
            count = count - 1;
        } else {
            valid = true;
            data = shift;
            ferr = !rx2;
            bytes = bytes + 1;
            if (rx2) {
                state = R_IDLE;
            } else {
                framing_errors = framing_errors + 1;
                state = R_WAIT_HIGH;
            }
        }
    } else {
        if (rx2) { state = R_IDLE; }
    }
    rx3 = rx2;
    rx2 = rx1;
    rx1 = uart_rx;
}

test bits_enter_from_the_top { assert_eq(shift_in(0, true), 128); assert_eq(shift_in(128, false), 64); }
test lsb_first_after_eight_samples {
    // 0x41 = 0100_0001, sent LSB first: 1,0,0,0,0,0,1,0
    assert_eq(shift_in(shift_in(shift_in(shift_in(shift_in(shift_in(shift_in(shift_in(0, true), false), false), false), false), false), true), false), 65);
}
endmodule
