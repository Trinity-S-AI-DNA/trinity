module TrinityFpgaEdgeArgmaxT27;

// Edge Demo label on the device: the strict maximum of the three accumulators is
// the label (0 rising, 1 falling, 2 alternating); any tie is ambiguous, reported
// as label 3 (specs/memory/edge_demo.t27, tms_edge_argmax with -1 for a tie).
fn on_comb(acc0: i32, acc1: i32, acc2: i32) -> u16 {
    var best: u16 = 0;
    var top: i32 = acc0;
    if (acc1 > top) { best = 1; top = acc1; }
    if (acc2 > top) { best = 2; top = acc2; }
    var ties: u16 = 0;
    if (acc0 == top) { ties = ties + 1; }
    if (acc1 == top) { ties = ties + 1; }
    if (acc2 == top) { ties = ties + 1; }
    if (ties > 1) { return 7; }
    return best;
}

test rising { assert_eq(on_comb(480, -480, 0), 0); }
test falling { assert_eq(on_comb(-480, 480, 0), 1); }
test alternating { assert_eq(on_comb(0, 0, 360), 2); }
test tie_is_ambiguous { assert_eq(on_comb(5, 5, 1), 7); }
test all_equal_is_ambiguous { assert_eq(on_comb(0, 0, 0), 7); }
test negative_maximum { assert_eq(on_comb(-3, -1, -2), 1); }
endmodule
