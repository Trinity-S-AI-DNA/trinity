module TrinityGf16ScalarT27;
// Issue #111. Bounded clocked scalar arithmetic for the unchanged GF16 profiles.
// 1: relu(x)^2*y -> FP32; 2: x*y -> GF16; 3: (x:y + r/d)*2^-39 -> GF16;
// 4: RNE(abs(FP32(x))/2^aux) -> unsigned Q magnitude (at most 41 bits).
// x is the low and y the high quotient limb in mode 3; negative is its sign.
fn finite(v: u64) -> bool { return v <= 65535 && (v & 32256) != 32256; }
fn mant(v: u64) -> u32 { if ((v & 32256) == 0) { return (v & 511) as u32; } return ((v & 511) | 512) as u32; }
fn power(v: u64) -> i32 { if ((v & 32256) == 0) { return -39; } return (((v >> 9) & 63) as i32)-40; }
fn pick(flag: bool, a: u32, b: u32) -> u32 { if (flag) { return a; } return b; }

var state: u32 = 0;
var busy: bool = false;
var done: bool = false;
var fault: bool = false;
var value: u64 = 0;
var op: u32 = 0;
var sign: u32 = 0;
var exponent: i32 = 0;
var m0: u64 = 0;
var m1: u64 = 0;
var guard: bool = false;
var sticky: bool = false;
var rounded: u32 = 0;
var ma: u32 = 0;
var mb: u32 = 0;
var mc: u32 = 0;
var sum: u32 = 0;
var mul_index: u32 = 0;
var phase: u32 = 0;
var twice0: u64 = 0;
var twice1: u64 = 0;
var den0: u64 = 0;
var den1: u64 = 0;
var shift: i32 = 0;

fn on_clock(start: bool, mode: u32, x: u64, y: u64,
            r0: u64, r1: u64, d0: u64, d1: u64, negative: bool, aux: i32) {
    done = false;
    if (state == 0) {
        if (start) {
            op = mode; busy = true; fault = false; value = 0; guard = false; sticky = false;
            if (mode == 1 || mode == 2) {
                sign = pick(mode == 1,((y as u32) & 32768) << 16,((x^y) as u32) & 32768);
                ma = mant(x); mb = mant(y); mc = mant(y); sum = 0; mul_index = 0; phase = 1;
                exponent = power(x)+power(y); state = 1;
                if (mode == 1) { mb = mant(x); exponent = power(x)+power(x)+power(y); phase = 0; }
                if ((x & 32767) == 0 || (y & 32767) == 0 || (mode == 1 && (x & 32768) != 0)) {
                    value = pick(mode == 1,((y as u32) & 32768) << 16,((x^y) as u32) & 32768) as u64;
                    busy = false; done = true; state = 0;
                }
                if (!finite(x) || !finite(y)) { fault = true; busy = false; done = true; state = 0; }
            } else if (mode == 3) {
                sign = pick(negative,32768,0); m0 = x; m1 = y; exponent = -39;
                twice0 = r0 << 1; twice1 = (r1 << 1) | (r0 >> 63); den0 = d0; den1 = d1; state = 20;
                if ((d0 == 0 && d1 == 0) || (d1 >> 63) != 0 || r1 > d1 || (r1 == d1 && r0 >= d0)) {
                    fault = true; busy = false; done = true; state = 0;
                }
            } else if (mode == 4) {
                m0 = (x & 8388607) | 8388608; m1 = 0;
                shift = (((x >> 23) & 255) as i32)-150-aux; state = 30;
                if ((x & 2147483647) == 0) { value = 0; busy = false; done = true; state = 0; }
                if ((x >> 32) != 0 || aux < -54 || aux > 55 || ((x & 2147483647) != 0 && (((x >> 23) & 255) < 10 || ((x >> 23) & 255) > 222))) { fault = true; busy = false; done = true; state = 0; }
            } else { fault = true; busy = false; done = true; state = 0; }
        }
    } else if (state == 1) {
        if ((mb & 1) != 0) { sum = sum+ma; }
        ma = ma << 1; mb = mb >> 1; mul_index = mul_index+1;
        if (mul_index == 9) { state = 2; }
    } else if (state == 2) {
        if (phase == 0) { ma = sum; mb = mc; sum = 0; mul_index = 0; phase = 1; state = 1; }
        else { m0 = sum as u64; m1 = 0; state = 10; }
    } else if (state == 20) {
        guard = twice1 > den1 || (twice1 == den1 && twice0 >= den0);
        sticky = (twice0 != 0 || twice1 != 0) && (twice1 != den1 || twice0 != den0);
        state = 10;
    } else if (state == 10) {
        if (m1 != 0 || m0 >= (pick(op == 1,16777216,1024) as u64) || (op != 1 && exponent < -39)) {
            sticky = sticky || guard; guard = (m0 & 1) != 0;
            m0 = (m0 >> 1) | (m1 << 63); m1 = m1 >> 1; exponent = exponent+1;
        } else if (m0 < (pick(op == 1,8388608,512) as u64) && (op == 1 || exponent > -39)) {
            m0 = m0 << 1; m1 = (m1 << 1) | (m0 >> 63); exponent = exponent-1;
        } else { state = 11; }
    } else if (state == 11) {
        rounded = (m0 as u32)+pick(guard && (sticky || (m0 & 1) != 0),1,0); state = 12;
    } else if (state == 12) {
        if (rounded >= pick(op == 1,16777216,1024)) { rounded = rounded >> 1; exponent = exponent+1; }
        state = 13;
    } else if (state == 13) {
        if (op == 1) { value = (sign | (((exponent+150) as u32) << 23) | (rounded & 8388607)) as u64; }
        else if (exponent > 22) { value = (sign | 32256) as u64; }
        else if (exponent == -39 && rounded < 512) { value = (sign | rounded) as u64; }
        else { value = (sign | (((exponent+40) as u32) << 9) | (rounded & 511)) as u64; }
        busy = false; done = true; state = 0;
    } else if (state == 30) {
        if (shift > 17) { fault = true; busy = false; done = true; state = 0; }
        else if (shift <= -25) { value = 0; busy = false; done = true; state = 0; }
        else if (shift > 0) { m0 = m0 << 1; shift = shift-1; }
        else if (shift < 0) { sticky = sticky || guard; guard = (m0 & 1) != 0; m0 = m0 >> 1; shift = shift+1; }
        else { state = 31; }
    } else if (state == 31) {
        value = m0+(pick(guard && (sticky || (m0 & 1) != 0),1,0) as u64);
        busy = false; done = true; state = 0;
    }
}

test significands { assert_eq(mant(15872),512); assert_eq(power(15872),-9); }
