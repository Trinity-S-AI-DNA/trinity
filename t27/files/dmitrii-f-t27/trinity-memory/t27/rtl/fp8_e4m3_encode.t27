module TrinityFp8E4m3EncodeT27;

// IEEE-754 binary32 -> OCP FP8 E4M3FN, round to nearest, ties to even.
// The E4M3 overflow rule is where conforming implementations part ways, so it
// is an input rather than a guess:
//   saturate = 1: overflow and infinities give +-448 (0x7E / 0xFE), the
//                 saturating convention (AMD, tt-metal);
//   saturate = 0: overflow and infinities give NaN (0x7F / 0xFF), the
//                 non-saturating convention (ml_dtypes float8_e4m3fn).
// Only bit 0 of `saturate` is read. A NaN input gives NaN with the input sign.
// binary32 subnormals (below 2^-126) round to a signed zero.

// Round-to-nearest-even of v >> sh for 1 <= sh <= 25 and v < 2^24.
fn rne_shift(v: u32, sh: u32) -> u32 {
    var q: u32 = v >> sh;
    var rem: u32 = v & ((1 << sh) - 1);
    var half: u32 = 1 << (sh - 1);
    var up: u32 = 0;
    if (rem > half) { up = 1; }
    if (rem == half) { up = q & 1; }
    return q + up;
}

fn on_comb(bits: u32, saturate: u8) -> u8 {
    var sign: u32 = (bits >> 31) << 7;
    var exponent: u32 = (bits >> 23) & 255;
    var fraction: u32 = bits & 8388607;
    var sat: u32 = (saturate as u32) & 1;
    var nan_code: u32 = sign | 127;
    var overflow_code: u32 = sign | (127 - sat);
    var significand: u32 = 8388608 | fraction;

    // Normal E4M3 targets: unbiased exponent -6..8, binary32 field 121..135.
    var q: u32 = rne_shift(significand, 20);
    var e8: u32 = exponent - 120;
    var q_n: u32 = q;
    if (q == 16) { q_n = 8; e8 = e8 + 1; }
    var normal_code: u32 = sign | (e8 << 3) | (q_n - 8);

    // Subnormal E4M3 targets: value in units of 2^-9 is significand >> (141 - exponent).
    var sh: u32 = 141 - exponent;
    if (sh > 25) { sh = 25; }
    var qs: u32 = rne_shift(significand, sh);
    var subnormal_code: u32 = sign | qs;

    if (exponent == 255) {
        if (fraction != 0) { return nan_code as u8; }
        return overflow_code as u8;
    }
    if (exponent == 0) { return sign as u8; }
    if (exponent > 135) { return overflow_code as u8; }
    if (exponent >= 121) {
        if (e8 > 15) { return overflow_code as u8; }
        if (e8 == 15) {
            if (q_n == 15) { return overflow_code as u8; }
        }
        return normal_code as u8;
    }
    if (exponent < 116) { return sign as u8; }
    // qs == 8 is the carry into the smallest normal, whose code is 8 as well.
    return subnormal_code as u8;
}

test one { assert_eq(on_comb(1065353216, 1), 56); }
test minus_one_and_half { assert_eq(on_comb(3217031168, 0), 188); }
test largest_finite { assert_eq(on_comb(1138753536, 0), 126); }
test tie_below_overflow_rounds_to_even { assert_eq(on_comb(1139277824, 0), 126); }
test just_above_tie_saturates { assert_eq(on_comb(1139310592, 1), 126); }
test just_above_tie_is_nan { assert_eq(on_comb(1139310592, 0), 127); }
test thousand_saturates { assert_eq(on_comb(1148846080, 1), 126); }
test thousand_is_nan { assert_eq(on_comb(1148846080, 0), 127); }
test infinity_saturates { assert_eq(on_comb(2139095040, 1), 126); }
test infinity_is_nan { assert_eq(on_comb(2139095040, 0), 127); }
test negative_infinity_saturates { assert_eq(on_comb(4286578688, 1), 254); }
test nan_stays_nan { assert_eq(on_comb(2143289344, 1), 127); }
test smallest_subnormal { assert_eq(on_comb(989855744, 0), 1); }
test half_smallest_subnormal_ties_to_zero { assert_eq(on_comb(981467136, 0), 0); }
test three_quarters_smallest_subnormal_rounds_up { assert_eq(on_comb(985661440, 0), 1); }
test largest_subnormal { assert_eq(on_comb(1012924416, 0), 7); }
test smallest_normal { assert_eq(on_comb(1015021568, 0), 8); }
test negative_zero { assert_eq(on_comb(2147483648, 0), 128); }
endmodule
