module TrinityFpgaResetT27;

// Reset generator: the active-low push button synchronized through two stages,
// plus a power-on hold of 128 enabled clocks. `reset` is high until both the
// power-on hold has elapsed and the button is released. `heartbeat` toggles
// every 2^23 enabled clocks (an LED that proves the clock runs).
var stage1: bool = false;
var stage2: bool = false;
var hold: u32 = 0;
var blink: u32 = 0;
var reset: bool;
var heartbeat: bool;
reset = hold < 128 || !stage2;
heartbeat = (blink & 8388608) == 8388608;

fn on_clock(button_n: bool) {
    stage2 = stage1;
    stage1 = button_n;
    if (hold < 128) { hold = hold + 1; }
    blink = blink + 1;
}

test hold_counts_to_128 { assert_eq(127 < 128, true); assert_eq(128 < 128, false); }
endmodule
