module TrinityStreamStorageT27;

// Native synchronous storage and read sequencer. Current t27c needs a literal
// physical array dimension; word_count selects the logical extent (1..64).
// The 16-bit primitive element bridges both 8-bit dense and 10-bit baseline
// ports. No RAM width/resource claim follows from this functional model.
const CAPACITY: u32 = 64;
var memory: [CAPACITY]u16;
var read_code: u16;
var read_addr: u32 = 0;
var active: bool = false;
var valid_q: bool = false;
var last_q: bool = false;

fn visible_code(code: u16, valid: bool) -> u16 {
    if (valid) { return code; }
    return 0;
}

var config_ok: bool;
var busy: bool;
var load_ready: bool;
var out_valid: bool;
var out_last: bool;
var out_code: u16;
config_ok = word_count > 0 && word_count <= CAPACITY;
busy = active || valid_q;
load_ready = !reset && !busy && !start && config_ok;
out_valid = valid_q;
out_last = valid_q && last_q;
out_code = visible_code(read_code, valid_q);

// Compiler rst_n/en are tied high by the adapter. Reset is synchronous and
// only resets control, so written RAM contents survive an aborted stream.
// out_ready is the downstream ready: while a word is presented (valid_q) and
// out_ready is low, the sequencer holds the word, its flags and its address,
// so the read -> decode -> dot join needs no buffer (issue #15).
fn on_clock(reset: bool, start: bool, load_en: bool, load_addr: u32,
            load_code: u16, word_count: u32, out_ready: bool) {
    if (load_en && load_ready && load_addr < word_count) {
        memory[load_addr] = load_code;
    }
    if (reset) {
        read_addr = 0;
        active = false;
        valid_q = false;
        last_q = false;
    } else if (out_ready || !valid_q) {
        if (active) { read_code = memory[read_addr]; }
        valid_q = false;
        last_q = false;
        if (start && !busy && config_ok) {
            read_addr = 0;
            active = true;
        } else if (active) {
            valid_q = true;
            if (read_addr == word_count - 1) {
                active = false;
                last_q = true;
            } else { read_addr = read_addr + 1; }
        }
    }
}

test hidden_idle_data { assert_eq(visible_code(171, false), 0); }
test visible_valid_data { assert_eq(visible_code(171, true), 171); }
endmodule
