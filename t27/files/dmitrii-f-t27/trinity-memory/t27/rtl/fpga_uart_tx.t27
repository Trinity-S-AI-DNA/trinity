module TrinityFpgaUartTxT27;

// 8N1 UART transmitter: one start bit, eight data bits LSB first, one stop bit,
// baud_div enabled clocks per bit. tx is the shift register's low bit while a
// frame is in flight and idle-high otherwise.
var busy: bool = false;
var shift: u32 = 1023;
var count: u32 = 0;
var bits: u32 = 0;
var tx: bool;
tx = !busy || (shift & 1) == 1;

fn on_clock(start: bool, data: u32, baud_div: u32) {
    if (!busy) {
        if (start) {
            shift = 512 | ((data & 255) << 1);
            count = baud_div - 1;
            bits = 10;
            busy = true;
        }
    } else if (count != 0) {
        count = count - 1;
    } else {
        shift = 512 | (shift >> 1);
        count = baud_div - 1;
        bits = bits - 1;
        if (bits == 1) { busy = false; }
    }
}

test frame_layout { assert_eq(512 | ((65 & 255) << 1), 642); }
test stop_bit_fills_from_the_top { assert_eq(512 | (642 >> 1), 833); }
endmodule
