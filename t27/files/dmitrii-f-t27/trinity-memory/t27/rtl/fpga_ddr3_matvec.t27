fn d5t10(w: u64) -> u64 {
    var t: u64 = 0;
    if (w == 1) { t = 0; }
    if (w == 2) { t = 0; }
    if (w == 3) { t = 0; }
    if (w == 4) { t = 0; }
    if (w == 5) { t = 0; }
    if (w == 6) { t = 0; }
    if (w == 7) { t = 4294443008; }
    return t;
}

fn d5_dec(code: u64) -> u64 {
    var w: u64 = (code >> 5) & 7;
    var s: u64 = code & 31;
    return ((d5t0(w) >> s) & 1)
         | (((d5t1(w) >> s) & 1) << 1)
         | (((d5t2(w) >> s) & 1) << 2)
         | (((d5t3(w) >> s) & 1) << 3)
         | (((d5t4(w) >> s) & 1) << 4)
         | (((d5t5(w) >> s) & 1) << 5)
         | (((d5t6(w) >> s) & 1) << 6)
         | (((d5t7(w) >> s) & 1) << 7)
         | (((d5t8(w) >> s) & 1) << 8)
         | (((d5t9(w) >> s) & 1) << 9)
         | (((d5t10(w) >> s) & 1) << 10);
}

// Four dense5 bytes -> 20 lanes in bits 39:0, invalid bytes in bits 55:48.
fn d5_dec4(w: u64) -> u64 {
    var b0: u64 = d5_dec(w & 255);
    var b1: u64 = d5_dec((w >> 8) & 255);
    var b2: u64 = d5_dec((w >> 16) & 255);
    var b3: u64 = d5_dec((w >> 24) & 255);
    var lanes: u64 = (b0 & 1023) | ((b1 & 1023) << 10) | ((b2 & 1023) << 20) | ((b3 & 1023) << 30);
    var bad: u64 = ((b0 >> 10) + (b1 >> 10)) + ((b2 >> 10) + (b3 >> 10));
    return lanes | (bad << 48);
}

// Sixteen baseline2 lanes with every 11 lane cleared and counted.
fn b2_dec16(w: u64) -> u64 {
    var x: u64 = w & M32;
    var both: u64 = x & (x >> 1) & PAIRS32;
    var bad: u64 = 0;
    var j: u32 = 0;
    while (j < 16) {
        bad = bad + ((both >> (j << 1)) & 1);
        j = j + 1;
    }
    return (x ^ (both | (both << 1))) | (bad << 48);
}

fn lanes_of(f: u32) -> u32 {
    var n: u32 = 64;
    if (f == FMT_D5) { n = 80; }
    return n;
}

// Sub-words of eight lanes in a word: 10 dense5, 8 baseline2.
fn subs_of(f: u32) -> u32 {
    var n: u32 = 8;
    if (f == FMT_D5) { n = 10; }
    return n;
}

// 0 unless cols is a multiple of the word lanes (the model's guard).
fn words_per_row(cols: u32, f: u32) -> u32 {
    var w2: u32 = cols >> 6;
    var w5: u32 = 0;
    if ((cols % 80) == 0) { w5 = cols / 80; }
    var w: u32 = w2;
    if (f == FMT_D5) { w = w5; }
    return w;
}

fn act_words_of(cols: u32) -> u32 {
    return (cols + 15) >> 4;
}

// Decoded lanes of the four chunks, as the reader's dec_part.
fn dec_part(f: u32, d0: u64, d1: u64, d2: u64, d3: u64, part: u32) -> u64 {
    var x0: u64 = d0 & 1099511627775;
    var x1: u64 = d1 & 1099511627775;
    var x2: u64 = d2 & 1099511627775;
    var x3: u64 = d3 & 1099511627775;
    var y0: u64 = d0 & M32;
    var y1: u64 = d1 & M32;
    var y2: u64 = d2 & M32;
    var y3: u64 = d3 & M32;
    var dense: u64 = x0 | (x1 << 40);
    var base2: u64 = y0 | (y1 << 32);
    if (part == 1) {
        dense = (x1 >> 24) | (x2 << 16) | (x3 << 56);
        base2 = y2 | (y3 << 32);
    }
    if (part == 2) {
        dense = x3 >> 8;
        base2 = 0;
    }
    var r: u64 = base2;
    if (f == FMT_D5) { r = dense; }
    return r;
}

fn invalid_of(d0: u64, d1: u64, d2: u64, d3: u64) -> u32 {
    return ((((d0 >> 48) & 255) + ((d1 >> 48) & 255)) + (((d2 >> 48) & 255) + ((d3 >> 48) & 255))) as u32;
}

// Bit 2j + sign of the 160-bit lane vector.
fn lane_bit(l0: u64, l1: u64, l2: u64, j: u32, sign: u32) -> u64 {
    var w: u64 = l0;
    if (j >= 32) { w = l1; }
    if (j >= 64) { w = l2; }
    return (w >> (((j << 1) + sign) & 63)) & 1;
}

// Byte j of the act word, sign extended to 64-bit two's complement.
fn act_ext(word: u64, j: u32) -> u64 {
    var b: u64 = (word >> ((j & 7) << 3)) & 255;
    if (b < 128) { return b; }
    return b | 18446744073709551360;
}

// The sixteen lane bits of the sub-word c_sub addresses, ten static shifts:
// mutually exclusive picks that synthesise to a flat mux, not a barrel over
// the 160-bit lane vector (the dynamic-shift lane_bit was the board build's
// critical path). dg0 holds lanes 0-31, dg1 32-63, dg2 64-79.
fn sub_lane_bits(s: u32, d0: u64, d1: u64, d2: u64) -> u64 {
    var r: u64 = 0;
    if (s == 0) { r = d0 & 65535; }
    if (s == 1) { r = (d0 >> 16) & 65535; }
    if (s == 2) { r = (d0 >> 32) & 65535; }
    if (s == 3) { r = (d0 >> 48) & 65535; }
    if (s == 4) { r = d1 & 65535; }
    if (s == 5) { r = (d1 >> 16) & 65535; }
    if (s == 6) { r = (d1 >> 32) & 65535; }
    if (s == 7) { r = (d1 >> 48) & 65535; }
    if (s == 8) { r = d2 & 65535; }
    if (s == 9) { r = (d2 >> 16) & 65535; }
    return r;
}

// Dot of the sub-word's eight lanes against eight activation bytes. Lane j's
// magnitude is bit 2j and its sign bit 2j + 1 of the extracted half word:
// value = mag - sign. The sum stays inside 16-bit two's complement
// (|sum| <= 8 * 128 = 1024), so the additions run on u32: the 64-bit carry
// chains of the u64 form were most of the consumer's critical path on the
// board build.
// One lane's product: the sign-extended activation byte selected by the
// lane's magnitude/sign bits of the extracted half word.
fn dot_one(sw: u64, word: u64, j: u32) -> u32 {
    var sign: u64 = ((sw >> (j << 1)) & 1) - ((sw >> ((j << 1) + 1)) & 1);
    var b: u32 = ((word >> ((j & 7) << 3)) & 255) as u32;
    if (b >= 128) { b = b | 4294967040; }
    var prod: u32 = 0;
    if (sign == 1) { prod = b; }
    if (sign == 18446744073709551615) { prod = 0 - b; }
    return prod;
}

fn dot_sub(sw: u64, word: u64) -> u32 {
    var sum: u32 = 0;
    var j: u32 = 0;
    while (j < 8) {
        var sign: u64 = ((sw >> (j << 1)) & 1) - ((sw >> ((j << 1) + 1)) & 1);
        var b: u32 = ((word >> ((j & 7) << 3)) & 255) as u32;
        if (b >= 128) { b = b | 4294967040; }   // sign-extend the byte in u32
        var prod: u32 = 0;
        if (sign == 1) { prod = b; }
        if (sign == 18446744073709551615) { prod = 0 - b; }
        sum = sum + prod;
        j = j + 1;
    }
    return sum;
}

fn pick64(c: bool, a: u64, b: u64) -> u64 {
    var r: u64 = b;
    if (c) { r = a; }
    return r;
}

fn pick32(c: bool, a: u32, b: u32) -> u32 {
    var r: u32 = b;
    if (c) { r = a; }
    return r;
}

fn pick_bool(c: bool, a: bool, b: bool) -> bool {
    var r: bool = b;
    if (c) { r = a; }
    return r;
}

fn rep_last(kind: u32) -> u32 {
    var n: u32 = 0;
    if (kind == K_HEAD) { n = 2; }
    if (kind == K_RUN) { n = 6; }
    return n;
}

fn rep_tag(kind: u32, n: u32) -> u32 {
    var t: u32 = TAG_Z;
    if (kind == K_HEAD) {
        t = TAG_Q;
        if (n == 1) { t = TAG_K; }
        if (n == 2) { t = TAG_V; }
    }
    if (kind == K_RUN) {
        t = TAG_D;
        if (n == 1) { t = TAG_C; }
        if (n == 2) { t = TAG_O; }
        if (n == 3) { t = TAG_W; }
        if (n == 4) { t = TAG_N; }
        if (n == 5) { t = TAG_U; }
        if (n == 6) { t = TAG_Z; }
    }
    if (kind == K_TIME) { t = TAG_T; }
    return t;
}

fn head_a(cols: u32, rows: u32, magic: u32, n: u32) -> u32 {
    var a: u32 = cols;
    if (n == 1) { a = rows; }
    if (n == 2) { a = magic; }
    return a;
}

fn head_b(lanes: u32, cap: u32, wpr: u32, aw: u32, pd: u32, n: u32) -> u64 {
    var b: u64 = (MATVEC_FORMAT << 32) | (((lanes & 255) as u64) << 24) | ((cap & 16777215) as u64);
    if (n == 1) { b = ((wpr as u64) << 32) | (aw as u64); }
    if (n == 2) { b = pd as u64; }
    return b;
}

fn run_a(run: u32, words: u32, rmax: u32, rhold: u32, bad: u32, acts_run: u32, rd: u32, n: u32) -> u32 {
    var a: u32 = rd;
    if (n == 0) { a = run; }
    if (n == 1) { a = words; }
    if (n == 2) { a = rmax; }
    if (n == 3) { a = rhold; }
    if (n == 4) { a = bad; }
    if (n == 5) { a = acts_run; }
    if (n == 6) { a = runs_done; }
    return a;
}

fn run_b(polls_v: u64, cyc: u64, cmd: u64, wt: u64, cs: u64, sa: u32, tbad: u64, n: u32) -> u64 {
    var b: u64 = tbad & B40;
    if (n == 0) { b = polls_v & B40; }
    if (n == 1) { b = cyc & B40; }
    if (n == 2) { b = cmd & B40; }
    if (n == 3) { b = wt & B40; }
    if (n == 4) { b = cs & B40; }
    if (n == 5) { b = sa as u64; }
    return b;
}

fn time_b(acts_phase: bool, f: u32, run: u32) -> u64 {
    var x: u64 = 0;
    var one: u64 = 1;
    if (acts_phase) { x = one << 36; }
    return x | (((f & 1) as u64) << 32) | (run as u64);
}

// Module-level combinational assignments (gen-verilog declares an on_clock
// local where it appears, which plain Verilog rejects).
var accept: bool;
var progress: bool;
var rd_ack: bool;
var phase_ack: bool;
var out_up: u32;
var out_down: u32;
var room_up: bool;
var room_same: bool;
var room_down: bool;
var out_next: u32;
var cap_room: bool;
var fifo_room: bool;
var can_issue: bool;
var wpr_now: u32;
var subs_now: u32;
var aw_now: u32;
var words_total: u32;
var wlast_off: u32;
var awlast_off: u32;
var final_ack: bool;
var final_act_ack: bool;
var timeout: bool;
var fq_head_lo: u64;
var fq_head_hi: u64;
var push_word: bool;
var pop_word: bool;
var pop_go: bool;
var cons_active: bool;
var y_fire: bool;
var drain_done: bool;
var pfire: bool;
var sfire: bool;
var s_idle: bool;
var ack_seen: bool;
var ack_stray: bool;
var rd_phase: bool;
var rp_t: u32;
var rp_a: u32;
var rp_b: u64;
var row_result: u32;
var product_stage: bool;
product_stage = cstage == 3;
accept = wb_stb && !stall;
progress = accept || ack;
rd_ack = ack && (mstate == M_DOORBELL || mstate == M_ACTS || mstate == M_WEIGHTS);
phase_ack = ack && (mstate == M_ACTS || mstate == M_WEIGHTS);
out_up = outst + 1;
out_down = outst - 1;
room_up = out_up < cap;
room_same = outst < cap;
room_down = out_down < cap;
out_next = pick32(accept && !ack, out_up, pick32(ack && !accept, out_down, outst));
cap_room = pick_bool(accept && !ack, room_up, pick_bool(ack && !accept, room_down, room_same));
fifo_room = fq_count + out_next < 5;
can_issue = cap_room && (!serial_reads || outst == 0) && (mstate != M_WEIGHTS || fifo_room);
row_result = (c_acc + (((pr0 + pr1) + (pr2 + pr3)) + ((pr4 + pr5) + (pr6 + pr7)))) & 2097151;
wpr_now = words_per_row(cols, fmt);
subs_now = subs_of(fmt);
aw_now = act_words_of(cols);
words_total = rows * wpr_now;
wlast_off = words_total - 1;
awlast_off = aw_now - 1;
final_ack = ack && acks == wlast_off;
final_act_ack = ack && acks == awlast_off;
timeout = !progress && quiet >= watchdog;
fq_head_lo = pick64(fir == 0, fq_lo[0], pick64(fir == 1, fq_lo[1], pick64(fir == 2, fq_lo[2], pick64(fir == 3, fq_lo[3], pick64(fir == 4, fq_lo[4], pick64(fir == 5, fq_lo[5], pick64(fir == 6, fq_lo[6], fq_lo[7])))))));
fq_head_hi = pick64(fir == 0, fq_hi[0], pick64(fir == 1, fq_hi[1], pick64(fir == 2, fq_hi[2], pick64(fir == 3, fq_hi[3], pick64(fir == 4, fq_hi[4], pick64(fir == 5, fq_hi[5], pick64(fir == 6, fq_hi[6], fq_hi[7])))))));
push_word = ack && mstate == M_WEIGHTS;
pop_word = fq_count != 0 && cstage == 0 && !y_pending;
pop_go = pop_word && (mstate == M_WEIGHTS || mstate == M_DRAIN);
// The act store read address of the sub-word the NEXT clock processes (the
// registered read lands one clock later): the popped word's sub 0 while the
// pop is taken, sub 0 again through the bubble, sub s + 1 during sub s, and
// the next word's sub 0 on the last one.
act_addr = pick32(cstage <= 1, c_wir * subs_now,
             pick32(cstage == 2, c_wir_q * subs_now,
               pick32(cstage == 4, (c_wir_q * subs_now) + c_sub + 1,
                 pick32(c_sub == subs_now - 1, pick32(c_wir_q == wpr_now - 1, 0, c_wir_q + 1) * subs_now,
                   (c_wir_q * subs_now) + c_sub + 1))));
cons_active = cstage >= 2;
y_fire = cstage == 4 && c_sub == subs_now - 1 && c_wir_q == wpr_now - 1;
drain_done = fq_count == 0 && !cons_active && !y_pending;
dec0 = pick64(fmt == FMT_D5, d5_dec4(hq_lo & M32), b2_dec16(hq_lo));
dec1 = pick64(fmt == FMT_D5, d5_dec4(hq_lo >> 32), b2_dec16(hq_lo >> 32));
dec2 = pick64(fmt == FMT_D5, d5_dec4(hq_hi & M32), b2_dec16(hq_hi));
dec3 = pick64(fmt == FMT_D5, d5_dec4(hq_hi >> 32), b2_dec16(hq_hi >> 32));
dg0 = dec_part(fmt, dec0, dec1, dec2, dec3, 0);
dg1 = dec_part(fmt, dec0, dec1, dec2, dec3, 1);
dg2 = dec_part(fmt, dec0, dec1, dec2, dec3, 2);
dinv = invalid_of(dec0, dec1, dec2, dec3);
pfire = arb == 0 && line_idle && mstate == M_REPORT && rline <= rep_last(rkind);
sfire = arb == 0 && sbuf_full && line_idle && !pfire;
s_idle = !sbuf_full;
ack_seen = ack && mstate != M_CALIB;
rd_phase = mstate == M_DOORBELL || mstate == M_ACTS || mstate == M_WEIGHTS;
ack_stray = ack_seen && !rd_phase;
rp_t = rep_tag(rkind, rline);
rp_a = pick32(rkind == K_HEAD, head_a(cols, rows, magic, rline),
              pick32(rkind == K_RUN, run_a(doorbell_run, run_words, run_max, run_hold, bad_words, aw_stored, runs_done, rline), acks));
rp_b = pick64(rkind == K_HEAD, head_b(lanes_of(fmt), cap, wpr_now, aw_now, poll_div, rline),
              pick64(rkind == K_RUN, run_b(polls, run_cycles, run_cmd, run_wait, cons_stalls, stray_acks, total_bad, rline),
                     time_b(timed_acts, fmt, doorbell_run)));

// calib: ddr3_top o_calib_complete. stall, ack: the arbiter's master-1 port;
// rdata_lo, rdata_hi: bits 63:0 and 127:64 of the acknowledged word. cols:
// columns per row (a multiple of the word lanes); rows >= 1; fmt 0 baseline2,
// 1 dense5; waddr, aaddr, daddr: word addresses of the weights, activations
// and doorbell; magic: the doorbell's top half; cap >= 1: requests outstanding
// at most; watchdog >= 1: clocks without a request taken or an ack after which
// a phase gives up; poll_div >= 1: doorbell polls at most once every poll_div
// clocks. line_idle: the emitter's.
// serial_reads/read_gap: original workaround true/8, pipelined false/0.
// defer_results: buffer rows (1..4096) until the timed phase ends. cap is 1..4,
// cols <= 7168; unsupported shapes do not consume a doorbell.
// compute_pipeline: overlap eight-lane products with the prior subgroup sum.
fn on_clock(calib: bool, stall: bool, ack: bool, rdata_lo: u64, rdata_hi: u64,
            cols: u32, rows: u32, fmt: u32, waddr: u32, aaddr: u32, daddr: u32, magic: u32,
            cap: u32, watchdog: u32, poll_div: u32, line_idle: bool,
            serial_reads: bool, read_gap: u32, defer_results: bool, compute_pipeline: bool,
            s_go: bool, s_tag: u32, s_a: u32, s_b: u64) {
    if (req_gap != 0) { req_gap = req_gap - 1; }
    if (ack_seen) { all_acks = all_acks + 1; }
    if (ack_stray) { stray_acks = stray_acks + 1; }

    if (mstate == M_CALIB) {
        if (calib) {
            calib_clocks = cycles;
            runs_done = 0;
            total_bad = 0;
            polls = 0;
            stray_acks = 0;
            rkind = K_HEAD;
            rline = 0;
            wb_cyc = true;
            mstate = M_REPORT;
        }
    } else if (mstate == M_POLL) {
        if (poll_wait == 0) {
            wb_addr = daddr;
            wb_stb = true;
            outst = 0;
            acks = 0;
            quiet = 0;
            mstate = M_DOORBELL;
        } else {
            poll_wait = poll_wait - 1;
        }
    } else if (mstate == M_DOORBELL) {
        // One request: after it is taken the strobe drops until the ack (a held
        // strobe with stall low would hand the memory the same request again,
        // one per clock, as the pipelined contract reads it).
        if (accept) { wb_stb = false; }
        if (ack) {
            polls = polls + 1;
            wb_stb = false;
            poll_wait = poll_div;
            req_gap = read_gap;
            if ((rdata_lo >> 32) == (magic as u64) && (rdata_lo & M32) != 0
                && (rdata_lo & M32) != (last_run as u64) && wpr_now != 0
                && cols <= 7168 && rows != 0 && cap != 0 && cap <= 4
                && (!defer_results || rows <= 4096)) {
                doorbell_run = (rdata_lo & M32) as u32;
                // Tick reads see the old register value. Remember the actual
                // descriptor here, or the same doorbell is accepted twice.
                last_run = (rdata_lo & M32) as u32;
                aw_stored = 0;
                bad_words = 0;
                cons_stalls = 0;
                wb_addr = aaddr;
                wb_stb = can_issue && req_gap == 0;
                outst = 0;
                acks = 0;
                issue_done = false;
                quiet = 0;
                phase_clocks = 0;
                run_cmd = 0;
                run_wait = 0;
                run_hold = 0;
                run_max = 0;
                timed_acts = true;
                mstate = M_ACTS;
            } else {
                mstate = M_POLL;
            }
        }
    } else if (mstate == M_ACTS) {
        if (wb_stb && stall) { run_cmd = run_cmd + 1; }
        if (outst != 0 && !ack) { run_wait = run_wait + 1; }
        if (!wb_stb && !issue_done) { run_hold = run_hold + 1; }
        if (outst > run_max) { run_max = outst; }
        if (accept) {
            if (wb_addr == aaddr + awlast_off) {
                wb_stb = false;
                issue_done = true;
            } else {
                wb_addr = wb_addr + 1;
                wb_stb = !serial_reads && can_issue && req_gap == 0;
            }
        } else if (!wb_stb && !issue_done) {
            wb_stb = can_issue && req_gap == 0;
        }
        outst = out_next;
        if (ack) { acks = acks + 1; req_gap = read_gap; }
        if (progress) { quiet = 0; } else { quiet = quiet + 1; }
        phase_clocks = phase_clocks + 1;
        if (final_act_ack) {
            // The weight phase starts clean: one request stream, one FIFO.
            issue_done = false;
            outst = 0;
            acks = 0;
            quiet = 0;
            phase_clocks = 0;
            run_words = 0;
            run_cycles = 0;
            run_cmd = 0;
            run_wait = 0;
            run_hold = 0;
            run_max = 0;
            fq_count = 0;
            fir = 0;
            fow = 0;
            cstage = 0;
            c_wir = 0;
            c_sub = 0;
            c_row = 0;
            c_words = 0;
            c_acc = 0;
            y_pending = false;
            result_index = 0;
            result_stage = 0;
            wb_addr = waddr;
            wb_stb = can_issue && req_gap == 0;
            timed_acts = false;
            mstate = M_WEIGHTS;
        } else if (timeout) {
            wb_stb = false;
            issue_done = false;
