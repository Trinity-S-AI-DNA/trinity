            rline = 0;
            mstate = M_REPORT;
        }
    } else if (mstate == M_WEIGHTS) {
        if (wb_stb && stall) { run_cmd = run_cmd + 1; }
        if (outst != 0 && !ack) { run_wait = run_wait + 1; }
        if (!wb_stb && !issue_done) { run_hold = run_hold + 1; }
        if (outst > run_max) { run_max = outst; }
        if (accept) {
            if (wb_addr == waddr + wlast_off) {
                wb_stb = false;
                issue_done = true;
            } else {
                wb_addr = wb_addr + 1;
                // cap_room uses the post-take/post-ack count. A presented
                // request stays asserted while stalled, including its address.
                wb_stb = !serial_reads && can_issue && req_gap == 0;
            }
        } else if (!wb_stb && !issue_done) {
            wb_stb = can_issue && req_gap == 0;
        }
        outst = out_next;
        if (ack) { acks = acks + 1; req_gap = read_gap; }
        if (progress) { quiet = 0; } else { quiet = quiet + 1; }
        phase_clocks = phase_clocks + 1;
        run_cycles = phase_clocks;
        if (fq_count == 0 && cstage == 0 && !issue_done) { cons_stalls = cons_stalls + 1; }
        if (final_ack) {
            run_words = acks + 1;
            drain = 0;
            mstate = M_DRAIN;
        } else if (timeout) {
            wb_stb = false;
            wb_cyc = false;
            issue_done = false;
            poll_wait = poll_div;
            rkind = K_TIME;
            rline = 0;
            mstate = M_REPORT;
        }
    } else if (mstate == M_DRAIN) {
        // Include the consumer's tail, not just the final memory ack. Deferred
        // Y emission below begins after this counter is frozen.
        phase_clocks = phase_clocks + 1;
        if (drain_done) {
            if (drain == DRAIN_CLOCKS) {
                run_cycles = phase_clocks + 1;
                // Counted here, before the report phase: the z line's value is
                // read at its tick's start, so an update on the z line's own
                // clock would reach the line one run late.
