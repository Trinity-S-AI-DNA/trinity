fn d5t5(w: u64) -> u64 {
    var t: u64 = 4160750079;
    if (w == 1) { t = 2143289359; }
    if (w == 2) { t = 66977792; }
    if (w == 3) { t = 2093056; }
    if (w == 4) { t = 65408; }
    if (w == 5) { t = 3758098428; }
    if (w == 6) { t = 4278190143; }
    if (w == 7) { t = 1; }
    return t;
}

fn d5t6(w: u64) -> u64 {
    var t: u64 = 0;
    if (w == 1) { t = 4290772992; }
    if (w == 2) { t = 131071; }
    if (w == 3) { t = 0; }
    if (w == 4) { t = 4294967168; }
    if (w == 5) { t = 3; }
    if (w == 6) { t = 4278190080; }
    if (w == 7) { t = 524287; }
