module TrinityFpgaDdr3MatvecT27;

// Device matvec of issue #64 (consumer (B) of #65's measurement): rows of a
// stage-1 layer chunk streamed from DDR3 through the decode pipeline of the #62
// reader, dotted column-exact against int8 activations held in a block-RAM
// store, one Y line per row. Weights and activations reach DDR3 through the #63
// UART loader (master 0 of fpga_wb_arbiter.t27); this module is master 1 and
// reads only. Wired by fpga/ax7203/ddr3/tms_ddr3_matvec_ax7203.v (make ...
// DDR3_APP=matvec). tools/matvec_device_model.py states the doorbell, the
// layout and every result in Python; tests/test_ddr3_matvec.py checks the
// functions in C against that model and the whole module in Icarus against a
// behavioural Wishbone memory, on the stage-1 chunk of the q_proj golden
// accumulators (reports/ternary-check/matvec-2026-09-23.json).
//
// Doorbell: the host loads a descriptor word at word address `daddr` with the
// loader ('L' frames): bits 63:32 = `magic`, bits 31:0 = the run counter. After
// calibration the module reads the doorbell every `poll_div` controller clocks
// (one request, counted as a poll); a word whose top half equals `magic` and
// whose run counter is nonzero and differs from the last run taken starts a
// run. Nothing else is read from the line: no loader protocol change, and the
// polls show in the arbiter's switch counters.
//
// Layout (cols must be a multiple of the word lanes: 64 baseline2, 80 dense5 —
// 2560 satisfies both; down_proj's 6912 is baseline2 only, and words_per_row
// returns 0 for the rest, which stops the run before any request): the weights
// region holds rows * words_per_row words of the chunk's TMEM device-code
// stream, row r at waddr + r * words_per_row; the activations region at aaddr
// holds ceil(cols / 16) words of int8 columns, column c at byte c.
//
// A run reads the activation words into the act store first (one u64 pair per
// ack, 896 u64 = 7168 columns, words_per_row * rows / 8 of them used), then
// streams the weight words through the #62 burst reader (a request taken on a
// clock with stb and not stall, at most `cap` outstanding, never withdrawn)
// into an eight-word FIFO, and presents a request only while the FIFO plus the
// requests outstanding leave room (fq_count + outstanding < 5, so the acks of
// everything already outstanding — at most cap = 4 — can land and push before
// the presented request is taken, and the FIFO still holds: 4 + 4 = 8). Consumer (B) pops a
// word, decodes the four 32-bit chunks with the reader's decoders (dg0..dg2,
// 80 dense5 or 64 baseline2 lanes) and then takes one sub-word of eight lanes
// every two clocks in the reference mode (one clock with compute_pipeline):
// the lanes are dotted against eight sign-extended activation
// bytes of one act store word, the products accumulated into the row
// accumulator in wrapping u32 (exact two's complement: |acc| <= cols * 128 <=
// 917,504, inside the signed 21-bit result), and the last word of a row flushes the
// accumulator as a Y line — in the original mode the consumer holds until the emitter has taken it,
// which is the matvec's backpressure (a Y line takes about 1.7 ms at 115200
// baud; a 40-word row takes about 480 clocks). The act store word of a
// sub-word is read one clock ahead (act_rd), so a popped word spends one
// bubble clock before its first sub-word. A word with an invalid group
// (baseline2 lane 11, dense5 code 243-255) counts in bad words; its lanes
// still enter the dot, as the decoders read them.
// With defer_results, up to 4096 row results are buffered in block RAM and
// emitted only after computation drains. This isolates the timed interval
// from UART Y-line latency. The default board mode remains serial reads with
// an eight-clock gap and immediate output, for a measured baseline.
//
// Counters of a run (the reader's names where the same thing is counted):
//   cycles        weight phase through consumer drain, including DRAIN_CLOCKS;
//                 activation prefetch and deferred Y emission are excluded.
//                 Older builds stopped at the last ack, before the consumer tail.
//   words         acks of the weight phase (rows * words_per_row by construction)
//   command stalls clocks with a request presented and o_wb_stall high
//   wait stalls   clocks with a request outstanding and no ack
//   consumer stalls clocks the consumer was idle with the FIFO empty in the weight phase
//   max outstanding, cap holds: as the reader
//   bad words     words with an invalid group
//   polls, act words, stray acks (since calibration): the doorbell evidence
//
// Report lines (tag, a 32 bits, b 40 bits) on the module's own emitter:
//   q a=cols   b=(MATVEC_FORMAT << 32) | (byte lanes << 24) | cap        (after calib)
//   k a=rows   b=(words per row << 32) | act words
//   v a=magic  b=poll_div
// then per run, after its weight phase has drained:
//   d a=run    b=polls since calibration
//   c a=words  b=cycles
//   o a=max outstanding   b=command stalls
//   w a=cap holds         b=wait stalls
//   n a=bad words         b=consumer stalls
//   u a=act words of the run   b=stray acks since calibration
//   z a=runs done   b=bad words over all runs
// and one Y line per row while the weights stream:
//   y a=row    b=accumulator (64-bit two's complement, low 40 bits)
// On a timeout (watchdog clocks without a taken request or an ack in the acts
// or weights phase) the run stops with
//   t a=acks of the open phase   b=(acts phase << 36) | (format << 32) | run
// and the module returns to the doorbell (the host retries by bumping the
// counter). As in fpga_ddr3_reader.t27, the module-level assignments are not
// lowered by the pinned gen-c: the functions are checked in C against the
// model and the module in Icarus.
const M_CALIB: u32 = 0;
const M_POLL: u32 = 1;
const M_DOORBELL: u32 = 2;
const M_ACTS: u32 = 3;
const M_WEIGHTS: u32 = 4;
const M_DRAIN: u32 = 5;
const M_REPORT: u32 = 6;
const M_RESULTS: u32 = 7;

const K_HEAD: u32 = 0;
const K_RUN: u32 = 1;
const K_TIME: u32 = 2;

const A_IDLE: u32 = 0;
const A_START: u32 = 1;
const A_WAIT: u32 = 2;

const FMT_B2: u32 = 0;
const FMT_D5: u32 = 1;
const DRAIN_CLOCKS: u32 = 12;
// serial_reads/read_gap select the existing board workaround (true/8) or
// the experimental pipelined path (false/0). The separate direct reader has
// already passed pipelined reads; the integrated board failure needs its own
// reproduction. Defaults are bound by the board top, not inferred here.
const ACT_WORDS: u32 = 896;
const FIFO_WORDS: u32 = 8;
const MATVEC_FORMAT: u64 = 1;
const B40: u64 = 1099511627775;
const M32: u64 = 4294967295;
const PAIRS32: u64 = 1431655765;
const TAG_Q: u32 = 113;
const TAG_K: u32 = 107;
const TAG_V: u32 = 118;
const TAG_D: u32 = 100;
const TAG_Y: u32 = 121;
const TAG_C: u32 = 99;
const TAG_O: u32 = 111;
const TAG_W: u32 = 119;
const TAG_N: u32 = 110;
const TAG_U: u32 = 117;
const TAG_T: u32 = 116;
const TAG_Z: u32 = 122;

// Sequencer.
var mstate: u32 = 0;
var cycles: u64 = 0;
var calib_clocks: u64 = 0;
var last_run: u32 = 4294967295;
var doorbell_run: u32 = 0;
var poll_wait: u32 = 0;
var polls: u64 = 0;
var drain: u32 = 0;
var rkind: u32 = 0;
var rline: u32 = 0;
var total_bad: u64 = 0;
var runs_done: u32 = 0;

// Wishbone master (to the arbiter) and the phase counters.
var wb_cyc: bool = false;
var wb_stb: bool = false;
var wb_addr: u32 = 0;
var outst: u32 = 0;
var acks: u32 = 0;
var issue_done: bool = false;
var phase_clocks: u64 = 0;
var quiet: u32 = 0;
var req_gap: u32 = 0;
var run_words: u32 = 0;
var run_cycles: u64 = 0;
var run_cmd: u64 = 0;
var run_wait: u64 = 0;
var run_hold: u32 = 0;
var run_max: u32 = 0;
var bad_words: u32 = 0;
var cons_stalls: u64 = 0;
var timed_out: bool = false;
var timed_acts: bool = false;

// Acks since calibration: all of them, and those outside every read phase.
var all_acks: u64 = 0;
var stray_acks: u32 = 0;

// Act store: 896 u64 halves (7168 int8 columns), two arrays of write and
// read half words (one write and one read port each, block-RAM-mapped).
var acts_lo: [448]u64;
var acts_hi: [448]u64;

var act_rd: u64 = 0;
var aw_stored: u32 = 0;

// Weight FIFO of acknowledged words, eight entries.
var fq_lo: [8]u64;
var fq_hi: [8]u64;
var act_addr: u32;
var fq_count: u32 = 0;
var fir: u32 = 0;
var fow: u32 = 0;

// Consumer: 0 idle/pop, 1 decode, 2 initial extract, 3 products, 4 sum/drain.
// wir is the word in its row; sub is the subgroup whose products are formed.
var cstage: u32 = 0;
var product_valid: bool = false;
var c_wir: u32 = 0;
var c_sub: u32 = 0;
var c_row: u32 = 0;
var c_words: u32 = 0;
var c_acc: u32 = 0;
var c_dg0: u64 = 0;
var c_dg1: u64 = 0;
var c_dg2: u64 = 0;
var c_wir_q: u32 = 0;
var hq_lo: u64;
var hq_hi: u64;    // the popped word, decoded in the bubble clock
var sub_q: u64;             // the current sub-word's lane bits, lifted in their own clock
var pr0: u32; var pr1: u32; var pr2: u32; var pr3: u32;
var pr4: u32; var pr5: u32; var pr6: u32; var pr7: u32;   // lane products, their own clock
var y_pending: bool = false;
var y_row: u32 = 0;
var y_acc: u64 = 0;
// Deferred output holds a chunk's row results until the timed phase ends.
// One registered read and one write port allow block-RAM inference.
var results: [4096]u32;
var result_read: u32 = 0;
var result_index: u32 = 0;
var result_stage: u32 = 0;

fn signed_row(value: u32) -> u64 {
    if ((value & 1048576) != 0) { return (value as u64) | 18446744073707454464; }
    return value as u64;
}

// Decoders of the FIFO head (the reader's chunk decoders). No initial values,
// as dinv: the codegen's initial on a module-level comb variable becomes a
// second driver, and yosys resolves the conflict by tying bits to constant
// zero — 224 conflicts here zeroed every decoded lane group, and the board
// computed y = 0 on all rows while Icarus, without conflict resolution,
// stayed green (AX7203, 2026-09-26).
var dec0: u64;
var dec1: u64;
var dec2: u64;
var dec3: u64;
var dg0: u64;
var dg1: u64;
var dg2: u64;
var dinv: u32;

// Report line arbiter, as in fpga_ddr3_pattern.t27, with the loader's line
// passthrough of the reader's sbuf: a second producer (the loader on the board
// top) parks its line here while the emitter is busy; s_idle is false from the
// request clock until the line has left, so a producer never overwrites one.
var arb: u32 = 0;
var sbuf_full: bool = false;
var sb_tag: u32 = 0;
var sb_a: u32 = 0;
var sb_b: u64 = 0;
var line_go: bool = false;
var line_tag: u32 = 0;
var line_a: u32 = 0;
var line_b: u64 = 0;

fn ones() -> u64 {
    var z: u64 = 0;
    return z - 1;
}

// Dense5 byte -> its five lane codes: truth tables rather than divisions (the
// reader's tables, checked on every code against the codec and the model).
fn d5t0(w: u64) -> u64 {
    var t: u64 = 613566756;
    if (w == 1) { t = 1227133513; }
    if (w == 2) { t = 2454267026; }
    if (w == 3) { t = 613566756; }
    if (w == 4) { t = 1227133513; }
    if (w == 5) { t = 2454267026; }
    if (w == 6) { t = 613566756; }
    if (w == 7) { t = 299593; }
    return t;
}

fn d5t1(w: u64) -> u64 {
    var t: u64 = 1227133513;
    if (w == 1) { t = 2454267026; }
    if (w == 2) { t = 613566756; }
    if (w == 3) { t = 1227133513; }
    if (w == 4) { t = 2454267026; }
    if (w == 5) { t = 613566756; }
    if (w == 6) { t = 1227133513; }
    if (w == 7) { t = 74898; }
    return t;
}

fn d5t2(w: u64) -> u64 {
    var t: u64 = 117670336;
    if (w == 1) { t = 1882725390; }
    if (w == 2) { t = 58835168; }
    if (w == 3) { t = 941362695; }
    if (w == 4) { t = 2176901232; }
    if (w == 5) { t = 470681347; }
    if (w == 6) { t = 3235934264; }
    if (w == 7) { t = 459649; }
