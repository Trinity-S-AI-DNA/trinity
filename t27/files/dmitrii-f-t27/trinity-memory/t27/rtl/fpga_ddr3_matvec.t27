                    poll_wait = poll_div;
                    mstate = M_POLL;
                } else {
                    // A timeout keeps the doorbell run unconsumed only when the
                    // counter moved; otherwise the host bumps it to retry.
                    wb_cyc = true;
                    mstate = M_POLL;
                }
            } else {
                rline = rline + 1;
            }
        }
    }

    // The act store words: written two per activation ack (the low u64 holds
    // the first eight columns, the high u64 the next eight), read one clock
    // ahead. aw_stored counts the words stored and is read before this tick
    // writes it — the acks counter cannot serve: the phase block above writes
    // it in the same tick.
    // Two arrays, one write and one read port each: a single array with two
    // writes and a dynamic-index read per clock maps to no BRAM, and its
    // flip-flop fallback was optimised away entirely on the board build
    // (yosys "Removed 59544 unused cells" — every accumulator read zero;
    // AX7203, 2026-09-26). Icarus keeps the behavioural array, so only the
    // synthesis diverged.
    if (phase_ack) {
        if (mstate == M_ACTS) {
            acts_lo[aw_stored] = rdata_lo;
            acts_hi[aw_stored] = rdata_hi;
            aw_stored = aw_stored + 1;
        }
    }
    act_rd = pick64((act_addr & 1) == 0, acts_lo[act_addr >> 1], acts_hi[act_addr >> 1]);

    // Read-before-write: product_valid describes pr0..pr7 from the preceding
    // clock. In pipeline mode stage 3 produces the next subgroup while the
    // prior products enter the accumulator. Stage 4 drains the last subgroup
    // before publishing the row or popping another word.
    product_valid = product_stage;
    if (compute_pipeline && product_valid && product_stage) {
        c_acc = c_acc + (((pr0 + pr1) + (pr2 + pr3)) + ((pr4 + pr5) + (pr6 + pr7)));
    }
    // Stage 0 pop, 1 decode, 2 initial extract, 3 products, 4 sum/drain.
    if (pop_go) {
        // The popped word is captured raw and decoded in the bubble clock: the
        // FIFO-head mux and the dense5 decoders in one clock spanned 39 ns
        // placed (the board build's routed Fmax fell to 25 MHz once the
        // decoders stopped being conflict-zeroed constants).
        hq_lo = fq_head_lo;
        hq_hi = fq_head_hi;
        c_wir_q = c_wir;
        cstage = 1;
        fir = (fir + 1) % FIFO_WORDS;
    } else if (cstage == 1) {
        // The bubble decodes the popped word into the lane groups.
        c_dg0 = dg0;
        c_dg1 = dg1;
        c_dg2 = dg2;
        if (dinv > 0) { bad_words = bad_words + 1; }
        c_sub = 0;
        cstage = 2;
    } else if (cstage == 2) {
        // The extract clock lifts sub-word 0's sixteen lane bits out of the
        // groups on its own: the selection and the dot in one clock was the
        // routed critical path.
        sub_q = sub_lane_bits(0, c_dg0, c_dg1, c_dg2);
        cstage = 3;
    } else if (product_stage) {
        // The product clock: eight lane products off the extracted half word,
        // no carry chains (the products are selection muxes of sign-extended
        // bytes). The adder tree gets its own clock below.
        pr0 = dot_one(sub_q, act_rd, 0);
        pr1 = dot_one(sub_q, act_rd, 1);
        pr2 = dot_one(sub_q, act_rd, 2);
        pr3 = dot_one(sub_q, act_rd, 3);
        pr4 = dot_one(sub_q, act_rd, 4);
        pr5 = dot_one(sub_q, act_rd, 5);
        pr6 = dot_one(sub_q, act_rd, 6);
        pr7 = dot_one(sub_q, act_rd, 7);
        if (compute_pipeline && c_sub != subs_now - 1) {
            sub_q = sub_lane_bits(c_sub + 1, c_dg0, c_dg1, c_dg2);
            c_sub = c_sub + 1;
        } else {
            cstage = 4;
        }
    } else if (cstage == 4) {
        // The sum clock: the eight-product adder tree alone.
        c_acc = c_acc + (((pr0 + pr1) + (pr2 + pr3)) + ((pr4 + pr5) + (pr6 + pr7)));
        sub_q = sub_lane_bits(c_sub + 1, c_dg0, c_dg1, c_dg2);
        if (c_sub == subs_now - 1) {
            if (y_fire) {
                if (defer_results) {
                    results[c_row] = row_result;
                } else {
                    y_pending = true;
                    y_row = c_row;
                    y_acc = signed_row(row_result);
                }
                c_row = c_row + 1;
                c_wir = 0;
                c_acc = 0;
            } else {
                c_wir = c_wir_q + 1;
            }
            c_words = c_words + 1;
            cstage = 0;
        } else {
            c_sub = c_sub + 1;
            cstage = 3;
        }
    }
    if (push_word) {
        fq_lo[fow] = rdata_lo;
        fq_hi[fow] = rdata_hi;
        fow = (fow + 1) % FIFO_WORDS;
    }
    // The FIFO count has exactly one write per clock: a pop and a push in the
    // same tick must net zero, and two writes to one register in a tick would
    // keep only the last one.
    fq_count = fq_count + pick32(push_word, 1, 0) - pick32(pop_go, 1, 0);

    // Report line arbiter: the loader's parked line first, then a pending Y
    // line, then the phase report.
    line_go = false;
    if (s_go) {
        sbuf_full = true;
        sb_tag = s_tag;
        sb_a = s_a;
        sb_b = s_b;
    }
    if (arb == 0) {
        if (sfire) {
            line_go = true;
            line_tag = sb_tag;
            line_a = sb_a;
            line_b = sb_b;
            sbuf_full = false;
            arb = A_START;
        } else if (line_idle && y_pending) {
            line_go = true;
            line_tag = TAG_Y;
            line_a = y_row;
            line_b = y_acc & B40;
            y_pending = false;
            arb = A_START;
        } else if (pfire && !y_pending) {
            line_go = true;
            line_tag = rp_t;
            line_a = rp_a;
            line_b = rp_b;
            arb = A_START;
        }
    } else if (arb == A_START) {
        arb = A_WAIT;
    } else {
        if (line_idle) { arb = 0; }
    }
    cycles = cycles + 1;
}

test words_per_row_alignment {
    assert_eq(words_per_row(2560, 0), 40);
    assert_eq(words_per_row(2560, 1), 32);
    assert_eq(words_per_row(6912, 0), 108);
    assert_eq(words_per_row(6912, 1), 0);
    assert_eq(words_per_row(2559, 0), 39);
    assert_eq(words_per_row(2559, 1), 0);
}
test act_words {
    assert_eq(act_words_of(2560), 160);
    assert_eq(act_words_of(6912), 432);
    assert_eq(act_words_of(1), 1);
}
test sub_words_per_word {
    assert_eq(subs_of(0), 8);
    assert_eq(subs_of(1), 10);
}
test sign_extension_of_activation_bytes {
    assert_eq(act_ext(255, 0), 18446744073709551615);
    assert_eq(act_ext(127, 0), 127);
    assert_eq(act_ext(32768, 1), 18446744073709551488);
}
test dot_sub_matches_the_reference {
    // Lanes +1,-1,0,+1,+1,-1,0,+1 (bits 0,3,6,8,11,14 -- dg0's low half word)
    // against 1,-1,-128,127,0,-128,1,-1 -> 1+1+127+128-1 = 256.
    assert_eq(dot_sub(sub_lane_bits(0, 18761, 0, 0), 18375108694275849985), 256);
    // The same lanes addressed as sub-word 2: dg0 bits 32..47.
    assert_eq(dot_sub(sub_lane_bits(2, 18761 << 32, 0, 0), 18375108694275849985), 256);
}
endmodule
