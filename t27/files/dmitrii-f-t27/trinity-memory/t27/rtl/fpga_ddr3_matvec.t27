            y_row = result_index;
            y_acc = signed_row(result_read);
            result_stage = 2;
        } else if (result_stage == 2 && !y_pending) {
            if (result_index == rows - 1) {
                mstate = M_REPORT;
            } else {
                result_index = result_index + 1;
