fn d5t9(w: u64) -> u64 {
    var t: u64 = 4294967295;
    if (w == 1) { t = 4294967295; }
    if (w == 2) { t = 131071; }
    if (w == 3) { t = 0; }
    if (w == 4) { t = 0; }
    if (w == 5) { t = 0; }
    if (w == 6) { t = 0; }
    if (w == 7) { t = 0; }
