    var t: u64 = 133955584;
    if (w == 1) { t = 4186112; }
    if (w == 2) { t = 130816; }
    if (w == 3) { t = 3221229560; }
    if (w == 4) { t = 4261412991; }
    if (w == 5) { t = 535822339; }
    if (w == 6) { t = 16744448; }
