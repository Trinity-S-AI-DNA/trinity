module TrinityFp8E4m3DecodeT27;

// OCP FP8 E4M3FN (torch.float8_e4m3fn, ml_dtypes float8_e4m3fn): 1 sign bit,
// 4 exponent bits with bias 7, 3 mantissa bits, no infinities, one NaN pattern
// per sign (S.1111.111), largest finite 448.0, smallest subnormal 2^-9.
// Returns the IEEE-754 binary32 bit pattern of the code's exact value.
// Every E4M3 value is exact in binary32. NaN decodes to the quiet NaN
// 0x7FC00000 carrying the input sign. No embedded backend-language text.

fn msb3(m: u32) -> u32 {
    if (m >= 4) { return 2; }
    if (m >= 2) { return 1; }
    return 0;
}

fn on_comb(code: u8) -> u32 {
    var c: u32 = code as u32;
    var sign: u32 = (c >> 7) << 31;
    var e: u32 = (c >> 3) & 15;
    var m: u32 = c & 7;
    // Subnormal m * 2^-9 = 1.f * 2^(p-9): binary32 exponent field 118 + p.
    var p: u32 = msb3(m);
    var subnormal: u32 = sign | ((118 + p) << 23) | ((m ^ (1 << p)) << (23 - p));
    // Normal (1 + m/8) * 2^(e-7): binary32 exponent field e + 120.
    var normal: u32 = sign | ((e + 120) << 23) | (m << 20);
    if (e == 15) {
        if (m == 7) { return sign | 2143289344; }
    }
    if (e == 0) {
        if (m == 0) { return sign; }
        return subnormal;
    }
    return normal;
}

test positive_zero { assert_eq(on_comb(0), 0); }
test negative_zero { assert_eq(on_comb(128), 2147483648); }
test one { assert_eq(on_comb(56), 1065353216); }
test minus_one_and_half { assert_eq(on_comb(188), 3217031168); }
test largest_finite { assert_eq(on_comb(126), 1138753536); }
test nan { assert_eq(on_comb(127), 2143289344); }
test negative_nan { assert_eq(on_comb(255), 4290772992); }
test smallest_subnormal { assert_eq(on_comb(1), 989855744); }
test largest_subnormal { assert_eq(on_comb(7), 1012924416); }
test smallest_normal { assert_eq(on_comb(8), 1015021568); }
endmodule
