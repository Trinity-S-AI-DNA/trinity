fn ones() -> u64 {
    var z: u64 = 0;
    return z - 1;
}

// Nine xorshift steps, the bijection of fpga_ddr3_pattern.t27 (tools/ddr3_pattern_model.py lin).
fn lin(x: u64) -> u64 {
    var y: u64 = x;
    y = y ^ (y << 13);
    y = y ^ (y >> 7);
    y = y ^ (y << 17);
    y = y ^ (y << 21);
    y = y ^ (y >> 35);
    y = y ^ (y << 4);
    y = y ^ (y << 9);
    y = y ^ (y >> 29);
    y = y ^ (y << 25);
    return y;
}

fn key_base(seed: u32, pair: u32) -> u64 {
    return ((seed as u64) << 32) | (pair as u64);
}

// Every lane pair 11 of 32 bits read as 00.
fn clean32(x: u64) -> u64 {
    var both: u64 = x & (x >> 1) & PAIRS32;
    return x ^ (both | (both << 1));
}

// Nonlinear, invertible steps before and after lin (bit i xored with an AND of lower
// resp. higher bits).
fn mix(b: u64) -> u64 {
    return b ^ ((b << 3) & (b << 7));
}

fn post(y: u64) -> u64 {
    return y ^ ((y >> 1) & (y >> 2));
}

// The 16 lane codes of block b.
fn raw32(k: u64, b: u32) -> u64 {
    return clean32((k ^ post(lin(mix(b as u64)))) & M32);
}

// Dense5 byte -> its five lane codes (lane i at bits 2i, 2i+1: digit 0 -> 10, 1 -> 00,
// 2 -> 01, digit i = floor(code / 3^i) mod 3, docs/format.md), bit 10 set for an invalid
// code (243-255, lanes 00). Truth tables rather than the divisions of
// t27/rtl/bram_trit_codec.t27: with carry chains allowed, as in the DDR3 flow, yosys builds a
// divider of CARRY4 chains for every / and % (one codec decoder and one encoder of four bytes
// each took 183 CARRY4 and 609 LUTs out of context); with a chain of 243 constant compares
// per byte instead, the reader held 486,935 cells in yosys's first optimisation and the
// out-of-context synthesis ended after 4 minutes without a result. Output bit k of code c
// is bit c mod 32 of word c / 32 of table k (d5t0 .. d5t10, eight u32 words each), so each
// output is a function of the eight code bits. tests/test_ddr3_reader.py checks all 256 codes
// against the codec's C and tools/ddr3_read_model.py.
fn d5t0(w: u64) -> u64 {
    var t: u64 = 613566756;
    if (w == 1) { t = 1227133513; }
    if (w == 2) { t = 2454267026; }
    if (w == 3) { t = 613566756; }
    if (w == 4) { t = 1227133513; }
    if (w == 5) { t = 2454267026; }
    if (w == 6) { t = 613566756; }
    if (w == 7) { t = 299593; }
    return t;
}

