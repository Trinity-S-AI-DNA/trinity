// Native command dispatch and strict JSON trit-array parsing.
// Domain command dispatch is native. Host hooks supply file IO, buffers,
// entropy, sockets and signal waiting; generated modules own all data formats.
module TrinityMemoryCLI {
    fn tm_cli_space(c: u8) -> bool {
        return c == 32 || c == 9 || c == 10 || c == 13;
    }
    fn tm_cli_json_trits(data: []u8, size: usize, values: []i32, capacity: usize) -> i64 {
        var pos: usize = 0;
        while (pos < size && tm_cli_space(data[pos])) { pos = pos + 1; }
        if (pos >= size || data[pos] != 91) { return -1; }
        pos = pos + 1;
        var count: usize = 0;
        var need_value: bool = false;
        while (true) {
            while (pos < size && tm_cli_space(data[pos])) { pos = pos + 1; }
            if (pos >= size) { return -1; }
            if (data[pos] == 93) {
                if (need_value) { return -1; }
                pos = pos + 1;
                while (pos < size && tm_cli_space(data[pos])) { pos = pos + 1; }
                if (pos != size) { return -1; }
                return count as i64;
            }
            var sign: i32 = 1;
            if (data[pos] == 45) { sign = -1; pos = pos + 1; }
            if (pos >= size || data[pos] < 48 || data[pos] > 49) { return -1; }
            if (count >= capacity) { return -2; }
            values[count] = sign * ((data[pos] - 48) as i32);
            count = count + 1;
            pos = pos + 1;
            while (pos < size && tm_cli_space(data[pos])) { pos = pos + 1; }
            if (pos >= size) { return -1; }
            if (data[pos] == 44) { need_value = true; pos = pos + 1; }
            else {
                if (data[pos] != 93) { return -1; }
                need_value = false;
            }
        }
        return -1;
    }
    fn tm_cli_json_encode(values: []i32, count: usize, out: []u8, capacity: usize) -> i64 {
        if (count > 4194304 || capacity < 3 + count * 4) { return -1; }
        var pos: usize = 1;
        var i: usize = 0;
        out[0] = 91;
        while (i < count) {
            if (i > 0) { out[pos] = 44; out[pos + 1] = 32; pos = pos + 2; }
            var value: i32 = values[i];
            if (value < -1 || value > 1) { return -1; }
            if (value == -1) { out[pos] = 45; pos = pos + 1; value = 1; }
            out[pos] = (48 + value) as u8;
            pos = pos + 1;
            i = i + 1;
        }
        out[pos] = 93;
        out[pos + 1] = 10;
        return (pos + 2) as i64;
    }
    fn tm_cli_codec(argument: i32) -> i32 {
        if (tm_os_arg_equal(argument, "baseline2")) { return 0; }
        if (tm_os_arg_equal(argument, "dense5")) { return 1; }
        if (tm_os_arg_equal(argument, "dense17")) { return 2; }
        if (tm_os_arg_equal(argument, "dense22")) { return 3; }
        if (tm_os_arg_equal(argument, "sparse41")) { return 4; }
        if (tm_os_arg_equal(argument, "sparse82")) { return 5; }
        return -1;
    }
    fn tm_cli_copy(value: str, out: []u8, capacity: usize) -> i64 {
        var size: usize = 0;
        while (value[size] != 0) {
            if (size == capacity) { return -1; }
            out[size] = value[size] as u8; size = size + 1;
        }
        return size as i64;
    }
    fn tm_cli_text_equal(value: str, expected: str) -> bool {
        var index: usize = 0;
        while (expected[index] != 0) {
            if (value[index] != expected[index]) { return false; }
            index = index + 1;
        }
        return value[index] == 0;
    }
    fn tm_cli_option(value: str, name: str) -> str {
        var index: usize = 0;
        while (name[index] != 0) {
            if (value[index] != name[index]) { return 0; }
            index = index + 1;
        }
        if (value[index] != 61) { return 0; }
        return &value[index + 1];
    }
    fn tm_cli_codec_text(value: str) -> i32 {
        var codec: i32 = 0;
        while (codec < 6) {
            if (tm_cli_text_equal(value, tm_bridge_codec_name(codec))) { return codec; }
            codec = codec + 1;
        }
        if (tm_cli_text_equal(value, "baseline5")) { return 6; }
        return -1;
    }
    fn tm_cli_quote_arg(writer: *TMJsonWriter, index: i32) -> void {
        var bytes: [4096]u8;
        var size: i64 = tm_cli_copy(tm_os_arg(index), bytes, 4096);
        if (size < 0) { writer.error = -1; return; }
        tm_json_write_quoted(writer, bytes, size as usize);
    }
    fn tm_cli_port_text(value: str) -> i32 {
        var port: i64 = 0;
        if (!tm_cli_i64(value, &port) || port < 0 || port > 65535) { return -1; }
        return port as i32;
    }
    fn tm_cli_url_port(value: str) -> i32 {
        var bytes: [128]u8; var size: i64 = tm_cli_copy(value, bytes, 128);
        if (size < 0) { return -1; }
        return tm_http_url(bytes, size as usize);
    }
    fn tm_cli_tmem_info(data: []u8, size: usize, count: u64) -> i32 {
        var output: *u8 = tm_os_scratch(3, 4096);
        if (!tm_os_allocated()) { return tm_os_error("Allocation failed"); }
        var w: TMJsonWriter; tm_json_writer_init(output, 4096, &w);
        var codec: i32 = data[5] as i32;
        tm_bridge_text(&w, "{\"format\":\"TMEM\",\"version\":1,\"codec\":");
        tm_bridge_literal_string(&w, tm_bridge_codec_name(codec));
        tm_bridge_text(&w, ",\"count\":"); tm_json_write_u64(&w, count);
        tm_bridge_text(&w, ",\"payload_bytes\":"); tm_json_write_u64(&w, (size - 24) as u64);
        tm_bridge_text(&w, ",\"header_bytes\":24,\"container_bytes\":"); tm_json_write_u64(&w, size as u64);
        tm_bridge_text(&w, ",\"payload_bpw\":");
        if (count == 0) { tm_json_write_null(&w); } else { tm_json_write_f64(&w, ((size - 24) as f64) * 8.0 / (count as f64)); }
        tm_bridge_text(&w, ",\"container_bpw\":");
        if (count == 0) { tm_json_write_null(&w); } else { tm_json_write_f64(&w, (size as f64) * 8.0 / (count as f64)); }
        tm_bridge_text(&w, ",\"crc32\":\"");
        var checksum: u32 = tm_read_u32(data, 20); var digit: usize = 8;
        while (digit > 0) { digit = digit - 1; tm_json_write_byte(&w, tm_bridge_hex_digit(((checksum >> (digit * 4)) & 15) as u8)); }
        tm_bridge_text(&w, "\",\"validated\":true,\"layout\":{\"id\":"); tm_json_write_i64(&w, codec as i64);
        tm_bridge_text(&w, ",\"name\":"); tm_bridge_literal_string(&w, tm_bridge_codec_name(codec));
        tm_bridge_text(&w, ",\"group_size\":"); tm_json_write_u64(&w, tm_group_size(codec) as u64);
        tm_bridge_text(&w, ",\"group_bits\":"); tm_json_write_u64(&w, tm_group_bits(codec) as u64);
        tm_bridge_text(&w, ",\"max_nonzero\":");
        if (codec == 4) { tm_json_write_u64(&w, 1); }
        else { if (codec == 5) { tm_json_write_u64(&w, 2); } else { tm_json_write_null(&w); } }
        tm_bridge_text(&w, "}}\n");
        if (w.error != 0 || tm_os_bytes(output, w.used) != 0) { return tm_os_error("Cannot print metadata"); }
        return 0;
    }
    fn tm_cli_export_hex(values: []i32, count: usize, codec: i32, out: []u8, capacity: usize) -> i64 {
        if (count == 0 || (codec != 1 && codec != 4 && codec != 6)) { return -1; }
        var lanes: usize = 5; var digits: usize = 2;
        if (codec == 4) { lanes = 4; digits = 1; }
        if (codec == 6) { digits = 3; }
        var groups: usize = (count + lanes - 1) / lanes;
        if (groups > capacity / (digits + 1)) { return -2; }
        var index: usize = 0; var written: usize = 0;
        while (index < count) {
            var group: [5]i32 = [0]; var lane: usize = 0;
            while (lane < lanes && index + lane < count) { group[lane] = values[index + lane]; lane = lane + 1; }
            var word: u32 = 0;
            if (codec == 6) {
                lane = 0;
                while (lane < 5) {
                    var trit: u32 = 0;
                    if (group[lane] == 1) { trit = 1; }
                    if (group[lane] == -1) { trit = 2; }
                    if (group[lane] < -1 || group[lane] > 1) { return -1; }
                    word = word | (trit << (lane * 2)); lane = lane + 1;
                }
            } else {
                var encoded: [1]u8 = [0];
                if (tm_encode(codec, group, lanes, encoded, 1) < 0) { return -1; }
                word = encoded[0] as u32;
            }
            var digit: usize = digits;
            while (digit > 0) {
                digit = digit - 1;
                out[written] = tm_bridge_hex_digit(((word >> (digit * 4)) & 15) as u8); written = written + 1;
            }
            out[written] = 10; written = written + 1; index = index + lanes;
        }
        return written as i64;
    }
    // kind: pack0, unpack1, inspect2, export-rtl3, tensor-pack4,
    // tensor-unpack5, tensor-inspect6. Paths may surround --codec.
    fn tm_cli_file_command(argc: i32, kind: i32) -> i32 {
        var input: i32 = -1; var output: i32 = -1; var codec: i32 = 1;
        var index: i32 = 2; var options: bool = true;
        while (index < argc) {
            var inline_codec: str = tm_cli_option(tm_os_arg(index), "--codec");
            if (options && tm_os_arg_equal(index, "--")) { options = false; index = index + 1; }
            else {
                if (options && (inline_codec != 0 || tm_os_arg_equal(index, "--codec"))) {
                    if (kind != 0 && kind != 3) { return tm_os_usage(); }
                    if (inline_codec == 0) {
                        if (index + 1 >= argc) { return tm_os_usage(); }
                        inline_codec = tm_os_arg(index + 1); index = index + 1;
                    }
                    codec = tm_cli_codec_text(inline_codec);
                    if (codec < 0 || (kind == 0 && codec == 6) || (kind == 3 && codec != 1 && codec != 4 && codec != 6)) { return tm_os_error("Unknown codec"); }
                    index = index + 1;
                } else {
                    var path: str = tm_os_arg(index);
                    if (options && path[0] == 45) { return tm_os_usage(); }
                    if (input < 0) { input = index; }
                    else { if (output < 0) { output = index; } else { return tm_os_usage(); } }
                    index = index + 1;
                }
            }
        }
        var inspect: bool = kind == 2 || kind == 6;
        if (input < 0 || (inspect && output >= 0) || (!inspect && output < 0)) { return tm_os_usage(); }
        var size: i64 = tm_os_read(input, 67108864);
        if (size < 0) { return tm_os_error("Cannot read input (64 MiB limit)"); }
        var data: *u8 = tm_os_input();
        var values: *i32 = tm_os_values(4194304);
        if (!tm_os_allocated()) { return tm_os_error("Allocation failed"); }
        if (kind >= 4) {
            var workspace_size: usize = size as usize;
            if (kind != 4 || workspace_size < 1048576) { workspace_size = 1048576; }
            var work: *TMTPJSONWorkspace = tm_os_tensor_workspace(workspace_size);
            var out: *u8 = tm_os_output(68157472);
            var metadata: *u8 = tm_os_scratch(3, 1048576);
            if (work == 0 || out == 0 || metadata == 0 || !tm_os_allocated()) { return tm_os_error("Allocation failed"); }
            var length: i64 = 0;
            if (kind == 4) {
                length = tm_tp_encode_input_json(data, size as usize, work, values, 4194304, metadata, 1048576, out, 68157472);
            } else {
                if (kind == 5) { length = tm_tp_export_json(data, size as usize, work, values, 4194304, 4194304, out, 68157472); }
                else { length = tm_tp_inspect_json(data, size as usize, work, 4194304, out, 68157472); }
            }
            if (length < 0) { return tm_os_error("Invalid TensorPack, tensor JSON, or configured capacity exceeded"); }
            if (kind == 6) { if (tm_os_bytes(out, length as usize) != 0) { return tm_os_error("Cannot print metadata"); } return 0; }
            if (tm_os_write(output, out, length as usize) != 0) { return tm_os_error("Cannot write output"); }
            if (kind == 4) {
                var info: *u8 = tm_os_scratch(0, 4194304);
                if (!tm_os_allocated()) { return tm_os_error("Allocation failed"); }
                length = tm_tp_inspect_json(out, length as usize, work, 4194304, info, 4194304);
                if (length < 0 || tm_os_bytes(info, length as usize) != 0) { return tm_os_error("Cannot print metadata"); }
            }
            return 0;
        }
        var count: i64 = 0;
        if (kind == 0 || kind == 3) { count = tm_cli_json_trits(data, size as usize, values, 4194304); }
        else { count = tm_unpack(data, size as usize, values, 4194304); }
        if (count < 0) { return tm_os_error("Invalid TMEM or integer trit JSON (4M decoded limit)"); }
        if (kind == 2) { return tm_cli_tmem_info(data, size as usize, count as u64); }
        var out_capacity: usize = 3 + (count as usize) * 4;
        if (kind == 0) { var payload: i64 = tm_payload_size(codec, count as u64); if (payload < 0) { return tm_os_error("Invalid payload size"); } out_capacity = (payload + 24) as usize; }
        var out: *u8 = tm_os_output(out_capacity);
        if (!tm_os_allocated()) { return tm_os_error("Allocation failed"); }
        var length: i64 = 0;
        if (kind == 0) { length = tm_pack(codec, values, count as usize, out, out_capacity); }
        if (kind == 1) { length = tm_cli_json_encode(values, count as usize, out, out_capacity); }
        if (kind == 3) { length = tm_cli_export_hex(values, count as usize, codec, out, out_capacity); }
        if (length < 0) { return tm_os_error("Input rejected by codec/export policy"); }
        if (tm_os_write(output, out, length as usize) != 0) { return tm_os_error("Cannot write output"); }
        if (kind == 0) { return tm_cli_tmem_info(out, length as usize, count as u64); }
        if (kind == 1) { tm_os_text("Decoded "); tm_os_integer(count); tm_os_text(" trits\n"); }
        if (kind == 3) { tm_os_text("Exported RTL words; set the RTL logical weight count separately\n"); }
        return 0;
    }
    fn tm_cli_rpc(port: i32, method: str, params: []u8, params_size: usize,
                  work: *TMRPCWorkspace, reply: *TMRPCReply) -> i32 {
        var method_bytes: [64]u8; var method_size: i64 = tm_cli_copy(method, method_bytes, 64);
        if (method_size < 0) { return -32602; }
        var id: [32]u8;
        if (tm_rpc_random_id(id) != 0) { return -32000; }
        var request: *u8 = tm_os_scratch(1, 2097152);
        var response: *u8 = tm_os_scratch(2, 4194304);
        if (request == 0 || response == 0 || !tm_os_allocated()) { return -32010; }
        var size: i64 = tm_rpc_prepare(method_bytes, method_size as usize, params, params_size, id, request, 2097152, work);
        if (size < 0) { return size as i32; }
        size = tm_runtime_http(port, 5.0, request, size as usize, response, 4194304);
        if (size < 0) { return -32000; }
        return tm_rpc_validate(response, size as usize, id, work, reply);
    }
    fn tm_cli_rpc_error(status: i32, work: *TMRPCWorkspace, reply: *TMRPCReply) -> i32 {
        if (status == 1) {
            var error: *u8 = tm_os_scratch(0, 4096);
            if (!tm_os_allocated()) { return tm_os_error("Allocation failed"); }
            var writer: TMJsonWriter; tm_json_writer_init(error, 4096, &writer);
            tm_json_write_tree(&writer, work.tokens, work.token_count, reply.error_index);
            if (writer.error == 0) { return tm_os_error_bytes(error, writer.used); }
        }
        return tm_os_error("RPC transport, request, or response validation failed");
    }
    // kind: upload0, download1, dot2. All RPC operations use real loopback HTTP.
    fn tm_cli_remote_command(argc: i32, kind: i32) -> i32 {
        var args: [3]i32 = [-1, -1, -1]; var count: usize = 0;
        var url: str = "http://127.0.0.1:8787"; var index: i32 = 2; var options: bool = true;
        while (index < argc) {
            var inline_url: str = tm_cli_option(tm_os_arg(index), "--url");
            if (options && tm_os_arg_equal(index, "--")) { options = false; index = index + 1; }
            else {
                if (options && (inline_url != 0 || tm_os_arg_equal(index, "--url"))) {
                    if (inline_url == 0) {
                        if (index + 1 >= argc) { return tm_os_usage(); }
                        inline_url = tm_os_arg(index + 1); index = index + 1;
                    }
                    url = inline_url; index = index + 1;
                } else {
                    var argument: str = tm_os_arg(index);
                    if (count >= 3 || (options && argument[0] == 45)) { return tm_os_usage(); }
                    args[count] = index; count = count + 1; index = index + 1;
                }
            }
        }
        if (count != (kind + 1) as usize) { return tm_os_usage(); }
        var port: i32 = tm_cli_url_port(url);
        if (port < 1) { return tm_os_error("URL must be a plain loopback HTTP endpoint with an explicit port"); }
        var params: *u8 = tm_os_scratch(0, 2097152);
        var output: *u8 = tm_os_output(4194304);
        var work: *TMRPCWorkspace = tm_os_rpc_workspace(4194304);
        if (params == 0 || output == 0 || work == 0 || !tm_os_allocated()) { return tm_os_error("Allocation failed"); }
        var writer: TMJsonWriter; tm_json_writer_init(params, 2097152, &writer);
        var method: str = "memory.upload";
        if (kind == 0) {
            var size: i64 = tm_os_read(args[0], 67108864);
            if (size < 0) { return tm_os_error("Cannot read upload input"); }
            var data: *u8 = tm_os_input();
            tm_bridge_text(&writer, "{\"data\":\""); tm_bridge_b64_encode(&writer, data, size as usize); tm_bridge_text(&writer, "\"}");
        } else {
            tm_bridge_text(&writer, "{\"handle\":"); tm_cli_quote_arg(&writer, args[0]);
            method = "memory.read";
            if (kind == 2) {
                method = "compute.dot";
                var size: i64 = tm_os_read(args[2], 67108864);
                if (size < 0) { return tm_os_error("Cannot read activation JSON"); }
                var data: *u8 = tm_os_input();
                if (tm_rpc_parse(data, size as usize, work) != 0) { return tm_os_error("Invalid activation JSON or parser bounds exceeded"); }
                // Preserve integer JSON types; the Bridge validates signed int8.
                tm_bridge_text(&writer, ",\"tensor_name\":"); tm_cli_quote_arg(&writer, args[1]);
                tm_bridge_text(&writer, ",\"activations\":");
                tm_json_write_tree(&writer, work[0].tokens, work[0].token_count, work[0].root);
            }
            tm_bridge_put(&writer, 125);
        }
        if (writer.error != 0) { return tm_os_error("Request exceeds native bounds or contains invalid text"); }
        var reply: TMRPCReply;
        var status: i32 = tm_cli_rpc(port, method, params, writer.used, work, &reply);
        if (status != 0) { return tm_cli_rpc_error(status, work, &reply); }
        if (kind == 0) {
            var token: i64 = tm_rpc_field(work, reply.result_index, "handle", 6);
            if (token < 0 || work[0].tokens[token].kind != TM_JSON_STRING || work[0].tokens[token].text_size != 32) { return tm_os_error("Invalid upload response handle"); }
            var handle: [32]u8; var byte: usize = 0;
            while (byte < 32) { handle[byte] = work[0].tokens[token].text[byte]; byte = byte + 1; }
            if (!tm_rpc_id_valid(handle)) { return tm_os_error("Invalid upload response handle"); }
            tm_json_writer_init(params, 2097152, &writer);
            tm_bridge_text(&writer, "{\"handle\":"); tm_json_write_quoted(&writer, handle, 32); tm_bridge_put(&writer, 125);
            status = tm_cli_rpc(port, "memory.info", params, writer.used, work, &reply);
            if (status != 0) { return tm_cli_rpc_error(status, work, &reply); }
            tm_json_writer_init(output, 4194304, &writer);
            tm_bridge_text(&writer, "{\"handle\":"); tm_json_write_quoted(&writer, handle, 32);
            tm_bridge_text(&writer, ",\"info\":"); tm_json_write_tree(&writer, work[0].tokens, work[0].token_count, reply.result_index);
            tm_bridge_text(&writer, "}\n");
        } else {
            if (kind == 1) {
                var token: i64 = tm_rpc_field(work, reply.result_index, "data", 4);
                if (token < 0 || work[0].tokens[token].kind != TM_JSON_STRING) { return tm_os_error("Invalid memory.read response"); }
                var size: i64 = tm_bridge_b64_decode(work[0].tokens[token].text, work[0].tokens[token].text_size, output, 4194304);
                if (size < 0) { return tm_os_error("Invalid memory.read base64 data"); }
                if (tm_os_write(args[1], output, size as usize) != 0) { return tm_os_error("Cannot write download output"); }
                return 0;
            }
            tm_json_writer_init(output, 4194304, &writer);
            tm_json_write_tree(&writer, work[0].tokens, work[0].token_count, reply.result_index); tm_json_write_byte(&writer, 10);
        }
        if (writer.error != 0 || tm_os_bytes(output, writer.used) != 0) { return tm_os_error("Cannot print RPC result"); }
        return 0;
    }
    fn tm_cli_serve(argc: i32) -> i32 {
        var port: i32 = 8787; var index: i32 = 2;
        while (index < argc) {
            var value: str = tm_cli_option(tm_os_arg(index), "--port");
            if (value == 0) {
                if (!tm_os_arg_equal(index, "--port") || index + 1 >= argc) { return tm_os_usage(); }
                value = tm_os_arg(index + 1); index = index + 1;
            }
            port = tm_cli_port_text(value); if (port < 0) { return tm_os_error("Invalid server port"); }
            index = index + 1;
        }
        var server: *TMRuntime = tm_runtime_new(port, 2097152, 524288, 8388608, 16, 1000000, 5.0);
        if (server == 0) { return tm_os_error("Cannot allocate Bridge runtime"); }
        if (tm_os_prepare_interrupts() != 0) { tm_runtime_close(server); return tm_os_error("Cannot prepare interrupt handling"); }
        if (tm_runtime_start(server) != 0) { tm_runtime_close(server); return tm_os_error("Cannot start loopback Bridge"); }
        tm_os_text("Trinity Bridge EMULATOR: http://127.0.0.1:"); tm_os_integer(tm_runtime_port(server) as i64);
        tm_os_text("/ (Ctrl-C to stop)\n");
        if (tm_os_flush() != 0) { tm_runtime_close(server); return tm_os_error("Cannot print server URL"); }
        tm_os_wait_for_interrupt(); tm_runtime_close(server); return 0;
    }
    fn tm_cli_i64(value: str, out: *i64) -> bool {
        var index: usize = 0; var negative: bool = false; var number: u64 = 0;
        if (value[0] == 45 || value[0] == 43) { negative = value[0] == 45; index = 1; }
        if (value[index] == 0) { return false; }
        var limit: u64 = 9223372036854775807;
        if (negative) { limit = 0x8000000000000000; }
        while (value[index] != 0) {
            if (value[index] < 48 || value[index] > 57) { return false; }
            var digit: u64 = (value[index] - 48) as u64;
            if (number > (limit - digit) / 10) { return false; }
            number = number * 10 + digit; index = index + 1;
        }
        if (negative) {
            if (number == 0x8000000000000000) { out[0] = -9223372036854775807 - 1; }
            else { out[0] = -(number as i64); }
        } else { out[0] = number as i64; }
        return true;
    }
    // kind: benchmark0, edge-demo1, conformance2. Algorithms live in
    // experiments.t27; path creation and bytes IO are explicit OS operations.
    fn tm_cli_experiments(argc: i32, kind: i32) -> i32 {
        var count: i64 = 65536; var repeats: i64 = 3; var seed: i64 = 27; var rtl: bool = false;
        var output_path: str = "reports/benchmark.json";
        if (kind == 1) { output_path = "build/edge-report.json"; }
        if (kind == 2) { output_path = "build/conformance-report.json"; }
        var html_path: str = "build/edge-report.html"; var vectors_path: str = "examples/conformance.json";
        var index: i32 = 2;
        while (index < argc) {
            if (tm_os_arg_equal(index, "--rtl")) {
                if (kind == 0) { return tm_os_usage(); }
                rtl = true; index = index + 1;
            } else {
                var argument: str = tm_os_arg(index); var flag: i32 = 0; var value: str = 0;
                if (tm_cli_text_equal(argument, "--output") || tm_cli_option(argument, "--output") != 0) { flag = 1; value = tm_cli_option(argument, "--output"); }
                if (tm_cli_text_equal(argument, "--html") || tm_cli_option(argument, "--html") != 0) { flag = 2; value = tm_cli_option(argument, "--html"); }
                if (tm_cli_text_equal(argument, "--vectors") || tm_cli_option(argument, "--vectors") != 0) { flag = 3; value = tm_cli_option(argument, "--vectors"); }
                if (tm_cli_text_equal(argument, "--count") || tm_cli_option(argument, "--count") != 0) { flag = 4; value = tm_cli_option(argument, "--count"); }
                if (tm_cli_text_equal(argument, "--repeats") || tm_cli_option(argument, "--repeats") != 0) { flag = 5; value = tm_cli_option(argument, "--repeats"); }
                if (tm_cli_text_equal(argument, "--seed") || tm_cli_option(argument, "--seed") != 0) { flag = 6; value = tm_cli_option(argument, "--seed"); }
                if (flag == 0 || (flag == 2 && kind != 1) || (flag == 3 && kind != 2) || ((flag == 4 || flag == 5) && kind != 0)) { return tm_os_usage(); }
                if (value == 0) {
                    if (index + 1 >= argc) { return tm_os_usage(); }
                    index = index + 1; value = tm_os_arg(index);
                }
                if (flag == 1) { output_path = value; }
                if (flag == 2) { html_path = value; }
                if (flag == 3) { vectors_path = value; }
                if (flag == 4 && (!tm_cli_i64(value, &count) || count < 1)) { return tm_os_error("Count must be a positive integer"); }
                if (flag == 5 && (!tm_cli_i64(value, &repeats) || repeats < 1)) { return tm_os_error("Repeats must be a positive integer"); }
                if (flag == 6 && !tm_cli_i64(value, &seed)) { return tm_os_error("Seed must fit a signed 64-bit integer"); }
                index = index + 1;
            }
        }
        // RTL seeds are 32-bit (specs/memory/edge_demo.t27: the demo adds the row index,
        // specs/memory/conformance.t27: the full unsigned range); refuse them here with a
        // precise message rather than through the experiment's generic failure.
        if (rtl && kind == 1 && (seed < 0 || seed > 4294967293)) { return tm_os_error("Seed must be in 0..4294967293 for edge-demo --rtl"); }
        if (rtl && kind == 2 && (seed < 0 || seed > 4294967295)) { return tm_os_error("Seed must be in 0..4294967295 for conformance --rtl"); }
        var output: *u8 = tm_os_output(4194304);
        if (!tm_os_allocated()) { return tm_os_error("Allocation failed"); }
        var size: i64 = 0;
        if (kind == 0) { size = tm_exp_benchmark(count as usize, repeats as usize, seed, output, 4194304); }
        if (kind == 1) { size = tm_exp_edge(rtl, seed, output, 4194304); }
        if (kind == 2) {
            var source_size: i64 = tm_os_read_path(vectors_path, 67108864);
            if (source_size < 0) { return tm_os_error("Cannot read conformance vectors"); }
            var source: *u8 = tm_os_input();
            size = tm_exp_conformance(source, source_size as usize, rtl, seed, output, 4194304);
        }
        if (size < 0) { return tm_os_error("Experiment failed validation, tool execution, or native capacity limits"); }
        if (tm_os_write_path(output_path, output, size as usize, true) != 0) { return tm_os_error("Cannot write experiment report"); }
        if (kind == 1) {
            var html: *u8 = tm_os_scratch(3, 4194304);
            if (!tm_os_allocated()) { return tm_os_error("Allocation failed"); }
            var html_size: i64 = tm_report_edge_html(output, size as usize, html, 4194304);
            if (html_size < 0 || tm_os_write_path(html_path, html, html_size as usize, true) != 0) { return tm_os_error("Cannot render/write native Edge HTML report"); }
        }
        tm_os_text("Saved verified native report: "); tm_os_text(output_path); tm_os_text("\n");
        return 0;
    }
    fn tm_cli_main(argc: i32) -> i32 {
        if (argc < 2) { return tm_os_usage(); }
        var help_index: i32 = 1;
        while (help_index < argc && !tm_os_arg_equal(help_index, "--")) {
            if (tm_os_arg_equal(help_index, "--help") || tm_os_arg_equal(help_index, "-h")) { tm_os_usage(); return 0; }
            help_index = help_index + 1;
        }
        if (tm_os_arg_equal(1, "pack")) { return tm_cli_file_command(argc, 0); }
        if (tm_os_arg_equal(1, "unpack")) { return tm_cli_file_command(argc, 1); }
        if (tm_os_arg_equal(1, "inspect")) { return tm_cli_file_command(argc, 2); }
        if (tm_os_arg_equal(1, "export-rtl")) { return tm_cli_file_command(argc, 3); }
        if (tm_os_arg_equal(1, "tensor-pack")) { return tm_cli_file_command(argc, 4); }
        if (tm_os_arg_equal(1, "tensor-unpack")) { return tm_cli_file_command(argc, 5); }
        if (tm_os_arg_equal(1, "tensor-inspect")) { return tm_cli_file_command(argc, 6); }
        if (tm_os_arg_equal(1, "upload")) { return tm_cli_remote_command(argc, 0); }
        if (tm_os_arg_equal(1, "download")) { return tm_cli_remote_command(argc, 1); }
        if (tm_os_arg_equal(1, "dot")) { return tm_cli_remote_command(argc, 2); }
        if (tm_os_arg_equal(1, "serve")) { return tm_cli_serve(argc); }
        if (tm_os_arg_equal(1, "benchmark")) { return tm_cli_experiments(argc, 0); }
        if (tm_os_arg_equal(1, "edge-demo")) { return tm_cli_experiments(argc, 1); }
        if (tm_os_arg_equal(1, "conformance")) { return tm_cli_experiments(argc, 2); }
        return tm_os_usage();
    }
}
