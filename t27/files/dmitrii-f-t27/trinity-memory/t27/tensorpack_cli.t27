// Native TensorPack CLI JSON contracts, independent of file/terminal services.
// Workspace, value buffers and output JSON are caller-owned scratch. Callers
// publish output only after success; no routine allocates or opens a path.
module TrinityMemoryTensorPackCLI {
    fn tm_tpc_allowed_key(token: *TMJsonToken) -> bool {
        return tm_tpj_text(token.text, token.text_size, "name", 4) ||
            tm_tpj_text(token.text, token.text_size, "shape", 5) ||
            tm_tpj_text(token.text, token.text_size, "values", 6) ||
            tm_tpj_text(token.text, token.text_size, "codec", 5) ||
            tm_tpj_text(token.text, token.text_size, "scales", 6) ||
            tm_tpj_text(token.text, token.text_size, "scale_axis", 10) ||
            tm_tpj_text(token.text, token.text_size, "axes", 4);
    }
    fn tm_tp_parse_tensor_json(data: []u8, size: usize, work: *TMTPJSONWorkspace,
                               values: []i32, value_capacity: usize, result: *TMTPValidation) -> i32 {
        var parsed: TMJsonResult = TMJsonResult{ .root = -1, .token_count = 0, .arena_used = 0 };
        var status: i32 = tm_json_parse(data, size, work.tokens, work.token_capacity,
                                      work.arena, work.arena_capacity, 8, &parsed);
        if (status != 0) { return TM_TPJ_ERR_JSON; }
        var tokens: *TMJsonToken = work.tokens;
        var root: i64 = parsed.root;
        if (root < 0 || tokens[root].kind != TM_JSON_ARRAY) { return TM_TPJ_ERR_SCHEMA; }
        var tensor_count: usize = tm_tpj_members(tokens, root);
        if (tensor_count > 1024) { return TM_ERR_LIMIT; }
        if (tensor_count > work.item_capacity) { return TM_ERR_CAPACITY; }
        var shape_used: usize = 0;
        var scale_used: usize = 0;
        var axis_used: usize = 0;
        var total: usize = 0;
        var payload: u64 = 0;
        var entry: i64 = tokens[root].first;
        var i: usize = 0;
        while (entry >= 0) {
            if (tokens[entry].kind != TM_JSON_OBJECT) { return TM_TPJ_ERR_SCHEMA; }
            var key: i64 = tokens[entry].first;
            while (key >= 0) { if (!tm_tpc_allowed_key(&tokens[key])) { return TM_TPJ_ERR_SCHEMA; } key = tokens[key].next; }
            var name: i64 = tm_tpj_field(tokens, entry, "name", 4);
            var shape: i64 = tm_tpj_field(tokens, entry, "shape", 5);
            var content: i64 = tm_tpj_field(tokens, entry, "values", 6);
            var scales: i64 = tm_tpj_field(tokens, entry, "scales", 6);
            var axis: i64 = tm_tpj_field(tokens, entry, "scale_axis", 10);
            var axes: i64 = tm_tpj_field(tokens, entry, "axes", 4);
            var codec: i64 = tm_tpj_field(tokens, entry, "codec", 5);
            if (name < 0 || shape < 0 || content < 0 || tokens[name].kind != TM_JSON_STRING ||
                tokens[shape].kind != TM_JSON_ARRAY || tokens[content].kind != TM_JSON_ARRAY) { return TM_TPJ_ERR_SCHEMA; }
            if ((scales >= 0 && tokens[scales].kind != TM_JSON_ARRAY) ||
                (axes >= 0 && tokens[axes].kind != TM_JSON_ARRAY)) { return TM_TPJ_ERR_SCHEMA; }
            var d: *TMTensorDescriptor = &work.items[i];
            d[0].name = tokens[name].text; d[0].name_size = tokens[name].text_size;
            d[0].codec = 1; if (codec >= 0) { d[0].codec = tm_tpj_codec(&tokens[codec]); }
            d[0].rank = tm_tpj_members(tokens, shape);
            d[0].scale_count = 1; if (scales >= 0) { d[0].scale_count = tm_tpj_members(tokens, scales); }
            d[0].axes_count = 0; if (axes >= 0) { d[0].axes_count = tm_tpj_members(tokens, axes); }
            if (d[0].rank > 16 || d[0].axes_count > 16) { return TM_TP_ERR_SHAPE; }
            if (d[0].rank > work.shape_capacity - shape_used || d[0].scale_count > work.scale_capacity - scale_used ||
                d[0].axes_count > work.axis_capacity - axis_used) { return TM_ERR_CAPACITY; }
            d[0].shape = work.shapes; d[0].scales = work.scales; d[0].axes = work.axes;
            if (shape_used > 0) { d[0].shape = &work.shapes[shape_used]; }
            if (scale_used > 0) { d[0].scales = &work.scales[scale_used]; }
            if (axis_used > 0) { d[0].axes = &work.axes[axis_used]; }
            d[0].scale_axis = -1;
            if (axis >= 0 && tokens[axis].kind != TM_JSON_NULL) {
                if (!tm_tpj_unsigned(&tokens[axis]) || tokens[axis].uinteger > 15) { return TM_TP_ERR_SCALE; }
                d[0].scale_axis = tokens[axis].uinteger as i32;
            }
            var child: i64 = tokens[shape].first;
            while (child >= 0) {
                if (!tm_tpj_unsigned(&tokens[child])) { return TM_TP_ERR_SHAPE; }
                work.shapes[shape_used] = tokens[child].uinteger; shape_used = shape_used + 1; child = tokens[child].next;
            }
            if (scales < 0) { work.scales[scale_used] = 1.0; scale_used = scale_used + 1; }
            else {
                child = tokens[scales].first;
                while (child >= 0) {
                    if (tokens[child].kind != TM_JSON_REAL) { return TM_TP_ERR_SCALE; }
                    work.scales[scale_used] = tokens[child].real; scale_used = scale_used + 1; child = tokens[child].next;
                }
            }
            if (axes >= 0) {
                child = tokens[axes].first;
                while (child >= 0) {
                    if (tokens[child].kind != TM_JSON_STRING) { return TM_TP_ERR_AXES; }
                    work.axes[axis_used].data = tokens[child].text; work.axes[axis_used].size = tokens[child].text_size;
                    axis_used = axis_used + 1; child = tokens[child].next;
                }
            }
            var count: i64 = tm_tp_descriptor_count(d);
            if (count < 0) { return count as i32; }
            if ((count as usize) != tm_tpj_members(tokens, content)) { return TM_TP_ERR_SHAPE; }
            if ((count as usize) > 4194304 - total) { return TM_ERR_LIMIT; }
            if ((count as usize) > value_capacity - total) { return TM_ERR_CAPACITY; }
            var j: usize = 0;
            while (j < i) {
                if (tm_tp_text_equal(d[0].name, d[0].name_size, work.items[j].name, work.items[j].name_size)) { return TM_TP_ERR_DESCRIPTOR; }
                j = j + 1;
            }
            child = tokens[content].first;
            while (child >= 0) {
                if (tokens[child].kind != TM_JSON_INTEGER || tokens[child].uinteger > 1) { return TM_ERR_TRIT; }
                var value: i32 = tokens[child].uinteger as i32;
                if (tokens[child].negative) { value = -value; }
                values[total] = value; total = total + 1; child = tokens[child].next;
            }
            d[0].offset = payload; d[0].length = 24 + (tm_payload_size(d[0].codec, count as u64) as u64);
            payload = payload + d[0].length;
            if (payload > 67108864) { return TM_ERR_LIMIT; }
            i = i + 1; entry = tokens[entry].next;
        }
        result.tensor_count = tensor_count; result.total_trits = total as u64; result.payload_bytes = payload as usize;
        result.framing_valid = false; result.descriptors_valid = true; result.json_binding_valid = true;
        return 0;
    }
    fn tm_tp_encode_input_json(data: []u8, size: usize, work: *TMTPJSONWorkspace,
                               values: []i32, value_capacity: usize, metadata: []u8,
                               metadata_capacity: usize, out: []u8, capacity: usize) -> i64 {
        var validation: TMTPValidation = TMTPValidation{ .tensor_count = 0, .total_trits = 0, .payload_bytes = 0,
            .framing_valid = false, .descriptors_valid = false, .json_binding_valid = false };
        var status: i32 = tm_tp_parse_tensor_json(data, size, work, values, value_capacity, &validation);
        if (status != 0) { return status as i64; }
        return tm_tp_encode_json(work.items, validation.tensor_count, values, validation.total_trits as usize,
                                 metadata, metadata_capacity, out, capacity);
    }
    fn tm_tpc_shape(writer: *TMTPJSONWriter, d: *TMTensorDescriptor) -> void {
        tm_tpj_put(writer, 91); var i: usize = 0;
        while (i < d.rank) { if (i > 0) { tm_tpj_put(writer, 44); } tm_tpj_u64(writer, d.shape[i]); i = i + 1; }
        tm_tpj_put(writer, 93);
    }
    fn tm_tpc_scales(writer: *TMTPJSONWriter, d: *TMTensorDescriptor) -> void {
        tm_tpj_put(writer, 91); var i: usize = 0;
        while (i < d.scale_count) { if (i > 0) { tm_tpj_put(writer, 44); } tm_tpj_float(writer, d.scales[i]); i = i + 1; }
        tm_tpj_put(writer, 93);
    }
    fn tm_tpc_axes(writer: *TMTPJSONWriter, d: *TMTensorDescriptor) -> void {
        tm_tpj_put(writer, 91); var i: usize = 0;
        while (i < d.axes_count) {
            if (i > 0) { tm_tpj_put(writer, 44); }
            tm_tpj_string(writer, d.axes[i].data, d.axes[i].size); i = i + 1;
        }
        tm_tpj_put(writer, 93);
    }
    fn tm_tpc_descriptor_json(writer: *TMTPJSONWriter, d: *TMTensorDescriptor) -> void {
        tm_tpj_z(writer, "{\"name\":"); tm_tpj_string(writer, d.name, d.name_size);
        tm_tpj_z(writer, ",\"shape\":"); tm_tpc_shape(writer, d);
        tm_tpj_z(writer, ",\"codec\":"); tm_tpj_codec_json(writer, d.codec);
        tm_tpj_z(writer, ",\"scales\":"); tm_tpc_scales(writer, d);
        tm_tpj_z(writer, ",\"scale_axis\":");
        if (d.scale_axis == -1) { tm_tpj_z(writer, "null"); } else { tm_tpj_u64(writer, d.scale_axis as u64); }
        tm_tpj_z(writer, ",\"axes\":"); tm_tpc_axes(writer, d);
    }
    fn tm_tp_inspect_json(data: []u8, size: usize, work: *TMTPJSONWorkspace,
                          max_total_trits: u64, out: []u8, capacity: usize) -> i64 {
        var validation: TMTPValidation = TMTPValidation{ .tensor_count = 0, .total_trits = 0, .payload_bytes = 0,
            .framing_valid = false, .descriptors_valid = false, .json_binding_valid = false };
        var status: i32 = tm_tp_bind_json(data, size, work, max_total_trits, &validation);
        if (status != 0) { return status as i64; }
        var writer: TMTPJSONWriter = TMTPJSONWriter{ .data = out, .capacity = capacity, .size = 0, .status = 0 };
        tm_tpj_z(&writer, "{\"format\":\"TensorPack\",\"version\":1,\"order\":\"C\",\"tensor_count\":");
        tm_tpj_u64(&writer, validation.tensor_count as u64);
        tm_tpj_z(&writer, ",\"total_count\":"); tm_tpj_u64(&writer, validation.total_trits);
        tm_tpj_z(&writer, ",\"header_bytes\":32,\"metadata_bytes\":"); tm_tpj_u64(&writer, tm_read_u32(data, 8) as u64);
        tm_tpj_z(&writer, ",\"payload_bytes\":"); tm_tpj_u64(&writer, validation.payload_bytes as u64);
        tm_tpj_z(&writer, ",\"container_bytes\":"); tm_tpj_u64(&writer, size as u64);
        tm_tpj_z(&writer, ",\"validated\":true,\"tensors\":[");
        var i: usize = 0;
        while (i < validation.tensor_count) {
            if (i > 0) { tm_tpj_put(&writer, 44); }
            tm_tpc_descriptor_json(&writer, &work.items[i]);
            tm_tpj_z(&writer, ",\"offset\":"); tm_tpj_u64(&writer, work.items[i].offset);
            tm_tpj_z(&writer, ",\"length\":"); tm_tpj_u64(&writer, work.items[i].length);
            tm_tpj_z(&writer, ",\"count\":"); tm_tpj_u64(&writer, tm_tp_descriptor_count(&work.items[i]) as u64);
            tm_tpj_z(&writer, ",\"payload_bytes\":"); tm_tpj_u64(&writer, work.items[i].length - 24);
            tm_tpj_put(&writer, 125); i = i + 1;
        }
        tm_tpj_z(&writer, "]}\n");
        if (writer.status != 0) { return writer.status as i64; }
        return writer.size as i64;
    }
    fn tm_tp_export_json(data: []u8, size: usize, work: *TMTPJSONWorkspace,
                         values: []i32, value_capacity: usize, max_total_trits: u64,
                         out: []u8, capacity: usize) -> i64 {
        var validation: TMTPValidation = TMTPValidation{ .tensor_count = 0, .total_trits = 0, .payload_bytes = 0,
            .framing_valid = false, .descriptors_valid = false, .json_binding_valid = false };
        var status: i32 = tm_tp_decode_json(data, size, work, values, value_capacity, max_total_trits, &validation);
        if (status != 0) { return status as i64; }
        var writer: TMTPJSONWriter = TMTPJSONWriter{ .data = out, .capacity = capacity, .size = 0, .status = 0 };
        tm_tpj_put(&writer, 91); var i: usize = 0; var offset: usize = 0;
        while (i < validation.tensor_count) {
            if (i > 0) { tm_tpj_put(&writer, 44); }
            tm_tpc_descriptor_json(&writer, &work.items[i]);
            tm_tpj_z(&writer, ",\"values\":[");
            var count: usize = tm_tp_descriptor_count(&work.items[i]) as usize;
            var j: usize = 0;
            while (j < count) {
                if (j > 0) { tm_tpj_put(&writer, 44); }
                if (values[offset + j] < 0) { tm_tpj_z(&writer, "-1"); }
                else { tm_tpj_u64(&writer, values[offset + j] as u64); }
                j = j + 1;
            }
            tm_tpj_z(&writer, "]}"); offset = offset + count; i = i + 1;
        }
        tm_tpj_z(&writer, "]\n");
        if (writer.status != 0) { return writer.status as i64; }
        return writer.size as i64;
    }
}
