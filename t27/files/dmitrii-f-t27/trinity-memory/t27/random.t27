module TrinityMemoryRandom {
    const TM_RANDOM_ERR_ARGUMENT: i32 = -70;
    const TM_RANDOM_ERR_CAPACITY: i32 = -71;
    struct TMRandom { mt: [624]u32, index: usize, }
    // Magnitude words least-significant first; strip redundant high zeros.
    fn tm_random_seed_words(s: *TMRandom, words: []u32, count: usize) -> i32 {
        if (count == 0) { return TM_RANDOM_ERR_ARGUMENT; }
        var length: usize = count;
        while (length > 1 && words[length - 1] == 0) { length = length - 1; }
        s.mt[0] = 19650218; var i: usize = 1;
        while (i < 624) {
            s.mt[i] = 1812433253 * (s.mt[i - 1] ^ (s.mt[i - 1] >> 30)) + (i as u32); i = i + 1;
        }
        var j: usize = 0; var remaining: usize = 624;
        if (length > remaining) { remaining = length; }
        i = 1;
        while (remaining > 0) {
            s.mt[i] = (s.mt[i] ^ ((s.mt[i - 1] ^ (s.mt[i - 1] >> 30)) * 1664525)) + words[j] + (j as u32);
            i = i + 1; j = j + 1;
            if (i >= 624) { s.mt[0] = s.mt[623]; i = 1; }
            if (j >= length) { j = 0; } remaining = remaining - 1;
        }
        remaining = 623;
        while (remaining > 0) {
            s.mt[i] = (s.mt[i] ^ ((s.mt[i - 1] ^ (s.mt[i - 1] >> 30)) * 1566083941)) - (i as u32);
            i = i + 1;
            if (i >= 624) { s.mt[0] = s.mt[623]; i = 1; } remaining = remaining - 1;
        }
        s.mt[0] = 0x80000000; s.index = 624; return 0;
    }
    fn tm_random_init(s: *TMRandom, seed: u64) -> void {
        var words: [2]u32 = [0, 0]; words[0] = seed as u32; words[1] = (seed >> 32) as u32;
        tm_random_seed_words(s, words, 2);
    }
    fn tm_random_init_i64(s: *TMRandom, seed: i64) -> void {
        var magnitude: u64 = seed as u64;
        if (seed < 0) { magnitude = (-(seed + 1)) as u64 + 1; } tm_random_init(s, magnitude);
    }
    fn tm_random_u32(s: *TMRandom) -> u32 {
        var i: usize = 0; var y: u32 = 0; var odd: u32 = 0;
        if (s.index >= 624) {
            while (i < 227) {
                y = (s.mt[i] & 0x80000000) | (s.mt[i + 1] & 0x7fffffff);
                odd = 0; if ((y & 1) != 0) { odd = 0x9908b0df; }
                s.mt[i] = s.mt[i + 397] ^ (y >> 1) ^ odd; i = i + 1;
            }
            while (i < 623) {
                y = (s.mt[i] & 0x80000000) | (s.mt[i + 1] & 0x7fffffff);
                odd = 0; if ((y & 1) != 0) { odd = 0x9908b0df; }
                s.mt[i] = s.mt[i - 227] ^ (y >> 1) ^ odd; i = i + 1;
            }
            y = (s.mt[623] & 0x80000000) | (s.mt[0] & 0x7fffffff);
            odd = 0; if ((y & 1) != 0) { odd = 0x9908b0df; }
            s.mt[623] = s.mt[396] ^ (y >> 1) ^ odd; s.index = 0;
        }
        y = s.mt[s.index]; s.index = s.index + 1;
        y = y ^ (y >> 11); y = y ^ ((y << 7) & 0x9d2c5680);
        y = y ^ ((y << 15) & 0xefc60000); y = y ^ (y >> 18); return y;
    }
    // Valid bits 0..64; zero consumes no state, invalid >64 returns zero.
    fn tm_random_bits(s: *TMRandom, bits: u32) -> u64 {
        if (bits == 0 || bits > 64) { return 0; }
        if (bits <= 32) { return (tm_random_u32(s) >> (32 - bits)) as u64; }
        var low: u64 = tm_random_u32(s) as u64;
        var high: u64 = (tm_random_u32(s) >> (64 - bits)) as u64; return low | (high << 32);
    }
    fn tm_random_getrandbits(s: *TMRandom, bits: u32, output: []u64) -> i32 {
        if (bits > 64) { return TM_RANDOM_ERR_ARGUMENT; } output[0] = tm_random_bits(s, bits); return 0;
    }
    fn tm_random_bit_length(value: u64) -> u32 {
        var v: u64 = value; var length: u32 = 0;
        while (v > 0) { v = v >> 1; length = length + 1; } return length;
    }
    // Same draws as Random._randbelow(n). Requires n>0; zero returns zero.
    fn tm_random_below64(s: *TMRandom, n: u64) -> u64 {
        if (n == 0) { return 0; }
        var bits: u32 = tm_random_bit_length(n); var value: u64 = tm_random_bits(s, bits);
        while (value >= n) { value = tm_random_bits(s, bits); } return value;
    }
    fn tm_random_below(s: *TMRandom, n: u32) -> u32 { return tm_random_below64(s, n as u64) as u32; }
    fn tm_random_choice(s: *TMRandom, population: []i64, count: u32, output: []i64) -> i32 {
        if (count == 0) { return TM_RANDOM_ERR_ARGUMENT; }
        output[0] = population[tm_random_below(s, count) as usize]; return 0;
    }
    fn tm_random_random(s: *TMRandom) -> f64 {
        var high: u32 = tm_random_u32(s) >> 5; var low: u32 = tm_random_u32(s) >> 6;
        return (((high as f64) * 67108864.0) + (low as f64)) * (1.0 / 9007199254740992.0);
    }
    // Internal: start+offset must mathematically fit signed64.
    fn tm_random_add_offset(start: i64, offset: u64) -> i64 {
        if (start >= 0) { return start + (offset as i64); }
        var magnitude: u64 = (-(start + 1)) as u64 + 1;
        if (offset >= magnitude) { return (offset - magnitude) as i64; }
        return -((magnitude - offset - 1) as i64) - 1;
    }
    fn tm_random_randint(s: *TMRandom, low: i64, high: i64, output: []i64) -> i32 {
        if (high < low) { return TM_RANDOM_ERR_ARGUMENT; }
        var distance: u64 = (high as u64) - (low as u64); var offset: u64 = 0;
        if (distance == 0xffffffffffffffff) {
            // Full signed64 range: Python requests 65 bits and rejects bit65=1.
            var reject: u64 = 1;
            while (reject != 0) { offset = tm_random_bits(s, 64); reject = tm_random_bits(s, 1); }
        } else { offset = tm_random_below64(s, distance + 1); }
        output[0] = tm_random_add_offset(low, offset); return 0;
    }
    fn tm_random_range(s: *TMRandom, start: i64, stop: i64, step: i64, output: []i64) -> i32 {
        if (step == 0 || (step > 0 && start >= stop) || (step < 0 && start <= stop)) { return TM_RANDOM_ERR_ARGUMENT; }
        var distance: u64 = 0; var stride: u64 = 0;
        if (step > 0) { distance = (stop as u64) - (start as u64); stride = step as u64; }
        else { distance = (start as u64) - (stop as u64); stride = (-(step + 1)) as u64 + 1; }
        var count: u64 = (distance - 1) / stride + 1; var offset: u64 = tm_random_below64(s, count) * stride;
        if (step > 0) { output[0] = tm_random_add_offset(start, offset); }
        else {
            if (start <= 0) { output[0] = start - (offset as i64); }
            else {
                if (offset <= (start as u64)) { output[0] = start - (offset as i64); }
                else { output[0] = -((offset - (start as u64) - 1) as i64) - 1; }
            }
        }
        return 0;
    }
    fn tm_random_sample_scratch(population_count: u32, k: u32) -> i64 {
        if (k > population_count) { return TM_RANDOM_ERR_ARGUMENT as i64; }
        if (k == 0) { return 0; }
        var threshold: u64 = 21;
        if (k > 5) {
            var table: u64 = 1;
            while (table < (k as u64) * 3) { table = table * 4; } threshold = threshold + table;
        }
        if ((population_count as u64) <= threshold) { return population_count as i64; } return 0;
    }
    // Sample range(n) indices in Python selection order. Pool: n scratch slots.
    // Set branch uses output-prefix membership, same RNG draws, O(k**2) time.
    // No counts= or noninteger seeds; output values can index any population.
    fn tm_random_sample(s: *TMRandom, population_count: u32, k: u32,
                        output: []u32, capacity: usize, scratch: []u32, scratch_capacity: usize) -> i32 {
        var need: i64 = tm_random_sample_scratch(population_count, k);
        if (need < 0) { return TM_RANDOM_ERR_ARGUMENT; }
        if ((k as u64) > (capacity as u64) || (need as u64) > (scratch_capacity as u64)) { return TM_RANDOM_ERR_CAPACITY; }
        var i: u32 = 0;
        if (need > 0) {
            while (i < population_count) { scratch[i as usize] = i; i = i + 1; } i = 0;
            while (i < k) {
                var chosen: u32 = tm_random_below(s, population_count - i);
                output[i as usize] = scratch[chosen as usize];
                scratch[chosen as usize] = scratch[(population_count - i - 1) as usize]; i = i + 1;
            }
        } else {
            while (i < k) {
                var chosen: u32 = tm_random_below(s, population_count); var duplicate: bool = true;
                while (duplicate) {
                    duplicate = false; var j: u32 = 0;
                    while (j < i) { if (output[j as usize] == chosen) { duplicate = true; } j = j + 1; }
                    if (duplicate) { chosen = tm_random_below(s, population_count); }
                }
                output[i as usize] = chosen; i = i + 1;
            }
        }
        return 0;
    }
}
