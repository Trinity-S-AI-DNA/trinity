// Ternary Check CLI contract v1 (ternary-check/CONTRACT.md). Three parts:
// the strict reader and writer behind `trinity-memory ternary-check decode`
// and `encode` (the t27/formats.t27 decoders and encoders, with the checks
// tests/test_spec_formats.py applies to each vector kind); the class tokens
// that cross the contract (the TF_ERR_* statuses and TF_FLAG_* slots of
// t27/formats.t27, spelled as the keys of conformance/formats_*.json
// constants.errors and constants.flags); and the comparison and verdict the
// runner applies to one vector. Values cross the contract as one signed byte
// per weight, scale words as stored (little-endian). Caller-owned buffers, no
// allocation. Compiled after formats.h in one translation unit.
module TrinityMemoryTernaryContract {
    // Outcome of one vector (tk_verdict).
    const TK_MATCH: i32 = 0;             // decoded; values, scales and flags equal
    const TK_ERR_HADAMARD_BLOCK: i32 = -63;         // rotate BLOCK not 16/64/256/1024 (v1.1)
    const TK_ERR_HADAMARD_SIGN_VALUE: i32 = -64;    // a sign neither +1 nor -1
    const TK_ERR_HADAMARD_SIGNS_LENGTH: i32 = -65;  // SIGNS not exactly BLOCK signs
    const TK_REJECTED: i32 = 1;          // refused a reject vector with its class
    const TK_MATCH_UNFLAGGED: i32 = 2;   // values and scales equal, expected flags not reported
    const TK_MISMATCH: i32 = 3;          // values, scale words, stored bytes or reported flags differ
    const TK_WRONG_CLASS: i32 = 4;       // refused a reject vector with another class
    const TK_UNEXPECTED_REJECT: i32 = 5; // refused a vector it must decode
    const TK_UNCLASSIFIED: i32 = 6;      // nonzero exit without one known class token
    const TK_SILENT: i32 = 7;            // exit 0 on a vector it must refuse
    const TK_CRASHED: i32 = 8;           // stopped by a signal or the time limit
    const TK_OUTCOME_COUNT: i32 = 9;

    // --fail-on policies (tk_fails).
    const TK_FAIL_MISMATCH: i32 = 0;
    const TK_FAIL_SILENT: i32 = 1;
    const TK_FAIL_NEVER: i32 = 2;

    // Flag comparison (tk_flag_state).
    const TK_FLAGS_EQUAL: i32 = 0;
    const TK_FLAGS_UNREPORTED: i32 = 1;
    const TK_FLAGS_DIFFER: i32 = 2;

    // Contract name of a format id; "" for none. MLX2 is TF_LINEAR2 under
    // MLX's group rule (32, 64 or 128).
    fn tk_format_name(format: i32) -> str {
        if (format == TF_TQ1_0) { return "TQ1_0"; }
        if (format == TF_TQ2_0) { return "TQ2_0"; }
        if (format == TF_Q2_0) { return "Q2_0"; }
        if (format == TF_Q1_0) { return "Q1_0"; }
        if (format == TF_PQ2_0) { return "PQ2_0"; }
        if (format == TF_PTQ1_0) { return "PTQ1_0"; }
        if (format == TF_I2_S) { return "I2_S"; }
        if (format == TF_HF_PACKED) { return "HF_PACKED"; }
        if (format == TF_LINEAR2) { return "MLX2"; }
        if (format == TF_ONNX2) { return "ONNX2"; }
        return "";
    }

    // Token of a TF_ERR_* status; "" for any other status.
    fn tk_error_name(status: i32) -> str {
        if (status == TF_ERR_FORMAT) { return "format"; }
        if (status == TF_ERR_LENGTH) { return "length"; }
        if (status == TF_ERR_CAPACITY) { return "capacity"; }
        if (status == TF_ERR_CODE) { return "code"; }
        if (status == TF_ERR_PADDING) { return "padding"; }
        if (status == TF_ERR_TRUNCATED) { return "truncated"; }
        if (status == TF_ERR_CONTAINER) { return "container"; }
        if (status == TF_ERR_NOT_FOUND) { return "not_found"; }
        if (status == TF_ERR_SCALE_NONFINITE) { return "scale_nonfinite"; }
        if (status == TF_ERR_TYPE_AMBIGUOUS) { return "type_ambiguous"; }
        if (status == TF_ERR_LAYOUT_UNSUPPORTED) { return "layout_unsupported"; }
        if (status == TF_ERR_MISALIGNED) { return "misaligned"; }
        if (status == TF_ERR_EXTENT) { return "extent"; }
        if (status == TK_ERR_HADAMARD_BLOCK) { return "hadamard_block"; }
        if (status == TK_ERR_HADAMARD_SIGN_VALUE) { return "hadamard_sign_value"; }
        if (status == TK_ERR_HADAMARD_SIGNS_LENGTH) { return "hadamard_signs_length"; }
        return "";
    }

    // Token of a TF_FLAG_* slot; "" past the last slot.
    fn tk_flag_name(slot: usize) -> str {
        if (slot == TF_FLAG_OUTSIDE_TERNARY) { return "outside_ternary"; }
        if (slot == TF_FLAG_NONCANONICAL_BASE3) { return "noncanonical_base3"; }
        if (slot == TF_FLAG_SCALE_NEGATIVE) { return "scale_negative"; }
        if (slot == TF_FLAG_SCALE_ZERO) { return "scale_zero"; }
        if (slot == TF_FLAG_TRAILER_NONZERO) { return "trailer_nonzero"; }
        if (slot == TF_FLAG_PADDING_NONZERO) { return "padding_nonzero"; }
        if (slot == TF_FLAG_AFFINE_NOT_TERNARY) { return "affine_not_ternary"; }
        return "";
    }

    fn tk_outcome_name(outcome: i32) -> str {
        if (outcome == TK_MATCH) { return "match"; }
        if (outcome == TK_REJECTED) { return "rejected"; }
        if (outcome == TK_MATCH_UNFLAGGED) { return "match_unflagged"; }
        if (outcome == TK_MISMATCH) { return "mismatch"; }
        if (outcome == TK_WRONG_CLASS) { return "wrong_class"; }
        if (outcome == TK_UNEXPECTED_REJECT) { return "unexpected_reject"; }
        if (outcome == TK_UNCLASSIFIED) { return "unclassified"; }
        if (outcome == TK_SILENT) { return "silent"; }
        if (outcome == TK_CRASHED) { return "crashed"; }
        return "";
    }

    // Copies a NUL-terminated name into `out`; returns its length, or
    // TF_ERR_CAPACITY when it does not fit.
    fn tk_put_name(name: str, out: []u8, capacity: usize) -> i64 {
        var i: usize = 0;
        while (name[i] != 0) {
            if (i >= capacity) { return TF_ERR_CAPACITY as i64; }
            out[i] = name[i] as u8;
            i = i + 1;
        }
        return i as i64;
    }

    // data[at, at + size) equals a nonempty NUL-terminated name.
    fn tk_is_name(data: []u8, at: usize, size: usize, name: str) -> bool {
        if (size == 0) { return false; }
        var i: usize = 0;
        while (i < size) {
            if (name[i] == 0 || data[at + i] != (name[i] as u8)) { return false; }
            i = i + 1;
        }
        return name[i] == 0;
    }

    fn tk_format_of_name(text: []u8, size: usize) -> i32 {
        var format: i32 = TF_TQ1_0;
        while (format <= TF_ONNX2) {
            if (tk_is_name(text, 0, size, tk_format_name(format))) { return format; }
            format = format + 1;
        }
        return 0;
    }

    fn tk_space(c: u8) -> bool { return c == 32 || c == 9 || c == 10 || c == 13; }

    // TF_ERR_* status named by an error file: one class token, optionally
    // followed by ASCII whitespace. 0 when the text names no class.
    fn tk_error_status(text: []u8, size: usize) -> i32 {
        var n: usize = size;
        while (n > 0 && tk_space(text[n - 1])) { n = n - 1; }
        var status: i32 = TF_ERR_FORMAT;
        while (status >= TK_ERR_HADAMARD_SIGNS_LENGTH) {
            if (tk_is_name(text, 0, n, tk_error_name(status))) { return status; }
            status = status - 1;
        }
        return 0;
    }

    fn tk_error_token(status: i32, out: []u8, capacity: usize) -> i64 {
        return tk_put_name(tk_error_name(status), out, capacity);
    }

    fn tk_flag_token(slot: usize, out: []u8, capacity: usize) -> i64 {
        return tk_put_name(tk_flag_name(slot), out, capacity);
    }

    fn tk_outcome_token(outcome: i32, out: []u8, capacity: usize) -> i64 {
        return tk_put_name(tk_outcome_name(outcome), out, capacity);
    }

    fn tk_format_token(format: i32, out: []u8, capacity: usize) -> i64 {
        return tk_put_name(tk_format_name(format), out, capacity);
    }

    // Parses a flags file into TF_FLAG_COUNT slots (cleared first): one line
    // per flag, "<token> <count>" with a single space and a decimal count of
    // at most 18 digits; blank lines and a CR before LF are ignored; a token
    // may appear once. Returns 0, or -1 for anything else.
    fn tk_parse_flags(text: []u8, size: usize, flags: []i64) -> i32 {
        tf_flags_clear(flags);
        var one: u32 = 1;
        var seen: u32 = 0;
        var at: usize = 0;
        while (at < size) {
            var end: usize = at;
            while (end < size && text[end] != 10) { end = end + 1; }
            var stop: usize = end;
            if (stop > at && text[stop - 1] == 13) { stop = stop - 1; }
            if (stop > at) {
                var space: usize = at;
                while (space < stop && text[space] != 32) { space = space + 1; }
                if (space == stop || space == at) { return -1; }
                var slot: usize = TF_FLAG_COUNT;
                var s: usize = 0;
                while (s < TF_FLAG_COUNT) {
                    if (tk_is_name(text, at, space - at, tk_flag_name(s))) { slot = s; }
                    s = s + 1;
                }
                if (slot == TF_FLAG_COUNT) { return -1; }
                var bit: u32 = one << (slot as u32);
                if ((seen & bit) != 0) { return -1; }
                seen = seen | bit;
                var digit: usize = space + 1;
                if (digit >= stop || stop - digit > 18) { return -1; }
                var count: i64 = 0;
                while (digit < stop) {
                    var c: u8 = text[digit];
                    if (c < 48 || c > 57) { return -1; }
                    count = count * 10 + ((c - 48) as i64);
                    digit = digit + 1;
                }
                flags[slot] = count;
            }
            at = end + 1;
        }
        return 0;
    }

    // One "<token> <count>\n" line at out[at]; returns its length.
    fn tk_flag_line(slot: usize, count: i64, out: []u8, at: usize, capacity: usize) -> i64 {
        var used: usize = at;
        var name: str = tk_flag_name(slot);
        var i: usize = 0;
        while (name[i] != 0) {
            if (used >= capacity) { return TF_ERR_CAPACITY as i64; }
            out[used] = name[i] as u8;
            used = used + 1;
            i = i + 1;
        }
        if (used >= capacity) { return TF_ERR_CAPACITY as i64; }
        out[used] = 32;
        used = used + 1;
        var value: u64 = count as u64;
        var divisor: u64 = 1;
        while (value / divisor >= 10) { divisor = divisor * 10; }
        while (divisor > 0) {
            if (used >= capacity) { return TF_ERR_CAPACITY as i64; }
            out[used] = (48 + (value / divisor) % 10) as u8;
            used = used + 1;
            divisor = divisor / 10;
        }
        if (used >= capacity) { return TF_ERR_CAPACITY as i64; }
        out[used] = 10;
        used = used + 1;
        return (used - at) as i64;
    }

    // Writes one "<token> <count>\n" line per nonzero slot, in slot order.
    // Returns the byte count, TF_ERR_CAPACITY, or TF_ERR_LENGTH for a
    // negative count.
    fn tk_flags_text(flags: []i64, out: []u8, capacity: usize) -> i64 {
        var used: usize = 0;
        var s: usize = 0;
        while (s < TF_FLAG_COUNT) {
            var count: i64 = flags[s];
            if (count < 0) { return TF_ERR_LENGTH as i64; }
            if (count > 0) {
                var written: i64 = tk_flag_line(s, count, out, used, capacity);
                if (written < 0) { return written; }
                used = used + (written as usize);
            }
            s = s + 1;
        }
        return used as i64;
    }

    // ---- comparison -------------------------------------------------------
    // Positions of `count` expected bytes that `actual` (actual_size bytes)
    // does not reproduce: differing bytes plus every missing or surplus
    // position. first[0] is the first such position, or -1.
    fn tk_compare_bytes(actual: []u8, actual_size: usize, expected: []u8, count: usize, first: []i64) -> i64 {
        first[0] = -1;
        var common: usize = count;
        if (actual_size < common) { common = actual_size; }
        var total: i64 = 0;
        var i: usize = 0;
        while (i < common) {
            if (actual[i] != expected[i]) {
                if (total == 0) { first[0] = i as i64; }
                total = total + 1;
            }
            i = i + 1;
        }
        if (actual_size != count) {
            if (total == 0) { first[0] = common as i64; }
            if (actual_size > count) { total = total + ((actual_size - count) as i64); }
            else { total = total + ((count - actual_size) as i64); }
        }
        return total;
    }

    // Scale words of `count` expected words that `actual` (little-endian words
    // of `width` bytes, 2 or 4) does not reproduce: differing words plus every
    // missing or surplus word, a trailing partial word included. first[0] is
    // the first such word index, or -1. TF_ERR_LENGTH for another width.
    fn tk_compare_words(actual: []u8, actual_size: usize, width: usize, expected: []u32, count: usize,
                        first: []i64) -> i64 {
        first[0] = -1;
        if (width != 2 && width != 4) { return TF_ERR_LENGTH as i64; }
        var whole: usize = actual_size / width;
        var partial: bool = actual_size % width != 0;
        var common: usize = count;
        if (whole < common) { common = whole; }
        var total: i64 = 0;
        var i: usize = 0;
        while (i < common) {
            var word: u32 = 0;
            if (width == 2) { word = tf_read_u16(actual, 2 * i); }
            else { word = tf_read_u32(actual, 4 * i); }
            if (word != expected[i]) {
                if (total == 0) { first[0] = i as i64; }
                total = total + 1;
            }
            i = i + 1;
        }
        var extra: i64 = 0;
        if (whole > count) { extra = (whole - count) as i64; }
        if (whole < count) { extra = (count - whole) as i64; }
        if (partial && whole >= count) { extra = extra + 1; }
        if (extra > 0 && total == 0) { first[0] = common as i64; }
        return total + extra;
    }

    // TK_FLAGS_EQUAL when the reported flags equal the expected ones, or
    // nothing was reported and every expected slot is 0; TK_FLAGS_UNREPORTED
    // when nothing was reported but a slot is expected nonzero;
    // TK_FLAGS_DIFFER when the report is malformed (parse_status != 0) or a
    // slot differs.
    fn tk_flag_state(reported: bool, parse_status: i32, actual: []i64, expected: []i64) -> i32 {
        var s: usize = 0;
        if (!reported) {
            var any: bool = false;
            while (s < TF_FLAG_COUNT) {
                if (expected[s] != 0) { any = true; }
                s = s + 1;
            }
            if (any) { return TK_FLAGS_UNREPORTED; }
            return TK_FLAGS_EQUAL;
        }
        if (parse_status != 0) { return TK_FLAGS_DIFFER; }
        var differ: bool = false;
        while (s < TF_FLAG_COUNT) {
            if (actual[s] != expected[s]) { differ = true; }
            s = s + 1;
        }
        if (differ) { return TK_FLAGS_DIFFER; }
        return TK_FLAGS_EQUAL;
    }

    // Outcome of one call. expected: 0 when the vector must decode (or
    // encode), else the TF_ERR_* status of its class. ended: 0 when the
    // decoder exited, nonzero when a signal or the time limit stopped it.
    // error_status: tk_error_status of its error file, 0 when absent or
    // naming no class. The differences count only after an exit 0.
    fn tk_verdict(expected: i32, ended: i32, exit_code: i32, error_status: i32,
                  value_diff: i64, scale_diff: i64, flag_state: i32) -> i32 {
        if (ended != 0) { return TK_CRASHED; }
        if (exit_code != 0) {
            if (error_status == 0) { return TK_UNCLASSIFIED; }
            if (expected == 0) { return TK_UNEXPECTED_REJECT; }
            if (error_status == expected) { return TK_REJECTED; }
            return TK_WRONG_CLASS;
        }
        if (expected != 0) { return TK_SILENT; }
        if (value_diff != 0 || scale_diff != 0 || flag_state == TK_FLAGS_DIFFER) { return TK_MISMATCH; }
        if (flag_state == TK_FLAGS_UNREPORTED) { return TK_MATCH_UNFLAGGED; }
        return TK_MATCH;
    }

    // Whether an outcome fails the run under a --fail-on policy: mismatch
    // fails every outcome but match, match_unflagged and rejected; silent
    // fails only a silent acceptance; never fails nothing.
    fn tk_fails(outcome: i32, policy: i32) -> bool {
        if (policy == TK_FAIL_NEVER) { return false; }
        if (policy == TK_FAIL_SILENT) { return outcome == TK_SILENT; }
        return outcome != TK_MATCH && outcome != TK_MATCH_UNFLAGGED && outcome != TK_REJECTED;
    }

    // Whether a run passes: at least one call ran, every format named in the
    // run's filter ran at least once (idle_formats counts those that did
    // not), and no call fails under the policy (failures counts tk_fails).
    // A run that checked nothing never passes, under every policy.
    fn tk_run_passed(cases: usize, failures: usize, idle_formats: usize) -> bool {
        if (cases == 0) { return false; }
        if (idle_formats != 0) { return false; }
        return failures == 0;
    }

    // ---- the strict reader and writer --------------------------------------
    // Geometry of a call: `count` weights; for HF_PACKED and MLX2 rows and
    // cols of the weight matrix, for ONNX2 its N and K (count = rows * cols);
    // group is MLX2's group or ONNX2's block_size.
    fn tk_side_scales(format: i32) -> bool {
        return format == TF_HF_PACKED || format == TF_LINEAR2 || format == TF_ONNX2;
    }

    // Scale words of a call: one per block, one for I2_S and HF_PACKED, one
    // per MLX2 group, one per ONNX2 row block. 0 when the geometry has none.
    fn tk_scale_count(format: i32, count: usize, rows: usize, cols: usize, group: usize) -> usize {
        var per: usize = tf_block_elements(format);
        if (per != 0) { return count / per; }
        if (format == TF_I2_S || format == TF_HF_PACKED) { return 1; }
        if (group == 0) { return 0; }
        if (format == TF_LINEAR2) { return count / group; }
        if (format == TF_ONNX2) { return rows * ((cols + group - 1) / group); }
        return 0;
    }

    // Bytes of one scale word: fp16 in the block formats, f32 in I2_S, and
    // the scale kind (TF_KIND_F16, _BF16, _F32) of a separate scale tensor.
    fn tk_scale_width(format: i32, kind: i32) -> usize {
        if (tf_block_elements(format) != 0) { return 2; }
        if (format == TF_I2_S || kind == TF_KIND_F32) { return 4; }
        return 2;
    }

    fn tk_shape_valid(count: usize, rows: usize, cols: usize) -> bool {
        if (rows == 0 || cols == 0) { return false; }
        return count % rows == 0 && count / rows == cols;
    }

    // Stored bytes the writer produces for a geometry; 0 when invalid.
    fn tk_encoded_bytes(format: i32, count: usize, rows: usize, cols: usize, group: usize) -> usize {
        var per: usize = tf_block_elements(format);
        if (per != 0) { return (count / per) * tf_block_bytes(format); }
        if (format == TF_I2_S) { return tf_i2s_bytes(count); }
        if (!tk_shape_valid(count, rows, cols)) { return 0; }
        if (format == TF_HF_PACKED) { return (rows / 4) * cols; }
        if (format == TF_LINEAR2) { return rows * (cols / 4); }
        if (format == TF_ONNX2 && group != 0) { return rows * tf_onnx2_row_bytes(cols, group); }
        return 0;
    }

    fn tk_store_values(work: []i32, count: usize, values: []u8) -> void {
        var i: usize = 0;
        while (i < count) {
            values[i] = ((work[i] as u32) & 255) as u8;
            i = i + 1;
        }
    }

    fn tk_load_values(values: []u8, count: usize, work: []i32) -> void {
        var i: usize = 0;
        while (i < count) {
            var v: i32 = values[i] as i32;
            if (v > 127) { v = v - 256; }
            work[i] = v;
            i = i + 1;
        }
    }

    // Reads one call: `size` stored bytes of `format` into `count` signed
    // bytes (the value is the stored code minus the format's zero point, so
    // +2 and -2 appear as such), the scale words into `scales`, and the
    // flags (cleared first). The separate scale tensor of HF_PACKED, MLX2
    // and ONNX2 is `side` (scale words of `kind`), MLX2's biases `biases`,
    // ONNX2's packed zero points `zero_points` (zp_size 0: the default 2);
    // their scale words are returned unchanged. `work` holds count i32.
    // Returns the number of scale words, or the first rejection in the order
    // the vectors state: the payload reader's, then the scale check's.
    // Nothing is written to `values` or `scales` on rejection.
    fn tk_decode(format: i32, data: []u8, size: usize, count: usize, rows: usize, cols: usize, group: usize,
                 kind: i32, side: []u32, side_count: usize, biases: []u32, bias_count: usize,
                 zero_points: []u8, zp_size: usize, work: []i32, values: []u8, capacity: usize,
                 scales: []u32, scale_capacity: usize, flags: []i64) -> i64 {
        tf_flags_clear(flags);
        var per: usize = tf_block_elements(format);
        if (per != 0) {
            var blocks: i64 = tf_decode_blocks(format, data, size, count, work, capacity, scales, scale_capacity);
            if (blocks < 0) { return blocks; }
            var block_check: i64 = tf_block_flags(format, data, size, count, flags);
            if (block_check < 0) { return block_check; }
            tk_store_values(work, count, values);
            return (count / per) as i64;
        }
        if (format == TF_I2_S) {
            if (scale_capacity < 1) { return TF_ERR_CAPACITY as i64; }
            var i2s: i64 = tf_decode_i2s(data, size, count, work, capacity, scales);
            if (i2s < 0) { return i2s; }
            var i2s_check: i64 = tf_i2s_flags(data, size, count, flags);
            if (i2s_check < 0) { return i2s_check; }
            tk_store_values(work, count, values);
            return 1;
        }
        if (!tk_side_scales(format)) { return TF_ERR_FORMAT as i64; }
        if (kind != TF_KIND_F16 && kind != TF_KIND_BF16 && kind != TF_KIND_F32) { return TF_ERR_FORMAT as i64; }
        if (!tk_shape_valid(count, rows, cols)) { return TF_ERR_LENGTH as i64; }
        if (count > capacity) { return TF_ERR_CAPACITY as i64; }
        var outside: i64 = 0;
        if (format == TF_HF_PACKED) { outside = tf_decode_hf_packed(data, size, rows, cols, work, capacity); }
        if (format == TF_LINEAR2) { outside = tf_decode_mlx2(data, size, rows, cols, group, work, capacity); }
        if (format == TF_ONNX2) {
            outside = tf_decode_onnx2(data, size, rows, cols, group, zero_points, zp_size, work, capacity);
        }
        if (outside < 0) { return outside; }
        var needed: usize = tk_scale_count(format, count, rows, cols, group);
        if (side_count != needed) { return TF_ERR_LENGTH as i64; }
        if (needed > scale_capacity) { return TF_ERR_CAPACITY as i64; }
        var check: i64 = 0;
        if (format == TF_LINEAR2) {
            if (bias_count != side_count) { return TF_ERR_LENGTH as i64; }
            check = tf_affine_check(side, biases, side_count, kind, flags);
        } else {
            check = tf_scales_check(side, side_count, kind, flags);
        }
        if (check < 0) { tf_flags_clear(flags); return check; }
        flags[TF_FLAG_OUTSIDE_TERNARY] = flags[TF_FLAG_OUTSIDE_TERNARY] + outside;
        if (format == TF_ONNX2) {
            flags[TF_FLAG_PADDING_NONZERO] = tf_onnx2_padding_nonzero(data, size, rows, cols, group);
        }
        var i: usize = 0;
        while (i < needed) { scales[i] = side[i]; i = i + 1; }
        tk_store_values(work, count, values);
        return needed as i64;
    }

    // Writes one call: `count` signed bytes of `format` (with the scale words
    // of the block formats and I2_S; the other formats keep their scales in
    // separate tensors and take none) into `out`. `values_size` is the byte
    // count of the VALUES input; it must equal `count` (TF_ERR_LENGTH), and
    // nothing past it is read. An unknown format is TF_ERR_FORMAT before any
    // other check. Returns the byte count or the writer's rejection; `work`
    // holds count i32.
    fn tk_encode(format: i32, values: []u8, values_size: usize, count: usize, rows: usize, cols: usize,
                 group: usize, scales: []u32, scale_count: usize, zero_points: []u8, zp_size: usize,
                 work: []i32, work_capacity: usize, out: []u8, capacity: usize) -> i64 {
        if (tf_block_elements(format) == 0 && format != TF_I2_S && !tk_side_scales(format)) {
            return TF_ERR_FORMAT as i64;
        }
        if (values_size != count) { return TF_ERR_LENGTH as i64; }
        if (count > work_capacity) { return TF_ERR_CAPACITY as i64; }
        tk_load_values(values, count, work);
        if (tf_block_elements(format) != 0) {
            return tf_encode_blocks(format, work, count, scales, scale_count, out, capacity);
        }
        if (format == TF_I2_S) {
            if (scale_count != 1) { return TF_ERR_LENGTH as i64; }
            return tf_encode_i2s(work, count, scales[0], out, capacity);
        }
        if (!tk_side_scales(format)) { return TF_ERR_FORMAT as i64; }
        if (!tk_shape_valid(count, rows, cols)) { return TF_ERR_LENGTH as i64; }
        if (format == TF_HF_PACKED) { return tf_encode_hf_packed(work, rows, cols, out, capacity); }
        if (format == TF_LINEAR2) { return tf_encode_mlx2(work, rows, cols, group, out, capacity); }
        return tf_encode_onnx2(work, rows, cols, group, zero_points, zp_size, out, capacity);
    }
}

test tk_tokens_verdicts_and_comparison {
    var token: [32]u8;
    assert(tk_error_token(-58, token, 32) == 15);
    assert(tk_error_status(token, 15) == -58);
    assert(tk_error_token(-49, token, 32) == 0);
    var line: [8]u8 = [112, 97, 100, 100, 105, 110, 103, 10];
    assert(tk_error_status(line, 8) == -54);
    assert(tk_error_status(line, 6) == 0);
    assert(tk_format_of_name(line, 0) == 0);
    assert(tk_verdict(-54, 0, 1, -54, 0, 0, 0) == 1);
    assert(tk_verdict(-54, 0, 0, 0, 0, 0, 0) == 7);
    assert(tk_verdict(0, 0, 0, 0, 3, 0, 0) == 3);
    assert(tk_verdict(0, 0, 0, 0, 0, 0, 1) == 2);
    assert(tk_verdict(0, 1, 0, 0, 0, 0, 0) == 8);
    assert(tk_fails(7, 1));
    assert(!tk_fails(3, 1));
    assert(!tk_fails(2, 0));
    assert(tk_run_passed(3, 0, 0));
    assert(!tk_run_passed(0, 0, 0));
    assert(!tk_run_passed(3, 1, 0));
    assert(!tk_run_passed(3, 0, 1));
    var a: [4]u8 = [1, 255, 0, 1];
    var b: [4]u8 = [1, 255, 1, 1];
    var first: [1]i64 = [0];
    assert(tk_compare_bytes(a, 4, b, 4, first) == 1);
    assert(first[0] == 2);
    assert(tk_compare_bytes(a, 2, b, 4, first) == 2);
    assert(first[0] == 2);
    var words: [2]u32 = [15360, 511];
    var stored: [4]u8 = [0, 60, 255, 1];
    assert(tk_compare_words(stored, 4, 2, words, 2, first) == 0);
    assert(first[0] == -1);
    assert(tk_compare_words(stored, 3, 2, words, 2, first) == 1);
    assert(first[0] == 1);
}
