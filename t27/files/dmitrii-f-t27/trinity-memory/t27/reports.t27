// Native HTML report rendering. Every data value is escaped before insertion;
// HTML/CSS below are presentation templates, not embedded domain algorithms.
module TrinityMemoryReports {
    fn tm_report_escape(w: *TMJsonWriter, text: []u8, size: usize) -> void {
        var i: usize = 0;
        while (i < size) {
            var c: u8 = text[i];
            if (c == 38) { tm_bridge_text(w, "&amp;"); }
            else { if (c == 60) { tm_bridge_text(w, "&lt;"); }
            else { if (c == 62) { tm_bridge_text(w, "&gt;"); }
            else { if (c == 34) { tm_bridge_text(w, "&quot;"); }
            else { if (c == 39) { tm_bridge_text(w, "&#x27;"); }
            else { tm_bridge_put(w, c); } } } } }
            i = i + 1;
        }
    }
    fn tm_report_field(work: *TMRPCWorkspace, object: i64, name: str, size: usize, kind: i32) -> i64 {
        var index: i64 = tm_rpc_field(work, object, name, size);
        if (index < 0 || work.tokens[index].kind != kind) { return -1; }
        return index;
    }
    fn tm_report_string(w: *TMJsonWriter, work: *TMRPCWorkspace, index: i64) -> void {
        if (index < 0) { w.error = TM_EXP_ERR_CHECK; return; }
        if (work.tokens[index].kind == TM_JSON_NULL) { tm_bridge_text(w, "None"); return; }
        if (work.tokens[index].kind != TM_JSON_STRING) { w.error = TM_EXP_ERR_CHECK; return; }
        tm_report_escape(w, work.tokens[index].text, work.tokens[index].text_size);
    }
    fn tm_report_integer(w: *TMJsonWriter, work: *TMRPCWorkspace, index: i64) -> void {
        if (index < 0 || work.tokens[index].kind != TM_JSON_INTEGER || !work.tokens[index].integer_fits_i64) {
            w.error = TM_EXP_ERR_CHECK; return;
        }
        tm_json_write_i64(w, work.tokens[index].integer);
    }
    fn tm_report_ms(w: *TMJsonWriter, ns: u64) -> void {
        var micros: u64 = ns / 1000; var remainder: u64 = ns % 1000;
        if (remainder > 500 || (remainder == 500 && micros % 2 == 1)) { micros = micros + 1; }
        tm_json_write_u64(w, micros / 1000); tm_bridge_put(w, 46);
        var fraction: u64 = micros % 1000;
        tm_bridge_put(w, (48 + fraction / 100) as u8);
        tm_bridge_put(w, (48 + (fraction / 10) % 10) as u8);
        tm_bridge_put(w, (48 + fraction % 10) as u8);
    }
    fn tm_report_scores(w: *TMJsonWriter, work: *TMRPCWorkspace, array: i64) -> void {
        if (array < 0 || work.tokens[array].kind != TM_JSON_ARRAY) { w.error = TM_EXP_ERR_CHECK; return; }
        tm_bridge_put(w, 91); var child: i64 = work.tokens[array].first; var seen: usize = 0;
        while (child >= 0) {
            if (seen > 0) { tm_bridge_text(w, ", "); }
            tm_report_integer(w, work, child); child = work.tokens[child].next; seen = seen + 1;
        }
        tm_bridge_put(w, 93);
    }
    fn tm_report_edge_body(data: []u8, size: usize, work: *TMRPCWorkspace, writer: *TMJsonWriter) -> i32 {
        if (tm_rpc_parse(data, size, work) != 0) { return TM_EXP_ERR_CHECK; }
        var schema: i64 = tm_report_field(work, work.root, "schema", 6, TM_JSON_STRING);
        var modes: i64 = tm_report_field(work, work.root, "modes", 5, TM_JSON_ARRAY);
        var limits: i64 = tm_report_field(work, work.root, "limitations", 11, TM_JSON_ARRAY);
        var evidence: i64 = tm_report_field(work, work.root, "evidence", 8, TM_JSON_ARRAY);
        if (schema < 0 || !tm_rpc_text(&work.tokens[schema], "trinity.edge-report.v1", 22) || modes < 0 || limits < 0 || evidence < 0) {
            return TM_EXP_ERR_CHECK;
        }
        var rtl: bool = false; var item: i64 = work.tokens[evidence].first;
        while (item >= 0) { if (tm_rpc_text(&work.tokens[item], "rtl-simulation", 14)) { rtl = true; } item = work.tokens[item].next; }
        tm_bridge_text(writer, "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Trinity Memory &middot; five directions</title>\n");
        tm_bridge_text(writer, "<style>body{margin:0;background:#0d1424;color:#e6edf7;font:16px/1.6 system-ui}main{max-width:1100px;margin:auto;padding:48px 24px}h1{font-size:42px;line-height:1.15}h2{margin-top:36px}.eyebrow{color:#72dcc0;letter-spacing:.12em}.chain{padding:24px;background:#172338;border:1px solid #32455f;border-radius:12px;font-size:19px}.badge{display:inline-block;background:#184b40;border:1px solid #458b75;padding:4px 12px;border-radius:20px}.muted{color:#afc0d6}table{border-collapse:collapse;width:100%;font-size:14px}th,td{text-align:left;border-bottom:1px solid #32455f;padding:12px}.scroll{overflow:auto}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px}a{color:#72dcc0}details{margin-top:32px}code{color:#9ee0ef}</style>\n");
        tm_bridge_text(writer, "<main><div class=\"eyebrow\">TRINITY MEMORY &middot; NATIVE T27</div><h1>From a tensor file<br>to a checked computation.</h1><p><span class=\"badge\">");
        if (rtl) { tm_bridge_text(writer, "Software + RTL simulation"); }
        else { tm_bridge_text(writer, "Software demonstrator &middot; RTL not run"); }
        tm_bridge_text(writer, "</span></p><p class=\"chain\">TensorPack &rarr; Bridge / HTTP &rarr; emulated memory &rarr; Stream Compute &rarr; Edge Demo<br><small>Conformance Lab checks each boundary.</small></p><p class=\"muted\">A hand-authored ternary signal classifier. Every result below is compared against an independent integer reference. Physical hardware has not been tested.</p>");
        tm_bridge_text(writer, "<h2>Storage and transfer</h2><p>Raw payload counts the 36 trits only. TensorPack includes names, dimensions, scales, headers and checksums. The tiny fixture illustrates metadata overhead.</p><div class=\"scroll\"><table><thead><tr><th>Codec</th><th>Payload bytes</th><th>Container bytes</th><th>HTTP upload + read (ms)</th></tr></thead><tbody>");
        var mode: i64 = work.tokens[modes].first;
        while (mode >= 0 && writer.error == 0) {
            tm_bridge_text(writer, "<tr><td>"); tm_report_string(writer, work, tm_rpc_field(work, mode, "codec", 5));
            tm_bridge_text(writer, "</td><td>"); tm_report_integer(writer, work, tm_rpc_field(work, mode, "raw_weight_payload_bytes", 24));
            tm_bridge_text(writer, "</td><td>"); tm_report_integer(writer, work, tm_rpc_field(work, mode, "container_bytes", 15));
            var elapsed: i64 = tm_report_field(work, mode, "upload_read_wall_ns", 19, TM_JSON_INTEGER);
            if (elapsed < 0 || work.tokens[elapsed].negative) { return TM_EXP_ERR_CHECK; }
            tm_bridge_text(writer, "</td><td>"); tm_report_ms(writer, work.tokens[elapsed].uinteger);
            tm_bridge_text(writer, "</td></tr>"); mode = work.tokens[mode].next;
        }
        tm_bridge_text(writer, "</tbody></table></div><h2>End-to-end checks</h2><p>RTL cycles are per output row and include the configured testbench stalls.</p><div class=\"scroll\"><table><thead><tr><th>Codec</th><th>Signal</th><th>Expected</th><th>Predicted</th><th>Integer scores</th><th>RTL cycles</th><th>Check</th></tr></thead><tbody>");
        mode = work.tokens[modes].first;
        while (mode >= 0 && writer.error == 0) {
            var cases: i64 = tm_report_field(work, mode, "cases", 5, TM_JSON_ARRAY);
            if (cases < 0) { return TM_EXP_ERR_CHECK; }
            var item: i64 = work.tokens[cases].first;
            while (item >= 0 && writer.error == 0) {
                tm_bridge_text(writer, "<tr><td>"); tm_report_string(writer, work, tm_rpc_field(work, mode, "codec", 5));
                tm_bridge_text(writer, "</td><td>"); tm_report_string(writer, work, tm_rpc_field(work, item, "name", 4));
                tm_bridge_text(writer, "</td><td>"); tm_report_string(writer, work, tm_rpc_field(work, item, "expected", 8));
                tm_bridge_text(writer, "</td><td>"); tm_report_string(writer, work, tm_rpc_field(work, item, "label", 5));
                tm_bridge_text(writer, "</td><td>"); tm_report_scores(writer, work, tm_rpc_field(work, item, "accumulators", 12));
                tm_bridge_text(writer, "</td><td>"); var witnesses: i64 = tm_report_field(work, item, "rtl", 3, TM_JSON_ARRAY);
                if (witnesses < 0) { return TM_EXP_ERR_CHECK; }
                var witness: i64 = work.tokens[witnesses].first; var seen: usize = 0;
                if (witness < 0) { tm_bridge_text(writer, "not run"); }
                while (witness >= 0) {
                    if (seen > 0) { tm_bridge_text(writer, ", "); }
                    tm_report_integer(writer, work, tm_rpc_field(work, witness, "cycles", 6));
                    witness = work.tokens[witness].next; seen = seen + 1;
                }
                var passed: i64 = tm_rpc_field(work, item, "passed", 6);
                if (passed < 0 || (work.tokens[passed].kind != TM_JSON_TRUE && work.tokens[passed].kind != TM_JSON_FALSE)) { return TM_EXP_ERR_CHECK; }
                tm_bridge_text(writer, "</td><td>");
                if (work.tokens[passed].kind == TM_JSON_TRUE) { tm_bridge_text(writer, "PASS"); } else { tm_bridge_text(writer, "FAIL"); }
                tm_bridge_text(writer, "</td></tr>"); item = work.tokens[item].next;
            }
            mode = work.tokens[mode].next;
        }
        tm_bridge_text(writer, "</tbody></table></div><h2>Evidence boundaries</h2><ul>"); item = work.tokens[limits].first;
        while (item >= 0) { tm_bridge_text(writer, "<li>"); tm_report_string(writer, work, item); tm_bridge_text(writer, "</li>"); item = work.tokens[item].next; }
        tm_bridge_text(writer, "</ul><p><a href=\"https://github.com/dmitrii-f-t27/trinity-memory\">Source and reproduction instructions</a></p><details><summary>Inspect the complete report JSON</summary><pre>");
        tm_report_escape(writer, data, size); tm_bridge_text(writer, "</pre></details></main></html>\n");
        return writer.error;
    }
    fn tm_report_edge_html(data: []u8, size: usize, out: []u8, capacity: usize) -> i64 {
        if (size > 16777216) { return TM_RPC_ERR_LIMIT as i64; }
        var work: *TMRPCWorkspace = tm_runtime_rpc_new(size);
        if (work == 0) { return TM_EXP_ERR_RESOURCE as i64; }
        var writer: TMJsonWriter = TMJsonWriter{ .data = out, .capacity = capacity, .used = 0, .error = 0 };
        var status: i32 = tm_report_edge_body(data, size, work, &writer);
        tm_runtime_rpc_free(work);
        if (status != 0) { return status as i64; }
        return writer.used as i64;
    }

    // Finite nonnegative numeric fields, with booleans rejected explicitly.
    fn tm_report_number(work: *TMRPCWorkspace, object: i64, name: str, size: usize) -> i64 {
        var index: i64 = tm_rpc_field(work, object, name, size);
        if (index < 0) { return -1; }
        if (work.tokens[index].kind == TM_JSON_INTEGER) {
            if (work.tokens[index].negative) { return -1; }
            return index;
        }
        if (work.tokens[index].kind != TM_JSON_REAL || !tm_compute_finite(work.tokens[index].real) || work.tokens[index].real < 0.0) { return -1; }
        return index;
    }
    fn tm_report_validate_benchmark(work: *TMRPCWorkspace) -> i32 {
        if (work.root < 0 || work.tokens[work.root].kind != TM_JSON_OBJECT) { return TM_EXP_ERR_CHECK; }
        var version: i64 = tm_rpc_field(work, work.root, "schema_version", 14);
        if (version < 0) { return TM_EXP_ERR_CHECK; }
        var accepted: bool = (work.tokens[version].kind == TM_JSON_INTEGER && work.tokens[version].integer_fits_i64 && work.tokens[version].integer == 1) || (work.tokens[version].kind == TM_JSON_REAL && work.tokens[version].real == 1.0);
        if (!accepted) { return TM_EXP_ERR_CHECK; }
        var datasets: i64 = tm_report_field(work, work.root, "datasets", 8, TM_JSON_ARRAY);
        if (datasets < 0 || work.tokens[datasets].first < 0) { return TM_EXP_ERR_CHECK; }
        var dataset: i64 = work.tokens[datasets].first;
        while (dataset >= 0) {
            if (work.tokens[dataset].kind != TM_JSON_OBJECT || tm_report_field(work, dataset, "name", 4, TM_JSON_STRING) < 0) { return TM_EXP_ERR_CHECK; }
            if (tm_report_number(work, dataset, "count", 5) < 0 || tm_report_number(work, dataset, "entropy_bpw", 11) < 0) { return TM_EXP_ERR_CHECK; }
            var zeros: i64 = tm_report_number(work, dataset, "zero_fraction", 13);
            if (zeros < 0) { return TM_EXP_ERR_CHECK; }
            if ((work.tokens[zeros].kind == TM_JSON_INTEGER && work.tokens[zeros].uinteger > 1) || (work.tokens[zeros].kind == TM_JSON_REAL && work.tokens[zeros].real > 1.0)) { return TM_EXP_ERR_CHECK; }
            var results: i64 = tm_report_field(work, dataset, "results", 7, TM_JSON_ARRAY);
            if (results < 0 || work.tokens[results].first < 0) { return TM_EXP_ERR_CHECK; }
            var item: i64 = work.tokens[results].first;
            while (item >= 0) {
                if (work.tokens[item].kind != TM_JSON_OBJECT || tm_report_field(work, item, "codec", 5, TM_JSON_STRING) < 0) { return TM_EXP_ERR_CHECK; }
                if (tm_report_number(work, item, "group_size", 10) < 0 || tm_report_number(work, item, "group_bits", 10) < 0 || tm_report_number(work, item, "payload_bytes", 13) < 0 || tm_report_number(work, item, "container_bytes", 15) < 0) { return TM_EXP_ERR_CHECK; }
                if (tm_report_number(work, item, "payload_bpw", 11) < 0 || tm_report_number(work, item, "container_bpw", 13) < 0 || tm_report_number(work, item, "encode_ms", 9) < 0 || tm_report_number(work, item, "decode_ms", 9) < 0 || tm_report_number(work, item, "ideal_payload_ratio_vs_baseline", 31) < 0) { return TM_EXP_ERR_CHECK; }
                var roundtrip: i64 = tm_rpc_field(work, item, "roundtrip", 9);
                if (roundtrip < 0 || (work.tokens[roundtrip].kind != TM_JSON_TRUE && work.tokens[roundtrip].kind != TM_JSON_FALSE)) { return TM_EXP_ERR_CHECK; }
                item = work.tokens[item].next;
            }
            dataset = work.tokens[dataset].next;
        }
        return 0;
    }
    fn tm_report_script_json(writer: *TMJsonWriter, data: []u8, size: usize) -> void {
        var i: usize = 0;
        while (i < size) {
            var c: u8 = data[i];
            if (c == 38) { tm_bridge_text(writer, "\\u0026"); }
            else { if (c == 60) { tm_bridge_text(writer, "\\u003c"); }
            else { if (c == 62) { tm_bridge_text(writer, "\\u003e"); }
            else { if (i + 2 < size && c == 226 && data[i + 1] == 128 && (data[i + 2] == 168 || data[i + 2] == 169)) {
                if (data[i + 2] == 168) { tm_bridge_text(writer, "\\u2028"); } else { tm_bridge_text(writer, "\\u2029"); }
                i = i + 2;
            } else { tm_bridge_put(writer, c); } } } }
            i = i + 1;
        }
    }
    fn tm_report_benchmark_part0(writer: *TMJsonWriter) -> void {
        tm_bridge_text(writer, "<!doctype html>\n");
        tm_bridge_text(writer, "<html lang=\"ru\">\n");
        tm_bridge_text(writer, "<head>\n");
        tm_bridge_text(writer, "  <meta charset=\"utf-8\">\n");
        tm_bridge_text(writer, "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n");
        tm_bridge_text(writer, "  <meta name=\"color-scheme\" content=\"light\">\n");
        tm_bridge_text(writer, "  <title>Trinity Memory &#183; Benchmark Lab</title>\n");
        tm_bridge_text(writer, "  <style>\n");
        tm_bridge_text(writer, "    :root{--paper:#f5f4ed;--card:#fffef8;--ink:#192b29;--muted:#5b6c65;--line:#d8ddd3;--accent:#c3e65d;--green:#27594c;--orange:#c16b32;--red:#a53631;--mono:ui-monospace,SFMono-Regular,Consolas,monospace}\n");
        tm_bridge_text(writer, "    *{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}a{color:inherit;text-underline-offset:4px}a:hover{color:var(--green)}button,select{font:inherit}button{cursor:pointer}button:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid var(--orange);outline-offset:4px}.wrap{max-width:1260px;margin:auto;padding:0 40px}.top{display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line);padding:24px 0}.brand{font-weight:800;letter-spacing:.1em;font-size:17px;display:flex;align-items:center;gap:12px}.triangle{width:20px;height:20px;background:var(--green);clip-path:polygon(50% 0,100% 100%,0 100%)}.top nav{display:flex;gap:24px;font-size:13px}.eyebrow{font:11px/1.5 var(--mono);text-transform:uppercase;letter-spacing:.1em}.hero{display:grid;grid-template-columns:1.45fr 1fr;gap:64px;padding:62px 0 44px;align-items:center}.hero h1{font-size:clamp(35px,4.8vw,62px);font-weight:560;line-height:1.06;letter-spacing:-.055em;margin:19px 0 23px}.hero p{max-width:570px;color:var(--muted);font-size:17px;margin:0}.pill{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:30px;padding:7px 11px;font:11px var(--mono);background:var(--card)}.dot{width:6px;height:6px;border-radius:50%;background:var(--green)}.hero-graphic{background:var(--ink);color:var(--paper);border-radius:4px;padding:32px;min-height:244px;position:relative;overflow:hidden}.hero-graphic .eyebrow{color:#bacbbd}.ternary{display:flex;gap:10px;padding:22px 0}.ternary span{flex:1;border:1px solid #59736a;display:grid;place-items:center;aspect-ratio:1.12;font:clamp(32px,5vw,54px) var(--mono);border-radius:3px}.ternary span:nth-child(2){background:var(--accent);color:var(--ink);border-color:var(--accent)}.graphic-foot{display:flex;justify-content:space-between;gap:12px;font:11px var(--mono);color:#c7d0c8}.metrics{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);background:var(--card);margin:0 0 44px;border-radius:4px}.metric{padding:22px 24px;min-width:0}.metric+.metric{border-left:1px solid var(--line)}.metric-value{font:32px/1.1 var(--mono);letter-spacing:-.06em;margin:10px 0}.metric-detail{font-size:12px;color:var(--muted)}.section-head{display:flex;justify-content:space-between;gap:20px;align-items:flex-end;margin:0 0 20px}h2{font-size:26px;letter-spacing:-.03em;font-weight:550;margin:4px 0 0}h3{f");
        tm_bridge_text(writer, "ont-size:17px;margin:0 0 12px;font-weight:600}.section-head p{font-size:13px;color:var(--muted);margin:6px 0 0}.tabs{display:flex;gap:5px;flex-wrap:wrap}.tabs button{border:1px solid var(--line);border-radius:3px;background:transparent;padding:9px 15px;font:12px var(--mono);color:var(--muted)}.tabs button[aria-pressed=true]{background:var(--ink);border-color:var(--ink);color:var(--paper)}.panel{border:1px solid var(--line);border-radius:4px;background:var(--card);padding:26px}.measurement{display:grid;grid-template-columns:1.6fr 1fr;gap:20px}.chart-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:24px}.chart-title span{font:11px var(--mono);color:var(--muted)}.chart{display:grid;gap:15px}.bar-row{display:grid;grid-template-columns:80px 1fr 75px;gap:13px;align-items:center;font:12px var(--mono)}.bar-track{height:27px;background:#eef0e8;border-radius:2px;overflow:hidden}.bar-fill{height:100%;background:var(--green);width:0;transition:width .25s ease}.bar-fill.baseline{background:#aab5a6}.bar-fill.best{background:var(--accent)}.bar-value{text-align:right}.chart-note{font-size:12px;color:var(--muted);margin:21px 0 0}.dataset-card{background:#e9eddd;display:flex;flex-direction:column;justify-content:space-between}.dataset-card dl{margin:13px 0}.dataset-card dl>div{display:flex;justify-content:space-between;gap:15px;padding:11px 0;border-bottom:1px solid #cfd7c3;font-size:13px}.dataset-card dd{font:13px var(--mono);margin:0;text-align:right}.dataset-card p{font-size:12px;color:#455748;margin:8px 0 0}.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:4px;margin-top:20px;background:var(--card)}table{width:100%;border-collapse:collapse;white-space:nowrap}th{font:10px/1.6 var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:.04em;text-align:right;background:#eef0e7;padding:16px 17px;border-bottom:1px solid var(--line)}th:first-child,td:first-child{text-align:left}td{font:12px var(--mono);text-align:right;padding:15px 17px;border-bottom:1px solid #e8eadf}tbody tr:last-child td{border:0}td:first-child{font-weight:600}.ok{color:var(--green)}.fail{color:var(--red);font-weight:700}.table-caption{font-size:12px;color:var(--muted);margin:12px 0 43px}.experiment{margin-top:24px;padding:30px;background:var(--ink);border-radius:4px;color:var(--paper);display:grid;grid-template-columns:1.25fr 1fr;gap:50px}.experiment .eyebrow{color:var(--accent)}.experiment h2{margin:10px 0 12px}.experiment p{font-");
        tm_bridge_text(writer, "size:13px;color:#c7d0c8}.trits{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:24px 0 18px}.trit label{display:block;color:#b7c6b9;font:10px var(--mono);margin-bottom:7px}.trit select{width:100%;min-width:0;border:1px solid #677e70;border-radius:3px;color:var(--paper);background:#283e35;padding:12px 8px;font:22px var(--mono)}.trit small{display:block;text-align:center;font:10px var(--mono);margin-top:8px;color:#c8d2c6}.formula{font:12px/1.8 var(--mono);overflow-wrap:anywhere;min-height:43px}.byte-card{align-self:center;background:var(--accent);color:var(--ink);padding:24px;border-radius:3px}.byte-top{display:flex;justify-content:space-between;align-items:center;gap:16px}.byte-value{font:76px/1.2 var(--mono);letter-spacing:-.06em}.byte-hex{font:18px var(--mono)}.binary{display:grid;grid-template-columns:repeat(8,1fr);gap:5px;margin:15px 0}.binary span{text-align:center;padding:7px 0;background:#b2d250;border-radius:2px;font:18px var(--mono)}.byte-card p{color:#344a2d;font-size:12px;margin:12px 0 0}.byte-card code{font-family:var(--mono);font-size:11px}.note-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:32px 0 40px}.note{border-top:2px solid var(--ink);padding-top:17px}.note h3{font-size:15px}.note p{font-size:13px;color:var(--muted);margin:0}.tag{font:10px var(--mono);letter-spacing:.06em;display:block;margin-bottom:10px;color:var(--green)}footer{padding:23px 0 35px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:25px;font:11px/1.8 var(--mono);color:var(--muted)}footer .meta{max-width:75%;overflow-wrap:anywhere}.foot-title{font-weight:700;color:var(--ink)}.empty{padding:30px;background:var(--card);border:1px solid var(--line)}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n");
        tm_bridge_text(writer, "    @media(max-width:900px){.wrap{padding:0 24px}.hero{gap:28px;padding-top:40px}.hero-graphic{padding:24px;min-height:0}.section-head{align-items:flex-start;flex-direction:column}.measurement{grid-template-columns:1fr 1fr}.experiment{gap:25px;padding:24px}.trit select{font-size:18px;padding:10px 5px}.note-grid{gap:24px}.metric{padding:20px}.metric-value{font-size:27px}}\n");
        tm_bridge_text(writer, "    @media(max-width:660px){.wrap{padding:0 18px}.top{padding:18px 0}.top nav{gap:14px;font-size:11px}.brand{font-size:13px;gap:7px}.triangle{width:16px;height:16px}.hero{grid-template-columns:1fr;padding:36px 0 24px;gap:24px}.hero h1{font-size:44px}.hero p{font-size:15px}.hero-graphic{display:none}.metrics{grid-template-columns:1fr;margin-bottom:33px}.metric{padding:17px 20px;display:grid;grid-template-columns:1fr auto;gap:4px 12px;align-items:center}.metric+.metric{border-left:0;border-top:1px solid var(--line)}.metric-value{grid-column:2;grid-row:1/3;font-size:29px;margin:0}.metric-detail{font-size:11px}.measurement,.experiment,.note-grid{grid-template-columns:1fr}.panel{padding:20px}.bar-row{grid-template-columns:67px 1fr 63px;gap:9px;font-size:11px}.chart-title{margin-bottom:18px}.chart-title span{font-size:10px}.dataset-card dl>div{padding:8px 0}.experiment{padding:24px 20px;gap:22px}.trits{gap:7px}.byte-card{padding:20px}.byte-value{font-size:63px}.note-grid{gap:25px}.table-caption{margin-bottom:30px}footer{flex-direction:column;gap:8px}footer .meta{max-width:100%}}\n");
        tm_bridge_text(writer, "    @media(prefers-reduced-motion:reduce){.bar-fill{transition:none}}\n");
        tm_bridge_text(writer, "    @media print{body{background:white}.wrap{max-width:none;padding:0}.top nav,.tabs,.trits{display:none}.hero{padding:24px 0}.hero h1{font-size:38px}.hero-graphic{display:none}.hero{grid-template-columns:1fr}.measurement{grid-template-columns:1.5fr 1fr}.panel,.table-wrap,.experiment,.note{break-inside:avoid}.experiment{color:black;background:#eee}.experiment p{color:#333}.experiment .eyebrow{color:#333}.formula{color:black}table{white-space:normal}th,td{padding:9px 6px}.note-grid{gap:18px}footer{padding-bottom:0}}\n");
        tm_bridge_text(writer, "  </style>\n");
        tm_bridge_text(writer, "</head>\n");
        tm_bridge_text(writer, "<body>\n");
        tm_bridge_text(writer, "<div class=\"wrap\">\n");
        tm_bridge_text(writer, "  <header class=\"top\"><div class=\"brand\"><span class=\"triangle\" aria-hidden=\"true\"></span>TRINITY <span style=\"font-weight:400;letter-spacing:0;color:var(--muted)\">/ memory lab</span></div><nav aria-label=\"&#1044;&#1086;&#1082;&#1091;&#1084;&#1077;&#1085;&#1090;&#1072;&#1094;&#1080;&#1103;\"><a href=\"https://github.com/dmitrii-f-t27/trinity-memory/blob/master/README.md\">README &#8599;</a><a href=\"https://github.com/dmitrii-f-t27/trinity-memory/blob/master/docs/research.md\">Research &#8599;</a><a href=\"https://github.com/dmitrii-f-t27/trinity-memory/blob/master/docs/hardware.md\">RTL &#8599;</a></nav></header>\n");
        tm_bridge_text(writer, "  <main>\n");
        tm_bridge_text(writer, "    <section class=\"hero\" aria-labelledby=\"title\">\n");
        tm_bridge_text(writer, "      <div><span class=\"pill\"><span class=\"dot\" aria-hidden=\"true\"></span>SOFTWARE BENCHMARK &#183; LOCAL ARTIFACT</span><h1 id=\"title\">&#1058;&#1088;&#1086;&#1080;&#1095;&#1085;&#1072;&#1103; &#1087;&#1072;&#1084;&#1103;&#1090;&#1100;.<br>&#1048;&#1079;&#1084;&#1077;&#1088;&#1103;&#1077;&#1084; &#1074; &#1073;&#1080;&#1090;&#1072;&#1093;.</h1><p>&#1059;&#1087;&#1072;&#1082;&#1086;&#1074;&#1082;&#1072; &#1074;&#1077;&#1089;&#1086;&#1074; &#8722;1, 0, +1 &#1074; &#1076;&#1074;&#1086;&#1080;&#1095;&#1085;&#1091;&#1102; &#1087;&#1072;&#1084;&#1103;&#1090;&#1100;: &#1088;&#1072;&#1079;&#1084;&#1077;&#1088; &#1076;&#1072;&#1085;&#1085;&#1099;&#1093;, &#1086;&#1073;&#1088;&#1072;&#1090;&#1080;&#1084;&#1086;&#1089;&#1090;&#1100; &#1080; &#1074;&#1088;&#1077;&#1084;&#1103; &#1082;&#1086;&#1076;&#1080;&#1088;&#1086;&#1074;&#1072;&#1085;&#1080;&#1103;. &#1056;&#1077;&#1079;&#1091;&#1083;&#1100;&#1090;&#1072;&#1090;&#1099; &#1086;&#1076;&#1085;&#1086;&#1075;&#1086; &#1074;&#1086;&#1089;&#1087;&#1088;&#1086;&#1080;&#1079;&#1074;&#1086;&#1076;&#1080;&#1084;&#1086;&#1075;&#1086; &#1079;&#1072;&#1087;&#1091;&#1089;&#1082;&#1072;.</p></div>\n");
        tm_bridge_text(writer, "      <div class=\"hero-graphic\" aria-hidden=\"true\"><div class=\"eyebrow\">Three values &#183; one representation</div><div class=\"ternary\"><span>&#8722;1</span><span>0</span><span>+1</span></div><div class=\"graphic-foot\"><span>log&#8322;(3) &#8776; 1.585 bit / trit</span><span>DENSE LIMIT</span></div></div>\n");
        tm_bridge_text(writer, "    </section>\n");
        tm_bridge_text(writer, "    <div class=\"metrics\" aria-label=\"&#1055;&#1086;&#1082;&#1072;&#1079;&#1072;&#1090;&#1077;&#1083;&#1080; &#1074;&#1099;&#1073;&#1088;&#1072;&#1085;&#1085;&#1086;&#1075;&#1086; &#1085;&#1072;&#1073;&#1086;&#1088;&#1072;\">\n");
        tm_bridge_text(writer, "      <div class=\"metric\"><div class=\"eyebrow\">&#1052;&#1080;&#1085;&#1080;&#1084;&#1072;&#1083;&#1100;&#1085;&#1099;&#1081; payload</div><div class=\"metric-value\" id=\"best-bpw\">&#8212;</div><div class=\"metric-detail\" id=\"best-detail\">bits / weight &#183; &#1074;&#1099;&#1073;&#1088;&#1072;&#1085;&#1085;&#1099;&#1081; &#1085;&#1072;&#1073;&#1086;&#1088;</div></div>\n");
        tm_bridge_text(writer, "      <div class=\"metric\"><div class=\"eyebrow\">&#1069;&#1085;&#1090;&#1088;&#1086;&#1087;&#1080;&#1103; &#1086;&#1076;&#1085;&#1086;&#1075;&#1086; &#1074;&#1077;&#1089;&#1072;</div><div class=\"metric-value\" id=\"entropy\">&#8212;</div><div class=\"metric-detail\">&#1069;&#1084;&#1087;&#1080;&#1088;&#1080;&#1095;&#1077;&#1089;&#1082;&#1072;&#1103; H&#8321; = &#8722;&#931; p &#183; log&#8322;(p)</div></div>\n");
        tm_bridge_text(writer, "      <div class=\"metric\"><div class=\"eyebrow\">&#1054;&#1073;&#1088;&#1072;&#1090;&#1080;&#1084;&#1086;&#1089;&#1090;&#1100;</div><div class=\"metric-value\" id=\"roundtrip\">&#8212;</div><div class=\"metric-detail\">decode(encode(weights)) = weights</div></div>\n");
        tm_bridge_text(writer, "    </div>\n");
        tm_bridge_text(writer, "    <section aria-labelledby=\"benchmark-title\">\n");
        tm_bridge_text(writer, "      <div class=\"section-head\"><div><div class=\"eyebrow\">01 / Measured benchmark</div><h2 id=\"benchmark-title\">&#1057;&#1082;&#1086;&#1083;&#1100;&#1082;&#1086; &#1087;&#1072;&#1084;&#1103;&#1090;&#1080; &#1079;&#1072;&#1085;&#1080;&#1084;&#1072;&#1077;&#1090; &#1085;&#1072;&#1073;&#1086;&#1088;</h2><p>&#1042;&#1099;&#1073;&#1077;&#1088;&#1080;&#1090;&#1077; &#1088;&#1072;&#1089;&#1087;&#1088;&#1077;&#1076;&#1077;&#1083;&#1077;&#1085;&#1080;&#1077; &#1074;&#1077;&#1089;&#1086;&#1074;. &#1050;&#1086;&#1088;&#1086;&#1090;&#1082;&#1072;&#1103; &#1087;&#1086;&#1083;&#1086;&#1089;&#1072; &#1086;&#1079;&#1085;&#1072;&#1095;&#1072;&#1077;&#1090; &#1084;&#1077;&#1085;&#1100;&#1096;&#1080;&#1081; payload.</p></div><div class=\"tabs\" id=\"datasets\" aria-label=\"&#1042;&#1099;&#1073;&#1086;&#1088; &#1085;&#1072;&#1073;&#1086;&#1088;&#1072; &#1076;&#1072;&#1085;&#1085;&#1099;&#1093;\"></div></div>\n");
        tm_bridge_text(writer, "      <div class=\"measurement\">\n");
        tm_bridge_text(writer, "        <div class=\"panel\"><div class=\"chart-title\"><h3 style=\"margin:0\">Payload</h3><span>bit / weight &#8595;</span></div><div class=\"chart\" id=\"chart\" role=\"img\" aria-label=\"&#1056;&#1072;&#1079;&#1084;&#1077;&#1088; &#1076;&#1072;&#1085;&#1085;&#1099;&#1093; &#1087;&#1086; &#1082;&#1086;&#1076;&#1077;&#1082;&#1072;&#1084;\"></div><p class=\"chart-note\">&#1056;&#1072;&#1079;&#1084;&#1077;&#1088; payload &#1088;&#1072;&#1089;&#1089;&#1095;&#1080;&#1090;&#1072;&#1085; &#1080;&#1079; &#1092;&#1072;&#1082;&#1090;&#1080;&#1095;&#1077;&#1089;&#1082;&#1086;&#1081; &#1076;&#1083;&#1080;&#1085;&#1099; &#1073;&#1072;&#1081;&#1090;&#1086;&#1074;&#1086;&#1075;&#1086; &#1087;&#1086;&#1090;&#1086;&#1082;&#1072;: bytes &#215; 8 / weights. &#1047;&#1072;&#1075;&#1086;&#1083;&#1086;&#1074;&#1086;&#1082; &#1082;&#1086;&#1085;&#1090;&#1077;&#1081;&#1085;&#1077;&#1088;&#1072; &#1091;&#1095;&#1090;&#1105;&#1085; &#1086;&#1090;&#1076;&#1077;&#1083;&#1100;&#1085;&#1086;.</p></div>\n");
        tm_bridge_text(writer, "        <aside class=\"panel dataset-card\" aria-labelledby=\"dataset-title\"><div><div class=\"eyebrow\">Dataset profile</div><h3 id=\"dataset-title\" style=\"margin-top:9px\">&#8212;</h3><dl><div><dt>&#1042;&#1077;&#1089;&#1086;&#1074;</dt><dd id=\"count\">&#8212;</dd></div><div><dt>&#1044;&#1086;&#1083;&#1103; &#1085;&#1091;&#1083;&#1077;&#1081;</dt><dd id=\"zeros\">&#8212;</dd></div><div><dt>Seed</dt><dd id=\"seed\">&#8212;</dd></div><div><dt>&#1055;&#1086;&#1074;&#1090;&#1086;&#1088;&#1086;&#1074; &#1079;&#1072;&#1084;&#1077;&#1088;&#1072;</dt><dd id=\"repeats\">&#8212;</dd></div></dl></div><p id=\"dataset-note\"></p></aside>\n");
        tm_bridge_text(writer, "      </div>\n");
        tm_bridge_text(writer, "      <div class=\"table-wrap\"><table><caption class=\"sr-only\">&#1048;&#1079;&#1084;&#1077;&#1088;&#1077;&#1085;&#1085;&#1099;&#1077; &#1088;&#1072;&#1079;&#1084;&#1077;&#1088;&#1099; &#1080; &#1074;&#1088;&#1077;&#1084;&#1103; &#1088;&#1072;&#1073;&#1086;&#1090;&#1099; &#1082;&#1086;&#1076;&#1077;&#1082;&#1086;&#1074;</caption><thead><tr><th scope=\"col\">Codec<br>group &#8594; bits</th><th scope=\"col\">Payload<br>bytes</th><th scope=\"col\">Container<br>bytes</th><th scope=\"col\">Container<br>bit / weight</th><th scope=\"col\">Encode<br>ms</th><th scope=\"col\">Decode<br>ms</th><th scope=\"col\">Payload ratio&#185;<br>vs baseline</th><th scope=\"col\">Roundtrip</th></tr></thead><tbody id=\"results\"></tbody></table></div>\n");
        tm_bridge_text(writer, "      <p class=\"table-caption\">&#185; Payload ratio = &#1092;&#1072;&#1082;&#1090;&#1080;&#1095;&#1077;&#1089;&#1082;&#1080;&#1077; bytes baseline2 / bytes &#1082;&#1086;&#1076;&#1077;&#1082;&#1072;, &#1074;&#1082;&#1083;&#1102;&#1095;&#1072;&#1103; padding &#1080; &#1080;&#1089;&#1082;&#1083;&#1102;&#1095;&#1072;&#1103; &#1079;&#1072;&#1075;&#1086;&#1083;&#1086;&#1074;&#1082;&#1080;. &#1055;&#1088;&#1080; &#1085;&#1077;&#1080;&#1079;&#1084;&#1077;&#1085;&#1085;&#1086;&#1081; &#1087;&#1088;&#1086;&#1087;&#1091;&#1089;&#1082;&#1085;&#1086;&#1081; &#1089;&#1087;&#1086;&#1089;&#1086;&#1073;&#1085;&#1086;&#1089;&#1090;&#1080; &#1101;&#1090;&#1086; &#1088;&#1072;&#1089;&#1095;&#1105;&#1090;&#1085;&#1099;&#1081; &#1087;&#1088;&#1077;&#1076;&#1077;&#1083; &#1091;&#1089;&#1082;&#1086;&#1088;&#1077;&#1085;&#1080;&#1103; &#1087;&#1077;&#1088;&#1077;&#1076;&#1072;&#1095;&#1080; payload; &#1086;&#1085; &#1085;&#1077; &#1080;&#1079;&#1084;&#1077;&#1088;&#1103;&#1077;&#1090; FPGA. &#1042;&#1088;&#1077;&#1084;&#1103; Encode / Decode &#1086;&#1090;&#1085;&#1086;&#1089;&#1080;&#1090;&#1089;&#1103; &#1082; &#1089;&#1088;&#1077;&#1076;&#1077; &#1074;&#1099;&#1087;&#1086;&#1083;&#1085;&#1077;&#1085;&#1080;&#1103;, &#1091;&#1082;&#1072;&#1079;&#1072;&#1085;&#1085;&#1086;&#1081; &#1074; &#1084;&#1077;&#1090;&#1072;&#1076;&#1072;&#1085;&#1085;&#1099;&#1093; &#1079;&#1072;&#1087;&#1091;&#1089;&#1082;&#1072;.</p>\n");
        tm_bridge_text(writer, "    </section>\n");
        tm_bridge_text(writer, "    <section class=\"experiment\" aria-labelledby=\"encoder-title\">\n");
        tm_bridge_text(writer, "      <div><div class=\"eyebrow\">02 / Interactive codec</div><h2 id=\"encoder-title\">&#1055;&#1103;&#1090;&#1100; &#1090;&#1088;&#1080;&#1090;&#1086;&#1074; &#8594; &#1086;&#1076;&#1080;&#1085; &#1073;&#1072;&#1081;&#1090;</h2><p>&#1050;&#1072;&#1078;&#1076;&#1099;&#1081; &#1074;&#1077;&#1089; t &#1087;&#1088;&#1077;&#1074;&#1088;&#1072;&#1097;&#1072;&#1077;&#1090;&#1089;&#1103; &#1074; &#1094;&#1080;&#1092;&#1088;&#1091; d = t + 1. &#1055;&#1077;&#1088;&#1074;&#1099;&#1081; &#1090;&#1088;&#1080;&#1090; &#1079;&#1072;&#1085;&#1080;&#1084;&#1072;&#1077;&#1090; &#1084;&#1083;&#1072;&#1076;&#1096;&#1080;&#1081; &#1088;&#1072;&#1079;&#1088;&#1103;&#1076;: byte = &#931; d&#7522; &#215; 3&#8305;.</p><div class=\"trits\" id=\"trits\"></div><div class=\"formula\" id=\"formula\" aria-live=\"polite\"></div></div>\n");
        tm_bridge_text(writer, "      <div class=\"byte-card\"><div class=\"eyebrow\" style=\"color:var(--ink)\">Encoded byte &#183; 0&#8230;242</div><div class=\"byte-top\"><output class=\"byte-value\" id=\"byte-decimal\" aria-label=\"&#1041;&#1072;&#1081;&#1090; &#1074; &#1076;&#1077;&#1089;&#1103;&#1090;&#1080;&#1095;&#1085;&#1086;&#1081; &#1092;&#1086;&#1088;&#1084;&#1077;\">&#8212;</output><span class=\"byte-hex\" id=\"byte-hex\">&#8212;</span></div><div class=\"binary\" id=\"binary\" aria-label=\"&#1041;&#1072;&#1081;&#1090; &#1074; &#1076;&#1074;&#1086;&#1080;&#1095;&#1085;&#1086;&#1081; &#1092;&#1086;&#1088;&#1084;&#1077;\"></div><code id=\"rtl-lanes\"></code><p>RTL lane: 00 = 0, 01 = +1, 10 = &#8722;1; 11 &#1085;&#1077;&#1076;&#1086;&#1087;&#1091;&#1089;&#1090;&#1080;&#1084;&#1086;. &#1069;&#1090;&#1086; &#1087;&#1088;&#1077;&#1076;&#1089;&#1090;&#1072;&#1074;&#1083;&#1077;&#1085;&#1080;&#1077; &#1090;&#1088;&#1080;&#1090;&#1072; &#1085;&#1072; &#1074;&#1099;&#1093;&#1086;&#1076;&#1077; RTL-&#1076;&#1077;&#1082;&#1086;&#1076;&#1077;&#1088;&#1072;. &#1041;&#1072;&#1081;&#1090;&#1099; 243&#8230;255 &#1085;&#1077; &#1082;&#1086;&#1076;&#1080;&#1088;&#1091;&#1102;&#1090; &#1087;&#1103;&#1090;&#1100; &#1090;&#1088;&#1080;&#1090;&#1086;&#1074;.</p></div>\n");
        tm_bridge_text(writer, "    </section>\n");
        tm_bridge_text(writer, "    <section class=\"note-grid\" aria-label=\"&#1043;&#1088;&#1072;&#1085;&#1080;&#1094;&#1099; &#1074;&#1099;&#1074;&#1086;&#1076;&#1086;&#1074;\">\n");
        tm_bridge_text(writer, "      <div class=\"note\"><span class=\"tag\">MEASURED / SOFTWARE</span><h3>&#1041;&#1072;&#1081;&#1090;&#1099; &#1080; &#1074;&#1088;&#1077;&#1084;&#1103; &#1074;&#1099;&#1087;&#1086;&#1083;&#1085;&#1077;&#1085;&#1080;&#1103;</h3><p id=\"scope\"></p></div>\n");
        tm_bridge_text(writer, "      <div class=\"note\"><span class=\"tag\">CALCULATED / MODEL</span><h3>&#1058;&#1077;&#1086;&#1088;&#1077;&#1090;&#1080;&#1095;&#1077;&#1089;&#1082;&#1072;&#1103; &#1087;&#1083;&#1086;&#1090;&#1085;&#1086;&#1089;&#1090;&#1100;</h3><p>&#1044;&#1083;&#1103; &#1088;&#1072;&#1074;&#1085;&#1086;&#1074;&#1077;&#1088;&#1086;&#1103;&#1090;&#1085;&#1099;&#1093; &#1085;&#1077;&#1079;&#1072;&#1074;&#1080;&#1089;&#1080;&#1084;&#1099;&#1093; &#1090;&#1088;&#1080;&#1090;&#1086;&#1074; &#1087;&#1088;&#1077;&#1076;&#1077;&#1083; &#8212; log&#8322;(3) &#8776; 1.585 bit / weight. &#1055;&#1083;&#1086;&#1090;&#1085;&#1086;&#1089;&#1090;&#1100; &#1092;&#1080;&#1082;&#1089;&#1080;&#1088;&#1086;&#1074;&#1072;&#1085;&#1085;&#1086;&#1081; &#1075;&#1088;&#1091;&#1087;&#1087;&#1099; &#8212; group_bits / group_size. &#1069;&#1084;&#1087;&#1080;&#1088;&#1080;&#1095;&#1077;&#1089;&#1082;&#1072;&#1103; H&#8321; &#1086;&#1087;&#1080;&#1089;&#1099;&#1074;&#1072;&#1077;&#1090; &#1095;&#1072;&#1089;&#1090;&#1086;&#1090;&#1099; &#1086;&#1076;&#1085;&#1086;&#1075;&#1086; &#1074;&#1077;&#1089;&#1072;; &#1086;&#1085;&#1072; &#1085;&#1077; &#1091;&#1095;&#1080;&#1090;&#1099;&#1074;&#1072;&#1077;&#1090; &#1089;&#1074;&#1103;&#1079;&#1080; &#1084;&#1077;&#1078;&#1076;&#1091; &#1074;&#1077;&#1089;&#1072;&#1084;&#1080; &#1089;&#1090;&#1088;&#1091;&#1082;&#1090;&#1091;&#1088;&#1080;&#1088;&#1086;&#1074;&#1072;&#1085;&#1085;&#1086;&#1075;&#1086; &#1085;&#1072;&#1073;&#1086;&#1088;&#1072;.</p></div>\n");
        tm_bridge_text(writer, "      <div class=\"note\"><span class=\"tag\">UNMEASURED / HARDWARE</span><h3>&#1056;&#1077;&#1079;&#1091;&#1083;&#1100;&#1090;&#1072;&#1090;&#1099; FPGA &#1074;&#1087;&#1077;&#1088;&#1077;&#1076;&#1080;</h3><p>DDR bandwidth, LUT, Fmax, &#1101;&#1085;&#1077;&#1088;&#1075;&#1086;&#1087;&#1086;&#1090;&#1088;&#1077;&#1073;&#1083;&#1077;&#1085;&#1080;&#1077; &#1080; LLM inference &#1079;&#1076;&#1077;&#1089;&#1100; &#1085;&#1077; &#1080;&#1079;&#1084;&#1077;&#1088;&#1077;&#1085;&#1099;. &#1042; &#1092;&#1086;&#1088;&#1084;&#1072;&#1090;&#1077; dense17/dense22 &#1093;&#1088;&#1072;&#1085;&#1103;&#1090;&#1089;&#1103; &#1085;&#1077;&#1087;&#1088;&#1077;&#1088;&#1099;&#1074;&#1085;&#1099;&#1084; &#1087;&#1086;&#1090;&#1086;&#1082;&#1086;&#1084; &#1073;&#1080;&#1090;&#1086;&#1074;. &#1060;&#1080;&#1079;&#1080;&#1095;&#1077;&#1089;&#1082;&#1072;&#1103; &#1091;&#1082;&#1083;&#1072;&#1076;&#1082;&#1072; &#1074; BRAM &#1080; &#1080;&#1079;&#1084;&#1077;&#1088;&#1077;&#1085;&#1080;&#1103; &#1085;&#1072; &#1087;&#1083;&#1072;&#1090;&#1077; &#1090;&#1088;&#1077;&#1073;&#1091;&#1102;&#1090; &#1086;&#1090;&#1076;&#1077;&#1083;&#1100;&#1085;&#1086;&#1081; &#1087;&#1088;&#1086;&#1074;&#1077;&#1088;&#1082;&#1080;.</p></div>\n");
        tm_bridge_text(writer, "    </section>\n");
        tm_bridge_text(writer, "  </main>\n");
        tm_bridge_text(writer, "  <footer><div class=\"meta\"><span class=\"foot-title\">SOURCE: <a href=\"benchmark.json\">benchmark.json</a></span><br><span id=\"generated\"></span><br><span id=\"environment\"></span></div><div>TRINITY / TERNARY MEMORY<br>Self-contained report &#183; schema v1</div></footer>\n");
        tm_bridge_text(writer, "  <noscript><p class=\"empty\">&#1044;&#1083;&#1103; &#1080;&#1085;&#1090;&#1077;&#1088;&#1072;&#1082;&#1090;&#1080;&#1074;&#1085;&#1086;&#1075;&#1086; &#1086;&#1090;&#1095;&#1105;&#1090;&#1072; &#1074;&#1082;&#1083;&#1102;&#1095;&#1080;&#1090;&#1077; JavaScript. &#1048;&#1089;&#1093;&#1086;&#1076;&#1085;&#1099;&#1077; &#1080;&#1079;&#1084;&#1077;&#1088;&#1077;&#1085;&#1080;&#1103; &#1076;&#1086;&#1089;&#1090;&#1091;&#1087;&#1085;&#1099; &#1074; <a href=\"benchmark.json\">benchmark.json</a>.</p></noscript>\n");
        tm_bridge_text(writer, "</div>\n");
        tm_bridge_text(writer, "<script type=\"application/json\" id=\"benchmark-data\">");
    }
    fn tm_report_benchmark_part1(writer: *TMJsonWriter) -> void {
        tm_bridge_text(writer, "</script>\n");
        tm_bridge_text(writer, "<script>\n");
        tm_bridge_text(writer, "\"use strict\";\n");
        tm_bridge_text(writer, "const data = JSON.parse(document.getElementById(\"benchmark-data\").textContent);\n");
        tm_bridge_text(writer, "const $ = id => document.getElementById(id);\n");
        tm_bridge_text(writer, "const num = (v, digits = 3) => new Intl.NumberFormat(\"en-US\", {minimumFractionDigits: digits, maximumFractionDigits: digits}).format(v);\n");
        tm_bridge_text(writer, "const int = v => new Intl.NumberFormat(\"en-US\", {maximumFractionDigits: 0}).format(v);\n");
        tm_bridge_text(writer, "function node(tag, text, className) { const n = document.createElement(tag); if (text !== undefined) n.textContent = text; if (className) n.className = className; return n; }\n");
        tm_bridge_text(writer, "const datasetDescriptions = {\n");
        tm_bridge_text(writer, "  uniform: \"\\u0421\\u0438\\u043d\\u0442\\u0435\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0439 \\u043d\\u0430\\u0431\\u043e\\u0440 \\u0441 \\u0440\\u0430\\u0432\\u043d\\u043e\\u0432\\u0435\\u0440\\u043e\\u044f\\u0442\\u043d\\u043e\\u0439 \\u0433\\u0435\\u043d\\u0435\\u0440\\u0430\\u0446\\u0438\\u0435\\u0439 \\u22121, 0, +1. \\u0424\\u0430\\u043a\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0430\\u044f \\u0434\\u043e\\u043b\\u044f \\u043d\\u0443\\u043b\\u0435\\u0439 \\u0438 \\u044d\\u043c\\u043f\\u0438\\u0440\\u0438\\u0447\\u0435\\u0441\\u043a\\u0430\\u044f \\u044d\\u043d\\u0442\\u0440\\u043e\\u043f\\u0438\\u044f \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u043d\\u044b \\u0432\\u044b\\u0448\\u0435.\",\n");
        tm_bridge_text(writer, "  sparse_4_1: \"\\u0421\\u0442\\u0440\\u0443\\u043a\\u0442\\u0443\\u0440\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u0439 \\u043d\\u0430\\u0431\\u043e\\u0440: \\u0432 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0439 \\u0433\\u0440\\u0443\\u043f\\u043f\\u0435 \\u0438\\u0437 4 \\u0432\\u0435\\u0441\\u043e\\u0432 \\u0434\\u043e\\u043f\\u0443\\u0441\\u043a\\u0430\\u0435\\u0442\\u0441\\u044f \\u043d\\u0435 \\u0431\\u043e\\u043b\\u0435\\u0435 1 \\u043d\\u0435\\u043d\\u0443\\u043b\\u0435\\u0432\\u043e\\u0433\\u043e \\u0432\\u0435\\u0441\\u0430. \\u0421\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0437\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u0439 \\u043a\\u043e\\u0434\\u0435\\u043a \\u043f\\u0440\\u0438\\u043c\\u0435\\u043d\\u0438\\u043c \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043a \\u0441\\u043e\\u0432\\u043c\\u0435\\u0441\\u0442\\u0438\\u043c\\u043e\\u0439 \\u0441\\u0442\\u0440\\u0443\\u043a\\u0442\\u0443\\u0440\\u0435.\",\n");
        tm_bridge_text(writer, "  sparse_8_2: \"\\u0421\\u0442\\u0440\\u0443\\u043a\\u0442\\u0443\\u0440\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u0439 \\u043d\\u0430\\u0431\\u043e\\u0440: \\u0432 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0439 \\u0433\\u0440\\u0443\\u043f\\u043f\\u0435 \\u0438\\u0437 8 \\u0432\\u0435\\u0441\\u043e\\u0432 \\u0434\\u043e\\u043f\\u0443\\u0441\\u043a\\u0430\\u0435\\u0442\\u0441\\u044f \\u043d\\u0435 \\u0431\\u043e\\u043b\\u0435\\u0435 2 \\u043d\\u0435\\u043d\\u0443\\u043b\\u0435\\u0432\\u044b\\u0445 \\u0432\\u0435\\u0441\\u043e\\u0432. \\u0421\\u043f\\u0435\\u0446\\u0438\\u0430\\u043b\\u0438\\u0437\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u0439 \\u043a\\u043e\\u0434\\u0435\\u043a \\u043f\\u0440\\u0438\\u043c\\u0435\\u043d\\u0438\\u043c \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043a \\u0441\\u043e\\u0432\\u043c\\u0435\\u0441\\u0442\\u0438\\u043c\\u043e\\u0439 \\u0441\\u0442\\u0440\\u0443\\u043a\\u0442\\u0443\\u0440\\u0435.\"\n");
        tm_bridge_text(writer, "};\n");
        tm_bridge_text(writer, "const buttons = data.datasets.map((dataset, index) => {\n");
        tm_bridge_text(writer, "  const button = node(\"button\", dataset.name); button.type = \"button\"; button.setAttribute(\"aria-pressed\", \"false\"); button.addEventListener(\"click\", () => showDataset(index)); $(\"datasets\").appendChild(button); return button;\n");
        tm_bridge_text(writer, "});\n");
        tm_bridge_text(writer, "function showDataset(index) {\n");
        tm_bridge_text(writer, "  const dataset = data.datasets[index];\n");
        tm_bridge_text(writer, "  buttons.forEach((button, i) => button.setAttribute(\"aria-pressed\", String(i === index)));\n");
        tm_bridge_text(writer, "  const best = dataset.results.reduce((a, b) => a.payload_bpw <= b.payload_bpw ? a : b);\n");
        tm_bridge_text(writer, "  $(\"best-bpw\").textContent = num(best.payload_bpw);\n");
        tm_bridge_text(writer, "  $(\"best-detail\").textContent = `${best.codec} \\u00b7 bit / weight \\u00b7 payload`;\n");
        tm_bridge_text(writer, "  $(\"entropy\").textContent = num(dataset.entropy_bpw);\n");
        tm_bridge_text(writer, "  const passed = dataset.results.filter(r => r.roundtrip).length;\n");
        tm_bridge_text(writer, "  $(\"roundtrip\").textContent = `${passed} / ${dataset.results.length}`;\n");
        tm_bridge_text(writer, "  $(\"roundtrip\").classList.toggle(\"fail\", passed !== dataset.results.length);\n");
        tm_bridge_text(writer, "  $(\"dataset-title\").textContent = dataset.name;\n");
        tm_bridge_text(writer, "  $(\"count\").textContent = int(dataset.count);\n");
        tm_bridge_text(writer, "  $(\"zeros\").textContent = `${num(dataset.zero_fraction * 100, 2)}%`;\n");
        tm_bridge_text(writer, "  $(\"seed\").textContent = data.seed ?? \"\\u041d\\u0435 \\u0443\\u043a\\u0430\\u0437\\u0430\\u043d\";\n");
        tm_bridge_text(writer, "  $(\"repeats\").textContent = data.repeats ?? \"\\u041d\\u0435 \\u0443\\u043a\\u0430\\u0437\\u0430\\u043d\\u044b\";\n");
        tm_bridge_text(writer, "  $(\"dataset-note\").textContent = datasetDescriptions[dataset.name] ?? \"\\u041f\\u0430\\u0440\\u0430\\u043c\\u0435\\u0442\\u0440\\u044b \\u044d\\u0442\\u043e\\u0433\\u043e \\u043d\\u0430\\u0431\\u043e\\u0440\\u0430 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0435\\u043d\\u044b \\u0432 \\u0438\\u0441\\u0445\\u043e\\u0434\\u043d\\u043e\\u043c benchmark.json.\";\n");
        tm_bridge_text(writer, "  $(\"chart\").replaceChildren(); $(\"results\").replaceChildren();\n");
        tm_bridge_text(writer, "  const ceiling = Math.max(2, ...dataset.results.map(r => r.payload_bpw));\n");
        tm_bridge_text(writer, "  const labels = [];\n");
        tm_bridge_text(writer, "  dataset.results.forEach(result => {\n");
        tm_bridge_text(writer, "    const bar = node(\"div\", undefined, \"bar-row\");\n");
        tm_bridge_text(writer, "    bar.appendChild(node(\"span\", result.codec));\n");
        tm_bridge_text(writer, "    const track = node(\"div\", undefined, \"bar-track\");\n");
        tm_bridge_text(writer, "    const fill = node(\"div\", undefined, \"bar-fill\");\n");
        tm_bridge_text(writer, "    fill.classList.toggle(\"baseline\", result.codec === \"baseline2\");\n");
        tm_bridge_text(writer, "    fill.classList.toggle(\"best\", result.payload_bpw === best.payload_bpw && result.codec !== \"baseline2\");\n");
        tm_bridge_text(writer, "    fill.style.width = `${100 * result.payload_bpw / ceiling}%`;\n");
        tm_bridge_text(writer, "    track.appendChild(fill); bar.appendChild(track); bar.appendChild(node(\"span\", num(result.payload_bpw), \"bar-value\")); $(\"chart\").appendChild(bar);\n");
        tm_bridge_text(writer, "    labels.push(`${result.codec}: ${num(result.payload_bpw)} bit / weight`);\n");
        tm_bridge_text(writer, "    const row = node(\"tr\");\n");
        tm_bridge_text(writer, "    const codec = node(\"td\"); codec.appendChild(node(\"span\", result.codec)); codec.appendChild(node(\"br\")); const group = node(\"small\", `${result.group_size} \\u2192 ${result.group_bits}`); group.style.color = \"var(--muted)\"; codec.appendChild(group); row.appendChild(codec);\n");
        tm_bridge_text(writer, "    [int(result.payload_bytes), int(result.container_bytes), num(result.container_bpw), num(result.encode_ms), num(result.decode_ms), `${num(result.ideal_payload_ratio_vs_baseline, 2)}\\u00d7`].forEach(value => row.appendChild(node(\"td\", value)));\n");
        tm_bridge_text(writer, "    row.appendChild(node(\"td\", result.roundtrip ? \"PASS\" : \"FAIL\", result.roundtrip ? \"ok\" : \"fail\")); $(\"results\").appendChild(row);\n");
        tm_bridge_text(writer, "  });\n");
        tm_bridge_text(writer, "  $(\"chart\").setAttribute(\"aria-label\", `Payload, ${dataset.name}. ${labels.join(\". \")}`);\n");
        tm_bridge_text(writer, "}\n");
        tm_bridge_text(writer, "$(\"scope\").textContent = data.measurement_scope || \"\\u0418\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u044b \\u0444\\u0430\\u043a\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0435 \\u0440\\u0430\\u0437\\u043c\\u0435\\u0440\\u044b \\u0441\\u0435\\u0440\\u0438\\u0430\\u043b\\u0438\\u0437\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u0433\\u043e \\u043f\\u043e\\u0442\\u043e\\u043a\\u0430 \\u0438 \\u0432\\u0440\\u0435\\u043c\\u044f encode/decode \\u043d\\u0430 \\u043b\\u043e\\u043a\\u0430\\u043b\\u044c\\u043d\\u043e\\u0439 \\u043c\\u0430\\u0448\\u0438\\u043d\\u0435. \\u041e\\u0431\\u043b\\u0430\\u0441\\u0442\\u044c \\u0437\\u0430\\u043c\\u0435\\u0440\\u0430 \\u043d\\u0435 \\u0443\\u0442\\u043e\\u0447\\u043d\\u0435\\u043d\\u0430 \\u0432 \\u0438\\u0441\\u0445\\u043e\\u0434\\u043d\\u043e\\u043c \\u0444\\u0430\\u0439\\u043b\\u0435.\";\n");
        tm_bridge_text(writer, "$(\"generated\").textContent = `Generated: ${data.generated_at || \"\\u043d\\u0435 \\u0443\\u043a\\u0430\\u0437\\u0430\\u043d\\u043e\"} \\u00b7 seed ${data.seed ?? \"\\u043d\\u0435 \\u0443\\u043a\\u0430\\u0437\\u0430\\u043d\"} \\u00b7 repeats ${data.repeats ?? \"\\u043d\\u0435 \\u0443\\u043a\\u0430\\u0437\\u0430\\u043d\\u044b\"}`;\n");
        tm_bridge_text(writer, "$(\"environment\").textContent = `${data.environment?.runtime || (data.environment?.python ? \"Python \" + data.environment.python : \"runtime \\u043d\\u0435 \\u0443\\u043a\\u0430\\u0437\\u0430\\u043d\")} \\u00b7 ${data.environment?.platform || \"\\u043f\\u043b\\u0430\\u0442\\u0444\\u043e\\u0440\\u043c\\u0430 \\u043d\\u0435 \\u0443\\u043a\\u0430\\u0437\\u0430\\u043d\\u0430\"}`;\n");
        tm_bridge_text(writer, "const startingTrits = [-1, 0, 1, 0, -1];\n");
        tm_bridge_text(writer, "const selects = startingTrits.map((value, index) => {\n");
        tm_bridge_text(writer, "  const holder = node(\"div\", undefined, \"trit\");\n");
        tm_bridge_text(writer, "  const label = node(\"label\", `t${index} \\u00b7 3^${index}`); label.htmlFor = `trit-${index}`; holder.appendChild(label);\n");
        tm_bridge_text(writer, "  const select = node(\"select\"); select.id = `trit-${index}`;\n");
        tm_bridge_text(writer, "  [-1, 0, 1].forEach(trit => { const option = node(\"option\", trit === 1 ? \"+1\" : trit === -1 ? \"\\u22121\" : \"0\"); option.value = trit; select.appendChild(option); });\n");
        tm_bridge_text(writer, "  select.value = value; select.addEventListener(\"change\", encodeExample); holder.appendChild(select); holder.appendChild(node(\"small\", `\\u00d7 ${3 ** index}`)); $(\"trits\").appendChild(holder); return select;\n");
        tm_bridge_text(writer, "});\n");
        tm_bridge_text(writer, "let codecWasm = null;\n");
        tm_bridge_text(writer, "let codecFailure = null;\n");
        tm_bridge_text(writer, "function encodeExample() {\n");
        tm_bridge_text(writer, "  if (!codecWasm) {\n");
        tm_bridge_text(writer, "    $(\"byte-decimal\").textContent = codecFailure ? \"ERROR\" : \"...\";\n");
        tm_bridge_text(writer, "    $(\"byte-hex\").textContent = \"\";\n");
        tm_bridge_text(writer, "    $(\"formula\").textContent = codecFailure || \"Loading native t27 WebAssembly codec...\";\n");
        tm_bridge_text(writer, "    $(\"binary\").replaceChildren(); $(\"rtl-lanes\").textContent = \"\";\n");
        tm_bridge_text(writer, "    return;\n");
        tm_bridge_text(writer, "  }\n");
        tm_bridge_text(writer, "  try {\n");
        tm_bridge_text(writer, "    const trits = selects.map(select => Number(select.value));\n");
        tm_bridge_text(writer, "    const digits = trits.map(t => t + 1);\n");
        tm_bridge_text(writer, "    const valuesPointer = codecWasm.tm_wasm_values();\n");
        tm_bridge_text(writer, "    const outputPointer = codecWasm.tm_wasm_output();\n");
        tm_bridge_text(writer, "    new Int32Array(codecWasm.memory.buffer, valuesPointer, 5).set(trits);\n");
        tm_bridge_text(writer, "    if (codecWasm.tm_encode(1, valuesPointer, 5, outputPointer, 8) !== 1n) throw new Error(\"Native dense5 rejected input\");\n");
        tm_bridge_text(writer, "    const byte = new Uint8Array(codecWasm.memory.buffer, outputPointer, 1)[0];\n");
        tm_bridge_text(writer, "    $(\"byte-decimal\").textContent = byte; $(\"byte-hex\").textContent = `0x${byte.toString(16).toUpperCase().padStart(2, \"0\")}`;\n");
        tm_bridge_text(writer, "    $(\"formula\").textContent = digits.map((digit, index) => `${digit} x ${3 ** index}`).join(\" + \") + ` = ${byte}`;\n");
        tm_bridge_text(writer, "    const bits = byte.toString(2).padStart(8, \"0\"); $(\"binary\").replaceChildren(...[...bits].map(bit => node(\"span\", bit))); $(\"binary\").setAttribute(\"aria-label\", `Binary: ${bits}`);\n");
        tm_bridge_text(writer, "    if (codecWasm.tm_encode(0, valuesPointer, 5, outputPointer, 8) !== 2n) throw new Error(\"Native baseline2 rejected input\");\n");
        tm_bridge_text(writer, "    const packed = new Uint8Array(codecWasm.memory.buffer, outputPointer, 2);\n");
        tm_bridge_text(writer, "    const lanes = Array.from({length: 5}, (_, i) => ((packed[Math.floor(i / 4)] >> (2 * (i % 4))) & 3).toString(2).padStart(2, \"0\"));\n");
        tm_bridge_text(writer, "    $(\"rtl-lanes\").textContent = \"RTL lanes t0 -> t4: \" + lanes.join(\" / \");\n");
        tm_bridge_text(writer, "  } catch (error) {\n");
        tm_bridge_text(writer, "    codecWasm = null; codecFailure = `Native WebAssembly codec error: ${error.message}`; encodeExample();\n");
        tm_bridge_text(writer, "  }\n");
        tm_bridge_text(writer, "}\n");
        tm_bridge_text(writer, "showDataset(0); encodeExample();\n");
        tm_bridge_text(writer, "(async () => {\n");
        tm_bridge_text(writer, "  try {\n");
        tm_bridge_text(writer, "    const encoded = \"");
    }
    fn tm_report_benchmark_part2(writer: *TMJsonWriter) -> void {
        tm_bridge_text(writer, "\";\n");
        tm_bridge_text(writer, "    const bytes = Uint8Array.from(atob(encoded), character => character.charCodeAt(0));\n");
        tm_bridge_text(writer, "    const result = await WebAssembly.instantiate(bytes, {});\n");
        tm_bridge_text(writer, "    codecWasm = result.instance.exports;\n");
        tm_bridge_text(writer, "    encodeExample();\n");
        tm_bridge_text(writer, "  } catch (error) {\n");
        tm_bridge_text(writer, "    codecFailure = `Native WebAssembly codec unavailable: ${error.message}`; encodeExample();\n");
        tm_bridge_text(writer, "  }\n");
        tm_bridge_text(writer, "})();\n");
        tm_bridge_text(writer, "</script>\n");
        tm_bridge_text(writer, "</body>\n");
        tm_bridge_text(writer, "</html>\n");
    }

    fn tm_report_benchmark_html(data: []u8, size: usize, out: []u8, capacity: usize) -> i64 {
        if (size > 16777216) { return TM_RPC_ERR_LIMIT as i64; }
        var work: *TMRPCWorkspace = tm_runtime_rpc_new(size);
        if (work == 0) { return TM_EXP_ERR_RESOURCE as i64; }
        var status: i32 = tm_rpc_parse(data, size, work);
        if (status == 0) { status = tm_report_validate_benchmark(work); }
        tm_runtime_rpc_free(work);
        if (status != 0) { return status as i64; }
        var wasm: *u8 = tm_report_wasm_base64(); var wasm_size: usize = tm_report_wasm_base64_size();
        if (wasm == 0 || wasm_size == 0 || wasm_size > 1048576) { return TM_EXP_ERR_RESOURCE as i64; }
        var writer: TMJsonWriter = TMJsonWriter{ .data = out, .capacity = capacity, .used = 0, .error = 0 };
        tm_report_benchmark_part0(&writer); tm_report_script_json(&writer, data, size);
        tm_report_benchmark_part1(&writer); tm_json_write_bytes(&writer, wasm, wasm_size);
        tm_report_benchmark_part2(&writer);
        if (writer.error != 0) { return writer.error as i64; }
        return writer.used as i64;
    }
}
