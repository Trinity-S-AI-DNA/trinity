    // Whether the architecture is mapped but refused as a main model after the
    // hyperparameters (clip in llama.cpp and the PrismML fork).
    fn trt_arch_refused_as_main(runtime: i32, data: []u8, at: usize, size: usize) -> bool {
        if (runtime == 1) {
            if (tf_same_text(data, at, size, "clip", 4)) { return true; }
            return false;
        }
        if (runtime == 2) {
            if (tf_same_text(data, at, size, "clip", 4)) { return true; }
            return false;
        }
        return false;
    }
}
