    // The ggml_nbytes rule of the id (TRT_RULE_*).
    fn trt_rule(runtime: i32, type_id: u32) -> i32 {
        if (runtime == 3) {
            if (type_id == 36) { return TRT_RULE_I2S; }  // i2_s
            if (type_id == 38) { return TRT_RULE_I2S; }  // tl1
            if (type_id == 42) { return TRT_RULE_TL2; }  // tl2
        }
        return TRT_RULE_BLOCKS;
    }

    // Whether the runtime's model loader applies prism.hadamard.* (only the PrismML fork).
    fn trt_hadamard(runtime: i32) -> bool {
        if (runtime == 1) { return false; }
        if (runtime == 2) { return true; }
        if (runtime == 3) { return false; }
        if (runtime == 4) { return false; }
        return false;
    }

    // Whether the loader checks general.tensor_extra.* (the activation precision policy;
    // stock llama.cpp from 4364bf72).
    fn trt_tensor_extra(runtime: i32) -> bool {
        if (runtime == 1) { return true; }
        if (runtime == 2) { return false; }
        if (runtime == 3) { return false; }
        if (runtime == 4) { return false; }
        return false;
    }

    // Whether data[at .. at + size) is an architecture name the runtime's model mapping
    // turns into a model class (the caller passes the name up to its first NUL, as the
    // loader reads it); other names are refused before the hyperparameters.
    fn trt_arch_known(runtime: i32, data: []u8, at: usize, size: usize) -> bool {
        if (runtime == 1) {
            if (tf_same_text(data, at, size, "clip", 4)) { return true; }
            if (tf_same_text(data, at, size, "llama", 5)) { return true; }
            if (tf_same_text(data, at, size, "llama4", 6)) { return true; }
            if (tf_same_text(data, at, size, "deci", 4)) { return true; }
            if (tf_same_text(data, at, size, "falcon", 6)) { return true; }
            if (tf_same_text(data, at, size, "grok", 4)) { return true; }
            if (tf_same_text(data, at, size, "gpt2", 4)) { return true; }
            if (tf_same_text(data, at, size, "gptneox", 7)) { return true; }
            if (tf_same_text(data, at, size, "mpt", 3)) { return true; }
            if (tf_same_text(data, at, size, "baichuan", 8)) { return true; }
