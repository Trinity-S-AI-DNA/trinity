// Native entry points for Python FFI representation adapters.
// No Python-domain fallbacks; caller supplies every buffer and explicit bound.
module TrinityMemoryPythonAPI;

fn tm_api_validate_trits(values: []i32, count: usize) -> i32 {
    var index: usize = 0;
    while (index < count) {
        if (values[index] < -1 || values[index] > 1) { return -1; }
        index = index + 1;
    }
    return 0;
}
fn tm_api_tmem_count(data: []u8, size: usize, limit: usize) -> i64 {
    if (size < 24) { return -1; }
    var count: u64 = tm_read_u64(data, 8);
    if (count > limit as u64 || count > 0x7fffffffffffffff) { return -1; }
    return count as i64;
}
fn tm_api_server_host(data: []u8, size: usize) -> bool {
    return tm_bridge_equal(data, size, "127.0.0.1") || tm_bridge_equal(data, size, "localhost");
}
fn tm_api_tmem_metadata(data: []u8, size: usize, count: u64, output: []u8, capacity: usize) -> i64 {
    // The caller validates the container with tm_unpack before this formatter.
    if (size < 24) { return -1; }
    var w: TMJsonWriter; tm_json_writer_init(output, capacity, &w);
    var codec: i32 = data[5] as i32;
    tm_bridge_text(&w, "{\"format\":\"TMEM\",\"version\":1,\"codec\":");
    tm_bridge_literal_string(&w, tm_bridge_codec_name(codec));
    tm_bridge_text(&w, ",\"count\":"); tm_json_write_u64(&w, count);
    tm_bridge_text(&w, ",\"payload_bytes\":"); tm_json_write_u64(&w, (size - 24) as u64);
    tm_bridge_text(&w, ",\"header_bytes\":24,\"container_bytes\":"); tm_json_write_u64(&w, size as u64);
    tm_bridge_text(&w, ",\"payload_bpw\":");
    if (count == 0) { tm_json_write_null(&w); } else { tm_json_write_f64(&w, ((size - 24) as f64) * 8.0 / (count as f64)); }
    tm_bridge_text(&w, ",\"container_bpw\":");
    if (count == 0) { tm_json_write_null(&w); } else { tm_json_write_f64(&w, (size as f64) * 8.0 / (count as f64)); }
    tm_bridge_text(&w, ",\"crc32\":\"");
    var checksum: u32 = tm_read_u32(data, 20); var digit: usize = 8;
    while (digit > 0) { digit = digit - 1; tm_json_write_byte(&w, tm_bridge_hex_digit(((checksum >> (digit * 4)) & 15) as u8)); }
    tm_bridge_text(&w, "\",\"validated\":true,\"layout\":{\"id\":"); tm_json_write_i64(&w, codec as i64);
    tm_bridge_text(&w, ",\"name\":"); tm_bridge_literal_string(&w, tm_bridge_codec_name(codec));
    tm_bridge_text(&w, ",\"group_size\":"); tm_json_write_u64(&w, tm_group_size(codec) as u64);
    tm_bridge_text(&w, ",\"group_bits\":"); tm_json_write_u64(&w, tm_group_bits(codec) as u64);
    tm_bridge_text(&w, ",\"max_nonzero\":");
    if (codec == 4) { tm_json_write_u64(&w, 1); }
    else { if (codec == 5) { tm_json_write_u64(&w, 2); } else { tm_json_write_null(&w); } }
    tm_bridge_text(&w, "}}");
    if (w.error != 0) { return -1; }
    return w.used as i64;
}
fn tm_api_classify(raw: []i64, count: usize, scales: []f64, scale_count: usize,
                   scores: []f64, best: *i64, tied: *i64) -> i32 {
    if (count != 3) { return -1; }
    var status: i32 = tm_scale_scores(raw, count as u64, scales, scale_count as u64, scores, count as u64);
    if (status != 0) { return status; }
    return tm_argmax_scores(scores, count as u64, best, tied);
}
fn tm_api_timeout(value: f64) -> bool {
    return value > 0.0 && value <= 1.7976931348623157e308;
}
