// SPDX-License-Identifier: Apache-2.0
// Issue: https://github.com/dmitrii-f-t27/trinity-memory/issues/125
// Issue: https://github.com/dmitrii-f-t27/trinity-memory/issues/131
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/29
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/30
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/34
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/98
// specs/formats/prismml.t27 -- PrismML llama.cpp fork: PQ2_0, PTQ1_0 and its group-64 Q2_0
// Restates upstream PrismML-Eng/llama.cpp@87268f775d74cf8f7ffc6c22a95684aa55995533
// (branch prism): ggml/include/ggml.h:431-437 (Q1_0 41, Q2_0 42, PQ2_0 142,
// PTQ1_0 143, GGML_TYPE_COUNT 144); ggml/src/ggml-common.h:192-197 (block_q2_0,
// still group 64), :199-207 (block_pq2_0: one fp16 scale per 128 weights),
// :209-220 (block_ptq1_0: qs[24], qh[2], d); ggml/src/ggml-quants.c:74 and :474
// (quantize_row_q2_0_ref, dequantize_row_q2_0), :113 and :494 (quantize_row_pq2_0_ref,
// dequantize_row_pq2_0), :2203 (stages 32/16/8), :2205 and :2255
// (quantize_row_ptq1_0_ref, dequantize_row_ptq1_0), :2246-2248 (a qh group is
// multiplied by 3 once more, so its fifth digit is 0), :2277-2283 (qh digits
// 0..3 only), :5515-5552 and :5707-5718
// (ggml_validate_row_data: finite d for Q2_0, PQ2_0 and PTQ1_0). The fork marks
// its files with keys beginning "prism." (for example prism.hadamard.*); the
// GGUF type-id rule is stated in specs/formats/llama_cpp.t27.
// Group-128 bytes read as group 64 are a synthetic negative case of this
// repository: the published Q2_0 file holds valid group-64 blocks.
// Hadamard load rules (issue #98, section 6 below), same commit, src/llama-model.cpp
// (blob c2ac6a50): :1196-1208 (prism.hadamard.tied_output read first, an optional bool;
// prism.hadamard.version 1 or 2, any other value throws; version 2 exactly when
// tied_output; tied_output needs output.weight absent) and :1345-1356 (tied_output
// needs version 2 and a latent token_embd.weight among the inverse tables; a latent
// token_embd.weight with no output.weight needs version 2 and tied_output). Not
// restated: the rule "prism.hadamard.tied_output is not bound to the token
// embedding" (:1997-2002) depends on the architecture's graph builder
// (src/models/<arch>.cpp, output falling back to tok_embd), which no pinned file
// carries and t27/live.t27 does not model; and every other prism.hadamard.* rule
// (status classes -63, -64, -66 to -71 in specs/formats/OWNERS.md): the scanner
// t27/live.t27 (tlv_hadamard) states them, and they run between the two stages
// of section 6. The fork has no reader of general.tensor_extra.* (no hit in its
// src/llama-model.cpp, llama-arch.cpp, llama-model-loader.cpp, llama.cpp,
// llama-arch.h at this commit); the stock rule is in specs/formats/llama_cpp.t27.
// phi^2 + 1/phi^2 = 3 | TRINITY
module TrinityFormatsPrismmlSpec {
    // 1. Status classes (specs/formats/OWNERS.md).
    pub const TFS_PRISM_ERR_FORMAT: i32 = -50;
    pub const TFS_PRISM_ERR_LENGTH: i32 = -51;
    pub const TFS_PRISM_ERR_CAPACITY: i32 = -52;
    pub const TFS_PRISM_ERR_CODE: i32 = -53;
    pub const TFS_PRISM_ERR_PADDING: i32 = -54;
    pub const TFS_PRISM_ERR_SCALE_NONFINITE: i32 = -58;
    pub const TFS_PRISM_FLAG_OUTSIDE_TERNARY: u32 = 0;
    pub const TFS_PRISM_FLAG_NONCANONICAL_BASE3: u32 = 1;
    pub const TFS_PRISM_FLAG_SCALE_NEGATIVE: u32 = 2;
    pub const TFS_PRISM_FLAG_SCALE_ZERO: u32 = 3;
    pub const TFS_PRISM_FLAG_COUNT: u32 = 7;

    // 2. Format identifiers of this repository and the fork's ggml type ids.
    pub const TFS_PRISM_Q2_0: i32 = 3;
    pub const TFS_PRISM_PQ2_0: i32 = 5;
    pub const TFS_PRISM_PTQ1_0: i32 = 6;
    pub const TFS_PRISM_TYPE_Q2_0: u32 = 42;
    pub const TFS_PRISM_TYPE_PQ2_0: u32 = 142;
    pub const TFS_PRISM_TYPE_PTQ1_0: u32 = 143;
    pub const TFS_PRISM_TYPE_COUNT: u32 = 144;

    // 3. Block geometry.
    pub const TFS_PRISM_Q2_0_BLOCK_WEIGHTS: u32 = 64;
    pub const TFS_PRISM_Q2_0_BLOCK_BYTES: u32 = 18;
    pub const TFS_PRISM_PQ2_0_BLOCK_WEIGHTS: u32 = 128;
    pub const TFS_PRISM_PQ2_0_BLOCK_BYTES: u32 = 34;
    pub const TFS_PRISM_PTQ1_0_BLOCK_WEIGHTS: u32 = 128;
    pub const TFS_PRISM_PTQ1_0_BLOCK_BYTES: u32 = 28;
    pub const TFS_PRISM_PTQ1_0_QS_BYTES: u32 = 24;
    pub const TFS_PRISM_PTQ1_0_QH_BYTES: u32 = 2;
    pub const TFS_PRISM_PTQ1_0_SCALE_AT: u32 = 26;
    pub const TFS_PRISM_SCALE_BITS: u32 = 16;

    // 4. Bits per weight including the block scale, as NUM/DEN.
    pub const TFS_PRISM_Q2_0_BPW_NUM: u32 = 9;
    pub const TFS_PRISM_Q2_0_BPW_DEN: u32 = 4;
    pub const TFS_PRISM_PQ2_0_BPW_NUM: u32 = 17;
    pub const TFS_PRISM_PQ2_0_BPW_DEN: u32 = 8;
    pub const TFS_PRISM_PTQ1_0_BPW_NUM: u32 = 7;
    pub const TFS_PRISM_PTQ1_0_BPW_DEN: u32 = 4;

    // 5. The shortest byte run that is a whole number of blocks in both 2-bit
    //    layouts: 9 PQ2_0 blocks (1152 weights) or 17 Q2_0 blocks (1088).
    pub const TFS_PRISM_COMMON_BYTES: u32 = 306;

    // 6. Hadamard load rules of the fork (issue #98). Status classes of
    //    specs/formats/OWNERS.md; the key prism.hadamard.version is 1 (no tied
    //    output) or 2 (tied output, no output.weight).
    pub const TFS_PRISM_ERR_HADAMARD_VERSION: i32 = -65;
    pub const TFS_PRISM_ERR_HADAMARD_TIED: i32 = -88;
    pub const TFS_PRISM_HADAMARD_VERSION_UNTIED: u32 = 1;
    pub const TFS_PRISM_HADAMARD_VERSION_TIED: u32 = 2;

    // Stage 1 of the fork's Hadamard rules (src/llama-model.cpp:1197-1208), run
    // right after the metadata is read. has_version: prism.hadamard.version is
    // present; version: its value; tied: prism.hadamard.tied_output is true (an
    // absent key reads false); has_output: the file has a tensor named output.weight.
    // No version key means the fork applies no rotation and checks nothing here.
    // A present version must be 1 or 2 (:1199-1201, status -65); version 2 exactly
    // when tied (:1203-1205) and a tied output has no output.weight (:1206-1208),
    // both status -88.
    pub fn tfs_prism_hadamard_keys_status(has_version: bool, version: u32, tied: bool, has_output: bool) -> i32 {
        if (!has_version) { return 0; }
        if (version != TFS_PRISM_HADAMARD_VERSION_UNTIED && version != TFS_PRISM_HADAMARD_VERSION_TIED) {
            return TFS_PRISM_ERR_HADAMARD_VERSION;
        }
        if (version == TFS_PRISM_HADAMARD_VERSION_TIED && !tied) { return TFS_PRISM_ERR_HADAMARD_TIED; }
        if (version == TFS_PRISM_HADAMARD_VERSION_UNTIED && tied) { return TFS_PRISM_ERR_HADAMARD_TIED; }
        if (tied && has_output) { return TFS_PRISM_ERR_HADAMARD_TIED; }
        return 0;
    }

    // Stage 2 (:1345-1356), run after the weight lists and the inverse tables have
    // been read. has_latent: token_embd.weight is among the names of
    // prism.hadamard.inverse_weight_names, the only inverse table the fork lets
    // through (:1335). A tied output needs version 2 (:1346-1348, so also a version
    // key) and the latent token embedding (:1349-1352); without a tied output a
    // latent token embedding needs an output.weight (:1354-1356). Without a version
    // key the inverse tables are never read, so has_latent counts as false.
    pub fn tfs_prism_hadamard_embedding_status(has_version: bool, version: u32, tied: bool,
                                               has_output: bool, has_latent: bool) -> i32 {
        var latent: bool = has_version && has_latent;
        if (tied) {
            if (!has_version || version != TFS_PRISM_HADAMARD_VERSION_TIED) { return TFS_PRISM_ERR_HADAMARD_TIED; }
            if (!latent) { return TFS_PRISM_ERR_HADAMARD_TIED; }
            return 0;
        }
        if (latent && !has_output) { return TFS_PRISM_ERR_HADAMARD_TIED; }
        return 0;
    }

    // Both stages for a file whose other prism.hadamard.* keys and tensors pass
    // (the rules between the stages, OWNERS.md -63, -64, -66 to -71, are not
    // restated here): the first refusal wins.
    pub fn tfs_prism_hadamard_tied_status(has_version: bool, version: u32, tied: bool,
                                          has_output: bool, has_latent: bool) -> i32 {
        var keys: i32 = tfs_prism_hadamard_keys_status(has_version, version, tied, has_output);
        if (keys != 0) { return keys; }
        return tfs_prism_hadamard_embedding_status(has_version, version, tied, has_output, has_latent);
    }

    // The fork at 87268f77 has no reader of general.tensor_extra.name or
    // general.tensor_extra.prec_a4: whatever those keys hold, they do not refuse a
    // load. Stock llama.cpp refuses (specs/formats/llama_cpp.t27, status -89).
    pub fn tfs_prism_tensor_extra_status() -> i32 {
        return 0;
    }

    pub fn tfs_prism_block_weights(format: i32) -> usize {
        if (format == TFS_PRISM_Q2_0) { return TFS_PRISM_Q2_0_BLOCK_WEIGHTS as usize; }
        if (format == TFS_PRISM_PQ2_0) { return TFS_PRISM_PQ2_0_BLOCK_WEIGHTS as usize; }
        if (format == TFS_PRISM_PTQ1_0) { return TFS_PRISM_PTQ1_0_BLOCK_WEIGHTS as usize; }
        return 0;
    }

    pub fn tfs_prism_block_bytes(format: i32) -> usize {
        if (format == TFS_PRISM_Q2_0) { return TFS_PRISM_Q2_0_BLOCK_BYTES as usize; }
        if (format == TFS_PRISM_PQ2_0) { return TFS_PRISM_PQ2_0_BLOCK_BYTES as usize; }
        if (format == TFS_PRISM_PTQ1_0) { return TFS_PRISM_PTQ1_0_BLOCK_BYTES as usize; }
        return 0;
    }

    pub fn tfs_prism_scale_at(format: i32) -> usize {
        if (format == TFS_PRISM_PTQ1_0) { return TFS_PRISM_PTQ1_0_SCALE_AT as usize; }
        return 0;
    }

    pub fn tfs_prism_f16_class(word: u32) -> i32 {
        if ((word & 0x7c00) == 0x7c00) { return TFS_PRISM_ERR_SCALE_NONFINITE; }
        if ((word & 0x7fff) == 0) { return 1; }
        if ((word & 0x8000) != 0) { return 2; }
        return 0;
    }

    // Digit n of a base-3 byte: q = (uint8_t)(byte * pow3[n]), ((uint16_t)q * 3) >> 8.
    pub fn tfs_prism_b3_trit(byte: u32, n: u32) -> i32 {
        var power: u32 = 1;
        if (n == 1) { power = 3; }
        if (n == 2) { power = 9; }
        if (n == 3) { power = 27; }
        if (n == 4) { power = 81; }
        var q: u32 = (byte * power) & 255;
        return (((q * 3) >> 8) as i32) - 1;
    }

    // Digit 4 of a qh byte is padding: the quantizer writes 0, the
    // dequantizer does not read it.
    pub fn tfs_prism_b3_padded(byte: u32) -> bool {
        return tfs_prism_b3_trit(byte, 4) != -1;
    }

    pub fn tfs_prism_b3_canonical(byte: u32, digits: u32) -> bool {
        var limit: u32 = 243;
        var factor: u32 = 1;
        if (digits == 4) { limit = 81; factor = 3; }
        var q: u32 = 0;
        while (q < limit) {
            if ((q * factor * 256 + 242) / 243 == byte) { return true; }
            q = q + 1;
        }
        return false;
    }

    // Weight e of the block at data[base]. PTQ1_0 walks the stages 32, 16, 8:
    // a stage of c bytes fits while j + c <= 24 and yields 5c weights (digit
    // n of byte j + m for weight 5-digit order n*c + m); then 2 qh bytes x 4.
    pub fn tfs_prism_weight(format: i32, data: []u8, base: usize, e: usize) -> i32 {
        if (format == TFS_PRISM_PTQ1_0) {
            var rest: usize = e;
            var j: usize = 0;
            var s: usize = 0;
            while (s < 3) {
                var c: usize = 32 >> s;
                while (j + c <= 24) {
                    if (rest < 5 * c) { return tfs_prism_b3_trit(data[base + j + rest % c] as u32, (rest / c) as u32); }
                    rest = rest - 5 * c;
                    j = j + c;
                }
                s = s + 1;
            }
            return tfs_prism_b3_trit(data[base + 24 + rest % 2] as u32, (rest / 2) as u32);
        }
        // Q2_0 and PQ2_0: d first, then byte j/4 at bits (j%4)*2; 11 is +2.
        return ((((data[base + 2 + e / 4] as u32) >> (2 * (e % 4))) & 3) as i32) - 1;
    }

    fn tfs_prism_read_d(data: []u8, at: usize) -> u32 {
        return (data[at] as u32) + 256 * (data[at + 1] as u32);
    }

    pub fn tfs_prism_validate(format: i32, data: []u8, size: usize, count: usize,
                              value_capacity: usize, scale_capacity: usize) -> i64 {
        var per: usize = tfs_prism_block_weights(format);
        if (per == 0) { return TFS_PRISM_ERR_FORMAT as i64; }
        if (count % per != 0) { return TFS_PRISM_ERR_LENGTH as i64; }
        var bytes: usize = tfs_prism_block_bytes(format);
        if (size != (count / per) * bytes) { return TFS_PRISM_ERR_LENGTH as i64; }
        if (count > value_capacity || count / per > scale_capacity) { return TFS_PRISM_ERR_CAPACITY as i64; }
        var b: usize = 0;
        while (b < count / per) {
            if (tfs_prism_f16_class(tfs_prism_read_d(data, b * bytes + tfs_prism_scale_at(format))) < 0) {
                return TFS_PRISM_ERR_SCALE_NONFINITE as i64;
            }
            b = b + 1;
        }
        // PTQ1_0: PADDING for the first qh byte whose fifth digit is not 0.
        if (format == TFS_PRISM_PTQ1_0) {
            b = 0;
            while (b < count / per) {
                var h: usize = 0;
                while (h < (TFS_PRISM_PTQ1_0_QH_BYTES as usize)) {
                    if (tfs_prism_b3_padded(data[b * bytes + (TFS_PRISM_PTQ1_0_QS_BYTES as usize) + h] as u32)) {
                        return TFS_PRISM_ERR_PADDING as i64;
                    }
                    h = h + 1;
                }
                b = b + 1;
            }
        }
        return (count / per) as i64;
    }

    pub fn tfs_prism_decode(format: i32, data: []u8, size: usize, count: usize,
                            values: []i32, value_capacity: usize,
                            scales: []u32, scale_capacity: usize) -> i64 {
        var blocks: i64 = tfs_prism_validate(format, data, size, count, value_capacity, scale_capacity);
        if (blocks < 0) { return blocks; }
        var per: usize = tfs_prism_block_weights(format);
        var bytes: usize = tfs_prism_block_bytes(format);
        var outside: i64 = 0;
        var b: usize = 0;
        while (b < (blocks as usize)) {
            scales[b] = tfs_prism_read_d(data, b * bytes + tfs_prism_scale_at(format));
            var e: usize = 0;
            while (e < per) {
                var w: i32 = tfs_prism_weight(format, data, b * bytes, e);
                if (w < -1 || w > 1) { outside = outside + 1; }
                values[b * per + e] = w;
                e = e + 1;
            }
            b = b + 1;
        }
        return outside;
    }

    pub fn tfs_prism_flags(format: i32, data: []u8, size: usize, count: usize, flags: []i64) -> i64 {
        var slot: u32 = 0;
        while (slot < TFS_PRISM_FLAG_COUNT) { flags[slot] = 0; slot = slot + 1; }
        var blocks: i64 = tfs_prism_validate(format, data, size, count, count, count);
        if (blocks < 0) { return blocks; }
        var per: usize = tfs_prism_block_weights(format);
        var bytes: usize = tfs_prism_block_bytes(format);
        var b: usize = 0;
        while (b < (blocks as usize)) {
            var d: i32 = tfs_prism_f16_class(tfs_prism_read_d(data, b * bytes + tfs_prism_scale_at(format)));
            if (d == 1) { flags[TFS_PRISM_FLAG_SCALE_ZERO] = flags[TFS_PRISM_FLAG_SCALE_ZERO] + 1; }
            if (d == 2) { flags[TFS_PRISM_FLAG_SCALE_NEGATIVE] = flags[TFS_PRISM_FLAG_SCALE_NEGATIVE] + 1; }
            var e: usize = 0;
            while (e < per) {
                if (tfs_prism_weight(format, data, b * bytes, e) > 1) {
                    flags[TFS_PRISM_FLAG_OUTSIDE_TERNARY] = flags[TFS_PRISM_FLAG_OUTSIDE_TERNARY] + 1;
                }
                e = e + 1;
            }
            if (format == TFS_PRISM_PTQ1_0) {
                var j: usize = 0;
                while (j < 26) {
                    var digits: u32 = 5;
                    if (j >= 24) { digits = 4; }
                    if (!tfs_prism_b3_canonical(data[b * bytes + j] as u32, digits)) {
                        flags[TFS_PRISM_FLAG_NONCANONICAL_BASE3] = flags[TFS_PRISM_FLAG_NONCANONICAL_BASE3] + 1;
                    }
                    j = j + 1;
                }
            }
            b = b + 1;
        }
        return 0;
    }

    // PTQ1_0 accepts -1..1; the 2-bit layouts also store +2.
    pub fn tfs_prism_code_allowed(format: i32, value: i32) -> bool {
        if (format == TFS_PRISM_PTQ1_0) { return value >= -1 && value <= 1; }
        return value >= -1 && value <= 2;
    }

    fn tfs_prism_b3_pack(values: []i32, first: usize, stride: usize, digits: usize) -> u32 {
        var q: u32 = 0;
        var n: usize = 0;
        while (n < digits) { q = q * 3 + ((values[first + n * stride] + 1) as u32); n = n + 1; }
        if (digits == 4) { q = q * 3; }
        return (q * 256 + 242) / 243;
    }

    pub fn tfs_prism_encode(format: i32, values: []i32, count: usize, scales: []u32, scale_count: usize,
                            out: []u8, capacity: usize) -> i64 {
        var per: usize = tfs_prism_block_weights(format);
        if (per == 0) { return TFS_PRISM_ERR_FORMAT as i64; }
        if (count % per != 0 || scale_count != count / per) { return TFS_PRISM_ERR_LENGTH as i64; }
        var bytes: usize = tfs_prism_block_bytes(format);
        if ((count / per) * bytes > capacity) { return TFS_PRISM_ERR_CAPACITY as i64; }
        var i: usize = 0;
        while (i < count) {
            if (!tfs_prism_code_allowed(format, values[i])) { return TFS_PRISM_ERR_CODE as i64; }
            i = i + 1;
        }
        var b: usize = 0;
        while (b < count / per) {
            var base: usize = b * bytes;
            var first: usize = b * per;
            var k: usize = 0;
            while (k < bytes) { out[base + k] = 0; k = k + 1; }
            var d: usize = base + tfs_prism_scale_at(format);
            out[d] = (scales[b] & 255) as u8;
            out[d + 1] = ((scales[b] >> 8) & 255) as u8;
            if (format == TFS_PRISM_PTQ1_0) {
                var m: usize = 0;
                while (m < 16) { out[base + m] = tfs_prism_b3_pack(values, first + m, 16, 5) as u8; m = m + 1; }
                m = 0;
                while (m < 8) { out[base + 16 + m] = tfs_prism_b3_pack(values, first + 80 + m, 8, 5) as u8; m = m + 1; }
                m = 0;
                while (m < 2) { out[base + 24 + m] = tfs_prism_b3_pack(values, first + 120 + m, 2, 4) as u8; m = m + 1; }
            } else {
                var e: usize = 0;
                while (e < per) {
                    out[base + 2 + e / 4] = ((out[base + 2 + e / 4] as u32) | (((values[first + e] + 1) as u32) << (2 * (e % 4)))) as u8;
                    e = e + 1;
                }
            }
            b = b + 1;
        }
        return ((count / per) * bytes) as i64;
    }

    invariant prism_pq2_0_layout { assert 2 + TFS_PRISM_PQ2_0_BLOCK_WEIGHTS / 4 == TFS_PRISM_PQ2_0_BLOCK_BYTES && TFS_PRISM_Q2_0_BLOCK_WEIGHTS * 2 == TFS_PRISM_PQ2_0_BLOCK_WEIGHTS; }
    invariant prism_ptq1_0_layout { assert TFS_PRISM_PTQ1_0_QS_BYTES == (TFS_PRISM_PTQ1_0_BLOCK_WEIGHTS - 4 * TFS_PRISM_PTQ1_0_BLOCK_WEIGHTS / 64) / 5 && TFS_PRISM_PTQ1_0_QH_BYTES == TFS_PRISM_PTQ1_0_BLOCK_WEIGHTS / 64 && TFS_PRISM_PTQ1_0_QS_BYTES + TFS_PRISM_PTQ1_0_QH_BYTES == TFS_PRISM_PTQ1_0_SCALE_AT && TFS_PRISM_PTQ1_0_SCALE_AT + 2 == TFS_PRISM_PTQ1_0_BLOCK_BYTES; }
    invariant prism_ptq1_0_stages_cover_qs { assert 16 + 8 == TFS_PRISM_PTQ1_0_QS_BYTES && 5 * 16 + 5 * 8 + 4 * TFS_PRISM_PTQ1_0_QH_BYTES == TFS_PRISM_PTQ1_0_BLOCK_WEIGHTS; }
    invariant prism_bits_per_weight { assert TFS_PRISM_PQ2_0_BLOCK_BYTES * 8 * TFS_PRISM_PQ2_0_BPW_DEN == TFS_PRISM_PQ2_0_BPW_NUM * TFS_PRISM_PQ2_0_BLOCK_WEIGHTS && TFS_PRISM_PTQ1_0_BLOCK_BYTES * 8 * TFS_PRISM_PTQ1_0_BPW_DEN == TFS_PRISM_PTQ1_0_BPW_NUM * TFS_PRISM_PTQ1_0_BLOCK_WEIGHTS && TFS_PRISM_Q2_0_BLOCK_BYTES * 8 * TFS_PRISM_Q2_0_BPW_DEN == TFS_PRISM_Q2_0_BPW_NUM * TFS_PRISM_Q2_0_BLOCK_WEIGHTS; }
    invariant prism_scale_share_is_one_eighth_bit { assert TFS_PRISM_SCALE_BITS * 8 == TFS_PRISM_PQ2_0_BLOCK_WEIGHTS && TFS_PRISM_SCALE_BITS * 8 == TFS_PRISM_PTQ1_0_BLOCK_WEIGHTS; }
    invariant prism_common_byte_run { assert TFS_PRISM_COMMON_BYTES == 9 * TFS_PRISM_PQ2_0_BLOCK_BYTES && TFS_PRISM_COMMON_BYTES == 17 * TFS_PRISM_Q2_0_BLOCK_BYTES; }
    invariant prism_type_ids { assert TFS_PRISM_TYPE_PQ2_0 == 142 && TFS_PRISM_TYPE_PTQ1_0 == 143 && TFS_PRISM_TYPE_Q2_0 == 42 && TFS_PRISM_TYPE_COUNT == 144; }
    invariant prism_hadamard_status_classes { assert TFS_PRISM_ERR_HADAMARD_VERSION == -65 && TFS_PRISM_ERR_HADAMARD_TIED == -88; }
    invariant prism_hadamard_versions { assert TFS_PRISM_HADAMARD_VERSION_UNTIED == 1 && TFS_PRISM_HADAMARD_VERSION_TIED == 2; }

    test "prism pq2_0 and ptq1_0 encoder examples" {
        var p: [128]i32;
        var i: usize = 0;
        while (i < 128) { p[i] = 0; i = i + 1; }
        p[0] = 1; p[1] = 0; p[2] = -1; p[3] = 1;
        var half: [1]u32 = [14336];
        var pq: [34]u8;
        assert tfs_prism_encode(TFS_PRISM_PQ2_0, p, 128, half, 1, pq, 34) == 34;
        assert pq[0] == 0 && pq[1] == 56 && pq[2] == 134 && pq[3] == 85;
        i = 0;
        while (i < 128) { p[i] = 0; i = i + 1; }
        p[0] = 1; p[16] = 0; p[32] = -1; p[48] = 1; p[64] = 0;
        p[120] = -1; p[122] = 1; p[124] = 0; p[126] = 1;
        var pt: [28]u8;
        assert tfs_prism_encode(TFS_PRISM_PTQ1_0, p, 128, half, 1, pt, 28) == 28;
        assert pt[0] == 207 && pt[24] == 73 && pt[26] == 0 && pt[27] == 56;
        var back: [128]i32;
        var s: [1]u32;
        assert tfs_prism_decode(TFS_PRISM_PTQ1_0, pt, 28, 128, back, 128, s, 1) == 0;
        assert back[0] == 1 && back[16] == 0 && back[32] == -1 && back[48] == 1 && back[120] == -1 && back[126] == 1;
        assert s[0] == 14336;
        p[7] = 2;
        assert tfs_prism_encode(TFS_PRISM_PTQ1_0, p, 128, half, 1, pt, 28) == TFS_PRISM_ERR_CODE;
    }
    test "prism group 128 bytes read as group 64 decode without error" {
        // 9 PQ2_0 blocks of code 1 (0) with codes 2 (+1) at weights 0 and 127.
        var data: [306]u8;
        var i: usize = 0;
        while (i < 306) { data[i] = 85; i = i + 1; }
        var b: usize = 0;
        while (b < 9) { data[34 * b] = 0; data[34 * b + 1] = 60; data[34 * b + 2] = 86; data[34 * b + 33] = 149; b = b + 1; }
        var v: [1152]i32;
        var s: [17]u32;
        assert tfs_prism_decode(TFS_PRISM_PQ2_0, data, 306, 1152, v, 1152, s, 9) == 0;
        assert v[0] == 1 && v[1] == 0 && v[127] == 1 && v[128] == 1;
        // The same bytes as group-64 Q2_0: 1088 weights; block 1's scale is
        // read from PQ2_0 code bytes (0x5555), and eight PQ2_0 scale bytes
        // 0x3C land among Q2_0 codes as two +2 codes each.
        assert tfs_prism_decode(TFS_PRISM_Q2_0, data, 306, 1088, v, 1152, s, 17) == 16;
        assert s[0] == 15360 && s[1] == 21845 && v[0] == 1 && v[64] == 0;
        assert tfs_prism_decode(TFS_PRISM_Q2_0, data, 306, 1152, v, 1152, s, 17) == TFS_PRISM_ERR_LENGTH;
    }
    test "prism rejects non-finite scales and counts flags" {
        var pt: [56]u8;
        var i: usize = 0;
        while (i < 56) { pt[i] = 0; i = i + 1; }
        pt[26] = 0; pt[27] = 188; pt[54] = 0; pt[55] = 0;
        pt[0] = 1; pt[24] = 1;
        var f: [7]i64;
        assert tfs_prism_flags(TFS_PRISM_PTQ1_0, pt, 56, 256, f) == 0;
        assert f[1] == 2 && f[2] == 1 && f[3] == 1 && f[0] == 0;
        pt[55] = 124;
        var v: [256]i32;
        var s: [2]u32;
        assert tfs_prism_decode(TFS_PRISM_PTQ1_0, pt, 56, 256, v, 256, s, 2) == TFS_PRISM_ERR_SCALE_NONFINITE;
        assert tfs_prism_flags(TFS_PRISM_PTQ1_0, pt, 56, 256, f) == TFS_PRISM_ERR_SCALE_NONFINITE && f[1] == 0;
        assert tfs_prism_decode(TFS_PRISM_PQ2_0, pt, 56, 256, v, 256, s, 2) == TFS_PRISM_ERR_LENGTH;
        assert tfs_prism_decode(7, pt, 56, 256, v, 256, s, 2) == TFS_PRISM_ERR_FORMAT;
        pt[55] = 0;
        pt[25] = 2;
        assert tfs_prism_decode(TFS_PRISM_PTQ1_0, pt, 56, 256, v, 256, s, 2) == TFS_PRISM_ERR_PADDING;
        assert tfs_prism_flags(TFS_PRISM_PTQ1_0, pt, 56, 256, f) == TFS_PRISM_ERR_PADDING && f[1] == 0;
        assert tfs_prism_b3_padded(2) && !tfs_prism_b3_padded(1) && !tfs_prism_b3_padded(73);
    }
    test "prism hadamard version is 1 or 2 and tied_output follows it" {
        // No version key: the fork checks nothing at stage 1, whatever else is set.
        assert tfs_prism_hadamard_keys_status(false, 0, false, false) == 0;
        assert tfs_prism_hadamard_keys_status(false, 2, true, true) == 0;
        // Versions: 1 and 2 pass, 0, 3 and the largest u32 are status -65 (the
        // version is read before tied_output is compared with it).
        assert tfs_prism_hadamard_keys_status(true, 1, false, false) == 0;
        assert tfs_prism_hadamard_keys_status(true, 2, true, false) == 0;
        assert tfs_prism_hadamard_keys_status(true, 0, false, false) == TFS_PRISM_ERR_HADAMARD_VERSION;
        assert tfs_prism_hadamard_keys_status(true, 3, true, false) == TFS_PRISM_ERR_HADAMARD_VERSION;
        assert tfs_prism_hadamard_keys_status(true, 4294967295, false, true) == TFS_PRISM_ERR_HADAMARD_VERSION;
        // Version 2 needs tied_output true; version 1 forbids it.
        assert tfs_prism_hadamard_keys_status(true, 2, false, false) == TFS_PRISM_ERR_HADAMARD_TIED;
        assert tfs_prism_hadamard_keys_status(true, 2, false, true) == TFS_PRISM_ERR_HADAMARD_TIED;
        assert tfs_prism_hadamard_keys_status(true, 1, true, false) == TFS_PRISM_ERR_HADAMARD_TIED;
        assert tfs_prism_hadamard_keys_status(true, 1, true, true) == TFS_PRISM_ERR_HADAMARD_TIED;
        // A tied output has no output.weight; an untied one may have it.
        assert tfs_prism_hadamard_keys_status(true, 2, true, true) == TFS_PRISM_ERR_HADAMARD_TIED;
        assert tfs_prism_hadamard_keys_status(true, 1, false, true) == 0;
    }
    test "prism hadamard tied output needs the latent token embedding" {
        // Stage 2 alone.
        assert tfs_prism_hadamard_embedding_status(true, 2, true, false, true) == 0;
        assert tfs_prism_hadamard_embedding_status(true, 2, true, false, false) == TFS_PRISM_ERR_HADAMARD_TIED;
        assert tfs_prism_hadamard_embedding_status(true, 1, true, false, true) == TFS_PRISM_ERR_HADAMARD_TIED;
        assert tfs_prism_hadamard_embedding_status(false, 0, true, false, true) == TFS_PRISM_ERR_HADAMARD_TIED;
        assert tfs_prism_hadamard_embedding_status(false, 0, false, false, true) == 0;
        assert tfs_prism_hadamard_embedding_status(true, 1, false, false, true) == TFS_PRISM_ERR_HADAMARD_TIED;
        assert tfs_prism_hadamard_embedding_status(true, 1, false, true, true) == 0;
        assert tfs_prism_hadamard_embedding_status(true, 1, false, false, false) == 0;
    }
    test "prism hadamard tied status over every version, tied_output, output.weight and latent embedding" {
        // No version key: only a tied_output refuses (the rotation is not declared).
        assert tfs_prism_hadamard_tied_status(false, 0, false, false, false) == 0;
        assert tfs_prism_hadamard_tied_status(false, 0, false, true, true) == 0;
        assert tfs_prism_hadamard_tied_status(false, 0, true, false, true) == TFS_PRISM_ERR_HADAMARD_TIED;
        assert tfs_prism_hadamard_tied_status(false, 0, true, true, false) == TFS_PRISM_ERR_HADAMARD_TIED;
        // Version 1, tied_output absent or false: accepted unless a latent token
        // embedding stands without an output.weight.
        assert tfs_prism_hadamard_tied_status(true, 1, false, false, false) == 0;
        assert tfs_prism_hadamard_tied_status(true, 1, false, true, false) == 0;
        assert tfs_prism_hadamard_tied_status(true, 1, false, true, true) == 0;
        assert tfs_prism_hadamard_tied_status(true, 1, false, false, true) == TFS_PRISM_ERR_HADAMARD_TIED;
        // Version 1 with tied_output true: refused in all four.
        assert tfs_prism_hadamard_tied_status(true, 1, true, false, false) == TFS_PRISM_ERR_HADAMARD_TIED;
        assert tfs_prism_hadamard_tied_status(true, 1, true, false, true) == TFS_PRISM_ERR_HADAMARD_TIED;
        assert tfs_prism_hadamard_tied_status(true, 1, true, true, false) == TFS_PRISM_ERR_HADAMARD_TIED;
        assert tfs_prism_hadamard_tied_status(true, 1, true, true, true) == TFS_PRISM_ERR_HADAMARD_TIED;
        // Version 2 without tied_output: refused in all four.
        assert tfs_prism_hadamard_tied_status(true, 2, false, false, false) == TFS_PRISM_ERR_HADAMARD_TIED;
        assert tfs_prism_hadamard_tied_status(true, 2, false, false, true) == TFS_PRISM_ERR_HADAMARD_TIED;
        assert tfs_prism_hadamard_tied_status(true, 2, false, true, false) == TFS_PRISM_ERR_HADAMARD_TIED;
        assert tfs_prism_hadamard_tied_status(true, 2, false, true, true) == TFS_PRISM_ERR_HADAMARD_TIED;
        // Version 2 with tied_output: only without output.weight and with the latent embedding.
        assert tfs_prism_hadamard_tied_status(true, 2, true, false, true) == 0;
        assert tfs_prism_hadamard_tied_status(true, 2, true, false, false) == TFS_PRISM_ERR_HADAMARD_TIED;
        assert tfs_prism_hadamard_tied_status(true, 2, true, true, true) == TFS_PRISM_ERR_HADAMARD_TIED;
        assert tfs_prism_hadamard_tied_status(true, 2, true, true, false) == TFS_PRISM_ERR_HADAMARD_TIED;
        // An unsupported version wins over the tied rules.
        assert tfs_prism_hadamard_tied_status(true, 3, true, false, true) == TFS_PRISM_ERR_HADAMARD_VERSION;
        assert tfs_prism_hadamard_tied_status(true, 0, false, true, false) == TFS_PRISM_ERR_HADAMARD_VERSION;
    }
    test "prism fork does not read general.tensor_extra" {
        // Whatever shape the two keys have (conformance/formats_prismml.json replays the
        // shapes stock llama.cpp refuses through t27/live.t27), the load is not refused.
        assert tfs_prism_tensor_extra_status() == 0;
    }
}
