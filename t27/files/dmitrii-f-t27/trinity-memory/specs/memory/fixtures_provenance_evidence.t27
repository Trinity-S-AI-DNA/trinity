// SPDX-License-Identifier: Apache-2.0
// Issue: https://github.com/dmitrii-f-t27/trinity-memory/issues/129
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/31
// DEPENDS ON A FETCHED CACHE: the real-weight byte ranges are not in git. They
// live in build/fixtures, filled anonymously from Hugging Face by
// tools/fetch-fixtures.py, and this replay is valid only with that cache present
// and complete. The cache files are not bound by the evidence manifest; their
// integrity is the sha256 and exact-length check against fixtures/manifest.json
// that the consumer runs and counts (no network, no hardware, nothing fetched).
// The consumer first checks the bound files against the evidence manifest, then
//   - runs tools/fetch-fixtures.py --offline (strict: every range present with
//     exact length and sha256, no unlisted cache file),
//   - re-reads every range of fixtures/manifest.lock.json from the cache with its
//     own code and recounts ranges and bytes, equal to the tool and the manifest,
//   - runs tests/test_fixtures.py (local fault-injecting HTTP server, no skips),
//   - replays tools/bitnet_audit.py --offline and compares it byte for byte with
//     reports/ternary-check/bitnet-audit-2026-09-23.json.
// Counts: 6 pinned models (full 40-hex revisions), 554 ranges re-hashed,
// 227142652 bytes hashed, 26 fixture tests, audit report equal (1).
// Not covered: the Hugging Face side (that these revisions and ranges are what the
// Hub serves, the HTTP 206 behaviour against the real Hub, rate limits) is not
// replayed; the whole-file lfs_sha256 values are not checked, only the ranges;
// the manifest hashes were recorded by the project, so this shows the cache
// equals what was pinned, not independent provenance of the pin itself.
// No receipt flag, closed issue or generated seal alone constitutes this proof.
module TrinityMemoryFixturesProvenanceEvidence {
    pub const TMFP_MODELS: u32 = 6;
    pub const TMFP_RANGES: u32 = 554;
    pub const TMFP_BYTES: u32 = 227142652;
    pub const TMFP_TESTS: u32 = 26;
    pub const TMFP_AUDIT_EQUAL: u32 = 1;

    pub fn tmfp_accept(source_current: bool, evidence_exact: bool,
                       replay_passed: bool, models: u32, ranges: u32,
                       bytes: u32, tests: u32, audit_equal: u32) -> bool {
        return source_current && evidence_exact && replay_passed
            && models == TMFP_MODELS && ranges == TMFP_RANGES
            && bytes == TMFP_BYTES && tests == TMFP_TESTS
            && audit_equal == TMFP_AUDIT_EQUAL;
    }

    test complete_fetched_cache {
        assert tmfp_accept(true, true, true, 6, 554, 227142652, 26, 1);
    }
    test missing_or_wrong_evidence {
        assert !tmfp_accept(false, true, true, 6, 554, 227142652, 26, 1);
        assert !tmfp_accept(true, false, true, 6, 554, 227142652, 26, 1);
        assert !tmfp_accept(true, true, false, 6, 554, 227142652, 26, 1);
        assert !tmfp_accept(true, true, true, 5, 554, 227142652, 26, 1);
        assert !tmfp_accept(true, true, true, 6, 553, 227142652, 26, 1);
        assert !tmfp_accept(true, true, true, 6, 554, 227142651, 26, 1);
        assert !tmfp_accept(true, true, true, 6, 554, 227142652, 25, 1);
        assert !tmfp_accept(true, true, true, 6, 554, 227142652, 26, 0);
    }
}
