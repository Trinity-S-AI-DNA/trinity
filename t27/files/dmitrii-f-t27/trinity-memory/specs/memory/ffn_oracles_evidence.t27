// SPDX-License-Identifier: Apache-2.0
// Issue: https://github.com/dmitrii-f-t27/trinity-memory/issues/127
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/103
// NUMERIC ORACLES, NOT HARDWARE EVIDENCE. Nothing here ran on a board.
// Replayed offline from committed files, with the pinned compiler:
//   #91  the synthetic-layer tests of tools/ffn_reference.py: RNE rounding
//        primitives, RMSNorm as sqrt(mean(x*x)+epsilon) in the f64 and the
//        Q16.16 and wide datapaths (small and zero inputs), signed-64-bit
//        clamp of the wide relu2 product with saturation counting, guard bounds.
//   #103 tests/test_gf16_codec.py: the independent GF16 value oracle against
//        the generated C codec (all 65536 decode/round trips, encode boundary
//        and random vectors), a sanitized run, the generated RTL and the
//        yosys-mapped RTL in iverilog.
// NOT replayed: the real layer-0 BitNet FFN report (reports/ffn/reference-2026-09-28.json)
// needs the HuggingFace fixture cache, which is not committed, so the real-fixture
// part of #91 is not covered, so #91 is NOT claimed as covered here: the synthetic-layer
// tests above are only the defect-fix checks. #105 (FFN boundary quantization report) needs the same
// cache and is not covered. No ActQuant/AutoBitLinear replay, no GF16 arithmetic,
// no board or performance claim. The counts come from the verifiers' own output.
module TrinityMemoryFfnOraclesEvidence {
    pub const TMFO_FFN_TESTS: u32 = 10;
    pub const TMFO_CODEC_TESTS: u32 = 5;
    pub const TMFO_ENCODE_VECTORS: u32 = 314883;
    pub const TMFO_ROUND_TRIPS: u32 = 65536;
    pub const TMFO_RTL_VECTORS: u32 = 314883;
    pub const TMFO_MAPPED_VECTORS: u32 = 314883;

    pub fn tmfo_accept(source_current: bool, evidence_exact: bool,
                       replay_passed: bool, ffn_tests: u32, codec_tests: u32,
                       encode_vectors: u32, round_trips: u32,
                       rtl_vectors: u32, mapped_vectors: u32) -> bool {
        return source_current && evidence_exact && replay_passed
            && ffn_tests == TMFO_FFN_TESTS && codec_tests == TMFO_CODEC_TESTS
            && encode_vectors == TMFO_ENCODE_VECTORS
            && round_trips == TMFO_ROUND_TRIPS
            && rtl_vectors == TMFO_RTL_VECTORS
            && mapped_vectors == TMFO_MAPPED_VECTORS;
    }

    test complete_oracles {
        assert tmfo_accept(true, true, true, 10, 5, 314883, 65536, 314883, 314883);
    }
    test missing_or_wrong_evidence {
        assert !tmfo_accept(false, true, true, 10, 5, 314883, 65536, 314883, 314883);
        assert !tmfo_accept(true, false, true, 10, 5, 314883, 65536, 314883, 314883);
        assert !tmfo_accept(true, true, false, 10, 5, 314883, 65536, 314883, 314883);
        assert !tmfo_accept(true, true, true, 9, 5, 314883, 65536, 314883, 314883);
        assert !tmfo_accept(true, true, true, 10, 4, 314883, 65536, 314883, 314883);
        assert !tmfo_accept(true, true, true, 10, 5, 314882, 65536, 314883, 314883);
        assert !tmfo_accept(true, true, true, 10, 5, 314883, 65535, 314883, 314883);
        assert !tmfo_accept(true, true, true, 10, 5, 314883, 65536, 314882, 314883);
        assert !tmfo_accept(true, true, true, 10, 5, 314883, 65536, 314883, 314884);
    }
}
