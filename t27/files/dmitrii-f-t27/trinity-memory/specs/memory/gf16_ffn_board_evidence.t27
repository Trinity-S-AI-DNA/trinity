// SPDX-License-Identifier: Apache-2.0
// Issue: https://github.com/dmitrii-f-t27/trinity-memory/issues/127
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/111
// Retained captures, not a new board run. Replayed offline: the committed UART
// captures of two AX7203 runs (real BOS input, zero input) of the gf16-ffn-v1
// layer-0 FFN (2560 -> 6912 -> 2560, 60 MHz controller clock, bitstream hash
// shared by build.json and boot.json). The consumer runs the retained
// verify-captures.py and recomputes, with tools/gf16_ffn_vectors.validate, that
// each capture reproduces the retained integer reference stage by stage and
// ActQuant value/code by value/code. The build record must show every routed
// clock domain passing a 60 MHz target. NOT replayed: raw DDR3 readback
// (verify-board.py needs local raw streams that are not committed), the
// bitstream, the weights, timing of the PHY/IO, attention, residuals, later
// layers or any model-quality claim; the reference is a retained file, not
// recomputed from weights.
module TrinityMemoryGf16FfnBoardEvidence {
    pub const TMGB_ISSUE: u32 = 111;
    pub const TMGB_RUNS: u32 = 2;
    pub const TMGB_STAGE_VALUES: u32 = 32768;
    pub const TMGB_ACTQUANT_VALUES: u32 = 9472;
    pub const TMGB_ROUTED_60MHZ: u32 = 1;

    pub fn tmgb_accept(source_current: bool, evidence_exact: bool,
                       replay_passed: bool, runs: u32, stage_values: u32,
                       actquant_values: u32, routed_60mhz: u32) -> bool {
        return source_current && evidence_exact && replay_passed
            && runs == TMGB_RUNS && stage_values == TMGB_STAGE_VALUES
            && actquant_values == TMGB_ACTQUANT_VALUES
            && routed_60mhz == TMGB_ROUTED_60MHZ;
    }

    test complete_retained_evidence {
        assert tmgb_accept(true, true, true, 2, 32768, 9472, 1);
        assert TMGB_ISSUE == 111;
    }
    test missing_or_wrong_evidence {
        assert !tmgb_accept(false, true, true, 2, 32768, 9472, 1);
        assert !tmgb_accept(true, false, true, 2, 32768, 9472, 1);
        assert !tmgb_accept(true, true, false, 2, 32768, 9472, 1);
        assert !tmgb_accept(true, true, true, 1, 32768, 9472, 1);
        assert !tmgb_accept(true, true, true, 3, 32768, 9472, 1);
        assert !tmgb_accept(true, true, true, 2, 32767, 9472, 1);
        assert !tmgb_accept(true, true, true, 2, 32769, 9472, 1);
        assert !tmgb_accept(true, true, true, 2, 32768, 9471, 1);
        assert !tmgb_accept(true, true, true, 2, 32768, 9473, 1);
        assert !tmgb_accept(true, true, true, 2, 32768, 9472, 0);
        assert !tmgb_accept(true, true, true, 2, 32768, 9472, 2);
    }
}
