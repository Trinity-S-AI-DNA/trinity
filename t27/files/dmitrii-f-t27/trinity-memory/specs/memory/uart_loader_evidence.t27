// SPDX-License-Identifier: Apache-2.0
// Issue: https://github.com/dmitrii-f-t27/trinity-memory/issues/127
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/63
// Replay of retained UART loader board runs (host to AX7203), not a new board run.
// Ten runs are replayed from their raw received byte streams (*.rx.bin.gz): five on the
// block-RAM build 1d474000 and five on the DDR3 build a9a56541 (seed 3). The stream hash
// is checked against the record, the stream is re-decoded, every read-back frame of the
// payload is CRC-checked and reassembled, and the bytes' sha256 and TMEM header must equal
// the record's; every load chunk needs its ack line; the nak lines by reason must equal the
// record's retransmits (injected corrupt, drop and abort faults); the DDR3 runs must end
// with calibration complete, state 23 and no clock lost. Hash-bound payload only: the qproj
// rows file itself is not retained, so "real weights" rests on its recorded sha256.
// NOT replayed: the 1.3 MB qproj runs (DDR3 runs 3 and 7) and block-RAM run 6 (raw streams
// not committed, only their sha256 in the record), the superseded build 22844259 and the
// failed build 6bc63ca4, timing and throughput (host clocks), the TMEM trit decode (needs the
// native library), the RTL (its Icarus tests tests/test_uart_loader.py and tests/test_ddr3_loader.py
// run in CI, not here), and the DDR3 PHY.
// Queen must additionally require accepted default-branch source and green CI.
module TrinityMemoryUartLoaderEvidence {
    pub const TMUL_ISSUE: u32 = 63;
    pub const TMUL_RUNS: u32 = 10;
    pub const TMUL_LOAD_ACKS: u32 = 339;
    pub const TMUL_READBACK_BYTES: u32 = 1360040;
    pub const TMUL_NAK_LINES: u32 = 10;
    pub const TMUL_DDR3_CALIBRATED_RUNS: u32 = 5;

    pub fn tmul_accept(source_current: bool, evidence_exact: bool, replay_passed: bool,
                       runs: u32, load_acks: u32, readback_bytes: u32,
                       nak_lines: u32, calibrated_runs: u32) -> bool {
        return source_current && evidence_exact && replay_passed
            && runs == TMUL_RUNS && load_acks == TMUL_LOAD_ACKS
            && readback_bytes == TMUL_READBACK_BYTES && nak_lines == TMUL_NAK_LINES
            && calibrated_runs == TMUL_DDR3_CALIBRATED_RUNS;
    }

    test complete_retained_evidence {
        assert tmul_accept(true, true, true, 10, 339, 1360040, 10, 5);
        assert TMUL_ISSUE == 63;
    }
    test missing_or_wrong_evidence {
        assert !tmul_accept(false, true, true, 10, 339, 1360040, 10, 5);
        assert !tmul_accept(true, false, true, 10, 339, 1360040, 10, 5);
        assert !tmul_accept(true, true, false, 10, 339, 1360040, 10, 5);
        assert !tmul_accept(true, true, true, 9, 339, 1360040, 10, 5);
        assert !tmul_accept(true, true, true, 10, 338, 1360040, 10, 5);
        assert !tmul_accept(true, true, true, 10, 339, 1360039, 10, 5);
        assert !tmul_accept(true, true, true, 10, 339, 1360040, 9, 5);
        assert !tmul_accept(true, true, true, 10, 339, 1360040, 10, 4);
        assert !tmul_accept(true, true, true, 11, 339, 1360040, 10, 5);
    }
}
