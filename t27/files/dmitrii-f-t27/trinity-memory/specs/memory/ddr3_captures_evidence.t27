// SPDX-License-Identifier: Apache-2.0
// Issue: https://github.com/dmitrii-f-t27/trinity-memory/issues/127
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/61
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/62
// Retained DDR3 board captures of 2026-09-24, not a new board run.
// The consumer first checks every bound file against the evidence manifest,
// then re-decodes each committed UART transcript with tools/fpga-ddr3-capture.py
// (transcript sha256, decoder output equal to the kept record) and recounts:
//   #61: 33 bring-up captures re-decoded; 10 clean x16 and 17 clean x32 runs
//        (calibration complete, no return to IDLE, pattern or BIST checks pass);
//        zero wrong bits and zero bad bursts in those clean runs.
//   #62: 3202 reader runs of 6 board loads re-decoded; zero bad words, invalid
//        groups, consumer stalls and stray acks over them.
// Not covered: the raw openFPGALoader/XADC files are not committed; the host
// model is run against the first 3 runs of each load, the rest only against the
// kept record; the Icarus simulation half of #62 and the seed sweeps, probes and
// x32 skew reports are not replayed here; nothing here shows the bitstream that
// ran was the one built from the t27 source. Some x32 builds failed on the board
// (seeds 1, 2, 5, 7, 9) and are replayed but not counted as clean.
// No receipt flag, closed issue or generated seal alone constitutes this proof.
module TrinityMemoryDdr3CapturesEvidence {
    pub const TMDC_CAPTURES: u32 = 33;
    pub const TMDC_CLEAN_X16: u32 = 10;
    pub const TMDC_CLEAN_X32: u32 = 17;
    pub const TMDC_PATTERN_ERRORS: u32 = 0;
    pub const TMDC_READER_RUNS: u32 = 3202;
    pub const TMDC_READER_DEFECTS: u32 = 0;

    pub fn tmdc_accept(source_current: bool, evidence_exact: bool,
                       replay_passed: bool, captures: u32, clean_x16: u32,
                       clean_x32: u32, pattern_errors: u32,
                       reader_runs: u32, reader_defects: u32) -> bool {
        return source_current && evidence_exact && replay_passed
            && captures == TMDC_CAPTURES && clean_x16 == TMDC_CLEAN_X16
            && clean_x32 == TMDC_CLEAN_X32
            && pattern_errors == TMDC_PATTERN_ERRORS
            && reader_runs == TMDC_READER_RUNS
            && reader_defects == TMDC_READER_DEFECTS;
    }

    test complete_retained_evidence {
        assert tmdc_accept(true, true, true, 33, 10, 17, 0, 3202, 0);
    }
    test missing_or_wrong_evidence {
        assert !tmdc_accept(false, true, true, 33, 10, 17, 0, 3202, 0);
        assert !tmdc_accept(true, false, true, 33, 10, 17, 0, 3202, 0);
        assert !tmdc_accept(true, true, false, 33, 10, 17, 0, 3202, 0);
        assert !tmdc_accept(true, true, true, 32, 10, 17, 0, 3202, 0);
        assert !tmdc_accept(true, true, true, 33, 9, 17, 0, 3202, 0);
        assert !tmdc_accept(true, true, true, 33, 10, 16, 0, 3202, 0);
        assert !tmdc_accept(true, true, true, 33, 10, 17, 1, 3202, 0);
        assert !tmdc_accept(true, true, true, 33, 10, 17, 0, 3201, 0);
        assert !tmdc_accept(true, true, true, 33, 10, 17, 0, 3202, 1);
    }
}
