// SPDX-License-Identifier: Apache-2.0
// Issue: https://github.com/dmitrii-f-t27/trinity-memory/issues/129
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/32
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/33
// REPLAY DEPENDENCIES, STATED PLAINLY: this claim is not replayable from the git tree alone. It
// needs (1) the sha256-pinned fixture ranges of fixtures/manifest.json in build/fixtures (554 byte
// ranges of the public BitNet b1.58 2B4T and Ternary Bonsai 2 27B files, about 217 MB, fetched by
// tools/fetch-fixtures.py and verified against the manifest), (2) the sha256-pinned llama.cpp
// sources of tests/upstream/llama.cpp.lock.json in build/upstream (commit 4364bf72), and (3) the
// t27 compiler pinned by native/compiler.lock ($T27_ROOT, cargo 1.94.0) that builds t27/*.t27
// into the native library and formats.wasm (clang with wasm32 or zig, plus wasm-ld). If a cache
// is absent the replay fails; it never skips.
// What is replayed (tools/evidence/ternary_check_matrix.py, run by tools/evidence-proof.py), the
// chain of the CI job ternary-check in check mode:
//  - tools/ternary-check.sh --check: every cell of the matrix is recomputed from the pinned bytes
//    (published bytes decoded by t27/formats.t27, t27 round trips, llama.cpp-encoded TQ1_0 and
//    TQ2_0 cells) and reports/ternary-check.json, .html and repro/ are reproduced byte for byte.
//  - TRINITY_REQUIRE_CACHED=1 node tests/matrix_wasm.mjs and tests/matvec_wasm.mjs recompute
//    every cell, every derived cell and every stored form of the real layers in formats.wasm
//    (t27/matrix.t27, t27/matvec.t27 over t27/compute.t27 dot primitives), a second route.
//  - python -m unittest tests.test_ternary_check tests.test_matvec, none skipped.
//  - the matrix and matvec reports are recomputed into a temporary directory, required equal to
//    the committed ones, and the counts below are taken from that recomputed copy.
// Issue 32 (matrix): 36 cells = 3 tensors (BitNet q_proj and down_proj, Bonsai ffn_down) x 12
// columns (10 storage formats, plus the two llama.cpp-encoded TQ columns), 2 model families.
// 23 match, 4 mismatch, 9 not-representable (each with a reason). The trits are identical in all
// 27 representable cells; the 4 mismatches are scale words only and each carries an explanation
// (I2_S stores the scale as f32, the bf16 word rounds differently; llama.cpp TQ blocks of q_proj
// hold zero-weight groups with scale 0). The triple check of the issue is reported honestly:
// packed == I2_S holds for both BitNet tensors (2), bf16 absmean == packed holds for none (0):
// the 2 derived cells differ at the ties of the absmean rounding and are explained as tie_split.
// Issue 33 (matvec): y = W x with the deterministic int8 vector (CPython Random(27)), integer
// accumulators per 64-column dot of t27/compute.t27. 8 stored forms (hf_packed, I2_S of two
// BitNet tensors; PTQ1_0, PQ2_0, Q2_0, mlx_2bit of the Bonsai tensor) give identical accumulators
// in all 3 tensors (0 differing rows); the absmean derivation differs from the packed weights
// and its y difference equals D x in every row (0 rows with a residual).
// NOT replayed or not claimed: Hugging Face downloads (the caches are consumed, not re-fetched),
// any model other than layer 0 of BitNet and the one Bonsai layer, the other tensors of those
// models, activation quantisation, the PrismML Hadamard rotation (products use the stored
// weights without it), the FFN and attention tests that share the CI job, the HTML as a
// rendering, and hardware. Queen must additionally require accepted default-branch source and
// green CI of the job ternary-check.
module TrinityMemoryTernaryCheckMatrixEvidence {
    pub const TMCM_CELLS: u32 = 36;
    pub const TMCM_WASM_CELLS: u32 = 38;
    pub const TMCM_MATCH: u32 = 23;
    pub const TMCM_MISMATCH: u32 = 4;
    pub const TMCM_NOT_REPRESENTABLE: u32 = 9;
    pub const TMCM_TRIT_EXACT: u32 = 27;
    pub const TMCM_SCALE_EXACT: u32 = 23;
    pub const TMCM_UNEXPLAINED: u32 = 0;
    pub const TMCM_FORMATS: u32 = 12;
    pub const TMCM_FAMILIES: u32 = 2;
    pub const TMCM_TRIPLE_PACKED_EQ_I2S: u32 = 2;
    pub const TMCM_TRIPLE_ABSMEAN_EQ_PACKED: u32 = 0;
    pub const TMCM_ABSMEAN_EXPLAINED: u32 = 2;
    pub const TMCM_MATVEC_FORMS: u32 = 8;
    pub const TMCM_IDENTICAL_TENSORS: u32 = 3;
    pub const TMCM_ACC_ROWS_DIFFER: u32 = 0;
    pub const TMCM_RESIDUAL_ROWS_DIFFER: u32 = 0;
    pub const TMCM_TESTS: u32 = 30;
    pub const TMCM_SKIPPED: u32 = 0;

    pub fn tmcm_accept(source_current: bool, evidence_exact: bool, replay_passed: bool,
                       cells: u32,
                       wasm_cells: u32,
                       match: u32,
                       mismatch: u32,
                       not_representable: u32,
                       trit_exact: u32,
                       scale_exact: u32,
                       unexplained: u32,
                       formats: u32,
                       families: u32,
                       triple_packed_eq_i2s: u32,
                       triple_absmean_eq_packed: u32,
                       absmean_explained: u32,
                       matvec_forms: u32,
                       identical_tensors: u32,
                       acc_rows_differ: u32,
                       residual_rows_differ: u32,
                       tests: u32,
                       skipped: u32) -> bool {
        return source_current && evidence_exact && replay_passed
            && cells == TMCM_CELLS
            && wasm_cells == TMCM_WASM_CELLS
            && match == TMCM_MATCH
            && mismatch == TMCM_MISMATCH
            && not_representable == TMCM_NOT_REPRESENTABLE
            && trit_exact == TMCM_TRIT_EXACT
            && scale_exact == TMCM_SCALE_EXACT
            && unexplained == TMCM_UNEXPLAINED
            && formats == TMCM_FORMATS
            && families == TMCM_FAMILIES
            && triple_packed_eq_i2s == TMCM_TRIPLE_PACKED_EQ_I2S
            && triple_absmean_eq_packed == TMCM_TRIPLE_ABSMEAN_EQ_PACKED
            && absmean_explained == TMCM_ABSMEAN_EXPLAINED
            && matvec_forms == TMCM_MATVEC_FORMS
            && identical_tensors == TMCM_IDENTICAL_TENSORS
            && acc_rows_differ == TMCM_ACC_ROWS_DIFFER
            && residual_rows_differ == TMCM_RESIDUAL_ROWS_DIFFER
            && tests == TMCM_TESTS
            && skipped == TMCM_SKIPPED;
    }

    test complete_replay {
        assert tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
    }

    test missing_or_wrong_evidence {
        assert !tmcm_accept(false, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, false, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, false, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 37, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 35, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 39, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 37, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 24, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 22, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 5, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 3, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 10, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 8, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 28, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 26, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 24, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 22, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 1, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 13, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 11, 2, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 3, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 1, 2, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 3, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 1, 0, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 1, 2, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 3, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 1, 8, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 9, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 7, 3, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 4, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 2, 0, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 1, 0, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 1, 30, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 31, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 29, 0);
        assert !tmcm_accept(true, true, true, 36, 38, 23, 4, 9, 27, 23, 0, 12, 2, 2, 0, 2, 8, 3, 0, 0, 30, 1);
    }
}
