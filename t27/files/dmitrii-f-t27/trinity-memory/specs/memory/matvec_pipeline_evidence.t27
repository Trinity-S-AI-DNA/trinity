// SPDX-License-Identifier: Apache-2.0
// Issue: https://github.com/dmitrii-f-t27/trinity-memory/issues/127
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/88
// Retained AX7203 matvec compute-pipeline captures, not a new board run.
// Replayed offline: 24 raw UART captures (12 compute_pipeline 0, 12 compute_pipeline 1,
// dense5 q_proj 320 x 2560, 60 MHz controller, source d375d7ff) are hashed, parsed
// strictly and every Y accumulator is compared with a committed reference vector
// (derived from the pinned BitNet fixtures; the fixtures themselves are not in this
// tree). Cycle counts are taken from the raw `c` lines; the ratio is
// floor(1e6 * baseline / pipeline). NOT replayed: routed timing, resource use,
// the simulation/randomized-stall/arbiter acceptance tests, baseline2, down_proj,
// and the physical measurement itself. Queen must additionally require accepted
// default-branch source and green CI.
module TrinityMemoryMatvecPipelineEvidence {
    pub const TMMP_ISSUE: u32 = 88;
    pub const TMMP_CAPTURES: u32 = 24;
    pub const TMMP_ROWS: u32 = 7680;
    pub const TMMP_BAD_ROWS: u32 = 0;
    pub const TMMP_BASELINE_CYCLES: u32 = 235544;
    pub const TMMP_PIPELINE_CYCLES: u32 = 143384;
    pub const TMMP_RATIO_PPM: u32 = 1642749;

    pub fn tmmp_accept(source_current: bool, evidence_exact: bool,
                       replay_passed: bool, captures: u32, rows: u32,
                       bad_rows: u32, baseline_cycles: u32,
                       pipeline_cycles: u32, ratio_ppm: u32) -> bool {
        return source_current && evidence_exact && replay_passed
            && captures == TMMP_CAPTURES && rows == TMMP_ROWS
            && bad_rows == TMMP_BAD_ROWS
            && baseline_cycles == TMMP_BASELINE_CYCLES
            && pipeline_cycles == TMMP_PIPELINE_CYCLES
            && ratio_ppm == TMMP_RATIO_PPM;
    }

    test complete_retained_evidence {
        assert tmmp_accept(true, true, true, 24, 7680, 0, 235544, 143384, 1642749);
        assert TMMP_ISSUE == 88;
    }
    test missing_or_wrong_evidence {
        assert !tmmp_accept(false, true, true, 24, 7680, 0, 235544, 143384, 1642749);
        assert !tmmp_accept(true, false, true, 24, 7680, 0, 235544, 143384, 1642749);
        assert !tmmp_accept(true, true, false, 24, 7680, 0, 235544, 143384, 1642749);
        assert !tmmp_accept(true, true, true, 23, 7680, 0, 235544, 143384, 1642749);
        assert !tmmp_accept(true, true, true, 24, 7679, 0, 235544, 143384, 1642749);
        assert !tmmp_accept(true, true, true, 24, 7680, 1, 235544, 143384, 1642749);
        assert !tmmp_accept(true, true, true, 24, 7680, 0, 235543, 143384, 1642749);
        assert !tmmp_accept(true, true, true, 24, 7680, 0, 235544, 143385, 1642749);
        assert !tmmp_accept(true, true, true, 24, 7680, 0, 235544, 143384, 1642750);
    }
}
