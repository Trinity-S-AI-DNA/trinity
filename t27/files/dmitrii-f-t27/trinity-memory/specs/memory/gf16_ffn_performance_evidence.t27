// SPDX-License-Identifier: Apache-2.0
// Issue: https://github.com/dmitrii-f-t27/trinity-memory/issues/127
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/113
// Retained GF16 layer-0 FFN performance evidence (2026-10-01), not a new board run.
// Replayed offline: five RTL simulation replay captures, serial/accelerated
// simulation result-mode captures, and six physical AX7203 captures (full and
// result-only for serial BOS, accelerated BOS, accelerated zero input), each
// re-validated word by word against its saved integer oracle with the phase
// partition and projection-loop clocks checked. Counts are recomputed from those
// retained raw captures by tools/evidence/gf16_ffn_performance.py after
// verify-evidence.py and verify-board-evidence.py pass.
// Ratios are floor(1e6 * serial / accelerated) of recomputed clock totals:
// simulation result-mode active 288502758/183993318 = 1.568006x, simulation
// projection loop 265420800/160911360 = 1.649484x, physical result-mode active
// window 292383894/188528131 = 1.550876x at the 60 MHz controller clock.
// Seconds are clocks over the nominal 60 MHz, not an independent wall clock.
// NOT replayed: verify-raw-board.py (needs local DDR payloads and raw readback
// streams that are not committed; only its hash and receipt are checked), routed
// timing and bitstream builds (logs retained and hash-bound, not re-run), the
// UART-dominated full-trace time, energy, and any later-model work.
module TrinityMemoryGf16FfnPerformanceEvidence {
    pub const TMGP_ISSUE: u32 = 113;
    pub const TMGP_REPLAY_VALUES: u32 = 211200;
    pub const TMGP_PHYSICAL_CAPTURES: u32 = 6;
    pub const TMGP_SIM_ACTIVE_PPM: u32 = 1568006;
    pub const TMGP_SIM_LOOP_PPM: u32 = 1649484;
    pub const TMGP_PHYSICAL_ACTIVE_PPM: u32 = 1550876;

    pub fn tmgp_accept(source_current: bool, evidence_exact: bool,
                       replay_passed: bool, replay_values: u32,
                       physical_captures: u32, sim_active_ppm: u32,
                       sim_loop_ppm: u32, physical_active_ppm: u32) -> bool {
        return source_current && evidence_exact && replay_passed
            && replay_values == TMGP_REPLAY_VALUES
            && physical_captures == TMGP_PHYSICAL_CAPTURES
            && sim_active_ppm == TMGP_SIM_ACTIVE_PPM
            && sim_loop_ppm == TMGP_SIM_LOOP_PPM
            && physical_active_ppm == TMGP_PHYSICAL_ACTIVE_PPM;
    }

    test complete_retained_evidence {
        assert tmgp_accept(true, true, true, 211200, 6, 1568006, 1649484, 1550876);
        assert TMGP_ISSUE == 113;
    }
    test missing_or_wrong_evidence {
        assert !tmgp_accept(false, true, true, 211200, 6, 1568006, 1649484, 1550876);
        assert !tmgp_accept(true, false, true, 211200, 6, 1568006, 1649484, 1550876);
        assert !tmgp_accept(true, true, false, 211200, 6, 1568006, 1649484, 1550876);
        assert !tmgp_accept(true, true, true, 211199, 6, 1568006, 1649484, 1550876);
        assert !tmgp_accept(true, true, true, 211200, 5, 1568006, 1649484, 1550876);
        assert !tmgp_accept(true, true, true, 211200, 6, 1568005, 1649484, 1550876);
        assert !tmgp_accept(true, true, true, 211200, 6, 1568006, 1649485, 1550876);
        assert !tmgp_accept(true, true, true, 211200, 6, 1568006, 1649484, 1550877);
    }
}
