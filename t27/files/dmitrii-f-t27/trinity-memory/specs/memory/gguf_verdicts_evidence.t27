// SPDX-License-Identifier: Apache-2.0
// Issue: https://github.com/dmitrii-f-t27/trinity-memory/issues/127
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/50
// Not claimed: #51 (its table cites runtime source lines and lists mlx and onnxruntime, which
// t27/runtimes.t27 does not hold; only the verdict rule and the table regeneration replay here).
// What is replayed (tools/evidence/gguf_verdicts.py, run by tools/evidence-proof.py):
//  - 14 committed synthetic GGUF headers (fixtures/gguf-verdicts/cases.json, written
//    byte by byte by tools/evidence/_gguf_verdicts_cases.py) go through the C generated
//    by the pinned t27c from t27/live.t27 and t27/runtimes.t27: tlv_model for the four
//    runtimes (llama.cpp, PrismML fork, bitnet.cpp, mortar.cpp), tlv_native,
//    tlv_ternary_count, tlv_file_verdict and tlv_walk. 34 (header, runtime) cells are
//    checked against hand-written verdicts (runs / refuses with status and offsets /
//    ignores the declared rotation = "silent"); every header also keeps its native
//    runtime and file verdict.
//  - Issue 50: 2 type-42 headers whose bytes fit 128-weight groups are diagnosed by the
//    generated walk as PQ2_0 (declared Q2_0 id 42, stored group 128); the diagnosis is
//    confirmed from the retained real-file replay of 2026-09-29: 9 public files whose
//    t27 verdict is refused, with an extent diagnosis of PQ2_0, were refused by all
//    three upstream gguf.cpp readers (counted from the per-file records of
//    reports/live/legacy-q2_0-2026-09-29/scan-replay.json; the readers are not re-run).
//  - Issue 51: the 147 type rows of specs/runtimes/*.json are regenerated into
//    t27/runtimes.t27 without a difference (tools/generate-runtime-tables.py --check).
// NOT replayed: the Hugging Face scan of every public model (issue 48), upstream drift
// and the 98 fixes, real upstream readers, runtimes outside runtimes.t27 (mlx,
// onnxruntime), the line citations of the table cells, split-model parts, and
// real model headers (none is committed). This is retained and synthetic evidence, not
// a new scan. Queen must additionally require accepted default-branch source and green CI.
module TrinityMemoryGgufVerdictsEvidence {
    pub const TMGV_HEADERS: u32 = 14;
    pub const TMGV_CELLS: u32 = 34;
    pub const TMGV_DIAGNOSES: u32 = 2;
    pub const TMGV_TABLE_ROWS: u32 = 147;
    pub const TMGV_LEGACY_CONFIRMED: u32 = 9;

    pub fn tmgv_accept(source_current: bool, evidence_exact: bool, replay_passed: bool,
                       headers: u32, cells: u32, diagnoses: u32,
                       table_rows: u32, legacy_confirmed: u32) -> bool {
        return source_current && evidence_exact && replay_passed
            && headers == TMGV_HEADERS && cells == TMGV_CELLS
            && diagnoses == TMGV_DIAGNOSES && table_rows == TMGV_TABLE_ROWS
            && legacy_confirmed == TMGV_LEGACY_CONFIRMED;
    }

    test complete_replay {
        assert tmgv_accept(true, true, true, 14, 34, 2, 147, 9);
        assert TMGV_HEADERS == 14;
    }
    test missing_or_wrong_evidence {
        assert !tmgv_accept(false, true, true, 14, 34, 2, 147, 9);
        assert !tmgv_accept(true, false, true, 14, 34, 2, 147, 9);
        assert !tmgv_accept(true, true, false, 14, 34, 2, 147, 9);
        assert !tmgv_accept(true, true, true, 13, 34, 2, 147, 9);
        assert !tmgv_accept(true, true, true, 14, 33, 2, 147, 9);
        assert !tmgv_accept(true, true, true, 14, 34, 1, 147, 9);
        assert !tmgv_accept(true, true, true, 14, 34, 2, 146, 9);
        assert !tmgv_accept(true, true, true, 14, 34, 2, 147, 8);
        assert !tmgv_accept(true, true, true, 15, 34, 2, 147, 9);
        assert !tmgv_accept(true, true, true, 14, 35, 2, 147, 9);
        assert !tmgv_accept(true, true, true, 14, 34, 3, 147, 9);
        assert !tmgv_accept(true, true, true, 14, 34, 2, 148, 9);
        assert !tmgv_accept(true, true, true, 14, 34, 2, 147, 10);
    }
}
