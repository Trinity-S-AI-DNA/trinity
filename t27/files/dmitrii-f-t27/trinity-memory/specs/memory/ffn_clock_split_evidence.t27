// SPDX-License-Identifier: Apache-2.0
// Issue: https://github.com/dmitrii-f-t27/trinity-memory/issues/127
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/94
// Replay of the retained clock-split FFN board runs (seed27 and zero) on AX7203, not a new board run.
// Recomputed from the retained raw data: both compressed UART captures are re-validated
// against the stage 5 integer reference vectors (32768 stage values per run, saturations,
// line order, doorbell ack) by tools/ffn_vectors.py validate(); its two `k` lines give the
// report-wait and memory-wait counters, the compute clocks are the remainder of the `c`
// total (present in both runs) and must be equal in both runs; capture and payload hashes are checked.
// Counted from the host loader receipts only: every load chunk acknowledged and every
// readback chunk crc_ok on its final attempt (the raw readback streams are NOT retained;
// the README notes some readback frames failed CRC and were re-requested, which the receipts
// record as extra read attempts, not as load retransmits).
// NOT covered: the simulation test that compute clocks do not depend on memory or report
// latency (tests/test_ffn_rtl.py runs in CI, not here), timing closure and seed sweep
// (build-gates.json is bound but only its bitstream hash and source head are checked),
// the boot-refused 93 C record, verify-ffn-board.py (hard-coded private paths, not run),
// that the reference is the BitNet layer-0 oracle, and any throughput claim.
// Queen must additionally require accepted default-branch source and green CI.
module TrinityMemoryFfnClockSplitEvidence {
    pub const TMFC_ISSUE: u32 = 94;
    pub const TMFC_RUNS: u32 = 2;
    pub const TMFC_STAGE_VALUES: u32 = 65536;
    pub const TMFC_LOADS: u32 = 16;
    pub const TMFC_CHUNKS: u32 = 13182;
    pub const TMFC_COMPUTE_CLOCKS: u32 = 118308783;

    pub fn tmfc_accept(source_current: bool, evidence_exact: bool, replay_passed: bool,
                       runs: u32, stage_values: u32, loads: u32, chunks: u32,
                       compute_clocks: u32) -> bool {
        return source_current && evidence_exact && replay_passed
            && runs == TMFC_RUNS && stage_values == TMFC_STAGE_VALUES
            && loads == TMFC_LOADS && chunks == TMFC_CHUNKS
            && compute_clocks == TMFC_COMPUTE_CLOCKS;
    }

    test complete_retained_evidence {
        assert tmfc_accept(true, true, true, 2, 65536, 16, 13182, 118308783);
        assert TMFC_ISSUE == 94;
    }
    test missing_or_wrong_evidence {
        assert !tmfc_accept(false, true, true, 2, 65536, 16, 13182, 118308783);
        assert !tmfc_accept(true, false, true, 2, 65536, 16, 13182, 118308783);
        assert !tmfc_accept(true, true, false, 2, 65536, 16, 13182, 118308783);
        assert !tmfc_accept(true, true, true, 1, 65536, 16, 13182, 118308783);
        assert !tmfc_accept(true, true, true, 2, 65535, 16, 13182, 118308783);
        assert !tmfc_accept(true, true, true, 2, 65536, 15, 13182, 118308783);
        assert !tmfc_accept(true, true, true, 2, 65536, 16, 13181, 118308783);
        assert !tmfc_accept(true, true, true, 2, 65536, 16, 13182, 118308784);
        assert !tmfc_accept(true, true, true, 2, 65536, 16, 13182, 118308782);
    }
}
