// SPDX-License-Identifier: Apache-2.0
// Issue: https://github.com/dmitrii-f-t27/trinity-memory/issues/127
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/92
// Replay of the retained Q16 FFN board runs (seed27 and zero) on AX7203, not a new board run.
// Recomputed from the retained raw data: both compressed UART captures are parsed and
// every stage value (32768 per run), the saturation counters, the line order, the clock
// counter and the doorbell acknowledgement are compared with the retained integer
// reference by tools/ffn_vectors.py validate(); capture and payload hashes are checked.
// Counted from the host loader receipts only: every load chunk acknowledged and every
// readback chunk reported crc_ok. The raw readback streams (*.rx.bin.gz) are NOT retained,
// so the CRC readback is not re-decoded here.
// NOT covered: that the retained reference is the BitNet layer-0 oracle (its weights are
// not in this tree), that the capture came from silicon (only the receipts and thermal log
// say so), timing closure, the clock split (#94), ActQuant/bf16, attention, residuals.
// Queen must additionally require accepted default-branch source and green CI.
module TrinityMemoryFfnQ16BoardEvidence {
    pub const TMFQ_ISSUE: u32 = 92;
    pub const TMFQ_RUNS: u32 = 2;
    pub const TMFQ_STAGE_VALUES: u32 = 65536;
    pub const TMFQ_LOADS: u32 = 16;
    pub const TMFQ_CHUNKS: u32 = 13182;

    pub fn tmfq_accept(source_current: bool, evidence_exact: bool, replay_passed: bool,
                       runs: u32, stage_values: u32, loads: u32, chunks: u32) -> bool {
        return source_current && evidence_exact && replay_passed
            && runs == TMFQ_RUNS && stage_values == TMFQ_STAGE_VALUES
            && loads == TMFQ_LOADS && chunks == TMFQ_CHUNKS;
    }

    test complete_retained_evidence {
        assert tmfq_accept(true, true, true, 2, 65536, 16, 13182);
        assert TMFQ_ISSUE == 92;
    }
    test missing_or_wrong_evidence {
        assert !tmfq_accept(false, true, true, 2, 65536, 16, 13182);
        assert !tmfq_accept(true, false, true, 2, 65536, 16, 13182);
        assert !tmfq_accept(true, true, false, 2, 65536, 16, 13182);
        assert !tmfq_accept(true, true, true, 1, 65536, 16, 13182);
        assert !tmfq_accept(true, true, true, 2, 65535, 16, 13182);
        assert !tmfq_accept(true, true, true, 2, 65536, 15, 13182);
        assert !tmfq_accept(true, true, true, 2, 65536, 16, 13181);
        assert !tmfq_accept(true, true, true, 3, 65536, 16, 13182);
    }
}
