// SPDX-License-Identifier: Apache-2.0
// Issue: https://github.com/dmitrii-f-t27/trinity-memory/issues/129
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/91
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/105
// NUMERIC REPLAY OF REAL MODEL DATA, NOT HARDWARE EVIDENCE.
// THE REPLAY DEPENDS ON THE sha256-PINNED FETCHED CACHE build/fixtures. The real
// BitNet b1.58 2B-4T layer-0 tensors are not committed; tools/fetch-fixtures.py
// fills the byte-range cache, and every read is checked against the sha256 in
// fixtures/manifest.json. Without that cache the claim FAILS (it never skips):
// the verifiers run with TRINITY_REQUIRE_CACHED=1 and TRINITY_FIXTURES_OFFLINE=1.
// The native t27 library (tools/build-t27.sh) must be built too.
// Replayed from those pinned tensors:
//   #91  the corrected real-fixture report reports/ffn/reference-2026-09-28.json:
//        tests.test_ffn_reference (11 tests, incl. FixtureLayerTest, which
//        recomputes f64 and Q16.16/wide stages h,g,u,a,s,y from the real weights
//        and compares them with the report), plus a recomputation of all 53084160
//        ternary weights, 6 stages inside the guard, 0 saturations, and both
//        output hashes equal to the report.
//   #105 tests.test_ffn_quantization (9 tests) and
//        `tools/ffn_quantization.py --check`: the committed report
//        reports/numeric/ffn-quantization-v1.json, 5 synthetic probes x 4
//        propagated GF16/BF16 paths, recomputed byte for byte.
// NOT replayed: ActQuant/AutoBitLinear or a bf16 runtime, captured text
// activations (the probes are synthetic), language-model quality, GF16 codec
// conformance (claim ffn_oracles), attention (tests.test_attn_reference), any
// board or performance claim. The counts come from the verifiers' own runs.
module TrinityMemoryFfnRealLayerEvidence {
    pub const TMFR_FFN_TESTS: u32 = 11;
    pub const TMFR_REAL_LAYER_TESTS: u32 = 1;
    pub const TMFR_QUANT_TESTS: u32 = 9;
    pub const TMFR_WEIGHTS: u32 = 53084160;
    pub const TMFR_STAGES_IN_GUARD: u32 = 6;
    pub const TMFR_SATURATIONS: u32 = 0;
    pub const TMFR_PROBES: u32 = 5;
    pub const TMFR_PATHS: u32 = 20;

    pub fn tmfr_accept(source_current: bool, evidence_exact: bool,
                       replay_passed: bool, ffn_tests: u32, real_tests: u32,
                       quant_tests: u32, weights: u32, stages_in_guard: u32,
                       saturations: u32, probes: u32, paths: u32) -> bool {
        return source_current && evidence_exact && replay_passed
            && ffn_tests == TMFR_FFN_TESTS && real_tests == TMFR_REAL_LAYER_TESTS
            && quant_tests == TMFR_QUANT_TESTS && weights == TMFR_WEIGHTS
            && stages_in_guard == TMFR_STAGES_IN_GUARD
            && saturations == TMFR_SATURATIONS
            && probes == TMFR_PROBES && paths == TMFR_PATHS;
    }

    test complete_real_layer {
        assert tmfr_accept(true, true, true, 11, 1, 9, 53084160, 6, 0, 5, 20);
    }
    test missing_or_wrong_evidence {
        assert !tmfr_accept(false, true, true, 11, 1, 9, 53084160, 6, 0, 5, 20);
        assert !tmfr_accept(true, false, true, 11, 1, 9, 53084160, 6, 0, 5, 20);
        assert !tmfr_accept(true, true, false, 11, 1, 9, 53084160, 6, 0, 5, 20);
        assert !tmfr_accept(true, true, true, 10, 1, 9, 53084160, 6, 0, 5, 20);
        assert !tmfr_accept(true, true, true, 11, 0, 9, 53084160, 6, 0, 5, 20);
        assert !tmfr_accept(true, true, true, 11, 1, 8, 53084160, 6, 0, 5, 20);
        assert !tmfr_accept(true, true, true, 11, 1, 9, 53084159, 6, 0, 5, 20);
        assert !tmfr_accept(true, true, true, 11, 1, 9, 53084160, 5, 0, 5, 20);
        assert !tmfr_accept(true, true, true, 11, 1, 9, 53084160, 6, 1, 5, 20);
        assert !tmfr_accept(true, true, true, 11, 1, 9, 53084160, 6, 0, 4, 20);
        assert !tmfr_accept(true, true, true, 11, 1, 9, 53084160, 6, 0, 5, 19);
    }
}
