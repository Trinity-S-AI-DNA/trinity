// SPDX-License-Identifier: Apache-2.0
// Issue: https://github.com/dmitrii-f-t27/trinity-memory/issues/127
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/49
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/52
// Replayed offline: t27/hadamard.t27 and t27/live.t27 (tlv_hadamard) are generated
// to C by the pinned t27c and run over committed vectors. No model file, runtime,
// network or hardware is involved; this is not a run of PrismML's fork.
//  - 80 rotation vectors (reports/prism_hadamard/inputs.json; blocks 16, 64,
//    256, 1024; identity and explicit signs; extreme, impulse, ramp and random
//    integer inputs). For each: every numerator of sw_rotate_numerator equals an
//    independent Python butterfly transform, sw_normalisation equals the integer
//    square root of the block, numerator / divisor equals the expected f64 bit
//    pattern, and rotating the numerators again with the signs returns
//    block * input exactly (rotating twice returns the input). A table of 18
//    blocks (powers of two and not) must also get the right divisor; a miss
//    aborts the replay.
//  - 8 positive vectors of conformance/hadamard_rotate.json (the vectors of #52's
//    Action), bit for bit through the generated code.
//  - 57 GGUF headers built byte by byte: 18 that tlv_hadamard accepts and 39 that
//    it refuses, each with the status class its mutation was built to trigger
//    (type, missing key, version, block, transform/axis/sign mode, signs,
//    architecture, weight name, tensor, tied output).
// Not covered: the three negative rotate vectors of hadamard_rotate.json (their
// status classes are assigned by trinity_memory/ternary_check_run.py, not by t27);
// the Action and CLI plumbing; any real PrismML model file; weights, signs and
// activations of real layers; the fork's own source (rules are those documented in
// t27/live.t27). Queen must additionally require accepted default-branch source
// and green CI.
module TrinityMemoryPrismHadamardEvidence {
    pub const TMPH_ROTATIONS: u32 = 80;
    pub const TMPH_FIXTURES: u32 = 8;
    pub const TMPH_ACCEPTED: u32 = 18;
    pub const TMPH_REJECTED: u32 = 39;

    pub fn tmph_accept(source_current: bool, evidence_exact: bool,
                       replay_passed: bool, rotations: u32, fixtures: u32,
                       accepted: u32, rejected: u32) -> bool {
        return source_current && evidence_exact && replay_passed
            && rotations == TMPH_ROTATIONS && fixtures == TMPH_FIXTURES
            && accepted == TMPH_ACCEPTED && rejected == TMPH_REJECTED;
    }

    test complete_replay {
        assert tmph_accept(true, true, true, 80, 8, 18, 39);
    }
    test missing_or_wrong_evidence {
        assert !tmph_accept(false, true, true, 80, 8, 18, 39);
        assert !tmph_accept(true, false, true, 80, 8, 18, 39);
        assert !tmph_accept(true, true, false, 80, 8, 18, 39);
        assert !tmph_accept(true, true, true, 79, 8, 18, 39);
        assert !tmph_accept(true, true, true, 80, 7, 18, 39);
        assert !tmph_accept(true, true, true, 80, 8, 17, 39);
        assert !tmph_accept(true, true, true, 80, 8, 18, 38);
        assert !tmph_accept(true, true, true, 81, 8, 18, 39);
    }
}
