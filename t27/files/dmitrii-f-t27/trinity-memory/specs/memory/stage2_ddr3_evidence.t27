// SPDX-License-Identifier: Apache-2.0
// Issue: https://github.com/dmitrii-f-t27/trinity-memory/issues/127
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/65
// Coverage: https://github.com/dmitrii-f-t27/trinity-memory/issues/67
// Retained 2026-09-27 DDR3 matvec measurements (AX7203), not a new board run.
// Replayed offline by tools/evidence/stage2_ddr3.py: it runs
// tools/stage2-report.py --check (JSON, HTML and docs/hardware.md rebuilt from
// the committed captures; a failure rejects) and recomputes: 12 runs per format
// (dense5 1.6 and baseline2 2.0 bits per weight, 24 in all) each covering
// 819,200 weights, every recorded weights/s equal to weights * 60 MHz / cycles;
// zero bad words (measured runs, golden summaries, direct reader); the dense5 /
// baseline2 throughput ratio 1.0000 (10000 in units of 1e-4); the first four
// device Y rows of each golden run equal the reference; and the separate direct
// reader's 1653 model-checked runs, recounted from its archived captures.
// Limits the report itself states: DDR3 bandwidth as the bottleneck is NOT
// established (the timed matvec includes UART result backpressure, consumer
// stalls of the 12-run series are unrecoverable), the 1.25 payload ceiling was
// not reached, and power, tokens/s, model quality, x32 and >480 MT/s are not
// measured. Not replayed: the 320/320 bit-exact flag (retained as a flag plus
// four rows, not 320 Y lines), the board runs, the 2026-09-28 pipeline/serial
// captures, and #67's release number and GPL-UberDDR3 licensing decisions.
// No receipt flag, closed issue or generated seal alone constitutes this proof.
module TrinityMemoryStage2Ddr3Evidence {
    pub const TMSD_RATE_RUNS: u32 = 24;
    pub const TMSD_BAD_WORDS: u32 = 0;
    pub const TMSD_RATIO_E4: u32 = 10000;
    pub const TMSD_GOLDEN_FIRST_ROWS: u32 = 8;
    pub const TMSD_READER_CHECKED_RUNS: u32 = 1653;

    pub fn tmsd_accept(source_current: bool, evidence_exact: bool,
                       replay_passed: bool, rate_runs: u32, bad_words: u32,
                       ratio_e4: u32, golden_first_rows: u32,
                       reader_checked_runs: u32) -> bool {
        return source_current && evidence_exact && replay_passed
            && rate_runs == TMSD_RATE_RUNS
            && bad_words == TMSD_BAD_WORDS
            && ratio_e4 == TMSD_RATIO_E4
            && golden_first_rows == TMSD_GOLDEN_FIRST_ROWS
            && reader_checked_runs == TMSD_READER_CHECKED_RUNS;
    }

    test complete_retained_evidence {
        assert tmsd_accept(true, true, true, 24, 0, 10000, 8, 1653);
    }
    test missing_or_wrong_evidence {
        assert !tmsd_accept(false, true, true, 24, 0, 10000, 8, 1653);
        assert !tmsd_accept(true, false, true, 24, 0, 10000, 8, 1653);
        assert !tmsd_accept(true, true, false, 24, 0, 10000, 8, 1653);
        assert !tmsd_accept(true, true, true, 23, 0, 10000, 8, 1653);
        assert !tmsd_accept(true, true, true, 24, 1, 10000, 8, 1653);
        assert !tmsd_accept(true, true, true, 24, 0, 12500, 8, 1653);
        assert !tmsd_accept(true, true, true, 24, 0, 10000, 7, 1653);
        assert !tmsd_accept(true, true, true, 24, 0, 10000, 8, 1652);
    }
}
