pub const SUMMARY_EN : str = "Reads the hive journal and delivers the queen's report to the keepers, passing alarms straight through and batching ordinary events.";
; A setInterval inside a long-lived process: a period, not a cron expression.
pub const INTERVAL_MS : u32 = 600000;
pub const TZ : str = "UTC";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
