// SPDX-License-Identifier: Apache-2.0
; specs/crons/mac-leela-dailyquote.t27 -- cron launchd/leela-vedic/leela-dailyquote
; Source of truth for the job card on t27.ai (#/crons?cron=launchd/leela-vedic/leela-dailyquote).
; The schedule was read from ~/Library/LaunchAgents/ai.t27.leela.dailyquote.plist on 2026-10-04.
; A launchd job runs on the owner's Mac: the Queen serves this card tick-only and never dispatches it.
; A cron CONTROLS skills: RUNS names the skill IDs it launches. It is empty
; unless the source evidently invokes one -- nothing here is inferred from a name.
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_mac_leela_dailyquote;

pub const KIND : str = "cron";
pub const ID : str = "launchd/leela-vedic/leela-dailyquote";
pub const NAME : str = "Leela daily quote";
pub const HOST : str = "launchd";
pub const REPO : str = "leela-vedic";
pub const SERVICE : str = "ai.t27.leela.dailyquote";
pub const SUMMARY_EN : str = "Picks and publishes the daily quote in both languages once a day.";
pub const SCHEDULE : str = "0 6 * * *";
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "code-only";

test basic_constants {
  assert KIND == "cron";
  assert ENABLED == true;
  assert SCHEDULE == "0 6 * * *";
  assert TZ == "Asia/Bangkok";
}
