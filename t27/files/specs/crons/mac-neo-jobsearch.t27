// SPDX-License-Identifier: Apache-2.0
; specs/crons/mac-neo-jobsearch.t27 -- cron launchd/mac/neo-jobsearch
; Source of truth for the job card on t27.ai (#/crons?cron=launchd/mac/neo-jobsearch).
; The schedule was read from ~/Library/LaunchAgents/ai.t27.neo-jobsearch.plist on 2026-10-04.
; A launchd job runs on the owner's Mac: the Queen serves this card tick-only and never dispatches it.
; A cron CONTROLS skills: RUNS names the skill IDs it launches. It is empty
; unless the source evidently invokes one -- nothing here is inferred from a name.
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_mac_neo_jobsearch;

pub const KIND : str = "cron";
pub const ID : str = "launchd/mac/neo-jobsearch";
pub const NAME : str = "Neo job-search sweep";
pub const HOST : str = "launchd";
pub const REPO : str = "mac";
pub const SERVICE : str = "ai.t27.neo-jobsearch";
pub const SUMMARY_EN : str = "Runs the job-search sweep through BrowserOS neo every 30 minutes.";
pub const INTERVAL_MS : u32 = 1800000;
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "code-only";

test mac_neo_jobsearch_test {
    assert KIND == "cron";
    assert ENABLED == true;
    assert INTERVAL_MS >= 1000000;
    assert HOST == "launchd";
}
