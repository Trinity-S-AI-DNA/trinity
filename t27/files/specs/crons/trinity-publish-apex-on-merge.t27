// SPDX-License-Identifier: Apache-2.0
; specs/crons/trinity-publish-apex-on-merge.t27 -- cron github-actions/trinity/publish-apex-on-merge
; Source of truth for the job card on t27.ai (#/crons?cron=github-actions/trinity/publish-apex-on-merge).
; The schedule lands in trinity:.github/workflows/publish-apex-on-merge.yml beside its push
; and workflow_dispatch triggers; the workflow file documents why the hourly run exists:
; the publisher is the only door to t27.ai, it publishes only when the bytes changed, and a
; broken verify gate (2026-10-25 to 2026-10-26, trinity#1761) went unnoticed for a day
; because nothing retried it -- the push-only door never fired again on a healed main.
; The workflow's own header records the same intent: it was meant to run every 15 minutes
; and GitHub scheduled-workflow capacity, not this card, sets the real period.
; A cron CONTROLS skills: RUNS names the skill IDs it launches. It is empty
; unless the source evidently invokes one -- nothing here is inferred from a name.
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_trinity_publish_apex_on_merge;

pub const KIND : str = "cron";
pub const ID : str = "github-actions/trinity/publish-apex-on-merge";
pub const NAME : str = "Publish the apex on merge";
pub const HOST : str = "github-actions";
pub const REPO : str = "trinity";
pub const SERVICE : str = ".github/workflows/publish-apex-on-merge.yml";
pub const SUMMARY_EN : str = "Asks t27.ai's publisher to build trinity main and publish it now; the publisher itself stops when the built bytes match what the domain serves, so an hourly run is a self-healing retry that costs nothing when the site is fresh.";
pub const SCHEDULE : str = "37 * * * *";
pub const TZ : str = "UTC";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const NOTE : str = "Born 2026-10-26 (trinity#1761): the publisher failed its verify gate for a day and nothing retried it. The hourly run is the backstop the workflow header always promised; merge-triggered dispatch stays the fast door.";
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "github-actions-dispatch";

test id_is_host_repo_and_slug {
    assert HOST == "github-actions";
    assert ID == HOST + "/" + REPO + "/publish-apex-on-merge";
}
test vocabularies_and_the_control_link {
    assert KIND == "cron";
    assert ENABLED == true;
    assert TZ == "UTC";
    assert ON_FAILURE == "log";
    assert CONTROL == "github-actions-dispatch";
    assert RUNS.len == 0 and RUNS_NOTE != "";
}
test schedule_is_hourly_at_minute_37 {
    assert SCHEDULE == "37 * * * *";
}
test the_workflow_file_is_the_slug {
    assert SERVICE == ".github/workflows/publish-apex-on-merge.yml";
}
