// SPDX-License-Identifier: Apache-2.0
; specs/crons/mac-mcp-hub.t27 -- cron launchd/mcp-hub/mcp-hub
; Source of truth for the job card on t27.ai (#/crons?cron=launchd/mcp-hub/mcp-hub).
; The schedule was read from ~/Library/LaunchAgents/ai.t27.mcp-hub.plist on 2026-10-04.
; A launchd job runs on the owner's Mac: the Queen serves this card tick-only and never dispatches it.
; A cron CONTROLS skills: RUNS names the skill IDs it launches. It is empty
; unless the source evidently invokes one -- nothing here is inferred from a name.
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_mac_mcp_hub;

pub const KIND : str = "cron";
pub const ID : str = "launchd/mcp-hub/mcp-hub";
pub const NAME : str = "MCP hub";
pub const HOST : str = "launchd";
pub const REPO : str = "mcp-hub";
pub const SERVICE : str = "ai.t27.mcp-hub";
pub const SUMMARY_EN : str = "Serves the aggregated MCP hub that knows every MCP server on the Mac, whether it answers, and its tools.";
pub const SCHEDULE : str = "";
pub const SCHEDULE_NOTE : str = "KeepAlive daemon (launchd restarts it); it has no schedule";
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "code-only";

test mac_mcp_hub_test {
    assert KIND == "cron";
    assert ENABLED == true;
    assert HOST == "launchd";
    assert CONTROL == "code-only";
}
