// SPDX-License-Identifier: Apache-2.0
; specs/crons/mac-reviewer-bees.t27 -- cron launchd/t27/reviewer-bees
; Source of truth for the job card on t27.ai (#/crons?cron=launchd/t27/reviewer-bees).
; The schedule was read from ~/Library/LaunchAgents/ai.t27.reviewer-bees.plist on 2026-10-04.
; A launchd job runs on the owner's Mac: the Queen serves this card tick-only and never dispatches it.
; A cron CONTROLS skills: RUNS names the skill IDs it launches. It is empty
; unless the source evidently invokes one -- nothing here is inferred from a name.
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_mac_reviewer_bees;

pub const KIND : str = "cron";
pub const ID : str = "launchd/t27/reviewer-bees";
pub const NAME : str = "Reviewer bee";
pub const HOST : str = "launchd";
pub const REPO : str = "t27";
pub const SERVICE : str = "ai.t27.reviewer-bees";
pub const SUMMARY_EN : str = "Reviews open bee pull requests every ten minutes, then approves and labels them as t27-bees[bot].";
pub const INTERVAL_MS : u32 = 600000;
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "code-only";

test mac_reviewer_bees_test {
    assert KIND == "cron";
    assert ENABLED == true;
    assert INTERVAL_MS >= 500000;
    assert HOST == "launchd";
}
