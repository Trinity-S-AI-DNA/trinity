; specs/crons/trinity-main-red-watch.t27 -- cron github-actions/trinity/main-red-watch
; Source of truth for the job card on t27.ai (#/crons?cron=github-actions/trinity/main-red-watch).
; THE RULES LIVE HERE; the workflow is the thin host. Two rules, both born from the
; same silence: the docs-check gate failed every docs-touching pull request from
; 2026-10-24 to 2026-10-26 and nothing noticed, because its paths filter kept it
; off main and its red runs lived on PR branches (trinity#1761's class of failure,
; swept in trinity#1766 but invisible for two days).
; RULE 1: a workflow whose newest run on main concluded failure is a finding.
; RULE 2: a workflow whose newest pull_request run concluded failure more than
;         24 hours ago is a finding -- the stale PR-branch red that paths-filtered
;         gates produce and nobody re-tests.
; RULE 3 (2026-10-27): the site's freshness. t27.ai's Last-Modified header older
;         than 48 hours, or the apex publisher's newest run (.github/workflows/
;         publish-website.yml in gHashTag/ghashtag.github.io, anonymous public
;         API) concluded failure, is a finding: one daily issue holds the whole
;         health picture -- red gates, stale gates, stale site, red publisher.
; A clean day prints one line and touches nobody; a finding opens one issue that
; names the workflow and its run. The workflow lands in trinity as
; .github/workflows/main-red-watch.yml beside this card, in the POST_DIR precedent
; of pr-blog-report.yml (read the rules from the card, keep no logic of your own);
; this card lands only together with that workflow -- the registry honesty rule.
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_trinity_main_red_watch;

pub const KIND : str = "cron";
pub const ID : str = "github-actions/trinity/main-red-watch";
pub const NAME : str = "Main red watch";
pub const HOST : str = "github-actions";
pub const REPO : str = "trinity";
pub const SERVICE : str = ".github/workflows/main-red-watch.yml";
pub const SUMMARY_EN : str = "Asks every workflow where its newest run stands: a failure newest on main, or a pull-request failure older than a day, becomes one issue naming the workflow and its run; a clean day logs one line and touches nobody.";
pub const SCHEDULE : str = "47 5 * * *";
pub const TZ : str = "UTC";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const NOTE : str = "Born 2026-10-27: docs-check sat red on every docs-touching PR for two days (2026-10-24..26) behind a paths filter that kept it off main; the sweep that fixed it is trinity#1766. Daily at 05:47 UTC -- enough to catch a day of silence without burning Actions minutes hourly. RULE 3 joined 2026-10-27 with its trinity workflow in the same hour, so the watch also answers: is the site itself fresh? 2026-10-27, later the same day: findings land in ONE standing Site-health issue (a stable URL, refreshed on clean days too), not a new issue per day -- the tablo.";
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "github-actions-dispatch";

test id_is_host_repo_and_slug {
    assert HOST == "github-actions";
    assert ID == HOST + "/" + REPO + "/main-red-watch";
}
test vocabularies_and_the_control_link {
    assert KIND == "cron";
    assert ENABLED == true;
    assert TZ == "UTC";
    assert ON_FAILURE == "log";
    assert CONTROL == "github-actions-dispatch";
    assert RUNS.len == 0 and RUNS_NOTE != "";
}
test schedule_is_daily_at_0547_utc {
    assert SCHEDULE == "47 5 * * *";
}
test the_workflow_file_is_the_slug {
    assert SERVICE == ".github/workflows/main-red-watch.yml";
}
