// SPDX-License-Identifier: Apache-2.0
; specs/crons/mac-alerts-digest.t27 -- cron launchd/mac/alerts-digest
; Source of truth for the job card on t27.ai (#/crons?cron=launchd/mac/alerts-digest).
; The schedule was read from ~/Library/LaunchAgents/ai.t27.alerts-digest.plist on 2026-10-04.
; A launchd job runs on the owner's Mac: the Queen serves this card tick-only and never dispatches it.
; A cron CONTROLS skills: RUNS names the skill IDs it launches. It is empty
; unless the source evidently invokes one -- nothing here is inferred from a name.
; phi^2 + 1/phi^2 = 3 | TRINITY

module cron_mac_alerts_digest;

pub const KIND : str = "cron";
pub const ID : str = "launchd/mac/alerts-digest";
pub const NAME : str = "Alerts digest";
pub const HOST : str = "launchd";
pub const REPO : str = "mac";
pub const SERVICE : str = "ai.t27.alerts-digest";
pub const SUMMARY_EN : str = "Sends the owner a status digest of sweeps, crons and leads over Telegram every three hours.";
pub const INTERVAL_MS : u32 = 10800000;
pub const TZ : str = "Asia/Bangkok";
pub const RUNS : [0]str = [];
pub const RUNS_NOTE : str = "no skill invocation found in source";
pub const ENABLED : bool = true;
pub const ON_FAILURE : str = "log";
pub const CONTROL : str = "code-only";

test basic_constants {
  assert KIND == "cron";
  assert ENABLED == true;
  assert INTERVAL_MS >= 60000;
  assert TZ == "Asia/Bangkok";
}
