// SPDX-License-Identifier: Apache-2.0
; specs/conformance/e2e_scenarios.t27 -- end-to-end scenarios: VSA -> VM -> SDK -> codebook -> verdict
; The full-pipeline verification plan of Phase 4, Quality and Performance (issue #48).
; ASCII only (L3).

; Until this rewrite the file was a Markdown document with a .t27 name, which the parser
; refused at its first line. Its scenarios were Zig test bodies written against the vsa,
; vm and sdk modules of the trinity runtime, which this repository does not define, so
; they are recorded here as data -- stages and thresholds -- and not as tests that could
; run. The tests below check the plan's own arithmetic, and two of them pin defects in it.
; phi^2 + 1/phi^2 = 3 | TRINITY

module e2e_scenarios;

pub const ISSUE : u32 = 48;

pub const SCENARIOS : [6]str = ["VSA create -> VM execute -> SDK verify: two 256-trit random vectors (seeds 42, 84), bound by the VM (v_bind) and by vsa.bind; cosine of the two results > 0.99", "codebook encode -> bind -> decode: a 512-trit codebook encodes cat, sits, mat; each is bound to a random role, the three are bundled, and unbinding the subject role decodes to cat", "associative memory store -> retrieve: two VM-generated vectors (v_random 111, 222) stored as key and value; count is 1 and the retrieved value has similarity > 0.15", "sequence encode -> probe: [apple, banana, cherry] at 512 trits; probing apple scores higher at position 0 than at 1 or 2", "classifier train -> predict: 3 fruit and 2 veggie samples; 2 classes; fruit1 predicts fruit with confidence > 0.3", "HybridBigInt pack -> unpack -> VM execute: a packed 256-trit vector is loaded into v0 and the VM computes self-similarity > 0.99 -- see PACK_SCENARIO_DEFECT"];

; The pack scenario does not test what it is named for. Its program begins
; `v_random dst=0 imm=42`, which overwrites the packed vector in v0 before anything reads
; it, and then takes the cosine of v0 with itself -- 1.0 for any nonzero vector. The check
; passes whether pack and unpack work or not.
pub const PACK_SCENARIO_DEFECT : str = "v_random dst=0 overwrites the packed vector before v_cosine reads v0 against itself";

pub const VSA_DIM_SMALL : u32 = 256;
pub const VSA_DIM : u32 = 512;
pub const BENCH_DIM : u32 = 1024;
pub const BENCH_ITERS : u32 = 1000;
; Every benchmark target is below 1,000,000 ns per op.
pub const BENCH_TARGET_NS : u32 = 1000000;
pub const BENCHES : [5]str = ["bind", "bundle2", "cosineSimilarity", "hammingDistance", "permute"];

pub const THRESHOLD_BIND_AGREEMENT : f64 = 0.99;
pub const THRESHOLD_MEMORY_RETRIEVE : f64 = 0.15;
pub const THRESHOLD_CLASSIFIER_CONFIDENCE : f64 = 0.3;
pub const THRESHOLD_SELF_SIMILARITY : f64 = 0.99;
pub const THRESHOLD_PERF : f64 = 0.9;

; Verdict record: pass, a 0..100 score, and one sub-score per layer.
pub const VERDICT_FIELDS : [7]str = ["pass", "score", "vsa_score", "vm_score", "sdk_score", "memory_score", "perf_score"];

; The document closed its verdict table with `Total verdict: PASS (all scores > 0.9)`.
; Its own rows set 0.15 for associative memory and 0.3 for the classifier, so a run
; meeting every row can hold scores below 0.9 -- the summary is not implied by the rows.
pub const TOTAL_VERDICT_AS_WRITTEN : str = "PASS (all scores > 0.9)";

; Classifier training set.
pub const FRUIT_SAMPLES : u32 = 3;
pub const VEGGIE_SAMPLES : u32 = 2;
pub const CLASSES : u32 = 2;

test "bench_target_is_one_millisecond" {
    assert(BENCH_TARGET_NS == 1000 * 1000);
}

test "dimensions_double" {
    assert(VSA_DIM_SMALL * 2 == VSA_DIM);
    assert(VSA_DIM * 2 == BENCH_DIM);
}

test "classifier_training_set" {
    assert(FRUIT_SAMPLES + VEGGIE_SAMPLES == 5);
    assert(CLASSES == 2);
    assert(FRUIT_SAMPLES > VEGGIE_SAMPLES);
}

test "thresholds_are_probabilities" {
    assert(THRESHOLD_MEMORY_RETRIEVE > 0.0);
    assert(THRESHOLD_BIND_AGREEMENT < 1.0);
    assert(THRESHOLD_SELF_SIMILARITY < 1.0);
}

test "total_verdict_is_not_implied_by_the_rows" {
    // Two row thresholds sit below the 0.9 the summary claims for every score.
    assert(THRESHOLD_MEMORY_RETRIEVE < THRESHOLD_PERF);
    assert(THRESHOLD_CLASSIFIER_CONFIDENCE < THRESHOLD_PERF);
}

test "verdict_has_five_layer_scores" {
    // pass and score, then one per layer: vsa, vm, sdk, memory, perf
    assert(7 - 2 == 5);
}
