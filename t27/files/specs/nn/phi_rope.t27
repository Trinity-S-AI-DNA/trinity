// specs/nn/phi_rope.t27
// φ-RoPE: Rotary Position Embedding using Golden Ratio
// θ_i = PHI^(-2i/d) instead of standard 10000^(-2i/d)

// The original file was a declarative `algorithm phi_rope { ... }` record
// (module / strand_i..iii / complexity / inputs / outputs / notes /
// invariants / tests). t27 has no such block, so each field is kept below as
// a constant or comment, the `notes` pseudocode is written out as the
// functions phi_rope_theta / phi_rope_rotate, and the named invariants and
// the three test records become invariant / test blocks.
module PhiRope;

    // module: brain.prefrontal.rotary_temporal
    pub const PHI_ROPE_MODULE = "brain.prefrontal.rotary_temporal";

    // strand_i
    pub const PHI_IDENTITY = "theta_i = PHI^(-2i/d)";
    pub const NUMERIC_FORMAT = "GF16";
    pub const PHI : f64 = 1.6180339887498948;

    // strand_ii
    pub const BRAIN_REGION = "prefrontal_cortex";
    pub const BIOLOGICAL_ANALOG = "mPFC temporal context encoding";

    // strand_iii
    pub const T27_TARGET = "nn/phi_rope";
    // backends: [rust, zig, c, verilog] (kept as one comma-separated string:
    // a list of strings is not lowerable on every backend)
    pub const BACKENDS = "rust,zig,c,verilog";

    // complexity: O(d)

    // inputs:  [x: Float[seq, dim], position: Int]
    // outputs: [x_rotated: Float[seq, dim]]
    // The [seq, dim] tensors are passed as flat row-major slices of length
    // seq * dim (t27 has no 2-D dynamic tensor type); each row is rotated
    // independently, exactly as the per-row notes below describe.

    // notes:
    //     for i in 0..dim/2:
    //         theta = PHI.pow(-2.0 * i / dim)
    //         angle = position * theta
    //         x_rotated[2i]   = x[2i]*cos(angle) - x[2i+1]*sin(angle)
    //         x_rotated[2i+1] = x[2i]*sin(angle) + x[2i+1]*cos(angle)

    // theta_i = PHI^(-2i/d)
    pub fn phi_rope_theta(i: usize, dim: usize) -> f64 {
        return pow(PHI, -2.0 * (i as f64) / (dim as f64));
    }

    // Rotate every row of x (seq rows of dim values) by position.
    pub fn phi_rope_rotate(x: []const f64, x_rotated: []f64, seq: usize, dim: usize, position: i64) -> void {
        var row : usize = 0;
        while row < seq {
            const base = row * dim;
            var i : usize = 0;
            while i < dim / 2 {
                const theta = phi_rope_theta(i, dim);
                const angle = (position as f64) * theta;
                const a = x[base + 2 * i];
                const b = x[base + 2 * i + 1];
                x_rotated[base + 2 * i]     = a * cos(angle) - b * sin(angle);
                x_rotated[base + 2 * i + 1] = a * sin(angle) + b * cos(angle);
                i = i + 1;
            }
            row = row + 1;
        }
    }

    // invariants: [orthogonality_preserved, phi_decay_monotone]
    // The original only names the two invariants; the bodies below state the
    // property each name refers to (a 2x2 rotation keeps the pair's length;
    // theta decreases as i grows).
    invariant orthogonality_preserved {
        const x : [4]f64 = [1.0, 2.0, 3.0, 4.0];
        var y : [4]f64 = [0.0, 0.0, 0.0, 0.0];
        phi_rope_rotate(x, y, 1, 4, 7);
        var i : usize = 0;
        while i < 2 {
            const before = x[2 * i] * x[2 * i] + x[2 * i + 1] * x[2 * i + 1];
            const after = y[2 * i] * y[2 * i] + y[2 * i + 1] * y[2 * i + 1];
            assert abs(before - after) < 0.000001;
            i = i + 1;
        }
    }

    invariant phi_decay_monotone {
        const dim : usize = 81;
        var i : usize = 0;
        while i + 1 < dim {
            assert phi_rope_theta(i + 1, dim) < phi_rope_theta(i, dim);
            i = i + 1;
        }
    }

    // tests:
    //     { input: pos=0, assert: x_rotated == x }
    //     { input: dim=81, assert: theta[0] == 1.0 }
    //     { input: dim=4, theta: [1.0, 0.886, 0.618, 0.486] }

    // pos=0 -> x_rotated == x (the original gives no x; any vector will do)
    test phi_rope_position_zero_is_identity {
        const x : [4]f64 = [1.0, 2.0, 3.0, 4.0];
        var y : [4]f64 = [0.0, 0.0, 0.0, 0.0];
        phi_rope_rotate(x, y, 1, 4, 0);
        var i : usize = 0;
        while i < 4 {
            assert y[i] == x[i];
            i = i + 1;
        }
    }

    // dim=81 -> theta[0] == 1.0
    test phi_rope_theta0_is_one {
        assert phi_rope_theta(0, 81) == 1.0;
    }

    // dim=4 -> theta: [1.0, 0.886, 0.618, 0.486]
    // NOTE (review): the table is kept verbatim, but by the formula above
    // theta[1] = PHI^(-1/2) = 0.786, not 0.886, so this assertion fails
    // until the table (or the formula) is corrected by the spec owner.
    test phi_rope_theta_dim4 {
        const expected : [4]f64 = [1.0, 0.886, 0.618, 0.486];
        var i : usize = 0;
        while i < 4 {
            assert abs(phi_rope_theta(i, 4) - expected[i]) < 0.001;
            i = i + 1;
        }
    }
