// specs/nn/sacred_attention.t27
// Sacred Attention: Multi-head attention with φ-based scaling
// scale = head_dim^(-PHI^3) instead of standard 1/sqrt(head_dim)

// The original file was a declarative `algorithm sacred_attention { ... }`
// record (module / strand_i..iii / complexity / inputs / outputs / depends /
// notes / invariants / tests). t27 has no such block, so each field is kept
// below as a constant or comment (the translation also used for
// specs/nn/phi_rope.t27). The tests call sacred_scale(), which the record
// never defined; it is written out here from the record's own phi_identity,
// scale = head_dim^(-PHI^3), read the way specs/nn/attention.t27 reads the
// same notation (see the note at sacred_scale). The two named invariants and
// the two test records become invariant / test blocks. The `notes` pseudocode (the
// attention forward pass) is kept as a comment: the record gives no Wq / Wk /
// Wv / Wo and no head split, so writing it as a function would invent them.
module sacred_attention;

    // module: brain.prefrontal.parallel_attention
    pub const SACRED_ATTENTION_MODULE = "brain.prefrontal.parallel_attention";

    // strand_i
    pub const PHI_IDENTITY = "scale = head_dim^(-PHI^3)";
    pub const N_HEADS : usize = 3;
    pub const HEAD_DIM : usize = 81;
    pub const EMBED_DIM : usize = 243;
    pub const NUMERIC_FORMAT = "GF16";
    pub const PHI : f64 = 1.6180339887498948;

    // strand_ii
    pub const BRAIN_REGION = "prefrontal_cortex";
    pub const BIOLOGICAL_ANALOG = "dlPFC parallel attention streams";

    // strand_iii
    pub const T27_TARGET = "nn/sacred_attention";
    // backends: [rust, zig, c, verilog] (kept as one comma-separated string:
    // a list of strings is not lowerable on every backend)
    pub const BACKENDS = "rust,zig,c,verilog";

    // complexity: O(n^2 * d)

    // inputs:  [x: Float[B, seq, 243]]
    // outputs: [out: Float[B, seq, 243]]

    // depends: [phi_rope]
    pub const DEPENDS = "phi_rope";

    // notes:
    //     scale = head_dim^(-PHI^3)
    //     Q,K,V = x @ Wq, x @ Wk, x @ Wv
    //     scores = (Q @ K^T) * scale
    //     attn   = softmax(scores)
    //     out    = (attn @ V) @ Wo

    // scale = head_dim^(-PHI^3)
    // NOTE (review): the notation is read as in specs/nn/attention.t27, which
    // writes "d_k^(-phi^3)" but computes SACRED_SCALE = pow(81.0, -SACRED_GAMMA)
    // with SACRED_GAMMA = PHI_CUBED_INV = phi^-3 (test
    // attn_sacred_scaling_constant: pow(81.0, -0.2360679); scale in (0.3, 0.4)).
    // So the exponent is -(1 / PHI^3): 81^(-0.236068) ~= 0.3544, compared with
    // the standard 1/sqrt(81) ~= 0.111. The literal exponent -(PHI^3) would give
    // 81^(-4.236068) ~= 8.2e-9, which makes softmax almost uniform.
    pub fn sacred_scale() -> f64 {
        return pow(HEAD_DIM as f64, -1.0 / (PHI * PHI * PHI));
    }

    // invariants: [scale_in_0_1, n_heads_times_head_dim_eq_embed_dim]
    // The original only names the two invariants; each body states the
    // property its name spells out.
    invariant scale_in_0_1 {
        assert sacred_scale() > 0.0;
        assert sacred_scale() < 1.0;
    }

    invariant n_heads_times_head_dim_eq_embed_dim {
        assert N_HEADS * HEAD_DIM == EMBED_DIM;
    }

    // tests:
    //     { assert: N_HEADS * HEAD_DIM == EMBED_DIM }
    //     { assert: sacred_scale() > 0.0 && sacred_scale() < 1.0 }

    test sacred_attention_heads_cover_embed_dim {
        assert N_HEADS * HEAD_DIM == EMBED_DIM;
    }

    test sacred_attention_scale_in_unit_interval {
        assert sacred_scale() > 0.0 && sacred_scale() < 1.0;
    }
