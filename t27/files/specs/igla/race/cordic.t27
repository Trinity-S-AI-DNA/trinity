fn cordic_sin_cos(angle: f32, iterations: u8) -> ([]f32, []f32) {
    let gain = cordic_gain(iterations);
    let (x, y) = cordic_inner(gain, 0.0, angle, 0, iterations);
    return ([y], [x]);
}

invariant cordic_pow2_neg_entry_bounded:
    forall i : u8
    i < 16 ==> pow2_neg_entry(i) > 0.0 && pow2_neg_entry(i) <= 1.0

invariant cordic_gain_bounded
    forall iters : u8
    iters >= 2 && iters <= 16 ==>
    cordic_gain(iters) > 0.6 && cordic_gain(iters) < 0.65

invariant cordic_gain_positive:
    forall n : u8
    n >= 2 && n <= 16 ==> cordic_gain(n) > 0.5 && cordic_gain(n) < 0.7