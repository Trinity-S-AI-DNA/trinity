test bram_weights_read_weight_oob
    given bank = WeightBank { depth: 2, width: 2, data: [1, 2, 3, 4] }
    given addr = WeightAddr { row: 5, col: 5 }
    when v = read_weight(bank, addr)
    then v == 0

test bram_weights_write_weight_oob_unchanged
    given bank = WeightBank { depth: 2, width: 2, data: [1, 2, 3, 4] }
    given addr = WeightAddr { row: 5, col: 5 }
    when new_bank = write_weight(bank, addr, 99)
