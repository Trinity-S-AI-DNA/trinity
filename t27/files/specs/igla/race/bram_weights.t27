    when row = load_row(bank, 1, 0)
    then len(row) == 2 && row[0] == 30 && row[1] == 40

test bram_weights_write_weight_zero
    given bank = WeightBank { depth: 2, width: 2, data: [1, 2, 3, 4] }
    given addr = WeightAddr { row: 0, col: 0 }
    when new_bank = write_weight(bank, addr, 0)
