test ternary_gemm_2x2_large_activations_2
    given a = [127, -128, 64, -64]
    given w = [TernaryWeight { code: 1 }, TernaryWeight { code: 2 }, TernaryWeight { code: 0 }, TernaryWeight { code: 1 }]
    when out = ternary_gemm_2x2(a, w)
    then out[0] == 63 && out[1] == -64 && out[2] == 0 && out[3] == -128

