test ternary_gemm_2x2_large_activations
    given a = [127, -128, 127, -128]
    given w = [TernaryWeight { code: 1 }, TernaryWeight { code: 2 }, TernaryWeight { code: 2 }, TernaryWeight { code: 1 }]
    when out = ternary_gemm_2x2(a, w)
