test ternary_dot_offset_seed
    given a = [1, 2, 3]
    given w = [TernaryWeight { code: 1 }, TernaryWeight { code: 1 }, TernaryWeight { code: 1 }]
    when d = ternary_dot(a, w, 1, 10)
    then d == 15

