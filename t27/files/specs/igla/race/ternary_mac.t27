    given a = []i8{}
    given w = []TernaryWeight{}
    given idx = 0
    given acc = 7
    when d = ternary_dot(a, w, idx, acc)
    then d == 7

invariant ternary_dot_two_elements_sum_inv:
    forall a1 : i8, a2 : i8
    ternary_dot([a1, a2], [TernaryWeight { code: 1 }, TernaryWeight { code: 1 }], 0, 0) == a1 + a2

invariant ternary_dot_empty_vectors_identity_inv:
    forall acc : i16
    ternary_dot([]i8{}, []TernaryWeight{}, 0, acc) == acc

