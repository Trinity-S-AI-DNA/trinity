    given w = TernaryWeight { code: 1 }
    when r = ternary_mac(acc, a, w)
    then r == -5

test ternary_dot_negative_activation
    given a = [cast_i8(-3), cast_i8(4)]
    given w = [TernaryWeight { code: 1 }, TernaryWeight { code: 2 }]
    given idx = 0
    given acc = 0
    when d = ternary_dot(a, w, idx, acc)
    then d == -7

invariant ternary_dot_single_element_identity
    forall a : i8
    ternary_dot([a], [TernaryWeight { code: 1 }], 0, 0) == a

invariant ternary_mul_negative_weight_identity
    forall a : i8
    ternary_mul(a, TernaryWeight { code: 2 }) == -a

