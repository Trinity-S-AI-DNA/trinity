bench ternary_mac_latency
    given acc = 0
    given a = 7
    given w = TernaryWeight { code: 1 }
    measure ternary_mac(acc, a, w)
    target latency_us < 0.1

bench ternary_dot_latency
    given a = [1, 2, 3, 4, 5, 6, 7, 8]
    given w = [TernaryWeight { code: 1 }, TernaryWeight { code: 1 }, TernaryWeight { code: 1 }, TernaryWeight { code: 1 }, TernaryWeight { code: 1 }, TernaryWeight { code: 1 }, TernaryWeight { code: 1 }, TernaryWeight { code: 1 }]
    measure ternary_dot(a, w, 0, 0)
    target latency_us < 1.0

