invariant yosys_const_positive:
    assert 1 > 0

invariant sva_clock_present_native
    forall props : []Property
    props.len() == 0 || props[0].clk.len() > 0

invariant yosys_coverage_nonnegative
    forall report : CoverageReport
    report.coverage_percent >= 0.0 && report.coverage_percent <= 100.0

invariant strings_equal_reflexive
    forall s : string
    strings_equal(s, s) == true

fn inv_sva_clock_present_inner(props: []Property, idx: u32) -> bool {
    if (idx >= props.len()) {
        return true;
    }
    if (props[idx].clk.len() == 0) {
        return false;
    }
    return inv_sva_clock_present_inner(props, idx + 1);
}

#[invariant]
fn inv_sva_clock_present(props: []Property) {
    assert(inv_sva_clock_present_inner(props, 0), "every property needs a clock");
}

