    given weights = [TernaryWeight { code: 1 }, TernaryWeight { code: 0 }, TernaryWeight { code: 2 }]
    given size = 3
    when result = systolic_ternary_array(activations, weights, size)
    then result.len() == 3 && result[0] == 1 && result[1] == 0 && result[2] == -3

