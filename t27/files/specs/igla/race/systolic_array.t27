    given a = 7
    when p = booth_mul_u32(0, a)
    then p == 0

test systolic_step_identity_A_passes_activation
    given a = 5
    given w = [TernaryWeight { code: 1 }, TernaryWeight { code: 0 }]
    given psum = [10i16, 0]
    when (a_out, psum_out) = systolic_step_identity_A(a, w, psum)
    then a_out == 5

invariant systolic_step_identity_A_passes_activation_inv:
    forall a : i8, w : []TernaryWeight, psum : []i16
    w.len() > 0 ==>
    systolic_step_identity_A(a, w, psum).0 == a

