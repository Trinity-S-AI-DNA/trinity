    given rst_n = true
    given angle = 1.0
    given valid_in = false
    when (s, c, r) = cordic_top(clk, rst_n, angle, valid_in)
    then r == false

test cordic_top_large_angle
    given clk = true
    given rst_n = true
    given angle = 6.28
    given valid_in = true
    when (s, c, r) = cordic_top(clk, rst_n, angle, valid_in)
    then s > -500 && s < 500 && r == true

test cordic_top_rst_n_false_resets
