    given pos = [
        ProofObligation { category: 0, description: "p1", module_name: "m", line_start: 0, line_end: 0, status: ProofStatus::proved },
        ProofObligation { category: 0, description: "p2", module_name: "m", line_start: 1, line_end: 1, status: ProofStatus::proved }
