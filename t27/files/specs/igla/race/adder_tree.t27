    given a = 1
    given b = -1
    given c = 2
    given d = -2
    when sum = adder_tree_4(a, b, c, d)
    then sum == 0

// ============================================================================
// 4. Invariants
// ============================================================================

        invariant adder_tree_width_positive: forall a : AdderTree, a.width > 0
invariant adder_tree_8_commutative
    forall a : i32, b : i32, c : i32, d : i32, e : i32, f : i32, g : i32, h : i32
    let v = Vec8 { v0: a, v1: b, v2: c, v3: d, v4: e, v5: f, v6: g, v7: h }
    adder_tree_8(v) == a + b + c + d + e + f + g + h

invariant adder_tree_4_commutative
    forall a : i32, b : i32, c : i32, d : i32
    adder_tree_4(a, b, c, d) == a + b + c + d

// ============================================================================
// 5. Benchmarks
// ============================================================================

invariant trinity_phi_identity:
    assert 1.618 * 1.618 + 1.0 / (1.618 * 1.618) > 2.99 && 1.618 * 1.618 + 1.0 / (1.618 * 1.618) < 3.01

invariant adder_tree_2_commutative
    forall a : i32, b : i32
    adder_tree_2(a, b) == adder_tree_2(b, a)

bench adder_tree_8_latency
    given v = Vec8 { v0: 1, v1: 2, v2: 3, v3: 4, v4: 5, v5: 6, v6: 7, v7: 8 }
    measure adder_tree_8(v)
    target latency_us < 1.0

bench adder_tree_4_latency
    given a = 3
    given b = 7
    given c = 2
    given d = 8
    measure adder_tree_4(a, b, c, d)
    target latency_us < 0.5

bench adder_tree_2_latency
    given a = 10
    given b = 20
    measure a + b
    target latency_us < 0.3

