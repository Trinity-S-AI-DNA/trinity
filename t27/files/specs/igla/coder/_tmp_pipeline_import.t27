test pipeline_select_best_candidate_highest_score
    given candidates = [BeamCandidate { token: 1, score: 0.5, prefix_len: 1 }, BeamCandidate { token: 2, score: 0.9, prefix_len: 1 }, BeamCandidate { token: 3, score: 0.7, prefix_len: 1 }]
    when best = select_best_candidate(candidates)
    then best.token == 2

test pipeline_generate_tokens_recursive_empty_logits
