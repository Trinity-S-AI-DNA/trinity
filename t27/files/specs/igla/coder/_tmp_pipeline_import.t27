    when tokens = generate_tokens_recursive(logits, cfg, 5)
    then tokens.len() == 0

invariant pipeline_select_best_candidate_max_score_inv:
    forall c1 : BeamCandidate, c2 : BeamCandidate, c3 : BeamCandidate
    c1.score >= 0.0 && c2.score >= 0.0 && c3.score >= 0.0
    && c2.score > c1.score
    && c2.score > c3.score ==>
    select_best_candidate([c1, c2, c3]).token == c2.token

