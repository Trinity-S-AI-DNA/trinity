// Was: for all results : []BenchmarkResult, results.len() == 0 ==> count_passed(results, 0, 0) == 0.
// Only the empty slice satisfies the premise, so checking it is exhaustive, not a sample.
invariant benchmark_count_passed_empty_zero_inv:
