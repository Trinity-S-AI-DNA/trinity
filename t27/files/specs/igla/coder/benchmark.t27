        BenchmarkResult { task_id: "t2", generated: "", passed: true, passed_at_5: true, passed_at_10: true, sacred_ok: true, synth_ok: true, ngram_score: 1.0 }
    ]
    when report = compute_aggregate_report(results)
    then report.pass_at_1 == 1.0 && report.pass_at_5 == 1.0 && report.pass_at_10 == 1.0 && report.sacred_rate == 1.0 && report.avg_ngram == 1.0

test compute_aggregate_report_mixed
