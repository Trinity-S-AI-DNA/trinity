/// dataset_scale_competitor_comparison(trinity_size, competitor_size) -> f32
/// Returns the ratio of Trinity dataset size to competitor dataset size.
/// 1.0 = parity. <1.0 = Trinity is smaller. >1.0 = Trinity is larger.
pub fn dataset_scale_competitor_comparison(trinity_size: u32, competitor_size: u32) -> f32 {
    if (competitor_size == 0) { return 0.0; }
    return trinity_size as f32 / competitor_size as f32;
}

