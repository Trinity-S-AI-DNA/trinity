    then n == 2

test benchmark_count_passed_single_failed
    given results = [BenchmarkResult { passed: true, passed_at_5: true, passed_at_10: true, module_name: "m1" }, BenchmarkResult { passed: false, passed_at_5: false, passed_at_10: false, module_name: "m2" }]
    when n = count_passed(results, 0, 0)
    then n == 1

test benchmark_count_passed_at_5_empty_zero
