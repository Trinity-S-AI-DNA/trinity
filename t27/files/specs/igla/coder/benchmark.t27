    when ok = evaluate_task_at_k(bank, task, k)
    then ok == true

test sacrebleu_precision_identical
    given candidate = "abc"
    given reference = "abc"
    given n = 1
    when score = sacrebleu_precision(candidate, reference, n)
    then score == 1.0

test sacrebleu_precision_partial
    given candidate = "abx"
    given reference = "abc"
    given n = 1
    when score = sacrebleu_precision(candidate, reference, n)
    then score > 0.5 && score < 1.0

test run_benchmark_suite_empty
