test transformer_layer_with_weights_shape
    given x = [0.1, 0.2, 0.3]
    given bank = WeightBank { depth: 2, width: 2, data: [16384, 8192, 4096, 2048] }
    when y = transformer_layer_with_weights(x, bank)
