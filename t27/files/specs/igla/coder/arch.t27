test embedding_lookup_shape
    given input_ids = [1, 2, 3]
    when emb = embedding_lookup(input_ids, 0)
    then len(emb) == 3

test transformer_layer_preserves_length
    given x = [0.1, 0.2, 0.3]
    when y = transformer_layer(x)
    then len(y) == 3

test lm_head_shape
    given hidden = [0.5]
    when logits = lm_head_from_hidden(hidden, 0)
    then len(logits) == VOCAB_SIZE

test load_scalar_weight_reads_bram
    given bank = WeightBank { depth: 2, width: 2, data: [0, 1000, 2000, 3000] }
    given addr_row = 1
    given addr_col = 1
    when w = load_scalar_weight(bank, addr_row, addr_col)
