test forward_layers_with_weights_identity
    given x = [0.1, 0.2, 0.3]
    given bank = WeightBank { depth: 2, width: 2, data: [16384, 8192, 4096, 2048] }
    when y = forward_layers_with_weights(x, 0, bank)
