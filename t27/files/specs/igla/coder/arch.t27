    then y == 0.0

test arch_sin_approx_zero_is_zero
    given x = 0.0
    when y = sin_approx(x)
    then y == 0.0

invariant compute_head_dim_positive:
    forall cfg : ModelConfig
    cfg.n_heads > 0 ==> compute_head_dim(cfg) > 0

// ============================================================================
// Invariants
// ============================================================================

invariant param_count_ceiling
    forall cfg : ModelConfig
    estimate_param_count(cfg) <= MAX_PARAMS

invariant head_dim_positive
    forall cfg : ModelConfig
    cfg.d_model / cfg.n_heads > 0

invariant infer_forward_pass_logits_len
    forall ids : []u32, bank : WeightBank
    infer_forward_pass(ids, bank).logits.len() == VOCAB_SIZE

invariant stochastic_sampling_bounded
    forall logits : []f32, k : u32, temp : f32, p : f32
    len(logits) > 0 && k > 0
    generate_next_token_stochastic(logits, k, temp, p) < len(logits)

invariant arch_sqrt_approx_nonnegative:
    forall x : f32, x >= 0.0
    sqrt_approx(x) >= 0.0

