    when accepted = verify_accept(draft_logits, target_logits)
    then accepted == true

test verify_accept_mismatch
    given draft_logits = [0.1, 0.9, 0.3]
    given target_logits = [0.8, 0.1, 0.3]
    when accepted = verify_accept(draft_logits, target_logits)
    then accepted == false

test speculative_decode_step_returns_token
    given input_ids = [1]
    given draft_cfg = DraftModelConfig { d_model: 4, n_layers: 2, temperature: 1.0 }
    when token = speculative_decode_step(input_ids, draft_cfg)
    then token <= VOCAB_SIZE

test load_draft_weights_shape
    given bank = WeightBank { depth: 2, width: 2, data: [32768, 16384, 8192, 4096] }
    when draft_cfg = load_draft_weights(bank)
    then draft_cfg.d_model == 1

