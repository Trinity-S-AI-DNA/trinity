; The skill body lives in gHashTag/t27 at .claude/skills/tri-pipeline/SKILL.md
; (vendored copy: apps/website/public/skills/files/t27/tri-pipeline/SKILL.md, sha256 b4bfc290b86a...).
; The JSON the site serves is generated from this file by the real compiler;
; nothing below is parsed with a regex.
; phi^2 + 1/phi^2 = 3 | TRINITY

module skill_t27_tri_pipeline;

pub const KIND : str = "skill";
pub const ID : str = "t27/tri-pipeline";
pub const NAME : str = "TRI Pipeline";
pub const REPO : str = "t27";
pub const SOURCE : str = "SKILL.md";
pub const SUMMARY_EN : str = "Execute tri commands (gen, test, verify, seal, verdict) for spec-first development";
; The frontmatter name is a display title, not a slash command, so no invocation is declared.
pub const COMMAND : str = "";
; Specs this skill stands on, as declared (frontmatter or the site's bindings.json).
pub const SPECS : [1]str = ["specs/pipeline/e2e_test.t27"];
pub const TAGS : [3]str = ["tri", "pipeline", "verify"];
pub const ENABLED : bool = true;
; Default budget; SKILL.md declares no timeout of its own.
pub const TIMEOUT_MIN : u16 = 30;

test basic_constants {
    assert KIND == "skill";
    assert ID == "t27/tri-pipeline";
    assert NAME == "TRI Pipeline";
    assert REPO == "t27";
    assert ENABLED == true;
    assert TIMEOUT_MIN == 30;
    assert TAGS[0] == "tri";
    assert TAGS[1] == "pipeline";
    assert TAGS[2] == "verify";
    assert SPECS.len == 1;
    assert SPECS[0] == "specs/pipeline/e2e_test.t27";
}
