pub const SUMMARY_EN : str = "Execute 9-phase spec-first development workflow (Issue → Spec → TDD → Code → Gen → Seal → Verify → Land → Learn)";
; The frontmatter name is a display title, not a slash command, so no invocation is declared.
pub const COMMAND : str = "";
; No spec is declared for this skill yet; the Skill Explorer lists it as unbound.
pub const SPECS : [0]str = [];
pub const TAGS : [3]str = ["workflow", "spec-first", "tdd"];
pub const ENABLED : bool = true;
; Default budget; SKILL.md declares no timeout of its own.
pub const TIMEOUT_MIN : u16 = 30;

test basic_constants {
    assert KIND == "skill";
    assert ID == "t27/phi-loop";
    assert NAME == "PHI LOOP";
    assert REPO == "t27";
    assert ENABLED == true;
    assert TIMEOUT_MIN == 30;
    assert TAGS[0] == "workflow";
    assert TAGS[1] == "spec-first";
    assert TAGS[2] == "tdd";
    assert SPECS.len == 0;
}
