; The skill file declares no invocation; the Queen's scheduler fires
; skill/t27/providers-steward.run via the Inngest app t27-queen.
pub const COMMAND : str = "";
; The rung the card keeps true, as repo-root paths.
pub const SPECS : [9]str = ["specs/providers/catalog.t27", "specs/providers/tri_gnk_pair.t27", "specs/providers/gonka/deepseek-v4-flash-0731.t27", "specs/providers/gonka/glm-5-2-fp8.t27", "specs/providers/gonka/glm-5-3-flash.t27", "specs/providers/gonka/kimi-k2-6.t27", "specs/providers/gonka/minimax-m2-7.t27", "specs/providers/trinet/fpga-xc7a200t.t27", "specs/providers/trinet/gpu-consumer-24gb.t27"];
