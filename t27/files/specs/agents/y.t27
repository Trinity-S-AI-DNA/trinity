; Tool IDs (specs/tools) the agent holds. Bound only where a source line names the command
; for this letter; TOOLS_NOTE cites that line or says why the list is empty.
pub const TOOLS : [7]str = ["gHashTag/trinity:tri/govern", "gHashTag/trinity:tri/hardware", "gHashTag/trinity:tri/identity", "gHashTag/trinity:tri/mesh", "gHashTag/trinity:tri/reputation", "gHashTag/trinity:tri/wallet", "tri/serve"];
