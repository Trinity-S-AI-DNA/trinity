; alphabet layer: Archetypal (A-I), Spiritual (J-R), Physical (S-27th)
pub const LAYER : str = "Physical";
pub const SUMMARY_EN : str = "Yield / DePIN / Fitness. Yield and DePIN are the evolutionary crossroad.";
