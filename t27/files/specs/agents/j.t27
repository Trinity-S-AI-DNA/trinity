// SPDX-License-Identifier: Apache-2.0
; specs/agents/j.t27 -- agent t27/J, letter J of the 27-agent alphabet
; Source of truth for the agent card on t27.ai (#/agents?agent=t27/J).
; Transcribed from docs/agents/AGENTS_ALPHABET.md (v3.0): the FULL TABLE row and the
; "Agent J - Iota-extended (Jobs)" schema section. The agent is bound to the others by SOUL.md,
; AGENTS.md and the experience log; the JSON the site serves is generated from this
; file by the real compiler, nothing below is parsed with a regex. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module agent_j;

pub const KIND : str = "agent";
pub const ID : str = "t27/J";
pub const LETTER : str = "J";
; position in the alphabet, 1..27 (the 27th letter is Ti, register R26)
pub const ORDINAL : u8 = 10;
pub const LETTER_NAME : str = "Iota-extended";
pub const NAME : str = "Iota-extended (Jobs)";
pub const DOMAIN : str = "Jobs / Task Routing";
pub const ARCHETYPE : str = "Hand with grip - dispatcher";
; Coptic register from the schema section (the ISA register the agent is bound to)
pub const REGISTER : str = "R9";
; alphabet layer: Archetypal (A-I), Spiritual (J-R), Physical (S-27th)
pub const LAYER : str = "Spiritual";
pub const SUMMARY_EN : str = "Jobs / Task Routing. Jobs grab tasks and route them.";
; The three documents that bind every agent, as repo-root paths in gHashTag/t27.
pub const SOUL : str = "SOUL.md";
pub const AGENTS_DOC : str = "AGENTS.md";
pub const ALPHABET : str = "docs/agents/AGENTS_ALPHABET.md";
; Key files as the alphabet lists them (paths and globs relative to the t27 root).
pub const KEY_FILES : [1]str = ["src/tri/dev_commands.zig"];
pub const ENTRY_INVARIANT : str = "Task queue exists, scheduler is running";
pub const EXIT_INVARIANT : str = "No stuck jobs > 1 hour, all jobs assigned";
; The alphabet lists no CLARA role for this agent ("-").
pub const CLARA_ROLE : str = "";
; Skill IDs the agent holds. Bound only where a source names the skill; SKILLS_NOTE
; cites that source or says why the list is empty.
pub const SKILLS : [4]str = ["t27/wave-audit", "trinity/board-sync", "trinity/tech-tree", "trinity/ux-wave"];
pub const SKILLS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\", rule 2: domain lead for 4 skill card(s).";
; Tool IDs (specs/tools) the agent holds. Bound only where a source line names the command
; for this letter; TOOLS_NOTE cites that line or says why the list is empty.
pub const TOOLS : [4]str = ["gHashTag/trinity:tri/swarm", "mcp/inngest-dev", "tri/loop", "tri/topic"];
pub const TOOLS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\", rule 2: domain lead for 4 tool card(s), read off what each card states it does rather than off its name.";
; Where the agent logs episodes (AGENTS_ALPHABET.md: "Logs to .trinity/experience/").
pub const EXPERIENCE_LOG : str = ".trinity/experience/";
pub const ENABLED : bool = true;

test test_agent_j_constants {
  assert KIND == "agent";
  assert ID == "t27/J";
  assert LETTER == "J";
  assert ORDINAL == 10;
  assert LETTER_NAME == "Iota-extended";
  assert NAME == "Iota-extended (Jobs)";
  assert DOMAIN == "Jobs / Task Routing";
  assert ARCHETYPE == "Hand with grip - dispatcher";
  assert REGISTER == "R9";
  assert LAYER == "Spiritual";
  assert ENABLED == true;
}
