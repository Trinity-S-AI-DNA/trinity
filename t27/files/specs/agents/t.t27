  assert KIND == "agent";
  assert ID == "t27/T";
  assert LETTER == "T";
  assert ORDINAL == 20;
  assert LETTER_NAME == "Tau";
  assert NAME == "Tau (TRINITY Queen)";
  assert DOMAIN == "Queen / Lotus Orchestrator";
  assert ARCHETYPE == "CROSS - seal, signature, truth";
  assert REGISTER == "R19";
  assert LAYER == "Physical";
