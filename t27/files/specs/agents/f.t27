// SPDX-License-Identifier: Apache-2.0
; specs/agents/f.t27 -- agent t27/F, letter F of the 27-agent alphabet
; Source of truth for the agent card on t27.ai (#/agents?agent=t27/F).
; Transcribed from docs/agents/AGENTS_ALPHABET.md (v3.0): the FULL TABLE row and the
; "Agent F - Phi (Formal Conformance)" schema section. The agent is bound to the others by SOUL.md,
; AGENTS.md and the experience log; the JSON the site serves is generated from this
; file by the real compiler, nothing below is parsed with a regex. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module agent_f;

pub const KIND : str = "agent";
pub const ID : str = "t27/F";
pub const LETTER : str = "F";
; position in the alphabet, 1..27 (the 27th letter is Ti, register R26)
pub const ORDINAL : u8 = 6;
pub const LETTER_NAME : str = "Phi";
pub const NAME : str = "Phi (Formal Conformance)";
pub const DOMAIN : str = "Formal Conformance";
pub const ARCHETYPE : str = "Nail - connection, binding";
; Coptic register from the schema section (the ISA register the agent is bound to)
pub const REGISTER : str = "R5";
; alphabet layer: Archetypal (A-I), Spiritual (J-R), Physical (S-27th)
pub const LAYER : str = "Archetypal";
pub const SUMMARY_EN : str = "Formal Conformance. The conformance JSON files are the nails holding the specs together.";
; The three documents that bind every agent, as repo-root paths in gHashTag/t27.
pub const SOUL : str = "SOUL.md";
pub const AGENTS_DOC : str = "AGENTS.md";
pub const ALPHABET : str = "docs/agents/AGENTS_ALPHABET.md";
; Key files as the alphabet lists them (paths and globs relative to the t27 root).
pub const KEY_FILES : [2]str = ["t27/conformance/*.json", "conformance/FORMAT-SPEC-001.json"];
pub const ENTRY_INVARIANT : str = "All sacred vectors (G, OmegaLambda, phi) are valid";
pub const EXIT_INVARIANT : str = "Conformance > 95%, all sacred physics verified";
; The alphabet lists no CLARA role for this agent ("-").
pub const CLARA_ROLE : str = "";
; Skill IDs the agent holds. Bound only where a source names the skill; SKILLS_NOTE
; cites that source or says why the list is empty.
pub const SKILLS : [1]str = ["trinity/vsa-verify"];
pub const SKILLS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\", rule 2: domain lead for 1 skill card(s).";
; Tool IDs (specs/tools) the agent holds. Bound only where a source line names the command
; for this letter; TOOLS_NOTE cites that line or says why the list is empty.
pub const TOOLS : [2]str = ["tri/lean", "tri/vectors"];
pub const TOOLS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\", rule 2: domain lead for 2 tool card(s), read off what each card states it does rather than off its name.";
; Where the agent logs episodes (AGENTS_ALPHABET.md: "Logs to .trinity/experience/").
pub const EXPERIENCE_LOG : str = ".trinity/experience/";
pub const ENABLED : bool = true;

test verify_agent_f_constants {
    assert KIND == "agent";
    assert ID == "t27/F";
    assert LETTER == "F";
    assert ORDINAL == 6;
    assert ENABLED == true;
}
