// SPDX-License-Identifier: Apache-2.0
; specs/agents/ti.t27 -- agent t27/TI, letter TI of the 27-agent alphabet
; Source of truth for the agent card on t27.ai (#/agents?agent=t27/TI).
; Transcribed from docs/agents/AGENTS_ALPHABET.md (v3.0): the FULL TABLE row and the
; "Agent 27th - Ti (Security)" schema section. The agent is bound to the others by SOUL.md,
; AGENTS.md and the experience log; the JSON the site serves is generated from this
; file by the real compiler, nothing below is parsed with a regex. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module agent_ti;

pub const KIND : str = "agent";
pub const ID : str = "t27/TI";
pub const LETTER : str = "TI";
; position in the alphabet, 1..27 (the 27th letter is Ti, register R26)
pub const ORDINAL : u8 = 27;
pub const LETTER_NAME : str = "Ti";
pub const NAME : str = "Ti (Security)";
pub const DOMAIN : str = "Security / Reserve";
pub const ARCHETYPE : str = "Egyptian cross - \"sacred gift\"";
; Coptic register from the schema section (the ISA register the agent is bound to)
pub const REGISTER : str = "R26";
; alphabet layer: Archetypal (A-I), Spiritual (J-R), Physical (S-27th)
pub const LAYER : str = "Physical";
pub const SUMMARY_EN : str = "Security / Reserve. Security and AAIF are what Trinity gifts the world; the seat is reserved (key files: future).";
; The three documents that bind every agent, as repo-root paths in gHashTag/t27.
pub const SOUL : str = "SOUL.md";
pub const AGENTS_DOC : str = "AGENTS.md";
pub const ALPHABET : str = "docs/agents/AGENTS_ALPHABET.md";
; The alphabet lists no key files for the reserved 27th seat ("- (future)").
pub const KEY_FILES : [0]str = [];
pub const ENTRY_INVARIANT : str = "Security policy exists";
pub const EXIT_INVARIANT : str = "AAIF compliance ready, no vulnerabilities";
; The alphabet lists no CLARA role for this agent ("-").
pub const CLARA_ROLE : str = "";
; Skill IDs the agent holds. Bound only where a source names the skill; SKILLS_NOTE
; cites that source or says why the list is empty.
pub const SKILLS : [0]str = [];
pub const SKILLS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\": no skill card states this domain as its subject. The Queen holds every skill by rule 1.";
; Tool IDs (specs/tools) the agent holds. Bound only where a source line names the command
; for this letter; TOOLS_NOTE cites that line or says why the list is empty.
pub const TOOLS : [1]str = ["gHashTag/trinity:tri/identity"];
pub const TOOLS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\", rule 2: domain lead for 1 tool card(s), read off what each card states it does rather than off its name.";
; Where the agent logs episodes (AGENTS_ALPHABET.md: "Logs to .trinity/experience/").
pub const EXPERIENCE_LOG : str = ".trinity/experience/";
; Reserved seat: the alphabet marks its key files as future, so the agent is not enabled.
pub const ENABLED : bool = false;

test agent_ti_constants {
  assert KIND == "agent";
  assert ID == "t27/TI";
  assert LETTER == "TI";
  assert ORDINAL == 27;
  assert LETTER_NAME == "Ti";
  assert NAME == "Ti (Security)";
  assert DOMAIN == "Security / Reserve";
  assert ARCHETYPE == "Egyptian cross - \"sacred gift\"";
  assert REGISTER == "R26";
  assert LAYER == "Physical";
  assert ENABLED == false;
  assert CLARA_ROLE == "";
  assert TOOLS[0] == "gHashTag/trinity:tri/identity";
}
