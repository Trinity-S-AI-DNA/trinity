// SPDX-License-Identifier: Apache-2.0
; specs/agents/k.t27 -- agent t27/K, letter K of the 27-agent alphabet
; Source of truth for the agent card on t27.ai (#/agents?agent=t27/K).
; Transcribed from docs/agents/AGENTS_ALPHABET.md (v3.0): the FULL TABLE row and the
; "Agent K - Kappa (Kernel)" schema section. The agent is bound to the others by SOUL.md,
; AGENTS.md and the experience log; the JSON the site serves is generated from this
; file by the real compiler, nothing below is parsed with a regex. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module agent_k;

pub const KIND : str = "agent";
pub const ID : str = "t27/K";
pub const LETTER : str = "K";
; position in the alphabet, 1..27 (the 27th letter is Ti, register R26)
pub const ORDINAL : u8 = 11;
pub const LETTER_NAME : str = "Kappa";
pub const NAME : str = "Kappa (Kernel)";
pub const DOMAIN : str = "Kernel / FPGA MAC";
pub const ARCHETYPE : str = "Palm - open hand";
; Coptic register from the schema section (the ISA register the agent is bound to)
pub const REGISTER : str = "R10";
; alphabet layer: Archetypal (A-I), Spiritual (J-R), Physical (S-27th)
pub const LAYER : str = "Spiritual";
pub const SUMMARY_EN : str = "Kernel / FPGA MAC. Kernel and FPGA are the open palm of the lower hardware level.";
; The three documents that bind every agent, as repo-root paths in gHashTag/t27.
pub const SOUL : str = "SOUL.md";
pub const AGENTS_DOC : str = "AGENTS.md";
pub const ALPHABET : str = "docs/agents/AGENTS_ALPHABET.md";
; Key files as the alphabet lists them (paths and globs relative to the t27 root).
pub const KEY_FILES : [2]str = ["t27/specs/fpga/mac.t27", "specs/math/e8_lie_algebra.t27"];
pub const ENTRY_INVARIANT : str = "MAC spec is zero-DSP (no digital signal processors)";
pub const EXIT_INVARIANT : str = "Synthesis is verified, E8 kernel integration works";
; The alphabet lists no CLARA role for this agent ("-").
pub const CLARA_ROLE : str = "";
; Skill IDs the agent holds. Bound only where a source names the skill; SKILLS_NOTE
; cites that source or says why the list is empty.
pub const SKILLS : [1]str = ["trinity/fpga-synth"];
pub const SKILLS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\", rule 2: domain lead for 1 skill card(s).";
; Tool IDs (specs/tools) the agent holds. Bound only where a source line names the command
; for this letter; TOOLS_NOTE cites that line or says why the list is empty.
pub const TOOLS : [7]str = ["gHashTag/trinity:tri/fpga", "gHashTag/trinity:tri/sacred-const", "tri/fleet", "tri/fpga", "tri/rtl", "tri/sweep", "tri/synth"];
pub const TOOLS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\", rule 2: domain lead for 7 tool card(s), read off what each card states it does rather than off its name.";
; Where the agent logs episodes (AGENTS_ALPHABET.md: "Logs to .trinity/experience/").
pub const EXPERIENCE_LOG : str = ".trinity/experience/";
pub const ENABLED : bool = true;

test test_agent_k_constants {
  assert KIND == "agent";
  assert ID == "t27/K";
  assert LETTER == "K";
  assert ORDINAL == 11;
  assert LETTER_NAME == "Kappa";
  assert NAME == "Kappa (Kernel)";
  assert DOMAIN == "Kernel / FPGA MAC";
  assert ARCHETYPE == "Palm - open hand";
  assert REGISTER == "R10";
  assert LAYER == "Spiritual";
  assert ENABLED == true;
}
