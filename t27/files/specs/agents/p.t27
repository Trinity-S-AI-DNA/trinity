// SPDX-License-Identifier: Apache-2.0
; specs/agents/p.t27 -- agent t27/P, letter P of the 27-agent alphabet
; Source of truth for the agent card on t27.ai (#/agents?agent=t27/P).
; Transcribed from docs/agents/AGENTS_ALPHABET.md (v3.0): the FULL TABLE row and the
; "Agent P - Pi (Physics)" schema section. The agent is bound to the others by SOUL.md,
; AGENTS.md and the experience log; the JSON the site serves is generated from this
; file by the real compiler, nothing below is parsed with a regex. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module agent_p;

pub const KIND : str = "agent";
pub const ID : str = "t27/P";
pub const LETTER : str = "P";
; position in the alphabet, 1..27 (the 27th letter is Ti, register R26)
pub const ORDINAL : u8 = 16;
pub const LETTER_NAME : str = "Pi";
pub const NAME : str = "Pi (Physics)";
pub const DOMAIN : str = "Physics / SacredPhysics";
pub const ARCHETYPE : str = "Mouth - speech of universe";
; Coptic register from the schema section (the ISA register the agent is bound to)
pub const REGISTER : str = "R15";
; alphabet layer: Archetypal (A-I), Spiritual (J-R), Physical (S-27th)
pub const LAYER : str = "Spiritual";
pub const SUMMARY_EN : str = "Physics / SacredPhysics. Physics is nature speaking through its constants (phi, G, OmegaLambda).";
; The three documents that bind every agent, as repo-root paths in gHashTag/t27.
pub const SOUL : str = "SOUL.md";
pub const AGENTS_DOC : str = "AGENTS.md";
pub const ALPHABET : str = "docs/agents/AGENTS_ALPHABET.md";
; Key files as the alphabet lists them (paths and globs relative to the t27 root).
pub const KEY_FILES : [2]str = ["t27/specs/math/sacred_physics.t27", "specs/physics/su2_chern_simons.t27"];
pub const ENTRY_INVARIANT : str = "phi^2 + phi^-2 = 3 holds in all calculations";
pub const EXIT_INVARIANT : str = "Sacred constants (G, OmegaLambda, phi, tpresent) are verified";
; CLARA role from the alphabet (TA1/TA2 work areas).
pub const CLARA_ROLE : str = "TA1: AR Theoretical Foundations - provides mathematical basis for AR reasoning";
; Skill IDs the agent holds. Bound only where a source names the skill; SKILLS_NOTE
; cites that source or says why the list is empty.
pub const SKILLS : [0]str = [];
pub const SKILLS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\": no skill card states this domain as its subject. The Queen holds every skill by rule 1.";
; Tool IDs (specs/tools) the agent holds. Bound only where a source line names the command
; for this letter; TOOLS_NOTE cites that line or says why the list is empty.
pub const TOOLS : [9]str = ["gHashTag/trinity:tri/bio", "gHashTag/trinity:tri/blindspots", "gHashTag/trinity:tri/conscious", "gHashTag/trinity:tri/constants", "gHashTag/trinity:tri/cosmos", "gHashTag/trinity:tri/particles", "gHashTag/trinity:tri/quantum", "gHashTag/trinity:tri/sacred-const", "gHashTag/trinity:tri/spiral"];
pub const TOOLS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\", rule 2: domain lead for 9 tool card(s), read off what each card states it does rather than off its name.";
; Where the agent logs episodes (AGENTS_ALPHABET.md: "Logs to .trinity/experience/").
pub const EXPERIENCE_LOG : str = ".trinity/experience/";
pub const ENABLED : bool = true;

test agent_p_constants {
  assert KIND == "agent";
  assert ID == "t27/P";
  assert LETTER == "P";
  assert ORDINAL == 16;
  assert LETTER_NAME == "Pi";
  assert NAME == "Pi (Physics)";
  assert DOMAIN == "Physics / SacredPhysics";
  assert ARCHETYPE == "Mouth - speech of universe";
  assert REGISTER == "R15";
  assert LAYER == "Spiritual";
  assert ENABLED == true;
  assert CLARA_ROLE == "TA1: AR Theoretical Foundations - provides mathematical basis for AR reasoning";
  assert KEY_FILES[0] == "t27/specs/math/sacred_physics.t27";
  assert KEY_FILES[1] == "specs/physics/su2_chern_simons.t27";
}
