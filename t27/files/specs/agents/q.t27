// SPDX-License-Identifier: Apache-2.0
; specs/agents/q.t27 -- agent t27/Q, letter Q of the 27-agent alphabet
; Source of truth for the agent card on t27.ai (#/agents?agent=t27/Q).
; Transcribed from docs/agents/AGENTS_ALPHABET.md (v3.0): the FULL TABLE row and the
; "Agent Q - Theta (Queue)" schema section. The agent is bound to the others by SOUL.md,
; AGENTS.md and the experience log; the JSON the site serves is generated from this
; file by the real compiler, nothing below is parsed with a regex. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module agent_q;

pub const KIND : str = "agent";
pub const ID : str = "t27/Q";
pub const LETTER : str = "Q";
; position in the alphabet, 1..27 (the 27th letter is Ti, register R26)
pub const ORDINAL : u8 = 17;
pub const LETTER_NAME : str = "Theta";
pub const NAME : str = "Theta (Queue)";
pub const DOMAIN : str = "Queue / Scheduling";
pub const ARCHETYPE : str = "Needle's eye - bottleneck";
; Coptic register from the schema section (the ISA register the agent is bound to)
pub const REGISTER : str = "R16";
; alphabet layer: Archetypal (A-I), Spiritual (J-R), Physical (S-27th)
pub const LAYER : str = "Spiritual";
pub const SUMMARY_EN : str = "Queue / Scheduling. The queue is the needle's eye for tasks.";
; The three documents that bind every agent, as repo-root paths in gHashTag/t27.
pub const SOUL : str = "SOUL.md";
pub const AGENTS_DOC : str = "AGENTS.md";
pub const ALPHABET : str = "docs/agents/AGENTS_ALPHABET.md";
; Key files as the alphabet lists them (paths and globs relative to the t27 root).
pub const KEY_FILES : [1]str = ["src/tri/dev_commands.zig"];
pub const ENTRY_INVARIANT : str = "Queue is not empty (work exists)";
pub const EXIT_INVARIANT : str = "MNL (Most-Numerous-Loss) pattern enforced, no starvation";
; The alphabet lists no CLARA role for this agent ("-").
pub const CLARA_ROLE : str = "";
; Skill IDs the agent holds. Bound only where a source names the skill; SKILLS_NOTE
; cites that source or says why the list is empty.
pub const SKILLS : [1]str = ["trinity/god-mode"];
pub const SKILLS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\", rule 2: domain lead for 1 skill card(s).";
; Tool IDs (specs/tools) the agent holds. Bound only where a source line names the command
; for this letter; TOOLS_NOTE cites that line or says why the list is empty.
pub const TOOLS : [1]str = ["mcp/inngest-dev"];
pub const TOOLS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\", rule 2: domain lead for 1 tool card(s), read off what each card states it does rather than off its name.";
; Where the agent logs episodes (AGENTS_ALPHABET.md: "Logs to .trinity/experience/").
pub const EXPERIENCE_LOG : str = ".trinity/experience/";
pub const ENABLED : bool = true;

test agent_q_constants {
  assert KIND == "agent";
  assert ID == "t27/Q";
  assert LETTER == "Q";
  assert ORDINAL == 17;
  assert LETTER_NAME == "Theta";
  assert NAME == "Theta (Queue)";
  assert DOMAIN == "Queue / Scheduling";
  assert ARCHETYPE == "Needle's eye - bottleneck";
  assert REGISTER == "R16";
  assert LAYER == "Spiritual";
  assert ENABLED == true;
  assert CLARA_ROLE == "";
  assert SKILLS[0] == "trinity/god-mode";
  assert TOOLS[0] == "mcp/inngest-dev";
}
