// SPDX-License-Identifier: Apache-2.0
; specs/agents/i.t27 -- agent t27/I, letter I of the 27-agent alphabet
; Source of truth for the agent card on t27.ai (#/agents?agent=t27/I).
; Transcribed from docs/agents/AGENTS_ALPHABET.md (v3.0): the FULL TABLE row and the
; "Agent I - Iota (ISA)" schema section. The agent is bound to the others by SOUL.md,
; AGENTS.md and the experience log; the JSON the site serves is generated from this
; file by the real compiler, nothing below is parsed with a regex. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module agent_i;

pub const KIND : str = "agent";
pub const ID : str = "t27/I";
pub const LETTER : str = "I";
; position in the alphabet, 1..27 (the 27th letter is Ti, register R26)
pub const ORDINAL : u8 = 9;
pub const LETTER_NAME : str = "Iota";
pub const NAME : str = "Iota (ISA)";
pub const DOMAIN : str = "ISA / Registers";
pub const ARCHETYPE : str = "Hand - action, point";
; Coptic register from the schema section (the ISA register the agent is bound to)
pub const REGISTER : str = "R8";
; alphabet layer: Archetypal (A-I), Spiritual (J-R), Physical (S-27th)
pub const LAYER : str = "Archetypal";
pub const SUMMARY_EN : str = "ISA / Registers. The ISA is the hand of the machine, its most basic instruction level.";
; The three documents that bind every agent, as repo-root paths in gHashTag/t27.
pub const SOUL : str = "SOUL.md";
pub const AGENTS_DOC : str = "AGENTS.md";
pub const ALPHABET : str = "docs/agents/AGENTS_ALPHABET.md";
; Key files as the alphabet lists them (paths and globs relative to the t27 root).
pub const KEY_FILES : [1]str = ["t27/specs/isa/registers.t27"];
pub const ENTRY_INVARIANT : str = "27 registers are defined, Coptic mapping exists";
pub const EXIT_INVARIANT : str = "Coptic mapping is verified (bijection), all registers accessible";
; The alphabet lists no CLARA role for this agent ("-").
pub const CLARA_ROLE : str = "";
; Skill IDs the agent holds. Bound only where a source names the skill; SKILLS_NOTE
; cites that source or says why the list is empty.
pub const SKILLS : [0]str = [];
pub const SKILLS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\": no skill card states this domain as its subject. The Queen holds every skill by rule 1.";
; Tool IDs (specs/tools) the agent holds. Bound only where a source line names the command
; for this letter; TOOLS_NOTE cites that line or says why the list is empty.
pub const TOOLS : [0]str = [];
pub const TOOLS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\": no tool card states this domain as its subject. The Queen holds every tool by rule 1.";
; Where the agent logs episodes (AGENTS_ALPHABET.md: "Logs to .trinity/experience/").
pub const EXPERIENCE_LOG : str = ".trinity/experience/";
pub const ENABLED : bool = true;

test test_agent_i_constants {
  assert KIND == "agent";
  assert ID == "t27/I";
  assert LETTER == "I";
  assert ORDINAL == 9;
  assert LETTER_NAME == "Iota";
  assert NAME == "Iota (ISA)";
  assert DOMAIN == "ISA / Registers";
  assert ARCHETYPE == "Hand - action, point";
  assert REGISTER == "R8";
  assert LAYER == "Archetypal";
  assert ENABLED == true;
}
