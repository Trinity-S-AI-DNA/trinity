// SPDX-License-Identifier: Apache-2.0
; specs/agents/s.t27 -- agent t27/S, letter S of the 27-agent alphabet
; Source of truth for the agent card on t27.ai (#/agents?agent=t27/S).
; Transcribed from docs/agents/AGENTS_ALPHABET.md (v3.0): the FULL TABLE row and the
; "Agent S - Sigma (Specs)" schema section. The agent is bound to the others by SOUL.md,
; AGENTS.md and the experience log; the JSON the site serves is generated from this
; file by the real compiler, nothing below is parsed with a regex. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module agent_s;

pub const KIND : str = "agent";
pub const ID : str = "t27/S";
pub const LETTER : str = "S";
; position in the alphabet, 1..27 (the 27th letter is Ti, register R26)
pub const ORDINAL : u8 = 19;
pub const LETTER_NAME : str = "Sigma";
pub const NAME : str = "Sigma (Specs)";
pub const DOMAIN : str = "Specs / Standardization / AR Specs";
pub const ARCHETYPE : str = "Teeth - sharpness, flame";
; Coptic register from the schema section (the ISA register the agent is bound to)
pub const REGISTER : str = "R18";
; alphabet layer: Archetypal (A-I), Spiritual (J-R), Physical (S-27th)
pub const LAYER : str = "Physical";
pub const SUMMARY_EN : str = "Specs / Standardization / AR Specs. Specs are the teeth of the standard that grind everything into canon.";
; The three documents that bind every agent, as repo-root paths in gHashTag/t27.
pub const SOUL : str = "SOUL.md";
pub const AGENTS_DOC : str = "AGENTS.md";
pub const ALPHABET : str = "docs/agents/AGENTS_ALPHABET.md";
; Key files as the alphabet lists them (paths and globs relative to the t27 root).
pub const KEY_FILES : [3]str = ["specs/", "specs/ar/*.t27", "docs/NUMERIC-*.md"];
pub const ENTRY_INVARIANT : str = "All specs have TDD (test/invariant/bench)";
pub const EXIT_INVARIANT : str = "Standards are consistent, naming rules followed";
; CLARA role from the alphabet (TA1/TA2 work areas).
pub const CLARA_ROLE : str = "TA1: AR Spec Standards - defines and enforces AR spec conventions";
; Skill IDs the agent holds. Bound only where a source names the skill; SKILLS_NOTE
; cites that source or says why the list is empty.
pub const SKILLS : [1]str = ["t27/measure-corpus"];
pub const SKILLS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\", rule 2: domain lead for 1 skill card(s).";
; Tool IDs (specs/tools) the agent holds. Bound only where a source line names the command
; for this letter; TOOLS_NOTE cites that line or says why the list is empty.
pub const TOOLS : [4]str = ["mcp/t27-traceability", "tri/prose", "tri/seals", "tri/types"];
pub const TOOLS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\", rule 2: domain lead for 4 tool card(s), read off what each card states it does rather than off its name.";
; Where the agent logs episodes (AGENTS_ALPHABET.md: "Logs to .trinity/experience/").
pub const EXPERIENCE_LOG : str = ".trinity/experience/";
pub const ENABLED : bool = true;

test agent_s_constants {
  assert KIND == "agent";
  assert ID == "t27/S";
  assert LETTER == "S";
  assert ORDINAL == 19;
  assert LETTER_NAME == "Sigma";
  assert NAME == "Sigma (Specs)";
  assert DOMAIN == "Specs / Standardization / AR Specs";
  assert ARCHETYPE == "Teeth - sharpness, flame";
  assert REGISTER == "R18";
  assert LAYER == "Physical";
  assert ENABLED == true;
  assert CLARA_ROLE == "TA1: AR Spec Standards - defines and enforces AR spec conventions";
  assert KEY_FILES[0] == "specs/";
  assert KEY_FILES[1] == "specs/ar/*.t27";
  assert KEY_FILES[2] == "docs/NUMERIC-*.md";
}
