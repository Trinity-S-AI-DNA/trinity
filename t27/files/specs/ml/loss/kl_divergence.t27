// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// KL divergence - measure of difference between distributions | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-05 from trinity specs/algo/kl_divergence.tri: the port kept only
// the first parameter and returned void, so forward computed a value and
// threw it away, and every test asserted `result != undefined`.

module KlDivergence;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // KL(p || q) = sum p_i log(p_i / q_i), in nats. A term with p_i = 0 is 0
    // (limit of x log x); q_i = 0 where p_i > 0 makes KL infinite, which
    // @log(inf) reports. The old body summed p log p (negative entropy),
    // ignored q, and never returned it.
    fn forward(p: []const f32, q: []const f32) -> f32 {
        var sum : f32 = 0.0;
        var i : usize = 0;
        while (i < p.len) {
            if (p[i] > 0.0) {
                sum = sum + p[i] * @log(p[i] / q[i]);
            }
            i = i + 1;
        }
        return sum;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    fn kl_at(p0: f32, p1: f32, q0: f32, q1: f32) -> f32 {
        const p : [2]f32 = [p0, p1];
        const q : [2]f32 = [q0, q1];
        return forward(&p, &q);
    }

    test zero_for_identical_distributions
        given result = kl_at(0.3, 0.7, 0.3, 0.7)
        when also = kl_at(1.0, 0.0, 1.0, 0.0)
        then result == 0.0 and also == 0.0

    // 0.5 ln(0.5/0.9) + 0.5 ln(0.5/0.1) = 0.5108256
    test forward_reference_value
        given result = kl_at(0.5, 0.5, 0.9, 0.1)
        when reversed = kl_at(0.9, 0.1, 0.5, 0.5)
        then @abs(result - 0.5108256) < 0.00001 and @abs(reversed - 0.3680642) < 0.00001

    // KL is not symmetric, and is never negative (Gibbs)
    test asymmetric_and_nonnegative
        given forward_kl = kl_at(0.5, 0.5, 0.9, 0.1)
        when backward_kl = kl_at(0.9, 0.1, 0.5, 0.5)
        then forward_kl > backward_kl and backward_kl > 0.0

    // KL(p || uniform over 2) = ln 2 - H(p); for p = (1, 0): ln 2
    test point_mass_against_uniform
        given result = kl_at(1.0, 0.0, 0.5, 0.5)
        when expected = 0.6931472
        then @abs(result - expected) < 0.00001

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants
    // ═══════════════════════════════════════════════════════════

    invariant kl_zero_on_self
        assert kl_at(0.25, 0.75, 0.25, 0.75) == 0.0
