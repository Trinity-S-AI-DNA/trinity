// SPDX-License-Identifier: Apache-2.0
// t27/specs/ml/layers/residual_connection.t27
// Add & Norm: residual add, then layer normalization | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/algo/residual.tri. The port's
// forward read each input element and discarded it, took no sublayer
// output, gamma, beta or output, and its tests said `result != undefined`
// (one on default_input(), defined nowhere).
// forward follows the .tri formula: output = layer_norm(sublayer_output +
// input, gamma, beta), the post-LN order. The .tri's own behavior text
// says "Pre-LN: normalize before residual", which contradicts the formula;
// the formula is the only one with a definition. Owner decision.
// layer_norm is the one restored in specs/ml/layers/layernorm_layer.t27
// (mean, biased variance over the vector). The .tri gives it no eps, so
// eps is a parameter here, not an invented constant.

module Residual;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // output = gamma * (s - mean(s)) / sqrt(var(s) + eps) + beta, s = sublayer_output + input
    fn forward(input: []const f32, sublayer_output: []const f32, gamma: []const f32, beta: []const f32, output: []f32, eps: f32) -> void {
        const n = input.len as f32;
        var sum : f32 = 0.0;
        var i : usize = 0;
        while (i < input.len) {
            output[i] = sublayer_output[i] + input[i];
            sum = sum + output[i];
            i = i + 1;
        }
        const mean = sum / n;
        var sum_sq : f32 = 0.0;
        i = 0;
        while (i < input.len) {
            const diff = output[i] - mean;
            sum_sq = sum_sq + diff * diff;
            i = i + 1;
        }
        const inv_std = 1.0 / @sqrt(sum_sq / n + eps);
        i = 0;
        while (i < input.len) {
            output[i] = gamma[i] * (output[i] - mean) * inv_std + beta[i];
            i = i + 1;
        }
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (reference values computed by hand)
    // ═══════════════════════════════════════════════════════════

    // input = (1, 0, 2), sublayer = (0, 2, 2): the sum (1, 2, 4) is the
    // layernorm_layer test vector, so y0 + 10 y1 + 100 y2 = -29.5991535 there
    // too. Normalizing the sublayer alone gives -41.9170; the input alone, -53.2579.
    fn residual_code() -> f32 {
        const input : [3]f32 = [1.0, 0.0, 2.0];
        const sub : [3]f32 = [0.0, 2.0, 2.0];
        const gamma : [3]f32 = [1.0, 2.0, 0.5];
        const beta : [3]f32 = [0.0, 1.0, 0.0 - 1.0];
        var y : [3]f32 = [0.0] ** 3;
        forward(&input, &sub, &gamma, &beta, &y, 0.00001);
        return y[0] + 10.0 * y[1] + 100.0 * y[2];
    }

    test forward_adds_then_normalizes
        given result = residual_code()
        when expected = -29.5991535
        then @abs(result - expected) < 0.0001
