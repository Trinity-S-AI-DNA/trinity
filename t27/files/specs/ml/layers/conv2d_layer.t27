// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Optimized depthwise convolution | φ² + 1/φ² = 3 | TRINITY

module Conv2d;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const MIN_KERNEL_SIZE : u32 = 1;
    const MAX_KERNEL_SIZE : u32 = 7;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Conv2DConfig = struct {
        in_channels : u32,
        out_channels : u32,
        kernel_size : u32,
        stride : u32,
        padding : u32,
        dilation : u32,
        groups : u32,
        has_bias : bool,
    };

    pub const PaddingMode = enum(u8) {
        Zeros,
        Reflect,
        Replicate,
        Circular,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // forward(input: []const f32, weights: []const f32, bias: []const f32, output: []f32, config: Conv2DConfig) → void
    fn forward(input: []const f32, weights: []const f32, bias: []const f32, output: []f32, config: Conv2DConfig) -> void {
        // Simple 2D convolution implementation
        var i: u32 = 0;
        while (i < config.kernel_size) {
            var j: u32 = 0;
            while (j < config.kernel_size) {
                output[i * config.kernel_size + j] = input[i * config.kernel_size + j] * weights[i * config.kernel_size + j];
                j = j + 1;
            }
            i = i + 1;
        }
        
        // Add bias if present
        if (config.has_bias) {
            var k: u32 = 0;
            while (k < config.kernel_size * config.kernel_size) {
                output[k] = output[k] + bias[0];
                k = k + 1;
            }
        }
    }

    // backward(grad_output: []const f32, input: []const f32, weights: []const f32, grad_input: []f32, grad_weights: []f32, grad_bias: []f32, config: Conv2DConfig) → void
    fn backward(grad_output: []const f32, input: []const f32, weights: []const f32, grad_input: []f32, grad_weights: []f32, grad_bias: []f32, config: Conv2DConfig) -> void {
        // Simple backward pass implementation
        var i: u32 = 0;
        while (i < config.kernel_size) {
            var j: u32 = 0;
            while (j < config.kernel_size) {
                // Gradient w.r.t input
                grad_input[i * config.kernel_size + j] = grad_output[i * config.kernel_size + j] * weights[i * config.kernel_size + j];
                
                // Gradient w.r.t weights
                grad_weights[i * config.kernel_size + j] = grad_output[i * config.kernel_size + j] * input[i * config.kernel_size + j];
                
                j = j + 1;
            }
            i = i + 1;
        }
        
        // Gradient w.r.t bias
        if (config.has_bias) {
            var k: u32 = 0;
            while (k < config.kernel_size * config.kernel_size) {
                grad_bias[0] = grad_bias[0] + grad_output[k];
                k = k + 1;
            }
        }
    }

    // ═══════════════════════════════════════════════════════════
    // 4. Helper Functions
    // ═══════════════════════════════════════════════════════════

    fn default_input() -> []const f32 {
        return [1.0, 2.0, 3.0, 4.0]; // 2x2 input
    }

    fn default_weights() -> []const f32 {
        return [1.0, 0.5, 0.25, 0.1]; // 2x2 kernel
    }

    fn default_bias() -> []const f32 {
        return [0.1];
    }

    fn default_output() -> []f32 {
        return [0.0, 0.0, 0.0, 0.0]; // 2x2 output
    }

    fn default_grad_output() -> []const f32 {
        return [1.0, 1.0, 1.0, 1.0]; // 2x2 gradient
    }

    fn default_grad_input() -> []f32 {
        return [0.0, 0.0, 0.0, 0.0]; // 2x2 gradient input
    }

    fn default_grad_weights() -> []f32 {
        return [0.0, 0.0, 0.0, 0.0]; // 2x2 gradient weights
    }

    fn default_grad_bias() -> []f32 {
        return [0.0]; // 1x1 gradient bias
    }

    // The input the invariants below are stated over.
    fn valid_input() -> Conv2DConfig {
        return default_config();
    }

    fn default_config() -> Conv2DConfig {
        return Conv2DConfig {
            in_channels: 1,
            out_channels: 1,
            kernel_size: 2,
            stride: 1,
            padding: 0,
            dilation: 1,
            groups: 1,
            has_bias: true,
        };
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    // The two tests below used `given output = default_output()`, which hands
    // forward() a constant buffer to write into, and `then result != undefined`
    // on a void call. Neither could pass once the spec compiled (#6446), so they
    // write into local buffers and check the values the kernel produces.
    test forward_basic_case {
        var output: [4]f32 = [0.0, 0.0, 0.0, 0.0];
        forward(default_input(), default_weights(), default_bias(), &output, default_config());
        // 2x2 elementwise product plus bias[0]: 1.0 * 1.0 + 0.1 and 4.0 * 0.1 + 0.1
        assert(output[0] > 1.09);
        assert(output[0] < 1.11);
        assert(output[3] > 0.49);
        assert(output[3] < 0.51);
    }

    test backward_basic_case {
        var grad_input: [4]f32 = [0.0, 0.0, 0.0, 0.0];
        var grad_weights: [4]f32 = [0.0, 0.0, 0.0, 0.0];
        var grad_bias: [1]f32 = [0.0];
        backward(default_grad_output(), default_input(), default_weights(), &grad_input, &grad_weights, &grad_bias, default_config());
        // grad_output is all ones: grad_input = weights, grad_weights = input,
        // grad_bias = the sum of the four ones.
        assert(grad_input[1] > 0.49);
        assert(grad_input[1] < 0.51);
        assert(grad_weights[2] > 2.99);
        assert(grad_weights[2] < 3.01);
        assert(grad_bias[0] > 3.99);
        assert(grad_bias[0] < 4.01);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (from .tri constraints)
    // ═══════════════════════════════════════════════════════════

    invariant conv2d_constraint_0
        given input = valid_input()
        then true // kernel_size in [1, 3, 5, 7]

    invariant conv2d_constraint_1
        given input = valid_input()
        then true // stride in [1, 2, 4]

    invariant conv2d_constraint_2
        given input = valid_input()
        then true // dilation in [1, 2]

    invariant conv2d_constraint_3
        given input = valid_input()
        then true // in_channels % groups == 0

    invariant conv2d_constraint_4
        given input = valid_input()
        then true // out_channels % groups == 0

