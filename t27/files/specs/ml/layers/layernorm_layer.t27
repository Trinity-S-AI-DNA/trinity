// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Normalizes across hidden dimension, not batch | φ² + 1/φ² = 3 | TRINITY

module Layernorm;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Added to the variance before the square root, as in torch.nn.LayerNorm.
    const LAYERNORM_EPS : f32 = 1.0e-5;

    pub const LayerNormConfig = struct {
        normalized_shape : []u32,
        eps : f32,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // forward(input, out): layer normalization over the whole of input, with no
    // affine scale or shift. out[i] = (input[i] - mean) / sqrt(variance + eps),
    // where mean and the biased variance (divided by n, not n - 1) are taken
    // over input. out must hold at least input.len values; an empty input
    // writes nothing.
    fn forward(input: []const f32, out: []f32) -> void {
        if (input.len == 0) {
            return;
        }
        var sum: f32 = 0.0;
        var n: f32 = 0.0;
        var i: usize = 0;
        while (i < input.len) {
            sum = sum + input[i];
            n = n + 1.0;
            i = i + 1;
        }
        const mean: f32 = sum / n;
        var variance: f32 = 0.0;
        i = 0;
        while (i < input.len) {
            const diff: f32 = input[i] - mean;
            variance = variance + diff * diff;
            i = i + 1;
        }
        variance = variance / n;
        const denom: f32 = @sqrt(variance + LAYERNORM_EPS);
        i = 0;
        while (i < input.len) {
            out[i] = (input[i] - mean) / denom;
            i = i + 1;
        }
    }

    // |a - b| <= tol
    fn near(a: f32, b: f32, tol: f32) -> bool {
        if (a > b) {
            return a - b <= tol;
        }
        return b - a <= tol;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // The three tests here used to read `when result = forward(input) then true`:
    // forward() returned nothing and dropped every value it computed, so they
    // passed whatever it did. forward() now writes its result to `out`, and the
    // tests check the values. The expected numbers are worked out by hand.

    // [1, 2, 3, 4]: mean 2.5, variance (2.25 + 0.25 + 0.25 + 2.25) / 4 = 1.25,
    // so out = [-1.5, -0.5, 0.5, 1.5] / sqrt(1.25 + 1e-5)
    //         = [-1.341635, -0.447212, 0.447212, 1.341635].
    test forward_normalizes_input {
        var input: [4]f32 = [1.0, 2.0, 3.0, 4.0];
        var out: [4]f32 = [9.0, 9.0, 9.0, 9.0];
        forward(&input, &out);
        assert(near(out[0], -1.341635, 0.0001));
        assert(near(out[1], -0.447212, 0.0001));
        assert(near(out[2], 0.447212, 0.0001));
        assert(near(out[3], 1.341635, 0.0001));
        // The result has mean 0 and variance 1.25 / (1.25 + 1e-5), just under 1.
        assert(near(out[0] + out[1] + out[2] + out[3], 0.0, 0.0001));
        const sq: f32 = out[0] * out[0] + out[1] * out[1] + out[2] * out[2] + out[3] * out[3];
        assert(near(sq / 4.0, 0.999992, 0.0001));
    }

    // Shifting and scaling the input leaves the result unchanged, up to eps.
    test forward_ignores_shift_and_scale {
        var input: [4]f32 = [12.0, 14.0, 16.0, 18.0];
        var out: [4]f32 = [9.0, 9.0, 9.0, 9.0];
        forward(&input, &out);
        assert(near(out[0], -1.341639, 0.0001));
        assert(near(out[1], -0.447213, 0.0001));
        assert(near(out[2], 0.447213, 0.0001));
        assert(near(out[3], 1.341639, 0.0001));
    }

    // An empty input writes nothing.
    test forward_handles_empty_input {
        var input: [4]f32 = [1.0, 2.0, 3.0, 4.0];
        var out: [4]f32 = [9.0, 9.0, 9.0, 9.0];
        forward(input[0..0], &out);
        assert(out[0] == 9.0);
        assert(out[3] == 9.0);
    }

    // One element is its own mean, so it normalizes to exactly 0 (0 / sqrt(eps)),
    // and only out[0] is written.
    test forward_normalizes_single_element {
        var input: [1]f32 = [5.0];
        var out: [2]f32 = [9.0, 9.0];
        forward(&input, &out);
        assert(out[0] == 0.0);
        assert(out[1] == 9.0);
    }

    // A constant input has variance 0, and every value normalizes to 0.
    test forward_constant_input_is_zero {
        var input: [3]f32 = [3.0, 3.0, 3.0];
        var out: [3]f32 = [9.0, 9.0, 9.0];
        forward(&input, &out);
        assert(out[0] == 0.0);
        assert(out[1] == 0.0);
        assert(out[2] == 0.0);
    }
