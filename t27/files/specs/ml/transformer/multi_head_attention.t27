// t27/specs/ml/transformer/multi_head_attention.t27
// Multi-head attention configuration | φ² + 1/φ² = 3 | TRINITY
// Checked 2026-10-06 against trinity specs/algo/multi_head_attn.tri. The
// port's forward took only the query and returned; its two tests read
// default_input(), defined nowhere, and asserted `result != undefined`
// and `true`. The .tri formula projects with Wq_h, Wk_h, Wv_h and Wo,
// but forward's parameters carry no weights and the .tri never says
// where they live or how they are laid out, so forward is not written
// here. What the .tri does state is the per-head width:
// d_k = d_model / num_heads.

module MultiHeadAttn;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const MHAConfig = struct {
        d_model : u32,
        num_heads : u32,
        d_k : u32,
        causal : bool,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // at least one head, and the heads split d_model exactly into d_k each
    fn config_ok(config: MHAConfig) -> bool {
        return config.num_heads >= 1 and config.d_k * config.num_heads == config.d_model;
    }

    fn cfg(d_model: u32, num_heads: u32, d_k: u32) -> MHAConfig {
        return MHAConfig{ .d_model = d_model, .num_heads = num_heads, .d_k = d_k, .causal = false };
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // 512 = 8 x 64 passes; d_k 63 does not split 512; 0 heads fails;
    // 10 = 3 x 3 + 1 does not split (integer d_model / num_heads would say 3)
    fn bounds_check() -> bool {
        const a = config_ok(cfg(512, 8, 64));
        const b = config_ok(cfg(512, 8, 63));
        const c = config_ok(cfg(0, 0, 64));
        const d = config_ok(cfg(10, 3, 3));
        return a and !b and !c and !d;
    }

    test config_splits_d_model
        given result = bounds_check()
        when expected = true
        then result == expected

    // NOT CHECKED: forward (projection weights undefined in the .tri),
    // causal masking, and the prose behavior parallel_heads.
