    invariant ppo_critic_constraint_4
        given input = valid_input()
        then true // "Schulman et al. (2016) - High-dimensional continuous control using GAE"

    invariant ppo_critic_constraint_5
        given input = valid_input()
        then true // "Schulman et al. (2017) - Proximal Policy Optimization Algorithms"

