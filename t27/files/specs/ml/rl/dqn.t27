// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// DQN: epsilon-greedy choice, TD targets, target-network copy | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/algo/dqn.tri. The port's three fns
// ignored their inputs and its tests were `then true`. The .tri calls
// q_network.forward/backward and random(), none of which it defines, so the
// network is outside this spec: the caller passes Q-values and the random
// draw, and the pieces of the .tri formulas that need neither are checked.

module Dqn;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    const DEFAULT_GAMMA : f32 = 0.99;
    const DEFAULT_EPSILON_START : f32 = 1.0;
    const DEFAULT_EPSILON_END : f32 = 0.01;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const DQNConfig = struct {
        state_dim : u32,
        action_dim : u32,
        hidden_dims : []u32,
        learning_rate : f32,
        gamma : f32,
        epsilon_start : f32,
        epsilon_end : f32,
        epsilon_decay : f32,
        batch_size : u32,
        target_update_freq : u32,
    };

    pub const Transition = struct {
        state : []f32,
        action : u32,
        reward : f32,
        next_state : []f32,
        done : bool,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // argmax over Q-values; the first index wins a tie
    fn greedy_action(q_values: []const f32) -> u32 {
        var best : usize = 0;
        var i : usize = 1;
        while (i < q_values.len) {
            if (q_values[i] > q_values[best]) {
                best = i;
            }
            i = i + 1;
        }
        return best as u32;
    }

    // Epsilon-greedy. `draw` is the caller's uniform sample in [0, 1) and
    // `random_action` the caller's uniform action: explore when draw < epsilon.
    fn select_action(q_values: []const f32, epsilon: f32, draw: f32, random_action: u32) -> u32 {
        if (draw < epsilon) {
            return random_action;
        }
        return greedy_action(q_values);
    }

    // Bellman target from the .tri: r if the episode ended, else
    // r + gamma * max_a Q_target(s', a)
    fn td_target(reward: f32, done: bool, next_q_values: []const f32, gamma: f32) -> f32 {
        if (done) {
            return reward;
        }
        var best : f32 = next_q_values[0];
        var i : usize = 1;
        while (i < next_q_values.len) {
            best = @max(best, next_q_values[i]);
            i = i + 1;
        }
        return reward + gamma * best;
    }

    // The loss train_step returns: sum over the batch of (target - Q(s, a))^2.
    // The .tri divides by batch_size only for the backward pass.
    fn td_loss(taken_q_values: []const f32, targets: []const f32) -> f32 {
        var loss : f32 = 0.0;
        var i : usize = 0;
        while (i < targets.len) {
            const td_error = targets[i] - taken_q_values[i];
            loss = loss + td_error * td_error;
            i = i + 1;
        }
        return loss;
    }

    // target_network = copy(q_network)
    fn update_target(q_network: []const f32, target_network: []f32) -> void {
        var i : usize = 0;
        while (i < q_network.len) {
            target_network[i] = q_network[i];
            i = i + 1;
        }
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (values worked by hand)
    // ═══════════════════════════════════════════════════════════

    fn argmax_of_three() -> u32 {
        const q : [3]f32 = [0.1, 0.7, 0.3];
        return greedy_action(&q);
    }

    fn argmax_tie() -> u32 {
        const q : [3]f32 = [0.5, 0.2, 0.5];
        return greedy_action(&q);
    }

    fn choose(draw: f32) -> u32 {
        const q : [3]f32 = [0.1, 0.7, 0.3];
        return select_action(&q, 0.1, draw, 2);
    }

    fn target_with(done: bool) -> f32 {
        const next : [2]f32 = [0.5, 2.0];
        return td_target(1.0, done, &next, 0.9);
    }

    fn loss_two() -> f32 {
        const taken : [2]f32 = [1.0, 2.0];
        const targets : [2]f32 = [2.8, 1.0];
        return td_loss(&taken, &targets);
    }

    fn copied_sum() -> f32 {
        const q : [3]f32 = [1.0, 2.0, 3.0];
        var target : [3]f32 = [0.0] ** 3;
        update_target(&q, &target);
        return target[0] + 10.0 * target[1] + 100.0 * target[2];
    }

    test greedy_action_picks_largest_q
        given best = argmax_of_three()
        when tie = argmax_tie()
        then best == 1 and tie == 0

    // draw 0.05 < epsilon 0.1 explores (action 2); draw 0.5 exploits (action 1)
    test select_action_epsilon_greedy
        given explore = choose(0.05)
        when exploit = choose(0.5)
        then explore == 2 and exploit == 1

    // not done: 1 + 0.9 * 2 = 2.8; done: the reward alone
    test td_target_bellman
        given open_episode = target_with(false)
        when ended = target_with(true)
        then @abs(open_episode - 2.8) < 0.00001 and @abs(ended - 1.0) < 0.000001

    // (2.8 - 1)^2 + (1 - 2)^2 = 3.24 + 1 = 4.24
    test td_loss_sums_squared_errors
        given result = loss_two()
        when expected = 4.24
        then @abs(result - expected) < 0.00001

    test update_target_copies_every_weight
        given result = copied_sum()
        when expected = 321.0
        then @abs(result - expected) < 0.0001

    // ═══════════════════════════════════════════════════════════
    // TDD: Invariants (from .tri constraints)
    // ═══════════════════════════════════════════════════════════

    invariant dqn_defaults_in_range
        assert DEFAULT_GAMMA >= 0.0 and DEFAULT_GAMMA <= 1.0 and DEFAULT_EPSILON_END >= 0.0 and DEFAULT_EPSILON_END <= DEFAULT_EPSILON_START and DEFAULT_EPSILON_START <= 1.0

    // NOT CHECKED here (were `then true` over an undefined valid_input()):
    // 0 < epsilon_decay <= 1 (the .tri gives no decay formula), and the
    // Q-network forward/backward that train_step needs.
