// specs/git/diff.t27
// Git Diff Operations
// φ² + 1/φ² = 3 | TRINITY

module GitDiff {
    use base::types;
    use git::schema;

    // ════════════════════════════════════════════════════════════════════
    // Diff Operations
    // ════════════════════════════════════════════════════════════════════
    //
    // These bodies were Rust: `Command::new(..)` and 21 Rust match blocks over
    // Ok/Err and over the status code. t27 has no such statement, so the
    // parser kept them as text, every backend lowered them to
    // nothing, and typecheck refused the spec (#5949, #6446). They are now
    // written the way specs/git/status.t27 is: run the command, test its exit
    // code, and hand the text to a parser. The parsers are pure, so the tests
    // check them on literal git output instead of on whatever repository the
    // test happens to run in.

    // kind_of_code maps a `git diff --name-status` code to its Kind
    fn kind_of_code(code: str) -> Kind {
        if code == "A" {
            return Kind::Added;
        }
        if code == "D" {
            return Kind::Deleted;
        }
        return Kind::Modified;
    }

    // parse_name_status parses `git diff --name-status` output: CODE<TAB>FILE per line
    fn parse_name_status(output: str) -> [Item] {
        var items: [Item] = [];
        var lines = output.split("\n");
        for line in lines {
            if line.trim() != "" {
                var parts = line.split("\t");
                if parts.len >= 2 {
                    var code = parts[0];
                    var file = parts[1];
                    items.append(Item { file = file, code = code, status = kind_of_code(code) });
                }
            }
        }
        return items;
    }

    // parse_numstat parses `git diff --numstat` output: ADDED<TAB>DELETED<TAB>FILE per line
    fn parse_numstat(output: str) -> [Stat] {
        var stats: [Stat] = [];
        var lines = output.split("\n");
        for line in lines {
            if line.trim() != "" {
                var parts = line.split("\t");
                if parts.len >= 3 {
                    var additions = parts[0].parse_u32();
                    var deletions = parts[1].parse_u32();
                    var file = parts[2];
                    stats.append(Stat { file = file, additions = additions, deletions = deletions });
                }
            }
        }
        return stats;
    }

    // diff returns changed files compared to a ref
    fn diff(cwd: str, ref: str) -> Result<[Item], GitError> {
        var result = execute_command("git diff --name-status " + ref, cwd);
        if result.exit_code != 0 {
            return Err(GitError::CommandFailed);
        }
        return parse_name_status(result.stdout);
    }

    // diff_cached returns staged changes compared to a ref (an empty ref means none)
    fn diff_cached(cwd: str, ref: str) -> Result<[Item], GitError> {
        var result = execute_command("git diff --cached --name-status " + ref, cwd);
        if result.exit_code != 0 {
            return Err(GitError::CommandFailed);
        }
        return parse_name_status(result.stdout);
    }

    // diff_files returns diff for specific files
    fn diff_files(cwd: str, ref: str, files: [str]) -> Result<[Item], GitError> {
        var items: [Item] = [];
        if files.len == 0 {
            return items;
        }
        var command = "git diff --name-status " + ref + " --";
        for file in files {
            command = command + " " + file;
        }
        var result = execute_command(command, cwd);
        if result.exit_code != 0 {
            return Err(GitError::CommandFailed);
        }
        return parse_name_status(result.stdout);
    }

    // diff_text returns the full diff text
    fn diff_text(cwd: str, ref: str) -> Result<str, GitError> {
        var result = execute_command("git diff " + ref, cwd);
        if result.exit_code != 0 {
            return Err(GitError::CommandFailed);
        }
        return result.stdout;
    }

    // diff_file_text returns diff text for a specific file
    fn diff_file_text(cwd: str, ref: str, file: str) -> Result<str, GitError> {
        var result = execute_command("git diff " + ref + " -- " + file, cwd);
        if result.exit_code != 0 {
            return Err(GitError::CommandFailed);
        }
        return result.stdout;
    }

    test "parse_name_status_reads_codes" {
        var items = parse_name_status("A\tsrc/a.t27\nD\tsrc/b.t27\nM\tsrc/c.t27\nR100\tsrc/d.t27\n");
        assert(items.len == 4);
        assert(items[0].file == "src/a.t27");
        assert(items[0].status == Kind::Added);
        assert(items[1].status == Kind::Deleted);
        assert(items[2].status == Kind::Modified);
        assert(items[3].status == Kind::Modified);
    }

    test "parse_name_status_skips_blank_and_short_lines" {
        var items = parse_name_status("\nM\n\nA\tx.t27\n");
        assert(items.len == 1);
        assert(items[0].file == "x.t27");
    }

    // ════════════════════════════════════════════════════════════════════
    // Diff Statistics
    // ════════════════════════════════════════════════════════════════════

    // stats returns line change statistics
    fn stats(cwd: str, ref: str) -> Result<[Stat], GitError> {
        var result = execute_command("git diff --numstat " + ref, cwd);
        if result.exit_code != 0 {
            return Err(GitError::CommandFailed);
        }
        return parse_numstat(result.stdout);
    }

    // stats_cached returns staged change statistics (an empty ref means none)
    fn stats_cached(cwd: str, ref: str) -> Result<[Stat], GitError> {
        var result = execute_command("git diff --cached --numstat " + ref, cwd);
        if result.exit_code != 0 {
            return Err(GitError::CommandFailed);
        }
        return parse_numstat(result.stdout);
    }

    test "parse_numstat_reads_counts" {
        var stats_list = parse_numstat("10\t5\ta.t27\n20\t15\tb.t27\n");
        assert(stats_list.len == 2);
        assert(stats_list[0].file == "a.t27");
        assert(stats_list[0].additions == 10);
        assert(stats_list[1].deletions == 15);
    }

    // stats_summary returns summary statistics
    struct StatsSummary {
        files_changed: u32,
        additions: u32,
        deletions: u32,
    }

    // summarize totals a list of stats
    fn summarize(stats_list: [Stat]) -> StatsSummary {
        var total_additions: u32 = 0;
        var total_deletions: u32 = 0;
        for stat in stats_list {
            total_additions = total_additions + stat.additions;
            total_deletions = total_deletions + stat.deletions;
        }
        return StatsSummary {
            files_changed = stats_list.len,
            additions = total_additions,
            deletions = total_deletions,
        };
    }

    fn stats_summary(cwd: str, ref: str) -> Result<StatsSummary, GitError> {
        var result = execute_command("git diff --numstat " + ref, cwd);
        if result.exit_code != 0 {
            return Err(GitError::CommandFailed);
        }
        return summarize(parse_numstat(result.stdout));
    }

    test "summarize_totals_the_stats" {
        var summary = summarize(parse_numstat("10\t5\ta.t27\n20\t15\tb.t27\n5\t0\tc.t27\n"));
        assert(summary.files_changed == 3);
        assert(summary.additions == 35);
        assert(summary.deletions == 20);
    }

    // ════════════════════════════════════════════════════════════════════
