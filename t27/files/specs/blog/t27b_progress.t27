; t27b against its reference, one dated entry per day the lab moved, and the
; t27.ai post that shows them.

; Owner's order, 2026-10-05: a blog post on t27b against the other second
; backends and the road to 100%, kept current as t27b improves, with the bees
; told to update it. Owner's rule of the same day: no new pull request may
; hold hand-written code in any language other than t27. So the post's text
; and its numbers live here, and `t27c gen-ts specs/blog/t27b_progress.t27`
; prints them as a TypeScript module. Nothing else writes them.

; Every number comes from the Railway lab,
; https://t27b-lab-production.up.railway.app/runs/<sha>.json, or from a
; source named in RECEIPT_HREF. Competitor figures are their own
; publications, quoted, not re-measured.

; Columns, one index per entry:
;   DATE       UTC day of the lab run, yyyymmdd
;   COMMIT     the t27 commit the lab measured, first 9 hex digits
;   REFERENCE  specs the reference path (t27c gen-zig + zig test) passes:
;              the denominator
;   CHECKED    of those, t27b passes with at least one runtime check
;   VACUOUS    of those, t27b passes with no test, invariant or assert run
;   BLOCKED    of those, t27b refuses (blocked + frontend)

; Entry 0 is the first lab run with reference numbers, 2026-10-04 15:09Z, on
; the lab's own branch claude/t27b-railway-lab. That lab did not split
; vacuous passes yet: it printed 47 passes, of which 26 ran no test and no
; invariant. They are entered here as VACUOUS, so a column means the same
; thing in every row. "47 passes" and "380 checked" are different
; quantities; checked against checked is 21 -> 380.

; How an entry is added (epic t27#6063). When the lab at master shows a
; CHECKED count different from the newest entry, the steward files ONE issue
; that day, "t27b blog: append today's lab entry", whose Boundary is this
; file only. The bee (or the steward) then:
;   1. reads latest.json: commit, summary.reference_pass, and per result
;      with reference == "pass": t27b == "pass" -> CHECKED,
;      "pass_vacuous" -> VACUOUS, "blocked" or "frontend" -> BLOCKED;
;   2. if DATE's last element is today, replaces that entry; otherwise
;      grows every array by one and adds today's entry;
;   3. sets ENTRIES, the SHOWN_* consts and SHOWN_CHECKED_PCT_TENTHS /
;      SHOWN_ANY_PCT_TENTHS to the newest entry;
;   4. appends one Updates paragraph to `body` (newest last) with the same
;      numbers, and rewrites the two headline paragraphs marked below;
;   5. runs `t27c test-report specs/blog/t27b_progress.t27`, which must
;      print "FAIL        0".
; The tests below refuse an entry that did not move CHECKED, a date out of
; order, CHECKED above REFERENCE, and a headline that is not the newest
; entry. They cannot read the numbers inside the prose; step 4 is checked
; by review.

; Publishing: trinity apps/website/src/data/blog needs bodies/<slug>.ts and
; a registration in posts.ts and index.ts. On 2026-10-05 that registration
; is hand-written TypeScript, which the owner's rule forbids in a new PR, so
; the trinity side waits for the owner or for a generator. The Russian body
; is not here: Article LANG-EN keeps .t27 files ASCII and English.

module BlogT27bProgress;

pub const ENTRIES: u32 = 2;
pub const DATE: [2]u32 = [20261004, 20261005];
pub const COMMIT: [2]u64 = [0xf59fd7685, 0x682564f48];
pub const REFERENCE: [2]u32 = [646, 723];
pub const CHECKED: [2]u32 = [21, 380];
pub const VACUOUS: [2]u32 = [26, 281];
pub const BLOCKED: [2]u32 = [599, 62];

; What the post's headline shows. It must be the newest entry.
pub const SHOWN_DATE: u32 = 20261005;
pub const SHOWN_REFERENCE: u32 = 723;
pub const SHOWN_CHECKED: u32 = 380;
pub const SHOWN_VACUOUS: u32 = 281;
pub const SHOWN_BLOCKED: u32 = 62;
; Tenths of a percent, rounded to nearest: 52.6% and 91.4%.
pub const SHOWN_CHECKED_PCT_TENTHS: u32 = 526;
pub const SHOWN_ANY_PCT_TENTHS: u32 = 914;

; The post. A block is a paragraph ("p") or a heading ("h"), the two shapes
; trinity's blog Block type shares; tables were left out on purpose, the
; owner found a wide table unreadable, and each ranking is one short line.
pub struct PostBlock {
    kind: str,
    text: str,
}

; Key of this post in a specs/i18n bundle (specs/i18n/blog-ru.t27).
pub const ID: str = "blog/t27b-against-other-second-backends";
pub const SLUG: str = "t27b-against-other-second-backends";
pub const TITLE: str = "t27b against other second backends, and the road to 100%";
pub const SUMMARY: str = "[one lab run on one commit; the suites differ, so the percentages are not the same quantity; competitor figures are their own publications] t27b, the native AArch64 backend of t27, passes with runtime checks 380 of the 723 specs its reference path passes (52.6%), 661 with the vacuous ones (91.4%). By coverage it is third of three backends with published numbers, by speed of growth and by automation it is first, by depth of checking it is last. The post says what each issue fixes, and it is updated as the lab moves.";
pub const DATE_ISO: str = "2026-10-05";
pub const TAGS: [3]str = ["t27", "Compiler", "Measurement"];

pub const RECEIPT_LABEL: [12]str = [
    "The t27b lab, latest run (master 682564f48, finished 2026-10-05 15:01Z)",
    "The lab's run index: every run since 2026-10-04",
    "t27#6063: epic, t27b runs the whole corpus",
    "t27#6441: per-test reference differential",
    "t27#6442: source-level differential fuzzer",
    "t27#6443: the lab image is stale, its poll is 30 min",
    "t27#6444: native arm64 CI per PR",
    "t27#6445: automatic reducer",
    "t27#6446: gen emits code for specs typecheck refuses",
    "Zig 0.10.0 release notes: per-backend pass rates",
    "Zig devlog 2025: x86_64 1987 vs LLVM 1980 of 2084; aarch64 1547 of 1960",
    "Go bisect (Russ Cox): how Go hunted SSA backend bugs",
];
pub const RECEIPT_HREF: [12]str = [
    "https://t27b-lab-production.up.railway.app/latest.json",
    "https://t27b-lab-production.up.railway.app/runs/index.json",
    "https://github.com/gHashTag/t27/issues/6063",
    "https://github.com/gHashTag/t27/issues/6441",
    "https://github.com/gHashTag/t27/issues/6442",
    "https://github.com/gHashTag/t27/issues/6443",
    "https://github.com/gHashTag/t27/issues/6444",
    "https://github.com/gHashTag/t27/issues/6445",
    "https://github.com/gHashTag/t27/issues/6446",
    "https://ziglang.org/download/0.10.0/release-notes.html",
    "https://ziglang.org/devlog/2025/",
    "https://research.swtch.com/bisect",
];

pub const OPEN_QUESTIONS: [4]str = [
    "Our 723 specs and Zig's 1960 or 2084 behavior tests are different suites. The ranking by coverage says where each backend is on its own path, not which is better.",
    "The comparison with the reference is per file, not per test (t27#6441), and the lab's mismatch 0 compares the JIT with an interpreter over the same IR, not with the reference.",
    "The lab runs t27b under qemu on x86, not on native arm64 (t27#6444).",
    "The 281 vacuous specs need tests in the specs themselves; until then they prove only that t27b compiles them.",
];

; Headline paragraphs 1 and 2 (index 0 and 1) and the Updates log at the end
; carry the numbers; step 4 above rewrites them.
pub const body: [24]PostBlock = [
    PostBlock { kind: "p", text: "[measured] On 2026-10-05 the t27b lab measured master 682564f48. The reference path, t27c gen-zig plus zig test, passes 723 of 1260 specs. t27b passes 380 of those 723 with at least one runtime check (52.6%), and 661 if the 281 passes that run no test are counted (91.4%). 62 are still blocked. t27b passes no spec the reference fails; its 8 failures and 2 timeouts are all in specs the reference does not pass." },
    PostBlock { kind: "p", text: "[measured] The first lab run with reference numbers, 2026-10-04 15:09Z, printed 47 passes of 646. 26 of the 47 ran no test or invariant; that lab did not count them apart yet. Checked against checked, the count went from 21 to 380 in about 24 hours." },
    PostBlock { kind: "h", text: "What t27b is measured against" },
    PostBlock { kind: "p", text: "t27b is the native AArch64 JIT backend of t27, with no LLVM. Its reference is the long path: t27c prints Zig, and Zig compiles it through LLVM. The denominator is only the specs that path passes, so a spec the reference itself cannot run never counts for or against t27b. A pass that ran no test, invariant or assert is pass_vacuous and is reported apart: it proves that t27b compiled the spec, not that the code is right." },
    PostBlock { kind: "h", text: "Where we stand: four rankings" },
    PostBlock { kind: "p", text: "The suites differ, so the percentages below are not the same quantity. Ours is 723 t27 specs; Zig's are its own behavior tests. Each number says where one backend is on its own road." },
    PostBlock { kind: "p", text: "By coverage we are 3rd of 3 with published numbers. 1st: Zig's self-hosted x86_64 backend, about 100% (1987 tests passed against LLVM's 1980, of 2084, devlog 2025-06). 2nd: Zig's self-hosted aarch64 backend, 79% (1547 of 1960, devlog 2025-07). 3rd: t27b, 52.6% checked, 91.4% with the vacuous passes." },
    PostBlock { kind: "p", text: "By speed of growth we are 1st. t27b went from 21 to 380 checked specs in about a day; Zig's backends took years, from 41% and 64% in 0.10.0 (2022) to the 2025 numbers." },
    PostBlock { kind: "p", text: "By automation we are 1st. tri t27b next picks the next lane from the lab's blocker grid with a rule written in t27, a steward loop merges green pull requests, and the lab's results are public JSON. We found no such loop published by Zig, rustc_codegen_cranelift, Go's SSA backend or QBE." },
    PostBlock { kind: "p", text: "By depth of checking we are last. The others compare with their reference per test; Go hunted its SSA bugs with hash bisection, QBE and cg_clif fuzz the ABI. t27b compares per file, has no fuzzer and no reducer, and its CI runs under qemu, not on arm64." },
    PostBlock { kind: "h", text: "What stands between t27b and 100%" },
    PostBlock { kind: "p", text: "The 62 blocked specs, by the first construct t27b refuses in each: a tuple type 16, f32 7, undefined 5, a std call 3, a method call 3, an assignment to an undeclared name 3, and a tail of ones and twos. The tuple and f32 lanes are open; tri t27b next ranks the rest." },
    PostBlock { kind: "p", text: "The 281 vacuous passes need tests in the specs themselves. That is bee work, spec by spec, and it raises the checked count without touching t27b." },
    PostBlock { kind: "h", text: "How we get faster" },
    PostBlock { kind: "p", text: "t27#6441: compare each test with the reference, not each file, so a wrong value in one test of a passing file shows up." },
    PostBlock { kind: "p", text: "t27#6442: a source-level fuzzer against t27c gen-zig, so bugs are found by generated programs and not only by the corpus." },
    PostBlock { kind: "p", text: "t27#6445: a reducer that shrinks a blocked or disagreeing spec to the few lines that matter, so a lane starts from a small case." },
    PostBlock { kind: "p", text: "t27#6444: native arm64 CI on every pull request, off the Mac and off qemu." },
    PostBlock { kind: "p", text: "t27#6443: a fresh lab image with the ratchet step and a shorter poll than 30 minutes, so a merged lane shows up sooner." },
    PostBlock { kind: "p", text: "t27#6446: gen refuses what typecheck refuses, so a misread spec cannot stay green on the reference side." },
    PostBlock { kind: "h", text: "Updates" },
    PostBlock { kind: "p", text: "Newest last. Each entry is one lab run on master, the day its checked count moved; the source is specs/blog/t27b_progress.t27 in gHashTag/t27." },
    PostBlock { kind: "p", text: "2026-10-04, lab f59fd7685 (the lab's branch): 21 checked of 646, 26 vacuous, 599 blocked. Printed then as 47 passes." },
    PostBlock { kind: "p", text: "2026-10-05, lab 682564f48: 380 checked of 723 (52.6%), 281 vacuous (91.4% with them), 62 blocked." },
];

test checked_never_exceeds_reference {
    var i: u32 = 0;
    while (i < ENTRIES) {
        assert(CHECKED[i] <= REFERENCE[i]);
        assert(CHECKED[i] + VACUOUS[i] + BLOCKED[i] <= REFERENCE[i]);
        i = i + 1;
    }
}

test entries_in_date_order {
    var i: u32 = 1;
    while (i < ENTRIES) {
        assert(DATE[i - 1] < DATE[i]);
        i = i + 1;
    }
}

; The rule of --append: an entry is written only when CHECKED moved.
test the_newest_entry_moved {
    assert(CHECKED[ENTRIES - 1] != CHECKED[ENTRIES - 2]);
}

test the_post_shows_the_newest_entry {
    assert_eq(SHOWN_DATE, DATE[ENTRIES - 1]);
    assert_eq(SHOWN_REFERENCE, REFERENCE[ENTRIES - 1]);
    assert_eq(SHOWN_CHECKED, CHECKED[ENTRIES - 1]);
    assert_eq(SHOWN_VACUOUS, VACUOUS[ENTRIES - 1]);
    assert_eq(SHOWN_BLOCKED, BLOCKED[ENTRIES - 1]);
}

test the_shown_percentages_are_the_shown_counts {
    assert_eq(SHOWN_CHECKED_PCT_TENTHS, (SHOWN_CHECKED * 1000 + SHOWN_REFERENCE / 2) / SHOWN_REFERENCE);
    assert_eq(SHOWN_ANY_PCT_TENTHS, ((SHOWN_CHECKED + SHOWN_VACUOUS) * 1000 + SHOWN_REFERENCE / 2) / SHOWN_REFERENCE);
}
