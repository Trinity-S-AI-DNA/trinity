// SPDX-License-Identifier: Apache-2.0
; bench_coverage.t27 -- declares the set of specs the L3 bench test-reports and validates the rule
; This spec replaces hardcoded spec names in .github/workflows/xilinx7-l3-bench.yml, so the bench
; runs t27c test-report on all four xilinx7 specs with tests: packets, frames, far, flow.
; Measurement context: Issue gHashTag/t27#6351 shows 35 tests pass across packets, frames, far;
; adding these to the bench costs about 1.7 s extra on ubuntu-latest (cold cache) and requires
; the owner's label to edit the workflow that reads this rule.
; FR-001: declares the set of specs the L3 bench test-reports (packets, frames, far, flow)
; FR-003: cites measurement and workflow edit requirement
; ----
; Driver: bench should read this spec instead of hardcoding flow.t27 alone

module xilinx7_bench_coverage;

; The set of specs with test blocks that the L3 bench should test-report
const BENCH_SPEC_STEMS : [4]str = [
    "packets",
    "frames", 
    "far",
    "flow"
];

; Returns true if a spec stem should be test-reported by the L3 bench
pub fn bench_tests(stem: string) bool {
    for (spec_stem in BENCH_SPEC_STEMS) {
        if (stem == spec_stem) {
            return true;
        }
    }
    return false;
}

; Tests that validate the bench coverage rule
test bench_coverage_includes_all_four_specs {
    assert bench_tests("packets") == true;
    assert bench_tests("frames") == true;
    assert bench_tests("far") == true;
    assert bench_tests("flow") == true;
}

test bench_coverage_excludes_others {
    assert bench_tests("unknown") == false;
    assert bench_tests("other") == false;
    assert bench_tests("random") == false;
}

test bench_coverage_matches_issue_requirement {
    const expected_count : u64 = 4;
    var actual_count : u64 = 0;
    
    for (_ in BENCH_SPEC_STEMS) {
        actual_count = actual_count + 1;
    }
    
    assert actual_count == expected_count;
}