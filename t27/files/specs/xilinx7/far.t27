    42, 30, 36, 36, 36, 36, 28, 36, 36, 28, 36, 36, 36, 36, 28, 36, 36, 28, 36, 36, 36, 36, 36, 36, 30, 36, 36, 36, 28, 36, 36, 28, 36, 36, 36, 36, 36, 36, 36, 36, 28, 36, 36, 28, 36, 36, 36, 36, 28, 36, 36, 28, 36, 36, 36, 30, 36, 36, 28, 36, 36, 28, 36, 36, 36, 36, 28, 36, 36, 28, 36, 36, 36, 36, 36, 36, 36, 36, 36, 36, 36, 36, 36, 36, 36, 36, 36, 36, 28, 36, 36, 28, 36, 36, 36, 36, 28, 36, 36, 28, 36, 36, 36, 36, 30, 42,
    128, 128, 128, 128, 128, 128, 128, 128, 128,
