// ---- END part table ----

pub const NO_GROUP : u32 = 0xFFFFFFFF;

// The part whose IDCODE a bitstream writes, or PARTS if the table has none.
pub fn part_of_idcode(id: u32) u32 {
    var p : u32 = 0;
    while p < PARTS {
        const hit = PART_IDCODE[p] == id;
        if (hit) {
            return p;
        }
        p = p + 1;
    }
    return PARTS;
}

// Index into GROUP_KEY of part p's first group.
pub fn first_group(p: u32) u32 {
    var k : u32 = 0;
    var n : u32 = 0;
    while k < p {
        n = n + PART_GROUPS[k];
        k = k + 1;
    }
    return n;
}

// Index into COL_FRAMES of group g's first column.
pub fn first_column(g: u32) u32 {
    var k : u32 = 0;
    var n : u32 = 0;
    while k < g {
        n = n + GROUP_COLS[k];
        k = k + 1;
    }
    return n;
}

// Frames group g carries, pads excluded, counted by walking it with far_next_in_row.
pub fn group_frames(g: u32) u32 {
    const first = first_column(g);
    const cols = GROUP_COLS[g];
    var a : u32 = group_start(GROUP_KEY[g]);
    var n : u32 = 0;
    while a != NO_FRAME {
        n = n + 1;
        a = far_next_in_row(a, COL_FRAMES[first + far_column(a)], cols);
    }
    return n;
}

// Frames of an FDRI write that starts at FAR 0 and covers all of part p, pads included.
pub fn part_fdri_frames(p: u32) u32 {
    const g0 = first_group(p);
    var g : u32 = g0;
    var n : u32 = 0;
    while g < g0 + PART_GROUPS[p] {
        n = n + group_frames(g) + ROW_PAD_FRAMES;
        g = g + 1;
    }
    return n;
}

// The group of part p holding address a, or NO_GROUP if p has none.
pub fn group_index(p: u32, a: u32) u32 {
    const g0 = first_group(p);
    var g : u32 = g0;
    while g < g0 + PART_GROUPS[p] {
        const hit = GROUP_KEY[g] == far_group(a);
        if (hit) {
            return g;
        }
        g = g + 1;
    }
    return NO_GROUP;
}

// Position of address a in an FDRI write that starts at FAR 0 and covers all of part p, or
// NO_FRAME if a is not a valid address of p.
pub fn fdri_index(p: u32, a: u32) u32 {
    const g = group_index(p, a);
    const no_group = g == NO_GROUP;
    if (no_group) {
        return NO_FRAME;
    }
    const first = first_column(g);
    const col = far_column(a);
    const no_column = col >= GROUP_COLS[g];
    if (no_column) {
        return NO_FRAME;
    }
    const no_minor = far_minor(a) >= COL_FRAMES[first + col];
    if (no_minor) {
        return NO_FRAME;
    }
    var n : u32 = 0;
    var k : u32 = first_group(p);
    while k < g {
        n = n + group_frames(k) + ROW_PAD_FRAMES;
        k = k + 1;
    }
    var c : u32 = 0;
    while c < col {
        n = n + COL_FRAMES[first + c];
        c = c + 1;
    }
    return n + far_minor(a);
}

// ============================================================================
// Tests
// ============================================================================

test far_round_trip {
    const a = far(BLOCK_BLOCK_RAM, 1, 3, 42, 127);
    assert far_block(a) == BLOCK_BLOCK_RAM;
    assert far_bottom(a) == 1;
    assert far_row(a) == 3;
    assert far_column(a) == 42;
    assert far_minor(a) == 127;
}

test next_steps_minor_then_column_then_stops {
    assert far_next_in_row(far(0, 0, 0, 0, 40), 42, 44) == far(0, 0, 0, 0, 41);
    assert far_next_in_row(far(0, 0, 0, 0, 41), 42, 44) == far(0, 0, 0, 1, 0);
    assert far_next_in_row(far(0, 1, 0, 43, 41), 42, 44) == NO_FRAME;
}

; Within each part, group keys rise strictly: that is the walk order.
test groups_are_in_increasing_address_order {
    var p : u32 = 0;
    var rising : u32 = 0;
    var pairs : u32 = 0;
    while p < PARTS {
        const g0 = first_group(p);
        var g : u32 = g0 + 1;
        while g < g0 + PART_GROUPS[p] {
            pairs = pairs + 1;
            const up = GROUP_KEY[g - 1] < GROUP_KEY[g];
            if (up) {
                rising = rising + 1;
            }
            g = g + 1;
        }
        p = p + 1;
    }
    assert pairs == 21;
    assert rising == pairs;
}

; Every one of the six Vivado xc7a35t bitstreams (vivado/vendor/A_direct_top.bit,
; B_idelay_top.bit, prjxray-db harness arty-a7/{swbut,uart,pmod}, basys3/swbut) writes FDRI in
; one packet of 547,420 words = 5420 frames. The part table alone sums to 5408; the walk must
; put the other 12 where Vivado put them.
test walk_covers_vivado_fdri_write {
    assert part_fdri_frames(XC7A35T) == 5420;
}

; The larger parts have no Vivado reference here. xc7a100t: hb.bit (xc7frames2bit, openXC7) writes
; FDRI as 9464 frames = 9448 + 8 groups x 2 pads; that is agreement with prjxray, not evidence.
; xc7a200t: 24060 + 10 x 2, from part.json alone.
test walk_sizes_of_the_larger_parts {
    assert part_fdri_frames(XC7A100T) == 9464;
    assert part_fdri_frames(XC7A200T) == 24080;
}

// For every part, the first address of each group sits two pads after the previous group's last
// address, and the last address of the last group sits two pads before the end of the write.
// Self-consistency only: it ties fdri_index to part_fdri_frames, it is not device evidence.
test every_part_index_meets_its_walk {
    var p : u32 = 0;
    var checked : u32 = 0;
    while p < PARTS {
        const g0 = first_group(p);
        var g : u32 = g0;
        var expect : u32 = 0;
        while g < g0 + PART_GROUPS[p] {
            const head = group_start(GROUP_KEY[g]);
            assert fdri_index(p, head) == expect;
            const cols = GROUP_COLS[g];
            const last_col = cols - 1;
            const last_minor = COL_FRAMES[first_column(g) + last_col] - 1;
            const tail = head + (last_col << 7) + last_minor;
            expect = expect + group_frames(g);
            assert fdri_index(p, tail) == expect - 1;
            expect = expect + ROW_PAD_FRAMES;
            checked = checked + 1;
            g = g + 1;
        }
        assert expect == part_fdri_frames(p);
        p = p + 1;
    }
    assert checked == 24;
}

test idcode_names_the_part {
    assert part_of_idcode(0x0362D093) == XC7A35T;
    assert part_of_idcode(0x03631093) == XC7A100T;
    assert part_of_idcode(0x03636093) == XC7A200T;
    assert part_of_idcode(0x0362C093) == PARTS;
}

; A_direct_top.bit constrains its clock to pin E3, which is RIOB33_X43Y75: tilegrid base
; 0x00001580 (CLB_IO_CLK, top, row 0, column 43), words 51..54. In Vivado's stream the frames
; with data in those words are 1519, 1528 and 1529 and no frame next to them -- 1528 is the
; frame frames.t27 checks its ECC on. Pin A8 is LIOB33_X0Y125: base 0x00020000 (row 1,
; column 0), words 51..54; Vivado's first frame with data there is 1534. Frames 1532 and 1533,
; between the two rows, are zero in all six files.
test vivado_pins_land_in_their_tiles {
    assert fdri_index(XC7A35T, 0x00001580) == 1490;
    assert fdri_index(XC7A35T, 0x00001580 + 29) == 1519;
    assert fdri_index(XC7A35T, 0x00001580 + 38) == 1528;
    assert fdri_index(XC7A35T, 0x00001580 + 41) == 1531;
    assert fdri_index(XC7A35T, 0x00020000) == 1534;
}

test invalid_addresses_have_no_frame {
    assert fdri_index(XC7A35T, far(0, 0, 0, 44, 0)) == NO_FRAME;
    assert fdri_index(XC7A35T, far(0, 0, 0, 0, 42)) == NO_FRAME;
    assert fdri_index(XC7A35T, far(0, 1, 1, 0, 0)) == NO_FRAME;
    assert fdri_index(XC7A35T, far(BLOCK_CFG_CLB, 0, 0, 0, 0)) == NO_FRAME;
}
