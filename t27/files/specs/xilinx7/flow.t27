// SPDX-License-Identifier: Apache-2.0
; flow.t27 -- the arithmetic of the FPGA flow table on t27.ai/#/devkit: how long each layer
; takes, what replacing one layer saves, the most a further rewrite could save, and when one
; tool may be called faster than another. Times are integer milliseconds of wall clock.
; Ratios are kept in thousandths (1400 = 1.40x), shares in thousandths of the whole flow
; (600 = 60.0 %), hours in tenths.
; ----
; SOURCE: gHashTag/trinity apps/website/src/data/devkit.ts (flowBefore, flowAfter, ceiling,
; hoursPerYear, WORKING_DAYS) at the page of 2026-10-03; this spec is the rule those
; functions implement, with the rounding written down.
; ORACLE: the page's own numbers (tests below) and the timings in conformance/xilinx7_flow.json,
; replayed by `bitwalk --flow` (bitwalk.rs beside this file). Issue gHashTag/t27#6068.
; ----
; Driver: bitwalk.rs beside this file.
;   t27c gen-rust specs/xilinx7/flow.t27 > specs/xilinx7/flow.rs

module xilinx7_flow;

pub const WORKING_DAYS : u64 = 230;
pub const MS_PER_TENTH_HOUR : u64 = 360000;

pub const VERDICT_TIE : u32 = 0;
pub const VERDICT_FASTER : u32 = 1;
pub const VERDICT_SLOWER : u32 = 2;

// ============================================================================
// One tool, N runs. The table quotes the best run of each tool, and the same N for every tool:
// the devkit page of 2026-10-03 quoted one openXC7 run against the best of three t27 runs.
// ============================================================================

pub fn best(prev: u64, run: u64) u64 {
    const lower = run < prev;
    if (lower) {
        return run;
    }
    return prev;
}

pub fn worst(prev: u64, run: u64) u64 {
    const higher = run > prev;
    if (higher) {
        return run;
    }
    return prev;
}

// A rewrite is faster only if its slowest run beats the old tool's fastest run, and slower
// only if its fastest run loses to the old tool's slowest. Overlapping ranges are a tie: on a
// shared machine wall time moves by more than a sub-second layer's difference (the 8-11 s
// first recorded for gf16_heartbeat_top was a loaded machine, docs/now 2026-10-03).
pub fn verdict(old_best: u64, old_worst: u64, new_best: u64, new_worst: u64) u32 {
    const faster = new_worst < old_best;
    if (faster) {
        return VERDICT_FASTER;
    }
    const slower = new_best > old_worst;
    if (slower) {
        return VERDICT_SLOWER;
    }
    return VERDICT_TIE;
}

// ============================================================================
// The whole flow.
// ============================================================================

// The flow with one layer's time replaced by its rewrite's.
pub fn replaced(flow: u64, old_layer: u64, new_layer: u64) u64 {
    return flow - old_layer + new_layer;
}

pub fn saved(before: u64, after: u64) u64 {
    const gained = after < before;
    if (gained) {
        return before - after;
    }
    return 0;
}

// before / after in thousandths, rounded half up.
pub fn speedup_milli(before: u64, after: u64) u64 {
    return (before * 1000 + after / 2) / after;
}

// A layer's part of the flow in thousandths, rounded half up.
pub fn share_milli(layer: u64, flow: u64) u64 {
    return (layer * 1000 + flow / 2) / flow;
}

// Amdahl: the flow if one more layer took no time at all. A rewrite of that layer cannot beat
// it, so the page calls it a ceiling, not a result.
pub fn ceiling(after: u64, layer: u64) u64 {
    return after - layer;
}

pub fn ceiling_speedup_milli(before: u64, after: u64, layer: u64) u64 {
    return speedup_milli(before, ceiling(after, layer));
}

// Waiting removed in a year, in tenths of an hour, rounded half up. Builds a day and people are
// the reader's inputs, not measurements.
pub fn tenth_hours_per_year(saved_ms: u64, builds_per_day: u64, people: u64) u64 {
    const total = saved_ms * builds_per_day * WORKING_DAYS * people;
    return (total + MS_PER_TENTH_HOUR / 2) / MS_PER_TENTH_HOUR;
}

// ============================================================================
// Tests
// ============================================================================

; The build of 2026-10-03 on the page: trinet_node_v2_ax7203, L1 yosys 12.69 s, L2
; nextpnr-xilinx 70.09 s, L3 fasm2frames 33.86 s -> bitwalk 0.42 s, L4 xc7frames2bit 0.22 s ->
; bitwalk 0.25 s. The page prints 116.86 s -> 83.45 s, 1.40x.
test page_flow_of_2026_10_03 {
    assert 12690 + 70090 + 33860 + 220 == 116860;
    assert replaced(replaced(116860, 33860, 420), 220, 250) == 83450;
    assert saved(116860, 83450) == 33410;
    assert speedup_milli(116860, 83450) == 1400;
}

; Half up, not down: 2/3 is 0.667x, and 1/8 is 0.125x exactly.
test speedup_rounds_half_up {
    assert speedup_milli(2, 3) == 667;
    assert speedup_milli(1, 8) == 125;
    assert share_milli(1, 3) == 333;
}

test page_shares {
    assert share_milli(12690, 116860) == 109;
    assert share_milli(70090, 116860) == 600;
    assert share_milli(33860, 116860) == 290;
    assert share_milli(220, 116860) == 2;
}

; "If L1 synthesis took 0 s: flow 116.9 s -> 70.8 s (1.65x)"; "If L2 place & route took 0 s:
; flow 116.9 s -> 13.4 s (8.75x)". The ceiling starts from the flow WITH the rewrites done.
test page_ceilings {
    assert ceiling(83450, 12690) == 70760;
    assert ceiling_speedup_milli(116860, 83450, 12690) == 1651;
    assert ceiling(83450, 70090) == 13360;
    assert ceiling_speedup_milli(116860, 83450, 70090) == 8747;
}

; "42.7 h / year ... at the measured 33.4 s per build": the page's defaults are 20 builds a
; day and one person.
test page_hours {
    assert tenth_hours_per_year(33410, 20, 1) == 427;
    assert tenth_hours_per_year(0, 20, 1) == 0;
    assert tenth_hours_per_year(1800, 1, 1) == 1;
}

test saved_is_never_negative {
    assert saved(220, 250) == 0;
    assert saved(250, 220) == 30;
}

test best_and_worst_fold_runs {
    assert best(best(best(999999999, 420), 390), 455) == 390;
    assert worst(worst(worst(0, 420), 390), 455) == 455;
}

; L4 on the page: 0.22 s against 0.25 s, called a tie. With ranges it is a tie while the
; ranges overlap, and a loss only when the rewrite's best run is slower than every old run.
test verdict_needs_ranges_apart {
    assert verdict(33100, 34900, 390, 455) == VERDICT_FASTER;
    assert verdict(210, 260, 240, 270) == VERDICT_TIE;
    assert verdict(210, 230, 240, 270) == VERDICT_SLOWER;
    assert verdict(220, 220, 220, 220) == VERDICT_TIE;
    assert verdict(210, 260, 200, 240) == VERDICT_TIE;
    assert verdict(210, 260, 240, 300) == VERDICT_TIE;
}
