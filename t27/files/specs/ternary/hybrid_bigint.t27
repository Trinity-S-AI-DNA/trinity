    const iterations = 10000;
    var a = hybrid_from_i64(123456789);
    var b = hybrid_from_i64(987654321);

    for _ in 0..iterations {
        _ = hybrid_add_simd(&a, &b);
    }
}

bench "hybrid_bigint_sub" {
    const iterations = 10000;
