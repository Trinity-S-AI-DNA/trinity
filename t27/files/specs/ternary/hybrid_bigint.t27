    var b = hybrid_from_i64(123456789);

    for _ in 0..iterations {
        _ = hybrid_sub(&a, &b);
    }
}

bench "hybrid_bigint_mul" {
    const iterations = 1000;
    var a = hybrid_from_i64(12345);
    var b = hybrid_from_i64(6789);

    for _ in 0..iterations {
        _ = hybrid_mul(&a, &b);
    }
}

bench "hybrid_bigint_dot_product" {
    const iterations = 10000;
    var a = hybrid_from_i64(123456789);
    var b = hybrid_from_i64(987654321);

    for _ in 0..iterations {
        _ = hybrid_dot_product(&a, &b);
    }
}

bench "hybrid_bigint_pack" {
    const iterations = 10000;
    var h = hybrid_from_i64(123456789);

    for _ in 0..iterations {
        hybrid_pack(&h);
    }
}

bench "hybrid_bigint_ensure_unpacked" {
    const iterations = 10000;
    var h = hybrid_zero();

    for _ in 0..iterations {
        hybrid_ensure_unpacked(&h);
    }
}

bench "hybrid_bigint_negate" {
    const iterations = 10000;
    var h = hybrid_from_i64(123456789);

    for _ in 0..iterations {
        _ = hybrid_negate(&h);
    }
}

bench "simd_add_performance" {
    const iterations = 100000;
    const a: Vec32 = [1; SIMD_WIDTH];
    const b: Vec32 = [1; SIMD_WIDTH];

    for _ in 0..iterations {
        _ = simd_add(a, b);
    }
}

bench "simd_dot_product_performance" {
    const iterations = 100000;
    const a: Vec32 = [1; SIMD_WIDTH];
    const b: Vec32 = [1; SIMD_WIDTH];

    for _ in 0..iterations {
        _ = simd_dot_product(a, b);
    }
}
