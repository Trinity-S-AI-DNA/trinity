module GftMagsubTie;
// #5169: Rounding tie rules for magnitude addition and subtraction in GF-T16.
// 
// In _magsub, the `if sticky: mant += 1` arm is incorrect for subtraction.
// Discarded bits of the subtrahend make the true difference smaller than the
// computed one, so at a tie the true remainder sits strictly below half and 
// must round down. This spec states the correct rules once, as pure helpers
// with tests, next to the mirrored addition rule.
//
// Measurement over 525,918 points (ho in {2, 3, 40, 79}, hm and lm swept, 
// d in 0..30) finds no input where `rem == half` and `sticky == 1` hold 
// together. The arm is wired but never fires with the correct value.

fn sub_tie_rounds_up(sticky: i32, q: i32) -> bool {
    // In subtraction: when sticky == 1, round down (false). Otherwise round to even.
    if (sticky == 1) { return false; } else { return (q & 1) == 1; }
}

fn add_tie_rounds_up(sticky: i32, q: i32) -> bool {
    // In addition: when sticky == 1, round up (true). Otherwise round to even.
    if (sticky == 1) { return true; } else { return (q & 1) == 1; }
}

// Test the subtraction tie rule: sticky=1 should round down, sticky=0 should round to even
test sub_tie_sticky_rounds_down { assert_eq(sub_tie_rounds_up(1, 0), false); }
test sub_tie_sticky_rounds_down_odd { assert_eq(sub_tie_rounds_up(1, 1), false); }
test sub_tie_rounds_to_even_even { assert_eq(sub_tie_rounds_up(0, 0), false); }
test sub_tie_rounds_to_even_odd { assert_eq(sub_tie_rounds_up(0, 1), true); }

// Test the addition tie rule: sticky=1 should round up, sticky=0 should round to even
test add_tie_sticky_rounds_up { assert_eq(add_tie_rounds_up(1, 0), true); }
test add_tie_sticky_rounds_up_odd { assert_eq(add_tie_rounds_up(1, 1), true); }
test add_tie_rounds_to_even_even { assert_eq(add_tie_rounds_up(0, 0), false); }
test add_tie_rounds_to_even_odd { assert_eq(add_tie_rounds_up(0, 1), true); }

endmodule