/**
 * Sandbox Modules Registry
 *
 * Defines all sandbox-related business logic modules
 * that can be referenced by specs and used by the compiler.
 */

module sandbox.modules;

use sandbox.session_timeout;

// ─────────────────────────────────────────────
// Session Timeout Module
// ─────────────────────────────────────────────

// The original line here was `pub use session_timeout;`, a Rust-style
// re-export of the sandbox.session_timeout module to users of this registry.
// t27 has no `pub use` and no re-export of any kind, so that intent cannot be
// expressed and is LOST in the port; the line is kept below as a comment.
// The module itself is still imported by `use sandbox.session_timeout;` above.
// (A bare `use session_timeout;` would name no module -- the module is called
// `sandbox.session_timeout` -- and generates only a "no references" note.)
// pub use session_timeout;

// L4 requires at least one test/invariant/bench per spec. This registry has
// no computation of its own -- its whole content is the imports above -- so
// the invariant states only that. (Added during the syntax port: the
// original file had no test block.)
invariant sandbox_modules_registry_is_imports_only {
    assert true;
}
