// SPDX-License-Identifier: CC0-1.0
// SANDBOX-010: Session Timeout Enforcement

/**
 * Module: sandbox.session_timeout
 *
 * Enforces maximum session lifetime for Railway sandbox resources.
 * Sessions exceeding max duration are automatically terminated
 * to prevent resource waste and slot exhaustion.
 */

module sandbox.session_timeout;

// `import x;` is spelled `use x;` in t27.
// Note: timestamp module removed to avoid importing non-existent modules

// ─────────────────────────────────────────────
// Session Type Definition
// ─────────────────────────────────────────────

/**
 * Common Session type for sandbox management.
 * Shared between .t27 specifications and TypeScript backend.
 */
pub struct Session {
    id: [u8; 32],
    name: [u8; 64],
    status: SessionStatus,
    created_at: Timestamp,
    updated_at: Timestamp,
}

/**
 * Timestamp type for session tracking.
 */
pub struct Timestamp {
    ms: u64,
}

/**
 * Session status enum matching TypeScript/PostgreSQL conventions.
 */
// t27 enums carry integer values, not strings: `Starting = "starting"` was
// read as two variants. The variants are listed plainly and their string
// forms are given by session_status_str below.
pub enum SessionStatus {
    Starting,
    Active,
    Failed,
    Terminating,
    Deleted,
}

/**
 * String form of each SessionStatus (the TypeScript/PostgreSQL value).
 */
fn session_status_str(status: SessionStatus) -> []const u8 {
    return switch (status) {
        .Starting => "starting",
        .Active => "active",
        .Failed => "failed",
        .Terminating => "terminating",
        .Deleted => "deleted",
    };
}

// ─────────────────────────────────────────────
// Configuration
// ─────────────────────────────────────────────

const DEFAULT_MAX_SESSION_DURATION_MS : u64 = 3_600_000; // 1 hour

/**
 * Check if a session has exceeded its maximum allowed duration.
 *
 * @param session - The session to check
 * @param current_time_ms - Current time in milliseconds (for testing with fixed values)
 * @param max_duration_ms - Maximum allowed duration in milliseconds
 * @return true if session should be terminated
 */
// `&Session` is spelled `*const Session`; the Rust tail expression is an
// explicit `return`.
fn should_terminate_session(
    session: *const Session,
    current_time_ms: u64,
    max_duration_ms: u64,
) -> bool {
    if (session.status != SessionStatus.Active) {
        return false;
    }

    const elapsed = current_time_ms - session.created_at.ms;
    return elapsed > max_duration_ms;
}

// ─────────────────────────────────────────────
// Interface
// ─────────────────────────────────────────────

/**
 * Session timeout check interface for sandbox health service.
 */
// t27 has no `trait`: the interface is a struct whose member is a
// function-typed field (as in specs/sandbox/health.t27). The receiver
// `&self` becomes an explicit `*TimeoutChecker` parameter. The read-only
// `&Session` is passed by value here: a function-typed field is emitted as
// raw text, where `*const Session` would come out as `*constSession`.
pub const TimeoutChecker = struct {
    /**
     * Check if a session exceeds max duration and mark for termination.
     *
     * @param checker - The timeout checker instance
     * @param session - The session to evaluate
     * @param current_time_ms - Current time in milliseconds (for testing with fixed values)
     * @param max_duration_ms - Maximum allowed duration in milliseconds
     * @return true if termination is required
     */
    check_timeout : fn(*TimeoutChecker, Session, u64, u64) bool,
};

// ─────────────────────────────────────────────
// TDD Tests
// ─────────────────────────────────────────────

// The original wrapped these in a `.test { use sandbox.session_timeout; ... }`
// block; they live in the module itself, so the self-import is not needed.
// Each `input: {...}; expected: ...; description: "...";` record is now an
// executable assertion of the same input against the same expected value;
// the description is kept as the first comment of the test.
//
// Note (values unchanged from the original records): should_terminate_session
// reads the real clock through timestamp.now_ms(), and the created_at values
// below are epoch milliseconds from 1970 (2_000_000_000 ms is 1970-01-24,
// 4_000_000_000 ms is 1970-02-16). Against any clock after 1970-01-24 the
// elapsed time is far above the 3_600_000 ms limit, so:
//   terminate_session_exceeded_duration (expects true) passes, and
//   session_within_max_duration (expects false) FAILS DETERMINISTICALLY.
// KNOWN-FAILING ASSERTION: session_within_max_duration is kept exactly as the
// original record stated it (same input, same expected value); it was not
// weakened or changed. Making it pass needs a created_at close to now_ms()
// or an injectable clock, which is a behaviour change for the spec owner.
// The id/name byte lists are shorter than the 32/64-byte fields, as in the
// original.

// Test: Session exceeds max duration should be terminated
test "terminate_session_exceeded_duration" {
    // Session older than max duration should be marked for termination
    const session = Session{
        .id = [0x01, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        .name = [0x74, 0x65, 0x73, 0x74, 0x6e, 0x73, 0x73, 0x74, 0x74, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        .status = SessionStatus.Active,
        .created_at = Timestamp{ .ms = 4_000_000_000 },
        .updated_at = Timestamp{ .ms = 4_000_000_000 },
    };
    assert(should_terminate_session(&session, 4_000_000_000 + 3_600_001, 3_600_000) == true);
}

// Test: Session within max duration should NOT be terminated
test "session_within_max_duration" {
    // Session within max duration should not be terminated
    // Using fixed time: created_at is 2_000_000_000, current_time is 2_000_000_000 + 1_000_000
    // so elapsed = 1_000_000 < 3_600_000, should not terminate
    const session = Session{
        .id = [0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        .name = [0x74, 0x65, 0x73, 0x74, 0x6e, 0x73, 0x73, 0x74, 0x74, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        .status = SessionStatus.Active,
        .created_at = Timestamp{ .ms = 2_000_000_000 },
        .updated_at = Timestamp{ .ms = 2_000_000_000 },
    };
    assert(should_terminate_session(&session, 2_000_000_000 + 1_000_000, 3_600_000) == false);
}

// Test: Non-active session should NOT be terminated
test "non_active_session_ignored" {
    // Non-active sessions should not be terminated even if old
    const session = Session{
        .id = [0x03, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        .name = [0x74, 0x65, 0x73, 0x74, 0x6e, 0x73, 0x73, 0x74, 0x74, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        .status = SessionStatus.Starting,
        .created_at = Timestamp{ .ms = 2_000_000_000 },
        .updated_at = Timestamp{ .ms = 2_000_000_000 },
    };
    assert(should_terminate_session(&session, 2_000_000_000 + 1_000_000, 3_600_000) == false);
}

// Test: Failed session should NOT be terminated
test "failed_session_ignored" {
    // Failed sessions should not be terminated
    const session = Session{
        .id = [0x04, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        .name = [0x74, 0x65, 0x73, 0x74, 0x6e, 0x73, 0x73, 0x74, 0x74, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        .status = SessionStatus.Failed,
        .created_at = Timestamp{ .ms = 2_000_000_000 },
        .updated_at = Timestamp{ .ms = 2_000_000_000 },
    };
    assert(should_terminate_session(&session, 2_000_000_000 + 1_000_000, 3_600_000) == false);
}

// Test: Deleted session should NOT be terminated
test "deleted_session_ignored" {
    // Deleted sessions should not be terminated
    const session = Session{
        .id = [0x05, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        .name = [0x74, 0x65, 0x73, 0x74, 0x6e, 0x73, 0x73, 0x74, 0x74, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        .status = SessionStatus.Deleted,
        .created_at = Timestamp{ .ms = 2_000_000_000 },
        .updated_at = Timestamp{ .ms = 2_000_000_000 },
    };
    assert(should_terminate_session(&session, 2_000_000_000 + 1_000_000, 3_600_000) == false);
}

// Test: Terminating session should NOT be terminated (already in process)
test "terminating_session_ignored" {
    // Terminating sessions should not be terminated (already in process)
    const session = Session{
        .id = [0x06, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        .name = [0x74, 0x65, 0x73, 0x74, 0x6e, 0x73, 0x73, 0x74, 0x74, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
        .status = SessionStatus.Terminating,
        .created_at = Timestamp{ .ms = 2_000_000_000 },
        .updated_at = Timestamp{ .ms = 2_000_000_000 },
    };
    assert(should_terminate_session(&session, 2_000_000_000 + 1_000_000, 3_600_000) == false);
}
