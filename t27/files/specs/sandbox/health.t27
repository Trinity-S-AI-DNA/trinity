// SPDX-License-Identifier: CC0-1.0
// SANDBOX-010 + SANDBOX-011: Sandbox Health Management

/**
 * Module: sandbox.health
 *
 * Consolidates sandbox health polling operations:
 * - Health check (existing)
 * - Session timeout enforcement
 * - Orphaned session detection
 */

module sandbox.health;

use sandbox.session_timeout;

// ─────────────────────────────────────────────
// Configuration
// ─────────────────────────────────────────────

const DEFAULT_POLL_INTERVAL_MS : usize = 10_000; // 10 seconds between health checks

// ─────────────────────────────────────────────
// Interface
// ─────────────────────────────────────────────

/**
 * Sandbox health polling interface.
 */
// t27 has no `trait`: the interface is expressed the way other specs express
// one (see specs/server/sse.t27) -- a struct whose member is a function-typed
// field. An implementation supplies `poll_sessions`; the receiver `&self`
// becomes an explicit `*HealthPoller` parameter.
pub const HealthPoller = struct {
    /**
     * Poll all sessions and update status based on health and timeouts.
     *
     * @return true if polling completed
     */
    poll_sessions : fn(*HealthPoller) bool,
};

// ---------------------------------------------
// Tests
// ---------------------------------------------

// Added so the spec carries a checkable claim (law L4): the configured poll
// interval is the 10 seconds the constant's comment states.
test "default_poll_interval_is_ten_seconds" {
    assert(DEFAULT_POLL_INTERVAL_MS == 10000);
}
