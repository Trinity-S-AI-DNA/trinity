// SPDX-License-Identifier: Apache-2.0
; specs/i18n/blog-ru.t27 -- translation contract, Russian, for the blog posts in specs/blog
; Specs are English-only (LANG-EN). This module carries no translated word: it
; declares WHICH fields of WHICH post specs a bundle may translate, WHERE that
; bundle lives and HOW it is keyed. The Russian text is in the bundle named below.
; Every t27.ai post has an English and a Russian version; the English is the post
; spec itself (for example specs/blog/t27b_progress.t27), the Russian is the bundle
; entry keyed by that spec's ID.
; phi^2 + 1/phi^2 = 3 | TRINITY

module i18n_blog_ru;

pub const KIND : str = "i18n";
pub const LOCALE : str = "ru";
pub const SOURCE_LOCALE : str = "en";
; Spec directories whose modules this bundle may translate; an entry ID must
; resolve to a spec in one of them.
pub const SCOPE : [1]str = ["specs/blog"];
; Spec fields a bundle entry may carry. TITLE maps to TITLE and SUMMARY to SUMMARY.
; BODY maps to the post's body array as one Markdown string: a block of kind "h"
; is a line starting with "## ", a block of kind "p" is a paragraph, and blocks are
; separated by one blank line. It must have the same number of blocks, of the same
; kinds, in the same order as the English body.
; OPEN_QUESTIONS maps to OPEN_QUESTIONS, one question per line, the same count.
pub const FIELDS : [4]str = ["TITLE", "SUMMARY", "BODY", "OPEN_QUESTIONS"];
pub const BUNDLE_REPO : str = "trinity";
pub const BUNDLE_PATH : str = "apps/website/i18n/blog.ru.json";
pub const BUNDLE_FORMAT : str = "json";
; Bundle entries are keyed by the post spec's ID constant.
pub const KEY : str = "ID";
; What the site shows when an entry or a field has no translation.
pub const FALLBACK : str = "en";
; true: every post has a Russian version, so a post spec with no entry fails the build.
pub const COVERAGE_REQUIRED : bool = true;
; false: a bundle entry whose ID matches no spec in SCOPE fails the build.
pub const ORPHANS_ALLOWED : bool = false;
pub const ENABLED : bool = true;

test the_contract_has_one_scope_and_four_fields {
    assert(SCOPE.len == 1);
    assert(FIELDS.len == 4);
}
