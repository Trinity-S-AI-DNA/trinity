// SPDX-License-Identifier: Apache-2.0
; specs/catalog/discovery.t27 -- how the t27.ai catalog finds the repositories that write .t27
; Source of truth for scripts/discover-t27-worlds.mjs and .github/workflows/t27-world-scan.yml
; (gHashTag/trinity, apps/website). The scan reads this file through the vendored compiler
; (public/t27/t27_compiler.wasm), checks the constant schema and evaluates the test blocks
; below before it touches GitHub; nothing below is parsed with a regex and no owner, limit or
; exclusion is typed twice. ASCII only (L3), English only (LANG-EN).

; WHY (measured 2026-09-12): the catalog behind #/specs and the Queen map held five
; repositories, every one typed into scripts/sync-t27-specs.mjs by hand. The same owner's
; public inventory also held gHashTag/trios with 71 .t27 files, never listed; another owner's
; dmitrii-f-t27/trinity-memory held 37 more. The "+ Repository" dialog saves a map on one
; device only. A list in a script does not scale to two owners, let alone to GitHub.

; WHAT QUALIFIES: a public repository, not a fork, not a build mirror, whose default branch
; holds .t27 files of which one of up to PROBE_FILES probed parses to at least MIN_DECLARATIONS
; declarations (fn, struct, enum, const, type, test, invariant, bench). The compiler accepts
; any text as an empty module, so "it compiles" proves nothing: a licence file named .t27
; compiles too, and GitHub code search returns forty of those.

; WHAT THE SCAN NEVER DOES: read private repositories, write to GitHub, or rewrite the five
; FOUNDING sources. Those come from a local t27 checkout through sync-t27-specs.mjs, and that
; checkout carries the teaching course (specs/tutorial, hello_world) on a branch that is not
; on t27 master yet; a re-vendor from GitHub alone would delete it from the site.
; phi^2 + 1/phi^2 = 3 | TRINITY

module catalog_discovery;

pub const KIND : str = "discovery";
pub const ID : str = "catalog/discovery";
pub const NAME : str = "t27 world discovery";
; The derived artifacts a scan rewrites (relative to apps/website).
pub const GENERATED : [3]str = ["public/t27/manifest.json", "public/t27/shared-core.json", "public/t27/universe-atlas.json"];

; --- Where to look -----------------------------------------------------------------------
; Public GitHub owners whose whole repository inventories are read on every scan: the two
; co-founders' accounts. Adding an owner here is the only way to add one.
pub const OWNERS : [2]str = ["gHashTag", "dmitrii-f-t27"];
; Supplementary hint for owners nobody listed: GitHub code search, at most CODE_SEARCH_PAGES
; pages of 100. Best effort: the index is incomplete (trinity-memory was not in it) and noisy
; (licence databases carry .t27 files), so every hit still has to qualify like any candidate.
pub const CODE_SEARCH : str = "extension:t27";
pub const CODE_SEARCH_PAGES : u8 = 10;

; --- What is excluded ----------------------------------------------------------------------
pub const PUBLIC_ONLY : bool = true;
; A fork of t27 or trinity carries their specs again under another name.
pub const SKIP_FORKS : bool = true;
; An archived repository still holds the specs it holds; it is kept and marked, not hidden.
pub const SKIP_ARCHIVED : bool = false;
; Build output that mirrors this catalog byte for byte; a copy is never a source.
pub const MIRRORS : [1]str = ["ghashtag/ghashtag.github.io"];
; Vendored by hand from a local checkout (see WHAT THE SCAN NEVER DOES); reported, not rewritten.
pub const FOUNDING : [5]str = ["ghashtag/t27", "ghashtag/tri-net", "ghashtag/trinity", "ghashtag/trinity-fpga", "ghashtag/tt-trinity-corona"];

; --- How a candidate qualifies -------------------------------------------------------------
; Files compiled per candidate at most: spread evenly over the specs/ paths first, then over
; the rest, and the probe stops at the first file that qualifies. Spread, not the first few:
; trinity-fpga's first three specs by name parse to empty modules under the vendored compiler
; (newer syntax), while 26 of its 64 do not, and a single unlucky prefix must not hide a world.
pub const PROBE_FILES : u8 = 8;
; Declarations one probed file must hold for the repository to count as writing t27.
pub const MIN_DECLARATIONS : u8 = 1;

; --- Limits --------------------------------------------------------------------------------
pub const MAX_WORLDS : u8 = 40;
pub const MAX_FILES_PER_WORLD : u16 = 2000;
; Larger files are skipped and counted; the explorer compiles every entry in the browser.
pub const MAX_FILE_BYTES : u32 = 1048576;

test the_founding_five_are_the_hand_vendored_sources {
    assert FOUNDING[0] == "ghashtag/t27";
    assert FOUNDING[1] == "ghashtag/tri-net";
    assert FOUNDING[2] == "ghashtag/trinity";
    assert FOUNDING[3] == "ghashtag/trinity-fpga";
    assert FOUNDING[4] == "ghashtag/tt-trinity-corona";
}

test both_cofounders_are_scanned {
    assert OWNERS[0] == "gHashTag";
    assert OWNERS[1] == "dmitrii-f-t27";
}

test the_probe_is_bounded_and_demands_a_declaration {
    assert PROBE_FILES >= 1;
    assert PROBE_FILES <= 10;
    assert MIN_DECLARATIONS >= 1;
}

test public_only_and_no_forks {
    assert PUBLIC_ONLY == true;
    assert SKIP_FORKS == true;
    assert SKIP_ARCHIVED == false;
}

test limits_leave_room_for_growth {
    assert MAX_WORLDS > 5;
    assert MAX_FILES_PER_WORLD >= 1000;
    assert MAX_FILE_BYTES >= 65536;
    assert CODE_SEARCH_PAGES >= 1;
    assert CODE_SEARCH_PAGES <= 10;
}
