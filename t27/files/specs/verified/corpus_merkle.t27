// SPDX-License-Identifier: Apache-2.0
; specs/verified/corpus_merkle.t27 -- the Merkle roots of specs/verified/corpus_receipt.t27,
; computed with specs/tri/crypto/sha256.t27 and checked against vectors computed independently.
; Issue #7576 (epic #6063, Verified Compute #6655).
; --
; corpus_receipt.t27 states the tree: RFC 6962 section 2.1, LEAF_PREFIX and NODE_PREFIX, split at
; split_point(n). This file is that tree as t27 code over the SHA-256 spec, so the rule is executed
; and not only described. `t27c corpus-receipt` computes the same tree with the sha2 crate until
; gen-rust lowers slices (#7469, then #7499 drops the crate); the vectors below are what both must
; produce.
; --
; Oracle: Python hashlib.sha256 with the RFC 6962 recursion written out independently, over the
; leaf lines `specs/<x>.t27 TAB <xx>` for x = a..e (`<xx>` is the letter doubled). The two wrong
; trees a careless implementation builds -- split at the middle instead of at a power of two, and
; a leaf hashed without its prefix -- give different roots, and the tests below name both.
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedCorpusMerkle;

use verified::corpus_receipt;
use tri::crypto::sha256;

/// The sample corpus: five paths and their values, in sorted path order.
pub const SAMPLE_PATHS : [5]str = ["specs/a.t27", "specs/b.t27", "specs/c.t27", "specs/d.t27", "specs/e.t27"];
pub const SAMPLE_VALUES : [5]str = ["aa", "bb", "cc", "dd", "ee"];

/// The hash of one leaf line `path TAB value`, under LEAF_PREFIX.
fn merkle_leaf(path: []const u8, value: []const u8) -> [32]u8 {
    var s = init();
    var b : [1]u8 = [0] ** 1;
    b[0] = LEAF_PREFIX;
    update(&s, b[0..1]);
    update(&s, path);
    b[0] = CH_TAB as u8;
    update(&s, b[0..1]);
    update(&s, value);
    return final(&s);
}

/// The hash of an inner node, under NODE_PREFIX.
fn merkle_node(left: [32]u8, right: [32]u8) -> [32]u8 {
    var s = init();
    var b : [1]u8 = [0] ** 1;
    b[0] = NODE_PREFIX;
    update(&s, b[0..1]);
    update(&s, left[0..32]);
    update(&s, right[0..32]);
    return final(&s);
}

/// The root of leaves lo..hi-1 (hi > lo), split where corpus_receipt.t27 says.
fn merkle_range(d: [5][32]u8, lo: u32, hi: u32) -> [32]u8 {
    if (hi - lo == 1) { return d[lo]; }
    const k = split_point(hi - lo);
    return merkle_node(merkle_range(d, lo, lo + k), merkle_range(d, lo + k, hi));
}

/// The leaf hashes of the five sample lines.
fn sample_leaves() -> [5][32]u8 {
    var d : [5][32]u8 = [[0] ** 32] ** 5;
    var i : usize = 0;
    while (i < 5) {
        d[i] = merkle_leaf(SAMPLE_PATHS[i], SAMPLE_VALUES[i]);
        i = i + 1;
    }
    return d;
}

/// The root of the first n sample leaves; n == 0 is the hash of the empty string.
fn sample_root(n: u32) -> [32]u8 {
    if (n == 0) { return hash(""); }
    return merkle_range(sample_leaves(), 0, n);
}

fn hex_nibble_of(c: u8) -> usize {
    if (c >= 97) { return (c as usize) - 87; }
    return (c as usize) - 48;
}

/// The digest equals the 64-letter lowercase hex text.
fn digest_is(d: [32]u8, hex: []const u8) -> bool {
    if (hex.len != 64) { return false; }
    var i : usize = 0;
    while (i < 32) {
        if ((d[i] as usize) != hex_nibble_of(hex[2 * i]) * 16 + hex_nibble_of(hex[2 * i + 1])) { return false; }
        i = i + 1;
    }
    return true;
}

/// How many of the six roots (0..5 leaves) match the hashlib oracle.
fn oracle_roots() -> usize {
    var ok : usize = 0;
    if (digest_is(sample_root(0), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")) { ok = ok + 1; }
    if (digest_is(sample_root(1), "83c2e0d01cf45c60060daee549a7a0cb6896ba11a4d9ebc8b873a8ccce57c6b7")) { ok = ok + 1; }
    if (digest_is(sample_root(2), "06e1671516ddf2ac56f1c576f4cd17a5a0985787b60f9807ef43c55a50eccbc2")) { ok = ok + 1; }
    if (digest_is(sample_root(3), "c4930743536b4efa6564f5226ffcd60900091fd014d5583bacf161dd1e15d38f")) { ok = ok + 1; }
    if (digest_is(sample_root(4), "40ab2ac101414f4cb382c4273b4e324dff0b90805c9859722744de74b8056105")) { ok = ok + 1; }
    if (digest_is(sample_root(5), "272c9664c1823398bae6b3868ab616c044e33729a5522c33e95215e551fd9905")) { ok = ok + 1; }
    return ok;
}

/// The tree a middle split builds for five leaves (3 + 2), which RFC 6962 does not (4 + 1).
fn middle_split_root() -> [32]u8 {
    const d = sample_leaves();
    return merkle_node(merkle_range(d, 0, 3), merkle_range(d, 3, 5));
}

/// A single leaf hashed with no prefix: what a leaf and a node would collide through.
fn unprefixed_leaf() -> [32]u8 {
    var s = init();
    update(&s, "specs/a.t27");
    var b : [1]u8 = [9] ** 1;
    update(&s, b[0..1]);
    update(&s, "aa");
    return final(&s);
}

test "the roots of zero to five leaves are the hashlib oracle's" {
    assert oracle_roots() == 6;
    assert digest_is(sample_root(0), "e3b0c44298fc1c149afbf4c8996fb924") == false;
}

test "five leaves split four and one, not at the middle" {
    assert digest_is(middle_split_root(), "402172c1c4e1c9d725cf0354b49e976c5a359720831d1a80e384b29ea7434956") == true;
    assert digest_is(middle_split_root(), "272c9664c1823398bae6b3868ab616c044e33729a5522c33e95215e551fd9905") == false;
}

test "a leaf is hashed under its prefix" {
    assert digest_is(unprefixed_leaf(), "f0cbaa29b95a9bc9eae7352f04a3857be296efbefd7f81310135fce4164cd463") == true;
    assert digest_is(sample_root(1), "f0cbaa29b95a9bc9eae7352f04a3857be296efbefd7f81310135fce4164cd463") == false;
}

test "the order of the leaves is part of the root" {
    const d = sample_leaves();
    assert digest_is(merkle_node(d[1], d[0]), "a211198705967662a65140c01a00c398bb381faa8ded64ae11174580395b1125") == true;
    assert digest_is(merkle_node(d[0], d[1]), "a211198705967662a65140c01a00c398bb381faa8ded64ae11174580395b1125") == false;
}
