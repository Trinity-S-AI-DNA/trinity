// SPDX-License-Identifier: Apache-2.0
; specs/verified/ddc_receipt.t27 -- one Diverse Double-Compiling run of t27core as a signed receipt,
; and the verdict it supports for compiler-sieve filter C4. Issue #7699 (epic #6488, item C4/C5;
; the cell's fix is #5980). This file is the contract: `t27c ddc-receipt` runs the code
; `t27c gen-rust` writes from it, and the t27b lab only hands it the run.
; --
; What already exists and is NOT restated here:
; - specs/compiler/theory/toolchain.t27 owns the DDC rule. T732's ddc_verdict() judges the routes
;   (cannot run, miscompile, back-end agreement, independent agreement) over its route bits, and
;   T729's shared() says what a shared front end is. This file calls ddc_verdict(); it never
;   restates it, and a test holds its front-end count to shared() on the pairs T729 models.
; - specs/compiler/core/t27core_ddc.t27 (#6508, PR #6825) is the harness routes B and C run: it
;   imports S's functions through `use`, carries S and E as packed data, runs S's `compile` on S
;   inside the program the route built, compares the output with E and must find one flipped byte.
; - specs/verified/signed_receipt.t27 (R3-1, #7332) owns the scheme (Ed25519), the key registry,
;   the field line `name=value\n`, the nonce rule and auth_first_missing / receipt_level. A DDC
;   receipt is judged by exactly those rules; only its domain line and its fields are new.
; - specs/verified/corpus_receipt.t27 (#7576) owns text_is() (byte equality) and HARDWARE_ROOTED
;   (false: the lab key is NAMED); this file uses both and restates neither.
; --
; Why: until this rule the C4 cell cited logs copied by hand to the t27b lab (ddc6508/*.out). A
; receipt binds the run to a commit, to the hashes of S, E and the harness, to each route's builder
; and front end, and to a verifier's challenge, so the cell's evidence is checked, not believed.
; --
; The record:
; - The signed message is the domain line DDC_DOMAIN, then one signed_receipt field line per field
;   in DDC_SIGNED_FIELDS order; value is the field's JSON text as the receipt stores it. The receipt
;   names itself with `kind` = DDC_DOMAIN, so a signature over a corpus or hardware receipt can
;   never verify as a DDC receipt, nor the other way round.
; - s_sha256 is S (DDC_S_PATH); e_sha256 is E, `t27c gen-c S` by the commit's own t27c;
;   frozen_hash is bootstrap/stage0/FROZEN_HASH, the sha256 of the front end the routes share;
;   harness_sha256 is DDC_HARNESS_PATH; harness_s_sha256 is the S the harness's data packs (its
;   `ddc_source`); t27c_sha256 is the t27c that ran gen-c.
; - routes is a JSON array of DDC_ROUTE_COUNT objects in T732's order A, B, C (DDC_ROUTE_IDS:
;   gen-c + cc, t27b, the Zig reference), each with the keys DDC_ROUTE_KEYS: its id; builder_sha256
;   and built_by, the binary that built stage 1 and what it says it is; front_end, the front end
;   that parsed S as `<its source path>@<its hash>`; stage2_sha256; outcome.
; - outcome: OUTCOME_PASS, the stage-1 program ran on S to the end and exited 0; OUTCOME_FAIL, it
;   ran and did not (a failed assert, a crash, a refusal of S); OUTCOME_NOT_RUN, no stage-1 program
;   ran to the end (it did not build, a tool is missing, a timeout).
; - stage2_sha256, for a pass (otherwise empty). Route A is measured outside the program, as
;   Wheeler compares: E is the stage-1 core's C, cc builds it with the commit's own driver
;   (bootstrap/tests/core_selfhost.rs), the core reads S, and the digest is that of what it wrote.
;   Routes B and C run the harness, whose comparison runs inside the stage-1 program (its limit 2):
;   their digest is that of the harness's E data (`ddc_expected`), which a pass found stage 2 equal
;   to byte for byte.
; --
; The verdict, from the signed fields only:
; 1. The routes are comparable when there are exactly DDC_ROUTE_COUNT of them, E is a digest, and
;    the harness's data is S. A harness that packs another S ran nothing on this one.
; 2. route_state(): a route in the wrong place, or that did not run, is RS_NOT_RUN; a fail is
;    RS_DIFFERS; a pass whose stage-2 digest is E is RS_AGREES, and any other pass is RS_DIFFERS.
;    A pass against a harness whose E data is not this commit's E does not agree: the core no
;    longer reproduces gen-c, which is the disagreement DDC exists to find.
; 3. The front end is shared when fewer than two DIFFERENT front-end names are among the routes
;    that ran. A name is the front_end text before its first `@`: the hash after it is a version,
;    and two versions of one front end are one implementation. An empty name never counts.
; 4. T732's ddc_verdict() over the masks of routes that ran and that agree, and the shared flag.
; Its answers print as DDC_NAMES: DDC_CANNOT_RUN, DDC_MISCOMPILE, DDC_BACKEND_AGREEMENT,
; DDC_INDEPENDENT. C4 holds only on DDC_INDEPENDENT. Every route today names
; bootstrap/src/compiler.rs, so the most a real run can say is DDC_BACKEND_AGREEMENT; the test
; "today's three routes agree on back ends only" pins that.
; --
; verify judges in fixed order: the receipt names itself DDC_DOMAIN; it authenticates
; (signed_receipt codes, against the verifier's challenge when one is given); then the verdict. Its
; exit code is ddc_exit(): 0 DDC_INDEPENDENT, 1 DDC_MISCOMPILE, 2 refused, 3 DDC_CANNOT_RUN,
; 4 DDC_BACKEND_AGREEMENT. A refused receipt has no verdict.
; --
; When the lab runs DDC (ddc_due): when no DDC receipt was signed before, or when one of
; DDC_INPUT_FIELDS (S, E, FROZEN_HASH) differs from the last signed receipt's. Nothing else makes a
; master run pay for it: a back end that changed alone (t27b, cc, zig) waits for the next change of
; S, E or the front end.
; --
; The honest ceiling: the key is the lab's (trust level NAMED); HARDWARE_ROOTED is false. A receipt
; proves the key holder signed these facts for this challenge. It does not prove the routes ran on
; any given machine, and the in-program comparison rules out a no-op compare (the flipped byte),
; not a targeted trojan. Tests pin literal codes where a fact names itself.
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedDdcReceipt;

use verified::signed_receipt;
use verified::corpus_receipt;
use compiler::theory::toolchain;

/// The signed message starts with this line; a receipt's `kind` field carries the same text.
pub const DDC_DOMAIN : str = "t27-ddc-receipt-v1";

/// The signed fields, in message order. `kind`, `key_id` and `signature` are the envelope.
pub const DDC_SIGNED_FIELDS : [9]str = ["commit", "s_sha256", "e_sha256", "frozen_hash", "harness_sha256", "harness_s_sha256", "t27c_sha256", "routes", "nonce"];
pub const DDC_SIGNED_FIELD_COUNT : u8 = 9;

/// The keys of one route object, and the route ids in T732's order (ROUTE_GENC_CC, ROUTE_T27B,
/// ROUTE_ZIG).
pub const DDC_ROUTE_KEYS : [6]str = ["route", "builder_sha256", "built_by", "front_end", "stage2_sha256", "outcome"];
pub const DDC_ROUTE_IDS : [3]str = ["A", "B", "C"];
pub const DDC_ROUTE_COUNT : u32 = 3;

/// The fields whose change makes the lab run DDC again.
pub const DDC_INPUT_FIELDS : [3]str = ["s_sha256", "e_sha256", "frozen_hash"];

/// S, and the harness routes B and C run. Route A cannot build the harness yet: gen-c declares its
/// module vars before the constants `use` splices in, which size them (#7702).
pub const DDC_S_PATH : str = "specs/compiler/core/t27core.t27";
pub const DDC_HARNESS_PATH : str = "specs/compiler/core/t27core_ddc.t27";

/// A route's outcome.
pub const OUTCOME_PASS : str = "pass";
pub const OUTCOME_FAIL : str = "fail";
pub const OUTCOME_NOT_RUN : str = "not_run";

/// route_state() answers, ordered: a route that agrees also ran.
pub const RS_NOT_RUN : u8 = 0;
pub const RS_DIFFERS : u8 = 1;
pub const RS_AGREES : u8 = 2;

/// A digest is 64 lowercase hex digits; a front end's name ends at its first `@`.
pub const DIGEST_HEX_LEN : u32 = 64;
pub const CH_AT : u32 = 64;

/// T732's ddc_verdict() answers, by code, as `verify` prints them.
pub const DDC_NAMES : [4]str = ["DDC_CANNOT_RUN", "DDC_MISCOMPILE", "DDC_BACKEND_AGREEMENT", "DDC_INDEPENDENT"];

/// ddc_first_problem() answers, in judgment order.
pub const DDC_OK : u8 = 0;
pub const DDC_WRONG_KIND : u8 = 1;
pub const DDC_NOT_AUTHENTIC : u8 = 2;

/// ddc_exit() answers: the exit code of `t27c ddc-receipt verify`.
pub const DDC_EXIT_INDEPENDENT : u8 = 0;
pub const DDC_EXIT_MISCOMPILE : u8 = 1;
pub const DDC_EXIT_REFUSED : u8 = 2;
pub const DDC_EXIT_CANNOT_RUN : u8 = 3;
pub const DDC_EXIT_BACKEND_AGREEMENT : u8 = 4;

; --- The message ---------------------------------------------------------------------------------

/// The first line: DDC_DOMAIN, then a newline. Field lines are signed_receipt's.
pub fn ddc_domain_line_len() -> u32 {
    return (DDC_DOMAIN.len as u32) + 1;
}

pub fn ddc_domain_line_char(k: u32) -> u32 {
    if (k < (DDC_DOMAIN.len as u32)) { return DDC_DOMAIN[k] as u32; }
    if (k == (DDC_DOMAIN.len as u32)) { return CH_NEWLINE; }
    return LINE_END;
}

; --- Digests -------------------------------------------------------------------------------------

/// A sha256 as receipts write it: DIGEST_HEX_LEN hex digits in git's lowercase spelling.
pub fn digest_well_formed(d: string) -> bool {
    if ((d.len as u32) != DIGEST_HEX_LEN) { return false; }
    var k : u32 = 0;
    var c : u32 = 0;
    while (k < DIGEST_HEX_LEN) {
        c = d[k] as u32;
        if (hex_digit_value(c) == HEX_NOT_A_DIGIT) { return false; }
        if (hex_digit_char(hex_digit_value(c)) != c) { return false; }
        k = k + 1;
    }
    return true;
}

; --- One route -----------------------------------------------------------------------------------

/// The route at `place` (0, 1, 2) carries the id T732's order gives it.
pub fn route_id_is(place: u32, id: string) -> bool {
    if (place == 0) { return text_is(id, "A"); }
    if (place == 1) { return text_is(id, "B"); }
    if (place == 2) { return text_is(id, "C"); }
    return false;
}

/// What one route showed: not run, a stage 2 that is not E, or a stage 2 that is E.
pub fn route_state(place: u32, id: string, outcome: string, stage2: string, e: string) -> u8 {
    if (route_id_is(place, id) == false) { return RS_NOT_RUN; }
    if (text_is(outcome, OUTCOME_PASS)) {
        if (digest_well_formed(stage2)) {
            if (text_is(stage2, e)) { return RS_AGREES; }
        }
        return RS_DIFFERS;
    }
    if (text_is(outcome, OUTCOME_FAIL)) { return RS_DIFFERS; }
    return RS_NOT_RUN;
}

/// T732's route mask of the routes whose state is at least `at_least`: RS_DIFFERS gives the routes
/// that ran (T732's `built`), RS_AGREES the routes whose stage 2 is E (its `equal`).
pub fn route_mask(st_a: u8, st_b: u8, st_c: u8, at_least: u8) -> u32 {
    var m : u32 = 0;
    if (st_a >= at_least) { m = m | ROUTE_GENC_CC; }
    if (st_b >= at_least) { m = m | ROUTE_T27B; }
    if (st_c >= at_least) { m = m | ROUTE_ZIG; }
    return m;
}

; --- Front ends ----------------------------------------------------------------------------------

/// Where a front-end identity's name ends: its first `@`, or its length when it has none.
pub fn name_end(fe: string) -> u32 {
    var k : u32 = 0;
    while (k < (fe.len as u32)) {
        if ((fe[k] as u32) == CH_AT) { return k; }
        k = k + 1;
    }
    return fe.len as u32;
}

/// Two identities name one front end: their names, the text before the first `@`, are equal.
pub fn same_front_end(a: string, b: string) -> bool {
    var n : u32 = name_end(a);
    if (name_end(b) != n) { return false; }
    var k : u32 = 0;
    while (k < n) {
        if ((a[k] as u32) != (b[k] as u32)) { return false; }
        k = k + 1;
    }
    return true;
}

/// A route's front end counts when the route ran and its identity has a name.
pub fn front_end_counts(ran: u32, bit: u32, fe: string) -> bool {
    if ((ran & bit) == 0) { return false; }
    return name_end(fe) > 0;
}

/// How many different named front ends the routes in `ran` name, 0 to 3.
pub fn distinct_front_ends3(ran: u32, fe_a: string, fe_b: string, fe_c: string) -> u32 {
    var a : bool = front_end_counts(ran, ROUTE_GENC_CC, fe_a);
    var b : bool = front_end_counts(ran, ROUTE_T27B, fe_b);
    var c : bool = front_end_counts(ran, ROUTE_ZIG, fe_c);
    var n : u32 = 0;
    if (a) { n = n + 1; }
    if (b) {
        var new_b : bool = true;
        if (a) { if (same_front_end(fe_a, fe_b)) { new_b = false; } }
        if (new_b) { n = n + 1; }
    }
    if (c) {
        var new_c : bool = true;
        if (a) { if (same_front_end(fe_a, fe_c)) { new_c = false; } }
        if (b) { if (same_front_end(fe_b, fe_c)) { new_c = false; } }
        if (new_c) { n = n + 1; }
    }
    return n;
}

; --- The verdict ---------------------------------------------------------------------------------

/// The routes can be compared at all: DDC_ROUTE_COUNT of them, E a digest, the harness's data S.
pub fn routes_comparable(route_count: u32, s: string, harness_s: string, e: string) -> bool {
    if (route_count != DDC_ROUTE_COUNT) { return false; }
    if (digest_well_formed(e) == false) { return false; }
    if (digest_well_formed(s) == false) { return false; }
    return text_is(harness_s, s);
}

/// The receipt's verdict: T732's ddc_verdict() over the routes that ran and agree, with the front
/// end shared when fewer than two different named front ends ran. st_* are route_state() answers.
pub fn ddc_receipt_verdict(route_count: u32, s: string, harness_s: string, e: string, st_a: u8, st_b: u8, st_c: u8, fe_a: string, fe_b: string, fe_c: string) -> u8 {
    var ran : u32 = 0;
    var agree : u32 = 0;
    if (routes_comparable(route_count, s, harness_s, e)) {
        ran = route_mask(st_a, st_b, st_c, RS_DIFFERS);
        agree = route_mask(st_a, st_b, st_c, RS_AGREES);
    }
    return ddc_verdict(ran, agree, distinct_front_ends3(ran, fe_a, fe_b, fe_c) < 2);
}

; --- Judging a receipt ---------------------------------------------------------------------------

/// The first reason a receipt has no verdict, or DDC_OK. `auth` is its auth_first_missing code.
pub fn ddc_first_problem(kind: string, auth: u8) -> u8 {
    if (text_is(kind, DDC_DOMAIN) == false) { return DDC_WRONG_KIND; }
    if (auth != AUTH_MISSING_NONE) { return DDC_NOT_AUTHENTIC; }
    return DDC_OK;
}

/// The exit code of `verify`: 0 only when C4 holds, 2 for a receipt with no verdict.
pub fn ddc_exit(problem: u8, verdict: u8) -> u8 {
    if (problem != DDC_OK) { return DDC_EXIT_REFUSED; }
    if (verdict == DDC_AGREE_INDEPENDENT) { return DDC_EXIT_INDEPENDENT; }
    if (verdict == DDC_MISCOMPILE) { return DDC_EXIT_MISCOMPILE; }
    if (verdict == DDC_CANNOT_RUN) { return DDC_EXIT_CANNOT_RUN; }
    return DDC_EXIT_BACKEND_AGREEMENT;
}

/// Sieve filter C4 for the compiler this receipt is about: an authenticated independent agreement.
pub fn c4_holds(problem: u8, verdict: u8) -> bool {
    if (problem != DDC_OK) { return false; }
    return verdict == DDC_AGREE_INDEPENDENT;
}

; --- When the lab runs it ------------------------------------------------------------------------

/// Run DDC when there is no signed receipt yet, or when `changed` of DDC_INPUT_FIELDS differ from it.
pub fn ddc_due(have_last: bool, changed: u32) -> bool {
    if (have_last == false) { return true; }
    return changed > 0;
}

/// `due` exits 0 to run and 1 to skip. Any other exit is a t27c with no `ddc-receipt`: it could not sign
/// either, so the lab runs nothing.
pub fn due_exit(due: bool) -> u8 {
    if (due) { return 0; }
    return 1;
}

; --- Tests ---------------------------------------------------------------------------------------

test "the DDC message starts with its own domain line" {
    assert ddc_domain_line_len() == 19;
    assert ddc_domain_line_char(0) == 116;
    assert ddc_domain_line_char(4) == 100;
    assert ddc_domain_line_char(17) == 49;
    assert ddc_domain_line_char(18) == CH_NEWLINE;
    assert ddc_domain_line_char(19) == LINE_END;
    // and it is not the hardware receipt's
    assert ddc_domain_line_len() != domain_line_len();
    assert ddc_domain_line_char(4) != domain_line_char(4);
}

test "nine signed fields, the routes and the nonce among them" {
    assert DDC_SIGNED_FIELD_COUNT == 9;
    assert text_is(DDC_SIGNED_FIELDS[0], "commit") == true;
    assert text_is(DDC_SIGNED_FIELDS[2], "e_sha256") == true;
    assert text_is(DDC_SIGNED_FIELDS[3], "frozen_hash") == true;
    assert text_is(DDC_SIGNED_FIELDS[5], "harness_s_sha256") == true;
    assert text_is(DDC_SIGNED_FIELDS[7], "routes") == true;
    assert text_is(DDC_SIGNED_FIELDS[8], "nonce") == true;
    assert text_is(DDC_ROUTE_KEYS[3], "front_end") == true;
    assert text_is(DDC_ROUTE_KEYS[4], "stage2_sha256") == true;
    assert text_is(DDC_INPUT_FIELDS[2], "frozen_hash") == true;
    assert text_is(DDC_S_PATH, "specs/compiler/core/t27core.t27") == true;
    assert text_is(DDC_HARNESS_PATH, "specs/compiler/core/t27core_ddc.t27") == true;
}

test "a digest is sixty-four lowercase hex digits" {
    assert digest_well_formed("3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a58") == true;
    assert digest_well_formed("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef") == true;
    assert digest_well_formed("3EFC314E176B846935852D39CE5DBCD28EDAA4053383B33B767DA5494CFF2A58") == false;
    assert digest_well_formed("3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a5") == false;
    assert digest_well_formed("3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a588") == false;
    assert digest_well_formed("3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a5g") == false;
    assert digest_well_formed("g3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a5") == false;
    assert digest_well_formed("") == false;
}

test "a route sits in T732's place: A, then B, then C" {
    assert route_id_is(0, "A") == true;
    assert route_id_is(1, "B") == true;
    assert route_id_is(2, "C") == true;
    assert route_id_is(0, "B") == false;
    assert route_id_is(1, "C") == false;
    assert route_id_is(2, "A") == false;
    assert route_id_is(3, "C") == false;
    assert route_id_is(0, "") == false;
    assert text_is(DDC_ROUTE_IDS[1], "B") == true;
}

test "a pass agrees only when its stage 2 is E" {
    var e : string = "3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a58";
    assert route_state(0, "A", "pass", "3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a58", e) == RS_AGREES;
    assert route_state(1, "B", "pass", "3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a58", e) == 2;
    // a doctored stage-2 digest, a missing one, one in the wrong spelling
    assert route_state(1, "B", "pass", "3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a59", e) == RS_DIFFERS;
    assert route_state(1, "B", "pass", "", e) == RS_DIFFERS;
    assert route_state(1, "B", "pass", "3EFC314E176B846935852D39CE5DBCD28EDAA4053383B33B767DA5494CFF2A58", "3EFC314E176B846935852D39CE5DBCD28EDAA4053383B33B767DA5494CFF2A58") == 1;
}

test "a fail never agrees, and a route that did not run is not counted" {
    var e : string = "3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a58";
    assert route_state(2, "C", "fail", "3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a58", e) == RS_DIFFERS;
    assert route_state(2, "C", "fail", "", e) == 1;
    assert route_state(2, "C", "not_run", "", e) == RS_NOT_RUN;
    assert route_state(2, "C", "passed", "3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a58", e) == 0;
    assert route_state(2, "C", "", "", e) == RS_NOT_RUN;
    // a route out of its place is not counted, even when it agrees
    assert route_state(2, "A", "pass", "3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a58", e) == RS_NOT_RUN;
    assert route_state(3, "C", "fail", "", e) == RS_NOT_RUN;
}

test "the route masks are T732's bits" {
    assert route_mask(RS_AGREES, RS_AGREES, RS_AGREES, RS_DIFFERS) == ROUTE_ALL;
    assert route_mask(RS_AGREES, RS_DIFFERS, RS_NOT_RUN, RS_DIFFERS) == 3;
    assert route_mask(RS_AGREES, RS_DIFFERS, RS_NOT_RUN, RS_AGREES) == ROUTE_GENC_CC;
    assert route_mask(RS_NOT_RUN, RS_AGREES, RS_DIFFERS, RS_DIFFERS) == 6;
    assert route_mask(RS_NOT_RUN, RS_NOT_RUN, RS_AGREES, RS_AGREES) == ROUTE_ZIG;
    assert route_mask(RS_NOT_RUN, RS_AGREES, RS_NOT_RUN, RS_AGREES) == ROUTE_T27B;
    assert route_mask(RS_NOT_RUN, RS_NOT_RUN, RS_NOT_RUN, RS_DIFFERS) == 0;
    assert RS_NOT_RUN < RS_DIFFERS;
    assert RS_DIFFERS < RS_AGREES;
}

test "a front end is named by the text before its first at sign" {
    assert name_end("bootstrap/src/compiler.rs@39fa") == 25;
    assert name_end("a@b@c") == 1;
    assert name_end("@39fa") == 0;
    assert name_end("compiler.rs") == 11;
    assert name_end("") == 0;
    assert same_front_end("bootstrap/src/compiler.rs@39fa", "bootstrap/src/compiler.rs@0000") == true;
    assert same_front_end("bootstrap/src/compiler.rs@39fa", "bootstrap/src/compiler.rs") == true;
    assert same_front_end("bootstrap/src/compiler.rs@39fa", "specs/compiler/core/t27core.t27@261f") == false;
    assert same_front_end("bootstrap/src/compiler.rs@1", "bootstrap/src/compiler.rx@1") == false;
    assert same_front_end("ab@1", "abc@1") == false;
    assert same_front_end("abc@1", "ab@1") == false;
}

test "front ends are counted over the routes that ran, by name, never an empty one" {
    assert distinct_front_ends3(ROUTE_ALL, "compiler.rs@1", "compiler.rs@1", "compiler.rs@1") == 1;
    assert distinct_front_ends3(ROUTE_ALL, "compiler.rs@1", "compiler.rs@2", "compiler.rs@3") == 1;
    assert distinct_front_ends3(ROUTE_ALL, "compiler.rs@1", "t27core.t27@1", "compiler.rs@1") == 2;
    assert distinct_front_ends3(ROUTE_ALL, "compiler.rs@1", "compiler.rs@1", "t27core.t27@1") == 2;
    assert distinct_front_ends3(ROUTE_ALL, "t27core.t27@1", "compiler.rs@1", "compiler.rs@1") == 2;
    assert distinct_front_ends3(ROUTE_ALL, "a@1", "b@1", "c@1") == 3;
    assert distinct_front_ends3(ROUTE_ALL, "a@1", "b@1", "a@1") == 2;
    assert distinct_front_ends3(ROUTE_ALL, "a@1", "b@1", "b@2") == 2;
    // a route that did not run brings no front end
    assert distinct_front_ends3(ROUTE_GENC_CC | ROUTE_ZIG, "compiler.rs@1", "t27core.t27@1", "compiler.rs@1") == 1;
    assert distinct_front_ends3(ROUTE_T27B, "a@1", "b@1", "c@1") == 1;
    assert distinct_front_ends3(0, "a@1", "b@1", "c@1") == 0;
    // an unnamed front end is nobody, never a second front end
    assert distinct_front_ends3(ROUTE_ALL, "compiler.rs@1", "", "@2") == 1;
    assert distinct_front_ends3(ROUTE_ALL, "", "", "") == 0;
    assert distinct_front_ends3(ROUTE_ALL, "", "a@1", "b@1") == 2;
}

test "the front-end flag is T729's shared() on the pairs it models" {
    // t27b against the reference: both parse with compiler.rs, so T729 says the pair shares stages
    var ref_pair : bool = shared(PAIR_T27B_REFERENCE) != 0;
    var ref_count : bool = distinct_front_ends3(ROUTE_T27B | ROUTE_ZIG, "", "bootstrap/src/compiler.rs@1", "bootstrap/src/compiler.rs@1") < 2;
    assert ref_pair == ref_count;
    assert ref_pair == true;
    // t27b behind t27core's own front end against the reference: nothing shared
    var core_pair : bool = shared(PAIR_T27B_CORE_FRONT) != 0;
    var core_count : bool = distinct_front_ends3(ROUTE_T27B | ROUTE_ZIG, "", "specs/compiler/core/t27core.t27@1", "bootstrap/src/compiler.rs@1") < 2;
    assert core_pair == core_count;
    assert core_pair == false;
}

test "the routes are comparable only on S, with E a digest and three routes" {
    var s : string = "261f436a02103f899896ef19d1fe4472523c3cd0bd803983b1888eec90e33dbd";
    var e : string = "3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a58";
    assert routes_comparable(3, s, "261f436a02103f899896ef19d1fe4472523c3cd0bd803983b1888eec90e33dbd", e) == true;
    assert routes_comparable(3, s, "36baed9b65a777955dd71d28dde6bfa37489125c3dde61208878c03f9f1bc314", e) == false;
    assert routes_comparable(3, s, s, "") == false;
    assert routes_comparable(3, "", "", e) == false;
    assert routes_comparable(2, s, s, e) == false;
    assert routes_comparable(4, s, s, e) == false;
    assert routes_comparable(0, s, s, e) == false;
}

test "today's three routes agree on back ends only" {
    // master 2e06cef59: S, E and compiler.rs's FROZEN_HASH as the t27b lab ran them; every route passes
    var s : string = "261f436a02103f899896ef19d1fe4472523c3cd0bd803983b1888eec90e33dbd";
    var e : string = "3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a58";
    var fe : string = "bootstrap/src/compiler.rs@39fa3908f9fd84c3444d754a48edfe3b73ba4cdb132efaa879853186aa8afd7d";
    var a : u8 = route_state(0, "A", "pass", e, e);
    var b : u8 = route_state(1, "B", "pass", e, e);
    var c : u8 = route_state(2, "C", "pass", e, e);
    var v : u8 = ddc_receipt_verdict(3, s, s, e, a, b, c, fe, fe, fe);
    assert v == DDC_AGREE_BACK_ENDS;
    assert v == 2;
    assert text_is(DDC_NAMES[v], "DDC_BACKEND_AGREEMENT") == true;
    assert ddc_exit(DDC_OK, v) == 4;
    assert c4_holds(DDC_OK, v) == false;
    // the same as T732's recorded run at 0fbd183ba
    assert v == ddc_verdict(RUN_0FBD183BA_BUILT, RUN_0FBD183BA_EQUAL, shared(PAIR_T27B_REFERENCE) != 0);
}

test "a doctored stage-2 digest is a miscompile" {
    var s : string = "261f436a02103f899896ef19d1fe4472523c3cd0bd803983b1888eec90e33dbd";
    var e : string = "3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a58";
    var fe : string = "bootstrap/src/compiler.rs@39fa";
    var b : u8 = route_state(1, "B", "pass", "3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a59", e);
    var v : u8 = ddc_receipt_verdict(3, s, s, e, RS_AGREES, b, RS_AGREES, fe, fe, fe);
    assert v == DDC_MISCOMPILE;
    assert v == 1;
    assert text_is(DDC_NAMES[v], "DDC_MISCOMPILE") == true;
    assert ddc_exit(DDC_OK, v) == 1;
    // a miscompile on one route is not hidden by an independent front end on another
    assert ddc_receipt_verdict(3, s, s, e, RS_AGREES, RS_AGREES, RS_DIFFERS, fe, "specs/compiler/core/t27core.t27@1", fe) == DDC_MISCOMPILE;
}

test "the first Zig run of T732 is a miscompile: one route fails, two agree" {
    var s : string = "261f436a02103f899896ef19d1fe4472523c3cd0bd803983b1888eec90e33dbd";
    var e : string = "3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a58";
    var fe : string = "bootstrap/src/compiler.rs@39fa";
    var c : u8 = route_state(2, "C", "fail", "", e);
    var v : u8 = ddc_receipt_verdict(3, s, s, e, RS_AGREES, RS_AGREES, c, fe, fe, fe);
    assert v == ddc_verdict(RUN_FIRST_ZIG_BUILT, RUN_FIRST_ZIG_EQUAL, true);
    assert v == 1;
}

test "fewer than two routes on S cannot run" {
    var s : string = "261f436a02103f899896ef19d1fe4472523c3cd0bd803983b1888eec90e33dbd";
    var e : string = "3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a58";
    var fe : string = "bootstrap/src/compiler.rs@39fa";
    // T732's run before #6825: only route A built
    var v : u8 = ddc_receipt_verdict(3, s, s, e, RS_AGREES, RS_NOT_RUN, RS_NOT_RUN, fe, fe, fe);
    assert v == ddc_verdict(RUN_BEFORE_BUILT, RUN_BEFORE_EQUAL, true);
    assert v == DDC_CANNOT_RUN;
    assert v == 0;
    assert text_is(DDC_NAMES[v], "DDC_CANNOT_RUN") == true;
    assert ddc_exit(DDC_OK, v) == 3;
    // even a single failing route proves nothing without a second
    assert ddc_receipt_verdict(3, s, s, e, RS_NOT_RUN, RS_DIFFERS, RS_NOT_RUN, fe, fe, fe) == 0;
    // a harness that packs another S, a missing E, a wrong route count: nothing ran on S
    assert ddc_receipt_verdict(3, s, "36baed9b65a777955dd71d28dde6bfa37489125c3dde61208878c03f9f1bc314", e, RS_AGREES, RS_AGREES, RS_AGREES, fe, fe, fe) == 0;
    assert ddc_receipt_verdict(3, s, s, "", RS_DIFFERS, RS_DIFFERS, RS_DIFFERS, fe, fe, fe) == DDC_CANNOT_RUN;
    assert ddc_receipt_verdict(2, s, s, e, RS_AGREES, RS_AGREES, RS_AGREES, fe, "specs/compiler/core/t27core.t27@1", fe) == DDC_CANNOT_RUN;
}

test "two agreeing routes behind different front ends are independent" {
    var s : string = "261f436a02103f899896ef19d1fe4472523c3cd0bd803983b1888eec90e33dbd";
    var e : string = "3efc314e176b846935852d39ce5dbcd28edaa4053383b33b767da5494cff2a58";
    var rs : string = "bootstrap/src/compiler.rs@39fa";
    var own : string = "specs/compiler/core/t27core.t27@261f";
    var v : u8 = ddc_receipt_verdict(3, s, s, e, RS_AGREES, RS_AGREES, RS_AGREES, rs, own, rs);
    assert v == DDC_AGREE_INDEPENDENT;
    assert v == 3;
    assert text_is(DDC_NAMES[v], "DDC_INDEPENDENT") == true;
    assert ddc_exit(DDC_OK, v) == 0;
    assert c4_holds(DDC_OK, v) == true;
    // two routes are enough; the third may not have run
    assert ddc_receipt_verdict(3, s, s, e, RS_NOT_RUN, RS_AGREES, RS_AGREES, rs, own, rs) == 3;
    // ...but the two that ran must differ in front end: the one that did not run does not count
    assert ddc_receipt_verdict(3, s, s, e, RS_AGREES, RS_NOT_RUN, RS_AGREES, rs, own, rs) == DDC_AGREE_BACK_ENDS;
    // two versions of compiler.rs are one front end, and an unnamed one is nobody
    assert ddc_receipt_verdict(3, s, s, e, RS_AGREES, RS_AGREES, RS_AGREES, rs, "bootstrap/src/compiler.rs@0000", rs) == 2;
    assert ddc_receipt_verdict(3, s, s, e, RS_AGREES, RS_AGREES, RS_AGREES, rs, "", "@261f") == 2;
}

test "a receipt of another kind, or one that does not authenticate, has no verdict" {
    assert ddc_first_problem("t27-ddc-receipt-v1", AUTH_MISSING_NONE) == DDC_OK;
    assert ddc_first_problem("t27-corpus-receipt-v1", AUTH_MISSING_NONE) == DDC_WRONG_KIND;
    assert ddc_first_problem("", AUTH_UNSIGNED) == 1;
    assert ddc_first_problem("t27-ddc-receipt-v1", AUTH_BAD_SIGNATURE) == DDC_NOT_AUTHENTIC;
    assert ddc_first_problem("t27-ddc-receipt-v1", AUTH_NONCE_NOT_CHALLENGE) == 2;
    assert ddc_first_problem("t27-ddc-receipt-v2", AUTH_MISSING_NONE) == 1;
    assert ddc_exit(DDC_WRONG_KIND, DDC_AGREE_INDEPENDENT) == DDC_EXIT_REFUSED;
    assert ddc_exit(DDC_NOT_AUTHENTIC, DDC_AGREE_BACK_ENDS) == 2;
    assert c4_holds(DDC_NOT_AUTHENTIC, DDC_AGREE_INDEPENDENT) == false;
    assert c4_holds(DDC_OK, DDC_AGREE_BACK_ENDS) == false;
    assert c4_holds(DDC_OK, DDC_MISCOMPILE) == false;
}

test "the lab runs DDC only when S, E or the front end moved" {
    assert ddc_due(false, 0) == true;
    assert ddc_due(true, 0) == false;
    assert ddc_due(true, 1) == true;
    assert ddc_due(true, 3) == true;
    assert due_exit(true) == 0;
    assert due_exit(false) == 1;
    // the trust level is named, not rooted
    assert HARDWARE_ROOTED == false;
    assert DEVICE_ROOTED_LEVELS == 0;
}
