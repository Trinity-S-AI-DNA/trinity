// SPDX-License-Identifier: Apache-2.0
; specs/verified/corpus_receipt.t27 -- a t27b corpus run as a signed receipt, and two such receipts
; compared. Issue #7576 (epic #6063; t27b in t27 #6198; Verified Compute #6655). This file is the
; contract: `t27c corpus-receipt` runs the code `t27c gen-rust` writes from it, and the lab only
; hands it the run and the binaries.
; --
; What already exists and is NOT restated here:
; - specs/verified/signed_receipt.t27 (R3-1, #7332) owns the scheme (Ed25519), the key registry
;   (KEY_DIR, key ids), the field line `name=value\n`, the nonce rule and the judgment order
;   auth_first_missing / receipt_level. A corpus receipt is judged by exactly those rules; only its
;   domain line and its field list are new.
; - specs/verified/corpus_merkle.t27 computes the roots defined here with
;   specs/tri/crypto/sha256.t27 and checks them against independent vectors. The hash itself is
;   never restated: t27c uses the same SHA-256 (FIPS 180-4) that spec implements.
; --
; Why: until this rule a corpus number in an issue was text anyone could type. A receipt binds the
; numbers to a commit, to the two binaries that produced them and to a verifier's challenge, and
; its Merkle roots let two runs be compared file by file without trusting either summary.
; --
; The rule:
; - The signed message is the domain line CORPUS_DOMAIN, then one signed_receipt field line per
;   field in CORPUS_SIGNED_FIELDS order; value is the field's JSON text as the receipt stores it.
;   The receipt names itself with `kind` = CORPUS_DOMAIN, and only such a receipt is checked
;   against this message: the two domain lines differ, so a signature over one kind of record can
;   never verify as the other.
; - `totals` is the run's summary without the keys in TOTALS_UNSIGNED. timeout_retried counts the
;   files that timed out once under the lab's load and passed on a retry: a count of the runner,
;   not of the commit. Two runs of one commit (9a9d17280) gave 2 and 4, with every root equal.
; - Three leaf lists, each one line per corpus file, each `path TAB value`, sorted by path in byte
;   order (a path holds no TAB, so sorting the lines sorts the paths):
;     input   -- value: lowercase hex SHA-256 of the spec file's bytes, for every file in the run;
;     verdict -- value: the t27b verdict, TAB, the reference verdict, for every file in the run;
;     output  -- value: lowercase hex SHA-256 of `t27b asm <file>` stdout, only for the files whose
;                t27b verdict output_counted() accepts (pass and pass_vacuous: t27b compiled and
;                ran them clean). When asm does not exit 0 on such a file (the object writer lacks
;                a construct the JIT has: 28 of 1007 passing files on the #7576 branch), the value is
;                pair(ASM_FAILED, hex SHA-256 of its stderr): the file keeps a leaf, a change in
;                why it fails changes the leaf, and the leaf can never read as a digest.
; - Each list's root is the RFC 6962 Merkle tree hash: an empty list hashes the empty string; one
;   leaf hashes LEAF_PREFIX then the line; n > 1 leaves split at split_point(n), the largest power
;   of two below n, and hash NODE_PREFIX, the left root, the right root. Not the "duplicate the
;   last leaf" tree: there two different lists can share a root.
; - Comparing two receipts (base, head) is judged in fixed order: the base authenticates, the head
;   authenticates (signed_receipt codes, each against its own challenge when one is given), the
;   base's leaves rehash to its signed roots, the head's do. Authentication comes first because an
;   unauthenticated leaf list is just text. Only a receipt that passes all four is compared:
;   totals, verdict root and output root, and per file a leaf_change() over the leaf lists.
; - The honest ceiling: the key is the lab's (trust level NAMED). It proves the holder of the lab
;   key signed these bytes, for this challenge. It does not prove the run happened on any given
;   machine, and HARDWARE_ROOTED is false.
; --
; A lane's judgment (#7672). A coverage lane is never equivalent to its base, so `compare` also
; judges the pair the way a lane PR needs it judged. Per file, lane_file() reads the two verdict
; leaves and the two output leaves; lane_worst() keeps the most severe answer; lane_verdict() turns
; it into the exit code. The rules:
; - A t27b verdict has a rank, its distance from pass: pass, then pass_vacuous, then the not-yet
;   verdicts (blocked, frontend, codegen, timeout, not run, lab_error: the file does not run here
;   yet), then the defects (mismatch, crash, and a fail the reference does not share; a fail the
;   reference shares is the spec's own failure, so it ranks as not yet). A move to a higher rank
;   is toward pass. Two not-yet verdicts are the same rank: the file still does not run.
; - REGRESSED, in this order: a file only the base has (a lane removes no spec; a removal is its
;   own PR); the reference half of the verdict changed; the rank fell (from pass or pass_vacuous:
;   left-pass; from not yet: a new defect); the head is a defect other than the base's; t27b
;   newly passes where the reference fails (a disagreement); a file passing on both sides whose
;   `t27b asm` worked now fails; or the signed reference_disagree / reference_disagree_tests
;   totals grew. Per-test disagreement is not in the leaves, so the totals carry it.
; - A file only the head has (a new spec) was not measured before: it is judged as a move from
;   not yet. A new passing file is an improvement, a new defect or disagreement regresses, and a
;   new file that does not run yet is neutral.
; - An output change of a file passing on both sides is neutral: its tests still pass and agree,
;   only its asm moved (a lane may change the code of the files it touches). From asm-failed to a
;   digest is an improvement; from a digest to asm-failed regresses.
; - The verdict: REFUSED when compare_first_problem() refuses; REGRESSED as above; EQUIVALENT when
;   compare_exit() says so; IMPROVED_ONLY when some file moved toward pass; NEUTRAL when the pair
;   differs and no file moved either way. Each is the exit code: 0 stays EQUIVALENT only and 2
;   stays REFUSED, so #7576's contract holds; a lane may merge on 0, 3 or 4, never on 1 or 2.
; --
; A lane's request (#7672). The lab signs master as it polls, and a lane asks it for any other
; commit by writing SRV/requests/<sha> (its text: the challenge for the receipt). request_verdict()
; admits it: a 40-digit lowercase hex sha, among the first REQUEST_QUEUE_MAX requests by age, not
; older than REQUEST_AGE_MAX_S, and on origin (a branch head, or a commit on master's first-parent
; line). On origin bounds who can put code in front of the signing step: the people who can
; already push to master. The judge is master's t27c, never the requested commit's.
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedCorpusReceipt;

use verified::signed_receipt;

/// The signed message starts with this line; a receipt's `kind` field carries the same text.
pub const CORPUS_DOMAIN : str = "t27-corpus-receipt-v1";

/// The signed fields, in message order. `leaves`, `key_id` and `signature` are the envelope: the
/// leaves are bound by the three signed roots, not by the signature directly.
pub const CORPUS_SIGNED_FIELDS : [8]str = ["commit", "t27b_sha256", "t27c_sha256", "input_root", "verdict_root", "output_root", "totals", "nonce"];
pub const CORPUS_SIGNED_FIELD_COUNT : u8 = 8;

/// Summary keys left out of the signed totals: they measure the runner, not the commit.
pub const TOTALS_UNSIGNED : [1]str = ["timeout_retried"];

/// The three leaf lists, in the order their roots are signed.
pub const LEAF_LISTS : [3]str = ["input", "verdict", "output"];

/// RFC 6962 section 2.1 domain separation between a leaf and an inner node.
pub const LEAF_PREFIX : u8 = 0;
pub const NODE_PREFIX : u8 = 1;

pub const CH_TAB : u32 = 9;

/// The two t27b verdicts whose asm output is a leaf.
pub const VERDICT_PASS : str = "pass";
pub const VERDICT_PASS_VACUOUS : str = "pass_vacuous";

/// An output leaf's value starts with this when `t27b asm` did not exit 0 on a passing file.
pub const ASM_FAILED : str = "asm-failed";

/// compare_first_problem() answers, in judgment order.
pub const CMP_OK : u8 = 0;
pub const CMP_BASE_AUTH : u8 = 1;
pub const CMP_HEAD_AUTH : u8 = 2;
pub const CMP_BASE_LEAVES : u8 = 3;
pub const CMP_HEAD_LEAVES : u8 = 4;

/// leaf_change() answers for one path.
pub const LEAF_SAME : u8 = 0;
pub const LEAF_ONLY_HEAD : u8 = 1;
pub const LEAF_ONLY_BASE : u8 = 2;
pub const LEAF_CHANGED : u8 = 3;

/// compare_exit() answers: the process exit code of `t27c corpus-receipt compare`.
pub const EXIT_EQUIVALENT : u8 = 0;
pub const EXIT_DIFFERENT : u8 = 1;
pub const EXIT_REFUSED : u8 = 2;

/// The trust ceiling, stated so a reader cannot round it up.
pub const HARDWARE_ROOTED : bool = false;

/// The t27b verdicts a lane's judgment names besides pass and pass_vacuous.
pub const VERDICT_FAIL : str = "fail";
pub const VERDICT_MISMATCH : str = "mismatch";
pub const VERDICT_CRASH : str = "crash";

/// t27b_rank() answers: the distance of a verdict leaf from pass, higher is closer.
pub const RANK_DEFECT : u8 = 0;
pub const RANK_NOT_YET : u8 = 1;
pub const RANK_PASS_VACUOUS : u8 = 2;
pub const RANK_PASS : u8 = 3;

/// lane_file() answers, in rising severity; from FILE_REMOVED on, each one is a regression.
pub const FILE_SAME : u8 = 0;
pub const FILE_NEUTRAL : u8 = 1;
pub const FILE_IMPROVED : u8 = 2;
pub const FILE_REMOVED : u8 = 3;
pub const FILE_REFERENCE_MOVED : u8 = 4;
pub const FILE_LEFT_PASS : u8 = 5;
pub const FILE_NEW_DEFECT : u8 = 6;
pub const FILE_NEW_DISAGREE : u8 = 7;
pub const FILE_ASM_FAILED : u8 = 8;
pub const FILE_NAMES : [9]str = ["same", "neutral", "improved", "removed", "reference-moved", "left-pass", "new-defect", "new-disagree", "asm-failed"];

/// lane_verdict() answers; each is the exit code of `t27c corpus-receipt compare`.
pub const LANE_EQUIVALENT : u8 = 0;
pub const LANE_REGRESSED : u8 = 1;
pub const LANE_REFUSED : u8 = 2;
pub const LANE_IMPROVED_ONLY : u8 = 3;
pub const LANE_NEUTRAL : u8 = 4;
pub const LANE_NAMES : [5]str = ["EQUIVALENT", "REGRESSED", "REFUSED", "IMPROVED_ONLY", "NEUTRAL"];

/// The signed totals that count t27b's per-test disagreements with the reference: files, tests.
pub const DISAGREE_TOTALS : [2]str = ["reference_disagree", "reference_disagree_tests"];

/// request_verdict() answers and their names; request_exit() is the exit code of `admit`.
pub const REQ_ADMIT : u8 = 0;
pub const REQ_BAD_NAME : u8 = 1;
pub const REQ_QUEUE_FULL : u8 = 2;
pub const REQ_EXPIRED : u8 = 3;
pub const REQ_NOT_ON_ORIGIN : u8 = 4;
pub const REQUEST_NAMES : [5]str = ["ADMIT", "BAD_NAME", "QUEUE_FULL", "EXPIRED", "NOT_ON_ORIGIN"];

/// A request names a full commit sha, in git's lowercase spelling.
pub const REQUEST_SHA_LEN : u32 = 40;
/// At most this many requests wait; a lab run takes about 10 minutes.
pub const REQUEST_QUEUE_MAX : u32 = 4;
/// A request not started within 6 hours of being written is dropped unrun.
pub const REQUEST_AGE_MAX_S : u32 = 21600;

; --- The message ---------------------------------------------------------------------------------

/// The first line: CORPUS_DOMAIN, then a newline. Field lines are signed_receipt's.
pub fn corpus_domain_line_len() -> u32 {
    return (CORPUS_DOMAIN.len as u32) + 1;
}

pub fn corpus_domain_line_char(k: u32) -> u32 {
    if (k < (CORPUS_DOMAIN.len as u32)) { return CORPUS_DOMAIN[k] as u32; }
    if (k == (CORPUS_DOMAIN.len as u32)) { return CH_NEWLINE; }
    return LINE_END;
}

; --- Leaves --------------------------------------------------------------------------------------

/// Two texts joined by one TAB, no newline: a leaf is pair(path, value), and a verdict leaf's value
/// is pair(t27b verdict, reference verdict).
pub fn pair_len(a: string, b: string) -> u32 {
    return (a.len as u32) + 1 + (b.len as u32);
}

pub fn pair_char(a: string, b: string, k: u32) -> u32 {
    var n : u32 = a.len as u32;
    if (k < n) { return a[k] as u32; }
    if (k == n) { return CH_TAB; }
    if (k < n + 1 + (b.len as u32)) { return b[k - n - 1] as u32; }
    return LINE_END;
}

/// Byte equality of two texts.
pub fn text_is(a: string, b: string) -> bool {
    if ((a.len as u32) != (b.len as u32)) { return false; }
    var k : u32 = 0;
    while (k < (a.len as u32)) {
        if ((a[k] as u32) != (b[k] as u32)) { return false; }
        k = k + 1;
    }
    return true;
}

/// Whether a file's `t27b asm` output is an output leaf: t27b compiled and ran it clean.
pub fn output_counted(t27b_verdict: string) -> bool {
    if (text_is(t27b_verdict, VERDICT_PASS)) { return true; }
    return text_is(t27b_verdict, VERDICT_PASS_VACUOUS);
}

; --- The Merkle shape ----------------------------------------------------------------------------

/// Where a list of n > 1 leaves splits: the largest power of two strictly below n (RFC 6962 2.1).
/// The left subtree is always complete; for n < 2 the answer is 0 (a single leaf does not split).
pub fn split_point(n: u32) -> u32 {
    if (n < 2) { return 0; }
    var k : u32 = 1;
    while (k * 2 < n) { k = k * 2; }
    return k;
}

; --- Comparing two receipts ----------------------------------------------------------------------

/// The first reason two receipts cannot be compared, or CMP_OK. Each auth argument is that
/// receipt's signed_receipt auth_first_missing code; each bound says its leaves rehash to its roots.
pub fn compare_first_problem(base_auth: u8, head_auth: u8, base_bound: bool, head_bound: bool) -> u8 {
    if (base_auth != AUTH_MISSING_NONE) { return CMP_BASE_AUTH; }
    if (head_auth != AUTH_MISSING_NONE) { return CMP_HEAD_AUTH; }
    if (base_bound == false) { return CMP_BASE_LEAVES; }
    if (head_bound == false) { return CMP_HEAD_LEAVES; }
    return CMP_OK;
}

/// How one path's leaf changed from base to head.
pub fn leaf_change(in_base: bool, in_head: bool, same_value: bool) -> u8 {
    if (in_base == false) {
        if (in_head) { return LEAF_ONLY_HEAD; }
        return LEAF_SAME;
    }
    if (in_head == false) { return LEAF_ONLY_BASE; }
    if (same_value) { return LEAF_SAME; }
    return LEAF_CHANGED;
}

/// Equivalent means the same totals, the same verdicts and the same outputs; anything less is a
/// difference, and a pair that could not be compared is refused, never called equivalent.
pub fn compare_exit(problem: u8, totals_equal: bool, verdicts_equal: bool, outputs_equal: bool) -> u8 {
    if (problem != CMP_OK) { return EXIT_REFUSED; }
    if (totals_equal == false) { return EXIT_DIFFERENT; }
    if (verdicts_equal == false) { return EXIT_DIFFERENT; }
    if (outputs_equal == false) { return EXIT_DIFFERENT; }
    return EXIT_EQUIVALENT;
}

; --- A lane's judgment ---------------------------------------------------------------------------

/// Where the first TAB of a leaf value is, or its length when it has none. A verdict leaf's value
/// is pair(t27b verdict, reference verdict).
pub fn tab_at(v: string) -> u32 {
    var k : u32 = 0;
    while (k < (v.len as u32)) {
        if ((v[k] as u32) == CH_TAB) { return k; }
        k = k + 1;
    }
    return v.len as u32;
}

/// Whether the bytes of v from `from` up to `to` are exactly w.
pub fn part_is(v: string, from: u32, to: u32, w: string) -> bool {
    if (to > (v.len as u32)) { return false; }
    if (to < from) { return false; }
    if (to - from != (w.len as u32)) { return false; }
    var k : u32 = 0;
    while (k < (w.len as u32)) {
        if ((v[from + k] as u32) != (w[k] as u32)) { return false; }
        k = k + 1;
    }
    return true;
}

/// The t27b half of a verdict leaf value is w.
pub fn t27b_is(v: string, w: string) -> bool {
    return part_is(v, 0, tab_at(v), w);
}

/// The reference half of a verdict leaf value is w. A value with no TAB has no reference half:
/// its half would start past its end, which part_is refuses.
pub fn reference_is(v: string, w: string) -> bool {
    return part_is(v, tab_at(v) + 1, v.len as u32, w);
}

/// The two values' reference halves, each from its first TAB on, are byte-equal.
pub fn same_reference(a: string, b: string) -> bool {
    var ta : u32 = tab_at(a);
    var tb : u32 = tab_at(b);
    if ((a.len as u32) - ta != (b.len as u32) - tb) { return false; }
    var k : u32 = 0;
    while (ta + k < (a.len as u32)) {
        if ((a[ta + k] as u32) != (b[tb + k] as u32)) { return false; }
        k = k + 1;
    }
    return true;
}

/// A verdict leaf value's distance from pass. A fail the reference shares is the spec's own.
pub fn t27b_rank(v: string) -> u8 {
    if (t27b_is(v, VERDICT_PASS)) { return RANK_PASS; }
    if (t27b_is(v, VERDICT_PASS_VACUOUS)) { return RANK_PASS_VACUOUS; }
    if (t27b_is(v, VERDICT_MISMATCH)) { return RANK_DEFECT; }
    if (t27b_is(v, VERDICT_CRASH)) { return RANK_DEFECT; }
    if (t27b_is(v, VERDICT_FAIL)) {
        if (reference_is(v, VERDICT_FAIL)) { return RANK_NOT_YET; }
        return RANK_DEFECT;
    }
    return RANK_NOT_YET;
}

/// An output leaf value that records a failed `t27b asm`: pair(ASM_FAILED, hex of its stderr).
pub fn asm_failed(out: string) -> bool {
    var n : u32 = ASM_FAILED.len as u32;
    if ((out.len as u32) <= n) { return false; }
    if (tab_at(out) != n) { return false; }
    return part_is(out, 0, n, ASM_FAILED);
}

/// How one file moved from base to head. base/head are its verdict leaf values and base_out/
/// head_out its output leaf values ("" where that side has no such leaf).
pub fn lane_file(in_base: bool, in_head: bool, base: string, head: string, base_out: string, head_out: string) -> u8 {
    if (in_head == false) {
        if (in_base) { return FILE_REMOVED; }
        return FILE_SAME;
    }
    var hr : u8 = t27b_rank(head);
    var br : u8 = RANK_NOT_YET;
    if (in_base) {
        if (same_reference(base, head) == false) { return FILE_REFERENCE_MOVED; }
        br = t27b_rank(base);
    }
    if (hr < br) {
        if (br >= RANK_PASS_VACUOUS) { return FILE_LEFT_PASS; }
        return FILE_NEW_DEFECT;
    }
    if (hr == RANK_DEFECT) {
        if (text_is(base, head) == false) { return FILE_NEW_DEFECT; }
        return FILE_SAME;
    }
    if (hr >= RANK_PASS_VACUOUS) {
        if (br < RANK_PASS_VACUOUS) {
            if (reference_is(head, VERDICT_FAIL)) { return FILE_NEW_DISAGREE; }
            return FILE_IMPROVED;
        }
        if (asm_failed(head_out)) {
            if (asm_failed(base_out) == false) { return FILE_ASM_FAILED; }
        }
        if (asm_failed(base_out)) {
            if (asm_failed(head_out) == false) { return FILE_IMPROVED; }
        }
    }
    if (hr > br) { return FILE_IMPROVED; }
    if (in_base == false) { return FILE_NEUTRAL; }
    if (text_is(base, head) == false) { return FILE_NEUTRAL; }
    if (text_is(base_out, head_out) == false) { return FILE_NEUTRAL; }
    return FILE_SAME;
}

/// The more severe of two lane_file() answers: the codes rise with severity.
pub fn lane_worst(a: u8, b: u8) -> u8 {
    if (b > a) { return b; }
    return a;
}

/// The pair's verdict and exit code. `exit` is compare_exit(); `worst` is lane_worst() over every
/// file; the four counts are DISAGREE_TOTALS in the base's and the head's signed totals.
pub fn lane_verdict(problem: u8, exit: u8, worst: u8, files_base: u32, files_head: u32, tests_base: u32, tests_head: u32) -> u8 {
    if (problem != CMP_OK) { return LANE_REFUSED; }
    if (worst >= FILE_REMOVED) { return LANE_REGRESSED; }
    if (files_head > files_base) { return LANE_REGRESSED; }
    if (tests_head > tests_base) { return LANE_REGRESSED; }
    if (exit == EXIT_EQUIVALENT) { return LANE_EQUIVALENT; }
    if (worst == FILE_IMPROVED) { return LANE_IMPROVED_ONLY; }
    return LANE_NEUTRAL;
}

; --- A lane's request ----------------------------------------------------------------------------

/// A full commit sha in git's spelling: REQUEST_SHA_LEN lowercase hex digits, so a request name
/// can never be an option, a path or an abbreviation.
pub fn request_name_ok(name: string) -> bool {
    if ((name.len as u32) != REQUEST_SHA_LEN) { return false; }
    var k : u32 = 0;
    var c : u32 = 0;
    while (k < REQUEST_SHA_LEN) {
        c = name[k] as u32;
        if (hex_digit_value(c) == HEX_NOT_A_DIGIT) { return false; }
        if (hex_digit_char(hex_digit_value(c)) != c) { return false; }
        k = k + 1;
    }
    return true;
}

/// Whether the lab runs a request. `index` is its place among the waiting requests, oldest first;
/// `age_s` is how long it has waited; `on_origin` says its sha is a branch head on origin or a
/// commit on master's first-parent line. The name is judged first: nothing else is read for a
/// name that is not a sha.
pub fn request_verdict(name: string, age_s: u32, index: u32, on_origin: bool) -> u8 {
    if (request_name_ok(name) == false) { return REQ_BAD_NAME; }
    if (index >= REQUEST_QUEUE_MAX) { return REQ_QUEUE_FULL; }
    if (age_s > REQUEST_AGE_MAX_S) { return REQ_EXPIRED; }
    if (on_origin == false) { return REQ_NOT_ON_ORIGIN; }
    return REQ_ADMIT;
}

/// `admit` exits 0 to run the request and 1 to drop it. Any other exit (an older t27c with no
/// `admit`) leaves the request waiting, so a judge that cannot judge never drops one.
pub fn request_exit(verdict: u8) -> u8 {
    if (verdict == REQ_ADMIT) { return 0; }
    return 1;
}

; --- Tests ---------------------------------------------------------------------------------------

test "the corpus message starts with its own domain line" {
    assert corpus_domain_line_len() == 22;
    assert corpus_domain_line_char(0) == 116;
    assert corpus_domain_line_char(3) == 45;
    assert corpus_domain_line_char(4) == 99;
    assert corpus_domain_line_char(20) == 49;
    assert corpus_domain_line_char(21) == CH_NEWLINE;
    assert corpus_domain_line_char(22) == LINE_END;
}

test "the corpus domain line is not the hardware receipt's" {
    assert corpus_domain_line_len() != domain_line_len();
    assert corpus_domain_line_char(4) != domain_line_char(4);
}

test "eight signed fields, the nonce among them, three leaf lists" {
    assert CORPUS_SIGNED_FIELD_COUNT == 8;
    assert text_is(CORPUS_SIGNED_FIELDS[0], "commit") == true;
    assert text_is(CORPUS_SIGNED_FIELDS[5], "output_root") == true;
    assert text_is(CORPUS_SIGNED_FIELDS[7], "nonce") == true;
    assert text_is(LEAF_LISTS[0], "input") == true;
    assert text_is(LEAF_LISTS[2], "output") == true;
}

test "a leaf is path, tab, value, with no newline" {
    assert pair_len("a.t27", "pass") == 10;
    assert pair_char("a.t27", "pass", 0) == 97;
    assert pair_char("a.t27", "pass", 4) == 55;
    assert pair_char("a.t27", "pass", 5) == CH_TAB;
    assert pair_char("a.t27", "pass", 6) == 112;
    assert pair_char("a.t27", "pass", 9) == 115;
    assert pair_char("a.t27", "pass", 10) == LINE_END;
}

test "an empty side of a pair still has its tab" {
    assert pair_len("", "x") == 2;
    assert pair_char("", "x", 0) == CH_TAB;
    assert pair_char("", "x", 1) == 120;
    assert pair_char("p", "", 1) == CH_TAB;
    assert pair_char("p", "", 2) == LINE_END;
}

test "the retry count is left out of the totals, the timeout count is not" {
    assert text_is(TOTALS_UNSIGNED[0], "timeout_retried") == true;
    assert text_is(TOTALS_UNSIGNED[0], "timeout") == false;
}

test "a failed asm is a leaf of its own, never a digest" {
    assert pair_len(ASM_FAILED, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") == 75;
    assert pair_char(ASM_FAILED, "e3", 10) == CH_TAB;
    assert text_is(ASM_FAILED, "asm-failed") == true;
    assert text_is(ASM_FAILED, "") == false;
}

test "text equality is byte equality, length first" {
    assert text_is("pass", "pass") == true;
    assert text_is("pass", "pas") == false;
    assert text_is("pas", "pass") == false;
    assert text_is("pass", "past") == false;
    assert text_is("", "") == true;
}

test "only a clean pass contributes an output leaf" {
    assert output_counted("pass") == true;
    assert output_counted("pass_vacuous") == true;
    assert output_counted("fail") == false;
    assert output_counted("crash") == false;
    assert output_counted("timeout") == false;
    assert output_counted("mismatch") == false;
    assert output_counted("passed") == false;
    assert output_counted("") == false;
}

test "a list splits at the largest power of two below its length" {
    assert split_point(0) == 0;
    assert split_point(1) == 0;
    assert split_point(2) == 1;
    assert split_point(3) == 2;
    assert split_point(4) == 2;
    assert split_point(5) == 4;
    assert split_point(7) == 4;
    assert split_point(8) == 4;
    assert split_point(9) == 8;
    assert split_point(1559) == 1024;
}

test "authentication is judged before the leaves, base before head" {
    assert compare_first_problem(0, 0, true, true) == CMP_OK;
    assert compare_first_problem(AUTH_BAD_SIGNATURE, 0, true, true) == CMP_BASE_AUTH;
    assert compare_first_problem(0, AUTH_NONCE_NOT_CHALLENGE, true, true) == CMP_HEAD_AUTH;
    assert compare_first_problem(AUTH_UNSIGNED, AUTH_UNSIGNED, false, false) == CMP_BASE_AUTH;
    assert compare_first_problem(0, AUTH_UNSIGNED, false, false) == CMP_HEAD_AUTH;
    assert compare_first_problem(0, 0, false, true) == CMP_BASE_LEAVES;
    assert compare_first_problem(0, 0, false, false) == CMP_BASE_LEAVES;
    assert compare_first_problem(0, 0, true, false) == CMP_HEAD_LEAVES;
}

test "a leaf is added, removed, changed or the same" {
    assert leaf_change(true, true, true) == LEAF_SAME;
    assert leaf_change(true, true, false) == LEAF_CHANGED;
    assert leaf_change(false, true, false) == LEAF_ONLY_HEAD;
    assert leaf_change(true, false, false) == LEAF_ONLY_BASE;
    assert leaf_change(false, false, false) == LEAF_SAME;
}

test "equivalent needs all three equal; a refused pair is never equivalent" {
    assert compare_exit(CMP_OK, true, true, true) == EXIT_EQUIVALENT;
    assert compare_exit(CMP_OK, false, true, true) == EXIT_DIFFERENT;
    assert compare_exit(CMP_OK, true, false, true) == EXIT_DIFFERENT;
    assert compare_exit(CMP_OK, true, true, false) == EXIT_DIFFERENT;
    assert compare_exit(CMP_BASE_AUTH, true, true, true) == EXIT_REFUSED;
    assert compare_exit(CMP_HEAD_LEAVES, true, true, true) == EXIT_REFUSED;
    assert compare_exit(CMP_HEAD_AUTH, false, false, false) == 2;
    // the trust level is named, not rooted
    assert HARDWARE_ROOTED == false;
    assert DEVICE_ROOTED_LEVELS == 0;
}

test "a verdict leaf value splits at its first tab" {
    assert tab_at("pass\tpass") == 4;
    assert tab_at("pass_vacuous\tblocked") == 12;
    assert tab_at("a\tb\tc") == 1;
    assert tab_at("\tx") == 0;
    assert tab_at("pass") == 4;
    assert tab_at("") == 0;
}

test "part_is compares exactly the bytes between from and to" {
    assert part_is("fail\tpass", 0, 4, "fail") == true;
    assert part_is("fail\tpass", 5, 9, "pass") == true;
    assert part_is("fail\tpass", 0, 3, "fail") == false;
    assert part_is("fail\tpass", 0, 4, "fall") == false;
    assert part_is("fail\tpass", 5, 9, "pasS") == false;
    assert part_is("fail", 0, 5, "fail!") == false;
    assert part_is("fail", 3, 2, "") == false;
    assert part_is("fail", 2, 2, "") == true;
}

test "each half of a verdict leaf value is read on its own" {
    assert t27b_is("pass\tfail", "pass") == true;
    assert t27b_is("pass\tfail", "fail") == false;
    assert t27b_is("pass_vacuous\tpass", "pass") == false;
    assert reference_is("pass\tfail", "fail") == true;
    assert reference_is("pass\tfail", "pass") == false;
    assert reference_is("fail", "fail") == false;
    assert reference_is("fail", "") == false;
    assert reference_is("pass\t", "") == true;
}

test "two reference halves are compared from the tab on" {
    assert same_reference("pass\tpass", "blocked\tpass") == true;
    assert same_reference("pass\tpass", "pass\tfail") == false;
    assert same_reference("pass\tpass", "pass\tpasses") == false;
    assert same_reference("a\tbc", "a\tbd") == false;
    assert same_reference("pass\t", "pass") == false;
    assert same_reference("pass", "blocked") == true;
}

test "a verdict's rank is its distance from pass" {
    assert t27b_rank("pass\tpass") == RANK_PASS;
    assert t27b_rank("pass_vacuous\tpass") == RANK_PASS_VACUOUS;
    assert t27b_rank("blocked\tpass") == RANK_NOT_YET;
    assert t27b_rank("frontend\tpass") == RANK_NOT_YET;
    assert t27b_rank("timeout\tpass") == RANK_NOT_YET;
    assert t27b_rank("mismatch\tpass") == RANK_DEFECT;
    assert t27b_rank("crash\tblocked") == RANK_DEFECT;
    assert t27b_rank("fail\tpass") == RANK_DEFECT;
    assert t27b_rank("fail\tblocked") == RANK_DEFECT;
    assert t27b_rank("fail\tfail") == RANK_NOT_YET;
    assert t27b_rank("passed\tpass") == RANK_NOT_YET;
    assert RANK_DEFECT < RANK_NOT_YET;
    assert RANK_NOT_YET < RANK_PASS_VACUOUS;
    assert RANK_PASS_VACUOUS < RANK_PASS;
}

test "a failed asm is its prefix and a tab, never a digest" {
    assert asm_failed("asm-failed\te3b0") == true;
    assert asm_failed("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") == false;
    assert asm_failed("asm-failed") == false;
    assert asm_failed("asm-faile\tx") == false;
    assert asm_failed("asm-failedx\ty") == false;
    assert asm_failed("ASM-FAILED\tx") == false;
    assert asm_failed("") == false;
}

test "a file only the base has is removed; one neither has is the same" {
    assert lane_file(true, false, "blocked\tpass", "", "", "") == FILE_REMOVED;
    assert lane_file(true, false, "pass\tpass", "", "d1", "") == FILE_REMOVED;
    assert lane_file(false, false, "", "", "", "") == FILE_SAME;
}

test "a new file is judged as a move from not yet" {
    assert lane_file(false, true, "", "pass\tpass", "", "d1") == FILE_IMPROVED;
    assert lane_file(false, true, "", "pass_vacuous\tpass", "", "d1") == FILE_IMPROVED;
    assert lane_file(false, true, "", "pass\tblocked", "", "d1") == FILE_IMPROVED;
    assert lane_file(false, true, "", "blocked\tpass", "", "") == FILE_NEUTRAL;
    assert lane_file(false, true, "", "fail\tfail", "", "") == FILE_NEUTRAL;
    assert lane_file(false, true, "", "mismatch\tpass", "", "") == FILE_NEW_DEFECT;
    assert lane_file(false, true, "", "fail\tpass", "", "") == FILE_NEW_DEFECT;
    assert lane_file(false, true, "", "pass\tfail", "", "d1") == FILE_NEW_DISAGREE;
    assert lane_file(false, true, "", "pass_vacuous\tfail", "", "d1") == FILE_NEW_DISAGREE;
    // the base value of a file the base lacks is never read
    assert lane_file(false, true, "blocked\tpass", "blocked\tpass", "", "") == FILE_NEUTRAL;
}

test "a moved reference regresses before the t27b half is read" {
    assert lane_file(true, true, "blocked\tpass", "pass\tfail", "", "d1") == FILE_REFERENCE_MOVED;
    assert lane_file(true, true, "pass\tpass", "pass\tblocked", "d1", "d1") == FILE_REFERENCE_MOVED;
    assert lane_file(true, true, "blocked\tfail", "blocked\tpass", "", "") == FILE_REFERENCE_MOVED;
}

test "leaving pass regresses, from pass_vacuous too" {
    assert lane_file(true, true, "pass\tpass", "pass_vacuous\tpass", "d1", "d1") == FILE_LEFT_PASS;
    assert lane_file(true, true, "pass\tpass", "blocked\tpass", "d1", "") == FILE_LEFT_PASS;
    assert lane_file(true, true, "pass\tpass", "timeout\tpass", "d1", "") == FILE_LEFT_PASS;
    assert lane_file(true, true, "pass\tpass", "mismatch\tpass", "d1", "") == FILE_LEFT_PASS;
    assert lane_file(true, true, "pass_vacuous\tpass", "blocked\tpass", "d1", "") == FILE_LEFT_PASS;
}

test "a new defect regresses; a refusal in place of a defect improves" {
    assert lane_file(true, true, "blocked\tpass", "mismatch\tpass", "", "") == FILE_NEW_DEFECT;
    assert lane_file(true, true, "blocked\tpass", "crash\tpass", "", "") == FILE_NEW_DEFECT;
    assert lane_file(true, true, "blocked\tpass", "fail\tpass", "", "") == FILE_NEW_DEFECT;
    assert lane_file(true, true, "fail\tpass", "mismatch\tpass", "", "") == FILE_NEW_DEFECT;
    assert lane_file(true, true, "mismatch\tpass", "mismatch\tpass", "", "") == FILE_SAME;
    assert lane_file(true, true, "mismatch\tpass", "blocked\tpass", "", "") == FILE_IMPROVED;
    assert lane_file(true, true, "blocked\tfail", "fail\tfail", "", "") == FILE_NEUTRAL;
}

test "moving to pass improves, unless the reference fails there" {
    assert lane_file(true, true, "blocked\tpass", "pass\tpass", "", "d1") == FILE_IMPROVED;
    assert lane_file(true, true, "blocked\tpass", "pass_vacuous\tpass", "", "d1") == FILE_IMPROVED;
    assert lane_file(true, true, "pass_vacuous\tpass", "pass\tpass", "d1", "d1") == FILE_IMPROVED;
    assert lane_file(true, true, "mismatch\tpass", "pass\tpass", "", "d1") == FILE_IMPROVED;
    assert lane_file(true, true, "blocked\tfail", "pass\tfail", "", "d1") == FILE_NEW_DISAGREE;
    assert lane_file(true, true, "pass_vacuous\tfail", "pass\tfail", "d1", "d1") == FILE_IMPROVED;
    assert lane_file(true, true, "pass\tfail", "pass\tfail", "d1", "d1") == FILE_SAME;
}

test "the asm of a file passing on both sides may move; a failing asm regresses" {
    assert lane_file(true, true, "pass\tpass", "pass\tpass", "d1", "d2") == FILE_NEUTRAL;
    assert lane_file(true, true, "pass\tpass", "pass\tpass", "d1", "d1") == FILE_SAME;
    assert lane_file(true, true, "pass\tpass", "pass\tpass", "d1", "asm-failed\te1") == FILE_ASM_FAILED;
    assert lane_file(true, true, "pass\tpass", "pass\tpass", "asm-failed\te1", "d1") == FILE_IMPROVED;
    assert lane_file(true, true, "pass\tpass", "pass\tpass", "asm-failed\te1", "asm-failed\te2") == FILE_NEUTRAL;
    assert lane_file(true, true, "pass_vacuous\tpass", "pass\tpass", "d1", "asm-failed\te1") == FILE_ASM_FAILED;
    assert lane_file(true, true, "pass_vacuous\tpass", "pass_vacuous\tpass", "d1", "d2") == FILE_NEUTRAL;
    assert lane_file(true, true, "pass_vacuous\tpass", "pass_vacuous\tpass", "d1", "asm-failed\te1") == FILE_ASM_FAILED;
}

test "a file that still does not run moves sideways, neither toward nor away from pass" {
    assert lane_file(true, true, "blocked\tpass", "frontend\tpass", "", "") == FILE_NEUTRAL;
    assert lane_file(true, true, "blocked\tpass", "timeout\tpass", "", "") == FILE_NEUTRAL;
    assert lane_file(true, true, "blocked\tpass", "blocked\tpass", "", "") == FILE_SAME;
}

test "the most severe file answer wins, and severity rises with the code" {
    assert lane_worst(FILE_SAME, FILE_IMPROVED) == FILE_IMPROVED;
    assert lane_worst(FILE_IMPROVED, FILE_NEUTRAL) == FILE_IMPROVED;
    assert lane_worst(FILE_LEFT_PASS, FILE_IMPROVED) == FILE_LEFT_PASS;
    assert lane_worst(FILE_SAME, FILE_SAME) == FILE_SAME;
    assert FILE_NEUTRAL < FILE_IMPROVED;
    assert FILE_IMPROVED < FILE_REMOVED;
    assert FILE_REMOVED < FILE_ASM_FAILED;
    assert text_is(FILE_NAMES[FILE_IMPROVED], "improved") == true;
    assert text_is(FILE_NAMES[FILE_NEW_DISAGREE], "new-disagree") == true;
    assert text_is(FILE_NAMES[FILE_ASM_FAILED], "asm-failed") == true;
}

test "the lane verdict: refused, regressed, equivalent, improved only, neutral" {
    assert lane_verdict(CMP_BASE_AUTH, EXIT_EQUIVALENT, FILE_SAME, 0, 0, 0, 0) == LANE_REFUSED;
    assert lane_verdict(CMP_HEAD_LEAVES, EXIT_DIFFERENT, FILE_LEFT_PASS, 0, 0, 0, 0) == LANE_REFUSED;
    assert lane_verdict(CMP_OK, EXIT_DIFFERENT, FILE_REMOVED, 0, 0, 0, 0) == LANE_REGRESSED;
    assert lane_verdict(CMP_OK, EXIT_DIFFERENT, FILE_ASM_FAILED, 0, 0, 0, 0) == LANE_REGRESSED;
    assert lane_verdict(CMP_OK, EXIT_DIFFERENT, FILE_IMPROVED, 0, 1, 0, 0) == LANE_REGRESSED;
    assert lane_verdict(CMP_OK, EXIT_DIFFERENT, FILE_IMPROVED, 1, 1, 2, 3) == LANE_REGRESSED;
    assert lane_verdict(CMP_OK, EXIT_DIFFERENT, FILE_IMPROVED, 1, 1, 3, 3) == LANE_IMPROVED_ONLY;
    assert lane_verdict(CMP_OK, EXIT_DIFFERENT, FILE_IMPROVED, 1, 0, 3, 2) == LANE_IMPROVED_ONLY;
    assert lane_verdict(CMP_OK, EXIT_EQUIVALENT, FILE_SAME, 0, 0, 0, 0) == LANE_EQUIVALENT;
    assert lane_verdict(CMP_OK, EXIT_DIFFERENT, FILE_NEUTRAL, 0, 0, 0, 0) == LANE_NEUTRAL;
    assert lane_verdict(CMP_OK, EXIT_DIFFERENT, FILE_SAME, 0, 0, 0, 0) == LANE_NEUTRAL;
}

test "the lane exit codes keep the compare contract" {
    assert LANE_EQUIVALENT == EXIT_EQUIVALENT;
    assert LANE_REFUSED == EXIT_REFUSED;
    assert LANE_REGRESSED == EXIT_DIFFERENT;
    assert text_is(LANE_NAMES[LANE_IMPROVED_ONLY], "IMPROVED_ONLY") == true;
    assert text_is(LANE_NAMES[LANE_REGRESSED], "REGRESSED") == true;
    assert text_is(LANE_NAMES[LANE_NEUTRAL], "NEUTRAL") == true;
    assert text_is(DISAGREE_TOTALS[0], "reference_disagree") == true;
    assert text_is(DISAGREE_TOTALS[1], "reference_disagree_tests") == true;
}

test "a request names a full lowercase sha and nothing else" {
    assert request_name_ok("5f308712519557028d680357280bcc941e0ec222") == true;
    assert request_name_ok("0123456789abcdef0123456789abcdef01234567") == true;
    assert request_name_ok("5F308712519557028D680357280BCC941E0EC222") == false;
    assert request_name_ok("5f308712519557028d680357280bcc941e0ec22g") == false;
    assert request_name_ok("5f308712519557028d680357280bcc941e0ec22") == false;
    assert request_name_ok("5f308712519557028d680357280bcc941e0ec2223") == false;
    assert request_name_ok("--upload-pack=touch_x;5f308712519557028d") == false;
    assert request_name_ok("") == false;
}

test "a request runs only when every bound holds, its name judged first" {
    assert request_verdict("5f308712519557028d680357280bcc941e0ec222", 0, 0, true) == REQ_ADMIT;
    assert request_verdict("5f308712519557028d680357280bcc941e0ec222", 21600, 3, true) == REQ_ADMIT;
    assert request_verdict("5f308712519557028d680357280bcc941e0ec222", 21601, 0, true) == REQ_EXPIRED;
    assert request_verdict("5f308712519557028d680357280bcc941e0ec222", 0, 4, true) == REQ_QUEUE_FULL;
    assert request_verdict("5f308712519557028d680357280bcc941e0ec222", 0, 0, false) == REQ_NOT_ON_ORIGIN;
    assert request_verdict("5f308712519557028d680357280bcc941e0ec222", 99999, 9, false) == REQ_QUEUE_FULL;
    assert request_verdict("5f308712519557028d680357280bcc941e0ec222", 99999, 0, false) == REQ_EXPIRED;
    assert request_verdict("HEAD", 0, 0, true) == REQ_BAD_NAME;
    assert request_verdict("HEAD", 99999, 9, false) == REQ_BAD_NAME;
    assert text_is(REQUEST_NAMES[REQ_NOT_ON_ORIGIN], "NOT_ON_ORIGIN") == true;
    assert text_is(REQUEST_NAMES[REQ_ADMIT], "ADMIT") == true;
    assert request_exit(REQ_ADMIT) == 0;
    assert request_exit(REQ_BAD_NAME) == 1;
    assert request_exit(REQ_NOT_ON_ORIGIN) == 1;
    assert REQUEST_SHA_LEN == 40;
    assert REQUEST_QUEUE_MAX == 4;
    assert REQUEST_AGE_MAX_S == 21600;
}
