// SPDX-License-Identifier: Apache-2.0
; specs/verified/run_record.t27 -- the run record: when a set of receipts is ONE verified run, and
; when such a record may stand as the run reference of a verdict record. Epic gHashTag/t27#6655,
; Round 2, R2-4 (one run record per verified run; issue #7058).
; --
; What already exists and is NOT restated here:
; - specs/verified/receipt.t27 (#6943) owns the shape of ONE receipt: six fields, fixed order,
;   first-missing, producer named. A run record is a SET of receipts; this file says when the set
;   is a run, not when a receipt is a receipt.
; - specs/verified/verdict.t27 (#6732) owns record_status: a verdict record names run, artifact,
;   evidence, judged in that order before the chain is read. The run reference it names is a
;   record of THIS shape -- that is the consumption point R2-4 exists for.
; - `t27c verdict` already refuses fewer than three seeds (T619a) and requires AGREED ACROSS
;   3 PLACEMENTS: place-and-route is not function-preserving (W842), so one placement decides
;   nothing. placements_needed() gives that number one home as a rule.
; - specs/verified/failure_loop.t27 (#6705) owns what happens after a completed run that failed.
; --
; The run-record rule:
; - One verified run is at least three receipts (T619a), every receipt complete by receipt.t27's
;   rule, all verdict words agreeing, and every receipt naming its own seal's producer (R2-2: a
;   receipt citing someone else's seal is a claim about someone else's work).
; - Judged in fixed order: count, completeness, agreement, producer. Count is judged first because
;   below three receipts agreement is vacuous -- it cannot be judged on a set the rule already
;   refuses.
; - An unknown verdict word never reaches the agreement test: receipt.t27 counts it absent, its
;   receipt goes incomplete, and this file answers RUN_RECEIPT_INCOMPLETE.
; - Which word the receipts agree on is not this file's business: a run of agreeing FAILs is one
;   complete run recording a failure, and the failure loop owns what happens next.
; - A verdict record may cite a run record as its run reference only when the run is complete. An
;   incomplete run is no run reference at all: verdict.t27 answers INVALID_NO_RUN before it reads
;   anything else, and this file does not soften that.
; Tests pin literal codes where a fact names itself, so renumbering the constants cannot pass.
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedRunRecord;

use verified::receipt;
use verified::verdict;
use verified::evidence_chain;

/// run_first_missing() answers, in run order.
pub const RUN_MISSING_NONE : u8 = 0;
pub const RUN_TOO_FEW_RECEIPTS : u8 = 1;
pub const RUN_RECEIPT_INCOMPLETE : u8 = 2;
pub const RUN_WORDS_DISAGREE : u8 = 3;
pub const RUN_PRODUCER_MISMATCH : u8 = 4;

/// The number of placements a verdict is built over (T619a): fewer is refused, because
/// place-and-route is not function-preserving and one placement decides nothing (W842).
pub fn placements_needed() -> u8 {
    return 3;
}

/// The first fact that keeps this set of receipts from being one verified run, or RUN_MISSING_NONE.
pub fn run_first_missing(receipt_count: u8, all_receipts_complete: bool, verdict_words_agree: bool, producers_match_seal: bool) -> u8 {
    if (receipt_count < placements_needed()) { return RUN_TOO_FEW_RECEIPTS; }
    if (all_receipts_complete == false) { return RUN_RECEIPT_INCOMPLETE; }
    if (verdict_words_agree == false) { return RUN_WORDS_DISAGREE; }
    if (producers_match_seal == false) { return RUN_PRODUCER_MISMATCH; }
    return RUN_MISSING_NONE;
}

/// Whether these receipts are one verified run. Complete is reported, never repaired: the tool
/// collects the receipts, the rule reads them.
pub fn run_complete(receipt_count: u8, all_receipts_complete: bool, verdict_words_agree: bool, producers_match_seal: bool) -> bool {
    return run_first_missing(receipt_count, all_receipts_complete, verdict_words_agree, producers_match_seal) == RUN_MISSING_NONE;
}

/// The consumption point (R2-4): may a verdict record cite this run as its run reference?
/// A complete run is a run reference; an incomplete one is not, and verdict.t27 says which
/// reference is missing, in its order, before any chain is read.
pub fn verdict_run_reference(run_code: u8, has_artifact_id: bool, has_evidence_id: bool, chain_code: u8) -> u8 {
    return record_status(run_code == RUN_MISSING_NONE, has_artifact_id, has_evidence_id, chain_code);
}

test "three complete agreeing sealed receipts are one run" {
    assert run_first_missing(3, true, true, true) == RUN_MISSING_NONE;
    assert run_complete(3, true, true, true) == true;
    // at least three, not exactly three
    assert run_first_missing(5, true, true, true) == RUN_MISSING_NONE;
}

test "fewer than three receipts is not a run, whatever else holds" {
    assert run_first_missing(2, true, true, true) == RUN_TOO_FEW_RECEIPTS;
    // count is judged first: below three, agreement cannot be judged at all
    assert run_first_missing(0, false, false, false) == RUN_TOO_FEW_RECEIPTS;
    assert run_complete(2, true, true, true) == false;
}

test "each missing run fact names itself, in run order" {
    assert run_first_missing(2, true, true, true) == 1;
    assert run_first_missing(3, false, false, false) == 2;
    assert run_first_missing(3, true, false, false) == 3;
    assert run_first_missing(3, true, true, false) == 4;
    assert run_first_missing(3, true, true, true) == 0;
}

test "an incomplete receipt among them names the run incomplete" {
    assert run_first_missing(3, false, true, true) == RUN_RECEIPT_INCOMPLETE;
    assert run_complete(3, false, true, true) == false;
}

test "disagreeing words are not one verdict over the spec" {
    assert run_first_missing(3, true, false, true) == RUN_WORDS_DISAGREE;
    assert run_complete(3, true, false, true) == false;
}

test "a receipt citing someone else's seal is not this run's evidence" {
    assert run_first_missing(3, true, true, false) == RUN_PRODUCER_MISMATCH;
    assert run_complete(3, true, true, false) == false;
    // the fact read here is receipt.t27's producer_matches, held for every receipt in the set
    assert producer_matches(9, 9) == true;
    assert producer_matches(9, 8) == false;
}

test "three is the number of placements a verdict is built over" {
    assert placements_needed() == 3;
    assert run_first_missing(placements_needed(), true, true, true) == RUN_MISSING_NONE;
}

test "a complete run may be the run reference of a verdict record" {
    assert verdict_run_reference(RUN_MISSING_NONE, true, true, LINKED) == PASS;
}

test "an incomplete run is no run reference at all, judged before the chain" {
    assert verdict_run_reference(RUN_TOO_FEW_RECEIPTS, false, false, NO_TESTS) == INVALID_NO_RUN;
    assert verdict_run_reference(RUN_PRODUCER_MISMATCH, true, true, LINKED) == INVALID_NO_RUN;
    assert verdict_run_reference(RUN_TOO_FEW_RECEIPTS, false, false, NO_TESTS) == 2;
}

test "the receipts a run is built from are complete by receipt.t27's rule" {
    assert receipt_first_missing(true, true, true, true, true, true) == MISSING_NONE;
    assert receipt_complete(true, true, true, true, true, true) == true;
    // an unknown verdict word makes its receipt incomplete first, so agreement never sees it
    assert receipt_complete(true, true, verdict_word_known(7), true, true, true) == false;
}
