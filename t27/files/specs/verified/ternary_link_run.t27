// SPDX-License-Identifier: Apache-2.0
; specs/verified/ternary_link_run.t27 -- the run citation: a verdict record whose run reference is
; the 2026-10-07 ternary_link silicon run, read off the XC7A200T bench. Epic gHashTag/t27#6655,
; Round 2 R2-5 capstone (issue #7177): the chain receipt -> run record -> citation, end to end on
; real hardware, with the post-#7044 writer and the #7130 reader.
; --
; What already exists and is NOT restated here:
; - specs/verified/receipt.t27 (#6943) owns the shape of ONE receipt: six fields, fixed order.
; - specs/verified/run_record.t27 (#7061) owns when a set of receipts is one verified run, and its
;   verdict_run_reference() is the consumption point this record exercises.
; - specs/verified/verdict.t27 (#6732) owns record_status: run, artifact, evidence, judged in that
;   order before the chain is read.
; - .trinity/receipts/*.json are the machine-readable run; this file is the record that cites it.
; --
; The measured facts of the run (bench, 2026-10-07):
; - Three placements of specs/fpga/ternary_link.t27, pnr seeds 1, 7, 42 (T619a/W842: a verdict
;   decides nothing on one placement). Command shape:
;   t27c silicon --busdev-num 0:2 --pnr-seed S --top fpga/verilog/ternary_link_jtag.v
;     --wrong-part fpga/verilog/ternary_mac_demo_top.bit specs/fpga/ternary_link.t27
; - Every placement: wrong-part control Done=0, our bitstream Done=1, full IDCODE read live
;   0x3636093, verdict 0xa5a532bf (design 10, clauses=1111, ok=1) -- the same word Phase H read.
; - Every receipt complete: seeds carried, seal_hash = the seal's gen_hash_verilog
;   sha256:a769f41ecf2da17a27d68cabd5f0a132f010b89a3d08eade51a454ba8064e7fa, toolchain =
;   the seal's built_by t27c-bootstrap@0.4.0+df00ec428 (R2-2: a receipt names its own producer).
; - t27c run-record specs/fpga/ternary_link.t27: RUN_MISSING_NONE, "Run complete: yes",
;   "may cite this run", exit 0.
; - A fourth, seedless placement (no --pnr-seed) wrote a receipt with seeds absent; the reader
;   judged the set RUN_RECEIPT_INCOMPLETE, so it was removed and the run redone seeded. The
;   writer and the reader agree: a receipt without its seeds is not complete. Pinned below.
; phi^2 + 1/phi^2 = 3 | TRINITY

module TernaryLinkRunCitation;

use verified::run_record;
use verified::verdict;
use verified::evidence_chain;

/// The run this record cites: three placements, judged by the reader as one complete run.
pub const RUN_RECEIPTS : u8 = 3;
/// The verdict word every placement of this run read off the die: PASS (receipt word 0).
pub const WORD_OBSERVED : u8 = 0;

/// The citation itself: this run's code read through the consumption point. The artifact and the
/// evidence are named -- the seal (.trinity/seals/fpga_ZeroDSP_TernaryLink.json, gen_hash_verilog
/// above) and the receipts (.trinity/receipts/ternary_link-*.json) -- so the record reaches the
/// chain, and INVALID_NO_ARTIFACT / INVALID_NO_EVIDENCE cannot be its answer.
pub fn cites_run(run_code: u8, chain_code: u8) -> u8 {
    return verdict_run_reference(run_code, true, true, chain_code);
}

; Three complete agreeing producer-matched receipts, exactly as the reader judged them (exit 0).
test "the measured run is one complete run" {
    assert run_first_missing(RUN_RECEIPTS, true, true, true) == RUN_MISSING_NONE;
    assert run_complete(RUN_RECEIPTS, true, true, true) == true;
}

; The consumption point on the real run's code and a whole chain.
test "the citation answers PASS on the measured run" {
    assert cites_run(RUN_MISSING_NONE, LINKED) == PASS;
    assert cites_run(RUN_MISSING_NONE, LINKED) == 0;
}

; Each break named as it happened or could have happened on the bench: a seedless receipt (the
; fourth placement, removed and redone), two placements, disagreeing words, a foreign producer.
test "every run fact is load-bearing: break one, the citation dies" {
    assert run_first_missing(RUN_RECEIPTS, false, true, true) == RUN_RECEIPT_INCOMPLETE;
    assert cites_run(RUN_RECEIPT_INCOMPLETE, LINKED) == INVALID_NO_RUN;
    assert run_first_missing(2, true, true, true) == RUN_TOO_FEW_RECEIPTS;
    assert cites_run(RUN_TOO_FEW_RECEIPTS, LINKED) == INVALID_NO_RUN;
    assert cites_run(RUN_WORDS_DISAGREE, LINKED) == INVALID_NO_RUN;
    assert cites_run(RUN_PRODUCER_MISMATCH, LINKED) == INVALID_NO_RUN;
}

; The references are whole, so the record is read; the chain is what is broken.
test "a broken chain is a FAIL verdict, not an invalid record" {
    assert cites_run(RUN_MISSING_NONE, NO_CHANGE) == FAIL;
    assert cites_run(RUN_MISSING_NONE, RUN_OTHER_CHANGE) == FAIL;
    assert run_verdict(LINKED) == PASS;
}

; 0xa5a532bf on the die read ok=1: receipt word 0. A word the vocabulary does not define is not a
; stricter verdict; the reader counts it absent (pinned in run_record.t27).
test "the observed word is the word the vocabulary defines" {
    assert WORD_OBSERVED == PASS;
    assert WORD_OBSERVED != FAIL;
}
