// SPDX-License-Identifier: Apache-2.0
; specs/verified/independence.t27 -- when a run's three placements are independent evidence:
; agreement across distinct dies, and across distinct operators. Epic gHashTag/t27#6655, Round 3,
; item R3-3 (issue #7497).
; --
; What already exists and is NOT restated here:
; - specs/verified/run_record.t27 (#7058) owns whether the receipts are ONE run: three of them,
;   each complete, verdict words agreeing, producer matching the seal. A disagreement is its
;   RUN_WORDS_DISAGREE, passed through here as INDEP_NOT_A_RUN -- reported, never averaged away.
; - specs/verified/signed_receipt.t27 (#7332) owns authorship and freshness, and the run's level
;   as the fold of its receipts' levels (run_level_with).
; - specs/verified/die_binding.t27 (#7452) owns the DNA inside the signed bytes, DIE_NAMED, the
;   run's die level (run_die_level_with) and distinct_dies3.
; --
; Why: three seeds on one board catch place-and-route faults (W842), not a bad die, a swapped
; cable or a mislabelled bench, and they say nothing about the operator. The epic asks that a
; citable run at the higher level needs agreement across distinct dies.
; --
; The rule, judged in order, the first failing fact named:
; 1. the receipts are one run (run_record.t27 answers RUN_MISSING_NONE);
; 2. the run is LEVEL_FRESH: every receipt signed and answering the verifier's nonce;
; 3. the run is DIE_NAMED: every receipt carries its die's DNA inside the signed bytes;
; 4. no die is claimed under two keys -- at least one claim is false, or the board changed hands
;    mid-run, and either way the run is not independent;
; 5. the three placements name placements_needed() distinct dies.
; All five give INDEP_DIES. INDEP_OPERATORS also needs placements_needed() distinct parties from
; the verifier's own roster: the tool maps each key to its roster party, a key outside the roster
; is ROSTER_NONE, and ROSTER_NONE never counts. Parties, not keys: one party may hold many keys.
; --
; The honest ceiling, stated first among the claims because it is the one most easily overclaimed:
; - The DNA is a name, not a secret (die_binding.t27). INDEP_DIES under one key catches honest
;   faults -- a bad die, a swapped cable, a wrong board -- and NOT a signer who writes three DNAs
;   it never read. The test "an invented DNA reaches INDEP_DIES" pins that limit, so no later edit
;   can quietly claim more.
; - INDEP_OPERATORS is exactly as strong as the verifier's roster. Distinct keys are not distinct
;   people, and three colluding parties defeat it, as a colluding majority defeats any
;   re-execution quorum.
; - No level here is rooted in a die-held secret: INDEP_ROOTED_LEVELS is 0.
; - Our bench has one operator key, so it reaches at most INDEP_DIES.
; Competitors, 2026-10-07: Gonka and EigenAI get independence from re-execution by other hosts,
; weighted by stake or restaking; a TEE quote (Phala, NVIDIA CC) needs no quorum but trusts one
; vendor root; zkML needs no quorum and pays 1000x or more. Here the placements of one sealed
; bitstream must agree bit-for-bit, not statistically, and the rule is this compiled contract.
; Tests pin literal codes where a fact names itself, so renumbering the constants cannot pass.
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedIndependence;

use verified::run_record;
use verified::signed_receipt;
use verified::die_binding;

/// The first fact that keeps a run from being independent, in judging order.
pub const INDEP_MISSING_NONE : u8 = 0;
pub const INDEP_NOT_A_RUN : u8 = 1;
pub const INDEP_NOT_FRESH : u8 = 2;
pub const INDEP_DIE_UNNAMED : u8 = 3;
pub const INDEP_DIE_CLAIMED_TWICE : u8 = 4;
pub const INDEP_SHARED_DIE : u8 = 5;

/// Levels, ordered: a run is cited at most at the level it reaches.
pub const INDEP_NONE : u8 = 0;
pub const INDEP_DIES : u8 = 1;
pub const INDEP_OPERATORS : u8 = 2;

/// A key the verifier's roster does not name. It never counts as a party.
pub const ROSTER_NONE : u32 = 65535;

/// The honest ceiling: no level here rests on a secret only the die holds.
pub const INDEP_ROOTED_LEVELS : u8 = 0;

/// Two placements claim one die under two keys.
pub fn claimed_twice(dna_x: u64, dna_y: u64, key_x: u64, key_y: u64) -> bool {
    if (dna_x == dna_y) {
        if (key_x != key_y) { return true; }
    }
    return false;
}

pub fn claimed_twice3(dna_a: u64, dna_b: u64, dna_c: u64, key_a: u64, key_b: u64, key_c: u64) -> bool {
    if (claimed_twice(dna_a, dna_b, key_a, key_b)) { return true; }
    if (claimed_twice(dna_a, dna_c, key_a, key_c)) { return true; }
    if (claimed_twice(dna_b, dna_c, key_b, key_c)) { return true; }
    return false;
}

/// The first fact that keeps three placements from being independent, or INDEP_MISSING_NONE.
pub fn indep_first_missing(run_code: u8, run_level: u8, run_die_level: u8, dna_a: u64, dna_b: u64, dna_c: u64, key_a: u64, key_b: u64, key_c: u64) -> u8 {
    if (run_code != RUN_MISSING_NONE) { return INDEP_NOT_A_RUN; }
    if (run_level < LEVEL_FRESH) { return INDEP_NOT_FRESH; }
    if (run_die_level < DIE_NAMED) { return INDEP_DIE_UNNAMED; }
    if (claimed_twice3(dna_a, dna_b, dna_c, key_a, key_b, key_c)) { return INDEP_DIE_CLAIMED_TWICE; }
    if (distinct_dies3(dna_a, dna_b, dna_c) < placements_needed()) { return INDEP_SHARED_DIE; }
    return INDEP_MISSING_NONE;
}

/// How many distinct roster parties three placements name. ROSTER_NONE is nobody.
pub fn distinct_parties3(a: u32, b: u32, c: u32) -> u8 {
    var n : u8 = 0;
    if (a != ROSTER_NONE) { n = n + 1; }
    if (b != ROSTER_NONE) {
        if (b != a) { n = n + 1; }
    }
    if (c != ROSTER_NONE) {
        if (c != a) {
            if (c != b) { n = n + 1; }
        }
    }
    return n;
}

/// The level three placements reach, from indep_first_missing's answer and their roster parties.
pub fn indep_level(first_missing: u8, party_a: u32, party_b: u32, party_c: u32) -> u8 {
    if (first_missing != INDEP_MISSING_NONE) { return INDEP_NONE; }
    if (distinct_parties3(party_a, party_b, party_c) >= placements_needed()) { return INDEP_OPERATORS; }
    return INDEP_DIES;
}

/// May a verdict record cite this run at the independence it requires? The level only narrows.
pub fn indep_citable_at(level: u8, required_level: u8) -> bool {
    return level >= required_level;
}

; --- tests --------------------------------------------------------------------------------------

test "three fresh receipts naming three dies under one key are INDEP_DIES" {
    var code : u8 = indep_first_missing(RUN_MISSING_NONE, LEVEL_FRESH, DIE_NAMED, 11, 22, 33, 7, 7, 7);
    assert code == INDEP_MISSING_NONE;
    assert code == 0;
    assert indep_level(code, 4, 4, 4) == INDEP_DIES;
    assert indep_level(code, 4, 4, 4) == 1;
}

test "each missing fact names itself, in judging order" {
    // everything wrong at once: the run is judged first
    assert indep_first_missing(RUN_WORDS_DISAGREE, LEVEL_NONE, DIE_NONE, 1, 1, 1, 7, 8, 9) == 1;
    assert indep_first_missing(RUN_TOO_FEW_RECEIPTS, LEVEL_FRESH, DIE_NAMED, 1, 2, 3, 7, 7, 7) == INDEP_NOT_A_RUN;
    assert indep_first_missing(0, LEVEL_AUTHOR, DIE_NONE, 1, 1, 1, 7, 8, 9) == 2;
    assert indep_first_missing(0, LEVEL_NONE, DIE_NAMED, 1, 2, 3, 7, 7, 7) == INDEP_NOT_FRESH;
    assert indep_first_missing(0, LEVEL_FRESH, DIE_NONE, 1, 1, 1, 7, 8, 9) == 3;
    assert indep_first_missing(0, LEVEL_FRESH, DIE_NAMED, 1, 1, 3, 7, 8, 7) == 4;
    assert indep_first_missing(0, LEVEL_FRESH, DIE_NAMED, 1, 1, 3, 7, 7, 7) == 5;
}

test "a verdict disagreement is reported through the run, never averaged" {
    var run : u8 = run_first_missing(3, true, false, true);
    assert run == RUN_WORDS_DISAGREE;
    assert indep_first_missing(run, LEVEL_FRESH, DIE_NAMED, 11, 22, 33, 7, 8, 9) == INDEP_NOT_A_RUN;
    assert indep_level(indep_first_missing(run, LEVEL_FRESH, DIE_NAMED, 11, 22, 33, 7, 8, 9), 1, 2, 3) == INDEP_NONE;
}

test "a die claimed under two keys is caught in any pair" {
    assert claimed_twice3(5, 5, 9, 1, 2, 1) == true;
    assert claimed_twice3(5, 9, 5, 1, 1, 2) == true;
    assert claimed_twice3(9, 5, 5, 1, 1, 2) == true;
    assert claimed_twice3(5, 5, 5, 1, 1, 1) == false;
    assert claimed_twice3(5, 6, 7, 1, 2, 3) == false;
    assert claimed_twice(5, 6, 1, 2) == false;
    assert claimed_twice(5, 5, 1, 1) == false;
    assert claimed_twice(5, 5, 1, 2) == true;
}

test "two placements on one die are not independent, under one key or two" {
    assert indep_first_missing(0, LEVEL_FRESH, DIE_NAMED, 1, 2, 2, 7, 7, 7) == INDEP_SHARED_DIE;
    assert indep_first_missing(0, LEVEL_FRESH, DIE_NAMED, 2, 1, 2, 7, 7, 7) == INDEP_SHARED_DIE;
    assert indep_first_missing(0, LEVEL_FRESH, DIE_NAMED, 2, 2, 2, 7, 7, 7) == INDEP_SHARED_DIE;
    assert indep_first_missing(0, LEVEL_FRESH, DIE_NAMED, 1, 2, 2, 7, 8, 9) == INDEP_DIE_CLAIMED_TWICE;
    assert indep_level(INDEP_SHARED_DIE, 1, 2, 3) == INDEP_NONE;
}

test "roster parties are counted, and a key outside the roster is nobody" {
    assert distinct_parties3(1, 2, 3) == 3;
    assert distinct_parties3(1, 1, 1) == 1;
    assert distinct_parties3(1, 2, 1) == 2;
    assert distinct_parties3(1, 2, 2) == 2;
    assert distinct_parties3(2, 1, 1) == 2;
    assert distinct_parties3(ROSTER_NONE, 2, 3) == 2;
    assert distinct_parties3(1, ROSTER_NONE, 3) == 2;
    assert distinct_parties3(1, 2, ROSTER_NONE) == 2;
    assert distinct_parties3(ROSTER_NONE, ROSTER_NONE, ROSTER_NONE) == 0;
    assert distinct_parties3(ROSTER_NONE, 5, 5) == 1;
}

test "three dies under three roster parties are INDEP_OPERATORS" {
    var code : u8 = indep_first_missing(0, LEVEL_FRESH, DIE_NAMED, 11, 22, 33, 7, 8, 9);
    assert code == INDEP_MISSING_NONE;
    assert indep_level(code, 1, 2, 3) == INDEP_OPERATORS;
    assert indep_level(code, 1, 2, 3) == 2;
    assert indep_level(code, 1, 2, 2) == INDEP_DIES;
    assert indep_level(code, 1, 2, ROSTER_NONE) == INDEP_DIES;
    // three keys of one party are one operator
    assert indep_level(code, 4, 4, 4) == INDEP_DIES;
}

test "the bench's one key reaches at most INDEP_DIES" {
    var over : u32 = 0;
    var p : u32 = 0;
    while (p < 6) {
        if (indep_level(INDEP_MISSING_NONE, p, p, p) > INDEP_DIES) { over = over + 1; }
        p = p + 1;
    }
    assert over == 0;
    assert indep_level(INDEP_MISSING_NONE, ROSTER_NONE, ROSTER_NONE, ROSTER_NONE) == INDEP_DIES;
}

test "an invented DNA reaches INDEP_DIES: the DNA is a name, not a secret" {
    // a signer that never read a die can write three DNAs; nothing here can tell
    var code : u8 = indep_first_missing(0, LEVEL_FRESH, DIE_NAMED, 1, 2, 3, 7, 7, 7);
    assert indep_level(code, 4, 4, 4) == INDEP_DIES;
    assert INDEP_ROOTED_LEVELS == 0;
    assert INDEP_ROOTED_LEVELS == DIE_ROOTED_LEVELS;
    assert INDEP_ROOTED_LEVELS == DEVICE_ROOTED_LEVELS;
}

test "a run is citable at most at the independence it reaches" {
    assert indep_citable_at(INDEP_OPERATORS, INDEP_DIES) == true;
    assert indep_citable_at(INDEP_DIES, INDEP_DIES) == true;
    assert indep_citable_at(INDEP_DIES, INDEP_OPERATORS) == false;
    assert indep_citable_at(INDEP_NONE, INDEP_DIES) == false;
    assert indep_citable_at(INDEP_NONE, INDEP_NONE) == true;
}

test "the levels are ordered and the codes are distinct" {
    assert INDEP_NONE < INDEP_DIES;
    assert INDEP_DIES < INDEP_OPERATORS;
    assert INDEP_NOT_A_RUN < INDEP_NOT_FRESH;
    assert INDEP_NOT_FRESH < INDEP_DIE_UNNAMED;
    assert INDEP_DIE_UNNAMED < INDEP_DIE_CLAIMED_TWICE;
    assert INDEP_DIE_CLAIMED_TWICE < INDEP_SHARED_DIE;
    assert placements_needed() == 3;
}
