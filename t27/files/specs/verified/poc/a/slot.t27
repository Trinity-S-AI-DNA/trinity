// SPDX-License-Identifier: Apache-2.0
; specs/verified/poc/a/slot.t27 -- implementation A of the PoC's reconfigurable slot (#6656, epic #6655).
; b/slot.t27 is implementation B. Both declare the same module and the same on_comb signature, so the
; generated Verilog port list is the same and either fits the slot; only the body differs.
; A passes the input through.
; phi^2 + 1/phi^2 = 3 | TRINITY

module PocSlot;

pub fn on_comb(x: u8) -> u8 {
    return x;
}

test a_passes_the_input_through {
    assert on_comb(0) == 0;
    assert on_comb(5) == 5;
    assert on_comb(255) == 255;
}
