// SPDX-License-Identifier: Apache-2.0
; specs/verified/poc/b/slot.t27 -- implementation B of the PoC's reconfigurable slot (#6656, epic #6655).
; Same module and on_comb signature as a/slot.t27, so it fits the same slot; only the body differs.
; B inverts every bit of the input.
; phi^2 + 1/phi^2 = 3 | TRINITY

module PocSlot;

pub fn on_comb(x: u8) -> u8 {
    return x ^ 255;
}

test b_inverts_the_input {
    assert on_comb(0) == 255;
    assert on_comb(5) == 250;
    assert on_comb(255) == 0;
}
