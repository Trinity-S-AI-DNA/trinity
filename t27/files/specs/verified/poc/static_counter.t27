// SPDX-License-Identifier: Apache-2.0
; specs/verified/poc/static_counter.t27 -- the static region of the Verified Compute PoC (#6656, epic #6655).
; It must stay byte-identical while the slot in a/slot.t27 is swapped for b/slot.t27: its seal is the
; evidence that the static side was reused, not rebuilt. Same mechanism as specs/ternary/clocked_counter.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module PocStatic;

var count : u8 = 0

fn on_clock() {
    count = count + 1
}

test "on_clock_advances_the_static_counter" {
    assert_eq(count, 0);
    on_clock();
    assert_eq(count, 1);
    on_clock();
    assert_eq(count, 2);
}
