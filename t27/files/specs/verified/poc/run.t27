// SPDX-License-Identifier: Apache-2.0
; specs/verified/poc/run.t27 -- the A -> B step of the Verified Compute PoC (#6656, epic #6655), judged by
; the frontier rule. The observations it is fed come from tools, not from this file:
; - .trinity/seals/poc_PocStatic.json: the static region. Its spec_hash is the same before and after
;   the slot is swapped (the file did not change), and it imports nothing from the slot: SAME, no edge.
; - .trinity/seals/a_PocSlot.json, b_PocSlot.json: the slot. Same module, different spec_hash and
;   gen_hash_verilog: DIFF.
; - Port compatibility: the `module PocSlot (...)` header of `t27c gen-verilog` is byte-identical
;   for a/slot.t27 and b/slot.t27 (clk, rst_n, en, x[7:0], ready, result[7:0]).
; - Toolchain and config are the same for both runs: one t27c build, one zig, no flags.
; - Injected failure: b/slot.t27 with `== 250` edited to `== 251` fails zig test the same way on two
;   runs (same test, same assertion), so it normalizes to one (stage, class, scope).
; Reproduce on any checkout (Railway lab used master t27c 1c0299f59, zig 0.16.0):
;   t27c seal specs/verified/poc/static_counter.t27 --verify
;   t27c seal specs/verified/poc/a/slot.t27 --verify
;   t27c seal specs/verified/poc/b/slot.t27 --verify
;   t27c gen-verilog specs/verified/poc/a/slot.t27   (and b/slot.t27; compare the module header)
;   t27c gen specs/verified/poc/run.t27 > run.zig && zig test run.zig
; Hardware: no device was programmed. The slot was not loaded into any FPGA region; the hardware
; step is UNPROVEN, and this file asserts exactly that.
; phi^2 + 1/phi^2 = 3 | TRINITY

module PocRun;

use verified::frontier;

/// Node indices of the PoC graph.
pub const NODE_STATIC : usize = 0;
pub const NODE_SLOT : usize = 1;

/// Injected failure, normalized: zig test failed in the slot's spec. Class 1 = assertion failed.
pub const CLASS_ASSERT : u8 = 1;
/// Scope of the slot: the first 32 bits of b/slot.t27's spec_hash in its seal (0x64be0a9d).
pub const SCOPE_SLOT : u32 = 0x64be0a9d;

test a_to_b_rebuilds_the_slot_and_reuses_the_static_region {
    var from : [1]usize = [1]usize{ 0 };
    var to : [1]usize = [1]usize{ 0 };
    var spec : [2]u8 = [2]u8{ PART_SAME, PART_DIFF };
    var ok : [2]bool = [2]bool{ true, true };
    var d : [2]u8 = undefined;
    assert walk(2, &from, &to, 0, &spec, &ok, PART_SAME, PART_SAME, &d) == 1;
    assert d[NODE_STATIC] == REUSE;
    assert d[NODE_SLOT] == REBUILD_SPEC;
}

test negative_control_a_new_toolchain_reuses_nothing {
    var from : [1]usize = [1]usize{ 0 };
    var to : [1]usize = [1]usize{ 0 };
    var spec : [2]u8 = [2]u8{ PART_SAME, PART_DIFF };
    var ok : [2]bool = [2]bool{ true, true };
    var d : [2]u8 = undefined;
    assert walk(2, &from, &to, 0, &spec, &ok, PART_DIFF, PART_SAME, &d) == 0;
    assert d[NODE_STATIC] == REBUILD_TOOLCHAIN;
}

test the_injected_failure_has_one_fingerprint {
    var first : u64 = fingerprint(STAGE_TEST, CLASS_ASSERT, SCOPE_SLOT);
    var second : u64 = fingerprint(STAGE_TEST, CLASS_ASSERT, SCOPE_SLOT);
    assert first == second;
    assert on_failure(false) == ISSUE_OPEN_NEW;
    assert on_failure(true) == ISSUE_UPDATE;
}

test hardware_is_unproven {
    assert hw_state(true, false) == HW_UNPROVEN;
}
