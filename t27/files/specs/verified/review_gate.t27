// SPDX-License-Identifier: Apache-2.0
; specs/verified/review_gate.t27 -- the review state of a pull request, read from recorded evidence, and
; whether it may merge. Epic gHashTag/t27#6655, Phase E (automated review gate).
; --
; The state is a chain, and a pull request sits at the last link it has evidence for:
;   AFFECTED   the affected set was resolved (specs/ci/affected.t27: a list, or RUN_ALL)
;   EXECUTED   every required check of that set ran and reported
;   PASSED     none of them failed
;   SEALED     every touched spec's seal verifies (`t27c seal --verify`)
;   POLICY     the policy gates passed (own_language, L1 traceability, secret scan)
; Missing evidence is not a pass: an affected set nobody could resolve, a required check that did not
; report, an unverified seal -- each stops the chain where it is. RUN_ALL is a resolved answer (run
; everything), not a missing one.
; --
; Merge needs POLICY and an approver who is not the author. A bee never approves or merges its own
; pull request (EPIC #6655 rule 12); a bee may approve another bee's.
; What already exists and is not restated: which specs are affected (specs/ci/affected.t27), what a
; send-back or escalation does next (specs/queen/review_valve.t27), the seal itself (`t27c seal`).
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedReviewGate;

/// How the affected set was resolved.
pub const AFF_UNKNOWN : u8 = 0;
pub const AFF_LIST : u8 = 1;
pub const AFF_RUN_ALL : u8 = 2;

/// The chain, in order. A pull request's state is the last link it reached.
pub const G_NONE : u8 = 0;
pub const G_AFFECTED : u8 = 1;
pub const G_EXECUTED : u8 = 2;
pub const G_PASSED : u8 = 3;
pub const G_SEALED : u8 = 4;
pub const G_POLICY : u8 = 5;

/// The review state from the recorded evidence. required: checks the affected set requires;
/// reported: how many of those reported a result; failed: how many of those failed.
pub fn gate_state(affected: u8, required: u32, reported: u32, failed: u32, seals_ok: bool, policy_ok: bool) -> u8 {
    if (affected == AFF_UNKNOWN) { return G_NONE; }
    if (affected != AFF_LIST and affected != AFF_RUN_ALL) { return G_NONE; }
    if (reported < required) { return G_AFFECTED; }
    if (failed > 0) { return G_EXECUTED; }
    if (seals_ok == false) { return G_PASSED; }
    if (policy_ok == false) { return G_SEALED; }
    return G_POLICY;
}

/// Whether the pull request may merge.
pub fn may_merge(state: u8, approved: bool, approver_is_author: bool) -> bool {
    if (state != G_POLICY) { return false; }
    if (approved == false) { return false; }
    if (approver_is_author) { return false; }
    return true;
}

test full_evidence_reaches_policy_and_merges_with_another_approver {
    var s : u8 = gate_state(AFF_LIST, 3, 3, 0, true, true);
    assert s == G_POLICY;
    assert may_merge(s, true, false);
}

test run_all_is_resolved_not_missing {
    assert gate_state(AFF_RUN_ALL, 40, 40, 0, true, true) == G_POLICY;
}

test an_unresolved_affected_set_blocks_everything {
    assert gate_state(AFF_UNKNOWN, 0, 0, 0, true, true) == G_NONE;
    assert gate_state(7, 0, 0, 0, true, true) == G_NONE;
    assert may_merge(G_NONE, true, false) == false;
}

test a_required_check_that_did_not_report_is_not_a_pass {
    assert gate_state(AFF_LIST, 3, 2, 0, true, true) == G_AFFECTED;
}

test a_failed_check_stops_at_executed {
    assert gate_state(AFF_LIST, 3, 3, 1, true, true) == G_EXECUTED;
}

test an_unverified_seal_stops_at_passed {
    assert gate_state(AFF_LIST, 3, 3, 0, false, true) == G_PASSED;
}

test a_policy_failure_stops_at_sealed {
    assert gate_state(AFF_LIST, 3, 3, 0, true, false) == G_SEALED;
    assert may_merge(G_SEALED, true, false) == false;
}

test no_self_approval_and_no_merge_without_approval {
    assert may_merge(G_POLICY, true, true) == false;
    assert may_merge(G_POLICY, false, false) == false;
}

test an_empty_required_set_still_needs_seals_and_policy {
    assert gate_state(AFF_LIST, 0, 0, 0, true, true) == G_POLICY;
    assert gate_state(AFF_LIST, 0, 0, 0, false, true) == G_PASSED;
}

invariant the_chain_is_ordered {
    assert G_NONE < G_AFFECTED;
    assert G_AFFECTED < G_EXECUTED;
    assert G_EXECUTED < G_PASSED;
    assert G_PASSED < G_SEALED;
    assert G_SEALED < G_POLICY;
}
