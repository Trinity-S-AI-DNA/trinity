// SPDX-License-Identifier: Apache-2.0
; specs/verified/evidence_chain.t27 -- the three identities that link a change to what was run for it and
; to what that run proved, and the check that the links hold. Epic gHashTag/t27#6655, Phase D (cross-
; repository glue contract: change identity, execution/run identity, evidence record).
; --
; The records stay where they already live; this file only says how they point at each other:
;   change    a pull request head commit or a spec_hash (`t27c seal`); its id is supplied by the caller
;   run       one CI or lab execution; it records the change id it ran for
;   evidence  one record per run; it records the run id, and whether outputs, test results and logs
;             are referenced, and the seal state the run left (`t27c seal --verify`)
; An id is a 64-bit prefix of an existing hash or number (commit sha, spec_hash, run number); 0 means
; "not recorded". This file computes no hash.
; --
; The chain is checked link by link and the first broken link is the answer, so the same records always
; give the same answer. A record that points at a different change or run is not "almost linked": it is
; another chain and proves nothing about this one. Missing is never linked (fail closed).
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedEvidenceChain;

/// Seal state recorded by the run.
pub const SEAL_NOT_RUN : u8 = 0;
pub const SEAL_MATCH : u8 = 1;
pub const SEAL_MISMATCH : u8 = 2;

/// chain() answers: LINKED, or the first link that is broken.
pub const LINKED : u8 = 0;
pub const NO_CHANGE : u8 = 1;
pub const RUN_UNBOUND : u8 = 2;
pub const RUN_OTHER_CHANGE : u8 = 3;
pub const EVIDENCE_UNBOUND : u8 = 4;
pub const EVIDENCE_OTHER_RUN : u8 = 5;
pub const NO_OUTPUTS : u8 = 6;
pub const NO_TESTS : u8 = 7;
pub const NO_LOGS : u8 = 8;
pub const SEAL_NOT_VERIFIED : u8 = 9;

/// change: the change id. run_change: the change id the run recorded; run: the run id.
/// ev_run: the run id the evidence recorded.
pub fn chain(change: u64, run_change: u64, run: u64, ev_run: u64, has_outputs: bool, has_tests: bool, has_logs: bool, seal: u8) -> u8 {
    if (change == 0) { return NO_CHANGE; }
    if (run == 0 or run_change == 0) { return RUN_UNBOUND; }
    if (run_change != change) { return RUN_OTHER_CHANGE; }
    if (ev_run == 0) { return EVIDENCE_UNBOUND; }
    if (ev_run != run) { return EVIDENCE_OTHER_RUN; }
    if (has_outputs == false) { return NO_OUTPUTS; }
    if (has_tests == false) { return NO_TESTS; }
    if (has_logs == false) { return NO_LOGS; }
    if (seal != SEAL_MATCH) { return SEAL_NOT_VERIFIED; }
    return LINKED;
}

test a_full_chain_is_linked {
    assert chain(0xaaaa, 0xaaaa, 7, 7, true, true, true, SEAL_MATCH) == LINKED;
}

test no_change_id_means_nothing_is_linked {
    assert chain(0, 0, 7, 7, true, true, true, SEAL_MATCH) == NO_CHANGE;
}

test a_run_without_ids_is_unbound {
    assert chain(0xaaaa, 0xaaaa, 0, 7, true, true, true, SEAL_MATCH) == RUN_UNBOUND;
    assert chain(0xaaaa, 0, 7, 7, true, true, true, SEAL_MATCH) == RUN_UNBOUND;
}

test a_run_for_another_change_proves_nothing_here {
    assert chain(0xaaaa, 0xbbbb, 7, 7, true, true, true, SEAL_MATCH) == RUN_OTHER_CHANGE;
}

test evidence_must_name_this_run {
    assert chain(0xaaaa, 0xaaaa, 7, 0, true, true, true, SEAL_MATCH) == EVIDENCE_UNBOUND;
    assert chain(0xaaaa, 0xaaaa, 7, 8, true, true, true, SEAL_MATCH) == EVIDENCE_OTHER_RUN;
}

test evidence_must_reference_outputs_tests_and_logs {
    assert chain(0xaaaa, 0xaaaa, 7, 7, false, true, true, SEAL_MATCH) == NO_OUTPUTS;
    assert chain(0xaaaa, 0xaaaa, 7, 7, true, false, true, SEAL_MATCH) == NO_TESTS;
    assert chain(0xaaaa, 0xaaaa, 7, 7, true, true, false, SEAL_MATCH) == NO_LOGS;
}

test only_a_matching_seal_completes_the_chain {
    assert chain(0xaaaa, 0xaaaa, 7, 7, true, true, true, SEAL_NOT_RUN) == SEAL_NOT_VERIFIED;
    assert chain(0xaaaa, 0xaaaa, 7, 7, true, true, true, SEAL_MISMATCH) == SEAL_NOT_VERIFIED;
    assert chain(0xaaaa, 0xaaaa, 7, 7, true, true, true, 9) == SEAL_NOT_VERIFIED;
}

test the_first_broken_link_is_the_answer {
    assert chain(0xaaaa, 0xbbbb, 7, 8, false, false, false, SEAL_MISMATCH) == RUN_OTHER_CHANGE;
    assert chain(0xaaaa, 0xaaaa, 7, 7, false, false, false, SEAL_MISMATCH) == NO_OUTPUTS;
}

test full_width_ids_compare_exactly {
    assert chain(18446744073709551615, 18446744073709551615, 18446744073709551615, 18446744073709551615, true, true, true, SEAL_MATCH) == LINKED;
    assert chain(18446744073709551615, 18446744073709551614, 1, 1, true, true, true, SEAL_MATCH) == RUN_OTHER_CHANGE;
}

invariant linked_is_zero {
    assert LINKED == 0;
    assert SEAL_NOT_RUN == 0;
}
