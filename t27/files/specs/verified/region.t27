// SPDX-License-Identifier: Apache-2.0
; specs/verified/region.t27 -- the identity of an FPGA region and the rule that admits one partial
; image into it. Epic gHashTag/t27#6655, Phase G (software artifact -> region/bitstream identity,
; compatibility constraints, verified partial-update policy).
; --
; What already exists and is NOT restated here:
; - specs/fpga/adapter.t27 (trinity_fpga_adapter) owns the whole device side: a receipt is a build-only
;   record or a device record with a transcript, and no hardware run may be inferred from synthesis.
;   This file never touches receipts or bitstreams; it decides admission BEFORE the adapter is called.
; - specs/verified/poc/ (#6705) demonstrated the slot side: two PocSlot implementations with
;   byte-identical Verilog port headers and different spec/gen hashes -- compatible implementations
;   of one boundary. That observation is the boundary part below.
; - specs/verified/reuse.t27 owns the software artifact identity (five parts, MISSING fails closed)
;   and the hardware triad UNPROVEN / VERIFIED / BLOCKED. Imported, not restated.
; --
; The region rule:
; - A region is identified by four parts: the design it belongs to, its boundary (the port contract
;   the implementing module must expose), its placement (the frame/site span it owns), and the
;   toolchain that placed it. Parts are compared with reuse.t27's PART_* codes.
; - A partial image is admitted only when all four parts are SAME and the image's seal verified as a
;   pass (seal_check.t27 CHECK_MATCH). The first differing part names itself, in the order above, so
;   the same image and region always give the same refusal. A part that cannot be established makes
;   the whole admission UNKNOWN -- rejected, never waved through.
; - Two regions may not own overlapping placements; an empty or inverted span (lo >= hi) is not a
;   placement at all.
; - A partial update is complete only with device evidence through the adapter: without a transcript
;   the update is UNPROVEN, with a failing adapter BLOCKED -- reuse.t27's triad, applied to updates.
; - The static region must be SAME through a slot swap; anything else is a rebuild of the whole design,
;   not a partial update.
; Tests pin literal codes where a part names itself, so renumbering the constants cannot pass.
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedRegion;

use verified::reuse;

/// image_admits() answers.
pub const ADMIT : u8 = 0;
pub const REJECT_DESIGN : u8 = 1;
pub const REJECT_BOUNDARY : u8 = 2;
pub const REJECT_PLACEMENT : u8 = 3;
pub const REJECT_TOOLCHAIN : u8 = 4;
pub const REJECT_UNSEALED : u8 = 5;
pub const REJECT_UNKNOWN : u8 = 6;

/// Admit one sealed partial image into one region. design, boundary, placement, toolchain are the
/// region-identity parts of the image measured against the region; sealed_pass is verdict_pass()
/// from specs/verified/seal_check.t27 on the image's seal.
pub fn image_admits(design: u8, boundary: u8, placement: u8, toolchain: u8, sealed_pass: bool) -> u8 {
    if (design != PART_SAME) { return reject_or_unknown(design, REJECT_DESIGN); }
    if (boundary != PART_SAME) { return reject_or_unknown(boundary, REJECT_BOUNDARY); }
    if (placement != PART_SAME) { return reject_or_unknown(placement, REJECT_PLACEMENT); }
    if (toolchain != PART_SAME) { return reject_or_unknown(toolchain, REJECT_TOOLCHAIN); }
    if (sealed_pass == false) { return REJECT_UNSEALED; }
    return ADMIT;
}

/// A part that could not be established rejects the whole admission as UNKNOWN; a part established
/// and different names itself.
pub fn reject_or_unknown(part: u8, reject_code: u8) -> u8 {
    if (part == PART_MISSING) { return REJECT_UNKNOWN; }
    return reject_code;
}

/// A span is a placement only when it is non-empty and not inverted.
pub fn placement_valid(lo: u64, hi: u64) -> bool {
    return lo < hi;
}

/// Whether two placements claim overlapping fabric. Total on any inputs: an invalid span owns
/// nothing, so it can never conflict -- but placement_valid refuses it before it gets this far.
pub fn regions_overlap(a_lo: u64, a_hi: u64, b_lo: u64, b_hi: u64) -> bool {
    if (placement_valid(a_lo, a_hi) == false) { return false; }
    if (placement_valid(b_lo, b_hi) == false) { return false; }
    if (a_lo >= b_hi) { return false; }
    if (b_lo >= a_hi) { return false; }
    return true;
}

/// Whether two implementations are swappable slot images for one region: same boundary, same
/// placement, everything about the implementation itself free to differ.
pub fn slot_swappable(boundary: u8, placement: u8) -> bool {
    if (boundary != PART_SAME) { return false; }
    if (placement != PART_SAME) { return false; }
    return true;
}

/// The state of a partial update once the image was admitted and loaded: device evidence through the
/// adapter makes it VERIFIED, no transcript yet leaves it UNPROVEN, a failing adapter BLOCKS it.
pub fn partial_update_state(device_evidence: bool, adapter_ok: bool) -> u8 {
    if (adapter_ok == false) { return HW_BLOCKED; }
    if (device_evidence == false) { return HW_UNPROVEN; }
    return HW_VERIFIED;
}

/// The static region survives a slot swap only unchanged; any other part means the whole design
/// rebuilds, not a partial update.
pub fn partial_update_allowed(static_part: u8) -> bool {
    return static_part == PART_SAME;
}

test "matching region and sealed image admits" {
    assert image_admits(PART_SAME, PART_SAME, PART_SAME, PART_SAME, true) == ADMIT;
}

test "each identity part names itself in order" {
    assert image_admits(PART_DIFF, PART_DIFF, PART_DIFF, PART_DIFF, true) == 1;
    assert image_admits(PART_SAME, PART_DIFF, PART_DIFF, PART_DIFF, true) == 2;
    assert image_admits(PART_SAME, PART_SAME, PART_DIFF, PART_DIFF, true) == 3;
    assert image_admits(PART_SAME, PART_SAME, PART_SAME, PART_DIFF, true) == 4;
}

test "an unsealed image is rejected even when every part matches" {
    assert image_admits(PART_SAME, PART_SAME, PART_SAME, PART_SAME, false) == REJECT_UNSEALED;
}

test "a part that cannot be established rejects as unknown, never admits" {
    assert image_admits(PART_SAME, PART_SAME, PART_SAME, PART_MISSING, true) == REJECT_UNKNOWN;
    assert image_admits(PART_MISSING, PART_SAME, PART_SAME, PART_SAME, true) == REJECT_UNKNOWN;
    assert image_admits(PART_MISSING, PART_MISSING, PART_MISSING, PART_MISSING, true) == REJECT_UNKNOWN;
}

test "overlap is symmetric and catches containment" {
    assert regions_overlap(100, 200, 150, 250) == true;
    assert regions_overlap(150, 250, 100, 200) == true;
    assert regions_overlap(100, 300, 150, 200) == true;
    assert regions_overlap(100, 200, 200, 300) == false;
    assert regions_overlap(100, 200, 50, 100) == false;
    assert regions_overlap(100, 200, 300, 400) == false;
}

test "an empty or inverted span is not a placement" {
    assert placement_valid(5, 5) == false;
    assert placement_valid(9, 5) == false;
    assert placement_valid(5, 6) == true;
}

test "an invalid span owns nothing" {
    assert regions_overlap(5, 5, 4, 6) == false;
}

test "swappable needs boundary and placement, ignores the rest" {
    assert slot_swappable(PART_SAME, PART_SAME) == true;
    assert slot_swappable(PART_DIFF, PART_SAME) == false;
    assert slot_swappable(PART_SAME, PART_DIFF) == false;
    assert slot_swappable(PART_MISSING, PART_SAME) == false;
}

test "update state is the adapter triad" {
    assert partial_update_state(true, true) == HW_VERIFIED;
    assert partial_update_state(false, true) == HW_UNPROVEN;
    assert partial_update_state(true, false) == HW_BLOCKED;
    assert partial_update_state(false, false) == HW_BLOCKED;
}

test "static must be same or the update is not partial" {
    assert partial_update_allowed(PART_SAME) == true;
    assert partial_update_allowed(PART_DIFF) == false;
    assert partial_update_allowed(PART_MISSING) == false;
}
