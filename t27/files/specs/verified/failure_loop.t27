// SPDX-License-Identifier: Apache-2.0
; specs/verified/failure_loop.t27 -- the automatic failure loop: what level a failure issue is filed at,
; what a Queen-runnable failure issue must carry, what a fix PR must point at, and when the loop may
; close. Epic gHashTag/t27#6655, Phase F.
; --
; What already exists and is not restated here:
; - specs/verified/reuse.t27: the failure fingerprint (stage, class, scope), on_failure() (open a new
;   issue or update the open one) and on_fix_run() (close only on a passing, sealed, non-recurring run).
; - specs/queen/priority.t27: the levels, the critical cap and aging. This file picks the BASE level a
;   failure issue is labelled with; the cap and aging stay there.
; --
; The level is decided by what the failure blocks, never by an agent's judgment:
;   - a failure on the default branch blocks every pull request based on it: CRITICAL;
;   - a fingerprint that recurred after its issue was closed (the fix did not hold): HIGH;
;   - anything else: NORMAL.
; Occurrence counts do not raise the level: no threshold is invented here, and a repeated failure
; updates its one issue (reuse.t27) instead of flooding the queue.
; --
; A failure issue is runnable by the Queen only with a Boundary, machine-checkable Success Criteria and
; the fingerprint it was filed for. A fix PR is linked only when it references both the failure issue
; and the original change. The loop closes only when the fix is linked, the SAME pipeline was re-run,
; and reuse.on_fix_run() says close.
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedFailureLoop;

use verified::reuse;

/// specs/queen/priority.t27 levels, same values.
pub const LEVEL_CRITICAL : u8 = 0;
pub const LEVEL_HIGH : u8 = 1;
pub const LEVEL_NORMAL : u8 = 2;

/// The base level a failure issue is labelled with.
pub fn failure_level(on_default_branch: bool, recurred_after_close: bool) -> u8 {
    if (on_default_branch) { return LEVEL_CRITICAL; }
    if (recurred_after_close) { return LEVEL_HIGH; }
    return LEVEL_NORMAL;
}

/// Whether a failure issue may be handed to the Queen.
pub fn runnable(has_boundary: bool, has_criteria: bool, has_fingerprint: bool) -> bool {
    return has_boundary and has_criteria and has_fingerprint;
}

/// Whether a fix PR is linked to what it fixes.
pub fn fix_linked(refs_failure_issue: bool, refs_original_change: bool) -> bool {
    return refs_failure_issue and refs_original_change;
}

/// What the failure issue does after a fix run. A recurring fingerprint always updates; an unlinked fix
/// or a different pipeline proves nothing about the original failure, so the issue stays open.
pub fn close_action(linked: bool, same_pipeline: bool, passed: bool, seal_verified: bool, recurred: bool) -> u8 {
    if (recurred) { return ISSUE_UPDATE; }
    if (linked == false) { return ISSUE_KEEP; }
    if (same_pipeline == false) { return ISSUE_KEEP; }
    return on_fix_run(passed, seal_verified, recurred);
}

test a_red_default_branch_is_critical {
    assert failure_level(true, false) == LEVEL_CRITICAL;
    assert failure_level(true, true) == LEVEL_CRITICAL;
}

test a_fix_that_did_not_hold_is_high {
    assert failure_level(false, true) == LEVEL_HIGH;
}

test any_other_failure_is_normal {
    assert failure_level(false, false) == LEVEL_NORMAL;
}

test a_failure_issue_needs_boundary_criteria_and_fingerprint {
    assert runnable(true, true, true);
    assert runnable(false, true, true) == false;
    assert runnable(true, false, true) == false;
    assert runnable(true, true, false) == false;
}

test a_fix_pr_must_reference_the_failure_and_the_change {
    assert fix_linked(true, true);
    assert fix_linked(true, false) == false;
    assert fix_linked(false, true) == false;
}

test the_loop_closes_on_a_linked_same_pipeline_passing_sealed_run {
    assert close_action(true, true, true, true, false) == ISSUE_CLOSE;
}

test an_unlinked_fix_or_another_pipeline_keeps_the_issue_open {
    assert close_action(false, true, true, true, false) == ISSUE_KEEP;
    assert close_action(true, false, true, true, false) == ISSUE_KEEP;
}

test a_failing_or_unsealed_rerun_keeps_the_issue_open {
    assert close_action(true, true, false, true, false) == ISSUE_KEEP;
    assert close_action(true, true, true, false, false) == ISSUE_KEEP;
}

test a_recurring_fingerprint_updates_even_without_a_link {
    assert close_action(false, false, true, true, true) == ISSUE_UPDATE;
    assert close_action(true, true, true, true, true) == ISSUE_UPDATE;
}

test the_same_failure_files_once_then_updates {
    var fp : u64 = fingerprint(STAGE_TEST, 1, 77);
    assert fp == fingerprint(STAGE_TEST, 1, 77);
    assert on_failure(false) == ISSUE_OPEN_NEW;
    assert on_failure(true) == ISSUE_UPDATE;
}

invariant levels_match_queen_priority {
    assert LEVEL_CRITICAL < LEVEL_HIGH;
    assert LEVEL_HIGH < LEVEL_NORMAL;
}
