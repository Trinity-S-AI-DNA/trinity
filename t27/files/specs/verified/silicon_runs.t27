// SPDX-License-Identifier: Apache-2.0
; specs/verified/silicon_runs.t27 -- the index of signed silicon runs that the Spec Explorer's Chip tab
; renders (gHashTag/trinity#1527). Epic gHashTag/t27#6655. The index is DATA written by t27c, never by
; hand: docs/reports/silicon-runs/index.json is a JSON array of `t27c run-record --json` documents
; (#7723), one per run, each carrying t27c's own judgment and the identity of the build that judged it.
; --
; Why a spec: the website vendors a file only when a spec cites it -- SOURCES below, read by
; apps/website/scripts/sync-t27-specs.mjs in gHashTag/trinity. This spec is that citation, and it
; pins how each entry was produced so anyone can regenerate and compare it.
; --
; The entries, as of 2026-10-08, judged by t27c-bootstrap@0.5.0+12c41a42b (a build of master):
; 1. R3-2 (#7452, PR #7598): ternary_link on die 050d58218fd9854, pnr seeds 1/7/42, one nonce.
;    Its receipts live in .trinity/receipts/r32-2026-10-07 since #7681. It is judged against the
;    seal of 46dce0066, whose built_by (t27c-bootstrap@0.4.0+eedcfbf6c) is the build that ran it.
;    #7681 re-saved that seal for R3-3, and a re-saved seal names a new producer, so against
;    today's seal this run reads RUN_PRODUCER_MISMATCH. That is the honest consequence of re-sealing,
;    stated here rather than hidden. Command, in a tree holding 46dce0066's seal:
;      t27c run-record specs/fpga/ternary_link.t27 --challenge 7dbb6f7f4fbd412e9d83b6b4a900555f
;        --receipts .trinity/receipts/r32-2026-10-07 --json r32.json
; 2. R3-3 (#7669): in progress. Only die A has reported (#7687), so the run reads
;    RUN_TOO_FEW_RECEIPTS until dies B and C land. Command, on master:
;      t27c run-record specs/fpga/ternary_link.t27 --challenge e61798b78cbb6b287b8ff8523cea71a6
;        --json r33.json
; The array is the two documents in that order, unchanged.
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedSiliconRuns;

use verified::run_record;

pub const SOURCES : [1]str = ["docs/reports/silicon-runs/index.json"];
pub const INDEX_RUNS : u8 = 2;
pub const R32_RECEIPTS : u8 = 3;
pub const R33_RECEIPTS_SO_FAR : u8 = 1;

test "the R3-2 entry has exactly the placements run_record.t27 requires" {
    assert_eq(R32_RECEIPTS, placements_needed());
    assert_eq(run_first_missing(R32_RECEIPTS, true, true, true), 0);
}

test "the R3-3 entry stays honestly incomplete until two more dies report" {
    assert_eq(run_first_missing(R33_RECEIPTS_SO_FAR, true, true, true), 1);
    assert_eq(run_first_missing(R33_RECEIPTS_SO_FAR + 2, true, true, true), 0);
}

invariant index_lists_one_entry_per_run {
    assert_eq(INDEX_RUNS, 2);
}
