// SPDX-License-Identifier: Apache-2.0
; specs/verified/payout.t27 -- no verified result, no normal reward. Epic gHashTag/t27#6655, Phase I
; (network economy and provider settlement).
; --
; The settlement ledger already exists and is not restated here:
; gHashTag/trinity-fpga@65855047454a src/trinet/ledger.zig (law: specs/trinet/settlement_law.t27).
; Its settle() refuses identity theft, double billing (spent-nonce set keyed by node and nonce), a
; suspended node and a lie, and pays nothing and charges nothing for a damaged or unverifiable frame.
; The OUT_* codes below are that file's `Outcome` enum in declaration order, so a caller passes the
; ledger's own answer through unchanged.
; --
; This file adds the one rule the ledger cannot see: whether the engineering pipeline verified the
; work the receipt is for. A credited receipt is a judged dot product; it is not a passed test, a
; verified seal or a policy pass. So a normal payout needs all three of:
;   - the ledger credited the receipt (OUT_CREDITED);
;   - the engineering verdict is verified (for a pull request: specs/verified/review_gate.t27 at
;     G_POLICY; for a sealed artifact: `t27c seal --verify` matched and its tests passed);
;   - the settlement record references that verdict (a payout is never inferred from an attempt).
; Anything else gets no normal payout. A slash the ledger already decided stays a slash.
; --
; Splitting: the executor (bee/agent), the compute provider and a contributor are separate shares of
; one pool. The shares are inputs from the existing economy rules; this file names no percentage. It
; only refuses a split whose sum exceeds the pool, without overflowing on the way.
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedPayout;

/// ledger.zig `Outcome`, in declaration order.
pub const OUT_CREDITED : u8 = 0;
pub const OUT_REJECTED_AND_SLASHED : u8 = 1;
pub const OUT_CORRUPT_NOT_CHARGED : u8 = 2;
pub const OUT_IDENTITY_MISMATCH : u8 = 3;
pub const OUT_UNVERIFIABLE_NOT_CHARGED : u8 = 4;
pub const OUT_NOT_ELIGIBLE : u8 = 5;

/// payout() answers.
pub const PAY_NONE : u8 = 0;
pub const PAY_NORMAL : u8 = 1;
pub const PAY_SLASH_ONLY : u8 = 2;

/// The payout for one settled receipt. verified: the engineering verdict passed;
/// verdict_referenced: the settlement record names that verdict.
pub fn payout(outcome: u8, verified: bool, verdict_referenced: bool) -> u8 {
    if (outcome == OUT_REJECTED_AND_SLASHED) { return PAY_SLASH_ONLY; }
    if (outcome != OUT_CREDITED) { return PAY_NONE; }
    if (verified == false) { return PAY_NONE; }
    if (verdict_referenced == false) { return PAY_NONE; }
    return PAY_NORMAL;
}

/// Whether executor + provider + contributor fits in the pool. Subtracts instead of adding, so a
/// share near the top of u64 cannot wrap the sum back under the pool.
pub fn split_fits(pool: u64, executor: u64, provider: u64, contributor: u64) -> bool {
    if (executor > pool) { return false; }
    var left : u64 = pool - executor;
    if (provider > left) { return false; }
    left = left - provider;
    if (contributor > left) { return false; }
    return true;
}

test a_credited_verified_referenced_receipt_is_paid {
    assert payout(OUT_CREDITED, true, true) == PAY_NORMAL;
}

test a_credited_receipt_for_unverified_work_is_not_paid {
    assert payout(OUT_CREDITED, false, true) == PAY_NONE;
}

test a_payout_is_never_inferred_from_an_attempt {
    assert payout(OUT_CREDITED, true, false) == PAY_NONE;
}

test every_ledger_refusal_stays_a_refusal_even_when_verified {
    assert payout(OUT_CORRUPT_NOT_CHARGED, true, true) == PAY_NONE;
    assert payout(OUT_IDENTITY_MISMATCH, true, true) == PAY_NONE;
    assert payout(OUT_UNVERIFIABLE_NOT_CHARGED, true, true) == PAY_NONE;
    assert payout(OUT_NOT_ELIGIBLE, true, true) == PAY_NONE;
}

test an_unknown_outcome_fails_closed {
    assert payout(6, true, true) == PAY_NONE;
    assert payout(255, true, true) == PAY_NONE;
}

test a_slash_stays_a_slash {
    assert payout(OUT_REJECTED_AND_SLASHED, true, true) == PAY_SLASH_ONLY;
    assert payout(OUT_REJECTED_AND_SLASHED, false, false) == PAY_SLASH_ONLY;
}

test a_split_within_the_pool_fits_and_one_unit_over_does_not {
    assert split_fits(10, 6, 3, 1);
    assert split_fits(10, 0, 0, 0);
    assert split_fits(10, 6, 3, 2) == false;
    assert split_fits(10, 11, 0, 0) == false;
    assert split_fits(10, 0, 11, 0) == false;
    assert split_fits(10, 0, 0, 11) == false;
}

test a_split_cannot_wrap_past_the_pool {
    assert split_fits(10, 18446744073709551615, 18446744073709551615, 2) == false;
    assert split_fits(18446744073709551615, 18446744073709551615, 0, 0);
    assert split_fits(18446744073709551615, 18446744073709551615, 1, 0) == false;
}

invariant credited_is_the_first_outcome {
    assert OUT_CREDITED == 0;
    assert PAY_NONE == 0;
}
