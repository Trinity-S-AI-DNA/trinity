// SPDX-License-Identifier: Apache-2.0
; specs/verified/receipt.t27 -- the persisted receipt record: the shape of what `t27c silicon` must
; write into the tree, and the producer identity it must carry. Epic gHashTag/t27#6655, Round 2
; (R2-1 receipt persistence, R2-2 toolchain identity; issue #6942). This file is the contract half:
; the tool change that emits the record comes after it and changes no decision made here.
; --
; What already exists and is NOT restated here:
; - specs/verified/device_evidence.t27 (#6720) owns the six EVIDENCE facts read off an adapter
;   receipt (device record, sealed bitstream, full IDCODE, ran on device, transcript, reproducible)
;   and when they verify a hardware step. This file owns the SHAPE of the record persisted into the
;   tree: which fields must exist on it, judged in a fixed order. The two meet at the record: a
;   receipt device_evidence could verify is a receipt this file calls complete.
; - specs/verified/verdict.t27 (#6732) owns the run-verdict vocabulary; a receipt's verdict word is
;   a verdict only if it is one of those words. A word the vocabulary does not define is not a
;   stricter verdict, it is a typo with authority.
; - specs/fpga/adapter.t27 owns the full-IDCODE rule (a masked read is not identity); here the
;   field is FULL by definition -- a masked IDCODE is reported as the field being absent.
; - .trinity/seals/*.json are the seal records themselves; producer_matches reads two producer
;   identities and compares them, it does not open the seal.
; --
; The receipt rule:
; - Six fields, each observable on the record, judged in fixed order: the record is a device record
;   (not a dry-run), the full IDCODE, the verdict word, the seal hash of the image the device ran,
;   the seeds of the run, and the identity of the toolchain that produced and verified it. Any one
;   missing leaves the record incomplete and the first-missing code names it; there is no partial
;   credit and no field inferred from another.
; - The producer identity is verbatim equality against the seal's producer (R2-2): a receipt that
;   cannot name its producer cannot be independently re-verified, and one that names a different
;   producer than the seal it cites is a claim about someone else's work.
; - The verdict word must be a word verdict.t27 defines. PASS and FAIL are verdicts; anything else
;   on that field is absent, whatever it says.
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedReceipt;

use verified::verdict;

/// receipt_first_missing() answers, in receipt order.
pub const MISSING_NONE : u8 = 0;
pub const MISSING_DEVICE_RECORD : u8 = 1;
pub const MISSING_FULL_IDCODE : u8 = 2;
pub const MISSING_VERDICT_WORD : u8 = 3;
pub const MISSING_SEAL_HASH : u8 = 4;
pub const MISSING_SEEDS : u8 = 5;
pub const MISSING_TOOLCHAIN : u8 = 6;

/// The first of the six fields the record does not carry, or MISSING_NONE when it carries all.
/// Fields are judged in this order so the same broken record always names the same missing field.
pub fn receipt_first_missing(has_device_record: bool, has_full_idcode: bool, has_verdict_word: bool, has_seal_hash: bool, has_seeds: bool, has_toolchain: bool) -> u8 {
    if (has_device_record == false) { return MISSING_DEVICE_RECORD; }
    if (has_full_idcode == false) { return MISSING_FULL_IDCODE; }
    if (has_verdict_word == false) { return MISSING_VERDICT_WORD; }
    if (has_seal_hash == false) { return MISSING_SEAL_HASH; }
    if (has_seeds == false) { return MISSING_SEEDS; }
    if (has_toolchain == false) { return MISSING_TOOLCHAIN; }
    return MISSING_NONE;
}

/// Whether the record is complete: every field present, no partial credit. Incomplete is reported,
/// never repaired here -- the tool writes the record, the rule reads it.
pub fn receipt_complete(has_device_record: bool, has_full_idcode: bool, has_verdict_word: bool, has_seal_hash: bool, has_seeds: bool, has_toolchain: bool) -> bool {
    return receipt_first_missing(has_device_record, has_full_idcode, has_verdict_word, has_seal_hash, has_seeds, has_toolchain) == MISSING_NONE;
}

/// Whether the verdict word on the record is a word the run-verdict vocabulary defines.
/// An unknown word is absent for every purpose: it is not a stricter verdict, it is no verdict.
pub fn verdict_word_known(word: u8) -> bool {
    if (word == PASS) { return true; }
    if (word == FAIL) { return true; }
    return false;
}

/// Whether the record names the producer that produced and verified it (R2-2). Verbatim equality,
/// read verbatim and never inferred: a receipt naming any producer other than the one on its seal
/// is a claim about someone else's work, and matching is not graded.
pub fn producer_matches(receipt_producer: u8, seal_producer: u8) -> bool {
    return receipt_producer == seal_producer;
}

test "complete only when every field is carried" {
    assert receipt_complete(true, true, true, true, true, true) == true;
}

test "any missing field leaves the record incomplete" {
    assert receipt_complete(false, true, true, true, true, true) == false;
    assert receipt_complete(true, false, true, true, true, true) == false;
    assert receipt_complete(true, true, false, true, true, true) == false;
    assert receipt_complete(true, true, true, false, true, true) == false;
    assert receipt_complete(true, true, true, true, false, true) == false;
    assert receipt_complete(true, true, true, true, true, false) == false;
}

test "each missing field names itself, in receipt order" {
    assert receipt_first_missing(false, false, false, false, false, false) == 1;
    assert receipt_first_missing(true, false, false, false, false, false) == 2;
    assert receipt_first_missing(true, true, false, false, false, false) == 3;
    assert receipt_first_missing(true, true, true, false, false, false) == 4;
    assert receipt_first_missing(true, true, true, true, false, false) == 5;
    assert receipt_first_missing(true, true, true, true, true, false) == 6;
    assert receipt_first_missing(true, true, true, true, true, true) == 0;
}

test "a dry-run record is not a receipt, whatever else it carries" {
    assert receipt_first_missing(false, true, true, true, true, true) == MISSING_DEVICE_RECORD;
    assert receipt_complete(false, true, true, true, true, true) == false;
}

test "the verdict word must be one the vocabulary defines" {
    assert verdict_word_known(PASS) == true;
    assert verdict_word_known(FAIL) == true;
    assert verdict_word_known(INVALID_NO_RUN) == false;
    assert verdict_word_known(200) == false;
}

test "the producer is compared verbatim, never graded" {
    assert producer_matches(7, 7) == true;
    assert producer_matches(7, 8) == false;
    assert producer_matches(8, 7) == false;
}
