// SPDX-License-Identifier: Apache-2.0
; specs/verified/device_evidence.t27 -- what a device transcript must carry before any hardware step
; of the Verified Compute loop may be called VERIFIED. Epic gHashTag/t27#6655, Phase H (hardware
; evidence; recording the rule, not claiming the hardware).
; --
; What already exists and is NOT restated here:
; - specs/fpga/adapter.t27 (trinity_fpga_adapter) owns receipts end to end: a receipt is a build-only
;   dry_run record or a device record with a transcript; no hardware run may be inferred from
;   synthesis; the board identity is the FULL 32-bit IDCODE because a masked match is not identity.
;   This file only reads those facts as booleans and refuses to conclude without them.
; - specs/verified/region.t27 (#6717) admits a partial image into a region and names the update state;
;   this file adds the last link: when that state may be VERIFIED at all.
; - specs/verified/reuse.t27 owns the triad UNPROVEN / VERIFIED / BLOCKED.
; --
; The evidence rule:
; - Six things must all hold, and each is observable from the receipt: the receipt is a device record
;   (not dry_run); the bitstream the device ran is the sealed image (the same gen bytes the seal
;   verified); the board identity is the full IDCODE (a masked read is not identity); the check ran
;   on the device, not in synthesis; a transcript exists; and a re-run of the same check on the same
;   inputs reported the same verdict (reproducible, not a one-off).
; - Any one missing leaves the step UNPROVEN. There is no partial credit and no inference: a dry_run
;   receipt, a masked IDCODE or a synthesis result can never verify a hardware step.
; - Evidence counts for an update only on top of an admitted image (region.t27 ADMIT) and an unchanged
;   static region (region.t27 partial_update_allowed) -- otherwise the whole design rebuilds and the
;   question is not partial at all.
; first_gap() names the missing part for the report, in the fixed order above; tests pin literals.
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedDeviceEvidence;

use verified::reuse;
use verified::region;

/// first_gap() answers, in evidence order.
pub const GAP_NONE : u8 = 0;
pub const GAP_RECEIPT : u8 = 1;
pub const GAP_BITSTREAM : u8 = 2;
pub const GAP_BOARD : u8 = 3;
pub const GAP_DEVICE_RUN : u8 = 4;
pub const GAP_TRANSCRIPT : u8 = 5;
pub const GAP_REPRODUCIBLE : u8 = 6;

/// The first of the six facts that does not hold, or GAP_NONE when all do.
pub fn first_gap(receipt_device: bool, bitstream: u8, board_full: bool, ran_on_device: bool, transcript: bool, reproducible: bool) -> u8 {
    if (receipt_device == false) { return GAP_RECEIPT; }
    if (bitstream != PART_SAME) { return GAP_BITSTREAM; }
    if (board_full == false) { return GAP_BOARD; }
    if (ran_on_device == false) { return GAP_DEVICE_RUN; }
    if (transcript == false) { return GAP_TRANSCRIPT; }
    if (reproducible == false) { return GAP_REPRODUCIBLE; }
    return GAP_NONE;
}

/// The state of one hardware step given its evidence: VERIFIED only when every fact holds, UNPROVEN
/// otherwise. BLOCKED is not produced here -- a failing adapter blocks before evidence is read
/// (region.t27 partial_update_state owns that path).
pub fn evidence_state(receipt_device: bool, bitstream: u8, board_full: bool, ran_on_device: bool, transcript: bool, reproducible: bool) -> u8 {
    if (first_gap(receipt_device, bitstream, board_full, ran_on_device, transcript, reproducible) == GAP_NONE) {
        return HW_VERIFIED;
    }
    return HW_UNPROVEN;
}

/// Whether a verified step may close a partial update: the image must have been admitted into the
/// region first, the evidence must be VERIFIED, and the static region must be unchanged.
pub fn completes_update(admission: u8, evidence: u8, static_part: u8) -> bool {
    if (admission != ADMIT) { return false; }
    if (evidence != HW_VERIFIED) { return false; }
    return partial_update_allowed(static_part);
}

test "all six facts verify the step" {
    assert evidence_state(true, PART_SAME, true, true, true, true) == HW_VERIFIED;
}

test "any missing fact leaves the step unproven" {
    assert evidence_state(false, PART_SAME, true, true, true, true) == HW_UNPROVEN;
    assert evidence_state(true, PART_DIFF, true, true, true, true) == HW_UNPROVEN;
    assert evidence_state(true, PART_SAME, false, true, true, true) == HW_UNPROVEN;
    assert evidence_state(true, PART_SAME, true, false, true, true) == HW_UNPROVEN;
    assert evidence_state(true, PART_SAME, true, true, false, true) == HW_UNPROVEN;
    assert evidence_state(true, PART_SAME, true, true, true, false) == HW_UNPROVEN;
}

test "first gap names itself in evidence order" {
    assert first_gap(false, PART_MISSING, false, false, false, false) == 1;
    assert first_gap(true, PART_DIFF, false, false, false, false) == 2;
    assert first_gap(true, PART_SAME, false, false, false, false) == 3;
    assert first_gap(true, PART_SAME, true, false, false, false) == 4;
    assert first_gap(true, PART_SAME, true, true, false, false) == 5;
    assert first_gap(true, PART_SAME, true, true, true, false) == 6;
    assert first_gap(true, PART_SAME, true, true, true, true) == 0;
}

test "a dry run receipt can never verify" {
    assert evidence_state(false, PART_SAME, true, true, true, true) == HW_UNPROVEN;
    assert first_gap(false, PART_SAME, true, true, true, true) == GAP_RECEIPT;
}

test "a masked idcode is not identity" {
    assert evidence_state(true, PART_SAME, false, true, true, true) == HW_UNPROVEN;
    assert first_gap(true, PART_SAME, false, true, true, true) == GAP_BOARD;
}

test "an unestablished bitstream link is not a match" {
    assert evidence_state(true, PART_MISSING, true, true, true, true) == HW_UNPROVEN;
    assert first_gap(true, PART_MISSING, true, true, true, true) == GAP_BITSTREAM;
}

test "evidence completes an update only on an admitted image" {
    assert completes_update(ADMIT, HW_VERIFIED, PART_SAME) == true;
    assert completes_update(REJECT_UNKNOWN, HW_VERIFIED, PART_SAME) == false;
    assert completes_update(ADMIT, HW_UNPROVEN, PART_SAME) == false;
    assert completes_update(ADMIT, HW_VERIFIED, PART_DIFF) == false;
}
