// SPDX-License-Identifier: Apache-2.0
// specs/benchmarks/kernel_matmul.t27 -- 24x24 integer matrix product, repeated with a
// rep-dependent fill so no backend can hoist the work (epic #6488, axis C7).
// Every value the remainder operator sees is non-negative, so truncating
// and flooring remainder agree on every backend.

module kernel_matmul;

pub const DIM : u64 = 24;

pub fn matmul_checksum(reps: u64) -> i64 {
    var a : [576]i64 = [0; 576];
    var b : [576]i64 = [0; 576];
    var c : [576]i64 = [0; 576];
    var check : i64 = 0;
    var r : u64 = 0;
    var rv : i64 = 0;
    while (r < reps) {
        var k : u64 = 0;
        var kv : i64 = 0;
        while (k < 576) {
            a[k] = ((kv + rv) * 7) % 11 - 5;
            b[k] = (kv * 3 + rv) % 13 - 6;
            k = k + 1;
            kv = kv + 1;
        }
        var i : u64 = 0;
        while (i < DIM) {
            var j : u64 = 0;
            while (j < DIM) {
                var s : i64 = 0;
                var t : u64 = 0;
                while (t < DIM) {
                    s = s + a[i * DIM + t] * b[t * DIM + j];
                    t = t + 1;
                }
                c[i * DIM + j] = s;
                j = j + 1;
            }
            i = i + 1;
        }
        var m : u64 = 0;
        while (m < 576) {
            check = (check * 31 + c[m] + 1000000) % 1000000007;
            m = m + 1;
        }
        r = r + 1;
        rv = rv + 1;
    }
    return check;
}

test matmul_one_rep {
    assert_eq(matmul_checksum(1), 17928930);
}

test matmul_reps_5000 {
    assert_eq(matmul_checksum(5000), 927571403);
}

endmodule
