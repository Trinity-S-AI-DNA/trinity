// specs/benchmarks/kernel_f64loop.t27 -- the Leibniz series for pi in f64, a dependent chain
// of divides and adds (epic #6488, axis C7). The result is compared with a
// tolerance, never for exact equality.

module kernel_f64loop;

pub fn leibniz(terms: u64) -> f64 {
    var sum : f64 = 0.0;
    var den : f64 = 1.0;
    var sign : f64 = 1.0;
    var k : u64 = 0;
    while (k < terms) {
        sum = sum + sign / den;
        den = den + 2.0;
        sign = 0.0 - sign;
        k = k + 1;
    }
    return 4.0 * sum;
}

pub fn near(a: f64, b: f64, tol: f64) -> bool {
    var d : f64 = a - b;
    if (d < 0.0) {
        d = 0.0 - d;
    }
    return d < tol;
}

test leibniz_few_terms {
    assert(near(leibniz(1), 4.0, 0.000000001));
}

test leibniz_pi {
    assert(near(leibniz(20000000), 3.14159265358979, 0.000001));
}

endmodule
