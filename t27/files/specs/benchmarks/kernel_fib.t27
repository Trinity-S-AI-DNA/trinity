// specs/benchmarks/kernel_fib.t27 -- recursive Fibonacci, a call-heavy compute kernel for the
// t27b backend comparison (epic #6488, axis C7). The same source goes to
// every backend; the test pins the result so a wrong answer is a FAIL.

module kernel_fib;

pub fn fib(n: u64) -> u64 {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

test fib_small {
    assert_eq(fib(10), 55);
}

test fib_35 {
    assert_eq(fib(35), 9227465);
}

endmodule
