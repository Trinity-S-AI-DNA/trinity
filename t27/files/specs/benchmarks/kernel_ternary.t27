// SPDX-License-Identifier: Apache-2.0
// specs/benchmarks/kernel_ternary.t27 -- a ternary kernel: balanced-ternary encode and decode
// of every integer in a range (digits in {-1, 0, 1}), plus a multiplier-free
// ternary dot product, where a trit selects add, skip or subtract
// (epic #6488, axis C7).

module kernel_ternary;

pub const TRITS : u64 = 41;

// Encode x in balanced ternary, decode it again, and return the number of
// non-zero trits; returns -1 if the round trip does not give x back.
pub fn trit_roundtrip(x: i64) -> i64 {
    var digits : [41]i64 = [0; 41];
    var v : i64 = x;
    var k : u64 = 0;
    while (v != 0) {
        var r : i64 = v % 3;
        v = v / 3;
        if (r == 2) {
            r = -1;
            v = v + 1;
        } else if (r == -2) {
            r = 1;
            v = v - 1;
        }
        digits[k] = r;
        k = k + 1;
    }
    var back : i64 = 0;
    var nonzero : i64 = 0;
    var i : u64 = k;
    while (i > 0) {
        i = i - 1;
        back = back * 3 + digits[i];
        if (digits[i] != 0) {
            nonzero = nonzero + 1;
        }
    }
    if (back != x) {
        return -1;
    }
    return nonzero;
}

pub fn trit_census(lo: i64, hi: i64) -> i64 {
    var total : i64 = 0;
    var x : i64 = lo;
    while (x <= hi) {
        const n : i64 = trit_roundtrip(x);
        if (n < 0) {
            return -1;
        }
        total = total + n;
        x = x + 1;
    }
    return total;
}

// Weights are trits drawn from a linear congruential generator; the dot
// product never multiplies, as in a ternary network layer.
pub fn ternary_dot(reps: u64) -> i64 {
    var w : [1000]i64 = [0; 1000];
    var act : [1000]i64 = [0; 1000];
    var s : i64 = 12345;
    var k : u64 = 0;
    while (k < 1000) {
        s = (s * 1103515245 + 12345) % 2147483648;
        w[k] = (s / 65536) % 3 - 1;
        s = (s * 1103515245 + 12345) % 2147483648;
        act[k] = (s / 65536) % 255 - 127;
        k = k + 1;
    }
    var acc : i64 = 0;
    var r : u64 = 0;
    while (r < reps) {
        var d : i64 = 0;
        var i : u64 = 0;
        while (i < 1000) {
            if (w[i] == 1) {
                d = d + act[i];
            } else if (w[i] == -1) {
                d = d - act[i];
            }
            i = i + 1;
        }
        acc = acc + d + (acc % 7);
        act[r % 1000] = act[r % 1000] + 1;
        r = r + 1;
    }
    return acc;
}

test trit_roundtrip_small {
    assert_eq(trit_roundtrip(0), 0);
    assert_eq(trit_roundtrip(8), 2);
    assert_eq(trit_roundtrip(-5), 3);
}

test trit_census_range {
    assert_eq(trit_census(-300000, 300000), 4905080);
}

test ternary_dot_reps {
    assert_eq(ternary_dot(20000), 51560056);
}

endmodule
