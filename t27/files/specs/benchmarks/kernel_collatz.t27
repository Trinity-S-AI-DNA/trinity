// specs/benchmarks/kernel_collatz.t27 -- the longest Collatz chain below a bound: a branchy
// u64 loop with division by two and 3n+1 (epic #6488, axis C7).

module kernel_collatz;

pub fn collatz_steps(start: u64) -> u64 {
    var n : u64 = start;
    var steps : u64 = 0;
    while (n != 1) {
        if (n % 2 == 0) {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        steps = steps + 1;
    }
    return steps;
}

pub fn collatz_max_steps(limit: u64) -> u64 {
    var best : u64 = 0;
    var s : u64 = 1;
    while (s < limit) {
        const c : u64 = collatz_steps(s);
        if (c > best) {
            best = c;
        }
        s = s + 1;
    }
    return best;
}

test collatz_27 {
    assert_eq(collatz_steps(27), 111);
}

test collatz_max_below_1m {
    assert_eq(collatz_max_steps(1000000), 524);
}

endmodule
