// specs/benchmarks/kernel_sieve.t27 -- sieve of Eratosthenes over a local bool array, repeated
// to give a measurable run time (epic #6488, axis C7). The array stays under
// 16 KB so it fits one t27b frame.

module kernel_sieve;

pub const SIEVE_N : u64 = 16000;

pub fn sieve_count(n: u64) -> u64 {
    var composite : [16000]bool = [false; 16000];
    var count : u64 = 0;
    var i : u64 = 2;
    while (i < n) {
        if (!composite[i]) {
            count = count + 1;
            var j : u64 = i * i;
            while (j < n) {
                composite[j] = true;
                j = j + i;
            }
        }
        i = i + 1;
    }
    return count;
}

pub fn sieve_reps(reps: u64) -> u64 {
    var total : u64 = 0;
    var r : u64 = 0;
    while (r < reps) {
        total = total + sieve_count(SIEVE_N - (r % 2));
        r = r + 1;
    }
    return total;
}

test sieve_primes_below_100 {
    assert_eq(sieve_count(100), 25);
}

test sieve_reps_2000 {
    assert_eq(sieve_reps(2000), 3724000);
}

endmodule
