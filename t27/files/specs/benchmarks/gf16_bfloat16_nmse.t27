// SPDX-License-Identifier: Apache-2.0
; specs/benchmarks/gf16_bfloat16_nmse.t27 -- GF16 against bfloat16 NMSE protocol (TRI-NET benchmark 0)
; The standard comparison of GoldenFloat GF16 and bfloat16 numeric fidelity, as normalised
; mean squared error over named reference distributions. Protocol only: no silicon number
; is asserted. ASCII only (L3).

; Until this rewrite the file was a Markdown document with a .t27 name, which the parser
; refused at its first line, and its tests and invariants had comment-only bodies. The
; protocol is unchanged; the parts of it that are arithmetic are now checked.

; Human-readable mirror: docs/GF16_BFLOAT16_NMSE_PROTOCOL.md. Manifest schema:
; schemas/nmse-protocol-v1.json. Numeric SSOT: conformance/FORMAT-SPEC-001.json and
; specs/numeric/gf16.t27 (L6). Artefact consumer contract: docs/TRI_NET_API.md.

; NMSE(F) = E[(x - Q_F(x))^2] / E[x^2]. A ratio below 1.0 favours GF16 on that
; distribution, above 1.0 favours BF16, 1.0 ties; a ratio is never reported without its
; distribution and seed, and never compared against a commercial-NPU number.
; phi^2 + 1/phi^2 = 3 | TRINITY

module gf16_bfloat16_nmse;

pub const PROTOCOL_MAJOR : u32 = 1;
pub const SCHEMA : str = "schemas/nmse-protocol-v1.json";

pub const PHI : f64 = 1.618033988749895;
; L5 witnesses: a run aborts before reporting any NMSE if either fails.
pub const WITNESS_TOLERANCE : f64 = 1e-15;

; GF16: [S(1) | E(6) | M(9)], bias 31, value (-1)^S * 2^(E - 31) * (1 + M / 2^9).
pub const GF16_SIGN_BITS : u32 = 1;
pub const GF16_EXP_BITS : u32 = 6;
pub const GF16_MANT_BITS : u32 = 9;
pub const GF16_BIAS : u32 = 31;
; bfloat16: [S(1) | E(8) | M(7)], bias 127, value (-1)^S * 2^(E - 127) * (1 + M / 2^7).
pub const BF16_SIGN_BITS : u32 = 1;
pub const BF16_EXP_BITS : u32 = 8;
pub const BF16_MANT_BITS : u32 = 7;
pub const BF16_BIAS : u32 = 127;
pub const ROUNDING : str = "round_to_nearest_ties_to_even";
; BF16 subnormal policy, which a manifest must declare.
pub const SUBNORMAL_POLICIES : [2]str = ["ieee", "ftz"];

pub const DISTRIBUTIONS : [5]str = ["D_NORM: x ~ N(0, 1)", "D_LOG: log2|x| ~ U(-10, 10), sign uniform", "D_RELU: x = max(0, N(0, 1))", "D_PHI: x ~ N(phi, 1/phi)", "D_DEEP: 0.7 D_NORM + 0.3 D_LOG"];
pub const D_DEEP_NORM_WEIGHT : f64 = 0.7;
pub const D_DEEP_LOG_WEIGHT : f64 = 0.3;
pub const SAMPLES_PER_DISTRIBUTION : u32 = 10000000;

pub const FAIL_MODES : [3]str = ["identity_witness_fail -> abort, no manifest emitted", "subnormal_policy_missing -> abort, no manifest emitted", "seal_hash_missing -> emit manifest tagged informational"];

pub const NON_CLAIMS : [3]str = ["no measured NMSE on silicon is asserted", "GF16 is not asserted to win or lose against BF16 in general", "nothing is assumed about the sign of a ratio without a distribution and a seed"];

; NMSE is undefined when the reference has no energy; the run reports null rather than
; dividing by zero.
fn nmse_defined(mean_sq_ref : f64) -> bool {
    return mean_sq_ref > 0.0;
}

fn nmse(mean_sq_err : f64, mean_sq_ref : f64) -> f64 {
    return mean_sq_err / mean_sq_ref;
}

test "identity_witnesses_hold_in_f64" {
    assert(PHI * PHI - (PHI + 1.0) < WITNESS_TOLERANCE);
    assert((PHI + 1.0) - PHI * PHI < WITNESS_TOLERANCE);
    assert(PHI * PHI + 1.0 / (PHI * PHI) - 3.0 < WITNESS_TOLERANCE);
    assert(3.0 - (PHI * PHI + 1.0 / (PHI * PHI)) < WITNESS_TOLERANCE);
}

test "both_layouts_are_sixteen_bits" {
    assert(GF16_SIGN_BITS + GF16_EXP_BITS + GF16_MANT_BITS == 16);
    assert(BF16_SIGN_BITS + BF16_EXP_BITS + BF16_MANT_BITS == 16);
}

test "biases_are_half_the_exponent_range" {
    // 2^(E - 1) - 1: 2^5 - 1 = 31 and 2^7 - 1 = 127.
    assert(GF16_BIAS == 32 - 1);
    assert(BF16_BIAS == 128 - 1);
}

test "gf16_trades_exponent_for_mantissa" {
    assert(GF16_MANT_BITS == BF16_MANT_BITS + 2);
    assert(GF16_EXP_BITS + 2 == BF16_EXP_BITS);
}

test "d_deep_mixture_weights_sum_to_one" {
    assert(D_DEEP_NORM_WEIGHT + D_DEEP_LOG_WEIGHT == 1.0);
}

test "nmse_non_negative_and_zero_baseline_undefined" {
    assert(nmse_defined(1.0));
    assert(nmse_defined(0.0) == false);
    assert(nmse(0.0, 1.0) == 0.0);
    assert(nmse(0.25, 1.0) >= 0.0);
}

test "ratio_direction" {
    // ratio = nmse_gf16 / nmse_bf16; below 1.0 favours GF16.
    assert(nmse(0.001, 1.0) / nmse(0.004, 1.0) < 1.0);
    assert(nmse(0.004, 1.0) / nmse(0.001, 1.0) > 1.0);
}
