pub const PERMISSION_GATE_IN_TREE : str = "src/tri-api/permissions.zig (the client side): deny rules over allow rules over defaults; read_file and grep are allowed by default, every other tool is denied; a denied MCP tool never reaches the executor and returns Permission denied with is_error";
