pub const DISPATCH_LAYERS : [5]str = ["global flags and the interactive REPL (src/tri/main.zig:82-127)", "a first-argument chain of string comparisons (src/tri/main.zig:134-639)", "two static handler maps of cell dispatch (src/tri/tri_cell_dispatch.zig)", "cell-contributed two-word commands, matched before the flat switch, that spawn zig-out/bin/<word> (src/tri/tri_cell_dispatch.zig:288-385)", "six namespaces and a flat Command enum of 186 variants behind parseCommand (src/tri/tri_namespace.zig, src/tri/tri_utils.zig:35-1069)"];
pub const FINDING_COUNT : u32 = 10;
pub const FINDINGS : [10]str = ["the consumer has a tri binary (build.zig:2134, exe tri, run step tri); the statement that it has none is withdrawn from specs/tools/README.md and docs/system/tooling.md", "the command table holds 187 commands and the export keeps the 29 with mcp_enabled: 158 commands the binary dispatches are in no registry artifact CI checks", "six exported commands reach no dispatcher at the pin (their execute_map entries are among the 18 commented out): their MCP tools have no CLI behind them", "the comptime check that every execute_map entry exists in the command table is commented out (src/tri/tri_register.zig:1268-1280)", "the MCP server advertises 210 tools from a literal of which 32 objects are malformed JSON, the exporter writes 29 from the table, nine names are common to both, and the server never reads the export", "tri mcp tools is unreachable: the cell of tools/mcp/trinity_mcp claims the two-word command first and spawns a binary that does not exist", "tri --help lists six commands no layer dispatches (auto-commit, ml-optimize, deploy-dashboard, self-host, safeguards, safeguards-disable) and omits every layer-two namespace; a --search flag the README documents does not exist", "two ExitCode enums coexist (sysexits in observability.zig, 0..7 in tri_exit_codes.zig) and the sysexits mapping is reached from no caller: UnifiedOutput status carries failure at exit 0", "the only workflow step that runs a tri command runs `tri --version || true`, `tri help || true`, `tri constants || true` (docs-check.yml); no workflow builds or runs trinity-mcp or needle-mcp", "docs/command_registry.md (165 CLI, 23 MCP, 120 API), docs/api_reference.md (47+ tools), cell.tri (47+), server.zig (35+, 38+), resources.zig (280+ commands) and README.md (100+) each count differently; the registry export and the source are the numbers above"];
pub const ENABLED : bool = true;

; --- Rules -------------------------------------------------------------------------------------------

pub fn resolve_legacy(in_t27: bool, in_trinity: bool) -> u32 {
    if (in_t27) { return RESOLVE_LEGACY; }
    if (in_trinity) { return RESOLVE_NEEDS_REPOSITORY; }
    return RESOLVE_UNKNOWN;
}

pub fn is_collision(in_t27: bool, in_trinity: bool) -> bool {
    return in_t27 and in_trinity;
}

pub fn legacy_selects_trinity(in_t27: bool, in_trinity: bool) -> bool {
    return false;
}

pub fn witness_rank(witness: u32) -> u32 {
    if (witness > 3) { return 0; }
    return witness + 1;
}

pub fn witness_claims_runtime(witness: u32) -> bool {
    return witness == 3;
}

pub fn card_is_qualified(has_repo: bool, has_qualified_id: bool, schema: u32) -> bool {
    return has_repo and has_qualified_id and schema == SCHEMA_VERSION;
}

pub fn exported_share(exported: u32, table: u32) -> u32 {
    return (exported * 100) / table;
}

invariant the_legacy_table_covers_every_legacy_card { LEGACY_COUNT == T27_TRI_CARDS + MCP_CARDS }
invariant the_trinity_cards_are_the_export { TRINITY_TRI_CARDS == TRINITY_EXPORTED }
invariant the_export_is_the_mcp_enabled_subset { TRINITY_EXPORTED == TRINITY_TABLE_MCP_ENABLED }
invariant the_overlap_is_within_the_export { TRINITY_MCP_OVERLAP <= TRINITY_EXPORTED }

test a_legacy_id_never_selects_the_other_repository {
    assert resolve_legacy(true, false) == RESOLVE_LEGACY;
    assert resolve_legacy(true, true) == RESOLVE_LEGACY;
    assert resolve_legacy(false, true) == RESOLVE_NEEDS_REPOSITORY;
    assert resolve_legacy(false, false) == RESOLVE_UNKNOWN;
    assert legacy_selects_trinity(true, true) == false;
    assert legacy_selects_trinity(false, true) == false;
}

test the_collisions_are_the_names_both_binaries_dispatch {
    assert is_collision(true, true) == true;
    assert is_collision(true, false) == false;
    assert COLLISIONS[0] == "fpga";
    assert COLLISIONS[1] == "test";
    assert COLLISION_COUNT == 2;
}

test witnesses_rank_and_only_runtime_claims_runtime {
    assert witness_rank(0) == 1;
    assert witness_rank(3) == 4;
    assert witness_rank(4) == 0;
    assert witness_claims_runtime(0) == false;
    assert witness_claims_runtime(1) == false;
    assert witness_claims_runtime(3) == true;
}

test schema_two_needs_the_three_fields {
    assert card_is_qualified(true, true, 2) == true;
    assert card_is_qualified(true, true, 1) == false;
    assert card_is_qualified(false, true, 2) == false;
    assert LEGACY_IDS[0] == "tri/abandoned";
    assert LEGACY_TARGETS[0] == "gHashTag/t27:tri/abandoned";
}

test the_export_is_a_sixth_of_the_table {
    assert exported_share(TRINITY_EXPORTED, TRINITY_TABLE_COMMANDS) == EXPORTED_SHARE_PERCENT;
    assert TRINITY_EXPORTED_UNROUTED == 6;
    assert UNROUTED_EXPORTED[0] == "blindspots";
}
