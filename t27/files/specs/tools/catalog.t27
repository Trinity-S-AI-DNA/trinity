; --- Evidence -----------------------------------------------------------------------------------------
pub const WITNESSES : [4]str = ["source-parse", "registry-export", "help-output", "runtime"];
pub const WITNESS_RULE : str = "source-parse: read from the source at a named commit; registry-export: read from an artifact the binary itself exported and CI holds to the binary; help-output: diffed against the binary's own --help on a named host; runtime: an invocation and its result recorded. Source parsing alone never claims runtime verification";
pub const WITNESS_T27_TRI : str = "source-parse on the cards, help-output measured by tools/trinity_tools_registry.py inventory --tri against target/release/tri: 52 of 52 names and every ACTIONS list agree with the binary's help (clap's implicit help subcommand set aside)";
pub const WITNESS_TRINITY_TRI : str = "registry-export: no host builds the Trinity tri, and no workflow runs its help; its cards claim nothing about runtime";
pub const WITNESS_MCP : str = "source-parse: no workflow runs either MCP server; specs/tools/mcp_protocol.t27 states the behaviour read from the source";
