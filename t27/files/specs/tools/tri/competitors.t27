// SPDX-License-Identifier: Apache-2.0
; specs/tools/tri/competitors.t27 -- tool tri/competitors, the `tri competitors` command of the tri CLI
; Source of truth for the tool card on t27.ai (#/tools?tool=tri/competitors).
; Extracted from the clap #[derive(Subcommand)] enums in cli/tri/src (witness source-parse:
; cargo was not run, the enum and its /// docs were read at commit 3cb7a4352492).
; Layer 5 of the ladder Specs -> Skills -> Crons -> Agents -> Tools. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module tool_tri_competitors;

pub const KIND : str = "tool";
pub const FAMILY : str = "tri-cli";
pub const ID : str = "tri/competitors";
pub const REPO : str = "gHashTag/t27";
pub const QUALIFIED_ID : str = "gHashTag/t27:tri/competitors";
pub const SCHEMA : u32 = 2;
pub const COMMAND : str = "tri competitors";
; clap enum variant and where the dispatch lands
pub const VARIANT : str = "Commands::Competitors";
pub const SOURCE : str = "cli/tri/src/competitors.rs";
pub const ENTRY : str = "cli/tri/src/main.rs";
; The clap about text (first /// paragraph), as `tri --help` would print it.
pub const ABOUT : str = "The competitor table against its own contract: how many of its published scores were never published, and how many papers it counts twice.";
pub const ABOUT_SOURCE : str = "clap /// doc on Commands::Competitors (cli/tri/src/main.rs; module cli/tri/src/competitors.rs)";
; Nested subcommands (kebab-case as clap derives them) and their first /// paragraph ("" when none).
pub const ACTIONS : [2]str = ["audit", "freshness"];
pub const ACTIONS_ABOUT : [2]str = ["Count the records, the double-entered papers and the unpublished zeros.", "When the survey behind this table last read a paper, by the month its citations encode."];
; Top-level arguments/flags of the command itself, "<name>: doc".
pub const ARGS : [0]str = [];
; Agent letters that own this command, only where a source line names it (AGENTS_NOTE cites it).
pub const AGENTS : [2]str = ["T", "V"];
pub const AGENTS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\" binds every tool to the Queen (T). Domain lead V: ABOUT audits \"The competitor table against its own contract: how many of its published scores were never published, and how many papers it counts twice\", with actions counting records/double-entered papers and \"When the survey behind this table last read a paper\" -- the benchmark comparison record, V's Verdict / Bench domain.";
; From the about text (long about when the doc has more than one paragraph); no marketing.
pub const WHEN_TO_USE : str = "The competitor table against its own contract: how many of its published scores were never published, and how many papers it counts twice.";
; Recorded run: https://t27.ai/term/t27-tri-competitors/ (gHashTag/trinity apps/website/public/term/t27-tri-competitors/).
; Its meta.json lists 1 run of `tri competitors`; no other tri has a command of that name.
; Recorded with target/release/tri built from gHashTag/t27 at 1b12580ce699, not at the commit
; this card was extracted from. The site plays it at the end of this card.
pub const CAST : str = "term/t27-tri-competitors/session.cast";
pub const WITNESS : str = "source-parse";
pub const ENABLED : bool = true;

test verify_constants {
    assert KIND == "tool";
    assert FAMILY == "tri-cli";
    assert ID == "tri/competitors";
    assert REPO == "gHashTag/t27";
    assert QUALIFIED_ID == "gHashTag/t27:tri/competitors";
    assert SCHEMA == 2;
    assert COMMAND == "tri competitors";
    assert VARIANT == "Commands::Competitors";
    assert ENABLED == true;
    assert AGENTS[0] == "T";
    assert AGENTS[1] == "V";
    assert ACTIONS[0] == "audit";
    assert ACTIONS[1] == "freshness";
    assert CAST == "term/t27-tri-competitors/session.cast";
}
