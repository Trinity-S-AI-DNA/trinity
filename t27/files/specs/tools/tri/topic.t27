// SPDX-License-Identifier: Apache-2.0
; specs/tools/tri/topic.t27 -- tool tri/topic, the `tri topic` command of the tri CLI
; Source of truth for the tool card on t27.ai (#/tools?tool=tri/topic).
; Extracted from the clap #[derive(Subcommand)] enums in cli/tri/src (witness source-parse:
; cargo was not run, the enum and its /// docs were read at commit 3cb7a4352492).
; Layer 5 of the ladder Specs -> Skills -> Crons -> Agents -> Tools. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module tool_tri_topic;

pub const KIND : str = "tool";
pub const FAMILY : str = "tri-cli";
pub const ID : str = "tri/topic";
pub const REPO : str = "gHashTag/t27";
pub const QUALIFIED_ID : str = "gHashTag/t27:tri/topic";
pub const SCHEMA : u32 = 2;
pub const COMMAND : str = "tri topic";
; clap enum variant and where the dispatch lands
pub const VARIANT : str = "Commands::Topic";
pub const SOURCE : str = "cli/tri/src/main.rs";
pub const ENTRY : str = "cli/tri/src/main.rs";
; The clap about text (first /// paragraph), as `tri --help` would print it.
pub const ABOUT : str = "Has anyone already done this, or are they doing it now?";
pub const ABOUT_SOURCE : str = "clap /// doc on Commands::Topic (cli/tri/src/main.rs)";
; Nested subcommands (kebab-case as clap derives them) and their first /// paragraph ("" when none).
pub const ACTIONS : [0]str = [];
pub const ACTIONS_ABOUT : [0]str = [];
; Top-level arguments/flags of the command itself, "<name>: doc".
pub const ARGS : [2]str = ["<keywords>: Words to look for. A row matches on any; rows carrying more come first.", "--commits: How many recent commits on the base branch to read."];
; Agent letters that own this command, only where a source line names it (AGENTS_NOTE cites it).
pub const AGENTS : [2]str = ["T", "J"];
pub const AGENTS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\" binds every tool to the Queen (T). Domain lead J: ABOUT is \"Has anyone already done this, or are they doing it now?\" and topic.rs scans \"open pull requests, recent commits on the base branch, open issues, and the section titles of every SKILL.md\" after \"[t]wice in one session I started work another session had shipped or had open\" -- work dispatch / duplicate-assignment, J's \"grab tasks and routing\".";
; From the about text (long about when the doc has more than one paragraph); no marketing.
pub const WHEN_TO_USE : str = "Has anyone already done this, or are they doing it now?";
pub const WITNESS : str = "source-parse";
pub const ENABLED : bool = true;

test verify_tool_constants {
  assert KIND == "tool";
  assert FAMILY == "tri-cli";
  assert SCHEMA == 2;
  assert ENABLED == true;
}
