// SPDX-License-Identifier: Apache-2.0
; specs/tools/tri/abandoned.t27 -- tool tri/abandoned, the `tri abandoned` command of the tri CLI
; Source of truth for the tool card on t27.ai (#/tools?tool=tri/abandoned).
; Extracted from the clap #[derive(Subcommand)] enums in cli/tri/src (witness source-parse:
; cargo was not run, the enum and its /// docs were read at commit 3cb7a4352492).
; Layer 5 of the ladder Specs -> Skills -> Crons -> Agents -> Tools. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module tool_tri_abandoned;

pub const KIND : str = "tool";
pub const FAMILY : str = "tri-cli";
pub const ID : str = "tri/abandoned";
pub const REPO : str = "gHashTag/t27";
pub const QUALIFIED_ID : str = "gHashTag/t27:tri/abandoned";
pub const SCHEMA : u32 = 2;
pub const COMMAND : str = "tri abandoned";
; clap enum variant and where the dispatch lands
pub const VARIANT : str = "Commands::Abandoned";
pub const SOURCE : str = "cli/tri/src/abandoned.rs";
pub const ENTRY : str = "cli/tri/src/main.rs";
; The clap about text (first /// paragraph), as `tri --help` would print it.
pub const ABOUT : str = "Recovery sites whose own comment names the construct they discard.";
pub const ABOUT_SOURCE : str = "clap /// doc on Commands::Abandoned (cli/tri/src/main.rs; module cli/tri/src/abandoned.rs)";
; Nested subcommands (kebab-case as clap derives them) and their first /// paragraph ("" when none).
pub const ACTIONS : [1]str = ["list"];
pub const ACTIONS_ABOUT : [1]str = ["List recovery sites whose preceding comment names a concrete construct."];
; Top-level arguments/flags of the command itself, "<name>: doc".
pub const ARGS : [0]str = [];
; Agent letters that own this command, only where a source line names it (AGENTS_NOTE cites it).
pub const AGENTS : [2]str = ["T", "C"];
pub const AGENTS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\" binds every tool to the Queen (T). Domain lead C: The one action is \"List recovery sites whose preceding comment names a concrete construct\", and SOURCE cli/tri/src/abandoned.rs defaults its --file to bootstrap/src/compiler.rs and opens \"shapes the parser had already described in prose and never handled\" -- parser recovery in C's own key file.";
; From the about text (long about when the doc has more than one paragraph); no marketing.
pub const WHEN_TO_USE : str = "Recovery sites whose own comment names the construct they discard.";
pub const WITNESS : str = "source-parse";
pub const ENABLED : bool = true;

test verify_constants {
    assert KIND == "tool";
    assert FAMILY == "tri-cli";
    assert ID == "tri/abandoned";
    assert REPO == "gHashTag/t27";
    assert QUALIFIED_ID == "gHashTag/t27:tri/abandoned";
    assert SCHEMA == 2;
    assert COMMAND == "tri abandoned";
    assert VARIANT == "Commands::Abandoned";
    assert ENABLED == true;
    assert AGENTS[0] == "T";
    assert AGENTS[1] == "C";
    assert ACTIONS[0] == "list";
}
