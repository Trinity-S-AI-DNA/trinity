// SPDX-License-Identifier: Apache-2.0
; specs/tools/tri/discard.t27 -- tool tri/discard, the `tri discard` command of the tri CLI
; Source of truth for the tool card on t27.ai (#/tools?tool=tri/discard).
; Extracted from the clap #[derive(Subcommand)] enums in cli/tri/src (witness source-parse:
; cargo was not run, the enum and its /// docs were read at commit 3cb7a4352492).
; Layer 5 of the ladder Specs -> Skills -> Crons -> Agents -> Tools. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module tool_tri_discard;

pub const KIND : str = "tool";
pub const FAMILY : str = "tri-cli";
pub const ID : str = "tri/discard";
pub const REPO : str = "gHashTag/t27";
pub const QUALIFIED_ID : str = "gHashTag/t27:tri/discard";
pub const SCHEMA : u32 = 2;
pub const COMMAND : str = "tri discard";
; clap enum variant and where the dispatch lands
pub const VARIANT : str = "Commands::Discard";
pub const SOURCE : str = "cli/tri/src/discard.rs";
pub const ENTRY : str = "cli/tri/src/main.rs";
; The clap about text (first /// paragraph), as `tri --help` would print it.
pub const ABOUT : str = "What the parser reads and throws away, ranked against its pinned bound.";
pub const ABOUT_SOURCE : str = "clap /// doc on Commands::Discard (cli/tri/src/main.rs; module cli/tri/src/discard.rs)";
; Nested subcommands (kebab-case as clap derives them) and their first /// paragraph ("" when none).
pub const ACTIONS : [2]str = ["top", "classify"];
pub const ACTIONS_ABOUT : [2]str = ["Rank the discarding specs, largest first, against the pinned volume.", "Group the discard by which recovery threw it away, and what it stopped on."];
; Top-level arguments/flags of the command itself, "<name>: doc".
pub const ARGS : [0]str = [];
; Agent letters that own this command, only where a source line names it (AGENTS_NOTE cites it).
pub const AGENTS : [2]str = ["T", "C"];
pub const AGENTS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\" binds every tool to the Queen (T). Domain lead C: ABOUT is \"What the parser reads and throws away, ranked against its pinned bound\" and classify groups the discard \"by which recovery threw it away, and what it stopped on\" -- parser behaviour, Compiler Core.";
; From the about text (long about when the doc has more than one paragraph); no marketing.
pub const WHEN_TO_USE : str = "What the parser reads and throws away, ranked against its pinned bound.";
; Recorded run: https://t27.ai/term/t27-tri-discard/ (gHashTag/trinity apps/website/public/term/t27-tri-discard/).
; Its meta.json lists 1 run of `tri discard`; no other tri has a command of that name.
; Recorded with target/release/tri built from gHashTag/t27 at 1b12580ce699, not at the commit
; this card was extracted from. The site plays it at the end of this card.
pub const CAST : str = "term/t27-tri-discard/session.cast";
pub const WITNESS : str = "source-parse";
pub const ENABLED : bool = true;

test verify_constants {
    assert KIND == "tool";
    assert FAMILY == "tri-cli";
    assert ID == "tri/discard";
    assert REPO == "gHashTag/t27";
    assert QUALIFIED_ID == "gHashTag/t27:tri/discard";
    assert SCHEMA == 2;
    assert COMMAND == "tri discard";
    assert VARIANT == "Commands::Discard";
    assert ENABLED == true;
    assert AGENTS[0] == "T";
    assert AGENTS[1] == "C";
    assert ACTIONS[0] == "top";
    assert ACTIONS[1] == "classify";
    assert CAST == "term/t27-tri-discard/session.cast";
}
