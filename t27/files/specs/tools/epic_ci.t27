// specs/tools/epic_ci.t27 -- epic-ci tool logic: classifies checks, detects newly red, calculates exit codes
// gHashTag/t27#6087 | φ² + 1/φ² = 3 | TRINITY

module ToolsEpicCi;

// Status codes: 0 = pending, 1 = red, 2 = green
pub const STATUS_PENDING : u32 = 0;
pub const STATUS_RED : u32 = 1;
pub const STATUS_GREEN : u32 = 2;

// CheckRun conclusion codes
pub const CONCLUSION_SUCCESS : u32 = 0;
pub const CONCLUSION_NEUTRAL : u32 = 1;
pub const CONCLUSION_SKIPPED : u32 = 2;
pub const CONCLUSION_FAILURE : u32 = 3;
pub const CONCLUSION_TIMED_OUT : u32 = 4;
pub const CONCLUSION_CANCELLED : u32 = 5;
pub const CONCLUSION_ACTION_REQUIRED : u32 = 6;
pub const CONCLUSION_STARTUP_FAILURE : u32 = 7;

// StatusContext state codes
pub const STATE_SUCCESS : u32 = 0;
pub const STATE_FAILURE : u32 = 1;
pub const STATE_ERROR : u32 = 2;
pub const STATE_PENDING : u32 = 3;
pub const STATE_STATELESS : u32 = 4;

// Classify a CheckRun entry based on completion status and conclusion
pub fn classify_check_run(completed: bool, conclusion: u32) -> u32 {
    if (!completed) {
        // Not completed -> pending
        return STATUS_PENDING;
    }
    
    // Completed: check conclusion
    if (conclusion == CONCLUSION_SUCCESS or 
        conclusion == CONCLUSION_NEUTRAL or 
        conclusion == CONCLUSION_SKIPPED) {
        return STATUS_GREEN;
    }
    
    if (conclusion == CONCLUSION_FAILURE or 
        conclusion == CONCLUSION_TIMED_OUT or 
        conclusion == CONCLUSION_CANCELLED or 
        conclusion == CONCLUSION_ACTION_REQUIRED or 
        conclusion == CONCLUSION_STARTUP_FAILURE) {
        return STATUS_RED;
    }
    
    // Any other conclusion -> pending
    return STATUS_PENDING;
}

// Classify a StatusContext entry based on state
pub fn classify_status_context(state: u32) -> u32 {
    if (state == STATE_SUCCESS) {
        return STATUS_GREEN;
    }
    
    if (state == STATE_FAILURE or state == STATE_ERROR) {
        return STATUS_RED;
    }
    
    // Any other state -> pending
    return STATUS_PENDING;
}

// Determine if a check is newly red (red now but was not red before)
pub fn is_newly_red(red_now: bool, red_before: bool) -> bool {
    return red_now and (!red_before);
}

// Calculate exit code based on newly red checks, previous snapshot availability, and file readability
pub fn exit_code(newly_red: u32, has_previous: bool, unreadable: bool) -> u32 {
    if (unreadable) {
        return 2;
    }
    
    if (newly_red > 0) {
        return 1;
    }
    
    return 0;
}

// Test the classification logic
test "classify_check_run_success" {
    let result = classify_check_run(true, CONCLUSION_SUCCESS);
    assert(result == STATUS_GREEN);
}

test "classify_check_run_failure" {
    let result = classify_check_run(true, CONCLUSION_FAILURE);
    assert(result == STATUS_RED);
}

test "classify_check_run_timed_out" {
    let result = classify_check_run(true, CONCLUSION_TIMED_OUT);
    assert(result == STATUS_RED);
}

test "classify_check_run_skipped" {
    let result = classify_check_run(true, CONCLUSION_SKIPPED);
    assert(result == STATUS_GREEN);
}

test "classify_check_run_in_progress" {
    let result = classify_check_run(false, CONCLUSION_SUCCESS);
    assert(result == STATUS_PENDING);
}

test "classify_status_context_success" {
    let result = classify_status_context(STATE_SUCCESS);
    assert(result == STATUS_GREEN);
}

test "classify_status_context_failure" {
    let result = classify_status_context(STATE_FAILURE);
    assert(result == STATUS_RED);
}

test "classify_status_context_error" {
    let result = classify_status_context(STATE_ERROR);
    assert(result == STATUS_RED);
}

test "classify_status_context_pending" {
    let result = classify_status_context(STATE_PENDING);
    assert(result == STATUS_PENDING);
}

test "is_newly_red_true" {
    let result = is_newly_red(true, false);
    assert(result == true);
}

test "is_newly_red_false_now_red" {
    let result = is_newly_red(true, true);
    assert(result == false);
}

test "is_newly_red_false_not_red" {
    let result = is_newly_red(false, false);
    assert(result == false);
}

test "is_newly_red_false_now_not_red" {
    let result = is_newly_red(false, true);
    assert(result == false);
}

test "exit_code_unreadable" {
    let result = exit_code(0, true, true);
    assert(result == 2);
}

test "exit_code_newly_red" {
    let result = exit_code(1, true, false);
    assert(result == 1);
}

test "exit_code_no_newly_red" {
    let result = exit_code(0, true, false);
    assert(result == 0);
}

test "exit_code_no_previous" {
    let result = exit_code(0, false, false);
    assert(result == 0);
}