    // list_dangerous returns tools that are dangerous
    fn list_dangerous(registry: ToolRegistry) -> [ToolID] {
        var dangerous_tools: [ToolID] = [];
        var tool_ids = list(registry);
        for (tool_id in tool_ids) {
            var tool_def = get(registry, tool_id).unwrap();
            if (is_dangerous(tool_def.metadata)) {
                dangerous_tools.append(tool_id);
            }
        }
        return dangerous_tools;
    }

    test "list_dangerous_empty" {
        var registry = create();
        var dangerous = list_dangerous(registry);
        assert(dangerous.len == 0);
    }

