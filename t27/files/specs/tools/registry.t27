    test "tool_id_creation" {
        var id = ToolID("bash");
        assert(id.0 == "bash");
    }

    test "call_id_creation" {
        var id = CallID("call-abc");
        assert(id.0 == "call-abc");
    }

    test "registry_creation" {
        var registry = create();
        assert(is_empty(registry));
        assert(count(registry) == 0);
    }

