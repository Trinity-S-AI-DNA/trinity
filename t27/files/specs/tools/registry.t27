    // list_custom returns all custom tools
    fn list_custom(registry: ToolRegistry) -> [ToolID] {
        var custom_tools: [ToolID] = [];
        for (tool_id in registry.tools) {
            var tool_def = registry.tools[tool_id];
            if (tool_def.metadata.category == ToolCategory::Custom) {
                custom_tools.append(tool_id);
            }
        }
        return custom_tools;
    }

