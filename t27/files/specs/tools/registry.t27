    // Custom Tool Operations
    // ════════════════════════════════════════════════════════════════════

    // register_custom registers a custom tool
    fn register_custom(registry: ToolRegistry, tool: ToolDefinition) -> Result<void, ToolError> {
        var custom_tool = ToolDefinition {
            id = tool.id,
            description = tool.description,
            parameters = tool.parameters,
            metadata = ToolMetadata {
                category = ToolCategory::Custom,
                permission = tool.metadata.permission,
                dangerous = tool.metadata.dangerous,
                experimental = tool.metadata.experimental,
                truncated = tool.metadata.truncated,
                outputPath = tool.metadata.outputPath,
            },
        };
        return register(registry, custom_tool);
    }

