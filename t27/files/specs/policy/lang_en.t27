// SPDX-License-Identifier: Apache-2.0
; specs/policy/lang_en.t27 -- LANG-EN for specs: no Cyrillic in a .t27 or .tri file under specs/.
; bootstrap/build.rs used to scan every spec for this and printed a rerun-if-changed line per spec,
; so editing one spec rebuilt t27c, and the rebuilt binary (it embeds the git commit) missed every
; row of the t27b reference cache: the whole corpus was re-referenced on every PR (#7548).
; The check moves here and runs in CI (spec-guards) on the specs a PR changes; t27c no longer
; rebuilds when a spec changes.
; --
; - Cyrillic is U+0400..U+04FF. In UTF-8 that is a lead byte 0xD0..0xD3 followed by a
;   continuation byte 0x80..0xBF. Greek (phi is U+03C6 = CF 86), superscripts (C2 B2) and
;   punctuation (em dash E2 80 94) stay allowed: math in comments is not prose in Russian.
; - The answer is the 1-based line of the first Cyrillic character, or 0 when there is none,
;   so CI can print path:line.
; phi^2 + 1/phi^2 = 3 | TRINITY

module PolicyLangEn;

pub const LEAD_LO : u8 = 208;
pub const LEAD_HI : u8 = 211;
pub const CONT_LO : u8 = 128;
pub const CONT_HI : u8 = 191;

/// 1-based line of the first Cyrillic character in s[0..n], 0 when there is none.
pub fn first_cyrillic_line(s: []const u8, n: usize) -> u32 {
    var line : u32 = 1;
    var i : usize = 0;
    while (i + 1 < n) {
        if (s[i] == '\n') { line = line + 1; }
        if (s[i] >= LEAD_LO and s[i] <= LEAD_HI and s[i + 1] >= CONT_LO and s[i + 1] <= CONT_HI) { return line; }
        i = i + 1;
    }
    return 0;
}

// Bytes are set by number: a string literal cannot carry a raw UTF-8 lead byte through the
// L3 ASCII-only rule this repository applies to its own sources.
test ascii_has_no_cyrillic {
    var b : [4]u8 = undefined;
    b[0] = 'a';
    b[1] = 10;
    b[2] = 'b';
    b[3] = 'c';
    assert first_cyrillic_line(&b, 4) == 0;
    assert first_cyrillic_line(&b, 0) == 0;
}

test the_line_of_the_first_cyrillic_character_is_reported {
    var b : [5]u8 = undefined;
    b[0] = 'a';
    b[1] = 10;
    b[2] = 'b';
    b[3] = 208;
    b[4] = 191;
    assert first_cyrillic_line(&b, 5) == 2;
    b[0] = 10;
    assert first_cyrillic_line(&b, 5) == 3;
    b[2] = 10;
    assert first_cyrillic_line(&b, 5) == 4;
    b[0] = 209;
    b[1] = 143;
    assert first_cyrillic_line(&b, 5) == 1;
}

test both_ends_of_the_block_are_cyrillic {
    var b : [2]u8 = undefined;
    b[0] = 208;
    b[1] = 128;
    assert first_cyrillic_line(&b, 2) == 1;
    b[0] = 211;
    b[1] = 191;
    assert first_cyrillic_line(&b, 2) == 1;
    b[0] = 210;
    b[1] = 160;
    assert first_cyrillic_line(&b, 2) == 1;
}

test negative_control_neighbours_of_the_block_are_allowed {
    var b : [3]u8 = undefined;
    b[2] = 'x';
    b[0] = 212;
    b[1] = 128;
    assert first_cyrillic_line(&b, 3) == 0;
    b[0] = 207;
    b[1] = 191;
    assert first_cyrillic_line(&b, 3) == 0;
    b[0] = 207;
    b[1] = 134;
    assert first_cyrillic_line(&b, 3) == 0;
    b[0] = 194;
    b[1] = 178;
    assert first_cyrillic_line(&b, 3) == 0;
    b[0] = 208;
    b[1] = 65;
    assert first_cyrillic_line(&b, 3) == 0;
    b[0] = 208;
    b[1] = 192;
    assert first_cyrillic_line(&b, 3) == 0;
    b[0] = 208;
    b[1] = 127;
    assert first_cyrillic_line(&b, 3) == 0;
}

test negative_control_em_dash_is_allowed {
    var b : [3]u8 = undefined;
    b[0] = 226;
    b[1] = 128;
    b[2] = 148;
    assert first_cyrillic_line(&b, 3) == 0;
}

test only_the_first_n_bytes_are_read {
    var b : [2]u8 = undefined;
    b[0] = 208;
    b[1] = 128;
    assert first_cyrillic_line(&b, 1) == 0;
    assert first_cyrillic_line(&b, 0) == 0;
}
