# Required Contexts Ledger
# 
# This file declares the contexts that can block a merge on the master branch.
# The ledger is regenerated from `gh api repos/gHashTag/t27/rules/branches/master`
# when the ruleset changes.
#
# Current required contexts (2026-10-05): validate, check-linked-issue, parse-ratchet

pub const REQUIRED_CONTEXTS : [3]str = ["validate", "check-linked-issue", "parse-ratchet"];

/// Test whether a context name is required for merges
/// Returns true for required contexts, false for optional/unrequired contexts
pub fn is_required_context(name: str) -> bool {
    // Required contexts that can block a merge
    if name == "validate" {
        return true;
    }
    if name == "check-linked-issue" {
        return true;
    }
    if name == "parse-ratchet" {
        return true;
    }
    
    // Previously required but no longer required contexts
    if name == "check" {
        return false;
    }
    if name == "check-now-freshness" {
        return false;
    }
    
    // Any other context is not required
    return false;
}

// Tests for is_required_context function
test "validate is required" {
    assert is_required_context("validate") == true;
}

test "check-linked-issue is required" {
    assert is_required_context("check-linked-issue") == true;
}

test "parse-ratchet is required" {
    assert is_required_context("parse-ratchet") == true;
}

test "check is not required" {
    assert is_required_context("check") == false;
}

test "check-now-freshness is not required" {
    assert is_required_context("check-now-freshness") == false;
}

test "unknown context is not required" {
    assert is_required_context("unknown-context") == false;
}