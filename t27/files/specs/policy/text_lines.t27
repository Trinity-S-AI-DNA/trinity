// SPDX-License-Identifier: Apache-2.0
; specs/policy/text_lines.t27 -- where a line of a byte buffer ends, written once.
; The CI change selector (specs/ci/affected.t27) and the L2 GENERATION rule (specs/policy/l2_generation.t27)
; both read newline-separated input and both had these two bodies, byte for byte (tools/dupe_scan.py, #7113).
; They import this module instead, so a fix to line handling is made in one place.
; --
; - A line ends at its '\n', or at n when the buffer has no more newlines.
; - Its text ends one byte earlier when that byte is a '\r', so a CRLF file reads as an LF one. Only one
;   '\r' is dropped, and only when the line is not empty.
; phi^2 + 1/phi^2 = 3 | TRINITY

module PolicyTextLines;

/// End of the line that starts at s (the index of its '\n', or n).
pub fn line_end(buf: []const u8, s: usize, n: usize) -> usize {
    var e : usize = s;
    while (e < n and buf[e] != '\n') { e += 1; }
    return e;
}

/// End of the line's text: e with one trailing '\r' dropped.
pub fn text_end(buf: []const u8, s: usize, e: usize) -> usize {
    if (e > s and buf[e - 1] == '\r') { return e - 1; }
    return e;
}

// The bytes are set by number: t27c does not read "\r" in a string literal as an escape (gen-zig
// emits a backslash and an r), so a CRLF literal would test the wrong input.
test a_line_ends_at_its_newline_or_the_end {
    var b : [6]u8 = undefined;
    b[0] = 'a';
    b[1] = 'b';
    b[2] = 10;
    b[3] = 10;
    b[4] = 'c';
    b[5] = 'd';
    assert line_end(&b, 0, 6) == 2;
    assert line_end(&b, 2, 6) == 2;
    assert line_end(&b, 3, 6) == 3;
    assert line_end(&b, 4, 6) == 6;
    assert line_end(&b, 6, 6) == 6;
    assert line_end(&b, 0, 1) == 1;
}

test one_carriage_return_is_dropped_and_only_from_a_nonempty_line {
    var b : [5]u8 = undefined;
    b[0] = 'a';
    b[1] = 13;
    b[2] = 13;
    b[3] = 10;
    b[4] = 13;
    assert text_end(&b, 0, 3) == 2;
    assert text_end(&b, 0, 2) == 1;
    assert text_end(&b, 0, 1) == 1;
    assert text_end(&b, 4, 5) == 4;
    assert text_end(&b, 5, 5) == 5;
    assert text_end(&b, 2, 2) == 2;
    assert text_end(&b, 0, 0) == 0;
}
