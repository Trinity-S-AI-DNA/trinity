// SPDX-License-Identifier: Apache-2.0
; specs/policy/merge_ours.t27 -- detects when a merge takes "ours" and discards work from parent 2
; Implements the discriminator for gHashTag/t27#6016 to catch silent work loss in merges.
; --
; This spec implements the structural discriminator that flags when a merge commit resolves
; a file by taking parent 1's version ("ours") when parent 2 had changed it since the
; merge base, causing work loss. The logic is based on the mechanism described in #6016:
; 
; For each merge M with parents P1, P2:
;   base = merge-base(P1, P2)
;   for each file F that P2 changed since base:
;     if blob(M:F) == blob(P1:F) and blob(P2:F) != blob(P1:F):
;         # M resolved F by taking ours and discarding theirs
; 
; The discriminator needs no size threshold -- it reports the exact shape of the problem.
; --

module PolicyMergeOurs;

/// Discriminator: did the merge take "ours" and discard parent 2's changes?
/// Returns true when:
/// - p2_changed_since_base: parent 2 changed the file since the merge base
/// - merge_equals_p1: the merge result is byte-identical to parent 1
/// - p2_equals_p1: parent 2 differs from parent 1 (work was actually lost)
pub fn resolved_ours(p2_changed_since_base: bool, merge_equals_p1: bool, p2_equals_p1: bool) -> bool {
    return p2_changed_since_base and merge_equals_p1 and !p2_equals_p1;
}

/// Should a merge that took "ours" require a reason in the commit message?
/// Returns true when a code file was resolved ours and the merge message gives no explanation.
pub fn needs_reason(resolved_ours: bool, is_code_file: bool, message_gives_reason: bool) -> bool {
    return resolved_ours and is_code_file and !message_gives_reason;
}

// Test cases for the merge loss discriminator

// fc4f468f3 control case: TernaryFPGABoot.lean merge that took ours and lost 649 lines
test fc4f468f3_ternary_fpga_boot_merge_loss {
    // fc4f468f3 took parent 1's version (2128 lines) when parent 2 had 2777 lines
    let p2_changed_since_base = true;  // parent 2 changed the file since merge base
    let merge_equals_p1 = true;       // merge result == parent 1 (ours)
    let p2_equals_p1 = false;         // parent 2 != parent 1 (work was lost)
    let should_flag = resolved_ours(p2_changed_since_base, merge_equals_p1, p2_equals_p1);
    assert should_flag == true;
}

// Ordinary divergence: file parent 2 never touched (should not be flagged)
test ordinary_divergence_not_flagged {
    // File that parent 2 never changed since merge base
    let p2_changed_since_base = false; // parent 2 did NOT change the file
    let merge_equals_p1 = true;       // merge result == parent 1 (ordinary case)
    let p2_equals_p1 = false;         // parent 2 != parent 1 (but this is expected divergence)
    let should_flag = resolved_ours(p2_changed_since_base, merge_equals_p1, p2_equals_p1);
    assert should_flag == false;
}

// Merge that took parent 2's side (should not be flagged)
test merge_takes_parent2_not_flagged {
    // Merge that correctly took parent 2's version
    let p2_changed_since_base = true;  // parent 2 changed the file
    let merge_equals_p1 = false;      // merge result != parent 1 (took parent 2)
    let p2_equals_p1 = false;         // parent 2 != parent 1
    let should_flag = resolved_ours(p2_changed_since_base, merge_equals_p1, p2_equals_p1);
    assert should_flag == false;
}

// Merge message gives reason (should not need reason even if ours was taken)
test merge_with_reason_does_not_need_reason {
    // Code file where ours was taken but message explains why
    let resolved_ours_flag = true;      // merge took ours
    let is_code_file = true;           // it's a code file
    let message_gives_reason = true;    // commit message explains the reason
    let requires_reason = needs_reason(resolved_ours_flag, is_code_file, message_gives_reason);
    assert requires_reason == false;
}

// Non-code file (should not need reason even if ours was taken)
test non_code_file_does_not_need_reason {
    // Documentation file where ours was taken (no reason needed for non-code)
    let resolved_ours_flag = true;      // merge took ours
    let is_code_file = false;          // it's NOT a code file (e.g., docs)
    let message_gives_reason = false;  // no reason in message
    let requires_reason = needs_reason(resolved_ours_flag, is_code_file, message_gives_reason);
    assert requires_reason == false;
}

// Code file without reason (should require reason)
test code_file_without_reason_requires_reason {
    // Code file where ours was taken and no reason given
    let resolved_ours_flag = true;      // merge took ours
    let is_code_file = true;           // it's a code file
    let message_gives_reason = false;   // no reason in message
    let requires_reason = needs_reason(resolved_ours_flag, is_code_file, message_gives_reason);
    assert requires_reason == true;
}

// Edge case: parent 2 equals parent 1 (no work lost, should not be flagged)
test p2_equals_p1_no_work_lost {
    // Parent 2 changed file but it's identical to parent 1 (no actual loss)
    let p2_changed_since_base = true;  // parent 2 changed the file
    let merge_equals_p1 = true;       // merge result == parent 1
    let p2_equals_p1 = true;          // parent 2 == parent 1 (no work lost)
    let should_flag = resolved_ours(p2_changed_since_base, merge_equals_p1, p2_equals_p1);
    assert should_flag == false;
}