// SPDX-License-Identifier: Apache-2.0
// specs/numeric/catalog_paper_count.t27
// Paper Count Catalog — Tracks paper version counts and divergence warnings
// NUMERIC-STANDARD-002 — Paper count ratchet for catalog divergence detection

module CatalogPaperCount {
    use base::types;

    // ----------------------------------------------------------------------
    // Paper Version Constants
    // ----------------------------------------------------------------------

    // Live paper version (arXiv:2606.09686v3, announced 2026-09-07)
    const PAPER_LIVE_VERSION: u8 = 3;

    // Paper counts by version (arXiv:2606.09686)
    // v1: 84 (withdrawn)
    // v2: 83 (corrected, 2026-06-22) 
    // v3: 109 (current, announced 2026-09-07)
    const PAPER_COUNT_V1: u32 = 84;
    const PAPER_COUNT_V2: u32 = 83;
    const PAPER_COUNT_V3: u32 = 109;

    // ----------------------------------------------------------------------
    // Paper Count Functions
    // ----------------------------------------------------------------------

    // paper_count(version: u8) -> u32
    // Returns the paper count for the specified version
    // Returns 0 for unknown versions
    pub fn paper_count(version: u8) -> u32 {
        if version == 1 {
            return PAPER_COUNT_V1;
        } else if version == 2 {
            return PAPER_COUNT_V2;
        } else if version == 3 {
            return PAPER_COUNT_V3;
        } else {
            return 0; // Unknown version
        }
    }

    // paper_divergence_warns(n_ssot: u32, paper: u32) -> bool
    // Returns true only when n_ssot < paper (paper count is a floor the catalog may exceed)
    // The catalog may grow beyond the paper count without warning, but shrinking
    // below the paper count indicates a problem requiring investigation.
    pub fn paper_divergence_warns(n_ssot: u32, paper: u32) -> bool {
        return n_ssot < paper;
    }

    // ----------------------------------------------------------------------
    // Tests
    // ----------------------------------------------------------------------

    // Test paper_count function for all known versions
    test paper_count_v1 {
        assert(paper_count(1) == 84, "Version 1 paper count should be 84");
    }

    test paper_count_v2 {
        assert(paper_count(2) == 83, "Version 2 paper count should be 83");
    }

    test paper_count_v3 {
        assert(paper_count(3) == 109, "Version 3 paper count should be 109");
    }

    test paper_count_unknown {
        assert(paper_count(0) == 0, "Unknown version should return 0");
        assert(paper_count(4) == 0, "Unknown version should return 0");
    }

    // Test paper_divergence_warns function - should only warn when SSOT is below paper count
    test divergence_warn_equal {
        assert(!paper_divergence_warns(109, 109), "Equal counts should not warn");
        assert(!paper_divergence_warns(83, 83), "Equal counts should not warn");
    }

    test divergence_warn_above {
        assert(!paper_divergence_warns(110, 109), "SSOT above paper count should not warn");
        assert(!paper_divergence_warns(84, 83), "SSOT above paper count should not warn");
    }

    test divergence_warn_below {
        assert(paper_divergence_warns(108, 109), "SSOT below paper count should warn");
        assert(paper_divergence_warns(82, 83), "SSOT below paper count should warn");
        assert(paper_divergence_warns(1, 109), "SSOT far below paper count should warn");
    }

    // Test live version constant
    test live_version {
        assert(PAPER_LIVE_VERSION == 3, "Live paper version should be v3");
        assert(paper_count(PAPER_LIVE_VERSION) == 109, "Live version count should be 109");
    }
}