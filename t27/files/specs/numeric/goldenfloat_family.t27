            sign_bits = 1,
            exp_bits = 5,
            mant_bits = 8,
            exp_mant_ratio = 0.625,
            phi_distance = abs(0.625 - PHI_RATIO_TARGET),
            is_primary = false,
        },
        GoldenFloatFormat{
            name = "GF16",
            bits = 16,
            sign_bits = 1,
            exp_bits = 6,
            mant_bits = 9,
            exp_mant_ratio = 0.6666666666666667,
            phi_distance = abs(0.6666666666666667 - PHI_RATIO_TARGET),
            is_primary = true,  // PRIMARY FORMAT
        },
        GoldenFloatFormat{
