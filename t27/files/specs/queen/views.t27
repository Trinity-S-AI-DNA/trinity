; --- Identity -------------------------------------------------------------------------------------
; Five things a view names, each by the whole of its identity and nothing less.
pub const IDENTITIES : [5]str = [
    "repository: owner/name, lowercased, as GitHub's full_name; a bare name (t27, tri-net) is a display label of gHashTag/<name>, never an identity",
    "source: repository plus the full path from that repository's root; the site's mirror prefixes a path with <name>/ or <owner>/<name>/, and that prefix is part of the mirror path, not of the source",
    "spec: the sha256 of the exact bytes; one spec may have several sources, and is counted once however many sources or map placements it has",
    "revision: a full 40-hex commit of the source's repository; a branch name or a date is a pointer to a revision, not one",
    "issue: repository#number; a number without its repository names nothing"
];
; How two things may have been matched. Only EXACT and HASH are identity. Every other kind finds a candidate:
; it may be listed, counted and opened as a candidate, labelled unverified, and it is never taken for the thing
; itself -- it joins no data of one thing into another, colours, counts or links nothing as that thing, and
; marks nothing done.
pub const ID_EXACT : u32 = 0;
pub const ID_HASH : u32 = 1;
pub const ID_BASENAME : u32 = 2;
pub const ID_SUFFIX : u32 = 3;
pub const ID_CASE_FOLDED : u32 = 4;
pub const ID_LEXICAL : u32 = 5;
pub const ID_NUMBER_ONLY : u32 = 6;
pub const REL_SAME : u32 = 0;
pub const REL_CANDIDATE : u32 = 1;

; --- An address that names a spec ------------------------------------------------------------------
pub const R_RESOLVED : u32 = 0;
pub const R_INVALID : u32 = 1;
pub const R_MISSING : u32 = 2;
pub const R_AMBIGUOUS : u32 = 3;
pub const R_HASH_MISMATCH : u32 = 4;
; What the view shows: the featured spec (only for an address that names none), the named spec, an explicit
; unavailable state, or nothing new (an answer to an earlier request is dropped). There is no fifth outcome:
; an explicit address never shows another spec, neither the featured one nor the one already open.
pub const V_FEATURED : u32 = 0;
pub const V_SPEC : u32 = 1;
pub const V_UNAVAILABLE : u32 = 2;
pub const V_UNCHANGED : u32 = 3;
pub const V_OTHER_SPEC : u32 = 4;
pub const RESOLUTION_RULE : str = "an address names a spec by its full mirror path and may pin its bytes by sha256; it resolves only to the one manifest entry with exactly that path, the bytes are verified against the pinned hash when the address carries one and against the catalog's own hash when the manifest carries one, and every other outcome is shown as unavailable with its reason; the address is never rewritten to drop the hash it was given";

; --- Five kinds of evidence, kept apart ------------------------------------------------------------
pub const AXIS_AVAILABILITY : u32 = 0;
pub const AXIS_GENERATION : u32 = 1;
pub const AXIS_COVERAGE : u32 = 2;
pub const AXIS_RUNTIME : u32 = 3;
pub const AXIS_LIFECYCLE : u32 = 4;
pub const AXES : [5]str = [
    "availability: the bytes are in the catalog at a pinned revision (a gold spec cell says this and nothing more)",
    "generation: a named compiler at a named revision generated a named artifact from those bytes; parse and typecheck are inputs to it, not it",
    "coverage: a consumer revision's acceptance tests pass against that artifact; a path, symbol or word match is never coverage",
    "runtime: an invocation of the running system with its recorded result",
    "lifecycle: the issue's state and reason on GitHub at an observed time"
];
; What may make a view call an issue done. Only an issue closed as completed with independently verified
; acceptance; a closed issue is closed, an issue closed as not planned is neither progress nor done.
pub const DONE_FROM_GOLD_CELL : u32 = 0;
pub const DONE_FROM_TYPECHECK : u32 = 1;
pub const DONE_FROM_CATALOG : u32 = 2;
pub const DONE_FROM_MATCH : u32 = 3;
pub const DONE_FROM_SNAPSHOT : u32 = 4;
pub const DONE_FROM_NOT_PLANNED : u32 = 5;
pub const DONE_FROM_COMPLETED : u32 = 6;
pub const DONE_FROM_ACCEPTED : u32 = 7;

