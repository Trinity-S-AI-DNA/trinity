; --- Decisions -----------------------------------------------------------------------------------

/// Whether a kind of match is identity.
pub fn is_identity(kind: u32) -> bool {
    return kind == ID_EXACT or kind == ID_HASH;
}

/// The relation a match may claim: the same thing, or an unverified candidate.
pub fn relation_of(kind: u32) -> u32 {
    if (is_identity(kind)) { return REL_SAME; }
    return REL_CANDIDATE;
}

/// Whether a match of this kind may link, colour, count, navigate or mark done.
pub fn may_bind(kind: u32) -> bool {
    return relation_of(kind) == REL_SAME;
}

/// A live row belongs to a cell only when both its repository and its number are the cell's.
pub fn row_joins_cell(same_repository: bool, same_number: bool) -> bool {
    return same_repository and same_number;
}

/// The resolution of an explicit address: the grammar first, then exactly one entry, then the bytes.
pub fn resolve_address(grammar_ok: bool, exact_matches: u32, hash_given: bool, hash_equal: bool) -> u32 {
    if (grammar_ok == false) { return R_INVALID; }
    if (exact_matches == 0) { return R_MISSING; }
    if (exact_matches > 1) { return R_AMBIGUOUS; }
    if (hash_given and hash_equal == false) { return R_HASH_MISMATCH; }
    return R_RESOLVED;
}

/// An answer is applied only if no request was made after it.
pub fn accept_answer(request: u32, latest: u32) -> bool {
    return request == latest;
}

/// What the view shows for an address, given whether it names a spec and how it (or, for an address that
/// names none, the featured spec) resolved.
pub fn view_of_address(named: bool, resolution: u32, answer_current: bool) -> u32 {
    if (answer_current == false) { return V_UNCHANGED; }
    if (resolution != R_RESOLVED) { return V_UNAVAILABLE; }
    if (named == false) { return V_FEATURED; }
    return V_SPEC;
}

/// No evidence axis implies another.
pub fn axis_implies(from: u32, to: u32) -> bool {
    return from == to;
}

/// Whether this source of belief may make a view call an issue done.
pub fn marks_done(source: u32) -> bool {
    return source == DONE_FROM_ACCEPTED;
}

/// Whether a closed child counts toward an epic's progress.
pub fn counts_toward_progress(closed: bool, completed: bool) -> bool {
    return closed and completed;
}

/// Whether an epic stands complete: closed itself, and every one of its children completed.
pub fn epic_complete(epic_closed: bool, children: u32, completed_children: u32) -> bool {
    return epic_closed and children > 0 and completed_children == children;
}

/// How a reading is presented.
pub fn presentation(source: u32, has_data: bool, loading: bool, failed_since_success: bool, online: bool) -> u32 {
    if (has_data == false) {
        if (loading) { return P_LOADING; }
        if (online == false) { return P_OFFLINE; }
        return P_UNAVAILABLE;
    }
    if (source == SRC_SNAPSHOT) { return P_SNAPSHOT; }
    if (online == false) { return P_OFFLINE; }
    if (failed_since_success) { return P_STALE; }
    return P_LIVE;
}

/// Only a change between two live readings may be presented as an event.
pub fn change_is_event(before: u32, after: u32) -> bool {
    return before == P_LIVE and after == P_LIVE;
}

/// Whether a live badge may stand over data from this source.
pub fn live_badge_allowed(source: u32) -> bool {
    return source == SRC_LIVE;
}

/// Seconds since the last success once a request has failed after one; -1 when there is no badge.
pub fn stale_age_s(now_s: i64, last_success_s: i64, has_success: bool, failed: bool) -> i64 {
    if (has_success == false or failed == false) { return -1; }
    return now_s - last_success_s;
}

/// Whether a quantity may be printed as a number: only when it was read.
pub fn shows_number(read: bool) -> bool {
    return read;
}

/// How many distinct ids the first n of eight placements hold.
pub fn distinct_count(ids: [8]u32, n: u32) -> u32 {
    var count : u32 = 0;
    var i : u32 = 0;
    while (i < n) {
        var seen : bool = false;
        var j : u32 = 0;
        while (j < i) {
            if (ids[j] == ids[i]) { seen = true; }
            j = j + 1;
        }
        if (seen == false) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

/// Whether motion may play.
pub fn motion_allowed(reduced: bool) -> bool {
    return reduced == false;
}

