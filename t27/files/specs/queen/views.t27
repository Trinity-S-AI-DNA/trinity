    "f83 apps/queen builds (Swift 6.4, 0 errors, 52 warnings) and its 60 tests in 10 suites pass at the pin; none of its 204 sources reads the catalog, the atlas, GitHub or a public Queen endpoint, so it has no project view to hold to this contract, and no workflow builds it [native]",
    "f84 specs/docs/system.t27 and its chapters cannot gain a constant without the site's generator changing with them: scripts/agents-from-specs.mjs:442 refuses an unknown constant; specs/ui/queen_evidence.t27 lived only in the site's mirror, outside its manifest, and is now here byte for byte; a one-element string array generates a comment instead of a C initialiser [data; spec]",
    "f85 Counting conforms: the mirror is gHashTag/t27 at the revision the manifest names, 1100 files identical and 9 unreachable ones named as such; the same bytes in two repositories are one spec with two sources; displayed totals count distinct ids (atlas.specs.length), and the per-world counts of one spec in two worlds sum to two only where nothing adds them [ts; data]",
    "f86 No issue cell can be honey: honey needs coverage 't27' and every row is built with coverage 'unknown' (queenHiveDisplay.ts:13, :37); a gold cell on the catalog map is a spec, and the map says so ('gold = spec, not a resolved issue'); the DONE tile counts the board's done column, which S09 measured to hold a closed issue whatever its verdict (f54) [ts; browser; source]"
];

; --- Tests ---------------------------------------------------------------------------------------------

test only_exact_and_hash_are_identity {
    assert is_identity(ID_EXACT);
    assert is_identity(ID_HASH);
    assert is_identity(ID_BASENAME) == false;
    assert is_identity(ID_SUFFIX) == false;
    assert is_identity(ID_LEXICAL) == false;
    assert is_identity(ID_NUMBER_ONLY) == false;
    assert relation_of(ID_SUFFIX) == REL_CANDIDATE;
    assert may_bind(ID_NUMBER_ONLY) == false;
    // #7077: and an identity does bind
    assert relation_of(ID_EXACT) == REL_SAME;
    assert may_bind(ID_HASH);
}

test a_row_of_another_repository_never_joins {
    assert row_joins_cell(true, true);
    assert row_joins_cell(false, true) == false;
    assert row_joins_cell(true, false) == false;
}

test an_explicit_address_never_shows_another_spec {
    assert resolve_address(true, 1, false, false) == R_RESOLVED;
    assert resolve_address(false, 1, false, false) == R_INVALID;
    assert resolve_address(true, 0, false, false) == R_MISSING;
    assert resolve_address(true, 2, false, false) == R_AMBIGUOUS;
    assert resolve_address(true, 1, true, false) == R_HASH_MISMATCH;
    assert resolve_address(true, 1, true, true) == R_RESOLVED;
    assert view_of_address(true, R_MISSING, true) == V_UNAVAILABLE;
    assert view_of_address(true, R_HASH_MISMATCH, true) == V_UNAVAILABLE;
    assert view_of_address(false, R_RESOLVED, true) == V_FEATURED;
    assert view_of_address(false, R_MISSING, true) == V_UNAVAILABLE;
    assert view_of_address(true, R_RESOLVED, false) == V_UNCHANGED;
    assert accept_answer(3, 4) == false;
    assert accept_answer(4, 4);
}

test nothing_but_accepted_marks_done {
    assert marks_done(DONE_FROM_ACCEPTED);
    assert marks_done(DONE_FROM_GOLD_CELL) == false;
    assert marks_done(DONE_FROM_TYPECHECK) == false;
    assert marks_done(DONE_FROM_COMPLETED) == false;
    assert marks_done(DONE_FROM_NOT_PLANNED) == false;
    assert counts_toward_progress(true, false) == false;
    assert counts_toward_progress(true, true);
    assert epic_complete(true, 4, 3) == false;
    assert epic_complete(true, 4, 4);
    assert epic_complete(true, 0, 0) == false;
    assert axis_implies(AXIS_GENERATION, AXIS_COVERAGE) == false;
    assert axis_implies(AXIS_LIFECYCLE, AXIS_LIFECYCLE);
}

test a_snapshot_is_never_live {
    assert presentation(SRC_SNAPSHOT, true, false, false, true) == P_SNAPSHOT;
    assert presentation(SRC_LIVE, true, false, false, true) == P_LIVE;
    assert presentation(SRC_LIVE, true, false, true, true) == P_STALE;
    assert presentation(SRC_LIVE, true, false, false, false) == P_OFFLINE;
    assert presentation(SRC_LIVE, false, true, false, true) == P_LOADING;
    assert presentation(SRC_LIVE, false, false, true, true) == P_UNAVAILABLE;
    // #7077: the true side of every rule below, not only the false one
    assert presentation(SRC_LIVE, false, false, false, false) == P_OFFLINE;
    assert change_is_event(P_SNAPSHOT, P_SNAPSHOT) == false;
    assert change_is_event(P_LIVE, P_LIVE);
    assert change_is_event(P_STALE, P_LIVE) == false;
    assert live_badge_allowed(SRC_SNAPSHOT) == false;
    assert live_badge_allowed(SRC_LIVE);
    assert stale_age_s(42, 0, true, true) == 42;
    assert stale_age_s(100, 58, true, true) == 42;
    assert stale_age_s(42, 0, true, false) == -1;
    assert stale_age_s(42, 0, false, true) == -1;
    assert shows_number(false) == false;
    assert shows_number(true);
}

test a_spec_in_three_placements_counts_once {
    var ids : [8]u32 = [7, 7, 9, 7, 3, 0, 0, 0];
    assert distinct_count(ids, 5) == 3;
    assert distinct_count(ids, 2) == 1;
    assert distinct_count(ids, 0) == 0;
}

test reduced_motion_stops_motion {
    assert motion_allowed(true) == false;
    assert motion_allowed(false);
}

; --- Invariants ----------------------------------------------------------------------------------------

invariant identity_codes_are_distinct {
    assert ID_EXACT < ID_HASH;
    assert ID_HASH < ID_BASENAME;
    assert ID_LEXICAL < ID_NUMBER_ONLY;
}

invariant the_measured_counts_hold_together {
    assert MANIFEST_ENTRIES_WITH_SHA256 <= MANIFEST_ENTRIES;
    assert ATLAS_ISSUES_CLOSED_SINCE < ATLAS_ISSUES;
    assert SITE_GATES_RUN_BY_CI < SITE_GATES;
}
