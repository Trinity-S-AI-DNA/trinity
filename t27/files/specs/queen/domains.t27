// SPDX-License-Identifier: Apache-2.0
; specs/queen/domains.t27 -- which agent domain a task belongs to, read from its boundary paths
; specs/queen/control.t27 section 5 places a task on a runtime of its own domain when one is idle (a
; domain is an affinity, not a cap: owner, 2026-10-08, #7674). This file answers the question that
; placement needs first: what is this task's domain?
; It is kept apart from control.t27 because the supervisor (gHashTag/BrowserOS trios/agent-server)
; reads control.t27 at run time through a vendored compiler wasm, and that typechecker refuses the
; byte walks below. A card the supervisor refuses stops every dispatch, so the walks live here. The
; supervisor imports these constants from `t27c gen-js` of this file and mirrors the two functions
; line for line.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueenDomains;

/// Domain codes. They are mirrored by number from control.t27 section 5 (DOMAIN_T27C ...
/// DOMAIN_QUEEN_OPS, index = DOMAINS there), so a code never moves.
pub const DOMAIN_T27C : u8 = 0;
pub const DOMAIN_T27B : u8 = 1;
pub const DOMAIN_SPECS : u8 = 2;
pub const DOMAIN_QUEEN_OPS : u8 = 3;

/// The path prefixes of each domain. Each list is comma-separated and ends in '$', and is walked byte
/// by byte as in specs/policy/own_language.t27. The order of the checks in domain_of_path matters: the
/// C backend's sources sit under bootstrap/, which is otherwise the compiler's.
pub const PREFIXES_T27C : str = "gen/c/,specs/isa/,specs/asm/,bootstrap/src/codegen_c,$";
pub const PREFIXES_T27B : str = "cli/t27b/,specs/tri/t27b/,bootstrap/,$";
pub const PREFIXES_QUEEN_OPS : str = "specs/queen/,tools/queen/,tools/bees/,trios/,docs/coordination/,$";

/// '$' and ',' as numbers: a char literal is not a const initializer in every backend.
pub const LIST_END : u8 = 36;
pub const LIST_SEP : u8 = 44;

/// Does path[0..len] start with one entry of `list`?
pub fn starts_with_one_of(list: []const u8, path: []const u8, len: usize) -> bool {
    var i : usize = 0;
    while (list[i] != LIST_END) {
        var k : usize = 0;
        var ok : bool = true;
        while (list[i] != LIST_SEP and list[i] != LIST_END) {
            if (k >= len) {
                ok = false;
            } else {
                if (path[k] != list[i]) { ok = false; }
            }
            k += 1;
            i += 1;
        }
        if (ok) { return true; }
        if (list[i] == LIST_SEP) { i += 1; }
    }
    return false;
}

/// The domain of one path. A task's domain is the domain of the first path its boundary declares. A
/// path no prefix names is spec work: most of the corpus is.
pub fn domain_of_path(path: []const u8, len: usize) -> u8 {
    if (starts_with_one_of(PREFIXES_T27C, path, len)) { return DOMAIN_T27C; }
    if (starts_with_one_of(PREFIXES_T27B, path, len)) { return DOMAIN_T27B; }
    if (starts_with_one_of(PREFIXES_QUEEN_OPS, path, len)) { return DOMAIN_QUEEN_OPS; }
    return DOMAIN_SPECS;
}

test a_task_takes_the_domain_of_its_first_path {
    assert domain_of_path("gen/c/queen/review_valve.c", 26) == DOMAIN_T27C;
    assert domain_of_path("bootstrap/src/codegen_c.rs", 26) == DOMAIN_T27C;
    assert domain_of_path("bootstrap/src/compiler.rs", 25) == DOMAIN_T27B;
    assert domain_of_path("cli/t27b/src/lower.rs", 21) == DOMAIN_T27B;
    assert domain_of_path("specs/tri/t27b/lencall.t27", 26) == DOMAIN_T27B;
    assert domain_of_path("specs/queen/control.t27", 23) == DOMAIN_QUEEN_OPS;
    assert domain_of_path("tools/queen/publish.py", 22) == DOMAIN_QUEEN_OPS;
    assert domain_of_path("specs/tri/sort/quick_sort.t27", 29) == DOMAIN_SPECS;
    assert domain_of_path("docs/now/x.md", 13) == DOMAIN_SPECS;
}

test a_prefix_must_fit_inside_the_path {
    // a prefix longer than the path does not match
    assert domain_of_path("gen/c", 5) == DOMAIN_SPECS;
    // the length bounds the match: only "specs/q" is read
    assert domain_of_path("specs/queen/control.t27", 7) == DOMAIN_SPECS;
    assert starts_with_one_of(PREFIXES_T27B, "bootstrap/", 10) == true;
    assert starts_with_one_of(PREFIXES_T27B, "bootstrap", 9) == false;
}

// The supervisor mirrors the codes by number, as control.t27 section 5 numbers them.
invariant the_domain_codes_never_move {
    assert DOMAIN_T27C == 0;
    assert DOMAIN_T27B == 1;
    assert DOMAIN_SPECS == 2;
    assert DOMAIN_QUEEN_OPS == 3;
}
