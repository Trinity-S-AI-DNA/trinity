// queen/task_analysis.t27 — Task Priority Analysis for Queen
// Trinity S³AI — Cognitive Task Orchestration
// φ² + 1/φ² = 3 | TRINITY

; S09 of gHashTag/trinity#988 (gHashTag/t27#4828), 2026-10-01. Until today this file sorted by returning
; its input (`sort_tasks_by_priority` was `return tasks;`), picked the next task without reading either of
; its arguments, counted 27 workers because there are 27 agent letters, and did not compile in C (it
; imported BrainState across modules, which the C backend cannot resolve). It now compiles, orders by the
; score it always defined, and is tested on deliberately unsorted input, where returning the input fails.
; WHAT IT IS NOT: the order the Queen works in. The running supervisor takes the first eligible issue in
; GitHub's listing order and ranks nothing (specs/queen/dispatch.t27, PRIORITY_RULE, measured on 120
; orders); no runtime calls these functions. They are the priority a scheduler WOULD apply, stated so it
; can be checked, not a description of one.

module queen-task-analysis;

// ============================================================================
// SACRED CONSTANTS
// ============================================================================

pub const PHI : f64 = 1.618033988749895;
pub const PHI_INV : f64 = 0.618033988749895;
pub const TRINITY : f64 = 3.0;

/// The agent alphabet of AGENTS.md: 27 documentation roles. Not workers: a worker is a model turn on a
/// provider key, and how many run is bounded by keys, lanes and TRIOS_QUEEN_MAX_WORKERS (default 4).
pub const AGENT_LETTER_COUNT : u8 = 27;

/// Task priority levels
pub const PRIORITY_CRITICAL : u8 = 0;
pub const PRIORITY_HIGH : u8 = 1;
pub const PRIORITY_NORMAL : u8 = 2;
pub const PRIORITY_LOW : u8 = 3;

/// The functions below order a queue of at most this many tasks, passed as parallel arrays.
pub const QUEUE_SLOTS : u32 = 4;

// ============================================================================
// FUNCTIONS: Task Analysis
// ============================================================================

/// The priority score: PHI * urgency + PHI_INV * (1 - priority / 4). Higher is more urgent.
pub fn priority_score(priority: u8, urgency: f64) -> f64 {
    var normalized : f64 = 1.0 - (priority as f64) / 4.0;
    return PHI * urgency + PHI_INV * normalized;
}

/// Whether task a comes before task b: higher score first, then the older one, then the lower index.
pub fn outranks(score_a: f64, created_a: u64, index_a: u32, score_b: f64, created_b: u64, index_b: u32) -> bool {
    if (score_a > score_b) { return true; }
    if (score_a < score_b) { return false; }
    if (created_a < created_b) { return true; }
    if (created_a > created_b) { return false; }
    return index_a < index_b;
}

/// The position task i takes in the order: how many of the first n tasks outrank it.
pub fn priority_rank(scores: [4]f64, created: [4]u64, n: u32, i: u32) -> u32 {
    var rank : u32 = 0;
    var j : u32 = 0;
    while (j < n) {
        if (j != i) {
            if (outranks(scores[j], created[j], j, scores[i], created[i], i)) {
                rank = rank + 1;
            }
        }
        j = j + 1;
    }
    return rank;
}

/// The index of the task at a position of the order, or QUEUE_SLOTS when the position is past the queue.
/// Replaces `sort_tasks_by_priority`, which returned its input.
pub fn priority_order_at(scores: [4]f64, created: [4]u64, n: u32, position: u32) -> u32 {
    var i : u32 = 0;
    while (i < n) {
        if (priority_rank(scores, created, n, i) == position) {
            return i;
        }
        i = i + 1;
    }
    return QUEUE_SLOTS;
}

/// How many of the first n priorities are critical.
pub fn critical_count(priorities: [4]u8, n: u32) -> u32 {
    var count : u32 = 0;
    var i : u32 = 0;
    while (i < n) {
        if (priorities[i] == PRIORITY_CRITICAL) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

// ============================================================================
// TDD: TESTS
// ============================================================================

test priority_score_bounds {
    var low : f64 = priority_score(PRIORITY_LOW, 0.0);
    var top : f64 = priority_score(PRIORITY_CRITICAL, 1.0);
    assert low >= 0.0;
    assert top <= 2.3;
    assert top > low;
    // #7077: at one urgency the more urgent priority scores higher
    assert priority_score(PRIORITY_CRITICAL, 0.0) > priority_score(PRIORITY_LOW, 0.0);
}

test an_unsorted_queue_is_put_in_order {
    // scores 0.5, 2.0, 1.0, 1.5 at indices 0..3: the order is 1, 3, 2, 0 -- returning the input gives 0, 1, 2, 3
    var scores : [4]f64 = [0.5, 2.0, 1.0, 1.5];
    var created : [4]u64 = [10, 20, 30, 40];
    assert priority_order_at(scores, created, 4, 0) == 1;
    assert priority_order_at(scores, created, 4, 1) == 3;
    assert priority_order_at(scores, created, 4, 2) == 2;
    assert priority_order_at(scores, created, 4, 3) == 0;
    assert priority_order_at(scores, created, 4, 4) == QUEUE_SLOTS;
}

test ties_go_to_the_older_task_then_the_lower_index {
    var scores : [4]f64 = [1.0, 1.0, 1.0, 0.0];
    var created : [4]u64 = [30, 10, 10, 5];
    assert priority_order_at(scores, created, 4, 0) == 1;
    assert priority_order_at(scores, created, 4, 1) == 2;
    assert priority_order_at(scores, created, 4, 2) == 0;
    assert priority_order_at(scores, created, 4, 3) == 3;
    // #7077: a strict order: no task outranks itself
    assert outranks(1.0, 10, 2, 1.0, 10, 2) == false;
}

test a_short_queue_uses_only_its_first_n {
    var scores : [4]f64 = [0.1, 0.9, 5.0, 5.0];
    var created : [4]u64 = [1, 2, 3, 4];
    assert priority_order_at(scores, created, 2, 0) == 1;
    assert priority_order_at(scores, created, 2, 1) == 0;
    assert priority_order_at(scores, created, 2, 2) == QUEUE_SLOTS;
}

test critical_tasks_are_counted {
    var priorities : [4]u8 = [0, 2, 0, 3];
    assert critical_count(priorities, 4) == 2;
    assert critical_count(priorities, 1) == 1;
}

// ============================================================================
// TDD: INVARIANTS
// ============================================================================

invariant agent_letters_are_twenty_seven {
    assert AGENT_LETTER_COUNT == 27;
}

invariant priority_levels_sequential {
    assert PRIORITY_CRITICAL < PRIORITY_HIGH;
    assert PRIORITY_HIGH < PRIORITY_NORMAL;
    assert PRIORITY_NORMAL < PRIORITY_LOW;
}

// #7077: these were two tests of constants only, which test-report counts as
// vacuous (no runtime assert); a constant is pinned at compile time instead.
// priority_score divides the level by 4 and the queue functions take [4]
// arrays, so the values, not only their order, are part of the contract.
invariant priority_levels_are_zero_to_three {
    assert PRIORITY_CRITICAL == 0;
    assert PRIORITY_HIGH == 1;
    assert PRIORITY_NORMAL == 2;
    assert PRIORITY_LOW == 3;
}

invariant a_queue_holds_four_slots {
    assert QUEUE_SLOTS == 4;
}
