    test "logout_success" {
        var account_id = AccountID("test-account");
        var result = logout(account_id);
        assert(result.is_ok());
        // was: assert(result.unwrap() == ()) -- t27 has no unit value `()`;
        // for a void result the check is that unwrapping it succeeds
        result.unwrap();
    }
}
