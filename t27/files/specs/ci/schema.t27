module CiSchema

pub const TRIGGER_PULL_REQUEST = "pull_request"
pub const TRIGGER_PULL_REQUEST_TARGET = "pull_request_target"
pub const TRIGGER_PUSH = "push"
pub const TRIGGER_SCHEDULE = "schedule"

pub const STAGE_BUILD = "build"
pub const STAGE_TEST = "test"
pub const STAGE_DEPLOY = "deploy"

pub fn required_runs_on_pr(required: bool, on_pr: bool) -> bool {
    if required {
        return on_pr
    }
    return true
}

pub fn trigger_from_string(trigger: str) -> str {
    if trigger == "pull_request" {
        return TRIGGER_PULL_REQUEST
    } else if trigger == "pull_request_target" {
        return TRIGGER_PULL_REQUEST_TARGET
    } else if trigger == "push" {
        return TRIGGER_PUSH
    } else if trigger == "schedule" {
        return TRIGGER_SCHEDULE
    } else {
        return "unknown"
    }
}

test required_runs_on_pr_positive {
    let result = required_runs_on_pr(true, true)
    assert result == true
}

test required_runs_on_pr_negative {
    let result = required_runs_on_pr(true, false)
    assert result == false
}

test required_runs_on_pr_not_required {
    let result = required_runs_on_pr(false, false)
    assert result == true
}

test trigger_from_string_pull_request {
    let result = trigger_from_string("pull_request")
    assert result == TRIGGER_PULL_REQUEST
}

test trigger_from_string_unknown {
    let result = trigger_from_string("unknown")
    assert result == "unknown"
}