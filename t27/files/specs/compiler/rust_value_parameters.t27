// Mutation of by-value arguments stays local to each function call.
module RustValueParameters {
    fn increment(value: u32) -> u32 {
        value = value + 1;
        return value;
    }
    fn clamp_value(value: u32, low: u32, high: u32) -> u32 {
        if (value < low) { value = low; }
        if (value > high) { value = high; }
        return value;
    }
    fn edit_array(values: [u32; 4]) -> u32 {
        values[0] = values[0] + values[3];
        return values[0] + values[1] + values[2] + values[3];
    }
    fn nested_edits(values: [u32; 4], counter: u32) -> u32 {
        for i in 0..4 {
            if (values[i] < counter) { values[i] = counter; }
            counter = counter + 1;
        }
        return values[0] ^ values[1] ^ values[2] ^ values[3];
    }
    fn readonly(value: u32, values: [u32; 4]) -> u32 {
        return value + values[0];
    }
    // Existing reference parameter paths must retain caller-visible writes.
    struct Cell { value: u32, }
    fn write_slice(values: []u32, value: u32) -> u32 {
        values[0] = value;
        return values[0];
    }
    fn read_slice(values: []u32) -> u32 { return values[0]; }
    fn write_cell(cell: *Cell, value: u32) -> u32 {
        cell.value = value;
        return cell.value;
    }
    test scalar_increment { assert(increment(7) == 8, "scalar value argument"); }
    test scalar_clamp_lower { assert(clamp_value(2, 8, 64) == 8, "lower bound"); }
    test scalar_clamp_upper { assert(clamp_value(255, 8, 64) == 64, "upper bound"); }
    test scalar_clamp_middle { assert(clamp_value(32, 8, 64) == 32, "unchanged middle"); }
    test array_edit { let values: [u32; 4] = [1, 2, 3, 4]; assert(edit_array(values) == 14, "array argument"); }
    test nested_array_and_scalar { let values: [u32; 4] = [0, 0, 0, 0]; assert(nested_edits(values, 4) == 0, "nested assignments"); }
    test readonly_control { let values: [u32; 4] = [2, 3, 4, 5]; assert(readonly(7, values) == 9, "readonly arguments"); }
    test scalar_caller_copy {
        let value: u32 = 7;
        let changed: u32 = increment(value);
        assert(changed == 8, "returned scalar changed");
        assert(value == 7, "caller scalar remains unchanged");
    }
    test array_caller_copy {
        let values: [u32; 4] = [1, 2, 3, 4];
        let changed: u32 = edit_array(values);
        assert(changed == 14, "returned array sum changed");
        assert(values[0] == 1, "caller array remains unchanged");
    }
}
