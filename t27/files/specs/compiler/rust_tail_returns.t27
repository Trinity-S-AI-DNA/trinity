; Value-returning function tails preserve the declared return context.
module RustTailReturns {
    var GLOBAL_VALUE: u32 = 7;
    fn top_tail(value: u32) -> u32 { value ^ 165 }
    fn branch_tail(value: u32) -> u32 { if value == 0 { 0 } else { value ^ 165 } }
    fn nested_tail(value: u32) -> u32 {
        if value < 128 { if value < 64 { value + 1 } else { value ^ 1 } } else { value - 1 }
    }
    fn local_tail(value: u32) -> u32 {
        if value == 0 { let bias: u32 = 9; let adjusted: u32 = bias ^ 0; adjusted } else { let bias: u32 = 12; let adjusted: u32 = value ^ bias; adjusted }
    }
    fn widen_tail(value: u8) -> u32 { value }
    fn narrow_tail(value: u32) -> u8 { value }
    fn wide_tail(value: u32, divisor: u32) -> u64 {
        if divisor == 0 { 0 } else { ((value as u64) << 33) / (divisor as u64) }
    }
    fn bool_tail(value: u32) -> bool { value < 128 }
    fn bool_to_int_tail(value: u32) -> u32 { value < 128 }
    fn call_tail(value: u8) -> u32 { widen_tail(value) }
    fn global_tail() -> u32 { GLOBAL_VALUE }
    fn explicit(value: u32) -> u32 { if value == 0 { return 17; } return value ^ 3; }
    fn mixed(value: u32) -> u32 { if value == 0 { return 17; } else { value ^ 3 } }
    fn ordinary_if(value: u32) -> u32 { var result: u32 = 5; if value > 0 { result = value; } return result ^ 1; }
    fn loop_tail(value: u32) -> u32 { var result: u32 = value; var index: u32 = 0; while index < 4 { result = result ^ 1; index += 1; } result }
    fn void_control(value: u32) -> void { var count: u32 = value; if value > 0 { count = count ^ 1; } while count > 0 { count -= 1; } }
    test source_anchor { assert(branch_tail(19) == 182, "source tail anchor"); }
}
