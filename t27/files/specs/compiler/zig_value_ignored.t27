; #6315: three forms put a value where gen-zig wrote a bare statement, and
; Zig refused the whole file ("value of type 'bool' ignored").
;   1. a brace invariant's predicate, `invariant i { MAX == 9 }`, is asserted
;   2. a tail expression, `fn f(v: u32) -> u32 { v + 1 }`, is the return
;      value, also through a final if/else
;   3. a bare call to a fn that returns a value, `load(5);`, is discarded
;      by name: `_ = load(5);`
module ZigValueIgnored {
    const MAX: u32 = 9;
    var LOADED: u32 = 0;
    fn ready() -> bool { return true; }
    fn top_tail(v: u32) -> u32 { v + 1 }
    fn branch_tail(v: u32) -> u32 { if v == 0 { 7 } else { v } }
    fn load(v: u32) -> bool { LOADED = v; return true; }
    invariant max_is_nine { MAX == 9 }
    invariant ready_holds { ready() }
    test tails {
        assert(top_tail(1) == 2);
        assert(branch_tail(0) == 7);
        assert(branch_tail(3) == 3);
    }
    test discard { load(5); assert(LOADED == 5); }
}
