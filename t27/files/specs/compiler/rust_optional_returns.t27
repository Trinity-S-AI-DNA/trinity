; #7534: gen-rust lowered a `?T` return type to `Option<T>` and `return null;`
; to `return None;`, but emitted a plain value return as is. rustc rejected it,
; E0308 "mismatched types", at `return (x / 2);`. A value returned from a `?T`
; fn is now wrapped in `Some(..)` when it is known not to be optional already;
; `null`, an optional local and a call to a `?T` fn pass through unwrapped.
; Rust-only shapes covered: a value and `null` from the same fn, a narrower
; integer (the width cast goes inside `Some`), a struct value, a tail value, a
; forwarded optional call, a forwarded optional local, and an unwrap `x.?`.
module RustOptionalReturns {
    struct Split { lo: u32, hi: u32, }

    pub fn half(x: u32) -> ?u32 {
        if (x % 2 == 1) {
            return null;
        }
        return x / 2;
    }

    pub fn widen(x: u8) -> ?u32 {
        if (x == 0) {
            return null;
        }
        return x;
    }

    pub fn split(x: u32) -> ?Split {
        if (x == 0) {
            return null;
        }
        return Split { lo: x & 65535, hi: x >> 16 };
    }

    pub fn seven_or_none(x: u32) -> ?u32 {
        if (x == 0) {
            return 7;
        }
        return null;
    }

    pub fn tail_value(x: u32) -> ?u32 {
        if (x > 100) {
            return null;
        }
        x + 1
    }

    pub fn forward_call(x: u32) -> ?u32 {
        return half(x);
    }

    pub fn forward_local(x: u32) -> ?u32 {
        const h: ?u32 = half(x);
        return h;
    }

    pub fn half_plus_one(x: u32) -> ?u32 {
        const h: ?u32 = half(x);
        if (h == null) {
            return null;
        }
        return h.? + 1;
    }

    test value_and_null {
        assert(half(4).? == 2, "even input gives a value");
        assert(half(3) == null, "odd input gives null");
    }

    test narrower_value {
        assert(widen(200).? == 200, "u8 value widened inside the optional");
        assert(widen(0) == null, "zero gives null");
    }

    test struct_value {
        const s: Split = split(131075).?;
        assert(s.lo == 3, "low half");
        assert(s.hi == 2, "high half");
        assert(split(0) == null, "zero gives null");
    }

    test literal_value {
        assert(seven_or_none(0).? == 7, "literal value");
        assert(seven_or_none(1) == null, "literal null");
    }

    test tail_value_returned {
        assert(tail_value(5).? == 6, "tail value");
        assert(tail_value(500) == null, "early null");
    }

    test forwarded_optionals {
        assert(forward_call(8).? == 4, "forwarded call value");
        assert(forward_call(9) == null, "forwarded call null");
        assert(forward_local(10).? == 5, "forwarded local value");
        assert(forward_local(11) == null, "forwarded local null");
    }

    test unwrapped_then_returned {
        assert(half_plus_one(6).? == 4, "unwrap plus one");
        assert(half_plus_one(7) == null, "null passes through");
    }
}
