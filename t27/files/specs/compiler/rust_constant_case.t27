// Public value names belong to the source API, including mixed case.
module RustConstantCase {
    const type_documentation: u32 = 2;
    const mixedCount: u32 = 3;
    const UPPER_COUNT: u32 = 4;
    var UPPER_STATE: u32 = 0;
    fn document(value: u32) -> u32 {
        return value + type_documentation + mixedCount + UPPER_COUNT;
    }
    fn record_state(value: u32) -> u32 {
        UPPER_STATE = value;
        return UPPER_STATE;
    }
    fn read_state() -> u32 { return UPPER_STATE; }
    test retained_values { assert(document(5) == 14, "all constant values"); }
    test module_state {
        assert(record_state(37) == 37, "written state");
        assert(read_state() == 37, "caller visible state");
    }
}
