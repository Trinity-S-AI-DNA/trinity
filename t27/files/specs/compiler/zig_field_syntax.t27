; #6451 and #6532: four spellings gen-zig wrote verbatim, each a Zig syntax
; error that stopped the whole file before any test ran.
;   1. a postfix optional type, `note: str?`  -> Zig `?[]const u8`
;   2. a field named for a Zig keyword, `error` -> `.@"error"` where it is
;      initialised and read
;   3. a fn parameter named for a keyword, `var`, `error` -> `@"var"`
;   4. an array repeat with a Rust width suffix, `[0i32; 2]` -> `{ 0 } ** 2`
module ZigFieldSyntax {
    struct Reply {
        ok: bool,
        note: str?,
        error: str,
    }
    fn make(ok: bool) -> Reply { return Reply { ok: ok, note: null, error: "none" }; }
    fn error_of(r: Reply) -> str { return r.error; }
    fn failed(error: str) -> Reply { return Reply { ok: false, note: null, error: error }; }
    fn twice(var: u32) -> u32 { return var + var; }
    fn sum_two() -> i32 {
        var xs: [i32; 2] = [0i32; 2];
        xs[1] = 5;
        return xs[0] + xs[1];
    }
    test keyword_names_and_optional {
        const r = make(true);
        assert(r.ok);
        assert(r.note == null);
        assert(error_of(r).len == 4);
        assert(!failed("x").ok);
        assert(twice(21) == 42);
    }
    test repeat_literal { assert(sum_two() == 5); }
}
