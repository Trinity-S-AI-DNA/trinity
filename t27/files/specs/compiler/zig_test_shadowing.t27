; #6295: three things in a test block that gen-zig turned into a shadowed or
; redeclared Zig local, so Zig refused the whole file.
;   1. `HITS = 3;` writes the module var HITS. It was bound as
;      `const HITS = 3;`, which shadowed the declaration.
;   2. `var READY: bool = true;` and `twice = 4;` are new locals. READY is a
;      module var and twice is a module fn, so each one gets the `_lv` rename
;      that fn bodies already had.
;   3. `var ok: bool = twice(1) == 2;` and then `ok = twice(2) == 5;`
;      reassign the local the test declared. The reassignment was bound a
;      second time as `const ok`.
; A bench block is lowered with the same binding rules, so bench_counts
; checks the same three things there.
module ZigTestShadowing {
    var HITS: u32 = 0;
    var READY: bool = false;
    fn twice(v: u32) -> u32 { return v * 2; }
    fn hit() -> u32 { HITS = HITS + 1; return HITS; }
    test module_var_write {
        HITS = 3;
        assert(hit() == 4);
        assert(HITS == 4);
    }
    test local_shadows_module_names {
        var READY: bool = true;
        twice = 4;
        assert(READY == true);
        assert(twice == 4);
    }
    test reassign_declared_local {
        var ok: bool = twice(1) == 2;
        assert(ok == true);
        ok = twice(2) == 5;
        assert(ok == false);
    }
    bench bench_counts {
        var i: u32 = 0;
        while i < 3 { i = i + 1; }
        i = 0;
        HITS = 1;
        twice = 2;
    }
}
