; #6941: gen-zig picks a cast builtin from the operand's type, and it could
; not see that a call returns a float. `(half() - quarter()) as f32` was read
; as an integer and lowered to `@floatFromInt`, which Zig refuses on an f64
; ("expected integer type, found 'f64'"); so was a lone `half() as f32`.
; specs/numeric/formats.t27 routed the value through a typed f64 local.
; A call that returns an integer must keep `@floatFromInt`.
module ZigFloatCallCast {
    fn half() -> f64 {
        return 0.5;
    }

    fn quarter() -> f64 {
        return 0.25;
    }

    fn three() -> u32 {
        return 3;
    }

    fn diff_f32() -> f32 {
        return (half() - quarter()) as f32;
    }

    fn half_f32() -> f32 {
        return half() as f32;
    }

    fn three_f32() -> f32 {
        return three() as f32;
    }

    test call_minus_call {
        assert(diff_f32() == 0.25);
    }

    test single_call {
        assert(half_f32() == 0.5);
    }

    test int_call_stays_int {
        assert(three_f32() == 3.0);
    }
}
