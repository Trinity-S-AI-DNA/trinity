; #6941: gen-rust learned an enum's name only when it emitted the enum, so a
; function emitted before its enum lowered the enum's members wrong:
;   1. `Trit.pos` reached Rust as a field access on a type, which rustc
;      refuses ("expected value, found enum `Trit`"), and
;   2. a switch arm `.neg` stayed a bare name, which Rust reads as a binding
;      that matches every value.
; An enum that arrives by `use` is spliced in after the functions, so every
; imported enum sat in that position; so did a local enum declared below its
; users. specs/numeric/formats.t27 spelled its members `Trit::pos` to avoid it.
module RustEnumOrder {
    use base::types;

    fn sign_of(x: i32) -> Trit {
        if (x > 0) {
            return Trit.pos;
        }
        if (x < 0) {
            return Trit.neg;
        }
        return Trit.zero;
    }

    fn weight(t: Trit) -> i32 {
        return switch (t) {
            .neg => 0 - 1,
            .zero => 0,
            .pos => 1,
        };
    }

    fn is_warm(s: Shade) -> bool {
        return s == Shade.red;
    }

    pub const Shade = enum(u8) {
        red,
        blue,
    };

    test imported_enum_members {
        assert(weight(sign_of(5)) == 1);
        assert(weight(sign_of(0 - 5)) == 0 - 1);
        assert(weight(sign_of(0)) == 0);
    }

    test local_enum_below_its_users {
        assert(is_warm(Shade.red));
        assert(!is_warm(Shade.blue));
    }
}
