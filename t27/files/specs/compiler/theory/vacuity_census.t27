// SPDX-License-Identifier: Apache-2.0
; specs/compiler/theory/vacuity_census.t27 -- sieve C10: where the specs with no test block live,
; directory by directory (gHashTag/t27 epic #6488, issue #6518).
; ASCII only (L3).

; Theorem T730 (specs/compiler/theory/toolchain.t27): a pass with zero executed asserts certifies
; nothing. I. Beer, S. Ben-David, C. Eisner, Y. Rodeh, CAV 1997, LNCS 1254:279-290,
; DOI 10.1007/3-540-63166-6_28, call such a pass vacuous. A spec with no test block can only pass
; vacuously. This census tells the Queen which top-level directories of specs/ hold the most such
; specs, so test-writing lanes can be aimed at them.

; ---- How the counts were taken ------------------------------------------------------------------
; Master commit of the count: 5bad20521ebb22474b9ba6ed57784de23e16aba6 (2026-10-06).
; For each top-level directory D of specs/ with at least one .t27 file directly in it:
;   files_in      = ls specs/D/*.t27 | wc -l
;   without_tests = grep -LE '^[[:space:]]*test ' specs/D/*.t27 | wc -l
; The pattern allows leading whitespace because most test blocks on master sit indented inside
; `module X { ... }` (the Queen-runnable restatement of #6518 corrects `^test ` to this).
; Only files directly in D are counted; subdirectories such as specs/tri/sort are not.
; Rows are sorted by without_tests, largest first; ties are broken by directory name (ASCII order).

; ---- Whole tree, same commit --------------------------------------------------------------------
; 72 top-level directories hold .t27 files directly; together 598 files, 166 of them with no test
; block. 16 directories have at least one such file; the top 10 below hold 160 of the 166.
; The six left out each have exactly 1: docs, jit, lsp, physics, sandbox, system.
; Two of the top 10 are not real subsystems: specs/a/b_c.t27 and specs/a_b/c.t27 are one-file
; directories (module-path fixtures), listed because the rule is mechanical, not curated.

; ---- The top 10 ---------------------------------------------------------------------------------
; d  directory    files_in  without_tests
; 0  crons              50             49
; 1  functions          29             29
; 2  skills             29             29
; 3  agents             27             27
; 4  numeric            59             11
; 5  sacred             10             10
; 6  i18n                3              2
; 7  a                   1              1
; 8  a_b                 1              1
; 9  automation         31              1
; math is not in the top 10 (no math file lacks a test block at this commit).

; phi^2 + 1/phi^2 = 3 | TRINITY

module CompilerTheoryVacuityCensus;

pub const ROWS : u32 = 10;
pub const TOTAL_WITHOUT_TESTS : u32 = 160;
pub const TOTAL_FILES : u32 = 240;
pub const TREE_WITHOUT_TESTS : u32 = 166;
pub const TREE_FILES : u32 = 598;
pub const TREE_DIRS : u32 = 72;

; The row index d of each directory in the top 10.
; d = 0: specs/crons
pub const D_CRONS : u32 = 0;
; d = 1: specs/functions
pub const D_FUNCTIONS : u32 = 1;
; d = 2: specs/skills
pub const D_SKILLS : u32 = 2;
; d = 3: specs/agents
pub const D_AGENTS : u32 = 3;
; d = 4: specs/numeric
pub const D_NUMERIC : u32 = 4;
; d = 5: specs/sacred
pub const D_SACRED : u32 = 5;
; d = 6: specs/i18n
pub const D_I18N : u32 = 6;
; d = 7: specs/a
pub const D_A : u32 = 7;
; d = 8: specs/a_b
pub const D_A_B : u32 = 8;
; d = 9: specs/automation
pub const D_AUTOMATION : u32 = 9;

; Number of .t27 files directly in directory d of the top 10 (0 outside 0..9).
pub fn files_in(d: u32) -> u32 {
    if (d == D_CRONS) { return 50; }
    if (d == D_FUNCTIONS) { return 29; }
    if (d == D_SKILLS) { return 29; }
    if (d == D_AGENTS) { return 27; }
    if (d == D_NUMERIC) { return 59; }
    if (d == D_SACRED) { return 10; }
    if (d == D_I18N) { return 3; }
    if (d == D_A) { return 1; }
    if (d == D_A_B) { return 1; }
    if (d == D_AUTOMATION) { return 31; }
    return 0;
}

; Number of those files with no line matching '^[[:space:]]*test ' (0 outside 0..9).
pub fn without_tests(d: u32) -> u32 {
    if (d == D_CRONS) { return 49; }
    if (d == D_FUNCTIONS) { return 29; }
    if (d == D_SKILLS) { return 29; }
    if (d == D_AGENTS) { return 27; }
    if (d == D_NUMERIC) { return 11; }
    if (d == D_SACRED) { return 10; }
    if (d == D_I18N) { return 2; }
    if (d == D_A) { return 1; }
    if (d == D_A_B) { return 1; }
    if (d == D_AUTOMATION) { return 1; }
    return 0;
}

; True when a pair of adjacent rows is in census order: the earlier row has at least as many
; files without tests as the later one.
pub fn pair_sorted(earlier: u32, later: u32) -> bool {
    return earlier >= later;
}

; True when every adjacent pair of the top 10 is in census order.
pub fn census_sorted() -> bool {
    var d : u32 = 1;
    var ok : bool = true;
    while (d < ROWS) {
        if (pair_sorted(without_tests(d - 1), without_tests(d)) == false) { ok = false; }
        d = d + 1;
    }
    return ok;
}

test c10_no_row_has_more_untested_files_than_files {
    var d : u32 = 0;
    var bad : u32 = 0;
    while (d < ROWS) {
        if (without_tests(d) > files_in(d)) { bad = bad + 1; }
        if (files_in(d) == 0) { bad = bad + 1; }
        d = d + 1;
    }
    assert bad == 0;
    assert files_in(ROWS) == 0;
    assert without_tests(ROWS) == 0;
}

test c10_sums_match_the_recorded_totals {
    var d : u32 = 0;
    var sum_without : u32 = 0;
    var sum_files : u32 = 0;
    while (d < ROWS) {
        sum_without = sum_without + without_tests(d);
        sum_files = sum_files + files_in(d);
        d = d + 1;
    }
    assert sum_without == TOTAL_WITHOUT_TESTS;
    assert sum_files == TOTAL_FILES;
    assert TOTAL_WITHOUT_TESTS <= TREE_WITHOUT_TESTS;
    assert TREE_WITHOUT_TESTS - TOTAL_WITHOUT_TESTS == 6;
    assert TREE_WITHOUT_TESTS <= TREE_FILES;
}

test c10_list_is_sorted_non_increasing {
    assert census_sorted();
    assert without_tests(0) == 49;
    assert without_tests(ROWS - 1) >= 1;
}

; Negative control: the same pair_sorted that accepts the census must reject an unsorted pair,
; otherwise c10_list_is_sorted_non_increasing would be a vacuous pass of its own (T730).
test c10_negative_control_unsorted_pair_is_rejected {
    assert pair_sorted(without_tests(9), without_tests(0)) == false;
    assert pair_sorted(1, 2) == false;
    assert pair_sorted(2, 2);
    assert pair_sorted(without_tests(0), without_tests(9));
}

invariant c10_crons_is_the_largest_gap {
    assert without_tests(0) >= without_tests(1);
    assert without_tests(0) <= files_in(0);
}
