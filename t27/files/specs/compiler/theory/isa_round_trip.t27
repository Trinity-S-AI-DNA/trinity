// SPDX-License-Identifier: Apache-2.0
; specs/compiler/theory/isa_round_trip.t27 -- T735, T736: does the TRI-27 word round-trip, and what
; t27a (the assembler and disassembler) must change so that it does (gHashTag/t27 epic #6488).
; ASCII only (L3).

; Why this is the assembler's theorem. N. Ramsey and M. F. Fernandez, "Specifying Representations of
; Machine Instructions", ACM TOPLAS 19(3), 1997 (the New Jersey Machine-Code Toolkit), generate an
; encoder and a decoder from ONE specification of the instruction fields, so that the decoder
; inverts the encoder by construction. The property that buys is decode(encode(i)) = i for every
; well-formed instruction i; T734 in specs/compiler/theory/toolchain.t27 shows it is what lets a
; backend's wrong word be blamed on instruction selection alone.

; The encoding under test is specs/isa/ternary_encoding.t27 (module Tri27Encoding), which pins the
; Trinity emulator's decoder.zig. That spec already records the losses below as findings (its
; SRC2_LOSS_RULE and SACR_MODE_RULE) and tests single words. Note on its own tests: on the t27b lab
; (master 682564f48) the reference path reports that spec BLOCKED, because its two `invariant`
; blocks are bare expressions, which the generated Zig rejects ("value of type bool ignored"), so
; none of its round-trip tests runs in the reference today. The tests here exercise the same
; functions through `use`, at run time.

; Well-formed domain, as the encoding declares it: dst, src1, src2 and the third BUNDLE3 register
; are register numbers 0..26 (specs/isa/registers.t27: 27 registers; the executor refuses 27..31);
; in the immediate form src1 is four bits (0..15) and the immediate is 15-bit two's complement
; (IMM_MIN..IMM_MAX). An operand is CARRIED by an opcode when the executor reads it: src2 for the
; three-operand opcodes and for DOT, BIND, BUNDLE2, BUNDLE3; the immediate for the immediate-form
; opcodes and for SACR (its mode); the third register for BUNDLE3.

; phi^2 + 1/phi^2 = 3 | TRINITY

module CompilerTheoryIsaRoundTrip;

use isa::ternary_encoding;

pub const REGS : u32 = 27;

pub fn carries_src2(op: u32) -> bool {
    if (has_src2(op)) { return true; }
    if (op == OP_DOT) { return true; }
    if (op == OP_BIND) { return true; }
    if (op == OP_BUNDLE2) { return true; }
    if (op == OP_BUNDLE3) { return true; }
    return false;
}

pub fn carries_imm(op: u32) -> bool {
    if (has_imm(op)) { return true; }
    if (op == OP_SACR) { return true; }
    return false;
}

pub fn carries_v3(op: u32) -> bool {
    return op == OP_BUNDLE3;
}

; SACR is taken with a four-bit src1, the domain on which T736's fix exists (see T736's cost).
pub fn src1_limit(op: u32) -> u32 {
    if (has_imm(op)) { return 16; }
    if (op == OP_SACR) { return 16; }
    return REGS;
}

; The current pair: the owner's encode, plus bundle3_word, the only writer of a BUNDLE3 word
; (`use_bundle3_writer`), and the owner's field decoders.
pub fn word_now(op: u32, dst: u32, s1: u32, s2: u32, v3: u32, imm: i32, use_bundle3_writer: bool) -> u32 {
    if (op == OP_BUNDLE3) {
        if (use_bundle3_writer) { return bundle3_word(dst, s1, s2, v3); }
    }
    return encode(op, dst, s1, s2, imm);
}

; The t27a fields: the same layout, with the forms widened so that every carried operand has a
; field. DOT, BIND, BUNDLE2 take the three-operand layout; SACR takes the immediate layout; BUNDLE3
; writes its third register at V3_SHIFT. Nothing else moves, so every word the current encoder
; writes for the other 42 opcodes is unchanged (checked below). This file first carried the table
; as a proposal; it is now adopted in specs/isa/ternary_encoding.t27 (t27a_imm_form,
; t27a_src2_form, t27a_encode, t27a_src1, t27a_src2, t27a_imm, gHashTag/t27#6507), and the T736
; tests below run against that one copy through `use`, so the theorem checks the table t27a uses.

; One sample of the well-formed domain, indexed by k: registers at both ends and the middle, the
; immediate at both ends, -1, 0 and 1.
pub fn sample_reg(k: u32, limit: u32) -> u32 {
    var m : u32 = k % 3;
    if (m == 0) { return 0; }
    if (m == 1) { return limit / 2; }
    return limit - 1;
}

pub fn sample_imm(k: u32) -> i32 {
    var m : u32 = k % 5;
    if (m == 0) { return IMM_MIN; }
    if (m == 1) { return 0 - 1; }
    if (m == 2) { return 0; }
    if (m == 3) { return 1; }
    return IMM_MAX;
}

; Does the pair (fixed = false: current encode/decode; fixed = true: the t27a fields) round-trip
; opcode op on all 3^4 x 5 samples?
pub fn round_trips(op: u32, fixed: bool, use_bundle3_writer: bool) -> bool {
    var k : u32 = 0;
    while (k < 405) {
        var dst : u32 = sample_reg(k, REGS);
        var s1 : u32 = sample_reg(k / 3, src1_limit(op));
        var s2 : u32 = sample_reg(k / 9, REGS);
        var v3 : u32 = sample_reg(k / 27, REGS);
        var imm : i32 = sample_imm(k / 81);
        var w : u32 = 0;
        if (fixed) { w = t27a_encode(op, dst, s1, s2, v3, imm); } else { w = word_now(op, dst, s1, s2, v3, imm, use_bundle3_writer); }
        if (decode_opcode(opcode_of(w)) != op) { return false; }
        if (dst_of(w) != dst) { return false; }
        if (fixed) {
            if (t27a_src1(w, op) != s1) { return false; }
            if (carries_src2(op)) {
                if (t27a_src2(w, op) != s2) { return false; }
            }
            if (carries_imm(op)) {
                if (t27a_imm(w, op) != imm) { return false; }
            }
        } else {
            if (src1_of(w, op) != s1) { return false; }
            if (carries_src2(op)) {
                if (src2_of(w, op) != s2) { return false; }
            }
            if (carries_imm(op)) {
                if (imm_of(w, op) != imm) { return false; }
            }
        }
        if (carries_v3(op)) {
            if (v3_of(w, op) != v3) { return false; }
        }
        k = k + 1;
    }
    return true;
}

pub fn failing_opcodes(fixed: bool, use_bundle3_writer: bool) -> u32 {
    var op : u32 = 0;
    var bad : u32 = 0;
    while (op < 256) {
        if (is_defined_opcode(op)) {
            if (round_trips(op, fixed, use_bundle3_writer) == false) { bad = bad + 1; }
        }
        op = op + 1;
    }
    return bad;
}

pub fn defined_opcodes() -> u32 {
    var op : u32 = 0;
    var n : u32 = 0;
    while (op < 256) {
        if (is_defined_opcode(op)) { n = n + 1; }
        op = op + 1;
    }
    return n;
}

; ==================================================================================================
; T735 -- the current TRI-27 encoder is not a left inverse of the decoder.
; Statement. Over the well-formed domain, decode(encode(i)) = i holds for exactly 42 of the 47
; opcodes. It fails for DOT, BIND and BUNDLE2 (src2 is carried but not written), SACR (its mode
; immediate is carried but not written) and BUNDLE3 (encode never writes the third register; the
; separate writer bundle3_word does, and with it BUNDLE3 round-trips). Proof: exhaustive over the
; 47 opcodes and the sampled operand grid, by the tests below. Consequence (T734): until t27a fixes
; this, a wrong word for these five opcodes cannot be blamed on instruction selection.
; A second, decoder-side, gap: 209 of the 256 opcode bytes are undefined and decode as NOP
; (UNKNOWN_OPCODE_RULE), so a disassembler built on decode_opcode cannot tell a NOP from garbage.
; ==================================================================================================

test t735_the_table_has_forty_seven_opcodes {
    assert defined_opcodes() == OPCODE_COUNT;
}

test t735_exactly_five_opcodes_fail_to_round_trip {
    assert failing_opcodes(false, false) == 5;
    assert round_trips(OP_DOT, false, false) == false;
    assert round_trips(OP_BIND, false, false) == false;
    assert round_trips(OP_BUNDLE2, false, false) == false;
    assert round_trips(OP_SACR, false, false) == false;
    assert round_trips(OP_BUNDLE3, false, false) == false;
    assert round_trips(OP_ADD, false, false);
    assert round_trips(OP_LDI, false, false);
    assert round_trips(OP_MOV, false, false);
}

test t735_bundle3_round_trips_only_through_its_separate_writer {
    assert round_trips(OP_BUNDLE3, false, true);
    assert failing_opcodes(false, true) == 4;
}

test t735_undefined_bytes_alias_nop {
    var b : u32 = 1;
    var aliases : u32 = 0;
    while (b < 256) {
        if (decode_opcode(b) == OP_NOP) { aliases = aliases + 1; }
        b = b + 1;
    }
    assert aliases == 209;
}

; ==================================================================================================
; T736 -- a t27a field table that round-trips all 47 opcodes and moves no existing word.
; Statement. Widen the three-operand form by DOT, BIND, BUNDLE2 (BUNDLE3 too), the immediate form by
; SACR, and write BUNDLE3's third register at V3_SHIFT. Then (a) decode(encode(i)) = i for all 47
; opcodes over the well-formed domain, and (b) for the 42 opcodes that already round-trip, the new
; encoder writes exactly the word the current one writes, so no existing program changes. Proof:
; exhaustive over opcodes and the operand grid, by the tests below. What T736 does not settle: the
; Trinity emulator (gHashTag/trinity src/tri27/emu/decoder.zig) must take the same field table, or
; the t27a words for these five opcodes mean something else there; that is the t27a MVP issue's
; boundary, not this spec's. The cost: SACR moves to the immediate layout, so its src1 shrinks from
; five bits to four, and registers 16..26 can no longer be SACR's source (the last test pins that).
; ==================================================================================================

test t736_the_t27a_fields_round_trip_every_opcode {
    assert failing_opcodes(true, false) == 0;
}

test t736_the_cost_is_sacr_src1_shrinking_to_four_bits {
    assert src1_of(encode(OP_SACR, 0, 20, 0, 0), OP_SACR) == 20;
    assert t27a_src1(t27a_encode(OP_SACR, 0, 20, 0, 0, 0), OP_SACR) == 4;
    assert t27a_src1(t27a_encode(OP_SACR, 0, 15, 0, 0, 0), OP_SACR) == 15;
}

test t736_the_t27a_fields_move_no_word_that_already_round_trips {
    var op : u32 = 0;
    var moved : u32 = 0;
    var checked : u32 = 0;
    while (op < 256) {
        if (is_defined_opcode(op)) {
            if (round_trips(op, false, false)) {
                var k : u32 = 0;
                while (k < 45) {
                    var dst : u32 = sample_reg(k, REGS);
                    var s1 : u32 = sample_reg(k / 3, src1_limit(op));
                    var s2 : u32 = 0;
                    if (carries_src2(op)) { s2 = sample_reg(k / 9, REGS); }
                    var imm : i32 = sample_imm(k / 9);
                    if (carries_imm(op) == false) { imm = 0; }
                    if (t27a_encode(op, dst, s1, s2, 0, imm) != encode(op, dst, s1, s2, imm)) { moved = moved + 1; }
                    checked = checked + 1;
                    k = k + 1;
                }
            }
        }
        op = op + 1;
    }
    assert moved == 0;
    assert checked == 42 * 45;
}
