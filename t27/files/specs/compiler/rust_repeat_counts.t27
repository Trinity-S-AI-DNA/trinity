// Integral counts in repetition expressions retain their full grouping.
module RustRepeatCounts {
    const COUNT8: u8 = 4;
    const COUNT16: u16 = 4;
    const COUNT32: u32 = 4;
    const COUNT64: u64 = 4;
    const ZERO: u16 = 0;
    fn repeat8(value: u32) -> [u32; 4] { return [value; COUNT8]; }
    fn repeat16(value: u32) -> [u32; 4] { return [value; COUNT16]; }
    fn repeat32(value: u32) -> [u32; 4] { return [value; COUNT32]; }
    fn repeat64(value: u32) -> [u32; 4] { return [value; COUNT64]; }
    fn grouped(value: u32) -> [u32; 7] { return [value; COUNT32 * 2 - 1]; }
    fn empty() -> [u32; 0] { return [0; ZERO]; }
    fn literal(value: u32) -> [u32; 4] { return [value; 4]; }
    fn list(value: u32) -> [u32; 4] { return [value, 2, 3, 4]; }
    test named_integral_widths {
        let a: [u32; 4] = repeat8(9);
        let b: [u32; 4] = repeat16(9);
        let c: [u32; 4] = repeat32(9);
        let d: [u32; 4] = repeat64(9);
        assert(a[3] == 9, "u8 count");
        assert(b[3] == 9, "u16 count");
        assert(c[3] == 9, "u32 count");
        assert(d[3] == 9, "u64 count");
    }
    test grouped_count {
        let values: [u32; 7] = grouped(12);
        assert(values[6] == 12, "last repeated element");
    }
    test literal_and_list_controls {
        let repeated: [u32; 4] = literal(11);
        let listed: [u32; 4] = list(11);
        assert(repeated[3] == 11, "literal repeat");
        assert(listed[0] == 11, "first list element");
        assert(listed[3] == 4, "last list element");
    }
}
