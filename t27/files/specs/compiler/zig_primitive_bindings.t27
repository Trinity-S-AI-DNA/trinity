; Primitive-shaped value bindings stay distinct from builtin types.
module ZigPrimitiveBindings {
    const BYTE = u8;
    fn typed(value: u32) -> u32 { let f16: u32 = value; return f16; }
    fn untyped(value: u32) -> u32 { let i0 = value; return i0; }
    fn parameters(f16: u32, i0: u32) -> u32 { return f16 ^ i0; }
    fn mutable_parameter(f16: u32) -> u32 { f16 = f16 ^ 1; return f16; }
    fn ignored_parameter(i0: u32) -> u32 { return 7; }
    fn pair(value: u32) -> (u32, u32) { return (value, value ^ 1); }
    fn tuple_value(value: u32) -> u32 { let (f16, i0) = pair(value); return f16 ^ i0; }
    fn narrow(value: u16) -> u8 { return value as u8; }
    fn floating(value: u32) -> f64 { return value as f64; }
    fn alias_value(value: u8) -> BYTE { return value; }
    test primitive_assignments {
        i0 = typed(19);
        f16 = untyped(19);
        assert(i0 == 19, "first assignment");
        assert(f16 == i0, "primitive references");
        assert(parameters(19, 3) == 16, "parameters");
        assert(mutable_parameter(19) == 18, "mutable parameter");
        assert(ignored_parameter(19) == 7, "discarded parameter");
        assert(tuple_value(19) == 1, "tuple bindings");
    }
    test builtin_controls {
        assert(narrow(511) == 255, "integer builtin cast");
        assert(floating(19) == 19.0, "float builtin cast");
        assert(alias_value(19) == 19, "builtin alias");
    }
    bench primitive_values {
        i0 = typed(23);
        assert(i0 == 23, "bench first assignment");
    }
}
