; #6533: a type written through its module, `gf16::GF16`, is the same type
; as the bare `GF16`. gen-zig mapped the bare name to `u16` and wrote the
; scoped one as `gf16.GF16`, which names a module this file never declares.
; use-resolution splices declarations with their module paths intact, so
; every spliced struct with such a field stopped the importer from compiling.
module ZigScopedType {
    struct Cache {
        cos: []gf16::GF16,
        sin: []gf16::GF16,
        scale: gf16::GF16,
    }
    fn scale_of(c: Cache) -> u16 { return c.scale; }
    fn first_cos(c: Cache) -> gf16::GF16 { return c.cos[0]; }
    test scoped_field_is_the_bare_type {
        var xs: [2]u16 = [2]u16{ 15360, 16384 };
        xs[1] = 16384;
        const c = Cache { cos: xs[0..2], sin: xs[0..1], scale: 15360 };
        assert(scale_of(c) == 15360);
        assert(first_cos(c) == 15360);
        assert(c.sin.len == 1);
    }
}
