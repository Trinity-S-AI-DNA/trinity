; #5710: fixed array returns must be values, never addresses of frame locals.
; The [N]T spelling currently generates dangerous C that returns pointers to stack
; memory, while [T; N] correctly returns structs by value. This regression test
; documents the expected behavior for both spellings and ensures they work safely.
; 
; Design decision: Returns and parameters should use the same representation
; ([T; N] struct form) for type safety and consistency. This affects #3435
; for parameter form while fixing the return safety issue.
module CFixedArrayReturn {
    // Function returning [4]u8 (problematic spelling - should become struct)
    fn return_bracket_array(v: i32) -> [4]u8 {
        var a: [4]u8 = [0, 0, 0, 0];
        a[0] = 7;  // Write to first element
        return a;
    }
    
    // Function returning [u8; 4] (correct spelling - struct return)
    fn return_semicolon_array(v: i32) -> [u8; 4] {
        var a: [u8; 4] = [0, 0, 0, 0];
        a[0] = 7;  // Write to first element
        return a;
    }
    
    // Function that takes [4]u8 parameter (should match return representation)
    fn consume_array(input: [4]u8) -> u32 {
        return input[0] as u32 + input[1] as u32 + input[2] as u32 + input[3] as u32;
    }
    
    // Helper to test both spellings by calling them
    fn test_both_spellings() -> (u8, u8, u8, u8, u32) {
        let bracket_result: [4]u8 = return_bracket_array(42);
        let semicolon_result: [u8; 4] = return_semicolon_array(42);
        let consumed: u32 = consume_array(bracket_result);  // Pass bracket result to consumer
        return (bracket_result[0], bracket_result[3], semicolon_result[0], semicolon_result[3], consumed);
    }
    
    // Test bracket array return values
    test bracket_array_first_element {
        let result: [4]u8 = return_bracket_array(123);
        assert(result[0] == 7, "first element should be 7");
    }
    
    test bracket_array_last_element {
        let result: [4]u8 = return_bracket_array(456);
        assert(result[3] == 0, "last element should be 0");
    }
    
    // Test semicolon array return values  
    test semicolon_array_first_element {
        let result: [u8; 4] = return_semicolon_array(789);
        assert(result[0] == 7, "first element should be 7");
    }
    
    test semicolon_array_last_element {
        let result: [u8; 4] = return_semicolon_array(101);
        assert(result[3] == 0, "last element should be 0");
    }
    
    // Test passing returned array to consumer function
    test array_parameter_passing {
        let returned: [4]u8 = return_bracket_array(202);
        let sum: u32 = consume_array(returned);
        assert(sum == 7, "sum should be 7 (7 + 0 + 0 + 0)");
    }
    
    // Test both spellings together
    test both_spellings_comparison {
        let (bracket_first, bracket_last, semicolon_first, semicolon_last, consumed) = test_both_spellings();
        assert(bracket_first == 7, "bracket first element");
        assert(bracket_last == 0, "bracket last element");
        assert(semicolon_first == 7, "semicolon first element");
        assert(semicolon_last == 0, "semicolon last element");
        assert(consumed == 7, "consumed sum");
    }
}