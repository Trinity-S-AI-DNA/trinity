// SPDX-License-Identifier: Apache-2.0
// specs/automation/blog-share.t27 -- the blog desk: one t27.ai article a day becomes a
// question to the owner, and it is posted on their networks only after a yes.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/agent/blog-share.ts (the
//       tick: the open question first, then at most one new question a day; the
//       receipt and the published-somewhere rule) beside src/agent/blog-share-wiring.ts
//       (the real feed, the owner's approvals, their browser: the publish-button
//       search), driven by the interval in render-server.ts.
// Laws carried from the incidents of 2026-10-02:
//       - twelve rows were closed as "declined" while their approval row was still
//         pending -- nobody pressed no. A decline is real only when the approval was
//         decided; an expiry is silence, and the desk says so to the owner.
//       - the only allowed article of the month reported "button not found" on X and
//         LinkedIn: one look at six seconds on a cold browser. The desk looks again
//         every three seconds, eight looks in all.
//       - a press is not a post: only the page leaving its share address is a receipt.
//       - a receipt is not a post either: a page can leave the form for an error page.
//         After the receipt the owner's own profile is opened in the same browser and
//         the post's opening words are looked for; only a post seen there counts as
//         published. Pressed and not seen is "unconfirmed", never "posted".
// v3 (2026-10-04): the owner's queue comes first. The owner ranked the articles in
//       their Blogger agent's skill ("the blog starts with its successes"), and the
//       desk still asked about the newest article nobody was asked about: the ranking
//       reached the agent and not the desk. The next question is now the first queued
//       article that the feed carries and nobody was asked about; the newest such only
//       when no queued one is left. The queue lives in that one skill and the host
//       reads it there, so it has one home. And a network the owner switched off --
//       Reddit closed r/t27ai on 2026-10-03 -- is neither named in the question nor
//       posted to.
// v4 (2026-10-06): a fresh article goes before the queue. The queue was written once,
//       its first items from August; from 2026-10-04 to 10-06 it sent three August
//       articles to X @t27_dev on three days while the articles of 10-04 waited behind
//       seven more old ones -- a queue of August articles kept the fresh ones out of
//       X for a week. An offerable article published within FRESH_MS (seven days) now
//       goes first, the newest such first; then the queue; then the newest remaining.
// UI words (the owner reads Russian) stay in the host; the spec holds the rules.
// Claim status: the desk is live behind BLOG_SHARE_ENABLED=1 on the render service,
//       and its posts are confirmed: on 2026-10-03 08:36 UTC it found its post of
//       one-regional-clock-twelve-pull-requests on the owner's X, LinkedIn and Reddit
//       profiles (blog_shares row, state "posted"); Facebook went by its API, Threads
//       was not signed in. The order of v4 is not yet measured on a live tick.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::blog_share {

    pub const KIND : str = "automation";
    pub const ID : str = "blog-share";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 4;

    // ---- The pace -------------------------------------------------------------------
    pub const TICK_MS : u32 = 300000;  // render-server.ts: every five minutes; a
                                       // thirty-minute timer restarted by each deploy
                                       // often never fired at all
    pub const ASK_EVERY_MS : u32 = 72000000;  // 20 h: one question a day at most, a
                                              // little under 24 h so the hour drifts
                                              // earlier, never later
    pub const ANSWER_WAIT_MS : u32 = 86400000;  // 24 h: the approval's own lifetime; a
                                                // question nobody answered is let go
    pub const ASK_NEEDS_YES : bool = true;  // posting on someone's public accounts is
                                            // outward and cannot be taken back

    // ---- The publish button ---------------------------------------------------------
    pub const FIRST_SETTLE_MS : u16 = 6000;  // the share page draws before the first look
    pub const LOOK_EVERY_MS : u16 = 3000;  // a cold browser draws the composer late
    pub const LOOKS : u8 = 8;  // first look included: about half a minute in all
    pub const AFTER_CLICK_SETTLE_MS : u16 = 5000;  // then the address is read again

    // ---- The confirmation on the owner's own profile -------------------------------
    pub const PROFILE_SETTLE_MS : u16 = 5000;  // the profile draws before the first look
    pub const PROFILE_LOOK_EVERY_MS : u16 = 4000;  // a fresh post reaches the feed late
    pub const PROFILE_LOOKS : u8 = 4;  // first look included: under twenty seconds
    pub const MATCH_CHARS : u8 = 60;  // the post's opening words, normalized, are the
                                      // needle; every post starts with the title

    // ---- The order of the next question ---------------------------------------------
    pub const FRESH_MS : u32 = 604800000;  // 7 days: an article this young goes before
                                           // the owner's queue

    // ---- Not claimed ----------------------------------------------------------------
    pub const RUN_LIVE : bool = true;  // flipped in v3: confirmed on the profile 2026-10-03

    // An open question is still waited on while it is pending and younger than the
    // approval's lifetime.
    fn still_waiting(answer: str, age_ms: u32) -> bool {
        return answer == "pending" && age_ms < ANSWER_WAIT_MS;
    }

    // A new question is due when none was ever asked, or the last one is a pace old.
    fn may_ask(ever_asked: bool, since_last_ms: u32) -> bool {
        return !ever_asked || since_last_ms >= ASK_EVERY_MS;
    }

    // Only "allowed" posts. Everything else closes the question unposted.
    fn posts(answer: str) -> bool {
        return answer == "allowed";
    }

    // A decline is real only when a person decided it: "denied". An expiry -- or a
    // row still pending -- is silence, and the owner is told it went unanswered.
    fn decline_is_real(answer: str) -> bool {
        return answer == "denied";
    }

    // The receipt: both addresses read, and the page left the share form.
    fn left_the_form(before: str, after: str) -> bool {
        return before != "" && after != "" && before != after;
    }

    // A network counts as published only when the page left the form AND the post
    // was then seen on the owner's own profile.
    fn counted(left: bool, seen: bool) -> bool {
        return left && seen;
    }

    // Pressed, but not seen on the profile: unconfirmed, which is not published.
    fn unconfirmed(pressed: bool, seen: bool) -> bool {
        return pressed && !seen;
    }

    // Published somewhere: no run-wide error, and at least one network whose post
    // was seen on the owner's profile.
    fn published_somewhere(has_error: bool, seen: u8) -> bool {
        return !has_error && seen > 0;
    }

    // An article may be offered when the feed carries it and nobody was asked about it.
    fn offerable(in_feed: bool, asked_before: bool) -> bool {
        return in_feed && !asked_before;
    }

    // The owner's queue comes first: the newest offerable article goes next only when
    // no queued article is offerable any more.
    fn newest_goes_next(queued_offerable: u8) -> bool {
        return queued_offerable == 0;
    }

    // An article is fresh while its age is at most FRESH_MS, the edge included.
    fn is_fresh(age_ms: u32) -> bool {
        return age_ms <= FRESH_MS;
    }

    // Where the next question comes from: a fresh offerable article first, then the
    // owner's queue, then the newest offerable remaining; "none" when nothing is left.
    fn next_source(fresh_offerable: u8, queued_offerable: u8, offerable_left: u8) -> str {
        if fresh_offerable > 0 {
            return "fresh";
        }
        if queued_offerable > 0 {
            return "queue";
        }
        if offerable_left > 0 {
            return "newest";
        }
        return "none";
    }

    // A network the owner switched off is neither named in the question nor posted to.
    fn network_used(switched_off: bool) -> bool {
        return !switched_off;
    }

    // The last moment the profile is looked at, from its opening.
    fn last_profile_look_ms() -> u32 {
        return PROFILE_SETTLE_MS + (PROFILE_LOOKS - 1) * PROFILE_LOOK_EVERY_MS;
    }

    // The last moment the publish button is looked for, from the page's opening.
    fn last_look_ms() -> u32 {
        return FIRST_SETTLE_MS + (LOOKS - 1) * LOOK_EVERY_MS;
    }

    test "an open question is waited on for the approval's lifetime, then let go" {
        assert(still_waiting("pending", 0));
        assert(still_waiting("pending", 86399999));
        assert(!still_waiting("pending", 86400000));
        assert(!still_waiting("allowed", 0));
        assert(!still_waiting("expired", 0));
        assert(ANSWER_WAIT_MS == 86400000);
    }

    test "one question a day at most, on a five-minute tick" {
        assert(may_ask(false, 0));
        assert(!may_ask(true, 71999999));
        assert(may_ask(true, 72000000));
        assert(ASK_EVERY_MS < ANSWER_WAIT_MS + TICK_MS);
        assert(TICK_MS == 300000);
        assert(TICK_MS < ASK_EVERY_MS);
    }

    test "nothing is posted without a yes" {
        assert(posts("allowed"));
        assert(!posts("denied"));
        assert(!posts("expired"));
        assert(!posts("pending"));
        assert(ASK_NEEDS_YES);
    }

    test "a decline is real only if the approval was decided" {
        assert(decline_is_real("denied"));
        assert(!decline_is_real("expired"));
        assert(!decline_is_real("pending"));
        assert(!decline_is_real("allowed"));
    }

    test "the page leaving the form is the receipt" {
        assert(left_the_form("https://x.com/intent/post", "https://x.com/home"));
        assert(!left_the_form("https://x.com/intent/post", "https://x.com/intent/post"));
        assert(!left_the_form("", "https://x.com/home"));
        assert(!left_the_form("https://x.com/intent/post", ""));
    }

    test "a post counts only when the profile shows it" {
        assert(counted(true, true));
        assert(!counted(true, false));
        assert(!counted(false, true));
        assert(unconfirmed(true, false));
        assert(!unconfirmed(true, true));
        assert(!unconfirmed(false, false));
    }

    test "the profile is looked at under twenty seconds" {
        assert(PROFILE_SETTLE_MS == 5000);
        assert(PROFILE_LOOK_EVERY_MS == 4000);
        assert(PROFILE_LOOKS == 4);
        assert(last_profile_look_ms() == 17000);
        assert(last_profile_look_ms() < 20000);
        assert(MATCH_CHARS == 60);
    }

    test "published somewhere means a post seen on the profile, and no error" {
        assert(published_somewhere(false, 1));
        assert(published_somewhere(false, 4));
        assert(!published_somewhere(false, 0));
        assert(!published_somewhere(true, 1));
    }

    test "the publish button is looked for about half a minute" {
        assert(FIRST_SETTLE_MS == 6000);
        assert(LOOK_EVERY_MS == 3000);
        assert(LOOKS == 8);
        assert(AFTER_CLICK_SETTLE_MS == 5000);
        assert(last_look_ms() == 27000);
        assert(LOOKS > 1);
    }

    test "the owner's queue comes first, the newest only after it" {
        assert(offerable(true, false));
        assert(!offerable(true, true));
        assert(!offerable(false, false));
        assert(!newest_goes_next(1));
        assert(newest_goes_next(0));
    }

    test "a fresh article goes first, then the owner's queue, then the newest" {
        assert(FRESH_MS == 604800000);
        assert(is_fresh(0));
        assert(is_fresh(604800000));
        assert(!is_fresh(604800001));
        assert(next_source(1, 3, 9) == "fresh");
        assert(next_source(1, 0, 1) == "fresh");
        assert(next_source(0, 2, 9) == "queue");
        assert(next_source(0, 0, 4) == "newest");
        assert(next_source(0, 0, 0) == "none");
    }

    test "a network switched off is neither asked about nor posted to" {
        assert(network_used(false));
        assert(!network_used(true));
    }

    test "the desk is live, and its posts were seen on the profile" {
        assert(RUN_LIVE);
        assert(VERSION == 4);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
