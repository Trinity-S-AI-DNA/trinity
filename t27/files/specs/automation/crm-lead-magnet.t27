// SPDX-License-Identifier: Apache-2.0
// specs/automation/crm-lead-magnet.t27 -- the CRM lead magnet: a person's own face redrawn
// as a vertical 9:16 story portrait and given away free, to show the AI assistant doing
// something for THEM before anything is sold.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/agent/crm-deliver-tool.ts
//       (the tool crm_deliver_photo, gift mode by default), src/agent/client-face.ts
//       (whose face: a photo they sent, or their avatar; the prompt's identity and framing),
//       src/kie-image.ts (editInputFor), src/agent/billing-shared.ts (the op gpt_image_edit
//       and its price).
// Consumer: the bot src/navigation/helpers/crmMenu.ts (keyboard width rule, prep label).
// Generated: `t27c gen-ts` of this file is vendored into the host as
//       apps/vibee-editor/render/src/spec/crm-lead-magnet.gen.ts. The host imports the
//       numbers below from there and never restates them; a host test fails when the
//       vendored copy and this file disagree, and runs this file's vectors against the host.
// Why a personal artefact: a generic lead magnet is content the person has seen before; a
// picture WITH THEM in it is opened, kept and forwarded. This spec fixes what the gift is,
// whose face it is drawn from, who pays for it, how the prompt is ordered so the face stays
// theirs, and how wide a keyboard row may be so the buttons can be read on a phone.
// Claim status: implemented, unit-tested, and RUN live on 2026-09-16 on the owner's own avatar
// (75 s, 6 Kie credits, a 941x1672 PNG, face kept). v2 (2026-09-27) brings the spec back to
// the code it describes: v1 still promised a text-to-image fallback the owner removed on
// 2026-09-21 ("never draw a stranger"), said the model was never run, and held a safe zone
// and a one-gift rule the host did not implement.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::crm_lead_magnet {

    pub const KIND : str = "automation";
    pub const ID : str = "crm-lead-magnet";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 2;

    // ---- What the gift is ---------------------------------------------------------------
    pub const TOOL : str = "crm_deliver_photo";
    pub const DEFAULT_MODE : str = "gift";  // gift=true unless the owner says gift=false
    pub const ASPECT_RATIO : str = "9:16";
    pub const STORY_PX : str = "1080x1920";  // the story frame the safe zone is measured on
    pub const GIFT_PX_1K : str = "941x1672";  // what 1K came back as, live 2026-09-16
    pub const TEXT_IN_IMAGE : bool = false;  // the caption carries the words, never the pixels
    pub const SECOND_GIFT : str = "crm-story-reel";  // the next free thing is the reel, not a portrait

    // ---- Whose face ---------------------------------------------------------------------
    // v2: the face is THEIRS or there is no portrait. A photo they sent, when the model names
    // one of their own and it shows one grown-up face; else their Telegram avatar; else a
    // photo of theirs that shows one grown-up face; else one short line asking for a photo.
    // Nothing is drawn from a description of a person: v1's text-to-image fallback put a
    // stranger's face under the person's name, and the owner stopped work over it.
    pub const SOURCE : str = "lead-avatar";
    pub const SOURCE_ALT : str = "sent-photo";
    pub const FALLBACK : str = "ask-for-photo";
    pub const DRAWN_WITHOUT_FACE : bool = false;
    pub const FACE_AVATAR : u8 = 0;
    pub const FACE_SENT : u8 = 1;
    pub const FACE_NONE : u8 = 2;  // the ask-for-photo card, nothing drawn or paid

    // ---- The safe zone of the story frame ----------------------------------------------
    // The app's own UI covers the top and the bottom of a story; the face and anything that
    // matters stay inside. v2: the numbers are IN the prompt, not only in a comment.
    pub const SAFE_ZONE_TOP_PCT : u8 = 14;
    pub const SAFE_ZONE_BOTTOM_PCT : u8 = 35;
    pub const SAFE_ZONE_SIDE_PCT : u8 = 6;

    // ---- Who draws it and what it costs --------------------------------------------------
    pub const MODEL : str = "gpt-image-2-5-flare-image-to-image";  // Kie; sunburst = premium tier
    pub const MODEL_ALT : str = "gpt-image-2-5-sunburst-image-to-image";
    pub const RESOLUTION : str = "1K";
    pub const KIE_INPUT_URLS_FIELD : str = "input_urls";  // nano-banana-edit uses image_urls
    pub const COST_USD : str = "0.03";  // Kie price list, 1K, read 2026-09-13
    pub const COST_MICRO_USD : u32 = 30000;
    pub const TOKEN_MICRO_USD : u32 = 5000;  // one token is half a cent
    pub const MARKUP_PCT : u32 = 200;
    pub const OP : str = "gpt_image_edit";  // the billing op the OWNER is charged
    pub const OP_TOKENS : u8 = 12;  // ceil(0.03 * 2.0 / 0.005)
    pub const PAYER : str = "owner";
    pub const RECIPIENT_CHARGED : bool = false;
    pub const CHARGE_DEFERRED : bool = false;  // the owner pays at generation, not at the press
    pub const LIVE_RUN_STATUS : str = "run-2026-09-16";

    // ---- The prompt order ---------------------------------------------------------------
    // Identity FIRST, the owner's scene second, framing last. img2img models weigh the opening
    // of the prompt most, so "the same person" goes before the scene, phrased as what to KEEP.
    pub const PROMPT_ORDER : str = "identity,scene,framing";
    pub const IDENTITY_FIRST : bool = true;

    // ---- The caption --------------------------------------------------------------------
    pub const CAPTION_ONE_LINE : bool = true;
    pub const CAPTION_HAS_NAME : bool = true;  // when the name is known
    pub const CAPTION_NAMES_MAKER : bool = true;  // "my AI assistant made this"
    pub const CAPTION_NAMES_SOURCE : bool = true;  // "from your avatar" only when it was
    pub const CAPTION_QUESTIONS : u8 = 1;  // one soft question, the CTA
    pub const CAPTION_HAS_PRICE : bool = false;
    pub const CAPTION_HAS_LINK : bool = false;
    // A caption the model writes itself is only made one line and stripped of links.
    pub const CUSTOM_CAPTION_CHECKED : str = "one-line,no-link";

    // ---- One gift per person ------------------------------------------------------------
    // v2: enforced. A portrait already given (a sent gift in the touches) is not given again:
    // the second one is a paid service (gift=false), or the second gift is the story reel.
    pub const GIFTS_PER_PERSON : u8 = 1;

    // ---- Nothing leaves without the owner's press ----------------------------------------
    pub const SENT_WITHOUT_BUTTON : bool = false;
    pub const TOUCH_KIND : str = "written";  // a gift is a touch, not a purchase
    pub const TOUCH_NOTE_PREFIX : str = "gift";  // SELLER_NOTE_PREFIXES.gift in crm-notes.ts

    // ---- The keyboard width rule --------------------------------------------------------
    // Telegram shares a row's width between its buttons; three Russian labels with an emoji
    // are cut on a phone, two are readable. Every CRM keyboard passes through `fit`.
    pub const MAX_BUTTONS_PER_ROW : u8 = 2;
    pub const HUB_ROWS : u8 = 2;  // list + overview, then sweep
    pub const PREP_LABEL_NAMES_ASPECT : bool = true;  // the prepare button says 9:16

    // Whose face the portrait is drawn from.
    fn face_for(named_sent_ok: bool, has_avatar: bool, has_sent_face: bool) -> u8 {
        if named_sent_ok {
            return FACE_SENT;
        }
        if has_avatar {
            return FACE_AVATAR;
        }
        if has_sent_face {
            return FACE_SENT;
        }
        return FACE_NONE;
    }

    // Whether this call may give a portrait away free.
    fn gift_allowed(portraits_given: u8) -> bool {
        return portraits_given < GIFTS_PER_PERSON;
    }

    // A cost in micro-dollars as tokens: ceil(cost * markup / token), the platform rule.
    fn tokens_for(cost_micro_usd: u32) -> u32 {
        return (cost_micro_usd * MARKUP_PCT / 100 + TOKEN_MICRO_USD - 1) / TOKEN_MICRO_USD;
    }

    // How many rows `fit` makes of one row of n buttons.
    fn rows_for(buttons: u8) -> u8 {
        return (buttons + MAX_BUTTONS_PER_ROW - 1) / MAX_BUTTONS_PER_ROW;
    }

    // Whether the three bands leave a central area for the face.
    fn safe_zone_leaves_room(top: u8, bottom: u8, side: u8) -> bool {
        return top + bottom < 100 && side * 2 < 100;
    }

    test "the gift is drawn from the person's own face at 9:16 and the recipient pays nothing" {
        assert(face_for(false, true, false) == FACE_AVATAR);
        assert(face_for(true, true, false) == FACE_SENT);
        assert(face_for(false, false, true) == FACE_SENT);
        assert(ASPECT_RATIO == "9:16");
        assert(PAYER == "owner");
        assert(!RECIPIENT_CHARGED);
        assert(!CHARGE_DEFERRED);
        assert(!TEXT_IN_IMAGE);
    }

    test "with no face of theirs nothing is drawn: one line asks for a photo" {
        assert(face_for(false, false, false) == FACE_NONE);
        assert(!DRAWN_WITHOUT_FACE);
        assert(FALLBACK == "ask-for-photo");
    }

    test "one portrait per person is a gift; the second is paid, or the reel" {
        assert(GIFTS_PER_PERSON == 1);
        assert(gift_allowed(0));
        assert(!gift_allowed(1));
        assert(!gift_allowed(2));
        assert(SECOND_GIFT == "crm-story-reel");
    }

    test "the caption names the person, the maker and the source, asks once, sells nothing" {
        assert(CAPTION_ONE_LINE);
        assert(CAPTION_HAS_NAME);
        assert(CAPTION_NAMES_MAKER);
        assert(CAPTION_NAMES_SOURCE);
        assert(CAPTION_QUESTIONS == 1);
        assert(!CAPTION_HAS_PRICE);
        assert(!CAPTION_HAS_LINK);
    }

    test "the safe zone leaves the centre for the face" {
        assert(safe_zone_leaves_room(SAFE_ZONE_TOP_PCT, SAFE_ZONE_BOTTOM_PCT, SAFE_ZONE_SIDE_PCT));
        assert(!safe_zone_leaves_room(50, 50, SAFE_ZONE_SIDE_PCT));
        assert(SAFE_ZONE_TOP_PCT < SAFE_ZONE_BOTTOM_PCT);
    }

    test "a row of three is split; a row of two stands" {
        assert(rows_for(3) == 2);
        assert(rows_for(2) == 1);
        assert(rows_for(1) == 1);
        assert(rows_for(4) == 2);
        assert(PREP_LABEL_NAMES_ASPECT);
    }

    test "the price is the Kie 1K price with the platform markup, and it was run live" {
        assert(tokens_for(COST_MICRO_USD) == 12);
        assert(OP_TOKENS == 12);
        assert(tokens_for(20000) == 8);
        assert(tokens_for(3000) == 2);
        assert(LIVE_RUN_STATUS == "run-2026-09-16");
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
