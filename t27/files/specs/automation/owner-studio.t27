// SPDX-License-Identifier: Apache-2.0
// specs/automation/owner-studio.t27 -- the STUDIO step before a talking reel: one real photo
// of a person, redrawn photorealistic in a ready-made studio, so the talking avatar starts
// from a frame worth watching instead of a bedroom.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/kie-image.ts (editImage, the
//       gpt-image-2-5 contract), the talking leg lipsync_generate (owner-noir-reel skill).
// Order of a reel: STUDIO (this spec) -> voice -> lipsync. The studio frame is the face_url
//       the reel is cut from; a reel never starts from the raw phone photo.
// Providers: Kie is primary (owner, 2026-10-02: "Kie is primary now, the others are secondary").
//       The fallback is nano-banana-edit, also on Kie. Nothing off Kie is called by this step.
// Claim status: plan + first run. The prompts below were run on the owner's own photo
//       2026-10-02 (three studios, gpt-image-2-5 flare, 1K); the host tool that serves them
//       to every client is NOT written yet.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::owner_studio {

    pub const KIND : str = "automation";
    pub const ID : str = "owner-studio";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 1;

    // ---- Where it runs ------------------------------------------------------------------
    pub const PROVIDER : str = "kie";
    pub const MODEL : str = "gpt-image-2-5-flare-image-to-image";
    pub const MODEL_FALLBACK : str = "google/nano-banana-edit";
    pub const RESOLUTION : str = "1K";  // $0.03 a frame, the lead-magnet tier
    pub const ASPECT_RATIO : str = "9:16";
    pub const CREDITS_PER_FRAME : u8 = 6;  // measured on the lead magnet 2026-09-16

    // ---- What the source must be --------------------------------------------------------
    // Letterbox bars (a phone screenshot of a video) are cropped BEFORE the edit: the model
    // keeps black bars as part of the scene and the reel then carries them.
    pub const CROP_LETTERBOX : bool = true;
    pub const ONE_FACE : bool = true;
    pub const TEXT_IN_IMAGE : bool = false;

    // ---- The identity lock: first in every prompt ---------------------------------------
    // The face is the reason the frame exists. It goes first so the scene cannot outvote it,
    // and it names the mouth: a talking avatar needs lips the microphone does not cover.
    pub const IDENTITY : str = "Keep this exact man: same face, same bald head, same beard and moustache, same blue-grey eyes, same expression, same red leopard-print shirt and black fingerless glove, same handheld microphone held below the mouth so the lips stay fully visible. Do not beautify, do not change age, do not change face shape. Photorealistic, real skin texture, shot on a full-frame camera, 50mm, shallow depth of field. Vertical 9:16, he sits centred, face in the upper third, no text, no logos, no watermark.";

    // ---- The studios: ready-made, picked by number ---------------------------------------
    pub const STUDIO_COUNT : u8 = 3;
    // The studio a talking reel starts from when nobody picks one (owner, 2026-10-02).
    pub const DEFAULT_STUDIO : str = "lab";

    pub const STUDIO_1_ID : str = "noir";
    pub const STUDIO_1 : str = "Move him into a dark noir podcast studio: matte black acoustic walls, one warm golden key light from the left carving his face, soft rim light on the head, a single small downward-pointing gold triangle glowing on the wall behind him, a black leather chair, thin haze in the air. Mood: late-night interview, cinematic, high contrast.";

    pub const STUDIO_2_ID : str = "lab";
    pub const STUDIO_2 : str = "Move him into a hardware engineer's studio at night: FPGA development boards with blinking LEDs on the desk, an oscilloscope showing a green waveform, racks of cables, deep blue and magenta practical lights, a large monitor glowing with circuit schematics out of focus behind him. Mood: maker channel, futuristic but real.";

    pub const STUDIO_3_ID : str = "broadcast";
    pub const STUDIO_3 : str = "Move him into a premium broadcast podcast studio: walnut wood slat walls, hexagonal acoustic panels, a professional boom arm and studio monitors, warm tungsten practical lamps, a softbox key light, a city skyline at dusk through a large window behind him, out of focus. Mood: top-tier talk show, clean and expensive.";

    pub fn studio_prompt_len_ok(n : u32) -> bool {
        return n <= 20000;  // gpt-image-2-5 input.prompt limit
    }

    test "three ready studios, the bars cropped first and no text drawn" {
        assert(STUDIO_COUNT == 3);
        assert(CROP_LETTERBOX);
        assert(!TEXT_IN_IMAGE);
        assert(ONE_FACE);
        assert(DEFAULT_STUDIO == STUDIO_2_ID);
    }

    test "the identity and any studio together fit the model's prompt" {
        assert(studio_prompt_len_ok(1200));
        assert(!studio_prompt_len_ok(20001));
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
