// SPDX-License-Identifier: Apache-2.0
// specs/automation/social-api.t27 -- LinkedIn and X as API connectors of the blog desk:
// the owner connects each network once (OAuth), and an approved article is posted
// through the network's own API instead of a press in a browser that may be signed out.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/agent/social-api.ts (the two
//       OAuth flows, the X refresh, the two publishes and their receipts) beside
//       src/agent/meta-connect.ts (meta-connect.t27: the shared token table, the sealing,
//       the single-use state, route() and posted(), which this spec does not restate).
// Why: the desk shares to LinkedIn and X by filling a share page and pressing its
//       button. A signed-out browser or a moved button is no post, and the press itself
//       is no receipt; the API returns the post's own id.
// LinkedIn (Posts API, "Share on LinkedIn" product, scope w_member_social): a 60-day
//       access token, and no refresh token outside LinkedIn's partner programme -- so
//       the owner reconnects, and is told so a week before.
// X (API v2, OAuth 2.0 Authorization Code with PKCE, scope offline.access): a two-hour
//       access token and a refresh token that is REPLACED on every refresh; keeping the
//       old one loses the connection at the next refresh.
// Measured from the networks' documentation, 2026-10-02: X counts 280 weighted
//       characters, every link as 23 (t.co), Latin and Cyrillic as 1, emoji as 2;
//       LinkedIn's commentary holds 3000 characters; a PKCE verifier is 43 to 128.
// UI words (the owner reads Russian) stay in the host; the spec holds the rules.
// Claim status: written before any token exists; nothing has been posted through it.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::social_api {

    pub const KIND : str = "automation";
    pub const ID : str = "social-api";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 1;

    // ---- Each network's own limits --------------------------------------------------
    pub const X_TEXT_MAX : u16 = 280;  // weighted characters of one post
    pub const X_URL_WEIGHT : u8 = 23;  // any link, whatever its length (t.co)
    pub const X_LINK_GAP : u8 = 2;  // the blank line between the title and its link
    pub const LI_TEXT_MAX : u16 = 3000;  // characters of a LinkedIn post's commentary

    // ---- Tokens ---------------------------------------------------------------------
    pub const LI_TOKEN_DAYS : u8 = 60;  // a LinkedIn member token's lifetime
    pub const LI_REFRESHES : bool = false;  // no refresh token for an ordinary app
    pub const LI_WARN_DAYS_LEFT : u8 = 7;  // the owner is told to reconnect this early
    pub const X_TOKEN_S : u16 = 7200;  // an X access token lives two hours
    pub const X_REFRESH_BEFORE_S : u16 = 300;  // refreshed when this little is left
    pub const X_REFRESH_ROTATES : bool = true;  // every refresh issues a new refresh token
    pub const PKCE_MIN : u8 = 43;  // shortest PKCE code verifier (RFC 7636)
    pub const PKCE_MAX : u8 = 128;  // longest PKCE code verifier
    pub const TOKEN_LEAVES_SERVER : bool = false;  // never in a reply, a log or an error
    pub const ASK_NEEDS_YES : bool = true;  // the desk's own yes still comes first

    // ---- Not claimed ----------------------------------------------------------------
    pub const RUN_LIVE : bool = false;  // flips when a post returns its id in production

    // X's weighted length of a post: its plain characters plus 23 for each link.
    fn x_weight(plain: u16, links: u8) -> u16 {
        return plain + links * X_URL_WEIGHT;
    }

    // A post fits X when its weighted length is within the limit.
    fn x_fits(plain: u16, links: u8) -> bool {
        return x_weight(plain, links) <= X_TEXT_MAX;
    }

    // Room for the title in a post of a title, a blank line and one link.
    fn x_title_room() -> u16 {
        return X_TEXT_MAX - X_URL_WEIGHT - X_LINK_GAP;
    }

    // An X token is refreshed before it ends, not after a post has failed on it.
    fn x_refresh_due(seconds_left: u16) -> bool {
        return seconds_left < X_REFRESH_BEFORE_S;
    }

    // A LinkedIn token is usable while it has days left; it cannot be refreshed.
    fn li_usable(days_left: u8) -> bool {
        return days_left > 0;
    }

    // The owner is told to reconnect LinkedIn while there is still time to.
    fn li_reconnect_soon(days_left: u8) -> bool {
        return days_left > 0 && days_left <= LI_WARN_DAYS_LEFT;
    }

    // A PKCE verifier is within RFC 7636's length.
    fn verifier_ok(len: u8) -> bool {
        return len >= PKCE_MIN && len <= PKCE_MAX;
    }

    test "a link weighs 23 on X whatever its length" {
        assert(x_weight(0, 1) == 23);
        assert(x_weight(100, 1) == 123);
        assert(x_weight(10, 2) == 56);
    }

    test "a post fits X within 280 weighted characters" {
        assert(x_fits(257, 1));
        assert(!x_fits(258, 1));
        assert(x_fits(280, 0));
        assert(!x_fits(281, 0));
    }

    test "a title, a blank line and a link leave 255 for the title" {
        assert(x_title_room() == 255);
        assert(x_fits(x_title_room() + X_LINK_GAP, 1));
        assert(!x_fits(x_title_room() + X_LINK_GAP + 1, 1));
    }

    test "an X token is refreshed in its last five minutes" {
        assert(x_refresh_due(0));
        assert(x_refresh_due(299));
        assert(!x_refresh_due(300));
        assert(!x_refresh_due(X_TOKEN_S));
        assert(X_REFRESH_ROTATES);
    }

    test "a LinkedIn token lasts sixty days and is never refreshed" {
        assert(li_usable(1));
        assert(!li_usable(0));
        assert(LI_TOKEN_DAYS == 60);
        assert(!LI_REFRESHES);
    }

    test "the owner hears about LinkedIn a week before it ends" {
        assert(li_reconnect_soon(7));
        assert(li_reconnect_soon(1));
        assert(!li_reconnect_soon(8));
        assert(!li_reconnect_soon(0));
        assert(LI_WARN_DAYS_LEFT < LI_TOKEN_DAYS);
    }

    test "a PKCE verifier is 43 to 128 characters" {
        assert(verifier_ok(43));
        assert(verifier_ok(128));
        assert(!verifier_ok(42));
        assert(!verifier_ok(129));
    }

    test "LinkedIn holds far more than X" {
        assert(X_TEXT_MAX < LI_TEXT_MAX);
    }

    test "the token never leaves the server and nothing posts without a yes" {
        assert(!TOKEN_LEAVES_SERVER);
        assert(ASK_NEEDS_YES);
    }

    test "nothing has been posted through it yet" {
        assert(!RUN_LIVE);
        assert(VERSION == 1);
    }
}
// phi^2 + 1/phi^2 = 3 | TRINITY
