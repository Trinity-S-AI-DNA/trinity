// SPDX-License-Identifier: Apache-2.0
// specs/automation/bot-topic-tabs.t27 -- the fixed tabs of a person's private chat with the bot.
// Host: 999-multibots-telegraf src/navigation/topics/ (tabs.ts, threads.ts, wire.ts).
// Trace: 999-multibots-telegraf PR #3544, owner 2026-10-07 "move the tab table and its rules
// into a .t27 spec that the host imports".
// Generated: t27c gen-ts; vendored spec and generated constants in src/spec/.
// Claim status: routing contract. Telegram (Bot API 9.3/9.4) shows private-chat topics as a
// column of tabs; this spec says which tabs the bot makes, in what order and colour, how a
// second /start or /tabs stays idempotent, and when a send is aimed into a tab.
// Interface text (the Russian titles, the intros) stays in the host; the table here holds
// the key, the English title, the emoji as a code point, the icon colour and the app route.
// v1 (2026-10-07): the six tabs, the topic-name bound, the icon colours Telegram accepts,
// the idempotent make, the claim, the thread injection and the cached lookup.
// v2 (2026-10-07): a slow maker settles only its own claim and deletes the topic it made
// when the claim was taken; no topic is named while a tab is being made; /tabs probes the
// topic itself (editForumTopic, no change); a person's tabs are set up remotely only by
// that person or a keeper.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::bot_topic_tabs {
    pub const KIND : str = "automation";
    pub const ID : str = "bot-topic-tabs";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 2;

    // ---- the table, in the order of the tab column ----

    pub const TAB_COUNT : u32 = 6;
    pub const TAB_KEYS : [6]str = ["agent", "reels", "browser", "mybot", "wallet", "hive"];
    pub const TAB_TITLES_EN : [6]str = ["Agent", "Reels", "Browser", "My bot", "Balance & club", "Hive"];
    // Unicode code points of the emoji that opens each title:
    // robot face, clapper board, globe Europe-Africa, hammer and wrench, money bag, honeybee.
    pub const TAB_EMOJI : [6]u32 = [129302, 127916, 127757, 128736, 128176, 128029];
    pub const TAB_COLORS : [6]u32 = [7322096, 16749490, 9367192, 16766590, 16478047, 13338331];
    // The mini-app screen each tab's first message opens (host appLinks.ts APP_ROUTES).
    pub const TAB_ROUTES : [6]str = ["chat", "story", "browser", "profile", "club", "hive"];

    // The only icon colours createForumTopic accepts (Bot API): any other value is refused,
    // and the tab is never made.
    pub const ICON_COLOR_COUNT : u32 = 6;
    pub const ICON_COLORS : [6]u32 = [7322096, 16766590, 13338331, 9367192, 16749490, 16478047];

    fn color_allowed(c: u32) -> bool {
        for i in 0..ICON_COLOR_COUNT {
            if ICON_COLORS[i] == c { return true; }
        }
        return false;
    }

    // Every tab of the table wears a colour Telegram accepts.
    fn table_colors_allowed() -> bool {
        for i in 0..TAB_COUNT {
            if !color_allowed(TAB_COLORS[i]) { return false; }
        }
        return true;
    }

    // Two tabs of one colour read as one tab in the column.
    fn table_colors_distinct() -> bool {
        for i in 0..TAB_COUNT {
            for j in 0..TAB_COUNT {
                if i != j && TAB_COLORS[i] == TAB_COLORS[j] { return false; }
            }
        }
        return true;
    }

    // ---- names ----

    // A topic name the bot writes: at most this many characters (Telegram allows 128,
    // the tab column shows far fewer). Applies to the fixed titles in every language
    // and to the name taken from the first message of a person's own topic.
    pub const TOPIC_NAME_MAX : u32 = 32;
    pub const TELEGRAM_TOPIC_NAME_MAX : u32 = 128;

    // Length of the name made from a first message of `chars` characters: kept whole when
    // it fits, otherwise cut to one less than the bound and closed with an ellipsis.
    fn topic_name_len(chars: u32) -> u32 {
        if chars <= TOPIC_NAME_MAX { return chars; }
        return TOPIC_NAME_MAX;
    }

    fn name_fits(chars: u32) -> bool {
        return chars > 0 && chars <= TOPIC_NAME_MAX;
    }

    // ---- making the tabs ----

    // A fixed tab is made only when no row names it, or when Telegram says its thread is
    // gone. A stored tab that is alive is never made again: /tabs twice makes nothing.
    fn make_tab(stored: bool, alive: bool) -> bool {
        return !stored || !alive;
    }

    // /tabs asks Telegram about each stored tab with this method, naming only the chat and
    // the thread: an edit that changes nothing, so it must find the topic. Telegram has no
    // getForumTopic, and a chat action was accepted for threads that no longer existed.
    // Known limit: the Bot API does not document the answer for a deleted topic; an answer
    // other than "thread not found" keeps the tab.
    pub const PROBE_METHOD : str = "editForumTopic";

    // A stored tab is forgotten only on Telegram's own word that the thread is missing.
    // A network error or a rate limit says nothing about the tab and forgets nothing.
    fn forget_row(probe_failed: bool, thread_missing: bool) -> bool {
        return probe_failed && thread_missing;
    }

    // Two /start in a row race each other. Before createForumTopic the bot inserts a claim
    // row for the tab; the UNIQUE (bot, person, key) of fixed tabs lets one insert in, and
    // only the one whose insert landed makes the tab.
    fn claim_won(inserted_rows: u32) -> bool {
        return inserted_rows == 1;
    }

    // Each attempt claims under an id of its own, and turns its claim into the tab only if
    // that very row is still there (one row updated). A maker slower than CLAIM_STALE_MS
    // whose claim was dropped and taken by another finds no row: it keeps nothing and
    // deletes the topic it just made, so the person sees one tab, not two.
    fn settle_won(updated_rows: u32) -> bool {
        return updated_rows == 1;
    }

    // A claim whose maker died (a crash between claim and create) blocks the tab forever
    // unless it expires; after this long it is dropped and the tab may be made again.
    pub const CLAIM_STALE_MS : u32 = 120000;
    fn claim_stale(age_ms: u32) -> bool {
        return age_ms >= CLAIM_STALE_MS;
    }

    // The first message of a topic the PERSON opened names it. A topic any row knows (a
    // fixed tab, a claim, a topic already named) is never renamed, nor one opened by a
    // command, nor one whose Telegram name is a fixed tab's. While a fresh claim of the
    // person's is pending, an unknown thread may be the tab being made right now (its row
    // does not name it yet), so nothing is named until the claim settles or goes stale.
    fn may_rename(known: bool, fixed_name: bool, is_command: bool, claim_pending: bool) -> bool {
        return !known && !fixed_name && !is_command && !claim_pending;
    }

    // ---- setting the tabs up from outside the chat ----

    // An agent may read or make a person's tabs without that person pressing /start. Its
    // own tabs any caller may; somebody else's only a keeper (the platform owner or a
    // hive keeper), because making a tab writes into that person's chat.
    fn may_set_up(own: bool, keeper: bool) -> bool {
        return own || keeper;
    }

    // ---- answering into the tab ----

    // A send gets the tab's thread only when it is a send that accepts one, aimed at this
    // same chat, not a business-connection send, and it did not name a thread itself --
    // and naming means the key is present, even with the value null.
    fn inject_thread(threaded_method: bool, same_chat: bool, key_present: bool, business: bool) -> bool {
        return threaded_method && same_chat && !key_present && !business;
    }

    // ---- reading the tabs ----

    // The person's rows are read from the database once and then kept in memory; a make,
    // a claim or a forget drops the person's entry. A message in a tab costs no read.
    pub const TAB_CACHE_MAX : u32 = 5000;
    fn reads_db(cached: bool) -> bool {
        return !cached;
    }

    // At the cap the oldest person is dropped before a new one is kept.
    fn evicts(entries: u32) -> bool {
        return entries >= TAB_CACHE_MAX;
    }

    // ---- tests ----

    test "the table has six tabs, each in a colour Telegram accepts, no two alike" {
        assert(TAB_COUNT == 6);
        assert(table_colors_allowed());
        assert(table_colors_distinct());
        assert(color_allowed(7322096));
        assert(color_allowed(16478047));
        assert(!color_allowed(9363846));
        assert(!color_allowed(7545565));
        assert(!color_allowed(0));
    }

    test "a topic name is at most thirty-two characters" {
        assert(topic_name_len(1) == 1);
        assert(topic_name_len(32) == 32);
        assert(topic_name_len(33) == 32);
        assert(topic_name_len(500) == 32);
        assert(name_fits(32));
        assert(!name_fits(33));
        assert(!name_fits(0));
        assert(TOPIC_NAME_MAX < TELEGRAM_TOPIC_NAME_MAX);
    }

    test "a stored tab that is alive is never made again" {
        assert(!make_tab(true, true));
        assert(make_tab(true, false));
        assert(make_tab(false, true));
        assert(make_tab(false, false));
    }

    test "a tab is forgotten only when Telegram says its thread is missing" {
        assert(forget_row(true, true));
        assert(!forget_row(true, false));
        assert(!forget_row(false, false));
        assert(!forget_row(false, true));
    }

    test "only the claim that landed makes the tab, and a dead claim expires" {
        assert(claim_won(1));
        assert(!claim_won(0));
        assert(!claim_stale(0));
        assert(!claim_stale(119999));
        assert(claim_stale(120000));
    }

    test "only a person's own unknown topic is named from its first message" {
        assert(may_rename(false, false, false, false));
        assert(!may_rename(true, false, false, false));
        assert(!may_rename(false, true, false, false));
        assert(!may_rename(false, false, true, false));
    }

    test "no topic is named while one of the person's tabs is being made" {
        assert(!may_rename(false, false, false, true));
        assert(!may_rename(true, false, false, true));
    }

    test "a slow maker whose claim was taken keeps nothing and deletes its topic" {
        assert(settle_won(1));
        assert(!settle_won(0));
        assert(!settle_won(2));
    }

    test "a person's tabs are set up by that person or a keeper" {
        assert(may_set_up(true, false));
        assert(may_set_up(false, true));
        assert(may_set_up(true, true));
        assert(!may_set_up(false, false));
    }

    test "a send named its own thread, even null, keeps it" {
        assert(inject_thread(true, true, false, false));
        assert(!inject_thread(true, true, true, false));
        assert(!inject_thread(false, true, false, false));
        assert(!inject_thread(true, false, false, false));
        assert(!inject_thread(true, true, false, true));
    }

    test "a message in a known tab costs no database read" {
        assert(!reads_db(true));
        assert(reads_db(false));
        assert(!evicts(4999));
        assert(evicts(5000));
    }

    test "VERSION says what the header's last note says" {
        assert(VERSION == 2);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
