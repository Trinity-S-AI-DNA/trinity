// SPDX-License-Identifier: Apache-2.0
// specs/automation/split-reel.t27 -- the split talking-head reel: b-roll on top, the person
// talking below, one yellow word at a time on the seam, hard cuts on a fixed rhythm.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/split-reel-plan.ts (segments and
//       props for the Remotion composition SplitTalkingHead), src/agent/reel-analyze.ts (the
//       tool reel_analyze: a reference reel in, this spec's shape out), src/agent/split-reel-tool.ts
//       (the tool split_reel: whose reel it is, its voice and its call), src/agent/tools.ts
//       audio_generate and src/agent/voice-clone-speak.ts (the owner's voice, his reels only).
//       src/compositions/SplitTalkingHead.tsx draws the call with StoryReel.tsx CallToAction,
//       in the colour this spec decides (v10).
// Generated: `t27c gen-ts` of this file is vendored as
//       apps/vibee-editor/render/src/spec/split-reel.gen.ts; the host imports the numbers.
// Measured on a reference reel 2026-10-02 (720x1280, 30 fps, 14.97 s): cuts at 1.9, 5.9, 7.4,
//       11.4, 12.9, 14.7 s, the same in both halves. That is full 57, split 120, full 45,
//       split 120, full 45, split 54, full to the end: the rhythm this spec fixes.
// Order of a reel: STUDIO (owner-studio.t27, the face) -> voice (the person's own: their
//       voice notes cut on pauses; Kie has no speech cloning, Replicate is off)
//       -> lipsync (Kie, primary) -> b-roll stills (Kie) -> Remotion SplitTalkingHead.
// Claim status: two reels rendered from it on 2026-10-02, both on Kie, both with the owner's
//       real voice notes cut on their pauses. His trained clone (MiniMax, made on Replicate)
//       cannot speak: Replicate has no balance and is off (owner, 2026-10-02), and Kie has
//       no speech cloning (every clone model name answers 422).
// v7 (2026-10-04): a reel the house did not order carries no mark of the house's -- not its
//       bot as the call at the end, not the owner's voice, not a house name the agent or a
//       template put into its words; words the person wrote herself stand. Every refusal
//       comes before the charge, so a refused call costs nothing and nothing is refunded.
//       A rule, not a measurement: no reel rendered under it yet.
// v8 (2026-10-04): every voice decision comes before the charge. An ordinary caller (not the
//       house) who named no voice and had no clone of her own was charged, then given the
//       first custom voice in the house's ElevenLabs account, else its first library voice --
//       a voice not hers, possibly the owner's own, from a provider the house no longer
//       calls (Kie is the provider). She is now refused before the charge and asked for a
//       voice_id or her own clone. And split_reel paid for a new voice before learning it
//       ran past SPEECH_MAX_SECONDS; its length is now estimated from its text first, at
//       MS_PER_CHAR, measured on the one voice in the host repo with word times. That pace
//       is one voice's, so a slower voice can pass the estimate and still be measured past
//       the ceiling once it exists: the one refusal that comes after the charge. That voice
//       is given back, once, at exactly that refusal (REFUND_TOO_LONG_VOICE). A rule and
//       one measurement: no reel rendered under it yet.
// v9 (2026-10-04): each voice is held to its own slowest measured pace before it is paid
//       (PACE_PER_VOICE). v8 judged every text at MS_PER_CHAR, the owner's pace, so a slower
//       voice was charged, measured too long and given back on every reel it was asked
//       for. split_reel now keeps, on the clone's own row, the slowest pace each voice
//       was ever measured at, and judges the next text at the slower of that and
//       MS_PER_CHAR. A text is counted in speech units: a digit (read as a word) and a
//       letter of a script that writes a syllable or a word per character (Han, kana,
//       Hangul) weigh more than a Latin or Cyrillic letter. A voice's first reel, and a
//       voice slower than its own slowest, still meet the backstop and its refund.
//       A measurement lands on the measured voice's own row and nowhere else: another
//       voice -- another client's, another seller's, one never measured -- keeps what it
//       had (PACE_ON_OTHER_VOICES). A rule, not a measurement: no voice measured under it yet.
// v10 (2026-10-04): a reel that is not the house's own is no longer called in the house's
//       gold. Until v10 the composition drew every call in HOUSE_CALL_COLOR, whoever the
//       reel was for, and no road passed it another colour: v7 took the house's words off
//       a client's call and left its look on. The call's colour now comes from the same
//       places as its words, by the same rule (cta_for): the colour the order gave, unless
//       it is the house's gold on a reel that is not the house's; on the house's own reel
//       the house's gold; else her own -- the palette the seller keeps for her, else her
//       profile's; else NEUTRAL_CALL_COLOR. A colour the order gave that does not read on
//       the scrim under the call is refused before the charge, with the shade of it that
//       reads; hers is drawn in that shade. A rule, not a measurement: no reel rendered
//       under it yet.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::split_reel {

    pub const KIND : str = "automation";
    pub const ID : str = "split-reel";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 10;

    // ---- Where it is drawn --------------------------------------------------------------
    pub const COMPOSITION : str = "SplitTalkingHead";
    pub const FACE_SPEC : str = "owner-studio";  // the face is a studio frame, never a raw photo
    pub const LIPSYNC_MODEL : str = "kie/kling/ai-avatar-standard";
    pub const BROLL_MODEL : str = "gpt-image-2-5-flare-image-to-image";
    pub const OWN_VOICE : bool = true;  // the person's own voice; a stock voice is not their reel

    // ---- The rhythm, in frames at 30 fps -------------------------------------------------
    pub const FPS : u32 = 30;
    pub const OPEN_FULL_FRAMES : u32 = 60;  // the face first, measured 57
    pub const SPLIT_FRAMES : u32 = 120;  // b-roll on top, measured 120 twice
    pub const FULL_FRAMES : u32 = 45;  // back to the face, measured 45 twice
    pub const MAX_SECONDS : u32 = 15;
    // No shot shorter than a second. The voice decides where the reel ends, and a
    // 13.35 s voice left an 11-frame split at the end: a flash of b-roll nobody can
    // read. A tail that short joins the shot before it.
    pub const MIN_SHOT_FRAMES : u32 = 30;
    pub const SPLIT_PCT : u32 = 50;  // the seam sits in the middle
    // The talking head FILLS the lower half of a split, as in the reference. The
    // composition's own default is a 25% circle on black: the first reel rendered
    // from this spec (2026-10-02) came out that way and nobody could see the face.
    pub const FACE_FILLS_HALF : bool = true;

    // ---- The face in its window -----------------------------------------------------------
    // The face is CENTRED in the window it is shown in, and the head is never cut.
    // Reel 2 (2026-10-02): the lower half of a split showed the MIDDLE of a 9:16
    // lipsync, so the top of the head sat on the seam and the face sat low. The
    // composition is told where to aim (object-position), computed from where the
    // face is in the source: measured, or the studio's own place when unmeasured.
    pub const FACE_CENTER_X_PCT : u32 = 50;  // the face's centre, across the window
    pub const FACE_CENTER_Y_PCT : u32 = 50;  // and down it: the middle, as the owner asked
    // Where an owner-studio frame puts the face when nothing was measured: studio-lab
    // on the Kie lipsync (2026-10-02, 8 frames, Haar): centre at 48% across and 28%
    // down, the face box 21% of the height. Under a 50% split that face starts 50 px
    // below the seam -- the forehead and hair were above it.
    pub const STUDIO_FACE_X_PCT : u32 = 48;
    pub const STUDIO_FACE_Y_PCT : u32 = 28;
    // What the analyser (tri reel-check) calls a defect.
    pub const HEADROOM_MIN_PCT : u32 = 3;  // space above the skull, % of the window height
    pub const FACE_OFF_CENTER_MAX_PCT : u32 = 10;  // centre drift, % of the window side
    // v6 (reel 1, 2026-10-02): a big face centred in a split loses its skull to the
    // seam -- the Haar box was 49% of the 960 px half, so the middle left 0% above it.
    // Such a face is aimed lower, by no more than the drift allowed, until the skull
    // (one box above the centre: half a box to the brow, half again to the crown)
    // has HEADROOM_AIM_PCT above it. Twice the minimum, so a wobble between frames
    // does not cut it.
    pub const HEADROOM_AIM_PCT : u32 = 6;

    // ---- The words ------------------------------------------------------------------------
    pub const CAPTION_COLOR : str = "#FFFF00";
    pub const WORDS_PER_CAPTION : u32 = 1;
    pub const TEXT_IN_BROLL : bool = false;  // captions carry the words, never the pictures
    // Each caption is a word of the FINAL voice -- the file the reel plays -- with that
    // word's own time. Reel 2 (2026-10-02) carried captions over from the uncut voice
    // notes: 5 of 28 were 200-800 ms off and 8 showed words that are not in the cut.
    pub const CAPTIONS_FROM_FINAL_VOICE : bool = true;
    pub const CAPTION_DRIFT_MAX_MS : u32 = 150;  // tri reel-check calls more a defect
    // A word starts where the SOUND starts. Whisper stretches the start of a word that
    // follows a pause back into the pause: on reel 2 v3 the word "i" was given 5720 ms, is
    // heard at 6320, so its caption sat on silence for 0.6 s. The planner moves each
    // start to the first speech frame inside the word; speech is a 10 ms frame within
    // SPEECH_BELOW_LOUD_DB of the loud level (the 95th percentile of the voice).
    pub const ONSET_FRAME_MS : u32 = 10;
    pub const SPEECH_BELOW_LOUD_DB : u32 = 30;
    // A caption is late or early only against the sound itself: tri reel-check also
    // asks whether the audio is speech within this long after the caption appears.
    pub const CAPTION_ON_SILENCE_MAX_MS : u32 = 150;

    // v5 (owner, 2026-10-02: "at the end we do a CTA, study the templates"). The split
    // template declared ctaText and never drew it, so a split reel ended on the last
    // word. The canon is StoryReel's (crm-story-reel.t27 PAUSE_SEC): after the voice the
    // last frame is held, silent, while the call to action stands on screen. A host test
    // holds this pause equal to that one: one pause for every reel template.
    pub const CTA_PAUSE_SEC : u32 = 3;
    pub const CTA_ALWAYS : bool = true;  // a reel without a call is not delivered
    pub const OWNER_CTA : str = "@t27ai_bot";  // the house's own reel only (v7)
    // The voice may run to MAX_SECONDS minus the pause: the whole reel stays inside it.
    pub const SPEECH_MAX_SECONDS : u32 = 12;

    // ---- Whose reel it is -------------------------------------------------------------------
    // v7 (owner, 2026-10-03: "why does it make the CTA mine and not the client's? what a
    // mess"). A reel ordered for a client ended on OWNER_CTA: the planner fell back to it
    // whenever no call was written, and the order named none. The owner's voice and the
    // bot's spoken name leaked the same way: both were applied to every reel of the house.
    //
    // A reel is the HOUSE'S OWN only when the house orders it and nobody else is named on
    // the turn: no client the turn speaks with, no lead the order is for, and no unattended
    // sweep (a sweep works for leads only, as image_edit already holds for the owner's
    // face). A seller who is not the house orders reels of her own, not the house's. Every
    // other reel is a client's, and carries the client's marks:
    //   the call   -- the one the order wrote, unless it names the house; else the call in
    //                 the client's own profile; else a neutral call with no name in it.
    //                 OWNER_CTA is the house's own reel's, and nobody else's.
    //   the voice  -- the client's own clone; never the owner's clone or sample. With no
    //                 clone of hers the voice is refused.
    //   the words  -- no house name the agent or a template put there: no OWNER_CTA, no
    //                 spoken brand name. Words the person wrote or spoke herself stand --
    //                 the owner refused the house's CALL and VOICE on a reel made for
    //                 somebody, not every mention of the product in her own script.
    // The texts of the neutral call and of the refusals are interface copy: the host's.
    pub const CTA_GIVEN : u8 = 1;  // the call the order wrote
    pub const CTA_CLIENT : u8 = 2;  // the call in the client's own profile
    pub const CTA_NEUTRAL : u8 = 3;  // a call with no name in it
    pub const CTA_OWNER : u8 = 4;  // OWNER_CTA
    pub const OWNER_VOICE_ON_CLIENT_REEL : bool = false;
    pub const AGENT_HOUSE_NAME_ON_CLIENT_REEL : bool = false;
    // Every refusal above -- another client's reel, a house name the agent put in, a voice
    // nobody may lend -- is decided before the first paid step (the voice's own charge, or
    // the first paid tool the reel calls). A refused call takes nothing, so none of these
    // charges and then refuses, and none has a refund to promise. One refusal cannot be
    // decided before the charge: a new voice measured past SPEECH_MAX_SECONDS once it exists
    // (v8, below). It comes AFTER the charge, so "nothing to refund" does not cover it:
    // that voice is given back (REFUND_TOO_LONG_VOICE). A provider that fails AFTER the
    // charge is a failure, not a refusal: its refund is the host's, not this rule.
    pub const REFUSED_BEFORE_SPEND : bool = true;

    // ---- Every voice decision before the charge (v8) --------------------------------------
    // A caller who is not the house, names no voice and has no clone of her own has no voice
    // to speak in. There is no stock voice to give her: OWN_VOICE holds, and the one stock
    // voice the host could reach was the first voice of the house's own ElevenLabs account
    // (a provider the house no longer calls) -- a voice not hers, possibly the owner's. So
    // she is refused, before the charge, and asked for a voice_id or her own clone. The
    // house with no voice keeps its own path, which is the host's to choose.
    pub const STOCK_VOICE_FOR_ORDINARY : bool = false;
    // How long a new voice will run, from its text, before it is paid for. Measured
    // 2026-10-04 on the one voice in the host repo with word times:
    // apps/vibee-editor/player/public/lipsync/captions.json (whisper, 75 Russian words of
    // the owner's clone) -- 464 characters with the words joined by single spaces, over
    // lipsync.mp4, 25920 ms by ffprobe. 25920 / 464 = 55.9 ms a character, rounded UP so
    // the estimate errs long: a text the estimate passes fits when spoken at the measured
    // pace. A slower voice (another language, another speaker) can still
    // pass the estimate and run past SPEECH_MAX_SECONDS: the measured length stays the
    // last word, checked after the voice exists.
    pub const MEASURED_CHARS : u32 = 464;
    pub const MEASURED_MS : u32 = 25920;
    pub const MS_PER_CHAR : u32 = 56;
    // Each voice is held to its own slowest measured pace (v9). MS_PER_CHAR is one voice's
    // pace; a slower voice passed it, was paid for, measured too long and given back --
    // on every reel it was asked for. split_reel measures every voice it buys: the text's
    // speech units and the voice's length. It keeps, on that clone's own row, the slowest
    // pace the voice was ever measured at, in ms a unit rounded UP, and judges the next
    // text for that voice at the slower of MS_PER_CHAR and that pace -- never faster than
    // MS_PER_CHAR, so a quick voice does not stretch the ceiling. The pace belongs to the
    // voice, not to whoever asks for it. A voice with no row (the owner's own, spoken by
    // the house's clone) stays at MS_PER_CHAR.
    pub const PACE_PER_VOICE : bool = true;
    // A measurement is kept on the measured voice's own row and on no other. Every other
    // clone -- another client's, another seller's -- keeps the pace it had, and one never
    // measured stays never measured (0). Written onto them, one voice's pace would refuse
    // a stranger's text, before the charge, at a pace that voice never spoke at.
    pub const PACE_ON_OTHER_VOICES : bool = false;
    // A text is counted in speech units, not characters. A Latin or Cyrillic letter, a
    // space or a mark is one unit: MS_PER_CHAR was measured on such text. A digit is read
    // out as a word ("2026" is four digits and some twenty letters spoken), and a letter of
    // a script that writes a syllable or a word per character (Han, Hiragana, Katakana,
    // Hangul) is spoken at ~150-250 ms (999#3573), 3-4 of our units. Both weights are a
    // guess, not a measurement, and they err long; the voice's own pace corrects a voice
    // slower than them. A letter of another alphabet (Greek, Arabic, Hebrew...) is a sound
    // like a Latin one and weighs one: weighing it more would refuse honest texts forever,
    // and its own pace corrects a slow one.
    pub const PLAIN_CHAR_WEIGHT : u32 = 1;
    pub const DIGIT_WEIGHT : u32 = 4;
    pub const WIDE_CHAR_WEIGHT : u32 = 4;
    // A text shorter than this many units is not counted as a measurement of its voice.
    // The silence before and after the words is fixed, so on a short text it reads as a
    // slow voice, and the slowest pace is kept for ever: one "Hello" would cap the voice
    // for good. Half of what fits at MS_PER_CHAR (214 units). A rule, not a measurement.
    pub const MIN_PACE_UNITS : u32 = 107;
    // Why not the slowest pace per language instead: the host repo holds ONE voice with its
    // text -- the clip above, Russian, the owner's clone. Its other voice files have no text
    // (render/public/vo/vo1..vo5.wav, Silero, cut to fit their scenes; avatar_brain's mp3),
    // and no English or client voice is there at all. A "slowest measured" pace for a
    // language nobody measured is a guess, and a guess cannot promise that no voice passes
    // the estimate and then fails the backstop. So the backstop's refusal, the only one after
    // the charge, gives the voice back: the exact sum that voice was charged, once, and only
    // when THIS call paid for it. A voice_url passed back was paid by an earlier call and is
    // not paid again here, so it is not given back again; a voice that fits is used, not
    // refused; the house paid nothing and is given nothing.
    pub const REFUND_TOO_LONG_VOICE : bool = true;

    // ---- The colour of the call (v10) -------------------------------------------------------
    // The owner's words above were about the colour too: v7 took the house's bot off a
    // client's call, and the call was still drawn in the house's gold -- the composition
    // held one colour for every reel, and no road passed it another. The colour comes from
    // the same four places as the words, by the same rule (cta_for, so the two cannot part):
    //   CTA_GIVEN    -- the colour the order gave for this reel; on a reel that is not the
    //                   house's own, not the house's gold (an agent copies that gold from the
    //                   house's own reels as it copied the bot; gold kept in HER palette is
    //                   hers, and stands);
    //   CTA_OWNER    -- HOUSE_CALL_COLOR, the house's own reel's and nobody else's;
    //   CTA_CLIENT   -- hers: the call colour of the palette the seller keeps for her, else of
    //                   her profile (crm-story-reel.t27 v10, the title of her end card);
    //   CTA_NEUTRAL  -- NEUTRAL_CALL_COLOR, nobody's.
    // The house's gold. crm-story-reel.t27 END_CARD_DEFAULT_TITLE is the same colour: a host
    // test holds the two together.
    pub const HOUSE_CALL_COLOR : str = "#FFD700";
    // The composition's own white: the line under the call is drawn in it already.
    pub const NEUTRAL_CALL_COLOR : str = "#FFFFFF";
    // What the call is read against: the scrim under it, black where it is darkest. The held
    // frame shows through the scrim, so this is the best case, and the text's black shadow
    // carries a bright frame. The check is crm-story-reel.t27's own (END_CARD_CONTRAST_MIN_X10,
    // WCAG): the host imports it, it does not keep a second one.
    pub const CALL_GROUND : str = "#000000";
    // How the chosen colour is drawn.
    pub const CALL_AS_IS : u8 = 1;
    pub const CALL_SHADE : u8 = 2;  // its least shade that reads on CALL_GROUND
    pub const CALL_REFUSED : u8 = 3;  // the reel is refused, before the charge
    // A colour that does not read stops the reel only when the order gave it: the seller is
    // there to fix it, and the refusal names the shade that reads. Hers stops nothing -- she
    // is not there to fix it -- and is drawn in that shade, as crm-story-reel.t27 refuses the
    // seller's unreadable palette and not her profile's.
    pub const GIVEN_CALL_COLOR_UNREADABLE_REFUSED : bool = true;

    // A reel is checked before anyone is given it (tri reel-check, in the render as
    // well): no head cut, no face off its window's centre, no caption on silence. A
    // reel that was not measured is not passed: "not measured" is not "fine".
    pub const REEL_CHECK_BEFORE_SEND : bool = true;

    // Where a word's caption starts: at the first speech frame inside the word, or
    // where whisper put it when the word has no frame loud enough (a whisper).
    fn caption_start_ms(whisper_ms : u32, first_speech_ms : u32, end_ms : u32) -> u32 {
        if first_speech_ms < whisper_ms {
            return whisper_ms;
        }
        if first_speech_ms >= end_ms {
            return whisper_ms;
        }
        return first_speech_ms;
    }

    // The cut before the short-tail rule: the rhythm run until the voice ends.
    fn raw_count(total : u32) -> u32 {
        if total <= OPEN_FULL_FRAMES {
            return 1;
        }
        let rest : u32 = total - OPEN_FULL_FRAMES;
        let pairs : u32 = rest / (SPLIT_FRAMES + FULL_FRAMES);
        let tail : u32 = rest % (SPLIT_FRAMES + FULL_FRAMES);
        if tail == 0 {
            return 1 + pairs * 2;
        }
        if tail <= SPLIT_FRAMES {
            return 2 + pairs * 2;
        }
        return 3 + pairs * 2;
    }

    fn raw_last(total : u32) -> u32 {
        if total <= OPEN_FULL_FRAMES {
            return total;
        }
        let tail : u32 = (total - OPEN_FULL_FRAMES) % (SPLIT_FRAMES + FULL_FRAMES);
        if tail == 0 {
            return FULL_FRAMES;
        }
        if tail <= SPLIT_FRAMES {
            return tail;
        }
        return tail - SPLIT_FRAMES;
    }

    // How long the shot before the raw last one runs.
    fn raw_before_last(total : u32) -> u32 {
        let rest : u32 = total - OPEN_FULL_FRAMES;
        let tail : u32 = rest % (SPLIT_FRAMES + FULL_FRAMES);
        if tail > SPLIT_FRAMES {
            return SPLIT_FRAMES;
        }
        if rest < SPLIT_FRAMES + FULL_FRAMES {
            return OPEN_FULL_FRAMES;
        }
        return FULL_FRAMES;
    }

    fn tail_joins(total : u32) -> bool {
        if raw_count(total) == 1 {
            return false;
        }
        return raw_last(total) < MIN_SHOT_FRAMES;
    }

    // How many segments a reel of this many frames is cut into.
    fn segment_count(total : u32) -> u32 {
        if tail_joins(total) {
            return raw_count(total) - 1;
        }
        return raw_count(total);
    }

    // How long the last segment runs: the cut that the end of the voice decides.
    fn last_frames(total : u32) -> u32 {
        if tail_joins(total) {
            return raw_before_last(total) + raw_last(total);
        }
        return raw_last(total);
    }

    // object-position (percent) along one axis that puts a face at `face` px of a
    // source scaled to `rendered` px at `target` percent of a `window` px window.
    fn object_pos_pct(face : u32, rendered : u32, window : u32, target : u32) -> u32 {
        if rendered <= window {
            return 50;
        }
        if face * 100 <= window * target {
            return 0;
        }
        let pct : u32 = (face * 100 - window * target) / (rendered - window);
        if pct > 100 {
            return 100;
        }
        return pct;
    }

    // Where down its window a face is aimed: the middle, or lower when its box
    // (`box_pct` of the window height) would leave the skull less than the aim.
    fn face_target_y_pct(box_pct : u32) -> u32 {
        let need : u32 = box_pct + HEADROOM_AIM_PCT;
        if need <= FACE_CENTER_Y_PCT {
            return FACE_CENTER_Y_PCT;
        }
        if need > FACE_CENTER_Y_PCT + FACE_OFF_CENTER_MAX_PCT {
            return FACE_CENTER_Y_PCT + FACE_OFF_CENTER_MAX_PCT;
        }
        return need;
    }

    fn fits(total : u32) -> bool {
        return total <= MAX_SECONDS * FPS;
    }

    // Frames of the whole reel: the voice, then the pause with the call.
    fn reel_frames(speech_frames : u32) -> u32 {
        return speech_frames + CTA_PAUSE_SEC * FPS;
    }

    // Given to a person only when measured and clean.
    fn deliverable(measured : bool, defects : u32) -> bool {
        if !measured {
            return false;
        }
        return defects == 0;
    }

    // The house's own reel: the house orders it, no client on the turn, no lead named,
    // no sweep for leads.
    fn house_own(house_caller : bool, client_turn : bool, for_lead : bool, seller_sweep : bool) -> bool {
        if !house_caller {
            return false;
        }
        if client_turn {
            return false;
        }
        if for_lead {
            return false;
        }
        return !seller_sweep;
    }

    // Which call the reel ends on. A call the order wrote stands, except one that names
    // the house on a client's reel: hers stands instead.
    fn cta_for(house_own : bool, given : bool, given_names_house : bool, client_has_cta : bool) -> u8 {
        if given {
            if house_own {
                return CTA_GIVEN;
            }
            if !given_names_house {
                return CTA_GIVEN;
            }
        }
        if house_own {
            return CTA_OWNER;
        }
        if client_has_cta {
            return CTA_CLIENT;
        }
        return CTA_NEUTRAL;
    }

    // The owner's clone or sample speaks the house's own reel, and no other.
    fn owner_voice_allowed(house_own : bool) -> bool {
        if house_own {
            return true;
        }
        return OWNER_VOICE_ON_CLIENT_REEL;
    }

    // A house name in a reel's words: always on the house's own reel; on any other, only
    // when the person put it there herself, never when the agent or a template did.
    fn house_name_allowed(house_own : bool, agent_supplied : bool) -> bool {
        if house_own {
            return true;
        }
        if !agent_supplied {
            return true;
        }
        return AGENT_HOUSE_NAME_ON_CLIENT_REEL;
    }

    // Whether a call is charged: a call that goes ahead pays its price; a refused one pays
    // nothing, because its refusal came before the charge.
    fn charged(refused : bool) -> bool {
        if !refused {
            return true;
        }
        return !REFUSED_BEFORE_SPEND;
    }

    // Whether a voice call is refused for want of a voice: a named voice or a clone speaks;
    // the house keeps its own path; anyone else with neither is refused (v8).
    fn voice_refused(house : bool, has_voice_id : bool, has_clone : bool) -> bool {
        if has_voice_id {
            return false;
        }
        if has_clone {
            return false;
        }
        if house {
            return false;
        }
        return !STOCK_VOICE_FOR_ORDINARY;
    }

    // A text's length in speech units (v9): plain characters, digits, and letters of a
    // script that writes a syllable or a word per character, each at its own weight.
    fn speech_units(plain : u32, digits : u32, wide : u32) -> u32 {
        return plain * PLAIN_CHAR_WEIGHT + digits * DIGIT_WEIGHT + wide * WIDE_CHAR_WEIGHT;
    }

    // The pace a voice is judged at (v9): the slower of MS_PER_CHAR and the slowest pace
    // that voice was ever measured at; 0 is a voice never measured.
    fn pace_for(slowest : u32) -> u32 {
        if !PACE_PER_VOICE {
            return MS_PER_CHAR;
        }
        if slowest > MS_PER_CHAR {
            return slowest;
        }
        return MS_PER_CHAR;
    }

    // How long a voice will run for a text of this many units, at that voice's pace (v8,
    // per voice since v9).
    fn speech_ms_estimate(units : u32, slowest : u32) -> u32 {
        return units * pace_for(slowest);
    }

    // Whether a text's voice will fit the format, judged before the voice is paid for (v8,
    // per voice since v9).
    fn text_fits(units : u32, slowest : u32) -> bool {
        return speech_ms_estimate(units, slowest) <= SPEECH_MAX_SECONDS * 1000;
    }

    // The pace one measured voice spoke at (v9): ms a unit, rounded UP so it errs long;
    // 0 when there were no units to divide by.
    fn measured_pace(measured_ms : u32, units : u32) -> u32 {
        if units == 0 {
            return 0;
        }
        return (measured_ms + units - 1) / units;
    }

    // The slowest of the pace kept for a voice and a new measurement: a voice is only ever
    // slowed down, never sped up, by what it is measured at (v9).
    fn slowest_pace(kept : u32, measured : u32) -> u32 {
        if measured > kept {
            return measured;
        }
        return kept;
    }

    // What the voice's row keeps after a voice of this many units ran this long (v9): a
    // text too short to measure leaves the kept pace as it was.
    fn pace_to_keep(kept : u32, measured_ms : u32, units : u32) -> u32 {
        if units < MIN_PACE_UNITS {
            return kept;
        }
        return slowest_pace(kept, measured_pace(measured_ms, units));
    }

    // What one clone's row keeps after split_reel measured a voice (v9): the measured
    // voice's row keeps the slower pace; any other voice's row keeps what it kept, a pace
    // or 0 for never measured.
    fn row_pace_after(row_of_measured : bool, kept : u32, measured_ms : u32, units : u32) -> u32 {
        if !row_of_measured {
            if !PACE_ON_OTHER_VOICES {
                return kept;
            }
        }
        return pace_to_keep(kept, measured_ms, units);
    }

    // Whether a voice, measured once it exists, runs past the format: the backstop (v8).
    fn voice_too_long(measured_ms : u32) -> bool {
        return measured_ms > SPEECH_MAX_SECONDS * 1000;
    }

    // What the backstop gives back when it refuses a voice (v8): the exact sum this call was
    // charged for it, and nothing when the voice came from an earlier call or fits.
    fn backstop_refund(paid_here : bool, measured_ms : u32, charged_now : u32) -> u32 {
        if !paid_here {
            return 0;
        }
        if !voice_too_long(measured_ms) {
            return 0;
        }
        if !REFUND_TOO_LONG_VOICE {
            return 0;
        }
        return charged_now;
    }

    // Where the call's colour comes from (v10): the rule its words come from, with the
    // order's colour for the order's call, the house's gold for the house's bot, and her
    // palette for her profile's call.
    fn call_colour_from(house_own : bool, given : bool, given_is_house : bool, hers : bool) -> u8 {
        return cta_for(house_own, given, given_is_house, hers);
    }

    // How the chosen colour is drawn (v10): as it is when it reads on CALL_GROUND; else the
    // order's colour is refused, before the charge, and any other is drawn in its shade.
    fn call_drawn(from : u8, readable : bool) -> u8 {
        if readable {
            return CALL_AS_IS;
        }
        if from == CTA_GIVEN {
            if GIVEN_CALL_COLOR_UNREADABLE_REFUSED {
                return CALL_REFUSED;
            }
        }
        return CALL_SHADE;
    }

    test "the reel opens on the face, then split 120 and full 45 by turns" {
        assert(segment_count(450) == 6);
        assert(last_frames(450) == 60);
        assert(segment_count(225) == 3);
        assert(last_frames(225) == 45);
    }

    test "a voice shorter than the opening is one shot of the face" {
        assert(segment_count(50) == 1);
        assert(last_frames(50) == 50);
    }

    test "fifteen seconds is the ceiling and the words are one at a time in yellow" {
        assert(fits(450));
        assert(!fits(451));
        assert(WORDS_PER_CAPTION == 1);
        assert(CAPTION_COLOR == "#FFFF00");
        assert(OWN_VOICE);
        assert(CAPTIONS_FROM_FINAL_VOICE);
        assert(CAPTION_DRIFT_MAX_MS <= 150);
    }

    test "a caption starts where the sound starts, not in the pause before it" {
        // reel 2 v3: whisper 5720, speech from 6300, the word ends 6380.
        assert(caption_start_ms(5720, 6300, 6380) == 6300);
        // Already on the sound: unchanged.
        assert(caption_start_ms(1340, 1340, 1440) == 1340);
        // No loud frame inside the word: whisper's own start stands.
        assert(caption_start_ms(1000, 1500, 1400) == 1000);
        assert(ONSET_FRAME_MS == 10);
        assert(SPEECH_BELOW_LOUD_DB > 0);
        assert(CAPTION_ON_SILENCE_MAX_MS <= CAPTION_DRIFT_MAX_MS);
    }

    test "the reel ends on a held frame with the call, inside fifteen seconds" {
        // reel 1 (2026-10-02): its lipsync runs 368 frames, and 368 + 90 is
        // past the ceiling. Its last word ends at 11.33 s, so the call starts
        // where the speech ends (346 frames), not where the file does.
        assert(reel_frames(368) == 458);
        assert(!fits(reel_frames(368)));
        assert(fits(reel_frames(346)));
        assert(CTA_PAUSE_SEC == 3);
        assert(CTA_ALWAYS);
        assert(fits(reel_frames(SPEECH_MAX_SECONDS * FPS)));
        assert(!fits(reel_frames(SPEECH_MAX_SECONDS * FPS + 1)));
    }

    test "a reel is given to a person only when it was measured and is clean" {
        assert(REEL_CHECK_BEFORE_SEND);
        assert(deliverable(true, 0));
        assert(!deliverable(true, 1));
        assert(!deliverable(false, 0));
    }

    test "a tail shorter than a second joins the shot before it" {
        assert(segment_count(401) == 5);
        assert(last_frames(401) == 56);
        assert(segment_count(190) == 2);
        assert(last_frames(190) == 130);
        assert(segment_count(61) == 1);
        assert(last_frames(61) == 61);
    }

    test "in a split the face fills the lower half, not a circle" {
        assert(FACE_FILLS_HALF);
        assert(SPLIT_PCT == 50);
    }

    test "the face is aimed at the middle of its window, never cut at the seam" {
        // A 9:16 lipsync under a 1080x960 half: rendered 1920 tall, face at 760.
        assert(object_pos_pct(760, 1920, 960, FACE_CENTER_Y_PCT) == 29);
        // studio-lab: centre at 28% of 1920 = 537 px -> aim 5%, not the 50% default.
        assert(object_pos_pct(537, 1920, 960, FACE_CENTER_Y_PCT) == 5);
        assert(object_pos_pct(300, 1920, 960, FACE_CENTER_Y_PCT) == 0);
        assert(object_pos_pct(1900, 1920, 960, FACE_CENTER_Y_PCT) == 100);
        // Full screen of a 9:16 source: nothing to move.
        assert(object_pos_pct(760, 1920, 1920, FACE_CENTER_Y_PCT) == 50);
        assert(object_pos_pct(518, 1080, 1080, FACE_CENTER_X_PCT) == 50);
        assert(FACE_CENTER_X_PCT == 50);
        assert(HEADROOM_MIN_PCT > 0);
    }

    test "a face too big for the middle is aimed lower, never past the drift" {
        // A face a third of the window: the middle leaves room above it.
        assert(face_target_y_pct(30) == 50);
        // Reel 1: the box is 49% of the half, the middle cut the skull; 55% leaves 6%.
        assert(face_target_y_pct(49) == 55);
        assert(face_target_y_pct(49) - 49 == HEADROOM_AIM_PCT);
        // Bigger still: lower stops at the drift a check allows.
        assert(face_target_y_pct(58) == 60);
        assert(face_target_y_pct(58) - FACE_CENTER_Y_PCT == FACE_OFF_CENTER_MAX_PCT);
        assert(HEADROOM_AIM_PCT > HEADROOM_MIN_PCT);
    }

    test "a reel is the house own only when the house orders it and nobody else is named" {
        assert(house_own(true, false, false, false));
        assert(!house_own(true, true, false, false));
        assert(!house_own(true, false, true, false));
        assert(!house_own(true, false, false, true));
        assert(!house_own(true, true, true, true));
        // A seller who is not the house: her own reel is not the house's.
        assert(!house_own(false, false, false, false));
    }

    test "a client reel ends on the client call, never on the owner bot" {
        // The order wrote no call: hers, from her profile.
        assert(cta_for(false, false, false, true) == CTA_CLIENT);
        // Her profile has none either: a neutral call, not OWNER_CTA.
        assert(cta_for(false, false, false, false) == CTA_NEUTRAL);
        // The order wrote one: it stands.
        assert(cta_for(false, true, false, false) == CTA_GIVEN);
        assert(cta_for(false, true, false, true) == CTA_GIVEN);
        // The order wrote the owner bot on her reel: hers stands instead.
        assert(cta_for(false, true, true, true) == CTA_CLIENT);
        assert(cta_for(false, true, true, false) == CTA_NEUTRAL);
        assert(CTA_ALWAYS);
    }

    test "the house own reel still ends on the bot" {
        assert(cta_for(true, false, false, false) == CTA_OWNER);
        assert(cta_for(true, false, false, true) == CTA_OWNER);
        // The house may write its own call, the bot included.
        assert(cta_for(true, true, true, false) == CTA_GIVEN);
        assert(cta_for(true, true, false, false) == CTA_GIVEN);
        assert(OWNER_CTA == "@t27ai_bot");
    }

    test "a reel the house did not order never speaks in the owner voice" {
        assert(owner_voice_allowed(true));
        assert(!owner_voice_allowed(false));
        assert(!OWNER_VOICE_ON_CLIENT_REEL);
        assert(OWN_VOICE);
    }

    test "a house name stands in her own words, never where the agent put it" {
        // The house's own reel: any house name stands.
        assert(house_name_allowed(true, true));
        assert(house_name_allowed(true, false));
        // Any other reel: the agent's or a template's house name is refused...
        assert(!house_name_allowed(false, true));
        // ...and the words she wrote herself stand.
        assert(house_name_allowed(false, false));
        assert(!AGENT_HOUSE_NAME_ON_CLIENT_REEL);
    }

    test "a refusal comes before the charge, so a refused call costs nothing" {
        // Refused -- a voice nobody may lend, another client's reel, the agent's house
        // name: nothing was taken, nothing is given back.
        assert(!charged(true));
        // A call that goes ahead pays its price.
        assert(charged(false));
        assert(REFUSED_BEFORE_SPEND);
    }

    test "an ordinary caller with no voice of her own is refused before the charge" {
        // Not the house, no voice named, no clone: refused, and nothing taken.
        assert(voice_refused(false, false, false));
        assert(!charged(voice_refused(false, false, false)));
        // A voice she named, or her own clone, speaks and pays its price.
        assert(!voice_refused(false, true, false));
        assert(!voice_refused(false, false, true));
        assert(charged(voice_refused(false, false, true)));
        // The house with no voice keeps its own path.
        assert(!voice_refused(true, false, false));
        assert(!voice_refused(true, true, true));
        assert(!STOCK_VOICE_FOR_ORDINARY);
        assert(OWN_VOICE);
    }

    test "a voice too long for the format is refused from its text, before it is paid" {
        // The pace is the measured one, rounded up: never below the measurement.
        assert((MEASURED_MS + MEASURED_CHARS - 1) / MEASURED_CHARS == MS_PER_CHAR);
        assert(MEASURED_MS / MEASURED_CHARS < MS_PER_CHAR);
        // The measured text itself is far past the ceiling.
        assert(!text_fits(MEASURED_CHARS, 0));
        // The boundary, for a voice never measured: 214 characters fit, 215 do not.
        assert(speech_ms_estimate(214, 0) == 11984);
        assert(text_fits(214, 0));
        assert(speech_ms_estimate(215, 0) == 12040);
        assert(!text_fits(215, 0));
        assert(text_fits(0, 0));
        // A text refused by its length takes nothing.
        assert(!charged(!text_fits(215, 0)));
        assert(charged(!text_fits(214, 0)));
    }

    test "a voice refused for its length after it is paid is given back, once" {
        // The backstop: past the ceiling by a millisecond is refused, at it is not.
        assert(voice_too_long(12001));
        assert(!voice_too_long(12000));
        // Paid in this call and refused for its length: the exact charge goes back.
        assert(backstop_refund(true, 12001, 10) == 10);
        assert(backstop_refund(true, 14500, 37) == 37);
        // A voice that fits is used, not refused: nothing goes back.
        assert(backstop_refund(true, 12000, 10) == 0);
        // A voice_url from an earlier call is refused again, not paid again: nothing.
        assert(backstop_refund(false, 14500, 10) == 0);
        // The house, or a caller someone else pays for, was charged nothing: nothing.
        assert(backstop_refund(true, 14500, 0) == 0);
        // A text the estimate passes is charged for its voice, so the backstop refuses AFTER
        // the charge: the one refusal REFUSED_BEFORE_SPEND does not cover.
        assert(charged(!text_fits(214, 0)));
        assert(REFUND_TOO_LONG_VOICE);
        assert(REFUSED_BEFORE_SPEND);
    }

    test "a voice is held to its own slowest measured pace before it is paid" {
        assert(PACE_PER_VOICE);
        // A voice never measured is judged at MS_PER_CHAR: its first reel meets the backstop.
        assert(pace_for(0) == MS_PER_CHAR);
        // A voice once measured at 70 ms a unit is judged at 70: 171 units fit, 172 do not.
        assert(pace_for(70) == 70);
        assert(speech_ms_estimate(171, 70) == 11970);
        assert(text_fits(171, 70));
        assert(speech_ms_estimate(172, 70) == 12040);
        assert(!text_fits(172, 70));
        // The text MS_PER_CHAR passes is refused for the slower voice, before it is paid.
        assert(text_fits(200, 0));
        assert(!text_fits(200, 70));
        assert(!charged(!text_fits(200, 70)));
        // A voice quicker than MS_PER_CHAR does not stretch the ceiling: 215 still do not fit.
        assert(pace_for(40) == MS_PER_CHAR);
        assert(text_fits(214, 40));
        assert(!text_fits(215, 40));
        // That voice paid once for 200 units over 14000 ms: its row now keeps 70.
        assert(pace_to_keep(0, 14000, 200) == 70);
        assert(!text_fits(200, pace_to_keep(0, 14000, 200)));
        // The voice that is now held: past the ceiling at its first reel, given back then.
        assert(backstop_refund(true, 14000, 12) == 12);
    }

    test "a voice keeps the slowest pace it was ever measured at" {
        // The measurement that set MS_PER_CHAR gives MS_PER_CHAR back.
        assert(measured_pace(MEASURED_MS, MEASURED_CHARS) == MS_PER_CHAR);
        // Rounded up, so the pace errs long: 12001 ms over 214 units is 57, not 56.
        assert(measured_pace(12001, 214) == 57);
        assert(measured_pace(14000, 200) == 70);
        assert(measured_pace(5000, 0) == 0);
        // Slowest wins, in either order: a quicker reel later does not speed the voice up.
        assert(slowest_pace(70, 60) == 70);
        assert(slowest_pace(60, 70) == 70);
        assert(slowest_pace(0, 57) == 57);
        assert(pace_to_keep(80, 14000, 200) == 80);
        assert(pace_to_keep(60, 14000, 200) == 70);
        // A text too short to measure keeps what was kept: one "Hello" does not cap a voice.
        assert(MIN_PACE_UNITS * 2 == SPEECH_MAX_SECONDS * 1000 / MS_PER_CHAR);
        assert(pace_to_keep(0, 1200, 10) == 0);
        assert(pace_to_keep(0, 9000, MIN_PACE_UNITS - 1) == 0);
        assert(pace_to_keep(0, 9000, MIN_PACE_UNITS) == 85);
    }

    test "a voice's pace is kept on its own row and never on another voice" {
        // Voice A paid for 200 units over 14000 ms: its row, never measured, now keeps 70.
        assert(row_pace_after(true, 0, 14000, 200) == 70);
        assert(row_pace_after(true, 80, 14000, 200) == 80);
        // Voice B, never measured, still has no pace: A's 70 does not land on it.
        assert(row_pace_after(false, 0, 14000, 200) == 0);
        assert(text_fits(200, row_pace_after(false, 0, 14000, 200)));
        // Voice C, measured at 60, keeps 60: A's slower pace does not land on it either.
        assert(row_pace_after(false, 60, 14000, 200) == 60);
        assert(!PACE_ON_OTHER_VOICES);
    }

    test "a digit or a syllable character weighs more than a letter" {
        // The measured text has no digits and no wide letters: its count is its units.
        assert(speech_units(MEASURED_CHARS, 0, 0) == MEASURED_CHARS);
        assert(speech_units(150, 20, 0) == 230);
        assert(speech_units(0, 0, 60) == 240);
        // A digit-heavy text: 170 characters would fit, its 230 units do not.
        assert(text_fits(150 + 20, 0));
        assert(!text_fits(speech_units(150, 20, 0), 0));
        assert(!charged(!text_fits(speech_units(150, 20, 0), 0)));
        // A text in Han characters: 53 of them fit, 54 do not -- never 214.
        assert(text_fits(speech_units(0, 0, 53), 0));
        assert(!text_fits(speech_units(0, 0, 54), 0));
        assert(text_fits(54, 0));
        // A Latin or Cyrillic letter weighs one; a digit and a wide letter weigh more.
        assert(PLAIN_CHAR_WEIGHT == 1);
        assert(DIGIT_WEIGHT > PLAIN_CHAR_WEIGHT);
        assert(WIDE_CHAR_WEIGHT > PLAIN_CHAR_WEIGHT);
    }

    test "a client with no palette gets the neutral call colour, not the house gold" {
        // Nothing given, nothing of hers: neutral -- not the house's gold.
        assert(call_colour_from(false, false, false, false) == CTA_NEUTRAL);
        assert(call_colour_from(false, false, false, false) != CTA_OWNER);
        assert(NEUTRAL_CALL_COLOR == "#FFFFFF");
        assert(HOUSE_CALL_COLOR == "#FFD700");
        // An ordinary seller's own reel is not the house's either.
        assert(call_colour_from(house_own(false, false, false, false), false, false, false) == CTA_NEUTRAL);
        // A client named on the house's turn: hers, else neutral -- never the gold.
        assert(call_colour_from(house_own(true, false, true, false), false, false, false) == CTA_NEUTRAL);
        assert(call_colour_from(house_own(true, false, true, false), false, false, true) == CTA_CLIENT);
    }

    test "a client reel's call is drawn in the order's colour, else hers" {
        // Her palette: hers.
        assert(call_colour_from(false, false, false, true) == CTA_CLIENT);
        // The order gave one: it stands, over hers.
        assert(call_colour_from(false, true, false, true) == CTA_GIVEN);
        assert(call_colour_from(false, true, false, false) == CTA_GIVEN);
        // The order gave the house's gold on her reel: hers stands instead, else neutral.
        assert(call_colour_from(false, true, true, true) == CTA_CLIENT);
        assert(call_colour_from(false, true, true, false) == CTA_NEUTRAL);
        // The colour and the words come from the same place.
        assert(call_colour_from(false, true, true, true) == cta_for(false, true, true, true));
        assert(call_colour_from(false, false, false, false) == cta_for(false, false, false, false));
    }

    test "the house own reel keeps its gold" {
        assert(call_colour_from(true, false, false, false) == CTA_OWNER);
        assert(call_colour_from(true, false, false, true) == CTA_OWNER);
        // The house may give its own colour, its gold included.
        assert(call_colour_from(true, true, false, false) == CTA_GIVEN);
        assert(call_colour_from(true, true, true, false) == CTA_GIVEN);
        assert(call_colour_from(house_own(true, false, false, false), false, false, false) == CTA_OWNER);
    }

    test "a call colour that does not read: the order's is refused before the charge, hers is shaded" {
        // A colour that reads is drawn as it is, whoever's it is.
        assert(call_drawn(CTA_GIVEN, true) == CALL_AS_IS);
        assert(call_drawn(CTA_CLIENT, true) == CALL_AS_IS);
        assert(call_drawn(CTA_OWNER, true) == CALL_AS_IS);
        assert(call_drawn(CTA_NEUTRAL, true) == CALL_AS_IS);
        // The order's colour that does not read: refused, and nothing taken.
        assert(call_drawn(CTA_GIVEN, false) == CALL_REFUSED);
        assert(!charged(call_drawn(CTA_GIVEN, false) == CALL_REFUSED));
        // Hers that does not read: drawn in its shade that reads, and the reel goes ahead.
        assert(call_drawn(CTA_CLIENT, false) == CALL_SHADE);
        assert(charged(call_drawn(CTA_CLIENT, false) == CALL_REFUSED));
        assert(GIVEN_CALL_COLOR_UNREADABLE_REFUSED);
        assert(REFUSED_BEFORE_SPEND);
    }

    test "the version is the last dated note" {
        assert(VERSION == 10);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
