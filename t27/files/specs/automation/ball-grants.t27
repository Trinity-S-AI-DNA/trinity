// SPDX-License-Identifier: Apache-2.0
// specs/automation/ball-grants.t27 -- who besides the owner may see the mail cards of
// the ball board, and exactly how much of them.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/agent/ball-grants.ts (the
//       tool ball_grant, and the gate the ball_board tool asks before it reads mail),
//       registered in src/agent/tools.ts.
// Reader: the Queen's kanban on app.t27.ai/game/kanban, its MAIL lane, asked as the
//       person who is signed in (gHashTag/trinity apps/website/src/lib/ballBoard.ts).
// Owner, 2026-10-01: "all the tasks from my mail must be visible to me when I am
//       signed in, and to others if I allowed it; sort out privacy and security".
// Law lineage: automation/ball-board (the mailbox is the owner's, refused before the
//       read -- this spec is its ONE exception, and it is the owner's to make); the
//       hive board (a filter can narrow and never widen; a count of what was not sent
//       is a leak with a smaller vocabulary).
// What this spec decides: what a grant opens, for whom, for how long, and which parts
//       of a mail card never leave the server whoever asks. What it does NOT decide:
//       whose move a matter is (automation/ball-board mail_ball) or how a matter finds
//       its client (ball-board's links, applied on the server, never sent).
// Claim status: designed and bound by tests; RUN_LIVE flips when a granted viewer
//       reads exactly their clients' cards on app.t27.ai and the owner sees the read.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::ball_grants {

    pub const KIND : str = "automation";
    pub const ID : str = "ball-grants";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 1;

    // ---- The door -------------------------------------------------------------------
    pub const TOOL : str = "ball_grant";  // owner only: grant, revoke, list
    pub const BOARD_TOOL : str = "ball_board";  // the read this gate stands in front of
    pub const TABLE : str = "ball_viewer_grants";  // owner, viewer, client, granted_at,
                                                   // expires_at, last_read_at

    // ---- What a grant opens ---------------------------------------------------------
    pub const SOURCE : str = "mail";  // the only source a grant opens
    pub const WORK_SHARED : bool = false;  // a private repository's titles stay the
                                           // owner's: no grant reaches the github column
    pub const ALL_CLIENTS : str = "*";  // a grant for every LINKED client at once
    pub const VIEWER_BY_ID : bool = true;  // a viewer is a telegram id: a username can
                                           // change hands, an id cannot

    // ---- For how long ---------------------------------------------------------------
    pub const DAYS_DEFAULT : u8 = 30;  // a grant nobody sized still ends
    pub const DAYS_MAX : u8 = 90;  // and none outlives a quarter; renewing is one call

    // ---- What never leaves the server, whoever asks ---------------------------------
    pub const UNLINKED_TO_VIEWER : bool = false;  // a matter no link names has no client
                                                  // to be granted, so no viewer sees it
    pub const LINKS_TO_VIEWER : bool = false;  // the owner's links are applied on the
                                               // server; the address book is not sent
    pub const COUNTERPARTIES_TO_VIEWER : bool = false;  // no card carries an address
    pub const COUNTS_OUTSIDE_GRANT : bool = false;  // "12 more elsewhere" is not sent:
                                                    // a viewer's counts are of cards in
                                                    // hand
    pub const GAME_TOKEN_MAY_READ : bool = false;  // the t27.ai bridge token was consented
                                                   // for a name and a picture, not mail

    // ---- What the owner keeps -------------------------------------------------------
    pub const READ_RECORDED : bool = true;  // every viewer read stamps last_read_at, and
                                            // the owner's list shows it: the owner can see
                                            // who looked, and when

    // ---- Not claimed ----------------------------------------------------------------
    pub const RUN_LIVE : bool = false;

    // The mail source is read for the owner, or for a caller holding a live grant --
    // and for nobody else, before anything is read.
    fn may_read_mail(caller_is_owner: bool, has_live_grant: bool) -> bool {
        return caller_is_owner || has_live_grant;
    }

    // Only the owner grants, and never to the owner: a grant to oneself is a row that
    // means nothing and would be listed as if somebody else had access.
    fn may_grant(caller_is_owner: bool, viewer_is_owner: bool) -> bool {
        return caller_is_owner && !viewer_is_owner;
    }

    // A card reaches a viewer only when its client is the granted one, or the grant is
    // for every client. A card with no client (an unlinked matter) reaches no viewer.
    fn grant_covers(grant_client: str, card_client: str) -> bool {
        if card_client == "" {
            return false;
        }
        if grant_client == ALL_CLIENTS {
            return true;
        }
        return grant_client == card_client;
    }

    // The length of a grant: unsized means the default, oversized means the ceiling.
    fn grant_days(asked: u8) -> u8 {
        if asked == 0 {
            return DAYS_DEFAULT;
        }
        if asked > DAYS_MAX {
            return DAYS_MAX;
        }
        return asked;
    }

    test "the owner reads the mail, a viewer only with a live grant, nobody else" {
        assert(may_read_mail(true, false));
        assert(may_read_mail(true, true));
        assert(may_read_mail(false, true));
        assert(!may_read_mail(false, false));
    }

    test "only the owner grants, and never to the owner" {
        assert(may_grant(true, false));
        assert(!may_grant(true, true));
        assert(!may_grant(false, false));
        assert(!may_grant(false, true));
    }

    test "a grant covers its client, or every linked client, and never an unlinked one" {
        assert(grant_covers("acme", "acme"));
        assert(!grant_covers("acme", "globex"));
        assert(grant_covers(ALL_CLIENTS, "globex"));
        assert(!grant_covers(ALL_CLIENTS, ""));
        assert(!grant_covers("acme", ""));
        assert(!UNLINKED_TO_VIEWER);
    }

    test "every grant ends: unsized is a month, nothing outlives a quarter" {
        assert(grant_days(0) == 30);
        assert(grant_days(7) == 7);
        assert(grant_days(90) == 90);
        assert(grant_days(91) == 90);
        assert(grant_days(200) == 90);
        assert(DAYS_DEFAULT <= DAYS_MAX);
    }

    test "a grant opens the mail and nothing else" {
        assert(SOURCE == "mail");
        assert(!WORK_SHARED);
        assert(VIEWER_BY_ID);
        assert(BOARD_TOOL == "ball_board");
    }

    test "what never leaves the server, whoever asks" {
        assert(!LINKS_TO_VIEWER);
        assert(!COUNTERPARTIES_TO_VIEWER);
        assert(!COUNTS_OUTSIDE_GRANT);
        assert(!GAME_TOKEN_MAY_READ);
    }

    test "the owner sees who looked" {
        assert(READ_RECORDED);
        assert(TABLE == "ball_viewer_grants");
        assert(TOOL == "ball_grant");
    }

    test "the sharing is designed, not yet live" {
        assert(!RUN_LIVE);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
