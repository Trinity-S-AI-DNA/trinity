// SPDX-License-Identifier: Apache-2.0
// specs/automation/plan-reel.t27 -- a card of a person's content plan is one press from its
// reel: the person's own face and voice (the digital clone) in the story template, and the
// reel that came out stands on its card as a picture. The t27 course is a plan the owner can
// take in: one card a lesson, each card's reel ending on its lesson.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/agent/plan-reel.ts (the rules
//       and the course reader), plan-tools.ts (plan_list carries each card's reel and the
//       next press's price; plan_course_add takes the course in), crm-story-tool.ts
//       (my_story_reel item_id), story-template.ts (the job made of THAT card); the player's
//       components/Profile/ProfilePlan.tsx (the press and the preview on a card),
//       components/Story/MyStoryWidget.tsx and components/Profile/StoryCard.tsx (previews);
//       the render's agent/reel-poster.ts (the poster, drawn when a reel is out and by the
//       story sweep) and the player's components/Story/ReelPreview.tsx (poster or frame).
// Generated: `t27c gen-ts` of this file is vendored into the host as
//       apps/vibee-editor/render/src/spec/plan-reel.gen.ts and copied to the player's
//       src/spec/. The host imports the numbers below and never restates them; a host test
//       runs every test here.
// Why: the owner, 2026-10-08: "t27.ai/#/course and my content plan -- link them to my
//       digital clone and the template, and add reel previews to the cabinet; start with
//       ONE reel, test it cheaply". Read in the host the same day: a card became a reel
//       only as "the next idea" when no topic was typed, never by a press on it; its note
//       (the theses the plan screen asks for) never reached the writer of the lines; the
//       finished reel's address was appended to the note as text and the card showed no
//       picture; the cabinet listed reels as words with a link; nothing read the course.
// Laws:
//   - A card is pressed, not guessed: the reel is made of THAT card, its title the topic and
//     its note the writer's material. A card already being made is not taken again.
//   - One reel at a time per person; while one is made, no card offers the press.
//   - The first reel a person makes from the plan is the trial: TRIAL_SCENES scene, the
//     cheapest reel the template makes. FULL_SCENES only once a reel from the plan came out.
//   - The price is named before the press, for the scenes that press would make.
//   - A card whose note links a lesson of the course ends its reel on that lesson: the
//     call is the lesson's address. Any other card ends on the person's own call.
//   - A lesson's address is its static page (LESSON_ROUTE + id + "/"), never its SPA
//     route: what follows '#' never reaches a crawler (v2).
//   - The course is read from its own spec, never from a hand copy, and its Russian from
//     the bundle its translation contract names; a field missing there is the English one.
//     A course that does not read as LESSONS lessons is refused whole, not half taken in.
//   - Taking the course in is free and idempotent: a lesson already a card is not added.
//   - A reel that came out stands on its card as a picture: its frame at PREVIEW_SEEK_MS,
//     9:16, muted, never playing by itself; a press on it opens the reel.
//   - The cabinet's story card shows the last PREVIEWS_MAX reels that came out.
//   - A reel that came out gets a poster: its frame at PREVIEW_SEEK_MS, drawn once by the
//     server, POSTER_W wide (the card's width at POSTER_DENSITY). Where the poster stands,
//     the picture is the poster and the video is not fetched; where none does, the browser
//     draws the frame (v3).
//   - The reel is out before its poster is drawn: a poster that fails never delays the reel,
//     never fails it, and is never charged.
//   - A poster is tried once. The sweep draws the posters of reels that came out without one
//     (before v3, or their process died), at most POSTER_SWEEP_MAX a round; a poster that
//     could not be drawn is marked tried and left to the browser's frame (v3).
// Claim status: v1 written 2026-10-08 with its host; the first trial reel is the owner's
//       press on one lesson card after the deploy -- not yet made when this was written.
// v1 (2026-10-08): the press on a card, the trial, the course's lesson call, the course
//       sources, the preview and the cabinet's count.
// v2 (2026-10-08, the owner, a screenshot: course 0 posted to X as t27.ai/#/t27-basics showed
//       the home page's card): a crawler drops what follows '#', so a lesson linked by its
//       SPA route previews as the home page wherever the link is shared. LESSON_ROUTE is now
//       the lesson's own static page, t27.ai/learn/<id>/ (one per lesson, ids unique across
//       the courses), which carries the lesson's card: the call at the end of a reel and the
//       link in a lesson card's note both name it.
// v3 (2026-10-08, the owner: "measure the trial reel, and why do previews keep breaking"):
//       the preview drew a story reel's frame in the browser from the video itself. Each card
//       fetched the video's metadata to show one frame, and a phone's webview may draw
//       nothing before playback. The feed's videos already carry a server-drawn cover; the
//       story reel did not. Now the server draws the poster once and the card shows it.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::plan_reel {

    pub const KIND : str = "automation";
    pub const ID : str = "plan-reel";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 3;

    // ---- A card's status, as the plan stores it ------------------------------------------
    pub const STATUS_IDEA : u8 = 0;   // not made yet
    pub const STATUS_DOING : u8 = 1;  // its reel is being made (or the person said so)
    pub const STATUS_DONE : u8 = 2;   // out

    // ---- How many scenes a press makes ---------------------------------------------------
    pub const TRIAL_SCENES : u16 = 1;  // the first reel from the plan: the cheapest test
    pub const FULL_SCENES : u16 = 3;   // the template's own count (crm-story-reel SCENES_DEFAULT)

    // ---- Where a reel's call comes from ---------------------------------------------------
    pub const CALL_OWN : u8 = 0;     // the person's own call (her profile, else the template's)
    pub const CALL_LESSON : u8 = 1;  // the lesson the card links

    // ---- The course ----------------------------------------------------------------------
    pub const COURSE_LESSONS : u8 = 27;  // course.t27 LESSON_COUNT: 9 modules of 3
    // Read in this order; the first that answers as a whole course is the course.
    pub const COURSE_SOURCES : [2]str = [
        "https://t27.ai/learn/course.t27",
        "https://raw.githubusercontent.com/gHashTag/trinity/main/apps/website/specs/course/course.t27"
    ];
    // The Russian bundle course-ru.t27 names (BUNDLE_REPO trinity, BUNDLE_PATH).
    pub const COURSE_RU_SOURCE : str = "https://raw.githubusercontent.com/gHashTag/trinity/main/apps/website/i18n/course.ru.json";
    pub const LESSON_ROUTE : str = "https://t27.ai/learn/";  // + the lesson id + "/" (v2)

    // ---- The picture of a reel -----------------------------------------------------------
    pub const PREVIEW_SEEK_MS : u16 = 1000;  // past the first frame, which may be dark
    pub const PREVIEW_W : u8 = 9;
    pub const PREVIEW_H : u8 = 16;
    pub const PREVIEW_CARD_PX : u16 = 72;  // its width on a plan card
    pub const PREVIEWS_MAX : u8 = 3;       // the cabinet's story card, newest first

    // ---- The poster: the same frame, drawn once by the server (v3) ----------------------
    pub const POSTER_DENSITY : u16 = 3;     // the densest phone screen's pixels per CSS px
    pub const POSTER_W : u16 = 216;         // PREVIEW_CARD_PX * POSTER_DENSITY
    pub const POSTER_SWEEP_MAX : u8 = 3;    // posters the sweep draws in one round
    pub const POSTER_NONE : u8 = 0;         // never tried
    pub const POSTER_TRIED : u8 = 1;        // tried, none drawn: the browser's frame stands
    pub const POSTER_KEPT : u8 = 2;         // drawn and stored
    pub const PICTURE_FRAME : u8 = 0;       // the browser draws the frame from the video
    pub const PICTURE_POSTER : u8 = 1;      // the stored poster is shown

    // A card offers the press when it is not made yet and nothing of the person's is made now.
    fn press_offered(status: u8, busy: bool) -> bool {
        return status == STATUS_IDEA && !busy;
    }

    // A card is taken by a press only while it is still an idea.
    fn card_taken(status: u8) -> bool {
        return status == STATUS_IDEA;
    }

    // A reel that came out stands on its card, whatever the card's status says now.
    fn preview_shown(has_reel: bool) -> bool {
        return has_reel;
    }

    // How many scenes the next press makes, given how many reels from the plan came out.
    fn scenes_for(reels_out: u16) -> u16 {
        if reels_out == 0 {
            return TRIAL_SCENES;
        }
        return FULL_SCENES;
    }

    // Where the reel of a card ends: its lesson, when its note links one.
    fn call_of(links_lesson: bool) -> u8 {
        if links_lesson {
            return CALL_LESSON;
        }
        return CALL_OWN;
    }

    // A course that read as anything but the whole course is not taken in.
    fn course_whole(lessons: u8) -> bool {
        return lessons == COURSE_LESSONS;
    }

    // Taking the course in adds a lesson only when it is not a card already.
    fn lesson_added(already_a_card: bool) -> bool {
        return !already_a_card;
    }

    // How many pictures the cabinet's story card shows.
    fn previews_shown(reels_out: u8) -> u8 {
        if reels_out < PREVIEWS_MAX {
            return reels_out;
        }
        return PREVIEWS_MAX;
    }

    // What a card shows for a reel that came out: its poster, when one is kept.
    fn picture_of(poster: u8) -> u8 {
        if poster == POSTER_KEPT {
            return PICTURE_POSTER;
        }
        return PICTURE_FRAME;
    }

    // The sweep draws a poster only for a reel that came out and was never tried.
    fn poster_swept(reel_out: bool, poster: u8) -> bool {
        return reel_out && poster == POSTER_NONE;
    }

    // How many posters one round of the sweep draws, given how many wait.
    fn posters_this_round(waiting: u16) -> u16 {
        if waiting < POSTER_SWEEP_MAX {
            return waiting;
        }
        return POSTER_SWEEP_MAX;
    }

    // The height of a reel's picture of a given width.
    fn preview_height(width: u16) -> u16 {
        return width * PREVIEW_H / PREVIEW_W;
    }

    test "a card offers the press only while it is an idea and nothing is being made" {
        assert(press_offered(STATUS_IDEA, false));
        assert(!press_offered(STATUS_IDEA, true));
        assert(!press_offered(STATUS_DOING, false));
        assert(!press_offered(STATUS_DONE, false));
    }

    test "a press takes the card it was made on, and only an idea" {
        assert(card_taken(STATUS_IDEA));
        assert(!card_taken(STATUS_DOING));
        assert(!card_taken(STATUS_DONE));
    }

    test "a reel that came out stands on its card" {
        assert(preview_shown(true));
        assert(!preview_shown(false));
    }

    test "the first reel from the plan is the trial, one scene" {
        assert(scenes_for(0) == TRIAL_SCENES);
        assert(scenes_for(0) == 1);
        assert(scenes_for(1) == FULL_SCENES);
        assert(scenes_for(9) == FULL_SCENES);
        assert(TRIAL_SCENES < FULL_SCENES);
    }

    test "a lesson card ends on its lesson" {
        assert(call_of(true) == CALL_LESSON);
        assert(call_of(false) == CALL_OWN);
    }

    test "the course is taken in whole or not at all, and never twice" {
        assert(course_whole(27));
        assert(!course_whole(26));
        assert(!course_whole(0));
        assert(lesson_added(false));
        assert(!lesson_added(true));
    }

    test "the cabinet shows at most three reels, as 9:16 pictures" {
        assert(previews_shown(0) == 0);
        assert(previews_shown(2) == 2);
        assert(previews_shown(3) == 3);
        assert(previews_shown(12) == PREVIEWS_MAX);
        assert(preview_height(PREVIEW_CARD_PX) == 128);
        assert(preview_height(90) == 160);
    }

    test "a kept poster is the picture, anything else leaves the frame to the browser" {
        assert(picture_of(POSTER_KEPT) == PICTURE_POSTER);
        assert(picture_of(POSTER_NONE) == PICTURE_FRAME);
        assert(picture_of(POSTER_TRIED) == PICTURE_FRAME);
    }

    test "the poster is the card's width at the densest screen, 9:16" {
        assert(POSTER_W == PREVIEW_CARD_PX * POSTER_DENSITY);
        assert(preview_height(POSTER_W) == 384);
    }

    test "the sweep draws a poster once, only for a reel that came out" {
        assert(poster_swept(true, POSTER_NONE));
        assert(!poster_swept(true, POSTER_TRIED));
        assert(!poster_swept(true, POSTER_KEPT));
        assert(!poster_swept(false, POSTER_NONE));
        assert(posters_this_round(0) == 0);
        assert(posters_this_round(2) == 2);
        assert(posters_this_round(40) == POSTER_SWEEP_MAX);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
