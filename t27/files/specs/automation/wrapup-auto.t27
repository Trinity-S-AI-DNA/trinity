# specs/automation/wrapup-auto.t27
# Ring-071 - RAG-Backed Semantic Memory
# phi^2 + 1/phi^2 = 3 | TRINITY

module automation::wrapup {
    use memory::notebooklm;

    const DEFAULT_NOTEBOOK : str = "t27-QUEEN-BRAIN";
    const VENV_PATH : str = ".trinity/notebooklm-venv";

    // tri_command: "tri wrapup"
    // Invoked from Claude Code via /tri wrapup or Skill tool
    // Backend: contrib/backend/notebooklm/wrapup_auto.py

    struct WrapUpInput {
        summary: str,
        decisions: str,
        files_modified: [str],
        next_steps: str,
        session_id: str,
        issue_number: u32,   // GitHub issue number
        issue_title: str,    // GitHub issue title
    }

    struct WrapUpResult {
        notebook_id: str,
        notebook_name: str,
        source_id: str,
        uploaded_at: u64,
    }

    // wrapup_run(input: WrapUpInput) -> (WrapUpResult, ErrorCode)
    // Find/create notebook, format markdown, upload source.
    // NOT CHECKED here: wrapup_run lives in the Python backend named above and
    // talks to NotebookLM over the network, and no spec declares it. The test
    // that called it (wrapup_run_uploads_source) had no braces, so t27c kept
    // only its first statement and it passed with 0 asserts executed. It also
    // claimed a notebook name the backend never builds: wrapup_auto.py uploads
    // to DEFAULT_NOTEBOOK under the source title "Session <session_id>".

    // A wrap-up record holds the session it was built from.
    test wrapup_input_holds_the_session {
        var input = WrapUpInput {
            summary: "Test session",
            decisions: "Used notebooklm-py",
            files_modified: ["specs/automation/wrapup-auto.t27"],
            next_steps: "Verify upload",
            session_id: "test-001",
            issue_number: 350,
            issue_title: "NotebookLM Integration",
        };
        assert(input.issue_number == 350);
        assert(input.files_modified.len == 1);
        assert(input.files_modified[0].len == 32);
        assert(input.session_id.len == 8);
        assert(input.issue_title.len == 22);
        assert(DEFAULT_NOTEBOOK.len == 15);
    }
}
