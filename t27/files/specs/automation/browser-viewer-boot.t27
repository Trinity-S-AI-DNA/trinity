// SPDX-License-Identifier: Apache-2.0
// specs/automation/browser-viewer-boot.t27 -- how the person's live-browser window comes up:
// the loader, the fast fall to pictures when the video is late, the final give-up, the
// language the window speaks and whether the video may make a sound.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/browser/skin.ts (BOOT_SCRIPT,
//       LANG_SCRIPT, MUTE_SCRIPT: the scripts injected into the viewer's document) and
//       src/browser/live-proxy.ts (viewerLangOf: the language the proxy carries through
//       the login redirect). The host imports every number and word below from the gen.
// Generated: by hand, 2026-10-07; host bound in the same change (999 PR, branch
//       spec/browser-viewer-boot). Behaviour first shipped in 999 PR #3807.
// Why: owner, 2026-10-06, iPhone in Telegram: minutes of "Starting your browser" over a
//       dimmed picture that was already live, and the loader in English under a Russian app.
// Laws:
//   - The fast fallback comes well before the give-up: frames with no playing video by
//     BOOT_FAST_WATCH_MS mean the pod is up and only the video is late, so the window
//     shows the pictures (frames mode). The give-up at BOOT_GIVE_UP_MS stays for the
//     case with no frames at all, where the loader must leave to uncover the error card.
//   - Frames mode is remembered for the tab, per session, so a reconnect reload shows the
//     pictures on its first frame; a video that plays clears that memory.
//   - The window speaks only a language it has words for: lang=ru or lang=en on the
//     address. Anything else is ignored and the phone's own language decides.
//   - The video plays inline and muted; only sound=1 on the address keeps its sound.
// Claim status: v1 written 2026-10-07 from the shipped host and its tests
//       (render/browser-viewer-boot.test.ts); not measured on a live iPhone since.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::browser_viewer_boot {

    pub const KIND : str = "automation";
    pub const ID : str = "browser-viewer-boot";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 1;

    // ---- The two clocks ---------------------------------------------------------------
    pub const BOOT_FAST_WATCH_MS : u32 = 8000;  // frames and no video by now: pictures
    pub const BOOT_GIVE_UP_MS : u32 = 45000;  // longer than a cold pod takes

    // ---- What the window shows (the answers of mode_at) ----------------------------------
    pub const MODE_LOADER : u8 = 0;  // the ring over the poster
    pub const MODE_FRAMES : u8 = 1;  // watch mode: the JPEG stream is the picture
    pub const MODE_DONE : u8 = 2;  // the loader has left the page

    // ---- Frames mode is remembered per session, a playing video forgets it ----------------
    pub const FRAMES_MODE_PER_SESSION : bool = true;
    pub const FRAMES_MODE_CLEARED_ON_PLAY : bool = true;

    // ---- The language on the address ------------------------------------------------------
    pub const LANG_PARAM : str = "lang";
    pub const LANG_RU : str = "ru";
    pub const LANG_EN : str = "en";

    // ---- Sound on the address --------------------------------------------------------------
    pub const SOUND_PARAM : str = "sound";
    pub const SOUND_ON : str = "1";
    pub const PLAYS_INLINE : bool = true;  // WKWebView plays nothing in-page without it

    // The fast fallback is a fallback only while it comes before the give-up.
    fn fast_before_give_up() -> bool {
        return BOOT_FAST_WATCH_MS < BOOT_GIVE_UP_MS;
    }

    // What the window shows after elapsed_ms. A playing video ends the loader at once.
    // A tab that already reached frames mode shows the pictures on its first frame.
    fn mode_at(elapsed_ms: u32, frames: bool, playing: bool, remembered: bool) -> u8 {
        if playing {
            return MODE_DONE;
        }
        if frames && remembered {
            return MODE_FRAMES;
        }
        if elapsed_ms >= BOOT_GIVE_UP_MS {
            if frames {
                return MODE_FRAMES;
            }
            return MODE_DONE;
        }
        if frames && elapsed_ms >= BOOT_FAST_WATCH_MS {
            return MODE_FRAMES;
        }
        return MODE_LOADER;
    }

    // The tab's memory of frames mode after one more turn of the window.
    fn remembered_after(was: bool, entered_frames: bool, played: bool) -> bool {
        if played {
            return false;
        }
        return was || entered_frames;
    }

    // A language on the address is kept only when the window has words for it.
    fn lang_kept(asked: str) -> bool {
        return asked == LANG_RU || asked == LANG_EN;
    }

    // The video is muted unless the address carries sound=1.
    fn muted(sound: str) -> bool {
        return sound != SOUND_ON;
    }

    test "the fast fallback comes well before the give-up" {
        assert(fast_before_give_up());
        assert(BOOT_FAST_WATCH_MS == 8000);
        assert(BOOT_GIVE_UP_MS == 45000);
        assert(BOOT_FAST_WATCH_MS * 5 <= BOOT_GIVE_UP_MS);
    }

    test "frames and no video go to frames mode at the fast clock" {
        assert(mode_at(BOOT_FAST_WATCH_MS - 1, true, false, false) == MODE_LOADER);
        assert(mode_at(BOOT_FAST_WATCH_MS, true, false, false) == MODE_FRAMES);
        assert(mode_at(BOOT_GIVE_UP_MS, true, false, false) == MODE_FRAMES);
    }

    test "no frames keep the loader until the give-up, then it leaves" {
        assert(mode_at(BOOT_FAST_WATCH_MS, false, false, false) == MODE_LOADER);
        assert(mode_at(BOOT_GIVE_UP_MS - 1, false, false, false) == MODE_LOADER);
        assert(mode_at(BOOT_GIVE_UP_MS, false, false, false) == MODE_DONE);
    }

    test "a playing video ends the loader at any time" {
        assert(mode_at(0, false, true, false) == MODE_DONE);
        assert(mode_at(BOOT_FAST_WATCH_MS, true, true, true) == MODE_DONE);
    }

    test "a reload after frames mode shows the pictures on the first frame" {
        assert(FRAMES_MODE_PER_SESSION);
        assert(mode_at(0, true, false, true) == MODE_FRAMES);
        assert(mode_at(0, false, false, true) == MODE_LOADER);
        assert(remembered_after(false, true, false));
        assert(remembered_after(true, false, false));
        assert(!remembered_after(false, false, false));
    }

    test "a video that plays clears the frames-mode memory" {
        assert(FRAMES_MODE_CLEARED_ON_PLAY);
        assert(!remembered_after(true, false, true));
        assert(!remembered_after(true, true, true));
    }

    test "a language outside ru and en is ignored" {
        assert(lang_kept("ru"));
        assert(lang_kept("en"));
        assert(!lang_kept("de"));
        assert(!lang_kept(""));
        assert(!lang_kept("RU"));
        assert(LANG_PARAM == "lang");
    }

    test "the video plays inline and muted unless sound=1" {
        assert(PLAYS_INLINE);
        assert(muted(""));
        assert(muted("0"));
        assert(!muted("1"));
        assert(SOUND_PARAM == "sound");
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
