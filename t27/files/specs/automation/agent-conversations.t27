// SPDX-License-Identifier: Apache-2.0
// specs/automation/agent-conversations.t27 -- SEVERAL CONVERSATIONS with one agent: the person's own
// thread and each hired specialist split into named conversations, so a second task no longer means
// clearing the first. Written after the owner said (2026-09-26) "so I can keep several chats going".
// Host: 999-multibots-telegraf apps/vibee-editor -- render: agent_messages.thread carries the
//       conversation as base + '~' + id (conversation.ts conversationThread/splittable), listed and
//       named through /api/agent/conversations (routes.ts handleAgentConversations), body.conversation
//       / ?conversation= threaded through withConversation on the four /api/agent routes; player:
//       ?c=<id> on /chat and /agents/:agentId/work, the rail (ConversationRail.tsx), one stream, queue
//       and Stop per conversation (agentStream.ts threadKeyOf/stopAgent).
// WHAT was measured before this spec (code read 2026-09-26): agent_messages.thread had exactly one
//       value per surface -- 'self', 'client:<id>', 'agent:<id>', 'room:<id>' -- so the own thread and
//       a specialist's were ONE conversation forever, and "new conversation" DELETEd the whole thread;
//       agentStream held a single boolean inFlight, so a question to one agent waited in the queue
//       behind another agent's answer, though the server already ran turns side by side.
// WHY a suffix on the same thread key and not a new column or table: the four routes and both apps
//       already speak agent_messages.thread; base+'~'+id keeps every existing row (the base thread is
//       the first conversation, migrated nothing) and a caller that names no id is byte-for-byte
//       unchanged -- the bot included.
// WHY only the own thread and a specialist split: a client's thread is one conversation ABOUT one
//       person whoever helps in it (crm-client-workspace.t27), and a room's memory belongs to the room
//       (issue #2644); withConversation refuses an id on either.
// Claim status: contract, gates and pure rules written and unit-tested with doubles and a real
//       Postgres on both sides (render several-conversations.test.ts; player conversations.test.ts,
//       agentQueue.test.ts, ConversationRail.test.tsx). Being SEEN live is shown by the host, not here.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::agent_conversations {

    pub const KIND : str = "automation";
    pub const ID : str = "agent-conversations";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 1;

    // ---- The conversation id ----------------------------------------------------------------
    pub const ID_MIN_LEN : u8 = 4;
    pub const ID_MAX_LEN : u8 = 24;
    pub const SEP : str = "~";                    // base thread + '~' + id
    pub const NO_ID_IS_BASE : bool = true;        // the conversation that was there first
    pub const MALFORMED_IS_400 : bool = true;     // never silently a thread name

    // ---- Which threads split --------------------------------------------------------------
    pub const SELF_SPLITS : bool = true;          // the person's own thread
    pub const SPECIALIST_SPLITS : bool = true;    // a hired marketplace agent's thread
    pub const CLIENT_SPLITS : bool = false;       // one conversation about one person
    pub const ROOM_SPLITS : bool = false;         // memory belongs to the room
    pub const QUEEN_SPLITS : bool = false;        // the supervisor beside a client

    // ---- The gate order -------------------------------------------------------------------
    // threadFor decides whether the base thread is the caller's AT ALL; only then does
    // withConversation add the id. So a conversation id never opens anything its base did not.
    pub const BASE_GATE_FIRST : bool = true;
    pub const NO_ID_LEAVES_GATE_UNTOUCHED : bool = true;  // every existing caller unchanged

    // ---- Storage & routes -----------------------------------------------------------------
    pub const THREAD_COLUMN : str = "thread";
    pub const ROUTES_WITH_CONVERSATION : u8 = 4;  // chat, history GET, history POST, history DELETE
    pub const LIST_ROUTE : str = "/api/agent/conversations";  // GET list, POST name
    pub const DELETE_FORGETS_TITLE : bool = true; // a deleted conversation takes its name with it
    pub const TITLE_FALLBACK : str = "first-user-message";  // no given name -> the first question

    // ---- One stream per conversation (the app) --------------------------------------------
    pub const STREAM_PER_CONVERSATION : bool = true;   // one busy chat never holds another
    pub const QUEUE_PER_CONVERSATION : bool = true;    // a queued line goes to ITS conversation
    pub const STOP_CUTS_ONE : bool = true;             // Stop aborts this stream only, drops its queue
    pub const DRAFT_PER_CONVERSATION : bool = true;    // a half-written task stays in its own chat

    // ---- Not claimed ----------------------------------------------------------------------
    pub const SEEN_LIVE : bool = false;  // the rail opened on app.t27.ai is shown by the host

    struct Conversation {
        len: u8,
        splits: bool,
    }

    // The stored thread splits into a conversation only for the own and specialist threads.
    fn base_splits(is_self: bool, is_specialist: bool, is_client: bool, is_room: bool) -> bool {
        return (is_self || is_specialist) && !is_client && !is_room;
    }

    // A conversation id is well formed: length within bounds. (Charset is checked in host regex.)
    fn id_well_formed(len: u8) -> bool {
        return len >= ID_MIN_LEN && len <= ID_MAX_LEN;
    }

    // withConversation: the id is accepted only when the base gate already passed AND the base
    // splits AND the id is well formed; otherwise the request is refused, never silently rebased.
    fn conversation_accepted(base_ok: bool, base_splits_v: bool, id_len: u8, has_id: bool) -> bool {
        if !has_id { return base_ok; }             // no id: the gate is returned untouched
        return base_ok && base_splits_v && id_well_formed(id_len);
    }

    test "an id splits only the own and specialist threads, never a client, room or queen thread"
        assert(base_splits(true, false, false, false));    // self
        assert(base_splits(false, true, false, false));    // specialist
        assert(!base_splits(false, false, true, false));   // client
        assert(!base_splits(false, false, false, true));   // room
        assert(SELF_SPLITS && SPECIALIST_SPLITS);
        assert(!CLIENT_SPLITS && !ROOM_SPLITS && !QUEEN_SPLITS);

    test "a well formed id is four to twenty-four long; outside that it is refused, not rebased"
        assert(id_well_formed(4));
        assert(id_well_formed(24));
        assert(!id_well_formed(3));
        assert(!id_well_formed(25));
        assert(MALFORMED_IS_400);

    test "no id leaves the gate as it was, so every existing caller keeps its thread"
        assert(NO_ID_LEAVES_GATE_UNTOUCHED);
        assert(conversation_accepted(true, true, 0, false));    // base ok, no id -> ok
        assert(!conversation_accepted(false, true, 0, false));  // base refused, no id -> refused
        assert(NO_ID_IS_BASE);

    test "an id opens nothing its base thread did not, and only where the base splits"
        assert(BASE_GATE_FIRST);
        assert(conversation_accepted(true, true, 8, true));     // ok base, splits, good id
        assert(!conversation_accepted(false, true, 8, true));   // base refused -> refused
        assert(!conversation_accepted(true, false, 8, true));   // client/room base -> refused
        assert(!conversation_accepted(true, true, 2, true));    // bad id -> refused

    test "the routes, the list and the deletion carry the conversation through unchanged"
        assert(ROUTES_WITH_CONVERSATION == 4);
        assert(LIST_ROUTE == "/api/agent/conversations");
        assert(DELETE_FORGETS_TITLE);
        assert(TITLE_FALLBACK == "first-user-message");
        assert(SEP == "~");

    test "the app runs one stream, queue, Stop and draft per conversation, not one for all"
        assert(STREAM_PER_CONVERSATION);
        assert(QUEUE_PER_CONVERSATION);
        assert(STOP_CUTS_ONE);
        assert(DRAFT_PER_CONVERSATION);

    test "only the rail being seen live is left unclaimed"
        assert(!SEEN_LIVE);
        assert(VERSION == 1);
        assert(ID == "agent-conversations");
}
