// SPDX-License-Identifier: Apache-2.0
// specs/automation/crm-first-screen.t27 -- the CRM work tab on a phone opens on the first
// person waiting for an answer, and on the press that starts the reply, inside Telegram's
// own first screen -- not below it.
// Host: 999-multibots-telegraf apps/vibee-editor/player/src/lib/crmPhone.ts (the rules),
//       src/pages/Crm.tsx (the order of the work tab), src/components/Crm/AutoPanel.tsx (the
//       AUTO line), src/components/Crm/FunnelStrip.css (the pills); measured by the repo's
//       bin/helpers/shot.mjs (`tri shot crm`: the `fold` line, with Telegram's insets).
// Generated: `t27c gen-ts` of this file is vendored into the host as
//       apps/vibee-editor/player/src/spec/crm-first-screen.gen.ts. The host imports the
//       numbers below from there and never restates them; a host test runs every test here.
// Why: measured 2026-10-07 with `tri shot crm` at 390x844, every control 44 px and nothing
//       cut, the first person waiting ended at 926 px and their Prepare at 1065 px, while
//       the tab bar starts at 787. Above them: the AUTO switch at full size while OFF
//       (~220 px), the level chips on two lines, the funnel stacked two rows high, a count
//       line printing zeros, and "everyone waiting for AUTO" between the heading and the
//       first row. A real phone has less: Telegram in fullscreen keeps its own Close and
//       menu row and the device's status bar at the top, and the home indicator at the
//       bottom.
// Laws:
//   - A phone is the page's own phone width; the rules below change nothing wider.
//   - On a phone the people waiting come BEFORE the funnel (owner, 2026-10-07: the counts
//     are read at a glance and keep, the first person's Prepare does not). The AUTO line
//     stays above them: folded while off, and when on its stop must be in sight.
//   - On a phone the AUTO switch is ONE LINE once its state is read, off or on (v2). Off,
//     the line names the state and opens the panel; it turns nothing on -- the scope is
//     chosen first. On, the line carries the stop: one press turns AUTO off. A press on
//     the line can only make things safer. An unread switch says so at full size.
//   - A count of zero is not printed: "time to return: 0" cost the English line a second row.
//   - Funnel pills (stage and count side by side) only from PILLS_MIN_PX: below it five
//     pills wrap to three rows, as tall as two stacked ones.
//   - The first screen is Telegram's: the bars fixed to the bottom start the line, less the
//     home indicator, less the status bar and Telegram's own row on top.
// Claim status: v1 written 2026-10-07 with its host (P31 numbers, P32 order); measured in
//       Chromium by `tri shot crm` at 390x844 against tg_line: name 478, reason 518,
//       Prepare 617 of 648 px, Russian and English alike; not yet on a live iPhone.
// v1 (2026-10-07): the phone width, the pill width, Telegram's insets, the AUTO fold, the
//       count line and the phone order.
// v2 (2026-10-08, owner: "do variant 2, AUTO on in one line"): v1 kept AUTO full size while
//       it was on, about 220 px above the people, so the first person's Prepare left the
//       first screen exactly when AUTO was writing to people by itself. On is one line too
//       now, and that line holds the stop. The first screen is promised on or off.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::crm_first_screen {

    pub const KIND : str = "automation";
    pub const ID : str = "crm-first-screen";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 2;

    // ---- What counts as a phone -----------------------------------------------------------
    pub const PHONE_MAX_PX : u16 = 480;  // the page's own phone width (Crm.css lays rows out)
    pub const PILLS_MIN_PX : u16 = 360;  // below it the five funnel pills take three rows

    // ---- Telegram's first screen, fullscreen, a phone with a Dynamic Island ---------------
    pub const TG_DEVICE_TOP_PX : u16 = 59;   // the status bar (safeAreaInset.top)
    pub const TG_BUTTONS_TOP_PX : u16 = 46;  // Close and menu (contentSafeAreaInset.top)
    pub const TG_HOME_BOTTOM_PX : u16 = 34;  // the home indicator (safeAreaInset.bottom)

    // ---- What a press on the AUTO line does (v2) -------------------------------------------
    pub const ACTION_NONE : u8 = 0;   // off: the line opens the panel, and that is all
    pub const ACTION_STOP : u8 = 1;   // on: the line's own button turns AUTO off
    pub const ACTION_START : u8 = 2;  // never on the line: the scope is chosen first

    // ---- The order of the work tab --------------------------------------------------------
    pub const ORDER_PHONE : [3]str = ["auto", "waiting", "funnel"];
    pub const ORDER_WIDE : [3]str = ["funnel", "auto", "waiting"];

    // ---- What the first screen holds -------------------------------------------------------
    // Whether AUTO is off or on (v2): on, its one line carries the stop.
    pub const FIRST_SCREEN_NAME : bool = true;     // who waits, at any width
    pub const FIRST_SCREEN_REASON : bool = true;   // why they wait, from PILLS_MIN_PX up
    pub const FIRST_SCREEN_PREPARE : bool = true;  // the press that starts the reply,
                                                   // from PILLS_MIN_PX up

    // A width is a phone when it is at most the page's phone width.
    fn is_phone(width: u16) -> bool {
        return width <= PHONE_MAX_PX;
    }

    // The funnel draws pills on a phone wide enough for two rows of them.
    fn pills(width: u16) -> bool {
        return width >= PILLS_MIN_PX && width <= PHONE_MAX_PX;
    }

    // The AUTO switch is one line on a phone once its state is read, off or on.
    fn auto_line(phone: bool, reachable: bool) -> bool {
        return phone && reachable;
    }

    // The one action the AUTO line carries besides opening the panel.
    fn line_action(on: bool) -> u8 {
        if on {
            return ACTION_STOP;
        }
        return ACTION_NONE;
    }

    // A kind of waiting is named only when somebody is in it.
    fn count_shown(n: u16) -> bool {
        return n > 0;
    }

    // The people waiting come before the funnel only on a phone.
    fn waiting_before_funnel(phone: bool) -> bool {
        return phone;
    }

    // What Telegram keeps at the top of the screen in fullscreen.
    fn tg_top() -> u16 {
        return TG_DEVICE_TOP_PX + TG_BUTTONS_TOP_PX;
    }

    // Where Telegram's first screen ends, in page pixels from the top, given where the bars
    // fixed to the bottom of the viewport begin.
    fn tg_line(bars_top: u16) -> u16 {
        return bars_top - TG_HOME_BOTTOM_PX - tg_top();
    }

    // A thing ending at `end` (page pixels from the top) is on Telegram's first screen.
    fn on_first_screen(end: u16, bars_top: u16) -> bool {
        return end <= tg_line(bars_top);
    }

    test "a phone is the page's own phone width" {
        assert(is_phone(320));
        assert(is_phone(390));
        assert(is_phone(480));
        assert(!is_phone(481));
    }

    test "the funnel draws pills only where they save a row" {
        assert(pills(360));
        assert(pills(390));
        assert(pills(480));
        assert(!pills(359));
        assert(!pills(320));
        assert(!pills(481));
    }

    test "AUTO is one line on a phone once read, off or on" {
        assert(auto_line(true, true));
        assert(!auto_line(true, false));
        assert(!auto_line(false, true));
        assert(!auto_line(false, false));
    }

    test "a press on the AUTO line can only make things safer" {
        assert(line_action(true) == ACTION_STOP);
        assert(line_action(false) == ACTION_NONE);
        assert(line_action(true) != ACTION_START);
        assert(line_action(false) != ACTION_START);
    }

    test "a count of zero is not printed" {
        assert(!count_shown(0));
        assert(count_shown(1));
        assert(count_shown(12));
    }

    test "on a phone the people waiting come before the funnel" {
        assert(waiting_before_funnel(true));
        assert(!waiting_before_funnel(false));
    }

    test "Telegram's first screen at 390x844 ends at 648 px" {
        assert(tg_top() == 105);
        assert(tg_line(787) == 648);
        assert(on_first_screen(648, 787));
        assert(!on_first_screen(649, 787));
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
