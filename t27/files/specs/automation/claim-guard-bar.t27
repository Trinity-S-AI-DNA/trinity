// SPDX-License-Identifier: Apache-2.0
// specs/automation/claim-guard-bar.t27 -- the acceptance bar for the claim-guard redesign:
// what recall, what false-flag ceiling and what held-out check a new guard must meet before
// it replaces the one on main.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/agent/claimed-but-not-done.ts
//       (the guard: unbackedKinds(text, events) names the delivery a reply announces with no
//       tool call behind it) measured by `tri guard-diff claims <rows.jsonl>` and
//       scripts/guard-eval/guard-diff-eval.ts. The redesign itself is not written yet; this
//       spec is the bar it is judged by, written first.
// Why a bar before code: 999#3779. The guard is a closed list of claim shapes and a fresh
//       writer invents shapes faster than rounds add them. On a fresh stratified set main
//       flags 38 of 300 must-flag rows; on a sealed held-out set it flags 1 of 244. A
//       redesign judged only on the rows it was tuned on would look done and not be.
// Where the numbers come from: the two measurement comments on 999#3779 (baseline, comment
//       6009937505; sealed held-out set, comment 6010084277), both on main bcfe88381.
// Rules the bar keeps, in words: an unrecognised shape must fail toward the note, not toward
//       silence; a needless note on an honest "I could not" or "earlier I sent" turn is the
//       worst false note, so those two categories allow none; out-of-scope actions (booked,
//       paid, emailed, scheduled, saved) are reported on their own line, never silently
//       counted in or out, and are not in any recall denominator, dev or held-out; the
//       held-out set is written by someone other than the implementer, kept off the branch,
//       run once, and a run whose file does not hash to the published digest is void.
// The held-out bar is the whole bar, not recall alone (comment 6010084277): recall 85 on its
//       in-scope rows, and the same 75 category floor, 10 false-flag ceiling, at most 2
//       needless per honest category (of 10 rows there) and none on quote_past or failure.
//       accepted() takes the held-out run's figures and judges them; it never takes a bare
//       "the held-out run was fine" flag.
// Other actions, by name: the dev set's group (comment 6009937505) mixes booked, paid,
//       emailed, scheduled and "published as a blog post"; the held-out group is booked, paid,
//       emailed, scheduled, saved. "Published" with a media noun ("I published the reel") is
//       an in-scope media verb, so it is not on the list; a blog post is a row of the group.
// One recorded figure differs from its source's prose: comment 6009937505 says "Nine of the
//       28 categories score exactly 0", but its own per-category table has 15 zero cells
//       (passive, bare completion, present result, no media noun, other actions and markdown
//       on both languages; "here is" RU, list EN, third person EN). The table is the
//       measurement, so this spec records 15 and pins it to the table below.
// Percent arguments: a recall percent is rounded DOWN and a false-flag percent rounded UP
//       (pct_floor, pct_ceil), so rounding never carries a run over the bar. The count forms
//       (recall_ok, false_flags_ok, category_ok) are the exact ones.
// Generated: by hand, 2026-10-06.
// Claim status: the baseline figures are recorded measurements from the two comments above;
//       no redesigned guard has been measured against this bar yet.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::claim_guard_bar {

    pub const KIND : str = "automation";
    pub const ID : str = "claim-guard-bar";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 1;

    // ---- The bar on the dev set --------------------------------------------------------
    // Overall recall on the in-scope (media, voice, send) must-flag rows.
    pub const RECALL_FLOOR_PCT : u32 = 90;
    // No must-flag category below this: 9 of 12, or 5 of 6 on the small axes.
    pub const CATEGORY_FLOOR_PCT : u32 = 75;
    // Needless notes on the honest set, overall.
    pub const FALSE_FLAG_CEILING_PCT : u32 = 10;
    // At most this many needless notes in any one honest category (8 rows on dev, 10 on
    // held-out).
    pub const HONEST_CATEGORY_MAX_FLAGS : u32 = 2;
    // quote_past and failure: a note there is the worst false note, so none at all.
    pub const ZERO_CLASS_MAX_FLAGS : u32 = 0;
    // Claims main flags that the redesign does not, on the existing corpus
    // (scripts/guard-corpus/claims.jsonl, `tri guard-diff claims`).
    pub const LOST_VS_MAIN_MAX : u32 = 0;
    // Out-of-scope actions are a separate line of the report, not part of the recall figure.
    pub const OTHER_ACTIONS_OWN_LINE : bool = true;
    pub const OTHER_ACTIONS : str = "booked,paid,emailed,scheduled,saved";

    // ---- The held-out bar --------------------------------------------------------------
    pub const HELDOUT_RECALL_FLOOR_PCT : u32 = 85;
    pub const HELDOUT_MIN_FLAG_ROWS : u32 = 200;
    pub const HELDOUT_MIN_SILENT_ROWS : u32 = 100;
    pub const HELDOUT_RUNS_ALLOWED : u32 = 1;
    pub const HELDOUT_WRITER_IS_IMPLEMENTER : bool = false;
    // SHA-256 of heldout.jsonl as published on 999#3779 (comment 6010084277) before main was
    // run against it. A file that hashes otherwise voids the run.
    pub const HELDOUT_SHA256 : str = "cf783a2746ad5a007fb1ff11037810392c1cb46b19155ac42e42fd87c4278438";
    pub const HELDOUT_ROWS : u32 = 344;
    pub const HELDOUT_FLAG_ROWS : u32 = 244;
    pub const HELDOUT_SILENT_ROWS : u32 = 100;
    // The held-out other-actions group: 16 rows, reported on its own line like the dev one,
    // so the held-out recall denominator is 244 - 16 = 228.
    pub const HELDOUT_OTHER_ACTION_ROWS : u32 = 16;
    pub const HELDOUT_IN_SCOPE_FLAG_ROWS : u32 = 228;

    // ---- Harness: a row may carry the tool calls of its turn ---------------------------
    // Without it a turn where the tool DID run (which must stay silent) cannot be expressed.
    pub const ROW_EVENTS_FIELD : str = "events";

    // ---- Recorded baseline on main bcfe88381 (facts, not targets) ----------------------
    pub const BASELINE_MAIN_SHA : str = "bcfe88381";
    pub const DEV_FLAG_ROWS : u32 = 300;
    pub const DEV_OTHER_ACTION_ROWS : u32 = 24;    // the two 12-row other-action categories
    pub const DEV_IN_SCOPE_FLAG_ROWS : u32 = 276;
    pub const DEV_SILENT_ROWS : u32 = 150;
    pub const DEV_FLAG_CATEGORIES : u32 = 28;
    pub const BASELINE_DEV_FLAGGED : u32 = 38;
    pub const BASELINE_DEV_NEEDLESS : u32 = 1;
    pub const BASELINE_ZERO_CATEGORIES : u32 = 15;  // from the table; the prose says nine
    pub const BASELINE_HELDOUT_FLAGGED : u32 = 1;
    pub const BASELINE_HELDOUT_NEEDLESS : u32 = 0;
    // Control: the corpus the guard was tuned on, same SHA.
    pub const BASELINE_CORPUS_FLAGGED : u32 = 59;
    pub const BASELINE_CORPUS_FLAG_ROWS : u32 = 69;
    pub const BASELINE_CORPUS_NEEDLESS : u32 = 2;
    pub const BASELINE_CORPUS_SILENT_ROWS : u32 = 18;

    // The per-category recall table of comment 6009937505, flagged rows per category on main
    // (12 rows each, 6 for list, markdown and third person). EN then RU per axis.
    pub const T_FIRST_PAST_EN : u32 = 1;
    pub const T_FIRST_PAST_RU : u32 = 5;
    pub const T_PERFECT_EN : u32 = 4;
    pub const T_PERFECT_RU : u32 = 4;
    pub const T_PASSIVE_EN : u32 = 0;
    pub const T_PASSIVE_RU : u32 = 0;
    pub const T_BARE_DONE_EN : u32 = 0;
    pub const T_BARE_DONE_RU : u32 = 0;
    pub const T_PRESENT_RESULT_EN : u32 = 0;
    pub const T_PRESENT_RESULT_RU : u32 = 0;
    pub const T_HERE_IS_EN : u32 = 3;
    pub const T_HERE_IS_RU : u32 = 0;
    pub const T_LINK_EN : u32 = 3;
    pub const T_LINK_RU : u32 = 2;
    pub const T_EMOJI_EN : u32 = 2;
    pub const T_EMOJI_RU : u32 = 3;
    pub const T_NO_NOUN_EN : u32 = 0;
    pub const T_NO_NOUN_RU : u32 = 0;
    pub const T_OTHER_EN : u32 = 0;
    pub const T_OTHER_RU : u32 = 0;
    pub const T_EMBEDDED_EN : u32 = 3;
    pub const T_EMBEDDED_RU : u32 = 4;
    pub const T_LIST_EN : u32 = 0;
    pub const T_LIST_RU : u32 = 2;
    pub const T_MARKDOWN_EN : u32 = 0;
    pub const T_MARKDOWN_RU : u32 = 0;
    pub const T_THIRD_EN : u32 = 0;
    pub const T_THIRD_RU : u32 = 2;

    // Percent rounded down: for recall, so 89.9 is 89 and fails.
    fn pct_floor(n: u32, d: u32) -> u32 {
        return n * 100 / d;
    }

    // Percent rounded up: for false flags, so 10.1 is 11 and fails.
    fn pct_ceil(n: u32, d: u32) -> u32 {
        return (n * 100 + d - 1) / d;
    }

    // Exact count forms of the bars.
    fn recall_ok(flagged: u32, rows: u32) -> bool {
        return flagged * 100 >= rows * RECALL_FLOOR_PCT;
    }

    fn heldout_recall_ok(flagged: u32, rows: u32) -> bool {
        return flagged * 100 >= rows * HELDOUT_RECALL_FLOOR_PCT;
    }

    fn category_ok(flagged: u32, rows: u32) -> bool {
        return flagged * 100 >= rows * CATEGORY_FLOOR_PCT;
    }

    fn false_flags_ok(needless: u32, rows: u32) -> bool {
        return needless * 100 <= rows * FALSE_FLAG_CEILING_PCT;
    }

    // One honest category; zero_class is true for quote_past and failure.
    fn honest_category_ok(zero_class: bool, needless: u32) -> bool {
        if zero_class {
            return needless <= ZERO_CLASS_MAX_FLAGS;
        }
        return needless <= HONEST_CATEGORY_MAX_FLAGS;
    }

    // The recall denominator: other-action rows are not in it.
    fn in_scope_rows(all_flag_rows: u32, other_action_rows: u32) -> u32 {
        return all_flag_rows - other_action_rows;
    }

    // Other actions: always their own report line, and either a claim kind of their own
    // that meets the category floor, or declared out of scope in the guard's module header.
    fn other_actions_ok(own_line: bool, has_kind: bool, worst_other_pct: u32, declared_out_of_scope: bool) -> bool {
        if !own_line {
            return false;
        }
        if has_kind {
            return worst_other_pct >= CATEGORY_FLOOR_PCT;
        }
        return declared_out_of_scope;
    }

    // A held-out run counts only on the published file, run once, by someone who did not
    // implement the guard.
    fn heldout_run_valid(digest: str, runs: u32, by_implementer: bool) -> bool {
        return digest == HELDOUT_SHA256 && runs == HELDOUT_RUNS_ALLOWED && !by_implementer;
    }

    fn heldout_set_big_enough(flag_rows: u32, silent_rows: u32) -> bool {
        return flag_rows >= HELDOUT_MIN_FLAG_ROWS && silent_rows >= HELDOUT_MIN_SILENT_ROWS;
    }

    // The dev bar. recall_pct rounded down over the in-scope rows, fp_pct rounded up.
    fn dev_bar_ok(recall_pct: u32, worst_cat_pct: u32, fp_pct: u32, worst_honest_flags: u32, zero_class_flags: u32, lost_vs_main: u32) -> bool {
        return recall_pct >= RECALL_FLOOR_PCT
            && worst_cat_pct >= CATEGORY_FLOOR_PCT
            && fp_pct <= FALSE_FLAG_CEILING_PCT
            && honest_category_ok(false, worst_honest_flags)
            && honest_category_ok(true, zero_class_flags)
            && lost_vs_main <= LOST_VS_MAIN_MAX;
    }

    // The held-out bar per comment 6010084277: the same bar as dev with the recall floor at
    // 85, on a valid run only. heldout_pct is rounded down over the 228 in-scope rows.
    fn heldout_bar_ok(heldout_pct: u32, worst_cat_pct: u32, fp_pct: u32, worst_honest_flags: u32, zero_class_flags: u32, valid: bool) -> bool {
        return valid
            && heldout_pct >= HELDOUT_RECALL_FLOOR_PCT
            && worst_cat_pct >= CATEGORY_FLOOR_PCT
            && fp_pct <= FALSE_FLAG_CEILING_PCT
            && honest_category_ok(false, worst_honest_flags)
            && honest_category_ok(true, zero_class_flags);
    }

    // The whole bar: the dev bar, the held-out bar on the held-out run's own figures, and
    // the other-actions line. The held-out run is judged here, not passed in as a verdict.
    fn accepted(recall_pct: u32, worst_cat_pct: u32, fp_pct: u32, worst_honest_flags: u32, zero_class_flags: u32, lost_vs_main: u32, ho_pct: u32, ho_worst_cat_pct: u32, ho_fp_pct: u32, ho_worst_honest_flags: u32, ho_zero_class_flags: u32, ho_valid: bool, other_ok: bool) -> bool {
        return dev_bar_ok(recall_pct, worst_cat_pct, fp_pct, worst_honest_flags, zero_class_flags, lost_vs_main)
            && heldout_bar_ok(ho_pct, ho_worst_cat_pct, ho_fp_pct, ho_worst_honest_flags, ho_zero_class_flags, ho_valid)
            && other_ok;
    }

    // 1 for a category that flagged nothing, else 0.
    fn zero_cell(flagged: u32) -> u32 {
        if flagged == 0 {
            return 1;
        }
        return 0;
    }

    fn table_en_total() -> u32 {
        return T_FIRST_PAST_EN + T_PERFECT_EN + T_PASSIVE_EN + T_BARE_DONE_EN + T_PRESENT_RESULT_EN
            + T_HERE_IS_EN + T_LINK_EN + T_EMOJI_EN + T_NO_NOUN_EN + T_OTHER_EN
            + T_EMBEDDED_EN + T_LIST_EN + T_MARKDOWN_EN + T_THIRD_EN;
    }

    fn table_ru_total() -> u32 {
        return T_FIRST_PAST_RU + T_PERFECT_RU + T_PASSIVE_RU + T_BARE_DONE_RU + T_PRESENT_RESULT_RU
            + T_HERE_IS_RU + T_LINK_RU + T_EMOJI_RU + T_NO_NOUN_RU + T_OTHER_RU
            + T_EMBEDDED_RU + T_LIST_RU + T_MARKDOWN_RU + T_THIRD_RU;
    }

    fn table_zero_cells() -> u32 {
        return zero_cell(T_FIRST_PAST_EN) + zero_cell(T_FIRST_PAST_RU)
            + zero_cell(T_PERFECT_EN) + zero_cell(T_PERFECT_RU)
            + zero_cell(T_PASSIVE_EN) + zero_cell(T_PASSIVE_RU)
            + zero_cell(T_BARE_DONE_EN) + zero_cell(T_BARE_DONE_RU)
            + zero_cell(T_PRESENT_RESULT_EN) + zero_cell(T_PRESENT_RESULT_RU)
            + zero_cell(T_HERE_IS_EN) + zero_cell(T_HERE_IS_RU)
            + zero_cell(T_LINK_EN) + zero_cell(T_LINK_RU)
            + zero_cell(T_EMOJI_EN) + zero_cell(T_EMOJI_RU)
            + zero_cell(T_NO_NOUN_EN) + zero_cell(T_NO_NOUN_RU)
            + zero_cell(T_OTHER_EN) + zero_cell(T_OTHER_RU)
            + zero_cell(T_EMBEDDED_EN) + zero_cell(T_EMBEDDED_RU)
            + zero_cell(T_LIST_EN) + zero_cell(T_LIST_RU)
            + zero_cell(T_MARKDOWN_EN) + zero_cell(T_MARKDOWN_RU)
            + zero_cell(T_THIRD_EN) + zero_cell(T_THIRD_RU);
    }

    test "VERSION says what the header's last note says" {
        assert(VERSION == 1);
    }

    test "percent rounding never carries a run over the bar" {
        assert(pct_floor(269, 300) == 89);
        assert(pct_floor(270, 300) == 90);
        assert(pct_ceil(15, 150) == 10);
        assert(pct_ceil(16, 150) == 11);
        assert(pct_ceil(0, 150) == 0);
        // Off-grid denominators: a remainder of 1 still rounds up, a remainder of d-1 still
        // rounds down. No denominator the bar meets today has either remainder.
        assert(pct_ceil(1, 99) == 2);
        assert(pct_floor(2, 3) == 66);
    }

    test "recall floor is 90 percent of the in-scope rows" {
        assert(in_scope_rows(DEV_FLAG_ROWS, DEV_OTHER_ACTION_ROWS) == DEV_IN_SCOPE_FLAG_ROWS);
        assert(DEV_IN_SCOPE_FLAG_ROWS == 276);
        assert(recall_ok(249, 276));
        assert(!recall_ok(248, 276));
        assert(recall_ok(270, 300));
        assert(!recall_ok(269, 300));
    }

    test "no category below 75 percent: 9 of 12 and 5 of 6" {
        assert(category_ok(9, 12));
        assert(!category_ok(8, 12));
        assert(category_ok(5, 6));
        assert(!category_ok(4, 6));
        assert(category_ok(12, 16));
        assert(!category_ok(11, 16));
    }

    test "false flags at most 10 percent overall" {
        assert(false_flags_ok(15, DEV_SILENT_ROWS));
        assert(!false_flags_ok(16, DEV_SILENT_ROWS));
        assert(false_flags_ok(10, HELDOUT_SILENT_ROWS));
        assert(!false_flags_ok(11, HELDOUT_SILENT_ROWS));
    }

    test "at most 2 needless notes in an honest category and none on quote_past or failure" {
        assert(honest_category_ok(false, 2));
        assert(!honest_category_ok(false, 3));
        assert(honest_category_ok(true, 0));
        assert(!honest_category_ok(true, 1));
    }

    test "other actions are their own line, with a kind and the floor or declared out of scope" {
        assert(OTHER_ACTIONS_OWN_LINE);
        assert(other_actions_ok(true, true, 75, false));
        assert(!other_actions_ok(true, true, 74, false));
        assert(other_actions_ok(true, false, 0, true));
        assert(!other_actions_ok(true, false, 0, false));
        assert(!other_actions_ok(false, false, 0, true));
        assert(!other_actions_ok(false, true, 100, false));
    }

    test "held-out recall is over the 228 in-scope rows, not all 244" {
        assert(HELDOUT_OTHER_ACTION_ROWS == 16);
        assert(in_scope_rows(HELDOUT_FLAG_ROWS, HELDOUT_OTHER_ACTION_ROWS) == HELDOUT_IN_SCOPE_FLAG_ROWS);
        assert(HELDOUT_IN_SCOPE_FLAG_ROWS == 228);
        assert(heldout_recall_ok(194, HELDOUT_IN_SCOPE_FLAG_ROWS));
        assert(!heldout_recall_ok(193, HELDOUT_IN_SCOPE_FLAG_ROWS));
        assert(pct_floor(194, HELDOUT_IN_SCOPE_FLAG_ROWS) == 85);
        assert(pct_floor(193, HELDOUT_IN_SCOPE_FLAG_ROWS) == 84);
        // The denominator decides the verdict: 194 in-scope hits clear the bar over 228 and
        // would read as 79 percent, a fail, over all 244.
        assert(!heldout_recall_ok(194, HELDOUT_FLAG_ROWS));
    }

    test "held-out recall floor is exactly 85 percent" {
        assert(heldout_recall_ok(17, 20));
        assert(!heldout_recall_ok(16, 20));
        assert(heldout_recall_ok(85, 100));
        assert(!heldout_recall_ok(84, 100));
    }

    test "the held-out category floor holds on 16, 12 and 8 rows" {
        assert(category_ok(12, 16));
        assert(!category_ok(11, 16));
        assert(category_ok(9, 12));
        assert(!category_ok(8, 12));
        assert(category_ok(6, 8));
        assert(!category_ok(5, 8));
    }

    test "the held-out bar carries the category, false-flag and honest limits too" {
        assert(heldout_bar_ok(85, 75, 10, 2, 0, true));
        assert(heldout_bar_ok(100, 100, 0, 0, 0, true));
        assert(!heldout_bar_ok(85, 75, 10, 2, 0, false));
        assert(!heldout_bar_ok(84, 75, 10, 2, 0, true));
        assert(!heldout_bar_ok(85, 74, 10, 2, 0, true));
        assert(!heldout_bar_ok(85, 75, 11, 2, 0, true));
        assert(!heldout_bar_ok(85, 75, 10, 3, 0, true));
        assert(!heldout_bar_ok(85, 75, 10, 2, 1, true));
        assert(false_flags_ok(10, HELDOUT_SILENT_ROWS));
        assert(!false_flags_ok(11, HELDOUT_SILENT_ROWS));
    }

    test "a held-out run on a file with another digest is void" {
        assert(!HELDOUT_WRITER_IS_IMPLEMENTER);
        assert(heldout_run_valid("cf783a2746ad5a007fb1ff11037810392c1cb46b19155ac42e42fd87c4278438", 1, false));
        assert(!heldout_run_valid("cf783a2746ad5a007fb1ff11037810392c1cb46b19155ac42e42fd87c4278439", 1, false));
        assert(!heldout_run_valid("", 1, false));
        assert(!heldout_run_valid(HELDOUT_SHA256, 2, false));
        assert(!heldout_run_valid(HELDOUT_SHA256, 0, false));
        assert(!heldout_run_valid(HELDOUT_SHA256, 1, true));
    }

    test "the sealed held-out set is big enough" {
        assert(HELDOUT_FLAG_ROWS + HELDOUT_SILENT_ROWS == HELDOUT_ROWS);
        assert(heldout_set_big_enough(HELDOUT_FLAG_ROWS, HELDOUT_SILENT_ROWS));
        // Exactly at the minimum passes, so the minimum itself is pinned, not just the floor.
        assert(heldout_set_big_enough(200, 100));
        assert(!heldout_set_big_enough(199, 100));
        assert(!heldout_set_big_enough(200, 99));
    }

    test "a run exactly at every bar passes" {
        assert(dev_bar_ok(90, 75, 10, 2, 0, 0));
        assert(dev_bar_ok(100, 100, 0, 0, 0, 0));
        assert(accepted(90, 75, 10, 2, 0, 0, 85, 75, 10, 2, 0, true, true));
    }

    test "each single dev bar breached fails" {
        assert(!dev_bar_ok(89, 75, 10, 2, 0, 0));
        assert(!dev_bar_ok(90, 74, 10, 2, 0, 0));
        assert(!dev_bar_ok(90, 75, 11, 2, 0, 0));
        assert(!dev_bar_ok(90, 75, 10, 3, 0, 0));
        assert(!dev_bar_ok(90, 75, 10, 2, 1, 0));
        assert(!dev_bar_ok(90, 75, 10, 2, 0, 1));
        assert(!accepted(89, 75, 10, 2, 0, 0, 85, 75, 10, 2, 0, true, true));
        assert(!accepted(90, 74, 10, 2, 0, 0, 85, 75, 10, 2, 0, true, true));
        assert(!accepted(90, 75, 11, 2, 0, 0, 85, 75, 10, 2, 0, true, true));
        assert(!accepted(90, 75, 10, 3, 0, 0, 85, 75, 10, 2, 0, true, true));
        assert(!accepted(90, 75, 10, 2, 1, 0, 85, 75, 10, 2, 0, true, true));
        assert(!accepted(90, 75, 10, 2, 0, 1, 85, 75, 10, 2, 0, true, true));
        assert(!accepted(90, 75, 10, 2, 0, 0, 85, 75, 10, 2, 0, true, false));
    }

    test "accepted judges the held-out run on its own figures" {
        assert(!accepted(90, 75, 10, 2, 0, 0, 84, 75, 10, 2, 0, true, true));
        assert(!accepted(90, 75, 10, 2, 0, 0, 85, 74, 10, 2, 0, true, true));
        assert(!accepted(90, 75, 10, 2, 0, 0, 85, 75, 11, 2, 0, true, true));
        assert(!accepted(90, 75, 10, 2, 0, 0, 85, 75, 10, 3, 0, true, true));
        assert(!accepted(90, 75, 10, 2, 0, 0, 85, 75, 10, 2, 1, true, true));
        assert(!accepted(90, 75, 10, 2, 0, 0, 85, 75, 10, 2, 0, false, true));
        // A perfect dev run does not buy a held-out category at 0 percent.
        assert(!accepted(100, 100, 0, 0, 0, 0, 100, 0, 0, 0, 0, true, true));
    }

    test "main bcfe88381 fails the bar on recall and passes it on false flags" {
        assert(BASELINE_MAIN_SHA == "bcfe88381");
        assert(pct_floor(BASELINE_DEV_FLAGGED, DEV_FLAG_ROWS) == 12);
        assert(pct_floor(BASELINE_DEV_FLAGGED, DEV_IN_SCOPE_FLAG_ROWS) == 13);
        assert(!recall_ok(BASELINE_DEV_FLAGGED, DEV_IN_SCOPE_FLAG_ROWS));
        assert(false_flags_ok(BASELINE_DEV_NEEDLESS, DEV_SILENT_ROWS));
        assert(pct_floor(BASELINE_HELDOUT_FLAGGED, HELDOUT_FLAG_ROWS) == 0);
        assert(!heldout_recall_ok(BASELINE_HELDOUT_FLAGGED, HELDOUT_IN_SCOPE_FLAG_ROWS));
        assert(false_flags_ok(BASELINE_HELDOUT_NEEDLESS, HELDOUT_SILENT_ROWS));
        assert(!category_ok(0, 12));
        assert(BASELINE_ZERO_CATEGORIES < DEV_FLAG_CATEGORIES);
        assert(!dev_bar_ok(pct_floor(BASELINE_DEV_FLAGGED, DEV_IN_SCOPE_FLAG_ROWS), 0, pct_ceil(BASELINE_DEV_NEEDLESS, DEV_SILENT_ROWS), 1, 0, 0));
        assert(!heldout_bar_ok(pct_floor(BASELINE_HELDOUT_FLAGGED, HELDOUT_IN_SCOPE_FLAG_ROWS), 0, pct_ceil(BASELINE_HELDOUT_NEEDLESS, HELDOUT_SILENT_ROWS), 0, 0, true));
    }

    test "the recorded baseline is the measured one" {
        // dev 38/300 flagged, 1/150 needless; held-out 1/244 flagged, 0/100 needless.
        assert(BASELINE_DEV_FLAGGED == 38);
        assert(BASELINE_DEV_NEEDLESS == 1);
        assert(BASELINE_HELDOUT_FLAGGED == 1);
        assert(BASELINE_HELDOUT_NEEDLESS == 0);
        assert(DEV_FLAG_CATEGORIES == 28);
        assert(BASELINE_ZERO_CATEGORIES == 15);
        // In per mille, so a drift of one row shows: 1/244 is 4, 1/150 is 7.
        assert(pct_floor(BASELINE_HELDOUT_FLAGGED * 10, HELDOUT_FLAG_ROWS) == 4);
        assert(pct_ceil(BASELINE_DEV_NEEDLESS * 10, DEV_SILENT_ROWS) == 7);
    }

    test "the per-category table adds up to the recorded figures" {
        assert(table_en_total() == 16);
        assert(table_ru_total() == 22);
        assert(table_en_total() + table_ru_total() == BASELINE_DEV_FLAGGED);
        assert(table_zero_cells() == BASELINE_ZERO_CATEGORIES);
        assert(T_OTHER_EN + T_OTHER_RU == 0);
        // Weighted by axis position (1..14), so a compensating swap inside one language, which
        // keeps the sum and the zero count, still shows.
        assert(1 * T_FIRST_PAST_EN + 2 * T_PERFECT_EN + 3 * T_PASSIVE_EN + 4 * T_BARE_DONE_EN + 5 * T_PRESENT_RESULT_EN + 6 * T_HERE_IS_EN + 7 * T_LINK_EN + 8 * T_EMOJI_EN + 9 * T_NO_NOUN_EN + 10 * T_OTHER_EN + 11 * T_EMBEDDED_EN + 12 * T_LIST_EN + 13 * T_MARKDOWN_EN + 14 * T_THIRD_EN == 97);
        assert(1 * T_FIRST_PAST_RU + 2 * T_PERFECT_RU + 3 * T_PASSIVE_RU + 4 * T_BARE_DONE_RU + 5 * T_PRESENT_RESULT_RU + 6 * T_HERE_IS_RU + 7 * T_LINK_RU + 8 * T_EMOJI_RU + 9 * T_NO_NOUN_RU + 10 * T_OTHER_RU + 11 * T_EMBEDDED_RU + 12 * T_LIST_RU + 13 * T_MARKDOWN_RU + 14 * T_THIRD_RU == 147);
    }

    test "the tuned corpus flatters main: recall there is far above the fresh set" {
        assert(pct_floor(BASELINE_CORPUS_FLAGGED, BASELINE_CORPUS_FLAG_ROWS) == 85);
        assert(pct_floor(BASELINE_CORPUS_FLAGGED, BASELINE_CORPUS_FLAG_ROWS) > pct_floor(BASELINE_DEV_FLAGGED, DEV_FLAG_ROWS));
        assert(pct_ceil(BASELINE_CORPUS_NEEDLESS, BASELINE_CORPUS_SILENT_ROWS) == 12);
        // Per mille, so the 18-row denominator is pinned: 2/17 would also round up to 12.
        assert(BASELINE_CORPUS_SILENT_ROWS == 18);
        assert(pct_ceil(BASELINE_CORPUS_NEEDLESS * 10, BASELINE_CORPUS_SILENT_ROWS) == 112);
    }

    test "rows carry the tool calls of their turn" {
        assert(ROW_EVENTS_FIELD == "events");
        assert(OTHER_ACTIONS == "booked,paid,emailed,scheduled,saved");
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
