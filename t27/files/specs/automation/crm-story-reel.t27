    // ---- The house's names, read as a reader reads them (v23) ----------------------------------
    // The text and every mark are folded the same way before they are compared: NFKC (the
    // superscript three is a 3, a full-width letter is its letter), invisible characters dropped,
    // one case, and each Cyrillic letter whose capital looks like a Latin capital read as that
    // Latin letter (Te is T, Er is P, En is H; LOOKALIKE_LATIN lists the Latin side). Greek is not
    // folded: the leak is a model writing Russian that mixes the two scripts it writes. Then each
    // mark found is judged by what stands around it -- a name (name_mark), the brand as a code
    // (code_mark), the product as one code token (product_mark). The rows of 999#3564 are vectors
    // the host runs through its detector; the Russian row, Trinity in Cyrillic with a Latin T, is
    // kept by the host, as this file stays ASCII.
    pub const FOLD_LOOKALIKES : bool = true;  // a Cyrillic look-alike reads as its Latin letter
    pub const INVISIBLES_DROPPED : bool = true;  // a zero-width or soft-hyphen character splits no mark
    pub const LOOKALIKE_LATIN : str = "abcdehijkmopqstwxy";  // the Latin letters a Cyrillic one passes for
    pub const NAME_INSIDE_WORD : bool = true;  // TrinityBot, #trinity: still the name
    pub const NAME_IN_ANY_CONTEXT : bool = true;  // Trinity College too: no word after it tells which
    pub const CODE_MARK_PREFIX : bool = true;  // T27 starting a word -- t27ai, t27_ai -- is the brand
    pub const PRODUCT_ONE_TOKEN : bool = true;  // S3AI is one token; S3 AI is two words
    pub const MARK_ROW_T27AI_EN : str = "write to t27ai";  // names the house: the brand starts a word
    pub const MARK_ROW_S3_SPACE_EN : str = "our S3 AI pipeline";  // names nothing: S3 and AI
    pub const MARK_ROW_COLLEGE_EN : str = "I studied at Trinity College";  // names the house
    pub const MARK_ROW_TITLE_CASE_EN : str = "Write To Trinity AI";  // a title-cased call: the house

    // ---- Every line of a client's reel (v22) ---------------------------------------------------
    // Every line is checked, the first as much as the last: the captions are the lines as
    // written (CAPTION_TEXT_FROM_LINE), so a line naming the house is a caption naming it too.
    // A template's line on a client's reel is its client version, always -- the host keeps one
    // for every line, in every language, and none of them names the house. A line someone wrote
    // or edited -- the agent, the writer of a topic reel, a seller in the editor -- stands when it
    // names no house mark, or when it is the person's own words typed this turn (what she typed,
    // set by code, never by the model) -- judged for THAT line, not for her message (own_words).
    // Any other is refused before the first paid step.
    pub const HOUSE_LINE_ON_CLIENT_REEL : bool = false;  // a house name nobody typed, on a client's reel
    pub const CLIENT_VERSION_NAMES_HOUSE : bool = false;  // no template's client version names the house
    pub const CLIENT_LIST_HOUSE_FREE : bool = true;  // a client's template list: client versions only
    pub const LINE_FROM_TEMPLATE : u8 = 0;  // the template's line as the template has it
    pub const LINE_FROM_EDIT : u8 = 1;  // written or edited: the agent, the writer, a seller
    pub const LINE_FROM_PERSON : u8 = 2;  // the person's own words, typed this turn
    pub const LINE_KEPT : u8 = 0;
    pub const LINE_CLIENT_VERSION : u8 = 1;  // the template's house-free version of the line
    pub const LINE_REFUSED : u8 = 2;  // refused before anything is spent
    // A refusal here comes before the first paid step -- the still, the voice, the lip-sync --
    // so a refused press takes nothing and nothing is given back (split-reel v7, the same word).
    pub const REFUSED_BEFORE_SPEND : bool = true;

    // ---- Her own words, line by line (v22) ----------------------------------------------------
    // A line naming the house is hers only when THAT LINE's words are in what she typed this
    // turn: the whole line, or each house name in it with up to OWN_WORDS_REACH of the line's
    // words either side. Both are read as words -- case, punctuation and spaces aside -- and must
    // hold a word that is not a house name, so the bot's name alone is never her line. Her
    // message naming the house somewhere lends no line its name: sellers address the bot by name,
    // and a message-level reading let every house name through in that, the common case.
    pub const NAMING_THE_BOT_LENDS : bool = false;  // her message naming the house lends no line
    pub const OWN_WORDS_REACH : u8 = 2;  // the line's words either side that come with a house name
    pub const OWN_SAID_ADDRESS_EN : str = "Trinity, make a reel";  // she addresses the bot...
    pub const OWN_LINE_ADDRESS_EN : str = "This is Trinity";  // ...so this line is not hers
    pub const OWN_SAID_QUOTE_EN : str = "at the end let it say: Write to Trinity";  // she dictates...
    pub const OWN_LINE_QUOTE_EN : str = "Write to Trinity";  // ...so this line is hers

    struct Job {
        has_face: bool,
        has_voice: bool,
        asked_by_client: bool,
        vip_gift: bool,
    }

    // A client with both halves qualifies; either missing refuses before anything is spent.
    fn qualifies(j: Job) -> bool {
        return j.has_face && j.has_voice;
    }

    // Who pays: the seller who asked; the client who pressed, unless her profile makes the
    // reels the seller's gift.
    fn seller_pays(j: Job) -> bool {
        return !j.asked_by_client || j.vip_gift;
    }

    // The estimate named before the press.
    fn price_estimate(scenes: u16, billed_seconds: u16) -> u16 {
        return scenes * TOKENS_PER_STILL + scenes * TOKENS_PER_LINE + billed_seconds * TOKENS_PER_LIPSYNC_SEC + TOKENS_PER_ASSEMBLY;
    }

    // A script is 1..4 scenes; anything else is refused before anything is spent.
    fn scenes_ok(n: u16) -> bool {
        return n >= SCENES_MIN && n <= SCENES_MAX;
    }

    // The pause the template renders, whatever was asked.
    fn pause_of(asked: u16) -> u16 {
        if asked < PAUSE_SEC_MIN {
            return PAUSE_SEC_MIN;
        }
        if asked > PAUSE_SEC_MAX {
            return PAUSE_SEC_MAX;
        }
        return asked;
    }

    // Whether a running job whose row has been silent `silent_ms` is claimed by the sweep.
    fn sweep_claims(silent_ms: u32) -> bool {
        return silent_ms > DEAD_MS;
    }

    // Whether the sweep gives a running job up instead of claiming it again.
    fn sweep_gives_up(attempts: u16, silent_ms: u32) -> bool {
        return attempts >= JOB_ATTEMPTS && silent_ms > DEAD_MS;
    }

    // Whether a failure may say "nothing was charged".
    fn nothing_charged_may_be_said(stills_made: u16, clips_made: u16) -> bool {
        return stills_made == 0 && clips_made == 0;
    }

    // What a resume does with a still whose provider task is known.
    fn still_resume(ready: bool, refused: bool, age_ms: u32) -> u8 {
        if ready {
            return RESUME_USE;
        }
        if refused {
            return RESUME_REDRAW;
        }
        if age_ms >= STILL_GIVE_UP_MS {
            return RESUME_REDRAW;
        }
        return RESUME_WAIT;
    }

    // Which voice a reel speaks: her clone when she has one and its provider answers; otherwise,
    // for a reel the seller asked for, her own voice notes. A client pressing for herself speaks
    // her clone or nothing: her notes are read only for the seller.
    fn voice_mode(has_clone: bool, clone_down: bool, seller_asked: bool) -> u8 {
        if has_clone && !clone_down {
            return VOICE_CLONE;
        }
        if seller_asked {
            return VOICE_NOTES;
        }
        if has_clone {
            return VOICE_CLONE;
        }
        return VOICE_NONE;
    }

    // Generations a reel still needs: the missing stills, a clone's line per missing clip, the
    // missing lip-syncs and the assembly. Her own notes are cut on our shelf and cost no slot.
    fn slots_needed(scenes: u16, stills_have: u16, clips_have: u16, clone: bool) -> u16 {
        const stills = scenes - stills_have;
        const clips = scenes - clips_have;
        if clone {
            return stills + clips + clips + CAP_SLOT_PER_RENDER;
        }
        return stills + clips + CAP_SLOT_PER_RENDER;
    }

    // Whether the day's generations cover what the reel still needs.
    fn day_covers(left: u16, needed: u16) -> bool {
        return left >= needed;
    }

    // Where one cut falls: on a pause near the even cut, or on the even cut itself.
    fn cut_at(even_ms: u32, pause_ms: u32) -> u32 {
        if pause_ms >= even_ms && pause_ms - even_ms <= NOTES_CUT_WINDOW_MS {
            return pause_ms;
        }
        if pause_ms < even_ms && even_ms - pause_ms <= NOTES_CUT_WINDOW_MS {
            return pause_ms;
        }
        return even_ms;
    }

    // The estimate of a reel in her own voice: no clone, no synthesis, only stills, the
    // lip-sync of her seconds, and the cut.
    fn price_estimate_notes(scenes: u16, seconds: u16) -> u16 {
        return scenes * TOKENS_PER_STILL + seconds * TOKENS_PER_LIPSYNC_SEC + TOKENS_PER_ASSEMBLY;
    }

    // Whether a job whose last call made nothing new is released for the sweep instead of
    // failed: anything made, or any still still drawing, keeps it.
    fn job_kept(stills_made: u16, clips_made: u16, stills_drawing: u16) -> bool {
        return stills_made > 0 || clips_made > 0 || stills_drawing > 0;
    }

    // Where one end-card colour comes from: the seller's word for this reel, else the palette
    // kept for her (v10), else her profile, else the default.
    fn end_card_field(seller_gave: bool, kept_has: bool, profile_has: bool) -> u8 {
        if seller_gave {
            return FIELD_FROM_SELLER;
        }
        if kept_has {
            return FIELD_FROM_KEPT;
        }
        if profile_has {
            return FIELD_FROM_PROFILE;
        }
        return FIELD_FROM_DEFAULT;
    }

    // Where a gallery preview takes a field of the end card (v27): the panel's card when it holds
    // one, else the render's default -- the preview never invents a colour of its own.
    fn gallery_preview_field(panel_has: bool) -> u8 {
        if panel_has {
            return FIELD_FROM_SELLER;
        }
        return FIELD_FROM_DEFAULT;
    }

    // Where a surface takes an end-card colour (v29, brand kit): the client's saved palette when
    // she has one, else the render's default -- the same answer on every surface.
    fn brand_kit_field(has_client_palette: bool, surface: u8) -> u8 {
        if has_client_palette {
            return FIELD_FROM_KEPT;
        }
        return FIELD_FROM_DEFAULT;
    }

    // How many slots a retry renders (v28): only the empty ones. A count of done slots above the
    // total is a broken row, and renders nothing rather than wrapping around.
    fn slots_to_render(slots_total: u16, slots_done: u16) -> u16 {
        if slots_done >= slots_total {
            return 0;
        }
        return slots_total - slots_done;
    }

    // What a retry charges (v28): the slots it renders, never the ones already made.
    fn retry_price(slots_total: u16, slots_done: u16, per_slot: u16) -> u16 {
        return slots_to_render(slots_total, slots_done) * per_slot;
    }

    // Whether one slot is rendered on a retry (v28): a done slot never is.
    fn slot_renders(done: bool) -> bool {
        return !done;
    }

    // Whether a retry keeps the stills a failed job made (v30): only in the same style.
    fn carry_stills(same_style: bool) -> bool {
        return same_style;
    }

    // Whether a retry keeps the clips a failed job made (v30): only when its stills are carried
    // and the voice mode is recorded and the same. An unrecorded voice mode never matches.
    fn carry_clips(same_style: bool, same_voice: bool, voice_known: bool) -> bool {
        return carry_stills(same_style) && voice_known && same_voice;
    }

    // Whether a #hex colour has a length CSS reads: #rgb, #rgba, #rrggbb, #rrggbbaa.
    fn hex_digits_ok(n: u8) -> bool {
        return n == 3 || n == 4 || n == 6 || n == 8;
    }

    // Whether text in one colour reads on a background, given their WCAG contrast times ten.
    fn end_card_readable(contrast_x10: u16) -> bool {
        return contrast_x10 >= END_CARD_CONTRAST_MIN_X10;
    }

    // Whether a reel is refused before anything is spent for its end card: only the seller's own
    // palette, and only when the call or the button cannot be read.
    fn end_card_refused(seller_gave_card: bool, readable: bool) -> bool {
        if readable {
            return false;
        }
        if seller_gave_card {
            return SELLER_PALETTE_UNREADABLE_REFUSED;
        }
        return PROFILE_PALETTE_UNREADABLE_REFUSED;
    }

    // What a call does to the kept palette: nothing unless asked; asked with no card, it clears;
    // asked with a card, it keeps it only when the card passed the checks a start makes.
    fn keep_action(save_asked: bool, card_given: bool, card_ok: bool) -> u8 {
        if !save_asked {
            return KEEP_NONE;
        }
        if !card_given {
            return KEEP_CLEAR;
        }
        if card_ok {
            return KEEP_SAVE;
        }
        return KEEP_REFUSED;
    }

    // Whether the panel offers "keep": only for the card the last check passed, unedited since.
    fn panel_keep_offered(checked: bool, edited_since_check: bool, verdict_clean: bool) -> bool {
        return checked && !edited_since_check && verdict_clean;
    }

    // Which way her colour is shaded: the way that reads in fewer steps (SUGGEST_NEVER loses to
    // any step); on a tie, toward the extreme that reads better on this background.
    fn shade_way(light_step: u16, dark_step: u16, light_reads_better: bool) -> u8 {
        if light_step < dark_step {
            return WAY_LIGHT;
        }
        if dark_step < light_step {
            return WAY_DARK;
        }
        if light_reads_better {
            return WAY_LIGHT;
        }
        return WAY_DARK;
    }

    // Whether a shade is named for a field: only for a #hex colour that does not read.
    fn suggest_offered(colour_ok: bool, readable: bool) -> bool {
        if !colour_ok {
            return SUGGEST_FOR_BAD_HEX;
        }
        return !readable;
    }

    // Whether her own colour is offered for a field: one of her card's colours reads there, and
    // it is not the shade already named.
    fn palette_offered(reads: bool, same_as_shade: bool) -> bool {
        return reads && !same_as_shade;
    }

    // Whether her ground is offered: the card does not read, and some shade of her background
    // makes every line on it read at once.
    fn bg_offered(unreadable: bool, all_read_at_some_step: bool) -> bool {
        return unreadable && all_read_at_some_step;
    }

    // Whether a colour's hue is hers to keep: near grey, the hue is rounding noise.
    fn hue_checked(chroma_x1000: u16) -> bool {
        return chroma_x1000 >= HUE_CHECKED_MIN_CHROMA_X1000;
    }

    // Whether a shade kept her hue: it moved no more than rounding to 8 bits moves it.
    fn hue_kept(drift_deg: u16) -> bool {
        return drift_deg <= HUE_DRIFT_MAX_DEG;
    }

    // Whether the card offers "take": only beside the verdict on the card still on screen.
    fn panel_take_offered(checked: bool, edited_since_check: bool, has_fix: bool) -> bool {
        return checked && !edited_since_check && has_fix;
    }

    // Whether the card shows the load's reason: until a check has spoken for the fields.
    fn panel_why_shown(editor_open: bool, checked_since_open: bool) -> bool {
        return !editor_open || !checked_since_open;
    }

    // Which reel is made for a CRM client: the story reel, unless the owner named the old one.
    fn reel_route(owner_named_old_template: bool) -> u8 {
        if owner_named_old_template {
            return ROUTE_OLD_PLAN_REEL;
        }
        return ROUTE_STORY;
    }

    // Whether the reel's card may be shown now: only when nothing else waits for the owner.
    fn card_may_show(pending_for_owner: u16) -> bool {
        return pending_for_owner == 0;
    }

    // Whether a group is ever the destination: never for a client pressing for herself.
    fn may_go_to_group(asked_by_client: bool, group_bound: bool) -> bool {
        return !asked_by_client && group_bound;
    }

    // Whether the reel leaves for a client chat: the owner's press, and nothing else.
    // What a new still's face check leads to: kept, drawn once more, or the run stops.
    fn still_face_action(has_face: bool, redraws: u16) -> u8 {
        if has_face {
            return FACE_KEEP;
        }
        if redraws < STILL_FACE_REDRAWS {
            return FACE_REDRAW;
        }
        return FACE_STOP;
    }

    // Whether a scene shows the source photo as it is, with no still drawn for it.
    fn scene_is_source(scene: u16) -> bool {
        return OPEN_ON_SOURCE && scene == OPEN_SCENE;
    }

    // Whether a scene's place is drawn (v21): only one a caller named in a script of their
    // own. The writer of a topic reel writes lines, and a place it returns anyway is dropped.
    fn setting_drawn(from_writer: bool, has_setting: bool) -> bool {
        return has_setting && (!from_writer || WRITER_WRITES_SETTINGS);
    }

    // Which shot a scene is: wide first, then close and medium by turns -- a cut always
    // changes the size, so a jump between two scenes never looks like a glitch.
    fn shot_of_scene(scene: u16) -> u8 {
        if scene == OPEN_SCENE {
            return SHOT_WIDE;
        }
        if scene % 2 == 1 {
            return SHOT_CLOSE;
        }
        return SHOT_MEDIUM;
    }

    // How much of the source's side a shot keeps.
    fn shot_permille(shot: u8) -> u16 {
        if shot == SHOT_CLOSE {
            return SHOT_CLOSE_PERMILLE;
        }
        if shot == SHOT_MEDIUM {
            return SHOT_MEDIUM_PERMILLE;
        }
        return 1000;
    }

    // Whether a line, as heard, may go on to its lip-sync.
    fn line_fits(ms: u32) -> bool {
        return ms <= LINE_MAX_MS;
    }

    // Whether a line typed in the editor may be sent: something, and no more than it holds.
    fn line_fits_chars(chars: u16) -> bool {
        return chars > 0 && chars <= LINE_MAX_CHARS;
    }

    // The longest a reel of n scenes may run, in ms: its lines, the breaths, the pause.
    fn reel_max_ms(scenes: u16) -> u32 {
        return scenes * LINE_MAX_MS + (scenes - 1) * BREATH_MS + PAUSE_SEC * 1000;
    }

    // The language a line is spoken in: any Cyrillic letter makes it Russian.
    fn language_of(has_cyrillic: bool) -> u8 {
        if has_cyrillic {
            return LANG_RU;
        }
        return LANG_EN;
    }

    // Whether the captions of a scene show its line as written, or the words as heard.
    fn caption_uses_line(line_words: u16, heard_words: u16) -> bool {
        return CAPTION_TEXT_FROM_LINE && heard_words > 0 && line_words == heard_words;
    }

    // Whether the pause shows the widget's call card: when there is a call or a card to show.
    fn cta_card_shown(call_chars: u16, has_end_card: bool) -> bool {
        return CTA_CARD_LIKE_WIDGET && (has_end_card || call_chars > 0);
    }

    // Whether the host fills every colour of a reel's end card before the render (v25): on a
    // client's reel, whenever the pause shows the card -- so the composition's house defaults
    // are never what a client's card is drawn in.
    fn card_filled(own_reel: bool, has_end_card: bool, call_chars: u16) -> bool {
        return !own_reel && !HOUSE_COLOURS_ON_CLIENT_REEL && cta_card_shown(call_chars, has_end_card);
    }

    // Whether every colour of the card is set before the render (v26): whenever the pause shows
    // it -- a client's in ink (card_filled), the own reel's in the defaults.
    fn card_complete(own_reel: bool, has_end_card: bool, call_chars: u16) -> bool {
        if card_filled(own_reel, has_end_card, call_chars) {
            return true;
        }
        return own_reel && OWN_CARD_FILLED && cta_card_shown(call_chars, has_end_card);
    }

    // Whether a reel is the caller's own (v26): the house's own turn, or a reel whose client
    // is the caller himself.
    fn reel_is_own(house_own: bool, lead_is_caller: bool) -> bool {
        if house_own {
            return true;
        }
        return lead_is_caller && CALLER_OWN_LEAD_IS_OWN_REEL;
    }

    // The colour a field nobody gave takes (v25): the house's default on its own reel, else
    // white or black, whichever contrasts more with the ground (a tie is white).
    fn default_ink(own_reel: bool, white_x10: u16, black_x10: u16) -> u8 {
        if own_reel || HOUSE_COLOURS_ON_CLIENT_REEL {
            return INK_HOUSE;
        }
        if white_x10 >= black_x10 {
            return INK_WHITE;
        }
        return INK_BLACK;
    }

    fn leaves_for_client(owner_pressed: bool) -> bool {
        return owner_pressed && !SENT_WITHOUT_PRESS;
    }

    // Whether a call or a button given for a reel is used: something, and on a client's reel
    // nothing that names the house.
    fn word_taken(chars: u16, names_house: bool, own_reel: bool) -> bool {
        return chars > 0 && (own_reel || !names_house);
    }

    // Whether a given call or button is replaced by hers -- and the answer says so.
    fn house_word_replaced(chars: u16, names_house: bool, own_reel: bool) -> bool {
        return HOUSE_WORD_REPLACED_SAID && chars > 0 && names_house && !own_reel;
    }

    // Where a reel's call comes from: the seller's word for it, the template's on the house's
    // own reel, else the lead's own.
    fn call_from(seller_ok: bool, template_given: bool, own_reel: bool) -> u8 {
        if seller_ok {
            return CALL_FROM_SELLER;
        }
        if template_given && (own_reel || HOUSE_CALL_ON_CLIENT_REEL) {
            return CALL_FROM_TEMPLATE;
        }
        return CALL_FROM_PROFILE;
    }

    // Which of her own calls: her story call, her approved call, or the default.
    fn profile_call_from(story_ok: bool, approved_ok: bool) -> u8 {
        if story_ok {
            return CALL_FROM_STORY;
        }
        if approved_ok {
            return CALL_FROM_APPROVED;
        }
        return CALL_FROM_DEFAULT;
    }

    // Where a reel's end-card button comes from: the seller's, the template's on the house's own
    // reel, else her kept card, her profile, or none.
    fn button_from(seller_ok: bool, template_given: bool, own_reel: bool, kept_ok: bool, profile_ok: bool) -> u8 {
        if seller_ok {
            return FIELD_FROM_SELLER;
        }
        if template_given && (own_reel || HOUSE_BUTTON_ON_CLIENT_REEL) {
            return FIELD_FROM_TEMPLATE;
        }
        if kept_ok {
            return FIELD_FROM_KEPT;
        }
        if profile_ok {
            return FIELD_FROM_PROFILE;
        }
        return FIELD_FROM_DEFAULT;
    }

    // How the template's last line ends on a client's reel: the lead-in and her call, her call
    // alone, or the lead-in alone -- never longer than the editor holds.
    fn last_line_way(lead_chars: u16, call_chars: u16, same_language: bool) -> u8 {
        if call_chars == 0 || !same_language {
            return LAST_LINE_LEAD;
        }
        if lead_chars + 1 + call_chars <= LINE_MAX_CHARS {
            return LAST_LINE_LEAD_AND_CALL;
        }
        if call_chars <= LINE_MAX_CHARS {
            return LAST_LINE_CALL;
        }
        return LAST_LINE_LEAD;
    }

    // Whose voice story_reel speaks: the lead's when one is named or the turn is a client's,
    // the caller's on its own reel, and a client turn naming another client is refused.
    fn voice_of(lead_named: bool, client_turn: bool, names_this_client: bool) -> u8 {
        if client_turn && lead_named && !names_this_client {
            return SPEAKS_REFUSED;
        }
        if lead_named || (client_turn && CLIENT_TURN_SPEAKS_CLIENT) {
            return SPEAKS_LEAD;
        }
        return SPEAKS_CALLER;
    }

    // What becomes of one line of a reel: on the caller's own reel it stands; on a client's, a
    // template's line is its client version, and a written or edited one stands only when it
    // names no house mark or is the person's own words typed this turn -- her line, or its
    // house-name words, in what she typed (own_words, line_from). Her message naming the house
    // anywhere is not enough. Any other is refused.
    fn line_way(names_house: bool, own_reel: bool, from: u8) -> u8 {
        if own_reel {
            return LINE_KEPT;
        }
        if from == LINE_FROM_TEMPLATE {
            return LINE_CLIENT_VERSION;
        }
        if !names_house || from == LINE_FROM_PERSON {
            return LINE_KEPT;
        }
        if HOUSE_LINE_ON_CLIENT_REEL {
            return LINE_KEPT;
        }
        return LINE_REFUSED;
    }

    // Whether a client's reel says the house's name aloud (and so in its captions): only through
    // a line kept as written, never through a client version.
    fn line_names_house(way: u8, names_house: bool) -> bool {
        if way == LINE_CLIENT_VERSION {
            return CLIENT_VERSION_NAMES_HOUSE;
        }
        return way == LINE_KEPT && names_house;
    }

    // Whether a press is charged: one that goes ahead pays its price; a refused one pays
    // nothing, because its refusal came before the charge. The same body as split-reel v7's
    // `charged`, copied on purpose and recorded in tools/duplicate_bodies_baseline.txt: a
    // `use a::b;` still generates no import (#5718), so no spec can reuse another's function.
    fn charged(refused: bool) -> bool {
        if !refused {
            return true;
        }
        return !REFUSED_BEFORE_SPEND;
    }

    // Whether a line naming the house is the person's own words, judged for that line: the whole
    // line is in what she typed this turn (line_in_said), or each house name in it is, with the
    // line's words around it (phrase_in_said) -- read as words, case, punctuation and spaces
    // aside, holding a word that is not a house name. That her message names the house somewhere
    // (said_names_house) lends the line nothing (NAMING_THE_BOT_LENDS).
    fn own_words(line_in_said: bool, phrase_in_said: bool, said_names_house: bool) -> bool {
        if line_in_said || phrase_in_said {
            return true;
        }
        return said_names_house && NAMING_THE_BOT_LENDS;
    }

    // Where a written or edited line comes from, for line_way: the person's when it is her own
    // words (own_words), else the agent's, the writer's or a seller's edit.
    fn line_from(own: bool) -> u8 {
        if own {
            return LINE_FROM_PERSON;
        }
        return LINE_FROM_EDIT;
    }

    // Whether a house name found in the folded text names the house: anywhere, inside a longer
    // word too (TrinityBot, #trinity, the handle), and whatever word follows it -- Trinity
    // College as much as Trinity AI, since no word after the name tells which Trinity it is.
    fn name_mark(inside_word: bool, word_after: bool) -> bool {
        if inside_word {
            return NAME_INSIDE_WORD;
        }
        if word_after {
            return NAME_IN_ANY_CONTEXT;
        }
        return true;
    }

    // Whether a code found in the folded text is the house's: not when a letter or a digit
    // stands right before it (at27) or a digit right after it (T270 is another number), and yes
    // when it starts a word (t27ai, the handle and the domain: CODE_MARK_PREFIX).
    fn code_mark(word_before: bool, digit_after: bool, letter_after: bool) -> bool {
        if word_before || digit_after {
            return false;
        }
        if letter_after {
            return CODE_MARK_PREFIX;
        }
        return true;
    }

    // Whether the product found in the folded text is the house's: a code like the brand
    // (code_ok, from code_mark), written as one token. With a space inside it is two words --
    // "S3 AI" is S3 the storage and the word AI -- and names nothing (PRODUCT_ONE_TOKEN).
    fn product_mark(code_ok: bool, space_inside: bool) -> bool {
        if !code_ok {
            return false;
        }
        if space_inside {
            return !PRODUCT_ONE_TOKEN;
        }
        return true;
    }

    test "a client qualifies with a face and a voice, and with nothing less" {
        assert(FACE_REQUIRED);
        assert(VOICE_REQUIRED);
        assert(qualifies(Job { has_face: true, has_voice: true, asked_by_client: false, vip_gift: false }));
        assert(!qualifies(Job { has_face: true, has_voice: false, asked_by_client: false, vip_gift: false }));
        assert(!qualifies(Job { has_face: false, has_voice: true, asked_by_client: false, vip_gift: false }));
    }

    test "the voice is her own, cloned once per seller, and only Replicate can speak it" {
        assert(VOICE_SOURCE == "own-voice-notes-in-owner-dm");
        assert(CLONE_PER_SELLER);
        assert(CLONE_MIN_SECONDS < CLONE_GOOD_SECONDS);
        assert(CLONE_GOOD_SECONDS < CLONE_MAX_SECONDS);
        assert(VOICE_PROVIDER == "replicate");
        assert(!VOICE_ON_KIE);
    }

    test "the seller pays for what the seller asked; the client pays unless it is a gift" {
        assert(seller_pays(Job { has_face: true, has_voice: true, asked_by_client: false, vip_gift: false }));
        assert(!seller_pays(Job { has_face: true, has_voice: true, asked_by_client: true, vip_gift: false }));
        assert(seller_pays(Job { has_face: true, has_voice: true, asked_by_client: true, vip_gift: true }));
    }

    test "the estimate is three stills, three lines, thirteen seconds of lip-sync and one cut" {
        assert(price_estimate(SCENES_DEFAULT, BILLED_SECONDS) == PRICE_ESTIMATE_TOKENS);
        assert(price_estimate(3, 13) == 270);
        assert(price_estimate(1, 4) == 86);
        assert(REFUND_ON_PROVIDER_FAILURE);
    }

    test "a script of one to six scenes is made as given; seven is refused" {
        assert(SELLER_SCRIPT_ACCEPTED);
        assert(scenes_ok(SCENES_DEFAULT));
        assert(scenes_ok(1));
        assert(scenes_ok(4));
        assert(scenes_ok(6));
        assert(!scenes_ok(0));
        assert(!scenes_ok(7));
    }

    test "the pause stays between one and four seconds, three by default" {
        assert(pause_of(PAUSE_SEC) == 3);
        assert(pause_of(0) == 1);
        assert(pause_of(9) == 4);
        assert(REEL_MAX_SEC == 24);
    }

    test "a job whose process died is claimed by the sweep and continued, not redone" {
        assert(!sweep_claims(BEAT_MS));
        assert(!sweep_claims(DEAD_MS));
        assert(sweep_claims(DEAD_MS + 1));
        assert(BEAT_MS < DEAD_MS);
        assert(DEAD_MS < SWEEP_MS);
        assert(!PAID_WORK_REDONE_ON_RESUME);
        assert(RUNNING_JOBS_PER_CLIENT == 1);
        assert(JOB_ATTEMPTS == 3);
    }

    test "a job that keeps dying is given up after its last attempt and closed like any failure" {
        assert(!sweep_gives_up(JOB_ATTEMPTS - 1, DEAD_MS + 1));
        assert(sweep_gives_up(JOB_ATTEMPTS, DEAD_MS + 1));
        assert(!sweep_gives_up(JOB_ATTEMPTS, DEAD_MS));
        assert(EXHAUSTED_JOB_CLOSED);
        assert(ABANDONED_JOB_CLOSED);
        assert(PLAN_CARD_RETURNED_ON_FAILURE);
    }

    test "a failure says nothing was charged only when nothing was made" {
        assert(nothing_charged_may_be_said(0, 0));
        assert(!nothing_charged_may_be_said(2, 0));
        assert(!nothing_charged_may_be_said(0, 1));
        assert(FAILURE_NAMES_PAID_PARTS);
    }

    test "a still that is still drawing is paid once: a resume waits for it and never orders it again" {
        assert(STILL_TASK_KEPT_AT_ACCEPT);
        assert(!STILL_TASK_FROM_MODEL);
        assert(still_resume(true, false, 0) == RESUME_USE);
        assert(still_resume(true, false, STILL_GIVE_UP_MS) == RESUME_USE);
        assert(still_resume(false, false, 0) == RESUME_WAIT);
        assert(still_resume(false, false, STILL_GIVE_UP_MS - 1) == RESUME_WAIT);
        assert(still_resume(false, false, STILL_GIVE_UP_MS) == RESUME_REDRAW);
        assert(still_resume(false, true, 0) == RESUME_REDRAW);
        assert(STILL_POLL_MS < STILL_WAIT_MS);
        assert(STILL_WAIT_MS < STILL_GIVE_UP_MS);
        assert(!PAID_WORK_REDONE_ON_RESUME);
    }

    test "a charge for a still that never came is given back once, whoever notices" {
        assert(LATE_REFUND_ONCE_PER_TASK);
        assert(LATE_REFUND_REF_PREFIX == "late-image:");
        assert(FAILED_JOB_RETURNS_PENDING_STILLS);
        assert(REFUND_ON_PROVIDER_FAILURE);
    }

    test "a job waiting only for a still is released for the sweep, not failed" {
        assert(PENDING_STILL_KEEPS_JOB);
        assert(job_kept(0, 0, 1));
        assert(job_kept(1, 0, 0));
        assert(job_kept(0, 1, 0));
        assert(!job_kept(0, 0, 0));
    }

    test "the seller reaches the template, and a broken ElevenLabs key never stops a client's voice" {
        assert(SELLER_TOOL == "crm_story_reel");
        assert(CLONE_TOOL == "crm_voice_clone");
        assert(!HAND_ASSEMBLY_IN_CHAT);
        assert(VOICE_PROVIDER == "replicate");
        assert(!VOICE_NEEDS_ELEVENLABS);
        assert(SENT_VOICE_NOTES_TRIED_FIRST);
        assert(VOICE_HEALTH_FROM_REAL_CALLS);
    }

    test "with no clone, a seller's reel speaks her own voice notes on Kie, and nothing else does" {
        assert(voice_mode(true, false, true) == VOICE_CLONE);
        assert(voice_mode(true, false, false) == VOICE_CLONE);
        assert(voice_mode(false, false, true) == VOICE_NOTES);
        assert(voice_mode(false, false, false) == VOICE_NONE);
        assert(!NOTES_NEED_REPLICATE);
        assert(NOTES_WORDS_ARE_HERS);
        assert(NOTES_FROM_SELLER_DM_ONLY);
        assert(NOTES_MAX_SEC + PAUSE_SEC <= REEL_MAX_SEC);
        assert(SCENES_MAX * NOTES_PART_MIN_MS <= NOTES_MAX_SEC * 1000);
        assert(NOTES_MIN_SEC <= NOTES_MAX_SEC);
    }

    test "a seller's reel whose clone its provider refuses speaks her notes in the same run, on the stills it paid for" {
        assert(voice_mode(true, true, true) == VOICE_NOTES);
        assert(voice_mode(true, true, false) == VOICE_CLONE);
        assert(voice_mode(false, true, true) == VOICE_NOTES);
        assert(voice_mode(false, true, false) == VOICE_NONE);
        assert(CLONE_DOWN_FALLS_TO_NOTES);
        assert(CLONE_DOWN_SAME_RUN);
        assert(CLONE_DOWN_KEEPS_STILLS);
        assert(CLONE_DOWN_ONLY_ON_PROVIDER);
    }

    test "the day's generations are counted before anything is spent, and a waiting job keeps its attempts" {
        assert(slots_needed(3, 0, 0, true) == 10);
        assert(slots_needed(3, 0, 0, false) == 7);
        assert(slots_needed(3, 3, 0, false) == 4);
        assert(slots_needed(3, 3, 2, true) == 3);
        assert(slots_needed(3, 3, 3, true) == CAP_SLOT_PER_RENDER);
        assert(!day_covers(9, 10));
        assert(day_covers(10, 10));
        assert(CAP_ASKED_BEFORE_SPEND);
        assert(CAP_WAIT_KEEPS_ATTEMPTS);
        assert(CAP_WAIT_TOLD_ONCE);
    }

    test "her notes are cut at a pause near the even cut, or at the even cut" {
        assert(cut_at(4000, 4600) == 4600);
        assert(cut_at(4000, 3000) == 3000);
        assert(cut_at(4000, 4000 + NOTES_CUT_WINDOW_MS) == 4000 + NOTES_CUT_WINDOW_MS);
        assert(cut_at(4000, 4000 + NOTES_CUT_WINDOW_MS + 1) == 4000);
        assert(cut_at(4000, 1000) == 4000);
        assert(NOTES_PART_MIN_MS <= NOTES_CUT_WINDOW_MS);
    }

    test "a reel in her own voice costs its stills, her seconds of lip-sync and the cut" {
        assert(price_estimate_notes(3, 12) == 218);
        assert(price_estimate_notes(3, NOTES_MAX_SEC) < PRICE_ESTIMATE_TOKENS);
        assert(price_estimate_notes(1, 5) == 90);
    }

    test "the card never displaces one the owner has not answered" {
        assert(PRESSABLE_CARDS_PER_PERSON == 1);
        assert(!CARD_DISPLACES_UNANSWERED);
        assert(card_may_show(0));
        assert(!card_may_show(1));
        assert(CALLBACK_BYTES_MAX == 64);
    }

    test "nothing reaches a client chat without the owner's press, and a client press never reaches a group" {
        assert(!SENT_WITHOUT_PRESS);
        assert(leaves_for_client(true));
        assert(!leaves_for_client(false));
        assert(!CLIENT_PRESS_SENDS_TO_GROUP);
        assert(!may_go_to_group(true, true));
        assert(may_go_to_group(false, true));
        assert(!may_go_to_group(false, false));
        assert(GROUP_MUST_BE_READ_BY_CRM);
        assert(DM_SEND_RECORDED_AS_GIFT);
    }

    test "a gallery preview with no card yet is drawn in the render's defaults, not the theme's green" {
        assert(GALLERY_PREVIEW_FROM_CARD_DEFAULTS);
        assert(gallery_preview_field(false) == FIELD_FROM_DEFAULT);
        assert(gallery_preview_field(true) == FIELD_FROM_SELLER);
        assert(gallery_preview_field(false) == end_card_field(false, false, false));
        assert(END_CARD_DEFAULT_ACCENT == END_CARD_DEFAULT_TITLE);
        assert(END_CARD_DEFAULT_ACCENT != "#00FF88");
        assert(END_CARD_DEFAULT_BG != "#000000");
    }

    test "her visual at the end: the seller's word, then her profile, then the default, kept in the job" {
        assert(END_CARD_ARG == "end_card");
        assert(END_CARD_KEPT_IN_JOB);
        assert(end_card_field(true, true, true) == FIELD_FROM_SELLER);
        assert(end_card_field(true, false, false) == FIELD_FROM_SELLER);
        assert(end_card_field(false, false, true) == FIELD_FROM_PROFILE);
        assert(end_card_field(false, false, false) == FIELD_FROM_DEFAULT);
        assert(END_CARD_BUTTON_MAX == 60);
        assert(END_CARD_DEFAULT_BG == "#0B0B0B");
        assert(END_CARD_DEFAULT_TITLE == "#FFD700");
        assert(END_CARD_DEFAULT_TEXT == "#FFFFFF");
        assert(END_CARD_DEFAULT_ACCENT == "#FFD700");
    }

    test "a colour is #hex that CSS reads, and an unreadable palette of the seller's is refused before spending" {
        assert(hex_digits_ok(3));
        assert(hex_digits_ok(4));
        assert(hex_digits_ok(6));
        assert(hex_digits_ok(8));
        assert(!hex_digits_ok(5));
        assert(!hex_digits_ok(7));
        assert(!hex_digits_ok(9));
        assert(END_CARD_CONTRAST_MIN_X10 == 45);
        assert(end_card_readable(45));
        assert(!end_card_readable(44));
        assert(end_card_readable(210));
        assert(end_card_refused(true, false));
        assert(!end_card_refused(true, true));
        assert(!end_card_refused(false, false));
        assert(!end_card_refused(false, true));
        assert(SELLER_BAD_COLOUR_REFUSED);
        assert(PROFILE_BAD_COLOUR_DROPPED);
    }

    test "her palette is kept once for every next reel, checked first, and never turns her presses on" {
        assert(END_CARD_SAVE_ARG == "save_end_card");
        assert(end_card_field(false, true, true) == FIELD_FROM_KEPT);  // kept over her profile
        assert(end_card_field(false, true, false) == FIELD_FROM_KEPT);
        assert(end_card_field(true, true, false) == FIELD_FROM_SELLER);  // this reel's word over the kit
        assert(KEPT_PER_SELLER_AND_CLIENT);
        assert(KEPT_CHECKED_BEFORE_KEEPING);
        assert(keep_action(false, true, true) == KEEP_NONE);
        assert(keep_action(true, true, true) == KEEP_SAVE);
        assert(keep_action(true, true, false) == KEEP_REFUSED);
        assert(keep_action(true, false, false) == KEEP_CLEAR);
        assert(KEPT_EMPTY_CARD_CLEARS);
        assert(KEPT_FOR_HER_OWN_PRESS);
        assert(!KEPT_IN_PROFILE_STORY_BLOCK);
    }

    test "the card shows her palette and keeps it by a press, for the card the last check passed" {
        assert(PANEL_SHOWS_END_CARD);
        assert(PANEL_CHECK_IS_READ);
        assert(PANEL_VERDICT_FROM_SERVER);
        assert(PANEL_KEEP_IS_PRESS);
        assert(panel_keep_offered(true, false, true));
        assert(!panel_keep_offered(false, false, true));  // never checked
        assert(!panel_keep_offered(true, true, true));  // edited after the check
        assert(!panel_keep_offered(true, false, false));  // the server named a problem
    }

    test "a refusal for contrast names the least shade of her own colour that reads" {
        assert(SUGGEST_FIX_ARG == "end_card_fix");
        assert(SUGGEST_STEPS == 64);
        assert(SUGGEST_NEVER == SUGGEST_STEPS + 1);
        assert(end_card_readable(EXTREME_MIN_CONTRAST_X10));  // the last step always reads
        assert(shade_way(3, 7, false) == WAY_LIGHT);  // fewer steps wins
        assert(shade_way(7, 3, true) == WAY_DARK);
        assert(shade_way(SUGGEST_NEVER, 10, true) == WAY_DARK);  // a way that never reads loses
        assert(shade_way(4, SUGGEST_NEVER, false) == WAY_LIGHT);
        assert(shade_way(5, 5, true) == WAY_LIGHT);  // a tie: the extreme that reads better
        assert(shade_way(5, 5, false) == WAY_DARK);
        assert(suggest_offered(true, false));
        assert(!suggest_offered(true, true));
        assert(!suggest_offered(false, false));  // not #hex: named back, nothing to shade
        assert(SUGGEST_KEEPS_HER_COLOUR);
        assert(SUGGEST_FOR_PROFILE_PALETTE);
        assert(!end_card_refused(false, false));  // her profile's shade is named, the reel still goes
    }

    test "the card takes the named shade by a press and checks it again before keeping" {
        assert(SUGGEST_TAKEN_BY_PRESS);
        assert(!SUGGEST_KEPT_BY_ITSELF);
        assert(panel_take_offered(true, false, true));
        assert(!panel_take_offered(false, false, true));  // never checked
        assert(!panel_take_offered(true, true, true));  // the fix was for the card before the edit
        assert(!panel_take_offered(true, false, false));  // nothing to take
        assert(!panel_keep_offered(true, true, true));  // taking edits the fields: keep waits
    }

    test "her own colour and her ground are offered beside the shade, each by a press" {
        assert(SUGGEST_PALETTE_ARG == "end_card_fix_palette");
        assert(SUGGEST_BG_ARG == "end_card_fix_bg");
        assert(palette_offered(true, false));
        assert(!palette_offered(false, false));  // none of her colours reads there
        assert(!palette_offered(true, true));  // the shade already is that colour: named once
        assert(bg_offered(true, true));
        assert(!bg_offered(true, false));  // no ground makes every line read: nothing offered
        assert(!bg_offered(false, true));  // it reads already
        assert(!BG_FIX_ALWAYS_EXISTS);
        assert(PALETTE_FROM_HER_CARD);
        assert(PALETTE_NEAREST_FIRST);
        assert(OPTIONS_TAKEN_BY_PRESS);
        assert(panel_take_offered(true, false, true));  // one rule for every option
        assert(SUGGEST_NEVER == SUGGEST_STEPS + 1);
    }

    test "the shade moves only her lightness: her hue stays within rounding" {
        assert(SHADE_SPACE == "oklch");
        assert(SHADE_CHROMA_CUT_TO_SRGB);
        assert(NEAREST_BY == "oklab");
        assert(hue_kept(0));
        assert(hue_kept(HUE_DRIFT_MAX_DEG));
        assert(!hue_kept(HUE_DRIFT_MAX_DEG + 1));
        assert(!hue_kept(SRGB_MIX_DRIFT_DEG));  // the v13 mix breaks the law it replaces
        assert(hue_checked(HUE_CHECKED_MIN_CHROMA_X1000));
        assert(!hue_checked(HUE_CHECKED_MIN_CHROMA_X1000 - 1));  // near grey: not judged
        assert(end_card_readable(EXTREME_MIN_CONTRAST_X10));  // the last step is still white or black
    }

    test "the card says one reason at a time" {
        assert(PANEL_ONE_REASON_AT_A_TIME);
        assert(panel_why_shown(false, false));  // closed: the load's reason
        assert(panel_why_shown(false, true));  // closed after a keep: the fresh load's reason
        assert(panel_why_shown(true, false));  // open, nothing checked yet: still the only reason
        assert(!panel_why_shown(true, true));  // a check has spoken: its verdict is the one
        assert(!panel_take_offered(true, true, true));  // the load's options stepped aside the same way
    }

    test "the price stands above the button on both screens" {
        assert(PRICE_BEFORE_PRESS);
