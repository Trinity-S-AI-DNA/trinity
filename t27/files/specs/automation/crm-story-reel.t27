    test "a client's end card is never drawn in the house's gold: a colour nobody gave is white or black ink" {
        assert(!HOUSE_COLOURS_ON_CLIENT_REEL);
        assert(INK_WHITE_HEX == "#FFFFFF");
        assert(INK_BLACK_HEX == "#000000");
        // The house's own reel keeps the house's defaults.
        assert(default_ink(true, 210, 10) == INK_HOUSE);
        assert(default_ink(true, 11, 180) == INK_HOUSE);
        // A client's: whichever of white and black reads more on her ground.
        assert(default_ink(false, 210, 10) == INK_WHITE);
        assert(default_ink(false, 11, 180) == INK_BLACK);
        assert(default_ink(false, 45, 45) == INK_WHITE);
        assert(default_ink(false, 44, 45) == INK_BLACK);
        assert(default_ink(false, 46, 45) == INK_WHITE);
        // The better of the two always reads, so the ink never needs a refusal.
        assert(end_card_readable(EXTREME_MIN_CONTRAST_X10));
        assert(CLIENT_CARD_CHECKED_AS_DRAWN);
    }

