    test "captions are yellow, word by word, heard from each clip, and the line is shown as written" {
        assert(CAPTIONS_ON);
        assert(CAPTIONS_PER_SCENE);
        assert(CAPTIONS_MISSING_KEEPS_REEL);
        assert(CAPTION_COLOR == "#FFFF00");
        assert(CAPTION_MAX_WORDS == 1);
        assert(CAPTION_TOP_PERCENT > 50);
        assert(CAPTION_TOP_PERCENT < 85);
        assert(caption_uses_line(6, 6));
        assert(!caption_uses_line(6, 7));
        assert(!caption_uses_line(7, 6));
        assert(!caption_uses_line(0, 0));
    }

    test "the pause shows the call as the widget draws it, when there is a call" {
        assert(CTA_PULSE_MS == 2400);
        assert(cta_card_shown(14, false));
        assert(cta_card_shown(0, true));
        assert(cta_card_shown(14, true));
        assert(!cta_card_shown(0, false));
    }

    test "every reel for a client is a story reel; the silent plan reel only when the owner names it" {
        assert(reel_route(false) == ROUTE_STORY);
        assert(reel_route(true) == ROUTE_OLD_PLAN_REEL);
        assert(OLD_PLAN_REEL == "LeelaPlanReel");
        assert(SELLER_TOOL == "crm_story_reel");
        assert(REEL_TOOL_IN_CLIENT_BRIEF);
        assert(REEL_TOOL_IN_QUEEN_BLOCK);
        assert(REEL_TOOL_IN_PLAN_HINT);
        assert(REEL_TOOL_IN_PLAN_READ);
        assert(PLAN_ITEM_IS_TOPIC);
        assert(REELS_STAY_STORY_AFTER_GIFTS);
    }

    test "a render asked for by the service waits for approval in the feed" {
        assert(!SERVICE_RENDER_FEED_PUBLIC);
        assert(!AUTOPILOT_SENDS_CARD);
    }

    test "what was seen live is kept apart from what is blocked" {
        assert(LIVE_RUN_STATUS == "delivered-2026-09-26");
        assert(VOICE_LEG_STATUS == "clone-402-falls-to-notes-on-kie-2026-09-27");
        assert(CAP_LEG_STATUS == "lipsync-met-daily-cap-attempts-burned-2026-09-27");
    }

    test "a client's reel carries her call: the seller's for her, then her own, never the house's" {
        assert(!HOUSE_CALL_ON_CLIENT_REEL);
        assert(call_from(true, true, false) == CALL_FROM_SELLER);
        assert(call_from(true, true, true) == CALL_FROM_SELLER);
        assert(call_from(false, true, false) == CALL_FROM_PROFILE);
        assert(call_from(false, true, true) == CALL_FROM_TEMPLATE);
        assert(call_from(false, false, true) == CALL_FROM_PROFILE);
        assert(call_from(false, false, false) == CALL_FROM_PROFILE);
        assert(profile_call_from(true, true) == CALL_FROM_STORY);
        assert(profile_call_from(true, false) == CALL_FROM_STORY);
        assert(profile_call_from(false, true) == CALL_FROM_APPROVED);
        assert(profile_call_from(false, false) == CALL_FROM_DEFAULT);
    }

    test "a call or a button naming the house on a client's reel is replaced by hers, and the answer says so" {
        assert(HOUSE_MARKS == 5);
        assert(BOT_SPOKEN_AS == "Trinity");
        assert(HOUSE_DELIVERY_BOT == "t27ai_bot");
        assert(HOUSE_BRAND == "T27");
        assert(HOUSE_PRODUCT == "S3AI");
        assert(TEMPLATE_BUTTON == "@t27ai_bot");
        assert(HOUSE_WORD_REPLACED_SAID);
        assert(word_taken(12, false, false));
        assert(!word_taken(12, true, false));
        assert(word_taken(12, true, true));
        assert(!word_taken(0, false, false));
        assert(!word_taken(0, false, true));
        assert(house_word_replaced(12, true, false));
        assert(!house_word_replaced(12, true, true));
        assert(!house_word_replaced(12, false, false));
        assert(!house_word_replaced(0, true, false));
        assert(call_from(word_taken(16, true, false), false, false) == CALL_FROM_PROFILE);
        assert(call_from(word_taken(16, true, true), false, true) == CALL_FROM_SELLER);
    }

    test "a client's end-card button: the seller's, her kept card, her profile, or none -- never the house bot" {
        assert(!HOUSE_BUTTON_ON_CLIENT_REEL);
        assert(FIELD_FROM_TEMPLATE != FIELD_FROM_SELLER);
        assert(FIELD_FROM_TEMPLATE != FIELD_FROM_KEPT);
        assert(FIELD_FROM_TEMPLATE != FIELD_FROM_PROFILE);
        assert(FIELD_FROM_TEMPLATE != FIELD_FROM_DEFAULT);
        assert(button_from(true, true, false, true, true) == FIELD_FROM_SELLER);
        assert(button_from(false, true, false, true, true) == FIELD_FROM_KEPT);
        assert(button_from(false, true, false, false, true) == FIELD_FROM_PROFILE);
        assert(button_from(false, true, false, false, false) == FIELD_FROM_DEFAULT);
        assert(button_from(false, true, true, true, true) == FIELD_FROM_TEMPLATE);
        assert(button_from(false, false, true, true, true) == FIELD_FROM_KEPT);
        assert(button_from(true, true, true, false, false) == FIELD_FROM_SELLER);
    }

    test "the template's last line on a client's reel ends with her call, within the editor's limit" {
        assert(TEMPLATE_LEAD_EN_4 == "Want the same?");
        assert(last_line_way(14, 16, true) == LAST_LINE_LEAD_AND_CALL);
        assert(last_line_way(14, LINE_MAX_CHARS - 15, true) == LAST_LINE_LEAD_AND_CALL);
        assert(last_line_way(14, LINE_MAX_CHARS - 14, true) == LAST_LINE_CALL);
        assert(last_line_way(14, LINE_MAX_CHARS, true) == LAST_LINE_CALL);
        assert(last_line_way(14, LINE_MAX_CHARS + 1, true) == LAST_LINE_LEAD);
        assert(last_line_way(14, 16, false) == LAST_LINE_LEAD);
        assert(last_line_way(14, 0, true) == LAST_LINE_LEAD);
    }

    test "story_reel for a client takes the same call and card, and speaks her voice, never the owner's" {
        assert(CLIENT_TURN_SPEAKS_CLIENT);
        assert(voice_of(true, false, false) == SPEAKS_LEAD);
        assert(voice_of(false, true, false) == SPEAKS_LEAD);
        assert(voice_of(true, true, true) == SPEAKS_LEAD);
        assert(voice_of(true, true, false) == SPEAKS_REFUSED);
        assert(voice_of(false, false, false) == SPEAKS_CALLER);
        assert(call_from(false, false, false) == CALL_FROM_PROFILE);
        assert(button_from(false, false, false, true, false) == FIELD_FROM_KEPT);
        assert(button_from(false, false, false, false, true) == FIELD_FROM_PROFILE);
    }

    test "every template line on a client's reel is its client version, the first as much as the last" {
        assert(!CLIENT_VERSION_NAMES_HOUSE);
        assert(CLIENT_LIST_HOUSE_FREE);
        assert(line_way(true, false, LINE_FROM_TEMPLATE) == LINE_CLIENT_VERSION);
        assert(line_way(false, false, LINE_FROM_TEMPLATE) == LINE_CLIENT_VERSION);
        assert(!line_names_house(line_way(true, false, LINE_FROM_TEMPLATE), true));
        assert(!line_names_house(line_way(false, false, LINE_FROM_TEMPLATE), false));
        assert(line_way(true, true, LINE_FROM_TEMPLATE) == LINE_KEPT);
        assert(line_way(false, true, LINE_FROM_TEMPLATE) == LINE_KEPT);
    }

    test "a written or edited line naming the house on a client's reel is refused before anything is spent" {
        assert(!HOUSE_LINE_ON_CLIENT_REEL);
        assert(REFUSED_BEFORE_SPEND);
        assert(line_way(true, false, LINE_FROM_EDIT) == LINE_REFUSED);
        assert(line_way(false, false, LINE_FROM_EDIT) == LINE_KEPT);
        assert(line_way(true, true, LINE_FROM_EDIT) == LINE_KEPT);
        assert(line_way(false, true, LINE_FROM_EDIT) == LINE_KEPT);
        assert(!line_names_house(line_way(true, false, LINE_FROM_EDIT), true));
        assert(!line_names_house(line_way(false, false, LINE_FROM_EDIT), false));
        assert(!charged(line_way(true, false, LINE_FROM_EDIT) == LINE_REFUSED));
        assert(charged(line_way(false, false, LINE_FROM_EDIT) == LINE_REFUSED));
    }

    test "only the person's own words typed this turn may name the house on a client's reel" {
        assert(line_way(true, false, LINE_FROM_PERSON) == LINE_KEPT);
        assert(line_way(false, false, LINE_FROM_PERSON) == LINE_KEPT);
        assert(line_way(true, true, LINE_FROM_PERSON) == LINE_KEPT);
        assert(line_names_house(line_way(true, false, LINE_FROM_PERSON), true));
        assert(!line_names_house(line_way(false, false, LINE_FROM_PERSON), false));
        assert(line_way(true, false, LINE_FROM_EDIT) != line_way(true, false, LINE_FROM_PERSON));
    }

    test "her own words are judged line by line: naming the bot lends no line the house's name" {
        // OWN_SAID_ADDRESS_EN + OWN_LINE_ADDRESS_EN: her message names the house, the line is
        // not in it -- refused, before anything is spent.
        assert(!NAMING_THE_BOT_LENDS);
        assert(!own_words(false, false, true));
        assert(line_from(own_words(false, false, true)) == LINE_FROM_EDIT);
        assert(line_way(true, false, line_from(own_words(false, false, true))) == LINE_REFUSED);
        assert(!charged(line_way(true, false, line_from(own_words(false, false, true))) == LINE_REFUSED));
        // OWN_SAID_QUOTE_EN + OWN_LINE_QUOTE_EN: the whole line is in what she typed -- hers.
        assert(own_words(true, false, true));
        assert(line_way(true, false, line_from(own_words(true, false, true))) == LINE_KEPT);
        // A house name with her words around it, inside a longer line of hers, is hers too.
        assert(own_words(false, true, true));
        assert(line_from(own_words(false, true, true)) == LINE_FROM_PERSON);
        assert(OWN_WORDS_REACH > 0);
        assert(!own_words(false, false, false));
    }

    test "a refusal comes before the charge, so a refused press costs nothing" {
        assert(!charged(true));
        assert(charged(false));
        assert(LINE_REFUSED != LINE_KEPT);
        assert(LINE_REFUSED != LINE_CLIENT_VERSION);
        assert(LINE_KEPT != LINE_CLIENT_VERSION);
        assert(LINE_FROM_TEMPLATE != LINE_FROM_EDIT);
        assert(LINE_FROM_EDIT != LINE_FROM_PERSON);
        assert(LINE_FROM_TEMPLATE != LINE_FROM_PERSON);
    }

    test "a Cyrillic letter that looks Latin reads as that letter, and an invisible one splits no name" {
        // The Russian row -- Trinity in Cyrillic with a Latin T -- folds to the Russian mark,
        // folded the same way, so it is the bare name, and an agent's line with it is refused.
        assert(FOLD_LOOKALIKES);
        assert(INVISIBLES_DROPPED);
        assert(LOOKALIKE_LATIN == "abcdehijkmopqstwxy");
        assert(name_mark(false, false));
        assert(line_way(name_mark(false, false), false, LINE_FROM_EDIT) == LINE_REFUSED);
        assert(!charged(line_way(name_mark(false, false), false, LINE_FROM_EDIT) == LINE_REFUSED));
    }

    test "T27 starting a word is the brand: t27ai and t27_ai, not at27 nor T270" {
        assert(MARK_ROW_T27AI_EN == "write to t27ai");
        assert(CODE_MARK_PREFIX);
        assert(code_mark(false, false, true));
        assert(code_mark(false, false, false));
        assert(!code_mark(true, false, false));
        assert(!code_mark(true, false, true));
        assert(!code_mark(false, true, false));
        assert(line_way(code_mark(false, false, true), false, LINE_FROM_EDIT) == LINE_REFUSED);
        assert(line_way(code_mark(true, false, true), false, LINE_FROM_EDIT) == LINE_KEPT);
    }

    test "the product is one token: our S3 AI pipeline names no house" {
        assert(MARK_ROW_S3_SPACE_EN == "our S3 AI pipeline");
        assert(HOUSE_PRODUCT == "S3AI");
        assert(PRODUCT_ONE_TOKEN);
        assert(!product_mark(code_mark(false, false, false), true));
        assert(product_mark(code_mark(false, false, false), false));
        assert(product_mark(code_mark(false, false, true), false));
        assert(!product_mark(code_mark(true, false, false), false));
        assert(line_way(product_mark(code_mark(false, false, false), true), false, LINE_FROM_EDIT) == LINE_KEPT);
        assert(line_way(product_mark(code_mark(false, false, false), false), false, LINE_FROM_EDIT) == LINE_REFUSED);
    }

    test "Trinity College stays a house name: a refused line is rewritten, a missed one is on her reel" {
        assert(MARK_ROW_COLLEGE_EN == "I studied at Trinity College");
        assert(NAME_IN_ANY_CONTEXT);
        assert(name_mark(false, true));
        // The agent's line: refused before anything is spent, and written again.
        assert(line_way(name_mark(false, true), false, LINE_FROM_EDIT) == LINE_REFUSED);
        assert(!charged(line_way(name_mark(false, true), false, LINE_FROM_EDIT) == LINE_REFUSED));
        // Her own typed line: hers to say, college and all.
        assert(line_way(name_mark(false, true), false, line_from(own_words(true, false, true))) == LINE_KEPT);
    }

    test "no rule that clears a false positive clears a mark: Trinity, Trinity S3AI, T27 and @t27ai_bot stay" {
        assert(BOT_SPOKEN_AS == "Trinity");
        assert(HOUSE_BRAND == "T27");
        assert(TEMPLATE_BUTTON == "@t27ai_bot");
        assert(MARK_ROW_TITLE_CASE_EN == "Write To Trinity AI");
        // Trinity alone, and Trinity before any word: Trinity S3AI, Write To Trinity AI.
        assert(name_mark(false, false));
        assert(name_mark(false, true));
        // TrinityBot, and the delivery bot inside a longer handle.
        assert(NAME_INSIDE_WORD);
        assert(name_mark(true, false));
        // S3AI after Trinity, T27 alone, and the t27 starting @t27ai_bot.
        assert(product_mark(code_mark(false, false, false), false));
        assert(code_mark(false, false, false));
        assert(code_mark(false, false, true));
        assert(line_way(name_mark(false, true), false, LINE_FROM_EDIT) == LINE_REFUSED);
        assert(line_way(code_mark(false, false, false), false, LINE_FROM_EDIT) == LINE_REFUSED);
    }

    test "a reel whose client is the caller himself is his own, and his lines may name the house" {
        assert(CALLER_OWN_LEAD_IS_OWN_REEL);
        assert(reel_is_own(false, true));
        assert(reel_is_own(true, false));
        assert(reel_is_own(true, true));
        assert(!reel_is_own(false, false));
        assert(line_way(true, reel_is_own(false, true), LINE_FROM_EDIT) == LINE_KEPT);
        assert(line_way(true, reel_is_own(false, false), LINE_FROM_EDIT) == LINE_REFUSED);
    }

    test "a retry renders only the empty slots and charges only for them" {
        assert(RETRY_REUSES_DONE_SLOTS);
        // Nothing made yet: every slot, at full price.
        assert(slots_to_render(3, 0) == 3);
        assert(retry_price(3, 0, TOKENS_PER_STILL) == 3 * TOKENS_PER_STILL);
        // Partly made: only the rest.
        assert(slots_to_render(3, 2) == 1);
        assert(retry_price(3, 2, TOKENS_PER_LINE) == TOKENS_PER_LINE);
        assert(slots_to_render(5, 1) == 4);
        // All made: nothing rendered, nothing charged.
        assert(slots_to_render(3, 3) == 0);
        assert(retry_price(3, 3, TOKENS_PER_LINE) == 0);
        assert(slots_to_render(0, 0) == 0);
        // A broken row with more done than total renders nothing, never wraps.
        assert(slots_to_render(2, 5) == 0);
        // A done slot is never rendered again; an empty one is.
        assert(!slot_renders(true));
        assert(slot_renders(false));
    }

    test "every end card the pause shows has a ground and a readable call and button" {
        assert(OWN_CARD_FILLED);
        assert(card_complete(true, false, 14));
        assert(card_complete(true, true, 0));
        assert(card_complete(true, false, 1));
        assert(card_complete(false, false, 14));
        assert(card_complete(false, true, 0));
        assert(!card_complete(true, false, 0));
        assert(!card_complete(false, false, 0));
        assert(END_CARD_DEFAULT_ACCENT == END_CARD_DEFAULT_TITLE);
        assert(DEFAULT_TITLE_CONTRAST_X10 == 140);
        assert(DEFAULT_TEXT_CONTRAST_X10 == 196);
        assert(end_card_readable(DEFAULT_TITLE_CONTRAST_X10));
        assert(end_card_readable(DEFAULT_TEXT_CONTRAST_X10));
    }

    test "a retry carries stills only in the same style" {
        assert(carry_stills(true));
        assert(!carry_stills(false));
    }

    test "a retry carries clips only with carried stills and a recorded, matching voice mode" {
        // Same style, same recorded voice: clips kept.
        assert(carry_clips(true, true, true));
        // Same style, other voice: stills kept, clips re-rendered.
        assert(carry_stills(true));
        assert(!carry_clips(true, false, true));
        // Other style: neither stills nor clips, whatever the voice.
        assert(!carry_clips(false, true, true));
        // Voice mode never recorded: no clips, even with the same style.
        assert(!carry_clips(true, true, false));
        assert(!carry_clips(true, false, false));
    }

}

// phi^2 + 1/phi^2 = 3 | TRINITY
