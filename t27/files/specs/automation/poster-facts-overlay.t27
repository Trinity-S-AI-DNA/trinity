// SPDX-License-Identifier: Apache-2.0
// specs/automation/poster-facts-overlay.t27 -- the exact facts of an event poster (title, date
// and time, venue, price) are laid out by CODE as text over the generated picture, never left
// to the image model's lettering.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/agent/poster-facts-layout.ts
//       (layoutPosterFacts(facts, canvas): line boxes and the plate, a pure function; nothing
//       is drawn yet). The drawing step and its wiring into image_generate (when factsIn of the
//       prompt is non-empty) is a follow-up in the host repo.
// Why code and not the model: 999#3701 -- the free background model (Pollinations) prints
//       pseudo-letters, and even the best text models are measured at 85-95% accuracy on
//       short copy (Ideogram, Recraft reviews, 2026). A poster with 19:00 printed as 18:00 is
//       worse than a poster with no time at all. Canva, Adobe Express and Kittl keep facts in
//       live text layers over the art for the same reason (Canva Magic Layers, 2026-03).
// Layout rules taken from the poster typography canon (4over4, Whitman print services):
//       three levels at most, each about 1.6x the one below; space between groups larger
//       than inside them; even safe margins; light text on a dark plate for contrast.
// Generated: by hand, 2026-10-06. Numbers below are integer per-mille so the host computes
//       the same pixels the spec does.
// Claim status: layout only. The numbers are derived (ratios, margins, char advance of a
//       bold sans), the contrast floor is computed (WCAG 2 formula); no poster has been drawn
//       with them yet.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::poster_facts_overlay {

    pub const KIND : str = "automation";
    pub const ID : str = "poster-facts-overlay";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 1;

    // ---- The canvases the image tool produces ----------------------------------------------
    pub const TALL_W : u32 = 1024;
    pub const TALL_H : u32 = 1536;
    pub const SQUARE_W : u32 = 768;
    pub const SQUARE_H : u32 = 768;
    // A canvas whose height is under 1.2x its width uses the square row: on a near-square
    // picture a font sized from the height alone comes out too small to read on a phone.
    pub const TALL_RATIO_PERMILLE : u32 = 1200;

    // ---- Order: one line kind each, missing facts leave no empty line ----------------------
    pub const LINE_ORDER : str = "title,date_time,venue,price";
    pub const LINE_KINDS : u8 = 4;
    pub const FACT_NEVER_TRUNCATED : bool = true;  // a fact that cannot fit is refused, not cut

    // ---- Safe margin: per-mille of the SHORT side, the same on all four edges --------------
    pub const MARGIN_PERMILLE : u32 = 60;

    // ---- Font size per level, per-mille of the canvas height (about 1.6x per level) --------
    // Level 1 = title, level 2 = date and time, level 3 = venue and price.
    pub const TALL_TITLE_PERMILLE : u32 = 60;
    pub const TALL_SECOND_PERMILLE : u32 = 38;
    pub const TALL_DETAIL_PERMILLE : u32 = 24;
    pub const TALL_MIN_PERMILLE : u32 = 20;
    pub const SQUARE_TITLE_PERMILLE : u32 = 80;
    pub const SQUARE_SECOND_PERMILLE : u32 = 50;
    pub const SQUARE_DETAIL_PERMILLE : u32 = 32;
    pub const SQUARE_MIN_PERMILLE : u32 = 28;

    // ---- Wrap, then shrink -----------------------------------------------------------------
    // Average advance of a bold sans glyph, per-mille of the font size; Cyrillic letters are
    // wider than Latin, so this errs wide.
    pub const CHAR_ADVANCE_PERMILLE : u32 = 600;
    pub const LEADING_PERMILLE : u32 = 1200;  // line height = font * 1.2
    pub const TITLE_MAX_LINES : u32 = 2;
    pub const OTHER_MAX_LINES : u32 = 2;
    // The title never shrinks below the second level: the hierarchy does not invert.
    pub const TITLE_FLOOR_IS_SECOND_LEVEL : bool = true;
    // The gap after the title group, per-mille of the second-level font.
    pub const GROUP_GAP_PERMILLE : u32 = 600;

    // ---- The plate: a full-width dark band from the text block to the bottom edge ----------
    pub const PLATE_IS_BLACK : bool = true;
    pub const TEXT_IS_WHITE : bool = true;
    pub const PLATE_OPACITY_PERMILLE : u32 = 550;
    // Computed over 8-bit pixels (WCAG 2 luminance; the host enumerates it): white text on a
    // black plate composited over a WHITE picture is 4.54:1 at 536 and 4.48:1 at 535; 4.5:1
    // is the WCAG AA floor for body text. The worst picture is white, so 536 holds on any.
    pub const PLATE_MIN_OPACITY_PERMILLE : u32 = 536;
    pub const MIN_CONTRAST_X100 : u32 = 450;
    pub const PLATE_PAD_PERMILLE : u32 = 500;  // padding above the text, per-mille of the margin
    // The plate never covers more than this of the height: the picture is still the poster.
    pub const BLOCK_MAX_PERMILLE : u32 = 450;

    // Which row of sizes a canvas takes: "tall" or "square".
    fn row_for(w: u32, h: u32) -> str {
        if h * 1000 >= w * TALL_RATIO_PERMILLE {
            return "tall";
        }
        return "square";
    }

    // The safe margin in pixels.
    fn margin_px(w: u32, h: u32) -> u32 {
        if w < h {
            return w * MARGIN_PERMILLE / 1000;
        }
        return h * MARGIN_PERMILLE / 1000;
    }

    // A per-mille of the height in pixels.
    fn font_px(h: u32, permille: u32) -> u32 {
        return h * permille / 1000;
    }

    // How many characters fit on one line of the content width at this font.
    fn chars_per_line(content_w: u32, font: u32) -> u32 {
        return content_w * 1000 / (font * CHAR_ADVANCE_PERMILLE);
    }

    // Lines a run of characters needs when broken anywhere (the host breaks at spaces, so it
    // may need more, never fewer).
    fn lines_for(chars: u32, per_line: u32) -> u32 {
        return (chars + per_line - 1) / per_line;
    }

    fn line_height_px(font: u32) -> u32 {
        return font * LEADING_PERMILLE / 1000;
    }

    // The largest font, not above `start`, at which `chars` fit in `max_lines` lines; 0 when
    // even `floor` is too big -- the fact is refused, never cut.
    fn shrink_font(chars: u32, max_lines: u32, content_w: u32, start: u32, floor: u32) -> u32 {
        let per_line = (chars + max_lines - 1) / max_lines;
        let font = content_w * 1000 / (per_line * CHAR_ADVANCE_PERMILLE);
        if font >= start {
            return start;
        }
        if font < floor {
            return 0;
        }
        return font;
    }

    fn plate_ok(opacity_permille: u32) -> bool {
        return opacity_permille >= PLATE_MIN_OPACITY_PERMILLE;
    }

    fn block_fits(block_h: u32, h: u32) -> bool {
        return block_h * 1000 <= h * BLOCK_MAX_PERMILLE;
    }

    test "VERSION says what the header's last note says" {
        assert(VERSION == 1);
    }

    test "the tall canvas takes the tall row and both squares the square row" {
        assert(row_for(TALL_W, TALL_H) == "tall");
        assert(row_for(SQUARE_W, SQUARE_H) == "square");
        assert(row_for(1024, 1024) == "square");
        assert(row_for(1000, 1200) == "tall");
        assert(row_for(1000, 1199) == "square");
    }

    test "margins are six per cent of the short side on both canvases" {
        assert(margin_px(TALL_W, TALL_H) == 61);
        assert(margin_px(SQUARE_W, SQUARE_H) == 46);
        assert(margin_px(1536, 1024) == 61);
    }

    test "each level is about 1.6x the one below and the floor is under the detail" {
        assert(font_px(TALL_H, TALL_TITLE_PERMILLE) == 92);
        assert(font_px(TALL_H, TALL_SECOND_PERMILLE) == 58);
        assert(font_px(TALL_H, TALL_DETAIL_PERMILLE) == 36);
        assert(font_px(TALL_H, TALL_MIN_PERMILLE) == 30);
        assert(font_px(SQUARE_H, SQUARE_TITLE_PERMILLE) == 61);
        assert(font_px(SQUARE_H, SQUARE_SECOND_PERMILLE) == 38);
        assert(font_px(SQUARE_H, SQUARE_DETAIL_PERMILLE) == 24);
        assert(font_px(SQUARE_H, SQUARE_MIN_PERMILLE) == 21);
        assert(TALL_MIN_PERMILLE < TALL_DETAIL_PERMILLE);
        assert(SQUARE_MIN_PERMILLE < SQUARE_DETAIL_PERMILLE);
    }

    test "max chars per line before a wrap, per level and canvas" {
        assert(chars_per_line(902, 92) == 16);
        assert(chars_per_line(902, 58) == 25);
        assert(chars_per_line(902, 36) == 41);
        assert(chars_per_line(676, 61) == 18);
        assert(chars_per_line(676, 38) == 29);
        assert(chars_per_line(676, 24) == 46);
    }

    test "a 40-char title wraps to 2 lines after shrinking above the second level" {
        assert(lines_for(40, chars_per_line(902, 92)) == 3);
        assert(shrink_font(40, TITLE_MAX_LINES, 902, 92, 58) == 75);
        assert(lines_for(40, chars_per_line(902, 75)) == 2);
        assert(shrink_font(40, TITLE_MAX_LINES, 676, 61, 38) == 56);
        assert(lines_for(40, chars_per_line(676, 56)) == 2);
    }

    test "a 9-char price never shrinks below the min" {
        assert(shrink_font(9, 1, 902, 36, 30) == 36);
        assert(shrink_font(9, 1, 676, 24, 21) == 24);
        assert(lines_for(9, chars_per_line(676, 24)) == 1);
    }

    test "a fact too long to fit is refused, never cut" {
        assert(FACT_NEVER_TRUNCATED);
        assert(shrink_font(90, OTHER_MAX_LINES, 676, 24, 21) == 24);
        assert(shrink_font(100, OTHER_MAX_LINES, 676, 24, 21) == 22);
        assert(shrink_font(120, OTHER_MAX_LINES, 676, 24, 21) == 0);
    }

    test "4 facts fit inside the block limit on both canvases" {
        assert(line_height_px(75) == 90);
        assert(line_height_px(58) == 69);
        assert(line_height_px(36) == 43);
        assert(block_fits(460, TALL_H));
        assert(block_fits(691, TALL_H));
        assert(!block_fits(692, TALL_H));
        assert(block_fits(326, SQUARE_H));
        assert(block_fits(345, SQUARE_H));
        assert(!block_fits(346, SQUARE_H));
        assert(block_fits(450, 1000));
        assert(!block_fits(451, 1000));
    }

    test "white on the plate keeps 4.5:1 over a white picture" {
        assert(PLATE_IS_BLACK);
        assert(TEXT_IS_WHITE);
        assert(plate_ok(PLATE_OPACITY_PERMILLE));
        assert(plate_ok(536));
        assert(!plate_ok(535));
        assert(MIN_CONTRAST_X100 == 450);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
