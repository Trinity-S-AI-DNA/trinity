// SPDX-License-Identifier: Apache-2.0
// specs/automation/connect-card.t27 -- the owner's Telegram card "Connect Threads and
// LinkedIn": one tap on the phone opens the network's own OAuth consent, after which
// the blog desk may post there (still only on the owner's yes for each post).
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/agent/connect-card.ts (the
//       card, its one-time links, the door that redeems a link) beside
//       src/agent/meta-connect.ts and src/agent/social-api.ts (the OAuth start and
//       callback this card leads to, unchanged) and src/agent/social-tools.ts
//       (social_status reports each network's connect state).
// Why: on 2026-10-07 Threads and LinkedIn were the two desk networks without a token,
//       though both apps were configured on the render service. Consent is a thing
//       only the owner can give, and the only door to it was a screen deep in the
//       app's Profile. The card brings the door to the chat he already reads.
// Who may open a link: the button is a Telegram web_app button, so the page it opens
//       carries the owner's signed launch data; the link is redeemed only with that
//       signature (or his app session), never with the agent's key -- an agent that
//       read the card still cannot start a consent with it. A link is used once and
//       lives LINK_TTL_MS; a dead link puts the card back in the queue, so the next
//       desk tick sends a fresh one instead of leaving a dead button.
// No app, no button: a network whose client id is not on the render service gets a
//       line saying so on the card, never a button that leads nowhere.
// UI words (the owner reads Russian) stay in the host; the spec holds the rules.
// Claim status: written before the owner tapped a card; nothing is connected by it yet.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::connect_card {

    pub const KIND : str = "automation";
    pub const ID : str = "connect-card";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 1;

    // ---- The link on the card -------------------------------------------------------
    pub const LINK_TTL_MS : u32 = 3600000;  // a card's link is good for one hour
    pub const LINK_USES : u8 = 1;  // and is redeemed once
    pub const AGENT_MAY_START : bool = false;  // the agent's key is refused at the door

    // ---- How often the card is sent -------------------------------------------------
    pub const CARD_EVERY_MS : u32 = 604800000;  // once per network per seven days
    pub const CARD_NETWORKS : u8 = 2;  // Threads and LinkedIn

    // ---- What the consent asks for --------------------------------------------------
    pub const THREADS_SCOPES : str = "threads_basic,threads_content_publish";
    pub const LINKEDIN_SCOPES : str = "openid profile w_member_social";

    // ---- What never happens ---------------------------------------------------------
    pub const TOKEN_IN_CARD : bool = false;  // the card carries a link, never a token
    pub const CONNECT_POSTS : bool = false;  // connecting posts nothing by itself

    // ---- Not claimed ----------------------------------------------------------------
    pub const RUN_LIVE : bool = false;  // flips when a tap on a card connected a network

    // A link is honoured once, and only while it is young.
    fn link_ok(age_ms: u32, used: bool) -> bool {
        return !used && age_ms < LINK_TTL_MS;
    }

    // Where a network stands: a usable token is connected whatever else is true;
    // without the app's client id there is nothing to connect to; without the
    // sealing key a token could not be kept; otherwise it waits for the owner.
    fn connect_state(app: bool, sealable: bool, held: bool, usable: bool) -> str {
        if held && usable {
            return "connected";
        }
        if !app {
            return "no-client-id";
        }
        if !sealable {
            return "no-seal-key";
        }
        return "needs-connect";
    }

    // A network is put on the card when it is not connected and the last card
    // for it is a week old, or there was none.
    fn should_card(state: str, ever_sent: bool, since_ms: u32) -> bool {
        return state != "connected" && (!ever_sent || since_ms >= CARD_EVERY_MS);
    }

    // Only a network that can really be connected gets a button.
    fn has_button(state: str) -> bool {
        return state == "needs-connect";
    }

    // The door that turns a link into a consent page opens for the person only.
    fn may_start(actor: str) -> bool {
        return actor == "person";
    }

    test "a link is good once and for an hour" {
        assert(link_ok(0, false));
        assert(link_ok(3599999, false));
        assert(!link_ok(3600000, false));
        assert(!link_ok(0, true));
        assert(LINK_USES == 1);
    }

    test "a usable token is connected, else the missing piece is named" {
        assert(connect_state(true, true, true, true) == "connected");
        assert(connect_state(false, false, true, true) == "connected");
        assert(connect_state(false, true, false, false) == "no-client-id");
        assert(connect_state(false, true, true, false) == "no-client-id");
        assert(connect_state(true, false, false, false) == "no-seal-key");
        assert(connect_state(true, true, false, false) == "needs-connect");
        assert(connect_state(true, true, true, false) == "needs-connect");
    }

    test "a network is carded once a week until it is connected" {
        assert(should_card("needs-connect", false, 0));
        assert(!should_card("needs-connect", true, 604799999));
        assert(should_card("needs-connect", true, 604800000));
        assert(should_card("no-client-id", false, 0));
        assert(!should_card("connected", false, 0));
        assert(!should_card("connected", true, 4294967295));
    }

    test "only a network that can be connected gets a button" {
        assert(has_button("needs-connect"));
        assert(!has_button("no-client-id"));
        assert(!has_button("no-seal-key"));
        assert(!has_button("connected"));
    }

    test "the agent cannot start a consent" {
        assert(may_start("person"));
        assert(!may_start("agent"));
        assert(!AGENT_MAY_START);
    }

    test "the consent asks only to read the profile and to post" {
        assert(THREADS_SCOPES == "threads_basic,threads_content_publish");
        assert(LINKEDIN_SCOPES == "openid profile w_member_social");
        assert(CARD_NETWORKS == 2);
    }

    test "the card carries no token and posts nothing" {
        assert(!TOKEN_IN_CARD);
        assert(!CONNECT_POSTS);
        assert(LINK_TTL_MS < CARD_EVERY_MS);
        assert(!link_ok(CARD_EVERY_MS, false));
    }

    test "nothing has been connected by a card yet" {
        assert(!RUN_LIVE);
        assert(VERSION == 1);
        assert(connect_state(true, true, false, false) != "connected");
    }
}
// phi^2 + 1/phi^2 = 3 | TRINITY
