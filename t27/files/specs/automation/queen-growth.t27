// SPDX-License-Identifier: Apache-2.0
// specs/automation/queen-growth.t27 -- the Queen's "next best action to earn" for one
// connected person, computed from that person's OWN data and nobody else's.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/agent/queen-growth.ts (the
//       tool hive_growth, registered in src/agent/tools.ts next to the hive tools), and
//       `tri growth` (bin/helpers/growth.ts), which prints it for the owner.
// Generated: t27c gen-ts; vendored spec and generated constants in render/src/spec/.
// Design: docs/architecture/queen-god-mode-growth.md in the host (slice 1 of 4).
// Owner, 2026-10-02: "in god mode the Queen speeds up the benefit for all my contacts
//       and the earning of everyone who connects to her; her job is to help everyone in
//       the network earn".
// Law lineage: crm-profit-loop (money is read from the live wallet token_ledger, kind
//       'purchase', one star one token -- never the payments_v2 archive; an unpaid
//       invoice is a question, not a new invoice); the hive board (the refusal comes
//       BEFORE the read).
// What this spec decides: the action vocabulary and its order, the referral threshold,
//       who may read whose recommendation, and that slice 1 sends nothing and promises
//       no sum. What it does NOT decide: the revenue sums themselves -- those are
//       crm-revenue-tool.ts crmRevenue, called, never re-derived.
// Claim status: designed and bound by tests; read-only. RUN_LIVE flips when the owner
//       reads his own action on app.t27.ai and through `tri growth`.
// v1 (2026-10-02): seven actions in one fixed order, unknown is not zero.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::queen_growth {

    pub const KIND : str = "automation";
    pub const ID : str = "queen-growth";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 1;

    pub const TOOL : str = "hive_growth";

    // ---- The actions, in the order they are weighed -----------------------------
    // The first that holds wins: an earlier action unblocks every later one.
    pub const ACT_UNKNOWN : u8 = 0;          // the wallet could not be read: say so
    pub const ACT_CONNECT_BOT : u8 = 1;      // no bot yet: owner-two-tap-onboarding
    pub const ACT_FIRST_CONTACTS : u8 = 2;   // a bot, nobody in the CRM yet
    pub const ACT_FOLLOW_UP_INVOICE : u8 = 3; // an open invoice: ask, do not re-bill
    pub const ACT_FIRST_OFFER : u8 = 4;      // contacts, nobody has paid
    pub const ACT_WIN_BACK : u8 = 5;         // paid before, nothing in the window
    pub const ACT_NEXT_OFFER : u8 = 6;       // earning, too few payers to ask referrals
    pub const ACT_ASK_REFERRAL : u8 = 7;     // enough happy payers: ask who else
    pub const ACT_COUNT : u8 = 8;

    // ---- The numbers ------------------------------------------------------------
    pub const WINDOW_DAYS : u32 = 30;         // "earning now" = purchases in this window
    pub const REFERRAL_MIN_PAYING : u32 = 3;  // a referral ask needs this many payers
    pub const INVOICE_OPEN_DAYS : u32 = 14;   // an unpaid invoice older than this is cold

    // ---- The hard rules of slice 1 ----------------------------------------------
    pub const SENDS_MESSAGES : bool = false;   // read-only: nothing leaves on anyone's behalf
    pub const PROMISES_EARNINGS : bool = false; // no forecast, no "you will earn N"
    pub const READS_PAYMENTS_ARCHIVE : bool = false; // payments_v2 is never read

    // A recommendation is read by its own person only. There is no keeper override in
    // slice 1: reading somebody else's numbers needs that person's consent (slice 3).
    fn may_read(identified: bool, subject_is_caller: bool) -> bool {
        return identified && subject_is_caller;
    }

    // An invoice still worth a follow-up question.
    fn invoice_open(redeemed: bool, cancelled: bool, age_days: u32) -> bool {
        return !redeemed && !cancelled && age_days <= INVOICE_OPEN_DAYS;
    }

    fn next_action(wallet_known: bool, bots: u32, audience: u32, open_invoices: u32,
                   paying: u32, paying_in_window: u32) -> u8 {
        if !wallet_known {
            return ACT_UNKNOWN;
        }
        if bots == 0 {
            return ACT_CONNECT_BOT;
        }
        if audience == 0 {
            return ACT_FIRST_CONTACTS;
        }
        if open_invoices > 0 {
            return ACT_FOLLOW_UP_INVOICE;
        }
        if paying == 0 {
            return ACT_FIRST_OFFER;
        }
        if paying_in_window == 0 {
            return ACT_WIN_BACK;
        }
        if paying < REFERRAL_MIN_PAYING {
            return ACT_NEXT_OFFER;
        }
        return ACT_ASK_REFERRAL;
    }

    test "a recommendation is read by its own identified person only" {
        assert(may_read(true, true));
        assert(!may_read(true, false));
        assert(!may_read(false, true));
        assert(!may_read(false, false));
    }

    test "an unreadable wallet is unknown, never a zero that asks for a first offer" {
        assert(next_action(false, 1, 5, 0, 0, 0) == ACT_UNKNOWN);
        assert(next_action(false, 0, 0, 0, 0, 0) == ACT_UNKNOWN);
    }

    test "no bot comes first, then no contacts" {
        assert(next_action(true, 0, 9, 2, 4, 4) == ACT_CONNECT_BOT);
        assert(next_action(true, 1, 0, 0, 0, 0) == ACT_FIRST_CONTACTS);
    }

    test "an open invoice is followed up before any new offer" {
        assert(next_action(true, 1, 3, 1, 0, 0) == ACT_FOLLOW_UP_INVOICE);
        assert(next_action(true, 1, 3, 1, 5, 5) == ACT_FOLLOW_UP_INVOICE);
    }

    test "an invoice is open while unpaid, not cancelled and at most the open days old" {
        assert(invoice_open(false, false, 0));
        assert(invoice_open(false, false, 14));
        assert(!invoice_open(false, false, 15));
        assert(!invoice_open(true, false, 1));
        assert(!invoice_open(false, true, 1));
    }

    test "contacts and no payer ask for a first offer" {
        assert(next_action(true, 1, 3, 0, 0, 0) == ACT_FIRST_OFFER);
    }

    test "a payer who went quiet in the window is won back" {
        assert(next_action(true, 1, 3, 0, 1, 0) == ACT_WIN_BACK);
        assert(next_action(true, 2, 8, 0, 5, 0) == ACT_WIN_BACK);
    }

    test "referrals are asked from the third payer, not before" {
        assert(next_action(true, 1, 9, 0, 2, 1) == ACT_NEXT_OFFER);
        assert(next_action(true, 1, 9, 0, 3, 1) == ACT_ASK_REFERRAL);
        assert(next_action(true, 1, 9, 0, 7, 2) == ACT_ASK_REFERRAL);
    }

    test "every action code is below the count" {
        assert(ACT_ASK_REFERRAL < ACT_COUNT);
        assert(ACT_COUNT == 8);
    }

    test "slice 1 sends nothing, promises nothing and never reads the archive" {
        assert(!SENDS_MESSAGES);
        assert(!PROMISES_EARNINGS);
        assert(!READS_PAYMENTS_ARCHIVE);
    }

    test "the window is thirty days and referrals need three payers" {
        assert(WINDOW_DAYS == 30);
        assert(REFERRAL_MIN_PAYING == 3);
        assert(INVOICE_OPEN_DAYS == 14);
    }

    test "VERSION says what the header's last note says" {
        assert(VERSION == 1);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
