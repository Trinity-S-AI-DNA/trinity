// SPDX-License-Identifier: Apache-2.0
// specs/automation/ball-board.t27 -- ONE board of everything the owner is in the middle
// of, grouped by CLIENT, and for every card: whose move it is (where the ball is).
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/agent/ball-board.ts (the tools
//       ball_board, ball_work_push, ball_link), registered in src/agent/tools.ts.
// Feeders: the CRM (the render's own crm_waiting, called, never re-derived); the mailbox
//       (jcrm's crm_matter_digest, the table automation/mail-push already receives); the
//       code work (open PRs and bugs of the owner's repositories, pushed by `tri ball push`
//       from the owner's machine through the render's own door -- the mail digest's
//       pattern, so no GitHub token has to live in production).
// Owner, 2026-10-01: "compare my CRM tasks with my mail contacts so the tasks are tied
//       by client, with the status of where the ball is, and everything in work and
//       every bug on the board, so I see the status of all tasks in the project;
//       orchestration through .t27".
// Law lineage: automation/mail-push (a stale digest is refused, not shown; the digest
//       lands through the render's own door, not a second database); the hive board
//       (the refusal comes BEFORE the read; a filter can narrow and never widen).
// What this spec decides: the ball vocabulary and its order, the mail mapping, the
//       code-work ball rules, how a card finds its client, and when a source is
//       reported instead of shown. What it does NOT decide: the CRM's own "whose turn"
//       -- that is crm-stages.ts waitingOn, and restating its numbers here would make
//       two boards that disagree about when a silence starts to matter.
// Claim status: designed and bound by tests; RUN_LIVE flips when the board answers
//       the owner on app.t27.ai with all three sources fresh.
// v2 (2026-10-01), from the first live read (crm 6, mail 134, github 71 cards):
//       - hh.ru was a counterparty of 50 unrelated matters. A domain link on a domain
//         many strangers share (a job board, a mailbox provider, a submission system)
//         would have filed all 50 under one client, so such a link is REFUSED;
//       - code work had no way to a client but its repository, and the blog's PRs live
//         in the same repository as everything else, named "blog: ...". A TITLE link
//         claims the work whose title starts with its value as a word; it is weighed after the
//         label and before the repository, the more specific claim first.
// v3 (2026-10-01), owner: "the AI browser's tasks -- what the agent is doing -- I want
//       on the board, and to open the AI browser at any moment to help the agent or
//       give it a hint; the board is the control centre of the whole game and the
//       agents; and privacy, so users are safe giving us their data". A fourth source,
//       the agent's browser, read ONLY for the caller's own session -- the owner
//       included: there is no reading somebody else's browser from this board. A card
//       says what the agent is on and whether it waits on the person, and opens the
//       app's own browser view; it never carries a viewing token, a pod address or
//       anything the person typed.
// v4 (2026-10-01), owner: "the board is the control centre of the whole game". A fifth
//       source, the caller's own meetings (automation/meeting-reminders), read ONLY for
//       the caller like the browser. A meeting that ended with no answer is past its
//       date (due); one that starts within a day is on us; a later one owes nothing yet.
//       A meeting card carries neither the tap token nor the calendar token, nor the
//       meeting's link or place: the reminder in Telegram already holds those.
// v5 (2026-10-01), from the live board (mail: 115 cards "on us"): jcrm says "we owe"
//       whenever the newest message is inbound, and a machine's message is always
//       inbound -- a DMARC report, a "noreply" notice, a sign-in mail from a publisher
//       sat on the board as a reply owed. A matter whose every address is a machine's
//       (a marker in the address) or the owner's own domain has nobody to answer: its
//       ball is none, and the board COUNTS such matters instead of hiding them. One
//       human address among them keeps the matter as jcrm decided it.
// v6 (2026-10-01), v5 read live: 53 matters weighed as machine-only, 48 of them from
//       noreply@hh.ru. hh.ru is a relay -- "a message from the employer" comes from its
//       no-reply address, and the words in it are a person's. v5 called those robots and
//       moved live conversations off "on us". An address on a relay domain speaks for a
//       person: it is never a machine's, whatever its marker. Only the real machines
//       stay nobody's move.
// v7 (2026-10-01), owner: "one status of where the ball is, per client". Measured: no
//       CRM person matches a mail matter by name, username or address (crm_people has
//       no email), so the join stays the explicit link v2 made and nothing is guessed.
//       The defect is the other way round: jcrm keys a matter by its domain, so gmail.com
//       is ONE matter of 14 people under one stage ("rejected", terminal, so nobody's
//       move) while 3 of them wrote last within a day. A matter named by a shared domain
//       with more than one person in it is a mailbox, not a client: the board COUNTS it
//       and says so on the card. The ball stays jcrm's -- there is no per-person stage
//       on this side to put in its place; the split belongs to jcrm.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::ball_board {

    pub const KIND : str = "automation";
    pub const ID : str = "ball-board";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 7;

    // ---- The doors ------------------------------------------------------------------
    pub const TOOL : str = "ball_board";  // read: the whole board, grouped by client
    pub const PUSH_TOOL : str = "ball_work_push";  // write: the code-work snapshot, owner only
    pub const LINK_TOOL : str = "ball_link";  // write: "this address / repo is that client"
    pub const DOOR : str = "/mcp";  // tools/call, X-Api-Key -- the mail digest's own door

    // ---- The sources ----------------------------------------------------------------
    pub const SOURCE_CRM : str = "crm";  // people in Telegram: crm_waiting, as it is
    pub const SOURCE_MAIL : str = "mail";  // matters in the mailbox: crm_matter_digest
    pub const SOURCE_WORK : str = "github";  // open PRs and bugs: ball_work_digest
    pub const SOURCE_BROWSER : str = "browser";  // the agent's browser: the caller's own
                                                 // session, its open ask, its last step
    pub const SOURCE_MEETING : str = "meeting";  // the caller's own meetings: upcoming,
                                                 // and ended ones nobody answered yet
    pub const CRM_TOOL : str = "crm_waiting";  // CALLED with the caller's context: its
                                               // scope gate and its waitingOn are the
                                               // only ones; this board adds none
    pub const MAIL_TABLE : str = "crm_matter_digest";  // automation/mail-push DIGEST_TABLE
    pub const WORK_TABLE : str = "ball_work_digest";  // one row per open PR or issue
    pub const LINK_TABLE : str = "ball_client_links";  // owner, client, kind, value

    // ---- The ball -------------------------------------------------------------------
    // Columns in the order a day should be spent: what is on us, what is past its date,
    // what waits on somebody else, and what nobody has a move on.
    pub const BALL_OURS : str = "ours";
    pub const BALL_DUE : str = "due";
    pub const BALL_THEIRS : str = "theirs";
    pub const BALL_NONE : str = "none";  // a matter the mailbox knows but owes nothing on
    pub const WAITING_LABEL : str = "waiting";  // an issue label containing this word puts
                                                // the move on somebody else
    pub const BUG_LABEL : str = "bug";  // the push carries every open issue labelled so

    // ---- Freshness ------------------------------------------------------------------
    pub const STALE_H : u8 = 26;  // the mail digest's law, for both pushed sources: a
                                  // snapshot older than a day and a bit is REPORTED as
                                  // stale with its age, and its cards are not shown
    pub const SNAPSHOT_REPLACES : bool = true;  // a push is the whole truth of its repos:
                                                // a PR merged since the last push leaves
                                                // the board, it does not linger as open
                                                // (upsert the snapshot, then prune the
                                                // rest -- a pool is not one connection,
                                                // so there is no BEGIN to lean on)
    pub const CARDS_MAX : u16 = 300;  // one answer; counts are taken over everything

    // ---- Who may read what ----------------------------------------------------------
    pub const MAIL_OWNER_ONLY : bool = true;  // the mailbox is one person's
    pub const WORK_OWNER_ONLY : bool = true;  // a private repository's titles are too
    pub const REFUSE_BEFORE_READ : bool = true;  // a source the caller may not see is
                                                 // reported as not theirs; it is never
                                                 // read and then filtered

    // ---- Where a card's client comes from -------------------------------------------
    pub const LINK_EMAIL : str = "email";  // a counterparty address of a mail matter
    pub const LINK_DOMAIN : str = "domain";  // every address at that domain
    pub const LINK_REPO : str = "repo";  // owner/name: all its work is that client's
    pub const LINK_LABEL : str = "label";  // an issue label, e.g. client:acme
    pub const LINK_TITLE : str = "title";  // a title's first word, e.g. "blog" --
                                           // lower-cased, so "Blog:" is claimed too
    pub const PROJECT_CLIENT : str = "project";  // code work no client claims: the
                                                 // project's own row, never dropped
    pub const UNLINKED_MAIL_IS_ITS_OWN_ROW : bool = true;  // a matter nobody linked stays
                                                           // visible under its own name

    // ---- Every card stands on a spec ------------------------------------------------
    pub const SPEC_OF_CRM : str = "specs/automation/crm-client-workspace.t27";
    pub const SPEC_OF_MAIL : str = "specs/automation/mail-push.t27";
    pub const SPEC_OF_BOARD : str = "specs/automation/ball-board.t27";
    pub const SPEC_OF_BROWSER : str = "specs/automation/browser-sign-in.t27";
    pub const SPEC_OF_MEETING : str = "specs/automation/meeting-reminders.t27";
    pub const UNSPECCED_IS_COUNTED : bool = true;  // a card with no spec is reported,
                                                   // never given one it does not have

    // ---- Domains no single client owns --------------------------------------------
    // A domain link files every address at that domain under one client. For these
    // domains that is false by construction: the address is the channel, not the
    // company (the mail CRM's own ATS list says the same for its matters).
    pub const SHARED_DOMAINS_SEEN : u8 = 50;  // hh.ru's matters on the first live read

    // ---- The agent's browser: what it is on, and whose move ------------------------
    // The person can always take the wheel; the card is the way there, so it opens the
    // app's browser view, where the app's own session decides what may be seen.
    pub const BROWSER_OWN_ONLY : bool = true;  // WHERE telegram_id = the caller, always;
                                               // no caller reads another's browser here
    pub const BROWSER_OPEN_AT : str = "/game/browser";  // the app's view, never /live/
    pub const CARD_CARRIES_NO_TOKEN : bool = true;  // no view or admin token, no endpoint,
                                                    // no pod: those columns are not even
                                                    // selected, so they cannot leak
    pub const TYPED_IS_A_LENGTH : bool = true;  // an answered ask shows how many characters,
                                                // never the characters (the journal's law)
    pub const PROBES_ARE_NOT_WORK : bool = true;  // health probes stay out of "last step"
    pub const ASK_TTL_MIN : u8 = 10;  // an ask or an approval older than this is gone
    pub const STATE_LIVE : str = "live";
    pub const STATE_STARTING : str = "starting";

    // ---- Meetings: the caller's own, and whose move ---------------------------------
    pub const MEETING_OWN_ONLY : bool = true;  // WHERE telegram_id = the caller, always
    pub const MEETING_SOON_H : u8 = 24;  // starts within this: on us to be there
    pub const MEETING_AHEAD_H : u8 = 168;  // later than this is not on the board yet
    pub const MEETING_ASK_BACK_H : u8 = 72;  // an unanswered ended meeting stays this long
    pub const MEETING_CARD_NO_TOKEN : bool = true;  // no tap or ics token, no link, no place
    pub const MEETING_OPEN_STATUS : str = "planned";  // done, missed, cancelled are history

    // ---- Mail nobody can answer ------------------------------------------------------
    pub const OWN_DOMAIN : str = "t27.ai";  // the owner's own address owes nobody
    pub const RELAY_DOMAIN : str = "hh.ru";  // its no-reply carries an employer's words
    pub const RELAY_SEEN : u8 = 48;  // of the 53 machine-only matters v5 found live
    pub const AUTOMATED_IS_COUNTED : bool = true;  // reported as a number, never dropped
    pub const AUTOMATED_SEEN : u8 = 5;  // such matters "on us" on the first live read

    // ---- One matter, many people -----------------------------------------------------
    pub const POOLED_IS_COUNTED : bool = true;  // reported as a number; the ball stays jcrm's
    pub const POOLED_SEEN : u8 = 2;  // gmail.com (14 people) and groups.io (4 lists)
    pub const CRM_MAIL_OVERLAP_SEEN : u8 = 0;  // CRM people found in the mail, measured

    // ---- Not claimed ----------------------------------------------------------------
    pub const RUN_LIVE : bool = false;

    // The mailbox's "who owes the reply" in the board's words. jcrm decides the matter;
    // this side only translates it, and anything it does not recognise owes nothing.
    fn mail_ball(owes_reply: str) -> str {
        if owes_reply == "us" {
            return BALL_OURS;
        }
        if owes_reply == "them" {
            return BALL_THEIRS;
        }
        return BALL_NONE;
    }

    // A machine's address. The host looks for a marker in the address with the
    // separators . - _ + removed (so "no-reply" is "noreply"); finding one is enough.
    fn automated_marker(marker: str) -> bool {
        if marker == "noreply" || marker == "donotreply" || marker == "mailerdaemon" {
            return true;
        }
        if marker == "postmaster" || marker == "bounce" || marker == "dmarc" {
            return true;
        }
        return marker == "notification";
    }

    // A relay: a job board whose no-reply address delivers a person's message. An
    // address on it (or a subdomain of it) is never a machine's.
    fn relay_domain(domain: str) -> bool {
        return domain == RELAY_DOMAIN;
    }

    // Nobody to answer: every address is a machine's or the owner's own. A matter with
    // no address at all is not judged here -- nothing is invented.
    fn nobody_to_answer(addresses: u8, machine_or_own: u8) -> bool {
        return addresses > 0 && machine_or_own == addresses;
    }

    // The mail ball, once the addresses are weighed.
    fn mail_ball_weighed(owes_reply: str, nobody: bool) -> str {
        if nobody {
            return BALL_NONE;
        }
        return mail_ball(owes_reply);
    }

    // A mailbox, not a client: a matter named by a shared domain with more than one
    // person (an address that is not a machine's or the owner's) in it.
    fn pooled_matter(matter_is_shared: bool, people: u8) -> bool {
        return matter_is_shared && people > 1;
    }

    // Code work. A repository the owner merges alone has nobody else to wait on, so an
    // open PR is on us unless a review was asked of somebody else and is still open; a
    // bug is on us until it is closed; an issue is on somebody else only when it is
    // labelled as waiting for them.
    fn work_ball(is_pr: bool, review_asked_of_others: bool, waiting_label: bool) -> str {
        if is_pr && review_asked_of_others {
            return BALL_THEIRS;
        }
        if !is_pr && waiting_label {
            return BALL_THEIRS;
        }
        return BALL_OURS;
    }

    // The column's rank on the board: lower comes first.
    fn ball_rank(ball: str) -> u8 {
        if ball == BALL_OURS {
            return 0;
        }
        if ball == BALL_DUE {
            return 1;
        }
        if ball == BALL_THEIRS {
            return 2;
        }
        return 3;
    }

    // A domain many unrelated senders share. Lower-cased by the caller.
    fn shared_domain(domain: str) -> bool {
        // job boards and applicant-tracking systems
        if domain == "hh.ru" || domain == "getmatch.ru" || domain == "linkedin.com" {
            return true;
        }
        if domain == "greenhouse.io" || domain == "lever.co" || domain == "workable.com" {
            return true;
        }
        // mailbox providers
        if domain == "gmail.com" || domain == "googlemail.com" || domain == "yahoo.com" {
            return true;
        }
        if domain == "outlook.com" || domain == "hotmail.com" || domain == "icloud.com" {
            return true;
        }
        if domain == "mail.ru" || domain == "yandex.ru" || domain == "proton.me" {
            return true;
        }
        // lists and submission systems
        if domain == "groups.io" || domain == "googlegroups.com" {
            return true;
        }
        if domain == "editorialmanager.com" || domain == "github.com" {
            return true;
        }
        return false;
    }

    // Whether a link may be set at all. Only a domain link can claim strangers.
    fn may_link(kind: str, value: str) -> bool {
        if kind == LINK_DOMAIN && shared_domain(value) {
            return false;
        }
        return kind == LINK_EMAIL || kind == LINK_DOMAIN || kind == LINK_REPO
            || kind == LINK_LABEL || kind == LINK_TITLE;
    }

    // A title link claims the work whose title HEAD equals its value. The head is the
    // title's first word, lower-cased, cut at the first ':' or space: "Blog: phi" has
    // the head "blog", "fix(blog): typo" has "fix(blog)" -- a word in passing is not
    // a claim.
    fn title_claims(title_head: str, value: str) -> bool {
        if value == "" {
            return false;
        }
        return title_head == value;
    }

    // The spec a card stands on: the path its title names wins; otherwise the source's
    // spec of record; code work that names none has none ("").
    fn card_spec(source: str, title_spec: str) -> str {
        if title_spec != "" {
            return title_spec;
        }
        if source == SOURCE_CRM {
            return SPEC_OF_CRM;
        }
        if source == SOURCE_MAIL {
            return SPEC_OF_MAIL;
        }
        if source == SOURCE_BROWSER {
            return SPEC_OF_BROWSER;
        }
        if source == SOURCE_MEETING {
            return SPEC_OF_MEETING;
        }
        return "";
    }

    // The browser's ball. An open ask (a field to type, a choice, an approval) or the
    // person holding the wheel puts the move on the person: ours. A browser that is up
    // and asks nothing is the agent's move: theirs. A stopped one is not a card at all.
    fn browser_ball(asks_person: bool, person_has_wheel: bool) -> str {
        if asks_person || person_has_wheel {
            return BALL_OURS;
        }
        return BALL_THEIRS;
    }

    // A session is a card while it is starting or live; "stopped" is history.
    fn browser_is_card(state: str) -> bool {
        return state == STATE_LIVE || state == STATE_STARTING;
    }

    // What a browser card may carry. Everything else in browser_sessions is a key to the
    // stream or the pod, and is refused by name so a new column is refused by default.
    fn browser_field_shown(field: str) -> bool {
        return field == "state" || field == "last_seen_at" || field == "person_wheel_until";
    }

    // A meeting's ball. Ended with no answer: past its date, the person still owes how it
    // went. Starting within MEETING_SOON_H: on us to be there. Later: nobody's move yet.
    fn meeting_ball(ended: bool, answered: bool, starts_soon: bool) -> str {
        if ended && !answered {
            return BALL_DUE;
        }
        if ended {
            return BALL_NONE;
        }
        if starts_soon {
            return BALL_OURS;
        }
        return BALL_NONE;
    }

    // What a meeting card may carry. The tokens open the buttons and the calendar file,
    // the link and the place are the person's own; none of them belong on a board.
    fn meeting_field_shown(field: str) -> bool {
        return field == "title" || field == "starts_at" || field == "ends_at" || field == "mode" || field == "status";
    }

    // A browser row is read only for its own person.
    fn browser_visible(row_is_callers: bool) -> bool {
        return row_is_callers;
    }

    // A pushed snapshot is shown only while it is fresh.
    fn fresh(age_h: u8) -> bool {
        return age_h <= STALE_H;
    }

    // A source is read only for a caller who may see it.
    fn may_read(owner_only: bool, caller_is_owner: bool) -> bool {
        return !owner_only || caller_is_owner;
    }

    test "the mailbox's owes_reply becomes the ball, and nothing else is invented" {
        assert(mail_ball("us") == BALL_OURS);
        assert(mail_ball("them") == BALL_THEIRS);
        assert(mail_ball("") == BALL_NONE);
        assert(mail_ball("both") == BALL_NONE);
        assert(MAIL_TABLE == "crm_matter_digest");
    }

    test "an open PR is ours unless a review is asked of somebody else" {
        assert(work_ball(true, false, false) == BALL_OURS);
        assert(work_ball(true, true, false) == BALL_THEIRS);
        assert(work_ball(true, false, true) == BALL_OURS);
    }

    test "a bug is ours until it is closed, an issue is theirs only when labelled so" {
        assert(work_ball(false, false, false) == BALL_OURS);
        assert(work_ball(false, true, false) == BALL_OURS);
        assert(work_ball(false, false, true) == BALL_THEIRS);
        assert(WAITING_LABEL == "waiting");
        assert(BUG_LABEL == "bug");
    }

    test "the columns run ours, due, theirs, none" {
        assert(ball_rank(BALL_OURS) == 0);
        assert(ball_rank(BALL_DUE) == 1);
        assert(ball_rank(BALL_THEIRS) == 2);
        assert(ball_rank(BALL_NONE) == 3);
        assert(ball_rank("anything") == 3);
    }

    test "a stale snapshot is reported, not shown" {
        assert(fresh(0));
        assert(fresh(26));
        assert(!fresh(27));
        assert(STALE_H == 26);
        assert(SNAPSHOT_REPLACES);
    }

    test "the mailbox and the private repos are the owner's, refused before the read" {
        assert(may_read(MAIL_OWNER_ONLY, true));
        assert(!may_read(MAIL_OWNER_ONLY, false));
        assert(!may_read(WORK_OWNER_ONLY, false));
        assert(may_read(false, false));
        assert(REFUSE_BEFORE_READ);
    }

    test "the CRM is called, not re-derived" {
        assert(CRM_TOOL == "crm_waiting");
        assert(SOURCE_CRM == "crm");
        assert(SOURCE_MAIL == "mail");
        assert(SOURCE_WORK == "github");
        assert(SOURCE_BROWSER == "browser");
    }

    test "every card has a client, and nothing unclaimed is dropped" {
        assert(PROJECT_CLIENT == "project");
        assert(UNLINKED_MAIL_IS_ITS_OWN_ROW);
        assert(LINK_EMAIL != LINK_DOMAIN);
        assert(LINK_REPO != LINK_LABEL);
        assert(CARDS_MAX >= 100);
    }

    test "a domain strangers share cannot be linked to one client" {
        assert(!may_link(LINK_DOMAIN, "hh.ru"));
        assert(!may_link(LINK_DOMAIN, "gmail.com"));
        assert(!may_link(LINK_DOMAIN, "editorialmanager.com"));
        assert(may_link(LINK_DOMAIN, "arxiv.org"));
        assert(may_link(LINK_EMAIL, "someone@gmail.com"));
        assert(!may_link("phone", "123"));
        assert(SHARED_DOMAINS_SEEN == 50);
    }

    test "a title link claims work by the start of its title" {
        assert(title_claims("blog", "blog"));
        assert(!title_claims("fix(blog)", "blog"));
        assert(!title_claims("", ""));
        assert(may_link(LINK_TITLE, "blog"));
        assert(LINK_TITLE != LINK_LABEL);
    }

    test "every card names its spec, or is counted as having none" {
        assert(card_spec(SOURCE_CRM, "") == SPEC_OF_CRM);
        assert(card_spec(SOURCE_MAIL, "") == SPEC_OF_MAIL);
        assert(card_spec(SOURCE_WORK, "") == "");
        assert(card_spec(SOURCE_WORK, "specs/port/x.t27") == "specs/port/x.t27");
        assert(card_spec(SOURCE_CRM, SPEC_OF_BOARD) == SPEC_OF_BOARD);
        assert(UNSPECCED_IS_COUNTED);
    }

    test "the agent's browser waits on the person only when it asks or they drive" {
        assert(browser_ball(true, false) == BALL_OURS);
        assert(browser_ball(false, true) == BALL_OURS);
        assert(browser_ball(false, false) == BALL_THEIRS);
        assert(browser_is_card(STATE_LIVE));
        assert(browser_is_card(STATE_STARTING));
        assert(!browser_is_card("stopped"));
        assert(ASK_TTL_MIN == 10);
    }

    test "a browser card is the caller's own and carries no key to the stream" {
        assert(BROWSER_OWN_ONLY);
        assert(browser_visible(true));
        assert(!browser_visible(false));
        assert(browser_field_shown("state"));
        assert(!browser_field_shown("view_token"));
        assert(!browser_field_shown("admin_token"));
        assert(!browser_field_shown("endpoint"));
        assert(!browser_field_shown("cdp_endpoint"));
        assert(!browser_field_shown("pod_id"));
        assert(CARD_CARRIES_NO_TOKEN);
        assert(TYPED_IS_A_LENGTH);
        assert(PROBES_ARE_NOT_WORK);
        assert(BROWSER_OPEN_AT == "/game/browser");
        assert(card_spec(SOURCE_BROWSER, "") == SPEC_OF_BROWSER);
    }

    test "a meeting that ended unanswered is due, one within a day is ours" {
        assert(meeting_ball(true, false, false) == BALL_DUE);
        assert(meeting_ball(true, true, false) == BALL_NONE);
        assert(meeting_ball(false, false, true) == BALL_OURS);
        assert(meeting_ball(false, false, false) == BALL_NONE);
        assert(MEETING_SOON_H == 24);
        assert(MEETING_SOON_H < MEETING_AHEAD_H);
        assert(MEETING_OPEN_STATUS == "planned");
    }

    test "a meeting card is the caller's own and carries no token, link or place" {
        assert(MEETING_OWN_ONLY);
        assert(MEETING_CARD_NO_TOKEN);
        assert(meeting_field_shown("title"));
        assert(meeting_field_shown("starts_at"));
        assert(!meeting_field_shown("tap_token"));
        assert(!meeting_field_shown("ics_token"));
        assert(!meeting_field_shown("url"));
        assert(!meeting_field_shown("place"));
        assert(!meeting_field_shown("notes"));
        assert(card_spec(SOURCE_MEETING, "") == SPEC_OF_MEETING);
    }

    test "a matter only machines or the owner wrote is nobody's move" {
        assert(automated_marker("noreply"));
        assert(automated_marker("dmarc"));
        assert(automated_marker("notification"));
        assert(!automated_marker("help"));
        assert(!automated_marker("jobs"));
        assert(nobody_to_answer(2, 2));
        assert(!nobody_to_answer(2, 1));
        assert(!nobody_to_answer(0, 0));
        assert(mail_ball_weighed("us", true) == BALL_NONE);
        assert(mail_ball_weighed("us", false) == BALL_OURS);
        assert(mail_ball_weighed("them", false) == BALL_THEIRS);
        assert(OWN_DOMAIN == "t27.ai");
        assert(AUTOMATED_IS_COUNTED);
        assert(AUTOMATED_SEEN == 5);
    }

    test "a relay's no-reply speaks for a person" {
        assert(relay_domain("hh.ru"));
        assert(!relay_domain("osf.io"));
        assert(!relay_domain("fastmaildmarc.com"));
        assert(RELAY_DOMAIN == "hh.ru");
        assert(RELAY_SEEN == 48);
        assert(RELAY_SEEN < 53);
    }

    test "a mailbox provider's matter is not one client" {
        assert(pooled_matter(true, 2));
        assert(pooled_matter(true, 4));
        assert(!pooled_matter(true, 1));
        assert(!pooled_matter(false, 4));
        assert(shared_domain("gmail.com"));
        assert(shared_domain("groups.io"));
        assert(!shared_domain("google.com"));
        assert(POOLED_IS_COUNTED);
        assert(POOLED_SEEN == 2);
        assert(CRM_MAIL_OVERLAP_SEEN == 0);
    }

    test "the board is designed, not yet live" {
        assert(!RUN_LIVE);
        assert(TOOL == "ball_board");
        assert(PUSH_TOOL == "ball_work_push");
        assert(LINK_TOOL == "ball_link");
        assert(DOOR == "/mcp");
        assert(VERSION == 7);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
