// specs/automation/hive-contributor-keys.t27 -- authenticated contributor key boundary.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/hive/contributor-keys-route.ts.
// Trace: gHashTag/t27#5472; gHashTag/999-multibots-telegraf#3251.
// Generated: t27c gen-ts; vendored spec and generated constants in render/src/spec/.
// Claim status: boundary contract; deployment and provider health require live evidence.
// A full person session supplies the Telegram subject. Request bodies never choose an
// owner, upstream URL or GitHub attribution. The Queen owns key storage and XP scoring.
// v1 (2026-10-01): bounded credentials, trusted identity, exact action routes.
// v2 (2026-10-02): one model for all keys of a provider; the proxy waits out the
// Queen's two-key model check (2 x 90 s) instead of cutting it at 45 s.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::hive_contributor_keys {
    pub const KIND : str = "automation";
    pub const ID : str = "hive-contributor-keys";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 2;

    pub const PROXY_TIMEOUT_MS : u32 = 200000;
    pub const BODY_MAX_BYTES : u32 = 8192;
    pub const MAX_SECRET_CHARS : u32 = 4096;
    pub const MAX_LABEL_CHARS : u32 = 80;
    pub const MAX_SUBJECT_DIGITS : u32 = 20;
    pub const MAX_MODEL_CHARS : u32 = 128;
    pub const QUEEN_MODEL_CHECK_MS : u32 = 180000;

    fn may_manage(allowed: bool, person: bool, signed_subject: bool) -> bool {
        return allowed && person && signed_subject;
    }

    fn subject_fits(digits: u32, decimal: bool, positive: bool) -> bool {
        return digits > 0 && digits <= MAX_SUBJECT_DIGITS && decimal && positive;
    }

    fn body_fits(bytes: u32) -> bool {
        return bytes <= BODY_MAX_BYTES;
    }

    fn secret_fits(chars: u32, printable_without_space: bool) -> bool {
        return chars > 0 && chars <= MAX_SECRET_CHARS && printable_without_space;
    }

    fn label_fits(chars: u32) -> bool {
        return chars <= MAX_LABEL_CHARS;
    }

    fn body_allowed(plain_object: bool, known_provider: bool, known_fields: bool) -> bool {
        return plain_object && known_provider && known_fields;
    }

    fn route_allowed(exact_prefix: bool, safe_integer: bool, exact_action: bool) -> bool {
        return exact_prefix && safe_integer && exact_action;
    }

    fn model_fits(chars: u32, catalog_chars: bool) -> bool {
        return chars > 0 && chars <= MAX_MODEL_CHARS && catalog_chars;
    }

    fn model_body_allowed(plain_object: bool, known_provider: bool, only_provider_and_model: bool) -> bool {
        return plain_object && known_provider && only_provider_and_model;
    }

    test "only an allowed person session with a verified subject can manage keys" {
        assert(may_manage(true, true, true));
        assert(!may_manage(false, true, true));
        assert(!may_manage(true, false, true));
        assert(!may_manage(true, true, false));
    }

    test "the trusted subject is positive decimal within the digit limit" {
        assert(subject_fits(1, true, true));
        assert(subject_fits(20, true, true));
        assert(!subject_fits(0, true, true));
        assert(!subject_fits(21, true, true));
        assert(!subject_fits(9, false, true));
        assert(!subject_fits(1, true, false));
    }

    test "the request body is bounded by UTF8 bytes including JSON whitespace" {
        assert(body_fits(8191));
        assert(body_fits(8192));
        assert(!body_fits(8193));
    }

    test "secrets have a nonempty bounded printable value without whitespace" {
        assert(secret_fits(1, true));
        assert(secret_fits(4096, true));
        assert(!secret_fits(0, true));
        assert(!secret_fits(4097, true));
        assert(!secret_fits(32, false));
    }

    test "an optional label is bounded before trimming" {
        assert(label_fits(0));
        assert(label_fits(80));
        assert(!label_fits(81));
    }

    test "only provider credentials and an optional label cross the boundary" {
        assert(body_allowed(true, true, true));
        assert(!body_allowed(false, true, true));
        assert(!body_allowed(true, false, true));
        assert(!body_allowed(true, true, false));
    }

    test "key actions require the exact route and a safe signed integer" {
        assert(route_allowed(true, true, true));
        assert(!route_allowed(false, true, true));
        assert(!route_allowed(true, false, true));
        assert(!route_allowed(true, true, false));
    }

    test "a model name is a bounded nonempty catalog identifier" {
        assert(model_fits(1, true));
        assert(model_fits(128, true));
        assert(!model_fits(0, true));
        assert(!model_fits(129, true));
        assert(!model_fits(12, false));
    }

    test "only a provider and a model cross the model boundary" {
        assert(model_body_allowed(true, true, true));
        assert(!model_body_allowed(false, true, true));
        assert(!model_body_allowed(true, false, true));
        assert(!model_body_allowed(true, true, false));
    }

    test "the proxy outlasts the Queen's slowest model check" {
        assert(PROXY_TIMEOUT_MS > QUEEN_MODEL_CHECK_MS);
    }

    test "VERSION says what the header's last note says" {
        assert(VERSION == 2);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
