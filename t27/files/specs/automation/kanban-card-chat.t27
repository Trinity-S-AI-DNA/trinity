// SPDX-License-Identifier: Apache-2.0
// specs/automation/kanban-card-chat.t27 -- tap ANY card on the game's kanban and a chat
// with the agent opens over the board, with the whole history of that task, so the
// person can write and carry the task on; every A2A agent the person brings reads and
// writes the SAME conversation.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/agent/task-thread.ts (the
//       thread key, the gate, the task note), wired into routes.ts (chat, history,
//       append) and a2a.ts (message/send, message/stream). The sheet: the player's
//       pages/Hive.tsx + components/CardChat. The card: gHashTag/trinity
//       apps/website/src/pages/Queen.tsx KanbanView.
// Owner, 2026-10-01: "make every card on app.t27.ai/game/kanban open a chat and the
//       history with the agent, so any task can be written to and continued; mobile
//       first; synchronised with all A2A agents; the interface between agents and the
//       person tied through .t27".
// Law lineage: automation/crm-client-workspace (one thread per subject, keyed by the
//       person; a thread kind is a prefix, never a second table); the hive board (the
//       board's own words are foreign text -- an issue title is written by whoever
//       opened it, so it reaches the model fenced, never as an instruction).
// What this spec decides: the task thread's key and who may open it, which thread
//       kinds it combines with, the frame -> app message, the card's address, the
//       sheet's first height, the task note's size, and how an A2A call finds the same
//       thread; since v2 also what the sheet says about the task's work (linked pull
//       requests and their checks, measured or honestly not) and that an action the
//       agent proposes runs only on the person's tap; since v5 the person's way to the
//       Queen's move door (a keeper, through render, two taps), the thread live in an
//       open sheet, and the one issue the nightly check keeps; since v6 what the sheet
//       shows while the agent works (a kind and a tool's name, never its words); since
//       v7 the bee's own log on a running card -- its commands and their outcome, live,
//       read through render with the Queen's token. What it
//       does NOT decide: what the
//       agent does in the task (that is the agent's own loop), where a card's column
//       goes (that is the Queen's verdict), or who may merge (that stays the owner's).
// Claim status: designed and bound by tests; RUN_LIVE flips when a card tapped on
//       app.t27.ai/game/kanban opens its chat and an A2A message/send with the same
//       task shows up in it.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::kanban_card_chat {

    pub const KIND : str = "automation";
    pub const ID : str = "kanban-card-chat";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 7;

    // ---- The thread -----------------------------------------------------------------
    // One conversation per (person, task): "task:gHashTag/t27#3587". The person is
    // the row's telegram_id, as for every other thread, so two people talking about
    // the same card never read each other.
    pub const THREAD_PREFIX : str = "task:";
    pub const NUMBER_SEP : str = "#";
    pub const TASK_OWNER : str = "gHashTag";  // only this owner's repositories have cards
    pub const REPO_FROM_BOARD : bool = true;  // a bare number belongs to the repository
                                              // the board publishes (it moved from trios
                                              // to t27 on its own -- measured 2026-10-01),
                                              // never to a name written here
    pub const BOARD_CACHE_S : u16 = 60;  // one read of the board serves a minute of taps
    pub const REPO_NAME_MAX : u8 = 100;  // GitHub's own limit on a repository name
    pub const NUMBER_MAX : u32 = 999999999;  // nine digits; an issue number is never 0
    pub const PER_PERSON : bool = true;
    pub const SPLITS : bool = false;  // one task, one conversation: no ?c= under it

    // ---- What a task thread combines with -------------------------------------------
    // A specialist may be called into a task (the memory stays the task's, as with a
    // client); a task is not a client, not a room, and not one of several conversations.
    pub const WITH_AGENT : bool = true;
    pub const WITH_CLIENT : bool = false;
    pub const WITH_ROOM : bool = false;
    pub const WITH_CONVERSATION : bool = false;

    // ---- The doors ------------------------------------------------------------------
    pub const FIELD : str = "task";  // body field and query parameter: "gHashTag/t27#3587"
    pub const CHAT_DOOR : str = "/api/agent/chat";
    pub const HISTORY_DOOR : str = "/api/agent/history";
    pub const SURFACE : str = "kanban";  // the surface a card's turns are stored under
    pub const HISTORY_LIMIT : u8 = 100;  // turns the sheet reads when it opens

    // ---- The task note --------------------------------------------------------------
    // What the agent is told about the card: number, title, column, criteria, needs,
    // read from the board the person sees. Fenced: an issue title is foreign text.
    pub const NOTE_SOURCE : str = "/queen/public-board";
    pub const NOTE_MAX : u16 = 1200;
    pub const NOTE_FENCED : bool = true;
    pub const NOTE_WITHOUT_BOARD : bool = true;  // the board down: the note still names
                                                 // the task by its key, and says so
    pub const UNTITLED_SAYS_SO : bool = true;  // a card whose title is just "#5382" is
                                               // told to the model as untitled, not as a
                                               // title that happens to be a number

    // ---- The frame -> the app -------------------------------------------------------
    // The board is this origin's /queen/ inside the app's frame. A card tap posts
    // {v:1, type:'t27-app', kind:'open-card', repo, number, title, column} to the page.
    pub const MSG_V : u8 = 1;
    pub const MSG_TYPE : str = "t27-app";
    pub const MSG_KIND : str = "open-card";
    pub const SAME_ORIGIN_ONLY : bool = true;  // only the app's own frame is listened to
    pub const TITLE_MAX : u16 = 200;  // the header shows at most this much of a title

    // ---- The address ----------------------------------------------------------------
    // /game/kanban?card=3587 opens the board with that card's chat; ?repo= only when the
    // card is not the board's own repository. A card the board does not have still
    // opens: its chat says the board does not know it, it never falls back to the feed.
    pub const CARD_PARAM : str = "card";
    pub const REPO_PARAM : str = "repo";

    // ---- The sheet ------------------------------------------------------------------
    // Mobile first: the chat rises over the board to HALF, the board stays visible above
    // it; a drag or a focus in the composer takes it to FULL. The composer is pinned to
    // the bottom at every height, and GitHub is a small link in the header, never the tap.
    pub const DETENT_PEEK : str = "peek";
    pub const DETENT_HALF : str = "half";
    pub const DETENT_FULL : str = "full";
    pub const OPEN_DETENT : str = "half";
    // The same heights as ranks, lower is shorter: the backend compares numbers,
    // not strings, so the order of the three is stated where it can be checked.
    pub const DETENT_PEEK_RANK : u8 = 0;
    pub const DETENT_HALF_RANK : u8 = 1;
    pub const DETENT_FULL_RANK : u8 = 2;
    pub const OPEN_DETENT_RANK : u8 = 1;
    pub const COMPOSER_PINNED : bool = true;
    pub const GITHUB_IS_SECONDARY : bool = true;
    pub const TOUCH_TARGET_PX : u8 = 44;

    // ---- A2A ------------------------------------------------------------------------
    // An outside agent continues the task by naming it: message.metadata.task, or a
    // contextId that IS the thread key. Either way the turn is read from and written to
    // the person's task thread, so the sheet shows what the agent said, and the agent
    // sees what the person said.
    pub const A2A_META_KEY : str = "task";
    pub const A2A_CONTEXT_IS_THREAD : bool = true;
    pub const A2A_HISTORY_TURNS : u8 = 20;  // prior turns handed to the model per call
    pub const A2A_PERSISTS : bool = true;  // the conversation outlives a deploy; the
                                           // in-memory task map only tracks the run

    // ---- The task's work, said in the sheet (v2) -------------------------------------
    // Under the title: the pull requests that name the issue (cross-repository too) and
    // the worst state of their checks. Read from GitHub's public API by the person's own
    // client; the server holds no GitHub token. Over the public limit the strip says it
    // was NOT measured and when it can be again -- never "no pull request".
    pub const STATUS_CACHE_S : u16 = 300;  // one read serves five minutes of opens
    pub const PRS_SHOWN_MAX : u8 = 3;  // more are behind the GitHub link
    pub const CHECKS_PRS_MAX : u8 = 2;  // checks are read for this many open PRs only
    pub const CHECK_PASS_RANK : u8 = 0;  // neutral and skipped count as passed
    pub const CHECK_PENDING_RANK : u8 = 1;
    pub const CHECK_FAIL_RANK : u8 = 2;
    pub const CHECK_NONE_RANK : u8 = 3;  // the PR has no checks at all
    pub const STATUS_UNMEASURED : u8 = 0;
    pub const STATUS_NO_PR : u8 = 1;
    pub const STATUS_PRS : u8 = 2;
    pub const UNMEASURED_IS_NOT_NONE : bool = true;
    pub const LIMIT_SAYS_WHEN : bool = true;
    // v3, measured on a live issue (999-multibots-telegraf#999: 149 events, 58 PRs):
    // one page of 100 said "+42" for 55 and, the timeline running oldest first, would
    // hide the newest open PR on page two. Read the first page and the last; what lies
    // between is said as "at least", never as a count.
    pub const TIMELINE_PAGE : u8 = 100;
    pub const TIMELINE_PAGES_MAX : u8 = 2;  // the first and the last
    pub const MIDDLE_SAYS_AT_LEAST : bool = true;
    // Check runs are read by the PR's head ref (refs/pull/<n>/head): one read, not a
    // pulls/<n> read for the head sha and then another.
    pub const CHECKS_ONE_READ : bool = true;
    pub const PUBLIC_READS_HOUR : u8 = 60;  // GitHub's unauthenticated limit per address
    pub const READS_PER_OPEN_MAX : u8 = 4;  // TIMELINE_PAGES_MAX + CHECKS_PRS_MAX
    pub const OPENS_PER_HOUR_MIN : u8 = 15;  // uncached card opens before the limit

    // ---- The server reads for everyone (v4) -----------------------------------------
    // With a read-only GitHub token on the server (SERVER_TOKEN_ENV -- the owner's call)
    // one GraphQL query returns the NEWEST cross-references and each PR's check rollup,
    // and its answer serves every person for STATUS_CACHE_S. Without the token the door
    // says it is not configured and the client reads for itself as in v3. A door that
    // did not measure never answers "no pull request"; the client then reads itself.
    pub const STATUS_DOOR : str = "/api/card-status";
    pub const SERVER_TOKEN_ENV : str = "GITHUB_READ_TOKEN";
    pub const STATUS_DOOR_NEEDS_PERSON : bool = true;  // nobody burns the token anonymously
    pub const SERVER_READS_PER_OPEN : u8 = 1;  // one query: references and rollups
    pub const SERVER_REFS_LAST : u8 = 100;  // the newest end of the timeline, not the oldest
    pub const SERVER_SHARED_CACHE : bool = true;  // one read serves every person
    pub const SERVER_CACHE_CARDS_MAX : u16 = 1000;  // the board holds ~900 cards
    pub const SERVER_READS_ONLY : bool = true;  // the query is never a mutation
    pub const SOURCE_SERVER : u8 = 0;
    pub const SOURCE_CLIENT : u8 = 1;

    // ---- What the agent may do with the card (v2) -----------------------------------
    // The agent proposes; the person decides. A proposal is a card in the conversation
    // with approve and decline, and nothing outside the conversation happens before the
    // tap. The column is the Queen's verdict, computed from the registry and the
    // dispatch: the sheet offers no move, because no door could honour it.
    pub const CARDS_ON_KANBAN : bool = true;  // the card chat gets the proposal cards
    pub const ACTIONS_ON_TAP_ONLY : bool = true;
    pub const MOVE_OFFERED : bool = false;
    pub const AGENT_OPENS_PR : bool = false;  // a read token cannot write; writing is the owner's call

    // ---- Moving a card: the contract for a door that does not exist yet (v4, S15) ----
    // Read on the Queen's deployed server (BrowserOS trios/agent-server, #517): a column
    // is computed when the board is read -- registry task first, then the dispatch
    // verdict, then the open issue -- and no route sets one. The only write that could
    // change a column, PUT /queen/registry, replaces the whole task array: a sheet that
    // used it to move one card would race every other writer. So the sheet offers no
    // move until the Queen has a door for ONE card, and this is that door's contract.
    pub const COL_BACKLOG : u8 = 0;
    pub const COL_BLOCKED : u8 = 1;
    pub const COL_RUNNING : u8 = 2;
    pub const COL_REVIEW : u8 = 3;
    pub const COL_DONE : u8 = 4;
    pub const COL_DROPPED : u8 = 5;
    pub const COLUMNS : u8 = 6;
    pub const MOVE_DOOR : str = "/queen/move";  // proposed; 404 on the live server
    pub const MOVE_DOOR_EXISTS : bool = false;
    pub const MOVE_DOOR_ONE_CARD : bool = true;  // one issue per request, never the registry
    pub const REGISTRY_PUT_IS_A_MOVE : bool = false;
    pub const MOVE_SAYS_FROM : bool = true;  // the column the person saw; stale -> refused
    pub const MOVE_ANSWER_HAS_REASON : bool = true;  // accepted or declined, always said why

    // ---- The person's way to the door (v5, S16) -------------------------------------
    // The Queen's door takes the deployment's own credential and nothing else: a
    // browser cannot reach it. The person taps in the sheet; render checks the person
    // is a keeper of the hive, then calls the door with the token it holds. The token
    // never reaches a browser. The Queen's reason comes back as she said it.
    pub const MOVE_PROXY : str = "/api/card-move";
    pub const MOVE_TOKEN_ENV : str = "TRIOS_API_TOKEN";
    pub const MOVE_NEEDS_KEEPER : bool = true;  // a bee or a bot owner sees no button
    pub const MOVE_TOKEN_TO_BROWSER : bool = false;
    pub const MOVE_REASON_MAX : u8 = 200;  // the door's own limit, one sentence
    pub const MOVE_CONFIRM_TAPS : u8 = 2;  // the first tap arms, the second sends
    pub const MOVE_ARM_S : u8 = 5;  // an armed button disarms itself after this long
    pub const MOVE_NONE : u8 = 6;  // == COLUMNS: no move is offered from this column

    // ---- The thread live (v5, S17) --------------------------------------------------
    // An A2A agent writing into the same task thread shows up in the open sheet without
    // a reload. One stream per open sheet, scoped to the person like the history; it
    // sends only turns newer than the last id the sheet holds, and the server looks
    // again on its own every LIVE_RECHECK_S so a turn written by another replica is not
    // lost. The stream ends after LIVE_STREAM_MAX_S and the browser reconnects with
    // the last id it saw: no stream lives forever on a proxy that cuts idle ones.
    pub const LIVE_DOOR : str = "/api/agent/history/live";
    pub const LIVE_PER_PERSON : bool = true;
    pub const LIVE_RECHECK_S : u8 = 15;
    pub const LIVE_STREAM_MAX_S : u16 = 300;
    pub const LIVE_PING_S : u8 = 25;  // under the 30 s idle cut of the platform proxy
    pub const LIVE_AFTER_ID : bool = true;  // resume from the last id, never from zero

    // ---- The agent at work (v6, S19) ------------------------------------------------
    // A turn takes seconds to minutes and the sheet showed nothing until the answer was
    // written. While a turn runs in a task thread, the live stream also carries what
    // the agent is doing: thinking, calling a tool by NAME, writing the answer, done.
    // Names only -- the thinking text and a tool's arguments are the turn's own and
    // never leave it. The signal is not stored: it reaches a sheet listening on the
    // replica that runs the turn, and a sheet elsewhere still gets the answer by the
    // recheck. The stream sends a kind only when it changes, and the sheet drops the
    // line after WORK_IDLE_S of silence, so a turn that died unseen does not show as
    // running forever.
    pub const WORK_EVENT : str = "work";
    pub const WORK_NAMES_ONLY : bool = true;
    pub const WORK_STORED : bool = false;
    pub const WORK_NONE : u8 = 0;
    pub const WORK_THINKING : u8 = 1;
    pub const WORK_TOOL : u8 = 2;
    pub const WORK_WRITING : u8 = 3;
    pub const WORK_DONE : u8 = 4;
    pub const WORK_NAME_MAX : u8 = 64;
    pub const WORK_IDLE_S : u8 = 90;  // longer than a slow tool, shorter than a doubt

    // ---- The bee's own log (v7, S20) ------------------------------------------------
    // Owner, 2026-10-03: "tapping a card I want to see the agent working online -- its
    // logs, its tool calls, the tri commands it runs". The v6 line shows the agent of
    // the CHAT; the card's work is done by a Queen bee in another service, whose log
    // the Queen keeps (BEE_SOURCE, Bearer token only, up to BEE_PAGE_MAX rows a read).
    // Render reads it for a signed-in person and answers rows, never the token
    // (BEE_TOKEN_TO_BROWSER false), never storing them (BEE_STORED false). One attempt
    // at a time: the rows of the dispatch's own conversation, from the last seq on.
    // A command is shown as written up to the first word that could carry a secret (an
    // assignment, a quote, a `$`); the rest is cut. A result is ok or failed and its
    // first line. The model's own words (BEE_PROSE) are the noisiest and the likeliest
    // to repeat what it read, so only a keeper of the hive gets them, joined into one
    // thought and capped. The sheet asks every BEE_POLL_S while the bee runs, every
    // BEE_IDLE_POLL_S after, and keeps the last BEE_ROWS_MAX rows.
    pub const BEE_DOOR : str = "/api/card-work";
    pub const BEE_SOURCE : str = "/queen/feed/data";
    pub const BEE_TOKEN_ENV : str = "TRIOS_API_TOKEN";
    pub const BEE_TOKEN_TO_BROWSER : bool = false;
    pub const BEE_STORED : bool = false;
    pub const BEE_ONE_ATTEMPT : bool = true;
    pub const BEE_PAGE_MAX : u16 = 500;
    pub const BEE_ROWS_MAX : u16 = 300;
    pub const BEE_POLL_S : u8 = 3;
    pub const BEE_IDLE_POLL_S : u8 = 30;
    pub const BEE_CACHE_S : u8 = 2;  // persons on one card share one read
    pub const BEE_LINE_MAX : u8 = 180;
    pub const BEE_THOUGHT_MAX : u16 = 400;
    pub const BEE_SECRET_RUN : u8 = 24;  // a run of this many token characters is masked
    pub const BEE_PROSE_KEEPER_ONLY : bool = true;
    pub const BEE_ROW_TOOL : u8 = 1;
    pub const BEE_ROW_RESULT : u8 = 2;
    pub const BEE_ROW_THOUGHT : u8 = 3;
    pub const BEE_ROW_USAGE : u8 = 4;
    pub const BEE_ROW_ERROR : u8 = 5;
    // The sheet has two faces, the chat and the bee. A card a bee is on opens on its
    // bee until the person picks a face (BEE_FACE_FIRST_RUNNING), and the bee's face
    // takes the sheet to BEE_FACE_DETENT: a phone at HALF showed two lines of the log
    // (tri shot card-chat-bee, 2026-10-03). A message sent shows the chat, where its
    // answer lands (SEND_SHOWS_CHAT).
    pub const BEE_FACE_FIRST_RUNNING : bool = true;
    pub const BEE_FACE_DETENT : str = "full";
    pub const BEE_FACE_DETENT_RANK : u8 = 2;
    pub const SEND_SHOWS_CHAT : bool = true;

    // ---- The nightly look (v5, S18) -------------------------------------------------
    // tri card-check compares the server's read of a card with the client's. Drift is
    // written into ONE issue under the EPIC and updated there, never a new issue a
    // night; the issue is closed by the check that finds the two agreeing again.
    pub const DRIFT_ONE_ISSUE : bool = true;
    pub const DRIFT_NONE : u8 = 0;
    pub const DRIFT_OPEN : u8 = 1;
    pub const DRIFT_COMMENT : u8 = 2;
    pub const DRIFT_CLOSE : u8 = 3;

    // ---- Not claimed ----------------------------------------------------------------
    pub const RUN_LIVE : bool = false;

    // The stream sends a work kind only when it differs from the last one it sent
    // (for a tool: or the tool's name differs).
    fn work_send(last: u8, kind: u8, same_name: bool) -> bool {
        return kind != last || (kind == WORK_TOOL && !same_name);
    }

    // The sheet shows the line for a running kind heard less than WORK_IDLE_S ago.
    fn work_shown(kind: u8, quiet_s: u16) -> bool {
        return kind != WORK_NONE && kind != WORK_DONE && quiet_s < WORK_IDLE_S;
    }

    // How often the sheet asks for the bee's log: often while it runs, rarely after.
    fn bee_poll_s(running: bool) -> u8 {
        if (running) {
            return BEE_POLL_S;
        }
        return BEE_IDLE_POLL_S;
    }

    // A row of the model's own words reaches only a keeper.
    fn bee_prose_sent(keeper: bool) -> bool {
        return keeper || !BEE_PROSE_KEEPER_ONLY;
    }

    // An issue number the thread accepts.
    fn number_ok(n: u32) -> bool {
        return n >= 1 && n <= NUMBER_MAX;
    }

    // A repository the thread accepts: this owner's, and a name GitHub could have.
    fn repo_ok(owner_is_ours: bool, name_len: u8) -> bool {
        return owner_is_ours && name_len >= 1 && name_len <= REPO_NAME_MAX;
    }

    // A task thread next to the other thread parts of a request. Only a specialist
    // may come along; anything else is refused, not silently dropped.
    fn combines(has_client: bool, has_room: bool, has_conversation: bool) -> bool {
        return !has_client && !has_room && !has_conversation;
    }

    // The frame's message opens a card only when it is the app's own frame and the
    // envelope is the one this spec names.
    fn opens_card(same_origin: bool, v: u8, kind_ok: bool, number: u32) -> bool {
        return same_origin && v == MSG_V && kind_ok && number_ok(number);
    }

    // How much of the board's text about a card reaches the model.
    fn note_len(available: u16) -> u16 {
        if available > NOTE_MAX {
            return NOTE_MAX;
        }
        return available;
    }


    // Which turns an A2A call hands to the model: the last A2A_HISTORY_TURNS.
    fn a2a_turns(stored: u16) -> u16 {
        if stored > A2A_HISTORY_TURNS {
            return A2A_HISTORY_TURNS;
        }
        return stored;
    }

    // The worst state among a PR's checks: one failure outranks everything.
    fn checks_rank(failed: u16, pending: u16, passed: u16) -> u8 {
        if failed > 0 {
            return CHECK_FAIL_RANK;
        }
        if pending > 0 {
            return CHECK_PENDING_RANK;
        }
        if passed > 0 {
            return CHECK_PASS_RANK;
        }
        return CHECK_NONE_RANK;
    }

    // What the strip says: a read that did not happen is not an empty answer.
    fn status_state(measured: bool, found: u16) -> u8 {
        if !measured {
            return STATUS_UNMEASURED;
        }
        if found == 0 {
            return STATUS_NO_PR;
        }
        return STATUS_PRS;
    }

    // How many pull requests the strip lists.
    fn prs_shown(found: u16) -> u16 {
        if found > PRS_SHOWN_MAX {
            return PRS_SHOWN_MAX;
        }
        return found;
    }

    // Timeline pages read for an issue with `pages` pages in all.
    fn pages_read(pages: u16) -> u16 {
        if pages > TIMELINE_PAGES_MAX {
            return TIMELINE_PAGES_MAX;
        }
        return pages;
    }

    // Whether "more on GitHub" is a lower bound: some pages were not read.
    fn more_is_lower_bound(pages: u16) -> bool {
        return pages > TIMELINE_PAGES_MAX;
    }

    // Who reads the card's work: the server when it holds the token and measured,
    // otherwise the person's own client (v3).
    fn status_source(token_set: bool, door_measured: bool) -> u8 {
        if token_set && door_measured {
            return SOURCE_SERVER;
        }
        return SOURCE_CLIENT;
    }

    // The server's read is a floor when GitHub holds more references than it returned.
    fn refs_partial(total: u16, returned: u16) -> bool {
        return total > returned;
    }

    // The sheet offers a move only when the Queen has a door for one card.
    fn move_offered(door_exists: bool, one_card: bool) -> bool {
        return door_exists && one_card;
    }

    // A person may only ask for "later" or "not doing": running and review are a
    // dispatch, blocked is a boundary, done is the Queen's acceptance.
    fn move_target_ok(to: u8) -> bool {
        return to == COL_BACKLOG || to == COL_DROPPED;
    }

    // A move happens when the door exists, the person tapped, the column is still the
    // one they saw, the target is theirs to ask for, and the Queen accepted.
    fn move_applies(door_exists: bool, tapped: bool, from_matches: bool, to: u8, queen_accepts: bool) -> bool {
        return door_exists && tapped && from_matches && move_target_ok(to) && queen_accepts;
    }

    // The button shows only to a keeper, only when render holds the token and only
    // when the Queen's door is deployed.
    fn move_allowed(is_keeper: bool, token_set: bool, door_exists: bool) -> bool {
        return is_keeper && token_set && door_exists;
    }

    // The one move the sheet offers from a column, or MOVE_NONE. A card that is not
    // anybody's yet can be dropped; a dropped card can go back -- the Queen refuses,
    // with her reason, when the drop was her own verdict.
    fn move_choice(col: u8) -> u8 {
        if col == COL_BACKLOG || col == COL_BLOCKED {
            return COL_DROPPED;
        }
        if col == COL_DROPPED {
            return COL_BACKLOG;
        }
        return MOVE_NONE;
    }

    // A turn the open sheet does not hold yet.
    fn live_fresh(id: u32, last_seen: u32) -> bool {
        return id > last_seen;
    }

    // What the nightly check does with its drift issue.
    fn drift_action(drifted: bool, issue_open: bool) -> u8 {
        if drifted && issue_open {
            return DRIFT_COMMENT;
        }
        if drifted {
            return DRIFT_OPEN;
        }
        if issue_open {
            return DRIFT_CLOSE;
        }
        return DRIFT_NONE;
    }

    // An action the agent proposed runs only when the person tapped approve.
    fn action_runs(proposed: bool, approved_by_tap: bool) -> bool {
        return proposed && approved_by_tap;
    }

    test "a task thread is keyed by owner, repository and number" {
        assert(REPO_FROM_BOARD);
        assert(BOARD_CACHE_S <= 300);
        assert(number_ok(1));
        assert(number_ok(3587));
        assert(number_ok(NUMBER_MAX));
        assert(!number_ok(0));
        assert(!number_ok(1000000000));
    }

    test "only this owner's repositories have task threads" {
        assert(repo_ok(true, 5));
        assert(!repo_ok(false, 5));
        assert(!repo_ok(true, 0));
        assert(!repo_ok(true, 101));
        assert(repo_ok(true, REPO_NAME_MAX));
    }

    test "the thread is the person's and does not split" {
        assert(PER_PERSON);
        assert(!SPLITS);
        assert(!WITH_CONVERSATION);
    }

    test "a specialist may join a task, a client or a room may not" {
        assert(WITH_AGENT);
        assert(!WITH_CLIENT);
        assert(!WITH_ROOM);
        assert(combines(false, false, false));
        assert(!combines(true, false, false));
        assert(!combines(false, true, false));
        assert(!combines(false, false, true));
    }

    test "the frame opens a card only through the named envelope" {
        assert(SAME_ORIGIN_ONLY);
        assert(opens_card(true, 1, true, 3587));
        assert(!opens_card(false, 1, true, 3587));
        assert(!opens_card(true, 2, true, 3587));
        assert(!opens_card(true, 1, false, 3587));
        assert(!opens_card(true, 1, true, 0));
    }

    test "the task note is bounded and fenced" {
        assert(note_len(10) == 10);
        assert(note_len(1200) == 1200);
        assert(note_len(5000) == NOTE_MAX);
        assert(NOTE_FENCED);
        assert(NOTE_WITHOUT_BOARD);
        assert(UNTITLED_SAYS_SO);
    }

    test "the sheet opens at half with the composer pinned" {
        assert(OPEN_DETENT_RANK == DETENT_HALF_RANK);
        assert(DETENT_PEEK_RANK < DETENT_HALF_RANK);
        assert(DETENT_HALF_RANK < DETENT_FULL_RANK);
        assert(COMPOSER_PINNED);
        assert(GITHUB_IS_SECONDARY);
        assert(TOUCH_TARGET_PX >= 44);
    }

    test "a card has its own address" {
        // The names themselves (card, repo, task, kanban) are strings, which the
        // backend does not compare; the host test pins each one against the code.
        assert(TITLE_MAX >= 80);
    }

    test "an A2A agent continues the same thread" {
        assert(A2A_CONTEXT_IS_THREAD);
        assert(A2A_PERSISTS);
        assert(a2a_turns(3) == 3);
        assert(a2a_turns(500) == A2A_HISTORY_TURNS);
    }

    test "one failed check outranks the rest" {
        assert(checks_rank(1, 5, 9) == CHECK_FAIL_RANK);
        assert(checks_rank(0, 1, 9) == CHECK_PENDING_RANK);
        assert(checks_rank(0, 0, 9) == CHECK_PASS_RANK);
        assert(checks_rank(0, 0, 0) == CHECK_NONE_RANK);
        assert(CHECK_PASS_RANK < CHECK_PENDING_RANK);
        assert(CHECK_PENDING_RANK < CHECK_FAIL_RANK);
    }

    test "a read that did not happen never says no pull request" {
        assert(UNMEASURED_IS_NOT_NONE);
        assert(LIMIT_SAYS_WHEN);
        assert(status_state(false, 0) == STATUS_UNMEASURED);
        assert(status_state(false, 4) == STATUS_UNMEASURED);
        assert(status_state(true, 0) == STATUS_NO_PR);
        assert(status_state(true, 2) == STATUS_PRS);
        assert(STATUS_UNMEASURED != STATUS_NO_PR);
    }

    test "the strip is short and cheap" {
        assert(prs_shown(1) == 1);
        assert(prs_shown(40) == PRS_SHOWN_MAX);
        assert(CHECKS_PRS_MAX <= PRS_SHOWN_MAX);
        assert(STATUS_CACHE_S >= BOARD_CACHE_S);
    }

    test "a long timeline is read at both ends, the middle said as at least" {
        assert(TIMELINE_PAGE == 100);
        assert(pages_read(1) == 1);
        assert(pages_read(2) == 2);
        assert(pages_read(9) == TIMELINE_PAGES_MAX);
        assert(!more_is_lower_bound(1));
        assert(!more_is_lower_bound(2));
        assert(more_is_lower_bound(3));
        assert(MIDDLE_SAYS_AT_LEAST);
    }

    test "one open of a card costs at most four public reads" {
        assert(CHECKS_ONE_READ);
        assert(READS_PER_OPEN_MAX == TIMELINE_PAGES_MAX + CHECKS_PRS_MAX);
        assert(PUBLIC_READS_HOUR / READS_PER_OPEN_MAX >= OPENS_PER_HOUR_MIN);
    }

    test "with no token the door says so and the client reads for itself" {
        assert(status_source(false, false) == SOURCE_CLIENT);
        assert(status_source(false, true) == SOURCE_CLIENT);
        assert(status_source(true, false) == SOURCE_CLIENT);
        assert(status_source(true, true) == SOURCE_SERVER);
        assert(SOURCE_SERVER != SOURCE_CLIENT);
        assert(STATUS_DOOR_NEEDS_PERSON);
        assert(UNMEASURED_IS_NOT_NONE);
    }

    test "the server reads once for everyone, newest first, and says when there were more" {
        assert(SERVER_READS_PER_OPEN == 1);
        assert(SERVER_READS_PER_OPEN < READS_PER_OPEN_MAX);
        assert(SERVER_SHARED_CACHE);
        assert(SERVER_READS_ONLY);
        assert(SERVER_REFS_LAST == TIMELINE_PAGE);
        assert(refs_partial(150, 100));
        assert(!refs_partial(40, 40));
        assert(!refs_partial(0, 0));
        assert(SERVER_CACHE_CARDS_MAX >= 900);
    }

    test "the agent proposes, the person's tap decides" {
        assert(CARDS_ON_KANBAN);
        assert(ACTIONS_ON_TAP_ONLY);
        assert(action_runs(true, true));
        assert(!action_runs(true, false));
        assert(!action_runs(false, true));
        assert(!MOVE_OFFERED);
        assert(!AGENT_OPENS_PR);
    }

    test "a move is one card through the Queen's door, and there is no door yet" {
        assert(COLUMNS == 6);
        assert(!MOVE_DOOR_EXISTS);
        assert(MOVE_OFFERED == move_offered(MOVE_DOOR_EXISTS, MOVE_DOOR_ONE_CARD));
        assert(!move_offered(true, false));
        assert(move_offered(true, true));
        assert(!REGISTRY_PUT_IS_A_MOVE);
        assert(MOVE_SAYS_FROM);
        assert(MOVE_ANSWER_HAS_REASON);
        assert(move_target_ok(COL_BACKLOG));
        assert(move_target_ok(COL_DROPPED));
        assert(!move_target_ok(COL_DONE));
        assert(!move_target_ok(COL_RUNNING));
        assert(!move_target_ok(COL_REVIEW));
        assert(!move_target_ok(COL_BLOCKED));
        assert(move_applies(true, true, true, COL_DROPPED, true));
        assert(!move_applies(false, true, true, COL_DROPPED, true));
        assert(!move_applies(true, false, true, COL_DROPPED, true));
        assert(!move_applies(true, true, false, COL_DROPPED, true));
        assert(!move_applies(true, true, true, COL_DONE, true));
        assert(!move_applies(true, true, true, COL_BACKLOG, false));
    }

    test "the person reaches the door through render, and only a keeper" {
        assert(MOVE_NEEDS_KEEPER);
        assert(!MOVE_TOKEN_TO_BROWSER);
        assert(MOVE_CONFIRM_TAPS == 2);
        assert(MOVE_ARM_S >= 3);
        assert(MOVE_NONE == COLUMNS);
        assert(move_allowed(true, true, true));
        assert(!move_allowed(false, true, true));
        assert(!move_allowed(true, false, true));
        assert(!move_allowed(true, true, false));
        assert(!move_allowed(true, true, MOVE_DOOR_EXISTS));
        assert(move_choice(COL_BACKLOG) == COL_DROPPED);
        assert(move_choice(COL_BLOCKED) == COL_DROPPED);
        assert(move_choice(COL_DROPPED) == COL_BACKLOG);
        assert(move_choice(COL_RUNNING) == MOVE_NONE);
        assert(move_choice(COL_REVIEW) == MOVE_NONE);
        assert(move_choice(COL_DONE) == MOVE_NONE);
        assert(move_target_ok(move_choice(COL_BACKLOG)));
        assert(move_target_ok(move_choice(COL_DROPPED)));
    }

    test "the sheet sees a new turn without a reload, from the last id on" {
        assert(LIVE_PER_PERSON);
        assert(LIVE_AFTER_ID);
        assert(LIVE_PING_S < 30);
        assert(LIVE_RECHECK_S < LIVE_PING_S);
        assert(LIVE_STREAM_MAX_S >= 60);
        assert(live_fresh(11, 10));
        assert(!live_fresh(10, 10));
        assert(!live_fresh(9, 10));
    }

    test "the sheet shows the agent at work, by name, never its words" {
        assert(WORK_NAMES_ONLY);
        assert(!WORK_STORED);
        assert(WORK_IDLE_S > LIVE_PING_S);
        assert(WORK_IDLE_S < LIVE_STREAM_MAX_S);
        assert(work_send(WORK_NONE, WORK_THINKING, true));
        assert(!work_send(WORK_THINKING, WORK_THINKING, true));
        assert(work_send(WORK_THINKING, WORK_TOOL, true));
        assert(!work_send(WORK_TOOL, WORK_TOOL, true));
        assert(work_send(WORK_TOOL, WORK_TOOL, false));
        assert(!work_send(WORK_WRITING, WORK_WRITING, false));
        assert(work_send(WORK_WRITING, WORK_DONE, true));
        assert(work_shown(WORK_THINKING, 0));
        assert(work_shown(WORK_TOOL, 89));
        assert(!work_shown(WORK_TOOL, 90));
        assert(!work_shown(WORK_DONE, 0));
        assert(!work_shown(WORK_NONE, 0));
    }

    test "the bee's log reaches the sheet through render, without the token or its secrets" {
        assert(!BEE_TOKEN_TO_BROWSER);
        assert(!BEE_STORED);
        assert(BEE_ONE_ATTEMPT);
        assert(BEE_ROWS_MAX <= BEE_PAGE_MAX);
        assert(BEE_CACHE_S < BEE_POLL_S);
        assert(BEE_POLL_S < BEE_IDLE_POLL_S);
        assert(BEE_IDLE_POLL_S < WORK_IDLE_S);
        assert(bee_poll_s(true) == BEE_POLL_S);
        assert(bee_poll_s(false) == BEE_IDLE_POLL_S);
        assert(bee_prose_sent(true));
        assert(!bee_prose_sent(false));
        assert(BEE_SECRET_RUN >= 20);
        assert(BEE_LINE_MAX < BEE_THOUGHT_MAX);
        assert(BEE_ROW_TOOL != BEE_ROW_RESULT);
        assert(BEE_ROW_THOUGHT < BEE_ROW_ERROR);
        assert(BEE_FACE_FIRST_RUNNING);
        assert(BEE_FACE_DETENT_RANK == DETENT_FULL_RANK);
        assert(BEE_FACE_DETENT_RANK > OPEN_DETENT_RANK);
        assert(SEND_SHOWS_CHAT);
    }

    test "drift lives in one issue, updated, and closed by agreement" {
        assert(DRIFT_ONE_ISSUE);
        assert(drift_action(true, false) == DRIFT_OPEN);
        assert(drift_action(true, true) == DRIFT_COMMENT);
        assert(drift_action(false, true) == DRIFT_CLOSE);
        assert(drift_action(false, false) == DRIFT_NONE);
    }

    test "the card chat is designed, not yet live" {
        assert(!RUN_LIVE);
        assert(VERSION == 7);
        assert(HISTORY_LIMIT == 100);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
