// SPDX-License-Identifier: Apache-2.0
// specs/automation/mail-push.t27 -- the owner's mailbox PUSHED: a cron watches the Inbox
// and every new letter reaches the owner in Telegram as a card that already carries a
// drafted reply, sent only by their tap.
// Host: 999-multibots-telegraf apps/vibee-editor/render/src/agent/mail-push.ts (the tool
//       mail_push_sweep: cursor, fresh-pick, card, draft) beside src/agent/mail-tools.ts
//       (whose card and transmit halves this reuses -- nothing here sends by itself),
//       registered in src/agent/tools.ts.
// Consumer: the bot src/inngest_app/functions/mail/mailPushSweep.ts (Inngest cron, calls
//       the tool as the owner over the server key, the same door crmProactive.ts uses),
//       registered in src/inngest_app/registerFunctions.ts.
// Law lineage: agent-mail-mcp spec/agent_mail.t27 -- the local bridge this vertical ports.
//       Its measured laws carry over: the first sweep announces nothing (a watcher whose
//       debut is 200 notifications is muted within the minute, and a muted watcher is
//       worse than none), the draft rides with the letter (BRIDGE_DRAFT_WITH_PUSH), a
//       body is data a stranger sent, and the seen set is bounded because state that
//       grows forever becomes the slowest part of the sweep.
// Difference from the bridge: one push target, not a fan-out. The local bridge serves
//       several chats and tracks delivery per chat; the cloud pushes the owner's card
//       alone, so the cursor is one row, and there is no observer to protect.
// v2, 2026-09-29 (#5174): the push and jcrm become one system. jcrm (job-search
//       crm/jcrm.py) already derives the whole campaign from this same mailbox; v2 closes
//       the other direction -- the card carries the matter's CRM context from a digest
//       jcrm exports, the draft is composed with the matter's recent history, every tap
//       outcome is written back for jcrm to read, the Sent folder is watched so a manual
//       reply becomes evidence and is paired with the draft that was offered, and a daily
//       heartbeat alarms when the sweep goes quiet. Identity everywhere is the
//       enumeration message_id, because the search index is twelve days stale (measured
//       in the correspondence-crm skill, 2026-08-28) and an id out of search is a lie.
// v2.1, 2026-09-29: the digest travels through the render's own door (tool
//       mail_push_digest), not the PostgREST gateway. Measured live: SUPABASE_URL's
//       PostgREST serves a different database than the one the render's ledger lives
//       in (mail_push_state is 42P01 through the gateway while the sweep writes it),
//       so a PostgREST table would be a second home for the truth -- the one home is
//       the ledger db, and the only door that reaches it is the render's own MCP door.
// v2.2, 2026-09-30: the door opens both ways. v2.1 made the ledger write-only from
//       outside -- jcrm could export the digest but never read back what the owner's
//       taps recorded (outcomes, feedback pairs), so the dashboard still said "we
//       owe" right after a reply was sent. LEDGER_TOOL (mail_push_ledger) is a
//       SELECT-only, owner-gated read of the same three tables through the same
//       door, and the pulse now also reports digest age (a digest nobody refreshed
//       within DIGEST_STALE_H is cards going out blind, and the heartbeat must
//       say so, not just the laptop that may be asleep).
// Claim status: v1 is LIVE -- the cron fired on schedule from 2026-09-29 10:30
//       (measured: Inngest runs 10:30/10:35/10:40/10:45/10:50, the debut baselined the
//       Inbox, no letter has been carded yet -- none arrived). RUN_LIVE flips when the
//       cron cards its first real letter.
// phi^2 + 1/phi^2 = 3 | TRINITY

module automation::mail_push {

    pub const KIND : str = "automation";
    pub const ID : str = "mail-push";
    pub const REPO : str = "999-multibots-telegraf";
    pub const VERSION : u8 = 2;

    // ---- The door -------------------------------------------------------------------
    pub const TOOL : str = "mail_push_sweep";  // in the render's registry, owner-gated
    pub const CALLER : str = "inngest-cron";  // the bot, as the owner, over the server key
    pub const DOOR : str = "/mcp";  // tools/call, X-Api-Key -- the CRM sweep's own door
    pub const CRON : str = "*/5 * * * *";  // mail lands in the chat within one interval
    pub const CONCURRENCY : u8 = 1;  // two sweeps would race the one cursor row
    pub const RETRIES : u8 = 0;  // a retry after a partial push pushes twice; the next tick is 5 min away

    // ---- The cursor -----------------------------------------------------------------
    pub const STATE_TABLE : str = "mail_push_state";  // one row: the mailbox owner's seen set
    pub const SEEN_CAP : u16 = 500;  // bounded: it only needs to cover what one view returns
    pub const VIEW_LIMIT : u8 = 25;  // one poll reads the newest window, like the bridge

    // ---- The push -------------------------------------------------------------------
    pub const FIRST_SWEEP_ANNOUNCES_NOTHING : bool = true;  // baseline where the Inbox is
    pub const OLDEST_FIRST : bool = true;  // a burst arrives in the chat in mailbox order
    pub const PUSH_PER_TICK : u8 = 5;  // a burst of 25 drafts at 60 s each would outlive
                                       // the wire; the rest carries to the next tick
    pub const PREVIEW_CHARS : u16 = 400;  // the bridge's measured preview length
    pub const SEEN_ON_PUSH : bool = true;  // seen when the CARD is out, not when tapped:
                                           // an untapped card is the owner's decision, not a retry

    // ---- The draft ------------------------------------------------------------------
    pub const DRAFT_WITH_PUSH : bool = true;  // ported: agent-mail-mcp BRIDGE_DRAFT_WITH_PUSH
    pub const DRAFT_NO_TOOLS : bool = true;  // a composer, not an actor; the letter is data
    pub const DRAFT_TIMEOUT_S : u8 = 60;  // the letter waits for nobody's slow model
    pub const DRAFT_MAX_TOKENS : u16 = 700;  // a reply is proposed, not an essay
    pub const DRAFT_FAILURE_PUSHES_ANYWAY : bool = true;  // the letter is the news; the draft is convenience

    // ---- The one outward act --------------------------------------------------------
    pub const SEND_TOOL : str = "mail_send";  // the only thing that can leave (agent-mail-mcp OUTWARD_TOOLS)
    pub const SEND_NEEDS_TAP : bool = true;  // the card IS the gate; the sweep itself never transmits

    // ---- v2: the CRM convergence (#5174) ---------------------------------------------
    pub const SENT_WATCH : bool = true;  // the Sent folder is watched too: a reply typed by
                                         // hand in the webmail is evidence the CRM must see
    pub const SENT_LIMIT : u8 = 25;  // the same window discipline as the Inbox
    pub const OUTCOMES_TABLE : str = "mail_push_outcomes";  // every settle written back for jcrm
    pub const FEEDBACK_TABLE : str = "mail_push_feedback";  // the draft offered vs the reply
                                                            // the owner actually sent
    pub const DIGEST_TABLE : str = "crm_matter_digest";  // jcrm's export; the card reads it
    pub const DIGEST_DOOR : str = "mail_push_digest";  // the tool the export calls; the
                                                       // digest lands in the ledger db the
                                                       // card reads, exported_at is stamped
                                                       // by the receiver's clock (v2.1)
    pub const DIGEST_STALE_H : u8 = 26;  // a day and a bit: older context is not shown
    pub const LEDGER_TOOL : str = "mail_push_ledger";  // SELECT-only read of the
                                                       // ledger through the same door:
                                                       // digest, outcomes, feedback --
                                                       // the circle closes
                                         // (channels.json law: a stale number is never
                                         // presented as current)
    pub const HISTORY_MESSAGES : u8 = 6;  // recent both-direction lines feeding the draft
    pub const HISTORY_CHARS : u16 = 200;  // per line: subject and summary, never the body
    pub const FEEDBACK_PAIR_H : u8 = 48;  // a manual reply pairs with an offered draft of
                                          // the same matter within two days
    pub const IDENTITY : str = "enumeration message_id";  // search ids are 12 days stale
    pub const PULSE_TOOL : str = "mail_push_pulse";  // reads the cursor's heartbeat
    pub const PULSE_CRON : str = "17 9 * * *";  // daily, off the :00 mark
    pub const PULSE_STALE_MIN : u16 = 30;  // six missed 5-min ticks means the sweep is down

    // ---- Not claimed ----------------------------------------------------------------
    pub const RUN_LIVE : bool = false;  // the cron IS live (first run 2026-09-29 10:30,
                                        // measured); RUN_LIVE flips only when it cards
                                        // its first real letter

    // A letter is announced when the cursor was baselined before (not the first sweep)
    // and the letter's id is not in the seen set. The first sweep baselines and says nothing.
    fn announces(baselined: bool, already_seen: bool) -> bool {
        return baselined && !already_seen;
    }

    // The reply leaves only on the owner's Allow. Any other answer -- Deny, expiry,
    // somebody else's tap -- is a refusal, and the letter is still delivered news.
    fn may_transmit(tap: str) -> bool {
        return tap == "allowed";
    }

    // The seen set never outgrows the cap: newest kept, oldest dropped, because a
    // later view cannot return what has scrolled past the window anyway.
    fn capped(seen: u16) -> usize {
        if seen > SEEN_CAP {
            return SEEN_CAP;
        }
        return seen;
    }

    // A digest older than DIGEST_STALE_H is refused, not shown: context that lies is
    // worse than no context, and the CRM's own counters carry the same law.
    fn digest_fresh(age_h: u8) -> bool {
        return age_h <= DIGEST_STALE_H;
    }

    // A Sent item is news only when the sweep did not send it itself and has not
    // already recorded it: the send's own answer names our message by its id.
    fn sent_is_news(id_known_ours: bool, already_recorded: bool) -> bool {
        return !id_known_ours && !already_recorded;
    }

    // A manual reply is paired with the draft that was offered when the matter is the
    // same and the card has not gone cold: the pair is how drafts get measured.
    fn pairs(thread_same: bool, card_age_h: u8) -> bool {
        return thread_same && card_age_h <= FEEDBACK_PAIR_H;
    }

    // The heartbeat is fresh while the cursor moved within six missed ticks.
    fn pulse_fresh(age_min: u16) -> bool {
        return age_min <= PULSE_STALE_MIN;
    }

    test "the first sweep announces nothing, and only unseen mail after" {
        assert(!announces(false, false));
        assert(!announces(false, true));
        assert(announces(true, false));
        assert(!announces(true, true));
        assert(FIRST_SWEEP_ANNOUNCES_NOTHING);
    }

    test "the push carries a drafted reply, and a failed draft delays nothing" {
        assert(DRAFT_WITH_PUSH);
        assert(DRAFT_NO_TOOLS);
        assert(DRAFT_FAILURE_PUSHES_ANYWAY);
        assert(DRAFT_TIMEOUT_S <= 60);
        assert(PREVIEW_CHARS == 400);
        assert(OLDEST_FIRST);
        assert(SEEN_ON_PUSH);
    }

    test "nothing transmits without the owner's tap" {
        assert(may_transmit("allowed"));
        assert(!may_transmit("denied"));
        assert(!may_transmit("expired"));
        assert(!may_transmit("pending"));
        assert(SEND_NEEDS_TAP);
        assert(SEND_TOOL == "mail_send");
    }

    test "one writer, one target, bounded state" {
        assert(CONCURRENCY == 1);
        assert(RETRIES == 0);
        assert(capped(3) == 3);
        assert(capped(SEEN_CAP) == SEEN_CAP);
        assert(capped(SEEN_CAP + 100) == SEEN_CAP);
        assert(VIEW_LIMIT <= SEEN_CAP);
        assert(PUSH_PER_TICK >= 1);
        assert(PUSH_PER_TICK <= VIEW_LIMIT);
        assert(CRON == "*/5 * * * *");
    }

    test "the desk is live, the push is not yet" {
        assert(!RUN_LIVE);
        assert(TOOL == "mail_push_sweep");
        assert(DOOR == "/mcp");
        assert(CALLER == "inngest-cron");
    }

    test "a stale digest is refused, not shown" {
        assert(digest_fresh(0));
        assert(digest_fresh(26));
        assert(!digest_fresh(27));
        assert(DIGEST_STALE_H == 26);
        assert(HISTORY_MESSAGES >= 1);
        assert(HISTORY_CHARS <= 200);
        assert(DIGEST_TABLE == "crm_matter_digest");
    }

    test "the digest lands through the render's own door, not a second database" {
        assert(DIGEST_DOOR == "mail_push_digest");
        assert(DIGEST_DOOR != TOOL);  // the export door is not the sweep door
        assert(DIGEST_TABLE == "crm_matter_digest");  // one table, one home
    }

    test "the Sent folder separates our tap-sends from the owner's manual replies" {
        assert(SENT_WATCH);
        assert(!sent_is_news(true, false));
        assert(!sent_is_news(false, true));
        assert(sent_is_news(false, false));
        assert(SENT_LIMIT <= SEEN_CAP);
        assert(IDENTITY == "enumeration message_id");
    }

    test "every outcome is written back: allowed sends, denials and expiries" {
        assert(OUTCOMES_TABLE == "mail_push_outcomes");
        assert(may_transmit("allowed"));
        assert(!may_transmit("denied"));
    }

    test "a manual reply is paired with the draft that was offered" {
        assert(pairs(true, 0));
        assert(pairs(true, 48));
        assert(!pairs(true, 49));
        assert(!pairs(false, 0));
        assert(FEEDBACK_TABLE == "mail_push_feedback");
    }

    test "the heartbeat alarms when the sweep goes quiet" {
        assert(pulse_fresh(0));
        assert(pulse_fresh(30));
        assert(!pulse_fresh(31));
        assert(PULSE_TOOL == "mail_push_pulse");
        assert(PULSE_CRON == "17 9 * * *");
    }

    test "the ledger reads back through the same door, select only" {
        assert(LEDGER_TOOL == "mail_push_ledger");
        assert(LEDGER_TOOL != TOOL);  // reading is not sweeping
        assert(LEDGER_TOOL != DIGEST_DOOR);  // reading is not exporting
        assert(DIGEST_TABLE == "crm_matter_digest");
        assert(OUTCOMES_TABLE == "mail_push_outcomes");
        assert(FEEDBACK_TABLE == "mail_push_feedback");
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
