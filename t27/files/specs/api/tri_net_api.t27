// SPDX-License-Identifier: Apache-2.0
; specs/api/tri_net_api.t27 -- TRI-NET API contract 0: the external integration surface
; The file-based, read-only surface that downstream tools (chip-repo CI, third-party
; auditors, formal-methods reviewers) consume to read TRI-NET artefacts produced by t27 and
; its sibling chip repos. There is no hosted network endpoint in scope. ASCII only (L3).

; Until this rewrite the file was a Markdown document with a .t27 name, which the parser
; refused at its first line; its tests and invariants had comment-only bodies. The contract
; is unchanged. Human-readable mirror: docs/TRI_NET_API.md. Schema:
; schemas/tri-net-api-v1.json. Numeric SSOT: conformance/FORMAT-SPEC-001.json and
; schemas/numeric-format-v1.json.

; The API has no math content of its own; it shapes how artefacts that do carry math
; content are produced and consumed.
; phi^2 + 1/phi^2 = 3 | TRINITY

module tri_net_api;

; schema_version is semver: MAJOR breaks and the consumer must opt in, MINOR adds and the
; consumer should ignore unknown fields, PATCH is editorial.
pub const SCHEMA_MAJOR : u32 = 1;
pub const SCHEMA_MINOR : u32 = 0;
pub const SCHEMA : str = "schemas/tri-net-api-v1.json";
pub const HOSTED_ENDPOINT : bool = false;
pub const EXTENSION_KEY : str = "x_extension";

; Artefact families, "name: path -- schema or format".
pub const FAMILIES : [6]str = ["format registry: conformance/FORMAT-SPEC-001.json -- schemas/numeric-format-v1.json; hosted in t27 only, chip repos consume and do not republish (L6 CEILING)", "NMSE protocol results: bench/results/nmse-<runner>-<seed>-<iso8601>.json -- schemas/nmse-protocol-v1.json", "toolchain seal: bootstrap/stage0/FROZEN_HASH -- see SEAL_FORMAT (L2 GENERATION)", "readiness ladder, optional: bench/readiness.json -- schemas/tri-net-api-v1.json#/$defs/Readiness; STATUS.md stays the human-readable SSOT", "conformance vectors: conformance/*.json -- gf*_vectors, ar_*, nn_*, sacred_physics*, FORMAT-SPEC-001", "cross-repo identity, optional: tri-net-identity.json at a repo's top level -- schemas/tri-net-api-v1.json#/$defs/RepoIdentity"];

; The document said FROZEN_HASH holds a single SHA-256 hex digest. bootstrap/build.rs
; reads the first non-comment line as `<64-hex-sha256> <repo-relative-path>` and compares
; only the first field, so a consumer must split on whitespace before comparing.
pub const SEAL_FORMAT : str = "<64-hex-sha256> <repo-relative-path>";
pub const SEAL_DIGEST_HEX_CHARS : u32 = 64;

pub const READINESS_LEVELS : [6]str = ["SPEC", "RTL", "SIM", "SYNTH", "GDS_TAPEOUT", "SILICON"];

pub const CONSUMER_MUST : [3]str = ["pin a schema MAJOR", "validate every artefact before treating fields as authoritative", "fail closed on schema violation"];
pub const CONSUMER_SHOULD : [2]str = ["verify seal_hash against bootstrap/stage0/FROZEN_HASH", "log schema_version in any output"];
pub const PRODUCER_MUST : [4]str = ["emit only artefacts that validate against the active schema", "include schema_version at the artefact root", "place extensions under the reserved x_extension object", "cite seal_hash when numeric results are reported"];
pub const PRODUCER_SHOULD : [1]str = ["publish tri-net-identity.json at the repo root"];

; The round-trip benchmark: for each family produce a minimal golden artefact under
; bench/api_goldens/, validate it, mutate one required field and confirm validation fails;
; success is 100% of goldens validating and 100% of mutants failing. Neither
; bench/api_goldens/ nor bench/results/ exists in this repository today, so the benchmark
; has not been run and no result is claimed for it.
pub const ROUNDTRIP_GOLDENS_PRESENT : bool = false;

pub const IS_NOT : [4]str = ["a hosted HTTP service", "an SDK (see specs/api/sdk_contract.t27)", "a control plane for any chip", "a place where silicon-bring-up endpoints live"];

; R5-HONEST: file-based today, no network endpoint implied; schemas describe shape only and
; promise no silicon behaviour; no throughput, latency or energy field is canonical.
pub const CANONICAL_PERF_FIELDS : u32 = 0;

; Producers may not add top-level keys; anything unknown goes under x_extension.
fn top_level_key_allowed(is_documented : bool, is_extension : bool) -> bool {
    return is_documented or is_extension;
}

; A consumer accepts an artefact only on a pinned MAJOR; MINOR may be newer.
fn consumer_accepts(pinned_major : u32, artefact_major : u32) -> bool {
    return pinned_major == artefact_major;
}

test "no_hosted_endpoint_claim" {
    assert(HOSTED_ENDPOINT == false);
    assert(CANONICAL_PERF_FIELDS == 0);
}

test "major_is_pinned_minor_is_not" {
    assert(consumer_accepts(SCHEMA_MAJOR, 1));
    assert(consumer_accepts(SCHEMA_MAJOR, 2) == false);
    assert(consumer_accepts(SCHEMA_MAJOR, 0) == false);
}

test "fail_closed_on_undocumented_top_level_field" {
    assert(top_level_key_allowed(true, false));
    assert(top_level_key_allowed(false, true));
    assert(top_level_key_allowed(false, false) == false);
}

test "seal_digest_is_sha256_hex" {
    // 256 bits at 4 bits per hex character
    assert(256 / 4 == SEAL_DIGEST_HEX_CHARS);
}

test "roundtrip_is_not_claimed" {
    assert(ROUNDTRIP_GOLDENS_PRESENT == false);
}
