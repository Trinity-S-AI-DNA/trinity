// SPDX-License-Identifier: Apache-2.0
; specs/api/tri_api_context.t27 -- the context budget of gHashTag/trinity's tri-api at the pin
; S07 of gHashTag/trinity#988 (gHashTag/t27#3569). Before every request the loop estimates the size of
; its history and, near a threshold, first truncates old tool outputs and then asks the provider for a
; summary that replaces the history. This file states the estimate, the threshold, what truncation
; keeps, and what the summary step loses. src/tri-api/context.zig at the pin; the loop that calls it
; is main.zig:296-322. Evidence: the file's own nine tests and 19 generated vectors compiled and run in
; Debug, ReleaseSafe, ReleaseFast and ReleaseSmall, and the real binary driven by a scripted provider with a
; 600 KB prompt (tools/trinity_tri_api.py, scenario e20). Not measured: a real summary from a real model.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriApiContext;

pub const KIND : str = "agent-context";
pub const ID : str = "api/tri_api_context";
pub const NAME : str = "The context budget of the pinned tri-api";
pub const CONSUMER_REPO : str = "gHashTag/trinity";
pub const PINNED_REVISION : str = "afc9d38435ad01c48af6c33c311da422c38f046e";
pub const ISSUE_BASELINE : str = "03ae2f93f5af2fd4fa23e4c613a3c0e19ac51530";
pub const SOURCE_LINES : str = "context.zig: config :10-13, estimateTokens :18, trackApiUsage :40, isNearLimit :46, truncateOldToolOutputs :63, buildCompactionRequest :171, applySummary :193; main.zig: call site :296-322";
pub const MAX_TOKENS : u32 = 180000;
pub const COMPACT_THRESHOLD : u32 = 144000;
pub const KEEP_TURNS : u32 = 3;
pub const BYTES_PER_TOKEN : u32 = 4;
pub const EXCERPT_MAX_BYTES : u32 = 400000;
pub const ESTIMATE_RULE : str = "tokens are estimated as the byte length of the history divided by four, never less than one; the usage numbers the provider reports are tracked but never consulted (and are always 0, see tri_api_loop f01)";
pub const NEAR_LIMIT_RULE : str = "the history is near the limit when the estimate reaches 144000 tokens, that is 576000 bytes";
pub const TRUNCATE_RULE : str = "first step: tool_result contents older than the last three assistant turns are cut to a short head; the step reports whether it changed anything";
pub const SUMMARY_RULE : str = "second step, when still near the limit: one request with the first 400000 bytes of the history and a fixed instruction, no tools, sent to the same endpoint; the text blocks of the reply are applied one after another as summaries";
pub const SUMMARY_REPLACES : str = "a summary replaces the history: the last three assistant turns are kept and everything before them, the user's original prompt included, is replaced by one message that begins [Previous context summary]; with no assistant turn at all the whole history becomes that one message";
pub const SUMMARY_FAILURE : str = "a failed summary request is swallowed: no line is printed and the next request goes out over the limit";
pub const SUMMARY_ACCOUNTING : str = "the summary request is not counted: no tools, no usage, no turn";
pub const PROMPT_LOSS : str = "a first prompt of 600000 bytes is itself past the threshold: the request that follows the compaction holds only the summary, and the prompt is gone from the conversation";
pub const FINDINGS_COUNT : u32 = 2;
pub const FINDINGS : [2]str = [
    "f19 compaction replaces the user's original prompt with the summary: a 600 KB prompt is absent from the request after it [e20, vectors sm-no-turns sm-five-turns cr-big]",
    "f29 the summary request has no tools, no usage accounting and a silent failure path [e20, vector cr-big; the failure path is read from main.zig:307 and not run]"
];
pub const ENABLED : bool = true;

; --- Rules -------------------------------------------------------------------------------------------------

pub fn estimate_tokens(bytes: u32) -> u32 {
    let t = bytes / BYTES_PER_TOKEN;
    if (t < 1) { return 1; }
    return t;
}

pub fn near_limit(bytes: u32) -> bool {
    return estimate_tokens(bytes) >= COMPACT_THRESHOLD;
}

pub fn summary_keeps_first_prompt() -> bool {
    return false;
}

pub fn summary_request_has_tools() -> bool {
    return false;
}

pub fn summary_request_counted() -> bool {
    return false;
}

pub fn excerpt_bytes(history_bytes: u32) -> u32 {
    if (history_bytes > EXCERPT_MAX_BYTES) { return EXCERPT_MAX_BYTES; }
    return history_bytes;
}

invariant the_threshold_is_four_fifths_of_the_window { COMPACT_THRESHOLD * 5 == MAX_TOKENS * 4 }
invariant the_estimate_is_a_quarter { BYTES_PER_TOKEN == 4 }

test the_estimate_is_a_quarter_of_the_bytes_and_at_least_one {
    assert estimate_tokens(8) == 2;
    assert estimate_tokens(2) == 1;
    assert estimate_tokens(0) == 1;
    assert estimate_tokens(576000) == 144000;
}

test the_threshold_is_reached_at_576000_bytes {
    assert near_limit(575999) == false;
    assert near_limit(576000) == true;
    assert near_limit(600000) == true;
}

test the_summary_step_loses_the_prompt_and_is_not_counted {
    assert summary_keeps_first_prompt() == false;
    assert summary_request_has_tools() == false;
    assert summary_request_counted() == false;
}

test the_excerpt_is_cut_at_the_limit {
    assert excerpt_bytes(1000) == 1000;
    assert excerpt_bytes(600000) == 400000;
}
