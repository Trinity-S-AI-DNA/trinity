// SPDX-License-Identifier: Apache-2.0
; specs/api/tri_api_permissions.t27 -- the permission boundary of gHashTag/trinity's tri-api at the pin
; S07 of gHashTag/trinity#988 (gHashTag/t27#3569). Between a model's tool_use block and a side effect
; stand four things: a permission table (allow and deny rules from settings.json), a path predicate,
; a bash allowlist and, for write_file, a git checkpoint. This file states what each of them decides
; at src/tri-api/{permissions,tool_executor,checkpoint,mcp_client}.zig, including where they fail open.
; The decisions are functions the C backend executes. Evidence, kept apart (tools/trinity_tri_api.py):
;   model   a Python reading of the source, compared with the compiled Zig on 148 vectors
;   zig     the pinned files compiled and run in Debug, ReleaseSafe, ReleaseFast and ReleaseSmall: the
;           settings loader is run in all four, because its answer depends on the optimize mode
;   binary  the real tri-api driven by a scripted provider and a scripted MCP server
; Not measured: a real MCP server, a model deciding to attack. A denied tool cannot reach the executor in
; the builds where the rules are intact; in the builds where they are not, see FINDINGS f11.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriApiPermissions;

pub const KIND : str = "agent-permissions";
pub const ID : str = "api/tri_api_permissions";
pub const NAME : str = "The permission boundary of the pinned tri-api";
pub const CONSUMER_REPO : str = "gHashTag/trinity";
pub const PINNED_REVISION : str = "afc9d38435ad01c48af6c33c311da422c38f046e";
pub const ISSUE_BASELINE : str = "03ae2f93f5af2fd4fa23e4c613a3c0e19ac51530";
pub const SOURCE_LINES : str = "permissions.zig: rules :9, check :25, loadConfig :66, loadFromFile :89, parseRuleArray :100; tool_executor.zig: executeDynamic :146, execute :165, isPathSafe :220, readFile :228, isBashAllowed :284, runBash :305, runGrep :338; checkpoint.zig: createBeforeWrite :19; mcp_client.zig: connectServer :52, discoverTools :147, writeToolDefinitions :124; main.zig: loadMcpServers :431";
; --- The table ----------------------------------------------------------------------------------------
pub const DECISION_ALLOW : u32 = 0;
pub const DECISION_DENY : u32 = 1;
pub const PRECEDENCE : str = "a matching deny rule wins; else a matching allow rule; else the default: read_file and grep are allowed, every other tool, bash and write_file and every MCP tool included, is denied";
pub const DEFAULT_ALLOWED_TOOLS : [2]str = ["read_file", "grep"];
pub const RULE_SHAPE : str = "tool(pattern): the pattern is * (anything), an exact argument, a prefix ending in *, or a pattern with one inner * matched on both ends; a rule without a closing bracket or with an empty tool is dropped";
pub const MAX_RULES : u32 = 64;
pub const RULE_CAP_RULE : str = "at most 64 allow and 64 deny rules are kept; a 65th rule is dropped without a word, so a long deny list loses its tail";
pub const SETTINGS_PATHS : str = "the table reads $HOME/.trinity/api/settings.json and then ./.trinity/api/settings.json; both lists are added together, so a project file cannot lift a user deny, and a user file cannot lift a project deny; the comments of the source name .tri-api, which the table does not read";
pub const SETTINGS_SHAPE : str = "rules are found by searching the text for the exact needle \"allow\":[ and \"deny\":[ with no whitespace; a pretty-printed file loads no rules, and a file whose allow array is compact and whose deny array is not loads the allow rules and drops the deny rules";
pub const UAF_RULE : str = "the loader frees the settings text and keeps slices into it: every rule tool and pattern dangles; in Debug and ReleaseSafe the freed bytes read 0xAA, so an allow rule never allows and a deny rule never denies; in ReleaseFast and ReleaseSmall the bytes survive by accident and the table works; a larger file or a busier heap can break that too";
pub const SAFE_MODES : [2]str = ["Debug", "ReleaseSafe"];
pub const FAST_MODES : [2]str = ["ReleaseFast", "ReleaseSmall"];
; --- Paths ----------------------------------------------------------------------------------------------
pub const PATH_RULE : str = "a path is refused when it contains the two bytes .. anywhere or a NUL; that is the whole boundary: an absolute path, a home path and a symlink are read as they are, and a name such as a..b.txt is refused";
pub const READ_LIMIT_BYTES : u32 = 524288;
pub const ESCAPE_RULE : str = "the path and the command are cut out of the tool input without unescaping: a name holding an escaped quote is looked up with the backslash in it";
; --- Bash ---------------------------------------------------------------------------------------------------
pub const BASH_PREFIX_COUNT : u32 = 32;
pub const BASH_BARE : [4]str = ["pwd", "date", "env", "ls"];
pub const BASH_META : str = "|;`$(){}";
pub const BASH_PAIRS : [2]str = ["&&", "||"];
pub const BASH_RULE : str = "a command is allowed when it starts with one of 32 prefixes (git, zig, cat, ls, grep, find, echo, mkdir, rm, tri, docker, gh, head, tail, wc, pwd, date, env, which, file, diff, sort, test, cd, cp, mv, chmod, touch, sed, awk; most need a space after them, pwd date env do not) or is exactly pwd, date, env or ls, and holds none of | ; ` $ ( ) { } and neither && nor ||";
pub const BASH_NOT_BLOCKED : str = "a single &, the redirects > and <, find -delete, find -exec, sed -i, awk system(), env <command>, rm, cp, mv, chmod, zig build, and the prefixes pwd date env without a boundary (pwdx, datex, envsubst); the list bounds the first word, not what the command does";
pub const BASH_EXECUTION : str = "sh -c <command> in the working directory, output cut at 512 KiB, no timeout; a non-zero exit is an error result that holds the exit code, stderr and stdout";
pub const GREP_RULE : str = "grep runs as timeout 5 grep -rnF (fixed string unless a regex field is present); a host without a timeout binary, macOS among them, answers spawn failed FileNotFound";
; --- Checkpoint -------------------------------------------------------------------------------------------------
pub const CHECKPOINT_RULE : str = "before a permitted write_file the tool runs git stash push -m checkpoint -- <path> when the file exists and the directory is a git work tree; the stash removes the file's uncommitted edits from the work tree before the new content is written";
pub const CHECKPOINT_ORDER : str = "the checkpoint runs BEFORE the path predicate, which sits inside the write: a refused write of ../top.txt still stashed the local edits of top.txt";
pub const CHECKPOINT_INTERFACE : str = "createBeforeWrite(path) returns nothing and cannot fail a write; restoreFile and restoreLatest exist and are called by nothing in the loop";
; --- MCP ------------------------------------------------------------------------------------------------------------
pub const MCP_ROUTING : str = "a tool name that is not built in and holds a dot is looked up among the MCP tools; a rule is checked with the argument \"\", so only a pattern of * or of nothing can match; a rule such as server.tool(hello*) never matches";
pub const MCP_DISCOVERY : str = "the client never reads the reply to initialize, so the first line it reads for tools/list is that reply: a compliant server registers 0 tools; a server that does not answer initialize registers tools (two registrations for one listed tool were measured, and are not modelled)";
pub const MCP_CONFIG_PATH : str = "mcp_servers are read from ./.trinity/api/settings.json, and only when that file is missing from $HOME/.tri-api/settings.json; the permission table reads $HOME/.trinity/api/settings.json: the two loaders share no file";
pub const MCP_UAF_RULE : str = "the tool description and input schema kept in the tool list are slices into the freed tools/list reply: the next request writes them out from freed memory (Debug aborts inside writeToolDefinitions, ReleaseFast dies on SIGSEGV before the first request)";
pub const MCP_TIMEOUT : str = "none: a server that never answers holds the loop for ever";
; --- Findings: measured, the tag names the evidence ------------------------------------------------------------------
pub const FINDINGS_COUNT : u32 = 12;
pub const FINDINGS : [12]str = [
    "f11 the rules parsed from settings.json dangle into a freed buffer: in Debug and ReleaseSafe deny read_file(.env) still reads .env [e09, zig uaf-loadfromfile x4]",
    "f12 pretty-printed settings load 0 rules, and a mixed file silently drops the deny rules [e09, vectors pra-pretty pra-space-before-bracket]",
    "f13 project settings do not override user settings: the two lists are added, deny still wins [e10]",
    "f14 a rule past the 64th is dropped silently [e11, vector pra-cap]",
    "f15 the bash allowlist passes a single &, > and < redirects, env <command>, find -delete, sed -i and the prefix quirks [e12, vectors ba-amp ba-redirect ba-env-cmd ba-find-delete ba-sed-i ba-pwdx ba-datex]",
    "f16 the path boundary is the substring .. and NUL: an absolute path is read, a..b.txt is refused [e04, vectors ps-absolute ps-dots-in-name]",
    "f17 the git checkpoint runs before the path predicate: a refused write stashed the file's local edits [e13]",
    "f18 the MCP client never reads the initialize reply, so a compliant server yields 0 tools, and an MCP rule can only match with * [e17, vectors rm-mcp-arg rm-mcp-star]",
    "f24 MCP tool descriptions and schemas dangle into the freed tools/list reply and kill the process [e17]",
    "f25 with 70 rules the first checked tool call died on SIGSEGV in ReleaseFast, twice in two runs (recorded, not asserted) [e11]",
    "f27 the MCP config and the permission table read different settings files [e23]",
    "f28 grep needs a timeout binary: on this macOS host it answers spawn failed [e24]"
];
pub const ENABLED : bool = true;

; --- Rules ------------------------------------------------------------------------------------------------------------------

pub fn permission(has_deny_rule: bool, has_allow_rule: bool, default_allowed: bool) -> u32 {
    if (has_deny_rule) { return DECISION_DENY; }
    if (has_allow_rule) { return DECISION_ALLOW; }
    if (default_allowed) { return DECISION_ALLOW; }
    return DECISION_DENY;
}

pub fn rules_admitted(written: u32) -> u32 {
    if (written > MAX_RULES) { return MAX_RULES; }
    return written;
}

pub fn path_safe(has_dotdot: bool, has_nul: bool) -> bool {
    if (has_dotdot) { return false; }
    if (has_nul) { return false; }
    return true;
}

pub fn bash_allowed(listed: bool, has_meta: bool, has_pair: bool) -> bool {
    if (has_meta) { return false; }
    if (has_pair) { return false; }
    return listed;
}

pub fn rules_effective(safe_build: bool) -> bool {
    return safe_build == false;
}

pub fn checkpoint_runs_before_path_check() -> bool {
    return true;
}

pub fn mcp_rule_can_match(pattern_is_star_or_empty: bool) -> bool {
    return pattern_is_star_or_empty;
}

pub fn mcp_lists_tools(server_answers_initialize: bool) -> bool {
    return server_answers_initialize == false;
}

invariant a_deny_rule_beats_everything { permission(true, true, true) == DECISION_DENY }
invariant the_rule_cap_is_sixty_four { MAX_RULES == 64 }
invariant two_defaults_are_allowed { DEFAULT_ALLOWED_TOOLS[0] == "read_file" and DEFAULT_ALLOWED_TOOLS[1] == "grep" }
invariant the_bash_list_has_four_bare_commands { BASH_BARE[0] == "pwd" and BASH_BARE[3] == "ls" }

test deny_beats_allow_beats_default {
    assert permission(true, true, true) == DECISION_DENY;
    assert permission(true, false, true) == DECISION_DENY;
    assert permission(false, true, false) == DECISION_ALLOW;
    assert permission(false, false, true) == DECISION_ALLOW;
    assert permission(false, false, false) == DECISION_DENY;
}

test the_rule_cap_drops_the_tail {
    assert rules_admitted(3) == 3;
    assert rules_admitted(64) == 64;
    assert rules_admitted(70) == 64;
}

test the_path_boundary_is_two_dots_and_a_nul {
    assert path_safe(false, false) == true;
    assert path_safe(true, false) == false;
    assert path_safe(false, true) == false;
}

test the_bash_list_bounds_the_first_word_and_a_few_bytes {
    assert bash_allowed(true, false, false) == true;
    assert bash_allowed(true, true, false) == false;
    assert bash_allowed(true, false, true) == false;
    assert bash_allowed(false, false, false) == false;
}

test rules_survive_only_where_the_freed_bytes_do {
    assert rules_effective(true) == false;
    assert rules_effective(false) == true;
}

test the_checkpoint_runs_first_and_an_mcp_rule_needs_a_star {
    assert checkpoint_runs_before_path_check() == true;
    assert mcp_rule_can_match(true) == true;
    assert mcp_rule_can_match(false) == false;
    assert mcp_lists_tools(true) == false;
    assert mcp_lists_tools(false) == true;
}
