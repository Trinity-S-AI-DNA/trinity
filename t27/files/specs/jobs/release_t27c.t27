// SPDX-License-Identifier: Apache-2.0
; specs/jobs/release_t27c.t27 -- the t27c release, as a job the Queen runs (specs/queen/jobs.t27)
; The steps are the ones a Claude session ran by hand from a laptop for the 0.5.0 release
; (2026-10-07, about three hours on a 15-minute cron), minus what the Queen already does on her own
; (merging the pull requests the release waits for). The job starts with one parameter, the version,
; once the version bump has landed on the base branch.
;   0 CHECK  version-truth     the base branch's head is pinned as the subject; bootstrap/Cargo.toml's
;                              first `version` line and .zenodo.json's "version" both say the version
;                              (release.yml's VERSION TRUTH gate, asked before anything is published)
;   1 CHECK  tag-absent        no tag TAG_PREFIX + version exists, and the registry has no such version
;   2 EFFECT github-release    publish a GitHub release of that tag at the subject; release.yml runs
;                              on that event and publishes the crate (irreversible)
;   3 WAIT   release-workflow  the run of RELEASE_WORKFLOW for that release concluded success
;   4 WAIT   crate-published   the registry lists CRATE at the version
; Read at run time by the supervisor's vendored compiler wasm, so this card holds constants only.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module JobReleaseT27c;

pub const JOB_NAME : str = "release-t27c";
pub const REPO : str = "gHashTag/t27";
pub const BASE_BRANCH : str = "master";
pub const CRATE : str = "t27c";
pub const TAG_PREFIX : str = "t27c-v";
pub const RELEASE_WORKFLOW : str = "release.yml";
pub const CARGO_MANIFEST : str = "bootstrap/Cargo.toml";
pub const ZENODO_FILE : str = ".zenodo.json";

/// The one parameter a job of this card starts with.
pub const PARAMS : [1]str = ["version"];

/// Step kinds by number (specs/queen/jobs.t27: CHECK 0, WAIT 1, EFFECT 2), and the executor each
/// step names. A name the supervisor does not know fails the step: it never guesses.
pub const STEP_COUNT : u32 = 5;
pub const STEP_KIND : [5]u8 = [0, 0, 2, 1, 1];
pub const STEP_WHAT : [5]str = [
    "version-truth", "tag-absent", "github-release", "release-workflow", "crate-published"
];

/// The index of the one irreversible step. Every step before it is a CHECK, so effect_may_run
/// (jobs.t27) sees every check passed at the subject before anything is published.
pub const PUBLISH_STEP : u32 = 2;

test the_card_publishes_only_after_its_checks {
    assert STEP_COUNT == 5;
    assert STEP_KIND[0] == 0;
    assert STEP_KIND[1] == 0;
    assert STEP_KIND[PUBLISH_STEP] == 2;
    assert STEP_KIND[3] == 1;
    assert STEP_KIND[4] == 1;
}

invariant the_publish_step_follows_the_checks {
    assert PUBLISH_STEP == 2;
    assert PUBLISH_STEP < STEP_COUNT;
}
