// #6954 wrote these tests with `return false` in a test body, which Zig
// rejects (a test returns anyerror!void), and expected 0x11 at packed[j*8]
// for the identity matrix -- but row j's diagonal nibble sits at byte
// j*8 + j/2, low nibble for even j and high nibble for odd j. Measured on
// the t27c lab: the pack tests below pass 3/3, and a mutant that drops the
// `<< 4` fails two of them.
test "test_pack_gf16_matrix_identity" {
    var identity: [16][16]u8 = [_][16]u8{ [_]u8{0} ** 16 } ** 16;
    var i: usize = 0;
    while (i < 16) {
        identity[i][i] = 1;
        i += 1;
    }
    const packed = pack_gf16_matrix(identity);
    var k: usize = 0;
    while (k < 128) {
        const row = k / 8;
        var want: u8 = 0;
        if (k == row * 8 + row / 2) {
            if ((row & 1) == 0) {
                want = 0x01;
            } else {
                want = 0x10;
            }
        }
        assert(packed[k] == want);
        k += 1;
    }
}

test "test_pack_gf16_matrix_zero" {
    var zero: [16][16]u8 = [_][16]u8{ [_]u8{0} ** 16 } ** 16;
    const packed = pack_gf16_matrix(zero);
    var i: usize = 0;
    while (i < 128) {
        assert(packed[i] == 0);
        i += 1;
    }
}

test "test_pack_gf16_matrix_nibble_order" {
    var m: [16][16]u8 = [_][16]u8{ [_]u8{0} ** 16 } ** 16;
    m[3][4] = 0xA;
    m[3][5] = 0x5;
    m[15][15] = 0xF;
    const packed = pack_gf16_matrix(m);
    assert(packed[3 * 8 + 2] == 0x5A);
    assert(packed[127] == 0xF0);
}

// The Merkle tests below cannot run yet: `use tri::crypto::sha256::TriSha256`
// does not resolve, so the whole spec's tests are BLOCKED at compile time
// (recorded as such in the seal). They are written as asserts so that they
// compile once it resolves.
test "test_merkle_root_single_leaf" {
    // Single leaf should return itself as root
    var leaf: [32]u8 = [_]u8{1} ** 32;
    var leaves = [leaf];
    var root = merkle_root(leaves);
    var i: usize = 0;
    while (i < 32) {
        assert(root[i] == leaf[i]);
        i += 1;
    }
}

test "test_merkle_root_two_leaves" {
    // Two leaves should hash to root
    var leaf1: [32]u8 = [_]u8{1} ** 32;
    var leaf2: [32]u8 = [_]u8{2} ** 32;
    var leaves = [leaf1, leaf2];
    var root = merkle_root(leaves);
    var expected_hash = TriSha256.hash(&leaf1 ++ leaf2);
    var i: usize = 0;
    while (i < 32) {
        assert(root[i] == expected_hash[i]);
        i += 1;
    }
}

test "test_merkle_root_empty" {
    // Empty tree should return zero root
    var leaves: [][32]u8 = [];
    var root = merkle_root(leaves);
    var zero: [32]u8 = [_]u8{0} ** 32;
    var i: usize = 0;
    while (i < 32) {
        assert(root[i] == zero[i]);
        i += 1;
    }
}

test "test_verify_merkle_single_leaf" {
    // Single leaf should verify against itself
    var leaf: [32]u8 = [_]u8{1} ** 32;
    var leaves = [leaf];
    var root = merkle_root(leaves);
    var siblings: [][32]u8 = [];
    assert(verify_merkle(root, leaf, siblings, 0));
}

test "test_verify_merkle_two_leaves_left" {
    // Verify left leaf (index 0) in 2-leaf tree
    var leaf1: [32]u8 = [_]u8{1} ** 32;
    var leaf2: [32]u8 = [_]u8{2} ** 32;
    var leaves = [leaf1, leaf2];
    var root = merkle_root(leaves);
    var siblings: [][32]u8 = [leaf2]; // Right sibling
    assert(verify_merkle(root, leaf1, siblings, 0));
}

test "test_verify_merkle_two_leaves_right" {
    // Verify right leaf (index 1) in 2-leaf tree
    var leaf1: [32]u8 = [_]u8{1} ** 32;
    var leaf2: [32]u8 = [_]u8{2} ** 32;
    var leaves = [leaf1, leaf2];
    var root = merkle_root(leaves);
    var siblings: [][32]u8 = [leaf1]; // Left sibling
    assert(verify_merkle(root, leaf2, siblings, 1));
}

test "test_verify_merkle_wrong_root" {
    // Should fail with wrong root
    var leaf: [32]u8 = [_]u8{1} ** 32;
    var wrong_root: [32]u8 = [_]u8{0} ** 32;
    var siblings: [][32]u8 = [];
    assert(!verify_merkle(wrong_root, leaf, siblings, 0));
}

// ============================================================================
// TDD — Invariants
// ============================================================================

invariant phi_challenge_deterministic {
    // derive_phi_challenge(epoch, node_id) is deterministic for identical inputs
    // Rationale: SHA256 is a deterministic PRF
    @compileAssert(true);
}

invariant phi_challenge_epoch_binding {
    // derive_phi_challenge(e1, id) != derive_phi_challenge(e2, id) for e1 != e2
    // Rationale: epoch is mixed into SHA256 input, collisions are negligible
    @compileAssert(true);
}

invariant phi_challenge_node_binding {
    // derive_phi_challenge(e, id1) != derive_phi_challenge(e, id2) for id1 != id2
    // Rationale: node_id is mixed into SHA256 input, collisions are negligible
    @compileAssert(true);
}

invariant gf16_mul_field_closure {
    // gf16_mul(a, b) in [0..15] for all a, b in [0..15]
    // Rationale: GF(2^4) multiplication is closed
    @compileAssert(true);
}

invariant gf16_mul_commutative {
    // gf16_mul(a, b) == gf16_mul(b, a)
    // Rationale: Finite field multiplication is commutative
    @compileAssert(true);
}

invariant gf16_dot4_elementwise {
    // gf16_dot4(w, x)[i] == gf16_mul(w[i], x[i]) for i in [0..3]
    // Rationale: dot4 is element-wise multiplication
    @compileAssert(true);
}

invariant merkle_root_empty_is_zero {
    // merkle_root([]) == [0u8; 32]
    // Rationale: Empty tree has zero root
    @compileAssert(true);
}

invariant merkle_verify_single_leaf_no_siblings {
    // verify_merkle(root, leaf, [], 0) for single-leaf tree
    // Rationale: Single leaf is its own root, no siblings needed
    @compileAssert(true);
}

invariant merkle_verify_tamper_detection {
    // verify_merkle returns false for any tampered root, leaf, or siblings
    // Rationale: SHA256 collision resistance ensures tamper detection
    @compileAssert(true);
}

invariant prove_requires_valid_phi_challenge {
    // POST /prove rejects if phi_response != gf16_dot4(challenge[..4], node_id[..4])
    // V2: rejects if SHA256(pack(gf16_matmul(CHAMPION_WEIGHTS, challenge))) != response
    // Rationale: Layer 1 of PoUC must be enforced
    @compileAssert(true);
}

invariant v2_response_is_sha256_of_matmul {
    // V2 response = SHA256(pack(gf16_matmul(CHAMPION_WEIGHTS, challenge)))
    // Rationale: Forces full 16x16 matrix multiply, 2^256 security
    @compileAssert(true);
}

invariant v2_champion_weights_derived_from_seed {
    // CHAMPION_WEIGHTS[i][j] = SHA256("TRI_PHI_CHAMPION_SEED_V1" || i_le8)[j*2] >> 4
    // Rationale: Deterministic, publicly verifiable bootstrap
    @compileAssert(true);
}

invariant prove_requires_valid_merkle {
    // POST /prove rejects if merkle proof verification fails
    // Rationale: Layer 2 of PoUC must be enforced
    @compileAssert(true);
}

// ============================================================================
// TDD — Benchmarks
// ============================================================================

bench "bench_derive_phi_challenge" {
    // Measure: SHA256 challenge derivation latency
    // Target: < 500ns on commodity CPU
    @setEvalBranchQuota(10000);
    // Rust `[1u8; 32]` (32 copies of 1) in the file's own repeat form.
    var node_id: [32]u8 = [_]u8{1} ** 32;
    _ = derive_phi_challenge(1, node_id);
}

bench "bench_gf16_dot4" {
    // Measure: GF16 dot product of 4-element vectors
    // Target: < 20ns on commodity CPU, < 5 cycles on FPGA
    @setEvalBranchQuota(10000);
    var w: [4]u8 = [_]u8{1, 2, 3, 4};
    var x: [4]u8 = [_]u8{5, 6, 7, 8};
    _ = gf16_dot4(w, x);
}

bench "bench_merkle_verify_8_leaves" {
    // Measure: Merkle proof verification for 8-leaf tree
    // Target: < 2us on commodity CPU
    @setEvalBranchQuota(10000);
}
