// NOTE: This design is superseded by the mint-on-acceptance design in
// specs/trinet/mint_on_acceptance.t27 and contracts/solana/tri_mint.rs.
// Do not deploy. This file is kept for historical reference.
// DePIN proof-of-useful-compute spec
// Issue #40 — L-TRI-1: POST /prove endpoint
// phi^2 + phi^-2 = 3 | TRINITY

module depin.prove;
    use tri::crypto::sha256::TriSha256;

// ============================================================================
// Types
// ============================================================================

// Rust types written in t27 form: `[u8; N]` is `[N]u8`, and the growable
// `Vec<T>` is the slice `[]T` (t27 has no heap vector; the length travels
// with the slice).
pub struct ProveRequest {
    node_id : [32]u8,
    epoch : u64,
    phi_response : []u8,
    merkle_proof : MerkleProof,
    merkle_leaf_index : usize,
    peer_sample_sig : [64]u8,
    version : u8,
}

pub struct MerkleProof {
    root : [32]u8,
    leaf : [32]u8,
    siblings : [][32]u8,
}

pub struct ProveResponse {
    valid : bool,
    reward_lamports : u64,
    epoch_hash : [32]u8,
    next_challenge : [16]u8,
    tokens_count : u64,
    reason : ?[]const u8,
}

pub struct MiningEpoch {
    epoch_id : u64,
    phi_seed : [16]u8,
    start_ts : u64,
    block_reward : u64,
}

// ============================================================================
// Functions
// ============================================================================

pub fn derive_phi_challenge(epoch: u64, node_id: [32]u8) [16]u8 {
    // SHA256("TRI_PHI_CHALLENGE_V1" || epoch_le || node_id)[..16]
    var hasher = TriSha256.init();
    _ = hasher.update("TRI_PHI_CHALLENGE_V1");
    var epoch_bytes: [8]u8 = @bytesOf(epoch, .Little);
    _ = hasher.update(&epoch_bytes);
    _ = hasher.update(node_id);
    var hash = hasher.final();
    return hash[0..16];
}

pub fn verify_phi_response(challenge: [16]u8, response: [4]u8, node_id: [32]u8) bool {
    // gf16_dot4(challenge[..4], node_id[..4]) == response
    var challenge_prefix: [4]u8 = [_]u8{ challenge[0], challenge[1], challenge[2], challenge[3] };
    var node_id_prefix: [4]u8 = [_]u8{ node_id[0], node_id[1], node_id[2], node_id[3] };
    var dot = gf16_dot4(challenge_prefix, node_id_prefix);
    var i: usize = 0;
    while (i < 4) {
        if (dot[i] != response[i]) return false;
        i += 1;
    }
    return true;
}

pub fn gf16_mul(a: u8, b: u8) u8 {
    // GF(2^4) multiplication, reduction polynomial 0x3 (x^4 + x + 1)
    var result: u8 = 0;
    var aa: u8 = a & 0xF;
    var bb: u8 = b & 0xF;
    while (bb != 0) {
        if ((bb & 1) != 0) {
            result ^= aa;
        }
        var carry = aa & 0x8;
        aa = aa << 1;
        if (carry != 0) {
            aa ^= 0x3; // reduction polynomial x^4 + x + 1 = 0x13, but we shifted so it's 0x3
        }
        bb = bb >> 1;
    }
    return result & 0xF;
}

pub fn gf16_dot4(w: [4]u8, x: [4]u8) [4]u8 {
    // Element-wise GF16 multiplication of 4-element vectors
    var result: [4]u8 = [_]u8{0, 0, 0, 0};
    var i: usize = 0;
    while (i < 4) {
        result[i] = gf16_mul(w[i], x[i]);
        i += 1;
    }
    return result;
}

// The spec defined `compute_champion_weights` twice. Both drafts compute the
// same table -- SHA256 over 32 bytes (the 24-byte seed prefix + i as 8 LE
// bytes; i < 16, so only byte 24 is non-zero) -- and a name may be declared
// once, so this first, byte-by-byte draft keeps its body under its own name.
// compute_phi_response_v2 uses the second definition below.
fn compute_champion_weights_bytewise() [16][16]u8 {
    // CHAMPION_WEIGHTS[i][j] = SHA256("TRI_PHI_CHAMPION_SEED_V1" || i_le8)[j*2] >> 4
    var weights: [16][16]u8 = [_][16]u8{ [_]u8{0} ** 16 } ** 16;
    var i: usize = 0;
    while (i < 16) {
        var data: [40]u8 = [_]u8{0} ** 40; // "TRI_PHI_CHAMPION_SEED_V1" (24) + i_le8 (8) + padding
        // Copy prefix
        var prefix = "TRI_PHI_CHAMPION_SEED_V1";
        var p: usize = 0;
        while (p < 24) {
            data[p] = prefix[p];
            p += 1;
        }
        // Write i as little-endian u64
        var ii: u64 = @as(u64, @intCast(i));
        data[24] = @truncate(ii);
        data[25] = @truncate(ii >> 8);
        data[26] = @truncate(ii >> 16);
        data[27] = @truncate(ii >> 24);
        data[28] = @truncate(ii >> 32);
        data[29] = @truncate(ii >> 40);
        data[30] = @truncate(ii >> 48);
        data[31] = @truncate(ii >> 56);
        // Hash
        var hash = TriSha256.hash(&data[0..32]);
        // Extract high nibbles
        var j: usize = 0;
        while (j < 16) {
            weights[i][j] = (hash[j * 2] >> 4) & 0xF;
            j += 1;
        }
        i += 1;
    }
    return weights;
}

pub fn derive_phi_challenge_v2(epoch: u64, node_id: [32]u8) [16][16]u8 {
    // 16 rows, each = SHA256("TRI_PHI_CHALLENGE_V2" || epoch_le8 || node_id || row_index)[j*2] >> 4
    var result: [16][16]u8 = [_][16]u8{ [_]u8{0} ** 16 } ** 16;
    var i: usize = 0;
    while (i < 16) {
        var data: [72]u8 = [_]u8{0} ** 72; // "TRI_PHI_CHALLENGE_V2" (22) + epoch_le8 (8) + node_id (32) + i_le8 (8) + padding
        // Copy prefix
        var prefix = "TRI_PHI_CHALLENGE_V2";
        var p: usize = 0;
        while (p < 22) {
            data[p] = prefix[p];
            p += 1;
        }
        // Write epoch as little-endian u64
        data[22] = @truncate(epoch);
        data[23] = @truncate(epoch >> 8);
        data[24] = @truncate(epoch >> 16);
        data[25] = @truncate(epoch >> 24);
        data[26] = @truncate(epoch >> 32);
        data[27] = @truncate(epoch >> 40);
        data[28] = @truncate(epoch >> 48);
        data[29] = @truncate(epoch >> 56);
        // Copy node_id
        var n: usize = 0;
        while (n < 32) {
            data[30 + n] = node_id[n];
            n += 1;
        }
        // Write i as little-endian u64
        var ii: u64 = @as(u64, @intCast(i));
        data[62] = @truncate(ii);
        data[63] = @truncate(ii >> 8);
        data[64] = @truncate(ii >> 16);
        data[65] = @truncate(ii >> 24);
        data[66] = @truncate(ii >> 32);
        data[67] = @truncate(ii >> 40);
        data[68] = @truncate(ii >> 48);
        data[69] = @truncate(ii >> 56);
        // Hash
        var hash = TriSha256.hash(&data[0..70]);
        // Extract high nibbles
        var j: usize = 0;
        while (j < 16) {
            result[i][j] = (hash[j * 2] >> 4) & 0xF;
            j += 1;
        }
        i += 1;
    }
    return result;
}

fn compute_champion_weights() [16][16]u8 {
    // CHAMPION_WEIGHTS[i][j] = SHA256("TRI_PHI_CHAMPION_SEED_V1" || i_le8)[j*2] >> 4
    var result: [16][16]u8 = [_][16]u8{ [_]u8{0} ** 16 } ** 16;
    var seed_prefix: [32]u8 = [_]u8{0} ** 32;
    // "TRI_PHI_CHAMPION_SEED_V1" is 24 bytes
    @memcpy(&seed_prefix[0], "TRI_PHI_CHAMPION_SEED_V1", 24);
    var i: usize = 0;
    while (i < 16) {
        // Create input: prefix (24) + i_le8 (8) = 32 bytes
        var input: [32]u8 = seed_prefix;
        // Write i as little-endian 8 bytes at offset 24
        input[24] = (i as u8);
        input[25] = 0;
        input[26] = 0;
        input[27] = 0;
        input[28] = 0;
        input[29] = 0;
        input[30] = 0;
        input[31] = 0;
        var hash = TriSha256.hash(&input);
        var j: usize = 0;
        while (j < 16) {
            // Take byte j*2, high nibble
            result[i][j] = (hash[j * 2] >> 4) & 0xF;
            j += 1;
        }
        i += 1;
    }
    return result;
}

pub fn compute_phi_response_v2(challenge: [16][16]u8) [32]u8 {
    // SHA256(pack(gf16_matmul(CHAMPION_WEIGHTS, challenge)))
    var weights = compute_champion_weights();
    var mat = gf16_matmul(weights, challenge);
    // Pack the 16x16 matrix of 4-bit values into 128 bytes (16*16*4 bits = 128 bytes)
    var packed: [128]u8 = [_]u8{0} ** 128;
    var idx: usize = 0;
    var i: usize = 0;
    while (i < 16) {
        var j: usize = 0;
        while (j < 16) {
            // Two 4-bit values per byte
            var byte_idx = (i * 16 + j) / 2;
            if ((j & 1) == 0) {
                packed[byte_idx] = (mat[i][j] & 0xF);
            } else {
                packed[byte_idx] |= ((mat[i][j] & 0xF) << 4);
            }
            j += 1;
        }
        i += 1;
    }
    return TriSha256.hash(&packed);
}

pub fn verify_phi_response_v2(challenge: [16][16]u8, response: [32]u8) bool {
    // compute_phi_response_v2(challenge) == response
    var computed = compute_phi_response_v2(challenge);
    var i: usize = 0;
    while (i < 32) {
        if (computed[i] != response[i]) return false;
        i += 1;
    }
    return true;
}

pub fn gf16_matmul(a: [16][16]u8, b: [16][16]u8) [16][16]u8 {
    // 16x16 GF(2^4) matrix multiplication
    var result: [16][16]u8 = [_][16]u8{ [_]u8{0} ** 16 } ** 16;
    var i: usize = 0;
    while (i < 16) {
        var j: usize = 0;
        while (j < 16) {
            var sum: u8 = 0;
            var k: usize = 0;
            while (k < 16) {
                sum ^= gf16_mul(a[i][k], b[k][j]);
                k += 1;
            }
            result[i][j] = sum;
            j += 1;
        }
        i += 1;
    }
    return result;
}

pub fn pack_gf16_matrix(m: [16][16]u8) [128]u8 {
    // Pack 16x16 nibble matrix into 128 bytes (2 nibbles per byte)
    var result: [128]u8 = [_]u8{0} ** 128;
    var byte_idx: usize = 0;
    var i: usize = 0;
    while (i < 16) {
        var j: usize = 0;
        while (j < 16) {
            if ((j & 1) == 0) {
                // First nibble in the byte
                result[byte_idx] = m[i][j] & 0xF;
            } else {
                // Second nibble in the byte
                result[byte_idx] |= ((m[i][j] & 0xF) << 4);
                byte_idx += 1;
            }
            j += 1;
        }
        i += 1;
    }
    return result;
}

pub fn merkle_root(leaves: [][32]u8) [32]u8 {
    // Binary Merkle tree root computation
    if (leaves.len == 0) {
        // Empty tree has zero root
        var zero: [32]u8 = [_]u8{0} ** 32;
        return zero;
    }
    
    var current_level = leaves;
    while (current_level.len > 1) {
        var next_level: [][32]u8 = [];
        var i: usize = 0;
        while (i < current_level.len) {
            if (i + 1 < current_level.len) {
                // Pair two leaves and hash them
                var hasher = TriSha256.init();
                _ = hasher.update(&current_level[i]);
                _ = hasher.update(&current_level[i + 1]);
                var hash = hasher.final();
                next_level = next_level ++ [hash];
                i += 2;
            } else {
                // Odd number of leaves: promote last leaf to next level
                next_level = next_level ++ [current_level[i]];
                i += 1;
            }
        }
        current_level = next_level;
    }
    
    return current_level[0];
}

pub fn verify_merkle(root: [32]u8, leaf: [32]u8, siblings: [][32]u8, index: usize) bool {
    // Merkle inclusion proof verification
    var current = leaf;
    var sibling_idx: usize = 0;
    
    // Build up the proof by hashing with siblings according to the index bits
    while (sibling_idx < siblings.len) {
        var hasher = TriSha256.init();
        if (((index >> sibling_idx) & 1) == 0) {
            // Current is left child, sibling is right child
            _ = hasher.update(&current);
            _ = hasher.update(&siblings[sibling_idx]);
        } else {
            // Current is right child, sibling is left child
            _ = hasher.update(&siblings[sibling_idx]);
            _ = hasher.update(&current);
        }
        current = hasher.final();
        sibling_idx += 1;
    }
    
    // The final hash should match the root
    var i: usize = 0;
    while (i < 32) {
        if (current[i] != root[i]) return false;
        i += 1;
    }
    return true;
}

