// SPDX-License-Identifier: Apache-2.0
; specs/vibecoding/four_phases.t27 -- vibecoding lesson: the four phases, idea, build, test, ship
; One idea: work moves through four phases in order, and a failed test sends it back to build,
; never forward to ship. A phase is a number: 0 idea, 1 build, 2 test, 3 ship. The two tables
; below say where each phase goes next, one when the tests pass and one when they fail.
; Run it in the player, then change FAIL_NEXT[2] from 1 to 3 (a failed test goes on to ship) and
; read which test goes red.
; ASCII only, English only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module vibecoding_four_phases;

pub const PHASE_IDEA : u8 = 0;
pub const PHASE_BUILD : u8 = 1;
pub const PHASE_TEST : u8 = 2;
pub const PHASE_SHIP : u8 = 3;
pub const PHASE_COUNT : u8 = 4;

; Next phase, indexed by the phase you are in.
pub const PASS_NEXT : [4]u8 = [1, 2, 3, 3];
pub const FAIL_NEXT : [4]u8 = [1, 2, 1, 3];

test the_phases_run_in_order {
    assert PASS_NEXT[0] == PHASE_BUILD;
    assert PASS_NEXT[1] == PHASE_TEST;
    assert PASS_NEXT[2] == PHASE_SHIP;
}

test a_failed_test_goes_back_to_build {
    assert FAIL_NEXT[2] == PHASE_BUILD;
    assert FAIL_NEXT[2] != PHASE_SHIP;
}

test shipped_stays_shipped {
    assert PASS_NEXT[3] == PHASE_SHIP;
    assert FAIL_NEXT[3] == PHASE_SHIP;
}

test three_steps_from_idea_to_ship {
    assert PASS_NEXT[PASS_NEXT[PASS_NEXT[0]]] == PHASE_SHIP;
    assert PHASE_COUNT == PHASE_SHIP + 1;
}
