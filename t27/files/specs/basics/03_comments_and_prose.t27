// SPDX-License-Identifier: Apache-2.0
; t27 basics, lesson 3: Comments and prose lines.
; Two kinds of notes: a semicolon line of prose, and a comment after two slashes.

module basics_03_comments_and_prose;

; A prose line starts with a semicolon and must carry words.

// Two slashes start a comment anywhere, also after code.
pub const PROSE_NEEDS_WORDS : bool = true; // a trailing comment

test comments_change_nothing {
    // a comment inside a test
    assert PROSE_NEEDS_WORDS == true;
}
