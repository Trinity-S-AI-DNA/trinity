// SPDX-License-Identifier: Apache-2.0
; t27 basics, lesson 27: Where to go next.
; Course 1 takes these specs onto an FPGA; course 2 builds AI numbers with them.

module basics_27_where_next;

pub const COURSES : [3]str = ["t27-basics", "course", "ai-numbers"];
pub const LESSONS_EACH : u8 = 27;

test three_courses_of_27 {
    assert COURSES[0] == "t27-basics";
    assert COURSES[2] == "ai-numbers";
    assert LESSONS_EACH == 3 * 3 * 3;
}
