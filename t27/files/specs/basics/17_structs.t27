; t27 basics, lesson 17: Structs.
; A struct groups named fields, each with its own type.

module basics_17_structs;

pub struct Point {
    x: i32,
    y: i32,
}

pub const Flags = packed struct {
    ready: bool,
    error: bool,
};

pub const FIELDS_IN_POINT : u8 = 2;

test a_point_has_two_fields {
    assert FIELDS_IN_POINT == 2;
}
