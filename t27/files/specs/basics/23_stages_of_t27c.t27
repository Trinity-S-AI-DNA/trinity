; t27 basics, lesson 23: The stages of t27c.
; Bytes, tokens, a tree, a type check, HIR and code: how t27c reads a spec.

module basics_23_stages_of_t27c;

pub const WIDTH : u8 = 8;

pub fn add(a: u8, b: u8) -> u8 {
    return a + b;
}

test width_is_a_byte {
    assert WIDTH == 8;
}
