; t27 basics, lesson 7: Arrays.
; An array has a length and a type, [5]u8, and its items are read by index from 0.

module basics_07_arrays;

pub const PRIMES : [5]u8 = [2, 3, 5, 7, 11];
pub const DIGITS : [3]str = ["zero", "one", "two"];

test indexes_start_at_zero {
    assert PRIMES[0] == 2;
    assert PRIMES[4] == 11;
    assert DIGITS[2] == "two";
}
