// SPDX-License-Identifier: Apache-2.0
; t27 basics, lesson 21: gen-ts: a spec becomes TypeScript.
; gen-ts writes the constants of a spec as TypeScript, and leaves function bodies out.

module basics_21_gen_ts;

pub const WIDTH : u8 = 8;
pub const NAME : str = "basics";

pub fn add(a: u8, b: u8) -> u8 {
    return a + b;
}

test width_is_a_byte {
    assert WIDTH == 8;
}
