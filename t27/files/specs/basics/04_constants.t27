; t27 basics, lesson 4: Constants.
; A constant gives a name, a type and a value, and the name never changes its value.

module basics_04_constants;

pub const WIDTH : u8 = 8;
pub const HEIGHT : u8 = 4;
pub const AREA : u8 = 32;

test area_is_width_times_height {
    assert WIDTH * HEIGHT == AREA;
}
