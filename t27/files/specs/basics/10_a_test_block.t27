// SPDX-License-Identifier: Apache-2.0
; t27 basics, lesson 10: A test block.
; A test is a name and a list of asserts; each assert must be true.

module basics_10_a_test_block;

pub const DAYS : u16 = 365;
pub const WEEKS : u16 = 52;

test a_year_is_52_weeks_and_a_day {
    assert WEEKS * 7 + 1 == DAYS;
}
