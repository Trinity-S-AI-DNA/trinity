; t27 basics, lesson 12: Functions.
; A function takes typed inputs and returns a typed result.

module basics_12_functions;

pub fn add(a: u8, b: u8) -> u8 {
    return a + b;
}

pub fn twice(a: u8) u8 {
    return a + a;
}

pub const TWO_PLUS_THREE : u8 = 5;

test results_are_kept_as_constants {
    assert TWO_PLUS_THREE == 2 + 3;
}
