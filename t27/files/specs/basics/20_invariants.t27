; t27 basics, lesson 20: Invariants and benches.
; An invariant states a rule that must always hold; a bench names a measurement.

module basics_20_invariants;

pub const SIDES : u8 = 3;

invariant a_triangle_has_three_sides
    assert SIDES == 3

test the_invariant_as_a_test {
    assert SIDES == 3;
}
