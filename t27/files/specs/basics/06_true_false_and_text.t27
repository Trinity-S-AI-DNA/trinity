; t27 basics, lesson 6: True, false and text.
; bool holds true or false; str holds text between double quotes.

module basics_06_true_false_and_text;

pub const READY : bool = true;
pub const DONE : bool = false;
pub const NAME : str = "trit";
pub const NOT_A_COMMENT : str = "; and // inside quotes are text";

test bools_and_text_compare {
    assert READY == true;
    assert READY != DONE;
    assert NAME == "trit";
}
