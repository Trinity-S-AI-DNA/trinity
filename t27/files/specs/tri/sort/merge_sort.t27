// t27/specs/tri/sort/merge_sort.t27
// Split in half, recursively sort, merge | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-06 from trinity specs/tri/tri_merge_sort.tri. The port
// had empty sort(allocator) / sort_in_place(allocator) bodies and tests
// that read default_input() (defined nowhere). The .tri gives
// sort(allocator, values) -> []i64 (stable, new array) and
// sortInPlace(allocator, values) with an auxiliary buffer, behavior
// "Divide array in half recursively, merge sorted halves". Here the
// allocator is replaced by caller-provided buffers of values.len slots.

module TriMergeSort;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Core Functions
    // ═══════════════════════════════════════════════════════════

    // merge sorted values[lo..mid) and values[mid..hi) through scratch;
    // ties take the left run first, so the sort is stable
    fn merge(values: []i64, scratch: []i64, lo: usize, mid: usize, hi: usize) -> void {
        var i : usize = lo;
        var j : usize = mid;
        var k : usize = lo;
        while (k < hi) {
            if (j >= hi or (i < mid and values[i] <= values[j])) {
                scratch[k] = values[i];
                i = i + 1;
            } else {
                scratch[k] = values[j];
                j = j + 1;
            }
            k = k + 1;
        }
        k = lo;
        while (k < hi) {
            values[k] = scratch[k];
            k = k + 1;
        }
    }

    fn sort_range(values: []i64, scratch: []i64, lo: usize, hi: usize) -> void {
        if (hi - lo < 2) {
            return;
        }
        const mid = lo + (hi - lo) / 2;
        sort_range(values, scratch, lo, mid);
        sort_range(values, scratch, mid, hi);
        merge(values, scratch, lo, mid, hi);
    }

    fn sort_in_place(values: []i64, scratch: []i64) -> void {
        sort_range(values, scratch, 0, values.len);
    }

    // values is left untouched; output receives the sorted copy
    fn sort(values: []const i64, output: []i64, scratch: []i64) -> void {
        var k : usize = 0;
        while (k < values.len) {
            output[k] = values[k];
            k = k + 1;
        }
        sort_in_place(output, scratch);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // coded sum of x[k] * (k + 1): one number that pins every slot
    fn code(values: []const i64) -> i64 {
        var sum : i64 = 0;
        var k : usize = 0;
        while (k < values.len) {
            sum = sum + values[k] * ((k + 1) as i64);
            k = k + 1;
        }
        return sum;
    }

    // (9, -1, 4, 4, -8, 0, 7, 2, 6) -> (-8, -1, 0, 2, 4, 4, 6, 7, 9): 221
    fn sort_copy() -> i64 {
        const v : [9]i64 = [9, 0 - 1, 4, 4, 0 - 8, 0, 7, 2, 6];
        var out : [9]i64 = [0] ** 9;
        var scratch : [9]i64 = [0] ** 9;
        sort(&v, &out, &scratch);
        // the input must be unchanged: code(v) = 114
        return code(&out) * 1000 + code(&v);
    }

    // (5, -2, 8, 5, 0, -7, 3) -> (-7, -2, 0, 3, 5, 5, 8): 112
    fn sort_mixed() -> i64 {
        var v : [7]i64 = [5, 0 - 2, 8, 5, 0, 0 - 7, 3];
        var scratch : [7]i64 = [0] ** 7;
        sort_in_place(&v, &scratch);
        return code(&v);
    }

    fn edges_ok() -> bool {
        var two : [2]i64 = [2, 1];
        var s2 : [2]i64 = [0, 0];
        sort_in_place(&two, &s2);
        var none : [0]i64 = [];
        var s0 : [0]i64 = [];
        sort_in_place(&none, &s0);
        return two[0] == 1 and two[1] == 2;
    }

    test sort_copies_and_keeps_input
        given result = sort_copy()
        when expected = 221 * 1000 + 114
        then result == expected

    test sort_in_place_mixed
        given result = sort_mixed()
        when expected = 112
        then result == expected

    test sort_edge_inputs
        given result = edges_ok()
        when expected = true
        then result == expected
