// SPDX-License-Identifier: Apache-2.0
// t27/specs/
// Sort elements at gap distance, reduce gap | φ² + 1/φ² = 3 | TRINITY

module TriShellSort;
     use base::types;
     use math::constants;

     // ══════════════════════════════════════════════════════════════
     // 3. Core Functions
     // ══════════════════════════════════════════════════════════════

     // sort(values: []i64) → void
     fn sort(values: []i64) -> void {
         let n = values.length;
         if n <= 1 {
             return;
         }

         // Calculate gaps: 1, 4, 13, 40, ... (sequence: 3^k - 1)/2
         let mut gaps: []i64 = [];
         let mut gap = 1;
         while gap < n {
             gaps = gaps + [gap];
             gap = 3 * gap + 1;
         }

         // Start from the largest gap and work down to 1
         let mut i = gaps.length - 1;
         while i >= 0 {
             let g = gaps[i];
             // Insertion sort for this gap
             let mut j = g;
             while j < n {
                 let temp = values[j];
                 let mut k = j;
                 while k >= g {
                     if values[k - g] > temp {
                         values[k] = values[k - g];
                         k = k - g;
                     } else {
                         break;
                     }
                 }
                 values[k] = temp;
                 j = j + 1;
             }
             i = i - 1;
         }
     }

     // ══════════════════════════════════════════════════════════════
     // TDD: Tests (from .tri behaviors)
     // ══════════════════════════════════════════════════════════════

     test sort_basic_case
         given input = default_input()
         when result = sort(input)
         then result != undefined

     test sort_another_case
         given input = [5, 2, 3, 1, 4]
         when sort(input)
         then input == [1, 2, 3, 4, 5]