// t27/specs/
// Selection sort | φ² + 1/φ² = 3 | TRINITY

module TriSelectionSort;
    use base::types;

    // ═══════════════════════════════════════════════════════════════
    // Selection Sort Implementation
    // ═══════════════════════════════════════════════════════════════

    // sort(values: []i64) → void
    // Sorts the array in-place using selection sort algorithm
    fn sort(values: []i64) -> void {
        let n = values.len();
        if (n <= 1) {
            return;
        }
        for (i in 0..n - 1) {
            var min_idx = i;
            for (j in i + 1..n) {
                if (values[j] < values[min_idx]) {
                    min_idx = j;
                }
            }
            if (min_idx != i) {
                let tmp = values[i];
                values[i] = values[min_idx];
                values[min_idx] = tmp;
            }
        }
    }

    // ═══════════════════════════════════════════════════════════════
    // Tests
    // ═══════════════════════════════════════════════════════════════

    test sort_basic_case {
        var input = []i64{5, 2, 8, 1, 9};
        sort(input);
        assert(input[0] == 1);
        assert(input[1] == 2);
        assert(input[2] == 5);
        assert(input[3] == 8);
        assert(input[4] == 9);
    }

    test sort_already_sorted {
        var input = []i64{1, 2, 3, 4, 5};
        sort(input);
        assert(input[0] == 1);
        assert(input[1] == 2);
        assert(input[2] == 3);
        assert(input[3] == 4);
        assert(input[4] == 5);
    }

    test sort_reverse_sorted {
        var input = []i64{5, 4, 3, 2, 1};
        sort(input);
        assert(input[0] == 1);
        assert(input[1] == 2);
        assert(input[2] == 3);
        assert(input[3] == 4);
        assert(input[4] == 5);
    }

    test sort_single_element {
        var input = []i64{42};
        sort(input);
        assert(input[0] == 42);
    }

    test sort_empty {
        var input = []i64{};
        sort(input);
        // empty array stays empty - no assertions needed
    }