// t27/specs/
// Platform-aware paths | φ² + 1/φ² = 3 | TRINITY

module TriFs;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const Path = struct {
        parts : "[]const []const u8",
        absolute : "bool",
    };

    pub const FileInfo = struct {
        size : "u64",
        is_dir : "bool",
        is_file : "bool",
        modified : "Instant",
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // join(base: Path, suffix: Path, allocator: std.mem.Allocator) -> !Path
    fn join(base: Path, suffix: Path, allocator: std.mem.Allocator) -> !Path {
        var result_parts : "[]const []const u8" = allocator.alloc("[]const u8", base.parts.len + suffix.parts.len);
        if (result_parts == null) {
            return error.OutOfMemory;
        }
        
        // Copy base parts
        var i : usize = 0;
        while (i < base.parts.len) {
            result_parts[i] = base.parts[i];
            i += 1;
        }
        
        // Copy suffix parts
        var j : usize = 0;
        while (j < suffix.parts.len) {
            result_parts[i + j] = suffix.parts[j];
            j += 1;
        }
        
        return Path {
            .parts = result_parts,
            .absolute = base.absolute,
        };
    }

    // basename(path: Path) -> []const u8
    fn basename(path: Path) -> []const u8 {
        if (path.parts.len == 0) {
            return "";
        }
        return path.parts[path.parts.len - 1];
    }

    // dirname(path: Path) -> []const u8
    fn dirname(path: Path) -> []const u8 {
        if (path.parts.len == 0) {
            return "";
        }
        // Return all parts except the last one
        var result : "[]const u8" = "";
        var i : usize = 0;
        while (i < path.parts.len - 1) {
            if (i > 0) {
                result = result ++ "/";
            }
            result = result ++ path.parts[i];
            i += 1;
        }
        return result;
    }

    // extension(path: Path) -> ?[]const u8
    fn extension(path: Path) -> ?[]const u8 {
        if (path.parts.len == 0) {
            return null;
        }
        
        const last_part = path.parts[path.parts.len - 1];
        
        // Find the last dot in the last part
        var dot_pos : isize = -1;
        var i : isize = 0;
        while (i < last_part.len) {
            if (last_part[i] == '.') {
                dot_pos = i;
            }
            i += 1;
        }
        
        if (dot_pos == -1 or dot_pos == last_part.len - 1) {
            return null; // No dot or dot is at the end
        }
        
        return last_part[dot_pos + 1..];
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test join_basic_case
        given base = default_input(), suffix = default_input(), allocator = std.mem.Allocator
        when result = join(base, suffix, allocator)
        then result != undefined

    test basename_basic_case
        given input = default_input()
        when result = basename(input)
        then result != ""

    test dirname_basic_case
        given input = default_input()
        when result = dirname(input)
        then result != ""

    test extension_basic_case
        given input = default_input()
        when result = extension(input)
        then result != null

