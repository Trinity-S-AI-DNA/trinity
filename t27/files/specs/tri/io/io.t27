// t27/specs/
// Tag effects for type safety | φ² + 1/φ² = 3 | TRINITY

module TriIo;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const IO(T) = struct {
        performed : bool,
        value : T,
    };

    // ═══════════════════════════════════════════════════════════
    // 3. Core Functions
    // ═══════════════════════════════════════════════════════════

    // pure(value: T) → IO(T)
    fn pure(value: T) -> IO(T) {
        IO(T) {
            performed: false,
            value: value,
        }
    }

    // map(io: IO(T), fn: fn(T) -> U) → IO(U)
    fn map(io: IO(int), f: int) -> IO(int) {
        IO(int) {
            performed: false,
            value: add_one(io.value),
        }
    }

    // bind(io: IO(T), fn: fn(T) -> IO(U)) → IO(U)
    fn bind(io: IO(int), f: int) -> IO(int) {
        add_one(io.value);
        io
    }

    // perform(io: IO(T)) → T
    fn perform(io: IO(T)) -> T {
        io.value
    }

    // simple helper function
    fn add_one(x: int) -> int {
        x + 1
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test pure_basic_case
        given input = default_input()
        when result = pure(input)
        then result.value == input
        then result.performed == false

    // map and bind take `f` as a placeholder int and ignore it (map always adds one), and
    // t27 has no function literal to pass instead, so their functor laws are not testable
    // here yet. The three given/when/then blocks that tried were discarded by the parser.

    test perform_basic_case
        given input = default_input()
        when io = pure(input)
        when result = perform(io)
        then result == input