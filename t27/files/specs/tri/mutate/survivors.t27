// SPDX-License-Identifier: Apache-2.0
; specs/tri/mutate/survivors.t27 -- when `tri mutate spec` fails on survivors (#7303)
; `tri mutate spec` (cli/tri/src/mutate.rs, `mutate_spec`) exits 0 when mutants SURVIVE. It fails only
; when the unmutated spec is red or when some mutants could not be run, so a script or a CI step cannot
; gate on survivors without grepping the text `SURVIVED`. Measured 2026-10-07 on the Railway lab:
; `specs/tri/mutate/lab.t27` printed `48 of 52 killed ... 4 survived` and exited 0.
; This spec was slice 1 of #7303: the rule came first, in t27. Slice 2 is `--fail-on-survived` and
; `--accepted FILE` in cli/tri/src/mutate.rs, whose five gate functions copy the five below. Its test
; `the_gate_agrees_with_every_assert_row_of_its_spec` reads this file and evaluates every `assert` row
; of the tests below against that copy, so a row changed here fails the Rust test until the copy follows.
; The tool cannot tell an equivalent survivor from a test gap, so the caller lists the mutants it has
; accepted, one per line, as the tool prints them under SURVIVED or HUNG: `file:line [kind]`. Matching
; that text is the Rust's job; this spec sees only the counts:
;   survived        survivors in this run;
;   hung            mutants whose `zig test` outlived its clock: no check failed, so not killed;
;   accepted_hits   survivors and hung mutants whose line is in the accepted file;
;   accepted_killed lines in the accepted file whose mutant ran in this run and was killed.
; A line whose mutant did not run in this run (another `--fn`, or a line that moved) is in none of the
; four: a moved line leaves its survivor unaccepted, and that already fails. An unviable mutant (t27c or
; zig rejected it before any check ran) is counted nowhere, as cargo-mutants counts it nowhere.
; Exit codes follow cargo-mutants (mutants.rs, "Exit codes", read 2026-10-07): there 2 = mutants the
; tests missed, 3 = timeouts, 4 = a failing baseline. Here 2 = the gate failed, hung included; 1 stays the
; tool's error exit for a red baseline and for mutants not run, as today. Stryker's break threshold exits 1
; for a low score; that is the collision this spec avoids: a caller must tell a test gap from a broken run.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriMutateSurvivors;

// The tool's exit codes: 0 = every mutant ran on a green spec (and, with the gate on, none slipped
// past it); 1 = anyhow's error exit, no verdict (the unmutated spec is red, or some mutants could not be
// run); 2 = the gate failed: a survivor or a hung mutant the accepted file does not name, or an accepted
// line now killed. A wrapper passes 2 through (specs/tri/mutate/lab.t27 `lab_exit`).
pub const EXIT_OK : u8 = 0;
pub const EXIT_FAILED : u8 = 1;
pub const EXIT_SURVIVED : u8 = 2;

/// The gate is on with the flag, or with an accepted file: that file means something only to the gate.
/// Without either, the exit code is the one the tool has today.
pub fn gate_on(fail_on_survived: bool, accepted_given: bool) -> bool {
    return fail_on_survived || accepted_given;
}

/// Mutants that ran and were not killed: survivors, and hung mutants (a hang proves no check noticed).
pub fn not_killed(survived: u32, hung: u32) -> u32 {
    return survived + hung;
}

/// Not-killed mutants the accepted file does not name. More hits than mutants cannot come from a
/// correct count; the gate then treats every one as unaccepted rather than none (it fails closed).
pub fn unaccepted(missed: u32, accepted_hits: u32) -> u32 {
    if (accepted_hits > missed) { return missed; }
    return missed - accepted_hits;
}

/// The survivors' part of the exit code. With the gate on, an unaccepted survivor or hung mutant fails
/// the run, and so does an accepted line whose mutant is now killed: the file would otherwise keep a
/// claim that is no longer true, the way an expected-failure ledger refuses a fixed entry.
pub fn survivor_exit(on: bool, survived: u32, hung: u32, accepted_hits: u32, accepted_killed: u32) -> u8 {
    if (on == false) { return EXIT_OK; }
    if (unaccepted(not_killed(survived, hung), accepted_hits) > 0) { return EXIT_SURVIVED; }
    if (accepted_killed > 0) { return EXIT_SURVIVED; }
    return EXIT_OK;
}

/// The whole exit code. A red unmutated spec and mutants that could not run fail first, as today;
/// survivors are judged only on a run that is whole.
pub fn mutate_exit(baseline_green: bool, not_run: u32, survivors: u8) -> u8 {
    if (baseline_green == false) { return EXIT_FAILED; }
    if (not_run > 0) { return EXIT_FAILED; }
    return survivors;
}

/// 0 is success, 1 the tool's error exit, 2 the gate's verdict: a test gap is never read as a broken run.
invariant the_exit_codes_are_0_1_2 { assert EXIT_OK == 0 and EXIT_FAILED == 1 and EXIT_SURVIVED == 2; }

// Scenario: acceptance of #7303, third row -- no flag, no file: lab.t27's run exits 0 as today,
// with its 4 survivors.
test without_the_gate_survivors_exit_0_as_today {
    var on : bool = gate_on(false, false);
    assert on == false;
    assert survivor_exit(on, 4, 0, 0, 0) == EXIT_OK;
    assert survivor_exit(on, 4, 2, 0, 0) == EXIT_OK;
    assert mutate_exit(true, 0, survivor_exit(on, 4, 0, 0, 0)) == EXIT_OK;
}

// Scenario: acceptance of #7303, first row -- the flag on lab.t27: 4 survivors, none accepted. The exit
// is the gate's 2, not the tool's 1.
test the_flag_fails_on_unaccepted_survivors {
    var on : bool = gate_on(true, false);
    assert on == true;
    assert unaccepted(4, 0) == 4;
    assert survivor_exit(on, 4, 0, 0, 0) == EXIT_SURVIVED;
    assert mutate_exit(true, 0, survivor_exit(on, 4, 0, 0, 0)) == EXIT_SURVIVED;
}

// Scenario: acceptance of #7303, second row -- the 4 survivors listed as accepted.
test four_accepted_survivors_exit_0 {
    assert unaccepted(4, 4) == 0;
    assert survivor_exit(true, 4, 0, 4, 0) == EXIT_OK;
    assert mutate_exit(true, 0, survivor_exit(true, 4, 0, 4, 0)) == EXIT_OK;
}

// Scenario: one of the 4 is not in the file (a new survivor, or an accepted line that moved).
test one_unlisted_survivor_fails {
    assert unaccepted(4, 3) == 1;
    assert survivor_exit(true, 4, 0, 3, 0) == EXIT_SURVIVED;
}

// Scenario: a hung mutant is not a kill. Unlisted, it fails the gate; listed (a loop the mutant made
// endless), it passes; without the gate it changes nothing.
test a_hung_mutant_is_not_killed {
    assert not_killed(0, 1) == 1;
    assert not_killed(3, 2) == 5;
    assert survivor_exit(true, 0, 1, 0, 0) == EXIT_SURVIVED;
    assert survivor_exit(true, 0, 1, 1, 0) == EXIT_OK;
    assert survivor_exit(true, 2, 1, 2, 0) == EXIT_SURVIVED;
    assert survivor_exit(true, 2, 1, 3, 0) == EXIT_OK;
    assert survivor_exit(false, 0, 1, 0, 0) == EXIT_OK;
}

// Scenario: an accepted file alone turns the gate on.
test an_accepted_file_alone_turns_the_gate_on {
    var on : bool = gate_on(false, true);
    assert on == true;
    assert survivor_exit(on, 1, 0, 0, 0) == EXIT_SURVIVED;
    assert survivor_exit(on, 1, 0, 1, 0) == EXIT_OK;
}

// Scenario: a new test kills a mutant the file had accepted. The run is otherwise clean; the line
// must go, so the gate fails until it does.
test an_accepted_line_now_killed_fails {
    assert survivor_exit(true, 3, 0, 3, 1) == EXIT_SURVIVED;
    assert survivor_exit(true, 0, 0, 0, 2) == EXIT_SURVIVED;
    assert survivor_exit(true, 3, 0, 3, 0) == EXIT_OK;
    assert survivor_exit(false, 3, 0, 0, 1) == EXIT_OK;
}

// Scenario: every mutant killed, nothing accepted -- the gate passes with the flag on.
test nothing_survived_passes_the_gate {
    assert unaccepted(0, 0) == 0;
    assert survivor_exit(true, 0, 0, 0, 0) == EXIT_OK;
}

// Scenario: a count that cannot be right (more hits than not-killed mutants) fails closed.
test more_hits_than_survivors_fails_closed {
    assert unaccepted(2, 3) == 2;
    assert unaccepted(5, 5) == 0;
    assert survivor_exit(true, 2, 0, 3, 0) == EXIT_SURVIVED;
}

// Scenario: the run is not whole -- a red unmutated spec, or a mutant that did not run. That fails
// first with the tool's 1, as today, whatever the survivors say.
test a_run_that_is_not_whole_fails_first {
    assert mutate_exit(false, 0, EXIT_OK) == EXIT_FAILED;
    assert mutate_exit(true, 1, EXIT_OK) == EXIT_FAILED;
    assert mutate_exit(false, 0, EXIT_SURVIVED) == EXIT_FAILED;
    assert mutate_exit(true, 2, EXIT_SURVIVED) == EXIT_FAILED;
    assert mutate_exit(true, 0, EXIT_OK) == EXIT_OK;
    assert mutate_exit(true, 0, EXIT_SURVIVED) == EXIT_SURVIVED;
}
