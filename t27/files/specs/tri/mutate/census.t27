// SPDX-License-Identifier: Apache-2.0
; specs/tri/mutate/census.t27 -- one verdict and one share for a directory of specs (#7433)
; `tri mutate spec --file F` judges one spec. A census of a directory was, on 2026-10-07, a hand loop on
; the Railway lab over the 11 specs of specs/queen/: one log per spec, the exit codes collected in a
; text file, and the table and its totals copied out of the logs by hand (gHashTag/t27#6971, comment of
; 2026-10-07). This spec holds the rules of the census, before the command that uses them: slice 1 of
; #7433 the verdict and the share, slice 2a the reading of each spec's summary line, slice 2b a run
; whose counts do not add up and a directory with no spec. The command (`tri mutate census --dir D`,
; cli/tri/src/mutate.rs, through `t27c gen-rust` in gen/rust/tri/mutate/census.rs) is thin glue: it
; runs the existing per-spec path and folds what each run printed through the functions below.
; Two rules:
;   the verdict -- the directory's exit code is folded from the specs' exit codes, which are
;     survivors.t27's: 0 = whole run, gate passed (or off); 1 = no verdict (the unmutated spec is red, or
;     a mutant could not run); 2 = the gate failed. A code this spec does not know (the lab's 3, 4, 5:
;     specs/tri/mutate/lab.t27 `lab_exit`) is no verdict either, so it folds as 1. A directory with one
;     spec that has no verdict has no verdict: 1 wins over 2, as survivors.t27 `mutate_exit` judges
;     survivors only on a run that is whole.
;   the share -- killed of judged, in tenths of a percent, rounded DOWN, so 100.0 is printed only when
;     every judged mutant was killed. Judged = killed + survived + hung. An unviable mutant (t27c or zig
;     rejected it) judged nothing and is left out, as Stryker leaves out compile and runtime errors
;     ("mutant states and metrics", read 2026-10-07). A hung mutant is judged and NOT killed: Stryker
;     counts a timeout as detected, survivors.t27 does not, and this spec follows survivors.t27.
; Numbers in the tests are the 2026-10-07 census of specs/queen/ on master 05e633d03.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriMutateCensus;

// The exit codes of `tri mutate spec`, owned by specs/tri/mutate/survivors.t27 (EXIT_OK, EXIT_FAILED,
// EXIT_SURVIVED); the census exits with the same three.
pub const EXIT_OK : u8 = 0;
pub const EXIT_FAILED : u8 = 1;
pub const EXIT_SURVIVED : u8 = 2;

// A share is printed in tenths of a percent: 1000 = 100.0 %.
pub const TENTHS_WHOLE : u64 = 1000;

/// A spec's exit carries a verdict when it is 0 (whole run, gate passed) or 2 (gate failed).
pub fn verdict_known(code: u8) -> bool {
    return code == EXIT_OK or code == EXIT_SURVIVED;
}

/// Fold one spec's exit into the directory's, starting from EXIT_OK. No verdict anywhere -> 1;
/// else a failed gate anywhere -> 2; else 0. The order of the specs does not change the result.
pub fn census_exit(acc: u8, spec_exit: u8) -> u8 {
    if (verdict_known(acc) == false) { return EXIT_FAILED; }
    if (verdict_known(spec_exit) == false) { return EXIT_FAILED; }
    if (acc == EXIT_SURVIVED) { return EXIT_SURVIVED; }
    return spec_exit;
}

/// Mutants whose run judged the tests: killed, survived, hung. Unviable ones are not counted.
pub fn judged(killed: u64, survived: u64, hung: u64) -> u64 {
    return killed + survived + hung;
}

/// Killed of judged in tenths of a percent, rounded down. Nothing judged -> 0. More killed than
/// judged cannot come from a correct count; it reads 0 rather than a share above 100.0 (fails closed).
pub fn killed_tenths(killed: u64, of: u64) -> u64 {
    if (of == 0) { return 0; }
    if (killed > of) { return 0; }
    return killed * TENTHS_WHOLE / of;
}

/// The printed share is `whole.digit`: 927 -> 92 and 7.
pub fn tenths_whole_part(tenths: u64) -> u64 {
    return tenths / 10;
}

pub fn tenths_digit(tenths: u64) -> u64 {
    return tenths % 10;
}

/// 0 is success, 1 no verdict, 2 a failed gate -- survivors.t27's three, and 100.0 % is 1000 tenths.
invariant the_codes_and_the_scale { assert EXIT_OK == 0 and EXIT_FAILED == 1 and EXIT_SURVIVED == 2 and TENTHS_WHOLE == 1000; }

// Slice 2a: reading a spec's counts back from what `tri mutate spec` printed. Its summary line
// (cli/tri/src/mutate.rs `spec_report`) is, with 7 counts:
//   K of N killed (T by a failing test, I by an invariant at compile time); S survived, H hung, U unviable.
// The census reads K, S and H from each spec's line, so the totals come from the tool's own words and
// not from a log copied by hand.

// The counts by their place in the line, from 0.
pub const COUNT_KILLED : u32 = 0;
pub const COUNT_MUTANTS : u32 = 1;
pub const COUNT_BY_TEST : u32 = 2;
pub const COUNT_BY_INVARIANT : u32 = 3;
pub const COUNT_SURVIVED : u32 = 4;
pub const COUNT_HUNG : u32 = 5;
pub const COUNT_UNVIABLE : u32 = 6;

// A run of more digits than this is not a count the tool printed; 18 digits always fit in u64.
pub const MAX_COUNT_DIGITS : usize = 18;

/// One step of the summary line: at offset at, 1 to MAX_COUNT_DIGITS ASCII digits and then tail.
/// Returns the offset just past tail, or line.len + 1 when the step does not match. A step that
/// starts past the end does not match, so one miss carries through every later step.
pub fn after_count(line: string, at: usize, tail: string) -> usize {
    var end : usize = at;
    while (end < line.len and line[end] >= 48 and line[end] <= 57) {
        end = end + 1;
    }
    if (end == at or end - at > MAX_COUNT_DIGITS) { return line.len + 1; }
    if (tail.len > line.len - end) { return line.len + 1; }
    var k : usize = 0;
    while (k < tail.len) {
        if (line[end + k] != tail[k]) { return line.len + 1; }
        k = k + 1;
    }
    return end + tail.len;
}

/// Is line, without its newline, the summary line of a `tri mutate spec` run -- all of it?
pub fn is_summary_line(line: string) -> bool {
    var at : usize = after_count(line, 0, " of ");
    at = after_count(line, at, " killed (");
    at = after_count(line, at, " by a failing test, ");
    at = after_count(line, at, " by an invariant at compile time); ");
    at = after_count(line, at, " survived, ");
    at = after_count(line, at, " hung, ");
    at = after_count(line, at, " unviable.");
    return at == line.len;
}

/// The n-th run of digits in line as a number, from 0; 0 when line has fewer runs. Read it from a
/// line is_summary_line accepted: there every run is a count, and none is long enough to overflow.
/// It reads the whole line: once run n has ended, seen is past n and value no longer changes.
pub fn count_at(line: string, n: u32) -> u64 {
    var k : usize = 0;
    var seen : u32 = 0;
    var value : u64 = 0;
    var in_run : bool = false;
    while (k < line.len) {
        if (line[k] >= 48 and line[k] <= 57) {
            if (seen == n) { value = value * 10 + ((line[k] as u64) - 48); }
            in_run = true;
        } else {
            if (in_run) {
                seen = seen + 1;
                in_run = false;
            }
        }
        k = k + 1;
    }
    return value;
}

/// The tool puts every mutant in exactly one of killed, survived, hung and unviable, and every kill
/// is by a test or by an invariant. A summary line whose counts do not add up was not printed whole
/// by the tool, and the census does not sum it.
pub fn summary_adds_up(line: string) -> bool {
    const killed : u64 = count_at(line, COUNT_KILLED);
    if (killed != count_at(line, COUNT_BY_TEST) + count_at(line, COUNT_BY_INVARIANT)) { return false; }
    return count_at(line, COUNT_MUTANTS) == killed + count_at(line, COUNT_SURVIVED) + count_at(line, COUNT_HUNG) + count_at(line, COUNT_UNVIABLE);
}

/// The 7 counts are the summary line's, in its order, and 18 digits fit in u64.
invariant the_summary_line_has_7_counts_in_order { assert COUNT_KILLED == 0 and COUNT_MUTANTS == 1 and COUNT_BY_TEST == 2 and COUNT_BY_INVARIANT == 3 and COUNT_SURVIVED == 4 and COUNT_HUNG == 5 and COUNT_UNVIABLE == 6 and MAX_COUNT_DIGITS == 18; }

// Slice 2b: the two cases the command meets that slices 1 and 2a leave open.

/// A run that printed a summary line whose counts do not add up (`is_summary_line` true,
/// `summary_adds_up` false) printed counts the census does not sum, so its exit is not believed
/// either: it has no verdict. Before this rule, such a line would have been left out of the totals and the
/// directory could still exit 0.
pub fn spec_read(spec_exit: u8, unsound: u32) -> u8 {
    if (unsound > 0) { return EXIT_FAILED; }
    return spec_exit;
}

/// A census of no spec judged nothing, and the fold, which starts from EXIT_OK, would read it as a
/// clean 0. A directory of 0 specs has no verdict (1). PIT fails a run with no mutations by default
/// (`failWhenNoMutations`, read 2026-10-07) for the same reason.
pub fn census_of(specs: u32, folded: u8) -> u8 {
    if (specs == 0) { return EXIT_FAILED; }
    return folded;
}

// Scenario: the 2026-10-07 census of specs/queen/ with the accepted file, in file order: actors 0,
// brain_summaries 1 (does not compile, #7431), control 0, dispatch 2 (#7430), lotus 1 (#6519),
// merger_gate 0, priority 0, review_log 2 (line 36, closed by #7407), review_valve 0, task_analysis 0,
// views 0. The directory has no verdict: 1.
test the_queen_census_has_no_verdict_while_two_specs_do_not_compile {
    var acc : u8 = EXIT_OK;
    acc = census_exit(acc, 0);
    assert acc == EXIT_OK;
    acc = census_exit(acc, 1);
    assert acc == EXIT_FAILED;
    acc = census_exit(acc, 0);
    acc = census_exit(acc, 2);
    assert acc == EXIT_FAILED;
    acc = census_exit(acc, 1);
    acc = census_exit(acc, 0);
    acc = census_exit(acc, 0);
    acc = census_exit(acc, 2);
    acc = census_exit(acc, 0);
    acc = census_exit(acc, 0);
    acc = census_exit(acc, 0);
    assert acc == EXIT_FAILED;
}

// Scenario: the same directory once brain_summaries and lotus compile: dispatch and review_log still
// fail the gate, so the census exits 2.
test the_gate_fails_the_directory_when_every_spec_has_a_verdict {
    var acc : u8 = EXIT_OK;
    acc = census_exit(acc, 0);
    acc = census_exit(acc, 2);
    assert acc == EXIT_SURVIVED;
    acc = census_exit(acc, 0);
    assert acc == EXIT_SURVIVED;
    acc = census_exit(acc, 2);
    assert acc == EXIT_SURVIVED;
}

// Scenario: every spec passes its gate -- the census exits 0.
test a_clean_directory_exits_0 {
    assert census_exit(EXIT_OK, EXIT_OK) == EXIT_OK;
    var acc : u8 = EXIT_OK;
    acc = census_exit(acc, 0);
    acc = census_exit(acc, 0);
    acc = census_exit(acc, 0);
    assert acc == EXIT_OK;
}

// Scenario: no verdict wins over a failed gate in either order, so the order of the specs does not
// change the result.
test no_verdict_wins_in_either_order {
    assert census_exit(EXIT_SURVIVED, EXIT_FAILED) == EXIT_FAILED;
    assert census_exit(EXIT_FAILED, EXIT_SURVIVED) == EXIT_FAILED;
    assert census_exit(EXIT_FAILED, EXIT_OK) == EXIT_FAILED;
    assert census_exit(EXIT_OK, EXIT_FAILED) == EXIT_FAILED;
    assert census_exit(EXIT_SURVIVED, EXIT_OK) == EXIT_SURVIVED;
    assert census_exit(EXIT_OK, EXIT_SURVIVED) == EXIT_SURVIVED;
}

// Scenario: a lab run read back as 3 (no result), 4 (orphaned processes) or 5 (still running) carries
// no verdict; neither does a code no tool prints. Each folds as 1, from any accumulator.
test an_unknown_code_is_no_verdict {
    assert verdict_known(0) == true;
    assert verdict_known(2) == true;
    assert verdict_known(1) == false;
    assert verdict_known(3) == false;
    assert verdict_known(255) == false;
    assert census_exit(EXIT_OK, 3) == EXIT_FAILED;
    assert census_exit(EXIT_OK, 4) == EXIT_FAILED;
    assert census_exit(EXIT_SURVIVED, 5) == EXIT_FAILED;
    assert census_exit(3, EXIT_OK) == EXIT_FAILED;
    assert census_exit(5, EXIT_SURVIVED) == EXIT_FAILED;
}

// Scenario: the census totals of 2026-10-07: 783 killed, 54 survived, 7 hung over the 9 specs that
// ran; without dispatch.t27, 688 killed, 15 survived, 7 hung.
test the_queen_census_share_is_rounded_down {
    var all : u64 = judged(783, 54, 7);
    assert all == 844;
    assert killed_tenths(783, all) == 927;
    assert tenths_whole_part(927) == 92;
    assert tenths_digit(927) == 7;
    var rest : u64 = judged(688, 15, 7);
    assert rest == 710;
    assert killed_tenths(688, rest) == 969;
    assert tenths_whole_part(969) == 96;
    assert tenths_digit(969) == 9;
}

// Scenario: hung mutants are judged and not killed (task_analysis.t27: 33 killed, 0 survived, 2 hung).
test a_hung_mutant_lowers_the_share {
    assert judged(33, 0, 2) == 35;
    assert killed_tenths(33, judged(33, 0, 2)) == 942;
    assert killed_tenths(33, judged(33, 0, 0)) == 1000;
}

// Scenario: 100.0 % only when every judged mutant was killed -- 999 of 1000 and 1999 of 2000 both
// print 99.9, never 100.0.
test one_survivor_never_prints_100 {
    assert killed_tenths(1000, 1000) == TENTHS_WHOLE;
    assert killed_tenths(999, 1000) == 999;
    assert killed_tenths(1999, 2000) == 999;
    assert tenths_whole_part(999) == 99;
    assert tenths_digit(999) == 9;
    assert tenths_whole_part(1000) == 100;
    assert tenths_digit(1000) == 0;
    assert killed_tenths(28, 28) == TENTHS_WHOLE;
}

// Scenario: nothing judged (every mutant unviable, or a spec with no sites) reads 0, not a division by
// zero; an impossible count (more killed than judged) reads 0, not above 100.0.
test empty_and_impossible_counts_read_0 {
    assert judged(0, 0, 0) == 0;
    assert killed_tenths(0, 0) == 0;
    assert killed_tenths(5, 0) == 0;
    assert killed_tenths(5, 4) == 0;
    assert killed_tenths(4, 4) == TENTHS_WHOLE;
    assert killed_tenths(0, 4) == 0;
    assert killed_tenths(1, 3) == 333;
    assert killed_tenths(2, 3) == 666;
}

// Scenario: each part of judged counts on its own.
test judged_adds_all_three {
    assert judged(1, 0, 0) == 1;
    assert judged(0, 1, 0) == 1;
    assert judged(0, 0, 1) == 1;
    assert judged(295, 6, 3) == 304;
}

// Scenario: the 9 summary lines of the 2026-10-07 census of specs/queen/, as the tool printed them;
// summed, they give the census totals 783 killed, 54 survived, 7 hung.
test the_queen_summary_lines_sum_to_the_census {
    var killed : u64 = 0;
    var survived : u64 = 0;
    var hung : u64 = 0;
    var line : string = "295 of 304 killed (294 by a failing test, 1 by an invariant at compile time); 6 survived, 3 hung, 0 unviable.";
    assert is_summary_line(line) == true;
    assert summary_adds_up(line) == true;
    killed = killed + count_at(line, COUNT_KILLED);
    survived = survived + count_at(line, COUNT_SURVIVED);
    hung = hung + count_at(line, COUNT_HUNG);
    line = "169 of 173 killed (169 by a failing test, 0 by an invariant at compile time); 4 survived, 0 hung, 0 unviable.";
    assert is_summary_line(line) == true;
    killed = killed + count_at(line, COUNT_KILLED);
    survived = survived + count_at(line, COUNT_SURVIVED);
    hung = hung + count_at(line, COUNT_HUNG);
    line = "95 of 134 killed (95 by a failing test, 0 by an invariant at compile time); 39 survived, 0 hung, 0 unviable.";
    assert is_summary_line(line) == true;
    killed = killed + count_at(line, COUNT_KILLED);
    survived = survived + count_at(line, COUNT_SURVIVED);
    hung = hung + count_at(line, COUNT_HUNG);
    line = "28 of 28 killed (24 by a failing test, 4 by an invariant at compile time); 0 survived, 0 hung, 0 unviable.";
    assert is_summary_line(line) == true;
    assert summary_adds_up(line) == true;
    killed = killed + count_at(line, COUNT_KILLED);
    survived = survived + count_at(line, COUNT_SURVIVED);
    hung = hung + count_at(line, COUNT_HUNG);
    line = "27 of 31 killed (27 by a failing test, 0 by an invariant at compile time); 4 survived, 0 hung, 0 unviable.";
    killed = killed + count_at(line, COUNT_KILLED);
    survived = survived + count_at(line, COUNT_SURVIVED);
    hung = hung + count_at(line, COUNT_HUNG);
    line = "11 of 13 killed (11 by a failing test, 0 by an invariant at compile time); 1 survived, 1 hung, 0 unviable.";
    killed = killed + count_at(line, COUNT_KILLED);
    survived = survived + count_at(line, COUNT_SURVIVED);
    hung = hung + count_at(line, COUNT_HUNG);
    line = "50 of 50 killed (50 by a failing test, 0 by an invariant at compile time); 0 survived, 0 hung, 0 unviable.";
    killed = killed + count_at(line, COUNT_KILLED);
    survived = survived + count_at(line, COUNT_SURVIVED);
    hung = hung + count_at(line, COUNT_HUNG);
    line = "33 of 35 killed (33 by a failing test, 0 by an invariant at compile time); 0 survived, 2 hung, 0 unviable.";
    assert summary_adds_up(line) == true;
    killed = killed + count_at(line, COUNT_KILLED);
    survived = survived + count_at(line, COUNT_SURVIVED);
    hung = hung + count_at(line, COUNT_HUNG);
    line = "75 of 76 killed (75 by a failing test, 0 by an invariant at compile time); 0 survived, 1 hung, 0 unviable.";
    killed = killed + count_at(line, COUNT_KILLED);
    survived = survived + count_at(line, COUNT_SURVIVED);
    hung = hung + count_at(line, COUNT_HUNG);
    assert killed == 783;
    assert survived == 54;
    assert hung == 7;
    assert killed_tenths(killed, judged(killed, survived, hung)) == 927;
}

// Scenario: each count is read from its own place, including the last one and multi-digit runs.
test each_count_is_read_from_its_place {
    var line : string = "1234 of 98765 killed (1200 by a failing test, 34 by an invariant at compile time); 5 survived, 67 hung, 97459 unviable.";
    assert is_summary_line(line) == true;
    assert count_at(line, COUNT_KILLED) == 1234;
    assert count_at(line, COUNT_MUTANTS) == 98765;
    assert count_at(line, COUNT_BY_TEST) == 1200;
    assert count_at(line, COUNT_BY_INVARIANT) == 34;
    assert count_at(line, COUNT_SURVIVED) == 5;
    assert count_at(line, COUNT_HUNG) == 67;
    assert count_at(line, COUNT_UNVIABLE) == 97459;
    assert count_at(line, 7) == 0;
    assert count_at("", 0) == 0;
    assert count_at("no digits", 0) == 0;
    assert count_at("7", 0) == 7;
    assert summary_adds_up(line) == true;
}

// Scenario: the other lines the tool prints, and summary lines cut, padded or misspelled, are not
// summary lines.
test only_the_whole_summary_line_is_one {
    assert is_summary_line("") == false;
    assert is_summary_line("2 of 2 killed (2 by a failing test, 0 by an invariant at compile time); 0 survived, 0 hung, 0 unviable.") == true;
    assert is_summary_line("2 of 2 killed (2 by a failing test, 0 by an invariant at compile time); 0 survived, 0 hung, 0 unviable") == false;
    assert is_summary_line("2 of 2 killed (2 by a failing test, 0 by an invariant at compile time); 0 survived, 0 hung, 0 unviable.x") == false;
    assert is_summary_line(" 2 of 2 killed (2 by a failing test, 0 by an invariant at compile time); 0 survived, 0 hung, 0 unviable.") == false;
    assert is_summary_line("2 of 2 killed (2 by a failing test, 0 by an invariant at compile time); 0 survived, 0 hung,  unviable.") == false;
    assert is_summary_line("2 of 2 killed (2 by a failing test, 0 by an invariant at compile time); 0 survived, 0 hang, 0 unviable.") == false;
    assert is_summary_line("2 of x killed (2 by a failing test, 0 by an invariant at compile time); 0 survived, 0 hung, 0 unviable.") == false;
    assert is_summary_line("6 SURVIVED -- the spec's tests did not notice:") == false;
    assert is_summary_line("of 2 killed") == false;
}

// Scenario: a count of 18 digits is read; 19 digits is not a count the tool printed.
test a_count_has_at_most_18_digits {
    assert is_summary_line("999999999999999999 of 999999999999999999 killed (999999999999999999 by a failing test, 0 by an invariant at compile time); 0 survived, 0 hung, 0 unviable.") == true;
    assert count_at("999999999999999999 of 1", 0) == 999999999999999999;
    assert is_summary_line("1000000000000000000 of 1000000000000000000 killed (1000000000000000000 by a failing test, 0 by an invariant at compile time); 0 survived, 0 hung, 0 unviable.") == false;
    assert after_count("12 x", 0, " x") == 4;
    assert after_count("123456789012345678 x", 0, " x") == 20;
    assert after_count("1234567890123456789 x", 0, " x") == 22;
    assert after_count("12", 0, " x") == 3;
    assert after_count("12 y", 0, " x") == 5;
    assert after_count("ab 12 x", 3, " x") == 7;
    assert after_count("ab 12 x", 2, " x") == 8;
    assert after_count("12 x", 9, " x") == 5;
}

// Scenario: counts that cannot come from one whole run do not add up -- a kill counted by neither
// way, or a mutant in no bucket or in two.
test counts_that_do_not_add_up_are_refused {
    assert summary_adds_up("3 of 3 killed (2 by a failing test, 0 by an invariant at compile time); 0 survived, 0 hung, 0 unviable.") == false;
    assert summary_adds_up("3 of 3 killed (2 by a failing test, 2 by an invariant at compile time); 0 survived, 0 hung, 0 unviable.") == false;
    assert summary_adds_up("3 of 4 killed (3 by a failing test, 0 by an invariant at compile time); 0 survived, 0 hung, 0 unviable.") == false;
    assert summary_adds_up("3 of 4 killed (3 by a failing test, 0 by an invariant at compile time); 1 survived, 1 hung, 0 unviable.") == false;
    assert summary_adds_up("3 of 4 killed (3 by a failing test, 0 by an invariant at compile time); 1 survived, 0 hung, 0 unviable.") == true;
    assert summary_adds_up("3 of 4 killed (3 by a failing test, 0 by an invariant at compile time); 0 survived, 1 hung, 0 unviable.") == true;
    assert summary_adds_up("3 of 4 killed (3 by a failing test, 0 by an invariant at compile time); 0 survived, 0 hung, 1 unviable.") == true;
    assert summary_adds_up("3 of 4 killed (1 by a failing test, 2 by an invariant at compile time); 0 survived, 0 hung, 1 unviable.") == true;
}

// Scenario: a run printed a summary line whose counts do not add up. Its own exit, 0 or 2, is not
// believed, and the directory it is folded into has no verdict; a sound run keeps its exit.
test a_run_whose_counts_do_not_add_up_has_no_verdict {
    assert spec_read(EXIT_OK, 0) == EXIT_OK;
    assert spec_read(EXIT_SURVIVED, 0) == EXIT_SURVIVED;
    assert spec_read(EXIT_FAILED, 0) == EXIT_FAILED;
    assert spec_read(EXIT_OK, 1) == EXIT_FAILED;
    assert spec_read(EXIT_SURVIVED, 2) == EXIT_FAILED;
    assert census_exit(census_exit(EXIT_OK, spec_read(EXIT_OK, 0)), spec_read(EXIT_OK, 1)) == EXIT_FAILED;
    assert census_exit(census_exit(EXIT_OK, spec_read(EXIT_SURVIVED, 0)), spec_read(EXIT_OK, 0)) == EXIT_SURVIVED;
}

// Scenario: `tri mutate census --dir D` on a directory with no .t27 in it. The fold never ran and
// still holds EXIT_OK; the census is 1. With one spec or more the folded exit stands, whatever it is.
test an_empty_directory_has_no_verdict {
    assert census_of(0, EXIT_OK) == EXIT_FAILED;
    assert census_of(0, EXIT_SURVIVED) == EXIT_FAILED;
    assert census_of(1, EXIT_OK) == EXIT_OK;
    assert census_of(11, EXIT_SURVIVED) == EXIT_SURVIVED;
    assert census_of(11, EXIT_FAILED) == EXIT_FAILED;
}
