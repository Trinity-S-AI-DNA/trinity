module TriVariant;

pub const Variant(T) = struct {
    pub tag : []const u8,
    pub value : T,
};

pub fn make(tag: []const u8, value: T) Variant(T) {
    _ = tag; // unused by the spec body
    _ = value; // unused by the spec body
    return Variant(T);
}

pub fn get_tag(variant: Variant(T)) []const u8 {
    return variant.tag;
}

pub fn match(variant: Variant(T), handlers: Map) T {
    _ = handlers;
    return variant.value;
}

test "make_basic_case" {
    const input = undefined;
    const result = make(input);
    if (!(result != undefined)) __t27_assert_fail("\n  assertion failed:\n    result = {any}\n", .{ result });
}

test "get_tag_basic_case" {
    const input = undefined;
    const result = get_tag(input);
    if (!(result != undefined)) __t27_assert_fail("\n  assertion failed:\n    result = {any}\n", .{ result });
}

test "match_basic_case" {
    const input = undefined;
    const result = match(input);
    if (!(result != undefined)) __t27_assert_fail("\n  assertion failed:\n    result = {any}\n", .{ result });
}