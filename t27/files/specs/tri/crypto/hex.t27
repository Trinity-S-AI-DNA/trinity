// t27/specs/tri/crypto/hex.t27
// Every byte becomes 2 chars | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-07 from trinity src/tri/gen_hex.zig (generated from
// specs/tri/tri_hex.tri). The port's encode(codec) -> void and
// decode(input) -> void ignored their inputs, and their tests asserted
// `result == undefined` on a void result, which checks nothing. The Zig:
// encode writes alphabet[byte >> 4] then alphabet[byte & 0x0F] for every
// input byte, with "0123456789abcdef" or "0123456789ABCDEF" by the codec;
// decode refuses an odd length (error.InvalidLength) and any char outside
// 0-9, a-f, A-F (error.InvalidCharacter), and accepts both cases. Here the
// allocator becomes a caller buffer: encode and decode write into out and
// return the number of bytes written, or NONE (and write nothing) when out
// is too short; decode also returns NONE for the two Zig errors, and then
// out may hold a partial result.

module TriHex;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Types
    // ═══════════════════════════════════════════════════════════

    pub const Hex = struct {
        uppercase : bool,
    };

    pub const NONE : usize = 18446744073709551615;

    // ═══════════════════════════════════════════════════════════
    // 2. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn lower_case() -> Hex {
        return Hex{ .uppercase = false };
    }

    fn upper_case() -> Hex {
        return Hex{ .uppercase = true };
    }

    // Converts a hex character (0-9, a-f, A-F) to its nibble value (0-15),
    // or 255 for any other character
    fn char_to_nibble(c: u8) -> u8 {
        if (c >= '0' and c <= '9') return c - '0';
        if (c >= 'a' and c <= 'f') return c - 'a' + 10;
        if (c >= 'A' and c <= 'F') return c - 'A' + 10;
        return 255;
    }

    // Converts a nibble value (0-15) to its hex character, or 0 above 15
    fn nibble_to_char(n: u8, uppercase: bool) -> u8 {
        if (n > 15) return 0;
        if (n < 10) return '0' + n;
        if (uppercase) return 'A' + (n - 10);
        return 'a' + (n - 10);
    }

    // two chars per input byte, high nibble first
    fn encode(codec: Hex, input: []const u8, out: []u8) -> usize {
        if (out.len < input.len * 2) {
            return NONE;
        }
        var i : usize = 0;
        while (i < input.len) {
            out[i * 2] = nibble_to_char(input[i] / 16, codec.uppercase);
            out[i * 2 + 1] = nibble_to_char(input[i] % 16, codec.uppercase);
            i = i + 1;
        }
        return input.len * 2;
    }

    // one byte per two chars; either case is accepted
    fn decode(input: []const u8, out: []u8) -> usize {
        if (input.len % 2 != 0) {
            return NONE;
        }
        if (out.len < input.len / 2) {
            return NONE;
        }
        var i : usize = 0;
        while (i < input.len / 2) {
            const high = char_to_nibble(input[i * 2]);
            const low = char_to_nibble(input[i * 2 + 1]);
            if (high == 255 or low == 255) {
                return NONE;
            }
            out[i] = high * 16 + low;
            i = i + 1;
        }
        return input.len / 2;
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    fn same(a: []const u8, b: []const u8) -> bool {
        if (a.len != b.len) {
            return false;
        }
        var k : usize = 0;
        while (k < a.len) {
            if (a[k] != b[k]) {
                return false;
            }
            k = k + 1;
        }
        return true;
    }

    // 2 when plain encodes to coded and coded decodes to plain, into dirty buffers
    fn pair(codec: Hex, plain: []const u8, coded: []const u8) -> usize {
        var e : [16]u8 = [42] ** 16;
        var p : [8]u8 = [42] ** 8;
        var ok : usize = 0;
        const n = encode(codec, plain, &e);
        if (n == coded.len and same(e[0..n], coded)) {
            ok = ok + 1;
        }
        const m = decode(coded, &p);
        if (m == plain.len and same(p[0..m], plain)) {
            ok = ok + 1;
        }
        return ok;
    }

    // the Zig tests' 0xDE 0xAD 0xBE 0xEF in both cases, RFC 4648 section 10
    // BASE16 ("foobar" is 666F6F626172), and the empty input
    fn vectors() -> usize {
        const lo = lower_case();
        const up = upper_case();
        const dead : [4]u8 = [222, 173, 190, 239];
        return pair(lo, &dead, "deadbeef") + pair(up, &dead, "DEADBEEF") + pair(up, "", "")
            + pair(up, "f", "66") + pair(up, "fo", "666F") + pair(up, "foobar", "666F6F626172")
            + pair(lo, "foobar", "666f6f626172");
    }

    // every byte value: encode then decode gives it back, in both cases,
    // and the two chars are the nibble chars
    fn all_bytes() -> usize {
        var good : usize = 0;
        var b : usize = 0;
        while (b < 256) {
            const x : [1]u8 = [b as u8];
            var lo : [2]u8 = [0] ** 2;
            var up : [2]u8 = [0] ** 2;
            var back : [1]u8 = [0] ** 1;
            var back_up : [1]u8 = [0] ** 1;
            const n = encode(lower_case(), &x, &lo);
            const m = encode(upper_case(), &x, &up);
            const d = decode(&lo, &back);
            const e = decode(&up, &back_up);
            const chars = lo[0] == nibble_to_char((b / 16) as u8, false) and lo[1] == nibble_to_char((b % 16) as u8, false)
                and up[0] == nibble_to_char((b / 16) as u8, true) and up[1] == nibble_to_char((b % 16) as u8, true);
            if (n == 2 and m == 2 and d == 1 and e == 1 and back[0] == x[0] and back_up[0] == x[0] and chars) {
                good = good + 1;
            }
            b = b + 1;
        }
        return good;
    }

    fn refused(input: []const u8) -> usize {
        var out : [8]u8 = [42] ** 8;
        if (decode(input, &out) == NONE) {
            return 1;
        }
        return 0;
    }

    // odd lengths and chars outside 0-9, a-f, A-F; counts the ones refused
    fn refusals() -> usize {
        return refused("a") + refused("abc") + refused("g0") + refused("0g") + refused("0G")
            + refused("/0") + refused(":0") + refused("@0") + refused("`0") + refused("0 ")
            + refused("de ad");
    }

    // mixed case decodes; short output buffers are refused before anything is written
    fn buffers_ok() -> bool {
        var d1 : [1]u8 = [42] ** 1;
        var d2 : [2]u8 = [42] ** 2;
        var e3 : [3]u8 = [42] ** 3;
        var e4 : [4]u8 = [42] ** 4;
        const mixed = decode("dEaD", &d2) == 2 and d2[0] == 222 and d2[1] == 173;
        const dec = decode("beef", &d1) == NONE and d1[0] == 42;
        const ab : [2]u8 = [171, 205];
        const enc = encode(lower_case(), &ab, &e3) == NONE and e3[0] == 42 and encode(lower_case(), &ab, &e4) == 4
            and e4[0] == 'a' and e4[3] == 'd';
        return mixed and dec and enc;
    }

    test lower_case_basic_case
        when result = lower_case()
        then result.uppercase == false

    test upper_case_basic_case
        when result = upper_case()
        then result.uppercase == true

    test char_to_nibble_lowercase
        when result = char_to_nibble('a')
        then result == 10

    test char_to_nibble_uppercase
        when result = char_to_nibble('F')
        then result == 15

    test char_to_nibble_digit
        when result = char_to_nibble('7')
        then result == 7

    test char_to_nibble_invalid
        when result = char_to_nibble('g')
        then result == 255

    test nibble_to_char_lowercase
        when result = nibble_to_char(10, false)
        then result == 'a'

    test nibble_to_char_uppercase
        when result = nibble_to_char(15, true)
        then result == 'F'

    test nibble_to_char_digit
        when result = nibble_to_char(7, false)
        then result == '7'

    test nibble_to_char_out_of_range
        when result = nibble_to_char(16, false)
        then result == 0

    test encode_decode_vectors
        given result = vectors()
        when expected = 14
        then result == expected

    test every_byte_round_trips
        given result = all_bytes()
        when expected = 256
        then result == expected

    test invalid_input_is_refused
        given result = refusals()
        when expected = 11
        then result == expected

    test short_buffers_are_refused
        given result = buffers_ok()
        when expected = true
        then result == expected
