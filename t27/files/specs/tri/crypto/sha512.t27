// SPDX-License-Identifier: Apache-2.0
// t27/specs/tri/crypto/sha512.t27
// SHA-512 (FIPS 180-4 section 6.4): Merkle-Damgard over 128-byte blocks and
// 64-bit words | phi^2 + 1/phi^2 = 3 | TRINITY
//
// Step 3a of R3-1 (#7332, epic #6655): t27c signs hardware receipts with
// Ed25519, and Ed25519 hashes with SHA-512. Today both come from the
// ed25519-dalek and sha2 crates; this spec is the SHA-512 half of the
// path that lets t27c drop them. Ed25519 itself is a later step.
//
// Layout follows specs/tri/crypto/sha256.t27 as rewritten in the native
// dialect: init / update / finish / hash, padding through update, so after
// finish the hasher is spent and must be re-initialised. Words are u64 and
// every sum is the wrapping +% (FIPS 180-4 addition is mod 2^64). NOT x is
// written x ^ ALL because a unary operator loses the parentheses around its
// operand in codegen (#6549). The padding step is called finish, not final,
// because `final` is a reserved word in the Rust backend.
//
// The message length field is 128 bits: the high word is count >> 61 and
// the low word count *% 8, which is the bit length mod 2^128 for any u64
// byte count.
//
// Oracles: FIPS 180-4 / NIST example vectors ("", "abc", and the 896-bit
// two-block message), digests of 111, 112, 127, 128, 239 and 240 'a' bytes,
// which straddle every padding boundary, and random chunked updates against
// one-shot hashing. Expected digests were computed with Python's hashlib.
//
// Mutation-checked 2026-10-07 with t27c test-report on the lab: 22 one-line
// mutants (round constants, H0, every rotation and shift amount, ch, maj,
// the schedule bound and lag, the state feed-forward, the 0x80 marker, the
// padding split, the length field, byte packing and digest readout); 21
// fail a test. The survivor is len_hi = count >> 60 instead of >> 61, which
// differs only for messages of 2^60 bytes or more and is equivalent here.

module TriSha512;
    use base::types;

    // ===========================================================
    // 1. Constants
    // ===========================================================

    // FIPS 180-4 section 5.3.5: the first 64 bits of the fractional parts
    // of the square roots of the first eight primes
    pub const H0 : [8]u64 = [
        0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
        0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179,
    ];

    // FIPS 180-4 section 4.2.3: the first 64 bits of the fractional parts
    // of the cube roots of the first eighty primes
    pub const K : [80]u64 = [
        0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
        0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
        0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
        0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
        0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
        0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
        0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
        0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
        0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
        0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
        0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
        0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
        0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
        0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
        0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
        0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
        0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
        0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
        0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
        0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817,
    ];

    // all 64 bits set: x ^ ALL is NOT x
    pub const ALL : u64 = 18446744073709551615;

    // ===========================================================
    // 2. Types
    // ===========================================================

    pub const SHA512 = struct {
        state : [8]u64,
        buffer : [128]u8,
        count : u64,
    };

    // ===========================================================
    // 3. Core Functions
    // ===========================================================

    fn init() -> SHA512 {
        return SHA512{ .state = H0, .buffer = [0] ** 128, .count = 0 };
    }

    // x rotated right by 0 < n < 64
    fn rotr(x: u64, n: u64) -> u64 {
        return (x >> n) | (x << (64 - n));
    }

    fn big_sigma0(x: u64) -> u64 {
        return rotr(x, 28) ^ rotr(x, 34) ^ rotr(x, 39);
    }

    fn big_sigma1(x: u64) -> u64 {
        return rotr(x, 14) ^ rotr(x, 18) ^ rotr(x, 41);
    }

    fn small_sigma0(x: u64) -> u64 {
        return rotr(x, 1) ^ rotr(x, 8) ^ (x >> 7);
    }

    fn small_sigma1(x: u64) -> u64 {
        return rotr(x, 19) ^ rotr(x, 61) ^ (x >> 6);
    }

    fn ch(x: u64, y: u64, z: u64) -> u64 {
        return (x & y) ^ ((x ^ ALL) & z);
    }

    fn maj(x: u64, y: u64, z: u64) -> u64 {
        return (x & y) ^ (x & z) ^ (y & z);
    }

    // one 128-byte block from sha.buffer into sha.state
    fn compress(sha: *SHA512) -> void {
        var w : [80]u64 = [0] ** 80;
        var t : usize = 0;
        while (t < 16) {
            var word : u64 = 0;
            var b : usize = 0;
            while (b < 8) {
                word = (word << 8) | (sha.buffer[t * 8 + b] as u64);
                b = b + 1;
            }
            w[t] = word;
            t = t + 1;
        }
        while (t < 80) {
            w[t] = small_sigma1(w[t - 2]) +% w[t - 7] +% small_sigma0(w[t - 15]) +% w[t - 16];
            t = t + 1;
        }
        var v : [8]u64 = [0] ** 8;
        var k : usize = 0;
        while (k < 8) {
            v[k] = sha.state[k];
            k = k + 1;
        }
        t = 0;
        while (t < 80) {
            const t1 = v[7] +% big_sigma1(v[4]) +% ch(v[4], v[5], v[6]) +% K[t] +% w[t];
            const t2 = big_sigma0(v[0]) +% maj(v[0], v[1], v[2]);
            v[7] = v[6];
            v[6] = v[5];
            v[5] = v[4];
            v[4] = v[3] +% t1;
            v[3] = v[2];
            v[2] = v[1];
            v[1] = v[0];
            v[0] = t1 +% t2;
            t = t + 1;
        }
        k = 0;
        while (k < 8) {
            sha.state[k] = sha.state[k] +% v[k];
            k = k + 1;
        }
    }

    fn update(sha: *SHA512, data: []const u8) -> void {
        var i : usize = 0;
        while (i < data.len) {
            sha.buffer[(sha.count % 128) as usize] = data[i];
            sha.count = sha.count + 1;
            if (sha.count % 128 == 0) {
                compress(sha);
            }
            i = i + 1;
        }
    }

    // pads with 0x80, zeros to 112 mod 128, and the 128-bit big-endian bit
    // length, then reads the eight state words out big-endian
    fn finish(sha: *SHA512) -> [64]u8 {
        const len_hi = sha.count >> 61;
        const len_lo = sha.count *% 8;
        const used = (sha.count % 128) as usize;
        var zeros : usize = 239 - used;
        if (used < 112) {
            zeros = 111 - used;
        }
        var pad : [144]u8 = [0] ** 144;
        pad[0] = 128;
        var k : usize = 0;
        while (k < 8) {
            pad[1 + zeros + k] = ((len_hi >> (56 - 8 * (k as u64))) & 255) as u8;
            pad[9 + zeros + k] = ((len_lo >> (56 - 8 * (k as u64))) & 255) as u8;
            k = k + 1;
        }
        update(sha, pad[0 .. zeros + 17]);
        var out : [64]u8 = [0] ** 64;
        var i : usize = 0;
        while (i < 64) {
            out[i] = ((sha.state[i / 8] >> (56 - 8 * ((i % 8) as u64))) & 255) as u8;
            i = i + 1;
        }
        return out;
    }

    fn hash(data: []const u8) -> [64]u8 {
        var sha = init();
        update(&sha, data);
        return finish(&sha);
    }

    // ===========================================================
    // TDD: Tests
    // ===========================================================

    fn nibble(c: u8) -> usize {
        if (c >= 97) {
            return (c as usize) - 87;
        }
        return (c as usize) - 48;
    }

    // digest equals the 128-letter lower-case hex string
    fn is_hex(d: [64]u8, hex: []const u8) -> bool {
        if (hex.len != 128) {
            return false;
        }
        var i : usize = 0;
        while (i < 64) {
            if ((d[i] as usize) != nibble(hex[2 * i]) * 16 + nibble(hex[2 * i + 1])) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    fn a_bytes(n: usize) -> [64]u8 {
        var x : [240]u8 = [97] ** 240;
        return hash(x[0..n]);
    }

    // FIPS 180-4 / NIST example vectors: one block, one block, two blocks
    fn fips_vectors() -> usize {
        var ok : usize = 0;
        if (is_hex(hash(""), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")) {
            ok = ok + 1;
        }
        if (is_hex(hash("abc"), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")) {
            ok = ok + 1;
        }
        if (is_hex(hash("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"),
                "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909")) {
            ok = ok + 1;
        }
        return ok;
    }

    // n 'a' bytes for n on both sides of each padding boundary
    fn boundary_vectors() -> usize {
        var ok : usize = 0;
        if (is_hex(a_bytes(111), "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2")) {
            ok = ok + 1;
        }
        if (is_hex(a_bytes(112), "c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca")) {
            ok = ok + 1;
        }
        if (is_hex(a_bytes(127), "828613968b501dc00a97e08c73b118aa8876c26b8aac93df128502ab360f91bab50a51e088769a5c1eff4782ace147dce3642554199876374291f5d921629502")) {
            ok = ok + 1;
        }
        if (is_hex(a_bytes(128), "b73d1929aa615934e61a871596b3f3b33359f42b8175602e89f7e06e5f658a243667807ed300314b95cacdd579f3e33abdfbe351909519a846d465c59582f321")) {
            ok = ok + 1;
        }
        if (is_hex(a_bytes(239), "52c853cb8d907f3d4d6b889beb027985d7c273486d75f8baf26f80d24e90c74c6c3de3e22131582380a7d14d43f2941a31385439cd6ddc469f628015e50bf286")) {
            ok = ok + 1;
        }
        if (is_hex(a_bytes(240), "4c296d90c61052a62ffb1dd196f1b7b09373b1f93e71836baebf89690546b7595684dbe9467a8e484fa0d1094272b4344a7c24f5fee8daedeb0bf549c985ab5f")) {
            ok = ok + 1;
        }
        return ok;
    }

    fn same(a: [64]u8, b: [64]u8) -> bool {
        var i : usize = 0;
        while (i < 64) {
            if (a[i] != b[i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // seeded random messages of 0..299 bytes fed in random chunks hash the
    // same as in one piece, and count is the byte count before finish
    fn chunked_streams() -> usize {
        var s : usize = 27;
        var good : usize = 0;
        var t : usize = 0;
        while (t < 12) {
            var x : [300]u8 = [0] ** 300;
            s = (s * 1103515245 + 12345) % 2147483648;
            const n = s % 300;
            var k : usize = 0;
            while (k < n) {
                s = (s * 1103515245 + 12345) % 2147483648;
                x[k] = ((s / 65536) % 256) as u8;
                k = k + 1;
            }
            var sha = init();
            var at : usize = 0;
            while (at < n) {
                s = (s * 1103515245 + 12345) % 2147483648;
                var step = 1 + s % 140;
                if (at + step > n) {
                    step = n - at;
                }
                update(&sha, x[at .. at + step]);
                at = at + step;
            }
            const counted = (sha.count as usize) == n;
            if (counted and same(finish(&sha), hash(x[0..n]))) {
                good = good + 1;
            }
            t = t + 1;
        }
        return good;
    }

    fn initial_ok() -> bool {
        const sha = init();
        return sha.state[0] == 0x6a09e667f3bcc908 and sha.state[7] == 0x5be0cd19137e2179 and sha.count == 0;
    }

    // rotation moves the low bit to the top and keeps every bit
    fn rotr_ok() -> bool {
        return rotr(1, 1) == 0x8000000000000000 and rotr(0x0123456789abcdef, 4) == 0xf0123456789abcde
            and rotr(ALL, 37) == ALL;
    }

    test fips_180_4_vectors
        given result = fips_vectors()
        when expected = 3
        then result == expected

    test padding_boundary_vectors
        given result = boundary_vectors()
        when expected = 6
        then result == expected

    test chunked_updates_match_one_shot
        given result = chunked_streams()
        when expected = 12
        then result == expected

    test init_is_the_fips_initial_state
        given result = initial_ok()
        when expected = true
        then result == expected

    test rotr_is_a_64_bit_rotation
        given result = rotr_ok()
        when expected = true
        then result == expected
