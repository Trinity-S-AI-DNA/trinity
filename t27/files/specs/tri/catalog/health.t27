// SPDX-License-Identifier: Apache-2.0
; specs/tri/catalog/health.t27 -- what the SPECS catalog's health column means for the t27b loop (gHashTag/t27#6436, Refs #6434)
; The catalog (t27.ai/t27/manifest.json) marks every spec it carries ok, warn or fail. A raw count of
; warn and fail mixes two things the loop must not mix: fixtures written to be rejected (a negative
; fixture that fails is the test passing) and real specs that a backend or the parser cannot take.
; This file is the one home of that split. `tri catalog health` reads the manifest and calls the
; functions below through `t27c gen-c` and ctypes; the Python only counts and prints.
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriCatalogHealth;

/// Health of one spec in one catalog build. ABSENT: the spec is not in that build at all.
/// A health string the catalog adds later is an error in the reader, never a guess.
pub const HEALTH_OK : u8 = 0;
pub const HEALTH_WARN : u8 = 1;
pub const HEALTH_FAIL : u8 = 2;
pub const HEALTH_ABSENT : u8 = 3;

/// A negative fixture: a path under one of these directories, or a file name that starts with one of
/// these prefixes. Comma separated; the reader matches path prefixes and file-name prefixes only.
pub const NEGATIVE_DIRS : str = "bootstrap/tests/fixtures/";
pub const NEGATIVE_PREFIXES : str = "neg_,damage_,eof_";

/// The bucket one spec counts in. A broken spec with no AST nodes did not parse; one with nodes parsed
/// and lost only backends (or dropped content).
pub const BUCKET_OK : u8 = 0;
pub const BUCKET_FIXTURE_PARSE : u8 = 1;
pub const BUCKET_FIXTURE_BACKEND : u8 = 2;
pub const BUCKET_REAL_PARSE : u8 = 3;
pub const BUCKET_REAL_BACKEND : u8 = 4;

/// What happened to one spec between two catalog builds.
pub const CHANGE_NONE : u8 = 0;
pub const CHANGE_FIXED : u8 = 1;
pub const CHANGE_BROKE : u8 = 2;
pub const CHANGE_ADDED_BROKEN : u8 = 3;
pub const CHANGE_ADDED_OK : u8 = 4;
pub const CHANGE_REMOVED_BROKEN : u8 = 5;
pub const CHANGE_REMOVED_OK : u8 = 6;
pub const CHANGE_WORSE : u8 = 7;
pub const CHANGE_BETTER : u8 = 8;

/// warn and fail are broken; ok and absent are not.
pub fn is_broken(health: u8) -> bool {
    if (health == HEALTH_WARN) { return true; }
    if (health == HEALTH_FAIL) { return true; }
    return false;
}

/// Either marker makes a negative fixture: the directory holds fixtures written to be rejected, and
/// the prefixes name rejection fixtures wherever they sit.
pub fn is_negative(in_negative_dir: bool, negative_prefix: bool) -> bool {
    if (in_negative_dir) { return true; }
    if (negative_prefix) { return true; }
    return false;
}

/// The bucket of one spec: ok, or broken split by fixture-or-real and by parse-or-backend.
pub fn bucket(health: u8, negative: bool, nodes: u32) -> u8 {
    if (is_broken(health) == false) { return BUCKET_OK; }
    if (negative) {
        if (nodes == 0) { return BUCKET_FIXTURE_PARSE; }
        return BUCKET_FIXTURE_BACKEND;
    }
    if (nodes == 0) { return BUCKET_REAL_PARSE; }
    return BUCKET_REAL_BACKEND;
}

/// Only a real spec is work for the loop; a broken negative fixture is the fixture doing its job.
pub fn is_work(b: u8) -> bool {
    if (b == BUCKET_REAL_PARSE) { return true; }
    if (b == BUCKET_REAL_BACKEND) { return true; }
    return false;
}

/// One spec between an old and a new catalog build.
pub fn change(old: u8, new: u8) -> u8 {
    if (old == new) { return CHANGE_NONE; }
    if (old == HEALTH_ABSENT) {
        if (is_broken(new)) { return CHANGE_ADDED_BROKEN; }
        return CHANGE_ADDED_OK;
    }
    if (new == HEALTH_ABSENT) {
        if (is_broken(old)) { return CHANGE_REMOVED_BROKEN; }
        return CHANGE_REMOVED_OK;
    }
    if (old == HEALTH_OK) { return CHANGE_BROKE; }
    if (new == HEALTH_OK) { return CHANGE_FIXED; }
    if (new == HEALTH_FAIL) { return CHANGE_WORSE; }
    return CHANGE_BETTER;
}

/// A change the loop has to look at: something that was ok or absent is now broken, or warn became fail.
pub fn is_regression(c: u8) -> bool {
    if (c == CHANGE_BROKE) { return true; }
    if (c == CHANGE_ADDED_BROKEN) { return true; }
    if (c == CHANGE_WORSE) { return true; }
    return false;
}

test ok_is_never_broken {
    assert bucket(HEALTH_OK, false, 0) == BUCKET_OK;
    assert bucket(HEALTH_OK, true, 0) == BUCKET_OK;
    assert is_broken(HEALTH_ABSENT) == false;
}

test a_negative_fixture_is_not_work {
    assert bucket(HEALTH_FAIL, true, 0) == BUCKET_FIXTURE_PARSE;
    assert bucket(HEALTH_WARN, true, 54) == BUCKET_FIXTURE_BACKEND;
    assert is_work(BUCKET_FIXTURE_PARSE) == false;
    assert is_work(BUCKET_FIXTURE_BACKEND) == false;
}

test a_real_spec_splits_by_parse {
    assert bucket(HEALTH_FAIL, false, 0) == BUCKET_REAL_PARSE;
    assert bucket(HEALTH_WARN, false, 368) == BUCKET_REAL_BACKEND;
    assert is_work(BUCKET_REAL_PARSE);
    assert is_work(BUCKET_REAL_BACKEND);
}

test either_marker_makes_a_negative_fixture {
    assert is_negative(true, false);
    assert is_negative(false, true);
    assert is_negative(false, false) == false;
}

test changes_between_builds {
    assert change(HEALTH_FAIL, HEALTH_FAIL) == CHANGE_NONE;
    assert change(HEALTH_FAIL, HEALTH_OK) == CHANGE_FIXED;
    assert change(HEALTH_WARN, HEALTH_OK) == CHANGE_FIXED;
    assert change(HEALTH_OK, HEALTH_WARN) == CHANGE_BROKE;
    assert change(HEALTH_ABSENT, HEALTH_FAIL) == CHANGE_ADDED_BROKEN;
    assert change(HEALTH_ABSENT, HEALTH_OK) == CHANGE_ADDED_OK;
    assert change(HEALTH_WARN, HEALTH_ABSENT) == CHANGE_REMOVED_BROKEN;
    assert change(HEALTH_OK, HEALTH_ABSENT) == CHANGE_REMOVED_OK;
    assert change(HEALTH_WARN, HEALTH_FAIL) == CHANGE_WORSE;
    assert change(HEALTH_FAIL, HEALTH_WARN) == CHANGE_BETTER;
}

test regressions_are_the_ones_to_read {
    assert is_regression(CHANGE_BROKE);
    assert is_regression(CHANGE_ADDED_BROKEN);
    assert is_regression(CHANGE_WORSE);
    assert is_regression(CHANGE_FIXED) == false;
    assert is_regression(CHANGE_REMOVED_BROKEN) == false;
    assert is_regression(CHANGE_BETTER) == false;
}

invariant codes_are_distinct {
    assert HEALTH_OK < HEALTH_WARN;
    assert HEALTH_WARN < HEALTH_FAIL;
    assert HEALTH_FAIL < HEALTH_ABSENT;
    assert BUCKET_OK == 0;
    assert CHANGE_NONE == 0;
}
