// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/unresolved_signature.t27 -- a fn no test reaches whose signature names a struct
; that cannot be laid out, as the reference runs it (gHashTag/t27#6063 lane: StructDecl). Every test here
; passes `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; Zig resolves a fn's parameter and result types only when something analyzed references the fn, so
; `KidTree`, which holds two `KidTree`s by value, refuses nothing while only unreached fns name it: by value, as
; a result, or through a fn that calls another such fn. specs/compiler/optimizer.t27 is the port this
; mirrors (`parser::Node` holds `[MAX_CHILDREN]Node`).
; Not here (the reference cannot compile it): a test that calls `tree_kind`, which makes Zig lay out
; `KidTree` ("struct 'KidTree' depends on itself"), and an undeclared type in an unreached signature, which
; Zig's AstGen refuses in every fn.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceUnresolvedSignature;

const KIDS: usize = 2;

struct KidTree {
    kind: u32,
    kids: [KIDS]KidTree,
}

struct Leaf {
    kind: u32,
    weight: u32,
}

fn tree_kind(t: KidTree) -> u32 {
    return t.kind;
}

fn first_kid_kind(t: KidTree) -> u32 {
    return tree_kind(t.kids[0]);
}

fn tree_of(kind: u32) -> KidTree {
    return KidTree{ kind = kind };
}

fn leaf_score(l: Leaf) -> u32 {
    return l.kind * 10 + l.weight;
}

fn heavier(a: u32, b: u32) -> u32 {
    if (a > b) {
        return a;
    }
    return b;
}

test leaf_score_mixes_kind_and_weight {
    const l = Leaf{ kind = 3, weight = 4 };
    assert(leaf_score(l) == 34);
}

test heavier_picks_the_larger {
    assert(heavier(2, 9) == 9);
    assert(heavier(9, 2) == 9);
}

invariant heavier_is_symmetric {
    assert(heavier(5, 7) == heavier(7, 5));
}
