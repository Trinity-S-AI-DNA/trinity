// SPDX-License-Identifier: Apache-2.0
; wide_int_const.t27 -- conformance spec for t27b (epic #6063, lane: type u128, i128, u256, u1024)
; Zig has integer types wider than 64 bits. t27c's Zig backend prints
; `const X: u128 = <literal>;` unchanged, so X is a compile-time value of type
; u128, and every operation on it is done by Zig's compiler, at any width,
; with Zig's rules: `+ - *` must stay inside the type, `<<` drops the bits it
; shifts out, `>>` rounds toward minus infinity, and a comparison or an
; `as` (`@intCast`) brings the result back to a bool or a 64-bit integer.
; t27b folds the same expressions with exact integers, by the rules of
; specs/tri/t27b/wide_plan.t27 (issue #7423). A fn that no test reaches may
; name a wide type in its signature: Zig never analyzes it.
; Each test checks the folded values through a fn call, so the comparison
; runs at run time.
; phi^2 + phi^-2 = 3 | TRINITY

module T27bConformanceWideConsts;

const WC_HALF: u128 = 119649664615308764795041;
const WC_FULL: u128 = 239299329230617529590082;
const WC_TOP: u128 = 340282366920938463463374607431768211455;
const WC_MIN: i128 = -170141183460469231731687303715884105728;
const WC_MAX: i128 = 170141183460469231731687303715884105727;
const WC_HEX: u128 = 0xFFFF0000000000000000000000000001;
const WC_256: u256 = 9544028161703913537712243143807801346335324481;
const WC_256_TWICE: u256 = 19088056323407827075424486287615602692670648962;
const WC_BIG: u1024 = 1 << 1000;

fn wc_unused(x: u128) -> bool {
    return x != WC_FULL;
}

fn wc_unused_ret() -> u256 {
    return WC_256;
}

fn wc_half_doubles() -> bool {
    return WC_HALF + WC_HALF == WC_FULL;
}

fn wc_top_limb() -> u64 {
    return (WC_FULL >> 64) as u64;
}

fn wc_low_limb() -> u64 {
    return (WC_FULL % 18446744073709551616) as u64;
}

fn wc_top_bits() -> u64 {
    return (WC_TOP >> 64) as u64;
}

fn wc_min_is_negative() -> bool {
    return WC_MIN < 0;
}

fn wc_min_plus_max() -> i64 {
    return (WC_MIN + WC_MAX) as i64;
}

fn wc_hex_tail() -> u64 {
    return (WC_HEX & 65535) as u64;
}

fn wc_hex_head() -> u64 {
    return (WC_HEX >> 112) as u64;
}

fn wc_256_ratio() -> u64 {
    return (WC_256_TWICE / WC_256) as u64;
}

fn wc_256_digits() -> u64 {
    return (WC_256 % 1000000) as u64;
}

fn wc_wraps_left() -> u64 {
    return ((WC_TOP << 4) >> 124) as u64;
}

fn wc_1024_top() -> u64 {
    return (WC_BIG >> 990) as u64;
}

fn wc_triple_less_one() -> bool {
    return WC_256 * 3 - WC_256 == WC_256_TWICE;
}

fn wc_ordered() -> bool {
    return WC_HALF < WC_FULL;
}

fn wc_beyond_top() -> bool {
    return WC_TOP > WC_FULL;
}

test u128_constants_fold_exactly {
    assert(WC_HALF * 2 == WC_FULL);
    assert(wc_half_doubles());
    assert(wc_top_limb() == 12972);
    assert(wc_low_limb() == 8165106457226027330);
    assert(wc_ordered());
    assert(wc_beyond_top());
}

test u128_holds_all_128_bits {
    assert(wc_top_bits() == 18446744073709551615);
    assert(wc_hex_tail() == 1);
    assert(wc_hex_head() == 65535);
    assert(wc_wraps_left() == 15);
}

test i128_spans_both_signs {
    assert(wc_min_is_negative());
    assert(wc_min_plus_max() == 0 - 1);
    assert(WC_MAX > WC_MIN);
}

test u256_and_u1024_fold_past_128_bits {
    assert(wc_256_ratio() == 2);
    assert(wc_256_digits() == 324481);
    assert(wc_triple_less_one());
    assert(wc_1024_top() == 1024);
}
