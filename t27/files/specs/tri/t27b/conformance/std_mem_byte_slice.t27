// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/std_mem_byte_slice.t27 -- `std.mem.eql` and `std.mem.indexOf` on bytes
; written into a buffer, as the reference runs them (gHashTag/t27#6063 lane: ExprCall(std.*)).
; Every test here passes `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; What t27c's Zig backend prints, and so what each shape means:
;   - `buf[a:b]` of a `var buf: [N]u8` is a `[]u8`; `&buf` is a `*[N]u8`. Both coerce to `[]const u8`
;     where `std.mem.eql(u8, x, y)` or `std.mem.indexOf(u8, x, y)` wants one, so they compare by content,
;     exactly like two strings: equal lengths and equal bytes.
;   - The bytes are read when the call runs, so a buffer written again compares by its new content.
; Not here (t27b refuses them): an element type other than `u8`, and a slice of any other element type.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceStdMemByteSlice;

fn put(buf: []u8, pos: usize, s: []const u8) -> usize {
    var i: usize = 0;
    while (i < s.len) {
        buf[pos + i] = s[i];
        i += 1;
    }
    return pos + i;
}

fn same(a: []const u8, b: []const u8) -> bool {
    return std.mem.eql(u8, a, b);
}

test a_written_prefix_equals_its_literal {
    var buf: [16]u8 = undefined;
    const half: usize = put(&buf, 0, "ab");
    const n: usize = put(&buf, half, "cd");
    assert(n == 4);
    assert(std.mem.eql(u8, buf[0:n], "abcd"));
    assert(std.mem.eql(u8, "abcd", buf[0:n]));
}

test a_different_byte_or_length_is_unequal {
    var buf: [16]u8 = undefined;
    const n: usize = put(&buf, 0, "abcd");
    assert(!std.mem.eql(u8, buf[0:n], "abce"));
    assert(!std.mem.eql(u8, buf[0:n], "abc"));
    assert(!std.mem.eql(u8, buf[0:n], "abcde"));
    assert(std.mem.eql(u8, buf[0:0], ""));
    assert(std.mem.eql(u8, buf[1:3], "bc"));
}

test two_buffers_compare_by_content {
    var a: [8]u8 = undefined;
    var b: [8]u8 = undefined;
    const na: usize = put(&a, 0, "xyz");
    const nb: usize = put(&b, 0, "xyz");
    assert(std.mem.eql(u8, a[0:na], b[0:nb]));
    b[2] = 122 - 1;
    assert(!std.mem.eql(u8, a[0:na], b[0:nb]));
}

test a_rewritten_buffer_compares_by_its_new_bytes {
    var buf: [8]u8 = undefined;
    const n: usize = put(&buf, 0, "one");
    assert(std.mem.eql(u8, buf[0:n], "one"));
    const m: usize = put(&buf, 0, "two");
    assert(m == n);
    assert(std.mem.eql(u8, buf[0:n], "two"));
    assert(!std.mem.eql(u8, buf[0:n], "one"));
}

test the_whole_array_by_address {
    var buf: [3]u8 = undefined;
    const n: usize = put(&buf, 0, "hey");
    assert(n == 3);
    assert(std.mem.eql(u8, &buf, "hey"));
    assert(!std.mem.eql(u8, &buf, "he"));
}

test a_slice_passed_to_a_fn_and_searched {
    var buf: [16]u8 = undefined;
    const n: usize = put(&buf, 0, "hello world");
    assert(same(buf[0:n], "hello world"));
    assert(std.mem.indexOf(u8, buf[0:n], "world") != null);
    assert(std.mem.indexOf(u8, buf[0:n], "worlds") == null);
    assert(std.mem.indexOf(u8, "say hello world", buf[0:n]) != null);
}
