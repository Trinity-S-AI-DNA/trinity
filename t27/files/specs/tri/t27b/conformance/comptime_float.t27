// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/comptime_float.t27 -- float literals folded at compile time, as the reference runs
; them (gHashTag/t27#6063 lane: ExprBinary(*), "compile-time float arithmetic on an inexact literal").
; Every test here passes `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; What Zig does with the code t27c prints: an untyped float literal is a comptime_float, an IEEE binary128
; value. Arithmetic on two of them is done in binary128 at compile time, each step rounded to nearest even,
; and the result is rounded to f64 once, where an f64 is needed. A comparison of two of them is a
; comparison of the binary128 values. So `0.1 * 3.0` folds to 0.3, while the same product computed at
; run time in f64 is 0.30000000000000004. And `0.1 + 0.2 != 0.3` holds at compile time even though both
; sides round to the same f64.
; Each test below pairs a folded value with the same arithmetic done at run time, so a fold done in f64
; gets at least one assert wrong.
; Not here: builtins such as @sqrt applied to a comptime_float (Zig computes them in binary128 too), and a
; folded value outside the f64 range.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceComptimeFloat;

const TENTH = 0.1;
const FIFTH = 0.2;
const PI = 3.141592653589793;
const E = 2.718281828459045;
const PHI = 1.618033988749895;

fn add(x: f64, y: f64) -> f64 {
    return x + y;
}

fn mul(x: f64, y: f64) -> f64 {
    return x * y;
}

fn same(b: bool) -> bool {
    return b;
}

fn folded_sum() -> f64 {
    const s: f64 = TENTH + FIFTH;
    return s;
}

fn folded_triple() -> f64 {
    return TENTH * 3.0;
}

fn folded_cancel() -> f64 {
    return 1e16 + 1.0 - 1e16;
}

fn runtime_cancel(big: f64) -> f64 {
    return big + 1.0 - big;
}

fn trinity(n: f64) -> f64 {
    return n * 3.0 * PHI * PI * E;
}

test a_folded_sum_rounds_once {
    assert(folded_sum() == 0.3);
    assert(add(TENTH, FIFTH) != 0.3);
}

test a_folded_product_rounds_once {
    assert(folded_triple() == 0.3);
    assert(mul(TENTH, 3.0) != 0.3);
    const sq: f64 = 0.7 * 0.7;
    assert(sq == 0.49);
    assert(mul(0.7, 0.7) < 0.49);
}

test a_folded_cancellation_keeps_the_one {
    assert(folded_cancel() == 1.0);
    assert(runtime_cancel(1e16) == 0.0);
}

test comptime_floats_compare_in_binary128 {
    assert(same(TENTH + FIFTH != 0.3));
    assert(same(TENTH + FIFTH > 0.3));
    const s: f64 = TENTH + FIFTH;
    assert(add(s, 0.0) == 0.3);
}

test a_folded_reciprocal_differs_in_the_last_bit {
    const p = 1.61803398875;
    const g: f64 = 1.0 / (p * p * p);
    assert(g < 1.0 / mul(mul(1.61803398875, 1.61803398875), 1.61803398875));
}

test a_folded_product_can_match_its_runtime_twin {
    const expected = 1.0 * 3.0 * PHI * PI * E;
    assert(trinity(1.0) == expected);
    assert(trinity(2.0) == 2.0 * trinity(1.0));
}
