// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/brace_invariant.t27 -- a brace-form invariant whose statement is a bare
; predicate, as the reference runs it (gHashTag/t27#6063 lane: ExprBinary(value ignored) statement).
; Every invariant and test here passes `t27c test-report`; t27b must give the same verdict on each, or
; refuse the file.
; What t27c's Zig backend prints (#6315, gen_invariant_block): an invariant is a container-level
; `comptime { ... }` block, and each top-level statement of a brace invariant that is a predicate is
; emitted as `assert(<expr>)`, the way the clause form `invariant i: expr;` already was. A predicate is
; a binary or unary expression, a name, an index, a field access, the literal `true` or `false`, or a
; call to a module fn declared `-> bool`. Any other statement keeps its own form: `assert(...)` stays an
; assert, and a call to a void fn is an action that runs.
; So a false predicate fails the invariant: in the reference at compile time (the comptime assert),
; in t27b when the invariant runs. Both are a failed file, never a pass.
; Not here (the reference cannot compile them): a predicate that is not bool (`{ N + 1 }`), a bare
; non-bool literal (`{ 3 }`), and a predicate nested in an `if` (only top-level statements are
; wrapped). A bare call to a fn returning a non-bool value is not a predicate: the reference
; discards its value, which is the ExprCall(value ignored) family. A negated comparison `!(MAX == 8)` is also not here: the reference prints it as
; `!MAX == 8` and Zig refuses it (#6549, the same dropped parentheses as unary minus).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceBraceInvariant;

const MAX: u32 = 9;
const ON: bool = true;
const FLAGS: [3]bool = [false, true, true];

fn ready() -> bool {
    return true;
}

fn sum_to(n: u32) -> u32 {
    var s: u32 = 0;
    var i: u32 = 1;
    while (i <= n) {
        s += i;
        i += 1;
    }
    return s;
}

fn note() {
    var k: u32 = 0;
    k += 1;
}

invariant a_comparison_is_asserted { MAX == 9 }

invariant arithmetic_on_both_sides { MAX * 2 == sum_to(3) + 12 }

invariant a_bool_name_is_asserted { ON }

invariant a_negation_is_asserted { !FLAGS[0] }

invariant an_index_is_asserted { FLAGS[1] }

invariant the_literal_true_is_asserted { true }

invariant a_bool_fn_call_is_asserted { ready() }

invariant connectives_are_one_predicate { MAX > 8 and ON or FLAGS[0] }

invariant every_statement_is_checked {
    MAX > 8;
    MAX < 10;
    sum_to(4) == 10;
}

invariant an_assert_stays_an_assert {
    assert(MAX != 0);
    MAX % 3 == 0;
}

invariant a_void_call_is_an_action {
    note();
    sum_to(MAX) == 45;
}

test the_predicates_hold_at_run_time {
    assert(sum_to(3) + 12 == 18);
    assert(sum_to(4) == 10);
    assert(sum_to(MAX) == 45);
    assert(ready());
    assert(FLAGS[1] and !FLAGS[0]);
}
