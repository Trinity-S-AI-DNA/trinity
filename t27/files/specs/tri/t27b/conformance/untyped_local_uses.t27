// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/untyped_local_uses.t27 -- more locals declared with no type, as the reference
; runs them (gHashTag/t27#6063 lane: StmtLocal, #6998). Every test here passes `t27c test-report`; t27b
; must give the same verdict on each, or refuse the file.
; untyped_local.t27 holds the rule for a bare integer literal: the reference prints `var i = 0;` as
; `var i: u32 = 0;`, and as u64 when the literal does not fit in u32. This file adds what it does not run:
; an untyped var copied from a typed name (`var y = x;` keeps x's type, here f64), an untyped counter
; inside an f64 fn, an untyped var passed to a fn that takes u32 and assigned its result, and an unread
; `const scratch = undefined;` in a test body instead of a fn body.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceUntypedLocalUses;

fn double_it(x: u32) -> u32 {
    return x * 2;
}

fn heron(x: f64) -> f64 {
    if (x <= 0.0) {
        return 0.0;
    }
    var y = x;
    var n = 0;
    while (n < 40) {
        y = (y + x / y) / 2.0;
        n = n + 1;
    }
    return y;
}

fn passed_and_reassigned() -> u32 {
    var v = 21;
    v = double_it(v);
    v = double_it(v);
    return v;
}

test an_untyped_copy_of_an_f64_stays_f64 {
    const r = heron(2.0);
    assert(r > 1.41421 and r < 1.41422);
    assert(heron(0.0) == 0.0);
    assert(heron(9.0) == 3.0);
}

test an_untyped_var_is_passed_as_u32 {
    assert(passed_and_reassigned() == 84);
}

test an_unread_undefined_const_in_a_test {
    const scratch = undefined;
    assert(double_it(4) == 8);
}
