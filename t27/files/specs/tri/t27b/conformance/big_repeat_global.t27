// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/big_repeat_global.t27 -- module-level vars and constants initialized by an array
; repeat of more than 65536 elements, as the reference runs them (gHashTag/t27#7376, Part of #5980). Every test
; here passes `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; t27c's Zig backend prints `[_]T{ v } ** n` unchanged, so Zig evaluates the elements once and repeats them n
; times, with no limit below the array's length. t27b used to write such a repeat out as an n-element literal and
; refused one over 65536 elements, which capped the self-hosted core's buffers. It now fills the elements once
; and copies those bytes over the rest of the array.
; Not here: a repeat inside a constant that holds strings (still written out element by element, and still
; capped), and a repeat whose total is not the array's length (Zig refuses it).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceBigRepeatGlobal;

const BIG: usize = 262144;
const PAIRS: usize = 100000;

var bytes: [BIG]u8 = [_]u8{0} ** BIG;
var words: [300000]u32 = [_]u32{7} ** 300000;
var halves: [200000]u16 = [_]u16{ 1, 2 } ** PAIRS;
const THREES: [100000]u8 = [_]u8{3} ** 100000;

fn sum_bytes(xs: []const u8) -> u64 {
    var s: u64 = 0;
    var i: usize = 0;
    while (i < xs.len) {
        s = s + xs[i];
        i = i + 1;
    }
    return s;
}

fn sum_halves() -> u64 {
    var s: u64 = 0;
    var i: usize = 0;
    while (i < halves.len) {
        s = s + halves[i];
        i = i + 1;
    }
    return s;
}

test zero_bytes_past_the_old_cap {
    assert(bytes.len == 262144);
    assert(bytes[0] == 0);
    assert(bytes[65536] == 0);
    assert(bytes[262143] == 0);
    assert(sum_bytes(&bytes) == 0);
}

test bytes_are_writable_at_the_far_end {
    bytes[262143] = 9;
    bytes[70000] = 4;
    assert(bytes[262143] == 9);
    assert(bytes[262142] == 0);
    assert(sum_bytes(&bytes) == 13);
}

test one_word_repeated {
    assert(words.len == 300000);
    assert(words[0] == 7);
    assert(words[65536] == 7);
    assert(words[299999] == 7);
}

test two_halves_repeated {
    assert(halves[0] == 1);
    assert(halves[1] == 2);
    assert(halves[131072] == 1);
    assert(halves[199999] == 2);
    assert(sum_halves() == 300000);
}

test constant_repeat {
    assert(THREES[99999] == 3);
    assert(sum_bytes(&THREES) == 300000);
}
