// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/scoped_gf16.t27 -- a GF16 type written through its module, `gf16::GF16`, as the
; reference runs it (gHashTag/t27#6063 lane: type gf16::GF16). Every test here passes `t27c test-report`;
; t27b must give the same verdict on each, or refuse the file.
; A declaration spliced in by `use` keeps its module path. t27c's Zig type mapper (#6533) writes a scoped path
; whose last segment it maps on its own as that mapping, so `gf16::GF16` is `u16` wherever the mapper runs: a
; struct field, a parameter, a result, a local's annotation, and the element of a slice, an array or an
; optional built around it.
; Not here (the reference cannot compile it): `@as(gf16::GF16, x)`, whose type argument is printed as the
; value `gf16.GF16`, and `*gf16::GF16`, which the mapper turns into a plain `u16`.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceScopedGf16;

struct Halves {
    pair: [2]gf16::GF16,
    first: gf16::GF16,
    spare: ?gf16::GF16,
}

fn bump(x: gf16::GF16) -> gf16::GF16 {
    return x + 1024;
}

fn sum_all(xs: []gf16::GF16) -> gf16::GF16 {
    var s: gf16::GF16 = 0;
    for (xs) |x| {
        s = s + x;
    }
    return s;
}

fn has_spare(h: Halves) -> bool {
    return h.spare != null;
}

test scoped_param_and_result {
    const one: gf16::GF16 = 15360;
    const two: gf16::GF16 = bump(one);
    assert(two == 16384);
    assert(bump(0) == 1024);
}

test scoped_slice_element {
    var xs: [3]u16 = [3]u16{ 1, 2, 3 };
    xs[2] = 40;
    assert(sum_all(xs[0..3]) == 43);
    assert(sum_all(xs[1..2]) == 2);
}

test scoped_fields {
    const h = Halves{ .pair = [2]u16{ 15360, 16384 }, .first = 15360, .spare = null };
    const k = Halves{ .pair = [2]u16{ 0, 0 }, .first = 0, .spare = 17408 };
    assert(h.pair[1] == 16384);
    assert(h.first == 15360);
    assert(has_spare(h) == false);
    assert(has_spare(k) == true);
}
