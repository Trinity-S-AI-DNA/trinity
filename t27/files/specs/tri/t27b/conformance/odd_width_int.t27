// SPDX-License-Identifier: Apache-2.0
; odd_width_int.t27 -- conformance spec for t27b (epic #6063, lane: type u1, odd integer widths)
; Zig has an integer type of every width: `u1`, `i2`, `u4`, `u21`. t27c's
; Zig backend prints these spellings unchanged. A value of one is held like
; a u8: in a 32-bit register, zero-extended (unsigned) or sign-extended
; (signed), and checked against its own range after each `+ - *`.
; These tests pin down the range of each width at both ends, the wrapping
; operators, `~` on a narrow unsigned type, shifts that drop the bits that
; leave the type, products that pass 2^32 before they are checked, widening
; into wider types, `as` casts out of an odd width, and struct fields of odd
; widths. (t27c's `as` names only the standard widths as a target.)
; phi^2 + phi^-2 = 3 | TRINITY

module T27bConformanceOddWidthInts;

const OddNib = struct {
    lo: u4,
    hi: u4,
    sign: i2,
    flag: u1,
};

const OddWidePoint = struct {
    cp: u21,
    plane: u5,
};

fn bit_on() -> u1 {
    return 1;
}

fn bit_flip(b: u1) -> u1 {
    return 1 - b;
}

fn nib_add(a: u4, b: u4) -> u4 {
    return a + b;
}

fn nib_wrap_add(a: u4, b: u4) -> u4 {
    return a +% b;
}

fn nib_wrap_sub(a: u4, b: u4) -> u4 {
    return a -% b;
}

fn nib_wrap_mul(a: u4, b: u4) -> u4 {
    return a *% b;
}

fn nib_not(a: u4) -> u4 {
    return ~a;
}

fn nib_shl1(a: u4) -> u4 {
    return a << 1;
}

fn nib_shr2(a: u4) -> u4 {
    return a >> 2;
}

fn tri_neg(a: i2) -> i2 {
    return 0 - a;
}

fn tri_sum(a: i2, b: i2) -> i2 {
    return a + b;
}

fn cp_mul(a: u21, b: u21) -> u21 {
    return a * b;
}

fn cp_div(a: u21, b: u21) -> u21 {
    return a / b;
}

fn cp_rem(a: u21, b: u21) -> u21 {
    return a % b;
}

fn big_mul(a: u31, b: u31) -> u31 {
    return a * b;
}

fn wide_neg_mul(a: i21, b: i21) -> i21 {
    return a * b;
}

fn nib_to_u8(a: u4) -> u8 {
    const w: u8 = a;
    return w + 200;
}

fn tri_to_i32(a: i2) -> i32 {
    const w: i32 = a;
    return w * 1000;
}

fn cp_to_u32(x: u21) -> u32 {
    return x as u32;
}

fn cp_plane(x: u21) -> u32 {
    return (x >> 16) as u32;
}

fn count_nibbles(n: u32) -> u4 {
    var c: u4 = 0;
    var i: u32 = 0;
    while (i < n) {
        c = c +% 1;
        i = i + 1;
    }
    return c;
}

fn pack(lo: u4, hi: u4, s: i2, f: u1) -> OddNib {
    return OddNib{ .lo = lo, .hi = hi, .sign = s, .flag = f };
}

fn nib_value(n: OddNib) -> u8 {
    const lo: u8 = n.lo;
    const hi: u8 = n.hi;
    return hi * 16 + lo;
}

fn locate(cp: u21, plane: u5) -> OddWidePoint {
    return OddWidePoint{ .cp = cp, .plane = plane };
}

fn plane_matches(p: OddWidePoint) -> bool {
    const want: u32 = p.plane;
    return cp_plane(p.cp) == want;
}

test u1_holds_zero_and_one {
    assert(bit_on() == 1);
    assert(bit_flip(bit_on()) == 0);
    assert(bit_flip(0) == 1);
    assert(bit_flip(1) < bit_on());
}

test u4_range_at_both_ends {
    assert(nib_add(7, 8) == 15);
    assert(nib_add(0, 0) == 0);
    assert(nib_add(14, 1) == 15);
    assert(nib_wrap_add(15, 1) == 0);
    assert(nib_wrap_add(9, 9) == 2);
    assert(nib_wrap_sub(0, 1) == 15);
    assert(nib_wrap_sub(3, 5) == 14);
    assert(nib_wrap_mul(5, 7) == 3);
    assert(nib_wrap_mul(15, 15) == 1);
}

test u4_not_and_shifts_stay_in_four_bits {
    assert(nib_not(0) == 15);
    assert(nib_not(15) == 0);
    assert(nib_not(5) == 10);
    assert(nib_shl1(9) == 2);
    assert(nib_shl1(7) == 14);
    assert(nib_shr2(15) == 3);
    assert(nib_shr2(3) == 0);
}

test i2_is_minus_two_to_one {
    assert(tri_neg(1) == 0 - 1);
    assert(tri_neg(0 - 1) == 1);
    assert(tri_neg(0) == 0);
    assert(tri_sum(0 - 1, 0 - 1) == 0 - 2);
    assert(tri_sum(1, 0 - 2) == 0 - 1);
    assert(tri_sum(0 - 2, 1) < 0);
}

test u21_holds_every_code_point {
    assert(cp_mul(1000, 1000) == 1000000);
    assert(cp_mul(1114111, 1) == 1114111);
    assert(cp_mul(2097151, 1) == 2097151);
    assert(cp_div(1114111, 65536) == 16);
    assert(cp_rem(1114111, 65536) == 65535);
    assert(cp_to_u32(1114111) == 1114111);
    assert(cp_to_u32(2097151) + 1 == 2097152);
    assert(cp_plane(1114111) == 16);
    assert(cp_plane(65535) == 0);
}

test products_near_the_top_of_31_and_21_bits {
    assert(big_mul(46340, 46340) == 2147395600);
    assert(big_mul(2147483647, 1) == 2147483647);
    assert(wide_neg_mul(0 - 1024, 1023) == 0 - 1047552);
    assert(wide_neg_mul(0 - 1024, 1024) == 0 - 1048576);
    assert(wide_neg_mul(0 - 1, 0 - 1048575) == 1048575);
}

test odd_widths_widen_into_wider_types {
    assert(nib_to_u8(15) == 215);
    assert(nib_to_u8(0) == 200);
    assert(tri_to_i32(0 - 2) == 0 - 2000);
    assert(tri_to_i32(1) == 1000);
}

test a_u4_counter_wraps_every_sixteen {
    assert(count_nibbles(15) == 15);
    assert(count_nibbles(16) == 0);
    assert(count_nibbles(35) == 3);
}

test struct_fields_of_odd_widths {
    const n = pack(10, 12, 0 - 2, 1);
    assert(n.lo == 10);
    assert(n.hi == 12);
    assert(n.sign == 0 - 2);
    assert(n.flag == 1);
    assert(nib_value(n) == 202);
    const p = locate(1114111, 16);
    assert(p.cp == 1114111);
    assert(p.plane == 16);
    assert(plane_matches(p));
    const q = locate(128512, 31);
    assert(q.plane == 31);
    assert(!plane_matches(q));
}
