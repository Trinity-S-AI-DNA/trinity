// SPDX-License-Identifier: Apache-2.0
; anonymous_struct.t27 -- conformance spec for t27b (epic #6063, lane: type (anonymous struct))
; A fn may return `struct { a: T, b: U }`, a type with no name of its own.
; t27c's Zig backend prints that spelling as the fn's result type, and the
; fn builds its value with an anonymous literal `.{ .a = .., .b = .. }`.
; These tests pin down that each field keeps its own value: scalars side by
; side, a string, a named struct and an array as fields, a result held in a
; var and written through, and one fn's result passed on to another.
; phi^2 + phi^-2 = 3 | TRINITY

module T27bConformanceAnonymousStruct;

const Spot = struct {
    x: i32,
    y: i32,
};

fn divmod(a: u32, b: u32) -> struct { q: u32, r: u32 } {
    return .{ .q = a / b, .r = a % b };
}

fn classify(n: i32) -> struct { neg: bool, mag: i32, label: []const u8 } {
    if (n < 0) {
        return .{ .neg = true, .mag = 0 - n, .label = "negative" };
    }
    return .{ .neg = false, .mag = n, .label = "zero or more" };
}

fn nudged(p: Spot, d: i32) -> struct { at: Spot, moved: bool } {
    return .{ .at = Spot{ .x = p.x + d, .y = p.y - d }, .moved = d != 0 };
}

fn head_pair(xs: [4]u8) -> struct { pair: [2]u8, total: u32, } {
    var t: u32 = 0;
    for (xs) |x| {
        t = t + x;
    }
    return .{ .pair = [2]u8{ xs[0], xs[1] }, .total = t };
}

// The quotient bumped once through a var holding the result.
fn bumped(a: u32, b: u32) -> u32 {
    var d = divmod(a, b);
    d.q = d.q + 1;
    return d.q * 10 + d.r;
}

// One fn's result read by another.
fn recombine(a: u32, b: u32) -> u32 {
    const d = divmod(a, b);
    return d.q * b + d.r;
}

test scalar_fields_side_by_side {
    const d = divmod(17, 5);
    assert(d.q == 3);
    assert(d.r == 2);
    const e = divmod(4, 4);
    assert(e.q == 1);
    assert(e.r == 0);
    assert(recombine(29, 6) == 29);
}

test a_string_field {
    const c = classify(0 - 7);
    assert(c.neg);
    assert(c.mag == 7);
    assert(c.label.len == 8);
    const z = classify(0);
    assert(!z.neg);
    assert(z.mag == 0);
    assert(z.label.len == 12);
}

test struct_and_array_fields {
    const m = nudged(Spot{ .x = 3, .y = 10 }, 4);
    assert(m.at.x == 7);
    assert(m.at.y == 6);
    assert(m.moved);
    assert(!nudged(m.at, 0).moved);
    const h = head_pair([4]u8{ 9, 8, 7, 6 });
    assert(h.pair[0] == 9);
    assert(h.pair[1] == 8);
    assert(h.total == 30);
}

test a_result_written_through_a_var {
    assert(bumped(17, 5) == 42);
    assert(bumped(3, 7) == 13);
}
