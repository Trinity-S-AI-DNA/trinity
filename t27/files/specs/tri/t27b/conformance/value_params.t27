// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/value_params.t27 -- array and struct parameters and locals the body assigns,
; as the reference runs them (gHashTag/t27#6063 lane: StmtAssign, assignment through a constant). Every test
; here passes `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; What t27c's Zig backend prints: a parameter the body assigns is renamed `<name>_arg`, and the body opens
; with `var <name> = <name>_arg;`. So an array or struct parameter is the callee's own copy: writing an
; element or a field never reaches the caller. A `let` or `const` local the body assigns is declared `var`.
; A name counts as assigned when a statement assigns it whole (`p = ...`), one element of it
; (`p[i] = ...`) or one field of it (`p.f = ...`), at the top of the body or inside if / while / for.
; Not here (the reference cannot compile them): a parameter written only deeper (`p.a[i] = ...`,
; `p[i].f = ...`), which keeps it a constant, and a slice or pointer parameter, whose copy is never mutated.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceValueParams;

struct ValPair {
    a: i64,
    b: i64,
}

struct HitCounter {
    hits: [4]u32,
    len: usize,
}

fn bump_first(xs: [4]u32) -> u32 {
    xs[0] = xs[0] + 10;
    return xs[0] + xs[1] + xs[2] + xs[3];
}

fn swap(p: ValPair) -> ValPair {
    const t = p.a;
    p.a = p.b;
    p.b = t;
    return p;
}

fn add_to_b(p: ValPair, k: i64) -> i64 {
    p.b += k;
    return p.a + p.b;
}

fn fill(xs: [4]u32, v: u32) -> u32 {
    var i: usize = 0;
    while (i < 4) {
        if (xs[i] < v) {
            xs[i] = v;
        }
        i += 1;
    }
    return xs[0] + xs[1] + xs[2] + xs[3];
}

fn replace(p: ValPair) -> i64 {
    p = ValPair { a: 7, b: 8 };
    return p.a * p.b;
}

fn record(c: HitCounter, h: u32) -> HitCounter {
    c.len += 1;
    c.hits[c.len - 1] = h;
    return c;
}

fn make(a: i64) -> ValPair {
    return ValPair { a: a, b: 0 };
}

fn first_hit(c: HitCounter) -> u32 {
    return c.hits[0];
}

test array_element_write_stays_local {
    const xs: [4]u32 = [1, 2, 3, 4];
    assert(bump_first(xs) == 20);
    assert(xs[0] == 1);
}

test struct_field_write_stays_local {
    const p = ValPair { a: 1, b: 2 };
    const q = swap(p);
    assert(q.a == 2);
    assert(q.b == 1);
    assert(p.a == 1);
    assert(p.b == 2);
}

test compound_field_assignment {
    const p = ValPair { a: 3, b: 4 };
    assert(add_to_b(p, 5) == 12);
    assert(p.b == 4);
}

test writes_inside_a_loop {
    const xs: [4]u32 = [5, 1, 9, 2];
    assert(fill(xs, 4) == 22);
    assert(xs[1] == 1);
}

test whole_parameter_reassigned {
    const p = ValPair { a: 1, b: 1 };
    assert(replace(p) == 56);
    assert(p.a == 1);
}

test nested_write_after_a_field_write {
    var c = HitCounter { hits: [0, 0, 0, 0], len: 0 };
    const d = record(c, 9);
    const e = record(d, 11);
    assert(e.len == 2);
    assert(e.hits[1] == 11);
    assert(first_hit(e) == 9);
    assert(c.len == 0);
    assert(d.len == 1);
}

test let_struct_from_a_call_is_writable {
    let p = make(4);
    p.b = 6;
    assert(p.a + p.b == 10);
}

test const_struct_literal_written_in_a_loop {
    const p = ValPair { a: 0, b: 0 };
    var i: i64 = 0;
    while (i < 3) {
        p.a += i;
        i += 1;
    }
    assert(p.a == 3);
}

test typed_let_array_element_write {
    let xs: [3]u32 = [1, 2, 3];
    xs[2] = 10;
    assert(xs[0] + xs[1] + xs[2] == 13);
}

test a_copy_is_not_an_alias {
    const p = ValPair { a: 1, b: 2 };
    let q = p;
    q.a = 50;
    assert(p.a == 1);
    assert(q.a == 50);
}
