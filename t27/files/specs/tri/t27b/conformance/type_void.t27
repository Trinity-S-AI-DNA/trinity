// SPDX-License-Identifier: Apache-2.0
; type_void.t27 -- conformance spec for t27b (epic #6063, lane: type void)
; `void` is Zig's zero-bit type. Ported specs use it for plumbing they do not
; model: a parameter that only stands in for an allocator, a struct field
; that holds nothing, a pointer to such a field. Its one value is
; `undefined`. These tests pin down that a `void` takes no room: the fields
; around it keep their own values, an array of structs that hold one keeps
; its stride, and a `void` parameter or `*void` argument leaves the other
; arguments where they were.
; phi^2 + phi^-2 = 3 | TRINITY

module T27bConformanceTypeVoid;

const Handle = struct {
    before: u32,
    ctx: void,
    after: u32,
};

const Slot = struct {
    tag: void,
    lo: u8,
    hi: u16,
};

// The allocator is plumbing: nothing reads it.
fn larger(alloc: void, a: u32, b: u32) -> u32 {
    if (a > b) {
        return a;
    }
    return b;
}

// A pointer to a `void` field, passed before the values that matter.
fn through(p: *void, x: u32, y: u32) -> u32 {
    return x * 100 + y;
}

fn make(b: u32, a: u32) -> Handle {
    return Handle{ .before = b, .ctx = undefined, .after = a };
}

// Each slot's own lo and hi, summed in order: a stride error mixes them.
fn weigh(slots: [3]Slot) -> u32 {
    var t: u32 = 0;
    var i: usize = 0;
    while (i < 3) {
        t = t * 10 + slots[i].lo;
        t = t * 10 + slots[i].hi;
        i = i + 1;
    }
    return t;
}

// Never called: its signature alone names `*void`.
fn unused(alloc: *void, n: u32) -> u32 {
    return n + 1;
}

test fields_around_a_void_keep_their_values {
    var h = make(7, 9);
    assert(h.before == 7);
    assert(h.after == 9);
    h.after = h.after + h.before;
    assert(h.after == 16);
    assert(h.before == 7);
}

test a_void_parameter_leaves_the_others {
    assert(larger(undefined, 3, 8) == 8);
    assert(larger(undefined, 8, 3) == 8);
    assert(larger(undefined, 5, 5) == 5);
}

test a_pointer_to_a_void_field {
    var h = make(1, 2);
    h.before = 4;
    assert(through(&h.ctx, h.before, h.after) == 402);
}

test an_array_of_structs_with_a_void_field {
    const s = [3]Slot{
        Slot{ .tag = undefined, .lo = 1, .hi = 2 },
        Slot{ .tag = undefined, .lo = 3, .hi = 4 },
        Slot{ .tag = undefined, .lo = 5, .hi = 6 },
    };
    assert(weigh(s) == 123456);
}
