// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/cmp_out_of_range.t27 -- a run-time integer compared with a comptime_int its type
; cannot hold, as the reference runs it (gHashTag/t27#6063 lane: literal out of range). Every test here passes
; `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; Zig does not coerce the literal to the operand's type here: it knows the answer at compile time. A u32 is
; always below `1 << 32`, never equal to it, and an i8 is always above -200. The run-time side is still
; evaluated, so a call in it runs. An `assert` whose condition is such a comparison is settled at compile
; time and executes no run-time check, so each test also asserts something only a run can decide.
; Not here: arithmetic with such a literal (`x + (1 << 32)`), which Zig refuses.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceCmpOutOfRange;

const Reg = struct {
    shift_reg: u32,
};

fn below_two_to_32(x: u32) -> bool {
    return x < (1 << 32);
}

fn at_most(x: u32) -> bool {
    return x <= 4294967296;
}

fn equals_two_to_32(x: u32) -> bool {
    return x == (1 << 32);
}

fn differs_from_two_to_32(x: u32) -> bool {
    return x != (1 << 32);
}

fn above(x: u8) -> bool {
    return x > 256;
}

fn literal_on_the_left(x: u16) -> bool {
    return 70000 > x;
}

fn signed_above(x: i8) -> bool {
    return x > -200;
}

fn signed_below(x: i8) -> bool {
    return x < -129;
}

fn fits(r: Reg) -> bool {
    return r.shift_reg < (1 << 32);
}

var calls: u32 = 0;

fn bump() -> u32 {
    calls = calls + 1;
    return calls;
}

test unsigned_is_always_below_a_larger_literal {
    assert(below_two_to_32(0));
    assert(below_two_to_32(4294967295));
    assert(at_most(4294967295));
    assert(!above(255));
    assert(literal_on_the_left(65535));
}

test never_equal_to_a_literal_it_cannot_hold {
    assert(!equals_two_to_32(4294967295));
    assert(differs_from_two_to_32(0));
}

test signed_against_a_literal_below_its_range {
    assert(signed_above(-128));
    assert(!signed_below(-128));
}

test the_run_time_side_is_still_evaluated {
    assert(bump() < (1 << 32));
    assert(bump() != (1 << 40));
    assert(calls == 2);
}

test a_field_against_a_wide_literal {
    const r = Reg{ .shift_reg = 4294967295 };
    assert(fits(r));
    assert(r.shift_reg == 4294967295);
}
