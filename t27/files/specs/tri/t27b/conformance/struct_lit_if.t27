// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/struct_lit_if.t27 -- an `if` expression as a struct literal's field value, as the
; reference runs it (gHashTag/t27#6063 lane: ExprIf(left operand)). Every test here passes `t27c test-report`;
; t27b must give the same verdict on each, or refuse the file.
; The parser keeps `.f = <value>` as a field-access node named `f` holding the value, which is the shape of
; `<value>.f` too. gen-zig prints the first as `.f = <value>,`: the comma ends an `if` there, so
; `.on = if (c) true else false,` keeps its meaning. Only the second form, `(if (c) a else b).f`, loses its
; parentheses in print.
; Not here (the reference cannot compile it): `(if (c) 1 else 2) + 1`, printed as `if (c) 1 else 2 + 1`.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceStructLitIf;

struct Leds {
    red: bool,
    green: bool,
    level: u32,
}

fn leds_for(acc: [4]i32) -> Leds {
    return Leds{
        .red = if (acc[0] == 0) true else false,
        .green = if (acc[1] == 0) true else false,
        .level = if (acc[2] > 3) 2 else 1,
    };
}

fn level_after(acc: [4]i32) -> u32 {
    const l = Leds{ .red = false, .green = true, .level = if (acc[3] < 0) 7 else 9 };
    return l.level + 1;
}

test if_values_in_a_returned_literal {
    const a: [4]i32 = [0, 1, 5, 0];
    const l = leds_for(a);
    assert(l.red == true);
    assert(l.green == false);
    assert(l.level == 2);
}

test if_values_take_the_other_arm {
    const a: [4]i32 = [3, 0, 2, 0];
    const l = leds_for(a);
    assert(l.red == false);
    assert(l.green == true);
    assert(l.level == 1);
}

test if_value_in_a_local_literal {
    const a: [4]i32 = [0, 0, 0, -4];
    const b: [4]i32 = [0, 0, 0, 4];
    assert(level_after(a) == 8);
    assert(level_after(b) == 10);
}
