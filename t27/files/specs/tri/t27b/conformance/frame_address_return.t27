// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/frame_address_return.t27 -- a fn that returns the address of a local of its own
; frame, in the shape of specs/port/trinity/src/tri/gen_canvas.t27 (gHashTag/t27#7550): a struct whose slice
; field points into a local array of the fn that builds it.
; gen-zig prints it as written (`return FrameEscapeView{ .cells = cells[0 .. n], ... };`). In Zig that slice
; dangles once the fn returns. The test below passes `t27c test-report` only because it reads the bytes right
; after the return, before any other call reuses the dead frame. With a call in between that fills a 4 KiB
; array of its own, the same read sees what that call left there: 0, not 7 (zig 0.16).
; t27b refuses the file as ExprReturn(frame address), the verdict its ledger records as reference-bug ("the
; reference passes it for the wrong reason; t27b is right not to"). Before #7550 t27b took it: its
; interpreter faulted on the read ("1-byte access ... is outside every live slot") while its JIT read the
; stale stack, a JIT/interpreter mismatch. The frame is 4 KiB, so frame size plays no part.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceFrameAddressReturn;

pub const FrameEscapeView = struct {
    cells: []u8,
    n: usize,
};

// Fill the first n cells of a local array and hand back a slice of them.
pub fn frame_escape_view(n: usize) -> FrameEscapeView {
    var cells: [4096]u8 = undefined;
    var i: usize = 0;
    while (i < n) {
        cells[i] = 7;
        i += 1;
    }
    return FrameEscapeView{ .cells = cells[0..n], .n = n };
}

test frame_escape_read_after_return {
    var v = frame_escape_view(8);
    assert(v.n == 8);
    assert(v.cells[0] == 7);
}
