// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/const_optional.t27 -- module-level constants that hold an optional, as the
; reference runs them (gHashTag/t27#6063 lane: ConstDecl(?T), issue #7116). Every test here passes
; `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; A `?T` constant is either `null` or a value of `T`. It may stand alone, sit in a field of a struct
; constant (with or without `str` fields beside it), come from a field default, or copy another optional
; constant. A present zero is still present: `0` is not `null`.
; Not here: `?str` (an optional string), and an array whose element type is `?T` (`[2]?u16` does not
; parse).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceConstOptional;

const LIMIT: ?u32 = 40;
const NO_LIMIT: ?u32 = null;
const ZERO: ?u8 = 0;
const SAME: ?u32 = LIMIT;

const OptionalRow = struct {
    name: str,
    want: ?usize,
    cap: ?u8 = null,
};

const ROWS: [3]OptionalRow = [
    OptionalRow{ .name = "two", .want = 2 },
    OptionalRow{ .name = "none", .want = null, .cap = 7 },
    OptionalRow{ .name = "zero", .want = 0, .cap = 0 },
];

const Span = struct {
    lo: ?i32,
    hi: ?i32,
};

const SPAN: Span = Span{ .lo = -3, .hi = null };

fn or_else(x: ?usize, d: usize) -> usize {
    if (x != null) {
        return x.?;
    }
    return d;
}

fn u32_or(x: ?u32, d: u32) -> u32 {
    if (x != null) {
        return x.?;
    }
    return d;
}

fn u8_or(x: ?u8, d: u8) -> u8 {
    if (x != null) {
        return x.?;
    }
    return d;
}

fn pinned(x: ?u8) -> bool {
    return x != null;
}

test scalar_optional_constants {
    assert(u32_or(LIMIT, 1) == 40);
    assert(u32_or(NO_LIMIT, 1) == 1);
    assert(u8_or(ZERO, 9) == 0);
    assert(u32_or(SAME, 2) == 40);
    assert(LIMIT != null);
    assert(LIMIT.? == 40);
    assert(NO_LIMIT == null);
    assert(ZERO != null);
    assert(ZERO.? == 0);
}

test optional_fields_beside_strings {
    assert(ROWS[0].name == "two");
    assert(ROWS[0].want.? == 2);
    assert(ROWS[0].cap == null);
    assert(ROWS[1].want == null);
    assert(ROWS[1].cap.? == 7);
    assert(ROWS[2].want.? == 0);
    assert(ROWS[2].cap != null);
}

test rows_through_a_loop_and_parameters {
    var total: usize = 0;
    var caps: u32 = 0;
    var i: usize = 0;
    while (i < ROWS.len) {
        const r = ROWS[i];
        total = total + or_else(r.want, 10);
        if (pinned(r.cap)) {
            caps = caps + 1;
        }
        i = i + 1;
    }
    assert(total == 12);
    assert(caps == 2);
}

test optional_fields_without_strings {
    assert(SPAN.lo != null);
    assert(SPAN.lo.? == -3);
    assert(SPAN.hi == null);
    assert(or_else(null, 5) == 5);
}
