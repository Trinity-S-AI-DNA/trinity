// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/builtin_abs_max_min_pi.t27 -- `@abs`, `@max`, `@min` and `std.math.pi` /
; `std.math.e`, as the reference runs them (gHashTag/t27#6063 lane 4: ExprCall(@max), ExprFieldAccess).
; Every test here passes `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; gen-zig prints all of them as written.
; - `@abs` of an f64 or f32 is the magnitude: `-0.0` gives `+0.0`, an infinity gives `+inf`, a NaN stays a NaN.
; - `@max(a, b)` / `@min(a, b)` of two floats of one type: a NaN operand gives the other operand, and equal
;   operands give a value equal to both. Which sign `-0.0` against `+0.0` gives is not tested: Zig 0.16 leaves
;   it to the target (x86_64 gives the first operand, aarch64 gives `+0.0` for `@max` and `-0.0` for `@min`,
;   measured for #7394), so no reference passes such a test on both. A literal operand takes the other
;   operand's float type. Of two integers of one type: the larger / smaller. Each operand is evaluated once.
; - `std.math.pi` and `std.math.e` are comptime_floats (binary128), rounded once where a typed float is needed;
;   compile-time arithmetic on them stays binary128 until then.
; Not here: `@abs` of an integer (Zig's `@abs` of an `i32` is a `u32`), `@max` / `@min` of an integer and a
; literal (Zig narrows the result type to the literal's range), more than two operands, and the other
; `std.math` names.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceBuiltinAbsMaxMinPi;

var AMP_CALLS: u32 = 0;

fn amp_abs64(x: f64) -> f64 {
    return @abs(x);
}

fn amp_abs32(x: f32) -> f32 {
    return @abs(x);
}

fn amp_neg(x: f64) -> f64 {
    return -x;
}

fn amp_div(a: f64, b: f64) -> f64 {
    return a / b;
}

fn amp_nan(x: f64) -> bool {
    return x != x;
}

fn amp_max64(a: f64, b: f64) -> f64 {
    return @max(a, b);
}

fn amp_min64(a: f64, b: f64) -> f64 {
    return @min(a, b);
}

fn amp_max32(a: f32, b: f32) -> f32 {
    return @max(a, b);
}

fn amp_min32(a: f32, b: f32) -> f32 {
    return @min(a, b);
}

fn amp_maxi(a: i32, b: i32) -> i32 {
    return @max(a, b);
}

fn amp_mini(a: i32, b: i32) -> i32 {
    return @min(a, b);
}

fn amp_maxu(a: u8, b: u8) -> u8 {
    return @max(a, b);
}

fn amp_count(x: f64) -> f64 {
    AMP_CALLS = AMP_CALLS + 1;
    return x;
}

// Passes a value through a call, so the comparison runs at run time.
fn amp_same(x: f64) -> f64 {
    return x;
}

fn amp_same32(x: f32) -> f32 {
    return x;
}

// The largest of a slice, the loop dqn's td_target runs.
fn amp_best(xs: []const f32) -> f32 {
    var best: f32 = xs[0];
    var i: usize = 1;
    while (i < xs.len) {
        best = @max(best, xs[i]);
        i = i + 1;
    }
    return best;
}

// A literal operand: a hinge at zero.
fn amp_hinge(x: f64) -> f64 {
    return @max(x, 0.0);
}

fn amp_clamp(x: f64, lo: f64, hi: f64) -> f64 {
    return @min(@max(x, lo), hi);
}

test amp_abs_of_floats {
    assert(amp_abs64(-1.5) == 1.5);
    assert(amp_abs64(2.25) == 2.25);
    assert(amp_abs64(-0.000001) > 0.0);
    assert(amp_abs32(-0.75) == 0.75);
    assert(amp_abs32(3.5) == 3.5);
}

test amp_abs_of_zero_infinity_and_nan {
    assert(1.0 / amp_abs64(amp_neg(0.0)) > 0.0);
    assert(1.0 / amp_abs64(0.0) > 0.0);
    assert(amp_abs64(amp_div(-1.0, 0.0)) == amp_div(1.0, 0.0));
    assert(amp_nan(amp_abs64(amp_div(0.0, 0.0))));
}

test amp_abs_evaluates_its_operand_once {
    assert(@abs(amp_count(-4.5)) == 4.5);
    assert(AMP_CALLS == 1);
}

test amp_max_and_min_of_f64 {
    assert(amp_max64(1.0, 2.0) == 2.0);
    assert(amp_max64(2.0, 1.0) == 2.0);
    assert(amp_min64(1.0, 2.0) == 1.0);
    assert(amp_min64(2.0, 1.0) == 1.0);
    assert(amp_max64(-3.0, -7.5) == -3.0);
    assert(amp_min64(-3.0, -7.5) == -7.5);
    assert(amp_max64(amp_div(-1.0, 0.0), 5.0) == 5.0);
    assert(amp_min64(amp_div(1.0, 0.0), 5.0) == 5.0);
}

test amp_max_and_min_with_a_nan {
    const nan = amp_div(0.0, 0.0);
    assert(amp_max64(nan, 1.0) == 1.0);
    assert(amp_max64(1.0, nan) == 1.0);
    assert(amp_min64(nan, -1.0) == -1.0);
    assert(amp_min64(-1.0, nan) == -1.0);
    assert(amp_nan(amp_max64(nan, nan)));
    assert(amp_nan(amp_min64(nan, nan)));
}

test amp_equal_operands_give_an_equal_value {
    const nz = amp_neg(0.0);
    assert(amp_max64(nz, 0.0) == 0.0);
    assert(amp_max64(0.0, nz) == 0.0);
    assert(amp_min64(nz, 0.0) == 0.0);
    assert(amp_min64(0.0, nz) == 0.0);
    assert(amp_max64(2.5, 2.5) == 2.5);
    assert(amp_min32(0.5, 0.5) == 0.5);
}

test amp_max_and_min_of_f32 {
    assert(amp_max32(0.5, 0.25) == 0.5);
    assert(amp_min32(0.5, 0.25) == 0.25);
    const xs: [4]f32 = [0.5, 2.75, -1.0, 2.5];
    assert(amp_best(&xs) == 2.75);
    const ys: [3]f32 = [-3.0, -2.0, -9.0];
    assert(amp_best(&ys) == -2.0);
}

test amp_max_and_min_with_a_literal {
    assert(amp_hinge(-2.5) == 0.0);
    assert(amp_hinge(2.5) == 2.5);
    assert(amp_clamp(7.0, 0.0, 5.0) == 5.0);
    assert(amp_clamp(-7.0, 0.0, 5.0) == 0.0);
    assert(amp_clamp(3.0, 0.0, 5.0) == 3.0);
}

test amp_max_and_min_of_integers {
    assert(amp_maxi(-4, 3) == 3);
    assert(amp_maxi(3, -4) == 3);
    assert(amp_mini(-4, 3) == -4);
    assert(amp_mini(3, -4) == -4);
    assert(amp_maxi(-4, -4) == -4);
    assert(amp_maxu(200, 17) == 200);
    assert(amp_maxu(17, 200) == 200);
}

test amp_max_evaluates_each_operand_once {
    AMP_CALLS = 0;
    assert(@max(amp_count(1.0), amp_count(2.0)) == 2.0);
    assert(AMP_CALLS == 2);
    assert(@min(amp_count(1.0), amp_count(2.0)) == 1.0);
    assert(AMP_CALLS == 4);
}

test amp_pi_and_e_round_once {
    const p: f64 = std.math.pi;
    const q: f32 = std.math.pi;
    const e: f64 = std.math.e;
    assert(amp_same(p) == 3.141592653589793);
    assert(amp_same32(q) == 3.1415927);
    assert(amp_same(e) == 2.718281828459045);
    assert(amp_same(std.math.pi) == 3.141592653589793);
    assert(std.math.pi > 3.14159265358979);
    assert(std.math.pi < 3.14159265358980);
}

test amp_pi_in_run_time_arithmetic {
    const p: f64 = std.math.pi;
    assert(amp_div(1.618033988749895, p) == 0.5150362148004839);
    assert(amp_div(p, 1.618033988749895) == 1.9416110387254664);
    const t: f64 = 2.0 * std.math.pi * 1.5;
    assert(amp_same(t) == 9.42477796076938);
    const g: f64 = 1.618033988749895 / std.math.pi;
    assert(amp_same(g) == 0.5150362148004839);
}
