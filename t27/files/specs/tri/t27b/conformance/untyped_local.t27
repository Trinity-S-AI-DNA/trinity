// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/untyped_local.t27 -- a local declared with no type, as the reference runs it
; (gHashTag/t27#6063 lane: StmtLocal). Every test here passes `t27c test-report`; t27b must give the same
; verdict on each, or refuse the file.
; What t27c's Zig backend prints (`zig_int_literal_default_type` in bootstrap/src/compiler.rs):
; `var i = 0;` becomes `var i: u32 = 0;`, because Zig refuses a `var` of type comptime_int. The width is
; u32 when the literal fits in u32 and u64 when it does not, and a hex or binary literal is read the same
; way. The wrapping tests below show the width: `0 -% 1` is 4294967295 only in u32.
; `const _config = undefined;` with no type is printed as it is, followed by `_ = _config;` when nothing
; reads it. Zig accepts that, so the fn runs and the name is simply never used.
; Not here: `var x = -1` (a unary minus is not a bare literal, so the reference prints `var x = -1;`
; and Zig refuses it), `var x = 0.0` (comptime_float, refused by Zig), `var x = undefined` with no type
; (refused by Zig), and a read of an untyped `undefined` const (the reference compiles it and reads an
; undefined value; t27b refuses it rather than guess one). `var n = N` for a typed module const N is
; already typed, and both sides pass it.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceUntypedLocal;

fn count_to(n: u32) -> u32 {
    var i = 0;
    while (i < n) {
        i = i + 1;
    }
    return i;
}

fn sum_below(n: u32) -> u32 {
    var s = 0;
    var k = 1;
    while (k < n) {
        s = s + k;
        k = k + 1;
    }
    return s;
}

fn wrap_below_zero() -> u32 {
    var z = 0;
    z = z -% 1;
    return z;
}

fn wrap_past_top() -> u32 {
    var w = 4294967295;
    w = w +% 1;
    return w;
}

fn past_u32() -> u64 {
    var b = 5000000000;
    b = b + 7;
    return b;
}

fn wide_wraps_late() -> u64 {
    var v = 4294967296;
    v = v -% 1;
    v = v +% 2;
    return v;
}

fn hex_and_bin() -> u32 {
    var m = 0xFF;
    m = m * 16;
    var b = 0b1010;
    b = b + 1;
    return m + b;
}

fn submit(bpb: u32) -> bool {
    const _config = undefined;
    if (bpb == 0) {
        return false;
    }
    return true;
}

test a_counter_from_zero_counts {
    assert(count_to(0) == 0);
    assert(count_to(7) == 7);
    assert(count_to(50) == 50);
}

test two_untyped_vars_accumulate {
    assert(sum_below(1) == 0);
    assert(sum_below(5) == 10);
    assert(sum_below(101) == 5050);
}

test a_small_literal_makes_a_u32 {
    assert(wrap_below_zero() == 4294967295);
    assert(wrap_past_top() == 0);
}

test a_literal_past_u32_makes_a_u64 {
    assert(past_u32() == 5000000007);
    assert(wide_wraps_late() == 4294967297);
}

test hex_and_binary_literals_are_read_alike {
    assert(hex_and_bin() == 4091);
}

test an_unread_undefined_const_is_dropped {
    assert(submit(0) == false);
    assert(submit(3) == true);
}
