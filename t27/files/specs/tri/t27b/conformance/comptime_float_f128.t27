// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/comptime_float_f128.t27 -- more comptime_float folds, as the reference runs
; them (gHashTag/t27#6063 lane: ExprBinary(*), #7007). Every test here passes `t27c test-report`; t27b
; must give the same verdict on each, or refuse the file.
; comptime_float.t27 holds the rule: Zig folds an untyped float expression in binary128 and rounds it to
; f64 once, where it meets a typed value. This file adds the forms that one does not run: a folded
; difference, an integer literal times a float, a folded quotient, a negated fold, the golden identity
; phi^2 - phi with its binary128 residue, comparisons made in binary128 with no typed side at all, and
; f32 results rounded from a float literal that sits a hair off the midpoint between two f32 values.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceComptimeFloatF128;

const PHI = 1.618033988749895;

fn ident(v: f64) -> f64 {
    return v;
}

fn minus(a: f64, b: f64) -> f64 {
    return a - b;
}

fn times(a: f64, b: f64) -> f64 {
    return a * b;
}

fn over(a: f64, b: f64) -> f64 {
    return a / b;
}

fn above_one() -> f32 {
    return 1.0000000596046447753906250001;
}

fn below_half_ulp() -> f32 {
    return 1.00000005960464477539062499;
}

test a_folded_difference_rounds_once {
    const d = 1.0 - 0.9;
    assert(ident(0.1) == d);
    assert(minus(1.0, 0.9) != d);
}

test an_integer_times_a_float_folds_as_a_float {
    const t = 3 * 0.1;
    assert(ident(0.3) == t);
    assert(times(3.0, 0.1) != t);
}

test a_folded_quotient_matches_runtime {
    const q = 1.0 / 3.0;
    assert(over(1.0, 3.0) == q);
}

test the_golden_identity_keeps_a_binary128_residue {
    const r = PHI * PHI - PHI;
    assert(minus(times(PHI, PHI), PHI) == 1.0);
    assert(ident(1.0) != r);
    assert(r > 1.0);
}

test a_negated_fold_rounds_once {
    const n = -(0.1 * 3.0);
    assert(ident(-0.3) == n);
}

test untyped_comparisons_are_exact {
    assert(0.1 + 0.2 > 0.3);
    assert(0.1 * 3.0 > 0.3);
    assert(1.0 - 0.9 < 0.1);
    assert(ident(1.0 - 0.9) == 0.1);
}

test f32_rounding_near_a_midpoint {
    assert(above_one() == 1.00000011920928955078125);
    assert(below_half_ulp() == 1.0);
}
