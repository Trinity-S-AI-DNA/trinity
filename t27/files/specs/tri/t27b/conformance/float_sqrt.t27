// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/float_sqrt.t27 -- `@sqrt` of a run-time float, as the reference runs it
; (gHashTag/t27#6063 lane: ExprCall(@sqrt)). Every test here passes `t27c test-report`; t27b must give the
; same verdict on each, or refuse the file.
; gen-zig prints `@sqrt(x)` as written. Zig's `@sqrt` of an f64 or f32 is the IEEE-754 square root, correctly
; rounded to nearest: exact on a perfect square, the nearest float to the true root otherwise, and a NaN for
; a negative operand.
; Not here: `@sqrt` of a literal (Zig folds it at compile time) or of an integer (Zig refuses it).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceFloatSqrt;

fn root(x: f64) -> f64 {
    return @sqrt(x);
}

fn root32(x: f32) -> f32 {
    return @sqrt(x);
}

fn hypot(a: f64, b: f64) -> f64 {
    return @sqrt(a * a + b * b);
}

// The root of a negative value is a NaN, the one float not equal to itself.
fn is_nan(x: f64) -> bool {
    return x != x;
}

test sqrt_of_a_perfect_square_is_exact {
    assert(root(16.0) == 4.0);
    assert(root(0.25) == 0.5);
    assert(root(0.0) == 0.0);
    assert(root(1.0e10) == 1.0e5);
}

test sqrt_rounds_to_the_nearest_double {
    const r = root(2.0);
    assert(r == 1.4142135623730951);
    assert(r * r == 2.0000000000000004);
    assert(root(3.0) == 1.7320508075688772);
}

test sqrt_in_single_precision {
    assert(root32(9.0) == 3.0);
    assert(root32(2.0) == 1.4142135);
}

test sqrt_of_a_sum {
    assert(hypot(3.0, 4.0) == 5.0);
    assert(hypot(5.0, 12.0) == 13.0);
}

test sqrt_of_a_negative_is_nan {
    assert(is_nan(root(-1.0)));
    assert(!is_nan(root(1.0)));
}
