// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/int_cast.t27 -- `@intCast(x)` with a result type, as the reference runs it
; (gHashTag/t27#6063 lane 4: ExprCall(@intCast)). Every test here passes `t27c test-report`; t27b must give the
; same verdict on each, or refuse the file.
; gen-zig prints `@intCast(x)` as written. Zig takes the integer type from the result location (`@as(T, ..)`,
; a typed `const`, a `return`) and converts the value exactly: a narrower type, a wider one, or the other
; signedness. A value that does not fit is a safety panic in Debug, which is a failed test; the trap cases
; are in cli/t27b/tests/int_cast_traps.t27, since a conformance test must pass. A literal operand that does
; not fit is a compile error. What t27b decides is specs/tri/t27b/int_cast_plan.t27.
; Not here: `@intCast` with no result type (Zig refuses it), and a float or bool operand.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceIntCast;

fn ic_low_byte(x: u64) -> u8 {
    return @intCast(x & 255);
}

fn ic_to_u8(x: u64) -> u8 {
    return @as(u8, @intCast(x & 255));
}

fn ic_to_i32(x: i64) -> i32 {
    return @as(i32, @intCast(x));
}

fn ic_to_u64(x: i64) -> u64 {
    return @as(u64, @intCast(x));
}

fn ic_to_i64(x: u64) -> i64 {
    return @as(i64, @intCast(x));
}

fn ic_to_u32(x: i32) -> u32 {
    const r: u32 = @intCast(x);
    return r;
}

fn ic_narrow(x: u32) -> u16 {
    const r: u16 = @intCast(x);
    return r;
}

// gen_fuzz's rng_int_range after the draw: a value in [min, max].
fn ic_span(x: u64, min: i32, max: i32) -> i32 {
    if (max <= min) {
        return min;
    }
    const span: u64 = @as(u64, @intCast(@as(i64, max) - @as(i64, min))) + 1;
    const ic_offset: i64 = @as(i64, @intCast(x % span));
    return @as(i32, @intCast(@as(i64, min) + ic_offset));
}

test ic_narrowing_keeps_a_value_that_fits {
    assert(ic_low_byte(0x1234) == 0x34);
    assert(ic_low_byte(255) == 255);
    assert(ic_to_u8(18446744073709551615) == 255);
    assert(ic_to_u8(256) == 0);
    assert(ic_narrow(65535) == 65535);
    assert(ic_narrow(7) == 7);
}

test ic_signed_narrowing {
    assert(ic_to_i32(-2147483648) == -2147483648);
    assert(ic_to_i32(2147483647) == 2147483647);
    assert(ic_to_i32(-5) == -5);
}

test ic_signedness_changes {
    assert(ic_to_u64(0) == 0);
    assert(ic_to_u64(9223372036854775807) == 9223372036854775807);
    assert(ic_to_i64(9223372036854775807) == 9223372036854775807);
    assert(ic_to_i64(3) == 3);
    assert(ic_to_u32(2147483647) == 2147483647);
    assert(ic_to_u32(0) == 0);
}

test ic_widening {
    const small: u32 = ic_narrow(40000);
    const w: u64 = @intCast(small);
    assert(w == 40000);
    const neg: i64 = @intCast(ic_to_i32(-7));
    assert(neg == -7);
}

test ic_a_literal_operand {
    const b: u8 = @intCast(200);
    assert(ic_low_byte(b) == 200);
    assert(@as(u16, @intCast(1000)) + ic_narrow(1) == 1001);
}

test ic_range_from_a_draw {
    assert(ic_span(0, -3, 3) == -3);
    assert(ic_span(6, -3, 3) == 3);
    assert(ic_span(7, -3, 3) == -3);
    assert(ic_span(18446744073709551615, -2147483648, 2147483647) == 2147483647);
    assert(ic_span(5, 4, 4) == 4);
}
