// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/value_ignored.t27 -- tail expressions and discarded calls, as the reference
; runs them (gHashTag/t27#6063 lane: ExprLiteral/ExprCall/ExprBinary/ExprIdentifier(value ignored)
; statement). Every test here passes `t27c test-report`; t27b must give the same verdict on each, or
; refuse the file.
; What t27c's Zig backend prints since #6315 (bootstrap/src/compiler.rs):
;   1. `zig_tail_returns`: in a fn with a return type other than void, the last statement, when it is a
;      bare expression, becomes `return <expr>;`. Through an if/else that is last, the last statement of
;      each branch does too, at any depth. A `return`, an `assert` and a `print` keep their form.
;   2. `call_returns_value`: a statement that is only a call to a module fn returning a value becomes
;      `_ = f(x);`. The call runs and its value is dropped.
; Not here, because Zig still refuses them: a bare value in a test or a void fn, a value before the last
; statement of a body, and the tail of an `if` with no `else`. `zig_value_ignored.t27` and
; `brace_invariant.t27` cover the brace-invariant predicates.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceValueIgnored;

var CALLS: u32 = 0;

fn mask_low(w: u32) -> u32 {
    w & 255
}

fn same_word(w: u32) -> u32 {
    w
}

fn sign_of(d: i32) -> i32 {
    if d < 0 {
        -1
    } else {
        if d == 0 {
            0
        } else {
            1
        }
    }
}

fn clamp_byte(w: u32) -> u32 {
    if w > 255 {
        255
    } else {
        let low: u32 = w & 255;
        low
    }
}

fn is_even(w: u32) -> bool {
    w % 2 == 0
}

fn halve_masked(w: u32) -> u32 {
    mask_low(w) / 2
}

fn tick(step: u32) -> u32 {
    CALLS += step;
    CALLS
}

fn mark() -> bool {
    CALLS += 100;
    true
}

fn count_down(n: u32) -> u32 {
    var left: u32 = n;
    var steps: u32 = 0;
    while left > 0 {
        left -= 1;
        steps += 1;
    }
    steps * 3
}

fn tick_twice() {
    tick(2);
    tick(3);
}

test tail_binary_and_name {
    assert(mask_low(4660) == 52);
    assert(same_word(77) == 77);
    assert(halve_masked(511) == 127);
    assert(count_down(5) == 15);
}

test tail_through_nested_branches {
    assert(sign_of(-9) == -1);
    assert(sign_of(0) == 0);
    assert(sign_of(12) == 1);
    assert(clamp_byte(300) == 255);
    assert(clamp_byte(200) == 200);
}

test tail_comparison {
    assert(is_even(10));
    assert(!is_even(7));
}

test discarded_calls_still_run {
    CALLS = 0;
    tick(5);
    tick(6);
    assert(CALLS == 11);
    tick_twice();
    assert(CALLS == 16);
    mark();
    assert(CALLS == 116);
    var i: u32 = 0;
    while i < 3 {
        tick(1);
        i += 1;
    }
    assert(CALLS == 119);
}
