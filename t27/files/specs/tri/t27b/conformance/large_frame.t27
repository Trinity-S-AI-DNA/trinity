// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/large_frame.t27 -- fns and tests whose local arrays take more than 16 KiB of
; stack, as the reference runs them (gHashTag/t27#6063 lane 5: FnDecl(frame size)). Every test here passes
; `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; gen-zig prints each local array as it is (`var buf: [20000]u8 = undefined;`), and Zig puts it in the
; frame of the fn or test that declares it. A frame that large must touch its stack one page at a time on
; the way down, so that it can never step over the guard page below the stack without faulting on it.
; Covered: a test body with a 20000-byte array, a fn with a 48000-byte array called twice, a fn with two
; arrays whose sum is just over 16 KiB, and a recursion 12 frames deep with 20000 bytes in each frame, every
; byte of which is checked after the deeper frames returned.
; Not here: a frame over 1 MiB (t27b refuses it as FnDecl(frame size)) and a recursion deep enough to
; overflow the stack, which crashes both backends.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceLargeFrame;

// Fill 6000 u64 slots with 0, 3, 6, ... and add them back, last slot first.
fn wide_sum() -> u64 {
    var slots: [6000]u64 = undefined;
    var i: usize = 0;
    var v: u64 = 0;
    while (i < 6000) {
        slots[i] = v;
        v = v + 3;
        i = i + 1;
    }
    var total: u64 = 0;
    var j: usize = 6000;
    while (j > 0) {
        j = j - 1;
        total = total + slots[j];
    }
    return total;
}

// Two arrays, 16384 + 64 bytes: the size gen_w384_lean's test needs.
fn page_and_tail(seed: u8) -> u32 {
    var page: [16384]u8 = undefined;
    var tail: [64]u8 = undefined;
    var i: usize = 0;
    var v: u8 = seed;
    while (i < 16384) {
        page[i] = v;
        v = v + 1;
        if (v == 200) {
            v = 0;
        }
        i = i + 1;
    }
    var k: usize = 0;
    while (k < 64) {
        tail[k] = page[16383 - k];
        k = k + 1;
    }
    var acc: u32 = 0;
    k = 0;
    while (k < 64) {
        acc = acc + tail[k];
        k = k + 1;
    }
    return acc;
}

// 20000 bytes per frame. Each level fills its whole array with a pattern that
// starts at its depth, calls the next level down, and then checks every byte:
// if two frames overlapped, the deeper level's pattern would show through.
// The result counts the levels whose array came back whole.
fn deep_frames(depth: u8) -> u32 {
    var block: [20000]u8 = undefined;
    var i: usize = 0;
    var v: u8 = depth;
    while (i < 20000) {
        block[i] = v;
        v = v + 1;
        if (v == 250) {
            v = 0;
        }
        i = i + 1;
    }
    var below: u32 = 0;
    if (depth > 0) {
        below = deep_frames(depth - 1);
    }
    i = 0;
    v = depth;
    while (i < 20000) {
        if (block[i] != v) {
            return 0;
        }
        v = v + 1;
        if (v == 250) {
            v = 0;
        }
        i = i + 1;
    }
    return below + 1;
}

test a_test_body_holds_twenty_thousand_bytes {
    var buf: [20000]u8 = undefined;
    var i: usize = 0;
    var v: u8 = 0;
    while (i < 20000) {
        buf[i] = v;
        v = v + 1;
        if (v == 251) {
            v = 0;
        }
        i = i + 1;
    }
    // A callee's frame lies below this one; it must not reach into buf.
    assert(page_and_tail(0) == 9696);
    assert(buf[0] == 0);
    assert(buf[250] == 250);
    assert(buf[251] == 0);
    assert(buf[19999] == 170);
}

test a_forty_eight_thousand_byte_fn_runs_twice {
    assert(wide_sum() == 53991000);
    assert(wide_sum() == 53991000);
}

test just_over_sixteen_kib {
    // page[16383 - k] for k in 0..64 holds (seed + 16383 - k) % 200;
    // with seed 0 that is 183 down to 120, which add up to 9696.
    assert(page_and_tail(0) == 9696);
}

test twelve_frames_of_twenty_thousand_bytes {
    assert(deep_frames(11) == 12);
    assert(deep_frames(0) == 1);
}
