// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/bare_abs.t27 -- `abs(x)` with no `fn abs` declared, as the reference runs it
; (gHashTag/t27#6063 lane: ExprCall(undeclared fn), issue #7227). Every test here passes `t27c test-report`;
; t27b must give the same verdict on each, or refuse the file.
; t27c's Zig backend prints a bare `abs(x)` as Zig's builtin `@abs(x)` unless the spec declares a fn
; named `abs`. On a float it clears the sign bit: `-0.0` gives `+0.0`, an infinity gives `+inf`, and a NaN
; stays a NaN. The operand is evaluated once.
; Not here: a typed integer operand (Zig's `@abs` of an `i32` is a `u32`), and the other bare names the
; reference maps the same way (`sqrt floor ceil round min max`).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceBareAbs;

var CALLS: u32 = 0;

fn mag(x: f64) -> f64 {
    return abs(x);
}

fn mag32(x: f32) -> f32 {
    return abs(x);
}

fn negate(x: f64) -> f64 {
    return -x;
}

fn div(a: f64, b: f64) -> f64 {
    return a / b;
}

fn dist(a: f64, b: f64) -> f64 {
    return abs(a - b);
}

fn counted(x: f64) -> f64 {
    CALLS = CALLS + 1;
    return x;
}

fn within(a: f64, b: f64, tol: f64) -> bool {
    return abs(a - b) <= tol;
}

test abs_of_a_typed_f64 {
    assert(mag(-1.5) == 1.5);
    assert(mag(2.25) == 2.25);
    assert(mag(0.0) == 0.0);
    assert(mag(-0.000001) > 0.0);
}

test abs_of_negative_zero_is_positive_zero {
    assert(1.0 / negate(0.0) < 0.0);
    assert(1.0 / mag(negate(0.0)) > 0.0);
    assert(1.0 / mag(0.0) > 0.0);
}

test abs_of_an_f32 {
    assert(mag32(-0.75) == 0.75);
    assert(mag32(3.5) == 3.5);
}

test abs_of_infinity_and_nan {
    assert(mag(div(-1.0, 0.0)) == div(1.0, 0.0));
    assert(mag(div(1.0, 0.0)) > 1000000.0);
    assert(mag(div(0.0, 0.0)) != mag(div(0.0, 0.0)));
}

test abs_inside_an_expression {
    assert(dist(1.0, 1.25) == 0.25);
    assert(dist(1.25, 1.0) == 0.25);
    assert(within(3.0, 3.0001, 0.001));
    assert(!within(3.0, 3.1, 0.001));
}

test abs_evaluates_its_operand_once {
    assert(abs(counted(-4.5)) == 4.5);
    assert(CALLS == 1);
    assert(abs(counted(2.0)) + abs(counted(-2.0)) == 4.0);
    assert(CALLS == 3);
}
