// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/postfix_optional.t27 -- the optional spelled after the type, `T?`, as the
; reference runs it (gHashTag/t27#6063 lane 1, issue #7415). Every test here passes `t27c test-report`;
; t27b must give the same verdict on each, or refuse the file.
; t27c's type mapper writes a struct field's `T?` as Zig's `?T` (#6451), so `str?` is `?[]const u8` and
; `PostfixPoint?` an optional struct. The two spellings name one type: a `u16?` field goes into a `?u16`
; parameter and back.
; Not here: `-> T?` and `const X: T? = ..` do not parse, and a parameter's `T?` loses its `?` in the
; parser, so the reference and t27b both read that parameter as a plain `T`.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformancePostfixOptional;

// Named PostfixPoint and PostfixReply, not Point and Reply: specs/tri/math/bezier.t27 owns Point and
// specs/compiler/zig_field_syntax.t27 owns Reply, and a conformance fixture type name is unique in the
// corpus (Q66; tri types ratchet, #7522).
const PostfixPoint = struct {
    x: i32,
    y: i32,
};

const PostfixReply = struct {
    ok: bool,
    note: str?,
    code: u16?,
    at: PostfixPoint?,
};

fn make(ok: bool) -> PostfixReply {
    if (ok) {
        return PostfixReply{ .ok = true, .note = null, .code = null, .at = null };
    }
    return PostfixReply{ .ok = false, .note = "bad", .code = 404, .at = PostfixPoint{ .x = 2, .y = 3 } };
}

fn note_len(r: PostfixReply) -> usize {
    if (r.note != null) {
        return r.note.?.len;
    }
    return 0;
}

// The prefix spelling takes what the postfix field holds.
fn code_or(x: ?u16, d: u16) -> u16 {
    if (x != null) {
        return x.?;
    }
    return d;
}

fn sum_at(r: PostfixReply, d: i32) -> i32 {
    if (r.at != null) {
        return r.at.?.x * 10 + r.at.?.y;
    }
    return d;
}

// A field set after the struct is built, inside a loop.
fn first_multiple(start: u16, k: u16) -> PostfixReply {
    var r = make(true);
    var i: u16 = 0;
    while (i < 5) {
        if (r.code == null and (start + i) % k == 0) {
            r.code = start + i;
        }
        i = i + 1;
    }
    return r;
}

test fields_spelled_after_the_type {
    const a = make(true);
    assert(a.ok);
    assert(a.note == null);
    assert(a.code == null);
    assert(a.at == null);
    assert(note_len(a) == 0);
    const b = make(false);
    assert(!b.ok);
    assert(b.note != null);
    assert(note_len(b) == 3);
    assert(b.code.? == 404);
}

test the_prefix_spelling_reads_the_postfix_field {
    assert(code_or(make(false).code, 1) == 404);
    assert(code_or(make(true).code, 1) == 1);
}

test an_optional_struct_field {
    assert(sum_at(make(false), 5) == 23);
    assert(sum_at(make(true), 5) == 5);
}

test a_field_assigned_later {
    assert(first_multiple(7, 3).code.? == 9);
    assert(first_multiple(10, 2).code.? == 10);
    assert(first_multiple(1, 7).code == null);
}
