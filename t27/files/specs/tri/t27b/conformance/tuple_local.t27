// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/tuple_local.t27 -- a local tuple with no type, read at constant indices, as the
; reference runs it (gHashTag/t27#6063 lane: ExprTuple). Every test here passes `t27c test-report`; t27b
; must give the same verdict on each, or refuse the file.
; gen-zig prints `const t = .{ a, b };` (and `(a, b)` the same way). Zig makes that a tuple whose fields have
; the types of the run-time values in it, and `t[0]` reads one field at a compile-time index. The fields
; are evaluated once, in order, when the local is declared.
; Not here: a run-time index into the tuple (Zig refuses it), a literal element (a `comptime` field of type
; `comptime_int` or `comptime_float`), and `var t = .{ ... }`.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceTupleLocal;

struct Vec3 {
    x: f64,
    y: f64,
    z: f64,
}

fn dot_minus(a: Vec3, b: Vec3) -> f64 {
    const d = .{ a.x - b.x, a.y - b.y, a.z - b.z };
    return d[0] * d[0] + d[1] * d[1] + d[2] * d[2];
}

// Fields of different types, and the paren spelling.
fn mixed(n: u32, f: f64, flag: bool) -> u32 {
    const t = (n + 1, f, flag);
    if (t[2]) {
        return t[0];
    }
    return 0;
}

var calls: u32 = 0;

fn bump(v: u32) -> u32 {
    calls = calls + 1;
    return v + calls;
}

// Each field is evaluated once, left to right, at the declaration.
fn order() -> u32 {
    const t = .{ bump(10), bump(20) };
    return t[1] * 100 + t[0];
}

test tuple_of_differences {
    const a = Vec3 { x: 4.0, y: 6.0, z: 3.0 };
    const b = Vec3 { x: 1.0, y: 2.0, z: 3.0 };
    assert(dot_minus(a, b) == 25.0);
}

test tuple_of_mixed_fields {
    assert(mixed(41, 0.5, true) == 42);
    assert(mixed(41, 0.5, false) == 0);
}

test tuple_fields_evaluate_once_in_order {
    assert(order() == 2211);
    assert(calls == 2);
}
