// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/repeat_addr_unreached.t27 -- `&[_]T{ ... } ** n` in a fn only a bench names, as
; the reference runs it (gHashTag/t27#6063 lane: ExprBinary). Every test here passes `t27c test-report`; t27b
; must give the same verdict on each, or refuse the file.
; gen-zig prints `&[_]bool{true} ** 3` as `&.{ true } ** 3`, which Zig reads as `(&.{ true }) ** 3`, a
; pointer to a tuple: once analyzed it is refused ("expected indexable"). Zig analyzes only what a test or
; a constant reaches, and a bench is not lowered into anything a test reaches, so a fn only a bench names
; is parsed and nothing more.
; Not here (the reference cannot compile it): the same argument in a fn a test calls.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceRepeatAddrUnreached;

fn count(xs: []const bool) -> u32 {
    var n: u32 = 0;
    for (i in 0..xs.len) {
        if (xs[i]) {
            n = n + 1;
        }
    }
    return n;
}

// Only the bench below names it.
fn count_three() -> u32 {
    return count(&[_]bool{true} ** 3);
}

test count_of_a_slice {
    const xs = [_]bool{ true, false, true, true };
    assert(count(&xs) == 3);
}

bench count_latency
    measure: nanoseconds to count_three
    target: < 100ns
