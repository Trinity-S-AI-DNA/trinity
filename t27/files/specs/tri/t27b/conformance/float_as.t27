// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/float_as.t27 -- `x as T` with a float operand, as the reference runs it
; (gHashTag/t27#6063 lane: ExprCast(f64)). Every test here passes `t27c test-report`; t27b must give the
; same verdict on each, or refuse the file.
; gen-zig picks the builtin from how the operand is spelled: a parameter, a local or a struct field declared
; f32 / f64, a literal with a decimal point, or a binary expression with such a side is a float, so
; `y as i64` is `@as(i64, @intFromFloat(y))` (toward zero) and `y as f32` is `@as(f32, @floatCast(y))`
; (nearest, ties to even). An integer operand takes `@floatFromInt` as before.
; Not here (the reference cannot compile it): a float the backend does not spell as one, such as a call
; returning f64 cast to an integer, which it prints as `@intCast` and Zig refuses.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceFloatAs;

struct Sample {
    weight: f64,
    count: u32,
}

// floor(y) for |y| < 2^63, the casts of the queen-needs-you port.
fn floor_f64(y: f64) -> f64 {
    var t: i64 = y as i64;
    if (y < t as f64) {
        t = t - 1;
    }
    return t as f64;
}

fn trunc_i32(y: f64) -> i32 {
    var x: f64 = y * 2.0;
    return x as i32;
}

fn narrow(y: f64) -> f32 {
    return y as f32;
}

fn widen(y: f32) -> f64 {
    return y as f64;
}

fn same(y: f64) -> f64 {
    return y as f64;
}

fn weight_units(s: Sample) -> u32 {
    return s.weight as u32 + s.count;
}

fn shifted(y: f64) -> i64 {
    return (y + 0.5) as i64;
}

test floor_rounds_down {
    assert(floor_f64(2.5) == 2.0);
    assert(floor_f64(-2.5) == -3.0);
    assert(floor_f64(7.0) == 7.0);
    assert(floor_f64(-0.25) == -1.0);
}

test int_from_float_truncates_toward_zero {
    assert(trunc_i32(1.75) == 3);
    assert(trunc_i32(-1.75) == -3);
}

test float_cast_rounds_to_nearest {
    assert(narrow(0.1) == 0.1);
    assert(same(0.1) == 0.1);
    assert(widen(0.5) == 0.5);
    assert(narrow(16777217.0) == 16777216.0);
}

test struct_field_is_a_float {
    const s = Sample{ weight = 2.9, count = 4 };
    assert(weight_units(s) == 6);
}

test binary_with_a_float_side {
    assert(shifted(1.6) == 2);
    assert(shifted(-0.4) == 0);
}
