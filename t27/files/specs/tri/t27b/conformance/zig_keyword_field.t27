// SPDX-License-Identifier: Apache-2.0
; zig_keyword_field.t27 -- conformance spec for t27b (epic #6063, lane: ExprStructLit(zig keyword field))
; A struct field may be named for a Zig keyword (`align`, `error`). t27c's
; Zig backend escapes such a name as `@"align"` everywhere it prints one:
; in the declaration, in a struct literal (`.@"align" = 4`), in a read
; (`s.@"align"`) and in an assignment target. These tests pin that down:
; the field holds its own value, separate from its neighbours, in a
; literal built in a fn, in a module constant, and after a write.
; phi^2 + phi^-2 = 3 | TRINITY

module T27bConformanceZigKeywordField;

const Section = struct {
    vaddr: u32,
    align: u32,
    error: bool,
};

const BOOT: Section = Section{ .vaddr = 100, .align = 64, .error = false };

// Round vaddr up to the next multiple of align; align 0 leaves it.
fn aligned(sec: Section) -> u32 {
    if (sec.align == 0) {
        return sec.vaddr;
    }
    const rem: u32 = sec.vaddr % sec.align;
    if (rem == 0) {
        return sec.vaddr;
    }
    return sec.vaddr + sec.align - rem;
}

fn make(vaddr: u32, a: u32) -> Section {
    return Section{ .vaddr = vaddr, .align = a, .error = a == 0 };
}

fn doubled(s: Section) -> Section {
    var t: Section = s;
    t.align = t.align * 2;
    t.error = false;
    return t;
}

test keyword_fields_in_a_literal {
    const s = make(4097, 4096);
    assert(s.vaddr == 4097);
    assert(s.align == 4096);
    assert(!s.error);
    assert(aligned(s) == 8192);
}

test a_zero_keyword_field {
    const z = make(13, 0);
    assert(z.error);
    assert(z.align == 0);
    assert(aligned(z) == 13);
}

test a_keyword_field_written {
    const b = doubled(make(5, 4));
    assert(b.align == 8);
    assert(aligned(b) == 8);
    assert(aligned(make(16, 4)) == 16);
    const c = doubled(make(7, 0));
    assert(!c.error);
    assert(c.align == 0);
}

test a_keyword_field_in_a_module_constant {
    assert(BOOT.align == 64);
    assert(!BOOT.error);
    assert(aligned(BOOT) == 128);
}
