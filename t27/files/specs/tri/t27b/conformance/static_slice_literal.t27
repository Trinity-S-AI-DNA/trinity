// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/static_slice_literal.t27 -- array literals of compile-time elements that t27c's Zig
; backend prints as `@constCast(&[_]E{ ... })`: a slice field of a named struct literal, and the value of a fn
; that returns a slice, mutable or not (#7680, t27b coverage epic #6063; the shapes of specs/tri/graph/graph.t27,
; topological_sort.t27 and bellman_ford.t27).
; Every test here passes `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; What the reference does with them (zig 0.16.0, the default x86_64 Debug backend that `t27c test-report` builds
; with):
;   - E is the destination's element type. The literal's own type text is not printed, so `[]usize{ 0, 1 }`,
;     `[0, 1]` and a bare `[]usize` (no elements) differ only in their elements.
;   - The array is a comptime value. Zig interns it: one object per element type and value, wherever the literal
;     is written, alive for the whole process. This backend keeps it in writable memory, so a write through the
;     mutable slice succeeds, and every later evaluation of an equal literal reads what was written: the same
;     site, another site, and a `[]const` one too. A literal of another value or another element type is
;     another object.
;   - `t27c test-report` runs each test in its own process, so every test starts from the written constants.
; t27b's plan for these is specs/tri/t27b/slice_lit_plan.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceStaticSliceLiteral;

pub const StaticOrder = struct {
    order: []usize,
    has_cycle: bool,
};

pub const StaticBag = struct {
    items: []usize,
    count: usize,
};

pub const StaticHop = struct {
    from: usize,
    to: usize,
    weight: i64,
};

// A typed literal of constants for a mutable slice field (topological_sort.t27's `sort`).
fn static_order() -> StaticOrder {
    return StaticOrder{ .order = []usize{ 0, 1, 2, 3 }, .has_cycle = false };
}

// A typed literal with no elements (graph.t27's `empty`): an empty slice.
fn static_empty_bag(n: usize) -> StaticBag {
    return StaticBag{ .items = []usize, .count = n };
}

// An untyped literal of the same value as `static_order`'s, at another site.
fn static_same_bag() -> StaticBag {
    return StaticBag{ .items = [0, 1, 2, 3], .count = 4 };
}

// A literal of struct constants returned as a mutable slice (bellman_ford.t27's `default_input`).
fn static_hops() -> []StaticHop {
    return []StaticHop{
        .{ .from = 0, .to = 1, .weight = 4 },
        .{ .from = 1, .to = 2, .weight = -2 },
        .{ .from = 2, .to = 0, .weight = 5 },
    };
}

// The same value again, returned as a slice of constants.
fn static_order_view() -> []const usize {
    return [0, 1, 2, 3];
}

// Another value, and the same numbers of another element type.
fn static_prefix() -> []usize {
    return [0, 1, 2];
}

fn static_narrow() -> []u32 {
    return [0, 1, 2, 3];
}

// Two literals with the same bytes and different element types: [0, 1] as u32 is 2^32 as one usize.
fn static_pair32() -> []u32 {
    return [0, 1];
}

fn static_wide() -> []usize {
    return [4294967296];
}

fn static_sum(xs: []const usize) -> usize {
    var s: usize = 0;
    var i: usize = 0;
    while (i < xs.len) {
        s += xs[i];
        i += 1;
    }
    return s;
}

fn static_set_first(xs: []usize, v: usize) -> void {
    xs[0] = v;
}

test a_constant_slice_field_holds_its_elements {
    const r = static_order();
    assert(r.order.len == 4);
    assert(r.order[3] == 3);
    assert(static_sum(r.order) == 6);
    assert(r.has_cycle == false);
}

test a_typed_literal_without_elements_is_an_empty_slice {
    const b = static_empty_bag(5);
    assert(b.items.len == 0);
    assert(b.count == 5);
}

test a_constant_returned_as_a_mutable_slice {
    const hs = static_hops();
    assert(hs.len == 3);
    assert(hs[0].weight + hs[1].weight + hs[2].weight == 7);
    assert(hs[1].to == 2);
    assert(hs[2].from == 2);
}

test a_write_is_read_by_the_next_evaluation_of_the_same_literal {
    const a = static_order();
    static_set_first(a.order, 9);
    const b = static_order();
    assert(b.order[0] == 9);
    assert(static_sum(b.order) == 15);
}

test a_write_is_read_through_an_equal_literal_elsewhere {
    const a = static_order();
    static_set_first(a.order, 7);
    const c = static_same_bag();
    assert(c.items[0] == 7);
    assert(static_order_view()[0] == 7);
}

test another_value_or_element_type_is_another_object {
    const a = static_order();
    static_set_first(a.order, 8);
    assert(static_prefix()[0] == 0);
    assert(static_narrow()[0] == 0);
    assert(a.order[0] == 8);
    var p = static_pair32();
    p[1] = 5;
    assert(static_pair32()[1] == 5);
    assert(static_wide()[0] == 4294967296);
}

test a_write_through_a_returned_mutable_slice {
    var hs = static_hops();
    hs[0].weight = 40;
    assert(static_hops()[0].weight == 40);
}

test every_test_starts_from_the_constants {
    assert(static_order().order[0] == 0);
    assert(static_hops()[0].weight == 4);
    assert(static_same_bag().items[0] == 0);
}
