// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/module_var_in_test.t27 -- a test that writes a module-level var at its top level,
; as the reference runs it (gHashTag/t27#6063 lane: StmtAssign(module var in test)). Every test here passes
; `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; What t27c's Zig backend prints since #6295: `HITS = 3;` at the top of a test, where HITS is a module `var`,
; is the same `HITS = 3;` -- a write to module state, which the fns the test then calls read. (Before #6295
; it was bound as a fresh `const HITS = 3;`, which shadowed the declaration and Zig refused the file.)
; `t27c test-report` runs every test in a fresh process, so each test starts from the declared value.
; Not here: a test-local `var READY` with the name of a module var (renamed `READY_lv` by the reference;
; t27b refuses it as StmtLocal(shadows module var)), a write to a module var inside an invariant, which
; Zig cannot do at comptime, and a second write to a test-local `var` (a family of its own, which
; test_local_write.t27 covers since #7422).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceModuleVarInTest;

var HITS: u32 = 0;
var READY: bool = false;
var LEVEL: u32 = 1;
var TOTAL: u64 = 0;
var BALANCE: i64 = 0;

fn hit() -> u32 {
    HITS = HITS + 1;
    return HITS;
}

fn ready_now() -> bool {
    return READY;
}

fn read_total() -> u64 {
    return TOTAL;
}

fn in_debt() -> bool {
    return BALANCE < 0;
}

test a_write_is_seen_by_the_fn_it_calls {
    HITS = 3;
    assert(hit() == 4);
    assert(HITS == 4);
}

test each_test_starts_from_the_declared_value {
    assert(HITS == 0);
    HITS += 2;
    assert(HITS == 2);
    assert(hit() == 3);
}

test a_bool_var_is_written {
    assert(ready_now() == false);
    READY = true;
    assert(ready_now() == true);
}

test the_second_write_reads_the_first {
    LEVEL = 5;
    LEVEL = LEVEL * 2;
    assert(LEVEL == 10);
}

test a_computed_value_is_stored {
    TOTAL = read_total() + 6 * 7;
    assert(read_total() == 42);
    TOTAL = TOTAL * 2;
    assert(TOTAL == 84);
}

test a_signed_var_goes_negative {
    BALANCE = -12;
    assert(in_debt());
    BALANCE = BALANCE + 20;
    assert(in_debt() == false);
    assert(BALANCE == 8);
}
