// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/array_literal_value.t27 -- array literals with no result type of their
; own, as the reference runs them (gHashTag/t27#6063 lane: ExprArrayLiteral "no result type").
; Every test here passes `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; What t27c's Zig backend prints, and so what each shape means:
;   - `return [a, b];` or `return [_]T{ a, b };` in a fn returning a slice is
;     `return @constCast(&[_]E{ a, b });`: a slice of a constant array of the return element type E.
;     Its elements are comptime values, so it outlives the call. Written through, it would fault, so a
;     fn returning a mutable slice this way is only sound while no test reaches it.
;   - a local `const x = [N]T{ a, b };` (or `[_]T{...}`) is `const x = .{ a, b };`: a tuple. N and T
;     are dropped, so `[4]u8{ 7 }` has ONE element. `&x` passed where a callee declares `[]const E`
;     coerces to a slice of E, whatever T said.
; Not here (t27b refuses them): a literal of run-time values returned as a slice (the reference returns
; a pointer into its own frame), indexing such a local, a `var` one, and one passed to callees with
; different element types.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceArrayLiteralValue;

fn sum(xs: []const f64) -> f64 {
    var s: f64 = 0;
    for (xs) |x| {
        s += x;
    }
    return s;
}

fn total(xs: []const i64) -> i64 {
    var s: i64 = 0;
    for (xs) |x| {
        s += x;
    }
    return s;
}

fn count(xs: []const u8) -> usize {
    return xs.len;
}

fn first(xs: []const u8) -> u8 {
    return xs[0];
}

fn weights() -> []const f64 {
    return [1.5, 2.5, 3.0];
}

fn ints_as_floats() -> []const f64 {
    return [1, 2, 4];
}

fn typed_return() -> []const i64 {
    return [_]i64{ 5, -2, 10 };
}

fn never_called() -> []f32 {
    return [0.0, 1.0];
}

test a_returned_literal_is_a_constant_slice {
    assert(sum(weights()) == 7.0);
    assert(weights().len == 3);
}

test integer_elements_take_the_return_element_type {
    assert(sum(ints_as_floats()) == 7.0);
}

test a_typed_returned_literal {
    assert(total(typed_return()) == 13);
    assert(typed_return().len == 3);
}

test returned_twice_is_the_same_data {
    assert(sum(weights()) + sum(weights()) == 14.0);
}

test a_local_literal_passed_by_address {
    const ws = [_]u8{ 100, 200 };
    assert(total(&ws) == 300);
}

test the_declared_length_is_dropped {
    const frame = [4]u8{ 7 };
    assert(count(&frame) == 1);
    assert(first(&frame) == 7);
    assert(frame.len == 1);
}
