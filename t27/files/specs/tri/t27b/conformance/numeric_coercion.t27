// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/numeric_coercion.t27 -- what Zig 0.16 does with two numeric types that differ,
; as the reference runs it (gHashTag/t27#6063, the `type mismatch` family: gf16.t27, workflow.t27,
; gen_perceptron.t27). Every test here passes `t27c test-report`; t27b must give the same verdict on each,
; or refuse the file.
; gen-zig prints these expressions as written, so Zig's own rules decide them (each measured with zig 0.16.0
; on the t27c lab):
;   - two integers of any two types compare by value: `i8 == u8`, `i64 >= u32`, -1 is not 255;
;   - an integer constant Zig knows at compile time -- a module const, an array's `.len`, `+ - * & | ^`
;     over such constants -- coerces to any integer type that holds its value;
;   - for `+ - * & | ^` and the arms of an `if` with no result type, the operand type with more bits wins
;     (the first operand's on a tie); the other operand widens to it, or is a constant that fits it;
;   - an integer coerces to a float type that holds every value of its type exactly (up to u53 and i54
;     for an f64, u24 and i25 for an f32), a constant to one that holds its value exactly (2^60 in an f64).
; What t27b decides is specs/tri/t27b/coerce_plan.t27. Not here, since a conformance test must pass: what Zig
; refuses -- `NC_EXP_MAX + a` with `a` an i8 variable (the u8 is first), an i32 into an f32, an i8 constant
; -1 added to a u8.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceNumericCoercion;

pub const NC_EXP_MAX : u8 = 63;
pub const NC_BIG : u8 = 200;
pub const NC_FIVE : i8 = 5;
pub const NC_IDX : i64 = 2;
pub const NC_NINE : u8 = 9;
pub const NC_FOUR : u8 = 4;
pub const NC_TWO_60 : u64 = 1152921504606846976;
pub const NC_TABLE : [4]u16 = [10, 20, 30, 40];

pub const NcBox = struct {
    items : [5]u8,
    tag : u8,
};

// ---------------------------------------------------------------- integers of two types compared

fn nc_exponent(x: u16) -> i8 {
    return @as(i8, @intCast((x >> 9) & 63));
}

fn nc_is_special(x: u16) -> bool {
    return nc_exponent(x) == NC_EXP_MAX;
}

fn nc_is_normal(x: u16) -> bool {
    const e = nc_exponent(x);
    return e >= 0 and e < NC_EXP_MAX;
}

fn nc_lt(a: i8, b: u8) -> bool {
    return a < b;
}

fn nc_eq(a: i8, b: u8) -> bool {
    return a == b;
}

fn nc_ge(a: i64, b: u32) -> bool {
    return a >= b;
}

fn nc_below_big(a: i8) -> bool {
    return a < NC_BIG;
}

fn nc_at_index(n: u64) -> bool {
    return n == NC_IDX;
}

test nc_integers_of_two_types_compare_by_value {
    assert nc_is_special(0x7E00);
    assert !nc_is_special(0x3E00);
    assert nc_is_normal(0x3E00);
    assert !nc_is_normal(0x7E01);
    assert nc_lt(-3, 250);
    assert !nc_lt(5, 3);
    assert nc_lt(-1, 0);
    assert !nc_eq(-1, 255);
    assert nc_eq(7, 7);
    assert !nc_ge(-1, 0);
    assert nc_ge(5000000000, 4294967295);
    assert nc_below_big(127);
    assert nc_below_big(-128);
    assert nc_at_index(2);
    assert !nc_at_index(3);
}

// ---------------------------------------------------------------- typed constants coerced by value

fn nc_count(b: NcBox) -> i32 {
    return b.items.len;
}

fn nc_signed_byte(x: i8) -> i8 {
    return x;
}

fn nc_third(t: [4]u16) -> u16 {
    return t[NC_IDX];
}

fn nc_top_field(x: u16) -> u16 {
    const shift : u4 = NC_NINE - NC_FOUR;
    return x >> shift;
}

fn nc_low_field(x: u16) -> u16 {
    const shift : u4 = 9 - NC_FOUR;
    return (x >> shift) << shift;
}

test nc_typed_constants_coerce_by_value {
    const box = NcBox{ .items = [1, 2, 3, 4, 5], .tag = 1 };
    assert nc_count(box) == 5;
    assert nc_signed_byte(NC_EXP_MAX) == 63;
    assert nc_signed_byte(NC_FIVE) + nc_signed_byte(NC_EXP_MAX) == 68;
    assert nc_third(NC_TABLE) == 30;
    assert nc_top_field(0xFFFF) == 2047;
    assert nc_low_field(0x01FF) == 0x01E0;
}

// ---------------------------------------------------------------- the peer type of two integer operands

fn nc_add_const(a: i8) -> i8 {
    return a + NC_EXP_MAX;
}

fn nc_more_bits_wins(e: u16) -> u16 {
    return NC_FIVE + e;
}

fn nc_mask(a: i8) -> i8 {
    return a & NC_EXP_MAX;
}

fn nc_arm(c: bool, a: i8) -> i8 {
    const v = if (c) a else NC_EXP_MAX;
    return v;
}

test nc_the_wider_operand_type_wins {
    assert nc_add_const(-3) == 60;
    assert nc_add_const(64) == 127;
    assert nc_more_bits_wins(7) == 12;
    assert nc_more_bits_wins(65530) == 65535;
    assert nc_mask(-3) == 61;
    assert nc_arm(true, -9) == -9;
    assert nc_arm(false, -9) == 63;
}

// ---------------------------------------------------------------- integers into floats

fn nc_diff(target: i32, guess: i32) -> f64 {
    const d : f64 = target - guess;
    return d;
}

fn nc_u32_to_f64(x: u32) -> f64 {
    return x;
}

fn nc_u8_to_f32(x: u8) -> f32 {
    return x;
}

fn nc_scale(x: f64, i: i32) -> f64 {
    return x * i;
}

fn nc_shift32(x: f32, a: i16) -> f32 {
    return x + a;
}

fn nc_far(x: f64) -> f64 {
    return x + NC_TWO_60;
}

fn nc_f_lt(x: f64, i: i32) -> bool {
    return x < i;
}

test nc_integers_reach_a_float_exactly {
    assert nc_diff(1, 0) == 1.0;
    assert nc_diff(-5, 3) == -8.0;
    assert nc_u32_to_f64(4294967295) == 4294967295.0;
    assert nc_u8_to_f32(255) == 255.0;
    assert nc_scale(0.5, -3) == -1.5;
    assert nc_shift32(0.25, -2) == -1.75;
    assert nc_far(-1152921504606846976.0) == 0.0;
    assert nc_f_lt(0.5, 1);
    assert !nc_f_lt(0.5, -2);
}
