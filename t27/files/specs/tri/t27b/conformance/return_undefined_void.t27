// SPDX-License-Identifier: Apache-2.0
; return_undefined_void.t27 -- conformance spec for t27b (epic #6063, lane: ExprReturn)
; Ported specs end a `-> void` fn with `return undefined;` (a deinit that
; frees nothing, an early exit). `undefined` is the one value of `void`, so
; in Zig the statement is a plain `return;`: the fn stops there and the
; caller goes on. These tests pin down that it stops exactly there -- the
; work before it is kept, the work after it is skipped -- whether it sits in
; a branch, at the end of the body, or alone in a fn that is called or not.
; phi^2 + phi^-2 = 3 | TRINITY

module T27bConformanceReturnUndefinedVoid;

const VoidRetCounter = struct {
    n: u32,
    hits: u32,
};

// Counts the visit, then stops early when asked to.
fn bump(c: *VoidRetCounter, stop: bool) -> void {
    c.hits = c.hits + 1;
    if (stop) {
        return undefined;
    }
    c.n = c.n + 10;
}

// Bumps k times, stopping early on every odd visit; ends with the same
// statement.
fn bump_all(c: *VoidRetCounter, k: u32) -> void {
    var i: u32 = 0;
    while (i < k) {
        bump(c, i % 2 == 1);
        i = i + 1;
    }
    return undefined;
}

// The deinit shape of ported specs: nothing but the statement.
fn release(c: *VoidRetCounter) -> void {
    return undefined;
}

// Never called: the same shape where nothing reaches it.
fn unused_release(c: *VoidRetCounter) -> void {
    return undefined;
}

test an_early_undefined_return_skips_the_rest {
    var c = VoidRetCounter{ .n = 0, .hits = 0 };
    bump(&c, true);
    assert(c.hits == 1);
    assert(c.n == 0);
}

test without_the_early_return_the_rest_runs {
    var c = VoidRetCounter{ .n = 0, .hits = 0 };
    bump(&c, false);
    assert(c.hits == 1);
    assert(c.n == 10);
}

test the_caller_goes_on_after_each_return {
    var c = VoidRetCounter{ .n = 0, .hits = 0 };
    bump_all(&c, 5);
    assert(c.hits == 5);
    assert(c.n == 30);
}

test a_release_that_only_returns_changes_nothing {
    var c = VoidRetCounter{ .n = 7, .hits = 2 };
    release(&c);
    assert(c.n == 7);
    assert(c.hits == 2);
    bump(&c, false);
    assert(c.n == 17);
}
