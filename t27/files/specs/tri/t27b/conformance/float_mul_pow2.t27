// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/float_mul_pow2.t27 -- a float times a power-of-two literal, as the reference
; runs it (gHashTag/t27#6063 lane: ExprBinary(f64 * 2^k)). Every test here passes `t27c test-report`; t27b
; must give the same verdict on each, or refuse the file.
; t27c's optimizer rewrites `x * 2^k` as `x << k` (strength reduction), which Zig refuses for a float `x`.
; It only reaches the top-level statements of a fn body -- an assignment's value, a local's initializer, a
; `return` value -- and only through binary operators. A test body, a statement nested in an `if` or a loop,
; and a call argument are printed as written, so a float times 2, 4 or 8 there is an ordinary multiply.
; Not here (the reference cannot compile it): `return x * 2.0 + y * 4;` with a float `y` at the top of a
; fn body, which comes out as `y << 2`.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceFloatMulPow2;

fn halve(v: f64) -> f64 {
    return v / 2.0;
}

// The multiply is a call argument: not reached by the rewrite.
fn twice_through_call(x: f64) -> f64 {
    return halve(x * 4);
}

// The multiply sits in a nested block: not reached either.
fn scaled_if_positive(x: f64) -> f64 {
    var r: f64 = x;
    if (x > 0.0) {
        r = x * 8;
    }
    return r;
}

// An integer operand is still rewritten, and `<<` agrees with `*` on it.
fn int_times_four(n: i64) -> i64 {
    return n * 4 + 1;
}

test float_literal_times_two_in_an_assert {
    assert(20 - 0.5 * 2 == 19);
    assert(10 - 0.5 * 1 == 9.5);
}

test float_local_times_power_of_two_in_a_test {
    const x: f64 = 1.75;
    const y = x * 4;
    assert(y == 7.0);
    assert(x * 2 == 3.5);
}

test multiply_inside_a_call_argument {
    assert(twice_through_call(3.0) == 6.0);
    assert(twice_through_call(-0.5) == -1.0);
}

test multiply_inside_a_nested_block {
    assert(scaled_if_positive(0.5) == 4.0);
    assert(scaled_if_positive(-2.0) == -2.0);
}

test integer_times_four_is_a_shift {
    assert(int_times_four(5) == 21);
    assert(int_times_four(-3) == -11);
}
