// SPDX-License-Identifier: Apache-2.0
; eval_branch_quota.t27 -- conformance spec for t27b (epic #6063, lane: @setEvalBranchQuota)
; Ported specs open a bench or a fn with `@setEvalBranchQuota(n);`. It raises
; the number of backward branches Zig's compile-time evaluation may take and
; does nothing at run time, so the code around it runs as if it were absent.
; These tests pin that down: the statement before a loop, between two
; statements, with a literal or a module constant, in a fn, a test and a
; bench, and in a fn that a test calls more than once.
; phi^2 + phi^-2 = 3 | TRINITY

module T27bConformanceEvalBranchQuota;

const QUOTA: u32 = 5000;

// Sum of 1..n, after the statement.
fn sum_to(n: u32) -> u32 {
    @setEvalBranchQuota(10000);
    var s: u32 = 0;
    var i: u32 = 1;
    while (i <= n) {
        s = s + i;
        i = i + 1;
    }
    return s;
}

// The statement between two updates, with a module constant.
fn twice_plus(x: u32) -> u32 {
    var y: u32 = x * 2;
    @setEvalBranchQuota(QUOTA);
    y = y + 3;
    return y;
}

// A lower quota than the default is ignored by Zig; nothing changes either.
fn small_quota(x: u32) -> u32 {
    @setEvalBranchQuota(1);
    return x + 1;
}

test the_loop_after_the_statement_runs {
    assert(sum_to(10) == 55);
    assert(sum_to(0) == 0);
    assert(sum_to(100) == 5050);
}

test the_statement_between_two_updates_changes_nothing {
    assert(twice_plus(4) == 11);
    assert(twice_plus(0) == 3);
}

test a_quota_below_the_default_changes_nothing {
    assert(small_quota(41) == 42);
}

test the_statement_in_a_test_body {
    @setEvalBranchQuota(100000);
    var acc: usize = 0;
    for (0..20) |k| {
        acc = acc + k;
    }
    assert(acc == 190);
}

bench quota_then_loop {
    @setEvalBranchQuota(10000);
    var r: u32 = 0;
    for (0..100) |_| {
        r = r + sum_to(5);
    }
}
