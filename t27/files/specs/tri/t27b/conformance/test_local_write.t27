// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/test_local_write.t27 -- a test that declares a local at its top level and then
; writes it again at its top level, as the reference runs it (gHashTag/t27#7422, a lane of #6063). Every
; test here passes `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; What t27c's Zig backend prints since #6295 (`block_fresh_binding` in bootstrap/src/compiler.rs): the
; declaration `var acc: u8 = ..;`, then each later top-level `acc = ..;` as written, a write to that same
; local. Before #6295 the first such write was bound a second time as `const acc = ..;`, a redeclaration
; that Zig refuses, and t27b refused the shape as StmtAssign(reference redeclares) to match.
; The shapes are the corpus's own: an accumulator fed through a fn (specs/tri/mutate/census.t27), a string
; local replaced between reads (the same), a write cursor threaded through calls that fill a buffer
; (specs/tri/t27b/macho.t27), a loop index reset after its loop (specs/port/scripts/gen_w368.t27) and a
; bool flag (specs/compiler/zig_test_shadowing.t27). Then: a compound write, a signed local that goes
; negative, a nested write after the first top-level one, and a struct local replaced whole.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceTestLocalWrite;

pub const LW_OK: u8 = 0;
pub const LW_FAILED: u8 = 1;
pub const LW_STUCK: u8 = 2;

pub const LocalWritePair = struct {
    lo: u32,
    hi: u32,
};

/// The exit code of a run so far, after one more spec: a stuck run stays stuck, a failure stays.
pub fn fold_exit(acc: u8, code: u8) -> u8 {
    if (acc == LW_STUCK) { return LW_STUCK; }
    if (code == LW_STUCK) { return LW_STUCK; }
    if (acc == LW_FAILED) { return LW_FAILED; }
    return code;
}

pub fn twice(v: u32) -> u32 {
    return v * 2;
}

/// The value of the first decimal digit of `line`.
pub fn lead_digit(line: string) -> u32 {
    return (line[0] as u32) - 48;
}

/// Writes `v` and `v + 1` at `at`; returns where the next write goes.
pub fn put_pair(out: []u8, at: usize, v: u8) -> usize {
    out[at] = v;
    out[at + 1] = v + 1;
    return at + 2;
}

test an_accumulator_is_fed_through_a_fn {
    var acc: u8 = LW_OK;
    acc = fold_exit(acc, LW_OK);
    assert(acc == LW_OK);
    acc = fold_exit(acc, LW_FAILED);
    assert(acc == LW_FAILED);
    acc = fold_exit(acc, LW_OK);
    assert(acc == LW_FAILED);
    acc = fold_exit(acc, LW_STUCK);
    acc = fold_exit(acc, LW_OK);
    assert(acc == LW_STUCK);
}

test a_string_local_is_replaced_between_reads {
    var line: string = "7 of 9 killed";
    var total: u32 = lead_digit(line);
    line = "5 of 5";
    total = total + lead_digit(line);
    assert(total == 12);
    assert(line.len == 6);
}

test a_cursor_threads_through_the_calls_that_fill_a_buffer {
    var out: [8]u8 = undefined;
    var p: usize = put_pair(&out, 0, 10);
    p = put_pair(&out, p, 20);
    p = put_pair(&out, p, 30);
    assert(p == 6);
    assert(out[0] == 10 and out[1] == 11);
    assert(out[2] == 20 and out[5] == 31);
}

test a_loop_index_is_reset_after_its_loop {
    var k: usize = 0;
    var sum: u32 = 0;
    while (k < 4) {
        sum = sum + twice(k as u32);
        k += 1;
    }
    k = 0;
    while (k < 3) {
        sum = sum + 1;
        k += 1;
    }
    assert(k == 3);
    assert(sum == 15);
}

test a_bool_flag_is_written_again {
    var ok: bool = twice(1) == 2;
    assert(ok == true);
    ok = twice(2) == 5;
    assert(ok == false);
}

test a_compound_write_reads_the_local {
    var acc: u64 = 1;
    acc += twice(3) as u64;
    assert(acc == 7);
    acc *= 6;
    assert(acc == 42);
}

test a_signed_local_goes_negative {
    var bal: i64 = 5;
    bal = bal - (twice(6) as i64);
    assert(bal == -7);
    bal = bal * -3;
    assert(bal == 21);
}

test a_nested_write_after_the_first_writes_the_same_local {
    var n: u32 = 1;
    n = twice(n);
    if (n == 2) {
        n = n + 40;
    }
    assert(n == 42);
}

test a_struct_local_is_replaced_whole {
    var pair: LocalWritePair = LocalWritePair{ .lo = 1, .hi = 2 };
    assert(pair.lo + pair.hi == 3);
    pair = LocalWritePair{ .lo = twice(5), .hi = twice(7) };
    assert(pair.lo == 10);
    assert(pair.hi == 14);
}
