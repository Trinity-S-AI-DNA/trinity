// SPDX-License-Identifier: Apache-2.0
; type_alias.t27 -- conformance spec for t27b (epic #6063, lane: type (alias), issue #7241)
; `const Name = T;` with no type annotation names a type, not a value.
; t27c's Zig backend emits it as `const Name = T;`, which Zig reads as a
; type alias: every place that writes `Name` gets exactly `T`. These tests
; pin that down for a scalar alias, an alias of an alias, an alias of an
; array whose length is a named constant, and an alias of a struct.
; phi^2 + phi^-2 = 3 | TRINITY

module T27bConformanceTypeAlias;

const WIDTH: usize = 4;

const Code = u8;
const Signed = i8;
const Small = Code;
const Word = [WIDTH]Code;

const CodePair = struct {
    lo: Code,
    hi: Code,
};

const CodeDuo = CodePair;

// An alias of u8 wraps exactly like u8 does.
fn bump(c: Code) -> Code {
    return c +% 1;
}

// An alias of an alias is still u8.
fn twice(s: Small) -> Small {
    const t: Small = s *% 2;
    return t;
}

fn negate(x: Signed) -> Signed {
    return 0 - x;
}

// An array alias: four Code values, indexed and summed.
fn word_sum(w: Word) -> u32 {
    var s: u32 = 0;
    var i: usize = 0;
    while (i < WIDTH) {
        s = s + (w[i] as u32);
        i = i + 1;
    }
    return s;
}

fn make_word(base: Code) -> Word {
    var w: Word = [base, base, base, base];
    w[1] = base +% 1;
    w[3] = base +% 3;
    return w;
}

// A struct alias: same fields, same layout, interchangeable with CodePair.
fn swap(p: CodeDuo) -> CodePair {
    return CodePair{ .lo = p.hi, .hi = p.lo };
}

fn spread(p: CodePair) -> Code {
    return p.hi - p.lo;
}

test a_scalar_alias_is_the_aliased_type {
    assert(bump(41) == 42);
    assert(bump(255) == 0);
    assert(negate(5) == -5);
    assert(negate(-128 + 1) == 127);
}

test an_alias_of_an_alias {
    assert(twice(21) == 42);
    assert(twice(200) == 144);
}

test an_array_alias {
    const w = make_word(10);
    assert(w[0] == 10);
    assert(w[1] == 11);
    assert(w[3] == 13);
    assert(word_sum(w) == 44);
}

test a_struct_alias {
    const p: CodeDuo = CodeDuo{ .lo = 3, .hi = 9 };
    const q = swap(p);
    assert(q.lo == 9);
    assert(q.hi == 3);
    assert(spread(p) == 6);
    assert(spread(swap(q)) == 6);
}
