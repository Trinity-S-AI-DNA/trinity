// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/array_repeat_text.t27 -- an array literal written as `[v] ** n` or `[a, b] ** n`,
; as the reference runs it (gHashTag/t27#6063 lane: ExprArrayLiteral(repeat), issue #7112). Every test here
; passes `t27c test-report`; t27b must give the same verdict on each, or refuse the file.
; The parser keeps the element list of `[1]` or `[K, f()]` as text. t27c's Zig backend pastes that text
; back as `.{ 1 } ** n` or `.{ K, f() } ** n`, so Zig evaluates the elements once and repeats them n times.
; The count may be a literal or a module constant, and the total must be the array's length.
; Not here: `[] ** n` (no elements; Zig refuses it for any non-empty array), an element that is not a
; literal, a name, a call or a negated literal (the pasted text could mean something else in Zig), and a
; repeat whose total is not the array's length (Zig refuses it).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceArrayRepeatText;

const SEED: i32 = 7;
const QUAD: usize = 4;
const SEVENS: [3]i32 = [7] ** 3;
var scratch: [8]u8 = [0] ** 8;

fn minus_two() -> i32 {
    return -2;
}

fn sum_bytes(frame: []const u8) -> u32 {
    var s: u32 = 0;
    var i: usize = 0;
    while (i < frame.len) {
        s = s + frame[i];
        i = i + 1;
    }
    return s;
}

fn sum_i32(xs: []const i32) -> i32 {
    var s: i32 = 0;
    var i: usize = 0;
    while (i < xs.len) {
        s = s + xs[i];
        i = i + 1;
    }
    return s;
}

test one_element_repeated {
    var frame: [100]u8 = [1] ** 100;
    assert(sum_bytes(&frame) == 100);
    frame[42] = 9;
    assert(sum_bytes(&frame) == 108);
    assert(frame[41] == 1);
    assert(frame[42] == 9);
}

test two_elements_repeated {
    var p: [6]i32 = [1, 2] ** 3;
    assert(sum_i32(&p) == 9);
    p[5] = 10;
    assert(p[3] == 2);
    assert(p[4] == 1);
    assert(sum_i32(&p) == 17);
}

test names_and_calls_are_evaluated {
    var q: [4]i32 = [SEED, minus_two()] ** 2;
    assert(sum_i32(&q) == 10);
    assert(q[2] == 7);
    assert(q[3] == -2);
}

test a_count_from_a_module_constant {
    var r: [4]i32 = [-1] ** QUAD;
    assert(sum_i32(&r) == -4);
    r[0] = 5;
    assert(sum_i32(&r) == 2);
}

test module_level_repeats {
    assert(sum_i32(&SEVENS) == 21);
    assert(sum_bytes(&scratch) == 0);
    scratch[5] = 3;
    assert(sum_bytes(&scratch) == 3);
    assert(scratch[7] == 0);
}
