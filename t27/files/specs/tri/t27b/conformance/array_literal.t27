// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/conformance/array_literal.t27 -- the array-literal shapes t27b lowers, as the reference
; runs them (gHashTag/t27#6063 lane: ExprArrayLiteral). Every test here passes `t27c test-report`; t27b must
; give the same verdict on each, or refuse the file.
; What t27c's Zig backend prints, and so what each shape means:
;   - `const xs = &[_]T{ a, b }` is `const xs = &.{ a, b }`: a pointer to a tuple. Passed where a callee
;     declares `[]const E`, it coerces to a slice of E, whatever T says; `xs.len` is the element count.
;   - `return []T{};` and `return [];` in a fn returning a slice are `@constCast(&[_]E{ })`: an empty slice.
;   - an untyped module constant bound to a list is `.{ ... }`, a tuple; one nothing names is never
;     analyzed, so its elements need no type.
; Not here (t27b refuses them): indexing such a local (its elements are comptime values in the
; reference), a `var` one, and one passed to callees with different element types.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bConformanceArrayLiteral;

const UNUSED_NAMES = ["source", "headline", "body"];

fn sum(xs: []const f64) -> f64 {
    var s: f64 = 0;
    for (xs) |x| {
        s += x;
    }
    return s;
}

fn total(xs: []const i64) -> i64 {
    var s: i64 = 0;
    for (xs) |x| {
        s += x;
    }
    return s;
}

fn none() -> []str {
    return []str{};
}

fn no_bytes() -> []const u8 {
    return [];
}

test addr_of_literal_is_a_const_slice {
    const xs = &[_]f64{ 1.5, 2.5, 3.0 };
    assert(sum(xs) == 7.0);
    assert(xs.len == 3);
}

test integer_elements_become_the_callee_element_type {
    const xs = &[_]f64{ 1, 2, 4 };
    assert(sum(xs) == 7.0);
}

test the_declared_element_type_is_not_the_one_used {
    const ys = &[_]u8{ 100, 200 };
    assert(total(ys) == 300);
}

test one_element {
    const ys = &[_]i64{ -7 };
    assert(total(ys) == -7);
    assert(ys.len == 1);
}

test passed_twice {
    const ys = &[_]i64{ 2, 3 };
    assert(total(ys) + total(ys) == 10);
}

test empty_literals_are_empty_slices {
    assert(none().len == 0);
    assert(no_bytes().len == 0);
}
