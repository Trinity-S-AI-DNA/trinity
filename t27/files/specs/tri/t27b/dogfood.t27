// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/dogfood.t27 -- which specs are our own, and what one lab row of them means (gHashTag/t27#6457, Refs #6063)
; Owner's order, 2026-10-05 ~15:30Z: t27b is developed by dogfooding -- our own .t27 and t27c, written on
; ourselves, fixing what that turns up. This file is the one home of the dogfood rule:
;   - which specs count as our own (a path prefix, or a spec whose gen-c output a tool loads);
;   - how one lab record of such a spec is classified: a t27b lane (the reference passes, t27b does not)
;     or a t27c issue (the reference itself does not pass);
;   - the tie-break that puts families blocking our own specs first in the lane order, never above a
;     family that unlocks more files;
;   - the words a report prints for each row and each group.
; Verdict codes are steward.t27's: PASS = 0, PASS_VACUOUS = 1, BLOCKED = 2, FRONTEND = 3, CODEGEN = 4,
; FAIL = 5, MISMATCH = 6, CRASH = 7, TIMEOUT = 8, NOT_RUN = 9, MISSING = 10, LAB_ERROR = 11.
; Not here: reading the lab JSON, matching a path against the prefixes, finding the loaders. Those are
; I/O, and t27 has no I/O yet; a reader calls these functions through `t27c gen-c`.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bDogfood;

/// Path prefixes that make a spec our own, comma separated. A reader matches path prefixes only.
pub const OWN_PREFIXES : str = "specs/tri/,specs/queen/,specs/compiler/,specs/blog/,specs/automation/,specs/tools/";

/// A spec whose generated code a tool loads is our own wherever it sits. The loaders live here.
pub const LOADER_DIR : str = "scripts/tri_loop/";

/// The dogfood row of one spec in one lab run.
pub const ROW_NONE : u8 = 0;
pub const ROW_PASS : u8 = 1;
pub const ROW_VACUOUS : u8 = 2;
pub const ROW_T27B_LANE : u8 = 3;
pub const ROW_T27C_ISSUE : u8 = 4;
pub const ROW_UNJUDGED : u8 = 5;

/// The words a report prints for each row, in row order, comma separated.
pub const ROW_NAMES : str = "-,PASS,VACUOUS,T27B-LANE,T27C-ISSUE,UNJUDGED";

/// The two groups a dogfood report is about, and what each one asks for.
pub const GROUP_T27B_LANE : str = "t27b-only blocked -- the reference passes, t27b does not: a t27b lane";
pub const GROUP_T27C_ISSUE : str = "reference-blocked -- the reference itself does not pass: a t27c issue to file";

/// Either marker makes a spec our own.
pub fn own_spec(prefix_match: bool, fed: bool) -> bool {
    if (prefix_match) { return true; }
    if (fed) { return true; }
    return false;
}

/// One lab record of one spec. A reference verdict above TIMEOUT is no verdict (not run, missing,
/// lab error); any other reference verdict but a pass makes the row a t27c issue, whatever t27b did.
pub fn dogfood_row(own: bool, reference: u8, t: u8) -> u8 {
    if (own == false) { return ROW_NONE; }
    if (reference > 8) { return ROW_UNJUDGED; }
    if (reference > 1) { return ROW_T27C_ISSUE; }
    if (t == 0) { return ROW_PASS; }
    if (t == 1) { return ROW_VACUOUS; }
    return ROW_T27B_LANE;
}

/// Rows a report lists one by one: the two groups that are work.
pub fn is_work(row: u8) -> bool {
    if (row == ROW_T27B_LANE) { return true; }
    if (row == ROW_T27C_ISSUE) { return true; }
    return false;
}

/// Lane order: the higher steward.t27 lane_score goes first; among equal scores the family that blocks
/// more of our own specs goes first. Only a tie-break: our own specs never outrank a higher score.
pub fn lane_before(score_a: u32, own_a: u32, score_b: u32, own_b: u32) -> bool {
    if (score_a != score_b) { return score_a > score_b; }
    return own_a > own_b;
}

test own_by_prefix_or_loader {
    assert own_spec(true, false);
    assert own_spec(false, true);
    assert own_spec(true, true);
    assert own_spec(false, false) == false;
}

test not_own_is_no_row {
    assert dogfood_row(false, 0, 2) == ROW_NONE;
    assert dogfood_row(false, 2, 2) == ROW_NONE;
}

test both_pass {
    assert dogfood_row(true, 0, 0) == ROW_PASS;
    assert dogfood_row(true, 0, 1) == ROW_VACUOUS;
}

test reference_passes_t27b_does_not_is_a_lane {
    assert dogfood_row(true, 0, 2) == ROW_T27B_LANE;
    assert dogfood_row(true, 0, 3) == ROW_T27B_LANE;
    assert dogfood_row(true, 0, 5) == ROW_T27B_LANE;
    assert dogfood_row(true, 0, 6) == ROW_T27B_LANE;
    assert dogfood_row(true, 0, 8) == ROW_T27B_LANE;
}

test reference_not_passing_is_a_t27c_issue {
    assert dogfood_row(true, 2, 2) == ROW_T27C_ISSUE;
    assert dogfood_row(true, 5, 5) == ROW_T27C_ISSUE;
    assert dogfood_row(true, 8, 2) == ROW_T27C_ISSUE;
    assert dogfood_row(true, 2, 0) == ROW_T27C_ISSUE;
}

test no_reference_verdict_is_unjudged {
    assert dogfood_row(true, 9, 0) == ROW_UNJUDGED;
    assert dogfood_row(true, 10, 2) == ROW_UNJUDGED;
    assert dogfood_row(true, 11, 2) == ROW_UNJUDGED;
}

test only_lanes_and_issues_are_work {
    assert is_work(ROW_T27B_LANE);
    assert is_work(ROW_T27C_ISSUE);
    assert is_work(ROW_PASS) == false;
    assert is_work(ROW_VACUOUS) == false;
    assert is_work(ROW_UNJUDGED) == false;
    assert is_work(ROW_NONE) == false;
}

test own_specs_break_ties {
    assert lane_before(5000, 1, 5000, 0);
    assert lane_before(5000, 0, 5000, 1) == false;
    assert lane_before(5000, 2, 5000, 2) == false;
}

test own_specs_never_outrank_a_score {
    assert lane_before(5000, 9, 5001, 0) == false;
    assert lane_before(5001, 0, 5000, 9);
    assert lane_before(1000, 0, 999, 999);
}

invariant rows_are_distinct {
    assert ROW_NONE == 0;
    assert ROW_PASS < ROW_VACUOUS;
    assert ROW_VACUOUS < ROW_T27B_LANE;
    assert ROW_T27B_LANE < ROW_T27C_ISSUE;
    assert ROW_T27C_ISSUE < ROW_UNJUDGED;
    assert dogfood_row(true, 0, 2) != dogfood_row(true, 2, 2);
}
