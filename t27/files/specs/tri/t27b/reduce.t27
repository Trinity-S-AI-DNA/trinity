// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/reduce.t27 -- what `tri t27b reduce` decides (gHashTag/t27#6445, Refs #6488 #6063)
; `tri t27b reduce <spec> [--family X | --disagree]` shrinks a blocked or disagreeing spec to a minimal
; repro by delta debugging (ddmin, Zeller and Hildebrandt 2002), first over top-level declarations, then
; over statements, then over expressions, the C-Reduce / Perses idea applied to t27. This file is the one
; home of every decision the reducer makes:
;   - the interestingness test, reference guard first: a candidate is kept only when the reference path
;     (t27c test-report, Zig) passes it. Without the guard the reducer drifts into a reference bug and
;     hands a lane a file the reference cannot compile (slips Q38, Q40);
;   - the t27b half of that test, asked before the slow reference run so most candidates cost
;     milliseconds;
;   - the ddmin bookkeeping: how many chunks, where chunk i starts and ends, how the granularity moves
;     after a removal and after a round with none;
;   - the level order (declarations, statements, expressions) and when the reducer stops;
;   - the goal the issue sets: fewer than GOAL_LINES lines.
; Verdict codes are steward.t27's: PASS = 0, PASS_VACUOUS = 1, BLOCKED = 2, FRONTEND = 3, CODEGEN = 4,
; FAIL = 5, MISMATCH = 6, CRASH = 7, TIMEOUT = 8, NOT_RUN = 9, MISSING = 10, LAB_ERROR = 11.
; Not here: splitting the source into units, running t27c and t27b, the cache and the fixture's header
; text. Those are I/O and string building, which t27 has no construct for yet; the reader
; scripts/tri_loop/t27b_reduce.py calls these functions through `t27c gen-c` (debt #6198).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bReduce;

/// Interestingness modes. FAMILY: t27b's first blocker is the named construct family. DISAGREE: t27b
/// runs the spec and disagrees with the reference (a failing test, a JIT/interpreter mismatch, a crash,
/// or a per-test verdict that differs from the reference's).
pub const MODE_FAMILY : u8 = 0;
pub const MODE_DISAGREE : u8 = 1;

/// Why a candidate is kept or not. KEEP is the only interesting answer.
pub const KEEP : u8 = 0;
pub const REFERENCE_NOT_PASS : u8 = 1;
pub const REFERENCE_RAN_NO_TEST : u8 = 2;
pub const T27B_NOT_BLOCKED : u8 = 3;
pub const OTHER_FAMILY : u8 = 4;
pub const NO_DISAGREEMENT : u8 = 5;
pub const BAD_MODE : u8 = 6;

/// The words a report prints for each answer, in code order, comma separated.
pub const ANSWER_NAMES : str = "KEEP,REFERENCE-NOT-PASS,REFERENCE-RAN-NO-TEST,T27B-NOT-BLOCKED,OTHER-FAMILY,NO-DISAGREEMENT,BAD-MODE";

/// Reduction levels, in the order they run.
pub const LEVEL_DECL : u8 = 0;
pub const LEVEL_STMT : u8 = 1;
pub const LEVEL_EXPR : u8 = 2;
pub const LEVEL_DONE : u8 = 3;

/// The words for each level, in level order, comma separated.
pub const LEVEL_NAMES : str = "declarations,statements,expressions,done";

/// The issue's bar for a useful repro: fewer than this many lines, header included.
pub const GOAL_LINES : u32 = 20;

/// Candidates one reduce may try before it stops and writes what it has.
pub const CANDIDATE_BUDGET : u32 = 4000;

/// The fixtures directory, relative to the repository root. Outside specs/, so a fixture is not a
/// second module of the same name in the corpus the lab ratchets.
pub const FIXTURES_DIR : str = "cli/t27b/tests/reduced";

/// The line every fixture's header starts its family line with; `tri t27b next` reads it back.
pub const FAMILY_TAG : str = "// t27b-reduce family: ";

/// t27b's verdicts that disagree with a passing reference by themselves: FAIL, MISMATCH, CRASH.
pub fn t27b_disagrees(t: u8) -> bool {
    if (t == 5) { return true; }
    if (t == 6) { return true; }
    if (t == 7) { return true; }
    return false;
}

/// The t27b half of the test, asked first: can this candidate still be interesting, whatever the
/// reference says? In DISAGREE mode a pass can still differ test by test, so only verdicts that ran no
/// test (BLOCKED, FRONTEND, CODEGEN, TIMEOUT) are out.
pub fn t27b_side(mode: u8, t: u8, first_is_family: bool) -> bool {
    if (mode == MODE_FAMILY) {
        if (t != 2) { return false; }
        return first_is_family;
    }
    if (mode == MODE_DISAGREE) {
        if (t27b_disagrees(t)) { return true; }
        if (t == 0) { return true; }
        if (t == 1) { return true; }
        return false;
    }
    return false;
}

/// The whole test. The reference guard comes first: a reference that does not pass ends it, whatever
/// t27b did. need_tests is true when the reference ran tests on the original spec; a candidate whose
/// reference run executes none then proves nothing about the code (Zig never analyses an unreached
/// function), so it is not kept either.
pub fn answer(mode: u8, reference: u8, ref_tests: u32, need_tests: bool, t: u8, first_is_family: bool, disagreements: u32) -> u8 {
    if (mode > MODE_DISAGREE) { return BAD_MODE; }
    if (reference != 0) { return REFERENCE_NOT_PASS; }
    if (need_tests) {
        if (ref_tests == 0) { return REFERENCE_RAN_NO_TEST; }
    }
    if (mode == MODE_FAMILY) {
        if (t != 2) { return T27B_NOT_BLOCKED; }
        if (first_is_family == false) { return OTHER_FAMILY; }
        return KEEP;
    }
    if (t27b_disagrees(t)) { return KEEP; }
    if (disagreements > 0) {
        if (t == 0) { return KEEP; }
        if (t == 1) { return KEEP; }
    }
    return NO_DISAGREEMENT;
}

pub fn interesting(mode: u8, reference: u8, ref_tests: u32, need_tests: bool, t: u8, first_is_family: bool, disagreements: u32) -> bool {
    return answer(mode, reference, ref_tests, need_tests, t, first_is_family, disagreements) == KEEP;
}

/// ddmin: the first granularity for len units. One unit is one chunk; none is nothing to do.
pub fn start_chunks(len: u32) -> u32 {
    if (len < 2) { return len; }
    return 2;
}

/// Where chunk i of n starts among len units: the chunks split len as evenly as integer division does.
pub fn chunk_lo(len: u32, n: u32, i: u32) -> u32 {
    if (n == 0) { return 0; }
    const lo : u64 = (len as u64) * (i as u64) / (n as u64);
    return lo as u32;
}

/// Where chunk i of n ends (exclusive).
pub fn chunk_hi(len: u32, n: u32, i: u32) -> u32 {
    return chunk_lo(len, n, i + 1);
}

/// After chunk removal leaves len units: one chunk fewer, never below two, never above len.
pub fn after_removal(n: u32, len: u32) -> u32 {
    var m : u32 = 2;
    if (n > 2) { m = n - 1; }
    if (m > len) { m = len; }
    return m;
}

/// After a round of n chunks in which no removal was interesting: double the granularity, up to one
/// unit per chunk; 0 when the round already was one unit per chunk (1-minimal at this level).
pub fn after_round(n: u32, len: u32) -> u32 {
    if (n >= len) { return 0; }
    const m : u32 = n * 2;
    if (m > len) { return len; }
    return m;
}

/// The level after this one. After expressions the reducer starts over at declarations when the
/// cycle removed anything, because a removal deeper down can free a declaration; otherwise it is done.
pub fn next_level(level: u8, progressed: bool) -> u8 {
    if (level < LEVEL_EXPR) { return level + 1; }
    if (level == LEVEL_EXPR) {
        if (progressed) { return LEVEL_DECL; }
    }
    return LEVEL_DONE;
}

/// Whether the reducer may try another candidate.
pub fn within_budget(tried: u32) -> bool {
    return tried < CANDIDATE_BUDGET;
}

/// Whether a fixture of this many lines meets the issue's bar.
pub fn goal_met(lines: u32) -> bool {
    return lines < GOAL_LINES;
}

test guard_rejects_reference_fail {
    assert_eq(answer(MODE_FAMILY, 5, 2, true, 2, true, 0), REFERENCE_NOT_PASS);
    assert_eq(answer(MODE_DISAGREE, 5, 2, true, 5, false, 3), REFERENCE_NOT_PASS);
}

test guard_rejects_reference_blocked_and_unjudged {
    assert_eq(answer(MODE_FAMILY, 2, 0, false, 2, true, 0), REFERENCE_NOT_PASS);
    assert_eq(answer(MODE_FAMILY, 8, 0, false, 2, true, 0), REFERENCE_NOT_PASS);
    assert_eq(answer(MODE_FAMILY, 9, 0, false, 2, true, 0), REFERENCE_NOT_PASS);
    assert_eq(answer(MODE_FAMILY, 11, 0, false, 2, true, 0), REFERENCE_NOT_PASS);
}

test guard_wants_tests_when_the_original_had_them {
    assert_eq(answer(MODE_FAMILY, 0, 0, true, 2, true, 0), REFERENCE_RAN_NO_TEST);
    assert_eq(answer(MODE_FAMILY, 0, 0, false, 2, true, 0), KEEP);
    assert_eq(answer(MODE_FAMILY, 0, 1, true, 2, true, 0), KEEP);
}

test family_needs_blocked_and_the_family_first {
    assert_eq(answer(MODE_FAMILY, 0, 3, true, 2, true, 0), KEEP);
    assert_eq(answer(MODE_FAMILY, 0, 3, true, 2, false, 0), OTHER_FAMILY);
    assert_eq(answer(MODE_FAMILY, 0, 3, true, 0, true, 0), T27B_NOT_BLOCKED);
    assert_eq(answer(MODE_FAMILY, 0, 3, true, 3, true, 0), T27B_NOT_BLOCKED);
}

test disagree_kinds {
    assert_eq(answer(MODE_DISAGREE, 0, 3, true, 5, false, 0), KEEP);
    assert_eq(answer(MODE_DISAGREE, 0, 3, true, 6, false, 0), KEEP);
    assert_eq(answer(MODE_DISAGREE, 0, 3, true, 7, false, 0), KEEP);
    assert_eq(answer(MODE_DISAGREE, 0, 3, true, 0, false, 1), KEEP);
    assert_eq(answer(MODE_DISAGREE, 0, 3, true, 1, false, 2), KEEP);
    assert_eq(answer(MODE_DISAGREE, 0, 3, true, 0, false, 0), NO_DISAGREEMENT);
    assert_eq(answer(MODE_DISAGREE, 0, 3, true, 2, false, 4), NO_DISAGREEMENT);
    assert_eq(answer(MODE_DISAGREE, 0, 3, true, 8, false, 0), NO_DISAGREEMENT);
}

test bad_mode_is_never_kept {
    assert_eq(answer(2, 0, 3, true, 2, true, 0), BAD_MODE);
    assert(interesting(2, 0, 3, true, 2, true, 0) == false);
    assert(t27b_side(2, 2, true) == false);
}

test interesting_is_keep {
    assert(interesting(MODE_FAMILY, 0, 1, true, 2, true, 0));
    assert(interesting(MODE_FAMILY, 5, 1, true, 2, true, 0) == false);
}

test t27b_side_is_the_t27b_half {
    assert(t27b_side(MODE_FAMILY, 2, true));
    assert(t27b_side(MODE_FAMILY, 2, false) == false);
    assert(t27b_side(MODE_FAMILY, 0, true) == false);
    assert(t27b_side(MODE_DISAGREE, 5, false));
    assert(t27b_side(MODE_DISAGREE, 0, false));
    assert(t27b_side(MODE_DISAGREE, 1, false));
    assert(t27b_side(MODE_DISAGREE, 2, false) == false);
    assert(t27b_side(MODE_DISAGREE, 3, false) == false);
}

test chunks_cover_every_unit_once {
    assert_eq(chunk_lo(10, 3, 0), 0);
    assert_eq(chunk_hi(10, 3, 0), 3);
    assert_eq(chunk_lo(10, 3, 1), 3);
    assert_eq(chunk_hi(10, 3, 1), 6);
    assert_eq(chunk_lo(10, 3, 2), 6);
    assert_eq(chunk_hi(10, 3, 2), 10);
    assert_eq(chunk_hi(7, 7, 6), 7);
    assert_eq(chunk_lo(5, 0, 1), 0);
}

test chunks_do_not_overflow {
    assert_eq(chunk_hi(4000000000, 4, 3), 4000000000);
    assert_eq(chunk_lo(4000000000, 4, 1), 1000000000);
}

test granularity {
    assert_eq(start_chunks(0), 0);
    assert_eq(start_chunks(1), 1);
    assert_eq(start_chunks(9), 2);
    assert_eq(after_removal(2, 9), 2);
    assert_eq(after_removal(5, 9), 4);
    assert_eq(after_removal(5, 3), 3);
    assert_eq(after_removal(2, 1), 1);
    assert_eq(after_round(2, 9), 4);
    assert_eq(after_round(8, 9), 9);
    assert_eq(after_round(9, 9), 0);
    assert_eq(after_round(1, 1), 0);
}

test levels_run_in_order_and_repeat_only_on_progress {
    assert_eq(next_level(LEVEL_DECL, false), LEVEL_STMT);
    assert_eq(next_level(LEVEL_STMT, false), LEVEL_EXPR);
    assert_eq(next_level(LEVEL_EXPR, true), LEVEL_DECL);
    assert_eq(next_level(LEVEL_EXPR, false), LEVEL_DONE);
    assert_eq(next_level(LEVEL_DONE, true), LEVEL_DONE);
}

test budget_and_goal {
    assert(within_budget(0));
    assert(within_budget(CANDIDATE_BUDGET - 1));
    assert(within_budget(CANDIDATE_BUDGET) == false);
    assert(goal_met(19));
    assert(goal_met(20) == false);
}

invariant guard_first {
    assert(interesting(MODE_FAMILY, 2, 5, false, 2, true, 0) == false);
    assert(interesting(MODE_DISAGREE, 5, 5, false, 7, false, 9) == false);
}
