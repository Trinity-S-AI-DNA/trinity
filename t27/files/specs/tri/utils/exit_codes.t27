// t27/specs/
// | | φ² + 1/φ² = 3 | TRINITY

module TriExitCodes;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    // Standard exit codes for the TRI CLI (gHashTag/trinity specs/tri/tri_exit_codes.tri).
    pub const ExitCode = enum(u8) {
        success = 0,
        command_error = 1,
        validation_error = 2,
        runtime_error = 3,
        timeout = 4,
        job_failed = 5,
        artifact_failed = 6,
        internal_error = 7,
    };

    // exitWithCode calls std.process.exit with this number.
    fn exit_code_value(code: ExitCode) -> u8 {
        return @intFromEnum(code);
    }

    // exitInternalError exits with internal_error.
    fn internal_error_code() -> u8 {
        return exit_code_value(ExitCode.internal_error);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    test "success_is_zero" {
        assert(exit_code_value(ExitCode.success) == 0);
    }

    test "internal_error_is_seven" {
        assert(internal_error_code() == 7);
    }

    test "timeout_is_four" {
        assert(exit_code_value(ExitCode.timeout) == 4);
    }
