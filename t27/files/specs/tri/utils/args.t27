// SPDX-License-Identifier: Apache-2.0
// t27/specs/tri/utils/args.t27
// Command-line words: options, values, positionals | φ² + 1/φ² = 3 | TRINITY
// Restored 2026-10-07 from trinity src/tri/gen_args.zig (generated from
// specs/tri/tri_args.tri). The port was `fn parse(allocator) -> void` with
// `_ = allocator;` and one test, `then true`, so it checked nothing (and the
// Lean model of it split the dotted type std.mem.Allocator into three
// parameters, ci-gates section 342). The Zig parse walks argv[1..] once and
// sorts every word, and that rule is what this spec states, over one word
// at a time so it needs no allocator and no hash map:
//   - "--" (before any "--") ends the options; every later word is positional;
//   - "--name" or "--name=value" is a long option; the name ends at the first
//     '=' and the value is the rest;
//   - "-x" is one short option; "-xyz" is a group of short flags;
//   - anything else, a lone "-" included, is positional;
//   - an option word with no '=' value that expects a value takes the next
//     word as its value when there is one and it does not start with '-'.
// Which options expect a value comes from the caller's Arg table in the Zig
// (argExpectsValue); here it is a parameter. Refused, not ported: the Zig's
// first pass counts a lone "-" as an option while its second pass stores it
// as a positional, so "prog -" writes one past the positional array.

module TriArgs;
    use base::types;

    // ═══════════════════════════════════════════════════════════
    // 1. Constants
    // ═══════════════════════════════════════════════════════════

    pub const WORD_DOUBLE_DASH : u8 = 0;
    pub const WORD_LONG : u8 = 1;
    pub const WORD_SHORT : u8 = 2;
    pub const WORD_SHORT_GROUP : u8 = 3;
    pub const WORD_POSITIONAL : u8 = 4;

    pub const NONE : usize = 18446744073709551615;

    // ═══════════════════════════════════════════════════════════
    // 2. Core Functions
    // ═══════════════════════════════════════════════════════════

    fn starts_with_dash(word: []const u8) -> bool {
        return word.len > 0 and word[0] == '-';
    }

    // the kind of one argv word; after_double_dash is true once "--" was seen
    fn word_kind(word: []const u8, after_double_dash: bool) -> u8 {
        if (after_double_dash) {
            return WORD_POSITIONAL;
        }
        if (word.len >= 2 and word[0] == '-' and word[1] == '-') {
            if (word.len == 2) {
                return WORD_DOUBLE_DASH;
            }
            return WORD_LONG;
        }
        if (word.len == 2 and word[0] == '-') {
            return WORD_SHORT;
        }
        if (word.len > 2 and word[0] == '-') {
            return WORD_SHORT_GROUP;
        }
        return WORD_POSITIONAL;
    }

    // for a long option word, the index in the word of the first '=', or NONE
    fn eq_index(word: []const u8) -> usize {
        var i : usize = 2;
        while (i < word.len) {
            if (word[i] == '=') {
                return i;
            }
            i = i + 1;
        }
        return NONE;
    }

    // the length of a long option's name: "--name=value" and "--name" give 4
    fn long_name_len(word: []const u8) -> usize {
        const eq = eq_index(word);
        if (eq == NONE) {
            return word.len - 2;
        }
        return eq - 2;
    }

    // whether an option word takes the next argv word as its value
    fn takes_next(word: []const u8, expects_value: bool, has_next: bool, next: []const u8) -> bool {
        const kind = word_kind(word, false);
        if (kind == WORD_LONG and eq_index(word) != NONE) {
            return false;
        }
        if (kind != WORD_LONG and kind != WORD_SHORT) {
            return false;
        }
        return expects_value and has_next and !starts_with_dash(next);
    }

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests
    // ═══════════════════════════════════════════════════════════

    // 1 when word has the kind want (before any "--")
    fn kind_is(word: []const u8, want: u8) -> usize {
        if (word_kind(word, false) == want) {
            return 1;
        }
        return 0;
    }

    fn kinds() -> usize {
        return kind_is("--", WORD_DOUBLE_DASH) + kind_is("--verbose", WORD_LONG) + kind_is("--out=a.txt", WORD_LONG)
            + kind_is("--=", WORD_LONG) + kind_is("-v", WORD_SHORT) + kind_is("-vxz", WORD_SHORT_GROUP)
            + kind_is("-", WORD_POSITIONAL) + kind_is("", WORD_POSITIONAL) + kind_is("file", WORD_POSITIONAL)
            + kind_is("a-b", WORD_POSITIONAL) + kind_is("---", WORD_LONG) + kind_is("-ab", WORD_SHORT_GROUP);
    }

    // after "--" every word is positional, "--" itself too
    fn after_dd() -> usize {
        var n : usize = 0;
        if (word_kind("--", true) == WORD_POSITIONAL) { n = n + 1; }
        if (word_kind("--x", true) == WORD_POSITIONAL) { n = n + 1; }
        if (word_kind("-v", true) == WORD_POSITIONAL) { n = n + 1; }
        if (word_kind("-vxz", true) == WORD_POSITIONAL) { n = n + 1; }
        return n;
    }

    // the positional words among four, each word sorted as the Zig's second
    // pass sorts it, with no option expecting a value
    fn positional_of4(a: []const u8, b: []const u8, c: []const u8, d: []const u8) -> usize {
        var dd = false;
        var n : usize = 0;
        const k1 = word_kind(a, dd);
        if (k1 == WORD_DOUBLE_DASH) { dd = true; }
        if (k1 == WORD_POSITIONAL) { n = n + 1; }
        const k2 = word_kind(b, dd);
        if (k2 == WORD_DOUBLE_DASH) { dd = true; }
        if (k2 == WORD_POSITIONAL) { n = n + 1; }
        const k3 = word_kind(c, dd);
        if (k3 == WORD_DOUBLE_DASH) { dd = true; }
        if (k3 == WORD_POSITIONAL) { n = n + 1; }
        const k4 = word_kind(d, dd);
        if (k4 == WORD_POSITIONAL) { n = n + 1; }
        return n;
    }

    fn positionals() -> usize {
        // "a" "b" "c" "d" = 4; "-v" "a" "--x" "b" = 2; "--" "-v" "--" "x" = 3;
        // "--" "--" "--" "--" = 3 (only the first ends the options)
        return positional_of4("a", "b", "c", "d") * 1000 + positional_of4("-v", "a", "--x", "b") * 100
            + positional_of4("--", "-v", "--", "x") * 10 + positional_of4("--", "--", "--", "--");
    }

    fn eq_split() -> bool {
        return eq_index("--out=a.txt") == 5 and long_name_len("--out=a.txt") == 3
            and eq_index("--out") == NONE and long_name_len("--out") == 3
            and eq_index("--a=b=c") == 3 and long_name_len("--a=b=c") == 1
            and eq_index("--=x") == 2 and long_name_len("--=x") == 0;
    }

    fn values() -> bool {
        const long_takes = takes_next("--out", true, true, "a.txt");
        const short_takes = takes_next("-o", true, true, "a.txt");
        const no_expect = !takes_next("--out", false, true, "a.txt");
        const dash_next = !takes_next("--out", true, true, "-v");
        const no_next = !takes_next("--out", true, false, "");
        const has_eq = !takes_next("--out=b", true, true, "a.txt");
        const group = !takes_next("-ov", true, true, "a.txt");
        const plain = !takes_next("file", true, true, "a.txt");
        return long_takes and short_takes and no_expect and dash_next and no_next and has_eq and group and plain;
    }

    test word_kinds
        given result = kinds()
        when expected = 12
        then result == expected

    test double_dash_ends_options
        given result = after_dd()
        when expected = 4
        then result == expected

    test positional_counts
        given result = positionals()
        when expected = 4233
        then result == expected

    test long_option_splits_at_first_equals
        given result = eq_split()
        when expected = true
        then result == expected

    test option_takes_next_word_as_value
        given result = values()
        when expected = true
        then result == expected
