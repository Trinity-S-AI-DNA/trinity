// t27/specs/
// | | φ² + 1/φ² = 3 | TRINITY

module TestSpec;
    use base::types;
    use math::constants;

    // ═══════════════════════════════════════════════════════════
    // 2. Types
    // ═══════════════════════════════════════════════════════════

    pub const ParseError = struct {
        message : str,
        line : i32,
        column : i32,
        source : str,
    };

    // ═══════════════════════════════════════════════════════════
    // TDD: Tests (from .tri behaviors)
    // ═══════════════════════════════════════════════════════════

    pub fn parse_error_new(message: str, line: i32, column: i32, source: str) -> ParseError {
        return ParseError{
            .message = message,
            .line = line,
            .column = column,
            .source = source,
        };
    }

    pub fn parse_error_get_message(error: ParseError) -> str {
        return error.message;
    }

    pub fn parse_error_get_line(error: ParseError) -> i32 {
        return error.line;
    }

    pub fn parse_error_get_column(error: ParseError) -> i32 {
        return error.column;
    }

    pub fn parse_error_has_source(error: ParseError) -> bool {
        return error.source.len > 0;
    }

    test "parse_error_new_creates_error" {
        const error = parse_error_new("syntax error", 10, 5, "test.t27");
        assert parse_error_get_message(error) == "syntax error";
        assert parse_error_get_line(error) == 10;
        assert parse_error_get_column(error) == 5;
        assert parse_error_has_source(error) == true;
    }

    test "parse_error_empty_source" {
        const error = parse_error_new("fatal error", 1, 1, "");
        assert parse_error_get_message(error) == "fatal error";
        assert parse_error_get_line(error) == 1;
        assert parse_error_get_column(error) == 1;
        assert parse_error_has_source(error) == false;
    }

    test "parse_error_long_message" {
        const long_msg = "this is a very long error message that should be handled correctly by the parse error structure";
        const error = parse_error_new(long_msg, 100, 50, "long_file.t27");
        assert parse_error_get_message(error) == long_msg;
        assert parse_error_get_line(error) == 100;
        assert parse_error_get_column(error) == 50;
        assert parse_error_has_source(error) == true;
    }

