// Multipath router spec - reproduces dead-code elision bug
pub fn select_path_index(paths: [u32; 4]) -> u32 {
    // This variable might trigger dead-code elision that drops the name
    // leaving just "let mut;" which is invalid syntax
    let mut index: u32 = 0;
    if paths[0] > 0 {
        index = paths[0];
    } else if paths[1] > 0 {
        index = paths[1];
    }
    // index is always used in return, but let's make the compiler think it might not be
    // in some code path to trigger the bug
    return index;
}