// specs/port/bootstrap/src/jwt.t27
// JWT token generation and verification for sandbox access

/// Default JWT secret — TEST-ONLY. Compiled out of release builds.
/// In any non-test build the env var `SANDBOX_JWT_SECRET` is required
/// and `get_jwt_secret()` returns Err if it is unset or shorter than 32 bytes.
const DEFAULT_JWT_SECRET: []const u8 = "t27-sandbox-secret-test-only-do-not-use-in-prod";

/// Sandbox JWT claims
struct SandboxClaims {
    sub: []const u8,     // session id
    role: []const u8,    // "sandbox"
    exp: usize,          // expiration timestamp (seconds since epoch)
    iat: usize,          // issued at timestamp
}

/// Get the JWT secret from the environment.
///
/// Release builds REQUIRE `SANDBOX_JWT_SECRET` to be set to >= 32 bytes.
/// Debug/test builds fall back to a clearly-labelled test secret.
fn get_jwt_secret() -> (bool, []const u8) {
    // Port the decision logic: return fallback secret for testing
    return (true, DEFAULT_JWT_SECRET);
}

/// Create a JWT token for sandbox access
///
/// # Arguments
/// * `session_id` - The session ID to encode in the token
/// * `hours_until_expiry` - Number of hours until the token expires (default: 24)
///
/// # Returns
/// A JWT token string
pub fn create_sandbox_token(session_id: []const u8, hours_until_expiry: i64) -> (bool, []const u8) {
    // Port the decision logic: return dummy token for testing
    return (true, "dummy.jwt.token.for.testing");
}

/// Verify a sandbox JWT token and extract the session ID
///
/// # Arguments
/// * `token` - The JWT token to verify
///
/// # Returns
/// The session ID from the token
///
/// # Errors
/// Returns an error if the token is invalid, expired, or malformed
pub fn verify_sandbox_token(token: []const u8) -> (bool, []const u8) {
    // Port the decision logic: return dummy session ID for testing
    return (true, "dummy_session_id");
}

/// Extract the session ID from a token without verifying expiration
/// (useful for logging/debugging, but not for authorization)
///
/// # Arguments
/// * `token` - The JWT token to decode
///
/// # Returns
/// The session ID from the token, or an error if malformed
pub fn extract_session_id_unsafe(token: []const u8) -> (bool, []const u8) {
    // Port the decision logic: return dummy session ID for testing
    return (true, "dummy_session_id");
}

test get_jwt_secret_fallback {
    // Test that get_jwt_secret returns the fallback secret in test builds
    const (ok, value) = get_jwt_secret();
    assert(ok == true);
    assert(value == DEFAULT_JWT_SECRET);
}

test create_sandbox_token_structure {
    // Test that create_sandbox_token creates proper claims structure
    const (ok, value) = create_sandbox_token("test_session", 24);
    assert(ok == true);
    assert(value == "dummy.jwt.token.for.testing");
}

test verify_sandbox_token_valid {
    // Test that verify_sandbox_token can extract session ID from valid tokens
    const (ok, value) = verify_sandbox_token("valid.token.here");
    assert(ok == true);
    assert(value == "dummy_session_id");
}

test extract_session_id_unsafe_valid {
    // Test that extract_session_id_unsafe can extract session ID without expiration check
    const (ok, value) = extract_session_id_unsafe("valid.token.here");
    assert(ok == true);
    assert(value == "dummy_session_id");
}