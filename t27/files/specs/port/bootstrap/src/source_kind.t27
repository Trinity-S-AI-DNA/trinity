//! What a `.t27` file *is*, decided before the parser is asked.
//!
//! A `.t27` extension is a filename, not a type declaration. The corpus holds
//! Markdown documents, TRI-27 assembly listings and deliberately damaged test
//! fixtures under that extension, and a parser asked about any of them answers
//! the only way it can: this is not a module. Counting that answer as a broken
//! spec inflates every corpus ratio in a knowable direction.
//!
//! This rule used to live inside `run_classify` in `main.rs`, where it was
//! reachable from the CLI and from nothing else. The Spec Explorer needed the
//! same answer and could not have it, and re-deriving the rule in JavaScript
//! would have made a second, weaker implementation of something the compiler
//! already decides -- the failure this codebase keeps repeating. It is a module
//! now so that `run_classify` and `bindings/wasm-explorer` read one rule.
//!
//! It reads the OPENING of a file. Parsing is a different question about the
//! rest, and the two disagree in both directions: `parse-complete` measured
//! 2026-08-24 that 5 non-`Source` files parse anyway. Neither is a proxy for
//! the other.

/// What a `.t27` file is, judged from its text alone.
///
/// The order of the variants is the order the rule tries them, which is also
/// the order `run_classify` reported them in before the rule moved here.
enum SourceKind {
    /// `module X { ... }` or `module X;` -- an ordinary compilation unit.
    Source,
    /// `spec X { ... }` -- the older surface, still in the corpus.
    AltSyntax,
    /// Markdown headings near the top and no `fn` anywhere: a document.
    NotCode,
    /// Markdown headings AND functions -- prose with code in it, which is
    /// neither a document nor a module and is not treated as either.
    Mixed,
    /// None of the above. This is a genuine grab-bag, not a synonym for prose:
    /// it holds damaged fixtures whose `module X` line lost its brace, TRI-27
    /// assembly whose every line opens with `;`, and files that begin at a
    /// `const`. Do not report it as "not code".
    Unclassified,
}

pub fn SourceKind_slug(self: SourceKind) []const u8 {
    if (self == SourceKind.Source) {
        return "source";
    } else if (self == SourceKind.AltSyntax) {
        return "alt-syntax";
    } else if (self == SourceKind.NotCode) {
        return "not-code";
    } else if (self == SourceKind.Mixed) {
        return "mixed";
    } else {
        return "unclassified";
    }
}

pub fn SourceKind_label(self: SourceKind) []const u8 {
    if (self == SourceKind.Source) {
        return "SOURCE          module ...";
    } else if (self == SourceKind.AltSyntax) {
        return "ALT-SYNTAX      spec X { ... }";
    } else if (self == SourceKind.NotCode) {
        return "NOT-CODE        Markdown document";
    } else if (self == SourceKind.Mixed) {
        return "MIXED           Markdown + fn";
    } else {
        return "UNCLASSIFIED    neither module, spec nor Markdown";
    }
}

pub fn SourceKind_is_source(self: SourceKind) bool {
    if (self == SourceKind.Source) {
        return true;
    } else {
        return false;
    }
}

pub fn classify(text: []const u8) SourceKind {
    var has_module: bool = false;
    var has_spec: bool = false;
    var md: bool = false;
    var has_fn: bool = false;
    
    var line_count: usize = 0;
    var i: usize = 0;
    
    while (i < text.len and line_count < 40) {
        var line_start: usize = i;
        
        // Find end of line
        while (i < text.len and text[i] != '\n') {
            i += 1;
        }
        var line_end: usize = i;
        
        // Skip newline if present
        if (i < text.len and text[i] == '\n') {
            i += 1;
        }
        
        // Process the line character by character
        var pos: usize = line_start;
        var is_all_space: bool = true;
        
        // Skip leading spaces
        while (pos < line_end and text[pos] == ' ') {
            pos += 1;
        }
        
        // Check if line is empty or all whitespace
        if (pos >= line_end) {
            line_count += 1;
            continue;
        }
        
        is_all_space = false;
        
        // Check for "pub " prefix
        var after_pub_start: usize = pos;
        if (pos + 3 < line_end and 
            text[pos] == 'p' and text[pos + 1] == 'u' and text[pos + 2] == 'b' and text[pos + 3] == ' ') {
            after_pub_start = pos + 4;
        }
        
        // Check for module
        if (after_pub_start + 6 < line_end and
            text[after_pub_start] == 'm' and text[after_pub_start + 1] == 'o' and 
            text[after_pub_start + 2] == 'd' and text[after_pub_start + 3] == 'u' and
            text[after_pub_start + 4] == 'l' and text[after_pub_start + 5] == 'e' and
            text[after_pub_start + 6] == ' ') {
            // Check for semicolon or brace after "module "
            var has_semicolon: bool = false;
            var has_brace: bool = false;
            var k: usize = after_pub_start + 7;
            while (k < line_end) {
                if (text[k] == ';') {
                    has_semicolon = true;
                }
                if (text[k] == '{') {
                    has_brace = true;
                }
                k += 1;
            }
            if (has_semicolon or has_brace) {
                has_module = true;
            }
        }
        
        // Check for spec
        if (pos + 4 < line_end and
            text[pos] == 's' and text[pos + 1] == 'p' and 
            text[pos + 2] == 'e' and text[pos + 3] == 'c' and
            text[pos + 4] == ' ') {
            // Check for brace after "spec "
            var has_brace: bool = false;
            var k: usize = pos + 5;
            while (k < line_end) {
                if (text[k] == '{') {
                    has_brace = true;
                    break;
                }
                k += 1;
            }
            if (has_brace) {
                has_spec = true;
            }
        }
        
        // Check for markdown headings
        if (pos + 1 < line_end) {
            if (text[pos] == '#' and text[pos + 1] == ' ') {
                md = true;
            } else if (pos + 2 < line_end and text[pos] == '#' and text[pos + 1] == '#' and text[pos + 2] == ' ') {
                md = true;
            } else if (pos + 3 < line_end and text[pos] == '#' and text[pos + 1] == '#' and text[pos + 2] == '#' and text[pos + 3] == ' ') {
                md = true;
            }
        }
        
        // Check for fn
        if (after_pub_start + 2 < line_end and
            text[after_pub_start] == 'f' and text[after_pub_start + 1] == 'n' and
            text[after_pub_start + 2] == ' ') {
            has_fn = true;
        }
        
        line_count += 1;
    }
    
    if (has_module) {
        return SourceKind.Source;
    } else if (has_spec) {
        return SourceKind.AltSyntax;
    } else if (md and !has_fn) {
        return SourceKind.NotCode;
    } else if (md) {
        return SourceKind.Mixed;
    } else {
        return SourceKind.Unclassified;
    }
}

test a_module_is_source {
    var result1 = classify("module m {\n}\n");
    assert(result1 == SourceKind.Source);
    
    var result2 = classify("pub module m;\n");
    assert(result2 == SourceKind.Source);
    
    var result3 = classify("# Title\n\nmodule m {\n}\n");
    assert(result3 == SourceKind.Source);
}

test a_markdown_document_is_not_code {
    var result1 = classify("# Title\n\nSome prose.\n");
    assert(result1 == SourceKind.NotCode);
    
    var result2 = classify("#\n\nprose\n");
    assert(result2 == SourceKind.Unclassified);
}

test markdown_with_functions_is_mixed_not_a_document {
    var result = classify("# Title\n\nfn f() {}\n");
    assert(result == SourceKind.Mixed);
}

test the_older_spec_surface_is_alt_syntax {
    var result1 = classify("spec S {\n}\n");
    assert(result1 == SourceKind.AltSyntax);
    
    var result2 = classify("spec GammaConjecture version 1.0.0\n");
    assert(result2 == SourceKind.Unclassified);
}

test a_damaged_module_line_is_unclassified_not_source {
    var result = classify("module damage_class_01\n");
    assert(result == SourceKind.Unclassified);
}

test tri27_assembly_is_unclassified {
    var result = classify("; vsa_bind -- TRI-27\n; ---\nLOAD r1, r2\n");
    assert(result == SourceKind.Unclassified);
}

test a_heading_deeper_than_the_window_does_not_count {
    // Test that heading after 40 lines doesn't count
    var text: []const u8 = "prose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\nprose\n# Title\n";
    
    var result = classify(text);
    assert(result == SourceKind.Unclassified);
}

test slugs_are_distinct_and_stable {
    var all: [5]SourceKind = [SourceKind.Source, SourceKind.AltSyntax, 
                             SourceKind.NotCode, SourceKind.Mixed, 
                             SourceKind.Unclassified];
    
    // Check slugs are distinct by comparing them directly
    assert(SourceKind_slug(all[0]) != SourceKind_slug(all[1]));
    assert(SourceKind_slug(all[0]) != SourceKind_slug(all[2]));
    assert(SourceKind_slug(all[0]) != SourceKind_slug(all[3]));
    assert(SourceKind_slug(all[0]) != SourceKind_slug(all[4]));
    assert(SourceKind_slug(all[1]) != SourceKind_slug(all[2]));
    assert(SourceKind_slug(all[1]) != SourceKind_slug(all[3]));
    assert(SourceKind_slug(all[1]) != SourceKind_slug(all[4]));
    assert(SourceKind_slug(all[2]) != SourceKind_slug(all[3]));
    assert(SourceKind_slug(all[2]) != SourceKind_slug(all[4]));
    assert(SourceKind_slug(all[3]) != SourceKind_slug(all[4]));
    
    assert(SourceKind_is_source(SourceKind.Source) == true);
    assert(SourceKind_is_source(SourceKind.Unclassified) == false);
}