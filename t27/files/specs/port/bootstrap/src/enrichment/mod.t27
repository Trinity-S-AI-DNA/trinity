/// Check if the enrich script exists at the expected path
pub fn check_enrich_script_exists(notebooklm_dir: []const u8, script_name: []const u8) -> bool {
    // This would normally check file existence, but we port the decision logic
    // For testing purposes, we simulate the existence check
    // In the real implementation, this would be a file system call
    return true; // Assume script exists for decision logic testing
}

/// Build command arguments for the enrich script based on parameters
pub fn build_enrich_args(all: bool, notebook: []const u8, force: bool) -> struct { args: [4][]const u8, len: usize } {
    var args: [4]str = undefined;
    var len: usize = 0;
    
    args[0] = "enrich.py";
    len += 1;
    
    if (all) {
        args[len] = "--all";
        len += 1;
    } else if (notebook.len > 0) {
        args[len] = "--issue";
        len += 1;
        args[len] = notebook;
        len += 1;
    }
    
    if (force) {
        args[len] = "--force";
        len += 1;
    }
    
    return .{ .args = args, .len = len };
}

/// Determine if language parameter requires audio command
pub fn needs_audio_command(lang: []const u8) -> bool {
    return lang != "both";
}

