// SPDX-License-Identifier: Apache-2.0
// Port of bootstrap/src/parse_conform.rs (issue #6135, epic #5980).
//
// W577: a parser conformance table. Each input gets a verdict:
//   Full      - parses, and consumes the whole input.
//   Truncated - parses, and does NOT consume the whole input. Never acceptable:
//               it reports success while discarding the author's code.
//   Rejected  - refuses to parse; the CORRECT outcome for malformed input.
// Declaration counts and discarded-token counts are recorded alongside.
//
// What is ported, and what is not:
// - The table CASES is ported in full (all 25 rows: name, input, verdict,
//   expected declarations, expected discards). The prose `note` of each row
//   is left in the Rust original; no logic reads it.
// - evaluate(src) calls the compiler's three parsers (Compiler::parse_ast,
//   parse_ast_strict, parse_ast_accounted). Those are the host's parser, not
//   something a .t27 spec can call, so evaluate keeps its name with an
//   `undefined;` body that no test calls. Its DECISION - which verdict and
//   which counts follow from the three parse results - is evaluate_from.
// - run() collects failures as formatted strings (format!, Vec). t27 has no
//   string formatting or growable list, so run takes the evaluated results
//   (one Actual per case, in table order) as a parameter and returns the
//   number of failing cases; the per-row decision is case_ok.
// - total() is ported as is.
module parse_conform {
    pub enum Verdict {
        Full,
        Truncated,
        Rejected,
    }

    pub struct Case {
        name: str,
        input: str,
        verdict: Verdict,
        // Expected number of top-level declarations when the input parses; null = not pinned.
        decls: ?usize,
        // Expected count of top-level tokens recovery DISCARDED; null = not pinned, 0 = nothing dropped.
        discards: ?usize,
    }

    // What evaluate returns for one input: (Verdict, usize, usize) in the original.
    pub struct Actual {
        verdict: Verdict,
        decls: usize,
        discards: usize,
    }

    pub const CASE_COUNT: usize = 25;

    pub const CASES: [25]Case = [
        Case {
            name: "two_fns",
            input: "module m\n\nfn a() -> u32 { return 1; }\n\nfn b() -> u32 { return 2; }\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: 0,
        },
        Case {
            name: "stray_closing_brace",
            input: "module m\n\nfn a() -> u32 { return 1; }\n\n}\n\nfn b() -> u32 { return 2; }\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: 1,
        },
        Case {
            name: "unterminated_string",
            input: "module m\n\nconst S = \"oops\n\nfn a() -> u32 { return 1; }\n",
            verdict: Verdict.Rejected,
            decls: null,
            discards: 0,
        },
        Case {
            name: "struct_with_method",
            input: "module m\n\npub const S = struct {\n    x: u32,\n    pub fn get(self: S) u32 {\n        return self.x;\n    }\n};\n\nfn after() -> u32 { return 7; }\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: 0,
        },
        Case {
            name: "second_module_header",
            input: "module a;\n\nfn one() -> u32 { return 1; }\n\nmodule b;\n\nfn two() -> u32 { return 2; }\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: 0,
        },
        Case {
            name: "braced_module_then_more",
            input: "module a {\n    fn one() -> u32 { return 1; }\n}\n\nmodule b;\n\nfn two() -> u32 { return 2; }\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: 0,
        },
        Case {
            name: "method_call_on_call_result",
            input: "module m\n\nfn mk() -> []u32 { return [1, 2]; }\n\ntest t\n    then mk().len() == 2\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: 0,
        },
        Case {
            name: "array_literal_in_given",
            input: "module m\n\ntest t\n    given a = [1, 2, 3]\n    then a.len() == 3\n",
            verdict: Verdict.Full,
            decls: 1,
            discards: 0,
        },
        Case {
            name: "bare_assert_in_brace_body",
            input: "module m\n\ntest t {\n    assert true\n}\n\nfn after() -> u32 { return 1; }\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: 0,
        },
        Case {
            name: "bare_array_const_then_fn",
            input: "module m\n\nconst A : [3]u32 = [1, 2, 3]\n\nfn g() -> u32 { return A[0]; }\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: 0,
        },
        Case {
            name: "struct_field_slice_type",
            input: "module m\n\nstruct S {\n    a: []const u8,\n    b: std.mem.Allocator,\n}\n\nfn g() -> u32 { return 1; }\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: 0,
        },
        Case {
            name: "invariant_then_decl",
            input: "module m\n\ninvariant inv\n    assert true\n\nfn after() -> u32 { return 1; }\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: 0,
        },
        Case {
            name: "slice_expression",
            input: "module m\n\nfn head(s: []const u8) -> []const u8 {\n    return s[0:5];\n}\n\nfn after() -> u32 { return 1; }\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: 0,
        },
        Case {
            name: "index_still_parses",
            input: "module m\n\nfn first(s: []const u8) -> u8 {\n    return s[0];\n}\n\nfn after() -> u32 { return 1; }\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: 0,
        },
        Case {
            name: "braceless_block_survives_a_comment",
            input: "module m\n\ninvariant i\n    // a comment between the header and the body\n    const a = f(1);\n\nfn b() -> u32 { return 2; }\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: 0,
        },
        Case {
            name: "then_clause_takes_a_statement",
            input: "module m\n\ninvariant i\n    then for (x in 0..3) {\n        assert x == x;\n    }\n\nfn b() -> u32 { return 2; }\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: 0,
        },
        Case {
            name: "array_type_const_is_not_a_boundary",
            input: "module m\n\ninvariant i\n    const b = [_][]const u8{ \"z\" };\n    assert true;\n\nfn b2() -> u32 { return 2; }\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: null,
        },
        Case {
            name: "indent_outranks_a_blank_line_inside_a_block",
            input: "module m\n\ninvariant i\n    var a : [2]i32 = [_]i32{ 1, 2 };\n\n    const b = a[0];\n    assert b == 1;\n\nfn f() -> u32 { return 2; }\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: 0,
        },
        Case {
            name: "a_bare_call_is_a_statement_not_a_clause_head",
            input: "module m\n\n    test t\n        var a : usize = 1;\n        setup(&a);\n        assert a == 1\n\nfn f() -> u32 { return 2; }\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: 0,
        },
        Case {
            name: "a_fn_spelled_as_a_test_keeps_its_clauses",
            input: "module m\n\nfn g(x: u32) -> bool { return x == 0; }\n\n    fn plain_test()\n        given a = 1\n        then g(a) == false\n",
            verdict: Verdict.Full,
            decls: 2,
            discards: 0,
        },
        Case {
            name: "a_statement_may_stand_where_a_clause_head_is_expected",
            input: "module m\n\n    test t\n        var n : usize = 0;\n        for (i in 0..3) {\n            n = n + 1;\n        }\n        assert n == 3\n",
            verdict: Verdict.Full,
            decls: 1,
            discards: 0,
        },
        Case {
            name: "one_clause_may_bind_several_names",
            input: "module m\n\n    test t\n        given clk = true, rst_n = false, angle = 4096\n        then clk == true\n",
            verdict: Verdict.Full,
            decls: 1,
            discards: 0,
        },
        Case {
            name: "a_clause_binding_may_carry_a_type",
            input: "module m\n\n    test t\n        given crossings : [i32] = [1]\n        then crossings[0] == 1\n",
            verdict: Verdict.Full,
            decls: 1,
            discards: 0,
        },
        Case {
            name: "a_body_may_open_with_a_call",
            input: "module m\n\n    bench b\n        setup(10000);\n        var n : usize = 0;\n        assert n == 0\n",
            verdict: Verdict.Full,
            decls: 1,
            discards: 0,
        },
        Case {
            name: "unterminated_fn_body",
            input: "module m\n\nfn a() -> u32 { return 1;\n",
            verdict: Verdict.Rejected,
            decls: null,
            discards: 0,
        },

    ];

    // The decision inside evaluate. Inputs are the three parse results:
    //   accounted_ok / accounted_discards - parse_ast_accounted(src); an Err reads as 0 discards
    //   lenient_ok / lenient_decls        - parse_ast(src) and its children count
    //   strict_ok / strict_decls          - parse_ast_strict(src) and its children count
    pub fn evaluate_from(
        accounted_ok: bool,
        accounted_discards: usize,
        lenient_ok: bool,
        lenient_decls: usize,
        strict_ok: bool,
        strict_decls: usize,
    ) -> (Verdict, usize, usize) {
        var discards: usize = 0;
        if (accounted_ok) {
            discards = accounted_discards;
        }
        if (!lenient_ok) {
            return (Verdict.Rejected, 0, discards);
        }
        if (strict_ok) {
            return (Verdict.Full, strict_decls, discards);
        }
        return (Verdict.Truncated, lenient_decls, discards);
    }

    // Plumbing: runs the compiler's parsers on src and hands their results to
    // evaluate_from. The parsers are the host's; no test calls this.
    fn evaluate(src: str) -> (Verdict, usize, usize) {
        undefined;
    }

    // One row of run(): the verdict must match; the declaration count is checked
    // only when the row pins it AND the verdict is Full; the discard count is
    // checked only when the row pins it.
    pub fn case_ok(
        want_verdict: Verdict,
        want_decls: ?usize,
        want_discards: ?usize,
        verdict: Verdict,
        decls: usize,
        discards: usize,
    ) -> bool {
        var decl_ok: bool = true;
        if (want_decls != null and verdict == Verdict.Full) {
            decl_ok = decls == want_decls.?;
        }
        var discard_ok: bool = true;
        if (want_discards != null) {
            discard_ok = discards == want_discards.?;
        }
        return verdict == want_verdict and decl_ok and discard_ok;
    }

    // run(): the number of rows of CASES whose evaluated result fails case_ok.
    // actuals[i] is evaluate(CASES[i].input); the original gathers them itself.
    pub fn run(actuals: []const Actual) -> usize {
        var failures: usize = 0;
        var i: usize = 0;
        while (i < CASE_COUNT) {
            const c = CASES[i];
            const a = actuals[i];
            if (!case_ok(c.verdict, c.decls, c.discards, a.verdict, a.decls, a.discards)) {
                failures += 1;
            }
            i += 1;
        }
        return failures;
    }

    pub fn total() -> usize {
        return CASES.len;
    }

    test total_is_the_table_length {
        assert(total() == 25);
    }

    test table_rows_read_as_in_the_original {
        assert(CASES[0].name == "two_fns");
        assert(CASES[0].verdict == Verdict.Full);
        assert(CASES[0].decls.? == 2);
        assert(CASES[0].discards.? == 0);
        // stray_closing_brace: accepted, two decls, one token dropped
        assert(CASES[1].name == "stray_closing_brace");
        assert(CASES[1].discards.? == 1);
        // unterminated_string: rejected, decls not pinned
        assert(CASES[2].verdict == Verdict.Rejected);
        assert(CASES[2].decls == null);
        // array_type_const_is_not_a_boundary: the one row that does not pin discards
        assert(CASES[16].name == "array_type_const_is_not_a_boundary");
        assert(CASES[16].discards == null);
        assert(CASES[24].name == "unterminated_fn_body");
        assert(CASES[24].verdict == Verdict.Rejected);
    }

    test evaluate_rejects_when_the_lenient_parse_fails {
        const (v, d, x) = evaluate_from(true, 0, false, 0, false, 0);
        assert(v == Verdict.Rejected);
        assert(d == 0);
        assert(x == 0);
        // the decl count is forced to 0 even if a count was passed
        const (v2, d2, x2) = evaluate_from(true, 3, false, 7, false, 7);
        assert(v2 == Verdict.Rejected);
        assert(d2 == 0);
        assert(x2 == 3);
    }

    test evaluate_full_takes_the_strict_count {
        // stray_closing_brace: both parses succeed, strict sees 2 decls, 1 brace discarded
        const (v, d, x) = evaluate_from(true, 1, true, 2, true, 2);
        assert(v == Verdict.Full);
        assert(d == 2);
        assert(x == 1);
    }

    test evaluate_truncated_takes_the_lenient_count {
        const (v, d, x) = evaluate_from(true, 0, true, 1, false, 0);
        assert(v == Verdict.Truncated);
        assert(d == 1);
        assert(x == 0);
    }

    test evaluate_reads_a_failed_accounting_as_zero_discards {
        const (v, d, x) = evaluate_from(false, 9, true, 2, true, 2);
        assert(v == Verdict.Full);
        assert(d == 2);
        assert(x == 0);
    }

    test case_ok_checks_verdict_decls_and_discards {
        assert(case_ok(Verdict.Full, 2, 0, Verdict.Full, 2, 0));
        // wrong verdict
        assert(!case_ok(Verdict.Full, 2, 0, Verdict.Truncated, 2, 0));
        // decl count wrong on a Full verdict
        assert(!case_ok(Verdict.Full, 2, 0, Verdict.Full, 1, 0));
        // a dropped token where the row demands none
        assert(!case_ok(Verdict.Full, 2, 0, Verdict.Full, 2, 1));
        // unpinned discards accept any count
        assert(case_ok(Verdict.Full, 2, null, Verdict.Full, 2, 5));
        // a Rejected row with unpinned decls ignores the count
        assert(case_ok(Verdict.Rejected, null, 0, Verdict.Rejected, 0, 0));
    }

    test case_ok_skips_the_decl_count_when_the_verdict_is_not_full {
        // decls pinned at 2, actual Truncated with 1 decl, row wants Truncated:
        // the original only compares decls for (Some(n), Verdict::Full)
        assert(case_ok(Verdict.Truncated, 2, 0, Verdict.Truncated, 1, 0));
    }

    test run_counts_failing_rows {
        var all_pass: [25]Actual = undefined;
        var i: usize = 0;
        while (i < CASE_COUNT) {
            var want_d: usize = 0;
            if (CASES[i].decls != null) {
                want_d = CASES[i].decls.?;
            }
            var want_x: usize = 0;
            if (CASES[i].discards != null) {
                want_x = CASES[i].discards.?;
            }
            all_pass[i] = Actual { verdict: CASES[i].verdict, decls: want_d, discards: want_x };
            i += 1;
        }
        assert(run(&all_pass) == 0);
        // the W569 regression: stray `}` silently ends the file -> Truncated with 1 decl
        all_pass[1] = Actual { verdict: Verdict.Truncated, decls: 1, discards: 0 };
        assert(run(&all_pass) == 1);
        // the unterminated string swallowing the file and reporting success
        all_pass[2] = Actual { verdict: Verdict.Full, decls: 0, discards: 0 };
        assert(run(&all_pass) == 2);
    }
}
