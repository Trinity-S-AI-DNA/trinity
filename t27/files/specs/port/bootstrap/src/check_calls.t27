module port::bootstrap::src::check_calls;

fn is_scalar_type(ty: str) -> bool {
    if (ty == "i8" || ty == "i16" || ty == "i32" || ty == "i64" || ty == "isize" ||
        ty == "u8" || ty == "u16" || ty == "u32" || ty == "u64" || ty == "usize" ||
        ty == "f32" || ty == "f64" || ty == "bool" || ty == "char") {
        return true;
    } else {
        return false;
    }
}

test is_scalar_type_basic {
    assert(is_scalar_type("i32"));
    assert(is_scalar_type("u64"));
    assert(is_scalar_type("bool"));
    assert(is_scalar_type("char"));
}

test is_scalar_type_negative {
    assert(is_scalar_type("struct") == false);
    assert(is_scalar_type("Point") == false);
    assert(is_scalar_type("i128") == false);
    assert(is_scalar_type("") == false);
}

fn is_aggregate_arg(node_kind: str) -> bool {
    return node_kind == "ExprStructLit";
}

test is_aggregate_arg_positive {
    assert(is_aggregate_arg("ExprStructLit"));
}

test is_aggregate_arg_negative {
    assert(is_aggregate_arg("ExprCall") == false);
    assert(is_aggregate_arg("FnDecl") == false);
}

