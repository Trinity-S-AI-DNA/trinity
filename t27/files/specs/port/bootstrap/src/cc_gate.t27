test classify_basic {
    assert(classify("unknown type name 'f32'") == "normalized");
}

test classify_warning_removal {
    assert(classify("error at line 42 [-Wsome-warning]") == "normalized");
}

test classify_digit_replacement {
    assert(classify("line 123 column 456") == "normalized");
}

test classify_quote_handling {
    assert(classify("''") == "normalized");
    assert(classify("text '' more text") == "normalized");
}