module port::bootstrap::src::compiler::AsmRelocEntry_new;

// Port of bootstrap/src/compiler.rs impls for AsmRelocEntry, AsmSymbol and
// AsmSection to a pure .t27 module. Original source: current tree lines
// 30273-30369 (the issue line refs 30006-30113 are stale: those lines hold
// HirIpCatalog code). Replaces the salvaged draft on this path whose
// generated Zig failed with "value of type AsmRelocEntry ignored": every
// ported function now ends with an explicit return, so the generator no
// longer emits bare struct literals as discarded value statements.
//
// FR-001 decisions carried verbatim:
//   - AsmRelocEntry_new / AsmSymbol_new take the symbol or name as a
//     parameter and store it (original: symbol.to_string() / name.to_string())
//   - AsmSymbol_new always starts size at 0
//   - AsmSection_text/data/bss/rodata pin the fixed names .text/.data/
//     .bss/.rodata, lock kind to the matching AsmSectionKind variant and
//     start size at 0
//   - AsmSection_end saturates at the u32 maximum (original: saturating_add)
//   - AsmSymbol_validate rejects an empty name ("symbol name must not be empty")
//
// Deliberate .t27 adaptations (no generics, no growable lists, no owned heap
// strings, no cross-module use):
//   - String and &str fields/params ported as str slices
//   - &self receivers ported as plain by-value params (small fixed structs)
//   - AsmSymbol_validate returns the error count (0 or 1); the original
//     returns a Vec<String> holding the single message "symbol name must
//     not be empty"
//   - AsmSection_end ports saturating_add as subtract-and-compare so no u64
//     intermediate is needed
//   - none of the 8 ported functions contain a match, so no switch is needed
//     in the ports; one test uses a switch expression to assert a kind value

pub enum AsmSectionKind {
    Text,
    Data,
    Bss,
    Rodata,
}

pub enum AsmRelocKind {
    Abs32,
    Rel21,
    Gf16Label,
}

pub struct AsmRelocEntry {
    pub offset: u32,
    pub kind: AsmRelocKind,
    pub symbol: str,
    pub addend: u32,
}

pub struct AsmSymbol {
    pub name: str,
    pub address: u32,
    pub size: u32,
    pub section: AsmSectionKind,
    pub is_global: bool,
}

pub struct AsmSection {
    pub name: str,
    pub kind: AsmSectionKind,
    pub base_address: u32,
    pub size: u32,
}

pub fn AsmRelocEntry_new(offset: u32, kind: AsmRelocKind, symbol: str, addend: u32) -> AsmRelocEntry {
    return AsmRelocEntry {
        offset: offset,
        kind: kind,
        symbol: symbol,
        addend: addend,
    };
}

pub fn AsmSymbol_new(name: str, address: u32, section: AsmSectionKind, is_global: bool) -> AsmSymbol {
    return AsmSymbol {
        name: name,
        address: address,
        size: 0,
        section: section,
        is_global: is_global,
    };
}

pub fn AsmSymbol_validate(s: AsmSymbol) -> u32 {
    if (s.name == "") {
        return 1;
    }
    return 0;
}

pub fn AsmSection_text(base: u32) -> AsmSection {
    return AsmSection {
        name: ".text",
        kind: AsmSectionKind::Text,
        base_address: base,
        size: 0,
    };
}

pub fn AsmSection_data(base: u32) -> AsmSection {
    return AsmSection {
        name: ".data",
        kind: AsmSectionKind::Data,
        base_address: base,
        size: 0,
    };
}

pub fn AsmSection_bss(base: u32) -> AsmSection {
    return AsmSection {
        name: ".bss",
        kind: AsmSectionKind::Bss,
        base_address: base,
        size: 0,
    };
}

pub fn AsmSection_rodata(base: u32) -> AsmSection {
    return AsmSection {
        name: ".rodata",
        kind: AsmSectionKind::Rodata,
        base_address: base,
        size: 0,
    };
}

pub fn AsmSection_end(s: AsmSection) -> u32 {
    if (s.size > 0xFFFFFFFF - s.base_address) {
        return 0xFFFFFFFF;
    }
    return s.base_address + s.size;
}

test AsmRelocEntry_new_basic {
    const reloc = AsmRelocEntry_new(100, AsmRelocKind::Abs32, "test_symbol", 42);
    assert(reloc.offset == 100);
    assert(reloc.kind == AsmRelocKind::Abs32);
    assert(reloc.symbol == "test_symbol");
    assert(reloc.addend == 42);
}

test AsmRelocEntry_new_different_kinds {
    const reloc1 = AsmRelocEntry_new(200, AsmRelocKind::Rel21, "rel_symbol", 0);
    const reloc2 = AsmRelocEntry_new(300, AsmRelocKind::Gf16Label, "gf_symbol", 16);

    assert(reloc1.kind == AsmRelocKind::Rel21);
    assert(reloc1.symbol == "rel_symbol");
    assert(reloc2.kind == AsmRelocKind::Gf16Label);
    assert(reloc2.addend == 16);
}

test AsmRelocEntry_new_zero_fields {
    const reloc = AsmRelocEntry_new(0, AsmRelocKind::Abs32, "", 0);
    assert(reloc.offset == 0);
    assert(reloc.addend == 0);
    assert(reloc.symbol == "");
}

test AsmSymbol_new_basic {
    const sym = AsmSymbol_new("main", 0, AsmSectionKind::Text, true);
    assert(sym.name == "main");
    assert(sym.address == 0);
    assert(sym.size == 0);
    assert(sym.section == AsmSectionKind::Text);
    assert(sym.is_global == true);
}

test AsmSymbol_new_different_sections {
    const sym1 = AsmSymbol_new("data_var", 1024, AsmSectionKind::Data, false);
    const sym2 = AsmSymbol_new("bss_var", 2048, AsmSectionKind::Bss, false);
    const sym3 = AsmSymbol_new("rodata_var", 3072, AsmSectionKind::Rodata, true);

    assert(sym1.section == AsmSectionKind::Data);
    assert(sym2.section == AsmSectionKind::Bss);
    assert(sym3.section == AsmSectionKind::Rodata);
    assert(sym1.is_global == false);
    assert(sym3.is_global == true);
}

test AsmSymbol_validate_valid {
    const sym = AsmSymbol_new("valid_symbol", 0, AsmSectionKind::Text, true);
    assert(AsmSymbol_validate(sym) == 0);
}

test AsmSymbol_validate_empty_name {
    const sym = AsmSymbol_new("", 0, AsmSectionKind::Text, true);
    assert(AsmSymbol_validate(sym) == 1);
}

test AsmSection_text_basic {
    const section = AsmSection_text(0x1000);
    assert(section.name == ".text");
    assert(section.kind == AsmSectionKind::Text);
    assert(section.base_address == 0x1000);
    assert(section.size == 0);
}

test AsmSection_data_and_bss {
    const data_section = AsmSection_data(0x2000);
    const bss_section = AsmSection_bss(0x3000);

    assert(data_section.name == ".data");
    assert(data_section.kind == AsmSectionKind::Data);
    assert(data_section.base_address == 0x2000);

    assert(bss_section.name == ".bss");
    assert(bss_section.kind == AsmSectionKind::Bss);
    assert(bss_section.base_address == 0x3000);
}

test AsmSection_rodata {
    const section = AsmSection_rodata(0x4000);
    assert(section.name == ".rodata");
    assert(section.kind == AsmSectionKind::Rodata);
    assert(section.base_address == 0x4000);
    assert(section.size == 0);
}

test AsmSection_end_zero_size {
    const section = AsmSection_text(0x1000);
    assert(AsmSection_end(section) == 0x1000);
}

test AsmSection_end_grows {
    const section = AsmSection {
        name: ".data",
        kind: AsmSectionKind::Data,
        base_address: 0x2000,
        size: 512,
    };
    assert(AsmSection_end(section) == 0x2200);
}

test AsmSection_end_saturates {
    const section = AsmSection {
        name: ".bss",
        kind: AsmSectionKind::Bss,
        base_address: 0xFFFFFFF0,
        size: 0x20,
    };
    assert(AsmSection_end(section) == 0xFFFFFFFF);
}

test AsmSection_end_saturates_at_max {
    const section = AsmSection {
        name: ".rodata",
        kind: AsmSectionKind::Rodata,
        base_address: 0xFFFFFFFF,
        size: 0,
    };
    assert(AsmSection_end(section) == 0xFFFFFFFF);
}

test AsmSection_end_boundary_no_overflow {
    const section = AsmSection {
        name: ".text",
        kind: AsmSectionKind::Text,
        base_address: 0xFFFFFFF0,
        size: 0xF,
    };
    assert(AsmSection_end(section) == 0xFFFFFFFF);
}

test AsmSymbol_kind_via_switch {
    const sym = AsmSymbol_new("main", 0, AsmSectionKind::Text, true);
    var k: u32 = switch (sym.section) { .Text => 1, else => 0, };
    assert(k == 1);
}
