module port::bootstrap::src::compiler::TbCheck_new;

pub struct TbCheck {
    pub cycle: u32,
    pub signal: []const u8,
    pub expected: u32,
    pub mask: u32,
}

pub struct TbConfig {
    pub name: []const u8,
    pub dut_name: []const u8,
    pub timescale: []const u8,
    pub max_cycles: u32,
    pub timeout_ns: u32,
    pub fail_fast: bool,
}

pub fn TbCheck_new(cycle: u32, signal: []const u8, expected: u32) -> TbCheck {
    var result: TbCheck = undefined;
    result.cycle = cycle;
    result.signal = signal;
    result.expected = expected;
    result.mask = 0xFFFF_FFFF;
    return result;
}

pub fn TbCheck_with_mask(cycle: u32, signal: []const u8, expected: u32, mask: u32) -> TbCheck {
    var result: TbCheck = undefined;
    result.cycle = cycle;
    result.signal = signal;
    result.expected = expected;
    result.mask = mask;
    return result;
}

pub fn TbCheck_validate(self: TbCheck) -> []const u8 {
    if (self.signal.len == 0) {
        return "check signal must not be empty";
    }
    return "";
}

pub fn TbConfig_new(dut: []const u8, max_cycles: u32) -> TbConfig {
    var result: TbConfig = undefined;
    result.name = "tb";
    result.dut_name = dut;
    result.timescale = "1ns/1ps";
    result.max_cycles = max_cycles;
    result.timeout_ns = max_cycles * 10;
    result.fail_fast = true;
    return result;
}

pub fn TbConfig_validate(self: TbConfig) -> []const u8 {
    if (self.dut_name.len == 0) {
        return "DUT name must not be empty";
    }
    if (self.max_cycles == 0) {
        return "max_cycles must be positive";
    }
    return "";
}

test TbCheck_new_basic {
    const check = TbCheck_new(10, "clk", 1);
    assert(check.cycle == 10);
    assert(check.signal == "clk");
    assert(check.expected == 1);
    assert(check.mask == 0xFFFF_FFFF);
}

test TbCheck_with_mask_custom {
    const check = TbCheck_with_mask(20, "data", 5, 0x00FF);
    assert(check.cycle == 20);
    assert(check.signal == "data");
    assert(check.expected == 5);
    assert(check.mask == 0x00FF);
}

test TbCheck_validate_empty_signal {
    const check = TbCheck_new(30, "", 15);
    const result = TbCheck_validate(check);
    assert(result.len > 0);
    assert(result[0] == 'c'); // starts with "check signal must not be empty"
}

test TbCheck_validate_valid_signal {
    const check = TbCheck_new(40, "valid_signal", 25);
    const result = TbCheck_validate(check);
    assert(result.len == 0); // empty string means no errors
}

test TbConfig_new_defaults {
    const config = TbConfig_new("my_dut", 1000);
    assert(config.name == "tb");
    assert(config.dut_name == "my_dut");
    assert(config.timescale == "1ns/1ps");
    assert(config.max_cycles == 1000);
    assert(config.timeout_ns == 10000); // 1000 * 10
    assert(config.fail_fast == true);
}

test TbConfig_validate_empty_dut {
    const config = TbConfig_new("", 500);
    const result = TbConfig_validate(config);
    assert(result.len > 0);
    assert(result[0] == 'D'); // starts with "DUT name must not be empty"
}

test TbConfig_validate_zero_cycles {
    const config = TbConfig_new("my_dut", 0);
    const result = TbConfig_validate(config);
    assert(result.len > 0);
    assert(result[0] == 'm'); // starts with "max_cycles must be positive"
}

test TbConfig_validate_valid {
    const config = TbConfig_new("valid_dut", 100);
    const result = TbConfig_validate(config);
    assert(result.len == 0); // empty string means no errors
}