module port::bootstrap_compiler_asm_section_kind;

// Port of bootstrap/src/compiler.rs lines 29870-29934 (gHashTag/t27 at
// f244bd2bd316): the two tag enums the assembler carries on its section and
// relocation records, and the i8 conversions each one defines. The original
// is hand-written Rust and stays where it is; this file is the t27 twin of
// that slice, so the code is generated from .t27 instead of written by hand.
//
// All four functions are pure conversions - no files, network, subprocess,
// clock or randomness - so every decision is ported as a body with tests on
// it, and none of them carries an `undefined;` stub. The Rust `match` arms
// become if/else chains: the generator emits a bare `switch` statement with
// a trailing semicolon that Zig rejects ("expected statement, found ';'"),
// so the arms are written the way that compiles and runs.

pub enum AsmSectionKind {
    Text,
    Data,
    Bss,
    Rodata,
}

pub enum AsmRelocKind {
    Abs32,
    Rel21,
    Gf16Label,
}

// AsmSectionKind::from_i8 (line 29879 in the issue's gutter, line 30067 in
// this checkout). The decision the original makes: 0, 1, 2 and 3 map to
// Text, Data, Bss and Rodata, and any other code falls back to Text.
pub fn AsmSectionKind_from_i8(v: i8) -> AsmSectionKind {
    if (v == 0) {
        return AsmSectionKind.Text;
    }
    if (v == 1) {
        return AsmSectionKind.Data;
    }
    if (v == 2) {
        return AsmSectionKind.Bss;
    }
    if (v == 3) {
        return AsmSectionKind.Rodata;
    }
    return AsmSectionKind.Text;
}

// AsmSectionKind::to_i8 (line 29888 in the issue's gutter, line 30076 in
// this checkout). The inverse mapping; the original is exhaustive over its
// four variants, so every section kind round-trips through from_i8 and back
// unchanged.
pub fn AsmSectionKind_to_i8(self: AsmSectionKind) -> i8 {
    if (self == AsmSectionKind.Text) {
        return 0;
    }
    if (self == AsmSectionKind.Data) {
        return 1;
    }
    if (self == AsmSectionKind.Bss) {
        return 2;
    }
    if (self == AsmSectionKind.Rodata) {
        return 3;
    }
    return 0;
}

// AsmRelocKind::from_i8 (line 29906 in the issue's gutter, line 30094 in
// this checkout). The decision the original makes: 0, 1 and 2 map to Abs32,
// Rel21 and Gf16Label, and any other code falls back to Abs32.
pub fn AsmRelocKind_from_i8(v: i8) -> AsmRelocKind {
    if (v == 0) {
        return AsmRelocKind.Abs32;
    }
    if (v == 1) {
        return AsmRelocKind.Rel21;
    }
    if (v == 2) {
        return AsmRelocKind.Gf16Label;
    }
    return AsmRelocKind.Abs32;
}

// AsmRelocKind::to_i8 (line 29914 in the issue's gutter, line 30102 in
// this checkout). The inverse mapping over the three relocation kinds.
pub fn AsmRelocKind_to_i8(self: AsmRelocKind) -> i8 {
    if (self == AsmRelocKind.Abs32) {
        return 0;
    }
    if (self == AsmRelocKind.Rel21) {
        return 1;
    }
    if (self == AsmRelocKind.Gf16Label) {
        return 2;
    }
    return 0;
}

test AsmSectionKind_from_i8_canonical {
    assert(AsmSectionKind_from_i8(0) == AsmSectionKind.Text);
    assert(AsmSectionKind_from_i8(1) == AsmSectionKind.Data);
    assert(AsmSectionKind_from_i8(2) == AsmSectionKind.Bss);
    assert(AsmSectionKind_from_i8(3) == AsmSectionKind.Rodata);
}

test AsmSectionKind_from_i8_fallback {
    // The original's `_` arm: unknown codes fall back to Text, not to an error.
    assert(AsmSectionKind_from_i8(4) == AsmSectionKind.Text);
    assert(AsmSectionKind_from_i8(9) == AsmSectionKind.Text);
    assert(AsmSectionKind_from_i8(-1) == AsmSectionKind.Text);
}

test AsmSectionKind_to_i8_values {
    assert(AsmSectionKind_to_i8(AsmSectionKind.Text) == 0);
    assert(AsmSectionKind_to_i8(AsmSectionKind.Data) == 1);
    assert(AsmSectionKind_to_i8(AsmSectionKind.Bss) == 2);
    assert(AsmSectionKind_to_i8(AsmSectionKind.Rodata) == 3);
}

test AsmSectionKind_roundtrip {
    var v: i8 = 0;
    while (v < 4) {
        assert(AsmSectionKind_to_i8(AsmSectionKind_from_i8(v)) == v);
        v += 1;
    }
}

test AsmRelocKind_from_i8_canonical {
    assert(AsmRelocKind_from_i8(0) == AsmRelocKind.Abs32);
    assert(AsmRelocKind_from_i8(1) == AsmRelocKind.Rel21);
    assert(AsmRelocKind_from_i8(2) == AsmRelocKind.Gf16Label);
}

test AsmRelocKind_from_i8_fallback {
    // The original's `_` arm: unknown codes fall back to Abs32, not to an error.
    assert(AsmRelocKind_from_i8(3) == AsmRelocKind.Abs32);
    assert(AsmRelocKind_from_i8(100) == AsmRelocKind.Abs32);
    assert(AsmRelocKind_from_i8(-5) == AsmRelocKind.Abs32);
}

test AsmRelocKind_to_i8_values {
    assert(AsmRelocKind_to_i8(AsmRelocKind.Abs32) == 0);
    assert(AsmRelocKind_to_i8(AsmRelocKind.Rel21) == 1);
    assert(AsmRelocKind_to_i8(AsmRelocKind.Gf16Label) == 2);
}

test AsmRelocKind_roundtrip {
    var v: i8 = 0;
    while (v < 3) {
        assert(AsmRelocKind_to_i8(AsmRelocKind_from_i8(v)) == v);
        v += 1;
    }
}
