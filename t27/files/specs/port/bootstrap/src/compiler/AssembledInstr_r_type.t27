module port::bootstrap::src::compiler::AssembledInstr_r_type;

// Struct definition based on the original AssembledInstr
struct AssembledInstr {
    address: u32,
    opcode: u32,
    rd: u32,
    rs1: u32,
    rs2: u32,
    imm: u32,
    label: []const u8,
    is_gf16: bool,
}

pub fn AssembledInstr_r_type(opcode: u32, rd: u32, rs1: u32, rs2: u32) -> AssembledInstr {
    return AssembledInstr {
        address: 0,
        opcode: opcode,
        rd: rd,
        rs1: rs1,
        rs2: rs2,
        imm: 0,
        label: "",
        is_gf16: false,
    }
}

pub fn AssembledInstr_i_type(opcode: u32, rd: u32, rs1: u32, imm: u32) -> AssembledInstr {
    return AssembledInstr {
        address: 0,
        opcode: opcode,
        rd: rd,
        rs1: rs1,
        rs2: 0,
        imm: imm,
        label: "",
        is_gf16: false,
    }
}

pub fn AssembledInstr_gf16(opcode: u32, rd: u32, rs1: u32, rs2: u32) -> AssembledInstr {
    return AssembledInstr {
        address: 0,
        opcode: opcode,
        rd: rd,
        rs1: rs1,
        rs2: rs2,
        imm: 0,
        label: "",
        is_gf16: true,
    }
}

pub fn AssembledInstr_is_r_type(instr: AssembledInstr) -> bool {
    return instr.imm == 0 and instr.rs2 > 0
}

pub fn AssembledInstr_is_i_type(instr: AssembledInstr) -> bool {
    return instr.imm > 0
}

pub fn AssembledInstr_is_gf16_instr(instr: AssembledInstr) -> bool {
    return instr.is_gf16
}

pub fn AssembledInstr_encode_r_type(instr: AssembledInstr) -> u32 {
    return (instr.opcode << 26) | (instr.rd << 21) | (instr.rs1 << 16) | (instr.rs2 << 11)
}

pub fn AssembledInstr_encode_i_type(instr: AssembledInstr) -> u32 {
    return (instr.opcode << 26) | (instr.rd << 21) | (instr.rs1 << 16) | (instr.imm & 0xFFFF)
}

pub fn AssembledInstr_encode(instr: AssembledInstr) -> u32 {
    if (instr.is_gf16) {
        return AssembledInstr_encode_r_type(instr);
    } else if (AssembledInstr_is_i_type(instr)) {
        return AssembledInstr_encode_i_type(instr);
    } else {
        return AssembledInstr_encode_r_type(instr);
    }
}

// Test cases for r_type function
test r_type_basic {
    const instr = AssembledInstr_r_type(0x10, 1, 2, 3);
    assert(instr.opcode == 0x10);
    assert(instr.rd == 1);
    assert(instr.rs1 == 2);
    assert(instr.rs2 == 3);
    assert(instr.imm == 0);
    assert(instr.is_gf16 == false);
}

test r_type_zero_values {
    const instr = AssembledInstr_r_type(0, 0, 0, 0);
    assert(instr.opcode == 0);
    assert(instr.rd == 0);
    assert(instr.rs1 == 0);
    assert(instr.rs2 == 0);
    assert(instr.imm == 0);
}

// Test cases for i_type function
test i_type_basic {
    const instr = AssembledInstr_i_type(0x20, 4, 5, 0x1234);
    assert(instr.opcode == 0x20);
    assert(instr.rd == 4);
    assert(instr.rs1 == 5);
    assert(instr.rs2 == 0); // i_type sets rs2 to 0
    assert(instr.imm == 0x1234);
    assert(instr.is_gf16 == false);
}

test i_type_zero_imm {
    const instr = AssembledInstr_i_type(0x30, 1, 2, 0);
    assert(instr.imm == 0);
    assert(instr.rs2 == 0);
}

// Test cases for gf16 function
test gf16_basic {
    const instr = AssembledInstr_gf16(0x40, 6, 7, 8);
    assert(instr.opcode == 0x40);
    assert(instr.rd == 6);
    assert(instr.rs1 == 7);
    assert(instr.rs2 == 8);
    assert(instr.imm == 0);
    assert(instr.is_gf16 == true);
}

// Test cases for is_r_type function
test is_r_type_true {
    const instr1 = AssembledInstr_r_type(0x10, 1, 2, 3);
    const instr2 = AssembledInstr_i_type(0x20, 4, 5, 0);
    assert(AssembledInstr_is_r_type(instr1) == true);
    assert(AssembledInstr_is_r_type(instr2) == false); // imm is 0 but rs2 is 0
}

test is_r_type_false {
    const instr1 = AssembledInstr_i_type(0x20, 4, 5, 1);
    const instr2 = AssembledInstr_r_type(0x10, 1, 2, 0);
    assert(AssembledInstr_is_r_type(instr1) == false); // imm > 0
    assert(AssembledInstr_is_r_type(instr2) == false); // rs2 == 0
}

// Test cases for is_i_type function
test is_i_type_true {
    const instr = AssembledInstr_i_type(0x20, 4, 5, 1);
    assert(AssembledInstr_is_i_type(instr) == true);
}

test is_i_type_false {
    const instr1 = AssembledInstr_r_type(0x10, 1, 2, 3);
    const instr2 = AssembledInstr_i_type(0x20, 4, 5, 0);
    assert(AssembledInstr_is_i_type(instr1) == false);
    assert(AssembledInstr_is_i_type(instr2) == false);
}

// Test cases for is_gf16_instr function
test is_gf16_true {
    const instr = AssembledInstr_gf16(0x40, 6, 7, 8);
    assert(AssembledInstr_is_gf16_instr(instr) == true);
}

test is_gf16_false {
    const instr1 = AssembledInstr_r_type(0x10, 1, 2, 3);
    const instr2 = AssembledInstr_i_type(0x20, 4, 5, 1);
    assert(AssembledInstr_is_gf16_instr(instr1) == false);
    assert(AssembledInstr_is_gf16_instr(instr2) == false);
}

// Test cases for encode_r_type function
test encode_r_type_basic {
    const instr = AssembledInstr_r_type(0x10, 1, 2, 3);
    const encoded = AssembledInstr_encode_r_type(instr);
    // Expected: (0x10 << 26) | (1 << 21) | (2 << 16) | (3 << 11)
    const expected = (0x40000000) | (0x200000) | (0x20000) | (0x1800);
    assert(encoded == expected);
}

test encode_r_type_max_values {
    const instr = AssembledInstr_r_type(0x3F, 31, 31, 31);
    const encoded = AssembledInstr_encode_r_type(instr);
    // Expected: (0x3F << 26) | (31 << 21) | (31 << 16) | (31 << 11)
    const expected = 0xfffff800;
    assert(encoded == expected);
}

// Test cases for encode_i_type function
test encode_i_type_basic {
    const instr = AssembledInstr_i_type(0x20, 4, 5, 0x1234);
    const encoded = AssembledInstr_encode_i_type(instr);
    // Expected: (0x20 << 26) | (4 << 21) | (5 << 16) | (0x1234 & 0xFFFF)
    const expected = (0x80000000) | (0x800000) | (0x50000) | 0x1234;
    assert(encoded == expected);
}

test encode_i_type_imm_mask {
    const instr = AssembledInstr_i_type(0x30, 1, 2, 0x12345);
    const encoded = AssembledInstr_encode_i_type(instr);
    // imm should be masked to 0xFFFF (16 bits)
    const expected = (0xC0000000) | (0x200000) | (0x20000) | 0x2345;
    assert(encoded == expected);
}

// Test cases for encode function
test encode_gf16 {
    const instr = AssembledInstr_gf16(0x40, 6, 7, 8);
    const encoded = AssembledInstr_encode(instr);
    // Should encode as r_type for gf16
    const expected = 0xc74000;
    assert(encoded == expected);
}

test encode_i_type {
    const instr = AssembledInstr_i_type(0x20, 4, 5, 0x1234);
    const encoded = AssembledInstr_encode(instr);
    const expected = (0x80000000) | (0x800000) | (0x50000) | 0x1234;
    assert(encoded == expected);
}

test encode_r_type {
    const instr = AssembledInstr_r_type(0x10, 1, 2, 3);
    const encoded = AssembledInstr_encode(instr);
    const expected = 0x40221800;
    assert(encoded == expected);
}