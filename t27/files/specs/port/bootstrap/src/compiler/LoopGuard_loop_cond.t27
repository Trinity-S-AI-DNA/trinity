module LoopGuard_loop_cond;

// LoopGuard struct with the same fields as the original
struct LoopGuard {
    id: u32,
    brk: bool,
    cnt: bool,
    ret: bool,
}

pub fn LoopGuard_loop_cond(self: LoopGuard) -> []const u8 {
    if (self.brk and self.ret) {
        return "!__t27_brk_42 && !__t27_ret";
    } else if (self.brk) {
        return "!__t27_brk_42";
    } else if (self.ret) {
        return "!__t27_ret";
    } else {
        return "";
    }
}

pub fn LoopGuard_needs_block(self: LoopGuard) -> bool {
    return self.brk || self.cnt;
}

test loop_cond_no_break_no_return {
    var guard: LoopGuard = LoopGuard {
        .id = 42,
        .brk = false,
        .cnt = false,
        .ret = false,
    };
    var result: []const u8 = LoopGuard_loop_cond(guard);
    // When neither brk nor ret, should return empty string
    assert(result.len == 0);
}

test loop_cond_break_only {
    var guard: LoopGuard = LoopGuard {
        .id = 42,
        .brk = true,
        .cnt = false,
        .ret = false,
    };
    var result: []const u8 = LoopGuard_loop_cond(guard);
    // When only brk, should return !__t27_brk_42
    assert(result.len > 0);
    assert(result[0] == '!');
}

test loop_cond_return_only {
    var guard: LoopGuard = LoopGuard {
        .id = 42,
        .brk = false,
        .cnt = false,
        .ret = true,
    };
    var result: []const u8 = LoopGuard_loop_cond(guard);
    // When only ret, should return !__t27_ret
    assert(result.len > 0);
    assert(result[0] == '!');
    assert(std.mem.indexOf(u8, result, "__t27_ret") != null);
}

test loop_cond_break_and_return {
    var guard: LoopGuard = LoopGuard {
        .id = 42,
        .brk = true,
        .cnt = false,
        .ret = true,
    };
    var result: []const u8 = LoopGuard_loop_cond(guard);
    // When both brk and ret, should return both conditions joined by &&
    assert(result.len > 0);
    assert(std.mem.indexOf(u8, result, "__t27_brk_42") != null);
    assert(std.mem.indexOf(u8, result, "__t27_ret") != null);
    assert(std.mem.indexOf(u8, result, "&&") != null);
}

test needs_block_break_only {
    var guard: LoopGuard = LoopGuard {
        .id = 42,
        .brk = true,
        .cnt = false,
        .ret = false,
    };
    var result: bool = LoopGuard_needs_block(guard);
    assert(result == true);
}

test needs_block_continue_only {
    var guard: LoopGuard = LoopGuard {
        .id = 42,
        .brk = false,
        .cnt = true,
        .ret = false,
    };
    var result: bool = LoopGuard_needs_block(guard);
    assert(result == true);
}

test needs_block_neither {
    var guard: LoopGuard = LoopGuard {
        .id = 42,
        .brk = false,
        .cnt = false,
        .ret = false,
    };
    var result: bool = LoopGuard_needs_block(guard);
    assert(result == false);
}

test needs_block_both_break_continue {
    var guard: LoopGuard = LoopGuard {
        .id = 42,
        .brk = true,
        .cnt = true,
        .ret = false,
    };
    var result: bool = LoopGuard_needs_block(guard);
    assert(result == true);
}