module port::bootstrap_compiler_hir_cover_point;

// Port of gHashTag/t27 bootstrap/src/compiler.rs lines 29486-29528: the
// HirCoverPoint and HirFormalAssume impl blocks, four functions:
//
//   line 29487  HirCoverPoint::new
//   line 29496  HirCoverPoint::validate
//   line 29509  HirFormalAssume::new
//   line 29518  HirFormalAssume::validate
//
// Rust `new` takes &str and builds owned Strings; strings here are immutable
// slices, so the copy is a plain field move. Rust `validate` returns a
// Vec<String>; this language has no growable lists, so the verdict is a fixed
// record: a count plus one flag per check, set in the order the original
// pushes its errors. The message texts the original pushes -
//   "cover point name must not be empty" (fixed) and
//   "cover point '<name>' has empty condition" (formatted with the name),
//   "assumption name must not be empty" (fixed) and
//   "assumption '<name>' has empty condition" (formatted with the name) -
// need string formatting, which stays with the caller; the decision of WHICH
// errors apply is what this port carries.

struct HirCoverPoint {
    name: str,
    condition: str,
    clock: str,
    description: str,
}

struct HirFormalAssume {
    name: str,
    condition: str,
    clock: str,
    description: str,
}

// What Rust's Vec<String> verdict carried: how many errors, and which of the
// two checks fired.
struct HirValidationVerdict {
    error_count: usize,
    name_error: bool,
    condition_error: bool,
}

// Rust line 29487: pub fn new(name: &str, condition: &str, clock: &str,
// description: &str) -> Self.
pub fn HirCoverPoint_new(name: str, condition: str, clock: str, description: str) -> HirCoverPoint {
    return HirCoverPoint {
        name: name,
        condition: condition,
        clock: clock,
        description: description
    };
}

// Rust line 29496: pub fn validate(&self) -> Vec<String>.
pub fn HirCoverPoint_validate(self: HirCoverPoint) -> HirValidationVerdict {
    var verdict: HirValidationVerdict = HirValidationVerdict {
        error_count: 0,
        name_error: false,
        condition_error: false
    };
    if (self.name == "") {
        verdict.name_error = true;
        verdict.error_count += 1;
    }
    if (self.condition == "") {
        verdict.condition_error = true;
        verdict.error_count += 1;
    }
    return verdict;
}

// Rust line 29509: pub fn new(name: &str, condition: &str, clock: &str,
// description: &str) -> Self on HirFormalAssume.
pub fn HirFormalAssume_new(name: str, condition: str, clock: str, description: str) -> HirFormalAssume {
    return HirFormalAssume {
        name: name,
        condition: condition,
        clock: clock,
        description: description
    };
}

// Rust line 29518: pub fn validate(&self) -> Vec<String> on HirFormalAssume.
pub fn HirFormalAssume_validate(self: HirFormalAssume) -> HirValidationVerdict {
    var verdict: HirValidationVerdict = HirValidationVerdict {
        error_count: 0,
        name_error: false,
        condition_error: false
    };
    if (self.name == "") {
        verdict.name_error = true;
        verdict.error_count += 1;
    }
    if (self.condition == "") {
        verdict.condition_error = true;
        verdict.error_count += 1;
    }
    return verdict;
}

// Rust lines 29488-29493: every &str input lands in its field.
test HirCoverPoint_new_sets_all_fields {
    const point: HirCoverPoint = HirCoverPoint_new("addr_stable", "stage_out != 0", "clk_sys", "covers a stable address");
    assert(point.name == "addr_stable");
    assert(point.condition == "stage_out != 0");
    assert(point.clock == "clk_sys");
    assert(point.description == "covers a stable address");
}

// Rust lines 29497-29504: a point with a name and a condition validates clean.
test HirCoverPoint_validate_accepts_complete_point {
    const point: HirCoverPoint = HirCoverPoint_new("data_valid", "ready && valid", "clk_sys", "covers a completed transfer");
    const verdict: HirValidationVerdict = HirCoverPoint_validate(point);
    assert(verdict.error_count == 0);
    assert(!verdict.name_error);
    assert(!verdict.condition_error);
}

// Rust lines 29498-29500: an empty name is the fixed "cover point name must
// not be empty" error, on its own.
test HirCoverPoint_validate_flags_empty_name {
    const point: HirCoverPoint = HirCoverPoint_new("", "stage_out != 0", "clk_sys", "covers a stable address");
    const verdict: HirValidationVerdict = HirCoverPoint_validate(point);
    assert(verdict.error_count == 1);
    assert(verdict.name_error);
    assert(!verdict.condition_error);
}

// Rust lines 29501-29503: an empty condition is the formatted
// "cover point '<name>' has empty condition" error, on its own.
test HirCoverPoint_validate_flags_empty_condition {
    const point: HirCoverPoint = HirCoverPoint_new("data_valid", "", "clk_sys", "covers a completed transfer");
    const verdict: HirValidationVerdict = HirCoverPoint_validate(point);
    assert(verdict.error_count == 1);
    assert(!verdict.name_error);
    assert(verdict.condition_error);
}

// Both checks empty: the original pushes the name error first, then the
// condition error - two entries.
test HirCoverPoint_validate_flags_both_empty {
    const point: HirCoverPoint = HirCoverPoint_new("", "", "", "");
    const verdict: HirValidationVerdict = HirCoverPoint_validate(point);
    assert(verdict.error_count == 2);
    assert(verdict.name_error);
    assert(verdict.condition_error);
}

// Rust lines 29510-29515: every &str input lands in its field.
test HirFormalAssume_new_sets_all_fields {
    const assume: HirFormalAssume = HirFormalAssume_new("addr_in_range", "addr < limit", "clk_sys", "assumes the address stays in range");
    assert(assume.name == "addr_in_range");
    assert(assume.condition == "addr < limit");
    assert(assume.clock == "clk_sys");
    assert(assume.description == "assumes the address stays in range");
}

// Rust lines 29519-29527: an assumption with a name and a condition
// validates clean.
test HirFormalAssume_validate_accepts_complete_assume {
    const assume: HirFormalAssume = HirFormalAssume_new("no_unknown_bits", "!is_x(data)", "clk_sys", "assumes no unknown bits on the bus");
    const verdict: HirValidationVerdict = HirFormalAssume_validate(assume);
    assert(verdict.error_count == 0);
    assert(!verdict.name_error);
    assert(!verdict.condition_error);
}

// Rust lines 29520-29522: an empty name is the fixed "assumption name must
// not be empty" error, on its own.
test HirFormalAssume_validate_flags_empty_name {
    const assume: HirFormalAssume = HirFormalAssume_new("", "addr < limit", "clk_sys", "assumes the address stays in range");
    const verdict: HirValidationVerdict = HirFormalAssume_validate(assume);
    assert(verdict.error_count == 1);
    assert(verdict.name_error);
    assert(!verdict.condition_error);
}

// Rust lines 29523-29525: an empty condition is the formatted
// "assumption '<name>' has empty condition" error, on its own.
test HirFormalAssume_validate_flags_empty_condition {
    const assume: HirFormalAssume = HirFormalAssume_new("no_unknown_bits", "", "clk_sys", "assumes no unknown bits on the bus");
    const verdict: HirValidationVerdict = HirFormalAssume_validate(assume);
    assert(verdict.error_count == 1);
    assert(!verdict.name_error);
    assert(verdict.condition_error);
}

// Both checks empty on an assumption: two entries, name first.
test HirFormalAssume_validate_flags_both_empty {
    const assume: HirFormalAssume = HirFormalAssume_new("", "", "", "");
    const verdict: HirValidationVerdict = HirFormalAssume_validate(assume);
    assert(verdict.error_count == 2);
    assert(verdict.name_error);
    assert(verdict.condition_error);
}
