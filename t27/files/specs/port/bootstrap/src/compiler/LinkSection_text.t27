module LinkSection_text;

pub struct LinkSection {
    pub name: []const u8,
    pub vaddr: u32,
    pub size: u32,
    pub flags: u32,
    pub alignment: u32,
}

pub struct LinkedSymbol {
    pub name: []const u8,
    pub value: u32,
    pub size: u32,
    pub section_idx: u32,
    pub bind: u32,
    pub kind: u32,
}

pub struct ValidationResult {
    pub ok: bool,
    pub errors: [1][]const u8,
}

pub fn LinkSection_text(vaddr: u32, size: u32) -> LinkSection {
    return LinkSection{
        .name = ".text",
        .vaddr = vaddr,
        .size = size,
        .flags = 5,
        .alignment = 4,
    };
}

pub fn LinkSection_data(vaddr: u32, size: u32) -> LinkSection {
    return LinkSection{
        .name = ".data",
        .vaddr = vaddr,
        .size = size,
        .flags = 3,
        .alignment = 4,
    };
}

pub fn LinkSection_bss(vaddr: u32, size: u32) -> LinkSection {
    return LinkSection{
        .name = ".bss",
        .vaddr = vaddr,
        .size = size,
        .flags = 2,
        .alignment = 4,
    };
}

pub fn LinkSection_end(self: LinkSection) -> u32 {
    if (self.vaddr > 0xFFFFFFFF - self.size) {
        return 0xFFFFFFFF; // saturating_add: return max value on overflow
    }
    return self.vaddr + self.size;
}

pub fn LinkedSymbol_new(name: []const u8, value: u32, section_idx: u32) -> LinkedSymbol {
    return LinkedSymbol{
        .name = name,
        .value = value,
        .size = 0,
        .section_idx = section_idx,
        .bind = 1,
        .kind = 2,
    };
}

pub fn LinkedSymbol_is_global(self: LinkedSymbol) -> bool {
    return self.bind == 1;
}

pub fn LinkedSymbol_is_local(self: LinkedSymbol) -> bool {
    return self.bind == 0;
}

pub fn LinkedSymbol_validate(self: LinkedSymbol) -> ValidationResult {
    var result: ValidationResult = ValidationResult{
        .ok = true,
        .errors = undefined,
    };
    
    if (self.name.len == 0) {
        result.errors[0] = "symbol name must not be empty";
        result.ok = false;
    }
    
    return result;
}

test LinkSection_text_creates_correct_section {
    const section = LinkSection_text(0x1000, 0x100);
    assert(section.name == ".text");
    assert(section.vaddr == 0x1000);
    assert(section.size == 0x100);
    assert(section.flags == 5);
    assert(section.alignment == 4);
}

test LinkSection_data_creates_correct_section {
    const section = LinkSection_data(0x2000, 0x200);
    assert(section.name == ".data");
    assert(section.vaddr == 0x2000);
    assert(section.size == 0x200);
    assert(section.flags == 3);
    assert(section.alignment == 4);
}

test LinkSection_bss_creates_correct_section {
    const section = LinkSection_bss(0x3000, 0x300);
    assert(section.name == ".bss");
    assert(section.vaddr == 0x3000);
    assert(section.size == 0x300);
    assert(section.flags == 2);
    assert(section.alignment == 4);
}

test LinkSection_end_calculates_correctly {
    const section1 = LinkSection{.name = "test", .vaddr = 0x1000, .size = 0x100, .flags = 0, .alignment = 0};
    assert(LinkSection_end(section1) == 0x1100);
    
    const section2 = LinkSection{.name = "test", .vaddr = 0xFFFFFFFF, .size = 1, .flags = 0, .alignment = 0};
    assert(LinkSection_end(section2) == 0xFFFFFFFF); // saturating_add behavior
}

test LinkedSymbol_new_creates_correct_symbol {
    const symbol = LinkedSymbol_new("test_symbol", 0x1234, 5);
    assert(symbol.name == "test_symbol");
    assert(symbol.value == 0x1234);
    assert(symbol.size == 0);
    assert(symbol.section_idx == 5);
    assert(symbol.bind == 1);
    assert(symbol.kind == 2);
}

test LinkedSymbol_is_global_returns_true_for_bind_1 {
    const symbol = LinkedSymbol{.name = "test", .value = 0, .size = 0, .section_idx = 0, .bind = 1, .kind = 0};
    assert(LinkedSymbol_is_global(symbol) == true);
}

test LinkedSymbol_is_global_returns_false_for_bind_0 {
    const symbol = LinkedSymbol{.name = "test", .value = 0, .size = 0, .section_idx = 0, .bind = 0, .kind = 0};
    assert(LinkedSymbol_is_global(symbol) == false);
}

test LinkedSymbol_is_local_returns_true_for_bind_0 {
    const symbol = LinkedSymbol{.name = "test", .value = 0, .size = 0, .section_idx = 0, .bind = 0, .kind = 0};
    assert(LinkedSymbol_is_local(symbol) == true);
}

test LinkedSymbol_is_local_returns_false_for_bind_1 {
    const symbol = LinkedSymbol{.name = "test", .value = 0, .size = 0, .section_idx = 0, .bind = 1, .kind = 0};
    assert(LinkedSymbol_is_local(symbol) == false);
}

test LinkedSymbol_validates_empty_name {
    const symbol = LinkedSymbol{.name = "", .value = 0, .size = 0, .section_idx = 0, .bind = 1, .kind = 2};
    const result = LinkedSymbol_validate(symbol);
    assert(result.ok == false);
    assert(result.errors[0] == "symbol name must not be empty");
}

test LinkedSymbol_validates_non_empty_name {
    const symbol = LinkedSymbol{.name = "valid_name", .value = 0, .size = 0, .section_idx = 0, .bind = 1, .kind = 2};
    const result = LinkedSymbol_validate(symbol);
    assert(result.ok == true);
    // Note: errors field is undefined when ok=true, but we don't access it in this test
}