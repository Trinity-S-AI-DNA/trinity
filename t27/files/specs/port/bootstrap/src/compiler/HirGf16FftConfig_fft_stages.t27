module port::bootstrap::src::compiler::hir_gf16_fft_config_fft_stages;

// Port of bootstrap/src/compiler.rs lines 29185-29203 (impl HirGf16FftConfig).
// Only the fields the ported logic reads are carried here; the original
// struct (referenced as HirGf16Accel.fft_config) holds more.

struct HirGf16FftConfig {
    num_points: u32,
    radix: u32,
}

// HirGf16FftConfig::fft_stages (line 29186): counts how many radix-r
// butterfly stages it takes to reduce num_points down to 1. A radix of 0
// cannot divide, so it yields 0 stages.
pub fn HirGf16FftConfig_fft_stages(self: HirGf16FftConfig) -> u32 {
    var n: u32 = self.num_points;
    let r: u32 = self.radix;
    if (r == 0) {
        return 0;
    }
    var stages: u32 = 0;
    while (n > 1) {
        stages += 1;
        n = n / r;
    }
    return stages;
}

// HirGf16FftConfig::twiddle_count (line 29200): a transform over num_points
// points needs num_points / 2 twiddle factors.
pub fn HirGf16FftConfig_twiddle_count(self: HirGf16FftConfig) -> u32 {
    return self.num_points / 2;
}

test fft_stages_powers_of_two {
    const cfg16: HirGf16FftConfig = HirGf16FftConfig { num_points: 16, radix: 2 };
    assert(HirGf16FftConfig_fft_stages(cfg16) == 4);
    const cfg1024: HirGf16FftConfig = HirGf16FftConfig { num_points: 1024, radix: 2 };
    assert(HirGf16FftConfig_fft_stages(cfg1024) == 10);
    const cfg81: HirGf16FftConfig = HirGf16FftConfig { num_points: 81, radix: 3 };
    assert(HirGf16FftConfig_fft_stages(cfg81) == 4);
}

test fft_stages_edges {
    // Radix 0 is unusable: the original returns 0 instead of dividing by zero.
    const cfg_r0: HirGf16FftConfig = HirGf16FftConfig { num_points: 256, radix: 0 };
    assert(HirGf16FftConfig_fft_stages(cfg_r0) == 0);
    // A single point needs no stages.
    const cfg_1: HirGf16FftConfig = HirGf16FftConfig { num_points: 1, radix: 2 };
    assert(HirGf16FftConfig_fft_stages(cfg_1) == 0);
    // 5 points with radix 2: 5 -> 2 -> 1, two divisions.
    const cfg_5: HirGf16FftConfig = HirGf16FftConfig { num_points: 5, radix: 2 };
    assert(HirGf16FftConfig_fft_stages(cfg_5) == 2);
    // Integer division can overshoot past 1: 64 -> 4 -> 0 stops the loop at 2.
    const cfg_64: HirGf16FftConfig = HirGf16FftConfig { num_points: 64, radix: 16 };
    assert(HirGf16FftConfig_fft_stages(cfg_64) == 2);
}

test twiddle_count_cases {
    const cfg16: HirGf16FftConfig = HirGf16FftConfig { num_points: 16, radix: 2 };
    assert(HirGf16FftConfig_twiddle_count(cfg16) == 8);
    const cfg1024: HirGf16FftConfig = HirGf16FftConfig { num_points: 1024, radix: 2 };
    assert(HirGf16FftConfig_twiddle_count(cfg1024) == 512);
    // Integer division: an odd point count rounds down.
    const cfg_3: HirGf16FftConfig = HirGf16FftConfig { num_points: 3, radix: 2 };
    assert(HirGf16FftConfig_twiddle_count(cfg_3) == 1);
    // A single point needs no twiddles.
    const cfg_1: HirGf16FftConfig = HirGf16FftConfig { num_points: 1, radix: 2 };
    assert(HirGf16FftConfig_twiddle_count(cfg_1) == 0);
}
