// t27/specs/port/bootstrap/src/compiler/HirBusPort_axi4_lite_slave.t27
// Port of bootstrap/src/compiler.rs lines 28853-29058 (impl HirBusPort) to t27.
// The AXI4-Lite / AXI4-Full bus-port API: kind/role, addr_width, data_width,
// id_width, strb_width, is_* predicates, validate, port_count, signal_bits.
//
// FR-002: t27 has no impl blocks, so the 12 methods are represented as free
// functions named `HirBusPort_method(self: HirBusPort, ...)`:
//   HirBusPort_axi4_lite_slave, HirBusPort_axi4_lite_master,
//   HirBusPort_axi4_full_slave, HirBusPort_axi4_full_master,
//   HirBusPort_strb_width, HirBusPort_is_lite, HirBusPort_is_full,
//   HirBusPort_is_slave, HirBusPort_is_master, HirBusPort_validate,
//   HirBusPort_port_count, HirBusPort_total_signal_bits.
//
// FR-003: validate() returns Vec<String> in the original; t27 has no growable
// lists and no string formatting, so it returns a fixed-capacity
// HirBusValidation of error codes instead (see the mapping below).
//
// The port decision covers AXI4-Lite vs AXI4-Full ports of either role:
// AXI4-Lite drops burst/cache/qos/region/lock/last/id signals, an AXI4-Full
// port requires a non-zero id_width, and every address/data/strb signal is
// sized from addr_width / data_width.
module port::hir_bus_port_axi4_lite_slave {

enum HwBusKind { Axi4Lite, Axi4Full, }
enum HwBusRole { Slave, Master, }

// Port of `pub struct HirBusPort` (bootstrap/src/compiler.rs, just above the
// impl block): name plus bus kind, bus role, addr_width, data_width, id_width.
pub struct HirBusPort {
    name: []const u8,
    kind: HwBusKind,
    role: HwBusRole,
    addr_width: u32,
    data_width: u32,
    id_width: u32,
}

// Fixed-capacity replacement for the Vec<String> of validate(): at most 5
// validation errors, pushed in the same order the original pushes messages.
// Error codes (0 = unused slot, len = number of codes pushed):
//   1 - "bus port name must not be empty"
//   2 - "bus '<name>' has zero address width"
//   3 - "bus '<name>' has zero data width"
//   4 - "bus '<name>' data width <w> is not byte-aligned"
//   5 - "AXI4-Full bus '<name>' must have non-zero ID width"
pub struct HirBusValidation {
    items: [5]u32,
    len: usize,
}

// Port of `pub fn axi4_lite_slave(name: impl Into<String>, addr_width: u32,
// data_width: u32) -> Self`: an AXI4-Lite slave port, id_width forced to 0.
pub fn HirBusPort_axi4_lite_slave(name: []const u8, addr_width: u32, data_width: u32) -> HirBusPort {
    return HirBusPort{
        .name = name,
        .kind = HwBusKind::Axi4Lite,
        .role = HwBusRole::Slave,
        .addr_width = addr_width,
        .data_width = data_width,
        .id_width = 0,
    };
}

// Port of `pub fn axi4_lite_master(...)`: an AXI4-Lite master port.
pub fn HirBusPort_axi4_lite_master(name: []const u8, addr_width: u32, data_width: u32) -> HirBusPort {
    return HirBusPort{
        .name = name,
        .kind = HwBusKind::Axi4Lite,
        .role = HwBusRole::Master,
        .addr_width = addr_width,
        .data_width = data_width,
        .id_width = 0,
    };
}

// Port of `pub fn axi4_full_slave(..., id_width: u32)`: an AXI4-Full slave
// port that carries the given id_width through.
pub fn HirBusPort_axi4_full_slave(name: []const u8, addr_width: u32, data_width: u32, id_width: u32) -> HirBusPort {
    return HirBusPort{
        .name = name,
        .kind = HwBusKind::Axi4Full,
        .role = HwBusRole::Slave,
        .addr_width = addr_width,
        .data_width = data_width,
        .id_width = id_width,
    };
}

// Port of `pub fn axi4_full_master(..., id_width: u32)`: an AXI4-Full master
// port.
pub fn HirBusPort_axi4_full_master(name: []const u8, addr_width: u32, data_width: u32, id_width: u32) -> HirBusPort {
    return HirBusPort{
        .name = name,
        .kind = HwBusKind::Axi4Full,
        .role = HwBusRole::Master,
        .addr_width = addr_width,
        .data_width = data_width,
        .id_width = id_width,
    };
}

// Port of `pub fn strb_width(&self) -> u32 { self.data_width / 8 }`: the
// strobe width is data_width divided by 8, rounding down.
pub fn HirBusPort_strb_width(self: HirBusPort) -> u32 {
    return self.data_width / 8;
}

// Port of `pub fn is_lite(&self) -> bool`: true for AXI4-Lite ports.
pub fn HirBusPort_is_lite(self: HirBusPort) -> bool {
    return self.kind == HwBusKind::Axi4Lite;
}

// Port of `pub fn is_full(&self) -> bool`: true for AXI4-Full ports.
pub fn HirBusPort_is_full(self: HirBusPort) -> bool {
    return self.kind == HwBusKind::Axi4Full;
}

// Port of `pub fn is_slave(&self) -> bool`: true for slave-role ports.
pub fn HirBusPort_is_slave(self: HirBusPort) -> bool {
    return self.role == HwBusRole::Slave;
}

// Port of `pub fn is_master(&self) -> bool`: true for master-role ports.
pub fn HirBusPort_is_master(self: HirBusPort) -> bool {
    return self.role == HwBusRole::Master;
}

// Port of `pub fn validate(&self) -> Vec<String>`: checks, in the original's
// order, that the bus port name is not empty, addr_width is non-zero,
// data_width is non-zero and a multiple of 8, and that an AXI4-Full port has
// a non-zero id_width. Returns the error codes instead of formatted strings.
pub fn HirBusPort_validate(self: HirBusPort) -> HirBusValidation {
    var errors: HirBusValidation = HirBusValidation{ .items = [0, 0, 0, 0, 0], .len = 0 };
    if (self.name == "") {
        errors.items[errors.len] = 1;
        errors.len += 1;
    }
    if (self.addr_width == 0) {
        errors.items[errors.len] = 2;
        errors.len += 1;
    }
    if (self.data_width == 0) {
        errors.items[errors.len] = 3;
        errors.len += 1;
    }
    if ((self.data_width % 8) != 0) {
        errors.items[errors.len] = 4;
        errors.len += 1;
    }
    if ((self.kind == HwBusKind::Axi4Full) && (self.id_width == 0)) {
        errors.items[errors.len] = 5;
        errors.len += 1;
    }
    return errors;
}

// Port of `pub fn port_count(&self) -> u32`: the per-port signal count over
// the five AXI4 channels (AW/W/B/AR/R), with burst/cache/qos/region/lock/
// last/id signals present only on the AXI4-Full shape or when id_width > 0.
pub fn HirBusPort_port_count(self: HirBusPort) -> u32 {
    var count: u32 = 0;
    const has_id: bool = self.id_width > 0;
    const is_lite: bool = self.kind == HwBusKind::Axi4Lite;

    // AW channel
    count += 2;                      // awvalid, awready
    count += 1;                      // awaddr
    if (has_id) {
        count += 1;                  // awid
    }
    if (!is_lite) {
        count += 3;                  // awlen, awsize, awburst
    }
    if (!is_lite) {
        count += 1;                  // awcache
    }
    count += 1;                      // awprot
    if (!is_lite) {
        count += 1;                  // awqos
        count += 1;                  // awregion
        count += 1;                  // awlock
    }

    // W channel
    count += 2;                      // wvalid, wready
    count += 1;                      // wdata
    count += 1;                      // wstrb
    if (!is_lite) {
        count += 1;                  // wlast
    }

    // B channel
    count += 2;                      // bvalid, bready
    count += 1;                      // bresp
    if (has_id) {
        count += 1;                  // bid
    }

    // AR channel (mirrors AW)
    count += 2;
    count += 1;
    if (has_id) {
        count += 1;
    }
    if (!is_lite) {
        count += 3;
    }
    if (!is_lite) {
        count += 1;
    }
    count += 1;
    if (!is_lite) {
        count += 1;
        count += 1;
        count += 1;
    }

    // R channel (mirrors W plus rid)
    count += 2;
    count += 1;
    count += 1;
    if (!is_lite) {
        count += 1;                  // rlast
    }
    if (has_id) {
        count += 1;                  // rid
    }

    return count;
}

// Port of `pub fn total_signal_bits(&self) -> u32`: the bit count over the
// five AXI4 channels, sized from addr_width / data_width / id_width / strb
// width like the original, with the extra AXI4-Full control bits.
pub fn HirBusPort_total_signal_bits(self: HirBusPort) -> u32 {
    var bits: u32 = 0;
    const has_id: bool = self.id_width > 0;
    const is_lite: bool = self.kind == HwBusKind::Axi4Lite;

    // AW channel
    bits += self.addr_width;         // awaddr
    if (has_id) {
        bits += self.id_width;       // awid
    }
    if (!is_lite) {
        bits += 26;                  // awlen(8) awsize(3) awburst(2) awcache(4) awqos(4) awregion(4) awlock(1)
    }
    bits += 3;                       // awprot
    bits += 2;                       // awvalid, awready

    // W channel
    bits += self.data_width;         // wdata
    bits += HirBusPort_strb_width(self);  // wstrb
    if (!is_lite) {
        bits += 1;                   // wlast
    }
    bits += 2;                       // wvalid, wready

    // B channel
    bits += 2;                       // bresp
    if (has_id) {
        bits += self.id_width;       // bid
    }
    bits += 2;                       // bvalid, bready

    // AR channel (mirrors AW)
    bits += self.addr_width;
    if (has_id) {
        bits += self.id_width;
    }
    if (!is_lite) {
        bits += 26;
    }
    bits += 3;
    bits += 2;

    // R channel (mirrors W plus rid)
    bits += self.data_width;         // rdata
    bits += 2;                       // rresp
    if (!is_lite) {
        bits += 1;                   // rlast
    }
    if (has_id) {
        bits += self.id_width;       // rid
    }
    bits += 2;                       // rvalid, rready

    return bits;
}

// ---- tests ----

test axi4_lite_slave_fields {
    var p = HirBusPort_axi4_lite_slave("s_axi", 16, 32);
    assert(p.id_width == 0);
    assert(p.addr_width == 16);
    assert(p.data_width == 32);
    assert(HirBusPort_is_lite(p));
    assert(!HirBusPort_is_full(p));
    assert(HirBusPort_is_slave(p));
    assert(!HirBusPort_is_master(p));
}

test axi4_lite_master_fields {
    var p = HirBusPort_axi4_lite_master("m_axi", 32, 64);
    assert(p.id_width == 0);
    assert(p.addr_width == 32);
    assert(p.data_width == 64);
    assert(HirBusPort_is_lite(p));
    assert(HirBusPort_is_master(p));
    assert(!HirBusPort_is_slave(p));
    assert(!HirBusPort_is_full(p));
}

test axi4_full_slave_fields {
    var p = HirBusPort_axi4_full_slave("s_full", 32, 64, 4);
    assert(p.id_width == 4);
    assert(p.addr_width == 32);
    assert(p.data_width == 64);
    assert(HirBusPort_is_full(p));
    assert(!HirBusPort_is_lite(p));
    assert(HirBusPort_is_slave(p));
    assert(!HirBusPort_is_master(p));
}

test axi4_full_master_fields {
    var p = HirBusPort_axi4_full_master("m_full", 48, 128, 6);
    assert(p.id_width == 6);
    assert(p.addr_width == 48);
    assert(p.data_width == 128);
    assert(HirBusPort_is_full(p));
    assert(HirBusPort_is_master(p));
    assert(!HirBusPort_is_slave(p));
    assert(!HirBusPort_is_lite(p));
}

test strb_width_values {
    var p1 = HirBusPort_axi4_lite_slave("p1", 32, 32);
    assert(HirBusPort_strb_width(p1) == 4);
    var p2 = HirBusPort_axi4_lite_slave("p2", 32, 64);
    assert(HirBusPort_strb_width(p2) == 8);
    var p3 = HirBusPort_axi4_full_slave("p3", 32, 8, 1);
    assert(HirBusPort_strb_width(p3) == 1);
    var p4 = HirBusPort_axi4_full_master("p4", 32, 16, 1);
    assert(HirBusPort_strb_width(p4) == 2);
}

test strb_width_rounds_down {
    var p = HirBusPort_axi4_lite_slave("p", 32, 12);
    assert(HirBusPort_strb_width(p) == 1);
}

test is_lite_and_is_full {
    var l = HirBusPort_axi4_lite_slave("l", 16, 32);
    var f = HirBusPort_axi4_full_master("f", 16, 32, 2);
    assert(HirBusPort_is_lite(l));
    assert(!HirBusPort_is_full(l));
    assert(!HirBusPort_is_lite(f));
    assert(HirBusPort_is_full(f));
}

test is_slave_and_is_master {
    var s = HirBusPort_axi4_full_slave("s", 16, 32, 2);
    var m = HirBusPort_axi4_lite_master("m", 16, 32);
    assert(HirBusPort_is_slave(s));
    assert(!HirBusPort_is_master(s));
    assert(!HirBusPort_is_slave(m));
    assert(HirBusPort_is_master(m));
}

test validate_clean_lite_port {
    var p = HirBusPort_axi4_lite_slave("bus0", 16, 32);
    var e = HirBusPort_validate(p);
    assert(e.len == 0);
    assert(e.items[0] == 0);
    assert(e.items[4] == 0);
}

test validate_empty_name {
    var p = HirBusPort_axi4_lite_slave("", 16, 32);
    var e = HirBusPort_validate(p);
    assert(e.len == 1);
    assert(e.items[0] == 1);
}

test validate_zero_widths {
    var pa = HirBusPort_axi4_lite_slave("bus0", 0, 32);
    var ea = HirBusPort_validate(pa);
    assert(ea.len == 1);
    assert(ea.items[0] == 2);

    var pd = HirBusPort_axi4_lite_slave("bus0", 16, 0);
    var ed = HirBusPort_validate(pd);
    assert(ed.len == 1);
    assert(ed.items[0] == 3);
}

test validate_not_byte_aligned {
    var p = HirBusPort_axi4_lite_slave("bus0", 16, 12);
    var e = HirBusPort_validate(p);
    assert(e.len == 1);
    assert(e.items[0] == 4);
}

test validate_full_requires_id {
    var p = HirBusPort_axi4_full_slave("bus0", 16, 32, 0);
    var e = HirBusPort_validate(p);
    assert(e.len == 1);
    assert(e.items[0] == 5);
}

test validate_collects_all_errors {
    var p = HirBusPort_axi4_full_slave("", 0, 0, 0);
    var e = HirBusPort_validate(p);
    assert(e.len == 4);
    assert(e.items[0] == 1);
    assert(e.items[1] == 2);
    assert(e.items[2] == 3);
    assert(e.items[3] == 5);
    assert(e.items[4] == 0);
}

test validate_clean_full_port {
    var p = HirBusPort_axi4_full_slave("bus1", 32, 64, 4);
    var e = HirBusPort_validate(p);
    assert(e.len == 0);
}

test port_count_lite_slave {
    var p = HirBusPort_axi4_lite_slave("bus0", 16, 32);
    assert(HirBusPort_port_count(p) == 19);
}

test port_count_lite_master {
    var p = HirBusPort_axi4_lite_master("bus0", 32, 64);
    assert(HirBusPort_port_count(p) == 19);
}

test port_count_full_slave {
    var p = HirBusPort_axi4_full_slave("bus1", 32, 64, 4);
    assert(HirBusPort_port_count(p) == 39);
}

test port_count_full_master {
    var p = HirBusPort_axi4_full_master("bus1", 32, 64, 4);
    assert(HirBusPort_port_count(p) == 39);
}

test port_count_lite_with_id {
    // Edge case the original handles: an AXI4-Lite kind with id_width > 0
    // still gains the id signals (has_id is independent of is_lite).
    var p = HirBusPort{ .name = "odd", .kind = HwBusKind::Axi4Lite, .role = HwBusRole::Master, .addr_width = 16, .data_width = 32, .id_width = 4 };
    assert(HirBusPort_port_count(p) == 23);
}

test total_signal_bits_lite {
    // AXI4-Lite: no id/burst/cache/qos/region/lock/last bits.
    var p = HirBusPort_axi4_lite_slave("bus0", 32, 32);
    // AW: 32+3+2=37, W: 32+4+2=38, B: 2+2=4, AR: 37, R: 32+2+2=36
    assert(HirBusPort_total_signal_bits(p) == 152);
}

test total_signal_bits_full {
    var p = HirBusPort_axi4_full_slave("bus1", 32, 64, 4);
    // AW: 32+4+26+3+2=67, W: 64+8+1+2=75, B: 2+4+2=8, AR: 67, R: 64+2+1+4+2=73
    assert(HirBusPort_total_signal_bits(p) == 290);
}

test total_signal_bits_uneven_strb {
    var p = HirBusPort_axi4_lite_slave("bus0", 8, 24);
    // AW: 8+5=13, W: 24+3+2=29, B: 4, AR: 13, R: 24+4=28
    assert(HirBusPort_total_signal_bits(p) == 87);
}

}
