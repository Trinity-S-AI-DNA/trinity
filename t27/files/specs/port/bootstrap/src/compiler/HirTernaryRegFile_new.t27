// t27/specs/port/bootstrap/src/compiler/HirTernaryRegFile_new.t27
// Port of bootstrap/src/compiler.rs lines 29696-29795 (gHashTag/t27) to t27.

// HirTernaryRegFile, HirResourceEstimate and HirBoardResources with the seven
// functions issue #6165 lists. Every body below is a pure decision - a
// constructor or integer arithmetic on its inputs - so there is no plumbing
// and no `undefined;` stub: all seven are implemented and tested.
//
// HirIpCore and HirIpCatalog sit in the same Rust range but are struct
// declarations only, with no impls and no functions to port. HirIpCatalog
// holds a `Vec<HirIpCore>`, and growable lists do not compile in this
// language; a fixed-capacity struct would be the shape if a function over
// them is ever ported.

module port::hir_ternary_reg_file_new;

pub struct HirTernaryRegFile {
    name: str,
    num_regs: u32,
    trit_width: u32,
    read_ports: u32,
    write_ports: u32,
    has_forwarding: bool,
}

// compiler.rs:29697 - `pub fn new(name: &str) -> Self`, with the fixed
// 27-register / 27-trit shape of the ternary register file.
pub fn HirTernaryRegFile_new(name: str) -> HirTernaryRegFile {
    return HirTernaryRegFile {
        name: name,
        num_regs: 27,
        trit_width: 27,
        read_ports: 2,
        write_ports: 1,
        has_forwarding: true,
    };
}

// compiler.rs:29708 - `pub fn total_bits(&self) -> u32`.
pub fn HirTernaryRegFile_total_bits(self: HirTernaryRegFile) -> u32 {
    return self.num_regs * self.trit_width * 2;
}

// compiler.rs:29712 - `pub fn bram18_count(&self) -> u32`. Integer division,
// and the +1 guarantees at least one 18432-bit BRAM18 block even when the
// register file is far smaller than one block.
pub fn HirTernaryRegFile_bram18_count(self: HirTernaryRegFile) -> u32 {
    return HirTernaryRegFile_total_bits(self) / 18432 + 1;
}

pub struct HirResourceEstimate {
    luts: u32,
    ffs: u32,
    bram18: u32,
    dsp48: u32,
    io_pins: u32,
}

// compiler.rs:29727 - `pub fn zero() -> Self`.
pub fn HirResourceEstimate_zero() -> HirResourceEstimate {
    return HirResourceEstimate {
        luts: 0,
        ffs: 0,
        bram18: 0,
        dsp48: 0,
        io_pins: 0,
    };
}

// compiler.rs:29737 - `pub fn new(luts, ffs, bram18, dsp48, io_pins) -> Self`.
pub fn HirResourceEstimate_new(luts: u32, ffs: u32, bram18: u32, dsp48: u32, io_pins: u32) -> HirResourceEstimate {
    return HirResourceEstimate {
        luts: luts,
        ffs: ffs,
        bram18: bram18,
        dsp48: dsp48,
        io_pins: io_pins,
    };
}

pub struct HirBoardResources {
    name: str,
    luts: u32,
    ffs: u32,
    bram18: u32,
    dsp48: u32,
    io_pins: u32,
}

// compiler.rs:29767 - `pub fn arty_a7() -> Self`.
pub fn HirBoardResources_arty_a7() -> HirBoardResources {
    return HirBoardResources {
        name: "arty_a7",
        luts: 33800,
        ffs: 67600,
        bram18: 60,
        dsp48: 90,
        io_pins: 210,
    };
}

// compiler.rs:29778 - `pub fn xc7a100t() -> Self`.
pub fn HirBoardResources_xc7a100t() -> HirBoardResources {
    return HirBoardResources {
        name: "xc7a100t",
        luts: 63400,
        ffs: 126800,
        bram18: 135,
        dsp48: 240,
        io_pins: 300,
    };
}

// ------------------------------------------------------------------
// Tests - one per function, plus arithmetic edge cases
// ------------------------------------------------------------------

test HirTernaryRegFile_new_defaults {
    const rf = HirTernaryRegFile_new("x0");
    assert(rf.num_regs == 27);
    assert(rf.trit_width == 27);
    assert(rf.read_ports == 2);
    assert(rf.write_ports == 1);
    assert(rf.has_forwarding);
}

test HirTernaryRegFile_new_keeps_name {
    const rf = HirTernaryRegFile_new("x0");
    assert(rf.name == "x0");
}

test HirTernaryRegFile_total_bits_default {
    // 27 registers * 27 trits * 2 bits per trit = 1458.
    const rf = HirTernaryRegFile_new("x0");
    assert(HirTernaryRegFile_total_bits(rf) == 1458);
}

test HirTernaryRegFile_total_bits_custom {
    const rf = HirTernaryRegFile { name: "small", num_regs: 4, trit_width: 9, read_ports: 2, write_ports: 1, has_forwarding: true };
    assert(HirTernaryRegFile_total_bits(rf) == 72);
}

test HirTernaryRegFile_bram18_count_default {
    // 1458 bits is far below one 18432-bit block: the +1 still yields 1.
    const rf = HirTernaryRegFile_new("x0");
    assert(HirTernaryRegFile_bram18_count(rf) == 1);
}

test HirTernaryRegFile_bram18_count_exact_fit {
    // 9216 * 1 * 2 = 18432 exactly: one full block plus the +1 = 2.
    const rf = HirTernaryRegFile { name: "fit", num_regs: 9216, trit_width: 1, read_ports: 2, write_ports: 1, has_forwarding: true };
    assert(HirTernaryRegFile_bram18_count(rf) == 2);
}

test HirTernaryRegFile_bram18_count_two_full_blocks {
    // 18432 * 1 * 2 = 36864: two full blocks plus the +1 = 3.
    const rf = HirTernaryRegFile { name: "two", num_regs: 18432, trit_width: 1, read_ports: 2, write_ports: 1, has_forwarding: true };
    assert(HirTernaryRegFile_bram18_count(rf) == 3);
}

test HirResourceEstimate_zero_is_zero {
    const est = HirResourceEstimate_zero();
    assert(est.luts == 0);
    assert(est.ffs == 0);
    assert(est.bram18 == 0);
    assert(est.dsp48 == 0);
    assert(est.io_pins == 0);
}

test HirResourceEstimate_new_carries_fields {
    const est = HirResourceEstimate_new(10, 20, 3, 4, 5);
    assert(est.luts == 10);
    assert(est.ffs == 20);
    assert(est.bram18 == 3);
    assert(est.dsp48 == 4);
    assert(est.io_pins == 5);
}

test HirBoardResources_arty_a7_constants {
    const br = HirBoardResources_arty_a7();
    assert(br.name == "arty_a7");
    assert(br.luts == 33800);
    assert(br.ffs == 67600);
    assert(br.bram18 == 60);
    assert(br.dsp48 == 90);
    assert(br.io_pins == 210);
}

test HirBoardResources_xc7a100t_constants {
    const br = HirBoardResources_xc7a100t();
    assert(br.name == "xc7a100t");
    assert(br.luts == 63400);
    assert(br.ffs == 126800);
    assert(br.bram18 == 135);
    assert(br.dsp48 == 240);
    assert(br.io_pins == 300);
}

test xc7a100t_is_the_bigger_chip {
    // Every resource count of the xc7a100t entry dominates the arty_a7 one,
    // which is how the two constants sit in the original.
    const arty = HirBoardResources_arty_a7();
    const xc = HirBoardResources_xc7a100t();
    assert(arty.luts < xc.luts);
    assert(arty.ffs < xc.ffs);
    assert(arty.bram18 < xc.bram18);
    assert(arty.dsp48 < xc.dsp48);
    assert(arty.io_pins < xc.io_pins);
}
