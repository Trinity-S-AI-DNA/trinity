// SPDX-License-Identifier: Apache-2.0
// Port of the clock-domain and FIFO types from bootstrap/src/compiler.rs:
// HwClkSrcKind, HirClkSource, HirClockDomain, HwCrossStrategy, HirClockCrossing,
// HwFifoKind, HirFifo and their constructors/accessors.

module port::hir_clock_domain_new;

pub enum HwClkSrcKind { External, Pll, Dcm, Mmcm, }

pub struct HirClkSource {
    name: str,
    kind: HwClkSrcKind,
    freq_hz: u32,
    phase_deg: u32,
    jitter_ps: u32,
}

pub struct HirClockDomain {
    name: str,
    source_name: str,
    freq_hz: u32,
    posedge: bool,
}

pub fn HirClockDomain_new(name: str, source: str, freq_hz: u32) -> HirClockDomain {
    return HirClockDomain{
        .name = name,
        .source_name = source,
        .freq_hz = freq_hz,
        .posedge = true,
    };
}

pub fn HirClockDomain_period_ns(self: HirClockDomain) -> u32 {
    if (self.freq_hz == 0) {
        return 0;
    }
    return 1_000_000_000 / self.freq_hz;
}

pub fn HirClockDomain_half_period_ns(self: HirClockDomain) -> u32 {
    return HirClockDomain_period_ns(self) / 2;
}

pub enum HwCrossStrategy { TwoFlop, FifoAsync, Handshake, }

pub struct HirClockCrossing {
    src_domain: str,
    dst_domain: str,
    strategy: HwCrossStrategy,
    data_width: u32,
}

pub enum HwFifoKind { Sync, Async, }

pub struct HirFifo {
    name: str,
    kind: HwFifoKind,
    depth: u32,
    data_width: u32,
    has_almost_empty: bool,
    has_almost_full: bool,
    almost_empty_threshold: u32,
    almost_full_threshold: u32,
}

pub fn HirFifo_new_sync(name: str, depth: u32, data_width: u32) -> HirFifo {
    return HirFifo{
        .name = name,
        .kind = HwFifoKind::Sync,
        .depth = depth,
        .data_width = data_width,
        .has_almost_empty = false,
        .has_almost_full = false,
        .almost_empty_threshold = 0,
        .almost_full_threshold = 0,
    };
}

pub fn HirFifo_new_async(name: str, depth: u32, data_width: u32) -> HirFifo {
    return HirFifo{
        .name = name,
        .kind = HwFifoKind::Async,
        .depth = depth,
        .data_width = data_width,
        .has_almost_empty = false,
        .has_almost_full = false,
        .almost_empty_threshold = 0,
        .almost_full_threshold = 0,
    };
}

pub fn HirFifo_addr_width(self: HirFifo) -> u32 {
    if (self.depth <= 1) {
        return 1;
    }
    var w: u32 = 0;
    var d: u32 = self.depth;
    while (d > 1) {
        w += 1;
        d = d / 2;
    }
    if (w < 1) {
        return 1;
    }
    return w;
}

pub fn HirFifo_total_bits(self: HirFifo) -> u32 {
    return self.depth * self.data_width;
}

// ---- tests ----

test clock_domain_new_fields {
    const d = HirClockDomain_new("clk_cpu", "pll0", 100000000);
    assert(d.name == "clk_cpu");
    assert(d.source_name == "pll0");
    assert(d.freq_hz == 100000000);
    assert(d.posedge);
}

test clock_domain_period_ns_zero {
    const d = HirClockDomain_new("clk_stall", "pll0", 0);
    assert(HirClockDomain_period_ns(d) == 0);
    assert(HirClockDomain_half_period_ns(d) == 0);
}

test clock_domain_period_ns_values {
    const d = HirClockDomain_new("clk_100", "pll0", 100000000);
    assert(HirClockDomain_period_ns(d) == 10);
    const d2 = HirClockDomain_new("clk_200", "pll0", 200000000);
    assert(HirClockDomain_period_ns(d2) == 5);
    const d3 = HirClockDomain_new("clk_500", "pll0", 500000000);
    assert(HirClockDomain_period_ns(d3) == 2);
    const d4 = HirClockDomain_new("clk_1hz", "ext0", 1);
    assert(HirClockDomain_period_ns(d4) == 1000000000);
}

test clock_domain_half_period_ns_values {
    const d = HirClockDomain_new("clk_100", "pll0", 100000000);
    assert(HirClockDomain_half_period_ns(d) == 5);
    const d2 = HirClockDomain_new("clk_200", "pll0", 200000000);
    assert(HirClockDomain_half_period_ns(d2) == 2);
    const d3 = HirClockDomain_new("clk_1", "pll0", 1);
    assert(HirClockDomain_half_period_ns(d3) == 500000000);
}

test fifo_new_sync_fields {
    const f = HirFifo_new_sync("fifo0", 16, 32);
    assert(f.name == "fifo0");
    assert(f.kind == HwFifoKind::Sync);
    assert(f.depth == 16);
    assert(f.data_width == 32);
    assert(!f.has_almost_empty);
    assert(!f.has_almost_full);
    assert(f.almost_empty_threshold == 0);
    assert(f.almost_full_threshold == 0);
}

test fifo_new_async_fields {
    const f = HirFifo_new_async("fifo1", 64, 8);
    assert(f.name == "fifo1");
    assert(f.kind == HwFifoKind::Async);
    assert(f.kind != HwFifoKind::Sync);
    assert(f.depth == 64);
    assert(f.data_width == 8);
    assert(!f.has_almost_empty);
    assert(!f.has_almost_full);
}

test fifo_addr_width_edges {
    const f0 = HirFifo_new_sync("f0", 0, 8);
    assert(HirFifo_addr_width(f0) == 1);
    const f1 = HirFifo_new_sync("f1", 1, 8);
    assert(HirFifo_addr_width(f1) == 1);
    const f2 = HirFifo_new_sync("f2", 2, 8);
    assert(HirFifo_addr_width(f2) == 1);
    const f3 = HirFifo_new_sync("f3", 3, 8);
    assert(HirFifo_addr_width(f3) == 1);
    const f4 = HirFifo_new_sync("f4", 4, 8);
    assert(HirFifo_addr_width(f4) == 2);
    const f7 = HirFifo_new_sync("f7", 7, 8);
    assert(HirFifo_addr_width(f7) == 2);
    const f8 = HirFifo_new_sync("f8", 8, 8);
    assert(HirFifo_addr_width(f8) == 3);
}

test fifo_addr_width_powers {
    const f16 = HirFifo_new_sync("f16", 16, 8);
    assert(HirFifo_addr_width(f16) == 4);
    const f1024 = HirFifo_new_sync("f1024", 1024, 8);
    assert(HirFifo_addr_width(f1024) == 10);
    const f65536 = HirFifo_new_sync("f65536", 65536, 8);
    assert(HirFifo_addr_width(f65536) == 16);
}

test fifo_total_bits {
    const f = HirFifo_new_sync("f", 16, 32);
    assert(HirFifo_total_bits(f) == 512);
    const g = HirFifo_new_async("g", 1024, 8);
    assert(HirFifo_total_bits(g) == 8192);
    const h = HirFifo_new_sync("h", 0, 8);
    assert(HirFifo_total_bits(h) == 0);
    const i = HirFifo_new_sync("i", 1, 1);
    assert(HirFifo_total_bits(i) == 1);
}
