module port::bootstrap::src::compiler::HwType_hw_width;

// ===========================================================================
// Hardware IR (HIR) - Phase-0 FPGA foundation
// ===========================================================================
// Port of the HwType helpers from bootstrap/src/compiler.rs lines 28671-28748
// (gHashTag/t27#6155, at f244bd2bd316). The original is hand-written Rust; this
// .t27 twin is the source the code should have been written in, so it is
// generated instead of maintained by hand.
//
// Deviations from the original, named here rather than faked:
// - The original HwType (line 28671) is a Rust enum with payloads, including
//   the recursive Vector(Box<HwType>, u32) (line 28678) and
//   Bundle(Vec<(String, HwType)>) (line 28679). t27 has no enum payloads, no
//   boxes, no growable lists and no recursion, so HwType is ported as a struct
//   with a tag enum plus the scalar facts the five ported functions read:
//   `width` carries the Bits/UInt/SInt payload (and a Vector's precomputed
//   element width), `len` a Vector's length (and an Enum's variant count), and
//   `fields`/`n_fields` a Bundle's per-field widths (fixed capacity 8, per the
//   fixed-capacity-list rule; each field's width is precomputed for nested
//   element types by whoever builds the HwType, which lives outside this
//   slice). The field names the original carries are read by nothing in this
//   slice, so they are not carried.
// - HwResetKind / HwResetPolarity (lines 28686-28696) are payloads that no
//   ported function reads (hw_width matches Reset with `Reset(_, _)`, line
//   28703; is_reset_like matches the tag only, line 28737), so they are not
//   carried.
// - HwType_verilog_range (line 28740) returns format!("[{}:0]", w - 1) (line
//   28745). t27 has no string formatting or concatenation, so the function
//   returns the decision as a VerilogRange struct: empty = true is the
//   original's String::new() branch (lines 28742-28743), and hi = w - 1 with
//   empty = false is the original's "[{}:0]" payload; the caller renders
//   [hi:0].

pub enum HwTypeTag {
    Bits,
    UInt,
    SInt,
    Bool,
    Clock,
    Reset,
    Vector,
    Bundle,
    Enum,
    GF16
}

pub struct HwType {
    tag: HwTypeTag,
    width: u32,
    len: u32,
    fields: [8]u32,
    n_fields: usize
}

pub struct VerilogRange {
    empty: bool,
    hi: u32
}

const FIELDS_NONE: [8]u32 = [0, 0, 0, 0, 0, 0, 0, 0];

pub fn HwType_hw_width(self: HwType) -> u32 {
    return switch (self.tag) {
        .Bits => self.width,
        .UInt => self.width,
        .SInt => self.width,
        .Bool => 1,
        .Clock => 1,
        .Reset => 1,
        .Vector => self.width * self.len,
        .Bundle => HwType_bundle_width(self),
        .Enum => HwType_enum_width(self.len),
        .GF16 => 16,
    };
}

fn HwType_bundle_width(self: HwType) -> u32 {
    // Carries the Bundle arm of hw_width (line 28705): the sum of the field
    // widths.
    var total: u32 = 0;
    var i: usize = 0;
    while (i < self.n_fields) {
        total += self.fields[i];
        i += 1;
    }
    return total;
}

fn HwType_enum_width(n: u32) -> u32 {
    // Carries the Enum arm of hw_width (lines 28706-28723): the bit width for
    // a variant count, the same ladder the original walks.
    if (n <= 2) {
        return 1;
    } else if (n <= 4) {
        return 2;
    } else if (n <= 8) {
        return 3;
    } else if (n <= 16) {
        return 4;
    } else if (n <= 32) {
        return 5;
    } else if (n <= 64) {
        return 6;
    }
    return 8;
}

pub fn HwType_is_signed(self: HwType) -> bool {
    return switch (self.tag) {
        .SInt => true,
        else => false,
    };
}

pub fn HwType_is_clock_like(self: HwType) -> bool {
    return switch (self.tag) {
        .Clock => true,
        else => false,
    };
}

pub fn HwType_is_reset_like(self: HwType) -> bool {
    return switch (self.tag) {
        .Reset => true,
        else => false,
    };
}

pub fn HwType_verilog_range(self: HwType) -> VerilogRange {
    const w = HwType_hw_width(self);
    if (w <= 1) {
        return VerilogRange{ .empty = true, .hi = 0 };
    }
    return VerilogRange{ .empty = false, .hi = w - 1 };
}

test hw_width_integer_payloads {
    const bits8 = HwType{ .tag = HwTypeTag.Bits, .width = 8, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const uint16 = HwType{ .tag = HwTypeTag.UInt, .width = 16, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const sint32 = HwType{ .tag = HwTypeTag.SInt, .width = 32, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    assert(HwType_hw_width(bits8) == 8);
    assert(HwType_hw_width(uint16) == 16);
    assert(HwType_hw_width(sint32) == 32);
}

test hw_width_single_bit_kinds {
    const boolean = HwType{ .tag = HwTypeTag.Bool, .width = 0, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const clock = HwType{ .tag = HwTypeTag.Clock, .width = 0, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const reset = HwType{ .tag = HwTypeTag.Reset, .width = 0, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const gf16 = HwType{ .tag = HwTypeTag.GF16, .width = 0, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    assert(HwType_hw_width(boolean) == 1);
    assert(HwType_hw_width(clock) == 1);
    assert(HwType_hw_width(reset) == 1);
    assert(HwType_hw_width(gf16) == 16);
}

test hw_width_vector_multiplies_element_by_length {
    // Vector(Box<HwType>, u32): element width x length (original line 28704).
    // t27 cannot nest an HwType inside an HwType, so `width` carries the
    // element's precomputed width (an SInt(4) element is 4 bits).
    const vec_sint4_x3 = HwType{ .tag = HwTypeTag.Vector, .width = 4, .len = 3, .fields = FIELDS_NONE, .n_fields = 0 };
    const vec_sint1_x5 = HwType{ .tag = HwTypeTag.Vector, .width = 1, .len = 5, .fields = FIELDS_NONE, .n_fields = 0 };
    assert(HwType_hw_width(vec_sint4_x3) == 12);
    assert(HwType_hw_width(vec_sint1_x5) == 5);
}

test hw_width_bundle_sums_field_widths {
    // Bundle(Vec<(String, HwType)>): the sum of the field widths (line 28705).
    const f3: [8]u32 = [4, 4, 8, 0, 0, 0, 0, 0];
    const bundle3 = HwType{ .tag = HwTypeTag.Bundle, .width = 0, .len = 0, .fields = f3, .n_fields = 3 };
    assert(HwType_hw_width(bundle3) == 16);
    assert(HwType_bundle_width(bundle3) == 16);
    const f1: [8]u32 = [32, 0, 0, 0, 0, 0, 0, 0];
    const bundle1 = HwType{ .tag = HwTypeTag.Bundle, .width = 0, .len = 0, .fields = f1, .n_fields = 1 };
    assert(HwType_hw_width(bundle1) == 32);
}

test hw_width_enum_variant_ladder {
    // Enum(Vec<(String, String)>): width from the variant count (lines
    // 28706-28723). Every edge of the original ladder.
    assert(HwType_enum_width(1) == 1);
    assert(HwType_enum_width(2) == 1);
    assert(HwType_enum_width(3) == 2);
    assert(HwType_enum_width(4) == 2);
    assert(HwType_enum_width(5) == 3);
    assert(HwType_enum_width(8) == 3);
    assert(HwType_enum_width(9) == 4);
    assert(HwType_enum_width(16) == 4);
    assert(HwType_enum_width(17) == 5);
    assert(HwType_enum_width(32) == 5);
    assert(HwType_enum_width(33) == 6);
    assert(HwType_enum_width(64) == 6);
    assert(HwType_enum_width(65) == 8);
}

test hw_width_enum_via_hw_width {
    const enum4 = HwType{ .tag = HwTypeTag.Enum, .width = 0, .len = 4, .fields = FIELDS_NONE, .n_fields = 0 };
    const enum65 = HwType{ .tag = HwTypeTag.Enum, .width = 0, .len = 65, .fields = FIELDS_NONE, .n_fields = 0 };
    assert(HwType_hw_width(enum4) == 2);
    assert(HwType_hw_width(enum65) == 8);
}

test is_signed_is_true_only_for_top_level_sint {
    const sint8 = HwType{ .tag = HwTypeTag.SInt, .width = 8, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const uint8 = HwType{ .tag = HwTypeTag.UInt, .width = 8, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const bits8 = HwType{ .tag = HwTypeTag.Bits, .width = 8, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const boolean = HwType{ .tag = HwTypeTag.Bool, .width = 0, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    // matches!(self, HwType::SInt(_)) matches the top-level variant only, so a
    // Vector of SInt elements is not itself signed (line 28729).
    const vec_of_sint = HwType{ .tag = HwTypeTag.Vector, .width = 8, .len = 2, .fields = FIELDS_NONE, .n_fields = 0 };
    assert(HwType_is_signed(sint8));
    assert(!HwType_is_signed(uint8));
    assert(!HwType_is_signed(bits8));
    assert(!HwType_is_signed(boolean));
    assert(!HwType_is_signed(vec_of_sint));
}

test is_clock_like_is_true_only_for_clock {
    const clock = HwType{ .tag = HwTypeTag.Clock, .width = 0, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const reset = HwType{ .tag = HwTypeTag.Reset, .width = 0, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const boolean = HwType{ .tag = HwTypeTag.Bool, .width = 0, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const gf16 = HwType{ .tag = HwTypeTag.GF16, .width = 0, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    assert(HwType_is_clock_like(clock));
    assert(!HwType_is_clock_like(reset));
    assert(!HwType_is_clock_like(boolean));
    assert(!HwType_is_clock_like(gf16));
}

test is_reset_like_is_true_only_for_reset {
    const reset = HwType{ .tag = HwTypeTag.Reset, .width = 0, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const clock = HwType{ .tag = HwTypeTag.Clock, .width = 0, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const boolean = HwType{ .tag = HwTypeTag.Bool, .width = 0, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    assert(HwType_is_reset_like(reset));
    assert(!HwType_is_reset_like(clock));
    assert(!HwType_is_reset_like(boolean));
}

test verilog_range_is_empty_for_width_at_most_one {
    // w <= 1: the original returns String::new() (lines 28742-28743); the port
    // carries the decision as empty = true.
    const boolean = HwType{ .tag = HwTypeTag.Bool, .width = 0, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const bits1 = HwType{ .tag = HwTypeTag.Bits, .width = 1, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const reset = HwType{ .tag = HwTypeTag.Reset, .width = 0, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const r_bool = HwType_verilog_range(boolean);
    assert(r_bool.empty);
    assert(r_bool.hi == 0);
    const r_bits1 = HwType_verilog_range(bits1);
    assert(r_bits1.empty);
    const r_reset = HwType_verilog_range(reset);
    assert(r_reset.empty);
}

test verilog_range_hi_is_width_minus_one {
    // w > 1: the original returns format!("[{}:0]", w - 1) (lines 28744-28745);
    // the port carries hi = w - 1 with empty = false, and the caller renders
    // [hi:0].
    const bits2 = HwType{ .tag = HwTypeTag.Bits, .width = 2, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const bits8 = HwType{ .tag = HwTypeTag.Bits, .width = 8, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const gf16 = HwType{ .tag = HwTypeTag.GF16, .width = 0, .len = 0, .fields = FIELDS_NONE, .n_fields = 0 };
    const vec16 = HwType{ .tag = HwTypeTag.Vector, .width = 4, .len = 4, .fields = FIELDS_NONE, .n_fields = 0 };
    const f3: [8]u32 = [8, 8, 8, 0, 0, 0, 0, 0];
    const bundle24 = HwType{ .tag = HwTypeTag.Bundle, .width = 0, .len = 0, .fields = f3, .n_fields = 3 };
    const r_bits2 = HwType_verilog_range(bits2);
    assert(!r_bits2.empty);
    assert(r_bits2.hi == 1);
    const r_bits8 = HwType_verilog_range(bits8);
    assert(!r_bits8.empty);
    assert(r_bits8.hi == 7);
    const r_gf16 = HwType_verilog_range(gf16);
    assert(r_gf16.hi == 15);
    const r_vec16 = HwType_verilog_range(vec16);
    assert(r_vec16.hi == 15);
    const r_bundle24 = HwType_verilog_range(bundle24);
    assert(r_bundle24.hi == 23);
}
