// Port of bootstrap/src/compiler.rs, impl HirIpCatalog (lines 30053-30125),
// ten hand-written Rust functions re-authored here in .t27
// (gHashTag/t27#6166, roadmap stage 0 of 9). The issue named lines
// 29796-29869; the file has shifted since, and the same ten functions now
// sit at 30053-30125 - the behaviour is unchanged except where noted.
//
// Decisions kept, plumbing dropped:
// - The original's growable Vec<HirIpCore> becomes a fixed-capacity array of
//   32 slots with cores_len counting the slots in use.
// - add_core takes the catalog by value and returns the updated catalog,
//   because .t27 has no mutable references (&mut self).
// - validate() returns a fixed-capacity list of at most 65 messages (1
//   catalog error plus 2 per core, the worst case a 32-core catalog makes).
// - The format! interpolation at line 30120 becomes the fixed message
//   "IP core has zero clock frequency": .t27 does not compile string
//   concatenation, so the core name cannot be spliced into the message.
// - HirResourceEstimate::new (line 29994) stores its five numbers verbatim,
//   so the port stores them as given.
// - luts_remaining ports the CURRENT file's board.luts.saturating_sub
//   (line 30100); the issue's quoted slice had the operands swapped.

struct HirResourceEstimate {
    luts: u32,
    ffs: u32,
    bram18: u32,
    dsp48: u32,
    io_pins: u32,
}

struct HirIpCore {
    name: []const u8,
    resources: HirResourceEstimate,
    clock_freq_mhz: u32,
    verified: bool,
}

struct HirBoardResources {
    name: []const u8,
    luts: u32,
    ffs: u32,
    bram18: u32,
    dsp48: u32,
    io_pins: u32,
}

struct HirIpCatalog {
    name: []const u8,
    cores: [32]HirIpCore,
    cores_len: usize,
}

struct ValidationErrors {
    items: [65]str,
    len: usize,
}

// A zeroed HirIpCore; the element the fixed-capacity array starts from.
fn empty_core() -> HirIpCore {
    return HirIpCore{
        name: "",
        resources: HirResourceEstimate{ luts: 0, ffs: 0, bram18: 0, dsp48: 0, io_pins: 0, },
        clock_freq_mhz: 0,
        verified: false,
    };
}

// The decision inside add_core (compiler.rs:30071): build the core record
// with its estimate and verified = false.
fn make_core(name: []const u8, luts: u32, ffs: u32, bram18: u32, dsp48: u32, io: u32, freq_mhz: u32) -> HirIpCore {
    return HirIpCore{
        name: name,
        resources: HirResourceEstimate{ luts: luts, ffs: ffs, bram18: bram18, dsp48: dsp48, io_pins: io, },
        clock_freq_mhz: freq_mhz,
        verified: false,
    };
}

// compiler.rs:30054 - pub fn new(name: &str) -> Self
pub fn HirIpCatalog_new(name: []const u8) -> HirIpCatalog {
    return HirIpCatalog{
        name: name,
        cores: [_]HirIpCore{empty_core()} ** 32,
        cores_len: 0,
    };
}

// compiler.rs:30061 - pub fn add_core(&mut self, ...). The capacity decision
// (a full catalog keeps the incoming core out) is ported here; the caller
// gets the updated catalog back.
pub fn HirIpCatalog_add_core(catalog: HirIpCatalog, name: []const u8, luts: u32, ffs: u32, bram18: u32, dsp48: u32, io: u32, freq_mhz: u32) -> HirIpCatalog {
    if (catalog.cores_len >= 32) {
        return catalog;
    }
    var updated: HirIpCatalog = catalog;
    updated.cores[updated.cores_len] = make_core(name, luts, ffs, bram18, dsp48, io, freq_mhz);
    updated.cores_len += 1;
    return updated;
}

// compiler.rs:30079 - pub fn total_luts(&self) -> u32
pub fn HirIpCatalog_total_luts(catalog: HirIpCatalog) -> u32 {
    var total: u32 = 0;
    var i: usize = 0;
    while (i < catalog.cores_len) {
        const core: HirIpCore = catalog.cores[i];
        total += core.resources.luts;
        i += 1;
    }
    return total;
}

// compiler.rs:30082 - pub fn total_ffs(&self) -> u32
pub fn HirIpCatalog_total_ffs(catalog: HirIpCatalog) -> u32 {
    var total: u32 = 0;
    var i: usize = 0;
    while (i < catalog.cores_len) {
        const core: HirIpCore = catalog.cores[i];
        total += core.resources.ffs;
        i += 1;
    }
    return total;
}

// compiler.rs:30085 - pub fn total_bram18(&self) -> u32
pub fn HirIpCatalog_total_bram18(catalog: HirIpCatalog) -> u32 {
    var total: u32 = 0;
    var i: usize = 0;
    while (i < catalog.cores_len) {
        const core: HirIpCore = catalog.cores[i];
        total += core.resources.bram18;
        i += 1;
    }
    return total;
}

// compiler.rs:30088 - pub fn total_dsp48(&self) -> u32
pub fn HirIpCatalog_total_dsp48(catalog: HirIpCatalog) -> u32 {
    var total: u32 = 0;
    var i: usize = 0;
    while (i < catalog.cores_len) {
        const core: HirIpCore = catalog.cores[i];
        total += core.resources.dsp48;
        i += 1;
    }
    return total;
}

// compiler.rs:30092 - pub fn fits_board(&self, board: &HirBoardResources) -> bool
pub fn HirIpCatalog_fits_board(catalog: HirIpCatalog, board: HirBoardResources) -> bool {
    return HirIpCatalog_total_luts(catalog) <= board.luts
        and HirIpCatalog_total_ffs(catalog) <= board.ffs
        and HirIpCatalog_total_bram18(catalog) <= board.bram18
        and HirIpCatalog_total_dsp48(catalog) <= board.dsp48;
}

// compiler.rs:30099 - pub fn luts_remaining(&self, board: &HirBoardResources) -> u32
// board.luts.saturating_sub(self.total_luts()): board capacity minus what the
// catalog uses, never below zero.
pub fn HirIpCatalog_luts_remaining(catalog: HirIpCatalog, board: HirBoardResources) -> u32 {
    const used: u32 = HirIpCatalog_total_luts(catalog);
    if (used > board.luts) {
        return 0;
    }
    return board.luts - used;
}

// compiler.rs:30103 - pub fn utilization_percent(&self, board: &HirBoardResources) -> u32
pub fn HirIpCatalog_utilization_percent(catalog: HirIpCatalog, board: HirBoardResources) -> u32 {
    if (board.luts == 0) {
        return 0;
    }
    return HirIpCatalog_total_luts(catalog) * 100 / board.luts;
}

// compiler.rs:30110 - pub fn validate(&self) -> Vec<String>
// Vec<String> becomes a fixed-capacity list; the format! name interpolation
// of line 30120 becomes the fixed message below.
pub fn HirIpCatalog_validate(catalog: HirIpCatalog) -> ValidationErrors {
    var items: [65]str = undefined;
    var len: usize = 0;
    if (catalog.name == "") {
        items[len] = "catalog name must not be empty";
        len += 1;
    }
    var i: usize = 0;
    while (i < catalog.cores_len) {
        const core: HirIpCore = catalog.cores[i];
        if (core.name == "") {
            items[len] = "IP core name must not be empty";
            len += 1;
        }
        if (core.clock_freq_mhz == 0) {
            items[len] = "IP core has zero clock frequency";
            len += 1;
        }
        i += 1;
    }
    return ValidationErrors{ items: items, len: len };
}

test new_makes_empty_catalog {
    const c: HirIpCatalog = HirIpCatalog_new("gfx");
    assert(c.cores_len == 0);
    assert(c.name == "gfx");
}

test empty_core_defaults {
    const e = empty_core();
    assert(e.name == "");
    assert(e.verified == false);
    assert(e.resources.luts == 0);
}

test make_core_defaults {
    const c = make_core("pcie", 500, 100, 2, 4, 8, 125);
    assert(c.name == "pcie");
    assert(c.resources.luts == 500);
    assert(c.resources.io_pins == 8);
    assert(c.clock_freq_mhz == 125);
    assert(c.verified == false);
}

test totals_of_empty_catalog {
    const c = HirIpCatalog_new("");
    assert(HirIpCatalog_total_luts(c) == 0);
    assert(HirIpCatalog_total_ffs(c) == 0);
    assert(HirIpCatalog_total_bram18(c) == 0);
    assert(HirIpCatalog_total_dsp48(c) == 0);
}

test add_core_records_the_core {
    const c = HirIpCatalog_add_core(HirIpCatalog_new("gfx"), "uart", 100, 20, 1, 0, 2, 50);
    const k = c.cores[0];
    assert(c.cores_len == 1);
    assert(k.name == "uart");
    assert(k.resources.luts == 100);
    assert(k.resources.ffs == 20);
    assert(k.resources.io_pins == 2);
    assert(k.clock_freq_mhz == 50);
    assert(k.verified == false);
}

test add_core_totals_two_cores {
    const a = HirIpCatalog_add_core(HirIpCatalog_new("gfx"), "uart", 100, 20, 1, 2, 2, 50);
    const b = HirIpCatalog_add_core(a, "spi", 250, 40, 3, 4, 4, 100);
    assert(HirIpCatalog_total_luts(b) == 350);
    assert(HirIpCatalog_total_ffs(b) == 60);
    assert(HirIpCatalog_total_bram18(b) == 4);
    assert(HirIpCatalog_total_dsp48(b) == 6);
}

test fits_board_true_when_within {
    const b = HirIpCatalog_add_core(HirIpCatalog_new("gfx"), "uart", 100, 20, 1, 2, 2, 50);
    const board = HirBoardResources{ name: "xc7a100t", luts: 350, ffs: 60, bram18: 4, dsp48: 6, io_pins: 100, };
    assert(HirIpCatalog_fits_board(b, board) == true);
}

test fits_board_false_when_over {
    const b = HirIpCatalog_add_core(HirIpCatalog_new("gfx"), "uart", 100, 20, 1, 2, 2, 50);
    const board = HirBoardResources{ name: "xc7a100t", luts: 99, ffs: 60, bram18: 4, dsp48: 6, io_pins: 100, };
    assert(HirIpCatalog_fits_board(b, board) == false);
}

test luts_remaining_saturates_at_zero {
    const b = HirIpCatalog_add_core(HirIpCatalog_new("gfx"), "uart", 300, 20, 1, 2, 2, 50);
    const small = HirBoardResources{ name: "small", luts: 100, ffs: 60, bram18: 4, dsp48: 6, io_pins: 100, };
    const big = HirBoardResources{ name: "big", luts: 400, ffs: 60, bram18: 4, dsp48: 6, io_pins: 100, };
    assert(HirIpCatalog_luts_remaining(b, small) == 0);
    assert(HirIpCatalog_luts_remaining(b, big) == 100);
}

test utilization_percent_zero_board {
    const b = HirIpCatalog_add_core(HirIpCatalog_new("gfx"), "uart", 100, 20, 1, 2, 2, 50);
    const board = HirBoardResources{ name: "xc7a100t", luts: 0, ffs: 60, bram18: 4, dsp48: 6, io_pins: 100, };
    assert(HirIpCatalog_utilization_percent(b, board) == 0);
}

test utilization_percent_truncates {
    const b = HirIpCatalog_add_core(HirIpCatalog_new("gfx"), "uart", 1, 20, 1, 2, 2, 50);
    const board = HirBoardResources{ name: "xc7a100t", luts: 3, ffs: 60, bram18: 4, dsp48: 6, io_pins: 100, };
    assert(HirIpCatalog_utilization_percent(b, board) == 33);
}

test validate_flags_empty_catalog_name {
    const c = HirIpCatalog_new("");
    const errs = HirIpCatalog_validate(c);
    assert(errs.len == 1);
    assert(errs.items[0] == "catalog name must not be empty");
}

test validate_flags_core_problems {
    const b = HirIpCatalog_add_core(HirIpCatalog_new("gfx"), "", 100, 20, 1, 2, 2, 0);
    const errs = HirIpCatalog_validate(b);
    assert(errs.len == 2);
    assert(errs.items[0] == "IP core name must not be empty");
    assert(errs.items[1] == "IP core has zero clock frequency");
}

test validate_clean_catalog {
    const b = HirIpCatalog_add_core(HirIpCatalog_new("gfx"), "uart", 100, 20, 1, 2, 2, 50);
    const errs = HirIpCatalog_validate(b);
    assert(errs.len == 0);
}

test add_core_respects_fixed_capacity {
    var c = HirIpCatalog_new("gfx");
    var i: u32 = 0;
    while (i < 40) {
        c = HirIpCatalog_add_core(c, "ip", 1, 1, 0, 0, 0, 10);
        i += 1;
    }
    assert(c.cores_len == 32);
    assert(HirIpCatalog_total_luts(c) == 32);
}
