module port::trios::macos::rings::rust13::trios_mesh::tools::deploy;

const BOARDS: [3][]const u8 = ["192.168.1.11", "192.168.1.12", "192.168.1.13"];
const PASSWORD: []const u8 = "analog";
const SSH_OPTS: [6][]const u8 = ["-o", "StrictHostKeyChecking=no", "-o", "PubkeyAuthentication=no", "-o", "ConnectTimeout=10"];
const BIN_DIR: []const u8 = "target/armv7-unknown-linux-musleabihf/release";
const BINARIES: [2][]const u8 = ["trios_meshd", "smoke-m1"];

pub struct SshArgs {
    args: [12][]const u8,
    len: usize,
}

pub fn count_deploy_actions(binaries: [][]const u8, boards: [][]const u8, existing_binaries: []bool) usize {
    var total: usize = 0;
    var i: usize = 0;
    while (i < binaries.len) {
        if (existing_binaries[i]) {
            total += boards.len;
        }
        i += 1;
    }
    return total;
}

pub fn deployment_indices(binaries: [][]const u8, boards: [][]const u8, existing_binaries: []bool, out_indices: []usize) usize {
    var written: usize = 0;
    var bin_idx: usize = 0;
    while (bin_idx < binaries.len) {
        if (existing_binaries[bin_idx]) {
            var board_idx: usize = 0;
            while (board_idx < boards.len) {
                if (written < out_indices.len) {
                    out_indices[written] = bin_idx * boards.len + board_idx;
                    written += 1;
                }
                board_idx += 1;
            }
        }
        bin_idx += 1;
    }
    return written;
}

pub fn build_ssh_args(password: []const u8, ssh_opts: [6][]const u8, user_at_host: []const u8, remote_cmd: []const u8) SshArgs {
    var args: [12][]const u8 = undefined;
    args[0] = "-p";
    args[1] = password;
    var i: usize = 0;
    while (i < ssh_opts.len) {
        args[2 + i] = ssh_opts[i];
        i += 1;
    }
    args[2 + ssh_opts.len] = user_at_host;
    args[3 + ssh_opts.len] = remote_cmd;
    return SshArgs { .args = args, .len = 4 + ssh_opts.len };
}

pub fn deployment_status(success: bool) []const u8 {
    return if (success) "OK" else "FAIL";
}

pub fn main() {
    undefined;
}

test count_deploy_actions_all_exist {
    var existing: [2]bool = [true, true];
    const count = count_deploy_actions(&BINARIES, &BOARDS, &existing);
    assert(count == 6);
}

test count_deploy_actions_one_missing {
    var existing: [2]bool = [true, false];
    const count = count_deploy_actions(&BINARIES, &BOARDS, &existing);
    assert(count == 3);
}

test count_deploy_actions_none_exist {
    var existing: [2]bool = [false, false];
    const count = count_deploy_actions(&BINARIES, &BOARDS, &existing);
    assert(count == 0);
}

test deployment_indices_all_exist {
    var existing: [2]bool = [true, true];
    var indices: [6]usize = undefined;
    var binaries_var: [2][]const u8 = BINARIES;
    var boards_var: [3][]const u8 = BOARDS;
    const written = deployment_indices(&binaries_var, &boards_var, &existing, &indices);
    assert(written == 6);
    assert(indices[0] == 0);
    assert(indices[1] == 1);
    assert(indices[2] == 2);
    assert(indices[3] == 3);
    assert(indices[4] == 4);
    assert(indices[5] == 5);
}

test deployment_indices_one_missing {
    var existing: [2]bool = [true, false];
    var indices: [6]usize = undefined;
    var binaries_var: [2][]const u8 = BINARIES;
    var boards_var: [3][]const u8 = BOARDS;
    const written = deployment_indices(&binaries_var, &boards_var, &existing, &indices);
    assert(written == 3);
    assert(indices[0] == 0);
    assert(indices[1] == 1);
    assert(indices[2] == 2);
}

test deployment_indices_none_exist {
    var existing: [2]bool = [false, false];
    var indices: [6]usize = undefined;
    var binaries_var: [2][]const u8 = BINARIES;
    var boards_var: [3][]const u8 = BOARDS;
    const written = deployment_indices(&binaries_var, &boards_var, &existing, &indices);
    assert(written == 0);
}

test build_ssh_args_structure {
    const ssh_args = build_ssh_args(PASSWORD, SSH_OPTS, "root@192.168.1.11", "cat > /tmp/trios_meshd && chmod +x /tmp/trios_meshd");
    assert(ssh_args.len == 10);
    assert(ssh_args.args[0] == "-p");
    assert(ssh_args.args[1] == "analog");
    assert(ssh_args.args[2] == "-o");
    assert(ssh_args.args[3] == "StrictHostKeyChecking=no");
    assert(ssh_args.args[4] == "-o");
    assert(ssh_args.args[5] == "PubkeyAuthentication=no");
    assert(ssh_args.args[6] == "-o");
    assert(ssh_args.args[7] == "ConnectTimeout=10");
    assert(ssh_args.args[8] == "root@192.168.1.11");
    assert(ssh_args.args[9] == "cat > /tmp/trios_meshd && chmod +x /tmp/trios_meshd");
}

test deployment_status_values {
    assert(deployment_status(true) == "OK");
    assert(deployment_status(false) == "FAIL");
}