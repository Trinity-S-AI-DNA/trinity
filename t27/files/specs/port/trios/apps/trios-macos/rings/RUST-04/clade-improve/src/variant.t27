module specs::port::trios::apps::trios_macos::rings::RUST_04::clade_improve::src;

enum Variant {
    Prod,
    Staging,
    Dev,
}

// Helper function for from_env: decides variant from environment string
fn variant_from_env_str(env: []const u8) -> Variant {
    if (env == "dev") {
        return Variant::Dev;
    }
    if (env == "staging") {
        return Variant::Staging;
    }
    return Variant::Prod;
}

// Original function: reads environment variable and returns Variant
pub fn Variant_from_env() -> Variant {
    let env = get_env_trios_variant(); // undefined: plumbing
    return variant_from_env_str(env);
}

// Helper function for mcp_port: decides port from Variant
fn variant_mcp_port_str(self: Variant) -> u16 {
    switch (self) {
        .Prod => 9105,
        .Staging => 9205,
        .Dev => 9305
    }
}

// Original function: returns mcp port based on Variant
pub fn Variant_mcp_port(self: Variant) -> u16 {
    return variant_mcp_port_str(self);
}

// Helper function for working_dir: decides working directory string from root and Variant
fn variant_working_dir_str(root: []const u8, self: Variant) -> []const u8 {
    switch (self) {
        .Prod => root,
        .Staging => std::fmt::alloc("{}/.worktrees/staging", root),
        .Dev => std::fmt::alloc("{}/.trinity/dev", root)
    }
}

// Original function: returns working directory PathBuf based on Variant
pub fn Variant_working_dir(self: Variant) -> []const u8 {
    let root = trios_config_project_dir(); // undefined: plumbing
    return variant_working_dir_str(root, self);
}

// Helper function for is_production: decides if Variant is Prod
fn variant_is_production_str(self: Variant) -> bool {
    return self == Variant::Prod;
}

// Original function: returns true if Variant is Prod
pub fn Variant_is_production(self: Variant) -> bool {
    return variant_is_production_str(self);
}

// Helper function for can_self_modify: decides if Variant can self modify
fn variant_can_self_modify_str(self: Variant) -> bool {
    return self == Variant::Dev;
}

// Original function: returns true if Variant is Dev
pub fn Variant_can_self_modify(self: Variant) -> bool {
    return variant_can_self_modify_str(self);
}

// Undefined plumbing functions (no tests call these)
fn get_env_trios_variant() -> []const u8 {
    undefined;
}

fn trios_config_project_dir() -> []const u8 {
    undefined;
}

// Tests for helper functions

test variant_from_env_str_dev {
    assert(variant_from_env_str("dev") == Variant::Dev);
}

test variant_from_env_str_staging {
    assert(variant_from_env_str("staging") == Variant::Staging);
}

test variant_from_env_str_other {
    assert(variant_from_env_str("prod") == Variant::Prod);
    assert(variant_from_env_str("") == Variant::Prod);
    assert(variant_from_env_str("unknown") == Variant::Prod);
}

test variant_mcp_port_str_prod {
    assert(variant_mcp_port_str(Variant::Prod) == 9105);
}

test variant_mcp_port_str_staging {
    assert(variant_mcp_port_str(Variant::Staging) == 9205);
}

test variant_mcp_port_str_dev {
    assert(variant_mcp_port_str(Variant::Dev) == 9305);
}

test variant_working_dir_str_prod {
    assert(variant_working_dir_str("/project", Variant::Prod) == "/project");
}

test variant_working_dir_str_staging {
    assert(variant_working_dir_str("/project", Variant::Staging) == "/project/.worktrees/staging");
}

test variant_working_dir_str_dev {
    assert(variant_working_dir_str("/project", Variant::Dev) == "/project/.trinity/dev");
}

test variant_is_production_str_true {
    assert(variant_is_production_str(Variant::Prod) == true);
}

test variant_is_production_str_false {
    assert(variant_is_production_str(Variant::Staging) == false);
    assert(variant_is_production_str(Variant::Dev) == false);
}

test variant_can_self_modify_str_true {
    assert(variant_can_self_modify_str(Variant::Dev) == true);
}

test variant_can_self_modify_str_false {
    assert(variant_can_self_modify_str(Variant::Prod) == false);
    assert(variant_can_self_modify_str(Variant::Staging) == false);
}