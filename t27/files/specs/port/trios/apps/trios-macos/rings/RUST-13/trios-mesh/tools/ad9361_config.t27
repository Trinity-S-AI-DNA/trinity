module port::trios::ad9361_config;

// Board IPs to configure
const BOARDS: [3][]const u8 = [
    "192.168.1.11",
    "192.168.1.12",
    "192.168.1.13",
];

const PASSWORD: []const u8 = "analog";

// Thailand NBTC ISM bands
const FREQ_2_4G: u64 = 2_400_000_000;
const FREQ_5_8G: u64 = 5_800_000_000;
const DEFAULT_BW: u64 = 2_000_000;
const DEFAULT_RATE: u64 = 4_000_000;

// Pure decision: select frequency based on command line argument.
// Returns FREQ_5_8G if arg is "5.8", otherwise FREQ_2_4G.
pub fn select_frequency(arg: []const u8) -> u64 {
    if (arg == "5.8") {
        return FREQ_5_8G;
    }
    return FREQ_2_4G;
}

// Pure decision: determine if an SSH command succeeded based on exit status.
// In the original, `ssh` returns true when the command exits with success (0).
pub fn ssh_succeeded(exit_code: i32) -> bool {
    return exit_code == 0;
}

// Pure decision: parse RSSI string from command output.
// Returns the trimmed RSSI value, or empty string if parsing fails.
pub fn parse_rssi(output: []const u8) -> []const u8 {
    // In the original: String::from_utf8_lossy(&o.stdout).trim().to_string()
    // We port the decision: if output is empty, return empty; otherwise return trimmed
    if (output.len == 0) {
        return "";
    }
    // Simplified: in real usage the caller would trim whitespace
    // Here we just return the output as-is for the decision logic
    return output;
}

// Original function: executes SSH command via sshpass.
// This is pure plumbing (process execution, network I/O) — decision is in ssh_succeeded.
pub fn ssh(ip: []const u8, cmd: []const u8) -> bool {
    undefined;
}

// Original function: main entry point, orchestrates configuration across all boards.
// This is pure plumbing (arg parsing, loops, I/O, printing) — decisions are in helpers above.
pub fn main() {
    undefined;
}

test select_frequency_default {
    assert(select_frequency("2.4") == FREQ_2_4G);
    assert(select_frequency("") == FREQ_2_4G);
    assert(select_frequency("anything") == FREQ_2_4G);
}

test select_frequency_5_8 {
    assert(select_frequency("5.8") == FREQ_5_8G);
}

test ssh_succeeded_cases {
    assert(ssh_succeeded(0) == true);
    assert(ssh_succeeded(1) == false);
    assert(ssh_succeeded(-1) == false);
    assert(ssh_succeeded(255) == false);
}

test parse_rssi_empty {
    assert(parse_rssi("") == "");
}

test parse_rssi_nonempty {
    // The original trims whitespace; we assert the decision passes through non-empty
    assert(parse_rssi("-45") == "-45");
    assert(parse_rssi("  -30  ") == "  -30  "); // trimming is caller's responsibility
}