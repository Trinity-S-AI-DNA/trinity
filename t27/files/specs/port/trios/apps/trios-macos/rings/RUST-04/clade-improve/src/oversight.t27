// Test cases for the ported functions

test OversightAgent_default_creates_instance {
    var agent = OversightAgent_default();
    // Verify the agent is created with expected defaults
    // In the original, this calls OversightAgent_new() which sets signature_key_id to "HSM_OVERSIGHT_01"
    assert(agent.signature_key_id == "HSM_OVERSIGHT_01");
}

test OversightAgent_new_initializes_correctly {
