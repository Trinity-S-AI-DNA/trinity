module port::trios::crates::trios_sacred::rings::SC_00;

pub struct Vec2 {
    pub x: f64,
    pub y: f64,
}

pub fn Vec2_new(x: f64, y: f64) -> Vec2 {
    return Vec2 { x: x, y: y };
}

pub fn Vec2_dot(self: Vec2, other: Vec2) -> f64 {
    return self.x * other.x + self.y * other.y;
}

pub struct Triangle {
    pub points: [3]Vec2,
}

pub struct Circle {
    pub center: Vec2,
    pub radius: f64,
}

test Vec2_new_basic {
    const v = Vec2_new(1.0, 2.0);
    assert(v.x == 1.0);
    assert(v.y == 2.0);
}

test Vec2_dot_orthogonal {
    const a = Vec2_new(1.0, 0.0);
    const b = Vec2_new(0.0, 1.0);
    assert(Vec2_dot(a, b) == 0.0);
}

test Vec2_dot_parallel {
    const a = Vec2_new(2.0, 3.0);
    const b = Vec2_new(4.0, 6.0);
    assert(Vec2_dot(a, b) == 26.0);
}

test Vec2_dot_zero_vector {
    const zero = Vec2_new(0.0, 0.0);
    const v = Vec2_new(5.0, 7.0);
    assert(Vec2_dot(zero, v) == 0.0);
    assert(Vec2_dot(v, zero) == 0.0);
}