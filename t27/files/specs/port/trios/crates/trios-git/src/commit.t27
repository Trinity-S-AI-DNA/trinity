// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trios/crates/trios-git/src/commit.t27
//
// Port of gHashTag/trios crates/trios-git/src/commit.rs to t27.
//
// WHAT THIS SPEC DELIBERATELY DOES NOT CONTAIN
//
// The plumbing. The original create_commit(repo_path, message) opens the
// repository, takes its index, counts the staged entries, writes the tree,
// resolves the committer signature, picks the parent commit from HEAD and
// records the commit. Every one of those steps is an external effect on the
// repository on disk (git2 / Repository calls), and .t27 has no effect
// system, so the generated code leaves exactly the call shapes behind, as
// stubs that no test calls, with create_commit itself keeping an
// `undefined;` body.
//
// What is ported is every decision inside it:
// - repo.head() is a match: when HEAD resolves, the commit gets exactly one
//   parent (HEAD peeled to a commit); when it does not (the initial commit
//   on an unborn branch), the parent list is empty.
//   -> parent_count
// - index.iter().count() counts the staged entries before the tree is
//   written, and that count is the number of files the commit reports.
//   -> count_staged
// - repo.signature() is fallible: with no user.name / user.email configured
//   the commit fails with the signature error (the port's rendering of that
//   failure), and a configured signature lets it proceed.
//   -> signature_error
// - the commit's result carries the new commit's oid, the message as given
//   and the staged-entry count. -> make_commit_result

module port::trios::crates::trios_git::src::commit;

pub struct CommitResult {
    oid: str,
    message: str,
    files_committed: usize,
}

// The decision inside the original's `match repo.head()`: a resolved HEAD
// contributes exactly one parent commit; an unborn branch (the initial
// commit) contributes none.
fn parent_count(head_resolves: bool) -> usize {
    if (head_resolves) {
        return 1;
    }
    return 0;
}

// The decision inside the original's `index.iter().count()`: the commit's
// file count is taken from the staged entries before the tree is written.
// On the fixed slice the port counts with, that count is the length.
fn count_staged(staged: []str) -> usize {
    return staged.len;
}

// The decision inside the original's `repo.signature().context(...)`: a
// commit needs a git signature. With user.name / user.email configured there
// is no error; without them the commit fails with the signature error.
fn signature_error(configured: bool) -> ?str {
    if (configured) {
        return null;
    }
    return "no git signature configured";
}

// The original's `Ok(CommitResult { oid, message, files_committed })`: the
// commit reports the new oid, the message as given and the staged count.
fn make_commit_result(oid: str, message: str, files_committed: usize) -> CommitResult {
    return CommitResult { oid: oid, message: message, files_committed: files_committed };
}

// ---- git2 plumbing, kept as named stubs ----
//
// Each stub below is one call in the original create_commit. The repo,
// index, tree and commit handles are strings standing in for the git2
// handles, and the ?str results stand in for the original's Results: null
// is the failure branch. The generated code keeps only these shapes; no
// test calls them and create_commit's body stays `undefined;` because its
// real body is the composition of these calls with the decisions above,
// which .t27 cannot execute.

// Repository::open(repo_path) -> Result<Repository>
pub fn repository_open(repo_path: str) -> ?str { undefined; }

// repo.index() -> Result<Index>
pub fn index_of(repo: str) -> ?str { undefined; }

// index.write_tree() -> Result<Oid>
pub fn write_tree(index: str) -> ?str { undefined; }

// repo.find_tree(tree_oid) -> Result<Tree>
pub fn find_tree(repo: str, tree_oid: str) -> ?str { undefined; }

// repo.signature() -> Result<Signature> (user.name / user.email)
pub fn signature_of(repo: str) -> ?str { undefined; }

// repo.head() -> Result<Reference>
pub fn head_of(repo: str) -> ?str { undefined; }

// head.peel_to_commit() -> Result<Commit> (the parent commit)
pub fn peel_to_commit(head: str) -> ?str { undefined; }

// repo.commit(Some("HEAD"), &signature, &signature, message, &tree, &parents)
//   -> Result<Oid>
pub fn record_commit(repo: str, message: str, tree: str, parents: []str) -> ?str { undefined; }

// The original create_commit itself: the composition of the plumbing calls
// above with the decisions ported here. .t27 has no effect system to run
// that composition, so the body stays `undefined;` and no test calls it.
// The ?CommitResult return carries the ported Result: null is failure.
pub fn create_commit(repo_path: str, message: str) -> ?CommitResult { undefined; }

test parent_count_matches_the_original_head_match {
    assert(parent_count(true) == 1);
    assert(parent_count(false) == 0);
}

test count_staged_counts_every_index_entry {
    var staged: [3]str = ["lib.rs", "src/main.rs", "docs/notes.md"];
    assert(count_staged(&staged) == 3);
    var none: [0]str = [];
    assert(count_staged(&none) == 0);
}

test signature_error_passes_a_configured_signature {
    const ok = signature_error(true);
    assert(ok == null);
    const missing = signature_error(false);
    assert(missing != null);
}

test commit_result_carries_oid_message_and_staged_count {
    var staged: [3]str = ["lib.rs", "src/main.rs", "docs/notes.md"];
    const n = count_staged(&staged);
    const r = make_commit_result("9e8b22e9489ee", "feat: initial commit", n);
    assert(r.oid != "");
    assert(r.oid == "9e8b22e9489ee");
    assert(r.message == "feat: initial commit");
    assert_eq(r.files_committed, 3);
}
