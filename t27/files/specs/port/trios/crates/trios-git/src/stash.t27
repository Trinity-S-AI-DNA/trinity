module port::trios::git::stash;

// Plumbing functions - touch the world, so undefined
pub fn has_staged_changes(repo_path: []const u8) -> bool {
    undefined;
}

pub fn has_unstaged_changes(repo_path: []const u8) -> bool {
    undefined;
}

// Decision helper: pure function that I can test
pub fn should_stash(staged_changes: bool, unstaged_changes: bool) -> bool {
    return staged_changes or unstaged_changes;
}

// Main function - keeps original signature but delegates to helpers
pub fn stash_changes(repo_path: []const u8) -> i32 {
    const ERROR_NOTHING_TO_STASH = -1;
    const SUCCESS = 0;
    
    let staged = has_staged_changes(repo_path);
    let unstaged = has_unstaged_changes(repo_path);
    
    if (!should_stash(staged, unstaged)) {
        return ERROR_NOTHING_TO_STASH;
    }
    
    // In reality, we'd do the stashing here, but that's plumbing
    // For the purpose of this port, we just need to make the decision
    // The actual stashing would be additional plumbing that doesn't affect the decision
    return SUCCESS;
}

// Tests for the pure decision helper
test should_stash_both_false {
    assert(!should_stash(false, false));
}

test should_stash_staged_true {
    assert(should_stash(true, false));
}

test should_stash_unstaged_true {
    assert(should_stash(false, true));
}

test should_stash_both_true {
    assert(should_stash(true, true));
}