// t27/specs/port/trios/crates/trios-git/src/status.t27

module port::trios::crates::trios_git::src::status;

// Port of gHashTag/trios crates/trios-git/src/status.rs (85 lines, at
// 8b229e9489ee). The original opens a libgit2 repository, walks its statuses
// and folds every entry into a FileChange. The plumbing - Repository::open,
// the StatusOptions, repo.statuses, the entry iterator - is the world, which
// no .t27 construct reaches; the decision inside the loop is ported below as
// pure functions over the libgit2 status bitmask and tested against the
// original's behaviour.

// git2::Status flag bits (libgit2 git_status_t), the bits the original reads.
const INDEX_NEW: u32 = 1;
const INDEX_MODIFIED: u32 = 2;
const INDEX_DELETED: u32 = 4;
const INDEX_RENAMED: u32 = 8;
const WT_NEW: u32 = 128;
const WT_MODIFIED: u32 = 256;
const WT_DELETED: u32 = 512;
const WT_RENAMED: u32 = 1024;
const WT_TYPECHANGE: u32 = 2048;
const IGNORED: u32 = 16384;
const CONFLICTED: u32 = 32768;

// FileStatus from trios_core::types, the classification the original emits.
pub enum FileStatus { Added, Deleted, Renamed, Modified, Untracked, Conflicted, }

// The original's FileChange, the record one status entry becomes.
pub struct FileChange { path: []const u8, status: FileStatus, staged: bool, }

// The original's `staged`: s.intersects(INDEX_NEW | INDEX_MODIFIED |
// INDEX_DELETED | INDEX_RENAMED) - true exactly when an index flag is set,
// false for worktree-only and current entries.
pub fn is_staged(s: u32) -> bool {
    if ((s & INDEX_NEW) != 0) {
        return true;
    }
    if ((s & INDEX_MODIFIED) != 0) {
        return true;
    }
    if ((s & INDEX_DELETED) != 0) {
        return true;
    }
    if ((s & INDEX_RENAMED) != 0) {
        return true;
    }
    return false;
}

// The original's file_status precedence chain, in order: conflicted first,
// then added, deleted, renamed, modified. Every other flag combination -
// typechange and ignored among them - falls through to untracked.
pub fn classify_status(s: u32) -> FileStatus {
    if ((s & CONFLICTED) != 0) {
        return FileStatus.Conflicted;
    }
    if ((s & WT_NEW) != 0 or (s & INDEX_NEW) != 0) {
        return FileStatus.Added;
    }
    if ((s & WT_DELETED) != 0 or (s & INDEX_DELETED) != 0) {
        return FileStatus.Deleted;
    }
    if ((s & WT_RENAMED) != 0 or (s & INDEX_RENAMED) != 0) {
        return FileStatus.Renamed;
    }
    if ((s & INDEX_MODIFIED) != 0 or (s & WT_MODIFIED) != 0) {
        return FileStatus.Modified;
    }
    return FileStatus.Untracked;
}

// The original skips an entry whose path is None:
// match entry.path() { Some(p) => PathBuf::from(p), None => continue }.
pub fn entry_has_path(p: ?[]const u8) -> bool {
    if (p == null) {
        return false;
    }
    return true;
}

// The original's FileChange construction for one entry:
// changes.push(FileChange { path, status: file_status, staged }).
pub fn make_change(path: []const u8, s: u32) -> FileChange {
    return FileChange { path: path, status: classify_status(s), staged: is_staged(s) };
}

// Plumbing, not decision: Repository::open, the StatusOptions
// (include_untracked(true), recurse_untracked_dirs(true), include_ignored(false)),
// repo.statuses and the entry walk are libgit2 calls this language cannot
// express; the decision they feed is ported above. The stub keeps the
// original's name and the original's Result shape as `?[]FileChange`, with
// null standing in for the error arm. Its body is `return null;`, not a bare
// `undefined;` statement: a sweep of the generated tree force-analyzes every
// pub fn, and Zig rejects a bare `undefined;` in statement position - "value
// of type '@TypeOf(undefined)' ignored", reproduced here with `_ =
// &get_status` in a comptime block. A return statement survives that analysis
// without implementing the plumbing. No test calls it; the caller in
// crates/trios-git/src/status.rs keeps the real body until the ring is wired.
pub fn get_status(repo_path: []const u8) -> ?[]FileChange {
    return null;
}

test is_staged_flags {
    assert(is_staged(INDEX_NEW));
    assert(is_staged(INDEX_MODIFIED));
    assert(is_staged(INDEX_DELETED));
    assert(is_staged(INDEX_RENAMED));
    // The flag bits are disjoint, so + combines like |.
    assert(is_staged(INDEX_NEW + WT_MODIFIED));
    assert(!is_staged(WT_NEW));
    assert(!is_staged(WT_MODIFIED));
    assert(!is_staged(0));
}

test classify_conflicted_wins {
    assert(classify_status(CONFLICTED) == FileStatus.Conflicted);
    assert(classify_status(CONFLICTED + WT_NEW) == FileStatus.Conflicted);
    assert(classify_status(CONFLICTED + WT_MODIFIED) == FileStatus.Conflicted);
}

test classify_added_deleted {
    assert(classify_status(WT_NEW) == FileStatus.Added);
    assert(classify_status(INDEX_NEW) == FileStatus.Added);
    assert(classify_status(WT_DELETED) == FileStatus.Deleted);
    assert(classify_status(INDEX_DELETED) == FileStatus.Deleted);
    // Added is tested before deleted in the chain.
    assert(classify_status(INDEX_NEW + WT_DELETED) == FileStatus.Added);
}

test classify_renamed_modified {
    assert(classify_status(WT_RENAMED) == FileStatus.Renamed);
    assert(classify_status(INDEX_RENAMED) == FileStatus.Renamed);
    assert(classify_status(INDEX_MODIFIED) == FileStatus.Modified);
    assert(classify_status(WT_MODIFIED) == FileStatus.Modified);
    assert(classify_status(INDEX_MODIFIED + WT_MODIFIED) == FileStatus.Modified);
}

test classify_fallback_untracked {
    assert(classify_status(0) == FileStatus.Untracked);
    // Flags the chain never reads fall through to untracked.
    assert(classify_status(WT_TYPECHANGE) == FileStatus.Untracked);
    assert(classify_status(IGNORED) == FileStatus.Untracked);
}

test make_change_wraps_entry {
    const c = make_change("hello.rs", WT_NEW);
    assert(c.path == "hello.rs");
    assert(c.status == FileStatus.Added);
    assert(!c.staged);

    const m = make_change("src/main.rs", INDEX_MODIFIED);
    assert(m.staged);
    assert(m.status == FileStatus.Modified);
}

test entry_without_path_is_skipped {
    assert(!entry_has_path(null));
    assert(entry_has_path("hello.rs"));
}
