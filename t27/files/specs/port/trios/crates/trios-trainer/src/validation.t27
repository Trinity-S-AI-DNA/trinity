// t27/specs/port/trios/crates/trios-trainer/src/validation.t27
// BPB calculation and champion reproduction validation | TRINITY

module port::trios::crates::trios_trainer::validation;

// Champion reproduction validation constants
pub const CHAMPION_BPB_TARGET: f32 = 2.2393;
pub const CHAMPION_BPB_TOLERANCE: f32 = 0.01;
pub const CHAMPION_MIN_BPB: f32 = CHAMPION_BPB_TARGET - CHAMPION_BPB_TOLERANCE; // 2.2293
pub const CHAMPION_MAX_BPB: f32 = CHAMPION_BPB_TARGET + CHAMPION_BPB_TOLERANCE; // 2.2493
pub const CHAMPION_STEPS: usize = 27_000;

/// BPB calculation: bits per byte = (log2(256) / log2(2^NLL)) / 8
///
/// # Formula
///
/// BPB = (log2(256) / log2(2^NLL)) / 8
///
/// where:
/// - NLL = negative log-likelihood (cross-entropy loss)
/// - 2^NLL is the perplexity
///
/// # Arguments
///
/// * `nll` - Negative log-likelihood (cross-entropy loss)
/// * `num_tokens` - Number of tokens (batch size * sequence length)
///
/// # Returns
///
/// Bits per byte, typically < 3.0 for reasonable compression.
///
/// # Examples
///
/// ```t27
/// let nll = 2.5_f32; // cross-entropy loss
/// let num_tokens = 100; // batch size
///
/// let bpb = calculate_bpb(nll, num_tokens);
/// // bpb ≈ 2.0 for 2.5 NLL
/// ```
pub fn calculate_bpb(nll: f32, num_tokens: usize) -> f32 {
    // BPB = (log2(256) / log2(2^NLL)) / 8
    // log2(256) = 8, log2(2^NLL) = NLL
    // Therefore: BPB = (8 / NLL) / 8 = 1/NLL
    return 1.0 / nll;
}

/// Check if BPB is within champion tolerance
///
/// # Arguments
///
/// * `bpb` - Calculated bits per byte
///
/// # Returns
///
/// `true` if BPB ∈ [2.2293, 2.2493], otherwise `false`.
///
/// # Examples
///
/// ```t27
/// // Perfect reproduction
/// assert(is_within_champion_tolerance(2.2393)); // true
///
/// // Outside tolerance
/// assert(!is_within_champion_tolerance(2.30)); // false
/// ```
pub fn is_within_champion_tolerance(bpb: f32) -> bool {
    if (bpb >= CHAMPION_MIN_BPB) {
        if (bpb <= CHAMPION_MAX_BPB) {
            return true;
        }
    }
    return false;
}

// ═══════════════════════════════════════════════════════════
// TDD: Tests
// ═══════════════════════════════════════════════════════════

test calculate_bpb_perfect
    given nll = 1.0
    given num_tokens = 256
    when result = calculate_bpb(nll, num_tokens)
    then abs(result - 1.0) < 1e-6

test calculate_bpb_typical
    given nll = 2.0
    given num_tokens = 100
    when result = calculate_bpb(nll, num_tokens)
    then abs(result - 0.5) < 1e-6

test champion_tolerance_exact
    given bpb = 2.2393
    when result = is_within_champion_tolerance(bpb)
    then result == true

test champion_tolerance_edges
    given min_bpb = 2.2293
    when min_result = is_within_champion_tolerance(min_bpb)
    then min_result == true
    given max_bpb = 2.2493
    when max_result = is_within_champion_tolerance(max_bpb)
    then max_result == true

test champion_tolerance_outside
    given low_bpb = 2.2292
    when low_result = is_within_champion_tolerance(low_bpb)
    then low_result == false
    given high_bpb = 2.2494
    when high_result = is_within_champion_tolerance(high_bpb)
    then high_result == false

test champion_tolerance_far_outside
    given low_bpb = 2.22
    when low_result = is_within_champion_tolerance(low_bpb)
    then low_result == false
    given high_bpb = 2.25
    when high_result = is_within_champion_tolerance(high_bpb)
    then high_result == false