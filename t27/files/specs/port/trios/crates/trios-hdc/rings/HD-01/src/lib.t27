//! HD-01 — HDC operations (bind, bundle, similarity)

// Hypervector type definition using fixed-size arrays
struct Hypervector4 {
    data: [4]i8,
}

struct Hypervector3 {
    data: [3]i8,
}

pub fn bind(a: Hypervector4, b: Hypervector4) -> Hypervector4 {
    // Assert dimensions match (port the decision, not the plumbing)
    // Both are size 4, so they match
    
    var result: Hypervector4 = undefined;
    
    for (i in 0..4) {
        result.data[i] = a.data[i] * b.data[i];
    }
    
    return result;
}

pub fn bundle(a: Hypervector3, b: Hypervector3) -> Hypervector3 {
    // Assert dimensions match (port the decision, not the plumbing)
    // Both are size 3, so they match
    
    var result: Hypervector3 = undefined;
    
    // Handle each element separately to avoid redeclaration
    const sum0: i32 = a.data[0] as i32 + b.data[0] as i32;
    if (sum0 > 0) {
        result.data[0] = 1;
    } else if (sum0 < 0) {
        result.data[0] = -1;
    } else {
        result.data[0] = 0;
    }
    
    const sum1: i32 = a.data[1] as i32 + b.data[1] as i32;
    if (sum1 > 0) {
        result.data[1] = 1;
    } else if (sum1 < 0) {
        result.data[1] = -1;
    } else {
        result.data[1] = 0;
    }
    
    const sum2: i32 = a.data[2] as i32 + b.data[2] as i32;
    if (sum2 > 0) {
        result.data[2] = 1;
    } else if (sum2 < 0) {
        result.data[2] = -1;
    } else {
        result.data[2] = 0;
    }
    
    return result;
}

pub fn similarity(a: Hypervector4, b: Hypervector4) -> f64 {
    // Assert dimensions match (port the decision, not the plumbing)
    // Both are size 4, so they match
    
    var dot: i64 = 0;
    
    for (i in 0..4) {
        dot += a.data[i] as i64 * b.data[i] as i64;
    }
    
    return dot as f64 / 4 as f64;
}

test bind_self_is_ones {
    const a = Hypervector4 { data: [1, -1, 1, -1] };
    const r = bind(a, a);
    
    const expected = Hypervector4 { data: [1, 1, 1, 1] };
    
    assert(r.data[0] == expected.data[0]);
    assert(r.data[1] == expected.data[1]);
    assert(r.data[2] == expected.data[2]);
    assert(r.data[3] == expected.data[3]);
}

test similarity_self_is_one {
    const a = Hypervector4 { data: [1, -1, 1, -1] };
    const result = similarity(a, a);
    assert(result == 1.0);
}

test bundle_works {
    const a = Hypervector3 { data: [1, 1, -1] };
    const b = Hypervector3 { data: [1, -1, -1] };
    const result = bundle(a, b);
    
    const expected = Hypervector3 { data: [1, 0, -1] };
    
    assert(result.data[0] == expected.data[0]);
    assert(result.data[1] == expected.data[1]);
    assert(result.data[2] == expected.data[2]);
}