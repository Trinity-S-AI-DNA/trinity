module port::trios::crates::trios_physics::rings::PH_01::src::lib;

// Physics constants from PH-00
const C: f64 = 299792458.0; // Speed of light in m/s
const H: f64 = 6.62607015e-34; // Planck constant in J⋅s

/// E = m c^2.
pub fn rest_energy(mass_kg: f64) -> f64 {
    return mass_kg * C * C;
}

/// de Broglie wavelength: lambda = h / p.
pub fn de_broglie_wavelength(momentum: f64) -> f64 {
    return H / momentum;
}

test rest_energy_one_kg {
    const e = rest_energy(1.0);
    // E = 1 * c^2 = c^2
    assert_eq(e, C * C);
}

test de_broglie_unit_momentum {
    const lambda = de_broglie_wavelength(1.0);
    // lambda = h / 1 = h
    assert_eq(lambda, H);
}

test rest_energy_zero_mass {
    const e = rest_energy(0.0);
    assert_eq(e, 0.0);
}

test de_broglie_large_momentum {
    const momentum = 1e20;
    const lambda = de_broglie_wavelength(momentum);
    // lambda = h / momentum (should be very small)
    assert(lambda > 0.0);
    assert(lambda < 1e-14); // Should be around 6.6e-54
}