module port::epoch_rollover_wraparound_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/
// epoch_rollover_wraparound_guard.rs @ 8b229e9489ee (161 lines: 1 function,
// 3 constants, 1 error enum, 10 tests EPRW-01..10).
//
// CR-CHAT-02 — Epoch rollover wraparound guard (Wave-73 Lane A).
//
// RATCHET — epoch counter near u64::MAX forces rotation, R-CHAT-2. The epoch
// counter in the double ratchet is a u64; near u64::MAX, wrapping would break
// monotonicity: silent wraparound (epoch falls from u64::MAX to 0), fork after
// wrap (a post-wrap epoch 0 is indistinguishable from the original epoch 0),
// and key reuse (post-wrap keys collide with the first epoch's keys when the
// KDF input is only the epoch number).
//
// The original's #![forbid(unsafe_code)] needs no port. Its I/O (error
// Display/Debug formatting) is plumbing and is not ported; the validation
// itself is pure and is ported in full below.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * EPOCH-ROLLOVER

// u64::MAX, spelled out: .t27 has no u64::MAX literal.
const EPRW_U64_MAX: u64 = 18446744073709551615;

// Rotation threshold — must rotate before this. Original: u64::MAX - 1000.
const EPRW_ROTATION_THRESHOLD: u64 = EPRW_U64_MAX - 1000;

// Danger zone — warn at this point. Original: u64::MAX - 100.
const EPRW_DANGER_ZONE: u64 = EPRW_U64_MAX - 100;

// Maximum rotations per session.
const EPRW_MAX_ROTATIONS: usize = 8;

// All ways epoch rollover validation can fail. The Rust original returns
// Result<(), EpochRolloverError>; .t27 has no Result, so the verdict is this
// one enum: .Ok stands for Ok(()) and the other five variants carry
// EpochRolloverError's variants under their original names.
pub enum EpochRolloverError {
    Ok,
    AtMax,
    DangerZone,
    PastThreshold,
    ConsecutiveRotations,
    TooManyRotations,
}

// [VERIFIED] Validate epoch counter for rollover safety. Returns .Ok when the
// epoch is safe to keep using; the matching error variant otherwise, checked
// in the original's order: TooManyRotations, AtMax, DangerZone or
// ConsecutiveRotations (inside the danger zone, depending on
// last_was_rotation), PastThreshold.
pub fn validate_epoch_rollover(current_epoch: u64, rotation_count: usize, last_was_rotation: bool) -> EpochRolloverError {
    if (rotation_count > EPRW_MAX_ROTATIONS) {
        return .TooManyRotations;
    }
    if (current_epoch == EPRW_U64_MAX) {
        return .AtMax;
    }
    if (current_epoch >= EPRW_DANGER_ZONE) {
        if (last_was_rotation) {
            return .ConsecutiveRotations;
        }
        return .DangerZone;
    }
    if (current_epoch >= EPRW_ROTATION_THRESHOLD) {
        return .PastThreshold;
    }
    return .Ok;
}

// **EPRW-01** — epoch at u64::MAX rejected.
test eprw_01_at_max_rejected {
    assert(validate_epoch_rollover(EPRW_U64_MAX, 0, false) == .AtMax);
}

// **EPRW-02** — danger zone rejected (u64::MAX - 50 is inside it).
test eprw_02_danger_zone_rejected {
    assert(validate_epoch_rollover(EPRW_U64_MAX - 50, 0, false) == .DangerZone);
}

// **EPRW-03** — past threshold rejected (the threshold itself counts as past).
test eprw_03_past_threshold_rejected {
    assert(validate_epoch_rollover(EPRW_ROTATION_THRESHOLD, 0, false) == .PastThreshold);
}

// **EPRW-04** — consecutive rotations rejected (rotating again with no gap).
test eprw_04_consecutive_rejected {
    assert(validate_epoch_rollover(EPRW_U64_MAX - 50, 1, true) == .ConsecutiveRotations);
}

// **EPRW-05** — too many rotations rejected (EPRW_MAX_ROTATIONS + 1).
test eprw_05_too_many_rejected {
    assert(validate_epoch_rollover(100, EPRW_MAX_ROTATIONS + 1, false) == .TooManyRotations);
}

// **EPRW-06** — safe epoch accepted.
test eprw_06_safe_accepted {
    assert(validate_epoch_rollover(1000, 0, false) == .Ok);
}

// **EPRW-07** — just below threshold accepted.
test eprw_07_below_threshold_accepted {
    assert(validate_epoch_rollover(EPRW_ROTATION_THRESHOLD - 1, 0, false) == .Ok);
}

// **EPRW-08** — epoch 0 accepted.
test eprw_08_zero_accepted {
    assert(validate_epoch_rollover(0, 0, false) == .Ok);
}

// **EPRW-09** — exactly EPRW_MAX_ROTATIONS at a safe epoch accepted (> not >=).
test eprw_09_max_rotations_accepted {
    assert(validate_epoch_rollover(100, EPRW_MAX_ROTATIONS, false) == .Ok);
}

// **EPRW-10** — mid-range epoch accepted (u64::MAX / 2).
test eprw_10_mid_range_accepted {
    assert(validate_epoch_rollover(EPRW_U64_MAX / 2, 0, false) == .Ok);
}
