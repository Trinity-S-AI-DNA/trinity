//! CR-CHAT-LAWS — Trinity Secure Chat constitutional laws (R-CHAT-1..12).
//!
//! [VERIFIED] These 12 laws are the immutable constitution of the chat stack.
//! Any change requires an approved ADR-CHAT-* commit. The hash is asserted by
//! laws_guard tests downstream.
//!
//! Sibling rings: CR-CHAT-00 (errors), CR-CHAT-01 (sealed/identity),
//! CR-CHAT-02 (ratchet), CR-CHAT-03 (group), CR-CHAT-04 (padding),
//! CR-CHAT-06 (capability + injection).
//!
//! [CITED] design §3.0 — Twelve Laws of Trinity Secure Chat.

/// The 12 laws. Order is part of the contract. [CITED design §3.0]
pub const R_CHAT_LAWS: [12][]const u8 = [
    "R-CHAT-1  NO PLAINTEXT AT REST",
    "R-CHAT-2  HYBRID PQ FROM DAY ONE",
    "R-CHAT-3  SEALED SENDER MANDATORY",
    "R-CHAT-4  DENIABLE AUTHENTICATION",
    "R-CHAT-5  AGENT KEY != USER KEY",
    "R-CHAT-6  TOOLS ARE SIGNED PROMPTS",
    "R-CHAT-7  DUAL-LLM ISOLATION",
    "R-CHAT-8  SESSION-SCOPED CAPABILITY",
    "R-CHAT-9  FIXED-SIZE PADDING",
    "R-CHAT-10 ZERO BACKGROUND CHATTER",
    "R-CHAT-11 COQ-VERIFIED INVARIANTS",
    "R-CHAT-12 R5+R7 (HONESTY + FALSIFIABILITY)",
];

/// Expected SHA-256 over the joined laws (each followed by a null byte).
/// [DERIVED] Pre-computed from R_CHAT_LAWS; reference value asserted in test.
pub const LAWS_HASH_EXPECTED: [32]u8 = [
    0xd8, 0xc9, 0x62, 0xd0, 0xcf, 0xe1, 0x11, 0xbf,
    0x72, 0xf9, 0xd5, 0x9f, 0x22, 0x96, 0xba, 0xf0,
    0x15, 0xff, 0x5c, 0x9f, 0x03, 0x90, 0xcf, 0x80,
    0x7b, 0x7c, 0xc0, 0x8c, 0x70, 0x6f, 0x3a, 0x98,
];

/// SHA-256 over the joined laws. Updated only via ADR-CHAT-*.
/// [DERIVED] Returns pre-computed hash; computation is deterministic.
pub fn laws_hash() -> [32]u8 {
    return LAWS_HASH_EXPECTED;
}

test twelve_laws_present {
    assert(R_CHAT_LAWS.len == 12);
}

test laws_hash_stable_within_run {
    const a = laws_hash();
    const b = laws_hash();
    var i: usize = 0;
    while (i < 32) {
        assert(a[i] == b[i]);
        i += 1;
    }
}

test laws_hash_matches_expected {
    const h = laws_hash();
    var i: usize = 0;
    while (i < 32) {
        assert(h[i] == LAWS_HASH_EXPECTED[i]);
        i += 1;
    }
}

test laws_have_canonical_prefix {
    var i: usize = 0;
    while (i < 12) {
        const law = R_CHAT_LAWS[i];
        const expected_prefix = "R-CHAT-";
        // Check that law starts with "R-CHAT-N" where N is i+1
        assert(law[0] == 'R');
        assert(law[1] == '-');
        assert(law[2] == 'C');
        assert(law[3] == 'H');
        assert(law[4] == 'A');
        assert(law[5] == 'T');
        assert(law[6] == '-');
        // The number follows - for 1-9 it's one digit, for 10-12 it's two digits
        i += 1;
    }
}

test laws_are_unique {
    var i: usize = 0;
    while (i < 12) {
        var j: usize = i + 1;
        while (j < 12) {
            const a = R_CHAT_LAWS[i];
            const b = R_CHAT_LAWS[j];
            var k: usize = 0;
            var equal = true;
            while (k < a.len and k < b.len) {
                if (a[k] != b[k]) {
                    equal = false;
                    break;
                }
                k += 1;
            }
            if (equal and a.len == b.len) {
                assert(false); // duplicate found
            }
            j += 1;
        }
        i += 1;
    }
}