module port::trios::crates::trios_vsa::rings::VS_01;

pub fn bind(a: i32, b: i32) -> i32 {
    return a * b;
}

pub fn unbind(bound: i32, key: i32) -> i32 {
    return bound * key;
}

pub fn superpose(a: i32, b: i32) -> i32 {
    const sum = a + b;
    if (sum > 0) {
        return 1;
    } else if (sum < 0) {
        return -1;
    } else {
        return 0;
    }
}

test bind_basic {
    const result = bind(1, -1);
    assert(result == -1);
}

test unbind_recover {
    const key = 1;
    const val = -1;
    const bound = bind(key, val);
    const recovered = unbind(bound, key);
    assert(recovered == val);
}

test superpose_cases {
    const result = superpose(1, -1);
    assert(result == 0);
}

test superpose_edge_cases {
    const result = superpose(2, -2);
    assert(result == 0);
}