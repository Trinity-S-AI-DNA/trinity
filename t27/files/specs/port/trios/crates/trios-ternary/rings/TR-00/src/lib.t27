module port::trios::crates::trios-ternary::rings::TR_00::src;

enum Trit {
    Neg,
    Zero,
    Pos
}

struct Tryte {
    trit0: Trit,
    trit1: Trit,
    trit2: Trit
}

fn Trit_to_i8(self: Trit) -> i8 {
    return switch (self) {
        .Neg => -1,
        .Zero => 0,
        .Pos => 1,
    };
}

fn Trit_from_i8(v: i8) -> ?Trit {
    return switch (v) {
        -1 => Trit.Neg,
        0 => Trit.Zero,
        1 => Trit.Pos,
        else => null
    };
}

fn Tryte_zero() -> Tryte {
    return Tryte{ .trit0 = Trit.Zero, .trit1 = Trit.Zero, .trit2 = Trit.Zero }
}

test trit_to_i8_neg {
    assert(Trit_to_i8(Trit::Neg) == -1);
}

test trit_to_i8_zero {
    assert(Trit_to_i8(Trit::Zero) == 0);
}

test trit_to_i8_pos {
    assert(Trit_to_i8(Trit::Pos) == 1);
}

test trit_from_i8_neg {
    assert(Trit_from_i8(-1) == Trit::Neg);
}

test trit_from_i8_zero {
    assert(Trit_from_i8(0) == Trit::Zero);
}

test trit_from_i8_pos {
    assert(Trit_from_i8(1) == Trit::Pos);
}

test trit_from_i8_out_of_range {
    assert(Trit_from_i8(2) == -1);
    assert(Trit_from_i8(-2) == -1);
}

test tryte_zero {
    let expected = Tryte{ .trit0 = Trit::Zero, .trit1 = Trit::Zero, .trit2 = Trit::Zero };
    assert(Tryte_zero() == expected);
}

test tryte_field_access {
    let t = Tryte{ .trit0 = Trit::Pos, .trit1 = Trit::Zero, .trit2 = Trit::Neg };
    assert(t.trit0 == Trit::Pos);
    assert(t.trit1 == Trit::Zero);
    assert(t.trit2 == Trit::Neg);
}