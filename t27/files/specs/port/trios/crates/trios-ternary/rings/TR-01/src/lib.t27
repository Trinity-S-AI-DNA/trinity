module port::trios::crates::trios_ternary::rings::TR_01;

/// Trit enum from TR-00
enum Trit {
    Neg,
    Zero,
    Pos,
}

/// Negate a Trit (involution).
pub fn neg(t: Trit) -> Trit {
    if (t == Trit.Neg) {
        return Trit.Pos;
    } else if (t == Trit.Zero) {
        return Trit.Zero;
    } else {
        return Trit.Neg;
    }
}

/// Add two trits as i8, then map back if in range.
pub fn add_saturating(a: Trit, b: Trit) -> i8 {
    // Convert Trit to i8: Neg = -1, Zero = 0, Pos = 1
    const a_i8: i8 = switch (a) {
        .Neg => -1,
        .Zero => 0,
        .Pos => 1,
    };
    const b_i8: i8 = switch (b) {
        .Neg => -1,
        .Zero => 0,
        .Pos => 1,
    };
    return a_i8 + b_i8;
}

test neg_involution {
    // Test that negating twice returns the original trit
    assert(neg(neg(Trit.Neg)) == Trit.Neg);
    assert(neg(neg(Trit.Zero)) == Trit.Zero);
    assert(neg(neg(Trit.Pos)) == Trit.Pos);
}

test add_pos_neg_zero {
    // Test addition results
    assert(add_saturating(Trit.Pos, Trit.Neg) == 0);
    assert(add_saturating(Trit.Pos, Trit.Pos) == 2);
    assert(add_saturating(Trit.Neg, Trit.Neg) == -2);
    assert(add_saturating(Trit.Zero, Trit.Zero) == 0);
    assert(add_saturating(Trit.Pos, Trit.Zero) == 1);
    assert(add_saturating(Trit.Neg, Trit.Zero) == -1);
}