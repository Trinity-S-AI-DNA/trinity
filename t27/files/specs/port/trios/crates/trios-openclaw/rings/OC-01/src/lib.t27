//! OC-01 — Hermes provider mapping.
//!
//! Ported 1:1 from `lib/agents/hermes/hermes-provider-map.ts`. Pure lookup
//! mapping a BrowserOS provider type to the Hermes provider name, its API-key
//! env var, whether a base URL is required, and an optional default base URL.
//! No I/O. Depends on nothing (leaf ring).

/// A Hermes provider mapping (TS `HermesProviderMapping`).
pub struct HermesProviderMapping {
    hermes_provider: str,
    env_var_name: str,
    requires_base_url: bool,
    default_base_url: str,
}



pub fn HermesProviderMapping_new(provider: str, env: str, requires_base_url: bool, default_base_url: str) -> HermesProviderMapping {
    return HermesProviderMapping {
        hermes_provider: provider,
        env_var_name: env,
        requires_base_url: requires_base_url,
        default_base_url: default_base_url,
    };
}

pub fn is_supported(provider_type: str) -> bool {
    if (provider_type == "anthropic") {
        return true;
    } else if (provider_type == "openai") {
        return true;
    } else if (provider_type == "openrouter") {
        return true;
    } else if (provider_type == "openai-compatible") {
        return true;
    } else {
        return false;
    }
}

pub fn get_mapping(provider_type: str) -> ?HermesProviderMapping {
    if (provider_type == "anthropic") {
        return HermesProviderMapping_new("anthropic", "ANTHROPIC_API_KEY", false, "");
    } else if (provider_type == "openai") {
        return HermesProviderMapping_new("custom", "OPENAI_API_KEY", false, "https://api.openai.com/v1");
    } else if (provider_type == "openrouter") {
        return HermesProviderMapping_new("openrouter", "OPENROUTER_API_KEY", false, "");
    } else if (provider_type == "openai-compatible") {
        return HermesProviderMapping_new("custom", "OPENAI_API_KEY", true, "");
    } else {
        return null;
    }
}

test supported_set {
    assert(is_supported("anthropic") == true);
    assert(is_supported("openai-compatible") == true);
    assert(is_supported("cohere") == false);
}

test anthropic_mapping {
    const m = get_mapping("anthropic");
    assert(m != null);
    const mapping = m.?;
    assert(mapping.hermes_provider == "anthropic");
    assert(mapping.env_var_name == "ANTHROPIC_API_KEY");
    assert(mapping.requires_base_url == false);
    assert(mapping.default_base_url == "");
}

test openai_maps_to_custom_with_default_url {
    const m = get_mapping("openai");
    assert(m != null);
    const mapping = m.?;
    assert(mapping.hermes_provider == "custom");
    assert(mapping.default_base_url == "https://api.openai.com/v1");
}

test openai_compatible_requires_base_url {
    const m = get_mapping("openai-compatible");
    assert(m != null);
    const mapping = m.?;
    assert(mapping.hermes_provider == "custom");
    assert(mapping.requires_base_url == true);
    assert(mapping.default_base_url == "");
}

test unknown_returns_none {
    const m = get_mapping("cohere");
    assert(m == null);
}