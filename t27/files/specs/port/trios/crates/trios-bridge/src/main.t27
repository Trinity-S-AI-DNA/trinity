struct Config {
    port: u16,
    relay_port: u16,
    repo: []const u8,
    token: ?[]const u8,
}

fn compute_config(port: u16, repo: []const u8, token: ?[]const u8) -> Config {
    return Config { .port = port, .relay_port = port + 1, .repo = repo, .token = token };
}

pub fn main() -> undefined {
    undefined;
}

test compute_config_ports {
    var repo: []const u8 = "gHashTag/trios";
    var token: ?[]const u8 = null;
    var config = compute_config(7474, repo, token);
    assert(config.relay_port == 7475);
    assert(config.port == 7474);
}