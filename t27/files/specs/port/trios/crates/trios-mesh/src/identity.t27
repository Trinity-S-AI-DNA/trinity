// Port of gHashTag/trios crates/trios-mesh/src/identity.rs (8b229e9489ee):
// phi^2 + 1/phi^2 = 3 | TRINITY
//
// φ-Node Identity — an Ed25519 keypair distilled to a 128-bit destination
// hash, the mru_forward self_addr of the mesh.
//
// crate::DestHash is a 16-byte newtype in the original; the port carries it
// as its payload array [16]u8, the only part the ported logic reads.
// SHA-256 (FIPS 180-4) is inlined as pure helpers because use a::b; does not
// resolve across modules yet (#4298) and the upstream specs/tri/crypto/
// sha256.t27 is blocked on a pointer-type defect (update(&sha, ...)).
// All digest arithmetic runs in u64 masked to 32 bits: plain u32 + panics on
// overflow in the generated Zig, so wrapping is done by hand.
// The helpers hash exactly one 32-byte message (the Ed25519 pubkey), which
// pads to a single 64-byte block.

module port::trios::mesh::src::identity;

struct NodeIdentity {
    pubkey: [32]u8,
    dest_hash: [16]u8,
}

// SHA-256 initial hash value, H[0..8] (first 32 bits of the square roots of
// the first 8 primes).
const H0: [8]u64 = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
    0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
];

// SHA-256 round constants, K[0..64] (first 32 bits of the cube roots of the
// first 64 primes).
const K: [64]u64 = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

// Rotate right within 32 bits. Runs in u64 and masks: the generated Zig
// shift is safe on u64, while u32 + would panic on overflow.
fn rotr32(x: u64, n: u32) -> u64 {
    return ((x >> n) | (x << (32 - n))) & 0xFFFFFFFF;
}

// Wrapping 32-bit add: u64 arithmetic masked down to 32 bits.
fn add32(a: u64, b: u64) -> u64 {
    return (a + b) & 0xFFFFFFFF;
}

// SHA-256 over exactly one 32-byte message (the Ed25519 pubkey): pad with
// 0x80, zeros and a 256-bit big-endian length field into one 64-byte block,
// compress, and emit 32 big-endian digest bytes.
pub fn sha256_32(msg: [32]u8) -> [32]u8 {
    var block: [64]u8 = [_]u8{0} ** 64;
    var i: usize = 0;
    while (i < 32) {
        block[i] = msg[i];
        i += 1;
    }
    block[32] = 0x80;
    block[62] = 0x01; // message length: 32 bytes = 0x100 bits, big-endian

    // Message schedule: big-endian words, then the standard expansion.
    var w: [64]u64 = [_]u64{0} ** 64;
    i = 0;
    while (i < 16) {
        w[i] = (block[4 * i] as u64) << 24;
        w[i] = w[i] | ((block[4 * i + 1] as u64) << 16);
        w[i] = w[i] | ((block[4 * i + 2] as u64) << 8);
        w[i] = w[i] | (block[4 * i + 3] as u64);
        i += 1;
    }
    i = 16;
    while (i < 64) {
        const s0 = (rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18)) ^ (w[i - 15] >> 3);
        const s1 = (rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19)) ^ (w[i - 2] >> 10);
        w[i] = add32(add32(add32(w[i - 16], s0), w[i - 7]), s1);
        i += 1;
    }

    // Compression: 64 rounds over the working variables.
    var v: [8]u64 = H0;
    i = 0;
    while (i < 64) {
        const s1 = (rotr32(v[4], 6) ^ rotr32(v[4], 11)) ^ rotr32(v[4], 25);
        const ch = (v[4] & v[5]) ^ ((v[4] ^ 0xFFFFFFFF) & v[6]);
        const t1 = add32(add32(add32(add32(v[7], s1), ch), K[i]), w[i]);
        const s0 = (rotr32(v[0], 2) ^ rotr32(v[0], 13)) ^ rotr32(v[0], 22);
        const maj = ((v[0] & v[1]) ^ (v[0] & v[2])) ^ (v[1] & v[2]);
        const t2 = add32(s0, maj);
        v[7] = v[6];
        v[6] = v[5];
        v[5] = v[4];
        v[4] = add32(v[3], t1);
        v[3] = v[2];
        v[2] = v[1];
        v[1] = v[0];
        v[0] = add32(t1, t2);
        i += 1;
    }

    // Add the working variables back into the initial hash (FIPS 180-4:
    // the message digest is H0 + the eight working variables after the
    // 64 compression rounds).
    v[0] = add32(v[0], H0[0]);
    v[1] = add32(v[1], H0[1]);
    v[2] = add32(v[2], H0[2]);
    v[3] = add32(v[3], H0[3]);
    v[4] = add32(v[4], H0[4]);
    v[5] = add32(v[5], H0[5]);
    v[6] = add32(v[6], H0[6]);
    v[7] = add32(v[7], H0[7]);

    // Digest: the eight working variables, big-endian.
    var out: [32]u8 = [_]u8{0} ** 32;
    var j: usize = 0;
    while (j < 8) {
        out[4 * j] = ((v[j] >> 24) & 0xFF) as u8;
        out[4 * j + 1] = ((v[j] >> 16) & 0xFF) as u8;
        out[4 * j + 2] = ((v[j] >> 8) & 0xFF) as u8;
        out[4 * j + 3] = (v[j] & 0xFF) as u8;
        j += 1;
    }
    return out;
}

// Port of NodeIdentity::from_pubkey(&Keypair): hashes the 32-byte Ed25519
// public key with SHA-256 and keeps hash[..16] as the destination hash. The
// keypair copy in the original is incidental; the port carries the pubkey
// array by value.
pub fn NodeIdentity_from_pubkey(pubkey: [32]u8) -> NodeIdentity {
    const digest = sha256_32(pubkey);
    var dest: [16]u8 = [_]u8{0} ** 16;
    var i: usize = 0;
    while (i < 16) {
        dest[i] = digest[i]; // hash[..16]: first 16 of the 32 digest bytes
        i += 1;
    }
    return NodeIdentity{ .pubkey = pubkey, .dest_hash = dest };
}

// Port of NodeIdentity::gf16_prefix(&self) -> [u8; 8]: the first four bytes
// of the destination hash, split into high/low nibble GF16 elements.
pub fn NodeIdentity_gf16_prefix(self: NodeIdentity) -> [8]u8 {
    var out: [8]u8 = [_]u8{0} ** 8;
    var i: usize = 0;
    while (i < 4) {
        const byte: u8 = self.dest_hash[i];
        out[2 * i] = byte >> 4; // high nibble
        out[2 * i + 1] = byte & 0x0F; // low nibble: GF16 element
        i += 1;
    }
    return out;
}

test from_pubkey_copies_the_pubkey {
    var pk: [32]u8 = [_]u8{0} ** 32;
    var i: usize = 0;
    while (i < 32) {
        pk[i] = i as u8;
        i += 1;
    }
    const id = NodeIdentity_from_pubkey(pk);
    var j: usize = 0;
    while (j < 32) {
        assert(id.pubkey[j] == pk[j]);
        j += 1;
    }
}

test from_pubkey_digests_the_pubkey {
    // SHA-256("0123456789abcdef0123456789abcdef"), first 16 bytes.
    var pk: [32]u8 = [
        0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37,
        0x38, 0x39, 0x61, 0x62, 0x63, 0x64, 0x65, 0x66,
        0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37,
        0x38, 0x39, 0x61, 0x62, 0x63, 0x64, 0x65, 0x66,
    ];
    const id = NodeIdentity_from_pubkey(pk);
    const expect: [16]u8 = [
        0x3e, 0xb1, 0xbd, 0x43, 0x99, 0x47, 0xeb, 0x76,
        0x29, 0x98, 0xe5, 0x66, 0xcc, 0xc2, 0xe0, 0x99,
    ];
    var i: usize = 0;
    while (i < 16) {
        assert(id.dest_hash[i] == expect[i]);
        i += 1;
    }
}

test from_pubkey_digests_a_zero_pubkey {
    // SHA-256 of 32 zero bytes, first 16 bytes.
    var pk: [32]u8 = [_]u8{0} ** 32;
    const id = NodeIdentity_from_pubkey(pk);
    const expect: [16]u8 = [
        0x66, 0x68, 0x7a, 0xad, 0xf8, 0x62, 0xbd, 0x77,
        0x6c, 0x8f, 0xc1, 0x8b, 0x8e, 0x9f, 0x8e, 0x20,
    ];
    var i: usize = 0;
    while (i < 16) {
        assert(id.dest_hash[i] == expect[i]);
        i += 1;
    }
}

test gf16_prefix_splits_high_and_low_nibbles {
    var pk: [32]u8 = [_]u8{0} ** 32;
    var dest: [16]u8 = [_]u8{0} ** 16;
    dest[0] = 0xAB;
    dest[1] = 0x01;
    dest[2] = 0x00;
    dest[3] = 0xFF;
    const id = NodeIdentity{ .pubkey = pk, .dest_hash = dest };
    const g = NodeIdentity_gf16_prefix(id);
    assert((g[0] == 0x0A) and (g[1] == 0x0B));
    assert((g[2] == 0x00) and (g[3] == 0x01));
    assert((g[4] == 0x00) and (g[5] == 0x00));
    assert((g[6] == 0x0F) and (g[7] == 0x0F));
}

test gf16_prefix_reads_only_the_first_four_bytes {
    var pk: [32]u8 = [_]u8{0} ** 32;
    var dest: [16]u8 = [_]u8{0} ** 16;
    dest[0] = 0x12;
    dest[1] = 0x34;
    dest[2] = 0x56;
    dest[3] = 0x78;
    dest[4] = 0xEE; // past the GF16 window
    const id = NodeIdentity{ .pubkey = pk, .dest_hash = dest };
    const g = NodeIdentity_gf16_prefix(id);
    assert((g[0] == 0x01) and (g[1] == 0x02));
    assert((g[2] == 0x03) and (g[3] == 0x04));
    assert((g[4] == 0x05) and (g[5] == 0x06));
    assert((g[6] == 0x07) and (g[7] == 0x08));
}

test rotr32_rotates_within_32_bits {
    assert(rotr32(0x00000001, 1) == 0x80000000);
    assert(rotr32(0x80000000, 31) == 0x00000001);
    assert(rotr32(0xf0f0f0f0, 4) == 0x0f0f0f0f);
}

test add32_wraps_without_panicking {
    assert(add32(0xffffffff, 1) == 0);
    assert(add32(0x7fffffff, 1) == 0x80000000);
    assert(add32(0x12345678, 0) == 0x12345678);
}

test sha256_32_digests_the_zero_pubkey_fully {
    // python3 -c "import hashlib; print(hashlib.sha256(bytes(32)).hexdigest())"
    // -> 66687aadf862bd776c8fc18b8e9f8e20089714856ee233b3902a591d0d5f2925
    var pk: [32]u8 = [_]u8{0} ** 32;
    const d = sha256_32(pk);
    const expect: [32]u8 = [
        0x66, 0x68, 0x7a, 0xad, 0xf8, 0x62, 0xbd, 0x77,
        0x6c, 0x8f, 0xc1, 0x8b, 0x8e, 0x9f, 0x8e, 0x20,
        0x08, 0x97, 0x14, 0x85, 0x6e, 0xe2, 0x33, 0xb3,
        0x90, 0x2a, 0x59, 0x1d, 0x0d, 0x5f, 0x29, 0x25,
    ];
    var i: usize = 0;
    while (i < 32) {
        assert(d[i] == expect[i]);
        i += 1;
    }
}
