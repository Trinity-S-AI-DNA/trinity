module port::trios::mesh::src::packet;

const PACKET_TYPE_ANNOUNCE: u8 = 0x01;
const MIN_WIRE: usize = 34;

struct AnnounceHeader {
    dest: [16]u8,
    sender: [16]u8,
    hops: u8,
}

fn AnnounceHeader_parse(buf: []const u8, out: *AnnounceHeader) -> bool {
    if (buf.len < MIN_WIRE) {
        return false;
    }
    if (buf[0] != PACKET_TYPE_ANNOUNCE) {
        return false;
    }
    var i: usize = 0;
    while (i < 16) {
        out.dest[i] = buf[1 + i];
        out.sender[i] = buf[17 + i];
        i += 1;
    }
    out.hops = buf[33] & 0x0F;
    return true;
}

// The source takes `&mut [u8; MIN_WIRE]`: a buffer whose length is known. A slice keeps
// that length, so a buffer shorter than MIN_WIRE is an index out of bounds, where `[*]u8` had
// no length to check against.
fn AnnounceHeader_serialise(self: AnnounceHeader, buf: []u8) -> void {
    buf[0] = PACKET_TYPE_ANNOUNCE;
    var i: usize = 0;
    while (i < 16) {
        buf[1 + i] = self.dest[i];
        buf[17 + i] = self.sender[i];
        i += 1;
    }
    buf[33] = self.hops & 0x0F;
}

test parse_invalid_short_buffer {
    var buf: [33]u8 = undefined;
    buf[0] = PACKET_TYPE_ANNOUNCE;
    var i: usize = 0;
    while (i < 16) {
        buf[1 + i] = 0xAB;
        buf[17 + i] = 0xCD;
        i += 1;
    }
    buf[32] = 3;

    var header: AnnounceHeader = undefined;
    const ok = AnnounceHeader_parse(&buf, &header);
    assert(!ok);
}

test parse_invalid_type {
    var buf: [34]u8 = undefined;
    buf[0] = 0x02; // Not Announce type
    var i: usize = 0;
    while (i < 16) {
        buf[1 + i] = 0xAB;
        buf[17 + i] = 0xCD;
        i += 1;
    }
    buf[33] = 3;

    var header: AnnounceHeader = undefined;
    const ok = AnnounceHeader_parse(&buf, &header);
    assert(!ok);
}

test parse_valid {
    var buf: [34]u8 = undefined;
    buf[0] = PACKET_TYPE_ANNOUNCE;
    var i: usize = 0;
    while (i < 16) {
        buf[1 + i] = 0xAB;
        buf[17 + i] = 0xCD;
        i += 1;
    }
    buf[33] = 3;

    var header: AnnounceHeader = undefined;
    const ok = AnnounceHeader_parse(&buf, &header);
    assert(ok);
    assert(header.hops == 3);
    var j: usize = 0;
    while (j < 16) {
        assert(header.dest[j] == 0xAB);
        assert(header.sender[j] == 0xCD);
        j += 1;
    }
}

test serialise_then_parse {
    // Create an AnnounceHeader
    var dest: [16]u8 = undefined;
    var sender: [16]u8 = undefined;
    var i: usize = 0;
    while (i < 16) {
        dest[i] = 0xAB;
        sender[i] = 0xCD;
        i += 1;
    }
    const original = AnnounceHeader{ .dest = dest, .sender = sender, .hops = 3 };

    var buf: [34]u8 = undefined;
    AnnounceHeader_serialise(original, &buf);

    var parsed: AnnounceHeader = undefined;
    const ok = AnnounceHeader_parse(&buf, &parsed);
    assert(ok);
    assert(parsed.hops == 3);
    var j: usize = 0;
    while (j < 16) {
        assert(parsed.dest[j] == 0xAB);
        assert(parsed.sender[j] == 0xCD);
        j += 1;
    }
}

test serialise_correct_bytes {
    var dest: [16]u8 = undefined;
    var sender: [16]u8 = undefined;
    var i: usize = 0;
    while (i < 16) {
        dest[i] = 0x11;
        sender[i] = 0x22;
        i += 1;
    }
    const original = AnnounceHeader{ .dest = dest, .sender = sender, .hops = 5 };

    var buf: [34]u8 = undefined;
    AnnounceHeader_serialise(original, &buf);

    // Check the serialised bytes directly
    assert(buf[0] == PACKET_TYPE_ANNOUNCE);
    var j: usize = 0;
    while (j < 16) {
        assert(buf[1 + j] == 0x11);
        assert(buf[17 + j] == 0x22);
        j += 1;
    }
    assert(buf[33] == 5); // hops masked to 0x0F, 5 & 0x0F = 5
}

test parse_masks_hops {
    var buf: [34]u8 = undefined;
    buf[0] = PACKET_TYPE_ANNOUNCE;
    var i: usize = 0;
    while (i < 16) {
        buf[1 + i] = 0xAB;
        buf[17 + i] = 0xCD;
        i += 1;
    }
    buf[33] = 0x1F; // 31, but only lower 4 bits should be used

    var header: AnnounceHeader = undefined;
    const ok = AnnounceHeader_parse(&buf, &header);
    assert(ok);
    assert(header.hops == 0x0F); // 31 & 0x0F = 15
}