module port::trios::crates::trios_igla_race::src::main;

pub struct WorkerResult {
    should_stop: bool,
    new_best: f64,
}

pub enum RaceCommand {
    Start,
    Status,
    Best,
}

pub struct Cli {
    command: RaceCommand,
}

// Decision: Parse CLI args (would normally come from command line)
pub fn parse_cli() -> Cli {
    // Default CLI for testing - in real usage this would parse actual args
    let command = RaceCommand.Start;
    return Cli { command: command };
}

// Decision: Check if BPB is good enough to stop early
pub fn should_stop_early(bpb: f64) -> bool {
    return bpb < 1.5;
}

// Decision: Update best BPB tracking
pub fn update_best_bpb(current_best: f64, new_bpb: f64) -> f64 {
    if (new_bpb < current_best) {
        return new_bpb;
    }
    return current_best;
}

// Decision: Handle worker result and decide what to do
pub fn handle_worker_result(bpb: f64, current_best: f64) -> WorkerResult {
    if (should_stop_early(bpb)) {
        return WorkerResult { should_stop: true, new_best: current_best };
    }
    
    let new_best = update_best_bpb(current_best, bpb);
    return WorkerResult { should_stop: false, new_best: new_best };
}

// Decision: Simulate worker execution and return BPB result
pub fn execute_worker_simulation(worker_id: u64, machine: []const u8) -> f64 {
    // Simulate different BPB results based on worker ID
    // In real implementation, this would be the actual worker computation
    if (worker_id == 0) return 1.2;  // Good result
    if (worker_id == 1) return 1.8;  // Moderate result  
    if (worker_id == 2) return 1.3;  // Good result
    return 2.1;  // Poor result
}

// Decision: Execute Start command with worker simulation
pub fn execute_start_command() -> i32 {
    var best_bpb: f64 = 999999.0;
    var should_stop: bool = false;
    const workers: usize = 4; // Default number of workers
    const machine: []const u8 = "test"; // Default machine
    
    var wid: usize = 0;
    while (wid < workers) {
        let worker_bpb = execute_worker_simulation(wid as u64, machine);
        
        let result = handle_worker_result(worker_bpb, best_bpb);
        should_stop = result.should_stop;
        best_bpb = result.new_best;
        
        if (should_stop) {
            return 0; // Early exit for BPB < 1.5
        }
        
        wid += 1;
    }
    
    return 0;
}

// Decision: Route to appropriate command handler
pub fn execute_command(command: RaceCommand) -> i32 {
    if (command == RaceCommand.Start) {
        return execute_start_command();
    } else if (command == RaceCommand.Status) {
        // Decision: Show status (would connect to DB)
        // Return success code for simulation
        return 0;
    } else if (command == RaceCommand.Best) {
        // Decision: Show best result (would connect to DB)  
        // Return success code for simulation
        return 0;
    }
    
    return 0;
}

// Main function - orchestrates the decisions
pub fn main() -> i32 {
    let cli = parse_cli();
    return execute_command(cli.command);
}

// Test the BPB tracking decision logic
test bpb_tracking_decisions {
    // Test early stop decision
    assert(should_stop_early(1.4) == true);
    assert(should_stop_early(1.5) == false);
    assert(should_stop_early(2.0) == false);
    
    // Test BPB update decision
    assert(update_best_bpb(2.0, 1.8) == 1.8);
    assert(update_best_bpb(1.8, 2.0) == 1.8);
    assert(update_best_bpb(2.0, 1.4) == 1.4);
}

// Test worker result handling decisions
test worker_result_handling {
    let result1 = handle_worker_result(1.4, 2.0);
    assert(result1.should_stop == true);
    assert(result1.new_best == 2.0);
    
    let result2 = handle_worker_result(1.8, 2.0);
    assert(result2.should_stop == false);
    assert(result2.new_best == 1.8);
}

// Test command routing with simulation
test start_command_simulation {
    let start_cmd = RaceCommand.Start;
    let result = execute_command(start_cmd);
    assert(result == 0); // Should succeed
}

// Test worker simulation results
test worker_simulation {
    // Test that we get different BPB results from different workers
    let bpb1 = execute_worker_simulation(0, "test");
    let bpb2 = execute_worker_simulation(1, "test");
    let bpb3 = execute_worker_simulation(2, "test");
    
    // Verify we get the expected simulated results
    assert(bpb1 == 1.2);
    assert(bpb2 == 1.8);
    assert(bpb3 == 1.3);
}

// Test early stop condition in worker simulation
test early_stop_simulation {
    // Test with a worker that finds BPB < 1.5
    let start_cmd = RaceCommand.Start;
    let result = execute_command(start_cmd);
    assert(result == 0); // Should stop early
}