// Golden ratio constant
const PHI: f64 = 1.618033988749895;

// GF16 as a wrapper around u16
struct GF16 {
    dummy: u16,
    bits: u16,
}

// Convert GF16 to its underlying bits
fn to_bits(value: GF16) -> u16 {
    value.bits
}

// Create GF16 from raw bits
fn from_bits(bits: u16) -> GF16 {
    GF16 { dummy: 0, bits: bits }
}

// Add two GF16 values by their bit-level sum (wrapping addition)
pub fn add_bits(a: GF16, b: GF16) -> GF16 {
    let sum = to_bits(a).wrapping_add(to_bits(b));
    from_bits(sum)
}

// Multiply by phi as f64 (host arithmetic)
pub fn scale_phi(x: f64) -> f64 {
    x * PHI
}

// Tests
test add_bits_roundtrip {
    let a = from_bits(1);
    let b = from_bits(2);
    let result = add_bits(a, b);
    assert(to_bits(result) == 3);
}

test add_bits_wrapping {
    let a = from_bits(65535); // max u16
    let b = from_bits(1);
    let result = add_bits(a, b);
    assert(to_bits(result) == 0); // should wrap to 0
}

test scale_phi_unity {
    let s = scale_phi(1.0);
    let diff = if (s < PHI) { PHI - s } else { s - PHI };
    assert(diff < 0.000001);
}

test scale_phi_zero {
    assert(scale_phi(0.0) == 0.0);
}