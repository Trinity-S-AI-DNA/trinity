module port::trios::crates::trios_golden_float;

// Plumbing functions - undefined, only called from main (not tested)
fn join_paths(base: []const u8, sub: []const u8) -> []const u8 { undefined; }
fn file_exists(path: []const u8) -> bool { undefined; }
fn run_zig_build(zig_path: []const u8) -> i32 { undefined; }
fn get_current_dir() -> []const u8 { undefined; }

// Output functions - undefined, only called from main (not tested)
fn print_cargo_warning_skip() { undefined; }
fn print_cargo_rustc_cfg_has_zig_lib() { undefined; }
fn print_cargo_rustc_link_search_native(dir: []const u8) { undefined; }
fn print_cargo_rustc_link_lib_static_golden_float() { undefined; }
fn print_cargo_warning_no_static_lib(lib_path: []const u8) { undefined; }
fn print_cargo_warning_zig_build_failed(exit_code: i32) { undefined; }
fn print_cargo_rerun_if_changed(path: []const u8) { undefined; }

// Pure decision functions - can be tested
fn should_skip(build_zig_exists: bool) -> bool {
    return !build_zig_exists;
}

fn build_succeeded(exit_code: i32) -> bool {
    return exit_code == 0;
}

fn static_lib_exists_after_build(static_lib_path_exists: bool) -> bool {
    return static_lib_path_exists;
}

// Main function
pub fn main() {
    let zig_path = "vendor/zig-golden-float";
    
    // Plumbing: check if build.zig exists
    let build_zig_path = join_paths(zig_path, "build.zig");
    let build_zig_exists = file_exists(build_zig_path);
    
    if (should_skip(build_zig_exists)) {
        print_cargo_warning_skip();
        return;
    }
    
    // Plumbing: run zig build
    let exit_code = run_zig_build(zig_path);
    
    if (build_succeeded(exit_code)) {
        // Plumbing: check if static lib exists
        let lib_dir = join_paths(
            join_paths(get_current_dir(), zig_path),
            "zig-out/lib"
        );
        let static_lib_path = join_paths(lib_dir, "libgolden_float.a");
        let static_lib_exists = file_exists(static_lib_path);
        
        if (static_lib_exists_after_build(static_lib_exists)) {
            print_cargo_rustc_cfg_has_zig_lib();
            print_cargo_rustc_link_search_native(lib_dir);
            print_cargo_rustc_link_lib_static_golden_float();
        } else {
            print_cargo_warning_no_static_lib(static_lib_path);
        }
    } else {
        print_cargo_warning_zig_build_failed(exit_code);
    }
    
    // Plumbing: rerun-if-changed
    let src_path = join_paths(zig_path, "src");
    print_cargo_rerun_if_changed(src_path);
}

// Test blocks for pure decision functions
test should_skip_returns_true_when_build_zig_missing {
    assert(should_skip(false) == true);
}

test should_skip_returns_false_when_build_zig_exists {
    assert(should_skip(true) == false);
}

test build_succeeded_returns_true_for_exit_code_zero {
    assert(build_succeeded(0) == true);
}

test build_succeeded_returns_false_for_non_zero_exit_code {
    assert(build_succeeded(1) == false);
    assert(build_succeeded(-1) == false);
    assert(build_succeeded(42) == false);
}

test static_lib_exists_after_build_returns_true_when_exists {
    assert(static_lib_exists_after_build(true) == true);
}

test static_lib_exists_after_build_returns_false_when_not_exists {
    assert(static_lib_exists_after_build(false) == false);
}