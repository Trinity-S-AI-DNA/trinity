module port::trios_trinity_brain_phi;

pub fn phi_add(a: f32, b: f32) -> f32 {
    return a + b;
}

pub fn phi_mul(a: f32, b: f32) -> f32 {
    return a * b;
}

pub fn phi_subtract(a: f32, b: f32) -> f32 {
    return a - b;
}

test phi_add_test {
    assert(phi_add(1.0, 2.0) == 3.0);
    assert(phi_add(-1.0, 1.0) == 0.0);
    assert(phi_add(0.0, 0.0) == 0.0);
}

test phi_mul_test {
    assert(phi_mul(2.0, 3.0) == 6.0);
    assert(phi_mul(-2.0, 3.0) == -6.0);
    assert(phi_mul(0.0, 5.0) == 0.0);
}

test phi_subtract_test {
    assert(phi_subtract(5.0, 3.0) == 2.0);
    assert(phi_subtract(0.0, 4.0) == -4.0);
    assert(phi_subtract(2.0, 2.0) == 0.0);
}