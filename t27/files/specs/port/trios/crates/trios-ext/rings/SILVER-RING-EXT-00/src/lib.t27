    const result = setup_chat_listener(doc);
    assert(result == null); // Returns null due to undefined body
    
    var doc_no_input = Document { has_chat_input: false };
    const result2 = setup_chat_listener(doc_no_input);
    assert(result2 == null); // Returns null due to undefined body
}

