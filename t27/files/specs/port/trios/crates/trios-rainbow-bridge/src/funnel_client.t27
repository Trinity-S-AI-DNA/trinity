module port::funnel_client;

// Port of crates/trios-rainbow-bridge/src/funnel_client.rs
// Original: InMemoryFunnel struct and FunnelClient trait implementation

// Types from the original module - simplified for port
struct RainbowEvent {
}

struct Subscriber {
    id: u32,
}

struct InMemoryFunnel {
    subscribers: [10]Subscriber,
    len: usize,
    simulated_latency_ms: u64,
}

fn InMemoryFunnel_new() -> InMemoryFunnel {
    var funnel: InMemoryFunnel = undefined;
    funnel.len = 0;
    funnel.simulated_latency_ms = 0;
    return funnel;
}

fn InMemoryFunnel_attach(funnel: InMemoryFunnel, s: Subscriber) -> InMemoryFunnel {
    if (funnel.len < 10) {
        var new_funnel: InMemoryFunnel = undefined;
        new_funnel.len = funnel.len + 1;
        new_funnel.simulated_latency_ms = funnel.simulated_latency_ms;
        
        // Copy existing subscribers
        var i: usize = 0;
        while (i < funnel.len) {
            new_funnel.subscribers[i] = funnel.subscribers[i];
            i += 1;
        }
        
        // Add new subscriber
        new_funnel.subscribers[funnel.len] = s;
        return new_funnel;
    }
    return funnel;
}

fn InMemoryFunnel_subscribers(funnel: InMemoryFunnel) -> [10]Subscriber {
    return funnel.subscribers;
}

fn InMemoryFunnel_set_simulated_latency_ms(funnel: InMemoryFunnel, latency_ms: u64) -> InMemoryFunnel {
    var new_funnel: InMemoryFunnel = undefined;
    new_funnel.len = funnel.len;
    new_funnel.simulated_latency_ms = latency_ms;
    
    // Copy subscribers
    var i: usize = 0;
    while (i < funnel.len) {
        new_funnel.subscribers[i] = funnel.subscribers[i];
        i += 1;
    }
    
    return new_funnel;
}

fn InMemoryFunnel_current_latency_ms(funnel: InMemoryFunnel) -> u64 {
    return funnel.simulated_latency_ms;
}

fn InMemoryFunnel_publish(funnel: InMemoryFunnel, ev: RainbowEvent) -> u64 {
    // In the original, this would deliver events to all subscribers
    // For the port, we just return the latency
    return funnel.simulated_latency_ms;
}

test test_new_funnel {
    var funnel = InMemoryFunnel_new();
    assert(funnel.len == 0);
    assert(funnel.simulated_latency_ms == 0);
}

test test_attach_subscriber {
    var funnel = InMemoryFunnel_new();
    var subscriber: Subscriber = undefined;
    subscriber.id = 1;
    
    var new_funnel = InMemoryFunnel_attach(funnel, subscriber);
    assert(new_funnel.len == 1);
}

test test_set_latency {
    var funnel = InMemoryFunnel_new();
    var new_funnel = InMemoryFunnel_set_simulated_latency_ms(funnel, 100);
    assert(new_funnel.simulated_latency_ms == 100);
    assert(new_funnel.len == 0);
}

test test_get_current_latency {
    var funnel = InMemoryFunnel_new();
    var new_funnel = InMemoryFunnel_set_simulated_latency_ms(funnel, 200);
    var latency = InMemoryFunnel_current_latency_ms(new_funnel);
    assert(latency == 200);
}

test test_publish {
    var funnel = InMemoryFunnel_new();
    var new_funnel = InMemoryFunnel_set_simulated_latency_ms(funnel, 50);
    var latency = InMemoryFunnel_publish(new_funnel, undefined);
    assert(latency == 50);
}

test test_multiple_subscribers {
    var funnel = InMemoryFunnel_new();
    
    var subscriber1: Subscriber = undefined;
    subscriber1.id = 1;
    var funnel1 = InMemoryFunnel_attach(funnel, subscriber1);
    
    var subscriber2: Subscriber = undefined;
    subscriber2.id = 2;
    var funnel2 = InMemoryFunnel_attach(funnel1, subscriber2);
    
    assert(funnel2.len == 2);
}