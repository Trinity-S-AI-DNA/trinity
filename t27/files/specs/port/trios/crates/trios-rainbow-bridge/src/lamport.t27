module port::trios::rainbow_bridge::lamport;

const MAX_AGENTS: usize = 10;

struct LamportState {
    agents: [MAX_AGENTS][]const u8,
    lamports: [MAX_AGENTS]u64,
    len: usize,
}

fn LamportClock_new() -> LamportState {
    var state: LamportState = undefined;
    state.len = 0;
    return state;
}

fn LamportClock_last_seen(state: LamportState, agent: []const u8) -> ?u64 {
    var i: usize = 0;
    while (i < state.len) {
        if (state.agents[i] == agent) {
            return state.lamports[i];
        }
        i += 1;
    }
    return null;
}

fn LamportClock_advance(state: LamportState, agent: []const u8, lamport: u64) -> (bool, LamportState) {
    var i: usize = 0;
    while (i < state.len) {
        if (state.agents[i] == agent) {
            if (lamport <= state.lamports[i]) {
                return (false, state);
            } else {
                state.lamports[i] = lamport;
                return (true, state);
            }
        }
        i += 1;
    }
    if (state.len == MAX_AGENTS) {
        return (false, state);
    }
    state.agents[state.len] = agent;
    state.lamports[state.len] = lamport;
    state.len += 1;
    return (true, state);
}

        test first_event_advances {
            var state = LamportClock_new();
            const (advanced, _state) = LamportClock_advance(state, "alpha", 1);
            assert(advanced);
        }

        test monotone_steps_accepted {
            var state = LamportClock_new();
            const (advanced1, state1) = LamportClock_advance(state, "alpha", 1);
            const (advanced2, state2) = LamportClock_advance(state1, "alpha", 2);
            const (advanced3, state3) = LamportClock_advance(state2, "alpha", 100);
            assert(advanced1 && advanced2 && advanced3);
        }

        test regression_rejected {
            var state = LamportClock_new();
            const (advanced1, state1) = LamportClock_advance(state, "alpha", 10);
            const (advanced2, state2) = LamportClock_advance(state1, "alpha", 5);
            const (advanced3, state3) = LamportClock_advance(state2, "alpha", 10);
            assert(advanced1 && !advanced2 && !advanced3);
        }

        test agents_are_independent {
            var state = LamportClock_new();
            const (advanced1, state1) = LamportClock_advance(state, "alpha", 10);
            const (advanced2, state2) = LamportClock_advance(state1, "beta", 1);
            assert(advanced1 && advanced2);
        }