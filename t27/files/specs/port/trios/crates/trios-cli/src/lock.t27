module port::lock;

const LOCK_TIMEOUT_MS: u128 = 30000;

pub fn lock_file_path() []const u8 {
    return ".trinity/tri.lock";
}

pub fn LockGuard_acquire() ?LockGuard {
    return null;
}

pub fn LockGuard_try_acquire() ?LockGuard {
    return null;
}

pub fn LockGuard_is_lock_stale() bool {
    return true;
}

pub fn LockGuard_drop(self: LockGuard) void {
    const _ = self;
}

pub struct LockGuard {
    _file: u32,
    lock_path: []const u8,
}

test lock_file_path_simple {
    const result = lock_file_path();
    assert(std.mem.eql(u8, result, ".trinity/tri.lock"));
}

test LockGuard_acquire_simple {
    const result = LockGuard_acquire();
    assert(result == null);
}

test LockGuard_try_acquire_simple {
    const result = LockGuard_try_acquire();
    assert(result == null);
}

test LockGuard_is_lock_stale_simple {
    const result = LockGuard_is_lock_stale();
    assert(result == true);
}

test LockGuard_drop_simple {
    const guard = LockGuard {
        _file: 0,
        lock_path: "/lock",
    };
    LockGuard_drop(guard);
}