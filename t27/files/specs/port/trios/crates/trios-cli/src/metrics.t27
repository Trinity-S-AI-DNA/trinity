module port::trios::crates::trios_cli::src::metrics;

const MAX_PARAMS: u64 = 1_000_000;
const MAX_TIME_SEC: f64 = 3600.0;

struct MetricGate {
    name: []const u8,
    threshold: f64,
}

const GATES: [5]MetricGate = [
    MetricGate { .name = "G-BGH", .threshold = 1.50 },
    MetricGate { .name = "G-ORTH", .threshold = 1.20 },
    MetricGate { .name = "G-SWA", .threshold = 1.15 },
    MetricGate { .name = "G-STACK", .threshold = 1.12 },
    MetricGate { .name = "G-NEEDLE", .threshold = 1.00 },
];

struct ValidateBPBResult {
    gate_name: []const u8,
}

struct ValidateParamCountResult {
    success: bool,
}

struct ValidateTimeResult {
    success: bool,
}

pub fn validate_bpb(bpb: f64) -> ValidateBPBResult {
    var i: usize = GATES.len;
    while (i > 0) {
        i -= 1;
        const gate = GATES[i];
        if (bpb <= gate.threshold) {
            return ValidateBPBResult { .gate_name = gate.name };
        }
    }
    return ValidateBPBResult { .gate_name = "FAILED" };
}

pub fn validate_param_count(params: u64) -> ValidateParamCountResult {
    if (params > MAX_PARAMS) {
        return ValidateParamCountResult { .success = false };
    }
    return ValidateParamCountResult { .success = true };
}

pub fn validate_time(time_sec: f64) -> ValidateTimeResult {
    if (time_sec > MAX_TIME_SEC) {
        return ValidateTimeResult { .success = false };
    }
    return ValidateTimeResult { .success = true };
}

test validate_bpb_low {
    const result = validate_bpb(0.5);
    assert(result.gate_name == "G-NEEDLE");
}

test validate_bpb_mid {
    const result = validate_bpb(1.13);
    assert(result.gate_name == "G-SWA");
}

test validate_bpb_high {
    const result = validate_bpb(2.0);
    assert(result.gate_name == "FAILED");
}

test validate_param_count_ok {
    const result = validate_param_count(500_000);
    assert(result.success == true);
}

test validate_param_count_fail {
    const result = validate_param_count(1_500_000);
    assert(result.success == false);
}

test validate_time_ok {
    const result = validate_time(1800.0);
    assert(result.success == true);
}

test validate_time_fail {
    const result = validate_time(7200.0);
    assert(result.success == false);
}