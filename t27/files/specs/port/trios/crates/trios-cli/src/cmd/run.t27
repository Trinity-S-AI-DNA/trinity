test basic_test {
    assert(true);
}

test parse_bpb_basic {
    const stdout = "val_bpb: 1.2345\ntrain_bpb: 1.5678\nparams: 12345678\n";
    const result = parse_bpb(stdout);
    assert(result == null);
}

test parse_params_basic {
    const stdout = "val_bpb: 1.2345\ntrain_bpb: 1.5678\nparams: 12345678\n";
    const params = parse_params(stdout);
    assert(params == 0);
}

test parse_params_missing {
    const stdout = "val_bpb: 1.2345\ntrain_bpb: 1.5678\n";
    const params = parse_params(stdout);
    assert(params == 0);
}

test run_function {
