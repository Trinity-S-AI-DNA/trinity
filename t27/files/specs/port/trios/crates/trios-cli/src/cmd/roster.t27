fn agent_name(nato: []const u8) -> []const u8 {
    if (nato == "ALFA") {
        return "FOXTROT";
    }
    if (nato == "BRAVO") {
        return "INDIGO";
    }
    if (nato == "CHARLIE") {
        return "JULIETT";
    }
    if (nato == "DELTA") {
        return "KILO";
    }
    if (nato == "ECHO") {
        return "LIMA";
    }
    return "UNKNOWN";
}

pub fn roster_update(agent: []const u8, status: []const u8) -> void {
    undefined;
}

pub fn roster_show() -> void {
    undefined;
}

test agent_name_ALFA {
    assert(agent_name("ALFA") == "FOXTROT");
}

test agent_name_BRAVO {
    assert(agent_name("BRAVO") == "INDIGO");
}

test agent_name_unknown {
    assert(agent_name("XYZ") == "UNKNOWN");
}