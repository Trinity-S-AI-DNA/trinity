//! ST-00 — Store schema types
//!
//! Pure data + serde. Mirrors the drizzle SQLite schema from
//! `browseros-agent/apps/server/src/lib/db/schema/*` 1:1 so the Rust
//! backend reads/writes the SAME database file during migration.
//!
//! Three tables: `agent_definitions`, `oauth_tokens`, `produced_files`.
//! No I/O, no async, no SQL — this is the bottom of the ring graph.

/// Adapter kind for an agent definition (drizzle enum).
pub enum Adapter {
    Claude,
    Codex,
    Openclaw,
    Hermes,
}

pub fn Adapter_as_str(self: Adapter) -> []const u8 {
    switch (self) {
        .Claude => "claude",
        .Codex => "codex",
        .Openclaw => "openclaw",
        .Hermes => "hermes",
    }
}

pub fn Adapter_parse(s: []const u8) ?Adapter {
    if (std.mem.eql(u8, s, "claude")) {
        return Adapter.Claude;
    }
    if (std.mem.eql(u8, s, "codex")) {
        return Adapter.Codex;
    }
    if (std.mem.eql(u8, s, "openclaw")) {
        return Adapter.Openclaw;
    }
    if (std.mem.eql(u8, s, "hermes")) {
        return Adapter.Hermes;
    }
    return null;
}

/// How a produced file was detected (drizzle enum, default `diff`).
pub enum DetectedBy {
    Diff,
    Tool,
}

pub fn DetectedBy_default() -> DetectedBy {
    return DetectedBy.Diff;
}

pub fn DetectedBy_as_str(self: DetectedBy) -> []const u8 {
    switch (self) {
        .Diff => "diff",
        .Tool => "tool",
    }
}

pub fn DetectedBy_parse(s: []const u8) -> DetectedBy {
    if (std.mem.eql(u8, s, "tool")) {
        return DetectedBy.Tool;
    } else {
        return DetectedBy.Diff;
    }
}

/// Row of `agent_definitions`.
pub struct AgentDefinitionRow {
    pub id: []const u8,
    pub name: []const u8,
    pub adapter: Adapter,
    pub model_id: []const u8,
    pub reasoning_effort: []const u8,
    /// drizzle enum `permission_mode` — only `approve-all`, default `approve-all`.
    pub permission_mode: []const u8,
    pub session_key: []const u8,
    pub pinned: bool,
    pub adapter_config_json: ?[]const u8,
    /// epoch millis
    pub created_at: i64,
    pub updated_at: i64,
}

/// Row of `oauth_tokens` (composite PK: browseros_id + provider).
pub struct OAuthTokenRow {
    pub browseros_id: []const u8,
    pub provider: []const u8,
    pub access_token: []const u8,
    pub refresh_token: []const u8,
    pub expires_at: i64,
    pub email: ?[]const u8,
    pub account_id: ?[]const u8,
    pub updated_at: i64,
}

/// Row of `produced_files`.
pub struct ProducedFileRow {
    pub id: []const u8,
    pub agent_definition_id: []const u8,
    pub session_key: []const u8,
    pub turn_id: []const u8,
    pub turn_prompt: []const u8,
    pub path: []const u8,
    pub size: i64,
    pub mtime_ms: i64,
    pub created_at: i64,
    pub detected_by: DetectedBy,
}

test Adapter_as_str_test {
    const claude_str = Adapter_as_str(Adapter.Claude);
    assert(std.mem.eql(u8, claude_str, "claude"));
    
    const codex_str = Adapter_as_str(Adapter.Codex);
    assert(std.mem.eql(u8, codex_str, "codex"));
    
    const openclaw_str = Adapter_as_str(Adapter.Openclaw);
    assert(std.mem.eql(u8, openclaw_str, "openclaw"));
    
    const hermes_str = Adapter_as_str(Adapter.Hermes);
    assert(std.mem.eql(u8, hermes_str, "hermes"));
}

test Adapter_parse_test {
    assert(Adapter_parse("claude") == Adapter.Claude);
    assert(Adapter_parse("codex") == Adapter.Codex);
    assert(Adapter_parse("openclaw") == Adapter.Openclaw);
    assert(Adapter_parse("hermes") == Adapter.Hermes);
    assert(Adapter_parse("unknown") == null);
}

test DetectedBy_default_test {
    assert(DetectedBy_default() == DetectedBy.Diff);
}

test DetectedBy_as_str_test {
    assert(std.mem.eql(u8, DetectedBy_as_str(DetectedBy.Diff), "diff"));
    assert(std.mem.eql(u8, DetectedBy_as_str(DetectedBy.Tool), "tool"));
}

test DetectedBy_parse_test {
    assert(DetectedBy_parse("tool") == DetectedBy.Tool);
    assert(DetectedBy_parse("diff") == DetectedBy.Diff);
    assert(DetectedBy_parse("unknown") == DetectedBy.Diff);
}

test AgentDefinitionRow_creation_test {
    const row = AgentDefinitionRow {
        .id = "test_id",
        .name = "Test Agent",
        .adapter = Adapter.Openclaw,
        .model_id = "test_model",
        .reasoning_effort = "high",
        .permission_mode = "approve-all",
        .session_key = "test_session",
        .pinned = true,
        .adapter_config_json = null,
        .created_at = 1234567890,
        .updated_at = 1234567891,
    };
    assert(std.mem.eql(u8, row.id, "test_id"));
    assert(std.mem.eql(u8, row.name, "Test Agent"));
    assert(row.adapter == Adapter.Openclaw);
    assert(row.pinned == true);
}