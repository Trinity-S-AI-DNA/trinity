//! SR-02 scarab-soul ring.
//!
//! Combines O-Type + Three-Type for soul-level agents.
//!
//! Closes #479 · Part of #446 · Anchor: phi^2 + phi^-2 = 3
//!
//! Dep budget (R-RING-DEP-002): `serde` + SR-00 sibling only.

module SoulScarab;

pub enum SoulScarabType {
    OType,
    ThreeType,
    Composite,
}

pub struct SoulScarab {
    kind: SoulScarabType,
    o_term: []const u8,
    compound_term: []const u8,
}

pub fn SoulScarabType_slug(self: SoulScarabType) -> []const u8 {
    if (self == SoulScarabType.OType) {
        return "SR-02/O-Type";
    } else if (self == SoulScarabType.ThreeType) {
        return "SR-02/Three-Type";
    } else {
        return "SR-02/Composite";
    }
}

pub fn SoulScarabType_as_markdown(self: SoulScarabType) -> []const u8 {
    const slug = SoulScarabType_slug(self);
    if (slug == "SR-02/O-Type") {
        return "- **SR-02/O-Type**";
    } else if (slug == "SR-02/Three-Type") {
        return "- **SR-02/Three-Type**";
    } else {
        return "- **SR-02/Composite**";
    }
}

pub fn SoulScarabType_all() -> [SoulScarabType; 3] {
    return [SoulScarabType.OType, SoulScarabType.ThreeType, SoulScarabType.Composite];
}

pub fn SoulScarabType_fmt(self: SoulScarabType, f: anytype) -> []const u8 {
    const slug = SoulScarabType_slug(self);
    return slug;
}

pub fn SoulScarab_new(kind: SoulScarabType) -> SoulScarab {
    return SoulScarab {
        kind: kind,
        o_term: "OType",
        compound_term: "ThreeType",
    };
}

pub fn SoulScarab_fmt(self: SoulScarab, f: anytype) -> []const u8 {
    const slug = SoulScarabType_slug(self.kind);
    if (slug == "SR-02/O-Type") {
        return "SoulScarab(SR-02/O-Type)";
    } else if (slug == "SR-02/Three-Type") {
        return "SoulScarab(SR-02/Three-Type)";
    } else {
        return "SoulScarab(SR-02/Composite)";
    }
}

test three_variants_present {
    const variants = SoulScarabType_all();
    assert(variants.len == 3);
}

test slugs_are_unique {
    const variants = SoulScarabType_all();
    // Test that each variant returns the correct slug (which implies uniqueness)
    assert(SoulScarabType_slug(variants[0]) == "SR-02/O-Type");
    assert(SoulScarabType_slug(variants[1]) == "SR-02/Three-Type");
    assert(SoulScarabType_slug(variants[2]) == "SR-02/Composite");
}

test display_matches_slug {
    const o_type_slug = SoulScarabType_slug(SoulScarabType.OType);
    const composite_slug = SoulScarabType_slug(SoulScarabType.Composite);
    assert(o_type_slug == "SR-02/O-Type");
    assert(composite_slug == "SR-02/Composite");
}

test as_markdown_emits_bullet {
    const markdown = SoulScarabType_as_markdown(SoulScarabType.OType);
    assert(markdown == "- **SR-02/O-Type**");
}

test struct_carries_term_pair {
    const s = SoulScarab_new(SoulScarabType.Composite);
    assert(s.o_term == "OType");
    assert(s.compound_term == "ThreeType");
}

test struct_kind_preserved {
    const s = SoulScarab_new(SoulScarabType.ThreeType);
    assert(s.kind == SoulScarabType.ThreeType);
}