// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trios/crates/trios-scarab-types/rings/SR-01/src/lib.t27
//
// Port of the trios Rust source crates/trios-scarab-types/rings/SR-01/src/
// lib.rs (the SR-01 scarab-lane ring, 130 lines at 8b229e9489ee) to t27, so
// the ring is generated from this spec instead of hand-written Rust. This is
// roadmap stage 6 of 9 (goal #4548).
//
// WHAT IS CARRIED AS CODE
//
// The stable slug of each LaneScarabType variant, the markdown bullet of each
// variant, the declaration order of the variants, the exact strings the two
// fmt::Display impls render, and the SR-00 Term pair LaneScarab::new binds.
//
// WHAT IS DELIBERATELY LEFT OUT
//
// The fmt::Formatter writes themselves (original lines 53-57 and 82-86): the
// formatter is the I/O boundary, and every string an impl would write is
// returned by a ported function here and asserted by a test. The serde derive
// with its JSON round trip (original line 123) is wire I/O with no decision
// inside. as_markdown and LaneScarab_fmt unroll their format! compositions
// per variant because t27 has no string concatenation.
//
// The SR-00 Term pair is declared locally with the two variants the ring's
// logic reads; the real port would reuse the SR-00 sibling's own spec instead
// of this local copy, but cross-module use does not resolve yet.

// The SR-00 Term pair the scarab carries: only the variants the logic reads.
pub enum Term {
    OType,
    TwoType,
}

// LaneScarabType is the variant tag for LaneScarab: O-Type, Two-Type, or the
// composite of both.
pub enum LaneScarabType {
    OType,
    TwoType,
    Composite,
}

// LaneScarab is a lane-level scarab. Carries a LaneScarabType alongside the
// underlying SR-00 Term pair.
pub struct LaneScarab {
    kind: LaneScarabType,
    o_term: Term,
    compound_term: Term,
}

// LaneScarabType_slug returns the stable string slug of a variant. Ports
// LaneScarabType::slug (original line 30), which matches the variant and
// returns a static str per arm.
pub fn LaneScarabType_slug(self: LaneScarabType) -> str {
    return switch (self) {
        .OType => "SR-01/O-Type",
        .TwoType => "SR-01/Two-Type",
        .Composite => "SR-01/Composite",
    };
}

// LaneScarabType_as_markdown returns the markdown bullet representation.
// Ports LaneScarabType::as_markdown (original line 39), which composes
// format!("- **{}**", self.slug()). There is no string concatenation in t27,
// so the composition is unrolled per variant; the rendered text matches the
// original for all three variants.
pub fn LaneScarabType_as_markdown(self: LaneScarabType) -> str {
    return switch (self) {
        .OType => "- **SR-01/O-Type**",
        .TwoType => "- **SR-01/Two-Type**",
        .Composite => "- **SR-01/Composite**",
    };
}

// LaneScarabType_all returns all variants in declaration order. Ports
// LaneScarabType::all (original line 44).
pub fn LaneScarabType_all() -> [3]LaneScarabType {
    return [.OType, .TwoType, .Composite];
}

// LaneScarabType_fmt ports the fmt::Display impl for LaneScarabType (original
// line 54). The original writes self.slug() into the formatter; the write
// itself is I/O, and the string the formatter receives is the slug, so this
// returns that string.
pub fn LaneScarabType_fmt(self: LaneScarabType) -> str {
    return LaneScarabType_slug(self);
}

// LaneScarab_new builds a fresh lane-level scarab. Ports LaneScarab::new
// (original line 73): the kind is carried as given and the SR-00 term pair is
// always bound, o_term to OType and compound_term to TwoType.
pub fn LaneScarab_new(kind: LaneScarabType) -> LaneScarab {
    return LaneScarab { kind: kind, o_term: .OType, compound_term: .TwoType };
}

// LaneScarab_fmt ports the fmt::Display impl for LaneScarab (original line
// 83). The original writes write!(f, "LaneScarab({})", self.kind): the
// rendered text is LaneScarab(<the kind's slug>). The write itself is I/O and
// there is no string concatenation in t27, so the composition is unrolled per
// variant; the rendered text matches the original.
pub fn LaneScarab_fmt(self: LaneScarab) -> str {
    return switch (self.kind) {
        .OType => "LaneScarab(SR-01/O-Type)",
        .TwoType => "LaneScarab(SR-01/Two-Type)",
        .Composite => "LaneScarab(SR-01/Composite)",
    };
}

// Ports tests::three_variants_present, plus the declaration order all()
// promises: OType first, TwoType second, Composite third.
test three_variants_present {
    var xs: [3]LaneScarabType = LaneScarabType_all();
    assert(xs.len == 3);
    assert(LaneScarabType_slug(xs[0]) == "SR-01/O-Type");
    assert(LaneScarabType_slug(xs[1]) == "SR-01/Two-Type");
    assert(LaneScarabType_slug(xs[2]) == "SR-01/Composite");
}

// Ports tests::slugs_are_unique: each slug equals its own literal and differs
// from the other two variants' literals, so the three slugs are pairwise
// distinct.
test slugs_are_unique {
    assert(LaneScarabType_slug(.OType) == "SR-01/O-Type");
    assert(LaneScarabType_slug(.TwoType) == "SR-01/Two-Type");
    assert(LaneScarabType_slug(.Composite) == "SR-01/Composite");
    assert(LaneScarabType_slug(.OType) != "SR-01/Two-Type");
    assert(LaneScarabType_slug(.OType) != "SR-01/Composite");
    assert(LaneScarabType_slug(.TwoType) != "SR-01/Composite");
}

// Ports tests::display_matches_slug: the Display impl renders the slug.
test display_matches_slug {
    assert(LaneScarabType_fmt(.OType) == "SR-01/O-Type");
    assert(LaneScarabType_fmt(.TwoType) == "SR-01/Two-Type");
    assert(LaneScarabType_fmt(.Composite) == "SR-01/Composite");
}

// Ports tests::as_markdown_emits_bullet.
test as_markdown_emits_bullet {
    assert(LaneScarabType_as_markdown(.OType) == "- **SR-01/O-Type**");
    assert(LaneScarabType_as_markdown(.TwoType) == "- **SR-01/Two-Type**");
    assert(LaneScarabType_as_markdown(.Composite) == "- **SR-01/Composite**");
}

// Ports tests::struct_carries_term_pair: a fresh scarab binds the SR-00 term
// pair -- the O-Type term and the Two-Type compound term -- alongside the
// kind it was given.
test struct_carries_term_pair {
    var s: LaneScarab = LaneScarab_new(.Composite);
    assert(s.o_term == .OType);
    assert(s.compound_term == .TwoType);
    assert(s.kind == .Composite);
}

// Stands in for tests::struct_serde_round_trip (original line 123), which
// round-trips through serde_json -- wire I/O with no decision inside. It
// asserts the closest pure behaviour the original guarantees instead:
// LaneScarab::new carries the kind it is given, for every variant.
test new_carries_kind {
    var a: LaneScarab = LaneScarab_new(.OType);
    assert(LaneScarabType_slug(a.kind) == "SR-01/O-Type");
    var b: LaneScarab = LaneScarab_new(.TwoType);
    assert(LaneScarabType_slug(b.kind) == "SR-01/Two-Type");
    var c: LaneScarab = LaneScarab_new(.Composite);
    assert(LaneScarabType_slug(c.kind) == "SR-01/Composite");
}

// Ports the shape of the fmt::Display impl for LaneScarab (original line 83):
// the rendered text is LaneScarab(<the kind's slug>).
test lane_scarab_display_text {
    var s: LaneScarab = LaneScarab_new(.TwoType);
    assert(LaneScarab_fmt(s) == "LaneScarab(SR-01/Two-Type)");
    var t: LaneScarab = LaneScarab_new(.OType);
    assert(LaneScarab_fmt(t) == "LaneScarab(SR-01/O-Type)");
}
