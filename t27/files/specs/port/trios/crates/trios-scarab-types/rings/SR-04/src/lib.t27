module port::trios::crates::trios_scarab_types::rings::SR_04;

// Port of gHashTag/trios crates/trios-scarab-types/rings/SR-04/src/lib.rs at
// 8b229e9489ee - the SR-04 scarab-gate-five ring. A GateScarab pairs a
// GateScarabFiveType tag with the O-Type and Five-Type terms underneath it.
//
// Shape of the port:
// - The two enums and the GateScarab struct are declared here as .t27 types.
//   Rust's `match` parses and is then dropped by the generator, so every match
//   is rewritten as an if/else chain over qualified variants, the shape the
//   sibling ports under specs/port/bootstrap/src/compiler use.
// - Rust's `serde` derives and `fmt::Formatter` are plumbing the caller owns
//   after generation; the decisions - which slug, which markdown bullet, which
//   term pair, which display text - are ported as pure functions that return
//   the strings and values the original writes.
// - The original imports `Term` from the SR-00 sibling ring; cross-module `use`
//   does not resolve yet (#4298), so the two variants the logic reads
//   (Term::OType, Term::FiveType) are mirrored as a local enum.
// - .t27 has no string concatenation, so the `format!` calls in `as_markdown`
//   and `GateScarab_fmt` are unrolled per variant: each arm returns the exact
//   string the original builds for that variant.

pub enum Term {
    OType,
    FiveType,
}

// Variant tag for GateScarab: O-Type carrier (origin / monad term), Five-Type
// carrier, or Composite (both O-Type and Five-Type bound).
pub enum GateScarabFiveType {
    OType,
    FiveType,
    Composite,
}

// GateScarab - gate-five-level scarab. Carries a GateScarabFiveType and the
// underlying SR-00 Term pair (O-Type, FiveType).
struct GateScarab {
    kind: GateScarabFiveType,
    o_term: Term,
    compound_term: Term,
}

// GateScarabFiveType::slug: the stable string slug of the variant.
pub fn GateScarabFiveType_slug(self: GateScarabFiveType) -> []const u8 {
    if (self == GateScarabFiveType.OType) {
        return "SR-04/O-Type";
    }
    if (self == GateScarabFiveType.FiveType) {
        return "SR-04/Five-Type";
    }
    return "SR-04/Composite";
}

// GateScarabFiveType::as_markdown: the markdown bullet form, `- **<slug>**`.
// The original builds it with format!; with no string concatenation in .t27
// the three strings the template can produce are written out per variant.
pub fn GateScarabFiveType_as_markdown(self: GateScarabFiveType) -> []const u8 {
    if (self == GateScarabFiveType.OType) {
        return "- **SR-04/O-Type**";
    }
    if (self == GateScarabFiveType.FiveType) {
        return "- **SR-04/Five-Type**";
    }
    return "- **SR-04/Composite**";
}

// GateScarabFiveType::all: every variant, in declaration order.
pub fn GateScarabFiveType_all() -> [3]GateScarabFiveType {
    var v: [3]GateScarabFiveType = [.OType, .FiveType, .Composite];
    return v;
}

// GateScarabFiveType's fmt::Display: the original writes f.write_str(self.slug()),
// so the display text is the slug. The formatter argument is the caller's
// plumbing; this returns the string that would be written.
pub fn GateScarabFiveType_fmt(self: GateScarabFiveType) -> []const u8 {
    return GateScarabFiveType_slug(self);
}

// GateScarab::new: build a fresh gate-five-level scarab. The kind is the
// caller's choice; the Term pair is always (OType, FiveType).
pub fn GateScarab_new(kind: GateScarabFiveType) -> GateScarab {
    return GateScarab { kind: kind, o_term: Term.OType, compound_term: Term.FiveType };
}

// GateScarab's fmt::Display: the original writes write!(f, "GateScarab({})",
// self.kind), and GateScarabFiveType's Display is its slug, so the text is
// GateScarab(<slug>). Unrolled per variant, as above.
pub fn GateScarab_fmt(self: GateScarab) -> []const u8 {
    if (self.kind == GateScarabFiveType.OType) {
        return "GateScarab(SR-04/O-Type)";
    }
    if (self.kind == GateScarabFiveType.FiveType) {
        return "GateScarab(SR-04/Five-Type)";
    }
    return "GateScarab(SR-04/Composite)";
}

// String equality helper for the tests: both sides are string parameters here,
// which is one of the string comparisons the generator supports.
fn str_eq(a: []const u8, b: []const u8) -> bool {
    return a == b;
}

test three_variants_present {
    var v: [3]GateScarabFiveType = GateScarabFiveType_all();
    assert(v.len == 3);
}

test all_in_declaration_order {
    var v: [3]GateScarabFiveType = GateScarabFiveType_all();
    assert(v[0] == GateScarabFiveType.OType);
    assert(v[1] == GateScarabFiveType.FiveType);
    assert(v[2] == GateScarabFiveType.Composite);
}

test slug_values {
    assert(str_eq(GateScarabFiveType_slug(GateScarabFiveType.OType), "SR-04/O-Type"));
    assert(str_eq(GateScarabFiveType_slug(GateScarabFiveType.FiveType), "SR-04/Five-Type"));
    assert(str_eq(GateScarabFiveType_slug(GateScarabFiveType.Composite), "SR-04/Composite"));
}

test slugs_are_unique {
    // The original collects the three slugs and checks a HashSet keeps the same
    // length; here each slug is checked against each other variant's slug.
    assert(!str_eq(GateScarabFiveType_slug(GateScarabFiveType.OType), GateScarabFiveType_slug(GateScarabFiveType.FiveType)));
    assert(!str_eq(GateScarabFiveType_slug(GateScarabFiveType.OType), GateScarabFiveType_slug(GateScarabFiveType.Composite)));
    assert(!str_eq(GateScarabFiveType_slug(GateScarabFiveType.FiveType), GateScarabFiveType_slug(GateScarabFiveType.Composite)));
}

test display_matches_slug {
    assert(str_eq(GateScarabFiveType_fmt(GateScarabFiveType.OType), "SR-04/O-Type"));
    assert(str_eq(GateScarabFiveType_fmt(GateScarabFiveType.Composite), "SR-04/Composite"));
}

test as_markdown_emits_bullet {
    assert(str_eq(GateScarabFiveType_as_markdown(GateScarabFiveType.OType), "- **SR-04/O-Type**"));
    assert(str_eq(GateScarabFiveType_as_markdown(GateScarabFiveType.FiveType), "- **SR-04/Five-Type**"));
    assert(str_eq(GateScarabFiveType_as_markdown(GateScarabFiveType.Composite), "- **SR-04/Composite**"));
}

test struct_carries_term_pair {
    var s = GateScarab_new(GateScarabFiveType.Composite);
    assert(s.kind == GateScarabFiveType.Composite);
    assert(s.o_term == Term.OType);
    assert(s.compound_term == Term.FiveType);
}

test gate_scarab_display_is_kind_slug {
    var s = GateScarab_new(GateScarabFiveType.FiveType);
    assert(str_eq(GateScarab_fmt(s), "GateScarab(SR-04/Five-Type)"));
}
