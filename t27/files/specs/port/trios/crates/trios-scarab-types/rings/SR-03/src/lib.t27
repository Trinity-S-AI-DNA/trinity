// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trios/crates/trios-scarab-types/rings/SR-03/src/lib.t27
//
// Port of the trios Rust source crates/trios-scarab-types/rings/SR-03/src/
// lib.rs (the SR-03 scarab-gate-four ring, 130 lines at 8b229e9489ee) to t27,
// so the ring is generated from this spec instead of hand-written Rust.
//
// WHAT IS CARRIED AS CODE
//
// The stable slug of each GateScarabFourType variant, the markdown bullet of
// each variant, the declaration order of the variants, the exact strings the
// two fmt::Display impls render, and the SR-00 Term pair GateScarab::new
// binds: the O-Type term and the Four-Type compound term.
//
// WHAT IS DELIBERATELY LEFT OUT
//
// The fmt::Formatter writes themselves: the formatter is the I/O boundary,
// and every string an impl would write is returned by a ported function here
// and asserted by a test. The serde derive with its JSON round trip is wire
// I/O with no decision inside. as_markdown and GateScarabFour_fmt unroll their
// format! compositions per variant because t27 has no string concatenation.
//
// The SR-00 Term pair is declared locally with the two variants the ring's
// logic reads; the real port would reuse the SR-00 sibling's own spec instead
// of this local copy, but cross-module use does not resolve yet.

// The SR-00 Term pair the scarab carries: only the variants the logic reads.
pub enum Term {
    OType,
    FourType,
}

// GateScarabFourType is the variant tag for GateScarabFour: O-Type, Four-Type, or
// the composite of both.
pub enum GateScarabFourType {
    OType,
    FourType,
    Composite,
}

// GateScarabFour is a gate-four-level scarab. Carries a GateScarabFourType
// alongside the underlying SR-00 Term pair.
pub struct GateScarabFour {
    kind: GateScarabFourType,
    o_term: Term,
    compound_term: Term,
}

// GateScarabFourType_slug returns the stable string slug of a variant. Ports
// GateScarabFourType::slug, which matches the variant and returns a static
// str per arm.
pub fn GateScarabFourType_slug(self: GateScarabFourType) -> str {
    return switch (self) {
        .OType => "SR-03/O-Type",
        .FourType => "SR-03/Four-Type",
        .Composite => "SR-03/Composite",
    };
}

// GateScarabFourType_as_markdown returns the markdown bullet representation.
// Ports GateScarabFourType::as_markdown, which composes
// format!("- **{}**", self.slug()). There is no string concatenation in t27,
// so the composition is unrolled per variant; the rendered text matches the
// original for all three variants.
pub fn GateScarabFourType_as_markdown(self: GateScarabFourType) -> str {
    return switch (self) {
        .OType => "- **SR-03/O-Type**",
        .FourType => "- **SR-03/Four-Type**",
        .Composite => "- **SR-03/Composite**",
    };
}

// GateScarabFourType_all returns all variants in declaration order. Ports
// GateScarabFourType::all.
pub fn GateScarabFourType_all() -> [3]GateScarabFourType {
    return [.OType, .FourType, .Composite];
}

// GateScarabFourType_fmt ports the fmt::Display impl for GateScarabFourType.
// The original writes self.slug() into the formatter; the write itself is
// I/O, and the string the formatter receives is the slug, so this returns
// that string.
pub fn GateScarabFourType_fmt(self: GateScarabFourType) -> str {
    return GateScarabFourType_slug(self);
}

// GateScarabFour_new builds a fresh gate-four-level scarab. Ports GateScarab::new:
// the kind is carried as given and the SR-00 term pair is always bound,
// o_term to OType and compound_term to FourType.
pub fn GateScarabFour_new(kind: GateScarabFourType) -> GateScarabFour {
    return GateScarabFour { kind: kind, o_term: .OType, compound_term: .FourType };
}

// GateScarabFour_fmt ports the fmt::Display impl for GateScarab (named GateScarabFour here: SR-04 declares its own GateScarab). The original
// writes write!(f, "GateScarab({})", self.kind): the rendered text is
// GateScarab(<the kind's slug>). The write itself is I/O and there is no
// string concatenation in t27, so the composition is unrolled per variant;
// the rendered text matches the original.
pub fn GateScarabFour_fmt(self: GateScarabFour) -> str {
    return switch (self.kind) {
        .OType => "GateScarab(SR-03/O-Type)",
        .FourType => "GateScarab(SR-03/Four-Type)",
        .Composite => "GateScarab(SR-03/Composite)",
    };
}

// Ports tests::three_variants_present, plus the declaration order all()
// promises: OType first, FourType second, Composite third.
test three_variants_present {
    var xs: [3]GateScarabFourType = GateScarabFourType_all();
    assert(xs.len == 3);
    assert(GateScarabFourType_slug(xs[0]) == "SR-03/O-Type");
    assert(GateScarabFourType_slug(xs[1]) == "SR-03/Four-Type");
    assert(GateScarabFourType_slug(xs[2]) == "SR-03/Composite");
}

// Ports tests::slugs_are_unique: each slug equals its own literal and differs
// from the other two variants' literals, so the three slugs are pairwise
// distinct.
test slugs_are_unique {
    assert(GateScarabFourType_slug(.OType) == "SR-03/O-Type");
    assert(GateScarabFourType_slug(.FourType) == "SR-03/Four-Type");
    assert(GateScarabFourType_slug(.Composite) == "SR-03/Composite");
    assert(GateScarabFourType_slug(.OType) != "SR-03/Four-Type");
    assert(GateScarabFourType_slug(.OType) != "SR-03/Composite");
    assert(GateScarabFourType_slug(.FourType) != "SR-03/Composite");
}

// Ports tests::display_matches_slug: the Display impl renders the slug.
test display_matches_slug {
    assert(GateScarabFourType_fmt(.OType) == "SR-03/O-Type");
    assert(GateScarabFourType_fmt(.FourType) == "SR-03/Four-Type");
    assert(GateScarabFourType_fmt(.Composite) == "SR-03/Composite");
}

// Ports tests::as_markdown_emits_bullet.
test as_markdown_emits_bullet {
    assert(GateScarabFourType_as_markdown(.OType) == "- **SR-03/O-Type**");
    assert(GateScarabFourType_as_markdown(.FourType) == "- **SR-03/Four-Type**");
    assert(GateScarabFourType_as_markdown(.Composite) == "- **SR-03/Composite**");
}

// Ports tests::struct_carries_term_pair: a fresh scarab binds the SR-00 term
// pair -- the O-Type term and the Four-Type compound term -- alongside the
// kind it was given.
test struct_carries_term_pair {
    var s: GateScarabFour = GateScarabFour_new(.Composite);
    assert(s.o_term == .OType);
    assert(s.compound_term == .FourType);
    assert(s.kind == .Composite);
}

// Stands in for tests::struct_serde_round_trip, which round-trips through
// serde_json -- wire I/O with no decision inside. It asserts the closest pure
// behaviour the original guarantees instead: GateScarabFour_new carries the kind
// it is given, for every variant.
test new_carries_kind {
    var a: GateScarabFour = GateScarabFour_new(.OType);
    assert(GateScarabFourType_slug(a.kind) == "SR-03/O-Type");
    var b: GateScarabFour = GateScarabFour_new(.FourType);
    assert(GateScarabFourType_slug(b.kind) == "SR-03/Four-Type");
    var c: GateScarabFour = GateScarabFour_new(.Composite);
    assert(GateScarabFourType_slug(c.kind) == "SR-03/Composite");
}

// Ports the shape of the fmt::Display impl for GateScarabFour: the rendered text
// is GateScarab(<the kind's slug>).
test gate_scarab_display_text {
    var s: GateScarabFour = GateScarabFour_new(.FourType);
    assert(GateScarabFour_fmt(s) == "GateScarab(SR-03/Four-Type)");
    var t: GateScarabFour = GateScarabFour_new(.OType);
    assert(GateScarabFour_fmt(t) == "GateScarab(SR-03/O-Type)");
}
