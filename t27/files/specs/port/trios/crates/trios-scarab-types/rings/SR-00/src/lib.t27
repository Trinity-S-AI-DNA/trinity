module port::trios::crates::trios_scarab_types::rings::SR_00;

pub enum Term {
    OType,
    OneType,
    TwoType,
    ThreeType,
    FourType,
    FiveType,
    SixType,
    SevenType,
    EightType,
    NineType,
    TenType,
    ElevenType,
    TwelveType,
    TrinityType,
    PhiType,
    LucasType,
}

pub struct TermScarab {
    term: Term,
}

pub fn Term_slug(self: Term) -> []const u8 {
    switch (self) {
        .OType => "O-Type",
        .OneType => "One-Type",
        .TwoType => "Two-Type",
        .ThreeType => "Three-Type",
        .FourType => "Four-Type",
        .FiveType => "Five-Type",
        .SixType => "Six-Type",
        .SevenType => "Seven-Type",
        .EightType => "Eight-Type",
        .NineType => "Nine-Type",
        .TenType => "Ten-Type",
        .ElevenType => "Eleven-Type",
        .TwelveType => "Twelve-Type",
        .TrinityType => "Trinity-Type",
        .PhiType => "Phi-Type",
        .LucasType => "Lucas-Type",
    }
}

pub fn Term_as_markdown(self: Term) -> []const u8 {
    switch (self) {
        .OType => "- **O-Type**",
        .OneType => "- **One-Type**",
        .TwoType => "- **Two-Type**",
        .ThreeType => "- **Three-Type**",
        .FourType => "- **Four-Type**",
        .FiveType => "- **Five-Type**",
        .SixType => "- **Six-Type**",
        .SevenType => "- **Seven-Type**",
        .EightType => "- **Eight-Type**",
        .NineType => "- **Nine-Type**",
        .TenType => "- **Ten-Type**",
        .ElevenType => "- **Eleven-Type**",
        .TwelveType => "- **Twelve-Type**",
        .TrinityType => "- **Trinity-Type**",
        .PhiType => "- **Phi-Type**",
        .LucasType => "- **Lucas-Type**",
    }
}

pub fn Term_all() -> [16]Term {
    return [
        Term.OType,
        Term.OneType,
        Term.TwoType,
        Term.ThreeType,
        Term.FourType,
        Term.FiveType,
        Term.SixType,
        Term.SevenType,
        Term.EightType,
        Term.NineType,
        Term.TenType,
        Term.ElevenType,
        Term.TwelveType,
        Term.TrinityType,
        Term.PhiType,
        Term.LucasType,
    ];
}

pub fn Term_fmt(self: Term, f: anytype) void {
    const slug = Term_slug(self);
    _ = f.write_str(slug);
}

pub fn TermScarab_new(term: Term) -> TermScarab {
    var scarab = TermScarab { term: undefined };
    scarab.term = term;
    return scarab;
}

pub fn TermScarab_fmt(self: TermScarab, f: anytype) void {
    const slug = Term_slug(self.term);
    _ = f.write_str("TermScarab(");
    _ = f.write_str(slug);
    _ = f.write_str(")");
}

test Term_slug_basic {
    assert(Term_slug(Term.OType) == "O-Type");
    assert(Term_slug(Term.OneType) == "One-Type");
    assert(Term_slug(Term.TenType) == "Ten-Type");
}

test Term_slug_all_variants {
    assert(Term_slug(Term.TrinityType) == "Trinity-Type");
    assert(Term_slug(Term.PhiType) == "Phi-Type");
    assert(Term_slug(Term.LucasType) == "Lucas-Type");
}

test Term_as_markdown_format {
    assert(Term_as_markdown(Term.OType) == "- **O-Type**");
    assert(Term_as_markdown(Term.NineType) == "- **Nine-Type**");
}

test Term_all_returns_array {
    const terms = Term_all();
    assert(terms.len == 16);
    assert(terms[0] == Term.OType);
    assert(terms[15] == Term.LucasType);
}

test TermScarab_new_creates_instance {
    const scarab = TermScarab_new(Term.TrinityType);
    assert(scarab.term == Term.TrinityType);
}

test TermScarab_fmt_formats_correctly {
    const scarab = TermScarab_new(Term.OType);
    // Test the formatting by checking the term inside
    assert(Term_slug(scarab.term) == "O-Type");
}