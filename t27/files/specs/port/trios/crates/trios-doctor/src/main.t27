module port::trios::crates::trios_doctor;

pub enum CheckStatus { Green, Yellow, Red }

pub struct Diagnostic {
    pub checks: []CheckStatus,
}

pub fn compute_any_red(diag: Diagnostic) -> bool {
    for status in diag.checks {
        if (status == .Red) {
            return true;
        }
    }
    return false;
}

pub fn main() -> i32 {
    let workspace: []const u8 = undefined_get_workspace();
    let root: []const u8 = undefined_compute_root(workspace);
    undefined_print_header(root);
    let doctor = undefined_doctor_new(root);
    let crate_count = undefined_doctor_count_crates(doctor);
    undefined_print_crate_count(crate_count);
    let diag = undefined_doctor_run_all(doctor);
    undefined_print_diagnostics(diag);
    undefined_print_summary(crate_count);
    let any_red = compute_any_red(diag);
    if (any_red) {
        return 1;
    } else {
        return 0;
    }
}

fn undefined_get_workspace() -> []const u8 { undefined; }
fn undefined_compute_root(workspace: []const u8) -> []const u8 { undefined; }
fn undefined_print_header(root: []const u8) { undefined; }
fn undefined_doctor_new(root: []const u8) -> []const u8 { undefined; }
fn undefined_doctor_count_crates(doctor: []const u8) -> usize { undefined; }
fn undefined_print_crate_count(count: usize) { undefined; }
fn undefined_doctor_run_all(doctor: []const u8) -> Diagnostic { undefined; }
fn undefined_print_diagnostics(diag: Diagnostic) { undefined; }
fn undefined_print_summary(count: usize) { undefined; }

test compute_any_red_all_green {
    var checks: [3]CheckStatus = [.Green, .Green, .Green];
    let diag = Diagnostic { checks: &checks };
    assert(!compute_any_red(diag));
}

test compute_any_red_one_red {
    var checks: [3]CheckStatus = [.Green, .Red, .Yellow];
    let diag = Diagnostic { checks: &checks };
    assert(compute_any_red(diag));
}

test compute_any_red_mixed {
    var checks: [5]CheckStatus = [.Green, .Yellow, .Green, .Red, .Green];
    let diag = Diagnostic { checks: &checks };
    assert(compute_any_red(diag));
}