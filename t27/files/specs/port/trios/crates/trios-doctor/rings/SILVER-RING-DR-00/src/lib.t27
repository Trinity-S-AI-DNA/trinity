module port::trios::doctor::rings::SILVER_RING_DR_00;

pub enum CheckStatus {
    Green,
    Yellow,
    Red,
}

pub fn CheckStatus_fmt(status: CheckStatus) -> []const u8 {
    return switch (status) {
        .Green => "✅ Green",
        .Yellow => "⚠️ Yellow",
        .Red => "❌ Red",
    };
}

test CheckStatus_fmt_returns_correct_strings {
    assert(CheckStatus_fmt(CheckStatus::Green) == "✅ Green");
    assert(CheckStatus_fmt(CheckStatus::Yellow) == "⚠️ Yellow");
    assert(CheckStatus_fmt(CheckStatus::Red) == "❌ Red");
}