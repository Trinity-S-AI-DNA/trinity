// Simple types for porting the decision logic
const Value = i32;  // Placeholder for JSON value
const Git2Orchestrator = i32;  // Placeholder for git orchestrator

/// Dispatch GitButler tools.
pub fn dispatch(name: str, input: Value, repo: []const u8, git: Git2Orchestrator) -> Value {
    if (name == "gb_list_branches") {
        const result = gb_list_branches(repo);
        return result;
    } else if (name == "gb_push_stack") {
        const result = gb_push_stack(repo, input);
        return result;
    } else if (name == "gb_workspace_status") {
        const result = gb_workspace_status(repo, git);
        return result;
    } else {
        return 0;  // Default value for unknown function
    }
}

