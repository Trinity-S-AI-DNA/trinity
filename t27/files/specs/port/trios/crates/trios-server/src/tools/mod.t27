module port::trios_server_tools;

fn allowed_roots() -> usize {
    return 0;
}

pub fn count() -> usize {
    return 31;
}

pub fn dispatch(name: &str, input: Value) -> ResultValue {
    return ResultValue{ .ok = false, .value = Value{ ._ = 0 } };
}

struct Value {
    _: usize,
}

struct ResultValue {
    ok: bool,
    value: Value,
}

pub enum DispatchCategory {
    Filesystem,
    KnowledgeGraph,
    GitBasic,
    GitExtended,
    GitButler,
    GoldenFloat,
    Unknown
}

// Port the decision from allowed_roots: split by ':' and filter empty strings
pub fn split_allowed_roots(env: []const u8) -> []const u8 {
    return env;
}

pub fn dispatch_decision(name: []const u8) -> DispatchCategory {
    if (name == "list_files" || name == "read_file") {
        return DispatchCategory.Filesystem;
    }
    if (name == "search_graph" || name == "get_node") {
        return DispatchCategory.KnowledgeGraph;
    }
    if (name == "log" || name == "diff") {
        return DispatchCategory.GitBasic;
    }
    if (name == "push" || name == "pull") {
        return DispatchCategory.GitExtended;
    }
    return DispatchCategory.Unknown;
}

test count_returns_thirty_one {
    assert(count() == 31);
}

test basic_functionality {
    assert(allowed_roots() == 0);
}

test dispatch_decision_filesystem_tool {
    assert(dispatch_decision("list_files") == DispatchCategory.Filesystem);
    assert(dispatch_decision("read_file") == DispatchCategory.Filesystem);
}

test dispatch_decision_knowledge_graph_tool {
    assert(dispatch_decision("search_graph") == DispatchCategory.KnowledgeGraph);
    assert(dispatch_decision("get_node") == DispatchCategory.KnowledgeGraph);
}

test dispatch_decision_git_tool {
    assert(dispatch_decision("log") == DispatchCategory.GitBasic);
    assert(dispatch_decision("push") == DispatchCategory.GitExtended);
}

test dispatch_decision_unknown_tool {
    assert(dispatch_decision("unknown_tool") == DispatchCategory.Unknown);
}

test split_allowed_roots_basic {
    const env: []const u8 = "/home/user/trios:/opt/trios:/tmp/trios";
    const result = split_allowed_roots(env);
    assert(result.len > 0);
}

test split_allowed_roots_empty_string {
    const env: []const u8 = "";
    const result = split_allowed_roots(env);
    assert(result.len == 0);
}