module port::trios::server::src::mcp_endpoints::experience;

const AppState = struct{};

pub fn is_md_file(ext: []const u8) -> bool {
    return ext == "md";
}

pub fn compute_truncate_len(len: usize, limit: usize) -> usize {
    if (len > limit) {
        return limit;
    }
    return len;
}

pub fn read(_state: AppState, params: ?Value) -> Value {
    _ = _state; // unused by the spec body
    _ = params; // unused by the spec body
    undefined;
}

test is_md_file_works {
    assert(is_md_file("md") == true);
    assert(is_md_file("md ") == false);
    assert(is_md_file("markdown") == false);
    assert(is_md_file("") == false);
}

test compute_truncate_len_works {
    assert(compute_truncate_len(0, 50) == 0);
    assert(compute_truncate_len(10, 50) == 10);
    assert(compute_truncate_len(50, 50) == 50);
    assert(compute_truncate_len(51, 50) == 50);
    assert(compute_truncate_len(100, 50) == 50);
}