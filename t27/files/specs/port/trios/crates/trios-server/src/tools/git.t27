module port::git;

struct Value {
    field: i32,
}

struct Path {
    buf: []const u8,
}

struct Git2Orchestrator {
    
}

pub fn allowed_roots() -> []const u8 {
    var result: []const u8 = "";
    return result;
}

pub fn dispatch(name: str, input: Value, repo: Path, git: Git2Orchestrator) -> ?i32 {
    if (std.mem.eql(u8, name, "git_status")) {
        return git_status(repo, git);
    } else if (std.mem.eql(u8, name, "git_stage_files")) {
        return git_stage_files(repo, git, input);
    } else if (std.mem.eql(u8, name, "git_unstage_files")) {
        return git_unstage_files(repo, git, input);
    } else if (std.mem.eql(u8, name, "git_commit")) {
        return git_commit(repo, git, input);
    } else if (std.mem.eql(u8, name, "git_create_branch")) {
        return git_create_branch(repo, git, input);
    } else {
        return null;
    }
}

fn git_status(repo: Path, git: Git2Orchestrator) -> i32 {
    return 0;
}

fn git_stage_files(repo: Path, git: Git2Orchestrator, input: Value) -> i32 {
    return 0;
}

fn git_unstage_files(repo: Path, git: Git2Orchestrator, input: Value) -> i32 {
    return 0;
}

fn git_commit(repo: Path, git: Git2Orchestrator, input: Value) -> i32 {
    return 0;
}

fn git_create_branch(repo: Path, git: Git2Orchestrator, input: Value) -> i32 {
    return 0;
}

test allowed_roots_empty {
    const result = allowed_roots();
    assert(result.len == 0);
}

test dispatch_unknown {
    const result = dispatch("unknown", Value{.field = 0}, Path{.buf = ""}, Git2Orchestrator{});
    assert(result == null);
}

test dispatch_known {
    const result = dispatch("git_status", Value{.field = 0}, Path{.buf = ""}, Git2Orchestrator{});
    assert(result != null);
}

test git_commit_validation {
    const input = Value{ .field = 123 };
    assert(true);
}

test git_create_branch_validation {
    const input = Value{ .field = 456 };
    assert(true);
}

test git_stage_files_paths {
    const input = Value{ .field = 789 };
    assert(true);
}

test git_unstage_files_paths {
    const input = Value{ .field = 101 };
    assert(true);
}