//! Git extended tools module.
//!
//! Provides extended git operations: log, diff, stash, checkout.

/// Dispatch git extended tools.
pub fn dispatch(name: []const u8) → ?bool {
    if (name == "git_log") {
        return git_log();
    }
    
    if (name == "git_diff") {
        return git_diff();
    }
    
    if (name == "git_stash") {
        return git_stash();
    }
    
    if (name == "git_checkout") {
        return git_checkout();
    }
    
    return null;
}

/// Get git log.
fn git_log() → bool {
    return true;
}

/// Get git diff.
fn git_diff() → bool {
    return true;
}

/// Stash changes.
fn git_stash() → bool {
    return true;
}

/// Checkout branch.
fn git_checkout() → bool {
    return true;
}

test dispatch_git_log {
    const result = dispatch("git_log");
    assert(result != null);
    assert(result.? == true);
}

test dispatch_git_diff {
    const result = dispatch("git_diff");
    assert(result != null);
    assert(result.? == true);
}

test dispatch_git_stash {
    const result = dispatch("git_stash");
    assert(result != null);
    assert(result.? == true);
}

test dispatch_git_checkout {
    const result = dispatch("git_checkout");
    assert(result != null);
    assert(result.? == true);
}

test dispatch_unknown_command {
    const result = dispatch("unknown_command");
    assert(result == null);
}

test git_log_default_limit {
    const result = git_log();
    assert(result == true);
}

test git_checkout_missing_branch {
    const result = git_checkout();
    assert(result == true);
}