module port::trios::crates::trios_mcp::rings::BR_XTASK;

// Port of crates/trios-mcp/rings/BR-XTASK/src/main.rs (gHashTag/trios).
// BR-XTASK is the launcher: one `cargo run -p trios-mcp` starts every ring
// (SR-00 BrowserConnector, SR-02 McpServer) on the same host/port and waits
// on Ctrl+C.
//
// Port the decision, not the plumbing:
//   - parse_env collapses the MCP_HOST / MCP_PORT env reads into pure defaults
//     plus the port-validation decision the original gets from
//     `.parse::<u16>().context("Invalid MCP_PORT: must be a valid port number")?`.
//   - init_logging selects the EnvFilter; installing the tracing subscriber is
//     the caller's job.
//   - main is the exit-code decision of `tokio::select! { ctrl_c, ring exit }`.
// Spawning (tokio::spawn), the signal wait (signal::ctrl_c), the banners
// (println!) and the env reads themselves stay with the caller.
//
// No `undefined;` stubs: the review of the previous attempt measured that an
// `undefined;` main breaks the generated build, so every function below has a
// complete body and every one is exercised by a test.
//
// One deliberate simplification: an empty env value here means "variable not
// set", which is exactly when the original's `unwrap_or_else` applies its
// default. A variable explicitly set to "" would reach the original as Ok("")
// and (for MCP_PORT) fail the parse; a plain value parameter cannot see that
// difference.

pub struct PortParse {
    ok: bool,
    value: u16,
}

pub struct EnvOutcome {
    ok: bool,
    host: []const u8,
    port: u16,
    err: []const u8,
}

// The `.parse::<u16>()` of MCP_PORT, i.e. Rust's u16::from_str: an optional
// leading '+' is accepted, every remaining byte must be an ASCII digit, and
// the value must fit 0..=65535. Everything else is the Err the original
// wraps with its context message.
fn parse_port(port_env: []const u8) -> PortParse {
    var value: u32 = 0;
    var first: bool = true;
    var saw_digit: bool = false;
    for (port_env) |c| {
        if (first and (c == '+')) {
            first = false;
            continue;
        }
        first = false;
        if ((c < '0') or (c > '9')) {
            return PortParse { ok: false, value: 0 };
        }
        saw_digit = true;
        value = value * 10 + (c - '0');
        if (value > 65535) {
            return PortParse { ok: false, value: 0 };
        }
    }
    if (!saw_digit) {
        return PortParse { ok: false, value: 0 };
    }
    const port: u16 = value as u16;
    return PortParse { ok: true, value: port };
}

// env::var("MCP_HOST") defaults to 127.0.0.1, env::var("MCP_PORT") defaults
// to "3025", and the u16 parse fails the whole launcher with the original's
// context message when the configured port is not a valid u16.
pub fn parse_env(host_env: []const u8, port_env: []const u8) -> EnvOutcome {
    var host: []const u8 = "127.0.0.1";
    if (host_env.len > 0) {
        host = host_env;
    }
    var port_str: []const u8 = "3025";
    if (port_env.len > 0) {
        port_str = port_env;
    }
    const parsed = parse_port(port_str);
    if (!parsed.ok) {
        return EnvOutcome {
            ok: false,
            host: host,
            port: 0,
            err: "Invalid MCP_PORT: must be a valid port number",
        };
    }
    return EnvOutcome {
        ok: true,
        host: host,
        port: parsed.value,
        err: "",
    };
}

// env::var("RUST_LOG") defaults to "trios_mcp=info,warn"; the original hands
// the filter to tracing_subscriber::fmt().with_env_filter(filter).init().
// Choosing the filter is the decision; installing the global subscriber is
// plumbing, so the port returns the filter the caller should install.
pub fn init_logging(log_env: []const u8) -> []const u8 {
    if (log_env.len > 0) {
        return log_env;
    } else {
        return "trios_mcp=info,warn";
    }
}

// The original's async main: init_logging, banners, (host, port) = parse_env()?,
// launch SR-00 (BrowserConnector) and SR-02 (McpServer) with that endpoint,
// then tokio::select! { signal::ctrl_c() => (), ring exit => warn + exit(1) }.
// Ported as the synchronous exit-code decision - waiting is the caller's job:
//   - parse_env()? fails the launch before any ring starts: Rust's Termination
//     turns the returned Err into exit code 1.
//   - Ctrl+C wins the select: shutdown banner, Ok(()), exit code 0.
//   - A ring exits before Ctrl+C: warn!("{} exited unexpectedly") plus
//     std::process::exit(1).
pub fn main(host_env: []const u8, port_env: []const u8, ctrl_c: bool) -> i32 {
    const parsed = parse_env(host_env, port_env);
    if (!parsed.ok) {
        return 1;
    }
    if (ctrl_c) {
        return 0;
    }
    return 1;
}

test parse_port_is_u16_from_str {
    // Rust's u16::from_str: optional leading '+', all ASCII digits, <= 65535.
    const plus = parse_port("+80");
    assert(plus.ok);
    assert(plus.value == 80);
    const junk = parse_port(" ");
    assert(!junk.ok);
    const bare = parse_port("+");
    assert(!bare.ok);
}

test parse_env_defaults {
    // MCP_HOST and MCP_PORT unset: the original's unwrap_or_else defaults.
    const result = parse_env("", "");
    assert(result.ok);
    assert(result.host == "127.0.0.1");
    assert(result.port == 3025);
    assert(result.err == "");
}

test parse_env_custom_host {
    // A set MCP_HOST passes through with no validation, as in the original.
    const result = parse_env("custom-host", "");
    assert(result.ok);
    assert(result.host == "custom-host");
    assert(result.port == 3025);
}

test parse_env_custom_port {
    const result = parse_env("", "8080");
    assert(result.ok);
    assert(result.host == "127.0.0.1");
    assert(result.port == 8080);
}

test parse_env_leading_plus_is_valid {
    // u16::from_str accepts exactly one leading '+'.
    const result = parse_env("", "+8080");
    assert(result.ok);
    assert(result.port == 8080);
}

test parse_env_rejects_non_numeric_port {
    // "8a08" fails .parse(): the launcher dies with the original's context.
    const result = parse_env("", "8a08");
    assert(!result.ok);
    assert(result.port == 0);
    assert(result.err == "Invalid MCP_PORT: must be a valid port number");
}

test parse_env_port_bounds_match_u16 {
    const max = parse_env("", "65535");
    assert(max.ok);
    assert(max.port == 65535);
    const over = parse_env("", "65536");
    assert(!over.ok);
    const zero = parse_env("", "0");
    assert(zero.ok);
    assert(zero.port == 0);
    const negative = parse_env("", "-1");
    assert(!negative.ok);
}

test init_logging_defaults {
    // RUST_LOG unset: the original's default EnvFilter.
    const filter = init_logging("");
    assert(filter == "trios_mcp=info,warn");
}

test init_logging_custom {
    const filter = init_logging("debug");
    assert(filter == "debug");
}

test main_exits_zero_after_clean_shutdown {
    // Ctrl+C wins the select: shutdown banner, Ok(()), exit code 0.
    assert(main("", "", true) == 0);
    assert(main("0.0.0.0", "9000", true) == 0);
}

test main_exits_one_when_a_ring_exits_first {
    // "{} exited unexpectedly": warn! plus std::process::exit(1).
    assert(main("", "", false) == 1);
}

test main_fails_before_launch_on_invalid_port {
    // parse_env()? propagates the Err before any ring starts, whatever the
    // select would have done.
    assert(main("", "not-a-port", false) == 1);
    assert(main("", "not-a-port", true) == 1);
}
