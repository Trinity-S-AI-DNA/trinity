struct McpServer {
    host: []const u8,
    port: u16,
}

fn McpServer_new(host: []const u8, port: u16) -> McpServer {
    return McpServer { host: host, port: port };
}

fn McpServer_run_stdio(_self: McpServer) { undefined; }

test McpServer_new_test1 {
    var s: McpServer = McpServer_new("localhost", 3025);
    assert(s.host == "localhost");
    assert(s.port == 3025);
}

test McpServer_new_test2 {
    var s: McpServer = McpServer_new("", 0);
    assert(s.host == "");
    assert(s.port == 0);
}