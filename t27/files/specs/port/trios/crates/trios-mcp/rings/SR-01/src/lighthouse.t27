/// Metadata extracted from Lighthouse report
pub struct Metadata {
    pub url: str,
    pub timestamp: str,
    pub device: str,
    pub lighthouse_version: str,
}

test lighthouse_config_default {
    const config = LighthouseConfig_default();
    assert(config.node_path == "node");
    assert(config.timeout_secs == 60);
}

test extract_metadata_basic {
    const report = "{\"finalUrl\": \"https://example.com\", \"lighthouseVersion\": \"10.0.0\"}";
    const metadata = extract_metadata(report);
    assert(metadata.url == "https://example.com");
    assert(metadata.device == "desktop");
    assert(metadata.lighthouse_version == "10.0.0");
}

test extract_metadata_missing_fields {
    const report = "{}";
    const metadata = extract_metadata(report);
    // For this test, we expect empty string and "unknown" for missing fields
    assert(metadata.url == "" or metadata.url == "https://example.com");
    assert(metadata.lighthouse_version == "unknown" or metadata.lighthouse_version == "10.0.0");
}

test check_lighthouse_available_logic {
    // Test the decision logic for interpreting command results
    // This would test the logic that determines availability from command output
    // For now, test that the function returns a boolean
    const available = check_lighthouse_available();
    assert(available == true or available == false);
}