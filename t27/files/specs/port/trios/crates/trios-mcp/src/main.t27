module port::trios::mcp::main;

/// Default host for MCP server connection.
pub const DEFAULT_HOST: []const u8 = "127.0.0.1";

/// Default port for MCP server connection.
pub const DEFAULT_PORT: u16 = 3025;

/// Default username for MCP authentication.
pub const DEFAULT_USERNAME: []const u8 = "perplexity";

/// Default password for MCP authentication. The original fallback
/// password literal is not carried: no password literal lives in source.
pub const DEFAULT_PASSWORD: []const u8 = "";

/// Default TLS setting for MCP connection.
pub const DEFAULT_USE_TLS: bool = false;

/// Protocol scheme for WebSocket connections.
pub enum Protocol {
    Ws,
    Wss,
}

/// Configuration for MCP connection.
pub struct ConnectionConfig {
    host: []const u8,
    port: u16,
    username: []const u8,
    password: []const u8,
    use_tls: bool,
}

/// Parse a port string, returning the default on failure.
pub fn parse_port(port_str: []const u8, default_port: u16) -> u16 {
    // In .t27 we port the decision: try to parse, fall back to default.
    // The actual parsing is plumbing; we model the decision as a pure function.
    // For testing, we simulate the logic: non-numeric returns default.
    // The generated code will implement proper parsing.
    if (port_str.len == 0) {
        return default_port;
    }
    // Check if all characters are digits
    var all_digits: bool = true;
    for c in port_str {
        if (c < '0' or c > '9') {
            all_digits = false;
            break;
        }
    }
    if (!all_digits) {
        return default_port;
    }
    // Simple parsing for testable values
    var result: u16 = 0;
    for c in port_str {
        result = result * 10 + (c - '0') as u16;
    }
    return result;
}

/// Parse a boolean string, returning the default on failure.
pub fn parse_bool(bool_str: []const u8, default_bool: bool) -> bool {
    if (bool_str.len == 0) {
        return default_bool;
    }
    if (bool_str == "true" or bool_str == "True" or bool_str == "1") {
        return true;
    }
    if (bool_str == "false" or bool_str == "False" or bool_str == "0") {
        return false;
    }
    return default_bool;
}

/// Determine the protocol scheme based on TLS setting.
pub fn protocol_from_tls(use_tls: bool) -> Protocol {
    if (use_tls) {
        return Protocol.Wss;
    }
    return Protocol.Ws;
}

/// Get the protocol string for display.
pub fn protocol_string(proto: Protocol) -> []const u8 {
    if (proto == Protocol.Ws) {
        return "ws";
    }
    return "wss";
}

/// Build a ConnectionConfig from individual parameters.
pub fn build_connection_config(
    host: []const u8,
    port: u16,
    username: []const u8,
    password: []const u8,
    use_tls: bool,
) -> ConnectionConfig {
    return ConnectionConfig {
        host: host,
        port: port,
        username: username,
        password: password,
        use_tls: use_tls,
    };
}

/// Main entry point - handles I/O and orchestration (plumbing).
pub fn main() { undefined; }

test parse_port_valid {
    assert(parse_port("3025", 3025) == 3025);
    assert(parse_port("8080", 3025) == 8080);
    assert(parse_port("9999", 3025) == 9999);
}

test parse_port_empty_returns_default {
    assert(parse_port("", 3025) == 3025);
}

test parse_port_invalid_returns_default {
    assert(parse_port("abc", 3025) == 3025);
    assert(parse_port("3025abc", 3025) == 3025);
    assert(parse_port("-1", 3025) == 3025);
}

test parse_bool_true_values {
    assert(parse_bool("true", false) == true);
    assert(parse_bool("True", false) == true);
    assert(parse_bool("1", false) == true);
}

test parse_bool_false_values {
    assert(parse_bool("false", true) == false);
    assert(parse_bool("False", true) == false);
    assert(parse_bool("0", true) == false);
}

test parse_bool_empty_returns_default {
    assert(parse_bool("", true) == true);
    assert(parse_bool("", false) == false);
}

test parse_bool_invalid_returns_default {
    assert(parse_bool("yes", false) == false);
    assert(parse_bool("no", true) == true);
    assert(parse_bool("invalid", false) == false);
}

test protocol_from_tls {
    assert(protocol_from_tls(true) == Protocol.Wss);
    assert(protocol_from_tls(false) == Protocol.Ws);
}

test protocol_string {
    assert(protocol_string(Protocol.Ws) == "ws");
    assert(protocol_string(Protocol.Wss) == "wss");
}

test build_connection_config {
    var config = build_connection_config("127.0.0.1", 3025, "user", "p1", false);
    assert(config.host == "127.0.0.1");
    assert(config.port == 3025);
    assert(config.username == "user");
    assert(config.password == "p1");
    assert(config.use_tls == false);
}

test build_connection_config_with_tls {
    var config = build_connection_config("example.com", 443, "admin", "p2", true);
    assert(config.host == "example.com");
    assert(config.port == 443);
    assert(config.username == "admin");
    assert(config.password == "p2");
    assert(config.use_tls == true);
}

test default_constants {
    assert(DEFAULT_HOST == "127.0.0.1");
    assert(DEFAULT_PORT == 3025);
    assert(DEFAULT_USERNAME == "perplexity");
    assert(DEFAULT_PASSWORD == "");
    assert(DEFAULT_USE_TLS == false);
}