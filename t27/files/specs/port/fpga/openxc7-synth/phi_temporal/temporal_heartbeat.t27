// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/fpga/openxc7-synth/phi_temporal/temporal_heartbeat.t27
// Temporal Heartbeat Top Module Specification
// Port of fpga/openxc7-synth/phi_temporal/temporal_heartbeat.v for silicon generation
// phi^2 + 1/phi^2 = 3 | TRINITY

module temporal_heartbeat_top {

    // === Module Interface ===
    
    pub struct LedOutputs {
        led_d5 : bool,
        led_d6 : bool,
        led_j26 : bool,
    }

    // === Constants ===
    
    // PHI_CYCLE = 80,901,699 (27-bit value)
    pub const PHI_CYCLE : u32 = 80_901_699;
    
    // Counter widths
    pub const PHI_COUNTER_WIDTH : u32 = 27;
    pub const TEMPORAL_LAYER_WIDTH : u32 = 2;
    pub const BLINK_COUNTER_WIDTH : u32 = 25;

    // === State ===
    
    pub struct HeartbeatState {
        phi_counter : u32,
        temporal_layer : u32,
        blink_counter : u32,
    }

    // === Constructor ===
    
    fn init_state() -> HeartbeatState {
        return HeartbeatState{
            .phi_counter = 0,
            .temporal_layer = 0,
            .blink_counter = 0,
        };
    }

    // === Sequential Logic: Next State Computation ===
    
    // Computes the next state on a positive clock edge (cfgmclk)
    fn next_state(state: HeartbeatState) -> HeartbeatState {
        var next : HeartbeatState = state;
        
        // blink_counter increments every cycle
        next.blink_counter = state.blink_counter + 1;
        
        // phi_counter increments every cycle
        next.phi_counter = state.phi_counter + 1;
        
        // When phi_counter reaches PHI_CYCLE, reset it and increment temporal_layer
        if (next.phi_counter >= PHI_CYCLE) {
            next.phi_counter = 0;
            next.temporal_layer = (state.temporal_layer + 1) & 0x3;  // 2-bit wrap-around
        }
        
        return next;
    }

    // === Combinational Logic: LED Output Computation ===
    
    // Computes LED outputs based on temporal_layer and blink_counter bits
    // This corresponds to the always @(*) block in the original Verilog
    fn compute_led_outputs(temporal_layer: u32, blink_counter: u32) -> LedOutputs {
        // Extract relevant bits from blink_counter
        // blink_counter[24] = bit 24 (MSB of 25-bit counter)
        // blink_counter[22] = bit 22
        // blink_counter[20] = bit 20
        let bit24 : bool = ((blink_counter >> 24) & 1) != 0;
        let bit22 : bool = ((blink_counter >> 22) & 1) != 0;
        let bit20 : bool = ((blink_counter >> 20) & 1) != 0;
        
        // Use if/else instead of switch for now (switch with blocks not supported)
        if (temporal_layer == 0) {
            return LedOutputs{
                .led_d5 = bit24,
                .led_d6 = bit24,
                .led_j26 = bit22,
            };
        } else if (temporal_layer == 1) {
            return LedOutputs{
                .led_d5 = true,
                .led_d6 = true,
                .led_j26 = bit20,
            };
        } else if (temporal_layer == 2) {
            return LedOutputs{
                .led_d5 = bit22,
                .led_d6 = bit22,
                .led_j26 = bit20,
            };
        } else {
            // default (temporal_layer == 3)
            return LedOutputs{
                .led_d5 = false,
                .led_d6 = false,
                .led_j26 = false,
            };
        }
    }

    // === Full Cycle Simulation ===
    
    // Simulates one clock cycle: updates state and computes outputs
    fn simulate_cycle(state: HeartbeatState) -> (HeartbeatState, LedOutputs) {
        let next : HeartbeatState = next_state(state);
        let outputs : LedOutputs = compute_led_outputs(next.temporal_layer, next.blink_counter);
        return (next, outputs);
    }

    // === Tests ===
    
    test init_state_zero {
        let state = init_state();
        assert_eq(state.phi_counter, 0);
        assert_eq(state.temporal_layer, 0);
        assert_eq(state.blink_counter, 0);
    }

    test next_state_blink_counter_increments {
        let state = init_state();
        let next = next_state(state);
        assert_eq(next.blink_counter, 1);
        assert_eq(next.phi_counter, 1);
        assert_eq(next.temporal_layer, 0);
    }

    test next_state_phi_counter_wraps {
        let state = HeartbeatState{
            .phi_counter = PHI_CYCLE - 1,
            .temporal_layer = 0,
            .blink_counter = 100,
        };
        let next = next_state(state);
        assert_eq(next.phi_counter, 0);
        assert_eq(next.temporal_layer, 1);
        assert_eq(next.blink_counter, 101);
    }

    test next_state_temporal_layer_wraps {
        let state = HeartbeatState{
            .phi_counter = PHI_CYCLE - 1,
            .temporal_layer = 3,  // Max 2-bit value
            .blink_counter = 100,
        };
        let next = next_state(state);
        assert_eq(next.phi_counter, 0);
        assert_eq(next.temporal_layer, 0);  // Wraps from 3 to 0
        assert_eq(next.blink_counter, 101);
    }

    test compute_led_outputs_layer0 {
        // temporal_layer = 0: d5=d6=bit24, j26=bit22
        let outputs = compute_led_outputs(0, 0x1000000);  // bit24 = 1
        assert_eq(outputs.led_d5, true);
        assert_eq(outputs.led_d6, true);
        assert_eq(outputs.led_j26, false);  // bit22 = 0
        
        let outputs2 = compute_led_outputs(0, 0x00400000);  // bit22 = 1
        assert_eq(outputs2.led_d5, false);
        assert_eq(outputs2.led_d6, false);
        assert_eq(outputs2.led_j26, true);
    }

    test compute_led_outputs_layer1 {
        // temporal_layer = 1: d5=d6=1, j26=bit20
        let outputs = compute_led_outputs(1, 0x00100000);  // bit20 = 1
        assert_eq(outputs.led_d5, true);
        assert_eq(outputs.led_d6, true);
        assert_eq(outputs.led_j26, true);
        
        let outputs2 = compute_led_outputs(1, 0);  // bit20 = 0
        assert_eq(outputs2.led_d5, true);
        assert_eq(outputs2.led_d6, true);
        assert_eq(outputs2.led_j26, false);
    }

    test compute_led_outputs_layer2 {
        // temporal_layer = 2: d5=d6=bit22, j26=bit20
        let outputs = compute_led_outputs(2, 0x00400000);  // bit22 = 1
        assert_eq(outputs.led_d5, true);
        assert_eq(outputs.led_d6, true);
        assert_eq(outputs.led_j26, false);  // bit20 = 0
        
        let outputs2 = compute_led_outputs(2, 0x00100000);  // bit20 = 1
        assert_eq(outputs2.led_d5, false);
        assert_eq(outputs2.led_d6, false);
        assert_eq(outputs2.led_j26, true);
    }

    test compute_led_outputs_layer3_default {
        // temporal_layer = 3 (default): all outputs 0
        let outputs = compute_led_outputs(3, 0xFFFFFFF);  // All bits set
        assert_eq(outputs.led_d5, false);
        assert_eq(outputs.led_d6, false);
        assert_eq(outputs.led_j26, false);
    }

    test simulate_cycle_basic {
        let state = init_state();
        let (next, outputs) = simulate_cycle(state);
        assert_eq(next.blink_counter, 1);
        assert_eq(next.phi_counter, 1);
        assert_eq(next.temporal_layer, 0);
        // At layer 0, blink_counter=1 -> bit24=0, bit22=0
        assert_eq(outputs.led_d5, false);
        assert_eq(outputs.led_d6, false);
        assert_eq(outputs.led_j26, false);
    }

    test simulate_cycle_phi_wrap {
        let state = HeartbeatState{
            .phi_counter = PHI_CYCLE - 1,
            .temporal_layer = 0,
            .blink_counter = PHI_CYCLE - 1,
        };
        let (next, outputs) = simulate_cycle(state);
        assert_eq(next.phi_counter, 0);
        assert_eq(next.temporal_layer, 1);
        assert_eq(next.blink_counter, PHI_CYCLE);
        // At layer 1, outputs depend on blink_counter bits
    }

    // === Invariants ===
    
    invariant phi_counter_bounded
        given state = init_state()
        assert state.phi_counter < PHI_CYCLE

    invariant temporal_layer_2bit
        given state = init_state()
        assert state.temporal_layer < 4

    invariant blink_counter_25bit
        given state = init_state()
        assert state.blink_counter < (1u32 << 25)

    invariant phi_cycle_constant
        assert PHI_CYCLE == 80_901_699

    invariant counter_widths
        assert PHI_COUNTER_WIDTH == 27
        and TEMPORAL_LAYER_WIDTH == 2
        and BLINK_COUNTER_WIDTH == 25

}