// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/fpga/vsa/temporal_heartbeat_top.t27
// Temporal Heartbeat Top Module Specification for Trinity T27 FPGA HIR
// Implements a temporal heartbeat controller with configurable LED patterns
// Based on fpga/vsa/temporal_heartbeat_top.v
// Uses flat arrays + count fields (parser-compatible)
// phi^2 + 1/phi^2 = 3 | TRINITY

module temporal_heartbeat_top {

    // === Constants ===

    pub const PHI_CYCLE : u64 = 80_901_699; // 27-bit value from original

    // === State structures ===

    pub struct TemporalState {
        phi_counter : u64,      // 27-bit counter
        temporal_layer : u32,   // 2-bit counter (0-3)
        blink_counter : u64,    // 25-bit counter
    }

    pub struct LedOutputs {
        led_d5 : bool,
        led_d6 : bool,
        led_j26 : bool,
    }

    // === Constructor helpers ===

    fn initial_state() -> TemporalState {
        return TemporalState{
            .phi_counter = 0,
            .temporal_layer = 0,
            .blink_counter = 0,
        };
    }

    fn initial_outputs() -> LedOutputs {
        return LedOutputs{
            .led_d5 = false,
            .led_d6 = false,
            .led_j26 = false,
        };
    }

    // === State update functions ===

    fn update_counters(state: TemporalState, cfgmclk_rising: bool) -> TemporalState {
        if (!cfgmclk_rising) {
            return state;
        }

        var new_state = state;
        new_state.blink_counter = new_state.blink_counter + 1;
        new_state.phi_counter = new_state.phi_counter + 1;

        // Check if phi counter has reached PHI_CYCLE
        if (new_state.phi_counter >= PHI_CYCLE) {
            new_state.phi_counter = 0;
            new_state.temporal_layer = new_state.temporal_layer + 1;
            
            // Keep temporal_layer within 2-bit range (0-3)
            if (new_state.temporal_layer >= 4) {
                new_state.temporal_layer = 0;
            }
        }

        return new_state;
    }

    // === Output computation functions ===

    fn compute_outputs(state: TemporalState) -> LedOutputs {
        var outputs = initial_outputs();

        if (state.temporal_layer == 0) {
            outputs.led_d5 = state.blink_counter % 2 == 1;
            outputs.led_d6 = state.blink_counter % 2 == 1;
            outputs.led_j26 = state.blink_counter % 4 == 2;
        } else if (state.temporal_layer == 1) {
            outputs.led_d5 = true;
            outputs.led_d6 = true;
            outputs.led_j26 = state.blink_counter % 8 == 4;
        } else if (state.temporal_layer == 2) {
            outputs.led_d5 = state.blink_counter % 4 == 2;
            outputs.led_d6 = state.blink_counter % 4 == 2;
            outputs.led_j26 = state.blink_counter % 8 == 4;
        } else {
            outputs.led_d5 = false;
            outputs.led_d6 = false;
            outputs.led_j26 = false;
        }

        return outputs;
    }

    // === Tests ===

    test initial_state_check
        given s = initial_state()
        then s.phi_counter == 0
        and s.temporal_layer == 0
        and s.blink_counter == 0

    test update_counters_no_clock
        given s = initial_state()
        var new_s = update_counters(s, false)
        then new_s.phi_counter == 0
        and new_s.temporal_layer == 0
        and new_s.blink_counter == 0

    test update_counters_increment
        given s = initial_state()
        var new_s = update_counters(s, true)
        then new_s.phi_counter == 1
        and new_s.temporal_layer == 0
        and new_s.blink_counter == 1

    test phi_cycle_reset
        given s = TemporalState{.phi_counter = PHI_CYCLE - 1, .temporal_layer = 0, .blink_counter = 100}
        var new_s = update_counters(s, true)
        then new_s.phi_counter == 0
        and new_s.temporal_layer == 1
        and new_s.blink_counter == 101

    test temporal_layer_wraparound
        given s = TemporalState{.phi_counter = PHI_CYCLE - 1, .temporal_layer = 3, .blink_counter = 100}
        var new_s = update_counters(s, true)
        then new_s.phi_counter == 0
        and new_s.temporal_layer == 0
        and new_s.blink_counter == 101

    test layer0_outputs_odd
        given s = TemporalState{.phi_counter = 0, .temporal_layer = 0, .blink_counter = 1}
        var outputs = compute_outputs(s)
        then outputs.led_d5 == true
        and outputs.led_d6 == true
        and outputs.led_j26 == false

    test layer0_outputs_even
        given s = TemporalState{.phi_counter = 0, .temporal_layer = 0, .blink_counter = 2}
        var outputs = compute_outputs(s)
        then outputs.led_d5 == false
        and outputs.led_d6 == false
        and outputs.led_j26 == true

    test layer0_outputs_zero
        given s = TemporalState{.phi_counter = 0, .temporal_layer = 0, .blink_counter = 0}
        var outputs = compute_outputs(s)
        then outputs.led_d5 == false
        and outputs.led_d6 == false
        and outputs.led_j26 == false

    test layer1_outputs_on
        given s = TemporalState{.phi_counter = 0, .temporal_layer = 1, .blink_counter = 0}
        var outputs = compute_outputs(s)
        then outputs.led_d5 == true
        and outputs.led_d6 == true
        and outputs.led_j26 == false

    test layer1_outputs_bit2_set
        given s = TemporalState{.phi_counter = 0, .temporal_layer = 1, .blink_counter = 4}
        var outputs = compute_outputs(s)
        then outputs.led_d5 == true
        and outputs.led_d6 == true
        and outputs.led_j26 == true

    test layer2_outputs_bit1_set
        given s = TemporalState{.phi_counter = 0, .temporal_layer = 2, .blink_counter = 2}
        var outputs = compute_outputs(s)
        then outputs.led_d5 == true
        and outputs.led_d6 == true
        and outputs.led_j26 == false

    test layer2_outputs_bit2_set
        given s = TemporalState{.phi_counter = 0, .temporal_layer = 2, .blink_counter = 4}
        var outputs = compute_outputs(s)
        then outputs.led_d5 == false
        and outputs.led_d6 == false
        and outputs.led_j26 == true

    test layer2_outputs_zero
        given s = TemporalState{.phi_counter = 0, .temporal_layer = 2, .blink_counter = 0}
        var outputs = compute_outputs(s)
        then outputs.led_d5 == false
        and outputs.led_d6 == false
        and outputs.led_j26 == false

    test layer3_outputs_default
        given s = TemporalState{.phi_counter = 0, .temporal_layer = 3, .blink_counter = 1}
        var outputs = compute_outputs(s)
        then outputs.led_d5 == false
        and outputs.led_d6 == false
        and outputs.led_j26 == false

    test layer_transition_simple
        given s = TemporalState{.phi_counter = PHI_CYCLE - 1, .temporal_layer = 0, .blink_counter = 0}
        var new_s = update_counters(s, true)
        then new_s.temporal_layer == 1
        and new_s.phi_counter == 0
        and new_s.blink_counter == 1

    test layer_transition_final_to_initial
        given s = TemporalState{.phi_counter = PHI_CYCLE - 1, .temporal_layer = 3, .blink_counter = 0}
        var new_s = update_counters(s, true)
        then new_s.temporal_layer == 0
        and new_s.phi_counter == 0
        and new_s.blink_counter == 1

    // === Invariants ===

    invariant phi_counter_non_negative
        given s = initial_state()
        assert s.phi_counter >= 0

    invariant temporal_layer_valid_range
        given s = initial_state()
        assert s.temporal_layer < 4

    invariant blink_counter_non_negative
        given s = initial_state()
        assert s.blink_counter >= 0

    invariant phi_cycle_constant
        then PHI_CYCLE == 80_901_699

    invariant outputs_boolean
        given s = initial_state()
        var outputs = compute_outputs(s)
        assert (outputs.led_d5 == true or outputs.led_d5 == false)
        and (outputs.led_d6 == true or outputs.led_d6 == false)
        and (outputs.led_j26 == true or outputs.led_j26 == false)
}

// phi^2 + 1/phi^2 = 3 | TRINITY