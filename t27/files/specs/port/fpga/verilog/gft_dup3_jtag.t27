// SPDX-License-Identifier: Apache-2.0
// specs/port/fpga/verilog/gft_dup3_jtag.t27 -- the readout of fpga/verilog/gft_dup3_jtag.v
//
// The bench (W840, layout v3, design field 16) drives seven GftSmul instances
// and reports four sticky clauses over JTAG chain 3. What a host reads back is
// one 32-bit word:
//
//     {16'hA5A5, 4'd3, 6'd16, c_init, c_self, c_comm, c_ind, beat, ok}
//
// and the shift register is seeded with the value that word has when every
// clause still holds and beat = ok = 0, so a read before the first capture
// already decodes as "all clauses 1". This spec states that word, the shift,
// the four clause predicates, the sticky rule and the two counters, so a host
// decoder can be checked against the same numbers the bitstream was built from.
//
// The GftSmul arithmetic itself is not modelled here: the clauses take the
// instance results as inputs.

module gft_dup3_jtag;

pub const JTAG_CHAIN_N : u32 = 3;

pub const TWO : u32 = 20992;            // 2.0
pub const ONE : u32 = 20480;            // 1.0
pub const ZERO : u32 = 0;

pub const INIT_PROBE : u32 = 0x5A5A1234;  // seeded, written by nothing

pub const LIVE_SEED : u32 = 20480;
pub const LIVE_STRIDE : u32 = 1;
pub const LIVE2_SEED : u32 = 21504;
pub const LIVE2_STRIDE : u32 = 7;

pub const SETTLE_DONE : u32 = 31;       // 5'h1F

pub const WORD_MAGIC : u32 = 0xA5A5;    // bits 31..16
pub const WORD_LAYOUT : u32 = 3;        // bits 15..12, 4 bits
pub const WORD_DESIGN : u32 = 16;       // bits 11..6, 6 bits
pub const SR_INIT : u32 = 0xA5A5343C;   // the shift register's seed

pub fn bit(b: bool) -> u32 {
    if (b) { return 1; }
    return 0;
}

// The capture word, field by field as the Verilog concatenation lists it.
pub fn capture_word(c_init: bool, c_self: bool, c_comm: bool, c_ind: bool, beat: bool, ok: bool) -> u32 {
    return (WORD_MAGIC << 16) | (WORD_LAYOUT << 12) | (WORD_DESIGN << 6)
        | (bit(c_init) << 5) | (bit(c_self) << 4) | (bit(c_comm) << 3)
        | (bit(c_ind) << 2) | (bit(beat) << 1) | bit(ok);
}

// One SHIFT cycle: {tdi, sr[31:1]}. TDO is sr[0] before the shift.
pub fn shift_in(sr: u32, tdi: bool) -> u32 {
    return (bit(tdi) << 31) | (sr >> 1);
}

pub fn tdo(sr: u32) -> bool {
    return (sr & 1) == 1;
}

// The four clause predicates.
pub fn init_ok(initprobe: u32) -> bool {
    return initprobe == INIT_PROBE;
}

pub fn pair_ok(a: u32, b: u32) -> bool {
    return a == b;
}

// Liveness: u_ind must not fold to zero, smul(0, live) must vanish under the
// zero guard, and smul(1.0, 1.0) must be 1.0.
pub fn ind_ok(r_ind: u32, r_fold1: u32, r_fold2: u32) -> bool {
    return r_ind != 0 && r_fold1 == ZERO && r_fold2 == ONE;
}

// A clause register starts at 1 and can only be cleared, and only after settle.
pub fn sticky(c: bool, settled: bool, ok_now: bool) -> bool {
    if (settled && !ok_now) { return false; }
    return c;
}

// settle counts up once reset is released and stops at 5'h1F.
pub fn settle_next(settle: u32, rst_n: bool) -> u32 {
    if (rst_n && settle != SETTLE_DONE) { return settle + 1; }
    return settle;
}

// The two counters after `beats` wraps of the 24-bit prescaler.
pub fn live_after(beats: u32) -> u32 {
    return LIVE_SEED + beats * LIVE_STRIDE;
}

pub fn live2_after(beats: u32) -> u32 {
    return LIVE2_SEED + beats * LIVE2_STRIDE;
}

test capture_word_with_every_clause_holding_is_the_seed {
    assert capture_word(true, true, true, true, false, false) == SR_INIT;
    assert SR_INIT == 0xA5A5343C;
}

test capture_word_places_each_flag_in_its_own_bit {
    assert capture_word(false, false, false, false, false, false) == 0xA5A53400;
    assert capture_word(false, false, false, false, false, true) == 0xA5A53401;
    assert capture_word(false, false, false, false, true, false) == 0xA5A53402;
    assert capture_word(false, false, false, true, false, false) == 0xA5A53404;
    assert capture_word(false, false, true, false, false, false) == 0xA5A53408;
    assert capture_word(false, true, false, false, false, false) == 0xA5A53410;
    assert capture_word(true, false, false, false, false, false) == 0xA5A53420;
    assert capture_word(true, true, true, true, true, true) == 0xA5A5343F;
}

test capture_word_header_fields_decode_back {
    const w = capture_word(true, true, true, true, true, true);
    assert (w >> 16) == WORD_MAGIC;
    assert ((w >> 12) & 0xF) == WORD_LAYOUT;
    assert ((w >> 6) & 0x3F) == WORD_DESIGN;
    assert WORD_DESIGN < 64;
}

test shift_moves_right_and_takes_tdi_at_the_top {
    assert shift_in(SR_INIT, false) == 0x52D29A1E;
    assert shift_in(SR_INIT, true) == 0xD2D29A1E;
    assert tdo(SR_INIT) == false;
    assert tdo(capture_word(false, false, false, false, false, true)) == true;
}

test init_probe_matches_only_its_seed {
    assert init_ok(INIT_PROBE) == true;
    assert init_ok(0) == false;
    assert init_ok(SR_INIT) == false;
}

test self_and_comm_clauses_compare_the_pair {
    assert pair_ok(41984, 41984) == true;
    assert pair_ok(41984, 41985) == false;
}

test ind_clause_needs_all_three_instances {
    assert ind_ok(5, 0, ONE) == true;
    assert ind_ok(0, 0, ONE) == false;
    assert ind_ok(5, 1, ONE) == false;
    assert ind_ok(5, 0, TWO) == false;
}

test sticky_clause_clears_only_after_settle {
    assert sticky(true, false, false) == true;
    assert sticky(true, true, false) == false;
    assert sticky(true, true, true) == true;
    assert sticky(false, true, true) == false;
}

test settle_counts_after_reset_and_stops_at_31 {
    assert settle_next(0, false) == 0;
    assert settle_next(5, true) == 6;
    assert settle_next(30, true) == 31;
    assert settle_next(31, true) == 31;
}

test counters_step_by_their_strides {
    assert live_after(0) == ONE;
    assert live_after(3) == 20483;
    assert live2_after(0) == 21504;
    assert live2_after(3) == 21525;
}
