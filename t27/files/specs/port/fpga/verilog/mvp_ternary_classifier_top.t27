// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/fpga/verilog/mvp_ternary_classifier_top.t27
// MVP Ternary Classifier Top Module - Board Wrapper for IGLA RACE
// Provides a characterized clock and instantiates the ternary classifier check
// CFGMCLK (~65 MHz) / 2^PRESCALE_BITS ~= 3.9 vectors/s at default
// Target: QMTech Wukong V1 / XC7A200T-FGG676 via OpenXC7
// Refs #1959

module mvp_ternary_classifier_top {

    // === Module parameters ===

    pub const DEFAULT_PRESCALE_BITS : u32 = 24;

    // === Output port definitions ===

    pub struct LedOutputs {
        led_r23 : bool,
        led_t23 : bool,
    }

    // === Clock generation ===

    pub struct ClockConfig {
        prescale_bits : u32,
        cfgmclk_freq_mhz : f64,
        vector_rate_hz : f64,
    }

    fn clock_config(prescale_bits: u32) -> ClockConfig {
        // CFGMCLK (~65 MHz) / 2^PRESCALE_BITS ~= 3.9 vectors/s at default
        const cfgmclk_freq_mhz : f64 = 65.0;
        // Calculate 2^prescale_bits using bit shift, then convert to float for division
        const prescale_factor : u64 = 1 << prescale_bits;
        const vector_rate_hz : f64 = cfgmclk_freq_mhz * 1000000.0 / (prescale_factor as f64);
        
        return ClockConfig{
            .prescale_bits = prescale_bits,
            .cfgmclk_freq_mhz = cfgmclk_freq_mhz,
            .vector_rate_hz = vector_rate_hz,
        };
    }

    // === LED status interpretation ===

    pub enum LedStatus {
        Success = 0,      // led_r23 BLINKS ~2 Hz, led_t23 DARK -> every vector classified correctly
        Failure = 1,      // led_r23 DARK, led_t23 LIT -> a mismatch was latched
        NoClock = 2,      // both DARK -> no clock / not configured
        Contradiction = 3, // both LIT steady -> contradiction; harness is wrong
    }

    fn interpret_leds(led_r23: bool, led_t23: bool) -> LedStatus {
        if (!led_r23 and !led_t23) {
            return LedStatus.NoClock;
        }
        if (led_r23 and led_t23) {
            return LedStatus.Contradiction;
        }
        if (!led_r23 and led_t23) {
            return LedStatus.Failure;
        }
        // led_r23 is true and led_t23 is false
        return LedStatus.Success;
    }

    fn is_success_status(led_r23: bool, led_t23: bool) -> bool {
        return interpret_leds(led_r23, led_t23) == LedStatus.Success;
    }

    fn is_failure_status(led_r23: bool, led_t23: bool) -> bool {
        return interpret_leds(led_r23, led_t23) == LedStatus.Failure;
    }

    fn is_no_clock_status(led_r23: bool, led_t23: bool) -> bool {
        return interpret_leds(led_r23, led_t23) == LedStatus.NoClock;
    }

    fn is_blinking_success(led_r23: bool, led_t23: bool) -> bool {
        // Success status with blinking led_r23
        return is_success_status(led_r23, led_t23);
    }

    // === Module interface ===

    pub struct ModuleConfig {
        prescale_bits : u32,
    }

    fn module_config() -> ModuleConfig {
        return ModuleConfig{
            .prescale_bits = DEFAULT_PRESCALE_BITS,
        };
    }

    // === Test functions ===

    test clock_config_default
        given cfg = clock_config(24)
        then cfg.prescale_bits == 24
        and cfg.cfgmclk_freq_mhz == 65.0
        and cfg.vector_rate_hz > 3.0  // Should be ~3.9 Hz

    test clock_config_custom_prescale
        given cfg = clock_config(16)
        then cfg.prescale_bits == 16
        and cfg.vector_rate_hz >= cfg.cfgmclk_freq_mhz * 1000000.0 / 65536.0

    test led_status_success
        given status = interpret_leds(true, false)
        then status == LedStatus.Success

    test led_status_failure
        given status = interpret_leds(false, true)
        then status == LedStatus.Failure

    test led_status_no_clock
        given status = interpret_leds(false, false)
        then status == LedStatus.NoClock

    test led_status_contradiction
        given status = interpret_leds(true, true)
        then status == LedStatus.Contradiction

    test is_success_true
        given result = is_success_status(true, false)
        then result == true

    test is_success_false_on_failure
        given result = is_success_status(false, true)
        then result == false

    test is_success_false_on_no_clock
        given result = is_success_status(false, false)
        then result == false

    test is_success_false_on_contradiction
        given result = is_success_status(true, true)
        then result == false

    test is_failure_true
        given result = is_failure_status(false, true)
        then result == true

    test is_failure_false_on_success
        given result = is_failure_status(true, false)
        then result == false

    test is_no_clock_true
        given result = is_no_clock_status(false, false)
        then result == true

    test is_no_clock_false_on_success
        given result = is_no_clock_status(true, false)
        then result == false

    test is_blinking_success_true
        given result = is_blinking_success(true, false)
        then result == true

    test is_blinking_success_false_on_failure
        given result = is_blinking_success(false, true)
        then result == false

    test module_config_default
        given cfg = module_config()
        then cfg.prescale_bits == 24

    // === Invariants ===

    invariant prescale_bits_positive
        given cfg = module_config()
        assert cfg.prescale_bits > 0

    invariant success_leds_consistent
        given success = is_success_status(true, false)
        and failure = is_failure_status(true, false)
        assert success == true
        and failure == false

    invariant no_clock_leds_consistent
        given no_clock = is_no_clock_status(false, false)
        and success = is_success_status(false, false)
        assert no_clock == true
        and success == false

    invariant contradiction_leds_consistent
        given contradiction = interpret_leds(true, true) == LedStatus.Contradiction
        and success = is_success_status(true, true)
        assert contradiction == true
        and success == false
}