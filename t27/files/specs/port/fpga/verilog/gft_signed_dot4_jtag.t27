    //   u_ann: .a1(Z), .b1(live), .a2(Z), .b2(live2), .a3(Z), .b3(live), .a4(Z), .b4(live2)
    //   u_ab:  .a1(live), .b1(N1), .a2(Z), .b2(live2), .a3(N1), .b3(live2), .a4(live), .b4(live)
    //   u_ba:  .a1(N1), .b1(live), .a2(live2), .b2(Z), .a3(live2), .b3(N1), .a4(live), .b4(live)
    //   u_one: .a1(live), .b1(P1), .a2(Z), .b2(Z), .a3(Z), .b3(Z), .a4(Z), .b4(Z)

    // We will create helper functions for each instance's result.

