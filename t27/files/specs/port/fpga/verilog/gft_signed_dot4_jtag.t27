module gft_signed_dot4_jtag {

    // TNF constants per specs/numeric/tnf17.t27: 20480 = +1.0, 86016 = −1.0
    const P1: i32 = 20480;   // +1.0
    const N1: i32 = 86016;   // -1.0
    const Z:  i32 = 0;       // zero

    // Function: signed multiplication (16-bit inputs, 32-bit output)
    // Mimics smul from GftSignedDot4
    pub fn smul(a: i16, b: i16) -> i32 {
        // Sign-extend to 32-bit and multiply
        let a32: i32 = a as i32;
        let b32: i32 = b as i32;
        return a32 * b32;
    }

    // Function: signed addition
    // Mimics sadd from GftSignedDot4
    pub fn sadd(a: i32, b: i32) -> i32 {
        return a + b;
    }

    // Function: dot2 = sadd(smul(a1,b1), smul(a2,b2))
    // Mimics dot2 from GftSignedDot4
    pub fn dot2(a1: i16, b1: i16, a2: i16, b2: i16) -> i32 {
        let prod1: i32 = smul(a1, b1);
        let prod2: i32 = smul(a2, b2);
        return sadd(prod1, prod2);
    }

    // Function: on_comb = sadd(dot2(a1,b1, a2,b2), dot2(a3,b3, a4,b4))
    // Mimics the four-term dot product
    pub fn on_comb(a1: i16, b1: i16, a2: i16, b2: i16,
                   a3: i16, b3: i16, a4: i16, b4: i16) -> i32 {
        let dot2_1: i32 = dot2(a1, b1, a2, b2);
        let dot2_2: i32 = dot2(a3, b3, a4, b4);
        return sadd(dot2_1, dot2_2);
    }

    // Function: compute the four properties given the live and live2 signals
    // We assume that the GftSignedDot4 instances are computed as follows:
    //   r_can = on_comb(P1, live, N1, live, P1, live, N1, live)
    //   r_ann = on_comb(Z, live, Z, live2, Z, live, Z, live2)
    //   r_ab  = on_comb(live, N1, Z, live2, N1, live2, live, live)
    //   r_ba  = on_comb(N1, live, live2, Z, live2, N1, live, live)
    //   r_one = on_comb(live, P1, Z, Z, Z, Z, Z, Z)
