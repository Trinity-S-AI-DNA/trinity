// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/fpga/verilog/tnf17_jtag.t27
// TNF17 JTAG Test Module Specification
// Ports the involution test logic from fpga/verilog/tnf17_jtag.v
// Tests that TNF17 negation is an involution: applying twice returns original
// Also verifies that at least one probe actually changes (not identity)
// phi^2 + 1/phi^2 = 3 | TRINITY

module tnf17_jtag {

    // === Module parameters ===
    
    pub const JTAG_CHAIN_N : u32 = 3;
    
    // === TNF17 test probe values ===
    // These are the 8 test cases from the original Verilog
    
    pub const PROBE_VALUES : [8]u32 = [
        20480,   // TNF_ONE: offset 40, mantissa 0
        86016,   // its negation
        0,       // all zero
        511,     // mantissa full, offset 0
        16384,   // offset 32
        40960,   // offset 80, the top rung
        65536,   // sign bit alone
        131071   // every field saturated
    ];
    
    // === Test status tracking ===
    
    pub struct TestStatus {
        swept : bool,
        inv_acc : bool,
        moved : bool,
        sig : bool,
        beat : bool,
    }
    
    // === Constructor functions ===
    
    fn initial_test_status() -> TestStatus {
        return TestStatus{
            .swept = false,
            .inv_acc = true,
            .moved = false,
            .sig = false,
            .beat = false,
        };
    }
    
    fn test_status_with_beat(beat: bool) -> TestStatus {
        return TestStatus{
            .swept = false,
            .inv_acc = true,
            .moved = false,
            .sig = false,
            .beat = beat,
        };
    }
    
    // === Test logic functions ===
    
    // Get probe value for given index
    fn get_probe_value(index: u32) -> u32 {
        if (index < 8) {
            return PROBE_VALUES[index];
        }
        return 0;
    }
    
    // Simulate one TNF17 transformation
    // In the real hardware, this would be the actual TNF17 circuit
    // For testing, we model the expected behavior
    fn tnf17_transform(x: u32) -> u32 {
        // This is a mock implementation - in reality this would be
        // the actual TNF17 floating-point negation circuit
        // The key property is that applying it twice should return the original
        return x ^ 0x65536; // Flip the sign bit as a simple involution
    }
    
    // Check if applying TNF17 twice returns the original (involution property)
    fn is_involution(x: u32, r1: u32, r2: u32) -> bool {
        return r2 == x;
    }
    
    // Check if at least one probe actually changed (not identity)
    fn probe_moved(x: u32, r1: u32) -> bool {
        return r1 != x;
    }
    
    // Update test status for one probe
    fn update_test_status(status: TestStatus, v: u32, x: u32, r1: u32, r2: u32) -> TestStatus {
        var new_status = status;
        
        if (!new_status.swept) {
            // Check involution property
            if (!is_involution(x, r1, r2)) {
                new_status.inv_acc = false;
            }
            
            // Check if probe moved
            if (probe_moved(x, r1)) {
                new_status.moved = true;
            }
            
            // Check if we've processed all probes
            if (v == 7) {
                new_status.swept = true;
                // Compute final signature: involution passed AND at least one probe moved
                new_status.sig = new_status.inv_acc and (new_status.moved or probe_moved(x, r1));
            }
        }
        
        return new_status;
    }
    
    // Generate JTAG shift register value
    fn generate_jtag_value(status: TestStatus, beat: bool) -> u32 {
        // Layout from original Verilog:
        // Bits [31:16] = 0xA5A5 (constant)
        // Bits [15:12] = VERSION NIBBLE = 3 (layout v3)
        // Bits [11:8] = DESIGN NIBBLE = 9
        // Bit 7 = inv_acc (involution passed)
        // Bit 6 = moved (at least one probe changed)
        // Bit 5 = swept (test completed)
        // Bit 4 = PADDING = 1
        // Bit 3 = beat (alternating signal)
        // Bit 2 = ok (final signature)
        // Bits [1:0] = unused (0)
        
        var inv_acc_bit : u32 = 0;
        var moved_bit : u32 = 0;
        var swept_bit : u32 = 0;
        var beat_bit : u32 = 0;
        var ok_bit : u32 = 0;
        
        if (status.inv_acc) {
            inv_acc_bit = 1;
        }
        if (status.moved) {
            moved_bit = 1;
        }
        if (status.swept) {
            swept_bit = 1;
        }
        if (beat) {
            beat_bit = 1;
        }
        if (status.sig) {
            ok_bit = 1;
        }
        
        return (0xA5A5 << 16) | // Bits [31:16]
               (3 << 12) |     // VERSION NIBBLE = 3
               (9 << 8) |      // DESIGN NIBBLE = 9
               (inv_acc_bit << 7) |  // inv_acc
               (moved_bit << 6) |     // moved
               (swept_bit << 5) |     // swept
               (1 << 4) |        // PADDING = 1
               (beat_bit << 3) |      // beat
               (ok_bit << 2);        // ok
    }
    
    // === Test functions ===
    
    test probe_values_correct
        then get_probe_value(0) == 20480   // TNF_ONE
        and get_probe_value(1) == 86016   // its negation
        and get_probe_value(2) == 0       // all zero
        and get_probe_value(3) == 511     // mantissa full
        and get_probe_value(4) == 16384   // offset 32
        and get_probe_value(5) == 40960   // offset 80
        and get_probe_value(6) == 65536   // sign bit alone
        and get_probe_value(7) == 131071  // every field saturated
    
    test involution_property_holds
        // For any x, applying TNF17 twice should return x
        var x = 20480;
        var r1 = tnf17_transform(x);
        var r2 = tnf17_transform(r1);
        then is_involution(x, r1, r2) == true
    
    test involution_property_fails_for_identity
        // If we use identity function, involution should fail
        var x = 20480;
        var r1 = x;  // identity - no change
        var r2 = x;  // identity again
        then is_involution(x, r1, r2) == true  // This would pass, but moved would be false
    
    test probe_moved_detection
        var x = 20480;
        var r1 = tnf17_transform(x);  // should be different
        then probe_moved(x, r1) == true
    
    test probe_moved_false_for_identity
        var x = 20480;
        var r1 = x;  // identity - no change
        then probe_moved(x, r1) == false
    
    test test_status_update_first_probe
        var status = initial_test_status();
        var x = 20480;
        var r1 = tnf17_transform(x);
        var r2 = tnf17_transform(r1);
        var new_status = update_test_status(status, 0, x, r1, r2);
        then new_status.inv_acc == true    // involution holds
        and new_status.moved == true       // probe moved
        and new_status.swept == false      // not done yet
    
    test test_status_update_last_probe
        var status = initial_test_status();
        var x = 20480;
        var r1 = tnf17_transform(x);
        var r2 = tnf17_transform(r1);
        var new_status = update_test_status(status, 7, x, r1, r2);
        then new_status.swept == true       // test completed
        and new_status.sig == true         // both conditions met
    
    test jtag_value_generation
        var status = test_status_with_beat(true);
        var jtag_value = generate_jtag_value(status, true);
        then (jtag_value & 0xFFFF) == 0xA5A5  // lower 16 bits
        and (jtag_value >> 12) & 0xF == 3     // version nibble
        and (jtag_value >> 8) & 0xF == 9      // design nibble
        and (jtag_value >> 7) & 1 == 1        // inv_acc = true
        and (jtag_value >> 6) & 1 == 0        // moved = false (initial state)
        and (jtag_value >> 5) & 1 == 0        // swept = false (initial state)
        and (jtag_value >> 4) & 1 == 1        // padding = 1
        and (jtag_value >> 3) & 1 == 1        // beat = true
        and (jtag_value >> 2) & 1 == 0        // ok = false (initial state)
    
    test jtag_value_generation_with_results
        var status = TestStatus{
            .swept = true,
            .inv_acc = true,
            .moved = true,
            .sig = true,
            .beat = false,
        };
        var jtag_value = generate_jtag_value(status, false);
        then (jtag_value >> 7) & 1 == 1        // inv_acc = true
        and (jtag_value >> 6) & 1 == 1        // moved = true
        and (jtag_value >> 5) & 1 == 1        // swept = true
        and (jtag_value >> 2) & 1 == 1        // ok = true
    
    test complete_test_scenario
        // Simulate the complete test scenario from the original Verilog
        var status = initial_test_status();
        
        // Process all 8 probes
        var i: u32 = 0;
        while (i < 8) {
            var x = get_probe_value(i);
            var r1 = tnf17_transform(x);
            var r2 = tnf17_transform(r1);
            status = update_test_status(status, i, x, r1, r2);
            i = i + 1;
        }
        
        // Final results should show both conditions met
        then status.swept == true
        and status.inv_acc == true      // involution holds for all probes
        and status.moved == true       // at least one probe changed
        and status.sig == true         // final signature is good
    
    test beat_counter_simulation
        // Simulate the beat counter from the original Verilog
        var pre: u32 = 0;
        var beat: bool = false;
        
        // Simulate 2^24 + 1 clock cycles (should toggle beat once)
        var cycles: u32 = 0;
        while (cycles < 16777217) {  // 2^24 + 1
            pre = pre + 1;
            if (pre == 0) {
                beat = !beat;
            }
            cycles = cycles + 1;
        }
        
        then beat == true  // Should have toggled from initial false to true
}

// phi^2 + 1/phi^2 = 3 | TRINITY