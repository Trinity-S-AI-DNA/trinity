// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/fpga/verilog/link_node.t27
// Ternary Link Node Specification for Trinity T27 FPGA HIR
// JTAG-writable input, JTAG-readable output with three roles: encoder, decoder, relay
// Based on ZeroDSP_TernaryLink ternary encoding
// phi^2 + 1/phi^2 = 3 | TRINITY

module link_node {

    // === Module parameters ===

    pub const JTAG_CHAIN_N : u32 = 3;
    pub const ROLE : u32 = 0;

    // === Ternary encoding constants ===

    pub const WIRE_SYMBOL_COUNT : u32 = 3;  // {0,1,2} - 3 is not a wire code
    pub const DATA_WORD_BITS : u32 = 3;     // 3-bit input to encoder
    pub const CODEWORD_BITS : u32 = 4;      // 4-bit ternary codeword output
    pub const SENTINEL_VALUE : u32 = 0b1111; // 4'b1111 for invalid codewords

    // === Role enumeration ===

    pub const Role = enum(u8) {
        encoder = 0,
        decoder = 1,
        relay = 2,
    }

    // === ZeroDSP_TernaryLink interface simulation ===

    pub struct TernaryLinkConfig {
        name : &str,
        data_bits : u32,
        code_bits : u32,
    }

    pub struct TernaryLinkRequest {
        v : u32,        // Input data word (extended to 8 bits in original)
        en : bool,      // Enable signal
    }

    pub struct TernaryLinkResponse {
        code : u32,     // 8-bit codeword (we only use lower 4 bits)
        ready : bool,   // DUT ready signal
    }

    pub struct DecoderResult {
        reply : u32,    // Decoder reply value
        nomatch : bool, // Whether no match was found
    }

    fn ternary_link_config(name: &str) -> TernaryLinkConfig {
        return TernaryLinkConfig{
            .name = name,
            .data_bits = DATA_WORD_BITS,
            .code_bits = CODEWORD_BITS,
        };
    }

    fn ternary_link_request(v: u32, en: bool) -> TernaryLinkRequest {
        return TernaryLinkRequest{
            .v = v,
            .en = en,
        };
    }

    fn ternary_link_response(code: u32, ready: bool) -> TernaryLinkResponse {
        return TernaryLinkResponse{
            .code = code,
            .ready = ready,
        };
    }

    // === ZeroDSP_TernaryLink simulation ===
    // This simulates the ternary encoding behavior

    fn zero_dsp_ternary_encode(v: u32) -> u32 {
        // Simulate ternary encoding of 3-bit input to 4-bit codeword
        // This is a simplified model - the actual ZeroDSP_TernaryLink 
        // implements specific ternary encoding logic
        var lo_trit : u32 = v & 0x1;          // bit 0
        var hi_trit : u32 = (v >> 1) & 0x1;   // bit 1  
        var mid_trit : u32 = (v >> 2) & 0x1;  // bit 2
        
        // Map binary to ternary: 0->0, 1->1, but we need ternary logic
        // For simulation, create a deterministic encoding
        return (lo_trit * 1) | (mid_trit * 2) | (hi_trit * 4);
    }

    fn zero_dsp_ternary_link(config: TernaryLinkConfig, req: TernaryLinkRequest) -> TernaryLinkResponse {
        var code : u32 = 0;
        var ready : bool = req.en;
        
        if (req.en) {
            code = zero_dsp_ternary_encode(req.v);
        }
        
        return ternary_link_response(code, ready);
    }

    // === Role-specific logic functions ===

    // ENCODER ROLE (ROLE = 0): 3-bit word -> 4-bit ternary codeword
    fn encoder_process(cmd: u32, dut_req: TernaryLinkRequest) -> TernaryLinkResponse {
        var enc_in : u32 = cmd & 0x7;  // Take lower 3 bits of command
        var ternary_req : TernaryLinkRequest = ternary_link_request(enc_in, true);
        return zero_dsp_ternary_link(ternary_link_config("encoder"), ternary_req);
    }

    // DECODER ROLE (ROLE = 1): 4-bit codeword -> search for matching 3-bit word
    fn decoder_process(cmd: u32, dut_req: TernaryLinkRequest) -> DecoderResult {
        var reply : u32 = SENTINEL_VALUE;
        var nomatch : bool = true;
        
        // Search through all possible 3-bit inputs (0..7)
        var probe : u32 = 0;
        while (probe < 8) {
            var probe_req : TernaryLinkRequest = ternary_link_request(probe, true);
            var probe_resp : TernaryLinkResponse = zero_dsp_ternary_link(ternary_link_config("decoder"), probe_req);
            
            // Check if this probe matches the command codeword
            if (probe_resp.code == cmd) {
                reply = probe;  // Found match, return the probe value
                nomatch = false;
                break;
            }
            
            probe = probe + 1;
        }
        
        return DecoderResult{ .reply = reply, .nomatch = nomatch };
    }

    // RELAY ROLE (ROLE = 2): Validate codeword symbols and re-emit or send sentinel
    fn relay_process(cmd: u32) -> DecoderResult {
        var hi_ok : bool = (cmd & 0xC) != 0xC;  // Check upper 2 bits != 0b11
        var lo_ok : bool = (cmd & 0x3) != 0x3;  // Check lower 2 bits != 0b11
        
        var reply : u32 = SENTINEL_VALUE;
        var nomatch : bool = true;
        
        if (hi_ok and lo_ok) {
            reply = cmd;      // Both symbols are legal, re-emit unchanged
            nomatch = false;
        }
        
        return DecoderResult{ .reply = reply, .nomatch = nomatch };
    }

    // === Main processing function ===

    fn link_node_process(role: Role, cmd: u32) -> (u32, bool) {
        var dut_req : TernaryLinkRequest = ternary_link_request(0, true);
        
        if (role == .encoder) {
            var resp : TernaryLinkResponse = encoder_process(cmd, dut_req);
            return (resp.code & 0xF, resp.ready);  // Return lower 4 bits
        } else if (role == .decoder) {
            var result : DecoderResult = decoder_process(cmd, dut_req);
            return (result.reply, result.nomatch);
        } else if (role == .relay) {
            var result : DecoderResult = relay_process(cmd);
            return (result.reply, result.nomatch);
        } else {
            return (SENTINEL_VALUE, true);
        }
    }

    // === JTAG interface simulation ===

    pub struct JtagConfig {
        chain_n : u32,
        magic_prefix : u32,
    }

    fn jtag_config(chain_n: u32) -> JtagConfig {
        return JtagConfig{
            .chain_n = chain_n,
            .magic_prefix = 0xA5A5A5A,  // 28 bits of magic for shift register
        };
    }

    fn jtag_shift_reply(config: JtagConfig, reply: u32) -> u32 {
        // Shift in magic prefix + reply (32 bits total)
        return (config.magic_prefix << 4) | (reply & 0xF);
    }

    // === Validation functions ===

    fn validate_codeword(code: u32) -> bool {
        // Check if both 2-bit symbols are legal (not 0b11)
        var hi_ok : bool = (code & 0xC) != 0xC;
        var lo_ok : bool = (code & 0x3) != 0x3;
        return hi_ok and lo_ok;
    }

    fn is_sentinel(value: u32) -> bool {
        return value == SENTINEL_VALUE;
    }

    fn role_to_string(role: Role) -> &str {
        if (role == .encoder) {
            return "encoder";
        } else if (role == .decoder) {
            return "decoder";
        } else if (role == .relay) {
            return "relay";
        } else {
            return "unknown";
        }
    }

    // === Tests ===

    test encoder_role
        then role_to_string(.encoder) == "encoder"

    test decoder_role  
        then role_to_string(.decoder) == "decoder"

    test relay_role
        then role_to_string(.relay) == "relay"

    // link_node_process returns the pair (reply, flag); out[0] is the reply,
    // out[1] the flag (ready for the encoder, nomatch for decoder and relay).

    test encoder_process_input_0
        given out = link_node_process(Role.encoder, 0)  // cmd = 3'b000
        then out[0] == 0  // Should encode to 0
        and out[1] == true

    test encoder_process_input_1
        given out = link_node_process(Role.encoder, 1)  // cmd = 3'b001
        then out[0] != 0  // Should encode to non-zero
        and out[1] == true

    test encoder_process_input_7
        given out = link_node_process(Role.encoder, 7)  // cmd = 3'b111
        then out[0] != 0  // Should encode to non-zero
        and out[1] == true

    test decoder_process_nomatch
        given out = link_node_process(Role.decoder, 0b1111)  // Sentinel value has no preimage
        then is_sentinel(out[0]) == true
        and out[1] == true

    test decoder_process_match_found
        given out = link_node_process(Role.decoder, 0)  // Should match when probe=0 finds encoding
        then out[1] == false  // Should find a match for valid encoding

    test relay_process_valid_codeword
        given out = link_node_process(Role.relay, 0b0101)  // Delimiter (+1,+1) - should pass validation
        then out[0] == 0b0101  // Re-emit unchanged
        and out[1] == false

    test relay_process_invalid_hi
        given out = link_node_process(Role.relay, 0b1101)  // Upper 2 bits = 0b11 - invalid
        then is_sentinel(out[0]) == true
        and out[1] == true

    test relay_process_invalid_lo
        // The first draft set cmd = 0b0100 and then overrode it with 0b0111;
        // 0b0100 has legal lower bits (0b00), so the invalid case is 0b0111.
        given out = link_node_process(Role.relay, 0b0111)  // Lower 2 bits = 0b11 - invalid
        then is_sentinel(out[0]) == true
        and out[1] == true

    test validate_codeword_valid
        then validate_codeword(0b0101) == true  // Delimiter should pass

    test validate_codeword_invalid_hi
        then validate_codeword(0b1101) == false  // Upper bits invalid

    test validate_codeword_invalid_lo
        then validate_codeword(0b0100) == true   // This is actually valid, let me fix
        // Test actual invalid case
        then validate_codeword(0b0111) == false  // Lower bits invalid

    test jtag_shift_reply_format
        given config = jtag_config(3)
        and reply = 0xA
        then jtag_shift_reply(config, reply) == 0xA5A5A5AA

    test ternary_encode_simple
        then zero_dsp_ternary_encode(0) == 0
        and zero_dsp_ternary_encode(1) != 0
        and zero_dsp_ternary_encode(7) != 0

    // === Invariants ===

    invariant role_values_valid
        assert true  // Enum values are validated in tests

    invariant sentinel_value_constant
        assert SENTINEL_VALUE == 0b1111

    invariant codeword_bits_match
        assert CODEWORD_BITS == 4

    invariant data_word_bits_match
        assert DATA_WORD_BITS == 3

    invariant jtag_chain_positive
        assert JTAG_CHAIN_N > 0

    // === Benchmarks ===

    bench encoder_latency
        measure: nanoseconds to link_node_process(.encoder, 5)
        target: < 10ns

    bench decoder_latency  
        measure: nanoseconds to link_node_process(.decoder, 0b0101)
        target: < 50ns  // Decoder does exhaustive search

    bench relay_latency
        measure: nanoseconds to link_node_process(.relay, 0b0101)
        target: < 5ns

    bench validation_latency
        measure: nanoseconds to validate_codeword(0b0101)
        target: < 5ns
}

// phi^2 + 1/phi^2 = 3 | TRINITY