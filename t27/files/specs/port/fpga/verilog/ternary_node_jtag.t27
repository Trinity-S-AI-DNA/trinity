// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/fpga/verilog/ternary_node_jtag.t27
// IGLA-RACE ternary node JTAG test wrapper
// Ports exact additivity and non-triviality verification from Verilog
// Based on fpga/verilog/ternary_node_jtag.v
// phi^2 + 1/phi^2 = 3 | TRINITY

module ternary_node_jtag {

    // === Constants from original Verilog ===
    
    pub const JTAG_CHAIN_N : u32 = 3;
    
    // Test constants
    pub const KP : i32 = 12345;
    pub const KN : i32 = -987654321;
    
    // Weight sweep range
    pub const V_MIN : u32 = 0;
    pub const V_MAX : u32 = 7;
    
    // Live activation values (from original)
    pub const LIVE_A_INIT : i32 = 7;
    pub const LIVE_B_INIT : i32 = 11;
    
    // === State structures ===
    
    pub struct WeightState {
        v : u32,
        liveA : i32,
        liveB : i32,
    }
    
    pub struct TestState {
        swept : bool,
        add_ok : bool,
        moved : bool,
        sig : bool,
    }
    
    pub struct JtagOutput {
        version_nibble : u32,
        design_nibble : u32,
        add_ok : bool,
        moved : bool,
        swept : bool,
        padding : bool,
        beat : bool,
        ok : bool,
    }
    
    // === Constructor functions ===
    
    fn weight_state(v: u32, liveA: i32, liveB: i32) -> WeightState {
        return WeightState{
            .v = v,
            .liveA = liveA,
            .liveB = liveB,
        };
    }
    
    fn test_state() -> TestState {
        return TestState{
            .swept = false,
            .add_ok = true,
            .moved = false,
            .sig = false,
        };
    }
    
    fn jtag_output() -> JtagOutput {
        return JtagOutput{
            .version_nibble = 3,
            .design_nibble = 8,
            .add_ok = true,
            .moved = false,
            .swept = false,
            .padding = true,
            .beat = false,
            .ok = false,
        };
    }
    
    // === Helper functions ===
    
    fn compute_hi_lo(v: u32) -> (u32, u32) {
        // Original Verilog: hi = {6'b0, v[2], v[1]}; lo = {6'b0, v[1], v[0]};
        var v2 : u32 = (v >> 2) & 1;  // v[2]
        var v1 : u32 = (v >> 1) & 1;  // v[1] 
        var v0 : u32 = v & 1;         // v[0]
        
        var hi : u32 = (v2 << 1) | v1;  // {6'b0, v[2], v[1]} - effectively 2 bits
        var lo : u32 = (v1 << 1) | v0;  // {6'b0, v[1], v[0]} - effectively 2 bits
        
        return (hi, lo);
    }
    
    fn simulate_ternary_node(hi: u32, lo: u32, act_a: i32, act_b: i32, acc: i32) -> i32 {
        // This is a mock implementation since we don't have the actual IglaRaceTernaryNode
        // In the real implementation, this would call the actual ternary node logic
        // For testing purposes, we'll simulate some behavior
        var weighted : i32 = act_a + act_b + acc;
        return weighted;
    }
    
    // === Test logic functions ===
    
    fn test_additivity(r0: i32, rp: i32, rn: i32) -> bool {
        // Test exact additivity: rp == r0 + KP and rn == r0 + KN
        var add_ok : bool = true;
        if (rp != r0 + KP) {
            add_ok = false;
        }
        if (rn != r0 + KN) {
            add_ok = false;
        }
        return add_ok;
    }
    
    fn test_non_triviality(r0: i32) -> bool {
        // Test non-triviality: r0 != 0 for at least one symbol
        return r0 != 0;
    }
    
    fn update_test_state(state: TestState, v: u32, r0: i32, rp: i32, rn: i32) -> TestState {
        var new_state = state;
        
        if (!new_state.swept) {
            // Test additivity
            if (!test_additivity(r0, rp, rn)) {
                new_state.add_ok = false;
            }
            
            // Test non-triviality
            if (test_non_triviality(r0)) {
                new_state.moved = true;
            }
            
            // Check if sweep is complete
            if (v == V_MAX) {
                new_state.swept = true;
                new_state.sig = new_state.add_ok && 
                               (rp == r0 + KP) && 
                               (rn == r0 + KN) &&
                               (new_state.moved || (r0 != 0));
            }
        }
        
        return new_state;
    }
    
    fn next_weight_state(current: WeightState) -> WeightState {
        var next_v = current.v + 1;
        var next_liveA = current.liveA;
        var next_liveB = current.liveB;
        
        // Update live values when wrapping around from V_MAX to 0
        if (next_v > V_MAX) {
            next_v = 0;
            next_liveA = next_liveA + 1;
            next_liveB = next_liveB - 1;
        }
        
        return WeightState{
            .v = next_v,
            .liveA = next_liveA,
            .liveB = next_liveB,
        };
    }
    
    fn generate_jtag_output(state: TestState, beat: bool) -> JtagOutput {
        return JtagOutput{
            .version_nibble = 3,
            .design_nibble = 8,
            .add_ok = state.add_ok,
            .moved = state.moved,
            .swept = state.swept,
            .padding = true,
            .beat = beat,
            .ok = state.sig,
        };
    }
    
    fn jtag_to_word(output: JtagOutput) -> u32 {
        // Pack the JTAG output according to the original Verilog format:
        // {16'hA5A5, 4'd3, 6'd8, add_ok, moved, swept, 1'b1, beat, ok}
        var word : u32 = 0xA5A5 << 16;  // 16'hA5A5
        word = word | (3 << 12);        // 4'd3
        word = word | (8 << 6);         // 6'd8
        if (output.add_ok) word = word | (1 << 5);
        if (output.moved) word = word | (1 << 4);
        if (output.swept) word = word | (1 << 3);
        if (output.padding) word = word | (1 << 2);
        if (output.beat) word = word | (1 << 1);
        if (output.ok) word = word | (1 << 0);
        return word;
    }
    
    // === Main test functions ===
    
    fn run_ternary_test_cycle(v: u32, liveA: i32, liveB: i32, state: TestState) -> (TestState, i32, i32, i32) {
        var (hi, lo) = compute_hi_lo(v);
        
        // Simulate three instances of the ternary node
        var r0 = simulate_ternary_node(hi, lo, liveA, liveB, 0);
        var rp = simulate_ternary_node(hi, lo, liveA, liveB, KP);
        var rn = simulate_ternary_node(hi, lo, liveA, liveB, KN);
        
        var new_state = update_test_state(state, v, r0, rp, rn);
        
        return (new_state, r0, rp, rn);
    }
    
    fn run_complete_test() -> TestState {
        var state = test_state();
        var weight = weight_state(V_MIN, LIVE_A_INIT, LIVE_B_INIT);
        
        var v : u32 = V_MIN;
        while (v <= V_MAX) {
            var (new_state, _, _, _) = run_ternary_test_cycle(weight.v, weight.liveA, weight.liveB, state);
            state = new_state;
            weight = next_weight_state(weight);
            v = v + 1;
        }
        
        return state;
    }
    
    // === Tests ===
    
    test compute_hi_lo_values
        given (hi, lo) = compute_hi_lo(0b000)
        then hi == 0 and lo == 0
        
    test compute_hi_lo_values_1
        given (hi, lo) = compute_hi_lo(0b001)
        then hi == 0 and lo == 1
        
    test compute_hi_lo_values_2
        given (hi, lo) = compute_hi_lo(0b010)
        then hi == 1 and lo == 2
        
    test compute_hi_lo_values_3
        given (hi, lo) = compute_hi_lo(0b011)
        then hi == 1 and lo == 3
        
    test compute_hi_lo_values_4
        given (hi, lo) = compute_hi_lo(0b100)
        then hi == 2 and lo == 0
        
    test test_additivity_ok
        given add_ok = test_additivity(10, 10 + KP, 10 + KN)
        then add_ok == true
        
    test test_additivity_fail
        given add_ok = test_additivity(10, 999, 10 + KN)
        then add_ok == false
        
    test test_non_triviality_true
        given moved = test_non_triviality(42)
        then moved == true
        
    test test_non_triviality_false
        given moved = test_non_triviality(0)
        then moved == false
        
    test update_test_state_incomplete
        given state = test_state()
        given new_state = update_test_state(state, 0, 10, 10 + KP, 10 + KN)
        then new_state.swept == false
        and new_state.add_ok == true
        and new_state.moved == true
        
    test update_test_state_complete
        given state = test_state()
        given new_state = update_test_state(state, V_MAX, 10, 10 + KP, 10 + KN)
        then new_state.swept == true
        and new_state.sig == true
        
    test next_weight_state_increment
        given current = weight_state(3, 7, 11)
        given next = next_weight_state(current)
        then next.v == 4
        and next.liveA == 7
        and next.liveB == 11
        
    test next_weight_state_with_update
        given current = weight_state(V_MAX, 7, 11)
        given next = next_weight_state(current)
        then next.v == 0
        and next.liveA == 8
        and next.liveB == 10
        
    test generate_jtag_output_initial
        given state = test_state()
        given output = generate_jtag_output(state, false)
        then output.version_nibble == 3
        and output.design_nibble == 8
        and output.add_ok == true
        and output.moved == false
        and output.swept == false
        and output.ok == false
        
    test generate_jtag_output_complete
        given state = TestState{.swept = true, .add_ok = true, .moved = true, .sig = true}
        given output = generate_jtag_output(state, true)
        then output.ok == true
        and output.beat == true
        
    test jtag_to_word_format
        given output = JtagOutput{
            .version_nibble = 3,
            .design_nibble = 8,
            .add_ok = true,
            .moved = false,
            .swept = false,
            .padding = true,
            .beat = false,
            .ok = true,
        }
        given word = jtag_to_word(output)
        then (word >> 16) == 0xA5A5     // Upper 16 bits
        and ((word >> 12) & 0xF) == 3   // Version nibble at [15:12]
        and ((word >> 6) & 0x3F) == 8   // Design nibble at [11:6]
        and (word & 0x1) == 1           // OK bit at [0]
        
    test run_complete_test_additivity_holds
        given final_state = run_complete_test()
        then final_state.add_ok == true  // Assuming mock implementation passes
        
    test run_complete_test_non_triviality_holds
        given final_state = run_complete_test()
        then final_state.moved == true  // Assuming mock implementation produces non-zero results
        
    // === Integration tests ===
    
    test full_simulation_cycle
        given state = test_state()
        given weight = weight_state(0, LIVE_A_INIT, LIVE_B_INIT)
        given (new_state, r0, rp, rn) = run_ternary_test_cycle(0, LIVE_A_INIT, LIVE_B_INIT, state)
        then new_state.add_ok == true  // Initial state should pass
        and rp == r0 + KP              // Additivity should hold
        and rn == r0 + KN              // Additivity should hold
        
    test sweep_completes
        given final_state = run_complete_test()
        then final_state.swept == true
        and final_state.sig == true   // Both conditions should be met
        
    // === Invariants ===
    
    invariant weight_state_valid
        given ws = weight_state(5, 10, 20)
        assert ws.v <= V_MAX
        
    invariant test_state_boolean
        given ts = test_state()
        assert ts.add_ok == true or ts.add_ok == false
        assert ts.moved == true or ts.moved == false
        assert ts.swept == true or ts.swept == false
        assert ts.sig == true or ts.sig == false
        
    invariant jtag_output_valid
        given jo = jtag_output()
        assert jo.version_nibble == 3
        assert jo.design_nibble == 8
        
    invariant additivity_test_consistent
        given result1 = test_additivity(10, 10 + KP, 10 + KN)
        given result2 = test_additivity(10, 999, 10 + KN)
        assert result1 == true
        assert result2 == false
        
    invariant non_triviality_test_consistent
        given result1 = test_non_triviality(42)
        given result2 = test_non_triviality(0)
        assert result1 == true
        assert result2 == false
        
    // === Benchmarks ===
    
    bench compute_hi_lo_latency
        measure: nanoseconds to compute_hi_lo(0b101)
        target: < 10ns
        
    bench test_additivity_latency
        measure: nanoseconds to test_additivity(100, 100 + KP, 100 + KN)
        target: < 5ns
        
    bench test_non_triviality_latency
        measure: nanoseconds to test_non_triviality(42)
        target: < 5ns
        
    bench run_complete_test_latency
        measure: nanoseconds to run_complete_test()
        target: < 1000ns
}

// phi^2 + 1/phi^2 = 3 | TRINITY