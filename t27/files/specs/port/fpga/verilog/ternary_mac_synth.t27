module ternary_mac_top;

// Inputs and outputs are implicit: clk, rst_n, en, and the data ports from on_clock parameters and module-level var.

// Function to compute the multiplier from w_code
fn w_code_to_mult(w_code: [2]u8) -> i8 {
    if (w_code[0] == 0 && w_code[1] == 1) { return 1; }
    if (w_code[0] == 1 && w_code[1] == 0) { return -1; }
    return 0;
}

// Function to compute the product as a 32-bit signed integer
fn product(a: i8, w_code: [2]u8) -> i32 {
    return (a as i32) * (w_code_to_mult(w_code) as i32);
}

// Registered accumulator, exposed as an output data port.
var acc_out : i32 = 0

// The clocked process: a and w_code are streaming input data ports; acc_in is the input accumulator.
// Each cycle (while `en`) the product of a and w_code is added to acc_in and stored in acc_out.
fn on_clock(a: i8, w_code: [2]u8, acc_i: i32) {
            acc_out = acc_i + product(a, w_code)
        }

// Tests for the helper functions
test w_code_to_mult_plus {
    assert_eq(w_code_to_mult([0, 1]), 1);
}
test w_code_to_mult_minus {
    assert_eq(w_code_to_mult([1, 0]), -1);
}
test w_code_to_mult_zero {
    assert_eq(w_code_to_mult([0, 0]), 0);
    assert_eq(w_code_to_mult([1, 1]), 0);
}

test product_zero {
    assert_eq(product(0, [0, 0]), 0);
}
test product_pos {
    assert_eq(product(5, [0, 1]), 5);
}
test product_neg {
    assert_eq(product(5, [1, 0]), -5);
}
test product_neg_a {
    assert_eq(product(-5, [0, 1]), -5);
}
test product_neg_a_minus_w {
    assert_eq(product(-5, [1, 0]), 5);
}

// Test the on_clock function behavior
test on_clock_basic {
    // Initialize the accumulator (via reset) to 0
    // We simulate: reset -> then one clock cycle with en high
    // Note: in the test block, we can call on_clock directly to simulate a clock cycle.
    // First, we need to set the accumulator to a known state? 
    // The var acc_out is initially 0 (from the declaration).
    // Let's set acc_in to 10, a=2, w_code=[0, 1] (mult=1) -> product=2, so expected acc_out = 10+2=12.
    // We'll call on_clock and then check acc_out.
    // However, note that the test block runs in a simulation context and can access the module-level var.
    acc_out = 0; // reset to 0 (simulating reset)
    on_clock(2, [0, 1], 10);
    assert_eq(acc_out, 12);
}

test initial_value {
    assert_eq(acc_out, 0);
}

endmodule