// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/fpga/verilog/mvp_ternary_classifier_jtag_noport.t27
// MVP Ternary Classifier JTAG No-Port Module Specification
// Ports the original Verilog module to T27 for generation via t27c gen-verilog
// Based on gHashTag/t27 fpga/verilog/mvp_ternary_classifier_jtag_noport.v

module mvp_ternary_classifier_jtag_noport {

    // === Module parameter ===

    pub const JTAG_CHAIN_N : u32 = 3;
    pub const PRESCALE_BITS : u32 = 24;

    // === STARTUPE2 configuration ===

    pub struct StartupConfig {
        prog_usr : &str,
        sim_cclk_freq : f64,
    }

    fn startup_config() -> StartupConfig {
        return StartupConfig{
            .prog_usr = "FALSE",
            .sim_cclk_freq = 10.0,
        };
    }

    // === Check module interface (mvp_ternary_classifier_check) ===

    pub struct CheckOutputs {
        led_r23 : bool,
        led_t23 : bool,
    }

    // Derived signals from check outputs
    fn derive_ok_beat(outputs: CheckOutputs) -> (bool, bool) {
        let ok: bool = !outputs.led_t23;
        let beat: bool = outputs.led_r23;
        return (ok, beat);
    }

    // === JTAG USER3 shift register ===
    //
    // Protocol (USER3, IR = 0x22): 32-bit shift register clocked by DRCK.
    // On CAPTURE: loads verdict word
    //   [31:4] = 28-bit magic 0xA5A5A5A
    //   [3]    = constant 0
    //   [2]    = constant 1
    //   [1]    = beat (heartbeat)
    //   [0]    = ok (1 = all inputs classified correctly since power-up)
    // On SHIFT: walks out LSB first (tdo = sr[0], sr = {tdi, sr[31:1]})

    pub const MAGIC_28BIT : u32 = 0xA5A5A5Au32;
    pub const INITIAL_SR : u32 = 0xA5A5A5A4u32;  // {MAGIC_28BIT, 4'b0100}

    pub struct ClassifierShiftRegister {
        data : u32,
    }

    fn initial_shift_register() -> ClassifierShiftRegister {
        return ClassifierShiftRegister{
            .data = INITIAL_SR,
        };
    }

    fn capture_verdict_word(beat: bool, ok: bool) -> u32 {
        // {28'hA5A5A5A, 1'b0, 1'b1, beat, ok}
        let beat_bit: u32 = if (beat) 1u32 else 0u32;
        let ok_bit: u32 = if (ok) 1u32 else 0u32;
        return (MAGIC_28BIT << 4) | (0u32 << 3) | (1u32 << 2) | (beat_bit << 1) | ok_bit;
    }

    fn shift_register_capture(reg: ClassifierShiftRegister, beat: bool, ok: bool) -> ClassifierShiftRegister {
        return ClassifierShiftRegister{
            .data = capture_verdict_word(beat, ok),
        };
    }

    fn shift_register_shift(reg: ClassifierShiftRegister, tdi: bool) -> ClassifierShiftRegister {
        let tdi_bit: u32 = if (tdi) 0x80000000u32 else 0u32;
        let shifted: u32 = (reg.data >> 1) | tdi_bit;
        return ClassifierShiftRegister{
            .data = shifted,
        };
    }

    fn shift_register_tdo(reg: ClassifierShiftRegister) -> bool {
        return (reg.data & 1u32) != 0;
    }

    // === JTAG state machine ===

    pub struct JtagSignals {
        drck : bool,
        sel  : bool,
        shift: bool,
        capture: bool,
        tdi  : bool,
    }

    fn next_shift_register_and_tdo(
        reg: ClassifierShiftRegister,
        beat: bool,
        ok: bool,
        sig: JtagSignals
    ) -> (ClassifierShiftRegister, bool) {
        let tdo = shift_register_tdo(reg);
        
        if (sig.drck && sig.sel) {
            if (sig.capture) {
                return (shift_register_capture(reg, beat, ok), tdo);
            } else if (sig.shift) {
                return (shift_register_shift(reg, sig.tdi), tdo);
            } else {
                return (reg, tdo);
            }
        } else {
            return (reg, tdo);
        }
    }

    // === BSCANE2 configuration ===

    pub struct BscanConfig {
        jtag_chain : u32,
    }

    fn bscan_config() -> BscanConfig {
        return BscanConfig{
            .jtag_chain = JTAG_CHAIN_N,
        };
    }

    // === Tests ===

    test startup_config_defaults {
        let config = startup_config();
        assert(config.prog_usr == "FALSE");
        assert(config.sim_cclk_freq == 10.0);
    }

    test derive_ok_beat_from_leds {
        // led_r23 = true, led_t23 = false -> beat = true, ok = true
        let outputs = CheckOutputs{ .led_r23 = true, .led_t23 = false };
        let (ok, beat) = derive_ok_beat(outputs);
        assert(ok == true);
        assert(beat == true);

        // led_r23 = false, led_t23 = true -> beat = false, ok = false
        let outputs2 = CheckOutputs{ .led_r23 = false, .led_t23 = true };
        let (ok2, beat2) = derive_ok_beat(outputs2);
        assert(ok2 == false);
        assert(beat2 == false);

        // led_r23 = true, led_t23 = true -> beat = true, ok = false
        let outputs3 = CheckOutputs{ .led_r23 = true, .led_t23 = true };
        let (ok3, beat3) = derive_ok_beat(outputs3);
        assert(ok3 == false);
        assert(beat3 == true);
    }

    test capture_verdict_word_all_clear {
        // beat = true, ok = true
        // Expected: {28'hA5A5A5A, 1'b0, 1'b1, 1, 1} = 0xA5A5A5A7
        let word = capture_verdict_word(true, true);
        assert(word == 0xA5A5A5A7u32);
    }

    test capture_verdict_word_ok_false {
        // beat = false, ok = false
        // Expected: {28'hA5A5A5A, 1'b0, 1'b1, 0, 0} = 0xA5A5A5A4
        let word = capture_verdict_word(false, false);
        assert(word == 0xA5A5A5A4u32);
    }

    test capture_verdict_word_beat_false_ok_true {
        // beat = false, ok = true
        // Expected: {28'hA5A5A5A, 1'b0, 1'b1, 0, 1} = 0xA5A5A5A5
        let word = capture_verdict_word(false, true);
        assert(word == 0xA5A5A5A5u32);
    }

    test capture_verdict_word_beat_true_ok_false {
        // beat = true, ok = false
        // Expected: {28'hA5A5A5A, 1'b0, 1'b1, 1, 0} = 0xA5A5A5A6
        let word = capture_verdict_word(true, false);
        assert(word == 0xA5A5A5A6u32);
    }

    test initial_shift_register_value {
        let reg = initial_shift_register();
        assert(reg.data == INITIAL_SR);
        // Initial value has beat=0, ok=0 (LSBs = 0b0100 = 0x4)
        assert((reg.data & 0xFu32) == 0x4u32);
    }

    test shift_register_capture_updates_to_verdict {
        let reg = initial_shift_register();
        let beat = true;
        let ok = true;
        let new_reg = shift_register_capture(reg, beat, ok);
        assert(new_reg.data == 0xA5A5A5A7u32);
    }

    test shift_register_shift_with_tdi_high {
        let reg = ClassifierShiftRegister{ .data = 0x12345678u32 };
        let new_reg = shift_register_shift(reg, true);
        // {1, 0x12345678 >> 1} = {1, 0x091A2B3C} = 0x891A2B3C
        assert(new_reg.data == 0x891A2B3Cu32);
    }

    test shift_register_shift_with_tdi_low {
        let reg = ClassifierShiftRegister{ .data = 0x12345678u32 };
        let new_reg = shift_register_shift(reg, false);
        // {0, 0x12345678 >> 1} = 0x091A2B3C
        assert(new_reg.data == 0x091A2B3Cu32);
    }

    test shift_register_tdo_is_lsb {
        let reg0 = ClassifierShiftRegister{ .data = 0x12345678u32 }; // LSB = 0
        let reg1 = ClassifierShiftRegister{ .data = 0x12345679u32 }; // LSB = 1
        assert(shift_register_tdo(reg0) == false);
        assert(shift_register_tdo(reg1) == true);
    }

    test next_state_capture_cycle {
        let reg = initial_shift_register();
        let beat = true;
        let ok = true;
        let sig = JtagSignals{ .drck = true, .sel = true, .shift = false, .capture = true, .tdi = false };
        let (new_reg, tdo) = next_shift_register_and_tdo(reg, beat, ok, sig);
        assert(new_reg.data == 0xA5A5A5A7u32);
        // TDO is LSB of old reg (INITIAL_SR = 0xA5A5A5A4, LSB = 0)
        assert(tdo == false);
    }

    test next_state_shift_cycle {
        let reg = ClassifierShiftRegister{ .data = 0xA5A5A5A7u32 };
        let beat = false;
        let ok = false;
        let sig = JtagSignals{ .drck = true, .sel = true, .shift = true, .capture = false, .tdi = true };
        let (new_reg, tdo) = next_shift_register_and_tdo(reg, beat, ok, sig);
        // Shift with tdi=1: {1, 0xA5A5A5A7 >> 1} = 0xD2D2D2D3
        assert(new_reg.data == 0xD2D2D2D3u32);
        // TDO is LSB of old reg (0xA5A5A5A7, LSB = 1)
        assert(tdo == true);
    }

    test next_state_no_change_when_drck_low {
        let reg = ClassifierShiftRegister{ .data = 0xFFFFFFFFu32 };
        let beat = true;
        let ok = true;
        let sig = JtagSignals{ .drck = false, .sel = true, .shift = true, .capture = false, .tdi = true };
        let (new_reg, tdo) = next_shift_register_and_tdo(reg, beat, ok, sig);
        assert(new_reg.data == reg.data);
        assert(tdo == true);
    }

    test next_state_no_change_when_sel_low {
        let reg = ClassifierShiftRegister{ .data = 0xFFFFFFFFu32 };
        let beat = true;
        let ok = true;
        let sig = JtagSignals{ .drck = true, .sel = false, .shift = true, .capture = false, .tdi = true };
        let (new_reg, tdo) = next_shift_register_and_tdo(reg, beat, ok, sig);
        assert(new_reg.data == reg.data);
        assert(tdo == true);
    }

    test bscan_config_uses_parameter {
        let config = bscan_config();
        assert(config.jtag_chain == JTAG_CHAIN_N);
    }

    test magic_constant_width {
        // MAGIC_28BIT is 28 bits: 0xA5A5A5A = 28'hA5A5A5A
        assert(MAGIC_28BIT == 0xA5A5A5Au32);
        assert(MAGIC_28BIT <= 0xFFFFFFFu32); // fits in 28 bits
    }

    test initial_sr_construction {
        // INITIAL_SR = {MAGIC_28BIT, 4'b0100} = 0xA5A5A5A4
        let expected = (MAGIC_28BIT << 4) | 0x4u32;
        assert(INITIAL_SR == expected);
        assert(INITIAL_SR == 0xA5A5A5A4u32);
    }

    // === Invariants ===

    invariant capture_word_format_magic {
        // Capture word always has magic in upper 28 bits
        let w = capture_verdict_word(true, true);
        assert (w >> 4) == MAGIC_28BIT
    }

    invariant capture_word_format_bit3 {
        // Bit 3 is always 0
        let w = capture_verdict_word(true, true);
        assert ((w >> 3) & 1u32) == 0u32
    }

    invariant capture_word_format_bit2 {
        // Bit 2 is always 1
        let w = capture_verdict_word(true, true);
        assert ((w >> 2) & 1u32) == 1u32
    }

    invariant shift_register_32bit {
        let r = initial_shift_register();
        assert r.data <= 0xFFFFFFFFu32
    }

    invariant tdo_is_lsb {
        let r = initial_shift_register();
        assert shift_register_tdo(r) == ((r.data & 1u32) != 0)
    }

    invariant bscan_chain_parameter {
        assert JTAG_CHAIN_N == 3
    }
}