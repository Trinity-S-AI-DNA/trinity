// specs/port/fpga/verilog/dsp_probe.t27 -- port of the DSP48E1 probe design:
// one multiply computed by the hard DSP cell and by LUT logic, compared after
// a reset-and-count sequence. The original's 48-bit and 24-bit words are held
// in u64/u32 with masks, because the cast-target list has no u48/u24.

module dsp-probe {
    // Parameters
    const JTAG_CHAIN_N: u32 = 3;

    // Local parameters (constants)
    const A_VAL: u32 = 12345;      // [29:0], held in u32
    const B_VAL: u32 = 6789;       // [17:0]
    const EXPECT: u64 = 83810205;  // [47:0], held in u64

    // Module-level vars (registers)
    var p_lut: u64 = 0;
    var step: u8 = 0;
    var dsp_ok: bool = false;
    var lut_ok: bool = false;
    var agree: bool = false;
    var done: bool = false;
    var pre: u32 = 0;
    var beat: bool = false;
    var sr: u32 = 0xA5A5A5A0;

    // Combinatorial logic functions
    fn p_dsp() -> u64 {
        // DSP48E1: A_VAL * B_VAL (full precision)
        return (A_VAL as u64) * (B_VAL as u64);
    }

    fn p_lut_next() -> u64 {
        // LUT multiplication: lower 17 bits of A_VAL * lower 17 bits of B_VAL
        return ((A_VAL & 0x1FFFF) as u64) * ((B_VAL & 0x1FFFF) as u64);
    }

    // JTAG scan chain logic
    fn jtag_shift(sr_in: u32, tdi: bool, sel: bool, capture: bool, shift: bool) -> u32 {
        if (sel) {
            if (capture) {
                // Shift in status bits: {dsp_ok, lut_ok, agree, done}
                return (sr_in & 0xFFFFF000) |
                       ((dsp_ok as u32) << 3) |
                       ((lut_ok as u32) << 2) |
                       ((agree as u32) << 1) |
                       (done as u32);
            } else if (shift) {
                // Shift right, shift in tdi as MSB
                return (tdi as u32) << 31 | (sr_in >> 1);
            }
        }
        return sr_in;  // No change
    }

    // Clocked logic
    fn on_clock(cfgmclk: bool, rst_n: bool, en: bool) -> void {
        if (!rst_n) {
            // Reset values
            p_lut = 0;
            step = 0;
            dsp_ok = false;
            lut_ok = false;
            agree = false;
            done = false;
            pre = 0;
            beat = false;
            sr = 0xA5A5A5A0;
        } else if (en) {
            // p_lut update: A_VAL[16:0] * B_VAL[16:0]
            p_lut = p_lut_next();

            // Step counter and status update (when !done)
            if (!done) {
                step = step + 1;
                if (step == 32) {
                    dsp_ok = (p_dsp() == EXPECT);
                    lut_ok = (p_lut == EXPECT);
                    agree = (p_dsp() == p_lut);
                    done = true;
                }
            }

            // Beat signal: pre increments, beat toggles on wrap
            pre = pre + 1;
            if (pre == 0) {
                beat = !beat;
            }

            // JTAG shift register - this depends on drck, sel, etc.
            // These are inputs that come from the JTAG module
            // For now, we'll need to have them as parameters to on_clock
            // Actually, looking at the original, drck, sel, etc. are wires
            // that come from the BSCANE2 instance
        }
    }

    // Test functions
    test p_dsp_computation {
        assert(p_dsp() == EXPECT);
    }

    test p_lut_computation {
        // A_VAL[16:0] = 12345 & 0x1FFFF = 12345 (since 12345 < 2^16)
        // B_VAL[16:0] = 6789 & 0x1FFFF = 6789 (since 6789 < 2^16)
        // Product = 12345 * 6789 = 83810205
        assert(p_lut_next() == EXPECT);
    }
}
