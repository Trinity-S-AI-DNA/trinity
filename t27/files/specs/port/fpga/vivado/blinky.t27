// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/fpga/vivado/blinky.t27
// Blinky LED module specification for Trinity T27 FPGA HIR
// Ring oscillator with 20-inverter chain and 23-bit counter
// LED outputs derived from counter bits 20 and 19
// phi^2 + 1/phi^2 = 3 | TRINITY

module blinky {

    // === Module configuration ===

    pub const COUNTER_WIDTH : u32 = 23;
    pub const CHAIN_LENGTH : u32 = 20;
    pub const LED_R_BIT : u32 = 20;
    pub const LED_T_BIT : u32 = 19;

    // === State structures ===

    pub struct BlinkyState {
        counter : [COUNTER_WIDTH]u32,
        chain : [CHAIN_LENGTH]u32,
        osc_value : u32,
    }

    // === Constructor helpers ===

    fn initial_state() -> BlinkyState {
        var counter_array : [COUNTER_WIDTH]u32 = [_]u32{0} ** COUNTER_WIDTH;
        var chain_array : [CHAIN_LENGTH]u32 = [_]u32{0} ** CHAIN_LENGTH;
        
        return BlinkyState{
            .counter = counter_array,
            .chain = chain_array,
            .osc_value = 0,
        };
    }

    fn state_with_counter_bit(bit_index: u32, value: u32) -> BlinkyState {
        var counter_array : [COUNTER_WIDTH]u32 = [_]u32{0} ** COUNTER_WIDTH;
        if (bit_index < COUNTER_WIDTH) {
            counter_array[bit_index] = value;
        }
        
        return BlinkyState{
            .counter = counter_array,
            .chain = [_]u32{0} ** CHAIN_LENGTH,
            .osc_value = 0,
        };
    }

    // === LED output logic ===

    fn get_led_r(state: BlinkyState) -> u32 {
        // led_r23 = ~counter[20]
        if (LED_R_BIT < COUNTER_WIDTH) {
            return if (state.counter[LED_R_BIT] == 0) 1 else 0;
        }
        return 0;
    }

    fn get_led_t(state: BlinkyState) -> u32 {
        // led_t23 = ~counter[19]
        if (LED_T_BIT < COUNTER_WIDTH) {
            return if (state.counter[LED_T_BIT] == 0) 1 else 0;
        }
        return 0;
    }

    // === Tests ===

    test initial_state_empty
        given s = initial_state()
        then s.counter[0] == 0
        and s.chain[0] == 0
        and s.osc_value == 0

    test led_r_output
        given s = initial_state()
        then get_led_r(s) == 1  // ~0 = 1
        and get_led_t(s) == 1  // ~0 = 1

    test led_r_counter_bit_20
        given s = state_with_counter_bit(LED_R_BIT, 1)
        then get_led_r(s) == 0  // ~1 = 0

    test led_t_counter_bit_19
        given s = state_with_counter_bit(LED_T_BIT, 1)
        then get_led_t(s) == 0  // ~1 = 0

    // === Invariants ===

    invariant counter_width_positive
        given s = initial_state()
        assert COUNTER_WIDTH > 0

    invariant led_bit_indices_valid
        given s = initial_state()
        assert LED_R_BIT < COUNTER_WIDTH
        and LED_T_BIT < COUNTER_WIDTH

}