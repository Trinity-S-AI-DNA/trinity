module gf16_matmul4x4;

const DATA_WIDTH: u16 = 16;

struct MatrixInput {
    a00: u16, a01: u16, a02: u16, a03: u16,
    a10: u16, a11: u16, a12: u16, a13: u16,
    a20: u16, a21: u16, a22: u16, a23: u16,
    a30: u16, a31: u16, a32: u16, a33: u16,
    b00: u16, b01: u16, b02: u16, b03: u16,
    b10: u16, b11: u16, b12: u16, b13: u16,
    b20: u16, b21: u16, b22: u16, b23: u16,
    b30: u16, b31: u16, b32: u16, b33: u16
}

struct MatrixOutput {
    c00: u16, c01: u16, c02: u16, c03: u16,
    c10: u16, c11: u16, c12: u16, c13: u16,
    c20: u16, c21: u16, c22: u16, c23: u16,
    c30: u16, c31: u16, c32: u16, c33: u16
}

fn gf16_mul(x: u16, y: u16) -> u16 {
    // GF(2^4) multiplication with irreducible polynomial x^4 + x + 1 (0b10011)
    if (x == 0 || y == 0) {
        return 0;
    }
    
    var result: u16 = 0;
    var a: u16 = x;
    var b: u16 = y;
    
    for (i in 0..4) {
        if (b & 1 == 1) {
            result = gf16_add(result, a);
        }
        // Calculate next a: shift left and conditionally reduce
        if (a & 0x8000 != 0) {
            a = gf16_add(a << 1, 0x001b);
        } else {
            a = a << 1;
        }
        b = b >> 1;
    }
    
    return result;
}

fn gf16_add(x: u16, y: u16) -> u16 {
    return x ^ y; // Addition in GF(2^n) is XOR
}

fn dot_product(
    a0: u16, a1: u16, a2: u16, a3: u16,
    b0: u16, b1: u16, b2: u16, b3: u16
) -> u16 {
    return gf16_add(
        gf16_add(gf16_mul(a0, b0), gf16_mul(a1, b1)),
        gf16_add(gf16_mul(a2, b2), gf16_mul(a3, b3))
    );
}

fn multiply_matrices(input: MatrixInput) -> MatrixOutput {
    return MatrixOutput {
        c00: dot_product(input.a00, input.a01, input.a02, input.a03,
                         input.b00, input.b10, input.b20, input.b30),
        c01: dot_product(input.a00, input.a01, input.a02, input.a03,
                         input.b01, input.b11, input.b21, input.b31),
        c02: dot_product(input.a00, input.a01, input.a02, input.a03,
                         input.b02, input.b12, input.b22, input.b32),
        c03: dot_product(input.a00, input.a01, input.a02, input.a03,
                         input.b03, input.b13, input.b23, input.b33),
        c10: dot_product(input.a10, input.a11, input.a12, input.a13,
                         input.b00, input.b10, input.b20, input.b30),
        c11: dot_product(input.a10, input.a11, input.a12, input.a13,
                         input.b01, input.b11, input.b21, input.b31),
        c12: dot_product(input.a10, input.a11, input.a12, input.a13,
                         input.b02, input.b12, input.b22, input.b32),
        c13: dot_product(input.a10, input.a11, input.a12, input.a13,
                         input.b03, input.b13, input.b23, input.b33),
        c20: dot_product(input.a20, input.a21, input.a22, input.a23,
                         input.b00, input.b10, input.b20, input.b30),
        c21: dot_product(input.a20, input.a21, input.a22, input.a23,
                         input.b01, input.b11, input.b21, input.b31),
        c22: dot_product(input.a20, input.a21, input.a22, input.a23,
                         input.b02, input.b12, input.b22, input.b32),
        c23: dot_product(input.a20, input.a21, input.a22, input.a23,
                         input.b03, input.b13, input.b23, input.b33),
        c30: dot_product(input.a30, input.a31, input.a32, input.a33,
                         input.b00, input.b10, input.b20, input.b30),
        c31: dot_product(input.a30, input.a31, input.a32, input.a33,
                         input.b01, input.b11, input.b21, input.b31),
        c32: dot_product(input.a30, input.a31, input.a32, input.a33,
                         input.b02, input.b12, input.b22, input.b32),
        c33: dot_product(input.a30, input.a31, input.a32, input.a33,
                         input.b03, input.b13, input.b23, input.b33)
    };
}

// Helper functions to create test inputs
fn test_input_identity() -> MatrixInput {
    return MatrixInput {
        // Identity matrix for A
        a00: 0x0001, a01: 0x0000, a02: 0x0000, a03: 0x0000,
        a10: 0x0000, a11: 0x0001, a12: 0x0000, a13: 0x0000,
        a20: 0x0000, a21: 0x0000, a22: 0x0001, a23: 0x0000,
        a30: 0x0000, a31: 0x0000, a32: 0x0000, a33: 0x0001,
        // Identity matrix for B
        b00: 0x0001, b01: 0x0000, b02: 0x0000, b03: 0x0000,
        b10: 0x0000, b11: 0x0001, b12: 0x0000, b13: 0x0000,
        b20: 0x0000, b21: 0x0000, b22: 0x0001, b23: 0x0000,
        b30: 0x0000, b31: 0x0000, b32: 0x0000, b33: 0x0001
    };
}

fn test_input_zero_matrices() -> MatrixInput {
    return MatrixInput {
        a00: 0x0000, a01: 0x0000, a02: 0x0000, a03: 0x0000,
        a10: 0x0000, a11: 0x0000, a12: 0x0000, a13: 0x0000,
        a20: 0x0000, a21: 0x0000, a22: 0x0000, a23: 0x0000,
        a30: 0x0000, a31: 0x0000, a32: 0x0000, a33: 0x0000,
        b00: 0x0000, b01: 0x0000, b02: 0x0000, b03: 0x0000,
        b10: 0x0000, b11: 0x0000, b12: 0x0000, b13: 0x0000,
        b20: 0x0000, b21: 0x0000, b22: 0x0000, b23: 0x0000,
        b30: 0x0000, b31: 0x0000, b32: 0x0000, b33: 0x0000
    };
}

// === Tests ===

test multiply_by_zero {
    let input = test_input_zero_matrices();
    let result = multiply_matrices(input);
    assert(result.c00 == 0);
    assert(result.c01 == 0);
    assert(result.c02 == 0);
    assert(result.c03 == 0);
    assert(result.c10 == 0);
    assert(result.c11 == 0);
    assert(result.c12 == 0);
    assert(result.c13 == 0);
    assert(result.c20 == 0);
    assert(result.c21 == 0);
    assert(result.c22 == 0);
    assert(result.c23 == 0);
    assert(result.c30 == 0);
    assert(result.c31 == 0);
    assert(result.c32 == 0);
    assert(result.c33 == 0);
}

test multiply_identity {
    let input = test_input_identity();
    let result = multiply_matrices(input);
    // Identity * Identity = Identity
    assert(result.c00 == 0x0001);
    assert(result.c01 == 0x0000);
    assert(result.c02 == 0x0000);
    assert(result.c03 == 0x0000);
    assert(result.c10 == 0x0000);
    assert(result.c11 == 0x0001);
    assert(result.c12 == 0x0000);
    assert(result.c13 == 0x0000);
    assert(result.c20 == 0x0000);
    assert(result.c21 == 0x0000);
    assert(result.c22 == 0x0001);
    assert(result.c23 == 0x0000);
    assert(result.c30 == 0x0000);
    assert(result.c31 == 0x0000);
    assert(result.c32 == 0x0000);
    assert(result.c33 == 0x0001);
}