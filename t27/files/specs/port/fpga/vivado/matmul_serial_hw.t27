module matmul_serial_hw {

    // Constant A matrix (4x4) from original Verilog
    // a00=16'h3E00, a01=16'h4000, a02=16'h4100, a03=16'h4200
    // a10=16'h4300, a11=16'h4380, a12=16'h4400, a13=16'h4440
    // a20=16'h4480, a21=16'h44C0, a22=16'h4500, a23=16'h4520
    // a30=16'h4540, a31=16'h4560, a32=16'h4580, a33=16'h45A0
    pub const A00: u16 = 0x3E00;
    pub const A01: u16 = 0x4000;
    pub const A02: u16 = 0x4100;
    pub const A03: u16 = 0x4200;
    pub const A10: u16 = 0x4300;
    pub const A11: u16 = 0x4380;
    pub const A12: u16 = 0x4400;
    pub const A13: u16 = 0x4440;
    pub const A20: u16 = 0x4480;
    pub const A21: u16 = 0x44C0;
    pub const A22: u16 = 0x4500;
    pub const A23: u16 = 0x4520;
    pub const A30: u16 = 0x4540;
    pub const A31: u16 = 0x4560;
    pub const A32: u16 = 0x4580;
    pub const A33: u16 = 0x45A0;

    // B matrix is diagonal with 16'h3E00 on all diagonal elements
    pub const B_DIAG: u16 = 0x3E00;

    // State registers (initialized to 0 per FPGA config-time init)
    var sh: [16]u16 = [16]u16{0};
    var bitpos: u8 = 0;

    // Output registers
    var led_data: bool = false;
    var led_sync: bool = false;

    // First-cycle flag for initialization (simulates FPGA config-time init)
    var first: bool = true;

    // Placeholder GF(16) multiplication
    // Actual hardware uses gf16_matmul4x4 submodule; here we use regular multiplication
    // as a stand-in since the exact GF(16) field polynomial is not specified in this port.
    fn gf16_mul(a: u16, b: u16) -> u16 {
        // Placeholder: regular multiplication truncated to 16 bits
        // Real GF(16) multiplication would use the field polynomial
        return (a as u32 * b as u32) as u16;
    }

    // Placeholder GF(16) addition (XOR in GF(2^m))
    fn gf16_add(a: u16, b: u16) -> u16 {
        return a ^ b;
    }

    // Compute the 16-element result matrix C = A * B (diagonal B)
    // Since B is diagonal with B_DIAG on diagonal: C[i][j] = A[i][j] * B_DIAG (GF(16) mul)
    // Returns concatenated 256-bit result as [16]u16 array (c[0]..c[15])
    fn compute_result_matrix() -> [16]u16 {
        var c: [16]u16;
        c[0] = gf16_mul(A00, B_DIAG);
        c[1] = gf16_mul(A01, B_DIAG);
        c[2] = gf16_mul(A02, B_DIAG);
        c[3] = gf16_mul(A03, B_DIAG);
        c[4] = gf16_mul(A10, B_DIAG);
        c[5] = gf16_mul(A11, B_DIAG);
        c[6] = gf16_mul(A12, B_DIAG);
        c[7] = gf16_mul(A13, B_DIAG);
        c[8] = gf16_mul(A20, B_DIAG);
        c[9] = gf16_mul(A21, B_DIAG);
        c[10] = gf16_mul(A22, B_DIAG);
        c[11] = gf16_mul(A23, B_DIAG);
        c[12] = gf16_mul(A30, B_DIAG);
        c[13] = gf16_mul(A31, B_DIAG);
        c[14] = gf16_mul(A32, B_DIAG);
        c[15] = gf16_mul(A33, B_DIAG);
        return c;
    }

    // Clocked process: called on each rising edge of clk
    // No data inputs (only clk), updates state and outputs
    fn on_clock() {
        if (first) {
            // FPGA config-time initialization: sh=0, bitpos=0
            sh = [16]u16{0};
            bitpos = 0;
            led_data = false;
            led_sync = true; // bitpos == 0
            first = false;
        } else {
            // Output logic
            led_sync = (bitpos == 0);
            led_data = ((sh[0] >> 15) & 1) == 1;

            if (bitpos == 255) {
                // Load new result, reset bitpos
                sh = compute_result_matrix();
                bitpos = 0;
            } else {
                // Shift left by 1 across the 256-bit register (16 x u16)
                var carry: u16 = 0;
                var i: u8 = 15;
                while (true) {
                    var new_carry: u16 = (sh[i] >> 15) & 1;
                    sh[i] = (sh[i] << 1) | carry;
                    carry = new_carry;
                    if (i == 0) {
                        break;
                    }
                    i = i - 1;
                }
                bitpos = bitpos + 1;
            }
        }
    }

    // Helper: get current led_data output
    fn get_led_data() -> bool {
        return led_data;
    }

    // Helper: get current led_sync output
    fn get_led_sync() -> bool {
        return led_sync;
    }

    // ============================================================
    // Tests
    // ============================================================

    test gf16_mul_basic {
        // Placeholder multiplication: just verify it runs
        assert(gf16_mul(0, 0) == 0);
        assert(gf16_mul(1, 1) == 1);
        assert(gf16_mul(2, 3) == 6);
    }

    test gf16_add_basic {
        // GF(16) addition is XOR
        assert(gf16_add(0, 0) == 0);
        assert(gf16_add(5, 3) == 6); // 5 ^ 3 = 6
        assert(gf16_add(0xFFFF, 0xFFFF) == 0);
    }

    test compute_result_matrix_structure {
        // Verify the result matrix has 16 elements and uses the right A values
        var c = compute_result_matrix();
        // Each element should be A[i][j] * B_DIAG (placeholder mul)
        assert(c[0] == gf16_mul(A00, B_DIAG));
        assert(c[1] == gf16_mul(A01, B_DIAG));
        assert(c[2] == gf16_mul(A02, B_DIAG));
        assert(c[3] == gf16_mul(A03, B_DIAG));
        assert(c[15] == gf16_mul(A33, B_DIAG));
    }

    test initial_state {
        // Before first clock: sh=0, bitpos=0, first=true
        assert(bitpos == 0);
        assert(sh[0] == 0);
        assert(sh[15] == 0);
        assert(first == true);
    }

    test first_on_clock_outputs {
        // First call to on_clock initializes outputs per config-time init
        on_clock();
        assert(first == false);
        assert(led_sync == true);  // bitpos == 0
        assert(led_data == false); // sh[0] MSB is 0
        assert(bitpos == 0);
    }

    test on_clock_at_bitpos_0_produces_sync {
        // After first call, bitpos=0 so led_sync should be asserted
        on_clock(); // first call
        assert(led_sync == true);
        assert(bitpos == 0);
    }

    test on_clock_loads_result_at_255 {
        // Simulate running to bitpos=255 and verify reload
        // We can't easily run 255 cycles in a test, but we can test the logic
        // by manually setting bitpos and calling on_clock
        first = false;
        bitpos = 255;
        sh = [16]u16{0}; // current sh is all zeros
        on_clock();
        // At bitpos=255, should load result and reset bitpos to 0
        assert(bitpos == 0);
        var expected = compute_result_matrix();
        assert(sh[0] == expected[0]);
        assert(sh[15] == expected[15]);
    }

    test shift_left_logic {
        // Test the shift-left-by-1 across 16 u16 elements
        first = false;
        bitpos = 5; // not 255, so shift path
        // Set up a known pattern: sh[0]=0x8000 (MSB=1), rest=0
        sh = [16]u16{0};
        sh[0] = 0x8000;
        on_clock();
        // After shift: sh[0]=0x0000 (MSB shifted out), sh[1]=0x0001 (carry in)
        // Actually with MSB-first shift: 0x8000 << 1 = 0x0000 with carry=1
        // Next element gets carry as LSB
        assert(sh[0] == 0x0000);
        assert(sh[1] == 0x0001);
        for i in 2..16 {
            assert(sh[i] == 0);
        }
        assert(bitpos == 6);
    }

    test full_cycle_serialization {
        // Test that after loading result, serialization outputs bits correctly
        first = false;
        // Load result manually
        sh = compute_result_matrix();
        bitpos = 0;
        on_clock(); // bitpos=0 -> outputs sync, MSB of result
        assert(led_sync == true);
        var msb = (sh[0] >> 15) & 1;
        assert(led_data == (msb == 1));
        assert(bitpos == 1);
    }

    invariant bitpos_range {
        // bitpos should always be in 0..255
        assert(bitpos <= 255);
    }

    invariant shift_register_width {
        // sh should always have 16 elements
        assert(sh.len == 16);
    }

    invariant result_matrix_computable {
        // compute_result_matrix should always return 16 elements
        var c = compute_result_matrix();
        assert(c.len == 16);
    }
}