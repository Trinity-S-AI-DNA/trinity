module port::gen_w326;

/// Returns true if the wave number is the target wave (325) that should be processed.
pub fn is_target_wave(wave: i64) -> bool {
    return wave == 325;
}

/// Returns the next wave number.
pub fn next_wave(wave: i64) -> i64 {
    return wave + 1;
}

/// Returns the next depth value.
pub fn next_depth(depth: u32) -> u32 {
    return depth + 1;
}

/// Returns the next arrow Y value (the second number in X→Y).
pub fn next_arrow_y(y: u32) -> u32 {
    return y + 1;
}

/// Formats a depth value as a 3-digit zero-padded string suffix (e.g., 5 -> "005").
/// The caller constructs the full "depth_XXX" string.
pub fn format_depth_suffix(depth: u32) -> (u32, u32, u32) {
    const hundreds = depth / 100;
    const tens = (depth % 100) / 10;
    const ones = depth % 10;
    return (hundreds, tens, ones);
}

/// Formats an arrow transition as (Y→Y+1) components.
/// Returns (y, y_plus_1) for the caller to format.
pub fn format_arrow_transition(y: u32) -> (u32, u32) {
    return (y, y + 1);
}

/// Main entry point: reads a spec file, finds the last Wave Loop 325 block,
/// transforms it to Wave Loop 326, and appends it.
/// File I/O is plumbing; the decision logic lives in the pure helpers above.
pub fn append_w326(path: []const u8) {
    // Plumbing: read file, find matches, write file
    // Decision logic: is_target_wave, next_wave, next_depth, next_arrow_y
    return;
}

test is_target_wave_check {
    assert(is_target_wave(325));
    assert(!is_target_wave(324));
    assert(!is_target_wave(326));
    assert(!is_target_wave(0));
}

test next_wave_increment {
    assert(next_wave(325) == 326);
    assert(next_wave(0) == 1);
    assert(next_wave(-1) == 0);
}

test next_depth_increment {
    assert(next_depth(0) == 1);
    assert(next_depth(5) == 6);
    assert(next_depth(999) == 1000);
}

test next_arrow_y_increment {
    assert(next_arrow_y(0) == 1);
    assert(next_arrow_y(5) == 6);
    assert(next_arrow_y(99) == 100);
}

test format_depth_suffix_cases {
    const h1 = format_depth_suffix(0);
    assert(h1.0 == 0 and h1.1 == 0 and h1.2 == 0);
    const h2 = format_depth_suffix(5);
    assert(h2.0 == 0 and h2.1 == 0 and h2.2 == 5);
    const h3 = format_depth_suffix(42);
    assert(h3.0 == 0 and h3.1 == 4 and h3.2 == 2);
    const h4 = format_depth_suffix(123);
    assert(h4.0 == 1 and h4.1 == 2 and h4.2 == 3);
    const h5 = format_depth_suffix(999);
    assert(h5.0 == 9 and h5.1 == 9 and h5.2 == 9);
}

test format_arrow_transition_cases {
    const a1 = format_arrow_transition(0);
    assert(a1.0 == 0 and a1.1 == 1);
    const a2 = format_arrow_transition(5);
    assert(a2.0 == 5 and a2.1 == 6);
    const a3 = format_arrow_transition(10);
    assert(a3.0 == 10 and a3.1 == 11);
}