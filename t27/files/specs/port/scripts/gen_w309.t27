// t27/specs/port/scripts/gen_w309.t27
// Port of scripts/gen_w309.py to t27

// Batch append W309 tests and invariants to all IGLA specs: copy the last
// block (the last two tests plus the invariant that follows them), rewrite
// the wave suffix to _w309, and append the block back to the file it came
// from.
//
// WHAT THIS PORT DELIBERATELY DOES NOT CONTAIN
//
// The file system. The original walks two sorted globs, reads each spec
// with open() and appends the block back with a second open(), printing
// OK or SKIP per file. None of that decides anything - it moves bytes -
// so it stays in Python and the runtime's hands. What decided is here,
// and every test asserts one of these decisions:
//
// - get_last_block: which slice of a file is the block, or none
// - transform_block: which names the rewrite touches
// - spec_verdict: which marker a path earns

module port::scripts::gen_w309;

// The block the Python returns as lines[start:end], or None when the file
// has no recognizable block. No growable lists exist here, so the decision
// is the slice bounds plus whether a block was found at all.
pub struct BlockSpan {
    found: bool,
    start: usize,
    end: usize,
}

// Python: line.strip().startswith(prefix). Leading whitespace is skipped
// and the rest must carry the prefix from its first byte.
pub fn stripped_starts_with(line: []const u8, prefix: []const u8) -> bool {
    var lead: usize = 0;
    while (lead < line.len and (line[lead] == ' ' or line[lead] == '\t' or line[lead] == '\r' or line[lead] == '\n')) {
        lead += 1;
    }
    if (line.len - lead < prefix.len) {
        return false;
    }
    var at: usize = 0;
    while (at < prefix.len) {
        if (line[lead + at] != prefix[at]) {
            return false;
        }
        at += 1;
    }
    return true;
}

// Python: the block ends at the next line whose strip starts a new
// construct - test, invariant, fn, pub, comment, type or struct - or at
// end of file. Every prefix already implies a non-empty strip, so the
// empty-strip guard the original writes first is folded in here.
pub fn starts_new_construct(line: []const u8) -> bool {
    if (stripped_starts_with(line, "test ")) {
        return true;
    }
    if (stripped_starts_with(line, "invariant ")) {
        return true;
    }
    if (stripped_starts_with(line, "fn ")) {
        return true;
    }
    if (stripped_starts_with(line, "pub ")) {
        return true;
    }
    if (stripped_starts_with(line, "#")) {
        return true;
    }
    if (stripped_starts_with(line, "type ")) {
        return true;
    }
    if (stripped_starts_with(line, "struct ")) {
        return true;
    }
    return false;
}

// Python: needle in text. The rewrite's tests scan the rewritten buffer
// for the new suffix's presence and the old suffixes' absence. A plain
// helper, not part of the module's surface.
fn bytes_contain(haystack: []const u8, needle: []const u8) -> bool {
    if (needle.len == 0) {
        return true;
    }
    if (haystack.len < needle.len) {
        return false;
    }
    var i: usize = 0;
    while (i + needle.len <= haystack.len) {
        var matched: bool = true;
        var j: usize = 0;
        while (j < needle.len) {
            if (haystack[i + j] != needle[j]) {
                matched = false;
                break;
            }
            j += 1;
        }
        if (matched) {
            return true;
        }
        i += 1;
    }
    return false;
}

// Python: extract the last two tests plus the invariant that follows them
// from the end of the file, as lines[start:end], or None. The original
// checks twice - at least one test and one invariant anywhere, then two
// tests before the last invariant - and one check implies the other: a
// block needs the last invariant to exist and two tests above it. start
// is the second-to-last of those tests; end is the next construct start
// after the invariant, or the end of the file.
pub fn get_last_block(lines: []str) -> BlockSpan {
    var invariants: usize = 0;
    var last_inv_start: usize = 0;
    var last_inv_end: usize = 0;
    var idx: usize = 0;
    while (idx < lines.len) {
        if (stripped_starts_with(lines[idx], "invariant ")) {
            invariants += 1;
            last_inv_start = idx;
            last_inv_end = idx + 1;
        }
        idx += 1;
    }
    if (invariants == 0) {
        return BlockSpan { found: false, start: 0, end: 0 };
    }
    var test_count: usize = 0;
    var prev_test_start: usize = 0;
    var last_test_start: usize = 0;
    var walk: usize = 0;
    while (walk < last_inv_start) {
        if (stripped_starts_with(lines[walk], "test ")) {
            prev_test_start = last_test_start;
            last_test_start = walk;
            test_count += 1;
        }
        walk += 1;
    }
    if (test_count < 2) {
        return BlockSpan { found: false, start: 0, end: 0 };
    }
    var end: usize = lines.len;
    var scan: usize = last_inv_end;
    while (scan < lines.len) {
        if (starts_new_construct(lines[scan])) {
            end = scan;
            break;
        }
        scan += 1;
    }
    return BlockSpan { found: true, start: prev_test_start, end: end };
}

// Python: text.replace(from, to) for one same-length pair. The block
// arrives as a mutable byte buffer and the rewrite happens in place -
// _w308, _w307 and _w306 are all five bytes and _w309 is five, so the
// block's length never changes and no new string is built.
pub fn replace_wave_suffix(input: []u8, from: []const u8, to: []const u8) -> void {
    var i: usize = 0;
    while (i + from.len <= input.len) {
        var matched: bool = true;
        var j: usize = 0;
        while (j < from.len) {
            if (input[i + j] != from[j]) {
                matched = false;
                break;
            }
            j += 1;
        }
        if (matched) {
            var k: usize = 0;
            while (k < to.len) {
                input[i + k] = to[k];
                k += 1;
            }
            i += from.len;
        } else {
            i += 1;
        }
    }
}

// Python: the three text.replace calls that turn the copied block into a
// W309 block - _w308, _w307 and _w306 all become _w309. The joined text
// cannot be built here - no string building - so the block arrives as the
// buffer the caller filled and the rewrite is applied in place.
pub fn transform_block(block: []u8) -> void {
    replace_wave_suffix(block, "_w308", "_w309");
    replace_wave_suffix(block, "_w307", "_w309");
    replace_wave_suffix(block, "_w306", "_w309");
}

// Python: the skip gate inside process_specs - a file without a block is
// skipped, the rest are appended and reported with OK.
pub fn spec_verdict(block_found: bool) -> []const u8 {
    if (block_found) {
        return "OK";
    }
    return "SKIP";
}

// Python: process_specs walks two sorted globs, reads each spec, copies
// its last block, rewrites the wave suffix and appends the block back.
// Every one of those steps moves bytes: the globs, the file read, the
// append and the print. The decision it makes - which files earn an
// append rather than a SKIP - is spec_verdict above, and the rewrite it
// makes is transform_block above. This keeps the name and an undefined
// body, and no test calls it.
pub fn process_specs() {
    return;
}

test stripped_starts_with_skips_leading_space {
    assert(stripped_starts_with("test append_w308 {", "test "));
    assert(stripped_starts_with("    invariant indented {", "invariant "));
    assert(!stripped_starts_with("contest foo {", "test "));
    assert(!stripped_starts_with("testing_w308 {", "test "));
    assert(!stripped_starts_with("", "test "));
    assert(!stripped_starts_with("   ", "fn "));
}

test starts_new_construct_ends_the_block {
    assert(starts_new_construct("test next_w308 {"));
    assert(starts_new_construct("invariant inv_w308 {"));
    assert(starts_new_construct("fn helper() {"));
    assert(starts_new_construct("pub fn exported() {"));
    assert(starts_new_construct("# a comment ends the block"));
    assert(starts_new_construct("struct S {"));
    assert(starts_new_construct("type Alias = u8;"));
    assert(!starts_new_construct("    assert(x_w308());"));
    assert(!starts_new_construct("}"));
    assert(!starts_new_construct(""));
}

test get_last_block_copies_last_two_tests_plus_invariant {
    var lines: [12]str = ["fn helper() {", "}", "", "test first_w307 {", "    assert(first_w307());", "}", "", "test second_w308 {", "    assert(second_w308());", "}", "", "invariant inv_w308 holds {"];
    const span = get_last_block(&lines);
    assert(span.found);
    assert(span.start == 3);
    assert(span.end == 12);
}

test get_last_block_ends_at_next_construct {
    var lines: [9]str = ["test a_w306 {", "}", "test b_w307 {", "}", "invariant inv_w308 {", "    assert(x_w309());", "}", "", "fn next_thing() {"];
    const span = get_last_block(&lines);
    assert(span.found);
    assert(span.start == 0);
    assert(span.end == 8);
}

test get_last_block_uses_the_last_invariant {
    var lines: [8]str = ["test first_w306 {", "invariant early {", "}", "test second_w307 {", "}", "test third_w308 {", "}", "invariant last_w308 {"];
    const span = get_last_block(&lines);
    assert(span.found);
    assert(span.start == 3);
    assert(span.end == 8);
}

test get_last_block_needs_two_tests_before_the_invariant {
    var lines: [4]str = ["test only_w308 {", "}", "", "invariant inv_w308 {"];
    const span = get_last_block(&lines);
    assert(!span.found);
}

test get_last_block_needs_an_invariant {
    var lines: [3]str = ["test a_w308 {", "}", "test b_w308 {"];
    const span = get_last_block(&lines);
    assert(!span.found);
}

test get_last_block_needs_tests_above_the_invariant {
    var lines: [4]str = ["invariant early_w308 {", "}", "test a_w308 {", "}"];
    const span = get_last_block(&lines);
    assert(!span.found);
}

test replace_wave_suffix_rewrites_every_occurrence {
    var buf: [64]u8 = undefined;
    const src = "x_w307 first x_w307 second";
    var fill: usize = 0;
    while (fill < src.len) {
        buf[fill] = src[fill];
        fill += 1;
    }
    replace_wave_suffix(buf[0..src.len], "_w307", "_w309");
    assert(bytes_contain(buf[0..src.len], "_w309"));
    assert(!bytes_contain(buf[0..src.len], "_w307"));
}

test replace_wave_suffix_leaves_w309_alone {
    var buf: [32]u8 = undefined;
    const src = "x_w309 stays";
    var fill: usize = 0;
    while (fill < src.len) {
        buf[fill] = src[fill];
        fill += 1;
    }
    replace_wave_suffix(buf[0..src.len], "_w308", "_w309");
    replace_wave_suffix(buf[0..src.len], "_w307", "_w309");
    replace_wave_suffix(buf[0..src.len], "_w306", "_w309");
    assert(bytes_contain(buf[0..src.len], "_w309"));
    assert(bytes_contain(buf[0..src.len], "stays"));
}

test transform_block_rewrites_a_whole_block {
    var buf: [200]u8 = undefined;
    const src = "test append_w308 {\n    assert(append_w306());\n}\n\ninvariant seal_w307: true\n";
    var fill: usize = 0;
    while (fill < src.len) {
        buf[fill] = src[fill];
        fill += 1;
    }
    transform_block(buf[0..src.len]);
    assert(bytes_contain(buf[0..src.len], "_w309"));
    assert(!bytes_contain(buf[0..src.len], "_w308"));
    assert(!bytes_contain(buf[0..src.len], "_w307"));
    assert(!bytes_contain(buf[0..src.len], "_w306"));
}

test spec_verdict_ok_and_skip {
    assert(spec_verdict(true) == "OK");
    assert(spec_verdict(false) == "SKIP");
}
