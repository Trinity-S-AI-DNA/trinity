// specs/port/scripts/gen_w390.t27 -- port of scripts/gen_w390.py:
// wave_segments() finds the "// Wave Loop N" headers in a spec's text and
// returns one segment per header with its byte range. The host then appends
// the W390 blocks; append_w390 is stubbed, as in the sibling ports.
// The language has no regex or byte indexing, so the port reads one header
// per line and tracks the running byte offset.

module port-scripts;

pub const Segment = struct {
    wave: u32,
    start: u32,
    end: u32,
};

pub const Segments = struct {
    items: [100]Segment,
    len: u32,
};

// "// Wave Loop 389 some content" -- the wave number is the fourth token.
fn parse_wave(header: str) -> u32 {
    let parts = header.split(" ");
    if parts.len < 4 {
        return 0;
    }
    return parts[3].parse_u32().unwrap_or(0);
}

// One segment per "// Wave Loop N" header line; start/end are byte offsets of
// the header line and the next header line (or the end of the text).
pub fn wave_segments(text: str) -> Segments {
    var segs: Segments = undefined;
    segs.len = 0;
    var pos: u32 = 0;

    for line in text.lines() {
        let header = line.trim();
        if header.starts_with("// Wave Loop ") {
            let wave = parse_wave(header);
            if wave > 0 && segs.len < 100 {
                segs.items[segs.len] = Segment{
                    .wave = wave,
                    .start = pos,
                    .end = 0,
                };
                segs.len += 1;
            }
        }
        pos += line.len + 1;
    }

    // Close each segment at the next header's start, the last at text.len.
    var k: u32 = 0;
    while k + 1 < segs.len {
        segs.items[k].end = segs.items[k + 1].start;
        k += 1;
    }
    if segs.len > 0 {
        segs.items[segs.len - 1].end = text.len;
    }
    return segs;
}

// Stub: the host reads the file, rewrites the last W389 block and writes it
// back. The port cannot do host I/O.
pub fn append_w390(path: str) -> void {
    return;
}

test wave_segments_empty {
    const text = "";
    const segments = wave_segments(text);
    assert(segments.len == 0);
}

test wave_segments_single {
    const text = "// Wave Loop 389 some content here";
    const segments = wave_segments(text);
    assert(segments.len == 1);
    assert(segments.items[0].wave == 389);
    assert(segments.items[0].start == 0);
    assert(segments.items[0].end == text.len);
}

test wave_segments_multiple {
    const text = "// Wave Loop 100 first\n// Wave Loop 200 second";
    const segments = wave_segments(text);
    assert(segments.len == 2);
    assert(segments.items[0].wave == 100);
    assert(segments.items[0].start == 0);
    assert(segments.items[0].end == segments.items[1].start);
    assert(segments.items[1].wave == 200);
    assert(segments.items[1].end == text.len);
}
