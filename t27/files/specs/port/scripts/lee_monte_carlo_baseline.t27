module port::scripts::lee_monte_carlo_baseline;

// Port of scripts/lee_monte_carlo_baseline.py (gHashTag/t27 at e84927b600c6),
// 125 lines: the Monte Carlo baseline for LEE analysis. The two functions of
// the original keep their names and their decisions. The script's plumbing -
// loading research/lee-analysis/search_space_count.json, generating the
// random targets with numpy, printing, and writing monte_carlo_results.json -
// stays in Python and is not ported here.

// Line 26: the 0.1% criterion evaluate_expression tests against. It is the
// only Monte Carlo parameter the ported functions read.
const THRESHOLD: f64 = 0.001;

// np.sin and np.cos are third-party calls and .t27 has no math builtins, so
// the two trig candidates of the original are carried as Taylor series with
// range reduction into [-PI, PI]; eight terms keep the absolute error under
// 1e-5 over the whole range.
const PI: f64 = 3.141592653589793;
const TWO_PI: f64 = 6.283185307179586;
const NEG_PI: f64 = -3.141592653589793;

// Euler's number, the way the original's candidates mix phi, pi and e.
const EULER: f64 = 2.718281828459045;

// The target dicts of the original (lines 81-86): phi, pi, e and the value a
// candidate is compared against.
pub struct Target {
    phi: f64,
    pi: f64,
    e: f64,
    value: f64,
}

// Python's abs() for f64.
pub fn abs_f64(x: f64) -> f64 {
    if (x < 0.0) {
        return -x;
    }
    return x;
}

// np.sin, ported as a Taylor series around zero: sin(r) = r - r^3/3! +
// r^5/5! - ..., with r range-reduced into [-PI, PI] first.
pub fn sin(x: f64) -> f64 {
    var r: f64 = x;
    while (r > PI) {
        r -= TWO_PI;
    }
    while (r < NEG_PI) {
        r += TWO_PI;
    }
    const r2: f64 = r * r;
    return r * (1.0 - r2 / 6.0 + r2 * r2 / 120.0 - r2 * r2 * r2 / 5040.0 + r2 * r2 * r2 * r2 / 362880.0 - r2 * r2 * r2 * r2 * r2 / 39916800.0 + r2 * r2 * r2 * r2 * r2 * r2 / 6227020800.0 - r2 * r2 * r2 * r2 * r2 * r2 * r2 / 1307674368000.0);
}

// np.cos: cos(x) = sin(x + PI/2).
pub fn cos(x: f64) -> f64 {
    return sin(x + PI / 2.0);
}

// Line 29: evaluate if a Trinity formula matches the target within threshold.
// The Python version takes a callable (one of the candidate lambdas) plus the
// target dict and calls it; .t27 has no closures, so the candidate's value is
// computed by the caller and passed in as y_formula. The decision is the
// original's: relative error abs(y - value) / value against THRESHOLD, 1 on a
// hit, 0 otherwise.
pub fn evaluate_expression(y_formula: f64, target: Target) -> i32 {
    const error_mag: f64 = abs_f64(y_formula - target.value) / target.value;
    if (error_mag < THRESHOLD) {
        return 1;
    }
    return 0;
}

// Line 37: search the Trinity basis for matches within threshold. The Python
// version builds a list of ten candidate lambdas and counts the hits; .t27
// has no closures, so the candidates are enumerated inline, in the order of
// the original list (lines 40-53): sin(phi*pi), cos(phi*pi), phi/pi,
// phi*pi/e, phi*pi*e, phi^2, pi^2, e^2, phi^3, e^3.
pub fn search_trinity_basis(target: Target) -> i32 {
    var hits: i32 = 0;
    hits += evaluate_expression(sin(target.phi * target.pi), target);
    hits += evaluate_expression(cos(target.phi * target.pi), target);
    hits += evaluate_expression(target.phi / target.pi, target);
    hits += evaluate_expression(target.phi * target.pi / target.e, target);
    hits += evaluate_expression(target.phi * target.pi * target.e, target);
    hits += evaluate_expression(target.phi * target.phi, target);
    hits += evaluate_expression(target.pi * target.pi, target);
    hits += evaluate_expression(target.e * target.e, target);
    hits += evaluate_expression(target.phi * target.phi * target.phi, target);
    hits += evaluate_expression(target.e * target.e * target.e, target);
    return hits;
}

// The threshold decision of evaluate_expression: an exact hit, the strict
// boundary (the original uses <, so an error of exactly 0.001 is not a hit),
// just inside it, and outside it on the low side. value 1000.0 makes the
// boundary exact: 1.0 / 1000.0 rounds to the same f64 as the 0.001 literal.
test "the threshold decision, including the strict 0.001 boundary"
    const t: Target = Target { phi: 1.0, pi: PI, e: EULER, value: 1000.0 };
    assert(evaluate_expression(1000.0, t) == 1);
    assert(evaluate_expression(1001.0, t) == 0);
    assert(evaluate_expression(1000.999, t) == 1);
    assert(evaluate_expression(998.5, t) == 0);

// The hit counting of search_trinity_basis over the ten candidates. With phi
// = 1.0 and pi, e the mathematical constants, phi^2 and phi^3 are exact hits
// for value 1.0 and nothing else is within 0.1% of it; only pi^2 is an exact
// hit for value pi^2; nothing is within 0.1% of 3.5.
test "the hit counting over the ten candidates"
    const t1: Target = Target { phi: 1.0, pi: PI, e: EULER, value: 1.0 };
    assert(search_trinity_basis(t1) == 2);
    const v: f64 = PI * PI;
    const t2: Target = Target { phi: 1.0, pi: PI, e: EULER, value: v };
    assert(search_trinity_basis(t2) == 1);
    const t3: Target = Target { phi: 1.0, pi: PI, e: EULER, value: 3.5 };
    assert(search_trinity_basis(t3) == 0);

// The abs() the original applies to the error.
test "abs on both sides of zero"
    assert(abs_f64(2.5 - 1.0) == 1.5);
    assert(abs_f64(1.0 - 2.5) == 1.5);
    const neg: f64 = -3.0;
    assert(abs_f64(neg) == 3.0);
    assert(abs_f64(0.0) == 0.0);

// The ported trig helpers stand in for np.sin and np.cos: sin(0) is exactly
// 0, and the series stays within 1e-4 of the true values at the quarter
// points and the full turn.
test "the trig series tracks np.sin and np.cos within 1e-4"
    assert(sin(0.0) == 0.0);
    assert(abs_f64(sin(PI / 2.0) - 1.0) < 0.0001);
    assert(abs_f64(cos(0.0) - 1.0) < 0.0001);
    assert(abs_f64(cos(PI) + 1.0) < 0.0001);
    assert(abs_f64(sin(TWO_PI)) < 0.0001);
