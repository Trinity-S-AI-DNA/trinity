// SPDX-License-Identifier: Apache-2.0
// Port of scripts/aggregate-experience.sh (issue #5862).
// The script counts verdicts in episodes.jsonl, tracks the highest ring number and writes
// brain_summary.json and brain_domains.json. Reading the file, jq, date and the heredocs are
// plumbing; the decisions are the verdict class, the running maximum ring, the number of open
// rings, the queen health colour and the health score.
module aggregate_experience {
    const VERDICT_UNKNOWN: u32 = 0;
    const VERDICT_CLEAN: u32 = 1;
    const VERDICT_TOXIC: u32 = 2;
    const VERDICT_WEAK_CONFIRM: u32 = 3;
    const HEALTH_GREEN: u32 = 0;
    const HEALTH_YELLOW: u32 = 1;

    // verdict_class(is_clean, is_toxic, is_weak): the case statement; an unmatched verdict
    // is counted nowhere.
    fn verdict_class(is_clean: u32, is_toxic: u32, is_weak: u32) -> u32 {
        if (is_clean == 1) {
            return VERDICT_CLEAN;
        }
        if (is_toxic == 1) {
            return VERDICT_TOXIC;
        }
        if (is_weak == 1) {
            return VERDICT_WEAK_CONFIRM;
        }
        return VERDICT_UNKNOWN;
    }

    // next_last_ring(last_ring, ring): LAST_RING only moves up.
    fn next_last_ring(last_ring: u32, ring: u32) -> u32 {
        if (ring > last_ring) {
            return ring;
        }
        return last_ring;
    }

    // rings_open(last_ring, clean): $((LAST_RING - CLEAN)); bash arithmetic may go negative.
    fn rings_open(last_ring: i32, clean: i32) -> i32 {
        return last_ring - clean;
    }

    // queen_health(toxic): GREEN when no toxic verdict was seen, otherwise YELLOW.
    fn queen_health(toxic: u32) -> u32 {
        if (toxic == 0) {
            return HEALTH_GREEN;
        }
        return HEALTH_YELLOW;
    }

    // health_score(clean, last_ring): CLEAN / LAST_RING, or 1.0 when no ring was seen.
    fn health_score(clean: u32, last_ring: u32) -> f64 {
        if (last_ring == 0) {
            return 1.0;
        }
        return (clean as f64) / (last_ring as f64);
    }

    // Plumbing: reads episodes.jsonl and writes the two seal files; no test calls it.
    fn main() -> u32 {
        undefined;
    }

    test verdict_classes {
        assert(verdict_class(1, 0, 0) == 1);
        assert(verdict_class(0, 1, 0) == 2);
        assert(verdict_class(0, 0, 1) == 3);
        assert(verdict_class(0, 0, 0) == 0);
    }

    test last_ring_only_rises {
        assert(next_last_ring(5, 9) == 9);
        assert(next_last_ring(9, 5) == 9);
        assert(next_last_ring(9, 9) == 9);
    }

    test rings_open_counts {
        assert(rings_open(59, 50) == 9);
        assert(rings_open(3, 5) == -2);
    }

    test queen_health_colour {
        assert(queen_health(0) == 0);
        assert(queen_health(2) == 1);
    }

    test health_score_ratio {
        assert(health_score(0, 0) == 1.0);
        assert(health_score(3, 4) == 0.75);
        assert(health_score(0, 10) == 0.0);
    }
}
