// SPDX-License-Identifier: Apache-2.0
// Port of scripts/reseal-apply.sh (issue #6649).
// The script is the explicit "recertify now" action for the NMSE seal. Hashing, file I/O,
// the prompt and the two reseal steps are plumbing; the decisions are: whether the
// preconditions hold (exit 3), whether the read-only check already reports fresh (exit 0),
// whether the operator confirmed (RESEAL_YES=1, or a TTY and the answer "yes"; otherwise
// exit 1), whether regeneration failed (exit 2) and whether the re-verification is fresh
// (exit 0, else exit 2).
module reseal_apply {
    const EXIT_DONE: u32 = 0;
    const EXIT_DECLINED: u32 = 1;
    const EXIT_NOT_FRESH: u32 = 2;
    const EXIT_PRECONDITION: u32 = 3;

    // preconditions_exit(src_present, manifest_present): the source is checked first, then
    // the manifest; either one missing stops the script with exit 3, 255 means "go on".
    fn preconditions_exit(src_present: u32, manifest_present: u32) -> u32 {
        if (src_present == 0) {
            return EXIT_PRECONDITION;
        }
        if (manifest_present == 0) {
            return EXIT_PRECONDITION;
        }
        return 255;
    }

    // already_fresh(check_rc): the read-only checker exits 0 when the seal is fresh and the
    // script then has nothing to do.
    fn already_fresh(check_rc: u32) -> u32 {
        if (check_rc == 0) {
            return 1;
        }
        return 0;
    }

    // confirmed(reseal_yes, has_tty, answer_is_yes): RESEAL_YES=1 confirms without a prompt;
    // without it a missing TTY aborts, and with a TTY only the literal answer "yes" counts.
    fn confirmed(reseal_yes: u32, has_tty: u32, answer_is_yes: u32) -> u32 {
        if (reseal_yes == 1) {
            return 1;
        }
        if (has_tty == 0) {
            return 0;
        }
        if (answer_is_yes == 1) {
            return 1;
        }
        return 0;
    }

    // regen_exit(regen_ok): a failed `nmse_gf16.py --seal` ends the script with exit 2,
    // 255 means "go on to re-verify".
    fn regen_exit(regen_ok: u32) -> u32 {
        if (regen_ok == 0) {
            return EXIT_NOT_FRESH;
        }
        return 255;
    }

    // verify_exit(verify_rc): after the reseal the checker must report fresh (exit 0);
    // anything else asks for manual review (exit 2).
    fn verify_exit(verify_rc: u32) -> u32 {
        if (verify_rc == 0) {
            return EXIT_DONE;
        }
        return EXIT_NOT_FRESH;
    }

    // declined_exit(): the exit code when the operator did not confirm.
    fn declined_exit() -> u32 {
        return EXIT_DECLINED;
    }

    // Plumbing: runs the checker, refreezes FROZEN_HASH, regenerates the manifests and
    // prints the report; no test calls it.
    fn main() -> u32 {
        undefined;
    }

    test missing_source_or_manifest_is_exit_3 {
        assert(preconditions_exit(0, 1) == 3);
        assert(preconditions_exit(1, 0) == 3);
        assert(preconditions_exit(0, 0) == 3);
        assert(preconditions_exit(1, 1) == 255);
    }

    test fresh_seal_has_nothing_to_do {
        assert(already_fresh(0) == 1);
        assert(already_fresh(2) == 0);
        assert(already_fresh(3) == 0);
    }

    test reseal_yes_confirms_without_tty {
        assert(confirmed(1, 0, 0) == 1);
        assert(confirmed(1, 1, 0) == 1);
    }

    test no_tty_without_reseal_yes_aborts {
        assert(confirmed(0, 0, 1) == 0);
        assert(declined_exit() == 1);
    }

    test only_yes_answer_counts_on_a_tty {
        assert(confirmed(0, 1, 1) == 1);
        assert(confirmed(0, 1, 0) == 0);
    }

    test failed_regeneration_is_exit_2 {
        assert(regen_exit(0) == 2);
        assert(regen_exit(1) == 255);
    }

    test verification_must_be_fresh {
        assert(verify_exit(0) == 0);
        assert(verify_exit(2) == 2);
        assert(verify_exit(3) == 2);
    }
}
