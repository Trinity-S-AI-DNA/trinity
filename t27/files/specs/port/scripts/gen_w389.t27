module port::scripts::gen_w389;

struct WaveSegment {
    wave: i32,
    start: usize,
    end: usize,
}

struct WaveSegments {
    items: [32]WaveSegment,
    len: usize,
}

fn wave_segments(text: str) -> WaveSegments {
    var segments: WaveSegments = WaveSegments { items: [{ wave: 0, start: 0, end: 0 }; 32], len: 0 };
    var i: usize = 0;
    while (i < text.len) {
        // Check if we have "// Wave Loop " at position i
        if (i + 14 <= text.len) {
var j: usize = 0;
             var matches: bool = true;
             var prefix: str = "// Wave Loop ";
            while (j < 14) {
                if (text[i + j] != prefix[j]) {
                    matches = false;
                    break;
                }
                j += 1;
            }
            if (matches) {
                // Found prefix, now parse the number
                var num_start: usize = i + 14;
var num_end: usize = num_start;
                 while (num_end < text.len and text[num_end] >= '0' and text[num_end] <= '9') {
                    num_end += 1;
                }
                if (num_end > num_start) {
                    // We have a number
                    var wave_num: i32 = 0;
                    var k: usize = num_start;
                    while (k < num_end) {
                        wave_num = wave_num * 10 + (text[k] - '0' as i32);
                        k += 1;
                    }
                    var start_pos: usize = i;  // Start of the entire match
                    // Find end position: either start of next match or end of text
                    var end_pos: usize = text.len;
                    // Look for next match starting from num_end
                    var search_pos: usize = num_end;
                    while (search_pos < text.len) {
                        if (search_pos + 14 <= text.len) {
                            var k2: usize = 0;
                            var matches2: bool = true;
                            while (k2 < 14) {
                                if (text[search_pos + k2] != prefix[k2]) {
                                    matches2 = false;
                                    break;
                                }
                                k2 += 1;
                            }
                            if (matches2) {
                                end_pos = search_pos;
                                break;
                            }
                        }
                        search_pos += 1;
                    }
                    // Add segment
                    if (segments.len < 32) {
                        segments.items[segments.len] = WaveSegment { wave: wave_num, start: start_pos, end: end_pos };
                        segments.len += 1;
                    }
                    // Continue searching after this match
                    i = end_pos;
                    continue;
                }
            }
        }
        i += 1;
    }
    return segments;
}

fn append_w389(path: str) {
    undefined;
}

test wave_segments_empty {
    const text: str = "";
    const segments = wave_segments(text);
    assert(segments.len == 0);
}

test wave_segments_no_matches {
    const text: str = "This is some text\nwith no special markers.\n";
    const segments = wave_segments(text);
    assert(segments.len == 0);
}

test wave_segments_single_match {
    const text: str = "Before\n// Wave Loop 100\nAfter";
    const segments = wave_segments(text);
    assert(segments.len == 1);
    assert(segments.items[0].wave == 100);
    // start should be at the "//"
    assert(segments.items[0].start == 7); // "Before\n" is 7 chars
    // end should be at end of text
    assert(segments.items[0].end == text.len);
}

test wave_segments_two_matches {
    const text: str = "// Wave Loop 5\nMiddle\n// Wave Loop 10\nEnd";
    const segments = wave_segments(text);
    assert(segments.len == 2);
    assert(segments.items[0].wave == 5);
    assert(segments.items[1].wave == 10);
    // First segment: start at 0, end at start of second segment
    assert(segments.items[0].start == 0);
    assert(segments.items[0].end == 15); // "// Wave Loop 5\n" is 15 chars
    // Second segment: start at 15, end at end of text
    assert(segments.items[1].start == 15);
    assert(segments.items[1].end == text.len);
}