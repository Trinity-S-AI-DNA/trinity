// Helper function to copy a string into a buffer
fn copy_string(buffer: []u8, index: usize, text: []const u8) -> usize {
    var i: usize = 0;
    while (i < text.len) {
        if (index + i < buffer.len) {
            buffer[index + i] = text[i];
        }
        i += 1;
    }
    return text.len;
}



