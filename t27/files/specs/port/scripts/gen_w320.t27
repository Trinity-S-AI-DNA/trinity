test get_last_block_basic {
    const test_input = "test one {\n    assert(true);\n}\ninvariant {\n    true;\n}";
    const result = get_last_block(test_input);
    assert(result == null);
}

test get_last_block_with_invariant {
    const test_input = "test one {\n    assert(true);\n}\ntest two {\n    assert(false);\n}\ninvariant {\n    true;\n}";
    const result = get_last_block(test_input);
    assert(result == null);
}

test transform_block_replacement {
    const test_input = "test w319 {\n    assert(true);\n}";
    const result = transform_block(test_input);
    assert(result.len == test_input.len);
    assert(result[0] == 't');
}