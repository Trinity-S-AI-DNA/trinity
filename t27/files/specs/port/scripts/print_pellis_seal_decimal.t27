module port::print_pellis_seal_decimal;

pub fn calculate_sqrt5() -> f64 {
    const sqrt_val = 2.23606797749979; // Precomputed sqrt(5)
    return sqrt_val;
}

pub fn calculate_phi(sqrt5: f64) -> f64 {
    return (1.0 + sqrt5) / 2.0;
}

pub fn calculate_pellis(phi: f64) -> f64 {
    const term1 = 360.0 / (phi * phi);
    const term2 = 2.0 / (phi * phi * phi);
    const term3 = 1.0 / ((3.0 * phi) * (3.0 * phi) * (3.0 * phi) * (3.0 * phi) * (3.0 * phi));
    return term1 - term2 + term3;
}

pub fn main() -> i32 {
    undefined;
}

test calculate_sqrt5_test {
    const sqrt5 = calculate_sqrt5();
    assert(sqrt5 > 2.236 && sqrt5 < 2.237);
}

test calculate_phi_test {
    const sqrt5 = calculate_sqrt5();
    const phi = calculate_phi(sqrt5);
    assert(phi > 1.618 && phi < 1.619);
}

test calculate_pellis_test {
    const sqrt5 = calculate_sqrt5();
    const phi = calculate_phi(sqrt5);
    const pellis = calculate_pellis(phi);
    assert(pellis > 137.0 && pellis < 138.0);
}

test calculate_pellis_known_values {
    const sqrt5 = calculate_sqrt5();
    const phi = calculate_phi(sqrt5);
    const pellis = calculate_pellis(phi);
    assert(pellis > 137.0 && pellis < 138.0);
}