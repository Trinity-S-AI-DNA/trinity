// specs/port/scripts/gen_w366.t27 -- port of scripts/gen_w366.py: the host
// finds the last "// Wave Loop 365" block of a spec, rewrites it to 366 and
// appends it. The port keeps the pure parts -- wave-number extraction, the
// header predicate, the contains/transform helpers -- in the supported
// subset; the file rewrite is host work and stays stubbed.

module gen-w366;

pub const FindResult = struct {
    start: u32,
    end: u32,
    wave: u32,
};

// "// Wave Loop 389" -- the wave number is the fourth token.
pub fn extract_wave_number(line: str) -> i32 {
    let prefix = "// Wave Loop ";
    if !line.starts_with(prefix) {
        return 0;
    }
    let parts = line.split(" ");
    if parts.len < 4 {
        return 0;
    }
    return parts[3].parse_u32().unwrap_or(0) as i32;
}

// True when the line starts with the wave-loop header.
pub fn is_wave_loop_line(line: str) -> bool {
    return line.starts_with("// Wave Loop ");
}

// Stub of the host's byte-offset scan: the last "// Wave Loop 365" block's
// span. Without byte indexing the port reports no match.
pub fn find_last_wave_365(text: str) -> FindResult {
    return FindResult{ start = 0, end = 0, wave = 0 };
}

// The pure transform: 365 -> 366 in a block, and the seal note.
pub fn transform_w365_to_w366(block: str) -> str {
    var out = block.replace("Wave Loop 365", "Wave Loop 366");
    out = out.replace("w365", "w366");
    out = out.replace("W365", "W366");
    return out;
}

// Stub: the host reads and writes the file.
pub fn append_w366(path: str) -> void {
    return;
}

test extract_wave_number_basic {
    assert(extract_wave_number("// Wave Loop 365 some content") == 365);
}

test extract_wave_number_edge_cases {
    assert(extract_wave_number("not a header") == 0);
    assert(extract_wave_number("// Wave Loop ") == 0);
}

test is_wave_loop_line_cases {
    assert(is_wave_loop_line("// Wave Loop 365"));
    assert(!is_wave_loop_line("// WaveLoop 365"));
    assert(!is_wave_loop_line("  // Wave Loop 365"));
}

test transform_rewrites_the_wave_number {
    const block = "// Wave Loop 365: w365 seal";
    const out = transform_w365_to_w366(block);
    assert(out.contains("Wave Loop 366"));
    assert(out.contains("w366"));
    assert(!out.contains("w365"));
}

test find_last_wave_365_is_a_stub {
    const r = find_last_wave_365("// Wave Loop 365");
    assert(r.wave == 0);
}
