    const test_branch2: []const u8 = "feat/ring-052-lotus-automation";
    const test_branch3: []const u8 = "feat/ring-053-property-test";
    
    // Verify the function exists and can be called
    const status1 = is_branch_merged(test_branch1, "master");
    const status2 = is_branch_merged(test_branch2, "master");
    const status3 = is_branch_merged(test_branch3, "master");
}

