module port::scripts::install_constitutional_hook;

pub fn main(script_dir: []const u8) -> ([]const u8, []const u8, []const u8) {
    // Remove trailing slash if present
    var dir = script_dir;
    if (dir.len > 0 && dir[dir.len-1] == '/') {
        dir = dir[0..dir.len-1];
    }

    // Find the last slash
    var i: usize = 0;
    var j: usize = 0;
    while (j < dir.len) {
        if (dir[j] == '/') {
            i = j;
        }
        j += 1;
    }

    // Now i is the index of the last slash.
    const root = dir[0..i];
    const suffix = ".git/hooks/pre-commit";
    const hook_content = "#!/bin/sh\nset -e\ncd \"\\\"$(git rev-parse --show-toplevel)/bootstrap\\\"\" && cargo build -q\n";

    return (root, suffix, hook_content);
}

test main_no_trailing_slash {
    const script_dir: []const u8 = "/home/user/project/scripts";
    const (root, suffix, content) = main(script_dir);
    assert(root == "/home/user/project");
    assert(suffix == ".git/hooks/pre-commit");
    assert(content == "#!/bin/sh\nset -e\ncd \"\\\"$(git rev-parse --show-toplevel)/bootstrap\\\"\" && cargo build -q\n");
}

test main_with_trailing_slash {
    const script_dir: []const u8 = "/home/user/project/scripts/";
    const (root, suffix, content) = main(script_dir);
    assert(root == "/home/user/project");
    assert(suffix == ".git/hooks/pre-commit");
    assert(content == "#!/bin/sh\nset -e\ncd \"\\\"$(git rev-parse --show-toplevel)/bootstrap\\\"\" && cargo build -q\n");
}