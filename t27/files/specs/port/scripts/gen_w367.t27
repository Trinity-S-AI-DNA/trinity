module port::scripts::gen_w367;

struct WaveLoopBlock {
    wave: i32,
    full_block: []const u8,
    start_pos: usize,
    end_pos: usize,
}

struct WaveLoopBlocks {
    items: [32]WaveLoopBlock,
    len: usize,
}

pub fn find_wave_loop_blocks(text: []const u8) -> WaveLoopBlocks {
    var blocks = WaveLoopBlocks { items: [_]WaveLoopBlock{undefined} ** 32, len: 0 };
    var i: usize = 0;
    while (i < text.len) {
        const wave_prefix = "// Wave Loop ";
        if (i + wave_prefix.len <= text.len) {
            var match = true;
            var j: usize = 0;
            while (j < wave_prefix.len) {
                if (text[i + j] != wave_prefix[j]) {
                    match = false;
                    break;
                }
                j += 1;
            }
            if (match) {
                var wave_start = i + wave_prefix.len;
                var wave_end = wave_start;
                while (wave_end < text.len and text[wave_end] >= '0' and text[wave_end] <= '9') {
                    wave_end += 1;
                }
                if (wave_end > wave_start) {
                    var wave_num: i32 = 0;
                    var k = wave_start;
                    while (k < wave_end) {
                        wave_num = wave_num * 10 + (text[k] - '0') as i32;
                        k += 1;
                    }
                    var block_end = wave_end;
                    while (block_end < text.len and text[block_end] != '\n') {
                        block_end += 1;
                    }
                    if (block_end < text.len) {
                        block_end += 1;
                    }
                    var invariant_start = block_end;
                    var invariant_end = invariant_start;
                    while (invariant_end < text.len) {
                        if (invariant_end + 8 <= text.len) {
                            var inv_match = true;
                            var m: usize = 0;
                            while (m < 8) {
                                if (text[invariant_end + m] != "invariant"[m]) {
                                    inv_match = false;
                                    break;
                                }
                                m += 1;
                            }
                            if (inv_match) {
                                while (invariant_end < text.len and text[invariant_end] != '\n') {
                                    invariant_end += 1;
                                }
                                if (invariant_end < text.len) {
                                    invariant_end += 1;
                                }
                                break;
                            }
                        }
                        invariant_end += 1;
                        if (invariant_end > invariant_start + 200) {
                            break;
                        }
                    }
                    if (invariant_end > invariant_start) {
                        const full_len = invariant_end - i;
                        _ = full_len;
                        if (blocks.len < 32) {
                            blocks.items[blocks.len] = WaveLoopBlock {
                                wave: wave_num,
                                full_block: text[i..invariant_end],
                                start_pos: i,
                                end_pos: invariant_end,
                            };
                            blocks.len += 1;
                        }
                        i = invariant_end;
                        continue;
                    }
                }
            }
        }
        i += 1;
    }
    return blocks;
}

pub fn generate_w367_block(w366_block: []const u8) -> [512]u8 {
    var result: [512]u8 = undefined;
    var out_idx: usize = 0;
    var in_idx: usize = 0;
    while (in_idx < w366_block.len and out_idx < 511) {
        if (in_idx + 14 <= w366_block.len) {
            var match = true;
            var m: usize = 0;
            while (m < 14) {
                if (w366_block[in_idx + m] != "Wave Loop 366"[m]) {
                    match = false;
                    break;
                }
                m += 1;
            }
            if (match) {
                var repl = "Wave Loop 367";
                var r: usize = 0;
                while (r < repl.len and out_idx < 511) {
                    result[out_idx] = repl[r];
                    out_idx += 1;
                    r += 1;
                }
                in_idx += 14;
                continue;
            }
        }
        if (in_idx + 6 <= w366_block.len) {
            var match = true;
            var m: usize = 0;
            while (m < 6) {
                if (w366_block[in_idx + m] != "w366_"[m]) {
                    match = false;
                    break;
                }
                m += 1;
            }
            if (match) {
                var repl = "w367_";
                var r: usize = 0;
                while (r < repl.len and out_idx < 511) {
                    result[out_idx] = repl[r];
                    out_idx += 1;
                    r += 1;
                }
                in_idx += 6;
                continue;
            }
        }
        if (in_idx + 22 <= w366_block.len) {
            var match = true;
            var m: usize = 0;
            while (m < 22) {
                if (w366_block[in_idx + m] != "W365 seal regeneration"[m]) {
                    match = false;
                    break;
                }
                m += 1;
            }
            if (match) {
                var repl = "W366 seal regeneration";
                var r: usize = 0;
                while (r < repl.len and out_idx < 511) {
                    result[out_idx] = repl[r];
                    out_idx += 1;
                    r += 1;
                }
                in_idx += 22;
                continue;
            }
        }
        if (in_idx + 10 <= w366_block.len) {
            var match = true;
            var m: usize = 0;
            while (m < 10) {
                if (w366_block[in_idx + m] != "after W365"[m]) {
                    match = false;
                    break;
                }
                m += 1;
            }
            if (match) {
                var repl = "after W366";
                var r: usize = 0;
                while (r < repl.len and out_idx < 511) {
                    result[out_idx] = repl[r];
                    out_idx += 1;
                    r += 1;
                }
                in_idx += 10;
                continue;
            }
        }
        if (in_idx + 28 <= w366_block.len) {
            var match = true;
            var m: usize = 0;
            while (m < 28) {
                if (w366_block[in_idx + m] != "WAVE_LOOP_365_COOPERATION.md"[m]) {
                    match = false;
                    break;
                }
                m += 1;
            }
            if (match) {
                var repl = "WAVE_LOOP_366_COOPERATION.md";
                var r: usize = 0;
                while (r < repl.len and out_idx < 511) {
                    result[out_idx] = repl[r];
                    out_idx += 1;
                    r += 1;
                }
                in_idx += 28;
                continue;
            }
        }
        result[out_idx] = w366_block[in_idx];
        out_idx += 1;
        in_idx += 1;
    }
    result[out_idx] = 0;
    return result;
}

pub fn insert_block_at(text: []const u8, insert_pos: usize, new_block: []const u8) -> [2048]u8 {
    var result: [2048]u8 = undefined;
    var out_idx: usize = 0;
    var i: usize = 0;
    while (i < text.len and out_idx < 2047) {
        if (i == insert_pos) {
            var j: usize = 0;
            while (j < new_block.len and new_block[j] != 0 and out_idx < 2047) {
                result[out_idx] = new_block[j];
                out_idx += 1;
                j += 1;
            }
        }
        result[out_idx] = text[i];
        out_idx += 1;
        i += 1;
    }
    if (insert_pos >= text.len and out_idx < 2047) {
        var j: usize = 0;
        while (j < new_block.len and new_block[j] != 0 and out_idx < 2047) {
            result[out_idx] = new_block[j];
            out_idx += 1;
            j += 1;
        }
    }
    result[out_idx] = 0;
    return result;
}

fn slices_equal(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) {
        return false;
    }
    var i: usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn find_substring(haystack: []const u8, needle: []const u8) -> ?usize {
    if (needle.len == 0) {
        return 0;
    }
    if (haystack.len < needle.len) {
        return null;
    }
    var i: usize = 0;
    while (i <= haystack.len - needle.len) {
        var match = true;
        var j: usize = 0;
        while (j < needle.len) {
            if (haystack[i + j] != needle[j]) {
                match = false;
                break;
            }
            j += 1;
        }
        if (match) {
            return i;
        }
        i += 1;
    }
    return null;
}

pub fn append_w367(path: []const u8) -> void {
    undefined;
}

test find_wave_loop_blocks_single {
    const text = "// Wave Loop 366\ninvariant w366_test true\n";
    const blocks = find_wave_loop_blocks(text);
    assert(blocks.len == 1);
    assert(blocks.items[0].wave == 366);
    assert(slices_equal(blocks.items[0].full_block, "// Wave Loop 366\ninvariant w366_test true\n"));
    assert(blocks.items[0].start_pos == 0);
    assert(blocks.items[0].end_pos == text.len);
}

test find_wave_loop_blocks_multiple {
    const text = "// Wave Loop 365\ninvariant w365_a true\n// Wave Loop 366\ninvariant w366_b true\n";
    const blocks = find_wave_loop_blocks(text);
    assert(blocks.len == 2);
    assert(blocks.items[0].wave == 365);
    assert(blocks.items[1].wave == 366);
    assert(blocks.items[1].start_pos > blocks.items[0].start_pos);
}

test find_wave_loop_blocks_none {
    const text = "no wave loops here\njust regular text\n";
    const blocks = find_wave_loop_blocks(text);
    assert(blocks.len == 0);
}

test generate_w367_block_replacements {
    const w366 = "// Wave Loop 366\ninvariant w366_seal W365 seal regeneration after W365 WAVE_LOOP_365_COOPERATION.md true\n";
    const w367_arr = generate_w367_block(w366);
    const w367 = &w367_arr;
    assert(find_substring(w367, "Wave Loop 367") != null);
    assert(find_substring(w367, "w367_") != null);
    assert(find_substring(w367, "W366 seal regeneration") != null);
    assert(find_substring(w367, "after W366") != null);
    assert(find_substring(w367, "WAVE_LOOP_366_COOPERATION.md") != null);
    assert(find_substring(w367, "Wave Loop 366") == null);
    assert(find_substring(w367, "w366_") == null);
    assert(find_substring(w367, "W365 seal regeneration") == null);
    assert(find_substring(w367, "after W365") == null);
    assert(find_substring(w367, "WAVE_LOOP_365_COOPERATION.md") == null);
}

test insert_block_at_middle {
    const text = "before\nmiddle\nafter\n";
    const new_block = "INSERTED\n";
    const result_arr = insert_block_at(text, 7, new_block);
    const result = &result_arr;
    assert(find_substring(result, "before\n") == 0);
    assert(find_substring(result, "INSERTED\n") != null);
    assert(find_substring(result, "middle\nafter\n") != null);
}

test insert_block_at_end {
    const text = "before\n";
    const new_block = "APPENDED\n";
    const result_arr = insert_block_at(text, text.len, new_block);
    const result = &result_arr;
    assert(find_substring(result, "before\nAPPENDED\n") == 0);
}

test find_substring_basic {
    assert(find_substring("hello world", "world") == 6);
    assert(find_substring("hello world", "hello") == 0);
    assert(find_substring("hello world", "xyz") == null);
    assert(find_substring("aaa", "aa") == 0);
    assert(find_substring("", "a") == null);
    assert(find_substring("a", "") == 0);
}

test slices_equal_basic {
    assert(slices_equal("hello", "hello"));
    assert(!slices_equal("hello", "world"));
    assert(!slices_equal("hello", "hell"));
    assert(slices_equal("", ""));
}