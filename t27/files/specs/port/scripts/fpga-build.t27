// SPDX-License-Identifier: Apache-2.0
// Port of scripts/fpga-build.sh (issue #5842).
// The script builds a bitstream with yosys, nextpnr-xilinx, fasm2frames and xc7frames2bit,
// then deletes the 20,000-line .frames and .fasm intermediates. Running the tools, reading
// the environment and printing are plumbing; the decisions are the toolchain preflight
// (exit 1), the known-bad-primitive guard (exit 2) and the frames-count guard (exit 3).
module fpga_build {
    const EXIT_OK: u32 = 0;
    const EXIT_NO_TOOLCHAIN: u32 = 1;
    const EXIT_BAD_PRIMITIVE: u32 = 2;
    const EXIT_FEW_FRAMES: u32 = 3;
    const MIN_FRAMES: u32 = 100;

    // toolchain_ok(root_set, pnr_set, vpy_set, xr_set): the script refuses to run when
    // T27_OPENXC7 is empty AND at least one of PNR, VPY, XR is empty too.
    fn toolchain_ok(root_set: u32, pnr_set: u32, vpy_set: u32, xr_set: u32) -> u32 {
        if (root_set == 1) {
            return 1;
        }
        if (pnr_set == 1 and vpy_set == 1 and xr_set == 1) {
            return 1;
        }
        return 0;
    }

    // frames_ok(frame_lines): fewer than 100 frame lines means the bitstream is wrong.
    fn frames_ok(frame_lines: u32) -> u32 {
        if (frame_lines < MIN_FRAMES) {
            return 0;
        }
        return 1;
    }

    // verdict(toolchain, yostat_clean, frame_lines): the exit code of the script, checked
    // in the order the script runs its stages.
    fn verdict(toolchain: u32, yostat_clean: u32, frame_lines: u32) -> u32 {
        if (toolchain == 0) {
            return EXIT_NO_TOOLCHAIN;
        }
        if (yostat_clean == 0) {
            return EXIT_BAD_PRIMITIVE;
        }
        if (frames_ok(frame_lines) == 0) {
            return EXIT_FEW_FRAMES;
        }
        return EXIT_OK;
    }

    // Plumbing: runs yosys, nextpnr, fasm2frames and xc7frames2bit and removes the
    // intermediates; no test calls it.
    fn main() -> u32 {
        undefined;
    }

    test toolchain_root_alone_is_enough {
        assert(toolchain_ok(1, 0, 0, 0) == 1);
    }

    test toolchain_needs_all_three_without_root {
        assert(toolchain_ok(0, 1, 1, 1) == 1);
        assert(toolchain_ok(0, 1, 1, 0) == 0);
        assert(toolchain_ok(0, 0, 0, 0) == 0);
    }

    test frames_guard_threshold {
        assert(frames_ok(99) == 0);
        assert(frames_ok(100) == 1);
        assert(frames_ok(20000) == 1);
    }

    test verdict_exit_codes {
        assert(verdict(0, 1, 500) == 1);
        assert(verdict(1, 0, 500) == 2);
        assert(verdict(1, 1, 40) == 3);
        assert(verdict(1, 1, 500) == 0);
    }

    test verdict_stage_order {
        assert(verdict(0, 0, 0) == 1);
        assert(verdict(1, 0, 0) == 2);
    }
}
