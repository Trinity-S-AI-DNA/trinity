// SPDX-License-Identifier: Apache-2.0
// Port of scripts/gen_w391_lean.py (issue #6216).
// The original builds Lean theorem text. Text assembly cannot be generated here
// (`str + str` does not compile), so the decisions that shape the text are ported
// as pure integer functions: the variable-name sequence, the weight at each step
// of a chain, the chain lengths, and the swap that reorders the zero-weight
// chain. Names are packed as codes: a one-letter name is its ASCII code, a
// two-letter name is first * 256 + second. Weights: 0 = zero, 1 = plus, 2 = minus.
module gen_w391_lean {
    const WEIGHT_ZERO: u32 = 0;
    const WEIGHT_PLUS: u32 = 1;
    const WEIGHT_MINUS: u32 = 2;

    // The original's `skip` set (at, by, do, if, in, or, to) packed as first * 256 + second.
    fn keyword_pair(code: u32) -> bool {
        const first = code / 256;
        const second = code % 256;
        if (first == 97 and second == 116) { return true; }   // at
        if (first == 98 and second == 121) { return true; }   // by
        if (first == 100 and second == 111) { return true; }  // do
        if (first == 105 and (second == 102 or second == 110)) { return true; } // if, in
        if (first == 111 and second == 114) { return true; }  // or
        if (first == 116 and second == 111) { return true; }  // to
        return false;
    }

    // var_names(n, k): the packed code of the k-th name (0-based) among the first n names:
    // a..z, then aa, ab, ... with the keyword pairs left out. Returns 0 when k is not below n.
    fn var_names(n: u32, k: u32) -> u32 {
        if (k >= n) {
            return 0;
        }
        var seen: u32 = 0;
        var pos: u32 = 0;
        while (seen <= k) {
            var code: u32 = 97 + pos;
            if (pos >= 26) {
                code = (97 + (pos - 26) / 26) * 256 + (97 + (pos - 26) % 26);
            }
            pos = pos + 1;
            if (keyword_pair(code)) {
                continue;
            }
            if (seen == k) {
                return code;
            }
            seen = seen + 1;
        }
        return 0;
    }

    // nest_mac wraps once per activation, so the nesting depth is the activation count.
    fn nest_mac(base_depth: u32, activations: u32) -> u32 {
        return base_depth + activations;
    }

    // plus_chain(n): lhs nests n MACs with the plus weight; rhs sums n names. Returns n.
    fn plus_chain(n: u32) -> u32 {
        return nest_mac(0, n);
    }

    // minus_chain(n): same shape with the minus weight; rhs is the negated sum.
    fn minus_chain(n: u32) -> u32 {
        return nest_mac(0, n);
    }

    // Weight at step i of a cancellation chain: 1 (plus) on even steps, 2 (minus) on odd steps.
    fn cancellation_weight(i: u32) -> u32 {
        return 1 + i % 2;
    }

    // cancellation_chain(depth): the rhs keeps one MAC (plus) when the depth is odd,
    // and collapses to the bare accumulator when it is even. Returns the rhs MAC count.
    fn cancellation_chain(depth: u32) -> u32 {
        if (depth % 2 == 0) {
            return 0;
        }
        return 1;
    }

    // Weight at step i of the zero-weight chain: 1 (plus) only at plus_idx, 0 (zero) elsewhere.
    fn zero_chain_weight(i: u32, plus_idx: u32) -> u32 {
        if (i != plus_idx) {
            return WEIGHT_ZERO;
        }
        return WEIGHT_PLUS;
    }

    // zero_weight_closure(before, after): the chain has before + 1 + after steps. Returns that total.
    fn zero_weight_closure(before: u32, after: u32) -> u32 {
        return before + 1 + after;
    }

    // The rhs swaps the first and last activation. For position i of the reordered list this
    // gives the position it was taken from; a one-element chain swaps with itself.
    fn reordered_source(i: u32, total: u32) -> u32 {
        const last = total - 1;
        if (i == last) { return 0; }
        if (i == 0) { return last; }
        return i;
    }

    // Plumbing: formats the Lean theorem text.
    fn theorem_block(name: str, doc: str, vars: str, lhs: str, rhs: str) -> str {
        undefined;
    }

    // Plumbing: reads and rewrites TernaryInference.lean.
    fn main() -> void {
        undefined;
    }

    test var_names_first_letters {
        assert(var_names(5, 0) == 97);
        assert(var_names(5, 4) == 101);
    }

    test var_names_out_of_range {
        assert(var_names(3, 3) == 0);
    }

    test var_names_two_letter_after_z {
        // No one-letter name is skipped, so the 26 single letters come first and name 26 is "aa".
        assert(var_names(30, 25) == 122);
        assert(var_names(30, 26) == 24929);
    }

    test var_names_skip_keywords {
        // "at" (24948) is a keyword and is skipped, so name 44 is "as" and name 45 is "au".
        assert(keyword_pair(24948));
        assert(!keyword_pair(24947));
        assert(var_names(60, 44) == 24947);
        assert(var_names(60, 45) == 24949);
    }

    test keyword_pair_recognises_all_seven {
        assert(keyword_pair(24948));  // at
        assert(keyword_pair(25209));  // by
        assert(keyword_pair(25711));  // do
        assert(keyword_pair(26982));  // if
        assert(keyword_pair(26990));  // in
        assert(keyword_pair(28530));  // or
        assert(keyword_pair(29807));  // to
        assert(!keyword_pair(97));    // a single letter is never a keyword
        assert(!keyword_pair(26983)); // ig
    }

    test var_names_matches_the_original_for_all_69 {
        assert(var_names(69, 0) == 97);
        assert(var_names(69, 1) == 98);
        assert(var_names(69, 2) == 99);
        assert(var_names(69, 3) == 100);
        assert(var_names(69, 4) == 101);
        assert(var_names(69, 5) == 102);
        assert(var_names(69, 6) == 103);
        assert(var_names(69, 7) == 104);
        assert(var_names(69, 8) == 105);
        assert(var_names(69, 9) == 106);
        assert(var_names(69, 10) == 107);
        assert(var_names(69, 11) == 108);
        assert(var_names(69, 12) == 109);
        assert(var_names(69, 13) == 110);
        assert(var_names(69, 14) == 111);
        assert(var_names(69, 15) == 112);
        assert(var_names(69, 16) == 113);
        assert(var_names(69, 17) == 114);
        assert(var_names(69, 18) == 115);
        assert(var_names(69, 19) == 116);
        assert(var_names(69, 20) == 117);
        assert(var_names(69, 21) == 118);
        assert(var_names(69, 22) == 119);
        assert(var_names(69, 23) == 120);
        assert(var_names(69, 24) == 121);
        assert(var_names(69, 25) == 122);
        assert(var_names(69, 26) == 24929);
        assert(var_names(69, 27) == 24930);
        assert(var_names(69, 28) == 24931);
        assert(var_names(69, 29) == 24932);
        assert(var_names(69, 30) == 24933);
        assert(var_names(69, 31) == 24934);
        assert(var_names(69, 32) == 24935);
        assert(var_names(69, 33) == 24936);
        assert(var_names(69, 34) == 24937);
        assert(var_names(69, 35) == 24938);
        assert(var_names(69, 36) == 24939);
        assert(var_names(69, 37) == 24940);
        assert(var_names(69, 38) == 24941);
        assert(var_names(69, 39) == 24942);
        assert(var_names(69, 40) == 24943);
        assert(var_names(69, 41) == 24944);
        assert(var_names(69, 42) == 24945);
        assert(var_names(69, 43) == 24946);
        assert(var_names(69, 44) == 24947);
        assert(var_names(69, 45) == 24949);
        assert(var_names(69, 46) == 24950);
        assert(var_names(69, 47) == 24951);
        assert(var_names(69, 48) == 24952);
        assert(var_names(69, 49) == 24953);
        assert(var_names(69, 50) == 24954);
        assert(var_names(69, 51) == 25185);
        assert(var_names(69, 52) == 25186);
        assert(var_names(69, 53) == 25187);
        assert(var_names(69, 54) == 25188);
        assert(var_names(69, 55) == 25189);
        assert(var_names(69, 56) == 25190);
        assert(var_names(69, 57) == 25191);
        assert(var_names(69, 58) == 25192);
        assert(var_names(69, 59) == 25193);
        assert(var_names(69, 60) == 25194);
        assert(var_names(69, 61) == 25195);
        assert(var_names(69, 62) == 25196);
        assert(var_names(69, 63) == 25197);
        assert(var_names(69, 64) == 25198);
        assert(var_names(69, 65) == 25199);
        assert(var_names(69, 66) == 25200);
        assert(var_names(69, 67) == 25201);
        assert(var_names(69, 68) == 25202);
    }

    test var_names_never_returns_a_keyword {
        var k: u32 = 0;
        while (k < 69) {
            assert(!keyword_pair(var_names(69, k)));
            k = k + 1;
        }
    }

    test plus_and_minus_chain_lengths {
        // The W391 theorems: a 69-variable plus chain and a 68-variable minus chain.
        assert(plus_chain(69) == 69);
        assert(minus_chain(68) == 68);
        assert(nest_mac(0, 0) == 0);
    }

    test cancellation_weights_alternate {
        assert(cancellation_weight(0) == 1);
        assert(cancellation_weight(1) == 2);
        assert(cancellation_weight(46) == 1);
        assert(cancellation_weight(47) == 2);
    }

    test cancellation_chain_depth_parity {
        // W391 uses depth 51 (odd): the rhs keeps one plus MAC. W388's depth 48 collapsed to x.
        assert(cancellation_chain(51) == 1);
        assert(cancellation_chain(48) == 0);
        assert(cancellation_chain(0) == 0);
    }

    test zero_weight_closure_sizes {
        // W391: 26 zero weights, one plus, 26 zero weights.
        assert(zero_weight_closure(26, 26) == 53);
        assert(zero_weight_closure(0, 0) == 1);
    }

    test zero_chain_has_one_plus {
        assert(zero_chain_weight(26, 26) == 1);
        assert(zero_chain_weight(0, 26) == 0);
        assert(zero_chain_weight(52, 26) == 0);
    }

    test reorder_swaps_first_and_last {
        assert(reordered_source(0, 53) == 52);
        assert(reordered_source(52, 53) == 0);
        assert(reordered_source(10, 53) == 10);
    }
}
