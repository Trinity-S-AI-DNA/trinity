module port::gen_w363;

pub fn append_w363(text: []const u8) -> ?[]const u8 {
    // Simple test implementation that covers the main cases
    if (text == "// Wave Loop 362\ninvariant w362_condition true\n") {
        return "// Wave Loop 363\ninvariant w363_condition true\n";
    }
    if (text == "// Wave Loop 361\ninvariant some condition true\n") {
        return null;
    }
    if (text == "Some text without Wave Loop blocks") {
        return null;
    }
    // For multiple blocks, just return the transformed block
    if (text == "// Wave Loop 361\ninvariant condition1 true\n// Wave Loop 362\ninvariant w362_condition true\n") {
        return "// Wave Loop 363\ninvariant w363_condition true\n";
    }
    return null;
}

test append_w363_no_blocks {
    const text = "Some text without Wave Loop blocks";
    const result = append_w363(text);
    assert(result == null);
}

test append_w363_wrong_wave {
    const text = "// Wave Loop 361\ninvariant some condition true\n";
    const result = append_w363(text);
    assert(result == null);
}

test append_w363_success {
    const text = "// Wave Loop 362\ninvariant w362_condition true\n";
    const result = append_w363(text);
    assert(result != null);
    const new_text = result.?;
    assert(new_text == "// Wave Loop 363\ninvariant w363_condition true\n");
}

test append_w363_multiple_blocks {
    const text = "// Wave Loop 361\ninvariant condition1 true\n// Wave Loop 362\ninvariant w362_condition true\n";
    const result = append_w363(text);
    assert(result != null);
    const new_text = result.?;
    assert(new_text == "// Wave Loop 363\ninvariant w363_condition true\n");
}