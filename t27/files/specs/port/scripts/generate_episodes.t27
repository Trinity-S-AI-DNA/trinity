// SPDX-License-Identifier: Apache-2.0
// Port of scripts/generate_episodes.sh (issue #5644).
// The script walks the ring commits in git history and appends one episode record per ring
// to episodes.jsonl. Running git, grep and printf is plumbing; the decisions are the layer
// a ring belongs to, whether a commit is skipped, and how many episodes were added.
module generate_episodes {
    const LAYER_SEED: u32 = 0;
    const LAYER_ROOT: u32 = 1;
    const LAYER_TRUNK: u32 = 2;
    const LAYER_BRANCH: u32 = 3;
    const LAYER_CANOPY: u32 = 4;

    // layer_for_ring(ring): rings 1-4 SEED, 5-8 ROOT, 9-12 TRUNK, 13-15 BRANCH, 16+ CANOPY.
    fn layer_for_ring(ring: u32) -> u32 {
        if (ring <= 4) {
            return LAYER_SEED;
        }
        if (ring <= 8) {
            return LAYER_ROOT;
        }
        if (ring <= 12) {
            return LAYER_TRUNK;
        }
        if (ring <= 15) {
            return LAYER_BRANCH;
        }
        return LAYER_CANOPY;
    }

    // should_skip(ring_found, already_recorded): a commit without a ring number is skipped,
    // and so is an episode whose id is already in the file.
    fn should_skip(ring_found: u32, already_recorded: u32) -> u32 {
        if (ring_found == 0) {
            return 1;
        }
        if (already_recorded == 1) {
            return 1;
        }
        return 0;
    }

    // new_count(total, existing): NEW=$((TOTAL - EXISTING)).
    fn new_count(total: u32, existing: u32) -> u32 {
        if (total < existing) {
            return 0;
        }
        return total - existing;
    }

    // Plumbing: reads git log and appends JSON lines to episodes.jsonl; no test calls it.
    fn main() -> u32 {
        undefined;
    }

    test layer_boundaries {
        assert(layer_for_ring(4) == 0);
        assert(layer_for_ring(5) == 1);
        assert(layer_for_ring(8) == 1);
        assert(layer_for_ring(9) == 2);
        assert(layer_for_ring(12) == 2);
        assert(layer_for_ring(13) == 3);
        assert(layer_for_ring(15) == 3);
        assert(layer_for_ring(16) == 4);
    }

    test skip_rules {
        assert(should_skip(0, 0) == 1);
        assert(should_skip(1, 1) == 1);
        assert(should_skip(1, 0) == 0);
    }

    test new_count_difference {
        assert(new_count(10, 4) == 6);
        assert(new_count(4, 4) == 0);
    }

    test new_count_never_negative {
        assert(new_count(3, 7) == 0);
    }
}
