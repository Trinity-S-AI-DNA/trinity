module port::scripts::gen_w368;

const W368Path = struct{};

/// Check if we should append W368 block: need a match and the last wave must be 367.
pub fn should_append_w368(has_match: bool, wave: i32) -> bool {
    if (!has_match) {
        return false;
    }
    return wave == 367;
}

/// Extract wave number from a "// Wave Loop N" line.
/// Returns the wave number if found, otherwise 0.
pub fn extract_wave_number(line: []const u8) -> i32 {
    const prefix = "// Wave Loop ";
    const prefix_len = prefix.len;
    if (line.len < prefix_len) return 0;
    if (line[0..prefix_len] != prefix) return 0;

    var i: usize = prefix_len;
    var wave: i32 = 0;
    var has_digit = false;
    while (i < line.len) {
        const c = line[i];
        if (c >= '0' and c <= '9') {
            wave = wave * 10 + (c - '0') as i32;
            has_digit = true;
            i += 1;
        } else {
            break;
        }
    }
    if (!has_digit) return 0;
    return wave;
}

/// In-place replace all occurrences of `from` with `to` in `input`.
/// Precondition: from.len == to.len (same-length replacement).
pub fn replace_all_same_len(input: []u8, from: []const u8, to: []const u8) -> void {
    var i: usize = 0;
    while (i + from.len <= input.len) {
        if (input[i..i+from.len] == from) {
            var j: usize = 0;
            while (j < from.len) {
                input[i+j] = to[j];
                j += 1;
            }
            i += from.len;
        } else {
            i += 1;
        }
    }
}

/// Apply all W367->W368 replacements to a block (in-place, same-length).
pub fn apply_w368_replacements(block: []u8) -> void {
    replace_all_same_len(block, "Wave Loop 367", "Wave Loop 368");
    replace_all_same_len(block, "w367_", "w368_");
    replace_all_same_len(block, "W366 seal regeneration", "W367 seal regeneration");
    replace_all_same_len(block, "after W366", "after W367");
    replace_all_same_len(block, "WAVE_LOOP_366_COOPERATION.md", "WAVE_LOOP_367_COOPERATION.md");
}

/// Main function: append W368 block to the spec file.
/// File I/O is plumbing - left undefined. Tests cover the pure decision helpers above.
pub fn append_w368(path: W368Path) -> void {
    undefined;
}

// ============================================================================
// Tests
// ============================================================================

test should_append_w368_false_when_no_match {
    assert(!should_append_w368(false, 0));
    assert(!should_append_w368(false, 367));
    assert(!should_append_w368(false, 368));
}

test should_append_w368_false_when_wave_not_367 {
    assert(!should_append_w368(true, 366));
    assert(!should_append_w368(true, 368));
    assert(!should_append_w368(true, 369));
}

test should_append_w368_true_when_match_and_wave_367 {
    assert(should_append_w368(true, 367));
}

test extract_wave_number_valid {
    assert(extract_wave_number("// Wave Loop 367") == 367);
    assert(extract_wave_number("// Wave Loop 368 -- race depth +1") == 368);
    assert(extract_wave_number("// Wave Loop 0") == 0);
    assert(extract_wave_number("// Wave Loop 12345") == 12345);
}

test extract_wave_number_invalid {
    assert(extract_wave_number("// Wave Loop") == 0);
    assert(extract_wave_number("// Wave Loop abc") == 0);
    assert(extract_wave_number("Wave Loop 367") == 0);
    assert(extract_wave_number("") == 0);
    assert(extract_wave_number("// Something else") == 0);
}

test replace_all_same_len_single {
    var input: [100]u8 = undefined;
    const test_str = "Wave Loop 367";
    var i: usize = 0;
    while (i < test_str.len) {
        input[i] = test_str[i];
        i += 1;
    }
    let len = test_str.len;
    replace_all_same_len(input[0..len], "Wave Loop 367", "Wave Loop 368");
    const expected = "Wave Loop 368";
    var j: usize = 0;
    while (j < expected.len) {
        assert(input[j] == expected[j]);
        j += 1;
    }
}

test replace_all_same_len_multiple_occurrences {
    var input: [200]u8 = undefined;
    const test_str = "w367_ first w367_ second";
    var i: usize = 0;
    while (i < test_str.len) {
        input[i] = test_str[i];
        i += 1;
    }
    let len = test_str.len;
    replace_all_same_len(input[0..len], "w367_", "w368_");
    const expected = "w368_ first w368_ second";
    var j: usize = 0;
    while (j < expected.len) {
        assert(input[j] == expected[j]);
        j += 1;
    }
}

test apply_w368_replacements_full_block {
    var input: [500]u8 = undefined;
    const test_str = "// Wave Loop 367 -- race depth +1\n// See docs/reports/WAVE_LOOP_366_COOPERATION.md Variant B\n\ntest igla_race_w367_batch_depth_invariant_1 {\n    // verify baseline conformance passes after W366\n    assert true\n}\n\ntest igla_race_w367_batch_depth_invariant_2 {\n    // verify spec hash stability after W366 seal regeneration\n    assert true\n}\n\ninvariant igla_race_w367_depth: true\n";
    var i: usize = 0;
    while (i < test_str.len) {
        input[i] = test_str[i];
        i += 1;
    }
    let len = test_str.len;
    apply_w368_replacements(input[0..len]);

    // Check key replacements occurred
    // We can't easily check the whole string, so check for presence of new strings
    // and absence of old strings by scanning
    var found_new_wave = false;
    var found_new_w368 = false;
    var found_new_coop = false;
    var found_new_seal = false;
    var found_new_after = false;
    var k: usize = 0;
    while (k + 13 <= len) {
        if (input[k..k+13] == "Wave Loop 368") found_new_wave = true;
        if (input[k..k+28] == "WAVE_LOOP_367_COOPERATION.md") found_new_coop = true;
        if (input[k..k+22] == "W367 seal regeneration") found_new_seal = true;
        if (input[k..k+10] == "after W367") found_new_after = true;
        k += 1;
    }
    k = 0;
    while (k + 5 <= len) {
        if (input[k..k+5] == "w368_") found_new_w368 = true;
        k += 1;
    }
    assert(found_new_wave);
    assert(found_new_w368);
    assert(found_new_coop);
    assert(found_new_seal);
    assert(found_new_after);

    // Verify old strings are gone
    var found_old_wave = false;
    var found_old_w367 = false;
    var found_old_coop = false;
    var found_old_seal = false;
    var found_old_after = false;
    k = 0;
    while (k + 13 <= len) {
        if (input[k..k+13] == "Wave Loop 367") found_old_wave = true;
        if (input[k..k+28] == "WAVE_LOOP_366_COOPERATION.md") found_old_coop = true;
        if (input[k..k+22] == "W366 seal regeneration") found_old_seal = true;
        if (input[k..k+10] == "after W366") found_old_after = true;
        k += 1;
    }
    k = 0;
    while (k + 5 <= len) {
        if (input[k..k+5] == "w367_") found_old_w367 = true;
        k += 1;
    }
    assert(!found_old_wave);
    assert(!found_old_w367);
    assert(!found_old_coop);
    assert(!found_old_seal);
    assert(!found_old_after);
}