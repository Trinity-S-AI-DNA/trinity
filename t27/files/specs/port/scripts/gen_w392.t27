module port::scripts::gen_w392;

const MAX_SEGMENTS: usize = 32;
const WAVE_PREFIX: []const u8 = "// Wave Loop ";

pub struct WaveSegment {
    wave: i32,
    start: usize,
    end: usize,
}

pub struct SegmentList {
    items: [MAX_SEGMENTS]WaveSegment,
    len: usize,
}

pub fn wave_segments(text: []const u8) -> SegmentList {
    var segments: SegmentList = SegmentList {
        items: [_]WaveSegment{WaveSegment { wave: 0, start: 0, end: 0 }} ** MAX_SEGMENTS,
        len: 0,
    };

    var i: usize = 0;
    while (i < text.len) {
        if (starts_with_at(text, i, WAVE_PREFIX)) {
            var wave_start = i + WAVE_PREFIX.len;
            var wave_num: i32 = 0;
            var j = wave_start;
            while (j < text.len && text[j] >= '0' && text[j] <= '9') {
                wave_num = wave_num * 10 + (text[j] - '0') as i32;
                j += 1;
            }
            var start = i;
            var end: usize = text.len;
            if (segments.len > 0) {
                segments.items[segments.len - 1].end = start;
            }
            if (segments.len < MAX_SEGMENTS) {
                segments.items[segments.len] = WaveSegment {
                    wave: wave_num,
                    start: start,
                    end: end,
                };
                segments.len += 1;
            }
            i = j;
        } else {
            i += 1;
        }
    }
    return segments;
}

fn starts_with_at(haystack: []const u8, at: usize, needle: []const u8) -> bool {
    if (at + needle.len > haystack.len) {
        return false;
    }
    var k: usize = 0;
    while (k < needle.len) {
        if (haystack[at + k] != needle[k]) {
            return false;
        }
        k += 1;
    }
    return true;
}

pub fn build_w392_block(w391_block: []const u8, out: []u8) -> usize {
    var src_i: usize = 0;
    var dst_i: usize = 0;
    while (src_i < w391_block.len && dst_i < out.len) {
        if (src_i + 13 <= w391_block.len && mem_eql_at(w391_block, src_i, "Wave Loop 391")) {
            copy_bytes_at(out, dst_i, "Wave Loop 392");
            src_i += 13;
            dst_i += 13;
        } else if (src_i + 5 <= w391_block.len && mem_eql_at(w391_block, src_i, "w391_")) {
            copy_bytes_at(out, dst_i, "w392_");
            src_i += 5;
            dst_i += 5;
        } else if (src_i + 10 <= w391_block.len && mem_eql_at(w391_block, src_i, "after W390")) {
            copy_bytes_at(out, dst_i, "after W391");
            src_i += 10;
            dst_i += 10;
        } else if (src_i + 24 <= w391_block.len && mem_eql_at(w391_block, src_i, "W390 seal regeneration")) {
            copy_bytes_at(out, dst_i, "W391 seal regeneration");
            src_i += 24;
            dst_i += 24;
        } else if (src_i + 30 <= w391_block.len && mem_eql_at(w391_block, src_i, "WAVE_LOOP_390_COOPERATION.md")) {
            copy_bytes_at(out, dst_i, "WAVE_LOOP_391_COOPERATION.md");
            src_i += 30;
            dst_i += 30;
        } else {
            out[dst_i] = w391_block[src_i];
            src_i += 1;
            dst_i += 1;
        }
    }
    return dst_i;
}

fn mem_eql_at(haystack: []const u8, at: usize, needle: []const u8) -> bool {
    if (at + needle.len > haystack.len) return false;
    var i: usize = 0;
    while (i < needle.len) {
        if (haystack[at + i] != needle[i]) return false;
        i += 1;
    }
    return true;
}

fn copy_bytes_at(dst: []u8, at: usize, src: []const u8) -> void {
    var i: usize = 0;
    while (i < src.len && at + i < dst.len) {
        dst[at + i] = src[i];
        i += 1;
    }
}

fn mem_eql(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) return false;
    var i: usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) return false;
        i += 1;
    }
    return true;
}

pub fn append_w392(path: []const u8) -> void {
    undefined;
}

test wave_segments_single {
    const text = "// Wave Loop 1\nsome content\n// Wave Loop 2\nmore content";
    const segs = wave_segments(text);
    assert(segs.len == 2);
    assert(segs.items[0].wave == 1);
    assert(segs.items[0].start == 0);
    assert(segs.items[0].end == 28);
    assert(segs.items[1].wave == 2);
    assert(segs.items[1].start == 28);
    assert(segs.items[1].end == text.len);
}

test wave_segments_empty {
    const text = "no wave loops here";
    const segs = wave_segments(text);
    assert(segs.len == 0);
}

test build_w392_block_replacements {
    const w391 = "// Wave Loop 391\nw391_test\nafter W390\nW390 seal regeneration\nWAVE_LOOP_390_COOPERATION.md";
    var out: [200]u8 = [_]u8{0} ** 200;
    const len = build_w392_block(w391, &out);
    const expected = "// Wave Loop 392\nw392_test\nafter W391\nW391 seal regeneration\nWAVE_LOOP_391_COOPERATION.md";
    assert(len == expected.len);
    var i: usize = 0;
    while (i < len) {
        assert(out[i] == expected[i]);
        i += 1;
    }
}

test build_w392_block_no_match {
    const w391 = "nothing to replace here";
    var out: [100]u8 = [_]u8{0} ** 100;
    const len = build_w392_block(w391, &out);
    const expected = "nothing to replace here";
    assert(len == expected.len);
    var i: usize = 0;
    while (i < len) {
        assert(out[i] == expected[i]);
        i += 1;
    }
}