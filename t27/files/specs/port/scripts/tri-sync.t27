// SPDX-License-Identifier: Apache-2.0
// Port of scripts/tri-sync.py (issue #6074).
// The script syncs GitHub issues, PRs and docs into a NotebookLM notebook and keeps
// counters in .trinity/state/github-bridge.json. Parsing argv, reading and writing the
// state file, the clients and printing are plumbing; the decisions are which scope is
// accepted, which branch runs (--status, --dry-run, sync), which counter bucket a sync
// adds to, how many errors are printed and the exit code.
//
// Note on the original: line 60 calls `client_is_authenticated`, which the script never
// imports, so the sync branch raises NameError, the `except` on line 112 catches it and
// the script exits 1. `sync_exit(1, ...)` below is that path.
module tri_sync {
    const EXIT_OK: i32 = 0;
    const EXIT_FAIL: i32 = 1;
    const EXIT_USAGE: i32 = 2;

    const MODE_STATUS: u32 = 0;
    const MODE_DRY_RUN: u32 = 1;
    const MODE_SYNC: u32 = 2;

    const BUCKET_ISSUES: u32 = 0;
    const BUCKET_PRS: u32 = 1;
    const BUCKET_DOCS: u32 = 2;
    const BUCKET_NONE: u32 = 9;

    const MAX_ERRORS_SHOWN: u32 = 3;

    // scope_valid(scope): argparse `choices=["all", "issues", "prs", "docs"]` (line 29).
    fn scope_valid(scope: str) -> bool {
        if (scope == "all" or scope == "issues" or scope == "prs" or scope == "docs") {
            return true;
        }
        return false;
    }

    // mode(status, dry_run): --status is checked first (line 39) and returns before
    // --dry-run (line 52) is looked at; with neither flag the script syncs.
    fn mode(status: bool, dry_run: bool) -> u32 {
        if (status) {
            return MODE_STATUS;
        }
        if (dry_run) {
            return MODE_DRY_RUN;
        }
        return MODE_SYNC;
    }

    // stats_bucket(scope): line 98 adds the synced count to the bucket named by the
    // scope, and scope "all" goes to the issues bucket, not to all three.
    fn stats_bucket(scope: str) -> u32 {
        if (scope == "prs") {
            return BUCKET_PRS;
        }
        if (scope == "docs") {
            return BUCKET_DOCS;
        }
        if (scope == "issues" or scope == "all") {
            return BUCKET_ISSUES;
        }
        return BUCKET_NONE;
    }

    // next_synced(prev, items_synced): the counter after one sync (line 98).
    fn next_synced(prev: u64, items_synced: u64) -> u64 {
        return prev + items_synced;
    }

    // errors_shown(n): `result.errors[:3]` prints at most three errors (line 108).
    fn errors_shown(n: u32) -> u32 {
        if (n < MAX_ERRORS_SHOWN) {
            return n;
        }
        return MAX_ERRORS_SHOWN;
    }

    // sync_exit(raised, success): any exception exits 1 (line 116); otherwise the
    // orchestrator's success flag decides 0 or 1 (lines 103-110).
    fn sync_exit(raised: bool, success: bool) -> i32 {
        if (raised) {
            return EXIT_FAIL;
        }
        if (success) {
            return EXIT_OK;
        }
        return EXIT_FAIL;
    }

    // exit_code(scope, status, dry_run, raised, success): the whole script. A scope
    // outside the choices is an argparse error, exit 2, before any branch runs;
    // --status and --dry-run always exit 0, whether or not the state file exists.
    fn exit_code(scope: str, status: bool, dry_run: bool, raised: bool, success: bool) -> i32 {
        if (!scope_valid(scope)) {
            return EXIT_USAGE;
        }
        const m = mode(status, dry_run);
        if (m == MODE_STATUS or m == MODE_DRY_RUN) {
            return EXIT_OK;
        }
        return sync_exit(raised, success);
    }

    // Plumbing: argparse, the state file, the GitHub and NotebookLM clients and the
    // prints; no test calls it.
    fn main() -> i32 {
        undefined;
    }

    test scope_choices {
        assert(scope_valid("all"));
        assert(scope_valid("issues"));
        assert(scope_valid("prs"));
        assert(scope_valid("docs"));
        assert(!scope_valid("wiki"));
        assert(!scope_valid(""));
        assert(!scope_valid("ALL"));
    }

    test status_wins_over_dry_run {
        assert(mode(true, true) == 0);
        assert(mode(true, false) == 0);
        assert(mode(false, true) == 1);
        assert(mode(false, false) == 2);
    }

    test scope_all_counts_as_issues {
        assert(stats_bucket("all") == 0);
        assert(stats_bucket("issues") == 0);
        assert(stats_bucket("prs") == 1);
        assert(stats_bucket("docs") == 2);
        assert(stats_bucket("wiki") == 9);
    }

    test synced_counter_adds {
        assert(next_synced(0, 0) == 0);
        assert(next_synced(5, 7) == 12);
    }

    test at_most_three_errors_printed {
        assert(errors_shown(0) == 0);
        assert(errors_shown(2) == 2);
        assert(errors_shown(3) == 3);
        assert(errors_shown(10) == 3);
    }

    test sync_exit_codes {
        assert(sync_exit(true, true) == 1);
        assert(sync_exit(true, false) == 1);
        assert(sync_exit(false, true) == 0);
        assert(sync_exit(false, false) == 1);
    }

    test whole_script_exit_codes {
        assert(exit_code("bogus", true, false, false, true) == 2);
        assert(exit_code("all", true, false, true, false) == 0);
        assert(exit_code("prs", false, true, true, false) == 0);
        assert(exit_code("docs", false, false, false, true) == 0);
        assert(exit_code("all", false, false, true, false) == 1);
        assert(exit_code("issues", false, false, false, false) == 1);
    }
}
