module port::scripts::gen_w364;

pub fn append_w364(path: Path) -> None {
    undefined;
}

pub fn replace_all_same_len(input: []u8, from: []const u8, to: []const u8) -> void {
    // precondition: from.len == to.len
    var i: usize = 0;
    while (i <= input.len - from.len) {
        if (input[i..i+from.len] == from) {
            var j: usize = 0;
            while (j < from.len) {
                input[i+j] = to[j];
                j += 1;
            }
            i += from.len;
        } else {
            i += 1;
        }
    }
}

test replace_all_same_len_test {
    var input: [100]u8 = undefined;
    const test_str = "Wave Loop 363 w363_ W362 seal regeneration after W362 WAVE_LOOP_362_COOPERATION.md";
    var i: usize = 0;
    while (i < test_str.len) {
        input[i] = test_str[i];
        i += 1;
    }
    let len = test_str.len;
    // We know the replacements are same length, so the length won't change.
    replace_all_same_len(input[0..len], "Wave Loop 363", "Wave Loop 364");
    replace_all_same_len(input[0..len], "w363_", "w364_");
    replace_all_same_len(input[0..len], "W362 seal regeneration", "W363 seal regeneration");
    replace_all_same_len(input[0..len], "after W362", "after W363");
    replace_all_same_len(input[0..len], "WAVE_LOOP_362_COOPERATION.md", "WAVE_LOOP_363_COOPERATION.md");
    const expected = "Wave Loop 364 w364_ W363 seal regeneration after W363 WAVE_LOOP_363_COOPERATION.md";
    var j: usize = 0;
    while (j < expected.len) {
        assert(input[j] == expected[j]);
        j += 1;
    }
}