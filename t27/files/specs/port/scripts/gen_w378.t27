module port::gen_w378;

pub fn append_w378(path: []const u8) -> void {
    // Port the decision logic, not the plumbing
    // File operations are undefined; - the caller handles them
    
    undefined;
}

// Helper function to check if a file contains Wave Loop blocks and get the last wave number
pub fn get_last_wave_number(content: []const u8) ?i32 {
    var wave: ?i32 = null;
    var i: usize = 0;
    var content_len = content.len;
    
    while (i < content_len) {
        // Look for "// Wave Loop " pattern
        if (i + 13 <= content_len and 
            content[i] == '/' and content[i+1] == '/' and
            content[i+2] == ' ' and content[i+3] == 'W' and
            content[i+4] == 'a' and content[i+5] == 'v' and
            content[i+6] == 'e' and content[i+7] == ' ' and
            content[i+8] == 'L' and content[i+9] == 'o' and
            content[i+10] == 'o' and content[i+11] == 'p' and
            content[i+12] == ' ') {
            
            // Found Wave Loop, extract the number
            var j = i + 13;
            var num_start = j;
            while (j < content_len and content[j] >= '0' and content[j] <= '9') {
                j += 1;
            }
            
            if (j > num_start) {
                var num_str_len = j - num_start;
                var wave_num: i32 = 0;
                var k: usize = 0;
                while (k < num_str_len) {
                    var digit = content[num_start + k] - '0';
                    wave_num = wave_num * 10 + digit;
                    k += 1;
                }
                wave = wave_num;
            }
            
            // Skip to end of line to find next block
            while (i < content_len and content[i] != '\n') {
                i += 1;
            }
        }
        i += 1;
    }
    
    return wave;
}

// Helper function to check if content has Wave Loop blocks
pub fn has_wave_loop_blocks(content: []const u8) bool {
    return get_last_wave_number(content) != null;
}

// Helper function to check if wave number is 377
pub fn is_wave_377(content: []const u8) bool {
    var wave = get_last_wave_number(content);
    return wave.? == 377;
}

test get_last_wave_number_no_blocks {
    var content = "Some content without wave loops";
    var wave = get_last_wave_number(content);
    assert(wave == null);
}

test get_last_wave_number_with_377 {
    var content = "// Wave Loop 377\ninvariant test true\n";
    var wave = get_last_wave_number(content);
    assert(wave.? == 377);
}

test get_last_wave_number_with_376 {
    var content = "// Wave Loop 376\ninvariant test true\n";
    var wave = get_last_wave_number(content);
    assert(wave.? == 376);
}

test has_wave_loop_blocks_true {
    var content = "// Wave Loop 377\ninvariant test true\n";
    var has_blocks = has_wave_loop_blocks(content);
    assert(has_blocks == true);
}

test has_wave_loop_blocks_false {
    var content = "No wave loops here";
    var has_blocks = has_wave_loop_blocks(content);
    assert(has_blocks == false);
}

test is_wave_377_true {
    var content = "// Wave Loop 377\ninvariant test true\n";
    var is_377 = is_wave_377(content);
    assert(is_377 == true);
}

test is_wave_377_false {
    var content = "// Wave Loop 376\ninvariant test true\n";
    var is_377 = is_wave_377(content);
    assert(is_377 == false);
}