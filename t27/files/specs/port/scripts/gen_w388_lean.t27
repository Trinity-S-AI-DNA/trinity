// SPDX-License-Identifier: Apache-2.0
// Port of scripts/gen_w388_lean.py (issue #6211).
// The original builds Lean theorem text. Text assembly cannot be generated here
// (`str + str` does not compile), so the decisions that shape the text are ported
// as pure integer functions: the variable-name sequence, the weight at each step
// of a chain, the chain lengths, and the swap that reorders the zero-weight
// chain. Names are packed as codes: a one-letter name is its ASCII code, a
// two-letter name is first * 256 + second. Weights: 0 = zero, 1 = plus, 2 = minus.
module gen_w388_lean {
    const WEIGHT_ZERO: u32 = 0;
    const WEIGHT_PLUS: u32 = 1;
    const WEIGHT_MINUS: u32 = 2;

    // The original's `skip` set: Lean keywords that cannot be variable names.
    fn is_skipped(code: u32) -> bool {
        return code == 24948   // at
            or code == 25209   // by
            or code == 25711   // do
            or code == 26982   // if
            or code == 26990   // in
            or code == 28530   // or
            or code == 29807;  // to
    }

    // candidate for position i: a..z, then aa, ab, ... (26 two-letter names per first letter).
    fn candidate_code(i: u32) -> u32 {
        if (i < 26) {
            return 97 + i;
        }
        const first = 97 + (i - 26) / 26;
        const second = 97 + (i - 26) % 26;
        return first * 256 + second;
    }

    // var_names(n)[k]: the packed code of the k-th name (0-based) among the first n names,
    // skipping keywords. Returns 0 when k is not below n.
    fn var_names(n: u32, k: u32) -> u32 {
        if (k >= n) {
            return 0;
        }
        var produced: u32 = 0;
        var i: u32 = 0;
        while (true) {
            const code = candidate_code(i);
            i = i + 1;
            if (is_skipped(code)) {
                continue;
            }
            if (produced == k) {
                return code;
            }
            produced = produced + 1;
        }
        return 0;
    }

    // nest_mac wraps once per activation, so the nesting depth is the activation count.
    fn nest_mac(base_depth: u32, activations: u32) -> u32 {
        return base_depth + activations;
    }

    // plus_chain(n): lhs nests n MACs with the plus weight; rhs sums n names. Returns n.
    fn plus_chain(n: u32) -> u32 {
        return nest_mac(0, n);
    }

    // minus_chain(n): same shape with the minus weight; rhs is the negated sum.
    fn minus_chain(n: u32) -> u32 {
        return nest_mac(0, n);
    }

    // The weight used at step i of a cancellation chain: plus on even steps, minus on odd.
    fn cancellation_weight(i: u32) -> u32 {
        if (i % 2 == 0) {
            return WEIGHT_PLUS;
        }
        return WEIGHT_MINUS;
    }

    // cancellation_chain(depth): the rhs keeps one MAC (plus) when the depth is odd,
    // and collapses to the bare accumulator when it is even. Returns the rhs MAC count.
    fn cancellation_chain(depth: u32) -> u32 {
        if (depth % 2 == 0) {
            return 0;
        }
        return 1;
    }

    // The weight at step i of the zero-weight chain: plus at plus_idx, zero everywhere else.
    fn zero_chain_weight(i: u32, plus_idx: u32) -> u32 {
        if (i == plus_idx) {
            return WEIGHT_PLUS;
        }
        return WEIGHT_ZERO;
    }

    // zero_weight_closure(before, after): the chain has before + 1 + after steps. Returns that total.
    fn zero_weight_closure(before: u32, after: u32) -> u32 {
        return before + 1 + after;
    }

    // The rhs reorders the activations by swapping the first and the last; this maps a
    // position in the reordered list to the position it takes from in the original.
    fn reordered_source(i: u32, total: u32) -> u32 {
        if (i == 0) {
            return total - 1;
        }
        if (i == total - 1) {
            return 0;
        }
        return i;
    }

    // Plumbing: formats the Lean theorem text.
    fn theorem_block(name: str, doc: str, vars: str, lhs: str, rhs: str) -> str {
        undefined;
    }

    // Plumbing: reads and rewrites TernaryInference.lean.
    fn main() -> void {
        undefined;
    }

    test var_names_first_letters {
        assert(var_names(5, 0) == 97);
        assert(var_names(5, 4) == 101);
    }

    test var_names_out_of_range {
        assert(var_names(3, 3) == 0);
    }

    test var_names_two_letter_after_z {
        // No one-letter name is skipped, so the 26 single letters come first and name 26 is "aa".
        assert(var_names(30, 25) == 122);
        assert(var_names(30, 26) == 24929);
    }

    test var_names_skip_keywords {
        // Candidate 45 is "at" (24948), a keyword: it is skipped, so name 44 is "as" and
        // name 45 is "au".
        assert(candidate_code(45) == 24948);
        assert(is_skipped(24948));
        assert(var_names(60, 44) == 24947);
        assert(var_names(60, 45) == 24949);
    }

    test var_names_never_returns_a_keyword {
        var k: u32 = 0;
        while (k < 66) {
            assert(!is_skipped(var_names(66, k)));
            k = k + 1;
        }
    }

    test plus_and_minus_chain_lengths {
        assert(plus_chain(66) == 66);
        assert(minus_chain(65) == 65);
        assert(nest_mac(0, 0) == 0);
    }

    test cancellation_weights_alternate {
        assert(cancellation_weight(0) == 1);
        assert(cancellation_weight(1) == 2);
        assert(cancellation_weight(46) == 1);
        assert(cancellation_weight(47) == 2);
    }

    test cancellation_chain_depth_parity {
        assert(cancellation_chain(48) == 0);
        assert(cancellation_chain(47) == 1);
        assert(cancellation_chain(0) == 0);
    }

    test zero_weight_closure_sizes {
        assert(zero_weight_closure(23, 23) == 47);
        assert(zero_weight_closure(0, 0) == 1);
    }

    test zero_chain_has_one_plus {
        assert(zero_chain_weight(23, 23) == 1);
        assert(zero_chain_weight(0, 23) == 0);
        assert(zero_chain_weight(46, 23) == 0);
    }

    test reorder_swaps_first_and_last {
        assert(reordered_source(0, 47) == 46);
        assert(reordered_source(46, 47) == 0);
        assert(reordered_source(10, 47) == 10);
    }
}
