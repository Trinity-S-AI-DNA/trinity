// Port of scripts/run_v51_multiple.sh top level.
// The main function is left as undefined because it involves plumbing (filesystem, subprocess, etc.).
// The pure helper `script_output` captures the decision of what lines the script prints.

pub fn main() {
    undefined;
}

pub fn script_output() -> [22][]const u8 {
    let lines: [22][]const u8 = [
        "Running v51 multiple times...",
        "Run 1/10", "",
        "Run 2/10", "",
        "Run 3/10", "",
        "Run 4/10", "",
        "Run 5/10", "",
        "Run 6/10", "",
        "Run 7/10", "",
        "Run 8/10", "",
        "Run 9/10", "",
        "Run 10/10", "",
        "All runs completed!"
    ];
    return lines;
}

test script_output_returns_correct_lines {
    var expected: [22][]const u8 = [
        "Running v51 multiple times...",
        "Run 1/10", "",
        "Run 2/10", "",
        "Run 3/10", "",
        "Run 4/10", "",
        "Run 5/10", "",
        "Run 6/10", "",
        "Run 7/10", "",
        "Run 8/10", "",
        "Run 9/10", "",
        "Run 10/10", "",
        "All runs completed!"
    ];
    var result = script_output();
    var i: usize = 0;
    while (i < 22) {
        if (result[i].len != expected[i].len) {
            assert(false);
        }
        var j: usize = 0;
        while (j < result[i].len) {
            assert(result[i][j] == expected[i][j]);
            j += 1;
        }
        i += 1;
    }
}