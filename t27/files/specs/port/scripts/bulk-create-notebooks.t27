module port::scripts::bulk_create_notebooks;

// Define the NotebookIssue struct
pub struct NotebookIssue {
    number: i32,
    title: []const u8,
}

// Define the result of getting open issues
pub struct OpenIssuesResult {
    issues: [100]NotebookIssue,
    len: usize,
}

// Plumbing: get open issues from GitHub (undefined)
pub fn get_open_issues() -> OpenIssuesResult {
    undefined;
}

// Plumbing: process a single issue (create notebook and comment) (undefined)
pub fn process_issue(issue_number: i32, issue_title: []const u8) -> i32 {
    undefined;
}

// Pure decision function: given results of processing each issue, return exit code
pub fn decide_exit_code(results: []i32) -> i32 {
    for (results) |res| {
        if (res != 0) {
            return 1;
        }
    }
    return 0;
}

// Main function: the top-level of the original script
pub fn main() -> i32 {
    let open_issues_result = get_open_issues();
    // We'll allocate a fixed-size array for results (max 100 issues)
    var results: [100]i32;
    var i: usize = 0;
    while (i < open_issues_result.len) {
        results[i] = process_issue(
            open_issues_result.issues[i].number,
            open_issues_result.issues[i].title
        );
        if (results[i] != 0) {
            // Early exit on first failure
            return 1;
        }
        i += 1;
    }
    return 0;
}

// Tests for the pure decision function
test decide_exit_code_empty {
    var empty: [0]i32 = [];
    assert(decide_exit_code(&empty) == 0);
}

test decide_exit_code_all_success {
    var successes: [3]i32 = [0, 0, 0];
    assert(decide_exit_code(&successes) == 0);
}

test decide_exit_code_first_failure {
    var mixed: [3]i32 = [0, 1, 0];
    assert(decide_exit_code(&mixed) == 1);
}

test decide_exit_code_last_failure {
    var mixed: [3]i32 = [0, 0, 1];
    assert(decide_exit_code(&mixed) == 1);
}

test decide_exit_code_multiple_failures {
    var mixed: [3]i32 = [1, 1, 0];
    assert(decide_exit_code(&mixed) == 1);
}