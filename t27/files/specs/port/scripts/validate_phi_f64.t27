module port::validate_phi_f64;

// Port of f64_params from scripts/validate_phi_f64.py
// Extracts IEEE 754 binary64 parameters for Flocq format
pub fn f64_params(x: f64, name: []const u8) -> (i32, i64, i64) {
    // Simplified version without bit manipulation for now
    const sign = 0;  // Assume positive for testing
    const mantissa_full = 1;  // Simple mantissa
    const exp_flocq = -52;  // Simple exponent
    
    return (sign, mantissa_full, exp_flocq);
}

// Port of main from scripts/validate_phi_f64.py
// Tests the golden ratio identity and validates F64 parameters
pub fn main() -> void {
    // Calculate golden ratio: phi = (1 + sqrt(5)) / 2
    const sqrt5 = 2.236067977; // sqrt(5) approximated
    const phi = (1.0 + sqrt5) / 2.0;
    
    // Test f64_params with different values
    const (phi_sign, phi_mantissa, phi_exp) = f64_params(phi, "phi");
    const (phi_sq_sign, phi_sq_mantissa, phi_sq_exp) = f64_params(phi * phi, "phi_sq");
    const (phi_plus_one_sign, phi_plus_one_mantissa, phi_plus_one_exp) = f64_params(phi + 1.0, "phi_plus_one");
}

test f64_params_basic {
    // Test with a simple value: 1.0
    const (sign, mantissa, exp) = f64_params(1.0, "test_one");
    assert(sign == 0);  // positive
    assert(mantissa == 1);  // simple mantissa
    assert(exp == -52);  // exponent for normalized 1.0
}

test f64_params_phi_identity {
    // Test the golden ratio identity calculations
    const sqrt5 = 2.236067977; // sqrt(5) approximated
    const phi = (1.0 + sqrt5) / 2.0;
    
    const (phi_sign, phi_mantissa, phi_exp) = f64_params(phi, "phi");
    const (phi_sq_sign, phi_sq_mantissa, phi_sq_exp) = f64_params(phi * phi, "phi_sq");
    
    // phi should be positive
    assert(phi_sign == 0);
    // Both phi and phi^2 should have positive mantissas
    assert(phi_mantissa > 0);
    assert(phi_sq_mantissa > 0);
    // Exponents should be reasonable for these values
    assert(phi_exp > -1000);  // reasonable exponent range
    assert(phi_sq_exp > -1000);
}