// specs/port/scripts/gen_w391.t27 -- port of scripts/gen_w391.py (55 lines).
// The regex WAVE_HEADER_RE matches the literal "// Wave Loop " followed by
// one or more digits: here that is a pure byte scan, header_wave_at. The
// two ported functions:
//   wave_segments(text) -- one segment per wave header, each a
//     (wave, start, end) triple over the byte offsets of the text.
//   append_w391(text) -- the decisions of the original: skip when no Wave
//     Loop block is found, skip when the last block's wave is not 390,
//     otherwise append. Returns (verdict, block_start, block_end); the
//     caller owns the plumbing the original keeps inline (the read, the
//     print, the write of text[:block_start] + new_block) and the five
//     literal replacements of lines 41-45, which t27 has no string surgery
//     to perform.
// The language has no regex, so the port reads one header per scan position
// and tracks the running byte offset.
module port-scripts;

// Verdicts of append_w391, in the order the original prints them.
pub const VERDICT_APPEND: i32 = 0;
pub const VERDICT_SKIP_NO_BLOCK: i32 = 1;
pub const VERDICT_SKIP_WRONG_WAVE: i32 = 2;

// Not named Segment or Segments: gen_w390.t27 uses those names with u32
// fields, and this port keeps i64 and usize (tri types ratchet, #7437).
pub struct W391Segment {
    wave: i64,
    start: usize,
    end: usize,
}

pub struct W391Segments {
    items: [100]W391Segment,
    len: usize,
}

// The wave number the regex would report for a match at `at`: the literal
// "// Wave Loop " followed by one or more digits. -1 when `at` is not a
// match (too close to the end, the literal does not fit, or no digit
// follows). Wave 0 is reported as a match by the original but cannot be
// distinguished from the sentinel here, so it is treated as no match.
fn header_wave_at(text: str, at: usize) -> i64 {
    const header: str = "// Wave Loop ";
    if at + header.len > text.len {
        return -1;
    }
    var j: usize = 0;
    while j < header.len {
        if text[at + j] != header[j] {
            return -1;
        }
        j += 1;
    }
    var wave: i64 = 0;
    var digits: usize = 0;
    var k: usize = at + header.len;
    while k < text.len {
        if text[k] < '0' || text[k] > '9' {
            break;
        }
        wave = wave * 10 + ((text[k] as i64) - 48);
        digits += 1;
        k += 1;
    }
    if digits == 0 {
        return -1;
    }
    return wave;
}

pub fn wave_segments(text: str) -> W391Segments {
    var segs: W391Segments = undefined;
    segs.len = 0;
    var i: usize = 0;
    while i < text.len {
        const w = header_wave_at(text, i);
        if w >= 0 && segs.len < 100 {
            if segs.len > 0 {
                segs.items[segs.len - 1].end = i;
            }
            segs.items[segs.len] = W391Segment { wave: w, start: i, end: text.len };
            segs.len += 1;
        }
        i += 1;
    }
    return segs;
}

pub fn append_w391(text: str) -> (i32, usize, usize) {
    const segs = wave_segments(text);
    if segs.len == 0 {
        return (VERDICT_SKIP_NO_BLOCK, 0, 0);
    }
    const last = segs.items[segs.len - 1];
    if last.wave != 390 {
        return (VERDICT_SKIP_WRONG_WAVE, last.start, last.end);
    }
    return (VERDICT_APPEND, last.start, last.end);
}

test header_scan {
    const text = "x// Wave Loop 390\n";
    assert(header_wave_at(text, 0) == -1);
    assert(header_wave_at(text, 1) == 390);
    assert(header_wave_at(text, 2) == -1);
}

test wave_segments_two_blocks {
    const text = "// Wave Loop 389\n// Wave Loop 390\n";
    const segs = wave_segments(text);
    assert(segs.len == 2);
    assert(segs.items[0].wave == 389);
    assert(segs.items[0].start == 0);
    assert(segs.items[0].end == 17);
    assert(segs.items[1].wave == 390);
    assert(segs.items[1].start == 17);
    assert(segs.items[1].end == 34);
}

test wave_segments_edges {
    assert(wave_segments("").len == 0);
    assert(wave_segments("no blocks here\n").len == 0);
    assert(wave_segments("// Wave Loop \n").len == 0);
    const segs = wave_segments("// Wave Loop 7\n");
    assert(segs.len == 1);
    assert(segs.items[0].wave == 7);
    assert(segs.items[0].end == 15);
}

test append_w391_appends {
    const text = "x\n// Wave Loop 390\nw390_body\n";
    const (v, start, stop) = append_w391(text);
    assert(v == VERDICT_APPEND);
    assert(start == 2);
    assert(stop == 29);
}

test append_w391_skips {
    const (v0, s0, e0) = append_w391("nothing here\n");
    assert(v0 == VERDICT_SKIP_NO_BLOCK);
    assert(s0 == 0);
    const (v1, s1, e1) = append_w391("// Wave Loop 391\n");
    assert(v1 == VERDICT_SKIP_WRONG_WAVE);
    assert(s1 == 0);
    assert(e1 == 17);
}

test append_w391_on_spec_shaped_text {
    const text = "// Wave Loop 389 seal\nw389 notes\n// Wave Loop 390 cooperation\nw390 notes\n";
    const segs = wave_segments(text);
    assert(segs.len == 2);
    assert(segs.items[1].wave == 390);
    assert(segs.items[1].start == 33);
    const (v, start, stop) = append_w391(text);
    assert(v == VERDICT_APPEND);
    assert(start == segs.items[1].start);
    assert(stop == segs.items[1].end);
}
