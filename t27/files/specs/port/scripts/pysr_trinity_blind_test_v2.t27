// Port of scripts/pysr_trinity_blind_test_v2.py to t27

module port::pysr_trinity_blind_test_v2;

// True constants
const PI_TRUE: f64 = 3.141592653589793;
const E_TRUE: f64 = 2.718281828459045;
const PHI: f64 = 1.61803398875; // (1 + sqrt(5)) / 2 = 1.61803398875
const GAMMA_PHI: f64 = 1.0 / (PHI * PHI * PHI); // = 0.23607

// Target formulas (the original script's targets dict, flattened)
const P6_V_us_FORMULA: []const u8 = "3*GAMMA_PHI/PI_TRUE";
const P6_V_us_TARGET: f64 = 0.224310;

// Substring search over the equation string PySR found
pub fn contains(haystack: []const u8, needle: []const u8) bool {
    if (needle.len == 0) {
        return true;
    }
    if (haystack.len < needle.len) {
        return false;
    }
    var i: usize = 0;
    while (i + needle.len <= haystack.len) : (i += 1) {
        var j: usize = 0;
        var hit: bool = true;
        while (j < needle.len) : (j += 1) {
            if (haystack[i + j] != needle[j]) {
                hit = false;
            }
        }
        if (hit) {
            return true;
        }
    }
    return false;
}

// The target key selects the blind-test target
pub fn is_valid_target(target: []const u8) bool {
    return target.len > 0;
}

// Does the equation carry the expected Trinity structure?
pub fn has_trinity_structure(eq_str: []const u8) bool {
    if (eq_str.len == 0) {
        return false;
    }
    if (eq_str[0] != '3') {
        return false;
    }
    if (!contains(eq_str, "GAMMA")) {
        return false;
    }
    if (!contains(eq_str, "/")) {
        return false;
    }
    return true;
}

// The blind-test decision: pass only when the equation PySR found carries the
// structure 3*GAMMA_PHI/PI_TRUE. The steps that move data in or out of the
// process (numpy seeding and sampling, the PySR fit and predict calls, every
// print) are not expressible in .t27 and stay unported: the caller supplies
// the equation string PySR found. The decisions the original makes on that
// data are the pure functions above, and they carry this port's tests.
pub fn run_target(target: []const u8, eq_str: []const u8) bool {
    if (!is_valid_target(target)) {
        return false;
    }
    if (!has_trinity_structure(eq_str)) {
        return false;
    }
    return true;
}

// Test the mathematical constants and calculations
test constants_calculation {
    // Test PHI calculation
    const expected_phi = 1.61803398875; // (1 + sqrt(5)) / 2 = 1.61803398875
    // Use approximate equality for floating point numbers
    const phi_diff = if (PHI > expected_phi) PHI - expected_phi else expected_phi - PHI;
    assert(phi_diff < 0.000001);

    // Test GAMMA_PHI calculation
    const expected_gamma_phi = 1.0 / (expected_phi * expected_phi * expected_phi);
    const gamma_diff = if (GAMMA_PHI > expected_gamma_phi) GAMMA_PHI - expected_gamma_phi else expected_gamma_phi - GAMMA_PHI;
    assert(gamma_diff < 0.000001);

    // Test the true constant e
    assert(E_TRUE > 2.71828 && E_TRUE < 2.71829);

    // Test target value calculation
    const target_value = 3 * GAMMA_PHI / PI_TRUE;
    assert(target_value > 0.22); // Should be close to 0.224310
    assert(target_value < 0.23);
}

// Test the data generation logic
test data_generation_logic {
    const n_samples: usize = 50;
    const train_size: usize = (n_samples * 80 / 100);

    // Test the split calculation
    assert(train_size == 40);
    assert(n_samples - train_size == 10);

    // Test the target formula calculation
    const Y_true = 3 * GAMMA_PHI / PI_TRUE;
    assert(Y_true > 0.22);
    assert(Y_true < 0.23);
}

// Test the pattern detection logic with simpler string checks
test pattern_detection {
    // Test with expected equation
    const eq_str = "3*GAMMA*PHI/PI";
    // Check first character is '3'
    assert(eq_str[0] == '3');
    // Check substring "GAMMA" exists by checking specific positions
    assert(eq_str[2] == 'G');
    assert(eq_str[3] == 'A');
    assert(eq_str[4] == 'M');
    assert(eq_str[5] == 'M');
    assert(eq_str[6] == 'A');
    // Check '/' exists at position 11
    assert(eq_str[11] == '/');

    // Test with different equation
    const eq_str2 = "2*GAMMA+PHI";
    // Check first character is NOT '3'
    assert(eq_str2[0] != '3');
    // Check "GAMMA" still exists
    assert(eq_str2[2] == 'G');
    assert(eq_str2[3] == 'A');
    assert(eq_str2[4] == 'M');
    assert(eq_str2[5] == 'M');
    assert(eq_str2[6] == 'A');
    // Check '/' does NOT exist at position 8
    assert(eq_str2[8] != '/');
}

// Test the target constants
test target_constants {
    assert(P6_V_us_TARGET > 0.22 && P6_V_us_TARGET < 0.23);
    assert(contains(P6_V_us_FORMULA, "GAMMA"));
    assert(contains(P6_V_us_FORMULA, "PI_TRUE"));
}

// Test the substring search helper
test contains_cases {
    const haystack: []const u8 = "3*GAMMA_PHI/PI_TRUE";
    assert(contains(haystack, "GAMMA"));
    assert(contains(haystack, "PI_TRUE"));
    assert(contains(haystack, "/"));
    assert(contains(haystack, ""));
    assert(!contains(haystack, "gamma"));
    assert(!contains(haystack, "PHI_TRUE_EXTRA"));
}

// Test the blind-test decision on the equations PySR would report
test run_target_cases {
    const key: []const u8 = "V_us";
    const eq_pass: []const u8 = "3*GAMMA_PHI/PI_TRUE";
    const eq_fail: []const u8 = "2*GAMMA+PHI";
    const eq_ok: []const u8 = "3*GAMMA/PI_TRUE";
    const empty: []const u8 = "";
    assert(run_target(key, eq_pass));
    assert(run_target(key, eq_ok));
    assert(!run_target(key, eq_fail));
    assert(!run_target(empty, eq_pass));
    assert(!run_target(key, empty));
}
