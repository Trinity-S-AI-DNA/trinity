// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/scripts/gen_w377.t27
// Port of scripts/gen_w377.py (42 lines, one function: append_w377) to t27.

// The Python reads a spec file, finds the last `// Wave Loop N ... invariant
// ... true` block with a regex, checks the wave number, renumbers the block
// with five literal substitutions, and writes the file back. Reading, the
// regex, the write and the print are plumbing; the decision inside
// append_w377 is ported below as pure code: the file text arrives as a
// parameter, and the result is the plan -- append the renumbered block at
// insert_pos, or skip with the reason from the original's two SKIP messages.

module port::scripts::gen_w377;

// Python: `if wave != 376`.
const LAST_WAVE: i32 = 376;

// Python strings grow; this buffer is the fixed-capacity stand-in. The clamp
// in build_new_block leaves 32 bytes of headroom so every digit patch lands
// inside the buffer.
const BLOCK_CAP: usize = 4096;

// The matched block, copied out of the file text.
struct Block {
    chars: [BLOCK_CAP]u8,
    len: usize,
}

// What append_w377 decides for one spec. last_wave is carried so the caller
// can format "last wave is {wave}, expected 376"; insert_pos is the end of
// the last match (Python: `insert_pos = last.end()`), where the new block is
// inserted; new_block is the renumbered copy of the matched block.
struct W377Plan {
    appended: bool,
    skip_reason: []const u8,
    last_wave: i32,
    insert_pos: usize,
    new_block: Block,
}

// Literal matching at an offset -- the regex's job, reduced to what the
// decision reads: the `// Wave Loop ` prefix, the `invariant ` line and its
// `true\n` end.
pub fn matches_at(src: []const u8, pos: usize, lit: []const u8) -> bool {
    if (pos + lit.len > src.len) {
        return false;
    }
    var i: usize = 0;
    while (i < lit.len) {
        if (src[pos + i] != lit[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Python lines 26-30: `new_block = block.replace(...)` five times. Every
// substitution changes exactly one digit, so the port copies the block and
// patches those digits, tried in the original's replacement order:
//   "Wave Loop 376" -> "Wave Loop 377"            (digit 12: 6 -> 7)
//   "w376_" -> "w377_"                            (digit 3: 6 -> 7)
//   "W375 seal regeneration" -> "W376 seal regeneration"  (digit 3: 5 -> 6)
//   "after W375" -> "after W376"                  (digit 9: 5 -> 6)
//   "WAVE_LOOP_375_COOPERATION.md" -> "WAVE_LOOP_376_COOPERATION.md"
//                                                 (digit 12: 5 -> 6)
pub fn build_new_block(src: []const u8) -> Block {
    var n: usize = src.len;
    if (n > BLOCK_CAP - 32) {
        n = BLOCK_CAP - 32;
    }
    var out: Block = Block { chars: [_]u8{0} ** BLOCK_CAP, len: 0 };
    var i: usize = 0;
    while (i < n) {
        out.chars[i] = src[i];
        i += 1;
    }
    out.len = n;
    var j: usize = 0;
    while (j < n) {
        if (matches_at(src, j, "Wave Loop 376")) {
            out.chars[j + 12] = '7';
            j += 13;
        } else if (matches_at(src, j, "w376_")) {
            out.chars[j + 3] = '7';
            j += 5;
        } else if (matches_at(src, j, "W375 seal regeneration")) {
            out.chars[j + 3] = '6';
            j += 22;
        } else if (matches_at(src, j, "after W375")) {
            out.chars[j + 9] = '6';
            j += 10;
        } else if (matches_at(src, j, "WAVE_LOOP_375_COOPERATION.md")) {
            out.chars[j + 12] = '6';
            j += 28;
        } else {
            j += 1;
        }
    }
    return out;
}

// Compares a built block against expected text; the tests below use it to
// assert the renumbered bytes.
pub fn block_equals(out: Block, expected: []const u8) -> bool {
    if (out.len != expected.len) {
        return false;
    }
    var i: usize = 0;
    while (i < out.len) {
        if (out.chars[i] != expected[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Python line 13: `def append_w377(path: Path) -> None:`. The path is carried
// for the caller's messages; the text stands in for `path.read_text()`. The
// scan mirrors `re.finditer(r'// Wave Loop (\d+).*?\n(invariant .*?true)\n',
// text, re.DOTALL)`: left to right, non-overlapping, and for each
// `// Wave Loop N` the first `\ninvariant ` whose continuation reaches a
// `true\n`. `if not m` skips; `if wave != 376` skips; otherwise the
// renumbered block is inserted right after the match, so the block is
// duplicated with W377 numbering.
pub fn append_w377(path: []const u8, text: []const u8) -> W377Plan {
    var match_count: usize = 0;
    var last_wave: i32 = -1;
    var last_start: usize = 0;
    var last_end: usize = 0;
    const empty = build_new_block("");

    var pos: usize = 0;
    while (pos < text.len) {
        var matched_here = false;
        if (matches_at(text, pos, "// Wave Loop ")) {
            var wave: i32 = 0;
            var digits: usize = 0;
            var wi: usize = pos + 13;
            while (wi < text.len and text[wi] >= '0' and text[wi] <= '9') {
                wave = wave * 10 + (text[wi] - '0');
                digits += 1;
                wi += 1;
            }
            if (digits > 0) {
                var c: usize = wi;
                while (c < text.len and matched_here == false) {
                    if (text[c] == '\n' and matches_at(text, c + 1, "invariant ")) {
                        var t: usize = c + 11;
                        while (t + 5 <= text.len and matched_here == false) {
                            if (matches_at(text, t, "true\n")) {
                                match_count += 1;
                                last_wave = wave;
                                last_start = pos;
                                last_end = t + 5;
                                matched_here = true;
                            }
                            t += 1;
                        }
                    }
                    c += 1;
                }
            }
        }
        if (matched_here) {
            pos += last_end - pos;
        } else {
            pos += 1;
        }
    }

    if (match_count == 0) {
        return W377Plan { appended: false, skip_reason: "no Wave Loop block found", last_wave: -1, insert_pos: 0, new_block: empty };
    }
    if (last_wave != LAST_WAVE) {
        return W377Plan { appended: false, skip_reason: "last wave is not 376", last_wave: last_wave, insert_pos: last_end, new_block: empty };
    }
    const block: []const u8 = text[last_start..last_end];
    const nb = build_new_block(block);
    return W377Plan { appended: true, skip_reason: "", last_wave: last_wave, insert_pos: last_end, new_block: nb };
}

test append_w377_skips_without_a_wave_loop_block {
    const p = append_w377("specs/igla/race/x.t27", "some other content without wave loop");
    assert(p.appended == false);
    assert(p.skip_reason == "no Wave Loop block found");
}

test append_w377_skips_when_last_wave_is_375 {
    const p = append_w377("specs/igla/race/x.t27", "// Wave Loop 375\ninvariant a true\n\nother content");
    assert(p.appended == false);
    assert(p.last_wave == 375);
    assert(p.skip_reason == "last wave is not 376");
}

test append_w377_appends_a_w377_copy {
    const p = append_w377("specs/igla/race/x.t27", "// Wave Loop 376\ninvariant x true\n");
    assert(p.appended);
    assert(p.insert_pos == 34);
    assert(p.last_wave == 376);
    assert(block_equals(p.new_block, "// Wave Loop 377\ninvariant x true\n"));
}

test append_w377_uses_the_last_match {
    const p = append_w377("specs/igla/coder/y.t27", "// Wave Loop 375\ninvariant a true\n\n// Wave Loop 376\ninvariant b true\n");
    assert(p.appended);
    assert(p.last_wave == 376);
    assert(block_equals(p.new_block, "// Wave Loop 377\ninvariant b true\n"));
}

test append_w377_renumbers_the_matched_block {
    const p = append_w377("specs/igla/race/z.t27", "// Wave Loop 376 w376_x W375 seal regeneration after W375 WAVE_LOOP_375_COOPERATION.md\ninvariant w376_alive() == true\n");
    assert(p.appended);
    assert(block_equals(p.new_block, "// Wave Loop 377 w377_x W376 seal regeneration after W376 WAVE_LOOP_376_COOPERATION.md\ninvariant w377_alive() == true\n"));
}

test build_new_block_renumbers_every_form {
    const out = build_new_block("w376_x Wave Loop 376 W375 seal regeneration after W375 WAVE_LOOP_375_COOPERATION.md");
    assert(block_equals(out, "w377_x Wave Loop 377 W376 seal regeneration after W376 WAVE_LOOP_376_COOPERATION.md"));
}

test build_new_block_leaves_other_text_alone {
    const out = build_new_block("// Wave Loop 9\ninvariant other() == true\nw375 stays\n");
    assert(block_equals(out, "// Wave Loop 9\ninvariant other() == true\nw375 stays\n"));
}

test matches_at_finds_literals_at_offsets {
    assert(matches_at("Wave Loop 376", 0, "Wave Loop 376"));
    assert(matches_at("// Wave Loop 376 x", 3, "Wave Loop 376"));
    assert(matches_at("x w376_ y", 2, "w376_"));
    assert(matches_at("Wav", 0, "Wave") == false);
    assert(matches_at("w376", 0, "w376_") == false);
    assert(matches_at("abc", 1, "abcd") == false);
}
