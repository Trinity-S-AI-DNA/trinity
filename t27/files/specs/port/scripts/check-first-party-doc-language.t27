module port::scripts::check_first_party_doc_language;

// The script's top level: find root directory and execute Python script
pub fn main() -> i32 {
    // Find the root directory by going up one level from the script's location
    const script_path: []const u8 = "scripts/check-first-party-doc-language.sh";
    const root_path = find_root_directory(script_path);
    
    // Execute the Python script - this is plumbing that should be undefined
    undefined;
}

// Find the root directory by going up one level from the script's location
fn find_root_directory(script_path: []const u8) -> []const u8 {
    // Extract directory from script path
    const last_slash = find_last_char(script_path, '/');
    if (last_slash == null) {
        return "."; // script is in root, no directory part
    }
    
    const script_dir = slice_string(script_path, 0, last_slash.?);
    
    // Go up one level: ".." relative to script directory
    return "..";
}

// Helper: find last occurrence of a character in a string
fn find_last_char(s: []const u8, c: u8) -> ?usize {
    var i: usize = s.len;
    while (i > 0) {
        i -= 1;
        if (s[i] == c) {
            return i;
        }
    }
    return null;
}

// Helper: slice a string from start to end index
fn slice_string(s: []const u8, start: usize, end: usize) -> []const u8 {
    if (end > s.len) {
        return s[start..s.len];
    }
    return s[start..end];
}

test find_root_directory_absolute_path {
    // Test with absolute-like path
    const result = find_root_directory("scripts/check-first-party-doc-language.sh");
    assert(result == "..");
}

test find_root_directory_no_directory {
    // Test with no directory part (script in root)
    const result = find_root_directory("script.sh");
    assert(result == ".");
}

test find_last_char_found {
    const result = find_last_char("path/to/file", '/');
    assert(result.? == 4);
}

test find_last_char_not_found {
    const result = find_last_char("filename", '/');
    assert(result == null);
}