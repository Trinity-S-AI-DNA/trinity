module port::scripts::gen_w312;

// Helper: check if a line (after skipping whitespace) starts with a prefix
fn line_starts_with(line: []const u8, prefix: []const u8) -> bool {
    var i: usize = 0;
    while (i < line.len and (line[i] == ' ' or line[i] == '\t')) {
        i += 1;
    }
    if (i + prefix.len > line.len) {
        return false;
    }
    for (j in 0..prefix.len) {
        if (line[i + j] != prefix[j]) {
            return false;
        }
    }
    return true;
}

// Helper: compare two slices for equality (used for the replacement tokens)
fn slices_equal(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) {
        return false;
    }
    for (i in 0..a.len) {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

// Helper: copy a slice from src to dst, assuming dst has enough space
fn slice_copy(dst: []u8, src: []const u8, dst_index: usize) -> usize {
    for (i in 0..src.len) {
        dst[dst_index + i] = src[i];
    }
    return dst_index + src.len;
}

pub fn get_last_block(lines: [][]const u8) -> ?[][]const u8 {
    var test_indices: [100]usize = undefined;
    var test_count: usize = 0;
    var inv_indices: [100]usize = undefined;
    var inv_count: usize = 0;

    // Find indices of lines that start with 'test ' or 'invariant ' after stripping whitespace
    for (i in 0..lines.len) {
        let line = lines[i];
        if (line_starts_with(line, "test ")) {
            if (test_count < test_indices.len) {
                test_indices[test_count] = i;
                test_count += 1;
            }
        } else if (line_starts_with(line, "invariant ")) {
            if (inv_count < inv_indices.len) {
                inv_indices[inv_count] = i;
                inv_count += 1;
            }
        }
    }

    if (test_count < 2 or inv_count < 1) {
        return null;
    }

    let last_inv = inv_indices[inv_count - 1];

    // Collect test indices that are before last_inv
    var tests_before: [100]usize = undefined;
    var tests_before_count: usize = 0;
    for (i in 0..test_count) {
        if (test_indices[i] < last_inv) {
            if (tests_before_count < tests_before.len) {
                tests_before[tests_before_count] = test_indices[i];
                tests_before_count += 1;
            }
        }
    }

    if (tests_before_count < 2) {
        return null;
    }

    var start = tests_before[tests_before_count - 2]; // second-to-last test before last_inv

    var end_index: usize = lines.len;
    let end_ptr = &end_index;
    _ = end_ptr;
    // Look for the first line after last_inv that starts with certain keywords after stripping
    for (i in (last_inv + 1)..lines.len) {
        let line = lines[i];
        if (line_starts_with(line, "test ") or
            line_starts_with(line, "invariant ") or
            line_starts_with(line, "fn ") or
            line_starts_with(line, "pub ") or
            line_starts_with(line, "//") or
            line_starts_with(line, "type ") or
            line_starts_with(line, "struct ")) {
            end_index = i;
            break;
        }
    }

    // Return the slice from start to end (exclusive of end)
    var result: [100][]const u8 = undefined;
    var result_count: usize = 0;
    for (i in start..end_index) {
        if (result_count < result.len) {
            result[result_count] = lines[i];
            result_count += 1;
        }
    }
    return result[0..result_count];
}

pub fn transform_block(block_lines: [][]const u8) -> []const u8 {
    // Fixed buffer size for the output string
    const BUF_SIZE: usize = 4096;
    var buf: [BUF_SIZE]u8 = undefined;
    var len: usize = 0;

    for (line_idx in 0..block_lines.len) {
        let line = block_lines[line_idx];
        var char_idx: usize = 0;
        while (char_idx < line.len) {
            // Check for "_w311", "_w310", "_w309" (each 5 bytes including underscores)
            if (char_idx + 5 <= line.len) {
                let slice = line[char_idx..char_idx+5];
                if (slices_equal(slice, "_w311") or
                    slices_equal(slice, "_w310") or
                    slices_equal(slice, "_w309")) {
                    // Replace with "_w312"
                    if (len + 5 > BUF_SIZE) {
                        // Buffer too small, return empty string (error case)
                        return &[];
                    }
                    len = slice_copy(buf[0..BUF_SIZE], "_w312", len);
                    char_idx += 5;
                    continue;
                }
            }
            // Copy current character
            if (len >= BUF_SIZE) {
                return &[];
            }
            buf[len] = line[char_idx];
            len += 1;
            char_idx += 1;
        }
    // Add newline after each line
    if (len >= BUF_SIZE) {
        return &[];
    }
    buf[len] = '\n';
    len += 1;
    }
    // Add final newline after all lines
    if (len >= BUF_SIZE) {
        return &[];
    }
    buf[len] = '\n';
    len += 1;
    return buf[0..len];
}

pub fn process_specs() {
    undefined;
}

test get_last_block_normal {
    var lines: [10][]const u8 = [
        "test something",
        "line 1",
        "invariant something",
        "line 2",
        "test another",
        "line 3",
        "line 4",
    ];
    const expected: [3][]const u8 = [
        "invariant something",
        "line 2",
        "test another",
    ];
    let result = get_last_block(&lines);
    if (result) {
        assert(result.len == expected.len);
        for (i in 0..result.len) {
            assert(slices_equal(result[i], expected[i]));
        }
    } else {
        assert(false);
    }
}

test get_last_block_insufficient_tests {
    var lines: [5][]const u8 = [
        "test only one",
        "invariant something",
        "line 1",
        "line 2",
        "line 3",
    ];
    let result = get_last_block(&lines);
    assert(result == null);
}

test get_last_block_insufficient_invariants {
    var lines: [5][]const u8 = [
        "test one",
        "test two",
        "line 1",
        "line 2",
        "line 3",
    ];
    let result = get_last_block(&lines);
    assert(result == null);
}

test get_last_block_stops_at_keyword {
    var lines: [10][]const u8 = [
        "test first",
        "line 1",
        "invariant something",
        "line 2",
        "test second",
        "line 3",
        "fn something() { }", // should stop here
        "line 4",
    ];
    const expected: [3][]const u8 = [
        "invariant something",
        "line 2",
        "test second",
    ];
    let result = get_last_block(&lines);
    if (result) {
        assert(result.len == expected.len);
        for (i in 0..result.len) {
            assert(slices_equal(result[i], expected[i]));
        }
    } else {
        assert(false);
    }
}

test transform_block_simple {
    var input: [2][]const u8 = [
        "hello_w311_world",
        "foo_w310_bar_w309_baz",
    ];
    let result = transform_block(&input);
    assert(result.len > 0);
    // Check that the result contains the expected replacements
    // We'll check by looking for the expected substrings in the result
    // Since we cannot easily split the result into lines without allocation, we do a simple check:
    // The first line should be "hello_w312_world\\n"
    // The second line should be "foo_w312_bar_w312_baz\\n"
    // And then a final newline.
    // We'll check the entire string for the expected pattern.
    const expected_start: []const u8 = "hello_w312_world\\nfoo_w312_bar_w312_baz\\n\\n";
    // We cannot compare strings directly if one is a variable and the other is a literal? But we can if the literal is on the right.
    // According to the issue, == is allowed when one side is a literal.
    assert(result == expected_start);
}
