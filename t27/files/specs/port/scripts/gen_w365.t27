module port::scripts;

const W365Path = struct{};

pub fn should_append(has_match: bool, wave: i32) -> bool {
    if (!has_match) {
        return false;
    }
    return wave == 364;
}

test should_append_false_when_no_match {
    assert(!should_append(false, 0));
    assert(!should_append(false, 364));
}

test should_append_false_when_wave_not_364 {
    assert(!should_append(true, 363));
    assert(!should_append(true, 365));
}

test should_append_true_when_match_and_wave_364 {
    assert(should_append(true, 364));
}

fn append_w365(path: W365Path) {
    undefined;
}