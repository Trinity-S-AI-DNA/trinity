module port::scripts::tri_loop::claims;

pub fn main(argv: []str) -> i32 {
    // Filesystem operations are undefined; we test the decision logic
    undefined;
}

// Helper function to check if a step name contains strong words
pub fn has_strong_claim(name: []const u8) -> bool {
    // Simple implementation - check for exact matches of strong words
    if (contains_exact(name, "prove") or
        contains_exact(name, "proves") or
        contains_exact(name, "proof") or
        contains_exact(name, "bit-exact") or
        contains_exact(name, "bitexact") or
        contains_exact(name, "never") or
        contains_exact(name, "guarantee") or
        contains_exact(name, "exhaustive") or
        contains_exact(name, "correct") or
        starts_with_exact(name, "all ") or
        starts_with_exact(name, "every ") or
        starts_with_exact(name, "whole ")) {
        return true;
    }
    
    return false;
}

// Helper function to check if text mentions limits
pub fn mentions_limits(text: []const u8) -> bool {
    // Check for exact matches of limit phrases
    if (contains_exact(text, "does not check") or
        contains_exact(text, "not claimed") or
        contains_exact(text, "does not mean") or
        contains_exact(text, "says nothing") or
        contains_exact(text, "scoped claim") or
        contains_exact(text, "deliberately") or
        contains_exact(text, "is a ratchet") or
        contains_exact(text, "ledger")) {
        return true;
    }
    
    return false;
}

// Simple exact substring matching
fn contains_exact(s: []const u8, substr: []const u8) -> bool {
    var s_len = s.len;
    var substr_len = substr.len;
    
    if (substr_len == 0 or s_len < substr_len) {
        return false;
    }
    
    var i: usize = 0;
    while (i <= s_len - substr_len) {
        var j: usize = 0;
        while (j < substr_len) {
            if (s[i + j] != substr[j]) {
                break;
            }
            j += 1;
        }
        if (j == substr_len) {
            return true;
        }
        i += 1;
    }
    
    return false;
}

// Simple exact prefix matching
fn starts_with_exact(s: []const u8, prefix: []const u8) -> bool {
    var prefix_len = prefix.len;
    var s_len = s.len;
    
    if (prefix_len == 0 or s_len < prefix_len) {
        return false;
    }
    
    var i: usize = 0;
    while (i < prefix_len) {
        if (s[i] != prefix[i]) {
            return false;
        }
        i += 1;
    }
    
    return true;
}

// Test the decision logic
test strong_claim_detection {
    // Test names that should have strong claims
    assert(has_strong_claim("prove this works"));
    assert(has_strong_claim("proves the concept"));
    assert(has_strong_claim("proof of correctness"));
    assert(has_strong_claim("bit-exact matching"));
    assert(has_strong_claim("bitexact output"));
    assert(has_strong_claim("never fails"));
    assert(has_strong_claim("guaranteed success"));
    assert(has_strong_claim("exhaustive testing"));
    assert(has_strong_claim("correct implementation"));
    assert(has_strong_claim("all files processed"));
    assert(has_strong_claim("every test passes"));
    assert(has_strong_claim("whole system verified"));
    
    // Test names that should NOT have strong claims
    assert(!has_strong_claim("install dependencies"));
    assert(!has_strong_claim("delivery pipeline"));
    assert(!has_strong_claim("build project"));
    assert(!has_strong_claim("run tests"));
    assert(!has_strong_claim("deploy to production"));
}

test limit_detection {
    // Text that should mention limits
    assert(mentions_limits("this does not check performance"));
    assert(mentions_limits("not claimed to be perfect"));
    assert(mentions_limits("does not mean it's secure"));
    assert(mentions_limits("says nothing about scalability"));
    assert(mentions_limits("scoped claim only"));
    assert(mentions_limits("deliberately limited"));
    assert(mentions_limits("is a ratchet"));
    assert(mentions_limits("ledger of exceptions"));
    
    // Text that should NOT mention limits
    assert(!mentions_limits("this proves everything works"));
    assert(!mentions_limits("guaranteed to be fast"));
    assert(!mentions_limits("exhaustive coverage"));
    assert(!mentions_limits("correct implementation"));
}

test combined_logic {
    // Test the combination of strong claims and limits
    assert(has_strong_claim("prove correctness") and mentions_limits("does not check performance"));
    assert(has_strong_claim("exhaustive testing") and mentions_limits("not claimed to be perfect"));
    assert(has_strong_claim("all files processed") and !mentions_limits("this is comprehensive"));
}