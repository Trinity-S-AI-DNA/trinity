test find_specs_basic {
    // Test that find_specs filters .t27 files correctly
    var root: []const u8 = "specs";
    var excludes: []const u8 = "**/scratch/**|**/test/**";
    var specs = find_specs(root, excludes);
    
    // In a real implementation, this would find actual .t27 files
    // For now, we test the interface
    assert(specs.len == 0); // Empty in this mock
}

test find_specs_excludes {
    // Test that find_specs respects exclude patterns
    var root: []const u8 = "specs";
    var excludes: []const u8 = "**/scratch/**";
    var specs = find_specs(root, excludes);
    
    // Should not include files matching exclude patterns
    assert(specs.len == 0);
}

test parse_one_success {
    // Test parse_one with successful parsing
    var binary: []const u8 = "t27c";
    var path: []const u8 = "test.t27";
    var budget: f64 = 10.0;
    var result = parse_one(binary, path, budget);
    
    assert(result.path == path);
    assert(result.verdict == "ok");
    assert(result.exit_code == 0);
    assert(result.first_error == null);
    assert(result.ms > 0);
}

test parse_one_timeout {
    // Test parse_one timeout behavior
    // This would require mocking the timeout mechanism
    var binary: []const u8 = "t27c";
    var path: []const u8 = "slow_test.t27";
    var budget: f64 = 1.0; // Very short timeout
    var result = parse_one(binary, path, budget);
    
    // In a real implementation, this could timeout
    // For now, we just test the interface works
    assert(result.path == path);
}

test parse_one_failure {
