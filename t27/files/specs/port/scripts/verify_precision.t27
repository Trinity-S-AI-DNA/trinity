// SPDX-License-Identifier: Apache-2.0
// Port of scripts/verify_precision.py (issue #5620).
// The original prints sacred-constant checks at a chosen number of decimal digits
// with mpmath. Arbitrary precision, argparse, JSON output and file writing are
// plumbing. What is ported is what the script decides and computes: it refuses to
// run without mpmath (exit 1), the default precision is 100 digits, and the
// closed forms of phi, the trinity identity and the Pellis expression, here in f64.
module verify_precision {
    const DEFAULT_DIGITS: u32 = 100;
    const EXIT_OK: i32 = 0;
    const EXIT_FAIL: i32 = 1;

    // Original: `except ImportError: ... sys.exit(1)`.
    fn decide_start(has_mpmath: bool) -> i32 {
        if (!has_mpmath) {
            return EXIT_FAIL;
        }
        return EXIT_OK;
    }

    // Original: `--digits` defaults to 100 when not given (0 stands for "not given").
    fn effective_digits(requested: u32) -> u32 {
        if (requested == 0) {
            return DEFAULT_DIGITS;
        }
        return requested;
    }

    // phi = (1 + sqrt(5)) / 2, as the nearest f64.
    fn phi() -> f64 {
        return 1.618033988749895;
    }

    // phi_identity = phi^2 - phi - 1 (zero in exact arithmetic).
    fn phi_identity() -> f64 {
        const p = phi();
        return p * p - p - 1.0;
    }

    // trinity = phi^2 + phi_inv^2 (exactly 3).
    fn trinity() -> f64 {
        const p = phi();
        const inv = 1.0 / p;
        return p * p + inv * inv;
    }

    // pellis = 360 / phi^2 - 2 / phi^4 + 1 / (3 phi)^5.
    fn pellis_closed_form() -> f64 {
        const p = phi();
        const p2 = p * p;
        const p4 = p2 * p2;
        const q = 3.0 * p;
        const q5 = q * q * q * q * q;
        return 360.0 / p2 - 2.0 / p4 + 1.0 / q5;
    }

    // Plumbing: argv, mpmath, JSON, stdout or the output file.
    fn main() -> void {
        undefined;
    }

    test missing_mpmath_is_a_failure {
        assert(decide_start(false) == 1);
    }

    test present_mpmath_runs {
        assert(decide_start(true) == 0);
    }

    test digits_default_to_100 {
        assert(effective_digits(0) == 100);
    }

    test explicit_digits_are_kept {
        assert(effective_digits(200) == 200);
        assert(effective_digits(1) == 1);
    }

    test phi_identity_is_zero_to_double_precision {
        const d = phi_identity();
        assert(d < 0.000000000001);
        assert(d > -0.000000000001);
    }

    test trinity_identity_is_three {
        const d = trinity() - 3.0;
        assert(d < 0.000000000001);
        assert(d > -0.000000000001);
    }

    // 137.21633905226457 is what the original formula gives in double precision (checked with Python).
    test pellis_closed_form_value {
        const d = pellis_closed_form() - 137.21633905226457;
        assert(d < 0.000000001);
        assert(d > -0.000000001);
    }
}
