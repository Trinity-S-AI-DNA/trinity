// SPDX-License-Identifier: Apache-2.0
// Port of scripts/reseal-check.sh (issue #5873).
// The script compares the live digest of bootstrap/src/compiler.rs with the seal in the
// NMSE manifest and exits 0 (fresh), 2 (stale) or 3 (unsealed or source missing). Reading
// the files, hashing and printing are plumbing; the decisions are the exit code, whether
// the manifest counts as unsealed, and whether the FROZEN_HASH note is printed.
module reseal_check {
    const EXIT_FRESH: u32 = 0;
    const EXIT_STALE: u32 = 2;
    const EXIT_UNSEALED: u32 = 3;

    // is_unsealed(seal_len, seal_is_literal_unsealed): an empty seal or the literal
    // "unsealed" means the manifest carries nothing to compare.
    fn is_unsealed(seal_len: u32, seal_is_literal_unsealed: u32) -> u32 {
        if (seal_len == 0) {
            return 1;
        }
        if (seal_is_literal_unsealed == 1) {
            return 1;
        }
        return 0;
    }

    // verdict(source_present, unsealed, live_equals_seal): the exit code of the script.
    fn verdict(source_present: u32, unsealed: u32, live_equals_seal: u32) -> u32 {
        if (source_present == 0) {
            return EXIT_UNSEALED;
        }
        if (unsealed == 1) {
            return EXIT_UNSEALED;
        }
        if (live_equals_seal == 1) {
            return EXIT_FRESH;
        }
        return EXIT_STALE;
    }

    // frozen_note(frozen_len, live_equals_frozen): the stale branch adds a NOTE only when
    // FROZEN_HASH holds a digest that differs from the live one.
    fn frozen_note(frozen_len: u32, live_equals_frozen: u32) -> u32 {
        if (frozen_len == 0) {
            return 0;
        }
        if (live_equals_frozen == 1) {
            return 0;
        }
        return 1;
    }

    // Plumbing: hashes compiler.rs, reads the manifest and FROZEN_HASH, prints the
    // report; no test calls it.
    fn main() -> u32 {
        undefined;
    }

    test missing_source_is_unsealed_exit {
        assert(verdict(0, 0, 1) == 3);
    }

    test empty_or_literal_unsealed_seal {
        assert(is_unsealed(0, 0) == 1);
        assert(is_unsealed(64, 1) == 1);
        assert(is_unsealed(64, 0) == 0);
        assert(verdict(1, is_unsealed(0, 0), 0) == 3);
    }

    test matching_seal_is_fresh {
        assert(verdict(1, 0, 1) == 0);
    }

    test differing_seal_is_stale {
        assert(verdict(1, 0, 0) == 2);
    }

    test frozen_note_only_when_digest_differs {
        assert(frozen_note(0, 0) == 0);
        assert(frozen_note(64, 1) == 0);
        assert(frozen_note(64, 0) == 1);
    }
}
