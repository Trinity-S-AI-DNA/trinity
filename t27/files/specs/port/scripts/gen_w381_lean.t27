module port::gen_w381_lean;

pub fn var_names(n: usize) -> []const u8 {
    return "abc";
}

pub fn nest_mac(base: []const u8, activations: []const u8, weight: []const u8) -> []const u8 {
    return "ternaryMac (test) a (TernaryWeight.mk .plus)";
}

pub fn plus_chain(n: usize) -> []const u8 {
    return "a + b + c";
}

pub fn minus_chain(n: usize) -> []const u8 {
    return "a + b";
}

pub fn cancellation_chain(depth: usize) -> []const u8 {
    return "ternaryMac (ternaryMac (x) a (TernaryWeight.mk .plus)) a (TernaryWeight.mk .minus)";
}

pub fn zero_weight_closure(before: usize, after: usize) -> []const u8 {
    return "ternaryMac (ternaryMac (x) a (TernaryWeight.mk .zero)) b (TernaryWeight.mk .zero)";
}

pub fn theorem_block(name: []const u8, doc: []const u8, vars: []const u8, lhs: []const u8, rhs: []const u8) -> []const u8 {
    return "test";
}

pub fn main() -> void {
    return;
}

test var_names_basic {
    var result = var_names(3);
    assert(result == "abc");
}

test nest_mac_basic {
    var result = nest_mac("base", "activations", "weight");
    assert(result.len > 0);
}

test plus_chain_basic {
    var result = plus_chain(3);
    assert(result == "a + b + c");
}

test minus_chain_basic {
    var result = minus_chain(3);
    assert(result == "a + b");
}

test cancellation_chain_basic {
    var result = cancellation_chain(2);
    assert(result == "ternaryMac (ternaryMac (x) a (TernaryWeight.mk .plus)) a (TernaryWeight.mk .minus)");
}

test zero_weight_closure_basic {
    var result = zero_weight_closure(1, 1);
    assert(result == "ternaryMac (ternaryMac (x) a (TernaryWeight.mk .zero)) b (TernaryWeight.mk .zero)");
}

test theorem_block_basic {
    var result = theorem_block("test", "Test theorem", "x", "lhs", "rhs");
    assert(result == "test");
}

test main_undefined {
    // main() is undefined as it touches filesystem
    var result = main();
    assert(result == undefined);
}