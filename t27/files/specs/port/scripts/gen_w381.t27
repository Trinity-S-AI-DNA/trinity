// SPDX-License-Identifier: Apache-2.0
// Port of scripts/gen_w381.py (issue #5217).
// The original appends a Wave Loop 381 test/invariant block to each of the 27 IGLA
// specs. The decision in it is the verdict per spec: skip when no Wave Loop block
// exists, skip when the last block is not wave 380 (the block it copies and
// renames), otherwise append. File reading and writing and the text replacement
// are plumbing.
module gen_w381 {
    const WAVE: u32 = 381;
    const EXPECTED_LAST_WAVE: u32 = 380;

    // Verdicts: what happens to one spec file.
    const VERDICT_SKIP_NO_BLOCK: u32 = 0;
    const VERDICT_SKIP_WRONG_WAVE: u32 = 1;
    const VERDICT_APPEND: u32 = 2;

    // has_block: the regex found at least one "// Wave Loop N ... invariant ... true" block.
    // last_wave: the wave number of the last such block.
    fn append_w381(has_block: bool, last_wave: u32) -> u32 {
        if (!has_block) {
            return VERDICT_SKIP_NO_BLOCK;
        }
        if (last_wave != 380) {
            return VERDICT_SKIP_WRONG_WAVE;
        }
        return VERDICT_APPEND;
    }

    test no_block_is_skipped {
        assert(append_w381(false, 0) == 0);
    }

    test no_block_wins_over_a_matching_wave {
        assert(append_w381(false, 380) == 0);
    }

    test last_wave_380_is_appended {
        assert(append_w381(true, 380) == 2);
    }

    test an_older_wave_is_skipped {
        assert(append_w381(true, 379) == 1);
    }

    test the_same_wave_is_skipped {
        assert(append_w381(true, 381) == 1);
    }

    test a_newer_wave_is_skipped {
        assert(append_w381(true, 382) == 1);
    }

    // The wave this script appends follows the last wave it expects to find. A call, so the
    // assertion runs at runtime; two constants alone would fold at compile time.
    fn next_wave(last_wave: u32) -> u32 {
        return last_wave + 1;
    }

    test wave_constants_follow_each_other {
        assert(next_wave(EXPECTED_LAST_WAVE) == WAVE);
    }
}
