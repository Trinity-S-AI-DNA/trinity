// Main function - the script's top level
pub fn main() -> i32 {
    // Step 1: Check prerequisites
    if (!check_cargo_available()) {
        return 1; // Exit code 1 like original script
    }
    
    if (!check_node_available()) {
        return 1; // Exit code 1 like original script
    }
    
    // Step 2: Check backend build
    if (!check_backend_build_success()) {
        return 1; // Exit code 1 like original script
    }
    
    // Step 3: Check backend start
    if (!check_backend_start_success()) {
        return 1; // Exit code 1 like original script
    }
    
    // Step 4: Test CLI commands
    var tests_passed: bool = true;
    
    if (!test_agent_say_command("A", "message", "Hello from Agent A", "💬")) {
        tests_passed = false;
    }
    
    if (!test_agent_say_command("Q", "test_result", "All agents operational", "🧪")) {
        tests_passed = false;
    }
    
    if (!test_agent_say_command("27", "status", "Building spec...", "📡")) {
        tests_passed = false;
    }
    
    if (!test_agent_say_command("B", "error", "Build failed", "❌")) {
        tests_passed = false;
    }
    
    return if (tests_passed) 0 else 1;
}

test check_cargo_available_true {
    // Test that cargo availability check returns true when cargo is available
    assert(check_cargo_available() == true);
}

test check_node_available_true {
    // Test that node availability check returns true when node is available  
    assert(check_node_available() == true);
}

test get_package_command_pnpm {
    // Test that pnpm is preferred when available
    var result = get_package_command();
    assert(result.available == true);
    assert(result.command == "pnpm");
}

test get_package_command_fallback {
    // Test that npm is fallback when pnpm not available
    // This would need to mock pnpm unavailability, but we test the structure
    var result = get_package_command();
    // In real scenario, if pnpm not available, result.available would be false
    assert(result.command == "pnpm" or result.command == "npm");
}

test backend_build_success {
    // Test that backend build success check returns true when build succeeds
    assert(check_backend_build_success() == true);
}

test backend_start_success {
    // Test that backend start success check returns true when backend responds
    assert(check_backend_start_success() == true);
}

test agent_say_command_success {
    // Test that agent-say command returns true when command succeeds
    assert(test_agent_say_command("A", "message", "test", "💬") == true);
}

test main_script_success {
    // Test that main script returns 0 when all tests pass
    assert(main() == 0);
}