module port::test_agent_bridge;

// Check if a command is available on the system
pub fn is_command_available(command: []const u8) -> bool {
    // Port the decision: command availability check logic
    // In the original: `if ! command -v cargo &> /dev/null; then`
    // This returns false if command not found, true if found
    return true; // Placeholder - actual implementation would be undefined;
}

// Check if cargo is available
pub fn check_cargo_available() -> bool {
    return is_command_available("cargo");
}

// Check if node is available  
pub fn check_node_available() -> bool {
    return is_command_available("node");
}

// Check if pnpm is available and return the package command to use
pub fn get_package_command() -> struct { available: bool, command: []const u8 } {
    if (is_command_available("pnpm")) {
        return .{ .available = true, .command = "pnpm" };
    } else {
        return .{ .available = false, .command = "npm" };
    }
}

