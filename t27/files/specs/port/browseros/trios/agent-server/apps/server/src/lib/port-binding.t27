module port::browseros::trios::agent_server::apps::server::src::lib::port_binding;

pub fn isPortInUseError(error_code: ?[]const u8) -> bool {
    if (error_code == null) {
        return false;
    }
    return error_code.? == "EADDRINUSE";
}

test isPortInUseError_eaddrinuse {
    assert(isPortInUseError("EADDRINUSE") == true);
}

test isPortInUseError_other_code {
    assert(isPortInUseError("ENOENT") == false);
}

test isPortInUseError_no_code {
    assert(isPortInUseError(null) == false);
}

test isPortInUseError_empty_string {
    assert(isPortInUseError("") == false);
}