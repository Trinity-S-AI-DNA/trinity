module port::envelope;

// Stub types imported from './types' in the original
struct MonitoringSessionContext {
    // Placeholder - original types not provided
}

struct MonitoringToolCallRecord {
    // Placeholder - original types not provided  
}

struct MonitoringFinalization {
    // Placeholder - original types not provided
}

// Input struct for the function - simplified to avoid slice issues
struct BuildJudgeAuditEnvelopeInput {
    context: MonitoringSessionContext,
    toolCalls: ?[]MonitoringToolCallRecord,
    finalization: ?MonitoringFinalization,
}

struct JudgeAuditEnvelope {
    run: MonitoringSessionContext,
    toolCalls: ?[]MonitoringToolCallRecord,
    finalization: ?MonitoringFinalization,
}

pub fn buildJudgeAuditEnvelope(input: BuildJudgeAuditEnvelopeInput) -> JudgeAuditEnvelope {
    var envelope: JudgeAuditEnvelope = JudgeAuditEnvelope {
        run = input.context,
        toolCalls = input.toolCalls,
        finalization = null,
    };

    if (input.finalization != null) {
        envelope.finalization = input.finalization;
    }

    return envelope;
}

test buildJudgeAuditEnvelope_basic {
    // Test basic functionality without finalization
    var mock_context: MonitoringSessionContext = MonitoringSessionContext {};
    var input: BuildJudgeAuditEnvelopeInput = BuildJudgeAuditEnvelopeInput {
        context = mock_context,
        toolCalls = null,
        finalization = null,
    };
    
    var result = buildJudgeAuditEnvelope(input);
    // Check that the envelope was created and has null finalization
    assert(result.finalization == null);
}

test buildJudgeAuditEnvelope_with_finalization {
    // Test functionality with finalization
    var mock_context: MonitoringSessionContext = MonitoringSessionContext {};
    var mock_finalization: MonitoringFinalization = MonitoringFinalization {};
    var input: BuildJudgeAuditEnvelopeInput = BuildJudgeAuditEnvelopeInput {
        context = mock_context,
        toolCalls = null,
        finalization = mock_finalization,
    };
    
    var result = buildJudgeAuditEnvelope(input);
    // Check that finalization was added
    assert(result.finalization != null);
}