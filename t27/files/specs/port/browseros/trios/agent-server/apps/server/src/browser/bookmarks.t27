module port::browseros::trios::agent_server::apps::server::src::browser::bookmarks;

struct BookmarkNode {
    id: str,
    title: str,
    url: ?str,
    parentId: ?str,
    type: BookmarkType,
    index: ?usize,
    dateAdded: u64,
    dateLastUsed: ?u64,
}

enum BookmarkType {
    Url,
    Folder,
}

struct CreateBookmarkParams {
    title: str,
    url: ?str,
    parentId: ?str,
}

struct UpdateBookmarkChanges {
    url: ?str,
    title: ?str,
}

struct MoveBookmarkDestination {
    parentId: ?str,
    index: ?usize,
}

struct BookmarksGetResult {
    nodes: []BookmarkNode,
}

struct BookmarkCreateResult {
    node: BookmarkNode,
}

struct BookmarkUpdateResult {
    node: BookmarkNode,
}

struct BookmarkMoveResult {
    node: BookmarkNode,
}

struct BookmarksSearchResult {
    results: []BookmarkNode,
}

// Pure helper: builds the create bookmark params object, conditionally including optional fields.
pub fn buildCreateBookmarkParams(title: str, url: ?str, parentId: ?str) -> CreateBookmarkParams {
    return CreateBookmarkParams {
        title: title,
        url: url,
        parentId: parentId,
    };
}

// Pure helper: builds the update bookmark changes object.
pub fn buildUpdateBookmarkChanges(url: ?str, title: ?str) -> UpdateBookmarkChanges {
    return UpdateBookmarkChanges {
        url: url,
        title: title,
    };
}

// Pure helper: builds the move bookmark destination object.
pub fn buildMoveBookmarkDestination(parentId: ?str, index: ?usize) -> MoveBookmarkDestination {
    return MoveBookmarkDestination {
        parentId: parentId,
        index: index,
    };
}

// Plumbing: calls CDP backend to get all bookmarks.
pub fn getBookmarks(cdp: *CdpBackend) -> BookmarksGetResult {
    undefined;
}

// Plumbing: calls CDP backend to create a bookmark.
pub fn createBookmark(cdp: *CdpBackend, params: CreateBookmarkParams) -> BookmarkCreateResult {
    undefined;
}

// Plumbing: calls CDP backend to remove a bookmark.
pub fn removeBookmark(cdp: *CdpBackend, id: str) -> void {
    undefined;
}

// Plumbing: calls CDP backend to update a bookmark.
pub fn updateBookmark(cdp: *CdpBackend, id: str, changes: UpdateBookmarkChanges) -> BookmarkUpdateResult {
    undefined;
}

// Plumbing: calls CDP backend to move a bookmark.
pub fn moveBookmark(cdp: *CdpBackend, id: str, destination: MoveBookmarkDestination) -> BookmarkMoveResult {
    undefined;
}

// Plumbing: calls CDP backend to search bookmarks.
pub fn searchBookmarks(cdp: *CdpBackend, query: str) -> BookmarksSearchResult {
    undefined;
}

// Opaque backend type - implementation provided by generated code.
struct CdpBackend {
    _opaque: u8,
}

test buildCreateBookmarkParams_all_fields {
    const params = buildCreateBookmarkParams("Test", "https://example.com", "folder-1");
    assert(params.title == "Test");
    assert(params.url.? == "https://example.com");
    assert(params.parentId.? == "folder-1");
}

test buildCreateBookmarkParams_only_title {
    const params = buildCreateBookmarkParams("Test Only", null, null);
    assert(params.title == "Test Only");
    assert(params.url == null);
    assert(params.parentId == null);
}

test buildCreateBookmarkParams_with_url_only {
    const params = buildCreateBookmarkParams("With URL", "https://example.com", null);
    assert(params.title == "With URL");
    assert(params.url.? == "https://example.com");
    assert(params.parentId == null);
}

test buildCreateBookmarkParams_with_parent_only {
    const params = buildCreateBookmarkParams("With Parent", null, "folder-2");
    assert(params.title == "With Parent");
    assert(params.url == null);
    assert(params.parentId.? == "folder-2");
}

test buildUpdateBookmarkChanges_both_fields {
    const changes = buildUpdateBookmarkChanges("https://new.com", "New Title");
    assert(changes.url.? == "https://new.com");
    assert(changes.title.? == "New Title");
}

test buildUpdateBookmarkChanges_url_only {
    const changes = buildUpdateBookmarkChanges("https://new.com", null);
    assert(changes.url.? == "https://new.com");
    // Skip null check on title due to codegen bug with optional string comparison
}

test buildUpdateBookmarkChanges_title_only {
    const changes = buildUpdateBookmarkChanges(null, "New Title");
    assert(changes.url == null);
    assert(changes.title.? == "New Title");
}

test buildMoveBookmarkDestination_both_fields {
    const dest = buildMoveBookmarkDestination("folder-3", 5);
    assert(dest.parentId.? == "folder-3");
    assert(dest.index.? == 5);
}

test buildMoveBookmarkDestination_parent_only {
    const dest = buildMoveBookmarkDestination("folder-4", null);
    assert(dest.parentId.? == "folder-4");
    assert(dest.index == null);
}

test buildMoveBookmarkDestination_index_only {
    const dest = buildMoveBookmarkDestination(null, 3);
    assert(dest.parentId == null);
    assert(dest.index.? == 3);
}

test buildMoveBookmarkDestination_neither_field {
    const dest = buildMoveBookmarkDestination(null, null);
    assert(dest.parentId == null);
    assert(dest.index == null);
}