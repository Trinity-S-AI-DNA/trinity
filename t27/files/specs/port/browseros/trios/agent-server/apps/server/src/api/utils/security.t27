module port::security;

pub fn isLocalhostDecision(socketAddr: ?[]const u8, hostHeader: []const u8, refererHeader: ?[]const u8) -> bool {
    // 1. Check socketAddr
    if (socketAddr) |addr| {
        if (std.mem.eql(u8, addr, "127.0.0.1") or std.mem.eql(u8, addr, "::1") or std.mem.eql(u8, addr, "::ffff:127.0.0.1")) {
            // socketAddr is localhost, continue to host header check
        } else {
            return false;
        }
    } else {
        return false;
    }

    // 2. Check host header - extract hostname before ':'
    var i: usize = 0;
    while (i < hostHeader.len) {
        if (hostHeader[i] == ':') {
            break;
        }
        i += 1;
    }
    const hostname = if (i < hostHeader.len) hostHeader[0..i] else hostHeader;
    if (! (std.mem.eql(u8, hostname, "127.0.0.1") or std.mem.eql(u8, hostname, "localhost"))) {
        return false;
    }

    // 3. Check refererHeader if present
    if (refererHeader) |referer| {
        // Extract hostname from referer string
        const refererHostname = extractHostnameFromReferer(referer);
        if (refererHostname) |host| {
            if (! (std.mem.eql(u8, host, "127.0.0.1") or std.mem.eql(u8, host, "localhost"))) {
                return false;
            }
        } else {
            // Failed to parse referer, treat as invalid
            return false;
        }
    }

    return true;
}

// Helper to extract hostname from a referer string (assuming it's a URL)
fn extractHostnameFromReferer(referer: []const u8) -> ?[]const u8 {
    // Skip scheme if present
    var start: usize = 0;
    if (referer.len >= 7 && std.mem.eql(u8, referer[0..7], "http://")) {
        start = 7;
    } else if (referer.len >= 8 && std.mem.eql(u8, referer[0..8], "https://")) {
        start = 8;
    }
    // Find end of hostname: first '/' or ':' or end
    var end: usize = start;
    while (end < referer.len) {
        if (referer[end] == '/' || referer[end] == ':') {
            break;
        }
        end += 1;
    }
    if (start == end) {
        return null;
    }
    return referer[start..end];
}

// The original function - plumbing left undefined
pub fn isLocalhostRequest(c: Context<Env>) -> bool {
    undefined;
}

// Tests for the decision helper
test "isLocalhostDecision: localhost IPv4" {
    const addr: []const u8 = "127.0.0.1";
    const host: []const u8 = "127.0.0.1";
    const referer: ?[]const u8 = null;
    assert(isLocalhostDecision(addr, host, referer) == true);
}

test "isLocalhostDecision: localhost IPv6" {
    const addr: []const u8 = "::1";
    const host: []const u8 = "[::1]:3000"; // with port
    const referer: ?[]const u8 = null;
    assert(isLocalhostDecision(addr, host, referer) == true);
}

test "isLocalhostDecision: localhost IPv4-mapped" {
    const addr: []const u8 = "::ffff:127.0.0.1";
    const host: []const u8 = "localhost";
    const referer: ?[]const u8 = null;
    assert(isLocalhostDecision(addr, host, referer) == true);
}

test "isLocalhostDecision: non-localhost address" {
    const addr: []const u8 = "192.168.1.1";
    const host: []const u8 = "192.168.1.1";
    const referer: ?[]const u8 = null;
    assert(isLocalhostDecision(addr, host, referer) == false);
}

test "isLocalhostDecision: null socketAddr" {
    const addr: ?[]const u8 = null;
    const host: []const u8 = "127.0.0.1";
    const referer: ?[]const u8 = null;
    assert(isLocalhostDecision(addr, host, referer) == false);
}

test "isLocalhostDecision: invalid host header" {
    const addr: []const u8 = "127.0.0.1";
    const host: []const u8 = "example.com";
    const referer: ?[]const u8 = null;
    assert(isLocalhostDecision(addr, host, referer) == false);
}

test "isLocalhostDecision: host with port" {
    const addr: []const u8 = "127.0.0.1";
    const host: []const u8 = "localhost:8080";
    const referer: ?[]const u8 = null;
    assert(isLocalhostDecision(addr, host, referer) == true);
}

test "isLocalhostDecision: referer localhost" {
    const addr: []const u8 = "127.0.0.1";
    const host: []const u8 = "127.0.0.1";
    const referer: []const u8 = "http://127.0.0.1/some/path";
    assert(isLocalhostDecision(addr, host, referer) == true);
}

test "isLocalhostDecision: referer localhost https" {
    const addr: []const u8 = "127.0.0.1";
    const host: []const u8 = "127.0.0.1";
    const referer: []const u8 = "https://localhost:3000/foo";
    assert(isLocalhostDecision(addr, host, referer) == true);
}

test "isLocalhostDecision: referer non-localhost" {
    const addr: []const u8 = "127.0.0.1";
    const host: []const u8 = "127.0.0.1";
    const referer: []const u8 = "http://example.com/";
    assert(isLocalhostDecision(addr, host, referer) == false);
}

test "isLocalhostDecision: referer invalid URL (no scheme)" {
    const addr: []const u8 = "127.0.0.1";
    const host: []const u8 = "127.0.0.1";
    const referer: []const u8 = "something";
    assert(isLocalhostDecision(addr, host, referer) == false);
}