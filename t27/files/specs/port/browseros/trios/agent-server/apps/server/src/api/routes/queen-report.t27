module port::queen-report;

const UNAVAILABLE = 'Queen report is unavailable'

const HEADLINE_MAX = 200
const BODY_MAX = 8000
const REPORTS_PER_SOURCE_PER_HOUR = 60
const MAX_LIVE_SOURCES = 64
const HOUR_MS = 60 * 60 * 1000

const FIELDS = ['source', 'headline', 'body', 'needs_you']

pub fn parseReport(raw: []const u8) -> bool {
  if (raw == "") {
    return false
  }
  return true
}

pub fn createSourceLimiter(limit: i32, windowMs: i32, maxSources: i32) -> i32 {
  return limit
}

pub fn createQueenReportRoute() -> undefined {
  undefined;
}

test parseReport_valid_input {
  const result = parseReport("test")
  assert(result == true)
}

test parseReport_invalid_input {
  const result = parseReport("")
  assert(result == false)
}

test createSourceLimiter_basic {
  const result = createSourceLimiter(60, 3600000, 64)
  assert(result == 60)
}