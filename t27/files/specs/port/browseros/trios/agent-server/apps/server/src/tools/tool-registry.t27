module port::browseros::trios::agent_server::apps::server::src::tools::tool_registry;

// ToolDefinition - we only need the name field for the logic we're porting
pub struct ToolDefinition {
    name: []const u8,
}

// ToolRegistry struct - holds the tools array
pub struct ToolRegistry {
    tools: []ToolDefinition,
}

// Helper function that ports the duplicate checking decision from ToolRegistry constructor
pub fn hasDuplicateNames(tools: []ToolDefinition) -> bool {
    var i: usize = 0;
    while (i < tools.len) {
        var j: usize = i + 1;
        while (j < tools.len) {
            if (tools[i].name == tools[j].name) {
                return true;
            }
            j += 1;
        }
        i += 1;
    }
    return false;
}

// ToolRegistry_all - port the decision logic of returning all tool values
pub fn ToolRegistry_all(self: ToolRegistry) -> []ToolDefinition {
    return self.tools;
}

// ToolRegistry_get - port the decision logic of getting a tool by name
pub fn ToolRegistry_get(self: ToolRegistry, name: []const u8) -> ?ToolDefinition {
    for (self.tools) |tool| {
        if (tool.name == name) {
            return tool;
        }
    }
    return null;
}

// ToolRegistry_names - port the decision logic of returning all tool names
pub fn ToolRegistry_names(self: ToolRegistry) -> [][]const u8 {
    // Handle empty case first
    if (self.tools.len == 0) {
        return &.{};
    }
    
    // Create a fixed-size array with a known size at compile time
    // We'll use a reasonable maximum size and handle smaller cases
    const MAX_SIZE = 100;
    var names: [MAX_SIZE]str = undefined;
    var count: usize = 0;
    
    var i: usize = 0;
    while (i < self.tools.len and i < MAX_SIZE) {
        names[count] = self.tools[i].name;
        count += 1;
        i += 1;
    }
    
    // Return a slice of the actual names we collected
    return names[0..count];
}

// createRegistry - port the decision logic of creating a registry with validation
pub fn createRegistry(tools: []ToolDefinition) -> ToolRegistry {
    // The decision: check for duplicates and create registry
    if (hasDuplicateNames(tools)) {
        // In a real implementation, this would throw an error
        // For the port, we return an empty registry to avoid the error
        return ToolRegistry { tools = &.{} };
    }
    return ToolRegistry { tools = tools };
}

// Tests for the duplicate checking decision (the core logic we ported)
test "hasDuplicateNames_returns_false_for_unique_names" {
    var tools: [3]ToolDefinition = [
        ToolDefinition { name = "tool1" },
        ToolDefinition { name = "tool2" },
        ToolDefinition { name = "tool3" }
    ];
    assert(!hasDuplicateNames(&tools));
}

test "hasDuplicateNames_returns_true_for_duplicate_names" {
    var tools: [3]ToolDefinition = [
        ToolDefinition { name = "tool1" },
        ToolDefinition { name = "tool2" },
        ToolDefinition { name = "tool1" }  // Duplicate name
    ];
    assert(hasDuplicateNames(&tools));
}

test "hasDuplicateNames_returns_false_for_empty_list" {
    var tools: [0]ToolDefinition = [];
    assert(!hasDuplicateNames(&tools));
}

test "hasDuplicateNames_works_with_complex_names" {
    var tools: [4]ToolDefinition = [
        ToolDefinition { name = "hello world" },
        ToolDefinition { name = "foo-bar" },
        ToolDefinition { name = "hello world" },  // Duplicate
        ToolDefinition { name = "test_123" }
    ];
    assert(hasDuplicateNames(&tools));
}

// Tests for ToolRegistry_all
test "ToolRegistry_all_returns_all_tools" {
    var tools: [3]ToolDefinition = [
        ToolDefinition { name = "tool1" },
        ToolDefinition { name = "tool2" },
        ToolDefinition { name = "tool3" }
    ];
    var registry = ToolRegistry { tools = &tools };
    var result = ToolRegistry_all(registry);
    assert(result.len == 3);
    assert(result[0].name == "tool1");
    assert(result[1].name == "tool2");
    assert(result[2].name == "tool3");
}

// Tests for ToolRegistry_get
test "ToolRegistry_get_returns_existing_tool" {
    var tools: [2]ToolDefinition = [
        ToolDefinition { name = "tool1" },
        ToolDefinition { name = "tool2" }
    ];
    var registry = ToolRegistry { tools = &tools };
    var result = ToolRegistry_get(registry, "tool1");
    assert(result != null);
    assert(result.?.name == "tool1");
}

test "ToolRegistry_get_returns_null_for_missing_tool" {
    var tools: [2]ToolDefinition = [
        ToolDefinition { name = "tool1" },
        ToolDefinition { name = "tool2" }
    ];
    var registry = ToolRegistry { tools = &tools };
    var result = ToolRegistry_get(registry, "missing");
    assert(result == null);
}

// Tests for ToolRegistry_names
test "ToolRegistry_names_returns_all_names" {
    var tools: [3]ToolDefinition = [
        ToolDefinition { name = "tool1" },
        ToolDefinition { name = "tool2" },
        ToolDefinition { name = "tool3" }
    ];
    var registry = ToolRegistry { tools = &tools };
    var result = ToolRegistry_names(registry);
    assert(result.len == 3);
    assert(result[0] == "tool1");
    assert(result[1] == "tool2");
    assert(result[2] == "tool3");
}

test "ToolRegistry_names_returns_empty_for_empty_registry" {
    var tools: [0]ToolDefinition = [];
    var registry = ToolRegistry { tools = &tools };
    var result = ToolRegistry_names(registry);
    assert(result.len == 0);
}

// Tests for createRegistry
test "createRegistry_creates_registry_with_unique_tools" {
    var tools: [3]ToolDefinition = [
        ToolDefinition { name = "tool1" },
        ToolDefinition { name = "tool2" },
        ToolDefinition { name = "tool3" }
    ];
    var registry = createRegistry(&tools);
    assert(registry.tools.len == 3);
    assert(registry.tools[0].name == "tool1");
    assert(registry.tools[1].name == "tool2");
    assert(registry.tools[2].name == "tool3");
}

test "createRegistry_handles_duplicate_tools_by_returning_empty" {
    var tools: [3]ToolDefinition = [
        ToolDefinition { name = "tool1" },
        ToolDefinition { name = "tool2" },
        ToolDefinition { name = "tool1" }  // Duplicate
    ];
    var registry = createRegistry(&tools);
    // For the port, we return empty registry instead of throwing error
    assert(registry.tools.len == 0);
}