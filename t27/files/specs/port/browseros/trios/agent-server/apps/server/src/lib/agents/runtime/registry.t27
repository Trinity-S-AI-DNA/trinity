module port::browseros::trios::agent_server::apps::server::src::lib::agents::runtime::registry;

struct AgentRuntimeDescriptor {
    adapter_id: []const u8,
}

struct AgentRuntime {
    descriptor: AgentRuntimeDescriptor,
}

const MAX_RUNTIMES: usize = 16;

struct AgentRuntimeRegistry {
    runtimes: [MAX_RUNTIMES]AgentRuntime,
    len: usize,
}

pub fn AgentRuntimeRegistry_register(self: *AgentRuntimeRegistry, runtime: AgentRuntime) void {
    const id = runtime.descriptor.adapter_id;
    var i: usize = 0;
    while (i < self.len) : (i += 1) {
        if (self.runtimes[i].descriptor.adapter_id == id) {
            return; // In original: throws error. Here: silent no-op per porting decision.
        }
    }
    if (self.len < MAX_RUNTIMES) {
        self.runtimes[self.len] = runtime;
        self.len += 1;
    }
}

pub fn AgentRuntimeRegistry_get(self: *AgentRuntimeRegistry, adapter_id: []const u8) ?AgentRuntime {
    var i: usize = 0;
    while (i < self.len) : (i += 1) {
        if (self.runtimes[i].descriptor.adapter_id == adapter_id) {
            return self.runtimes[i];
        }
    }
    return null;
}

pub fn AgentRuntimeRegistry_list(self: *AgentRuntimeRegistry) []const AgentRuntime {
    return self.runtimes[0..self.len];
}

pub fn AgentRuntimeRegistry_unregister(self: *AgentRuntimeRegistry, adapter_id: []const u8) bool {
    var i: usize = 0;
    while (i < self.len) : (i += 1) {
        if (self.runtimes[i].descriptor.adapter_id == adapter_id) {
            // Shift remaining elements left
            var j: usize = i;
            while (j + 1 < self.len) : (j += 1) {
                self.runtimes[j] = self.runtimes[j + 1];
            }
            self.len -= 1;
            return true;
        }
    }
    return false;
}

// Global registry state - using a module-level variable pattern
var global_registry: ?AgentRuntimeRegistry = null;

pub fn getAgentRuntimeRegistry() *AgentRuntimeRegistry {
    if (global_registry == null) {
        global_registry = AgentRuntimeRegistry{ .runtimes = [_]AgentRuntime{undefined} ** MAX_RUNTIMES, .len = 0 };
    }
    return &global_registry.?;
}

pub fn resetAgentRuntimeRegistry() void {
    global_registry = null;
}

test "AgentRuntimeRegistry_register adds runtime" {
    var registry = AgentRuntimeRegistry{ .runtimes = [_]AgentRuntime{undefined} ** MAX_RUNTIMES, .len = 0 };
    const runtime = AgentRuntime{ .descriptor = .{ .adapter_id = "test-adapter" } };
    AgentRuntimeRegistry_register(&registry, runtime);
    assert(registry.len == 1);
    assert(registry.runtimes[0].descriptor.adapter_id == "test-adapter");
}

test "AgentRuntimeRegistry_register rejects duplicate adapter_id" {
    var registry = AgentRuntimeRegistry{ .runtimes = [_]AgentRuntime{undefined} ** MAX_RUNTIMES, .len = 0 };
    const runtime1 = AgentRuntime{ .descriptor = .{ .adapter_id = "dup-adapter" } };
    const runtime2 = AgentRuntime{ .descriptor = .{ .adapter_id = "dup-adapter" } };
    AgentRuntimeRegistry_register(&registry, runtime1);
    AgentRuntimeRegistry_register(&registry, runtime2);
    // Original throws error; ported version silently ignores duplicate
    assert(registry.len == 1);
}

test "AgentRuntimeRegistry_get returns runtime for existing adapter_id" {
    var registry = AgentRuntimeRegistry{ .runtimes = [_]AgentRuntime{undefined} ** MAX_RUNTIMES, .len = 0 };
    const runtime = AgentRuntime{ .descriptor = .{ .adapter_id = "get-adapter" } };
    AgentRuntimeRegistry_register(&registry, runtime);
    const found = AgentRuntimeRegistry_get(&registry, "get-adapter");
    assert(found != null);
    assert(found.?.descriptor.adapter_id == "get-adapter");
}

test "AgentRuntimeRegistry_get returns null for unknown adapter_id" {
    var registry = AgentRuntimeRegistry{ .runtimes = [_]AgentRuntime{undefined} ** MAX_RUNTIMES, .len = 0 };
    const found = AgentRuntimeRegistry_get(&registry, "unknown");
    assert(found == null);
}

test "AgentRuntimeRegistry_list returns all registered runtimes" {
    var registry = AgentRuntimeRegistry{ .runtimes = [_]AgentRuntime{undefined} ** MAX_RUNTIMES, .len = 0 };
    const r1 = AgentRuntime{ .descriptor = .{ .adapter_id = "list-1" } };
    const r2 = AgentRuntime{ .descriptor = .{ .adapter_id = "list-2" } };
    AgentRuntimeRegistry_register(&registry, r1);
    AgentRuntimeRegistry_register(&registry, r2);
    const list = AgentRuntimeRegistry_list(&registry);
    assert(list.len == 2);
    assert(list[0].descriptor.adapter_id == "list-1");
    assert(list[1].descriptor.adapter_id == "list-2");
}

test "AgentRuntimeRegistry_unregister removes existing runtime" {
    var registry = AgentRuntimeRegistry{ .runtimes = [_]AgentRuntime{undefined} ** MAX_RUNTIMES, .len = 0 };
    const r1 = AgentRuntime{ .descriptor = .{ .adapter_id = "unreg-1" } };
    const r2 = AgentRuntime{ .descriptor = .{ .adapter_id = "unreg-2" } };
    AgentRuntimeRegistry_register(&registry, r1);
    AgentRuntimeRegistry_register(&registry, r2);
    const removed = AgentRuntimeRegistry_unregister(&registry, "unreg-1");
    assert(removed == true);
    assert(registry.len == 1);
    assert(registry.runtimes[0].descriptor.adapter_id == "unreg-2");
}

test "AgentRuntimeRegistry_unregister returns false for unknown adapter_id" {
    var registry = AgentRuntimeRegistry{ .runtimes = [_]AgentRuntime{undefined} ** MAX_RUNTIMES, .len = 0 };
    const removed = AgentRuntimeRegistry_unregister(&registry, "unknown");
    assert(removed == false);
    assert(registry.len == 0);
}

test "getAgentRuntimeRegistry returns singleton instance" {
    resetAgentRuntimeRegistry();
    const reg1 = getAgentRuntimeRegistry();
    const reg2 = getAgentRuntimeRegistry();
    assert(reg1 == reg2);
}

test "resetAgentRuntimeRegistry clears global registry" {
    resetAgentRuntimeRegistry();
    const reg1 = getAgentRuntimeRegistry();
    // Add something to it
    const runtime = AgentRuntime{ .descriptor = .{ .adapter_id = "reset-test" } };
    AgentRuntimeRegistry_register(reg1, runtime);
    assert(reg1.len == 1);
    resetAgentRuntimeRegistry();
    const reg2 = getAgentRuntimeRegistry();
    // After reset, registry should be empty (new logical instance)
    assert(reg2.len == 0);
}