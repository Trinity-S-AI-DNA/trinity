module port::memory;

const MAX_CONTENT_LENGTH = 50000;

// Plumbing function that touches the world - has undefined body
pub fn createMemoryRoutes() -> undefined {
    undefined;
}

// Decision: GET endpoint logic - return empty content if file doesn't exist, otherwise return file content
pub fn get_memory_content() -> struct { content: []const u8 } {
    // In the original, this would check if the file exists and return empty string if not
    // Since we're porting decisions, not plumbing, we simulate the decision logic
    // The actual file existence check and reading would be handled by the caller
    return .{ .content = "" };
}

// Decision: PUT endpoint logic - validate content and confirm success
pub fn save_memory_content(content: []const u8) -> struct { success: bool } {
    // The original validates content length against MAX_CONTENT_LENGTH
    if (content.len > MAX_CONTENT_LENGTH) {
        // In the original, this would be caught by zod validation
        // For the decision logic, we return false to indicate validation failure
        return .{ .success = false };
    }
    
    // The original creates directory and writes file
    // Since we're porting decisions, not plumbing, we just confirm the decision to proceed
    return .{ .success = true };
}

// Test the GET endpoint decision logic
test get_memory_content_empty {
    const result = get_memory_content();
    assert(result.content.len == 0);
}

// Test the PUT endpoint decision logic with valid content
test save_memory_content_valid {
    const content = "test memory content";
    const result = save_memory_content(content);
    assert(result.success == true);
}

// Test the PUT endpoint decision logic with content too long
test save_memory_content_too_long {
    var long_content: [MAX_CONTENT_LENGTH + 1]u8 = undefined;
    for (0..long_content.len) |i| {
        long_content[i] = 'x';
    }
    const result = save_memory_content(&long_content);
    assert(result.success == false);
}

// Test the PUT endpoint decision logic with exactly max length
test save_memory_content_max_length {
    var max_content: [MAX_CONTENT_LENGTH]u8 = undefined;
    for (0..max_content.len) |i| {
        max_content[i] = 'y';
    }
    const result = save_memory_content(&max_content);
    assert(result.success == true);
}