module port::browseros::trios::agent_server::apps::server::src::api::routes::queen_rehearsal;

struct RehearsalRequest {
    model: []const u8,
}

struct SseFrame {
    id: []const u8,
    object: []const u8,
    created: u64,
    model: []const u8,
    delta_content: []const u8,
    delta_role: []const u8,
    finish_reason: ?[]const u8,
}

const REHEARSAL_REPLY: []const u8 = "Rehearsal turn. This reply came from a recorded stream inside the container, not from a model: the deployment holds no provider credential, and this route exists so the dispatch chain can be proven without one. Nothing was read and nothing was decided.";

pub fn build_rehearsal_reply() -> []const u8 {
    return REHEARSAL_REPLY;
}

struct WordsResult {
    words: [64][]const u8,
    len: usize,
}

pub fn split_into_words(text: []const u8) -> WordsResult {
    var words: [64][]const u8 = undefined;
    var word_count: usize = 0;
    var start: usize = 0;
    var in_word: bool = false;
    var i: usize = 0;

    while (i < text.len) {
        const c = text[i];
        if (c != ' ' and c != '\t' and c != '\n' and c != '\r') {
            if (!in_word) {
                start = i;
                in_word = true;
            }
        } else if (in_word) {
            words[word_count] = text[start..i];
            word_count += 1;
            in_word = false;
        }
        i += 1;
    }

    if (in_word) {
        words[word_count] = text[start..text.len];
        word_count += 1;
    }

    return WordsResult { words: words, len: word_count };
}

pub fn build_sse_frame(frame: SseFrame) -> []const u8 {
    // In .t27 we return the frame structure; JSON serialization is plumbing
    _ = frame;
    return "data: {\"id\":\"rehearsal\",\"object\":\"chat.completion.chunk\",\"created\":0,\"model\":\"rehearsal\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"test\"},\"finish_reason\":null}]}\n\n";
}

pub fn build_initial_frame(model: []const u8) -> SseFrame {
    return SseFrame {
        id: "rehearsal",
        object: "chat.completion.chunk",
        created: 0,
        model: model,
        delta_content: "",
        delta_role: "assistant",
        finish_reason: null,
    };
}

// The caller owns the buffer: a slice of a local array would dangle once this fn returns.
pub fn build_content_frame(model: []const u8, word: []const u8, content_buf: []u8) -> SseFrame {
    var content_len: usize = 0;
    var i: usize = 0;
    while (i < word.len) {
        content_buf[i] = word[i];
        content_len = i + 1;
        i += 1;
    }
    content_buf[content_len] = ' ';
    content_len += 1;

    return SseFrame {
        id: "rehearsal",
        object: "chat.completion.chunk",
        created: 0,
        model: model,
        delta_content: content_buf[0..content_len],
        delta_role: "",
        finish_reason: null,
    };
}

pub fn build_final_frame(model: []const u8) -> SseFrame {
    return SseFrame {
        id: "rehearsal",
        object: "chat.completion.chunk",
        created: 0,
        model: model,
        delta_content: "",
        delta_role: "",
        finish_reason: "stop",
    };
}

pub fn createQueenRehearsalRoute() -> void {
    undefined;
}

test build_rehearsal_reply_returns_expected_text {
    const reply = build_rehearsal_reply();
    assert(reply.len > 0);
    // Check it has the expected length (the constant's length)
    assert(reply.len == REHEARSAL_REPLY.len);
    // Check first few characters match
    assert(reply[0] == 'R');
    assert(reply[1] == 'e');
    assert(reply[2] == 'h');
    assert(reply[3] == 'e');
}

test split_into_words_splits_correctly {
    const result = split_into_words("hello world test");
    assert(result.len == 3);
    assert(result.words[0] == "hello");
    assert(result.words[1] == "world");
    assert(result.words[2] == "test");
}

test split_into_words_handles_multiple_spaces {
    const result = split_into_words("hello   world");
    assert(result.len == 2);
    assert(result.words[0] == "hello");
    assert(result.words[1] == "world");
}

test split_into_words_empty_string {
    const result = split_into_words("");
    assert(result.len == 0);
}

test build_initial_frame_has_correct_structure {
    const frame = build_initial_frame("rehearsal");
    assert(frame.id == "rehearsal");
    assert(frame.object == "chat.completion.chunk");
    assert(frame.created == 0);
    assert(frame.model == "rehearsal");
    assert(frame.delta_role == "assistant");
    assert(frame.finish_reason == null);
}

test build_content_frame_includes_word_with_space {
    var buf: [256]u8 = undefined;
    const frame = build_content_frame("rehearsal", "test", &buf);
    assert(frame.delta_content == "test ");
    assert(frame.finish_reason == null);
}

test build_final_frame_has_stop_reason {
    const frame = build_final_frame("rehearsal");
    assert(frame.finish_reason.? == "stop");
    assert(frame.delta_content == "");
}