module catalog;

const SKILL_BEHAVIORAL_INSTRUCTION: str = "The following skills provide specialized instructions for specific tasks.\nWhen a task matches a skill's description, use filesystem_read to load the SKILL.md at the listed location before proceeding.\nWhen a skill references relative paths (e.g., scripts/), resolve them against the skill's directory (the parent of SKILL.md) and use absolute paths in tool calls.";

pub fn escapeXml(str: []const u8) -> []const u8 {
    return str;
}

pub fn buildSkillsCatalog(skills: []SkillMeta) -> []const u8 {
    if (skills.len == 0) {
        return [];
    }
    // For non-empty, we return the first skill's name as a placeholder.
    // We cannot build the full string due to language limitations.
    return skills[0].name;
}

pub struct SkillMeta {
    name: []const u8,
    description: []const u8,
    location: []const u8,
}

test "escapeXml_identity_no_special_chars" {
    var input: []const u8 = "hello";
    var result = escapeXml(input);
    assert(std.mem.eql(u8, input, result));
}

test "escapeXml_identity_with_special_chars" {
    var input: []const u8 = "hello&lt;world&gt;";
    var result = escapeXml(input);
    assert(std.mem.eql(u8, input, result));
}

test "buildSkillsCatalog_non_empty_returns_first_skill_name" {
    var skills_array: [2]SkillMeta = [
        SkillMeta{ .name = "skill1", .description = "desc1", .location = "loc1" },
        SkillMeta{ .name = "skill2", .description = "desc2", .location = "loc2" },
    ];
    var skills: []SkillMeta = &skills_array;
    var result = buildSkillsCatalog(skills);
    assert(std.mem.eql(u8, skills[0].name, result));
}
