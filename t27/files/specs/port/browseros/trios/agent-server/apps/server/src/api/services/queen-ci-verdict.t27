// specs/port/browseros/trios/agent-server/apps/server/src/api/services/queen-ci-verdict.t27
// -- port of the BrowserOS queen-ci-verdict service: the CI-verdict rules that
// decide which check runs count as a refusal and which lines of a job log are
// the error note. The host GitHub API parts (pulls, check runs, job logs) are
// stubbed; the pure predicates and the note-building shape are kept.

module QueenCiVerdict;

pub const RED_ITEMS: [5]str = ["failure", "timed_out", "cancelled", "action_required", "startup_failure"];
pub const CI_CHECKS_PER_ROUND: u32 = 8;
pub const CI_MAXIMUM_SEND_BACKS: u32 = 2;
pub const NOTE_MAX: u32 = 1500;
pub const ERROR_MAX: u32 = 600;

pub const CheckRun = struct {
    id: u32,
    name: str,
    status: str,
    conclusion: str, // empty represents null
    url: str,        // empty represents null
};

pub const VerdictPullRequest = struct {
    number: u32,
    state: str,
    merged: bool,
    headSha: str,
};

pub const TakenBack = struct {
    issue: u32,
    pull: u32,
    state: str, // 'sendBack' or 'escalate'
    checks: []str,
};

// True when the conclusion is one of the red items.
pub fn isRedConclusion(conclusion: str) -> bool {
    var i: u32 = 0;
    while (i < 5) {
        if (RED_ITEMS[i] == conclusion) {
            return true;
        }
        i += 1;
    }
    return false;
}

// True when name is one of the required checks.
pub fn isRequired(name: str, required: []str) -> bool {
    var i: u32 = 0;
    while (i < required.len) {
        if (required[i] == name) {
            return true;
        }
        i += 1;
    }
    return false;
}

// True when the run is completed and has a conclusion.
pub fn isCheckRunCompleted(run: CheckRun) -> bool {
    return run.status == "completed" && run.conclusion.len > 0;
}

// True when the log line opens with the error marker.
pub fn startsWithErrorMarker(line: str) -> bool {
    return line.starts_with("##[error]");
}

// True when the log line opens with the process-completed marker.
pub fn startsWithProcessCompleted(line: str) -> bool {
    return line.starts_with("##[group]Run") || line.starts_with("Process completed with exit code");
}

// The refusal predicate the verdict is built from: a required, completed run
// whose conclusion is red.
pub fn isRefusal(run: CheckRun, required: []str) -> bool {
    if (!isCheckRunCompleted(run)) {
        return false;
    }
    if (!isRequired(run.name, required)) {
        return false;
    }
    return isRedConclusion(run.conclusion);
}

// Stubs: the host GitHub API calls.
pub fn githubCiDeps_requiredChecks_impl(repo: str, baseBranch: str) -> []str {
    return []str{};
}

pub fn githubCiDeps_pullsForBranch_impl(repo: str, baseBranch: str, branch: str) -> []VerdictPullRequest {
    return []VerdictPullRequest{};
}

pub fn githubCiDeps_checkRuns_impl(repo: str, baseBranch: str, sha: str) -> []CheckRun {
    return []CheckRun{};
}

pub fn githubCiDeps_jobLog_impl(repo: str, baseBranch: str, jobId: u32) -> str {
    return "";
}

// Stub: the host assembles the refusal note from the collected error lines.
pub fn ciRefusalNote(pull: u32, branch: str, refused: []str) -> str {
    return "";
}

// Stub: the host computes the take-back pool over the API results.
pub fn takeBackRefusedAcceptances(limit: u32) -> []TakenBack {
    return []TakenBack{};
}

test red_conclusions_are_detected {
    assert(isRedConclusion("failure"));
    assert(isRedConclusion("startup_failure"));
    assert(!isRedConclusion("success"));
    assert(!isRedConclusion(""));
}

test required_membership {
    assert(isRequired("validate", ["validate", "check"]));
    assert(!isRequired("parse", ["validate", "check"]));
}

test completed_runs_only {
    var r: CheckRun = undefined;
    r.status = "completed";
    r.conclusion = "failure";
    r.name = "validate";
    r.id = 1;
    r.url = "";
    assert(isCheckRunCompleted(r));
    r.status = "in_progress";
    assert(!isCheckRunCompleted(r));
}

test refusal_needs_required_and_red {
    var r: CheckRun = undefined;
    r.status = "completed";
    r.conclusion = "failure";
    r.name = "validate";
    r.id = 1;
    r.url = "";
    assert(isRefusal(r, ["validate"]));
    r.conclusion = "success";
    assert(!isRefusal(r, ["validate"]));
    r.conclusion = "failure";
    assert(!isRefusal(r, ["check"]));
}

test error_markers {
    assert(startsWithErrorMarker("##[error]something broke"));
    assert(!startsWithErrorMarker("  ##[error]indented"));
}
