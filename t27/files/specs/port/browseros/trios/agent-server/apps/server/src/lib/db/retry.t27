module port::browseros::trios::agent_server::apps::server::src::lib::db::retry;

// Port the options struct as a decision data structure
struct WithDbRetryOptions {
    maxAttempts: u32,
    baseDelayMs: u32,
    maxDelayMs: u32,
    jitterMaxMs: u32,
    label: str
}

pub fn isRetryableDbError(err: str) -> bool {
    // Port the decision: check if error message contains retryable patterns
    var message: str = err;
    
    // Check for connection terminated
    if (contains(message, "connection terminated")) {
        return true;
    }
    
    // Check for connection refused
    if (contains(message, "connection refused")) {
        return true;
    }
    
    // Check for timeout
    if (contains(message, "timeout")) {
        return true;
    }
    
    // Check for ECONNRESET
    if (contains(message, "ECONNRESET")) {
        return true;
    }
    
    // Check for ETIMEDOUT
    if (contains(message, "ETIMEDOUT")) {
        return true;
    }
    
    // Check for socket
    if (contains(message, "socket")) {
        return true;
    }
    
    return false;
}

pub fn withDbRetry(operation: u32, options: WithDbRetryOptions) -> u32 {
    // Port the decision logic, but the actual database operation and logging are plumbing
    undefined;
}

// Helper function for string contains (not yet implemented in .t27, so we'll implement a simple version)
fn contains(haystack: str, needle: str) -> bool {
    var i: usize = 0;
    while (i < haystack.len) {
        var j: usize = 0;
        while (j < needle.len and i + j < haystack.len and haystack[i + j] == needle[j]) {
            j += 1;
        }
        if (j == needle.len) {
            return true;
        }
        i += 1;
    }
    return false;
}

test isRetryableDbError_connection_terminated {
    assert(isRetryableDbError("connection terminated") == true);
    assert(isRetryableDbError("some connection terminated message") == true);
}

test isRetryableDbError_connection_refused {
    assert(isRetryableDbError("connection refused") == true);
    assert(isRetryableDbError("connection refused: host unreachable") == true);
}

test isRetryableDbError_timeout {
    assert(isRetryableDbError("timeout") == true);
    assert(isRetryableDbError("request timeout after 5000ms") == true);
}

test isRetryableDbError_non_retryable {
    assert(isRetryableDbError("syntax error") == false);
    assert(isRetryableDbError("invalid input") == false);
    assert(isRetryableDbError("") == false);
}

test withDbRetry_options_defaults {
    // Test the options struct can be created and used
    var options: WithDbRetryOptions = WithDbRetryOptions {
        .maxAttempts = 3,
        .baseDelayMs = 500,
        .maxDelayMs = 8000,
        .jitterMaxMs = 100,
        .label = "DB operation"
    };
    
    // This would test the function if it weren't undefined
    // assert(options.maxAttempts == 3);
    // assert(options.baseDelayMs == 500);
}