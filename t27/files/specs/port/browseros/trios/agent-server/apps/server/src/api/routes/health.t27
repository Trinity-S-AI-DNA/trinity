module port::browseros::trios::agent_server::api::routes::health;

/// Health check response structure
struct HealthResponse {
    status: []const u8,
    pid: u32,
    cdpConnected: ?bool,
    state: ?BackendStatus,
}

/// Backend status from state backend
struct BackendStatus {
    durable: bool,
    configured: bool,
    err_msg: ?[]const u8,
}

/// Dependencies for health route (plumbing - not used in pure logic)
struct HealthDeps {
    browser: ?Browser,
    stateBackend: ?StateBackend,
}

/// Browser interface (plumbing)
struct Browser {
    _opaque: u8,
}

/// State backend interface (plumbing)
struct StateBackend {
    _opaque: u8,
}

/// Pure function: build health response from optional inputs.
/// This ports the decision logic from createHealthRoute.
pub fn buildHealthResponse(
    pid: u32,
    cdpConnected: ?bool,
    state: ?BackendStatus,
) HealthResponse {
    return HealthResponse {
        .status = "ok",
        .pid = pid,
        .cdpConnected = cdpConnected,
        .state = state,
    };
}

/// Pure function: determine if cdpConnected should be included in response.
/// Returns null if browser is not provided, otherwise the connection status.
pub fn maybeCdpConnected(browser: ?Browser) ?bool {
    if (browser == null) {
        return null;
    }
    // In real code this would call browser.isCdpConnected()
    // For the pure function we accept the status as a parameter
    return undefined;
}

/// Pure function: determine if state should be included in response.
/// Returns null if stateBackend is not provided, otherwise the backend status.
pub fn maybeBackendStatus(stateBackend: ?StateBackend) ?BackendStatus {
    if (stateBackend == null) {
        return null;
    }
    // In real code this would call stateBackend.backendStatus()
    // For the pure function we accept the status as a parameter
    return undefined;
}

/// Main route creator - touches HTTP framework (Hono), so undefined body.
/// The decision logic is in buildHealthResponse which is tested.
pub fn createHealthRoute(deps: HealthDeps) HealthResponse {
    undefined;
}

test buildHealthResponse_basic {
    const resp = buildHealthResponse(1234, null, null);
    assert(resp.status == "ok");
    assert(resp.pid == 1234);
    assert(resp.cdpConnected == null);
    assert(resp.state == null);
}

test buildHealthResponse_with_cdp_connected {
    const resp = buildHealthResponse(5678, true, null);
    assert(resp.status == "ok");
    assert(resp.pid == 5678);
    assert(resp.cdpConnected == true);
}

test buildHealthResponse_with_cdp_disconnected {
    const resp = buildHealthResponse(5678, false, null);
    assert(resp.status == "ok");
    assert(resp.pid == 5678);
    assert(resp.cdpConnected == false);
}

test buildHealthResponse_with_state {
    const state = BackendStatus {
        .durable = true,
        .configured = true,
        .err_msg = null,
    };
    const resp = buildHealthResponse(9999, null, state);
    assert(resp.status == "ok");
    assert(resp.pid == 9999);
    assert(resp.cdpConnected == null);
    assert(resp.state.?.durable == true);
    assert(resp.state.?.configured == true);
    assert(resp.state.?.err_msg == null);
}

test buildHealthResponse_with_state_error {
    const state = BackendStatus {
        .durable = false,
        .configured = true,
        .err_msg = "connection refused",
    };
    const resp = buildHealthResponse(9999, true, state);
    assert(resp.status == "ok");
    assert(resp.pid == 9999);
    assert(resp.cdpConnected == true);
    assert(resp.state.?.durable == false);
    assert(resp.state.?.configured == true);
    assert(resp.state.?.err_msg.? == "connection refused");
}

test buildHealthResponse_full {
    const state = BackendStatus {
        .durable = true,
        .configured = false,
        .err_msg = "not configured",
    };
    const resp = buildHealthResponse(42, false, state);
    assert(resp.status == "ok");
    assert(resp.pid == 42);
    assert(resp.cdpConnected == false);
    assert(resp.state.?.durable == true);
    assert(resp.state.?.configured == false);
    assert(resp.state.?.err_msg.? == "not configured");
}

test maybeCdpConnected_no_browser {
    assert(maybeCdpConnected(null) == null);
}

test maybeBackendStatus_no_backend {
    assert(maybeBackendStatus(null) == null);
}