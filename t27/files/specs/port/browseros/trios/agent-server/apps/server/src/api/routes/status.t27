module specs::port::browseros::trios::agent-server::apps::server::src::api::routes;

// StatusDeps represents the dependencies for creating the status route.
// In the original TypeScript, it had an optional browser property.
// We define it as an empty struct because the function body is undefined
// and we are not using the dependencies in the extracted decision.
struct StatusDeps {}

// createStatusRoute returns a route handler for the status endpoint.
// The original TypeScript function returns a Hono route.
// Since we cannot express Hono in .t27, we leave the body undefined.
// The decision inside the route handler is extracted to getStatusResponse.
pub fn createStatusRoute(deps: StatusDeps) -> undefined {
    undefined;
}

// Define the response structure for the status endpoint.
struct ServerStatusResponse {
    status: []const u8,
    cdpConnected: ?bool
}

// getStatusResponse extracts the decision from the original route handler.
// It takes an optional boolean representing the result of
// `deps.browser?.isCdpConnected()` (null if browser is undefined).
// It returns a ServerStatusResponse that will be serialized to JSON.
// The JSON serializer should omit the cdpConnected field when it is null,
// matching the original behavior where the field is omitted when undefined.
pub fn getStatusResponse(cdpConnected: ?bool) -> ServerStatusResponse {
    return ServerStatusResponse { .status = "ok", .cdpConnected = cdpConnected };
}

// Test cases for getStatusResponse, asserting on the behavior of the original function.

test "getStatusResponse returns only status when cdpConnected is null" {
    const resp = getStatusResponse(null);
    assert(resp.status == "ok");
    assert(resp.cdpConnected == null);
}

test "getStatusResponse returns status and cdpConnected true when browser is connected" {
    const resp = getStatusResponse(true);
    assert(resp.status == "ok");
    assert(resp.cdpConnected == true);
}

test "getStatusResponse returns status and cdpConnected false when browser is not connected" {
    const resp = getStatusResponse(false);
    assert(resp.status == "ok");
    assert(resp.cdpConnected == false);
}