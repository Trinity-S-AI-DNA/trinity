module port::browseros::trios::agent_server::api::routes::queen_registry;

/**
 * Port of trios/agent-server/apps/server/src/api/routes/queen-registry.ts
 * The Queen's delegation registry, mirrored into Postgres.
 */

// Environment variable names as constants
const ENV_DATABASE_URL: []const u8 = "DATABASE_URL";
const ENV_RAILWAY_SSOT_URL: []const u8 = "RAILWAY_SSOT_URL";

// Variant default
const DEFAULT_VARIANT: []const u8 = "prod";

/**
 * Pure decision: resolve database URL from environment.
 * Returns null if neither DATABASE_URL nor RAILWAY_SSOT_URL is set.
 */
pub fn databaseUrl(db_url: ?[]const u8, railway_url: ?[]const u8) -> ?[]const u8 {
    if (db_url != null) {
        if (db_url.?.len > 0) {
            return db_url.?;
        }
    }
    if (railway_url != null) {
        if (railway_url.?.len > 0) {
            return railway_url.?;
        }
    }
    return null;
}

/**
 * Pure decision: validate that tasks exists and is an array.
 * Returns (ok, error_message). ok=true means valid.
 */
pub struct ValidationResult {
    ok: bool,
    err_msg: ?[]const u8,
}

pub fn validateTasks(body_tasks: ?usize) -> ValidationResult {
    // The original checks Array.isArray(tasks). In this pure port, the caller
    // passes the array length (or null for missing/not-array).
    // null represents missing tasks or non-array; a usize represents a valid array.
    if (body_tasks == null) {
        return ValidationResult { ok: false, err_msg: "tasks must be an array" };
    }
    return ValidationResult { ok: true, err_msg: null };
}

/**
 * Pure decision: extract variant from body, defaulting to 'prod'.
 */
pub fn extractVariant(body_variant: ?[]const u8) -> []const u8 {
    if (body_variant == null) {
        return DEFAULT_VARIANT;
    }
    return body_variant.?;
}

/**
 * Pure decision: build PUT success response.
 */
pub fn buildPutResponse(stored: usize, variant: []const u8) -> PutResponse {
    return PutResponse {
        stored: stored,
        variant: variant,
        err_msg: null,
    };
}

/**
 * Pure decision: build PUT error response.
 */
pub fn buildPutError(err: []const u8, status: i32) -> PutResponse {
    return PutResponse {
        stored: 0,
        variant: "",
        err_msg: err,
    };
}

/**
 * Pure decision: build GET success response.
 */
pub fn buildGetResponse(tasks: []const u8, task_count: usize, published_at: []const u8) -> GetResponse {
    return GetResponse {
        tasks: tasks,
        task_count: task_count,
        published_at: published_at,
        err_msg: null,
    };
}

/**
 * Pure decision: build GET not-found response.
 */
pub fn buildGetNotFound() -> GetResponse {
    return GetResponse {
        tasks: "",
        task_count: 0,
        published_at: "",
        err_msg: "nothing published yet",
    };
}

/**
 * Pure decision: build GET error response (no database configured).
 */
pub fn buildGetNoDb() -> GetResponse {
    return GetResponse {
        tasks: "",
        task_count: 0,
        published_at: "",
        err_msg: "No database configured",
    };
}

// Response structs for pure functions
pub struct PutResponse {
    stored: usize,
    variant: []const u8,
    err_msg: ?[]const u8,
}

pub struct GetResponse {
    tasks: []const u8,
    task_count: usize,
    published_at: []const u8,
    err_msg: ?[]const u8,
}

// Plumbing functions - undefined bodies, not called from tests
pub fn createQueenPool(url: []const u8) -> RegistryPool { undefined; }

pub struct RegistryPool {
    // Opaque handle
    _dummy: u8,
}

pub fn Pool_query(pool: RegistryPool, sql: []const u8, params: [][]const u8) -> QueryResult { undefined; }

pub fn Pool_end(pool: RegistryPool) -> void { undefined; }

pub struct QueryResult {
    rowCount: usize,
    rows: []Row,
}

pub struct Row {
    tasks: []const u8,
    task_count: usize,
    published_at: []const u8,
}

// Main route creator - plumbing, not tested
pub fn createQueenRegistryRoute() -> Route { undefined; }

pub struct Route {
    _dummy: u8,
}

// ============================================================================
// TESTS
// ============================================================================

test databaseUrl_returns_DATABASE_URL_when_set {
    const result = databaseUrl("postgres://local", null);
    assert(result != null);
    assert(result.? == "postgres://local");
}

test databaseUrl_falls_back_to_RAILWAY_SSOT_URL {
    const result = databaseUrl(null, "postgres://railway");
    assert(result != null);
    assert(result.? == "postgres://railway");
}

test databaseUrl_returns_null_when_neither_set {
    const result = databaseUrl(null, null);
    assert(result == null);
}

test databaseUrl_empty_DATABASE_URL_falls_back {
    const result = databaseUrl("", "postgres://railway");
    assert(result != null);
    assert(result.? == "postgres://railway");
}

test databaseUrl_DATABASE_URL_takes_priority {
    const result = databaseUrl("postgres://local", "postgres://railway");
    assert(result != null);
    assert(result.? == "postgres://local");
}

test validateTasks_accepts_array {
    const result = validateTasks(5); // usize represents valid array with length
    assert(result.ok);
    assert(result.err_msg == null);
}

test validateTasks_rejects_missing {
    // In pure logic, we can't easily represent "is array" vs "not array"
    // The original checks Array.isArray(tasks). We test the missing case.
    const result = validateTasks(null);
    assert(!result.ok);
    assert(result.err_msg.? == "tasks must be an array");
}

test extractVariant_returns_default_when_missing {
    const result = extractVariant(null);
    assert(result == "prod");
}

test extractVariant_returns_provided_value {
    const result = extractVariant("staging");
    assert(result == "staging");
}

test buildPutResponse_sets_fields {
    const resp = buildPutResponse(5, "prod");
    assert(resp.stored == 5);
    assert(resp.variant == "prod");
    assert(resp.err_msg == null);
}

test buildPutError_sets_error {
    const resp = buildPutError("database down", 500);
    assert(resp.err_msg.? == "database down");
    assert(resp.stored == 0);
}

test buildGetResponse_sets_fields {
    const resp = buildGetResponse("[{\"id\":1}]", 1, "2025-01-01T00:00:00Z");
    assert(resp.tasks == "[{\"id\":1}]");
    assert(resp.task_count == 1);
    assert(resp.published_at == "2025-01-01T00:00:00Z");
    assert(resp.err_msg == null);
}

test buildGetNotFound_sets_error {
    const resp = buildGetNotFound();
    assert(resp.err_msg.? == "nothing published yet");
    assert(resp.task_count == 0);
}

test buildGetNoDb_sets_error {
    const resp = buildGetNoDb();
    assert(resp.err_msg.? == "No database configured");
}