// specs/port/browseros/trios/agent-server/apps/server/src/api/services/a2a/a2a-liveness.t27
// -- port of the BrowserOS A2A liveness threshold: the one derivation of the
// offline threshold, shared by every site that decides whether an agent
// counts as alive. RING-01 (trios/rings/T27-01/a2a.t27) states the rule once:
// HEARTBEAT_INTERVAL_SECONDS * MISSED_BEATS_BEFORE_OFFLINE, with an inclusive
// boundary - an agent silent for exactly the threshold is still alive, and a
// negative age (clocks disagreeing, the last beat appearing to be in the
// future) is answered as alive rather than left to arithmetic.
//
// Like the original, this module contains no import statements. The two units
// the threshold is asked in are spelled as the original's string union:
// "seconds" or "milliseconds".

// Heartbeat cadence, in seconds. Mirrors a2a.t27 HEARTBEAT_INTERVAL_SECONDS.
pub const HEARTBEAT_INTERVAL_SECONDS: i64 = 30;

// Beats that may be missed before an agent is called offline.
// Mirrors a2a.t27 MISSED_BEATS_BEFORE_OFFLINE.
pub const MISSED_BEATS_BEFORE_OFFLINE: i64 = 3;

// The offline threshold in the requested unit, derived from the one spec
// product rather than written out per unit. pruneOffline takes seconds; the
// memory-path comparisons are in milliseconds. Naming the unit at the call
// site keeps a bare number, whose unit has to be inferred from surrounding
// code, out of the service. As in the original's ternary, anything other
// than "seconds" is answered in milliseconds.
pub fn a2aLivenessThreshold(unit: str) -> i64 {
    const offlineAfterSeconds: i64 = HEARTBEAT_INTERVAL_SECONDS * MISSED_BEATS_BEFORE_OFFLINE;
    if (unit == "seconds") {
        return offlineAfterSeconds;
    }
    return offlineAfterSeconds * 1000;
}

// Whether an agent counts as alive, given how long since its last heartbeat,
// in milliseconds. Mirrors a2a.t27 is_alive: inclusive on the boundary, and
// a negative age is answered as alive - the case the spec spells out rather
// than leaving to arithmetic.
pub fn a2aIsAlive(msSinceLastHeartbeat: i64) -> bool {
    if (msSinceLastHeartbeat < 0) {
        return true;
    }
    return msSinceLastHeartbeat <= a2aLivenessThreshold("milliseconds");
}

// 30 s heartbeat * 3 missed beats: the threshold in seconds is 90.
test a2aLivenessThreshold_seconds_unit {
    assert(a2aLivenessThreshold("seconds") == 90);
}

// The same product, expressed in milliseconds: 90_000.
test a2aLivenessThreshold_milliseconds_unit {
    assert(a2aLivenessThreshold("milliseconds") == 90_000);
}

// Inclusive on the boundary: silent for exactly the threshold is still
// alive, one millisecond more is not.
test a2aIsAlive_inclusive_boundary {
    assert(a2aIsAlive(89_999));
    assert(a2aIsAlive(90_000));
    assert(!a2aIsAlive(90_001));
}

// A negative age (clocks disagreeing, the last beat in the future) is
// answered as alive, before any arithmetic runs.
test a2aIsAlive_negative_age {
    assert(a2aIsAlive(-1));
    assert(a2aIsAlive(-90_000));
}
