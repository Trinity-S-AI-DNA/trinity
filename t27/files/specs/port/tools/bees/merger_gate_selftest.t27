// Test cases ported from the original scenarios
test review_basic {
    const result = review(BOT, "APPROVED", HEAD, "2026-10-02T10:05:00Z");
    assert(result.user.login == BOT);
    assert(result.state == "APPROVED");
    assert(result.commit_id == HEAD);
    assert(result.submitted_at == "2026-10-02T10:05:00Z");
}

test label_basic {
    const result = label(BOT, "2026-10-02T10:06:00Z", "bee-reviewed");
    assert(result.event == "labeled");
    assert(result.label.name == "bee-reviewed");
    assert(result.created_at == "2026-10-02T10:06:00Z");
    assert(result.actor.login == BOT);
}

test label_custom_name {
    const result = label(BOT, "2026-10-02T10:06:00Z", "custom-label");
    assert(result.label.name == "custom-label");
}

test pr_basic {
    const review_data = review(BOT, "APPROVED", HEAD, "2026-10-02T10:05:00Z");
    const label_data = label(BOT, "2026-10-02T10:06:00Z", "bee-reviewed");
    
    const result = pr("dummy", "dummy", "dummy");
    assert(result.result.view.title == "x (Closes #1)");
    assert(result.result.view.headRefOid == HEAD);
    assert(result.result.committed == "2026-10-02T10:00:00Z");
}

test extract_find_ready_logic {
    // Test the basic functionality of extract_find_ready
    const workflow_content = "test content";
    const result = extract_find_ready(workflow_content);
    assert(result.len > 0);
}

test out_with_jq {
    const result = out("test_data", "jq_query");
    assert(result == "jq_processed_output");
}

test out_without_jq {
    const result = out("test_data", null);
    assert(result == "json_output");
}