module port::tools::oracle::run;

pub enum OracleResult {
    Pass,
    Timeout,
    TestFail,
    NoCompile,
}

pub fn categorize_rc_and_log(rc: i32, log: []const u8, LIMIT: u32) -> OracleResult {
    if (rc == 0) {
        return .Pass;
    } else if (rc == 124 || rc == 142) {
        return .Timeout;
    } else {
        return .NoCompile;
    }
}

pub fn run_one(f: []const u8, OUT: []const u8, ZIG: []const u8, LIMIT: u32) -> []const u8 {
    let (rc, log) = undefined_run_test_shim(f, OUT, ZIG, LIMIT);
    let result = categorize_rc_and_log(rc, log, LIMIT);
    return undefined_format_oracle_result(result, f, LIMIT, log);
}

pub fn main() -> i32 {
    undefined_main();
    return 0;
}

// Undefined functions representing plumbing
pub fn undefined_run_test_shim(f: []const u8, OUT: []const u8, ZIG: []const u8, LIMIT: u32) -> (i32, []const u8) {
    undefined;
}
pub fn undefined_format_oracle_result(result: OracleResult, f: []const u8, LIMIT: u32, log: []const u8) -> []const u8 {
    undefined;
}
pub fn undefined_main() -> void {
    undefined;
}

test categorize_rc_and_log_pass {
    assert(categorize_rc_and_log(0, [], 0) == .Pass);
}

test categorize_rc_and_log_timeout {
    assert(categorize_rc_and_log(124, [], 0) == .Timeout);
    assert(categorize_rc_and_log(142, [], 0) == .Timeout);
}