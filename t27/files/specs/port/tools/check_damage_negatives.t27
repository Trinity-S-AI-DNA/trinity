module check-damage-negatives;

// Constants from the original implementation
pub const EXPECTED_FIXTURES : u32 = 6;

// Helper function to parse tri damage output
// Returns Option<(files_scanned: u32, damaged_lines: u32)>
fn parse_report(text: str) -> Option<(u32, u32)> {
    let mut scanned = none();
    let mut damaged = none();
    
    for line in text.lines() {
        let trimmed = line.trim();
        if trimmed.starts_with("files scanned:") {
            let parts = trimmed.split(":");
            if parts.len() >= 2 {
                let value_str = parts[1].trim();
                // (Rust turbofish `parse::<u32>()` written as `parse_u32()`:
                // the parser has no generic call syntax; same u32 parse.)
                scanned = some(value_str.parse_u32().unwrap_or(0));
            }
        } else if trimmed.starts_with("damaged lines:") {
            let parts = trimmed.split(":");
            if parts.len() >= 2 {
                let value_part = parts[1].trim();
                // Take only the first number (before any spaces)
                let num_str = value_part.split(" ").next().unwrap_or("");
                damaged = some(num_str.parse_u32().unwrap_or(0));
            }
        }
    }
    
    if scanned.is_some && damaged.is_some {
        return some((scanned.value, damaged.value));
    }
    return none();
}

