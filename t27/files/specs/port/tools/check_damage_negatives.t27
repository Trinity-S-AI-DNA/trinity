// Main entry point
pub fn main() -> i32 {
    // Handle --self-check argument
    if (@hasArg("--self-check")) {
        return self_check();
    }
    
    // Get require argument (default false)
    let require = @hasArg("--require");
    return run(require);
}

// Test block for parse_report function
// (Rust `assert!(cond, "msg")` is written as t27's `assert(cond, "msg")`:
// `assert!` parsed as `assert` applied to the negated tuple `!(cond, msg)`.)
test "parse_report_clean" {
    let input = "corpus: x\nfiles scanned: 6\ndamaged lines: 0 in 0 files, 0 distinct shapes\n";
    let result = parse_report(input);
    assert(result.is_some(), "parse_report should return Some for clean input");
    let (scanned, damaged) = result.unwrap();
    assert(scanned == 6, "scanned should be 6");
    assert(damaged == 0, "damaged should be 0");
}

test "parse_report_empty" {
    let input = "corpus: x\nfiles scanned: 0\ndamaged lines: 0 in 0 files, 0 distinct shapes\n";
    let result = parse_report(input);
    assert(result.is_some(), "parse_report should return Some for empty scan");
    let (scanned, damaged) = result.unwrap();
    assert(scanned == 0, "scanned should be 0");
    assert(damaged == 0, "damaged should be 0");
}

test "parse_report_dirty" {
    let input = "corpus: x\nfiles scanned: 6\ndamaged lines: 3 in 2 files, 1 distinct shapes\n";
    let result = parse_report(input);
    assert(result.is_some(), "parse_report should return Some for dirty input");
    let (scanned, damaged) = result.unwrap();
    assert(scanned == 6, "scanned should be 6");
    assert(damaged == 3, "damaged should be 3");
}

test "parse_report_unreadable" {
    let input = "corpus: x\n";
    let result = parse_report(input);
    assert(result.is_none(), "parse_report should return None for unreadable input");
}

