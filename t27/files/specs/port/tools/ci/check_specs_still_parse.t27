module port::tools::ci::check_specs_still_parse;

const NOPARSE = "NOPARSE";

// Pure helper functions containing the decision logic

fn is_not_noparse(verdict: ?[]const u8) -> bool {
    if (verdict == null) {
        return false;
    }
    // Use a simple character-by-character comparison instead of string comparison
    const verdict_str = verdict.?;
    if (verdict_str.len == NOPARSE.len) {
        var i: usize = 0;
        while (i < verdict_str.len) {
            if (verdict_str[i] != NOPARSE[i]) {
                return true;
            }
            i += 1;
        }
        return false;
    }
    return true;
}

fn determine_regression(base_verdict: ?[]const u8, head_verdict: []const u8) -> bool {
    // A regression is: it parsed at the base, and it does not now.
    // A NEW file (no base version) cannot regress - it never parsed here before,
    // and refusing it would make this gate a style rule about new specs instead of
    // a ratchet. `Spec Guards` is where a new file's shape belongs.
    if (base_verdict == null) {
        return false;
    }
    return is_not_noparse(base_verdict) and head_verdict == NOPARSE;
}

fn run_self_test() -> i32 {
    // The negative control: this checker must reject the shape it exists to reject.
    // A gate nobody has watched fail is indistinguishable from one that cannot.
    
    // Test cases manually instead of using tuple indexing
    const case1_result = determine_regression("IMPLEMENTED", NOPARSE);
    const case1_want = true;
    if (case1_result != case1_want) {
        return 1;
    }
    
    const case2_result = determine_regression("UNWRITTEN", NOPARSE);
    const case2_want = true;
    if (case2_result != case2_want) {
        return 1;
    }
    
    const case3_result = determine_regression("PARTIAL", NOPARSE);
    const case3_want = true;
    if (case3_result != case3_want) {
        return 1;
    }
    
    const case4_result = determine_regression(NOPARSE, NOPARSE);
    const case4_want = false;
    if (case4_result != case4_want) {
        return 1;
    }
    
    const case5_result = determine_regression(NOPARSE, "IMPLEMENTED");
    const case5_want = false;
    if (case5_result != case5_want) {
        return 1;
    }
    
    const case6_result = determine_regression("IMPLEMENTED", "IMPLEMENTED");
    const case6_want = false;
    if (case6_result != case6_want) {
        return 1;
    }
    
    const case7_result = determine_regression(null, NOPARSE);
    const case7_want = false;
    if (case7_result != case7_want) {
        return 1;
    }
    
    return 0;
}

// External functions with undefined bodies

pub fn spec_status(t27c: []const u8, source: []const u8, timeout: i32) -> []const u8 {
    undefined;
}

pub fn git(args: []const u8) -> []const u8 {
    undefined;
}

pub fn changed_specs(base: []const u8, head: []const u8) -> []const u8 {
    undefined;
}

pub fn version_at(ref: []const u8, path: []const u8) -> ?[]const u8 {
    undefined;
}

pub fn self_test() -> i32 {
    undefined;
}

pub fn is_regression(base_verdict: ?[]const u8, head_verdict: []const u8) -> bool {
    undefined;
}

pub fn main() -> i32 {
    undefined;
}

// Tests for the pure decision logic

test determine_regression_true {
    // Test that determine_regression returns true when base implemented and head is NOPARSE
    const is_reg = determine_regression("IMPLEMENTED", NOPARSE);
    assert(is_reg == true);
}

test determine_regression_false_new_file {
    // Test determine_regression returns false for new file (no base)
    const is_reg = determine_regression(null, NOPARSE);
    assert(is_reg == false);
}

test determine_regression_false_repaired {
    // Test determine_regression returns false when broken file is repaired
    const is_reg = determine_regression(NOPARSE, "IMPLEMENTED");
    assert(is_reg == false);
}

test determine_regression_false_no_change {
    // Test determine_regression returns false when both are implemented
    const is_reg = determine_regression("IMPLEMENTED", "IMPLEMENTED");
    assert(is_reg == false);
}

test determine_regression_false_already_broken {
    // Test determine_regression returns false when both are NOPARSE
    const is_reg = determine_regression(NOPARSE, NOPARSE);
    assert(is_reg == false);
}

test determine_regression_partial_to_noparse {
    // Test determine_regression returns true when base was PARTIAL and head is NOPARSE
    const is_reg = determine_regression("PARTIAL", NOPARSE);
    assert(is_reg == true);
}

test determine_regression_unwritten_to_noparse {
    // Test determine_regression returns true when base was UNWRITTEN and head is NOPARSE
    const is_reg = determine_regression("UNWRITTEN", NOPARSE);
    assert(is_reg == true);
}

test is_not_noparse_true {
    // Test is_not_noparse returns true for non-NOPARSE verdicts
    const result = is_not_noparse("IMPLEMENTED");
    assert(result == true);
}

test is_not_noparse_false {
    // Test is_not_noparse returns false for NOPARSE
    const result = is_not_noparse(NOPARSE);
    assert(result == false);
}

test is_not_noparse_null {
    // Test is_not_noparse returns false for null
    const result = is_not_noparse(null);
    assert(result == false);
}

test run_self_test_all_pass {
    // Test the self_test function with known cases
    const result = run_self_test();
    // Should return 0 if all regression detection cases pass
    assert(result == 0);
}