module port.tools.check_graph_law8;

// ============================================================================
// Constants
// ============================================================================

pub const DOC_KINDS = [_][]u8{ "documented-by", "references", "standardizes" };
pub const MAX_CYCLES: i32 = 1;
pub const MAX_TIER_BACKWARD: i32 = 5;
pub const MAX_DEP_CYCLES: i32 = 0;
pub const MAX_DEP_TIER_BACKWARD: i32 = 3;

// ============================================================================
// Structures
// ============================================================================

// Renamed from `Edge` (2026-09-21): specs/tri/graph/bellman_ford.t27 has
// declared a different `Edge` -- from/to/weight, a weighted graph edge --
// since long before this file. Two definitions of one name is what
// `tri types ratchet` reports, and a resolver has nothing to break the tie
// with. This one is an edge of the DEPENDENCY graph: it carries a `kind`
// tag and no weight, so it takes the narrower name.
pub struct DepEdge {
    from: i32,
    to: i32,
    kind: []u8,
}

