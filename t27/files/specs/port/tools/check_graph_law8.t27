// ============================================================================

pub fn refuse(msg: []u8) -> void {
    // Print to stderr and exit with code 2
    const stdout = @stdout();
    const stderr = @stderr();
    // We'll use print to stderr via @stdout().printErr? Not sure.
    // In T27, we can use @debug() or @panic()? We need to mimic the Python behavior.
    // For now, we'll print to stderr and then exit.
    // We'll use the C standard library via @cImport? But we don't have that.
    // Let's assume we have a way to print to stderr and exit.
    // We'll use @panic(msg) for now, but that might not be exactly stderr.
    // We'll look at other .t27 files for error printing.
    // We'll use @stdout().writeErr? Let's check the std module.
    // Since we don't have the std module defined, we'll use @debug for now and hope it goes to stderr.
    // Alternatively, we can use @cImport("stdio") and call fprintf and exit.
    // But we are to write pure T27? The issue says we are writing source, not compiler output.
    // We'll use the built-in @panic for now and adjust if needed.
    @panic("check_graph_law8: " ++ msg ++ "\n  Exit 2 = could not run. An absent graph is not a graph without cycles.");
    // Note: @panic will terminate the program. We don't need to call exit explicitly.
}

