    test "_who_returns_program_name" {
        // This test would need to mock os.args, which is complex in T27
        // For now, we'll test the fallback case when args is empty
        // In a real test, we'd set up mock args
        const result = _who();
        // When no args, should return "verifier"
        assert(result == "verifier");
    }

