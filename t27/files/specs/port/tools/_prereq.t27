// specs/port/tools/_prereq.t27
// Port of tools/_prereq.py to T27
// φ² + 1/φ² = 3 | TRINITY

module Prereq;
    use std::os;
    use std::process;
    use std::fs;
    use std::path;
    // `use std::regex;` sat inside plant(); t27 only accepts `use` at module level.
    use std::regex;

    // ═══════════════════════════════════════════════════════════════════════════
    // 1. Function: _who
    // ═══════════════════════════════════════════════════════════════════════════

    // _who() → str
    // Returns the program name from argv[0] or "verifier" as fallback
    fn _who() -> str {
        if (os.args.len > 0) {
            return path.basename(os.args[0]);
        }
        return "verifier";
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 2. Function: skip
    // ══════════════════════════════════════════════════════════════════════════

    // skip(msg: str) → void
    // Handles skip condition: environment incomplete
    // Exits with 0 normally, or 2 if --require flag is present
    fn skip(msg: str) -> void {
        // println!("{}") formatting has no t27 form: each line is printed as
        // its parts with the multi-argument @print the port specs use.
        if (os.args.contains("--require")) {
            @print("FAIL ", _who(), ": ", msg, "\n");
            @print("  --require was given, so a missing prerequisite is a failure, not a skip.\n");
            @print("  The CI job builds t27c and the runner ships the toolchain; if one is\n");
            @print("  absent the environment is broken and this check did not run.\n");
            @print("  Exit 2 = could not run, not a check that ran and said no.\n");
            process.exit(2);
        }
        @print("SKIP ", _who(), ": ", msg, "\n");
        process.exit(0);
    }

    // ════════════════════════════════════════════════════════════════════════════
    // 3. Function: broken
    // ══════════════════════════════════════════════════════════════════════════

    // broken(msg: str) → void
    // Handles broken condition: product failed or tracked file missing
    // Always exits with 1
    fn broken(msg: str) -> void {
        @print("FAIL ", _who(), ": ", msg, "\n");
        @print("  This is not a missing tool. Nothing was compared, and the reason is\n");
        @print("  the thing under test -- a compiler that would not emit, or a spec\n");
        @print("  this repository tracks and no longer has.\n");
        process.exit(1);
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 4. Function: plant
    // ══════════════════════════════════════════════════════════════════════════

    // plant(script: str, dest_tools: str) → []str
    // Copy `script` into `dest_tools`, together with what it imports.
    fn plant(script: str, dest_tools: str) -> []str {
        const src = path.script.to_string();  // TODO: Fix this - need to resolve script path
        const here = path.dirname(src);
        const dest = path.dest_tools.to_string();  // TODO: Fix this
        
        // Create destination directory if it doesn't exist
        // Mode 493 == 0o755 (rwxr-xr-x); t27 has no `0o` octal literal.
        fs.create_dir_all(dest, 493).expect("Failed to create destination directory");
        
        var seen: []str = [];
        var queue: []str = [src];
        
        while (queue.len > 0) {
            const f = queue.pop().expect("Queue should not be empty");
            const fname = path.basename(f);
            
            if (seen.contains(fname) || !fs.is_file(f)) {
                continue;
            }
            
            seen.push(fname);
            fs.copy(f, path.join(dest, fname)).expect("Failed to copy file");
            
            const text = fs.read_to_string(f).expect("Failed to read file");
            // Raw string r"..." rewritten as an ordinary string: each `\s` is `\\s`.
            const import_regex = regex.Regex.new("^\\s*(?:from|import)\\s+([A-Za-z_][A-Za-z0-9_]*)").expect("Failed to create regex");
            
            for cap in import_regex.captures_iter(text) {
                const name = cap.get(1).unwrap().as_str();
                const sib = path.join(here, name + ".py");
                if (fs.is_file(sib) && !seen.contains(path.basename(sib))) {
                    queue.push(sib);
                }
            }
        }
        
        seen.sort();
        return seen;
    }

    // ═══════════════════════════════════════════════════════════════════════════
