// specs/port/tools/gft_generalize_demo.t27 -- port of tools/gft_generalize_demo.py:
// the GF-T16 arithmetic (f2gft/gft_value, magadd/magsub, sadd/smul/magmul,
// neg/exp2/pow2_frac/recip, softmax/gt/cat) kept bit-for-bit, re-expressed in
// the supported subset: tuple destructuring becomes explicit lets, `2.0 ** e`
// and log2 become helper loops, and the rng-driven training demo is stubbed.

module GftGeneralizeDemo;

const BIAS : i32 = 40;
const N : u32 = 64;

// f2gft: convert Python-style float to GF-T16
fn f2gft(x: f32) -> u32 {
    if (x == 0.0) { return 0; }
    var s: u32;
    if (x < 0.0) {
        s = 1;
    } else {
        s = 0;
    }
    var ax: f32;
    if (x < 0.0) {
        ax = -x;
    } else {
        ax = x;
    }
    // integer log2 of ax, the manual form of ax.log2().floor()
    var exp: i32 = 0;
    var t: f32 = ax;
    while (t >= 2.0) {
        t = t / 2.0;
        exp += 1;
    }
    while (t < 1.0) {
        t = t * 2.0;
        exp -= 1;
    }
    // 2.0 ** exp, the manual form
    var pw: f32 = 1.0;
    var k: i32 = 0;
    while (k < exp) {
        pw = pw * 2.0;
        k += 1;
    }
    while (k > exp) {
        pw = pw / 2.0;
        k -= 1;
    }
    let frac: f32 = ax / pw;
    var mant: i32 = ((frac - 1.0) * 512.0 + 0.5) as i32;
    var off: i32 = exp + BIAS;
    if (mant == 512) { mant = 0; off += 1; }
    if (off < 1) { off = 1; mant = 0; }
    if (off > 80) { off = 80; mant = 511; }
    return (s << 16) | ((off as u32) << 9) | (mant as u32);
}

// gft_value: convert GF-T16 to Python-style float
fn gft_value(u: u32) -> f32 {
    if (u == 0) { return 0.0; }
    var s: f32;
    if ((u >> 16) == 1) {
        s = -1.0;
    } else {
        s = 1.0;
    }
    let mag: u32 = u & 65535;
    let mantissa: f32 = (mag & 511) as f32 / 512.0;
    let exponent: i32 = (mag >> 9) as i32 - BIAS;
    var pw: f32 = 1.0;
    var k: i32 = 0;
    while (k < exponent) {
        pw = pw * 2.0;
        k += 1;
    }
    while (k > exponent) {
        pw = pw / 2.0;
        k -= 1;
    }
    return s * (1.0 + mantissa) * pw;
}

// magadd: magnitude addition (used by sadd)
fn magadd(a: u32, b: u32) -> u32 {
    let ao: i32 = (a >> 9) as i32;
    let am: i32 = (a & 511) as i32;
    let bo: i32 = (b >> 9) as i32;
    let bm: i32 = (b & 511) as i32;
    var ho: i32;
    var hm: i32;
    var lo: i32;
    var lm: i32;
    if (ao >= bo) {
        ho = ao; hm = am; lo = bo; lm = bm;
    } else {
        ho = bo; hm = bm; lo = ao; lm = am;
    }
    let hs: i32 = 512 + hm;
    let ls: i32 = 512 + lm;
    let d: i32 = ho - lo;
    let d_clamped: i32 = if (d > 11) 11 else d;
    let losh: i32 = ls >> d_clamped;
    let rem: i32 = ls - (losh << d_clamped);
    let s: i32 = hs + losh;
    var off: i32 = ho;
    var mant: i32 = s - 512;
    if (s >= 1024) {
        let g: i32 = s & 1;
        let pre: i32 = s >> 1;
        mant = pre - 512;
        if (g == 1) {
            if (rem > 0) {
                mant = mant + 1;
            } else {
                if ((pre & 1) == 1) {
                    mant = mant + 1;
                }
            }
        }
        off = ho + 1;
        if (off > 80) { off = 80; }
    } else {
        let t: i32 = rem << 1;
        let hf: i32 = 1 << d_clamped;
        if (t > hf) {
            mant = mant + 1;
        } else if (t == hf) {
            if ((s & 1) == 1) {
                mant = mant + 1;
            }
        }
    }
    if (mant >= 512) {
        mant = 0;
        off = off + 1;
        if (off > 80) { off = 80; }
    }
    return ((off as u32) << 9) | (mant as u32);
}

// magsub: magnitude subtraction (used by sadd)
fn magsub(hi: u32, lo: u32) -> u32 {
    if (hi == lo) { return 0; }
    let ho: i32 = (hi >> 9) as i32;
    let hm: i32 = (hi & 511) as i32;
    let lo_o: i32 = (lo >> 9) as i32;
    let lm: i32 = (lo & 511) as i32;
    let d: i32 = ho - lo_o;
    var la: i32 = 0;
    var sticky: i32 = 0;
    if (d < 0) {
        return 0; // hi<lo: spec discards this call (recomputes magsub(mb,ma))
    }
    if (d >= 26) {
        la = 0;
        sticky = 1;
    } else {
        let ls: i32 = (512 + lm) << 14;
        la = ls >> d;
        if ((ls - (la << d)) > 0) {
            sticky = 1;
        }
    }
    var diff: i32 = ((512 + hm) << 14) - la;
    var off: i32 = ho;
    var cap: i32 = 12;
    if (off - 1 < cap) { cap = off - 1; }
    if (cap < 0) { cap = 0; }
    var sh: i32 = 0;
    if (diff != 0) {
        var t: i32 = diff;
        if (t < 65536) { if (sh + 8 <= cap) { t = t << 8; sh = sh + 8; } }
        if (t < 1048576) { if (sh + 4 <= cap) { t = t << 4; sh = sh + 4; } }
        if (t < 4194304) { if (sh + 2 <= cap) { t = t << 2; sh = sh + 2; } }
        if (t < 8388608) { if (sh + 1 <= cap) { t = t << 1; sh = sh + 1; } }
    }
    diff = diff << sh;
    off = off - sh;
    let q: i32 = diff >> 14;
    let rem: i32 = diff - (q << 14);
    let half: i32 = 8192;
    var mant: i32 = q - 512;
    if (rem > half) {
        mant = mant + 1;
    } else if (rem == half) {
        if (sticky == 1) {
            mant = mant + 1;
        } else {
            if ((q & 1) == 1) {
                mant = mant + 1;
            }
        }
    }
    if (mant >= 512) {
        mant = 0;
        off = off + 1;
        if (off > 80) { off = 80; }
    }
    return ((off as u32) << 9) | (mant as u32);
}

// sadd: signed addition
fn sadd(a: u32, b: u32) -> u32 {
    if (a == 0) { return b; }
    if (b == 0) { return a; }
    let sa: u32 = a >> 16;
    let ma: u32 = a & 65535;
    let sb: u32 = b >> 16;
    let mb: u32 = b & 65535;
    if (sa == sb) {
        return ((sa << 16) | magadd(ma, mb)) & 0xffffffff;
    }
    var bsign: u32 = sa;
    var r: u32 = magsub(ma, mb);
    if (ma < mb) {
        r = magsub(mb, ma);
        bsign = sb;
    }
    if (r == 0) { return 0; }
    return ((bsign << 16) | r) & 0xffffffff;
}

// smul: signed multiplication
fn smul(a: u32, b: u32) -> u32 {
    if (a == 0 || b == 0) { return 0; }
    let sign: u32 = ((a >> 16) & 1) ^ ((b >> 16) & 1);
    let mag: u32 = magmul(a & 65535, b & 65535);
    if (mag == 0) { return 0; }
    return (sign << 16) | mag;
}

// magmul: magnitude multiplication (used by smul)
fn magmul(a16: u32, b16: u32) -> u32 {
    let ao: i32 = (a16 >> 9) as i32;
    let am: i32 = (a16 & 511) as i32;
    let bo: i32 = (b16 >> 9) as i32;
    let bm: i32 = (b16 & 511) as i32;
    var prod: i32 = (512 + am) * (512 + bm);
    let carry: i32 = if (prod >= 524288) 1 else 0;
    var q: i32;
    var r: i32;
    var half: i32;
    if (carry != 0) {
        q = prod >> 10;
        r = prod & 1023;
        half = 512;
    } else {
        q = prod >> 9;
        r = prod & 511;
        half = 256;
    }
    var mant: i32 = q - 512;
    if (r > half) {
        mant = mant + 1;
    } else if (r == half) {
        if ((q & 1) == 1) {
            mant = mant + 1;
        }
    }
    let sm_: i32 = ao + bo + carry;
    var out_off: i32 = 0;
    if (sm_ >= 40) {
        out_off = if (sm_ - 40 > 80) 80 else sm_ - 40;
    }
    if (mant >= 512) {
        mant = 0;
        out_off = if (out_off + 1 > 80) 80 else out_off + 1;
    }
    return ((out_off as u32) << 9) | (mant as u32);
}

// neg: negation
fn neg(v: u32) -> u32 {
    if (v == 0) { return 0; }
    return v ^ 65536;
}

// pow2_frac: helper for exp2
fn pow2_frac(f: u32) -> u32 {
    var p: u32 = 6;
    var i: u32 = 0;
    var f_: u32 = f;
    // arr = [29, 123, 354]
    let a0: u32 = 29;
    let a1: u32 = 123;
    let a2: u32 = 354;
    while (i < 3) {
        let c: u32 = if (i == 0) a0 else if (i == 1) a1 else a2;
        p = ((p * f_ + 32768) >> 16) + c; // H=1<<15 = 32768
        i += 1;
    }
    p = ((p * f_ + 32768) >> 16);
    if (p > 511) { p = 511; }
    return p;
}

// exp2: approximate base-2 exponential
fn exp2(x: u32) -> u32 {
    if (x == 0) { return 20480; }
    let ng: u32 = (x >> 16) & 1;
    let off_in: u32 = (x >> 9) & 127;
    let mant_in: u32 = x & 511;
    if (off_in >= 48) {
        if (ng == 1) { return 512; } else { return (80 << 9) | 511; }
    }
    let num: u32 = 512 + mant_in;
    let sh: i32 = (off_in as i32) - 33;
    var mq: u32;
    if (sh >= 0) {
        mq = num << (sh as u32);
    } else {
        mq = num >> ((-sh) as u32);
    }
    let ki: u32 = mq >> 16;
    let ff: u32 = mq & 65535;
    var k: i32;
    var f: u32;
    if (ng == 1) {
        k = if (ff == 0) -(ki as i32) else -((ki + 1) as i32);
        f = if (ff == 0) 0 else 65536 - ff;
    } else {
        k = ki as i32;
        f = ff;
    }
    let mut mant: u32 = pow2_frac(f);
    var off: i32 = k + 40;
    if (off < 1) { off = 1; }
    if (off > 80) { off = 80; }
    return ((off as u32) << 9) | mant;
}

// recip: reciprocal
fn recip(x: u32) -> u32 {
    if (x == 0) { return (80 << 9) | 511; }
    let s: u32 = (x >> 16) & 1;
    let o: u32 = (x >> 9) & 127;
    let m: u32 = x & 511;
    let den: u32 = 512 + m;
    var mp: i32 = ((524288 + (den >> 1)) / den) as i32 - 512;
    var off: i32 = 79 - (o as i32);
    if (mp >= 512) {
        mp = mp - 512;
        off = off + 1;
    }
    if (off < 1) {
        off = 1;
        mp = 0;
    }
    if (off > 80) {
        off = 80;
        mp = 511;
    }
    return (s << 16) | ((off as u32) << 9) | (mp as u32);
}

// gt: greater than (used by softmax)
fn gt(a: u32, b: u32) -> u8 {
    let ca: u8 = cat(a);
    let cb: u8 = cat(b);
    if (ca != cb) {
        return if (ca > cb) 1 else 0;
    }
    let ma: u32 = a & 65535;
    let mb: u32 = b & 65535;
    if (ca == 2) {
        return if (ma > mb) 1 else 0;
    }
    if (ca == 0) {
        return if (ma < mb) 1 else 0;
    }
    return 0;
}

// cat: category (used by gt)
fn cat(a: u32) -> u8 {
    if (a == 0) { return 1; }
    return if ((a >> 16) == 0) 2 else 0;
}

// softmax: compute softmax of four logits for index sel
fn softmax(ls: [4]u32, sel: u8) -> u32 {
    var mx: u32 = ls[0];
    var i: u32 = 1;
    while (i < 4) {
        if (gt(ls[i], mx) == 1) {
            mx = ls[i];
        }
        i += 1;
    }
    var es: [4]u32 = undefined;
    i = 0;
    while (i < 4) {
        es[i] = sadd(ls[i], neg(mx));
        es[i] = exp2(es[i]);
        i += 1;
    }
    let S: u32 = sadd(sadd(es[0], es[1]), sadd(es[2], es[3]));
    let r: u32 = recip(S);
    let tmp: u32 = magmul(es[sel as u32] & 65535, r & 65535);
    return tmp & 0xffff;
}

// quadrant: quadrant of point (x0, x1); kept from the training demo
fn quadrant(x0: f32, x1: f32) -> u8 {
    if (x0 >= 0.0 && x1 >= 0.0) { return 0; }
    if (x0 < 0.0 && x1 >= 0.0) { return 1; }
    if (x0 < 0.0 && x1 < 0.0) { return 2; }
    return 3;
}

// Stubs: the rng-driven training demo is host work (Random, file I/O, prints).
pub fn gen(n: u32) -> []f32 {
    return []f32{};
}

pub fn accuracy(W: [4][2]u32, data: []f32) -> f32 {
    return 0.0;
}

pub fn main() -> i32 {
    return 0;
}

test f2gft_roundtrip_zero {
    assert(f2gft(0.0) == 0);
    assert(gft_value(0) == 0.0);
}

test f2gft_sign_bit {
    const p = f2gft(1.5);
    const n = f2gft(-1.5);
    assert((p >> 16) == 0);
    assert((n >> 16) == 1);
}

test sadd_zero_is_identity {
    const v = f2gft(1.25);
    assert(sadd(v, 0) == v);
    assert(sadd(0, v) == v);
}

test smul_sign_xor {
    const p = f2gft(2.0);
    const n = f2gft(-2.0);
    assert((smul(p, p) >> 16) == 0);
    assert((smul(p, n) >> 16) == 1);
    assert((smul(n, n) >> 16) == 0);
}

test exp2_of_zero_is_one {
    assert(exp2(0) == 20480);
}

test recip_of_one_is_one {
    const one = f2gft(1.0);
    const r = recip(one);
    assert(gft_value(r) > 0.999 && gft_value(r) < 1.001);
}

test cat_categories {
    assert(cat(0) == 1);
    assert(cat(f2gft(1.0)) == 2);
    assert(cat(f2gft(-1.0)) == 0);
}

test softmax_picks_the_max_index {
    var ls: [4]u32 = undefined;
    ls[0] = f2gft(1.0);
    ls[1] = f2gft(2.0);
    ls[2] = f2gft(3.0);
    ls[3] = f2gft(0.5);
    let p2 = softmax(ls, 2);
    let p0 = softmax(ls, 0);
    assert(gft_value(p2) > gft_value(p0));
}
