const SPECS = "specs";

fn starts_with(s: string, prefix: string) -> bool {
    if s.len < prefix.len {
        return false;
    }
    let i = 0;
    while i < prefix.len {
        if s[i] != prefix[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn ends_with(s: string, suffix: string) -> bool {
    if s.len < suffix.len {
        return false;
    }
    let i = s.len - suffix.len;
    let j = 0;
    while j < suffix.len {
        if s[i + j] != suffix[j] {
            return false;
        }
        j = j + 1;
    }
    return true;
}

fn lstrip(s: string) -> string {
    let i = 0;
    while i < s.len && (s[i] == ' ' || s[i] == '\t') {
        i = i + 1;
    }
    // Open-ended slice `s[i..]` written with its explicit end.
    return s[i..s.len];
}

// Recursive walk
// The original declared `walk` inside code_lines as a closure that appended
// to code_lines' local `paths` and `lines`. t27 has no closures or nested
// functions, so walk is a top-level function that receives both accumulators
// by pointer; the traversal and the filtering are unchanged.
fn walk(dir: string, paths: *[]string, lines: *[]string) {
    let entries = read_dir(dir);
    let i = 0;
    while i < entries.len {
        let entry = entries[i];
        let full = dir + "/" + entry;
        if is_dir(full) {
            walk(full, paths, lines);
        } else if ends_with(full, ".t27") {
            let content = read_file_to_string(full);
            let content_lines = split(content, "\n");
            let j = 0;
            while j < content_lines.len {
                let line = content_lines[j];
                let trimmed = lstrip(line);
                if !starts_with(trimmed, "//") && !starts_with(trimmed, "#") {
                    paths.push(full);
                    lines.push(line);
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
}

fn code_lines() -> ([]string, []string) {
    // Check if SPECS directory exists
    if !dir_exists(SPECS) {
        eprint("published_figures: no specs directory. Exit 2.");
        exit(2);
    }
    let mut paths = [];
    let mut lines = [];
    walk(SPECS, &paths, &lines);
    return (paths, lines);
}

fn derive() -> ([]int, []int) {
    let mut rows = []; // each element is (regex: Regex, count: int, files: []string)
    let i = 0;
    while i < FIGURES.len {
        let fig = FIGURES[i];
        let rx = regex_compile(fig.pattern);
        rows.push((rx, 0, []));
        i = i + 1;
    }
    let (paths, lines) = code_lines();
    let pi = 0;
    while pi < paths.len {
        let p = paths[pi];
        let line = lines[pi];
        let ri = 0;
        while ri < rows.len {
            let mut row = rows[ri];
            let rx = row.0;
            let mut count = row.1;
            let mut files = row.2;
            let matches = regex_find_all(rx, line);
            let k = matches.len;
            if k > 0 {
                count = count + k;
                // Check if p is already in files
                let mut found = false;
                let fj = 0;
                while fj < files.len {
                    if files[fj] == p {
                        found = true;
                        break;
                    }
                    fj = fj + 1;
                }
                if !found {
                    // Append p to files
                    let new_files = files + [p];
                    files = new_files;
                }
                rows[ri] = (rx, count, files);
            }
            ri = ri + 1;
        }
        pi = pi + 1;
    }
    let mut counts = [];
    let mut nspecs = [];
    let ri = 0;
    while ri < rows.len {
        let row = rows[ri];
        counts.push(row.1);
        let mut unique = [];
        // Tuple field `row.2` is bound to a name first: `row.2.len` lexes
        // `2.` as a number and does not parse.
        let row_files = row.2;
        let fj = 0;
        while fj < row_files.len {
            let f = row_files[fj];
            let mut found = false;
            let uj = 0;
            while uj < unique.len {
                if unique[uj] == f {
                    found = true;
                    break;
                }
                uj = uj + 1;
            }
            if !found {
                unique.push(f);
            }
            fj = fj + 1;
        }
        nspecs.push(unique.len);
        ri = ri + 1;
    }
    return (counts, nspecs);
}

fn self_check() -> int {
    let dir = temp_dir();
    let p = dir + "/x.t27";
    write_file(p, "// cast_i8(1) in a comment\nvar a = cast_i8(2);\n");
    // Raw string r"..." spelled as an ordinary string with escaped backslashes.
    let rx = regex_compile("(?<![\\w.@])cast_i8\\s*\\(");
    let content = read_file_to_string(p);
    let lines = split(content, "\n");
    let mut seen = 0;
    let li = 0;
    while li < lines.len {
        let line = lines[li];
        let trimmed = lstrip(line);
        if !starts_with(trimmed, "//") {
            let matches = regex_find_all(rx, line);
            seen = seen + matches.len;
        }
        li = li + 1;
    }
    print("  one in code, one in a comment -> counted ");
    print_int(seen);
    print(" (");
    if seen == 1 {
        print("PASS");
    } else {
        print("FAIL");
    }
    print(")\n");
    if seen == 1 {
        return 0;
    } else {
        return 2;
    }
}

fn main() -> int {
    let args = args();
    let i = 0;
    while i < args.len {
        if args[i] == "--self-check" {
            return self_check();
        }
        i = i + 1;
    }
    let got = derive(); // ([]int, []int)
    let mut check = false;
    let i = 0;
    while i < args.len {
        if args[i] == "--check" {
            check = true;
            break;
        }
        i = i + 1;
    }
    let mut drift = 0;
    // Print header
    print("Figure                         Unit   Expected   Got   Files  Where\n");
    print("----------------------------------------------------------------\n");
    let i = 0;
    while i < FIGURES.len {
        let fig = FIGURES[i];
        let now = got.0[i];
        let nspecs = got.1[i];
        let mut mark = "";
        if now != fig.pinned {
            mark = "  DRIFT";
            drift = drift + 1;
        }
        // We'll print the row with fixed width? We'll just separate by spaces for simplicity.
        print(fig.name);
        // We assume we have a way to pad to a width. We'll skip for now and just print with spaces.
        print("  ");
        print(fig.unit);
        print("  ");
        print_int(fig.pinned);
        print("  ");
        print_int(now);
        print("  ");
        print_int(nspecs);
        print("  ");
        print(fig.where);
        print(mark);
        print("\n");
        i = i + 1;
    }
    if drift > 0 && check {
        print("\n");
        print_int(drift);
        print(" figure(s) drifted; run `t27c seal` to update the pinned values.\n");
        return 1;
    } else {
        return 0;
    }
}

