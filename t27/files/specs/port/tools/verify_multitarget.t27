// specs/port/tools/verify_multitarget.t27 -- port of tools/verify_multitarget.py:
// the host generates smul/sadd from the ternary_encoding spec with t27c, builds
// each backend and compares every pair against the Python GF-T model. The port
// keeps the operand-pair generation (a deterministic LCG, the same shape the
// corpus fuzzers use) and the verdict rule; every host run is stubbed.

module verify-multitarget;

// Constants from the original
pub const N : u32 = 1000;
pub const REQUIRE : bool = false;

pub const Pair = struct {
    a: i32,
    b: i32,
};

// Deterministic pair generation: (a, b) in [-1000, 1000].
fn next_pair(seed: u64) -> (i32, i32, u64) {
    let next = seed * 6364136223846793005 + 1442695040888963407;
    let hi = ((next >> 32) as u32) as i32;
    let lo = (next as u32) as i32;
    let a = (hi % 2001) - 1000;
    let b = (lo % 2001) - 1000;
    return (a, b, next);
}

pub fn gen_pairs(seed: u64) -> [1000]Pair {
    var pairs: [1000]Pair = undefined;
    var s = seed;
    var i: u32 = 0;
    while i < N {
        let p = next_pair(s);
        pairs[i] = Pair{ .a = p.0, .b = p.1 };
        s = p.2;
        i += 1;
    }
    return pairs;
}

// The Python GF-T model's smul over one pair; the reference the backends are
// held against. Scaled integer multiply, as the host model computes it.
pub fn py_ref(a: i32, b: i32) -> i32 {
    return a * b;
}

// Stub: the host runs the generated C binary over the pairs.
pub fn run_c(pairs: [1000]Pair) -> []i32 {
    return []i32{};
}

// Stub: the host runs the generated Rust binary over the pairs.
pub fn run_rust(pairs: [1000]Pair) -> []i32 {
    return []i32{};
}

// Stub: the host runs the generated Zig binary over the pairs.
pub fn run_zig(pairs: [1000]Pair) -> []i32 {
    return []i32{};
}

// The verdict the host prints: bit-exact over every pair, or the first
// mismatch. With no backend results (the port cannot run them), the honest
// verdict is "could not run".
pub fn main() -> i32 {
    return 2;
}

// Stub: the negative control plants a known mismatch on the host.
pub fn self_check() -> i32 {
    return 0;
}

test gen_pairs_is_deterministic {
    const a = gen_pairs(27);
    const b = gen_pairs(27);
    var i: u32 = 0;
    while i < N {
        assert(a[i].a == b[i].a);
        assert(a[i].b == b[i].b);
        i += 1;
    }
}

test py_ref_matches_the_scaled_model {
    assert(py_ref(3, 7) == 21);
    assert(py_ref(-5, 6) == -30);
}
