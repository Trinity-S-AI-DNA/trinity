test _rinteger_small_bits {
    assert(_rinteger(1) == 1);
    assert(_rinteger(2) == 2);
    assert(_rinteger(3) == 4);
    assert(_rinteger(4) == 8);
}

test _rinteger_edge_cases {
    // Test with conservative values that definitely won't overflow
    assert(_rinteger(5) == 16);
    assert(_rinteger(6) == 32);
    assert(_rinteger(7) == 64);
}

test _rinteger_zero_bits {
    // Edge case: bits should be at least 1
    assert(_rinteger(1) == 1);
}

test _rinteger_large_bits {
    // Test with larger bit values (conservative range)
    assert(_rinteger(10) == 512);
    assert(_rinteger(15) == 16384);
}