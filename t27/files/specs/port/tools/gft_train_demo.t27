module gft_train_demo;

// Constants from the original implementation
pub const BIAS : i32 = 40;

// ---- GF-T16 signed arithmetic (bit-exact to the .t27 specs) ----

fn gft_value(u: i32) -> f64 {
    if u == 0 {
        return 0.0;
    }
    let s : f64 = if ((u >> 16) == 1) { -1.0 } else { 1.0 };
    let mag : i32 = u & 65535;
    let mantissa_fraction : f64 = (mag & 511) as f64 / 512.0;
    let exponent : i32 = (mag >> 9) - BIAS;
    return s * (1.0 + mantissa_fraction) * (2.0 as f64).powf(exponent as f64);
}

fn f2gft(x: f64) -> i32 {
    if x == 0.0 {
        return 0;
    }
    let s : i32 = if x < 0.0 { 1 } else { 0 };
    let ax : f64 = x.abs();
    let exp : f64 = ax.log2().floor();
    let frac : f64 = ax / (2.0 as f64).powf(exp);
    let mut mant : i32 = ((frac - 1.0) * 512.0).round() as i32;
    let mut off : i32 = (exp as i32) + BIAS;
    if mant == 512 {
        mant = 0;
        off += 1;
    }
    if off < 1 {
        off = 1;
        mant = 0;
    }
    if off > 80 {
        off = 80;
        mant = 511;
    }
    return (s << 16) | (off << 9) | mant;
}

fn magadd(a: i32, b: i32) -> i32 {
    let ao : i32 = a >> 9;
    let am : i32 = a & 511;
    let bo : i32 = b >> 9;
    let bm : i32 = b & 511;
    let ho : i32;
    let hm : i32;
    let lo : i32;
    let lm : i32;
    if ao >= bo {
        ho = ao;
        hm = am;
        lo = bo;
        lm = bm;
    } else {
        ho = bo;
        hm = bm;
        lo = ao;
        lm = am;
    }
    let hs : i32 = 512 + hm;
    let ls : i32 = 512 + lm;
    let d : i32 = ho - lo;
    if d > 11 {
        d = 11;
    }
    let losh : i32 = ls >> d;
    let rem : i32 = ls - (losh << d);
    let mut s : i32 = hs + losh;
    let mut off : i32 = ho;
    let mut mant : i32 = s - 512;
    if s >= 1024 {
        let gg : i32 = s & 1;
        let pre : i32 = s >> 1;
        mant = pre - 512;
        if gg == 1 {
            if rem > 0 {
                mant += 1;
            } else {
                if (pre & 1) == 1 {
                    mant += 1;
                }
            }
        }
        off = ho + 1;
        if off > 80 {
            off = 80;
        }
    } else {
        let t : i32 = rem << 1;
        let hf : i32 = 1 << d;
        if t > hf {
            mant += 1;
        } else if t == hf {
            if (s & 1) == 1 {
                mant += 1;
            }
        }
    }
    if mant >= 512 {
        mant = 0;
        off += 1;
        if off > 80 {
            off = 80;
        }
    }
    return (off << 9) | mant;
}

fn magsub(hi: i32, lo: i32) -> i32 {
    if hi == lo {
        return 0;
    }
    let ho : i32 = hi >> 9;
    let hm : i32 = hi & 511;
    let lo_o : i32 = lo >> 9;
    let lm : i32 = lo & 511;
    let d : i32 = ho - lo_o;
    let mut hs : i32 = (512 + hm) << 14;
    let mut la : i32 = 0;
    let mut sticky : i32 = 0;
    if d < 0 {
        return 0; // hi<lo: spec discards this call (recomputes magsub(mb,ma))
    }
    if d >= 26 {
        la = 0;
        sticky = 1;
    } else {
        let ls : i32 = (512 + lm) << 14;
        la = ls >> d;
        if (ls - (la << d)) > 0 {
            sticky = 1;
        }
    }
    let mut diff : i32 = hs - la;
    let mut off : i32 = ho;
    // for _ in range(12):
    let mut _i : i32 = 0;
    while _i < 12 {
        if diff < 8388608 && off > 1 {
            diff = diff << 1;
            off -= 1;
        }
        _i += 1;
    }
    let q : i32 = diff >> 14;
    let rem : i32 = diff - (q << 14);
    let half : i32 = 8192;
    let mut mant : i32 = q - 512;
    if rem > half {
        mant += 1;
    } else if rem == half {
        if sticky == 1 {
            mant += 1;
        } else {
            if (q & 1) == 1 {
                mant += 1;
            }
        }
    }
    if mant >= 512 {
        mant = 0;
        off += 1;
        if off > 80 {
            off = 80;
        }
    }
    return (off << 9) | mant;
}

fn sadd(a: i32, b: i32) -> i32 {
    if a == 0 {
        return b;
    }
    if b == 0 {
        return a;
    }
    let sa : i32 = a >> 16;
    let ma : i32 = a & 65535;
    let sb : i32 = b >> 16;
    let mb : i32 = b & 65535;
    if sa == sb {
        return ((sa << 16) | magadd(ma, mb)) & 0xffffffff;
    }
    let bsign : i32 = sa;
    let mut r : i32 = magsub(ma, mb);
    if ma < mb {
        r = magsub(mb, ma);
        bsign = sb;
    }
    if r == 0 {
        return 0;
    }
    return ((bsign << 16) | r) & 0xffffffff;
}

fn neg(v: i32) -> i32 {
    if v == 0 {
        return 0;
    } else {
        return v ^ 65536;
    }
}

fn magmul(a16: i32, b16: i32) -> i32 {
    let ao : i32 = a16 >> 9;
    let am : i32 = a16 & 511;
    let bo : i32 = b16 >> 9;
    let bm : i32 = b16 & 511;
    let prod : i32 = (512 + am) * (512 + bm);
    let mut carry : i32;
    if prod >= 524288 {
        carry = 1;
    } else {
        carry = 0;
    }
    let mut q : i32;
    let mut r : i32;
    let mut half : i32;
    if carry == 1 {
        q = prod >> 10;
        r = prod & 1023;
        half = 512;
    } else {
        q = prod >> 9;
        r = prod & 511;
        half = 256;
    }
    let mut mant : i32 = q - 512;
    if r > half {
        mant += 1;
    } else if r == half {
        if (q & 1) == 1 {
            mant += 1;
        }
    }
    let sm_ : i32 = ao + bo + carry;
    let mut out_off : i32 = 0;
    if sm_ >= 40 {
        out_off = sm_ - 40;
        if out_off > 80 {
            out_off = 80;
        }
    }
    if mant >= 512 {
        mant = 0;
        out_off += 1;
        if out_off > 80 {
            out_off = 80;
        }
    }
    return (out_off << 9) | mant;
}

fn smul(a: i32, b: i32) -> i32 {
    if a == 0 || b == 0 {
        return 0;
    }
    let sign : i32 = ((a >> 16) & 1) ^ ((b >> 16) & 1);
    let mag : i32 = magmul(a & 65535, b & 65535);
    if mag == 0 {
        return 0;
    } else {
        return (sign << 16) | mag;
    }
}

// Test blocks for each function

test "gft_value_zero" {
    let result = gft_value(0);
    assert(result == 0.0, "gft_value(0) should return 0.0");
}

test "gft_value_one" {
    let result = gft_value(20480);
    assert((result - 1.0).abs() < 1e-6, "gft_value(20480) should return 1.0");
}

test "gft_value_negative_one" {
    let result = gft_value(86016);
    assert((result - (-1.0)).abs() < 1e-6, "gft_value(86016) should return -1.0");
}

test "gft_value_two" {
    let result = gft_value(20992);
    assert((result - 2.0).abs() < 1e-6, "gft_value(20992) should return 2.0");
}

test "f2gft_zero" {
    let result = f2gft(0.0);
    assert(result == 0, "f2gft(0.0) should return 0");
}

test "f2gft_one" {
    let result = f2gft(1.0);
    assert(result == 20480, "f2gft(1.0) should return 20480");
}

test "f2gft_negative_one" {
    let result = f2gft(-1.0);
    assert(result == 86016, "f2gft(-1.0) should return 86016");
}

test "f2gft_two" {
    let result = f2gft(2.0);
    assert(result == 20992, "f2gft(2.0) should return 20992");
}

test "magadd_zero_zero" {
    let result = magadd(0, 0);
    assert(result == 512, "magadd(0,0) should return 512");
}

test "magadd_zero_512" {
    let result = magadd(0, 512);
    assert(result == 768, "magadd(0,512) should return 768");
}

test "magadd_512_512" {
    let result = magadd(512, 512);
    assert(result == 1024, "magadd(512,512) should return 1024");
}

test "magadd_zero_one" {
    let result = magadd(0, 1);
    assert(result == 512, "magadd(0,1) should return 512");
}

test "magadd_512_one" {
    let result = magadd(512, 1);
    assert(result == 768, "magadd(512,1) should return 768");
}

test "magadd_one_512" {
    let result = magadd(1, 512);
    assert(result == 768, "magadd(1,512) should return 768");
}

test "magadd_one_one" {
    let result = magadd(1, 1);
    assert(result == 513, "magadd(1,1) should return 513");
}

test "magadd_512_zero" {
    let result = magadd(512, 0);
    assert(result == 768, "magadd(512,0) should return 768");
}

test "magsub_512_zero" {
    let result = magsub(512, 0);
    assert(result == -256, "magsub(512,0) should return -256");
}

test "magsub_zero_512" {
    let result = magsub(0, 512);
    assert(result == 0, "magsub(0,512) should return 0");
}

test "magsub_512_512" {
    let result = magsub(512, 512);
    assert(result == 0, "magsub(512,512) should return 0");
}

test "magsub_1024_512" {
    let result = magsub(1024, 512);
    assert(result == 512, "magsub(1024,512) should return 512");
}

test "magsub_512_1024" {
    let result = magsub(512, 1024);
    assert(result == 0, "magsub(512,1024) should return 0");
}

test "sadd_one_one" {
    let a = f2gft(1.0);
    let b = f2gft(1.0);
    let result = sadd(a, b);
    let expected = f2gft(2.0);
    assert(result == expected, "sadd(f2gft(1.0), f2gft(1.0)) should return f2gft(2.0)");
}

test "sadd_one_neg_one" {
    let a = f2gft(1.0);
    let b = f2gft(-1.0);
    let result = sadd(a, b);
    let expected = 0;
    assert(result == expected, "sadd(f2gft(1.0), f2gft(-1.0)) should return 0");
}

test "sadd_two_three" {
    let a = f2gft(2.0);
    let b = f2gft(3.0);
    let result = sadd(a, b);
    let expected = f2gft(5.0);
    assert(result == expected, "sadd(f2gft(2.0), f2gft(3.0)) should return f2gft(5.0)");
}

test "neg_zero" {
    let result = neg(0);
    assert(result == 0, "neg(0) should return 0");
}

test "neg_one" {
    let a = f2gft(1.0);
    let result = neg(a);
    let expected = f2gft(-1.0);
    assert(result == expected, "neg(f2gft(1.0)) should return f2gft(-1.0)");
}

test "neg_neg_one" {
    let a = f2gft(-1.0);
    let result = neg(a);
    let expected = f2gft(1.0);
    assert(result == expected, "neg(f2gft(-1.0)) should return f2gft(1.0)");
}

test "magmul_512_512" {
    let result = magmul(512, 512);
    assert(result == 0, "magmul(512,512) should return 0");
}

test "magmul_512_zero" {
    let result = magmul(512, 0);
    assert(result == 0, "magmul(512,0) should return 0");
}

test "magmul_zero_512" {
    let result = magmul(0, 512);
    assert(result == 0, "magmul(0,512) should return 0");
}

test "magmul_768_768" {
    let result = magmul(768, 768);
    assert(result == 64, "magmul(768,768) should return 64");
}

test "smul_one_one" {
    let a = f2gft(1.0);
    let b = f2gft(1.0);
    let result = smul(a, b);
    let expected = f2gft(1.0);
    assert(result == expected, "smul(f2gft(1.0), f2gft(1.0)) should return f2gft(1.0)");
}

test "smul_one_neg_one" {
    let a = f2gft(1.0);
    let b = f2gft(-1.0);
    let result = smul(a, b);
    let expected = f2gft(-1.0);
    assert(result == expected, "smul(f2gft(1.0), f2gft(-1.0)) should return f2gft(-1.0)");
}