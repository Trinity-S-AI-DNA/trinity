pub const CLK_BITS_OUT_NEG: u8 = undefined;
pub const CLK_TMS_OUT_NEG: u8 = undefined;

pub struct Mpsse {
}

pub fn mpsse_new(idx: i32) Mpsse {
    undefined;
}

pub fn mpsse_tms(mpsse: Mpsse, bits: []u8) void {
    undefined;
}

pub fn mpsse_w(mpsse: Mpsse, data: []u8) void {
    undefined;
}

pub fn mpsse_shift_dr_read(mpsse: Mpsse, nbits: i32) []u8 {
    undefined;
}

pub fn mpsse_close(mpsse: Mpsse) void {
    undefined;
}

pub fn shift_ir(mpsse: Mpsse, val: u8) void {
    mpsse_tms(mpsse, [1, 1, 0, 0]);
    mpsse_w(mpsse, [CLK_BITS_OUT_NEG, 4, val & 0x1F]);
    mpsse_w(mpsse, [CLK_TMS_OUT_NEG, 0, (((val >> 5) & 1) << 7) | 0x01]);
    mpsse_tms(mpsse, [1, 0]);
}

pub fn user1(idx: i32, nbits: i32) u8 {
    const mpsse = mpsse_new(idx);
    defer mpsse_close(mpsse);
    mpsse_tms(mpsse, [1, 1, 1, 1, 1]);
    mpsse_tms(mpsse, [0]);
    shift_ir(mpsse, 0x02);
    mpsse_tms(mpsse, [1, 0, 0]);
    const r = mpsse_shift_dr_read(mpsse, nbits);
    mpsse_tms(mpsse, [1, 1, 0]);
    if (r.len > 0) {
        return r[0] & ((1 << nbits) - 1);
    } else {
        return 0;
    }
}

test shift_ir_test {
    const mpsse = mpsse_new(0);
    shift_ir(mpsse, 0x12);
    assert true;  // smoke test: shift_ir returns
}

// The first draft checked `result == result`, which holds for any value.
// user1 masks its read to nbits bits, so with nbits = 4 the result is below 16.
test user1_test {
    const result = user1(0, 4);
    assert result < 16;
}
