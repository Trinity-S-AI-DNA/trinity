module MpsseJtag;

pub const MpsseContext = struct {
    ctx: i32,
};

pub fn mpsse_init(index: i32) -> MpsseContext {
    return MpsseContext{ .ctx = index };
}

pub fn mpsse_w(self: *MpsseContext, data: []const u8) -> void {
