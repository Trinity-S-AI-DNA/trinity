// specs/port/tools/ring_spec_differential.t27 -- port of tools/ring_spec_differential.py:
// the host walks a spec's function signatures, pairs each type with its ring
// producer, emits the differential and runs it. The port keeps the pure
// helpers (integer-type set, signature parsing) in the supported subset; the
// emit/run/self-check host parts are stubbed.

module ring-spec-differential;

pub const INT_TYPES : [10]str = ["u8", "u16", "u32", "u64", "usize", "i8", "i16", "i32", "i64", "isize"];

pub struct SigItem {
    name: str,
    ret: str,
    params: []str,
}

// True when ty is one of the integer types.
pub fn is_int_type(ty: str) -> bool {
    var i: u32 = 0;
    while (i < 10) {
        if (INT_TYPES[i] == ty) {
            return true;
        }
        i += 1;
    }
    return false;
}

// Parse one "fn name(...) -> ret" header line into a SigItem, or none.
pub fn parse_sig(line: str) -> Option<SigItem> {
    let t = line.trim();
    if !t.starts_with("fn ") {
        return none();
    }
    let rest = t.trim_start("fn ");
    let parts = rest.split("(");
    if parts.len < 2 {
        return none();
    }
    let name = parts[0].trim();
    let tail = parts[1].split(")");
    if tail.len < 2 {
        return none();
    }
    let params = tail[0].split(",");
    var ret = "";
    let after = tail[1].trim();
    if after.starts_with("->") {
        ret = after.trim_start("->").trim();
    }
    return some(SigItem{ name = name, ret = ret, params = params });
}

// The number of fn headers a spec text declares. The host collects the items
// themselves; the port counts what the parser can see.
pub fn signatures(text: str) -> u32 {
    var count: u32 = 0;
    for line in text.lines() {
        let sig = parse_sig(line);
        if sig.is_some {
            count += 1;
        }
    }
    return count;
}

// Stub: the host emits the ring library and the differential crate.
pub fn emit(ring_lib: str, spec_rs: str) -> i32 {
    return 0;
}

pub fn t27c() -> str {
    return "t27c";
}

// Stub: the host builds and runs the differential.
pub fn run(ring: str, spec: str) -> i32 {
    return 2;
}

pub fn self_check() -> i32 {
    return 0;
}

pub fn main() -> i32 {
    return 2;
}

test is_int_type_cases {
    assert(is_int_type("u32"));
    assert(is_int_type("isize"));
    assert(!is_int_type("bool"));
    assert(!is_int_type(""));
}

test parse_sig_reads_name_and_ret {
    const s = parse_sig("fn sadd(a: u32, b: u32) -> u32 {");
    assert(s.is_some);
    assert(s.value.name == "sadd");
    assert(s.value.ret == "u32");
}

test parse_sig_rejects_non_fn {
    const s = parse_sig("let x = 1;");
    assert(!s.is_some);
}

test signatures_collects_headers {
    const text = "fn f(a: u32) -> u32 {\n}\nfn g() -> void {\n}\nlet x = 1;";
    const sigs = signatures(text);
    assert(sigs == 2);
}
