// specs/port/tools/check_json_parses.t27
// Port of tools/check_json_parses.py functions (tracked_json, scan, baseline,
// self_check, main). Host actions -- git ls-files, filesystem walks, json
// parsing -- are stubs, matching the sibling ports in specs/port/tools/.

module check-json-parses;

// Constants from the original implementation
pub const EXCLUDE_PREFIX : str = "external/";
pub const BASELINE_PATH : str = "tools/json_parse_baseline.txt";

pub const ScanResult = struct {
    empty: u32,
    bad: u32,
    ok: u32,
};

// Stub for the host json parse: the gate rejects bare Infinity/-Infinity/NaN,
// which CPython accepts and RFC 8259 does not. The real parse runs in the host
// tool; the port keeps the empty/bad split the exit code is built from.
fn json_parses_strict(text: str) -> bool {
    return text.trim() != "";
}

// Stub for the host filesystem walk: returns the number of tracked JSON files
// the walk would yield. The real gate counts them via `git ls-files -z`.
fn tracked_count() -> u32 {
    return 0;
}

// Classify one file's text: 1 = empty (a build that died), 2 = unparseable,
// 0 = parses. Mirrors the split in the original's scan().
fn classify(text: str) -> i32 {
    if text.trim() == "" {
        return 1;
    }
    if !json_parses_strict(text) {
        return 2;
    }
    return 0;
}

// The original's scan(): classify the tracked files and return the counts the
// exit code is derived from. File reads are stubbed at zero files.
pub fn scan() -> ScanResult {
    var empty = 0;
    var bad = 0;
    var ok = 0;

    let count = tracked_count();
    var i = 0;
    while i < count {
        // The stub cannot read a file body; classify an empty body as empty.
        if classify("") == 1 {
            empty += 1;
        } else {
            ok += 1;
        }
        i += 1;
    }
    return ScanResult{ empty = empty, bad = bad, ok = ok };
}

// The original's baseline update path; stubbed: the host writes the file.
fn update_baseline() -> i32 {
    return 0;
}

// The original's self-check (negative control); stubbed: it plants a broken
// fixture through the host filesystem.
fn self_check() -> i32 {
    return 0;
}

// The original's main(): non-zero when any tracked file is empty or bad.
pub fn main() -> i32 {
    let result = scan();
    if result.empty > 0 {
        return 1;
    }
    if result.bad > 0 {
        return 1;
    }
    return 0;
}
