                let line = lines[end];
                let mut j: u32 = 0;
                while (j < line.len()) {
                    if (line[j] == '{') {
                        depth = depth + 1;
                    } else if (line[j] == '}') {
                        if (depth == 0) {
                            // Unmatched closing brace, but we break anyway
                            break;
                        }
                        depth = depth - 1;
