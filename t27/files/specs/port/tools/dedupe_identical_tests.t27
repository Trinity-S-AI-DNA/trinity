module specs::port::tools;

/// Returns true if the line matches the ITEM pattern (optional pub followed by a keyword).
fn is_item_line(line: str) -> bool {
    let mut i: u32 = 0;
    // Skip whitespace
    while (i < line.len() && line[i] == ' ') {
        i = i + 1;
    }
    // Check for optional "pub "
    if (i + 3 <= line.len() && line[i] == 'p' && line[i+1] == 'u' && line[i+2] == 'b' && line[i+3] == ' ') {
        i = i + 4;
    }
    // Keywords to match
    let keywords = ["test", "bench", "invariant", "fn", "struct", "enum", "module", "const", "impl", "use", "type"];
    let mut kw_index: u32 = 0;
    while (kw_index < keywords.len()) {
        let kw = keywords[kw_index];
        if (line.len() - i >= kw.len() && line[i..i+kw.len()] == kw) {
            // Check word boundary: next char must not be letter, digit, or underscore
            let after = i + kw.len();
            if (after == line.len()) {
                return true;
            }
            let c = line[after];
            if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_')) {
                return true;
            }
        }
        kw_index = kw_index + 1;
    }
    return false;
}

/// Parses a test line. Returns Some((name, has_brace)) if the line is a test line, else None.
/// The name is the test name (either the quoted string or the identifier).
/// has_brace is true if the line contains a '{' after the name (with only whitespace in between).
fn parse_test_line(line: str) -> Option<(str, bool)> {
    let mut i: u32 = 0;
    // Skip whitespace
    while (i < line.len() && line[i] == ' ') {
        i = i + 1;
    }
    // Check for optional "pub "
    if (i + 3 <= line.len() && line[i] == 'p' && line[i+1] == 'u' && line[i+2] == 'b' && line[i+3] == ' ') {
        i = i + 4;
    }
    // Expect literal "test"
    if (i + 4 > line.len() || line[i] != 't' || line[i+1] != 'e' || line[i+2] != 's' || line[i+3] != 't') {
        return None;
    }
    i = i + 4;
    // Skip whitespace after "test"
    while (i < line.len() && line[i] == ' ') {
        i = i + 1;
    }
    if (i >= line.len()) {
        return None;
    }
    let mut name: str = "";
    let mut has_brace: bool = false;
    if (line[i] == '"') {
        // Parse quoted string
        i = i + 1;
        let mut start: u32 = i;
        while (i < line.len() && line[i] != '"') {
            i = i + 1;
        }
        if (i >= line.len()) {
            return None; // unterminated string
        }
        name = line[start..i];
        i = i + 1; // skip closing quote
    } else {
        // Parse identifier: [A-Za-z_][\w\-]*
        let c = line[i];
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_') {
            return None;
        }
        name = name + c;
        i = i + 1;
        while (i < line.len()) {
            let c = line[i];
            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-') {
                name = name + c;
                i = i + 1;
            } else {
                break;
            }
        }
    }
    // Skip whitespace after name
    while (i < line.len() && line[i] == ' ') {
        i = i + 1;
    }
    // Check for optional '{'
    if (i < line.len() && line[i] == '{') {
        has_brace = true;
        i = i + 1;
    }
    // Skip trailing whitespace
    while (i < line.len() && line[i] == ' ') {
        i = i + 1;
    }
    // If there's anything left, it's not a valid test line
    if (i < line.len()) {
        return None;
    }
    return Some((name, has_brace));
}

// A test's line span. Not named Block: scripts/gen_w377.t27 uses Block for a
// character buffer (tri types ratchet, #7437).
struct TestSpan {
    start: u32,
    end: u32,
    name: str,
}

fn blocks(lines: []str) -> []TestSpan {
