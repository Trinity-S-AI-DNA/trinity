// specs/port/tools/check_assertionless_spec_tests.t27 -- port of
// tools/check_assertionless_spec_tests.py: a `test` whose body holds nothing
// but comments, or comments and `assert true`, cannot fail. The port keeps
// the body walker (open a `test NAME {` line, read to the closing brace,
// count bodies that hold a real statement); the corpus census and the
// baseline are host work and stay stubbed.

module check-assertionless-spec-tests;

pub fn refuse(msg: str) -> void {
    return;
}

// True when the trimmed line cannot fail a test: empty, or comment-only.
fn comment_only(line: str) -> bool {
    let t = line.trim();
    if t == "" {
        return true;
    }
    if t.starts_with("//") {
        return true;
    }
    if t.starts_with("/*") && t.ends_with("*/") {
        return true;
    }
    return false;
}

// True when the only statement on the line is `assert true`.
fn assert_true(line: str) -> bool {
    let t = line.trim();
    if t == "assert true" {
        return true;
    }
    if t == "assert true;" {
        return true;
    }
    return false;
}

// The body walker: count `test NAME {` blocks whose body holds at least one
// line that is neither a comment nor `assert true`.
pub fn assertionless_in(text: str) -> u32 {
    var in_test = false;
    var count = 0;

    for line in text.lines() {
        let t = line.trim();
        if !in_test {
            if t.starts_with("test ") && t.ends_with("{") {
                in_test = true;
            }
            continue;
        }
        if t == "}" {
            in_test = false;
            continue;
        }
        if !comment_only(t) && !assert_true(t) {
            count += 1;
            in_test = false; // one real statement: this body can fail
        }
    }
    return count;
}

// Stubs: the census walks the corpus and the baseline files on the host.
pub fn census() -> []str {
    return []str{};
}

pub fn load_baseline() -> []str {
    return []str{};
}

pub fn write_baseline(rows: []str) -> void {
    return;
}

pub fn self_check() -> i32 {
    return 0;
}

pub fn main(argv: []str) -> i32 {
    return 0;
}

test assertionless_in_counts_a_comment_only_body {
    const text = "test single_node_depth {\n    // Validated via invariant\n}";
    assert(assertionless_in(text) == 0);
}

test assertionless_in_counts_assert_true {
    const text = "test k3_no_tautology {\n    assert true\n}";
    assert(assertionless_in(text) == 0);
}

test assertionless_in_counts_a_real_statement {
    const text = "test real_body {\n    let x = 1;\n}";
    assert(assertionless_in(text) == 1);
}
