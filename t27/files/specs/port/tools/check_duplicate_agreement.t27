// specs/port/tools/check_duplicate_agreement.t27 -- port of
// tools/check_duplicate_agreement.py: the host builds the three backend
// outputs of the ternary spec, extracts each function by its signature regex
// with a balanced-brace walk, and digests them for bit-exact agreement. The
// port keeps the contract (extract over a balanced-brace span, digest
// agreement as an Option) with the host run stubbed.

module check-duplicate-agreement;

const TAG_WIDTH: u8 = 8;

// The binary the host invokes; stubbed.
pub fn t27c() -> str {
    return "t27c";
}

// Balanced-brace extraction, the pure half of the host's extract(): given the
// text and a marker this port matches with contains(), return the span from
// the first '{' to its matching '}' -- or none. The host keeps the regex part.
pub fn extract(src: str, sig: str) -> Option<str> {
    if !src.contains(sig) {
        return none();
    }
    // No byte indexing in the language: the span itself is host work.
    return none();
}

// Stub: the host runs the C binary, extracts the five parts and digests them.
pub fn digest_for(cbin: str, name: str, sig: str, deps: []str, csrc: str) -> Option<str> {
    return none();
}

// Stub: the host walks the corpus and ratchets per-spec agreement rows.
pub fn scan(wd: str) -> []str {
    return []str{};
}

// Stubs: the negative controls plant fixtures on the host.
pub fn self_check() -> i32 {
    return 0;
}

pub fn self_check_drop() -> i32 {
    return 0;
}

// The original's main(): 0 = agreement holds, 2 = could not run. The port has
// no backends to build, so the honest verdict is 2.
pub fn main() -> i32 {
    return 2;
}

test t27c_returns_the_binary_name {
    assert(t27c() == "t27c");
}

test extract_returns_none_on_no_match {
    const r = extract("module M { fn f() {} }", "absent");
    assert(!r.is_some);
}

test extract_sees_a_marker {
    const r = extract("module M { fn f() {} }", "fn f");
    assert(!r.is_some);
}

test main_returns_could_not_run {
    assert(main() == 2);
}
