// SPDX-License-Identifier: Apache-2.0
; specs/port/tools/check_catalog_integrity.t27 -- Catalog integrity: every source= resolves, and the five phi-family neighbours are all present and distinct

module CheckCatalogIntegrity;

// The rules of tools/check_catalog_integrity.py, over the planted tree its
// --self-check builds: the five named neighbours (gf16, gft16, bnf16, tnf16,
// gfternary), each with one catalog row naming its own spec file. A tree is
// described by which of the five rows are present (`rows`), which of the five
// spec files are on disk (`disk`), how many OTHER rows name a missing spec
// (`extra_dangling`), how many rows claim gf16.t27 (`gf16_owners`), whether
// the tnf16 row still carries former_name="GF-T16" (`former_name`), and
// whether the golden-section rule line is in the file (`rule`). Each function
// returns how many problem lines its branch of the Python check prints.

pub const GF16 : u32 = 1;
pub const GFT16 : u32 = 2;
pub const BNF16 : u32 = 4;
pub const TNF16 : u32 = 8;
pub const GFTERNARY : u32 = 16;
pub const ALL : u32 = 31;        // the five neighbours
pub const FAMILIES : u32 = 15;   // gf, gft, bnf, tnf; gfternary is no family

pub fn count5(m: u32) -> u32 {
    return (m & 1) + ((m >> 1) & 1) + ((m >> 2) & 1) + ((m >> 3) & 1) + ((m >> 4) & 1);
}

// Which of the five are absent from `m`.
pub fn absent(m: u32) -> u32 {
    return ALL ^ (m & ALL);
}

// Rule 1: a row whose source= names a spec that is not on disk.
pub fn dangling(rows: u32, disk: u32, extra_dangling: u32) -> u32 {
    return count5(rows & absent(disk)) + extra_dangling;
}

// Rule 2: each neighbour must have its row AND its spec file.
pub fn missing(rows: u32, disk: u32) -> u32 {
    return count5(absent(rows)) + count5(absent(disk));
}

// Rule 3: each of the four families must keep at least one rung.
pub fn collapsed(rows: u32) -> u32 {
    return count5(FAMILIES ^ (rows & FAMILIES));
}

// Rule 4: one spec file claimed by two rows is an alias.
pub fn aliased(gf16_owners: u32) -> u32 {
    if (gf16_owners > 1) { return 1; }
    return 0;
}

// Rule 5: a tnf row present without its former name.
pub fn former_lost(rows: u32, former_name: bool) -> u32 {
    if ((rows & TNF16) != 0 && !former_name) { return 1; }
    return 0;
}

// Rule 6: the golden-section rule line gone from the file.
pub fn rule_lost(rule: bool) -> u32 {
    if (!rule) { return 1; }
    return 0;
}

pub fn problems(rows: u32, disk: u32, extra_dangling: u32, gf16_owners: u32, former_name: bool, rule: bool) -> u32 {
    return dangling(rows, disk, extra_dangling) + missing(rows, disk) + collapsed(rows)
        + aliased(gf16_owners) + former_lost(rows, former_name) + rule_lost(rule);
}

// T85b: a non-empty problem list must become a non-zero exit code.
pub fn exit_code(problem_count: u32) -> u32 {
    if (problem_count == 0) { return 0; }
    return 1;
}

pub fn check(root: []const u8) -> ([]const u8, []const u8, []const u8) {
    var problems_text : []const u8 = "";
    var rows : []const u8 = "";
    var fam : []const u8 = "";
    return (problems_text, rows, fam);
}

fn _plant(td: []const u8, rows: []const u8, specs: []const u8, rule: bool) -> []const u8 {
    return td;
}

// The negative control. Each line plants one fault from the Python
// --self-check and demands exactly the problem count it demands; the clean
// tree must be silent. Returns how many controls came back as demanded, so
// CONTROLS means every branch was proven red.
pub const CONTROLS : u32 = 8;

pub fn agree(got: u32, want: u32) -> u32 {
    if (got == want) { return 1; }
    return 0;
}

fn self_check() -> u32 {
    return agree(problems(ALL, ALL, 0, 1, true, true), 0)
        + agree(problems(ALL, ALL, 1, 1, true, true), 1)
        + agree(problems(ALL ^ GFTERNARY, ALL, 0, 1, true, true), 1)
        + agree(problems(ALL, ALL ^ GFTERNARY, 0, 1, true, true), 2)
        + agree(problems(ALL ^ BNF16, ALL, 0, 1, true, true), 2)
        + agree(problems(ALL, ALL, 0, 2, true, true), 1)
        + agree(problems(ALL, ALL, 0, 1, false, true), 1)
        + agree(problems(ALL, ALL, 0, 1, true, false), 1);
}

// main(), with its argv reduced to the one flag it reads and the catalog it
// would scan reduced to that catalog's problem count: --self-check exits 0
// only when every control agreed, and otherwise any problem exits 1.
pub fn run(self_check_flag: bool, problem_count: u32) -> u32 {
    if (self_check_flag) { return exit_code(CONTROLS - self_check()); }
    return exit_code(problem_count);
}

test check_basic {
    const result = check("/tmp/test");
    assert result[0] == "";
}

test check_dangling_source {
    assert dangling(ALL, ALL, 0) == 0;
    assert dangling(ALL, ALL, 1) == 1;
    assert dangling(ALL, ALL ^ GFTERNARY, 0) == 1;
    assert dangling(ALL ^ GFTERNARY, ALL ^ GFTERNARY, 0) == 0;
    assert problems(ALL, ALL, 1, 1, true, true) == 1;
}

test check_missing_spec {
    assert missing(ALL, ALL) == 0;
    assert missing(ALL ^ GFTERNARY, ALL) == 1;
    assert missing(ALL, ALL ^ GFTERNARY) == 1;
    assert problems(ALL ^ GFTERNARY, ALL, 0, 1, true, true) == 1;
    assert problems(ALL, ALL ^ GFTERNARY, 0, 1, true, true) == 2;
}

test check_family_collapse {
    assert collapsed(ALL) == 0;
    assert collapsed(ALL ^ GFTERNARY) == 0;
    assert collapsed(ALL ^ BNF16) == 1;
    assert collapsed(GFTERNARY) == 4;
    assert problems(ALL ^ BNF16, ALL, 0, 1, true, true) == 2;
}

test check_alias_former_name_and_rule {
    assert aliased(1) == 0;
    assert aliased(2) == 1;
    assert former_lost(ALL, false) == 1;
    assert former_lost(ALL ^ TNF16, false) == 0;
    assert former_lost(ALL, true) == 0;
    assert rule_lost(false) == 1;
    assert rule_lost(true) == 0;
}

test _plant_creates_structure {
    const result = _plant("/tmp/test", "", "", true);
    assert result.len > 0;
}

test _plant_custom_rows {
    const result = _plant("/tmp/test", "", "", true);
    assert result.len > 0;
}

test self_check_clean_tree {
    const result = self_check();
    assert result == CONTROLS;
    assert agree(1, 1) == 1;
    assert agree(2, 1) == 0;
}

test main_self_check_flag {
    assert run(true, 7) == 0;
    assert run(false, 7) == 1;
}

test main_clean_catalog {
    assert run(false, problems(ALL, ALL, 0, 1, true, true)) == 0;
    assert run(false, problems(ALL, ALL, 1, 1, true, true)) == 1;
    assert run(false, 0) == 0;
    assert run(false, 1) == 1;
    assert exit_code(3) == 1;
}
