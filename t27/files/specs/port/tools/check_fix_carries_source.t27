// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/tools/check_fix_carries_source.t27
// Port of tools/check_fix_carries_source.py to t27

// A pull request whose title claims a compiler fix must carry a source file.
//
// #3264 was titled `fix(rust): an untyped local bound to a comparison is not a
// bool (+3)` and merged carrying only its docs/now note. The edit lived in the
// working tree and a `git reset --hard`, taken to get an honest baseline,
// destroyed it before the commit. Every control that pass asked about the
// built binary -- correct, having been built from the working tree. None asked
// about the commit.
//
// WHAT THIS SPEC DELIBERATELY DOES NOT CONTAIN
//
// The scope list and the prose-extension list. They have exactly one
// definition, `cli/tri/src/hooks.rs`, and the Python parses it rather than
// restating it: "two readers with two copies of a list is how a rule drifts
// into two rules." Writing them out here would make a third copy and would be
// the very defect the tool exists to catch. So every predicate below takes the
// ANSWER to a lookup -- "did a prefix match", "is this extension listed" --
// and states what follows from it. The lookup is the runtime's.
//
// What is written down is the part that is a rule rather than a table: the
// verdict lattice, the inversion in `is_prose`, and the refusal to pass when
// the definition cannot be read.

module port::check_fix_carries_source {
    // 0 passed. 1 found the defect. 2 never checked anything -- a missing
    // definition, or a pull_request event with half a context. The third is
    // the one that matters: a guard that cannot find its own rule has not
    // checked, and saying so is the difference between a finding and a pass.
    const EXIT_PASS          : i32 = 0;
    const EXIT_FAIL          : i32 = 1;
    const EXIT_COULD_NOT_RUN : i32 = 2;

    // What was read out of the single definition in cli/tri/src/hooks.rs.
    // Counts, not contents: this spec reasons about whether the rule was
    // found, never about what it says.
    pub struct Definitions {
        rust_file_present: bool,
        scopes: u32,
        prose_prefixes: u32,
        prose_extensions: u32,
    }

    // The event this gate was handed. A pull_request event carries all three;
    // anything else carries none.
    //
    // Named PrEvent rather than Context: `Context` already has two definitions
    // in this corpus (specs/neural/forward_pass.t27 as a type alias, and
    // specs/queen/lotus.t27 as a struct), and a third would be a name whose
    // meaning depends on which file you are reading.
    pub struct PrEvent {
        has_title: bool,
        has_base: bool,
        has_head: bool,
    }

    // ------------------------------------------------------------------
    // The definition must be readable, or nothing was checked
    // ------------------------------------------------------------------

    // Every list must be found AND be non-empty. An empty rule is worse than
    // a missing one: it parses, it runs, and it judges every pull request
    // wrongly while reporting success.
    pub fn definitions_usable(d: Definitions) bool {
        if (!d.rust_file_present) {
            return false;
        }
        return d.scopes > 0 && d.prose_prefixes > 0 && d.prose_extensions > 0;
    }

    // ------------------------------------------------------------------
    // Does a subject claim the compiler?
    // ------------------------------------------------------------------

    // `fix(rust): ...` claims it; `fix(seals): ...` does not; `fix: ...` with
    // no parenthesis at all claims nothing, and neither does an unterminated
    // `fix(rust` -- an unparseable scope is not a scope.
    //
    // `listed_scopes` is how many of the comma-separated names inside the
    // parentheses appear in the definition's list, so `fix(rust, seals)`
    // claims on the strength of `rust` alone.
    pub fn claims_source(starts_with_fix: bool, has_closing_paren: bool, listed_scopes: u32) bool {
        if (!starts_with_fix) {
            return false;
        }
        if (!has_closing_paren) {
            return false;
        }
        return listed_scopes > 0;
    }

    // ------------------------------------------------------------------
    // Is a changed path prose, or is it substance?
    // ------------------------------------------------------------------

    // Prose or a record. Everything else is substance.
    //
    // Inverted from an extension whitelist after an adversarial pass named
    // four categories that exist here and would each have been a false
    // accusation: .xdc/.tcl constraint and synthesis files, which are the
    // deliverable of timing work under fix(verilog); .toml manifests; .lean
    // formalisations of the compiler's own lowering; and every extensionless
    // path -- Makefile, Dockerfile, scripts/tri -- which no extension entry
    // can ever match.
    //
    // A whitelist of code cannot be completed and each omission accuses
    // someone. Prose and records are a small closed set, so the rule names
    // those and treats the remainder as substance.
    pub fn is_prose(matched_prose_prefix: bool, has_extension: bool, extension_is_prose: bool) bool {
        if (matched_prose_prefix) {
            return true;
        }
        // The `has_extension` conjunct is load-bearing rather than defensive:
        // without it an extensionless path falls through to an extension
        // comparison it can never satisfy, and the four categories above come
        // back as false accusations.
        return has_extension && extension_is_prose;
    }

    // A path is substance exactly when it is not prose. Named, because the
    // verdict below turns on the count of these and the inversion is where
    // the reasoning is easy to get backwards.
    pub fn is_substance(matched_prose_prefix: bool, has_extension: bool, extension_is_prose: bool) bool {
        return !is_prose(matched_prose_prefix, has_extension, extension_is_prose);
    }

    // ------------------------------------------------------------------
    // The verdict
    // ------------------------------------------------------------------

    // Not a pull_request event: no title and no range. Inventing one would
    // check a different thing than the one this gate is about, so it passes.
    pub fn not_a_pull_request(c: PrEvent) bool {
        return !c.has_title && !c.has_base && !c.has_head;
    }

    // Half a context is not a context. Some of the three present and some
    // absent means the event was a pull_request and the harness lost part of
    // it -- which is could-not-run, never a pass.
    pub fn pr_event_incomplete(c: PrEvent) bool {
        if (not_a_pull_request(c)) {
            return false;
        }
        return !c.has_title || !c.has_base || !c.has_head;
    }

    // The whole gate.
    //
    // `claiming` counts the subjects -- the title and every non-merge commit
    // subject in the range -- that claim a compiler scope. `changed` and
    // `substance` count the paths in the diff.
    pub fn verdict(d: Definitions, c: PrEvent, claiming: u32, changed: u32, substance: u32) i32 {
        // Before anything else. A gate that cannot read its own rule reports
        // that it did not run, and does not reach the question it was asked.
        if (!definitions_usable(d)) {
            return EXIT_COULD_NOT_RUN;
        }
        if (not_a_pull_request(c)) {
            return EXIT_PASS;
        }
        if (pr_event_incomplete(c)) {
            return EXIT_COULD_NOT_RUN;
        }
        // Nothing claimed the compiler, so there is nothing to require.
        if (claiming == 0) {
            return EXIT_PASS;
        }
        // An empty diff cannot land, so it cannot land a claim either.
        if (changed == 0) {
            return EXIT_PASS;
        }
        // The claim is backed by at least one file that is not prose.
        if (substance > 0) {
            return EXIT_PASS;
        }
        // Claimed, and the whole diff is prose. This is #3264.
        return EXIT_FAIL;
    }

    // ------------------------------------------------------------------
    // The runtime's side: reading the definition, walking the range
    // ------------------------------------------------------------------

    pub fn read_definitions(rust_path: str) Definitions {
        undefined;
    }

    pub fn commit_subject_count(base: str, head: str) u32 {
        undefined;
    }

    pub fn changed_file_count(base: str, head: str) u32 {
        undefined;
    }

    // ==================================================================
    // Tests
    // ==================================================================

    test "a gate that cannot read its own rule did not run, and did not pass"
        const whole = Definitions { rust_file_present: true, scopes: 4, prose_prefixes: 3, prose_extensions: 5 };
        assert(definitions_usable(whole));

        // The file is gone.
        assert(!definitions_usable(Definitions { rust_file_present: false, scopes: 4, prose_prefixes: 3, prose_extensions: 5 }));
        // Each list, empty on its own. An empty rule parses and judges every
        // pull request wrongly, so it is refused exactly as hard as a missing
        // one.
        assert(!definitions_usable(Definitions { rust_file_present: true, scopes: 0, prose_prefixes: 3, prose_extensions: 5 }));
        assert(!definitions_usable(Definitions { rust_file_present: true, scopes: 4, prose_prefixes: 0, prose_extensions: 5 }));
        assert(!definitions_usable(Definitions { rust_file_present: true, scopes: 4, prose_prefixes: 3, prose_extensions: 0 }));

        // And an unusable definition outranks every other question: a clean
        // pull request with a perfect diff still reports could-not-run.
        const pr = PrEvent { has_title: true, has_base: true, has_head: true };
        const broken = Definitions { rust_file_present: false, scopes: 0, prose_prefixes: 0, prose_extensions: 0 };
        assert(verdict(broken, pr, 0, 9, 9) == EXIT_COULD_NOT_RUN);

    test "a subject claims the compiler only with a parsed, listed scope"
        // fix(rust): the scope is in the list.
        assert(claims_source(true, true, 1));
        // fix(rust, seals): one listed name is enough.
        assert(claims_source(true, true, 2));
        // fix(seals): parsed, and not one of the compiler's scopes.
        assert(!claims_source(true, true, 0));
        // feat(rust): not a fix at all.
        assert(!claims_source(false, true, 1));
        // fix(rust -- unterminated. An unparseable scope is not a scope, and
        // guessing at it would accuse on the strength of a typo.
        assert(!claims_source(true, false, 1));
        assert(!claims_source(false, false, 0));

    test "prose is a closed set and everything else is substance"
        // docs/now/....md -- under a prose prefix.
        assert(is_prose(true, true, true));
        // A prefix match settles it whatever the extension says.
        assert(is_prose(true, true, false));
        assert(is_prose(true, false, false));
        // foo.md elsewhere in the tree -- a listed extension.
        assert(is_prose(false, true, true));
        // bootstrap/src/lower.rs -- an extension, and not a prose one.
        assert(!is_prose(false, true, false));

    test "an extensionless path is never prose"
        // Makefile, Dockerfile, scripts/tri. No extension entry can match
        // them, so without the has_extension conjunct they would fall through
        // to a comparison they cannot satisfy and be accused wrongly.
        assert(!is_prose(false, false, false));
        // Even told the extension is listed, which cannot happen for a path
        // that has none: the guard holds rather than trusting the caller.
        assert(!is_prose(false, false, true));
        // And the same four categories, as substance.
        assert(is_substance(false, false, false));
        assert(is_substance(false, true, false));
        assert(!is_substance(true, true, true));

    test "a non-event passes and half an event does not"
        const nothing = PrEvent { has_title: false, has_base: false, has_head: false };
        const whole   = PrEvent { has_title: true,  has_base: true,  has_head: true };
        assert(not_a_pull_request(nothing));
        assert(!not_a_pull_request(whole));
        assert(!pr_event_incomplete(nothing));
        assert(!pr_event_incomplete(whole));

        // Every way of losing part of it.
        assert(pr_event_incomplete(PrEvent { has_title: true,  has_base: false, has_head: false }));
        assert(pr_event_incomplete(PrEvent { has_title: false, has_base: true,  has_head: false }));
        assert(pr_event_incomplete(PrEvent { has_title: false, has_base: false, has_head: true }));
        assert(pr_event_incomplete(PrEvent { has_title: true,  has_base: true,  has_head: false }));
        assert(pr_event_incomplete(PrEvent { has_title: false, has_base: true,  has_head: true }));
        assert(pr_event_incomplete(PrEvent { has_title: true,  has_base: false, has_head: true }));

        const d = Definitions { rust_file_present: true, scopes: 4, prose_prefixes: 3, prose_extensions: 5 };
        // Not a pull_request at all: nothing to check, and that is a pass.
        assert(verdict(d, nothing, 0, 0, 0) == EXIT_PASS);
        // A pull_request with a lost range: nothing WAS checked, and that is not.
        assert(verdict(d, PrEvent { has_title: true, has_base: false, has_head: false }, 0, 0, 0) == EXIT_COULD_NOT_RUN);

    test "a claimed compiler fix over a prose-only diff is the defect"
        const d  = Definitions { rust_file_present: true, scopes: 4, prose_prefixes: 3, prose_extensions: 5 };
        const pr = PrEvent { has_title: true, has_base: true, has_head: true };

        // #3264: one claiming subject, one changed path, and it is a docs/now
        // note. The entire diff was that note.
        assert(verdict(d, pr, 1, 1, 0) == EXIT_FAIL);
        // Many prose paths are still no paths.
        assert(verdict(d, pr, 1, 14, 0) == EXIT_FAIL);
        // One file of substance is enough to back the claim.
        assert(verdict(d, pr, 1, 14, 1) == EXIT_PASS);
        // Nothing claimed the compiler, so a prose-only diff is ordinary.
        assert(verdict(d, pr, 0, 14, 0) == EXIT_PASS);
        // An empty diff cannot land, so it cannot land a claim.
        assert(verdict(d, pr, 1, 0, 0) == EXIT_PASS);
        // The claim may come from a commit subject rather than the title;
        // the count does not care which said it.
        assert(verdict(d, pr, 3, 2, 0) == EXIT_FAIL);
}
