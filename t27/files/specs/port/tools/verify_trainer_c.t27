// ------------------------------------------------------------
// 1. _run_bin(cmd, what, cwd=None)
// ------------------------------------------------------------
pub fn _run_bin(cmd: [str], what: str, cwd: str = "") ?str {
    var result = run_subprocess(cmd, cwd, 30000);
    if (result == null) {
        return null;
    }
    
    var (exit_code, stdout, stderr) = result.unwrap();
    if (exit_code == 0) {
        return Some(stdout);
    }
    
    var sig = "";
    if (exit_code < 0) {
        sig = " (signal " + (-exit_code).str() + ")";
    }
    
    print("  " + what + ": exited " + exit_code.str() + sig);
    var stderr_lines = stderr.split("\n");
    var i: i32 = 0;
    while (i < @len(stderr_lines) && i < 4) {
        if (@len(stderr_lines[i]) > 0) {
            print("      " + stderr_lines[i]);
        }
        i = i + 1;
    }
    
    return null;
}

test "_run_bin_returns_stdout_on_success" {
    var cmd = ["echo", "hello"];
    var result = _run_bin(cmd, "test", "");
    assert(result == Some("hello\n") or result == null);
}

test "_run_bin_returns_none_on_failure" {
    var cmd = ["false"];
    var result = _run_bin(cmd, "test", "");
    assert(result == null);
}

test "_run_bin_handles_signal" {
    var cmd = ["sh", "-c", "kill -9 $"];
    var result = _run_bin(cmd, "test", "");
    assert(result == null);
}

// ------------------------------------------------------------
// 2. _gen(t27c, mode, spec, root)
// ------------------------------------------------------------
pub fn _gen(t27c: str, mode: str, spec: str, root: str) ?str {
    var cmd = [t27c, "gen-" + mode, spec];
    var result = run_subprocess(cmd, root, 30000);
    if (result == null) {
        return null;
    }
    
    var (exit_code, stdout, stderr) = result.unwrap();
    if (exit_code == 0) {
        return Some(stdout);
    }
    
    var out = (stderr + stdout).split("\n");
    print("  t27c gen-" + mode + " " + spec + ": exited " + exit_code.str() + 
          (if (@len(out) == 0 or (@len(out[0]) == 0 and @len(out) == 1)) " with no message" else ""));
    
    var i: i32 = 0;
    while (i < @len(out) && i < 4) {
        if (@len(out[i]) > 0) {
            print("      " + out[i]);
        }
        i = i + 1;
    }
    
    return null;
}

test "_gen_returns_stdout_on_success" {
    var result = _gen("t27c", "c", "test.t27", "/tmp");
    assert(result == Some("") or result == null);
}

test "_gen_returns_none_on_failure" {
    var result = _gen("t27c", "invalid", "test.t27", "/tmp");
    assert(result == null);
}

// ------------------------------------------------------------
// 3. _build(cmd, cwd, what)
// ------------------------------------------------------------
pub fn _build(cmd: [str], cwd: str, what: str) bool {
    var result = run_subprocess(cmd, cwd, 60000);
    if (result == null) {
        return false;
    }
    
    var (exit_code, stdout, stderr) = result.unwrap();
    if (exit_code == 0) {
        return true;
    }
    
    var out = (stderr + stdout).split("\n");
    var basename = if (@len(cmd) > 0) cmd[0] else "unknown";
    print("  " + what + ": " + basename + " exited " + exit_code.str() + 
          (if (@len(out) == 0 or (@len(out[0]) == 0 and @len(out) == 1)) " with no message" else ""));
    
    var i: i32 = 0;
    while (i < @len(out) && i < 6) {
        if (@len(out[i]) > 0) {
            print("      " + out[i]);
        }
        i = i + 1;
    }
    
    if (@len(out) > 6) {
        print("      ... " + (@len(out) - 6).str() + " more line(s)");
    }
    
    return false;
}

test "_build_returns_true_on_success" {
    var cmd = ["echo", "test"];
    var result = _build(cmd, "/tmp", "test");
    assert(result == true or result == false);
}

test "_build_returns_false_on_failure" {
    var cmd = ["false"];
    var result = _build(cmd, "/tmp", "test");
    assert(result == false);
}

// ------------------------------------------------------------
// 4. find_t27c()
// ------------------------------------------------------------
pub fn find_t27c() ?str {
    var paths = ["target/debug/t27c", "target/release/t27c"];
    var root = "/workspace/t27/.worktrees/queen-4803";
    
    var i: i32 = 0;
    while (i < @len(paths)) {
        var path = root + "/" + paths[i];
        if (file_exists(path)) {
            return Some(path);
        }
        i = i + 1;
    }
    
    return which("t27c");
}

test "find_t27c_checks_debug_path" {
    var result = find_t27c();
    assert(result == Some("/workspace/t27/.worktrees/queen-4803/target/debug/t27c") or 
           result == Some("/workspace/t27/.worktrees/queen-4803/target/release/t27c") or 
           result == null);
}

test "find_t27c_falls_back_to_path" {
    var result = find_t27c();
    assert(result == null or @len(result.unwrap()) > 0);
}

