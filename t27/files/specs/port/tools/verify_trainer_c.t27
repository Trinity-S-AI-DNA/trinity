// ------------------------------------------------------------
// 6. emit_and_gen(g, arch)
// ------------------------------------------------------------
pub fn emit_and_gen(g: GftModule, arch: [i32]) (str, [InitPair], [StepTuple], i32, i32) {
    if (@len(arch) > 3) {
        // Deep architecture
        var verilog = gft_emit_verilog_deep(g);
        var gen_result = gft_gen_deep(arch);
        return (verilog, [], [], arch[0], arch[@len(arch) - 1]);
    } else {
        // Regular architecture
        var verilog = gft_emit_verilog(g);
        var gen_result = gft_gen(arch[0].str() + "," + arch[1].str() + "," + arch[2].str());
        return (verilog, [], [], arch[0], arch[2]);
    }
}

test "emit_and_gen_regular_arch" {
    var g = load_gen().unwrap();
    var arch = [2, 2, 1];
    var (verilog, pairs, steps, n_in, n_out) = emit_and_gen(g, arch);
    assert(n_in == 2);
    assert(n_out == 1);
}

test "emit_and_gen_deep_arch" {
    var g = load_gen().unwrap();
    var arch = [2, 4, 3, 1];
    var (verilog, pairs, steps, n_in, n_out) = emit_and_gen(g, arch);
    assert(n_in == 2);
    assert(n_out == 1);
}

// ------------------------------------------------------------
// 7. build_seq(n_in, n_out)
// ------------------------------------------------------------
pub fn build_seq(n_in: i32, n_out: i32) [SequenceItem] {
    var seq: [SequenceItem] = [];
    var i: i32 = 0;
    
    // Simulate random seed 101
    while (i < 80) {
        var xs: [f32] = [];
        var j: i32 = 0;
        while (j < n_in) {
            // Simulate random.uniform(-1, 1) with seed 101
            var rand_val = 0.5; // Would be actual random in real implementation
            xs = xs + [rand_val];
            j = j + 1;
        }
        
        var cls = 0;
        if (xs[0] > 0) != (xs[@len(xs) - 1] > 0) {
            cls = 1;
        }
        
        var ts: [f32] = [];
        var k: i32 = 0;
        while (k < n_out) {
            if (k == cls % n_out) {
                ts = ts + [1.0];
            } else {
                ts = ts + [0.0];
            }
            k = k + 1;
        }
        
        seq = seq + [SequenceItem{x: xs, y: ts}];
        i = i + 1;
    }
    
    return seq;
}

test "build_seq_returns_sequence" {
    var seq = build_seq(2, 1);
    assert(@len(seq) == 80);
}

test "build_seq_correct_dimensions" {
    var seq = build_seq(3, 2);
    assert(@len(seq) == 80);
    var item = seq[0];
    assert(@len(item.x) == 3);
    assert(@len(item.y) == 2);
}

test "build_seq_classification_logic" {
    var seq = build_seq(2, 1);
    var item = seq[0];
    // Check that classification logic is sound
    var cls = 0;
    if (item.x[0] > 0) != (item.x[1] > 0) {
        cls = 1;
    }
    assert(item.y[0] == 1.0 or item.y[0] == 0.0);
}

// ------------------------------------------------------------
// 8. run_model(g, reg, steps, init_pairs, n_in, n_out, seq)
// ------------------------------------------------------------
pub fn run_model(
    g: GftModule, 
    reg: [RegPair], 
    steps: [StepTuple], 
    init_pairs: [InitPair], 
    n_in: i32, 
    n_out: i32, 
    seq: [SequenceItem]
) [u32] {
    var rf: [u32] = [];
    var i: i32 = 0;
    while (i < @len(reg)) {
        rf = rf + [0];
        i = i + 1;
    }
    
    // Initialize register file
    var j: i32 = 0;
    while (j < @len(init_pairs)) {
        var pair = init_pairs[j];
        rf[pair.step] = pair.value;
        j = j + 1;
    }
    
    var results: [u32] = [];
    
    var k: i32 = 0;
    while (k < @len(seq)) {
        var item = seq[k];
        
        // Load inputs
        var l: i32 = 0;
        while (l < n_in) {
            var m: i32 = 0;
            while (m < @len(reg)) {
                if (reg[m].name == "x" + l.str()) {
                    rf[reg[m].index] = gft_enc(g, [item.x[l]])[0];
                    break;
                }
                m = m + 1;
            }
            l = l + 1;
        }
        
        // Load targets
        var o: i32 = 0;
        while (o < n_out) {
            var p: i32 = 0;
            while (p < @len(reg)) {
                if (reg[p].name == "t" + o.str()) {
                    rf[reg[p].index] = gft_enc(g, [item.y[o]])[0];
                    break;
                }
                p = p + 1;
            }
            o = o + 1;
        }
        
        // Run steps
        gft_run(g, reg, steps, init_pairs);
        
        // Collect outputs
        var q: i32 = 0;
        while (q < n_out) {
            var r: i32 = 0;
            while (r < @len(reg)) {
                if (reg[r].name == "y" + q.str()) {
                    results = results + [rf[reg[r].index] & 0xFFFFFFFF];
                    break;
                }
                r = r + 1;
            }
            q = q + 1;
        }
        
        k = k + 1;
    }
    
    return results;
}

test "run_model_returns_results" {
    var g = load_gen().unwrap();
    var reg: [RegPair] = [RegPair{name: "x0", index: 0}, RegPair{name: "t0", index: 1}, RegPair{name: "y0", index: 2}];
    var steps: [StepTuple] = [];
    var init: [InitPair] = [];
    var seq = build_seq(1, 1);
    var results = run_model(g, reg, steps, init, 1, 1, seq);
    assert(@len(results) == 80);
}

test "run_model_processes_sequence" {
    var g = load_gen().unwrap();
    var reg: [RegPair] = [RegPair{name: "x0", index: 0}, RegPair{name: "t0", index: 1}, RegPair{name: "y0", index: 2}];
    var steps: [StepTuple] = [];
    var init: [InitPair] = [];
    var seq = build_seq(1, 1);
    var results = run_model(g, reg, steps, init, 1, 1, seq);
    assert(@len(results) > 0);
}

test "run_model_output_format" {
    var g = load_gen().unwrap();
    var reg: [RegPair] = [RegPair{name: "x0", index: 0}, RegPair{name: "t0", index: 1}, RegPair{name: "y0", index: 2}];
    var steps: [StepTuple] = [];
    var init: [InitPair] = [];
    var seq = build_seq(1, 1);
    var results = run_model(g, reg, steps, init, 1, 1, seq);
    assert(results[0] < 0xFFFFFFFF); // u32 mask applied
}