// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-regress/regress-fabric-bufg/fabric_bufg.t27
// Global Buffer (BUFG) regression test for Xilinx Artix-7
// Ported from gHashTag/trinity fpga/openxc7-regress/regress-fabric-bufg/fabric_bufg.v
// phi^2 + 1/phi^2 = 3 | TRINITY

module top {

    // === IBUFDS differential clock buffer ===
    
    fn ibufds_diff_to_single(clk_p: bool, clk_n: bool) -> bool {
        // Convert differential clock to single-ended
        return clk_p and (clk_n == false);
    }
    
    // === Clock divider (fabric-driven BUFG) ===
    
    fn divide_clock(sys_clk: bool, div: bool) -> bool {
        // Toggle div on each positive edge of sys_clk
        if (sys_clk) {
            return !div;
        }
        return div;
    }
    
    // === 24-bit counter ===
    
    fn increment_counter(counter: u32) -> u32 {
        // Increment 24-bit counter with wrapping
        if (counter == 0xFFFFFF) {
            return 0;  // Wrap around
        }
        return counter + 1;
    }
    
    // === Test helpers ===
    
    fn led_state(counter: u32) -> bool {
        return (counter & 0x800000) != 0;  // Check bit 23 (MSB of 24-bit counter)
    }
    
    // === Tests ===
    
    test ibufds_differential {
        assert(ibufds_diff_to_single(true, false) == true);
    }
    
    test ibufds_no_clock {
        assert(ibufds_diff_to_single(false, false) == false);
    }
    
    test ibufds_reverse_polarity {
        assert(ibufds_diff_to_single(false, true) == false);
    }
    
    test clock_divider_toggle {
        assert(divide_clock(true, false) == true);
        assert(divide_clock(true, true) == false);
        assert(divide_clock(false, false) == false);
        assert(divide_clock(false, true) == true);
    }
    
    test counter_increment_zero_to_one {
        assert(increment_counter(0) == 1);
    }
    
    test counter_increment_one_to_two {
        assert(increment_counter(1) == 2);
    }
    
    test counter_increment_max_value {
        assert(increment_counter(0xFFFFFF) == 0);  // Wraps to 0
    }
    
    test led_output_msb_set {
        assert(led_state(0x800000) == true);
    }
    
    test led_output_msb_clear {
        assert(led_state(0x7FFFFF) == false);
    }
    
    test led_output_lower_bits_set {
        assert(led_state(3) == false);  // Only bits 0 and 1 set
    }
    
    test led_output_bit23_set {
        assert(led_state(0x800000) == true);  // Bit 23 set (MSB of 24-bit counter)
    }
    
    test led_output_bit22_clear {
        assert(led_state(0x400000) == false);  // Bit 22 set, but we check bit 23
    }
}