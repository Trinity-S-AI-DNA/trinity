// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/d_y0_test.t27
// Trinity Y0 Test Module - Counter with Buffered Clock
// Ports the original Verilog module to T27 specification
// 24-bit counter with BUFG clock buffer, MSB output to LED
// Uses flat arrays + count fields (parser-compatible)
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Module interface ===
    
    pub struct TrinityInterface {
        clk : bool,
        led : bool,
    }
    
    // === Clock buffer configuration ===
    
    pub struct ClockBufferConfig {
        name : &str,
        input_delay_ps : u32,
        output_delay_ps : u32,
        fanout_capacity : u32,
    }
    
    fn bufg_config(name: &str) -> ClockBufferConfig {
        return ClockBufferConfig{
            .name = name,
            .input_delay_ps = 0,
            .output_delay_ps = 100,  // BUFG typical delay
            .fanout_capacity = 32,
        };
    }
    
    // === Counter configuration ===
    
    pub struct CounterConfig {
        width : u32,
        initial_value : u32,
        max_value : u32,
    }
    
    fn counter_24bit() -> CounterConfig {
        return CounterConfig{
            .width = 24,
            .initial_value = 0,
            .max_value = 16777215,  // 2^24 - 1
        };
    }
    
    // === Clock buffering ===
    
    fn buffer_clock(input_clk: bool, cfg: ClockBufferConfig) -> bool {
        // Model BUFG behavior: passes through clock with minimal delay
        // In real Verilog: BUFG clk_buf (.I(clk), .O(clk_bufged));
        return input_clk;
    }
    
    // === Counter logic ===
    
    fn next_counter_value(current: u32, cfg: CounterConfig) -> u32 {
        var next : u32 = current + 1;
        if (next > cfg.max_value) {
            return cfg.initial_value;  // Wrap around
        }
        return next;
    }
    
    fn counter_msb(counter: u32, cfg: CounterConfig) -> bool {
        // Return the most significant bit (bit 23 for 24-bit counter)
        var bit23 : u32 = 1 << 23;  // 2^23 = 8388608
        return (counter & bit23) != 0;
    }
    
    fn compute_counter_state(input_clk: bool, counter: u32, cfg: CounterConfig) -> TrinityInterface {
        var buffered_clk : bool = buffer_clock(input_clk, bufg_config("clk_buf"));
        var msb : bool = counter_msb(counter, cfg);
        
        return TrinityInterface{
            .clk = buffered_clk,
            .led = msb,
        };
    }
    
    fn simulate_clock_tick(current_clk: bool, current_counter: u32, cfg: CounterConfig) -> (bool, u32) {
        var next_clk : bool = buffer_clock(current_clk, bufg_config("clk_buf"));
        var next_counter : u32 = next_counter_value(current_counter, cfg);
        
        return (next_clk, next_counter);
    }
    
    // === Test helpers ===
    
    fn get_counter_bit(counter: u32, bit_pos: u32) -> bool {
        var mask : u32 = 1 << bit_pos;
        return (counter & mask) != 0;
    }
    
    fn is_counter_power_of_two(counter: u32, cfg: CounterConfig) -> bool {
        // Check if counter value is a power of two (only MSB set)
        if (counter == 0) {
            return false;  // 0 is not a power of two
        }
        return (counter & (counter - 1)) == 0;
    }
    
    // === Validation ===
    
    fn validate_clock_buffer(cfg: ClockBufferConfig) -> u32 {
        var errors : u32 = 0;
        if (cfg.name == "") {
            errors = errors + 1;
        }
        if (cfg.output_delay_ps == 0) {
            errors = errors + 1;
        }
        if (cfg.fanout_capacity == 0) {
            errors = errors + 1;
        }
        return errors;
    }
    
    fn validate_counter_config(cfg: CounterConfig) -> u32 {
        var errors : u32 = 0;
        if (cfg.width == 0) {
            errors = errors + 1;
        }
        if (cfg.width > 64) {  // Reasonable upper limit
            errors = errors + 1;
        }
        if (cfg.initial_value > cfg.max_value) {
            errors = errors + 1;
        }
        return errors;
    }
    
    // === Tests ===
    
    test clock_buffer_config_creation
        given cfg = bufg_config("clk_buf")
        then cfg.name == "clk_buf"
        and cfg.input_delay_ps == 0
        and cfg.output_delay_ps == 100
        and cfg.fanout_capacity == 32
    
    test counter_config_creation
        given cfg = counter_24bit()
        then cfg.width == 24
        and cfg.initial_value == 0
        and cfg.max_value == 16777215
    
    test buffer_clock_passthrough
        given cfg = bufg_config("test_buf")
        then buffer_clock(true, cfg) == true
        and buffer_clock(false, cfg) == false
    
    test next_counter_value_increment
        given cfg = counter_24bit()
        then next_counter_value(0, cfg) == 1
        and next_counter_value(1, cfg) == 2
        and next_counter_value(16777214, cfg) == 16777215
    
    test next_counter_value_wrap_around
        given cfg = counter_24bit()
        then next_counter_value(16777215, cfg) == 0  // Max value wraps to 0
    
    test counter_msb_bit23
        given cfg = counter_24bit()
        then counter_msb(0, cfg) == false      // 0...00000000
        and counter_msb(8388607, cfg) == false  // 0...01111111 (bit 23 = 0)
        and counter_msb(8388608, cfg) == true   // 0...10000000 (bit 23 = 1)
        and counter_msb(16777215, cfg) == true  // 1...11111111 (bit 23 = 1)
    
    test compute_counter_state_initial
        given cfg = counter_24bit()
        and state = compute_counter_state(true, 0, cfg)
        then state.clk == true  // Buffered clock
        and state.led == false  // MSB of 0 is false
    
    test compute_counter_state_mid_count
        given cfg = counter_24bit()
        and state = compute_counter_state(true, 8388608, cfg)  // 2^23
        then state.clk == true
        and state.led == true  // MSB of 8388608 is true
    
    test simulate_clock_tick_increment
        given cfg = counter_24bit()
        and (next_clk, next_counter) = simulate_clock_tick(true, 5, cfg)
        then next_clk == true
        and next_counter == 6
    
    test simulate_clock_tick_max_value
        given cfg = counter_24bit()
        and (next_clk, next_counter) = simulate_clock_tick(true, 16777215, cfg)
        then next_clk == true
        and next_counter == 0  // Wraps around
    
    test get_counter_bit_function
        then get_counter_bit(5, 0) == true   // Bit 0 of 5 (101) is 1
        and get_counter_bit(5, 1) == false  // Bit 1 of 5 (101) is 0
        and get_counter_bit(5, 2) == true   // Bit 2 of 5 (101) is 1
    
    test is_counter_power_of_two
        given cfg = counter_24bit()
        then is_counter_power_of_two(0, cfg) == false
        and is_counter_power_of_two(1, cfg) == true   // 2^0
        and is_counter_power_of_two(2, cfg) == true   // 2^1
        and is_counter_power_of_two(4, cfg) == true   // 2^2
        and is_counter_power_of_two(3, cfg) == false  // Not power of two
        and is_counter_power_of_two(8388608, cfg) == true  // 2^23
    
    test validate_clock_buffer_ok
        given cfg = bufg_config("valid_buf")
        then validate_clock_buffer(cfg) == 0
    
    test validate_clock_buffer_empty_name
        given cfg = ClockBufferConfig{.name = "", .input_delay_ps = 0, .output_delay_ps = 100, .fanout_capacity = 32}
        then validate_clock_buffer(cfg) > 0
    
    test validate_counter_config_ok
        given cfg = counter_24bit()
        then validate_counter_config(cfg) == 0
    
    test validate_counter_config_zero_width
        given cfg = CounterConfig{.width = 0, .initial_value = 0, .max_value = 15}
        then validate_counter_config(cfg) > 0
    
    test validate_counter_config_initial_too_large
        given cfg = CounterConfig{.width = 4, .initial_value = 20, .max_value = 15}
        then validate_counter_config(cfg) > 0
    
    // === Invariants ===
    
    invariant clock_buffer_name_non_empty
        given cfg = bufg_config("inv")
        assert cfg.name != ""
    
    invariant counter_width_positive
        given cfg = counter_24bit()
        assert cfg.width > 0
    
    invariant msb_is_boolean
        given cfg = counter_24bit()
        assert counter_msb(0, cfg) == true or counter_msb(0, cfg) == false
    
    invariant led_state_matches_msb
        given cfg = counter_24bit()
        and state = compute_counter_state(true, 8388608, cfg)
        assert state.led == counter_msb(8388608, cfg)
    
    invariant counter_value_in_range
        given cfg = counter_24bit()
        and (next_clk, next_counter) = simulate_clock_tick(true, 16777215, cfg)
        assert next_counter <= cfg.max_value
    
    // === Benchmarks ===
    
    bench buffer_clock_latency
        measure: nanoseconds to buffer_clock(true, bufg_config("bench"))
        target: < 10ns
    
    bench next_counter_value_latency
        measure: nanoseconds to next_counter_value(1000, counter_24bit())
        target: < 10ns
    
    bench counter_msb_latency
        measure: nanoseconds to counter_msb(8388608, counter_24bit())
        target: < 10ns
    
    bench compute_counter_state_latency
        measure: nanoseconds to compute_counter_state(true, 5000, counter_24bit())
        target: < 20ns
    
    bench simulate_clock_tick_latency
        measure: nanoseconds to simulate_clock_tick(true, 10000, counter_24bit())
        target: < 20ns

}

// phi^2 + 1/phi^2 = 3 | TRINITY