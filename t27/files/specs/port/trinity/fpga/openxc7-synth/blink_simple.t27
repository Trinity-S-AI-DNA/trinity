// SPDX-License-Identifier: Apache-2.0
//
// blink_simple.t27 - port of gHashTag/trinity fpga/openxc7-synth/blink_simple.v
// (Verilog, commit fc914dbaa7ab, 29 lines, one module).
//
// The original is a 50 MHz LED blinker: a 26-bit counter increments on every
// posedge of clk; when the counter still reads 26'h0 before an edge it wraps
// and led_state toggles; the led output is the active-low inversion of
// led_state. First toggle one posedge after reset, then one every 2^26
// cycles, for a full blink period of 2^27 cycles (~2.7 s at 50 MHz).
//
// Mapping from the original Verilog:
//
//   reg [25:0] counter = 26'h0;   ->  COUNTER_WIDTH, COUNTER_RESET,
//                                     COUNTER_MAX, SimpleBlinkState.counter
//   reg led_state = 1'b0;         ->  SimpleBlinkState.led_state
//   always @(posedge clk) ...     ->  init_state, next_counter,
//                                     at_toggle_point, toggle_led, blink_step
//   assign led = ~led_state;      ->  led_output (LED_ACTIVE_LOW)
//
// Porting notes:
// - The original's clk and led ports are synthesis plumbing; this spec keeps
//   the pure decisions the original makes, in the shape the Verilog backend
//   lowers (see specs/fpga/cts.t27 and specs/fpga/apb_bridge.t27): plain
//   functions, no on_comb / on_clock.
// - The 26-bit wrap is expressed as a comparison against COUNTER_MAX rather
//   than an overflow add, because the counter is u32 in .t27.
// - Struct returns lower to packed vectors (SimpleBlinkState is 33 bits), so
//   blink_step and led_output generate working RTL, not placeholders.
// - Tests are simulation constructs carried by `gen-verilog-for-simulation`
//   and executed by `t27c test-report`.

module trinity_top {

    // ---------------------------------------------------------------
    // Constants (from the original's literals and header comment)
    // ---------------------------------------------------------------

    pub const COUNTER_WIDTH : u32 = 26;      // reg [25:0] counter
    pub const COUNTER_RESET : u32 = 0;       // 26'h0 -- power-on value; the toggle compares against it
    pub const COUNTER_MAX : u32 = 0x3FFFFFF; // 2^26 - 1 -- where the 26-bit reg wraps
    pub const LED_ACTIVE_LOW : bool = true;  // assign led = ~led_state

    // ---------------------------------------------------------------
    // Structs
    // ---------------------------------------------------------------

    // Not named BlinkState: blink_correct and d6_blink use that name for
    // {counter, led}, and this top keeps the Verilog's led_state (tri types
    // ratchet, #7437).
    pub struct SimpleBlinkState {
        counter : u32,
        led_state : bool,
    }

    // ---------------------------------------------------------------
    // Functions
    // ---------------------------------------------------------------

    // Power-on state: counter = 26'h0, led_state = 1'b0 (LED ON, active-low)
    fn init_state() -> SimpleBlinkState {
        return SimpleBlinkState{ .counter = COUNTER_RESET, .led_state = false };
    }

    // counter <= counter + 1'b1 -- a 26-bit reg wraps at 2^26 - 1
    fn next_counter(counter: u32) -> u32 {
        if (counter == COUNTER_MAX) {
            return COUNTER_RESET;
        }
        return counter + 1;
    }

    // The always block toggles on a posedge whose pre-edge counter reads 26'h0
    fn at_toggle_point(counter: u32) -> bool {
        return counter == COUNTER_RESET;
    }

    // led_state <= ~led_state -- toggle at overflow
    fn toggle_led(led_state: bool) -> bool {
        return !led_state;
    }

    // One posedge of clk: the counter increments; led_state toggles iff the
    // counter read 26'h0 before the edge
    fn blink_step(state: SimpleBlinkState) -> SimpleBlinkState {
        var next : SimpleBlinkState = init_state();
        next.counter = next_counter(state.counter);
        if (at_toggle_point(state.counter)) {
            next.led_state = !state.led_state;
        } else {
            next.led_state = state.led_state;
        }
        return next;
    }

    // assign led = ~led_state -- invert for the active-low LED
    fn led_output(state: SimpleBlinkState) -> bool {
        return !state.led_state;
    }

    // ---------------------------------------------------------------
    // Tests
    // ---------------------------------------------------------------

    test init_power_on
        given s = init_state()
        then s.counter == 0
        and s.led_state == false
        and led_output(s) == true

    test next_counter_counts_from_reset
        given s = init_state()
        then next_counter(s.counter) == 1

    test next_counter_wraps_at_max
        then next_counter(COUNTER_MAX) == 0

    test toggle_fires_at_zero
        given s = init_state()
        then at_toggle_point(s.counter) == true
        and at_toggle_point(next_counter(s.counter)) == false

    test toggle_does_not_fire_at_max
        then at_toggle_point(COUNTER_MAX) == false

    test led_inverts_state
        given off = init_state()
        then led_output(off) == true
        and led_output(SimpleBlinkState{ .counter = 3, .led_state = true }) == false

    test first_posedge_toggles
        given s2 = blink_step(init_state())
        then s2.counter == 1
        and s2.led_state == true
        and led_output(s2) == false

    test second_posedge_holds
        given s2 = blink_step(blink_step(init_state()))
        then s2.counter == 2
        and s2.led_state == true

    test wrap_then_toggle
        given s1 = blink_step(SimpleBlinkState{ .counter = COUNTER_MAX, .led_state = false })
        given s2 = blink_step(s1)
        then s1.counter == 0
        and s1.led_state == false
        and s2.counter == 1
        and s2.led_state == true

}

// End of module trinity_top
