// t27/specs/port/trinity/fpga/openxc7-synth/led_both_test.t27
// LED Both Test Module — Drive BOTH T23 and R23
// Try all combinations for LED testing on OpenXC7 FPGA
// Ports the original Verilog module to T27 specification
// Original: assign led_t23 = 1'b0; assign led_r23 = 1'b1;
// phi^2 + 1/phi^2 = 3 | TRINITY

module led_both_test_top {

    // === LED Output Constants ===
    // Port of the original Verilog constant assignments
    pub const LED_T23_VALUE : bool = false;  // 1'b0 = LOW = ON (active LOW)
    pub const LED_R23_VALUE : bool = true;   // 1'b1 = HIGH = OFF (active HIGH)

    // === LED State Functions ===
    // Return the constant values as specified in the original Verilog

    fn get_t23_led() -> bool {
        return LED_T23_VALUE;  // Always returns false (LOW = ON)
    }

    fn get_r23_led() -> bool {
        return LED_R23_VALUE;  // Always returns true (HIGH = OFF)
    }

    // === Configuration Struct ===
    // Simple struct to hold LED configuration for testing

    pub struct LedConfig {
        t23_on : bool,
        r23_on : bool,
    }

    fn default_config() -> LedConfig {
        return LedConfig{
            .t23_on = true,   // T23 is ON (LOW)
            .r23_on = false,  // R23 is OFF (HIGH)
        };
    }

    // === Validation Functions ===

    fn validate_config(config: LedConfig) -> u32 {
        var errors : u32 = 0;
        if (config.t23_on != true and config.t23_on != false) {
            errors = errors + 1;
        }
        if (config.r23_on != true and config.r23_on != false) {
            errors = errors + 1;
        }
        return errors;
    }

    // === Tests ===

    test t23_led_constant
        then get_t23_led() == false

    test r23_led_constant
        then get_r23_led() == true

    test led_config_defaults
        given cfg = default_config()
        then cfg.t23_on == true
        and cfg.r23_on == false

    test validate_config_ok
        given cfg = default_config()
        then validate_config(cfg) == 0

    test validate_config_invalid
        given cfg = LedConfig{.t23_on = true, .r23_on = false}
        then validate_config(cfg) == 0

    // === Invariants ===

    invariant t23_led_consistent
        then get_t23_led() == false

    invariant r23_led_consistent
        then get_r23_led() == true

    invariant config_validation_non_negative
        given cfg = default_config()
        assert validate_config(cfg) >= 0

    invariant boolean_values_valid
        assert LED_T23_VALUE == false
        and LED_R23_VALUE == true
}

// phi^2 + 1/phi^2 = 3 | TRINITY