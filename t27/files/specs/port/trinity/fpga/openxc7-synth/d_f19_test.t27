// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/d_f19_test.t27
// Trinity F19 LED Test Module Port
// Simple LED blinker using 24-bit counter
// Ports the original Verilog: fpga/openxc7-synth/d_f19_test.v
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Module constants ===

    pub const COUNTER_WIDTH : u32 = 24;
    pub const LED_BIT : u32 = 23;  // MSB of 24-bit counter

    // === Counter state ===

    pub struct F19CounterState {
        value : u32,
        cycles : u32,
    }

    // === BUFG configuration ===

    pub struct BufgConfig {
        name : &str,
        input_delay_ps : u32,
        output_delay_ps : u32,
    }

    // === Constructor functions ===

    fn counter_state() -> F19CounterState {
        return F19CounterState{
            .value = 0,
            .cycles = 0,
        };
    }

    fn bufg_config(name: &str) -> BufgConfig {
        return BufgConfig{
            .name = name,
            .input_delay_ps = 100,
            .output_delay_ps = 100,
        };
    }

    // === Core functionality ===

    // Buffer the clock using BUFG primitive (hardware-specific)
    // Returns buffered clock signal (simulated)
    fn buffer_clock(clk: bool, config: BufgConfig) -> bool {
        // In real hardware, this would instantiate a BUFG primitive
        // For simulation, we just pass through with some delay modeling
        return clk;
    }

    // Increment counter on positive clock edge
    fn increment_counter(state: F19CounterState, clk_pos_edge: bool) -> F19CounterState {
        var new_state : F19CounterState = state;
        if (clk_pos_edge) {
            new_state.cycles = new_state.cycles + 1;
            new_state.value = new_state.value + 1;
            
            // Handle 24-bit counter wraparound
            if (new_state.value >= (1 << COUNTER_WIDTH)) {
                new_state.value = 0;
            }
        }
        return new_state;
    }

    // Get LED output from counter state
    fn get_led(state: F19CounterState) -> bool {
        // LED is driven by the MSB (bit 23) of the 24-bit counter
        return (state.value >> LED_BIT) & 1 == 1;
    }

    // Full module simulation: takes clock input, returns LED output
    fn simulate_trinity_top(clk: bool) -> bool {
        var bufg : BufgConfig = bufg_config("clk_buf");
        var state : F19CounterState = counter_state();
        
        // Buffer the clock
        var clk_bufged : bool = buffer_clock(clk, bufg);
        
        // Detect positive edge (rising edge)
        var pos_edge : bool = clk_bufged;  // Simplified for simulation
        
        // Update counter
        state = increment_counter(state, pos_edge);
        
        // Return LED state
        return get_led(state);
    }

    // Test helper: simulate multiple clock cycles
    fn simulate_cycles(clk_pattern: []const bool, results: []bool) -> void {
        var state : F19CounterState = counter_state();
        var clk_bufged : bool = false;
        
        for (i in 0..clk_pattern.len) {
            // Buffer the clock
            clk_bufged = buffer_clock(clk_pattern[i], bufg_config("clk_buf"));
            
            // Detect positive edge (rising edge)
            var pos_edge : bool = clk_bufged;
            
            // Update counter
            state = increment_counter(state, pos_edge);
            
            // Store LED state
            if (i < results.len) {
                results[i] = get_led(state);
            }
        }
    }

    // === Validation functions ===

    fn validate_counter_width(width: u32) -> bool {
        return width > 0 and width <= 32;
    }

    fn validate_led_bit(bit: u32, width: u32) -> bool {
        return bit < width;
    }

    fn is_counter_power_of_two(value: u32) -> bool {
        if (value == 0) {
            return false;
        }
        return (value & (value - 1)) == 0;
    }

    // === Tests ===

    test counter_state_initialization
        given state = counter_state()
        then state.value == 0
        and state.cycles == 0

    test counter_increment_single
        given state = counter_state()
        and pos_edge = true
        then increment_counter(state, pos_edge).value == 1
        and increment_counter(state, pos_edge).cycles == 1

    test counter_increment_no_edge
        given state = counter_state()
        and pos_edge = false
        then increment_counter(state, pos_edge).value == 0
        and increment_counter(state, pos_edge).cycles == 0

    test counter_wraparound
        given state = F19CounterState{.value = (1 << COUNTER_WIDTH) - 1, .cycles = 100}
        and pos_edge = true
        then increment_counter(state, pos_edge).value == 0
        and increment_counter(state, pos_edge).cycles == 101

    test led_msb_zero
        given state = F19CounterState{.value = 0, .cycles = 0}
        then get_led(state) == false

    test led_msb_one
        given state = F19CounterState{.value = 1 << LED_BIT, .cycles = 1}
        then get_led(state) == true

    test led_msb_toggle
        given state1 = F19CounterState{.value = 0, .cycles = 0}
        and state2 = F19CounterState{.value = 1 << LED_BIT, .cycles = 1}
        then get_led(state1) == false
        and get_led(state2) == true

    test simulate_single_cycle_high
        given led = simulate_trinity_top(true)
        then led == false  // Counter starts at 0, MSB is 0

    test simulate_multiple_cycles
        var pattern: [4]bool = [false, true, false, true];
        var results: [4]bool = [_]bool{false} ** 4;
        simulate_cycles(&pattern, &results);
        // Pattern: low, high, low, high
        // Counter: 0 -> 1 -> 1 -> 2
        // LED (bit 23): 0 -> 0 -> 0 -> 0 (for 4 cycles, MSB stays 0)
        then results[0] == false  // Counter = 0, LED = 0
        and results[1] == false  // Counter = 1, LED = 0
        and results[2] == false  // Counter = 1, LED = 0
        and results[3] == false  // Counter = 2, LED = 0

    test simulate_until_led_toggle
        var pattern: [25]bool = [_]bool{true} ** 25;  // 25 rising edges
        var results: [25]bool = [_]bool{false} ** 25;
        simulate_cycles(&pattern, &results);
        // After 2^23 = 8,388,608 cycles, bit 23 would toggle
        // For simulation with 25 cycles, LED should still be false
        then results[0] == false  // Cycle 1: counter = 1, LED = 0
        and results[24] == false  // Cycle 25: counter = 25, LED = 0 (bit 23 still 0)

    test validate_counter_width_ok
        then validate_counter_width(24) == true

    test validate_counter_width_bad
        then validate_counter_width(0) == false
        and validate_counter_width(33) == false

    test validate_led_bit_ok
        then validate_led_bit(23, 24) == true

    test validate_led_bit_bad
        then validate_led_bit(24, 24) == false
        and validate_led_bit(25, 24) == false

    test is_power_of_two_true
        then is_counter_power_of_two(1) == true
        and is_counter_power_of_two(2) == true
        and is_counter_power_of_two(16) == true
        and is_counter_power_of_two(8192) == true

    test is_power_of_two_false
        then is_counter_power_of_two(0) == false
        and is_counter_power_of_two(3) == false
        and is_counter_power_of_two(5) == false
        and is_counter_power_of_two(24) == false

    // === Invariants ===

    invariant counter_width_positive
        assert validate_counter_width(COUNTER_WIDTH) == true

    invariant led_bit_valid
        assert validate_led_bit(LED_BIT, COUNTER_WIDTH) == true

    invariant counter_state_consistent
        given state = counter_state()
        assert state.cycles == 0
        and state.value == 0

    invariant led_matches_counter_msb
        given state = F19CounterState{.value = 0x800000, .cycles = 1}  // Bit 23 set
        assert get_led(state) == true

    invariant buffer_config_valid
        given config = bufg_config("test")
        assert config.name == "test"
        and config.input_delay_ps > 0
        and config.output_delay_ps > 0

    // Helper function for benchmark
    fn simulate_cycles_simple() -> void {
        var results: [10]bool = [_]bool{false} ** 10;
        simulate_cycles(&[_]bool{true} ** 10, &results);
    }

    // === Benchmarks ===

    bench counter_increment_latency
        measure: nanoseconds to increment_counter(counter_state(), true)
        target: < 10ns

    bench led_output_latency
        measure: nanoseconds to get_led(F19CounterState{.value = 0x123456, .cycles = 100})
        target: < 5ns

    bench full_simulation_latency
        measure: nanoseconds to simulate_cycles_simple
        target: < 100ns
}

// phi^2 + 1/phi^2 = 3 | TRINITY