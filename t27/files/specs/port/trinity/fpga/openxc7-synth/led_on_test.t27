// t27/specs/port/trinity/fpga/openxc7-synth/led_on_test.t27
// LED ON Test — Simplest possible test for Trinity FPGA
// Just turn LED ON steady - no clock, no counter
// Ports the original Verilog module led_on_test_top
// Original: assign led = 1'b0; (active LOW: 0 = ON)
// Uses flat arrays + count fields (parser-compatible)
// phi^2 + 1/phi^2 = 3 | TRINITY

module led_on_test_top {

    // === LED configuration ===
    // Original comment: "Try active LOW (0 = ON)"
    pub const LED_ACTIVE_LOW : bool = true;
    pub const LED_ON_VALUE : u8 = 0;  // 1'b0 in Verilog
    pub const LED_OFF_VALUE : u8 = 1; // 1'b1 in Verilog

    // === Combinational function that mimics the original assign statement ===
    // The original: assign led = 1'b0;
    // This function returns the constant value for the LED output
    pub fn get_led_value() -> u8 {
        return LED_ON_VALUE;  // Always return 0 (active LOW = ON)
    }

    // === Test that verifies the original behavior ===
    test led_on_test_original_behavior
        // The original Verilog assigns led = 1'b0 (active LOW = ON)
        then get_led_value() == LED_ON_VALUE
        and LED_ON_VALUE == 0  // Verify 1'b0 translates to 0
        and LED_ACTIVE_LOW == true  // Verify active LOW configuration

    test led_values_consistency
        then LED_ON_VALUE != LED_OFF_VALUE  // ON and OFF should be different

    // === Invariant to ensure LED logic is correct ===
    invariant led_on_constant
        // The LED should always be ON (value 0 for active LOW)
        assert get_led_value() == LED_ON_VALUE
        and LED_ON_VALUE == 0
}

// phi^2 + 1/phi^2 = 3 | TRINITY