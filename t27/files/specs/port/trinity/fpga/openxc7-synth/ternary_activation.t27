// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/ternary_activation.t27
// Ternary Activation Module for Trinity S³AI — Streaming ReLU
// Ported from gHashTag/trinity fpga/openxc7-synth/ternary_activation.v
// out = (in > 0) ? in : 0
// 1-clock pipeline: valid/data/done all delayed by 1 cycle
// ~10 LUT, 0 BRAM, 0 DSP
// phi^2 + 1/phi^2 = 3 | TRINITY

module ternary_activation {

    // === Module parameters ===

    pub const DEFAULT_WIDTH : u32 = 20;

    // === Input interface ===

    pub struct TernaryActivationInput {
        data : i32,
        valid : bool,
        done : bool,
    }

    // === Output interface ===

    pub struct TernaryActivationOutput {
        data : i32,
        valid : bool,
        done : bool,
    }

    // === Constructor helpers ===

    fn input(data: i32, valid: bool, done: bool) -> TernaryActivationInput {
        return TernaryActivationInput{
            .data = data,
            .valid = valid,
            .done = done,
        };
    }

    fn output(data: i32, valid: bool, done: bool) -> TernaryActivationOutput {
        return TernaryActivationOutput{
            .data = data,
            .valid = valid,
            .done = done,
        };
    }

    // === Core computation functions ===

    // ReLU: clamp negative to zero, pass positive through
    fn relu_activation(data: i32) -> i32 {
        if (data > 0) {
            return data;
        } else {
            return 0;
        }
    }

    // Pipeline simulation: 1-clock delay for valid/data/done
    fn pipeline_step(input: TernaryActivationInput) -> TernaryActivationOutput {
        var data_out : i32 = relu_activation(input.data);
        return output(data_out, input.valid, input.done);
    }

    // === Validation functions ===

    fn validate_input_width(width: u32) -> bool {
        return width > 0 and width <= 64;
    }

    fn is_valid_relu_result(input_data: i32, output_data: i32) -> bool {
        // ReLU should clamp negatives to zero and pass positives through
        if (input_data > 0) {
            return output_data == input_data;
        } else {
            return output_data == 0;
        }
    }

    fn pipeline_behavior_preserves_done(done_in: bool, valid_in: bool) -> bool {
        // Done should be preserved through the pipeline when valid is high
        return done_in == true or valid_in == false;
    }

    // === Tests ===

    test relu_positive_passthrough
        then relu_activation(42) == 42
        and relu_activation(1) == 1
        and relu_activation(1000) == 1000

    test relu_negative_clamping
        then relu_activation(-5) == 0
        and relu_activation(-1) == 0
        and relu_activation(-1000) == 0

    test relu_zero_passthrough
        then relu_activation(0) == 0

    test pipeline_positive_input
        given input_data = input(42, true, false)
        then pipeline_step(input_data).data == 42
        and pipeline_step(input_data).valid == true
        and pipeline_step(input_data).done == false

    test pipeline_negative_input
        given input_data = input(-5, true, false)
        then pipeline_step(input_data).data == 0
        and pipeline_step(input_data).valid == true
        and pipeline_step(input_data).done == false

    test pipeline_zero_input
        given input_data = input(0, true, false)
        then pipeline_step(input_data).data == 0
        and pipeline_step(input_data).valid == true
        and pipeline_step(input_data).done == false

    test pipeline_done_preservation
        given input_data = input(42, true, true)
        then pipeline_step(input_data).done == true
        and pipeline_step(input_data).valid == true

    test pipeline_done_with_invalid
        given input_data = input(42, false, true)
        then pipeline_step(input_data).done == true
        and pipeline_step(input_data).valid == false

    test validate_width_ok
        then validate_input_width(20) == true
        and validate_input_width(32) == true
        and validate_input_width(1) == true

    test validate_width_bad
        then validate_input_width(0) == false
        and validate_input_width(65) == false

    test relu_result_validation_positive
        then is_valid_relu_result(42, 42) == true
        and is_valid_relu_result(1, 1) == true

    test relu_result_validation_negative
        then is_valid_relu_result(-5, 0) == true
        and is_valid_relu_result(-1, 0) == true

    test pipeline_behavior_validation
        then pipeline_behavior_preserves_done(true, true) == true
        and pipeline_behavior_preserves_done(false, false) == true
        and pipeline_behavior_preserves_done(true, false) == true

    // === Invariants ===

    invariant relu_output_non_negative
        given input_val = -100
        assert relu_activation(input_val) >= 0

    invariant pipeline_output_valid_matches_input
        given input_data = input(42, true, false)
        assert pipeline_step(input_data).valid == input_data.valid

    invariant pipeline_output_done_matches_input
        given input_data = input(42, true, true)
        assert pipeline_step(input_data).done == input_data.done

    invariant relu_identity_for_positive
        given input_val = 42
        assert relu_activation(input_val) == input_val

    invariant relu_zero_for_non_positive
        given input_val = -42
        assert relu_activation(input_val) == 0

    bench relu_computation_latency
        measure: nanoseconds to relu_activation(42)
        target: < 10ns

    bench pipeline_step_latency
        measure: nanoseconds to pipeline_step(input(42, true, false))
        target: < 20ns

}