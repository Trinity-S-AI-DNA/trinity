// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/symbiflow_blink.t27
// SymbiFlow LED blink module for Xilinx Artix-7 XC7A100T
// Ports the original fpga/openxc7-synth/symbiflow_blink.v to T27 HIR
// 25-bit counter with MSB LED output for visual verification
// Uses flat arrays + count fields (parser-compatible)
// phi^2 + 1/phi^2 = 3 | TRINITY

module xc7a100t_testbench {

    // === Port declarations ===

    pub const CLK_INPUT : &str = "clk";
    pub const LED_OUTPUT : &str = "led";

    // === Counter configuration ===

    pub const COUNTER_WIDTH : u32 = 25;
    pub const COUNTER_MAX : u32 = 33554431; // 2^25 - 1
    pub const BLINK_PERIOD : u32 = 16777216; // 2^24 clock cycles

    // === Counter state ===

    pub struct CounterState {
        value : u32,
        cycles : u32,
    }

    // === Constructor helpers ===

    fn initial_counter() -> CounterState {
        return CounterState{
            .value = 0,
            .cycles = 0,
        };
    }

    fn counter_at_value(value: u32) -> CounterState {
        return CounterState{
            .value = value,
            .cycles = value,
        };
    }

    // === Counter operations ===

    fn increment_counter(state: CounterState) -> CounterState {
        var new_value : u32 = state.value + 1;
        if (new_value > COUNTER_MAX) {
            new_value = 0;
        }
        return CounterState{
            .value = new_value,
            .cycles = state.cycles + 1,
        };
    }

    fn counter_msb(state: CounterState) -> bool {
        return (state.value & (1 << 24)) != 0;
    }

    fn counter_half_period(state: CounterState) -> bool {
        return (state.value & (1 << 23)) != 0;
    }

    fn is_power_of_two(value: u32) -> bool {
        if (value == 0) {
            return false;
        }
        return (value & (value - 1)) == 0;
    }

    fn count_set_bits(value: u32) -> u32 {
        var count : u32 = 0;
        var v : u32 = value;
        while (v > 0) {
            count = count + (v & 1);
            v = v >> 1;
        }
        return count;
    }

    // === LED output computation ===

    fn compute_led(state: CounterState) -> bool {
        return counter_msb(state);
    }

    // === Period analysis ===

    fn period_complete(state: CounterState) -> bool {
        return state.value == 0 and state.cycles > 0;
    }

    fn cycles_to_half_period(cycles: u32) -> u32 {
        return cycles / 2;
    }

    fn is_blinking_at_half_period(state: CounterState) -> bool {
        return counter_half_period(state);
    }

    // === Validation ===

    fn validate_counter_width() -> u32 {
        var errors : u32 = 0;
        if (COUNTER_WIDTH != 25) {
            errors = errors + 1;
        }
        if (COUNTER_MAX != (1 << 25) - 1) {
            errors = errors + 1;
        }
        return errors;
    }

    fn validate_counter_state(state: CounterState) -> u32 {
        var errors : u32 = 0;
        if (state.value > COUNTER_MAX) {
            errors = errors + 1;
        }
        if (state.cycles < state.value) {
            errors = errors + 1;
        }
        return errors;
    }

    // === Tests ===

    test counter_initialization
        given state = initial_counter()
        then state.value == 0
        and state.cycles == 0

    test counter_increment_basic
        given state = initial_counter()
        when next_state = increment_counter(state)
        then next_state.value == 1
        and next_state.cycles == 1

    test counter_increment_overflow
        given state = counter_at_value(COUNTER_MAX)
        when next_state = increment_counter(state)
        then next_state.value == 0
        and next_state.cycles == COUNTER_MAX + 1

    test counter_msb_zero
        given state = counter_at_value(0)
        then counter_msb(state) == false

    test counter_msb_set
        given state = counter_at_value(1 << 24)
        then counter_msb(state) == true

    test counter_msb_clear
        given state = counter_at_value((1 << 24) - 1)
        then counter_msb(state) == false

    test led_output_off
        given state = counter_at_value(0)
        then compute_led(state) == false

    test led_output_on
        given state = counter_at_value(1 << 24)
        then compute_led(state) == true

    test half_period_detection
        given state = counter_at_value(1 << 23)
        then counter_half_period(state) == true
        and is_blinking_at_half_period(state) == true

    test power_of_two_validation
        then is_power_of_two(1) == true
        and is_power_of_two(2) == true
        and is_power_of_two(4) == true
        and is_power_of_two(3) == false
        and is_power_of_two(5) == false

    test bit_counting
        then count_set_bits(0b0) == 0
        and count_set_bits(0b1) == 1
        and count_set_bits(0b1010) == 2
        and count_set_bits(0b1111) == 4

    test counter_width_validation
        then validate_counter_width() == 0

    test counter_state_validation
        given state = initial_counter()
        then validate_counter_state(state) == 0

    test counter_state_validation_invalid
        given state = CounterState{ .value = COUNTER_MAX + 1, .cycles = 0 }
        then validate_counter_state(state) > 0

    test period_completion
        given state = counter_at_value(0)
        then period_complete(state) == false

    test period_completion_after_increment
        given state = initial_counter()
        when next_state = increment_counter(state)
        when state2 = increment_counter(next_state)
        when state3 = increment_counter(increment_counter(increment_counter(next_state)))
        then state2.value == 2
        and state2.cycles == 2
        and state3.value == 4
        and state3.cycles == 4

    test blink_period_halfway
        given state = counter_at_value(BLINK_PERIOD / 2)
        then counter_half_period(state) == true
        and compute_led(state) == false

    // === Invariants ===

    invariant counter_width_constant
        assert COUNTER_WIDTH == 25

    invariant counter_max_correct
        assert COUNTER_MAX == (1 << 25) - 1

    invariant blink_period_power_of_two
        assert is_power_of_two(BLINK_PERIOD)

    invariant msb_bit_position
        assert (1 << 24) == 16777216

    invariant counter_state_consistency
        given state = CounterState{ .value = 100, .cycles = 100 }
        assert state.cycles >= state.value

    invariant led_boolean_output
        given state = initial_counter()
        assert compute_led(state) == true or compute_led(state) == false

    bench counter_increment_latency
        measure: nanoseconds to increment_counter(initial_counter())
        target: < 10ns

    bench led_computation_latency
        measure: nanoseconds to compute_led(initial_counter())
        target: < 5ns
}

// phi^2 + 1/phi^2 = 3 | TRINITY