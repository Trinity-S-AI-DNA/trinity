// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/d_srl_blink.t27
// SRL16E-based blink (no FD flip-flops) for Trinity S³AI — synthesizable Verilog module
// 16-bit shift register with rotation and active-low LED output
// Ports the original Verilog module to T27 specification
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Shift register configuration ===
    
    pub struct ShiftRegisterConfig {
        width : u32,
        initial_value : u32,
        is_active_low : bool,
    }
    
    fn shift_register_config() -> ShiftRegisterConfig {
        return ShiftRegisterConfig{
            .width = 16,
            .initial_value = 0x0001,  // 16'h0001
            .is_active_low = true,
        };
    }
    
    // === Shift register state computation ===
    
    fn rotate_left(value: u32, width: u32) -> u32 {
        // Rotate left by 1 bit: {value[width-2:0], value[width-1]}
        if (width == 0) {
            return 0;
        }
        var mask : u32 = (1 << width) - 1;  // Create mask for width bits
        var rotated : u32 = ((value << 1) & mask) | ((value >> (width - 1)) & 1);
        return rotated;
    }
    
    fn shift_register_next_state(current: u32, width: u32) -> u32 {
        // On each clock edge, rotate the shift register left by 1 bit
        // Original: shift <= {shift[14:0], shift[15]};
        return rotate_left(current, width);
    }
    
    fn get_highest_bit(value: u32, width: u32) -> bool {
        // Get the highest bit (bit width-1)
        if (width == 0) {
            return false;
        }
        return (value & (1 << (width - 1))) != 0;
    }
    
    fn led_output(shift_value: u32, cfg: ShiftRegisterConfig) -> bool {
        // Active-low LED: led = ~shift[15]
        // If highest bit is 1, LED should be 0 (OFF)
        // If highest bit is 0, LED should be 1 (ON)
        var highest_bit : bool = get_highest_bit(shift_value, cfg.width);
        if (cfg.is_active_low) {
            return !highest_bit;  // Invert for active-low
        } else {
            return highest_bit;   // Direct for active-high
        }
    }
    
    fn compute_led_state(clk: bool, current_shift: u32, cfg: ShiftRegisterConfig) -> u32 {
        // Compute LED output based on current shift register state
        var led_on : bool = led_output(current_shift, cfg);
        if (led_on) {
            return 0;  // 1'b0 for LED ON
        } else {
            return 1;  // 1'b1 for LED OFF
        }
    }
    
    // === Tests ===
    
    test shift_register_config_defaults
        given cfg = shift_register_config()
        then cfg.width == 16
        and cfg.initial_value == 0x0001
        and cfg.is_active_low == true
    
    test rotate_left_16bit
        then rotate_left(0x0001, 16) == 0x0002  // 0b0000...0001 -> 0b0000...0010
        and rotate_left(0x0002, 16) == 0x0004  // 0b0000...0010 -> 0b0000...0100
        and rotate_left(0x8000, 16) == 0x0001  // 0b1000...0000 -> 0b0000...0001 (rotation)
    
    test get_highest_bit
        then get_highest_bit(0x8000, 16) == true   // Bit 15 is set
        and get_highest_bit(0x7FFF, 16) == false  // Bit 15 is not set
        and get_highest_bit(0x0001, 16) == false  // Bit 15 is not set
    
    test led_output_active_low
        given cfg = shift_register_config()
        then led_output(0x8000, cfg) == false  // Highest bit set -> LED OFF (0)
        and led_output(0x7FFF, cfg) == true   // Highest bit clear -> LED ON (1)
        and led_output(0x0001, cfg) == true   // Highest bit clear -> LED ON (1)
    
    test compute_led_state
        given cfg = shift_register_config()
        then compute_led_state(true, 0x8000, cfg) == 1   // LED OFF
        and compute_led_state(true, 0x7FFF, cfg) == 0   // LED ON
        and compute_led_state(false, 0x0001, cfg) == 0  // LED ON
    
    test simulate_single_cycle
        given cfg = shift_register_config()
        then simulate_clock_cycle(true, 0x0001, cfg) == 0  // Clock rises, LED ON
        and simulate_clock_cycle(false, 0x0001, cfg) == 0 // Clock falls, no change
    
    test simulate_clock_cycle
        given cfg = shift_register_config()
        and clk: bool = true
        and current_shift: u32 = 0x0001
        then simulate_clock_cycle(clk, current_shift, cfg) == 0  // LED should be ON
}

fn simulate_clock_cycle(clk: bool, current_shift: u32, cfg: ShiftRegisterConfig) -> u32 {
    // Simulate one clock cycle
    var next_shift : u32 = current_shift;
    var led_value : u32 = 0;
    
    // On positive clock edge, update shift register
    if (clk) {
        next_shift = shift_register_next_state(current_shift, cfg.width);
    }
    
    led_value = compute_led_state(clk, next_shift, cfg);
    return led_value;
}

// phi^2 + 1/phi^2 = 3 | TRINITY