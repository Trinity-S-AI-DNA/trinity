module trinity_top;

const COUNTER_WIDTH: u32 = 24;

// Initialize counter state
fn initial_counter() -> u32 {
    return 0;
}

// Get current counter value
fn counter_value(value: u32) -> u32 {
    return value;
}

// Check if LED is on (active-low: 1 means ON)
fn is_led_on(value: u32) -> bool {
    return (value & (1 << (COUNTER_WIDTH - 1))) == 0;
}

// Increment counter by 1
fn increment_counter(value: u32) -> u32 {
    return value + 1;
}

// === Tests ===

test initial_state_test
    const init_val: u32 = initial_counter();
    assert(counter_value(init_val) == 0);
    assert(is_led_on(init_val) == true);

test single_increment_test
    const start_val: u32 = initial_counter();
    const after_val: u32 = increment_counter(start_val);
    assert(counter_value(after_val) == 1);
    assert(is_led_on(after_val) == true);

test led_behavior_test
    const test_val: u32 = initial_counter();
    assert(is_led_on(test_val) == true);
    const test_val_2: u32 = increment_counter(test_val);
    assert(is_led_on(test_val_2) == true);