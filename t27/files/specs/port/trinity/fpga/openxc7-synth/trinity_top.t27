// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/trinity_top.t27
// FPGA component for Trinity S³AI — synthesizable Verilog module
// LED blink counter with 25-bit register and active-low output
// Ports the original Verilog: reg [24:0] counter; always @(posedge clk) counter <= counter + 1; assign led = ~counter[24]
// Uses flat arrays + count fields (parser-compatible)
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Module interface constants ===
    
    pub const COUNTER_WIDTH : u32 = 25;
    pub const MAX_COUNTER_VALUE : u32 = 33554431;  // 2^25 - 1

    // === Counter state ===
    
    pub struct CounterState {
        value : u32,
        cycles : u32,
    }

    // === LED output configuration ===
    
    pub struct LedConfig {
        is_active_low : bool,
        blink_half_period : u32,  // Half-period in cycles (counter[24] toggles every 2^24 cycles)
    }

    // === Counter functions ===

    fn initial_counter() -> CounterState {
        return CounterState{
            .value = 0,
            .cycles = 0,
        };
    }

    fn counter_next(state: CounterState, clk_edge: bool) -> CounterState {
        var next_value : u32 = state.value;
        var next_cycles : u32 = state.cycles;
        
        if (clk_edge) {
            next_value = state.value + 1;
            next_cycles = state.cycles + 1;
            
            // Handle 25-bit overflow (original uses 25'd0, so it wraps around)
            if (next_value > MAX_COUNTER_VALUE) {
                next_value = 0;
            }
        }
        
        return CounterState{
            .value = next_value,
            .cycles = next_cycles,
        };
    }

    fn counter_bit_24(state: CounterState) -> bool {
        // Extract bit 24 from the 25-bit counter (0-indexed, so bit 24 is the MSB)
        return (state.value & 0x00800000) != 0;
    }

    // === LED output functions ===

    fn led_config() -> LedConfig {
        return LedConfig{
            .is_active_low = true,
            .blink_half_period = 8388608,  // 2^24 = 16,777,216 cycles for full period
        };
    }

    fn led_output(state: CounterState, cfg: LedConfig) -> bool {
        var bit_24 : bool = counter_bit_24(state);
        
        // Original: assign led = ~counter[24];  // Active-low
        // So when counter[24] is 1, led should be 0 (OFF)
        // When counter[24] is 0, led should be 1 (ON)
        
        if (cfg.is_active_low) {
            return !bit_24;  // Active-low: invert the bit
        } else {
            return bit_24;  // Active-high: use the bit directly
        }
    }

    fn led_value(state: CounterState, cfg: LedConfig) -> u32 {
        // Convert boolean to 1-bit Verilog value (0 or 1)
        if (led_output(state, cfg)) {
            return 0;  // 1'b0 for ON (active-low)
        } else {
            return 1;  // 1'b1 for OFF (active-low)
        }
    }

    // === Simulation helpers ===

    fn simulate_clock_cycles(initial_state: CounterState, num_cycles: u32) -> CounterState {
        var state : CounterState = initial_state;
        var i : u32 = 0;
        
        while (i < num_cycles) {
            // Simulate clock edge every cycle
            state = counter_next(state, true);
            i = i + 1;
        }
        
        return state;
    }

    fn get_blink_period(cfg: LedConfig) -> u32 {
        return cfg.blink_half_period * 2;  // Full period is 2 * half_period
    }

    // === Validation ===

    fn validate_counter_state(state: CounterState) -> u32 {
        var errors : u32 = 0;
        
        if (state.value > MAX_COUNTER_VALUE) {
            errors = errors + 1;
        }
        
        if (state.cycles == 0 and state.value != 0) {
            errors = errors + 1;
        }
        
        return errors;
    }

    fn validate_led_config(cfg: LedConfig) -> u32 {
        var errors : u32 = 0;
        
        if (!cfg.is_active_low) {
            // Only active-low is supported in the original
            errors = errors + 1;
        }
        
        if (cfg.blink_half_period == 0) {
            errors = errors + 1;
        }
        
        return errors;
    }

    // === Tests ===

    test counter_initialization
        given state = initial_counter()
        then state.value == 0
        and state.cycles == 0
        and validate_counter_state(state) == 0

    test counter_increment_on_clock_edge
        given initial = initial_counter()
        and next = counter_next(initial, true)
        then next.value == 1
        and next.cycles == 1
        and validate_counter_state(next) == 0

    test counter_no_change_no_clock_edge
        given initial = initial_counter()
        and next = counter_next(initial, false)
        then next.value == 0
        and next.cycles == 0

    test counter_overflow
        given max_state = CounterState{.value = MAX_COUNTER_VALUE, .cycles = 100}
        and next = counter_next(max_state, true)
        then next.value == 0
        and next.cycles == 101

    test counter_bit_24_zero
        given state = CounterState{.value = 0, .cycles = 0}
        then counter_bit_24(state) == false

    test counter_bit_24_one
        given state = CounterState{.value = 0x00800000, .cycles = 0}  // 2^24
        then counter_bit_24(state) == true

    test led_config_active_low
        given cfg = led_config()
        then cfg.is_active_low == true
        and cfg.blink_half_period == 8388608

    test led_output_counter_bit_zero
        given state = CounterState{.value = 0, .cycles = 0}
        and cfg = led_config()
        then led_output(state, cfg) == true  // Active-low: 0 bit -> LED ON (1)
        and led_value(state, cfg) == 0

    test led_output_counter_bit_one
        given state = CounterState{.value = 0x00800000, .cycles = 0}
        and cfg = led_config()
        then led_output(state, cfg) == false  // Active-low: 1 bit -> LED OFF (0)
        and led_value(state, cfg) == 1

    test led_output_half_period_toggles
        given initial = initial_counter()
        and after_half_period = simulate_clock_cycles(initial, 8388608)  // 2^24 cycles
        and cfg = led_config()
        // After half period, counter[24] should have toggled once
        then led_output(initial, cfg) != led_output(after_half_period, cfg)

    test simulate_clock_cycles_basic
        given initial = initial_counter()
        and after_10_cycles = simulate_clock_cycles(initial, 10)
        then after_10_cycles.value == 10
        and after_10_cycles.cycles == 10

    test validate_counter_ok
        given state = CounterState{.value = 12345, .cycles = 12345}
        then validate_counter_state(state) == 0

    test validate_counter_invalid_value
        given state = CounterState{.value = MAX_COUNTER_VALUE + 1, .cycles = 0}
        then validate_counter_state(state) > 0

    test validate_led_config_ok
        given cfg = led_config()
        then validate_led_config(cfg) == 0

    test validate_led_config_wrong_polarity
        given cfg = LedConfig{.is_active_low = false, .blink_half_period = 8388608}
        then validate_led_config(cfg) > 0

    // === Invariants ===

    invariant counter_value_within_bounds
        given state = CounterState{.value = 12345, .cycles = 12345}
        assert state.value <= MAX_COUNTER_VALUE

    invariant counter_cycles_non_decreasing
        given initial = initial_counter()
        and next = counter_next(initial, true)
        assert next.cycles >= initial.cycles

    invariant led_output_boolean
        given state = CounterState{.value = 12345, .cycles = 12345}
        and cfg = led_config()
        assert led_output(state, cfg) == true or led_output(state, cfg) == false

    invariant led_value_is_0_or_1
        given state = CounterState{.value = 12345, .cycles = 12345}
        and cfg = led_config()
        assert led_value(state, cfg) == 0 or led_value(state, cfg) == 1

    invariant counter_bit_24_is_boolean
        given state = CounterState{.value = 0x00800000, .cycles = 0}
        assert counter_bit_24(state) == true or counter_bit_24(state) == false

    // === Benchmarks ===

    bench counter_increment_latency
        measure: nanoseconds to counter_next(initial_counter(), true)
        target: < 10ns

    bench led_output_latency
        measure: nanoseconds to led_output(initial_counter(), led_config())
        target: < 5ns

    bench simulation_100_cycles_latency
        measure: nanoseconds to simulate_clock_cycles(initial_counter(), 100)
        target: < 100ns

    bench counter_validation_latency
        measure: nanoseconds to validate_counter_state(CounterState{.value = 12345, .cycles = 12345})
        target: < 10ns

}

// phi^2 + 1/phi^2 = 3 | TRINITY