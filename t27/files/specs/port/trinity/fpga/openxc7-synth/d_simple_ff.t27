// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/d_simple_ff.t27
// Simple flip-flop test module for Trinity S3AI - host model of the Verilog module
// Ports the original Verilog: single FF that toggles every clock cycle
// Active-low LED output with clock buffer
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Module interface ===
    
    // Module ports match the original Verilog exactly:
    // input  wire clk,
    // output wire led,
    pub struct ModulePorts {
        clk : bool,
        led : bool,
    }
    
    // === Internal state ===
    
    pub struct FlipFlopState {
        q : bool,        // Current flip-flop state (reg q = 0;)
        clk_bufged : bool,  // Buffered clock signal
    }
    
    // === Clock buffer (BUFG primitive) ===
    
    fn buffer_clock(clk: bool) -> bool {
        // Simulates BUFG behavior: passes clock through
        // Original: BUFG clk_buf (.I(clk), .O(clk_bufged));
        return clk;
    }
    
    // === Flip-flop state update on positive edge ===
    
    fn update_flip_flop(current: FlipFlopState, clk_posedge: bool) -> FlipFlopState {
        var next : FlipFlopState = FlipFlopState{
            .q = current.q,
            .clk_bufged = current.clk_bufged,
        };
        
        // On positive edge of buffered clock: toggle the flip-flop
        // Original: always @(posedge clk_bufged) begin q <= ~q; end
        if (clk_posedge) {
            next.q = !current.q;
        }
        
        return next;
    }
    
    // === LED output (active-low) ===
    
    fn compute_led_output(ff_state: FlipFlopState) -> bool {
        // Active-low LED: ~q means 0 = ON, 1 = OFF
        // Original: assign led = ~q;  // Active-low
        return !ff_state.q;
    }
    
    // === Main module computation ===
    
    fn trinity_top_module(ports: ModulePorts) -> ModulePorts {
        var state : FlipFlopState = FlipFlopState{
            .q = false,    // Initialize to 0 (reg q = 0;)
            .clk_bufged = false,  // Previous clock state (initially low)
        };
        
        // Detect rising edge BEFORE updating buffered clock
        var clk_posedge : bool = ports.clk and !state.clk_bufged;
        
        // Update flip-flop state on rising edge
        state = update_flip_flop(state, clk_posedge);
        
        // Update buffered clock after state update
        state.clk_bufged = buffer_clock(ports.clk);
        
        // Return updated ports
        return ModulePorts{
            .clk = ports.clk,
            .led = compute_led_output(state),
        };
    }
    
    // === Test helper functions ===
    
    fn simulate_two_cycles(clk1: bool, clk2: bool) -> (FlipFlopState, FlipFlopState) {
        // Simulate two consecutive clock cycles
        var state1 : FlipFlopState = FlipFlopState{
            .q = false,    // Initial state
            .clk_bufged = buffer_clock(clk1),
        };
        
        // First cycle
        var edge1 : bool = clk1 and !false;  // Rising edge detection (previous was low)
        if (edge1) {
            state1.q = !state1.q;
        }
        state1.clk_bufged = buffer_clock(clk1);
        
        // Second cycle
        var state2 : FlipFlopState = FlipFlopState{
            .q = state1.q,
            .clk_bufged = buffer_clock(clk2),
        };
        var edge2 : bool = clk2 and !clk1;  // Rising edge detection
        if (edge2) {
            state2.q = !state2.q;
        }
        state2.clk_bufged = buffer_clock(clk2);
        
        return (state1, state2);
    }
    
    fn simulate_four_cycles(c1: bool, c2: bool, c3: bool, c4: bool) -> (FlipFlopState, FlipFlopState, FlipFlopState, FlipFlopState) {
        // Simulate four consecutive clock cycles
        var state1 : FlipFlopState = FlipFlopState{
            .q = false,    // Initial state
            .clk_bufged = buffer_clock(c1),
        };
        
        // Cycle 1
        var edge1 : bool = c1 and !false;
        if (edge1) {
            state1.q = !state1.q;
        }
        state1.clk_bufged = buffer_clock(c1);
        
        // Cycle 2
        var state2 : FlipFlopState = FlipFlopState{
            .q = state1.q,
            .clk_bufged = buffer_clock(c2),
        };
        var edge2 : bool = c2 and !c1;
        if (edge2) {
            state2.q = !state2.q;
        }
        state2.clk_bufged = buffer_clock(c2);
        
        // Cycle 3
        var state3 : FlipFlopState = FlipFlopState{
            .q = state2.q,
            .clk_bufged = buffer_clock(c3),
        };
        var edge3 : bool = c3 and !c2;
        if (edge3) {
            state3.q = !state3.q;
        }
        state3.clk_bufged = buffer_clock(c3);
        
        // Cycle 4
        var state4 : FlipFlopState = FlipFlopState{
            .q = state3.q,
            .clk_bufged = buffer_clock(c4),
        };
        var edge4 : bool = c4 and !c3;
        if (edge4) {
            state4.q = !state4.q;
        }
        state4.clk_bufged = buffer_clock(c4);
        
        return (state1, state2, state3, state4);
    }
    
    // === Validation functions ===
    
    fn validate_ff_state(state: FlipFlopState) -> u32 {
        var errors : u32 = 0;
        // Flip-flop state should always be boolean
        if (state.q != true and state.q != false) {
            errors = errors + 1;
        }
        if (state.clk_bufged != true and state.clk_bufged != false) {
            errors = errors + 1;
        }
        return errors;
    }
    
    fn validate_module_ports(ports: ModulePorts) -> u32 {
        var errors : u32 = 0;
        if (ports.clk != true and ports.clk != false) {
            errors = errors + 1;
        }
        if (ports.led != true and ports.led != false) {
            errors = errors + 1;
        }
        return errors;
    }
    
    // === Tests ===

    test initial_ff_state {
        const state = FlipFlopState{ .q = false, .clk_bufged = false };
        assert state.q == false;
        assert state.clk_bufged == false;
        assert validate_ff_state(state) == 0;
    }

    test initial_module_ports {
        const ports = ModulePorts{ .clk = false, .led = true };
        assert ports.clk == false;
        assert ports.led == true;
        assert validate_module_ports(ports) == 0;
    }

    test clock_buffer_passthrough {
        assert buffer_clock(true) == true;
        assert buffer_clock(false) == false;
    }

    test ff_toggle_simple {
        const low = FlipFlopState{ .q = false, .clk_bufged = true };
        const high = FlipFlopState{ .q = true, .clk_bufged = true };
        assert compute_led_output(low) == true;
        assert compute_led_output(high) == false;
        const toggled = update_flip_flop(low, true);
        const restored = update_flip_flop(toggled, true);
        const held = update_flip_flop(high, false);
        assert toggled.q == true;
        assert restored.q == false;
        assert held.q == true;
        assert held.clk_bufged == high.clk_bufged;
    }

    test rising_edge_detection {
        const steady_high = simulate_four_cycles(true, true, true, true);
        const s1 = steady_high.0;
        const s2 = steady_high.1;
        const s3 = steady_high.2;
        const s4 = steady_high.3;
        assert s1.q == true;
        assert s2.q == true;
        assert s3.q == true;
        assert s4.q == true;
    }

    test single_cycle_toggle {
        const rising_then_falling = simulate_two_cycles(true, false);
        const first = rising_then_falling.0;
        const second = rising_then_falling.1;
        assert first.q == true;
        assert compute_led_output(first) == false;
        assert second.q == true;
        assert second.clk_bufged == false;
        assert compute_led_output(second) == false;
        const held_high = simulate_two_cycles(true, true);
        const high_second = held_high.1;
        assert high_second.q == true;
        const held_low = simulate_two_cycles(false, false);
        const low_second = held_low.1;
        assert low_second.q == false;
    }

    test two_cycles_toggle {
        const cycles = simulate_two_cycles(false, true);
        const first = cycles.0;
        const second = cycles.1;
        assert first.q == false;
        assert first.clk_bufged == false;
        assert second.q == true;
        assert second.clk_bufged == true;
    }

    test four_cycles_sequence {
        const cycles = simulate_four_cycles(false, true, false, true);
        const s1 = cycles.0;
        const s2 = cycles.1;
        const s3 = cycles.2;
        const s4 = cycles.3;
        assert s1.q == false;
        assert s2.q == true;
        assert s3.q == true;
        assert s4.q == false;
        assert s1.clk_bufged == false;
        assert s2.clk_bufged == true;
        assert s3.clk_bufged == false;
        assert s4.clk_bufged == true;
    }

    test module_initial_output {
        const ports = trinity_top_module(ModulePorts{ .clk = false, .led = false });
        assert ports.clk == false;
        assert ports.led == true;
    }

    test debug_edge_detection {
        const state = FlipFlopState{ .q = false, .clk_bufged = false };
        const updated = update_flip_flop(state, true);
        assert updated.q == true;
        assert compute_led_output(updated) == false;
    }

    test module_with_rising_edge_debug {
        const low_led_input = trinity_top_module(ModulePorts{ .clk = true, .led = false });
        const high_led_input = trinity_top_module(ModulePorts{ .clk = true, .led = true });
        assert low_led_input.clk == true;
        assert low_led_input.led == false;
        assert high_led_input.led == false;
    }

    test module_with_rising_edge {
        const ports = trinity_top_module(ModulePorts{ .clk = true, .led = true });
        assert ports.clk == true;
        assert ports.led == false;
    }

    test module_no_edge {
        const ports = trinity_top_module(ModulePorts{ .clk = false, .led = false });
        assert ports.clk == false;
        assert ports.led == true;
    }

    test validation_functions {
        const state = FlipFlopState{ .q = true, .clk_bufged = false };
        const ports = ModulePorts{ .clk = true, .led = false };
        assert validate_ff_state(state) == 0;
        assert validate_module_ports(ports) == 0;
    }

    // === Invariants ===

    invariant ff_state_boolean {
        const low = FlipFlopState{ .q = false, .clk_bufged = false };
        const high = update_flip_flop(low, true);
        const held = update_flip_flop(high, false);
        assert high.q == true;
        assert held.q == high.q;
    }

    invariant led_complementarity {
        const low = FlipFlopState{ .q = false, .clk_bufged = false };
        const high = FlipFlopState{ .q = true, .clk_bufged = false };
        assert compute_led_output(low) != low.q;
        assert compute_led_output(high) != high.q;
    }

    invariant clock_buffer_consistency {
        assert buffer_clock(false) == false;
        assert buffer_clock(true) == true;
    }

    invariant module_ports_valid {
        const ports = ModulePorts{ .clk = true, .led = false };
        assert validate_module_ports(ports) == 0;
    }

    // Named host workloads; no measured physical latency is claimed.
    bench ff_state_update_latency {
        update_flip_flop(FlipFlopState{ .q = false, .clk_bufged = false }, true);
    }

    bench led_output_latency {
        compute_led_output(FlipFlopState{ .q = false, .clk_bufged = false });
    }

    bench trinity_top_compute_latency {
        trinity_top_module(ModulePorts{ .clk = true, .led = false });
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
