// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/d_blink_high.t27
//
// Port of fpga/openxc7-synth/d_blink_high.v (gHashTag/trinity @ 92e1d48d0399):
// "D21 LED blinking ~3 Hz (active-high test)"
//
// Original Verilog (quoted in full; the synthesizable body is lines 6-19):
//     //! Strand III: Language & Hardware Bridge
//     //!
//     //! FPGA component for Trinity SM-BM-3AI — synthesizable Verilog module.
//     //!
//
//     // D21 LED blinking ~3 Hz (active-high test)
//     module trinity_top (
//         input  wire clk,
//         output wire led
//     );
//         reg [24:0] counter = 25'd0;
//
//         always @(posedge clk) begin
//             counter <= counter + 1'b1;
//         end
//
//         // Blink ~3 Hz - NO inversion (active-high)
//         assign led = counter[24];
//     endmodule
//
// Port notes (issue #5660). The decisions the original hard-wires, carried
// as code with the same behavior and interface (input clk, output led):
//
//   * `reg [24:0] counter = 25'd0;` -- the module holds exactly one
//     free-running 25-bit register, initialized to 25'd0 (an FPGA initial
//     value; there is no reset input to model). HighBlinkState{ counter } is
//     that register, init_state() is its power-on value.
//   * `always @(posedge clk) counter <= counter + 1'b1;` -- every rising
//     (posedge) clock edge increments the counter by 1'b1. Because the
//     register is 25 bits wide, the sum is truncated back to 25 bits:
//     increment past 25'h1FFFFFF wraps around to 25'd0. next_state() is
//     that nonblocking next-state relation as a pure function; advance()
//     applies it for `cycles` consecutive clock edges, the way a
//     testbench would tick the clk input.
//   * `assign led = counter[24];` -- the led output taps the counter's
//     most significant bit, bit 24, and nothing else: NO inversion, the
//     comment's "(active-high)" note. led_output() is the wire's value:
//     the LED is lit exactly while bit 24 is 1 (high half of the count)
//     and dark while it is 0 (low half).
//   * "// Blink ~3 Hz" -- bit 24 stays low for 2^24 cycles and high for
//     2^24 cycles, so one full blink (dark -> lit -> dark) lasts
//     2^25 = 33_554_432 clock cycles. On the 100 MHz board clock that
//     assumption encodes, f = 100_000_000 / 2^25 = 2.98 Hz, which the
//     original rounds to ~3 Hz. blink_hz_x100()/approx_blink_hz() compute
//     that rate; a test pins it to the comment's ~3 Hz.
//
// Everything that touches the world -- the clk input -- enters as an
// argument (advance() takes the number of edges to apply), so no
// undefined; bodies are needed: the module is a pure next-state/output
// function of its state, and the tests assert the values the original
// computes, at reset, across posedges, at the bit-24 tap, at wraparound,
// over a full blink period, and in hertz.
//
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Constants: the register geometry of the original ===

    // reg [24:0] counter -- a 25-bit register (indices 24..0).
    const COUNTER_WIDTH : u32 = 25;

    // assign led = counter[24] -- the led output taps the MSB, bit 24.
    const LED_BIT : u32 = 24;

    // A 25-bit register saturates representation at 2^25 - 1; the
    // increment truncates back into 25 bits, so 25'h1FFFFFF + 1'b1
    // wraps around to 25'd0.
    const COUNTER_MASK : u32 = 0x1FFFFFF;

    // Bit 24 of the count is 0 for the first 2^24 cycles after wrap and
    // 1 for the next 2^24: one LED phase (dark or lit) per half period.
    const HALF_BLINK_CYCLES : u32 = 16_777_216;

    // One full blink -- LED dark, then lit, then dark again -- spans
    // 2^25 = 33_554_432 rising clock edges.
    const BLINK_PERIOD_CYCLES : u32 = 33_554_432;

    // The 100 MHz board clock the original's "~3 Hz" comment assumes:
    // 100_000_000 / 2^25 = 2.98 Hz, about 3 Hz. The original pins led to
    // LOC D21 (its title's "D21 LED"), driven active-high.
    const CLK_HZ : u64 = 100_000_000;

    // === State: the single register the original holds ===

    // Not named BlinkState: blink_correct and d6_blink use that name for
    // {counter, led}, and this top has no LED register (tri types ratchet,
    // #7437).
    struct HighBlinkState {
        counter : u32,
    }

    // reg [24:0] counter = 25'd0;
    // The power-on initial value: a fresh 25'd0 count.
    fn init_state() -> HighBlinkState {
        return HighBlinkState{ .counter = 0 };
    }

    // always @(posedge clk) counter <= counter + 1'b1;
    // The nonblocking next-state relation as a pure function: each
    // rising clock edge increments the counter by 1'b1, and the 25-bit
    // register truncates its own sum, wrapping 25'h1FFFFFF back to
    // 25'd0 instead of carrying into a 26th bit.
    fn next_state(state: HighBlinkState) -> HighBlinkState {
        var next : HighBlinkState = state;
        next.counter = (state.counter + 1) & COUNTER_MASK;
        return next;
    }

    // Apply `cycles` consecutive rising clock edges (posedge to posedge),
    // the way a testbench would drive the clk input; the free-running
    // register counts on every edge, enabling included.
    fn advance(state: HighBlinkState, cycles: u32) -> HighBlinkState {
        var cur : HighBlinkState = state;
        var i : u32 = 0;
        while (i < cycles) {
            cur = next_state(cur);
            i += 1;
        }
        return cur;
    }

    // assign led = counter[24];  -- NO inversion (active-high)
    // The led output is the counter's bit 24, verbatim: high (lit, the
    // D21 LED is active-high) exactly while the count is in its upper
    // half, and low (dark) in its lower half.
    fn led_output(state: HighBlinkState) -> bool {
        return ((state.counter >> LED_BIT) & 1) != 0;
    }

    // The led wire as a 1-bit value, the way a Verilog simulator prints
    // the output port: 1'b0 when dark, 1'b1 when lit.
    fn led_value(state: HighBlinkState) -> u32 {
        if (led_output(state)) {
            return 1;
        } else {
            return 0;
        }
    }

    // The original's comment says "NO inversion (active-high)": the
    // driver feeds counter[24] straight to the LED anode, not through
    // an inverter, so LED on == bit 24 high.
    fn is_active_high() -> bool {
        return true;
    }

    // Blink rate in hundredths of a hertz. One full blink is
    // BLINK_PERIOD_CYCLES = 2^25 clock cycles, so f = clk_hz / 2^25.
    fn blink_hz_x100(clk_hz: u64) -> u64 {
        return (clk_hz * 100) / 33_554_432;
    }

    // The "~" of "~3 Hz": the blink rate from blink_hz_x100(), rounded
    // to whole hertz (2.98 Hz -> 3 Hz on a 100 MHz clock).
    fn approx_blink_hz(clk_hz: u64) -> u64 {
        return (blink_hz_x100(clk_hz) + 50) / 100;
    }

    // === Tests: values the original module computes ===

    // reg [24:0] counter = 25'd0; assign led = counter[24];
    // At reset the count is 25'd0, so bit 24 is 0 and the LED is dark.
    test reset_holds_led_dark {
        let s = init_state();
        assert(s.counter == 0);
        assert(led_output(s) == false);
        assert(led_value(s) == 0);
    }

    // always @(posedge clk) counter <= counter + 1'b1;
    // Every posedge adds exactly 1'b1 to the register.
    test every_posedge_increments {
        let s0 = init_state();
        let s1 = next_state(s0);
        assert(s1.counter == 1);
        let s5 = advance(s0, 5);
        assert(s5.counter == 5);
    }

    // assign led = counter[24]; -- the tap is bit 24 and only bit 24:
    // the last dark count, the first lit count, and the count after it.
    test led_taps_counter_bit_24 {
        let below = HighBlinkState{ .counter = HALF_BLINK_CYCLES - 1 };
        let at = HighBlinkState{ .counter = HALF_BLINK_CYCLES };
        let above = HighBlinkState{ .counter = HALF_BLINK_CYCLES + 1 };
        assert(led_output(below) == false);
        assert(led_output(at) == true);
        assert(led_output(above) == true);
    }

    // "NO inversion (active-high)": the wire carries the bit itself,
    // never its complement, so the LED is lit while bit 24 is 1.
    test no_inversion_led_is_active_high {
        let lit = HighBlinkState{ .counter = 0x1000000 };
        let dark = HighBlinkState{ .counter = 0x0FFFFFF };
        assert(is_active_high() == true);
        assert(led_output(lit) == true);
        assert(led_output(dark) == false);
        assert(led_value(lit) == 1);
        assert(led_value(dark) == 0);
    }

    // The 25-bit register truncates its own increment: at the top of
    // the count, 25'h1FFFFFF + 1'b1 wraps around to 25'd0 and the LED,
    // fed by bit 24, falls dark again.
    test counter_wraps_around_at_25_bits {
        let full = HighBlinkState{ .counter = COUNTER_MASK };
        assert(led_output(full) == true);
        let next = next_state(full);
        assert(next.counter == 0);
        assert(led_output(next) == false);
    }

    // Tick the clock across bit 24's rising edge: two posedges after
    // 25'h0FFFFFE the count reaches 25'h1000000 and the LED is lit.
    test led_rises_halfway_through_the_count {
        let s = HighBlinkState{ .counter = HALF_BLINK_CYCLES - 2 };
        let e = advance(s, 2);
        assert(e.counter == HALF_BLINK_CYCLES);
        assert(led_output(e) == true);
    }

    // A full blink period from reset: after 2^24 edges the LED is lit
    // (upper half of the count); after 2^25 edges the free-running
    // register has wrapped back to 25'd0 and the LED is dark again.
    test full_blink_period_from_reset {
        let half = advance(init_state(), HALF_BLINK_CYCLES);
        assert(half.counter == HALF_BLINK_CYCLES);
        assert(led_output(half) == true);
        let full = advance(half, HALF_BLINK_CYCLES);
        assert(full.counter == 0);
        assert(led_output(full) == false);
    }

    // The geometry the original hard-wires: a 25-bit register, tapped
    // at bit 24 (width - 1, its MSB), wrapping at 2^25, toggling the
    // tap every 2^24.
    test counter_geometry {
        assert(COUNTER_WIDTH == 25);
        assert(LED_BIT == COUNTER_WIDTH - 1);
        assert(COUNTER_MASK == 33_554_431);
        assert(HALF_BLINK_CYCLES == 16_777_216);
        assert(BLINK_PERIOD_CYCLES == HALF_BLINK_CYCLES * 2);
    }

    // "// Blink ~3 Hz": on the 100 MHz board clock, 2^25 cycles of
    // period is 2.98 Hz -- blink_hz_x100 gives 298 (hundredths), and
    // the rounded rate is the comment's 3 Hz.
    test blink_rate_is_about_3_hz {
        assert(blink_hz_x100(CLK_HZ) == 298);
        assert(approx_blink_hz(CLK_HZ) == 3);
    }

    // === Invariants ===

    // The register always fits its 25-bit Verilog width: the counter is
    // 25'd0 at reset and never escapes the mask after any posedge.
    invariant counter_fits_25_bits
        given s = init_state()
        assert s.counter <= COUNTER_MASK

    // assign led = counter[24]; with the initial value 25'd0: the LED
    // starts dark, its wire reading 1'b0.
    invariant reset_led_dark
        given s = init_state()
        assert led_output(s) == false
        and led_value(s) == 0

    // The tap is the MSB, active-high: exactly at 2^24 the count enters
    // its upper half and the LED is lit.
    invariant tap_is_bit_24_active_high
        given lit = HighBlinkState{ .counter = HALF_BLINK_CYCLES }
        assert led_output(lit) == true
        and led_value(lit) == 1

    // The period arithmetic behind "~3 Hz": 2^25 cycles per full blink,
    // 2^24 per phase, the mask one below the period, the tap the MSB.
    invariant blink_period_is_two_halves
        assert BLINK_PERIOD_CYCLES == HALF_BLINK_CYCLES * 2
        and COUNTER_MASK == BLINK_PERIOD_CYCLES - 1
        and LED_BIT == COUNTER_WIDTH - 1
}
