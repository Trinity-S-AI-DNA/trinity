// SPDX-License-Identifier: Apache-2.0
// Port of gHashTag/trinity:fpga/openxc7-synth/multi_led_test.v (issue #6215).
// The original is a 24-bit free-running counter; each LED pin shows one bit of it,
// so the blink rates differ per pin: led0 = bit 23, led1 = bit 22, ... led5 = bit 18,
// led7 repeats bit 23 and led8 is tied low (M22 is not a valid LED).
module trinity_top {
    const COUNTER_MASK: u32 = 16777215; // 24 bits: 24'hFFFFFF

    // always @(posedge clk) counter <= counter + 1'b1, wrapping at 24 bits.
    fn counter_next(counter: u32) -> u32 {
        return (counter + 1) & COUNTER_MASK;
    }

    // assign ledN = counter[bit]; bit 23 is the slowest.
    fn led_from_bit(counter: u32, bit: u32) -> bool {
        return ((counter >> bit) & 1) == 1;
    }

    // assign led0 = counter[23]; assign led7 = counter[23] (same pin rate as T23).
    fn led0_level(counter: u32) -> bool {
        return led_from_bit(counter, 23);
    }

    fn led7_level(counter: u32) -> bool {
        return led_from_bit(counter, 23);
    }

    // assign led8 = 1'b0.
    fn led8_level() -> bool {
        return false;
    }

    test counter_counts_up {
        assert(counter_next(0) == 1);
        assert(counter_next(41) == 42);
    }

    test counter_wraps_at_24_bits {
        assert(counter_next(16777215) == 0);
    }

    test led0_follows_bit_23 {
        assert(!led_from_bit(8388607, 23));
        assert(led_from_bit(8388608, 23));
    }

    test led_rates_double_per_bit {
        // 262144 is bit 18 only: led5 high, led4 (bit 19) and led0 (bit 23) low.
        assert(led_from_bit(262144, 18));
        assert(!led_from_bit(262144, 19));
        assert(!led_from_bit(262144, 23));
    }

    test led7_repeats_led0 {
        assert(led7_level(0) == led0_level(0));
        assert(led7_level(8388608) == led0_level(8388608));
        assert(led7_level(8388608));
        assert(!led7_level(8388607));
    }

    test led8_is_always_off {
        assert(!led8_level());
    }
}
