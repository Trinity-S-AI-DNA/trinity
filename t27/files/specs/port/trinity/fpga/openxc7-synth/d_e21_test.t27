// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/d_e21_test.t27
// Trinity E21 Test Module - FPGA Synthesis Test
// Clock buffer with 24-bit counter and LED output
// Ports: clk (input), led (output)
// Uses BUFG global clock buffer and MSB LED indicator
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Module constants ===

    pub const COUNTER_WIDTH : u32 = 24;
    pub const COUNTER_RESET : u32 = 0;

    // === Counter state ===

    pub struct Counter {
        value : u32,
        width : u32,
    }

    // === Constructor functions ===

    fn create_counter(width: u32) -> Counter {
        return Counter{
            .value = COUNTER_RESET,
            .width = width,
        };
    }

    // === Counter functions ===

    fn increment_counter(counter: Counter, rising_edge: bool) -> Counter {
        var next_value : u32 = counter.value;
        if (rising_edge) {
            next_value = counter.value + 1;
        }
        return Counter{
            .value = next_value,
            .width = counter.width,
        };
    }

    fn get_msb(counter: Counter) -> bool {
        if (counter.width == 0) {
            return false;
        }
        var msb_pos : u32 = counter.width - 1;
        var mask : u32 = 1 << msb_pos;
        return (counter.value & mask) != 0;
    }

    // === LED output functions ===

    fn compute_led(counter: Counter) -> bool {
        return get_msb(counter);
    }

    // === Validation functions ===

    fn validate_counter_width(width: u32) -> bool {
        return width > 0 and width <= 64;
    }

    // === Tests ===

    test create_counter_ok
        given counter = create_counter(24)
        then counter.value == 0
        and counter.width == 24

    test counter_increment_rising_edge
        given initial = create_counter(24)
        and result = increment_counter(initial, true)
        then result.value == 1
        and result.width == 24

    test counter_no_increment_falling_edge
        given initial = create_counter(24)
        and result = increment_counter(initial, false)
        then result.value == 0
        and result.width == 24

    test counter_msb_24bit
        given counter1 = Counter{.value = 0, .width = 24}
        and counter2 = Counter{.value = 0x800000, .width = 24}
        and counter3 = Counter{.value = 0xFFFFFF, .width = 24}
        then get_msb(counter1) == false
        and get_msb(counter2) == true
        and get_msb(counter3) == true

    test led_output_from_counter
        given counter = Counter{.value = 0x800000, .width = 24}
        then compute_led(counter) == true

    test validate_counter_width_ok
        then validate_counter_width(24) == true

    test validate_counter_width_zero
        then validate_counter_width(0) == false

    test validate_counter_width_too_large
        then validate_counter_width(65) == false

    // === Invariants ===

    invariant counter_width_positive
        given counter = create_counter(24)
        assert counter.width > 0

    invariant msb_bounds_check
        given counter = Counter{.value = 0x800000, .width = 24}
        assert get_msb(counter) == true or get_msb(counter) == false

    invariant counter_increment_preserves_width
        given initial = create_counter(24)
        and result = increment_counter(initial, true)
        assert result.width == initial.width

    invariant led_consistent_with_msb
        given counter = Counter{.value = 0x800000, .width = 24}
        assert compute_led(counter) == get_msb(counter)
}

// phi^2 + 1/phi^2 = 3 | TRINITY