// SPDX-License-Identifier: Apache-2.0
// Original: gHashTag/trinity@fd276ca7f6b5, fpga/openxc7-synth/clk_test.v.
// The original computes led = clk; a level alone cannot detect oscillation.
module trinity_top {
    // The continuously driven result maps to original led. clock_level is
    // distinct from backend control clk; brightness and frequency are not outputs.
    fn on_comb(clock_level: bool) -> bool {
        return clock_level;
    }

    test high_clock_drives_high_led {
        assert(on_comb(true));
    }

    test low_clock_drives_low_led {
        assert(!on_comb(false));
    }

    test repeated_levels_do_not_toggle_output {
        assert(!on_comb(false));
        assert(!on_comb(false));
        assert(on_comb(true));
        assert(on_comb(true));
        assert(!on_comb(false));
    }

    invariant both_binary_levels_pass_through {
        assert(on_comb(false) == false);
        assert(on_comb(true) == true);
    }
}
