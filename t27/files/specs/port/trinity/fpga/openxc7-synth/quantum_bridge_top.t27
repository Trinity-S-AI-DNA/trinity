// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/quantum_bridge_top.t27
// Port of gHashTag/trinity fpga/openxc7-synth/quantum_bridge_top.v
//
// Top module of the quantum_bridge project: a 50 MHz clock feeds a
// quantum_bridge core; output wire led (D5, J19) is active low.
//
// The core is fed a HARDCODED QUANTUM STATE = VIOLATION (2'b01) — VIOLATION
// MODE! To explore the other modes, change to 2'b00 for separable, 2'b10 for
// zero, 2'b11 for negative. The button (input wire rst_n) is ignored: the
// module ties its own reset to VCC for auto-start.
//
// Uses u8 widths only. A u2 local initialised from a u8 is a landmine: it
// narrows silently at parse time and breaks the generated Zig with
// "expected type 'u2', found 'u8'" as soon as the simulation body is
// analysed with runtime values.
// phi^2 + 1/phi^2 = 3 | TRINITY

module quantum_bridge_top {

    // === Module constants (from the original's header comments) ===

    pub const CLK_MHZ : u32 = 50;              // input wire clk — 50 MHz
    pub const LED_ACTIVE_LOW : u8 = 1;         // output wire led — D5 (J19), active low

    // QUANTUM STATE encoding (2-bit code in the original, widened to u8)
    pub const STATE_SEPARABLE : u8 = 0b00;     // 2'b00 — separable
    pub const STATE_VIOLATION : u8 = 0b01;     // 2'b01 — violation (the hardcoded mode)
    pub const STATE_ZERO : u8 = 0b10;          // 2'b10 — zero
    pub const STATE_NEGATIVE : u8 = 0b11;      // 2'b11 — negative

    // === Input/Output types ===

    // Not named Inputs: the other openxc7-synth tops use that name for {clk},
    // and this top also takes rst_n (tri types ratchet, #7437).
    pub struct BridgeInputs {
        clk : bool,        // input wire clk — 50 MHz
        rst_n : bool,      // input wire rst_n — active low button, tied to VCC for auto-start
    }

    pub struct Outputs {
        led : bool,        // output wire led — D5 (J19), active low
    }

    // === Port record constructors ===

    fn inputs(clk: bool, rst_n: bool) -> BridgeInputs {
        return BridgeInputs{ .clk = clk, .rst_n = rst_n };
    }

    fn outputs(led: bool) -> Outputs {
        return Outputs{ .led = led };
    }

    // === The module's two decisions, as code ===

    // Hardcoded QUANTUM STATE = VIOLATION (2'b01) — VIOLATION MODE! Change to
    // STATE_SEPARABLE (2'b00), STATE_ZERO (2'b10) or STATE_NEGATIVE (2'b11)
    // for the other modes.
    fn quantum_state() -> u8 {
        return STATE_VIOLATION;
    }

    // Pull reset high (disabled) for auto-start: the core never waits for the
    // button.
    fn rst_n_internal() -> u8 {
        return 1;
    }

    // The external button (input wire rst_n) never reaches the core: it is
    // tied to VCC for auto-start.
    fn uses_external_reset() -> bool {
        return false;
    }

    // === Mode predicates (the original's encoding table as code) ===

    fn is_separable(state: u8) -> bool {
        return state == STATE_SEPARABLE;
    }

    fn is_violation(state: u8) -> bool {
        return state == STATE_VIOLATION;
    }

    fn is_zero(state: u8) -> bool {
        return state == STATE_ZERO;
    }

    fn is_negative(state: u8) -> bool {
        return state == STATE_NEGATIVE;
    }

    // === LED polarity ===

    // output wire led — D5 (J19) is active low: the lamp lights when the wire
    // is driven to 0 and goes dark at 1.
    fn led_level(lit: bool) -> u8 {
        if (lit) {
            return 0;
        }
        return 1;
    }

    // === Combinational surface for t27c gen-verilog ===

    // `rst_n_external` becomes an input, the returned wire level becomes
    // `result`. The button level never reaches the core: reset is tied to VCC
    // for auto-start, so the core's reset line is 1'b1 whatever the button
    // carries.
    fn on_comb(rst_n_external: u8) -> u8 {
        if (uses_external_reset()) {
            return rst_n_external;
        }
        return 1;
    }

    // === Tests ===

    test quantum_state_hardcoded {
        assert(quantum_state() == STATE_VIOLATION);
        assert(quantum_state() == 1);
        assert(is_violation(quantum_state()));
    }

    test mode_encoding {
        assert(STATE_SEPARABLE == 0);
        assert(STATE_VIOLATION == 1);
        assert(STATE_ZERO == 2);
        assert(STATE_NEGATIVE == 3);
        assert(is_separable(0));
        assert(is_violation(1));
        assert(is_zero(2));
        assert(is_negative(3));
    }

    test reset_tied_high_for_auto_start {
        assert(rst_n_internal() == 1);
        assert(!uses_external_reset());
        assert(on_comb(0) == 1);
        assert(on_comb(1) == 1);
    }

    test led_active_low {
        assert(led_level(true) == 0);
        assert(led_level(false) == 1);
        assert(LED_ACTIVE_LOW == 1);
    }

    test port_records {
        const i : BridgeInputs = inputs(true, false);
        assert(i.clk);
        assert(i.rst_n == false);
        const o : Outputs = outputs(true);
        assert(o.led);
        const o_dark : Outputs = outputs(false);
        assert(o_dark.led == false);
    }

    // === Benchmarks ===

bench quantum_state_latency {
    assert(quantum_state() == STATE_VIOLATION);
}

bench reset_tie_latency {
    assert(on_comb(0) == 1);
}

    // === Invariants (checked at compile time) ===

    invariant state_encoding_valid {
        assert(STATE_SEPARABLE == 0);
        assert(STATE_VIOLATION == 1);
        assert(STATE_ZERO == 2);
        assert(STATE_NEGATIVE == 3);
    }

    invariant led_is_active_low {
        assert(LED_ACTIVE_LOW == 1);
        assert(led_level(true) == 0);
        assert(led_level(false) == 1);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
