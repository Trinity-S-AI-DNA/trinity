// t27/specs/port/trinity/fpga/openxc7-synth/blink_minimal.t27
// BLINK MINIMAL — Simplest possible blink test
// Uses direct clock division with minimal logic
// If this doesn't work, the clock itself is the problem
// Ported from gHashTag/trinity fpga/openxc7-synth/blink_minimal.v
// phi^2 + 1/phi^2 = 3 | TRINITY

module blink_minimal {

    // === Module constants ===

    pub const CLOCK_FREQ_MHZ : u32 = 50;
    pub const FAST_DIV_WIDTH : u32 = 24;
    pub const SLOW_DIV_WIDTH : u32 = 26;
    pub const FAST_DIV_MSB : u32 = 23;
    pub const SLOW_DIV_MSB : u32 = 25;

    // === Input/Output types ===

    pub struct Inputs {
        clk : bool,
    }

    pub struct Outputs {
        t23 : bool,  // Right LED D6
        r23 : bool,  // Left LED D5
    }

    // === Constructor helpers ===

    fn inputs(clk: bool) -> Inputs {
        return Inputs{ .clk = clk };
    }

    fn outputs(t23: bool, r23: bool) -> Outputs {
        return Outputs{ .t23 = t23, .r23 = r23 };
    }

    // === Core logic ===

    fn compute_outputs(fast_div_msb: bool, slow_div_msb: bool) -> Outputs {
        const t23_value : bool = fast_div_msb;
        const r23_value : bool = slow_div_msb;
        return outputs(t23_value, r23_value);
    }

    // === Test functions ===

    test initial_state {
        const result = compute_outputs(false, false);
        assert result.t23 == false;
        assert result.r23 == false;
    }

    test fast_div_msb {
        const result = compute_outputs(true, false);
        assert result.t23 == true;
        assert result.r23 == false;
    }

    test slow_div_msb {
        const result = compute_outputs(false, true);
        assert result.t23 == false;
        assert result.r23 == true;
    }

    test both_msb {
        const result = compute_outputs(true, true);
        assert result.t23 == true;
        assert result.r23 == true;
    }

    test input_creation {
        const input = inputs(true);
        assert input.clk == true;
        
        const input_false = inputs(false);
        assert input_false.clk == false;
    }

    test output_creation {
        const result = outputs(true, false);
        assert result.t23 == true;
        assert result.r23 == false;
        
        const result_false = outputs(false, true);
        assert result_false.t23 == false;
        assert result_false.r23 == true;
    }

    // === Invariants ===

    invariant counter_widths_positive {
        assert FAST_DIV_WIDTH == 24;
        assert SLOW_DIV_WIDTH == 26;
        assert FAST_DIV_MSB == 23;
        assert SLOW_DIV_MSB == 25;
    }

    invariant msb_positions_valid {
        assert FAST_DIV_MSB < FAST_DIV_WIDTH;
        assert SLOW_DIV_MSB < SLOW_DIV_WIDTH;
    }

    invariant clock_frequency_positive {
        assert CLOCK_FREQ_MHZ > 0;
    }

    invariant msb_is_less_than_width {
        assert FAST_DIV_MSB < FAST_DIV_WIDTH;
        assert SLOW_DIV_MSB < SLOW_DIV_WIDTH;
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY