// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/d_static_on.t27
// Static ON LED driver for Trinity S³AI — synthesizable Verilog module
// Active-low LED output with constant ON state
// Original: assign led = 1'b0;  // Active-low = ON
// Uses flat arrays + count fields (parser-compatible)
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === LED driver configuration ===

    pub struct LedConfig {
        name : &str,
        is_active_low : bool,
        default_state : bool,
    }

    fn led_config(name: &str) -> LedConfig {
        return LedConfig{
            .name = name,
            .is_active_low = true,
            .default_state = true,
        };
    }

    // === LED state computation ===

    fn led_output(cfg: LedConfig) -> bool {
        // Original: assign led = 1'b0;  // Active-low = ON
        // For active-low LED: 1'b0 = ON, 1'b1 = OFF
        // Static ON state means always return true for active-low ON
        return cfg.default_state;
    }

    fn led_value(cfg: LedConfig) -> u32 {
        // Convert boolean to 1-bit Verilog value
        // Original: assign led = 1'b0;
        if (led_output(cfg)) {
            return 0;  // 1'b0 for active-low ON (matches original)
        } else {
            return 1;  // 1'b1 for active-low OFF
        }
    }

    // === Validation ===

    fn validate_led_config(cfg: LedConfig) -> u32 {
        var errors : u32 = 0;
        if (cfg.name == "") {
            errors = errors + 1;
        }
        return errors;
    }

    // === Tests ===

    test led_config_creation
        given cfg = led_config("static_on_led")
        then cfg.name == "static_on_led"
        and cfg.is_active_low == true
        and cfg.default_state == true

    test led_output_static_on
        given cfg = led_config("static_on_led")
        then led_output(cfg) == true
        and led_value(cfg) == 0  // 1'b0 matches original assign led = 1'b0;

    test led_value_matches_original
        given cfg = led_config("static_on_led")
        then led_value(cfg) == 0  // Verifies exact match with original: assign led = 1'b0;

    test led_config_validation_ok
        given cfg = led_config("static_on_led")
        then validate_led_config(cfg) == 0

    test led_config_validation_empty_name
        given cfg = LedConfig{.name = "", .is_active_low = true, .default_state = true}
        then validate_led_config(cfg) > 0

    // === Invariants ===

    invariant led_config_name_non_empty
        given cfg = led_config("inv")
        assert cfg.name != ""

    invariant led_value_is_0_or_1
        given cfg = led_config("inv")
        assert led_value(cfg) == 0 or led_value(cfg) == 1

    invariant led_output_consistent
        given cfg = led_config("inv")
        assert led_output(cfg) == led_config("inv").default_state

    // === Benchmarks ===

    bench led_output_latency
        measure: nanoseconds to led_output(led_config("bench"))
        target: < 10ns

    bench led_value_latency
        measure: nanoseconds to led_value(led_config("bench"))
        target: < 10ns
}

// phi^2 + 1/phi^2 = 3 | TRINITY