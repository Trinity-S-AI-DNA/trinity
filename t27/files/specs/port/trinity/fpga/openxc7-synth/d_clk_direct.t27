// Original: gHashTag/trinity@3204243868d9, fpga/openxc7-synth/d_clk_direct.v.
// Binary signal model of the original continuous assignment: led = clk.
module trinity_top {
    // clock_level is the diagnostic signal; the backend's clk/rst_n/en are
    // separate control ports. The continuous result wire maps to original led.
    fn on_comb(clock_level: bool) -> bool {
        return clock_level;
    }

    test on_comb_passes_through_true {
        assert(on_comb(true));
    }

    test on_comb_passes_through_false {
        assert(!on_comb(false));
    }

    invariant both_binary_levels_pass_through {
        assert(on_comb(true) == true);
        assert(on_comb(false) == false);
    }
}
