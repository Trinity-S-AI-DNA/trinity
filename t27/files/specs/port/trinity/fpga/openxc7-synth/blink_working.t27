// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/blink_working.t27
// Blink Working LED Module Specification for Trinity T27 FPGA HIR
// Port of gHashTag/trinity fpga/openxc7-synth/blink_working.v
// 50MHz clock with 26-bit counter driving two LEDs at different rates
// Uses flat arrays + count fields (parser-compatible)
// phi^2 + 1/phi^2 = 3 | TRINITY

module blink_working {

    // === Clock and LED pin definitions ===

    pub struct BlinkConfig {
        clock_mhz : u32,
        counter_width : u32,
        fast_led_bit : u32,
        slow_led_bit : u32,
    }

    pub struct BlinkWorkingState {
        counter : u64,
        t23_output : bool,
        r23_output : bool,
    }

    pub struct BlinkInputs {
        clk_in : bool,
    }

    pub struct BlinkOutputs {
        t23 : bool,
        r23 : bool,
    }

    // === Configuration constants ===

    pub const BLINK_CONFIG : BlinkConfig = BlinkConfig{
        .clock_mhz = 50,
        .counter_width = 26,
        .fast_led_bit = 22,
        .slow_led_bit = 24,
    }

    pub const COUNTER_MAX : u64 = (1 << 26) - 1;  // 26-bit counter max value

    // === Constructor functions ===

    fn blink_config(clock_mhz: u32, counter_width: u32, fast_bit: u32, slow_bit: u32) -> BlinkConfig {
        return BlinkConfig{
            .clock_mhz = clock_mhz,
            .counter_width = counter_width,
            .fast_led_bit = fast_bit,
            .slow_led_bit = slow_bit,
        };
    }

    fn blink_state() -> BlinkWorkingState {
        return BlinkWorkingState{
            .counter = 0,
            .t23_output = false,
            .r23_output = false,
        };
    }

    fn blink_inputs(clk: bool) -> BlinkInputs {
        return BlinkInputs{
            .clk_in = clk,
        };
    }

    fn blink_outputs(t23: bool, r23: bool) -> BlinkOutputs {
        return BlinkOutputs{
            .t23 = t23,
            .r23 = r23,
        };
    }

    // === Counter functions ===

    fn counter_period_mhz(config: BlinkConfig) -> u32 {
        return config.clock_mhz;
    }

    fn counter_period_ns(config: BlinkConfig) -> u32 {
        return 1000 / config.clock_mhz;
    }

    fn is_counter_overflow(config: BlinkConfig, counter: u64) -> bool {
        return counter >= COUNTER_MAX;
    }

    fn increment_counter(config: BlinkConfig, counter: u64) -> u64 {
        if (is_counter_overflow(config, counter)) {
            return 0;
        }
        return counter + 1;
    }

    // === LED output functions ===

    fn compute_fast_led(config: BlinkConfig, counter: u64) -> bool {
        var bit_mask : u64 = 1 << config.fast_led_bit;
        return (counter & bit_mask) != 0;
    }

    fn compute_slow_led(config: BlinkConfig, counter: u64) -> bool {
        var bit_mask : u64 = 1 << config.slow_led_bit;
        return (counter & bit_mask) != 0;
    }

    // === State update function ===

    fn update_blink_state(config: BlinkConfig, current_state: BlinkWorkingState, inputs: BlinkInputs) -> BlinkWorkingState {
        var new_counter : u64 = increment_counter(config, current_state.counter);
        var new_t23 : bool = compute_fast_led(config, new_counter);
        var new_r23 : bool = compute_slow_led(config, new_counter);
        
        return BlinkWorkingState{
            .counter = new_counter,
            .t23_output = new_t23,
            .r23_output = new_r23,
        };
    }

    // === Output computation function ===

    fn compute_outputs(config: BlinkConfig, state: BlinkWorkingState) -> BlinkOutputs {
        return BlinkOutputs{
            .t23 = state.t23_output,
            .r23 = state.r23_output,
        };
    }

    // === Clock buffer simulation ===

    fn simulate_bufg(inputs: BlinkInputs) -> BlinkInputs {
        // In the original Verilog, BUFG is a Xilinx primitive that buffers the clock
        // For simulation purposes, we just pass the clock through with ideal behavior
        return inputs;
    }

    // === Validation functions ===

    fn validate_config(config: BlinkConfig) -> u32 {
        var errors : u32 = 0;
        if (config.clock_mhz == 0) {
            errors = errors + 1;
        }
        if (config.counter_width == 0) {
            errors = errors + 1;
        }
        if (config.fast_led_bit >= config.counter_width) {
            errors = errors + 1;
        }
        if (config.slow_led_bit >= config.counter_width) {
            errors = errors + 1;
        }
        return errors;
    }

    fn validate_state(state: BlinkWorkingState) -> u32 {
        var errors : u32 = 0;
        if (state.counter > COUNTER_MAX) {
            errors = errors + 1;
        }
        return errors;
    }

    // === Tests ===

    test config_creation
        given cfg = blink_config(50, 26, 22, 24)
        then cfg.clock_mhz == 50
        and cfg.counter_width == 26
        and cfg.fast_led_bit == 22
        and cfg.slow_led_bit == 24
        and validate_config(cfg) == 0

    test counter_period
        given cfg = blink_config(50, 26, 22, 24)
        then counter_period_mhz(cfg) == 50
        and counter_period_ns(cfg) == 20

    test counter_increment
        given cfg = blink_config(50, 26, 22, 24)
        then increment_counter(cfg, 0) == 1
        and increment_counter(cfg, 100) == 101
        and increment_counter(cfg, COUNTER_MAX - 1) == COUNTER_MAX
        and increment_counter(cfg, COUNTER_MAX) == 0  // 26-bit wrap, as reg [25:0] counter + 1

    test led_outputs
        given cfg = blink_config(50, 26, 22, 24)
        then compute_fast_led(cfg, 0) == false
        and compute_fast_led(cfg, 1 << 22) == true
        and compute_slow_led(cfg, 0) == false
        and compute_slow_led(cfg, 1 << 24) == true

    test state_update
        given cfg = blink_config(50, 26, 22, 24)
        and state = blink_state()
        and inputs = blink_inputs(true)
        then update_blink_state(cfg, state, inputs).counter == 1

    test output_computation
        given cfg = blink_config(50, 26, 22, 24)
        and state = BlinkWorkingState{ .counter = 1 << 22, .t23_output = true, .r23_output = false }
        then compute_outputs(cfg, state).t23 == true
        and compute_outputs(cfg, state).r23 == false

    test bufg_simulation
        given inputs = blink_inputs(true)
        then simulate_bufg(inputs).clk_in == true

    test config_validation
        given cfg1 = blink_config(50, 26, 22, 24)
        and cfg2 = blink_config(0, 26, 22, 24)
        and cfg3 = blink_config(50, 26, 30, 24)  // invalid bit position
        then validate_config(cfg1) == 0
        and validate_config(cfg2) > 0
        and validate_config(cfg3) > 0

    test state_validation
        given state1 = blink_state()
        and state2 = BlinkWorkingState{ .counter = COUNTER_MAX, .t23_output = false, .r23_output = false }
        and state3 = BlinkWorkingState{ .counter = COUNTER_MAX + 1, .t23_output = false, .r23_output = false }
        then validate_state(state1) == 0
        and validate_state(state2) == 0
        and validate_state(state3) > 0

    test counter_overflow_detection
        given cfg = blink_config(50, 26, 22, 24)
        then is_counter_overflow(cfg, COUNTER_MAX - 1) == false
        and is_counter_overflow(cfg, COUNTER_MAX) == true
        and is_counter_overflow(cfg, COUNTER_MAX + 1) == true

    // === Invariants ===

    invariant config_valid
        given cfg = blink_config(50, 26, 22, 24)
        assert validate_config(cfg) == 0

    invariant state_valid
        given state = blink_state()
        assert validate_state(state) == 0

    invariant counter_bounded {
        assert blink_state().counter <= COUNTER_MAX;
        assert increment_counter(blink_config(50, 26, 22, 24), COUNTER_MAX) <= COUNTER_MAX;
    }

    invariant leds_start_off {
        assert compute_outputs(blink_config(50, 26, 22, 24), blink_state()).t23 == false;
        assert compute_outputs(blink_config(50, 26, 22, 24), blink_state()).r23 == false;
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY