// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/d6_inv_test.t27
// Test with inverted output for Trinity S³AI — synthesizable Verilog module
// Simple LED driver with constant high output (active-high)
// Uses flat arrays + count fields (parser-compatible)
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Signal definitions ===

    pub struct ClockSignal {
        name : &str,
        frequency_hz : u32,
    }

    pub struct LedSignal {
        name : &str,
        is_active_high : bool,
        current_state : bool,
    }

    // === Configuration ===

    fn clock_signal(name: &str, freq: u32) -> ClockSignal {
        return ClockSignal{
            .name = name,
            .frequency_hz = freq,
        };
    }

    fn led_signal(name: &str, active_high: bool) -> LedSignal {
        return LedSignal{
            .name = name,
            .is_active_high = active_high,
            .current_state = false,
        };
    }

    // === LED output computation ===

    fn led_output_constant() -> bool {
        // Original: assign led = 1'b1;
        // Always return true (1'b1) for active-high LED ON
        return true;
    }

    fn update_led_state(led: LedSignal) -> LedSignal {
        var updated : LedSignal = led;
        updated.current_state = led_output_constant();
        return updated;
    }

    fn get_verilog_value(led: LedSignal) -> u32 {
        // Convert boolean to 1-bit Verilog value
        if (led.current_state) {
            return 1;  // 1'b1
        } else {
            return 0;  // 1'b0
        }
    }

    fn is_led_on(led: LedSignal) -> bool {
        // For active-high LED: true = ON, false = OFF
        return led.current_state;
    }

    // === Validation ===

    fn validate_clock_signal(clk: ClockSignal) -> u32 {
        var errors : u32 = 0;
        if (clk.name == "") {
            errors = errors + 1;
        }
        if (clk.frequency_hz == 0) {
            errors = errors + 1;
        }
        return errors;
    }

    fn validate_led_signal(led: LedSignal) -> u32 {
        var errors : u32 = 0;
        if (led.name == "") {
            errors = errors + 1;
        }
        return errors;
    }

    // === Tests ===

    test clock_signal_creation
        given clk = clock_signal("clk", 1000000)
        then clk.name == "clk"
        and clk.frequency_hz == 1000000

    test led_signal_creation
        given led = led_signal("led", true)
        then led.name == "led"
        and led.is_active_high == true
        and led.current_state == false

    test led_output_constant_high
        then led_output_constant() == true

    test update_led_state_to_high
        given led = led_signal("led", true)
        then update_led_state(led).current_state == true

    test get_verilog_value_high
        given led = LedSignal{.name = "led", .is_active_high = true, .current_state = true}
        then get_verilog_value(led) == 1

    test get_verilog_value_low
        given led = LedSignal{.name = "led", .is_active_high = true, .current_state = false}
        then get_verilog_value(led) == 0

    test is_led_on_active_high
        given led = LedSignal{.name = "led", .is_active_high = true, .current_state = true}
        then is_led_on(led) == true

    test is_led_off_active_high
        given led = LedSignal{.name = "led", .is_active_high = true, .current_state = false}
        then is_led_on(led) == false

    test validate_clock_ok
        given clk = clock_signal("clk", 50000000)
        then validate_clock_signal(clk) == 0

    test validate_clock_empty_name
        given clk = ClockSignal{.name = "", .frequency_hz = 1000000}
        then validate_clock_signal(clk) > 0

    test validate_clock_zero_freq
        given clk = ClockSignal{.name = "clk", .frequency_hz = 0}
        then validate_clock_signal(clk) > 0

    test validate_led_ok
        given led = led_signal("led", true)
        then validate_led_signal(led) == 0

    test validate_led_empty_name
        given led = LedSignal{.name = "", .is_active_high = true, .current_state = false}
        then validate_led_signal(led) > 0

    // === Invariants ===

    invariant clock_name_non_empty
        given clk = clock_signal("inv", 1000000)
        assert clk.name != ""

    invariant clock_frequency_positive
        given clk = clock_signal("inv", 1000000)
        assert clk.frequency_hz > 0

    invariant led_name_non_empty
        given led = led_signal("inv", true)
        assert led.name != ""

    invariant led_state_is_boolean
        given led = led_signal("inv", true)
        assert led.current_state == true or led.current_state == false

    invariant verilog_value_is_0_or_1
        given led = LedSignal{.name = "inv", .is_active_high = true, .current_state = true}
        assert get_verilog_value(led) == 0 or get_verilog_value(led) == 1

    // === Benchmarks ===

    bench led_output_constant_latency
        measure: nanoseconds to led_output_constant()
        target: < 5ns

    bench led_update_latency
        measure: nanoseconds to update_led_state(led_signal("bench", true))
        target: < 10ns

    bench validation_latency
        measure: nanoseconds to validate_led_signal(led_signal("bench", true))
        target: < 10ns
}

// phi^2 + 1/phi^2 = 3 | TRINITY