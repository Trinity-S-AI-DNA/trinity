// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/d_g22_test.t27
// G22 Test module for Trinity S³AI — synthesizable Verilog module
// Clock buffering with 24-bit counter and LED output
// Active-low LED driven by counter[23] inversion
// Uses flat arrays + count fields (parser-compatible)
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Clock and counter configuration ===

    pub struct CounterConfig {
        width : u32,
        initial_value : u32,
    }

    pub struct LedConfig {
        is_active_low : bool,
        bit_position : u32,
    }

    fn counter_config(width: u32) -> CounterConfig {
        return CounterConfig{
            .width = width,
            .initial_value = 0,
        };
    }

    fn led_config() -> LedConfig {
        return LedConfig{
            .is_active_low = true,
            .bit_position = 23,
        };
    }

    // === Clock buffer simulation ===

    fn buffer_clock(clk: bool) -> bool {
        // Simulates BUFG behavior: passes clock through with minimal delay
        return clk;
    }

    // === Counter computation ===

    fn next_counter(current: u32, width: u32) -> u32 {
        // Increment counter, wrapping around at bit width
        var max_val : u32 = 1;
        var i : u32 = 0;
        while (i < width) {
            max_val = max_val * 2;
            i = i + 1;
        }
        max_val = max_val - 1;
        
        var next : u32 = current + 1;
        if (next > max_val) {
            return 0;
        }
        return next;
    }

    fn counter_bit_value(counter: u32, bit_pos: u32) -> bool {
        // Extract specific bit from counter (0 = LSB)
        var mask : u32 = 1;
        var bit_i : u32 = 0;
        while (bit_i < bit_pos) {
            mask = mask * 2;
            bit_i = bit_i + 1;
        }
        return (counter & mask) != 0;
    }

    // === LED output computation ===

    fn led_output(counter: u32, cfg: LedConfig) -> bool {
        var bit_val : bool = counter_bit_value(counter, cfg.bit_position);
        if (cfg.is_active_low) {
            return !bit_val;  // Invert for active-low
        } else {
            return bit_val;   // Direct for active-high
        }
    }

    // === Simulation helpers ===

    fn simulate_counter_cycles(clk_freq_hz: u32, cycles: u32) -> u32 {
        // Simulate counter advancing over given number of cycles
        var sim_counter : u32 = 0;
        var sim_i : u32 = 0;
        while (sim_i < cycles) {
            sim_counter = next_counter(sim_counter, 24);
            sim_i = sim_i + 1;
        }
        return sim_counter;
    }

    fn led_after_cycles(clk_freq_hz: u32, cycles: u32, cfg: LedConfig) -> bool {
        var after_counter : u32 = simulate_counter_cycles(clk_freq_hz, cycles);
        return led_output(after_counter, cfg);
    }

    // === Validation ===

    fn validate_counter_config(cfg: CounterConfig) -> u32 {
        var counter_errors : u32 = 0;
        if (cfg.width == 0) {
            counter_errors = counter_errors + 1;
        }
        if (cfg.width > 64) {  // Reasonable upper limit
            counter_errors = counter_errors + 1;
        }
        return counter_errors;
    }

    fn validate_led_config(cfg: LedConfig) -> u32 {
        var led_errors : u32 = 0;
        if (cfg.bit_position >= 24) {  // 24-bit counter
            led_errors = led_errors + 1;
        }
        return led_errors;
    }

    // === Tests ===

    test counter_config_creation
        given cfg = counter_config(24)
        then cfg.width == 24
        and cfg.initial_value == 0

    test next_counter_increment
        given cfg = counter_config(24)
        then next_counter(0, cfg.width) == 1
        and next_counter(1, cfg.width) == 2
        and next_counter(255, cfg.width) == 256

    test next_counter_wrap_around
        given cfg = counter_config(24)
        then next_counter(16777215, 24) == 0    // 2^24 - 1 = 16777215
        and next_counter(16777214, 24) == 16777215

    test counter_bit_value_lsb
        then counter_bit_value(1, 0) == true
        and counter_bit_value(2, 0) == false

    test counter_bit_value_msb_24bit
        given cfg = counter_config(24)
        then counter_bit_value(16777215, 23) == true    // MSB of max value (0xFFFFFF)
        and counter_bit_value(8388607, 23) == false    // MSB of half-range value (0x7FFFFF)

    test led_output_active_low
        given cfg = led_config()
        then led_output(0, cfg) == true    // counter[23] = 0, led = ~0 = 1 (ON)
        and led_output(0x800000, cfg) == false  // counter[23] = 1, led = ~1 = 0 (OFF)

    test led_output_active_high
        given cfg = LedConfig{.is_active_low = false, .bit_position = 23}
        then led_output(0, cfg) == false   // counter[23] = 0, led = 0 (OFF)
        and led_output(0x800000, cfg) == true  // counter[23] = 1, led = 1 (ON)

    test simulate_counter_cycles_small
        given cfg = counter_config(24)
        then simulate_counter_cycles(1000000, 10) == 10
        and simulate_counter_cycles(1000000, 0) == 0

    test simulate_counter_cycles_large
        given cfg = counter_config(24)
        then simulate_counter_cycles(1000000, 16777216) == 0  // Full wrap around

    test led_after_cycles_toggle
        given cfg = led_config()
        then led_after_cycles(1000000, 0, cfg) == true     // Initial state: ON
        and led_after_cycles(1000000, 8388608, cfg) == false  // After 2^23 cycles: OFF
        and led_after_cycles(1000000, 16777216, cfg) == true  // After 2^24 cycles: ON again

    test validate_counter_ok
        given cfg = counter_config(24)
        then validate_counter_config(cfg) == 0

    test validate_counter_zero_width
        given cfg = counter_config(0)
        then validate_counter_config(cfg) > 0

    test validate_led_ok
        given cfg = led_config()
        then validate_led_config(cfg) == 0

    test validate_led_invalid_bit
        given cfg = LedConfig{.is_active_low = true, .bit_position = 24}
        then validate_led_config(cfg) > 0

    // === Invariants ===

    invariant counter_width_positive
        given cfg = counter_config(24)
        assert cfg.width > 0

    invariant counter_width_reasonable
        given cfg = counter_config(24)
        assert cfg.width <= 64

    invariant led_bit_position_valid
        given cfg = led_config()
        assert cfg.bit_position < 24

    invariant led_output_boolean
        given cfg = led_config()
        assert led_output(0, cfg) == true or led_output(0, cfg) == false

    invariant counter_increment_monotonic
        given cfg = counter_config(24)
        assert next_counter(0, cfg.width) > 0
        and next_counter(100, cfg.width) > 100

    // === Benchmarks ===

    bench counter_increment_latency
        measure: nanoseconds to next_counter(1000, 24)
        target: < 5ns

    bench led_output_latency
        measure: nanoseconds to led_output(1000, led_config())
        target: < 5ns

    bench simulation_latency
        measure: nanoseconds to simulate_counter_cycles(1000000, 1000)
        target: < 50ns

}

// phi^2 + 1/phi^2 = 3 | TRINITY