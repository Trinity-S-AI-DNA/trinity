// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/d_bufg_test.t27
// BUFG (Global Buffer) Test Module for Trinity S³AI FPGA
// Tests clock buffering and 24-bit counter behavior
// Uses flat arrays + count fields (parser-compatible)
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Module interface ===

    pub struct ModuleInterface {
        clk : bool,
        led : bool,
    }

    // === Clock buffer configuration ===

    pub struct BufgConfig {
        name : &str,
        input_delay_ps : u32,
        output_delay_ps : u32,
        fanout_capacity : u32,
    }

    fn bufg_config(name: &str) -> BufgConfig {
        return BufgConfig{
            .name = name,
            .input_delay_ps = 0,
            .output_delay_ps = 100,
            .fanout_capacity = 32,
        };
    }

    // === Counter configuration ===

    pub struct CounterConfig {
        width : u32,
        initial_value : u32,
        max_value : u32,
    }

    fn counter_24bit() -> CounterConfig {
        return CounterConfig{
            .width = 24,
            .initial_value = 0,
            .max_value = 16777215, // 2^24 - 1
        };
    }

    // === Simulation state ===

    pub struct SimulationState {
        clk_input : bool,
        clk_bufged : bool,
        counter_value : u32,
        cycle_count : u32,
    }

    fn initial_state() -> SimulationState {
        return SimulationState{
            .clk_input = false,
            .clk_bufged = false,
            .counter_value = 0,
            .cycle_count = 0,
        };
    }

    fn apply_clock_buffer(state: SimulationState, clk: bool, cfg: BufgConfig) -> SimulationState {
        var new_state : SimulationState = state;
        new_state.clk_input = clk;
        new_state.clk_bufged = clk; // BUFG passes clock through with buffering
        return new_state;
    }

    fn increment_counter(state: SimulationState, cfg: CounterConfig) -> SimulationState {
        var new_state : SimulationState = state;
        if (state.counter_value < cfg.max_value) {
            new_state.counter_value = state.counter_value + 1;
        } else {
            new_state.counter_value = cfg.initial_value; // Roll over
        }
        new_state.cycle_count = state.cycle_count + 1;
        return new_state;
    }

    fn compute_led_output(state: SimulationState, cfg: CounterConfig) -> bool {
        var msb_bit : u32 = 1 << (cfg.width - 1);
        return (state.counter_value & msb_bit) != 0;
    }

    // === Test functions ===

    fn simulate_clock_cycles(state: SimulationState, clk_cycles: u32, cfg: CounterConfig, bufg_cfg: BufgConfig) -> SimulationState {
        var current_state : SimulationState = state;
        var i : u32 = 0;
        
        while (i < clk_cycles) {
            // Toggle clock for each cycle
            var new_clk : bool = (i % 2) == 0;
            current_state = apply_clock_buffer(current_state, new_clk, bufg_cfg);
            
            // Increment counter on rising edge
            if (current_state.clk_bufged and (i % 2) == 0) {
                current_state = increment_counter(current_state, cfg);
            }
            
            i = i + 1;
        }
        
        return current_state;
    }

    fn test_counter_increment() -> bool {
        var cfg : CounterConfig = counter_24bit();
        var bufg_cfg : BufgConfig = bufg_config("test_bufg");
        var state : SimulationState = initial_state();
        
        // Simulate 10 clock cycles
        state = simulate_clock_cycles(state, 10, cfg, bufg_cfg);
        
        // After 5 rising edges (cycles 0, 2, 4, 6, 8), counter should be 5
        return state.counter_value == 5;
    }

    fn test_counter_roll_over() -> bool {
        var cfg : CounterConfig = counter_24bit();
        var bufg_cfg : BufgConfig = bufg_config("test_bufg");
        var state : SimulationState = initial_state();
        
        // Set counter to max value
        state.counter_value = cfg.max_value;
        
        // Simulate one more cycle - should roll over to 0
        state = simulate_clock_cycles(state, 2, cfg, bufg_cfg);
        
        return state.counter_value == 0;
    }

    fn test_msb_behavior() -> bool {
        var cfg : CounterConfig = counter_24bit();
        
        // Test counter at 0: MSB should be 0
        var state_zero : SimulationState = initial_state();
        var led_at_zero : bool = compute_led_output(state_zero, cfg);
        
        // Set counter to value with MSB set
        var state_msb : SimulationState = initial_state();
        state_msb.counter_value = 0x800000; // Only MSB set
        var led_at_msb : bool = compute_led_output(state_msb, cfg);
        
        return led_at_zero == false and led_at_msb == true;
    }

    // === Tests ===

    test counter_increment_test
        then test_counter_increment() == true

    test counter_roll_over_test
        then test_counter_roll_over() == true

    test msb_behavior_test
        then test_msb_behavior() == true

    test bufg_config_creation
        given cfg = bufg_config("clk_buf")
        then cfg.name == "clk_buf"
        and cfg.input_delay_ps == 0
        and cfg.output_delay_ps == 100
        and cfg.fanout_capacity == 32

    test counter_config_creation
        given cfg = counter_24bit()
        then cfg.width == 24
        and cfg.initial_value == 0
        and cfg.max_value == 16777215

    // === Benchmarks ===

    bench counter_increment_latency
        measure: nanoseconds to simulate_clock_cycles(initial_state(), 1000, counter_24bit(), bufg_config("bench"))
        target: < 1000ns

}

// phi^2 + 1/phi^2 = 3 | TRINITY