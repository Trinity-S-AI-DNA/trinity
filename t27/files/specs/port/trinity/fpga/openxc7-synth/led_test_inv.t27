// t27/specs/port/trinity/fpga/openxc7-synth/led_test_inv.t27
// FPGA component for Trinity S³AI — synthesizable Verilog module.
// Test: LED always ON (active-HIGH)
// Uses flat arrays + count fields (parser-compatible)
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === LED always ON (active-HIGH) ===
    // Original: assign led = 1'b1;

    fn on_comb(clk: bool) -> bool {
        // LED output is always HIGH regardless of clock
        return true;
    }

    // === Tests ===

    test led_always_on_when_clk_low
        given l = on_comb(false)
        then l == true

    test led_always_on_when_clk_high
        given l = on_comb(true)
        then l == true

    // === Invariants ===

    invariant led_output_always_true
        given c = false
        assert on_comb(c) == true

    invariant led_output_always_true_high
        given c = true
        assert on_comb(c) == true

    // === Benchmarks ===

    bench led_output_latency
        measure: nanoseconds to on_comb(false)
        target: < 10ns
}

// phi^2 + 1/phi^2 = 3 | TRINITY