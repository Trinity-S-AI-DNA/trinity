// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/d6_blink.t27
// Trinity D6 Blink Module - 50 MHz counter and ~3 Hz LED blink
// Ports the original Verilog module trinity_top to T27 specification
// 25-bit counter wraps at 2^25; LED pin inverts counter[24] (active-low board LED)
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Module interface ===

    pub struct BlinkState {
        counter : u32,
        led : bool,
    }

    // === Constants (from the original Verilog) ===

    pub const CLK_HZ : u32 = 50_000_000;       // 50 MHz board clock
    pub const COUNTER_TOP : u32 = 33_554_432;  // 2^25: reg [24:0] wraps after this
    pub const BLINK_HALF_PERIOD : u32 = 16_777_216;  // 2^24: led level flips every 2^24 cycles

    // === Counter logic (ported from the original Verilog) ===

    fn counter_next(counter: u32) -> u32 {
        // Original Verilog: reg [24:0] counter = 25'd0;
        //                   always @(posedge clk) counter <= counter + 1'b1;
        // The 25-bit counter wraps at 2^25 - 1 = 33554431 (COUNTER_TOP - 1).
        if counter >= 33554431 {
            return 0;
        }
        return counter + 1;
    }

    // === LED output computation (ported from the original Verilog) ===

    fn top_bit_set(counter: u32) -> bool {
        // Original Verilog: assign led = ~counter[24];
        // counter[24] is 1 exactly when counter is in [2^24, 2^25).
        return (counter / 16777216) == 1;
    }

    fn led_value(counter: u32) -> bool {
        // The board LED is active-low: the pin inverts counter[24].
        return top_bit_set(counter) == false;
    }

    fn get_verilog_value(counter: u32) -> u32 {
        // LED pin value as a 1-bit Verilog value: 1'b1 when counter[24] == 0
        if (top_bit_set(counter)) {
            return 0;  // 1'b0
        } else {
            return 1;  // 1'b1
        }
    }

    fn compute_blink_state(counter: u32) -> BlinkState {
        return BlinkState{
            .counter = counter_next(counter),
            .led = led_value(counter),
        };
    }

    // === Tests ===

    test constants_document_the_rate
        then COUNTER_TOP == 33554432
        and BLINK_HALF_PERIOD == 16777216
        and CLK_HZ == 50000000

    test counter_increments_from_zero
        then counter_next(0) == 1

    test counter_increments
        then counter_next(41) == 42

    test counter_wraps_at_2p25
        then counter_next(33554431) == 0

    test counter_no_wrap_below_max
        then counter_next(16777215) == 16777216

    test top_bit_clear_below_2p24
        then top_bit_set(0) == false
        and top_bit_set(16777215) == false

    test top_bit_set_from_2p24
        then top_bit_set(16777216) == true
        and top_bit_set(33554431) == true

    test led_is_high_when_top_bit_clear
        then led_value(0) == true
        and led_value(16777215) == true

    test led_is_low_when_top_bit_set
        then led_value(16777216) == false

    test get_verilog_value_matches_led
        given s = compute_blink_state(16777216)
        then s.led == false
        and get_verilog_value(16777216) == 0

    test compute_blink_state_ports
        given s = compute_blink_state(0)
        then s.counter == 1
        and s.led == true

    // === Invariants ===

    invariant counter_always_wraps
        then counter_next(33554431) == 0

    invariant led_matches_counter
        given s = compute_blink_state(0)
        assert s.led == true

    // === Benchmarks ===

    bench counter_next_latency
        measure: nanoseconds to counter_next(16777215)
        target: < 10ns

    bench compute_blink_state_latency
        measure: nanoseconds to compute_blink_state(0)
        target: < 20ns
}

// phi^2 + 1/phi^2 = 3 | TRINITY
