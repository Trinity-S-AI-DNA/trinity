// t27/specs/port/trinity/fpga/openxc7-synth/d6_test.t27
// Trinity D6 Test Module - Simple LED Driver
// Ports the original Verilog module to T27 specification
// Uses constant LED output (active-low = ON)
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Module interface ===
    
    pub struct D6TestInterface {
        clk : bool,
        led : bool,
    }
    
    // === LED control functions ===
    
    fn led_state() -> bool {
        // Test: always ON (active-low means ~0 = 1)
        // Original Verilog: assign led = 1'b0;
        return false;  // false = 0 = ON for active-low LED
    }
    
    fn compute_output(clk: bool) -> D6TestInterface {
        return D6TestInterface{
            .clk = clk,
            .led = led_state(),
        };
    }
    
    fn is_led_on(led_val: bool) -> bool {
        // For active-low LED: false (0) = ON, true (1) = OFF
        return led_val == false;
    }
    
    // === Tests ===
    
    test led_always_on
        then led_state() == false
        and is_led_on(led_state()) == true
    
    test compute_output_with_clk
        given output = compute_output(true)
        then output.clk == true
        and output.led == false
        and is_led_on(output.led) == true
    
    test compute_output_without_clk
        given output = compute_output(false)
        then output.clk == false
        and output.led == false
        and is_led_on(output.led) == true
    
    // === Invariants ===
    
    invariant led_consistent
        then led_state() == false  // LED state never changes
    
    invariant output_led_matches
        given output = compute_output(true)
        assert output.led == led_state()
    
    // === Benchmarks ===
    
    bench led_state_latency
        measure: nanoseconds to led_state()
        target: < 10ns
    
    bench compute_output_latency
        measure: nanoseconds to compute_output(true)
        target: < 20ns
}

// phi^2 + 1/phi^2 = 3 | TRINITY