// Port of fpga/openxc7-synth/blink_correct.v (gHashTag/trinity, 2193a8a443b2)
// to `.t27` (roadmap stage 7, issue #5623).
//
// The original is the 19-line "Correct LED blink on T23 (D6)" module:
//
//     module trinity_top (
//         input  wire clk,
//         output wire led
//     );
//         reg [24:0] counter = 25'd0;
//         always @(posedge clk) begin
//             counter <= counter + 1'b1;
//         end
//         assign led = counter[24];  // T23 LED
//     endmodule
//
// Every decision it carries lives here as constants, a struct and pure
// functions: the 25-bit counter and its power-on value, the +1 wraparound
// on every posedge, the LED driven by counter bit 24, and the blink timing
// those imply on the T23 fabric clock. `t27c gen-verilog` turns this module
// into the RTL: the counter registers under `always @(posedge clk)` (issue
// #1764) and the LED port is continuously driven, like `assign led`.

module trinity_top {

    // reg [24:0] -- the counter sweeps its full range, one tick per clock.
    pub const COUNTER_WIDTH: u32 = 25;

    // 25'd0 -- the counter's power-on value.
    pub const COUNTER_INIT: u32 = 0;

    // assign led = counter[24] -- the T23 LED follows the counter's MSB.
    pub const LED_BIT: u32 = 24;

    // 1 << 24: how many clocks the LED holds one level before toggling.
    pub const TOGGLE_CYCLES: u32 = 16_777_216;

    // 1 << 25: one full on-off blink spans the whole 25-bit range.
    pub const BLINK_PERIOD_CYCLES: u32 = 33_554_432;

    // 25'h1FFFFFF = 2^25 - 1: the last value before the reg wraps.
    pub const COUNTER_MAX: u32 = 33_554_431;

    // One snapshot of the module: the reg and the wire it drives.
    pub struct BlinkState {
        counter: u32,
        led: bool,
    }

    // always @(posedge clk) counter <= counter + 1'b1;
    // A 25-bit reg has no carry-out: it wraps to 0 past 25'h1FFFFFF.
    pub fn next_counter(counter: u32) -> u32 {
        var next: u32 = counter + 1;
        if (next > COUNTER_MAX) {
            next = COUNTER_INIT;
        }
        return next;
    }

    // assign led = counter[24];  // T23 LED
    pub fn led_from_counter(counter: u32) -> bool {
        return (counter >> LED_BIT) == 1;
    }

    // reg [24:0] counter = 25'd0; -- bit 24 clear, so the blink starts dark.
    pub fn initial_state() -> BlinkState {
        return BlinkState { counter: COUNTER_INIT, led: false };
    }

    // One posedge: the register takes counter + 1'b1 and the LED wire
    // follows the new counter's bit 24.
    pub fn tick(state: BlinkState) -> BlinkState {
        var next: BlinkState = state;
        next.counter = next_counter(state.counter);
        next.led = led_from_counter(next.counter);
        return next;
    }

    // counter[24] flips once every 2^24 clocks.
    pub fn cycles_per_toggle() -> u32 {
        return TOGGLE_CYCLES;
    }

    // One blink per 25-bit sweep: 2^24 clocks off, 2^24 clocks on.
    pub fn blink_period_cycles() -> u32 {
        return BLINK_PERIOD_CYCLES;
    }

    // The blink rate seen at the LED for a given fabric clock, in
    // millihertz so it stays integral. The T23 runs 100 MHz: 2^25 clocks
    // span ~0.34 s, i.e. ~2.98 Hz -- the visible blink this module is named
    // "correct" for.
    pub fn blink_millihz(clk_hz: u64) -> u64 {
        return (clk_hz * 1000) / BLINK_PERIOD_CYCLES;
    }

    // The register: the reg [24:0] from the original. gen-verilog declares
    // it as the module's state and registers it on posedge clk.
    var counter: u32 = COUNTER_INIT;

    // The always block: always @(posedge clk) begin
    //                     counter <= counter + 1'b1;
    //                   end
    fn on_clock() {
        counter = next_counter(counter);
    }

    // The continuous assignment: assign led = counter[24];  // T23 LED
    fn on_comb() -> bool {
        return led_from_counter(counter);
    }

    test counter_increments_and_wraps_like_a_25_bit_reg {
        assert(next_counter(0) == 1);
        assert(next_counter(33_554_430) == 33_554_431);
        // 25'h1FFFFFF + 1'b1 wraps to 25'd0, not 33_554_432.
        assert(next_counter(33_554_431) == 0);
    }

    test led_is_counter_bit_24 {
        assert(led_from_counter(0) == false);
        assert(led_from_counter(16_777_215) == false);
        // counter[24] first sets at 2^24 and stays set to the end of range.
        assert(led_from_counter(16_777_216) == true);
        assert(led_from_counter(33_554_431) == true);
    }

    test power_on_state_is_counter_zero_led_off {
        const s: BlinkState = initial_state();
        assert(s.counter == 0);
        assert(s.led == false);
    }

    test tick_steps_one_clock_and_follows_bit_24 {
        const s1: BlinkState = tick(initial_state());
        assert(s1.counter == 1);
        assert(s1.led == false);
        // The last off cycle flips the LED on in one tick.
        const off: BlinkState = BlinkState { counter: 16_777_215, led: false };
        const on: BlinkState = tick(off);
        assert(on.counter == 16_777_216);
        assert(on.led == true);
        // The end of range wraps to the dark start in one tick.
        const high: BlinkState = BlinkState { counter: 33_554_431, led: true };
        const wrap: BlinkState = tick(high);
        assert(wrap.counter == 0);
        assert(wrap.led == false);
    }

    test blink_timing_from_the_counter_width {
        assert(cycles_per_toggle() == 16_777_216);
        assert(blink_period_cycles() == 33_554_432);
        assert(cycles_per_toggle() * 2 == blink_period_cycles());
    }

    test blink_rate_on_the_t23_clock {
        assert(blink_millihz(100_000_000) == 2980);
        assert(blink_millihz(50_000_000) == 1490);
    }

    // The hardware surface itself: the always block clocks the register and
    // the LED port follows its bit 24 (the shape gen-verilog lowers).
    test hardware_surface_clocks_the_counter {
        on_clock();
        assert(counter == 1);
        assert(on_comb() == false);
    }
}
