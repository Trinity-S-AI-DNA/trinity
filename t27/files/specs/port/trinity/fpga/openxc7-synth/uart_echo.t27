// Port of gHashTag/trinity fpga/openxc7-synth/uart_echo.v (19 lines, 1 module).
// The original is a minimal direct-wire test: it bypasses all UART logic and
// connects RX straight to TX, with a status LED held low (active-low).
// Pins per the original: clk 50 MHz (M22), RX (K20), TX (L20), LED (T23).

module uart_echo {

    // 50 MHz clock (M22) driving the module.
    pub const CLK_MHZ: u32 = 50;

    // The LED output is tied to 1'b0 -- the LED is lit, being active-low.
    pub const LED_LEVEL_ON: u8 = 0;

    // The module's only decision: uart_tx is a direct wire from uart_rx.
    // Whatever bit arrives on RX leaves on TX unchanged.
    pub fn on_comb(uart_rx: u8) -> u8 {
        return uart_rx;
    }

    // The status LED level: held constant low (active-low, so 0 = on).
    pub fn led_level() -> u8 {
        return LED_LEVEL_ON;
    }

    test echo_wire {
        assert(on_comb(0) == 0);
        assert(on_comb(1) == 1);
        assert(on_comb(0xFF) == 0xFF);
    }

    test led_constant_low {
        assert(led_level() == 0);
        assert(led_level() == LED_LEVEL_ON);
    }
}
