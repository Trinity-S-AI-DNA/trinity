module trinity_top {

    // FPGA component for Trinity S3AI - port of
    // trinity/fpga/openxc7-synth/led_d5_test.v (LED D5 Test, V2 Day 6).
    // Uses the QMTECH XC7A100T-1FGG676C pinout; LED D5 is on header J19.

    // Board clock: 50 MHz (original comment: 50MHz / 2^23 ~ 6 Hz toggle).
    pub const CLK_HZ : u32 = 50_000_000;

    // reg [23:0] blink_counter - 24 bits, so the count wraps at 2^24.
    pub const BLINK_COUNTER_BITS : u32 = 24;

    // The wrap point of the 24-bit counter: 2^24 - 1.
    pub const BLINK_COUNT_MAX : u32 = 0xFFFFFF;

    // The bit the LED follows: assign led = blink_counter[23].
    pub const LED_BIT : u32 = 23;

    // always @(posedge clk): blink_counter <= blink_counter + 1'b1.
    // The hardware register is BLINK_COUNTER_BITS wide, so it wraps to 0.
    pub fn next_count(counter: u32) -> u32 {
        return (counter + 1) & BLINK_COUNT_MAX;
    }

    // assign led = blink_counter[23] - the LED is on at bit LED_BIT.
    pub fn led_value(counter: u32) -> bool {
        return (counter >> LED_BIT) & 1 == 1;
    }

    // Module state gives the clocked backend real registers and output ports.
    // u32 carries the masked 24-bit value; rst_n/en are backend control ports.
    var blink_counter: u32 = 0;
    pub var led: bool = false;

    // Both RTL assignments sample the old count. Evaluate the LED first so
    // sequential host execution observes the same next count as nonblocking RTL.
    fn on_clock() -> void {
        led = led_value(next_count(blink_counter));
        blink_counter = next_count(blink_counter);
    }

    test next_count_increments {
        assert(next_count(0) == 1);
        assert(next_count(5) == 6);
        assert(next_count(0x7FFFFF) == 0x800000);
    }

    test next_count_wraps_at_24_bits {
        assert(next_count(0xFFFFFF) == 0);
        assert(next_count(0xFFFFFE) == 0xFFFFFF);
    }

    test led_value_follows_bit_23 {
        assert(!led_value(0));
        assert(led_value(0x800000));
        assert(!led_value(0x7FFFFF));
        assert(led_value(0xFFFFFF));
    }

    test on_clock_advances_registered_state {
        assert(blink_counter == 0);
        assert(!led);
        on_clock();
        assert(blink_counter == 1);
        assert(!led);
        on_clock();
        assert(blink_counter == 2);
        assert(!led);
    }
}
