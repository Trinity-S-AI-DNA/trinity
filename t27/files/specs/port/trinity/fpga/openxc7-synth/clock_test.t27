// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/clock_test.t27
// CLOCK TEST - Verify 50MHz oscillator is working
// Ported from gHashTag/trinity fpga/openxc7-synth/clock_test.v
// Direct connection: T23 LED tied to the clock, R23 LED tied to the inverted clock
// If the clock works, the LEDs show blur (~50MHz too fast to see)
// If an LED is solid, the clock is not working
// phi^2 + 1/phi^2 = 3 | TRINITY

module clock_test {

    // === Module constants ===

    // 50 MHz on U22
    pub const CLK_MHZ : u32 = 50;

    // === Output types ===

    // The two LEDs the module drives: t23 follows the clock, r23 inverts it.
    pub struct ClockOutputs {
        t23 : bool,
        r23 : bool,
    }

    // === Combinational surface ===

    // The original's two assigns in one host decision:
    //   assign t23 = clk;
    //   assign r23 = ~clk;
    fn clock_outputs(clock_level: bool) -> ClockOutputs {
        return ClockOutputs{ .t23 = clock_level, .r23 = !clock_level };
    }

    // The RTL entry must return a scalar the backend can expose. result[0]
    // maps to original t23, result[1] to original r23; bits[7:2] are zero.
    // This is the same two-state Boolean domain as the host ClockOutputs.
    // Diagnostic clock_level is separate from backend control clk/rst_n/en.
    fn on_comb(clock_level: bool) -> u8 {
        const outputs : ClockOutputs = clock_outputs(clock_level);
        if (outputs.t23) {
            return 1;
        }
        if (outputs.r23) {
            return 2;
        }
        return 0;
    }

    // === Output functions (the individual assigns) ===

    // assign t23 = clk;  // T23 LED - direct clock connection
    fn t23_output(clk: bool) -> bool {
        return clk;
    }

    // assign r23 = ~clk;  // R23 LED - inverted clock
    fn r23_output(clk: bool) -> bool {
        return !clk;
    }

    // === Tests ===

    // T23 LED follows the clock in both states.
    test t23_follows_clk
        given high = t23_output(true)
        then high == true
        and t23_output(false) == false

    // R23 LED is the inverted clock in both states.
    test r23_inverts_clk
        given low = r23_output(false)
        then low == true
        and r23_output(true) == false

    // The original's pair of assigns: the two LEDs never agree.
    test outputs_complement
        given quiet = clock_outputs(false)
        then quiet.t23 == false
        and quiet.r23 == true
        and t23_output(true) == true
        and r23_output(true) == false
        and quiet.t23 != quiet.r23

    test packed_result_maps_both_original_outputs {
        assert(on_comb(false) == 2);
        assert(on_comb(true) == 1);
        assert(on_comb(false) & 1 == 0);
        assert(on_comb(false) & 2 == 2);
        assert(on_comb(true) & 1 == 1);
        assert(on_comb(true) & 2 == 0);
    }

    // === Invariants ===

    invariant result_has_only_the_two_original_output_bits {
        assert(on_comb(false) == 2);
        assert(on_comb(true) == 1);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
