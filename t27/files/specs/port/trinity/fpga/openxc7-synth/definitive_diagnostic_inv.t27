// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/definitive_diagnostic_inv.t27
// Definitive LED Diagnostic with Inversion - Port from Verilog
// Implements LED blink patterns with inverted outputs for FPGA diagnostic
// Uses counter-based timing with different bit selections for fast/slow rates
// phi^2 + 1/phi^2 = 3 | TRINITY

module definitive_diagnostic_top {

    // === Constants ===
    
    pub const COUNTER_WIDTH : u32 = 26;
    pub const FAST_BIT : u32 = 22;  // 50MHz / 2^23 = ~5.96 Hz
    pub const SLOW_BIT : u32 = 24;  // 50MHz / 2^25 = ~1.49 Hz
    
    // === Counter simulation ===
    
    fn counter_next(current: u32) -> u32 {
        var next : u32 = current + 1;
        // 26-bit counter wraps around
        if (next >= (1 << COUNTER_WIDTH)) {
            return 0;
        }
        return next;
    }
    
    fn counter_at_cycle(cycle: u32) -> u32 {
        return cycle;
    }
    
    // === LED output computation ===
    
    fn fast_blink_inverted(counter_value: u32) -> bool {
        // T23: Fast blink (~6 Hz) - ACTIVE-LOW (inverted)
        // Returns true when counter[22] is 0 (inverted output)
        var bit_value : bool = (counter_value >> FAST_BIT) & 1 == 0;
        return bit_value;
    }
    
    fn slow_blink_inverted(counter_value: u32) -> bool {
        // R23: Slow blink (~1.5 Hz) - ACTIVE-LOW (inverted)
        // Returns true when counter[24] is 0 (inverted output)
        var bit_value : bool = (counter_value >> SLOW_BIT) & 1 == 0;
        return bit_value;
    }
    
    // === LED pattern validation ===
    
    fn get_led_state_at_cycle(cycle: u32, led_type: &str) -> bool {
        var counter : u32 = counter_at_cycle(cycle);
        if (led_type == "fast") {
            return fast_blink_inverted(counter);
        } else if (led_type == "slow") {
            return slow_blink_inverted(counter);
        } else {
            return false;
        }
    }
    
    fn fast_blink_period() -> u32 {
        return 1 << FAST_BIT;  // 2^23 cycles
    }
    
    fn slow_blink_period() -> u32 {
        return 1 << SLOW_BIT;  // 2^25 cycles
    }
    
    fn fast_blink_frequency_mhz() -> f64 {
        return 50.0 / (1 << FAST_BIT) as f64;  // 50MHz / 2^23
    }
    
    fn slow_blink_frequency_mhz() -> f64 {
        return 50.0 / (1 << SLOW_BIT) as f64;  // 50MHz / 2^25
    }
    
    // === Tests ===
    
    test counter_increment
        given start = 0
        then counter_next(start) == 1
        and counter_next(1) == 2
        and counter_next(0x3FFFFFF) == 0
    
    test counter_at_cycle_values
        then counter_at_cycle(0) == 0
        and counter_at_cycle(100) == 100
        and counter_at_cycle(0x3FFFFFF) == 0x3FFFFFF
    
    test fast_blink_inverted_logic
        // When counter[22] = 0, output should be true (inverted)
        then fast_blink_inverted(0) == true      // bit 22 = 0 -> output = 1
        and fast_blink_inverted(1 << 22) == false // bit 22 = 1 -> output = 0
        and fast_blink_inverted(3 << 22) == false // bit 22 = 1 -> output = 0
        and fast_blink_inverted((1 << 22) - 1) == true // bit 22 = 0 -> output = 1
    
    test slow_blink_inverted_logic
        // When counter[24] = 0, output should be true (inverted)
        then slow_blink_inverted(0) == true      // bit 24 = 0 -> output = 1
        and slow_blink_inverted(1 << 24) == false // bit 24 = 1 -> output = 0
        and slow_blink_inverted(3 << 24) == false // bit 24 = 1 -> output = 0
        and slow_blink_inverted((1 << 24) - 1) == true // bit 24 = 0 -> output = 1
    
    test led_state_at_cycle_fast
        then get_led_state_at_cycle(0, "fast") == true
        and get_led_state_at_cycle(1 << 22, "fast") == false
        and get_led_state_at_cycle((1 << 22) - 1, "fast") == true
    
    test led_state_at_cycle_slow
        then get_led_state_at_cycle(0, "slow") == true
        and get_led_state_at_cycle(1 << 24, "slow") == false
        and get_led_state_at_cycle((1 << 24) - 1, "slow") == true
    
    test blink_periods
        then fast_blink_period() == 1 << 22
        and slow_blink_period() == 1 << 24
        and slow_blink_period() > fast_blink_period()
    
    test blink_frequencies
        then fast_blink_frequency_mhz() > 0.0
        and slow_blink_frequency_mhz() > 0.0
        and fast_blink_frequency_mhz() > slow_blink_frequency_mhz()
        and fast_blink_frequency_mhz() < 10.0  // Should be ~6 Hz
        and slow_blink_frequency_mhz() < 2.0   // Should be ~1.5 Hz
    
    test counter_width_bounds
        then counter_at_cycle((1 << COUNTER_WIDTH) - 1) == (1 << COUNTER_WIDTH) - 1
        and counter_next((1 << COUNTER_WIDTH) - 1) == 0  // Wraps around
    
    test led_inversion_consistency
        // Test that inversion logic is consistent for both LEDs
        var counter_test : u32 = 0;
        then fast_blink_inverted(counter_test) == true
        and slow_blink_inverted(counter_test) == true
        and fast_blink_inverted(counter_test + (1 << 22)) == false
        and slow_blink_inverted(counter_test + (1 << 24)) == false
    
    // === Invariants ===
    
    invariant counter_width_positive
        assert COUNTER_WIDTH > 0
    
    invariant fast_bit_less_than_counter_width
        assert FAST_BIT < COUNTER_WIDTH
    
    invariant slow_bit_less_than_counter_width
        assert SLOW_BIT < COUNTER_WIDTH
    
    invariant fast_bit_less_than_slow_bit
        assert FAST_BIT < SLOW_BIT
    
    invariant blink_periods_positive
        assert fast_blink_period() > 0
        and slow_blink_period() > 0
    
    invariant blink_frequencies_positive
        assert fast_blink_frequency_mhz() > 0.0
        and slow_blink_frequency_mhz() > 0.0
    
    invariant fast_blink_faster_than_slow
        assert fast_blink_frequency_mhz() > slow_blink_frequency_mhz()
    
    // === Benchmarks ===
    
    bench counter_increment_latency
        measure: nanoseconds to counter_next(1000)
        target: < 10ns
    
    bench led_computation_latency
        measure: nanoseconds to fast_blink_inverted(1000) and slow_blink_inverted(1000)
        target: < 20ns
    
    bench blink_frequency_calculation_latency
        measure: nanoseconds to fast_blink_frequency_mhz() and slow_blink_frequency_mhz()
        target: < 30ns
}

// phi^2 + 1/phi^2 = 3 | TRINITY