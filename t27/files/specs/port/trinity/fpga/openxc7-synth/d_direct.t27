// specs/port/trinity/fpga/openxc7-synth/d_direct.t27
// Port of gHashTag/trinity:fpga/openxc7-synth/d_direct.v
// Trinity S³AI — Direct Clock-to-LED Pass-Through
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // The original Verilog: assign led = clk;
    // This on_comb function expresses that combinational pass-through.
    // Parameter becomes input port 'clk', return becomes output port 'result'.
    fn on_comb(clk: bool) -> bool {
        return clk;
    }

    // ---- Tests: verify the pass-through behavior ----

    test comb_clk_high_drives_led_high
        given led = on_comb(true)
        then led == true

    test comb_clk_low_drives_led_low
        given led = on_comb(false)
        then led == false

}