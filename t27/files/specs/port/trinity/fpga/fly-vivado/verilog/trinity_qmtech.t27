module trinity_top {

    // FPGA component for Trinity QMTECH XC7A100T Core Board LED Blink - port of
    // trinity/fpga/fly-vivado/verilog/trinity_qmtech.v (27 lines of hand-written
    // Verilog). Minimal test: LED heartbeat (no reset button - the Core Board
    // has no SW1). Uses the QMTECH XC7A100T-1FGG676C pinout; LED D5 is on
    // header J19.

    // Board clock: 50 MHz.
    pub const CLK_HZ: u32 = 50_000_000;

    // reg [25:0] counter - 26 bits, so the count wraps at 2^26.
    pub const COUNTER_BITS: u32 = 26;

    // The wrap point of the 26-bit counter: 2^26 - 1.
    pub const COUNT_MAX: u32 = 0x3FFFFFF;

    // The bit the LED follows: assign led = ~counter[24].
    pub const LED_BIT: u32 = 24;

    // always @(posedge clk): counter <= counter + 1'b1.
    // The hardware register is COUNTER_BITS wide, so it wraps to 0.
    pub fn next_count(counter: u32) -> u32 {
        return (counter + 1) & COUNT_MAX;
    }

    // assign led = ~counter[LED_BIT] - the led wire carries the inverted bit
    // LED_BIT: high while bit LED_BIT is 0, low once it rolls to 1.
    pub fn led_value(counter: u32) -> bool {
        return ((counter >> LED_BIT) & 1) == 0;
    }

    // The led wire toggles once per 2^LED_BIT cycles, so one full blink (on
    // and off) is 2^(LED_BIT + 1) = 2^25 cycles: 50MHz / 2^25 ~ 1.49 Hz.
    pub fn blink_period_cycles() -> u32 {
        return (1 << (LED_BIT + 1));
    }

    // Module state gives the clocked backend real registers and output ports.
    // u32 carries the masked 26-bit count; rst_n/en are backend control ports.
    // Power-on state matches the RTL: counter is 0 and the combinational
    // assign led = ~counter[24] holds the wire high.
    var counter: u32 = 0;
    pub var led: bool = true;

    // The hardware performs both assignments on every posedge clk: led is
    // assigned first so sequential host execution observes the same post-edge
    // count as nonblocking RTL and led stays in phase with counter.
    fn on_clock() -> void {
        led = led_value(next_count(counter));
        counter = next_count(counter);
    }

    test next_count_increments {
        assert(next_count(0) == 1);
        assert(next_count(5) == 6);
        assert(next_count(0x1FFFFFF) == 0x2000000);
    }

    test next_count_wraps_at_26_bits {
        assert(next_count(0x3FFFFFF) == 0);
        assert(next_count(0x3FFFFFE) == 0x3FFFFFF);
    }

    test led_wire_is_inverted_bit_24 {
        // The wire is high while bit LED_BIT is 0 and goes low once it rolls
        // to 1; the LED is active-low, so it blinks at half that rate.
        assert(led_value(0) == true);
        assert(led_value(0xFFFFFF) == true);
        assert(led_value(0x1000000) == false);
        assert(led_value(0x3FFFFFF) == false);
        assert(led_value(next_count(0xFFFFFF)) == false);
    }

    test on_clock_powers_on_and_advances {
        assert(counter == 0);
        assert(led == true);
        on_clock();
        assert(counter == 1);
        assert(led == true);
        on_clock();
        assert(counter == 2);
        assert(led == led_value(counter));
    }

    test blink_period_is_two_pow_25_cycles {
        // One full blink (on and off) is 2^25 cycles: 50MHz / 2^25 ~ 1.49 Hz.
        assert(blink_period_cycles() == 0x2000000);
        assert((blink_period_cycles() * 2) == (1 << COUNTER_BITS));
    }
}
