// specs/port/trinity/fpga/uart_loopback.t27
// UART Loopback Top Module - Port of gHashTag/trinity fpga/uart_loopback.v
// Instantiates uart_loopback_core
// phi^2 + 1/phi^2 = 3 | TRINITY

module uart_loopback {

    // === Port identifiers ===

    pub const PORT_CLK : &str = "clk";
    pub const PORT_UART_RX : &str = "uart_rx";
    pub const PORT_UART_TX : &str = "uart_tx";
    pub const PORT_LED : &str = "led";

    // === Core instance configuration ===

    pub struct CoreInstance {
        instance_name : &str,
        clk_port : &str,
        uart_rx_port : &str,
        uart_tx_port : &str,
        led_port : &str,
    }

    // === Constructor ===

    fn uart_loopback_core() -> CoreInstance {
        return CoreInstance{
            .instance_name = "core_inst",
            .clk_port = PORT_CLK,
            .uart_rx_port = PORT_UART_RX,
            .uart_tx_port = PORT_UART_TX,
            .led_port = PORT_LED,
        };
    }

    // === Query functions ===

    fn has_clk_port(core: CoreInstance) -> bool {
        return core.clk_port == PORT_CLK;
    }

    fn has_uart_rx_port(core: CoreInstance) -> bool {
        return core.uart_rx_port == PORT_UART_RX;
    }

    fn has_uart_tx_port(core: CoreInstance) -> bool {
        return core.uart_tx_port == PORT_UART_TX;
    }

    fn has_led_port(core: CoreInstance) -> bool {
        return core.led_port == PORT_LED;
    }

    fn instance_name(core: CoreInstance) -> &str {
        return core.instance_name;
    }

    // === Validation ===

    fn validate_core_instance(core: CoreInstance) -> u32 {
        var errors : u32 = 0;
        if (core.instance_name == "") {
            errors = errors + 1;
        }
        if (core.clk_port == "") {
            errors = errors + 1;
        }
        if (core.uart_rx_port == "") {
            errors = errors + 1;
        }
        if (core.uart_tx_port == "") {
            errors = errors + 1;
        }
        if (core.led_port == "") {
            errors = errors + 1;
        }
        return errors;
    }

    // === Tests ===

    test core_instance_creation
        given core = uart_loopback_core()
        then instance_name(core) == "core_inst"
        and has_clk_port(core) == true
        and has_uart_rx_port(core) == true
        and has_uart_tx_port(core) == true
        and has_led_port(core) == true

    test validate_core_instance_ok
        given core = uart_loopback_core()
        then validate_core_instance(core) == 0

    test validate_core_instance_empty_name
        given core = CoreInstance{.instance_name = "", .clk_port = "clk", .uart_rx_port = "rx", .uart_tx_port = "tx", .led_port = "led"}
        then validate_core_instance(core) > 0

    test validate_core_instance_empty_clk
        given core = CoreInstance{.instance_name = "core_inst", .clk_port = "", .uart_rx_port = "rx", .uart_tx_port = "tx", .led_port = "led"}
        then validate_core_instance(core) > 0

    test port_constants
        then PORT_CLK == "clk"
        and PORT_UART_RX == "uart_rx"
        and PORT_UART_TX == "uart_tx"
        and PORT_LED == "led"

    // === Invariants ===

    invariant core_instance_name_nonempty
        given core = uart_loopback_core()
        assert instance_name(core) != ""

    invariant core_instance_ports_nonempty
        given core = uart_loopback_core()
        assert core.clk_port != ""
        and core.uart_rx_port != ""
        and core.uart_tx_port != ""
        and core.led_port != ""

    invariant validate_non_negative
        given core = uart_loopback_core()
        assert validate_core_instance(core) >= 0
}