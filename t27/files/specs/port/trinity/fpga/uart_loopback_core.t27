// UART Loopback for QMTech XC7A100T FGG676 Core Board
// Clock: M22 (50 MHz)
// UART: D26/E26 (Bank 15)
// Simple loopback: what we receive, we send back
//
// Ported from fpga/uart_loopback_core.v: the module below is what
// `t27c gen-verilog` lowers to Verilog, so the core is generated from this
// spec instead of being hand-written. The original Verilog:
//
//   module uart_loopback_core(
//       input  wire clk,
//       input  wire uart_rx,
//       output wire uart_tx,
//       output wire led
//   );
//       assign uart_tx = uart_rx; // Loopback: receive -> transmit
//       assign led = uart_rx;     // LED shows data activity
//   endmodule

module uart_loopback_core {

    // Board facts from the original's header comments.
    pub const CLOCK_FREQ_HZ : u32 = 50_000_000; // Clock: M22 (50 MHz)
    pub const UART_BANK      : u32 = 15;         // UART: D26/E26 (Bank 15)

    // Port list of the original module, kept name-for-name. Each field is
    // 1 bit (bool), and the two structs split the ports by direction, as
    // the original declares them.
    pub struct UartLoopbackPortsIn {
        clk     : bool, // input  wire clk     - feeds the control FSM only
        uart_rx : bool, // input  wire uart_rx - data in, D26/E26 (Bank 15)
    }

    pub struct UartLoopbackPortsOut {
        uart_tx : bool, // output wire uart_tx - Loopback: receive -> transmit
        led     : bool, // output wire led     - LED shows data activity
    }

    // `assign uart_tx = uart_rx;` - Simple loopback: what we receive, we
    // send back.
    pub fn uart_loopback_tx(uart_rx : bool) -> bool {
        return uart_rx;
    }

    // `assign led = uart_rx;` - LED shows data activity.
    pub fn activity_led(uart_rx : bool) -> bool {
        return uart_rx;
    }

    // Both output wires the original drives, in port order.
    pub fn loopback_outputs(uart_rx : bool) -> UartLoopbackPortsOut {
        return UartLoopbackPortsOut {
            .uart_tx = uart_loopback_tx(uart_rx),
            .led     = activity_led(uart_rx),
        };
    }

    // The Verilog backend gives a generated module exactly one data
    // output, `result`. The original drives two 1-bit output wires, so
    // they travel packed: result[0] = uart_tx, result[1] = led; the upper
    // bits of the port are unused.
    pub const UART_TX_MASK : u8 = 1; // result[0] = uart_tx
    pub const LED_MASK     : u8 = 2; // result[1] = led

    // Pack the output bundle into the `result` port value.
    pub fn pack_outputs(outputs : UartLoopbackPortsOut) -> u8 {
        var packed : u8 = 0;
        if (outputs.uart_tx) { packed = packed | UART_TX_MASK; }
        if (outputs.led)     { packed = packed | LED_MASK; }
        return packed;
    }

    // Data surface lowered to Verilog: `on_comb`'s parameters become the
    // module's data input ports and its return becomes the `result`
    // output. `clk` from UartLoopbackPortsIn is the control clock; the
    // loopback never reads it, exactly like the original's `clk`.
    pub fn on_comb(uart_rx : bool) -> u8 {
        return pack_outputs(loopback_outputs(uart_rx));
    }

    // The original sends back what it receives: uart_rx high -> uart_tx high.
    test uart_tx_loopback {
        assert(uart_loopback_tx(true) == true);
        assert(uart_loopback_tx(false) == false);
    }

    // The LED mirrors receive activity: uart_rx high -> led high.
    test led_shows_data_activity {
        assert(activity_led(true) == true);
        assert(activity_led(false) == false);
    }

    // The bundle carries both output wires, in the original's port order.
    test output_bundle_in_port_order {
        let high = loopback_outputs(true);
        let low = loopback_outputs(false);
        assert(high.uart_tx == true);
        assert(high.led == true);
        assert(low.uart_tx == false);
        assert(low.led == false);
    }

    // The generated `result` port carries both outputs:
    // uart_rx high -> result = UART_TX_MASK | LED_MASK, uart_rx low -> 0.
    test result_packs_both_outputs {
        assert(on_comb(true) == (UART_TX_MASK | LED_MASK));
        assert(on_comb(false) == 0);
        assert((on_comb(true) & UART_TX_MASK) == UART_TX_MASK);
        assert((on_comb(true) & LED_MASK) == LED_MASK);
    }

    // Board header facts: 50 MHz on M22, UART on Bank 15.
    test board_header_facts {
        assert(CLOCK_FREQ_HZ == 50_000_000);
        assert(UART_BANK == 15);
    }
}
