// specs/port/trinity/src/vsa_simple/vsa.t27 -- port of the VSA (vector
// symbolic architecture) helpers: bind, bundle2 majority vote and cosine
// similarity over ternary vectors {-1, 0, +1}. The Zig port's allocator-driven
// dynamic vectors are re-expressed as fixed-size arrays of trits (i8), the
// shape the language supports.

module port-trin-vsa-simple;

pub const VECTOR_LEN : u32 = 100;
pub const Trit = i8;

pub const Vector = struct {
    data: [100]i8,
    len: u32,
};

pub fn Vector_init(len: u32) -> Vector {
    var v: Vector = undefined;
    v.len = len;
    var i: u32 = 0;
    while i < VECTOR_LEN {
        v.data[i] = 0;
        i += 1;
    }
    return v;
}

pub fn Vector_clone(self: Vector) -> Vector {
    var result = Vector_init(self.len);
    var i: u32 = 0;
    while i < self.len {
        result.data[i] = self.data[i];
        i += 1;
    }
    return result;
}

// VSA bind: b==0 keeps a, otherwise the product.
pub fn bind(a: Vector, b: Vector) -> Vector {
    var result = Vector_init(a.len);
    var i: u32 = 0;
    while i < a.len {
        let a_val = a.data[i];
        let b_val = if (i < b.len) b.data[i] else 0;
        result.data[i] = if (b_val == 0) a_val else b_val * a_val;
        i += 1;
    }
    return result;
}

// Bundle2: majority vote of the pairwise sum.
pub fn bundle2(a: Vector, b: Vector) -> Vector {
    var result = Vector_init(a.len);
    var i: u32 = 0;
    while i < a.len {
        let a_val = a.data[i];
        let b_val = if (i < b.len) b.data[i] else 0;
        let sum = a_val + b_val;
        result.data[i] = if (sum > 0) 1 else if (sum < 0) -1 else 0;
        i += 1;
    }
    return result;
}

// Cosine similarity over the overlapping prefix.
pub fn cosineSimilarity(a: Vector, b: Vector) -> f64 {
    var dot: f64 = 0.0;
    var norm_a: f64 = 0.0;
    var norm_b: f64 = 0.0;
    let len = if (a.len < b.len) a.len else b.len;

    var i: u32 = 0;
    while i < len {
        let av = a.data[i] as f64;
        let bv = b.data[i] as f64;
        dot += av * bv;
        norm_a += av * av;
        norm_b += bv * bv;
        i += 1;
    }

    let denom = norm_a * norm_b;
    if (denom == 0.0) {
        return 0.0;
    }
    return dot / denom;
}

test vector_init_is_zeroed {
    const v = Vector_init(10);
    assert(v.len == 10);
    assert(v.data[0] == 0);
    assert(v.data[9] == 0);
}

test bind_creates_the_product {
    var a = Vector_init(10);
    var b = Vector_init(10);
    var i: u32 = 0;
    while i < 10 {
        a.data[i] = 1;
        b.data[i] = -1;
        i += 1;
    }
    const result = bind(a, b);
    assert(result.len == 10);
    assert(result.data[0] == -1);
}

test bundle2_majority_vote {
    var a = Vector_init(10);
    var b = Vector_init(10);
    var i: u32 = 0;
    while i < 10 {
        a.data[i] = 1;
        b.data[i] = 1;
        i += 1;
    }
    const result = bundle2(a, b);
    assert(result.data[0] == 1);
}

test cosine_identical_is_one {
    var a = Vector_init(10);
    var i: u32 = 0;
    while i < 10 {
        a.data[i] = 1;
        i += 1;
    }
    const sim = cosineSimilarity(a, a);
    assert(sim > 0.999);
}

test clone_copies_data {
    var original = Vector_init(5);
    original.data[0] = 42;
    const clone = Vector_clone(original);
    assert(clone.len == original.len);
    assert(clone.data[0] == 42);
}

test bind_with_different_lengths {
    var a = Vector_init(5);
    var b = Vector_init(3);
    var i: u32 = 0;
    while i < 5 {
        a.data[i] = 2;
        i += 1;
    }
    i = 0;
    while i < 3 {
        b.data[i] = 3;
        i += 1;
    }
    const result = bind(a, b);
    assert(result.len == 5);
    assert(result.data[0] == 6);
    assert(result.data[3] == 2);
    assert(result.data[4] == 2);
}

test bundle2_with_different_lengths {
    var a = Vector_init(4);
    var b = Vector_init(2);
    var i: u32 = 0;
    while i < 4 {
        a.data[i] = 1;
        i += 1;
    }
    b.data[0] = -1;
    b.data[1] = -1;
    const result = bundle2(a, b);
    assert(result.data[0] == 0);
    assert(result.data[2] == 1);
    assert(result.data[3] == 1);
}
