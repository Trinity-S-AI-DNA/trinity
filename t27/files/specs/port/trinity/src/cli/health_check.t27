module port::trinity::src::cli::health_check;

// Core decision logic: determine URL and check if curl succeeded
pub fn decide_health_check(argc: u32, args: []str, curl_exit_code: i32) -> i32 {
    // URL selection logic from the original
    const url = if (argc > 1) args[1] else "https://hslm-r12.up.railway.app/health";
    
    // Success/failure determination from the original
    if (curl_exit_code != 0) {
        return 1; // EXIT_FAIL equivalent
    }
    
    return 0; // success
}

// Main function with undefined body (plumbing)
pub fn main() -> void {
    undefined;
}

// Test the decision logic
test decide_health_check_default_url_success {
    var args: [2][]const u8 = ["program", "https://hslm-r12.up.railway.app/health"];
    const result = decide_health_check(1, &args, 0);
    assert(result == 0);
}

test decide_health_check_custom_url_success {
    var args: [2][]const u8 = ["program", "https://example.com/health"];
    const result = decide_health_check(2, &args, 0);
    assert(result == 0);
}

test decide_health_check_failure {
    var args: [2][]const u8 = ["program", "https://example.com/health"];
    const result = decide_health_check(2, &args, 1);
    assert(result == 1);
}