module port::trinity::src::cli::railway_deployment_create;

// Port of gHashTag/trinity:src/cli/railway_deployment_create.zig (issue #6108).
// The original triggers a Railway build + deploy through one GraphQL `up`
// mutation made with curl. The decisions in it are two: whether the command
// line is complete, and whether the response counts as a Railway error.
// Everything else (argv, allocator, string formatting, the curl subprocess,
// printing) is plumbing.
//
// Unlike railway_null_startcmd.zig, this original never looks at curl's exit
// code: only the "errors" field in stdout makes it fail. The port keeps that.
//
// argv is not modelled as an array of strings: a local `[N][]const u8` is a
// 2-D aggregate that gen-verilog cannot lower (W469), and the decision only
// ever reads its length.

const EXIT_OK: i32 = 0;
const EXIT_FAIL: i32 = 1;

// Original: `if (args.len < 4)` prints the usage line and exits 1.
// `args` includes the program name, so <project-id> <service-id> <token>
// need argc >= 4.
pub fn decide_args(argc: u32) -> i32 {
    if (argc < 4) {
        return EXIT_FAIL;
    }
    return EXIT_OK;
}

// Original: `std.mem.indexOf(u8, haystack, needle) != null`.
// An empty needle is found at index 0, as in std.mem.indexOf.
pub fn contains(haystack: []const u8, needle: []const u8) -> bool {
    if (needle.len > haystack.len) {
        return false;
    }
    var i: usize = 0;
    while (i + needle.len <= haystack.len) {
        var j: usize = 0;
        var same: bool = true;
        while (j < needle.len) {
            if (haystack[i + j] != needle[j]) {
                same = false;
            }
            j += 1;
        }
        if (same) {
            return true;
        }
        i += 1;
    }
    return false;
}

// Original: `if (std.mem.indexOf(u8, result.stdout, "\"errors\"")) |_|`
// returns error.RailwayError. Railway answers HTTP 200 with an "errors"
// array on a rejected mutation, so the body is the only signal.
pub fn decide_response(stdout: []const u8) -> i32 {
    if (contains(stdout, "\"errors\"")) {
        return EXIT_FAIL;
    }
    return EXIT_OK;
}

// Plumbing: parses argv, builds the GraphQL body and the bearer header,
// runs curl, prints.
pub fn main() -> void {
    undefined;
}

test decide_args_no_arguments {
    assert(decide_args(1) == 1);
}

test decide_args_missing_service_and_token {
    assert(decide_args(2) == 1);
}

test decide_args_missing_token {
    assert(decide_args(3) == 1);
}

test decide_args_complete {
    assert(decide_args(4) == 0);
}

test decide_args_extra_arguments_are_ignored {
    assert(decide_args(6) == 0);
}

test contains_finds_suffix_and_prefix {
    assert(contains("hello world", "world") == true);
    assert(contains("hello world", "hello") == true);
}

test contains_rejects_absent_needle {
    assert(contains("hello world", "foo") == false);
}

test contains_needle_longer_than_haystack {
    assert(contains("hi", "hello") == false);
}

test contains_empty_needle_is_found {
    assert(contains("hello", "") == true);
    assert(contains("", "") == true);
}

test contains_partial_match_then_full_match {
    assert(contains("errorerrors", "errors") == true);
}

test decide_response_success_body {
    assert(decide_response("{\"data\": {\"up\": {\"url\": \"https://example.com\"}}}") == 0);
}

test decide_response_errors_field_is_a_failure {
    assert(decide_response("{\"errors\": [{\"message\": \"Service not found\"}]}") == 1);
}

test decide_response_unquoted_word_is_not_the_field {
    assert(decide_response("{\"data\": {\"note\": \"no errors here\"}}") == 0);
}

test decide_response_empty_body {
    assert(decide_response("") == 0);
}
