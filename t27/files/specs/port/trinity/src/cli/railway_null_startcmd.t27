module port::trinity::src::cli::railway_null_startcmd;

// Port of gHashTag/trinity:src/cli/railway_null_startcmd.zig (issue #6213).
// The original removes a Railway service's startCommand through one GraphQL
// call made with curl. The decisions in it are two: whether the command line
// is complete, and whether the call counts as having failed. Everything else
// (argv, allocator, string formatting, the curl subprocess) is plumbing.

const EXIT_OK: i32 = 0;
const EXIT_FAIL: i32 = 1;

// Original: `if (args.len < 3)` prints the usage line and exits 1.
// `args` includes the program name, so <service-id> and <token> need argc >= 3.
pub fn decide_args(argc: u32) -> i32 {
    if (argc < 3) {
        return EXIT_FAIL;
    }
    return EXIT_OK;
}

// Original: `has_error = result.term.Exited != 0` and
// `has_errors_field = stdout contains "\"errors\""`; either one is
// error.RailwayError. Railway answers HTTP 200 with an "errors" array on a
// rejected mutation, so a zero curl exit code alone does not mean success.
pub fn decide_result(curl_exit_code: i32, stdout_has_errors_field: bool) -> i32 {
    if (curl_exit_code != 0) {
        return EXIT_FAIL;
    }
    if (stdout_has_errors_field) {
        return EXIT_FAIL;
    }
    return EXIT_OK;
}

// Plumbing: parses argv, builds the GraphQL body, runs curl, prints.
pub fn main() -> void {
    undefined;
}

test decide_args_no_arguments {
    assert(decide_args(1) == 1);
}

test decide_args_missing_token {
    assert(decide_args(2) == 1);
}

test decide_args_complete {
    assert(decide_args(3) == 0);
}

test decide_args_extra_arguments_are_ignored {
    assert(decide_args(5) == 0);
}

test decide_result_clean_response {
    assert(decide_result(0, false) == 0);
}

test decide_result_errors_field_is_a_failure {
    assert(decide_result(0, true) == 1);
}

test decide_result_curl_failed {
    assert(decide_result(6, false) == 1);
}

test decide_result_curl_failed_and_errors_field {
    assert(decide_result(7, true) == 1);
}
