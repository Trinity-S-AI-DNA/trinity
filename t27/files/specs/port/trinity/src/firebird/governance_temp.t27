// @origin(manual) @regen(manual-impl)
// Port of gHashTag/trinity src/firebird/governance_temp.zig at b794aff58858,
// a deinit fix for governance.zig: the original walks the appeals map and
// frees, per appeal, appeal_id, appeal_reason and every evidence URL, then
// deinits evidence_urls and the appeals map itself. original_violation is
// deliberately NOT freed - it is a deep copy of duped_violation and dies
// with the appeals map (original lines 9-11).
//
// Allocator access, map iteration and collection deinit are plumbing the
// .t27 world cannot express. The decision the function encodes is the
// pure part below: how many allocations one appeal hands back, the one
// allocation it must never free, and how the walk sums across the whole
// map.

module port::trinity::src::firebird::governance_temp;

// One appeal as the deinit decision reads it: the number of evidence URLs
// it carries. appeal_id and appeal_reason are always freed, so they need
// no flag; original_violation is not this struct's business at all.
struct Appeal {
    evidence_count: u32,
}

// Number of allocator.free calls the original makes for one appeal:
// appeal_id (line 8), appeal_reason (line 12) and one per evidence URL
// (lines 13-15). evidence_urls itself is deinited, not freed.
pub fn appeal_free_count(evidence_count: u32) u32 {
    return 2 + evidence_count;
}

// original_violation must never be freed in the walk: it is a copy of
// duped_violation (deep copy owned by the HashMap) and is freed when the
// appeals map itself deinits (original lines 9-11, the commented-out free).
pub fn frees_original_violation() bool {
    return false;
}

// The original's while loop over the appeals map, as a count: how many
// allocator.free calls one full walk performs before the final
// appeals-map deinit.
pub fn deinit_free_total(evidence_counts: []u32) u32 {
    var total: u32 = 0;
    for n in evidence_counts {
        total = total + appeal_free_count(n);
    }
    return total;
}

// The original deinit itself. Walking the appeals map, calling the
// allocator and deiniting the collections are plumbing the .t27 world
// cannot express, so the shell stays a bare return and the caller keeps
// the allocator. Every decision it encodes is a tested function above.
pub fn deinit() void {
    return;
}

test appeal_free_count_matches_original {
    const plain = Appeal { evidence_count: 0 };
    const with_evidence = Appeal { evidence_count: 3 };
    assert(appeal_free_count(plain.evidence_count) == 2);
    assert(appeal_free_count(with_evidence.evidence_count) == 5);
}

test original_violation_never_freed {
    assert(frees_original_violation() == false);
}

test deinit_free_total_walks_map {
    var counts: [3]u32 = [1, 0, 2];
    assert(deinit_free_total(&counts) == 9);
}
