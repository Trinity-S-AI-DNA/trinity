module port::trinity::src::storm::experience_engine;

// Port of gHashTag/trinity:src/storm/experience_engine.zig @ cdb78c219135
// (STORM P3 "Memory and Speed": consult experience, save episodes, blacklist.)
//
// Decisions ported as code (pure):
//   - init     -> default episodes dir ".trinity/experience/episodes"
//     (original line 43) plus empty blacklist state. The original's error
//     union never fires (line 44 swallows makePath errors), so the port
//     returns the engine directly.
//   - deinit   -> releases the blacklist state. The original drops its
//     StringHashMap; the port resets the fixed-capacity blacklist to empty.
//   - consult  -> membership test: a task is blacklisted iff it equals one of
//     the codes currently held (original line 60: map.get(task) != null).
//     The original's map is std.StringHashMap(Error); the port carries the
//     codes in a fixed-capacity array plus a count (no allocation). Only
//     codes within blacklist_len are entries; spare slots are not.
//
// Plumbing, not ported (named per the port protocol):
//   - allocator (original line 38, std.mem.Allocator): used only to build the
//     map; the port's fixed array needs no allocator.
//   - makePath(".trinity/experience/episodes") (original line 44): filesystem
//     side effect; the port keeps the dir as data only.
//   - EpisodeData / Result / SimilarTask shapes (original lines 9-33):
//     carried as structs; no ported decision reads them in the P3 slice.
//
// Per the port protocol, no test calls ExperienceEngine_deinit; its body is
// still real code (a compiling reset), not an undefined stub.

pub const Error = struct {
    code: []const u8,
    message: []const u8,
};

pub const EpisodeData = struct {
    task: []const u8,
    timestamp: u64,
    results: []const Result,
};

pub const Result = struct {
    success: bool,
    message: []const u8,
    duration_ms: u64,
    exit_code: u32,
};

pub const ConsultResult = struct {
    is_blacklisted: bool,
};

pub const SimilarTask = struct {
    task: []const u8,
    distance: usize,
};

pub const ExperienceEngine = struct {
    episodes_dir: []const u8,
    blacklist: [8][]const u8,
    blacklist_len: usize,
};

fn ExperienceEngine_init() ExperienceEngine {
    return ExperienceEngine{
        .episodes_dir = ".trinity/experience/episodes",
        .blacklist = ["", "", "", "", "", "", "", ""],
        .blacklist_len = 0,
    };
}

fn ExperienceEngine_deinit(self: *ExperienceEngine) void {
    self.blacklist_len = 0;
}

fn ExperienceEngine_consult(self: *ExperienceEngine, task: []const u8) ConsultResult {
    var found: bool = false;
    var seen: usize = 0;
    for code in self.blacklist {
        if (seen < self.blacklist_len) {
            if (task == code) {
                found = true;
            }
        }
        seen = seen + 1;
    }
    return ConsultResult{
        .is_blacklisted = found,
    };
}

test ExperienceEngine_init_defaults {
    var engine: ExperienceEngine = ExperienceEngine_init();
    assert(engine.episodes_dir == ".trinity/experience/episodes");
    assert(engine.blacklist_len == 0);
    var fresh: ConsultResult = ExperienceEngine_consult(&engine, "rm -rf /");
    assert(!fresh.is_blacklisted);
}

test ExperienceEngine_consult_not_blacklisted {
    var engine: ExperienceEngine = ExperienceEngine{
        .episodes_dir = ".trinity/experience/episodes",
        .blacklist = ["rm -rf /", "chmod 777 /", "", "", "", "", "", ""],
        .blacklist_len = 2,
    };
    var result: ConsultResult = ExperienceEngine_consult(&engine, "test_task");
    assert(!result.is_blacklisted);
}

test ExperienceEngine_consult_blacklisted {
    var engine: ExperienceEngine = ExperienceEngine{
        .episodes_dir = ".trinity/experience/episodes",
        .blacklist = ["rm -rf /", "chmod 777 /", "", "", "", "", "", ""],
        .blacklist_len = 2,
    };
    var result: ConsultResult = ExperienceEngine_consult(&engine, "chmod 777 /");
    assert(result.is_blacklisted);
}

test ExperienceEngine_consult_exact_match_only {
    var engine: ExperienceEngine = ExperienceEngine{
        .episodes_dir = ".trinity/experience/episodes",
        .blacklist = ["rm -rf /", "", "", "", "", "", "", ""],
        .blacklist_len = 1,
    };
    var result: ConsultResult = ExperienceEngine_consult(&engine, "rm -rf ./build");
    assert(!result.is_blacklisted);
}
