// module: server_main - HTTP server main for the trinity port stub.

// 1. health classifier: returns 1 for a health probe request, 0 for anything else.
pub fn classify_kind(request: str) u8 {
    if (contains(request, "GET /health ")) {
        return 1;
    }
    return 0;
}

pub fn is_health(request: str) bool {
    return classify_kind(request) == 1;
}

// 2. substring search: plain double loop, safe on short haystacks and empty needles.
pub fn contains(haystack: str, needle: str) bool {
    if (needle.len > haystack.len) {
        return false;
    }
    var i: usize = 0;
    while (i + needle.len <= haystack.len) {
        var matched = true;
        var j: usize = 0;
        while (j < needle.len) {
            if (haystack[i + j] != needle[j]) {
                matched = false;
            }
            j += 1;
        }
        if (matched) {
            return true;
        }
        i += 1;
    }
    return false;
}

// 3. port parsing: accepts 1..5 ASCII digits, rejects empty, non-digit, and out-of-range input.
pub fn parse_port(raw: str) u16 {
    if (raw.len == 0 or raw.len > 5) {
        return 8080;
    }
    var value: u32 = 0;
    for c in raw {
        const d = @as(u32, c - '0');
        if (d > 9) {
            return 8080;
        }
        value = (value * 10) + d;
    }
    if (value == 0 or value > 65535) {
        return 8080;
    }
    return @intCast(value);
}

// 4. port resolution: env value wins when present and valid, otherwise 8080.
pub fn resolve_port(has_env: bool, raw: str) u16 {
    if (!has_env) {
        return 8080;
    }
    return parse_port(raw);
}

// 5. entry point: startup self-check of the classifier before the server loop is wired.
pub fn main() void {
    assert(classify_kind("GET /health HTTP/1.1") == 1);
    assert(classify_kind("GET / HTTP/1.1") == 0);
}

test "health classification" {
    assert(classify_kind("GET /health HTTP/1.1") == 1);
    assert(classify_kind("GET /healthz HTTP/1.1") == 0);
    assert(classify_kind("GET / HTTP/1.1") == 0);
    assert(is_health("GET /health HTTP/1.1"));
    assert(!is_health("GET / HTTP/1.1"));
}

test "substring search" {
    assert(contains("GET /health HTTP/1.1", "GET /health "));
    assert(!contains("GET / HTTP/1.1", "GET /health "));
    assert(contains("x", ""));
    assert(!contains("x", "xy"));
}

test "port parsing" {
    assert(parse_port("3000") == 3000);
    assert(parse_port("1") == 1);
    assert(parse_port("65535") == 65535);
    assert(parse_port("") == 8080);
    assert(parse_port("123456") == 8080);
    assert(parse_port("99999") == 8080);
    assert(parse_port("65536") == 8080);
    assert(parse_port("12x4") == 8080);
    assert(parse_port("0") == 8080);
}

test "port resolution" {
    assert(resolve_port(false, "3000") == 8080);
    assert(resolve_port(true, "3000") == 3000);
    assert(resolve_port(true, "abc") == 8080);
    assert(resolve_port(true, "") == 8080);
}
