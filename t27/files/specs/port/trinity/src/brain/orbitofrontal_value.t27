module port::trinity::src::brain::orbitofrontal_value;

pub const PHI: f64 = 1.6180339887498948482;

pub const FormatDecision = enum {
    gf16,
    bf16,
    fp16,
    ternary,
};

pub const LayerAnalysis = struct {
    layer_idx: usize,
    weight_std: f64,
    weight_range: f64,
    recommended: FormatDecision,
    confidence: f64,
};

// Helper functions for math operations
fn abs(x: f64) -> f64 {
    if (x < 0.0) {
        return -x;
    }
    return x;
}

fn sqrt(x: f64) -> f64 {
    if (x <= 0.0) {
        return 0.0;
    }
    // Newton's method: y_{n+1} = (y_n + x/y_n) / 2
    var y = x;
    var i = 0;
    while (i < 50) {
        y = (y + x / y) / 2.0;
        i = i + 1;
    }
    return y;
}

fn max(a: f64, b: f64) -> f64 {
    if (a > b) {
        return a;
    }
    return b;
}

fn min(a: f64, b: f64) -> f64 {
    if (a < b) {
        return a;
    }
    return b;
}

pub fn recommendFormat(weight_std: f64, weight_range: f64) FormatDecision {
    if (weight_std < 0.1) {
        return .ternary;
    }
    if (weight_range < 2.0 and weight_std < 0.5) {
        return .gf16;
    }
    if (weight_range > 100.0) {
        return .bf16;
    }
    return .fp16;
}

pub fn analyzeLayer(weights: []const f64, layer_idx: usize) LayerAnalysis {
    var sum: f64 = 0;
    var sum_sq: f64 = 0;
    var min_val: f64 = 1e300; // Large positive number
    var max_val: f64 = -1e300; // Large negative number

    for (weights) |w| {
        sum += w;
        sum_sq += w * w;
        if (w < min_val) {
            min_val = w;
        }
        if (w > max_val) {
            max_val = w;
        }
    }

    const n_f64: f64 = weights.len as f64;
    const mean = sum / n_f64;
    const variance = sum_sq / n_f64 - mean * mean;
    const std_dev = sqrt(max(variance, 0));
    const range = max_val - min_val;

    const recommended = recommendFormat(std_dev, range);

    // The Zig source is an exhaustive `switch (recommended)` with block arms;
    // the t27 parser takes no `{` after `.tag =>`, so the same four arms are
    // written as an if / else-if chain over the enum tag.
    const PHI_INV: f64 = 1.0 / PHI;
    var confidence: f64 = 0.5;
    if (recommended == .gf16) {
        confidence = 1.0 - abs(std_dev - PHI_INV) / PHI_INV;
    } else if (recommended == .ternary) {
        confidence = 1.0 - std_dev;
    } else if (recommended == .bf16) {
        confidence = min(range / 1000.0, 0.95);
    } else if (recommended == .fp16) {
        confidence = 0.7;
    }

    return .{
        .layer_idx = layer_idx,
        .weight_std = std_dev,
        .weight_range = range,
        .recommended = recommended,
        .confidence = min(max(confidence, 0.0), 1.0),
    };
}

test "recommend format for small weights" {
    assert(recommendFormat(0.05, 0.3) == .ternary);
}

test "recommend format for medium weights" {
    assert(recommendFormat(0.3, 1.5) == .gf16);
}

test "recommend format for large range" {
    assert(recommendFormat(5.0, 500.0) == .bf16);
}

test "analyze layer" {
    var weights: [6]f64 = [0.1, 0.2, -0.1, 0.3, -0.2, 0.05];
    const analysis = analyzeLayer(&weights, 0);
    assert(analysis.weight_std > 0);
    assert(analysis.weight_range > 0);
}