module port::trinity::src::brain::weber_tuning;

pub const PHI: f64 = 1.6180339887498948482;

pub const WeberLevel = enum(u8) {
    fine = 0,
    medium = 1,
    coarse = 2,
};

pub fn weberQuantize(value: f64, jnd_fraction: f64) -> i2 {
    if (@abs(value) < jnd_fraction * 0.5) return 0;
    if (value > 0) return 1;
    if (value < 0) return -1;
    return 0;
}

pub fn weberQuantizeLevels(value: f64, levels: usize) -> i64 {
    if (value == 0) return 0;
    const sign: i64 = if (value > 0) 1 else -1;
    const abs_v = @abs(value);
    const log_val = std.math.log(f64, std.math.e, abs_v + 1.0);
    const quantized = @round(log_val * @as(f64, @floatFromInt(levels)) / 5.0);
    return sign * @as(i64, @intFromFloat(@min(@abs(quantized), @as(f64, @floatFromInt(levels)))));
}

pub fn adaptiveJND(base_jnd: f64, magnitude: f64) -> f64 {
    return base_jnd * (1.0 + std.math.log1p(@abs(magnitude)));
}

pub fn ternaryEncode(values: []const f64, jnd: f64, output: []i2) -> void {
    var i: usize = 0;
    while (i < values.len) {
        output[i] = weberQuantize(values[i], jnd);
        i += 1;
    }
}

pub fn ternaryStats(encoded: []const i2) -> struct { pos: usize, neg: usize, zero: usize, sparsity: f64 } {
    var pos: usize = 0;
    var neg: usize = 0;
    var zero: usize = 0;
    for (encoded) |v| {
        if (v > 0) pos += 1;
        if (v < 0) neg += 1;
        if (v == 0) zero += 1;
    }
    return .{
        .pos = pos,
        .neg = neg,
        .zero = zero,
        .sparsity = @as(f64, @floatFromInt(zero)) / @as(f64, @floatFromInt(encoded.len)),
    };
}

test weber_quantize_positive {
    assert(weberQuantize(0.5, 0.1) == 1);
}

test weber_quantize_negative {
    assert(weberQuantize(-0.5, 0.1) == -1);
}

test weber_quantize_small {
    assert(weberQuantize(0.01, 0.1) == 0);
}

test weber_quantize_levels_zero {
    assert(weberQuantizeLevels(0.0, 10) == 0);
}

test weber_quantize_levels_positive {
    const result = weberQuantizeLevels(2.0, 5);
    assert(result > 0);
}

test weber_quantize_levels_negative {
    const result = weberQuantizeLevels(-2.0, 5);
    assert(result < 0);
}

test adaptive_jnd_small_magnitude {
    const jnd = adaptiveJND(0.1, 0.1);
    assert(jnd > 0.1);
}

test adaptive_jnd_large_magnitude {
    const jnd = adaptiveJND(0.1, 10.0);
    assert(jnd > adaptiveJND(0.1, 0.1));
}

test ternary_encode_basic {
    const values = [_]f64{ 0.5, -0.3, 0.01, 0.8, -0.02 };
    var encoded: [5]i2 = undefined;
    ternaryEncode(&values, 0.1, &encoded);
    
    assert(encoded[0] == 1);
    assert(encoded[1] == -1);
    assert(encoded[2] == 0);
    assert(encoded[3] == 1);
    assert(encoded[4] == 0);
}

test ternary_stats_basic {
    const encoded = [_]i2{ 1, -1, 0, 1, 0 };
    const stats = ternaryStats(&encoded);
    
    assert(stats.pos == 2);
    assert(stats.neg == 1);
    assert(stats.zero == 2);
    assert(stats.sparsity == 2.0 / 5.0);
}

test ternary_stats_all_positive {
    const encoded = [_]i2{ 1, 1, 1 };
    const stats = ternaryStats(&encoded);
    
    assert(stats.pos == 3);
    assert(stats.neg == 0);
    assert(stats.zero == 0);
    assert(stats.sparsity == 0.0);
}

test ternary_stats_all_zero {
    const encoded = [_]i2{ 0, 0, 0 };
    const stats = ternaryStats(&encoded);
    
    assert(stats.pos == 0);
    assert(stats.neg == 0);
    assert(stats.zero == 3);
    assert(stats.sparsity == 1.0);
}