module port::trinity::src::vibeec::p2p_module;

// Port of gHashTag/trinity src/vibeec/p2p_module.zig at 391882836c29 (61
// lines, 4 functions), re-authored here so the code is generated from .t27
// instead of written by hand.
//
// Three pieces of Zig plumbing have no .t27 form and are carried as data:
// - std.ArrayListUnmanaged(Node) grows at runtime; the original seeds exactly
//   10 nodes and never grows the list, so the port stores a fixed [10] array
//   plus a count.
// - std.mem.Allocator is the outside world; the port carries it as an opaque
//   i32 handle the caller passes in.
// - std.debug.print is the console; the port returns the swarm-health marker
//   the original prints and lets the caller print it.

pub const GOSSIP_EARNINGS: f64 = 0.01;

pub struct Node {
    id: [8]u8,
    balance: f64,
    latency_ms: u64,
}

pub struct SwarmManager {
    allocator: i32,
    nodes: [10]Node,
    nodes_len: usize,
    total_swarm_size: usize,
    gossip_interval_ms: u64,
}

// The original builds node i with std.fmt.bufPrint(&id, "{d}", .{i}) - the
// decimal digit of the seed index lands in byte 0 of the 8-byte id buffer
// ('0' is 48), balance starts at 0.0 and latency at 10 + i * 5 ms. d is that
// seed index as a digit.
pub fn seed_node(d: u8) -> Node {
    var id: [8]u8 = [0, 0, 0, 0, 0, 0, 0, 0];
    id[0] = 48 + d;
    return Node {
        id: id,
        balance: 0.0,
        latency_ms: 10 + d * 5,
    };
}

// The original returns !SwarmManager; its only error path is the allocator
// failing, which is plumbing, so the port returns the manager directly and
// seeds the same 10 representative nodes.
pub fn SwarmManager_init(allocator: i32) -> SwarmManager {
    return SwarmManager {
        allocator: allocator,
        nodes: [seed_node(0), seed_node(1), seed_node(2), seed_node(3), seed_node(4), seed_node(5), seed_node(6), seed_node(7), seed_node(8), seed_node(9)],
        nodes_len: 10,
        total_swarm_size: 10000,
        gossip_interval_ms: 500,
    };
}

// The original frees the nodes ArrayList back to the allocator. The
// fixed-capacity port owns its storage inline, so releasing the nodes is
// clearing them: the count returns to zero and the slots are free for reuse.
pub fn SwarmManager_deinit(self: *SwarmManager) void {
    self.nodes_len = 0;
}

// The original prints "Swarm Health: BLESSED" before running a gossip round.
// The marker is the decision (the swarm is healthy); the print is plumbing.
pub fn gossip_health() -> str {
    return "BLESSED";
}

// One gossip round pays GOSSIP_EARNINGS to every node in the swarm
// (original: node.balance += 0.01 for each node).
pub fn SwarmManager_simulateGossip(self: *SwarmManager) void {
    var i: usize = 0;
    while (i < self.nodes_len) {
        self.nodes[i].balance += GOSSIP_EARNINGS;
        i += 1;
    }
}

// The optimal job node is the one with the strictly smallest latency_ms;
// ties keep the earlier node (strict <, as in the original), and an empty
// swarm has none (the original's null).
pub fn SwarmManager_findOptimalJobNode(self: *SwarmManager) -> ?Node {
    if (self.nodes_len == 0) {
        return null;
    }
    var best: usize = 0;
    var min_latency: u64 = self.nodes[0].latency_ms;
    var i: usize = 1;
    while (i < self.nodes_len) {
        if (self.nodes[i].latency_ms < min_latency) {
            min_latency = self.nodes[i].latency_ms;
            best = i;
        }
        i += 1;
    }
    return self.nodes[best];
}

test init_seeds_ten_nodes_with_id_balance_latency {
    var m = SwarmManager_init(1);
    assert(m.nodes_len == 10);
    assert(m.total_swarm_size == 10000);
    assert(m.gossip_interval_ms == 500);
    assert(m.nodes[0].latency_ms == 10);
    assert(m.nodes[1].latency_ms == 15);
    assert(m.nodes[9].latency_ms == 55);
    assert(m.nodes[0].balance == 0.0);
    assert(m.nodes[0].id[0] == 48);
    assert(m.nodes[9].id[0] == 57);
}

test seed_node_writes_the_decimal_digit {
    const n0 = seed_node(0);
    assert(n0.id[0] == 48);
    const n5 = seed_node(5);
    assert(n5.id[0] == 53);
    assert(n5.id[7] == 0);
}

test gossip_pays_every_node {
    var m = SwarmManager_init(1);
    SwarmManager_simulateGossip(&m);
    assert(m.nodes[0].balance == 0.01);
    assert(m.nodes[9].balance == 0.01);
    SwarmManager_simulateGossip(&m);
    assert(m.nodes[0].balance == 0.02);
}

test gossip_health_marker_is_blessed {
    assert(gossip_health() == "BLESSED");
}

test find_optimal_prefers_the_lowest_latency {
    var m = SwarmManager_init(1);
    const opt = SwarmManager_findOptimalJobNode(&m);
    assert(opt != null);
    assert(opt.?.latency_ms == 10);
    assert(opt.?.balance == 0.0);
}

test find_optimal_returns_null_for_an_empty_swarm {
    var m = SwarmManager_init(1);
    m.nodes_len = 0;
    const opt = SwarmManager_findOptimalJobNode(&m);
    assert(opt == null);
}

test deinit_releases_the_nodes {
    var m = SwarmManager_init(1);
    assert(m.nodes_len == 10);
    SwarmManager_deinit(&m);
    assert(m.nodes_len == 0);
}
