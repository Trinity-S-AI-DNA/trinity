module port::validation_engine;

// Port of gHashTag/trinity src/vibeec/validation_engine.zig (51 lines at
// fc914dbaa7ab), re-authored here so the code is generated from .t27
// instead of written by hand.
//
// Two pieces of Zig plumbing have no .t27 form and are carried as data:
// - std.ArrayListUnmanaged([]const u8) grows at runtime; the three laws can
//   raise at most three violations, so the port stores a fixed [3] array
//   plus a count.
// - std.mem.Allocator is the outside world; the port carries it as an
//   opaque i32 handle the caller passes in.

pub struct ValidationResult {
    passed: bool,
    violations: [3][]const u8,
    violation_count: usize,
    allocator: i32,
}

pub struct Validator {
    allocator: i32,
}

// The decision inside the original's std.mem.indexOf(u8, code, needle)
// checks: does the needle occur in the code? Zig's null result becomes
// false here.
fn contains(code: []const u8, needle: []const u8) -> bool {
    if (needle.len == 0) {
        return true;
    }
    if (needle.len > code.len) {
        return false;
    }
    var i: usize = 0;
    while (i + needle.len <= code.len) {
        var j: usize = 0;
        var matched = true;
        while (j < needle.len) {
            if (code[i + j] != needle[j]) {
                matched = false;
            }
            j += 1;
        }
        if (matched) {
            return true;
        }
        i += 1;
    }
    return false;
}

// The original hands the violations list back to self.allocator. The
// fixed-capacity port owns its storage inline, so releasing the list is
// clearing it: the count returns to zero and the slots are free for reuse.
pub fn ValidationResult_deinit(self: *ValidationResult) void {
    self.violation_count = 0;
}

pub fn Validator_init(allocator: i32) -> Validator {
    return Validator {
        allocator: allocator
    };
}

// The original returns !ValidationResult; its only error path is the
// allocator failing, which is plumbing, so the port returns the result
// directly.
pub fn Validator_validate(self: *Validator, code: []const u8) -> ValidationResult {
    var violations: [3][]const u8 = ["", "", ""];
    var count: usize = 0;
    var passed = true;

    // Law 1: All code must have a 'main' entry point (The Alpha)
    if (!contains(code, "main")) {
        violations[count] = "Law Violation: Code lacks a 'main' entry point (The Alpha).";
        count += 1;
        passed = false;
    }

    // Law 2: No Forbidden Binary Logic (Mock)
    if (contains(code, "cursed_binary_hack")) {
        violations[count] = "Law Violation: Usage of 'cursed_binary_hack' detected. Heresy!";
        count += 1;
        passed = false;
    }

    // Law 3: Code must not be empty
    if (code.len < 10) {
        violations[count] = "Law Violation: Code is too sparse (Void).";
        count += 1;
        passed = false;
    }

    return ValidationResult {
        passed: passed,
        violations: violations,
        violation_count: count,
        allocator: self.allocator
    };
}

test validate_clean_code_passes {
    var v = Validator_init(1);
    const r = Validator_validate(&v, "pub fn main() -> i32 { return 0; }");
    assert(r.passed);
    assert(r.violation_count == 0);
}

test deinit_releases_the_violation_list {
    // The original's deinit frees the violations ArrayList back to the
    // allocator; the fixed-capacity port releases the list by clearing
    // its count.
    var r = ValidationResult {
        passed: false,
        violations: ["Law Violation: Code is too sparse (Void).", "", ""],
        violation_count: 1,
        allocator: 1
    };
    assert(r.violation_count == 1);
    ValidationResult_deinit(&r);
    assert(r.violation_count == 0);
}

test validate_missing_main_flags_the_alpha {
    var v = Validator_init(1);
    const r = Validator_validate(&v, "pub fn helper() -> i32 { return 1; }");
    assert(!r.passed);
    assert(r.violation_count == 1);
    assert(r.violations[0] == "Law Violation: Code lacks a 'main' entry point (The Alpha).");
}

test validate_cursed_binary_hack_flags_mock {
    var v = Validator_init(1);
    const r = Validator_validate(&v, "fn main() { cursed_binary_hack(); }");
    assert(!r.passed);
    assert(r.violation_count == 1);
    assert(r.violations[0] == "Law Violation: Usage of 'cursed_binary_hack' detected. Heresy!");
}

test validate_short_code_flags_void {
    var v = Validator_init(1);
    const r = Validator_validate(&v, "fn main()");
    assert(!r.passed);
    assert(r.violation_count == 1);
    assert(r.violations[0] == "Law Violation: Code is too sparse (Void).");
}

test validate_reports_all_violations_in_law_order {
    var v = Validator_init(1);
    const r = Validator_validate(&v, "x cursed_binary_hack x");
    assert(!r.passed);
    assert(r.violation_count == 2);
    assert(r.violations[0] == "Law Violation: Code lacks a 'main' entry point (The Alpha).");
    assert(r.violations[1] == "Law Violation: Usage of 'cursed_binary_hack' detected. Heresy!");
}

test contains_matches_the_way_indexOf_does {
    assert(contains("fn main() {}", "main"));
    assert(!contains("fn helper() {}", "main"));
    assert(contains("cursed_binary_hack", "cursed_binary_hack"));
    assert(!contains("cursed", "cursed_binary_hack"));
    assert(contains("anything", ""));
}
