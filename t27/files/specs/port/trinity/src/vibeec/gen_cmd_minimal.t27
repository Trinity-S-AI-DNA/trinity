test main_usage {
    // Test that main returns 1 when argc < 2 (not enough arguments)
    const result = main(1, "");
    assert(result == 1);
}

test main_success {
    // Test that main returns 0 when argc >= 2 (enough arguments)
    const result = main(2, "input.tri");
    assert(result == 0);
}