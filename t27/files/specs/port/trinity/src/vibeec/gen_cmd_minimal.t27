module port::vibeec::gen_cmd_minimal;

pub fn main(argc: u32, argv: []const u8) -> i32 {
    // Check if we have at least one argument (input file)
    if (argc < 2) {
        // Usage: vibeec <input.tri>
        return 1;
    }
    
    // Input file path is at argv[1]
