// Port of gHashTag/trinity:src/tri/gen_image.zig (tri/image, basic image
// operations). Rewritten 2026-10-07: the first port kept init, setPixel and
// deinit as bodies of `undefined;` over `*std.mem.Allocator`, so nothing they
// do was checked, and its tests covered only two helpers and `always_true`.
// The Zig: init allocates width * height pixels and sets every one to black
// (r = g = b = 0); setPixel writes pixels[y * width + x] when x < width and
// y < height and ignores the call otherwise; deinit frees the pixels. Here
// the allocator becomes a caller buffer: Image_init takes the pixel storage
// and uses its first width * height entries (a shorter buffer traps on the
// slice, where the Zig's alloc would fail), so there is nothing to free and
// deinit is gone. The Zig's nested Image.Color (r, g, b) is ImageColor.

module port::trinity.src.tri.gen_image;

pub const ImageColor = struct {
    r: u8,
    g: u8,
    b: u8,
};

pub const Image = struct {
    width: usize,
    height: usize,
    pixels: []ImageColor,
};

fn alloc_size(width: usize, height: usize) -> usize {
    return width * height;
}

fn bounds_check(x: usize, y: usize, width: usize, height: usize) -> bool {
    if (x < width) {
        if (y < height) {
            return true;
        }
    }
    return false;
}

pub fn Image_init(storage: []ImageColor, width: usize, height: usize) -> Image {
    const pixels = storage[0..alloc_size(width, height)];
    var i: usize = 0;
    while (i < pixels.len) {
        pixels[i] = ImageColor{ .r = 0, .g = 0, .b = 0 };
        i = i + 1;
    }
    return Image{ .width = width, .height = height, .pixels = pixels };
}

pub fn Image_setPixel(img: *Image, x: usize, y: usize, color: ImageColor) -> void {
    if (bounds_check(x, y, img.width, img.height)) {
        img.pixels[y * img.width + x] = color;
    }
}

// ═══════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════

// the sum over the image of r + 2 g + 3 b, each pixel weighted by 1 + its index
fn weighted(img: Image) -> usize {
    var s: usize = 0;
    var i: usize = 0;
    while (i < img.pixels.len) {
        const p = img.pixels[i];
        s = s + (i + 1) * ((p.r as usize) + 2 * (p.g as usize) + 3 * (p.b as usize));
        i = i + 1;
    }
    return s;
}

// init on a dirty 4x3 buffer: 12 pixels, all black, the 13th untouched
fn init_clears() -> bool {
    var storage: [13]ImageColor = [ImageColor{ .r = 9, .g = 9, .b = 9 }] ** 13;
    const img = Image_init(&storage, 4, 3);
    return img.width == 4 and img.height == 3 and img.pixels.len == 12 and weighted(img) == 0
        and storage[12].r == 9 and storage[12].b == 9;
}

// setPixel (x = 1, y = 2) on a 4x3 image writes index 2 * 4 + 1 = 9 and no other
fn set_one() -> usize {
    var storage: [12]ImageColor = [ImageColor{ .r = 0, .g = 0, .b = 0 }] ** 12;
    var img = Image_init(&storage, 4, 3);
    Image_setPixel(&img, 1, 2, ImageColor{ .r = 1, .g = 2, .b = 3 });
    return weighted(img);
}

// x == width and y == height are outside: neither call writes anything
fn set_outside() -> usize {
    var storage: [12]ImageColor = [ImageColor{ .r = 0, .g = 0, .b = 0 }] ** 12;
    var img = Image_init(&storage, 4, 3);
    Image_setPixel(&img, 4, 0, ImageColor{ .r = 5, .g = 5, .b = 5 });
    Image_setPixel(&img, 0, 3, ImageColor{ .r = 5, .g = 5, .b = 5 });
    Image_setPixel(&img, 3, 2, ImageColor{ .r = 1, .g = 0, .b = 0 });
    return weighted(img);
}

test bounds_check_true {
    assert(bounds_check(5, 5, 10, 10) == true);
    assert(bounds_check(0, 0, 1, 1) == true);
}

test bounds_check_false_x {
    assert(bounds_check(15, 5, 10, 10) == false);
    assert(bounds_check(10, 5, 10, 10) == false);
}

test bounds_check_false_y {
    assert(bounds_check(5, 15, 10, 10) == false);
    assert(bounds_check(5, 10, 10, 10) == false);
}

test alloc_size {
    assert(alloc_size(10, 10) == 100);
    assert(alloc_size(4, 3) == 12);
    assert(alloc_size(0, 0) == 0);
    assert(alloc_size(1, 1) == 1);
}

test init_sets_every_pixel_black {
    assert(init_clears() == true);
}

// pixel 9 weighs 10: 10 * (1 + 2 * 2 + 3 * 3) = 140
test set_pixel_writes_y_times_width_plus_x {
    assert(set_one() == 140);
}

// only (3, 2), index 11 weight 12, lands: 12 * 1 = 12
test set_pixel_outside_is_ignored {
    assert(set_outside() == 12);
}
