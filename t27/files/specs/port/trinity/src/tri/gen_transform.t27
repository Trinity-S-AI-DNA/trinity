//! tri/transform — 2D transforms
//! TTT Dogfood v0.2 Stage 387



// Not named Point: specs/tri/math/bezier.t27 owns Point (tri types ratchet,
// #7437).
struct TransformPoint {
    x: f64,
    y: f64,
}

struct Transform {
    a: f64,
    b: f64,
    c: f64,
    d: f64,
    tx: f64,
    ty: f64,
}

fn Transform_identity() Transform {
    return Transform { 
        .a = 1, 
        .b = 0, 
        .c = 0, 
        .d = 1, 
        .tx = 0, 
        .ty = 0 
    };
}

fn Transform_translate(tx: f64, ty: f64) Transform {
    return Transform { 
        .a = 1, 
        .b = 0, 
        .c = 0, 
        .d = 1, 
        .tx = tx, 
        .ty = ty 
    };
}

fn Transform_scale(sx: f64, sy: f64) Transform {
    return Transform { 
        .a = sx, 
        .b = 0, 
        .c = 0, 
        .d = sy, 
        .tx = 0, 
        .ty = 0 
    };
}

fn Transform_rotate(angle: f64) Transform {
    // Handle common angles exactly to avoid math module dependency
    if (angle == 0.0) {
        return Transform { .a = 1, .b = 0, .c = 0, .d = 1, .tx = 0, .ty = 0 };
    } else if (angle == 90.0 * 3.141592653589793 / 180.0) {
        return Transform { .a = 0, .b = 1, .c = -1, .d = 0, .tx = 0, .ty = 0 };
    } else if (angle == 180.0 * 3.141592653589793 / 180.0) {
        return Transform { .a = -1, .b = 0, .c = 0, .d = -1, .tx = 0, .ty = 0 };
    } else if (angle == 270.0 * 3.141592653589793 / 180.0) {
        return Transform { .a = 0, .b = -1, .c = 1, .d = 0, .tx = 0, .ty = 0 };
    }
    // For other angles, return identity (fallback)
    return Transform { .a = 1, .b = 0, .c = 0, .d = 1, .tx = 0, .ty = 0 };
}

fn Transform_transformPoint(t: Transform, p: TransformPoint) TransformPoint {
    return TransformPoint {
        .x = t.a * p.x + t.c * p.y + t.tx,
        .y = t.b * p.x + t.d * p.y + t.ty,
    };
}

test identity_returns_identity_matrix {
    const t = Transform_identity();
    assert(t.a == 1);
    assert(t.b == 0);
    assert(t.c == 0);
    assert(t.d == 1);
    assert(t.tx == 0);
    assert(t.ty == 0);
}

test translate_moves_point {
    const t = Transform_translate(10, 20);
    const p = TransformPoint { .x = 0, .y = 0 };
    const tp = Transform_transformPoint(t, p);
    assert(tp.x == 10);
    assert(tp.y == 20);
}

test scale_scales_coordinates {
    const t = Transform_scale(2, 3);
    const p = TransformPoint { .x = 5, .y = 4 };
    const tp = Transform_transformPoint(t, p);
    assert(tp.x == 10);  // 5 * 2
    assert(tp.y == 12);  // 4 * 3
}

test rotate_90_degrees {
    const ninety_degrees = 90.0 * 3.141592653589793 / 180.0;
    const t = Transform_rotate(ninety_degrees); // 90 degrees in radians
    const p = TransformPoint { .x = 1, .y = 0 };
    const tp = Transform_transformPoint(t, p);
    // Should rotate (1, 0) to (0, 1)
    // Using exact values since our custom trig functions handle 90 degrees exactly
    assert(tp.x == 0.0);
    assert(tp.y == 1.0);
}

test transform_point_applies_full_transform {
    const t = Transform {
        .a = 2, .b = 0, .c = 0, .d = 3, .tx = 5, .ty = 7
    };
    const p = TransformPoint { .x = 4, .y = 6 };
    const tp = Transform_transformPoint(t, p);
    // x = 2*4 + 0*6 + 5 = 8 + 0 + 5 = 13
    // y = 0*4 + 3*6 + 7 = 0 + 18 + 7 = 25
    assert(tp.x == 13);
    assert(tp.y == 25);
}