module port::trinity::src::tri;

pub const Operation = enum { insert, update, delete };

pub const LogEntry = struct {
    op: Operation,
    key: []const u8,
    value: []const u8,
};

pub const Transaction = struct {
    operations: [64]LogEntry,
    len: usize,
    allocator: u32,
};

pub fn Transaction_init(allocator: u32) Transaction {
    var operations_array: [64]LogEntry = undefined;
    for (0..64) |i| {
        operations_array[i] = LogEntry{ .op = .insert, .key = "", .value = "" };
    }
    return Transaction{
        .operations = operations_array,
        .len = 0,
        .allocator = allocator,
    };
}

pub fn Transaction_add(tx: *Transaction, op: Operation, key: []const u8, value: []const u8) bool {
    if (tx.len >= 64) {
        return false;
    }
    tx.operations[tx.len] = LogEntry{ .op = op, .key = key, .value = value };
    tx.len += 1;
    return true;
}

pub fn Transaction_commit(tx: *Transaction) i32 {
    return 0;
}

pub fn Transaction_rollback(tx: *Transaction) i32 {
    return 0;
}

pub fn Transaction_deinit(tx: *Transaction) void {
    tx.len = 0;
}

test "Transaction_init" {
    var tx = Transaction_init(0);
    assert(tx.len == 0);
    assert(tx.operations[0].op == .insert);
    assert(tx.operations[0].key == "");
    assert(tx.operations[0].value == "");
}

test "Transaction_add_insert" {
    var tx = Transaction_init(0);
    var result = Transaction_add(&tx, .insert, "key1", "value1");
    assert(result == true);
    assert(tx.len == 1);
    assert(tx.operations[0].op == .insert);
    assert(tx.operations[0].key == "key1");
    assert(tx.operations[0].value == "value1");
}

test "Transaction_add_multiple" {
    var tx = Transaction_init(0);
    assert(Transaction_add(&tx, .insert, "key1", "value1") == true);
    assert(Transaction_add(&tx, .update, "key2", "value2") == true);
    assert(Transaction_add(&tx, .delete, "key3", "") == true);
    assert(tx.len == 3);
    assert(tx.operations[0].op == .insert);
    assert(tx.operations[1].op == .update);
    assert(tx.operations[2].op == .delete);
    assert(tx.operations[0].key == "key1");
    assert(tx.operations[1].key == "key2");
    assert(tx.operations[2].key == "key3");
}

test "Transaction_add_capacity_limit" {
    var tx = Transaction_init(0);
    // Fill to capacity with repeated adds
    assert(Transaction_add(&tx, .insert, "key1", "value1") == true);
    assert(Transaction_add(&tx, .insert, "key2", "value2") == true);
    assert(Transaction_add(&tx, .insert, "key3", "value3") == true);
    assert(Transaction_add(&tx, .insert, "key4", "value4") == true);
    assert(Transaction_add(&tx, .insert, "key5", "value5") == true);
