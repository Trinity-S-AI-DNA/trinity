    assert(Transaction_add(&tx, .insert, "key8", "value8") == true);
    assert(Transaction_add(&tx, .insert, "key9", "value9") == true);
    assert(Transaction_add(&tx, .insert, "key10", "value10") == true);
    assert(Transaction_add(&tx, .insert, "key11", "value11") == true);
    assert(Transaction_add(&tx, .insert, "key12", "value12") == true);
    assert(Transaction_add(&tx, .insert, "key13", "value13") == true);
    assert(Transaction_add(&tx, .insert, "key14", "value14") == true);
    assert(Transaction_add(&tx, .insert, "key15", "value15") == true);
    assert(Transaction_add(&tx, .insert, "key16", "value16") == true);
    assert(Transaction_add(&tx, .insert, "key17", "value17") == true);
    assert(Transaction_add(&tx, .insert, "key18", "value18") == true);
    assert(Transaction_add(&tx, .insert, "key19", "value19") == true);
    assert(Transaction_add(&tx, .insert, "key20", "value20") == true);
    assert(Transaction_add(&tx, .insert, "key21", "value21") == true);
    assert(Transaction_add(&tx, .insert, "key22", "value22") == true);
    assert(Transaction_add(&tx, .insert, "key23", "value23") == true);
    assert(Transaction_add(&tx, .insert, "key24", "value24") == true);
    assert(Transaction_add(&tx, .insert, "key25", "value25") == true);
    assert(Transaction_add(&tx, .insert, "key26", "value26") == true);
    assert(Transaction_add(&tx, .insert, "key27", "value27") == true);
    assert(Transaction_add(&tx, .insert, "key28", "value28") == true);
    assert(Transaction_add(&tx, .insert, "key29", "value29") == true);
    assert(Transaction_add(&tx, .insert, "key30", "value30") == true);
    assert(Transaction_add(&tx, .insert, "key31", "value31") == true);
    assert(Transaction_add(&tx, .insert, "key32", "value32") == true);
    assert(Transaction_add(&tx, .insert, "key33", "value33") == true);
    assert(Transaction_add(&tx, .insert, "key34", "value34") == true);
    assert(Transaction_add(&tx, .insert, "key35", "value35") == true);
    assert(Transaction_add(&tx, .insert, "key36", "value36") == true);
    assert(Transaction_add(&tx, .insert, "key37", "value37") == true);
    assert(Transaction_add(&tx, .insert, "key38", "value38") == true);
    assert(Transaction_add(&tx, .insert, "key39", "value39") == true);
    assert(Transaction_add(&tx, .insert, "key40", "value40") == true);
    assert(Transaction_add(&tx, .insert, "key41", "value41") == true);
    assert(Transaction_add(&tx, .insert, "key42", "value42") == true);
    assert(Transaction_add(&tx, .insert, "key43", "value43") == true);
    assert(Transaction_add(&tx, .insert, "key44", "value44") == true);
    assert(Transaction_add(&tx, .insert, "key45", "value45") == true);
    assert(Transaction_add(&tx, .insert, "key46", "value46") == true);
    assert(Transaction_add(&tx, .insert, "key47", "value47") == true);
    assert(Transaction_add(&tx, .insert, "key48", "value48") == true);
    assert(Transaction_add(&tx, .insert, "key49", "value49") == true);
    assert(Transaction_add(&tx, .insert, "key50", "value50") == true);
    assert(Transaction_add(&tx, .insert, "key51", "value51") == true);
    assert(Transaction_add(&tx, .insert, "key52", "value52") == true);
    assert(Transaction_add(&tx, .insert, "key53", "value53") == true);
    assert(Transaction_add(&tx, .insert, "key54", "value54") == true);
    assert(Transaction_add(&tx, .insert, "key55", "value55") == true);
    assert(Transaction_add(&tx, .insert, "key56", "value56") == true);
    assert(Transaction_add(&tx, .insert, "key57", "value57") == true);
    assert(Transaction_add(&tx, .insert, "key58", "value58") == true);
    assert(Transaction_add(&tx, .insert, "key59", "value59") == true);
    assert(Transaction_add(&tx, .insert, "key60", "value60") == true);
    assert(Transaction_add(&tx, .insert, "key61", "value61") == true);
    assert(Transaction_add(&tx, .insert, "key62", "value62") == true);
    assert(Transaction_add(&tx, .insert, "key63", "value63") == true);
    assert(Transaction_add(&tx, .insert, "key64", "value64") == true);
    assert(tx.len == 64);
    
    // One more add should fail
    assert(Transaction_add(&tx, .insert, "overflow", "value") == false);
    // Should still be 64, not 65
    assert(tx.len == 64);
}

test "Transaction_deinit" {
    var tx = Transaction_init(0);
    assert(Transaction_add(&tx, .insert, "test_key", "test_value") == true);
    assert(tx.len == 1);
    Transaction_deinit(&tx);
    assert(tx.len == 0);
    // Operations should still be there but length is reset
    assert(tx.operations[0].op == .insert);
}