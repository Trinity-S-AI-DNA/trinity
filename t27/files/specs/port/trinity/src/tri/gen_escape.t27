module port::trinity::src::tri::gen_escape;

pub fn escapeJson(str: []const u8, buf: []u8) -> ?usize {
    var i: usize = 0;
    for (str) |c| {
        if (c == '\\' as u8) {
            if (i + 2 > buf.len) {
                return null;
            }
            buf[i] = '\\' as u8;
            buf[i+1] = '\\' as u8;
            i += 2;
        } else if (c == '"' as u8) {
            if (i + 2 > buf.len) {
                return null;
            }
            buf[i] = '\\' as u8;
            buf[i+1] = '"' as u8;
            i += 2;
        } else if (c == '\n' as u8) {
            if (i + 2 > buf.len) {
                return null;
            }
            buf[i] = '\\' as u8;
            buf[i+1] = 'n' as u8;
            i += 2;
        } else if (c == '\r' as u8) {
            if (i + 2 > buf.len) {
                return null;
            }
            buf[i] = '\\' as u8;
            buf[i+1] = 'r' as u8;
            i += 2;
        } else if (c == '\t' as u8) {
            if (i + 2 > buf.len) {
                return null;
            }
            buf[i] = '\\' as u8;
            buf[i+1] = 't' as u8;
            i += 2;
        } else {
            if (i + 1 > buf.len) {
                return null;
            }
            buf[i] = c;
            i += 1;
        }
    }
    return i;
}

test "escape json" {
            var buf: [100]u8 = undefined;
    const input = "Hello\nWorld";
    var expected: [12]u8 = [_]u8{
        'H' as u8, 'e' as u8, 'l' as u8, 'l' as u8, 'o' as u8,
        '\\' as u8, 'n' as u8,
        'W' as u8, 'o' as u8, 'r' as u8, 'l' as u8, 'd' as u8
    };

    const len = escapeJson(input, &buf);
    assert(len != null);
    const l = len.?;

    assert(l == 12);

    var i: usize = 0;
    while (i < l) {
        assert(buf[i] == expected[i]);
        i += 1;
    }
}

test "escape json buffer too small" {
            var buf: [5]u8 = undefined;
    const input = "Hello\nWorld";
    const len = escapeJson(input, &buf);
    assert(len == null);
}

test "escape json backslash" {
            var buf: [100]u8 = undefined;
    const input = "Hello\\World";
    var expected: [12]u8 = [_]u8{
        'H' as u8, 'e' as u8, 'l' as u8, 'l' as u8, 'o' as u8,
        '\\' as u8, '\\' as u8,
        'W' as u8, 'o' as u8, 'r' as u8, 'l' as u8, 'd' as u8
    };

    const len = escapeJson(input, &buf);
    assert(len != null);
    const l = len.?;

    assert(l == 12);

    var i: usize = 0;
    while (i < l) {
        assert(buf[i] == expected[i]);
        i += 1;
    }
}