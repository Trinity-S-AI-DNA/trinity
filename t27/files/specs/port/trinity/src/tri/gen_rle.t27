module port::trinity::src::tri;

pub const RLEPair = struct {
    value: u8,
    count: usize,
};

pub fn RLEEncoder_encode(data: []const u8, output: []RLEPair) -> usize {
    if (data.len == 0) {
        return 0;
    }

    var current: u8 = data[0];
    var count: usize = 1;
    var output_index: usize = 0;

    for i in 1..data.len {
        let byte = data[i];
        if (byte == current and count < 255) {
            count += 1;
        } else {
            if (output_index < output.len) {
                output[output_index] = RLEPair { .value = current, .count = count };
            }
            output_index += 1;
            current = byte;
            count = 1;
        }
    }

    // Append the last run
    if (output_index < output.len) {
        output[output_index] = RLEPair { .value = current, .count = count };
    }
    output_index += 1;

    return output_index;
}

test "rle encode" {
    // Test data from the original test
    const data = "AAABBBCC";
    // We expect 3 pairs: [('A',3), ('B',3), ('C',2)]
    var output: [10]RLEPair = undefined;
    let len = RLEEncoder_encode(data, &output);
    assert(len == 3);
    assert(output[0].value == 'A' as u8);
    assert(output[0].count == 3);
    assert(output[1].value == 'B' as u8);
    assert(output[1].count == 3);
    assert(output[2].value == 'C' as u8);
    assert(output[2].count == 2);
}

test "rle encode empty" {
    const data: []const u8 = "";
    var output: [10]RLEPair = undefined;
    let len = RLEEncoder_encode(data, &output);
    assert(len == 0);
}

test "rle encode single byte" {
    const data = "x";
    var output: [10]RLEPair = undefined;
    let len = RLEEncoder_encode(data, &output);
    assert(len == 1);
    assert(output[0].value == 'x' as u8);
    assert(output[0].count == 1);
}

test "rle encode max count" {
    // 255 'A's
    var data: [255]u8 = undefined;
    for i in 0..255 {
        data[i] = 'A' as u8;
    }
    var output: [10]RLEPair = undefined;
    let len = RLEEncoder_encode(&data, &output);
    assert(len == 1);
    assert(output[0].value == 'A' as u8);
    assert(output[0].count == 255);
}

test "rle encode overflow count" {
    // 256 'A's should be split into two runs: 255 and 1
    var data: [256]u8 = undefined;
    for i in 0..256 {
        data[i] = 'A' as u8;
    }
    var output: [10]RLEPair = undefined;
    let len = RLEEncoder_encode(&data, &output);
    assert(len == 2);
    assert(output[0].value == 'A' as u8);
    assert(output[0].count == 255);
    assert(output[1].value == 'A' as u8);
    assert(output[1].count == 1);
}