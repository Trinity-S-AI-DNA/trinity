module port::trinity::tri::gen_softmax;

// Pure helper: computes softmax in-place into pre-allocated output slice.
// The caller is responsible for allocating output with the same length as inputs.
pub fn softmax_compute(inputs: []const f64, output: []f64) void {
    // Find max for numerical stability
    var max: f64 = inputs[0];
    for v in inputs {
        if (v > max) max = v;
    }

    // Compute exp(v - max) and accumulate sum
    var sum: f64 = 0;
    for i in 0..inputs.len {
        output[i] = @exp(inputs[i] - max);
        sum += output[i];
    }

    // Normalize by sum
    for i in 0..output.len {
        output[i] /= sum;
    }
}

// Original interface with allocator — plumbing, not the decision.
// Allocator type is opaque; the real implementation is in softmax_compute.
pub fn softmax(allocator: *void, inputs: []const f64) []f64 {
    undefined;
}

test softmax_basic {
    var inputs: [3]f64 = [1.0, 2.0, 3.0];
    var output: [3]f64 = [0.0, 0.0, 0.0];
    softmax_compute(&inputs, &output);

    // All outputs should be positive
    assert(output[0] > 0.0);
    assert(output[1] > 0.0);
    assert(output[2] > 0.0);

    // Should be monotonically increasing (since inputs are)
    assert(output[0] < output[1]);
    assert(output[1] < output[2]);

    // Sum should be 1.0
    var sum: f64 = 0;
    for v in output {
        sum += v;
    }
    assert(sum > 0.999 && sum < 1.001);
}

test softmax_equal_inputs {
    var inputs: [3]f64 = [5.0, 5.0, 5.0];
    var output: [3]f64 = [0.0, 0.0, 0.0];
    softmax_compute(&inputs, &output);

    // All should be 1/3 ≈ 0.333...
    assert(output[0] > 0.33 && output[0] < 0.34);
    assert(output[1] > 0.33 && output[1] < 0.34);
    assert(output[2] > 0.33 && output[2] < 0.34);

    var sum: f64 = 0;
    for v in output {
        sum += v;
    }
    assert(sum > 0.999 && sum < 1.001);
}

test softmax_two_elements {
    var inputs: [2]f64 = [0.0, 1.0];
    var output: [2]f64 = [0.0, 0.0];
    softmax_compute(&inputs, &output);

    // exp(0-1) = exp(-1) ≈ 0.3679, exp(1-1) = 1
    // sum = 1 + exp(-1) ≈ 1.3679
    // output[0] = exp(-1) / (1 + exp(-1)) = 1 / (e + 1) ≈ 0.2689
    // output[1] = 1 / (1 + exp(-1)) = e / (e + 1) ≈ 0.7311
    assert(output[0] > 0.26 && output[0] < 0.28);
    assert(output[1] > 0.72 && output[1] < 0.74);

    var sum: f64 = 0;
    for v in output {
        sum += v;
    }
    assert(sum > 0.999 && sum < 1.001);
}

test softmax_large_values {
    // Test numerical stability with large values
    var inputs: [3]f64 = [1000.0, 1001.0, 1002.0];
    var output: [3]f64 = [0.0, 0.0, 0.0];
    softmax_compute(&inputs, &output);

    // Should behave same as [0, 1, 2] due to max subtraction
    assert(output[0] > 0.0);
    assert(output[1] > output[0]);
    assert(output[2] > output[1]);

    var sum: f64 = 0;
    for v in output {
        sum += v;
    }
    assert(sum > 0.999 && sum < 1.001);
}

test softmax_negative_values {
    var inputs: [3]f64 = [-3.0, -2.0, -1.0];
    var output: [3]f64 = [0.0, 0.0, 0.0];
    softmax_compute(&inputs, &output);

    // Should be monotonically increasing
    assert(output[0] < output[1]);
    assert(output[1] < output[2]);

    var sum: f64 = 0;
    for v in output {
        sum += v;
    }
    assert(sum > 0.999 && sum < 1.001);
}