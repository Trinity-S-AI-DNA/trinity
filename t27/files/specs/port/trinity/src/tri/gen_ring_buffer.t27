module port::trinity::src::tri::gen_ring_buffer;

// Port of gHashTag/trinity src/tri/gen_ring_buffer.zig (92e1d48d0399).
//
// The original grows its slot array on the heap through a std.mem.Allocator.
// This runtime has no heap, so the []i64 becomes a fixed inline array capped
// at MAX_CAPACITY, and init clamps its capacity argument to that cap. The
// empty error set of the original's `!bool` return (enqueue never returns an
// error) is dropped. Everything else - the ring arithmetic, the
// full-at-capacity-minus-one rule, FIFO order, null on empty dequeue - is
// the original's.

const MAX_CAPACITY: usize = 16;

// Placeholder for std.mem.Allocator: allocation is plumbing that the inline
// array replaces, so the parameter is carried but no test needs a real
// allocator.
struct Allocator {}

pub struct RingBuffer {
    buffer: [MAX_CAPACITY]i64,
    capacity: usize,
    head: usize,
    tail: usize,
}

pub fn RingBuffer_init(allocator: Allocator, capacity: usize) -> RingBuffer {
    const usable = if (capacity > MAX_CAPACITY) MAX_CAPACITY else capacity;
    return RingBuffer{
        .buffer = [_]i64{0} ** MAX_CAPACITY,
        .capacity = usable,
        .head = 0,
        .tail = 0,
    };
}

pub fn RingBuffer_enqueue(rb: *RingBuffer, value: i64) -> bool {
    const next_tail = (rb.tail + 1) % rb.capacity;
    if (next_tail == rb.head) {
        return false;
    }
    rb.buffer[rb.tail] = value;
    rb.tail = next_tail;
    return true;
}

pub fn RingBuffer_dequeue(rb: *RingBuffer) -> ?i64 {
    if (rb.head == rb.tail) {
        return null;
    }
    const value = rb.buffer[rb.head];
    rb.head = (rb.head + 1) % rb.capacity;
    return value;
}

pub fn RingBuffer_isEmpty(rb: *const RingBuffer) -> bool {
    return rb.head == rb.tail;
}

pub fn RingBuffer_deinit(rb: *RingBuffer, allocator: Allocator) void {
    // Plumbing: freeing the inline array is a no-op with no heap.
    return undefined;
}

// Test allocator for use in tests.
const test_allocator = Allocator{};

test "init zeroes every slot and starts empty" {
    var rb = RingBuffer_init(test_allocator, 4);
    assert(rb.capacity == 4);
    assert(rb.head == 0);
    assert(rb.tail == 0);
    assert(rb.buffer[0] == 0);
    assert(rb.buffer[15] == 0);
    assert(RingBuffer_isEmpty(&rb));
}

test "enqueue fills capacity minus one slots, then reports full" {
    var rb = RingBuffer_init(test_allocator, 4);
    assert(RingBuffer_enqueue(&rb, 1) == true);
    assert(RingBuffer_enqueue(&rb, 2) == true);
    assert(RingBuffer_enqueue(&rb, 3) == true);
    assert(RingBuffer_enqueue(&rb, 4) == false);
    assert(RingBuffer_isEmpty(&rb) == false);
}

test "dequeue returns values in FIFO order" {
    var rb = RingBuffer_init(test_allocator, 4);
    assert(RingBuffer_enqueue(&rb, 10) == true);
    assert(RingBuffer_enqueue(&rb, 20) == true);
    assert(RingBuffer_enqueue(&rb, 30) == true);
    assert(RingBuffer_dequeue(&rb) == 10);
    assert(RingBuffer_dequeue(&rb) == 20);
    assert(RingBuffer_dequeue(&rb) == 30);
    assert(RingBuffer_isEmpty(&rb));
}

test "dequeue on an empty ring returns null" {
    var rb = RingBuffer_init(test_allocator, 3);
    assert(RingBuffer_dequeue(&rb) == null);
    assert(RingBuffer_enqueue(&rb, 7) == true);
    assert(RingBuffer_dequeue(&rb) == 7);
    assert(RingBuffer_dequeue(&rb) == null);
}

test "indices wrap around the ring without losing order" {
    var rb = RingBuffer_init(test_allocator, 4);
    assert(RingBuffer_enqueue(&rb, 10) == true);
    assert(RingBuffer_enqueue(&rb, 20) == true);
    assert(RingBuffer_enqueue(&rb, 30) == true);
    assert(RingBuffer_dequeue(&rb) == 10);
    assert(RingBuffer_dequeue(&rb) == 20);
    assert(RingBuffer_enqueue(&rb, 40) == true);
    assert(RingBuffer_enqueue(&rb, 50) == true);
    assert(RingBuffer_dequeue(&rb) == 30);
    assert(RingBuffer_dequeue(&rb) == 40);
    assert(RingBuffer_dequeue(&rb) == 50);
    assert(RingBuffer_isEmpty(&rb));
}

test "a full ring accepts one more value after a dequeue" {
    var rb = RingBuffer_init(test_allocator, 3);
    assert(RingBuffer_enqueue(&rb, 100) == true);
    assert(RingBuffer_enqueue(&rb, 200) == true);
    assert(RingBuffer_enqueue(&rb, 300) == false);
    assert(RingBuffer_dequeue(&rb) == 100);
    assert(RingBuffer_enqueue(&rb, 300) == true);
    assert(RingBuffer_dequeue(&rb) == 200);
    assert(RingBuffer_dequeue(&rb) == 300);
}

test "a ring of capacity one can hold nothing" {
    var rb = RingBuffer_init(test_allocator, 1);
    assert(RingBuffer_isEmpty(&rb));
    assert(RingBuffer_enqueue(&rb, 5) == false);
    assert(RingBuffer_dequeue(&rb) == null);
    assert(RingBuffer_isEmpty(&rb));
}
