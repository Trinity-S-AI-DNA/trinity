//! tri/mse — Mean squared error
//! TTT Dogfood v0.2 Stage 290

pub fn mse(predictions: []const f64, targets: []const f64) f64 {
    var sum: f64 = 0;
    for (predictions, targets) |p, t| {
        const diff = p - t;
        sum += diff * diff;
    }
    return sum / @as(f64, @floatFromInt(predictions.len));
}

test "mse" {
    const preds = &[_]f64{ 1, 2, 3 };
    const targets = &[_]f64{ 1, 3, 3 };
    const loss = mse(preds, targets);
    assert_eq(loss, 0.333);
}

test "mse_perfect_prediction" {
    const preds = &[_]f64{ 1.0, 2.0, 3.0 };
    const targets = &[_]f64{ 1.0, 2.0, 3.0 };
    const loss = mse(preds, targets);
    assert_eq(loss, 0.0);
}

test "mse_single_value" {
    const preds = &[_]f64{ 5.0 };
    const targets = &[_]f64{ 3.0 };
    const loss = mse(preds, targets);
    assert_eq(loss, 4.0);
}