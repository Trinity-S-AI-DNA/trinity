// Port of gHashTag/trinity src/tri/gen_radix_tree.zig (Roadmap Stage 5, goal
// #4547: "The Zig core: hand-written Zig becomes generated Zig").
//
// The original keeps nodes behind pointers and children in a
// std.AutoHashMap(u8, *RadixNode). .t27 has no heap and no map today, so
// RadixNode is carried as a value struct and the only child fact the logic
// can read - that a fresh node has no children - is carried as a count.
// std.mem.Allocator stays in the signatures as the str token gen_cache uses;
// the allocation itself is plumbing. The two teardowns, which in the original
// only sequence allocator.destroy calls, keep their names with return-no-op
// bodies that no test calls. A bare undefined body is not usable: the Zig
// translation rejects it ("value of type '@TypeOf(undefined)' ignored") and
// an empty body lowers to @compileError. RadixTree_insert carries the
// original's decision - it discards both arguments and changes nothing - and
// RadixTree_contains carries its decision verbatim: false for every key.

pub struct RadixNode {
    prefix: []const u8,
    child_count: usize,
    is_end: bool,
    allocator: str,
}

pub struct RadixTree {
    root: RadixNode,
    allocator: str,
}

// A fresh node: empty prefix, no children, not an end marker. The original
// allocates the node first; the allocation is plumbing, this state is the
// decision.
pub fn RadixNode_init(allocator: str) RadixNode {
    return RadixNode{
        .prefix = "",
        .child_count = 0,
        .is_end = false,
        .allocator = allocator,
    };
}

// The original walks the child map, destroying each subtree and then the map
// itself: pure allocator sequencing, with no decision the value model carries.
// No test calls this - teardown is plumbing. The body is an explicit return,
// not an undefined body, for the compiler reason noted above.
pub fn RadixNode_deinit(node: RadixNode) void {
    return;
}

// A tree whose root is a fresh node; the original forwards the allocator to
// RadixNode.init.
pub fn RadixTree_init(allocator: str) RadixTree {
    return RadixTree{
        .root = RadixNode_init(allocator),
        .allocator = allocator,
    };
}

// The original is a stub: it discards the tree and the key and changes
// nothing, so the tree stays a lone fresh root and every lookup misses.
pub fn RadixTree_insert(tree: *RadixTree, key: []const u8) !void {
    return;
}

// The original returns false for every key - including the empty string and
// keys a completed radix tree would hold.
pub fn RadixTree_contains(tree: RadixTree, key: []const u8) bool {
    return false;
}

// The original destroys the root's subtree and then the root itself: pure
// allocator sequencing, like RadixNode_deinit. Body is an explicit return,
// not an undefined body, for the same compiler reason.
pub fn RadixTree_deinit(tree: RadixTree) void {
    return;
}

test "radix_node_init_state" {
    var node: RadixNode = RadixNode_init("test_allocator");
    assert(node.prefix == "");
    assert(node.prefix.len == 0);
    assert(node.is_end == false);
    assert(node.child_count == 0);
    assert(node.allocator == "test_allocator");
}

test "radix_tree_init_roots_a_fresh_node" {
    var tree: RadixTree = RadixTree_init("test_allocator");
    assert(tree.root.prefix == "");
    assert(tree.root.is_end == false);
    assert(tree.root.child_count == 0);
    assert(tree.allocator == "test_allocator");
}

test "radix_tree_contains_rejects_the_empty_key" {
    var tree: RadixTree = RadixTree_init("test_allocator");
    assert(RadixTree_contains(tree, "") == false);
}

test "radix_tree_contains_rejects_any_key" {
    var tree: RadixTree = RadixTree_init("test_allocator");
    assert(RadixTree_contains(tree, "a") == false);
    assert(RadixTree_contains(tree, "ab") == false);
    assert(RadixTree_contains(tree, "abc") == false);
    assert(RadixTree_contains(tree, "radix") == false);
    assert(!RadixTree_contains(tree, "radix"));
}

test "radix_tree_contains_rejects_shared_prefixes" {
    var tree: RadixTree = RadixTree_init("test_allocator");
    assert(RadixTree_contains(tree, "car") == false);
    assert(RadixTree_contains(tree, "cart") == false);
    assert(RadixTree_contains(tree, "cartographer") == false);
}

test "radix_tree_insert_changes_nothing" {
    var tree: RadixTree = RadixTree_init("test_allocator");
    RadixTree_insert(&tree, "key");
    assert(RadixTree_contains(tree, "key") == false);
    assert(tree.root.prefix == "");
    assert(tree.root.is_end == false);
    assert(tree.root.child_count == 0);
}

test "radix_tree_init_two_trees_are_independent" {
    var first: RadixTree = RadixTree_init("a");
    var second: RadixTree = RadixTree_init("b");
    assert(RadixTree_contains(first, "k") == false);
    assert(RadixTree_contains(second, "k") == false);
    assert(first.allocator == "a");
    assert(second.allocator == "b");
}
