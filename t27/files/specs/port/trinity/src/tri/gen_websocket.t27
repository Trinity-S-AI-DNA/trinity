module port::trinity::src::tri::gen_websocket;

enum WebSocketState { open, closed }

struct WebSocket {
    state: WebSocketState,
}

pub fn WebSocket_init() WebSocket {
    return WebSocket{ .state = .open };
}

pub fn WebSocket_send(ws: *WebSocket, data: []const u8) -> ?void {
    if (ws.state == .closed) {
        return null;
    }
    return undefined;
}

pub fn WebSocket_close(ws: *WebSocket) void {
    ws.state = .closed;
}

test "WebSocket_init_returns_open" {
    var ws = WebSocket_init();
    assert(ws.state == .open);
}

test "WebSocket_send_returns_null_when_closed" {
    var ws = WebSocket_init();
    WebSocket_close(&ws);
    assert(WebSocket_send(&ws, []) == null);
}

test "WebSocket_send_returns_undefined_when_open" {
    var ws = WebSocket_init();
    assert(WebSocket_send(&ws, []) != null);
}

test "WebSocket_close_sets_state_to_closed" {
    var ws = WebSocket_init();
    WebSocket_close(&ws);
    assert(ws.state == .closed);
}