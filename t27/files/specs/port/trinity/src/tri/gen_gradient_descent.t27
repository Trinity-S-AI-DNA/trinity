module port::trinity::tri::gen_gradient_descent;

pub struct GradientDescent {
    learning_rate: f64,
}

pub fn GradientDescent_init(lr: f64) GradientDescent {
    return GradientDescent { .learning_rate = lr };
}

pub fn GradientDescent_step(gd: *const GradientDescent, params: []f64, gradients: []const f64) void {
    const n = if (params.len < gradients.len) params.len else gradients.len;
    for (0..n) |i| {
        params[i] -= gd.learning_rate * gradients[i];
    }
}

test gradient_descent_init {
    const gd = GradientDescent_init(0.1);
    assert(gd.learning_rate == 0.1);
}

test gradient_descent_step {
    var gd = GradientDescent_init(0.1);
    var params: [2]f64 = [1, 2];
    const grads: [2]f64 = [0.1, 0.2];
    
    GradientDescent_step(&gd, &params, &grads);
    
    // Check that parameters were updated correctly
    // params[0] should be 1 - 0.1 * 0.1 = 0.99
    // params[1] should be 2 - 0.1 * 0.2 = 1.98
    assert(params[0] < 1);
    assert(params[1] < 2);
}

test gradient_descent_step_different_lengths {
    var gd = GradientDescent_init(0.5);
    var params: [3]f64 = [10, 20, 30];
    const grads: [2]f64 = [1, 2];
    
    GradientDescent_step(&gd, &params, &grads);
    
    // Only first two parameters should be updated (limited by gradients length)
    assert(params[0] == 10 - 0.5 * 1);  // 9.5
    assert(params[1] == 20 - 0.5 * 2);  // 19
    assert(params[2] == 30);  // unchanged
}

test gradient_descent_zero_learning_rate {
    var gd = GradientDescent_init(0.0);
    var params: [2]f64 = [5, 10];
    const grads: [2]f64 = [1, 1];
    
    GradientDescent_step(&gd, &params, &grads);
    
    // With zero learning rate, parameters should not change
    assert(params[0] == 5);
    assert(params[1] == 10);
}