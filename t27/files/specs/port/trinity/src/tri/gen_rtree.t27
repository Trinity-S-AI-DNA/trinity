module port::trinity::src::tri::gen_rtree;

pub const Rect = struct {
    x_min: f64,
    y_min: f64,
    x_max: f64,
    y_max: f64,
};

// Not named RTree: specs/tri/trees/rtree.t27 owns RTree, a node tree rather
// than these flat arrays (tri types ratchet, #7437).
pub const GenRTree = struct {
    rects: []Rect,
    data: []?i64,
    allocator: ?i64,
};

pub fn Rect_intersects(self: Rect, other: Rect) bool {
    return self.x_min <= other.x_max and self.x_max >= other.x_min and
        self.y_min <= other.y_max and self.y_max >= other.y_min;
}

pub fn RTree_init(allocator: ?i64) GenRTree {
    return undefined;
}

pub fn RTree_insert(rt: *GenRTree, rect: Rect, datum: ?i64) void {
    return undefined;
}

pub fn RTree_search(rt: *const GenRTree, query: Rect, allocator: ?i64) ?i64 {
    return undefined;
}

pub fn RTree_deinit(rt: *GenRTree) void {
    return undefined;
}

test rect_intersects_true {
    const rect1 = Rect{ .x_min = 0, .y_min = 0, .x_max = 10, .y_max = 10 };
    const rect2 = Rect{ .x_min = 5, .y_min = 5, .x_max = 15, .y_max = 15 };
    assert(Rect_intersects(rect1, rect2));
}

test rect_intersects_false {
    const rect1 = Rect{ .x_min = 0, .y_min = 0, .x_max = 10, .y_max = 10 };
    const rect2 = Rect{ .x_min = 20, .y_min = 20, .x_max = 30, .y_max = 30 };
    assert(!Rect_intersects(rect1, rect2));
}

test rect_intersects_edge_case {
    const rect1 = Rect{ .x_min = 0, .y_min = 0, .x_max = 10, .y_max = 10 };
    const rect2 = Rect{ .x_min = 10, .y_min = 0, .x_max = 20, .y_max = 10 };
    assert(Rect_intersects(rect1, rect2));
}

test rect_intersects_touching {
    const rect1 = Rect{ .x_min = 0, .y_min = 0, .x_max = 10, .y_max = 10 };
    const rect2 = Rect{ .x_min = 10, .y_min = 10, .x_max = 20, .y_max = 20 };
    assert(Rect_intersects(rect1, rect2));
}

test rect_intersects_completely_inside {
    const rect1 = Rect{ .x_min = 0, .y_min = 0, .x_max = 20, .y_max = 20 };
    const rect2 = Rect{ .x_min = 5, .y_min = 5, .x_max = 15, .y_max = 15 };
    assert(Rect_intersects(rect1, rect2));
}