module port::tri::gen_temp_file;

pub fn createTempFile(allocator: []u8) ?[13]u8 {
    // Port the decision logic: copy "/tmp/tempXXXXXX" pattern
    // The allocator allocation is plumbing, so we create the pattern directly
    var result: [13]u8 = undefined;
    for (0..result.len) |i| {
        result[i] = "/tmp/tempXXXXXX"[i];
    }
    return result;
}

test "temp file" {
    // Test the core logic: the function returns the expected pattern
    const result = createTempFile(undefined); // allocator is plumbing
    
    // Check that the result is not null
    if (result == null) {
        return;
    }
    
    // Check that the result is the expected pattern by comparing character by character
    const actual = result.?;
    assert(actual[0] == '/');
    assert(actual[1] == 't');
    assert(actual[2] == 'm');
    assert(actual[3] == 'p');
    assert(actual[4] == '/');
    assert(actual[5] == 't');
    assert(actual[6] == 'e');
    assert(actual[7] == 'm');
    assert(actual[8] == 'p');
    assert(actual[9] == 'X');
    assert(actual[10] == 'X');
    assert(actual[11] == 'X');
    assert(actual[12] == 'X');
    
    // Check that the result has the correct length
    assert(actual.len == 13); // "/tmp/tempXXXXXX" is 13 characters
}