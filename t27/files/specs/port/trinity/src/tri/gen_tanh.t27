module port::trinity::src::tri::gen_tanh;

pub fn tanh(x: f64) f64 {
    const e2x = RadixEconomy.exp(2.0 * x);
    return (e2x - 1.0) / (e2x + 1.0);
}

pub fn tanhDerivative(x: f64) f64 {
    const t = tanh(x);
    return 1.0 - t * t;
}

test tanh_zero {
    let result = tanh(0.0);
    assert((result - 0.0).abs() < 1e-6);
}

test tanh_one {
    let result = tanh(1.0);
    let expected = 0.7615941559557649;
    assert((result - expected).abs() < 1e-6);
}

test tanhDerivative_zero {
    let result = tanhDerivative(0.0);
    assert((result - 1.0).abs() < 1e-6);
}

test tanhDerivative_one {
    let result = tanhDerivative(1.0);
    let t = tanh(1.0);
    let expected = 1.0 - t * t;
    assert((result - expected).abs() < 1e-6);
}