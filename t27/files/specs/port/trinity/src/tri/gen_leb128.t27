module port::trinity::src::tri::gen_leb128;

pub const Encoded = struct { data: [10]u8, len: usize };
pub const Decoded = struct { value: u64, bytes: usize };

pub fn encodeULEB128(value: u64) -> Encoded {
    var data: [10]u8 = undefined;
    var i: usize = 0;
    var v: u64 = value;
    while (v >= 0x80) {
        data[i] = ((v & 0x7F) | 0x80) as u8;
        v = v >> 7;
        i += 1;
    }
    data[i] = v as u8;
    i += 1;
    return Encoded{ .data = data, .len = i };
}

pub fn decodeULEB128(data: [10]u8, len: usize) -> Decoded {
    var value: u64 = 0;
    var shift: usize = 0;
    var i: usize = 0;
    while (i < len) {
        let byte = data[i];
        value |= ((byte & 0x7F) as u64) << shift;
        if ((byte & 0x80) == 0) {
            return Decoded{ .value = value, .bytes = i + 1 };
        }
        shift += 7;
        i += 1;
    }
    return Decoded{ .value = value, .bytes = len };
}

test "encodeULEB128 example" {
    const encoded = encodeULEB128(624485);
    const decoded = decodeULEB128(encoded.data, encoded.len);
    assert(decoded.value == 624485);
    assert(decoded.bytes == encoded.len);
}

test "encodeULEB128 zero" {
    const encoded = encodeULEB128(0);
    assert(encoded.len == 1);
    assert(encoded.data[0] == 0);
    const decoded = decodeULEB128(encoded.data, encoded.len);
    assert(decoded.value == 0);
    assert(decoded.bytes == 1);
}