module port::trinity::gen_rsa_simple;

pub struct SimpleRSAKeyPair {
    public_key: u64,
    private_key: u64,
    modulus: u64,
}

pub fn generateKeyPair(p: u64, q: u64) -> SimpleRSAKeyPair {
    const n = p * q;
    const phi = (p - 1) * (q - 1);
    return SimpleRSAKeyPair {
        public_key: 65537,
        private_key: phi,
        modulus: n,
    };
}

test generateKeyPair_basic {
    const pair = generateKeyPair(61, 53);
    assert(pair.public_key == 65537);
    assert(pair.modulus == 61 * 53);
    assert(pair.private_key == (61 - 1) * (53 - 1));
}

test generateKeyPair_different_primes {
    const pair = generateKeyPair(17, 19);
    assert(pair.public_key == 65537);
    assert(pair.modulus == 17 * 19);
    assert(pair.private_key == (17 - 1) * (19 - 1));
}