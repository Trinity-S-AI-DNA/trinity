module port::trinity::src::tri;

pub struct AABB {
    min_x: f64,
    min_y: f64,
    max_x: f64,
    max_y: f64,
}

pub fn AABB_init(min_x: f64, min_y: f64, max_x: f64, max_y: f64) -> AABB {
    return AABB { min_x: min_x, min_y: min_y, max_x: max_x, max_y: max_y };
}

pub fn AABB_contains(aabb: *const AABB, x: f64, y: f64) -> bool {
    return x >= aabb.min_x and x <= aabb.max_x and y >= aabb.min_y and y <= aabb.max_y;
}

pub fn AABB_intersects(a: AABB, b: AABB) -> bool {
    return a.min_x <= b.max_x and a.max_x >= b.min_x and a.min_y <= b.max_y and a.max_y >= b.min_y;
}

test "AABB_init" {
    const aabb = AABB_init(0.0, 0.0, 10.0, 10.0);
    assert(aabb.min_x == 0.0);
    assert(aabb.min_y == 0.0);
    assert(aabb.max_x == 10.0);
    assert(aabb.max_y == 10.0);
}

test "AABB_contains_inside" {
    const aabb = AABB_init(0.0, 0.0, 10.0, 10.0);
    assert(AABB_contains(&aabb, 5.0, 5.0));
}

test "AABB_contains_outside" {
    const aabb = AABB_init(0.0, 0.0, 10.0, 10.0);
    assert(!AABB_contains(&aabb, 15.0, 5.0));
}

test "AABB_intersects_true" {
    const a = AABB_init(0.0, 0.0, 10.0, 10.0);
    const b = AABB_init(5.0, 5.0, 15.0, 15.0);
    assert(AABB_intersects(a, b));
}

test "AABB_intersects_false" {
    const a = AABB_init(0.0, 0.0, 10.0, 10.0);
    const b = AABB_init(20.0, 20.0, 30.0, 30.0);
    assert(!AABB_intersects(a, b));
}

test "AABB_intersects_edge" {
    const a = AABB_init(0.0, 0.0, 10.0, 10.0);
    const b = AABB_init(10.0, 0.0, 20.0, 10.0);
    assert(AABB_intersects(a, b));
}