module port::tri::string_dualities;

const PHI = 1.618033988749895; // Golden ratio

/// g_s at φ-point = φ/π
pub fn CouplingConstant_stringCouplingAtPhi() f64 {
    return PHI / std.math.pi;
}

/// S-dual coupling = 1/g_s = π/φ
pub fn CouplingConstant_sDualCoupling() f64 {
    return std.math.pi / PHI;
}

/// Self-dual when |g_s - 1/g_s| < 0.01
pub fn CouplingConstant_isSelfDual(g_s: f64) bool {
    if (g_s <= 0) return false;
    return @abs(g_s - 1.0 / g_s) < 0.01;
}

test stringCouplingAtPhi_is_phi_pi {
    const g = CouplingConstant_stringCouplingAtPhi();
    assert(@abs(g - PHI / std.math.pi) < 1e-14);
    assert(g > 0.515 and g < 0.516);
}

test S_duality_product_is_1 {
    const g = CouplingConstant_stringCouplingAtPhi();
    const g_dual = CouplingConstant_sDualCoupling();
    assert(@abs(g * g_dual - 1.0) < 1e-14);
}

test self_dual_at_gs_1 {
    assert(CouplingConstant_isSelfDual(1.0));
    assert(!CouplingConstant_isSelfDual(0.5));
}

test self_dual_edge_cases {
    assert(!CouplingConstant_isSelfDual(0.0));
    assert(CouplingConstant_isSelfDual(1.001));
    assert(CouplingConstant_isSelfDual(0.999));
}