//! tri/linear_regression — Linear regression model
//! TTT Dogfood v0.2 Stage 283

pub struct LinearRegression {
    slope: f64,
    intercept: f64,
}

pub fn LinearRegression_init() LinearRegression {
    return LinearRegression { .slope = 0, .intercept = 0 };
}

pub fn LinearRegression_fit(lr: *LinearRegression, x: []const f64, y: []const f64) void {
    if (x.len != y.len) {
        return;
    }

    var sum_x: f64 = 0;
    var sum_y: f64 = 0;
    var sum_xy: f64 = 0;
    var sum_x2: f64 = 0;

    for (x, y) |xi, yi| {
        sum_x += xi;
        sum_y += yi;
        sum_xy += xi * yi;
        sum_x2 += xi * xi;
    }

    const n = @as(f64, @floatFromInt(x.len));
    const slope_num = n * sum_xy - sum_x * sum_y;
    const slope_den = n * sum_x2 - sum_x * sum_x;

    if (slope_den != 0) {
        lr.slope = slope_num / slope_den;
    }

    lr.intercept = (sum_y - lr.slope * sum_x) / n;
}

pub fn LinearRegression_predict(lr: *const LinearRegression, x: f64) f64 {
    return lr.slope * x + lr.intercept;
}

test linear_regression_init {
    const lr = LinearRegression_init();
    assert(lr.slope == 0);
    assert(lr.intercept == 0);
}

test linear_regression_fit_perfect_line {
    var lr = LinearRegression_init();
    const x = &[_]f64{ 1, 2, 3 };
    const y = &[_]f64{ 2, 4, 6 }; // y = 2x
    
    LinearRegression_fit(&lr, x, y);
    
    // slope should be 2, intercept should be 0
    assert(lr.slope == 2);
    assert(lr.intercept == 0);
}

test linear_regression_fit_with_offset {
    var lr = LinearRegression_init();
    const x = &[_]f64{ 1, 2, 3 };
    const y = &[_]f64{ 3, 5, 7 }; // y = 2x + 1
    
    LinearRegression_fit(&lr, x, y);
    
    // slope should be 2, intercept should be 1
    assert(lr.slope == 2);
    assert(lr.intercept == 1);
}

test linear_regression_predict {
    var lr = LinearRegression_init();
    lr.slope = 2;
    lr.intercept = 1; // y = 2x + 1
    
    const result = LinearRegression_predict(&lr, 5);
    // 2 * 5 + 1 = 11
    assert(result == 11);
}

test linear_regression_fit_mismatched_lengths {
    var lr = LinearRegression_init();
    const x = &[_]f64{ 1, 2, 3 };
    const y = &[_]f64{ 2, 4 }; // Different length
    
    LinearRegression_fit(&lr, x, y);
    
    // Should not modify lr (early return)
    assert(lr.slope == 0);
    assert(lr.intercept == 0);
}

test linear_regression_fit_zero_denominator {
    var lr = LinearRegression_init();
    const x = &[_]f64{ 1, 1, 1 }; // All x values same -> slope_den = 0
    const y = &[_]f64{ 2, 4, 6 };
    
    LinearRegression_fit(&lr, x, y);
    
    // slope should remain 0 (denominator check), intercept = mean(y) = 4
    assert(lr.slope == 0);
    assert(lr.intercept == 4);
}