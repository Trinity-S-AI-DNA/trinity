module port::trinity::src::tri::gen_color;

// Color struct ported from tri/color.zig
pub struct Color {
    r: u8,
    g: u8,
    b: u8,
}

// Port of: pub fn rgb(r: u8, g: u8, b: u8) Color {
pub fn Color_rgb(r: u8, g: u8, b: u8) Color {
    return Color { .r = r, .g = g, .b = b };
}

// Port of: pub fn toHex(color: Color) [7]u8 {
pub fn Color_toHex(color: Color) [7]u8 {
    return [_]u8{
        '#',
        intToHex(color.r / 16),
        intToHex(color.r % 16),
        intToHex(color.g / 16),
        intToHex(color.g % 16),
        intToHex(color.b / 16),
        intToHex(color.b % 16),
    };
}

// Port of: fn intToHex(v: u8) u8 {
fn intToHex(v: u8) u8 {
    return if (v < 10) '0' + v else 'a' + v - 10;
}

test "color_rgb_basic" {
    const c = Color_rgb(255, 0, 0);
    assert(c.r == 255);
    assert(c.g == 0);
    assert(c.b == 0);
}

test "color_rgb_all_values" {
    const black = Color_rgb(0, 0, 0);
    const white = Color_rgb(255, 255, 255);
    const blue = Color_rgb(0, 0, 255);
    
    assert(black.r == 0 and black.g == 0 and black.b == 0);
    assert(white.r == 255 and white.g == 255 and white.b == 255);
    assert(blue.r == 0 and blue.g == 0 and blue.b == 255);
}

test "color_toHex_red" {
    const c = Color_rgb(255, 0, 0);
    const hex = Color_toHex(c);
    assert(hex[0] == '#');
    assert(hex[1] == 'f'); // 255 / 16 = 15 -> 'f'
    assert(hex[2] == 'f'); // 255 % 16 = 15 -> 'f'
    assert(hex[3] == '0'); // 0 / 16 = 0 -> '0'
    assert(hex[4] == '0'); // 0 % 16 = 0 -> '0'
    assert(hex[5] == '0'); // 0 / 16 = 0 -> '0'
    assert(hex[6] == '0'); // 0 % 16 = 0 -> '0'
}

test "color_toHex_green" {
    const c = Color_rgb(0, 255, 0);
    const hex = Color_toHex(c);
    assert(hex[0] == '#');
    assert(hex[1] == '0'); // 0 / 16 = 0 -> '0'
    assert(hex[2] == '0'); // 0 % 16 = 0 -> '0'
    assert(hex[3] == 'f'); // 255 / 16 = 15 -> 'f'
    assert(hex[4] == 'f'); // 255 % 16 = 15 -> 'f'
    assert(hex[5] == '0'); // 0 / 16 = 0 -> '0'
    assert(hex[6] == '0'); // 0 % 16 = 0 -> '0'
}

test "intToHex_digits" {
    assert(intToHex(0) == '0');
    assert(intToHex(1) == '1');
    assert(intToHex(9) == '9');
    assert(intToHex(10) == 'a');
    assert(intToHex(11) == 'b');
    assert(intToHex(12) == 'c');
    assert(intToHex(13) == 'd');
    assert(intToHex(14) == 'e');
    assert(intToHex(15) == 'f');
}