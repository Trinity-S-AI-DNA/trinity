module port::trinity::src::tri;

struct EncodeResult {
    data: [10]u8,
    len: usize
}

struct DecodeResult {
    value: u64,
    bytes: usize
}

pub fn encodeVarint(value: u64) -> EncodeResult {
    var result: [10]u8 = undefined;
    var len: usize = 0;
    var v = value;
    while (v >= 0x80) {
        result[len] = (v & 0x7F | 0x80) as u8;
        len += 1;
        v = v >> 7;
    }
    result[len] = v as u8;
    len += 1;
    return EncodeResult{ .data = result, .len = len };
}

pub fn decodeVarint(data: []const u8) -> DecodeResult {
    var value: u64 = 0;
    var shift: usize = 0;
    for i in 0..data.len {
        let byte = data[i];
        value |= ((byte & 0x7F) as u64) << shift;
        if ((byte & 0x80) == 0) {
            return DecodeResult{ .value = value, .bytes = i + 1 };
        }
        shift += 7;
        if (shift >= 64) {
            return DecodeResult{ .value = 0, .bytes = 0 };
        }
    }
    return DecodeResult{ .value = value, .bytes = data.len };
}

test "encode zero" {
    let res = encodeVarint(0);
    assert(res.len == 1);
    assert(res.data[0] == 0);
}

test "decode zero" {
    let input: [1]u8 = [0];
    let res = decodeVarint(&input);
    assert(res.value == 0);
    assert(res.bytes == 1);
}