module port::trinity::src::tri::gen_record_store;

// Port of gHashTag/trinity src/tri/gen_record_store.zig (4 functions,
// 1 test): column-oriented record storage for TTT Dogfood v0.2 Stage 295.
//
// What was kept as written:
// - init makes `column_count` columns, each with the initial capacity of 16
//   the original asks for, and starts the store at row_count 0. The
//   original takes a std.mem.Allocator; .t27 has no allocator, so the
//   parameter is dropped and memory is the generated caller's job.
// - insert stores values[i] into column i for every i below the column
//   count, silently ignores indices past it, and adds 1 to row_count once
//   per call even when nothing was stored.
// - get returns null when the column or the row is out of range, else the
//   cell.
// - deinit releases every column and then the column list. Freeing memory
//   is the generated caller's job in .t27, so this port keeps the decision
//   the release stands for: every column is emptied and the counts return
//   to zero, so a get after deinit finds nothing.
//
// What the port cannot carry: the original's columns grow past their
// initial capacity on append (std.ArrayList grows), and its error returns
// (!RecordStore, !void) surface allocation failure. .t27 has no growable
// lists and no error unions, so a column holds at most COLUMN_CAPACITY
// cells and an insert past that drops the cell; init clamps column_count
// to MAX_COLUMNS. No test exercises either branch.

const MAX_COLUMNS: usize = 8;
const COLUMN_CAPACITY: usize = 16;

// The original's std.ArrayList(i32) for one column.
struct Column {
    items: [COLUMN_CAPACITY]i32,
    len: usize,
}

// The original's RecordStore: the growable column list becomes a fixed
// array of columns with an explicit live count.
struct RecordStore {
    columns: [MAX_COLUMNS]Column,
    column_count: usize,
    row_count: usize,
}

pub fn RecordStore_init(column_count: usize) -> RecordStore {
    var n: usize = column_count;
    if (n > MAX_COLUMNS) {
        n = MAX_COLUMNS;
    }
    var store = RecordStore {
        columns: [_]Column{ Column { items: [_]i32{0} ** COLUMN_CAPACITY, len: 0 } } ** MAX_COLUMNS,
        column_count: n,
        row_count: 0,
    };
    return store;
}

pub fn RecordStore_insert(store: *RecordStore, values: []const i32) -> void {
    var i: usize = 0;
    while (i < values.len) {
        if (i < store.column_count) {
            const col_len = store.columns[i].len;
            if (col_len < COLUMN_CAPACITY) {
                store.columns[i].items[col_len] = values[i];
                store.columns[i].len = col_len + 1;
            }
        }
        i += 1;
    }
    store.row_count += 1;
}

pub fn RecordStore_get(store: *const RecordStore, row: usize, col: usize) -> ?i32 {
    if (col >= store.column_count) {
        return null;
    }
    if (row >= store.columns[col].len) {
        return null;
    }
    return store.columns[col].items[row];
}

pub fn RecordStore_deinit(store: *RecordStore) -> void {
    var i: usize = 0;
    while (i < MAX_COLUMNS) {
        store.columns[i].len = 0;
        i += 1;
    }
    store.column_count = 0;
    store.row_count = 0;
}

// The original's own test: two columns, insert the row {1, 2}, read cells
// back.
test record_store {
    var store = RecordStore_init(2);
    var vals: [2]i32 = [1, 2];
    RecordStore_insert(&store, &vals);
    assert(RecordStore_get(&store, 0, 0) == 1);
    assert(RecordStore_get(&store, 0, 1) == 2);
}

// Column-oriented storage: each insert lays one row across the columns, so
// column 0 holds the first value of every row and column 1 the second.
test record_store_is_column_oriented {
    var store = RecordStore_init(2);
    var row0: [2]i32 = [10, 20];
    var row1: [2]i32 = [11, 21];
    RecordStore_insert(&store, &row0);
    RecordStore_insert(&store, &row1);
    assert(RecordStore_get(&store, 0, 0) == 10);
    assert(RecordStore_get(&store, 0, 1) == 20);
    assert(RecordStore_get(&store, 1, 0) == 11);
    assert(RecordStore_get(&store, 1, 1) == 21);
}

// The original stores only values[i] for i below the column count and
// ignores the rest; row_count still goes up by exactly 1 for the call.
test record_store_ignores_values_past_column_count {
    var store = RecordStore_init(2);
    var vals: [4]i32 = [1, 2, 3, 4];
    RecordStore_insert(&store, &vals);
    assert(RecordStore_get(&store, 0, 0) == 1);
    assert(RecordStore_get(&store, 0, 1) == 2);
    assert(RecordStore_get(&store, 0, 2) == null);
    assert(store.row_count == 1);
}

// A fresh store has no rows and exactly the columns init made, so every get
// is out of range and returns null on both of the original's null paths.
test record_store_get_bounds {
    var store = RecordStore_init(2);
    assert(RecordStore_get(&store, 0, 0) == null);
    assert(RecordStore_get(&store, 1, 0) == null);
    assert(RecordStore_get(&store, 0, 2) == null);
    assert(RecordStore_get(&store, 9, 9) == null);
}

// The original adds 1 to row_count once per insert call, whatever the
// values carry: two calls, two rows, each readable in its own column.
test record_store_row_count_counts_every_insert {
    var store = RecordStore_init(3);
    var first: [2]i32 = [1, 2];
    var second: [2]i32 = [9, 8];
    RecordStore_insert(&store, &first);
    RecordStore_insert(&store, &second);
    assert(store.row_count == 2);
    assert(RecordStore_get(&store, 1, 0) == 9);
    assert(RecordStore_get(&store, 1, 1) == 8);
}

// The original's deinit releases every column and then the column list;
// this port keeps that decision as state: after deinit no column holds
// cells, the counts are back to zero, and a get finds nothing.
test record_store_deinit_empties_the_store {
    var store = RecordStore_init(2);
    var vals: [2]i32 = [1, 2];
    RecordStore_insert(&store, &vals);
    assert(RecordStore_get(&store, 0, 0) == 1);
    RecordStore_deinit(&store);
    assert(RecordStore_get(&store, 0, 0) == null);
    assert(store.column_count == 0);
    assert(store.row_count == 0);
}
