module port::trinity::src::tri::gen_cursor;

struct Allocator {}

pub struct Cursor {
    position: usize,
    data: []i32,
    allocator: Allocator,
}

pub fn Cursor_init(allocator: Allocator) -> Cursor {
    return Cursor{
        .position = 0,
        .data = [], // empty slice
        .allocator = allocator,
    };
}

pub fn Cursor_next(cursor: *Cursor) -> ?i32 {
    if (cursor.position >= cursor.data.len) {
        return null;
    }
    const value = cursor.data[cursor.position];
    cursor.position += 1;
    return value;
}

pub fn Cursor_reset(cursor: *Cursor) -> void {
    cursor.position = 0;
}

pub fn Cursor_deinit(cursor: *Cursor) -> void {
    // Plumbing: deallocate the underlying buffer.
    return;
}

// Test allocator for use in tests.
const test_allocator: Allocator = Allocator{};

test "init returns cursor with zero position and empty data" {
    var c = Cursor_init(test_allocator);
    assert(c.position == 0);
    assert(c.data.len == 0);
    // next should return null on empty data
    assert(Cursor_next(&c) == null);
}

test "next returns elements in order and then null" {
    var c = Cursor_init(test_allocator);
    // Prepare data: [10, 20, 30]
    var storage: [3]i32 = [10, 20, 30];
    c.data = storage[0..3]; // slice of entire array
    assert(c.position == 0);
    assert(Cursor_next(&c) == 10);
    assert(c.position == 1);
    assert(Cursor_next(&c) == 20);
    assert(c.position == 2);
    assert(Cursor_next(&c) == 30);
    assert(c.position == 3);
    assert(Cursor_next(&c) == null);
    assert(c.position == 3); // position stays at len
}

test "reset sets position to zero" {
    var c = Cursor_init(test_allocator);
    var storage: [2]i32 = [5, 6];
    c.data = storage[0..2];
    // Advance position
    let dummy = Cursor_next(&c);
    assert(c.position == 1);
    Cursor_reset(&c);
    assert(c.position == 0);
    // After reset, next returns first element again
    assert(Cursor_next(&c) == 5);
}

test "deinit can be called without error" {
    var c = Cursor_init(test_allocator);
    Cursor_deinit(&c);
    // No assertion needed; just calling is the test.
    // We can also check that allocator field still exists.
    let unused = c.allocator;
}