module tri::gen_assertion;

// Port of gHashTag/trinity/src/tri/gen_assertion.zig
// Original error types from the Zig version
pub const AssertionError = enum {
    NotEqual,
    IsNull,
    Failed,
};

// Helper function to check assertEqual - returns true if successful, false if it would error
fn assertEqualHelper(expected: i32, actual: i32) bool {
    return expected == actual;
}

// Helper function to check assertNotNull - returns true if successful, false if it would error  
fn assertNotNullHelper(ptr: ?*anyopaque) bool {
    return ptr != null;
}

// Helper function to check assert - returns true if successful, false if it would error
fn assertHelper(condition: bool) bool {
    return condition;
}

pub fn assertEqual(expected: i32, actual: i32) void {
    // Port the decision logic - the original would return an error if not equal
    if (!assertEqualHelper(expected, actual)) {
        // This would be where AssertionError.NotEqual is returned in the original
        // In .t27, we'll let the generated code handle this appropriately
    }
}

pub fn assertNotNull(ptr: ?*anyopaque) void {
    // Port the decision logic - the original would return an error if null
    if (!assertNotNullHelper(ptr)) {
        // This would be where AssertionError.IsNull is returned in the original
        // In .t27, we'll let the generated code handle this appropriately
    }
}

pub fn assert(condition: bool) void {
    // Port the decision logic - the original would return an error if false
    if (!assertHelper(condition)) {
        // This would be where AssertionError.Failed is returned in the original
        // In .t27, we'll let the generated code handle this appropriately
    }
}

test assertEqual_success {
    assertEqual(42, 42);
    assertEqual(0, 0);
    assertEqual(-1, -1);
}

test assertEqual_failure {
    // Test the helper function that determines if it would error
    assert(!assertEqualHelper(5, 10)); // This would cause an error in original
    assert(!assertEqualHelper(100, 200)); // This would cause an error in original
}

test assertNotNull_success {
    assertNotNull(@ptrFromInt(1));
    assertNotNull(@ptrFromInt(0)); // Any non-null pointer
}

test assertNotNull_failure {
    // Test the helper function that determines if it would error
    const ptr: ?*anyopaque = null;
    assert(!assertNotNullHelper(ptr)); // This would cause an error in original
}

test assert_success {
    assert(true);
    assert(1 != 0);
    assert(5 > 3);
}

test assert_failure {
    // Test the helper function that determines if it would error
    assert(!assertHelper(false)); // This would cause an error in original
    assert(!assertHelper(0 > 1)); // This would cause an error in original
}