module port::trinity::src::tri::gen_key_value;

const MaxEntries = 16;

const KeyValueStore = struct {
    entries: [MaxEntries][2][]const u8,
    len: usize,
    allocator: usize,
};

fn KeyValueStore_init(allocator: usize) -> KeyValueStore {
    var store: KeyValueStore = undefined;
    store.allocator = allocator;
    store.len = 0;
    var i: usize = 0;
    while (i < MaxEntries) {
        store.entries[i][0] = "";
        store.entries[i][1] = "";
        i += 1;
    }
    return store;
}

fn KeyValueStore_put(store: *KeyValueStore, key: []const u8, value: []const u8) -> void {
    var i: usize = 0;
    while (i < store.len) {
        if (store.entries[i][0] == key) {
            store.entries[i][1] = value;
            return;
        }
        i += 1;
    }
    if (store.len < MaxEntries) {
        store.entries[store.len][0] = key;
        store.entries[store.len][1] = value;
        store.len += 1;
    }
}

fn KeyValueStore_get(store: *const KeyValueStore, key: []const u8) -> (bool, []const u8) {
    var i: usize = 0;
    while (i < store.len) {
        if (store.entries[i][0] == key) {
            return (true, store.entries[i][1]);
        }
        i += 1;
    }
    return (false, "");
}

fn KeyValueStore_remove(store: *KeyValueStore, key: []const u8) -> bool {
    var i: usize = 0;
    while (i < store.len) {
        if (store.entries[i][0] == key) {
            var j: usize = i;
            while (j < store.len - 1) {
                store.entries[j] = store.entries[j + 1];
                j += 1;
            }
            store.len -= 1;
            return true;
        }
        i += 1;
    }
    return false;
}

fn KeyValueStore_deinit(store: *KeyValueStore) -> void {
    return;
}

test init_empty {
    var allocator: usize = 0;
    var store = KeyValueStore_init(allocator);
    assert(store.len == 0);
}

test put_and_get {
    var allocator: usize = 0;
    var store = KeyValueStore_init(allocator);
    KeyValueStore_put(&store, "foo", "bar");
    const (found, value) = KeyValueStore_get(&store, "foo");
    assert(found);
    assert(value == "bar");
}

test put_overwrite {
    var allocator: usize = 0;
    var store = KeyValueStore_init(allocator);
    KeyValueStore_put(&store, "foo", "bar");
    KeyValueStore_put(&store, "foo", "baz");
    const (found, value) = KeyValueStore_get(&store, "foo");
    assert(found);
    assert(value == "baz");
}

test remove {
    var allocator: usize = 0;
    var store = KeyValueStore_init(allocator);
    KeyValueStore_put(&store, "foo", "bar");
    const removed = KeyValueStore_remove(&store, "foo");
    assert(removed);
    const (found, _) = KeyValueStore_get(&store, "foo");
    assert(!found);
}

test get_missing {
    var allocator: usize = 0;
    var store = KeyValueStore_init(allocator);
    const (found, _) = KeyValueStore_get(&store, "missing");
    assert(!found);
}