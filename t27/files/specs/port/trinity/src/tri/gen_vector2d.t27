module port::trinity::src::tri::gen_vector2d;

const Vec2 = struct {
    x: f64,
    y: f64,
};

fn Vec2_add(v1: Vec2, v2: Vec2) Vec2 {
    return .{ .x = v1.x + v2.x, .y = v1.y + v2.y };
}

fn Vec2_sub(v1: Vec2, v2: Vec2) Vec2 {
    return .{ .x = v1.x - v2.x, .y = v1.y - v2.y };
}

fn Vec2_dot(v1: Vec2, v2: Vec2) f64 {
    return v1.x * v2.x + v1.y * v2.y;
}

fn Vec2_length(v: Vec2) f64 {
    let sum_of_squares = v.x * v.x + v.y * v.y;
    if (sum_of_squares == 0.0) {
        return 0.0;
    }
    var guess: f64 = sum_of_squares / 2.0;
    var i: usize = 0;
    while (i < 5) {
        guess = (guess + sum_of_squares / guess) / 2.0;
        i += 1;
    }
    return guess;
}

test Vec2_add {
    let v1 = Vec2{ .x = 1.0, .y = 2.0 };
    let v2 = Vec2{ .x = 3.0, .y = 4.0 };
    let result = Vec2_add(v1, v2);
    assert_eq(result.x, 4.0);
    assert_eq(result.y, 6.0);
}

test Vec2_sub {
    let v1 = Vec2{ .x = 4.0, .y = 6.0 };
    let v2 = Vec2{ .x = 1.0, .y = 2.0 };
    let result = Vec2_sub(v1, v2);
    assert_eq(result.x, 3.0);
    assert_eq(result.y, 4.0);
}

test Vec2_dot {
    let v1 = Vec2{ .x = 1.0, .y = 2.0 };
    let v2 = Vec2{ .x = 3.0, .y = 4.0 };
    let result = Vec2_dot(v1, v2);
    assert_eq(result, 11.0);
}

test Vec2_length {
    let v1 = Vec2{ .x = 3.0, .y = 4.0 };
    let result1 = Vec2_length(v1);
    let squared1 = result1 * result1;
    assert_eq(squared1, 25.0);

    let v2 = Vec2{ .x = 0.0, .y = 0.0 };
    let result2 = Vec2_length(v2);
    assert_eq(result2, 0.0);
}