module port::trinity::src::tri::gen_sigmoid;

pub fn sigmoid(x: f64) -> f64 {
    return 1.0 / (1.0 + @exp(-x));
}

pub fn sigmoidDerivative(x: f64) -> f64 {
    const s = sigmoid(x);
    return s * (1.0 - s);
}

test sigmoid_zero {
    const result = sigmoid(0.0);
    assert(result == 0.5);
}

test sigmoid_positive {
    const result = sigmoid(1.0);
    assert(result > 0.5 and result < 1.0);
}

test sigmoid_negative {
    const result = sigmoid(-1.0);
    assert(result > 0.0 and result < 0.5);
}

test sigmoid_derivative_zero {
    const result = sigmoidDerivative(0.0);
    assert(result == 0.25);
}

test sigmoid_derivative_symmetry {
    const result1 = sigmoidDerivative(1.0);
    const result2 = sigmoidDerivative(-1.0);
    assert(result1 == result2);
}