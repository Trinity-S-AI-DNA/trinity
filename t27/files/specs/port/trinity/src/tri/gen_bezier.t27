module port::trinity::src::tri::gen_bezier;

pub struct CubicBezier {
    p0: [2]f64,
    p1: [2]f64,
    p2: [2]f64,
    p3: [2]f64,
}

// Port of: pub fn eval(curve: CubicBezier, t: f64) [2]f64 {
pub fn BezierCurve_eval(curve: CubicBezier, t: f64) [2]f64 {
    const u = 1.0 - t;
    const uu = u * u;
    const uuu = uu * u;
    const tt = t * t;
    const ttt = tt * t;
    
    return [2]f64{
        (uuu * curve.p0[0] + 3.0 * uu * t * curve.p1[0] + 3.0 * u * tt * curve.p2[0] + ttt * curve.p3[0]),
        (uuu * curve.p0[1] + 3.0 * uu * t * curve.p1[1] + 3.0 * u * tt * curve.p2[1] + ttt * curve.p3[1]),
    };
}

test "bezier_at_t0" {
    const curve = CubicBezier{
        .p0 = [2]f64{0.0, 0.0},
        .p1 = [2]f64{1.0, 0.0},
        .p2 = [2]f64{0.0, 1.0},
        .p3 = [2]f64{1.0, 1.0},
    };
    const p = BezierCurve_eval(curve, 0.0);
    assert(p[0] == 0.0);
    assert(p[1] == 0.0);
}

test "bezier_at_t1" {
    const curve = CubicBezier{
        .p0 = [2]f64{0.0, 0.0},
        .p1 = [2]f64{1.0, 0.0},
        .p2 = [2]f64{0.0, 1.0},
        .p3 = [2]f64{1.0, 1.0},
    };
    const p = BezierCurve_eval(curve, 1.0);
    assert(p[0] == 1.0);
    assert(p[1] == 1.0);
}

test "bezier_at_t05" {
    const curve = CubicBezier{
        .p0 = [2]f64{0.0, 0.0},
        .p1 = [2]f64{1.0, 0.0},
        .p2 = [2]f64{0.0, 1.0},
        .p3 = [2]f64{1.0, 1.0},
    };
    const p = BezierCurve_eval(curve, 0.5);
    // At t=0.5, we expect the point to be approximately (0.5, 0.5) for this curve
    assert(p[0] >= 0.0 and p[0] <= 1.0);
    assert(p[1] >= 0.0 and p[1] <= 1.0);
}