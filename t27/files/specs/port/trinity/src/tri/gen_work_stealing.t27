module port::trinity.src.tri.gen_work_stealing;

const MAX_CAPACITY: usize = 1024;

pub struct WorkStealingDeque {
    tasks: [MAX_CAPACITY]i64,
    capacity: usize,
    bottom: usize,
    top: usize,
}

pub fn WorkStealingDeque_init(allocator: i32, capacity: usize) -> struct { ok: bool, value: WorkStealingDeque } {
    if (capacity > MAX_CAPACITY) {
        return .{ .ok = false, .value = WorkStealingDeque{
            .tasks = [_]i64{0} ** MAX_CAPACITY,
            .capacity = 0,
            .bottom = 0,
            .top = 0,
        } };
    }
    return .{ .ok = true, .value = WorkStealingDeque{
        .tasks = [_]i64{0} ** MAX_CAPACITY,
        .capacity = capacity,
        .bottom = 0,
        .top = 0,
    } };
}

pub fn WorkStealingDeque_push(deque: *WorkStealingDeque, task: i64) -> struct { ok: bool } {
    if (deque.bottom >= deque.capacity) {
        return .{ .ok = false };
    }
    deque.tasks[deque.bottom] = task;
    deque.bottom += 1;
    return .{ .ok = true };
}

pub fn WorkStealingDeque_pop(deque: *WorkStealingDeque) -> struct { ok: bool, value: i64 } {
    if (deque.bottom <= deque.top) {
        return .{ .ok = false, .value = 0 };
    }
    deque.bottom -= 1;
    return .{ .ok = true, .value = deque.tasks[deque.bottom] };
}

pub fn WorkStealingDeque_deinit(deque: *WorkStealingDeque) -> void {
    return undefined;
}

test init_valid_capacity {
    const result = WorkStealingDeque_init(0, 16);
    assert(result.ok);
    const d = result.value;
    assert(d.capacity == 16);
    assert(d.bottom == 0);
    assert(d.top == 0);
}

test init_too_large_capacity {
    const result = WorkStealingDeque_init(0, 2048);
    assert(!result.ok);
}

test push_and_pop {
    const init_result = WorkStealingDeque_init(0, 16);
    assert(init_result.ok);
    var deque = init_result.value;
    
    assert(WorkStealingDeque_push(&deque, 42).ok);
    assert(WorkStealingDeque_push(&deque, 43).ok);
    
    const pop1_result = WorkStealingDeque_pop(&deque);
    assert(pop1_result.ok);
    assert(pop1_result.value == 43);
    
    const pop2_result = WorkStealingDeque_pop(&deque);
    assert(pop2_result.ok);
    assert(pop2_result.value == 42);
    
    const pop3_result = WorkStealingDeque_pop(&deque);
    assert(!pop3_result.ok);
}

test push_until_full {
    const init_result = WorkStealingDeque_init(0, 4);
    assert(init_result.ok);
    var deque = init_result.value;
    
    assert(WorkStealingDeque_push(&deque, 1).ok);
    assert(WorkStealingDeque_push(&deque, 2).ok);
    assert(WorkStealingDeque_push(&deque, 3).ok);
    assert(WorkStealingDeque_push(&deque, 4).ok);
    
    const push5_result = WorkStealingDeque_push(&deque, 5);
    assert(!push5_result.ok);
    
    const pop1_result = WorkStealingDeque_pop(&deque);
    assert(pop1_result.ok);
    assert(pop1_result.value == 4);
    
    const pop2_result = WorkStealingDeque_pop(&deque);
    assert(pop2_result.ok);
    assert(pop2_result.value == 3);
    
    const pop3_result = WorkStealingDeque_pop(&deque);
    assert(pop3_result.ok);
    assert(pop3_result.value == 2);
    
    const pop4_result = WorkStealingDeque_pop(&deque);
    assert(pop4_result.ok);
    assert(pop4_result.value == 1);
    
    const pop5_result = WorkStealingDeque_pop(&deque);
    assert(!pop5_result.ok);
}

test alternating_push_pop {
    const init_result = WorkStealingDeque_init(0, 4);
    assert(init_result.ok);
    var deque = init_result.value;
    
    assert(WorkStealingDeque_push(&deque, 10).ok);
    const pop1_result = WorkStealingDeque_pop(&deque);
    assert(pop1_result.ok);
    assert(pop1_result.value == 10);
    
    assert(WorkStealingDeque_push(&deque, 20).ok);
    const pop2_result = WorkStealingDeque_pop(&deque);
    assert(pop2_result.ok);
    assert(pop2_result.value == 20);
    
    assert(WorkStealingDeque_push(&deque, 30).ok);
    const pop3_result = WorkStealingDeque_pop(&deque);
    assert(pop3_result.ok);
    assert(pop3_result.value == 30);
}