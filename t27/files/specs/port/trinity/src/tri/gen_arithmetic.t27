module port::trinity.src.tri.gen_arithmetic;

struct ArithmeticCoder {
    low: u32,
    high: u32,
}

fn ArithmeticCoder_init() ArithmeticCoder {
    return ArithmeticCoder {
        low: 0,
        high: 0xFFFFFFFFu32,
    };
}

fn ArithmeticCoder_encode(coder: *ArithmeticCoder, symbol: usize, cum_freq: []const usize, total: usize) -> void {
    let range = coder.high - coder.low + 1;
    coder.high = coder.low + ((range * cum_freq[symbol + 1]) / total) as u32 - 1;
    coder.low = coder.low + ((range * cum_freq[symbol]) / total) as u32;
}

fn ArithmeticCoder_deinit(coder: *ArithmeticCoder) void {
    return;
}

test "arithmetic coder init" {
    let coder = ArithmeticCoder_init();
    assert(coder.low == 0);
    assert(coder.high == 0xFFFFFFFFu32);
}

test "arithmetic coder encode" {
    var coder = ArithmeticCoder {
        low: 0,
        high: 100,
    };
    let symbol: usize = 0;
    let cum_freq: [3]usize = [0, 50, 100];
    let total: usize = 100;
    ArithmeticCoder_encode(&coder, symbol, &cum_freq, total);
    assert(coder.low == 0);
    assert(coder.high == 49);
}

test "arithmetic coder deinit" {
    let mut coder = ArithmeticCoder_init();
    let low_before = coder.low;
    let high_before = coder.high;
    ArithmeticCoder_deinit(&coder);
    assert(coder.low == low_before);
    assert(coder.high == high_before);
}