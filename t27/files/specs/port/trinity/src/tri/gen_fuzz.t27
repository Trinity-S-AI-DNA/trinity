module port::trinity::gen_fuzz;

const Allocator = struct { id: u32; };
const RngState = struct { seed: u64, counter: u64, state: u64; };

// The Zig original draws from std.Random.DefaultPrng (xoshiro256++), whose
// additions wrap. t27c emits `+` and `*` on u64 without wrapping in Zig and
// Rust, so this port uses xorshift64 (Marsaglia, 13/7/17): shifts and xors
// only, nothing to overflow. Same contract -- deterministic per seed, a byte
// per draw, an inclusive integer range -- not the same stream as the original.
const RNG_ZERO_SEED_STATE : u64 = 88172645463325252;

var alloc_buffer: [1024]u8 = [0] ** 1024;

fn allocator_alloc(allocator: Allocator, len: usize) -> []u8 {
    return alloc_buffer[0..len];
}
fn rng_init(seed: u64) -> RngState {
    var state : u64 = seed;
    if (state == 0) {
        state = RNG_ZERO_SEED_STATE;
    }
    return .{ .seed = seed, .counter = 0, .state = state };
}
fn rng_step(rng_state: *RngState) -> u64 {
    var x : u64 = rng_state.state;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    rng_state.state = x;
    rng_state.counter = rng_state.counter + 1;
    return x;
}
fn rng_next(rng_state: *RngState) -> u8 {
    const x : u64 = rng_step(rng_state);
    return @as(u8, @intCast(x & 255));
}
fn rng_int_range(rng_state: *RngState, min: i32, max: i32) -> i32 {
    const x : u64 = rng_step(rng_state);
    if (max <= min) {
        return min;
    }
    const span : u64 = @as(u64, @intCast(@as(i64, max) - @as(i64, min))) + 1;
    const offset : i64 = @as(i64, @intCast(x % span));
    return @as(i32, @intCast(@as(i64, min) + offset));
}

const Fuzzer = struct {
    allocator: Allocator,
    rng_state: RngState,
};

fn Fuzzer_init(allocator: Allocator, seed: u64) -> Fuzzer {
    return .{
        .allocator = allocator,
        .rng_state = rng_init(seed),
    };
}

fn Fuzzer_randomBytes(fuzzer: *Fuzzer, len: usize) -> []u8 {
    const bytes = allocator_alloc(fuzzer.allocator, len);
    var i: usize = 0;
    while (i < len) {
        bytes[i] = rng_next(&fuzzer.rng_state);
        i = i + 1;
    }
    return bytes;
}

fn Fuzzer_randomInt(fuzzer: *Fuzzer, min: i32, max: i32) -> i32 {
    return rng_int_range(&fuzzer.rng_state, min, max);
}

test "Fuzzer_init_seed" {
    var a: Allocator = Allocator { id: 0 };
    var f = Fuzzer_init(a, 42);
    assert(f.rng_state.seed == 42);
    assert(f.rng_state.counter == 0);
}

test "Fuzzer_randomBytes_increments_counter" {
        var a: Allocator = Allocator { id: 0 };
        var f = Fuzzer_init(a, 0);
        const len = 5;
        const bytes = Fuzzer_randomBytes(&f, len);
        assert(bytes.len >= 0);
        assert(f.rng_state.counter == len);
    }

test "Fuzzer_randomInt_increments_counter" {
    var a: Allocator = Allocator { id: 0 };
    var f = Fuzzer_init(a, 0);
    const x = Fuzzer_randomInt(&f, 0, 10);
    assert(x >= 0);
    assert(x <= 10);
    assert(f.rng_state.counter == 1);
}

test "rng_same_seed_draws_the_same_bytes" {
    var a = rng_init(42);
    var b = rng_init(42);
    var i: u32 = 0;
    while (i < 16) {
        assert(rng_next(&a) == rng_next(&b));
        i = i + 1;
    }
}

test "rng_bytes_are_not_one_constant" {
    var r = rng_init(1);
    const first = rng_next(&r);
    var differs = false;
    var i: u32 = 0;
    while (i < 8) {
        if (rng_next(&r) != first) {
            differs = true;
        }
        i = i + 1;
    }
    assert(differs);
}

test "rng_int_range_stays_inside_the_range" {
    var r = rng_init(7);
    var low_seen = false;
    var high_seen = false;
    var i: u32 = 0;
    while (i < 256) {
        const x = rng_int_range(&r, -3, 5);
        assert(x >= -3);
        assert(x <= 5);
        if (x == -3) {
            low_seen = true;
        }
        if (x == 5) {
            high_seen = true;
        }
        i = i + 1;
    }
    assert(low_seen);
    assert(high_seen);
}

test "rng_int_range_of_one_value_returns_it" {
    var r = rng_init(9);
    assert(rng_int_range(&r, 4, 4) == 4);
    assert(r.counter == 1);
}

test "rng_zero_seed_still_moves" {
    var r = rng_init(0);
    assert(r.seed == 0);
    assert(r.state != 0);
    const before = r.state;
    const b = rng_next(&r);
    assert(r.state != before);
    assert(b == @as(u8, @intCast(r.state & 255)));
    assert(r.counter == 1);
}