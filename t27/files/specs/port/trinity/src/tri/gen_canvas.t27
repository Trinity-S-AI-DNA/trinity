// Port of gHashTag/trinity:src/tri/gen_canvas.zig (tri/canvas, a drawing
// canvas). The Zig: init takes an allocator and appends width * height
// opaque black pixels (r = g = b = 0, a = 255); setPixel writes
// pixels[y * width + x], and returns error.OutOfBounds when x >= width or
// y >= height; clear sets every pixel to one color; deinit frees the pixels.
// Here the allocator becomes a caller buffer: Canvas_init takes the pixel
// storage and uses its first width * height entries (a shorter buffer traps
// on the index, where the Zig's alloc would fail). The caller owns that
// storage, so deinit has nothing to free. t27 has no error unions, so
// setPixel ignores an out-of-bounds call.
//
// #7658: the first port filled a local [10000]Color inside Canvas_init and
// returned a slice of it. That slice pointed into Canvas_init's own frame,
// so every pixel the tests read came from a frame that had already ended.

module tri::gen_canvas;

pub const Color = struct {
    r: u8,
    g: u8,
    b: u8,
    a: u8,
};

pub const Canvas = struct {
    pixels: []Color,
    width: usize,
    height: usize,
};

pub fn Canvas_init(storage: []Color, width: usize, height: usize) -> Canvas {
    var count: usize = 0;

    // Initialize pixels, in the caller's storage
    for (0..width * height) |i| {
        storage[i] = Color{ .r = 0, .g = 0, .b = 0, .a = 255 };
        count += 1;
    }

    return Canvas{
        .pixels = storage[0..count],
        .width = width,
        .height = height,
    };
}

pub fn Canvas_setPixel(canvas: *Canvas, x: usize, y: usize, color: Color) -> void {
    if (x >= canvas.width or y >= canvas.height) {
        return; // In t27 we can't throw errors, so just return
    }
    canvas.pixels[y * canvas.width + x] = color;
}

pub fn Canvas_clear(canvas: *Canvas, color: Color) -> void {
    var i: usize = 0;
    while (i < canvas.pixels.len) {
        canvas.pixels[i] = color;
        i += 1;
    }
}

pub fn Canvas_deinit(canvas: *Canvas) -> void {
    // The caller owns the pixel storage, so there is nothing to free
    return;
}

// Each test owns its pixel storage, filled with 9s so that only what
// Canvas_init writes reads back as black.

test Canvas_init_basic {
    var storage: [100]Color = [Color{ .r = 9, .g = 9, .b = 9, .a = 9 }] ** 100;
    var canvas = Canvas_init(&storage, 10, 10);
    assert(canvas.width == 10);
    assert(canvas.height == 10);
    assert(canvas.pixels.len == 100);
    assert(canvas.pixels[0].r == 0);
    assert(canvas.pixels[0].g == 0);
    assert(canvas.pixels[0].b == 0);
    assert(canvas.pixels[0].a == 255);
}

test Canvas_setPixel_valid {
    var storage: [25]Color = [Color{ .r = 9, .g = 9, .b = 9, .a = 9 }] ** 25;
    var canvas = Canvas_init(&storage, 5, 5);
    var red_color = Color{ .r = 255, .g = 0, .b = 0, .a = 255 };
    Canvas_setPixel(&canvas, 2, 3, red_color);
    assert(canvas.pixels[3 * 5 + 2].r == 255);
    assert(canvas.pixels[3 * 5 + 2].g == 0);
    assert(canvas.pixels[3 * 5 + 2].b == 0);
    assert(canvas.pixels[3 * 5 + 2].a == 255);
}

test Canvas_setPixel_out_of_bounds {
    var storage: [25]Color = [Color{ .r = 9, .g = 9, .b = 9, .a = 9 }] ** 25;
    var canvas = Canvas_init(&storage, 5, 5);
    var red_color = Color{ .r = 255, .g = 0, .b = 0, .a = 255 };
    // These should not crash the program
    Canvas_setPixel(&canvas, 10, 3, red_color); // x out of bounds
    Canvas_setPixel(&canvas, 2, 10, red_color); // y out of bounds
    // Check that pixels are unchanged
    assert(canvas.pixels[0].r == 0);
    assert(canvas.pixels[0].g == 0);
    assert(canvas.pixels[0].b == 0);
    assert(canvas.pixels[0].a == 255);
}

test Canvas_clear {
    var storage: [9]Color = [Color{ .r = 9, .g = 9, .b = 9, .a = 9 }] ** 9;
    var canvas = Canvas_init(&storage, 3, 3);
    var red_color = Color{ .r = 255, .g = 0, .b = 0, .a = 255 };
    // Set some pixels
    Canvas_setPixel(&canvas, 0, 0, red_color);
    Canvas_setPixel(&canvas, 1, 1, red_color);
    // Clear to blue
    var blue_color = Color{ .r = 0, .g = 0, .b = 255, .a = 255 };
    Canvas_clear(&canvas, blue_color);
    // All pixels should be blue
    for (0..9) |i| {
        assert(canvas.pixels[i].r == 0);
        assert(canvas.pixels[i].g == 0);
        assert(canvas.pixels[i].b == 255);
        assert(canvas.pixels[i].a == 255);
    }
}

test Canvas_deinit {
    var storage: [4]Color = [Color{ .r = 9, .g = 9, .b = 9, .a = 9 }] ** 4;
    var canvas = Canvas_init(&storage, 2, 2);
    Canvas_deinit(&canvas);
    // The function should not crash, and it frees nothing: the caller's
    // storage still holds the pixels Canvas_init wrote
    assert(canvas.pixels.len == 4);
    assert(storage[3].a == 255);
}
