struct Barrier {
    count: usize,
    remaining: usize,
}

fn Barrier_init(num_threads: usize) Barrier {
    return Barrier{
        count: num_threads,
        remaining: num_threads,
    };
}

fn Barrier_wait(barrier: *Barrier) void {
    barrier.remaining -= 1;
    if (barrier.remaining == 0) {
        barrier.remaining = barrier.count;
    }
}

test "barrier_wait_three_times" {
    var b: Barrier = Barrier_init(3);
    Barrier_wait(&b);
    assert(b.remaining == 2);
    Barrier_wait(&b);
    assert(b.remaining == 1);
    Barrier_wait(&b);
    assert(b.remaining == 3);
}

test "barrier_wait_one_thread" {
    var b: Barrier = Barrier_init(1);
    Barrier_wait(&b);
    assert(b.remaining == 1);
}