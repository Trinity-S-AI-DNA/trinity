module port::trinity::src::tri;

const MAX_CALLS = 8;

pub struct Mock {
    calls: [MAX_CALLS][]const u8,
    len: usize,
}

pub fn Mock_init(allocator: u32) Mock {
    var calls_array: [MAX_CALLS][]const u8 = undefined;
    for (0..MAX_CALLS) |i| {
        calls_array[i] = "";
    }
    return Mock{
        .calls = calls_array,
        .len = 0,
    };
}

pub fn Mock_record(mock: *Mock, method: []const u8) void {
    if (mock.len < MAX_CALLS) {
        mock.calls[mock.len] = method;
        mock.len += 1;
    }
}

pub fn Mock_wasCalled(mock: *const Mock, method: []const u8) bool {
    for (0..mock.len) |i| {
        if (mock.calls[i] == method) return true;
    }
    return false;
}

pub fn Mock_deinit(mock: *Mock) void {
    // In the original, this would free all allocated strings
    // Since we're using fixed arrays in .t27, we just reset the length
    mock.len = 0;
}

test "Mock_init" {
    var mock = Mock_init(0);
    assert(mock.len == 0);
    assert(mock.calls[0] == "");
}

test "Mock_record_and_wasCalled" {
    var mock = Mock_init(0);
    Mock_record(&mock, "foo");
    assert(Mock_wasCalled(&mock, "foo") == true);
    assert(Mock_wasCalled(&mock, "bar") == false);
}

test "Mock_multiple_records" {
    var mock = Mock_init(0);
    Mock_record(&mock, "method1");
    Mock_record(&mock, "method2");
    Mock_record(&mock, "method1");
    assert(Mock_wasCalled(&mock, "method1") == true);
    assert(Mock_wasCalled(&mock, "method2") == true);
    assert(Mock_wasCalled(&mock, "method3") == false);
    assert(mock.len == 3);
}

test "Mock_deinit" {
    var mock = Mock_init(0);
    Mock_record(&mock, "test");
    assert(Mock_wasCalled(&mock, "test") == true);
    Mock_deinit(&mock);
    assert(Mock_wasCalled(&mock, "test") == false);
    assert(mock.len == 0);
}

test "Mock_max_calls" {
    var mock = Mock_init(0);
    // Fill to capacity with different methods
    Mock_record(&mock, "method0");
    Mock_record(&mock, "method1");
    Mock_record(&mock, "method2");
    Mock_record(&mock, "method3");
    Mock_record(&mock, "method4");
    Mock_record(&mock, "method5");
    Mock_record(&mock, "method6");
    Mock_record(&mock, "method7");
    assert(mock.len == MAX_CALLS);
    
    // One more call should be ignored
    Mock_record(&mock, "overflow");
    assert(mock.len == MAX_CALLS);
    
    // All recorded methods should still be there
    assert(Mock_wasCalled(&mock, "method0") == true);
    assert(Mock_wasCalled(&mock, "method1") == true);
    assert(Mock_wasCalled(&mock, "method2") == true);
    assert(Mock_wasCalled(&mock, "method3") == true);
    assert(Mock_wasCalled(&mock, "method4") == true);
    assert(Mock_wasCalled(&mock, "method5") == true);
    assert(Mock_wasCalled(&mock, "method6") == true);
    assert(Mock_wasCalled(&mock, "method7") == true);
    assert(Mock_wasCalled(&mock, "overflow") == false);
}