module port::trinity::src::tri::gen_quaternion;

pub const Quaternion = struct {
    w: f64,
    x: f64,
    y: f64,
    z: f64,
};

pub fn Quaternion_identity() Quaternion {
    return Quaternion{ .w = 1.0, .x = 0.0, .y = 0.0, .z = 0.0 };
}

pub fn Quaternion_multiply(q1: Quaternion, q2: Quaternion) Quaternion {
    return Quaternion{
        .w = q1.w * q2.w - q1.x * q2.x - q1.y * q2.y - q1.z * q2.z,
        .x = q1.w * q2.x + q1.x * q2.w + q1.y * q2.z - q1.z * q2.y,
        .y = q1.w * q2.y - q1.x * q2.z + q1.y * q2.w + q1.z * q2.x,
        .z = q1.w * q2.z + q1.x * q2.y - q1.y * q2.x + q1.z * q2.w,
    };
}

test Quaternion_identity_test {
    const q = Quaternion_identity();
    assert(q.w == 1.0);
    assert(q.x == 0.0);
    assert(q.y == 0.0);
    assert(q.z == 0.0);
}

test Quaternion_multiply_test {
    const q1 = Quaternion{ .w = 1.0, .x = 0.0, .y = 0.0, .z = 0.0 };
    const q2 = Quaternion{ .w = 2.0, .x = 3.0, .y = 4.0, .z = 5.0 };
    const q3 = Quaternion_multiply(q1, q2);
    assert(q3.w == 2.0);
    assert(q3.x == 3.0);
    assert(q3.y == 4.0);
    assert(q3.z == 5.0);
}