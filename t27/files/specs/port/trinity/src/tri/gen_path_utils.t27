module port::trinity::src::tri::gen_path_utils;

pub fn basename(path: []const u8) -> []const u8 {
    var last_slash: ?usize = null;
    var i: usize = 0;
    
    // Find the last occurrence of '/'
    while (i < path.len) {
        if (path[i] == '/' as u8) {
            last_slash = i;
        }
        i += 1;
    }
    
    // Return everything after the last slash, or the whole string if no slash found
    if (last_slash != null) {
        const slash_idx = last_slash.?;
        if (slash_idx + 1 < path.len) {
            return path[slash_idx + 1 .. path.len];
        }
        return "";
    }
    return path;
}

pub fn dirname(path: []const u8) -> []const u8 {
    var last_slash: ?usize = null;
    var i: usize = 0;
    
    // Find the last occurrence of '/'
    while (i < path.len) {
        if (path[i] == '/' as u8) {
            last_slash = i;
        }
        i += 1;
    }
    
    // Return everything before the last slash, or "." if no slash found
    if (last_slash != null) {
        const slash_idx = last_slash.?;
        if (slash_idx == 0) {
            return "/";
        }
        return path[0 .. slash_idx];
    }
    return ".";
}

test "basename simple path" {
    const path = "/home/user/file.txt";
    assert(basename(path) == "file.txt");
}

test "basename root file" {
    const path = "/file.txt";
    assert(basename(path) == "file.txt");
}

test "basename no slash" {
    const path = "filename";
    assert(basename(path) == "filename");
}

test "basename trailing slash" {
    const path = "/home/user/";
    assert(basename(path) == "");
}

test "dirname simple path" {
    const path = "/home/user/file.txt";
    assert(dirname(path) == "/home/user");
}

test "dirname root file" {
    const path = "/file.txt";
    assert(dirname(path) == "/");
}

test "dirname no slash" {
    const path = "filename";
    assert(dirname(path) == ".");
}

test "dirname multiple slashes" {
    const path = "/home/user/subdir/file.txt";
    assert(dirname(path) == "/home/user/subdir");
}

test "dirname root directory" {
    const path = "/";
    assert(dirname(path) == "/");
}