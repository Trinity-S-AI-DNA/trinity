struct RwLock {
    readers: usize,
    writer: bool,
}

fn RwLock_init() RwLock {
    return RwLock{
        readers: 0,
        writer: false,
    };
}

fn RwLock_readLock(lock: *RwLock) void {
    while (lock.writer) {}
    lock.readers += 1;
}

fn RwLock_readUnlock(lock: *RwLock) void {
    lock.readers -= 1;
}

fn RwLock_writeLock(lock: *RwLock) void {
    while (lock.writer or lock.readers > 0) {}
    lock.writer = true;
}

fn RwLock_writeUnlock(lock: *RwLock) void {
    lock.writer = false;
}

// Test basic initialization
test "rwlock_init" {
    var lock: RwLock = RwLock_init();
    assert(lock.readers == 0);
    assert(lock.writer == false);
}

// Test read lock/unlock
test "rwlock_read_lock_unlock" {
    var lock: RwLock = RwLock_init();
    RwLock_readLock(&lock);
    assert(lock.readers == 1);
    RwLock_readUnlock(&lock);
    assert(lock.readers == 0);
}

// Test write lock/unlock
test "rwlock_write_lock_unlock" {
    var lock: RwLock = RwLock_init();
    RwLock_writeLock(&lock);
    assert(lock.writer == true);
    RwLock_writeUnlock(&lock);
    assert(lock.writer == false);
}

// Test multiple readers
test "rwlock_multiple_readers" {
    var lock: RwLock = RwLock_init();
    RwLock_readLock(&lock);
    assert(lock.readers == 1);
    RwLock_readLock(&lock);
    assert(lock.readers == 2);
    RwLock_readUnlock(&lock);
    assert(lock.readers == 1);
    RwLock_readUnlock(&lock);
    assert(lock.readers == 0);
}

// Test writer waits for readers
test "rwlock_writer_waits_for_readers" {
    // This test checks that the logic is correct - we can't easily test the blocking
    // behavior without concurrency, but we can test the decision logic
    var lock: RwLock = RwLock_init();
    // Simulate having readers
    lock.readers = 2;
    lock.writer = false;
    // The writeLock function should wait (in real usage) because readers > 0
    // We test that the condition is correct by checking what would cause it to wait
    assert(lock.writer or lock.readers > 0 == true); // Should be true since readers > 0
}