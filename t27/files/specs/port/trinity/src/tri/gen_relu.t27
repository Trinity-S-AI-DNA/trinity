pub fn relu(x: f64) -> f64 {
    return if (x > 0) x else 0;
}

pub fn reluDerivative(x: f64) -> f64 {
    return if (x > 0) 1 else 0;
}

test "relu positive" {
    assert(relu(5.0) == 5.0);
}

test "relu negative" {
    assert(relu(-5.0) == 0.0);
}

test "reluDerivative positive" {
    assert(reluDerivative(5.0) == 1.0);
}

test "reluDerivative nonPositive" {
    assert(reluDerivative(-5.0) == 0.0);
    assert(reluDerivative(0.0) == 0.0);
}