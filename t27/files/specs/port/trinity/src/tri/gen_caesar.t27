module port::trinity::src::tri::gen_caesar;

pub fn caesarEncrypt(text: []const u8, shift: u8, output: []u8) {
    var i: usize = 0;
    for c in text {
        output[i] = c + shift;
        i += 1;
    }
}

pub fn caesarDecrypt(text: []const u8, shift: u8, output: []u8) {
    var i: usize = 0;
    for c in text {
        output[i] = c - shift;
        i += 1;
    }
}

test "caesarEncrypt test" {
    var input: [3]u8 = [@as(u8, 'A'), @as(u8, 'B'), @as(u8, 'C')];
    var output: [3]u8;
    caesarEncrypt(&input, 1, &output);
    assert_eq(output[0], @as(u8, 'B'));
    assert_eq(output[1], @as(u8, 'C'));
    assert_eq(output[2], @as(u8, 'D'));
}

test "caesarDecrypt test" {
    var input: [3]u8 = [@as(u8, 'B'), @as(u8, 'C'), @as(u8, 'D')];
    var output: [3]u8;
    caesarDecrypt(&input, 1, &output);
    assert_eq(output[0], @as(u8, 'A'));
    assert_eq(output[1], @as(u8, 'B'));
    assert_eq(output[2], @as(u8, 'C'));
}