struct Semaphore {
    count: usize,
}

fn Semaphore_init(initial: usize) Semaphore {
    return .{ .count = initial };
}

fn Semaphore_wait(sem: *Semaphore) void {
    while (sem.count == 0) {}
    sem.count -= 1;
}

fn Semaphore_signal(sem: *Semaphore) void {
    sem.count += 1;
}

fn Semaphore_tryWait(sem: *Semaphore) bool {
    if (sem.count == 0) return false;
    sem.count -= 1;
    return true;
}

test "semaphore_init" {
    var sem = Semaphore_init(5);
    assert(sem.count == 5);
}

test "semaphore_wait_signal" {
    var sem = Semaphore_init(0);
    assert(!Semaphore_tryWait(&sem));
    Semaphore_signal(&sem);
    assert(Semaphore_tryWait(&sem));
}

test "semaphore_wait_blocks_until_signal" {
    var sem = Semaphore_init(1);
    Semaphore_wait(&sem);
    assert(sem.count == 0);
}

test "semaphore_signal_increments" {
    var sem = Semaphore_init(0);
    Semaphore_signal(&sem);
    assert(sem.count == 1);
    Semaphore_signal(&sem);
    assert(sem.count == 2);
}

test "semaphore_tryWait_decrements_and_returns_true" {
    var sem = Semaphore_init(2);
    assert(Semaphore_tryWait(&sem));
    assert(sem.count == 1);
    assert(Semaphore_tryWait(&sem));
    assert(sem.count == 0);
    assert(!Semaphore_tryWait(&sem));
}