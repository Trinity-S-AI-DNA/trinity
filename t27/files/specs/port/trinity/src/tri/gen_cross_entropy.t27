module port::trinity::tri::gen_cross_entropy;

pub fn crossEntropy(predictions: []f64, targets: []f64) -> f64 {
    var loss: f64 = 0;
    for (predictions, targets) |p, t| {
        loss -= t * @log(p + 1e-10);
    }
    return loss;
}

test cross_entropy_basic {
    var preds: [2]f64 = [0.5, 0.5];
    var targets: [2]f64 = [1.0, 0.0];
    const loss = crossEntropy(&preds, &targets);
    assert(loss > 0);
}

test cross_entropy_perfect_match {
    var preds: [2]f64 = [1.0, 0.0];
    var targets: [2]f64 = [1.0, 0.0];
    const loss = crossEntropy(&preds, &targets);
    assert(loss < 1e-5);
}

test cross_entropy_symmetric {
    var preds: [2]f64 = [0.5, 0.5];
    var targets: [2]f64 = [0.0, 1.0];
    const loss = crossEntropy(&preds, &targets);
    assert(loss > 0);
}