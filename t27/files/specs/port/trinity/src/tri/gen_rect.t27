module port::trinity::src::tri::gen_rect;

pub const RectPoint = struct {
    x: f64,
    y: f64,
};

pub const Rect = struct {
    x: f64,
    y: f64,
    width: f64,
    height: f64,
};

pub fn Rect_init(x: f64, y: f64, width: f64, height: f64) Rect {
    return .{ .x = x, .y = y, .width = width, .height = height };
}

pub fn Rect_contains(rect: *const Rect, point: RectPoint) bool {
    return point.x >= rect.x and point.x <= rect.x + rect.width and
        point.y >= rect.y and point.y <= rect.y + rect.height;
}

pub fn Rect_area(rect: *const Rect) f64 {
    return rect.width * rect.height;
}

test rect_init_basic {
    const rect = Rect_init(0, 0, 10, 10);
    assert(rect.x == 0);
    assert(rect.y == 0);
    assert(rect.width == 10);
    assert(rect.height == 10);
}

test rect_contains_inside {
    const rect = Rect_init(0, 0, 10, 10);
    const p = RectPoint{ .x = 5, .y = 5 };
    assert(Rect_contains(&rect, p));
}

test rect_contains_edge {
    const rect = Rect_init(0, 0, 10, 10);
    const p1 = RectPoint{ .x = 0, .y = 0 };
    const p2 = RectPoint{ .x = 10, .y = 10 };
    assert(Rect_contains(&rect, p1));
    assert(Rect_contains(&rect, p2));
}

test rect_contains_outside {
    const rect = Rect_init(0, 0, 10, 10);
    const p1 = RectPoint{ .x = -1, .y = 5 };
    const p2 = RectPoint{ .x = 5, .y = -1 };
    const p3 = RectPoint{ .x = 11, .y = 5 };
    const p4 = RectPoint{ .x = 5, .y = 11 };
    assert(!Rect_contains(&rect, p1));
    assert(!Rect_contains(&rect, p2));
    assert(!Rect_contains(&rect, p3));
    assert(!Rect_contains(&rect, p4));
}

test rect_area_basic {
    const rect = Rect_init(0, 0, 10, 10);
    assert(Rect_area(&rect) == 100);
}

test rect_area_rectangular {
    const rect = Rect_init(2, 3, 5, 7);
    assert(Rect_area(&rect) == 35);
}