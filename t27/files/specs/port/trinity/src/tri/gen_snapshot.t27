module port::trinity::src::tri::gen_snapshot;

pub const Snapshot = struct {
    data: []const u8,
};

pub fn Snapshot_init(data: []const u8) -> Snapshot {
    return Snapshot{ .data = data };
}

pub fn Snapshot_match(snapshot: *const Snapshot, expected: []const u8) -> bool {
    return snapshot.data == expected;
}

test Snapshot_init_sets_data {
    const snap = Snapshot_init("hello");
    assert(snap.data == "hello");
}

test Snapshot_match_returns_true_for_equal {
    const snap = Snapshot_init("hello");
    assert(Snapshot_match(&snap, "hello"));
}