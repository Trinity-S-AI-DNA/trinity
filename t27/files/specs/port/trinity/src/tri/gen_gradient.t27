module port::trinity::src::tri::gen_gradient;

pub const Color = struct {
    r: u8,
    g: u8,
    b: u8,
    a: u8,
};

pub const Gradient = struct {
    offsets: [4]f64,
    colors: [4]Color,
    allocator: usize,
};

pub fn Gradient_init(allocator: usize) Gradient {
    return Gradient{
        .offsets = [0, 0, 0, 0],
        .colors = [_]Color{ Color{ .r = 0, .g = 0, .b = 0, .a = 255 } } ** 4,
        .allocator = allocator,
    };
}

pub fn Gradient_addStop(gradient: *Gradient, offset: f64, color: Color) void {
    _ = gradient;
    _ = offset;
    _ = color;
    return;
}

pub fn Gradient_sample(gradient: *const Gradient, t: f64) Color {
    _ = t;
    if (gradient.offsets.len > 0) {
        return gradient.colors[0];
    }
    return Color{ .r = 0, .g = 0, .b = 0, .a = 255 };
}

pub fn Gradient_deinit(gradient: *Gradient) void {
    _ = gradient;
    return;
}

test gradient_init {
    var grad = Gradient_init(0);
    assert(grad.offsets.len == 4);
    assert(grad.colors.len == 4);
    assert(grad.allocator == 0);
}

test gradient_addStop {
    var grad = Gradient_init(0);
    defer Gradient_deinit(&grad);
    const red = Color{ .r = 255, .g = 0, .b = 0, .a = 255 };
    Gradient_addStop(&grad, 0.0, red);
    assert(grad.offsets.len == 4);
    assert(grad.colors.len == 4);
}

test gradient_sample {
    var grad = Gradient_init(0);
    defer Gradient_deinit(&grad);
    
    // Test with empty gradient
    const c1 = Gradient_sample(&grad, 0.5);
    assert(c1.r == 0);
    assert(c1.g == 0);
    assert(c1.b == 0);
    assert(c1.a == 255);
    
    // Test with gradient that has colors
    grad.colors[0] = Color{ .r = 255, .g = 0, .b = 0, .a = 255 };
    const c2 = Gradient_sample(&grad, 0.5);
    assert(c2.r == 255);
    assert(c2.g == 0);
    assert(c2.b == 0);
    assert(c2.a == 255);
}

test gradient_deinit {
    var grad = Gradient_init(0);
    Gradient_deinit(&grad);
    assert(true);
}