module port::trinity::tri::gen_hazard_pointers;

const MAX_HAZARDS = 10;

pub struct HazardPointer {
    pointer: ?*anyopaque,
    active: bool,
}

pub struct HazardRegistry {
    hazards: [MAX_HAZARDS]HazardPointer,
    allocator: ?*anyopaque, // std.mem.Allocator adapted to *anyopaque
}

pub fn HazardRegistry_init(allocator: ?*anyopaque) -> HazardRegistry {
    var hazards: [MAX_HAZARDS]HazardPointer = undefined;
    var i: usize = 0;
    while (i < 10) {
        hazards[i] = HazardPointer {
            .pointer = null,
            .active = false,
        };
        i += 1;
    }
    return HazardRegistry {
        .hazards = hazards,
        .allocator = allocator,
    };
}

pub fn HazardRegistry_acquire(registry: *HazardRegistry) -> ?*HazardPointer {
    var i: usize = 0;
    while (i < 10) {
        var h = &registry.hazards[i];
        if (!h.active) {
            h.active = true;
            return h;
        }
        i += 1;
    }
    return null;
}

pub fn HazardRegistry_release(hazard: *HazardPointer) -> void {
    hazard.pointer = null;
    hazard.active = false;
}

pub fn HazardRegistry_deinit(registry: *HazardRegistry) -> void {
    // In the original, this would call registry.hazards.deinit(registry.allocator)
    // Since we're using a fixed-size array, we don't need to deinit it
    // We just need to release all hazards
    var i: usize = 0;
    while (i < 10) {
        var h = &registry.hazards[i];
        if (h.active) {
            h.pointer = null;
            h.active = false;
        }
        i += 1;
    }
}

test hazard_pointer_basic {
    var registry = HazardRegistry_init(null);
    var hazard = HazardRegistry_acquire(&registry);
    assert(hazard != null);
}

test hazard_pointer_acquire_multiple {
    var registry = HazardRegistry_init(null);
    var hazard1 = HazardRegistry_acquire(&registry);
    var hazard2 = HazardRegistry_acquire(&registry);
    assert(hazard1 != null);
    assert(hazard2 != null);
    assert(hazard1 != hazard2);
}

test hazard_pointer_acquire_full {
    var registry = HazardRegistry_init(null);
    var i: usize = 0;
    while (i < 10) {
        var hazard = HazardRegistry_acquire(&registry);
        assert(hazard != null);
        i += 1;
    }
    var extra = HazardRegistry_acquire(&registry);
    assert(extra == null);
}

test hazard_pointer_release {
    var registry = HazardRegistry_init(null);
    var hazard = HazardRegistry_acquire(&registry);
    assert(hazard != null);
    // Find the hazard and release it
    var i: usize = 0;
    while (i < 10) {
        if (&registry.hazards[i] == hazard) {
            HazardRegistry_release(&registry.hazards[i]);
            break;
        }
        i += 1;
    }
}