//! tri/epoch_reclamation — Epoch-based reclamation
//! TTT Dogfood v0.2 Stage 230

const EPOCH_COUNT = 3;

struct EpochManager {
    current_epoch: usize,
    counters: [EPOCH_COUNT]usize,
}

fn EpochManager_init(allocator: usize) ?EpochManager {
    _ = allocator;
    return EpochManager {
        .current_epoch = 0,
        .counters = [_]usize{0} ** EPOCH_COUNT,
    };
}

fn EpochManager_enter(manager: *EpochManager) usize {
    const epoch = manager.current_epoch;
    manager.counters[epoch] += 1;
    return epoch;
}

fn EpochManager_exit(manager: *EpochManager, epoch: usize) void {
    manager.counters[epoch] -= 1;
    if (manager.counters[manager.current_epoch] == 0) {
        const next_epoch = (manager.current_epoch + 1) % EPOCH_COUNT;
        manager.current_epoch = next_epoch;
    }
}

fn EpochManager_deinit(manager: *EpochManager) void {
    const _ = manager;
}

test epoch_manager_init {
    const manager = EpochManager_init(0);
    assert(manager != null);
    const m = manager.?;
    assert(m.current_epoch == 0);
    assert(m.counters[0] == 0);
    assert(m.counters[1] == 0);
    assert(m.counters[2] == 0);
}

test epoch_manager_enter {
    var manager = EpochManager_init(0).?;
    const epoch = EpochManager_enter(&manager);
    assert(epoch == 0);
    assert(manager.current_epoch == 0);
    assert(manager.counters[0] == 1);
    assert(manager.counters[1] == 0);
    assert(manager.counters[2] == 0);
}

test epoch_manager_exit_advance {
    var manager = EpochManager_init(0).?;
    // Enter twice to increment counter
    const _1 = EpochManager_enter(&manager);
    const _2 = EpochManager_enter(&manager);
    assert(manager.counters[0] == 2);
    assert(manager.current_epoch == 0);
    
    // Exit once - counter still > 0, no advance
    EpochManager_exit(&manager, 0);
    assert(manager.counters[0] == 1);
    assert(manager.current_epoch == 0);
    
    // Exit again - counter now 0, should advance to epoch 1
    EpochManager_exit(&manager, 0);
    assert(manager.counters[0] == 0);
    assert(manager.current_epoch == 1);
}

test epoch_manager_cross_epoch {
    var manager = EpochManager_init(0).?;
    
    // Fill up epoch 0
    const _1 = EpochManager_enter(&manager);
    const _2 = EpochManager_enter(&manager);
    const _3 = EpochManager_enter(&manager);
    assert(manager.counters[0] == 3);
    assert(manager.current_epoch == 0);
    
    // Exit all from epoch 0 - should advance to epoch 1
    EpochManager_exit(&manager, 0);
    EpochManager_exit(&manager, 0);
    EpochManager_exit(&manager, 0);
    assert(manager.counters[0] == 0);
    assert(manager.current_epoch == 1);
    
    // Now enter epoch 1
    const epoch1 = EpochManager_enter(&manager);
    assert(epoch1 == 1);
    assert(manager.counters[1] == 1);
    assert(manager.current_epoch == 1);
}