module port::trinity.src.tri.gen_regression;

pub struct RegressionSuite {
    bugs: [8][]const u8,
    len: usize,
    allocator: std.mem.Allocator,
}

pub fn RegressionSuite_init(allocator: std.mem.Allocator) RegressionSuite {
    return RegressionSuite{
        .bugs = undefined,
        .len = 0,
        .allocator = allocator,
    };
}

pub fn RegressionSuite_add(suite: *RegressionSuite, bug_id: []const u8) void {
    if (suite.len >= suite.bugs.len) {
        return;
    }
    suite.bugs[suite.len] = bug_id;
    suite.len += 1;
}

pub fn RegressionSuite_has(suite: *const RegressionSuite, bug_id: []const u8) bool {
    var i: usize = 0;
    while (i < suite.len) {
        if (std.mem.eql(u8, suite.bugs[i], bug_id)) {
            return true;
        }
        i += 1;
    }
    return false;
}

pub fn RegressionSuite_deinit(suite: *RegressionSuite) void {
    return;
}

test RegressionSuite_init_test {
    const allocator = std.testing.allocator;
    const suite = RegressionSuite_init(allocator);
    assert(suite.len == 0);
}

test RegressionSuite_add_and_has {
    const allocator = std.testing.allocator;
    var suite = RegressionSuite_init(allocator);
    RegressionSuite_add(&suite, "BUG-1");
    assert(suite.len == 1);
    assert(RegressionSuite_has(&suite, "BUG-1"));
    assert(!RegressionSuite_has(&suite, "BUG-2"));
}

test RegressionSuite_has_empty {
    const allocator = std.testing.allocator;
    var suite = RegressionSuite_init(allocator);
    assert(!RegressionSuite_has(&suite, "ANY"));
}

test RegressionSuite_deinit_test {
    const allocator = std.testing.allocator;
    var suite = RegressionSuite_init(allocator);
    RegressionSuite_add(&suite, "BUG-X");
    RegressionSuite_deinit(&suite);
    // After deinit, len unchanged (no-op)
    assert(suite.len == 1);
}

test RegressionSuite_capacity_limit {
    const allocator = std.testing.allocator;
    var suite = RegressionSuite_init(allocator);
    var i: usize = 0;
    while (i < 8) {
        RegressionSuite_add(&suite, "BUG");
        i += 1;
    }
    assert(suite.len == 8);
    RegressionSuite_add(&suite, "OVERFLOW");
    assert(suite.len == 8);
    assert(!RegressionSuite_has(&suite, "OVERFLOW"));
}