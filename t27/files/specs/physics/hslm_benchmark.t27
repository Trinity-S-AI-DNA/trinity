// SPDX-License-Identifier: Apache-2.0
; specs/physics/hslm_benchmark.t27 -- HSLM platform benchmark suite
; The configuration of the standalone benchmark written for the Evaluation section of the
; arXiv paper: single-thread and multi-thread inference, ternary matvec bandwidth, memory,
; and a platform comparison table. ASCII only (L3).

; Until this rewrite the file was a Markdown document with a .t27 name: no module, no
; declaration, and the parser refused it at its first line. Every number below is the
; number that document stated; nothing was added that it did not say.

; Honesty note carried over from the document: model.zig uses 3 TrinityBlocks and the FPGA
; build uses 4, and the paper table states which configuration each row measured.
; phi^2 + 1/phi^2 = 3 | TRINITY

module hslm_benchmark;

pub const VOCAB_SIZE : u32 = 8192;
pub const EMBED_DIM : u32 = 512;
pub const HIDDEN_DIM : u32 = 2048;
pub const NUM_BLOCKS : u32 = 3;
pub const FPGA_NUM_BLOCKS : u32 = 4;
pub const CONTEXT_LEN : u32 = 512;
pub const WARMUP_ITERS : u32 = 50;
pub const BENCH_ITERS : u32 = 1000;
pub const MATMUL_ITERS : u32 = 100000;
pub const MAX_THREADS : u32 = 8;

; The document also wrote `ESTIMATED_PARAMS ~ 1.58M ternary parameters`. That is kept as
; its words and NOT as a number, because the dimensions above do not give it: the embedding
; table alone is VOCAB_SIZE * EMBED_DIM = 4,194,304 weights. 1.58 is the bits one ternary
; weight carries (log2 3 = 1.585), which is the likelier source of the figure.
pub const ESTIMATED_PARAMS_AS_WRITTEN : str = "~1.58M ternary parameters";

; Part 3 measures one ternary matvec of EMBED_DIM x HIDDEN_DIM, scalar against SIMD.
pub const MATVEC_WEIGHTS : u32 = 1048576;

; Part 4 compares ternary storage with f32. Five trits pack into one byte (3^5 = 243 <= 256),
; which is 1.6 bits per weight against the 1.585 a trit carries.
pub const TRITS_PER_BYTE : u32 = 5;
pub const F32_BITS : u32 = 32;

; Part 5, the platform table. Only the FPGA row carries measured numbers in the document;
; the M1 Pro and Railway rows were placeholders (~X ms, ~Y tok/s) and are not restated.
pub const FPGA_PLATFORM : str = "FPGA Artix-7";
pub const FPGA_LATENCY_MS : f64 = 28.50;
pub const FPGA_THROUGHPUT_TOK_S : u32 = 35;
pub const FPGA_POWER_W : f64 = 0.5;

pub const SECTIONS : [5]str = ["single-thread forward pass", "multi-thread inference", "ternary matvec bandwidth", "memory usage", "platform comparison table"];

test "configuration_consistency" {
    assert(NUM_BLOCKS == 3);
    assert(EMBED_DIM == 512);
    assert(HIDDEN_DIM == 2048);
    assert(FPGA_NUM_BLOCKS == NUM_BLOCKS + 1);
}

test "matvec_is_embed_by_hidden" {
    assert(EMBED_DIM * HIDDEN_DIM == MATVEC_WEIGHTS);
}

test "warmup_precedes_a_longer_run" {
    assert(WARMUP_ITERS < BENCH_ITERS);
    assert(BENCH_ITERS < MATMUL_ITERS);
}

test "embedding_alone_exceeds_the_written_estimate" {
    assert(VOCAB_SIZE * EMBED_DIM == 4194304);
    assert(VOCAB_SIZE * EMBED_DIM > 1580000);
}

test "five_trits_fit_one_byte" {
    assert(3 * 3 * 3 * 3 * 3 == 243);
    assert(243 <= 256);
    assert(3 * 3 * 3 * 3 * 3 * 3 > 256);
}

test "packed_ternary_is_twenty_times_smaller_than_f32" {
    // 8 bits per TRITS_PER_BYTE weights against F32_BITS per weight: 32 * 5 / 8 = 20.
    assert(F32_BITS * TRITS_PER_BYTE / 8 == 20);
}

test "fpga_row_is_self_consistent" {
    // 35 tok/s at 28.5 ms per token: 1000 / 28.5 = 35.09.
    assert(FPGA_LATENCY_MS * 35.0 < 1000.0);
    assert(FPGA_LATENCY_MS * 36.0 > 1000.0);
    assert(FPGA_POWER_W < 1.0);
}
