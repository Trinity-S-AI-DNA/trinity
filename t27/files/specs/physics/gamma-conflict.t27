// SPDX-License-Identifier: Apache-2.0
; specs/physics/gamma-conflict.t27 -- Conjecture GI1: the Barbero-Immirzi parameter is phi^-3
; Status CONJECTURAL, tier CANDIDATE, owner physics/trinity, issue #303, v0.2 of 2026-04-08.
; ASCII only (L3).

; Until this rewrite the file was a Markdown document with a .t27 name, which the parser
; refused at its first line, so none of its numbers had ever been checked by anything. They
; were recomputed for the rewrite. The conjecture and the values that hold are kept below;
; six statements that do not hold are listed in CORRECTIONS, and a test pins each one, so
; the record cannot drift back to them without a red test.

; Conjecture GI1: gamma_true = phi^-3 = sqrt(5) - 2, against Meissner's (2004) numerical
; LQG value gamma_1 = 0.237532958 and Ghosh-Mitra's (2004) gamma_2 = 0.273985635.
; gamma_0 = ln 2 / (sqrt(3) pi) = 0.12738 is the entropy coefficient in S = gamma_0 A /
; (4 gamma), not the Immirzi parameter.
; phi^2 + 1/phi^2 = 3 | TRINITY

module gamma_conflict;

pub const STATUS : str = "CONJECTURAL";
pub const TIER : str = "CANDIDATE";
pub const ISSUE : u32 = 303;

; Mathematical constants the formulas use (double precision).
pub const PI : f64 = 3.141592653589793;
pub const SQRT3 : f64 = 1.7320508075688772;
pub const LN2 : f64 = 0.6931471805599453;
pub const LN3 : f64 = 1.0986122886681098;
pub const PHI : f64 = 1.618033988749895;

pub const GAMMA_PHI : f64 = 0.2360679774997897;
pub const GAMMA_1 : f64 = 0.237532958;
pub const GAMMA_2 : f64 = 0.273985635;

pub const CORRECTIONS : [6]str = ["gamma_1 was written `ln2/(pi sqrt3) ~ 0.237533`; that expression is 0.127384, the entropy coefficient gamma_0 the same document names. gamma_1 is Meissner's numerical root, with no closed form stated here, so the claim that it is transcendental is not supported either", "(gamma_2 - gamma_1) / gamma_1 was written 13.9%; it is 15.35% (13.30% if divided by gamma_2)", "the gap ratio (gamma_2 - gamma_1) / (gamma_1 - gamma_phi) was written 22.5 and `22x`; it is 24.88", "A_min was written 8 pi gamma l_P^2 but its values 2.5691 and 2.5850 are 2 pi sqrt(3) gamma l_P^2; 8 pi gamma gives 5.933 and 5.970", "G1: G/G_Pl = 1.0679 was called a 0.0679% deviation; it is 6.79% (and 1.0812 is 8.12%)", "SC3: 4 pi exp(-1/gamma_phi) was written 3.528, an `exact match` to BCS; it is 0.1818"];

; Kept as stated and NOT checked here: no data in this file supports or refutes them.
pub const UNCHECKED : [2]str = ["G1 with gamma_phi gives a 3.4x better fit to CODATA 2022 than gamma_1", "SC4 critical temperatures shift by 0.62%, within the experimental 1 K (1%) precision"];

pub const FALSIFICATION : [4]str = ["DL bounds violation: gamma_phi outside [ln2/pi, ln3/pi] -- not violated (tested below)", "LQG exclusion: rigorous state counting proves gamma != phi^-3 -- open", "high-precision discrimination: EHT or LIGO resolves gamma below 0.5% and excludes gamma_phi -- EHT is at about 1.5%, ngEHT 2027+ would need below 0.6%", "cascade contradiction: gamma-dependent formulas fit worse with gamma_phi than gamma_1 -- not established by this file"];

pub const PROOFS : [3]str = ["proofs/sacred/l5_identity.v", "proofs/sacred/gamma_phi3.v", "proofs/gravity/dl_bounds.v"];

test "gamma_phi_is_sqrt5_minus_2" {
    // phi^3 = 2 phi + 1, so gamma_phi * (2 phi + 1) = 1; and (gamma_phi + 2)^2 = 5.
    assert(GAMMA_PHI * (2.0 * PHI + 1.0) - 1.0 < 1e-12);
    assert(1.0 - GAMMA_PHI * (2.0 * PHI + 1.0) < 1e-12);
    assert((GAMMA_PHI + 2.0) * (GAMMA_PHI + 2.0) - 5.0 < 1e-12);
    assert(5.0 - (GAMMA_PHI + 2.0) * (GAMMA_PHI + 2.0) < 1e-12);
}

test "dl_bounds_containment" {
    assert(LN2 / PI > 0.2206);
    assert(LN3 / PI < 0.3497);
    assert(LN2 / PI < GAMMA_PHI);
    assert(GAMMA_PHI < LN3 / PI);
    assert(LN2 / PI < GAMMA_1);
    assert(GAMMA_1 < LN3 / PI);
}

test "gap_is_0_6167_percent" {
    const gap : f64 = (GAMMA_1 - GAMMA_PHI) / GAMMA_1;
    assert(gap > 0.006167);
    assert(gap < 0.006168);
}

test "correction_gamma_1_is_not_ln2_over_pi_sqrt3" {
    const g0 : f64 = LN2 / (PI * SQRT3);
    assert(g0 > 0.12738);
    assert(g0 < 0.12739);
    assert(GAMMA_1 - g0 > 0.11);
}

test "correction_internal_dispute_is_15_percent" {
    const d : f64 = (GAMMA_2 - GAMMA_1) / GAMMA_1;
    assert(d > 0.1534);
    assert(d < 0.1535);
    const ratio : f64 = (GAMMA_2 - GAMMA_1) / (GAMMA_1 - GAMMA_PHI);
    assert(ratio > 24.8);
    assert(ratio < 24.9);
}

test "correction_a_min_values_are_2_pi_sqrt3_gamma" {
    assert(2.0 * PI * SQRT3 * GAMMA_PHI > 2.5690);
    assert(2.0 * PI * SQRT3 * GAMMA_PHI < 2.5691);
    assert(2.0 * PI * SQRT3 * GAMMA_1 > 2.5850);
    assert(2.0 * PI * SQRT3 * GAMMA_1 < 2.5851);
    assert(8.0 * PI * GAMMA_PHI > 5.93);
}

test "correction_g1_deviation_is_6_79_percent" {
    // G/G_Pl = pi^3 gamma^2 / phi; with gamma_phi it is pi^3 phi^-7.
    const r_phi : f64 = PI * PI * PI * GAMMA_PHI * GAMMA_PHI / PHI;
    const r_1 : f64 = PI * PI * PI * GAMMA_1 * GAMMA_1 / PHI;
    assert(r_phi > 1.0679);
    assert(r_phi < 1.0680);
    assert(r_1 > 1.0812);
    assert(r_1 < 1.0813);
    assert(r_phi - 1.0 > 0.06);
}

test "bh1_entropy_shift" {
    const shift : f64 = 2.0 * (GAMMA_1 - GAMMA_PHI) / GAMMA_1;
    assert(shift > 0.01233);
    assert(shift < 0.01234);
}

test "bh2_hawking_correction" {
    const c_phi : f64 = PI * PI * GAMMA_PHI * GAMMA_PHI / 6.0;
    const c_1 : f64 = PI * PI * GAMMA_1 * GAMMA_1 / 6.0;
    assert(c_phi > 0.091669);
    assert(c_phi < 0.091670);
    assert(c_1 > 0.092810);
    assert(c_1 < 0.092811);
    assert(c_1 - c_phi > 0.001141);
    assert(c_1 - c_phi < 0.001142);
}

test "correction_sc3_is_not_the_bcs_ratio" {
    // e^x > 1 + x + x^2/2 + x^3/6 for x > 0, so exp(-x) is below the reciprocal of that
    // sum, and 4 pi exp(-1/gamma_phi) is below 4 pi over it -- with no exp available.
    const x : f64 = 1.0 / GAMMA_PHI;
    const lower : f64 = 1.0 + x + x * x / 2.0 + x * x * x / 6.0;
    assert(4.0 * PI / lower < 0.5);
    assert(4.0 * PI / lower < 3.528);
}
