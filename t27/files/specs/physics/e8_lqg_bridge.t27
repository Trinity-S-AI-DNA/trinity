// SPDX-License-Identifier: Apache-2.0
; specs/physics/e8_lqg_bridge.t27 -- E8 / quantum gravity bridge (cycle #133, v9.5)
; Bridges the E8 Lie group, VSA hypervectors and quantum gravity observables: E8 root to
; LQG spin encoding, a phi-based Barbero-Immirzi parameter, the cosmological constant, the
; holographic bound S = A/4 and a graviton mass, each through the formula
; V = n * 3^k * pi^m * phi^p * e^q. ASCII only (L3).

; Until this rewrite the file was a Markdown document with a .t27 name, which the parser
; refused at its first line. The constants are the ones that document listed. Two of its
; lines do not survive arithmetic and are kept as written, not as numbers -- see GAMMA_PHI
; and GRAVITON_MASS_PREDICTION below.
; phi^2 + 1/phi^2 = 3 | TRINITY

module e8_lqg_bridge;

pub const PHI : f64 = 1.618033988749895;
pub const PHI_INV : f64 = 0.618033988749895;
pub const PHI_SQ : f64 = 2.618033988749895;
pub const PHI_CUBED : f64 = 4.23606797749979;

; SI units: m, kg, s, K.
pub const PLANCK_LENGTH : f64 = 1.616255e-35;
pub const PLANCK_MASS : f64 = 2.176434e-8;
pub const PLANCK_TIME : f64 = 5.391247e-44;
pub const PLANCK_TEMP : f64 = 1.416784e32;

; m^-2 and GeV/m^3.
pub const LAMBDA_CDM : f64 = 1.1056e-52;
pub const RHO_LAMBDA : f64 = 5.96e-10;

pub const GAMMA_STANDARD : f64 = 0.2375;

; The document wrote `GAMMA_PHI = (phi - 1) / sqrt(2) ~ 0.261`. The two halves disagree:
; (phi - 1) / sqrt(2) = 0.618034 / 1.414214 = 0.437016, not 0.261. Both are kept, and the
; test below pins the formula's real value so the next reader does not have to redo it.
pub const GAMMA_PHI_AS_WRITTEN : str = "(phi - 1) / sqrt(2) ~ 0.261";
pub const GAMMA_PHI_FORMULA_VALUE : f64 = 0.4370160244488211;
pub const GAMMA_PHI_STATED_VALUE : f64 = 0.261;

; eV. The prediction is written as m_Pl * phi^-8 eV. With m_Pl expressed in eV (about
; 1.22e28) that is about 2.6e26 eV, some 48 orders of magnitude above the bound it is set
; against, so the line is kept as text until its units are stated.
pub const GRAVITON_MASS_BOUND : f64 = 1e-22;
pub const GRAVITON_MASS_PREDICTION_AS_WRITTEN : str = "m_Pl * phi^(-8) eV";

pub const HOLOGRAPHIC_CONSTANT : f64 = 0.25;
pub const HYPERVECTOR_DIM : u32 = 1024;

; E8 roots. Type 1: (+-1, +-1, 0, 0, 0, 0, 0, 0) over all placements -- C(8,2) = 28
; placements times 4 sign choices. Type 2: all coordinates +-1/2 with an even number of
; minus signs -- half of 2^8. Every root has norm squared 2.
pub const E8_TYPE1_ROOTS : u32 = 112;
pub const E8_TYPE2_ROOTS : u32 = 128;
pub const E8_ROOTS : u32 = 240;
pub const E8_DIM : u32 = 8;
pub const E8_ROOT_NORM_SQ : f64 = 2.0;

; Projection of the 8 E8 coordinates: 4 to the spin network (j1..j4), 2 to the
; Barbero-Immirzi parameter, 2 to the scaled cosmological constant.
pub const PROJ_SPIN_COORDS : u32 = 4;
pub const PROJ_GAMMA_COORDS : u32 = 2;
pub const PROJ_LAMBDA_COORDS : u32 = 2;

; Sacred-formula encodings {n, k, m, p, q} as the document tabulated them.
pub const ENC_GAMMA_BELOW_024 : [5]i32 = [1, -2, 0, -1, 1];
pub const ENC_GAMMA_BELOW_026 : [5]i32 = [1, -1, 0, -2, 0];
pub const ENC_GAMMA_AT_LEAST_026 : [5]i32 = [2, -2, 0, -2, -1];
pub const ENC_LAMBDA : [5]i32 = [1, -4, 0, -8, 2];
pub const ENC_GRAVITON_BELOW_1E24 : [5]i32 = [1, 0, 0, -10, -5];
pub const ENC_GRAVITON_AT_LEAST_1E24 : [5]i32 = [1, 0, 0, -8, 0];

test "phi_powers" {
    assert(PHI_SQ - (PHI + 1.0) < 1e-12);
    assert((PHI + 1.0) - PHI_SQ < 1e-12);
    assert(PHI_CUBED - (2.0 * PHI + 1.0) < 1e-12);
    assert((2.0 * PHI + 1.0) - PHI_CUBED < 1e-12);
    assert(PHI_INV - (PHI - 1.0) < 1e-12);
    assert((PHI - 1.0) - PHI_INV < 1e-12);
}

test "trinity_identity" {
    // phi^2 + phi^-2 = 3, with phi^-2 = PHI_INV * PHI_INV.
    assert(PHI_SQ + PHI_INV * PHI_INV - 3.0 < 1e-12);
    assert(3.0 - (PHI_SQ + PHI_INV * PHI_INV) < 1e-12);
}

test "e8_root_count" {
    assert(28 * 4 == E8_TYPE1_ROOTS);
    assert(256 / 2 == E8_TYPE2_ROOTS);
    assert(E8_TYPE1_ROOTS + E8_TYPE2_ROOTS == E8_ROOTS);
}

test "e8_root_norms" {
    // type 1: 1 + 1; type 2: 8 * (1/2)^2.
    assert(1.0 + 1.0 == E8_ROOT_NORM_SQ);
    assert(8.0 * 0.25 == E8_ROOT_NORM_SQ);
}

test "projection_uses_every_coordinate_once" {
    assert(PROJ_SPIN_COORDS + PROJ_GAMMA_COORDS + PROJ_LAMBDA_COORDS == E8_DIM);
}

test "gamma_phi_formula_is_not_the_stated_value" {
    // value^2 * 2 must equal (phi - 1)^2 if value = (phi - 1) / sqrt(2).
    const v : f64 = GAMMA_PHI_FORMULA_VALUE;
    assert(v * v * 2.0 - PHI_INV * PHI_INV < 1e-12);
    assert(PHI_INV * PHI_INV - v * v * 2.0 < 1e-12);
    assert(GAMMA_PHI_FORMULA_VALUE - GAMMA_PHI_STATED_VALUE > 0.17);
}

test "gamma_bands_are_ordered" {
    assert(GAMMA_STANDARD < 0.24);
    assert(GAMMA_STANDARD > 0.0);
    assert(GAMMA_STANDARD < 1.0);
}

test "holographic_bound_is_a_quarter" {
    assert(HOLOGRAPHIC_CONSTANT * 4.0 == 1.0);
}
