// SPDX-License-Identifier: Apache-2.0
; specs/trinity/capabilities/fpga.adapter.t27 -- capability trinity/fpga.adapter: the FPGA
; adapter contract of S11 (gHashTag/t27#3573, dmitrii-f-t27/trinity-memory#66): a bitstream's
; path from build record to device receipt, the dry-run/flash boundary and the eight error
; statuses. The canonical spec is specs/fpga/adapter.t27; the enforcing tool is
; tools/trinity_fpga_adapter.py (check / self-check) over conformance/trinity/fpga_adapter.json,
; whose device receipts are the stage-2 runs of dmitrii-f-t27/trinity-memory (golden chunk
; dense5 and baseline2, 320/320 bit-exact on the AX7203, and the #65 measurements).
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_capability_fpga_adapter;

pub const KIND : str = "capability";
pub const ID : str = "trinity/fpga.adapter";
pub const TITLE : str = "The FPGA adapter contract: bitstream path, dry-run/flash boundary, device receipt";
pub const OWNER_REPO : str = "dmitrii-f-t27/trinity-memory";
pub const DISPOSITION : str = "adapter";
pub const PROFILE : str = "fpga";
pub const CANONICAL_SPEC : str = "specs/fpga/adapter.t27";
pub const DIALECT : str = "t27";
pub const IMPLEMENTATION : [2]str = ["tools/trinity_fpga_adapter.py", "conformance/trinity/fpga_adapter.json"];
pub const GENERATED : [0]str = [];
pub const BACKEND : str = "python";
pub const TARGETS : [0]str = [];
pub const ACCEPTANCE : str = "python3 tools/trinity_fpga_adapter.py check && python3 tools/trinity_fpga_adapter.py self-check";
pub const EVIDENCE : str = "measured";
pub const EVIDENCE_SOURCE : str = "Device receipts of dmitrii-f-t27/trinity-memory on the ALINX AX7203 (XC7A200T, IDCODE 0x13636093): the golden chunk 320/320 bit-exact in dense5 and baseline2 and the #65 weights-per-second runs (12/12 each), embedded in conformance/trinity/fpga_adapter.json with bitstream sha256, provenance and transcript hashes.";
pub const WORK_PACKAGE : str = "S11";
pub const NOTE : str = "NOTE, ENABLED and the test block were added by S10 (gHashTag/t27#4829): tools/trinity_manifest.py check refused this card for lacking them, and no workflow runs that check.";
pub const ENABLED : bool = true;

test card_is_bound_to_its_package {
    assert KIND == "capability";
    assert ID == "trinity/fpga.adapter";
    assert WORK_PACKAGE == "S11";
    assert ENABLED == true;
}
