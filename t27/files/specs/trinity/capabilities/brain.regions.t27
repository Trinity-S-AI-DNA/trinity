// SPDX-License-Identifier: Apache-2.0
; specs/trinity/capabilities/brain.regions.t27 -- capability trinity/brain.regions: The brain region tests of src/brain
; One card of the Trinity project manifest (specs/trinity/README.md, gHashTag/t27#3563 = S01 of
; gHashTag/trinity#988). tools/trinity_manifest.py check holds every card to the inventory of the
; pinned consumer tree gHashTag/trinity@976df5174: the targets it owns exist in build.zig and belong
; to no other card, the paths it names are tracked, the dialect matches the spec it cites and a
; measured claim names its command and its source. The consumer vendors a byte-identical copy and
; generates its manifest from these files (S12). ASCII only (L3), English only (LANG-EN).
; This card is the exception to the first of those: its eleven targets exist in build.zig from
; gHashTag/trinity#1333 on and not at the pin, so a check against the pinned inventory reports each
; of them as UNKNOWN_TARGET until S01 re-pins (gHashTag/t27#5953). Its paths do exist at the pin.
; phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_capability_brain_regions;

pub const KIND : str = "capability";
pub const ID : str = "trinity/brain.regions";
pub const TITLE : str = "The brain region tests of src/brain: the basal ganglia, reticular formation and locus coeruleus units, the aggregate and integration suite, and the stress suite";
; Who owns the implementation this card describes.
pub const OWNER_REPO : str = "gHashTag/trinity";
; executable | declared | adapter | external | deprecated | out-of-scope | research | catalog-only
pub const DISPOSITION : str = "executable";
; headless | web | native | fpga | training | network | research; a target installed by
; zig build -Dci=true is headless, a target guarded by !ci_mode is not.
pub const PROFILE : str = "headless";
; The canonical spec: a path in this repository, trinity:<path> for a spec authored in the
; consumer, <repo>:<path> elsewhere, "" while none exists. Never a mirrored copy.
pub const CANONICAL_SPEC : str = "";
pub const DIALECT : str = "none";
; Implementation and generated paths of the pinned tree (trinity: prefix), checked to exist.
pub const IMPLEMENTATION : [6]str = ["trinity:src/brain/basal_ganglia.zig", "trinity:src/brain/reticular_formation.zig", "trinity:src/brain/locus_coeruleus.zig", "trinity:src/brain/brain.zig", "trinity:src/brain/integration_test.zig", "trinity:src/brain/stress_test.zig"];
pub const GENERATED : [0]str = [];
; zig | c | rust | verilog | wasm | ts | swift | python | none; only executable, adapter and research cards claim one.
pub const BACKEND : str = "zig";
; build.zig targets this card owns: exe:<name>, lib:<name>, test:<root path>, step:<name>; patterns allowed.
pub const TARGETS : [11]str = ["step:test-basal-ganglia", "step:test-reticular-formation", "step:test-locus-coeruleus", "step:test-brain", "step:test-brain-stress", "test:src/brain/basal_ganglia.zig", "test:src/brain/reticular_formation.zig", "test:src/brain/locus_coeruleus.zig", "test:src/brain/brain.zig", "test:src/brain/integration_test.zig", "test:src/brain/stress_test.zig"];
; The command whose success is the acceptance of this capability; "" when nothing is claimed.
pub const ACCEPTANCE : str = "zig build test-basal-ganglia -Dci=true && zig build test-reticular-formation -Dci=true && zig build test-locus-coeruleus -Dci=true && zig build test-brain -Dci=true && zig build test-brain-stress -Dci=true";
; measured | declared | specified | external | not-claimed, as docs/system/project.md defines them.
pub const EVIDENCE : str = "measured";
pub const EVIDENCE_SOURCE : str = "https://github.com/gHashTag/trinity/actions/runs/37184075728 (push) and https://github.com/gHashTag/trinity/actions/runs/37184077352 (pull_request) -- brain-ci.yml on ubuntu-latest with zig 0.15.2 at gHashTag/trinity@291ac8b24 (the head of gHashTag/trinity#1333), each step run as zig build <step> -Dci=true --summary all with its exit code as the gate, the same counts in both runs: test-basal-ganglia 51/51, test-reticular-formation 48/48, test-locus-coeruleus 52/52, test-brain 151/151 (138 from brain.zig and 13 from integration_test.zig), test-brain-stress 261/261 with 0 leaked. That commit is not the pinned 976df517, whose build.zig defines none of these targets.";
; The work package of gHashTag/trinity#988 that owns this capability's contract.
pub const WORK_PACKAGE : str = "S03";
pub const NOTE : str = "S03 decides retire or attach for the sources research.unreferenced-sources names; gHashTag/trinity#1333 attached these six test roots, and this card takes src/brain off that list (gHashTag/t27#5953). At the pin build.zig names basal_ganglia.zig, locus_coeruleus.zig and reticular_formation.zig only as imported modules of another root, and defines no brain test or step. src/brain is handwritten Zig: specs/brain/brain.t27 lists its files in a comment table, but nothing generates them from it or checks them against it, so no canonical spec is claimed. Measured are these test steps, not a run of the brain inside a service.";
pub const ENABLED : bool = true;

test card_is_bound_to_its_package {
    assert KIND == "capability";
    assert ID == "trinity/brain.regions";
    assert WORK_PACKAGE == "S03";
    assert ENABLED == true;
}
