test {
    const suite_results = run_test_suite();

    // Check that all tests pass
    const failed_count = result_list_count_verdict(suite_results, Verdict::FAIL);
    // assert!(failed_count == 0, "Test suite had {} failures", failed_count):
    // t27 assert takes no message; a failure report shows failed_count.
    assert(failed_count == 0);

    // Generate TAP output (suite_results.clone(): structs are passed by value)
    const tap_reporter = tap_reporter_new(suite_results);
    const tap_output = tap_reporter_generate_tap(tap_reporter);
    // println!("TAP Output:\n{}", tap_output)
    print("TAP Output:");
    print(tap_output.bytes[0..tap_output.len]);

    // Generate JSON output
    const json_reporter = json_reporter_new(suite_results);
    const json_output = json_reporter_generate_json(json_reporter);
    // println!("JSON Output:\n{}", json_output)
    print("JSON Output:");
    print(json_output.bytes[0..json_output.len]);
}
