// SPDX-License-Identifier: Apache-2.0
// t27 Math/Physics Test Framework - Core
//
// Ring 050: Test framework core per T27-MATH-PHYSICS-TEST-FRAMEWORK-SPEC.md
// Provides fundamental testing constructs for scientific computing

module core;

// Translation notes. This spec was first written in Rust syntax; t27 has no
// generics, closures, function-typed parameters, `any`, Option<T>, heap
// Vec/String, impl blocks, match or format!. Each construct is expressed with
// t27 features instead:
//   string, format!        -> Text: fixed-size byte buffer + length, filled by
//                             the text_append_* helpers; Report is the larger
//                             buffer the TAP / JSON generators write into
//   Vec<TestResult>        -> ResultList: fixed-capacity array + length
//   Option<T>              -> a `has_<field>: bool` flag beside the value
//   any, generic T and R   -> f64 (every producer in this file passes a number)
//   fn(T) -> R parameters  -> the caller applies the functions and passes the
//                             evaluated samples (for_all, metamorphic,
//                             differential)
//   impl X { fn m(self) }  -> free fn x_m(x: X)
//   invariant f(x) -> bool -> predicate fn f(x), plus an invariant block that
//                             checks it on concrete inputs

// § Core testing enums and structures

/// Test verdict/tier classification
enum Verdict {
    CLEAN,
    FAIL,
    PARTIAL,
    SKIP
}

/// Test tolerance tier (numeric/physics precision levels)
enum ToleranceTier {
    EXACT,              // Mathematical identity (e.g., φ² = φ + 1)
    WITHIN_UNCERTAINTY,  // Within experimental uncertainty (CODATA)
    EMPIRICAL_FIT,      // Empirical formula, good accuracy
    APPROXIMATION,      // Approximation > experimental uncertainty
    FALSIFIED_AS_EXACT, // Cannot claim as exact vs experiment
    CONJECTURAL,        // Hypothesis, insufficient verification
    UNTTESTED           // Not yet checked quantitatively
}

/// Engineering status for toolchain tests
enum EngineeringStatus {
    proved,     // Theorem or machine-checked proof in-repo
    tested,     // Automated test / conformance fails if violated
    empirical,  // Observed in practice; not formal proof
    conjectural, // Open or partial
    deprecated  // Superseded; history only
}

// Text buffers (stand-in for Rust's String and format!)

const TEXT_CAP: u32 = 128;      // test names and messages
// TAP / JSON reports. Worst case is a TAP report of MAX_RESULTS failing
// results with full-length name and message: 6 + 64 * 284 = 18182 bytes.
const REPORT_CAP: u32 = 32768;

struct Text {
    bytes: [TEXT_CAP]u8,
    len: u32
}

struct Report {
    bytes: [REPORT_CAP]u8,
    len: u32
}

fn text_empty() -> Text {
    return Text{ bytes = [0; TEXT_CAP], len = 0 };
}

// Bytes past TEXT_CAP are dropped (a String would grow instead).
fn text_append_byte(t: *Text, b: u8) {
    if (t.len < TEXT_CAP) {
        t.bytes[t.len] = b;
        t.len = t.len + 1;
    }
}

fn text_append_str(t: *Text, s: str) {
    var i: u32 = 0;
    while (i < s.len) {
        text_append_byte(t, s[i]);
        i = i + 1;
    }
}

fn text_append_text(t: *Text, s: Text) {
    var i: u32 = 0;
    while (i < s.len) {
        text_append_byte(t, s.bytes[i]);
        i = i + 1;
    }
}

fn text_from(s: str) -> Text {
    var t = text_empty();
    text_append_str(&t, s);
    return t;
}

// Decimal digits of v, the `{}` of a u32.
fn u32_to_text(v: u32) -> Text {
    var t = text_empty();
    if (v == 0) {
        text_append_byte(&t, 48);
        return t;
    }
    var digits: [10]u8 = [0; 10];
    var count: u32 = 0;
    var n = v;
    while (n > 0) {
        digits[count] = 48 + (n % 10) as u8;
        count = count + 1;
        n = n / 10;
    }
    while (count > 0) {
        count = count - 1;
        text_append_byte(&t, digits[count]);
    }
    return t;
}

fn text_append_u32(t: *Text, v: u32) {
    text_append_text(t, u32_to_text(v));
}

const F64_MAX: f64 = 1.7976931348623157e308;

fn f64_abs(x: f64) -> f64 {
    if (x < 0.0) {
        return 0.0 - x;
    }
    return x;
}

fn f32_abs(x: f32) -> f32 {
    if (x < 0.0) {
        return 0.0 - x;
    }
    return x;
}

fn f64_max(a: f64, b: f64) -> f64 {
    if (a > b) {
        return a;
    }
    return b;
}

fn f64_is_infinite(x: f64) -> bool {
    return x > F64_MAX or x < 0.0 - F64_MAX;
}

// f64::INFINITY: the largest finite f64 doubled overflows to +inf (IEEE 754).
fn f64_infinity() -> f64 {
    return F64_MAX * 2.0;
}

// Approximation of Rust's `{}` / `{:?}` for f64. Rust prints the shortest
// decimal that round-trips; this writes the integer part (clamped to the u32
// range), then up to six fraction digits with trailing zeros removed, and
// "inf", "-inf" or "NaN" for the special values.
fn f64_to_text(v: f64) -> Text {
    var t = text_empty();
    if (v != v) {
        text_append_str(&t, "NaN");
        return t;
    }
    if (f64_is_infinite(v)) {
        if (v < 0.0) {
            text_append_str(&t, "-inf");
        } else {
            text_append_str(&t, "inf");
        }
        return t;
    }
    var x = v;
    if (x < 0.0) {
        text_append_byte(&t, 45);
        x = 0.0 - x;
    }
    var whole: u32 = 4294967295;
    var scaled: u32 = 0;
    if (x < 4294967295.0) {
        whole = x as u32;
        scaled = ((x - (whole as f64)) * 1000000.0 + 0.5) as u32;
    }
    if (scaled >= 1000000 and whole < 4294967295) {
        whole = whole + 1;
        scaled = 0;
    }
    text_append_u32(&t, whole);
    if (scaled > 0) {
        var frac: [6]u8 = [48; 6];
        var pos: u32 = 6;
        var n = scaled;
        while (pos > 0) {
            pos = pos - 1;
            frac[pos] = 48 + (n % 10) as u8;
            n = n / 10;
        }
        var last: u32 = 6;
        while (last > 1 and frac[last - 1] == 48) {
            last = last - 1;
        }
        text_append_byte(&t, 46);
        var i: u32 = 0;
        while (i < last) {
            text_append_byte(&t, frac[i]);
            i = i + 1;
        }
    }
    return t;
}

fn report_empty() -> Report {
    return Report{ bytes = [0; REPORT_CAP], len = 0 };
}

// Bytes past REPORT_CAP are dropped (a String would grow instead).
fn report_append_byte(r: *Report, b: u8) {
    if (r.len < REPORT_CAP) {
        r.bytes[r.len] = b;
        r.len = r.len + 1;
    }
}

fn report_append_str(r: *Report, s: str) {
    var i: u32 = 0;
    while (i < s.len) {
        report_append_byte(r, s[i]);
        i = i + 1;
    }
}

fn report_append_text(r: *Report, s: Text) {
    var i: u32 = 0;
    while (i < s.len) {
        report_append_byte(r, s.bytes[i]);
        i = i + 1;
    }
}

fn report_append_u32(r: *Report, v: u32) {
    report_append_text(r, u32_to_text(v));
}

/// Test result container
struct TestResult {
    name: Text,
    verdict: Verdict,
    tolerance: ToleranceTier,
    engineering: EngineeringStatus,
    has_claim_id: bool,     // Option<string>: Some(claim_id) when true
    claim_id: str,          // Link to RESEARCH_CLAIMS.md
    input: f64,             // any -> f64
    expected: f64,          // any -> f64
    actual: f64,            // any -> f64
    has_delta: bool,        // Option<f64>: Some(delta) when true
    delta: f64,
    has_message: bool,      // Option<string>: Some(message) when true
    message: Text
}

fn test_result_empty() -> TestResult {
    return TestResult{
        name = text_empty(),
        verdict = Verdict::SKIP,
        tolerance = ToleranceTier::EXACT,
        engineering = EngineeringStatus::tested,
        has_claim_id = false,
        claim_id = "",
        input = 0.0,
        expected = 0.0,
        actual = 0.0,
        has_delta = false,
        delta = 0.0,
        has_message = false,
        message = text_empty()
    };
}

// Vec<TestResult> with a fixed capacity.
const MAX_RESULTS: u32 = 64;

struct ResultList {
    items: [MAX_RESULTS]TestResult,
    len: u32
}

fn result_list_empty() -> ResultList {
    return ResultList{ items = [test_result_empty(); MAX_RESULTS], len = 0 };
}

// Vec::push; results past MAX_RESULTS are dropped (a Vec would grow).
fn result_list_push(list: *ResultList, r: TestResult) {
    if (list.len < MAX_RESULTS) {
        list.items[list.len] = r;
        list.len = list.len + 1;
    }
}

// Vec::extend
fn result_list_extend(list: *ResultList, other: ResultList) {
    var i: u32 = 0;
    while (i < other.len) {
        result_list_push(list, other.items[i]);
        i = i + 1;
    }
}

// results.iter().filter(|r| r.verdict == verdict).count()
fn result_list_count_verdict(list: ResultList, verdict: Verdict) -> u32 {
    var count: u32 = 0;
    var i: u32 = 0;
    while (i < list.len) {
        if (list.items[i].verdict == verdict) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

/// Sequential gate pipeline with short-circuit
/// Pattern: parse → type_check → semantic → numeric_stability → physics_constraint → audit
struct GatePipeline {
    parse_ok: bool,
    type_check_ok: bool,
    semantic_ok: bool,
    numeric_stability_ok: bool,
    physics_constraint_ok: bool,
    audit_ok: bool
}

// impl GatePipeline: t27 has no impl blocks, so the methods are free
// functions that take the pipeline as their first parameter.

// Sequential evaluation - if gate N fails, gates N+1... are not evaluated
fn gate_pipeline_run_sequential(gate: GatePipeline) -> bool {
    return gate.parse_ok and
        (if (gate.parse_ok) gate.type_check_ok else false) and
        (if (gate.parse_ok and gate.type_check_ok) gate.semantic_ok else false) and
        (if (gate.parse_ok and gate.type_check_ok and gate.semantic_ok) gate.numeric_stability_ok else false) and
        (if (gate.parse_ok and gate.type_check_ok and gate.semantic_ok and gate.numeric_stability_ok) gate.physics_constraint_ok else false) and
        (if (gate.parse_ok and gate.type_check_ok and gate.semantic_ok and gate.numeric_stability_ok and gate.physics_constraint_ok) gate.audit_ok else false);
}

fn gate_pipeline_verdict(gate: GatePipeline) -> Verdict {
    return if (gate_pipeline_run_sequential(gate)) Verdict::CLEAN else Verdict::FAIL;
}

// § Core testing utilities

// Most samples one for_all / metamorphic / differential call can take.
const MAX_CASES: u32 = 64;

// for_all<T>(domain: fn() -> T, property: fn(T) -> bool, iterations) takes
// functions, which t27 cannot pass. The caller runs them and hands over the
// evaluated samples: inputs[i] = domain() for iteration i, and
// holds[i] = property(inputs[i]). T is f64.
struct PropertySamples {
    inputs: [MAX_CASES]f64,
    holds: [MAX_CASES]bool
}

/// Property-based testing: for all x in domain, property holds
// At most MAX_CASES iterations are evaluated (the original loop is unbounded).
fn for_all(samples: PropertySamples, iterations: u32) -> TestResult {
    var failures: u32 = 0;
    var has_last_failure = false;   // last_failure = None
    var last_failure: f64 = 0.0;

    var i: u32 = 0;
    while (i < iterations and i < MAX_CASES) {
        const input = samples.inputs[i];
        if (!samples.holds[i]) {
            failures = failures + 1;
            has_last_failure = true;    // last_failure = Some(input)
            last_failure = input;
        }
        i = i + 1;
    }

    const verdict = if (failures == 0) Verdict::CLEAN else Verdict::FAIL;
    // format!("{} failures in {} iterations (last failure: {:?})", failures, iterations, last_failure)
    var message = text_empty();
    if (failures > 0) {
        text_append_u32(&message, failures);
        text_append_str(&message, " failures in ");
        text_append_u32(&message, iterations);
        text_append_str(&message, " iterations");
        // Only MAX_CASES iterations are evaluated; say so when capped.
        if (iterations > MAX_CASES) {
            text_append_str(&message, " (capped at ");
            text_append_u32(&message, MAX_CASES);
            text_append_str(&message, ")");
        }
        text_append_str(&message, " (last failure: ");
        if (has_last_failure) {
            text_append_str(&message, "Some(");
            text_append_text(&message, f64_to_text(last_failure));
            text_append_str(&message, ")");
        } else {
            text_append_str(&message, "None");
        }
        text_append_str(&message, ")");
    }

    // format!("for_all_{} iterations", iterations)
    var name = text_from("for_all_");
    text_append_u32(&name, iterations);
    text_append_str(&name, " iterations");
    if (iterations > MAX_CASES) {
        text_append_str(&name, " (capped at ");
        text_append_u32(&name, MAX_CASES);
        text_append_str(&name, ")");
    }

    return TestResult{
        name = name,
        verdict = verdict,
        tolerance = ToleranceTier::EXACT,
        engineering = EngineeringStatus::tested,
        has_claim_id = false,
        claim_id = "",
        input = iterations as f64,
        expected = 0.0,
        actual = failures as f64,
        has_delta = false,
        delta = 0.0,
        has_message = failures > 0,
        message = message
    };
}

// metamorphic<T, R>(input: fn(T) -> R, transform: fn(T) -> T,
// relation: fn(R, R) -> bool, test_cases: Vec<T>) takes functions. The caller
// evaluates each case: y1 = input(x), x_transformed = transform(x),
// y2 = input(x_transformed), relation_holds = relation(y1, y2). T and R are f64.
struct MetamorphicCase {
    x: f64,
    y1: f64,
    x_transformed: f64,
    y2: f64,
    relation_holds: bool
}

struct MetamorphicCases {
    items: [MAX_CASES]MetamorphicCase,
    len: u32
}

/// Metamorphic testing: if input(x) produces y, then input(f(x)) should produce g(y)
fn metamorphic(test_cases: MetamorphicCases) -> ResultList {
    var results = result_list_empty();
    var c: u32 = 0;
    while (c < test_cases.len and c < MAX_CASES) {
        const x = test_cases.items[c].x;
        const y1 = test_cases.items[c].y1;
        const y2 = test_cases.items[c].y2;

        const relation_holds = test_cases.items[c].relation_holds;
        const verdict = if (relation_holds) Verdict::CLEAN else Verdict::FAIL;

        // format!("metamorphic_{:?}", x)
        var name = text_from("metamorphic_");
        text_append_text(&name, f64_to_text(x));

        var message = text_empty();
        if (!relation_holds) {
            message = text_from("Metamorphic relation violated");
        }

        result_list_push(&results, TestResult{
            name = name,
            verdict = verdict,
            tolerance = ToleranceTier::EXACT,
            engineering = EngineeringStatus::tested,
            has_claim_id = false,
            claim_id = "",
            input = x,
            expected = y1,
            actual = y2,
            has_delta = false,
            delta = 0.0,
            has_message = !relation_holds,
            message = message
        });
        c = c + 1;
    }
    return results;
}

// differential<T>(impl1: fn(T) -> T, impl2: fn(T) -> T, tolerance,
// test_cases: Vec<T>) takes functions. The caller evaluates
// result1 = impl1(x) and result2 = impl2(x) for each case. T is f64.
struct DifferentialCase {
    x: f64,
    result1: f64,
    result2: f64
}

struct DifferentialCases {
    items: [MAX_CASES]DifferentialCase,
    len: u32
}

/// Differential testing: compare two implementations for equality within tolerance
fn differential(tolerance: f64, test_cases: DifferentialCases) -> ResultList {
    var results = result_list_empty();
    var c: u32 = 0;
    while (c < test_cases.len and c < MAX_CASES) {
        const x = test_cases.items[c].x;
        const result1 = test_cases.items[c].result1;
        const result2 = test_cases.items[c].result2;

        // For numeric types, check relative difference
        // (the original `match (result1, result2)` on f64::INF patterns:
        // both infinite -> 0.0, exactly one infinite -> INFINITY,
        // otherwise |a - b| / max(|a|, |b|, 1e-15))
        var delta: f64 = 0.0;
        if (f64_is_infinite(result1) and f64_is_infinite(result2)) {
            delta = 0.0;
        } else if (f64_is_infinite(result1)) {
            delta = f64_infinity();
        } else if (f64_is_infinite(result2)) {
            delta = f64_infinity();
        } else {
            delta = f64_abs(result1 - result2) / f64_max(f64_max(f64_abs(result1), f64_abs(result2)), 1e-15);
        }

        const verdict = if (delta <= tolerance) Verdict::CLEAN else Verdict::FAIL;
        const tol_tier = if (tolerance == 0.0) ToleranceTier::EXACT else ToleranceTier::WITHIN_UNCERTAINTY;

        // format!("differential_{:?}", x)
        var name = text_from("differential_");
        text_append_text(&name, f64_to_text(x));

        // format!("Delta {} exceeds tolerance {}", delta, tolerance)
        var message = text_empty();
        if (delta > tolerance) {
            text_append_str(&message, "Delta ");
            text_append_text(&message, f64_to_text(delta));
            text_append_str(&message, " exceeds tolerance ");
            text_append_text(&message, f64_to_text(tolerance));
        }

        result_list_push(&results, TestResult{
            name = name,
            verdict = verdict,
            tolerance = tol_tier,
            engineering = EngineeringStatus::empirical,
            has_claim_id = false,
            claim_id = "",
            input = x,
            expected = result1,
            actual = result2,
            has_delta = true,
            delta = delta,
            has_message = delta > tolerance,
            message = message
        });
        c = c + 1;
    }
    return results;
}

// § Test runners and reporting

/// TAP (Test Anything Protocol) output generator
struct TapReporter {
    results: ResultList
}

// impl TapReporter: methods as free functions (no impl blocks in t27).
fn tap_reporter_new(results: ResultList) -> TapReporter {
    return TapReporter{ results = results };
}

fn tap_reporter_generate_tap(reporter: TapReporter) -> Report {
    const total = reporter.results.len;
    // format!("1..{}\n", total)
    var output = report_empty();
    report_append_str(&output, "1..");
    report_append_u32(&output, total);
    report_append_str(&output, "\n");

    var i: u32 = 0;
    while (i < total) {
        const result = reporter.results.items[i];
        const status = switch (result.verdict) {
            .CLEAN => "ok",
            .PARTIAL => "ok # TODO",
            .SKIP => "ok # SKIP",
            .FAIL => "not ok",
        };

        // format!("{} {} - {}\n", status, i + 1, result.name)
        report_append_str(&output, status);
        report_append_str(&output, " ");
        report_append_u32(&output, i + 1);
        report_append_str(&output, " - ");
        report_append_text(&output, result.name);
        report_append_str(&output, "\n");

        if (result.verdict == Verdict::FAIL) {
            if (result.has_message) {
                // format!("  ---\n  {}\n  ...\n", msg)
                report_append_str(&output, "  ---\n  ");
                report_append_text(&output, result.message);
                report_append_str(&output, "\n  ...\n");
            }
        }
        i = i + 1;
    }

    return output;
}

/// JSON test report generator
struct JsonReporter {
    results: ResultList
}

// impl JsonReporter: methods as free functions (no impl blocks in t27).
fn json_reporter_new(results: ResultList) -> JsonReporter {
    return JsonReporter{ results = results };
}

fn json_reporter_generate_json(reporter: JsonReporter) -> Report {
    // Simplified JSON generation
    const total = reporter.results.len;
    const passed = result_list_count_verdict(reporter.results, Verdict::CLEAN);
    const failed = result_list_count_verdict(reporter.results, Verdict::FAIL);
    const skipped = result_list_count_verdict(reporter.results, Verdict::SKIP);

    // The raw-string template of the original:
    // {
    //   "total": N,
    //   "passed": N,
    //   "failed": N,
    //   "skipped": N,
    //   "results": []
    // }
    var output = report_empty();
    report_append_str(&output, "{\n  \"total\": ");
    report_append_u32(&output, total);
    report_append_str(&output, ",\n  \"passed\": ");
    report_append_u32(&output, passed);
    report_append_str(&output, ",\n  \"failed\": ");
    report_append_u32(&output, failed);
    report_append_str(&output, ",\n  \"skipped\": ");
    report_append_u32(&output, skipped);
    report_append_str(&output, ",\n  \"results\": []\n}");
    return output;
}

// § Test invariants and properties
// t27 invariants take no parameters. Each quantified invariant is kept as a
// predicate fn of the same name (run_test_suite calls phi_squared_identity),
// and an invariant block checks it on concrete inputs.

/// Sequential gate invariant - enforces strict ordering
fn gate_pipeline_sequential(gate: GatePipeline) -> bool {
    return gate_pipeline_run_sequential(gate) == (gate.parse_ok and gate.type_check_ok and gate.semantic_ok and
                              gate.numeric_stability_ok and gate.physics_constraint_ok and gate.audit_ok);
}

// The gate domain is finite: check every one of the 2^6 gate combinations.
invariant gate_pipeline_sequential_all_gates {
    var mask: u32 = 0;
    while (mask < 64) {
        const gate = GatePipeline{
            parse_ok = (mask & 1) != 0,
            type_check_ok = (mask & 2) != 0,
            semantic_ok = (mask & 4) != 0,
            numeric_stability_ok = (mask & 8) != 0,
            physics_constraint_ok = (mask & 16) != 0,
            audit_ok = (mask & 32) != 0
        };
        assert(gate_pipeline_sequential(gate));
        mask = mask + 1;
    }
}

/// GoldenFloat identity property: for any GF number, round-trip conversion preserves value
fn gf16_roundtrip_preservation(value: f64) -> bool {
    // This would call actual GF16 encode/decode functions
    // For now, this is a placeholder showing the invariant structure
    const encoded = gf16_encode_f32(value as f32);
    const decoded = gf16_decode_to_f32(encoded);
    return f32_abs(decoded - (value as f32)) < 1e-6;
}

// The GF16 codec below is still a placeholder (encode -> 0, decode -> 0.0),
// so 0.0 is the only input its round trip can be checked on today.
invariant gf16_roundtrip_preservation_at_zero {
    assert(gf16_roundtrip_preservation(0.0));
}

/// Phi algebraic identity: φ² = φ + 1 (exact mathematical identity)
fn phi_squared_identity(phi: f64) -> bool {
    return f64_abs(phi * phi - phi - 1.0) < 1e-15;  // Exact within floating point precision
}

invariant phi_squared_identity_at_golden_ratio {
    assert(phi_squared_identity(1.618033988749895));
}

// § Test entry point
fn run_test_suite() -> ResultList {
    var results = result_list_empty();

    // Example: Test GF4 exhaustive properties
    // This would generate all 16 GF4 values and test commutativity, associativity, etc.
    const gf4_exhaustive_results = test_gf4_exhaustive();
    result_list_extend(&results, gf4_exhaustive_results);

    // Example: Test phi identities
    const phi: f64 = 1.618033988749895;  // Golden ratio
    result_list_push(&results, TestResult{
        name = text_from("phi_squared_identity"),
        verdict = if (phi_squared_identity(phi)) Verdict::CLEAN else Verdict::FAIL,
        tolerance = ToleranceTier::EXACT,
        engineering = EngineeringStatus::proved,
        has_claim_id = true,
        claim_id = "C-phi-001",
        input = phi,
        expected = phi + 1.0,
        actual = phi * phi,
        has_delta = true,
        delta = f64_abs(phi * phi - phi - 1.0),
        has_message = false,
        message = text_empty()
    });

    return results;
}

