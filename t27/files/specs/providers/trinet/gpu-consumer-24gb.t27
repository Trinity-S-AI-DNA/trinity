// SPDX-License-Identifier: Apache-2.0
; specs/providers/trinet/gpu-consumer-24gb.t27 -- provider card: a 24 GB consumer GPU rented out to TRI-NET for $TRI
; Source of truth for the provider card on t27.ai (#/providers?provider=trinet/gpu-consumer-24gb).
; A design, not a measurement: no GPU worker exists. The card says what such a host would sell, why Gonka
; no longer takes it, how TRI-NET could check its work, and every piece that is missing.
; Schema and rules: specs/providers/catalog.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module provider_trinet_gpu_consumer_24gb;

pub const KIND : str = "provider";
pub const ID : str = "trinet/gpu-consumer-24gb";
pub const FAMILY : str = "host-class";
pub const NETWORK : str = "trinet";
pub const NAME : str = "Consumer GPU host (24 GB)";
pub const SUMMARY_EN : str = "A gaming GPU its owner would rent out to TRI-NET for $TRI. Gonka no longer admits a card like this: a Gonka ML node now needs about 320 GB of GPU memory, fourteen of these cards. TRI-NET could take one card at a time, with jobs that fit it and are checked by recomputation. Nothing is built yet.";
; planned: no code and no record
pub const STATUS : str = "planned";
pub const WITNESS : str = "design-only";
pub const CHECKED : str = "2026-10-03";
pub const SOURCES : [4]str = ["https://node3.gonka.ai/chain-api/productscience/inference/inference/models_all", "https://github.com/gonka-ai/gonka-docs (commits 3480cc7382 and ff70a0f856)", "gHashTag/trinity-fpga@c31157ae0dca4e1448f4c80b1c1884d298c40696:specs/trinet/settlement_law.t27", "gHashTag/igla-coder-gpu:LEDGER.md"];
pub const NOTE : str = "Market rent for this class, from our own bills: RTX 4090 at 0.34 USD (community) to 0.74 USD (secure) per GPU-hour on RunPod (igla-coder-gpu LEDGER.md). A $TRI reward only competes with that once $TRI has a market price, which it does not have.";
pub const ENABLED : bool = true;
pub const DEVICE : str = "NVIDIA RTX 3090 / RTX 4090 class, 24 GB";
pub const MEMORY_GB : u32 = 24;
; ceil(320 / 24): the smallest Gonka PoC model needs 280 GB, the most served one 320 GB
pub const UNITS_PER_GONKA_NODE : u32 = 14;
pub const PROOF : str = "design: deterministic integer or ternary kernels whose answer is identical on any card, checked by recomputing a sample on a second host and credited only on equality, the FPGA rule carried over; a floating-point job would need Gonka-style statistical acceptance with its own threshold per device class";
pub const REWARD : str = "design: the FPGA law, mTRI per accepted job minted on acceptance, scaled by a per-class weight factor (Gonka's weight_scale_factor per model) so that one device class cannot drown another";
pub const STAKE : str = "design: the FPGA law, 1000 mTRI minimum stake and 200 mTRI slashed per bad receipt (settlement_law.t27); not in force for GPUs";
pub const GONKA_PARALLEL : str = "Gonka admitted consumer cards from 2025-11-05 (gonka-docs 3480cc7382, 40 GB minimum across the cards of one node) and stopped on 2026-06-05 (gonka-docs ff70a0f856); the models it serves on 2026-10-03 need 280 to 560 GB per host. The class Gonka left behind is the class TRI-NET would serve";
pub const MEASURED : [0]str = [];
pub const GAPS : [5]str = ["no GPU worker exists in any repository", "no GPU job format: the 24-byte ternary job is sized for the FPGA cell", "no sampling verifier for a second host", "nobody buys this compute yet (settlement_law.t27 EFFICIENCY_IS_NOT_DEMAND, resolved false)", "$TRI is on no mainnet: the site's jetton is on TON testnet"];
pub const TOKEN : str = "$TRI: cap 3^21 = 10460353203, all of it mined on accepted work, no pre-mine and no sale (settlement_law.t27); issued on TON and Solana by owner decision 2026-09-24; today only a TON testnet jetton exists (gHashTag/trinity apps/website/src/lib/triToken.ts, TRI_NETWORK testnet)";

invariant a_gonka_node_needs_fourteen_cards { assert UNITS_PER_GONKA_NODE * MEMORY_GB >= 320; }
invariant thirteen_cards_are_not_enough { assert UNITS_PER_GONKA_NODE * MEMORY_GB - MEMORY_GB < 320; }
