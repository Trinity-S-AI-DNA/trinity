// SPDX-License-Identifier: Apache-2.0
; specs/providers/trinet/fpga-xc7a200t.t27 -- provider card: an Artix-7 FPGA rented out to TRI-NET for $TRI
; Source of truth for the provider card on t27.ai (#/providers?provider=trinet/fpga-xc7a200t).
; What a person who owns this board would sell, how the network would check it, and what it would pay. The
; measurements are TRI-NET's own, on three boards, and each one names the file that records it; the gaps are
; written as plainly as the measurements. Schema and rules: specs/providers/catalog.t27.
; phi^2 + 1/phi^2 = 3 | TRINITY

module provider_trinet_fpga_xc7a200t;

pub const KIND : str = "provider";
pub const ID : str = "trinet/fpga-xc7a200t";
pub const FAMILY : str = "host-class";
pub const NETWORK : str = "trinet";
pub const NAME : str = "Artix-7 XC7A200T FPGA host";
pub const SUMMARY_EN : str = "An FPGA board its owner rents out to TRI-NET for $TRI. The board computes balanced-ternary dot products bit-exactly, so a job is checked by recomputing it and comparing for equality, not by a statistical test. Measured on three boards; nobody buys this compute yet.";
; measured: a bench record a reader can rerun exists
pub const STATUS : str = "measured";
pub const WITNESS : str = "bench-measured";
pub const CHECKED : str = "2026-10-03";
pub const SOURCES : [4]str = ["gHashTag/trinity-fpga@167d2c77f5acefb8a215e21fdecdae10d5d4af9f:specs/trinet/ternary_hw_verification.t27", "gHashTag/trinity-fpga@c31157ae0dca4e1448f4c80b1c1884d298c40696:specs/trinet/settlement_law.t27", "gHashTag/trinity-fpga@ff2962d710f1b1b5e032fd7af875b20af2a8fd9a:docs/TRI_NET_HANDOFF.md", "gHashTag/t27:fpga/HARDWARE_SSOT.md"];
pub const NOTE : str = "Gonka has no FPGA path at all: its hosts run vLLM on GPUs and its proof races transformer forward passes. An FPGA earns on TRI-NET only through jobs written for the FPGA cell, which today means the 32-wide ternary dot product.";
pub const ENABLED : bool = true;
pub const DEVICE : str = "Xilinx Artix-7 XC7A200T. TRI-NET ran on three Alinx AX7203 boards (IDCODE 0x13636093); the t27 bench is three QMTech Wukong V1 boards (IDCODE 0x03636093), the same die";
; 0: on-board memory is not what bounds a ternary dot-product job
pub const MEMORY_GB : u32 = 0;
; 0: an FPGA cannot host a Gonka model at any count
pub const UNITS_PER_GONKA_NODE : u32 = 0;
pub const PROOF : str = "bit-exact recompute: a job is 24 bytes, the answer 19 bytes carrying the node id and a tag; the verifier recomputes the 32-wide balanced-ternary dot product and credits only an identical answer (settlement_law.t27, AUDIT_RATE_PERCENT 100: every job is checked while the network is small)";
pub const REWARD : str = "1 mTRI per accepted job (REWARD_PER_JOB_MTRI 1, 1000 mTRI = 1 TRI), minted when the verifier accepts the job; nothing is minted for a job nobody checked";
pub const STAKE : str = "1000 mTRI minimum stake (MIN_STAKE_MTRI), 200 mTRI slashed per bad receipt (SLASH_PER_BAD_RECEIPT_MTRI); a damaged receipt is neither credited nor slashed";
pub const GONKA_PARALLEL : str = "Gonka's Proof of Compute v2 races seeded transformer forward passes and accepts a host within a distance threshold by a binomial test; 20% of a host's weight needs no collateral and 20% of collateral is slashed for invalid work. Here the job is integer, so acceptance is equality and needs no threshold; stake and slash play the part of collateral";
pub const MEASURED : [3]str = ["TRINET MAC32, a 32-wide balanced-ternary dot product computed as popcount(agreements) - popcount(disagreements), bit-exact on the board: 512/512 (ternary_hw_verification.t27)", "6400/6400 jobs on each of three nodes at their own baud window centres, zero failures (ternary_hw_verification.t27)", "over the UART transport no node can exceed about 4770 jobs/s, against a compute ceiling about 480 times higher (TRI_NET_HANDOFF.md)"];
pub const GAPS : [4]str = ["the node keys are not on any host: no receipt from the three boards can be verified until they are re-keyed (ternary_hw_verification.t27 KEYS_NOT_ON_THIS_HOST)", "nobody buys ternary compute: settlement_law.t27 EFFICIENCY_IS_NOT_DEMAND is resolved false and WHO_BUYS_TERNARY_COMPUTE is open", "$TRI is on no mainnet: the site's jetton is on TON testnet", "the UART, not the cell, bounds throughput; a faster transport is not built"];
pub const TOKEN : str = "$TRI: cap 3^21 = 10460353203, all of it mined on accepted work, no pre-mine and no sale (settlement_law.t27); issued on TON and Solana by owner decision 2026-09-24; today only a TON testnet jetton exists (gHashTag/trinity apps/website/src/lib/triToken.ts, TRI_NETWORK testnet)";

invariant an_fpga_cannot_host_a_gonka_model { assert UNITS_PER_GONKA_NODE == 0; }
