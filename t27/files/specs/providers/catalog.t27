// SPDX-License-Identifier: Apache-2.0
; specs/providers/catalog.t27 -- the providers catalog contract: what a provider card states and what it may claim
; Layer 7 of the spec ladder (Specs -> Skills -> Crons -> Agents -> Tools -> Functions -> Providers). A provider
; is anything that sells or rents compute: a model a network serves (FAMILY "model", one card per model the
; Gonka chain lists) or a class of hardware a person can rent out to our own network for $TRI (FAMILY
; "host-class": a consumer GPU, an Artix-7 FPGA). One card per provider under specs/providers/<network>/<slug>.t27;
; this file states the schema, the vocabularies, and the rules a card is held to. The site generator
; (gHashTag/trinity apps/website/scripts/agents-from-specs.mjs) checks every card against the field lists
; below; the browser re-reads the Gonka chain and prints any distance between a card and the chain.
; Not to be confused with specs/provider/ (singular): those are the LLM adapter message types.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ProvidersCatalog;

pub const KIND : str = "providers-catalog";
pub const ID : str = "providers/catalog";
pub const NAME : str = "The providers catalog of specs/providers: models a network sells, hardware a person rents out";
pub const SCHEMA_VERSION : u32 = 1;
pub const CHECKED : str = "2026-10-03";

; --- Families, networks, directories ---------------------------------------------------------------
pub const FAMILIES : [2]str = ["model", "host-class"];
pub const NETWORKS : [2]str = ["gonka", "trinet"];
pub const DIRECTORIES : [2]str = ["gonka/<slug>.t27 (FAMILY model: one card per model in the chain's models_all)", "trinet/<slug>.t27 (FAMILY host-class: one card per device class our network would pay $TRI for)"];
pub const ID_RULE : str = "ID is the path under specs/providers without .t27, for example gonka/minimax-m2-7; the module is provider_<ID with every non-alphanumeric run replaced by _>";

; --- Fields --------------------------------------------------------------------------------------------
pub const COMMON_FIELDS : [12]str = ["KIND", "ID", "FAMILY", "NETWORK", "NAME", "SUMMARY_EN", "STATUS", "WITNESS", "CHECKED", "SOURCES", "NOTE", "ENABLED"];
pub const MODEL_FIELDS : [16]str = ["MODEL_ID", "HF_COMMIT", "CONTEXT_TOKENS", "VRAM_GB", "THROUGHPUT_PER_NONCE", "VALIDATION_PERMILLE", "POC_MODEL", "POC_WEIGHT_SCALE_E4", "HOSTS", "EPOCH", "UNITS_OF_COMPUTE_PER_TOKEN", "PRICE_PER_TOKEN", "PRICE_UNIT", "API", "CALL", "VLLM_ARGS"];
pub const HOST_FIELDS : [10]str = ["DEVICE", "MEMORY_GB", "UNITS_PER_GONKA_NODE", "PROOF", "REWARD", "STAKE", "GONKA_PARALLEL", "MEASURED", "GAPS", "TOKEN"];
pub const FIELD_SOURCE_RULE : str = "a model card copies the chain: MODEL_ID, HF_COMMIT, VRAM_GB (v_ram), THROUGHPUT_PER_NONCE, VALIDATION_PERMILLE (validation_threshold x 1000) and UNITS_OF_COMPUTE_PER_TOKEN from models_all; CONTEXT_TOKENS from the --max-model-len in its model_args; POC_MODEL and POC_WEIGHT_SCALE_E4 (weight_scale_factor x 10000) from params.poc_params.models; HOSTS from the count of active participants of EPOCH whose models list names MODEL_ID; PRICE_PER_TOKEN from /v1/governance/pricing";

; --- Vocabularies --------------------------------------------------------------------------------------
pub const STATUSES : [4]str = ["serving", "listed", "measured", "planned"];
pub const STATUS_RULE : str = "serving: on chain and at least one host of EPOCH serves it; listed: on chain, no host serves it; measured: our hardware, with a bench record a reader can rerun; planned: no code and no record, a design only";
pub const WITNESSES : [3]str = ["chain-read", "bench-measured", "design-only"];
pub const WITNESS_RULE : str = "chain-read: copied from a public chain endpoint on CHECKED; bench-measured: a record of runs on our boards, named in SOURCES; design-only: nothing has run. A design never claims a measurement";
pub const CALLS : [2]str = ["needs-key", "none"];
pub const CALL_RULE : str = "needs-key: the endpoint exists and answers OpenAI-compatible requests, but every request is paid and signed, so the site never calls it and never takes a key; none: there is no endpoint to call";

; --- Codes for the rules below ----------------------------------------------------------------------
pub const STATUS_SERVING : u32 = 0;
pub const STATUS_LISTED : u32 = 1;
pub const STATUS_MEASURED : u32 = 2;
pub const STATUS_PLANNED : u32 = 3;

; --- Rules -------------------------------------------------------------------------------------------

pub fn model_status(hosts: u32) -> u32 {
    if (hosts > 0) { return STATUS_SERVING; }
    return STATUS_LISTED;
}

pub fn host_status(has_bench_record: bool) -> u32 {
    if (has_bench_record) { return STATUS_MEASURED; }
    return STATUS_PLANNED;
}

; A model the chain removed from poc_params.models can still be listed in models_all; no host may serve it.
pub fn hosts_allowed(poc_model: bool, hosts: u32) -> bool {
    return poc_model or hosts == 0;
}

; The site calls a paid endpoint only with a key, and the site never holds one.
pub fn site_may_call(call_needs_key: bool, site_holds_key: bool) -> bool {
    if (call_needs_key) { return site_holds_key; }
    return false;
}

pub fn witness_claims_measurement(witness: u32) -> bool {
    return witness == 1;
}

pub fn per_mille(value: u32, scale: u32) -> u32 {
    return (value * 1000) / scale;
}

invariant four_statuses { assert STATUS_PLANNED == 3; }
invariant one_schema { assert SCHEMA_VERSION == 1; }

test a_model_is_serving_only_when_a_host_serves_it {
    assert model_status(26) == STATUS_SERVING;
    assert model_status(1) == STATUS_SERVING;
    assert model_status(0) == STATUS_LISTED;
}

test a_host_class_is_measured_only_with_a_record {
    assert host_status(true) == STATUS_MEASURED;
    assert host_status(false) == STATUS_PLANNED;
}

test a_retired_model_has_no_hosts {
    assert hosts_allowed(true, 26) == true;
    assert hosts_allowed(false, 0) == true;
    assert hosts_allowed(false, 3) == false;
}

test the_site_never_calls_a_paid_endpoint {
    assert site_may_call(true, false) == false;
    assert site_may_call(false, false) == false;
    assert site_may_call(false, true) == false;
}

test only_a_bench_record_claims_a_measurement {
    assert witness_claims_measurement(0) == false;
    assert witness_claims_measurement(1) == true;
    assert witness_claims_measurement(2) == false;
}

test the_threshold_is_stored_in_per_mille {
    assert per_mille(922, 1000) == 922;
    assert per_mille(951, 1000) == 951;
    assert FAMILIES[0] == "model";
    assert FAMILIES[1] == "host-class";
    assert STATUSES[0] == "serving";
    assert CALLS[0] == "needs-key";
}
