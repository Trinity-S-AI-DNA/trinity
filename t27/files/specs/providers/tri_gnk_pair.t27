; specs/providers/tri_gnk_pair.t27 -- the study behind specs/providers: how Gonka pays its hosts, the routes a
; $TRI/GNK pair could take, and where a network of ordinary GPUs and FPGAs paid in $TRI would differ.
; Every Gonka number is read from a public chain endpoint (https://node3.gonka.ai/chain-api) or from the chain's
; source (gonka-ai/gonka@83d9c206faa921649e3d8c440266186fcc306726) on CHECKED; the tests below check the
; arithmetic this file states, not the chain. It is not a provider card: the site generator reads cards only from
; specs/providers/gonka and specs/providers/trinet.
; Which chain a pair lives on is the owner's decision. This file lays out the routes and decides nothing.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ProvidersTriGnkPair;

pub const KIND : str = "providers-study";
pub const ID : str = "providers/tri_gnk_pair";
pub const CHECKED : str = "2026-10-03";

; --- The Gonka chain on CHECKED -------------------------------------------------------------------------
pub const CHAIN_HEIGHT : u64 = 6375920;
pub const EPOCH : u32 = 413;
pub const ACTIVE_HOSTS : u32 = 30;
pub const EPOCH_LENGTH_BLOCKS : u32 = 15391;
; block 6360529 at 2026-10-02T18:00:42Z, block 6375920 at 2026-10-03T16:52:07Z
pub const EPOCH_SECONDS_MEASURED : u32 = 82285;
; 1 GNK = 10^GNK_DECIMALS ngonka, the chain's base denomination
pub const GNK_DECIMALS : u8 = 9;
pub const INITIAL_EPOCH_REWARD_NGONKA : u64 = 323000000000000;
; tokenomics_data on CHECKED
pub const TOTAL_FEES_NGONKA : u64 = 1174606773777;
pub const TOTAL_SUBSIDIES_NGONKA : u64 = 120892672230996302;
pub const TOTAL_BURNED_NGONKA : u64 = 1284341372978310;
pub const SUPPLY_NGONKA : u64 = 446378386939836973;
pub const VESTING_EPOCHS : u32 = 180;
; collateral_params: the share of weight a host earns with no collateral, and the slashes
pub const BASE_WEIGHT_PERMILLE : u32 = 200;
pub const SLASH_INVALID_PERMILLE : u32 = 200;
pub const SLASH_DOWNTIME_PERMILLE : u32 = 100;
; participant_allowlist_until_block_height: the allowlist is active only below this height
; (inference-chain/x/inference/keeper/participant_allowlist.go)
pub const ALLOWLIST_UNTIL_HEIGHT : u64 = 2475000;
; v_ram of the models the chain pays PoC weight for on CHECKED
pub const SMALLEST_POC_MODEL_GB : u32 = 280;
pub const MOST_SERVED_MODEL_GB : u32 = 320;
pub const LARGEST_POC_MODEL_GB : u32 = 560;
; gonka-docs 3480cc7382 (2025-11-05): the minimum across the cards of one node while consumer cards were admitted
pub const CONSUMER_ERA_MIN_GB : u32 = 40;
pub const CONSUMER_CARD_GB : u32 = 24;
pub const DATACENTER_CARD_GB : u32 = 80;

; --- Where GNK can be traded on CHECKED ----------------------------------------------------------------
pub const WGNK_ETHEREUM : str = "0x972a7a92d92796a98801a8818bcf91f1648f2f68";
pub const WGNK_DECIMALS : u8 = 9;
pub const WGNK_USDT_UNISWAP_V3_POOL : str = "0x203EE836d417CF944133bbdd2c62B4BC7388C55D";
; /productscience/inference/inference/bridge_addresses/ethereum names WGNK_ETHEREUM; no other chain id has one
pub const BRIDGE_CHAINS : [1]str = ["ethereum"];
; /productscience/inference/inference/liquidity_pool answers "liquidity pool not found"
pub const GONKA_POOL_REGISTERED : bool = false;
; /productscience/inference/inference/approved_tokens_for_trade
pub const GONKA_APPROVED_FOR_TRADE : [3]str = ["ethereum USDC 0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48", "ethereum USDT 0xdac17f958d2ee523a2206206994597c13d831ec7", "kava_2222-10 USDT over IBC transfer/channel-5 (ibc/115F68FBA220A028C6F6ED08EA0C1A9C8C52798B14FB66E6C89D5D8C06A524D4)"];
pub const IBC_CHANNELS : [4]str = ["channel-1 Osmosis (no GNK on Osmosis on CHECKED)", "channel-3 Neutron", "channel-5 Kava", "channel-0 and channel-2 Axelar"];

; --- $TRI on CHECKED -----------------------------------------------------------------------------------
; owner decision 2026-09-24
pub const TRI_CHAINS : [2]str = ["ton", "solana"];
; the site's jetton (gHashTag/trinity apps/website/src/lib/triToken.ts) is on TON testnet
pub const TRI_MAINNET : bool = false;
pub const TRI_CAP : u64 = 10460353203;

; --- Routes to a $TRI/GNK pair -------------------------------------------------------------------------
pub const ROUTE_ETHEREUM_UNISWAP : u32 = 0;
pub const ROUTE_GONKA_POOL : u32 = 1;
pub const ROUTE_OSMOSIS_IBC : u32 = 2;
pub const ROUTE_TON_SOLANA : u32 = 3;
pub const ROUTES : [4]str = ["ethereum-uniswap: issue $TRI as an ERC-20 on Ethereum and open a TRI/WGNK pool on Uniswap v3 beside the WGNK/USDT pool; needs nobody's permission, and puts $TRI on a chain the owner did not choose", "gonka-pool: bring $TRI to the Gonka chain (an Ethereum ERC-20 through the Gonka bridge, or an IBC denom) and win a Gonka governance vote approving it for trade (MsgApproveBridgeTokenForTrading or MsgApproveIbcTokenForTrading); the chain's singleton pool is not registered yet and the approved list holds only USDC and USDT", "osmosis-ibc: send GNK to Osmosis over IBC channel-1 and pair it there with $TRI as an Osmosis tokenfactory denom; needs nobody's permission, puts $TRI on a third chain, and Osmosis holds no GNK today", "ton-or-solana: pair on the chains $TRI was decided for, on a TON or Solana exchange; needs GNK carried to TON or Solana, and the Gonka bridge serves only Ethereum"];
pub const CONFLICT : str = "the owner decided $TRI lives on TON and Solana; GNK lives on the Gonka chain and, wrapped, on Ethereum. No chain holds both, so every route either puts $TRI on a chain not chosen for it or needs a bridge nobody has built. Before any route, $TRI needs a mainnet issue: a testnet jetton cannot be paired";

; --- Where a network of ordinary cards differs ---------------------------------------------------------
pub const PARALLELS : [7]str = ["who pays: Gonka pays its hosts almost entirely by issuance, its subsidies were about 100000 times its fees on CHECKED; TRI-NET mints on accepted jobs, so both pay for work before anyone buys it, and both wait on demand (settlement_law.t27 WHO_BUYS_TERNARY_COMPUTE)", "proof: Gonka's Proof of Compute v2 is statistical, seeded forward passes accepted within a distance threshold by a binomial test; TRI-NET's is exact, a bit-identical recompute, which is cheaper to check and works only for integer jobs", "entry: a Gonka host needs 280 to 560 GB of GPU memory on CHECKED, so one 24 GB card is out; TRI-NET would take one card or one FPGA board", "weight: Gonka scales the PoC weight of each model (weight_scale_factor) so that one model cannot crowd out another; TRI-NET would need the same per device class", "collateral: Gonka gives 20% of a host's weight without collateral and slashes 20% for invalid work and 10% for downtime; TRI-NET asks a 1000 mTRI stake and slashes 200 mTRI per bad receipt", "vesting: Gonka vests rewards over 180 epochs, about 171 days at the measured epoch; TRI-NET has no vesting", "admission: Gonka's allowlist ended at height 2475000 and anyone may register a host; TRI-NET has three boards and no public registration"];

; --- Rules ---------------------------------------------------------------------------------------------

pub fn allowlist_active(height: u64, until: u64) -> bool {
    return height < until;
}

pub fn cards_needed(model_gb: u32, card_gb: u32) -> u32 {
    return (model_gb + card_gb - 1) / card_gb;
}

; whole GNK, rounded down: 10^GNK_DECIMALS ngonka to the GNK
pub fn ngonka_to_gnk(ngonka: u64) -> u64 {
    return ngonka / 1000000000;
}

pub fn subsidy_per_fee(subsidies: u64, fees: u64) -> u64 {
    return subsidies / fees;
}

pub fn vesting_days(epochs: u32, epoch_seconds: u32) -> u32 {
    return (epochs * epoch_seconds) / 86400;
}

pub fn route_on_chosen_chain(route: u32) -> bool {
    return route == ROUTE_TON_SOLANA;
}

pub fn route_has_bridge_today(route: u32) -> bool {
    return route != ROUTE_TON_SOLANA;
}

pub fn route_needs_gonka_vote(route: u32) -> bool {
    return route == ROUTE_GONKA_POOL;
}

pub fn pair_possible(tri_mainnet: bool, route: u32) -> bool {
    if (tri_mainnet == false) { return false; }
    return route_has_bridge_today(route);
}

test registration_is_open {
    assert allowlist_active(CHAIN_HEIGHT, ALLOWLIST_UNTIL_HEIGHT) == false;
    assert allowlist_active(2474999, ALLOWLIST_UNTIL_HEIGHT) == true;
}

test one_consumer_card_cannot_host_a_gonka_model {
    assert cards_needed(MOST_SERVED_MODEL_GB, CONSUMER_CARD_GB) == 14;
    assert cards_needed(SMALLEST_POC_MODEL_GB, CONSUMER_CARD_GB) == 12;
    assert cards_needed(LARGEST_POC_MODEL_GB, CONSUMER_CARD_GB) == 24;
    assert cards_needed(MOST_SERVED_MODEL_GB, DATACENTER_CARD_GB) == 4;
    assert cards_needed(CONSUMER_ERA_MIN_GB, CONSUMER_CARD_GB) == 2;
}

test gonka_amounts_in_gnk {
    assert ngonka_to_gnk(INITIAL_EPOCH_REWARD_NGONKA) == 323000;
    assert ngonka_to_gnk(SUPPLY_NGONKA) == 446378386;
    assert ngonka_to_gnk(TOTAL_SUBSIDIES_NGONKA) == 120892672;
    assert ngonka_to_gnk(TOTAL_FEES_NGONKA) == 1174;
    assert ngonka_to_gnk(TOTAL_BURNED_NGONKA) == 1284341;
}

test issuance_not_customers_pays_the_hosts {
    assert subsidy_per_fee(TOTAL_SUBSIDIES_NGONKA, TOTAL_FEES_NGONKA) == 102921;
    assert subsidy_per_fee(TOTAL_SUBSIDIES_NGONKA, TOTAL_FEES_NGONKA) > 100000;
}

test an_epoch_is_about_a_day {
    assert EPOCH_SECONDS_MEASURED / 3600 == 22;
    assert vesting_days(VESTING_EPOCHS, EPOCH_SECONDS_MEASURED) == 171;
}

test no_route_is_both_chosen_and_bridged {
    assert route_on_chosen_chain(ROUTE_ETHEREUM_UNISWAP) == false;
    assert route_on_chosen_chain(ROUTE_GONKA_POOL) == false;
    assert route_on_chosen_chain(ROUTE_OSMOSIS_IBC) == false;
    assert route_on_chosen_chain(ROUTE_TON_SOLANA) == true;
    assert route_has_bridge_today(ROUTE_TON_SOLANA) == false;
    assert route_needs_gonka_vote(ROUTE_GONKA_POOL) == true;
    assert route_needs_gonka_vote(ROUTE_ETHEREUM_UNISWAP) == false;
}

test no_pair_before_a_mainnet_issue {
    assert pair_possible(TRI_MAINNET, ROUTE_ETHEREUM_UNISWAP) == false;
    assert pair_possible(TRI_MAINNET, ROUTE_OSMOSIS_IBC) == false;
    assert pair_possible(true, ROUTE_ETHEREUM_UNISWAP) == true;
    assert pair_possible(true, ROUTE_TON_SOLANA) == false;
}

test the_pool_and_the_bridge_on_checked {
    assert GONKA_POOL_REGISTERED == false;
    assert BRIDGE_CHAINS[0] == "ethereum";
    assert TRI_CHAINS[0] == "ton";
    assert TRI_CHAINS[1] == "solana";
    assert WGNK_DECIMALS == 9;
    assert WGNK_DECIMALS == GNK_DECIMALS;
    assert TRI_CAP == 10460353203;
}
