// ============================================================================
// 6. TDD — Tests
// ============================================================================

test "lang_to_code_ru" {
    assert @langToCode("ru") == "ru";
    assert @langToCode("en") == "en";
}

test "lang_to_code_invalid" {
    assert @langToCode("fr") == "";
    assert @langToCode("english") == "";
}

test "lang_from_code_ru" {
    assert @langFromCode("ru") == Ru;
    assert @langFromCode("en") == En;
}

test "bilingual_filename" {
    let file = @concat(".trinity/audio/nb123/", @langFilename(Ru));
    assert @contains(file, "/ru.wav");
    assert !@contains(file, "/en.wav");
}

// ============================================================================
// 7. TDD — Invariants
// ============================================================================

invariant "lang_code_valid" {
    // forall lang : str where @langToCode(lang) != "",
    //     @langFromCode(@langToCode(lang)) == lang
    // Approximation: t27 has no quantifier over str, so the implication is
    // checked over the finite set of codes this spec's tests name.
    const candidates : [4]str = ["ru", "en", "fr", "english"];
    for i in 0..4 {
        const lang = candidates[i];
        if (@langToCode(lang) != "") {
            assert @langFromCode(@langToCode(lang)) == lang;
        }
    }
}

invariant "audio_files_have_duration" {
    // forall file : AudioFile where @len(file.content) > 0,
    //     file.duration_secs > 0
    // Approximation: t27 has no quantifier over a struct type, so the
    // implication is checked on a sample record. AudioFile declares no
    // content field, so the content length is carried beside the record.
    const file = AudioFile{ .notebook_id = "nb123", .lang = Lang.En, .path = AUDIO_DIR, .duration_secs = 1 };
    const content_len : usize = 1;
    if (content_len > 0) {
        assert file.duration_secs > 0;
    }
}

// ============================================================================
// 8. TDD — Benchmarks
// ============================================================================

bench "http_request_latency" {
    // Measure: milliseconds for HTTP POST to create audio overview
    // Target: < 5000ms
    // Original clauses: measure: milliseconds to call
    //   create_audio_overview("nb123", { language_code: "en" }); target: < 5000ms
    // The anonymous { language_code: "en" } is spelled as a full
    // AudioOverviewRequest (other fields empty, source_ids = None).
    const config = AudioOverviewRequest{ .notebook_id = "nb123", .language_code = Lang.En, .episode_focus = "", .source_ids = null };
    const status = create_audio_overview("nb123", config);
    _ = status;
}
