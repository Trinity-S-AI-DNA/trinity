// SPDX-License-Identifier: Apache-2.0
// t27/examples/fpga/qmtech_minimal/design.t27
// Minimal FPGA example: an 8-LED heartbeat that walks one lit LED back and
// forth, plus a UART loopback that repeats a fixed message.
//
// This file used to be a block of `#`-commented key/value pairs that only
// looked like t27; no parser accepted it, so nothing in it was ever checked.
// It now carries the parts of that design a compiler can hold to account --
// the LED pattern, the timing counts and the resource budget -- and nothing
// else. Package pins and the board part are NOT restated here: they live in
// specs/boards/xc7a100t_minimal.t27, and the board actually on the bench is
// fixed by fpga/HARDWARE_SSOT.md. A second pin table in an example is a
// second home for a fact that already has one.
// phi^2 + 1/phi^2 = 3 | TRINITY

module QmtechMinimalDesign {
    // Board clock the counts below are written against.
    const CLOCK_HZ : u32 = 12_000_000;

    // Heartbeat: one pattern step per HEARTBEAT_PERIOD clock cycles.
    const HEARTBEAT_PERIOD : u32 = 1_000_000;
    const NUM_LEDS : u8 = 8;
    // 0x01 up to 0x80 and back down to 0x02: 8 + 6 steps, then it repeats.
    const PATTERN_STEPS : u8 = 14;

    // UART loopback: "HELLO\n" every UART_REPEAT clock cycles at UART_BAUD.
    const UART_BAUD : u32 = 115_200;
    const UART_MESSAGE_BYTES : u32 = 6;
    const UART_REPEAT : u32 = 5_000_000;

    // Resource budget the design must fit in.
    const MAX_LUTS : u32 = 100;
    const MAX_FFS : u32 = 50;
    const MAX_BRAM : u32 = 0;
    const MAX_DSP : u32 = 0;

    // LED byte shown at pattern step `step` (taken modulo PATTERN_STEPS).
    pub fn heartbeat_led(step : u8) -> u8 {
        let s : u8 = step % PATTERN_STEPS;
        if s < NUM_LEDS {
            return 1u8 << s;
        }
        // Steps 8..13 walk back down: 0x40, 0x20, ... 0x02.
        return 1u8 << (PATTERN_STEPS - s);
    }

    // Clock cycles one bit lasts on the UART line, rounded down.
    pub fn uart_cycles_per_bit() -> u32 {
        return CLOCK_HZ / UART_BAUD;
    }

    test heartbeat_starts_at_led0
        given led = heartbeat_led(0u8)
        then led == 0x01u8

    test heartbeat_reaches_led7
        given led = heartbeat_led(7u8)
        then led == 0x80u8

    test heartbeat_turns_back
        given led = heartbeat_led(8u8)
        then led == 0x40u8

    test heartbeat_last_step
        given led = heartbeat_led(13u8)
        then led == 0x02u8

    test heartbeat_wraps
        given led = heartbeat_led(14u8)
        then led == 0x01u8

    test uart_bit_is_104_cycles
        given cycles = uart_cycles_per_bit()
        then cycles == 104u32

    invariant heartbeat_at_most_twelve_steps_per_second
        assert CLOCK_HZ / HEARTBEAT_PERIOD <= 12u32

    invariant uart_repeat_outlasts_the_message
        // 10 bits per byte (start + 8 data + stop) must fit in one repeat window.
        assert UART_MESSAGE_BYTES * 10u32 * uart_cycles_per_bit() < UART_REPEAT

    invariant budget_uses_no_hard_blocks
        assert MAX_BRAM == 0u32
        assert MAX_DSP == 0u32
        assert MAX_FFS <= MAX_LUTS
}
